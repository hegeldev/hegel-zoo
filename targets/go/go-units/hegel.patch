+// Hegel property tests for github.com/docker/go-units: the size grammar against exact
+// (math/big) arithmetic, the printers against their parsers and the unit tables, HumanDuration
+// against a rounding/monotonicity model, and ParseUlimit against its documented grammar.
+package units_test
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	. "github.com/docker/go-units"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+// weighted chooses among generators in proportion to integer weights; it shrinks towards the
+// first choice, so the simplest comes first.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// text generates strings of lo–hi characters drawn from pool.
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// seq generates the concatenation of one draw from each generator.
+func seq(gs ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gs {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// randomCase flips the case of each letter of the generated string at random.
+func randomCase(g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.FlatMap(g, func(s string) hegel.Generator[string] {
+		return hegel.Map(hegel.Lists(hegel.Booleans()).MinSize(len(s)).MaxSize(len(s)), func(flip []bool) string {
+			b := []byte(s)
+			for i, c := range b {
+				if flip[i] {
+					if 'a' <= c && c <= 'z' {
+						b[i] = c - 32
+					} else if 'A' <= c && c <= 'Z' {
+						b[i] = c + 32
+					}
+				}
+			}
+			return string(b)
+		})
+	})
+}
+
+// sizeNumber is the numeric part of a size: an integer part (empty, "0", or digits without a
+// leading zero), an optional fraction (".", digits), sometimes a leading '+'; a bare "." is
+// completed to ".0". The exponent and hex forms strconv accepts are lenient extras and kept
+// for the README.
+var sizeNumber = hegel.Map(hegel.Composite(func(tc hegel.TestCase) [3]string {
+	sign := hegel.Draw(tc, weighted(choice[string]{19, hegel.Just("")}, choice[string]{1, hegel.Just("+")}))
+	integer := hegel.Draw(tc, weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{1, hegel.Just("0")},
+		choice[string]{14, seq(text("123456789", 1, 1), text("0123456789", 0, 6))}))
+	fraction := ""
+	if integer == "" || hegel.Draw(tc, chance(60)) {
+		fraction = hegel.Draw(tc, prefixed(".", text("0123456789", 0, 6)))
+	}
+	return [3]string{sign, integer, fraction}
+}), func(p [3]string) string {
+	s := p[0] + p[1] + p[2]
+	if !strings.ContainsAny(s, "0123456789") {
+		s += "0" // "." alone is not a number
+	}
+	return s
+})
+
+func prefixed(prefix string, g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return prefix + s })
+}
+
+// suffix is a unit suffix: nothing, b/B, or a unit letter with an optional b / ib in any
+// case, paired with the unit letter (0 for none).
+type unitSuffix struct {
+	text string
+	unit byte
+}
+
+var suffix = weighted(
+	choice[unitSuffix]{1, hegel.Just(unitSuffix{})},
+	choice[unitSuffix]{1, hegel.Map(hegel.SampledFrom([]string{"b", "B"}), func(s string) unitSuffix { return unitSuffix{s, 0} })},
+	choice[unitSuffix]{3, hegel.FlatMap(text("kmgtp", 1, 1), func(u string) hegel.Generator[unitSuffix] {
+		return hegel.Map(randomCase(prefixed(u, hegel.SampledFrom([]string{"", "", "b", "ib"}))), func(s string) unitSuffix { return unitSuffix{s, u[0]} })
+	})})
+
+// ---- the size grammar ----------------------------------------------------------------------
+
+var (
+	decimalUnits = map[byte]int64{'k': KB, 'm': MB, 'g': GB, 't': TB, 'p': PB}
+	binaryUnits  = map[byte]int64{'k': KiB, 'm': MiB, 'g': GiB, 't': TiB, 'p': PiB}
+	decimalAbbrs = []string{"B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"}
+	binaryAbbrs  = []string{"B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB"}
+	two63        = new(big.Int).Lsh(big.NewInt(1), 63)
+)
+
+// exactSize is the exact value of number × multiplier, floored, or nil if it does not fit int64.
+func exactSize(number string, mul int64) *big.Int {
+	r, ok := new(big.Rat).SetString(strings.TrimPrefix(number, "+"))
+	if !ok {
+		return nil
+	}
+	r.Mul(r, new(big.Rat).SetInt64(mul))
+	q := new(big.Int).Quo(r.Num(), r.Denom())
+	if q.Cmp(two63) >= 0 {
+		return nil
+	}
+	return q
+}
+
+// TestHegelSizeParsersReadTheGrammar: FromHumanSize and RAMInBytes accept `<number>[ ]<suffix>`
+// — a decimal number with optional fraction, bare leading/trailing dot or '+', at most one
+// space, and a suffix that is empty, b/B, or one of k m g t p in any case followed by nothing,
+// b or ib in any case — and return the exact number of bytes with the decimal (1000) or binary
+// (1024) multiplier, within one byte (the exact value is go-units/2), never an error.
+func TestHegelSizeParsersReadTheGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		number := hegel.Draw(ht, sizeNumber)
+		sfx := hegel.Draw(ht, suffix)
+		unit := sfx.unit
+		sep := hegel.Draw(ht, weighted(choice[string]{7, hegel.Just("")}, choice[string]{3, hegel.Just(" ")}))
+		input := number + sep + sfx.text
+		for _, fn := range []struct {
+			name  string
+			parse func(string) (int64, error)
+			units map[byte]int64
+		}{{"FromHumanSize", FromHumanSize, decimalUnits}, {"RAMInBytes", RAMInBytes, binaryUnits}} {
+			mul := int64(1)
+			if unit != 0 {
+				mul = fn.units[unit]
+			}
+			want := exactSize(number, mul)
+			if want == nil {
+				// Values at or beyond 2^63 are go-units/1; shrink the number instead.
+				if i := strings.Index(number, "."); i >= 0 {
+					number = "1" + number[i:]
+				} else {
+					number = "1"
+				}
+				input = number + sep + sfx.text
+				want = exactSize(number, mul)
+			}
+			ht.Note(fmt.Sprintf("%s(%q) exact %s", fn.name, input, want))
+			got, err := fn.parse(input)
+			if err != nil {
+				ht.Fatalf("%s(%q) = %v, want %s", fn.name, input, err, want)
+			}
+			// go-units/2: the product is computed in float64, so allow its rounding error
+			// (relative 2^-50) plus the truncated byte.
+			tol := new(big.Int).Rsh(want, 50)
+			tol.Add(tol, big.NewInt(1))
+			if diff := new(big.Int).Sub(big.NewInt(got), want); diff.CmpAbs(tol) > 0 {
+				ht.Fatalf("%s(%q) = %d, want %s", fn.name, input, got, want)
+			}
+		}
+	})
+}
+
+// junkSize is a string outside the grammar: empty, a leading blank, two blanks, a trailing
+// blank, a negative number, an unknown or over-long suffix, a tab, junk words, two numbers,
+// a number after the suffix, NaN, Inf.
+var junkSize = hegel.FlatMap(sizeNumber, func(num string) hegel.Generator[string] {
+	one := func(g hegel.Generator[string]) choice[string] { return choice[string]{1, g} }
+	after := func(s string) func(string) string { return func(x string) string { return s + x } }
+	return weighted(
+		one(hegel.Just("")),
+		one(hegel.Just(" "+num)),
+		one(hegel.Map(hegel.SampledFrom([]string{"kB", "B", "MiB"}), after(num+"  "))),
+		one(hegel.Map(hegel.SampledFrom([]string{"kB", "B", "MiB", "k"}), func(u string) string { return num + u + " " })),
+		one(hegel.Map(hegel.SampledFrom([]string{"", "kB", " B"}), after("-"+strings.TrimPrefix(strings.TrimLeft(num, "+0."), ".")+"1"))),
+		one(hegel.Map(randomCase(hegel.SampledFrom([]string{"x", "kx", "bb", "ib", "kib2", "mbb", "kbi", "eb", "zb", "yb", "kiib", "k b", "bk"})), after(num))),
+		one(hegel.Map(hegel.SampledFrom([]string{"kB", "B"}), after(num+"\t"))),
+		one(hegel.SampledFrom([]string{"hello", ".", ". ", " ", "  ", " .", "-", "+", "k", "kB", "B", "1,5", "1.2.3", "٣", "①"})),
+		one(hegel.Just(num+" "+num)),
+		one(hegel.Map(hegel.SampledFrom([]string{"kB", "MB"}), func(u string) string { return num + u + num })),
+		one(hegel.Map(hegel.SampledFrom([]string{"", "kB"}), after("NaN"))),
+		one(hegel.Map(hegel.SampledFrom([]string{"", "B"}), after("Inf"))))
+})
+
+// TestHegelSizeParsersRejectJunk: anything outside the grammar — leading blanks, two blanks,
+// tabs, trailing blanks after a suffix, negative values, unknown or over-long suffixes
+// (including E/Z/Y, go-units/3), two numbers, NaN/Inf, non-ASCII digits — is an error with
+// result -1, for both parsers.
+func TestHegelSizeParsersRejectJunk(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		input := hegel.Draw(ht, junkSize)
+		for _, fn := range []struct {
+			name  string
+			parse func(string) (int64, error)
+		}{{"FromHumanSize", FromHumanSize}, {"RAMInBytes", RAMInBytes}} {
+			got, err := fn.parse(input)
+			if err == nil {
+				ht.Fatalf("%s(%q) = %d, want an error", fn.name, input, got)
+			}
+			if got != -1 {
+				ht.Fatalf("%s(%q) = %d with error %v, want -1", fn.name, input, got, err)
+			}
+		}
+	})
+}
+
+// ---- the printers --------------------------------------------------------------------------
+
+// byteSize generates a byte count as a float64 below max: small integers, exact integers up to
+// 2^60, and log-uniform reals in powers of ten and of two.
+func byteSize(max float64) hegel.Generator[float64] {
+	toF := func(i int) float64 { return float64(i) }
+	return hegel.Map(weighted(
+		choice[float64]{1, hegel.Map(hegel.Integers(0, 999999), toF)},
+		choice[float64]{1, hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hegel.Integers(0, 1<<30))) * float64(hegel.Draw(tc, hegel.Integers(1, 1<<30)))
+		})},
+		choice[float64]{1, hegel.Map(hegel.Integers(0, 2700), func(i int) float64 { return math.Pow(10, float64(i)/100) })},
+		choice[float64]{1, hegel.Map(hegel.Integers(0, 900), func(i int) float64 { return math.Pow(2, float64(i)/10) })},
+	), func(s float64) float64 {
+		if s > max {
+			return math.Mod(s, max)
+		}
+		return s
+	})
+}
+
+// splitSize separates the numeric prefix of a printed size from its unit (the longest unit
+// in the table that is a suffix of the text).
+func splitSize(out string, abbrs []string) (float64, int, bool) {
+	best := -1
+	for i, a := range abbrs {
+		if strings.HasSuffix(out, a) && (best < 0 || len(a) > len(abbrs[best])) {
+			best = i
+		}
+	}
+	if best < 0 {
+		return 0, 0, false
+	}
+	v, err := strconv.ParseFloat(strings.TrimSuffix(out, abbrs[best]), 64)
+	return v, best, err == nil
+}
+
+// awayFromBoundary nudges size up while its mantissa in base would print as the base itself
+// at the given precision (go-units/4).
+func awayFromBoundary(size, base float64, precision int) float64 {
+	for {
+		m := size
+		for i := 0; m >= base && i < 8; i++ {
+			m /= base
+		}
+		rounded, _ := strconv.ParseFloat(strconv.FormatFloat(m, 'g', precision, 64), 64)
+		if rounded < base || m >= base || size == 0 {
+			return size
+		}
+		size *= 1.01
+	}
+}
+
+// TestHegelSizePrintersUseTheRightUnit: HumanSize / HumanSizeWithPrecision / BytesSize /
+// CustomSize print a mantissa in [1, base) (except below 1 byte or beyond the last unit)
+// followed by the unit of the table whose power divides the size, with the mantissa rounded
+// to the precision (relative error at most half a unit in the last significant digit), and
+// the decimal output reads back through FromHumanSize (binary through RAMInBytes) within that
+// precision for sizes below the E units.
+func TestHegelSizePrintersUseTheRightUnit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		precision := hegel.Draw(ht, weighted(choice[int]{7, hegel.Just(4)}, choice[int]{3, hegel.Integers(1, 10)}))
+		size := awayFromBoundary(hegel.Draw(ht, byteSize(1e27)), 1000, precision)
+		var out string
+		if precision == 4 && hegel.Draw(ht, hegel.Booleans()) {
+			out = HumanSize(size)
+		} else {
+			out = HumanSizeWithPrecision(size, precision)
+		}
+		checkPrinted(ht, out, size, 1000, precision, decimalAbbrs)
+		if size < 1e18 && precision == 4 {
+			back, err := FromHumanSize(out)
+			if err != nil {
+				ht.Fatalf("FromHumanSize(HumanSize(%v) = %q) = %v", size, out, err)
+			}
+			if math.Abs(float64(back)-size) > size*6e-4+1 {
+				ht.Fatalf("FromHumanSize(HumanSize(%v) = %q) = %d", size, out, back)
+			}
+		}
+
+		bsize := awayFromBoundary(hegel.Draw(ht, byteSize(math.Pow(1024, 9))), 1024, 4)
+		bout := BytesSize(bsize)
+		checkPrinted(ht, bout, bsize, 1024, 4, binaryAbbrs)
+		if bsize < math.Pow(1024, 6) {
+			back, err := RAMInBytes(bout)
+			if err != nil {
+				ht.Fatalf("RAMInBytes(BytesSize(%v) = %q) = %v", bsize, bout, err)
+			}
+			if math.Abs(float64(back)-bsize) > bsize*6e-4+1 {
+				ht.Fatalf("RAMInBytes(BytesSize(%v) = %q) = %d", bsize, bout, back)
+			}
+		}
+
+		// CustomSize with a short table: the last unit absorbs everything above it.
+		table := decimalAbbrs[:hegel.Draw(ht, hegel.Integers(1, 4))]
+		cout := CustomSize("%.4g %s", size, 1000, table)
+		v, i, ok := splitSize(strings.ReplaceAll(cout, " ", ""), table)
+		if !ok {
+			ht.Fatalf("CustomSize(%v, table %v) = %q", size, table, cout)
+		}
+		if got := v * math.Pow(1000, float64(i)); size != 0 && math.Abs(got-size) > size*6e-4 {
+			ht.Fatalf("CustomSize(%v, table %v) = %q, reads back as %v", size, table, cout, got)
+		}
+		if i < len(table)-1 && (v >= 1000 || (v < 1 && size >= 1)) {
+			ht.Fatalf("CustomSize(%v, table %v) = %q: mantissa outside [1, 1000)", size, table, cout)
+		}
+	})
+}
+
+func checkPrinted(ht *hegel.T, out string, size, base float64, precision int, abbrs []string) {
+	v, i, ok := splitSize(out, abbrs)
+	if !ok {
+		ht.Fatalf("printed %q for %v: no unit from %v", out, size, abbrs)
+	}
+	back := v * math.Pow(base, float64(i))
+	// Half a unit in the last of `precision` significant digits, relative to a mantissa ≥ 1.
+	tol := size * math.Pow(10, 1-float64(precision)) * 0.51
+	if math.Abs(back-size) > tol {
+		ht.Fatalf("printed %q for %v: reads back as %v (tolerance %v)", out, size, back, tol)
+	}
+	if i < len(abbrs)-1 && size >= 1 && (v >= base || v < 1) {
+		ht.Fatalf("printed %q for %v: mantissa %v outside [1, %v)", out, size, v, base)
+	}
+}
+
+// ---- durations -----------------------------------------------------------------------------
+
+// durationValue reads HumanDuration's text back as a duration (its lower bound) and the unit
+// it counted in.
+func durationValue(s string) (time.Duration, time.Duration, bool) {
+	switch s {
+	case "Less than a second":
+		return 0, time.Second, true
+	case "1 second":
+		return time.Second, time.Second, true
+	case "About a minute":
+		return time.Minute, time.Minute, true
+	case "About an hour":
+		return time.Hour, time.Hour, true
+	}
+	num, unit, ok := strings.Cut(s, " ")
+	if !ok {
+		return 0, 0, false
+	}
+	k, err := strconv.Atoi(num)
+	if err != nil || k < 2 {
+		return 0, 0, false
+	}
+	units := map[string]time.Duration{"seconds": time.Second, "minutes": time.Minute, "hours": time.Hour, "days": 24 * time.Hour, "weeks": 7 * 24 * time.Hour, "months": 30 * 24 * time.Hour, "years": 365 * 24 * time.Hour}
+	u, ok := units[unit]
+	if !ok {
+		return 0, 0, false
+	}
+	return time.Duration(k) * u, u, true
+}
+
+// duration spans seconds to years: up to two minutes, three hours, 800 days in seconds,
+// 2000 whole days, and arbitrary products of two large factors.
+var duration = weighted(
+	choice[time.Duration]{1, seconds(120)},
+	choice[time.Duration]{1, seconds(3 * 3600)},
+	choice[time.Duration]{1, seconds(800 * 24 * 3600)},
+	choice[time.Duration]{1, hegel.Map(hegel.Integers(0, 2000), func(d int) time.Duration { return time.Duration(d) * 24 * time.Hour })},
+	choice[time.Duration]{1, hegel.Composite(func(tc hegel.TestCase) time.Duration {
+		return time.Duration(hegel.Draw(tc, hegel.Integers(0, 1<<30))) * time.Duration(hegel.Draw(tc, hegel.Integers(1, 1<<30)))
+	})})
+
+func seconds(max int) hegel.Generator[time.Duration] {
+	return hegel.Map(hegel.Integers(0, max), func(s int) time.Duration { return time.Duration(s) * time.Second })
+}
+
+// durationPair is two durations in order, the second sometimes within an hour of the first.
+var durationPair = hegel.Composite(func(tc hegel.TestCase) [2]time.Duration {
+	d1, d2 := hegel.Draw(tc, duration), hegel.Draw(tc, duration)
+	if d1 > d2 {
+		d1, d2 = d2, d1
+	}
+	if hegel.Draw(tc, chance(30)) {
+		d2 = d1 + hegel.Draw(tc, seconds(3600))
+	}
+	return [2]time.Duration{d1, d2}
+})
+
+// TestHegelHumanDurationIsWithinOneUnitAndMonotone: the text names a count of one unit (or
+// one of the three fixed phrases), the count times the unit is within one unit of the true
+// duration (a month is 30 days, a year 365), and a longer duration never reads back shorter.
+func TestHegelHumanDurationIsWithinOneUnitAndMonotone(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		pair := hegel.Draw(ht, durationPair)
+		d1, d2 := pair[0], pair[1]
+		s1, s2 := HumanDuration(d1), HumanDuration(d2)
+		v1, u1, ok := durationValue(s1)
+		if !ok {
+			ht.Fatalf("HumanDuration(%v) = %q: not a count of a unit", d1, s1)
+		}
+		v2, _, ok := durationValue(s2)
+		if !ok {
+			ht.Fatalf("HumanDuration(%v) = %q: not a count of a unit", d2, s2)
+		}
+		if diff := d1 - v1; diff < -u1 || diff > u1 {
+			ht.Fatalf("HumanDuration(%v) = %q, more than one %v off", d1, s1, u1)
+		}
+		if v1 > v2 {
+			ht.Fatalf("HumanDuration(%v) = %q but HumanDuration(%v) = %q reads shorter", d1, s1, d2, s2)
+		}
+	})
+}
+
+// ---- ulimits -------------------------------------------------------------------------------
+
+var ulimitNames = map[string]int{"core": 4, "cpu": 0, "data": 2, "fsize": 1, "locks": 10, "memlock": 8, "msgqueue": 12, "nice": 13, "nofile": 7, "nproc": 6, "rss": 5, "rtprio": 14, "rttime": 15, "sigpending": 11, "stack": 3}
+
+// limit is a ulimit value: -1 (unlimited), 0, small, near MaxInt64, or a large product.
+var limit = weighted(
+	choice[int64]{1, hegel.Just(int64(-1))},
+	choice[int64]{1, hegel.Just(int64(0))},
+	choice[int64]{1, hegel.Map(hegel.Integers(1, 1<<20), func(i int) int64 { return int64(i) })},
+	choice[int64]{1, hegel.Map(hegel.Integers(0, 5), func(i int) int64 { return math.MaxInt64 - int64(i) })},
+	choice[int64]{1, hegel.Composite(func(tc hegel.TestCase) int64 {
+		return int64(hegel.Draw(tc, hegel.Integers(0, 1<<30))) * int64(hegel.Draw(tc, hegel.Integers(1, 1<<30)))
+	})})
+
+// TestHegelUlimitGrammarAndRoundTrip: `name=soft[:hard]` with a known name and non-negative or
+// -1 (unlimited) limits parses iff hard is -1 or soft is a non-negative number ≤ hard; the
+// result carries the fields (hard = soft when absent), String() reproduces a form that parses
+// back to the same value, and GetRlimit maps the name to its RLIMIT number and -1 to
+// ^uint64(0). Unknown names, missing '=', empty or non-integer fields and extra ':' fields are
+// errors.
+func TestHegelUlimitGrammarAndRoundTrip(t *testing.T) {
+	names := make([]string, 0, len(ulimitNames))
+	for k := range ulimitNames {
+		names = append(names, k)
+	}
+	property(t, func(ht *hegel.T) {
+		name := hegel.Draw(ht, hegel.SampledFrom(names))
+		soft := hegel.Draw(ht, limit)
+		text := fmt.Sprintf("%s=%d", name, soft)
+		hard := soft
+		if hegel.Draw(ht, chance(60)) {
+			hard = hegel.Draw(ht, limit)
+			text = fmt.Sprintf("%s=%d:%d", name, soft, hard)
+		}
+		wantErr := hard != -1 && (soft == -1 || soft > hard)
+		u, err := ParseUlimit(text)
+		if wantErr {
+			if err == nil {
+				ht.Fatalf("ParseUlimit(%q) = %+v, want an error (soft above hard)", text, *u)
+			}
+			return
+		}
+		if err != nil {
+			ht.Fatalf("ParseUlimit(%q) = %v", text, err)
+		}
+		if u.Name != name || u.Soft != soft || u.Hard != hard {
+			ht.Fatalf("ParseUlimit(%q) = %+v", text, *u)
+		}
+		s := u.String()
+		u2, err := ParseUlimit(s)
+		if err != nil || *u2 != *u {
+			ht.Fatalf("ParseUlimit(%q) = %+v, %v; String() of %+v", s, u2, err, *u)
+		}
+		r, err := u.GetRlimit()
+		if err != nil {
+			ht.Fatalf("GetRlimit(%+v) = %v", *u, err)
+		}
+		if r.Type != ulimitNames[name] || r.Soft != uint64(soft) || r.Hard != uint64(hard) {
+			ht.Fatalf("GetRlimit(%+v) = %+v, want type %d", *u, *r, ulimitNames[name])
+		}
+		if _, err := (&Ulimit{Name: name + "x", Soft: 1, Hard: 1}).GetRlimit(); err == nil {
+			ht.Fatalf("GetRlimit accepted the unknown name %q", name+"x")
+		}
+
+		// A junk form.
+		junk := hegel.Draw(ht, hegel.SampledFrom([]string{
+			name, name + ":1024", name + "=", "=1024", name + "=:", name + "=:1024", name + "=1024=512",
+			name + "=1024:512=extra", name + "=1024:2048:4096", strings.ToUpper(name) + "=1024", name + "x=1",
+			name + "= 1024", name + "=1024 ", name + "=1.5", name + "=0x10", name + "=1024:", "as=1024",
+			name + "=9223372036854775808", name + "=1_000", name + "=１０",
+		}))
+		if u, err := ParseUlimit(junk); err == nil {
+			ht.Fatalf("ParseUlimit(%q) = %+v, want an error", junk, *u)
+		}
+	})
+}
