+// go-units/1: sizes at or beyond 2^63 bytes are converted with int64(float64) and come back
+// as -9223372036854775808 with a nil error.
+func TestHegelSizeParsersRejectOverflow(t *testing.T) {
+	cases := []struct {
+		name  string
+		parse func(string) (int64, error)
+		input string
+	}{
+		{"FromHumanSize", FromHumanSize, "9223372036854775808"},
+		{"FromHumanSize", FromHumanSize, "9999999999PB"},
+		{"FromHumanSize", FromHumanSize, "1e30"},
+		{"RAMInBytes", RAMInBytes, "8192PiB"},
+		{"RAMInBytes", RAMInBytes, "9223372036854775808"},
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom(cases))
+		got, err := c.parse(c.input)
+		if err == nil {
+			ht.Fatalf("%s(%q) = %d with no error, want an error (value beyond int64)", c.name, c.input, got)
+		}
+	})
+}
+
+// go-units/2: the number is multiplied as a float64 and truncated, so "1.007kB" is 1006 bytes
+// and "16.1PB" is 16100000000000002.
+func TestHegelSizeParsersAreExact(t *testing.T) {
+	cases := []struct {
+		name  string
+		parse func(string) (int64, error)
+		input string
+		want  int64
+	}{
+		{"FromHumanSize", FromHumanSize, "1.007kB", 1007},
+		{"FromHumanSize", FromHumanSize, "4.031kB", 4031},
+		{"FromHumanSize", FromHumanSize, "16.112 kB", 16112},
+		{"FromHumanSize", FromHumanSize, "1.007k", 1007},
+		{"FromHumanSize", FromHumanSize, "16.1PB", 16100000000000000},
+		{"RAMInBytes", RAMInBytes, "1.007kB", 1031},
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom(cases))
+		got, err := c.parse(c.input)
+		if err != nil || got != c.want {
+			ht.Fatalf("%s(%q) = %d, %v; want %d", c.name, c.input, got, err, c.want)
+		}
+	})
+}
+
+// go-units/3: HumanSize/BytesSize print EB/ZB/YB and EiB/ZiB/YiB, but the parsers know no
+// unit above P, so "1EB" — and the printers' own output for sizes from 10^18 — is an error.
+func TestHegelSizeParsersReadExaZettaYotta(t *testing.T) {
+	cases := []struct {
+		name  string
+		parse func(string) (int64, error)
+		input string
+		want  int64
+	}{
+		{"FromHumanSize", FromHumanSize, "1EB", 1000 * PB},
+		{"FromHumanSize", FromHumanSize, "2 EB", 2000 * PB},
+		{"RAMInBytes", RAMInBytes, "1EiB", 1024 * PiB},
+		{"RAMInBytes", RAMInBytes, "1E", 1024 * PiB},
+		{"FromHumanSize", FromHumanSize, HumanSize(1e18), 1000 * PB},
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom(cases))
+		got, err := c.parse(c.input)
+		if err != nil || got != c.want {
+			ht.Fatalf("%s(%q) = %d, %v; want %d", c.name, c.input, got, err, c.want)
+		}
+	})
+}
