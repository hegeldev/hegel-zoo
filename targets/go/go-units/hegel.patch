+// go-units/6: negative limits other than -1 are accepted ("nofile=-5", "nofile=-7:-5") and
+// GetRlimit turns them into limits near 2^64.
+func TestHegelUlimitRejectsNegativeLimits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		arg := hegel.Draw(ht, hegel.SampledFrom([]string{"nofile=-5", "nofile=-5:-5", "nofile=-7:-5", "nproc=-2:-1", "core=-9223372036854775808"}))
+		u, err := ParseUlimit(arg)
+		if err == nil {
+			r, _ := u.GetRlimit()
+			ht.Fatalf("ParseUlimit(%q) = %+v (rlimit %+v), want an error", arg, *u, r)
+		}
+	})
