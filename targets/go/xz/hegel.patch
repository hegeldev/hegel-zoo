+		if err != nil {
+			fail(ht, "Read: %v after %d of %d bytes\n%s, reader %s", err, len(got), len(want), strings.Join(descr, "; "), wrapName)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "decoded %d bytes, want %d (first difference at %d)\n%s, reader %s", len(got), len(want), firstDiff(got, want), strings.Join(descr, "; "), wrapName)
+		}
+	})
+}
