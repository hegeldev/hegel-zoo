+// TestHegelWriter2ReportsTheFlushError: lzma.Writer2 over a sink that fails
+// before its first chunk reports the sink's error from Write or Close (xz/5;
+// under HEGEL_NO_KNOWN=1 the .xz Writer and the classic Writer do).
+func TestHegelWriter2ReportsTheFlushError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, flushCases)
+		data := tc.data.bytes()
+		sink := &failWriter{limit: tc.limit}
+		var w io.WriteCloser
+		var err error
+		switch tc.kind {
+		case "xz":
+			w, err = tc.xcfg.config(len(data)).NewWriter(sink)
+		case "lzma":
+			w, err = tc.lcfg.config(len(data)).NewWriter(sink)
+		default:
+			w, err = tc.cfg.config(len(data)).NewWriter2(sink)
+		}
+		note(ht, "%s writer over a sink failing after %d bytes, %d random bytes", tc.kind, tc.limit, len(data))
+		if err != nil {
+			if !errors.Is(err, errSink) {
+				fail(ht, "%s NewWriter over a failing sink: %v (not the sink's error)", tc.kind, err)
+			}
+			return // the header write already failed: reported
+		}
+		werr := tc.writes.write(w, data)
+		cerr := w.Close()
+		if !sink.failed {
+			fail(ht, "the sink accepted %d bytes of a stream for %d random bytes without failing", sink.n, len(data))
+		}
+		if werr == nil && cerr == nil {
+			mismatch(ht, "xz/5", "%s writer over a sink that fails after %d bytes: neither Write nor Close reported an error (sink got %d bytes)", tc.kind, tc.limit, sink.n)
+		}
+	})
