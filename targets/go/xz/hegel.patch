+// TestHegelExplicitSizeHeadersRoundTrip: a classic stream written with
+// SizeInHeader carries the data's size in its header, Size 0 included (xz/4;
+// under HEGEL_NO_KNOWN=1 a non-empty input), has no EOS marker and decodes
+// with lzma.Reader and xz.
+func TestHegelExplicitSizeHeadersRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, sizeHeaderCases)
+		data := tc.data.bytes()
+		c := lzma.WriterConfig{Properties: tc.cfg.props, DictCap: tc.cfg.dictCap, BufSize: tc.cfg.bufSize, Matcher: tc.cfg.matcher, SizeInHeader: true, Size: int64(len(data))}
+		s := describeLzmaConfig(c)
+		note(ht, "%s, %d data bytes", s, len(data))
+		var buf bytes.Buffer
+		w, err := c.NewWriter(&buf)
+		if err != nil {
+			fail(ht, "NewWriter: %v\n%s", err, s)
+		}
+		if _, err := w.Write(data); err != nil {
+			fail(ht, "Write: %v\n%s", err, s)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v\n%s", err, s)
+		}
+		out := buf.Bytes()
+		r, err := lzma.NewReader(bytes.NewReader(out))
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s", err, s)
+		}
+		h, ok := r.Header()
+		if !ok || h.Size != int64(len(data)) {
+			mismatch(ht, "xz/4", "Header() = %+v, %v; want Size %d\n%s", h, ok, len(data), s)
+		}
+		got, err := io.ReadAll(r)
+		if err != nil || !bytes.Equal(got, data) {
+			mismatch(ht, "xz/4", "decoded %d bytes, %v; want %d\n%s", len(got), err, len(data), s)
+		}
+		if r.EOSMarker() {
+			mismatch(ht, "xz/4", "EOSMarker() true for a stream written with SizeInHeader\n%s", s)
+		}
+		props := lzma.Properties{LC: 3, LP: 0, PB: 2}
+		if c.Properties != nil {
+			props = *c.Properties
+		}
+		xzGot, err := xzCLI(t, out, "--format=lzma", "-dc")
+		if props.LC+props.LP > 4 {
+			if err == nil {
+				fail(ht, "xz decoded a .lzma stream with lc+lp = %d, which liblzma documents as unsupported\n%s", props.LC+props.LP, s)
+			}
+		} else if err != nil || !bytes.Equal(xzGot, data) {
+			mismatch(ht, "xz/4", "xz --format=lzma -dc gave %d bytes, %v; want %d\n%s", len(xzGot), err, len(data), s)
+		}
+	})
+}
