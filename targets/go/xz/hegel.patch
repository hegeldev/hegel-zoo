+package xz_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the correct
+// behaviour, so it fails while the bug is open; target.toml lists them as
+// expected failures.
+
+import (
+	"bytes"
+	"io"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/ulikunitz/xz"
+	"github.com/ulikunitz/xz/lzma"
+)
+
+func mustCompress(t *testing.T, c xz.WriterConfig, data []byte) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	w, err := c.NewWriter(&buf)
+	if err != nil {
+		t.Fatalf("NewWriter: %v", err)
+	}
+	if _, err := w.Write(data); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func decode(in []byte) ([]byte, error) {
+	r, err := xz.NewReader(bytes.NewReader(in))
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+// xz/1: every proper prefix of a valid stream must fail to decode. A cut
+// inside a block header, or exactly between two blocks, is reported as a
+// clean EOF with the data decoded so far (readBlockHeader passes io.EOF up as
+// the end of the stream, without index or footer).
+func TestHegelPinTruncatedStreamsAreErrors(t *testing.T) {
+	data := []byte(strings.Repeat("jumps over the lazy dog. ", 8))
+	stream := mustCompress(t, xz.WriterConfig{BlockSize: 40, NoCheckSum: true}, data)
+	if got, err := decode(stream); err != nil || !bytes.Equal(got, data) {
+		t.Fatalf("the whole stream: %d bytes, %v", len(got), err)
+	}
+	var clean []int
+	for cut := 1; cut < len(stream); cut++ {
+		got, err := decode(stream[:cut])
+		if err == nil {
+			clean = append(clean, cut)
+			if len(clean) <= 4 {
+				t.Errorf("stream cut at %d of %d bytes: clean EOF with %d of %d data bytes (stream %x | %x)", cut, len(stream), len(got), len(data), stream[:cut], stream[cut:])
+			}
+		}
+		if !bytes.Equal(got, data[:min(len(got), len(data))]) {
+			t.Errorf("stream cut at %d: %d bytes that are not a prefix of the data", cut, len(got))
+		}
+	}
+	if len(clean) > 0 {
+		t.Errorf("%d of %d proper prefixes decode with a clean EOF: cuts at %v", len(clean), len(stream)-1, clean)
+	}
+	// The same end of input inside a block header reached without a cut: in the
+	// 32-byte stream `xz --check=none` writes for empty input (header, an empty
+	// index, footer; no block) the index indicator (byte 12, 0x00) flipped to
+	// 0x12 announces a 76-byte block header of which only 19 bytes exist.
+	// xz: "Unexpected end of input"; the Reader: 0 bytes and a clean EOF.
+	empty := []byte{
+		0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x00, 0xff, 0x12, 0xd9, 0x41, // stream header, check none
+		0x00, 0x00, 0x00, 0x00, 0x1c, 0xdf, 0x44, 0x21, // index: indicator, 0 records, padding, CRC32
+		0x06, 0x72, 0x9e, 0x7a, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x59, 0x5a, // footer
+	}
+	if got, err := decode(empty); err != nil || len(got) != 0 {
+		t.Fatalf("the empty stream: %d bytes, %v", len(got), err)
+	}
+	mutant := append([]byte(nil), empty...)
+	mutant[12] = 0x12
+	if got, err := decode(mutant); err == nil {
+		t.Errorf("index indicator flipped to a block-header size byte (%x): clean EOF with %d bytes", mutant, len(got))
+	}
+}
+
+// xz/8: an LZMA2 chunk header's compressed-size field is never checked against
+// what the decoder consumed (lzma/reader2.go wraps the chunk in a LimitReader of
+// that size and moves on when the uncompressed size is reached). Overstated, the
+// stream decodes as if correct where xz reports "Compressed data is corrupt";
+// understated on a stream without a check, the chunk ends early and the Reader
+// returns a clean EOF with the data missing.
+func TestHegelPinLzma2PackedSizeIsVerified(t *testing.T) {
+	data := []byte("The quick brown fox jumps over the lazy dog, and then does it again and again.")
+	for _, c := range []xz.WriterConfig{{}, {NoCheckSum: true}} {
+		valid := mustCompress(t, c, data)
+		offs := lzma2PackedSizeOffsets(valid)
+		if len(offs) != 2 {
+			t.Fatalf("%+v: expected one LZMA chunk, packed-size offsets %v in %x", c, offs, valid)
+		}
+		for _, v := range []struct {
+			off int
+			val byte
+			way string
+		}{{offs[0], 0x74, "overstated"}, {offs[1], 0x01, "understated"}} {
+			mutant := append([]byte(nil), valid...)
+			mutant[v.off] = v.val
+			got, err := decode(mutant)
+			if err == nil {
+				t.Errorf("%+v: compressed size %s (byte %d = %#x): no error, %d of %d bytes (intact %v); xz: corrupt", c, v.way, v.off, v.val, len(got), len(data), bytes.Equal(got, data))
+			}
+		}
+	}
+}
+
+// xz/2: incompressible data with a dictionary under 64 KiB fails with
+// "insufficient space" (an uncompressed LZMA2 chunk is copied from a
+// dictionary buffer that no longer holds all of it).
+func TestHegelPinSmallDictionaryCompressesIncompressibleData(t *testing.T) {
+	data := make([]byte, 70000)
+	rand.New(rand.NewSource(1)).Read(data)
+	for _, dict := range []int{4096, 8192, 32768} {
+		var buf bytes.Buffer
+		w, err := xz.WriterConfig{DictCap: dict}.NewWriter(&buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, werr := w.Write(data)
+		cerr := w.Close()
+		if werr != nil || cerr != nil {
+			t.Errorf("xz.WriterConfig{DictCap: %d} on 70000 random bytes: Write %v, Close %v", dict, werr, cerr)
+			continue
+		}
+		if got, err := decode(buf.Bytes()); err != nil || !bytes.Equal(got, data) {
+			t.Errorf("DictCap %d: round trip gave %d bytes, %v", dict, len(got), err)
+		}
+	}
+	var buf bytes.Buffer
+	w2, _ := lzma.Writer2Config{DictCap: 4096}.NewWriter2(&buf)
+	_, werr := w2.Write(data)
+	cerr := w2.Close()
+	if werr != nil || cerr != nil {
+		t.Errorf("lzma.Writer2Config{DictCap: 4096} on 70000 random bytes: Write %v, Close %v", werr, cerr)
+	}
+}
+
+// xz/3: the classic Writer with Matcher BinaryTree writes streams that
+// neither lzma.Reader nor xz can decode ("distance out of range").
+func TestHegelPinBinaryTreeMatcherWritesDecodableStreams(t *testing.T) {
+	rng := rand.New(rand.NewSource(11))
+	failures := 0
+	for trial := 0; trial < 300; trial++ {
+		size := 100 + rng.Intn(3000)
+		data := make([]byte, size)
+		rng.Read(data)
+		for k := 0; k < 8; k++ {
+			l := 1 + rng.Intn(size/2)
+			src := rng.Intn(size - l + 1)
+			dst := rng.Intn(size - l + 1)
+			copy(data[dst:dst+l], data[src:src+l])
+		}
+		c := lzma.WriterConfig{Matcher: lzma.BinaryTree, DictCap: []int{4096, 8192, 1 << 16}[trial%3], BufSize: 4096}
+		var buf bytes.Buffer
+		w, err := c.NewWriter(&buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w.Write(data)
+		if err := w.Close(); err != nil {
+			t.Fatalf("Close: %v", err)
+		}
+		r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+		if err != nil {
+			t.Fatalf("NewReader: %v", err)
+		}
+		got, err := io.ReadAll(r)
+		if err != nil || !bytes.Equal(got, data) {
+			failures++
+			if failures <= 3 {
+				t.Errorf("trial %d (%d bytes, DictCap %d): decoded %d bytes, %v", trial, size, c.DictCap, len(got), err)
+			}
+		}
+	}
+	if failures > 0 {
+		t.Errorf("%d of 300 BinaryTree streams do not decode", failures)
+	}
+}
+
+// xz/4: an explicit size of 0 is written as "unknown size" and no EOS marker
+// follows, so the empty stream cannot be decoded.
+func TestHegelPinExplicitSizeZeroRoundTrips(t *testing.T) {
+	var buf bytes.Buffer
+	w, err := lzma.WriterConfig{SizeInHeader: true, Size: 0}.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatalf("NewReader: %v (stream %x)", err, buf.Bytes())
+	}
+	h, _ := r.Header()
+	got, err := io.ReadAll(r)
+	if err != nil || len(got) != 0 {
+		t.Errorf("empty stream with SizeInHeader: header %+v, read %d bytes, %v (stream %x)", h, len(got), err, buf.Bytes())
+	}
+	if h.Size != 0 {
+		t.Errorf("header Size = %d, want 0", h.Size)
+	}
+}
+
+// xz/5: Writer2.Close returns nil when flushing the last chunk fails.
+func TestHegelPinWriter2CloseReportsTheFlushError(t *testing.T) {
+	sink := &failWriter{limit: 0}
+	w, err := lzma.NewWriter2(sink)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := w.Write([]byte("hello")); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err == nil {
+		t.Errorf("Close returned nil although the underlying writer failed (it got %d bytes)", sink.n)
+	}
+}
+
+// xz/6: lzma.Writer accepts Write and Close after Close and appends more
+// bytes to the finished stream.
+func TestHegelPinLzmaWriterRefusesUseAfterClose(t *testing.T) {
+	var buf bytes.Buffer
+	w, err := lzma.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Write([]byte("hello"))
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	n := buf.Len()
+	if _, err := w.Write([]byte("more")); err == nil {
+		t.Errorf("Write after Close returned nil")
+	}
+	if err := w.Close(); err == nil {
+		t.Errorf("second Close returned nil")
+	}
+	if buf.Len() != n {
+		t.Errorf("the stream grew from %d to %d bytes after Close", n, buf.Len())
+	}
+}
+
+// xz/7: once the decoder has reached the end of the compressed stream,
+// lzma.Reader.Read with an empty buffer returns io.EOF although decoded bytes
+// are still buffered; a caller that treats EOF as the end loses them.
+func TestHegelPinEmptyReadIsNotEOFWhileDataRemains(t *testing.T) {
+	data := []byte("hello world, hello xz")
+	var buf bytes.Buffer
+	w, err := lzma.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Write(data)
+	w.Close()
+	r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := make([]byte, 1)
+	if k, err := r.Read(first); k != 1 || err != nil {
+		t.Fatalf("first Read: %d, %v", k, err)
+	}
+	if k, err := r.Read(nil); k != 0 || err != nil {
+		t.Errorf("Read(nil) after one byte = %d, %v; want 0, nil (%d bytes still to come)", k, err, len(data)-1)
+	}
+	rest, err := io.ReadAll(r)
+	if err != nil || string(first)+string(rest) != string(data) {
+		t.Errorf("after the empty read: %q, %v", rest, err)
+	}
+}
