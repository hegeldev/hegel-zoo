+func describeWriter2Config(c lzma.Writer2Config) string {
+	return fmt.Sprintf("Writer2Config{Properties: %s, DictCap: %d, BufSize: %d, Matcher: %s}", propsName(c.Properties), c.DictCap, c.BufSize, c.Matcher)
+}
