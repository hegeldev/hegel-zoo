new file mode 100644
index 0000000..cc080c5
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1370 @@
+package xz_test
+
+// Hegel property tests for github.com/ulikunitz/xz.
+//
+// Oracles: XZ Utils' `xz` command-line tool (5.4.x on this machine; a stream
+// written by the Go Writer must decode with `xz -dc`, `xz --robot -l` must see
+// the blocks and the check the Writer was configured for, and a stream written
+// by `xz` with any option set must decode with the Go Reader — for the .xz
+// container, the classic .lzma format (`--format=lzma`) and raw LZMA2 chunk
+// sequences (`--format=raw --lzma2`)), plus the round trip Writer→Reader under
+// random configurations and read/write chunkings, the documented Verify rules
+// for the configuration structs, and the io.Reader/io.WriteCloser contracts.
+//
+// Set XZ_COLLECT=1 to make the properties record mismatches instead of failing
+// and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"testing/iotest"
+
+	"github.com/ulikunitz/xz"
+	"github.com/ulikunitz/xz/lzma"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// Several properties fork the xz tool two to six times per case, so on a
+	// loaded machine a case can take over a second; Hegel's too-slow health
+	// check would then fail the run (and hegel-go reports that without a
+	// message). The slowness is the oracle's, not a test problem.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("XZ_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	truncatedBlockHeaderIsEOF bool // xz/1: a stream cut inside or just before a block header ends with a clean EOF
+	smallDictNoSpace          bool // xz/2: incompressible data with DictCap < 64 KiB fails with "insufficient space"
+	binaryTreeMatcher         bool // xz/3: Matcher BinaryTree writes undecodable streams (classic and LZMA2)
+	sizeZeroHeader            bool // xz/4: SizeInHeader with Size 0 writes an unknown-size header without an EOS marker
+	writer2CloseSwallows      bool // xz/5: Writer2.Close returns nil when the flush fails
+	lzmaWriterAfterClose      bool // xz/6: lzma.Writer accepts Write and Close after Close
+	emptyReadEOF              bool // xz/7: lzma.Reader.Read with an empty buffer returns io.EOF while output is still buffered
+	lzma2PackedSizeUnchecked  bool // xz/8: an LZMA2 chunk's compressed-size field is not verified against what the decoder consumed
+}{truncatedBlockHeaderIsEOF: true, smallDictNoSpace: true, binaryTreeMatcher: true, sizeZeroHeader: true, writer2CloseSwallows: true, lzmaWriterAfterClose: true, emptyReadEOF: true, lzma2PackedSizeUnchecked: true}
+
+// ---------------------------------------------------------------------------
+// Data generators. Bulk bytes come from math/rand seeded by a drawn value, so
+// the shape (kind, size, seed) is what Hegel shrinks.
+
+func genSize(tc hegel.TestCase) int {
+	switch n(tc, 0, 9) {
+	case 0:
+		return 0
+	case 1, 2, 3:
+		return n(tc, 1, 64)
+	case 4, 5, 6:
+		return n(tc, 65, 4096)
+	case 7, 8:
+		return n(tc, 4097, 1<<16)
+	default:
+		return n(tc, 1<<16+1, 1<<18)
+	}
+}
+
+func genData(tc hegel.TestCase) []byte {
+	size := genSize(tc)
+	seed := hegel.Draw(tc, hegel.Integers[int64](0, 1<<40))
+	kind := n(tc, 0, 5)
+	rng := rand.New(rand.NewSource(seed))
+	out := make([]byte, size)
+	switch kind {
+	case 0: // random bytes
+		rng.Read(out)
+	case 1: // text of a small vocabulary
+		words := []string{"the ", "quick ", "brown ", "fox ", "jumps ", "over ", "lazy ", "dog.\n", "xz ", "lzma2 ", "0", "1", "\t"}
+		var b strings.Builder
+		for b.Len() < size {
+			b.WriteString(words[rng.Intn(len(words))])
+		}
+		copy(out, b.String())
+	case 2: // constant runs
+		for i := 0; i < size; {
+			c := byte(rng.Intn(256))
+			l := 1 + rng.Intn(300)
+			for j := 0; j < l && i < size; j++ {
+				out[i] = c
+				i++
+			}
+		}
+	case 3: // random with long-distance repeats
+		rng.Read(out)
+		for k := 0; k < 8 && size > 16; k++ {
+			l := 1 + rng.Intn(size/2)
+			src := rng.Intn(size - l + 1)
+			dst := rng.Intn(size - l + 1)
+			copy(out[dst:dst+l], out[src:src+l])
+		}
+	case 4: // small alphabet
+		alpha := []byte("ab")
+		if rng.Intn(2) == 0 {
+			alpha = []byte("abcd\n")
+		}
+		for i := range out {
+			out[i] = alpha[rng.Intn(len(alpha))]
+		}
+	default: // mixed pieces
+		for i := 0; i < size; {
+			l := 1 + rng.Intn(1000)
+			if l > size-i {
+				l = size - i
+			}
+			switch rng.Intn(3) {
+			case 0:
+				rng.Read(out[i : i+l])
+			case 1:
+				c := byte(rng.Intn(256))
+				for j := 0; j < l; j++ {
+					out[i+j] = c
+				}
+			default:
+				for j := 0; j < l; j++ {
+					out[i+j] = byte('a' + rng.Intn(4))
+				}
+			}
+			i += l
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Configuration generators.
+
+var dictCaps = []int{0, 4096, 8192, 12288, 1 << 14, 3 << 13, 1 << 16, 1 << 17, 1 << 20, 3 << 19, 8 << 20}
+
+func genProps(tc hegel.TestCase, lzma2 bool) *lzma.Properties {
+	if chance(tc, 30) {
+		return nil
+	}
+	lc := n(tc, 0, 4)
+	lp := n(tc, 0, 4)
+	if lzma2 {
+		lp = n(tc, 0, 4-lc)
+	} else if chance(tc, 60) {
+		lc = n(tc, 0, 8)
+	}
+	return &lzma.Properties{LC: lc, LP: lp, PB: n(tc, 0, 4)}
+}
+
+func genWriterConfig(tc hegel.TestCase, dataLen int) xz.WriterConfig {
+	c := xz.WriterConfig{
+		Properties: genProps(tc, true),
+		DictCap:    pick(tc, dictCaps...),
+	}
+	if chance(tc, 30) {
+		c.BufSize = pick(tc, 4096, 8192, 300, 1<<16)
+	}
+	switch n(tc, 0, 4) {
+	case 0:
+		c.BlockSize = int64(n(tc, 1, 64))
+	case 1:
+		c.BlockSize = int64(n(tc, 1, dataLen+1))
+	case 2:
+		c.BlockSize = int64(n(tc, 1, 1<<20))
+	}
+	switch n(tc, 0, 5) {
+	case 0:
+		c.CheckSum = xz.CRC32
+	case 1:
+		c.CheckSum = xz.CRC64
+	case 2:
+		c.CheckSum = xz.SHA256
+	case 3:
+		c.NoCheckSum = true
+	}
+	if chance(tc, 30) && !Known.binaryTreeMatcher {
+		c.Matcher = lzma.BinaryTree
+	}
+	// Every block builds a fresh dictionary and matcher of DictCap bytes, so
+	// thousands of tiny blocks with a large dictionary take minutes: keep the
+	// block count within 64 (not a recorded bug; see the README).
+	if c.BlockSize > 0 && int64(dataLen)/c.BlockSize > 64 {
+		c.BlockSize = int64(dataLen)/64 + 1
+	}
+	if Known.smallDictNoSpace && c.DictCap != 0 && c.DictCap < 1<<16 && dataLen > c.DictCap {
+		c.DictCap = 1 << 16
+	}
+	return c
+}
+
+func describeWriterConfig(c xz.WriterConfig) string {
+	p := "nil"
+	if c.Properties != nil {
+		p = c.Properties.String()
+	}
+	return fmt.Sprintf("WriterConfig{Properties: %s, DictCap: %d, BufSize: %d, BlockSize: %d, CheckSum: %#x, NoCheckSum: %v, Matcher: %s}",
+		p, c.DictCap, c.BufSize, c.BlockSize, c.CheckSum, c.NoCheckSum, c.Matcher)
+}
+
+// checkName is the name `xz --robot -l` prints for the check the config selects.
+func checkName(c xz.WriterConfig) string {
+	if c.NoCheckSum {
+		return "None"
+	}
+	switch c.CheckSum {
+	case xz.CRC32:
+		return "CRC32"
+	case xz.SHA256:
+		return "SHA-256"
+	default:
+		return "CRC64"
+	}
+}
+
+// expectedBlocks is the number of blocks the Writer must produce for dataLen
+// bytes: one per BlockSize bytes, at least one.
+func expectedBlocks(c xz.WriterConfig, dataLen int) int {
+	if c.BlockSize <= 0 || dataLen == 0 {
+		return 1
+	}
+	return int((int64(dataLen) + c.BlockSize - 1) / c.BlockSize)
+}
+
+// ---------------------------------------------------------------------------
+// The xz command-line tool.
+
+var (
+	xzOnce sync.Once
+	xzBin  string
+	xzErr  error
+)
+
+func xzPath(t testing.TB) string {
+	xzOnce.Do(func() {
+		xzBin = os.Getenv("HEGEL_XZ")
+		if xzBin == "" {
+			xzBin, xzErr = exec.LookPath("xz")
+		}
+	})
+	if xzErr != nil {
+		t.Fatalf("the xz command-line tool is required as the oracle: %v", xzErr)
+	}
+	return xzBin
+}
+
+// xzCLI runs xz with args, feeding input on stdin and returning stdout; a
+// non-zero exit is returned as an error carrying stderr.
+func xzCLI(t testing.TB, input []byte, args ...string) ([]byte, error) {
+	all := append([]string{"--threads=1", "--memlimit=1GiB"}, args...)
+	cmd := exec.Command(xzPath(t), all...)
+	cmd.Stdin = bytes.NewReader(input)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	if err != nil {
+		return stdout.Bytes(), fmt.Errorf("xz %s: %v: %s", strings.Join(args, " "), err, strings.TrimSpace(stderr.String()))
+	}
+	return stdout.Bytes(), nil
+}
+
+// xzListing is what `xz --robot -l -v -v` reports about a file.
+type xzListing struct {
+	streams, blocks int
+	uncompressed    int64
+	check           string
+	padding         int64
+	blockSizes      []int64 // uncompressed size per block
+	blockChecks     []string
+}
+
+func xzList(t testing.TB, data []byte) (xzListing, error) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "f.xz")
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	out, err := xzCLI(t, nil, "--robot", "-l", "-v", "-v", path)
+	var l xzListing
+	if err != nil {
+		return l, err
+	}
+	for _, line := range strings.Split(string(out), "\n") {
+		f := strings.Split(line, "\t")
+		switch f[0] {
+		case "file":
+			if len(f) < 8 {
+				return l, fmt.Errorf("short file line %q", line)
+			}
+			l.streams, _ = strconv.Atoi(f[1])
+			l.blocks, _ = strconv.Atoi(f[2])
+			l.uncompressed, _ = strconv.ParseInt(f[4], 10, 64)
+			l.check = f[6]
+			l.padding, _ = strconv.ParseInt(f[7], 10, 64)
+		case "block":
+			if len(f) < 10 {
+				return l, fmt.Errorf("short block line %q", line)
+			}
+			u, _ := strconv.ParseInt(f[7], 10, 64)
+			l.blockSizes = append(l.blockSizes, u)
+			l.blockChecks = append(l.blockChecks, f[9])
+		}
+	}
+	return l, nil
+}
+
+// genXzArgs draws options for `xz -c`.
+func genXzArgs(tc hegel.TestCase) []string {
+	args := []string{"-c", "--format=xz"}
+	switch n(tc, 0, 3) {
+	case 0:
+		args = append(args, "-"+strconv.Itoa(n(tc, 0, 6)))
+		if chance(tc, 30) {
+			args = append(args, "-e")
+		}
+	default:
+		lc := n(tc, 0, 4)
+		opts := []string{
+			"dict=" + pick(tc, "4KiB", "8KiB", "12KiB", "64KiB", "1MiB", "8MiB", "5000", "100000"),
+			"lc=" + strconv.Itoa(lc),
+			"lp=" + strconv.Itoa(n(tc, 0, 4-lc)),
+			"pb=" + strconv.Itoa(n(tc, 0, 4)),
+			"mode=" + pick(tc, "fast", "normal"),
+			"mf=" + pick(tc, "hc3", "hc4", "bt2", "bt3", "bt4"),
+			"nice=" + strconv.Itoa(n(tc, 2, 273)),
+		}
+		args = append(args, "--lzma2="+strings.Join(opts, ","))
+	}
+	switch n(tc, 0, 5) {
+	case 0:
+		args = append(args, "--check=none")
+	case 1:
+		args = append(args, "--check=crc32")
+	case 2:
+		args = append(args, "--check=crc64")
+	case 3:
+		args = append(args, "--check=sha256")
+	}
+	if chance(tc, 40) {
+		args = append(args, "--block-size="+strconv.Itoa(pick(tc, 1, 7, 100, 1000, 4096, 65536)))
+	}
+	return args
+}
+
+// ---------------------------------------------------------------------------
+// Reading through random chunkings.
+
+// wrapReader returns r behind a randomly chosen io.Reader adapter.
+func wrapReader(tc hegel.TestCase, r io.Reader) (io.Reader, string) {
+	switch n(tc, 0, 4) {
+	case 0:
+		return iotest.OneByteReader(r), "OneByteReader"
+	case 1:
+		return iotest.HalfReader(r), "HalfReader"
+	case 2:
+		return iotest.DataErrReader(r), "DataErrReader"
+	default:
+		return r, "plain"
+	}
+}
+
+// readAllChunked reads r to EOF with buffers of the drawn sizes (cycling,
+// some empty unless zero is false), capped at limit bytes, and returns the
+// data and the final error (nil on a clean io.EOF).
+func readAllChunked(tc hegel.TestCase, r io.Reader, limit int, zero bool) ([]byte, error) {
+	sizes := []int{pick(tc, 1, 2, 3, 7, 64, 1000, 4096, 1<<16)}
+	if chance(tc, 50) {
+		lo := 1
+		if zero {
+			lo = 0
+		}
+		sizes = append(sizes, n(tc, 1, 5000), n(tc, lo, 10))
+	}
+	var out []byte
+	i := 0
+	for {
+		size := sizes[i%len(sizes)]
+		i++
+		buf := make([]byte, size)
+		k, err := r.Read(buf)
+		if k < 0 || k > size {
+			return out, fmt.Errorf("Read returned n=%d for a %d-byte buffer", k, size)
+		}
+		out = append(out, buf[:k]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+		if size == 0 && k == 0 && i > 3 {
+			// a zero-length read tells nothing; move on
+			continue
+		}
+		if len(out) > limit {
+			return out, fmt.Errorf("more than %d bytes without EOF", limit)
+		}
+	}
+}
+
+// writeChunked writes data to w in randomly sized pieces (some empty).
+func writeChunked(tc hegel.TestCase, w io.Writer, data []byte) error {
+	for len(data) > 0 || chance(tc, 20) {
+		k := 0
+		if len(data) > 0 {
+			switch n(tc, 0, 3) {
+			case 0:
+				k = len(data)
+			case 1:
+				k = n(tc, 1, min(len(data), 100))
+			default:
+				k = n(tc, 1, len(data))
+			}
+		}
+		m, err := w.Write(data[:k])
+		if err != nil {
+			return err
+		}
+		if m != k {
+			return fmt.Errorf("Write returned %d for %d bytes without an error", m, k)
+		}
+		data = data[k:]
+		if k == 0 {
+			break
+		}
+	}
+	return nil
+}
+
+func compressGo(tc hegel.TestCase, c xz.WriterConfig, data []byte) ([]byte, error) {
+	var buf bytes.Buffer
+	w, err := c.NewWriter(&buf)
+	if err != nil {
+		return nil, fmt.Errorf("NewWriter: %v", err)
+	}
+	if err := writeChunked(tc, w, data); err != nil {
+		return nil, fmt.Errorf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		return nil, fmt.Errorf("Close: %v", err)
+	}
+	return buf.Bytes(), nil
+}
+
+func short(b []byte) string {
+	if len(b) <= 48 {
+		return fmt.Sprintf("%q", b)
+	}
+	return fmt.Sprintf("%q... (%d bytes)", b[:48], len(b))
+}
+
+func firstDiff(a, b []byte) int {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if a[i] != b[i] {
+			return i
+		}
+	}
+	return min(len(a), len(b))
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelWriterOutputRoundTripsThroughTheReader: whatever the Writer writes
+// under any configuration, the Reader gives back, through any read chunking;
+// concatenated streams (with optional 4-byte padding) decode to the
+// concatenation, and SingleStream stops after the first.
+func TestHegelWriterOutputRoundTripsThroughTheReader(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		c := genWriterConfig(ht, len(data))
+		note(ht, "%s, %d data bytes", describeWriterConfig(c), len(data))
+		out, err := compressGo(ht, c, data)
+		if err != nil {
+			fail(ht, "%v\n%s, data %s", err, describeWriterConfig(c), short(data))
+		}
+		if !xz.ValidHeader(out[:12]) {
+			fail(ht, "ValidHeader false on the Writer's own header %x\n%s", out[:12], describeWriterConfig(c))
+		}
+
+		// concatenation
+		streams := [][]byte{out}
+		want := append([]byte(nil), data...)
+		joined := append([]byte(nil), out...)
+		extra := 0
+		if chance(ht, 30) {
+			extra = n(ht, 1, 2)
+		}
+		for i := 0; i < extra; i++ {
+			d2 := genData(ht)
+			c2 := genWriterConfig(ht, len(d2))
+			o2, err := compressGo(ht, c2, d2)
+			if err != nil {
+				fail(ht, "second stream: %v\n%s", err, describeWriterConfig(c2))
+			}
+			if chance(ht, 50) {
+				joined = append(joined, make([]byte, 4*n(ht, 1, 3))...)
+			}
+			joined = append(joined, o2...)
+			streams = append(streams, o2)
+			want = append(want, d2...)
+		}
+		trailingPad := chance(ht, 30)
+		if trailingPad {
+			joined = append(joined, make([]byte, 4*n(ht, 1, 2))...)
+		}
+
+		rc := xz.ReaderConfig{}
+		if chance(ht, 30) {
+			rc.DictCap = pick(ht, dictCaps...)
+		}
+		src, wrapName := wrapReader(ht, bytes.NewReader(joined))
+		r, err := rc.NewReader(src)
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s, %d streams, %s", err, describeWriterConfig(c), len(streams), wrapName)
+		}
+		got, err := readAllChunked(ht, r, len(want)+1<<20, true)
+		if err != nil {
+			fail(ht, "Read: %v after %d of %d bytes\n%s, %d streams (%d extra, trailing padding %v), reader %s, data %s", err, len(got), len(want), describeWriterConfig(c), len(streams), extra, trailingPad, wrapName, short(data))
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "decoded %d bytes, want %d (first difference at %d)\n%s, %d streams, reader %s, data %s", len(got), len(want), firstDiff(got, want), describeWriterConfig(c), len(streams), wrapName, short(data))
+		}
+		// a further Read stays at EOF
+		k, err := r.Read(make([]byte, 10))
+		if k != 0 || err != io.EOF {
+			fail(ht, "Read after EOF gave %d, %v", k, err)
+		}
+
+		// single-stream mode: the first stream only, then an error if anything follows
+		if len(streams) > 1 || trailingPad {
+			r1, err := xz.ReaderConfig{SingleStream: true}.NewReader(bytes.NewReader(joined))
+			if err != nil {
+				fail(ht, "SingleStream NewReader: %v", err)
+			}
+			got1, err := readAllChunked(ht, r1, len(data)+1<<20, true)
+			if !bytes.Equal(got1, data) {
+				fail(ht, "SingleStream decoded %d bytes, want the first stream's %d (err %v)", len(got1), len(data), err)
+			}
+			if err == nil {
+				fail(ht, "SingleStream reached EOF although %d bytes follow the first stream", len(joined)-len(out))
+			}
+		}
+	})
+}
+
+// TestHegelXzToolDecodesTheWriterOutput: the xz tool decodes what the Writer
+// writes, and its listing shows the blocks, sizes and check the Writer was
+// configured for.
+func TestHegelXzToolDecodesTheWriterOutput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		c := genWriterConfig(ht, len(data))
+		note(ht, "%s, %d data bytes", describeWriterConfig(c), len(data))
+		out, err := compressGo(ht, c, data)
+		if err != nil {
+			fail(ht, "%v\n%s, data %s", err, describeWriterConfig(c), short(data))
+		}
+		got, err := xzCLI(t, out, "-dc")
+		if err != nil {
+			fail(ht, "%v\n%s, data %s\nstream %x", err, describeWriterConfig(c), short(data), out)
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "xz -dc gave %d bytes, want %d (first difference at %d)\n%s, data %s", len(got), len(data), firstDiff(got, data), describeWriterConfig(c), short(data))
+		}
+		l, err := xzList(t, out)
+		if err != nil {
+			fail(ht, "%v\n%s", err, describeWriterConfig(c))
+		}
+		if l.streams != 1 || l.padding != 0 || l.uncompressed != int64(len(data)) {
+			fail(ht, "xz -l: %d streams, %d bytes padding, %d uncompressed; want 1, 0, %d\n%s", l.streams, l.padding, l.uncompressed, len(data), describeWriterConfig(c))
+		}
+		if l.check != checkName(c) {
+			fail(ht, "xz -l reports check %s, the Writer was configured for %s\n%s", l.check, checkName(c), describeWriterConfig(c))
+		}
+		if want := expectedBlocks(c, len(data)); l.blocks != want || len(l.blockSizes) != want {
+			fail(ht, "xz -l: %d blocks (%v), want %d for %d bytes at BlockSize %d\n%s", l.blocks, l.blockSizes, want, len(data), c.BlockSize, describeWriterConfig(c))
+		}
+		if c.BlockSize > 0 {
+			for i, s := range l.blockSizes {
+				want := c.BlockSize
+				if i == len(l.blockSizes)-1 && int64(len(data))%c.BlockSize != 0 {
+					want = int64(len(data)) % c.BlockSize
+				}
+				if len(data) == 0 {
+					want = 0
+				}
+				if s != want {
+					fail(ht, "block %d holds %d bytes, want %d (BlockSize %d, %d bytes)\n%s", i, s, want, c.BlockSize, len(data), describeWriterConfig(c))
+				}
+			}
+		}
+	})
+}
+
+// TestHegelReaderDecodesTheXzToolOutput: streams written by the xz tool with
+// any options, alone or concatenated with padding, decode with the Reader.
+func TestHegelReaderDecodesTheXzToolOutput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		count := 1
+		if chance(ht, 30) {
+			count = n(ht, 2, 3)
+		}
+		var joined, want []byte
+		var descr []string
+		for i := 0; i < count; i++ {
