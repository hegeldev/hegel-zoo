+// ---------------------------------------------------------------------------
+// Writing and reading through drawn chunkings.
+
+// writePlan is how a writer receives the data: the sizes of the Writes, each
+// taken modulo what is left plus one (so 0 is an empty Write), then one Write
+// of the rest. The empty plan is one Write, what a case shrinks to.
+type writePlan struct {
+	sizes []int
+}
+
+func (p writePlan) String() string {
+	if len(p.sizes) == 0 {
+		return "one write"
+	}
+	return fmt.Sprintf("writes %v", p.sizes)
+}
+
+// write performs the plan and reports the writer's first error.
+func (p writePlan) write(w io.Writer, data []byte) error {
+	for _, s := range p.sizes {
+		k := at(s, len(data)+1)
+		m, err := w.Write(data[:k])
+		if err != nil {
+			return err
+		}
+		if m != k {
+			return fmt.Errorf("Write returned %d for %d bytes without an error", m, k)
+		}
+		data = data[k:]
+	}
+	if len(data) > 0 {
+		m, err := w.Write(data)
+		if err != nil {
+			return err
+		}
+		if m != len(data) {
+			return fmt.Errorf("Write returned %d for %d bytes without an error", m, len(data))
+		}
+	}
+	return nil
+}
+
+var (
+	writeSizes = weighted(choice[int]{1, hegel.Just(0)}, choice[int]{2, hegel.Integers(1, 100)}, choice[int]{2, hegel.Integers(1, 1<<18)})
+	writePlans = hegel.Map(many(writeSizes, 0, 6), func(sizes []int) writePlan { return writePlan{sizes} })
+)
+
+// chunkPlan is a writePlan for lzma.Writer2 with a Flush after the pieces
+// whose entry in flushes (read modulo their number) is set; no flushes
+// without a list.
+type chunkPlan struct {
+	sizes   []int
+	flushes []bool
+}
+
+func (p chunkPlan) String() string {
+	return fmt.Sprintf("%s, flushes %v", writePlan{p.sizes}, p.flushes)
+}
+
+// write performs the plan and reports the number of flushes and the first error.
+func (p chunkPlan) write(w *lzma.Writer2, data []byte) (int, error) {
+	flushes := 0
+	piece := func(i int, b []byte) error {
+		if m, err := w.Write(b); err != nil {
+			return fmt.Errorf("Write: %w", err)
+		} else if m != len(b) {
+			return fmt.Errorf("Write returned %d for %d bytes without an error", m, len(b))
+		}
+		if len(p.flushes) > 0 && p.flushes[i%len(p.flushes)] {
+			if err := w.Flush(); err != nil {
+				return fmt.Errorf("Flush: %w", err)
+			}
+			flushes++
+		}
+		return nil
+	}
+	i := 0
+	for _, s := range p.sizes {
+		k := at(s, len(data)+1)
+		if err := piece(i, data[:k]); err != nil {
+			return flushes, err
+		}
+		data = data[k:]
+		i++
+	}
+	if len(data) > 0 {
+		if err := piece(i, data); err != nil {
+			return flushes, err
+		}
+	}
+	return flushes, nil
+}
+
+var chunkPlans = hegel.Composite(func(tc hegel.TestCase) chunkPlan {
+	return chunkPlan{sizes: hegel.Draw(tc, many(writeSizes, 0, 6)), flushes: hegel.Draw(tc, many(hegel.Booleans(), 0, 4))}
+})
+
+// readPlan is how a reader is read to EOF: buffer sizes cycled, the first
+// one never empty (so a plan of empty reads alone cannot spin), the others
+// empty at times (an empty read of lzma.Reader is the shape of xz/7).
+type readPlan struct {
+	sizes []int
+}
+
+func (p readPlan) String() string { return fmt.Sprintf("reads %v", p.sizes) }
+
+// classic is the plan for lzma.Reader: under HEGEL_NO_KNOWN=1 its empty reads
+// are one-byte reads.
+func (p readPlan) classic() readPlan {
+	if !Known.emptyReadEOF {
+		return p
+	}
+	sizes := make([]int, len(p.sizes))
+	for i, s := range p.sizes {
+		sizes[i] = max(s, 1)
+	}
+	return readPlan{sizes}
+}
+
+// readAll reads r to EOF with the plan's buffers, capped at limit bytes, and
+// returns the data and the final error (nil on a clean io.EOF).
+func (p readPlan) readAll(r io.Reader, limit int) ([]byte, error) {
+	var out []byte
+	idle := 0
+	for i := 0; ; i++ {
+		size := p.sizes[i%len(p.sizes)]
+		buf := make([]byte, size)
+		k, err := r.Read(buf)
+		if k < 0 || k > size {
+			return out, fmt.Errorf("Read returned n=%d for a %d-byte buffer", k, size)
+		}
+		out = append(out, buf[:k]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+		if len(out) > limit {
+			return out, fmt.Errorf("more than %d bytes without EOF", limit)
+		}
+		if k == 0 && size > 0 {
+			if idle++; idle > 1000 {
+				return out, fmt.Errorf("Read returned 0, nil for a %d-byte buffer %d times in a row", size, idle)
+			}
+		} else if k > 0 {
+			idle = 0
+		}
+	}
+}
+
+var (
+	firstReadSizes = weighted(choice[int]{3, pick(1, 2, 3, 7, 64, 1000, 4096, 1<<16)}, choice[int]{1, hegel.Integers(1, 5000)}, choice[int]{1, hegel.Integers(1, 10)})
+	readSizes      = weighted(choice[int]{3, pick(1, 2, 3, 7, 64, 1000, 4096, 1<<16)}, choice[int]{1, hegel.Integers(1, 5000)}, choice[int]{1, hegel.Integers(0, 10)})
+	readPlans      = hegel.Composite(func(tc hegel.TestCase) readPlan {
+		return readPlan{append([]int{hegel.Draw(tc, firstReadSizes)}, hegel.Draw(tc, many(readSizes, 0, 3))...)}
+	})
+)
+
+// wraps: the io.Reader adapter the stream is read through; plain first.
+var wraps = pick("plain", "plain", "OneByteReader", "HalfReader", "DataErrReader")
+
+func wrap(name string, r io.Reader) io.Reader {
+	switch name {
+	case "OneByteReader":
+		return iotest.OneByteReader(r)
+	case "HalfReader":
+		return iotest.HalfReader(r)
+	case "DataErrReader":
+		return iotest.DataErrReader(r)
+	}
+	return r
+}
+
+// compressGo writes data with the Writer under c through the plan.
+func compressGo(c xz.WriterConfig, plan writePlan, data []byte) ([]byte, error) {
+	var buf bytes.Buffer
+	w, err := c.NewWriter(&buf)
+	if err != nil {
+		return nil, fmt.Errorf("NewWriter: %v", err)
+	}
+	if err := plan.write(w, data); err != nil {
+		return nil, fmt.Errorf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		return nil, fmt.Errorf("Close: %v", err)
+	}
+	return buf.Bytes(), nil
+}
+
+// writerShape names the recorded bug of a Writer failure on data of dataLen
+// bytes under c: xz/2 for a DictCap under 64 KiB with more data than it
+// holds, xz/3 for BinaryTree; "" otherwise.
+func writerShape(c xz.WriterConfig, dataLen int) string {
+	if c.DictCap != 0 && c.DictCap < 1<<16 && dataLen > c.DictCap {
+		return "xz/2"
+	}
+	if c.Matcher == lzma.BinaryTree {
+		return "xz/3"
+	}
+	return ""
+}
+
+// Performance candidates (not recorded bugs; reported with reproductions):
+// the cases of these shapes are skipped behind named gates so that a case
+// stays within seconds.
+
+// candidate/go/xz-9: the BinaryTree matcher is superlinear on low-entropy
+// input: 256 KiB of a two-letter alphabet takes 29 s (128 KiB 5 s, 64 KiB
+// 0.9 s; 256 KiB of the 13-word text 5 s), where HashTable4 takes 20 ms and
+// `xz --lzma2=mf=bt4` 0.12 s.
+func slowMatcher(d dataSpec, m lzma.MatchAlgorithm) bool {
+	return m == lzma.BinaryTree && d.size > 1<<16 && (d.kind == kindText || d.kind == kindSmallAlphabet)
+}
+
+// candidate/go/xz-10: xz.Reader allocates a fresh dictionary of the stream's
+// dictionary size (and a decoder) for every block: a 256 KiB file that xz
+// wrote with --block-size=1 (262144 blocks, 8 MiB dictionary) takes over 80 s
+// and gigabytes of heap in the Reader, where `xz -dc` takes 0.07 s.
+func manyBlocks(a xzArgs, dataLen int) bool {
+	return a.blockSize > 0 && dataLen/a.blockSize > 4096
+}
+
+func short(b []byte) string {
+	if len(b) <= 48 {
+		return fmt.Sprintf("%q", b)
+	}
+	return fmt.Sprintf("%q... (%d bytes)", b[:48], len(b))
+}
+
+func firstDiff(a, b []byte) int {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if a[i] != b[i] {
+			return i
+		}
+	}
+	return min(len(a), len(b))
+}
+
+func padding(n int) []byte { return make([]byte, 4*n) }
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// extraStream is a further stream concatenated after the first, with 4-byte
+// padding units before it.
+type extraStream struct {
+	data   dataSpec
+	cfg    xzConfig
+	writes writePlan
+	pad    int
+}
+
+func (e extraStream) String() string {
+	return fmt.Sprintf("%d padding bytes, then %v with %v, %v", 4*e.pad, e.data, e.cfg, e.writes)
+}
+
+var extraStreams = hegel.Composite(func(tc hegel.TestCase) extraStream {
+	return extraStream{data: hegel.Draw(tc, dataSpecs), cfg: hegel.Draw(tc, xzConfigs), writes: hegel.Draw(tc, writePlans), pad: hegel.Draw(tc, maybe(50, hegel.Integers(1, 3)))}
+})
+
+// roundTripCase: the data, the Writer's configuration and chunking, further
+// streams, trailing padding units, the Reader's DictCap and adapter, and the
+// read chunking.
+type roundTripCase struct {
+	data        dataSpec
+	cfg         xzConfig
+	writes      writePlan
+	extra       []extraStream
+	trailingPad int
+	readerDict  int
+	wrap        string
+	reads       readPlan
+}
+
+func (c roundTripCase) GoString() string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "%v with %v, %v; %d extra streams, %d trailing padding bytes, ReaderConfig.DictCap %d, %s, %v", c.data, c.cfg, c.writes, len(c.extra), 4*c.trailingPad, c.readerDict, c.wrap, c.reads)
+	for i, e := range c.extra {
+		fmt.Fprintf(&sb, "\n  extra %d: %v", i, e)
+	}
+	return sb.String()
+}
+
+var roundTripCases = hegel.Composite(func(tc hegel.TestCase) roundTripCase {
+	return roundTripCase{
+		data:        hegel.Draw(tc, dataSpecs),
+		cfg:         hegel.Draw(tc, xzConfigs),
+		writes:      hegel.Draw(tc, writePlans),
+		extra:       hegel.Draw(tc, weighted(choice[[]extraStream]{7, hegel.Just[[]extraStream](nil)}, choice[[]extraStream]{3, many(extraStreams, 1, 2)})),
+		trailingPad: hegel.Draw(tc, maybe(30, hegel.Integers(1, 2))),
+		readerDict:  hegel.Draw(tc, readerDicts),
+		wrap:        hegel.Draw(tc, wraps),
+		reads:       hegel.Draw(tc, readPlans),
+	}
+})
+
+// TestHegelWriterOutputRoundTripsThroughTheReader: whatever the Writer writes
+// under any configuration, the Reader gives back, through any read chunking;
+// concatenated streams (with optional 4-byte padding) decode to the
+// concatenation, and SingleStream stops after the first.
+func TestHegelWriterOutputRoundTripsThroughTheReader(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, roundTripCases)
+		ht.Assume(!slowMatcher(tc.data, tc.cfg.matcher)) // candidate/go/xz-9
+		for _, e := range tc.extra {
+			ht.Assume(!slowMatcher(e.data, e.cfg.matcher)) // candidate/go/xz-9
+		}
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		note(ht, "%s, %d data bytes", describeWriterConfig(c), len(data))
+		out, err := compressGo(c, tc.writes, data)
+		if err != nil {
+			mismatch(ht, writerShape(c, len(data)), "%v\n%s, data %s", err, describeWriterConfig(c), short(data))
+		}
+		shape := writerShape(c, len(data)) // of any of the streams, the first one's first
+		if !xz.ValidHeader(out[:12]) {
+			fail(ht, "ValidHeader false on the Writer's own header %x\n%s", out[:12], describeWriterConfig(c))
+		}
+
+		// concatenation
+		streams := [][]byte{out}
+		want := append([]byte(nil), data...)
+		joined := append([]byte(nil), out...)
+		for _, e := range tc.extra {
+			d2 := e.data.bytes()
+			c2 := e.cfg.config(len(d2))
+			o2, err := compressGo(c2, e.writes, d2)
+			if err != nil {
+				mismatch(ht, writerShape(c2, len(d2)), "second stream: %v\n%s", err, describeWriterConfig(c2))
+			}
+			if shape == "" {
+				shape = writerShape(c2, len(d2))
+			}
+			joined = append(joined, padding(e.pad)...)
+			joined = append(joined, o2...)
+			streams = append(streams, o2)
+			want = append(want, d2...)
+		}
+		trailingPad := tc.trailingPad > 0
+		joined = append(joined, padding(tc.trailingPad)...)
+
+		rc := xz.ReaderConfig{DictCap: tc.readerDict}
+		src := wrap(tc.wrap, bytes.NewReader(joined))
+		r, err := rc.NewReader(src)
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s, %d streams, %s", err, describeWriterConfig(c), len(streams), tc.wrap)
+		}
+		got, err := tc.reads.readAll(r, len(want)+1<<20)
+		if err != nil {
+			mismatch(ht, shape, "Read: %v after %d of %d bytes\n%s, %d streams (%d extra, trailing padding %v), reader %s, data %s", err, len(got), len(want), describeWriterConfig(c), len(streams), len(tc.extra), trailingPad, tc.wrap, short(data))
+		}
+		if !bytes.Equal(got, want) {
+			mismatch(ht, shape, "decoded %d bytes, want %d (first difference at %d)\n%s, %d streams, reader %s, data %s", len(got), len(want), firstDiff(got, want), describeWriterConfig(c), len(streams), tc.wrap, short(data))
+		}
+		// a further Read stays at EOF
+		k, err := r.Read(make([]byte, 10))
+		if k != 0 || err != io.EOF {
+			fail(ht, "Read after EOF gave %d, %v", k, err)
+		}
+
+		// single-stream mode: the first stream only, then an error if anything follows
+		if len(streams) > 1 || trailingPad {
+			r1, err := xz.ReaderConfig{SingleStream: true}.NewReader(bytes.NewReader(joined))
+			if err != nil {
+				fail(ht, "SingleStream NewReader: %v", err)
+			}
+			got1, err := tc.reads.readAll(r1, len(data)+1<<20)
+			if !bytes.Equal(got1, data) {
+				fail(ht, "SingleStream decoded %d bytes, want the first stream's %d (err %v)", len(got1), len(data), err)
+			}
+			if err == nil {
+				fail(ht, "SingleStream reached EOF although %d bytes follow the first stream", len(joined)-len(out))
+			}
+		}
+	})
+}
+
+// writerCase: the data, the Writer's configuration and chunking.
+type writerCase struct {
+	data   dataSpec
+	cfg    xzConfig
+	writes writePlan
+}
