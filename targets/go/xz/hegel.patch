+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// Several properties fork the xz tool two to six times per case, so on a
+	// loaded machine a case can take over a second; Hegel's too-slow health
+	// check would then fail the run (and hegel-go reports that without a
+	// message). The slowness is the oracle's, not a test problem.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("XZ_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1 the
+// Known switches are on, the shapes are left out of the generators (shaped) or
+// their checks are skipped, and a mismatch that still has a known shape is
+// skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known switches off the input shapes of recorded bugs (see bugs.toml); every
+// switch is off by default, so the properties draw the shapes and fail on the
+// bugs (and are declared as expected failures beside their pins in
+// hegel_pins_test.go), and on under HEGEL_NO_KNOWN=1, which makes the
+// properties run clean.
+var Known = struct {
+	truncatedBlockHeaderIsEOF bool // xz/1: a stream cut inside or just before a block header ends with a clean EOF
+	smallDictNoSpace          bool // xz/2: incompressible data with DictCap < 64 KiB fails with "insufficient space" (or, below 64 KiB of input, is silently cut: Writer2.Close swallows the error, xz/5)
+	binaryTreeMatcher         bool // xz/3: Matcher BinaryTree writes undecodable streams (classic and LZMA2)
+	sizeZeroHeader            bool // xz/4: SizeInHeader with Size 0 writes an unknown-size header without an EOS marker
+	writer2CloseSwallows      bool // xz/5: Writer2.Close returns nil when the flush fails
+	lzmaWriterAfterClose      bool // xz/6: lzma.Writer accepts Write and Close after Close
+	emptyReadEOF              bool // xz/7: lzma.Reader.Read with an empty buffer returns io.EOF while output is still buffered
+	lzma2PackedSizeUnchecked  bool // xz/8: an LZMA2 chunk's compressed-size field is not verified against what the decoder consumed
+}{truncatedBlockHeaderIsEOF: noKnown, smallDictNoSpace: noKnown, binaryTreeMatcher: noKnown, sizeZeroHeader: noKnown, writer2CloseSwallows: noKnown, lzmaWriterAfterClose: noKnown, emptyReadEOF: noKnown, lzma2PackedSizeUnchecked: noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is
+// that of the recorded bug shape names ("" for none): the failure names the
+// shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped
+// instead (rare then, since the generators leave most shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format = "the shape of " + shape + ": " + format
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// positions are taken modulo the live size of whatever they index.
+var positions = hegel.Integers(0, 1<<20)
+
+func at(pos, size int) int {
+	if size <= 0 {
+		return 0
+	}
+	return pos % size
+}
+
+// ---------------------------------------------------------------------------
+// Data. Bulk bytes come from math/rand seeded by a drawn value, so the shape
+// (kind, size, seed) is what Hegel shrinks and bytes() renders it.
+
+type dataKind int
+
+const (
+	kindRandom dataKind = iota
+	kindText
+	kindRuns
+	kindRepeats
+	kindSmallAlphabet
+	kindMixed
+)
+
+var kindNames = []string{"random", "text", "runs", "repeats", "small-alphabet", "mixed"}
+
+var words = []string{"the ", "quick ", "brown ", "fox ", "jumps ", "over ", "lazy ", "dog.\n", "xz ", "lzma2 ", "0", "1", "\t"}
+
+func fill(rng *rand.Rand, kind dataKind, size int) []byte {
+	out := make([]byte, size)
+	switch kind {
+	case kindRandom:
+		rng.Read(out)
+	case kindText: // text of a small vocabulary
+		var b strings.Builder
+		for b.Len() < size {
+			b.WriteString(words[rng.Intn(len(words))])
+		}
+		copy(out, b.String())
+	case kindRuns: // constant runs
+		for i := 0; i < size; {
+			c := byte(rng.Intn(256))
+			l := 1 + rng.Intn(300)
+			for j := 0; j < l && i < size; j++ {
+				out[i] = c
+				i++
+			}
+		}
+	case kindRepeats: // random with long-distance repeats
+		rng.Read(out)
+		for k := 0; k < 8 && size > 16; k++ {
+			l := 1 + rng.Intn(size/2)
+			src := rng.Intn(size - l + 1)
+			dst := rng.Intn(size - l + 1)
+			copy(out[dst:dst+l], out[src:src+l])
+		}
+	case kindSmallAlphabet:
+		alpha := []byte("ab")
+		if rng.Intn(2) == 0 {
+			alpha = []byte("abcd\n")
+		}
+		for i := range out {
+			out[i] = alpha[rng.Intn(len(alpha))]
+		}
+	default: // mixed pieces
+		for i := 0; i < size; {
+			l := 1 + rng.Intn(1000)
+			if l > size-i {
+				l = size - i
+			}
+			switch rng.Intn(3) {
+			case 0:
+				rng.Read(out[i : i+l])
+			case 1:
+				c := byte(rng.Intn(256))
+				for j := 0; j < l; j++ {
+					out[i+j] = c
+				}
+			default:
+				for j := 0; j < l; j++ {
+					out[i+j] = byte('a' + rng.Intn(4))
+				}
+			}
+			i += l
+		}
+	}
+	return out
+}
+
+// dataSpec is the input of a case: size bytes of the kind from a PRNG seeded
+// with seed.
+type dataSpec struct {
+	size int
+	kind dataKind
+	seed int64
+}
+
+func (d dataSpec) bytes() []byte { return fill(rand.New(rand.NewSource(d.seed)), d.kind, d.size) }
+
+func (d dataSpec) String() string {
+	return fmt.Sprintf("%d %s bytes (seed %d)", d.size, kindNames[d.kind], d.seed)
+}
+
+var (
+	// byteSizes: empty a tenth of the time, mostly small, sometimes past the
+	// 64 KiB chunk, rarely up to 256 KiB; shrinks to 0.
+	byteSizes = weighted(
+		choice[int]{1, hegel.Just(0)},
+		choice[int]{3, hegel.Integers(1, 64)},
+		choice[int]{3, hegel.Integers(65, 4096)},
+		choice[int]{2, hegel.Integers(4097, 1<<16)},
+		choice[int]{1, hegel.Integers(1<<16+1, 1<<18)},
+	)
+	// nonEmptySizes: the same without the empty input.
+	nonEmptySizes = weighted(
+		choice[int]{3, hegel.Integers(1, 64)},
+		choice[int]{3, hegel.Integers(65, 4096)},
+		choice[int]{2, hegel.Integers(4097, 1<<16)},
+		choice[int]{1, hegel.Integers(1<<16+1, 1<<18)},
+	)
+	dataKinds = hegel.SampledFrom([]dataKind{kindRandom, kindText, kindRuns, kindRepeats, kindSmallAlphabet, kindMixed})
+	seeds     = hegel.Integers[int64](0, 1<<40)
+)
+
+// dataSpecsOf draws a dataSpec with its size from sizes.
+func dataSpecsOf(sizes hegel.Generator[int]) hegel.Generator[dataSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) dataSpec {
+		return dataSpec{size: hegel.Draw(tc, sizes), kind: hegel.Draw(tc, dataKinds), seed: hegel.Draw(tc, seeds)}
+	})
+}
+
+var (
+	dataSpecs         = dataSpecsOf(byteSizes)
+	nonEmptyDataSpecs = dataSpecsOf(nonEmptySizes)
+)
+
+// ---------------------------------------------------------------------------
+// Configuration records, rendered into the library's config structs.
+
+// dictCaps: the default (0) first, then edges from the minimum up to 8 MiB;
+// the values under 64 KiB are the shape of xz/2 with incompressible data
+// longer than the dictionary.
+var dictCaps = []int{0, 4096, 8192, 12288, 1 << 14, 3 << 13, 1 << 16, 1 << 17, 1 << 20, 3 << 19, 8 << 20}
+
+var (
+	// lzma2Props: lc+lp <= 4, as LZMA2 requires.
+	lzma2Props = hegel.Composite(func(tc hegel.TestCase) *lzma.Properties {
+		lc := hegel.Draw(tc, hegel.Integers(0, 4))
+		return &lzma.Properties{LC: lc, LP: hegel.Draw(tc, hegel.Integers(0, 4-lc)), PB: hegel.Draw(tc, hegel.Integers(0, 4))}
+	})
+	// classicProps: lc up to 8 most of the time (liblzma refuses lc+lp > 4,
+	// which the classic property expects).
+	classicProps = hegel.Composite(func(tc hegel.TestCase) *lzma.Properties {
+		return &lzma.Properties{
+			LC: hegel.Draw(tc, weighted(choice[int]{40, hegel.Integers(0, 4)}, choice[int]{60, hegel.Integers(0, 8)})),
+			LP: hegel.Draw(tc, hegel.Integers(0, 4)),
+			PB: hegel.Draw(tc, hegel.Integers(0, 4)),
+		}
+	})
+	dictCapPool = hegel.SampledFrom(dictCaps)
+	bufSizes    = maybe(30, pick(4096, 8192, 300, 1<<16))
+	// matchers: the default HashTable4 first, BinaryTree (the shape of xz/3)
+	// as the second alternative; never BinaryTree under HEGEL_NO_KNOWN=1.
+	matchers = shaped[hegel.Generator[lzma.MatchAlgorithm]](
+		weighted(choice[lzma.MatchAlgorithm]{70, hegel.Just(lzma.HashTable4)}, choice[lzma.MatchAlgorithm]{30, hegel.Just(lzma.BinaryTree)}),
+		hegel.Just(lzma.HashTable4))
+	// readerDicts: a ReaderConfig.DictCap a third of the time (0: the default).
+	readerDicts = maybe(30, dictCapPool)
+)
+
+func propsName(p *lzma.Properties) string {
+	if p == nil {
+		return "nil"
+	}
+	return p.String()
+}
+
+// blockSpec is the Writer's BlockSize: none (the default, one block), a
+// small size, a size relative to the data (n taken modulo the length plus
+// one), or a large one.
+type blockSpec struct {
+	kind blockKind
+	n    int
+}
+
+type blockKind int
+
+const (
+	blockNone blockKind = iota
+	blockSmall
+	blockRelative
+	blockLarge
+)
+
+func (b blockSpec) size(dataLen int) int64 {
+	switch b.kind {
+	case blockSmall, blockLarge:
+		return int64(b.n)
+	case blockRelative:
+		return int64(1 + at(b.n, dataLen+1))
+	}
+	return 0
+}
+
+func (b blockSpec) String() string {
+	switch b.kind {
+	case blockSmall:
+		return fmt.Sprintf("small %d", b.n)
+	case blockRelative:
+		return fmt.Sprintf("relative %d", b.n)
+	case blockLarge:
+		return fmt.Sprintf("large %d", b.n)
+	}
+	return "none"
+}
+
+var blockSpecs = weighted(
+	choice[blockSpec]{2, hegel.Just(blockSpec{})},
+	choice[blockSpec]{1, hegel.Map(hegel.Integers(1, 64), func(n int) blockSpec { return blockSpec{blockSmall, n} })},
+	choice[blockSpec]{1, hegel.Map(positions, func(n int) blockSpec { return blockSpec{blockRelative, n} })},
+	choice[blockSpec]{1, hegel.Map(hegel.Integers(1, 1<<20), func(n int) blockSpec { return blockSpec{blockLarge, n} })},
+)
+
+// checkKind is the Writer's check: the default (CRC64) first.
+type checkKind int
+
+const (
+	checkDefault checkKind = iota
+	checkCRC32
+	checkCRC64
+	checkSHA256
+	checkNone
+)
+
+var checkNames = []string{"default", "CRC32", "CRC64", "SHA-256", "none"}
+
+func (k checkKind) String() string { return checkNames[k] }
+
+var (
+	checks = hegel.SampledFrom([]checkKind{checkDefault, checkDefault, checkCRC32, checkCRC64, checkSHA256, checkNone})
+	// checked: the checks that leave a checksum in the stream.
+	checked = hegel.SampledFrom([]checkKind{checkDefault, checkCRC32, checkCRC64, checkSHA256})
+)
+
+// xzConfig is the .xz Writer's configuration as drawn; config renders it.
+type xzConfig struct {
+	props   *lzma.Properties
+	dictCap int
+	bufSize int
+	block   blockSpec
+	check   checkKind
+	matcher lzma.MatchAlgorithm
+}
+
+// config renders the record for data of dataLen bytes.
+func (c xzConfig) config(dataLen int) xz.WriterConfig {
+	w := xz.WriterConfig{Properties: c.props, DictCap: c.dictCap, BufSize: c.bufSize, BlockSize: c.block.size(dataLen), Matcher: c.matcher}
+	switch c.check {
+	case checkCRC32:
+		w.CheckSum = xz.CRC32
+	case checkCRC64:
+		w.CheckSum = xz.CRC64
+	case checkSHA256:
+		w.CheckSum = xz.SHA256
+	case checkNone:
+		w.NoCheckSum = true
+	}
+	// Every block builds a fresh dictionary and matcher of DictCap bytes, so
+	// thousands of tiny blocks with a large dictionary take minutes: keep the
+	// block count within 64 (not a recorded bug; see the README).
+	if w.BlockSize > 0 && int64(dataLen)/w.BlockSize > 64 {
+		w.BlockSize = int64(dataLen)/64 + 1
+	}
+	if Known.smallDictNoSpace && w.DictCap != 0 && w.DictCap < 1<<16 && dataLen > w.DictCap {
+		w.DictCap = 1 << 16
+	}
+	return w
+}
+
+func (c xzConfig) String() string {
+	return fmt.Sprintf("{props %s, DictCap %d, BufSize %d, block %s, check %s, %s}", propsName(c.props), c.dictCap, c.bufSize, c.block, c.check, c.matcher)
+}
+
+var xzConfigs = hegel.Composite(func(tc hegel.TestCase) xzConfig {
+	return xzConfig{
+		props:   hegel.Draw(tc, maybe(70, lzma2Props)),
+		dictCap: hegel.Draw(tc, dictCapPool),
+		bufSize: hegel.Draw(tc, bufSizes),
+		block:   hegel.Draw(tc, blockSpecs),
+		check:   hegel.Draw(tc, checks),
+		matcher: hegel.Draw(tc, matchers),
+	}
+})
+
+func describeWriterConfig(c xz.WriterConfig) string {
+	return fmt.Sprintf("WriterConfig{Properties: %s, DictCap: %d, BufSize: %d, BlockSize: %d, CheckSum: %#x, NoCheckSum: %v, Matcher: %s}",
+		propsName(c.Properties), c.DictCap, c.BufSize, c.BlockSize, c.CheckSum, c.NoCheckSum, c.Matcher)
+}
+
+// checkName is the name `xz --robot -l` prints for the check the config selects.
+func checkName(c xz.WriterConfig) string {
+	if c.NoCheckSum {
+		return "None"
+	}
+	switch c.CheckSum {
+	case xz.CRC32:
+		return "CRC32"
+	case xz.SHA256:
+		return "SHA-256"
+	default:
+		return "CRC64"
+	}
+}
+
+// expectedBlocks is the number of blocks the Writer must produce for dataLen
+// bytes: one per BlockSize bytes, at least one.
+func expectedBlocks(c xz.WriterConfig, dataLen int) int {
+	if c.BlockSize <= 0 || dataLen == 0 {
+		return 1
+	}
+	return int((int64(dataLen) + c.BlockSize - 1) / c.BlockSize)
+}
+
+// lzmaConfig is the classic lzma.Writer's configuration as drawn: the size
+// mode is how the data's size reaches the header ("eos": no size and an EOS
+// marker; "size": Size alone, which the Writer writes for a positive size and
+// otherwise falls back to a marker; "size+eos": both; "sizeInHeader":
+// SizeInHeader with the size, 0 included - the shape of xz/4).
+type lzmaConfig struct {
+	props    *lzma.Properties
+	dictCap  int
+	bufSize  int
+	matcher  lzma.MatchAlgorithm
+	sizeMode string
+}
+
+// mode is the effective size mode for data of dataLen bytes: under
+// HEGEL_NO_KNOWN=1 an explicit size of 0 is not written.
+func (c lzmaConfig) mode(dataLen int) string {
+	if Known.sizeZeroHeader && dataLen == 0 {
+		return "eos"
+	}
+	return c.sizeMode
+}
+
+func (c lzmaConfig) config(dataLen int) lzma.WriterConfig {
+	w := lzma.WriterConfig{Properties: c.props, DictCap: c.dictCap, BufSize: c.bufSize, Matcher: c.matcher}
+	switch c.mode(dataLen) {
+	case "size":
+		w.Size = int64(dataLen)
+	case "size+eos":
+		w.Size = int64(dataLen)
+		w.EOSMarker = true
+	case "sizeInHeader":
+		w.SizeInHeader = true
+		w.Size = int64(dataLen)
+	}
+	return w
+}
+
+func (c lzmaConfig) String() string {
+	return fmt.Sprintf("{props %s, DictCap %d, BufSize %d, %s, %s}", propsName(c.props), c.dictCap, c.bufSize, c.matcher, c.sizeMode)
+}
+
+func describeLzmaConfig(c lzma.WriterConfig) string {
+	return fmt.Sprintf("lzma.WriterConfig{Properties: %s, DictCap: %d, BufSize: %d, Matcher: %s, SizeInHeader: %v, Size: %d, EOSMarker: %v}",
+		propsName(c.Properties), c.DictCap, c.BufSize, c.Matcher, c.SizeInHeader, c.Size, c.EOSMarker)
+}
+
+var (
+	sizeModes   = pick("eos", "size", "size+eos", "sizeInHeader")
+	lzmaConfigs = hegel.Composite(func(tc hegel.TestCase) lzmaConfig {
+		return lzmaConfig{
+			props:    hegel.Draw(tc, maybe(70, classicProps)),
+			dictCap:  hegel.Draw(tc, dictCapPool),
+			bufSize:  hegel.Draw(tc, bufSizes),
+			matcher:  hegel.Draw(tc, matchers),
+			sizeMode: hegel.Draw(tc, sizeModes),
+		}
+	})
+)
+
+// writer2Config is lzma.Writer2's configuration as drawn.
+type writer2Config struct {
+	props   *lzma.Properties
+	dictCap int
+	bufSize int
+	matcher lzma.MatchAlgorithm
+}
+
+func (c writer2Config) config(dataLen int) lzma.Writer2Config {
+	w := lzma.Writer2Config{Properties: c.props, DictCap: c.dictCap, BufSize: c.bufSize, Matcher: c.matcher}
+	if Known.smallDictNoSpace && w.DictCap != 0 && w.DictCap < 1<<16 && dataLen > w.DictCap {
+		w.DictCap = 1 << 16
+	}
+	return w
+}
+
+// dict is the dictionary size the stream was written with (the default when 0).
+func (c writer2Config) dict(dataLen int) int {
+	if d := c.config(dataLen).DictCap; d != 0 {
+		return d
+	}
+	return 8 << 20
+}
