+// Raw LZMA2 chunk sequences.
+
+// TestHegelLzma2ChunkSequencesRoundTrip: Writer2 output (with Flush calls in
+// between) decodes with Reader2 and with `xz --format=raw --lzma2 -dc`; xz's
+// raw LZMA2 decodes with Reader2; EOS() reports the end-of-stream chunk.
+func TestHegelLzma2ChunkSequencesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		c := lzma.Writer2Config{Properties: genProps(ht, true), DictCap: pick(ht, dictCaps...)}
+		if Known.smallDictNoSpace && c.DictCap != 0 && c.DictCap < 1<<16 && len(data) > c.DictCap {
+			c.DictCap = 1 << 16
+		}
+		if chance(ht, 30) {
+			c.BufSize = pick(ht, 4096, 8192, 300, 1<<16)
+		}
+		if chance(ht, 30) && !Known.binaryTreeMatcher {
+			c.Matcher = lzma.BinaryTree
+		}
+		p := "nil"
+		if c.Properties != nil {
+			p = c.Properties.String()
+		}
+		descr := fmt.Sprintf("Writer2Config{Properties: %s, DictCap: %d, BufSize: %d, Matcher: %s}", p, c.DictCap, c.BufSize, c.Matcher)
+		note(ht, "%s, %d data bytes", descr, len(data))
+		var buf bytes.Buffer
+		w, err := c.NewWriter2(&buf)
+		if err != nil {
+			fail(ht, "NewWriter2: %v\n%s", err, descr)
+		}
+		flushes := 0
+		rest := data
+		for len(rest) > 0 {
+			k := len(rest)
+			if chance(ht, 50) {
+				k = n(ht, 1, len(rest))
+			}
+			if _, err := w.Write(rest[:k]); err != nil {
+				fail(ht, "Write: %v\n%s", err, descr)
+			}
+			rest = rest[k:]
+			if chance(ht, 40) {
+				if err := w.Flush(); err != nil {
+					fail(ht, "Flush: %v\n%s", err, descr)
+				}
+				flushes++
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v\n%s", err, descr)
+		}
+		out := buf.Bytes()
+		dict := c.DictCap
+		if dict == 0 {
+			dict = 8 << 20
+		}
+
+		src, wrapName := wrapReader(ht, bytes.NewReader(out))
+		r, err := lzma.Reader2Config{DictCap: dict}.NewReader2(src)
+		if err != nil {
+			fail(ht, "NewReader2: %v\n%s", err, descr)
+		}
+		got, err := readAllChunked(ht, r, len(data)+1<<20, true)
+		if err != nil {
+			fail(ht, "Read: %v after %d of %d bytes\n%s, %d flushes, reader %s", err, len(got), len(data), descr, flushes, wrapName)
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "decoded %d bytes, want %d (first difference at %d)\n%s, %d flushes, reader %s", len(got), len(data), firstDiff(got, data), descr, flushes, wrapName)
+		}
+		if !r.EOS() {
+			fail(ht, "EOS() false after reading the closed stream to its end\n%s", descr)
+		}
+
+		xzGot, err := xzCLI(t, out, "--format=raw", "--lzma2=dict="+strconv.Itoa(dict), "-dc")
+		if err != nil {
+			fail(ht, "%v\n%s, %d flushes, data %s\nstream %x", err, descr, flushes, short(data), out[:min(len(out), 64)])
+		}
+		if !bytes.Equal(xzGot, data) {
+			fail(ht, "xz --format=raw -dc gave %d bytes, want %d (first difference at %d)\n%s", len(xzGot), len(data), firstDiff(xzGot, data), descr)
+		}
+
+		lc := n(ht, 0, 4)
+		xdict := pick(ht, 4096, 1<<16, 1<<20, 8<<20)
+		args := []string{"-c", "--format=raw", fmt.Sprintf("--lzma2=dict=%d,lc=%d,lp=%d,pb=%d,mf=%s", xdict, lc, n(ht, 0, 4-lc), n(ht, 0, 4), pick(ht, "hc3", "hc4", "bt2", "bt3", "bt4"))}
+		xzOut, err := xzCLI(t, data, args...)
+		if err != nil {
+			fail(ht, "oracle failed: %v", err)
+		}
+		r2, err := lzma.Reader2Config{DictCap: xdict}.NewReader2(bytes.NewReader(xzOut))
+		if err != nil {
+			fail(ht, "NewReader2 on xz %s output: %v", strings.Join(args, " "), err)
+		}
+		got2, err := readAllChunked(ht, r2, len(data)+1<<20, true)
+		if err != nil {
+			fail(ht, "Read of xz %s output: %v after %d of %d bytes", strings.Join(args, " "), err, len(got2), len(data))
+		}
+		if !bytes.Equal(got2, data) {
+			fail(ht, "xz %s output decoded to %d bytes, want %d (first difference at %d)", strings.Join(args, " "), len(got2), len(data), firstDiff(got2, data))
+		}
+		if !r2.EOS() {
+			fail(ht, "EOS() false after xz's raw stream (%s)", strings.Join(args, " "))
+		}
+	})
+}
