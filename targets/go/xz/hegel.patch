@@ -0,0 +1,281 @@
+package xz_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the correct
+// behaviour, so it fails while the bug is open; target.toml lists them as
+// expected failures.
+
+import (
+	"bytes"
+	"io"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/ulikunitz/xz"
+	"github.com/ulikunitz/xz/lzma"
+)
+
+func mustCompress(t *testing.T, c xz.WriterConfig, data []byte) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	w, err := c.NewWriter(&buf)
+	if err != nil {
+		t.Fatalf("NewWriter: %v", err)
+	}
+	if _, err := w.Write(data); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func decode(in []byte) ([]byte, error) {
+	r, err := xz.NewReader(bytes.NewReader(in))
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+// xz/1: every proper prefix of a valid stream must fail to decode. A cut
+// inside a block header, or exactly between two blocks, is reported as a
+// clean EOF with the data decoded so far (readBlockHeader passes io.EOF up as
+// the end of the stream, without index or footer).
+func TestHegelPinTruncatedStreamsAreErrors(t *testing.T) {
+	data := []byte(strings.Repeat("jumps over the lazy dog. ", 8))
+	stream := mustCompress(t, xz.WriterConfig{BlockSize: 40, NoCheckSum: true}, data)
+	if got, err := decode(stream); err != nil || !bytes.Equal(got, data) {
+		t.Fatalf("the whole stream: %d bytes, %v", len(got), err)
+	}
+	var clean []int
+	for cut := 1; cut < len(stream); cut++ {
+		got, err := decode(stream[:cut])
+		if err == nil {
+			clean = append(clean, cut)
+			if len(clean) <= 4 {
+				t.Errorf("stream cut at %d of %d bytes: clean EOF with %d of %d data bytes (stream %x | %x)", cut, len(stream), len(got), len(data), stream[:cut], stream[cut:])
+			}
+		}
+		if !bytes.Equal(got, data[:min(len(got), len(data))]) {
+			t.Errorf("stream cut at %d: %d bytes that are not a prefix of the data", cut, len(got))
+		}
+	}
+	if len(clean) > 0 {
+		t.Errorf("%d of %d proper prefixes decode with a clean EOF: cuts at %v", len(clean), len(stream)-1, clean)
+	}
+	// The same end of input inside a block header reached without a cut: in the
+	// 32-byte stream `xz --check=none` writes for empty input (header, an empty
+	// index, footer; no block) the index indicator (byte 12, 0x00) flipped to
+	// 0x12 announces a 76-byte block header of which only 19 bytes exist.
+	// xz: "Unexpected end of input"; the Reader: 0 bytes and a clean EOF.
+	empty := []byte{
+		0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x00, 0xff, 0x12, 0xd9, 0x41, // stream header, check none
+		0x00, 0x00, 0x00, 0x00, 0x1c, 0xdf, 0x44, 0x21, // index: indicator, 0 records, padding, CRC32
+		0x06, 0x72, 0x9e, 0x7a, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x59, 0x5a, // footer
+	}
+	if got, err := decode(empty); err != nil || len(got) != 0 {
+		t.Fatalf("the empty stream: %d bytes, %v", len(got), err)
+	}
+	mutant := append([]byte(nil), empty...)
+	mutant[12] = 0x12
+	if got, err := decode(mutant); err == nil {
+		t.Errorf("index indicator flipped to a block-header size byte (%x): clean EOF with %d bytes", mutant, len(got))
+	}
+}
+
+// xz/8: an LZMA2 chunk header's compressed-size field is never checked against
+// what the decoder consumed (lzma/reader2.go wraps the chunk in a LimitReader of
+// that size and moves on when the uncompressed size is reached). Overstated, the
+// stream decodes as if correct where xz reports "Compressed data is corrupt";
+// understated on a stream without a check, the chunk ends early and the Reader
+// returns a clean EOF with the data missing.
+func TestHegelPinLzma2PackedSizeIsVerified(t *testing.T) {
+	data := []byte("The quick brown fox jumps over the lazy dog, and then does it again and again.")
+	for _, c := range []xz.WriterConfig{{}, {NoCheckSum: true}} {
+		valid := mustCompress(t, c, data)
+		offs := lzma2PackedSizeOffsets(valid)
+		if len(offs) != 2 {
+			t.Fatalf("%+v: expected one LZMA chunk, packed-size offsets %v in %x", c, offs, valid)
+		}
+		for _, v := range []struct {
+			off int
+			val byte
+			way string
+		}{{offs[0], 0x74, "overstated"}, {offs[1], 0x01, "understated"}} {
+			mutant := append([]byte(nil), valid...)
+			mutant[v.off] = v.val
+			got, err := decode(mutant)
+			if err == nil {
+				t.Errorf("%+v: compressed size %s (byte %d = %#x): no error, %d of %d bytes (intact %v); xz: corrupt", c, v.way, v.off, v.val, len(got), len(data), bytes.Equal(got, data))
+			}
+		}
+	}
+}
+
+// xz/2: incompressible data with a dictionary under 64 KiB fails with
+// "insufficient space" (an uncompressed LZMA2 chunk is copied from a
+// dictionary buffer that no longer holds all of it).
+func TestHegelPinSmallDictionaryCompressesIncompressibleData(t *testing.T) {
+	data := make([]byte, 70000)
+	rand.New(rand.NewSource(1)).Read(data)
+	for _, dict := range []int{4096, 8192, 32768} {
+		var buf bytes.Buffer
+		w, err := xz.WriterConfig{DictCap: dict}.NewWriter(&buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, werr := w.Write(data)
+		cerr := w.Close()
+		if werr != nil || cerr != nil {
+			t.Errorf("xz.WriterConfig{DictCap: %d} on 70000 random bytes: Write %v, Close %v", dict, werr, cerr)
+			continue
+		}
+		if got, err := decode(buf.Bytes()); err != nil || !bytes.Equal(got, data) {
+			t.Errorf("DictCap %d: round trip gave %d bytes, %v", dict, len(got), err)
+		}
+	}
+	var buf bytes.Buffer
+	w2, _ := lzma.Writer2Config{DictCap: 4096}.NewWriter2(&buf)
+	_, werr := w2.Write(data)
+	cerr := w2.Close()
+	if werr != nil || cerr != nil {
+		t.Errorf("lzma.Writer2Config{DictCap: 4096} on 70000 random bytes: Write %v, Close %v", werr, cerr)
+	}
+}
+
+// xz/3: the classic Writer with Matcher BinaryTree writes streams that
+// neither lzma.Reader nor xz can decode ("distance out of range").
+func TestHegelPinBinaryTreeMatcherWritesDecodableStreams(t *testing.T) {
+	rng := rand.New(rand.NewSource(11))
+	failures := 0
+	for trial := 0; trial < 300; trial++ {
+		size := 100 + rng.Intn(3000)
+		data := make([]byte, size)
+		rng.Read(data)
+		for k := 0; k < 8; k++ {
+			l := 1 + rng.Intn(size/2)
+			src := rng.Intn(size - l + 1)
+			dst := rng.Intn(size - l + 1)
+			copy(data[dst:dst+l], data[src:src+l])
+		}
+		c := lzma.WriterConfig{Matcher: lzma.BinaryTree, DictCap: []int{4096, 8192, 1 << 16}[trial%3], BufSize: 4096}
+		var buf bytes.Buffer
+		w, err := c.NewWriter(&buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w.Write(data)
+		if err := w.Close(); err != nil {
+			t.Fatalf("Close: %v", err)
+		}
+		r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+		if err != nil {
+			t.Fatalf("NewReader: %v", err)
+		}
+		got, err := io.ReadAll(r)
+		if err != nil || !bytes.Equal(got, data) {
+			failures++
+			if failures <= 3 {
+				t.Errorf("trial %d (%d bytes, DictCap %d): decoded %d bytes, %v", trial, size, c.DictCap, len(got), err)
+			}
+		}
+	}
+	if failures > 0 {
+		t.Errorf("%d of 300 BinaryTree streams do not decode", failures)
+	}
+}
+
+// xz/4: an explicit size of 0 is written as "unknown size" and no EOS marker
+// follows, so the empty stream cannot be decoded.
+func TestHegelPinExplicitSizeZeroRoundTrips(t *testing.T) {
+	var buf bytes.Buffer
+	w, err := lzma.WriterConfig{SizeInHeader: true, Size: 0}.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatalf("NewReader: %v (stream %x)", err, buf.Bytes())
+	}
+	h, _ := r.Header()
+	got, err := io.ReadAll(r)
+	if err != nil || len(got) != 0 {
+		t.Errorf("empty stream with SizeInHeader: header %+v, read %d bytes, %v (stream %x)", h, len(got), err, buf.Bytes())
+	}
+	if h.Size != 0 {
+		t.Errorf("header Size = %d, want 0", h.Size)
+	}
+}
+
+// xz/5: Writer2.Close returns nil when flushing the last chunk fails.
+func TestHegelPinWriter2CloseReportsTheFlushError(t *testing.T) {
+	sink := &failWriter{limit: 0}
+	w, err := lzma.NewWriter2(sink)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := w.Write([]byte("hello")); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err == nil {
+		t.Errorf("Close returned nil although the underlying writer failed (it got %d bytes)", sink.n)
+	}
+}
+
+// xz/6: lzma.Writer accepts Write and Close after Close and appends more
+// bytes to the finished stream.
+func TestHegelPinLzmaWriterRefusesUseAfterClose(t *testing.T) {
+	var buf bytes.Buffer
+	w, err := lzma.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Write([]byte("hello"))
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	n := buf.Len()
+	if _, err := w.Write([]byte("more")); err == nil {
+		t.Errorf("Write after Close returned nil")
+	}
+	if err := w.Close(); err == nil {
+		t.Errorf("second Close returned nil")
+	}
+	if buf.Len() != n {
+		t.Errorf("the stream grew from %d to %d bytes after Close", n, buf.Len())
+	}
+}
+
+// xz/7: once the decoder has reached the end of the compressed stream,
+// lzma.Reader.Read with an empty buffer returns io.EOF although decoded bytes
+// are still buffered; a caller that treats EOF as the end loses them.
+func TestHegelPinEmptyReadIsNotEOFWhileDataRemains(t *testing.T) {
+	data := []byte("hello world, hello xz")
+	var buf bytes.Buffer
+	w, err := lzma.NewWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Write(data)
+	w.Close()
+	r, err := lzma.NewReader(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := make([]byte, 1)
+	if k, err := r.Read(first); k != 1 || err != nil {
+		t.Fatalf("first Read: %d, %v", k, err)
+	}
+	if k, err := r.Read(nil); k != 0 || err != nil {
+		t.Errorf("Read(nil) after one byte = %d, %v; want 0, nil (%d bytes still to come)", k, err, len(data)-1)
+	}
+	rest, err := io.ReadAll(r)
+	if err != nil || string(first)+string(rest) != string(data) {
+		t.Errorf("after the empty read: %q, %v", rest, err)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..f0f98ae
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,692 @@
+package xz_test
+
+// One narrow property per recorded bug (bugs.toml): each draws the bug's
+// shape region with random contents and judges it by the checks of the wide
+// properties in hegel_test.go. Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region instead (shaped) and passes. Every case here is small
+// and forks the xz tool at most once.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"testing"
+
+	"github.com/ulikunitz/xz"
+	"github.com/ulikunitz/xz/lzma"
+	"hegel.dev/go/hegel"
+)
+
+// hashTable4 is the default matcher, which the narrow properties of the
+// other bugs keep so that each lands on its own bug.
+var hashTable4 = hegel.Just(lzma.HashTable4)
+
+// plainXzConfigs: Writer configurations with the default matcher.
+var plainXzConfigs = hegel.Composite(func(tc hegel.TestCase) xzConfig {
+	c := hegel.Draw(tc, xzConfigs)
+	c.matcher = hegel.Draw(tc, hashTable4)
+	return c
+})
+
+// plainLzmaConfigs: classic Writer configurations with the default matcher.
+var plainLzmaConfigs = hegel.Composite(func(tc hegel.TestCase) lzmaConfig {
+	c := hegel.Draw(tc, lzmaConfigs)
+	c.matcher = hegel.Draw(tc, hashTable4)
+	return c
+})
+
+// smallSizes: the data sizes of the narrow properties.
+var smallSizes = weighted(choice[int]{3, hegel.Integers(1, 64)}, choice[int]{2, hegel.Integers(65, 4096)})
+
+// ---------------------------------------------------------------------------
+// xz/1: a stream cut inside a block header or exactly at a block boundary
+// (before the next block's header or the index) decodes with a clean EOF.
+
+// cut is where a multi-block stream is cut: a block (taken modulo the block
+// count) and a point of it - inside its header, at its end (the boundary
+// before the next block or the index), or inside its data and check.
+type cut struct {
+	block int
+	where string
+	off   int
+}
+
+func (c cut) String() string { return fmt.Sprintf("cut in block %d %s at %d", c.block, c.where, c.off) }
+
+// apply returns the prefix of in that the cut leaves.
+func (c cut) apply(in []byte, l xzLayout) ([]byte, int) {
+	blk := l.blocks[at(c.block, len(l.blocks))]
+	var pos int
+	switch c.where {
+	case "header":
+		pos = blk.start + at(c.off, blk.headerLen)
+	case "boundary":
+		pos = blk.end
+	default: // data
+		pos = blk.start + blk.headerLen + at(c.off, blk.end-blk.start-blk.headerLen)
+	}
+	return in[:pos], pos
+}
+
+// cutCase: data written in small blocks by the Writer with a checksum, and
+// the cut.
+type cutCase struct {
+	data   dataSpec
+	cfg    xzConfig
+	writes writePlan
+	cut    cut
+}
+
+func (c cutCase) GoString() string {
+	return fmt.Sprintf("%v with %v, %v; %v", c.data, c.cfg, c.writes, c.cut)
+}
+
+var (
+	cutPlaces = shaped[hegel.Generator[string]](pick("header", "boundary"), hegel.Just("data"))
+	cuts      = hegel.Composite(func(tc hegel.TestCase) cut {
+		return cut{block: hegel.Draw(tc, positions), where: hegel.Draw(tc, cutPlaces), off: hegel.Draw(tc, positions)}
+	})
+	cutCases = hegel.Composite(func(tc hegel.TestCase) cutCase {
+		cfg := hegel.Draw(tc, plainXzConfigs)
+		cfg.block = blockSpec{blockSmall, hegel.Draw(tc, hegel.Integers(1, 64))}
+		cfg.check = hegel.Draw(tc, checked)
+		cfg.dictCap = hegel.Draw(tc, pick(4096, 8192, 1<<16)) // a small dictionary: every block allocates one
+		return cutCase{data: hegel.Draw(tc, dataSpecsOf(smallSizes)), cfg: cfg, writes: hegel.Draw(tc, writePlans), cut: hegel.Draw(tc, cuts)}
+	})
+)
+
+// TestHegelStreamsCutAtBlockBoundariesAreErrors: a checked multi-block stream
+// cut inside a block header or exactly between blocks (xz/1; under
+// HEGEL_NO_KNOWN=1 inside a block's data or check) is an error for the Reader,
+// as it is for xz.
+func TestHegelStreamsCutAtBlockBoundariesAreErrors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, cutCases)
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		valid, err := compressGo(c, tc.writes, data)
+		if err != nil {
+			mismatch(ht, writerShape(c, len(data)), "%v\n%s", err, describeWriterConfig(c))
+		}
+		bad, pos := tc.cut.apply(valid, layoutOf(valid))
+		note(ht, "%s; cut at %d of %d bytes (%s)", describeWriterConfig(c), pos, len(valid), tc.cut.where)
+		got, goErr := decodeGo(readPlan{[]int{4096}}, bad, len(data)+1<<20)
+		_, xzErr := xzCLI(t, bad, "-dc")
+		if xzErr == nil {
+			fail(ht, "xz decodes the stream cut at %d of %d bytes", pos, len(valid))
+		}
+		if goErr == nil {
+			mismatch(ht, "xz/1", "the Reader returned %d bytes with a clean EOF from the stream cut at %d of %d bytes (%s, data %d bytes); xz: %v\n%s", len(got), pos, len(valid), tc.cut.where, len(data), xzErr, describeWriterConfig(c))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// xz/2: incompressible data longer than a DictCap under 64 KiB.
+
+// smallDictCase: random data longer than the dictionary, the writer (the .xz
+// Writer or lzma.Writer2) and its DictCap.
+type smallDictCase struct {
+	data   dataSpec
+	kind   string
+	dict   int
+	writes writePlan
+}
+
+func (c smallDictCase) GoString() string {
+	return fmt.Sprintf("%s writer with DictCap %d, %v, %v", c.kind, c.dict, c.data, c.writes)
+}
+
+var (
+	smallDicts     = shaped[hegel.Generator[int]](pick(4096, 8192, 12288, 1<<14, 3<<13, 1<<15), pick(1<<16, 1<<17, 1<<20))
+	smallDictCases = hegel.Composite(func(tc hegel.TestCase) smallDictCase {
+		dict := hegel.Draw(tc, smallDicts)
+		return smallDictCase{
+			data:   dataSpec{size: dict + hegel.Draw(tc, hegel.Integers(1, 100000)), kind: kindRandom, seed: hegel.Draw(tc, seeds)},
+			kind:   hegel.Draw(tc, pick("xz", "lzma2")),
+			dict:   dict,
+			writes: hegel.Draw(tc, writePlans),
+		}
+	})
+)
+
+// TestHegelSmallDictionariesCompressIncompressibleData: random data longer
+// than a DictCap under 64 KiB (xz/2; under HEGEL_NO_KNOWN=1 a DictCap of 64
+// KiB or more) is written without an error and round-trips.
+func TestHegelSmallDictionariesCompressIncompressibleData(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, smallDictCases)
+		data := tc.data.bytes()
+		note(ht, "%s writer, DictCap %d, %d random bytes", tc.kind, tc.dict, len(data))
+		var buf bytes.Buffer
+		var w io.WriteCloser
+		var err error
+		if tc.kind == "xz" {
+			w, err = xz.WriterConfig{DictCap: tc.dict}.NewWriter(&buf)
+		} else {
+			w, err = lzma.Writer2Config{DictCap: tc.dict}.NewWriter2(&buf)
+		}
+		if err != nil {
+			fail(ht, "NewWriter: %v", err)
+		}
+		if err := tc.writes.write(w, data); err != nil {
+			mismatch(ht, "xz/2", "%s writer with DictCap %d on %d random bytes: Write: %v", tc.kind, tc.dict, len(data), err)
+		}
+		if err := w.Close(); err != nil {
+			mismatch(ht, "xz/2", "%s writer with DictCap %d on %d random bytes: Close: %v", tc.kind, tc.dict, len(data), err)
+		}
+		var got []byte
+		if tc.kind == "xz" {
+			got, err = decode(buf.Bytes())
+		} else {
+			var r io.Reader
+			r, err = lzma.Reader2Config{DictCap: tc.dict}.NewReader2(bytes.NewReader(buf.Bytes()))
+			if err == nil {
+				got, err = io.ReadAll(r)
+			}
+		}
+		if err != nil || !bytes.Equal(got, data) {
+			mismatch(ht, "xz/2", "%s writer with DictCap %d on %d random bytes: Write and Close succeeded but the %d-byte stream decodes to %d bytes, %v", tc.kind, tc.dict, len(data), buf.Len(), len(got), err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// xz/3: the BinaryTree matcher on small-alphabet data with a small dictionary.
+
+// matcherCase: small-alphabet data, the matcher, a small DictCap and BufSize,
+// and the format (.xz or classic .lzma).
+type matcherCase struct {
+	data    dataSpec
+	matcher lzma.MatchAlgorithm
+	dict    int
+	bufSize int
+	format  string
+	writes  writePlan
+}
+
+func (c matcherCase) GoString() string {
+	return fmt.Sprintf("%s %s with DictCap %d, BufSize %d, %v, %v", c.format, c.matcher, c.dict, c.bufSize, c.data, c.writes)
+}
+
+var (
+	treeMatchers = shaped[hegel.Generator[lzma.MatchAlgorithm]](hegel.Just(lzma.BinaryTree), hashTable4)
+	matcherCases = hegel.Composite(func(tc hegel.TestCase) matcherCase {
+		return matcherCase{
+			data:    dataSpec{size: hegel.Draw(tc, hegel.Integers(10000, 40000)), kind: kindSmallAlphabet, seed: hegel.Draw(tc, seeds)},
+			matcher: hegel.Draw(tc, treeMatchers),
+			dict:    hegel.Draw(tc, pick(4096, 8192, 1<<14)),
+			bufSize: hegel.Draw(tc, pick(0, 4096)),
+			format:  hegel.Draw(tc, pick("xz", "lzma")),
+			writes:  hegel.Draw(tc, writePlans),
+		}
+	})
+)
+
+// TestHegelBinaryTreeMatcherStreamsDecode: streams the BinaryTree matcher
+// writes from small-alphabet data with a small dictionary (xz/3; under
+// HEGEL_NO_KNOWN=1 the HashTable4 matcher) decode with the Go readers and
+// with xz.
+func TestHegelBinaryTreeMatcherStreamsDecode(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, matcherCases)
+		data := tc.data.bytes()
+		descr := fmt.Sprintf("%s %s DictCap %d BufSize %d, %d small-alphabet bytes", tc.format, tc.matcher, tc.dict, tc.bufSize, len(data))
+		note(ht, "%s", descr)
+		var buf bytes.Buffer
+		var w io.WriteCloser
+		var err error
+		if tc.format == "xz" {
+			w, err = xz.WriterConfig{DictCap: tc.dict, BufSize: tc.bufSize, Matcher: tc.matcher}.NewWriter(&buf)
+		} else {
+			w, err = lzma.WriterConfig{DictCap: tc.dict, BufSize: tc.bufSize, Matcher: tc.matcher}.NewWriter(&buf)
+		}
+		if err != nil {
+			fail(ht, "NewWriter: %v (%s)", err, descr)
+		}
+		if err := tc.writes.write(w, data); err != nil {
+			mismatch(ht, "xz/3", "Write: %v (%s)", err, descr)
+		}
+		if err := w.Close(); err != nil {
+			mismatch(ht, "xz/3", "Close: %v (%s)", err, descr)
+		}
+		out := buf.Bytes()
+		var r io.Reader
+		args := []string{"-dc"}
+		if tc.format == "xz" {
+			r, err = xz.NewReader(bytes.NewReader(out))
+		} else {
+			r, err = lzma.NewReader(bytes.NewReader(out))
+			args = []string{"--format=lzma", "-dc"}
+		}
+		if err != nil {
+			fail(ht, "NewReader: %v (%s)", err, descr)
+		}
+		got, err := io.ReadAll(r)
+		if err != nil {
+			mismatch(ht, "xz/3", "Read: %v after %d of %d bytes (%s)", err, len(got), len(data), descr)
+		}
+		if !bytes.Equal(got, data) {
+			mismatch(ht, "xz/3", "decoded %d bytes, want %d (first difference at %d) (%s)", len(got), len(data), firstDiff(got, data), descr)
+		}
+		xzGot, err := xzCLI(t, out, args...)
+		if err != nil {
+			mismatch(ht, "xz/3", "%v (%s)", err, descr)
+		}
+		if !bytes.Equal(xzGot, data) {
+			mismatch(ht, "xz/3", "xz gave %d bytes, want %d (%s)", len(xzGot), len(data), descr)
+		}
+	})
+}
