+				joined = append(joined, make([]byte, 4*n(ht, 1, 3))...)
+			}
+			joined = append(joined, out...)
+			want = append(want, data...)
+			descr = append(descr, fmt.Sprintf("xz %s (%d bytes -> %d)", strings.Join(args, " "), len(data), len(out)))
+		}
