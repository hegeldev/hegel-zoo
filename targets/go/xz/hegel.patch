+// TestHegelReaderDecodesTheXzToolOutput: streams written by the xz tool with
+// any options, alone or concatenated with padding, decode with the Reader.
+func TestHegelReaderDecodesTheXzToolOutput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, toolOutputCases)
+		for _, s := range tc.streams {
+			ht.Assume(!manyBlocks(s.args, s.data.size)) // candidate/go/xz-10
+		}
+		var joined, want []byte
+		var descr []string
+		for i, s := range tc.streams {
+			data := s.data.bytes()
+			args := s.args.args()
+			out, err := xzCLI(t, data, args...)
+			if err != nil {
+				fail(ht, "oracle failed: %v", err)
+			}
+			if i > 0 {
+				joined = append(joined, padding(s.pad)...)
+			}
+			joined = append(joined, out...)
+			want = append(want, data...)
+			descr = append(descr, fmt.Sprintf("xz %s (%d bytes -> %d)", strings.Join(args, " "), len(data), len(out)))
+		}
+		joined = append(joined, padding(tc.trailingPad)...)
+		note(ht, "%s", strings.Join(descr, "; "))
+		src := wrap(tc.wrap, bytes.NewReader(joined))
+		rc := xz.ReaderConfig{DictCap: tc.readerDict}
+		r, err := rc.NewReader(src)
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s", err, strings.Join(descr, "; "))
+		}
+		got, err := tc.reads.readAll(r, len(want)+1<<20)
+		if err != nil {
+			fail(ht, "Read: %v after %d of %d bytes\n%s, reader %s", err, len(got), len(want), strings.Join(descr, "; "), tc.wrap)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "decoded %d bytes, want %d (first difference at %d)\n%s, reader %s", len(got), len(want), firstDiff(got, want), strings.Join(descr, "; "), tc.wrap)
+		}
+	})
+}
