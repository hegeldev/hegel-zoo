+// ---------------------------------------------------------------------------
+// The classic .lzma format.
+
+// classicCase: the data, the lzma.Writer's configuration and chunking, the
+// lzma.Reader's DictCap, adapter and read chunking, and the tool's options
+// for its own .lzma stream.
+type classicCase struct {
+	data       dataSpec
+	cfg        lzmaConfig
+	writes     writePlan
+	readerDict int
+	wrap       string
+	reads      readPlan
+	args       lzma1Args
+}
+
+func (c classicCase) GoString() string {
+	return fmt.Sprintf("%v with %v, %v; ReaderConfig.DictCap %d, %s, %v; %v", c.data, c.cfg, c.writes, c.readerDict, c.wrap, c.reads, c.args)
+}
+
+var classicCases = hegel.Composite(func(tc hegel.TestCase) classicCase {
+	return classicCase{
+		data:       hegel.Draw(tc, dataSpecs),
+		cfg:        hegel.Draw(tc, lzmaConfigs),
+		writes:     hegel.Draw(tc, writePlans),
+		readerDict: hegel.Draw(tc, readerDicts),
+		wrap:       hegel.Draw(tc, wraps),
+		reads:      hegel.Draw(tc, readPlans),
+		args:       hegel.Draw(tc, lzma1ArgSets),
+	}
+})
+
+// classicShape names the recorded bug of a classic round-trip failure: xz/3
+// for BinaryTree, xz/4 for SizeInHeader with an empty input, xz/7 for a read
+// plan with an empty read; "" otherwise.
+func classicShape(c lzma.WriterConfig, dataLen int, reads readPlan) string {
+	if c.Matcher == lzma.BinaryTree {
+		return "xz/3"
+	}
+	if c.SizeInHeader && dataLen == 0 {
+		return "xz/4"
+	}
+	if slices.Contains(reads.sizes, 0) {
+		return "xz/7"
+	}
+	return ""
+}
+
+// TestHegelClassicLzmaRoundTrips: lzma.Writer output decodes with lzma.Reader
+// (Header reports what was written, EOSMarker whether the marker was written)
+// and with `xz --format=lzma -dc`; `xz --format=lzma -c` output decodes with
+// lzma.Reader and passes ValidHeader.
+func TestHegelClassicLzmaRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, classicCases)
+		ht.Assume(!slowMatcher(tc.data, tc.cfg.matcher)) // candidate/go/xz-9
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		mode := tc.cfg.mode(len(data))
+		s := describeLzmaConfig(c) + " (" + mode + ")"
+		note(ht, "%s, %d data bytes", s, len(data))
+		var buf bytes.Buffer
+		w, err := c.NewWriter(&buf)
+		if err != nil {
+			fail(ht, "NewWriter: %v\n%s", err, s)
+		}
+		if err := tc.writes.write(w, data); err != nil {
+			fail(ht, "Write: %v\n%s", err, s)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v\n%s, %d bytes", err, s, len(data))
+		}
+		out := buf.Bytes()
+		if !lzma.ValidHeader(out[:lzma.HeaderLen]) {
+			fail(ht, "lzma.ValidHeader false on the Writer's own header %x\n%s", out[:13], s)
+		}
+
+		// Go reader
+		rc := lzma.ReaderConfig{DictCap: tc.readerDict}
+		eff := c.DictCap
+		if eff == 0 {
+			eff = 8 << 20
+		}
+		tooSmall := rc.DictCap != 0 && rc.DictCap < eff
+		src := wrap(tc.wrap, bytes.NewReader(out))
+		r, err := rc.NewReader(src)
+		if tooSmall {
+			var e *lzma.ErrDictSize
+			if err == nil || !errors.As(err, &e) {
+				fail(ht, "ReaderConfig{DictCap: %d} on a stream with dictionary %d: NewReader err %v, want *ErrDictSize", rc.DictCap, c.DictCap, err)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s", err, s)
+		}
+		h, ok := r.Header()
+		wantDict := uint32(eff)
+		wantProps := lzma.Properties{LC: 3, LP: 0, PB: 2}
+		if c.Properties != nil {
+			wantProps = *c.Properties
+		}
+		wantSize := int64(-1)
+		if mode == "sizeInHeader" || (mode != "eos" && len(data) > 0) {
+			wantSize = int64(len(data))
+		}
+		if !ok || h.DictSize != wantDict || h.Properties != wantProps || h.Size != wantSize {
+			mismatch(ht, classicShape(c, len(data), readPlan{}), "Header() = %+v, %v; want DictSize %d, %s, Size %d\n%s", h, ok, wantDict, wantProps.String(), wantSize, s)
+		}
+		reads := tc.reads.classic()
+		got, err := reads.readAll(r, len(data)+1<<20)
+		if err != nil {
+			mismatch(ht, classicShape(c, len(data), reads), "Read: %v after %d of %d bytes\n%s, reader %s, data %s", err, len(got), len(data), s, tc.wrap, short(data))
+		}
+		if !bytes.Equal(got, data) {
+			mismatch(ht, classicShape(c, len(data), reads), "decoded %d bytes, want %d (first difference at %d)\n%s, reader %s", len(got), len(data), firstDiff(got, data), s, tc.wrap)
+		}
+		wantMarker := mode == "eos" || mode == "size+eos" || (mode == "size" && len(data) == 0)
+		if r.EOSMarker() != wantMarker {
+			fail(ht, "EOSMarker() = %v, want %v\n%s", r.EOSMarker(), wantMarker, s)
+		}
+
+		// xz decodes it (liblzma refuses lc+lp > 4 in every format: not a Go bug)
+		xzGot, err := xzCLI(t, out, "--format=lzma", "-dc")
+		if wantProps.LC+wantProps.LP > 4 {
+			if err == nil {
+				fail(ht, "xz decoded a .lzma stream with lc+lp = %d, which liblzma documents as unsupported\n%s", wantProps.LC+wantProps.LP, s)
+			}
+		} else {
+			if err != nil {
+				mismatch(ht, classicShape(c, len(data), readPlan{}), "%v\n%s, data %s\nstream %x", err, s, short(data), out[:min(len(out), 64)])
+			}
+			if !bytes.Equal(xzGot, data) {
+				mismatch(ht, classicShape(c, len(data), readPlan{}), "xz --format=lzma -dc gave %d bytes, want %d\n%s", len(xzGot), len(data), s)
+			}
+		}
+
+		// and the Reader decodes xz's .lzma
+		args := tc.args.args()
+		xzOut, err := xzCLI(t, data, args...)
+		if err != nil {
+			fail(ht, "oracle failed: %v", err)
+		}
+		if !lzma.ValidHeader(xzOut[:lzma.HeaderLen]) {
+			fail(ht, "lzma.ValidHeader false on xz's header %x (%s)", xzOut[:13], strings.Join(args, " "))
+		}
+		r2, err := lzma.NewReader(bytes.NewReader(xzOut))
+		if err != nil {
+			fail(ht, "NewReader on xz %s output: %v", strings.Join(args, " "), err)
+		}
+		got2, err := reads.readAll(r2, len(data)+1<<20)
+		if err != nil {
+			mismatch(ht, classicShape(lzma.WriterConfig{}, len(data), reads), "Read of xz %s output: %v after %d of %d bytes", strings.Join(args, " "), err, len(got2), len(data))
+		}
+		if !bytes.Equal(got2, data) {
+			mismatch(ht, classicShape(lzma.WriterConfig{}, len(data), reads), "xz %s output decoded to %d bytes, want %d (first difference at %d)", strings.Join(args, " "), len(got2), len(data), firstDiff(got2, data))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Raw LZMA2 chunk sequences.
+
+// lzma2Case: the data, lzma.Writer2's configuration and chunking (with
+// flushes), the Reader2's adapter and read chunking, and the tool's options
+// for its own raw stream.
+type lzma2Case struct {
+	data   dataSpec
+	cfg    writer2Config
+	writes chunkPlan
+	wrap   string
+	reads  readPlan
+	args   rawArgs
+}
+
+func (c lzma2Case) GoString() string {
+	return fmt.Sprintf("%v with %v, %v; %s, %v; %v", c.data, c.cfg, c.writes, c.wrap, c.reads, c.args)
+}
+
+var lzma2Cases = hegel.Composite(func(tc hegel.TestCase) lzma2Case {
+	return lzma2Case{
+		data:   hegel.Draw(tc, dataSpecs),
+		cfg:    hegel.Draw(tc, writer2Configs),
+		writes: hegel.Draw(tc, chunkPlans),
+		wrap:   hegel.Draw(tc, wraps),
+		reads:  hegel.Draw(tc, readPlans),
+		args:   hegel.Draw(tc, rawArgSets),
+	}
+})
+
+// writer2Shape names the recorded bug of a Writer2 failure on data of dataLen
+// bytes under c: xz/2 for a DictCap under 64 KiB with more data than it
+// holds, xz/3 for BinaryTree; "" otherwise.
+func writer2Shape(c lzma.Writer2Config, dataLen int) string {
+	if c.DictCap != 0 && c.DictCap < 1<<16 && dataLen > c.DictCap {
+		return "xz/2"
+	}
+	if c.Matcher == lzma.BinaryTree {
+		return "xz/3"
+	}
+	return ""
+}
+
+// TestHegelLzma2ChunkSequencesRoundTrip: Writer2 output (with Flush calls in
+// between) decodes with Reader2 and with `xz --format=raw --lzma2 -dc`; xz's
+// raw LZMA2 decodes with Reader2; EOS() reports the end-of-stream chunk.
+func TestHegelLzma2ChunkSequencesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, lzma2Cases)
+		ht.Assume(!slowMatcher(tc.data, tc.cfg.matcher)) // candidate/go/xz-9
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		descr := describeWriter2Config(c)
+		note(ht, "%s, %d data bytes", descr, len(data))
+		var buf bytes.Buffer
+		w, err := c.NewWriter2(&buf)
+		if err != nil {
+			fail(ht, "NewWriter2: %v\n%s", err, descr)
+		}
+		flushes, err := tc.writes.write(w, data)
+		if err != nil {
+			mismatch(ht, writer2Shape(c, len(data)), "%v\n%s", err, descr)
+		}
+		if err := w.Close(); err != nil {
+			mismatch(ht, writer2Shape(c, len(data)), "Close: %v\n%s", err, descr)
+		}
+		out := buf.Bytes()
+		dict := tc.cfg.dict(len(data))
+
+		src := wrap(tc.wrap, bytes.NewReader(out))
+		r, err := lzma.Reader2Config{DictCap: dict}.NewReader2(src)
+		if err != nil {
+			fail(ht, "NewReader2: %v\n%s", err, descr)
+		}
+		got, err := tc.reads.readAll(r, len(data)+1<<20)
+		if err != nil {
+			mismatch(ht, writer2Shape(c, len(data)), "Read: %v after %d of %d bytes\n%s, %d flushes, reader %s", err, len(got), len(data), descr, flushes, tc.wrap)
+		}
+		if !bytes.Equal(got, data) {
+			mismatch(ht, writer2Shape(c, len(data)), "decoded %d bytes, want %d (first difference at %d)\n%s, %d flushes, reader %s", len(got), len(data), firstDiff(got, data), descr, flushes, tc.wrap)
+		}
+		if !r.EOS() {
+			fail(ht, "EOS() false after reading the closed stream to its end\n%s", descr)
+		}
+
+		xzGot, err := xzCLI(t, out, "--format=raw", "--lzma2=dict="+strconv.Itoa(dict), "-dc")
+		if err != nil {
+			mismatch(ht, writer2Shape(c, len(data)), "%v\n%s, %d flushes, data %s\nstream %x", err, descr, flushes, short(data), out[:min(len(out), 64)])
+		}
+		if !bytes.Equal(xzGot, data) {
+			mismatch(ht, writer2Shape(c, len(data)), "xz --format=raw -dc gave %d bytes, want %d (first difference at %d)\n%s", len(xzGot), len(data), firstDiff(xzGot, data), descr)
+		}
+
+		args := tc.args.args()
+		xzOut, err := xzCLI(t, data, args...)
+		if err != nil {
+			fail(ht, "oracle failed: %v", err)
+		}
+		r2, err := lzma.Reader2Config{DictCap: tc.args.dict}.NewReader2(bytes.NewReader(xzOut))
+		if err != nil {
+			fail(ht, "NewReader2 on xz %s output: %v", strings.Join(args, " "), err)
+		}
+		got2, err := tc.reads.readAll(r2, len(data)+1<<20)
+		if err != nil {
+			fail(ht, "Read of xz %s output: %v after %d of %d bytes", strings.Join(args, " "), err, len(got2), len(data))
+		}
+		if !bytes.Equal(got2, data) {
+			fail(ht, "xz %s output decoded to %d bytes, want %d (first difference at %d)", strings.Join(args, " "), len(got2), len(data), firstDiff(got2, data))
+		}
+		if !r2.EOS() {
+			fail(ht, "EOS() false after xz's raw stream (%s)", strings.Join(args, " "))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Corruption.
+
+// mutation is one corruption of a stream: the kind, the byte it hits (at,
+// taken modulo the length) and the value it uses; a flip XORs with a non-zero
+// mask, an append adds the value and tail, the paddings add 1-3 or 4-12 zero
+// bytes.
+type mutation struct {
+	kind string
+	at   int
+	val  byte
+	tail []byte
+	n    int
+}
+
+func (m mutation) String() string { return fmt.Sprintf("%s at %d (%#x)", m.kind, m.at, m.val) }
+
+// apply returns a copy of in with the mutation and the position it hit.
+func (m mutation) apply(in []byte) ([]byte, int) {
+	out := append([]byte(nil), in...)
+	pos := at(m.at, len(out))
+	switch m.kind {
+	case "flip":
+		out[pos] ^= byte(1 + at(int(m.val), 255))
+	case "zero":
+		out[pos] = 0
+	case "truncate":
+		out = out[:pos]
+	case "delete":
+		out = append(out[:pos], out[pos+1:]...)
+	case "insert":
+		pos = at(m.at, len(out)+1)
+		out = append(out[:pos], append([]byte{m.val}, out[pos:]...)...)
+	case "append":
+		pos = len(out)
+		out = append(out, byte(1+at(int(m.val), 255)))
+		out = append(out, m.tail...)
+	case "shortpad":
+		pos = len(out)
+		out = append(out, make([]byte, 1+at(m.n, 3))...)
+	case "pad":
+		pos = len(out)
+		out = append(out, padding(1+at(m.n, 3))...)
+	}
+	return out, pos
+}
+
+var mutations = hegel.Composite(func(tc hegel.TestCase) mutation {
+	return mutation{
+		kind: hegel.Draw(tc, pick("flip", "zero", "truncate", "delete", "insert", "append", "shortpad", "pad", "flip", "truncate")),
+		at:   hegel.Draw(tc, positions),
+		val:  byte(hegel.Draw(tc, hegel.Integers(0, 255))),
+		tail: hegel.Draw(tc, hegel.Binary(0, 5)),
+		n:    hegel.Draw(tc, hegel.Integers(0, 2)),
+	}
+})
+
+// xzBlock is one block of a valid .xz stream as xzLayout walks it: the
+// offset of its header, the header's length, the offset after its check,
+// and the offsets of the compressed-size field (two bytes, high first) of
+// every LZMA chunk in it.
+type xzBlock struct {
+	start, headerLen, end int
+	packed                []int
+}
+
+// xzLayout is the structure of a valid .xz stream: its blocks and the offset
+// of the index. Nothing here decodes.
+type xzLayout struct {
+	blocks []xzBlock
+	index  int
+}
+
+func layoutOf(b []byte) xzLayout {
+	var l xzLayout
+	checkSize := map[byte]int{0: 0, 1: 4, 4: 8, 10: 32}[b[7]&0x0f]
+	pos := 12
+	for pos < len(b) && b[pos] != 0 { // 0 is the index indicator
+		blk := xzBlock{start: pos, headerLen: (int(b[pos]) + 1) * 4}
+		pos += blk.headerLen
+		for pos < len(b) {
+			c := b[pos]
+			if c == 0 { // end of the LZMA2 data
+				pos++
+				break
+			}
+			if c == 1 || c == 2 { // uncompressed chunk
+				pos += 3 + (int(b[pos+1])<<8 | int(b[pos+2])) + 1
+				continue
+			}
+			packed := (int(b[pos+3])<<8 | int(b[pos+4])) + 1
+			blk.packed = append(blk.packed, pos+3)
+			hdr := 5
+			if c >= 0xC0 { // a properties byte follows
+				hdr = 6
+			}
+			pos += hdr + packed
+		}
+		for (pos-blk.start)%4 != 0 {
+			pos++ // block padding
+		}
+		pos += checkSize
+		blk.end = pos
+		l.blocks = append(l.blocks, blk)
+	}
+	l.index = pos
+	return l
+}
+
+// lzma2PackedSizeOffsets walks a valid .xz stream (header, blocks of LZMA2 chunks with
+// padding and check, index) and returns the offsets of the two compressed-size bytes of
+// every LZMA chunk header - the field xz/8 leaves unverified.
+func lzma2PackedSizeOffsets(b []byte) []int {
+	var out []int
+	for _, blk := range layoutOf(b).blocks {
+		for _, p := range blk.packed {
+			out = append(out, p, p+1)
+		}
+	}
+	return out
+}
+
+// streamSource is where the valid stream of a corruption case comes from:
+// the Go Writer under a configuration, or the tool with its options.
+type streamSource struct {
+	fromXz bool
+	cfg    xzConfig
+	args   xzArgs
+}
+
+func (s streamSource) String() string {
+	if s.fromXz {
+		return s.args.String()
+	}
+	return "Writer " + s.cfg.String()
+}
+
+var streamSources = hegel.OneOf(
+	hegel.Map(xzConfigs, func(c xzConfig) streamSource { return streamSource{cfg: c} }),
+	hegel.Map(xzArgSets, func(a xzArgs) streamSource { return streamSource{fromXz: true, args: a} }),
+)
+
+// corruptCase: the data, the source of the valid stream, the Writer's
+// chunking, the mutation and the read chunking.
+type corruptCase struct {
+	data   dataSpec
+	src    streamSource
+	writes writePlan
+	mut    mutation
+	reads  readPlan
+}
+
+func (c corruptCase) GoString() string {
+	return fmt.Sprintf("%v from %v (%v): %v; %v", c.data, c.src, c.writes, c.mut, c.reads)
+}
+
+var corruptCases = hegel.Composite(func(tc hegel.TestCase) corruptCase {
+	return corruptCase{
+		data:   hegel.Draw(tc, dataSpecs),
+		src:    hegel.Draw(tc, streamSources),
+		writes: hegel.Draw(tc, writePlans),
+		mut:    hegel.Draw(tc, mutations),
+		reads:  hegel.Draw(tc, readPlans),
+	}
+})
+
+// decodeGo decodes an .xz stream fully; a nil error means a clean EOF.
+func decodeGo(reads readPlan, in []byte, limit int) ([]byte, error) {
+	r, err := xz.NewReader(bytes.NewReader(in))
+	if err != nil {
+		return nil, err
+	}
+	return reads.readAll(r, limit)
+}
+
+// TestHegelCorruptStreamsAreRejected: one mutation of a valid stream (by the
+// Writer or by xz) - the Reader either fails or returns exactly the original
+// data (a mutation that changes nothing), never panics, never returns
+// different data or a truncation with a clean EOF; and its verdict agrees with
+// `xz -dc`.
+func TestHegelCorruptStreamsAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, corruptCases)
+		ht.Assume(!manyBlocks(tc.src.args, tc.data.size) || !tc.src.fromXz)   // candidate/go/xz-10
+		ht.Assume(!slowMatcher(tc.data, tc.src.cfg.matcher) || tc.src.fromXz) // candidate/go/xz-9
+		data := tc.data.bytes()
+		var valid []byte
+		var origin string
+		if tc.src.fromXz {
+			args := tc.src.args.args()
+			out, err := xzCLI(t, data, args...)
+			if err != nil {
+				fail(ht, "oracle failed: %v", err)
+			}
+			valid, origin = out, "xz "+strings.Join(args, " ")
+		} else {
+			c := tc.src.cfg.config(len(data))
+			out, err := compressGo(c, tc.writes, data)
+			if err != nil {
+				mismatch(ht, writerShape(c, len(data)), "%v\n%s", err, describeWriterConfig(c))
+			}
+			valid, origin = out, describeWriterConfig(c)
+		}
+		bad, pos := tc.mut.apply(valid)
+		m := tc.mut
+		m.at = pos
+		note(ht, "%s; %s on %d bytes", origin, m, len(valid))
+
+		got, goErr := decodeGo(tc.reads, bad, len(data)+1<<20)
+		xzGot, xzErr := xzCLI(t, bad, "-dc")
+		xzOK := xzErr == nil && bytes.Equal(xzGot, data)
+		hasCheck := valid[7]&0x0f != 0
+		ctx := fmt.Sprintf("%s; %s on the %d-byte stream (data %d bytes, check %#x)\nvalid  %x\nmutant %x", origin, m, len(valid), len(data), valid[7], valid[:min(len(valid), 96)], bad[:min(len(bad), 96)])
+		if goErr == nil {
+			// The recorded shapes of a clean decode of a damaged stream: xz/8, a
+			// flipped or zeroed compressed-size byte of an LZMA chunk (overstated:
+			// decoded as if right; understated: a clean EOF); xz/1, a cut before
+			// the index (all data intact) or inside a block header, or a mutation
+			// that makes the stream end early by xz's own verdict (an index
+			// indicator flipped into a block-header size byte turns the index and
+			// footer into a truncated header).
+			shape := ""
+			if (m.kind == "flip" || m.kind == "zero") && slices.Contains(lzma2PackedSizeOffsets(valid), pos) {
+				shape = "xz/8"
+			} else if bytes.Equal(got, data[:min(len(got), len(data))]) && (m.kind == "truncate" || (xzErr != nil && strings.Contains(xzErr.Error(), "Unexpected end of input"))) {
+				shape = "xz/1"
+			}
+			if !hasCheck && xzErr == nil && !bytes.Equal(xzGot, data) {
+				// no check: corruption of the payload is undetectable; the two decoders must still agree
+				if !bytes.Equal(got, xzGot) {
+					mismatch(ht, shape, "unchecked stream: the Reader decoded %d bytes, xz %d (first difference at %d), neither with an error\n%s", len(got), len(xzGot), firstDiff(got, xzGot), ctx)
+				}
+				return
+			}
+			if !bytes.Equal(got, data) {
+				mismatch(ht, shape, "the Reader returned %d bytes with a clean EOF, the original has %d (first difference at %d); xz: %v\n%s", len(got), len(data), firstDiff(got, data), xzErr, ctx)
+			}
+			if !xzOK {
+				mismatch(ht, shape, "the Reader accepted the mutated stream (data intact); xz rejects it: %v\n%s", xzErr, ctx)
+			}
+			return
+		}
+		if xzOK {
+			fail(ht, "the Reader rejected the mutated stream (%v after %d bytes) although xz decodes it to the original\n%s", goErr, len(got), ctx)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Configuration verification and writer contracts.
+
+func inRange(x, lo, hi int) bool { return lo <= x && x <= hi }
+
+// configCase: a WriterConfig of in- and out-of-range values, a
+// ReaderConfig.DictCap and the classic WriterConfig's size fields.
+type configCase struct {
+	props        *lzma.Properties
+	dictCap      int
+	bufSize      int
+	blockSize    int
+	checkSum     byte
+	noCheckSum   bool
+	matcher      lzma.MatchAlgorithm
+	readerDict   int
+	size         int64
+	sizeInHeader bool
+	eosMarker    bool
+}
+
+func (c configCase) GoString() string {
+	return fmt.Sprintf("props %s, DictCap %d, BufSize %d, BlockSize %d, CheckSum %#x, NoCheckSum %v, Matcher %d; ReaderConfig.DictCap %d; Size %d, SizeInHeader %v, EOSMarker %v",
+		propsName(c.props), c.dictCap, c.bufSize, c.blockSize, c.checkSum, c.noCheckSum, c.matcher, c.readerDict, c.size, c.sizeInHeader, c.eosMarker)
+}
+
+var (
+	// edgeProps: each field one past its documented range on both sides.
+	edgeProps = hegel.Composite(func(tc hegel.TestCase) *lzma.Properties {
+		return &lzma.Properties{LC: hegel.Draw(tc, hegel.Integers(-1, 9)), LP: hegel.Draw(tc, hegel.Integers(-1, 5)), PB: hegel.Draw(tc, hegel.Integers(-1, 5))}
+	})
+	configCases = hegel.Composite(func(tc hegel.TestCase) configCase {
+		return configCase{
+			props: hegel.Draw(tc, maybe(70, edgeProps)),
+			// (MaxDictCap-sized values are valid but allocate gigabytes: not drawn)
+			dictCap:      hegel.Draw(tc, pick(0, 4095, 4096, 8<<20, -1, 100)),
+			bufSize:      hegel.Draw(tc, pick(0, 1, 272, 273, 4096, -5)),
+			blockSize:    hegel.Draw(tc, pick(0, 1, 100, -1, -100)),
+			checkSum:     hegel.Draw(tc, pick[byte](0, xz.CRC32, xz.CRC64, xz.SHA256, 0x02, 0x0f, 0x10, 0xff)),
+			noCheckSum:   hegel.Draw(tc, chance(30)),
+			matcher:      hegel.Draw(tc, pick[lzma.MatchAlgorithm](0, 1, 2, 200)),
+			readerDict:   hegel.Draw(tc, pick(0, 4095, 4096, 1<<20, -1)),
+			size:         hegel.Draw(tc, pick[int64](0, -1, 5, 1<<40)),
+			sizeInHeader: hegel.Draw(tc, chance(40)),
+			eosMarker:    hegel.Draw(tc, chance(40)),
+		}
+	})
+)
