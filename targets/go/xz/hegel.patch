+// failWriter fails every Write once limit bytes have been accepted.
+type failWriter struct {
+	limit  int
+	n      int
+	failed bool
+}
+
+var errSink = errors.New("sink failed")
+
+func (f *failWriter) Write(p []byte) (int, error) {
+	if f.n+len(p) > f.limit {
+		f.failed = true
+		k := f.limit - f.n
+		if k < 0 {
+			k = 0
+		}
+		f.n += k
+		return k, errSink
+	}
+	f.n += len(p)
+	return len(p), nil
+}
+
+// sinkCase: non-empty data, a sink that fails after limit bytes, which
+// writer is over it (with its configuration) and the write chunking.
+type sinkCase struct {
+	data   dataSpec
+	limit  int
+	kind   string
+	cfg    xzConfig
+	lcfg   lzmaConfig
+	writes writePlan
+}
+
+func (c sinkCase) GoString() string {
+	cfg := "default"
+	switch c.kind {
+	case "xz":
+		cfg = c.cfg.String()
+	case "lzma":
+		cfg = c.lcfg.String()
+	}
+	return fmt.Sprintf("%s writer %s over a sink failing after %d bytes, %v, %v", c.kind, cfg, c.limit, c.data, c.writes)
+}
+
+var (
+	writerKinds = pick("xz", "lzma", "lzma2")
+	sinkCases   = hegel.Composite(func(tc hegel.TestCase) sinkCase {
+		return sinkCase{
+			data:   hegel.Draw(tc, nonEmptyDataSpecs),
+			limit:  hegel.Draw(tc, hegel.Integers(0, 40)),
+			kind:   hegel.Draw(tc, writerKinds),
+			cfg:    hegel.Draw(tc, xzConfigs),
+			lcfg:   hegel.Draw(tc, lzmaConfigs),
+			writes: hegel.Draw(tc, writePlans),
+		}
+	})
+)
+
+// newWriterOver opens the writer of the kind over the sink.
+func newWriterOver(c sinkCase, sink io.Writer, dataLen int) (io.WriteCloser, error) {
+	switch c.kind {
+	case "xz":
+		return c.cfg.config(dataLen).NewWriter(sink)
+	case "lzma":
+		return c.lcfg.config(dataLen).NewWriter(sink)
+	}
+	return lzma.NewWriter2(sink)
+}
+
+// TestHegelWritersReportTheirSinksErrors: when the underlying writer fails, the
+// error surfaces from Write or Close (never swallowed), and the writers refuse
+// use after Close.
+func TestHegelWritersReportTheirSinksErrors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, sinkCases)
+		ht.Assume(!slowMatcher(tc.data, tc.cfg.matcher) || tc.kind != "xz")    // candidate/go/xz-9
+		ht.Assume(!slowMatcher(tc.data, tc.lcfg.matcher) || tc.kind != "lzma") // candidate/go/xz-9
+		data := tc.data.bytes()
+		kind, limit := tc.kind, tc.limit
+		sink := &failWriter{limit: limit}
+		w, err := newWriterOver(tc, sink, len(data))
+		note(ht, "%s writer over a sink failing after %d bytes, %d data bytes", kind, limit, len(data))
+		if err != nil {
+			if !errors.Is(err, errSink) && !strings.Contains(err.Error(), "sink failed") {
+				fail(ht, "%s NewWriter over a failing sink: %v (not the sink's error)", kind, err)
+			}
+			return // the header write already failed: fine
+		}
+		werr := tc.writes.write(w, data)
+		cerr := w.Close()
+		if sink.failed && werr == nil && cerr == nil && !(Known.writer2CloseSwallows && kind == "lzma2") {
+			shape := ""
+			if kind == "lzma2" {
+				shape = "xz/5"
+			}
+			mismatch(ht, shape, "%s writer over a sink that fails after %d bytes: neither Write nor Close reported an error (sink got %d bytes)", kind, limit, sink.n)
+		}
+		if Known.lzmaWriterAfterClose && kind == "lzma" {
+			return
+		}
+		if Known.writer2CloseSwallows && kind == "lzma2" && sink.failed {
+			return // Close returned nil without marking the writer closed
+		}
+		// after Close: Write and Close fail
+		shape := ""
+		switch {
+		case kind == "lzma":
+			shape = "xz/6"
+		case kind == "lzma2" && sink.failed:
+			shape = "xz/5"
+		}
+		if _, err := w.Write([]byte("more")); err == nil {
+			mismatch(ht, shape, "%s writer accepted a Write after Close", kind)
+		}
+		if err := w.Close(); err == nil {
+			mismatch(ht, shape, "%s writer accepted a second Close", kind)
+		}
+	})
+}
+
+// TestHegelReadersAreIOReaders: Read with an empty buffer returns 0, nil (or
+// EOF at the end); io.Copy and io.ReadAll give the data; a reader fed the
+// stream one byte at a time never returns n < 0 or n > len(p).
+func TestHegelReadersAreIOReaders(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, writerCases)
+		ht.Assume(!slowMatcher(tc.data, tc.cfg.matcher)) // candidate/go/xz-9
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		out, err := compressGo(c, tc.writes, data)
+		if err != nil {
+			mismatch(ht, writerShape(c, len(data)), "%v\n%s", err, describeWriterConfig(c))
+		}
+		r, err := xz.NewReader(bytes.NewReader(out))
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		if k, err := r.Read(nil); k != 0 || (err != nil && err != io.EOF) {
+			fail(ht, "Read(nil) = %d, %v\n%s", k, err, describeWriterConfig(c))
+		}
+		if k, err := r.Read([]byte{}); k != 0 || (err != nil && err != io.EOF) {
+			fail(ht, "Read(empty) = %d, %v\n%s", k, err, describeWriterConfig(c))
+		}
+		got, err := io.ReadAll(r)
+		if err != nil || !bytes.Equal(got, data) {
+			mismatch(ht, writerShape(c, len(data)), "ReadAll after empty reads: %d bytes, %v; want %d\n%s", len(got), err, len(data), describeWriterConfig(c))
+		}
+		var sink bytes.Buffer
+		r2, _ := xz.NewReader(iotest.OneByteReader(bytes.NewReader(out)))
