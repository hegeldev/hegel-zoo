+// ---------------------------------------------------------------------------
+// The classic .lzma format.
+
+type lzmaShape struct {
+	c        lzma.WriterConfig
+	sizeMode string
+}
+
+func genLzmaWriterConfig(tc hegel.TestCase, dataLen int) lzmaShape {
+	c := lzma.WriterConfig{
+		Properties: genProps(tc, false),
+		DictCap:    pick(tc, dictCaps...),
+	}
+	if chance(tc, 30) {
+		c.BufSize = pick(tc, 4096, 8192, 300, 1<<16)
+	}
+	if chance(tc, 30) && !Known.binaryTreeMatcher {
+		c.Matcher = lzma.BinaryTree
+	}
+	mode := pick(tc, "eos", "size", "size+eos", "sizeInHeader")
+	if Known.sizeZeroHeader && dataLen == 0 && mode != "eos" {
+		mode = "eos"
+	}
+	switch mode {
+	case "size":
+		c.Size = int64(dataLen)
+	case "size+eos":
+		c.Size = int64(dataLen)
+		c.EOSMarker = true
+	case "sizeInHeader":
+		c.SizeInHeader = true
+		c.Size = int64(dataLen)
+	}
+	return lzmaShape{c, mode}
+}
+
+func (s lzmaShape) String() string {
+	p := "nil"
+	if s.c.Properties != nil {
+		p = s.c.Properties.String()
+	}
+	return fmt.Sprintf("lzma.WriterConfig{Properties: %s, DictCap: %d, BufSize: %d, Matcher: %s, SizeInHeader: %v, Size: %d, EOSMarker: %v} (%s)",
+		p, s.c.DictCap, s.c.BufSize, s.c.Matcher, s.c.SizeInHeader, s.c.Size, s.c.EOSMarker, s.sizeMode)
+}
+
+// TestHegelClassicLzmaRoundTrips: lzma.Writer output decodes with lzma.Reader
+// (Header reports what was written, EOSMarker whether the marker was written)
+// and with `xz --format=lzma -dc`; `xz --format=lzma -c` output decodes with
+// lzma.Reader and passes ValidHeader.
+func TestHegelClassicLzmaRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		s := genLzmaWriterConfig(ht, len(data))
+		note(ht, "%s, %d data bytes", s, len(data))
+		var buf bytes.Buffer
+		w, err := s.c.NewWriter(&buf)
+		if err != nil {
+			fail(ht, "NewWriter: %v\n%s", err, s)
+		}
+		if err := writeChunked(ht, w, data); err != nil {
+			fail(ht, "Write: %v\n%s", err, s)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v\n%s, %d bytes", err, s, len(data))
+		}
+		out := buf.Bytes()
+		if !lzma.ValidHeader(out[:lzma.HeaderLen]) {
+			fail(ht, "lzma.ValidHeader false on the Writer's own header %x\n%s", out[:13], s)
+		}
+
+		// Go reader
+		rc := lzma.ReaderConfig{}
+		tooSmall := false
+		if chance(ht, 30) {
+			rc.DictCap = pick(ht, dictCaps...)
+			eff := s.c.DictCap
+			if eff == 0 {
+				eff = 8 << 20
+			}
+			tooSmall = rc.DictCap != 0 && rc.DictCap < eff
+		}
+		src, wrapName := wrapReader(ht, bytes.NewReader(out))
+		r, err := rc.NewReader(src)
+		if tooSmall {
+			var e *lzma.ErrDictSize
+			if err == nil || !errors.As(err, &e) {
+				fail(ht, "ReaderConfig{DictCap: %d} on a stream with dictionary %d: NewReader err %v, want *ErrDictSize", rc.DictCap, s.c.DictCap, err)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "NewReader: %v\n%s", err, s)
+		}
+		h, ok := r.Header()
+		wantDict := uint32(s.c.DictCap)
+		if s.c.DictCap == 0 {
+			wantDict = 8 << 20
+		}
+		wantProps := lzma.Properties{LC: 3, LP: 0, PB: 2}
+		if s.c.Properties != nil {
+			wantProps = *s.c.Properties
+		}
+		wantSize := int64(-1)
+		if s.sizeMode == "sizeInHeader" || (s.sizeMode != "eos" && len(data) > 0) {
+			wantSize = int64(len(data))
+		}
+		if !ok || h.DictSize != wantDict || h.Properties != wantProps || h.Size != wantSize {
+			fail(ht, "Header() = %+v, %v; want DictSize %d, %s, Size %d\n%s", h, ok, wantDict, wantProps.String(), wantSize, s)
+		}
+		got, err := readAllChunked(ht, r, len(data)+1<<20, !Known.emptyReadEOF)
+		if err != nil {
+			fail(ht, "Read: %v after %d of %d bytes\n%s, reader %s, data %s", err, len(got), len(data), s, wrapName, short(data))
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "decoded %d bytes, want %d (first difference at %d)\n%s, reader %s", len(got), len(data), firstDiff(got, data), s, wrapName)
+		}
+		wantMarker := s.sizeMode == "eos" || s.sizeMode == "size+eos" || (s.sizeMode == "size" && len(data) == 0)
+		if r.EOSMarker() != wantMarker {
+			fail(ht, "EOSMarker() = %v, want %v\n%s", r.EOSMarker(), wantMarker, s)
+		}
+
+		// xz decodes it (liblzma refuses lc+lp > 4 in every format: not a Go bug)
+		xzGot, err := xzCLI(t, out, "--format=lzma", "-dc")
+		if wantProps.LC+wantProps.LP > 4 {
+			if err == nil {
+				fail(ht, "xz decoded a .lzma stream with lc+lp = %d, which liblzma documents as unsupported\n%s", wantProps.LC+wantProps.LP, s)
+			}
+		} else {
+			if err != nil {
+				fail(ht, "%v\n%s, data %s\nstream %x", err, s, short(data), out[:min(len(out), 64)])
+			}
+			if !bytes.Equal(xzGot, data) {
+				fail(ht, "xz --format=lzma -dc gave %d bytes, want %d\n%s", len(xzGot), len(data), s)
+			}
+		}
+
+		// and the Reader decodes xz's .lzma
+		lc := n(ht, 0, 4)
+		args := []string{"-c", "--format=lzma", "--lzma1=dict=" + pick(ht, "4KiB", "64KiB", "1MiB", "8MiB") + fmt.Sprintf(",lc=%d,lp=%d,pb=%d", lc, n(ht, 0, 4-lc), n(ht, 0, 4))}
+		xzOut, err := xzCLI(t, data, args...)
+		if err != nil {
+			fail(ht, "oracle failed: %v", err)
+		}
+		if !lzma.ValidHeader(xzOut[:lzma.HeaderLen]) {
+			fail(ht, "lzma.ValidHeader false on xz's header %x (%s)", xzOut[:13], strings.Join(args, " "))
+		}
+		r2, err := lzma.NewReader(bytes.NewReader(xzOut))
+		if err != nil {
+			fail(ht, "NewReader on xz %s output: %v", strings.Join(args, " "), err)
+		}
+		got2, err := readAllChunked(ht, r2, len(data)+1<<20, !Known.emptyReadEOF)
+		if err != nil {
+			fail(ht, "Read of xz %s output: %v after %d of %d bytes", strings.Join(args, " "), err, len(got2), len(data))
+		}
+		if !bytes.Equal(got2, data) {
+			fail(ht, "xz %s output decoded to %d bytes, want %d (first difference at %d)", strings.Join(args, " "), len(got2), len(data), firstDiff(got2, data))
+		}
+	})
+}
