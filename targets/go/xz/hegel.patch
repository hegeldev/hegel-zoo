+// TestHegelEmptyReadsAreNotEOFWhileDataRemains: lzma.Reader read partly and
+// then with an empty buffer (xz/7; under HEGEL_NO_KNOWN=1 a one-byte buffer)
+// returns 0, nil rather than io.EOF, and the rest of the data follows.
+func TestHegelEmptyReadsAreNotEOFWhileDataRemains(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, emptyReadCases)
+		data := tc.data.bytes()
+		var stream []byte
+		var src string
+		if tc.fromXz {
+			out, err := xzCLI(t, data, tc.args.args()...)
+			if err != nil {
+				fail(ht, "oracle failed: %v", err)
+			}
+			stream, src = out, tc.args.String()
+		} else {
+			var buf bytes.Buffer
+			w, err := tc.cfg.config(len(data)).NewWriter(&buf)
+			if err != nil {
+				fail(ht, "NewWriter: %v", err)
+			}
+			if _, err := w.Write(data); err != nil {
+				fail(ht, "Write: %v", err)
+			}
+			if err := w.Close(); err != nil {
+				fail(ht, "Close: %v", err)
+			}
+			stream, src = buf.Bytes(), describeLzmaConfig(tc.cfg.config(len(data)))
+		}
+		first := 1 + at(tc.first, len(data)-1)
+		note(ht, "%s, %d data bytes; read %d, then %d bytes", src, len(data), first, tc.probe)
+		r, err := lzma.NewReader(bytes.NewReader(stream))
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		got, err := io.ReadFull(r, make([]byte, first))
+		if err != nil {
+			fail(ht, "reading the first %d of %d bytes: %v (%s)", first, len(data), err, src)
+		}
+		k, err := r.Read(make([]byte, tc.probe))
+		if k < 0 || k > tc.probe || err != nil {
+			mismatch(ht, "xz/7", "Read with a %d-byte buffer after %d of %d bytes = %d, %v; want 0..%d, nil (%s)", tc.probe, first, len(data), k, err, tc.probe, src)
+		}
+		rest, err := io.ReadAll(r)
+		if err != nil || got+k+len(rest) != len(data) {
+			mismatch(ht, "xz/7", "after %d bytes and a %d-byte read, ReadAll gave %d bytes, %v; want %d (%s)", first, tc.probe, len(rest), err, len(data)-first-k, src)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// xz/8: an LZMA2 chunk's compressed-size field over- or understated.
+
+// packedEdit is the edit of one LZMA chunk's compressed-size field: the
+// chunk (taken modulo the number of LZMA chunks), the direction and the
+// amount (clamped to the field's range).
+type packedEdit struct {
+	chunk int
+	over  bool
+	delta int
+}
+
+func (e packedEdit) String() string {
+	dir := "understated"
+	if e.over {
+		dir = "overstated"
+	}
+	return fmt.Sprintf("chunk %d packed size %s by %d", e.chunk, dir, e.delta)
+}
+
+// apply returns a copy of in with the edit, the offset of the field and the
+// old and new values; a nil copy when the stream has no LZMA chunk.
+func (e packedEdit) apply(in []byte) ([]byte, int, int, int) {
+	offs := lzma2PackedSizeOffsets(in)
+	if len(offs) == 0 {
+		return nil, 0, 0, 0
+	}
+	p := offs[2*at(e.chunk, len(offs)/2)]
+	old := int(in[p])<<8 | int(in[p+1])
+	v := old - e.delta
+	if e.over {
+		v = old + e.delta
+	}
+	v = max(0, min(v, 0xffff))
+	out := append([]byte(nil), in...)
+	out[p] = byte(v >> 8)
+	out[p+1] = byte(v)
+	return out, p, old, v
+}
+
+// packedCase: compressible data written by the Writer and the edit.
+type packedCase struct {
+	data   dataSpec
+	cfg    xzConfig
+	writes writePlan
+	edit   packedEdit
+}
+
+func (c packedCase) GoString() string {
+	return fmt.Sprintf("%v with %v, %v; %v", c.data, c.cfg, c.writes, c.edit)
+}
+
+var (
+	compressible = hegel.SampledFrom([]dataKind{kindText, kindRuns, kindSmallAlphabet})
+	// compressibleSpecs: data with at least one LZMA chunk in its stream.
+	compressibleSpecs = hegel.Composite(func(tc hegel.TestCase) dataSpec {
+		return dataSpec{size: hegel.Draw(tc, hegel.Integers(256, 4096)), kind: hegel.Draw(tc, compressible), seed: hegel.Draw(tc, seeds)}
+	})
+	directions  = shaped[hegel.Generator[bool]](pick(true, false), hegel.Just(false))
+	packedEdits = hegel.Composite(func(tc hegel.TestCase) packedEdit {
+		return packedEdit{chunk: hegel.Draw(tc, positions), over: hegel.Draw(tc, directions), delta: hegel.Draw(tc, hegel.Integers(1, 255))}
+	})
+	packedCases = hegel.Composite(func(tc hegel.TestCase) packedCase {
+		cfg := hegel.Draw(tc, plainXzConfigs)
+		cfg.check = hegel.Draw(tc, shaped[hegel.Generator[checkKind]](checks, checked))
+		cfg.block = blockSpec{} // one block, so that the data is not split into stored chunks
+		return packedCase{
+			data:   hegel.Draw(tc, compressibleSpecs),
+			cfg:    cfg,
+			writes: hegel.Draw(tc, writePlans),
+			edit:   hegel.Draw(tc, packedEdits),
+		}
+	})
+)
+
+// TestHegelLzma2PackedSizesAreVerified: a stream with one LZMA chunk's
+// compressed-size field overstated or understated (xz/8; under
+// HEGEL_NO_KNOWN=1 understated in a checked stream) is rejected by the
+// Reader as it is by xz, or decodes to exactly the original.
+func TestHegelLzma2PackedSizesAreVerified(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, packedCases)
+		data := tc.data.bytes()
+		c := tc.cfg.config(len(data))
+		valid, err := compressGo(c, tc.writes, data)
+		if err != nil {
+			mismatch(ht, writerShape(c, len(data)), "%v\n%s", err, describeWriterConfig(c))
+		}
+		bad, p, old, v := tc.edit.apply(valid)
+		ht.Assume(bad != nil && v != old) // an LZMA chunk to edit, and a change
+		note(ht, "%s; %s at %d: %d -> %d", describeWriterConfig(c), tc.edit, p, old, v)
+		ctx := fmt.Sprintf("%s; %s at %d: %d -> %d (data %d bytes, stream %d)", describeWriterConfig(c), tc.edit, p, old, v, len(data), len(valid))
+		got, goErr := decodeGo(readPlan{[]int{4096}}, bad, len(data)+1<<20)
+		xzGot, xzErr := xzCLI(t, bad, "-dc")
+		xzOK := xzErr == nil && bytes.Equal(xzGot, data)
+		if goErr == nil {
+			if !bytes.Equal(got, data) {
+				mismatch(ht, "xz/8", "the Reader returned %d bytes with a clean EOF, the original has %d (first difference at %d); xz: %v\n%s", len(got), len(data), firstDiff(got, data), xzErr, ctx)
+			}
+			if !xzOK {
+				mismatch(ht, "xz/8", "the Reader accepted the edited stream (data intact); xz rejects it: %v\n%s", xzErr, ctx)
+			}
+			return
+		}
+		if xzOK {
+			fail(ht, "the Reader rejected the edited stream (%v after %d bytes) although xz decodes it to the original\n%s", goErr, len(got), ctx)
+		}
+	})
+}
