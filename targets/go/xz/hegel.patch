+// ---------------------------------------------------------------------------
+// Corruption.
+
+type mutation struct {
+	kind string
+	at   int
+	val  byte
+}
+
+func (m mutation) String() string { return fmt.Sprintf("%s at %d (%#x)", m.kind, m.at, m.val) }
+
+func mutate(tc hegel.TestCase, in []byte) ([]byte, mutation) {
+	out := append([]byte(nil), in...)
+	m := mutation{kind: pick(tc, "flip", "zero", "truncate", "delete", "insert", "append", "shortpad", "pad", "flip", "truncate")}
+	switch m.kind {
+	case "flip":
+		m.at = n(tc, 0, len(out)-1)
+		m.val = byte(n(tc, 1, 255))
+		out[m.at] ^= m.val
+	case "zero":
+		m.at = n(tc, 0, len(out)-1)
+		out[m.at] = 0
+	case "truncate":
+		m.at = n(tc, 0, len(out)-1)
+		out = out[:m.at]
+	case "delete":
+		m.at = n(tc, 0, len(out)-1)
+		out = append(out[:m.at], out[m.at+1:]...)
+	case "insert":
+		m.at = n(tc, 0, len(out))
+		m.val = byte(n(tc, 0, 255))
+		out = append(out[:m.at], append([]byte{m.val}, out[m.at:]...)...)
+	case "append":
+		m.at = len(out)
+		m.val = byte(n(tc, 1, 255))
+		out = append(out, m.val)
+		for i := n(tc, 0, 5); i > 0; i-- {
+			out = append(out, byte(n(tc, 0, 255)))
+		}
+	case "shortpad":
+		m.at = len(out)
+		out = append(out, make([]byte, n(tc, 1, 3))...)
+	case "pad":
+		m.at = len(out)
+		out = append(out, make([]byte, 4*n(tc, 1, 3))...)
+	}
+	return out, m
+}
+
+// lzma2PackedSizeOffsets walks a valid .xz stream (header, blocks of LZMA2 chunks with
+// padding and check, index) and returns the offsets of the two compressed-size bytes of
+// every LZMA chunk header — the field xz/8 leaves unverified. Nothing here decodes.
+func lzma2PackedSizeOffsets(b []byte) []int {
+	var out []int
+	checkSize := map[byte]int{0: 0, 1: 4, 4: 8, 10: 32}[b[7]&0x0f]
+	pos := 12
+	for pos < len(b) && b[pos] != 0 { // 0 is the index indicator
+		start := pos
+		pos += (int(b[pos]) + 1) * 4 // block header
+		for pos < len(b) {
+			c := b[pos]
+			if c == 0 { // end of the LZMA2 data
+				pos++
+				break
+			}
+			if c == 1 || c == 2 { // uncompressed chunk
+				pos += 3 + (int(b[pos+1])<<8 | int(b[pos+2])) + 1
+				continue
+			}
+			packed := (int(b[pos+3])<<8 | int(b[pos+4])) + 1
+			out = append(out, pos+3, pos+4)
+			hdr := 5
+			if c >= 0xC0 { // a properties byte follows
+				hdr = 6
+			}
+			pos += hdr + packed
+		}
+		for (pos-start)%4 != 0 {
+			pos++ // block padding
+		}
+		pos += checkSize
+	}
+	return out
+}
+
+// decodeGo decodes an .xz stream fully; a nil error means a clean EOF.
+func decodeGo(tc hegel.TestCase, in []byte, limit int) ([]byte, error) {
+	r, err := xz.NewReader(bytes.NewReader(in))
+	if err != nil {
+		return nil, err
+	}
+	return readAllChunked(tc, r, limit, true)
+}
+
+// TestHegelCorruptStreamsAreRejected: one mutation of a valid stream (by the
+// Writer or by xz) — the Reader either fails or returns exactly the original
+// data (a mutation that changes nothing), never panics, never returns
+// different data or a truncation with a clean EOF; and its verdict agrees with
+// `xz -dc`.
+func TestHegelCorruptStreamsAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		var valid []byte
+		var origin string
+		if chance(ht, 50) {
+			c := genWriterConfig(ht, len(data))
+			out, err := compressGo(ht, c, data)
+			if err != nil {
+				fail(ht, "%v\n%s", err, describeWriterConfig(c))
+			}
+			valid, origin = out, describeWriterConfig(c)
+		} else {
+			args := genXzArgs(ht)
+			out, err := xzCLI(t, data, args...)
+			if err != nil {
+				fail(ht, "oracle failed: %v", err)
+			}
+			valid, origin = out, "xz "+strings.Join(args, " ")
+		}
+		bad, m := mutate(ht, valid)
+		note(ht, "%s; %s on %d bytes", origin, m, len(valid))
+
+		got, goErr := decodeGo(ht, bad, len(data)+1<<20)
+		xzGot, xzErr := xzCLI(t, bad, "-dc")
+		xzOK := xzErr == nil && bytes.Equal(xzGot, data)
+		hasCheck := valid[7]&0x0f != 0
+		ctx := fmt.Sprintf("%s; %s on the %d-byte stream (data %d bytes, check %#x)\nvalid  %x\nmutant %x", origin, m, len(valid), len(data), valid[7], valid[:min(len(valid), 96)], bad[:min(len(bad), 96)])
+		if goErr == nil {
+			if Known.lzma2PackedSizeUnchecked && (m.kind == "flip" || m.kind == "zero") && slices.Contains(lzma2PackedSizeOffsets(valid), m.at) {
+				return // xz/8: the chunk's compressed size is not verified (overstated: decoded as if right; understated: a clean EOF)
+			}
+			if Known.truncatedBlockHeaderIsEOF && bytes.Equal(got, data[:min(len(got), len(data))]) &&
+				(m.kind == "truncate" || (xzErr != nil && strings.Contains(xzErr.Error(), "Unexpected end of input"))) {
+				// xz/1: a cut before the index (all data intact) or inside a block header; or a
+				// mutation that makes the stream end early by xz's own verdict (an index indicator
+				// flipped into a block-header size byte turns the index and footer into a truncated header)
+				return
+			}
+			if !hasCheck && xzErr == nil && !bytes.Equal(xzGot, data) {
+				// no check: corruption of the payload is undetectable; the two decoders must still agree
+				if !bytes.Equal(got, xzGot) {
+					fail(ht, "unchecked stream: the Reader decoded %d bytes, xz %d (first difference at %d), neither with an error\n%s", len(got), len(xzGot), firstDiff(got, xzGot), ctx)
+				}
+				return
+			}
+			if !bytes.Equal(got, data) {
+				fail(ht, "the Reader returned %d bytes with a clean EOF, the original has %d (first difference at %d); xz: %v\n%s", len(got), len(data), firstDiff(got, data), xzErr, ctx)
+			}
+			if !xzOK {
+				fail(ht, "the Reader accepted the mutated stream (data intact); xz rejects it: %v\n%s", xzErr, ctx)
+			}
+			return
+		}
+		if goErr == io.ErrUnexpectedEOF && m.kind != "truncate" && m.kind != "shortpad" && m.kind != "delete" && m.kind != "flip" && m.kind != "zero" && m.kind != "insert" {
+			// (informational: which mutations are reported as unexpected EOF)
+		}
+		if xzOK {
+			fail(ht, "the Reader rejected the mutated stream (%v after %d bytes) although xz decodes it to the original\n%s", goErr, len(got), ctx)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Configuration verification and writer contracts.
+
+func inRange(x, lo, hi int) bool { return lo <= x && x <= hi }
+
+// TestHegelConfigsAreVerified: Verify accepts exactly the documented ranges
+// (zero values default) and NewWriter/NewReader refuse invalid configs with an
+// error rather than a panic; the accepted configs produce a decodable stream.
+func TestHegelConfigsAreVerified(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := xz.WriterConfig{}
+		if chance(ht, 70) {
+			c.Properties = &lzma.Properties{LC: n(ht, -1, 9), LP: n(ht, -1, 5), PB: n(ht, -1, 5)}
+		}
+		// (MaxDictCap-sized values are valid but allocate gigabytes: not drawn)
+		c.DictCap = pick(ht, 0, 4095, 4096, 8<<20, -1, 100)
+		c.BufSize = pick(ht, 0, 1, 272, 273, 4096, -5)
+		c.BlockSize = int64(pick(ht, 0, 1, 100, -1, -100))
+		c.CheckSum = pick(ht, 0, xz.CRC32, xz.CRC64, xz.SHA256, 0x02, 0x0f, 0x10, 0xff)
+		c.NoCheckSum = chance(ht, 30)
+		c.Matcher = lzma.MatchAlgorithm(pick(ht, 0, 1, 2, 200))
+		descr := describeWriterConfig(c)
+
+		wantOK := true
+		if c.Properties != nil {
+			p := c.Properties
+			wantOK = wantOK && inRange(p.LC, 0, 8) && inRange(p.LP, 0, 4) && inRange(p.PB, 0, 4) && p.LC+p.LP <= 4
+		}
+		wantOK = wantOK && (c.DictCap == 0 || inRange(c.DictCap, 4096, 1<<32-1))
+		wantOK = wantOK && (c.BufSize == 0 || c.BufSize >= 273)
+		wantOK = wantOK && c.BlockSize >= 0
+		wantOK = wantOK && (c.NoCheckSum || c.CheckSum == 0 || c.CheckSum == xz.CRC32 || c.CheckSum == xz.CRC64 || c.CheckSum == xz.SHA256)
+		wantOK = wantOK && c.Matcher <= lzma.BinaryTree
+
+		vc := c
+		verr := vc.Verify()
+		var buf bytes.Buffer
+		w, werr := c.NewWriter(&buf)
+		if (verr == nil) != wantOK {
+			fail(ht, "Verify() = %v, want ok=%v\n%s", verr, wantOK, descr)
+		}
+		if (werr == nil) != wantOK {
+			fail(ht, "NewWriter() err = %v, want ok=%v\n%s", werr, wantOK, descr)
+		}
+		if werr == nil {
+			if _, err := w.Write([]byte("abc")); err != nil {
+				fail(ht, "Write: %v\n%s", err, descr)
+			}
+			if err := w.Close(); err != nil {
+				fail(ht, "Close: %v\n%s", err, descr)
+			}
+			got, err := decodeGo(ht, buf.Bytes(), 1<<20)
+			if err != nil || string(got) != "abc" {
+				fail(ht, "round trip gave %q, %v\n%s", got, err, descr)
+			}
+		}
+
+		rc := xz.ReaderConfig{DictCap: pick(ht, 0, 4095, 4096, 1<<20, -1)}
+		rerr := rc.Verify()
+		wantR := rc.DictCap == 0 || inRange(rc.DictCap, 4096, 1<<32-1)
+		if (rerr == nil) != wantR {
+			fail(ht, "ReaderConfig{DictCap: %d}.Verify() = %v, want ok=%v", rc.DictCap, rerr, wantR)
+		}
+		_, nerr := xz.ReaderConfig{DictCap: rc.DictCap}.NewReader(bytes.NewReader(buf.Bytes()))
+		if wantR && werr == nil && nerr != nil {
+			fail(ht, "ReaderConfig{DictCap: %d}.NewReader: %v", rc.DictCap, nerr)
+		}
+		if !wantR && nerr == nil {
+			fail(ht, "ReaderConfig{DictCap: %d}.NewReader accepted the invalid config", rc.DictCap)
+		}
+
+		// classic lzma writer config
+		lc := lzma.WriterConfig{DictCap: c.DictCap, BufSize: c.BufSize, Matcher: c.Matcher, Properties: c.Properties}
+		lc.Size = int64(pick(ht, 0, -1, 5, 1<<40))
+		lc.SizeInHeader = chance(ht, 40)
+		lc.EOSMarker = chance(ht, 40)
+		wantL := true
+		if lc.Properties != nil {
+			p := lc.Properties
+			wantL = inRange(p.LC, 0, 8) && inRange(p.LP, 0, 4) && inRange(p.PB, 0, 4)
+		}
+		wantL = wantL && (lc.DictCap == 0 || inRange(lc.DictCap, 4096, 1<<32-1))
+		wantL = wantL && (lc.BufSize == 0 || lc.BufSize >= 273)
+		wantL = wantL && lc.Matcher <= lzma.BinaryTree
+		sizeInHeader := lc.SizeInHeader || lc.Size > 0
+		wantL = wantL && !(sizeInHeader && lc.Size < 0)
+		lerr := lc.Verify()
+		if (lerr == nil) != wantL {
+			fail(ht, "lzma.WriterConfig{Properties: %v, DictCap: %d, BufSize: %d, Matcher: %d, SizeInHeader: %v, Size: %d, EOSMarker: %v}.Verify() = %v, want ok=%v",
+				c.Properties, lc.DictCap, lc.BufSize, lc.Matcher, lc.SizeInHeader, lc.Size, lc.EOSMarker, lerr, wantL)
+		}
+	})
+}
+
+// failWriter fails every Write once limit bytes have been accepted.
+type failWriter struct {
+	limit  int
+	n      int
+	failed bool
+}
+
+var errSink = errors.New("sink failed")
+
+func (f *failWriter) Write(p []byte) (int, error) {
+	if f.n+len(p) > f.limit {
+		f.failed = true
+		k := f.limit - f.n
+		if k < 0 {
+			k = 0
+		}
+		f.n += k
+		return k, errSink
+	}
+	f.n += len(p)
+	return len(p), nil
+}
+
+// TestHegelWritersReportTheirSinksErrors: when the underlying writer fails, the
+// error surfaces from Write or Close (never swallowed), and the writers refuse
+// use after Close.
+func TestHegelWritersReportTheirSinksErrors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		if len(data) == 0 {
+			data = []byte("x")
+		}
+		limit := n(ht, 0, 40)
+		kind := pick(ht, "xz", "lzma", "lzma2")
+		sink := &failWriter{limit: limit}
+		var w io.WriteCloser
+		var err error
+		switch kind {
+		case "xz":
+			c := genWriterConfig(ht, len(data))
+			w, err = c.NewWriter(sink)
+		case "lzma":
+			s := genLzmaWriterConfig(ht, len(data))
+			w, err = s.c.NewWriter(sink)
+		default:
+			w, err = lzma.NewWriter2(sink)
+		}
+		note(ht, "%s writer over a sink failing after %d bytes, %d data bytes", kind, limit, len(data))
+		if err != nil {
+			if !errors.Is(err, errSink) && !strings.Contains(err.Error(), "sink failed") {
+				fail(ht, "%s NewWriter over a failing sink: %v (not the sink's error)", kind, err)
+			}
+			return // the header write already failed: fine
+		}
+		var werr error
+		for len(data) > 0 && werr == nil {
+			k := n(ht, 1, len(data))
+			_, werr = w.Write(data[:k])
+			data = data[k:]
+		}
+		cerr := w.Close()
+		if sink.failed && werr == nil && cerr == nil && !(Known.writer2CloseSwallows && kind == "lzma2") {
+			fail(ht, "%s writer over a sink that fails after %d bytes: neither Write nor Close reported an error (sink got %d bytes)", kind, limit, sink.n)
+		}
+		if Known.lzmaWriterAfterClose && kind == "lzma" {
+			return
+		}
+		if Known.writer2CloseSwallows && kind == "lzma2" && sink.failed {
+			return // Close returned nil without marking the writer closed
+		}
+		// after Close: Write and Close fail
+		if _, err := w.Write([]byte("more")); err == nil {
+			fail(ht, "%s writer accepted a Write after Close", kind)
+		}
+		if err := w.Close(); err == nil {
+			fail(ht, "%s writer accepted a second Close", kind)
+		}
+	})
+}
+
+// TestHegelReadersAreIOReaders: Read with an empty buffer returns 0, nil (or
+// EOF at the end); io.Copy and io.ReadAll give the data; a reader fed the
+// stream one byte at a time never returns n < 0 or n > len(p).
+func TestHegelReadersAreIOReaders(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		data := genData(ht)
+		c := genWriterConfig(ht, len(data))
+		out, err := compressGo(ht, c, data)
+		if err != nil {
+			fail(ht, "%v\n%s", err, describeWriterConfig(c))
+		}
+		r, err := xz.NewReader(bytes.NewReader(out))
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		if k, err := r.Read(nil); k != 0 || (err != nil && err != io.EOF) {
+			fail(ht, "Read(nil) = %d, %v\n%s", k, err, describeWriterConfig(c))
+		}
+		if k, err := r.Read([]byte{}); k != 0 || (err != nil && err != io.EOF) {
+			fail(ht, "Read(empty) = %d, %v\n%s", k, err, describeWriterConfig(c))
+		}
+		got, err := io.ReadAll(r)
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "ReadAll after empty reads: %d bytes, %v; want %d\n%s", len(got), err, len(data), describeWriterConfig(c))
+		}
+		var sink bytes.Buffer
+		r2, _ := xz.NewReader(iotest.OneByteReader(bytes.NewReader(out)))
+		if k, err := io.Copy(&sink, r2); err != nil || k != int64(len(data)) || !bytes.Equal(sink.Bytes(), data) {
+			fail(ht, "io.Copy: %d bytes, %v; want %d\n%s", k, err, len(data), describeWriterConfig(c))
+		}
+	})
+}
