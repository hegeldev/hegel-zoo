+package shortuuid
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+	"uuid"
+)
+
+// shortuuid/1: an alphabet string that is not valid UTF-8 is accepted, each invalid byte
+// standing for U+FFFD, which then appears in encodings although it was not in the alphabet.
+func TestHegelPinAlphabetRejectsInvalidUTF8(t *testing.T) {
+	abc := "\xff\xfeab"
+	defer func() {
+		if r := recover(); r != nil {
+			return // a panic, as for too short an alphabet, is the documented reaction
+		}
+	}()
+	enc := NewEncoder(abc)
+	var u uuid.UUID
+	for i := range u {
+		u[i] = 0xff
+	}
+	if s := enc.Encode(u); strings.ContainsRune(s, '�') {
+		t.Errorf("NewEncoder(%q).Encode(...) = %q: U+FFFD is not a character of the alphabet", abc, s)
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..f01bba7
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,560 @@
+package shortuuid
+
+// The model (math/big base-N arithmetic over the sorted alphabet), generators of alphabets and
+// UUIDs, the properties, and the reference test against the Python shortuuid library.
+
+import (
+	"cmp"
+	"crypto/sha1"
+	"encoding/json"
+	"errors"
+	"math/big"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+	"unicode/utf8"
+	"uuid"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- model
+
+var two128 = new(big.Int).Lsh(big.NewInt(1), 128)
+
+// exactLen is the smallest L with n^L >= 2^128: the width every encoding has.
+func exactLen(n int) int {
+	L := 0
+	p := big.NewInt(1)
+	b := big.NewInt(int64(n))
+	for p.Cmp(two128) < 0 {
+		p.Mul(p, b)
+		L++
+	}
+	return L
+}
+
+// sortedRunes is the alphabet as the package prepares it: sorted, deduplicated.
+func sortedRunes(abc string) []rune {
+	rs := []rune(abc)
+	slices.Sort(rs)
+	return slices.Compact(rs)
+}
+
+// modelEncode writes u as a base-len(chars) number, most significant digit first, padded on
+// the left with chars[0] to exactLen digits.
+func modelEncode(chars []rune, u uuid.UUID) string {
+	n := new(big.Int).SetBytes(u[:])
+	base := big.NewInt(int64(len(chars)))
+	L := exactLen(len(chars))
+	digits := make([]rune, L)
+	r := new(big.Int)
+	for i := L - 1; i >= 0; i-- {
+		n.QuoRem(n, base, r)
+		digits[i] = chars[r.Int64()]
+	}
+	return string(digits)
+}
+
+const (
+	decOK = iota
+	decForeign
+	decOverflow
+)
+
+// modelDecode reads s as a base-len(chars) number: a character outside the alphabet is an
+// error, a value of more than 128 bits is an error, anything shorter is padded with zeros.
+func modelDecode(chars []rune, s string) (uuid.UUID, int) {
+	var u uuid.UUID
+	base := big.NewInt(int64(len(chars)))
+	n := new(big.Int)
+	for _, c := range s {
+		i, ok := slices.BinarySearch(chars, c)
+		if !ok {
+			return u, decForeign
+		}
+		n.Mul(n, base)
+		n.Add(n, big.NewInt(int64(i)))
+	}
+	if n.Cmp(two128) >= 0 {
+		return u, decOverflow
+	}
+	n.FillBytes(u[:])
+	return u, decOK
+}
+
+// modelV5 is RFC 9562 section 5.5: SHA-1 of namespace and name, version and variant bits set.
+func modelV5(ns uuid.UUID, name string) uuid.UUID {
+	h := sha1.New()
+	h.Write(ns[:])
+	h.Write([]byte(name))
+	sum := h.Sum(nil)
+	var u uuid.UUID
+	copy(u[:], sum[:16])
+	u[6] = (u[6] & 0x0f) | 0x50
+	u[8] = (u[8] & 0x3f) | 0x80
+	return u
+}
+
+// --------------------------------------------------------------------------- alphabets
+
+// rune pools: one-byte, two-byte (Greek), three-byte (CJK), four-byte (emoji), and the default
+// alphabet's characters
+var runePools = [][]rune{
+	[]rune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!*'();:@&=+$,/?#[]"),
+	[]rune("αβγδεζηθικλμνξοπρστυφχψωΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿ"),
+	[]rune("一二三四五六七八九十百千万亿零壹贰叁肆伍陆柒捌玖拾日月火水木金土天地人山川田"),
+	[]rune("😀😁😂🤣😃😄😅😆😉😊😋😎😍😘🥰😗😙😚🙂🤗🤩🤔🤨😐😑😶🙄😏😣😥😮"),
+	[]rune(DefaultAlphabet),
+}
+
+// poolRunes is every pool's characters, sorted and deduplicated: the characters names are made
+// of, and the candidates for a character outside an alphabet.
+var poolRunes = func() []rune {
+	var all []rune
+	for _, p := range runePools {
+		all = append(all, p...)
+	}
+	return sortedRunes(string(all))
+}()
+
+// runeRange is the runes lo through hi.
+func runeRange(lo, hi rune) []rune {
+	rs := make([]rune, 0, hi-lo+1)
+	for c := lo; c <= hi; c++ {
+		rs = append(rs, c)
+	}
+	return rs
+}
+
+var poolIndex = hegel.Integers(0, len(runePools)-1)
+
+// pooledRunes is 2–40 characters from one pool, or from two pools three times in ten.
+var pooledRunes = hegel.FlatMap(
+	weighted(
+		choice[[]int]{7, hegel.Map(poolIndex, func(p int) []int { return []int{p} })},
+		choice[[]int]{3, hegel.Lists(poolIndex).MinSize(2).MaxSize(2)}),
+	func(pools []int) hegel.Generator[[]rune] {
+		from := make([]hegel.Generator[rune], len(pools))
+		for i, p := range pools {
+			from[i] = hegel.SampledFrom(runePools[p])
+		}
+		return hegel.Lists(hegel.OneOf(from...)).MinSize(2).MaxSize(40)
+	})
+
+// asciiRange is 2 to 94 consecutive printable ASCII characters.
+var asciiRange = hegel.FlatMap(hegel.Integers(33, 125), func(lo int) hegel.Generator[[]rune] {
+	return hegel.Map(hegel.Integers(lo+1, 126), func(hi int) []rune { return runeRange(rune(lo), rune(hi)) })
+})
+
+// wideSpread is a few ASCII characters plus 1–20 CJK ones: a code-point spread too wide for
+// the rune-index table.
+var wideSpread = hegel.Map(hegel.Lists(hegel.SampledFrom(runePools[2])).MinSize(1).MaxSize(20), func(cjk []rune) []rune {
+	return append([]rune{'a', 'b', 'c'}, cjk...)
+})
+
+// manyRunes is 256–356 consecutive CJK characters: more than 255, so decoding binary-searches.
+var manyRunes = hegel.FlatMap(hegel.Integers(0, 2000), func(start int) hegel.Generator[[]rune] {
+	return hegel.Map(hegel.Integers(256, 356), func(n int) []rune {
+		return runeRange(rune(0x4E00+start), rune(0x4E00+start+n-1))
+	})
+})
+
+// alphabetRunes is the characters of an alphabet before any reordering: mostly from one or two
+// pools, otherwise a consecutive ASCII range, a whole pool, the default alphabet, a wide
+// code-point spread or more than 255 characters, to reach every decoding path.
+var alphabetRunes = weighted(
+	choice[[]rune]{15, pooledRunes},
+	choice[[]rune]{1, asciiRange},
+	choice[[]rune]{1, hegel.Map(hegel.SampledFrom(runePools), func(p []rune) []rune { return slices.Clone(p) })},
+	choice[[]rune]{1, hegel.Just([]rune(DefaultAlphabet))},
+	choice[[]rune]{1, wideSpread},
+	choice[[]rune]{1, manyRunes},
+)
+
+// duplicated is rs with lo–hi repeats of its own characters appended.
+func duplicated(rs []rune, lo, hi int) hegel.Generator[[]rune] {
+	return hegel.Map(hegel.Lists(hegel.Integers(0, len(rs)-1)).MinSize(lo).MaxSize(hi), func(idx []int) []rune {
+		out := slices.Clone(rs)
+		for _, i := range idx {
+			out = append(out, rs[i])
+		}
+		return out
+	})
+}
+
+// permuted reorders rs by a drawn sort key per character; equal keys (the shrink target) keep
+// the order as it is.
+func permuted(rs []rune) hegel.Generator[[]rune] {
+	n := len(rs)
+	return hegel.Map(hegel.Lists(hegel.Integers(0, 1<<20)).MinSize(n).MaxSize(n), func(keys []int) []rune {
+		order := make([]int, n)
+		for i := range order {
+			order[i] = i
+		}
+		slices.SortStableFunc(order, func(a, b int) int { return cmp.Compare(keys[a], keys[b]) })
+		out := make([]rune, n)
+		for i, j := range order {
+			out[i] = rs[j]
+		}
+		return out
+	})
+}
+
+// userAlphabet is an alphabet string as a user might pass it, with its prepared form.
+type userAlphabet struct {
+	text  string
+	chars []rune // sorted, deduplicated
+}
+
+// alphabets draws an alphabet string as a user might pass it: alphabetRunes with duplicates
+// appended two times in five and in a drawn order half the time. Every pool is valid UTF-8; an
+// alphabet string that is not is shortuuid/1, pinned.
+var alphabets = hegel.Map(hegel.FlatMap(alphabetRunes, func(rs []rune) hegel.Generator[[]rune] {
+	return hegel.FlatMap(
+		weighted(choice[[]rune]{3, hegel.Just(rs)}, choice[[]rune]{2, duplicated(rs, 1, 5)}),
+		func(rs []rune) hegel.Generator[[]rune] { return hegel.OneOf(hegel.Just(rs), permuted(rs)) })
+}), func(rs []rune) userAlphabet {
+	chars := sortedRunes(string(rs))
+	if len(chars) < 2 { // one character drawn twice from a pool
+		rs = append(slices.Clone(rs), 'x', 'y')
+		chars = sortedRunes(string(rs))
+	}
+	return userAlphabet{string(rs), chars}
+})
+
+var defaultAlphabet = userAlphabet{DefaultAlphabet, sortedRunes(DefaultAlphabet)}
+
+// alphabetsOrDefault is alphabets, with the default alphabet itself one time in four.
+var alphabetsOrDefault = weighted(choice[userAlphabet]{3, alphabets}, choice[userAlphabet]{1, hegel.Just(defaultAlphabet)})
+
+// rearranged is the characters of abc in a drawn order with 0–3 duplicates appended.
+func rearranged(abc string) hegel.Generator[string] {
+	return hegel.Map(
+		hegel.FlatMap(permuted([]rune(abc)), func(rs []rune) hegel.Generator[[]rune] { return duplicated(rs, 0, 3) }),
+		func(rs []rune) string { return string(rs) })
+}
+
+// --------------------------------------------------------------------------- UUIDs
+
+// uuidWith is a zero UUID with b written at offset at.
+func uuidWith(b []byte, at int) uuid.UUID {
+	var u uuid.UUID
+	copy(u[at:], b)
+	return u
+}
+
+var allOnes = uuidWith(slices.Repeat([]byte{0xff}, 16), 0)
+
+// uuids: zero, a small number, leading zero bytes, trailing zero bytes, random bytes (half the
+// time), all ones.
+var uuids = weighted(
+	choice[uuid.UUID]{1, hegel.Just(uuid.UUID{})},
+	choice[uuid.UUID]{1, hegel.Map(hegel.Integers(0, 255), func(b int) uuid.UUID { return uuidWith([]byte{byte(b)}, 15) })},
+	choice[uuid.UUID]{1, hegel.FlatMap(hegel.Integers(0, 15), func(k int) hegel.Generator[uuid.UUID] {
+		return hegel.Map(hegel.Binary(16-k, 16-k), func(b []byte) uuid.UUID { return uuidWith(b, k) })
+	})},
+	choice[uuid.UUID]{1, hegel.FlatMap(hegel.Integers(0, 15), func(k int) hegel.Generator[uuid.UUID] {
+		return hegel.Map(hegel.Binary(k, k), func(b []byte) uuid.UUID { return uuidWith(b, 0) })
+	})},
+	choice[uuid.UUID]{5, hegel.Map(hegel.Binary(16, 16), func(b []byte) uuid.UUID { return uuidWith(b, 0) })},
+	choice[uuid.UUID]{1, hegel.Just(allOnes)},
+)
+
+// uuidPairs is two UUIDs: independent seven times in ten, otherwise the same UUID twice or
+// with one bit flipped.
+var uuidPairs = hegel.FlatMap(uuids, func(a uuid.UUID) hegel.Generator[[2]uuid.UUID] {
+	return weighted(
+		choice[[2]uuid.UUID]{70, hegel.Map(uuids, func(b uuid.UUID) [2]uuid.UUID { return [2]uuid.UUID{a, b} })},
+		choice[[2]uuid.UUID]{9, hegel.Just([2]uuid.UUID{a, a})},
+		choice[[2]uuid.UUID]{21, hegel.Map(hegel.Integers(0, 127), func(bit int) [2]uuid.UUID {
+			b := a
+			b[bit/8] ^= 1 << (bit % 8)
+			return [2]uuid.UUID{a, b}
+		})})
+})
+
+// --------------------------------------------------------------------------- decode inputs
+
+// decodeInputs draws a string for Decode over a: digits of the alphabet, of any length from 0
+// to L+2 (exactly L three times in ten), the largest digit one time in five (values near and
+// over 2^128); a character outside the alphabet, or an invalid byte, inserted 12% of the time.
+func decodeInputs(a userAlphabet) hegel.Generator[string] {
+	L := exactLen(len(a.chars))
+	digit := weighted(choice[rune]{4, hegel.SampledFrom(a.chars)}, choice[rune]{1, hegel.Just(a.chars[len(a.chars)-1])})
+	digits := weighted(
+		choice[[]rune]{7, hegel.Lists(digit).MaxSize(L + 2)},
+		choice[[]rune]{3, hegel.Lists(digit).MinSize(L).MaxSize(L)})
+	return hegel.FlatMap(digits, func(rs []rune) hegel.Generator[string] {
+		if len(rs) == 0 {
+			return hegel.Just("")
+		}
+		return weighted(choice[string]{88, hegel.Just(string(rs))}, choice[string]{12, withForeign(rs, a.chars)})
+	})
+}
+
+// withForeign is rs with a pool character outside chars (or, one time in ten, an invalid
+// byte) inserted before one of its characters.
+func withForeign(rs, chars []rune) hegel.Generator[string] {
+	var foreign []string
+	for _, c := range poolRunes {
+		if _, ok := slices.BinarySearch(chars, c); !ok {
+			foreign = append(foreign, string(c))
+		}
+	}
+	insert := weighted(choice[string]{9, hegel.SampledFrom(foreign)}, choice[string]{1, hegel.Just("\xff")})
+	return hegel.FlatMap(hegel.Integers(0, len(rs)-1), func(i int) hegel.Generator[string] {
+		return hegel.Map(insert, func(f string) string { return string(rs[:i]) + f + string(rs[i:]) })
+	})
+}
+
+// --------------------------------------------------------------------------- names
+
+var namePool = []string{"", "example.com", "EXAMPLE.com", "http://example.com", "HTTP://example.com", "https://x", "HtTpS://x", "http:/x", "ftp://x", "1.2.840.113549", "CN=example,O=org", "παράδειγμα", "😀", " ", "http://", "a\x00b", "https", "httpx://a", "xhttp://a", "\xff\xfehttp://"}
+
+var urlSchemes = []string{"http://", "HTTPS://", "Http://", "hTtP://"}
+
+// names: the pool's names, or 1–12 pool characters, three times in ten behind an http(s)://
+// scheme in some case.
+var names = weighted(
+	choice[string]{60, hegel.SampledFrom(namePool)},
+	choice[string]{28, text(string(poolRunes), 1, 12)},
+	choice[string]{12, seq(hegel.SampledFrom(urlSchemes), text(string(poolRunes), 1, 12))},
+)
+
+// namespaces: the four well-known namespaces, or any UUID one time in five.
+var namespaces = weighted(
+	choice[uuid.UUID]{4, hegel.SampledFrom([]uuid.UUID{NameSpaceDNS, NameSpaceURL, NameSpaceOID, NameSpaceX500})},
+	choice[uuid.UUID]{1, uuids},
+)
+
+// --------------------------------------------------------------------------- properties
+
+// Encode writes the base-N number the godoc describes, of the exact width, and Decode inverts it.
+func TestHegelEncodeIsBaseN(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, alphabets)
+		u := hegel.Draw(ht, uuids)
+		enc := NewEncoder(a.text)
+		got := enc.Encode(u)
+		want := modelEncode(a.chars, u)
+		if got != want {
+			ht.Fatalf("NewEncoder(%q).Encode(%s) = %q; want %q", a.text, u, got, want)
+		}
+		if w := utf8.RuneCountInString(got); w != exactLen(len(a.chars)) {
+			ht.Fatalf("NewEncoder(%q).Encode(%s) = %q, %d characters; a %d-character alphabet needs %d", a.text, u, got, w, len(a.chars), exactLen(len(a.chars)))
+		}
+		back, err := enc.Decode(got)
+		if err != nil || back != u {
+			ht.Fatalf("Decode(Encode(%s)) = %s, %v with alphabet %q", u, back, err, a.text)
+		}
+	})
+}
+
+// Decode reads any string as the base-N number: short input is padded, a character outside the
+// alphabet or a value beyond 128 bits is an error.
+func TestHegelDecodeIsBaseN(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, alphabets)
+		s := hegel.Draw(ht, decodeInputs(a))
+		got, err := NewEncoder(a.text).Decode(s)
+		want, kind := modelDecode(a.chars, s)
+		switch kind {
+		case decOK:
+			if err != nil || got != want {
+				ht.Fatalf("NewEncoder(%q).Decode(%q) = %s, %v; want %s", a.text, s, got, err, want)
+			}
+		case decForeign:
+			if !errors.Is(err, errNotInAlphabet) && !errors.Is(err, errOutOfRange) {
+				ht.Fatalf("NewEncoder(%q).Decode(%q) = %s, %v; want a not-in-alphabet error", a.text, s, got, err)
+			}
+		default:
+			if !errors.Is(err, errOutOfRange) {
+				ht.Fatalf("NewEncoder(%q).Decode(%q) = %s, %v; the value needs more than 128 bits", a.text, s, got, err)
+			}
+		}
+	})
+}
+
+// Encodings compare as the UUIDs do: fixed width over a sorted alphabet, so string order is
+// UUID order (the README's v7 sorting claim, for any alphabet).
+func TestHegelEncodingPreservesOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, alphabets)
+		pair := hegel.Draw(ht, uuidPairs)
+		enc := NewEncoder(a.text)
+		ua, ub := pair[0], pair[1]
+		sa, sb := enc.Encode(ua), enc.Encode(ub)
+		cu := slices.Compare(ua[:], ub[:])
+		cs := strings.Compare(sa, sb)
+		if cu != cs {
+			ht.Fatalf("alphabet %q: %s < %s is %d but %q < %q is %d", a.text, ua, ub, cu, sa, sb, cs)
+		}
+	})
+}
+
+// The alphabet's order and duplicates do not matter; the default alphabet in any order is the
+// default encoder.
+func TestHegelAlphabetIsASet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, alphabetsOrDefault)
+		abc2 := hegel.Draw(ht, rearranged(a.text))
+		u := hegel.Draw(ht, uuids)
+		e1, e2 := NewEncoder(a.text), NewEncoder(abc2)
+		if s1, s2 := e1.Encode(u), e2.Encode(u); s1 != s2 {
+			ht.Fatalf("NewEncoder(%q) and NewEncoder(%q) encode %s as %q and %q", a.text, abc2, u, s1, s2)
+		}
+		if string(a.chars) == DefaultAlphabet {
+			if s, d := e2.Encode(u), DefaultEncoder.Encode(u); s != d {
+				ht.Fatalf("NewEncoder(%q).Encode(%s) = %q; DefaultEncoder gives %q", abc2, u, s, d)
+			}
+		}
+	})
+}
+
+// UUIDv5 is RFC 9562's; NewV5 encodes it; NewWithNamespace picks NameSpaceURL for an http or
+// https prefix (any case) and NameSpaceDNS otherwise, and a random v4 for the empty name.
+func TestHegelV5FollowsTheRFC(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		name := hegel.Draw(ht, names)
+		ns := hegel.Draw(ht, namespaces)
+		u := UUIDv5(ns, name)
+		if w := modelV5(ns, name); u != w {
+			ht.Fatalf("UUIDv5(%s, %q) = %s; RFC 9562 gives %s", ns, name, u, w)
+		}
+		if u[6]>>4 != 5 || u[8]>>6 != 2 {
+			ht.Fatalf("UUIDv5(%s, %q) = %s: version %d, variant bits %b", ns, name, u, u[6]>>4, u[8]>>6)
+		}
+		if s := NewV5(ns, name); s != DefaultEncoder.Encode(u) {
+			ht.Fatalf("NewV5(%s, %q) = %q; want %q", ns, name, s, DefaultEncoder.Encode(u))
+		}
+		got := NewWithNamespace(name)
+		if name == "" {
+			d, err := DefaultEncoder.Decode(got)
+			if err != nil || d[6]>>4 != 4 || d[8]>>6 != 2 {
+				ht.Fatalf("NewWithNamespace(\"\") = %q, decodes to %s (%v); want a v4 UUID", got, d, err)
+			}
+			return
+		}
+		lower := strings.ToLower(name)
+		wantNS := NameSpaceDNS
+		if strings.HasPrefix(lower, "http://") || strings.HasPrefix(lower, "https://") {
+			wantNS = NameSpaceURL
+		}
+		if want := DefaultEncoder.Encode(modelV5(wantNS, name)); got != want {
+			ht.Fatalf("NewWithNamespace(%q) = %q; want %q (namespace %s)", name, got, want, wantNS)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- Python reference
+
+// TestHegelPythonReferenceAgrees runs the Python shortuuid library (the one this package is
+// "based on and compatible with") on a batch of UUIDs, alphabets and strings, and compares.
+// Skipped when python3 with the shortuuid module is not on PATH.
+func TestHegelPythonReferenceAgrees(t *testing.T) {
+	if err := exec.Command("python3", "-c", "import shortuuid").Run(); err != nil {
+		t.Skip("python3 with shortuuid not available: ", err)
+	}
+	type item struct {
+		Alphabet string `json:"alphabet"`
+		UUID     string `json:"uuid"`
+		Decode   string `json:"decode"`
+		Name     string `json:"name"`
+	}
+	var items []item
+	alphabets := []string{DefaultAlphabet, "0123456789abcdef", "ab", "zyxwvutsrqponmlkjihgfedcba", "αβγδεζηθικλμνξοπρστυφχψω", "一二三四五六七八九十", "23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxy=", "😀😁😂🤣😃"}
+	seed := uint64(0x9E3779B97F4A7C15)
+	next := func() byte {
+		seed ^= seed << 13
+		seed ^= seed >> 7
+		seed ^= seed << 17
+		return byte(seed)
+	}
+	for i := 0; i < 400; i++ {
+		var u uuid.UUID
+		for j := range u {
+			u[j] = next()
+		}
+		if i%7 == 0 {
+			for j := 0; j < int(next())%16; j++ {
+				u[j] = 0
+			}
+		}
+		abc := alphabets[i%len(alphabets)]
+		chars := sortedRunes(abc)
+		// a decode input: the encoding, or a prefix of it, or one digit changed
+		enc := modelEncode(chars, u)
+		rs := []rune(enc)
+		switch i % 5 {
+		case 1:
+			rs = rs[int(next())%len(rs):]
+		case 2:
+			rs[int(next())%len(rs)] = chars[len(chars)-1]
+		case 3:
+			rs = append(rs, chars[int(next())%len(chars)])
+		}
+		name := namePool[i%len(namePool)]
+		if !utf8.ValidString(name) {
+			name = "" // JSON cannot carry it, and a Python str cannot hold it
+		}
+		items = append(items, item{Alphabet: abc, UUID: u.String(), Decode: string(rs), Name: name})
+	}
+	in, _ := json.Marshal(items)
+	script := `
+import json, sys, uuid, shortuuid
+out = []
+for it in json.load(sys.stdin):
+    s = shortuuid.ShortUUID(alphabet=it["alphabet"])
+    u = uuid.UUID(it["uuid"])
+    try:
+        d = str(s.decode(it["decode"]))
+    except ValueError as e:
+        d = "error"
+    name = it["name"]
+    v5 = shortuuid.uuid(name) if name != "" else ""
+    out.append({"encode": s.encode(u), "decode": d, "v5": v5})
+json.dump(out, sys.stdout)
+`
+	cmd := exec.Command("python3", "-c", script)
+	cmd.Stdin = strings.NewReader(string(in))
+	outb, err := cmd.Output()
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			t.Fatalf("python: %v: %s", err, ee.Stderr)
+		}
+		t.Fatal(err)
+	}
+	var out []struct {
+		Encode string `json:"encode"`
+		Decode string `json:"decode"`
+		V5     string `json:"v5"`
+	}
+	if err := json.Unmarshal(outb, &out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != len(items) {
+		t.Fatalf("%d results for %d items", len(out), len(items))
+	}
+	for i, it := range items {
+		enc := NewEncoder(it.Alphabet)
+		u := uuid.MustParse(it.UUID)
+		if got := enc.Encode(u); got != out[i].Encode {
+			t.Errorf("Encode(%s) with %q = %q; Python gives %q", u, it.Alphabet, got, out[i].Encode)
+		}
+		d, err := enc.Decode(it.Decode)
+		got := d.String()
+		if err != nil {
+			got = "error"
+		}
+		if got != out[i].Decode {
+			t.Errorf("Decode(%q) with %q = %s (%v); Python gives %s", it.Decode, it.Alphabet, d, err, out[i].Decode)
+		}
+		if it.Name != "" {
+			if got := NewWithNamespace(it.Name); got != out[i].V5 {
+				t.Errorf("NewWithNamespace(%q) = %q; Python shortuuid.uuid gives %q", it.Name, got, out[i].V5)
+			}
+		}
+	}
+}
