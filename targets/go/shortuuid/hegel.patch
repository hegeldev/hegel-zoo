+package shortuuid
+
+// The model (math/big base-N arithmetic over the sorted alphabet), generators of alphabets and
+// UUIDs, the properties, and the reference test against the Python shortuuid library.
+
+import (
+	"crypto/sha1"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+	"unicode/utf8"
+	"uuid"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- model
+
+var two128 = new(big.Int).Lsh(big.NewInt(1), 128)
+
+// exactLen is the smallest L with n^L >= 2^128: the width every encoding has.
+func exactLen(n int) int {
+	L := 0
+	p := big.NewInt(1)
+	b := big.NewInt(int64(n))
+	for p.Cmp(two128) < 0 {
+		p.Mul(p, b)
+		L++
+	}
+	return L
+}
+
+// sortedRunes is the alphabet as the package prepares it: sorted, deduplicated.
+func sortedRunes(abc string) []rune {
+	rs := []rune(abc)
+	slices.Sort(rs)
+	return slices.Compact(rs)
+}
+
+// modelEncode writes u as a base-len(chars) number, most significant digit first, padded on
+// the left with chars[0] to exactLen digits.
+func modelEncode(chars []rune, u uuid.UUID) string {
+	n := new(big.Int).SetBytes(u[:])
+	base := big.NewInt(int64(len(chars)))
+	L := exactLen(len(chars))
+	digits := make([]rune, L)
+	r := new(big.Int)
+	for i := L - 1; i >= 0; i-- {
+		n.QuoRem(n, base, r)
+		digits[i] = chars[r.Int64()]
+	}
+	return string(digits)
+}
+
+const (
+	decOK = iota
+	decForeign
+	decOverflow
+)
+
+// modelDecode reads s as a base-len(chars) number: a character outside the alphabet is an
+// error, a value of more than 128 bits is an error, anything shorter is padded with zeros.
+func modelDecode(chars []rune, s string) (uuid.UUID, int) {
+	var u uuid.UUID
+	base := big.NewInt(int64(len(chars)))
+	n := new(big.Int)
+	for _, c := range s {
+		i, ok := slices.BinarySearch(chars, c)
+		if !ok {
+			return u, decForeign
+		}
+		n.Mul(n, base)
+		n.Add(n, big.NewInt(int64(i)))
+	}
+	if n.Cmp(two128) >= 0 {
+		return u, decOverflow
+	}
+	n.FillBytes(u[:])
+	return u, decOK
+}
+
+// modelV5 is RFC 9562 section 5.5: SHA-1 of namespace and name, version and variant bits set.
+func modelV5(ns uuid.UUID, name string) uuid.UUID {
+	h := sha1.New()
+	h.Write(ns[:])
+	h.Write([]byte(name))
+	sum := h.Sum(nil)
+	var u uuid.UUID
+	copy(u[:], sum[:16])
+	u[6] = (u[6] & 0x0f) | 0x50
+	u[8] = (u[8] & 0x3f) | 0x80
+	return u
+}
+
+// --------------------------------------------------------------------------- generators
+
+// rune pools: one-byte, two-byte (Greek), three-byte (CJK), four-byte (emoji), and the default
+// alphabet's characters
+var runePools = [][]rune{
+	[]rune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!*'();:@&=+$,/?#[]"),
+	[]rune("αβγδεζηθικλμνξοπρστυφχψωΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿ"),
+	[]rune("一二三四五六七八九十百千万亿零壹贰叁肆伍陆柒捌玖拾日月火水木金土天地人山川田"),
+	[]rune("😀😁😂🤣😃😄😅😆😉😊😋😎😍😘🥰😗😙😚🙂🤗🤩🤔🤨😐😑😶🙄😏😣😥😮"),
+	[]rune(DefaultAlphabet),
+}
+
+// genAlphabet draws an alphabet string as a user might pass it: runes from one or two pools,
+// possibly unsorted and with duplicates, sometimes the whole default alphabet or the whole of
+// a pool, sometimes a large one (more than 255 characters, or a wide code-point spread) to
+// reach every decoding path. Returns the string and its prepared form.
+func genAlphabet(tc hegel.TestCase) (string, []rune) {
+	var rs []rune
+	switch drawInt(tc, 1, 20) {
+	case 1:
+		rs = []rune(DefaultAlphabet)
+	case 2:
+		rs = slices.Clone(pick(tc, runePools))
+	case 3:
+		// wide spread: a few ASCII plus CJK, no rune-index table
+		rs = append(rs, 'a', 'b', 'c')
+		for k := drawInt(tc, 1, 20); k > 0; k-- {
+			rs = append(rs, pick(tc, runePools[2]))
+		}
+	case 4:
+		// more than 255 distinct runes: binary search decoding
+		start := rune(0x4E00 + drawInt(tc, 0, 2000))
+		for i := 0; i < 256+drawInt(tc, 0, 100); i++ {
+			rs = append(rs, start+rune(i))
+		}
+	case 5:
+		// consecutive ASCII: 2 to 94 characters
+		lo := drawInt(tc, 33, 125)
+		hi := drawInt(tc, lo+1, 126)
+		for c := lo; c <= hi; c++ {
+			rs = append(rs, rune(c))
+		}
+	default:
+		pools := []int{drawInt(tc, 0, len(runePools)-1)}
+		if chance(tc, 30) {
+			pools = append(pools, drawInt(tc, 0, len(runePools)-1))
+		}
+		for k := drawInt(tc, 2, 40); k > 0; k-- {
+			rs = append(rs, pick(tc, runePools[pick(tc, pools)]))
+		}
+	}
+	// duplicates and order
+	if chance(tc, 40) {
+		for k := drawInt(tc, 1, 5); k > 0; k-- {
+			rs = append(rs, rs[drawInt(tc, 0, len(rs)-1)])
+		}
+	}
+	if chance(tc, 50) {
+		for i := len(rs) - 1; i > 0; i-- {
+			j := drawInt(tc, 0, i)
+			rs[i], rs[j] = rs[j], rs[i]
+		}
+	}
+	chars := sortedRunes(string(rs))
+	if len(chars) < 2 {
+		rs = append(rs, 'x', 'y')
+		chars = sortedRunes(string(rs))
+	}
+	return string(rs), chars
+}
+
+// genUUID draws a UUID: random bytes, or a value with many leading or trailing zero bytes,
+// all ones, or a small number.
+func genUUID(tc hegel.TestCase) uuid.UUID {
+	var u uuid.UUID
+	switch drawInt(tc, 1, 10) {
+	case 1:
+		return u
+	case 2:
+		for i := range u {
+			u[i] = 0xff
+		}
+		return u
+	case 3:
+		k := drawInt(tc, 0, 15)
+		for i := k; i < 16; i++ {
+			u[i] = byte(drawInt(tc, 0, 255))
+		}
+		return u
+	case 4:
+		k := drawInt(tc, 0, 15)
+		for i := 0; i < k; i++ {
+			u[i] = byte(drawInt(tc, 0, 255))
+		}
+		return u
+	case 5:
+		u[15] = byte(drawInt(tc, 0, 255))
+		return u
+	}
+	for i := range u {
+		u[i] = byte(drawInt(tc, 0, 255))
+	}
+	return u
+}
+
+func encoderOf(abc string, chars []rune) Encoder { return NewEncoder(abc) }
+
+// --------------------------------------------------------------------------- properties
+
+// Encode writes the base-N number the godoc describes, of the exact width, and Decode inverts it.
+func TestHegelEncodeIsBaseN(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		abc, chars := genAlphabet(ht)
+		enc := encoderOf(abc, chars)
+		u := genUUID(ht)
+		got := enc.Encode(u)
+		want := modelEncode(chars, u)
+		if got != want {
+			c.failClass(ht, "encode", "NewEncoder(%q).Encode(%s) = %q; want %q", abc, u, got, want)
+			return
+		}
+		if w := utf8.RuneCountInString(got); w != exactLen(len(chars)) {
+			c.failClass(ht, "width", "NewEncoder(%q).Encode(%s) = %q, %d characters; a %d-character alphabet needs %d", abc, u, got, w, len(chars), exactLen(len(chars)))
+			return
+		}
+		back, err := enc.Decode(got)
+		if err != nil || back != u {
+			c.failClass(ht, "roundtrip", "Decode(Encode(%s)) = %s, %v with alphabet %q", u, back, err, abc)
+			return
+		}
+		switch {
+		case len(chars) == len(DefaultAlphabet) && string(chars) == DefaultAlphabet:
+			c.count("ok default")
+		case utf8.RuneLen(chars[len(chars)-1]) == 1:
+			c.count("ok single-byte")
+		case len(chars) > 255:
+			c.count("ok multibyte, binary search")
+		default:
+			c.count("ok multibyte")
+		}
+	})
+}
+
+// Decode reads any string as the base-N number: short input is padded, a character outside the
+// alphabet or a value beyond 128 bits is an error.
+func TestHegelDecodeIsBaseN(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		abc, chars := genAlphabet(ht)
+		enc := encoderOf(abc, chars)
+		L := exactLen(len(chars))
+		var b strings.Builder
+		length := drawInt(ht, 0, L+2)
+		if chance(ht, 30) {
+			length = L
+		}
+		for i := 0; i < length; i++ {
+			if chance(ht, 20) {
+				b.WriteRune(chars[len(chars)-1]) // large digits: values near or over 2^128
+			} else {
+				b.WriteRune(chars[drawInt(ht, 0, len(chars)-1)])
+			}
+		}
+		s := b.String()
+		if chance(ht, 12) && s != "" {
+			// a character outside the alphabet, or an invalid byte
+			rs := []rune(s)
+			i := drawInt(ht, 0, len(rs)-1)
+			var foreign string
+			for foreign == "" {
+				cand := pick(ht, runePools[drawInt(ht, 0, len(runePools)-1)])
+				if _, ok := slices.BinarySearch(chars, cand); !ok {
+					foreign = string(cand)
+				}
+				if chance(ht, 10) {
+					foreign = "\xff"
+				}
+			}
+			s = string(rs[:i]) + foreign + string(rs[i:])
+		}
+		got, err := enc.Decode(s)
+		want, kind := modelDecode(chars, s)
+		switch kind {
+		case decOK:
+			if err != nil || got != want {
+				c.failClass(ht, "value", "NewEncoder(%q).Decode(%q) = %s, %v; want %s", abc, s, got, err, want)
+				return
+			}
+			if length < L {
+				c.count("ok short")
+			} else if length > L {
+				c.count("ok long")
+			} else {
+				c.count("ok")
+			}
+		case decForeign:
+			if !errors.Is(err, errNotInAlphabet) && !errors.Is(err, errOutOfRange) {
+				c.failClass(ht, "foreign", "NewEncoder(%q).Decode(%q) = %s, %v; want a not-in-alphabet error", abc, s, got, err)
+				return
+			}
+			c.count("foreign rejected")
+		default:
+			if !errors.Is(err, errOutOfRange) {
+				c.failClass(ht, "overflow", "NewEncoder(%q).Decode(%q) = %s, %v; the value needs more than 128 bits", abc, s, got, err)
+				return
+			}
+			c.count("overflow rejected")
+		}
+	})
+}
+
+// Encodings compare as the UUIDs do: fixed width over a sorted alphabet, so string order is
+// UUID order (the README's v7 sorting claim, for any alphabet).
+func TestHegelEncodingPreservesOrder(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		abc, chars := genAlphabet(ht)
+		enc := encoderOf(abc, chars)
+		a, b := genUUID(ht), genUUID(ht)
+		if chance(ht, 30) {
+			b = a
+			if chance(ht, 70) {
+				b[drawInt(ht, 0, 15)] ^= byte(1 << drawInt(ht, 0, 7))
+			}
+		}
+		sa, sb := enc.Encode(a), enc.Encode(b)
+		cu := slices.Compare(a[:], b[:])
+		cs := strings.Compare(sa, sb)
+		if cu != cs {
+			c.fail(ht, "alphabet %q: %s < %s is %d but %q < %q is %d", abc, a, b, cu, sa, sb, cs)
+			return
+		}
+		c.count(fmt.Sprintf("compare %d", cu))
+	})
+}
+
+// The alphabet's order and duplicates do not matter; the default alphabet in any order is the
+// default encoder.
+func TestHegelAlphabetIsASet(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		abc, chars := genAlphabet(ht)
+		if chance(ht, 25) {
+			abc = DefaultAlphabet
+			chars = sortedRunes(abc)
+		}
+		rs := []rune(abc)
+		for i := len(rs) - 1; i > 0; i-- {
+			j := drawInt(ht, 0, i)
+			rs[i], rs[j] = rs[j], rs[i]
+		}
+		for k := drawInt(ht, 0, 3); k > 0; k-- {
+			rs = append(rs, rs[drawInt(ht, 0, len(rs)-1)])
+		}
+		abc2 := string(rs)
+		u := genUUID(ht)
+		e1, e2 := NewEncoder(abc), NewEncoder(abc2)
+		if s1, s2 := e1.Encode(u), e2.Encode(u); s1 != s2 {
+			c.failClass(ht, "order", "NewEncoder(%q) and NewEncoder(%q) encode %s as %q and %q", abc, abc2, u, s1, s2)
+			return
+		}
+		if string(chars) == DefaultAlphabet {
+			if s, d := e2.Encode(u), DefaultEncoder.Encode(u); s != d {
+				c.failClass(ht, "default", "NewEncoder(%q).Encode(%s) = %q; DefaultEncoder gives %q", abc2, u, s, d)
+				return
+			}
+			c.count("default")
+			return
+		}
+		c.count("ok")
+	})
+}
+
+var namePool = []string{"", "example.com", "EXAMPLE.com", "http://example.com", "HTTP://example.com", "https://x", "HtTpS://x", "http:/x", "ftp://x", "1.2.840.113549", "CN=example,O=org", "παράδειγμα", "😀", " ", "http://", "a\x00b", "https", "httpx://a", "xhttp://a", "\xff\xfehttp://"}
+
+// UUIDv5 is RFC 9562's; NewV5 encodes it; NewWithNamespace picks NameSpaceURL for an http or
+// https prefix (any case) and NameSpaceDNS otherwise, and a random v4 for the empty name.
+func TestHegelV5FollowsTheRFC(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		name := pick(ht, namePool)
+		if chance(ht, 40) {
+			var b strings.Builder
+			for k := drawInt(ht, 1, 12); k > 0; k-- {
+				b.WriteRune(pick(ht, runePools[drawInt(ht, 0, len(runePools)-1)]))
+			}
+			name = b.String()
+			if chance(ht, 30) {
+				name = pick(ht, []string{"http://", "HTTPS://", "Http://", "hTtP://"}) + name
+			}
+		}
+		ns := pick(ht, []uuid.UUID{NameSpaceDNS, NameSpaceURL, NameSpaceOID, NameSpaceX500, genUUID(ht)})
+		u := UUIDv5(ns, name)
+		if w := modelV5(ns, name); u != w {
+			c.failClass(ht, "v5", "UUIDv5(%s, %q) = %s; RFC 9562 gives %s", ns, name, u, w)
+			return
+		}
+		if u[6]>>4 != 5 || u[8]>>6 != 2 {
+			c.failClass(ht, "bits", "UUIDv5(%s, %q) = %s: version %d, variant bits %b", ns, name, u, u[6]>>4, u[8]>>6)
+			return
+		}
+		if s := NewV5(ns, name); s != DefaultEncoder.Encode(u) {
+			c.failClass(ht, "NewV5", "NewV5(%s, %q) = %q; want %q", ns, name, s, DefaultEncoder.Encode(u))
+			return
+		}
+		got := NewWithNamespace(name)
+		if name == "" {
+			d, err := DefaultEncoder.Decode(got)
+			if err != nil || d[6]>>4 != 4 || d[8]>>6 != 2 {
+				c.failClass(ht, "empty", "NewWithNamespace(\"\") = %q, decodes to %s (%v); want a v4 UUID", got, d, err)
+				return
+			}
+			c.count("empty name: v4")
+			return
+		}
+		lower := strings.ToLower(name)
+		wantNS := NameSpaceDNS
+		if strings.HasPrefix(lower, "http://") || strings.HasPrefix(lower, "https://") {
+			wantNS = NameSpaceURL
+		}
+		if want := DefaultEncoder.Encode(modelV5(wantNS, name)); got != want {
+			c.failClass(ht, "namespace", "NewWithNamespace(%q) = %q; want %q (namespace %s)", name, got, want, wantNS)
+			return
+		}
+		if wantNS == NameSpaceURL {
+			c.count("URL")
+		} else {
+			c.count("DNS")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- Python reference
+
+// TestHegelPythonReferenceAgrees runs the Python shortuuid library (the one this package is
+// "based on and compatible with") on a batch of UUIDs, alphabets and strings, and compares.
+// Skipped when python3 with the shortuuid module is not on PATH.
+func TestHegelPythonReferenceAgrees(t *testing.T) {
+	if err := exec.Command("python3", "-c", "import shortuuid").Run(); err != nil {
+		t.Skip("python3 with shortuuid not available: ", err)
+	}
+	type item struct {
+		Alphabet string `json:"alphabet"`
+		UUID     string `json:"uuid"`
+		Decode   string `json:"decode"`
+		Name     string `json:"name"`
+	}
+	var items []item
+	alphabets := []string{DefaultAlphabet, "0123456789abcdef", "ab", "zyxwvutsrqponmlkjihgfedcba", "αβγδεζηθικλμνξοπρστυφχψω", "一二三四五六七八九十", "23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxy=", "😀😁😂🤣😃"}
+	seed := uint64(0x9E3779B97F4A7C15)
+	next := func() byte {
+		seed ^= seed << 13
+		seed ^= seed >> 7
+		seed ^= seed << 17
+		return byte(seed)
+	}
+	for i := 0; i < 400; i++ {
+		var u uuid.UUID
+		for j := range u {
+			u[j] = next()
+		}
+		if i%7 == 0 {
+			for j := 0; j < int(next())%16; j++ {
+				u[j] = 0
+			}
+		}
+		abc := alphabets[i%len(alphabets)]
+		chars := sortedRunes(abc)
+		// a decode input: the encoding, or a prefix of it, or one digit changed
+		enc := modelEncode(chars, u)
+		rs := []rune(enc)
+		switch i % 5 {
+		case 1:
+			rs = rs[int(next())%len(rs):]
+		case 2:
+			rs[int(next())%len(rs)] = chars[len(chars)-1]
+		case 3:
+			rs = append(rs, chars[int(next())%len(chars)])
+		}
+		name := namePool[i%len(namePool)]
+		if !utf8.ValidString(name) {
+			name = "" // JSON cannot carry it, and a Python str cannot hold it
+		}
+		items = append(items, item{Alphabet: abc, UUID: u.String(), Decode: string(rs), Name: name})
+	}
+	in, _ := json.Marshal(items)
+	script := `
+import json, sys, uuid, shortuuid
+out = []
+for it in json.load(sys.stdin):
+    s = shortuuid.ShortUUID(alphabet=it["alphabet"])
+    u = uuid.UUID(it["uuid"])
+    try:
+        d = str(s.decode(it["decode"]))
+    except ValueError as e:
+        d = "error"
+    name = it["name"]
+    v5 = shortuuid.uuid(name) if name != "" else ""
+    out.append({"encode": s.encode(u), "decode": d, "v5": v5})
+json.dump(out, sys.stdout)
+`
+	cmd := exec.Command("python3", "-c", script)
+	cmd.Stdin = strings.NewReader(string(in))
+	outb, err := cmd.Output()
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			t.Fatalf("python: %v: %s", err, ee.Stderr)
+		}
+		t.Fatal(err)
+	}
+	var out []struct {
+		Encode string `json:"encode"`
+		Decode string `json:"decode"`
+		V5     string `json:"v5"`
+	}
+	if err := json.Unmarshal(outb, &out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != len(items) {
+		t.Fatalf("%d results for %d items", len(out), len(items))
+	}
+	for i, it := range items {
+		enc := NewEncoder(it.Alphabet)
+		u := uuid.MustParse(it.UUID)
+		if got := enc.Encode(u); got != out[i].Encode {
+			t.Errorf("Encode(%s) with %q = %q; Python gives %q", u, it.Alphabet, got, out[i].Encode)
+		}
+		d, err := enc.Decode(it.Decode)
+		got := d.String()
+		if err != nil {
+			got = "error"
+		}
+		if got != out[i].Decode {
+			t.Errorf("Decode(%q) with %q = %s (%v); Python gives %s", it.Decode, it.Alphabet, d, err, out[i].Decode)
+		}
+		if it.Name != "" {
+			if got := NewWithNamespace(it.Name); got != out[i].V5 {
+				t.Errorf("NewWithNamespace(%q) = %q; Python shortuuid.uuid gives %q", it.Name, got, out[i].V5)
+			}
+		}
+	}
+}
