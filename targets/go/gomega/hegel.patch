+// --------------------------------------------------------------------------- gomega/9
+
+// plainElems: elements that are not slices (a single slice argument would be flattened).
+var plainElems = weighted(
+	choice[any]{40, asAny(hegel.Integers(0, 4))},
+	choice[any]{30, asAny(elemStrings)},
+	choice[any]{10, hegel.Just[any](nil)},
+	choice[any]{10, asAny(hegel.Map(hegel.Integers(0, 2), func(k int) pt { return pt{k} }))},
+	choice[any]{10, asAny(hegel.Map(hegel.Integers(0, 4), func(k int) float64 { return float64(k) }))},
+)
+
+// exactCase: the elements the actual and the expectations share (none, so that the missing or
+// extra elements start at index 0, the shape of gomega/9; one to three under
+// HEGEL_NO_KNOWN=1), the elements one side has beyond them, and which side.
+type exactCase struct {
+	common  []any
+	surplus []any
+	missing bool // the expectations have the surplus (the actual is shorter)
+}
+
+var exactCases = hegel.Composite(func(tc hegel.TestCase) exactCase {
+	return exactCase{
+		common: hegel.Draw(tc, shaped[hegel.Generator[[]any]](hegel.Just[[]any](nil), hegel.Lists(plainElems).MinSize(1).MaxSize(3))),
+		// one surplus element: with more the message names the last extra index, which is
+		// gomega/15's property
+		surplus: hegel.Draw(tc, hegel.Lists(plainElems).MinSize(1).MaxSize(1)),
+		missing: hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+// sides are the actual and the expectations.
+func (ec exactCase) sides() (actual []any, exps []any) {
+	longer := append(append([]any{}, ec.common...), ec.surplus...)
+	shorter := append([]any{}, ec.common...)
+	if ec.missing {
+		return shorter, longer
+	}
+	return longer, shorter
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (ec exactCase) GoString() string {
+	actual, exps := ec.sides()
+	return fmt.Sprintf("HaveExactElements(%s) on %#v", labels(expectationsOf(exps)), actual)
+}
+
+func expectationsOf(vs []any) []expectation {
+	es := make([]expectation, len(vs))
+	for i, v := range vs {
+		es[i] = elemExpectation(v)
+	}
+	return es
+}
+
+// TestHegelExactElementsMessageNamesIndexZero: when the actual is shorter or longer than the
+// expectations, HaveExactElements fails and its message says where the missing or extra
+// elements start, index 0 included. The package omits the line for index 0 (gomega/9).
+func TestHegelExactElementsMessageNamesIndexZero(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, exactCases)
+		actual, exps := ec.sides()
+		m := HaveExactElements(exps...)
+		got := run(m, actual)
+		if got.err != "" || got.ok {
+			c.fail(ht, "%#v = %s, want false", ec, got)
+			return
+		}
+		which := "extra"
+		if ec.missing {
+			which = "missing"
+		}
+		line := fmt.Sprintf("the %s elements start from index %d", which, len(ec.common))
+		if msg := m.FailureMessage(actual); !strings.Contains(msg, line) {
+			c.mismatch(ht, shapeIf(len(ec.common) == 0, "gomega/9"), "Message", "%#v: message %q lacks %q", ec, msg, line)
+			return
+		}
+		c.count(which)
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/15
+
+// extraCase: the elements both sides share (one to three, so that the first extra index is
+// above zero and gomega/9 stays out of the way) and the extra elements of the actual: two to
+// four by default, the shape of gomega/15; one under HEGEL_NO_KNOWN=1.
+type extraCase struct {
+	common []any
+	extra  []any
+}
+
+var extraCases = hegel.Composite(func(tc hegel.TestCase) extraCase {
+	return extraCase{
+		common: hegel.Draw(tc, hegel.Lists(plainElems).MinSize(1).MaxSize(3)),
+		extra:  hegel.Draw(tc, shaped[hegel.Generator[[]any]](hegel.Lists(plainElems).MinSize(2).MaxSize(4), hegel.Lists(plainElems).MinSize(1).MaxSize(1))),
+	}
+})
+
+func (ec extraCase) actual() []any { return append(append([]any{}, ec.common...), ec.extra...) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (ec extraCase) GoString() string {
+	return fmt.Sprintf("HaveExactElements(%s) on %#v", labels(expectationsOf(ec.common)), ec.actual())
+}
+
+// TestHegelExactElementsMessageNamesTheFirstExtraIndex: when the actual is longer than the
+// expectations, HaveExactElements fails and its message says where the extra elements start,
+// which is the first extra index. The package names the last one (gomega/15).
+func TestHegelExactElementsMessageNamesTheFirstExtraIndex(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, extraCases)
+		actual := ec.actual()
+		m := HaveExactElements(ec.common...)
+		got := run(m, actual)
+		if got.err != "" || got.ok {
+			c.fail(ht, "%#v = %s, want false", ec, got)
+			return
+		}
+		line := fmt.Sprintf("the extra elements start from index %d", len(ec.common))
+		if msg := m.FailureMessage(actual); !strings.Contains(msg, line) {
+			c.mismatch(ht, shapeIf(len(ec.extra) > 1, "gomega/15"), "Message", "%#v: message %q lacks %q", ec, msg, line)
+			return
+		}
+		c.count("ok")
+	})
+}
