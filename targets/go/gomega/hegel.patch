+// --------------------------------------------------------------------------- gomega/8
+
+// streamCase: a document and the expected text: the same document followed by a second one
+// (a stream, the shape of gomega/8), or under HEGEL_NO_KNOWN=1 the same single document with
+// a "---" marker.
+type streamCase struct {
+	a      jv
+	sa, sb yamlStyle
+	second jv
+	stream bool
+}
+
+var streamCases = hegel.Composite(func(tc hegel.TestCase) streamCase {
+	sc := streamCase{a: hegel.Draw(tc, yamlTrees), sa: hegel.Draw(tc, yamlStyles), sb: hegel.Draw(tc, yamlStyles), stream: !noKnown}
+	if sc.stream {
+		sc.second = hegel.Draw(tc, hegel.OneOf(hegel.Just(objectOf(map[string]jv{"extra": itoaNumber(1)})), yamlTrees))
+	} else {
+		sc.sb.header = true
+	}
+	return sc
+})
+
+func (sc streamCase) expected() string {
+	s := renderYAML(sc.a, sc.sb)
+	if sc.stream {
+		s += "\n---\n" + renderYAML(sc.second, yamlStyle{})
+	}
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (sc streamCase) GoString() string {
+	return fmt.Sprintf("MatchYAML(%q) on %q", sc.expected(), renderYAML(sc.a, sc.sa))
+}
+
+// TestHegelYAMLStreamsCompareWholly: a document does not match a stream of itself and another
+// document. The package reads the first document of a stream and ignores the rest (gomega/8).
+func TestHegelYAMLStreamsCompareWholly(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, streamCases)
+		sa, sb := renderYAML(sc.a, sc.sa), sc.expected()
+		got := run(MatchYAML(sb), sa)
+		want := func(k known) res { return res{ok: yamlModel(sc.a, sc.a, sc.stream, k)} }
+		if judge(ht, c, yamlBugs, "MatchYAML", got, want, "%#v", sc) {
+			c.count(got.String())
+		}
+	})
+}
