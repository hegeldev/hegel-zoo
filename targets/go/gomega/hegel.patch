+// --------------------------------------------------------------------------- gomega/10
+
+// param is a function parameter type that can hold nil, a function of it reporting whether it
+// got nil (for WithTransform and Satisfy), and a non-nil value of the type.
+type param struct {
+	name   string
+	fn     any
+	nonNil any
+}
+
+var (
+	nillables = []param{
+		{"*int", func(p *int) bool { return p == nil }, ptrTo(1)},
+		{"[]int", func(p []int) bool { return p == nil }, []int{1}},
+		{"map[string]int", func(p map[string]int) bool { return p == nil }, map[string]int{"a": 1}},
+		{"func()", func(p func()) bool { return p == nil }, func() {}},
+		{"chan int", func(p chan int) bool { return p == nil }, make(chan int)},
+	}
+	interfaces = []param{
+		{"any", func(p any) bool { return p == nil }, 1},
+		{"error", func(p error) bool { return p == nil }, errors.New("x")},
+	}
+	paramNames = func(ps []param) []string {
+		names := make([]string, len(ps))
+		for i, p := range ps {
+			names[i] = p.name
+		}
+		return names
+	}
+	paramsByName = func() map[string]param {
+		m := map[string]param{}
+		for _, p := range append(append([]param{}, nillables...), interfaces...) {
+			m[p.name] = p
+		}
+		return m
+	}()
+)
+
+// nilCase: the parameter type (a pointer, slice, map, func or chan: the shape of gomega/10; an
+// interface under HEGEL_NO_KNOWN=1), the matcher, and whether the actual is nil.
+type nilCase struct {
+	param   string
+	matcher string
+	isNil   bool
+}
+
+var nilCases = hegel.Composite(func(tc hegel.TestCase) nilCase {
+	return nilCase{
+		param:   hegel.Draw(tc, hegel.SampledFrom(shaped(paramNames(nillables), paramNames(interfaces)))),
+		matcher: hegel.Draw(tc, hegel.SampledFrom([]string{"WithTransform", "Satisfy"})),
+		isNil:   hegel.Draw(tc, chance(70)),
+	}
+})
+
+func (nc nilCase) actual() any {
+	if nc.isNil {
+		return nil
+	}
+	return paramsByName[nc.param].nonNil
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (nc nilCase) GoString() string {
+	return fmt.Sprintf("%s(func(%s) bool) on %#v", nc.matcher, nc.param, nc.actual())
+}
+
+// TestHegelNilActualFitsNillableParameters: WithTransform and Satisfy pass a nil actual to a
+// function whose parameter can be nil, as they do for an interface parameter, and a value of
+// the type as it is. The package refuses a nil actual for a pointer, slice, map, func or chan
+// parameter (gomega/10).
+func TestHegelNilActualFitsNillableParameters(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nc := hegel.Draw(ht, nilCases)
+		p := paramsByName[nc.param]
+		m := Satisfy(p.fn)
+		if nc.matcher == "WithTransform" {
+			m = WithTransform(p.fn, BeTrue())
+		}
+		got := run(m, nc.actual())
+		if got.err != "" || got.ok != nc.isNil {
+			c.mismatch(ht, shapeIf(nc.isNil && !noKnown, "gomega/10"), nc.matcher, "%#v = %s, want %v", nc, got, nc.isNil)
+			return
+		}
+		c.count(fmt.Sprint(nc.matcher, " ", got.ok))
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/11
+
+// bytesCase: two byte slices, a nil one and an empty one (the shape of gomega/11; under
+// HEGEL_NO_KNOWN=1 both nil, both empty, or int slices), and the matcher Equal reaches them
+// through.
+type bytesCase struct {
+	a, b any
+	via  string
+}
+
+var (
+	nilAndEmpty = hegel.OneOf(
+		hegel.Just([2]any{[]byte(nil), []byte{}}),
+		hegel.Just([2]any{[]byte{}, []byte(nil)}),
+	)
+	alike = hegel.OneOf(
+		hegel.Just([2]any{[]byte(nil), []byte(nil)}),
+		hegel.Just([2]any{[]byte{}, []byte{}}),
+		hegel.Just([2]any{[]int(nil), []int{}}),
+		hegel.Just([2]any{[]int{}, []int(nil)}),
+	)
+	bytesCases = hegel.Composite(func(tc hegel.TestCase) bytesCase {
+		p := hegel.Draw(tc, shaped(nilAndEmpty, alike))
+		return bytesCase{a: p[0], b: p[1], via: hegel.Draw(tc, hegel.SampledFrom([]string{"Equal", "ContainElement", "BeElementOf"}))}
+	})
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (bc bytesCase) GoString() string {
+	switch bc.via {
+	case "ContainElement":
+		return fmt.Sprintf("ContainElement(%#v) on []any{%#v}", bc.b, bc.a)
+	case "BeElementOf":
+		return fmt.Sprintf("BeElementOf(%#v, \"x\") on %#v", bc.b, bc.a)
+	}
+	return fmt.Sprintf("Equal(%#v) on %#v", bc.b, bc.a)
+}
+
+// TestHegelEqualDistinguishesNilAndEmptyBytes: Equal is reflect.DeepEqual, so a nil byte slice
+// does not equal an empty one, through Equal itself, ContainElement and BeElementOf alike. The
+// package compares two byte slices with bytes.Equal (gomega/11).
+func TestHegelEqualDistinguishesNilAndEmptyBytes(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		bc := hegel.Draw(ht, bytesCases)
+		var got res
+		switch bc.via {
+		case "ContainElement":
+			got = run(ContainElement(bc.b), []any{bc.a})
+		case "BeElementOf":
+			got = run(BeElementOf(bc.b, "x"), bc.a)
+		default:
+			got = run(Equal(bc.b), bc.a)
+		}
+		want := func(k known) res { ok, _ := equalModel(bc.b)(bc.a, k); return res{ok: ok} }
+		if judge(ht, c, valueBugs, bc.via, got, want, "%#v", bc) {
+			c.count(got.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/12
+
+// erringKeyCase: a map with int keys, one of them above 1 (the others 0 and 1, so that the key
+// matcher accepts one key alone), and (the shape of gomega/12) string keys, on which
+// BeNumerically(">", 1) errors; the value looked for is the key's above 1.
+type erringKeyCase struct {
+	ints    map[int]int
+	strs    map[string]int
+	big     int
+	bigVal  int
+	withVal bool
+}
+
+var (
+	erringKeyCases = hegel.Composite(func(tc hegel.TestCase) erringKeyCase {
+		return erringKeyCase{
+			ints:    hegel.Draw(tc, hegel.Maps(hegel.Integers(0, 1), hegel.Integers(0, 9)).MaxSize(2)),
+			strs:    hegel.Draw(tc, shaped[hegel.Generator[map[string]int]](hegel.Maps(elemStrings, hegel.Integers(0, 9)).MinSize(1).MaxSize(2), hegel.Just[map[string]int](nil))),
+			big:     hegel.Draw(tc, hegel.Integers(2, 5)),
+			bigVal:  hegel.Draw(tc, hegel.Integers(0, 9)),
+			withVal: hegel.Draw(tc, hegel.Booleans()),
+		}
+	})
+	above1 = numericallyAbove(1)
+)
+
+func (ec erringKeyCase) m() map[any]any {
+	m := map[any]any{}
+	for k, v := range ec.ints {
+		m[k] = v
+	}
+	for k, v := range ec.strs {
+		m[k] = v
+	}
+	m[ec.big] = ec.bigVal
+	return m
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (ec erringKeyCase) GoString() string {
+	mc := mapCase{entries: ec.m()}
+	var parts []string
+	for _, k := range mc.keys() {
+		parts = append(parts, fmt.Sprintf("%#v: %#v", k, mc.entries[k]))
+	}
+	if ec.withVal {
+		return fmt.Sprintf("HaveKeyWithValue(%s, %d) on {%s}", above1.label, ec.bigVal, strings.Join(parts, ", "))
+	}
+	return fmt.Sprintf("HaveKey(%s) on {%s}", above1.label, strings.Join(parts, ", "))
+}
+
+// TestHegelKeyMatcherErrorsDoNotHideAMatch: HaveKey and HaveKeyWithValue with a key matcher
+// find a key the matcher accepts whatever the map's order, even when the matcher errors on
+// another key. The package returns the first error the map's order yields (gomega/12). The
+// package's answer is cached per case (verdicts).
+func TestHegelKeyMatcherErrorsDoNotHideAMatch(t *testing.T) {
+	c := newCollector(t)
+	v := newVerdicts()
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, erringKeyCases)
+		m := ec.m()
+		keys := mapCase{entries: m}.keys()
+		var got res
+		var want func(known) map[string]bool
+		class := "HaveKey"
+		if ec.withVal {
+			class = "HaveKeyWithValue"
+			ve := elemExpectation(ec.bigVal)
+			got = v.run(ec.GoString(), HaveKeyWithValue(above1.arg, ec.bigVal), m)
+			want = func(k known) map[string]bool { return haveKeyWithValueOutcomes(m, keys, above1, ve, k) }
+		} else {
+			got = v.run(ec.GoString(), HaveKey(above1.arg), m)
+			want = func(k known) map[string]bool { return haveKeyOutcomes(keys, above1, k) }
+		}
+		if judgeOutcomes(ht, c, class, got, want, "%#v", ec) {
+			c.count(got.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/13
+
+// nilElementCase: a collection holding a nil element (the shape of gomega/13; none under
+// HEGEL_NO_KNOWN=1) met by ContainElement(nil), HaveEach(nil) (every element nil) or
+// HaveKeyWithValue(key, nil).
+type nilElementCase struct {
+	matcher string
+	others  []any // the non-nil elements
+	at      int   // where the nil goes, modulo the elements plus one
+	typed   bool  // the collection is an []*int instead of an []any
+	key     string
+}
+
+var (
+	nonNilElems     = hegel.Filter(elems, func(e any) bool { return e != nil })
+	nilElementCases = hegel.Composite(func(tc hegel.TestCase) nilElementCase {
+		nc := nilElementCase{
+			matcher: hegel.Draw(tc, hegel.SampledFrom([]string{"ContainElement", "HaveEach", "HaveKeyWithValue"})),
+			at:      hegel.Draw(tc, hegel.Integers(0, 3)),
+			typed:   hegel.Draw(tc, chance(30)),
+			key:     hegel.Draw(tc, elemStrings),
+		}
+		switch nc.matcher {
+		case "HaveEach":
+			nc.others = hegel.Draw(tc, hegel.Lists(nonNilElems).MaxSize(2)) // only under HEGEL_NO_KNOWN=1
+		default:
+			nc.others = hegel.Draw(tc, hegel.Lists(nonNilElems).MaxSize(3))
+		}
+		return nc
+	})
+)
+
+// elems are the collection's elements: the others with a nil among them (one to three nils
+// for HaveEach), or the others alone under HEGEL_NO_KNOWN=1.
+func (nc nilElementCase) elems() []any {
+	if noKnown {
+		if nc.matcher == "HaveEach" && len(nc.others) == 0 {
+			return []any{1}
+		}
+		return nc.others
+	}
+	if nc.matcher == "HaveEach" {
+		return make([]any, nc.at%3+1)
+	}
+	i := nc.at % (len(nc.others) + 1)
+	out := append([]any{}, nc.others[:i]...)
+	out = append(out, nil)
+	return append(out, nc.others[i:]...)
+}
+
+// collection is the elements as the matcher sees them: an []any, an []*int when typed (its
+// elements nil pointers for nils and pointers to 1 otherwise), or a map for HaveKeyWithValue.
+func (nc nilElementCase) collection() any {
+	es := nc.elems()
+	if nc.matcher == "HaveKeyWithValue" {
+		m := map[string]any{}
+		if noKnown {
+			m[nc.key] = 1
+		} else {
+			m[nc.key] = nil
+		}
+		return m
+	}
+	if nc.typed {
+		ps := make([]*int, len(es))
+		for i, e := range es {
+			if e != nil {
+				ps[i] = ptrTo(1)
+			}
+		}
+		return ps
+	}
+	return es
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (nc nilElementCase) GoString() string {
+	if nc.matcher == "HaveKeyWithValue" {
+		return fmt.Sprintf("HaveKeyWithValue(%q, nil) on %#v", nc.key, nc.collection())
+	}
+	return fmt.Sprintf("%s(nil) on %#v", nc.matcher, nc.collection())
+}
+
+// TestHegelNilElementsMatchNil: ContainElement(nil) matches a collection with a nil element,
+// HaveEach(nil) a collection of nils and HaveKeyWithValue(key, nil) a map whose key holds nil,
+// as ConsistOf(nil) does. The package wraps the nil in Equal(nil), which refuses a nil element
+// (gomega/13).
+func TestHegelNilElementsMatchNil(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nc := hegel.Draw(ht, nilElementCases)
+		coll := nc.collection()
+		e := elemExpectation(nil)
+		var got res
+		var want func(known) res
+		switch nc.matcher {
+		case "HaveKeyWithValue":
+			m := coll.(map[string]any)
+			got = run(HaveKeyWithValue(nc.key, nil), m)
+			want = func(k known) res {
+				vok, ver := e.match(m[nc.key], k)
+				if k.nilElementEqual {
+					vok, ver = equalModel(nil)(m[nc.key], k)
+				}
+				if ver {
+					return res{err: "value"}
+				}
+				return res{ok: vok}
+			}
+		case "HaveEach":
+			got = run(HaveEach(nil), coll)
+			want = func(k known) res {
+				adj, errs := elementModel(valuesOf(coll), e, k)
+				for i := range adj {
+					if errs[i] {
+						return res{err: "element"}
+					}
+					if !adj[i] {
+						return res{ok: false}
+					}
+				}
+				return res{ok: true}
+			}
+		default:
+			got = run(ContainElement(nil), coll)
+			want = func(k known) res {
+				adj, errs := elementModel(valuesOf(coll), e, k)
+				anyOK, anyErr := false, false
+				for i := range adj {
+					anyOK, anyErr = anyOK || adj[i], anyErr || errs[i]
+				}
+				switch {
+				case anyOK:
+					return res{ok: true}
+				case anyErr:
+					return res{err: "element"}
+				}
+				return res{ok: false}
+			}
+		}
+		if judge(ht, c, collectionBugs, nc.matcher, got, want, "%#v", nc) {
+			c.count(got.String())
+		}
+	})
+}
+
+// valuesOf is the elements of a slice as an []any (a nil pointer as a typed nil).
+func valuesOf(coll any) []any {
+	rv := reflect.ValueOf(coll)
+	out := make([]any, rv.Len())
+	for i := range out {
+		out[i] = rv.Index(i).Interface()
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- gomega/14
+
+// thresholdCases: two numbers of one kind a small distance apart, within a threshold, under ==
+// (the shape of gomega/14 for the integer kinds; the float kinds are exact); under
+// HEGEL_NO_KNOWN=1 the distance is beyond the threshold or zero.
+var thresholdCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+	k := hegel.Draw(tc, hegel.SampledFrom(allKinds))
+	th := hegel.Draw(tc, hegel.Integers[int64](1, 20))
+	d := hegel.Draw(tc, shaped(hegel.Integers[int64](1, 20), hegel.OneOf(hegel.Just[int64](0), hegel.Integers[int64](21, 40))))
+	if !noKnown {
+		d = (d-1)%th + 1 // within the threshold
+	}
+	if hegel.Draw(tc, hegel.Booleans()) {
+		d = -d
+	}
+	var a num
+	switch family(k) {
+	case "int":
+		a = intNum(k, hegel.Draw(tc, hegel.Integers[int64](-50, 50)))
+	case "uint":
+		a = uintNum(k, hegel.Draw(tc, hegel.Integers[uint64](40, 100)))
+	default:
+		a = floatNum(k, float64(hegel.Draw(tc, hegel.Integers[int64](-50, 50)))*4)
+	}
+	t := intNum(reflect.Int, th)
+	return numCase{a: a, c: near(a, d), cmp: "==", th: &t}
+})
+
+// TestHegelEqualsThresholdIsTheSameForEveryKind: BeNumerically("==", x, threshold) means the
+// same for integers, unsigned integers and floats: equality, the threshold belonging to ~ (so
+// two numbers a small distance apart are not ==). The package applies the threshold to == on
+// integers and not on floats (gomega/14).
+func TestHegelEqualsThresholdIsTheSameForEveryKind(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumerically(ht, c, hegel.Draw(ht, thresholdCases))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..420713c
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,305 @@
+package hegel
+
+// Hegel property tests for onsi/gomega, written for the Hegel zoo. See targets/go/gomega/README.md.
+//
+// Oracle: models of the documented matcher semantics (matchers.go doc comments and the Gomega
+// reference): multiset matching by brute force for ConsistOf/ContainElements, exact rational
+// comparison for BeNumerically, semantic equality of decoded JSON/YAML/XML documents, and the
+// map and struct rules for the key, field and element matchers.
+//
+// Every property draws one case record built from the binding's combinators (a number pair and
+// its comparator, a collection and its expectations, a map and two matchers, a document tree
+// with a spelling record per rendering), and pure functions turn the record into the values the
+// matcher and the model see. The shapes of the recorded bugs (bugs.toml) are drawn at their
+// natural rate, so the properties that meet them fail, naming the bug (mismatch), and are the
+// expected failures mapped to the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property
+// per bug over its shape region alone, and hegel_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 (noKnown, below) makes the model follow the recorded behaviour instead and
+// leaves out of the generators the shapes the model cannot follow, for a run that looks past
+// the known bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"math/bits"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case that has the shape of the recorded
+// bugs named (none for a plain failure): the failure names the shape. Under HEGEL_NO_KNOWN=1
+// every switch is on, so a disagreement that a recorded behaviour explains is a case the model
+// did not follow; it is skipped and counted instead (rare, since the model follows every
+// switch and the generators leave out the shapes it cannot).
+func (c *collector) mismatch(ht *hegel.T, shape []string, class string, format string, args ...any) {
+	if len(shape) > 0 {
+		if noKnown {
+			c.count("assumed " + strings.Join(shape, "+"))
+			ht.Assume(false)
+		}
+		c.count("shape " + strings.Join(shape, "+"))
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch of Known is off, the model states the documented behaviour, the generators draw
+// the bugs' shapes and the properties that meet them fail, naming the shape (mismatch, with
+// explain naming the bugs whose recorded behaviour accounts for the package's answer); under
+// HEGEL_NO_KNOWN=1 every switch is on and the model reproduces the recorded behaviour.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// known holds the switches of the recorded bugs: the model follows a recorded behaviour while
+// its switch is on. The pins assert the documented behaviour and fail while the bug exists.
+type known struct {
+	mixedSignConversion    bool // 1: a signed and an unsigned integer are compared after converting to the actual's kind
+	intDiffOverflow        bool // 2: ~ and == on integers subtract in int64 and wrap
+	intFloatRounding       bool // 3: an integer and a float are compared as float64
+	keyMatcherFirstKey     bool // 4: HaveKeyWithValue judges the first key (in map order) the key matcher accepts
+	jsonDecodeErrorIgnored bool // 5: MatchJSON ignores json.Unmarshal errors (out-of-range numbers decode as infinities)
+	jsonNumbersFloat64     bool // 6: MatchJSON compares numbers as float64
+	xmlPrefixLiteral       bool // 7: MatchXML compares namespace declarations and prefixes literally
+	yamlFirstDocument      bool // 8: MatchYAML reads only the first document of a stream
+	equalBytesSpecial      bool // 11: Equal([]byte) uses bytes.Equal (nil equals empty)
+	keyMatcherErrorOrder   bool // 12: HaveKey/HaveKeyWithValue error or match depending on map order when the key matcher errors on a key
+	nilElementEqual        bool // 13: ContainElement(nil), HaveEach(nil) and HaveKeyWithValue(k, nil) error on a nil element instead of matching it
+	equalsThresholdInts    bool // 14: == with a threshold is ~ for integers and exact for floats
+}
+
+// Known: the switches of the run, all off by default and all on under HEGEL_NO_KNOWN=1.
+var Known = known{
+	mixedSignConversion:    noKnown,
+	intDiffOverflow:        noKnown,
+	intFloatRounding:       noKnown,
+	keyMatcherFirstKey:     noKnown,
+	jsonDecodeErrorIgnored: noKnown,
+	jsonNumbersFloat64:     noKnown,
+	xmlPrefixLiteral:       noKnown,
+	yamlFirstDocument:      noKnown,
+	equalBytesSpecial:      noKnown,
+	keyMatcherErrorOrder:   noKnown,
+	nilElementEqual:        noKnown,
+	equalsThresholdInts:    noKnown,
+}
+
+// switches turns on the switch of a recorded bug.
+var switches = map[string]func(*known){
+	"gomega/1":  func(k *known) { k.mixedSignConversion = true },
+	"gomega/2":  func(k *known) { k.intDiffOverflow = true },
+	"gomega/3":  func(k *known) { k.intFloatRounding = true },
+	"gomega/4":  func(k *known) { k.keyMatcherFirstKey = true },
+	"gomega/5":  func(k *known) { k.jsonDecodeErrorIgnored = true },
+	"gomega/6":  func(k *known) { k.jsonNumbersFloat64 = true },
+	"gomega/7":  func(k *known) { k.xmlPrefixLiteral = true },
+	"gomega/8":  func(k *known) { k.yamlFirstDocument = true },
+	"gomega/11": func(k *known) { k.equalBytesSpecial = true },
+	"gomega/12": func(k *known) { k.keyMatcherErrorOrder = true },
+	"gomega/13": func(k *known) { k.nilElementEqual = true },
+	"gomega/14": func(k *known) { k.equalsThresholdInts = true },
+}
+
+// knownOf is the switch set of the bugs named.
+func knownOf(ids ...string) known {
+	var k known
+	for _, id := range ids {
+		switches[id](&k)
+	}
+	return k
+}
+
+// explain names the recorded bugs whose behaviours, switched on in the model together, account
+// for the package's answer on a case the documented model disagrees with: the smallest set among
+// ids (the first in the order given, among sets of one size) for which fits holds; nil when no set
+// does, which makes the disagreement a plain failure.
+func explain(ids []string, fits func(known) bool) []string {
+	n := len(ids)
+	for size := 1; size <= n; size++ {
+		for mask := 1; mask < 1<<n; mask++ {
+			if bits.OnesCount(uint(mask)) != size {
+				continue
+			}
+			var set []string
+			for i, id := range ids {
+				if mask&(1<<i) != 0 {
+					set = append(set, id)
+				}
+			}
+			if fits(knownOf(set...)) {
+				return set
+			}
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// asAny widens a generator's values to any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// tape is a list of up to n small integers below hi, read modulo its length by a renderer: an
+// empty tape (which it shrinks to) is the plain spelling throughout.
+func tape(hi, n int) hegel.Generator[[]int] {
+	return hegel.Lists(hegel.Integers(0, hi)).MaxSize(n)
+}
+
+// at reads the i-th entry of a tape, modulo its length; 0 for an empty tape.
+func at(tape []int, i int) int {
+	if len(tape) == 0 {
+		return 0
+	}
+	return tape[i%len(tape)]
+}
