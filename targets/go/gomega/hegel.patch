+// TestHegelCollections: ConsistOf, ContainElements, HaveExactElements, ContainElement, HaveEach
+// against the multiset semantics of the documentation (a maximum matching between elements and
+// expectations).
+func TestHegelCollections(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		n := drawInt(ht, 0, 6)
+		elems := make([]any, n)
+		for i := range elems {
+			elems[i] = genElem(ht)
+		}
+		k := drawInt(ht, 0, 6)
+		if chance(ht, 40) {
+			k = n
+		}
+		exps := make([]expectation, k)
+		for i := range exps {
+			if i < n && chance(ht, 50) {
+				// an expectation spelled from an element present
+				exps[i] = elemExpectation(elems[drawInt(ht, 0, n-1)])
+			} else {
+				exps[i] = genExpectation(ht)
+			}
+		}
+		// the collection in one of its shapes
+		var actual any
+		shape := drawInt(ht, 0, 3)
+		switch shape {
+		case 0:
+			actual = elems
+		case 1:
+			arr := reflect.New(reflect.ArrayOf(n, reflect.TypeOf((*any)(nil)).Elem())).Elem()
+			for i, e := range elems {
+				if e != nil {
+					arr.Index(i).Set(reflect.ValueOf(e))
+				}
+			}
+			actual = arr.Interface()
+		case 2:
+			m := map[string]any{}
+			for i, e := range elems {
+				m[fmt.Sprint("k", i)] = e
+			}
+			actual = m
+		default:
+			// a typed slice when every element is an int
+			ints := []int{}
+			allInts := true
+			for _, e := range elems {
+				if i, ok := e.(int); ok {
+					ints = append(ints, i)
+				} else {
+					allInts = false
+				}
+			}
+			if allInts {
+				actual = ints
+			} else {
+				actual = elems
+			}
+		}
+		// adjacency: element i matches expectation j (an erroring matcher does not match)
+		adj := make([][]bool, n)
+		errs := make([][]bool, n)
+		for i := range elems {
+			adj[i] = make([]bool, k)
+			errs[i] = make([]bool, k)
+			for j, e := range exps {
+				ok, er := e.match(elems[i])
+				adj[i][j] = ok && !er
+				errs[i][j] = er
+			}
+		}
+		mm := maxMatching(adj, k)
+		desc := func() string { return fmt.Sprintf("actual %#v, expectations %s", actual, labels(exps)) }
+
+		// the single-slice rule: one expectation that is a slice is flattened; the generator
+		// avoids the case by wrapping
+		single := k == 1 && exps[0].arg != nil && (reflect.TypeOf(exps[0].arg).Kind() == reflect.Slice || reflect.TypeOf(exps[0].arg).Kind() == reflect.Array)
+		if !single {
+			got := run(ConsistOf(args(exps)...), actual)
+			want := mm == n && mm == k
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "ConsistOf", "ConsistOf = %s, want %v; %s", got, want, desc())
+				return
+			}
+			got = run(ContainElements(args(exps)...), actual)
+			want = mm == k
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "ContainElements", "ContainElements = %s, want %v; %s", got, want, desc())
+				return
+			}
+			if shape != 2 {
+				got = run(HaveExactElements(args(exps)...), actual)
+				want = n == k
+				for i := 0; i < n && i < k; i++ {
+					if !adj[i][i] {
+						want = false
+					}
+				}
+				if got.err != "" || got.ok != want {
+					c.failClass(ht, "HaveExactElements", "HaveExactElements = %s, want %v; %s", got, want, desc())
+					return
+				}
+			}
+		}
+		if k > 0 {
+			e := exps[0]
+			got := run(ContainElement(e.arg), actual)
+			any, anyErr := false, false
+			for i := range elems {
+				any = any || adj[i][0]
+				anyErr = anyErr || errs[i][0]
+			}
+			if e.arg == nil && Known.nilElementEqual {
+				// ContainElement and HaveEach wrap a nil argument in Equal(nil), which errors on a
+				// nil element and is false on a typed nil
+				any, anyErr = false, false
+				eq := equalModel(nil)
+				for i := range elems {
+					adj[i][0], errs[i][0] = eq(elems[i])
+					anyErr = anyErr || errs[i][0]
+				}
+			}
+			switch {
+			case any:
+				if got.err != "" || !got.ok {
+					c.failClass(ht, "ContainElement", "ContainElement(%s) = %s, want true; %s", e.label, got, desc())
+					return
+				}
+			case anyErr:
+				if got.err == "" {
+					c.failClass(ht, "ContainElement", "ContainElement(%s) = %s, want an error; %s", e.label, got, desc())
+					return
+				}
+			default:
+				if got.err != "" || got.ok {
+					c.failClass(ht, "ContainElement", "ContainElement(%s) = %s, want false; %s", e.label, got, desc())
+					return
+				}
+			}
+			if shape != 2 {
+				got = run(HaveEach(e.arg), actual)
+				// in order: an error stops with an error, a non-match with false
+				want := res{ok: true}
+				if n == 0 {
+					want = res{err: "empty"}
+				}
+				for i := range elems {
+					if errs[i][0] {
+						want = res{err: "element"}
+						break
+					}
+					if !adj[i][0] {
+						want = res{ok: false}
+						break
+					}
+				}
+				if !got.same(want) {
+					c.failClass(ht, "HaveEach", "HaveEach(%s) = %s, want %s; %s", e.label, got, want, desc())
+					return
+				}
+			}
+		}
+		// BeElementOf: the elements as variadic values (a single slice element would be flattened)
+		if n > 0 && !(n == 1 && elems[0] != nil && reflect.TypeOf(elems[0]).Kind() == reflect.Slice) {
+			v := genElem(ht)
+			if v != nil {
+				got := run(BeElementOf(elems...), v)
+				want := false
+				for _, e := range elems {
+					// BeElementOf wraps each element in Equal (a nil element in Equal(nil))
+					if ok, _ := equalModel(e)(v); ok {
+						want = true
+					}
+				}
+				if got.err != "" || got.ok != want {
+					c.failClass(ht, "BeElementOf", "BeElementOf(%#v) on %#v = %s, want %v", elems, v, got, want)
+					return
+				}
+			}
+		}
+		c.count(fmt.Sprintf("n=%d k=%d shape=%d", n, k, shape))
+	})
+}
+
+// TestHegelMaps: HaveKey, HaveKeyWithValue and BeKeyOf against the map, with outcome sets where
+// the package's answer depends on the iteration order.
+func TestHegelMaps(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m := map[any]any{}
+		keys := []any{}
+		for i := drawInt(ht, 0, 4); i > 0; i-- {
+			var k any
+			if chance(ht, 70) {
+				k = pick(ht, []string{"a", "ab", "b", "abc", "k1", "k2"})
+			} else {
+				k = drawInt(ht, 0, 3)
+			}
+			if _, dup := m[k]; dup {
+				continue
+			}
+			m[k] = genElem(ht)
+			keys = append(keys, k)
+		}
+		ke := genExpectation(ht)
+		ve := genExpectation(ht)
+		// HaveKey
+		got := run(HaveKey(ke.arg), m)
+		outcomes := map[string]bool{}
+		anyMatch, anyErr := false, false
+		for _, k := range keys {
+			ok, er := ke.match(k)
+			anyMatch = anyMatch || (ok && !er)
+			anyErr = anyErr || er
+		}
+		switch {
+		case anyErr && Known.keyMatcherErrorOrder:
+			outcomes["error"] = true
+			if anyMatch {
+				outcomes["true"] = true
+			}
+		case anyMatch:
+			outcomes["true"] = true
+		case anyErr:
+			outcomes["error"] = true
+		default:
+			outcomes["false"] = true
+		}
+		if !outcomes[got.String()] && !(got.err != "" && outcomes["error"]) {
+			c.failClass(ht, "HaveKey", "HaveKey(%s) on %#v = %s, want one of %v", ke.label, m, got, keysOf(outcomes))
+			return
+		}
+		// HaveKeyWithValue
+		got = run(HaveKeyWithValue(ke.arg, ve.arg), m)
+		outcomes = map[string]bool{}
+		var perKey []string // outcome if this key were the first accepted by the key matcher
+		exists := false
+		for _, k := range keys {
+			ok, er := ke.match(k)
+			if er {
+				perKey = append(perKey, "error")
+				continue
+			}
+			if !ok {
+				continue
+			}
+			vok, ver := ve.match(m[k])
+			if ve.arg == nil && Known.nilElementEqual {
+				vok, ver = equalModel(nil)(m[k]) // a nil value expectation is Equal(nil)
+			}
+			switch {
+			case ver:
+				perKey = append(perKey, "error")
+			case vok:
+				perKey = append(perKey, "true")
+				exists = true
+			default:
+				perKey = append(perKey, "false")
+			}
+		}
+		hasErr, hasFalse := false, false
+		for _, o := range perKey {
+			hasErr = hasErr || o == "error"
+			hasFalse = hasFalse || o == "false"
+		}
+		switch {
+		case Known.keyMatcherFirstKey:
+			// the first accepted key (in map order) decides
+			if exists {
+				outcomes["true"] = true
+			}
+			if hasFalse {
+				outcomes["false"] = true
+			}
+		case exists:
+			outcomes["true"] = true
+		case hasFalse:
+			outcomes["false"] = true
+		}
+		if hasErr && (Known.keyMatcherErrorOrder || len(outcomes) == 0) {
+			outcomes["error"] = true
+		}
+		if len(outcomes) == 0 {
+			outcomes["false"] = true
+		}
+		if _, isMatcher := ke.arg.(interface{ Match(any) (bool, error) }); !isMatcher && ke.arg != nil {
+			// a plain key: at most one key equals it, so the outcome is single
+			outcomes = map[string]bool{}
+			if len(perKey) == 0 {
+				outcomes["false"] = true
+			}
+			for _, o := range perKey {
+				outcomes[o] = true
+			}
+		}
+		if !outcomes[got.String()] && !(got.err != "" && outcomes["error"]) {
+			c.failClass(ht, "HaveKeyWithValue", "HaveKeyWithValue(%s, %s) on %#v = %s, want one of %v", ke.label, ve.label, m, got, keysOf(outcomes))
+			return
+		}
+		// BeKeyOf
+		probe := genElem(ht)
+		if probe != nil {
+			got = run(BeKeyOf(m), probe)
+			want := false
+			for _, k := range keys {
+				if reflect.DeepEqual(k, probe) {
+					want = true
+				}
+			}
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "BeKeyOf", "BeKeyOf(%#v) on %#v = %s, want %v", m, probe, got, want)
+				return
+			}
+		}
+		switch {
+		case len(outcomes) > 1:
+			c.count("order dependent")
+		default:
+			c.count("keys " + got.String())
+		}
+	})
+}
+
+func keysOf(m map[string]bool) []string {
+	var ks []string
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// TestHegelValues: Equal, BeEquivalentTo, BeIdenticalTo, BeZero, BeNil, HaveLen, HaveCap,
+// BeEmpty and the string matchers against their documented definitions.
+func TestHegelValues(t *testing.T) {
+	c := newCollector(t)
+	type strg string
+	property(t, func(ht *hegel.T) {
+		a := genElem(ht)
+		b := genElem(ht)
+		if chance(ht, 40) {
+			b = a
+		}
+		// Equal: reflect.DeepEqual, nil vs nil an error
+		got := run(Equal(b), a)
+		switch {
+		case a == nil && b == nil:
+			if got.err == "" {
+				c.failClass(ht, "Equal", "Equal(nil) on nil = %s, want an error", got)
+				return
+			}
+		default:
+			want, _ := equalModel(b)(a)
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "Equal", "Equal(%#v) on %#v = %s, want %v", b, a, got, want)
+				return
+			}
+		}
+		// BeIdenticalTo: == when comparable
+		if a != nil || b != nil {
+			got = run(BeIdenticalTo(b), a)
+			want := false
+			if a != nil && b != nil && reflect.TypeOf(a) == reflect.TypeOf(b) && reflect.TypeOf(a).Comparable() {
+				want = a == b
+			}
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "BeIdenticalTo", "BeIdenticalTo(%#v) on %#v = %s, want %v", b, a, got, want)
+				return
+			}
+		}
+		// BeZero / BeNil
+		got = run(BeZero(), a)
+		want := a == nil || reflect.DeepEqual(reflect.Zero(reflect.TypeOf(a)).Interface(), a)
+		if got.err != "" || got.ok != want {
+			c.failClass(ht, "BeZero", "BeZero on %#v = %s, want %v", a, got, want)
+			return
+		}
+		got = run(BeNil(), a)
+		if got.err != "" || got.ok != isNilValue(a) {
+			c.failClass(ht, "BeNil", "BeNil on %#v = %s, want %v", a, got, isNilValue(a))
+			return
+		}
+		// HaveLen / BeEmpty on the lengthy kinds
+		if a != nil {
+			switch reflect.TypeOf(a).Kind() {
+			case reflect.String, reflect.Slice, reflect.Array, reflect.Map:
+				l := reflect.ValueOf(a).Len()
+				n := drawInt(ht, 0, 3)
+				got = run(HaveLen(n), a)
+				if got.err != "" || got.ok != (l == n) {
+					c.failClass(ht, "HaveLen", "HaveLen(%d) on %#v = %s", n, a, got)
+					return
+				}
+				got = run(BeEmpty(), a)
+				if got.err != "" || got.ok != (l == 0) {
+					c.failClass(ht, "BeEmpty", "BeEmpty on %#v = %s", a, got)
+					return
+				}
+			}
+		}
+		// string matchers, with the actual as string, []byte or Stringer
+		s := pick(ht, []string{"", "a", "ab", "abc", "ba", "aXb", "%d", "a\nb", "é"})
+		sub := pick(ht, []string{"", "a", "b", "ab", "c", "%", "\n", "é"})
+		var actual any = s
+		switch drawInt(ht, 0, 2) {
+		case 1:
+			actual = []byte(s)
+		case 2:
+			actual = stringer(s)
+		}
+		checks := []struct {
+			m    types.GomegaMatcher
+			want bool
+			name string
+		}{
+			{HavePrefix(sub), strings.HasPrefix(s, sub), "HavePrefix"},
+			{HaveSuffix(sub), strings.HasSuffix(s, sub), "HaveSuffix"},
+			{ContainSubstring(sub), strings.Contains(s, sub), "ContainSubstring"},
+			{MatchRegexp("^" + regexpQuote(sub)), strings.HasPrefix(s, sub), "MatchRegexp"},
+		}
+		for _, ck := range checks {
+			got = run(ck.m, actual)
+			if got.err != "" || got.ok != ck.want {
+				c.failClass(ht, ck.name, "%s(%q) on %T %q = %s, want %v", ck.name, sub, actual, s, got, ck.want)
+				return
+			}
+		}
+		// the format-string form
+		got = run(HavePrefix("%s", sub), actual)
+		if got.err != "" || got.ok != strings.HasPrefix(s, sub) {
+			c.failClass(ht, "HavePrefixf", "HavePrefix(%%s, %q) on %q = %s", sub, s, got)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+type stringer string
+
+func (s stringer) String() string { return string(s) }
+
+func regexpQuote(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if strings.ContainsRune(`\.+*?()|[]{}^$`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..35b6496
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,160 @@
+package hegel
+
+// Hegel property tests for onsi/gomega, written for the Hegel zoo. See targets/go/gomega/README.md.
+//
+// Oracle: models of the documented matcher semantics (matchers.go doc comments and the Gomega
+// reference): multiset matching by brute force for ConsistOf/ContainElements, exact rational
+// comparison for BeNumerically, semantic equality of decoded JSON/YAML/XML documents, and the
+// map and struct rules for the key, field and element matchers.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	mixedSignConversion    bool // 1: a signed and an unsigned integer are compared after converting to the actual's kind
+	intDiffOverflow        bool // 2: ~ and == on integers subtract in int64 and wrap
+	intFloatRounding       bool // 3: an integer and a float are compared as float64
+	keyMatcherFirstKey     bool // 4: HaveKeyWithValue judges the first key (in map order) the key matcher accepts
+	jsonDecodeErrorIgnored bool // 5: MatchJSON ignores json.Unmarshal errors (out-of-range numbers)
+	jsonNumbersFloat64     bool // 6: MatchJSON compares numbers as float64
+	xmlPrefixLiteral       bool // 7: MatchXML compares namespace declarations and prefixes literally
+	yamlFirstDocument      bool // 8: MatchYAML reads only the first document of a stream
+	equalBytesSpecial      bool // 11: Equal([]byte) uses bytes.Equal (nil equals empty)
+	keyMatcherErrorOrder   bool // 12: HaveKey/HaveKeyWithValue error or match depending on map order when the key matcher errors on a key
+	nilElementEqual        bool // 13: ContainElement(nil), HaveEach(nil) and HaveKeyWithValue(k, nil) error on a nil element instead of matching it
+	equalsThresholdInts    bool // 14: == with a threshold is ~ for integers and exact for floats
+}{true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
