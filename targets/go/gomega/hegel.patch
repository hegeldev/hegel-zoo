+package hegel
+
+// MatchJSON, MatchYAML and MatchXML against structural equality of generated documents rendered
+// in different spellings.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- JSON / YAML values
+
+// jv is a JSON (or YAML) value: nil, bool, *big.Rat (number), string, []jv or map (sorted keys).
+type jv struct {
+	kind string // "null", "bool", "num", "str", "arr", "obj"
+	b    bool
+	n    *big.Rat
+	nsrc string // the number as written
+	s    string
+	arr  []jv
+	keys []string
+	obj  map[string]jv
+}
+
+// genJV is a JSON value; wide adds numbers beyond float64 or int64 precision (the JSON matcher only).
+func genJV(tc hegel.TestCase, depth int, wide bool) jv {
+	k := drawInt(tc, 0, 7)
+	if depth > 2 && k > 4 {
+		k = drawInt(tc, 0, 4)
+	}
+	switch k {
+	case 0:
+		return jv{kind: "null"}
+	case 1:
+		return jv{kind: "bool", b: chance(tc, 50)}
+	case 2, 3:
+		return genNumber(tc, wide)
+	case 4:
+		return jv{kind: "str", s: pick(tc, []string{"", "a", "ab", "A", "é", "a b", "\n", "\"q\"", "\\", "/", "", "x\ty"})}
+	case 5, 6:
+		n := drawInt(tc, 0, 3)
+		var arr []jv
+		for i := 0; i < n; i++ {
+			arr = append(arr, genJV(tc, depth+1, wide))
+		}
+		return jv{kind: "arr", arr: arr}
+	default:
+		obj := map[string]jv{}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			key := pick(tc, []string{"a", "b", "c", "k", "A", "a b", ""})
+			if _, dup := obj[key]; dup {
+				continue
+			}
+			obj[key] = genJV(tc, depth+1, wide)
+		}
+		var keys []string
+		for key := range obj {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		return jv{kind: "obj", obj: obj, keys: keys}
+	}
+}
+
+func genNumber(tc hegel.TestCase, wide bool) jv {
+	var src string
+	switch drawInt(tc, 0, 6) {
+	case 0:
+		src = strconv.Itoa(drawInt(tc, -5, 5))
+	case 1:
+		src = pick(tc, []string{"1.5", "-0.25", "0.1", "1e2", "1E-2", "2.5e0", "10", "1.0", "0.0", "-0"})
+	case 2:
+		if !wide || (Known.jsonNumbersFloat64 && Known.jsonDecodeErrorIgnored) {
+			src = strconv.Itoa(drawInt(tc, 100, 200))
+		} else {
+			src = pick(tc, []string{"12345678901234567890", "12345678901234567891", "9007199254740993", "9007199254740992", "1e400", "1e401", "123456789012345678901234567890"})
+		}
+	default:
+		src = strconv.Itoa(drawInt(tc, -1000, 1000))
+	}
+	r, ok := new(big.Rat).SetString(src)
+	if !ok {
+		panic("bad number " + src)
+	}
+	return jv{kind: "num", n: r, nsrc: src}
+}
+
+func (v jv) equal(o jv) bool {
+	if v.kind != o.kind {
+		return false
+	}
+	switch v.kind {
+	case "bool":
+		return v.b == o.b
+	case "num":
+		return v.n.Cmp(o.n) == 0
+	case "str":
+		return v.s == o.s
+	case "arr":
+		if len(v.arr) != len(o.arr) {
+			return false
+		}
+		for i := range v.arr {
+			if !v.arr[i].equal(o.arr[i]) {
+				return false
+			}
+		}
+		return true
+	case "obj":
+		if len(v.obj) != len(o.obj) {
+			return false
+		}
+		for k, x := range v.obj {
+			y, ok := o.obj[k]
+			if !ok || !x.equal(y) {
+				return false
+			}
+		}
+		return true
+	}
+	return true
+}
+
+// mutate changes one leaf of the value so that it differs.
+func mutate(tc hegel.TestCase, v jv) jv {
+	switch v.kind {
+	case "arr":
+		if len(v.arr) > 0 && chance(tc, 70) {
+			i := drawInt(tc, 0, len(v.arr)-1)
+			arr := append([]jv(nil), v.arr...)
+			arr[i] = mutate(tc, arr[i])
+			return jv{kind: "arr", arr: arr}
+		}
+		return jv{kind: "arr", arr: append(append([]jv(nil), v.arr...), jv{kind: "null"})}
+	case "obj":
+		if len(v.keys) > 0 && chance(tc, 70) {
+			k := pick(tc, v.keys)
+			obj := map[string]jv{}
+			for kk, vv := range v.obj {
+				obj[kk] = vv
+			}
+			obj[k] = mutate(tc, obj[k])
+			return jv{kind: "obj", obj: obj, keys: v.keys}
+		}
+		obj := map[string]jv{}
+		for kk, vv := range v.obj {
+			obj[kk] = vv
+		}
+		nk := "zz"
+		obj[nk] = jv{kind: "bool", b: true}
+		return jv{kind: "obj", obj: obj, keys: append(append([]string(nil), v.keys...), nk)}
+	case "num":
+		r := new(big.Rat).Add(v.n, big.NewRat(1, 1))
+		return jv{kind: "num", n: r, nsrc: r.FloatString(0)}
+	case "str":
+		return jv{kind: "str", s: v.s + "x"}
+	case "bool":
+		return jv{kind: "bool", b: !v.b}
+	default:
+		return jv{kind: "bool", b: false}
+	}
+}
+
+func jsonString(tc hegel.TestCase, s string) string {
+	b, _ := json.Marshal(s)
+	if tc == nil || !chance(tc, 30) {
+		return string(b)
+	}
+	// the same string with some characters as \uXXXX escapes
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r < 0x20 || r == '"' || r == '\\' || (r < 0x80 && chance(tc, 40)):
+			fmt.Fprintf(&sb, "\\u%04x", r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+func ws(tc hegel.TestCase) string {
+	if tc == nil {
+		return ""
+	}
+	return pick(tc, []string{"", "", " ", "\n", "\t", "  \n "})
+}
+
+// renderJSON spells the value with random whitespace, key order and escapes.
+func renderJSON(tc hegel.TestCase, v jv) string {
+	switch v.kind {
+	case "null":
+		return "null"
+	case "bool":
+		return strconv.FormatBool(v.b)
+	case "num":
+		if tc != nil && chance(tc, 30) && v.n.IsInt() && v.n.Num().IsInt64() && !strings.ContainsAny(v.nsrc, ".eE") && len(v.nsrc) < 15 {
+			// an equal spelling: 5 as 5.0 or 5e0 or 50e-1
+			if v.nsrc == "0" || v.nsrc == "-0" {
+				return pick(tc, []string{v.nsrc + ".0", v.nsrc + "e0"})
+			}
+			return pick(tc, []string{v.nsrc + ".0", v.nsrc + "e0", v.nsrc + "E0", v.nsrc + "0e-1"})
+		}
+		return v.nsrc
+	case "str":
+		return jsonString(tc, v.s)
+	case "arr":
+		var parts []string
+		for _, e := range v.arr {
+			parts = append(parts, ws(tc)+renderJSON(tc, e)+ws(tc))
+		}
+		return "[" + ws(tc) + strings.Join(parts, ",") + "]"
+	default:
+		keys := append([]string(nil), v.keys...)
+		if tc != nil && chance(tc, 50) {
+			for i := range keys {
+				j := drawInt(tc, 0, i)
+				keys[i], keys[j] = keys[j], keys[i]
+			}
+		}
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, ws(tc)+jsonString(tc, k)+ws(tc)+":"+ws(tc)+renderJSON(tc, v.obj[k])+ws(tc))
+		}
+		return "{" + ws(tc) + strings.Join(parts, ",") + "}"
+	}
+}
+
+// renderYAML spells the value in flow style (JSON-like) or block style.
+func renderYAML(tc hegel.TestCase, v jv, indent int) string {
+	pad := strings.Repeat("  ", indent)
+	switch v.kind {
+	case "null":
+		return pick(tc, []string{"null", "~", "Null"})
+	case "bool":
+		if v.b {
+			return pick(tc, []string{"true", "True"})
+		}
+		return pick(tc, []string{"false", "False"})
+	case "num":
+		return v.nsrc
+	case "str":
+		if chance(tc, 50) {
+			return jsonString(nil, v.s)
+		}
+		b, _ := json.Marshal(v.s)
+		return string(b)
+	case "arr":
+		if len(v.arr) == 0 || chance(tc, 40) {
+			var parts []string
+			for _, e := range v.arr {
+				parts = append(parts, renderYAMLFlow(tc, e))
+			}
+			return "[" + strings.Join(parts, ", ") + "]"
+		}
+		var sb strings.Builder
+		for _, e := range v.arr {
+			r := renderYAML(tc, e, indent+1)
+			if strings.HasPrefix(r, "\n") {
+				sb.WriteString("\n" + pad + "-" + r)
+			} else {
+				sb.WriteString("\n" + pad + "- " + r)
+			}
+		}
+		return sb.String()
+	default:
+		if len(v.keys) == 0 || chance(tc, 40) {
+			return renderYAMLFlow(tc, v)
+		}
+		var sb strings.Builder
+		for _, k := range v.keys {
+			sb.WriteString("\n" + pad + jsonString(nil, k) + ":")
+			r := renderYAML(tc, v.obj[k], indent+1)
+			if strings.HasPrefix(r, "\n") {
+				sb.WriteString(r)
+			} else {
+				sb.WriteString(" " + r)
+			}
+		}
+		return sb.String()
+	}
+}
+
+func renderYAMLFlow(tc hegel.TestCase, v jv) string {
+	switch v.kind {
+	case "arr":
+		var parts []string
+		for _, e := range v.arr {
+			parts = append(parts, renderYAMLFlow(tc, e))
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case "obj":
+		var parts []string
+		for _, k := range v.keys {
+			parts = append(parts, jsonString(nil, k)+": "+renderYAMLFlow(tc, v.obj[k]))
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	default:
+		return renderYAML(tc, v, 0)
+	}
+}
+
+// jsonModel: the documented equality (decoded documents compared), with the package's float64
+// decoding and ignored decode errors behind the switches.
+func jsonModel(a, b jv) (bool, bool) {
+	if Known.jsonDecodeErrorIgnored || Known.jsonNumbersFloat64 {
+		fa, okA := viaFloat64(a)
+		fb, okB := viaFloat64(b)
+		if Known.jsonDecodeErrorIgnored && (!okA || !okB) {
+			// json.Unmarshal fails on an out-of-range number and the value stays nil
+			return okA == okB, true
+		}
+		return fa.equal(fb), false
+	}
+	return a.equal(b), false
+}
+
+// viaFloat64 rounds every number to float64; false when one is out of range.
+func viaFloat64(v jv) (jv, bool) {
+	switch v.kind {
+	case "num":
+		f, _ := v.n.Float64()
+		if f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
+			return v, false
+		}
+		return jv{kind: "num", n: new(big.Rat).SetFloat64(f)}, true
+	case "arr":
+		var arr []jv
+		for _, e := range v.arr {
+			x, ok := viaFloat64(e)
+			if !ok {
+				return v, false
+			}
+			arr = append(arr, x)
+		}
+		return jv{kind: "arr", arr: arr}, true
+	case "obj":
+		obj := map[string]jv{}
+		for k, e := range v.obj {
+			x, ok := viaFloat64(e)
+			if !ok {
+				return v, false
+			}
+			obj[k] = x
+		}
+		return jv{kind: "obj", obj: obj, keys: v.keys}, true
+	}
+	return v, true
+}
+
+func TestHegelJSON(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genJV(ht, 0, true)
+		b := a
+		if chance(ht, 50) {
+			b = mutate(ht, a)
+		}
+		sa, sb := renderJSON(ht, a), renderJSON(ht, b)
+		var actual any = sa
+		if chance(ht, 20) {
+			actual = []byte(sa)
+		} else if chance(ht, 10) {
+			actual = json.RawMessage(sa)
+		}
+		got := run(MatchJSON(sb), actual)
+		want, viaNil := jsonModel(a, b)
+		if got.err != "" || got.ok != want {
+			c.failClass(ht, "MatchJSON", "MatchJSON(%s) on %s = %s, want %v", sb, sa, got, want)
+			return
+		}
+		switch {
+		case viaNil:
+			c.count("out of range")
+		case want:
+			c.count("match")
+		default:
+			c.count("mismatch")
+		}
+	})
+}
+
+func TestHegelYAML(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genJV(ht, 0, false)
+		b := a
+		if chance(ht, 50) {
+			b = mutate(ht, a)
+		}
+		sa, sb := renderYAML(ht, a, 0), renderYAML(ht, b, 0)
+		if chance(ht, 20) {
+			sa = "---\n" + sa
+		}
+		if !Known.yamlFirstDocument && chance(ht, 20) {
+			// a second document changes the stream
+			sb += "\n---\nextra: 1"
+			b = jv{kind: "str", s: "a stream of two documents"}
+		}
+		got := run(MatchYAML(sb), sa)
+		want := a.equal(b)
+		if a.kind == "num" && b.kind == "num" && Known.jsonNumbersFloat64 {
+			// yaml decodes an integer beyond uint64 as float64
+			fa, _ := viaFloat64(a)
+			fb, _ := viaFloat64(b)
+			if !a.n.IsInt() || !a.n.Num().IsUint64() && !a.n.Num().IsInt64() {
+				want = fa.equal(fb)
+			}
+		}
+		if got.err != "" || got.ok != want {
+			c.failClass(ht, "MatchYAML", "MatchYAML(%q) on %q = %s, want %v", sb, sa, got, want)
+			return
+		}
+		c.count(fmt.Sprint("match ", want))
+	})
+}
+
+// --------------------------------------------------------------------------- XML
+
+type xel struct {
+	name     string
+	prefixed bool // in the namespace u (declared on the root)
+	attrs    map[string]string
+	text     string // leaf text (no children)
+	children []xel
+}
+
+func genXel(tc hegel.TestCase, depth int) xel {
+	e := xel{name: pick(tc, []string{"a", "b", "item", "x"}), attrs: map[string]string{}}
+	e.prefixed = chance(tc, 30)
+	for i := drawInt(tc, 0, 2); i > 0; i-- {
+		e.attrs[pick(tc, []string{"id", "n", "k", "v"})] = pick(tc, []string{"1", "2", "a b", "<", "&", "'", "\""})
+	}
+	if depth < 2 && chance(tc, 50) {
+		for i := drawInt(tc, 1, 3); i > 0; i-- {
+			e.children = append(e.children, genXel(tc, depth+1))
+		}
+	} else if chance(tc, 60) {
+		e.text = pick(tc, []string{"x", "hello", "a<b", "1 & 2", "é", "]]>", "x y"})
+	}
+	return e
+}
+
+func (e xel) equal(o xel) bool {
+	if e.name != o.name || e.prefixed != o.prefixed || e.text != o.text || len(e.attrs) != len(o.attrs) || len(e.children) != len(o.children) {
+		return false
+	}
+	for k, v := range e.attrs {
+		if o.attrs[k] != v {
+			return false
+		}
+	}
+	for i := range e.children {
+		if !e.children[i].equal(o.children[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func mutateXel(tc hegel.TestCase, e xel) xel {
+	switch {
+	case len(e.children) > 0 && chance(tc, 60):
+		ch := append([]xel(nil), e.children...)
+		i := drawInt(tc, 0, len(ch)-1)
+		ch[i] = mutateXel(tc, ch[i])
+		e.children = ch
+	case len(e.attrs) > 0 && chance(tc, 50):
+		attrs := map[string]string{}
+		for k, v := range e.attrs {
+			attrs[k] = v
+		}
+		for k := range attrs {
+			attrs[k] += "z"
+			break
+		}
+		e.attrs = attrs
+	case len(e.children) == 0 && chance(tc, 50):
+		e.text += "z"
+	default:
+		e.name += "z"
+	}
+	return e
+}
+
+func escText(tc hegel.TestCase, s string) string {
+	if tc != nil && chance(tc, 25) && !strings.Contains(s, "]]>") {
+		return "<![CDATA[" + s + "]]>"
+	}
+	var sb strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '<':
+			sb.WriteString("&lt;")
+		case r == '&':
+			sb.WriteString("&amp;")
+		case r == '>':
+			sb.WriteString("&gt;")
+		case tc != nil && chance(tc, 20):
+			fmt.Fprintf(&sb, "&#%d;", r)
+		case tc != nil && chance(tc, 10):
+			fmt.Fprintf(&sb, "&#x%X;", r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+func escAttr(s string, q byte) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	if q == '"' {
+		return strings.ReplaceAll(s, "\"", "&quot;")
+	}
+	return strings.ReplaceAll(s, "'", "&apos;")
+}
+
+// renderXML spells the tree: attribute order and quotes, whitespace between children,
+// self-closing tags, escapes, the namespace prefix (px) for the prefixed elements.
+func renderXML(tc hegel.TestCase, e xel, px string, indent int, root bool) string {
+	var sb strings.Builder
+	pad := strings.Repeat("  ", indent)
+	name := e.name
+	if e.prefixed {
+		name = px + ":" + name
+	}
+	sb.WriteString("<" + name)
+	if root {
+		sb.WriteString(" xmlns:" + px + "=\"urn:u\"")
+	}
+	keys := make([]string, 0, len(e.attrs))
+	for k := range e.attrs {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for i := range keys {
+		j := drawInt(tc, 0, i)
+		keys[i], keys[j] = keys[j], keys[i]
+	}
+	for _, k := range keys {
+		q := byte('"')
+		if chance(tc, 30) {
+			q = '\''
+		}
+		sb.WriteString(pick(tc, []string{" ", "  ", "\n" + pad}) + k + pick(tc, []string{"=", " = "}) + string(q) + escAttr(e.attrs[k], q) + string(q))
+	}
+	if len(e.children) == 0 && e.text == "" && chance(tc, 50) {
+		sb.WriteString(pick(tc, []string{"/>", " />"}))
+		return sb.String()
+	}
+	sb.WriteString(">")
+	if len(e.children) > 0 {
+		pretty := chance(tc, 50)
+		for _, ch := range e.children {
+			if pretty {
+				sb.WriteString("\n" + pad + "  ")
+			}
+			sb.WriteString(renderXML(tc, ch, px, indent+1, false))
+		}
+		if pretty {
+			sb.WriteString("\n" + pad)
+		}
+	} else {
+		sb.WriteString(escText(tc, e.text))
+	}
+	sb.WriteString("</" + name + ">")
+	return sb.String()
+}
+
+func TestHegelXML(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genXel(ht, 0)
+		b := a
+		if chance(ht, 50) {
+			b = mutateXel(ht, a)
+		}
+		pa, pb := "p", "p"
+		if !Known.xmlPrefixLiteral && chance(ht, 50) {
+			pb = "q"
+		}
+		sa := renderXML(ht, a, pa, 0, true)
+		sb := renderXML(ht, b, pb, 0, true)
+		if chance(ht, 20) {
+			sa = `<?xml version="1.0" encoding="UTF-8"?>` + "\n" + sa
+		}
+		got := run(MatchXML(sb), sa)
+		want := a.equal(b)
+		if got.err != "" || got.ok != want {
+			c.failClass(ht, "MatchXML", "MatchXML(%s) on %s = %s, want %v", sb, sa, got, want)
+			return
+		}
+		c.count(fmt.Sprint("match ", want))
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..5accd99
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,558 @@
+package hegel
+
+// Generators and models: values and their documented matcher semantics.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+
+	. "github.com/onsi/gomega"
+	"github.com/onsi/gomega/types"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- numbers
+
+// num is a Go number with its exact value.
+type num struct {
+	v    any
+	x    *big.Rat // nil for NaN / Inf
+	kind string   // "int", "uint", "float"
+}
+
+var intKinds = []reflect.Kind{reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64}
+var uintKinds = []reflect.Kind{reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64}
+
+// nearNum is a number of a's kind a small distance from a (when that fits the type).
+func nearNum(tc hegel.TestCase, a num) num {
+	d := int64(drawInt(tc, -10, 10))
+	rv := reflect.ValueOf(a.v)
+	switch a.kind {
+	case "int":
+		v := rv.Int() + d
+		nv := reflect.New(rv.Type()).Elem()
+		if nv.OverflowInt(v) {
+			return a
+		}
+		nv.SetInt(v)
+		return num{v: nv.Interface(), x: new(big.Rat).SetInt64(v), kind: "int"}
+	case "uint":
+		u := rv.Uint()
+		if d < 0 && u < uint64(-d) {
+			return a
+		}
+		v := u + uint64(d)
+		if d < 0 {
+			v = u - uint64(-d)
+		}
+		nv := reflect.New(rv.Type()).Elem()
+		if nv.OverflowUint(v) {
+			return a
+		}
+		nv.SetUint(v)
+		return num{v: nv.Interface(), x: new(big.Rat).SetUint64(v), kind: "uint"}
+	default:
+		f := rv.Float() + float64(d)/4
+		if rv.Kind() == reflect.Float32 {
+			return num{v: float32(f), x: new(big.Rat).SetFloat64(float64(float32(f))), kind: "float"}
+		}
+		return num{v: f, x: new(big.Rat).SetFloat64(f), kind: "float"}
+	}
+}
+
+func genNum(tc hegel.TestCase) num {
+	switch drawInt(tc, 0, 2) {
+	case 0:
+		k := pick(tc, intKinds)
+		bits := 64
+		switch k {
+		case reflect.Int8:
+			bits = 8
+		case reflect.Int16:
+			bits = 16
+		case reflect.Int32:
+			bits = 32
+		}
+		min, max := -(int64(1) << (bits - 1)), int64(1)<<(bits-1)-1
+		var v int64
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			v = min
+		case 1:
+			v = max
+		case 2:
+			v = int64(drawInt(tc, -5, 5))
+		case 3:
+			v = pick(tc, []int64{1 << 53, 1<<53 + 1, -(1 << 53) - 1, 1<<62 + 3, math.MaxInt32, math.MinInt32, 1e15 + 1})
+			if v < min || v > max {
+				v = int64(drawInt(tc, -100, 100))
+			}
+		default:
+			v = int64(drawInt(tc, -1000, 1000))
+		}
+		rv := reflect.New(reflect.TypeOf(int(0))).Elem()
+		switch k {
+		case reflect.Int8:
+			rv = reflect.ValueOf(int8(v))
+		case reflect.Int16:
+			rv = reflect.ValueOf(int16(v))
+		case reflect.Int32:
+			rv = reflect.ValueOf(int32(v))
+		case reflect.Int64:
+			rv = reflect.ValueOf(v)
+		default:
+			rv = reflect.ValueOf(int(v))
+		}
+		return num{v: rv.Interface(), x: new(big.Rat).SetInt64(v), kind: "int"}
+	case 1:
+		k := pick(tc, uintKinds)
+		bits := 64
+		switch k {
+		case reflect.Uint8:
+			bits = 8
+		case reflect.Uint16:
+			bits = 16
+		case reflect.Uint32:
+			bits = 32
+		}
+		var max uint64 = math.MaxUint64
+		if bits < 64 {
+			max = uint64(1)<<bits - 1
+		}
+		var v uint64
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			v = max
+		case 1:
+			v = 0
+		case 2:
+			v = uint64(drawInt(tc, 0, 5))
+		case 3:
+			v = pick(tc, []uint64{1 << 63, 1<<63 + 1, 1 << 53, 1<<53 + 1, math.MaxInt64, math.MaxInt64 + 1})
+			if v > max {
+				v = uint64(drawInt(tc, 0, 200))
+			}
+		default:
+			v = uint64(drawInt(tc, 0, 1000))
+		}
+		var rv reflect.Value
+		switch k {
+		case reflect.Uint8:
+			rv = reflect.ValueOf(uint8(v))
+		case reflect.Uint16:
+			rv = reflect.ValueOf(uint16(v))
+		case reflect.Uint32:
+			rv = reflect.ValueOf(uint32(v))
+		case reflect.Uint64:
+			rv = reflect.ValueOf(v)
+		default:
+			rv = reflect.ValueOf(uint(v))
+		}
+		return num{v: rv.Interface(), x: new(big.Rat).SetUint64(v), kind: "uint"}
+	default:
+		var f float64
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			f = pick(tc, []float64{0, -0.0, 0.5, -0.5, 1.5, 1e-9, 1e-8, 2e-8, 0.1, 0.3})
+		case 1:
+			f = pick(tc, []float64{1 << 53, 1<<53 + 2, 1e18, 9.3e18, 1.9e19, -9.3e18, 1e300, -1e300, math.MaxFloat64})
+		case 2:
+			f = float64(drawInt(tc, -1000, 1000)) / 8
+		case 3:
+			f = float64(drawInt(tc, -5, 5))
+		default:
+			f = float64(drawInt(tc, -1000, 1000))
+		}
+		if chance(tc, 30) {
+			f32 := float32(f)
+			x, _ := new(big.Rat).SetString(strconv.FormatFloat(float64(f32), 'g', -1, 64))
+			return num{v: f32, x: x, kind: "float"}
+		}
+		return num{v: f, x: new(big.Rat).SetFloat64(f), kind: "float"}
+	}
+}
+
+func isFloatKind(v any) bool {
+	k := reflect.TypeOf(v).Kind()
+	return k == reflect.Float32 || k == reflect.Float64
+}
+
+func toF(v any) float64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Float32, reflect.Float64:
+		return rv.Float()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return float64(rv.Uint())
+	}
+	return float64(rv.Int())
+}
+
+// toI and toU convert as the package does (a float is truncated)
+func toI(v any) int64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return int64(rv.Uint())
+	case reflect.Float32, reflect.Float64:
+		return int64(rv.Float())
+	}
+	return rv.Int()
+}
+
+func toU(v any) uint64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return rv.Uint()
+	case reflect.Float32, reflect.Float64:
+		return uint64(rv.Float())
+	}
+	return uint64(rv.Int())
+}
+
+// modelNumerically is BeNumerically as documented: the numbers compared by value, whatever
+// their types; the recorded deviations behind the switches.
+func modelNumerically(cmp string, a, c num, t *num) bool {
+	if Known.intFloatRounding && (a.kind == "float" || c.kind == "float") {
+		af, cf := toF(a.v), toF(c.v)
+		th := 1e-8
+		if t != nil {
+			th = toF(t.v)
+		}
+		switch cmp {
+		case "~":
+			return math.Abs(af-cf) <= th
+		case "==":
+			return af == cf
+		case ">":
+			return af > cf
+		case ">=":
+			return af >= cf
+		case "<":
+			return af < cf
+		}
+		return af <= cf
+	}
+	if a.kind != "float" && c.kind != "float" && (Known.mixedSignConversion || Known.intDiffOverflow) {
+		// the package converts everything to the kind of actual
+		if a.kind == "int" {
+			ai, ci := toI(a.v), toI(c.v)
+			var ti int64
+			if t != nil {
+				ti = toI(t.v)
+			}
+			if !Known.mixedSignConversion {
+				return modelExact(cmp, a, c, t)
+			}
+			if cmp == "==" && !Known.equalsThresholdInts {
+				ti = 0 // == is exact; the threshold belongs to ~
+			}
+			switch cmp {
+			case "==", "~":
+				if Known.intDiffOverflow {
+					d := ai - ci
+					return -ti <= d && d <= ti
+				}
+				return modelExact(cmp, a, num{x: new(big.Rat).SetInt64(ci)}, &num{x: new(big.Rat).SetInt64(ti)})
+			case ">":
+				return ai > ci
+			case ">=":
+				return ai >= ci
+			case "<":
+				return ai < ci
+			}
+			return ai <= ci
+		}
+		au, cu := toU(a.v), toU(c.v)
+		var tu uint64
+		if t != nil {
+			tu = toU(t.v)
+		}
+		if !Known.mixedSignConversion {
+			return modelExact(cmp, a, c, t)
+		}
+		if cmp == "==" && !Known.equalsThresholdInts {
+			tu = 0
+		}
+		switch cmp {
+		case "==", "~":
+			if au < cu {
+				au, cu = cu, au
+			}
+			return au-cu <= tu
+		case ">":
+			return au > cu
+		case ">=":
+			return au >= cu
+		case "<":
+			return au < cu
+		}
+		return au <= cu
+	}
+	return modelExact(cmp, a, c, t)
+}
+
+func modelExact(cmp string, a, c num, t *num) bool {
+	if a.x == nil || c.x == nil {
+		return false
+	}
+	r := a.x.Cmp(c.x)
+	if cmp == "==" && t != nil && Known.equalsThresholdInts && a.kind != "float" && c.kind != "float" {
+		cmp = "~" // the package applies the threshold to == on integers
+	}
+	switch cmp {
+	case "==":
+		return r == 0
+	case "~":
+		th := new(big.Rat)
+		if t != nil {
+			if t.x == nil {
+				return false
+			}
+			th = t.x
+		} else if a.kind == "float" || c.kind == "float" {
+			th.SetFloat64(1e-8)
+		}
+		d := new(big.Rat).Sub(a.x, c.x)
+		d.Abs(d)
+		return d.Cmp(th) <= 0
+	case ">":
+		return r > 0
+	case ">=":
+		return r >= 0
+	case "<":
+		return r < 0
+	}
+	return r <= 0
+}
+
+// --------------------------------------------------------------------------- values and matchers
+
+type pt struct{ X int }
+
+// genElem draws a small value of a mixed pool.
+func genElem(tc hegel.TestCase) any {
+	switch drawInt(tc, 0, 9) {
+	case 0, 1, 2:
+		return drawInt(tc, 0, 4)
+	case 3, 4:
+		return pick(tc, []string{"a", "ab", "b", "", "abc"})
+	case 5:
+		return nil
+	case 6:
+		return []int{drawInt(tc, 0, 2)}
+	case 7:
+		return pt{drawInt(tc, 0, 2)}
+	case 8:
+		if chance(tc, 20) {
+			return []byte(nil)
+		}
+		return []byte(pick(tc, []string{"a", "ab", ""}))
+	default:
+		return float64(drawInt(tc, 0, 4))
+	}
+}
+
+// expectation: an element of a collection matcher's argument list with its model.
+type expectation struct {
+	arg   any
+	label string
+	// match reports whether the element matches and whether the matcher would error on it
+	match func(e any) (ok bool, errs bool)
+}
+
+// equalModel is Equal(v): reflect.DeepEqual, an error when both sides are nil.
+func equalModel(v any) func(any) (bool, bool) {
+	return func(e any) (bool, bool) {
+		if v == nil {
+			return false, e == nil
+		}
+		if e == nil {
+			return false, false
+		}
+		if Known.equalBytesSpecial {
+			if eb, ok := e.([]byte); ok {
+				if vb, ok := v.([]byte); ok {
+					return bytes.Equal(eb, vb), false
+				}
+			}
+		}
+		return reflect.DeepEqual(e, v), false
+	}
+}
+
+// elemExpectation is a plain value among a collection matcher's arguments: Equal(v), or BeNil
+// for a nil (the documented reading of a nil element).
+func elemExpectation(v any) expectation {
+	if v == nil {
+		return expectation{arg: nil, label: "nil", match: func(e any) (bool, bool) { return isNilValue(e), false }}
+	}
+	return expectation{arg: v, label: fmt.Sprintf("%#v", v), match: equalModel(v)}
+}
+
+func isNilValue(a any) bool {
+	if a == nil {
+		return true
+	}
+	switch reflect.TypeOf(a).Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return reflect.ValueOf(a).IsNil()
+	}
+	return false
+}
+
+func isNumberValue(a any) bool {
+	if a == nil {
+		return false
+	}
+	k := reflect.TypeOf(a).Kind()
+	return reflect.Int <= k && k <= reflect.Float64 && k != reflect.Uintptr
+}
+
+func stringOf(a any) (string, bool) {
+	switch s := a.(type) {
+	case string:
+		return s, true
+	case []byte:
+		return string(s), true
+	case fmt.Stringer:
+		return s.String(), true
+	}
+	return "", false
+}
+
+func genExpectation(tc hegel.TestCase) expectation {
+	switch drawInt(tc, 0, 9) {
+	case 0, 1, 2, 3:
+		return elemExpectation(genElem(tc))
+	case 4:
+		k := drawInt(tc, 0, 3)
+		return expectation{arg: BeNumerically(">", k), label: fmt.Sprintf("BeNumerically(>, %d)", k), match: func(e any) (bool, bool) {
+			if !isNumberValue(e) {
+				return false, true
+			}
+			return toF(e) > float64(k), false
+		}}
+	case 5:
+		p := pick(tc, []string{"a", "ab", ""})
+		return expectation{arg: HavePrefix(p), label: fmt.Sprintf("HavePrefix(%q)", p), match: func(e any) (bool, bool) {
+			s, ok := stringOf(e)
+			if !ok {
+				return false, true
+			}
+			return strings.HasPrefix(s, p), false
+		}}
+	case 6:
+		return expectation{arg: BeNil(), label: "BeNil()", match: func(e any) (bool, bool) { return isNilValue(e), false }}
+	case 7:
+		v := genElem(tc)
+		eq := equalModel(v)
+		return expectation{arg: Not(Equal(v)), label: fmt.Sprintf("Not(Equal(%#v))", v), match: func(e any) (bool, bool) {
+			if e == nil && v == nil {
+				return false, true
+			}
+			ok, errs := eq(e)
+			return !ok, errs
+		}}
+	case 8:
+		n := drawInt(tc, 0, 2)
+		return expectation{arg: HaveLen(n), label: fmt.Sprintf("HaveLen(%d)", n), match: func(e any) (bool, bool) {
+			if e == nil {
+				return false, true
+			}
+			switch reflect.TypeOf(e).Kind() {
+			case reflect.String, reflect.Slice, reflect.Array, reflect.Map:
+				return reflect.ValueOf(e).Len() == n, false
+			}
+			return false, true
+		}}
+	default:
+		return expectation{arg: BeZero(), label: "BeZero()", match: func(e any) (bool, bool) {
+			if e == nil {
+				return true, false
+			}
+			return reflect.DeepEqual(reflect.Zero(reflect.TypeOf(e)).Interface(), e), false
+		}}
+	}
+}
+
+// maxMatching is the size of a maximum bipartite matching (Kuhn's algorithm).
+func maxMatching(adj [][]bool, nRight int) int {
+	matchR := make([]int, nRight)
+	for i := range matchR {
+		matchR[i] = -1
+	}
+	var try func(l int, seen []bool) bool
+	try = func(l int, seen []bool) bool {
+		for r := 0; r < nRight; r++ {
+			if !adj[l][r] || seen[r] {
+				continue
+			}
+			seen[r] = true
+			if matchR[r] < 0 || try(matchR[r], seen) {
+				matchR[r] = l
+				return true
+			}
+		}
+		return false
+	}
+	n := 0
+	for l := range adj {
+		if try(l, make([]bool, nRight)) {
+			n++
+		}
+	}
+	return n
+}
+
+func args(es []expectation) []any {
+	out := make([]any, len(es))
+	for i, e := range es {
+		out[i] = e.arg
+	}
+	return out
+}
+
+func labels(es []expectation) string {
+	var ls []string
+	for _, e := range es {
+		ls = append(ls, e.label)
+	}
+	return "[" + strings.Join(ls, ", ") + "]"
+}
+
+// result of a Match call
+type res struct {
+	ok  bool
+	err string
+}
+
+func run(m types.GomegaMatcher, actual any) (r res) {
+	defer func() {
+		if p := recover(); p != nil {
+			r = res{err: fmt.Sprint("panic: ", p)}
+		}
+	}()
+	ok, err := m.Match(actual)
+	if err != nil {
+		return res{err: err.Error()}
+	}
+	return res{ok: ok}
+}
+
+func (r res) String() string {
+	if r.err != "" {
+		return "error(" + strings.SplitN(r.err, "\n", 2)[0] + ")"
+	}
+	return strconv.FormatBool(r.ok)
+}
+
+func (r res) same(o res) bool {
+	return (r.err != "") == (o.err != "") && (r.err != "" || r.ok == o.ok)
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..9c99e68
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,176 @@
+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"github.com/onsi/gomega/types"
+)
+
+func expectMatch(t *testing.T, m types.GomegaMatcher, actual any, want bool, desc string) {
+	t.Helper()
+	got := run(m, actual)
+	if got.err != "" || got.ok != want {
+		t.Errorf("%s = %s, want %v", desc, got, want)
+	}
+}
+
+// gomega/1: BeNumerically compares numbers by value whatever their types, so a negative
+// integer is less than any unsigned one and equal to none.
+func TestHegelPinSignedUnsigned(t *testing.T) {
+	expectMatch(t, BeNumerically("==", uint64(math.MaxUint64)), -1, false, "-1 == uint64 max")
+	expectMatch(t, BeNumerically("==", -1), uint64(math.MaxUint64), false, "uint64 max == -1")
+	expectMatch(t, BeNumerically(">", -3), uint(5), true, "uint 5 > -3")
+	expectMatch(t, BeNumerically("<", uint64(1)<<63), 5, true, "5 < uint64 1<<63")
+	expectMatch(t, BeNumerically("~", uint(5), -1), uint(5), false, "uint 5 ~ 5 within -1")
+}
+
+// gomega/2: == and ~ on integers compare the true difference, which does not wrap.
+func TestHegelPinIntegerDifference(t *testing.T) {
+	expectMatch(t, BeNumerically("~", int64(math.MaxInt64), 1), int64(math.MinInt64), false, "MinInt64 ~ MaxInt64 within 1")
+	expectMatch(t, BeNumerically("~", int64(math.MaxInt64), int64(math.MaxInt64)), int64(-1), false, "-1 ~ MaxInt64 within MaxInt64")
+	expectMatch(t, BeNumerically("==", int64(math.MaxInt64)), int64(math.MinInt64), false, "MinInt64 == MaxInt64")
+}
+
+// gomega/3: an integer and a float are compared by value, not after rounding the integer to
+// float64.
+func TestHegelPinIntegerFloat(t *testing.T) {
+	expectMatch(t, BeNumerically("==", float64(1<<53)), int64(1<<53+1), false, "2^53+1 == float 2^53")
+	expectMatch(t, BeNumerically(">", float64(1<<53)), int64(1<<53+1), true, "2^53+1 > float 2^53")
+	expectMatch(t, BeNumerically("==", 1e19), uint64(10000000000000000001), false, "10^19+1 == 1e19")
+}
+
+// gomega/4: HaveKeyWithValue with a key matcher succeeds when some key matching it has a
+// matching value, whatever the map's iteration order.
+func TestHegelPinKeyWithValueAnyKey(t *testing.T) {
+	m := map[string]string{"aFoo": "x", "bFoo": "Bar", "cFoo": "y", "dFoo": "z"}
+	for i := 0; i < 100; i++ {
+		got := run(HaveKeyWithValue(MatchRegexp(`.+Foo$`), "Bar"), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKeyWithValue(MatchRegexp(.+Foo$), Bar) on %v = %s on try %d, want true", m, got, i)
+		}
+	}
+}
+
+// gomega/5: MatchJSON reports invalid or undecodable JSON as an error instead of comparing the
+// undecoded values as equal.
+func TestHegelPinJSONDecodeError(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{{`1e400`, `1e401`}, {`1e400`, `null`}, {`{"a": 1e400}`, `{"a": 1e999}`}} {
+		got := run(MatchJSON(tc.e), tc.a)
+		if got.err == "" && got.ok {
+			t.Errorf("MatchJSON(%s) on %s = true; the numbers are not representable and differ", tc.e, tc.a)
+		}
+	}
+}
+
+// gomega/6: two JSON numbers match only when they denote the same number.
+func TestHegelPinJSONNumbers(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{
+		{`12345678901234567890`, `12345678901234567891`}, {`9007199254740993`, `9007199254740992`}, {`[0.1]`, `[0.10000000000000002]`},
+	} {
+		got := run(MatchJSON(tc.e), tc.a)
+		if got.err != "" || got.ok {
+			t.Errorf("MatchJSON(%s) on %s = %s, want false", tc.e, tc.a, got)
+		}
+	}
+}
+
+// gomega/7: MatchXML compares namespaces by URI: the prefix chosen for a namespace does not
+// matter.
+func TestHegelPinXMLNamespaces(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{
+		{`<a xmlns:p="urn:u"><p:b/></a>`, `<a xmlns:q="urn:u"><q:b/></a>`},
+		{`<a xmlns="urn:u"><b/></a>`, `<p:a xmlns:p="urn:u"><p:b/></p:a>`},
+		{`<a xmlns:p="urn:u"><p:b p:k="1"/></a>`, `<a xmlns:q="urn:u"><q:b q:k="1"/></a>`},
+	} {
+		got := run(MatchXML(tc.e), tc.a)
+		if got.err != "" || !got.ok {
+			t.Errorf("MatchXML(%s) on %s = %s, want true", tc.e, tc.a, got)
+		}
+	}
+	got := run(MatchXML(`<a xmlns:p="urn:v"><p:b/></a>`), `<a xmlns:p="urn:u"><p:b/></a>`)
+	if got.err != "" || got.ok {
+		t.Errorf("MatchXML with a different namespace URI = %s, want false", got)
+	}
+}
+
+// gomega/8: MatchYAML compares the whole YAML stream: a second document is a difference.
+func TestHegelPinYAMLStream(t *testing.T) {
+	got := run(MatchYAML("a: 1"), "a: 1\n---\nb: 2")
+	if got.err == "" && got.ok {
+		t.Errorf("MatchYAML(a: 1) on a two-document stream = true, want false or an error")
+	}
+	got = run(MatchYAML("a: 1\n---\nb: 2"), "a: 1\n---\nb: 3")
+	if got.err == "" && got.ok {
+		t.Errorf("MatchYAML on two streams differing in the second document = true")
+	}
+}
+
+// gomega/9: HaveExactElements reports where the missing or extra elements start, index 0
+// included.
+func TestHegelPinExactElementsIndexZero(t *testing.T) {
+	m := HaveExactElements("a")
+	m.Match([]string{})
+	if msg := m.FailureMessage([]string{}); !strings.Contains(msg, "missing elements start from index 0") {
+		t.Errorf("HaveExactElements(a) on []: message %q lacks the missing index", msg)
+	}
+	m2 := HaveExactElements()
+	m2.Match([]string{"x"})
+	if msg := m2.FailureMessage([]string{"x"}); !strings.Contains(msg, "extra elements start from index 0") {
+		t.Errorf("HaveExactElements() on [x]: message %q lacks the extra index", msg)
+	}
+}
+
+// gomega/10: WithTransform and Satisfy pass a nil actual to a function whose parameter can be
+// nil (pointer, slice, map, func, chan).
+func TestHegelPinNilArgument(t *testing.T) {
+	expectMatch(t, WithTransform(func(p *int) bool { return p == nil }, BeTrue()), nil, true, "WithTransform(func(*int)) on nil")
+	expectMatch(t, Satisfy(func(p []int) bool { return p == nil }), nil, true, "Satisfy(func([]int)) on nil")
+	expectMatch(t, Satisfy(func(p map[string]int) bool { return p == nil }), nil, true, "Satisfy(func(map)) on nil")
+}
+
+// gomega/11: Equal is reflect.DeepEqual, for []byte as for every other slice: a nil slice does
+// not equal an empty one.
+func TestHegelPinEqualBytes(t *testing.T) {
+	expectMatch(t, Equal([]byte{}), []byte(nil), false, "Equal([]byte{}) on nil []byte")
+	expectMatch(t, Equal([]byte(nil)), []byte{}, false, "Equal(nil []byte) on []byte{}")
+	expectMatch(t, Equal([]int{}), []int(nil), false, "Equal([]int{}) on nil []int")
+}
+
+// gomega/12: HaveKey and HaveKeyWithValue with a key matcher give the same answer whatever the
+// map order: a key the matcher accepts is found even when the matcher errors on another key.
+func TestHegelPinKeyMatcherError(t *testing.T) {
+	m := map[any]int{"a": 1, 2: 2, "b": 3, 4: 4}
+	for i := 0; i < 100; i++ {
+		got := run(HaveKey(BeNumerically(">", 1)), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKey(BeNumerically(>, 1)) on %v = %s on try %d, want true", m, got, i)
+		}
+		got = run(HaveKeyWithValue(BeNumerically(">", 1), 2), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKeyWithValue(BeNumerically(>, 1), 2) on %v = %s on try %d, want true", m, got, i)
+		}
+	}
+}
+
+// gomega/13: ContainElement(nil) and HaveEach(nil) match nil elements, as ConsistOf(nil) does.
+func TestHegelPinNilElement(t *testing.T) {
+	expectMatch(t, ContainElement(nil), []any{1, nil}, true, "ContainElement(nil) on [1, nil]")
+	expectMatch(t, ContainElement(nil), []any{nil}, true, "ContainElement(nil) on [nil]")
+	expectMatch(t, HaveEach(nil), []any{nil, nil}, true, "HaveEach(nil) on [nil, nil]")
+	expectMatch(t, ContainElement(nil), []*int{nil}, true, "ContainElement(nil) on []*int{nil}")
+	expectMatch(t, HaveKeyWithValue("a", nil), map[string]any{"a": nil}, true, "HaveKeyWithValue(a, nil) on {a: nil}")
+}
+
+// gomega/14: a threshold changes == in the same way for every kind of number; == is exact
+// (the threshold belongs to ~).
+func TestHegelPinEqualsThreshold(t *testing.T) {
+	expectMatch(t, BeNumerically("==", 5, 10), 7, false, "int 7 == 5 with threshold 10")
+	expectMatch(t, BeNumerically("==", uint(5), 10), uint(7), false, "uint 7 == 5 with threshold 10")
+	expectMatch(t, BeNumerically("==", 5.0, 10), 7.0, false, "float 7 == 5 with threshold 10")
+}
