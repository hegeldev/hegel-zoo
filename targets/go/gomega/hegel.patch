+// TestHegelNumerically: BeNumerically agrees with exact arithmetic on numbers of every kind.
+func TestHegelNumerically(t *testing.T) {
+	c := newCollector(t)
+	comparators := []string{"==", "~", ">", ">=", "<", "<="}
+	property(t, func(ht *hegel.T) {
+		a := genNum(ht)
+		var b num
+		if chance(ht, 30) {
+			b = a
+		} else if chance(ht, 30) {
+			b = nearNum(ht, a)
+		} else {
+			b = genNum(ht)
+		}
+		cmp := pick(ht, comparators)
+		var th *num
+		if chance(ht, 40) {
+			n := genNum(ht)
+			if chance(ht, 50) {
+				n = num{v: drawInt(ht, 0, 20), x: new(big.Rat).SetInt64(int64(drawInt(ht, 0, 20))), kind: "int"}
+				n.x.SetInt64(int64(n.v.(int)))
+			}
+			th = &n
+		}
+		var m = BeNumerically(cmp, b.v)
+		if th != nil {
+			m = BeNumerically(cmp, b.v, th.v)
+		}
+		got := run(m, a.v)
+		want := modelNumerically(cmp, a, b, th)
+		if got.err != "" {
+			c.failClass(ht, "Error", "BeNumerically(%s, %T %v, %v) on %T %v: %s", cmp, b.v, b.v, thDesc(th), a.v, a.v, got)
+			return
+		}
+		if got.ok != want {
+			c.failClass(ht, "Value", "BeNumerically(%s, %T %v, %v) on %T %v = %v, want %v", cmp, b.v, b.v, thDesc(th), a.v, a.v, got.ok, want)
+			return
+		}
+		c.count(fmt.Sprintf("%s %s/%s %v", cmp, a.kind, b.kind, want))
+	})
+}
+
+func thDesc(t *num) string {
+	if t == nil {
+		return "no threshold"
+	}
+	return fmt.Sprintf("threshold %T %v", t.v, t.v)
+}
