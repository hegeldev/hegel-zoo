+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"github.com/onsi/gomega/types"
+)
+
+func expectMatch(t *testing.T, m types.GomegaMatcher, actual any, want bool, desc string) {
+	t.Helper()
+	got := run(m, actual)
+	if got.err != "" || got.ok != want {
+		t.Errorf("%s = %s, want %v", desc, got, want)
+	}
+}
+
+// gomega/1: BeNumerically compares numbers by value whatever their types, so a negative
+// integer is less than any unsigned one and equal to none.
+func TestHegelPinSignedUnsigned(t *testing.T) {
+	expectMatch(t, BeNumerically("==", uint64(math.MaxUint64)), -1, false, "-1 == uint64 max")
+	expectMatch(t, BeNumerically("==", -1), uint64(math.MaxUint64), false, "uint64 max == -1")
+	expectMatch(t, BeNumerically(">", -3), uint(5), true, "uint 5 > -3")
+	expectMatch(t, BeNumerically("<", uint64(1)<<63), 5, true, "5 < uint64 1<<63")
+	expectMatch(t, BeNumerically("~", uint(5), -1), uint(5), false, "uint 5 ~ 5 within -1")
+}
+
+// gomega/2: == and ~ on integers compare the true difference, which does not wrap.
+func TestHegelPinIntegerDifference(t *testing.T) {
+	expectMatch(t, BeNumerically("~", int64(math.MaxInt64), 1), int64(math.MinInt64), false, "MinInt64 ~ MaxInt64 within 1")
+	expectMatch(t, BeNumerically("~", int64(math.MaxInt64), int64(math.MaxInt64)), int64(-1), false, "-1 ~ MaxInt64 within MaxInt64")
+	expectMatch(t, BeNumerically("==", int64(math.MaxInt64)), int64(math.MinInt64), false, "MinInt64 == MaxInt64")
+}
+
+// gomega/3: an integer and a float are compared by value, not after rounding the integer to
+// float64.
+func TestHegelPinIntegerFloat(t *testing.T) {
+	expectMatch(t, BeNumerically("==", float64(1<<53)), int64(1<<53+1), false, "2^53+1 == float 2^53")
+	expectMatch(t, BeNumerically(">", float64(1<<53)), int64(1<<53+1), true, "2^53+1 > float 2^53")
+	expectMatch(t, BeNumerically("==", 1e19), uint64(10000000000000000001), false, "10^19+1 == 1e19")
+}
+
+// gomega/4: HaveKeyWithValue with a key matcher succeeds when some key matching it has a
+// matching value, whatever the map's iteration order.
+func TestHegelPinKeyWithValueAnyKey(t *testing.T) {
+	m := map[string]string{"aFoo": "x", "bFoo": "Bar", "cFoo": "y", "dFoo": "z"}
+	for i := 0; i < 100; i++ {
+		got := run(HaveKeyWithValue(MatchRegexp(`.+Foo$`), "Bar"), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKeyWithValue(MatchRegexp(.+Foo$), Bar) on %v = %s on try %d, want true", m, got, i)
+		}
+	}
+}
+
+// gomega/5: MatchJSON reports invalid or undecodable JSON as an error instead of comparing the
+// undecoded values as equal.
+func TestHegelPinJSONDecodeError(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{{`1e400`, `1e401`}, {`1e400`, `null`}, {`{"a": 1e400}`, `{"a": 1e999}`}} {
+		got := run(MatchJSON(tc.e), tc.a)
+		if got.err == "" && got.ok {
+			t.Errorf("MatchJSON(%s) on %s = true; the numbers are not representable and differ", tc.e, tc.a)
+		}
+	}
+}
+
+// gomega/6: two JSON numbers match only when they denote the same number.
+func TestHegelPinJSONNumbers(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{
+		{`12345678901234567890`, `12345678901234567891`}, {`9007199254740993`, `9007199254740992`}, {`[0.1]`, `[0.10000000000000002]`},
+	} {
+		got := run(MatchJSON(tc.e), tc.a)
+		if got.err != "" || got.ok {
+			t.Errorf("MatchJSON(%s) on %s = %s, want false", tc.e, tc.a, got)
+		}
+	}
+}
+
+// gomega/7: MatchXML compares namespaces by URI: the prefix chosen for a namespace does not
+// matter.
+func TestHegelPinXMLNamespaces(t *testing.T) {
+	for _, tc := range []struct{ a, e string }{
+		{`<a xmlns:p="urn:u"><p:b/></a>`, `<a xmlns:q="urn:u"><q:b/></a>`},
+		{`<a xmlns="urn:u"><b/></a>`, `<p:a xmlns:p="urn:u"><p:b/></p:a>`},
+		{`<a xmlns:p="urn:u"><p:b p:k="1"/></a>`, `<a xmlns:q="urn:u"><q:b q:k="1"/></a>`},
+	} {
+		got := run(MatchXML(tc.e), tc.a)
+		if got.err != "" || !got.ok {
+			t.Errorf("MatchXML(%s) on %s = %s, want true", tc.e, tc.a, got)
+		}
+	}
+	got := run(MatchXML(`<a xmlns:p="urn:v"><p:b/></a>`), `<a xmlns:p="urn:u"><p:b/></a>`)
+	if got.err != "" || got.ok {
+		t.Errorf("MatchXML with a different namespace URI = %s, want false", got)
+	}
+}
+
+// gomega/8: MatchYAML compares the whole YAML stream: a second document is a difference.
+func TestHegelPinYAMLStream(t *testing.T) {
+	got := run(MatchYAML("a: 1"), "a: 1\n---\nb: 2")
+	if got.err == "" && got.ok {
+		t.Errorf("MatchYAML(a: 1) on a two-document stream = true, want false or an error")
+	}
+	got = run(MatchYAML("a: 1\n---\nb: 2"), "a: 1\n---\nb: 3")
+	if got.err == "" && got.ok {
+		t.Errorf("MatchYAML on two streams differing in the second document = true")
+	}
+}
+
+// gomega/9: HaveExactElements reports where the missing or extra elements start, index 0
+// included.
+func TestHegelPinExactElementsIndexZero(t *testing.T) {
+	m := HaveExactElements("a")
+	m.Match([]string{})
+	if msg := m.FailureMessage([]string{}); !strings.Contains(msg, "missing elements start from index 0") {
+		t.Errorf("HaveExactElements(a) on []: message %q lacks the missing index", msg)
+	}
+	m2 := HaveExactElements()
+	m2.Match([]string{"x"})
+	if msg := m2.FailureMessage([]string{"x"}); !strings.Contains(msg, "extra elements start from index 0") {
+		t.Errorf("HaveExactElements() on [x]: message %q lacks the extra index", msg)
+	}
+}
+
+// gomega/10: WithTransform and Satisfy pass a nil actual to a function whose parameter can be
+// nil (pointer, slice, map, func, chan).
+func TestHegelPinNilArgument(t *testing.T) {
+	expectMatch(t, WithTransform(func(p *int) bool { return p == nil }, BeTrue()), nil, true, "WithTransform(func(*int)) on nil")
+	expectMatch(t, Satisfy(func(p []int) bool { return p == nil }), nil, true, "Satisfy(func([]int)) on nil")
+	expectMatch(t, Satisfy(func(p map[string]int) bool { return p == nil }), nil, true, "Satisfy(func(map)) on nil")
+}
+
+// gomega/11: Equal is reflect.DeepEqual, for []byte as for every other slice: a nil slice does
+// not equal an empty one.
+func TestHegelPinEqualBytes(t *testing.T) {
+	expectMatch(t, Equal([]byte{}), []byte(nil), false, "Equal([]byte{}) on nil []byte")
+	expectMatch(t, Equal([]byte(nil)), []byte{}, false, "Equal(nil []byte) on []byte{}")
+	expectMatch(t, Equal([]int{}), []int(nil), false, "Equal([]int{}) on nil []int")
+}
+
+// gomega/12: HaveKey and HaveKeyWithValue with a key matcher give the same answer whatever the
+// map order: a key the matcher accepts is found even when the matcher errors on another key.
+func TestHegelPinKeyMatcherError(t *testing.T) {
+	m := map[any]int{"a": 1, 2: 2, "b": 3, 4: 4}
+	for i := 0; i < 100; i++ {
+		got := run(HaveKey(BeNumerically(">", 1)), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKey(BeNumerically(>, 1)) on %v = %s on try %d, want true", m, got, i)
+		}
+		got = run(HaveKeyWithValue(BeNumerically(">", 1), 2), m)
+		if got.err != "" || !got.ok {
+			t.Fatalf("HaveKeyWithValue(BeNumerically(>, 1), 2) on %v = %s on try %d, want true", m, got, i)
+		}
+	}
+}
+
+// gomega/13: ContainElement(nil) and HaveEach(nil) match nil elements, as ConsistOf(nil) does.
+func TestHegelPinNilElement(t *testing.T) {
+	expectMatch(t, ContainElement(nil), []any{1, nil}, true, "ContainElement(nil) on [1, nil]")
+	expectMatch(t, ContainElement(nil), []any{nil}, true, "ContainElement(nil) on [nil]")
+	expectMatch(t, HaveEach(nil), []any{nil, nil}, true, "HaveEach(nil) on [nil, nil]")
+	expectMatch(t, ContainElement(nil), []*int{nil}, true, "ContainElement(nil) on []*int{nil}")
+	expectMatch(t, HaveKeyWithValue("a", nil), map[string]any{"a": nil}, true, "HaveKeyWithValue(a, nil) on {a: nil}")
+}
+
+// gomega/14: a threshold changes == in the same way for every kind of number; == is exact
+// (the threshold belongs to ~).
+func TestHegelPinEqualsThreshold(t *testing.T) {
+	expectMatch(t, BeNumerically("==", 5, 10), 7, false, "int 7 == 5 with threshold 10")
+	expectMatch(t, BeNumerically("==", uint(5), 10), uint(7), false, "uint 7 == 5 with threshold 10")
+	expectMatch(t, BeNumerically("==", 5.0, 10), 7.0, false, "float 7 == 5 with threshold 10")
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..64771bf
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,701 @@
+package hegel
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"github.com/onsi/gomega/types"
+	"hegel.dev/go/hegel"
+)
+
+// The recorded bugs each wide property can meet (the ids explain tries).
+var (
+	numericallyBugs = []string{"gomega/1", "gomega/2", "gomega/3", "gomega/14"}
+	collectionBugs  = []string{"gomega/11", "gomega/13"}
+	mapBugs         = []string{"gomega/4", "gomega/12", "gomega/13"}
+	valueBugs       = []string{"gomega/11"}
+)
+
+// checkNumerically judges one BeNumerically call against the model.
+func checkNumerically(ht *hegel.T, c *collector, nc numCase) {
+	got := run(nc.matcher(), nc.a.v)
+	want := func(k known) bool { return modelNumerically(nc.cmp, nc.a, nc.c, nc.th, k) }
+	if got.err != "" {
+		c.failClass(ht, "Error", "%#v: %s", nc, got)
+		return
+	}
+	if got.ok != want(Known) {
+		c.mismatch(ht, explain(numericallyBugs, func(k known) bool { return got.ok == want(k) }), "Value", "%#v = %v, want %v", nc, got.ok, want(Known))
+		return
+	}
+	c.count(fmt.Sprintf("%s %s/%s %v", nc.cmp, nc.a.kind, nc.c.kind, got.ok))
+}
+
+// TestHegelNumerically: BeNumerically agrees with exact arithmetic on numbers of every kind. It
+// draws the shapes of gomega/1 (a signed and an unsigned integer, one outside the other's
+// range: bitcast pairs and mixed specials), gomega/2 (int64 operands whose difference wraps:
+// near pairs across the ends), gomega/3 (an integer beyond 2^53 against its float: cross pairs)
+// and gomega/14 (== with a threshold on near integers).
+func TestHegelNumerically(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumerically(ht, c, hegel.Draw(ht, numCases))
+	})
+}
+
+// --------------------------------------------------------------------------- collections
+
+// expSpec is one argument of a collection matcher: a fresh expectation, or the element at an
+// index (modulo the collection's size) spelled as a plain value.
+type expSpec struct {
+	fresh expectation
+	elem  bool
+	idx   int
+}
+
+var expSpecs = hegel.OneOf(
+	hegel.Map(expectations, func(e expectation) expSpec { return expSpec{fresh: e} }),
+	hegel.Map(hegel.Integers(0, 5), func(i int) expSpec { return expSpec{elem: true, idx: i} }),
+)
+
+var shapes = []string{"slice", "array", "map", "ints"}
+
+// collectionCase: the elements, the expectations (cut or padded to the elements' number when
+// sameCount), the shape of the collection, and a probe value for BeElementOf.
+type collectionCase struct {
+	elems     []any
+	specs     []expSpec
+	sameCount bool
+	shape     string
+	probe     any
+}
+
+var collectionCases = hegel.Composite(func(tc hegel.TestCase) collectionCase {
+	return collectionCase{
+		elems:     hegel.Draw(tc, hegel.Lists(elems).MaxSize(6)),
+		specs:     hegel.Draw(tc, hegel.Lists(expSpecs).MaxSize(6)),
+		sameCount: hegel.Draw(tc, chance(40)),
+		shape:     hegel.Draw(tc, hegel.SampledFrom(shapes)),
+		probe:     hegel.Draw(tc, elems),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (cc collectionCase) GoString() string {
+	return fmt.Sprintf("%s %#v, expectations %s, probe %#v", cc.shape, cc.collection(), labels(cc.expectations()), cc.probe)
+}
+
+// expectations resolves the specs against the elements: an index spec is the element at it, or
+// a nil expectation when there is no element.
+func (cc collectionCase) expectations() []expectation {
+	n := len(cc.elems)
+	specs := cc.specs
+	if cc.sameCount {
+		if len(specs) > n {
+			specs = specs[:n]
+		}
+		for i := len(specs); i < n; i++ {
+			specs = append(specs, expSpec{elem: true, idx: i})
+		}
+	}
+	exps := make([]expectation, len(specs))
+	for i, s := range specs {
+		switch {
+		case !s.elem:
+			exps[i] = s.fresh
+		case n > 0:
+			exps[i] = elemExpectation(cc.elems[s.idx%n])
+		default:
+			exps[i] = elemExpectation(nil)
+		}
+	}
+	return exps
+}
+
+// collection is the elements in the drawn shape: an []any, an array, a map by index, or an
+// []int when every element is an int (an []any otherwise).
+func (cc collectionCase) collection() any {
+	n := len(cc.elems)
+	switch cc.shape {
+	case "array":
+		arr := reflect.New(reflect.ArrayOf(n, reflect.TypeOf((*any)(nil)).Elem())).Elem()
+		for i, e := range cc.elems {
+			if e != nil {
+				arr.Index(i).Set(reflect.ValueOf(e))
+			}
+		}
+		return arr.Interface()
+	case "map":
+		m := map[string]any{}
+		for i, e := range cc.elems {
+			m[fmt.Sprint("k", i)] = e
+		}
+		return m
+	case "ints":
+		ints := []int{}
+		for _, e := range cc.elems {
+			i, ok := e.(int)
+			if !ok {
+				return cc.elems
+			}
+			ints = append(ints, i)
+		}
+		return ints
+	}
+	return cc.elems
+}
+
+// matching is the model's view of the elements against the expectations under a switch set:
+// the adjacency (element i matches expectation j without an error), the errors, and the size
+// of a maximum matching.
+type matching struct {
+	adj, errs [][]bool
+	mm        int
+}
+
+func matchingOf(elems []any, exps []expectation, k known) matching {
+	n, kk := len(elems), len(exps)
+	m := matching{adj: make([][]bool, n), errs: make([][]bool, n)}
+	for i := range elems {
+		m.adj[i] = make([]bool, kk)
+		m.errs[i] = make([]bool, kk)
+		for j, e := range exps {
+			ok, er := e.match(elems[i], k)
+			m.adj[i][j] = ok && !er
+			m.errs[i][j] = er
+		}
+	}
+	m.mm = maxMatching(m.adj, kk)
+	return m
+}
+
+// elementModel is the model of ContainElement(e) and HaveEach(e): the match and error of each
+// element; a nil argument is Equal(nil) while nilElementEqual is on (an error on a nil
+// element, false on a typed nil), BeNil otherwise.
+func elementModel(elems []any, e expectation, k known) (adj, errs []bool) {
+	adj, errs = make([]bool, len(elems)), make([]bool, len(elems))
+	match := e.match
+	if e.arg == nil && k.nilElementEqual {
+		match = equalModel(nil)
+	}
+	for i, el := range elems {
+		ok, er := match(el, k)
+		adj[i], errs[i] = ok && !er, er
+	}
+	return adj, errs
+}
+
+// judge compares the package's answer with the model's under Known; on a disagreement it names
+// the bugs that explain the answer (explain over ids) and fails.
+func judge(ht *hegel.T, c *collector, ids []string, class string, got res, want func(known) res, format string, args ...any) bool {
+	w := want(Known)
+	if got.same(w) {
+		return true
+	}
+	shape := explain(ids, func(k known) bool { return got.same(want(k)) })
+	c.mismatch(ht, shape, class, format+" = %s, want %s", append(args, got, w)...)
+	return false
+}
+
+// TestHegelCollections: ConsistOf, ContainElements, HaveExactElements, ContainElement, HaveEach
+// and BeElementOf against the multiset semantics of the documentation (a maximum matching
+// between elements and expectations). It draws the shapes of gomega/11 (a nil and an empty byte
+// slice meeting in Equal, through ConsistOf, ContainElement and BeElementOf) and gomega/13 (a
+// nil argument of ContainElement or HaveEach against a nil or typed-nil element).
+func TestHegelCollections(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, collectionCases)
+		elems, exps, actual := cc.elems, cc.expectations(), cc.collection()
+		n, k := len(elems), len(exps)
+		desc := fmt.Sprintf("actual %#v, expectations %s", actual, labels(exps))
+
+		// the single-slice rule: one expectation that is a slice is flattened; the generator
+		// avoids the case by wrapping
+		single := k == 1 && exps[0].arg != nil && (reflect.TypeOf(exps[0].arg).Kind() == reflect.Slice || reflect.TypeOf(exps[0].arg).Kind() == reflect.Array)
+		if !single {
+			got := run(ConsistOf(args(exps)...), actual)
+			want := func(kn known) res { m := matchingOf(elems, exps, kn); return res{ok: m.mm == n && m.mm == k} }
+			if !judge(ht, c, collectionBugs, "ConsistOf", got, want, "ConsistOf; %s", desc) {
+				return
+			}
+			got = run(ContainElements(args(exps)...), actual)
+			want = func(kn known) res { return res{ok: matchingOf(elems, exps, kn).mm == k} }
+			if !judge(ht, c, collectionBugs, "ContainElements", got, want, "ContainElements; %s", desc) {
+				return
+			}
+			if cc.shape != "map" {
+				got = run(HaveExactElements(args(exps)...), actual)
+				want = func(kn known) res {
+					m := matchingOf(elems, exps, kn)
+					ok := n == k
+					for i := 0; i < n && i < k; i++ {
+						if !m.adj[i][i] {
+							ok = false
+						}
+					}
+					return res{ok: ok}
+				}
+				if !judge(ht, c, collectionBugs, "HaveExactElements", got, want, "HaveExactElements; %s", desc) {
+					return
+				}
+			}
+		}
+		if k > 0 {
+			e := exps[0]
+			got := run(ContainElement(e.arg), actual)
+			want := func(kn known) res {
+				adj, errs := elementModel(elems, e, kn)
+				any, anyErr := false, false
+				for i := range elems {
+					any = any || adj[i]
+					anyErr = anyErr || errs[i]
+				}
+				switch {
+				case any:
+					return res{ok: true}
+				case anyErr:
+					return res{err: "element"}
+				}
+				return res{ok: false}
+			}
+			if !judge(ht, c, collectionBugs, "ContainElement", got, want, "ContainElement(%s); %s", e.label, desc) {
+				return
+			}
+			if cc.shape != "map" {
+				got = run(HaveEach(e.arg), actual)
+				// in order: an error stops with an error, a non-match with false
+				want = func(kn known) res {
+					adj, errs := elementModel(elems, e, kn)
+					if n == 0 {
+						return res{err: "empty"}
+					}
+					for i := range elems {
+						if errs[i] {
+							return res{err: "element"}
+						}
+						if !adj[i] {
+							return res{ok: false}
+						}
+					}
+					return res{ok: true}
+				}
+				if !judge(ht, c, collectionBugs, "HaveEach", got, want, "HaveEach(%s); %s", e.label, desc) {
+					return
+				}
+			}
+		}
+		// BeElementOf: the elements as variadic values (a single slice element would be flattened)
+		if n > 0 && cc.probe != nil && !(n == 1 && elems[0] != nil && reflect.TypeOf(elems[0]).Kind() == reflect.Slice) {
+			got := run(BeElementOf(elems...), cc.probe)
+			want := func(kn known) res {
+				// BeElementOf wraps each element in Equal (a nil element in Equal(nil))
+				for _, e := range elems {
+					if ok, _ := equalModel(e)(cc.probe, kn); ok {
+						return res{ok: true}
+					}
+				}
+				return res{ok: false}
+			}
+			if !judge(ht, c, collectionBugs, "BeElementOf", got, want, "BeElementOf(%#v) on %#v", elems, cc.probe) {
+				return
+			}
+		}
+		c.count(fmt.Sprintf("n=%d k=%d %s", n, k, cc.shape))
+	})
+}
+
+// --------------------------------------------------------------------------- maps
+
+// mapCase: a map with string and int keys, a key expectation, a value expectation and a probe
+// for BeKeyOf.
+type mapCase struct {
+	entries map[any]any
+	key     expectation
+	value   expectation
+	probe   any
+}
+
+var (
+	mapKeys = weighted(
+		choice[any]{70, asAny(hegel.SampledFrom([]string{"a", "ab", "b", "abc", "k1", "k2"}))},
+		choice[any]{30, asAny(hegel.Integers(0, 3))},
+	)
+	mapCases = hegel.Composite(func(tc hegel.TestCase) mapCase {
+		return mapCase{
+			entries: hegel.Draw(tc, hegel.Maps(mapKeys, elems).MaxSize(4)),
+			key:     hegel.Draw(tc, expectations),
+			value:   hegel.Draw(tc, expectations),
+			probe:   hegel.Draw(tc, elems),
+		}
+	})
+)
+
+// keys are the map's keys in a fixed order (ints before strings, each sorted).
+func (mc mapCase) keys() []any {
+	var ks []any
+	for k := range mc.entries {
+		ks = append(ks, k)
+	}
+	sort.Slice(ks, func(i, j int) bool {
+		a, aInt := ks[i].(int)
+		b, bInt := ks[j].(int)
+		switch {
+		case aInt && bInt:
+			return a < b
+		case aInt != bInt:
+			return aInt
+		}
+		return ks[i].(string) < ks[j].(string)
+	})
+	return ks
+}
+
+// GoString is what the draw report prints (it uses %#v); the entries in key order.
+func (mc mapCase) GoString() string {
+	var parts []string
+	for _, k := range mc.keys() {
+		parts = append(parts, fmt.Sprintf("%#v: %#v", k, mc.entries[k]))
+	}
+	return fmt.Sprintf("map{%s} key %s value %s probe %#v", strings.Join(parts, ", "), mc.key.label, mc.value.label, mc.probe)
+}
+
+// cacheKey tells the case apart from every other for the verdicts cache: %#v prints int(2) and
+// float64(2) alike, so the types of the entries and of the expectations' arguments are added.
+func (mc mapCase) cacheKey() string {
+	var parts []string
+	for _, k := range mc.keys() {
+		parts = append(parts, fmt.Sprintf("%T(%#v): %T(%#v)", k, k, mc.entries[k], mc.entries[k]))
+	}
+	return fmt.Sprintf("map{%s} key %s:%T value %s:%T", strings.Join(parts, ", "), mc.key.label, mc.key.arg, mc.value.label, mc.value.arg)
+}
+
+// the map the matchers see (a nil map for no entries is still a map)
+func (mc mapCase) m() map[any]any {
+	if mc.entries == nil {
+		return map[any]any{}
+	}
+	return mc.entries
+}
+
+// haveKeyOutcomes is the set of answers HaveKey(ke) may give on the map: the documented one, or
+// while keyMatcherErrorOrder is on, an error or a match by the map's order when the key matcher
+// errors on some key and accepts another.
+func haveKeyOutcomes(keys []any, ke expectation, k known) map[string]bool {
+	outcomes := map[string]bool{}
+	anyMatch, anyErr := false, false
+	for _, key := range keys {
+		ok, er := ke.match(key, k)
+		anyMatch = anyMatch || (ok && !er)
+		anyErr = anyErr || er
+	}
+	switch {
+	case anyErr && k.keyMatcherErrorOrder:
+		outcomes["error"] = true
+		if anyMatch {
+			outcomes["true"] = true
+		}
+	case anyMatch:
+		outcomes["true"] = true
+	case anyErr:
+		outcomes["error"] = true
+	default:
+		outcomes["false"] = true
+	}
+	return outcomes
+}
+
+// haveKeyWithValueOutcomes is the set of answers HaveKeyWithValue(ke, ve) may give: the
+// documented one (some accepted key has a matching value), or while keyMatcherFirstKey is on
+// the outcome of whichever accepted key the map's order yields first, while
+// keyMatcherErrorOrder is on an error whenever the key matcher errors on a key, and while
+// nilElementEqual is on a nil value expectation read as Equal(nil).
+func haveKeyWithValueOutcomes(m map[any]any, keys []any, ke, ve expectation, k known) map[string]bool {
+	outcomes := map[string]bool{}
+	var perKey []string // outcome if this key were the first accepted by the key matcher
+	exists := false
+	for _, key := range keys {
+		ok, er := ke.match(key, k)
+		if er {
+			perKey = append(perKey, "error")
+			continue
+		}
+		if !ok {
+			continue
+		}
+		vok, ver := ve.match(m[key], k)
+		if ve.arg == nil && k.nilElementEqual {
+			vok, ver = equalModel(nil)(m[key], k) // a nil value expectation is Equal(nil)
+		}
+		switch {
+		case ver:
+			perKey = append(perKey, "error")
+		case vok:
+			perKey = append(perKey, "true")
+			exists = true
+		default:
+			perKey = append(perKey, "false")
+		}
+	}
+	hasErr, hasFalse := false, false
+	for _, o := range perKey {
+		hasErr = hasErr || o == "error"
+		hasFalse = hasFalse || o == "false"
+	}
+	switch {
+	case k.keyMatcherFirstKey:
+		// the first accepted key (in map order) decides
+		if exists {
+			outcomes["true"] = true
+		}
+		if hasFalse {
+			outcomes["false"] = true
+		}
+	case exists:
+		outcomes["true"] = true
+	case hasFalse:
+		outcomes["false"] = true
+	}
+	if hasErr && (k.keyMatcherErrorOrder || len(outcomes) == 0) {
+		outcomes["error"] = true
+	}
+	if len(outcomes) == 0 {
+		outcomes["false"] = true
+	}
+	if _, isMatcher := ke.arg.(interface{ Match(any) (bool, error) }); !isMatcher && ke.arg != nil {
+		// a plain key: at most one key equals it, so the outcome is single
+		outcomes = map[string]bool{}
+		if len(perKey) == 0 {
+			outcomes["false"] = true
+		}
+		for _, o := range perKey {
+			outcomes[o] = true
+		}
+	}
+	return outcomes
+}
+
+func inOutcomes(got res, outcomes map[string]bool) bool {
+	return outcomes[got.String()] || (got.err != "" && outcomes["error"])
+}
+
+// judgeOutcomes is judge for a model that allows a set of answers.
+func judgeOutcomes(ht *hegel.T, c *collector, class string, got res, want func(known) map[string]bool, format string, args ...any) bool {
+	w := want(Known)
+	if inOutcomes(got, w) {
+		return true
+	}
+	shape := explain(mapBugs, func(k known) bool { return inOutcomes(got, want(k)) })
+	c.mismatch(ht, shape, class, format+" = %s, want one of %v", append(args, got, keysOf(w))...)
+	return false
+}
+
+// TestHegelMaps: HaveKey, HaveKeyWithValue and BeKeyOf against the map, with outcome sets where
+// the package's answer depends on the iteration order. It draws the shapes of gomega/4 (a key
+// matcher accepting several keys whose values differ in matching), gomega/12 (a key matcher
+// erroring on one key and accepting another) and gomega/13 (a nil value expectation against a
+// nil value). The package's answer on an order-dependent case is cached per case (verdicts), so
+// that the shrinker's revisits see one verdict.
+func TestHegelMaps(t *testing.T) {
+	c := newCollector(t)
+	v := newVerdicts()
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, mapCases)
+		m, keys, ke, ve := mc.m(), mc.keys(), mc.key, mc.value
+		key := mc.cacheKey()
+		got := v.run("HaveKey "+key, HaveKey(ke.arg), m)
+		want := func(k known) map[string]bool { return haveKeyOutcomes(keys, ke, k) }
+		if !judgeOutcomes(ht, c, "HaveKey", got, want, "HaveKey(%s) on %#v", ke.label, m) {
+			return
+		}
+		got = v.run("HaveKeyWithValue "+key, HaveKeyWithValue(ke.arg, ve.arg), m)
+		want = func(k known) map[string]bool { return haveKeyWithValueOutcomes(m, keys, ke, ve, k) }
+		if !judgeOutcomes(ht, c, "HaveKeyWithValue", got, want, "HaveKeyWithValue(%s, %s) on %#v", ke.label, ve.label, m) {
+			return
+		}
+		orderDependent := len(want(Known)) > 1
+		// BeKeyOf
+		if mc.probe != nil {
+			got = run(BeKeyOf(m), mc.probe)
+			wantKey := false
+			for _, k := range keys {
+				if reflect.DeepEqual(k, mc.probe) {
+					wantKey = true
+				}
+			}
+			if got.err != "" || got.ok != wantKey {
+				c.failClass(ht, "BeKeyOf", "BeKeyOf(%#v) on %#v = %s, want %v", m, mc.probe, got, wantKey)
+				return
+			}
+		}
+		if orderDependent {
+			c.count("order dependent")
+		} else {
+			c.count("keys " + got.String())
+		}
+	})
+}
+
+func keysOf(m map[string]bool) []string {
+	var ks []string
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// --------------------------------------------------------------------------- values
+
+// valueCase: two values (the same one 40% of the time), a length to ask for, and a string with
+// a candidate affix in one of three forms (string, []byte, Stringer).
+type valueCase struct {
+	a, b any
+	n    int
+	s    string
+	sub  string
+	form string
+}
+
+type stringer string
+
+func (s stringer) String() string { return string(s) }
+
+var (
+	valuePairs = weighted(
+		choice[[2]any]{40, hegel.Map(elems, func(a any) [2]any { return [2]any{a, a} })},
+		choice[[2]any]{60, hegel.Composite(func(tc hegel.TestCase) [2]any { return [2]any{hegel.Draw(tc, elems), hegel.Draw(tc, elems)} })},
+	)
+	valueCases = hegel.Composite(func(tc hegel.TestCase) valueCase {
+		p := hegel.Draw(tc, valuePairs)
+		return valueCase{
+			a: p[0], b: p[1],
+			n:    hegel.Draw(tc, hegel.Integers(0, 3)),
+			s:    hegel.Draw(tc, hegel.SampledFrom([]string{"", "a", "ab", "abc", "ba", "aXb", "%d", "a\nb", "é"})),
+			sub:  hegel.Draw(tc, hegel.SampledFrom([]string{"", "a", "b", "ab", "c", "%", "\n", "é"})),
+			form: hegel.Draw(tc, hegel.SampledFrom([]string{"string", "bytes", "stringer"})),
+		}
+	})
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (vc valueCase) GoString() string {
+	return fmt.Sprintf("a %#v b %#v n %d s %q sub %q as %s", vc.a, vc.b, vc.n, vc.s, vc.sub, vc.form)
+}
+
+// text is s in the drawn form.
+func (vc valueCase) text() any {
+	switch vc.form {
+	case "bytes":
+		return []byte(vc.s)
+	case "stringer":
+		return stringer(vc.s)
+	}
+	return vc.s
+}
+
+// TestHegelValues: Equal, BeIdenticalTo, BeZero, BeNil, HaveLen, BeEmpty and the string
+// matchers against their documented definitions. It draws the shape of gomega/11 (Equal on a
+// nil and an empty byte slice).
+func TestHegelValues(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		vc := hegel.Draw(ht, valueCases)
+		a, b := vc.a, vc.b
+		// Equal: reflect.DeepEqual, nil vs nil an error
+		got := run(Equal(b), a)
+		if a == nil && b == nil {
+			if got.err == "" {
+				c.failClass(ht, "Equal", "Equal(nil) on nil = %s, want an error", got)
+				return
+			}
+		} else {
+			want := func(k known) res { ok, _ := equalModel(b)(a, k); return res{ok: ok} }
+			if !judge(ht, c, valueBugs, "Equal", got, want, "Equal(%#v) on %#v", b, a) {
+				return
+			}
+		}
+		// BeIdenticalTo: == when comparable
+		if a != nil || b != nil {
+			got = run(BeIdenticalTo(b), a)
+			want := false
+			if a != nil && b != nil && reflect.TypeOf(a) == reflect.TypeOf(b) && reflect.TypeOf(a).Comparable() {
+				want = a == b
+			}
+			if got.err != "" || got.ok != want {
+				c.failClass(ht, "BeIdenticalTo", "BeIdenticalTo(%#v) on %#v = %s, want %v", b, a, got, want)
+				return
+			}
+		}
+		// BeZero / BeNil
+		got = run(BeZero(), a)
+		want := a == nil || reflect.DeepEqual(reflect.Zero(reflect.TypeOf(a)).Interface(), a)
+		if got.err != "" || got.ok != want {
+			c.failClass(ht, "BeZero", "BeZero on %#v = %s, want %v", a, got, want)
+			return
+		}
+		got = run(BeNil(), a)
+		if got.err != "" || got.ok != isNilValue(a) {
+			c.failClass(ht, "BeNil", "BeNil on %#v = %s, want %v", a, got, isNilValue(a))
+			return
+		}
+		// HaveLen / BeEmpty on the lengthy kinds
+		if a != nil {
+			switch reflect.TypeOf(a).Kind() {
+			case reflect.String, reflect.Slice, reflect.Array, reflect.Map:
+				l := reflect.ValueOf(a).Len()
+				got = run(HaveLen(vc.n), a)
+				if got.err != "" || got.ok != (l == vc.n) {
+					c.failClass(ht, "HaveLen", "HaveLen(%d) on %#v = %s", vc.n, a, got)
+					return
+				}
+				got = run(BeEmpty(), a)
+				if got.err != "" || got.ok != (l == 0) {
+					c.failClass(ht, "BeEmpty", "BeEmpty on %#v = %s", a, got)
+					return
+				}
+			}
+		}
+		// string matchers, with the actual as string, []byte or Stringer
+		s, sub, actual := vc.s, vc.sub, vc.text()
+		checks := []struct {
+			m    types.GomegaMatcher
+			want bool
+			name string
+		}{
+			{HavePrefix(sub), strings.HasPrefix(s, sub), "HavePrefix"},
+			{HaveSuffix(sub), strings.HasSuffix(s, sub), "HaveSuffix"},
+			{ContainSubstring(sub), strings.Contains(s, sub), "ContainSubstring"},
+			{MatchRegexp("^" + regexpQuote(sub)), strings.HasPrefix(s, sub), "MatchRegexp"},
+		}
+		for _, ck := range checks {
+			got = run(ck.m, actual)
+			if got.err != "" || got.ok != ck.want {
+				c.failClass(ht, ck.name, "%s(%q) on %T %q = %s, want %v", ck.name, sub, actual, s, got, ck.want)
+				return
+			}
+		}
+		// the format-string form
+		got = run(HavePrefix("%s", sub), actual)
+		if got.err != "" || got.ok != strings.HasPrefix(s, sub) {
+			c.failClass(ht, "HavePrefixf", "HavePrefix(%%s, %q) on %q = %s", sub, s, got)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+func regexpQuote(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if strings.ContainsRune(`\.+*?()|[]{}^$`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..c3b43a0
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,1069 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with random
+// contents, judged by the models the wide properties use (hegel_model_test.go,
+// hegel_props_test.go, hegel_docs_test.go), so that each bug has a property that finds it every
+// run; the wide properties reach the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each
+// draws the neighbouring region the bug does not touch instead (integers that fit both kinds,
+// differences that fit int64, integers float64 holds, maps with one outcome, numbers within
+// float64, one prefix, single documents, a start index above zero, interface parameters, equal
+// byte slices, key matchers that never error, collections without a nil, == without a threshold
+// within reach, one extra element) and passes.
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"hegel.dev/go/hegel"
+)
+
+func ptrTo[T any](x T) *T { return &x }
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- gomega/1
+
+var (
+	signedKinds     = hegel.SampledFrom(intKinds)
+	unsignedKinds   = hegel.SampledFrom(uintKinds)
+	wideUnsignedKin = hegel.SampledFrom([]reflect.Kind{reflect.Uint, reflect.Uint64})
+	// negatives: a negative integer of a signed kind (the kind's minimum one time in five)
+	negatives = hegel.FlatMap(signedKinds, func(k reflect.Kind) hegel.Generator[num] {
+		lo, _ := kindRange(k)
+		return weighted(
+			choice[num]{80, hegel.Map(hegel.Integers[int64](-1000, -1), func(v int64) num { return intNum(k, v) })},
+			choice[num]{20, hegel.Just(intNum(k, lo))},
+		)
+	})
+	// nonNegatives: a signed integer every unsigned kind holds
+	nonNegatives = hegel.FlatMap(signedKinds, func(k reflect.Kind) hegel.Generator[num] {
+		return hegel.Map(hegel.Integers[int64](0, 100), func(v int64) num { return intNum(k, v) })
+	})
+	// smallUnsigned: an unsigned integer every signed kind holds
+	smallUnsigned = hegel.FlatMap(unsignedKinds, func(k reflect.Kind) hegel.Generator[num] {
+		return hegel.Map(hegel.Integers[uint64](0, 100), func(v uint64) num { return uintNum(k, v) })
+	})
+	// hugeUnsigned: an unsigned integer above MaxInt64 (the maximum one time in five)
+	hugeUnsigned = hegel.FlatMap(wideUnsignedKin, func(k reflect.Kind) hegel.Generator[num] {
+		return weighted(
+			choice[num]{80, hegel.Map(hegel.Integers[uint64](1, 1000), func(v uint64) num { return uintNum(k, math.MaxInt64+v) })},
+			choice[num]{20, hegel.Just(uintNum(k, math.MaxUint64))},
+		)
+	})
+	smallThresholds = weighted(
+		choice[*num]{50, hegel.Just[*num](nil)},
+		choice[*num]{50, hegel.Map(hegel.Integers[int64](0, 20), func(v int64) *num { n := intNum(reflect.Int, v); return &n })},
+	)
+	negativeThresholds = hegel.Map(hegel.Integers[int64](-20, -1), func(v int64) *num { n := intNum(reflect.Int, v); return &n })
+)
+
+// pairOf is a case of a and c drawn from the generators given, any comparator, a threshold.
+func pairOf(as, cs hegel.Generator[num], ths hegel.Generator[*num]) hegel.Generator[numCase] {
+	return hegel.Composite(func(tc hegel.TestCase) numCase {
+		return numCase{a: hegel.Draw(tc, as), c: hegel.Draw(tc, cs), cmp: hegel.Draw(tc, comparators), th: hegel.Draw(tc, ths)}
+	})
+}
+
+// mixedSignCases: a signed and an unsigned integer where one is outside the other's kind (a
+// negative signed one, an unsigned one above MaxInt64), either as the actual, or an unsigned
+// actual with a negative threshold: the shape of gomega/1. Under HEGEL_NO_KNOWN=1 the mixed
+// kinds hold values that fit both.
+var mixedSignCases = shaped(
+	hegel.OneOf(
+		pairOf(negatives, smallUnsigned, smallThresholds),
+		pairOf(smallUnsigned, negatives, smallThresholds),
+		pairOf(hugeUnsigned, nonNegatives, smallThresholds),
+		pairOf(nonNegatives, hugeUnsigned, smallThresholds),
+		pairOf(smallUnsigned, smallUnsigned, negativeThresholds),
+	),
+	hegel.OneOf(
+		pairOf(nonNegatives, smallUnsigned, smallThresholds),
+		pairOf(smallUnsigned, nonNegatives, smallThresholds),
+	),
+)
+
+// TestHegelMixedSignIntegersCompareByValue: BeNumerically compares a signed and an unsigned
+// integer by value: a negative number is below every unsigned one, an unsigned one above
+// MaxInt64 is above every signed one, and a negative threshold puts nothing within reach. The
+// package converts every argument to the actual's kind, so -1 equals the unsigned maximum
+// (gomega/1).
+func TestHegelMixedSignIntegersCompareByValue(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumerically(ht, c, hegel.Draw(ht, mixedSignCases))
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/2
+
+var (
+	int64Kinds = hegel.SampledFrom([]reflect.Kind{reflect.Int, reflect.Int64})
+	// wrapCases: an int64 near one end and one near the other, so that their difference wraps
+	// (the shape of gomega/2), under == or ~ with no threshold, a small one or the largest.
+	wrapCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+		k := hegel.Draw(tc, int64Kinds)
+		low := intNum(k, math.MinInt64+hegel.Draw(tc, hegel.Integers[int64](0, 10)))
+		high := intNum(k, math.MaxInt64-hegel.Draw(tc, hegel.Integers[int64](0, 10)))
+		a, c := low, high
+		if hegel.Draw(tc, hegel.Booleans()) {
+			a, c = high, low
+		}
+		th := hegel.Draw(tc, weighted(
+			choice[*num]{40, hegel.Just[*num](nil)},
+			choice[*num]{40, hegel.Map(hegel.Integers[int64](0, 20), func(v int64) *num { n := intNum(reflect.Int, v); return &n })},
+			choice[*num]{20, hegel.Just(ptrTo(intNum(reflect.Int64, math.MaxInt64)))},
+		))
+		return numCase{a: a, c: c, cmp: hegel.Draw(tc, hegel.SampledFrom([]string{"~", "=="})), th: th}
+	})
+	// fittingCases: int64s whose difference fits (within 2^62 of zero)
+	fittingCases = pairOf(
+		hegel.FlatMap(int64Kinds, func(k reflect.Kind) hegel.Generator[num] {
+			return hegel.Map(hegel.Integers[int64](-(1<<62), 1<<62), func(v int64) num { return intNum(k, v) })
+		}),
+		hegel.FlatMap(int64Kinds, func(k reflect.Kind) hegel.Generator[num] {
+			return hegel.Map(hegel.Integers[int64](-(1<<62), 1<<62), func(v int64) num { return intNum(k, v) })
+		}),
+		smallThresholds,
+	)
+)
+
+// TestHegelIntegerDifferencesDoNotWrap: == and ~ on two int64s compare their true difference:
+// numbers at opposite ends of int64 are not within any threshold below 2^63. The package
+// subtracts in int64, which wraps (gomega/2).
+func TestHegelIntegerDifferencesDoNotWrap(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumerically(ht, c, hegel.Draw(ht, shaped(wrapCases, fittingCases)))
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/3
+
+// rounded is an integer float64 does not hold and the float it rounds to: m * 2^e + d with a
+// 53-bit m, e >= 2 and 0 < d < 2^(e-1), so that the integer rounds down to m * 2^e.
+type rounded struct {
+	m    uint64
+	e    int
+	d    uint64
+	swap bool
+}
+
+// values: the integer (an int64 kind when it fits, else an unsigned one) and the float.
+func (r rounded) values() (n, f num) {
+	v := r.m<<uint(r.e) + r.d
+	f = floatNum(reflect.Float64, float64(r.m)*math.Ldexp(1, r.e))
+	if v <= math.MaxInt64 {
+		return intNum(reflect.Int64, int64(v)), f
+	}
+	return uintNum(reflect.Uint64, v), f
+}
+
+var (
+	roundedInts = hegel.Composite(func(tc hegel.TestCase) rounded {
+		e := hegel.Draw(tc, hegel.Integers(2, 11))
+		return rounded{
+			m:    hegel.Draw(tc, hegel.Integers[uint64](1<<52, 1<<53-1)),
+			e:    e,
+			d:    hegel.Draw(tc, hegel.Integers[uint64](1, 1<<uint(e-1)-1)),
+			swap: hegel.Draw(tc, hegel.Booleans()),
+		}
+	})
+	// roundedCases: the integer against its float, either as the actual, any comparator.
+	roundedCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+		r := hegel.Draw(tc, roundedInts)
+		n, f := r.values()
+		a, c := n, f
+		if r.swap {
+			a, c = f, n
+		}
+		return numCase{a: a, c: c, cmp: hegel.Draw(tc, comparators), th: hegel.Draw(tc, smallThresholds)}
+	})
+	// heldCases: an integer within 2^53 against a float64 of a nearby integer
+	heldCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+		v := hegel.Draw(tc, hegel.Integers[int64](-(1<<53), 1<<53))
+		n := intNum(reflect.Int64, v)
+		f := floatNum(reflect.Float64, float64(v+hegel.Draw(tc, hegel.Integers[int64](-2, 2))))
+		a, c := n, f
+		if hegel.Draw(tc, hegel.Booleans()) {
+			a, c = f, n
+		}
+		return numCase{a: a, c: c, cmp: hegel.Draw(tc, comparators), th: hegel.Draw(tc, smallThresholds)}
+	})
+)
+
+// TestHegelIntegerFloatComparisonIsExact: an integer and a float are compared by value: an
+// integer float64 cannot hold is not equal to the float it rounds to, and is above it. The
+// package rounds the integer to float64 first (gomega/3).
+func TestHegelIntegerFloatComparisonIsExact(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumerically(ht, c, hegel.Draw(ht, shaped(roundedCases, heldCases)))
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/4
+
+func matchRegexp(pat string) expectation {
+	re := regexp.MustCompile(pat)
+	return expectation{arg: MatchRegexp(pat), label: fmt.Sprintf("MatchRegexp(%q)", pat), match: func(e any, _ known) (bool, bool) {
+		s, ok := stringOf(e)
+		if !ok {
+			return false, true
+		}
+		return re.MatchString(s), false
+	}}
+}
+
+// anyKeyCase: a map of two to four Foo keys, a key matcher accepting them all, and the value
+// looked for, held by one key (the shape of gomega/4), by every key or by none under
+// HEGEL_NO_KNOWN=1.
+type anyKeyCase struct {
+	values map[string]string
+	hit    int
+	all    bool
+	none   bool
+	key    expectation
+}
+
+var (
+	fooKeys     = hegel.SampledFrom([]string{"aFoo", "bFoo", "cFoo", "dFoo"})
+	otherValues = hegel.SampledFrom([]string{"x", "y", "z"})
+	allKeys     = hegel.OneOf(hegel.Just(havePrefix("")), hegel.Just(matchRegexp(`.+Foo$`)))
+	anyKeyCases = hegel.Composite(func(tc hegel.TestCase) anyKeyCase {
+		return anyKeyCase{
+			values: hegel.Draw(tc, hegel.Maps(fooKeys, otherValues).MinSize(2).MaxSize(4)),
+			hit:    hegel.Draw(tc, hegel.Integers(0, 3)),
+			all:    hegel.Draw(tc, shaped(hegel.Just(false), hegel.Booleans())),
+			none:   hegel.Draw(tc, shaped(hegel.Just(false), hegel.Booleans())),
+			key:    hegel.Draw(tc, allKeys),
+		}
+	})
+)
+
+// m is the map: the values drawn, with "Bar" at the hit key (at every key when all, at none
+// when none).
+func (c anyKeyCase) m() map[any]any {
+	keys := sortedKeys(c.values)
+	m := map[any]any{}
+	for i, k := range keys {
+		m[k] = c.values[k]
+		if c.all || (!c.none && i == c.hit%len(keys)) {
+			m[k] = "Bar"
+		}
+	}
+	return m
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c anyKeyCase) GoString() string {
+	m := c.m()
+	var parts []string
+	for _, k := range sortedKeys(c.values) {
+		parts = append(parts, fmt.Sprintf("%q: %q", k, m[k]))
+	}
+	return fmt.Sprintf("HaveKeyWithValue(%s, \"Bar\") on {%s}", c.key.label, strings.Join(parts, ", "))
+}
+
+// TestHegelKeyMatcherAnyKeyDecides: HaveKeyWithValue with a key matcher succeeds when some key
+// the key matcher accepts has the value, whichever key the map's order yields first. The
+// package judges the first accepted key alone (gomega/4). The package's answer is cached per
+// case (verdicts), so that the shrinker's revisits see one verdict.
+func TestHegelKeyMatcherAnyKeyDecides(t *testing.T) {
+	c := newCollector(t)
+	v := newVerdicts()
+	property(t, func(ht *hegel.T) {
+		kc := hegel.Draw(ht, anyKeyCases)
+		m, ve := kc.m(), elemExpectation("Bar")
+		keys := mapCase{entries: m}.keys()
+		got := v.run(kc.GoString(), HaveKeyWithValue(kc.key.arg, "Bar"), m)
+		want := func(k known) map[string]bool { return haveKeyWithValueOutcomes(m, keys, kc.key, ve, k) }
+		if judgeOutcomes(ht, c, "HaveKeyWithValue", got, want, "%#v", kc) {
+			c.count(got.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- gomega/5 and 6
+
+// wrapped puts a number into a small document: bare, in an array, or under a key.
+type wrapped struct {
+	wrap string
+	n    jv
+}
+
+func (w wrapped) doc() jv {
+	switch w.wrap {
+	case "array":
+		return arrayOf([]jv{w.n})
+	case "object":
+		return objectOf(map[string]jv{"k": w.n})
+	}
+	return w.n
+}
+
+var wraps = hegel.SampledFrom([]string{"bare", "array", "object"})
+
+// numberPair: two JSON documents with one number each, spelled by two styles.
+type numberPair struct {
+	wrap   string
+	na, nb jv
+	sa, sb jsonStyle
+}
+
+func (p numberPair) docs() (a, b jv) { return wrapped{p.wrap, p.na}.doc(), wrapped{p.wrap, p.nb}.doc() }
+
+func (p numberPair) texts() (sa, sb string) {
+	a, b := p.docs()
+	return renderJSON(a, p.sa), renderJSON(b, p.sb)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (p numberPair) GoString() string {
+	sa, sb := p.texts()
+	return fmt.Sprintf("MatchJSON(%s) on %s", sb, sa)
+}
+
+func numberPairsOf(numbers hegel.Generator[[2]jv]) hegel.Generator[numberPair] {
+	return hegel.Composite(func(tc hegel.TestCase) numberPair {
+		ns := hegel.Draw(tc, numbers)
+		return numberPair{wrap: hegel.Draw(tc, wraps), na: ns[0], nb: ns[1], sa: hegel.Draw(tc, jsonStyles), sb: hegel.Draw(tc, jsonStyles)}
+	})
+}
+
+// checkJSONPair judges MatchJSON on the pair against the JSON model.
+func checkJSONPair(ht *hegel.T, c *collector, p numberPair) {
+	a, b := p.docs()
+	sa, sb := p.texts()
+	got := run(MatchJSON(sb), sa)
+	fits := func(k known) bool {
+		want, mayErr := jsonModel(a, b, k)
+		if got.err != "" {
+			return mayErr
+		}
+		return got.ok == want
+	}
+	if !fits(Known) {
+		want, _ := jsonModel(a, b, Known)
+		c.mismatch(ht, explain(jsonBugs, fits), "MatchJSON", "%#v = %s, want %v", p, got, want)
+		return
+	}
+	c.count(got.String())
+}
+
+var (
+	// outOfRangePairs: two different numbers beyond float64's range, of one sign, which decode
+	// as the same infinity (the shape of gomega/5)
+	outOfRangePairs = hegel.Composite(func(tc hegel.TestCase) [2]jv {
+		sign := hegel.Draw(tc, hegel.SampledFrom([]string{"", "-"}))
+		e1 := hegel.Draw(tc, hegel.Integers(400, 999))
+		e2 := e1 + hegel.Draw(tc, hegel.Integers(1, 100))
+		return [2]jv{numberOf(fmt.Sprintf("%s1e%d", sign, e1)), numberOf(fmt.Sprintf("%s1e%d", sign, e2))}
+	})
+	// largePairs: two different numbers within float64's range, near its top
+	largePairs = hegel.Composite(func(tc hegel.TestCase) [2]jv {
+		sign := hegel.Draw(tc, hegel.SampledFrom([]string{"", "-"}))
+		e1 := hegel.Draw(tc, hegel.Integers(290, 307))
+		e2 := e1 + hegel.Draw(tc, hegel.Integers(1, 308-e1))
+		return [2]jv{numberOf(fmt.Sprintf("%s1e%d", sign, e1)), numberOf(fmt.Sprintf("%s1e%d", sign, e2))}
+	})
+)
+
+// TestHegelJSONDecodeErrorsAreReported: two documents whose numbers lie beyond float64's range
+// and differ do not match (or the matcher reports that it cannot decode them). The package
+// decodes both as the same infinity, ignoring json.Unmarshal's error, and says they match
+// (gomega/5).
+func TestHegelJSONDecodeErrorsAreReported(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkJSONPair(ht, c, hegel.Draw(ht, numberPairsOf(shaped(outOfRangePairs, largePairs))))
+	})
+}
+
+var (
+	// collapsingPairs: two different integers float64 rounds to one value: m * 2^e + d1 and
+	// m * 2^e + d2 with d1, d2 below half the spacing 2^e (the shape of gomega/6)
+	collapsingPairs = hegel.Composite(func(tc hegel.TestCase) [2]jv {
+		e := hegel.Draw(tc, hegel.Integers(2, 12))
+		m := hegel.Draw(tc, hegel.Integers[uint64](1<<52, 1<<53-1))
+		d1 := hegel.Draw(tc, hegel.Integers[uint64](0, 1<<uint(e-1)-1))
+		d2 := (d1 + hegel.Draw(tc, hegel.Integers[uint64](1, 1<<uint(e-1)-1))) % (1 << uint(e-1))
+		base := new(big.Int).Lsh(new(big.Int).SetUint64(m), uint(e))
+		return [2]jv{
+			numberOf(new(big.Int).Add(base, new(big.Int).SetUint64(d1)).String()),
+			numberOf(new(big.Int).Add(base, new(big.Int).SetUint64(d2)).String()),
+		}
+	})
+	// distinctPairs: two different integers within 2^53
+	distinctPairs = hegel.Composite(func(tc hegel.TestCase) [2]jv {
+		v := hegel.Draw(tc, hegel.Integers[int64](-(1<<53), 1<<53-1))
+		d := hegel.Draw(tc, hegel.Integers[int64](1, 1000))
+		return [2]jv{numberOf(fmt.Sprint(v)), numberOf(fmt.Sprint(v + d))}
+	})
+)
+
+// TestHegelJSONNumbersCompareExactly: two JSON documents whose integers differ do not match,
+// however large the integers. The package compares the numbers as float64, where integers
+// beyond 2^53 collapse (gomega/6).
+func TestHegelJSONNumbersCompareExactly(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkJSONPair(ht, c, hegel.Draw(ht, numberPairsOf(shaped(collapsingPairs, distinctPairs))))
+	})
+}
