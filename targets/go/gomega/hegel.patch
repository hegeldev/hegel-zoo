+package hegel
+
+// MatchJSON, MatchYAML and MatchXML against structural equality of generated documents rendered
+// in different spellings. A document is a value tree (jv, xel) drawn from a recursive generator;
+// a spelling record per rendering (jsonStyle, yamlStyle, xmlStyle) holds the whitespace, escape,
+// number, key-order, quoting and reference choices as tapes read modulo their length, so the
+// renderers are pure functions of the tree and the style, and an empty tape is the plain
+// spelling; a mutation is a path into the tree applied by a pure function.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- JSON / YAML values
+
+// jv is a JSON (or YAML) value: nil, bool, *big.Rat (number), string, []jv or map (sorted keys).
+type jv struct {
+	kind string // "null", "bool", "num", "str", "arr", "obj"
+	b    bool
+	n    *big.Rat
+	inf  int    // a number decoded as an infinity (+1, -1) in the package's float64 reading
+	nsrc string // the number as written
+	s    string
+	arr  []jv
+	keys []string
+	obj  map[string]jv
+}
+
+// GoString is what the draw report prints (it uses %#v): the plain JSON spelling.
+func (v jv) GoString() string { return renderJSON(v, jsonStyle{}) }
+
+func numberOf(src string) jv {
+	r, ok := new(big.Rat).SetString(src)
+	if !ok {
+		panic("bad number " + src)
+	}
+	return jv{kind: "num", n: r, nsrc: src}
+}
+
+// ratText is the decimal spelling of a rational of the generated number pools (integers and
+// short decimal fractions): exact, as JSON and YAML read it.
+func ratText(r *big.Rat) string {
+	if r.IsInt() {
+		return r.Num().String()
+	}
+	for digits := 1; digits <= 30; digits++ {
+		s := r.FloatString(digits)
+		if back, ok := new(big.Rat).SetString(s); ok && back.Cmp(r) == 0 {
+			return s
+		}
+	}
+	return r.FloatString(30)
+}
+
+var (
+	jvStrings      = hegel.SampledFrom([]string{"", "a", "ab", "A", "é", "a b", "\n", "\"q\"", "\\", "/", "x\ty"})
+	jvKeys         = hegel.SampledFrom([]string{"a", "b", "c", "k", "A", "a b", ""})
+	spelledNumbers = []string{"1.5", "-0.25", "0.1", "1e2", "1E-2", "2.5e0", "10", "1.0", "0.0", "-0"}
+	// wideNumbers: beyond float64's precision or range (the shapes of gomega/6 and gomega/5)
+	wideNumbers = []string{"12345678901234567890", "12345678901234567891", "9007199254740993", "9007199254740992", "1e400", "1e401", "123456789012345678901234567890"}
+)
+
+func itoaNumber(v int) jv { return numberOf(strconv.Itoa(v)) }
+
+// numbersOf: small integers first, the spelled fractions and exponents, wider integers, and,
+// for the JSON matcher (wide), the numbers beyond float64 - a hundred-odd instead under
+// HEGEL_NO_KNOWN=1, whose model follows the package's float64 reading.
+func numbersOf(wide bool) hegel.Generator[jv] {
+	alts := []choice[jv]{
+		{30, hegel.Map(hegel.Integers(-5, 5), itoaNumber)},
+		{20, hegel.Map(hegel.SampledFrom(spelledNumbers), numberOf)},
+		{30, hegel.Map(hegel.Integers(-1000, 1000), itoaNumber)},
+	}
+	if wide {
+		alts = append(alts, choice[jv]{20, shaped(hegel.Map(hegel.SampledFrom(wideNumbers), numberOf), hegel.Map(hegel.Integers(100, 200), itoaNumber))})
+	}
+	return weighted(alts...)
+}
+
+func arrayOf(xs []jv) jv { return jv{kind: "arr", arr: xs} }
+
+func objectOf(m map[string]jv) jv {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	if m == nil {
+		m = map[string]jv{}
+	}
+	return jv{kind: "obj", obj: m, keys: keys}
+}
+
+// treesOf is a JSON value up to three containers deep: scalars first, arrays and objects of up
+// to three members drawn from the same generator (a depth counter in the closure bounds the
+// recursion; deferred back so an aborted draw cannot leave it stale).
+func treesOf(wide bool) hegel.Generator[jv] {
+	scalars := weighted(
+		choice[jv]{15, hegel.Just(jv{kind: "null"})},
+		choice[jv]{15, hegel.Map(hegel.Booleans(), func(b bool) jv { return jv{kind: "bool", b: b} })},
+		choice[jv]{30, numbersOf(wide)},
+		choice[jv]{20, hegel.Map(jvStrings, func(s string) jv { return jv{kind: "str", s: s} })},
+	)
+	depth := 0
+	var values hegel.Generator[jv]
+	arrays := hegel.Composite(func(tc hegel.TestCase) jv { return arrayOf(hegel.Draw(tc, hegel.Lists(values).MaxSize(3))) })
+	objects := hegel.Composite(func(tc hegel.TestCase) jv { return objectOf(hegel.Draw(tc, hegel.Maps(jvKeys, values).MaxSize(3))) })
+	nodes := weighted(choice[jv]{70, scalars}, choice[jv]{15, arrays}, choice[jv]{15, objects})
+	values = hegel.Composite(func(tc hegel.TestCase) jv {
+		if depth >= 3 {
+			return hegel.Draw(tc, scalars)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, nodes)
+	})
+	return values
+}
+
+var (
+	jsonTrees = treesOf(true)
+	yamlTrees = treesOf(false)
+)
+
+func (v jv) equal(o jv) bool {
+	if v.kind != o.kind {
+		return false
+	}
+	switch v.kind {
+	case "bool":
+		return v.b == o.b
+	case "num":
+		if v.inf != 0 || o.inf != 0 {
+			return v.inf == o.inf
+		}
+		return v.n.Cmp(o.n) == 0
+	case "str":
+		return v.s == o.s
+	case "arr":
+		if len(v.arr) != len(o.arr) {
+			return false
+		}
+		for i := range v.arr {
+			if !v.arr[i].equal(o.arr[i]) {
+				return false
+			}
+		}
+		return true
+	case "obj":
+		if len(v.obj) != len(o.obj) {
+			return false
+		}
+		for k, x := range v.obj {
+			y, ok := o.obj[k]
+			if !ok || !x.equal(y) {
+				return false
+			}
+		}
+		return true
+	}
+	return true
+}
+
+// edit is a mutation of a value: a path of child indices, each taken modulo the live container,
+// into the leaf changed (a number plus one, a string with an x appended, a bool flipped, a null
+// made false); a container the path ends at, or an empty one, gains a member instead.
+type edit struct {
+	on   bool
+	path []int
+}
+
+var edits = weighted(
+	choice[edit]{50, hegel.Just(edit{})},
+	choice[edit]{50, hegel.Map(hegel.Lists(hegel.Integers(0, 3)).MaxSize(3), func(p []int) edit { return edit{on: true, path: p} })},
+)
+
+// mutate changes one leaf of the value along the path so that it differs.
+func mutate(v jv, path []int) jv {
+	switch v.kind {
+	case "arr":
+		if len(v.arr) > 0 && len(path) > 0 {
+			i := path[0] % len(v.arr)
+			arr := append([]jv(nil), v.arr...)
+			arr[i] = mutate(arr[i], path[1:])
+			return arrayOf(arr)
+		}
+		return arrayOf(append(append([]jv(nil), v.arr...), jv{kind: "null"}))
+	case "obj":
+		obj := map[string]jv{}
+		for kk, vv := range v.obj {
+			obj[kk] = vv
+		}
+		if len(v.keys) > 0 && len(path) > 0 {
+			k := v.keys[path[0]%len(v.keys)]
+			obj[k] = mutate(obj[k], path[1:])
+		} else {
+			obj["zz"] = jv{kind: "bool", b: true}
+		}
+		return objectOf(obj)
+	case "num":
+		r := new(big.Rat).Add(v.n, big.NewRat(1, 1))
+		return jv{kind: "num", n: r, nsrc: ratText(r)}
+	case "str":
+		return jv{kind: "str", s: v.s + "x"}
+	case "bool":
+		return jv{kind: "bool", b: !v.b}
+	}
+	return jv{kind: "bool", b: false}
+}
+
+func (e edit) apply(v jv) jv {
+	if !e.on {
+		return v
+	}
+	return mutate(v, e.path)
+}
+
+// --------------------------------------------------------------------------- JSON spelling
+
+// jsonStyle is the spelling of one JSON rendering, as tapes read modulo their length.
+type jsonStyle struct {
+	ws    []int // per gap: whitespace (0: none)
+	esc   []int // per string character: 1 escapes an ASCII character as \uXXXX
+	nums  []int // per number: an equal spelling (0: as written)
+	order []int // per object key: a rank; keys are ordered by rank, then by name
+}
+
+var (
+	jsonStyles = hegel.Composite(func(tc hegel.TestCase) jsonStyle {
+		return jsonStyle{ws: hegel.Draw(tc, tape(4, 12)), esc: hegel.Draw(tc, tape(1, 12)), nums: hegel.Draw(tc, tape(4, 6)), order: hegel.Draw(tc, tape(3, 6))}
+	})
+	wsPool = []string{"", " ", "\n", "\t", "  \n "}
+)
+
+// jsonWriter renders a value with a style, keeping a cursor per tape.
+type jsonWriter struct {
+	st  jsonStyle
+	cur [4]int
+}
+
+func (w *jsonWriter) next(tape []int, i int) int {
+	v := at(tape, w.cur[i])
+	w.cur[i]++
+	return v
+}
+
+func (w *jsonWriter) ws() string { return wsPool[w.next(w.st.ws, 0)] }
+
+// str spells s: each character as json.Marshal spells it, or (ASCII, when the escape tape says
+// so) as a \uXXXX escape.
+func (w *jsonWriter) str(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		if w.next(w.st.esc, 1) == 1 && r < 0x80 {
+			fmt.Fprintf(&sb, "\\u%04x", r)
+		} else {
+			b, _ := json.Marshal(string(r))
+			sb.Write(b[1 : len(b)-1])
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+// num spells a number: as written, or, for an integer written plainly, an equal spelling (5 as
+// 5.0, 5e0, 5E0 or 50e-1).
+func (w *jsonWriter) num(v jv) string {
+	c := w.next(w.st.nums, 2)
+	src := v.nsrc
+	plain := src == "0" || src == "-0" || (strings.Trim(strings.TrimPrefix(src, "-"), "0123456789") == "" && strings.TrimPrefix(src, "-")[0] != '0')
+	if c == 0 || !plain || len(src) >= 15 {
+		return src
+	}
+	switch c {
+	case 1:
+		return src + ".0"
+	case 2:
+		return src + "e0"
+	case 3:
+		return src + "E0"
+	}
+	if src == "0" || src == "-0" {
+		return src + "e0"
+	}
+	return src + "0e-1"
+}
+
+// ordered is the object's keys in the order the rank tape gives (a stable sort by rank over the
+// sorted keys: an empty tape keeps them sorted).
+func (w *jsonWriter) ordered(keys []string) []string {
+	ranked := make([]struct {
+		rank int
+		key  string
+	}, len(keys))
+	for i, k := range keys {
+		ranked[i].rank, ranked[i].key = w.next(w.st.order, 3), k
+	}
+	sort.SliceStable(ranked, func(i, j int) bool { return ranked[i].rank < ranked[j].rank })
+	out := make([]string, len(keys))
+	for i, r := range ranked {
+		out[i] = r.key
+	}
+	return out
+}
+
+func (w *jsonWriter) value(v jv) string {
+	switch v.kind {
+	case "null":
+		return "null"
+	case "bool":
+		return strconv.FormatBool(v.b)
+	case "num":
+		return w.num(v)
+	case "str":
+		return w.str(v.s)
+	case "arr":
+		var parts []string
+		for _, e := range v.arr {
+			parts = append(parts, w.ws()+w.value(e)+w.ws())
+		}
+		return "[" + w.ws() + strings.Join(parts, ",") + "]"
+	}
+	var parts []string
+	for _, k := range w.ordered(v.keys) {
+		parts = append(parts, w.ws()+w.str(k)+w.ws()+":"+w.ws()+w.value(v.obj[k])+w.ws())
+	}
+	return "{" + w.ws() + strings.Join(parts, ",") + "}"
+}
+
+// renderJSON spells the value in the style.
+func renderJSON(v jv, st jsonStyle) string {
+	w := &jsonWriter{st: st}
+	return w.value(v)
+}
+
+// --------------------------------------------------------------------------- YAML spelling
+
+// yamlStyle is the spelling of one YAML rendering: flow or block per container, the null and
+// bool spellings per scalar, and whether the document starts with a "---" marker.
+type yamlStyle struct {
+	block  []int // per container: 1 renders it in block style (an empty one is always flow)
+	nulls  []int // per null: null, ~, Null
+	bools  []int // per bool: true, True
+	header bool
+}
+
+var yamlStyles = hegel.Composite(func(tc hegel.TestCase) yamlStyle {
+	return yamlStyle{block: hegel.Draw(tc, tape(1, 8)), nulls: hegel.Draw(tc, tape(2, 4)), bools: hegel.Draw(tc, tape(1, 4)), header: hegel.Draw(tc, chance(20))}
+})
+
+type yamlWriter struct {
+	st  yamlStyle
+	cur [3]int
+}
+
+func (w *yamlWriter) next(tape []int, i int) int {
+	v := at(tape, w.cur[i])
+	w.cur[i]++
+	return v
+}
+
+func yamlString(s string) string {
+	b, _ := json.Marshal(s)
+	return string(b)
+}
+
+// value spells the value; a block container's rendering starts with a newline.
+func (w *yamlWriter) value(v jv, indent int) string {
+	pad := strings.Repeat("  ", indent)
+	switch v.kind {
+	case "null":
+		return []string{"null", "~", "Null"}[w.next(w.st.nulls, 1)]
+	case "bool":
+		s := strconv.FormatBool(v.b)
+		if w.next(w.st.bools, 2) == 1 {
+			s = strings.ToUpper(s[:1]) + s[1:]
+		}
+		return s
+	case "num":
+		return v.nsrc
+	case "str":
+		return yamlString(v.s)
+	case "arr":
+		if len(v.arr) == 0 || w.next(w.st.block, 0) == 0 {
+			return w.flow(v)
+		}
+		var sb strings.Builder
+		for _, e := range v.arr {
+			r := w.value(e, indent+1)
+			if strings.HasPrefix(r, "\n") {
+				sb.WriteString("\n" + pad + "-" + r)
+			} else {
+				sb.WriteString("\n" + pad + "- " + r)
+			}
+		}
+		return sb.String()
+	}
+	if len(v.keys) == 0 || w.next(w.st.block, 0) == 0 {
+		return w.flow(v)
+	}
+	var sb strings.Builder
+	for _, k := range v.keys {
+		sb.WriteString("\n" + pad + yamlString(k) + ":")
+		r := w.value(v.obj[k], indent+1)
+		if strings.HasPrefix(r, "\n") {
+			sb.WriteString(r)
+		} else {
+			sb.WriteString(" " + r)
+		}
+	}
+	return sb.String()
+}
+
+// flow spells a container and everything below it in flow style.
+func (w *yamlWriter) flow(v jv) string {
+	switch v.kind {
+	case "arr":
+		var parts []string
+		for _, e := range v.arr {
+			parts = append(parts, w.flow(e))
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case "obj":
+		var parts []string
+		for _, k := range v.keys {
+			parts = append(parts, yamlString(k)+": "+w.flow(v.obj[k]))
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	return w.value(v, 0)
+}
+
+// renderYAML spells the value in the style.
+func renderYAML(v jv, st yamlStyle) string {
+	w := &yamlWriter{st: st}
+	s := w.value(v, 0)
+	if st.header {
+		s = "---\n" + s
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- JSON model
+
+// outOfRange reports whether the number is beyond float64's range.
+func (v jv) outOfRange() bool {
+	if v.kind != "num" || v.inf != 0 {
+		return false
+	}
+	f, _ := v.n.Float64()
+	return math.IsInf(f, 0)
+}
+
+func (v jv) hasOutOfRange() bool {
+	switch v.kind {
+	case "num":
+		return v.outOfRange()
+	case "arr":
+		for _, e := range v.arr {
+			if e.hasOutOfRange() {
+				return true
+			}
+		}
+	case "obj":
+		for _, e := range v.obj {
+			if e.hasOutOfRange() {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// decoded is the value as the package's reading under k decodes it: every number as a float64
+// while jsonNumbersFloat64 is on, a number beyond float64's range as an infinity (what
+// encoding/json leaves, with the error the package ignores) while jsonDecodeErrorIgnored is on.
+func (v jv) decoded(k known) jv {
+	switch v.kind {
+	case "num":
+		f, _ := v.n.Float64()
+		if v.outOfRange() {
+			if k.jsonDecodeErrorIgnored {
+				return jv{kind: "num", inf: int(math.Copysign(1, f))}
+			}
+			return v
+		}
+		if k.jsonNumbersFloat64 {
+			return jv{kind: "num", n: new(big.Rat).SetFloat64(f)}
+		}
+		return v
+	case "arr":
+		arr := make([]jv, len(v.arr))
+		for i, e := range v.arr {
+			arr[i] = e.decoded(k)
+		}
+		return arrayOf(arr)
+	case "obj":
+		obj := map[string]jv{}
+		for key, e := range v.obj {
+			obj[key] = e.decoded(k)
+		}
+		return objectOf(obj)
+	}
+	return v
+}
+
+// jsonModel: the documented equality (the decoded documents compared as numbers) and whether
+// an error is acceptable (a document with a number beyond float64's range fails to decode: the
+// documented answer is an error, or the comparison); the package's float64 reading and ignored
+// decode errors behind the switches of k.
+func jsonModel(a, b jv, k known) (want bool, mayErr bool) {
+	mayErr = !k.jsonDecodeErrorIgnored && (a.hasOutOfRange() || b.hasOutOfRange())
+	return a.decoded(k).equal(b.decoded(k)), mayErr
+}
+
+// docCase: a value, a mutation of it for the second document, and a spelling per document.
+type docCase[S any] struct {
+	a      jv
+	edit   edit
+	sa, sb S
+}
+
+func (c docCase[S]) b() jv { return c.edit.apply(c.a) }
+
+var (
+	jsonCases = hegel.Composite(func(tc hegel.TestCase) docCase[jsonStyle] {
+		return docCase[jsonStyle]{a: hegel.Draw(tc, jsonTrees), edit: hegel.Draw(tc, edits), sa: hegel.Draw(tc, jsonStyles), sb: hegel.Draw(tc, jsonStyles)}
+	})
+	// jsonForms: the actual as a string, a []byte or a json.RawMessage
+	jsonForms = hegel.SampledFrom([]string{"string", "bytes", "raw"})
+	jsonBugs  = []string{"gomega/5", "gomega/6"}
+)
+
+// GoString is what the draw report prints (it uses %#v): the two documents as rendered.
+func (c docCase[S]) GoString() string {
+	switch sa := any(c.sa).(type) {
+	case jsonStyle:
+		return fmt.Sprintf("%s against %s", renderJSON(c.a, sa), renderJSON(c.b(), any(c.sb).(jsonStyle)))
+	case yamlStyle:
+		return fmt.Sprintf("%q against %q", renderYAML(c.a, sa), renderYAML(c.b(), any(c.sb).(yamlStyle)))
+	}
+	return fmt.Sprintf("%#v against %#v", c.a, c.b())
+}
+
+// TestHegelJSON: MatchJSON says equal for two spellings of one value and not for a value with
+// one leaf changed. It draws the shapes of gomega/5 (two numbers beyond float64's range, which
+// decode as the same infinity) and gomega/6 (two integers beyond 2^53 that round to one
+// float64).
+func TestHegelJSON(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		dc := hegel.Draw(ht, jsonCases)
+		form := hegel.Draw(ht, jsonForms)
+		a, b := dc.a, dc.b()
+		sa, sb := renderJSON(a, dc.sa), renderJSON(b, dc.sb)
+		var actual any = sa
+		switch form {
+		case "bytes":
+			actual = []byte(sa)
+		case "raw":
+			actual = json.RawMessage(sa)
+		}
+		got := run(MatchJSON(sb), actual)
+		fits := func(k known) bool {
+			want, mayErr := jsonModel(a, b, k)
+			if got.err != "" {
+				return mayErr
+			}
+			return got.ok == want
+		}
+		if !fits(Known) {
+			want, _ := jsonModel(a, b, Known)
+			c.mismatch(ht, explain(jsonBugs, fits), "MatchJSON", "MatchJSON(%s) on %s = %s, want %v", sb, sa, got, want)
+			return
+		}
+		switch {
+		case got.err != "":
+			c.count("out of range: error")
+		case got.ok:
+			c.count("match")
+		default:
+			c.count("mismatch")
+		}
+	})
+}
+
+// yamlCase: a document case and whether the second document is followed by another one (a
+// stream, the shape of gomega/8; never under HEGEL_NO_KNOWN=1).
+type yamlCase struct {
+	docCase[yamlStyle]
+	stream bool
+}
+
+var (
+	yamlCases = hegel.Composite(func(tc hegel.TestCase) yamlCase {
+		return yamlCase{
+			docCase: docCase[yamlStyle]{a: hegel.Draw(tc, yamlTrees), edit: hegel.Draw(tc, edits), sa: hegel.Draw(tc, yamlStyles), sb: hegel.Draw(tc, yamlStyles)},
+			stream:  hegel.Draw(tc, shaped(chance(20), hegel.Just(false))),
+		}
+	})
+	yamlBugs = []string{"gomega/8"}
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c yamlCase) GoString() string {
+	return fmt.Sprintf("%q against %q", renderYAML(c.a, c.sa), c.expected())
+}
+
+// expected is the second document as rendered, followed by another document when stream.
+func (c yamlCase) expected() string {
+	s := renderYAML(c.b(), c.sb)
+	if c.stream {
+		s += "\n---\nextra: 1"
+	}
+	return s
+}
+
+// yamlModel: the documented equality of the two YAML texts: the values equal and the expected
+// a single document - a stream of two is another document, unless the package's first-document
+// reading is on. An integer beyond uint64 is read as a float64 by the YAML decoder (recorded,
+// not counted: README); the YAML trees draw none.
+func yamlModel(a, b jv, stream bool, k known) bool {
+	want := a.equal(b)
+	if a.kind == "num" && b.kind == "num" && (!a.n.IsInt() || !a.n.Num().IsUint64() && !a.n.Num().IsInt64()) {
+		want = a.decoded(knownOf("gomega/6")).equal(b.decoded(knownOf("gomega/6")))
+	}
+	return want && (!stream || k.yamlFirstDocument)
+}
+
+// TestHegelYAML: MatchYAML says equal for two spellings of one value (flow or block, null and
+// bool spellings, a document marker) and not for a value with one leaf changed. It draws the
+// shape of gomega/8 (the expected text a stream of two documents).
+func TestHegelYAML(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		yc := hegel.Draw(ht, yamlCases)
+		a, b := yc.a, yc.b()
+		sa, sb := renderYAML(a, yc.sa), yc.expected()
+		got := run(MatchYAML(sb), sa)
+		want := func(k known) res { return res{ok: yamlModel(a, b, yc.stream, k)} }
+		if !judge(ht, c, yamlBugs, "MatchYAML", got, want, "MatchYAML(%q) on %q", sb, sa) {
+			return
+		}
+		c.count(fmt.Sprint("match ", got.ok))
+	})
+}
+
+// --------------------------------------------------------------------------- XML
+
+type xel struct {
+	name     string
+	prefixed bool // in the namespace u (declared on the root)
+	attrs    map[string]string
+	text     string // leaf text (no children)
+	children []xel
+}
+
+// GoString is what the draw report prints (it uses %#v): the plain XML spelling.
+func (e xel) GoString() string { return renderXML(e, xmlStyle{prefix: "p"}) }
+
+var (
+	xelNames = hegel.SampledFrom([]string{"a", "b", "item", "x"})
+	xelAttrs = hegel.Maps(hegel.SampledFrom([]string{"id", "n", "k", "v"}), hegel.SampledFrom([]string{"1", "2", "a b", "<", "&", "'", "\""})).MaxSize(2)
+	xelTexts = maybe(60, hegel.SampledFrom([]string{"x", "hello", "a<b", "1 & 2", "é", "]]>", "x y"}))
+	// xels: an element tree up to three levels deep; a leaf holds text three times in five.
+	xels = func() hegel.Generator[xel] {
+		depth := 0
+		var nodes hegel.Generator[xel]
+		children := hegel.Composite(func(tc hegel.TestCase) []xel {
+			if depth >= 2 {
+				return nil
+			}
+			depth++
+			defer func() { depth-- }()
+			return hegel.Draw(tc, hegel.Lists(nodes).MinSize(1).MaxSize(3))
+		})
+		kids := maybe(50, children)
+		nodes = hegel.Composite(func(tc hegel.TestCase) xel {
+			e := xel{name: hegel.Draw(tc, xelNames), prefixed: hegel.Draw(tc, chance(30)), attrs: hegel.Draw(tc, xelAttrs)}
+			e.children = hegel.Draw(tc, kids)
+			if len(e.children) == 0 {
+				e.text = hegel.Draw(tc, xelTexts)
+			}
+			return e
+		})
+		return nodes
+	}()
+)
+
+func (e xel) equal(o xel) bool {
+	if e.name != o.name || e.prefixed != o.prefixed || e.text != o.text || len(e.attrs) != len(o.attrs) || len(e.children) != len(o.children) {
+		return false
+	}
+	for k, v := range e.attrs {
+		if o.attrs[k] != v {
+			return false
+		}
+	}
+	for i := range e.children {
+		if !e.children[i].equal(o.children[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// xelEdit is a mutation of a tree: a path of child indices (modulo the live children) into the
+// element changed, and which of its changes: its name, an attribute (the first by name, when it
+// has one), or its text (when it is a leaf), the kind taken modulo the changes available.
+type xelEdit struct {
+	on   bool
+	path []int
+	kind int
+}
+
+var xelEdits = weighted(
+	choice[xelEdit]{50, hegel.Just(xelEdit{})},
+	choice[xelEdit]{50, hegel.Composite(func(tc hegel.TestCase) xelEdit {
+		return xelEdit{on: true, path: hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 2)).MaxSize(2)), kind: hegel.Draw(tc, hegel.Integers(0, 2))}
+	})},
+)
+
+func mutateXel(e xel, path []int, kind int) xel {
+	if len(e.children) > 0 && len(path) > 0 {
+		ch := append([]xel(nil), e.children...)
+		i := path[0] % len(ch)
+		ch[i] = mutateXel(ch[i], path[1:], kind)
+		e.children = ch
+		return e
+	}
+	changes := []string{"name"}
+	if len(e.attrs) > 0 {
+		changes = append(changes, "attr")
+	}
+	if len(e.children) == 0 {
+		changes = append(changes, "text")
+	}
+	switch changes[kind%len(changes)] {
+	case "attr":
+		attrs := map[string]string{}
+		for k, v := range e.attrs {
+			attrs[k] = v
+		}
+		attrs[sortedKeys(attrs)[0]] += "z"
+		e.attrs = attrs
+	case "text":
+		e.text += "z"
+	default:
+		e.name += "z"
+	}
+	return e
+}
+
+func (m xelEdit) apply(e xel) xel {
+	if !m.on {
+		return e
+	}
+	return mutateXel(e, m.path, m.kind)
+}
+
+func sortedKeys(m map[string]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// xmlStyle is the spelling of one XML rendering: the namespace prefix declared on the root,
+// the XML declaration, and tapes for the attribute order, quotes, gaps and equals signs, the
+// empty-element form, the whitespace between children, CDATA sections and character references.
+type xmlStyle struct {
+	prefix  string
+	decl    bool
+	order   []int // per attribute: a rank (sorted by name for equal ranks)
+	quotes  []int // per attribute: 1 single-quotes the value
+	gaps    []int // per attribute: the whitespace before it (one space, two, a newline)
+	eqs     []int // per attribute: 1 spaces the equals sign
+	empties []int // per empty element: <a></a>, <a/>, <a />
+	pretty  []int // per element with children: 1 puts each child on its own indented line
+	cdata   []int // per text: 1 wraps it in a CDATA section (unless it holds ]]>)
+	refs    []int // per text character: 1 writes a decimal reference, 2 a hexadecimal one
+}
+
+var (
+	// prefixes: the prefix spelling the namespace in a document, p or q (another prefix for
+	// the same namespace is the shape of gomega/7); p alone under HEGEL_NO_KNOWN=1.
+	prefixes  = shaped(hegel.SampledFrom([]string{"p", "q"}), hegel.Just("p"))
+	xmlStyles = hegel.Composite(func(tc hegel.TestCase) xmlStyle {
+		return xmlStyle{
+			prefix:  hegel.Draw(tc, prefixes),
+			decl:    hegel.Draw(tc, chance(20)),
+			order:   hegel.Draw(tc, tape(2, 4)),
+			quotes:  hegel.Draw(tc, tape(1, 4)),
+			gaps:    hegel.Draw(tc, tape(2, 4)),
+			eqs:     hegel.Draw(tc, tape(1, 4)),
+			empties: hegel.Draw(tc, tape(2, 4)),
+			pretty:  hegel.Draw(tc, tape(1, 4)),
+			cdata:   hegel.Draw(tc, tape(1, 4)),
+			refs:    hegel.Draw(tc, tape(2, 8)),
+		}
+	})
+)
+
+type xmlWriter struct {
+	st  xmlStyle
+	cur [8]int
+}
+
+func (w *xmlWriter) next(tape []int, i int) int {
+	v := at(tape, w.cur[i])
+	w.cur[i]++
+	return v
+}
+
+// text spells leaf text: a CDATA section, or the text with its markup characters escaped and
+// some characters as references.
+func (w *xmlWriter) text(s string) string {
+	if w.next(w.st.cdata, 6) == 1 && !strings.Contains(s, "]]>") {
+		return "<![CDATA[" + s + "]]>"
+	}
+	var sb strings.Builder
+	for _, r := range s {
+		ref := w.next(w.st.refs, 7)
+		switch {
+		case r == '<':
+			sb.WriteString("&lt;")
+		case r == '&':
+			sb.WriteString("&amp;")
+		case r == '>':
+			sb.WriteString("&gt;")
+		case ref == 1:
+			fmt.Fprintf(&sb, "&#%d;", r)
+		case ref == 2:
+			fmt.Fprintf(&sb, "&#x%X;", r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+func escAttr(s string, q byte) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	if q == '"' {
+		return strings.ReplaceAll(s, "\"", "&quot;")
+	}
+	return strings.ReplaceAll(s, "'", "&apos;")
+}
+
+func (w *xmlWriter) element(e xel, indent int, root bool) string {
+	var sb strings.Builder
+	pad := strings.Repeat("  ", indent)
+	name := e.name
+	if e.prefixed {
+		name = w.st.prefix + ":" + name
+	}
+	sb.WriteString("<" + name)
+	if root {
+		sb.WriteString(" xmlns:" + w.st.prefix + "=\"urn:u\"")
+	}
+	keys := sortedKeys(e.attrs)
+	ranked := make([]struct {
+		rank int
+		key  string
+	}, len(keys))
+	for i, k := range keys {
+		ranked[i].rank, ranked[i].key = w.next(w.st.order, 0), k
+	}
+	sort.SliceStable(ranked, func(i, j int) bool { return ranked[i].rank < ranked[j].rank })
+	for _, r := range ranked {
+		q := byte('"')
+		if w.next(w.st.quotes, 1) == 1 {
+			q = '\''
+		}
+		gap := []string{" ", "  ", "\n" + pad}[w.next(w.st.gaps, 2)]
+		eq := []string{"=", " = "}[w.next(w.st.eqs, 3)]
+		sb.WriteString(gap + r.key + eq + string(q) + escAttr(e.attrs[r.key], q) + string(q))
+	}
+	if len(e.children) == 0 && e.text == "" {
+		switch w.next(w.st.empties, 4) {
+		case 1:
+			sb.WriteString("/>")
+			return sb.String()
+		case 2:
+			sb.WriteString(" />")
+			return sb.String()
+		}
+	}
+	sb.WriteString(">")
+	if len(e.children) > 0 {
+		pretty := w.next(w.st.pretty, 5) == 1
+		for _, ch := range e.children {
+			if pretty {
+				sb.WriteString("\n" + pad + "  ")
+			}
+			sb.WriteString(w.element(ch, indent+1, false))
+		}
+		if pretty {
+			sb.WriteString("\n" + pad)
+		}
+	} else {
+		sb.WriteString(w.text(e.text))
+	}
+	sb.WriteString("</" + name + ">")
+	return sb.String()
+}
+
+// renderXML spells the tree in the style: attribute order and quotes, whitespace between
+// children, self-closing tags, escapes, the namespace prefix for the prefixed elements.
+func renderXML(e xel, st xmlStyle) string {
+	w := &xmlWriter{st: st}
+	s := w.element(e, 0, true)
+	if st.decl {
+		s = `<?xml version="1.0" encoding="UTF-8"?>` + "\n" + s
+	}
+	return s
+}
+
+// xmlCase: a tree, a mutation of it for the second document, and a spelling per document.
+type xmlCase struct {
+	a      xel
+	edit   xelEdit
+	sa, sb xmlStyle
+}
+
+func (c xmlCase) b() xel { return c.edit.apply(c.a) }
+
+// GoString is what the draw report prints (it uses %#v): the two documents as rendered.
+func (c xmlCase) GoString() string {
+	return fmt.Sprintf("%s against %s", renderXML(c.a, c.sa), renderXML(c.b(), c.sb))
+}
+
+var (
+	xmlCases = hegel.Composite(func(tc hegel.TestCase) xmlCase {
+		return xmlCase{a: hegel.Draw(tc, xels), edit: hegel.Draw(tc, xelEdits), sa: hegel.Draw(tc, xmlStyles), sb: hegel.Draw(tc, xmlStyles)}
+	})
+	xmlBugs = []string{"gomega/7"}
+)
+
+// xmlModel: the documented equality of the two documents: the trees equal, whatever prefix
+// spells the namespace - a different prefix is a difference while the package's literal
+// comparison is on.
+func xmlModel(a, b xel, sa, sb xmlStyle, k known) bool {
+	return a.equal(b) && (!k.xmlPrefixLiteral || sa.prefix == sb.prefix)
+}
+
+// TestHegelXML: MatchXML says equal for two spellings of one tree (attribute order and quotes,
+// whitespace, self-closing tags, CDATA, character references, the namespace prefix) and not for
+// a tree with one element changed. It draws the shape of gomega/7 (the two documents spelling
+// the namespace with different prefixes).
+func TestHegelXML(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		xc := hegel.Draw(ht, xmlCases)
+		a, b := xc.a, xc.b()
+		sa, sb := renderXML(a, xc.sa), renderXML(b, xc.sb)
+		got := run(MatchXML(sb), sa)
+		want := func(k known) res { return res{ok: xmlModel(a, b, xc.sa, xc.sb, k)} }
+		if !judge(ht, c, xmlBugs, "MatchXML", got, want, "MatchXML(%s) on %s", sb, sa) {
+			return
+		}
+		c.count(fmt.Sprint("match ", got.ok))
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..5db6a2c
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,702 @@
+package hegel
+
+// Generators and models: values and their documented matcher semantics. Every model takes the
+// switch set it follows (known): Known for the run's verdict, other sets for explain.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+
+	. "github.com/onsi/gomega"
+	"github.com/onsi/gomega/types"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- numbers
+
+// num is a Go number with its exact value.
+type num struct {
+	v    any
+	x    *big.Rat // nil for NaN / Inf
+	kind string   // "int", "uint", "float"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (n num) GoString() string { return fmt.Sprintf("%T(%v)", n.v, n.v) }
+
+var (
+	intKinds   = []reflect.Kind{reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64}
+	uintKinds  = []reflect.Kind{reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64}
+	floatKinds = []reflect.Kind{reflect.Float64, reflect.Float32}
+	// allKinds: the kinds a number is drawn in, a third each of signed, unsigned and float
+	// (float64 twice as often as float32).
+	allKinds = append(append(append(append([]reflect.Kind{}, intKinds...), uintKinds...), reflect.Float64, reflect.Float64, reflect.Float64, reflect.Float64), reflect.Float32, reflect.Float32)
+)
+
+func family(k reflect.Kind) string {
+	switch {
+	case reflect.Int <= k && k <= reflect.Int64:
+		return "int"
+	case reflect.Uint <= k && k <= reflect.Uint64:
+		return "uint"
+	}
+	return "float"
+}
+
+// kindBits is the width of an integer kind.
+func kindBits(k reflect.Kind) int {
+	switch k {
+	case reflect.Int8, reflect.Uint8:
+		return 8
+	case reflect.Int16, reflect.Uint16:
+		return 16
+	case reflect.Int32, reflect.Uint32:
+		return 32
+	}
+	return 64
+}
+
+func kindRange(k reflect.Kind) (lo, hi int64) {
+	b := kindBits(k)
+	return -(int64(1) << (b - 1)), int64(1)<<(b-1) - 1
+}
+
+func kindMax(k reflect.Kind) uint64 {
+	if b := kindBits(k); b < 64 {
+		return uint64(1)<<b - 1
+	}
+	return math.MaxUint64
+}
+
+// intNum is v in the signed kind k (clamped into its range), with its exact value.
+func intNum(k reflect.Kind, v int64) num {
+	lo, hi := kindRange(k)
+	v = min(max(v, lo), hi)
+	rv := reflect.New(kindType(k)).Elem()
+	rv.SetInt(v)
+	return num{v: rv.Interface(), x: new(big.Rat).SetInt64(v), kind: "int"}
+}
+
+// uintNum is v in the unsigned kind k (clamped into its range), with its exact value.
+func uintNum(k reflect.Kind, v uint64) num {
+	v = min(v, kindMax(k))
+	rv := reflect.New(kindType(k)).Elem()
+	rv.SetUint(v)
+	return num{v: rv.Interface(), x: new(big.Rat).SetUint64(v), kind: "uint"}
+}
+
+// floatNum is f in the float kind k (a float32 beyond its range is clamped to it, so that no
+// infinity is drawn), with its exact value.
+func floatNum(k reflect.Kind, f float64) num {
+	if k == reflect.Float32 {
+		f32 := float32(f)
+		if math.IsInf(float64(f32), 0) {
+			f32 = float32(math.Copysign(math.MaxFloat32, f))
+		}
+		return num{v: f32, x: new(big.Rat).SetFloat64(float64(f32)), kind: "float"}
+	}
+	return num{v: f, x: new(big.Rat).SetFloat64(f), kind: "float"}
+}
+
+var kindTypes = map[reflect.Kind]reflect.Type{
+	reflect.Int: reflect.TypeOf(int(0)), reflect.Int8: reflect.TypeOf(int8(0)), reflect.Int16: reflect.TypeOf(int16(0)), reflect.Int32: reflect.TypeOf(int32(0)), reflect.Int64: reflect.TypeOf(int64(0)),
+	reflect.Uint: reflect.TypeOf(uint(0)), reflect.Uint8: reflect.TypeOf(uint8(0)), reflect.Uint16: reflect.TypeOf(uint16(0)), reflect.Uint32: reflect.TypeOf(uint32(0)), reflect.Uint64: reflect.TypeOf(uint64(0)),
+	reflect.Float32: reflect.TypeOf(float32(0)), reflect.Float64: reflect.TypeOf(float64(0)),
+}
+
+func kindType(k reflect.Kind) reflect.Type { return kindTypes[k] }
+
+// The special values of each family: the precision and sign boundaries.
+var (
+	intSpecials   = []int64{1 << 53, 1<<53 + 1, -(1 << 53) - 1, 1<<62 + 3, math.MaxInt32, math.MinInt32, 1e15 + 1}
+	uintSpecials  = []uint64{1 << 63, 1<<63 + 1, 1 << 53, 1<<53 + 1, math.MaxInt64, math.MaxInt64 + 1}
+	floatSpecials = []float64{-0.0, 0.5, -0.5, 1.5, 1e-9, 1e-8, 2e-8, 0.1, 0.3, 1 << 53, 1<<53 + 2, 1e18, 9.3e18, 1.9e19, -9.3e18, 1e300, -1e300, math.MaxFloat64}
+)
+
+// numSpec is the shape of a number: its kind and a value shape, rendered by value(): zero, a
+// small value, a wide one, one of the kind's specials, or the kind's minimum or maximum.
+type numSpec struct {
+	kind  reflect.Kind
+	shape string
+	k     int64 // the small or wide value, or the index into the specials
+}
+
+func (s numSpec) value() num {
+	switch family(s.kind) {
+	case "int":
+		lo, hi := kindRange(s.kind)
+		switch s.shape {
+		case "zero":
+			return intNum(s.kind, 0)
+		case "special":
+			v := intSpecials[int(s.k)%len(intSpecials)]
+			if v < lo || v > hi {
+				v = s.k // a special the kind cannot hold: a small value
+			}
+			return intNum(s.kind, v)
+		case "min":
+			return intNum(s.kind, lo)
+		case "max":
+			return intNum(s.kind, hi)
+		}
+		return intNum(s.kind, s.k)
+	case "uint":
+		switch s.shape {
+		case "zero":
+			return uintNum(s.kind, 0)
+		case "special":
+			v := uintSpecials[int(s.k)%len(uintSpecials)]
+			if v > kindMax(s.kind) {
+				v = uint64(s.k)
+			}
+			return uintNum(s.kind, v)
+		case "min":
+			return uintNum(s.kind, 0)
+		case "max":
+			return uintNum(s.kind, kindMax(s.kind))
+		}
+		return uintNum(s.kind, uint64(max(s.k, -s.k)))
+	}
+	switch s.shape {
+	case "zero":
+		return floatNum(s.kind, 0)
+	case "small":
+		return floatNum(s.kind, float64(s.k))
+	case "wide":
+		return floatNum(s.kind, float64(s.k)/8)
+	case "special":
+		return floatNum(s.kind, floatSpecials[int(s.k)%len(floatSpecials)])
+	case "min":
+		return floatNum(s.kind, -math.MaxFloat64)
+	}
+	return floatNum(s.kind, math.MaxFloat64)
+}
+
+// numSpecs: a number of any kind, zero and small values first.
+var numSpecs = hegel.FlatMap(hegel.SampledFrom(allKinds), func(k reflect.Kind) hegel.Generator[numSpec] {
+	of := func(shape string) func(int64) numSpec {
+		return func(v int64) numSpec { return numSpec{kind: k, shape: shape, k: v} }
+	}
+	return weighted(
+		choice[numSpec]{15, hegel.Just(numSpec{kind: k, shape: "zero"})},
+		choice[numSpec]{30, hegel.Map(hegel.Integers[int64](-5, 5), of("small"))},
+		choice[numSpec]{25, hegel.Map(hegel.Integers[int64](-1000, 1000), of("wide"))},
+		choice[numSpec]{15, hegel.Map(hegel.Integers[int64](0, 20), of("special"))},
+		choice[numSpec]{8, hegel.Just(numSpec{kind: k, shape: "min"})},
+		choice[numSpec]{7, hegel.Just(numSpec{kind: k, shape: "max"})},
+	)
+})
+
+// near is a number of a's kind at distance d from a, in the kind's wrapping arithmetic (so that
+// int64's ends meet, the shape of gomega/2); a float moves by d/4.
+func near(a num, d int64) num {
+	rv := reflect.ValueOf(a.v)
+	switch a.kind {
+	case "int":
+		v := rv.Int() + d
+		if b := kindBits(rv.Kind()); b < 64 {
+			v = int64(v<<(64-b)) >> (64 - b) // wrap into the kind's width
+		}
+		return intNum(rv.Kind(), v)
+	case "uint":
+		v := rv.Uint() + uint64(d)
+		if b := kindBits(rv.Kind()); b < 64 {
+			v &= uint64(1)<<b - 1
+		}
+		return uintNum(rv.Kind(), v)
+	}
+	return floatNum(rv.Kind(), rv.Float()+float64(d)/4)
+}
+
+// cross is a's value plus d in the other family: an integer becomes the float64 of the sum (which
+// rounds beyond 2^53, the shape of gomega/3), a float the integer of the sum when it is integral
+// and fits a Go integer.
+func cross(a num, d int64) num {
+	rv := reflect.ValueOf(a.v)
+	switch a.kind {
+	case "int":
+		return floatNum(reflect.Float64, float64(rv.Int()+d))
+	case "uint":
+		return floatNum(reflect.Float64, float64(rv.Uint()+uint64(d)))
+	}
+	f := rv.Float()
+	if f != math.Trunc(f) {
+		return a
+	}
+	if f >= math.MinInt64 && f < math.MaxInt64 {
+		return intNum(reflect.Int64, int64(f)+d)
+	}
+	if f >= 0 && f < math.MaxUint64 {
+		return uintNum(reflect.Uint64, uint64(f)+uint64(d))
+	}
+	return a
+}
+
+// bitcast is a's bits in the other signedness of the same width (-1 as the unsigned maximum, the
+// shape of gomega/1); a float is unchanged.
+func bitcast(a num) num {
+	rv := reflect.ValueOf(a.v)
+	switch a.kind {
+	case "int":
+		u := map[reflect.Kind]reflect.Kind{reflect.Int: reflect.Uint, reflect.Int8: reflect.Uint8, reflect.Int16: reflect.Uint16, reflect.Int32: reflect.Uint32, reflect.Int64: reflect.Uint64}[rv.Kind()]
+		return uintNum(u, uint64(rv.Int())&kindMax(u))
+	case "uint":
+		i := map[reflect.Kind]reflect.Kind{reflect.Uint: reflect.Int, reflect.Uint8: reflect.Int8, reflect.Uint16: reflect.Int16, reflect.Uint32: reflect.Int32, reflect.Uint64: reflect.Int64}[rv.Kind()]
+		b := kindBits(i)
+		return intNum(i, int64(rv.Uint()<<(64-b))>>(64-b))
+	}
+	return a
+}
+
+// numRel says how the number compared to relates to the actual: the same, near it, another
+// number, across the integer/float line, or its bits in the other signedness.
+type numRel struct {
+	rel  string
+	d    int64
+	spec numSpec
+}
+
+func (r numRel) of(a num) num {
+	switch r.rel {
+	case "near":
+		return near(a, r.d)
+	case "other":
+		return r.spec.value()
+	case "cross":
+		return cross(a, r.d)
+	case "bitcast":
+		return bitcast(a)
+	}
+	return a
+}
+
+var numRels = weighted(
+	choice[numRel]{30, hegel.Just(numRel{rel: "same"})},
+	choice[numRel]{25, hegel.Map(hegel.Integers[int64](-10, 10), func(d int64) numRel { return numRel{rel: "near", d: d} })},
+	choice[numRel]{25, hegel.Map(numSpecs, func(s numSpec) numRel { return numRel{rel: "other", spec: s} })},
+	choice[numRel]{10, hegel.Map(hegel.Integers[int64](-2, 2), func(d int64) numRel { return numRel{rel: "cross", d: d} })},
+	choice[numRel]{10, hegel.Just(numRel{rel: "bitcast"})},
+)
+
+// thresholds: none most of the time, else a small int or a number of any kind.
+var thresholds = weighted(
+	choice[*num]{60, hegel.Just[*num](nil)},
+	choice[*num]{20, hegel.Map(hegel.Integers[int64](0, 20), func(v int64) *num { n := intNum(reflect.Int, v); return &n })},
+	choice[*num]{20, hegel.Map(numSpecs, func(s numSpec) *num { n := s.value(); return &n })},
+)
+
+var comparators = hegel.SampledFrom([]string{"==", "~", ">", ">=", "<", "<="})
+
+// numCase is one BeNumerically call: the actual a, the comparator, the number compared to and
+// an optional threshold.
+type numCase struct {
+	a, c num
+	cmp  string
+	th   *num
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (nc numCase) GoString() string {
+	return fmt.Sprintf("BeNumerically(%s, %#v, %s) on %#v", nc.cmp, nc.c, thDesc(nc.th), nc.a)
+}
+
+func (nc numCase) matcher() types.GomegaMatcher {
+	if nc.th != nil {
+		return BeNumerically(nc.cmp, nc.c.v, nc.th.v)
+	}
+	return BeNumerically(nc.cmp, nc.c.v)
+}
+
+func thDesc(t *num) string {
+	if t == nil {
+		return "no threshold"
+	}
+	return fmt.Sprintf("threshold %T %v", t.v, t.v)
+}
+
+var numCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+	a := hegel.Draw(tc, numSpecs).value()
+	return numCase{a: a, c: hegel.Draw(tc, numRels).of(a), cmp: hegel.Draw(tc, comparators), th: hegel.Draw(tc, thresholds)}
+})
+
+func isFloatKind(v any) bool {
+	k := reflect.TypeOf(v).Kind()
+	return k == reflect.Float32 || k == reflect.Float64
+}
+
+func toF(v any) float64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Float32, reflect.Float64:
+		return rv.Float()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return float64(rv.Uint())
+	}
+	return float64(rv.Int())
+}
+
+// toI and toU convert as the package does (a float is truncated)
+func toI(v any) int64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return int64(rv.Uint())
+	case reflect.Float32, reflect.Float64:
+		return int64(rv.Float())
+	}
+	return rv.Int()
+}
+
+func toU(v any) uint64 {
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return rv.Uint()
+	case reflect.Float32, reflect.Float64:
+		return uint64(rv.Float())
+	}
+	return uint64(rv.Int())
+}
+
+func ratI(v int64) *big.Rat  { return new(big.Rat).SetInt64(v) }
+func ratU(v uint64) *big.Rat { return new(big.Rat).SetUint64(v) }
+
+// modelNumerically is BeNumerically as documented: the numbers compared by value, whatever
+// their types, == exact and ~ within the threshold (0 for integers, 1e-8 when a float is
+// involved); the recorded deviations behind the switches of k.
+func modelNumerically(cmp string, a, c num, t *num, k known) bool {
+	floats := a.kind == "float" || c.kind == "float"
+	if k.intFloatRounding && floats {
+		// the package compares as float64 when either side is a float
+		af, cf := toF(a.v), toF(c.v)
+		th := 1e-8
+		if t != nil {
+			th = toF(t.v)
+		}
+		switch cmp {
+		case "~":
+			return math.Abs(af-cf) <= th
+		case "==":
+			return af == cf
+		case ">":
+			return af > cf
+		case ">=":
+			return af >= cf
+		case "<":
+			return af < cf
+		}
+		return af <= cf
+	}
+	if a.x == nil || c.x == nil || (t != nil && t.x == nil) {
+		return false // NaN or an infinity: never drawn
+	}
+	ax, cx := a.x, c.x
+	var tx *big.Rat
+	if t != nil {
+		tx = t.x
+	}
+	if !floats && k.mixedSignConversion {
+		// every argument is converted to the actual's integer kind (a float threshold truncated)
+		if a.kind == "int" {
+			ax, cx = ratI(toI(a.v)), ratI(toI(c.v))
+			if t != nil {
+				tx = ratI(toI(t.v))
+			}
+		} else {
+			ax, cx = ratU(toU(a.v)), ratU(toU(c.v))
+			if t != nil {
+				tx = ratU(toU(t.v))
+			}
+		}
+	}
+	if !floats && k.intDiffOverflow && a.kind == "int" && (c.kind == "int" || k.mixedSignConversion) && (cmp == "==" || cmp == "~") {
+		// the difference of two integers is taken in int64 and wraps
+		ax, cx = ratI(toI(a.v)-toI(c.v)), ratI(0)
+	}
+	if cmp == "==" && tx != nil && k.equalsThresholdInts && !floats {
+		cmp = "~" // the package applies the threshold to == on integers
+	}
+	r := ax.Cmp(cx)
+	switch cmp {
+	case "==":
+		return r == 0
+	case "~":
+		th := new(big.Rat)
+		if tx != nil {
+			th = tx
+		} else if floats {
+			th.SetFloat64(1e-8)
+		}
+		d := new(big.Rat).Sub(ax, cx)
+		d.Abs(d)
+		return d.Cmp(th) <= 0
+	case ">":
+		return r > 0
+	case ">=":
+		return r >= 0
+	case "<":
+		return r < 0
+	}
+	return r <= 0
+}
+
+// --------------------------------------------------------------------------- values and matchers
+
+type pt struct{ X int }
+
+// elems: a small value of a mixed pool: ints first, then strings, nil, a one-int slice, a
+// struct, a byte slice (nil one time in five) and a float.
+var (
+	elemStrings = hegel.SampledFrom([]string{"a", "ab", "b", "", "abc"})
+	byteSlices  = weighted(
+		choice[[]byte]{20, hegel.Just[[]byte](nil)},
+		choice[[]byte]{80, hegel.Map(hegel.SampledFrom([]string{"a", "ab", ""}), func(s string) []byte { return []byte(s) })},
+	)
+	elems = weighted(
+		choice[any]{30, asAny(hegel.Integers(0, 4))},
+		choice[any]{20, asAny(elemStrings)},
+		choice[any]{10, hegel.Just[any](nil)},
+		choice[any]{10, asAny(hegel.Map(hegel.Integers(0, 2), func(k int) []int { return []int{k} }))},
+		choice[any]{10, asAny(hegel.Map(hegel.Integers(0, 2), func(k int) pt { return pt{k} }))},
+		choice[any]{10, asAny(byteSlices)},
+		choice[any]{10, asAny(hegel.Map(hegel.Integers(0, 4), func(k int) float64 { return float64(k) }))},
+	)
+)
+
+// expectation: an element of a collection matcher's argument list with its model.
+type expectation struct {
+	arg   any
+	label string
+	// match reports whether the element matches and whether the matcher would error on it
+	match func(e any, k known) (ok bool, errs bool)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (e expectation) GoString() string { return e.label }
+
+// equalModel is Equal(v): reflect.DeepEqual, an error when both sides are nil; two byte slices
+// compared with bytes.Equal while equalBytesSpecial is on.
+func equalModel(v any) func(any, known) (bool, bool) {
+	return func(e any, k known) (bool, bool) {
+		if v == nil {
+			return false, e == nil
+		}
+		if e == nil {
+			return false, false
+		}
+		if k.equalBytesSpecial {
+			if eb, ok := e.([]byte); ok {
+				if vb, ok := v.([]byte); ok {
+					return bytes.Equal(eb, vb), false
+				}
+			}
+		}
+		return reflect.DeepEqual(e, v), false
+	}
+}
+
+// elemExpectation is a plain value among a collection matcher's arguments: Equal(v), or BeNil
+// for a nil (the documented reading of a nil element).
+func elemExpectation(v any) expectation {
+	if v == nil {
+		return expectation{arg: nil, label: "nil", match: func(e any, _ known) (bool, bool) { return isNilValue(e), false }}
+	}
+	return expectation{arg: v, label: fmt.Sprintf("%#v", v), match: equalModel(v)}
+}
+
+func isNilValue(a any) bool {
+	if a == nil {
+		return true
+	}
+	switch reflect.TypeOf(a).Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return reflect.ValueOf(a).IsNil()
+	}
+	return false
+}
+
+func isNumberValue(a any) bool {
+	if a == nil {
+		return false
+	}
+	k := reflect.TypeOf(a).Kind()
+	return reflect.Int <= k && k <= reflect.Float64 && k != reflect.Uintptr
+}
+
+func stringOf(a any) (string, bool) {
+	switch s := a.(type) {
+	case string:
+		return s, true
+	case []byte:
+		return string(s), true
+	case fmt.Stringer:
+		return s.String(), true
+	}
+	return "", false
+}
+
+// The matcher expectations and their models.
+func numericallyAbove(k int) expectation {
+	return expectation{arg: BeNumerically(">", k), label: fmt.Sprintf("BeNumerically(>, %d)", k), match: func(e any, _ known) (bool, bool) {
+		if !isNumberValue(e) {
+			return false, true
+		}
+		return toF(e) > float64(k), false
+	}}
+}
+
+func havePrefix(p string) expectation {
+	return expectation{arg: HavePrefix(p), label: fmt.Sprintf("HavePrefix(%q)", p), match: func(e any, _ known) (bool, bool) {
+		s, ok := stringOf(e)
+		if !ok {
+			return false, true
+		}
+		return strings.HasPrefix(s, p), false
+	}}
+}
+
+var beNil = expectation{arg: BeNil(), label: "BeNil()", match: func(e any, _ known) (bool, bool) { return isNilValue(e), false }}
+
+func notEqual(v any) expectation {
+	eq := equalModel(v)
+	return expectation{arg: Not(Equal(v)), label: fmt.Sprintf("Not(Equal(%#v))", v), match: func(e any, k known) (bool, bool) {
+		if e == nil && v == nil {
+			return false, true
+		}
+		ok, errs := eq(e, k)
+		return !ok, errs
+	}}
+}
+
+func haveLen(n int) expectation {
+	return expectation{arg: HaveLen(n), label: fmt.Sprintf("HaveLen(%d)", n), match: func(e any, _ known) (bool, bool) {
+		if e == nil {
+			return false, true
+		}
+		switch reflect.TypeOf(e).Kind() {
+		case reflect.String, reflect.Slice, reflect.Array, reflect.Map:
+			return reflect.ValueOf(e).Len() == n, false
+		}
+		return false, true
+	}}
+}
+
+var beZero = expectation{arg: BeZero(), label: "BeZero()", match: func(e any, _ known) (bool, bool) {
+	if e == nil {
+		return true, false
+	}
+	return reflect.DeepEqual(reflect.Zero(reflect.TypeOf(e)).Interface(), e), false
+}}
+
+// expectations: a plain value most of the time, else one of the matchers.
+var expectations = weighted(
+	choice[expectation]{40, hegel.Map(elems, elemExpectation)},
+	choice[expectation]{10, hegel.Map(hegel.Integers(0, 3), numericallyAbove)},
+	choice[expectation]{10, hegel.Map(hegel.SampledFrom([]string{"a", "ab", ""}), havePrefix)},
+	choice[expectation]{10, hegel.Just(beNil)},
+	choice[expectation]{10, hegel.Map(elems, notEqual)},
+	choice[expectation]{10, hegel.Map(hegel.Integers(0, 2), haveLen)},
+	choice[expectation]{10, hegel.Just(beZero)},
+)
+
+// maxMatching is the size of a maximum bipartite matching (Kuhn's algorithm).
+func maxMatching(adj [][]bool, nRight int) int {
+	matchR := make([]int, nRight)
+	for i := range matchR {
+		matchR[i] = -1
+	}
+	var try func(l int, seen []bool) bool
+	try = func(l int, seen []bool) bool {
+		for r := 0; r < nRight; r++ {
+			if !adj[l][r] || seen[r] {
+				continue
+			}
+			seen[r] = true
+			if matchR[r] < 0 || try(matchR[r], seen) {
+				matchR[r] = l
+				return true
+			}
+		}
+		return false
+	}
+	n := 0
+	for l := range adj {
+		if try(l, make([]bool, nRight)) {
+			n++
+		}
+	}
+	return n
+}
+
+func args(es []expectation) []any {
+	out := make([]any, len(es))
+	for i, e := range es {
+		out[i] = e.arg
+	}
+	return out
+}
+
+func labels(es []expectation) string {
+	var ls []string
+	for _, e := range es {
+		ls = append(ls, e.label)
+	}
+	return "[" + strings.Join(ls, ", ") + "]"
+}
+
+// result of a Match call
+type res struct {
+	ok  bool
+	err string
+}
+
+func run(m types.GomegaMatcher, actual any) (r res) {
+	defer func() {
+		if p := recover(); p != nil {
+			r = res{err: fmt.Sprint("panic: ", p)}
+		}
+	}()
+	ok, err := m.Match(actual)
+	if err != nil {
+		return res{err: err.Error()}
+	}
+	return res{ok: ok}
+}
+
+func (r res) String() string {
+	if r.err != "" {
+		return "error(" + strings.SplitN(r.err, "\n", 2)[0] + ")"
+	}
+	return strconv.FormatBool(r.ok)
+}
+
+func (r res) same(o res) bool {
+	return (r.err != "") == (o.err != "") && (r.err != "" || r.ok == o.ok)
+}
+
+// verdicts runs a matcher once per distinct case and replays the result on the shrinker's
+// revisits: the key matchers' answers depend on the map's iteration order (gomega/4, /12), and
+// a verdict that changes on replay reads as a flaky test to Hegel.
+type verdicts struct {
+	mu sync.Mutex
+	m  map[string]res
+}
+
+func newVerdicts() *verdicts { return &verdicts{m: map[string]res{}} }
+
+func (v *verdicts) run(key string, m types.GomegaMatcher, actual any) res {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if r, ok := v.m[key]; ok {
+		return r
+	}
+	r := run(m, actual)
+	v.m[key] = r
+	return r
+}
