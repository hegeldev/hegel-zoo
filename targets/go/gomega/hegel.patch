+// --------------------------------------------------------------------------- gomega/7
+
+// prefixPair: one tree, two spellings whose namespace prefixes differ (the shape of gomega/7),
+// or are the same under HEGEL_NO_KNOWN=1.
+type prefixPair struct {
+	a      xel
+	sa, sb xmlStyle
+}
+
+var (
+	prefixPool  = []string{"p", "q", "ns", "x1"}
+	prefixPairs = hegel.Composite(func(tc hegel.TestCase) prefixPair {
+		pp := prefixPair{a: hegel.Draw(tc, xels), sa: hegel.Draw(tc, xmlStyles), sb: hegel.Draw(tc, xmlStyles)}
+		i := hegel.Draw(tc, hegel.Integers(0, 3))
