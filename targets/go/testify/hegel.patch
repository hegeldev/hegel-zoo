+func TestHegelInDeltaRejectsANaNDelta(t *testing.T) {
+	c := newCollector(t)
+	nanCases := deltaCasesWith(shaped(hegel.Just(math.NaN()), hegel.SampledFrom(deltaPool)))
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, nanCases)
+		a, b, delta := cs.a, cs.b, cs.delta
+		shape := shapeIf(math.IsNaN(delta), "testify/10")
+		want := modelInDelta(a.f, b.f, delta)
+		c.count("delta=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%#v, %#v, %v)", a, b, delta)
+		if !expect(c, ht, "InDelta"+name, want, func(t assert.TestingT) bool { return assert.InDelta(t, a.v, b.v, delta) }, shape...) {
+			return
