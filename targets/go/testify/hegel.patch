+		s1, s2 := serialise(doc, &tape{vals: cs.t1}), serialise(doc, &tape{vals: cs.t2})
+		s3 := serialise(mutate(doc, &tape{vals: cs.t2}), &tape{vals: cs.t1})
+		c.count(fmt.Sprintf("%T", cs.n))
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, %s)", s1, s2), true, func(t assert.TestingT) bool { return assert.JSONEq(t, s1, s2) }, shape...) {
+			return
+		}
