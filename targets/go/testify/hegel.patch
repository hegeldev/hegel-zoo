+// --------------------------------------------------------------------------- testify/3
+
+// roundingCase: a float (the expected value, at least as wide as the integer) and an integer
+// the float type cannot hold exactly (the shape of testify/3: rounded to the float type), half
+// of the time the float being the rounded integer; under HEGEL_NO_KNOWN=1 the integer is small.
+type roundingCase struct {
+	a, b num
+}
+
+func (c roundingCase) GoString() string { return fmt.Sprintf("%#v, %#v", c.a, c.b) }
+
+var roundingCases = hegel.Composite(func(tc hegel.TestCase) roundingCase {
+	fi := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool { return t.float })))
+	tf := numTypes[fi]
+	inexact := func(t numType) []num { return poolWhere(t, func(x *big.Float) bool { return !tf.exactly(x) }) }
+	ii := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool {
+		return !t.float && t.bits <= tf.bits && len(inexact(t)) > 0
+	})))
+	ti := numTypes[ii]
+	b := hegel.Draw(tc, shaped(hegel.SampledFrom(inexact(ti)), numGens[ii][integralPool]))
+	rounded := exactOf(0)
+	if f, _ := b.exact.Float64(); tf.bits == 32 {
+		rounded = exactOf(float64(float32(f)))
+	} else {
+		rounded = exactOf(f)
+	}
+	a := hegel.Draw(tc, shaped(
+		weighted(choice[num]{50, numGens[fi][fullPool]}, choice[num]{50, hegel.Just(num{tf.value(rounded), rounded})}),
+		numGens[fi][integralPool]))
+	return roundingCase{a, b}
+})
+
+// TestHegelEqualValuesIsSymmetricOnRoundedIntegers: EqualValues on a float and an integer is
+// exact comparison either way round; testify/3 rounds the integer to the float type when the
+// float is the expected value, so float32(16777216) equals int32(16777217) in that order only.
+func TestHegelEqualValuesIsSymmetricOnRoundedIntegers(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, roundingCases)
+		c.count(fmt.Sprintf("%T/%T", cs.a.v, cs.b.v))
+		checkEqualValues(c, ht, cs.a, cs.b, known("testify/3"))
+		checkEqualValues(c, ht, cs.b, cs.a, known("testify/3"))
+		fwd, back := assert.ObjectsAreEqualValues(cs.a.v, cs.b.v), assert.ObjectsAreEqualValues(cs.b.v, cs.a.v)
+		if fwd != back {
+			c.mismatch(ht, known("testify/3"), "ObjectsAreEqualValues(%#v, %#v) = %v but %v the other way round", cs.a, cs.b, fwd, back)
+		}
+	})
+}
