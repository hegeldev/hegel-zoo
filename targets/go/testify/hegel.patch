+var (
+	zeroArrays = hegel.Map(hegel.Integers(1, 3), func(k int) any {
+		return reflect.New(reflect.ArrayOf(k, reflect.TypeOf(0))).Elem().Interface()
+	})
+	nonEmptyLists  = hegel.SampledFrom([]any{[]int{0}, [1]int{1}, []int{0, 0}, [2]int{1, 0}, [3]int{0, 0, 1}})
+	emptyLists     = hegel.SampledFrom([]any{[]int{}, []int(nil), [0]int{}})
+	zeroArrayCases = hegel.Map(pairs(shaped(zeroArrays, nonEmptyLists), emptyLists), func(p pair[any, any]) zeroArrayCase {
+		return zeroArrayCase{p.a, p.b}
+	})
+)
+
+// TestHegelElementsMatchCountsZeroElements: a list with elements does not ElementsMatch an
+// empty one, whatever the elements' values; testify/18 matches an array of zeros with an empty
+// list.
+func TestHegelElementsMatchCountsZeroElements(t *testing.T) {
