+// testify/18: an array of zero values has elements; it does not match an empty list.
+func TestHegelPinElementsMatchZeroArray(t *testing.T) {
+	pinExpect(t, "ElementsMatch([1]int{0}, []int{})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [1]int{0}, []int{}) })
+	pinExpect(t, "ElementsMatch([2]int{}, [1]int{})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [2]int{}, [1]int{}) })
+	pinExpect(t, "NotElementsMatch([1]int{0}, []int{})", true, func(m assert.TestingT) bool { return assert.NotElementsMatch(m, [1]int{0}, []int{}) })
+	pinExpect(t, "ElementsMatch([1]int{0}, []int{0})", true, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [1]int{0}, []int{0}) })
+}
