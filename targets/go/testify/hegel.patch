+package assert_test
+
+// One narrow property per recorded bug (bugs.toml): each draws the bug's shape region and fails
+// there naming the bug, so it is an expected failure mapped to it; under HEGEL_NO_KNOWN=1 it
+// draws the neighbouring region (shaped) and passes. The pins in hegel_pins_test.go hold the
+// single regression examples.
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
