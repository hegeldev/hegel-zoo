@@ -0,0 +1,355 @@
+package assert_test
+
+// Ordering and closeness: Greater, GreaterOrEqual, Less, LessOrEqual, Positive, Negative,
+// IsIncreasing, IsNonIncreasing, IsDecreasing, IsNonDecreasing, WithinDuration, WithinRange,
+// InDelta, InEpsilon, InDeltaSlice, InDeltaMapValues, InEpsilonSlice.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+type ordType struct {
+	name    string
+	typ     reflect.Type
+	numeric bool
+	gen     func(tc hegel.TestCase) any
+	cmp     func(a, b any) int
+}
+
+func cmpInt(a, b int64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+var baseTime = time.Date(2026, 9, 21, 0, 0, 0, 0, time.UTC)
+
+var ordTypes = []ordType{
+	{"int", reflect.TypeOf(0), true,
+		func(tc hegel.TestCase) any { return n(tc, -2, 2) },
+		func(a, b any) int { return cmpInt(int64(a.(int)), int64(b.(int))) }},
+	{"int64", reflect.TypeOf(int64(0)), true,
+		func(tc hegel.TestCase) any { return int64(pick(tc, []int{-1, 0, 1, math.MaxInt32})) },
+		func(a, b any) int { return cmpInt(a.(int64), b.(int64)) }},
+	{"uint8", reflect.TypeOf(uint8(0)), true,
+		func(tc hegel.TestCase) any { return uint8(pick(tc, []int{0, 1, 2, 255})) },
+		func(a, b any) int { return cmpInt(int64(a.(uint8)), int64(b.(uint8))) }},
+	{"myInt", reflect.TypeOf(myInt(0)), true,
+		func(tc hegel.TestCase) any { return myInt(n(tc, -2, 2)) },
+		func(a, b any) int { return cmpInt(int64(a.(myInt)), int64(b.(myInt))) }},
+	{"float64", reflect.TypeOf(0.0), true,
+		func(tc hegel.TestCase) any { return pick(tc, []float64{-1.5, 0, 0.5, 1, 1e300}) },
+		func(a, b any) int {
+			x, y := a.(float64), b.(float64)
+			switch {
+			case x < y:
+				return -1
+			case x > y:
+				return 1
+			}
+			return 0
+		}},
+	{"float32", reflect.TypeOf(float32(0)), true,
+		func(tc hegel.TestCase) any { return float32(pick(tc, []float64{-1.5, 0, 0.5, 1})) },
+		func(a, b any) int {
+			x, y := a.(float32), b.(float32)
+			switch {
+			case x < y:
+				return -1
+			case x > y:
+				return 1
+			}
+			return 0
+		}},
+	{"duration", reflect.TypeOf(time.Duration(0)), true,
+		func(tc hegel.TestCase) any { return time.Duration(n(tc, -1, 2)) * time.Second },
+		func(a, b any) int { return cmpInt(int64(a.(time.Duration)), int64(b.(time.Duration))) }},
+	{"string", reflect.TypeOf(""), false,
+		func(tc hegel.TestCase) any { return pick(tc, []string{"", "a", "ab", "b", "B"}) },
+		func(a, b any) int { return strings.Compare(a.(string), b.(string)) }},
+	{"bytes", reflect.TypeOf([]byte{}), false,
+		func(tc hegel.TestCase) any { return []byte(pick(tc, []string{"", "a", "ab", "b"})) },
+		func(a, b any) int { return bytes.Compare(a.([]byte), b.([]byte)) }},
+	{"time", reflect.TypeOf(time.Time{}), false,
+		func(tc hegel.TestCase) any { return baseTime.Add(time.Duration(n(tc, -1, 2)) * time.Hour) },
+		func(a, b any) int {
+			x, y := a.(time.Time), b.(time.Time)
+			switch {
+			case x.Before(y):
+				return -1
+			case x.After(y):
+				return 1
+			}
+			return 0
+		}},
+}
+
+// TestHegelOrderingFollowsTheModel: Greater & co on two values of one ordered type agree with
+// the type's ordering (GreaterOrEqual = Greater or equal, Less = Greater swapped); two values of
+// different kinds fail; Positive/Negative are Greater/Less than zero; IsIncreasing & co on a
+// slice or array hold exactly when every adjacent pair does.
+func TestHegelOrderingFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ot := pick(ht, ordTypes)
+		a, b := ot.gen(ht), ot.gen(ht)
+		if chance(ht, 15) {
+			// different kinds: every comparison fails
+			other := pick(ht, ordTypes)
+			if other.typ.Kind() == ot.typ.Kind() {
+				return
+			}
+			b = other.gen(ht)
+			name := fmt.Sprintf("(%T, %T)", a, b)
+			c.count("cross-kind")
+			for _, f := range []struct {
+				n string
+				f func(t assert.TestingT) bool
+			}{
+				{"Greater", func(t assert.TestingT) bool { return assert.Greater(t, a, b) }},
+				{"GreaterOrEqual", func(t assert.TestingT) bool { return assert.GreaterOrEqual(t, a, b) }},
+				{"Less", func(t assert.TestingT) bool { return assert.Less(t, a, b) }},
+				{"LessOrEqual", func(t assert.TestingT) bool { return assert.LessOrEqual(t, a, b) }},
+			} {
+				if !expect(c, ht, f.n+name, false, f.f) {
+					return
+				}
+			}
+			return
+		}
+		cmp := ot.cmp(a, b)
+		c.count(ot.name + "=" + strconv.Itoa(cmp))
+		name := fmt.Sprintf("(%s %v, %v)", ot.name, a, b)
+		if !expect(c, ht, "Greater"+name, cmp > 0, func(t assert.TestingT) bool { return assert.Greater(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "GreaterOrEqual"+name, cmp >= 0, func(t assert.TestingT) bool { return assert.GreaterOrEqual(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Less"+name, cmp < 0, func(t assert.TestingT) bool { return assert.Less(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "LessOrEqual"+name, cmp <= 0, func(t assert.TestingT) bool { return assert.LessOrEqual(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Less(b,a)"+name, cmp > 0, func(t assert.TestingT) bool { return assert.Less(t, b, a) }) {
+			return
+		}
+		if ot.numeric || !Known.positiveStrings {
+			zero := reflect.Zero(ot.typ).Interface()
+			cz := ot.cmp(a, zero)
+			if !expect(c, ht, "Positive"+name, cz > 0, func(t assert.TestingT) bool { return assert.Positive(t, a) }) {
+				return
+			}
+			if !expect(c, ht, "Negative"+name, cz < 0, func(t assert.TestingT) bool { return assert.Negative(t, a) }) {
+				return
+			}
+		}
+		// ordered collections
+		k := n(ht, 0, 5)
+		s := reflect.MakeSlice(reflect.SliceOf(ot.typ), k, k)
+		inc, noninc, dec, nondec := true, true, true, true
+		var prev any
+		for i := 0; i < k; i++ {
+			v := ot.gen(ht)
+			if i > 0 {
+				d := ot.cmp(prev, v)
+				inc = inc && d < 0
+				nondec = nondec && d <= 0
+				dec = dec && d > 0
+				noninc = noninc && d >= 0
+			}
+			s.Index(i).Set(reflect.ValueOf(v))
+			prev = v
+		}
+		coll := s.Interface()
+		if chance(ht, 30) {
+			arr := reflect.New(reflect.ArrayOf(k, ot.typ)).Elem()
+			reflect.Copy(arr, s)
+			coll = arr.Interface()
+		}
+		cn := fmt.Sprintf("(%s %v)", ot.name, coll)
+		if !expect(c, ht, "IsIncreasing"+cn, inc, func(t assert.TestingT) bool { return assert.IsIncreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsNonIncreasing"+cn, noninc, func(t assert.TestingT) bool { return assert.IsNonIncreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsDecreasing"+cn, dec, func(t assert.TestingT) bool { return assert.IsDecreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsNonDecreasing"+cn, nondec, func(t assert.TestingT) bool { return assert.IsNonDecreasing(t, coll) }) {
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- times
+
+// TestHegelTimeWindowsFollowTheModel: WithinDuration holds exactly when |a-b| <= delta and is
+// symmetric; WithinRange holds exactly when start <= t <= end (and fails when end < start).
+func TestHegelTimeWindowsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := baseTime.Add(time.Duration(n(ht, -5, 5)) * time.Second)
+		b := baseTime.Add(time.Duration(n(ht, -5, 5)) * time.Second)
+		delta := time.Duration(n(ht, 0, 5)) * time.Second
+		diff := a.Sub(b)
+		if diff < 0 {
+			diff = -diff
+		}
+		want := diff <= delta
+		c.count("within=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%v, %v, %v)", a, b, delta)
+		if !expect(c, ht, "WithinDuration"+name, want, func(t assert.TestingT) bool { return assert.WithinDuration(t, a, b, delta) }) {
+			return
+		}
+		if !expect(c, ht, "WithinDuration(b,a)"+name, want, func(t assert.TestingT) bool { return assert.WithinDuration(t, b, a, delta) }) {
+			return
+		}
+		start := baseTime.Add(time.Duration(n(ht, -5, 5)) * time.Second)
+		end := baseTime.Add(time.Duration(n(ht, -5, 5)) * time.Second)
+		wantR := !end.Before(start) && !a.Before(start) && !a.After(end)
+		expect(c, ht, fmt.Sprintf("WithinRange(%v, %v, %v)", a, start, end), wantR, func(t assert.TestingT) bool { return assert.WithinRange(t, a, start, end) })
+	})
+}
+
+// --------------------------------------------------------------------------- deltas
+
+// genFloatish: a number of a numeric type accepted by InDelta, and its float64 value.
+func genFloatish(tc hegel.TestCase) (any, float64) {
+	f := pick(tc, []float64{0, 1, -1, 2.5, 0.1, 0.3, 100, 1e10, -3, 0.25})
+	if chance(tc, 10) {
+		f = math.NaN()
+	}
+	switch n(tc, 0, 4) {
+	case 0:
+		if f == math.Trunc(f) && !math.IsNaN(f) && math.Abs(f) < 1e9 {
+			return int(f), f
+		}
+	case 1:
+		if f == math.Trunc(f) && f >= 0 && !math.IsNaN(f) && math.Abs(f) < 1e9 {
+			return uint32(f), f
+		}
+	case 2:
+		f32 := float32(f)
+		return f32, float64(f32)
+	case 3:
+		if f == math.Trunc(f) && !math.IsNaN(f) && math.Abs(f) < 1e9 {
+			return time.Duration(f), f
+		}
+	}
+	return f, f
+}
+
+func modelInDelta(a, b, delta float64) bool {
+	if math.IsNaN(a) && math.IsNaN(b) {
+		return true
+	}
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return false
+	}
+	return math.Abs(a-b) <= delta
+}
+
+func modelInEpsilon(a, b, eps float64) bool {
+	if math.IsNaN(eps) {
+		return false
+	}
+	if math.IsNaN(a) && math.IsNaN(b) {
+		return true
+	}
+	if math.IsNaN(a) || math.IsNaN(b) || a == 0 {
+		return false
+	}
+	return math.Abs(a-b)/math.Abs(a) <= eps
+}
+
+// TestHegelDeltasFollowTheModel: InDelta holds exactly when |a-b| <= delta (NaN equals NaN
+// only), symmetric; InEpsilon when the relative error is at most epsilon; InDeltaSlice,
+// InEpsilonSlice and InDeltaMapValues hold exactly when every pair does (same lengths, same
+// keys); a non-number fails.
+func TestHegelDeltasFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a, fa := genFloatish(ht)
+		b, fb := genFloatish(ht)
+		delta := pick(ht, []float64{0, 0.1, 0.5, 1, 2, 1e9})
+		want := modelInDelta(fa, fb, delta)
+		c.count("delta=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%T %v, %T %v, %v)", a, a, b, b, delta)
+		if !expect(c, ht, "InDelta"+name, want, func(t assert.TestingT) bool { return assert.InDelta(t, a, b, delta) }) {
+			return
+		}
+		if !expect(c, ht, "InDelta(b,a)"+name, want, func(t assert.TestingT) bool { return assert.InDelta(t, b, a, delta) }) {
+			return
+		}
+		if !expect(c, ht, "InDelta(string)"+name, false, func(t assert.TestingT) bool { return assert.InDelta(t, "1", b, delta) }) {
+			return
+		}
+		eps := pick(ht, []float64{0, 0.01, 0.5, 1, 10})
+		wantE := modelInEpsilon(fa, fb, eps)
+		if !expect(c, ht, "InEpsilon"+name, wantE, func(t assert.TestingT) bool { return assert.InEpsilon(t, a, b, eps) }) {
+			return
+		}
+		// slices of float64 with equal lengths
+		k := n(ht, 0, 3)
+		xs, ys := make([]float64, k), make([]float64, k)
+		all, allE := true, true
+		for i := range xs {
+			_, xs[i] = genFloatish(ht)
+			_, ys[i] = genFloatish(ht)
+			all = all && modelInDelta(xs[i], ys[i], delta)
+			allE = allE && modelInEpsilon(xs[i], ys[i], eps)
+		}
+		sn := fmt.Sprintf("(%v, %v, %v)", xs, ys, delta)
+		if !expect(c, ht, "InDeltaSlice"+sn, all, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys, delta) }) {
+			return
+		}
+		if !expect(c, ht, "InEpsilonSlice"+sn, allE, func(t assert.TestingT) bool { return assert.InEpsilonSlice(t, xs, ys, eps) }) {
+			return
+		}
+		if !Known.deltaSliceLength && k > 0 {
+			if !expect(c, ht, "InDeltaSlice(shorter)"+sn, false, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys[:k-1], delta) }) {
+				return
+			}
+		}
+		// maps
+		ma, mb := map[string]float64{}, map[string]float64{}
+		allM := true
+		for _, key := range []string{"x", "y", "z"} {
+			if chance(ht, 60) {
+				_, ma[key] = genFloatish(ht)
+			}
+			if chance(ht, 60) {
+				_, mb[key] = genFloatish(ht)
+			}
+		}
+		if len(ma) != len(mb) {
+			allM = false
+		} else {
+			for key, v := range ma {
+				w, ok := mb[key]
+				if !ok || !modelInDelta(v, w, delta) {
+					allM = false
+				}
+			}
+		}
+		expect(c, ht, fmt.Sprintf("InDeltaMapValues(%v, %v, %v)", ma, mb, delta), allM, func(t assert.TestingT) bool { return assert.InDeltaMapValues(t, ma, mb, delta) })
+	})
+}
