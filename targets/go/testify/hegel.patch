+	switch hegel.Draw(tc, shaped(hegel.Integers(0, 2), hegel.Just(-1))) {
+	case 0:
+		a = nil
+	case 1:
+		b = nil
+	case 2:
+		a, b = nil, nil
+	}
+	return nilCase{a: a, b: b, pick: hegel.Draw(tc, positions)}
+})
