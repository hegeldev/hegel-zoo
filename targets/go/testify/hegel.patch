+func (c bigIntCase) GoString() string { return fmt.Sprintf("%#v", c.doc()) }
+
+var (
+	bigInts = hegel.OneOf(
+		asAny(hegel.Map(hegel.Integers(0, 3), func(n int) int64 { return 9007199254740992 + int64(n) })),
