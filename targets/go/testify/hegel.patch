+// TestHegelJSONEqComparesIntegersExactly: JSONEq and YAMLEq equate two serialisations of an
+// integer document and tell it from the document with the integer changed by one; testify/14
+// decodes integers into float64 and equates 9007199254740993 with 9007199254740992.
+func TestHegelJSONEqComparesIntegersExactly(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, bigIntCases)
