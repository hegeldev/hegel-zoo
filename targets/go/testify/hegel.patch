new file mode 100644
index 0000000..b0287da
--- /dev/null
+++ b/assert/hegel_test.go
@@ -0,0 +1,430 @@
+package assert_test
+
+// Hegel property tests for stretchr/testify's assert package, written for the Hegel zoo.
+// See targets/go/testify/README.md.
+//
+// Oracles: the documented meaning of each assertion restated as a small model (reflect.DeepEqual
+// with the documented []byte rule for Equal; exact arithmetic for EqualValues, InDelta and
+// InEpsilon; multiset equality for ElementsMatch; the Go ordering of the kind for Greater and
+// friends), the laws between assertions (NotX is the negation of X, Exactly implies Equal,
+// ElementsMatch is invariant under permutation, symmetry) and the contract every assertion
+// shares: the returned bool is true exactly when nothing was reported to the TestingT, and the
+// caller's message is reported verbatim.
+//
+// Every property draws one case record from generators built of hegel-go's combinators (the
+// values, numbers, lists and documents of the other files), renders it with pure functions and
+// judges it through the recording mockT: check enforces the shared contract (the result is true
+// exactly when nothing was reported, one report, no panic) and expect adds the model's verdict.
+// The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so the properties
+// that meet them fail naming the shape and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its shape region alone,
+// and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape
+// (collector.mismatch); under HEGEL_NO_KNOWN=1 the switches of Known are on, the shapes are left
+// out of the generators (shaped) and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). A switch that is on means the property leaves the shape
+// out, which is so only under HEGEL_NO_KNOWN=1; the pins assert the correct behaviour and fail
+// while the bug exists.
+var Known = struct {
+	// testify/1: EqualValues converts between a signed and an unsigned integer type of the same
+	// size, so int8(-1) equals uint8(255) and uint64(1<<63) equals int64(MinInt64). On: the
+	// numeric model draws non-negative values below the wrap for signed/unsigned pairs.
+	sameSizeWrap bool
+	// testify/2: EqualValues converts a float to the integer type by truncation: 1 equals 1.5,
+	// int64(MinInt64) equals 1e300. On: integer/float pairs are drawn with integral floats only.
+	floatTruncation bool
+	// testify/3: EqualValues converts an integer to float32/float64 when the float type is at
+	// least as wide, so int32(16777217) equals float32(16777216) in one argument order and not
+	// the other. On: integer/float pairs stay below 2^24.
+	intRounding bool
+	// testify/4: EqualValues(65, "A") passes (the int to string rune conversion) but
+	// EqualValues("A", 65) fails. On: no integer/string pairs.
+	runeString bool
+	// testify/5: EqualValues panics when a slice is compared with a longer array. On:
+	// slice/array pairs are drawn with equal lengths.
+	sliceArrayPanic bool
+	// testify/6: Contains on a string with a non-string element matches the text of the
+	// element's reflect.Value.String() ("<int Value>"). On: strings are searched for strings only.
+	containsValueText bool
+	// testify/7: Subset, NotSubset, ElementsMatch, NotElementsMatch, IsIncreasing & co,
+	// Positive and Negative panic on a nil argument instead of failing. On: nil is not passed to
+	// them.
+	nilPanics bool
+	// testify/8: ElementsMatch passes for two empty values of any type (an empty map, "", 0)
+	// while the same non-empty values fail with a type error. On: non-list arguments are not
+	// passed to ElementsMatch.
+	emptyNonList bool
+	// testify/9: PanicsWithValue panics when the recovered value is not comparable (a slice).
+	// On: only comparable panic values.
+	uncomparablePanicValue bool
+	// testify/10: InDelta with a NaN delta passes (InEpsilon rejects a NaN epsilon). On: no NaN
+	// deltas.
+	nanDelta bool
+	// testify/11: InDeltaSlice ignores the lengths: it passes when actual is shorter than
+	// expected and panics when it is longer. On: the slices have equal lengths.
+	deltaSliceLength bool
+	// testify/12: Greater & co panic when the two arguments are structs or slices of different
+	// types (the second is converted without a check). On: both arguments share a type or differ
+	// in kind.
+	compareConvertPanic bool
+	// testify/13: EqualExportedValues drops map entries whose value is a nil interface and
+	// panics on a nil interface element of a slice or array. On: no nil leaves in the structures.
+	exportedNilInterface bool
+	// testify/14: JSONEq and YAMLEq decode integers into float64, so integers above 2^53 that
+	// differ compare equal. On: the documents' integers stay below 2^53.
+	bigIntegers bool
+	// testify/15: NotSame returns true after reporting a failure when the arguments are not
+	// pointers. On: NotSame runs on pointers only.
+	notSameReturn bool
+	// testify/16: NotElementsMatch reports the caller's message as a Go slice ("[my msg 7]",
+	// "[]" when there is none) and reports a type failure twice. On: the contract property
+	// leaves NotElementsMatch out.
+	notElementsMatchMessage bool
+	// testify/17: Positive and Negative accept strings, byte slices and times. On: only numbers
+	// go to them.
+	positiveStrings bool
+	// testify/18: ElementsMatch and NotElementsMatch treat an array of zero values as empty, so
+	// [1]int{0} matches []int{}. On: a zero array is not matched against an empty list of another
+	// length.
+	zeroArrayEmpty bool
+	// testify/19: EqualValues passes for a slice and a shorter array holding the slice's first
+	// elements: reflect converts the slice to the array of its prefix. On: slice/array pairs are
+	// drawn with the array at least as long.
+	slicePrefixArray bool
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a narrow property draws the shape of (none under HEGEL_NO_KNOWN=1, where
+// it draws the neighbouring region).
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// --------------------------------------------------------------------------- collector
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// mismatch reports a disagreement with the model on a case whose shape is that of the recorded
+// bugs shape names (none for a shape no bug covers): the failure names them, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func (c *collector) mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- mock TestingT
+
+// mockT records what an assertion reports.
+type mockT struct{ msgs []string }
+
+func (m *mockT) Errorf(format string, args ...interface{}) {
+	m.msgs = append(m.msgs, fmt.Sprintf(format, args...))
+}
+
+func (m *mockT) failed() bool { return len(m.msgs) > 0 }
+
+// run calls an assertion on a fresh mockT and returns its result, whether anything was reported
+// and the panic value if it panicked.
+func run(f func(t assert.TestingT) bool) (ok bool, reported int, panicked any) {
+	m := &mockT{}
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+			reported = len(m.msgs)
+		}
+	}()
+	ok = f(m)
+	return ok, len(m.msgs), nil
+}
+
+// check: the assertion's result agrees with what it reported, and no panic; shape names the
+// recorded bugs whose shape the call has.
+func check(c *collector, ht *hegel.T, name string, f func(t assert.TestingT) bool, shape ...string) (bool, bool) {
+	ok, reported, p := run(f)
+	if p != nil {
+		c.mismatch(ht, shape, "%s panicked: %v", name, p)
+		return false, false
+	}
+	if ok != (reported == 0) {
+		c.mismatch(ht, shape, "%s returned %v but reported %d failure(s)", name, ok, reported)
+		return false, false
+	}
+	if reported > 1 {
+		c.mismatch(ht, shape, "%s reported %d failures for one assertion", name, reported)
+		return false, false
+	}
+	return ok, true
+}
+
+// expect: run the assertion and compare with the model's verdict; shape names the recorded bugs
+// whose shape the call has.
+func expect(c *collector, ht *hegel.T, name string, want bool, f func(t assert.TestingT) bool, shape ...string) bool {
+	got, fine := check(c, ht, name, f, shape...)
+	if !fine {
+		return false
+	}
+	if got != want {
+		c.mismatch(ht, shape, "%s = %v, want %v", name, got, want)
+		return false
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements, and the models tell a nil collection from an empty one).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure renderer consumes in order, recycled
+// modulo its length, for the choices a rendering leaves free (whitespace, the order of an
+// object's members, which element a mutation hits). An empty tape answers 0 to every question,
+// so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 || n <= 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to forty values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 40)
+
+// shuffled is xs reordered by one sort key per element (keys recycled modulo their number; equal
+// keys keep the order, so an empty key list is the identity, which is what it shrinks to).
+func shuffled[T any](xs []T, keys []int) []T {
+	ys := append([]T{}, xs...)
+	if len(keys) == 0 {
+		return ys
+	}
+	idx := make([]int, len(xs))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.SliceStable(idx, func(i, j int) bool { return keys[idx[i]%len(keys)] < keys[idx[j]%len(keys)] })
+	for i, k := range idx {
+		ys[i] = xs[k]
+	}
+	return ys
+}
