+
+type S struct {
+	A int
+	B string
+}
+
+type myInt int
+
+// --------------------------------------------------------------------------- values
+
+var (
+	bits       = hegel.Integers(0, 1)
+	smallInts  = hegel.Integers(-3, 3)
+	int64s     = hegel.Map(smallInts, func(x int) int64 { return int64(x) })
+	uint8s     = hegel.Integers(uint8(0), 3)
+	floatPool  = hegel.SampledFrom([]float64{0, 1, 1.5, -2, 1e300, math.SmallestNonzeroFloat64})
+	stringPool = hegel.SampledFrom([]string{"", "a", "ab", "b", "<int Value>"})
+	abStrings  = hegel.SampledFrom([]string{"a", "b"})
+	byteValues = hegel.OneOf(hegel.Just([]byte(nil)), hegel.Just([]byte{}), hegel.Map(hegel.SampledFrom([]string{"a", "ab"}), func(s string) []byte { return []byte(s) }))
+	intSlices  = hegel.OneOf(hegel.Just([]int(nil)), hegel.Just([]int{}), many(hegel.Integers(0, 2), 1, 3))
+	intPairs   = hegel.Map(pairs(bits, bits), func(p pair[int, int]) [2]int { return [2]int{p.a, p.b} })
+	intMaps    = hegel.OneOf(hegel.Just(map[string]int(nil)), hegel.Just(map[string]int{}), hegel.Maps(abStrings, bits).MinSize(1).MaxSize(2))
+	structs    = hegel.Map(pairs(bits, hegel.SampledFrom([]string{"", "x"})), func(p pair[int, string]) S { return S{p.a, p.b} })
+	structPtrs = weighted(choice[*S]{30, hegel.Just[*S](nil)}, choice[*S]{70, hegel.Map(structs, ptrTo[S])})
+	channels   = weighted(
+		choice[chan int]{30, hegel.Just(chan int(nil))},
+		choice[chan int]{70, hegel.Map(chance(50), func(full bool) chan int {
+			ch := make(chan int, 1)
+			if full {
+				ch <- 1
+			}
+			return ch
+		})},
+	)
+	myInts    = hegel.Map(hegel.Integers(0, 2), func(x int) myInt { return myInt(x) })
+	errs      = hegel.Map(hegel.SampledFrom([]string{"e", "f"}), func(s string) error { return errors.New(s) })
+	durations = hegel.Map(hegel.Integers(-1, 2), func(n int) time.Duration { return time.Duration(n) * time.Second })
+)
+
+// values: a value of one of seventeen types, each as often as the others, with the shapes the
+// assertions treat specially (nil first, typed nil pointers/slices/maps/channels, empty and
+// non-empty collections, pointers to zero structs, nested interfaces): a []any holds values of
+// the next level, two levels deep at most, below which a myInt stands in for it (the depth
+// counter lives in the closure and is restored by defer, hegel-go's recursive Composite).
+//
+// nonNilValues and plainValues are the same without nil, and without nil and the pointers.
+var values, nonNilValues, plainValues = func() (hegel.Generator[any], hegel.Generator[any], hegel.Generator[any]) {
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	nested := hegel.Composite(func(tc hegel.TestCase) any {
+		if depth > 1 {
+			return hegel.Draw(tc, myInts)
+		}
+		depth++
+		defer func() { depth-- }()
+		return nonNil(hegel.Draw(tc, many(child, 0, 2)))
+	})
+	plain := []hegel.Generator[any]{
+		asAny(hegel.Booleans()),
+		asAny(smallInts),
+		asAny(int64s),
+		asAny(uint8s),
+		asAny(floatPool),
+		asAny(stringPool),
+		asAny(byteValues),
+		asAny(intSlices),
+		asAny(intPairs),
+		asAny(intMaps),
+		asAny(structs),
+		asAny(channels),
+		nested,
+		asAny(errs),
+		asAny(durations),
+	}
+	nonNil := append([]hegel.Generator[any]{asAny(structPtrs)}, plain...)
+	node = hegel.OneOf(append([]hegel.Generator[any]{hegel.Just[any](nil)}, nonNil...)...)
+	return node, hegel.OneOf(nonNil...), hegel.OneOf(plain...)
+}()
+
+// clone: a distinct value with the same content (pointers get a new pointee).
+func clone(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		if x == nil {
+			return []byte(nil)
+		}
+		return append([]byte{}, x...)
+	case []int:
+		if x == nil {
+			return []int(nil)
+		}
+		return append([]int{}, x...)
+	case map[string]int:
+		if x == nil {
+			return map[string]int(nil)
+		}
+		m := map[string]int{}
+		for k, v := range x {
+			m[k] = v
+		}
+		return m
+	case *S:
+		if x == nil {
+			return (*S)(nil)
+		}
+		s := *x
+		return &s
+	case []any:
+		if x == nil {
+			return []any(nil)
+		}
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = clone(x[i])
+		}
+		return out
+	case error:
+		return errors.New(x.Error())
+	}
+	return v
+}
+
+// modelEqual: Equal's documented rule (DeepEqual, []byte compared by content with nil distinct
+// from empty, nil equal to nil only).
+func modelEqual(a, b any) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if ab, ok := a.([]byte); ok {
+		bb, ok := b.([]byte)
+		if !ok {
+			return false
+		}
+		if ab == nil || bb == nil {
+			return ab == nil && bb == nil
+		}
+		return bytes.Equal(ab, bb)
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func modelEmpty(v any) bool {
+	if v == nil {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Map, reflect.Slice:
+		return rv.Len() == 0
+	case reflect.Ptr:
+		if rv.IsNil() {
+			return true
+		}
+		return modelEmpty(rv.Elem().Interface())
+	}
+	return rv.IsZero()
+}
+
+func modelZero(v any) bool {
+	if v == nil {
+		return true
+	}
+	return reflect.DeepEqual(v, reflect.Zero(reflect.TypeOf(v)).Interface())
+}
+
+func modelNil(v any) bool {
+	if v == nil {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice, reflect.UnsafePointer:
+		return rv.IsNil()
+	}
+	return false
+}
+
+func modelLen(v any) (int, bool) {
+	if v == nil {
+		return 0, false
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Array, reflect.Chan, reflect.Map, reflect.Slice, reflect.String:
+		return rv.Len(), true
+	}
+	return 0, false
+}
+
+func isPtr(v any) bool { return v != nil && reflect.TypeOf(v).Kind() == reflect.Ptr }
+
+// relation: how the second value of a pair comes about.
+type relation int
+
+const (
+	sameValue    relation = iota // the very same value (pointer identity holds)
+	clonedValue                  // a distinct value of the same content
+	anotherValue                 // an independent value
+)
+
+// eqCase: two values, related as rel says (other is the independent second value), and the
+// length Len is asked for.
+type eqCase struct {
+	a     any
+	rel   relation
+	other any
+	k     int
+}
+
+// b is the second value of the pair.
+func (c eqCase) b() any {
+	switch c.rel {
+	case sameValue:
+		return c.a
+	case clonedValue:
+		return clone(c.a)
+	}
+	return c.other
+}
+
+func (c eqCase) GoString() string {
+	b := c.b()
+	return fmt.Sprintf("a: %T %#v; b (%v): %T %#v; k=%d", c.a, c.a, []string{"same", "cloned", "another"}[c.rel], b, b, c.k)
+}
+
+var eqCases = hegel.Composite(func(tc hegel.TestCase) eqCase {
+	return eqCase{
+		a:     hegel.Draw(tc, values),
+		rel:   hegel.Draw(tc, hegel.SampledFrom([]relation{sameValue, clonedValue, anotherValue})),
+		other: hegel.Draw(tc, values),
+		k:     hegel.Draw(tc, hegel.Integers(0, 3)),
+	}
+})
+
+// TestHegelEqualityFollowsTheModel: Equal is DeepEqual with the documented []byte rule,
+// NotEqual its negation, Exactly adds a type check, IsType compares types, Same is pointer
+// identity (and NotSame its negation, false without a report on anything else: testify/15
+// returns true there), and Empty, Zero, Nil, Len follow their documentation with NotX = !X.
+func TestHegelEqualityFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, eqCases)
+		a, b := cs.a, cs.b()
+		eq := modelEqual(a, b)
+		c.count("eq=" + strconv.FormatBool(eq))
+		name := fmt.Sprintf("(%T %#v, %T %#v)", a, a, b, b)
+		if !expect(c, ht, "Equal"+name, eq, func(t assert.TestingT) bool { return assert.Equal(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Equal(b,a)"+name, eq, func(t assert.TestingT) bool { return assert.Equal(t, b, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotEqual"+name, !eq, func(t assert.TestingT) bool { return assert.NotEqual(t, a, b) }) {
+			return
+		}
+		if got := assert.ObjectsAreEqual(a, b); got != eq {
+			c.fail(ht, "ObjectsAreEqual%s = %v, want %v", name, got, eq)
+			return
+		}
+		sameType := reflect.TypeOf(a) == reflect.TypeOf(b)
+		if !expect(c, ht, "Exactly"+name, eq && sameType, func(t assert.TestingT) bool { return assert.Exactly(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "IsType"+name, sameType, func(t assert.TestingT) bool { return assert.IsType(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "IsNotType"+name, !sameType, func(t assert.TestingT) bool { return assert.IsNotType(t, a, b) }) {
+			return
+		}
+		if isPtr(a) && isPtr(b) {
+			same := sameType && reflect.ValueOf(a).Pointer() == reflect.ValueOf(b).Pointer()
+			if !expect(c, ht, "Same"+name, same, func(t assert.TestingT) bool { return assert.Same(t, a, b) }) {
+				return
+			}
+			if !expect(c, ht, "NotSame"+name, !same, func(t assert.TestingT) bool { return assert.NotSame(t, a, b) }) {
+				return
+			}
+		} else {
+			if !expect(c, ht, "Same"+name, false, func(t assert.TestingT) bool { return assert.Same(t, a, b) }) {
+				return
+			}
+			if !Known.notSameReturn {
+				if !expect(c, ht, "NotSame"+name, false, func(t assert.TestingT) bool { return assert.NotSame(t, a, b) }, known("testify/15")...) {
+					return
+				}
+			}
+		}
+		// single-value assertions on a
+		an := fmt.Sprintf("(%T %#v)", a, a)
+		empty := modelEmpty(a)
+		if !expect(c, ht, "Empty"+an, empty, func(t assert.TestingT) bool { return assert.Empty(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotEmpty"+an, !empty, func(t assert.TestingT) bool { return assert.NotEmpty(t, a) }) {
+			return
+		}
+		zero := modelZero(a)
+		if !expect(c, ht, "Zero"+an, zero, func(t assert.TestingT) bool { return assert.Zero(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotZero"+an, !zero, func(t assert.TestingT) bool { return assert.NotZero(t, a) }) {
+			return
+		}
+		if zero && !empty {
+			c.fail(ht, "%s is zero but not empty", an)
+			return
+		}
+		isNil := modelNil(a)
+		if !expect(c, ht, "Nil"+an, isNil, func(t assert.TestingT) bool { return assert.Nil(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotNil"+an, !isNil, func(t assert.TestingT) bool { return assert.NotNil(t, a) }) {
+			return
+		}
+		l, ok := modelLen(a)
+		k := cs.k
+		if !expect(c, ht, "Len"+an+strconv.Itoa(k), ok && l == k, func(t assert.TestingT) bool { return assert.Len(t, a, k) }) {
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- EqualValues
+
+// numType is one of the twelve numeric types.
+type numType struct {
+	name   string
+	signed bool
+	float  bool
+	bits   int
+}
+
+var numTypes = []numType{
+	{"int", true, false, 64}, {"int8", true, false, 8}, {"int16", true, false, 16}, {"int32", true, false, 32}, {"int64", true, false, 64},
+	{"uint", false, false, 64}, {"uint8", false, false, 8}, {"uint16", false, false, 16}, {"uint32", false, false, 32}, {"uint64", false, false, 64},
+	{"float32", false, true, 32}, {"float64", false, true, 64},
+}
+
+func exactOf(f float64) *big.Float { return new(big.Float).SetPrec(200).SetFloat64(f) }
+
+// pow2 is 2^n (at a precision that keeps 2^64-1 exact, unlike big.NewFloat's 53 bits).
+func pow2(n int) *big.Float { return new(big.Float).SetMantExp(exactOf(1), n) }
+
+// bounds are the smallest and largest value of an integer type.
+func (t numType) bounds() (lo, hi *big.Float) {
+	if t.signed {
+		hi = pow2(t.bits - 1)
+		return new(big.Float).Neg(hi), new(big.Float).Sub(hi, big.NewFloat(1))
+	}
+	return big.NewFloat(0), new(big.Float).Sub(pow2(t.bits), big.NewFloat(1))
+}
+
+// holds reports whether the integer type represents the (integral) value.
+func (t numType) holds(x *big.Float) bool {
+	lo, hi := t.bounds()
+	return x.Cmp(lo) >= 0 && x.Cmp(hi) <= 0
+}
+
+// exactly reports whether the float type represents the value without rounding.
+func (t numType) exactly(x *big.Float) bool {
+	if t.bits == 32 {
+		_, acc := x.Float32()
+		return acc == big.Exact
+	}
+	_, acc := x.Float64()
+	return acc == big.Exact
+}
+
+// value is the Go value of the type holding x, which fits it.
+func (t numType) value(x *big.Float) any {
+	if t.float {
+		f, _ := x.Float64()
+		if t.bits == 32 {
+			return float32(f)
+		}
+		return f
+	}
+	if t.signed {
+		i, _ := x.Int64()
+		switch t.name {
+		case "int":
+			return int(i)
+		case "int8":
+			return int8(i)
+		case "int16":
+			return int16(i)
+		case "int32":
+			return int32(i)
+		}
+		return i
+	}
+	u, _ := x.Uint64()
+	switch t.name {
+	case "uint":
+		return uint(u)
+	case "uint8":
+		return uint8(u)
+	case "uint16":
+		return uint16(u)
+	case "uint32":
+		return uint32(u)
+	}
+	return u
+}
+
+// num: a value of a numeric type and its exact value.
+type num struct {
+	v     any
+	exact *big.Float
+}
+
+func (n num) GoString() string { return fmt.Sprintf("%T(%v)", n.v, n.v) }
+
+var (
+	floatVals    = []float64{0, 1, -1, 2, 3, 1.5, -2.5, 0.1, 100, 1 << 24, 1<<24 + 1, 1e10, 1e300, -1e300, 0.5, 65535, 255, 127, -128}
+	signedVals   = []float64{0, 1, -1, 2, 3, 100, 127, -128, 255, 65535, -56, 1 << 24, 1<<24 + 1}
+	unsignedVals = []float64{0, 1, 2, 3, 100, 127, 128, 200, 255, 65535, 1 << 24, 1<<24 + 1}
+)
+
+// poolKind restricts a numeric pool to the values that meet a recorded EqualValues bug's
+// counterpart without its shape (HEGEL_NO_KNOWN=1).
+type poolKind int
+
+const (
+	fullPool        poolKind = iota
+	integralPool             // integral values below 2^24 in magnitude: exact in every type (integer/float pairs)
+	nonNegativePool          // signed values at or above zero, unsigned ones below the sign bit (signed/unsigned pairs)
+)
+
+// pool: the values of the type: the fixed pools (clamped to the type's range), the type's
+// extremes and, for an unsigned type, the sign-bit boundary; the exotic ones (a float32 that is
+// an infinity, 2^24+1) included.
+func (t numType) pool(kind poolKind) []num {
+	var xs []*big.Float
+	switch {
+	case t.float:
+		for _, f := range floatVals {
+			if t.bits == 32 {
+				f = float64(float32(f))
+			}
+			xs = append(xs, exactOf(f))
+		}
+	default:
+		lo, hi := t.bounds()
+		vals := signedVals
+		if !t.signed {
+			vals = unsignedVals
+		}
+		for _, f := range vals {
+			xs = append(xs, exactOf(f))
+		}
+		xs = append(xs, lo, hi, new(big.Float).Add(lo, big.NewFloat(1)), new(big.Float).Sub(hi, big.NewFloat(1)))
+		if !t.signed {
+			xs = append(xs, pow2(t.bits-1), new(big.Float).Sub(pow2(t.bits-1), big.NewFloat(1)))
+		}
+		for i, x := range xs {
+			switch {
+			case x.Cmp(lo) < 0:
+				xs[i] = lo
+			case x.Cmp(hi) > 0:
+				xs[i] = hi
+			}
+		}
+	}
+	var out []num
+	seen := map[string]bool{}
+	for _, x := range xs {
+		if !t.fits(x, kind) {
+			continue
+		}
+		key := x.Text('g', 40)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, num{t.value(x), x})
+	}
+	return out
+}
+
+var twoTo24 = pow2(24)
+
+func (t numType) fits(x *big.Float, kind poolKind) bool {
+	switch kind {
+	case integralPool:
+		return x.IsInt() && new(big.Float).Abs(x).Cmp(twoTo24) < 0
+	case nonNegativePool:
+		if t.signed {
+			return x.Sign() >= 0
+		}
+		if !t.float {
+			return x.Cmp(pow2(t.bits-1)) < 0
+		}
+	}
+	return true
+}
+
+// numGens: the values of every numeric type under every pool restriction.
+var numGens = func() [][]hegel.Generator[num] {
+	out := make([][]hegel.Generator[num], len(numTypes))
+	for i, t := range numTypes {
+		for _, kind := range []poolKind{fullPool, integralPool, nonNegativePool} {
+			out[i] = append(out[i], hegel.SampledFrom(t.pool(kind)))
+		}
+	}
+	return out
+}()
+
+// restriction: the pool both operands of a pair are drawn from: the full pools, or under
+// HEGEL_NO_KNOWN=1 the integral values for an integer/float pair (testify/2, testify/3) and the
+// non-negative ones below the sign bit for a signed/unsigned pair (testify/1).
+func restriction(ta, tb numType) poolKind {
+	switch {
+	case !noKnown:
+		return fullPool
+	case ta.float != tb.float:
+		return integralPool
+	case !ta.float && ta.signed != tb.signed:
+		return nonNegativePool
+	}
+	return fullPool
+}
+
+// numShape names the recorded EqualValues bug whose shape the pair has. ObjectsAreEqualValues
+// converts the actual value to the expected type when that is at least as wide, else the
+// expected value to the actual type; the shape is a converted value its target does not hold:
+// a signed value converted negative to an unsigned type or an unsigned one past the signed
+// range (testify/1), a float with a fraction or out of range converted to an integer type
+// (testify/2), an integer a float type cannot hold exactly (testify/3).
+func numShape(ta numType, a num, tb numType, b num) []string {
+	conv, ct, target := a, ta, tb
+	if ta.bits >= tb.bits {
+		conv, ct, target = b, tb, ta
+	}
+	x := conv.exact
+	switch {
+	case ct.float && !target.float:
+		return shapeIf(!x.IsInt() || !target.holds(x), "testify/2")
+	case !ct.float && target.float:
+		return shapeIf(!target.exactly(x), "testify/3")
+	case !ct.float && !target.float && ct.signed != target.signed:
+		return shapeIf(!target.holds(x), "testify/1")
+	}
+	return nil
+}
+
+// evCase: two values for EqualValues with the model's verdict: a string and a []byte, a named
+// int and an int, a slice and an array, an int and a string (while the shapes are on), or two
+// numbers of any of the twelve numeric types. oneWay: the pair is checked in the given order
+// only (Go converts a slice to an array, not an array to a slice).
+type evCase struct {
+	class  string
+	a, b   any
+	want   bool
+	oneWay bool
+	shape  []string
+}
+
+func (c evCase) GoString() string {
+	return fmt.Sprintf("%s: %T %#v, %T %#v (want %v)", c.class, c.a, c.a, c.b, c.b, c.want)
+}
+
+// swapped puts the pair the other way round half of the time.
+func swapped(c evCase, swap bool) evCase {
+	if swap {
+		c.a, c.b = c.b, c.a
+	}
+	return c
+}
+
+var (
+	shortStrings = hegel.SampledFrom([]string{"", "a", "ab"})
+	numTypeIdx   = hegel.Integers(0, len(numTypes)-1)
+
+	// stringBytesCases: a string and a []byte, equal when their contents are.
+	stringBytesCases = hegel.Composite(func(tc hegel.TestCase) evCase {
+		sa, sb := hegel.Draw(tc, shortStrings), hegel.Draw(tc, shortStrings)
+		return swapped(evCase{class: "string/bytes", a: sa, b: []byte(sb), want: sa == sb}, hegel.Draw(tc, chance(50)))
+	})
+	// namedCases: a named int and an int, equal when their values are.
+	namedCases = hegel.Composite(func(tc hegel.TestCase) evCase {
+		x, y := hegel.Draw(tc, hegel.Integers(0, 2)), hegel.Draw(tc, hegel.Integers(0, 2))
+		return swapped(evCase{class: "named", a: myInt(x), b: y, want: x == y}, hegel.Draw(tc, chance(50)))
+	})
+	// arrayExtras: how much longer than the slice the array is: as long, longer by one or two
+	// (the shape of testify/5: Convert panics) or shorter by one (the shape of testify/19: the
+	// array of the slice's prefix passes); as long under HEGEL_NO_KNOWN=1.
+	arrayExtras = weighted(
+		choice[int]{60, hegel.Just(0)},
+		choice[int]{30, shaped(hegel.Integers(1, 2), hegel.Just(0))},
+		choice[int]{10, shaped(hegel.Just(-1), hegel.Just(0))},
+	)
+	sliceArrayCases = sliceArrayCasesWith(arrayExtras)
+	// intStringCases: an integer (of a few types) and a string, never equal in value; the string
+	// is the integer as a rune (the shape of testify/4), "A", the empty string or the decimal
+	// digits (the digits or the empty string under HEGEL_NO_KNOWN=1).
+	intStringCases = hegel.Composite(func(tc hegel.TestCase) evCase {
+		r := hegel.Draw(tc, hegel.SampledFrom([]int{65, 66, 97, 48, 0x20ac, 0x1f600}))
+		i := hegel.Draw(tc, hegel.SampledFrom([]any{r, int32(r), int64(r), myInt(r)}))
+		asRune := string(rune(r))
+		s := hegel.Draw(tc, hegel.SampledFrom(shaped([]string{asRune, "A", "", strconv.Itoa(r)}, []string{"", strconv.Itoa(r)})))
+		return evCase{class: "int/string", a: i, b: s, want: false, shape: shapeIf(s == asRune, "testify/4")}
+	})
+	// numCases: two numbers of any two numeric types, equal when their exact values are; under
+	// HEGEL_NO_KNOWN=1 a mixed pair is drawn from the pools without the recorded shapes.
+	numCases = hegel.Composite(func(tc hegel.TestCase) evCase {
+		i, j := hegel.Draw(tc, numTypeIdx), hegel.Draw(tc, numTypeIdx)
+		ta, tb := numTypes[i], numTypes[j]
+		kind := restriction(ta, tb)
+		a, b := hegel.Draw(tc, numGens[i][kind]), hegel.Draw(tc, numGens[j][kind])
+		class := "num"
+		if i != j {
+			class = "num-mixed"
+		}
+		return evCase{class: class, a: a.v, b: b.v, want: a.exact.Cmp(b.exact) == 0, shape: numShape(ta, a, tb, b)}
+	})
+	// evCases: the numbers seven times in ten, the other classes once each.
+	evCases = weighted(choice[evCase]{1, stringBytesCases}, choice[evCase]{1, namedCases}, choice[evCase]{1, sliceArrayCases}, choice[evCase]{7, numCases}, choice[evCase]{1, intStringCases})
+)
+
+// sliceArrayCasesWith: a slice of 0 to 3 bits and an array longer by the drawn extra (at least
+// empty), equal when they have the same length and elements; the slice is the expected value.
+func sliceArrayCasesWith(extras hegel.Generator[int]) hegel.Generator[evCase] {
+	return hegel.Composite(func(tc hegel.TestCase) evCase {
+		xs := nonNil(hegel.Draw(tc, many(bits, 0, 3)))
+		ak := max(len(xs)+hegel.Draw(tc, extras), 0)
+		ys := hegel.Draw(tc, many(bits, ak, ak))
+		arr := reflect.New(reflect.ArrayOf(ak, reflect.TypeOf(0))).Elem()
+		want := ak == len(xs)
+		for i, y := range ys {
+			arr.Index(i).SetInt(int64(y))
+			if i < len(xs) && y != xs[i] {
+				want = false
+			}
+		}
+		shape := append(shapeIf(ak > len(xs), "testify/5"), shapeIf(ak < len(xs), "testify/19")...)
+		return evCase{class: "slice/array", a: xs, b: arr.Interface(), want: want, oneWay: true, shape: shape}
+	})
+}
+
+// TestHegelEqualValuesFollowsTheModel: EqualValues on two numbers is exact mathematical
+// equality, symmetric, with NotEqualValues its negation; on a string and a []byte it is
+// content equality; on a named integer and its base type, value equality; on a slice and an
+// array of the same length, element equality; an integer never equals a string.
+func TestHegelEqualValuesFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, evCases)
+		a, b, want := cs.a, cs.b, cs.want
+		c.count(cs.class + "=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%T %#v, %T %#v)", a, a, b, b)
+		if !expect(c, ht, "EqualValues"+name, want, func(t assert.TestingT) bool { return assert.EqualValues(t, a, b) }, cs.shape...) {
+			return
+		}
+		if !cs.oneWay {
+			if !expect(c, ht, "EqualValues(b,a)"+name, want, func(t assert.TestingT) bool { return assert.EqualValues(t, b, a) }, cs.shape...) {
+				return
+			}
+		}
+		if !expect(c, ht, "NotEqualValues"+name, !want, func(t assert.TestingT) bool { return assert.NotEqualValues(t, a, b) }, cs.shape...) {
+			return
+		}
+		if got := assert.ObjectsAreEqualValues(a, b); got != want {
+			c.mismatch(ht, cs.shape, "ObjectsAreEqualValues%s = %v, want %v", name, got, want)
+			return
+		}
+		// Equal implies EqualValues
+		if assert.ObjectsAreEqual(a, b) && !want {
+			c.mismatch(ht, cs.shape, "ObjectsAreEqual%s but the model says the values differ", name)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- EqualExportedValues
+
+// X: a struct with exported and unexported fields, nested through pointers, maps, slices and
+// interfaces.
+type X struct {
+	E int
+	u int
+	P *X
+	M map[string]any
+	L []any
+	I any
+	T S
+	t S
+}
+
+// xTrees: an X two levels deep: its pointer, map, list and interface fields present 40% of the
+// time each, the leaves of the map and list an int, a string, an X or a pointer to one, or (the
+// shape of testify/13, left out under HEGEL_NO_KNOWN=1) a nil interface.
+var xTrees = func() hegel.Generator[X] {
+	depth := 0
+	var node hegel.Generator[X]
+	child := hegel.Composite(func(tc hegel.TestCase) X { return hegel.Draw(tc, node) })
+	leafAlts := []hegel.Generator[any]{asAny(bits), asAny(abStrings), asAny(child), asAny(hegel.Map(child, ptrTo[X]))}
+	if !noKnown {
+		leafAlts = append([]hegel.Generator[any]{hegel.Just[any](nil)}, leafAlts...)
+	}
+	leaves := hegel.OneOf(leafAlts...)
+	maps := hegel.Map(hegel.Maps(abStrings, leaves).MaxSize(2), nonNilMap[string, any])
+	lists := hegel.Map(many(leaves, 0, 2), nonNil[any])
+	node = hegel.Composite(func(tc hegel.TestCase) X {
+		x := X{E: hegel.Draw(tc, bits), u: hegel.Draw(tc, bits), T: S{hegel.Draw(tc, bits), ""}, t: S{hegel.Draw(tc, bits), ""}}
+		if depth >= 2 {
+			return x
+		}
+		depth++
+		defer func() { depth-- }()
+		x.P = hegel.Draw(tc, optional(40, child))
+		x.M = hegel.Draw(tc, maybe(40, maps))
+		x.L = hegel.Draw(tc, maybe(40, lists))
+		x.I = hegel.Draw(tc, maybe(40, leaves))
+		return x
+	})
+	return node
+}()
+
+// hasNilLeaf reports whether a nil interface sits in a map or list of the structure (the shape
+// of testify/13).
+func hasNilLeaf(v any) bool {
+	switch x := v.(type) {
+	case X:
+		for _, e := range x.M {
+			if e == nil || hasNilLeaf(e) {
+				return true
+			}
+		}
+		for _, e := range x.L {
+			if e == nil || hasNilLeaf(e) {
+				return true
+			}
+		}
+		return (x.P != nil && hasNilLeaf(*x.P)) || (x.I != nil && hasNilLeaf(x.I))
+	case *X:
+		return x != nil && hasNilLeaf(*x)
+	}
+	return false
+}
+
+// exported: a copy of v with unexported struct fields zeroed, computed independently.
+func exported(v any) any {
+	if v == nil {
+		return nil
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Struct:
+		out := reflect.New(rv.Type()).Elem()
+		for i := 0; i < rv.NumField(); i++ {
+			if !rv.Type().Field(i).IsExported() {
+				continue
+			}
+			f := rv.Field(i)
+			if f.Kind() == reflect.Interface && f.IsNil() {
+				continue
+			}
+			if f.Kind() == reflect.Ptr && f.IsNil() {
+				continue
+			}
+			out.Field(i).Set(reflect.ValueOf(exported(f.Interface())))
+		}
+		return out.Interface()
+	case reflect.Ptr:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.New(rv.Type().Elem())
+		out.Elem().Set(reflect.ValueOf(exported(rv.Elem().Interface())))
+		return out.Interface()
+	case reflect.Slice:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.MakeSlice(rv.Type(), rv.Len(), rv.Len())
+		for i := 0; i < rv.Len(); i++ {
+			e := exported(rv.Index(i).Interface())
+			if e != nil {
+				out.Index(i).Set(reflect.ValueOf(e))
+			}
+		}
+		return out.Interface()
+	case reflect.Map:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.MakeMap(rv.Type())
+		for _, k := range rv.MapKeys() {
+			e := exported(rv.MapIndex(k).Interface())
+			if e == nil {
+				out.SetMapIndex(k, reflect.Zero(rv.Type().Elem()))
+			} else {
+				out.SetMapIndex(k, reflect.ValueOf(e))
+			}
+		}
+		return out.Interface()
+	}
+	return v
+}
+
+// exChange: how the second structure differs from the first.
+type exChange int
+
+const (
+	unexportedChanged exChange = iota // the unexported fields flipped: still equal
+	exportedChanged                   // an exported field flipped (E, or T.A when inT): not equal
+	independent                       // an independent structure
+)
+
+// exCase: two X structures, compared by value or by pointer.
+type exCase struct {
+	a     X
+	how   exChange
+	inT   bool
+	other X
+	byPtr bool
+}
+
+func (c exCase) b() X {
+	b := c.a
+	switch c.how {
+	case unexportedChanged:
+		b.u = 1 - c.a.u
+		b.t.A = 1 - c.a.t.A
+	case exportedChanged:
+		if c.inT {
+			b.T.A = 1 - c.a.T.A
+		} else {
+			b.E = 1 - c.a.E
+		}
+	default:
+		b = c.other
+	}
+	return b
+}
+
+func (c exCase) GoString() string {
+	return fmt.Sprintf("a %+v\nb %+v (%v) byPtr=%v", c.a, c.b(), []string{"unexported changed", "exported changed", "independent"}[c.how], c.byPtr)
+}
+
+var exCases = hegel.Composite(func(tc hegel.TestCase) exCase {
+	return exCase{
+		a:     hegel.Draw(tc, xTrees),
+		how:   hegel.Draw(tc, hegel.SampledFrom([]exChange{unexportedChanged, exportedChanged, independent})),
+		inT:   hegel.Draw(tc, chance(50)),
+		other: hegel.Draw(tc, xTrees),
+		byPtr: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// TestHegelEqualExportedValuesFollowsTheModel: EqualExportedValues on two X values (or
+// pointers) is DeepEqual of their exported-only copies; unexported fields never matter;
+// symmetric; a value equals a copy of itself with the unexported fields changed.
+func TestHegelEqualExportedValuesFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, exCases)
+		a, b := cs.a, cs.b()
+		want := reflect.DeepEqual(exported(a), exported(b))
+		shape := shapeIf(hasNilLeaf(a) || hasNilLeaf(b), "testify/13")
+		c.count("eq=" + strconv.FormatBool(want))
+		var va, vb any = a, b
+		if cs.byPtr {
+			va, vb = &a, &b
+		}
+		name := fmt.Sprintf("(%+v, %+v)", a, b)
+		if !expect(c, ht, "EqualExportedValues"+name, want, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, va, vb) }, shape...) {
+			return
+		}
+		if !expect(c, ht, "EqualExportedValues(b,a)"+name, want, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, vb, va) }, shape...) {
+			return
+		}
+		if !want {
+			return
+		}
+		// changing unexported fields keeps them equal
+		b2 := b
+		b2.u++
+		b2.t.B = "z"
+		expect(c, ht, "EqualExportedValues(unexported changed)"+name, true, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, a, b2) }, shape...)
+	})
+}
