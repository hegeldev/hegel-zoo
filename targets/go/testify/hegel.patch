+
+var nilLeafCases = hegel.Composite(func(tc hegel.TestCase) nilLeafCase {
+	return nilLeafCase{
+		a:     hegel.Draw(tc, xTrees),
+		where: hegel.Draw(tc, shaped(hegel.Integers(0, 1), hegel.Just(-1))),
+		other: hegel.Draw(tc, xTrees),
+	}
+})
+
+// TestHegelEqualExportedValuesKeepsNilInterfaces: EqualExportedValues on structures holding a
+// nil interface in a map or list is DeepEqual of the exported copies; testify/13 drops the map
+// entry and panics on the list element.
+func TestHegelEqualExportedValuesKeepsNilInterfaces(t *testing.T) {
+	c := newCollector(t)
