+package assert_test
+
+// Equality: Equal, NotEqual, Exactly, ObjectsAreEqual, IsType, Same, NotSame, Empty, Zero, Nil
+// and Len against models of their documentation; EqualValues against exact arithmetic;
+// EqualExportedValues against an independent exported-fields copy.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+type S struct {
+	A int
+	B string
+}
+
+type myInt int
+
+// --------------------------------------------------------------------------- values
+
+// genValue: a value of one of a dozen types, with the shapes the assertions treat specially
+// (nil, typed nil pointers/slices/maps, empty and non-empty collections, pointers to zero
+// structs, nested interfaces).
+func genValue(tc hegel.TestCase, depth int) any {
+	switch n(tc, 0, 16) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2:
+		return n(tc, -3, 3)
+	case 3:
+		return int64(n(tc, -3, 3))
+	case 4:
+		return uint8(n(tc, 0, 3))
+	case 5:
+		return pick(tc, []float64{0, 1, 1.5, -2, 1e300, math.SmallestNonzeroFloat64})
+	case 6:
+		return pick(tc, []string{"", "a", "ab", "b", "<int Value>"})
+	case 7:
+		switch n(tc, 0, 2) {
+		case 0:
+			return []byte(nil)
+		case 1:
+			return []byte{}
+		}
+		return []byte(pick(tc, []string{"a", "ab"}))
+	case 8:
+		switch n(tc, 0, 2) {
+		case 0:
+			return []int(nil)
+		case 1:
+			return []int{}
+		}
+		xs := make([]int, n(tc, 1, 3))
+		for i := range xs {
+			xs[i] = n(tc, 0, 2)
+		}
+		return xs
+	case 9:
+		return [2]int{n(tc, 0, 1), n(tc, 0, 1)}
+	case 10:
+		switch n(tc, 0, 2) {
+		case 0:
+			return map[string]int(nil)
+		case 1:
+			return map[string]int{}
+		}
+		m := map[string]int{}
+		for k := n(tc, 1, 2); k > 0; k-- {
+			m[pick(tc, []string{"a", "b"})] = n(tc, 0, 1)
+		}
+		return m
+	case 11:
+		return S{n(tc, 0, 1), pick(tc, []string{"", "x"})}
+	case 12:
+		if chance(tc, 30) {
+			return (*S)(nil)
+		}
+		return &S{n(tc, 0, 1), pick(tc, []string{"", "x"})}
+	case 13:
+		if chance(tc, 30) {
+			return chan int(nil)
+		}
+		ch := make(chan int, 1)
+		if chance(tc, 50) {
+			ch <- 1
+		}
+		return ch
+	case 14:
+		if depth > 1 {
+			return myInt(n(tc, 0, 2))
+		}
+		xs := make([]any, n(tc, 0, 2))
+		for i := range xs {
+			xs[i] = genValue(tc, depth+1)
+		}
+		return xs
+	case 15:
+		return errors.New(pick(tc, []string{"e", "f"}))
+	}
+	return time.Duration(n(tc, -1, 2)) * time.Second
+}
+
+// clone: a distinct value with the same content (pointers get a new pointee).
+func clone(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		if x == nil {
+			return []byte(nil)
+		}
+		return append([]byte{}, x...)
+	case []int:
+		if x == nil {
+			return []int(nil)
+		}
+		return append([]int{}, x...)
+	case map[string]int:
+		if x == nil {
+			return map[string]int(nil)
+		}
+		m := map[string]int{}
+		for k, v := range x {
+			m[k] = v
+		}
+		return m
+	case *S:
+		if x == nil {
+			return (*S)(nil)
+		}
+		s := *x
+		return &s
+	case []any:
+		if x == nil {
+			return []any(nil)
+		}
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = clone(x[i])
+		}
+		return out
+	case error:
+		return errors.New(x.Error())
+	}
+	return v
+}
+
+// modelEqual: Equal's documented rule (DeepEqual, []byte compared by content with nil distinct
+// from empty, nil equal to nil only).
+func modelEqual(a, b any) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if ab, ok := a.([]byte); ok {
+		bb, ok := b.([]byte)
+		if !ok {
+			return false
+		}
+		if ab == nil || bb == nil {
+			return ab == nil && bb == nil
+		}
+		return bytes.Equal(ab, bb)
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func modelEmpty(v any) bool {
+	if v == nil {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Map, reflect.Slice:
+		return rv.Len() == 0
+	case reflect.Ptr:
+		if rv.IsNil() {
+			return true
+		}
+		return modelEmpty(rv.Elem().Interface())
+	}
+	return rv.IsZero()
+}
+
+func modelZero(v any) bool {
+	if v == nil {
+		return true
+	}
+	return reflect.DeepEqual(v, reflect.Zero(reflect.TypeOf(v)).Interface())
+}
+
+func modelNil(v any) bool {
+	if v == nil {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice, reflect.UnsafePointer:
+		return rv.IsNil()
+	}
+	return false
+}
+
+func modelLen(v any) (int, bool) {
+	if v == nil {
+		return 0, false
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Array, reflect.Chan, reflect.Map, reflect.Slice, reflect.String:
+		return rv.Len(), true
+	}
+	return 0, false
+}
+
+func isPtr(v any) bool { return v != nil && reflect.TypeOf(v).Kind() == reflect.Ptr }
+
+// TestHegelEqualityFollowsTheModel: Equal is DeepEqual with the documented []byte rule,
+// NotEqual its negation, Exactly adds a type check, IsType compares types, Same is pointer
+// identity, and Empty, Zero, Nil, Len follow their documentation with NotX = !X.
+func TestHegelEqualityFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genValue(ht, 0)
+		var b any
+		switch n(ht, 0, 2) {
+		case 0:
+			b = a
+		case 1:
+			b = clone(a)
+		default:
+			b = genValue(ht, 0)
+		}
+		eq := modelEqual(a, b)
+		c.count("eq=" + strconv.FormatBool(eq))
+		name := fmt.Sprintf("(%T %#v, %T %#v)", a, a, b, b)
+		if !expect(c, ht, "Equal"+name, eq, func(t assert.TestingT) bool { return assert.Equal(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Equal(b,a)"+name, eq, func(t assert.TestingT) bool { return assert.Equal(t, b, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotEqual"+name, !eq, func(t assert.TestingT) bool { return assert.NotEqual(t, a, b) }) {
+			return
+		}
+		if got := assert.ObjectsAreEqual(a, b); got != eq {
+			c.fail(ht, "ObjectsAreEqual%s = %v, want %v", name, got, eq)
+			return
+		}
+		sameType := reflect.TypeOf(a) == reflect.TypeOf(b)
+		if !expect(c, ht, "Exactly"+name, eq && sameType, func(t assert.TestingT) bool { return assert.Exactly(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "IsType"+name, sameType, func(t assert.TestingT) bool { return assert.IsType(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "IsNotType"+name, !sameType, func(t assert.TestingT) bool { return assert.IsNotType(t, a, b) }) {
+			return
+		}
+		if isPtr(a) && isPtr(b) {
+			same := sameType && reflect.ValueOf(a).Pointer() == reflect.ValueOf(b).Pointer()
+			if !expect(c, ht, "Same"+name, same, func(t assert.TestingT) bool { return assert.Same(t, a, b) }) {
+				return
+			}
+			if !expect(c, ht, "NotSame"+name, !same, func(t assert.TestingT) bool { return assert.NotSame(t, a, b) }) {
+				return
+			}
+		} else {
+			if !expect(c, ht, "Same"+name, false, func(t assert.TestingT) bool { return assert.Same(t, a, b) }) {
+				return
+			}
+			if !Known.notSameReturn {
+				if !expect(c, ht, "NotSame"+name, false, func(t assert.TestingT) bool { return assert.NotSame(t, a, b) }) {
+					return
+				}
+			}
+		}
+		// single-value assertions on a
+		an := fmt.Sprintf("(%T %#v)", a, a)
+		empty := modelEmpty(a)
+		if !expect(c, ht, "Empty"+an, empty, func(t assert.TestingT) bool { return assert.Empty(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotEmpty"+an, !empty, func(t assert.TestingT) bool { return assert.NotEmpty(t, a) }) {
+			return
+		}
+		zero := modelZero(a)
+		if !expect(c, ht, "Zero"+an, zero, func(t assert.TestingT) bool { return assert.Zero(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotZero"+an, !zero, func(t assert.TestingT) bool { return assert.NotZero(t, a) }) {
+			return
+		}
+		if zero && !empty {
+			c.fail(ht, "%s is zero but not empty", an)
+			return
+		}
+		isNil := modelNil(a)
+		if !expect(c, ht, "Nil"+an, isNil, func(t assert.TestingT) bool { return assert.Nil(t, a) }) {
+			return
+		}
+		if !expect(c, ht, "NotNil"+an, !isNil, func(t assert.TestingT) bool { return assert.NotNil(t, a) }) {
+			return
+		}
+		l, ok := modelLen(a)
+		k := n(ht, 0, 3)
+		if !expect(c, ht, "Len"+an+strconv.Itoa(k), ok && l == k, func(t assert.TestingT) bool { return assert.Len(t, a, k) }) {
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- EqualValues
+
+var numTypes = []string{"int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "float32", "float64"}
+
+func numSigned(typ string) bool { return typ[0] == 'i' }
+func numFloat(typ string) bool  { return typ[0] == 'f' }
+func numBits(typ string) int {
+	switch typ {
+	case "int", "uint", "int64", "uint64", "float64":
+		return 64
+	case "int32", "uint32", "float32":
+		return 32
+	case "int16", "uint16":
+		return 16
+	}
+	return 8
+}
+
+// genNum: a value of the numeric type and its exact value.
+func genNum(tc hegel.TestCase, typ string) (any, *big.Float) {
+	bits := numBits(typ)
+	var v int64
+	var u uint64
+	if numFloat(typ) {
+		f := pick(tc, []float64{0, 1, -1, 2, 3, 1.5, -2.5, 0.1, 100, 1 << 24, 1<<24 + 1, 1e10, 1e300, -1e300, 0.5, 65535, 255, 127, -128})
+		if bits == 32 {
+			f32 := float32(f)
+			return f32, new(big.Float).SetPrec(200).SetFloat64(float64(f32))
+		}
+		return f, new(big.Float).SetPrec(200).SetFloat64(f)
+	}
+	if numSigned(typ) {
+		max := int64(1)<<(bits-1) - 1
+		min := -max - 1
+		v = pick(tc, []int64{0, 1, -1, 2, 3, 100, 127, -128, 255, 65535, -56, 1 << 24, 1<<24 + 1, max, min, max - 1, min + 1})
+		if v > max {
+			v = max
+		}
+		if v < min {
+			v = min
+		}
+		var out any
+		switch typ {
+		case "int":
+			out = int(v)
+		case "int8":
+			out = int8(v)
+		case "int16":
+			out = int16(v)
+		case "int32":
+			out = int32(v)
+		default:
+			out = int64(v)
+		}
+		return out, new(big.Float).SetPrec(200).SetInt64(v)
+	}
+	max := uint64(1)<<bits - 1
+	u = pick(tc, []uint64{0, 1, 2, 3, 100, 127, 128, 200, 255, 65535, 1 << 24, 1<<24 + 1, 1 << 63, max, max - 1, uint64(1)<<(bits-1) - 1})
+	if u > max {
+		u = max
+	}
+	var out any
+	switch typ {
+	case "uint":
+		out = uint(u)
+	case "uint8":
+		out = uint8(u)
+	case "uint16":
+		out = uint16(u)
+	case "uint32":
+		out = uint32(u)
+	default:
+		out = uint64(u)
+	}
+	return out, new(big.Float).SetPrec(200).SetUint64(u)
+}
+
+// safePair: false while the recorded EqualValues bugs would make the pair misreport.
+func safePair(ta, tb string, va, vb *big.Float) bool {
+	if numFloat(ta) != numFloat(tb) {
+		if Known.floatTruncation || Known.intRounding {
+			// integral floats below 2^24, integers below 2^24: exact either way
+			lim := big.NewFloat(1 << 24)
+			for _, v := range []*big.Float{va, vb} {
+				if !v.IsInt() || new(big.Float).Abs(v).Cmp(lim) >= 0 {
+					return false
+				}
+			}
+		}
+		return true
+	}
+	if numFloat(ta) {
+		return true
+	}
+	if numSigned(ta) == numSigned(tb) {
+		return true
+	}
+	if Known.sameSizeWrap {
+		sv, uv := va, vb
+		if numSigned(tb) {
+			sv, uv = vb, va
+		}
+		if sv.Sign() < 0 {
+			return false
+		}
+		bits := numBits(ta)
+		if numBits(tb) < bits {
+			bits = numBits(tb)
+		}
+		lim := new(big.Float).SetMantExp(big.NewFloat(1), bits-1)
+		if uv.Cmp(lim) >= 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelEqualValuesFollowsTheModel: EqualValues on two numbers is exact mathematical
+// equality, symmetric, with NotEqualValues its negation; on a string and a []byte it is
+// content equality; on a named integer and its base type, value equality; on a slice and an
+// array of the same length, element equality.
+func TestHegelEqualValuesFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		var a, b any
+		var want bool
+		var class string
+		switch n(ht, 0, 9) {
+		case 0:
+			// string and []byte
+			sa := pick(ht, []string{"", "a", "ab"})
+			sb := pick(ht, []string{"", "a", "ab"})
+			a, b = sa, []byte(sb)
+			if chance(ht, 50) {
+				a, b = b, a
+			}
+			want = sa == sb
+			class = "string/bytes"
+		case 1:
+			// named int and int
+			x, y := n(ht, 0, 2), n(ht, 0, 2)
+			a, b = myInt(x), y
+			if chance(ht, 50) {
+				a, b = b, a
+			}
+			want = x == y
+			class = "named"
+		case 2:
+			// slice and array of the same length
+			k := n(ht, 0, 3)
+			xs := make([]int, k)
+			arr := reflect.New(reflect.ArrayOf(k, reflect.TypeOf(0))).Elem()
+			want = true
+			for i := range xs {
+				xs[i] = n(ht, 0, 1)
+				y := n(ht, 0, 1)
+				arr.Index(i).SetInt(int64(y))
+				if y != xs[i] {
+					want = false
+				}
+			}
+			// Go converts a slice to an array, not an array to a slice: the slice is expected
+			a, b = xs, arr.Interface()
+			class = "slice/array"
+		default:
+			ta, tb := pick(ht, numTypes), pick(ht, numTypes)
+			va, fa := genNum(ht, ta)
+			vb, fb := genNum(ht, tb)
+			if !safePair(ta, tb, fa, fb) {
+				return
+			}
+			a, b = va, vb
+			want = fa.Cmp(fb) == 0
+			class = "num"
+			if ta != tb {
+				class = "num-mixed"
+			}
+		}
+		c.count(class + "=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%T %#v, %T %#v)", a, a, b, b)
+		if !expect(c, ht, "EqualValues"+name, want, func(t assert.TestingT) bool { return assert.EqualValues(t, a, b) }) {
+			return
+		}
+		if class != "slice/array" {
+			if !expect(c, ht, "EqualValues(b,a)"+name, want, func(t assert.TestingT) bool { return assert.EqualValues(t, b, a) }) {
+				return
+			}
+		}
+		if !expect(c, ht, "NotEqualValues"+name, !want, func(t assert.TestingT) bool { return assert.NotEqualValues(t, a, b) }) {
+			return
+		}
+		if got := assert.ObjectsAreEqualValues(a, b); got != want {
+			c.fail(ht, "ObjectsAreEqualValues%s = %v, want %v", name, got, want)
+			return
+		}
+		// Equal implies EqualValues
+		if assert.ObjectsAreEqual(a, b) && !want {
+			c.fail(ht, "ObjectsAreEqual%s but the model says the values differ", name)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- EqualExportedValues
+
+// X: a struct with exported and unexported fields, nested through pointers, maps, slices and
+// interfaces.
+type X struct {
+	E int
+	u int
+	P *X
+	M map[string]any
+	L []any
+	I any
+	T S
+	t S
+}
+
+func genX(tc hegel.TestCase, depth int) X {
+	x := X{E: n(tc, 0, 1), u: n(tc, 0, 1), T: S{n(tc, 0, 1), ""}, t: S{n(tc, 0, 1), ""}}
+	if depth < 2 {
+		if chance(tc, 40) {
+			p := genX(tc, depth+1)
+			x.P = &p
+		}
+		if chance(tc, 40) {
+			x.M = map[string]any{}
+			for k := n(tc, 0, 2); k > 0; k-- {
+				x.M[pick(tc, []string{"a", "b"})] = genLeafAny(tc, depth+1)
+			}
+		}
+		if chance(tc, 40) {
+			x.L = []any{}
+			for k := n(tc, 0, 2); k > 0; k-- {
+				x.L = append(x.L, genLeafAny(tc, depth+1))
+			}
+		}
+		if chance(tc, 40) {
+			x.I = genLeafAny(tc, depth+1)
+		}
+	}
+	return x
+}
+
+func genLeafAny(tc hegel.TestCase, depth int) any {
+	switch n(tc, 0, 3) {
+	case 0:
+		return n(tc, 0, 1)
+	case 1:
+		return pick(tc, []string{"a", "b"})
+	case 2:
+		return genX(tc, depth)
+	}
+	x := genX(tc, depth)
+	return &x
+}
+
+// exported: a copy of v with unexported struct fields zeroed, computed independently.
+func exported(v any) any {
+	if v == nil {
+		return nil
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Struct:
+		out := reflect.New(rv.Type()).Elem()
+		for i := 0; i < rv.NumField(); i++ {
+			if !rv.Type().Field(i).IsExported() {
+				continue
+			}
+			f := rv.Field(i)
+			if f.Kind() == reflect.Interface && f.IsNil() {
+				continue
+			}
+			if f.Kind() == reflect.Ptr && f.IsNil() {
+				continue
+			}
+			out.Field(i).Set(reflect.ValueOf(exported(f.Interface())))
+		}
+		return out.Interface()
+	case reflect.Ptr:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.New(rv.Type().Elem())
+		out.Elem().Set(reflect.ValueOf(exported(rv.Elem().Interface())))
+		return out.Interface()
+	case reflect.Slice:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.MakeSlice(rv.Type(), rv.Len(), rv.Len())
+		for i := 0; i < rv.Len(); i++ {
+			e := exported(rv.Index(i).Interface())
+			if e != nil {
+				out.Index(i).Set(reflect.ValueOf(e))
+			}
+		}
+		return out.Interface()
+	case reflect.Map:
+		if rv.IsNil() {
+			return v
+		}
+		out := reflect.MakeMap(rv.Type())
+		for _, k := range rv.MapKeys() {
+			e := exported(rv.MapIndex(k).Interface())
+			if e == nil {
+				out.SetMapIndex(k, reflect.Zero(rv.Type().Elem()))
+			} else {
+				out.SetMapIndex(k, reflect.ValueOf(e))
+			}
+		}
+		return out.Interface()
+	}
+	return v
+}
+
+// TestHegelEqualExportedValuesFollowsTheModel: EqualExportedValues on two X values (or
+// pointers) is DeepEqual of their exported-only copies; unexported fields never matter;
+// symmetric; a value equals a copy of itself with the unexported fields changed.
+func TestHegelEqualExportedValuesFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genX(ht, 0)
+		var b X
+		switch n(ht, 0, 2) {
+		case 0:
+			b = a
+			b.u = 1 - a.u
+			b.t.A = 1 - a.t.A
+		case 1:
+			b = a
+			if chance(ht, 50) {
+				b.E = 1 - a.E
+			} else {
+				b.T.A = 1 - a.T.A
+			}
+		default:
+			b = genX(ht, 0)
+		}
+		want := reflect.DeepEqual(exported(a), exported(b))
+		c.count("eq=" + strconv.FormatBool(want))
+		var va, vb any = a, b
+		if chance(ht, 30) {
+			va, vb = &a, &b
+		}
+		name := fmt.Sprintf("(%+v, %+v)", a, b)
+		if !expect(c, ht, "EqualExportedValues"+name, want, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, va, vb) }) {
+			return
+		}
+		if !expect(c, ht, "EqualExportedValues(b,a)"+name, want, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, vb, va) }) {
+			return
+		}
+		if !want {
+			return
+		}
+		// changing unexported fields keeps them equal
+		b2 := b
+		b2.u++
+		b2.t.B = "z"
+		expect(c, ht, "EqualExportedValues(unexported changed)"+name, true, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, a, b2) })
+	})
+}
diff --git a/assert/hegel_pins_test.go b/assert/hegel_pins_test.go
new file mode 100644
index 0000000..4479cec
--- /dev/null
+++ b/assert/hegel_pins_test.go
@@ -0,0 +1,205 @@
+package assert_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// pin runs an assertion on a fresh mockT and reports a panic as a test failure.
+func pin(t *testing.T, name string, f func(t assert.TestingT) bool) (ok bool, reported []string) {
+	t.Helper()
+	m := &mockT{}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("%s panicked: %v", name, r)
+		}
+	}()
+	ok = f(m)
+	return ok, m.msgs
+}
+
+func pinExpect(t *testing.T, name string, want bool, f func(t assert.TestingT) bool) {
+	t.Helper()
+	got, _ := pin(t, name, f)
+	if got != want {
+		t.Errorf("%s = %v, want %v", name, got, want)
+	}
+}
+
+// testify/1: a negative integer never equals an unsigned one.
+func TestHegelPinEqualValuesSignedUnsigned(t *testing.T) {
+	pinExpect(t, "EqualValues(int8(-1), uint8(255))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int8(-1), uint8(255)) })
+	pinExpect(t, "EqualValues(int8(-1), uint16(65535))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int8(-1), uint16(65535)) })
+	pinExpect(t, "EqualValues(uint64(1<<63), int64(MinInt64))", false, func(m assert.TestingT) bool {
+		return assert.EqualValues(m, uint64(1<<63), int64(math.MinInt64))
+	})
+	pinExpect(t, "EqualValues(int64(-1), uint64(MaxUint64))", false, func(m assert.TestingT) bool {
+		return assert.EqualValues(m, int64(-1), uint64(math.MaxUint64))
+	})
+}
+
+// testify/2: a float with a fraction never equals an integer.
+func TestHegelPinEqualValuesFloatTruncation(t *testing.T) {
+	pinExpect(t, "EqualValues(1, 1.5)", false, func(m assert.TestingT) bool { return assert.EqualValues(m, 1, 1.5) })
+	pinExpect(t, "EqualValues(int64(1), float32(1.9))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int64(1), float32(1.9)) })
+	pinExpect(t, "EqualValues(int64(MinInt64), 1e300)", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int64(math.MinInt64), 1e300) })
+}
+
+// testify/3: EqualValues is symmetric; an integer a float cannot represent does not equal it.
+func TestHegelPinEqualValuesSymmetric(t *testing.T) {
+	a, b := assert.ObjectsAreEqualValues(float32(16777216), int32(16777217)), assert.ObjectsAreEqualValues(int32(16777217), float32(16777216))
+	if a != b {
+		t.Errorf("ObjectsAreEqualValues(float32(16777216), int32(16777217)) = %v but the other way round %v", a, b)
+	}
+	pinExpect(t, "EqualValues(float32(16777216), int32(16777217))", false, func(m assert.TestingT) bool {
+		return assert.EqualValues(m, float32(16777216), int32(16777217))
+	})
+}
+
+// testify/4: an integer does not equal a string (and if it did, both ways round).
+func TestHegelPinEqualValuesIntString(t *testing.T) {
+	a, b := assert.ObjectsAreEqualValues(65, "A"), assert.ObjectsAreEqualValues("A", 65)
+	if a != b {
+		t.Errorf("ObjectsAreEqualValues(65, \"A\") = %v but ObjectsAreEqualValues(\"A\", 65) = %v", a, b)
+	}
+	pinExpect(t, "EqualValues(65, \"A\")", false, func(m assert.TestingT) bool { return assert.EqualValues(m, 65, "A") })
+}
+
+// testify/5: EqualValues on a slice and a longer array fails instead of panicking.
+func TestHegelPinEqualValuesSliceArray(t *testing.T) {
+	pinExpect(t, "EqualValues([]int{1}, [2]int{1, 0})", false, func(m assert.TestingT) bool { return assert.EqualValues(m, []int{1}, [2]int{1, 0}) })
+	pinExpect(t, "NotEqualValues([]int{1}, [2]int{1, 0})", true, func(m assert.TestingT) bool { return assert.NotEqualValues(m, []int{1}, [2]int{1, 0}) })
+}
+
+// testify/6: a string contains a non-string element only if it is a substring of it: 42 is not
+// a substring of "x <int Value> y".
+func TestHegelPinContainsStringNonString(t *testing.T) {
+	pinExpect(t, "Contains(\"x <int Value> y\", 42)", false, func(m assert.TestingT) bool { return assert.Contains(m, "x <int Value> y", 42) })
+	pinExpect(t, "Contains(\"<invalid Value>\", nil)", false, func(m assert.TestingT) bool { return assert.Contains(m, "<invalid Value>", nil) })
+	pinExpect(t, "NotContains(\"x <int Value> y\", 42)", true, func(m assert.TestingT) bool { return assert.NotContains(m, "x <int Value> y", 42) })
+}
+
+// testify/7: collection and sign assertions fail on nil instead of panicking.
+func TestHegelPinNilArgumentsFail(t *testing.T) {
+	pinExpect(t, "Subset(nil, []int{1})", false, func(m assert.TestingT) bool { return assert.Subset(m, nil, []int{1}) })
+	pinExpect(t, "NotSubset(nil, []int{1})", true, func(m assert.TestingT) bool { return assert.NotSubset(m, nil, []int{1}) })
+	pinExpect(t, "ElementsMatch(nil, []int{1})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, nil, []int{1}) })
+	pinExpect(t, "NotElementsMatch(nil, []int{1})", true, func(m assert.TestingT) bool { return assert.NotElementsMatch(m, nil, []int{1}) })
+	pinExpect(t, "IsIncreasing(nil)", false, func(m assert.TestingT) bool { return assert.IsIncreasing(m, nil) })
+	pinExpect(t, "Positive(nil)", false, func(m assert.TestingT) bool { return assert.Positive(m, nil) })
+	pinExpect(t, "Negative(nil)", false, func(m assert.TestingT) bool { return assert.Negative(m, nil) })
+}
+
+// testify/8: ElementsMatch takes arrays and slices only, empty or not.
+func TestHegelPinElementsMatchEmptyNonList(t *testing.T) {
+	pinExpect(t, "ElementsMatch(map{a:1}, []int{1})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, map[string]int{"a": 1}, []int{1}) })
+	pinExpect(t, "ElementsMatch(map{}, []int{})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, map[string]int{}, []int{}) })
+	pinExpect(t, "ElementsMatch(\"\", 0)", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, "", 0) })
+}
+
+// testify/9: PanicsWithValue fails, rather than panicking, when the panic value is not
+// comparable.
+func TestHegelPinPanicsWithValueUncomparable(t *testing.T) {
+	pinExpect(t, "PanicsWithValue([]int{1}, panic([]int{1}))", false, func(m assert.TestingT) bool {
+		return assert.PanicsWithValue(m, []int{1}, func() { panic([]int{1}) })
+	})
+	pinExpect(t, "PanicsWithValue(\"x\", panic([]int{1}))", false, func(m assert.TestingT) bool {
+		return assert.PanicsWithValue(m, "x", func() { panic([]int{1}) })
+	})
+}
+
+// testify/10: a NaN delta is rejected as a NaN epsilon is.
+func TestHegelPinInDeltaNaNDelta(t *testing.T) {
+	pinExpect(t, "InEpsilon(1, 100, NaN)", false, func(m assert.TestingT) bool { return assert.InEpsilon(m, 1, 100, math.NaN()) })
+	pinExpect(t, "InDelta(1, 100, NaN)", false, func(m assert.TestingT) bool { return assert.InDelta(m, 1, 100, math.NaN()) })
+}
+
+// testify/11: InDeltaSlice compares the lengths as InEpsilonSlice does.
+func TestHegelPinInDeltaSliceLength(t *testing.T) {
+	pinExpect(t, "InEpsilonSlice([1,2,3], [1], 0.1)", false, func(m assert.TestingT) bool { return assert.InEpsilonSlice(m, []float64{1, 2, 3}, []float64{1}, 0.1) })
+	pinExpect(t, "InDeltaSlice([1,2,3], [1], 0)", false, func(m assert.TestingT) bool { return assert.InDeltaSlice(m, []float64{1, 2, 3}, []float64{1}, 0) })
+	pinExpect(t, "InDeltaSlice([1], [1,2,3], 0)", false, func(m assert.TestingT) bool { return assert.InDeltaSlice(m, []float64{1}, []float64{1, 2, 3}, 0) })
+}
+
+// testify/12: Greater & co fail, rather than panicking, on two structs or two slices of
+// different types.
+func TestHegelPinCompareDifferentTypesFail(t *testing.T) {
+	pinExpect(t, "Greater(time.Time, struct{}{})", false, func(m assert.TestingT) bool { return assert.Greater(m, time.Now(), struct{}{}) })
+	pinExpect(t, "Less([]byte, []int)", false, func(m assert.TestingT) bool { return assert.Less(m, []byte("a"), []int{1}) })
+	pinExpect(t, "Greater(1, int64(0))", false, func(m assert.TestingT) bool { return assert.Greater(m, 1, int64(0)) })
+}
+
+// testify/13: EqualExportedValues keeps nil interface values in maps and slices.
+func TestHegelPinEqualExportedValuesNilInterface(t *testing.T) {
+	pinExpect(t, "EqualExportedValues(map{a:nil}, map{})", false, func(m assert.TestingT) bool {
+		return assert.EqualExportedValues(m, map[string]any{"a": nil}, map[string]any{})
+	})
+	pinExpect(t, "EqualExportedValues(map{a:nil}, map{b:nil})", false, func(m assert.TestingT) bool {
+		return assert.EqualExportedValues(m, map[string]any{"a": nil}, map[string]any{"b": nil})
+	})
+	pinExpect(t, "EqualExportedValues([]any{nil}, []any{nil})", true, func(m assert.TestingT) bool {
+		return assert.EqualExportedValues(m, []any{nil}, []any{nil})
+	})
+	pinExpect(t, "EqualExportedValues([]any{nil}, []any{1})", false, func(m assert.TestingT) bool {
+		return assert.EqualExportedValues(m, []any{nil}, []any{1})
+	})
+}
+
+// testify/14: two documents with different integers are not equal.
+func TestHegelPinJSONEqLargeIntegers(t *testing.T) {
+	pinExpect(t, "JSONEq(9007199254740993, 9007199254740992)", false, func(m assert.TestingT) bool {
+		return assert.JSONEq(m, `{"id": 9007199254740993}`, `{"id": 9007199254740992}`)
+	})
+	pinExpect(t, "YAMLEq(99999999999999999999, 99999999999999999998)", false, func(m assert.TestingT) bool {
+		return assert.YAMLEq(m, "id: 99999999999999999999", "id: 99999999999999999998")
+	})
+}
+
+// testify/15: an assertion that reports a failure returns false.
+func TestHegelPinNotSameReturnValue(t *testing.T) {
+	ok, msgs := pin(t, "NotSame(1, 2)", func(m assert.TestingT) bool { return assert.NotSame(m, 1, 2) })
+	if ok && len(msgs) > 0 {
+		t.Errorf("NotSame(1, 2) returned true after reporting %d failure(s)", len(msgs))
+	}
+}
+
+// testify/16: NotElementsMatch reports the caller's message like every other assertion, and
+// a type failure once.
+func TestHegelPinNotElementsMatchMessage(t *testing.T) {
+	_, msgs := pin(t, "NotElementsMatch([1], [1], msg)", func(m assert.TestingT) bool {
+		return assert.NotElementsMatch(m, []int{1}, []int{1}, "hegel marker %d", 7)
+	})
+	if len(msgs) != 1 || !strings.Contains(msgs[0], "\thegel marker 7\n") {
+		t.Errorf("NotElementsMatch with a message reported %q, want a Messages line ending in \"hegel marker 7\"", msgs)
+	}
+	_, msgs = pin(t, "NotElementsMatch([1], [1])", func(m assert.TestingT) bool { return assert.NotElementsMatch(m, []int{1}, []int{1}) })
+	if len(msgs) != 1 || strings.Contains(msgs[0], "Messages:") {
+		t.Errorf("NotElementsMatch without a message reported %q, want no Messages line", msgs)
+	}
+	_, msgs = pin(t, "NotElementsMatch(1, [1])", func(m assert.TestingT) bool { return assert.NotElementsMatch(m, 1, []int{1}) })
+	if len(msgs) != 1 {
+		t.Errorf("NotElementsMatch(1, []int{1}) reported %d failures, want 1", len(msgs))
+	}
+}
+
+// testify/17: Positive and Negative are for numbers.
+func TestHegelPinPositiveNumbersOnly(t *testing.T) {
+	pinExpect(t, "Positive(\"a\")", false, func(m assert.TestingT) bool { return assert.Positive(m, "a") })
+	pinExpect(t, "Positive([]byte(\"a\"))", false, func(m assert.TestingT) bool { return assert.Positive(m, []byte("a")) })
+	pinExpect(t, "Positive(time.Now())", false, func(m assert.TestingT) bool { return assert.Positive(m, time.Now()) })
+}
+
+// testify/18: an array of zero values has elements; it does not match an empty list.
+func TestHegelPinElementsMatchZeroArray(t *testing.T) {
+	pinExpect(t, "ElementsMatch([1]int{0}, []int{})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [1]int{0}, []int{}) })
+	pinExpect(t, "ElementsMatch([2]int{}, [1]int{})", false, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [2]int{}, [1]int{}) })
+	pinExpect(t, "NotElementsMatch([1]int{0}, []int{})", true, func(m assert.TestingT) bool { return assert.NotElementsMatch(m, [1]int{0}, []int{}) })
+	pinExpect(t, "ElementsMatch([1]int{0}, []int{0})", true, func(m assert.TestingT) bool { return assert.ElementsMatch(m, [1]int{0}, []int{0}) })
+}
diff --git a/assert/hegel_test.go b/assert/hegel_test.go
new file mode 100644
index 0000000..5cab58d
--- /dev/null
+++ b/assert/hegel_test.go
@@ -0,0 +1,242 @@
+package assert_test
+
+// Hegel property tests for stretchr/testify's assert package, written for the Hegel zoo.
+// See targets/go/testify/README.md.
+//
+// Oracles: the documented meaning of each assertion restated as a small model (reflect.DeepEqual
+// with the documented []byte rule for Equal; exact arithmetic for EqualValues, InDelta and
+// InEpsilon; multiset equality for ElementsMatch; the Go ordering of the kind for Greater and
+// friends), the laws between assertions (NotX is the negation of X, Exactly implies Equal,
+// ElementsMatch is invariant under permutation, symmetry) and the contract every assertion
+// shares: the returned bool is true exactly when nothing was reported to the TestingT, and the
+// caller's message is reported verbatim.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// testify/1: EqualValues converts between a signed and an unsigned integer type of the same
+	// size, so int8(-1) equals uint8(255) and uint64(1<<63) equals int64(MinInt64). The
+	// numeric model avoids signed/unsigned pairs of the same size.
+	sameSizeWrap bool
+	// testify/2: EqualValues converts a float to the integer type by truncation: 1 equals 1.5,
+	// int64(MinInt64) equals 1e300. Integer/float pairs are generated with integral floats only.
+	floatTruncation bool
+	// testify/3: EqualValues converts an integer to float32/float64 when the float type is at
+	// least as wide, so int32(16777217) equals float32(16777216) in one argument order and not
+	// the other. Integer/float pairs stay below 2^24.
+	intRounding bool
+	// testify/4: EqualValues(65, "A") passes (the int to string rune conversion) but
+	// EqualValues("A", 65) fails. Not generated.
+	runeString bool
+	// testify/5: EqualValues panics when a slice is compared with a longer array. Slice/array
+	// pairs are generated with equal lengths.
+	sliceArrayPanic bool
+	// testify/6: Contains on a string with a non-string element matches the text of the
+	// element's reflect.Value.String() ("<int Value>"). Strings are searched for strings only.
+	containsValueText bool
+	// testify/7: Subset, NotSubset, ElementsMatch, NotElementsMatch, IsIncreasing & co,
+	// Positive and Negative panic on a nil argument instead of failing. nil is not generated.
+	nilPanics bool
+	// testify/8: ElementsMatch passes for two empty values of any type (an empty map, "", 0)
+	// while the same non-empty values fail with a type error. Non-list arguments are not
+	// generated for ElementsMatch.
+	emptyNonList bool
+	// testify/9: PanicsWithValue panics when the recovered value is not comparable (a slice).
+	// Only comparable panic values are generated.
+	uncomparablePanicValue bool
+	// testify/10: InDelta with a NaN delta passes (InEpsilon rejects a NaN epsilon). NaN deltas
+	// are not generated.
+	nanDelta bool
+	// testify/11: InDeltaSlice ignores the lengths: it passes when actual is shorter than
+	// expected and panics when it is longer. Generated slices have equal lengths.
+	deltaSliceLength bool
+	// testify/12: Greater & co panic when the two arguments are structs or slices of different
+	// types (the second is converted without a check). Both arguments share a type.
+	compareConvertPanic bool
+	// testify/13: EqualExportedValues drops map entries whose value is a nil interface and
+	// panics on a nil interface element of a slice or array. Generated interface values are
+	// never nil.
+	exportedNilInterface bool
+	// testify/14: JSONEq and YAMLEq decode integers into float64, so integers above 2^53 that
+	// differ compare equal. Generated integers stay below 2^53.
+	bigIntegers bool
+	// testify/15: NotSame returns true after reporting a failure when the arguments are not
+	// pointers. The contract property skips NotSame on non-pointers.
+	notSameReturn bool
+	// testify/16: NotElementsMatch reports the caller's message as a Go slice ("[my msg 7]",
+	// "[]" when there is none) and reports a type failure twice. The contract property does
+	// not check NotElementsMatch's message.
+	notElementsMatchMessage bool
+	// testify/17: Positive and Negative accept strings, byte slices and times. Only numbers are
+	// generated for them.
+	positiveStrings bool
+	// testify/18: ElementsMatch and NotElementsMatch treat an array of zero values as empty, so
+	// [1]int{0} matches []int{}. Zero arrays are not matched against lists of another length.
+	zeroArrayEmpty bool
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- mock TestingT
+
+// mockT records what an assertion reports.
+type mockT struct{ msgs []string }
+
+func (m *mockT) Errorf(format string, args ...interface{}) {
+	m.msgs = append(m.msgs, fmt.Sprintf(format, args...))
+}
+
+func (m *mockT) failed() bool { return len(m.msgs) > 0 }
+
+// run calls an assertion on a fresh mockT and returns its result, whether anything was reported
+// and the panic value if it panicked.
+func run(f func(t assert.TestingT) bool) (ok bool, reported int, panicked any) {
+	m := &mockT{}
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+			reported = len(m.msgs)
+		}
+	}()
+	ok = f(m)
+	return ok, len(m.msgs), nil
+}
+
+// check: the assertion's result agrees with what it reported, and no panic.
+func check(c *collector, ht *hegel.T, name string, f func(t assert.TestingT) bool) (bool, bool) {
+	ok, reported, p := run(f)
+	if p != nil {
+		c.fail(ht, "%s panicked: %v", name, p)
+		return false, false
+	}
+	if ok != (reported == 0) {
+		c.fail(ht, "%s returned %v but reported %d failure(s)", name, ok, reported)
+		return false, false
+	}
+	if reported > 1 {
+		c.fail(ht, "%s reported %d failures for one assertion", name, reported)
+		return false, false
+	}
+	return ok, true
+}
+
+// expect: run the assertion and compare with the model's verdict.
+func expect(c *collector, ht *hegel.T, name string, want bool, f func(t assert.TestingT) bool) bool {
+	got, fine := check(c, ht, name, f)
+	if !fine {
+		return false
+	}
+	if got != want {
+		c.fail(ht, "%s = %v, want %v", name, got, want)
+		return false
+	}
+	return true
+}
