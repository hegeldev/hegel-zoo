+// reportCarriesMessage: the report of a failed assertion has the caller's message (want; "" for
+// none) on its "Messages:" line, exactly once, and no such line without a message.
+func reportCarriesMessage(c *collector, ht *hegel.T, name, report, want string, shape []string) {
+	if want == "" {
+		if strings.Contains(report, "Messages:") {
+			c.mismatch(ht, shape, "%s reported a Messages line without a message:\n%s", name, report)
+		}
+		return
+	}
+	found := 0
+	for _, l := range strings.Split(report, "\n") {
+		if strings.Contains(l, "Messages:") {
+			if !strings.HasSuffix(l, "\t"+want) {
+				c.mismatch(ht, shape, "%s Messages line %q does not end with the message %q", name, l, want)
+				return
+			}
+			found++
+		}
+	}
+	if found != 1 {
+		c.mismatch(ht, shape, "%s report has %d Messages lines, want 1:\n%s", name, found, report)
+		return
+	}
+	if strings.Count(report, want) != 1 {
+		c.mismatch(ht, shape, "%s report mentions the message %d times:\n%s", name, strings.Count(report, want), report)
+	}
+}
+
+// TestHegelAssertionsKeepTheContract: on generated arguments every assertion returns true iff
+// it reported nothing, reports once, does not panic, and the report carries the caller's
+// formatted message on its "Messages:" line exactly once.
+func TestHegelAssertionsKeepTheContract(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, contractCases)
+		as := cs.assertions()
+		na := as[cs.pick%len(as)]
+		msgAndArgs, want := cs.msgAndArgs()
+		m := &mockT{}
+		var ok bool
+		var p any
+		func() {
+			defer func() { p = recover() }()
+			ok = na.f(m, msgAndArgs...)
+		}()
+		if p != nil {
+			c.mismatch(ht, na.shape, "%s panicked: %v", na.name, p)
+			return
+		}
+		c.count(na.name + "=" + strconv.FormatBool(ok))
+		if ok != (len(m.msgs) == 0) {
+			c.mismatch(ht, na.shape, "%s returned %v but reported %d failure(s)", na.name, ok, len(m.msgs))
+			return
+		}
+		if len(m.msgs) > 1 {
+			c.mismatch(ht, na.shape, "%s reported %d failures for one assertion", na.name, len(m.msgs))
+			return
+		}
+		if ok {
+			return
+		}
+		reportCarriesMessage(c, ht, na.name, m.msgs[0], want, na.shape)
+	})
+}
+
+// --------------------------------------------------------------------------- JSONEq / YAMLEq
+
+// bigLit is an integer literal beyond uint64, written as its digits.
+type bigLit string
+
+var (
+	smallInt64s = hegel.Map(hegel.Integers(-1000, 1000), func(n int) int64 { return int64(n) })
+	// docInts: a small integer, or (the shape of testify/14, left out under HEGEL_NO_KNOWN=1)
+	// one just above 2^53, where a float64 no longer tells neighbours apart.
+	docInts = shaped[hegel.Generator[int64]](weighted(
+		choice[int64]{3, smallInt64s},
+		choice[int64]{1, hegel.Map(hegel.Integers(0, 3), func(n int) int64 { return 9007199254740992 + int64(n) })},
+	), smallInt64s)
+	docFloats  = hegel.SampledFrom([]float64{0.5, -1.25, 100.75})
+	docStrings = hegel.SampledFrom([]string{"", "a", "hello world", "yes", "null", "1"})
+	docKeys    = hegel.SampledFrom([]string{"a", "b", "c", "d"})
+	bigLits    = hegel.Map(hegel.SampledFrom([]bigLit{"99999999999999999999", "18446744073709551617", "9007199254740993"}), func(l bigLit) any { return l })
+)
+
+// docs: a JSON value up to three containers deep: null, a bool, an integer, a float, a string,
+// an array of up to three values, an object of up to three members with distinct keys (each
+// as often as the others; at the depth bound only the scalars), and while the shapes are on a
+// big integer literal (testify/14).
+var docs = func() hegel.Generator[any] {
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	scalars := []hegel.Generator[any]{
+		hegel.Just[any](nil),
+		asAny(hegel.Booleans()),
+		asAny(docInts),
+		asAny(docFloats),
+		asAny(docStrings),
+	}
+	if !noKnown {
+		scalars = append(scalars, bigLits)
+	}
+	leaves := hegel.OneOf(scalars...)
+	lists := hegel.Map(many(child, 0, 3), nonNil[any])
+	maps := hegel.Map(hegel.Maps(docKeys, child).MaxSize(3), nonNilMap[string, any])
+	branches := hegel.OneOf(append(scalars, asAny(lists), asAny(maps))...)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth > 2 {
+			return hegel.Draw(tc, leaves)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branches)
+	})
+	return node
+}()
+
+// hasBigInt reports whether the document holds an integer above 2^53 (the shape of testify/14).
+func hasBigInt(v any) bool {
+	switch x := v.(type) {
+	case int64:
+		return x >= 1<<53 || x <= -(1<<53)
+	case bigLit:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasBigInt(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasBigInt(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+var wsPool = []string{"", " ", "\n", "  "}
+
+// serialise: JSON text for v with the object keys in the order the tape ranks them and the
+// tape's whitespace (an empty tape: sorted keys, no whitespace).
+func serialise(v any, t *tape) string {
+	ws := func() string { return wsPool[t.next(len(wsPool))] }
+	switch x := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return strconv.FormatBool(x)
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case bigLit:
+		return string(x)
+	case float64:
+		return strconv.FormatFloat(x, 'f', -1, 64)
+	case string:
+		b, _ := json.Marshal(x)
+		return string(b)
+	case []any:
+		parts := make([]string, len(x))
+		for i := range x {
+			parts[i] = serialise(x[i], t)
+		}
+		return "[" + ws() + strings.Join(parts, ","+ws()) + ws() + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		ranks := make([]int, len(keys))
+		for i := range keys {
+			ranks[i] = t.next(100)
+		}
+		keys = shuffled(keys, ranks)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			kb, _ := json.Marshal(k)
+			parts[i] = string(kb) + ":" + ws() + serialise(x[k], t)
+		}
+		return "{" + ws() + strings.Join(parts, ","+ws()) + ws() + "}"
+	}
+	panic(fmt.Sprintf("serialise: %T", v))
+}
+
+// mutate: a value that differs from v; the tape chooses whether an element of a container is
+// changed (60%) and which, else one is appended.
+func mutate(v any, t *tape) any {
+	switch x := v.(type) {
+	case nil:
+		return false
+	case bool:
+		return !x
+	case int64:
+		return x + 1
+	case bigLit:
+		last := x[len(x)-1]
+		if last == '9' {
+			return x[:len(x)-1] + "8"
+		}
+		return x[:len(x)-1] + bigLit(last+1)
+	case float64:
+		return x + 1
+	case string:
+		return x + "!"
+	case []any:
+		if len(x) > 0 && t.coin(60) {
+			ys := append([]any{}, x...)
+			i := t.next(len(ys))
+			ys[i] = mutate(ys[i], t)
+			return ys
+		}
+		return append(append([]any{}, x...), int64(7))
+	case map[string]any:
+		m := map[string]any{}
+		for k, val := range x {
+			m[k] = val
+		}
+		if len(m) > 0 && t.coin(60) {
+			keys := make([]string, 0, len(m))
+			for k := range m {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			k := keys[t.next(len(keys))]
+			m[k] = mutate(m[k], t)
+			return m
+		}
+		m["zz"] = int64(7)
+		return m
+	}
+	return math.NaN()
+}
+
+// jsonCase: a document, the tapes of its two serialisations and of the mutation, and whether
+// the second text is of the mutated document.
+type jsonCase struct {
+	doc      any
+	t1, t2   []int
+	tm       []int
+	mutated  bool
+	mutation []int
+}
+
+func (c jsonCase) texts() (s1, s2 string) {
+	s1 = serialise(c.doc, &tape{vals: c.t1})
+	doc := c.doc
+	if c.mutated {
+		doc = mutate(doc, &tape{vals: c.tm})
+	}
+	return s1, serialise(doc, &tape{vals: c.t2})
+}
+
+func (c jsonCase) GoString() string {
+	s1, s2 := c.texts()
+	return fmt.Sprintf("doc %#v\ns1 %s\ns2 %s (mutated=%v)", c.doc, s1, s2, c.mutated)
+}
+
+var jsonCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+	return jsonCase{
+		doc:     hegel.Draw(tc, docs),
+		t1:      hegel.Draw(tc, tapes),
+		t2:      hegel.Draw(tc, tapes),
+		tm:      hegel.Draw(tc, tapes),
+		mutated: hegel.Draw(tc, chance(50)),
+	}
+})
+
+// TestHegelJSONEqFollowsTheModel: two serialisations of one document are JSONEq (and YAMLEq,
+// JSON being YAML), a serialisation of a mutated document is not (testify/14 equates integers
+// that round to one float64); invalid text fails.
+func TestHegelJSONEqFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, jsonCases)
+		s1, s2 := cs.texts()
+		want := !cs.mutated
+		shape := shapeIf(hasBigInt(cs.doc), "testify/14")
+		c.count("eq=" + strconv.FormatBool(want))
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, %s)", s1, s2), want, func(t assert.TestingT) bool { return assert.JSONEq(t, s1, s2) }, shape...) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, %s)", s2, s1), want, func(t assert.TestingT) bool { return assert.JSONEq(t, s2, s1) }, shape...) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("YAMLEq(%s, %s)", s1, s2), want, func(t assert.TestingT) bool { return assert.YAMLEq(t, s1, s2) }, shape...) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, bad)", s1), false, func(t assert.TestingT) bool { return assert.JSONEq(t, s1, s2+"]") }) {
+			return
+		}
+		expect(c, ht, fmt.Sprintf("JSONEq(bad, %s)", s1), false, func(t assert.TestingT) bool { return assert.JSONEq(t, "{"+s1, s1) })
+	})
+}
