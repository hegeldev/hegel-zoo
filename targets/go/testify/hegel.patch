+// pin runs an assertion on a fresh mockT and reports a panic as a test failure.
+func pin(t *testing.T, name string, f func(t assert.TestingT) bool) (ok bool, reported []string) {
+	t.Helper()
+	m := &mockT{}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("%s panicked: %v", name, r)
+		}
+	}()
+	ok = f(m)
+	return ok, m.msgs
+}
+
+func pinExpect(t *testing.T, name string, want bool, f func(t assert.TestingT) bool) {
+	t.Helper()
+	got, _ := pin(t, name, f)
+	if got != want {
+		t.Errorf("%s = %v, want %v", name, got, want)
+	}
+}
+
+// testify/1: a negative integer never equals an unsigned one.
+func TestHegelPinEqualValuesSignedUnsigned(t *testing.T) {
+	pinExpect(t, "EqualValues(int8(-1), uint8(255))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int8(-1), uint8(255)) })
+	pinExpect(t, "EqualValues(int8(-1), uint16(65535))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int8(-1), uint16(65535)) })
+	pinExpect(t, "EqualValues(uint64(1<<63), int64(MinInt64))", false, func(m assert.TestingT) bool {
+		return assert.EqualValues(m, uint64(1<<63), int64(math.MinInt64))
+	})
+	pinExpect(t, "EqualValues(int64(-1), uint64(MaxUint64))", false, func(m assert.TestingT) bool {
+		return assert.EqualValues(m, int64(-1), uint64(math.MaxUint64))
+	})
+}
+
+// testify/2: a float with a fraction never equals an integer.
+func TestHegelPinEqualValuesFloatTruncation(t *testing.T) {
+	pinExpect(t, "EqualValues(1, 1.5)", false, func(m assert.TestingT) bool { return assert.EqualValues(m, 1, 1.5) })
+	pinExpect(t, "EqualValues(int64(1), float32(1.9))", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int64(1), float32(1.9)) })
+	pinExpect(t, "EqualValues(int64(MinInt64), 1e300)", false, func(m assert.TestingT) bool { return assert.EqualValues(m, int64(math.MinInt64), 1e300) })
+}
+
+// testify/3: EqualValues is symmetric; an integer a float cannot represent does not equal it.
+func TestHegelPinEqualValuesSymmetric(t *testing.T) {
+	a, b := assert.ObjectsAreEqualValues(float32(16777216), int32(16777217)), assert.ObjectsAreEqualValues(int32(16777217), float32(16777216))
+	if a != b {
+		t.Errorf("ObjectsAreEqualValues(float32(16777216), int32(16777217)) = %v but the other way round %v", a, b)
+	}
