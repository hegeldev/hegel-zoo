diff --git a/assert/hegel_collections_test.go b/assert/hegel_collections_test.go
new file mode 100644
index 0000000..8851ba8
--- /dev/null
+++ b/assert/hegel_collections_test.go
@@ -0,0 +1,404 @@
+package assert_test
+
+// Collections: Contains, NotContains, Subset, NotSubset, ElementsMatch, NotElementsMatch on
+// slices, arrays, maps and strings against set and multiset models.
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// listForm is how a []int is handed to an assertion: as the slice, as an array of the same
+// content, or (when empty) as a nil slice.
+type listForm int
+
+const (
+	asSlice listForm = iota
+	asArray
+	asNilSlice
+)
+
+// intList: a small []int and its form.
+type intList struct {
+	xs   []int
+	form listForm
+}
+
+// value is the list in its form.
+func (l intList) value() any {
+	switch {
+	case l.form == asArray:
+		arr := reflect.New(reflect.ArrayOf(len(l.xs), reflect.TypeOf(0))).Elem()
+		reflect.Copy(arr, reflect.ValueOf(l.xs))
+		return arr.Interface()
+	case l.form == asNilSlice && len(l.xs) == 0:
+		return []int(nil)
+	}
+	return l.xs
+}
+
+func (l intList) GoString() string {
+	v := l.value()
+	return fmt.Sprintf("%T%v", v, v)
+}
+
+var (
+	listForms = weighted(choice[listForm]{65, hegel.Just(asSlice)}, choice[listForm]{25, hegel.Just(asArray)}, choice[listForm]{10, hegel.Just(asNilSlice)})
+	listInts  = hegel.Integers(0, 3)
+)
+
+// intLists: up to maxLen ints of 0 to 3 in a form.
+func intLists(maxLen int) hegel.Generator[intList] {
+	return hegel.Composite(func(tc hegel.TestCase) intList {
+		return intList{xs: nonNil(hegel.Draw(tc, many(listInts, 0, maxLen))), form: hegel.Draw(tc, listForms)}
+	})
+}
+
+// isZeroArray: an array whose elements are all zero (testify/18 treats it as empty).
+func isZeroArray(v any) bool {
+	rv := reflect.ValueOf(v)
+	return rv.Kind() == reflect.Array && rv.IsZero()
+}
+
+// emptyByRule: what ElementsMatch's shortcut takes for empty: nil, a collection without
+// elements, or an array of zero values.
+func emptyByRule(v any) bool {
+	if v == nil || isZeroArray(v) {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	return rv.Kind() == reflect.Slice && rv.Len() == 0
+}
+
+func containsInt(xs []int, x int) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func sortedCopy(xs []int) []int {
+	ys := append([]int{}, xs...)
+	sort.Ints(ys)
+	return ys
+}
+
+// otherKind is how the second list of ElementsMatch comes about.
+type otherKind int
+
+const (
+	shuffledSame   otherKind = iota // a permutation of the list
+	independent2                    // an independent list
+	shuffledEdited                  // a permutation with one element dropped or added
+)
+
+// collCase: a list of up to four ints and a candidate subset of up to three; the element looked
+// for (as an int64 15% of the time, which never matches); the other list for ElementsMatch and
+// the sort keys of its permutations.
+type collCase struct {
+	list, sub intList
+	x         int
+	foreign   bool
+	how       otherKind
+	other     intList
+	drop      bool
+	add       int
+	keys      []int
+	permKeys  []int
+}
+
+// elem is the element looked for.
+func (c collCase) elem() any {
+	if c.foreign {
+		return int64(c.x)
+	}
+	return c.x
+}
+
+// others is the second list of ElementsMatch: its content and its value.
+func (c collCase) others() ([]int, any) {
+	switch c.how {
+	case shuffledSame:
+		zs := shuffled(c.list.xs, c.keys)
+		return zs, zs
+	case independent2:
+		return c.other.xs, c.other.value()
+	}
+	zs := shuffled(c.list.xs, c.keys)
+	if len(zs) > 0 && c.drop {
+		zs = zs[1:]
+	} else {
+		zs = append(zs, c.add)
+	}
+	return zs, zs
+}
+
+func (c collCase) GoString() string {
+	_, other := c.others()
+	return fmt.Sprintf("list %#v sub %#v elem %T %v; other (%v) %T%v", c.list, c.sub, c.elem(), c.elem(), []string{"shuffled", "independent", "edited"}[c.how], other, other)
+}
+
+var collCases = hegel.Composite(func(tc hegel.TestCase) collCase {
+	return collCase{
+		list:     hegel.Draw(tc, intLists(4)),
+		sub:      hegel.Draw(tc, intLists(3)),
+		x:        hegel.Draw(tc, hegel.Integers(0, 4)),
+		foreign:  hegel.Draw(tc, chance(15)),
+		how:      hegel.Draw(tc, hegel.SampledFrom([]otherKind{shuffledSame, independent2, shuffledEdited})),
+		other:    hegel.Draw(tc, intLists(4)),
+		drop:     hegel.Draw(tc, chance(50)),
+		add:      hegel.Draw(tc, listInts),
+		keys:     hegel.Draw(tc, many(positions, 0, 4)),
+		permKeys: hegel.Draw(tc, many(positions, 0, 4)),
+	}
+})
+
+// TestHegelCollectionsFollowTheModel: Contains is membership (keys for maps, substrings for
+// strings), Subset is set containment (map/map: pairs; map/list: keys), ElementsMatch is
+// multiset equality and invariant under permutation (an array of zero values has elements:
+// testify/18 matches it with an empty list), with NotX = !X and Len = the length.
+func TestHegelCollectionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, collCases)
+		xs, list := cs.list.xs, cs.list.value()
+		ys, sub := cs.sub.xs, cs.sub.value()
+		// Contains on the list
+		elem := cs.elem()
+		wantC := !cs.foreign && containsInt(xs, cs.x)
+		name := fmt.Sprintf("(%T %v, %T %v)", list, list, elem, elem)
+		c.count("contains=" + strconv.FormatBool(wantC))
+		if !expect(c, ht, "Contains"+name, wantC, func(t assert.TestingT) bool { return assert.Contains(t, list, elem) }) {
+			return
+		}
+		if !expect(c, ht, "NotContains"+name, !wantC, func(t assert.TestingT) bool { return assert.NotContains(t, list, elem) }) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("Len(%v, %d)", list, len(xs)), true, func(t assert.TestingT) bool { return assert.Len(t, list, len(xs)) }) {
+			return
+		}
+		// Subset
+		wantS := true
+		for _, y := range ys {
+			if !containsInt(xs, y) {
+				wantS = false
+			}
+		}
+		sn := fmt.Sprintf("(%T %v, %T %v)", list, list, sub, sub)
+		c.count("subset=" + strconv.FormatBool(wantS))
+		if !expect(c, ht, "Subset"+sn, wantS, func(t assert.TestingT) bool { return assert.Subset(t, list, sub) }) {
+			return
+		}
+		if !expect(c, ht, "NotSubset"+sn, !wantS, func(t assert.TestingT) bool { return assert.NotSubset(t, list, sub) }) {
+			return
+		}
+		// a list is a subset of itself, and of itself plus anything
+		if !expect(c, ht, "Subset(self)"+sn, true, func(t assert.TestingT) bool { return assert.Subset(t, list, list) }) {
+			return
+		}
+		// ElementsMatch: multiset equality; shuffling changes nothing
+		zs, other := cs.others()
+		wantM := reflect.DeepEqual(sortedCopy(xs), sortedCopy(zs))
+		shape := shapeIf(len(xs) != len(zs) && emptyByRule(list) && emptyByRule(other), "testify/18")
+		if Known.zeroArrayEmpty {
+			ht.Assume(len(shape) == 0)
+		}
+		mn := fmt.Sprintf("(%T %v, %T %v)", list, list, other, other)
+		c.count("match=" + strconv.FormatBool(wantM))
+		if !expect(c, ht, "ElementsMatch"+mn, wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, list, other) }, shape...) {
+			return
+		}
+		if !expect(c, ht, "ElementsMatch(b,a)"+mn, wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, other, list) }, shape...) {
+			return
+		}
+		if !expect(c, ht, "NotElementsMatch"+mn, !wantM, func(t assert.TestingT) bool { return assert.NotElementsMatch(t, list, other) }, shape...) {
+			return
+		}
+		perm := shuffled(zs, cs.permKeys)
+		if !expect(c, ht, fmt.Sprintf("ElementsMatch(%v, %v)", list, perm), wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, list, perm) }, shape...) {
+			return
+		}
+		// ElementsMatch and Subset both ways is the same as ElementsMatch when there are no
+		// duplicates; Subset both ways is set equality
+		if wantM && !wantS && len(ys) > 0 && reflect.DeepEqual(sortedCopy(ys), sortedCopy(zs)) {
+			c.fail(ht, "%v matches %v but is not a superset of it", list, other)
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- maps and strings
+
+var (
+	abcKeys   = []string{"a", "b", "c"}
+	smallMaps = hegel.Map(hegel.Maps(hegel.SampledFrom(abcKeys), bits).MaxSize(3), nonNilMap[string, int])
+	// haystacks: the strings searched, with (while the shapes are on) the text a non-string
+	// element's reflect.Value prints as (testify/6).
+	haystacks = hegel.SampledFrom(shaped(
+		[]string{"", "ab", "abc", "hello world", "aXb", "x <int Value> y", "<invalid Value>", "<[]uint8 Value>", "<int32 Value>"},
+		[]string{"", "ab", "abc", "hello world", "aXb"},
+	))
+	stringNeedles = asAny(hegel.SampledFrom([]string{"", "a", "b", "X", "world", "lo w", "abcd"}))
+	// needles: a string, or (the shape of testify/6, left out under HEGEL_NO_KNOWN=1) a
+	// non-string element, whose text (fmt.Sprint) is in no haystack.
+	needles = func() hegel.Generator[any] {
+		if noKnown {
+			return stringNeedles
+		}
+		return hegel.OneOf(stringNeedles, hegel.SampledFrom([]any{42, nil, []byte("a"), 'a'}))
+	}()
+)
+
+// mapCase: a map of the keys a-c to bits, a key looked for (d never present), a candidate
+// subset (drawn from the map's own pairs by a mask 40% of the time, else independent), a key
+// list and a string with a needle.
+type mapCase struct {
+	m       map[string]int
+	key     string
+	own     bool
+	mask    []bool
+	subInd  map[string]int
+	keyMask []bool
+	s       string
+	needle  any
+}
+
+func sortedKeys(m map[string]int) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// sub is the candidate subset: the map's pairs the mask selects (recycled modulo its length;
+// an empty mask selects none), or the independent map.
+func (c mapCase) sub() map[string]int {
+	if !c.own {
+		return c.subInd
+	}
+	out := map[string]int{}
+	for i, k := range sortedKeys(c.m) {
+		if len(c.mask) > 0 && c.mask[i%len(c.mask)] {
+			out[k] = c.m[k]
+		}
+	}
+	return out
+}
+
+// keyList is the keys of a-c the key mask selects.
+func (c mapCase) keyList() []string {
+	var ks []string
+	for i, k := range abcKeys {
+		if len(c.keyMask) > 0 && c.keyMask[i%len(c.keyMask)] {
+			ks = append(ks, k)
+		}
+	}
+	return ks
+}
+
+func (c mapCase) GoString() string {
+	return fmt.Sprintf("m %v key %q sub %v keys %v; Contains(%q, %T %#v)", c.m, c.key, c.sub(), c.keyList(), c.s, c.needle, c.needle)
+}
+
+var mapCases = hegel.Composite(func(tc hegel.TestCase) mapCase {
+	return mapCase{
+		m:       hegel.Draw(tc, smallMaps),
+		key:     hegel.Draw(tc, hegel.SampledFrom([]string{"a", "b", "c", "d"})),
+		own:     hegel.Draw(tc, chance(40)),
+		mask:    hegel.Draw(tc, many(chance(60), 0, 3)),
+		subInd:  hegel.Draw(tc, smallMaps),
+		keyMask: hegel.Draw(tc, many(chance(40), 0, 3)),
+		s:       hegel.Draw(tc, haystacks),
+		needle:  hegel.Draw(tc, needles),
+	}
+})
+
+// TestHegelMapAndStringCollectionsFollowTheModel: Contains on a map is key membership and on a
+// string a substring test (a non-string element is never in a string: testify/6 looks for its
+// reflect text); Subset of two maps needs every pair, of a map and a list the keys.
+func TestHegelMapAndStringCollectionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, mapCases)
+		m, k := cs.m, cs.key
+		_, has := m[k]
+		c.count("key=" + strconv.FormatBool(has))
+		name := fmt.Sprintf("(%v, %q)", m, k)
+		if !expect(c, ht, "Contains"+name, has, func(t assert.TestingT) bool { return assert.Contains(t, m, k) }) {
+			return
+		}
+		if !expect(c, ht, "NotContains"+name, !has, func(t assert.TestingT) bool { return assert.NotContains(t, m, k) }) {
+			return
+		}
+		// map/map subset: every pair of sub is in m
+		sub := cs.sub()
+		wantS := true
+		for kk, v := range sub {
+			if w, ok := m[kk]; !ok || w != v {
+				wantS = false
+			}
+		}
+		sn := fmt.Sprintf("(%v, %v)", m, sub)
+		c.count("mapsubset=" + strconv.FormatBool(wantS))
+		if !expect(c, ht, "Subset"+sn, wantS, func(t assert.TestingT) bool { return assert.Subset(t, m, sub) }) {
+			return
+		}
+		if !expect(c, ht, "NotSubset"+sn, !wantS, func(t assert.TestingT) bool { return assert.NotSubset(t, m, sub) }) {
+			return
+		}
+		// map/list: keys
+		ks := cs.keyList()
+		wantK := true
+		for _, kk := range ks {
+			if _, ok := m[kk]; !ok {
+				wantK = false
+			}
+		}
+		kn := fmt.Sprintf("(%v, %v)", m, ks)
+		if !expect(c, ht, "Subset(map,list)"+kn, wantK, func(t assert.TestingT) bool { return assert.Subset(t, m, ks) }) {
+			return
+		}
+		// list/map: the map's keys must be in the list
+		mk := sortedKeys(m)
+		wantL := true
+		for kk := range sub {
+			if !containsStr(mk, kk) {
+				wantL = false
+			}
+		}
+		if !expect(c, ht, fmt.Sprintf("Subset(list,map)(%v, %v)", mk, sub), wantL, func(t assert.TestingT) bool { return assert.Subset(t, mk, sub) }) {
+			return
+		}
+		// strings: a substring, and never a non-string element
+		s, needle := cs.s, cs.needle
+		ns, isStr := needle.(string)
+		wantStr := isStr && strings.Contains(s, ns)
+		shape := shapeIf(!isStr, "testify/6")
+		c.count("substr=" + strconv.FormatBool(wantStr))
+		if !expect(c, ht, fmt.Sprintf("Contains(%q, %T %#v)", s, needle, needle), wantStr, func(t assert.TestingT) bool { return assert.Contains(t, s, needle) }, shape...) {
+			return
+		}
+		expect(c, ht, fmt.Sprintf("NotContains(%q, %T %#v)", s, needle, needle), !wantStr, func(t assert.TestingT) bool { return assert.NotContains(t, s, needle) }, shape...)
+	})
+}
+
+func containsStr(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
diff --git a/assert/hegel_compare_test.go b/assert/hegel_compare_test.go
new file mode 100644
index 0000000..50cc0ee
--- /dev/null
+++ b/assert/hegel_compare_test.go
@@ -0,0 +1,487 @@
+package assert_test
+
+// Ordering and closeness: Greater, GreaterOrEqual, Less, LessOrEqual, Positive, Negative,
+// IsIncreasing, IsNonIncreasing, IsDecreasing, IsNonDecreasing, WithinDuration, WithinRange,
+// InDelta, InEpsilon, InDeltaSlice, InDeltaMapValues, InEpsilonSlice.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// ordType is an ordered type: its values and the ordering of its kind.
+type ordType struct {
+	name    string
+	typ     reflect.Type
+	numeric bool
+	values  hegel.Generator[any]
+	cmp     func(a, b any) int
+}
+
+func cmpInt(a, b int64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+func cmpFloat(x, y float64) int {
+	switch {
+	case x < y:
+		return -1
+	case x > y:
+		return 1
+	}
+	return 0
+}
+
+var baseTime = time.Date(2026, 9, 21, 0, 0, 0, 0, time.UTC)
+
+var (
+	hourOffsets = hegel.Map(hegel.Integers(-1, 2), func(h int) time.Time { return baseTime.Add(time.Duration(h) * time.Hour) })
+	ordStrings  = hegel.SampledFrom([]string{"", "a", "ab", "b", "B"})
+	ordBytes    = hegel.Map(hegel.SampledFrom([]string{"", "a", "ab", "b"}), func(s string) []byte { return []byte(s) })
+)
+
+var ordTypes = []ordType{
+	{"int", reflect.TypeOf(0), true, asAny(hegel.Integers(-2, 2)),
+		func(a, b any) int { return cmpInt(int64(a.(int)), int64(b.(int))) }},
+	{"int64", reflect.TypeOf(int64(0)), true, asAny(hegel.SampledFrom([]int64{-1, 0, 1, math.MaxInt32})),
+		func(a, b any) int { return cmpInt(a.(int64), b.(int64)) }},
+	{"uint8", reflect.TypeOf(uint8(0)), true, asAny(hegel.SampledFrom([]uint8{0, 1, 2, 255})),
+		func(a, b any) int { return cmpInt(int64(a.(uint8)), int64(b.(uint8))) }},
+	{"myInt", reflect.TypeOf(myInt(0)), true, asAny(hegel.Map(hegel.Integers(-2, 2), func(x int) myInt { return myInt(x) })),
+		func(a, b any) int { return cmpInt(int64(a.(myInt)), int64(b.(myInt))) }},
+	{"float64", reflect.TypeOf(0.0), true, asAny(hegel.SampledFrom([]float64{-1.5, 0, 0.5, 1, 1e300})),
+		func(a, b any) int { return cmpFloat(a.(float64), b.(float64)) }},
+	{"float32", reflect.TypeOf(float32(0)), true, asAny(hegel.SampledFrom([]float32{-1.5, 0, 0.5, 1})),
+		func(a, b any) int { return cmpFloat(float64(a.(float32)), float64(b.(float32))) }},
+	{"duration", reflect.TypeOf(time.Duration(0)), true, asAny(durations),
+		func(a, b any) int { return cmpInt(int64(a.(time.Duration)), int64(b.(time.Duration))) }},
+	{"string", reflect.TypeOf(""), false, asAny(ordStrings),
+		func(a, b any) int { return strings.Compare(a.(string), b.(string)) }},
+	{"bytes", reflect.TypeOf([]byte{}), false, asAny(ordBytes),
+		func(a, b any) int { return bytes.Compare(a.([]byte), b.([]byte)) }},
+	{"time", reflect.TypeOf(time.Time{}), false, asAny(hourOffsets),
+		func(a, b any) int {
+			x, y := a.(time.Time), b.(time.Time)
+			switch {
+			case x.Before(y):
+				return -1
+			case x.After(y):
+				return 1
+			}
+			return 0
+		}},
+}
+
+var ordTypeIdx = hegel.Integers(0, len(ordTypes)-1)
+
+// foreignValues: for each ordered type, a value of a type of another kind (every comparison
+// fails) and, while the shapes are on, for []byte and time.Time a value of another type of
+// the same kind ([]int{1}, struct{}{}), which compare converts without a check (testify/12).
+var foreignValues = func() []hegel.Generator[any] {
+	out := make([]hegel.Generator[any], len(ordTypes))
+	for i, ot := range ordTypes {
+		var alts []hegel.Generator[any]
+		for _, other := range ordTypes {
+			if other.typ.Kind() != ot.typ.Kind() {
+				alts = append(alts, other.values)
+			}
+		}
+		if !noKnown {
+			switch ot.typ.Kind() {
+			case reflect.Slice:
+				alts = append(alts, hegel.Just[any]([]int{1}))
+			case reflect.Struct:
+				alts = append(alts, hegel.Just[any](struct{}{}))
+			}
+		}
+		out[i] = hegel.OneOf(alts...)
+	}
+	return out
+}()
+
+// ordCase: two values of one ordered type (b replaced by a foreign one 15% of the time), and
+// zero to five values of the type for the ordered-collection assertions, as an array 30% of
+// the time.
+type ordCase struct {
+	ti      int
+	a, b    any
+	foreign *any
+	elems   []any
+	asArray bool
+}
+
+func (c ordCase) GoString() string {
+	b := c.b
+	if c.foreign != nil {
+		b = *c.foreign
+	}
+	return fmt.Sprintf("%s: a=%v b=%T %v; elems %v asArray=%v", ordTypes[c.ti].name, c.a, b, b, c.elems, c.asArray)
+}
+
+// collection is the elements as a slice of the type, or an array of them.
+func (c ordCase) collection() any {
+	typ := ordTypes[c.ti].typ
+	s := reflect.MakeSlice(reflect.SliceOf(typ), len(c.elems), len(c.elems))
+	for i, e := range c.elems {
+		s.Index(i).Set(reflect.ValueOf(e))
+	}
+	if !c.asArray {
+		return s.Interface()
+	}
+	arr := reflect.New(reflect.ArrayOf(len(c.elems), typ)).Elem()
+	reflect.Copy(arr, s)
+	return arr.Interface()
+}
+
+var ordCases = hegel.Composite(func(tc hegel.TestCase) ordCase {
+	ti := hegel.Draw(tc, ordTypeIdx)
+	ot := ordTypes[ti]
+	return ordCase{
+		ti:      ti,
+		a:       hegel.Draw(tc, ot.values),
+		b:       hegel.Draw(tc, ot.values),
+		foreign: hegel.Draw(tc, optional(15, foreignValues[ti])),
+		elems:   hegel.Draw(tc, many(ot.values, 0, 5)),
+		asArray: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// TestHegelOrderingFollowsTheModel: Greater & co on two values of one ordered type agree with
+// the type's ordering (GreaterOrEqual = Greater or equal, Less = Greater swapped); two values of
+// different types fail (a []byte or time.Time against another type of its kind panics,
+// testify/12); Positive/Negative are Greater/Less than zero on numbers and fail on anything else
+// (testify/17 passes strings); IsIncreasing & co on a slice or array hold exactly when every
+// adjacent pair does.
+func TestHegelOrderingFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, ordCases)
+		ot := ordTypes[cs.ti]
+		a, b := cs.a, cs.b
+		if cs.foreign != nil {
+			// another type: every comparison fails
+			b = *cs.foreign
+			shape := shapeIf(reflect.TypeOf(b).Kind() == ot.typ.Kind(), "testify/12")
+			name := fmt.Sprintf("(%T %v, %T %v)", a, a, b, b)
+			c.count("cross-type")
+			for _, f := range []struct {
+				n string
+				f func(t assert.TestingT) bool
+			}{
+				{"Greater", func(t assert.TestingT) bool { return assert.Greater(t, a, b) }},
+				{"GreaterOrEqual", func(t assert.TestingT) bool { return assert.GreaterOrEqual(t, a, b) }},
+				{"Less", func(t assert.TestingT) bool { return assert.Less(t, a, b) }},
+				{"LessOrEqual", func(t assert.TestingT) bool { return assert.LessOrEqual(t, a, b) }},
+			} {
+				if !expect(c, ht, f.n+name, false, f.f, shape...) {
+					return
+				}
+			}
+			return
+		}
+		cmp := ot.cmp(a, b)
+		c.count(ot.name + "=" + strconv.Itoa(cmp))
+		name := fmt.Sprintf("(%s %v, %v)", ot.name, a, b)
+		if !expect(c, ht, "Greater"+name, cmp > 0, func(t assert.TestingT) bool { return assert.Greater(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "GreaterOrEqual"+name, cmp >= 0, func(t assert.TestingT) bool { return assert.GreaterOrEqual(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Less"+name, cmp < 0, func(t assert.TestingT) bool { return assert.Less(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "LessOrEqual"+name, cmp <= 0, func(t assert.TestingT) bool { return assert.LessOrEqual(t, a, b) }) {
+			return
+		}
+		if !expect(c, ht, "Less(b,a)"+name, cmp > 0, func(t assert.TestingT) bool { return assert.Less(t, b, a) }) {
+			return
+		}
+		if ot.numeric || !Known.positiveStrings {
+			// a number is positive when greater than zero; anything else is unsupported
+			wantPos, wantNeg := false, false
+			if ot.numeric {
+				cz := ot.cmp(a, reflect.Zero(ot.typ).Interface())
+				wantPos, wantNeg = cz > 0, cz < 0
+			}
+			shape := shapeIf(!ot.numeric, "testify/17")
+			if !expect(c, ht, "Positive"+name, wantPos, func(t assert.TestingT) bool { return assert.Positive(t, a) }, shape...) {
+				return
+			}
+			if !expect(c, ht, "Negative"+name, wantNeg, func(t assert.TestingT) bool { return assert.Negative(t, a) }, shape...) {
+				return
+			}
+		}
+		// ordered collections
+		inc, noninc, dec, nondec := true, true, true, true
+		for i := 1; i < len(cs.elems); i++ {
+			d := ot.cmp(cs.elems[i-1], cs.elems[i])
+			inc = inc && d < 0
+			nondec = nondec && d <= 0
+			dec = dec && d > 0
+			noninc = noninc && d >= 0
+		}
+		coll := cs.collection()
+		cn := fmt.Sprintf("(%s %v)", ot.name, coll)
+		if !expect(c, ht, "IsIncreasing"+cn, inc, func(t assert.TestingT) bool { return assert.IsIncreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsNonIncreasing"+cn, noninc, func(t assert.TestingT) bool { return assert.IsNonIncreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsDecreasing"+cn, dec, func(t assert.TestingT) bool { return assert.IsDecreasing(t, coll) }) {
+			return
+		}
+		if !expect(c, ht, "IsNonDecreasing"+cn, nondec, func(t assert.TestingT) bool { return assert.IsNonDecreasing(t, coll) }) {
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- times
+
+// timeCase: two instants, a tolerance and a range, all in whole seconds around baseTime.
+type timeCase struct {
+	a, b, delta, start, end int
+}
+
+func at(s int) time.Time { return baseTime.Add(time.Duration(s) * time.Second) }
+
+var (
+	secondOffsets = hegel.Integers(-5, 5)
+	timeCases     = hegel.Composite(func(tc hegel.TestCase) timeCase {
+		return timeCase{
+			a:     hegel.Draw(tc, secondOffsets),
+			b:     hegel.Draw(tc, secondOffsets),
+			delta: hegel.Draw(tc, hegel.Integers(0, 5)),
+			start: hegel.Draw(tc, secondOffsets),
+			end:   hegel.Draw(tc, secondOffsets),
+		}
+	})
+)
+
+// TestHegelTimeWindowsFollowTheModel: WithinDuration holds exactly when |a-b| <= delta and is
+// symmetric; WithinRange holds exactly when start <= t <= end (and fails when end < start).
+func TestHegelTimeWindowsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, timeCases)
+		a, b := at(cs.a), at(cs.b)
+		delta := time.Duration(cs.delta) * time.Second
+		diff := a.Sub(b)
+		if diff < 0 {
+			diff = -diff
+		}
+		want := diff <= delta
+		c.count("within=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%v, %v, %v)", a, b, delta)
+		if !expect(c, ht, "WithinDuration"+name, want, func(t assert.TestingT) bool { return assert.WithinDuration(t, a, b, delta) }) {
+			return
+		}
+		if !expect(c, ht, "WithinDuration(b,a)"+name, want, func(t assert.TestingT) bool { return assert.WithinDuration(t, b, a, delta) }) {
+			return
+		}
+		start, end := at(cs.start), at(cs.end)
+		wantR := !end.Before(start) && !a.Before(start) && !a.After(end)
+		expect(c, ht, fmt.Sprintf("WithinRange(%v, %v, %v)", a, start, end), wantR, func(t assert.TestingT) bool { return assert.WithinRange(t, a, start, end) })
+	})
+}
+
+// --------------------------------------------------------------------------- deltas
+
+// numish: a number of a type InDelta accepts, and its float64 value.
+type numish struct {
+	v any
+	f float64
+}
+
+func (n numish) GoString() string { return fmt.Sprintf("%T(%v)", n.v, n.v) }
+
+// numishOf: the float as a float64 (kind 0), or when it is integral, finite and below 1e9 as an
+// int, a uint32 (non-negative only) or a time.Duration, or as a float32 (which rounds it).
+func numishOf(f float64, kind int) numish {
+	integral := f == math.Trunc(f) && !math.IsNaN(f) && math.Abs(f) < 1e9
+	switch kind {
+	case 1:
+		if integral {
+			return numish{int(f), f}
+		}
+	case 2:
+		if integral && f >= 0 {
+			return numish{uint32(f), f}
+		}
+	case 3:
+		f32 := float32(f)
+		return numish{f32, float64(f32)}
+	case 4:
+		if integral {
+			return numish{time.Duration(f), f}
+		}
+	}
+	return numish{f, f}
+}
+
+var (
+	// floatishValues: a value of the pool, NaN once in ten.
+	floatishValues = weighted(
+		choice[float64]{90, hegel.SampledFrom([]float64{0, 1, -1, 2.5, 0.1, 0.3, 100, 1e10, -3, 0.25})},
+		choice[float64]{10, hegel.Just(math.NaN())},
+	)
+	numishes = hegel.Map(pairs(floatishValues, hegel.Integers(0, 4)), func(p pair[float64, int]) numish { return numishOf(p.a, p.b) })
+	// deltas: a tolerance, or (the shape of testify/10, left out under HEGEL_NO_KNOWN=1) NaN.
+	deltaPool = []float64{0, 0.1, 0.5, 1, 2, 1e9}
+	deltas    = hegel.SampledFrom(shaped(append(append([]float64{}, deltaPool...), math.NaN()), deltaPool))
+	epsilons  = hegel.SampledFrom([]float64{0, 0.01, 0.5, 1, 10})
+	xyzKeys   = hegel.SampledFrom([]string{"x", "y", "z"})
+	numMaps   = hegel.Map(hegel.Maps(xyzKeys, numishes).MaxSize(3), func(m map[string]numish) map[string]float64 {
+		out := map[string]float64{}
+		for k, v := range m {
+			out[k] = v.f
+		}
+		return out
+	})
+)
+
+func modelInDelta(a, b, delta float64) bool {
+	if math.IsNaN(a) && math.IsNaN(b) {
+		return true
+	}
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return false
+	}
+	return math.Abs(a-b) <= delta
+}
+
+func modelInEpsilon(a, b, eps float64) bool {
+	if math.IsNaN(eps) {
+		return false
+	}
+	if math.IsNaN(a) && math.IsNaN(b) {
+		return true
+	}
+	if math.IsNaN(a) || math.IsNaN(b) || a == 0 {
+		return false
+	}
+	return math.Abs(a-b)/math.Abs(a) <= eps
+}
+
+// deltaCase: two numbers, a delta and an epsilon, two slices of 0 to 3 values (of equal length
+// under HEGEL_NO_KNOWN=1: testify/11 ignores the lengths) and two maps of up to three keys.
+type deltaCase struct {
+	a, b   numish
+	delta  float64
+	eps    float64
+	xs, ys []numish
+	ma, mb map[string]float64
+}
+
+func (c deltaCase) GoString() string {
+	return fmt.Sprintf("a=%#v b=%#v delta=%v eps=%v\nxs=%#v ys=%#v\nma=%v mb=%v", c.a, c.b, c.delta, c.eps, c.xs, c.ys, c.ma, c.mb)
+}
+
+func floatsOf(xs []numish) []float64 {
+	out := make([]float64, len(xs))
+	for i, x := range xs {
+		out[i] = x.f
+	}
+	return out
+}
+
+var deltaCases = deltaCasesWith(deltas)
+
+// deltaCasesWith draws the cases with the given deltas.
+func deltaCasesWith(deltas hegel.Generator[float64]) hegel.Generator[deltaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) deltaCase {
+		xs := hegel.Draw(tc, many(numishes, 0, 3))
+		ysLen := many(numishes, 0, 3)
+		if noKnown {
+			ysLen = many(numishes, len(xs), len(xs))
+		}
+		return deltaCase{
+			a:     hegel.Draw(tc, numishes),
+			b:     hegel.Draw(tc, numishes),
+			delta: hegel.Draw(tc, deltas),
+			eps:   hegel.Draw(tc, epsilons),
+			xs:    xs,
+			ys:    hegel.Draw(tc, ysLen),
+			ma:    hegel.Draw(tc, numMaps),
+			mb:    hegel.Draw(tc, numMaps),
+		}
+	})
+}
+
+// TestHegelDeltasFollowTheModel: InDelta holds exactly when |a-b| <= delta (NaN equals NaN
+// only; a NaN delta holds nothing: testify/10 passes it), symmetric; InEpsilon when the relative
+// error is at most epsilon; InDeltaSlice, InEpsilonSlice and InDeltaMapValues hold exactly when
+// every pair does (same lengths, same keys); a non-number fails.
+func TestHegelDeltasFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, deltaCases)
+		a, fa, b, fb, delta := cs.a.v, cs.a.f, cs.b.v, cs.b.f, cs.delta
+		nan := shapeIf(math.IsNaN(delta), "testify/10")
+		want := modelInDelta(fa, fb, delta)
+		c.count("delta=" + strconv.FormatBool(want))
+		name := fmt.Sprintf("(%T %v, %T %v, %v)", a, a, b, b, delta)
+		if !expect(c, ht, "InDelta"+name, want, func(t assert.TestingT) bool { return assert.InDelta(t, a, b, delta) }, nan...) {
+			return
+		}
+		if !expect(c, ht, "InDelta(b,a)"+name, want, func(t assert.TestingT) bool { return assert.InDelta(t, b, a, delta) }, nan...) {
+			return
+		}
+		if !expect(c, ht, "InDelta(string)"+name, false, func(t assert.TestingT) bool { return assert.InDelta(t, "1", b, delta) }) {
+			return
+		}
+		eps := cs.eps
+		wantE := modelInEpsilon(fa, fb, eps)
+		if !expect(c, ht, "InEpsilon"+name, wantE, func(t assert.TestingT) bool { return assert.InEpsilon(t, a, b, eps) }) {
+			return
+		}
+		// slices of float64
+		xs, ys := floatsOf(cs.xs), floatsOf(cs.ys)
+		all, allE := len(xs) == len(ys), len(xs) == len(ys)
+		for i := 0; i < len(xs) && i < len(ys); i++ {
+			all = all && modelInDelta(xs[i], ys[i], delta)
+			allE = allE && modelInEpsilon(xs[i], ys[i], eps)
+		}
+		lengths := shapeIf(len(xs) != len(ys), "testify/11")
+		sn := fmt.Sprintf("(%v, %v, %v)", xs, ys, delta)
+		if !expect(c, ht, "InDeltaSlice"+sn, all, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys, delta) }, append(nan, lengths...)...) {
+			return
+		}
+		if !expect(c, ht, "InEpsilonSlice"+sn, allE, func(t assert.TestingT) bool { return assert.InEpsilonSlice(t, xs, ys, eps) }) {
+			return
+		}
+		if k := len(xs); !Known.deltaSliceLength && k > 0 && len(ys) >= k {
+			if !expect(c, ht, "InDeltaSlice(shorter)"+sn, false, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys[:k-1], delta) }, append(nan, known("testify/11")...)...) {
+				return
+			}
+		}
+		// maps
+		ma, mb := cs.ma, cs.mb
+		allM := len(ma) == len(mb)
+		for key, v := range ma {
+			w, ok := mb[key]
+			if !ok || !modelInDelta(v, w, delta) {
+				allM = false
+			}
+		}
+		expect(c, ht, fmt.Sprintf("InDeltaMapValues(%v, %v, %v)", ma, mb, delta), allM, func(t assert.TestingT) bool { return assert.InDeltaMapValues(t, ma, mb, delta) }, nan...)
+	})
+}
diff --git a/assert/hegel_contract_test.go b/assert/hegel_contract_test.go
new file mode 100644
index 0000000..463b98b
--- /dev/null
+++ b/assert/hegel_contract_test.go
@@ -0,0 +1,560 @@
+package assert_test
+
+// The contract shared by every assertion: it returns true exactly when it reported nothing,
+// reports at most once, never panics on ordinary arguments, and reports the caller's message
+// (formatted with its arguments) verbatim in a "Messages:" line. Also JSONEq/YAMLEq against a
+// generated document serialised twice.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// namedAssertion is an assertion call on the case's arguments, with the recorded bugs whose
+// shape the call has.
+type namedAssertion struct {
+	name  string
+	f     func(t assert.TestingT, msgAndArgs ...any) bool
+	shape []string
+}
+
+var errA = errors.New("a")
+var errB = errors.New("b")
+
+func isList(v any) bool {
+	if v == nil {
+		return false
+	}
+	k := reflect.TypeOf(v).Kind()
+	return k == reflect.Slice || k == reflect.Array
+}
+
+// isUncomparable reports whether == on two values of v's type panics.
+func isUncomparable(v any) bool { return v != nil && !reflect.TypeOf(v).Comparable() }
+
+// panicValues: what the panicking function panics with: a string, or (the shape of testify/9,
+// left out under HEGEL_NO_KNOWN=1) a slice, which PanicsWithValue cannot compare.
+var (
+	panicValues    = hegel.SampledFrom(shaped([]any{"boom", "bang", []int{1}}, []any{"boom", "bang"}))
+	expectedPanics = hegel.SampledFrom(shaped([]any{"boom", []int{1}}, []any{"boom"}))
+	wrappedErrs    = optional(50, hegel.Map(hegel.SampledFrom([]error{errA, errB}), func(e error) error { return fmt.Errorf("wrapped: %w", e) }))
+	filePaths      = hegel.SampledFrom([]string{"hegel_test.go", "no-such-file", "."})
+)
+
+// messageForm is how the caller's message is passed: none, a format with an argument, or a
+// plain string.
+type messageForm int
+
+const (
+	noMessage messageForm = iota
+	formatMessage
+	plainMessage
+)
+
+// contractCase: the arguments of some fifty assertions, which one is called (pick, modulo their
+// number) and the message it is given.
+type contractCase struct {
+	a, b          any
+	cloneB        bool
+	k             int
+	x, y          numish
+	err           *error
+	tmOff         int
+	panicky       bool
+	panicVal      any
+	expectedPanic any
+	jsonOther     string
+	yamlOther     string
+	path, path2   string
+	pick          int
+	msg           messageForm
+	marker        int
+}
+
+// second is b, or a clone of a.
+func (c contractCase) second() any {
+	if c.cloneB {
+		return clone(c.a)
+	}
+	return c.b
+}
+
+func (c contractCase) GoString() string {
+	as := c.assertions()
+	na := as[c.pick%len(as)]
+	b := c.second()
+	return fmt.Sprintf("%s(a: %T %#v, b: %T %#v, ...) message %v marker %d", na.name, c.a, c.a, b, b, []string{"none", "format", "plain"}[c.msg], c.marker)
+}
+
+// msgAndArgs is the message as passed, and the text it must appear as ("" for none).
+func (c contractCase) msgAndArgs() ([]any, string) {
+	switch c.msg {
+	case formatMessage:
+		return []any{"hegel marker %d here", c.marker}, "hegel marker " + strconv.Itoa(c.marker) + " here"
+	case plainMessage:
+		return []any{"hegel plain " + strconv.Itoa(c.marker)}, "hegel plain " + strconv.Itoa(c.marker)
+	}
+	return nil, ""
+}
+
+// assertions: the assertion calls on the case's arguments; the ones a recorded bug makes panic
+// or misreport are left out under HEGEL_NO_KNOWN=1 and carry the bug's name otherwise.
+func (c contractCase) assertions() []namedAssertion {
+	a, b := c.a, c.second()
+	k, x, y := c.k, c.x.v, c.y.v
+	var err error
+	if c.err != nil {
+		err = *c.err
+	}
+	tm := baseTime.Add(time.Duration(c.tmOff) * time.Second)
+	panicky, pv, expectedPanic := c.panicky, c.panicVal, c.expectedPanic
+	jsonOther, yamlOther, path, path2 := c.jsonOther, c.yamlOther, c.path, c.path2
+	out := []namedAssertion{
+		{"Equal", func(t assert.TestingT, m ...any) bool { return assert.Equal(t, a, b, m...) }, nil},
+		{"NotEqual", func(t assert.TestingT, m ...any) bool { return assert.NotEqual(t, a, b, m...) }, nil},
+		{"Exactly", func(t assert.TestingT, m ...any) bool { return assert.Exactly(t, a, b, m...) }, nil},
+		{"IsType", func(t assert.TestingT, m ...any) bool { return assert.IsType(t, a, b, m...) }, nil},
+		{"IsNotType", func(t assert.TestingT, m ...any) bool { return assert.IsNotType(t, a, b, m...) }, nil},
+		{"Same", func(t assert.TestingT, m ...any) bool { return assert.Same(t, a, b, m...) }, nil},
+		{"Empty", func(t assert.TestingT, m ...any) bool { return assert.Empty(t, a, m...) }, nil},
+		{"NotEmpty", func(t assert.TestingT, m ...any) bool { return assert.NotEmpty(t, a, m...) }, nil},
+		{"Zero", func(t assert.TestingT, m ...any) bool { return assert.Zero(t, a, m...) }, nil},
+		{"NotZero", func(t assert.TestingT, m ...any) bool { return assert.NotZero(t, a, m...) }, nil},
+		{"Nil", func(t assert.TestingT, m ...any) bool { return assert.Nil(t, a, m...) }, nil},
+		{"NotNil", func(t assert.TestingT, m ...any) bool { return assert.NotNil(t, a, m...) }, nil},
+		{"Len", func(t assert.TestingT, m ...any) bool { return assert.Len(t, a, k, m...) }, nil},
+		{"True", func(t assert.TestingT, m ...any) bool { return assert.True(t, k == 1, m...) }, nil},
+		{"False", func(t assert.TestingT, m ...any) bool { return assert.False(t, k == 1, m...) }, nil},
+		{"InDelta", func(t assert.TestingT, m ...any) bool { return assert.InDelta(t, x, y, 0.5, m...) }, nil},
+		{"InEpsilon", func(t assert.TestingT, m ...any) bool { return assert.InEpsilon(t, x, y, 0.5, m...) }, nil},
+		{"Error", func(t assert.TestingT, m ...any) bool { return assert.Error(t, err, m...) }, nil},
+		{"NoError", func(t assert.TestingT, m ...any) bool { return assert.NoError(t, err, m...) }, nil},
+		{"ErrorIs", func(t assert.TestingT, m ...any) bool { return assert.ErrorIs(t, err, errA, m...) }, nil},
+		{"NotErrorIs", func(t assert.TestingT, m ...any) bool { return assert.NotErrorIs(t, err, errA, m...) }, nil},
+		{"EqualError", func(t assert.TestingT, m ...any) bool { return assert.EqualError(t, err, "wrapped: a", m...) }, nil},
+		{"ErrorContains", func(t assert.TestingT, m ...any) bool { return assert.ErrorContains(t, err, "a", m...) }, nil},
+		{"Regexp", func(t assert.TestingT, m ...any) bool { return assert.Regexp(t, "^a", fmt.Sprint(a), m...) }, nil},
+		{"NotRegexp", func(t assert.TestingT, m ...any) bool {
+			return assert.NotRegexp(t, regexp.MustCompile("^a"), fmt.Sprint(a), m...)
+		}, nil},
+		{"WithinDuration", func(t assert.TestingT, m ...any) bool {
