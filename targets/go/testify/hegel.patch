+// --------------------------------------------------------------------------- testify/15
+
+// TestHegelNotSameReturnsFalseWhenItFails: NotSame on two values that are not both pointers
+// fails and returns false; testify/15 reports the failure and returns true. Under
+// HEGEL_NO_KNOWN=1 both are pointers and NotSame is the negation of Same.
+func TestHegelNotSameReturnsFalseWhenItFails(t *testing.T) {
+	c := newCollector(t)
+	cases := pairs(shaped(plainValues, asAny(structPtrs)), shaped(values, asAny(structPtrs)))
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, cases)
+		a, b := cs.a, cs.b
+		both := isPtr(a) && isPtr(b)
+		same := both && reflect.TypeOf(a) == reflect.TypeOf(b) && reflect.ValueOf(a).Pointer() == reflect.ValueOf(b).Pointer()
+		c.count(fmt.Sprintf("%T/%T", a, b))
+		name := fmt.Sprintf("(%T %#v, %T %#v)", a, a, b, b)
+		if !expect(c, ht, "Same"+name, same, func(t assert.TestingT) bool { return assert.Same(t, a, b) }) {
+			return
+		}
+		expect(c, ht, "NotSame"+name, both && !same, func(t assert.TestingT) bool { return assert.NotSame(t, a, b) }, shapeIf(!both, "testify/15")...)
+	})
+}
+
+// --------------------------------------------------------------------------- testify/16
+
+// messageCase: two lists, the second a permutation of the first (the shape of testify/16:
+// NotElementsMatch fails and misreports the message) or one with an element dropped or added
+// (always under HEGEL_NO_KNOWN=1), and the message given.
+type messageCase struct {
+	list   intList
+	edited bool
+	drop   bool
+	add    int
+	keys   []int
+	msg    messageForm
+	marker int
+}
+
+func (c messageCase) other() []int {
+	zs := shuffled(c.list.xs, c.keys)
+	switch {
+	case !c.edited:
+		return zs
+	case c.drop && len(zs) > 0:
+		return zs[1:]
+	}
+	return append(zs, c.add)
+}
+
+func (c messageCase) GoString() string {
+	return fmt.Sprintf("NotElementsMatch(%#v, %v, message %v %d)", c.list, c.other(), []string{"none", "format", "plain"}[c.msg], c.marker)
+}
+
+var messageCases = hegel.Composite(func(tc hegel.TestCase) messageCase {
+	return messageCase{
+		list:   hegel.Draw(tc, intLists(4)),
+		edited: hegel.Draw(tc, shaped(chance(50), hegel.Just(true))),
+		drop:   hegel.Draw(tc, chance(50)),
+		add:    hegel.Draw(tc, listInts),
+		keys:   hegel.Draw(tc, many(positions, 0, 4)),
+		msg:    hegel.Draw(tc, hegel.SampledFrom([]messageForm{noMessage, formatMessage, plainMessage})),
+		marker: hegel.Draw(tc, hegel.Integers(1000, 9999)),
+	}
+})
+
+// TestHegelNotElementsMatchReportsTheMessage: NotElementsMatch returns true exactly when it
+// reported nothing, reports once, and its report carries the caller's formatted message on the
+// Messages line; testify/16 reports the message as a Go slice.
+func TestHegelNotElementsMatchReportsTheMessage(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, messageCases)
+		list, other := cs.list.value(), cs.other()
+		want := !reflect.DeepEqual(sortedCopy(cs.list.xs), sortedCopy(other))
+		// (an array of zeros against the emptied list is the shape of testify/18)
+		shape := append(shapeIf(!want, "testify/16"), shapeIf(want && emptyByRule(list) && emptyByRule(other), "testify/18")...)
+		msgAndArgs, text := contractCase{msg: cs.msg, marker: cs.marker}.msgAndArgs()
+		c.count("differ=" + strconv.FormatBool(want))
+		m := &mockT{}
+		var ok bool
+		var p any
+		func() {
+			defer func() { p = recover() }()
+			ok = assert.NotElementsMatch(m, list, other, msgAndArgs...)
+		}()
+		name := fmt.Sprintf("NotElementsMatch(%v, %v)", list, other)
+		if p != nil {
+			c.mismatch(ht, shape, "%s panicked: %v", name, p)
+			return
+		}
+		if ok != (len(m.msgs) == 0) {
+			c.mismatch(ht, shape, "%s returned %v but reported %d failure(s)", name, ok, len(m.msgs))
+			return
+		}
+		if ok != want {
+			c.mismatch(ht, shape, "%s = %v, want %v", name, ok, want)
+			return
+		}
+		if len(m.msgs) > 1 {
+			c.mismatch(ht, shape, "%s reported %d failures for one assertion", name, len(m.msgs))
+			return
+		}
+		if !ok {
+			reportCarriesMessage(c, ht, name, m.msgs[0], text, shape)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- testify/17
+
+// TestHegelPositiveWantsANumber: Positive and Negative fail on a string, a []byte and a
+// time.Time (the shape of testify/17: they pass strings above "" and times after the zero time);
+// on a number (under HEGEL_NO_KNOWN=1) they are Greater and Less than zero.
+func TestHegelPositiveWantsANumber(t *testing.T) {
+	c := newCollector(t)
+	var numeric, other []hegel.Generator[int]
+	for i, ot := range ordTypes {
+		if ot.numeric {
+			numeric = append(numeric, hegel.Just(i))
+		} else {
+			other = append(other, hegel.Just(i))
+		}
+	}
+	typeIdx := shaped(hegel.OneOf(other...), hegel.OneOf(numeric...))
+	cases := hegel.FlatMap(typeIdx, func(ti int) hegel.Generator[pair[int, any]] { return pairs(hegel.Just(ti), ordTypes[ti].values) })
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, cases)
+		ot, a := ordTypes[cs.a], cs.b
+		wantPos, wantNeg := false, false
+		if ot.numeric {
+			cz := ot.cmp(a, reflect.Zero(ot.typ).Interface())
+			wantPos, wantNeg = cz > 0, cz < 0
+		}
+		shape := shapeIf(!ot.numeric, "testify/17")
+		c.count(ot.name)
+		name := fmt.Sprintf("(%T %v)", a, a)
+		if !expect(c, ht, "Positive"+name, wantPos, func(t assert.TestingT) bool { return assert.Positive(t, a) }, shape...) {
+			return
+		}
+		expect(c, ht, "Negative"+name, wantNeg, func(t assert.TestingT) bool { return assert.Negative(t, a) }, shape...)
+	})
+}
+
+// --------------------------------------------------------------------------- testify/18
+
+// zeroArrayCase: an array of one to three zeros (the shape of testify/18: ElementsMatch takes
+// it for empty; under HEGEL_NO_KNOWN=1 a list with an element, or a zero slice) and an empty
+// list.
+type zeroArrayCase struct {
+	a, b any
+}
+
+func (c zeroArrayCase) GoString() string { return fmt.Sprintf("%T %v, %T %v", c.a, c.a, c.b, c.b) }
