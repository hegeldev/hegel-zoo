+		xs, ys := floatsOf(cs.xs), floatsOf(cs.ys)
+		if len(xs) == len(ys) {
+			all := true
+			for i := range xs {
+				all = all && modelInDelta(xs[i], ys[i], delta)
+			}
+			if !expect(c, ht, fmt.Sprintf("InDeltaSlice(%v, %v, %v)", xs, ys, delta), all, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys, delta) }, shape...) {
+				return
+			}
+		}
+		ma, mb := cs.ma, cs.mb
+		allM := len(ma) == len(mb)
+		for key, v := range ma {
+			w, ok := mb[key]
+			if !ok || !modelInDelta(v, w, delta) {
+				allM = false
+			}
+		}
+		expect(c, ht, fmt.Sprintf("InDeltaMapValues(%v, %v, %v)", ma, mb, delta), allM, func(t assert.TestingT) bool { return assert.InDeltaMapValues(t, ma, mb, delta) }, shape...)
+	})
+}
+
+// --------------------------------------------------------------------------- testify/11
+
+// lengthCase: two slices of numbers of different lengths (the shape of testify/11; the same
+// length under HEGEL_NO_KNOWN=1) and a delta.
+type lengthCase struct {
+	xs, ys []numish
+	delta  float64
+}
+
+func (c lengthCase) GoString() string { return fmt.Sprintf("%#v, %#v, %v", c.xs, c.ys, c.delta) }
+
+var lengthCases = hegel.Composite(func(tc hegel.TestCase) lengthCase {
+	k := hegel.Draw(tc, hegel.Integers(0, 3))
+	k2 := (k + hegel.Draw(tc, shaped(hegel.Integers(1, 3), hegel.Just(0)))) % 4
+	return lengthCase{
+		xs:    hegel.Draw(tc, many(numishes, k, k)),
+		ys:    hegel.Draw(tc, many(numishes, k2, k2)),
+		delta: hegel.Draw(tc, hegel.SampledFrom(deltaPool)),
+	}
+})
+
+// TestHegelInDeltaSliceComparesTheLengths: InDeltaSlice and InEpsilonSlice fail on slices of
+// different lengths; testify/11 passes a shorter actual slice and panics on a longer one.
+func TestHegelInDeltaSliceComparesTheLengths(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, lengthCases)
+		xs, ys := floatsOf(cs.xs), floatsOf(cs.ys)
+		shape := shapeIf(len(xs) != len(ys), "testify/11")
+		all, allE := len(xs) == len(ys), len(xs) == len(ys)
+		for i := 0; i < len(xs) && i < len(ys); i++ {
+			all = all && modelInDelta(xs[i], ys[i], cs.delta)
+			allE = allE && modelInEpsilon(xs[i], ys[i], cs.delta)
+		}
+		c.count(fmt.Sprintf("%d/%d", len(xs), len(ys)))
+		name := fmt.Sprintf("(%v, %v, %v)", xs, ys, cs.delta)
+		if !expect(c, ht, "InDeltaSlice"+name, all, func(t assert.TestingT) bool { return assert.InDeltaSlice(t, xs, ys, cs.delta) }, shape...) {
+			return
+		}
+		expect(c, ht, "InEpsilonSlice"+name, allE, func(t assert.TestingT) bool { return assert.InEpsilonSlice(t, xs, ys, cs.delta) }, shape...)
+	})
+}
+
+// --------------------------------------------------------------------------- testify/12
+
+// mixedKindCase: a []byte or a time.Time and a value of another type of the same kind (a []int,
+// an empty struct: the shape of testify/12) or, under HEGEL_NO_KNOWN=1, of another kind.
+type mixedKindCase struct {
+	a, b any
+}
+
+func (c mixedKindCase) GoString() string { return fmt.Sprintf("%T %#v, %T %#v", c.a, c.a, c.b, c.b) }
+
+var (
+	sameKindOthers = hegel.SampledFrom([]any{[]int{1}, []int{}, struct{}{}, S{1, "x"}, []string{"a"}})
+	mixedKindCases = hegel.Composite(func(tc hegel.TestCase) mixedKindCase {
+		a := hegel.Draw(tc, hegel.OneOf(asAny(ordBytes), asAny(hourOffsets)))
+		kind := reflect.TypeOf(a).Kind()
+		var same, other []any
+		for _, v := range []any{[]int{1}, []int{}, struct{}{}, S{1, "x"}, []string{"a"}, 1, "a", 2.5, true} {
+			if reflect.TypeOf(v).Kind() == kind {
+				same = append(same, v)
+			} else {
+				other = append(other, v)
+			}
+		}
