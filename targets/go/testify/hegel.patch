+// assertions: the calls; NotElementsMatch on an argument that is not a list reports twice
+// (testify/16) and is left out under HEGEL_NO_KNOWN=1.
+func (c nilCase) assertions() []namedAssertion {
+	a, b := c.a, c.b
+	out := []namedAssertion{
+		{"Subset", func(t assert.TestingT, m ...any) bool { return assert.Subset(t, a, b, m...) }, nil},
+		{"NotSubset", func(t assert.TestingT, m ...any) bool { return assert.NotSubset(t, a, b, m...) }, nil},
+		{"ElementsMatch", func(t assert.TestingT, m ...any) bool { return assert.ElementsMatch(t, a, b, m...) }, nil},
+		{"IsIncreasing", func(t assert.TestingT, m ...any) bool { return assert.IsIncreasing(t, a, m...) }, nil},
+		{"IsNonIncreasing", func(t assert.TestingT, m ...any) bool { return assert.IsNonIncreasing(t, a, m...) }, nil},
+		{"IsDecreasing", func(t assert.TestingT, m ...any) bool { return assert.IsDecreasing(t, a, m...) }, nil},
+		{"IsNonDecreasing", func(t assert.TestingT, m ...any) bool { return assert.IsNonDecreasing(t, a, m...) }, nil},
+		{"Positive", func(t assert.TestingT, m ...any) bool { return assert.Positive(t, a, m...) }, nil},
+		{"Negative", func(t assert.TestingT, m ...any) bool { return assert.Negative(t, a, m...) }, nil},
+	}
+	lists := isList(a) && isList(b)
+	if lists || !Known.notElementsMatchMessage {
+		out = append(out, namedAssertion{"NotElementsMatch", func(t assert.TestingT, m ...any) bool { return assert.NotElementsMatch(t, a, b, m...) },
+			shapeIf(!lists, "testify/16")})
+	}
+	return out
