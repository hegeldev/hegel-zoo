+// poolWhere: the values of the type's full pool that satisfy pred.
+func poolWhere(t numType, pred func(x *big.Float) bool) []num {
+	var out []num
+	for _, n := range t.pool(fullPool) {
+		if pred(n.exact) {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// typesWhere: the indexes of the numeric types satisfying pred.
+func typesWhere(pred func(t numType) bool) []int {
+	var out []int
+	for i, t := range numTypes {
+		if pred(t) {
+			out = append(out, i)
+		}
+	}
+	return out
+}
+
+func cmpValues(a, b num) bool { return a.exact.Cmp(b.exact) == 0 }
+
+// checkEqualValues: EqualValues, NotEqualValues and ObjectsAreEqualValues agree with the exact
+// comparison of the two numbers.
+func checkEqualValues(c *collector, ht *hegel.T, a, b num, shape []string) {
+	want := cmpValues(a, b)
+	name := fmt.Sprintf("(%#v, %#v)", a, b)
+	if !expect(c, ht, "EqualValues"+name, want, func(t assert.TestingT) bool { return assert.EqualValues(t, a.v, b.v) }, shape...) {
+		return
+	}
+	if !expect(c, ht, "NotEqualValues"+name, !want, func(t assert.TestingT) bool { return assert.NotEqualValues(t, a.v, b.v) }, shape...) {
+		return
+	}
+	if got := assert.ObjectsAreEqualValues(a.v, b.v); got != want {
+		c.mismatch(ht, shape, "ObjectsAreEqualValues%s = %v, want %v", name, got, want)
+	}
+}
+
+// --------------------------------------------------------------------------- testify/1
+
+// wrapCase: a signed and an unsigned integer of the same width, the unsigned one at or above
+// the sign bit (the shape of testify/1: converted to the signed type it wraps negative) and half
+// of the time the very bit pattern of the signed one; under HEGEL_NO_KNOWN=1 both below it.
+type wrapCase struct {
+	a, b num
+}
+
+func (c wrapCase) GoString() string { return fmt.Sprintf("%#v, %#v", c.a, c.b) }
+
+var (
+	widths    = hegel.SampledFrom([]int{8, 16, 32, 64})
+	wrapCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+		w := hegel.Draw(tc, widths)
+		si := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool { return t.signed && t.bits == w })))
+		ui := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool { return !t.signed && !t.float && t.bits == w })))
+		tu := numTypes[ui]
+		signBit := pow2(w - 1)
+		a := hegel.Draw(tc, numGens[si][shaped(fullPool, nonNegativePool)])
+		high := poolWhere(tu, func(x *big.Float) bool { return x.Cmp(signBit) >= 0 })
+		low := poolWhere(tu, func(x *big.Float) bool { return x.Cmp(signBit) < 0 })
+		mirror := new(big.Float).Add(a.exact, pow2(w))
+		if a.exact.Sign() >= 0 {
+			mirror = a.exact
+		}
+		b := hegel.Draw(tc, shaped(
+			weighted(choice[num]{50, hegel.SampledFrom(high)}, choice[num]{50, hegel.Just(num{tu.value(mirror), mirror})}),
+			hegel.SampledFrom(low)))
+		return wrapCase{a, b}
+	})
+)
+
+// TestHegelEqualValuesKeepsSignedAndUnsignedApart: EqualValues on a signed and an unsigned
+// integer of the same width is exact comparison; testify/1 converts one to the other's type
+// and equates int8(-1) with uint8(255).
+func TestHegelEqualValuesKeepsSignedAndUnsignedApart(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, wrapCases)
+		c.count(fmt.Sprintf("%T/%T", cs.a.v, cs.b.v))
+		checkEqualValues(c, ht, cs.a, cs.b, known("testify/1"))
+		checkEqualValues(c, ht, cs.b, cs.a, known("testify/1"))
+	})
+}
+
+// --------------------------------------------------------------------------- testify/2
+
+// fractionCase: an integer (the expected value, at least as wide as the float) and a float
+// with a fraction or out of the integer's range (the shape of testify/2: truncated to the
+// integer type), half of the time one whose truncation is the integer; under HEGEL_NO_KNOWN=1
+// an integral float.
+type fractionCase struct {
+	a, b num
+}
+
+func (c fractionCase) GoString() string { return fmt.Sprintf("%#v, %#v", c.a, c.b) }
+
+var fractionCases = hegel.Composite(func(tc hegel.TestCase) fractionCase {
+	fi := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool { return t.float })))
+	tf := numTypes[fi]
+	ii := hegel.Draw(tc, hegel.SampledFrom(typesWhere(func(t numType) bool { return !t.float && t.bits >= tf.bits })))
+	ti := numTypes[ii]
+	b := hegel.Draw(tc, shaped(
+		hegel.SampledFrom(poolWhere(tf, func(x *big.Float) bool { return !x.IsInt() || !ti.holds(x) })),
+		numGens[fi][integralPool]))
+	trunc := new(big.Float).SetPrec(200)
+	if b.exact.IsInf() {
+		trunc.SetInt64(0)
+	} else {
+		i, _ := b.exact.Int(nil)
+		trunc.SetInt(i)
+	}
+	if !ti.holds(trunc) {
+		trunc.SetInt64(0)
+	}
+	a := hegel.Draw(tc, shaped(
+		weighted(choice[num]{50, numGens[ii][fullPool]}, choice[num]{50, hegel.Just(num{ti.value(trunc), trunc})}),
+		numGens[ii][integralPool]))
+	return fractionCase{a, b}
+})
+
+// TestHegelEqualValuesRejectsFractionsAgainstIntegers: EqualValues on an integer and a float
+// is exact comparison; testify/2 truncates the float to the integer type, so 1 equals 1.5.
+func TestHegelEqualValuesRejectsFractionsAgainstIntegers(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, fractionCases)
+		c.count(fmt.Sprintf("%T/%T", cs.a.v, cs.b.v))
+		checkEqualValues(c, ht, cs.a, cs.b, known("testify/2"))
+		checkEqualValues(c, ht, cs.b, cs.a, known("testify/2"))
+	})
+}
