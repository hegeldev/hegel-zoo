+package assert_test
+
+// The contract shared by every assertion: it returns true exactly when it reported nothing,
+// reports at most once, never panics on ordinary arguments, and reports the caller's message
+// (formatted with its arguments) verbatim in a "Messages:" line. Also JSONEq/YAMLEq against a
+// generated document serialised twice.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+type namedAssertion struct {
+	name string
+	f    func(t assert.TestingT, msgAndArgs ...any) bool
+}
+
+var errA = errors.New("a")
+var errB = errors.New("b")
+
+func isList(v any) bool {
+	if v == nil {
+		return false
+	}
+	k := reflect.TypeOf(v).Kind()
+	return k == reflect.Slice || k == reflect.Array
+}
+
+// assertionsOn: assertion calls on generated arguments that must not panic (shapes covered by
+// recorded bugs are left out).
+func assertionsOn(tc hegel.TestCase) []namedAssertion {
+	a, b := genValue(tc, 0), genValue(tc, 0)
+	if chance(tc, 30) {
+		b = clone(a)
+	}
+	k := n(tc, 0, 2)
+	x, fx := genFloatish(tc)
+	y, fy := genFloatish(tc)
+	_, _ = fx, fy
+	var err error
+	if chance(tc, 50) {
+		err = fmt.Errorf("wrapped: %w", pick(tc, []error{errA, errB}))
+	}
+	tm := baseTime.Add(time.Duration(n(tc, -2, 2)) * time.Second)
+	panicky := chance(tc, 50)
+	out := []namedAssertion{
+		{"Equal", func(t assert.TestingT, m ...any) bool { return assert.Equal(t, a, b, m...) }},
+		{"NotEqual", func(t assert.TestingT, m ...any) bool { return assert.NotEqual(t, a, b, m...) }},
+		{"Exactly", func(t assert.TestingT, m ...any) bool { return assert.Exactly(t, a, b, m...) }},
+		{"IsType", func(t assert.TestingT, m ...any) bool { return assert.IsType(t, a, b, m...) }},
+		{"IsNotType", func(t assert.TestingT, m ...any) bool { return assert.IsNotType(t, a, b, m...) }},
+		{"Same", func(t assert.TestingT, m ...any) bool { return assert.Same(t, a, b, m...) }},
+		{"Empty", func(t assert.TestingT, m ...any) bool { return assert.Empty(t, a, m...) }},
+		{"NotEmpty", func(t assert.TestingT, m ...any) bool { return assert.NotEmpty(t, a, m...) }},
+		{"Zero", func(t assert.TestingT, m ...any) bool { return assert.Zero(t, a, m...) }},
+		{"NotZero", func(t assert.TestingT, m ...any) bool { return assert.NotZero(t, a, m...) }},
+		{"Nil", func(t assert.TestingT, m ...any) bool { return assert.Nil(t, a, m...) }},
+		{"NotNil", func(t assert.TestingT, m ...any) bool { return assert.NotNil(t, a, m...) }},
+		{"Len", func(t assert.TestingT, m ...any) bool { return assert.Len(t, a, k, m...) }},
+		{"True", func(t assert.TestingT, m ...any) bool { return assert.True(t, k == 1, m...) }},
+		{"False", func(t assert.TestingT, m ...any) bool { return assert.False(t, k == 1, m...) }},
+		{"InDelta", func(t assert.TestingT, m ...any) bool { return assert.InDelta(t, x, y, 0.5, m...) }},
+		{"InEpsilon", func(t assert.TestingT, m ...any) bool { return assert.InEpsilon(t, x, y, 0.5, m...) }},
+		{"Error", func(t assert.TestingT, m ...any) bool { return assert.Error(t, err, m...) }},
+		{"NoError", func(t assert.TestingT, m ...any) bool { return assert.NoError(t, err, m...) }},
+		{"ErrorIs", func(t assert.TestingT, m ...any) bool { return assert.ErrorIs(t, err, errA, m...) }},
+		{"NotErrorIs", func(t assert.TestingT, m ...any) bool { return assert.NotErrorIs(t, err, errA, m...) }},
+		{"EqualError", func(t assert.TestingT, m ...any) bool { return assert.EqualError(t, err, "wrapped: a", m...) }},
+		{"ErrorContains", func(t assert.TestingT, m ...any) bool { return assert.ErrorContains(t, err, "a", m...) }},
+		{"Regexp", func(t assert.TestingT, m ...any) bool { return assert.Regexp(t, "^a", fmt.Sprint(a), m...) }},
+		{"NotRegexp", func(t assert.TestingT, m ...any) bool {
+			return assert.NotRegexp(t, regexp.MustCompile("^a"), fmt.Sprint(a), m...)
+		}},
+		{"WithinDuration", func(t assert.TestingT, m ...any) bool {
+			return assert.WithinDuration(t, tm, baseTime, time.Second, m...)
+		}},
+		{"WithinRange", func(t assert.TestingT, m ...any) bool {
+			return assert.WithinRange(t, tm, baseTime, baseTime.Add(time.Second), m...)
+		}},
+		{"Panics", func(t assert.TestingT, m ...any) bool {
+			return assert.Panics(t, func() {
+				if panicky {
+					panic("boom")
+				}
+			}, m...)
+		}},
+		{"NotPanics", func(t assert.TestingT, m ...any) bool {
+			return assert.NotPanics(t, func() {
+				if panicky {
+					panic("boom")
+				}
+			}, m...)
+		}},
+		{"PanicsWithValue", func(t assert.TestingT, m ...any) bool {
+			return assert.PanicsWithValue(t, "boom", func() {
+				if panicky {
+					panic(pick(tc, []string{"boom", "bang"}))
+				}
+			}, m...)
+		}},
+		{"PanicsWithError", func(t assert.TestingT, m ...any) bool {
+			return assert.PanicsWithError(t, "a", func() {
+				if panicky {
+					panic(errA)
+				}
+			}, m...)
+		}},
+		{"Condition", func(t assert.TestingT, m ...any) bool {
+			return assert.Condition(t, func() bool { return k == 1 }, m...)
+		}},
+		{"JSONEq", func(t assert.TestingT, m ...any) bool {
+			return assert.JSONEq(t, `{"a": 1}`, pick(tc, []string{`{"a":1}`, `{"a":2}`, `nope`}), m...)
+		}},
+		{"YAMLEq", func(t assert.TestingT, m ...any) bool {
+			return assert.YAMLEq(t, "a: 1", pick(tc, []string{"a: 1", "a: 2", "a: [b"}), m...)
+		}},
+		{"NoFileExists", func(t assert.TestingT, m ...any) bool {
+			return assert.NoFileExists(t, pick(tc, []string{"hegel_test.go", "no-such-file"}), m...)
+		}},
+		{"FileExists", func(t assert.TestingT, m ...any) bool {
+			return assert.FileExists(t, pick(tc, []string{"hegel_test.go", "no-such-file", "."}), m...)
+		}},
+		{"DirExists", func(t assert.TestingT, m ...any) bool {
+			return assert.DirExists(t, pick(tc, []string{"hegel_test.go", "no-such-file", "."}), m...)
+		}},
+		{"NoDirExists", func(t assert.TestingT, m ...any) bool {
+			return assert.NoDirExists(t, pick(tc, []string{"hegel_test.go", "no-such-file", "."}), m...)
+		}},
+		{"Implements", func(t assert.TestingT, m ...any) bool { return assert.Implements(t, (*error)(nil), a, m...) }},
+		{"NotImplements", func(t assert.TestingT, m ...any) bool { return assert.NotImplements(t, (*error)(nil), a, m...) }},
+	}
+	if isPtr(a) && isPtr(b) || !Known.notSameReturn {
+		out = append(out, namedAssertion{"NotSame", func(t assert.TestingT, m ...any) bool { return assert.NotSame(t, a, b, m...) }})
+	}
+	_, aStr := a.(string)
+	_, bStr := b.(string)
+	if !aStr || bStr || !Known.containsValueText {
+		out = append(out,
+			namedAssertion{"Contains", func(t assert.TestingT, m ...any) bool { return assert.Contains(t, a, b, m...) }},
+			namedAssertion{"NotContains", func(t assert.TestingT, m ...any) bool { return assert.NotContains(t, a, b, m...) }})
+	}
+	if a != nil || !Known.nilPanics {
+		out = append(out,
+			namedAssertion{"Subset", func(t assert.TestingT, m ...any) bool { return assert.Subset(t, a, b, m...) }},
+			namedAssertion{"NotSubset", func(t assert.TestingT, m ...any) bool { return assert.NotSubset(t, a, b, m...) }},
+			namedAssertion{"IsIncreasing", func(t assert.TestingT, m ...any) bool { return assert.IsIncreasing(t, a, m...) }},
+			namedAssertion{"IsNonDecreasing", func(t assert.TestingT, m ...any) bool { return assert.IsNonDecreasing(t, a, m...) }},
+			namedAssertion{"Positive", func(t assert.TestingT, m ...any) bool { return assert.Positive(t, a, m...) }},
+			namedAssertion{"Negative", func(t assert.TestingT, m ...any) bool { return assert.Negative(t, a, m...) }})
+		if (isList(a) && isList(b)) || !Known.emptyNonList && !Known.nilPanics {
+			// (testify/18 only changes the verdict, not the contract: kept)
+			out = append(out, namedAssertion{"ElementsMatch", func(t assert.TestingT, m ...any) bool { return assert.ElementsMatch(t, a, b, m...) }})
+			if !Known.notElementsMatchMessage {
+				out = append(out, namedAssertion{"NotElementsMatch", func(t assert.TestingT, m ...any) bool { return assert.NotElementsMatch(t, a, b, m...) }})
+			}
+		}
+	}
+	sameKind := a != nil && b != nil && reflect.TypeOf(a) == reflect.TypeOf(b)
+	if sameKind || !Known.compareConvertPanic {
+		out = append(out,
+			namedAssertion{"Greater", func(t assert.TestingT, m ...any) bool { return assert.Greater(t, a, b, m...) }},
+			namedAssertion{"LessOrEqual", func(t assert.TestingT, m ...any) bool { return assert.LessOrEqual(t, a, b, m...) }})
+	}
+	if !(isList(a) && isList(b) && reflect.TypeOf(a) != reflect.TypeOf(b)) || !Known.sliceArrayPanic {
+		out = append(out,
+			namedAssertion{"EqualValues", func(t assert.TestingT, m ...any) bool { return assert.EqualValues(t, a, b, m...) }},
+			namedAssertion{"NotEqualValues", func(t assert.TestingT, m ...any) bool { return assert.NotEqualValues(t, a, b, m...) }})
+	}
+	return out
+}
+
+// TestHegelAssertionsKeepTheContract: on generated arguments every assertion returns true iff
+// it reported nothing, reports once, does not panic, and the report carries the caller's
+// formatted message on its "Messages:" line exactly once.
+func TestHegelAssertionsKeepTheContract(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		as := assertionsOn(ht)
+		na := pick(ht, as)
+		marker := n(ht, 1000, 9999)
+		var msgAndArgs []any
+		want := ""
+		switch n(ht, 0, 2) {
+		case 0:
+			msgAndArgs = []any{"hegel marker %d here", marker}
+			want = "hegel marker " + strconv.Itoa(marker) + " here"
+		case 1:
+			msgAndArgs = []any{"hegel plain " + strconv.Itoa(marker)}
+			want = "hegel plain " + strconv.Itoa(marker)
+		}
+		m := &mockT{}
+		var ok bool
+		var p any
+		func() {
+			defer func() { p = recover() }()
+			ok = na.f(m, msgAndArgs...)
+		}()
+		if p != nil {
+			c.fail(ht, "%s panicked: %v", na.name, p)
+			return
+		}
+		c.count(na.name + "=" + strconv.FormatBool(ok))
+		if ok != (len(m.msgs) == 0) {
+			c.fail(ht, "%s returned %v but reported %d failure(s)", na.name, ok, len(m.msgs))
+			return
+		}
+		if len(m.msgs) > 1 {
+			c.fail(ht, "%s reported %d failures for one assertion", na.name, len(m.msgs))
+			return
+		}
+		if ok {
+			return
+		}
+		report := m.msgs[0]
+		if want == "" {
+			if strings.Contains(report, "Messages:") {
+				c.fail(ht, "%s reported a Messages line without a message:\n%s", na.name, report)
+			}
+			return
+		}
+		lines := strings.Split(report, "\n")
+		found := 0
+		for _, l := range lines {
+			if strings.Contains(l, "Messages:") {
+				if !strings.HasSuffix(l, "\t"+want) {
+					c.fail(ht, "%s Messages line %q does not end with the message %q", na.name, l, want)
+					return
+				}
+				found++
+			}
+		}
+		if found != 1 {
+			c.fail(ht, "%s report has %d Messages lines, want 1:\n%s", na.name, found, report)
+			return
+		}
+		if strings.Count(report, want) != 1 {
+			c.fail(ht, "%s report mentions the message %d times:\n%s", na.name, strings.Count(report, want), report)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- JSONEq / YAMLEq
+
+// genDoc: a JSON value (numbers below 2^53 while testify/14 is open).
+func genDoc(tc hegel.TestCase, depth int) any {
+	switch n(tc, 0, 6) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2:
+		if Known.bigIntegers {
+			return int64(n(tc, -1000, 1000))
+		}
+		return int64(9007199254740992) + int64(n(tc, 0, 3))
+	case 3:
+		return pick(tc, []float64{0.5, -1.25, 100.75})
+	case 4:
+		return pick(tc, []string{"", "a", "hello world", "yes", "null", "1"})
+	case 5:
+		if depth > 2 {
+			return "leaf"
+		}
+		xs := []any{}
+		for k := n(tc, 0, 3); k > 0; k-- {
+			xs = append(xs, genDoc(tc, depth+1))
+		}
+		return xs
+	}
+	if depth > 2 {
+		return "leaf"
+	}
+	m := map[string]any{}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		m[pick(tc, []string{"a", "b", "c", "d"})] = genDoc(tc, depth+1)
+	}
+	return m
+}
+
+// serialise: JSON text for v with the object keys in a random order and random whitespace.
+func serialise(tc hegel.TestCase, v any) string {
+	ws := func() string { return pick(tc, []string{"", " ", "\n", "  "}) }
+	switch x := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return strconv.FormatBool(x)
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case float64:
+		return strconv.FormatFloat(x, 'f', -1, 64)
+	case string:
+		b, _ := json.Marshal(x)
+		return string(b)
+	case []any:
+		parts := make([]string, len(x))
+		for i := range x {
+			parts[i] = serialise(tc, x[i])
+		}
+		return "[" + ws() + strings.Join(parts, ","+ws()) + ws() + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for i := len(keys) - 1; i > 0; i-- {
+			j := n(tc, 0, i)
+			keys[i], keys[j] = keys[j], keys[i]
+		}
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			kb, _ := json.Marshal(k)
+			parts[i] = string(kb) + ":" + ws() + serialise(tc, x[k])
+		}
+		return "{" + ws() + strings.Join(parts, ","+ws()) + ws() + "}"
+	}
+	panic(fmt.Sprintf("serialise: %T", v))
+}
+
+// mutate: a value that differs from v.
+func mutate(tc hegel.TestCase, v any) any {
+	switch x := v.(type) {
+	case nil:
+		return false
+	case bool:
+		return !x
+	case int64:
+		return x + 1
+	case float64:
+		return x + 1
+	case string:
+		return x + "!"
+	case []any:
+		if len(x) > 0 && chance(tc, 60) {
+			ys := append([]any{}, x...)
+			i := n(tc, 0, len(ys)-1)
+			ys[i] = mutate(tc, ys[i])
+			return ys
+		}
+		return append(append([]any{}, x...), int64(7))
+	case map[string]any:
+		m := map[string]any{}
+		for k, val := range x {
+			m[k] = val
+		}
+		if len(m) > 0 && chance(tc, 60) {
+			keys := make([]string, 0, len(m))
+			for k := range m {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			k := pick(tc, keys)
+			m[k] = mutate(tc, m[k])
+			return m
+		}
+		m["zz"] = int64(7)
+		return m
+	}
+	return math.NaN()
+}
+
+// TestHegelJSONEqFollowsTheModel: two serialisations of one document are JSONEq (and YAMLEq,
+// JSON being YAML), a serialisation of a mutated document is not; invalid text fails.
+func TestHegelJSONEqFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		doc := genDoc(ht, 0)
+		s1, s2 := serialise(ht, doc), serialise(ht, doc)
+		var want bool
+		if chance(ht, 50) {
+			s2 = serialise(ht, mutate(ht, doc))
+			want = false
+		} else {
+			want = true
+		}
+		c.count("eq=" + strconv.FormatBool(want))
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, %s)", s1, s2), want, func(t assert.TestingT) bool { return assert.JSONEq(t, s1, s2) }) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, %s)", s2, s1), want, func(t assert.TestingT) bool { return assert.JSONEq(t, s2, s1) }) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("YAMLEq(%s, %s)", s1, s2), want, func(t assert.TestingT) bool { return assert.YAMLEq(t, s1, s2) }) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("JSONEq(%s, bad)", s1), false, func(t assert.TestingT) bool { return assert.JSONEq(t, s1, s2+"]") }) {
+			return
+		}
+		expect(c, ht, fmt.Sprintf("JSONEq(bad, %s)", s1), false, func(t assert.TestingT) bool { return assert.JSONEq(t, "{"+s1, s1) })
+	})
+}
diff --git a/assert/hegel_equal_test.go b/assert/hegel_equal_test.go
new file mode 100644
index 0000000..042aae2
--- /dev/null
+++ b/assert/hegel_equal_test.go
