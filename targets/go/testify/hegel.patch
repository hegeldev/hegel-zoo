+// --------------------------------------------------------------------------- testify/13
+
+// nilLeafCase: an X and where a nil interface is put into it: into its map, into its list, or
+// (under HEGEL_NO_KNOWN=1 always) nowhere; and an independent X.
+type nilLeafCase struct {
+	a     X
+	where int
+	other X
+}
+
+// value is a with the nil leaf.
+func (c nilLeafCase) value() X {
