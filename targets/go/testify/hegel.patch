--- /dev/null
+++ b/assert/hegel_collections_test.go
@@ -0,0 +1,258 @@
+package assert_test
+
+// Collections: Contains, NotContains, Subset, NotSubset, ElementsMatch, NotElementsMatch on
+// slices, arrays, maps and strings against set and multiset models.
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// genInts: a small []int, sometimes returned as an array of the same content.
+func genInts(tc hegel.TestCase, maxLen int) ([]int, any) {
+	xs := make([]int, n(tc, 0, maxLen))
+	for i := range xs {
+		xs[i] = n(tc, 0, 3)
+	}
+	if chance(tc, 25) {
+		arr := reflect.New(reflect.ArrayOf(len(xs), reflect.TypeOf(0))).Elem()
+		reflect.Copy(arr, reflect.ValueOf(xs))
+		return xs, arr.Interface()
+	}
+	if chance(tc, 10) && len(xs) == 0 {
+		return xs, []int(nil)
+	}
+	return xs, xs
+}
+
+// isZeroArray: an array whose elements are all zero (testify/18 treats it as empty).
+func isZeroArray(v any) bool {
+	rv := reflect.ValueOf(v)
+	return rv.Kind() == reflect.Array && rv.IsZero()
+}
+
+func containsInt(xs []int, x int) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func sortedCopy(xs []int) []int {
+	ys := append([]int{}, xs...)
+	sort.Ints(ys)
+	return ys
+}
+
+func shuffle(tc hegel.TestCase, xs []int) []int {
+	ys := append([]int{}, xs...)
+	for i := len(ys) - 1; i > 0; i-- {
+		j := n(tc, 0, i)
+		ys[i], ys[j] = ys[j], ys[i]
+	}
+	return ys
+}
+
+// TestHegelCollectionsFollowTheModel: Contains is membership (keys for maps, substrings for
+// strings), Subset is set containment (map/map: pairs; map/list: keys), ElementsMatch is
+// multiset equality and invariant under permutation, with NotX = !X and Len = the length.
+func TestHegelCollectionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		xs, list := genInts(ht, 4)
+		ys, sub := genInts(ht, 3)
+		// Contains on the list
+		x := n(ht, 0, 4)
+		var elem any = x
+		wantC := containsInt(xs, x)
+		if chance(ht, 15) {
+			elem = int64(x) // a different type never matches
+			wantC = false
+		}
+		name := fmt.Sprintf("(%T %v, %T %v)", list, list, elem, elem)
+		c.count("contains=" + strconv.FormatBool(wantC))
+		if !expect(c, ht, "Contains"+name, wantC, func(t assert.TestingT) bool { return assert.Contains(t, list, elem) }) {
+			return
+		}
+		if !expect(c, ht, "NotContains"+name, !wantC, func(t assert.TestingT) bool { return assert.NotContains(t, list, elem) }) {
+			return
+		}
+		if !expect(c, ht, fmt.Sprintf("Len(%v, %d)", list, len(xs)), true, func(t assert.TestingT) bool { return assert.Len(t, list, len(xs)) }) {
+			return
+		}
+		// Subset
+		wantS := true
+		for _, y := range ys {
+			if !containsInt(xs, y) {
+				wantS = false
+			}
+		}
+		sn := fmt.Sprintf("(%T %v, %T %v)", list, list, sub, sub)
+		c.count("subset=" + strconv.FormatBool(wantS))
+		if !expect(c, ht, "Subset"+sn, wantS, func(t assert.TestingT) bool { return assert.Subset(t, list, sub) }) {
+			return
+		}
+		if !expect(c, ht, "NotSubset"+sn, !wantS, func(t assert.TestingT) bool { return assert.NotSubset(t, list, sub) }) {
+			return
+		}
+		// a list is a subset of itself, and of itself plus anything
+		if !expect(c, ht, "Subset(self)"+sn, true, func(t assert.TestingT) bool { return assert.Subset(t, list, list) }) {
+			return
+		}
+		// ElementsMatch: multiset equality; shuffling changes nothing
+		var zs []int
+		var other any
+		switch n(ht, 0, 2) {
+		case 0:
+			zs = shuffle(ht, xs)
+			other = zs
+		case 1:
+			zs, other = genInts(ht, 4)
+		default:
+			zs = shuffle(ht, xs)
+			if len(zs) > 0 && chance(ht, 50) {
+				zs = zs[1:]
+			} else {
+				zs = append(zs, n(ht, 0, 3))
+			}
+			other = zs
+		}
+		wantM := reflect.DeepEqual(sortedCopy(xs), sortedCopy(zs))
+		if Known.zeroArrayEmpty && len(xs) != len(zs) && (isZeroArray(list) || isZeroArray(other)) {
+			return
+		}
+		mn := fmt.Sprintf("(%T %v, %T %v)", list, list, other, other)
+		c.count("match=" + strconv.FormatBool(wantM))
+		if !expect(c, ht, "ElementsMatch"+mn, wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, list, other) }) {
+			return
+		}
+		if !expect(c, ht, "ElementsMatch(b,a)"+mn, wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, other, list) }) {
+			return
+		}
+		if !expect(c, ht, "NotElementsMatch"+mn, !wantM, func(t assert.TestingT) bool { return assert.NotElementsMatch(t, list, other) }) {
+			return
+		}
+		perm := shuffle(ht, zs)
+		if !expect(c, ht, fmt.Sprintf("ElementsMatch(%v, %v)", list, perm), wantM, func(t assert.TestingT) bool { return assert.ElementsMatch(t, list, perm) }) {
+			return
+		}
+		// ElementsMatch and Subset both ways is the same as ElementsMatch when there are no
+		// duplicates; Subset both ways is set equality
+		if wantM && !wantS && len(ys) > 0 && reflect.DeepEqual(sortedCopy(ys), sortedCopy(zs)) {
+			c.fail(ht, "%v matches %v but is not a superset of it", list, other)
+			return
+		}
+	})
+}
+
+// TestHegelMapAndStringCollectionsFollowTheModel: Contains on a map is key membership and on a
+// string a substring test; Subset of two maps needs every pair, of a map and a list the keys.
+func TestHegelMapAndStringCollectionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	keys := []string{"a", "b", "c"}
+	genMap := func(tc hegel.TestCase) map[string]int {
+		m := map[string]int{}
+		for _, k := range keys {
+			if chance(tc, 50) {
+				m[k] = n(tc, 0, 1)
+			}
+		}
+		return m
+	}
+	property(t, func(ht *hegel.T) {
+		m := genMap(ht)
+		k := pick(ht, []string{"a", "b", "c", "d"})
+		_, has := m[k]
+		c.count("key=" + strconv.FormatBool(has))
+		name := fmt.Sprintf("(%v, %q)", m, k)
+		if !expect(c, ht, "Contains"+name, has, func(t assert.TestingT) bool { return assert.Contains(t, m, k) }) {
+			return
+		}
+		if !expect(c, ht, "NotContains"+name, !has, func(t assert.TestingT) bool { return assert.NotContains(t, m, k) }) {
+			return
+		}
+		// map/map subset: every pair of sub is in m
+		sub := genMap(ht)
+		if chance(ht, 40) {
+			sub = map[string]int{}
+			for kk, v := range m {
+				if chance(ht, 60) {
+					sub[kk] = v
+				}
+			}
+		}
+		wantS := true
+		for kk, v := range sub {
+			if w, ok := m[kk]; !ok || w != v {
+				wantS = false
+			}
+		}
+		sn := fmt.Sprintf("(%v, %v)", m, sub)
+		c.count("mapsubset=" + strconv.FormatBool(wantS))
+		if !expect(c, ht, "Subset"+sn, wantS, func(t assert.TestingT) bool { return assert.Subset(t, m, sub) }) {
+			return
+		}
+		if !expect(c, ht, "NotSubset"+sn, !wantS, func(t assert.TestingT) bool { return assert.NotSubset(t, m, sub) }) {
+			return
+		}
+		// map/list: keys
+		var ks []string
+		for _, kk := range keys {
+			if chance(ht, 40) {
+				ks = append(ks, kk)
+			}
+		}
+		wantK := true
+		for _, kk := range ks {
+			if _, ok := m[kk]; !ok {
+				wantK = false
+			}
+		}
+		kn := fmt.Sprintf("(%v, %v)", m, ks)
+		if !expect(c, ht, "Subset(map,list)"+kn, wantK, func(t assert.TestingT) bool { return assert.Subset(t, m, ks) }) {
+			return
+		}
+		// list/map: the map's keys must be in the list
+		var mk []string
+		for kk := range m {
+			mk = append(mk, kk)
+		}
+		wantL := true
+		for kk := range sub {
+			if !containsStr(mk, kk) {
+				wantL = false
+			}
+		}
+		if !expect(c, ht, fmt.Sprintf("Subset(list,map)(%v, %v)", mk, sub), wantL, func(t assert.TestingT) bool { return assert.Subset(t, mk, sub) }) {
+			return
+		}
+		// strings
+		s := pick(ht, []string{"", "ab", "abc", "hello world", "aXb"})
+		needle := pick(ht, []string{"", "a", "b", "X", "world", "lo w", "abcd"})
+		wantStr := strings.Contains(s, needle)
+		c.count("substr=" + strconv.FormatBool(wantStr))
+		if !expect(c, ht, fmt.Sprintf("Contains(%q, %q)", s, needle), wantStr, func(t assert.TestingT) bool { return assert.Contains(t, s, needle) }) {
+			return
+		}
+		expect(c, ht, fmt.Sprintf("NotContains(%q, %q)", s, needle), !wantStr, func(t assert.TestingT) bool { return assert.NotContains(t, s, needle) })
+	})
+}
+
+func containsStr(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
diff --git a/assert/hegel_compare_test.go b/assert/hegel_compare_test.go
new file mode 100644
