+// nilCase: two arguments, one or both of them nil (the shape of testify/7; neither under
+// HEGEL_NO_KNOWN=1), and which of the collection assertions is called.
+type nilCase struct {
+	a, b any
+	pick int
+}
+
+func (c nilCase) GoString() string {
+	as := c.assertions()
+	return fmt.Sprintf("%s on %T %#v, %T %#v", as[c.pick%len(as)].name, c.a, c.a, c.b, c.b)
