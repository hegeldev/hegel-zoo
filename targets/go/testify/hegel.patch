+		a := cs.value()
+		shape := shapeIf(hasNilLeaf(a), "testify/13")
+		b := a
+		b.u = 1 - a.u
+		c.count("where=" + strconv.Itoa(cs.where))
+		if !expect(c, ht, fmt.Sprintf("EqualExportedValues(%+v, unexported changed)", a), true, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, a, b) }, shape...) {
+			return
+		}
+		if cs.where == 0 {
+			// the map without its nil entry is another exported value
+			b.M = map[string]any{"b": 1}
+			if !expect(c, ht, fmt.Sprintf("EqualExportedValues(%+v, %+v)", a, b), false, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, a, b) }, shape...) {
+				return
+			}
+		}
+		want := reflect.DeepEqual(exported(a), exported(cs.other))
+		expect(c, ht, fmt.Sprintf("EqualExportedValues(%+v, %+v)", a, cs.other), want, func(t assert.TestingT) bool { return assert.EqualExportedValues(t, a, cs.other) }, shape...)
+	})
+}
+
+// --------------------------------------------------------------------------- testify/14
+
+// bigIntCase: an integer document beyond 2^53 (the shape of testify/14: a float64 cannot tell
+// it from its neighbour; a small one under HEGEL_NO_KNOWN=1), in a container or bare, and the
+// tapes of its serialisations.
+type bigIntCase struct {
+	n      any
+	wrap   int
+	t1, t2 []int
+}
+
+func (c bigIntCase) doc() any {
