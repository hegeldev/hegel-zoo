+	if sameType || !Known.compareConvertPanic {
+		convertShape := shapeIf(!sameType && a != nil && b != nil && reflect.TypeOf(a).Kind() == reflect.TypeOf(b).Kind() &&
+			(reflect.TypeOf(a).Kind() == reflect.Slice || reflect.TypeOf(a).Kind() == reflect.Struct), "testify/12")
+		out = append(out,
+			namedAssertion{"Greater", func(t assert.TestingT, m ...any) bool { return assert.Greater(t, a, b, m...) }, convertShape},
+			namedAssertion{"LessOrEqual", func(t assert.TestingT, m ...any) bool { return assert.LessOrEqual(t, a, b, m...) }, convertShape})
