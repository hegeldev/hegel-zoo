+	})
+)
+
+// TestHegelOrderingFailsOnMixedStructAndSliceTypes: Greater & co on two values of different
+// types fail; testify/12 panics converting a struct or slice to the other struct or slice type.
+func TestHegelOrderingFailsOnMixedStructAndSliceTypes(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, mixedKindCases)
+		a, b := cs.a, cs.b
+		shape := shapeIf(reflect.TypeOf(a).Kind() == reflect.TypeOf(b).Kind(), "testify/12")
+		c.count(fmt.Sprintf("%T/%T", a, b))
+		name := fmt.Sprintf("(%T %v, %T %v)", a, a, b, b)
+		for _, f := range []struct {
+			n string
+			f func(t assert.TestingT) bool
+		}{
+			{"Greater", func(t assert.TestingT) bool { return assert.Greater(t, a, b) }},
+			{"GreaterOrEqual", func(t assert.TestingT) bool { return assert.GreaterOrEqual(t, a, b) }},
+			{"Less", func(t assert.TestingT) bool { return assert.Less(t, a, b) }},
+			{"LessOrEqual", func(t assert.TestingT) bool { return assert.LessOrEqual(t, a, b) }},
+			{"Greater(b,a)", func(t assert.TestingT) bool { return assert.Greater(t, b, a) }},
+		} {
