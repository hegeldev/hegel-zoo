+var lineLengthCases = hegel.FlatMap(hegel.Integers(2, 4), func(maxLen int) hegel.Generator[lineLengthCase] {
+	var wide []rune
+	for _, r := range "\u00e9\u65e5\U0001f600" {
+		if utf8.RuneLen(r) >= maxLen {
+			wide = append(wide, r)
+		}
+	}
+	// Kept to a handful of choices: every case in this shape is a hung child process that
+	// costs the deadline, and the shrinker tries each of them.
+	return hegel.Composite(func(tc hegel.TestCase) lineLengthCase {
+		return lineLengthCase{
+			maxLen: maxLen,
+			text:   hegel.Draw(tc, hegel.Text().Alphabet("a").MaxSize(1)) + string(wide[hegel.Draw(tc, hegel.Integers(0, len(wide)-1))]),
+		}
