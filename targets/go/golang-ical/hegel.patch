@@ -0,0 +1,223 @@
+package ics_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	ics "github.com/arran4/golang-ical"
+)
+
+// golang-ical/1: ComponentPropertyExtended prefixes a name with X-.
+func TestHegelPinExtendedPropertyName(t *testing.T) {
+	if got := ics.ComponentPropertyExtended("FOO"); got != "X-FOO" {
+		t.Fatalf("ComponentPropertyExtended(\"FOO\") = %q, want \"X-FOO\"", got)
+	}
+	if got := ics.ComponentPropertyExtended("X-FOO"); got != "X-FOO" {
+		t.Fatalf("ComponentPropertyExtended(\"X-FOO\") = %q, want \"X-FOO\"", got)
+	}
+}
+
+// golang-ical/2: RemovePropertyByValue removes the matching properties and nothing else.
+func TestHegelPinRemovePropertyByValue(t *testing.T) {
+	e := ics.NewEvent("u")
+	e.AddAttendee("a@x")
+	e.AddAttendee("b@x")
+	e.SetSummary("s")
+	removed := e.RemovePropertyByValue(ics.ComponentPropertyAttendee, "mailto:a@x")
+	if len(removed) != 1 || removed[0].Value != "mailto:a@x" {
+		t.Fatalf("removed %d properties %v, want the one attendee a@x", len(removed), removed)
+	}
+	var kept []string
+	for _, p := range e.Properties {
+		kept = append(kept, p.IANAToken+":"+p.Value)
+	}
+	want := []string{"UID:u", "ATTENDEE:mailto:b@x", "SUMMARY:s"}
+	if strings.Join(kept, " ") != strings.Join(want, " ") {
+		t.Fatalf("kept %q, want %q", kept, want)
+	}
+}
+
+// golang-ical/3: Id() is the identifier the component was created with.
+func TestHegelPinIdIsNotUnescapedTwice(t *testing.T) {
+	id := `a\,b`
+	if got := ics.NewEvent(id).Id(); got != id {
+		t.Fatalf("NewEvent(%q).Id() = %q", id, got)
+	}
+	cal := ics.NewCalendar()
+	cal.AddEvent(id)
+	back, err := ics.ParseCalendar(strings.NewReader(cal.Serialize()))
+	if err != nil {
+		t.Fatalf("ParseCalendar: %v", err)
+	}
+	if got := back.Events()[0].Id(); got != id {
+		t.Fatalf("after a round trip, Id() = %q, want %q", got, id)
+	}
+}
+
+// golang-ical/4: parameter values with : ; or , are quoted, an apostrophe is written as is
+// (RFC 5545 3.2: no escaping in parameter values).
+func TestHegelPinParameterValuesAreQuoted(t *testing.T) {
+	e := ics.NewEvent("u")
+	e.SetOrganizer("o@x", ics.WithCN("O'Brien"))
+	e.SetSummary("s", &ics.KeyValues{Key: "X-A", Value: []string{"a:b;c,d"}})
+	cal := ics.NewCalendar()
+	cal.AddVEvent(e)
+	out := cal.Serialize()
+	if !strings.Contains(out, "CN=O'Brien:") {
+		t.Fatalf("CN=O'Brien is written as %q", between(out, "ORGANIZER;", "\n"))
+	}
+	if !strings.Contains(out, `X-A="a:b;c,d":`) {
+		t.Fatalf("X-A=a:b;c,d is written as %q, want it quoted", between(out, "SUMMARY;", "\n"))
+	}
+}
+
+func between(s, a, b string) string {
+	i := strings.Index(s, a)
+	if i < 0 {
+		return ""
+	}
+	s = s[i:]
+	if j := strings.Index(s, b); j >= 0 {
+		return s[:j]
+	}
+	return s
+}
+
+// golang-ical/5: a backslash in a quoted parameter value is a character of the value.
+func TestHegelPinBackslashInQuotedParameter(t *testing.T) {
+	p, err := ics.ParseProperty(ics.ContentLine(`ORGANIZER;CN="C:\dir":mailto:o`))
+	if err != nil {
+		t.Fatalf("ParseProperty: %v", err)
+	}
+	if got := p.ICalParameters["CN"]; len(got) != 1 || got[0] != `C:\dir` {
+		t.Fatalf("CN = %q, want [C:\\dir]", got)
+	}
+}
+
+// golang-ical/6: CATEGORIES with two values stays two values across parse and serialize.
+func TestHegelPinCategoriesKeepTheirCommas(t *testing.T) {
+	in := "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:u\r\nCATEGORIES:a,b\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
+	cal, err := ics.ParseCalendar(strings.NewReader(in))
+	if err != nil {
+		t.Fatalf("ParseCalendar: %v", err)
+	}
+	out := cal.Serialize()
+	if !strings.Contains(out, "CATEGORIES:a,b\n") {
+		t.Fatalf("CATEGORIES:a,b is re-serialized as %q", between(out, "CATEGORIES", "\n"))
+	}
+}
+
+// golang-ical/7: Serialize terminates for every line length.
+func TestHegelPinSerializeTerminates(t *testing.T) {
+	// Run in a child process with a capped address space (hegel_shapes_test.go): the
+	// Serialize that never returns cannot be stopped in-process and grows without bound.
+	if serializeChild() {
+		return
+	}
+	out, err := serializeInChild(t.Name(), lineLengthCase{maxLen: 2, text: "\u65e5\u672c"}, time.Second)
+	if errors.Is(err, context.DeadlineExceeded) || strings.Contains(out, "out of memory") {
+		t.Fatalf("Serialize(WithLineLength(2)) of a description with multi-octet characters does not return")
+	}
+	if err != nil {
+		t.Fatalf("the child Serialize failed: %v\n%s", err, out)
+	}
+}
+
+// golang-ical/8: names are case-insensitive (RFC 5545 3.1).
+func TestHegelPinNamesAreCaseInsensitive(t *testing.T) {
+	in := "begin:vcalendar\r\nversion:2.0\r\nbegin:vevent\r\nuid:u\r\nsummary:x\r\nend:vevent\r\nend:vcalendar\r\n"
+	cal, err := ics.ParseCalendar(strings.NewReader(in))
+	if err != nil {
+		t.Fatalf("ParseCalendar of a lower-case calendar: %v", err)
+	}
+	if len(cal.Events()) != 1 {
+		t.Fatalf("begin:vevent is not read as an event: %T", cal.Components[0])
+	}
+	if p := cal.Events()[0].GetProperty(ics.ComponentPropertySummary); p == nil || p.Value != "x" {
+		t.Fatalf("summary:x is not found as SUMMARY")
+	}
+	if _, err := ics.ParseRecurrenceRule("freq=daily;byday=mo"); err != nil {
+		t.Fatalf("ParseRecurrenceRule(\"freq=daily;byday=mo\"): %v", err)
+	}
+}
+
+// golang-ical/9: the line number of a malformed line is its physical line.
+func TestHegelPinErrorLineNumbers(t *testing.T) {
+	in := "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nDESCRIPTION:aaa\r\n bbb\r\n ccc\r\n\r\n\r\nBEGIN:VEVENT\r\nUID:u\r\nX-BAD;=:v\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
+	_, err := ics.ParseCalendar(strings.NewReader(in))
+	var me *ics.MalformedError
+	if !errors.As(err, &me) {
+		t.Fatalf("got %v, want a MalformedError", err)
+	}
+	if me.Line != 10 {
+		t.Fatalf("the malformed property is on physical line 10, the error says line %d", me.Line)
+	}
+}
+
+// golang-ical/10: SetRefreshInterval on a parsed calendar replaces the REFRESH-INTERVAL.
+func TestHegelPinRefreshIntervalRoundTrip(t *testing.T) {
+	cal := ics.NewCalendar()
+	cal.SetRefreshInterval("PT1H")
+	back, err := ics.ParseCalendar(strings.NewReader(cal.Serialize()))
+	if err != nil {
+		t.Fatalf("ParseCalendar: %v", err)
+	}
+	before := len(back.CalendarProperties)
+	back.SetRefreshInterval("PT2H")
+	if len(back.CalendarProperties) != before {
+		t.Fatalf("SetRefreshInterval added a property: %d, was %d", len(back.CalendarProperties), before)
+	}
+	if !strings.Contains(back.Serialize(), "REFRESH-INTERVAL;VALUE=DURATION:PT2H\n") {
+		t.Fatalf("REFRESH-INTERVAL not replaced: %q", back.Serialize())
+	}
+}
+
+// golang-ical/11: VTodo.SetDuration on an all-day start gives an all-day DUE.
+func TestHegelPinTodoDurationAllDay(t *testing.T) {
+	td := ics.NewTodo("u")
+	td.SetAllDayStartAt(time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC))
+	if err := td.SetDuration(24 * time.Hour); err != nil {
+		t.Fatalf("SetDuration: %v", err)
+	}
+	due := td.GetProperty(ics.ComponentPropertyDue)
+	if due == nil || due.Value != "20240102" || len(due.ICalParameters["VALUE"]) != 1 || due.ICalParameters["VALUE"][0] != "DATE" {
+		t.Fatalf("DUE = %v, want DUE;VALUE=DATE:20240102 (as VEvent.SetDuration gives)", due)
+	}
+}
+
+// golang-ical/12: String() keeps a floating UNTIL floating.
+func TestHegelPinFloatingUntilStaysFloating(t *testing.T) {
+	r, err := ics.ParseRecurrenceRule("FREQ=DAILY;UNTIL=20240101T120000")
+	if err != nil {
+		t.Fatalf("ParseRecurrenceRule: %v", err)
+	}
+	if got := r.String(); got != "FREQ=DAILY;UNTIL=20240101T120000" {
+		t.Fatalf("String() = %q", got)
+	}
+}
+
+// golang-ical/13: values outside the RFC 5545 ranges are rejected.
+func TestHegelPinRecurrenceRangesAreChecked(t *testing.T) {
+	for _, s := range []string{"FREQ=DAILY;INTERVAL=0", "FREQ=DAILY;COUNT=-1", "FREQ=DAILY;BYHOUR=25", "FREQ=YEARLY;BYMONTH=13", "FREQ=DAILY;BYSECOND=61"} {
+		if r, err := ics.ParseRecurrenceRule(s); err == nil {
+			t.Fatalf("ParseRecurrenceRule(%q) accepts it: %q", s, r.String())
+		}
+	}
+}
+
+// golang-ical/14: a content line must start with the property name and a parameter name is a
+// token.
+func TestHegelPinNamesAreAnchored(t *testing.T) {
+	if p, err := ics.ParseProperty(ics.ContentLine("###SUMMARY:x")); err == nil {
+		t.Fatalf("ParseProperty(\"###SUMMARY:x\") accepts it as %v", p)
+	}
+	if p, err := ics.ParseProperty(ics.ContentLine("SUMMARY;=A=1:x")); err == nil {
+		t.Fatalf("ParseProperty(\"SUMMARY;=A=1:x\") accepts it as %v", p)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..fda9916
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,942 @@
+package ics_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the oracle of the wide property that found it (the model, the RFC
+// 5545 grammar, icalendar), so that each bug has a property that finds it every run and
+// shrinks to a minimal example of it; the wide properties in hegel_test.go and
+// hegel_api_test.go reach the shapes at their natural rate. Shapes the harness writer cannot
+// draw (a raw CATEGORIES list, a backslash in a quoted parameter, junk before a name, a line
+// length of 2) are built here directly. Under HEGEL_NO_KNOWN=1 every property here is skipped
+// as a known shape off: its whole domain is the bug's shape (an Assume on every case would
+// trip the filter-too-much health check).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	ics "github.com/arran4/golang-ical"
+)
+
+// shapeOff skips a narrow property under HEGEL_NO_KNOWN=1 (noKnown, hegel_test.go).
+func shapeOff(t *testing.T, id string) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("the shape of %s is off under HEGEL_NO_KNOWN=1", id)
+	}
+}
+
+// --------------------------------------------------------------------------- shared pieces
+
+const tokenChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
+
+// tokens: an iana-token of one to eight characters (RFC 5545 3.1).
+var tokens = hegel.Text().Alphabet(tokenChars).MinSize(1).MaxSize(8)
+
+var (
+	// plainProps: a property of any name with parameters of safe characters.
+	plainProps = propertiesOf(genOpts{}, typedNames)
+	// calendarProps: the same for the calendar level (never DTSTART, DTEND or DUE).
+	calendarProps = propertiesOf(genOpts{}, without(typedNames, "DTSTART", "DTEND", "DUE"))
+	// positions: an index taken modulo a live length.
+	positions = hegel.Integers(0, 99)
+)
+
+// oneEventCalendar is a model calendar of VERSION, PRODID and one event of the properties.
+func oneEventCalendar(prodid string, props ...mprop) *mcomp {
+	return &mcomp{
+		name:  "VCALENDAR",
+		props: []mprop{{name: "VERSION", value: "2.0"}, {name: "PRODID", value: prodid}},
+		kids:  []*mcomp{{name: "VEVENT", props: props}},
+	}
+}
+
+// unfolded is the text with its folds removed (RFC 5545 3.1).
+func unfolded(text string) string {
+	return strings.NewReplacer("\r\n ", "", "\r\n\t", "", "\n ", "", "\n\t", "").Replace(text)
+}
+
+// lineWith is the first unfolded content line of text that starts with prefix, "" for none.
+func lineWith(text, prefix string) string {
+	for _, l := range strings.Split(unfolded(text), "\n") {
+		l = strings.TrimSuffix(l, "\r")
+		if strings.HasPrefix(l, prefix) {
+			return l
+		}
+	}
+	return ""
+}
+
+// paramText is the raw text of the parameter key in an unfolded content line, up to the next
+// ; or : outside double quotes; "" when the line has no such parameter.
+func paramText(line, key string) string {
+	i := strings.Index(line, ";"+key+"=")
+	if i < 0 {
+		return ""
+	}
+	rest := line[i+len(key)+2:]
+	quoted := false
+	for j := 0; j < len(rest); j++ {
+		switch rest[j] {
+		case '"':
+			quoted = !quoted
+		case ';', ':':
+			if !quoted {
+				return rest[:j]
+			}
+		}
+	}
+	return rest
+}
+
+// withoutParam is the parameter list less the key.
+func withoutParam(ps []mparam, key string) []mparam {
+	var out []mparam
+	for _, p := range ps {
+		if p.key != key {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// sameProps compares two property lists (an empty list and a nil one are equal).
+func sameProps(a, b []mprop) bool {
+	return (len(a) == 0 && len(b) == 0) || reflect.DeepEqual(a, b)
+}
+
+// --------------------------------------------------------------------------- golang-ical/1
+
+// extendedNames: a token, once in two already in its X- form.
+var extendedNames = cat(hegel.SampledFrom([]string{"", "X-"}), tokens)
+
+// TestHegelExtendedPropertyNameKeepsTheName: ComponentPropertyExtended(s) is the X- form of
+// the name s (s itself when it already has the prefix); the library returns "X-X-" for every
+// name (golang-ical/1).
+func TestHegelExtendedPropertyNameKeepsTheName(t *testing.T) {
+	shapeOff(t, "golang-ical/1")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		name := hegel.Draw(ht, extendedNames)
+		want := "X-" + strings.TrimPrefix(name, "X-")
+		if got := string(ics.ComponentPropertyExtended(name)); got != want {
+			c.mismatch(ht, "golang-ical/1", "ComponentPropertyExtended(%q) = %q, want %q", name, got, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-ical/2
+
+// addEdits: the edits of the property API that only add (AddProperty of a name and value from
+// the pools, with or without a CN parameter).
+var addEdits = hegel.Map(edits, func(e edit) edit { e.op = "AddProperty"; return e })
+
+// removeByValueCase: up to six properties added to a fresh event, then one
+// RemovePropertyByValue of a name and value from the same pools.
+type removeByValueCase struct {
+	adds  []edit
+	name  string
+	value string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c removeByValueCase) GoString() string {
+	return editCase{c.adds}.GoString() + fmt.Sprintf("RemovePropertyByValue %s=%q\n", c.name, c.value)
+}
+
+var removeByValueCases = hegel.Composite(func(tc hegel.TestCase) removeByValueCase {
+	return removeByValueCase{
+		adds:  hegel.Draw(tc, many(addEdits, 0, 6)),
+		name:  hegel.Draw(tc, hegel.SampledFrom(editNames)),
+		value: hegel.Draw(tc, hegel.SampledFrom(editValues)),
+	}
+})
+
+// TestHegelRemovePropertyByValueRemovesOnlyTheMatches: RemovePropertyByValue(name, value)
+// returns the properties of that name and value and leaves the rest, in order (the model of
+// TestHegelPropertyEditsFollowTheModel); the library removes every other property and keeps
+// the matches (golang-ical/2).
+func TestHegelRemovePropertyByValueRemovesOnlyTheMatches(t *testing.T) {
+	shapeOff(t, "golang-ical/2")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, removeByValueCases)
+		ev := ics.NewEvent("u")
+		model := []mprop{{name: "UID", value: "u"}}
+		for _, e := range rc.adds {
+			var params []ics.PropertyParameter
+			var mps []mparam
+			if e.cn {
+				params = []ics.PropertyParameter{ics.WithCN("x")}
+				mps = []mparam{{"CN", []string{"x"}}}
+			}
+			ev.AddProperty(ics.ComponentProperty(e.name), e.value, params...)
+			model = append(model, mprop{name: e.name, value: e.value, params: mps})
+		}
+		removed := ev.RemovePropertyByValue(ics.ComponentProperty(rc.name), rc.value)
+		kept, gone := partition(model, func(p mprop) bool { return p.name == rc.name && p.value == rc.value })
+		if !sameRemoved(removed, gone) {
+			c.mismatch(ht, "golang-ical/2", "RemovePropertyByValue(%s, %q) removed %v, want %v", rc.name, rc.value, propsOf(removed), gone)
+			return
+		}
+		if got := propsOf(ev.Properties); !sameProps(got, kept) {
+			c.mismatch(ht, "golang-ical/2", "after RemovePropertyByValue(%s, %q):\n got  %v\n want %v", rc.name, rc.value, got, kept)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-ical/3
+
+// textEscapes: the escape sequences FromText reads (RFC 5545 3.3.11), as characters of a
+// logical value.
+var textEscapes = hegel.SampledFrom([]string{`\,`, `\;`, `\\`, `\n`, `\N`})
+
+// escapedUids: a UID with one escape sequence spliced in at a drawn position, so that its
+// logical text differs from its unescaped reading.
+var escapedUids = hegel.Composite(func(tc hegel.TestCase) string {
+	rs := []rune(hegel.Draw(tc, pieceTexts))
+	at := hegel.Draw(tc, positions) % (len(rs) + 1)
+	return string(rs[:at]) + hegel.Draw(tc, textEscapes) + string(rs[at:])
+})
+
+// TestHegelIdIsTheUid: Id() is the identifier the component was created with, before and
+// after a serialize/parse round trip (the Value field holds the logical text, GetProperty
+// agrees); the library unescapes the stored UID a second time (golang-ical/3).
+func TestHegelIdIsTheUid(t *testing.T) {
+	shapeOff(t, "golang-ical/3")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		uid := hegel.Draw(ht, escapedUids)
+		if got := ics.NewEvent(uid).Id(); got != uid {
+			c.mismatch(ht, "golang-ical/3", "NewEvent(%q).Id() = %q", uid, got)
+			return
+		}
+		cal := build(oneEventCalendar("p", mprop{name: "UID", value: uid}))
+		back, err := ics.ParseCalendar(strings.NewReader(cal.Serialize()))
+		if err != nil {
+			ht.Fatalf("ParseCalendar of the serialization: %v", err)
+		}
+		ev := back.Events()[0]
+		if p := ev.GetProperty(ics.ComponentPropertyUniqueId); p == nil || p.Value != uid {
+			c.fail(ht, "after a round trip, GetProperty(UID) = %v, want %q", p, uid)
+			return
+		}
+		if got := ev.Id(); got != uid {
+			c.mismatch(ht, "golang-ical/3", "after a round trip, Id() = %q, want %q", got, uid)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-ical/4
+
+// escapedParamChars: the characters golang-ical backslash-escapes in a parameter value; RFC
+// 5545 3.2 writes a value with : ; or , in double quotes and ' and \ as they are (" cannot
+// appear in a parameter value at all and is left to the wide properties).
+var escapedParamChars = hegel.SampledFrom([]string{",", ";", ":", "'", `\`})
+
+// quotedParamCase: a property with a parameter (never ALTREP, which the library does quote)
+// whose one value holds one of the characters between safe pieces.
+type quotedParamCase struct {
+	p   mprop
+	key string
+}
+
+// value is the parameter's value.
+func (c quotedParamCase) value() string {
+	for _, pa := range c.p.params {
+		if pa.key == c.key {
+			return pa.vals[0]
+		}
+	}
+	return ""
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c quotedParamCase) GoString() string {
+	return fmt.Sprintf("%s=%q on %s", c.key, c.value(), describe(&mcomp{name: "VEVENT", props: []mprop{c.p}}, ""))
+}
+
+var quotedParamCases = func() hegel.Generator[quotedParamCase] {
+	safe := joined(hegel.Lists(hegel.SampledFrom(paramSafe)).MaxSize(2))
+	keys := hegel.SampledFrom(without(paramKeys, "ALTREP"))
+	return hegel.Composite(func(tc hegel.TestCase) quotedParamCase {
+		p := hegel.Draw(tc, plainProps)
+		key := hegel.Draw(tc, keys)
+		v := hegel.Draw(tc, safe) + hegel.Draw(tc, escapedParamChars) + hegel.Draw(tc, safe)
+		p.params = sortParams(append(withoutParam(p.params, key), mparam{key, []string{v}}))
+		return quotedParamCase{p: p, key: key}
+	})
+}()
+
+// TestHegelParameterValuesAreQuotedNotEscaped: a parameter value with : ; or , is written as a
+// quoted-string and one with ' or \ as it is or quoted (RFC 5545 3.2 has no escaping in
+// parameter values), and icalendar reads the serialization as the model; the library writes a
+// backslash before each of them, which icalendar rejects (\') or misreads (\:)
+// (golang-ical/4).
+func TestHegelParameterValuesAreQuotedNotEscaped(t *testing.T) {
+	shapeOff(t, "golang-ical/4")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		q := hegel.Draw(ht, quotedParamCases)
+		m := oneEventCalendar("p", mprop{name: "UID", value: "u"}, q.p)
+		text := build(m).Serialize(ics.WithNewLine("\r\n"))
+		v := q.value()
+		line := lineWith(text, q.p.name+";")
+		if raw := paramText(line, q.key); raw != v && raw != `"`+v+`"` {
+			want := "as it is"
+			if needsQuote(v) {
+				want = "quoted"
+			}
+			c.mismatch(ht, "golang-ical/4", "%s=%q is written as %s=%s, want it %s\n%q", q.key, v, q.key, raw, want, line)
+			return
+		}
+		lines, perr := pyLines(ht, text)
+		if perr != "" {
+			c.mismatch(ht, "golang-ical/4", "icalendar rejects the serialization: %s\n%q", perr, text)
+			return
+		}
+		got, err := treeOfLines(lines)
+		if err != nil {
+			c.mismatch(ht, "golang-ical/4", "icalendar's lines do not form the tree: %v\n%q", err, text)
+			return
+		}
+		if d := diffModel(m, got, ""); d != "" {
+			c.mismatch(ht, "golang-ical/4", "icalendar reads: %s\n%q", d, text)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-ical/5
+
+// quotedBackslashCase: a content line with a quoted parameter value holding a backslash
+// before an ordinary character (not one of \ , ; n N, which the library reads as TEXT escapes,
+// a convention icalendar shares) between safe pieces.
+type quotedBackslashCase struct {
+	name  string
+	key   string
+	pval  string
+	value string
+}
+
+func (c quotedBackslashCase) text() string {
+	return c.name + ";" + c.key + `="` + c.pval + `":` + escapeText(c.value)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c quotedBackslashCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+var quotedBackslashCases = func() hegel.Generator[quotedBackslashCase] {
+	safe := joined(hegel.Lists(hegel.SampledFrom(paramSafe)).MaxSize(2))
+	backslashes := cat(hegel.Just(`\`), hegel.Text().Alphabet("abcdxyzABC0189 ._/-:").MinSize(1).MaxSize(1))
+	return hegel.Composite(func(tc hegel.TestCase) quotedBackslashCase {
+		return quotedBackslashCase{
+			name:  hegel.Draw(tc, hegel.SampledFrom(textNames)),
+			key:   hegel.Draw(tc, hegel.SampledFrom(paramKeys)),
