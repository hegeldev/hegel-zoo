+// plainRule is the rule with the other recorded shapes taken out: names in upper case, COUNT
+// and INTERVAL positive, the BY lists within their ranges (a value out of range becomes the
+// lower bound), no floating UNTIL. A fix-up rather than a filter, so the shrinker keeps every
+// other part.
+func plainRule(r mrule) mrule {
+	r.lower = false
+	if r.count != nil && *r.count <= 0 {
+		r.count = ptrTo(1)
+	}
+	if r.interval != nil && *r.interval <= 0 {
+		r.interval = ptrTo(1)
+	}
+	lists := map[string][]int{}
+	for key, vals := range r.lists {
+		out := make([]int, len(vals))
+		for i, v := range vals {
+			if !inRange(key, v) {
+				v = listRanges[key][0]
+			}
+			out[i] = v
+		}
+		lists[key] = out
+	}
+	r.lists = lists
+	if r.floating() {
+		r.until = ""
+	}
+	return r
+}
+
+// floatingUntils: a floating (local) DATE-TIME UNTIL value.
+var floatingUntils = hegel.Map(mtimesOf["local"], func(t mtime) string { return t.value() })
