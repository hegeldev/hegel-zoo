new file mode 100644
index 0000000..990c288
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1260 @@
+package ics_test
+
+// Hegel property tests for arran4/golang-ical, written for the Hegel zoo.
+// See targets/go/golang-ical/README.md.
+//
+// Oracles: a model calendar (nested components, properties with parameters and TEXT or typed
+// values) built through the API and serialized, or written by the harness in RFC 5545 syntax
+// (folding at arbitrary octets, quoted parameters, either line ending); the RFC's content-line
+// grammar, escaping and folding rules and the documented semantics of the property API,
+// recurrence rules and time getters, evaluated on the model; and icalendar (Python) as an
+// independent content-line parser, RRULE parser and date-time parser.
+//
+// Every property draws one case record built from the binding's combinators: the model
+// calendar is a tree of components (each drawing its children from the generators of the
+// names it may hold), its properties records of a name, a value and parameters, the harness
+// writer's choices a record of options and a tape of small integers it reads in order; a
+// recurrence rule, a time value and a list of edits are records too. Pure functions render
+// the records: the API builder, the RFC 5545 writer, the RRULE text.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and the properties that
+// meet them fail, naming the shape (mismatch); the pins in hegel_pins_test.go are the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a
+// run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	ics "github.com/arran4/golang-ical"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bug shape names ("" for none): the failure names the shape, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func (c *collector) mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if shape != "" {
+		if noKnown {
+			c.count("known-" + shape)
+			ht.Assume(false)
+		}
+		format += " (the shape of " + shape + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape; under HEGEL_NO_KNOWN=1 the switches of Known are on and the shapes are left out of
+// the generators (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known: the recorded bugs whose shapes the wide properties draw. A switch is on only under
+// HEGEL_NO_KNOWN=1, and then the generator leaves the shape out; the pins assert the correct
+// behaviour and fail while the bug exists. The other recorded bugs (golang-ical/1, /3, /5,
+// /6, /7, /9, /10, /11, /14) are not observable through the wide properties' oracles (the
+// trees compare unescaped values, the writer never puts a backslash in a parameter value, line
+// lengths start at 16); hegel_shapes_test.go has a narrow property per recorded bug, drawing
+// the bug's shape alone.
+var Known = struct {
+	// golang-ical/2: RemovePropertyByValue and RemovePropertyByFunc remove every property that
+	// is not selected and keep none of the selected ones (inverted condition).
+	removeByValueInverted bool
+	// golang-ical/4: parameter values containing : ; , " ' or \ are written with backslash
+	// escapes instead of being quoted (RFC 5545 3.2); icalendar rejects the \' form and
+	// misreads \: (it reads \, and \; as the de-facto escapes).
+	paramValuesEscaped bool
+	// golang-ical/8: component names, property names and RRULE parts are matched
+	// case-sensitively (RFC 5545 3.1 makes them case-insensitive).
+	caseSensitiveNames bool
+	// golang-ical/12: RecurrenceRule.String appends Z to a floating (local) UNTIL.
+	floatingUntilGetsZ bool
+	// golang-ical/13: ParseRecurrenceRule accepts out-of-range values (INTERVAL=0, COUNT=-1,
+	// BYHOUR=25, BYMONTH=13 ...).
+	recurRangesUnchecked bool
+}{
+	removeByValueInverted: noKnown,
+	paramValuesEscaped:    noKnown,
+	caseSensitiveNames:    noKnown,
+	floatingUntilGetsZ:    noKnown,
+	recurRangesUnchecked:  noKnown,
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// cat draws one string from each generator and joins them: the pieces of a token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// dec is the decimal text of an integer generator.
+func dec(g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, strconv.Itoa)
+}
+
+// joined is the concatenation of the strings of a list generator.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// without is the list less the values.
+func without(xs []string, drop ...string) []string {
+	var out []string
+	for _, x := range xs {
+		keep := true
+		for _, d := range drop {
+			keep = keep && x != d
+		}
+		if keep {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// tape is a drawn list of small integers that a pure writer consumes in order, recycled
+// modulo its length, for the choices the writer leaves free (where to cut a folded line,
+// whether to put a blank line before a line). An empty tape answers 0 to every question, so
+// the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// lowercases: names written in lower case once in twenty, the shape of golang-ical/8; never
+// under HEGEL_NO_KNOWN=1.
+var lowercases = func() hegel.Generator[bool] {
+	if Known.caseSensitiveNames {
+		return hegel.Just(false)
+	}
+	return chance(5)
+}()
+
+// --------------------------------------------------------------------------- model
+
+type mparam struct {
+	key  string
+	vals []string
+}
+
+type mprop struct {
+	name   string
+	params []mparam // sorted by key, keys unique
+	value  string   // the logical (unescaped) value
+}
+
+type mcomp struct {
+	name  string
+	props []mprop
+	kids  []*mcomp
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (m *mcomp) GoString() string { return describe(m, "") }
+
+// nonText: properties whose default value type is not TEXT (RFC 5545 3.8, as golang-ical's
+// GetValueType lists them); every other property, X- and unknown ones included, is TEXT.
+var nonText = map[string]bool{
+	"ATTACH": true, "TZURL": true, "URL": true, "SOURCE": true, "GEO": true,
+	"PERCENT-COMPLETE": true, "PRIORITY": true, "REPEAT": true, "SEQUENCE": true,
+	"COMPLETED": true, "DTEND": true, "DUE": true, "DTSTART": true, "RECURRENCE-ID": true,
+	"EXDATE": true, "RDATE": true, "CREATED": true, "DTSTAMP": true, "LAST-MODIFIED": true,
+	"DURATION": true, "TRIGGER": true, "FREEBUSY": true, "TZOFFSETFROM": true, "TZOFFSETTO": true,
+	"ATTENDEE": true, "ORGANIZER": true, "RRULE": true,
+}
+
+func isText(p mprop) bool {
+	for _, pa := range p.params {
+		if pa.key == "VALUE" && len(pa.vals) == 1 {
+			return pa.vals[0] == "TEXT"
+		}
+	}
+	return !nonText[p.name]
+}
+
+// escapeText: RFC 5545 3.3.11.
+func escapeText(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case ';':
+			b.WriteString(`\;`)
+		case ',':
+			b.WriteString(`\,`)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func sortParams(ps []mparam) []mparam {
+	if len(ps) == 0 {
+		return nil
+	}
+	out := append([]mparam{}, ps...)
+	sort.Slice(out, func(i, j int) bool { return out[i].key < out[j].key })
+	return out
+}
+
+func describe(m *mcomp, indent string) string {
+	var b strings.Builder
+	b.WriteString(indent + "BEGIN " + m.name + "\n")
+	for _, p := range m.props {
+		b.WriteString(indent + "  " + p.name)
+		for _, pa := range p.params {
+			b.WriteString(fmt.Sprintf(";%s=%q", pa.key, pa.vals))
+		}
+		b.WriteString(fmt.Sprintf(":%q\n", p.value))
+	}
+	for _, k := range m.kids {
+		b.WriteString(describe(k, indent+"  "))
+	}
+	b.WriteString(indent + "END " + m.name + "\n")
+	return b.String()
+}
+
+// diffModel: "" when equal, else the first difference.
+func diffModel(want, got *mcomp, path string) string {
+	if want.name != got.name {
+		return fmt.Sprintf("%s: component %q, want %q", path, got.name, want.name)
+	}
+	if len(want.props) != len(got.props) {
+		return fmt.Sprintf("%s %s: %d properties, want %d", path, want.name, len(got.props), len(want.props))
+	}
+	for i := range want.props {
+		w, g := want.props[i], got.props[i]
+		if w.name != g.name || w.value != g.value || !reflect.DeepEqual(w.params, g.params) {
+			return fmt.Sprintf("%s %s: property %d is %s%v:%q, want %s%v:%q", path, want.name, i, g.name, g.params, g.value, w.name, w.params, w.value)
+		}
+	}
+	if len(want.kids) != len(got.kids) {
+		return fmt.Sprintf("%s %s: %d components, want %d", path, want.name, len(got.kids), len(want.kids))
+	}
+	for i := range want.kids {
+		if d := diffModel(want.kids[i], got.kids[i], path+"/"+want.name); d != "" {
+			return d
+		}
+	}
+	return ""
+}
+
+func (m *mcomp) all() []*mcomp {
+	out := []*mcomp{m}
+	for _, k := range m.kids {
+		out = append(out, k.all()...)
+	}
+	return out
+}
+
+func (m *mcomp) allProps() []mprop {
+	var out []mprop
+	for _, c := range m.all() {
+		out = append(out, c.props...)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- generators
+
+var textPieces = []string{"a", "b", "Z", "0", " ", "  ", ",", ";", `\`, ":", `"`, "'", "\n", "é", "日本", "-", "=", "<a>", "http://x/", "N", "n", "\t", "%", "\\n"}
+
+var (
+	// pieceTexts: up to six pieces joined (the empty text is the empty list).
+	pieceTexts = joined(hegel.Lists(hegel.SampledFrom(textPieces)).MaxSize(6))
+	// longTexts: a piece repeated 30 to 120 times, a line that folds several times.
+	longTexts = hegel.Map(pairs(hegel.SampledFrom([]string{"x", "日", "ab ", "é,"}), hegel.Integers(30, 120)), func(p pair[string, int]) string {
+		return strings.Repeat(p.a, p.b)
+	})
+	// texts: a TEXT value: pieces nine times in ten, a long text once.
+	texts = weighted(choice[string]{90, pieceTexts}, choice[string]{10, longTexts})
+)
+
+var typedValues = map[string][]string{
+	"DTSTART":          {"20240101", "20240101T120000Z", "20240315T083000", "19991231T235959Z"},
+	"DTEND":            {"20240102", "20240101T130000Z", "20240315T093000"},
+	"DUE":              {"20240102", "20240101T130000Z"},
+	"DTSTAMP":          {"20240101T120000Z"},
+	"CREATED":          {"20240101T120000Z"},
+	"LAST-MODIFIED":    {"20240101T120000Z"},
+	"EXDATE":           {"20240101T120000Z", "20240101T120000Z,20240102T120000Z", "20240105"},
+	"RDATE":            {"20240101T120000Z", "20240101T120000Z,20240102T120000Z"},
+	"DURATION":         {"PT1H", "-PT15M", "P1DT2H30M", "P2W"},
+	"TRIGGER":          {"-PT15M", "PT0S", "-P1D"},
+	"URL":              {"http://example.com/a?b=c,d;e", "https://x.y/z"},
+	"ATTACH":           {"http://example.com/f.pdf", "https://x.y/z"},
+	"GEO":              {"1.5;2.25", "-37.386013;-122.082932"},
+	"PRIORITY":         {"1", "5", "9"},
+	"SEQUENCE":         {"0", "3"},
+	"PERCENT-COMPLETE": {"0", "50", "100"},
+	"ORGANIZER":        {"mailto:a@b.c", "mailto:o'b@x.y"},
+	"ATTENDEE":         {"mailto:a@b.c", "mailto:d@e.f"},
+	"RRULE":            {"FREQ=DAILY;COUNT=3", "FREQ=WEEKLY;BYDAY=MO,WE;INTERVAL=2"},
+	"TZOFFSETFROM":     {"+0100", "-0500"},
+	"TZOFFSETTO":       {"+0200", "-0400"},
+	"FREEBUSY":         {"20240101T000000Z/PT1H", "20240101T000000Z/20240101T010000Z"},
+	"REPEAT":           {"2"},
+}
+
+var textNames = []string{"SUMMARY", "DESCRIPTION", "LOCATION", "COMMENT", "CATEGORIES", "RESOURCES", "X-FOO", "X-WR-CALNAME", "STATUS", "CLASS", "TZNAME", "CONTACT", "RELATED-TO", "ACTION", "UID", "TRANSP", "REQUEST-STATUS", "NAME", "COLOR", "IANA-THING"}
+
+var typedNames = func() []string {
+	var out []string
+	for k := range typedValues {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}()
+
+// dateNames: the properties whose DATE value (no time part) may carry VALUE=DATE.
+var dateNames = map[string]bool{"DTSTART": true, "DTEND": true, "DUE": true, "EXDATE": true}
+
+var paramKeys = []string{"CN", "LANGUAGE", "X-P", "DIR", "ROLE", "PARTSTAT", "ENCODING", "FMTTYPE", "RSVP", "X-LONG-NAME", "ALTREP"}
+
+// (no leading or trailing blank: icalendar trims parameter values next to a quoted one)
+var paramSafe = []string{"a", "B", "1", "-", "_", "a b", "é", ".", "日", "en-US", "x.y/z"}
+
+// paramSpecial: the characters a parameter value may hold beside the safe ones: the six that
+// golang-ical backslash-escapes (the shape of golang-ical/4; RFC 5545 quotes : ; , and cannot
+// write " at all); under HEGEL_NO_KNOWN=1 only , and ; whose escapes icalendar reads back.
+var paramSpecial = shaped([]string{",", ";", ":", `"`, "'", `\`}, []string{",", ";"})
+
+// genOpts: what a generated calendar may contain.
+type genOpts struct {
+	paramSpecials bool // parameter values with the characters of paramSpecial
+	noQuote       bool // parameter values without " (the harness writer cannot express one)
+	noBackslash   bool // parameter values without \ (icalendar reads it as an escape too)
+}
+
+// specialsOf: the special characters of the grammar's parameter values, " and \ replaced by '
+// where the writer cannot express them (keeping the pool's weight).
+func specialsOf(o genOpts) []string {
+	out := make([]string, 0, len(paramSpecial))
+	for _, s := range paramSpecial {
+		if (o.noQuote && s == `"`) || (o.noBackslash && s == `\`) {
+			s = "'"
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+// paramValuesOf: up to three pieces, each a safe one or, when the grammar has specials, a
+// special one six times in a hundred.
+func paramValuesOf(o genOpts) hegel.Generator[string] {
+	pieces := hegel.SampledFrom(paramSafe)
+	if o.paramSpecials {
+		pieces = weighted(choice[string]{94, pieces}, choice[string]{6, hegel.SampledFrom(specialsOf(o))})
+	}
+	return joined(hegel.Lists(pieces).MaxSize(3))
+}
+
+// orV is the value, or "v" for an empty one (icalendar drops an empty trailing list value).
+func orV(v string) string {
+	if v == "" {
+		return "v"
+	}
+	return v
+}
+
+// toParams sorts a drawn map of parameters into the model's list.
+func toParams(m map[string][]string) []mparam {
+	var out []mparam
+	for k, v := range m {
+		out = append(out, mparam{k, v})
+	}
+	return sortParams(out)
+}
+
+// paramsOf: up to two parameters (three or four once in ten) with distinct keys, each with
+// one value, or once in five two values (neither empty).
+func paramsOf(o genOpts) hegel.Generator[[]mparam] {
+	values := paramValuesOf(o)
+	one := hegel.Map(values, func(v string) []string { return []string{v} })
+	two := hegel.Map(pairs(values, values), func(p pair[string, string]) []string { return []string{orV(p.a), orV(p.b)} })
+	lists := weighted(choice[[]string]{80, one}, choice[[]string]{20, two})
+	keys := hegel.SampledFrom(paramKeys)
+	few := hegel.Maps(keys, lists).MaxSize(2)
+	several := hegel.Maps(keys, lists).MinSize(3).MaxSize(4)
+	return hegel.Map(weighted(choice[map[string][]string]{90, few}, choice[map[string][]string]{10, several}), toParams)
+}
+
+// propertiesOf: a property: one of textNames with a TEXT value three times in five, else one
+// of the typed names with a value from its table; parameters from the grammar; a DATE value
+// (no time part) of DTSTART, DTEND, DUE or EXDATE carries VALUE=DATE three times in five.
+func propertiesOf(o genOpts, typed []string) hegel.Generator[mprop] {
+	params := paramsOf(o)
+	textProps := hegel.Composite(func(tc hegel.TestCase) mprop {
+		return mprop{name: hegel.Draw(tc, hegel.SampledFrom(textNames)), value: hegel.Draw(tc, texts), params: hegel.Draw(tc, params)}
+	})
+	byName := map[string]hegel.Generator[mprop]{}
+	for _, name := range typed {
+		name := name
+		values := hegel.SampledFrom(typedValues[name])
+		dated := hegel.Just(false)
+		if dateNames[name] {
+			dated = chance(60)
+		}
+		byName[name] = hegel.Composite(func(tc hegel.TestCase) mprop {
+			p := mprop{name: name, value: hegel.Draw(tc, values), params: hegel.Draw(tc, params)}
+			if hegel.Draw(tc, dated) && !strings.Contains(p.value, "T") {
+				p.params = sortParams(append(p.params, mparam{"VALUE", []string{"DATE"}}))
+			}
+			return p
+		})
+	}
+	typedProps := hegel.FlatMap(hegel.SampledFrom(typed), func(name string) hegel.Generator[mprop] { return byName[name] })
+	return weighted(choice[mprop]{60, textProps}, choice[mprop]{40, typedProps})
+}
+
+// component kinds and their allowed children
+var kidsOf = map[string][]string{
+	"VCALENDAR": {"VEVENT", "VTODO", "VJOURNAL", "VFREEBUSY", "VTIMEZONE", "X-COMP", "VALARM"},
+	"VEVENT":    {"VALARM"},
+	"VTODO":     {"VALARM"},
+	"VTIMEZONE": {"STANDARD", "DAYLIGHT"},
+	"X-COMP":    {"X-INNER", "VEVENT"},
+	"X-INNER":   {},
+}
+
+var tzids = []string{"Europe/Paris", "My/Zone", "UTC"}
+
+// calendarsOf: a model calendar of the grammar: VERSION and PRODID, up to two more
+// properties (never DTSTART, DTEND or DUE at the calendar level) and up to three components
+// of the RFC's nesting (alarms in events and to-dos, STANDARD/DAYLIGHT in time zones, X-
+// components anywhere). Every component draws its first property (UID or TZID), up to four
+// more and up to two children from the generators of the names it may hold; the nesting is
+// finite, so the generators are built bottom-up, once per name.
+func calendarsOf(o genOpts) hegel.Generator[*mcomp] {
+	propLists := hegel.Lists(propertiesOf(o, typedNames)).MaxSize(4)
+	comps := map[string]hegel.Generator[*mcomp]{}
+	var build func(name string) hegel.Generator[*mcomp]
+	build = func(name string) hegel.Generator[*mcomp] {
+		if g, ok := comps[name]; ok {
+			return g
+		}
+		heads := hegel.Just([]mprop(nil))
+		switch name {
+		case "VEVENT", "VTODO", "VJOURNAL", "VFREEBUSY":
+			heads = hegel.Map(texts, func(uid string) []mprop { return []mprop{{name: "UID", value: uid}} })
+		case "VTIMEZONE":
+			heads = hegel.Map(hegel.SampledFrom(tzids), func(tzid string) []mprop { return []mprop{{name: "TZID", value: tzid}} })
+		}
+		var kids hegel.Generator[[]*mcomp] = hegel.Just([]*mcomp(nil))
+		if allowed := kidsOf[name]; len(allowed) > 0 {
+			alts := make([]hegel.Generator[*mcomp], len(allowed))
+			for i, k := range allowed {
+				alts[i] = build(k)
+			}
+			kids = hegel.Lists(hegel.OneOf(alts...)).MaxSize(2)
+		}
+		g := hegel.Composite(func(tc hegel.TestCase) *mcomp {
+			return &mcomp{name: name, props: append(hegel.Draw(tc, heads), hegel.Draw(tc, propLists)...), kids: hegel.Draw(tc, kids)}
+		})
+		comps[name] = g
+		return g
+	}
+	calProps := hegel.Lists(propertiesOf(o, without(typedNames, "DTSTART", "DTEND", "DUE"))).MaxSize(2)
+	allowed := kidsOf["VCALENDAR"]
+	alts := make([]hegel.Generator[*mcomp], len(allowed))
+	for i, k := range allowed {
+		alts[i] = build(k)
+	}
+	kids := hegel.Lists(hegel.OneOf(alts...)).MaxSize(3)
+	return hegel.Composite(func(tc hegel.TestCase) *mcomp {
+		m := &mcomp{name: "VCALENDAR", props: []mprop{{name: "VERSION", value: "2.0"}, {name: "PRODID", value: hegel.Draw(tc, texts)}}}
+		m.props = append(m.props, hegel.Draw(tc, calProps)...)
+		m.kids = hegel.Draw(tc, kids)
+		return m
+	})
+}
+
+// --------------------------------------------------------------------------- the API
+
+func paramArgs(ps []mparam) []ics.PropertyParameter {
+	var out []ics.PropertyParameter
+	for _, p := range ps {
+		out = append(out, &ics.KeyValues{Key: p.key, Value: append([]string{}, p.vals...)})
+	}
+	return out
+}
+
+func baseOf(c ics.Component) *ics.ComponentBase {
+	switch x := c.(type) {
+	case *ics.VEvent:
+		return &x.ComponentBase
+	case *ics.VTodo:
+		return &x.ComponentBase
+	case *ics.VJournal:
+		return &x.ComponentBase
+	case *ics.VBusy:
+		return &x.ComponentBase
+	case *ics.VTimezone:
+		return &x.ComponentBase
+	case *ics.VAlarm:
+		return &x.ComponentBase
+	case *ics.Standard:
+		return &x.ComponentBase
+	case *ics.Daylight:
+		return &x.ComponentBase
+	case *ics.GeneralComponent:
+		return &x.ComponentBase
+	}
+	panic(fmt.Sprintf("baseOf: %T", c))
+}
+
+func compName(c ics.Component) string {
+	switch x := c.(type) {
+	case *ics.VEvent:
+		return "VEVENT"
+	case *ics.VTodo:
+		return "VTODO"
+	case *ics.VJournal:
+		return "VJOURNAL"
+	case *ics.VBusy:
+		return "VFREEBUSY"
+	case *ics.VTimezone:
+		return "VTIMEZONE"
+	case *ics.VAlarm:
+		return "VALARM"
+	case *ics.Standard:
+		return "STANDARD"
+	case *ics.Daylight:
+		return "DAYLIGHT"
+	case *ics.GeneralComponent:
+		return x.Token
+	}
+	return fmt.Sprintf("%T", c)
+}
+
+// buildComp constructs a component through the API: the constructor sets the first property
+// (UID or TZID), AddProperty the rest, the exported Components slice the children.
+func buildComp(m *mcomp) ics.Component {
+	var c ics.Component
+	rest := m.props
+	switch m.name {
+	case "VEVENT":
+		c = ics.NewEvent(m.props[0].value)
+		rest = m.props[1:]
+	case "VTODO":
+		c = ics.NewTodo(m.props[0].value)
+		rest = m.props[1:]
+	case "VJOURNAL":
+		c = ics.NewJournal(m.props[0].value)
+		rest = m.props[1:]
+	case "VFREEBUSY":
+		c = ics.NewBusy(m.props[0].value)
+		rest = m.props[1:]
+	case "VTIMEZONE":
+		c = ics.NewTimezone(m.props[0].value)
+		rest = m.props[1:]
+	case "VALARM":
+		c = ics.NewAlarm("")
+	case "STANDARD":
+		c = ics.NewStandard()
+	case "DAYLIGHT":
+		c = &ics.Daylight{}
+	default:
+		c = &ics.GeneralComponent{Token: m.name}
+	}
+	cb := baseOf(c)
+	for _, p := range rest {
+		cb.AddProperty(ics.ComponentProperty(p.name), p.value, paramArgs(p.params)...)
+	}
+	for _, k := range m.kids {
+		kid := buildComp(k)
+		switch x := c.(type) {
+		case *ics.VEvent:
+			if a, ok := kid.(*ics.VAlarm); ok {
+				x.AddVAlarm(a)
+				continue
+			}
+		case *ics.VTodo:
+			if a, ok := kid.(*ics.VAlarm); ok {
+				x.AddVAlarm(a)
+				continue
+			}
+		}
+		cb.Components = append(cb.Components, kid)
+	}
+	return c
+}
+
+func build(m *mcomp) *ics.Calendar {
+	cal, err := ics.NewCalendarWithOptions()
+	if err != nil {
+		panic(err)
+	}
+	for _, p := range m.props {
+		switch p.name {
+		case "VERSION":
+			cal.SetVersion(p.value, paramArgs(p.params)...)
+		case "PRODID":
+			cal.SetProductId(p.value, paramArgs(p.params)...)
+		default:
+			cp := ics.CalendarProperty{BaseProperty: ics.BaseProperty{IANAToken: p.name, Value: p.value, ICalParameters: map[string][]string{}}}
+			for _, pa := range p.params {
+				cp.ICalParameters[pa.key] = append([]string{}, pa.vals...)
+			}
+			cal.CalendarProperties = append(cal.CalendarProperties, cp)
+		}
+	}
+	for _, k := range m.kids {
+		kid := buildComp(k)
+		switch x := kid.(type) {
+		case *ics.VEvent:
+			cal.AddVEvent(x)
+		case *ics.VTodo:
+			cal.AddVTodo(x)
+		case *ics.VJournal:
+			cal.AddVJournal(x)
+		case *ics.VBusy:
+			cal.AddVBusy(x)
+		case *ics.VTimezone:
+			cal.AddVTimezone(x)
+		case *ics.VAlarm:
+			cal.AddVAlarm(x)
+		default:
+			cal.Components = append(cal.Components, kid)
+		}
+	}
+	return cal
+}
+
+func propsOf(ps []ics.IANAProperty) []mprop {
+	out := make([]mprop, 0, len(ps))
+	for _, p := range ps {
+		out = append(out, propOf(p.BaseProperty))
+	}
+	return out
+}
+
+func propOf(bp ics.BaseProperty) mprop {
+	m := mprop{name: bp.IANAToken, value: bp.Value}
+	for k, v := range bp.ICalParameters {
+		m.params = append(m.params, mparam{k, append([]string{}, v...)})
+	}
+	m.params = sortParams(m.params)
+	return m
+}
+
+func compOf(c ics.Component) *mcomp {
+	m := &mcomp{name: compName(c), props: propsOf(c.UnknownPropertiesIANAProperties())}
+	for _, k := range c.SubComponents() {
+		m.kids = append(m.kids, compOf(k))
+	}
+	return m
+}
+
+func calOf(cal *ics.Calendar) *mcomp {
+	m := &mcomp{name: "VCALENDAR"}
+	for _, p := range cal.CalendarProperties {
+		m.props = append(m.props, propOf(p.BaseProperty))
+	}
+	for _, c := range cal.Components {
+		m.kids = append(m.kids, compOf(c))
+	}
+	return m
+}
+
+// --------------------------------------------------------------------------- content lines
+
+// treeOfLines builds a model from content lines (icalendar's or the harness's own view), names
+// and parameter keys upper-cased.
+func treeOfLines(lines []lineView) (*mcomp, error) {
+	var stack []*mcomp
+	var root *mcomp
+	for i, l := range lines {
+		name := strings.ToUpper(l.Name)
+		switch name {
+		case "BEGIN":
+			c := &mcomp{name: strings.ToUpper(l.Value)}
+			if len(stack) > 0 {
+				top := stack[len(stack)-1]
+				top.kids = append(top.kids, c)
+			} else if root != nil {
+				return nil, fmt.Errorf("line %d: a second top-level component", i)
+			} else {
+				root = c
+			}
+			stack = append(stack, c)
+		case "END":
+			if len(stack) == 0 || stack[len(stack)-1].name != strings.ToUpper(l.Value) {
+				return nil, fmt.Errorf("line %d: unbalanced END:%s", i, l.Value)
+			}
+			stack = stack[:len(stack)-1]
+		default:
+			if len(stack) == 0 {
+				return nil, fmt.Errorf("line %d: property outside a component", i)
+			}
+			p := mprop{name: name, value: l.Value}
+			for k, v := range l.Params {
+				p.params = append(p.params, mparam{strings.ToUpper(k), v})
+			}
+			p.params = sortParams(p.params)
+			top := stack[len(stack)-1]
+			top.props = append(top.props, p)
+		}
+	}
+	if root == nil || len(stack) != 0 {
+		return nil, fmt.Errorf("no complete top-level component")
+	}
+	return root, nil
+}
+
+// hasParamSpecial: a parameter value that RFC 5545 requires quoting for (: ; ,) or cannot
+// represent (") or that golang-ical escapes (' \).
+func hasParamSpecial(m *mcomp, chars string) bool {
+	for _, p := range m.allProps() {
+		for _, pa := range p.params {
+			for _, v := range pa.vals {
+				if strings.ContainsAny(v, chars) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// paramShape names golang-ical/4 when a parameter value of the model holds one of the
+// characters golang-ical backslash-escapes.
+func paramShape(m *mcomp) string { return shapeIf(hasParamSpecial(m, `:;,"'\`), "golang-ical/4") }
+
+// checkFolding: every line of the serialization is within maxLen octets (line break excluded),
+// valid UTF-8 on its own (no fold inside a multi-octet sequence) and ends with the line ending.
+func checkFolding(text, nl string, maxLen int) string {
+	if !strings.HasSuffix(text, nl) {
+		return "the text does not end with the line ending"
+	}
+	for i, line := range strings.Split(strings.TrimSuffix(text, nl), nl) {
+		if len(line) > maxLen {
+			return fmt.Sprintf("line %d has %d octets, the limit is %d: %q", i+1, len(line), maxLen, line)
+		}
+		if !utf8.ValidString(line) {
+			return fmt.Sprintf("line %d is not valid UTF-8 on its own (a fold inside a character): %q", i+1, line)
+		}
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- the harness writer
+
+// writeOpts: how the harness writes a calendar.
+type writeOpts struct {
+	nl         string
+	fold       int  // 0: no folding; else fold so that lines have at most this many octets
+	tabFold    bool // continuation lines start with a tab
+	lowercase  bool // names in lower case (the shape of golang-ical/8)
+	quoteAll   bool // quote every parameter value
+	blankLines bool // a blank line before some lines
+}
+
+// writeOptions: LF or CRLF; folding at 8 to 90 octets seven times in ten; tab continuations
+// once in five; lower case once in twenty (never under HEGEL_NO_KNOWN=1); every parameter value
+// quoted three times in ten; blank lines once in five.
+var writeOptions = hegel.Composite(func(tc hegel.TestCase) writeOpts {
+	return writeOpts{
+		nl:         hegel.Draw(tc, hegel.SampledFrom([]string{"\n", "\r\n"})),
+		fold:       hegel.Draw(tc, maybe(70, hegel.Integers(8, 90))),
+		tabFold:    hegel.Draw(tc, chance(20)),
+		lowercase:  hegel.Draw(tc, lowercases),
+		quoteAll:   hegel.Draw(tc, chance(30)),
+		blankLines: hegel.Draw(tc, chance(20)),
+	}
+})
+
+func needsQuote(v string) bool { return strings.ContainsAny(v, ":;,") }
+
+// writer writes a model in RFC 5545 syntax with the options, the tape answering its free
+// choices: where to cut a folded line (an empty tape cuts at the limit) and whether to put a
+// blank line before a line (never on an empty tape).
+type writer struct {
+	b strings.Builder
+	w writeOpts
+	t *tape
+}
+
+func (wr *writer) line(line string) {
+	w := wr.w
+	if w.blankLines && wr.t.coin(20) {
+		wr.b.WriteString(w.nl)
+	}
+	if w.fold == 0 || len(line) <= w.fold {
+		wr.b.WriteString(line + w.nl)
+		return
+	}
+	first := true
+	for len(line) > 0 {
+		limit := w.fold
+		if !first {
+			limit--
+		}
+		cut := limit - wr.t.next(limit) // 1 to limit
+		if cut > len(line) {
+			cut = len(line)
+		}
+		for cut < len(line) && !utf8.RuneStart(line[cut]) {
+			cut++
+		}
+		if !first {
+			if w.tabFold {
+				wr.b.WriteString("\t")
+			} else {
+				wr.b.WriteString(" ")
+			}
+		}
+		wr.b.WriteString(line[:cut] + w.nl)
+		line = line[cut:]
+		first = false
+	}
+}
+
+func (wr *writer) prop(p mprop) {
+	name := p.name
+	if wr.w.lowercase {
+		name = strings.ToLower(name)
+	}
+	var l strings.Builder
+	l.WriteString(name)
+	for _, pa := range p.params {
+		key := pa.key
+		if wr.w.lowercase {
+			key = strings.ToLower(key)
+		}
+		l.WriteString(";" + key + "=")
+		for i, v := range pa.vals {
+			if i > 0 {
+				l.WriteString(",")
+			}
+			if wr.w.quoteAll || needsQuote(v) {
+				l.WriteString(`"` + v + `"`)
+			} else {
+				l.WriteString(v)
+			}
+		}
+	}
+	l.WriteString(":")
+	if isText(p) {
+		l.WriteString(escapeText(p.value))
+	} else {
+		l.WriteString(p.value)
+	}
+	wr.line(l.String())
+}
+
+func (wr *writer) comp(m *mcomp) {
+	begin, end := "BEGIN", "END"
+	name := m.name
+	if wr.w.lowercase {
+		begin, end, name = "begin", "end", strings.ToLower(name)
+	}
+	wr.line(begin + ":" + name)
+	for _, p := range m.props {
+		wr.prop(p)
+	}
+	for _, k := range m.kids {
+		wr.comp(k)
+	}
+	wr.line(end + ":" + name)
+}
+
+// writeICS is the model in RFC 5545 syntax under the options, the tape answering the writer's
+// free choices.
+func writeICS(m *mcomp, w writeOpts, tp []int) string {
+	wr := &writer{w: w, t: &tape{vals: tp}}
+	wr.comp(m)
+	return wr.b.String()
+}
+
+// --------------------------------------------------------------------------- cases
+
+var (
+	// lineLengths: 75 three times in five, else 16 to 200 (BEGIN and END lines are written
+	// unfolded and BEGIN:VCALENDAR is 15 octets).
+	lineLengths = weighted(choice[int]{60, hegel.Just(75)}, choice[int]{40, hegel.Integers(16, 200)})
+	lineEndings = hegel.SampledFrom([]string{"\n", "\r\n"})
+)
+
+// serializeCase: a model calendar and the line length and line ending of its serialization.
+type serializeCase struct {
+	m      *mcomp
+	maxLen int
+	nl     string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c serializeCase) GoString() string {
+	return fmt.Sprintf("line length %d, newline %q\n%s", c.maxLen, c.nl, describe(c.m, ""))
+}
+
+// serializeCases: parameter values with the specials (golang-ical's own parser reads its
+// escapes back; icalendar's reading of them is the shape of golang-ical/4).
+var serializeCases = func() hegel.Generator[serializeCase] {
+	cals := calendarsOf(genOpts{paramSpecials: true})
+	return hegel.Composite(func(tc hegel.TestCase) serializeCase {
+		return serializeCase{m: hegel.Draw(tc, cals), maxLen: hegel.Draw(tc, lineLengths), nl: hegel.Draw(tc, lineEndings)}
+	})
+}()
+
+// parseCase: a model calendar, the harness writer's options and its tape.
+type parseCase struct {
+	m    *mcomp
+	w    writeOpts
+	tape []int
+}
+
+func (c parseCase) text() string { return writeICS(c.m, c.w, c.tape) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c parseCase) GoString() string {
+	w := c.w
+	return fmt.Sprintf("newline %q fold %d tab %v lower %v quoteAll %v blankLines %v, tape of %d\n%s%q",
+		w.nl, w.fold, w.tabFold, w.lowercase, w.quoteAll, w.blankLines, len(c.tape), describe(c.m, ""), c.text())
+}
+
+// parseCases: calendars for the harness writer (no " or \ in parameter values), with the
+// specials in three calendars of ten.
+var parseCases = func() hegel.Generator[parseCase] {
+	plain := calendarsOf(genOpts{noQuote: true, noBackslash: true})
+	specials := calendarsOf(genOpts{paramSpecials: true, noQuote: true, noBackslash: true})
+	cals := weighted(choice[*mcomp]{70, plain}, choice[*mcomp]{30, specials})
+	return hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{m: hegel.Draw(tc, cals), w: hegel.Draw(tc, writeOptions), tape: hegel.Draw(tc, tapes)}
+	})
+}()
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelSerializeParsesBack: a calendar built through the API, serialized with any line
+// length (16 or more) and line ending, is folded within the limit without splitting a
+// character, and ParseCalendar reads it back to the model.
+func TestHegelSerializeParsesBack(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, serializeCases)
+		m, maxLen, nl := sc.m, sc.maxLen, sc.nl
+		cal := build(m)
+		if d := diffModel(m, calOf(cal), ""); d != "" {
+			ht.Fatalf("the built calendar is not the model: %s", d)
+		}
+		c.count(fmt.Sprintf("nl=%q", nl))
+		text := cal.Serialize(ics.WithLineLength(maxLen), ics.WithNewLine(nl))
+		if maxLen == 75 && nl == "\n" {
+			if plain := cal.Serialize(); plain != text {
+				c.fail(ht, "Serialize() differs from Serialize(WithLineLength(75), WithNewLine(\"\\n\"))")
+				return
+			}
+		}
+		if d := checkFolding(text, nl, maxLen); d != "" {
+			c.fail(ht, "folding at %d: %s", maxLen, d)
+			return
+		}
+		got, err := ics.ParseCalendar(strings.NewReader(text))
+		if err != nil {
+			c.fail(ht, "ParseCalendar of the serialization: %v\n%q", err, text)
+			return
+		}
+		if d := diffModel(m, calOf(got), ""); d != "" {
+			c.fail(ht, "read back (line length %d): %s\n%q", maxLen, d, text)
+		}
+	})
+}
+
+// TestHegelIcalendarReadsTheOutput: icalendar's content-line parser reads what Serialize writes
+// as the model (names, parameters, unescaped values, nesting). A parameter value with one of
+// : ; , " ' \ is written backslash-escaped instead of quoted, which icalendar rejects (\') or
+// misreads (\:): the shape of golang-ical/4, drawn at its natural rate (never under
+// HEGEL_NO_KNOWN=1, where only , and ; are drawn and read back).
+func TestHegelIcalendarReadsTheOutput(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, serializeCases)
+		m, maxLen, nl := sc.m, sc.maxLen, sc.nl
+		shape := paramShape(m)
+		cal := build(m)
+		text := cal.Serialize(ics.WithLineLength(maxLen), ics.WithNewLine(nl))
+		lines, perr := pyLines(ht, text)
+		if perr != "" {
+			c.mismatch(ht, shape, "icalendar rejects the serialization: %s\n%q", perr, text)
+			return
+		}
+		got, err := treeOfLines(lines)
+		if err != nil {
+			c.mismatch(ht, shape, "icalendar's lines do not form the tree: %v\n%q", err, text)
+			return
+		}
+		c.count("ok")
+		if d := diffModel(m, got, ""); d != "" {
+			c.mismatch(ht, shape, "icalendar reads: %s\n%q", d, text)
+		}
+	})
+}
+
+// TestHegelParsesLikeIcalendar: RFC 5545 text written by the harness (folded at arbitrary
+// octets, tab continuations, quoted parameters, either line ending, blank lines) parses to the
+// model, as icalendar reads it; the parsed calendar re-serializes to something icalendar reads
+// as the same model. Lower-case names (golang-ical/8) and parameter values with : ; , or '
+// (golang-ical/4, on the re-serialization) are drawn at their natural rates; under
+// HEGEL_NO_KNOWN=1 the names stay upper case and the specials are , and ;, whose escapes
+// icalendar reads back.
+func TestHegelParsesLikeIcalendar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		pc := hegel.Draw(ht, parseCases)
+		m, w := pc.m, pc.w
+		text := pc.text()
+
+		lines, perr := pyLines(ht, text)
+		if perr != "" {
+			ht.Fatalf("icalendar rejects the harness's text: %s\n%q", perr, text)
+		}
+		py, err := treeOfLines(lines)
+		if err != nil {
+			ht.Fatalf("icalendar's lines do not form the tree: %v\n%q", err, text)
+		}
+		if d := diffModel(m, py, ""); d != "" {
+			c.fail(ht, "icalendar reads the harness's text as: %s\n%q", d, text)
+			return
+		}
+
+		c.count(fmt.Sprintf("fold=%v lower=%v", w.fold > 0, w.lowercase))
+		lower := shapeIf(w.lowercase, "golang-ical/8")
+		cal, err := ics.ParseCalendar(strings.NewReader(text))
+		if err != nil {
+			c.mismatch(ht, lower, "ParseCalendar: %v\n%q", err, text)
+			return
+		}
+		if d := diffModel(m, calOf(cal), ""); d != "" {
+			c.mismatch(ht, lower, "ParseCalendar reads: %s\n%q", d, text)
+			return
+		}
+
+		// Re-serialize and let icalendar read it.
+		shape := paramShape(m)
+		out := cal.Serialize(ics.WithNewLine("\r\n"))
+		lines, perr = pyLines(ht, out)
+		if perr != "" {
+			c.mismatch(ht, shape, "icalendar rejects the re-serialization: %s\n%q", perr, out)
+			return
+		}
+		py, err = treeOfLines(lines)
+		if err != nil {
+			c.mismatch(ht, shape, "re-serialization lines: %v\n%q", err, out)
+			return
+		}
+		if d := diffModel(m, py, ""); d != "" {
+			c.mismatch(ht, shape, "icalendar reads the re-serialization as: %s\n%q", d, out)
+		}
+	})
+}
