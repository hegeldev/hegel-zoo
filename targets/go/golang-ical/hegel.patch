+// outOfRangeParts: COUNT 0 or -1, INTERVAL 0 or -2, or a BY list's upper bound plus one, lower
+// bound less one or 999 (the values the wide property draws at its rate).
+var outOfRangeParts = hegel.OneOf(
+	hegel.Map(hegel.SampledFrom([]int{0, -1}), func(v int) outOfRangePart { return outOfRangePart{"COUNT", v} }),
+	hegel.Map(hegel.SampledFrom([]int{0, -2}), func(v int) outOfRangePart { return outOfRangePart{"INTERVAL", v} }),
+	hegel.FlatMap(hegel.SampledFrom(without(listOrder, "BYDAY")), func(key string) hegel.Generator[outOfRangePart] {
+		rg := listRanges[key]
+		return hegel.Map(hegel.SampledFrom([]int{rg[1] + 1, rg[0] - 1, 999}), func(v int) outOfRangePart { return outOfRangePart{key, v} })
+	}),
