+// The environment variables of the child that runs one Serialize (a hang cannot be stopped
+// in-process: the test binary re-runs this test on itself with the case in them).
+const (
+	serializeChildLen  = "ZOO_ICAL_SERIALIZE_LINE_LENGTH"
+	serializeChildText = "ZOO_ICAL_SERIALIZE_TEXT"
+)
+
+// serializeInChild runs Serialize(WithLineLength(c.maxLen)) of a calendar with the description
+// in a child process, returning context.DeadlineExceeded when it does not return in time.
+// serializeChild is the child's side of serializeInChild: in the child process it runs the one
+// Serialize of the case and reports true, so the test returns; the address space is capped by
+// the parent. Shared with the pin of golang-ical/7, since a Serialize that never returns cannot
+// be run in-process: its goroutine cannot be stopped and grows to the machine's memory.
+func serializeChild() bool {
+	s := os.Getenv(serializeChildLen)
+	if s == "" {
+		return false
+	}
+	maxLen, _ := strconv.Atoi(s)
+	cal := ics.NewCalendar()
+	cal.AddEvent("u").SetDescription(os.Getenv(serializeChildText))
+	cal.Serialize(ics.WithLineLength(maxLen))
+	return true
+}
+
+func serializeInChild(testName string, c lineLengthCase, timeout time.Duration) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	// The folding loop that never returns also grows its output without bound (several GB
+	// within a second), so the child's address space is capped at 2.2 GB with ulimit -v (Go
+	// needs most of that just to start): the runtime
+	// then dies with "out of memory" instead of the machine's OOM killer choosing a victim.
+	cmd := exec.CommandContext(ctx, "/bin/sh", "-c", `ulimit -v 2200000 && exec "$0" "$@"`, os.Args[0], "-test.run", "^"+testName+"$")
+	cmd.Env = append(os.Environ(), serializeChildLen+"="+strconv.Itoa(c.maxLen), serializeChildText+"="+c.text)
+	cmd.WaitDelay = 500 * time.Millisecond // a killed child cannot hold the pipes open
+	out, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		return string(out), ctx.Err()
+	}
+	return string(out), err
+}
+
+// TestHegelSerializeTerminatesForEveryLineLength: Serialize returns for every line length
+// (refusing or clamping a degenerate one); with a line length of 2 to 4 and a character that
+// does not fit a continuation line the library's folding loop makes no progress and never
+// returns (golang-ical/7). The wide properties fold at 16 octets and more.
+func TestHegelSerializeTerminatesForEveryLineLength(t *testing.T) {
+	if serializeChild() {
+		return
+	}
+	shapeOff(t, "golang-ical/7")
+	c := newCollector(t)
+	name := t.Name()
+	// The shrinker revisits the same few cases hundreds of times and every hung case costs
+	// the deadline, so each case's verdict is kept.
+	type verdict struct {
+		out string
+		err error
+	}
+	seen := map[lineLengthCase]verdict{}
+	property(t, func(ht *hegel.T) {
+		lc := hegel.Draw(ht, lineLengthCases)
+		v, ok := seen[lc]
+		if !ok {
+			v.out, v.err = serializeInChild(name, lc, 150*time.Millisecond)
+			seen[lc] = v
+		}
+		out, err := v.out, v.err
+		if errors.Is(err, context.DeadlineExceeded) || strings.Contains(out, "out of memory") {
+			c.mismatch(ht, "golang-ical/7", "Serialize(WithLineLength(%d)) of a description %q does not return within 150 ms (or exhausts its address space first)", lc.maxLen, lc.text)
+			return
+		}
+		if err != nil {
+			ht.Fatalf("the child Serialize failed: %v\n%s", err, out)
+		}
+	})
+}
