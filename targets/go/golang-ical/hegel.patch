+// lineLengthCase: a line length of 2 to 4 and a description holding characters of at least
+// that many octets (which cannot fit a continuation line of length-1 octets) among ASCII
+// pieces (spaces and angle brackets are the word boundaries the trimming looks for).
+type lineLengthCase struct {
+	maxLen int
+	text   string
+}
