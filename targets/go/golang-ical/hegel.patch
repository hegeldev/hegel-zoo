+package ics_test
+
+// The icalendar (Python) oracle: one persistent child answering JSON lines.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const pythonScript = `
+import sys, json, datetime, warnings
+warnings.filterwarnings("ignore")
+from icalendar.parser import Contentlines, Contentline, unescape_char
+from icalendar import vRecur, vDDDTypes
+
+def lines(ics):
+    out = []
+    for cl in Contentlines.from_ical(ics):
+        if not cl:
+            continue
+        name, params, value = cl.parts()
+        ps = {}
+        for k, v in params.items():
+            if isinstance(v, (list, tuple)):
+                ps[str(k)] = [str(x) for x in v]
+            else:
+                ps[str(k)] = [str(v)]
+        out.append({"name": str(name), "params": ps, "value": str(value)})
+    return {"lines": out}
+
+def recur(s):
+    r = vRecur.from_ical(s)
+    out = {}
+    for k, v in r.items():
+        vals = []
+        for x in v:
+            if isinstance(x, datetime.datetime):
+                vals.append(x.strftime("%Y%m%dT%H%M%S") + ("Z" if x.tzinfo is not None else ""))
+            elif isinstance(x, datetime.date):
+                vals.append(x.strftime("%Y%m%d"))
+            else:
+                vals.append(str(x))
+        out[str(k)] = vals
+    return {"recur": out}
+
+def dt(s, tz):
+    v = vDDDTypes.from_ical(s, timezone=tz) if tz else vDDDTypes.from_ical(s)
+    if isinstance(v, datetime.datetime):
+        name = ""
+        if v.tzinfo is not None:
+            name = getattr(v.tzinfo, "key", None) or str(v.tzinfo)
+        return {"kind": "datetime", "wall": v.strftime("%Y%m%dT%H%M%S"), "tz": name}
+    if isinstance(v, datetime.date):
+        return {"kind": "date", "wall": v.strftime("%Y%m%d"), "tz": ""}
+    return {"kind": type(v).__name__, "wall": str(v), "tz": ""}
+
+for raw in sys.stdin:
+    raw = raw.strip()
+    if not raw:
+        continue
+    req = json.loads(raw)
+    try:
+        c = req["c"]
+        if c == "lines":
+            res = lines(req["ics"])
+        elif c == "text":
+            res = {"text": unescape_char(req["v"])}
+        elif c == "recur":
+            res = recur(req["v"])
+        elif c == "dt":
+            res = dt(req["v"], req.get("tz", ""))
+        else:
+            res = {"error": "unknown command " + c}
+    except Exception as e:
+        res = {"error": type(e).__name__ + ": " + str(e)}
+    sys.stdout.write(json.dumps(res) + "\n")
+    sys.stdout.flush()
+`
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+var (
+	oracleOnce sync.Once
+	oracleInst *pyChild
+	oracleErr  error
+)
+
+func oracle(t testing.TB) *pyChild {
+	t.Helper()
+	oracleOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			oracleErr = err
+			return
+		}
+		oracleInst = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	})
+	if oracleErr != nil {
+		t.Fatalf("starting the icalendar oracle: %v", oracleErr)
+	}
+	return oracleInst
+}
+
+type lineView struct {
+	Name   string              `json:"name"`
+	Params map[string][]string `json:"params"`
+	Value  string              `json:"value"`
+}
+
+type oracleReply struct {
+	Error string              `json:"error"`
+	Lines []lineView          `json:"lines"`
+	Text  *string             `json:"text"`
+	Recur map[string][]string `json:"recur"`
+	Kind  string              `json:"kind"`
+	Wall  string              `json:"wall"`
+	TZ    string              `json:"tz"`
+}
+
+func (p *pyChild) ask(t testing.TB, req map[string]any) oracleReply {
+	t.Helper()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle request: %v", err)
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if err := p.in.Flush(); err != nil {
+		t.Fatalf("oracle flush: %v", err)
+	}
+	line, err := p.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("oracle read: %v", err)
+	}
+	var rep oracleReply
+	if err := json.Unmarshal(line, &rep); err != nil {
+		t.Fatalf("oracle reply %q: %v", strings.TrimSpace(string(line)), err)
+	}
+	return rep
+}
+
+// pyLines: icalendar's content lines of an iCalendar text ("" error when it parses).
+func pyLines(t testing.TB, ics string) ([]lineView, string) {
+	rep := oracle(t).ask(t, map[string]any{"c": "lines", "ics": ics})
+	return rep.Lines, rep.Error
+}
+
+func pyText(t testing.TB, raw string) string {
+	rep := oracle(t).ask(t, map[string]any{"c": "text", "v": raw})
+	if rep.Error != "" || rep.Text == nil {
+		t.Fatalf("unescape_char(%q): %s", raw, rep.Error)
+	}
+	return *rep.Text
+}
+
+func pyRecur(t testing.TB, s string) (map[string][]string, string) {
+	rep := oracle(t).ask(t, map[string]any{"c": "recur", "v": s})
+	return rep.Recur, rep.Error
+}
+
+// pyDateTime: kind ("date"/"datetime"), wall-clock text, zone name, error.
+func pyDateTime(t testing.TB, s, tz string) (string, string, string, string) {
+	rep := oracle(t).ask(t, map[string]any{"c": "dt", "v": s, "tz": tz})
+	return rep.Kind, rep.Wall, rep.TZ, rep.Error
+}
+
+var _ = fmt.Sprintf
