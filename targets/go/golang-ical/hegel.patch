+// GoString is what the draw report prints (it uses %#v).
+func (c outOfRangeCase) GoString() string {
+	return fmt.Sprintf("RRULE %q with %s=%d", c.r.text(), c.part.key, c.part.value)
+}
+
+var outOfRangeCases = hegel.Composite(func(tc hegel.TestCase) outOfRangeCase {
+	r := plainRule(hegel.Draw(tc, rules))
+	part := hegel.Draw(tc, outOfRangeParts)
+	switch part.key {
+	case "COUNT":
+		r.count, r.until = ptrTo(part.value), ""
+	case "INTERVAL":
+		r.interval = ptrTo(part.value)
+	default:
+		r.lists[part.key] = append(r.lists[part.key], part.value)
+	}
+	return outOfRangeCase{r: r, part: part}
+})
+
+// TestHegelRecurrenceValuesOutOfRangeAreRejected: ParseRecurrenceRule rejects a rule with a
+// numeric part outside its RFC 5545 3.3.10 range (INTERVAL and COUNT positive, BYSECOND 0-60,
+// BYMINUTE 0-59, BYHOUR 0-23, BYMONTHDAY 1-31, BYYEARDAY 1-366, BYWEEKNO 1-53, BYMONTH 1-12,
+// BYSETPOS 1-366, the signed ones either sign); the library only converts the integers
+// (golang-ical/13).
+func TestHegelRecurrenceValuesOutOfRangeAreRejected(t *testing.T) {
+	shapeOff(t, "golang-ical/13")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		oc := hegel.Draw(ht, outOfRangeCases)
+		text := oc.r.text()
+		if got, err := ics.ParseRecurrenceRule(text); err == nil {
+			c.mismatch(ht, "golang-ical/13", "ParseRecurrenceRule(%q) accepts %s=%d, outside its range: %q", text, oc.part.key, oc.part.value, got.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-ical/14
+
+// badNameCase: a content line whose property name does not start the line (junk before it) or
+// whose parameter name is not a token (junk before it), around a name, a parameter and a value
+// from the pools.
+type badNameCase struct {
+	inParam bool // the junk is before the parameter name
+	junk    string
+	name    string
+	key     string
+	pval    string
+	value   string
+}
+
+func (c badNameCase) text() string {
+	if c.inParam {
+		return c.name + ";" + c.junk + c.key + "=" + c.pval + ":" + escapeText(c.value)
+	}
+	return c.junk + c.name + ":" + escapeText(c.value)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c badNameCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+var badNameCases = func() hegel.Generator[badNameCase] {
+	// junk: characters that are not in an iana-token, before the property name (spaces too, a
+	// stray continuation) or before a parameter name (where = and ; are the ones the pins show)
+	nameJunk := hegel.Text().Alphabet("#*!.+@$%_ ").MinSize(1).MaxSize(3)
+	paramJunk := hegel.Text().Alphabet("=;#*").MinSize(1).MaxSize(2)
+	rest := func(tc hegel.TestCase, inParam bool, junk string) badNameCase {
+		return badNameCase{
+			inParam: inParam,
+			junk:    junk,
+			name:    hegel.Draw(tc, hegel.SampledFrom(textNames)),
+			key:     hegel.Draw(tc, hegel.SampledFrom(paramKeys)),
+			pval:    hegel.Draw(tc, hegel.SampledFrom(paramSafe)),
+			value:   hegel.Draw(tc, pieceTexts),
+		}
+	}
+	return hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) badNameCase { return rest(tc, false, hegel.Draw(tc, nameJunk)) }),
+		hegel.Composite(func(tc hegel.TestCase) badNameCase { return rest(tc, true, hegel.Draw(tc, paramJunk)) }),
+	)
+}()
+
+// TestHegelNamesAreAnchored: a content line begins with the property name and a parameter name
+// is a token (RFC 5545 3.1), so a line with junk before either is malformed, as icalendar
+// reports; the library finds both names by an unanchored search and accepts the line
+// (golang-ical/14).
+func TestHegelNamesAreAnchored(t *testing.T) {
+	shapeOff(t, "golang-ical/14")
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		bc := hegel.Draw(ht, badNameCases)
+		text := bc.text()
+		if p, err := ics.ParseProperty(ics.ContentLine(text)); err == nil {
+			c.mismatch(ht, "golang-ical/14", "ParseProperty(%q) accepts it as %s with parameters %v and value %q", text, p.IANAToken, p.ICalParameters, p.Value)
+		}
+	})
+}
