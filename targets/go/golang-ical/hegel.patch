+package ics_test
+
+// Recurrence rules, time getters and the property API against the model and icalendar.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	ics "github.com/arran4/golang-ical"
+)
+
+// --------------------------------------------------------------------------- recurrence rules
+
+type mrule struct {
+	freq     string
+	until    string // raw value, "" when absent
+	count    int    // 0 when absent
+	interval int    // 0 when absent
+	lists    map[string][]int
+	byday    []string
+	wkst     string
+	parts    []string // the parts as written, in order
+	outRange bool     // a value outside the RFC's range
+	lower    bool     // written in lower case
+}
+
+var listRanges = map[string][2]int{
+	"BYSECOND": {0, 60}, "BYMINUTE": {0, 59}, "BYHOUR": {0, 23},
+	"BYMONTHDAY": {1, 31}, "BYYEARDAY": {1, 366}, "BYWEEKNO": {1, 53}, "BYMONTH": {1, 12}, "BYSETPOS": {1, 366},
+}
+var signedLists = map[string]bool{"BYMONTHDAY": true, "BYYEARDAY": true, "BYWEEKNO": true, "BYSETPOS": true}
+var listOrder = []string{"BYSECOND", "BYMINUTE", "BYHOUR", "BYDAY", "BYMONTHDAY", "BYYEARDAY", "BYWEEKNO", "BYMONTH", "BYSETPOS"}
+var weekdays = []string{"SU", "MO", "TU", "WE", "TH", "FR", "SA"}
+var freqs = []string{"SECONDLY", "MINUTELY", "HOURLY", "DAILY", "WEEKLY", "MONTHLY", "YEARLY"}
+
+func genRule(tc hegel.TestCase) mrule {
+	r := mrule{freq: pick(tc, freqs), lists: map[string][]int{}}
+	r.parts = append(r.parts, "FREQ="+r.freq)
+	switch n(tc, 1, 4) {
+	case 1:
+		r.until = pick(tc, []string{"20240101", "20241231T235959Z", "20240601T120000", "19700101T000000Z"})
+		r.parts = append(r.parts, "UNTIL="+r.until)
+	case 2:
+		r.count = n(tc, 1, 100)
+		if chance(tc, 4) {
+			r.count = pick(tc, []int{0, -1})
+			r.outRange = true
+		}
+		r.parts = append(r.parts, "COUNT="+strconv.Itoa(r.count))
+	}
+	if chance(tc, 50) {
+		r.interval = n(tc, 1, 50)
+		if chance(tc, 4) {
+			r.interval = pick(tc, []int{0, -2})
+			r.outRange = true
+		}
+		r.parts = append(r.parts, "INTERVAL="+strconv.Itoa(r.interval))
+	}
+	for _, key := range listOrder {
+		if !chance(tc, 25) {
+			continue
+		}
+		if key == "BYDAY" {
+			for k := n(tc, 1, 3); k > 0; k-- {
+				d := pick(tc, weekdays)
+				switch n(tc, 1, 4) {
+				case 1:
+					d = strconv.Itoa(n(tc, 1, 5)) + d
+				case 2:
+					d = "-" + strconv.Itoa(n(tc, 1, 5)) + d
+				case 3:
+					if chance(tc, 30) {
+						d = "+" + strconv.Itoa(n(tc, 1, 5)) + d
+					}
+				}
+				r.byday = append(r.byday, d)
+			}
+			r.parts = append(r.parts, "BYDAY="+strings.Join(r.byday, ","))
+			continue
+		}
+		rg := listRanges[key]
+		var vals []int
+		for k := n(tc, 1, 3); k > 0; k-- {
+			v := n(tc, rg[0], rg[1])
+			if signedLists[key] && chance(tc, 30) {
+				v = -v
+			}
+			if chance(tc, 3) {
+				v = pick(tc, []int{rg[1] + 1, rg[0] - 1, 999})
+				r.outRange = true
+			}
+			vals = append(vals, v)
+		}
+		r.lists[key] = vals
+		strs := make([]string, len(vals))
+		for i, v := range vals {
+			strs[i] = strconv.Itoa(v)
+		}
+		r.parts = append(r.parts, key+"="+strings.Join(strs, ","))
+	}
+	if chance(tc, 30) {
+		r.wkst = pick(tc, weekdays)
+		r.parts = append(r.parts, "WKST="+r.wkst)
+	}
+	// shuffle the parts after FREQ sometimes
+	if chance(tc, 50) {
+		for i := len(r.parts) - 1; i > 1; i-- {
+			j := n(tc, 1, i)
+			r.parts[i], r.parts[j] = r.parts[j], r.parts[i]
+		}
+	}
+	r.lower = n(tc, 1, 20) == 10
+	return r
+}
+
+func (r mrule) text() string {
+	s := strings.Join(r.parts, ";")
+	if r.lower {
+		s = strings.ToLower(s)
+	}
+	return s
+}
+
+// canonical: the String() form golang-ical documents (FREQ, UNTIL, COUNT, INTERVAL unless 1,
+// the BY lists in RFC order, WKST); "+" ordinals are written without the sign.
+func (r mrule) canonical() string {
+	parts := []string{"FREQ=" + r.freq}
+	if r.until != "" {
+		parts = append(parts, "UNTIL="+r.until)
+	}
+	if r.count != 0 {
+		parts = append(parts, "COUNT="+strconv.Itoa(r.count))
+	}
+	if r.interval != 0 && r.interval != 1 {
+		parts = append(parts, "INTERVAL="+strconv.Itoa(r.interval))
+	}
+	for _, key := range listOrder {
+		if key == "BYDAY" {
+			if len(r.byday) > 0 {
+				ds := make([]string, len(r.byday))
+				for i, d := range r.byday {
+					ds[i] = strings.TrimPrefix(d, "+")
+				}
+				parts = append(parts, "BYDAY="+strings.Join(ds, ","))
+			}
+			continue
+		}
+		if vals, ok := r.lists[key]; ok {
+			strs := make([]string, len(vals))
+			for i, v := range vals {
+				strs[i] = strconv.Itoa(v)
+			}
+			parts = append(parts, key+"="+strings.Join(strs, ","))
+		}
+	}
+	if r.wkst != "" {
+		parts = append(parts, "WKST="+r.wkst)
+	}
+	return strings.Join(parts, ";")
+}
+
+func ruleFields(g *ics.RecurrenceRule) map[string]any {
+	out := map[string]any{"FREQ": string(g.Freq), "COUNT": g.Count, "INTERVAL": g.Interval, "WKST": string(g.Wkst)}
+	var days []string
+	for _, d := range g.ByDay {
+		days = append(days, d.String())
+	}
+	out["BYDAY"] = days
+	out["BYSECOND"], out["BYMINUTE"], out["BYHOUR"] = g.BySecond, g.ByMinute, g.ByHour
+	out["BYMONTHDAY"], out["BYYEARDAY"], out["BYWEEKNO"], out["BYMONTH"], out["BYSETPOS"] = g.ByMonthDay, g.ByYearDay, g.ByWeekNo, g.ByMonth, g.BySetPos
+	if g.Until.IsZero() {
+		out["UNTIL"] = ""
+	} else if g.UntilDateOnly {
+		out["UNTIL"] = g.Until.Format("20060102")
+	} else {
+		out["UNTIL"] = g.Until.Format("20060102T150405") + map[bool]string{true: "Z", false: ""}[g.Until.Location() == time.UTC]
+	}
+	return out
+}
+
+func (r mrule) fields() map[string]any {
+	out := map[string]any{"FREQ": r.freq, "COUNT": r.count, "INTERVAL": r.interval, "WKST": r.wkst}
+	if out["INTERVAL"] == 0 {
+		out["INTERVAL"] = 1
+	}
+	var days []string
+	for _, d := range r.byday {
+		days = append(days, strings.TrimPrefix(d, "+"))
+	}
+	out["BYDAY"] = days
+	for _, key := range listOrder {
+		if key == "BYDAY" {
+			continue
+		}
+		var vals []int
+		if v, ok := r.lists[key]; ok {
+			vals = v
+		}
+		out[key] = vals
+	}
+	out["UNTIL"] = r.until
+	return out
+}
+
+func sameFields(a, b map[string]any) string {
+	for k, av := range a {
+		bv := b[k]
+		if fmt.Sprint(av) != fmt.Sprint(bv) {
+			return fmt.Sprintf("%s: %v, want %v", k, bv, av)
+		}
+	}
+	return ""
+}
+
+// TestHegelRecurrenceRulesFollowTheModel: an RRULE value with the parts in any order parses to
+// its fields (INTERVAL defaulting to 1, "+" ordinals absorbed), String() gives the canonical
+// form and re-parses to the same fields, and icalendar's vRecur agrees on every part.
+func TestHegelRecurrenceRulesFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		r := genRule(ht)
+		text := r.text()
+		got, err := ics.ParseRecurrenceRule(text)
+		switch {
+		case r.lower && Known.caseSensitiveNames:
+			c.count("lowercase-gated")
+			return
+		case r.outRange:
+			if Known.recurRangesUnchecked {
+				c.count("range-gated")
+				return
+			}
+			if err == nil {
+				c.fail(ht, "ParseRecurrenceRule(%q) accepts a value out of range", text)
+			}
+			return
+		}
+		if err != nil {
+			c.fail(ht, "ParseRecurrenceRule(%q): %v", text, err)
+			return
+		}
+		c.count("ok")
+		floating := r.until != "" && strings.Contains(r.until, "T") && !strings.HasSuffix(r.until, "Z")
+		wantF, gotF := r.fields(), ruleFields(got)
+		if floating && Known.floatingUntilGetsZ {
+			delete(wantF, "UNTIL")
+			delete(gotF, "UNTIL")
+		}
+		if d := sameFields(wantF, gotF); d != "" {
+			c.fail(ht, "ParseRecurrenceRule(%q): %s", text, d)
+			return
+		}
+		s := got.String()
+		if floating && Known.floatingUntilGetsZ {
+			c.count("floating-until-gated")
+		} else {
+			if s != r.canonical() {
+				c.fail(ht, "String() of %q = %q, want %q", text, s, r.canonical())
+				return
+			}
+			again, err := ics.ParseRecurrenceRule(s)
+			if err != nil {
+				c.fail(ht, "String() of %q = %q does not parse: %v", text, s, err)
+				return
+			}
+			if d := sameFields(ruleFields(got), ruleFields(again)); d != "" {
+				c.fail(ht, "String() of %q = %q re-parses differently: %s", text, s, d)
+				return
+			}
+		}
+		// icalendar
+		py, perr := pyRecur(ht, text)
+		if perr != "" {
+			c.fail(ht, "icalendar rejects %q: %s", text, perr)
+			return
+		}
+		want := map[string][]string{"FREQ": {r.freq}}
+		if r.until != "" {
+			want["UNTIL"] = []string{r.until}
+		}
+		if r.count != 0 {
+			want["COUNT"] = []string{strconv.Itoa(r.count)}
+		}
+		if r.interval != 0 {
+			want["INTERVAL"] = []string{strconv.Itoa(r.interval)}
+		}
+		if len(r.byday) > 0 {
+			want["BYDAY"] = r.byday
+		}
+		for k, vals := range r.lists {
+			strs := make([]string, len(vals))
+			for i, v := range vals {
+				strs[i] = strconv.Itoa(v)
+			}
+			want[k] = strs
+		}
+		if r.wkst != "" {
+			want["WKST"] = []string{r.wkst}
+		}
+		if !reflect.DeepEqual(py, want) {
+			c.fail(ht, "icalendar reads %q as %v, the model %v", text, py, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- time getters
+
+var zones = []string{"Europe/Paris", "America/New_York", "Asia/Tokyo", "UTC", "Australia/Lord_Howe", "Asia/Kolkata"}
+
+type mtime struct {
+	value string // the property value
+	kind  string // date, local, utc, bad
+	tzid  string // TZID parameter, "" none
+	date  bool   // VALUE=DATE parameter
+	y, mo, d, h, mi, s int
+}
+
+func genTime(tc hegel.TestCase) mtime {
+	t := mtime{y: n(tc, 1970, 2100), mo: n(tc, 1, 12), d: n(tc, 1, 28), h: n(tc, 0, 23), mi: n(tc, 0, 59), s: n(tc, 0, 59)}
+	switch n(tc, 1, 10) {
+	case 1, 2, 3:
+		t.kind = "date"
+		t.value = fmt.Sprintf("%04d%02d%02d", t.y, t.mo, t.d)
+		t.date = chance(tc, 70)
+	case 4, 5, 6:
+		t.kind = "local"
+		t.value = fmt.Sprintf("%04d%02d%02dT%02d%02d%02d", t.y, t.mo, t.d, t.h, t.mi, t.s)
+	case 7, 8, 9:
+		t.kind = "utc"
+		t.value = fmt.Sprintf("%04d%02d%02dT%02d%02d%02dZ", t.y, t.mo, t.d, t.h, t.mi, t.s)
+	default:
+		t.kind = "bad"
+		t.value = pick(tc, []string{"20241301T120000Z", "20240101T240000Z", "2024-01-01", "20240101T1200", "20240230", "T120000Z", "20240101T120000ZZ", "", "20240101 T120000", "20240101T120060Z"})
+	}
+	if chance(tc, 35) {
+		t.tzid = pick(tc, zones)
+		if chance(tc, 15) {
+			t.tzid = "Mars/Olympus"
+		}
+	}
+	return t
+}
+
+// expected: the time the model reads (RFC 5545 3.3.4/3.3.5 as golang-ical resolves zones), or
+// !ok for an error.
+func (t mtime) expected() (time.Time, bool) {
+	if t.kind == "bad" {
+		return time.Time{}, false
+	}
+	loc := time.Local
+	if t.tzid != "" {
+		l, err := time.LoadLocation(t.tzid)
+		if err != nil {
+			return time.Time{}, false
+		}
+		loc = l
+	}
+	switch t.kind {
+	case "date":
+		return time.Date(t.y, time.Month(t.mo), t.d, 0, 0, 0, 0, loc), true
+	case "local":
+		return time.Date(t.y, time.Month(t.mo), t.d, t.h, t.mi, t.s, 0, loc), true
+	}
+	return time.Date(t.y, time.Month(t.mo), t.d, t.h, t.mi, t.s, 0, time.UTC), true
+}
+
+func (t mtime) params() []ics.PropertyParameter {
+	var ps []ics.PropertyParameter
+	if t.tzid != "" {
+		ps = append(ps, ics.WithTZID(t.tzid))
+	}
+	if t.date {
+		ps = append(ps, ics.WithValue("DATE"))
+	}
+	return ps
+}
+
+func sameTime(a, b time.Time) bool {
+	return a.Equal(b) && a.Location().String() == b.Location().String()
+}
+
+// TestHegelTimesFollowTheModel: DTSTART/DTEND/DUE/DTSTAMP/RECURRENCE-ID values in the DATE,
+// floating DATE-TIME and UTC forms, with or without TZID, read through the getters as the
+// model's instant in the model's zone (or fail for malformed values and unknown zones); EXDATE
+// and RDATE lists likewise; icalendar's vDDDTypes agrees on the wall clock and zone.
+func TestHegelTimesFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mt := genTime(ht)
+		c.count(mt.kind)
+		want, ok := mt.expected()
+
+		ev := ics.NewEvent("u")
+		td := ics.NewTodo("u")
+		prop := pick(ht, []string{"DTSTART", "DTEND", "DUE", "DTSTAMP", "RECURRENCE-ID"})
+		var got time.Time
+		var err error
+		switch prop {
+		case "DTSTART":
+			ev.SetProperty(ics.ComponentPropertyDtStart, mt.value, mt.params()...)
+			got, err = ev.GetStartAt()
+		case "DTEND":
+			ev.SetProperty(ics.ComponentPropertyDtEnd, mt.value, mt.params()...)
+			got, err = ev.GetEndAt()
+		case "DUE":
+			td.SetProperty(ics.ComponentPropertyDue, mt.value, mt.params()...)
+			got, err = td.GetDueAt()
+		case "DTSTAMP":
+			ev.SetProperty(ics.ComponentPropertyDtstamp, mt.value, mt.params()...)
+			got, err = ev.GetDtStampTime()
+		case "RECURRENCE-ID":
+			ev.SetProperty(ics.ComponentPropertyRecurrenceId, mt.value, mt.params()...)
+			got, err = ev.GetRecurrenceID()
+		}
+		if !ok {
+			if err == nil {
+				c.fail(ht, "%s:%s (TZID %q): %v, want an error", prop, mt.value, mt.tzid, got)
+			}
+			return
+		}
+		if err != nil {
+			c.fail(ht, "%s:%s (TZID %q): %v", prop, mt.value, mt.tzid, err)
+			return
+		}
+		if !sameTime(want, got) {
+			c.fail(ht, "%s:%s (TZID %q, VALUE=DATE %v): %v in %s, want %v in %s", prop, mt.value, mt.tzid, mt.date, got, got.Location(), want, want.Location())
+			return
+		}
+		// the all-day getters on a DATE value
+		if mt.kind == "date" && prop == "DTSTART" {
+			ad, err := ev.GetAllDayStartAt()
+			if err != nil || !sameTime(want, ad) {
+				c.fail(ht, "GetAllDayStartAt of %s: %v %v, want %v", mt.value, ad, err, want)
+				return
+			}
+		}
+		// lists
+		k := n(ht, 1, 3)
+		vals := []string{mt.value}
+		wants := []time.Time{want}
+		for i := 1; i < k; i++ {
+			other := mt
+			other.d = n(ht, 1, 28)
+			switch mt.kind {
+			case "date":
+				other.value = fmt.Sprintf("%04d%02d%02d", other.y, other.mo, other.d)
+			case "local":
+				other.value = fmt.Sprintf("%04d%02d%02dT%02d%02d%02d", other.y, other.mo, other.d, other.h, other.mi, other.s)
+			default:
+				other.value = fmt.Sprintf("%04d%02d%02dT%02d%02d%02dZ", other.y, other.mo, other.d, other.h, other.mi, other.s)
+			}
+			w, _ := other.expected()
+			vals = append(vals, other.value)
+			wants = append(wants, w)
+		}
+		ev.AddExdate(strings.Join(vals, ","), mt.params()...)
+		ev.AddRdate(vals[0], mt.params()...)
+		if k > 1 {
+			ev.AddRdate(strings.Join(vals[1:], ","), mt.params()...)
+		}
+		ex, err := ev.GetExDates()
+		if err != nil || len(ex) != k {
+			c.fail(ht, "GetExDates of %q: %v %v", vals, ex, err)
+			return
+		}
+		rd, err := ev.GetRDates()
+		if err != nil || len(rd) != k {
+			c.fail(ht, "GetRDates of %q: %v %v", vals, rd, err)
+			return
+		}
+		for i := range wants {
+			if !sameTime(wants[i], ex[i]) || !sameTime(wants[i], rd[i]) {
+				c.fail(ht, "EXDATE/RDATE %q item %d: %v / %v, want %v", vals, i, ex[i], rd[i], wants[i])
+				return
+			}
+		}
+		// icalendar
+		if mt.kind == "utc" && mt.tzid != "" {
+			return // a UTC value with a TZID parameter: icalendar converts, golang-ical ignores the zone
+		}
+		pyTZ := mt.tzid
+		if mt.kind == "date" {
+			pyTZ = "" // icalendar applies a TZID to a DATE (making a datetime); the RFC forbids the parameter there
+		}
+		kind, wall, tz, perr := pyDateTime(ht, mt.value, pyTZ)
+		if perr != "" {
+			c.fail(ht, "icalendar rejects %s (TZID %q): %s", mt.value, mt.tzid, perr)
+			return
+		}
+		wantKind, wantWall, wantTZ := "datetime", want.Format("20060102T150405"), ""
+		switch {
+		case mt.kind == "date":
+			wantKind, wantWall = "date", want.Format("20060102")
+		case mt.kind == "utc":
+			wantTZ = "UTC"
+		case mt.tzid != "":
+			wantTZ = mt.tzid
+		}
+		if kind != wantKind || wall != wantWall || (wantTZ != "" && tz != wantTZ) || (wantTZ == "" && mt.kind != "date" && tz != "") {
+			c.fail(ht, "icalendar reads %s (TZID %q) as %s %s %q, want %s %s %q", mt.value, mt.tzid, kind, wall, tz, wantKind, wantWall, wantTZ)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the property API
+
+var editNames = []string{"SUMMARY", "COMMENT", "X-A", "CATEGORIES"}
+var editValues = []string{"a", "b", "c", ""}
+
+// TestHegelPropertyEditsFollowTheModel: AddProperty appends, SetProperty replaces the first
+// match or appends, ReplaceProperty removes all matches and appends (returning the removed),
+// RemoveProperty removes all matches (returning them), RemovePropertyByValue removes the
+// matches with that value; GetProperty is the first match, GetProperties all, HasProperty any.
+func TestHegelPropertyEditsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ev := ics.NewEvent("u")
+		model := []mprop{{name: "UID", value: "u"}}
+		check := func(step string) bool {
+			got := propsOf(ev.Properties)
+			if !reflect.DeepEqual(got, model) {
+				c.fail(ht, "after %s:\n got  %v\n want %v", step, got, model)
+				return false
+			}
+			for _, name := range editNames {
+				var wantAll []mprop
+				for _, p := range model {
+					if p.name == name {
+						wantAll = append(wantAll, p)
+					}
+				}
+				all := ev.GetProperties(ics.ComponentProperty(name))
+				if len(all) != len(wantAll) {
+					c.fail(ht, "after %s: GetProperties(%s) has %d, want %d", step, name, len(all), len(wantAll))
+					return false
+				}
+				first := ev.GetProperty(ics.ComponentProperty(name))
+				if (first == nil) != (len(wantAll) == 0) || (first != nil && !reflect.DeepEqual(propOf(first.BaseProperty), wantAll[0])) {
+					c.fail(ht, "after %s: GetProperty(%s) = %v, want %v", step, name, first, wantAll)
+					return false
+				}
+				if ev.HasProperty(ics.ComponentProperty(name)) != (len(wantAll) > 0) {
+					c.fail(ht, "after %s: HasProperty(%s) wrong", step, name)
+					return false
+				}
+			}
+			return true
+		}
+		for step := n(ht, 1, 12); step > 0; step-- {
+			name := pick(ht, editNames)
+			value := pick(ht, editValues)
+			cp := ics.ComponentProperty(name)
+			var params []ics.PropertyParameter
+			var mps []mparam
+			if chance(ht, 30) {
+				params = []ics.PropertyParameter{ics.WithCN("x")}
+				mps = []mparam{{"CN", []string{"x"}}}
+			}
+			np := mprop{name: name, value: value, params: mps}
+			op := n(ht, 1, 6)
+			desc := ""
+			switch op {
+			case 1:
+				ev.AddProperty(cp, value, params...)
+				model = append(model, np)
+				desc = "AddProperty"
+			case 2:
+				ev.SetProperty(cp, value, params...)
+				replaced := false
+				for i := range model {
+					if model[i].name == name {
+						model[i] = np
+						replaced = true
+						break
+					}
+				}
+				if !replaced {
+					model = append(model, np)
+				}
+				desc = "SetProperty"
+			case 3:
+				removed := ev.ReplaceProperty(cp, value, params...)
+				var kept, gone []mprop
+				for _, p := range model {
+					if p.name == name {
+						gone = append(gone, p)
+					} else {
+						kept = append(kept, p)
+					}
+				}
+				model = append(kept, np)
+				if !reflect.DeepEqual(propsOf(removed), gone) && !(len(removed) == 0 && len(gone) == 0) {
+					c.fail(ht, "ReplaceProperty(%s) removed %v, want %v", name, propsOf(removed), gone)
+					return
+				}
+				desc = "ReplaceProperty"
+			case 4:
+				removed := ev.RemoveProperty(cp)
+				var kept, gone []mprop
+				for _, p := range model {
+					if p.name == name {
+						gone = append(gone, p)
+					} else {
+						kept = append(kept, p)
+					}
+				}
+				model = kept
+				if !reflect.DeepEqual(propsOf(removed), gone) && !(len(removed) == 0 && len(gone) == 0) {
+					c.fail(ht, "RemoveProperty(%s) removed %v, want %v", name, propsOf(removed), gone)
+					return
+				}
+				desc = "RemoveProperty"
+			case 5:
+				if Known.removeByValueInverted {
+					c.count("remove-by-value-gated")
+					continue
+				}
+				removed := ev.RemovePropertyByValue(cp, value)
+				var kept, gone []mprop
+				for _, p := range model {
+					if p.name == name && p.value == value {
+						gone = append(gone, p)
+					} else {
+						kept = append(kept, p)
+					}
+				}
+				model = kept
+				if !reflect.DeepEqual(propsOf(removed), gone) && !(len(removed) == 0 && len(gone) == 0) {
+					c.fail(ht, "RemovePropertyByValue(%s, %q) removed %v, want %v", name, value, propsOf(removed), gone)
+					return
+				}
+				desc = "RemovePropertyByValue"
+			case 6:
+				switch name {
+				case "SUMMARY":
+					ev.SetSummary(value, params...)
+				case "COMMENT":
+					ev.AddComment(value, params...)
+					model = append(model, np)
+					desc = "AddComment"
+				case "CATEGORIES":
+					ev.AddCategory(value, params...)
+					model = append(model, np)
+					desc = "AddCategory"
+				default:
+					ev.SetProperty(cp, value, params...)
+				}
+				if desc == "" {
+					replaced := false
+					for i := range model {
+						if model[i].name == name {
+							model[i] = np
+							replaced = true
+							break
+						}
+					}
+					if !replaced {
+						model = append(model, np)
+					}
+					desc = "SetSummary/SetProperty"
+				}
+			}
+			c.count(desc)
+			if !check(desc) {
+				return
+			}
+		}
+		// The edited component serializes and reads back.
+		cal, _ := ics.NewCalendarWithOptions()
+		cal.AddVEvent(ev)
+		back, err := ics.ParseCalendar(strings.NewReader(cal.Serialize()))
+		if err != nil {
+			c.fail(ht, "ParseCalendar after edits: %v", err)
+			return
+		}
+		if got := propsOf(back.Events()[0].Properties); !reflect.DeepEqual(got, model) {
+			c.fail(ht, "after edits, read back:\n got  %v\n want %v", got, model)
+		}
+	})
+}
