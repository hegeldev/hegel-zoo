+package ics_test
+
+// Recurrence rules, time getters and the property API against the model and icalendar.
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	ics "github.com/arran4/golang-ical"
+)
+
+// --------------------------------------------------------------------------- recurrence rules
+
+// mrule is a recurrence rule as drawn: its parts and the order they are written in.
+type mrule struct {
+	freq     string
+	until    string // raw value, "" when absent
+	count    *int   // nil when absent
+	interval *int   // nil when absent
+	lists    map[string][]int
+	byday    []string
+	wkst     string
+	order    []int // a sort key per part after FREQ, recycled; none: the canonical order
+	lower    bool  // written in lower case
+}
+
+var listRanges = map[string][2]int{
+	"BYSECOND": {0, 60}, "BYMINUTE": {0, 59}, "BYHOUR": {0, 23},
+	"BYMONTHDAY": {1, 31}, "BYYEARDAY": {1, 366}, "BYWEEKNO": {1, 53}, "BYMONTH": {1, 12}, "BYSETPOS": {1, 366},
+}
+var signedLists = map[string]bool{"BYMONTHDAY": true, "BYYEARDAY": true, "BYWEEKNO": true, "BYSETPOS": true}
+var listOrder = []string{"BYSECOND", "BYMINUTE", "BYHOUR", "BYDAY", "BYMONTHDAY", "BYYEARDAY", "BYWEEKNO", "BYMONTH", "BYSETPOS"}
+var weekdays = []string{"SU", "MO", "TU", "WE", "TH", "FR", "SA"}
+var freqs = []string{"SECONDLY", "MINUTELY", "HOURLY", "DAILY", "WEEKLY", "MONTHLY", "YEARLY"}
+
+// inRange reports whether a value of the list is within the RFC's range (signed lists take
+// either sign).
+func inRange(key string, v int) bool {
+	rg := listRanges[key]
+	if signedLists[key] && v < 0 {
+		v = -v
+	}
+	return v >= rg[0] && v <= rg[1]
+}
+
+// outOrIn: a value from in, or pct percent of the time one of the out-of-range values (the
+// shape of golang-ical/13; never under HEGEL_NO_KNOWN=1).
+func outOrIn(in hegel.Generator[int], out []int, pct int) hegel.Generator[int] {
+	if Known.recurRangesUnchecked {
+		return in
+	}
+	return weighted(choice[int]{100 - pct, in}, choice[int]{pct, hegel.SampledFrom(out)})
+}
+
+// limit: the rule's UNTIL or COUNT, or neither.
+type limit struct {
+	until string
+	count *int
+}
+
+var (
+	// untils: a DATE, a UTC DATE-TIME and a floating DATE-TIME (the shape of golang-ical/12;
+	// never under HEGEL_NO_KNOWN=1).
+	untils = func() hegel.Generator[string] {
+		pool := []string{"20240101", "20241231T235959Z", "19700101T000000Z"}
+		if !Known.floatingUntilGetsZ {
+			pool = append(pool, "20240601T120000")
+		}
+		return hegel.SampledFrom(pool)
+	}()
+	// counts: 1 to 100, or once in twenty-five 0 or -1.
+	counts = outOrIn(hegel.Integers(1, 100), []int{0, -1}, 4)
+	// intervals: 1 to 50, or once in twenty-five 0 or -2.
+	intervals = outOrIn(hegel.Integers(1, 50), []int{0, -2}, 4)
+	// limits: neither half of the time, UNTIL or COUNT a quarter each.
+	limits = weighted(
+		choice[limit]{50, hegel.Just(limit{})},
+		choice[limit]{25, hegel.Map(untils, func(u string) limit { return limit{until: u} })},
+		choice[limit]{25, hegel.Map(counts, func(n int) limit { return limit{count: ptrTo(n)} })},
+	)
+	// ordinals: a BYDAY ordinal: none most of the time, else 1 to 5 with no sign, a minus or
+	// (rarely) a plus.
+	ordinals = weighted(
+		choice[string]{43, hegel.Just("")},
+		choice[string]{25, dec(hegel.Integers(1, 5))},
+		choice[string]{25, cat(hegel.Just("-"), dec(hegel.Integers(1, 5)))},
+		choice[string]{7, cat(hegel.Just("+"), dec(hegel.Integers(1, 5)))},
+	)
+	// bydays: one to three weekdays with ordinals.
+	bydays = many(cat(ordinals, hegel.SampledFrom(weekdays)), 1, 3)
+	// listValues: one to three values of each BY list within its range (negated three times in
+	// ten for the signed lists), each out of range three times in a hundred.
+	listValues = func() map[string]hegel.Generator[[]int] {
+		m := map[string]hegel.Generator[[]int]{}
+		for key, rg := range listRanges {
+			in := hegel.Integers(rg[0], rg[1])
+			if signedLists[key] {
+				in = hegel.Map(pairs(in, chance(30)), func(p pair[int, bool]) int {
+					if p.b {
+						return -p.a
+					}
+					return p.a
+				})
+			}
+			m[key] = many(outOrIn(in, []int{rg[1] + 1, rg[0] - 1, 999}, 3), 1, 3)
+		}
+		return m
+	}()
+	// rules: FREQ, a limit, INTERVAL half of the time, each BY list a quarter of the time, WKST
+	// three times in ten, the parts after FREQ in a drawn order half of the time, lower case
+	// once in twenty.
+	rules = hegel.Composite(func(tc hegel.TestCase) mrule {
+		r := mrule{freq: hegel.Draw(tc, hegel.SampledFrom(freqs)), lists: map[string][]int{}}
+		l := hegel.Draw(tc, limits)
+		r.until, r.count = l.until, l.count
+		r.interval = hegel.Draw(tc, optional(50, intervals))
+		for _, key := range listOrder {
+			if key == "BYDAY" {
+				r.byday = hegel.Draw(tc, maybe(25, bydays))
+				continue
+			}
+			if vals := hegel.Draw(tc, maybe(25, listValues[key])); vals != nil {
+				r.lists[key] = vals
+			}
+		}
+		r.wkst = hegel.Draw(tc, maybe(30, hegel.SampledFrom(weekdays)))
+		r.order = hegel.Draw(tc, maybe(50, many(hegel.Integers(0, 99), 1, 12)))
+		r.lower = hegel.Draw(tc, lowercases)
+		return r
+	})
+)
+
+func joinInts(vals []int) string {
+	strs := make([]string, len(vals))
+	for i, v := range vals {
+		strs[i] = strconv.Itoa(v)
+	}
+	return strings.Join(strs, ",")
+}
+
+// outRange reports a value outside the RFC's range (INTERVAL and COUNT positive, the BY lists
+// within their bounds).
+func (r mrule) outRange() bool {
+	if (r.count != nil && *r.count <= 0) || (r.interval != nil && *r.interval <= 0) {
+		return true
+	}
+	for key, vals := range r.lists {
+		for _, v := range vals {
+			if !inRange(key, v) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// floating reports a floating (local) DATE-TIME UNTIL.
+func (r mrule) floating() bool {
+	return r.until != "" && strings.Contains(r.until, "T") && !strings.HasSuffix(r.until, "Z")
+}
+
+// parts: the parts as written: FREQ first, then the rest in the canonical order sorted by the
+// drawn keys (a stable sort, so equal keys keep the canonical order).
+func (r mrule) parts() []string {
+	parts := []string{"FREQ=" + r.freq}
+	if r.until != "" {
+		parts = append(parts, "UNTIL="+r.until)
+	}
+	if r.count != nil {
+		parts = append(parts, "COUNT="+strconv.Itoa(*r.count))
+	}
+	if r.interval != nil {
+		parts = append(parts, "INTERVAL="+strconv.Itoa(*r.interval))
+	}
+	for _, key := range listOrder {
+		if key == "BYDAY" {
+			if len(r.byday) > 0 {
+				parts = append(parts, "BYDAY="+strings.Join(r.byday, ","))
+			}
+			continue
+		}
+		if vals, ok := r.lists[key]; ok {
+			parts = append(parts, key+"="+joinInts(vals))
+		}
+	}
+	if r.wkst != "" {
+		parts = append(parts, "WKST="+r.wkst)
+	}
+	if len(r.order) > 0 {
+		rest := parts[1:]
+		keys := make([]int, len(rest))
+		for i := range rest {
+			keys[i] = r.order[i%len(r.order)]
+		}
+		idx := make([]int, len(rest))
+		for i := range idx {
+			idx[i] = i
+		}
+		sort.SliceStable(idx, func(a, b int) bool { return keys[idx[a]] < keys[idx[b]] })
+		sorted := make([]string, len(rest))
+		for i, j := range idx {
+			sorted[i] = rest[j]
+		}
+		copy(rest, sorted)
+	}
+	return parts
+}
+
+func (r mrule) text() string {
+	s := strings.Join(r.parts(), ";")
+	if r.lower {
+		s = strings.ToLower(s)
+	}
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (r mrule) GoString() string { return fmt.Sprintf("RRULE %q", r.text()) }
+
+// canonical: the String() form golang-ical documents (FREQ, UNTIL, COUNT, INTERVAL unless 1,
+// the BY lists in RFC order, WKST); "+" ordinals are written without the sign.
+func (r mrule) canonical() string {
+	parts := []string{"FREQ=" + r.freq}
+	if r.until != "" {
+		parts = append(parts, "UNTIL="+r.until)
+	}
+	if r.count != nil {
+		parts = append(parts, "COUNT="+strconv.Itoa(*r.count))
+	}
+	if r.interval != nil && *r.interval != 1 {
+		parts = append(parts, "INTERVAL="+strconv.Itoa(*r.interval))
+	}
+	for _, key := range listOrder {
+		if key == "BYDAY" {
+			if len(r.byday) > 0 {
+				ds := make([]string, len(r.byday))
+				for i, d := range r.byday {
+					ds[i] = strings.TrimPrefix(d, "+")
+				}
+				parts = append(parts, "BYDAY="+strings.Join(ds, ","))
+			}
+			continue
+		}
+		if vals, ok := r.lists[key]; ok {
+			parts = append(parts, key+"="+joinInts(vals))
+		}
+	}
+	if r.wkst != "" {
+		parts = append(parts, "WKST="+r.wkst)
+	}
+	return strings.Join(parts, ";")
+}
+
+func ruleFields(g *ics.RecurrenceRule) map[string]any {
+	out := map[string]any{"FREQ": string(g.Freq), "COUNT": g.Count, "INTERVAL": g.Interval, "WKST": string(g.Wkst)}
+	var days []string
+	for _, d := range g.ByDay {
+		days = append(days, d.String())
+	}
+	out["BYDAY"] = days
+	out["BYSECOND"], out["BYMINUTE"], out["BYHOUR"] = g.BySecond, g.ByMinute, g.ByHour
+	out["BYMONTHDAY"], out["BYYEARDAY"], out["BYWEEKNO"], out["BYMONTH"], out["BYSETPOS"] = g.ByMonthDay, g.ByYearDay, g.ByWeekNo, g.ByMonth, g.BySetPos
+	if g.Until.IsZero() {
+		out["UNTIL"] = ""
+	} else if g.UntilDateOnly {
+		out["UNTIL"] = g.Until.Format("20060102")
+	} else {
+		out["UNTIL"] = g.Until.Format("20060102T150405") + map[bool]string{true: "Z", false: ""}[g.Until.Location() == time.UTC]
+	}
+	return out
+}
+
+// fields: the modelled fields (INTERVAL defaulting to 1, "+" ordinals absorbed).
+func (r mrule) fields() map[string]any {
+	out := map[string]any{"FREQ": r.freq, "COUNT": 0, "INTERVAL": 1, "WKST": r.wkst}
+	if r.count != nil {
+		out["COUNT"] = *r.count
+	}
+	if r.interval != nil {
+		out["INTERVAL"] = *r.interval
+	}
+	var days []string
+	for _, d := range r.byday {
+		days = append(days, strings.TrimPrefix(d, "+"))
+	}
+	out["BYDAY"] = days
+	for _, key := range listOrder {
+		if key == "BYDAY" {
+			continue
+		}
+		var vals []int
+		if v, ok := r.lists[key]; ok {
+			vals = v
+		}
+		out[key] = vals
+	}
+	out["UNTIL"] = r.until
+	return out
+}
+
+// pyFields: the parts as icalendar's vRecur reports them (every value a string, INTERVAL only
+// when written).
+func (r mrule) pyFields() map[string][]string {
+	want := map[string][]string{"FREQ": {r.freq}}
+	if r.until != "" {
+		want["UNTIL"] = []string{r.until}
+	}
+	if r.count != nil {
+		want["COUNT"] = []string{strconv.Itoa(*r.count)}
+	}
+	if r.interval != nil {
+		want["INTERVAL"] = []string{strconv.Itoa(*r.interval)}
+	}
+	if len(r.byday) > 0 {
+		want["BYDAY"] = r.byday
+	}
+	for k, vals := range r.lists {
+		want[k] = strings.Split(joinInts(vals), ",")
+	}
+	if r.wkst != "" {
+		want["WKST"] = []string{r.wkst}
+	}
+	return want
+}
+
+func sameFields(a, b map[string]any) string {
+	for k, av := range a {
+		bv := b[k]
+		if fmt.Sprint(av) != fmt.Sprint(bv) {
+			return fmt.Sprintf("%s: %v, want %v", k, bv, av)
+		}
+	}
+	return ""
+}
+
+// TestHegelRecurrenceRulesFollowTheModel: an RRULE value with the parts in any order parses to
+// its fields (INTERVAL defaulting to 1, "+" ordinals absorbed), String() gives the canonical
+// form and re-parses to the same fields, and icalendar's vRecur agrees on every part. Values
+// out of the RFC's ranges must be rejected (golang-ical/13), a lower-case rule read
+// (golang-ical/8) and a floating UNTIL kept floating by String() (golang-ical/12): the three
+// shapes are drawn at their natural rates, and never under HEGEL_NO_KNOWN=1.
+func TestHegelRecurrenceRulesFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		r := hegel.Draw(ht, rules)
+		text := r.text()
+		got, err := ics.ParseRecurrenceRule(text)
+		if r.outRange() {
+			c.count("out-of-range")
+			if err == nil {
+				c.mismatch(ht, "golang-ical/13", "ParseRecurrenceRule(%q) accepts a value out of range", text)
+			}
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, shapeIf(r.lower, "golang-ical/8"), "ParseRecurrenceRule(%q): %v", text, err)
+			return
+		}
+		c.count("ok")
+		floating := shapeIf(r.floating(), "golang-ical/12")
+		if d := sameFields(r.fields(), ruleFields(got)); d != "" {
+			c.mismatch(ht, shapeIf(strings.HasPrefix(d, "UNTIL"), floating), "ParseRecurrenceRule(%q): %s", text, d)
+			return
+		}
+		s := got.String()
+		if s != r.canonical() {
+			c.mismatch(ht, floating, "String() of %q = %q, want %q", text, s, r.canonical())
+			return
+		}
+		again, err := ics.ParseRecurrenceRule(s)
+		if err != nil {
+			c.mismatch(ht, floating, "String() of %q = %q does not parse: %v", text, s, err)
+			return
+		}
+		if d := sameFields(ruleFields(got), ruleFields(again)); d != "" {
+			c.mismatch(ht, floating, "String() of %q = %q re-parses differently: %s", text, s, d)
+			return
+		}
+		// icalendar
+		py, perr := pyRecur(ht, text)
+		if perr != "" {
+			c.fail(ht, "icalendar rejects %q: %s", text, perr)
+			return
+		}
+		if want := r.pyFields(); !reflect.DeepEqual(py, want) {
+			c.fail(ht, "icalendar reads %q as %v, the model %v", text, py, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- time getters
+
+var zones = []string{"Europe/Paris", "America/New_York", "Asia/Tokyo", "UTC", "Australia/Lord_Howe", "Asia/Kolkata"}
+
+// mtime is a time value as drawn: its kind (date, local, utc or bad), its fields, the malformed
+// text of a bad one, and its parameters.
+type mtime struct {
+	kind               string
+	y, mo, d, h, mi, s int
+	bad                string // the value of a bad one
+	tzid               string // TZID parameter, "" none
+	date               bool   // VALUE=DATE parameter
+}
+
+// value is the property value.
+func (t mtime) value() string {
+	switch t.kind {
+	case "date":
+		return fmt.Sprintf("%04d%02d%02d", t.y, t.mo, t.d)
+	case "local":
+		return fmt.Sprintf("%04d%02d%02dT%02d%02d%02d", t.y, t.mo, t.d, t.h, t.mi, t.s)
+	case "utc":
+		return fmt.Sprintf("%04d%02d%02dT%02d%02d%02dZ", t.y, t.mo, t.d, t.h, t.mi, t.s)
+	}
+	return t.bad
+}
+
+// onDay is the same value on another day of the month.
+func (t mtime) onDay(d int) mtime {
+	t.d = d
+	return t
+}
+
+var (
+	badTimes = hegel.SampledFrom([]string{"20241301T120000Z", "20240101T240000Z", "2024-01-01", "20240101T1200", "20240230", "T120000Z", "20240101T120000ZZ", "", "20240101 T120000", "20240101T120060Z"})
+	// timeKinds: a DATE, a floating DATE-TIME and a UTC DATE-TIME three times in ten each, a
+	// malformed value once.
+	timeKinds = hegel.SampledFrom([]string{"date", "date", "date", "local", "local", "local", "utc", "utc", "utc", "bad"})
+	// tzidParams: a TZID parameter 35% of the time: one of the zones, or once in seven an
+	// unknown one.
+	tzidParams = maybe(35, weighted(choice[string]{85, hegel.SampledFrom(zones)}, choice[string]{15, hegel.Just("Mars/Olympus")}))
+	// mtimesOf: a time of the kind; a DATE carries VALUE=DATE seven times in ten.
+	mtimesOf = func() map[string]hegel.Generator[mtime] {
+		m := map[string]hegel.Generator[mtime]{}
+		for _, kind := range []string{"date", "local", "utc", "bad"} {
+			kind := kind
+			bads, dated := hegel.Just(""), hegel.Just(false)
+			if kind == "bad" {
+				bads = badTimes
+			}
+			if kind == "date" {
+				dated = chance(70)
+			}
+			m[kind] = hegel.Composite(func(tc hegel.TestCase) mtime {
+				return mtime{
+					kind: kind,
+					y:    hegel.Draw(tc, hegel.Integers(1970, 2100)),
+					mo:   hegel.Draw(tc, hegel.Integers(1, 12)),
+					d:    hegel.Draw(tc, hegel.Integers(1, 28)),
+					h:    hegel.Draw(tc, hegel.Integers(0, 23)),
+					mi:   hegel.Draw(tc, hegel.Integers(0, 59)),
+					s:    hegel.Draw(tc, hegel.Integers(0, 59)),
+					bad:  hegel.Draw(tc, bads),
+					tzid: hegel.Draw(tc, tzidParams),
+					date: hegel.Draw(tc, dated),
+				}
+			})
+		}
+		return m
+	}()
+	mtimes    = hegel.FlatMap(timeKinds, func(kind string) hegel.Generator[mtime] { return mtimesOf[kind] })
+	timeProps = []string{"DTSTART", "DTEND", "DUE", "DTSTAMP", "RECURRENCE-ID"}
+)
+
+// timeCase: a time value, the property it is set on, and the days of up to two more values
+// beside it in the EXDATE and RDATE lists.
+type timeCase struct {
+	mt     mtime
+	prop   string
+	others []int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c timeCase) GoString() string {
+	return fmt.Sprintf("%s:%s TZID=%q VALUE=DATE=%v, other days %v", c.prop, c.mt.value(), c.mt.tzid, c.mt.date, c.others)
+}
+
+var timeCases = hegel.Composite(func(tc hegel.TestCase) timeCase {
+	return timeCase{mt: hegel.Draw(tc, mtimes), prop: hegel.Draw(tc, hegel.SampledFrom(timeProps)), others: hegel.Draw(tc, hegel.Lists(hegel.Integers(1, 28)).MaxSize(2))}
+})
+
+// expected: the time the model reads (RFC 5545 3.3.4/3.3.5 as golang-ical resolves zones), or
+// !ok for an error.
+func (t mtime) expected() (time.Time, bool) {
+	if t.kind == "bad" {
+		return time.Time{}, false
+	}
+	loc := time.Local
+	if t.tzid != "" {
+		l, err := time.LoadLocation(t.tzid)
+		if err != nil {
+			return time.Time{}, false
+		}
+		loc = l
+	}
+	switch t.kind {
+	case "date":
+		return time.Date(t.y, time.Month(t.mo), t.d, 0, 0, 0, 0, loc), true
+	case "local":
+		return time.Date(t.y, time.Month(t.mo), t.d, t.h, t.mi, t.s, 0, loc), true
+	}
+	return time.Date(t.y, time.Month(t.mo), t.d, t.h, t.mi, t.s, 0, time.UTC), true
+}
+
+func (t mtime) params() []ics.PropertyParameter {
+	var ps []ics.PropertyParameter
+	if t.tzid != "" {
+		ps = append(ps, ics.WithTZID(t.tzid))
+	}
+	if t.date {
+		ps = append(ps, ics.WithValue("DATE"))
+	}
+	return ps
+}
+
+func sameTime(a, b time.Time) bool {
+	return a.Equal(b) && a.Location().String() == b.Location().String()
+}
+
+// TestHegelTimesFollowTheModel: DTSTART/DTEND/DUE/DTSTAMP/RECURRENCE-ID values in the DATE,
+// floating DATE-TIME and UTC forms, with or without TZID, read through the getters as the
+// model's instant in the model's zone (or fail for malformed values and unknown zones); EXDATE
+// and RDATE lists likewise; icalendar's vDDDTypes agrees on the wall clock and zone.
+func TestHegelTimesFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, timeCases)
+		mt, prop := tcase.mt, tcase.prop
+		value := mt.value()
+		c.count(mt.kind)
+		want, ok := mt.expected()
+
+		ev := ics.NewEvent("u")
+		td := ics.NewTodo("u")
+		var got time.Time
+		var err error
+		switch prop {
+		case "DTSTART":
+			ev.SetProperty(ics.ComponentPropertyDtStart, value, mt.params()...)
+			got, err = ev.GetStartAt()
+		case "DTEND":
+			ev.SetProperty(ics.ComponentPropertyDtEnd, value, mt.params()...)
+			got, err = ev.GetEndAt()
+		case "DUE":
+			td.SetProperty(ics.ComponentPropertyDue, value, mt.params()...)
+			got, err = td.GetDueAt()
+		case "DTSTAMP":
+			ev.SetProperty(ics.ComponentPropertyDtstamp, value, mt.params()...)
+			got, err = ev.GetDtStampTime()
+		case "RECURRENCE-ID":
+			ev.SetProperty(ics.ComponentPropertyRecurrenceId, value, mt.params()...)
+			got, err = ev.GetRecurrenceID()
+		}
+		if !ok {
+			if err == nil {
+				c.fail(ht, "%s:%s (TZID %q): %v, want an error", prop, value, mt.tzid, got)
+			}
+			return
+		}
+		if err != nil {
+			c.fail(ht, "%s:%s (TZID %q): %v", prop, value, mt.tzid, err)
+			return
+		}
+		if !sameTime(want, got) {
+			c.fail(ht, "%s:%s (TZID %q, VALUE=DATE %v): %v in %s, want %v in %s", prop, value, mt.tzid, mt.date, got, got.Location(), want, want.Location())
+			return
+		}
+		// the all-day getters on a DATE value
+		if mt.kind == "date" && prop == "DTSTART" {
+			ad, err := ev.GetAllDayStartAt()
+			if err != nil || !sameTime(want, ad) {
+				c.fail(ht, "GetAllDayStartAt of %s: %v %v, want %v", value, ad, err, want)
+				return
+			}
+		}
+		// lists: the value and the same on the other days
+		vals := []string{value}
+		wants := []time.Time{want}
+		for _, d := range tcase.others {
+			other := mt.onDay(d)
+			w, _ := other.expected()
+			vals = append(vals, other.value())
+			wants = append(wants, w)
+		}
+		k := len(vals)
+		ev.AddExdate(strings.Join(vals, ","), mt.params()...)
+		ev.AddRdate(vals[0], mt.params()...)
+		if k > 1 {
+			ev.AddRdate(strings.Join(vals[1:], ","), mt.params()...)
+		}
+		ex, err := ev.GetExDates()
+		if err != nil || len(ex) != k {
+			c.fail(ht, "GetExDates of %q: %v %v", vals, ex, err)
+			return
+		}
+		rd, err := ev.GetRDates()
+		if err != nil || len(rd) != k {
+			c.fail(ht, "GetRDates of %q: %v %v", vals, rd, err)
+			return
+		}
+		for i := range wants {
+			if !sameTime(wants[i], ex[i]) || !sameTime(wants[i], rd[i]) {
+				c.fail(ht, "EXDATE/RDATE %q item %d: %v / %v, want %v", vals, i, ex[i], rd[i], wants[i])
+				return
+			}
+		}
+		// icalendar
+		if mt.kind == "utc" && mt.tzid != "" {
+			// a UTC value with a TZID parameter: icalendar converts, golang-ical ignores the zone
+			// (accepted difference; the golang-ical checks above have run)
+			c.count("utc-with-tzid-not-compared")
+			return
+		}
+		pyTZ := mt.tzid
+		if mt.kind == "date" {
+			pyTZ = "" // icalendar applies a TZID to a DATE (making a datetime); the RFC forbids the parameter there
+		}
+		kind, wall, tz, perr := pyDateTime(ht, value, pyTZ)
+		if perr != "" {
+			c.fail(ht, "icalendar rejects %s (TZID %q): %s", value, mt.tzid, perr)
+			return
+		}
+		wantKind, wantWall, wantTZ := "datetime", want.Format("20060102T150405"), ""
+		switch {
+		case mt.kind == "date":
+			wantKind, wantWall = "date", want.Format("20060102")
+		case mt.kind == "utc":
+			wantTZ = "UTC"
+		case mt.tzid != "":
+			wantTZ = mt.tzid
+		}
+		if kind != wantKind || wall != wantWall || (wantTZ != "" && tz != wantTZ) || (wantTZ == "" && mt.kind != "date" && tz != "") {
+			c.fail(ht, "icalendar reads %s (TZID %q) as %s %s %q, want %s %s %q", value, mt.tzid, kind, wall, tz, wantKind, wantWall, wantTZ)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the property API
+
+var editNames = []string{"SUMMARY", "COMMENT", "X-A", "CATEGORIES"}
+var editValues = []string{"a", "b", "c", ""}
+
+// editOps: the operations of an edit; RemovePropertyByValue is the shape of golang-ical/2 and
+// is left out under HEGEL_NO_KNOWN=1.
+var editOps = func() []string {
+	ops := []string{"AddProperty", "SetProperty", "ReplaceProperty", "RemoveProperty", "Setter"}
+	if !Known.removeByValueInverted {
+		ops = append(ops, "RemovePropertyByValue")
+	}
+	return ops
+}()
+
+// edit is one step of the property API: the operation, the property name and value it takes,
+// and whether it carries a CN parameter.
+type edit struct {
+	op    string
+	name  string
+	value string
+	cn    bool
+}
+
+var edits = hegel.Composite(func(tc hegel.TestCase) edit {
+	return edit{
+		op:    hegel.Draw(tc, hegel.SampledFrom(editOps)),
+		name:  hegel.Draw(tc, hegel.SampledFrom(editNames)),
+		value: hegel.Draw(tc, hegel.SampledFrom(editValues)),
+		cn:    hegel.Draw(tc, chance(30)),
+	}
+})
+
+// editCase: one to twelve edits applied in order to a fresh event.
+type editCase struct {
+	edits []edit
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c editCase) GoString() string {
+	var b strings.Builder
+	for _, e := range c.edits {
+		fmt.Fprintf(&b, "%s %s=%q", e.op, e.name, e.value)
+		if e.cn {
+			b.WriteString(" CN=x")
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+var editCases = hegel.Map(many(edits, 1, 12), func(es []edit) editCase { return editCase{es} })
+
+// partition splits the model into the properties the selector takes and the rest, in order.
+func partition(model []mprop, sel func(mprop) bool) (kept, gone []mprop) {
+	for _, p := range model {
+		if sel(p) {
+			gone = append(gone, p)
+		} else {
+			kept = append(kept, p)
+		}
+	}
+	return kept, gone
+}
+
+// setFirst replaces the first property of the name, or appends (the model of SetProperty).
+func setFirst(model []mprop, np mprop) []mprop {
+	for i := range model {
+		if model[i].name == np.name {
+			model[i] = np
+			return model
+		}
+	}
+	return append(model, np)
+}
+
+// sameRemoved reports whether the removed properties are the modelled ones.
+func sameRemoved(removed []ics.IANAProperty, gone []mprop) bool {
+	return reflect.DeepEqual(propsOf(removed), gone) || (len(removed) == 0 && len(gone) == 0)
+}
+
+// TestHegelPropertyEditsFollowTheModel: AddProperty appends, SetProperty replaces the first
+// match or appends, ReplaceProperty removes all matches and appends (returning the removed),
+// RemoveProperty removes all matches (returning them), RemovePropertyByValue removes the
+// matches with that value; GetProperty is the first match, GetProperties all, HasProperty any.
+// RemovePropertyByValue is drawn at its natural rate (golang-ical/2, never under
+// HEGEL_NO_KNOWN=1); once it has run, the model may have diverged, so every later mismatch
+// carries its shape.
+func TestHegelPropertyEditsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, editCases)
+		ev := ics.NewEvent("u")
+		model := []mprop{{name: "UID", value: "u"}}
+		shape := ""
+		check := func(step string) bool {
+			got := propsOf(ev.Properties)
+			if !reflect.DeepEqual(got, model) {
+				c.mismatch(ht, shape, "after %s:\n got  %v\n want %v", step, got, model)
+				return false
+			}
+			for _, name := range editNames {
+				_, wantAll := partition(model, func(p mprop) bool { return p.name == name })
+				all := ev.GetProperties(ics.ComponentProperty(name))
+				if len(all) != len(wantAll) {
+					c.mismatch(ht, shape, "after %s: GetProperties(%s) has %d, want %d", step, name, len(all), len(wantAll))
+					return false
+				}
+				first := ev.GetProperty(ics.ComponentProperty(name))
+				if (first == nil) != (len(wantAll) == 0) || (first != nil && !reflect.DeepEqual(propOf(first.BaseProperty), wantAll[0])) {
+					c.mismatch(ht, shape, "after %s: GetProperty(%s) = %v, want %v", step, name, first, wantAll)
+					return false
+				}
+				if ev.HasProperty(ics.ComponentProperty(name)) != (len(wantAll) > 0) {
+					c.mismatch(ht, shape, "after %s: HasProperty(%s) wrong", step, name)
+					return false
+				}
+			}
+			return true
+		}
+		for _, e := range ec.edits {
+			name, value := e.name, e.value
+			cp := ics.ComponentProperty(name)
+			var params []ics.PropertyParameter
+			var mps []mparam
+			if e.cn {
+				params = []ics.PropertyParameter{ics.WithCN("x")}
+				mps = []mparam{{"CN", []string{"x"}}}
+			}
+			np := mprop{name: name, value: value, params: mps}
+			byName := func(p mprop) bool { return p.name == name }
+			desc := e.op
+			switch e.op {
+			case "AddProperty":
+				ev.AddProperty(cp, value, params...)
+				model = append(model, np)
+			case "SetProperty":
+				ev.SetProperty(cp, value, params...)
+				model = setFirst(model, np)
+			case "ReplaceProperty":
+				removed := ev.ReplaceProperty(cp, value, params...)
+				kept, gone := partition(model, byName)
+				model = append(kept, np)
+				if !sameRemoved(removed, gone) {
+					c.mismatch(ht, shape, "ReplaceProperty(%s) removed %v, want %v", name, propsOf(removed), gone)
+					return
+				}
+			case "RemoveProperty":
+				removed := ev.RemoveProperty(cp)
+				kept, gone := partition(model, byName)
+				model = kept
+				if !sameRemoved(removed, gone) {
+					c.mismatch(ht, shape, "RemoveProperty(%s) removed %v, want %v", name, propsOf(removed), gone)
+					return
+				}
+			case "RemovePropertyByValue":
+				shape = "golang-ical/2"
+				removed := ev.RemovePropertyByValue(cp, value)
+				kept, gone := partition(model, func(p mprop) bool { return p.name == name && p.value == value })
+				model = kept
+				if !sameRemoved(removed, gone) {
+					c.mismatch(ht, shape, "RemovePropertyByValue(%s, %q) removed %v, want %v", name, value, propsOf(removed), gone)
+					return
+				}
+			case "Setter":
+				switch name {
+				case "SUMMARY":
+					ev.SetSummary(value, params...)
+					model = setFirst(model, np)
+					desc = "SetSummary"
+				case "COMMENT":
+					ev.AddComment(value, params...)
+					model = append(model, np)
+					desc = "AddComment"
+				case "CATEGORIES":
+					ev.AddCategory(value, params...)
+					model = append(model, np)
+					desc = "AddCategory"
+				default:
+					ev.SetProperty(cp, value, params...)
+					model = setFirst(model, np)
+					desc = "SetProperty"
+				}
+			}
+			c.count(desc)
+			if !check(desc) {
+				return
+			}
+		}
+		// The edited component serializes and reads back.
+		cal, _ := ics.NewCalendarWithOptions()
+		cal.AddVEvent(ev)
+		back, err := ics.ParseCalendar(strings.NewReader(cal.Serialize()))
+		if err != nil {
+			c.mismatch(ht, shape, "ParseCalendar after edits: %v", err)
+			return
+		}
+		if got := propsOf(back.Events()[0].Properties); !reflect.DeepEqual(got, model) {
+			c.mismatch(ht, shape, "after edits, read back:\n got  %v\n want %v", got, model)
+		}
+	})
+}
