index 0000000..3a8bdbb
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,36 @@
+package hegel
+
+import "strings"
+
+// Known bugs of x/image at the pinned commit, gated so the properties stay
+// green while they are open. Each rule names the zoo's bug id; the pins in
+// hegel_pins_test.go fail while the bug is open.
+
+// caseInfo describes a failing case for the gates.
+type caseInfo struct {
+	prop   string // which property
+	format string // BMP, TIFF, WEBP
+	mode   string // Pillow mode, when Pillow wrote the file
+	kind   string // Go image kind, when x/image wrote the file
+	opaque bool
+	opts   map[string]any
+	msg    string // the failure as it would be reported
+}
+
+func isCCITT(opts map[string]any) bool {
+	c, _ := opts["compression"].(string)
+	return c == "group3" || c == "group4"
+}
+
+// known returns the id of the bug that explains the case, or "".
+func known(c caseInfo) string {
+	switch {
+	case c.prop == "round-trip" && c.format == "BMP" && !c.opaque && strings.Contains(c.msg, "channel A"):
+		// x-image/1: bmp.Encode's alpha does not come back from bmp.Decode.
+		return "x-image/1"
+	case c.prop == "pillow-writes" && c.format == "TIFF" && c.mode == "1" && isCCITT(c.opts):
+		// x-image/2: CCITT strips with PhotometricInterpretation=1 decode inverted.
+		return "x-image/2"
+	}
+	return ""
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..c1c191b
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""Pillow oracle for the x/image hegel tests: one JSON object per line in, one per line out.
+
+  {"op": "encode", "fmt": "BMP"|"TIFF"|"WEBP", "mode": M, "w": W, "h": H, "data": b64,
+   "palette": b64 (mode P only, RGB triples), "opts": {...}}
+      -> {"file": b64} | {"error": "..."}
+  {"op": "decode", "file": b64}
+      -> {"mode": M, "w": W, "h": H, "data": b64, "palette": b64, "tags": {...}} | {"error": "..."}
+
+data is the image's raw bytes in Pillow's layout for the mode (Image.frombytes / tobytes),
+except that mode "1" is exchanged as mode "L" bytes holding 0 or 255.
+
+encode opts: compression (TIFF: raw, tiff_lzw, tiff_adobe_deflate, packbits, group3, group4),
+predictor (TIFF: 2 for horizontal), fillorder (TIFF: 2 for LSB first), rowsperstrip (TIFF),
+lossless (WEBP bool), quality (WEBP), method (WEBP), exact (WEBP).
+"""
+import base64
+import io
+import json
+import sys
+
+from PIL import Image
+
+Image.MAX_IMAGE_PIXELS = None
+
+
+def b64d(s):
+    return base64.b64decode(s) if s else b""
+
+
+def b64e(b):
+    return base64.b64encode(b).decode("ascii")
+
+
+def build(req):
+    mode, w, h = req["mode"], req["w"], req["h"]
+    data = b64d(req["data"])
+    if mode == "1":
+        im = Image.frombytes("L", (w, h), data).convert("1")
+    else:
+        im = Image.frombytes(mode, (w, h), data)
+        if mode in ("P", "PA"):
+            im.putpalette(b64d(req.get("palette", "")), "RGB")
+    return im
+
+
+def encode(req):
+    im = build(req)
+    fmt = req["fmt"]
+    opts = req.get("opts") or {}
+    kw = {}
+    if fmt == "TIFF":
+        comp = opts.get("compression")
+        if comp and comp != "raw":
+            if comp in ("group3", "group4") and im.mode != "1":
+                return {"error": "oracle: ccitt needs mode 1"}
+            kw["compression"] = comp
+        tiffinfo = {}
+        if opts.get("predictor"):
+            tiffinfo[317] = int(opts["predictor"])
+        if opts.get("fillorder"):
+            tiffinfo[266] = int(opts["fillorder"])
+        if opts.get("rowsperstrip"):
+            tiffinfo[278] = int(opts["rowsperstrip"])
+        if tiffinfo:
+            kw["tiffinfo"] = tiffinfo
+    elif fmt == "WEBP":
+        kw["lossless"] = bool(opts.get("lossless", True))
+        if "quality" in opts:
+            kw["quality"] = int(opts["quality"])
+        if "method" in opts:
+            kw["method"] = int(opts["method"])
+        if opts.get("exact"):
+            kw["exact"] = True
+    buf = io.BytesIO()
+    im.save(buf, fmt, **kw)
+    return {"file": b64e(buf.getvalue())}
+
+
+def decode(req):
+    im = Image.open(io.BytesIO(b64d(req["file"])))
+    im.load()
+    tags = {}
+    if hasattr(im, "tag_v2"):
+        for k, v in im.tag_v2.items():
+            if k in (320, 273, 279, 324, 325):
+                continue
+            try:
+                json.dumps(v)
+                tags[str(k)] = v
+            except TypeError:
+                tags[str(k)] = str(v)
+    mode = im.mode
+    palette = b""
+    if mode == "1":
+        im = im.convert("L")
+        mode = "L"
+    if im.mode in ("P", "PA"):
+        pal = im.getpalette("RGB") or []
+        palette = bytes(pal)
+    return {
+        "mode": mode,
+        "w": im.width,
+        "h": im.height,
+        "data": b64e(im.tobytes()),
+        "palette": b64e(palette),
+        "tags": tags,
+    }
+
+
+_webp = None
+
+
+def libwebp():
+    """libwebp itself, for the YUV planes a lossy decode produces (Pillow only gives RGB);
+    Pillow's bundled copy when there is one, else the system's."""
+    global _webp
+    if _webp is None:
+        import ctypes
+        import ctypes.util
+        import glob
+        import os
+
+        import PIL
+
+        cands = sorted(glob.glob(os.path.join(os.path.dirname(os.path.dirname(PIL.__file__)),
+                                              "pillow.libs", "libwebp-*.so*")))
+        path = cands[0] if cands else ctypes.util.find_library("webp")
+        if not path:
+            raise RuntimeError("no libwebp shared library found")
+        lib = ctypes.CDLL(path)
+        u8p = ctypes.POINTER(ctypes.c_uint8)
+        intp = ctypes.POINTER(ctypes.c_int)
+        lib.WebPDecodeYUV.restype = u8p
+        lib.WebPDecodeYUV.argtypes = [ctypes.c_char_p, ctypes.c_size_t, intp, intp,
+                                      ctypes.POINTER(u8p), ctypes.POINTER(u8p), intp, intp]
+        lib.WebPDecodeRGBA.restype = u8p
+        lib.WebPDecodeRGBA.argtypes = [ctypes.c_char_p, ctypes.c_size_t, intp, intp]
+        lib.WebPFree.argtypes = [ctypes.c_void_p]
+        lib.WebPGetDecoderVersion.restype = ctypes.c_int
+        _webp = (lib, ctypes, u8p)
+    return _webp
+
+
+def yuv(req):
+    lib, ctypes, u8p = libwebp()
+    data = b64d(req["file"])
+    w, h, stride, uvstride = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
+    u, v = u8p(), u8p()
+    y = lib.WebPDecodeYUV(data, len(data), ctypes.byref(w), ctypes.byref(h), ctypes.byref(u),
+                          ctypes.byref(v), ctypes.byref(stride), ctypes.byref(uvstride))
+    if not y:
+        return {"error": "libwebp: WebPDecodeYUV failed"}
+    W, H = w.value, h.value
+    uw, uh = (W + 1) // 2, (H + 1) // 2
+    yb = b"".join(ctypes.string_at(ctypes.addressof(y.contents) + r * stride.value, W) for r in range(H))
+    ub = b"".join(ctypes.string_at(ctypes.addressof(u.contents) + r * uvstride.value, uw) for r in range(uh))
+    vb = b"".join(ctypes.string_at(ctypes.addressof(v.contents) + r * uvstride.value, uw) for r in range(uh))
+    lib.WebPFree(y)
+    out = {"w": W, "h": H, "y": b64e(yb), "u": b64e(ub), "v": b64e(vb), "a": "",
+           "version": "%x" % lib.WebPGetDecoderVersion()}
+    if req.get("alpha"):
+        rgba = lib.WebPDecodeRGBA(data, len(data), ctypes.byref(w), ctypes.byref(h))
+        if not rgba:
+            return {"error": "libwebp: WebPDecodeRGBA failed"}
+        buf = ctypes.string_at(rgba, W * H * 4)
+        lib.WebPFree(rgba)
+        out["a"] = b64e(buf[3::4])
+    return out
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        req = json.loads(line)
+        try:
+            if req["op"] == "encode":
+                out = encode(req)
+            elif req["op"] == "decode":
+                out = decode(req)
+            elif req["op"] == "yuv":
+                out = yuv(req)
+            else:
+                out = {"error": "oracle: unknown op"}
+        except Exception as e:  # noqa: BLE001
+            out = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
