+package hegel
+
+// Hegel property tests for golang.org/x/image's bmp, tiff and webp packages.
+// The oracle is Pillow (with libtiff and libwebp), run as a child process
+// speaking one JSON line each way (oracle.py); for lossy WebP the oracle
+// also asks libwebp itself for the YUV planes it decodes.
+//
+// Needs python3 with Pillow.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"image"
+	"image/color"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"golang.org/x/image/bmp"
+	"golang.org/x/image/tiff"
+	"golang.org/x/image/webp"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// The oracle: Pillow in a child process, one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one JSON request and returns the answer object; an answer
+// carrying "error" is returned as the oracle's own verdict, not as err.
+func (o *oracle) call(req map[string]any) (m map[string]any, oracleErr string, err error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, "", o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, "", err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, "", err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, "", err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, "", err
+	}
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, "", fmt.Errorf("%s oracle: bad answer %.200q: %v", o.name, resp, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		return nil, fmt.Sprint(e), nil
+	}
+	return m, "", nil
+}
+
+var (
+	pyOnce sync.Once
+	py     *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("Pillow", "python3", "-u", "oracle.py") })
+	return py
+}
+
+func b64(b []byte) string { return base64.StdEncoding.EncodeToString(b) }
+
+func unb64(v any) []byte {
+	s, _ := v.(string)
+	b, _ := base64.StdEncoding.DecodeString(s)
+	return b
+}
+
+func jsonInt(v any) int {
+	f, _ := v.(float64)
+	return int(f)
+}
+
+// pillowEncode has Pillow write the raw pixels (in its layout for mode) as
+// a file of the format; oracleErr is Pillow's refusal, if any.
+func pillowEncode(t testing.TB, format, mode string, w, h int, data, palette []byte, opts map[string]any) (file []byte, oracleErr string) {
+	req := map[string]any{"op": "encode", "fmt": format, "mode": mode, "w": w, "h": h, "data": b64(data), "opts": opts}
+	if palette != nil {
+		req["palette"] = b64(palette)
+	}
+	m, oerr, err := pyOracle().call(req)
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if oerr != "" {
+		return nil, oerr
+	}
+	return unb64(m["file"]), ""
+}
+
+// pillowImage is what Pillow decoded: its mode and the raw bytes in that
+// mode's layout (mode "1" already converted to "L").
+type pillowImage struct {
+	mode    string
+	w, h    int
+	data    []byte
+	palette []byte
+	tags    map[string]any
+}
+
+func pillowDecode(t testing.TB, file []byte) (*pillowImage, string) {
+	m, oerr, err := pyOracle().call(map[string]any{"op": "decode", "file": b64(file)})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if oerr != "" {
+		return nil, oerr
+	}
+	p := &pillowImage{mode: m["mode"].(string), w: jsonInt(m["w"]), h: jsonInt(m["h"]), data: unb64(m["data"]), palette: unb64(m["palette"])}
+	p.tags, _ = m["tags"].(map[string]any)
+	return p, ""
+}
+
+// yuvPlanes is libwebp's own decode of a lossy WebP: Y at full size, U and
+// V at half size (rounded up), A when asked for.
+type yuvPlanes struct {
+	w, h       int
+	y, u, v, a []byte
+	version    string
+}
+
+func libwebpYUV(t testing.TB, file []byte, alpha bool) (*yuvPlanes, string) {
+	m, oerr, err := pyOracle().call(map[string]any{"op": "yuv", "file": b64(file), "alpha": alpha})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if oerr != "" {
+		return nil, oerr
+	}
+	return &yuvPlanes{w: jsonInt(m["w"]), h: jsonInt(m["h"]), y: unb64(m["y"]), u: unb64(m["u"]), v: unb64(m["v"]), a: unb64(m["a"]), version: fmt.Sprint(m["version"])}, ""
+}
+
+// ---------------------------------------------------------------------------
+// x/image's side.
+
+func xDecode(format string, file []byte) (image.Image, error) {
+	switch format {
+	case "BMP":
+		return bmp.Decode(bytes.NewReader(file))
+	case "TIFF":
+		return tiff.Decode(bytes.NewReader(file))
+	case "WEBP":
+		return webp.Decode(bytes.NewReader(file))
+	}
+	panic("format " + format)
+}
+
+func xDecodeConfig(format string, file []byte) (image.Config, error) {
+	switch format {
+	case "BMP":
+		return bmp.DecodeConfig(bytes.NewReader(file))
+	case "TIFF":
+		return tiff.DecodeConfig(bytes.NewReader(file))
+	case "WEBP":
+		return webp.DecodeConfig(bytes.NewReader(file))
+	}
+	panic("format " + format)
+}
+
+func xEncode(format string, img image.Image, topts *tiff.Options) ([]byte, error) {
+	var buf bytes.Buffer
+	var err error
+	switch format {
+	case "BMP":
+		err = bmp.Encode(&buf, img)
+	case "TIFF":
+		err = tiff.Encode(&buf, img, topts)
+	default:
+		panic("format " + format)
+	}
+	return buf.Bytes(), err
+}
+
+// ---------------------------------------------------------------------------
+// Pixels: every image is read as non-premultiplied 16-bit RGBA per pixel.
+
+type pixFn func(x, y int) [4]uint16
+
+// goPix reads an image.Image with straight (non-premultiplied) alpha;
+// straight-alpha colours are read as stored, so colour under zero alpha
+// survives and no rounding through premultiplication happens.
+func goPix(img image.Image) pixFn {
+	b := img.Bounds()
+	return func(x, y int) [4]uint16 {
+		switch c := img.At(b.Min.X+x, b.Min.Y+y).(type) {
+		case color.NRGBA:
+			return [4]uint16{uint16(c.R) * 0x101, uint16(c.G) * 0x101, uint16(c.B) * 0x101, uint16(c.A) * 0x101}
+		case color.NRGBA64:
+			return [4]uint16{c.R, c.G, c.B, c.A}
+		default:
+			n := color.NRGBA64Model.Convert(c).(color.NRGBA64)
+			return [4]uint16{n.R, n.G, n.B, n.A}
+		}
+	}
+}
+
+// unpremul8 turns 8-bit premultiplied pixels into straight ones the way a
+// reader would (p*255/a, truncated), for comparing with a reader that did.
+func unpremul8(fn pixFn) pixFn {
+	return func(x, y int) [4]uint16 {
+		p := fn(x, y)
+		a := uint32(p[3] >> 8)
+		if a == 0 {
+			return [4]uint16{0, 0, 0, 0}
+		}
+		for c := 0; c < 3; c++ {
+			v := uint32(p[c]>>8) * 255 / a
+			if v > 255 {
+				v = 255
+			}
+			p[c] = uint16(v) * 0x101
+		}
+		return p
+	}
+}
+
+// goPixPremul reads an image.Image as premultiplied RGBA (what RGBA()
+// returns), for comparing with a premultiplied encoding.
+func goPixPremul(img image.Image) pixFn {
+	b := img.Bounds()
+	return func(x, y int) [4]uint16 {
+		r, g, bl, a := img.At(b.Min.X+x, b.Min.Y+y).RGBA()
+		return [4]uint16{uint16(r), uint16(g), uint16(bl), uint16(a)}
+	}
+}
+
+// pillowPix interprets Pillow's raw bytes for its mode. premul reports a
+// mode with associated (premultiplied) alpha.
+func pillowPix(p *pillowImage) (fn pixFn, premul bool, err error) {
+	w, d := p.w, p.data
+	need := func(bpp int) error {
+		if len(d) < w*p.h*bpp {
+			return fmt.Errorf("Pillow mode %s: %d bytes for %dx%d", p.mode, len(d), w, p.h)
+		}
+		return nil
+	}
+	x8 := func(v byte) uint16 { return uint16(v) * 0x101 }
+	switch p.mode {
+	case "L":
+		return func(x, y int) [4]uint16 { v := x8(d[y*w+x]); return [4]uint16{v, v, v, 0xffff} }, false, need(1)
+	case "LA":
+		return func(x, y int) [4]uint16 { i := 2 * (y*w + x); v := x8(d[i]); return [4]uint16{v, v, v, x8(d[i+1])} }, false, need(2)
+	case "La":
+		return func(x, y int) [4]uint16 { i := 2 * (y*w + x); v := x8(d[i]); return [4]uint16{v, v, v, x8(d[i+1])} }, true, need(2)
+	case "P", "PA":
+		bpp := 1
+		if p.mode == "PA" {
+			bpp = 2
+		}
+		pal := p.palette
+		return func(x, y int) [4]uint16 {
+			i := bpp * (y*w + x)
+			idx := int(d[i])
+			a := uint16(0xffff)
+			if bpp == 2 {
+				a = x8(d[i+1])
+			}
+			if 3*idx+2 >= len(pal) {
+				return [4]uint16{0, 0, 0, a}
+			}
+			return [4]uint16{x8(pal[3*idx]), x8(pal[3*idx+1]), x8(pal[3*idx+2]), a}
+		}, false, need(bpp)
+	case "RGB":
+		return func(x, y int) [4]uint16 {
+			i := 3 * (y*w + x)
+			return [4]uint16{x8(d[i]), x8(d[i+1]), x8(d[i+2]), 0xffff}
+		}, false, need(3)
+	case "RGBX":
+		return func(x, y int) [4]uint16 {
+			i := 4 * (y*w + x)
+			return [4]uint16{x8(d[i]), x8(d[i+1]), x8(d[i+2]), 0xffff}
+		}, false, need(4)
+	case "RGBA", "RGBa":
+		return func(x, y int) [4]uint16 {
+			i := 4 * (y*w + x)
+			return [4]uint16{x8(d[i]), x8(d[i+1]), x8(d[i+2]), x8(d[i+3])}
+		}, p.mode == "RGBa", need(4)
+	case "I;16", "I;16L":
+		return func(x, y int) [4]uint16 {
+			i := 2 * (y*w + x)
+			v := uint16(d[i]) | uint16(d[i+1])<<8
+			return [4]uint16{v, v, v, 0xffff}
+		}, false, need(2)
+	case "I;16B":
+		return func(x, y int) [4]uint16 {
+			i := 2 * (y*w + x)
+			v := uint16(d[i])<<8 | uint16(d[i+1])
+			return [4]uint16{v, v, v, 0xffff}
+		}, false, need(2)
+	case "I":
+		return func(x, y int) [4]uint16 {
+			i := 4 * (y*w + x)
+			v := int32(uint32(d[i]) | uint32(d[i+1])<<8 | uint32(d[i+2])<<16 | uint32(d[i+3])<<24)
+			if v < 0 {
+				v = 0
+			}
+			if v > 0xffff {
+				v = 0xffff
+			}
+			return [4]uint16{uint16(v), uint16(v), uint16(v), 0xffff}
+		}, false, need(4)
+	}
+	return nil, false, fmt.Errorf("Pillow mode %s not interpreted here", p.mode)
+}
+
+// mismatch compares two images pixel by pixel at bits of precision (8 or
+// 16), with or without the alpha channel, and describes the first
+// difference ("" when none). Colour under zero alpha is not compared.
+func mismatch(w, h int, want, got pixFn, bits uint, alpha bool) string {
+	return mismatchTol(w, h, want, got, bits, alpha, 0)
+}
+
+// mismatchTol is mismatch allowing the colour channels of non-opaque
+// pixels to differ by tol (for readers that un-premultiply their way).
+func mismatchTol(w, h int, want, got pixFn, bits uint, alpha bool, tol int) string {
+	shift := 16 - bits
+	channels := [4]string{"R", "G", "B", "A"}
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			a, b := want(x, y), got(x, y)
+			for c := 0; c < 4; c++ {
+				if c == 3 && !alpha {
+					continue
+				}
+				if c < 3 && a[3]>>shift == 0 && b[3]>>shift == 0 {
+					continue
+				}
+				av, bv := int(a[c]>>shift), int(b[c]>>shift)
+				d := av - bv
+				if d < 0 {
+					d = -d
+				}
+				if d != 0 && !(c < 3 && tol > 0 && d <= tol && a[3]>>shift != 0xffff>>shift) {
+					return fmt.Sprintf("pixel (%d,%d) channel %s: want %s, got %s", x, y, channels[c], fmtPix(a, bits), fmtPix(b, bits))
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func fmtPix(p [4]uint16, bits uint) string {
+	if bits == 8 {
+		return fmt.Sprintf("rgba(%d,%d,%d,%d)", p[0]>>8, p[1]>>8, p[2]>>8, p[3]>>8)
+	}
+	return fmt.Sprintf("rgba16(%d,%d,%d,%d)", p[0], p[1], p[2], p[3])
+}
+
+// hexdump shows a small file whole, a large one by its head.
+func hexdump(b []byte) string {
+	if len(b) > 256 {
+		return fmt.Sprintf("% x ... (%d bytes)", b[:256], len(b))
+	}
+	return fmt.Sprintf("% x", b)
+}
