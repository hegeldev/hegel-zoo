+// Copyright 2026 The Hegel zoo authors. Use of this source code is governed
+// by the same BSD-style license as golang.org/x/image.
+
+// Package hegel holds the Hegel zoo's property tests for x/image's bmp, tiff
+// and webp packages: what Pillow writes, x/image reads back to the pixel;
+// what x/image writes, Pillow (and x/image) read back; lossy WebP decodes to
+// the planes libwebp produces; and no damaged file makes a decoder panic.
+package hegel
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..dd6b496
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,366 @@
+package hegel
+
+// Generators: images of every Go type the encoders special-case, with
+// pixel fills that exercise the codecs (noise, few colours, flat, gradients,
+// stripes), at sizes around the byte, word and tile boundaries.
+
+import (
+	"image"
+	"image/color"
+	"math/rand"
+
+	"hegel.dev/go/hegel"
+)
+
+// goKinds are the image types the x/image encoders and decoders special-case.
+var goKinds = []string{"gray1", "gray", "gray16", "paletted", "rgba", "nrgba", "rgba64", "nrgba64", "generic"}
+
+type sample struct {
+	kind   string
+	fill   string
+	opaque bool
+	img    image.Image
+}
+
+func (s sample) Bounds() image.Rectangle { return s.img.Bounds() }
+
+// wrapped hides an image's concrete type, so the encoders take their
+// generic path.
+type wrapped struct{ image.Image }
+
+func dims(tc hegel.TestCase) (int, int) {
+	edge := func() int {
+		if chance(tc, 55) {
+			return pick(tc, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33)
+		}
+		if chance(tc, 8) {
+			return n(tc, 34, 130)
+		}
+		return n(tc, 1, 33)
+	}
+	return edge(), edge()
+}
+
+// src supplies pixel values: drawn from the test case for small images
+// (so they shrink), from a seeded generator for large ones.
+type src struct {
+	tc     hegel.TestCase
+	r      *rand.Rand
+	fill   string
+	w, h   int
+	few    [][4]uint16
+	stripe int
+	alpha  string // "opaque", "binary" (0 or full), "random"
+}
+
+func newSrc(tc hegel.TestCase, w, h int, opaque bool) *src {
+	s := &src{tc: tc, w: w, h: h, fill: pick(tc, "random", "random", "few", "flat", "gradient", "stripes")}
+	if w*h > 64 || chance(tc, 25) {
+		s.r = rand.New(rand.NewSource(int64(n(tc, 0, 1<<30))))
+	}
+	s.alpha = "opaque"
+	if !opaque {
+		s.alpha = pick(tc, "binary", "random")
+	}
+	switch s.fill {
+	case "few", "stripes":
+		k := pick(tc, 2, 2, 3, 4, 8)
+		for i := 0; i < k; i++ {
+			s.few = append(s.few, s.randomColor())
+		}
+		s.stripe = n(tc, 1, 4)
+	case "flat":
+		s.few = [][4]uint16{s.randomColor()}
+	}
+	return s
+}
+
+func (s *src) rnd(lo, hi int) int {
+	if s.r != nil {
+		return lo + s.r.Intn(hi-lo+1)
+	}
+	return n(s.tc, lo, hi)
+}
+
+func (s *src) randomAlpha() uint16 {
+	switch s.alpha {
+	case "binary":
+		return uint16(s.rnd(0, 1)) * 0xffff
+	case "random":
+		return uint16(s.rnd(0, 0xffff))
+	}
+	return 0xffff
+}
+
+func (s *src) randomColor() [4]uint16 {
+	return [4]uint16{uint16(s.rnd(0, 0xffff)), uint16(s.rnd(0, 0xffff)), uint16(s.rnd(0, 0xffff)), s.randomAlpha()}
+}
+
+// pixel is the straight-alpha 16-bit colour at (x, y).
+func (s *src) pixel(x, y int) [4]uint16 {
+	switch s.fill {
+	case "few":
+		return s.few[s.rnd(0, len(s.few)-1)]
+	case "flat":
+		return s.few[0]
+	case "stripes":
+		return s.few[(x/s.stripe+y/s.stripe)%len(s.few)]
+	case "gradient":
+		mx, my := s.w-1, s.h-1
+		if mx == 0 {
+			mx = 1
+		}
+		if my == 0 {
+			my = 1
+		}
+		a := uint16(0xffff)
+		if s.alpha != "opaque" {
+			a = uint16(x * 0xffff / mx)
+		}
+		return [4]uint16{uint16(x * 0xffff / mx), uint16(y * 0xffff / my), uint16((x + y) * 0xffff / (mx + my)), a}
+	}
+	return s.randomColor()
+}
+
+// gray1 turns a colour into black or white.
+func gray1(c [4]uint16) uint8 {
+	if c[0] >= 0x8000 {
+		return 0xff
+	}
+	return 0
+}
+
+func genSample(tc hegel.TestCase, kind string) sample {
+	w, h := dims(tc)
+	return genSampleSized(tc, kind, w, h)
+}
+
+func genSampleSized(tc hegel.TestCase, kind string, w, h int) sample {
+	opaque := true
+	switch kind {
+	case "rgba", "nrgba", "rgba64", "nrgba64":
+		opaque = chance(tc, 40)
+	case "generic":
+		inner := genSampleSized(tc, pick(tc, "gray", "gray16", "paletted", "rgba", "nrgba", "rgba64", "nrgba64"), w, h)
+		return sample{kind: "generic", fill: inner.fill + "/" + inner.kind, opaque: inner.opaque, img: wrapped{inner.img}}
+	}
+	s := newSrc(tc, w, h, opaque)
+	r := image.Rect(0, 0, w, h)
+	var img image.Image
+	switch kind {
+	case "gray1":
+		m := image.NewGray(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				m.Pix[y*m.Stride+x] = gray1(s.pixel(x, y))
+			}
+		}
+		img = m
+	case "gray":
+		m := image.NewGray(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				m.Pix[y*m.Stride+x] = uint8(s.pixel(x, y)[0] >> 8)
+			}
+		}
+		img = m
+	case "gray16":
+		m := image.NewGray16(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				m.SetGray16(x, y, color.Gray16{Y: s.pixel(x, y)[0]})
+			}
+		}
+		img = m
+	case "paletted":
+		k := pick(tc, 1, 2, 3, 4, 15, 16, 17, 255, 256, n(tc, 1, 256))
+		pal := make(color.Palette, k)
+		for i := range pal {
+			c := s.randomColor()
+			pal[i] = color.RGBA{uint8(c[0] >> 8), uint8(c[1] >> 8), uint8(c[2] >> 8), 0xff}
+		}
+		m := image.NewPaletted(r, pal)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				var idx int
+				switch s.fill {
+				case "flat":
+					idx = 0
+				case "stripes":
+					idx = (x/s.stripe + y/s.stripe) % k
+				case "gradient":
+					idx = (x + y) % k
+				default:
+					idx = s.rnd(0, k-1)
+				}
+				m.Pix[y*m.Stride+x] = uint8(idx)
+			}
+		}
+		img = m
+	case "rgba":
+		m := image.NewRGBA(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				c := s.pixel(x, y)
+				m.Set(x, y, color.NRGBA64{c[0], c[1], c[2], c[3]})
+			}
+		}
+		img = m
+	case "nrgba":
+		m := image.NewNRGBA(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				c := s.pixel(x, y)
+				m.SetNRGBA(x, y, color.NRGBA{uint8(c[0] >> 8), uint8(c[1] >> 8), uint8(c[2] >> 8), uint8(c[3] >> 8)})
+			}
+		}
+		img = m
+	case "rgba64":
+		m := image.NewRGBA64(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				c := s.pixel(x, y)
+				m.Set(x, y, color.NRGBA64{c[0], c[1], c[2], c[3]})
+			}
+		}
+		img = m
+	case "nrgba64":
+		m := image.NewNRGBA64(r)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				c := s.pixel(x, y)
+				m.SetNRGBA64(x, y, color.NRGBA64{c[0], c[1], c[2], c[3]})
+			}
+		}
+		img = m
+	default:
+		panic("kind " + kind)
+	}
+	return sample{kind: kind, fill: s.fill + "/" + s.alpha, opaque: opaque, img: img}
+}
+
+// kindForMode is the Go image type that carries what a Pillow mode holds.
+func kindForMode(mode string) string {
+	switch mode {
+	case "1":
+		return "gray1"
+	case "L":
+		return "gray"
+	case "I;16", "I;16B":
+		return "gray16"
+	case "P":
+		return "paletted"
+	case "RGB":
+		return "rgba"
+	case "RGBA", "LA":
+		return "nrgba"
+	}
+	panic("mode " + mode)
+}
+
+// toPillow lays the sample's pixels out as Pillow's raw bytes for mode
+// (plus the RGB palette for P). The sample must be of kindForMode(mode),
+// and opaque for RGB.
+func toPillow(s sample, mode string) (data, palette []byte) {
+	b := s.img.Bounds()
+	w, h := b.Dx(), b.Dy()
+	switch mode {
+	case "1", "L":
+		m := s.img.(*image.Gray)
+		for y := 0; y < h; y++ {
+			data = append(data, m.Pix[y*m.Stride:y*m.Stride+w]...)
+		}
+	case "I;16", "I;16B":
+		m := s.img.(*image.Gray16)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				v := m.Gray16At(x, y).Y
+				if mode == "I;16" {
+					data = append(data, byte(v), byte(v>>8))
+				} else {
+					data = append(data, byte(v>>8), byte(v))
+				}
+			}
+		}
+	case "P":
+		m := s.img.(*image.Paletted)
+		for y := 0; y < h; y++ {
+			data = append(data, m.Pix[y*m.Stride:y*m.Stride+w]...)
+		}
+		for _, c := range m.Palette {
+			r, g, bl, _ := c.RGBA()
+			palette = append(palette, byte(r>>8), byte(g>>8), byte(bl>>8))
+		}
+	case "RGB":
+		m := s.img.(*image.RGBA)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				i := m.PixOffset(x, y)
+				data = append(data, m.Pix[i], m.Pix[i+1], m.Pix[i+2])
+			}
+		}
+	case "RGBA":
+		m := s.img.(*image.NRGBA)
+		for y := 0; y < h; y++ {
+			data = append(data, m.Pix[y*m.Stride:y*m.Stride+4*w]...)
+		}
+	case "LA":
+		m := s.img.(*image.NRGBA)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				i := m.PixOffset(x, y)
+				data = append(data, m.Pix[i], m.Pix[i+3])
+			}
+		}
+	default:
+		panic("mode " + mode)
+	}
+	return data, palette
+}
+
+// mutate damages a file: a flipped byte, a truncation, a zeroed or
+// inserted run, or a value pushed to an extreme.
+func mutate(tc hegel.TestCase, file []byte) ([]byte, string) {
+	if len(file) == 0 {
+		return file, "empty"
+	}
+	b := append([]byte(nil), file...)
+	switch n(tc, 1, 6) {
+	case 1:
+		i := n(tc, 0, len(b)-1)
+		b[i] ^= byte(1 << n(tc, 0, 7))
+		return b, "bit flip"
+	case 2:
+		return b[:n(tc, 0, len(b)-1)], "truncated"
+	case 3:
+		i := n(tc, 0, len(b)-1)
+		b[i] = byte(pick(tc, 0x00, 0xff, 0x7f, 0x80, 0x01))
+		return b, "byte set"
+	case 4:
+		i := n(tc, 0, len(b)-1)
+		j := i + n(tc, 1, 8)
+		if j > len(b) {
+			j = len(b)
+		}
+		for k := i; k < j; k++ {
+			b[k] = byte(n(tc, 0, 255))
+		}
+		return b, "run overwritten"
+	case 5:
+		i := n(tc, 0, len(b))
+		ins := make([]byte, n(tc, 1, 8))
+		for k := range ins {
+			ins[k] = byte(n(tc, 0, 255))
+		}
+		return append(b[:i:i], append(ins, b[i:]...)...), "run inserted"
+	default:
+		// The header fields are where the decoders decide sizes.
+		lim := len(b)
+		if lim > 64 {
+			lim = 64
+		}
+		i := n(tc, 0, lim-1)
+		b[i] = byte(pick(tc, 0x00, 0xff, 0x7f, 0x80))
+		return b, "header byte set"
+	}
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..d3fb1b8
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,116 @@
+package hegel
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug is open
+// (listed under [expected_failures] in the zoo's target.toml).
+
+import (
+	"bytes"
+	"encoding/hex"
+	"image"
+	"image/color"
+	"testing"
+
+	"golang.org/x/image/bmp"
+	"golang.org/x/image/tiff"
+)
+
+// x-image/1: bmp.Encode writes a non-opaque image as a 32-bit file with a
+// BITMAPINFOHEADER, whose fourth byte bmp.Decode (like other readers)
+// treats as unused, so the alpha never comes back; a BITMAPV4HEADER with
+// an alpha mask is what Decode honours.
+func TestHegelPinBMPEncodeCarriesAlpha(t *testing.T) {
+	m := image.NewNRGBA(image.Rect(0, 0, 2, 1))
+	m.SetNRGBA(0, 0, color.NRGBA{R: 200, G: 100, B: 50, A: 0x80})
+	m.SetNRGBA(1, 0, color.NRGBA{R: 10, G: 20, B: 30, A: 0xff})
+	var buf bytes.Buffer
+	if err := bmp.Encode(&buf, m); err != nil {
+		t.Fatal(err)
+	}
+	got, err := bmp.Decode(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := color.NRGBAModel.Convert(got.At(0, 0)).(color.NRGBA)
+	if c.A != 0x80 {
+		t.Errorf("bmp: Encode then Decode of a pixel with alpha 0x80 gives alpha %#x (%T, %d-byte file, header size %d)", c.A, got, buf.Len(), buf.Bytes()[14])
+	}
+}
+
+// x-image/2: a CCITT Group 3 or 4 strip with PhotometricInterpretation=1
+// (BlackIsZero) decodes inverted. In CCITT data "white" codes stand for 0
+// bits and PhotometricInterpretation then says what 0 means: the TIFF
+// specification has BlackIsZero display such images reversed, and libtiff
+// encodes and decodes accordingly (Pillow writes bilevel TIFFs this way by
+// default). tiff.Decode instead always paints "white" codes white, so
+// every pixel of such a file is wrong. The files below are Pillow's: the
+// same 4x2 image (black white white black / white black black white) as
+// Group 4 with PhotometricInterpretation 1, and with 0 as the control.
+func TestHegelPinTIFFCCITTHonoursBlackIsZero(t *testing.T) {
+	const blackIsZero = "49492a000e00000004a82500100109000001030001000000040000000101030001000000020000000201030001000000010000000301030001000000040000000601030001000000010000001101040001000000080000001601030001000000020000001701040001000000060000001c010300010000000100000000000000"
+	const whiteIsZero = "49492a001000000026a95a800800800009000001030001000000040000000101030001000000020000000201030001000000010000000301030001000000040000000601030001000000000000001101040001000000080000001601030001000000020000001701040001000000070000001c010300010000000100000000000000"
+	want := []uint8{0, 255, 255, 0, 255, 0, 0, 255}
+	for _, tc := range []struct{ name, file string }{{"PhotometricInterpretation=0", whiteIsZero}, {"PhotometricInterpretation=1", blackIsZero}} {
+		b, err := hex.DecodeString(tc.file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		img, err := tiff.Decode(bytes.NewReader(b))
+		if err != nil {
+			t.Fatalf("%s: %v", tc.name, err)
+		}
+		var got []uint8
+		for y := 0; y < 2; y++ {
+			for x := 0; x < 4; x++ {
+				got = append(got, color.GrayModel.Convert(img.At(x, y)).(color.Gray).Y)
+			}
+		}
+		if !bytes.Equal(got, want) {
+			t.Errorf("%s, Group 4: decoded %v, libtiff (and the image written) %v", tc.name, got, want)
+		}
+	}
+}
+
+// x-image/3: tiff.Options promises what tiff.Encode does not do. The
+// CompressionType constants are documented as "supported compression
+// types", but Encode returns "unsupported compression" for LZW,
+// CCITTGroup3 and CCITTGroup4; and Predictor is documented as switching
+// on horizontal differencing, but is applied only together with LZW, so
+// with the compressions Encode does write (none, Deflate) it is silently
+// ignored and no Predictor tag is written.
+func TestHegelPinTIFFEncodeHonoursItsOptions(t *testing.T) {
+	m := image.NewGray(image.Rect(0, 0, 4, 2))
+	copy(m.Pix, []uint8{0, 255, 255, 0, 255, 0, 0, 255})
+	for _, c := range []tiff.CompressionType{tiff.LZW, tiff.CCITTGroup3, tiff.CCITTGroup4} {
+		var buf bytes.Buffer
+		if err := tiff.Encode(&buf, m, &tiff.Options{Compression: c}); err != nil {
+			t.Errorf("tiff.Encode with Compression %d (one of the supported compression types constants): %v", c, err)
+		}
+	}
+	var buf bytes.Buffer
+	if err := tiff.Encode(&buf, m, &tiff.Options{Compression: tiff.Deflate, Predictor: true}); err != nil {
+		t.Fatal(err)
+	}
+	if !hasTIFFTag(buf.Bytes(), 317) {
+		t.Errorf("tiff.Encode with Options{Compression: Deflate, Predictor: true} wrote no Predictor tag (317): the option only takes effect with LZW, which Encode refuses")
+	}
+}
+
+// hasTIFFTag reports whether a little-endian TIFF's first IFD has the tag.
+func hasTIFFTag(b []byte, tag uint16) bool {
+	le16 := func(i int) int { return int(b[i]) | int(b[i+1])<<8 }
+	le32 := func(i int) int { return le16(i) | le16(i+2)<<16 }
+	if len(b) < 8 || string(b[:2]) != "II" {
+		return false
+	}
+	off := le32(4)
+	if off+2 > len(b) {
+		return false
+	}
+	n := le16(off)
+	for i := 0; i < n && off+2+12*i+2 <= len(b); i++ {
+		if le16(off+2+12*i) == int(tag) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..46f9706
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,503 @@
+package hegel
+
+import (
+	"fmt"
+	"image"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"golang.org/x/image/tiff"
+)
+
+// pillowModes are the modes Pillow can write for each format that x/image
+// can be expected to read (LA is read by x/image as unsupported).
+var pillowModes = map[string][]string{
+	"BMP":  {"1", "L", "P", "RGB", "RGBA"},
+	"TIFF": {"1", "L", "P", "RGB", "RGBA", "I;16", "I;16B", "LA"},
+	"WEBP": {"L", "P", "RGB", "RGBA"},
+}
+
+func isUnsupported(err error) bool {
+	if err == nil {
+		return false
+	}
+	if _, ok := err.(tiff.UnsupportedError); ok {
+		return true
+	}
+	return strings.Contains(err.Error(), "unsupported")
+}
+
+func bits(mode string) uint {
+	if strings.HasPrefix(mode, "I;16") {
+		return 16
+	}
+	return 8
+}
+
+func describe(format, mode string, s sample, opts map[string]any) string {
+	b := s.img.Bounds()
+	return fmt.Sprintf("%s %dx%d, Pillow mode %s, Go %T (%s), options %v", format, b.Dx(), b.Dy(), mode, s.img, s.fill, opts)
+}
+
+// pillowOpts draws Pillow's save options for the format.
+func pillowOpts(tc hegel.TestCase, format, mode string, h int) map[string]any {
+	opts := map[string]any{}
+	switch format {
+	case "TIFF":
+		comps := []string{"raw", "tiff_lzw", "tiff_adobe_deflate", "packbits"}
+		if mode == "1" {
+			comps = append(comps, "group3", "group4")
+		}
+		comp := pick(tc, comps...)
+		opts["compression"] = comp
+		if (comp == "tiff_lzw" || comp == "tiff_adobe_deflate") && mode != "1" && chance(tc, 40) {
+			opts["predictor"] = 2
+		}
+		if (comp == "group3" || comp == "group4") && chance(tc, 50) {
+			opts["fillorder"] = 2
+		}
+		if chance(tc, 40) {
+			opts["rowsperstrip"] = n(tc, 1, h)
+		}
+	case "WEBP":
+		opts["lossless"] = true
+		opts["exact"] = true
+		if chance(tc, 50) {
+			opts["method"] = n(tc, 0, 6)
+		}
+	}
+	return opts
+}
