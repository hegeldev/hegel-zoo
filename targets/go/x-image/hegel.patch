+// TestHegelPillowWritesXImageReads: an image Pillow writes as BMP, TIFF
+// or lossless WebP, in any of its modes and with any of its options, is
+// read back by x/image to the pixel (BMP: alpha is not carried; TIFF gray
+// with alpha: x/image says unsupported, which is allowed).
+func TestHegelPillowWritesXImageReads(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		format := pick(ht, "BMP", "TIFF", "WEBP")
+		mode := pick(ht, pillowModes[format]...)
+		s := genSample(ht, kindForMode(mode))
+		if mode == "RGB" && !s.opaque {
+			s = genSampleSized(ht, "rgba", s.Bounds().Dx(), s.Bounds().Dy())
+			s.opaque = true
+			if m, ok := s.img.(*image.RGBA); ok {
+				for i := 3; i < len(m.Pix); i += 4 {
+					m.Pix[i] = 0xff
+				}
+			}
+		}
+		if mode == "RGB" {
+			// Straight and premultiplied agree when opaque; make it so.
+			m := s.img.(*image.RGBA)
+			for y := 0; y < m.Rect.Dy(); y++ {
+				for x := 0; x < m.Rect.Dx(); x++ {
+					c := m.RGBAAt(x, y)
+					c.A = 0xff
+					m.SetRGBA(x, y, c)
+				}
+			}
+			s.opaque = true
+		}
+		b := s.Bounds()
+		w, h := b.Dx(), b.Dy()
+		opts := pillowOpts(ht, format, mode, h)
+		data, palette := toPillow(s, mode)
+		file, oerr := pillowEncode(ht, format, mode, w, h, data, palette, opts)
+		if oerr != "" {
+			count(fmt.Sprintf("Pillow cannot write %s mode %s: %.60s", format, mode, oerr))
+			return
+		}
+		desc := describe(format, mode, s, opts)
+		info := caseInfo{prop: "pillow-writes", format: format, mode: mode, kind: s.kind, opaque: s.opaque, opts: opts}
+		img, err := xDecode(format, file)
+		if err != nil {
+			if isUnsupported(err) && format == "TIFF" && mode == "LA" {
+				count("TIFF gray+alpha: x/image unsupported (allowed)")
+				return
+			}
+			info.msg = err.Error()
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: x/image cannot decode what Pillow wrote: %v\nfile: %s", desc, err, hexdump(file))
+		}
+		if mode == "LA" {
+			count("TIFF gray+alpha decoded")
+		}
+		if got := img.Bounds(); got.Dx() != w || got.Dy() != h {
+			fail(ht, "%s: x/image decoded %v, want %dx%d", desc, got, w, h)
+		}
+		if cfg, err := xDecodeConfig(format, file); err != nil || cfg.Width != w || cfg.Height != h {
+			fail(ht, "%s: DecodeConfig gave %dx%d, %v; Decode gave %dx%d", desc, cfg.Width, cfg.Height, err, w, h)
+		}
+		alpha := format != "BMP" && mode != "LA"
+		if mode == "LA" {
+			// If it decodes at all, the gray must be right; alpha is not in the Go image model for gray.
+			alpha = false
+		}
+		if d := mismatch(w, h, goPix(s.img), goPix(img), bits(mode), alpha); d != "" {
+			info.msg = d
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: x/image reads Pillow's file differently: %s\nfile: %s", desc, d, hexdump(file))
+		}
+	})
+}
+
+// tiffOpts draws x/image's tiff.Options (nil sometimes).
+func tiffOpts(tc hegel.TestCase) *tiff.Options {
+	if chance(tc, 20) {
+		return nil
+	}
+	return &tiff.Options{
+		Compression: pick(tc, tiff.Uncompressed, tiff.Deflate, tiff.Deflate, tiff.LZW, tiff.CCITTGroup3, tiff.CCITTGroup4),
+		Predictor:   chance(tc, 40),
+	}
+}
+
+func optsString(o *tiff.Options) string {
+	if o == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{Compression:%d Predictor:%v}", o.Compression, o.Predictor)
+}
+
+// TestHegelXImageWritesPillowReads: an image x/image writes as BMP or TIFF
+// is read by Pillow to the pixel (BMP: alpha is not carried; 16-bit RGBA
+// TIFFs Pillow reads at 8 bits).
+func TestHegelXImageWritesPillowReads(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		format := pick(ht, "BMP", "TIFF")
+		s := genSample(ht, pick(ht, goKinds...))
+		var topts *tiff.Options
+		if format == "TIFF" {
+			topts = tiffOpts(ht)
+		}
+		file, err := xEncode(format, s.img, topts)
+		desc := fmt.Sprintf("%s from Go %T (%s, %v), tiff options %s", format, s.img, s.fill, s.Bounds().Size(), optsString(topts))
+		if err != nil {
+			if format == "TIFF" && topts != nil && topts.Compression != tiff.Uncompressed && topts.Compression != tiff.Deflate && strings.Contains(err.Error(), "unsupported compression") {
+				count(fmt.Sprintf("tiff.Encode refuses compression %d (documented as such by Encode)", topts.Compression))
+				return
+			}
+			fail(ht, "%s: x/image cannot encode: %v", desc, err)
+		}
+		p, oerr := pillowDecode(ht, file)
+		info := caseInfo{prop: "ximage-writes", format: format, kind: s.kind, opaque: s.opaque}
+		if oerr != "" {
+			info.msg = oerr
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: Pillow cannot read what x/image wrote: %s\nfile: %s", desc, oerr, hexdump(file))
+		}
+		w, h := s.Bounds().Dx(), s.Bounds().Dy()
+		if p.w != w || p.h != h {
+			fail(ht, "%s: Pillow read %dx%d, want %dx%d", desc, p.w, p.h, w, h)
+		}
+		got, premul, err := pillowPix(p)
+		if err != nil {
+			count("Pillow mode not interpreted: " + p.mode)
+			return
+		}
+		count(fmt.Sprintf("%s %s -> Pillow %s", format, s.kind, p.mode))
+		want := goPix(s.img)
+		alpha := format == "TIFF"
+		tol := 0
+		prec := uint(8)
+		pillow16 := strings.HasPrefix(p.mode, "I;16") || p.mode == "I"
+		if pillow16 {
+			prec = 16
+		}
+		premulSource := false
+		switch s.img.(type) {
+		case *image.RGBA, *image.RGBA64, wrapped:
+			premulSource = true // written with associated alpha (or opaque)
+		}
+		switch {
+		case format == "BMP":
+			// 32-bit files hold straight alpha (Encode un-premultiplies an
+			// RGBA image and writes an NRGBA as it is); 24-bit files hold
+			// RGBA()'s colours.
+			switch s.img.(type) {
+			case *image.RGBA, *image.NRGBA:
+				want = goPix(s.img)
+			default:
+				want = goPixPremul(s.img)
+			}
+		case premul:
+			want = goPixPremul(s.img)
+		case premulSource && !s.opaque:
+			// x/image wrote associated alpha; Pillow keeps the high byte of
+			// 16-bit samples and un-premultiplies at 8 bits.
+			want = unpremul8(goPixPremul(s.img))
+			tol = 1
+		}
+		if d := mismatchTol(w, h, want, got, prec, alpha, tol); d != "" {
+			info.msg = d
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: Pillow (mode %s) reads x/image's file differently: %s\nfile: %s", desc, p.mode, d, hexdump(file))
+		}
+	})
+}
+
+// TestHegelRoundTrip: x/image's own Encode then Decode gives the image
+// back (BMP: 16-bit and generic images at 8 bits, and alpha as the format
+// carries it).
+func TestHegelRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		format := pick(ht, "BMP", "TIFF")
+		s := genSample(ht, pick(ht, goKinds...))
+		var topts *tiff.Options
+		if format == "TIFF" {
+			topts = &tiff.Options{Compression: pick(ht, tiff.Uncompressed, tiff.Deflate), Predictor: chance(ht, 40)}
+		}
+		file, err := xEncode(format, s.img, topts)
+		desc := fmt.Sprintf("%s from Go %T (%s, %v), tiff options %s", format, s.img, s.fill, s.Bounds().Size(), optsString(topts))
+		if err != nil {
+			fail(ht, "%s: Encode: %v", desc, err)
+		}
+		info := caseInfo{prop: "round-trip", format: format, kind: s.kind, opaque: s.opaque}
+		img, err := xDecode(format, file)
+		if err != nil {
+			info.msg = err.Error()
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: Decode of Encode's output: %v\nfile: %s", desc, err, hexdump(file))
+		}
+		w, h := s.Bounds().Dx(), s.Bounds().Dy()
+		if got := img.Bounds(); got.Dx() != w || got.Dy() != h {
+			fail(ht, "%s: round trip gave %v", desc, got)
+		}
+		count(fmt.Sprintf("%s %s -> %T", format, s.kind, img))
+		prec := uint(8)
+		alpha := true
+		want, got := goPix(s.img), goPix(img)
+		switch s.img.(type) {
+		case *image.Gray16, *image.RGBA64, *image.NRGBA64:
+			// TIFF carries 16 bits; BMP's generic path writes RGBA()'s
+			// colours at 8 bits.
+			prec = 16
+			if format == "BMP" {
+				prec = 8
+				want, got = goPixPremul(s.img), goPixPremul(img)
+			}
+		case wrapped:
+			// The generic paths write RGBA()'s colours at 8 bits.
+			want, got = goPixPremul(s.img), goPixPremul(img)
+		}
+		if d := mismatch(w, h, want, got, prec, alpha); d != "" {
+			info.msg = d
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: round trip changed the image: %s\nfile: %s", desc, d, hexdump(file))
+		}
+	})
+}
+
+// TestHegelLossyWebPDecodesLikeLibwebp: a lossy WebP Pillow (libwebp)
+// writes decodes in x/image to the Y, Cb, Cr (and alpha) planes libwebp
+// itself decodes.
+func TestHegelLossyWebPDecodesLikeLibwebp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		mode := pick(ht, "RGB", "RGBA")
+		s := genSample(ht, kindForMode(mode))
+		if mode == "RGB" {
+			m := s.img.(*image.RGBA)
+			for i := 3; i < len(m.Pix); i += 4 {
+				m.Pix[i] = 0xff
+			}
+			s.opaque = true
+		}
+		w, h := s.Bounds().Dx(), s.Bounds().Dy()
+		opts := map[string]any{"lossless": false, "quality": n(ht, 0, 100)}
+		if chance(ht, 50) {
+			opts["method"] = n(ht, 0, 6)
+		}
+		if chance(ht, 30) {
+			opts["exact"] = true
+		}
+		data, _ := toPillow(s, mode)
+		file, oerr := pillowEncode(ht, "WEBP", mode, w, h, data, nil, opts)
+		if oerr != "" {
+			count("Pillow cannot write lossy WebP: " + oerr)
+			return
+		}
+		desc := describe("WEBP lossy", mode, s, opts)
+		ref, oerr := libwebpYUV(ht, file, mode == "RGBA")
+		if oerr != "" {
+			count("libwebp cannot decode its own file: " + oerr)
+			return
+		}
+		info := caseInfo{prop: "lossy-webp", format: "WEBP", mode: mode, opaque: s.opaque, opts: opts}
+		img, err := xDecode("WEBP", file)
+		if err != nil {
+			info.msg = err.Error()
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: x/image cannot decode: %v\nfile: %s", desc, err, hexdump(file))
+		}
+		if ref.w != w || ref.h != h {
+			fail(ht, "%s: libwebp decoded %dx%d", desc, ref.w, ref.h)
+		}
+		var yc *image.YCbCr
+		var a []byte
+		var aStride int
+		switch m := img.(type) {
+		case *image.YCbCr:
+			yc = m
+		case *image.NYCbCrA:
+			yc = &m.YCbCr
+			a, aStride = m.A, m.AStride
+		default:
+			fail(ht, "%s: x/image decoded a %T", desc, img)
+		}
+		count(fmt.Sprintf("lossy %s -> %T", mode, img))
+		if got := yc.Bounds(); got.Dx() != w || got.Dy() != h {
+			fail(ht, "%s: x/image decoded %v", desc, got)
+		}
+		if yc.SubsampleRatio != image.YCbCrSubsampleRatio420 {
+			fail(ht, "%s: subsample ratio %v", desc, yc.SubsampleRatio)
+		}
+		w2, h2 := (w+1)/2, (h+1)/2
+		if d := planeDiff("Y", yc.Y, yc.YStride, ref.y, w, h); d != "" {
+			info.msg = d
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%s: %s\nfile: %s", desc, d, hexdump(file))
+		}
+		if d := planeDiff("Cb", yc.Cb, yc.CStride, ref.u, w2, h2); d != "" {
+			fail(ht, "%s: %s\nfile: %s", desc, d, hexdump(file))
+		}
+		if d := planeDiff("Cr", yc.Cr, yc.CStride, ref.v, w2, h2); d != "" {
+			fail(ht, "%s: %s\nfile: %s", desc, d, hexdump(file))
+		}
+		if len(ref.a) > 0 {
+			if a == nil {
+				// libwebp always has an alpha plane for VP8X+ALPH; x/image only when the ALPH chunk is present.
+				if !allByte(ref.a, 0xff) {
+					fail(ht, "%s: libwebp decodes alpha, x/image gives an opaque %T\nfile: %s", desc, img, hexdump(file))
+				}
+			} else if d := planeDiff("A", a, aStride, ref.a, w, h); d != "" {
+				fail(ht, "%s: %s\nfile: %s", desc, d, hexdump(file))
+			}
+		}
+	})
+}
+
+func allByte(b []byte, v byte) bool {
+	for _, x := range b {
+		if x != v {
+			return false
+		}
+	}
+	return true
+}
+
+func planeDiff(name string, got []byte, stride int, want []byte, w, h int) string {
+	if len(want) < w*h {
+		return fmt.Sprintf("%s plane: libwebp gave %d bytes for %dx%d", name, len(want), w, h)
+	}
+	for y := 0; y < h; y++ {
+		if len(got) < y*stride+w {
+			return fmt.Sprintf("%s plane: x/image's plane is short (%d bytes, stride %d)", name, len(got), stride)
+		}
+		g := got[y*stride : y*stride+w]
+		wr := want[y*w : (y+1)*w]
+		for x := 0; x < w; x++ {
+			if g[x] != wr[x] {
+				return fmt.Sprintf("%s plane differs at (%d,%d): x/image %d, libwebp %d\nx/image row % x\nlibwebp row % x", name, x, y, g[x], wr[x], g, wr)
+			}
+		}
+	}
+	return ""
+}
+
+// TestHegelDamagedFilesNeverPanic: Decode and DecodeConfig of a damaged
+// BMP, TIFF or WebP return an error or an image, never panic; when both
+// succeed they agree on the size.
+func TestHegelDamagedFilesNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		format := pick(ht, "BMP", "TIFF", "WEBP")
+		var file []byte
+		if format == "WEBP" || chance(ht, 30) {
+			mode := pick(ht, pillowModes[format]...)
+			if mode == "LA" {
+				mode = "L"
+			}
+			s := genSample(ht, kindForMode(mode))
+			if mode == "RGB" {
+				m := s.img.(*image.RGBA)
+				for i := 3; i < len(m.Pix); i += 4 {
+					m.Pix[i] = 0xff
+				}
+			}
+			w, h := s.Bounds().Dx(), s.Bounds().Dy()
+			opts := pillowOpts(ht, format, mode, h)
+			if format == "WEBP" && chance(ht, 50) {
+				opts = map[string]any{"lossless": false, "quality": n(ht, 0, 100)}
+			}
+			data, palette := toPillow(s, mode)
+			var oerr string
+			file, oerr = pillowEncode(ht, format, mode, w, h, data, palette, opts)
+			if oerr != "" {
+				count("Pillow cannot write: " + oerr)
+				return
+			}
+		} else {
+			s := genSample(ht, pick(ht, goKinds...))
+			var topts *tiff.Options
+			if format == "TIFF" {
+				topts = &tiff.Options{Compression: pick(ht, tiff.Uncompressed, tiff.Deflate)}
+			}
+			var err error
+			file, err = xEncode(format, s.img, topts)
+			if err != nil {
+				fail(ht, "%s: Encode: %v", format, err)
+			}
+		}
+		rounds := n(ht, 1, 3)
+		var how []string
+		for i := 0; i < rounds; i++ {
+			var what string
+			file, what = mutate(ht, file)
+			how = append(how, what)
+		}
+		desc := fmt.Sprintf("%s damaged (%s)", format, strings.Join(how, ", "))
+		cfg, cerr := xDecodeConfig(format, file)
+		if cerr == nil && (cfg.Width < 0 || cfg.Height < 0 || int64(cfg.Width)*int64(cfg.Height) > 1<<22) {
+			count("damaged file claims a huge size; Decode skipped")
+			return
+		}
+		img, err := xDecode(format, file) // a panic here is caught by property()
+		if err != nil {
+			count(format + " damaged: error")
+			return
+		}
+		count(format + " damaged: decoded")
+		if cerr != nil {
+			fail(ht, "%s: Decode succeeded but DecodeConfig failed: %v\nfile: %s", desc, cerr, hexdump(file))
+		}
+		if b := img.Bounds(); b.Dx() != cfg.Width || b.Dy() != cfg.Height {
+			fail(ht, "%s: Decode gave %v, DecodeConfig %dx%d\nfile: %s", desc, b, cfg.Width, cfg.Height, hexdump(file))
+		}
+	})
+}
