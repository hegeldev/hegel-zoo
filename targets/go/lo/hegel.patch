+package hegel
+
+// The map helpers against naive models; key order is unspecified, so slices
+// derived from maps are compared sorted.
+
+import (
+	"fmt"
+	"slices"
+	"sort"
+	"strconv"
+	"testing"
+
+	"github.com/samber/lo"
+	"hegel.dev/go/hegel"
+)
+
+func genMap(tc hegel.TestCase, maxLen int) map[int]string {
+	m := map[int]string{}
+	for _, x := range ints(tc, maxLen) {
+		m[x] = strconv.Itoa(x % 3)
+	}
+	return m
+}
+
+func sameStrMap(a, b map[int]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || v != w {
+			return false
+		}
+	}
+	return true
+}
+
+func sortedStrs(s []string) []string {
+	c := slices.Clone(s)
+	sort.Strings(c)
+	return c
+}
+
+func TestHegelMapHelpersMatchNaiveModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		m := genMap(tc, 8)
+		m2 := genMap(tc, 5)
+		keys := keysOf(m)
+		vals := []string{}
+		for _, k := range keys {
+			vals = append(vals, m[k])
+		}
