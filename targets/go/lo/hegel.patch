+func TestHegelMathHelpersMatchModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+
+		// Range / RangeFrom / RangeWithSteps
+		k := n(tc, -6, 6)
+		wantR := []int{}
+		for i := 0; i < k; i++ {
+			wantR = append(wantR, i)
+		}
+		for i := 0; i > k; i-- {
+			wantR = append(wantR, i)
+		}
+		if got := lo.Range(k); !slices.Equal(got, wantR) {
+			fail(ht, "Range(%d) %v, expected %v", k, got, wantR)
+		}
+		start := n(tc, -5, 5)
+		wantRF := lo.Map(wantR, func(x int, _ int) int { return x + start })
+		if got := lo.RangeFrom(start, k); !slices.Equal(got, wantRF) {
+			fail(ht, "RangeFrom(%d, %d) %v, expected %v", start, k, got, wantRF)
+		}
+		if got := lo.RangeFrom(float64(start)/2, k); len(got) != len(wantRF) || (len(got) > 0 && got[0] != float64(start)/2) {
+			fail(ht, "RangeFrom(%v, %d) %v", float64(start)/2, k, got)
+		}
+		end, step := n(tc, -5, 5), n(tc, -3, 3)
+		wantRS := []int{}
+		switch {
+		case step == 0 || start == end:
+		case start < end && step > 0:
+			for i := start; i < end; i += step {
+				wantRS = append(wantRS, i)
+			}
+		case start > end && step < 0:
+			for i := start; i > end; i += step {
+				wantRS = append(wantRS, i)
+			}
+		}
+		if got := lo.RangeWithSteps(start, end, step); !slices.Equal(got, wantRS) {
+			fail(ht, "RangeWithSteps(%d, %d, %d) %v, expected %v", start, end, step, got, wantRS)
+		}
+		fs, fe, fst := float64(start)/4, float64(end)/4, float64(step)/8
+		wantRSF := []float64{}
+		switch {
+		case fst == 0 || fs == fe:
+		case fs < fe && fst > 0:
+			for i := fs; i < fe; i += fst {
+				wantRSF = append(wantRSF, i)
+			}
+		case fs > fe && fst < 0:
+			for i := fs; i > fe; i += fst {
+				wantRSF = append(wantRSF, i)
+			}
+		}
+		if got := lo.RangeWithSteps(fs, fe, fst); !slices.Equal(got, wantRSF) {
+			fail(ht, "RangeWithSteps(%v, %v, %v) %v, expected %v", fs, fe, fst, got, wantRSF)
+		}
+
+		// Clamp
+		lo1, hi := n(tc, -5, 5), n(tc, -5, 5)
+		if lo1 > hi {
+			lo1, hi = hi, lo1
+		}
+		v := n(tc, -8, 8)
+		wantC := min(max(v, lo1), hi)
+		if got := lo.Clamp(v, lo1, hi); got != wantC {
+			fail(ht, "Clamp(%d, %d, %d) %d, expected %d", v, lo1, hi, got, wantC)
+		}
+
+		// Sum / Product / Mean / Mode
+		s := ints(tc, 8)
+		s = lo.Filter(s, func(x int, _ int) bool { return x > -1000 && x < 1000 })
+		sum, prod := 0, 1
+		for _, x := range s {
+			sum += x
+			prod *= x
+		}
+		if got := lo.Sum(s); got != sum {
+			fail(ht, "Sum(%v) %d, expected %d", s, got, sum)
+		}
+		if got := lo.SumBy(s, func(x int) int { return 2 * x }); got != 2*sum {
+			fail(ht, "SumBy(%v) %d, expected %d", s, got, 2*sum)
+		}
+		if got := lo.Product(s); got != prod {
+			fail(ht, "Product(%v) %d, expected %d", s, got, prod)
+		}
+		if got := lo.ProductBy(s, func(x int) int { return x }); got != prod {
+			fail(ht, "ProductBy(%v) %d, expected %d", s, got, prod)
+		}
+		wantMean := 0
+		if len(s) > 0 {
+			wantMean = sum / len(s)
+		}
+		if got := lo.Mean(s); got != wantMean {
+			fail(ht, "Mean(%v) %d, expected %d (integer division)", s, got, wantMean)
+		}
+		fsl := lo.Map(s, func(x int, _ int) float64 { return float64(x) })
+		if got := lo.Mean(fsl); len(s) > 0 && got != float64(sum)/float64(len(s)) {
+			fail(ht, "Mean(%v) %v, expected %v", fsl, got, float64(sum)/float64(len(s)))
+		}
+		if got := lo.MeanBy(s, func(x int) int { return x }); got != wantMean {
+			fail(ht, "MeanBy(%v) %d, expected %d", s, got, wantMean)
+		}
+		cnt := map[int]int{}
+		best := 0
+		for _, x := range s {
+			cnt[x]++
+			best = max(best, cnt[x])
+		}
+		wantMode := []int{}
+		for _, x := range firstOccurrences(s) {
+			if cnt[x] == best {
+				wantMode = append(wantMode, x)
+			}
+		}
+		if got := lo.Mode(s); !sameMultiset(got, wantMode) {
+			fail(ht, "Mode(%v) %v, expected the values %v (in some order)", s, got, wantMode)
+		}
+		if got, err := lo.SumByErr(s, func(x int) (int, error) { return x, nil }); err != nil || got != sum {
+			fail(ht, "SumByErr(%v) %d %v", s, got, err)
+		}
+		if len(s) > 0 {
+			if _, err := lo.MeanByErr(s, func(x int) (int, error) { return 0, errors.New("e") }); err == nil {
+				fail(ht, "MeanByErr swallowed the error")
+			}
+		}
+	})
+}
