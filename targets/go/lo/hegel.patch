+			fail(ht, "Keys %v%s", got, info())
+		}
+		both := slices.Concat(keys, keysOf(m2))
+		if got := lo.Keys(m, m2); !slices.Equal(sortedCopy(got), sortedCopy(both)) {
+			fail(ht, "Keys(m, m2) %v, expected the keys of both with repeats%s", got, info())
+		}
+		if got := lo.UniqKeys(m, m2); !slices.Equal(sortedCopy(got), sortedCopy(firstOccurrences(both))) {
+			fail(ht, "UniqKeys(m, m2) %v%s", got, info())
+		}
+		if got := lo.Values(m); !slices.Equal(sortedStrs(got), sortedStrs(vals)) {
+			fail(ht, "Values %v%s", got, info())
+		}
+		uv := lo.UniqValues(m, m2)
+		wantUV := map[string]bool{}
+		for _, v := range vals {
+			wantUV[v] = true
+		}
+		for _, v := range m2 {
+			wantUV[v] = true
+		}
+		if len(uv) != len(wantUV) || slices.ContainsFunc(uv, func(v string) bool { return !wantUV[v] }) {
+			fail(ht, "UniqValues(m, m2) %v, expected %v%s", uv, wantUV, info())
+		}
+		k := anInt(tc)
+		if len(keys) > 0 && chance(tc, 60) {
+			k = keys[n(tc, 0, len(keys)-1)]
+		}
+		_, has := m[k]
+		if got := lo.HasKey(m, k); got != has {
+			fail(ht, "HasKey(%d) %v%s", k, got, info())
+		}
+		if got := lo.ValueOr(m, k, "fb"); (has && got != m[k]) || (!has && got != "fb") {
+			fail(ht, "ValueOr(%d) %q%s", k, got, info())
+		}
+
+		// PickBy / OmitBy and their key/value forms partition the map
+		pred := func(k int, v string) bool { return k%2 == 0 }
+		wantPick, wantOmit := map[int]string{}, map[int]string{}
+		for kk, v := range m {
+			if pred(kk, v) {
+				wantPick[kk] = v
+			} else {
+				wantOmit[kk] = v
+			}
+		}
+		if got := lo.PickBy(m, pred); !sameStrMap(got, wantPick) {
+			fail(ht, "PickBy %v, expected %v%s", got, wantPick, info())
+		}
+		if got := lo.OmitBy(m, pred); !sameStrMap(got, wantOmit) {
+			fail(ht, "OmitBy %v, expected %v%s", got, wantOmit, info())
+		}
+		sel := ints(tc, 4)
+		wantPK, wantOK := map[int]string{}, map[int]string{}
+		for kk, v := range m {
+			if contains(sel, kk) {
+				wantPK[kk] = v
+			} else {
+				wantOK[kk] = v
+			}
+		}
+		if got := lo.PickByKeys(m, sel); !sameStrMap(got, wantPK) {
+			fail(ht, "PickByKeys(%v) %v, expected %v%s", sel, got, wantPK, info())
+		}
+		if got := lo.OmitByKeys(m, sel); !sameStrMap(got, wantOK) {
+			fail(ht, "OmitByKeys(%v) %v, expected %v%s", sel, got, wantOK, info())
+		}
+		selV := []string{strconv.Itoa(n(tc, -2, 2))}
+		wantPV, wantOV := map[int]string{}, map[int]string{}
+		for kk, v := range m {
+			if slices.Contains(selV, v) {
+				wantPV[kk] = v
+			} else {
+				wantOV[kk] = v
+			}
+		}
+		if got := lo.PickByValues(m, selV); !sameStrMap(got, wantPV) {
+			fail(ht, "PickByValues(%v) %v, expected %v%s", selV, got, wantPV, info())
+		}
+		if got := lo.OmitByValues(m, selV); !sameStrMap(got, wantOV) {
+			fail(ht, "OmitByValues(%v) %v, expected %v%s", selV, got, wantOV, info())
+		}
+		if got := lo.FilterKeys(m, pred); !slices.Equal(sortedCopy(got), keysOf(wantPick)) {
+			fail(ht, "FilterKeys %v%s", got, info())
+		}
+		if got := lo.FilterValues(m, pred); len(got) != len(wantPick) {
+			fail(ht, "FilterValues %v%s", got, info())
+		}
+
+		// Entries / FromEntries round trip, Invert, Assign, ChunkEntries
+		ents := lo.Entries(m)
+		if len(ents) != len(m) || slices.ContainsFunc(ents, func(e lo.Entry[int, string]) bool { return m[e.Key] != e.Value }) {
+			fail(ht, "Entries %v%s", ents, info())
+		}
+		if got := lo.FromEntries(ents); !sameStrMap(got, m) {
+			fail(ht, "FromEntries(Entries(m)) %v%s", got, info())
+		}
+		if got := lo.FromPairs(lo.ToPairs(m)); !sameStrMap(got, m) {
+			fail(ht, "FromPairs(ToPairs(m)) %v%s", got, info())
+		}
+		inv := lo.Invert(m)
+		distinct := map[string]bool{}
+		for _, v := range vals {
+			distinct[v] = true
+		}
+		if len(inv) != len(distinct) {
+			fail(ht, "Invert has %d keys, expected one per distinct value (%d)%s", len(inv), len(distinct), info())
+		}
+		for v, kk := range inv {
+			if m[kk] != v {
+				fail(ht, "Invert maps %q to %d, whose value is %q%s", v, kk, m[kk], info())
+			}
+		}
+		wantAs := map[int]string{}
+		for kk, v := range m {
+			wantAs[kk] = v
+		}
+		for kk, v := range m2 {
+			wantAs[kk] = v
+		}
+		if got := lo.Assign(m, m2); !sameStrMap(got, wantAs) {
+			fail(ht, "Assign %v, expected %v%s", got, wantAs, info())
+		}
+		size := n(tc, 1, 4)
+		chunks := lo.ChunkEntries(m, size)
+		wantN := (len(m) + size - 1) / size
+		if len(chunks) != wantN {
+			fail(ht, "ChunkEntries(%d) has %d chunks, expected %d%s", size, len(chunks), wantN, info())
+		}
+		union := map[int]string{}
+		for i, c := range chunks {
+			if (i < len(chunks)-1 && len(c) != size) || len(c) == 0 || len(c) > size {
+				fail(ht, "ChunkEntries(%d) chunk %d has %d entries%s", size, i, len(c), info())
+			}
+			for kk, v := range c {
+				if _, dup := union[kk]; dup {
+					fail(ht, "ChunkEntries(%d) repeats key %d%s", size, kk, info())
+				}
+				union[kk] = v
+			}
+		}
+		if !sameStrMap(union, m) {
+			fail(ht, "ChunkEntries(%d) chunks do not add up to the map: %v%s", size, chunks, info())
+		}
+		if _, ok := panics(func() { lo.ChunkEntries(m, 0) }); !ok {
+			fail(ht, "ChunkEntries(0) did not panic%s", info())
+		}
+
+		// MapKeys / MapValues / MapEntries / MapToSlice / FilterMapToSlice
+		if got := lo.MapKeys(m, func(v string, kk int) int { return kk ^ 1 }); len(got) != len(m) || slices.ContainsFunc(keys, func(kk int) bool { return got[kk^1] != m[kk] }) {
+			fail(ht, "MapKeys(^1) %v%s", got, info())
+		}
+		mk := lo.MapKeys(m, func(v string, kk int) string { return v })
+		if len(mk) != len(distinct) {
+			fail(ht, "MapKeys(value) has %d keys, expected %d%s", len(mk), len(distinct), info())
+		}
+		if got := lo.MapValues(m, func(v string, kk int) int { return kk + len(v) }); len(got) != len(m) || slices.ContainsFunc(keys, func(kk int) bool { return got[kk] != kk+len(m[kk]) }) {
+			fail(ht, "MapValues %v%s", got, info())
+		}
+		if got := lo.MapEntries(m, func(kk int, v string) (string, int) { return strconv.Itoa(kk), kk }); len(got) != len(m) || slices.ContainsFunc(keys, func(kk int) bool { return got[strconv.Itoa(kk)] != kk }) {
+			fail(ht, "MapEntries %v%s", got, info())
+		}
+		if got := lo.MapToSlice(m, func(kk int, v string) int { return kk }); !slices.Equal(sortedCopy(got), keys) {
+			fail(ht, "MapToSlice %v%s", got, info())
+		}
+		if got := lo.FilterMapToSlice(m, func(kk int, v string) (int, bool) { return kk, pred(kk, v) }); !slices.Equal(sortedCopy(got), keysOf(wantPick)) {
+			fail(ht, "FilterMapToSlice %v%s", got, info())
+		}
+	})
+}
