+func TestHegelTypeConditionAndErrorHelpersFollowTheirDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := ints(tc, 6)
+		x := anInt(tc)
+
+		// pointers
+		if p := lo.ToPtr(x); p == nil || *p != x || lo.FromPtr(p) != x || lo.FromPtrOr(p, 5) != x {
+			fail(ht, "ToPtr/FromPtr of %d", x)
+		}
+		if lo.FromPtr[int](nil) != 0 || lo.FromPtrOr[int](nil, 5) != 5 || lo.Nil[int]() != nil {
+			fail(ht, "FromPtr(nil)/FromPtrOr(nil)/Nil")
+		}
+		if p := lo.EmptyableToPtr(x); (x == 0) != (p == nil) || (p != nil && *p != x) {
+			fail(ht, "EmptyableToPtr(%d) %v", x, p)
+		}
+		ptrs := lo.ToSlicePtr(s)
+		if len(ptrs) != len(s) || slices.ContainsFunc(lo.Range(len(s)), func(i int) bool { return ptrs[i] == nil || *ptrs[i] != s[i] }) {
+			fail(ht, "ToSlicePtr(%v)", s)
+		}
+		if got := lo.FromSlicePtr(ptrs); !slices.Equal(got, s) {
+			fail(ht, "FromSlicePtr(ToSlicePtr(%v)) = %v", s, got)
+		}
+		if len(ptrs) > 0 {
+			i := n(tc, 0, len(ptrs)-1)
+			ptrs[i] = nil
+			want := slices.Clone(s)
+			want[i] = 0
+			if got := lo.FromSlicePtr(ptrs); !slices.Equal(got, want) {
+				fail(ht, "FromSlicePtr with a nil at %d = %v, expected %v", i, got, want)
+			}
+			want[i] = 42
+			if got := lo.FromSlicePtrOr(ptrs, 42); !slices.Equal(got, want) {
+				fail(ht, "FromSlicePtrOr with a nil at %d = %v, expected %v", i, got, want)
+			}
+		}
+		anys := lo.ToAnySlice(s)
+		if back, ok := lo.FromAnySlice[int](anys); !ok || !slices.Equal(back, s) {
+			fail(ht, "FromAnySlice(ToAnySlice(%v)) = %v %v", s, back, ok)
+		}
+		if len(anys) > 0 {
+			anys[n(tc, 0, len(anys)-1)] = "str"
+			if _, ok := lo.FromAnySlice[int](anys); ok {
+				fail(ht, "FromAnySlice accepted a string among ints")
+			}
+		}
+		if lo.IsNil(nil) != true || lo.IsNil((*int)(nil)) != true || lo.IsNil(x) != false || lo.IsNotNil((*int)(nil)) != false {
+			fail(ht, "IsNil")
+		}
+
+		// zero values and coalescing
+		if lo.IsEmpty(x) != (x == 0) || lo.IsNotEmpty(x) != (x != 0) || lo.Empty[int]() != 0 || lo.IsEmpty("") != true {
+			fail(ht, "IsEmpty(%d)", x)
+		}
+		wantCo, okCo := 0, false
+		for _, y := range s {
+			if y != 0 {
+				wantCo, okCo = y, true
+				break
+			}
+		}
+		if got, ok := lo.Coalesce(s...); got != wantCo || ok != okCo {
+			fail(ht, "Coalesce(%v) = %d %v, expected %d %v", s, got, ok, wantCo, okCo)
+		}
+		if got := lo.CoalesceOrEmpty(s...); got != wantCo {
+			fail(ht, "CoalesceOrEmpty(%v) = %d", s, got)
+		}
+		sl := [][]int{nil, {}, s, {1}}
+		if got, ok := lo.CoalesceSlice(sl...); !ok || (len(s) > 0 && !slices.Equal(got, s)) || (len(s) == 0 && !slices.Equal(got, []int{1})) {
+			fail(ht, "CoalesceSlice(nil, {}, %v, {1}) = %v %v", s, got, ok)
+		}
+		if got, ok := lo.CoalesceSlice[int](nil, nil); ok || len(got) != 0 {
+			fail(ht, "CoalesceSlice(nil, nil) = %v %v", got, ok)
+		}
+		if got, ok := lo.CoalesceMap(map[int]int(nil), map[int]int{}, map[int]int{1: 1}); !ok || len(got) != 1 {
+			fail(ht, "CoalesceMap = %v %v", got, ok)
+		}
+
+		// conditions
+		cond := chance(tc, 50)
+		if lo.Ternary(cond, 1, 2) != map[bool]int{true: 1, false: 2}[cond] {
+			fail(ht, "Ternary(%v)", cond)
+		}
+		if lo.TernaryF(cond, func() int { return 1 }, func() int { return 2 }) != map[bool]int{true: 1, false: 2}[cond] {
+			fail(ht, "TernaryF(%v)", cond)
+		}
+		a, b := chance(tc, 50), chance(tc, 50)
+		wantIf := 3
+		if a {
+			wantIf = 1
+		} else if b {
+			wantIf = 2
+		}
+		if got := lo.If(a, 1).ElseIf(b, 2).Else(3); got != wantIf {
+			fail(ht, "If(%v).ElseIf(%v).Else = %d, expected %d", a, b, got, wantIf)
+		}
+		if got := lo.IfF(a, func() int { return 1 }).ElseIfF(b, func() int { return 2 }).ElseF(func() int { return 3 }); got != wantIf {
+			fail(ht, "IfF(%v).ElseIfF(%v).ElseF = %d, expected %d", a, b, got, wantIf)
+		}
+		sw := n(tc, 0, 3)
+		wantSw := map[int]string{1: "one", 2: "two"}[sw]
+		if wantSw == "" {
+			wantSw = "other"
+		}
+		if got := lo.Switch[int, string](sw).Case(1, "one").Case(2, "two").Case(1, "uno").Default("other"); got != wantSw {
+			fail(ht, "Switch(%d) = %q, expected %q", sw, got, wantSw)
+		}
+		if got := lo.Switch[int, string](sw).CaseF(1, func() string { return "one" }).CaseF(2, func() string { return "two" }).DefaultF(func() string { return "other" }); got != wantSw {
+			fail(ht, "Switch(%d) with functions = %q, expected %q", sw, got, wantSw)
+		}
+
+		// errors: Try*, TryOr*, Must*, Validate, TryCatch, ErrorsAs
+		failing := chance(tc, 50)
+		panicking := !failing && chance(tc, 30)
+		cb := func() error {
+			if panicking {
+				panic("boom")
+			}
+			if failing {
+				return myErr{x}
+			}
+			return nil
+		}
+		if got := lo.Try(cb); got != !(failing || panicking) {
+			fail(ht, "Try = %v (failing %v panicking %v)", got, failing, panicking)
+		}
+		if got := lo.Try0(func() { _ = cb() }); got != !panicking {
+			fail(ht, "Try0 = %v (panicking %v)", got, panicking)
+		}
+		if got := lo.Try2(func() (int, error) { return x, cb() }); got != !(failing || panicking) {
+			fail(ht, "Try2 = %v", got)
+		}
+		if got, ok := lo.TryOr(func() (int, error) { return x, cb() }, 9); ok != !(failing || panicking) || (ok && got != x) || (!ok && got != 9) {
+			fail(ht, "TryOr = %d %v (failing %v panicking %v)", got, ok, failing, panicking)
+		}
+		ev, ok := lo.TryWithErrorValue(cb)
+		switch {
+		case panicking && (ok || ev != "boom"):
+			fail(ht, "TryWithErrorValue on a panic = %v %v", ev, ok)
+		case failing && (ok || ev == nil):
+			fail(ht, "TryWithErrorValue on an error = %v %v", ev, ok)
+		case !failing && !panicking && (!ok || ev != nil):
+			fail(ht, "TryWithErrorValue on success = %v %v", ev, ok)
+		}
+		caught := false
+		lo.TryCatch(cb, func() { caught = true })
+		if caught != (failing || panicking) {
+			fail(ht, "TryCatch caught %v (failing %v panicking %v)", caught, failing, panicking)
+		}
+		var caughtV any
+		lo.TryCatchWithErrorValue(cb, func(v any) { caughtV = v })
+		if (failing || panicking) == (caughtV == nil) {
+			fail(ht, "TryCatchWithErrorValue caught %v", caughtV)
+		}
+		if err := lo.Validate(cond, "bad %d", x); (err == nil) != cond || (err != nil && err.Error() != fmt.Sprintf("bad %d", x)) {
+			fail(ht, "Validate(%v) = %v", cond, err)
+		}
+		var e error
+		if failing {
+			e = myErr{x}
+		}
+		_, pk := panics(func() { lo.Must(x, e) })
+		if pk != failing {
+			fail(ht, "Must panicked %v with err %v", pk, e)
+		}
+		_, pk0 := panics(func() { lo.Must0(!failing) })
+		if pk0 != failing {
+			fail(ht, "Must0(bool) panicked %v", pk0)
+		}
+		if got := lo.Must(x, nil); got != x {
+			fail(ht, "Must returned %d", got)
+		}
+		wrapped := fmt.Errorf("wrap: %w", myErr{x})
+		if got, ok := lo.ErrorsAs[myErr](wrapped); !ok || got.code != x {
+			fail(ht, "ErrorsAs = %v %v", got, ok)
+		}
+		if _, ok := lo.ErrorsAs[myErr](errors.New("other")); ok {
+			fail(ht, "ErrorsAs matched an unrelated error")
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..da23919
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,51 @@
+package hegel
+
+// One deterministic reproduction per bug in bugs.toml; each is listed under
+// [expected_failures] in target.toml and should pass once upstream fixes it.
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/samber/lo"
+	"github.com/samber/lo/it"
+)
+
+func TestHegelPinCapitalizeLowersTheRestOfTheString(t *testing.T) {
+	// lo/1: documented as "the first character to upper case and the remaining to lower case".
+	if got := lo.Capitalize("heLLO"); got != "Hello" {
+		t.Errorf("Capitalize(heLLO) = %q", got)
+	}
+	if got := lo.Capitalize("hello world"); got != "Hello world" {
+		t.Errorf("Capitalize(hello world) = %q, expected %q", got, "Hello world")
+	}
+	if got := lo.Capitalize("8a"); got != "8a" {
+		t.Errorf("Capitalize(8a) = %q, expected %q", got, "8a")
+	}
+}
+
+func TestHegelPinSubstringCountsRunesFromTheEnd(t *testing.T) {
+	// lo/2: an offset before the start of the string starts from the beginning, as for ASCII.
+	if got := lo.Substring("ab", -3, 1); got != "a" {
+		t.Errorf("Substring(ab, -3, 1) = %q, expected %q", got, "a")
+	}
+	if got := lo.Substring("日本", -3, 1); got != "日" {
+		t.Errorf("Substring(日本, -3, 1) = %q, expected %q", got, "日")
+	}
+	if got := lo.Substring("日本", -2, 1); got != "日" {
+		t.Errorf("Substring(日本, -2, 1) = %q, expected %q", got, "日")
+	}
+}
+
+func TestHegelPinItTrimSuffixTrimsAPartialRun(t *testing.T) {
+	// lo/3: a trailing run that is not a whole number of copies of the suffix is kept entirely.
+	if got := slices.Collect(it.TrimSuffix(slices.Values([]int{1, 0, 0, 0, 0}), []int{0, 0})); !slices.Equal(got, []int{1}) {
+		t.Errorf("it.TrimSuffix([1 0 0 0 0], [0 0]) = %v, expected [1]", got)
+	}
+	if got := lo.TrimSuffix([]int{1, 0, 0, 0}, []int{0, 0}); !slices.Equal(got, []int{1, 0}) {
+		t.Errorf("lo.TrimSuffix([1 0 0 0], [0 0]) = %v, expected [1 0]", got)
+	}
+	if got := slices.Collect(it.TrimSuffix(slices.Values([]int{1, 0, 0, 0}), []int{0, 0})); !slices.Equal(got, []int{1, 0}) {
+		t.Errorf("it.TrimSuffix([1 0 0 0], [0 0]) = %v, expected [1 0]", got)
+	}
+}
diff --git a/hegel/hegel_slice_test.go b/hegel/hegel_slice_test.go
new file mode 100644
index 0000000..a7c99aa
--- /dev/null
+++ b/hegel/hegel_slice_test.go
@@ -0,0 +1,618 @@
+package hegel
+
+// The slice helpers of lo against naive models written from their documentation.
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"strconv"
+	"testing"
+
+	"github.com/samber/lo"
+	"hegel.dev/go/hegel"
+)
+
+func TestHegelSliceTransformsMatchNaiveModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := ints(tc, 12)
+		orig := slices.Clone(s)
+		m := n(tc, 2, 3)
+		even := func(x int) bool { return x%m == 0 }
+		evenI := func(x int, _ int) bool { return even(x) }
+		info := func() string { return fmt.Sprintf(" (s=%v m=%d)", orig, m) }
+
+		// Filter / Reject / FilterReject
+		wantKeep, wantDrop := []int{}, []int{}
+		for _, x := range s {
+			if even(x) {
+				wantKeep = append(wantKeep, x)
+			} else {
+				wantDrop = append(wantDrop, x)
+			}
+		}
+		if got := lo.Filter(s, evenI); !slices.Equal(got, wantKeep) {
+			fail(ht, "Filter %v, expected %v%s", got, wantKeep, info())
+		}
+		if got := lo.Reject(s, evenI); !slices.Equal(got, wantDrop) {
+			fail(ht, "Reject %v, expected %v%s", got, wantDrop, info())
+		}
+		if k, r := lo.FilterReject(s, evenI); !slices.Equal(k, wantKeep) || !slices.Equal(r, wantDrop) {
+			fail(ht, "FilterReject %v %v, expected %v %v%s", k, r, wantKeep, wantDrop, info())
+		}
+		if got, err := lo.FilterErr(s, func(x int, _ int) (bool, error) { return even(x), nil }); err != nil || !slices.Equal(got, wantKeep) {
+			fail(ht, "FilterErr %v %v, expected %v%s", got, err, wantKeep, info())
+		}
+		if len(s) > 0 {
+			bad := n(tc, 0, len(s)-1)
+			_, err := lo.FilterErr(s, func(_ int, i int) (bool, error) {
+				if i == bad {
+					return false, errors.New("boom")
+				}
+				return true, nil
+			})
+			if err == nil || err.Error() != "boom" {
+				fail(ht, "FilterErr did not return the predicate's error: %v%s", err, info())
+			}
+		}
+
+		// Map / MapErr / FilterMap / FlatMap / UniqMap
+		wantMap := make([]string, len(s))
+		for i, x := range s {
+			wantMap[i] = strconv.Itoa(x*2) + "@" + strconv.Itoa(i)
+		}
+		if got := lo.Map(s, func(x int, i int) string { return strconv.Itoa(x*2) + "@" + strconv.Itoa(i) }); !slices.Equal(got, wantMap) {
+			fail(ht, "Map %v, expected %v%s", got, wantMap, info())
+		}
+		if got, err := lo.MapErr(s, func(x int, i int) (string, error) { return wantMap[i], nil }); err != nil || !slices.Equal(got, wantMap) {
+			fail(ht, "MapErr %v %v%s", got, err, info())
+		}
+		wantFM := []int{}
+		for _, x := range s {
+			if even(x) {
+				wantFM = append(wantFM, x/m)
+			}
+		}
+		if got := lo.FilterMap(s, func(x int, _ int) (int, bool) { return x / m, even(x) }); !slices.Equal(got, wantFM) {
+			fail(ht, "FilterMap %v, expected %v%s", got, wantFM, info())
+		}
+		wantFlat := []int{}
+		for _, x := range s {
+			wantFlat = append(wantFlat, x, x+1)
+		}
+		if got := lo.FlatMap(s, func(x int, _ int) []int { return []int{x, x + 1} }); !slices.Equal(got, wantFlat) {
+			fail(ht, "FlatMap %v, expected %v%s", got, wantFlat, info())
+		}
+		wantUM := firstOccurrences(lo.Map(s, func(x int, _ int) int { return x % m }))
+		if got := lo.UniqMap(s, func(x int, _ int) int { return x % m }); !slices.Equal(got, wantUM) {
+			fail(ht, "UniqMap %v, expected %v%s", got, wantUM, info())
+		}
+
+		// Reduce / ReduceRight / ForEach / ForEachWhile / Times
+		wantRed, wantRR := "", ""
+		for i, x := range s {
+			wantRed += fmt.Sprintf("%d:%d,", i, x)
+		}
+		for i := len(s) - 1; i >= 0; i-- {
+			wantRR += fmt.Sprintf("%d:%d,", i, s[i])
+		}
+		if got := lo.Reduce(s, func(agg string, x int, i int) string { return agg + fmt.Sprintf("%d:%d,", i, x) }, ""); got != wantRed {
+			fail(ht, "Reduce %q, expected %q%s", got, wantRed, info())
+		}
+		if got := lo.ReduceRight(s, func(agg string, x int, i int) string { return agg + fmt.Sprintf("%d:%d,", i, x) }, ""); got != wantRR {
+			fail(ht, "ReduceRight %q, expected %q%s", got, wantRR, info())
+		}
+		gotFE := ""
+		lo.ForEach(s, func(x int, i int) { gotFE += fmt.Sprintf("%d:%d,", i, x) })
+		if gotFE != wantRed {
+			fail(ht, "ForEach visited %q, expected %q%s", gotFE, wantRed, info())
+		}
+		stop := n(tc, 0, len(s))
+		visited := 0
+		lo.ForEachWhile(s, func(x int, i int) bool { visited++; return i < stop })
+		if want := min(stop+1, len(s)); visited != want {
+			fail(ht, "ForEachWhile visited %d elements, expected %d (stop after index %d)%s", visited, want, stop, info())
+		}
+		k := n(tc, 0, 5)
+		wantTimes := []int{}
+		for i := 0; i < k; i++ {
+			wantTimes = append(wantTimes, i*i)
+		}
+		if got := lo.Times(k, func(i int) int { return i * i }); !slices.Equal(got, wantTimes) {
+			fail(ht, "Times(%d) %v, expected %v", k, got, wantTimes)
+		}
+		if got := lo.RepeatBy(k, func(i int) int { return i * i }); !slices.Equal(got, wantTimes) {
+			fail(ht, "RepeatBy(%d) %v, expected %v", k, got, wantTimes)
+		}
+		if got := lo.Repeat(k, cl(7)); len(got) != k || slices.ContainsFunc(got, func(x cl) bool { return x != 7 }) {
+			fail(ht, "Repeat(%d, 7) %v", k, got)
+		}
+
+		// Uniq / UniqBy / IsUniq / IsUniqBy
+		wantUniq := firstOccurrences(s)
+		if got := lo.Uniq(s); !slices.Equal(got, wantUniq) {
+			fail(ht, "Uniq %v, expected %v%s", got, wantUniq, info())
+		}
+		if got := lo.IsUniq(s); got != (len(wantUniq) == len(s)) {
+			fail(ht, "IsUniq %v%s", got, info())
+		}
+		key := func(x int) int { return x % m }
+		wantUB := []int{}
+		seenK := map[int]bool{}
+		for _, x := range s {
+			if !seenK[key(x)] {
+				seenK[key(x)] = true
+				wantUB = append(wantUB, x)
+			}
+		}
+		if got := lo.UniqBy(s, key); !slices.Equal(got, wantUB) {
+			fail(ht, "UniqBy %v, expected %v%s", got, wantUB, info())
+		}
+		if got := lo.IsUniqBy(s, key); got != (len(wantUB) == len(s)) {
+			fail(ht, "IsUniqBy %v%s", got, info())
+		}
+
+		// GroupBy / GroupByMap / PartitionBy
+		wantGB := map[int][]int{}
+		for _, x := range s {
+			wantGB[key(x)] = append(wantGB[key(x)], x)
+		}
+		if got := lo.GroupBy(s, key); !sameGroups(got, wantGB) {
+			fail(ht, "GroupBy %v, expected %v%s", got, wantGB, info())
+		}
+		wantGBM := map[int][]string{}
+		for _, x := range s {
+			wantGBM[key(x)] = append(wantGBM[key(x)], strconv.Itoa(x))
+		}
+		if got := lo.GroupByMap(s, func(x int) (int, string) { return key(x), strconv.Itoa(x) }); len(got) != len(wantGBM) || slices.ContainsFunc(keysOf(got), func(k int) bool { return !slices.Equal(got[k], wantGBM[k]) }) {
+			fail(ht, "GroupByMap %v, expected %v%s", got, wantGBM, info())
+		}
+		wantPB := [][]int{}
+		order := []int{}
+		for _, x := range s {
+			if !slices.Contains(order, key(x)) {
+				order = append(order, key(x))
+			}
+		}
+		for _, kk := range order {
+			wantPB = append(wantPB, wantGB[kk])
+		}
+		if got := lo.PartitionBy(s, key); !sameSlices(got, wantPB) {
+			fail(ht, "PartitionBy %v, expected %v%s", got, wantPB, info())
+		}
+
+		// Flatten / Concat / Reverse / Fill / Clone / Compact / Shuffle
+		parts := [][]int{ints(tc, 4), ints(tc, 4), ints(tc, 4)}
+		wantFlatten := slices.Concat(parts...)
+		if got := lo.Flatten(parts); !slices.Equal(got, wantFlatten) {
+			fail(ht, "Flatten %v, expected %v", got, wantFlatten)
+		}
+		if got := lo.Concat(parts[0], parts[1], parts[2]); !slices.Equal(got, wantFlatten) {
+			fail(ht, "Concat %v, expected %v", got, wantFlatten)
+		}
+		wantRev := slices.Clone(s)
+		slices.Reverse(wantRev)
+		if got := lo.Reverse(slices.Clone(s)); !slices.Equal(got, wantRev) {
+			fail(ht, "Reverse %v, expected %v%s", got, wantRev, info())
+		}
+		if got := lo.Fill(toCl(s), cl(9)); len(got) != len(s) || slices.ContainsFunc(got, func(x cl) bool { return x != 9 }) {
+			fail(ht, "Fill %v%s", got, info())
+		}
+		cl := lo.Clone(s)
+		if !slices.Equal(cl, s) {
+			fail(ht, "Clone %v%s", cl, info())
+		}
+		if len(cl) > 0 {
+			cl[0]++
+			if !slices.Equal(s, orig) {
+				fail(ht, "Clone shares memory with its source%s", info())
+			}
+		}
+		wantCompact := []int{}
+		for _, x := range s {
+			if x != 0 {
+				wantCompact = append(wantCompact, x)
+			}
+		}
+		if got := lo.Compact(s); !slices.Equal(got, wantCompact) {
+			fail(ht, "Compact %v, expected %v%s", got, wantCompact, info())
+		}
+		if got := lo.Shuffle(slices.Clone(s)); !sameMultiset(got, s) {
+			fail(ht, "Shuffle changed the multiset: %v%s", got, info())
+		}
+
+		// KeyBy / Associate / SliceToMap / Keyify / Count* / IsSorted*
+		wantKB := map[int]int{}
+		for _, x := range s {
+			wantKB[key(x)] = x
+		}
+		if got := lo.KeyBy(s, key); !sameIntMap(got, wantKB) {
+			fail(ht, "KeyBy %v, expected %v%s", got, wantKB, info())
+		}
+		if got := lo.Associate(s, func(x int) (int, int) { return key(x), x }); !sameIntMap(got, wantKB) {
+			fail(ht, "Associate %v, expected %v%s", got, wantKB, info())
+		}
+		if got := lo.SliceToMap(s, func(x int) (int, int) { return key(x), x }); !sameIntMap(got, wantKB) {
+			fail(ht, "SliceToMap %v, expected %v%s", got, wantKB, info())
+		}
+		if got := lo.FilterSliceToMap(s, func(x int) (int, int, bool) { return key(x), x, even(x) }); len(got) != len(lo.Filter(lo.Keys(wantKB), func(k int, _ int) bool { return k == 0 })) {
+			fail(ht, "FilterSliceToMap %v%s", got, info())
+		}
+		if got := lo.Keyify(s); len(got) != len(wantUniq) || slices.ContainsFunc(wantUniq, func(x int) bool { _, ok := got[x]; return !ok }) {
+			fail(ht, "Keyify %v%s", got, info())
+		}
+		v := anInt(tc)
+		wantCount := 0
+		for _, x := range s {
+			if x == v {
+				wantCount++
+			}
+		}
+		if got := lo.Count(s, v); got != wantCount {
+			fail(ht, "Count(%d) %d, expected %d%s", v, got, wantCount, info())
+		}
+		if got := lo.CountBy(s, even); got != len(wantKeep) {
+			fail(ht, "CountBy %d, expected %d%s", got, len(wantKeep), info())
+		}
+		wantCV := map[int]int{}
+		for _, x := range s {
+			wantCV[x]++
+		}
+		if got := lo.CountValues(s); !sameIntMap(got, wantCV) {
+			fail(ht, "CountValues %v, expected %v%s", got, wantCV, info())
+		}
+		wantCVB := map[int]int{}
+		for _, x := range s {
+			wantCVB[key(x)]++
+		}
+		if got := lo.CountValuesBy(s, key); !sameIntMap(got, wantCVB) {
+			fail(ht, "CountValuesBy %v, expected %v%s", got, wantCVB, info())
+		}
+		if got := lo.IsSorted(s); got != sort.IntsAreSorted(s) {
+			fail(ht, "IsSorted %v%s", got, info())
+		}
+		neg := lo.Map(s, func(x int, _ int) int { return -x }) // -MinInt wraps, on both sides
+		if got := lo.IsSortedBy(s, func(x int) int { return -x }); got != sort.IntsAreSorted(neg) {
+			fail(ht, "IsSortedBy(-x) %v%s", got, info())
+		}
+		if !slices.Equal(s, orig) {
+			fail(ht, "the input was modified: %v%s", s, info())
+		}
+	})
+}
+
+func sameGroups(a, b map[int][]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || !slices.Equal(v, w) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameSlices(a, b [][]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !slices.Equal(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameIntMap(a, b map[int]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || v != w {
+			return false
+		}
+	}
+	return true
+}
+
+func TestHegelSliceWindowsAndCutsMatchNaiveModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := ints(tc, 10)
+		orig := slices.Clone(s)
+		L := len(s)
+		info := func() string { return fmt.Sprintf(" (s=%v)", orig) }
+
+		// Chunk / Window / Sliding
+		size := n(tc, 1, 4)
+		wantChunk := [][]int{}
+		for i := 0; i < L; i += size {
+			wantChunk = append(wantChunk, s[i:min(i+size, L)])
+		}
+		if got := lo.Chunk(s, size); !sameSlices(got, wantChunk) {
+			fail(ht, "Chunk(%d) %v, expected %v%s", size, got, wantChunk, info())
+		}
+		if _, ok := panics(func() { lo.Chunk(s, -n(tc, 0, 1)) }); !ok {
+			fail(ht, "Chunk with a non-positive size did not panic%s", info())
+		}
+		wantWin := [][]int{}
+		for i := 0; i+size <= L; i++ {
+			wantWin = append(wantWin, s[i:i+size])
+		}
+		if got := lo.Window(s, size); !sameSlices(got, wantWin) {
+			fail(ht, "Window(%d) %v, expected %v%s", size, got, wantWin, info())
+		}
+		step := n(tc, 1, 4)
+		wantSl := [][]int{}
+		for i := 0; i+size <= L; i += step {
+			wantSl = append(wantSl, s[i:i+size])
+		}
+		if got := lo.Sliding(s, size, step); !sameSlices(got, wantSl) {
+			fail(ht, "Sliding(%d, %d) %v, expected %v%s", size, step, got, wantSl, info())
+		}
+
+		// Interleave
+		a, b, c := ints(tc, 4), ints(tc, 4), ints(tc, 4)
+		wantIL := []int{}
+		for i := 0; i < max(len(a), len(b), len(c)); i++ {
+			for _, l := range [][]int{a, b, c} {
+				if i < len(l) {
+					wantIL = append(wantIL, l[i])
+				}
+			}
+		}
+		if got := lo.Interleave(a, b, c); !slices.Equal(got, wantIL) {
+			fail(ht, "Interleave(%v, %v, %v) %v, expected %v", a, b, c, got, wantIL)
+		}
+
+		// Drop / DropRight / Take / DropWhile / DropRightWhile / TakeWhile / TakeFilter
+		k := n(tc, 0, L+2)
+		if got := lo.Drop(s, k); !slices.Equal(got, s[min(k, L):]) {
+			fail(ht, "Drop(%d) %v%s", k, got, info())
+		}
+		if got := lo.DropRight(s, k); !slices.Equal(got, s[:max(L-k, 0)]) {
+			fail(ht, "DropRight(%d) %v%s", k, got, info())
+		}
+		if got := lo.Take(s, k); !slices.Equal(got, s[:min(k, L)]) {
+			fail(ht, "Take(%d) %v%s", k, got, info())
+		}
+		for _, f := range []func(){func() { lo.Drop(s, -1) }, func() { lo.DropRight(s, -1) }, func() { lo.Take(s, -1) }} {
+			if _, ok := panics(f); !ok {
+				fail(ht, "Drop/DropRight/Take(-1) did not panic%s", info())
+			}
+		}
+		pos := func(x int) bool { return x > 0 }
+		i := 0
+		for i < L && pos(s[i]) {
+			i++
+		}
+		if got := lo.DropWhile(s, pos); !slices.Equal(got, s[i:]) {
+			fail(ht, "DropWhile %v, expected %v%s", got, s[i:], info())
+		}
+		if got := lo.TakeWhile(s, pos); !slices.Equal(got, s[:i]) {
+			fail(ht, "TakeWhile %v, expected %v%s", got, s[:i], info())
+		}
+		j := L
+		for j > 0 && pos(s[j-1]) {
+			j--
+		}
+		if got := lo.DropRightWhile(s, pos); !slices.Equal(got, s[:j]) {
+			fail(ht, "DropRightWhile %v, expected %v%s", got, s[:j], info())
+		}
+		wantTF := lo.Take(lo.Filter(s, func(x int, _ int) bool { return pos(x) }), k)
+		if got := lo.TakeFilter(s, k, func(x int, _ int) bool { return pos(x) }); !slices.Equal(got, wantTF) {
+			fail(ht, "TakeFilter(%d) %v, expected %v%s", k, got, wantTF, info())
+		}
+
+		// DropByIndex / WithoutNth
+		idx := []int{}
+		for r := n(tc, 0, 3); r > 0; r-- {
+			idx = append(idx, n(tc, -L-1, L+1))
+		}
+		drop := map[int]bool{}
+		for _, x := range idx {
+			if x < 0 {
+				x += L
+			}
+			if x >= 0 && x < L {
+				drop[x] = true
+			}
+		}
+		wantDBI := []int{}
+		for p, x := range s {
+			if !drop[p] {
+				wantDBI = append(wantDBI, x)
+			}
+		}
+		if got := lo.DropByIndex(s, idx...); !slices.Equal(got, wantDBI) {
+			fail(ht, "DropByIndex(%v) %v, expected %v%s", idx, got, wantDBI, info())
+		}
+		wantWN := []int{}
+		for p, x := range s {
+			if !slices.Contains(idx, p) {
+				wantWN = append(wantWN, x)
+			}
+		}
+		if got := lo.WithoutNth(s, idx...); !slices.Equal(got, wantWN) {
+			fail(ht, "WithoutNth(%v) %v, expected %v%s", idx, got, wantWN, info())
+		}
+
+		// Subset / Slice / Splice
+		off := n(tc, -L-2, L+2)
+		ln := n(tc, 0, L+2)
+		start := off
+		if start < 0 {
+			start = max(L+start, 0)
+		}
+		wantSub := []int{}
+		if start <= L {
+			wantSub = s[start:min(start+ln, L)]
+		}
+		if got := lo.Subset(s, off, uint(ln)); !slices.Equal(got, wantSub) {
+			fail(ht, "Subset(%d, %d) %v, expected %v%s", off, ln, got, wantSub, info())
+		}
+		st, en := n(tc, -2, L+2), n(tc, -2, L+2)
+		wantSlice := []int{}
+		if st < en {
+			cs, ce := min(max(st, 0), L), min(max(en, 0), L)
+			if cs < ce {
+				wantSlice = s[cs:ce]
+			}
+		}
+		if got := lo.Slice(s, st, en); !slices.Equal(got, wantSlice) {
+			fail(ht, "Slice(%d, %d) %v, expected %v%s", st, en, got, wantSlice, info())
+		}
+		el := ints(tc, 3)
+		at := n(tc, -L-2, L+2)
+		p := at
+		switch {
+		case p > L:
+			p = L
+		case p < -L:
+			p = 0
+		case p < 0:
+			p = L + p
+		}
+		wantSplice := slices.Concat(s[:p], el, s[p:])
+		if len(el) == 0 {
+			wantSplice = slices.Clone(s)
+		}
+		if got := lo.Splice(slices.Clone(s), at, el...); !slices.Equal(got, wantSplice) {
+			fail(ht, "Splice(%d, %v) %v, expected %v%s", at, el, got, wantSplice, info())
+		}
+
+		// Replace / ReplaceAll
+		old, nw := anInt(tc), anInt(tc)
+		if L > 0 && chance(tc, 70) {
+			old = s[n(tc, 0, L-1)]
+		}
+		cnt := n(tc, 0, L+1)
+		wantRep := slices.Clone(s)
+		left := cnt
+		for q := range wantRep {
+			if left > 0 && wantRep[q] == old {
+				wantRep[q] = nw
+				left--
+			}
+		}
+		if got := lo.Replace(s, old, nw, cnt); !slices.Equal(got, wantRep) {
+			fail(ht, "Replace(%d, %d, %d) %v, expected %v%s", old, nw, cnt, got, wantRep, info())
+		}
+		wantRA := slices.Clone(s)
+		for q := range wantRA {
+			if wantRA[q] == old {
+				wantRA[q] = nw
+			}
+		}
+		if got := lo.ReplaceAll(s, old, nw); !slices.Equal(got, wantRA) {
+			fail(ht, "ReplaceAll(%d, %d) %v, expected %v%s", old, nw, got, wantRA, info())
+		}
+		if got := lo.Replace(s, old, nw, -1); !slices.Equal(got, wantRA) {
+			fail(ht, "Replace with n = -1 %v, expected every occurrence replaced %v%s", got, wantRA, info())
+		}
+
+		// Cut / CutPrefix / CutSuffix / HasPrefix / HasSuffix / Trim*
+		sep := ints(tc, 2)
+		if L > 0 && chance(tc, 60) {
+			from := n(tc, 0, L-1)
+			sep = slices.Clone(s[from:min(from+n(tc, 1, 2), L)])
+		}
+		found := -1
+		if len(sep) > 0 {
+			for q := 0; q+len(sep) <= L; q++ {
+				if slices.Equal(s[q:q+len(sep)], sep) {
+					found = q
+					break
+				}
+			}
+		} else {
+			found = 0
+		}
+		before, after, ok := lo.Cut(s, sep)
+		if found < 0 {
+			if ok || !slices.Equal(before, s) || len(after) != 0 {
+				fail(ht, "Cut(%v) without a match gave %v %v %v%s", sep, before, after, ok, info())
+			}
+		} else if !ok || !slices.Equal(before, s[:found]) || !slices.Equal(after, s[found+len(sep):]) {
+			fail(ht, "Cut(%v) gave %v %v %v, expected %v %v true%s", sep, before, after, ok, s[:found], s[found+len(sep):], info())
+		}
+		hasP := len(sep) <= L && slices.Equal(s[:len(sep)], sep)
+		hasS := len(sep) <= L && slices.Equal(s[L-len(sep):], sep)
+		if got := lo.HasPrefix(s, sep); got != hasP {
+			fail(ht, "HasPrefix(%v) %v%s", sep, got, info())
+		}
+		if got := lo.HasSuffix(s, sep); got != hasS {
+			fail(ht, "HasSuffix(%v) %v%s", sep, got, info())
+		}
+		if got, ok := lo.CutPrefix(s, sep); ok != hasP || (hasP && !slices.Equal(got, s[len(sep):])) || (!hasP && !slices.Equal(got, s)) {
+			fail(ht, "CutPrefix(%v) %v %v%s", sep, got, ok, info())
+		}
+		if got, ok := lo.CutSuffix(s, sep); ok != hasS || (hasS && !slices.Equal(got, s[:L-len(sep)])) || (!hasS && !slices.Equal(got, s)) {
+			fail(ht, "CutSuffix(%v) %v %v%s", sep, got, ok, info())
+		}
+		cut := ints(tc, 3)
+		inCut := func(x int) bool { return slices.Contains(cut, x) }
+		lft := 0
+		for lft < L && inCut(s[lft]) {
+			lft++
+		}
+		rgt := L
+		for rgt > lft && inCut(s[rgt-1]) {
+			rgt--
+		}
+		if got := lo.TrimLeft(s, cut); !slices.Equal(got, s[lft:]) {
+			fail(ht, "TrimLeft(%v) %v, expected %v%s", cut, got, s[lft:], info())
+		}
+		rgt2 := L
+		for rgt2 > 0 && inCut(s[rgt2-1]) {
+			rgt2--
+		}
+		if got := lo.TrimRight(s, cut); !slices.Equal(got, s[:rgt2]) {
+			fail(ht, "TrimRight(%v) %v, expected %v%s", cut, got, s[:rgt2], info())
+		}
+		if got := lo.Trim(s, cut); !slices.Equal(got, s[lft:rgt]) {
+			fail(ht, "Trim(%v) %v, expected %v%s", cut, got, s[lft:rgt], info())
+		}
+		// TrimPrefix/TrimSuffix remove every leading/trailing copy of the sequence
+		tp := slices.Clone(s)
+		for len(sep) > 0 && len(tp) >= len(sep) && slices.Equal(tp[:len(sep)], sep) {
+			tp = tp[len(sep):]
+		}
+		if got := lo.TrimPrefix(s, sep); !slices.Equal(got, tp) {
+			fail(ht, "TrimPrefix(%v) %v, expected %v%s", sep, got, tp, info())
+		}
+		ts := slices.Clone(s)
+		for len(sep) > 0 && len(ts) >= len(sep) && slices.Equal(ts[len(ts)-len(sep):], sep) {
+			ts = ts[:len(ts)-len(sep)]
+		}
+		if got := lo.TrimSuffix(s, sep); !slices.Equal(got, ts) {
+			fail(ht, "TrimSuffix(%v) %v, expected %v%s", sep, got, ts, info())
+		}
+
+		// Nth / NthOr / NthOrEmpty
+		nth := n(tc, -L-2, L+1)
+		want, inRange := 0, false
+		if nth >= 0 && nth < L {
+			want, inRange = s[nth], true
+		} else if nth < 0 && -nth <= L {
+			want, inRange = s[L+nth], true
+		}
+		got, err := lo.Nth(s, nth)
+		if (err == nil) != inRange || (inRange && got != want) {
+			fail(ht, "Nth(%d) %v %v, expected %d in range %v%s", nth, got, err, want, inRange, info())
+		}
+		if got := lo.NthOr(s, nth, 99); (inRange && got != want) || (!inRange && got != 99) {
+			fail(ht, "NthOr(%d) %v%s", nth, got, info())
+		}
+		if got := lo.NthOrEmpty(s, nth); (inRange && got != want) || (!inRange && got != 0) {
+			fail(ht, "NthOrEmpty(%d) %v%s", nth, got, info())
+		}
+		if !slices.Equal(s, orig) {
+			fail(ht, "the input was modified: %v%s", s, info())
+		}
+	})
+}
diff --git a/hegel/hegel_string_test.go b/hegel/hegel_string_test.go
new file mode 100644
index 0000000..9ed6ff0
--- /dev/null
+++ b/hegel/hegel_string_test.go
@@ -0,0 +1,153 @@
+package hegel
+
+// The string helpers against rune-level models written from their documentation.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/samber/lo"
+	"golang.org/x/text/cases"
+	"golang.org/x/text/language"
+	"hegel.dev/go/hegel"
+)
+
+// Words as documented in string.go: a space at case and letter/digit
+// boundaries (two regexp passes), then the maximal runs of letters and digits.
+var (
+	reBoundary = regexp.MustCompile(`([a-z])([A-Z0-9])|([a-zA-Z])([0-9])|([0-9])([a-zA-Z])|([A-Z])([A-Z])([a-z])`)
+	reNumber   = regexp.MustCompile(`([0-9])([a-zA-Z])`)
+)
+
+func modelWords(s string) []string {
+	s = reBoundary.ReplaceAllString(s, "$1$3$5$7 $2$4$6$8$9")
+	s = reNumber.ReplaceAllString(s, "$1 $2")
+	return strings.FieldsFunc(s, func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsDigit(r) })
+}
+
+func modelCapitalizeWord(w string) string {
+	rs := []rune(strings.ToLower(w))
+	if len(rs) > 0 {
+		rs[0] = unicode.ToTitle(rs[0])
+	}
+	return string(rs)
+}
+
+func TestHegelStringHelpersMatchRuneModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		str := strs(tc, 8)
+		rs := []rune(str)
+		R := len(rs)
+		info := func() string { return fmt.Sprintf(" (str=%q runes=%d)", str, R) }
+
+		if got := lo.RuneLength(str); got != utf8.RuneCountInString(str) {
+			fail(ht, "RuneLength %d%s", got, info())
+		}
+
+		// Substring: a rune window; a negative offset counts from the end (and clamps
+		// to the start when it reaches past it); NUL runes are dropped from the result
+		off := n(tc, -R-3, R+3)
+		ln := n(tc, 0, R+2)
+		start := off
+		if start < 0 {
+			start = max(R+start, 0)
+		}
+		wantSub := ""
+		if start < R {
+			wantSub = strings.ReplaceAll(string(rs[start:min(start+ln, R)]), "\x00", "")
+		}
+		if got := lo.Substring(str, off, uint(ln)); got != wantSub {
+			if off < 0 && -off > R && -off <= len(str) {
+				// lo/2: the "offset before the start" test compares against the byte length
+				count(ht, "known lo/2")
+			} else {
+				fail(ht, "Substring(%d, %d) %q, expected %q%s", off, ln, got, wantSub, info())
+			}
+		}
+
+		// ChunkString: groups of size runes; the empty string gives [""] (documented)
+		size := n(tc, 1, 4)
+		wantCh := []string{}
+		for i := 0; i < R; i += size {
+			wantCh = append(wantCh, string(rs[i:min(i+size, R)]))
+		}
+		if R == 0 {
+			wantCh = []string{""}
+		}
+		if got := lo.ChunkString(str, size); !slices.Equal(got, wantCh) {
+			fail(ht, "ChunkString(%d) %v, expected %v%s", size, got, wantCh, info())
+		}
+		if _, ok := panics(func() { lo.ChunkString(str, 0) }); !ok {
+			fail(ht, "ChunkString(0) did not panic%s", info())
+		}
+
+		// Ellipsis: trimmed, at most length runes including the "..."
+		el := n(tc, -1, R+4)
+		trimmed := strings.TrimSpace(str)
+		trs := []rune(trimmed)
+		wantEl := trimmed
+		if len(trs) > el && len(trs) > 0 {
+			wantEl = strings.TrimSpace(string(trs[:max(el-3, 0)])) + "..."
+		}
+		if got := lo.Ellipsis(str, el); got != wantEl {
+			fail(ht, "Ellipsis(%d) %q, expected %q%s", el, got, wantEl, info())
+		}
+		if got := lo.Ellipsis(str, el); utf8.RuneCountInString(got) > max(el, 3) && len(trs) > el {
+			fail(ht, "Ellipsis(%d) %q is longer than asked%s", el, got, info())
+		}
+
+		// RandomString: size runes from the charset
+		charset := []rune("ab日")
+		sz := n(tc, 1, 6)
+		if got := lo.RandomString(sz, charset); utf8.RuneCountInString(got) != sz || strings.ContainsFunc(got, func(r rune) bool { return !slices.Contains(charset, r) }) {
+			fail(ht, "RandomString(%d) %q", sz, got)
+		}
+
+		// Words and the case conversions, on the ASCII alphabet the documented regexps speak
+		// (the converters use x/text's full case mappings, which differ from strings.ToLower
+		// on dotted I, sharp s and the like)
+		w := asciiWords(tc, 10)
+		words := modelWords(w)
+		winfo := fmt.Sprintf(" (input %q, words %q)", w, words)
+		if got := lo.Words(w); !slices.Equal(got, words) {
+			fail(ht, "Words %q, expected %q%s", got, words, winfo)
+		}
+		pascal := strings.Join(lo.Map(words, func(x string, _ int) string { return modelCapitalizeWord(x) }), "")
+		if got := lo.PascalCase(w); got != pascal {
+			fail(ht, "PascalCase %q, expected %q%s", got, pascal, winfo)
+		}
+		camel := pascal
+		if len(words) > 0 {
+			camel = strings.ToLower(words[0]) + strings.Join(lo.Map(words[1:], func(x string, _ int) string { return modelCapitalizeWord(x) }), "")
+		}
+		if got := lo.CamelCase(w); got != camel {
+			fail(ht, "CamelCase %q, expected %q%s", got, camel, winfo)
+		}
+		lower := lo.Map(words, func(x string, _ int) string { return strings.ToLower(x) })
+		if got := lo.KebabCase(w); got != strings.Join(lower, "-") {
+			fail(ht, "KebabCase %q, expected %q%s", got, strings.Join(lower, "-"), winfo)
+		}
+		if got := lo.SnakeCase(w); got != strings.Join(lower, "_") {
+			fail(ht, "SnakeCase %q, expected %q%s", got, strings.Join(lower, "_"), winfo)
+		}
+		// Capitalize: the first character upper case, the rest lower case (documented)
+		cap := ""
+		if crs := []rune(w); len(crs) > 0 {
+			cap = string(unicode.ToTitle(crs[0])) + strings.ToLower(string(crs[1:]))
+		}
+		if got := lo.Capitalize(w); got != cap {
+			if got == cases.Title(language.English).String(w) {
+				// lo/1: Capitalize title-cases every word instead of the first character only
+				count(ht, "known lo/1")
+			} else {
+				fail(ht, "Capitalize %q, expected %q (input %q)", got, cap, w)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..1508248
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,140 @@
+package hegel
+
+// Hegel properties for samber/lo: the slice, map, string, math, tuple, type,
+// condition and error helpers against naive models written from their
+// documentation, and the it (iterator), mutable and parallel variants against
+// the slice helpers they mirror. No external tools.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing (shared with the other Go targets of the zoo).
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	if lo > hi {
+		panic(fmt.Sprintf("n(%d, %d): empty range", lo, hi))
+	}
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// show renders a string with every non-ASCII or control rune escaped, so a
+// failure message can be read and replayed.
+func show(s string) string { return strconv.QuoteToASCII(s) }
