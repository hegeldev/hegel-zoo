+func TestHegelTuplesZipAndUnzipRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		a := ints(tc, 5)
+		b := lo.Map(ints(tc, 5), func(x int, _ int) string { return fmt.Sprint(x) })
+		c := lo.Map(ints(tc, 5), func(x int, _ int) bool { return x > 0 })
+		L := max(len(a), len(b))
+		pad := func(i int) (int, string) {
+			var x int
+			var y string
+			if i < len(a) {
+				x = a[i]
+			}
+			if i < len(b) {
+				y = b[i]
+			}
+			return x, y
+		}
+
+		z := lo.Zip2(a, b)
+		if len(z) != L {
+			fail(ht, "Zip2(%v, %v) has %d tuples, expected %d", a, b, len(z), L)
+		}
+		for i, tp := range z {
+			x, y := pad(i)
+			if tp.A != x || tp.B != y {
+				fail(ht, "Zip2(%v, %v)[%d] = %v, expected (%d, %q) (padding with zero values)", a, b, i, tp, x, y)
+			}
+			if xa, xb := lo.Unpack2(tp); xa != tp.A || xb != tp.B {
+				fail(ht, "Unpack2(%v) = %v %v", tp, xa, xb)
+			}
+			if lo.T2(x, y) != tp {
+				fail(ht, "T2(%d, %q) != %v", x, y, tp)
+			}
+		}
+		ua, ub := lo.Unzip2(z)
+		wantA, wantB := make([]int, L), make([]string, L)
+		for i := 0; i < L; i++ {
+			wantA[i], wantB[i] = pad(i)
+		}
+		if !slices.Equal(ua, wantA) || !slices.Equal(ub, wantB) {
+			fail(ht, "Unzip2(Zip2(%v, %v)) = %v %v", a, b, ua, ub)
+		}
+		if got := lo.ZipBy2(a, b, func(x int, y string) string { return fmt.Sprintf("%d%s", x, y) }); len(got) != L || slices.ContainsFunc(lo.Range(L), func(i int) bool { x, y := pad(i); return got[i] != fmt.Sprintf("%d%s", x, y) }) {
+			fail(ht, "ZipBy2(%v, %v) %v", a, b, got)
+		}
+		ba, bb := lo.UnzipBy2(z, func(tp lo.Tuple2[int, string]) (int, string) { return tp.A, tp.B })
+		if !slices.Equal(ba, wantA) || !slices.Equal(bb, wantB) {
+			fail(ht, "UnzipBy2 %v %v", ba, bb)
+		}
+		z3 := lo.Zip3(a, b, c)
+		L3 := max(L, len(c))
+		if len(z3) != L3 {
+			fail(ht, "Zip3 has %d tuples, expected %d", len(z3), L3)
+		}
+		u3a, u3b, u3c := lo.Unzip3(z3)
+		if len(u3a) != L3 || len(u3b) != L3 || len(u3c) != L3 || !slices.Equal(u3a[:len(a)], a) || !slices.Equal(u3b[:len(b)], b) || !slices.Equal(u3c[:len(c)], c) {
+			fail(ht, "Unzip3(Zip3(%v, %v, %v)) = %v %v %v", a, b, c, u3a, u3b, u3c)
+		}
+
+		// CrossJoin: the cartesian product in first-list-major order; empty if a list is empty
+		cj := lo.CrossJoin2(a, b)
+		wantCJ := []lo.Tuple2[int, string]{}
+		for _, x := range a {
+			for _, y := range b {
+				wantCJ = append(wantCJ, lo.T2(x, y))
+			}
+		}
+		if !slices.Equal(cj, wantCJ) {
+			fail(ht, "CrossJoin2(%v, %v) %v, expected %v", a, b, cj, wantCJ)
+		}
+		if got := lo.CrossJoinBy2(a, b, func(x int, y string) string { return fmt.Sprintf("%d%s", x, y) }); len(got) != len(wantCJ) || slices.ContainsFunc(lo.Range(len(got)), func(i int) bool { return got[i] != fmt.Sprintf("%d%s", wantCJ[i].A, wantCJ[i].B) }) {
+			fail(ht, "CrossJoinBy2(%v, %v) %v", a, b, got)
+		}
+		if got := lo.CrossJoin3(a, b, c); len(got) != len(a)*len(b)*len(c) {
+			fail(ht, "CrossJoin3 has %d tuples, expected %d", len(got), len(a)*len(b)*len(c))
+		}
+	})
+}
