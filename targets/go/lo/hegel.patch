diff --git a/hegel/hegel_find_test.go b/hegel/hegel_find_test.go
new file mode 100644
index 0000000..2db1df1
--- /dev/null
+++ b/hegel/hegel_find_test.go
@@ -0,0 +1,287 @@
+package hegel
+
+// The search and set helpers (find.go, intersect.go) against naive models.
+
+import (
+	"fmt"
+	"slices"
+	"testing"
+
+	"github.com/samber/lo"
+	"hegel.dev/go/hegel"
+)
+
+func TestHegelFindAndSetHelpersMatchNaiveModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := ints(tc, 10)
+		L := len(s)
+		v := anInt(tc)
+		if L > 0 && chance(tc, 70) {
+			v = s[n(tc, 0, L-1)]
+		}
+		info := func() string { return fmt.Sprintf(" (s=%v v=%d)", s, v) }
+
+		// IndexOf / LastIndexOf / Contains / Find*
+		first, last := -1, -1
+		for i, x := range s {
+			if x == v {
+				if first < 0 {
+					first = i
+				}
+				last = i
+			}
+		}
+		if got := lo.IndexOf(s, v); got != first {
+			fail(ht, "IndexOf %d, expected %d%s", got, first, info())
+		}
+		if got := lo.LastIndexOf(s, v); got != last {
+			fail(ht, "LastIndexOf %d, expected %d%s", got, last, info())
+		}
+		if got := lo.Contains(s, v); got != (first >= 0) {
+			fail(ht, "Contains %v%s", got, info())
+		}
+		is := func(x int) bool { return x == v }
+		if got := lo.ContainsBy(s, is); got != (first >= 0) {
+			fail(ht, "ContainsBy %v%s", got, info())
+		}
+		if got, ok := lo.Find(s, is); ok != (first >= 0) || (ok && got != v) || (!ok && got != 0) {
+			fail(ht, "Find %v %v%s", got, ok, info())
+		}
+		if got, i, ok := lo.FindIndexOf(s, is); i != first || ok != (first >= 0) || (ok && got != v) {
+			fail(ht, "FindIndexOf %v %d %v%s", got, i, ok, info())
+		}
+		if got, i, ok := lo.FindLastIndexOf(s, is); i != last || ok != (last >= 0) || (ok && got != v) {
+			fail(ht, "FindLastIndexOf %v %d %v%s", got, i, ok, info())
+		}
+		if got := lo.FindOrElse(s, 77, is); (first >= 0 && got != v) || (first < 0 && got != 77) {
+			fail(ht, "FindOrElse %v%s", got, info())
+		}
+		m := map[int]int{}
+		for i, x := range s {
+			m[i] = x
+		}
+		if k, ok := lo.FindKey(m, v); ok != (first >= 0) || (ok && m[k] != v) {
+			fail(ht, "FindKey %v %v%s", k, ok, info())
+		}
+		if k, ok := lo.FindKeyBy(m, func(_ int, x int) bool { return x == v }); ok != (first >= 0) || (ok && m[k] != v) {
+			fail(ht, "FindKeyBy %v %v%s", k, ok, info())
+		}
+
+		// FindUniques / FindDuplicates
+		cnt := map[int]int{}
+		for _, x := range s {
+			cnt[x]++
+		}
+		wantU, wantD := []int{}, []int{}
+		for _, x := range firstOccurrences(s) {
+			if cnt[x] == 1 {
+				wantU = append(wantU, x)
+			} else {
+				wantD = append(wantD, x)
+			}
+		}
+		if got := lo.FindUniques(s); !slices.Equal(got, wantU) {
+			fail(ht, "FindUniques %v, expected %v%s", got, wantU, info())
+		}
+		if got := lo.FindDuplicates(s); !slices.Equal(got, wantD) {
+			fail(ht, "FindDuplicates %v, expected %v%s", got, wantD, info())
+		}
+		abs := func(x int) int {
+			if x < 0 && x != -1<<63 {
+				return -x
+			}
+			return x
+		}
+		cntA := map[int]int{}
+		for _, x := range s {
+			cntA[abs(x)]++
+		}
+		wantUA, wantDA := []int{}, []int{}
+		seenA := map[int]bool{}
+		for _, x := range s {
+			if seenA[abs(x)] {
+				continue
+			}
+			seenA[abs(x)] = true
+			if cntA[abs(x)] == 1 {
+				wantUA = append(wantUA, x)
+			} else {
+				wantDA = append(wantDA, x)
+			}
+		}
+		if got := lo.FindUniquesBy(s, abs); !slices.Equal(got, wantUA) {
+			fail(ht, "FindUniquesBy %v, expected %v%s", got, wantUA, info())
+		}
+		if got := lo.FindDuplicatesBy(s, abs); !slices.Equal(got, wantDA) {
+			fail(ht, "FindDuplicatesBy %v, expected %v%s", got, wantDA, info())
+		}
+
+		// Min / Max / MinIndex / MaxIndex / MinBy / MaxBy / First / Last
+		if L == 0 {
+			if got := lo.Min(s); got != 0 {
+				fail(ht, "Min of empty %v", got)
+			}
+			if got, i := lo.MinIndex(s); got != 0 || i != -1 {
+				fail(ht, "MinIndex of empty %v %d", got, i)
+			}
+			if got, i := lo.MaxIndex(s); got != 0 || i != -1 {
+				fail(ht, "MaxIndex of empty %v %d", got, i)
+			}
+			if _, ok := lo.First(s); ok {
+				fail(ht, "First of empty is ok")
+			}
+			if got := lo.LastOr(s, 5); got != 5 {
+				fail(ht, "LastOr of empty %v", got)
+			}
+		} else {
+			mn, mx, mni, mxi := s[0], s[0], 0, 0
+			for i, x := range s {
+				if x < mn {
+					mn, mni = x, i
+				}
+				if x > mx {
+					mx, mxi = x, i
+				}
+			}
+			if got := lo.Min(s); got != mn {
+				fail(ht, "Min %d, expected %d%s", got, mn, info())
+			}
+			if got := lo.Max(s); got != mx {
+				fail(ht, "Max %d, expected %d%s", got, mx, info())
+			}
+			if got, i := lo.MinIndex(s); got != mn || i != mni {
+				fail(ht, "MinIndex %d %d, expected %d %d (first minimum)%s", got, i, mn, mni, info())
+			}
+			if got, i := lo.MaxIndex(s); got != mx || i != mxi {
+				fail(ht, "MaxIndex %d %d, expected %d %d (first maximum)%s", got, i, mx, mxi, info())
+			}
+			less := func(a, b int) bool { return a < b }
+			if got := lo.MinBy(s, less); got != mn {
+				fail(ht, "MinBy %d, expected %d%s", got, mn, info())
+			}
+			if got := lo.MaxBy(s, func(a, b int) bool { return a > b }); got != mx {
+				fail(ht, "MaxBy %d, expected %d%s", got, mx, info())
+			}
+			if got, i := lo.MinIndexBy(s, less); got != mn || i != mni {
+				fail(ht, "MinIndexBy %d %d, expected %d %d%s", got, i, mn, mni, info())
+			}
+			if got, ok := lo.First(s); !ok || got != s[0] {
+				fail(ht, "First %v %v%s", got, ok, info())
+			}
+			if got, ok := lo.Last(s); !ok || got != s[L-1] {
+				fail(ht, "Last %v %v%s", got, ok, info())
+			}
+			if lo.FirstOrEmpty(s) != s[0] || lo.LastOrEmpty(s) != s[L-1] || lo.FirstOr(s, 5) != s[0] || lo.LastOr(s, 5) != s[L-1] {
+				fail(ht, "FirstOr*/LastOr* disagree with First/Last%s", info())
+			}
+			if got := lo.Sample(s); !contains(s, got) {
+				fail(ht, "Sample %d is not an element%s", got, info())
+			}
+			k := n(tc, 0, L+2)
+			smp := lo.Samples(s, k)
+			if len(smp) != min(k, L) {
+				fail(ht, "Samples(%d) has %d elements%s", k, len(smp), info())
+			}
+			// a sub-multiset of s
+			left := slices.Clone(s)
+			for _, x := range smp {
+				i := slices.Index(left, x)
+				if i < 0 {
+					fail(ht, "Samples(%d) %v is not a sub-multiset%s", k, smp, info())
+				}
+				left = slices.Delete(left, i, i+1)
+			}
+		}
+
+		// Every / Some / None / Intersect / Difference / Union / Without / ElementsMatch
+		u := ints(tc, 6)
+		if chance(tc, 50) && L > 0 {
+			u = lo.Samples(s, n(tc, 1, 3))
+		}
+		inS := func(x int) bool { return contains(s, x) }
+		every, some := true, false
+		for _, x := range u {
+			if inS(x) {
+				some = true
+			} else {
+				every = false
+			}
+		}
+		if got := lo.Every(s, u); got != every {
+			fail(ht, "Every(%v) %v%s", u, got, info())
+		}
+		if got := lo.Some(s, u); got != some {
+			fail(ht, "Some(%v) %v%s", u, got, info())
+		}
+		if got := lo.None(s, u); got != !some {
+			fail(ht, "None(%v) %v%s", u, got, info())
+		}
+		pos := func(x int) bool { return x > 0 }
+		allPos, anyPos := true, false
+		for _, x := range s {
+			if pos(x) {
+				anyPos = true
+			} else {
+				allPos = false
+			}
+		}
+		if lo.EveryBy(s, pos) != allPos || lo.SomeBy(s, pos) != anyPos || lo.NoneBy(s, pos) != !anyPos {
+			fail(ht, "EveryBy/SomeBy/NoneBy disagree with the model%s", info())
+		}
+		// Intersect: the distinct elements of the first list present in every other, in order
+		wantI := []int{}
+		for _, x := range firstOccurrences(s) {
+			if contains(u, x) {
+				wantI = append(wantI, x)
+			}
+		}
+		if got := lo.Intersect(s, u); !slices.Equal(got, wantI) {
+			fail(ht, "Intersect(%v) %v, expected %v%s", u, got, wantI, info())
+		}
+		if got := lo.IntersectBy(abs, s, u); !slices.Equal(lo.Map(got, func(x int, _ int) int { return abs(x) }), lo.Map(lo.Intersect(lo.Map(s, func(x int, _ int) int { return abs(x) }), lo.Map(u, func(x int, _ int) int { return abs(x) })), func(x int, _ int) int { return x })) {
+			fail(ht, "IntersectBy(abs, %v) %v%s", u, got, info())
+		}
+		// Difference: the elements of each list absent from the other, in order, repeats kept
+		wantL, wantR := []int{}, []int{}
+		for _, x := range s {
+			if !contains(u, x) {
+				wantL = append(wantL, x)
+			}
+		}
+		for _, x := range u {
+			if !inS(x) {
+				wantR = append(wantR, x)
+			}
+		}
+		if gl, gr := lo.Difference(s, u); !slices.Equal(gl, wantL) || !slices.Equal(gr, wantR) {
+			fail(ht, "Difference(%v) %v %v, expected %v %v%s", u, gl, gr, wantL, wantR, info())
+		}
+		wantUn := firstOccurrences(slices.Concat(s, u))
+		if got := lo.Union(s, u); !slices.Equal(got, wantUn) {
+			fail(ht, "Union(%v) %v, expected %v%s", u, got, wantUn, info())
+		}
+		if got := lo.UnionBy(abs, s, u); len(got) != len(firstOccurrences(lo.Map(slices.Concat(s, u), func(x int, _ int) int { return abs(x) }))) {
+			fail(ht, "UnionBy(abs, %v) %v%s", u, got, info())
+		}
+		if got := lo.Without(s, u...); !slices.Equal(got, wantL) {
+			fail(ht, "Without(%v) %v, expected %v%s", u, got, wantL, info())
+		}
+		if got := lo.WithoutBy(s, abs, lo.Map(u, func(x int, _ int) int { return abs(x) })...); !slices.Equal(got, lo.Filter(s, func(x int, _ int) bool { return !slices.ContainsFunc(u, func(y int) bool { return abs(y) == abs(x) }) })) {
+			fail(ht, "WithoutBy(abs, %v) %v%s", u, got, info())
+		}
+		if got := lo.WithoutEmpty(s); !slices.Equal(got, lo.Compact(s)) {
+			fail(ht, "WithoutEmpty %v%s", got, info())
+		}
+		shuf := lo.Shuffle(slices.Clone(s))
+		if !lo.ElementsMatch(s, shuf) {
+			fail(ht, "ElementsMatch(s, shuffled s) is false: %v%s", shuf, info())
+		}
+		if got := lo.ElementsMatch(s, u); got != sameMultiset(s, u) {
+			fail(ht, "ElementsMatch(%v) %v%s", u, got, info())
+		}
+		if got := lo.ElementsMatchBy(s, u, abs); got != sameMultiset(lo.Map(s, func(x int, _ int) int { return abs(x) }), lo.Map(u, func(x int, _ int) int { return abs(x) })) {
+			fail(ht, "ElementsMatchBy(%v) %v%s", u, got, info())
+		}
+	})
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..bf271d0
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,121 @@
+package hegel
+
+// Generators and small helpers shared by the lo properties.
+
+import (
+	"math"
+	"slices"
+	"sort"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// ints draws a short slice of small integers with many repeats, an occasional
+// zero and an occasional extreme value.
+func ints(tc hegel.TestCase, maxLen int) []int {
+	l := n(tc, 0, maxLen)
+	out := make([]int, l)
+	for i := range out {
+		out[i] = anInt(tc)
+	}
+	return out
+}
+
+func anInt(tc hegel.TestCase) int {
+	switch {
+	case chance(tc, 8):
+		return 0
+	case chance(tc, 4):
+		return []int{math.MinInt, math.MaxInt, -1, 1000}[n(tc, 0, 3)]
+	default:
+		return n(tc, -3, 6)
+	}
+}
+
+// runePool mixes ASCII with multi-byte runes, a combining mark, a NUL and a
+// rune outside the BMP; strs draws from it, bytesStr may add invalid UTF-8.
+var runePool = []rune("aAbBzZ09 _-.,;!?éÉ日本\U0001F600́\x00ßıİ")
+
+func strs(tc hegel.TestCase, maxLen int) string {
+	l := n(tc, 0, maxLen)
+	var sb strings.Builder
+	for i := 0; i < l; i++ {
+		sb.WriteRune(runePool[n(tc, 0, len(runePool)-1)])
+	}
+	return sb.String()
+}
+
+// asciiWords draws strings made of ASCII letters, digits, spaces and
+// punctuation (the alphabet the word splitter's documented regexps speak).
+func asciiWords(tc hegel.TestCase, maxLen int) string {
+	const pool = "abcxyzABCXYZ0189  _-./"
+	l := n(tc, 0, maxLen)
+	b := make([]byte, l)
+	for i := range b {
+		b[i] = pool[n(tc, 0, len(pool)-1)]
+	}
+	return string(b)
+}
+
+// panics runs f and reports whether it panicked (and with what).
+func panics(f func()) (msg any, ok bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			msg, ok = r, true
+		}
+	}()
+	f()
+	return nil, false
+}
+
+// sortedCopy returns a sorted copy of s.
+func sortedCopy(s []int) []int {
+	c := slices.Clone(s)
+	sort.Ints(c)
+	return c
+}
+
+// sameMultiset reports whether a and b hold the same elements with the same
+// multiplicities.
+func sameMultiset(a, b []int) bool {
+	return slices.Equal(sortedCopy(a), sortedCopy(b))
+}
+
+// firstOccurrences keeps the first occurrence of each value, in order.
+func firstOccurrences(s []int) []int {
+	seen := map[int]bool{}
+	out := []int{}
+	for _, x := range s {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+func contains(s []int, x int) bool { return slices.Contains(s, x) }
+
+// keysOf returns the sorted keys of an int-keyed map.
+func keysOf[V any](m map[int]V) []int {
+	ks := make([]int, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Ints(ks)
+	return ks
+}
+
+// cl is an int with the Clone method Fill and Repeat require.
+type cl int
+
+func (c cl) Clone() cl { return c }
+
+func toCl(s []int) []cl {
+	out := make([]cl, len(s))
+	for i, x := range s {
+		out[i] = cl(x)
+	}
+	return out
+}
diff --git a/hegel/hegel_iter_test.go b/hegel/hegel_iter_test.go
new file mode 100644
index 0000000..0e649d0
--- /dev/null
+++ b/hegel/hegel_iter_test.go
@@ -0,0 +1,330 @@
+package hegel
+
+// The iterator (it), in-place (mutable) and parallel variants against the
+// slice helpers they mirror.
+
+import (
+	"fmt"
+	"iter"
+	"slices"
+	"testing"
+
+	"github.com/samber/lo"
+	"github.com/samber/lo/it"
+	"github.com/samber/lo/mutable"
+	"github.com/samber/lo/parallel"
+	"hegel.dev/go/hegel"
+)
+
+func seq(s []int) iter.Seq[int] { return slices.Values(s) }
+
+func TestHegelIteratorVariantsAgreeWithTheSliceOnes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := ints(tc, 10)
+		u := ints(tc, 4)
+		L := len(s)
+		m := n(tc, 2, 3)
+		key := func(x int) int { return x % m }
+		even := func(x int) bool { return x%m == 0 }
+		evenI := func(x int, _ int) bool { return even(x) }
+		k := n(tc, 0, L+2)
+		v := anInt(tc)
+		if L > 0 && chance(tc, 60) {
+			v = s[n(tc, 0, L-1)]
+		}
+		info := func() string { return fmt.Sprintf(" (s=%v u=%v m=%d k=%d v=%d)", s, u, m, k, v) }
+		eq := func(name string, got, want []int) {
+			if !slices.Equal(got, want) {
+				fail(ht, "it.%s %v, expected %v%s", name, got, want, info())
+			}
+		}
+		eqS := func(name string, got, want [][]int) {
+			if !sameSlices(got, want) {
+				fail(ht, "it.%s %v, expected %v%s", name, got, want, info())
+			}
+		}
+		c := slices.Collect[int]
+
+		eq("Filter", c(it.Filter(seq(s), even)), lo.Filter(s, evenI))
+		eq("FilterI", c(it.FilterI(seq(s), evenI)), lo.Filter(s, evenI))
+		eq("Reject", c(it.Reject(seq(s), even)), lo.Reject(s, evenI))
+		eq("Map", c(it.Map(seq(s), func(x int) int { return x * 3 })), lo.Map(s, func(x int, _ int) int { return x * 3 }))
+		eq("MapI", c(it.MapI(seq(s), func(x int, i int) int { return x + i })), lo.Map(s, func(x int, i int) int { return x + i }))
+		eq("FilterMap", c(it.FilterMap(seq(s), func(x int) (int, bool) { return x / m, even(x) })), lo.FilterMap(s, func(x int, _ int) (int, bool) { return x / m, even(x) }))
+		eq("RejectMap", c(it.RejectMap(seq(s), func(x int) (int, bool) { return x / m, even(x) })), lo.RejectMap(s, func(x int, _ int) (int, bool) { return x / m, even(x) }))
+		eq("FlatMap", c(it.FlatMap(seq(s), func(x int) iter.Seq[int] { return seq([]int{x, -x}) })), lo.FlatMap(s, func(x int, _ int) []int { return []int{x, -x} }))
+		eq("UniqMap", c(it.UniqMap(seq(s), key)), lo.UniqMap(s, func(x int, _ int) int { return key(x) }))
+		if got, want := it.Reduce(seq(s), func(agg string, x int) string { return agg + fmt.Sprint(x) + "," }, ""), lo.Reduce(s, func(agg string, x int, _ int) string { return agg + fmt.Sprint(x) + "," }, ""); got != want {
+			fail(ht, "it.Reduce %q, expected %q%s", got, want, info())
+		}
+		if got, want := it.ReduceLast(seq(s), func(agg string, x int) string { return agg + fmt.Sprint(x) + "," }, ""), lo.ReduceRight(s, func(agg string, x int, _ int) string { return agg + fmt.Sprint(x) + "," }, ""); got != want {
+			fail(ht, "it.ReduceLast %q, expected ReduceRight's %q%s", got, want, info())
+		}
+		eq("Uniq", c(it.Uniq(seq(s))), lo.Uniq(s))
