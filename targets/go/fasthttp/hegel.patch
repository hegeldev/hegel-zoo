+++ b/hegel/hegel_http_test.go
@@ -0,0 +1,649 @@
+package hegel
+
+// Generated HTTP/1.x requests and responses, read by fasthttp and by net/http.
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"net/http"
+	"net/textproto"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Alphabets.
+
+var headerKeys = []string{
+	"X-Custom", "Accept", "Accept-Encoding", "Accept-Language", "Cache-Control", "If-None-Match",
+	"Zoo-Key", "x-lower-case", "MIXED-cAsE-key", "Authorization", "Referer", "X-Request-Id",
+	"Content-Type", "User-Agent", "Via", "Warning", "X-Forwarded-For", "Upgrade-Insecure-Requests",
+	"ETag", "Vary", "Location", "Server", "Content-Encoding", "Content-Language", "Age", "Date",
+}
+
+// Header keys fasthttp stores in a field of its own and keeps single-valued;
+// they are generated at most once per message.
+var singleValued = map[string]bool{
+	"Content-Type": true, "User-Agent": true, "Server": true, "Content-Encoding": true,
+	"Host": true, "Content-Length": true, "Transfer-Encoding": true, "Connection": true,
+	"Trailer": true, "Cookie": true, "Set-Cookie": true,
+}
+
+var headerValues = []string{
+	"text/html; charset=utf-8", "gzip, deflate, br", "no-cache", "*/*", "en-US,en;q=0.9",
+	`W/"e-tag"`, `"quoted \"string\" here"`, "Mozilla/5.0 (X11; Linux x86_64) Zoo/1.0",
+	"Bearer abc.def-ghi_jkl", "a\tb", "x  y", "caf\xc3\xa9 \xff\x80", "0", "-1", "12345678901234567890",
+	"", "a,b,,c", "close", "keep-alive", "identity", "chunked", "100-continue",
+	strings.Repeat("v", 300), "http://example.com/a?b=c#d", "1.1 proxy", "Sun, 06 Nov 1994 08:49:37 GMT",
+	"attachment; filename=\"a b.txt\"", ";;", "=", "a=b; c=d",
+}
+
+var methods = []string{"GET", "GET", "POST", "POST", "PUT", "HEAD", "DELETE", "OPTIONS", "PATCH", "PURGE", "get", "M-SEARCH"}
+
+var hosts = []string{"example.com", "Example.COM", "example.com:8080", "localhost", "127.0.0.1:80", "[::1]:8080", "a.b-c.d", "xn--bcher-kva.example"}
+
+var targets = []string{
+	"/", "/index.html", "/a/b/c", "/a%20b", "/caf%C3%A9", "/a?b=c", "/a?b=c&d=e", "/a?", "/a?b", "/a#f",
+	"/a?b=c#frag", "/p%2Fq", "/a;b=c", "/~user/x.y", "/a/b/", "/%41%42", "/a?q=%2B+%20", "/a?x=1&x=2",
+	"/a?%zz", "/a?b==c", "/-._~!$&'()*+,;=:@", "/a?b=c&&d",
+}
+
+// ---------------------------------------------------------------------------
+// Generated shapes.
+
+type hdr struct {
+	key, value string
+	fold       bool // the value is written over an obs-fold continuation line
+	noSpace    bool // "key:value"
+	spaces     bool // "key:   value   "
+}
+
+func genHeaders(tc hegel.TestCase, seen map[string]bool) []hdr {
+	var hs []hdr
+	for k := pick(tc, 0, 1, 2, 3, 4, 6); k > 0; k-- {
+		key := pick(tc, headerKeys...)
+		canon := textproto.CanonicalMIMEHeaderKey(key)
+		if seen[canon] && singleValued[canon] {
+			continue
+		}
+		seen[canon] = true
+		h := hdr{key: key, value: pick(tc, headerValues...)}
+		if h.value == "" && (chance(tc, 50) || singleValued[canon]) {
+			h.value = "v" // an empty Content-Type, User-Agent, Server or Content-Encoding is "unset" to fasthttp
+		}
+		switch pick(tc, 0, 0, 0, 0, 1, 2, 3) {
+		case 1:
+			h.noSpace = true
+		case 2:
+			h.spaces = true
+		case 3:
+			if strings.Contains(h.value, " ") {
+				h.fold = true
+			}
+		}
+		hs = append(hs, h)
+	}
+	return hs
+}
+
+func writeHdr(b *strings.Builder, h hdr) {
+	b.WriteString(h.key)
+	switch {
+	case h.noSpace:
+		b.WriteString(":")
+	case h.spaces:
+		b.WriteString(":   ")
+	default:
+		b.WriteString(": ")
+	}
+	if h.fold {
+		i := strings.Index(h.value, " ")
+		b.WriteString(h.value[:i])
+		b.WriteString("\r\n\t")
+		b.WriteString(h.value[i+1:])
+	} else {
+		b.WriteString(h.value)
+	}
+	if h.spaces {
+		b.WriteString("  ")
+	}
+	b.WriteString("\r\n")
+}
+
+type kv struct{ k, v string }
+
+var cookieNames = []string{"session", "id", "a", "X-Token", "pref_1", "z"}
+var cookieValues = []string{"abc", "", "x=y", "a b", "1,2", "0123456789", "!#$%&'()*+-./:<=>?@[]^_`{|}~"}
+
+type cookieHdr struct {
+	cookies []kv
+	quoted  []bool
+	tight   bool // ";" without a following space
+}
+
+func genCookieHdr(tc hegel.TestCase) cookieHdr {
+	var c cookieHdr
+	for k := n(tc, 1, 3); k > 0; k-- {
+		c.cookies = append(c.cookies, kv{pick(tc, cookieNames...), pick(tc, cookieValues...)})
+		c.quoted = append(c.quoted, chance(tc, 20))
+	}
+	c.tight = chance(tc, 20)
+	return c
+}
+
+func (c cookieHdr) String() string {
+	var parts []string
+	for i, kv := range c.cookies {
+		v := kv.v
+		if c.quoted[i] {
+			v = `"` + v + `"`
+		}
+		parts = append(parts, kv.k+"="+v)
+	}
+	if c.tight {
+		return strings.Join(parts, ";")
+	}
+	return strings.Join(parts, "; ")
+}
+
+// body framing
+const (
+	framingNone = iota
+	framingLength
+	framingChunked
+)
+
+type body struct {
+	framing   int
+	data      string
+	chunks    []string // chunked: the chunks; their concatenation is data
+	exts      []string // chunked: per chunk, an extension ("" none)
+	upperHex  bool
+	trailers  []hdr
+	announced bool // a Trailer header names the trailer keys
+}
+
+var bodies = []string{"", "x", "hello world", "{\"a\": 1}", "a=1&b=2", strings.Repeat("0123456789", 50), "\x00\xff\r\n\r\n", "0\r\n\r\n"}
+
+var trailerKeys = []string{"Zoo-Sum", "X-Checksum", "Trailer-One", "Expires"}
+
+func genBody(tc hegel.TestCase, allowChunked bool) body {
+	var b body
+	b.data = pick(tc, bodies...)
+	switch {
+	case chance(tc, 30):
+		b.framing = framingNone
+	case allowChunked && chance(tc, 45):
+		b.framing = framingChunked
+	default:
+		b.framing = framingLength
+	}
+	if b.framing == framingChunked {
+		rest := b.data
+		for rest != "" {
+			cut := n(tc, 1, len(rest))
+			b.chunks = append(b.chunks, rest[:cut])
+			rest = rest[cut:]
+		}
+		for range b.chunks {
+			ext := ""
+			if chance(tc, 10) {
+				ext = pick(tc, ";ext", ";a=b", ";q=\"x\"", "; a=b")
+			}
+			b.exts = append(b.exts, ext)
+		}
+		b.upperHex = chance(tc, 20)
+		if chance(tc, 25) {
+			seen := map[string]bool{}
+			for k := n(tc, 1, 2); k > 0; k-- {
+				key := pick(tc, trailerKeys...)
+				if seen[key] {
+					continue
+				}
+				seen[key] = true
+				b.trailers = append(b.trailers, hdr{key: key, value: pick(tc, "abc", "1234", "W/\"x\"", "a, b")})
+			}
+			b.announced = chance(tc, 50)
+		}
+	}
+	return b
+}
+
+func (b body) headerLines() string {
+	switch b.framing {
+	case framingLength:
+		return fmt.Sprintf("Content-Length: %d\r\n", len(b.data))
+	case framingChunked:
+		s := "Transfer-Encoding: chunked\r\n"
+		if b.announced {
+			var ks []string
+			for _, t := range b.trailers {
+				ks = append(ks, t.key)
+			}
+			s += "Trailer: " + strings.Join(ks, ", ") + "\r\n"
+		}
+		return s
+	}
+	return ""
+}
+
+func (b body) write(sb *strings.Builder) {
+	switch b.framing {
+	case framingNone, framingLength:
+		sb.WriteString(b.data)
+	case framingChunked:
+		for i, c := range b.chunks {
+			if b.upperHex {
+				fmt.Fprintf(sb, "%X%s\r\n%s\r\n", len(c), b.exts[i], c)
+			} else {
+				fmt.Fprintf(sb, "%x%s\r\n%s\r\n", len(c), b.exts[i], c)
+			}
+		}
+		sb.WriteString("0\r\n")
+		for _, t := range b.trailers {
+			writeHdr(sb, t)
+		}
+		sb.WriteString("\r\n")
+	}
+}
+
+type request struct {
+	method, target, proto string
+	host                  string // Host header; "" omits it
+	hostLast              bool
+	headers               []hdr
+	connection            string // Connection header; "" none
+	connection2           string // a second Connection header; "" none
+	cookie                *cookieHdr
+	body                  body
+}
+
+func genRequest(tc hegel.TestCase) request {
+	var r request
+	r.method = pick(tc, methods...)
+	r.proto = pick(tc, "HTTP/1.1", "HTTP/1.1", "HTTP/1.1", "HTTP/1.0")
+	r.host = pick(tc, hosts...)
+	switch pick(tc, 0, 0, 0, 1, 2) {
+	case 0:
+		r.target = pick(tc, targets...)
+	case 1:
+		r.target = pick(tc, "http://", "https://", "HTTP://") + pick(tc, hosts...) + pick(tc, targets...)
+	case 2:
+		r.target = pick(tc, "http://", "https://") + pick(tc, hosts...)
+	}
+	if r.method == "OPTIONS" && chance(tc, 30) {
+		r.target = "*"
+	}
+	if r.proto == "HTTP/1.0" && chance(tc, 30) {
+		r.host = ""
+	}
+	r.hostLast = chance(tc, 20)
+	seen := map[string]bool{}
+	r.headers = genHeaders(tc, seen)
+	if chance(tc, 30) {
+		r.connection = pick(tc, "close", "keep-alive", "Close", "Keep-Alive", "close, TE", "upgrade", "TE, close", "keep-alive, Upgrade")
+		if chance(tc, 20) {
+			r.connection2 = pick(tc, "close", "keep-alive", "TE")
+		}
+	}
+	if chance(tc, 35) {
+		c := genCookieHdr(tc)
+		r.cookie = &c
+	}
+	r.body = genBody(tc, r.proto == "HTTP/1.1")
+	return r
+}
+
+func (r request) raw() string {
+	var b strings.Builder
+	b.WriteString(r.method + " " + r.target + " " + r.proto + "\r\n")
+	hostLine := ""
+	if r.host != "" {
+		hostLine = "Host: " + r.host + "\r\n"
+	}
+	if !r.hostLast {
+		b.WriteString(hostLine)
+	}
+	for _, h := range r.headers {
+		writeHdr(&b, h)
+	}
+	if r.connection != "" {
+		b.WriteString("Connection: " + r.connection + "\r\n")
+	}
+	if r.connection2 != "" {
+		b.WriteString("Connection: " + r.connection2 + "\r\n")
+	}
+	if r.cookie != nil {
+		b.WriteString("Cookie: " + r.cookie.String() + "\r\n")
+	}
+	b.WriteString(r.body.headerLines())
+	if r.hostLast {
+		b.WriteString(hostLine)
+	}
+	b.WriteString("\r\n")
+	r.body.write(&b)
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Views: what both parsers say, in one shape.
+
+// Keys compared through fields of their own rather than as headers.
+var framingKeys = map[string]bool{"Host": true, "Content-Length": true, "Transfer-Encoding": true, "Trailer": true, "Cookie": true, "Connection": true, "Set-Cookie": true}
+
+type msgView struct {
+	first    string // method + request-target, or status code + reason
+	http11   bool
+	host     string
+	close    bool
+	headers  map[string][]string
+	body     string
+	cookies  []kv
+	trailers map[string]string
+}
+
+func (v msgView) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "  first: %q http11=%v host=%q close=%v\n", v.first, v.http11, v.host, v.close)
+	keys := make([]string, 0, len(v.headers))
+	for k := range v.headers {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		fmt.Fprintf(&b, "  %s: %q\n", k, v.headers[k])
+	}
+	fmt.Fprintf(&b, "  body: %q\n  cookies: %q\n", v.body, v.cookies)
+	tk := make([]string, 0, len(v.trailers))
+	for k := range v.trailers {
+		tk = append(tk, k)
+	}
+	sort.Strings(tk)
+	for _, k := range tk {
+		fmt.Fprintf(&b, "  trailer %s: %q\n", k, v.trailers[k])
+	}
+	return b.String()
+}
+
+func netRequestView(raw string, trailerKeys []string) (msgView, error) {
+	r, err := http.ReadRequest(bufio.NewReader(strings.NewReader(raw)))
+	if err != nil {
+		return msgView{}, err
+	}
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return msgView{}, fmt.Errorf("body: %w", err)
+	}
+	v := msgView{first: r.Method + " " + r.RequestURI, http11: r.ProtoMajor == 1 && r.ProtoMinor == 1,
+		host: strings.ToLower(r.Host), close: r.Close, headers: map[string][]string{}, body: string(data), trailers: map[string]string{}}
+	for k, vals := range r.Header {
+		if framingKeys[k] {
+			continue
+		}
+		v.headers[k] = vals
+	}
+	for _, c := range r.Cookies() {
+		v.cookies = append(v.cookies, kv{c.Name, c.Value})
+	}
+	for _, k := range trailerKeys {
+		if vals, ok := r.Trailer[k]; ok {
+			v.trailers[k] = strings.Join(vals, ", ")
+		}
+	}
+	return v, nil
+}
+
+func fastRequestView(raw string, trailerKeys []string) (msgView, error) {
+	var req fasthttp.Request
+	if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+		return msgView{}, err
+	}
+	v := msgView{first: string(req.Header.Method()) + " " + string(req.Header.RequestURI()), http11: req.Header.IsHTTP11(),
+		host: strings.ToLower(string(req.Host())), close: req.ConnectionClose(), headers: map[string][]string{}, body: string(req.Body()), trailers: map[string]string{}}
+	isTrailer := map[string]bool{}
+	for _, k := range trailerKeys {
+		isTrailer[k] = true
+	}
+	for k, val := range req.Header.All() {
+		ks := string(k)
+		if framingKeys[ks] || isTrailer[ks] {
+			continue
+		}
+		v.headers[ks] = append(v.headers[ks], string(val))
+	}
+	for k, val := range req.Header.Cookies() {
+		v.cookies = append(v.cookies, kv{string(k), string(val)})
+	}
+	for _, k := range trailerKeys {
+		if val := req.Header.Peek(k); val != nil {
+			v.trailers[k] = string(val)
+		}
+	}
+	return v, nil
+}
+
+func (b body) trailerKeyList() []string {
+	var ks []string
+	for _, t := range b.trailers {
+		ks = append(ks, t.key)
+	}
+	return ks
+}
+
+// TestHegelRequestReadMatchesNetHTTP: a generated request read by fasthttp and
+// by net/http gives the same method, target, version, host, headers, body,
+// cookies and trailers, or both reject it.
+func TestHegelRequestReadMatchesNetHTTP(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		r := genRequest(tc)
+		raw := r.raw()
+		if id := knownRequest(r, raw); id != "" {
+			count("known " + id)
+			return
+		}
+		want, nerr := netRequestView(raw, r.body.trailerKeyList())
+		got, ferr := fastRequestView(raw, r.body.trailerKeyList())
+		switch {
+		case nerr != nil && ferr != nil:
+			count("both reject")
+			return
+		case nerr != nil:
+			fail(ht, "net/http rejects (%v), fasthttp reads\n%s\nrequest:\n%q", nerr, got, raw)
+		case ferr != nil:
+			fail(ht, "fasthttp rejects (%v), net/http reads\n%s\nrequest:\n%q", ferr, want, raw)
+		}
+		count(fmt.Sprintf("framing %d", r.body.framing))
+		if want.String() != got.String() {
+			fail(ht, "readings differ\nnet/http:\n%sfasthttp:\n%srequest:\n%q", want, got, raw)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Responses.
+
+type response struct {
+	proto      string
+	code       int
+	reason     string
+	noReason   bool
+	headers    []hdr
+	setCookies []setCookie
+	connection string
+	body       body
+}
+
+var statusCodes = []int{200, 200, 201, 204, 301, 302, 304, 400, 404, 418, 500, 503, 599}
+
+func genResponse(tc hegel.TestCase) response {
+	var r response
+	r.proto = pick(tc, "HTTP/1.1", "HTTP/1.1", "HTTP/1.1", "HTTP/1.0")
+	r.code = pick(tc, statusCodes...)
+	r.reason = http.StatusText(r.code)
+	if r.reason == "" || chance(tc, 15) {
+		r.reason = pick(tc, "Zoo Status", "OK", "Not  Found", "x")
+	}
+	r.noReason = chance(tc, 10)
+	seen := map[string]bool{}
+	r.headers = genHeaders(tc, seen)
+	for k := pick(tc, 0, 0, 0, 1, 1, 2, 3); k > 0; k-- {
+		r.setCookies = append(r.setCookies, genSetCookie(tc))
+	}
+	if chance(tc, 25) {
+		r.connection = pick(tc, "close", "keep-alive", "Close", "close, x")
+	}
+	if r.code == 204 || r.code == 304 {
+		r.body = body{framing: framingNone}
+		if chance(tc, 50) {
+			r.body = body{framing: framingLength}
+		}
+	} else {
+		r.body = genBody(tc, r.proto == "HTTP/1.1")
+	}
+	return r
+}
+
+func (r response) hasHeader(canon string) bool {
+	for _, h := range r.headers {
+		if textproto.CanonicalMIMEHeaderKey(h.key) == canon {
+			return true
+		}
+	}
+	return false
+}
+
+func (r response) raw() string {
+	var b strings.Builder
+	if r.noReason {
+		fmt.Fprintf(&b, "%s %d\r\n", r.proto, r.code)
+	} else {
+		fmt.Fprintf(&b, "%s %d %s\r\n", r.proto, r.code, r.reason)
+	}
+	for _, h := range r.headers {
+		writeHdr(&b, h)
+	}
+	for _, c := range r.setCookies {
+		b.WriteString("Set-Cookie: " + c.raw() + "\r\n")
+	}
+	if r.connection != "" {
+		b.WriteString("Connection: " + r.connection + "\r\n")
+	}
+	b.WriteString(r.body.headerLines())
+	b.WriteString("\r\n")
+	r.body.write(&b)
+	return b.String()
+}
+
+func netResponseView(raw string, trailerKeys []string) (msgView, []cookieView, error) {
+	r, err := http.ReadResponse(bufio.NewReader(strings.NewReader(raw)), nil)
+	if err != nil {
+		return msgView{}, nil, err
+	}
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return msgView{}, nil, fmt.Errorf("body: %w", err)
+	}
+	v := msgView{first: r.Status, http11: r.ProtoMajor == 1 && r.ProtoMinor == 1, close: r.Close,
+		headers: map[string][]string{}, body: string(data), trailers: map[string]string{}}
+	for k, vals := range r.Header {
+		if framingKeys[k] {
+			continue
+		}
+		v.headers[k] = vals
+	}
+	var cs []cookieView
+	for _, c := range r.Cookies() {
+		cs = append(cs, netCookieView(c))
+	}
+	for _, k := range trailerKeys {
+		if vals, ok := r.Trailer[k]; ok {
+			v.trailers[k] = strings.Join(vals, ", ")
+		}
+	}
+	return v, cs, nil
+}
+
+func fastResponseView(raw string, trailerKeys []string, hasContentType bool) (msgView, []cookieView, error) {
+	var resp fasthttp.Response
+	if err := resp.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+		return msgView{}, nil, err
+	}
+	v := msgView{first: strings.TrimRight(fmt.Sprintf("%d %s", resp.StatusCode(), resp.Header.StatusMessage()), " "), http11: resp.Header.IsHTTP11(),
+		close: resp.ConnectionClose(), headers: map[string][]string{}, body: string(resp.Body()), trailers: map[string]string{}}
+	isTrailer := map[string]bool{}
+	for _, k := range trailerKeys {
+		isTrailer[k] = true
+	}
+	for k, val := range resp.Header.All() {
+		ks := string(k)
+		if framingKeys[ks] || isTrailer[ks] {
+			continue
+		}
+		v.headers[ks] = append(v.headers[ks], string(val))
+	}
+	if !hasContentType {
+		delete(v.headers, "Content-Type") // fasthttp reports its default text/plain for a response without one
+	}
+	var cs []cookieView
+	for _, rawCookie := range resp.Header.Cookies() {
+		var c fasthttp.Cookie
+		if err := c.ParseBytes(rawCookie); err != nil {
+			cs = append(cs, cookieView{name: "<error: " + err.Error() + ">"})
+			continue
+		}
+		cs = append(cs, fastCookieView(&c))
+	}
+	for _, k := range trailerKeys {
+		if val := resp.Header.Peek(k); val != nil {
+			v.trailers[k] = string(val)
+		}
+	}
+	return v, cs, nil
+}
+
+func showCookies(cs []cookieView) string {
+	var b strings.Builder
+	for _, c := range cs {
+		fmt.Fprintf(&b, "  %s\n", c)
+	}
+	return b.String()
+}
+
+// TestHegelResponseReadMatchesNetHTTP: a generated response read by fasthttp
+// and by net/http gives the same status, headers, body, Set-Cookie cookies
+// and trailers, or both reject it.
+func TestHegelResponseReadMatchesNetHTTP(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		r := genResponse(tc)
+		raw := r.raw()
+		if id := knownResponse(r, raw); id != "" {
+			count("known " + id)
+			return
+		}
+		want, wantCookies, nerr := netResponseView(raw, r.body.trailerKeyList())
+		got, gotCookies, ferr := fastResponseView(raw, r.body.trailerKeyList(), r.hasHeader("Content-Type"))
+		switch {
+		case nerr != nil && ferr != nil:
+			count("both reject")
+			return
+		case nerr != nil:
+			fail(ht, "net/http rejects (%v), fasthttp reads\n%s\nresponse:\n%q", nerr, got, raw)
+		case ferr != nil:
+			fail(ht, "fasthttp rejects (%v), net/http reads\n%s\nresponse:\n%q", ferr, want, raw)
+		}
+		count(fmt.Sprintf("framing %d", r.body.framing))
+		if want.String() != got.String() {
+			fail(ht, "readings differ\nnet/http:\n%sfasthttp:\n%sresponse:\n%q", want, got, raw)
+		}
+		if showCookies(wantCookies) != showCookies(gotCookies) {
+			fail(ht, "Set-Cookie readings differ\nnet/http:\n%sfasthttp:\n%sresponse:\n%q", showCookies(wantCookies), showCookies(gotCookies), raw)
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..b453b04
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,136 @@
+package hegel
+
+import (
+	"bufio"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are net/http's and net/url's behaviour
+// and the RFCs (6265 for cookies, 9110/9112 for HTTP, 3986/6874 for URIs).
+
+// fasthttp/1: Max-Age with a negative value (RFC 6265 5.2.2: a delta-seconds
+// of zero or less means the cookie expires at once; net/http gives MaxAge -1)
+// makes Cookie.Parse fail, so the cookie is lost.
+func TestHegelPinNegativeMaxAge(t *testing.T) {
+	var c fasthttp.Cookie
+	if err := c.Parse("a=b; Max-Age=-1"); err != nil {
+		t.Fatalf("Parse(\"a=b; Max-Age=-1\") fails: %v; want the cookie with MaxAge -1 (net/http)", err)
+	}
+	if c.MaxAge() != -1 {
+		t.Errorf("MaxAge() = %d, want -1", c.MaxAge())
+	}
+}
+
+// fasthttp/2: an attribute value that does not parse (RFC 6265 5.2.1, 5.2.2:
+// ignore the cookie-av, keep the cookie) makes Cookie.Parse fail, and so does
+// an Expires date in RFC 1123 form with a zone other than GMT, which net/http
+// accepts.
+func TestHegelPinUnparsableAttributeDropsCookie(t *testing.T) {
+	for _, tc := range []struct {
+		header  string
+		expires int64
+	}{
+		{"a=b; Max-Age=abc", 0},
+		{"a=b; Max-Age=1.5", 0},
+		{"a=b; Expires=garbage", 0},
+		{"a=b; Expires=Thu, 01 Jan 1970 00:01:44 UTC", 104},
+	} {
+		var c fasthttp.Cookie
+		if err := c.Parse(tc.header); err != nil {
+			t.Errorf("Parse(%q) fails: %v; net/http keeps the cookie a=b", tc.header, err)
+			continue
+		}
+		if string(c.Value()) != "b" || c.MaxAge() != 0 {
+			t.Errorf("Parse(%q): value %q maxAge %d", tc.header, c.Value(), c.MaxAge())
+		}
+		if got := c.Expire(); tc.expires != 0 && got.Unix() != tc.expires {
+			t.Errorf("Parse(%q): Expire %v, want unix %d", tc.header, got, tc.expires)
+		}
+	}
+}
+
+// fasthttp/3: the close token in a Connection header is recognised only when
+// the whole value is exactly "close": "Close", "TE, close" and a close
+// followed by another Connection header leave ConnectionClose false, while
+// RFC 9110 7.6.1 makes connection options case-insensitive list members; and
+// an HTTP/1.0 request's keep-alive is looked for in the first Connection
+// header only.
+func TestHegelPinConnectionCloseToken(t *testing.T) {
+	for _, h := range []string{"Connection: Close\r\n", "Connection: TE, close\r\n", "Connection: close\r\nConnection: keep-alive\r\n"} {
+		raw := "GET / HTTP/1.1\r\nHost: h\r\n" + h + "\r\n"
+		var req fasthttp.Request
+		if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+			t.Fatalf("Read: %v", err)
+		}
+		if !req.ConnectionClose() {
+			t.Errorf("%q: ConnectionClose() false; net/http Close true", h)
+		}
+	}
+	// HTTP/1.0: keep-alive is looked for in the first Connection header only.
+	raw := "GET / HTTP/1.0\r\nHost: h\r\nConnection: upgrade\r\nConnection: keep-alive\r\n\r\n"
+	var req fasthttp.Request
+	if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+	if req.ConnectionClose() {
+		t.Errorf("HTTP/1.0 with Connection: upgrade then Connection: keep-alive: ConnectionClose() true; net/http Close false")
+	}
+}
+
+// fasthttp/4: ParseIPv4 accepts octets with leading zeros and reads them as
+// decimal ("010" is ten); Go's net and netip reject them (Go 1.17) because
+// inet_aton and other parsers read them as octal (eight).
+func TestHegelPinParseIPv4LeadingZeros(t *testing.T) {
+	if ip, err := fasthttp.ParseIPv4(nil, []byte("1.2.3.010")); err == nil {
+		t.Errorf("ParseIPv4(\"1.2.3.010\") = %v, want an error (netip: IPv4 field has octet with leading zero)", ip)
+	}
+}
+
+// fasthttp/5: SameSite with an unknown or empty value is treated as no
+// SameSite attribute; RFC 6265bis 5.6.7 says such a value means the Default
+// enforcement, as net/http reports (SameSiteDefaultMode) and as fasthttp
+// itself does for a bare "SameSite".
+func TestHegelPinSameSiteUnknownValue(t *testing.T) {
+	for _, h := range []string{"a=b; SameSite=Foo", "a=b; SameSite="} {
+		var c fasthttp.Cookie
+		if err := c.Parse(h); err != nil {
+			t.Fatalf("Parse(%q): %v", h, err)
+		}
+		if c.SameSite() != fasthttp.CookieSameSiteDefaultMode {
+			t.Errorf("Parse(%q): SameSite() = %d, want CookieSameSiteDefaultMode (%d)", h, c.SameSite(), fasthttp.CookieSameSiteDefaultMode)
+		}
+	}
+}
+
+// fasthttp/6: a host with an IPv6 zone identifier is unescaped on parsing
+// ([fe80::1%25eth0] becomes [fe80::1%eth0]) and written back as is, so
+// FullURI/String give a URI that is not valid (RFC 6874: the zone's '%' must
+// be written %25) and that net/url rejects.
+func TestHegelPinZoneIdentifierInFullURI(t *testing.T) {
+	var u fasthttp.URI
+	if err := u.Parse(nil, []byte("http://[fe80::1%25eth0]/")); err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	s := u.String()
+	if _, err := url.Parse(s); err != nil || s != "http://[fe80::1%25eth0]/" {
+		t.Errorf("String() = %q (net/url: %v), want %q", s, err, "http://[fe80::1%25eth0]/")
+	}
+}
+
+// fasthttp/7: Secure, HttpOnly and Partitioned given with a value
+// ("Secure=1") are not recognised; RFC 6265 5.2.5 and 5.2.6 set the flag
+// whatever the attribute-value, and net/http does.
+func TestHegelPinFlagAttributeWithValue(t *testing.T) {
+	var c fasthttp.Cookie
+	if err := c.Parse("a=b; Secure=1; HttpOnly=false; Partitioned=x"); err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	if !c.Secure() || !c.HTTPOnly() || !c.Partitioned() {
+		t.Errorf("Secure=1; HttpOnly=false; Partitioned=x: Secure %v HTTPOnly %v Partitioned %v, want all true (net/http)", c.Secure(), c.HTTPOnly(), c.Partitioned())
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..0538819
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+// Hegel property tests for fasthttp: generated HTTP requests, responses, URIs,
+// query strings and cookies, parsed by fasthttp and by the standard library
+// (net/http, net/url), must agree; what fasthttp writes, net/http must read as written.
+//
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
diff --git a/hegel/hegel_uri_test.go b/hegel/hegel_uri_test.go
new file mode 100644
index 0000000..68911e1
--- /dev/null
+++ b/hegel/hegel_uri_test.go
@@ -0,0 +1,353 @@
+package hegel
+
+// Query strings against net/url.ParseQuery and URIs against net/url.
+
+import (
+	"fmt"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+	"hegel.dev/go/hegel"
+)
+
+var argKeys = []string{"a", "b", "key", "k%20y", "k+y", "K", "x[]", "p.q", "", "%41", "caf%C3%A9", "a%2Bb", "~", "-_.", "!$'()*,", "k:v", "k/v", "k?v", "k@v", "%7E"}
+var argValues = []string{"", "1", "v", "a+b", "a%20b", "a%2Bb", "x=y", "%zz", "%", "%2", "caf%C3%A9", "%FF", "a&b", "1,2", "\"q\"", "%25", "~", "%7e", "a%20%20b", "\xc3\xa9"}
+
+type queryArg struct {
+	key, value string
+	noValue    bool
+}
+
+func genQuery(tc hegel.TestCase) ([]queryArg, string) {
+	var args []queryArg
+	var parts []string
+	for k := n(tc, 0, 5); k > 0; k-- {
+		a := queryArg{key: pick(tc, argKeys...), value: pick(tc, argValues...)}
+		if chance(tc, 15) {
+			a.noValue = true
+		}
+		if a.key == "" && a.value == "" && !a.noValue {
+			a.value = "1" // "=" alone: net/url keeps an empty pair, fasthttp drops it
+		}
+		args = append(args, a)
+		if a.noValue {
+			parts = append(parts, a.key)
+		} else {
+			parts = append(parts, a.key+"="+a.value)
+		}
+		if chance(tc, 5) {
+			parts = append(parts, "") // an empty pair: "&&"
+		}
+	}
+	q := strings.Join(parts, "&")
+	if chance(tc, 5) {
+		q = "&" + q
+	}
+	if chance(tc, 5) {
+		q += "&"
+	}
+	return args, q
+}
+
+// hasBadEscape reports a query string net/url rejects: a '%' not followed by
+// two hex digits, or a ';' separator.
+func hasBadEscape(q string) bool {
+	if _, err := url.ParseQuery(q); err != nil {
+		return true
+	}
+	return false
+}
+
+func showValues(v url.Values) string {
+	keys := make([]string, 0, len(v))
+	for k := range v {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var b strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&b, "  %q: %q\n", k, v[k])
+	}
+	return b.String()
+}
+
+func argsValues(a *fasthttp.Args) url.Values {
+	v := url.Values{}
+	for k, val := range a.All() {
+		v[string(k)] = append(v[string(k)], string(val))
+	}
+	return v
+}
+
+// TestHegelArgsMatchParseQuery: a query string net/url can parse gives the
+// same keys and values in fasthttp.Args; Args written back parse the same;
+// url.Values encoded by net/url parse the same in fasthttp.
+func TestHegelArgsMatchParseQuery(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		_, q := genQuery(tc)
+		if id := knownQuery(q); id != "" {
+			count("known " + id)
+			return
+		}
+		want, err := url.ParseQuery(q)
+		if err != nil {
+			count("net/url rejects")
+			return
+		}
+		count("parsed")
+		var a fasthttp.Args
+		a.Parse(q)
+		if got := argsValues(&a); showValues(got) != showValues(want) {
+			fail(ht, "Args.Parse differs from url.ParseQuery\nnet/url:\n%sfasthttp:\n%squery: %q", showValues(want), showValues(got), q)
+		}
+		// Written back by fasthttp and parsed by net/url.
+		back, err := url.ParseQuery(a.String())
+		if err != nil {
+			fail(ht, "url.ParseQuery rejects Args.String() %q: %v (query %q)", a.String(), err, q)
+		}
+		if showValues(back) != showValues(want) {
+			fail(ht, "Args.String() %q parses differently\nwant:\n%sgot:\n%squery: %q", a.String(), showValues(want), showValues(back), q)
+		}
+		// Encoded by net/url and parsed by fasthttp.
+		var b fasthttp.Args
+		b.Parse(want.Encode())
+		if got := argsValues(&b); showValues(got) != showValues(want) {
+			fail(ht, "Args.Parse of url.Values.Encode() %q differs\nwant:\n%sgot:\n%s", want.Encode(), showValues(want), showValues(got))
+		}
+		// Peek and Has agree with the map.
+		for k, vals := range want {
+			if !a.Has(k) {
+				fail(ht, "Args.Has(%q) false; net/url has %q (query %q)", k, vals, q)
+			}
+			if got := string(a.Peek(k)); got != vals[0] {
+				fail(ht, "Args.Peek(%q) = %q, first value %q (query %q)", k, got, vals[0], q)
+			}
+		}
+	})
+}
+
+// TestHegelQuotedArgMatchesQueryEscape: AppendQuotedArg is url.QueryEscape
+// and AppendUnquotedArg is url.QueryUnescape, for any bytes.
+func TestHegelQuotedArgMatchesQueryEscape(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		var b []byte
+		for k := n(tc, 0, 12); k > 0; k-- {
+			switch pick(tc, 0, 1, 2) {
+			case 0:
+				b = append(b, byte(n(tc, 0, 255)))
+			case 1:
+				b = append(b, pick(tc, "a", "Z", "0", " ", "+", "%", "%41", "%zz", "-", "_", ".", "~", "!", "*", "'", "(", ")", "/", "?", "&", "=", "#")...)
+			case 2:
+				b = append(b, "\xc3\xa9"...)
+			}
+		}
+		esc := string(fasthttp.AppendQuotedArg(nil, b))
+		if want := url.QueryEscape(string(b)); esc != want {
+			fail(ht, "AppendQuotedArg(%q) = %q, url.QueryEscape %q", b, esc, want)
+		}
+		if back := string(fasthttp.AppendUnquotedArg(nil, []byte(esc))); back != string(b) {
+			fail(ht, "AppendUnquotedArg(AppendQuotedArg(%q)) = %q", b, back)
+		}
+		want, err := url.QueryUnescape(string(b))
+		if err != nil {
+			count("not a valid escape")
+			return
+		}
+		count("ok")
+		if got := string(fasthttp.AppendUnquotedArg(nil, b)); got != want {
+			fail(ht, "AppendUnquotedArg(%q) = %q, url.QueryUnescape %q", b, got, want)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// URIs.
+
+var pathSegments = []string{"a", "index.html", "a%20b", "caf%C3%A9", "%41%42", "~user", "x.y", "-._~", "!$&'()*+,;=", ":@", "%2F", "a%3Fb", "%23", "p%25q", "AZ09", "%C3%A9", "%e2%82%ac", "\xc3\xa9", "a b", "q?r", "s#t", ".", "..", "%2e%2e"}
+
+type uriSpec struct {
+	scheme, userinfo, host, port string
+	segments                     []string
+	trailingSlash                bool
+	query, fragment              string
+	hasQuery, hasFragment        bool
+}
+
+func genURI(tc hegel.TestCase) uriSpec {
+	var u uriSpec
+	u.scheme = pick(tc, "http", "https", "HTTP", "Https", "ftp", "ws", "a+b-c.d")
+	if chance(tc, 20) {
+		u.userinfo = pick(tc, "user", "user:pass", "u.s-e_r~:p!$&'()*+,;=", "a%20b:c", ":", "user:")
+	}
+	u.host = pick(tc, "example.com", "Example.COM", "localhost", "127.0.0.1", "[::1]", "[fe80::1%25eth0]", "a.b-c.d", "xn--bcher-kva.example", "")
+	if chance(tc, 30) {
+		u.port = pick(tc, "80", "8080", "0", "65535", "")
+	}
+	for k := n(tc, 0, 4); k > 0; k-- {
+		u.segments = append(u.segments, pick(tc, pathSegments...))
+	}
+	u.trailingSlash = chance(tc, 20)
+	if chance(tc, 50) {
+		u.hasQuery = true
+		_, u.query = genQuery(tc)
+	}
+	if chance(tc, 30) {
+		u.hasFragment = true
+		u.fragment = pick(tc, "", "frag", "a%20b", "a/b?c", "x=y&z", "%zz", "caf%C3%A9")
+	}
+	return u
+}
+
+func (u uriSpec) path() string {
+	p := ""
+	for _, s := range u.segments {
+		p += "/" + s
+	}
+	if u.trailingSlash || len(u.segments) == 0 {
+		p += "/"
+	}
+	return p
+}
+
+// rawPath is the path as written: up to the first '?' or '#'.
+func (u uriSpec) rawPath() string {
+	p := u.path()
+	if i := strings.IndexAny(p, "?#"); i >= 0 {
+		p = p[:i]
+	}
+	return p
+}
+
+// rawFragment is the fragment as written: after the first '#' of the URI.
+func (u uriSpec) rawFragment() string {
+	s := u.String()
+	if i := strings.Index(s[len(u.scheme)+3+len(u.authority()):], "#"); i >= 0 {
+		return s[len(u.scheme)+3+len(u.authority())+i+1:]
+	}
+	return ""
+}
+
+func (u uriSpec) authority() string {
+	a := u.host
+	if u.port != "" {
+		a += ":" + u.port
+	}
+	if u.userinfo != "" {
+		a = u.userinfo + "@" + a
+	}
+	return a
+}
+
+func (u uriSpec) String() string {
+	s := u.scheme + "://" + u.authority() + u.path()
+	if u.hasQuery {
+		s += "?" + u.query
+	}
+	if u.hasFragment {
+		s += "#" + u.fragment
+	}
+	return s
+}
+
+// plainPath reports a path fasthttp's normalisation leaves alone: no dot
+// segments, no empty segments, no escaped slash.
+func (u uriSpec) plainPath() bool {
+	for _, s := range u.segments {
+		if s == "." || s == ".." || s == "%2e%2e" || strings.EqualFold(s, "%2F") {
+			return false
+		}
+	}
+	return true
+}
+
+func lowerHost(h string) string { return strings.ToLower(h) }
+
+// TestHegelURIMatchesNetURL: an absolute URI parsed by fasthttp.URI and by
+// net/url gives the same scheme, user, host, path, query and fragment, and
+// fasthttp's re-serialisation means the same to net/url.
+func TestHegelURIMatchesNetURL(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		spec := genURI(tc)
+		s := spec.String()
+		if id := knownURI(spec, s); id != "" {
+			count("known " + id)
+			return
+		}
+		want, err := url.Parse(s)
+		var u fasthttp.URI
+		ferr := u.Parse(nil, []byte(s))
+		switch {
+		case err != nil && ferr != nil:
+			count("both reject")
+			return
+		case err != nil:
+			if strings.Contains(err.Error(), "invalid URL escape") {
+				count("net/url rejects a bad escape") // fasthttp keeps a '%' that starts no escape, by design
+				return
+			}
+			fail(ht, "net/url rejects %q (%v), fasthttp gives %q", s, err, u.String())
+		case ferr != nil:
+			fail(ht, "fasthttp rejects %q (%v), net/url gives %+v", s, ferr, want)
+		}
+		count("parsed")
+		if got := string(u.Scheme()); got != want.Scheme {
+			fail(ht, "Scheme %q, net/url %q (uri %q)", got, want.Scheme, s)
+		}
+		if got := string(u.Host()); got != lowerHost(want.Host) {
+			fail(ht, "Host %q, net/url %q (uri %q)", got, want.Host, s)
+		}
+		wantUser, wantPass := "", ""
+		if want.User != nil {
+			wantUser = want.User.Username()
+			wantPass, _ = want.User.Password()
+		}
+		// net/url decodes escapes in userinfo; fasthttp keeps them.
+		if got, _ := url.PathUnescape(string(u.Username())); got != wantUser {
+			fail(ht, "Username %q, net/url %q (uri %q)", u.Username(), wantUser, s)
+		}
+		if got, _ := url.PathUnescape(string(u.Password())); got != wantPass {
+			fail(ht, "Password %q, net/url %q (uri %q)", u.Password(), wantPass, s)
+		}
+		if got := string(u.PathOriginal()); got != spec.rawPath() {
+			fail(ht, "PathOriginal %q, want the path as written %q (uri %q)", got, spec.rawPath(), s)
+		}
+		if spec.plainPath() {
+			if got := string(u.Path()); got != want.Path {
+				fail(ht, "Path %q, net/url %q (uri %q)", got, want.Path, s)
+			}
+		}
+		if got := string(u.QueryString()); got != want.RawQuery {
+			fail(ht, "QueryString %q, net/url RawQuery %q (uri %q)", got, want.RawQuery, s)
+		}
+		if got := string(u.Hash()); got != spec.rawFragment() {
+			fail(ht, "Hash %q, want the fragment as written %q (uri %q)", got, spec.rawFragment(), s)
+		}
+		// Re-serialised by fasthttp, parsed by net/url: the same meaning.
+		full := u.String()
+		back, err := url.Parse(full)
+		if err != nil {
+			fail(ht, "net/url rejects fasthttp's FullURI %q: %v (from %q)", full, err, s)
+		}
+		if back.Scheme != want.Scheme || lowerHost(back.Host) != lowerHost(want.Host) || back.RawQuery != want.RawQuery || back.Fragment != want.Fragment {
+			fail(ht, "fasthttp's FullURI %q means something else to net/url than %q:\n%+v\n%+v", full, s, back, want)
+		}
+		if spec.plainPath() && back.Path != want.Path {
+			fail(ht, "fasthttp's FullURI %q has path %q, net/url read %q from %q", full, back.Path, want.Path, s)
+		}
+		if spec.plainPath() {
+			req, err := url.ParseRequestURI(string(u.RequestURI()))
+			if err != nil {
+				fail(ht, "net/url rejects RequestURI %q: %v (uri %q)", u.RequestURI(), err, s)
+			}
+			if req.Path != want.Path || req.RawQuery != want.RawQuery {
+				fail(ht, "RequestURI %q: path %q query %q; net/url %q %q (uri %q)", u.RequestURI(), req.Path, req.RawQuery, want.Path, want.RawQuery, s)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_write_test.go b/hegel/hegel_write_test.go
new file mode 100644
index 0000000..c779a57
--- /dev/null
+++ b/hegel/hegel_write_test.go
@@ -0,0 +1,211 @@
+package hegel
+
+// Requests and responses written by fasthttp, read by net/http.
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"io"
+	"net/http"
+	"net/textproto"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelRequestWrittenReadByNetHTTP: a fasthttp.Request built from a
+// method, URI, headers, cookies and body, written with WriteTo, is read by
+// net/http with the same parts.
+func TestHegelRequestWrittenReadByNetHTTP(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		var req fasthttp.Request
+		method := pick(tc, methods...)
+		req.Header.SetMethod(method)
+		spec := genURI(tc)
+		spec.scheme = pick(tc, "http", "https")
+		spec.userinfo = ""
+		if spec.host == "" {
+			spec.host = "example.com"
+		}
+		uri := spec.String()
+		if _, err := url.Parse(uri); err != nil || strings.ContainsAny(uri, " \"") || !ascii(uri) {
+			count("invalid uri")
+			return
+		}
+		req.SetRequestURI(uri)
+		want := map[string][]string{}
+		seen := map[string]bool{}
+		for _, h := range genHeaders(tc, seen) {
+			if strings.Contains(h.value, "\xff") || strings.TrimSpace(h.value) != h.value || h.value == "" {
+				continue // net/http rejects non-ASCII bytes it did not write; fasthttp trims
+			}
+			canon := textproto.CanonicalMIMEHeaderKey(h.key)
+			req.Header.Add(h.key, h.value)
+			want[canon] = append(want[canon], h.value)
+		}
+		var cookies []kv
+		if chance(tc, 40) {
+			c := genCookieHdr(tc)
+			names := map[string]bool{}
+			for _, kv := range c.cookies {
+				if names[kv.k] || strings.ContainsAny(kv.v, "\";\\") {
+					continue
+				}
+				names[kv.k] = true
+				req.Header.SetCookie(kv.k, kv.v)
+				cookies = append(cookies, kv)
+			}
+		}
+		body := pick(tc, bodies...)
+		if body != "" && (method == "GET" || method == "HEAD" || method == "get") && !chance(tc, 20) {
+			body = ""
+		}
+		req.SetBodyString(body)
+		var buf bytes.Buffer
+		if _, err := req.WriteTo(&buf); err != nil {
+			if body != "" && (method == "GET" || method == "HEAD" || method == "get") {
+				count("body on GET refused")
+				return
+			}
+			fail(ht, "WriteTo: %v", err)
+		}
+		raw := buf.String()
+		if id := knownRequestWrite(raw); id != "" {
+			count("known " + id)
+			return
+		}
+		r, err := http.ReadRequest(bufio.NewReader(strings.NewReader(raw)))
+		if err != nil {
+			fail(ht, "net/http rejects fasthttp's request: %v\n%q", err, raw)
+		}
+		data, _ := io.ReadAll(r.Body)
+		if r.Method != method {
+			fail(ht, "method %q, want %q\n%q", r.Method, method, raw)
+		}
+		if r.RequestURI != string(req.URI().RequestURI()) {
+			fail(ht, "request-target %q, fasthttp's RequestURI %q\n%q", r.RequestURI, req.URI().RequestURI(), raw)
+		}
+		if r.Host != string(req.URI().Host()) {
+			fail(ht, "host %q, fasthttp's %q\n%q", r.Host, req.URI().Host(), raw)
+		}
+		if string(data) != body {
+			fail(ht, "body %q, want %q\n%q", data, body, raw)
+		}
+		for k, vals := range want {
+			if got := r.Header.Values(k); fmt.Sprint(got) != fmt.Sprint(vals) {
+				fail(ht, "header %s: net/http reads %q, set %q\n%q", k, got, vals, raw)
+			}
+		}
+		var gotCookies []kv
+		for _, c := range r.Cookies() {
+			gotCookies = append(gotCookies, kv{c.Name, c.Value})
+		}
+		if fmt.Sprint(gotCookies) != fmt.Sprint(cookies) {
+			fail(ht, "cookies: net/http reads %q, set %q\n%q", gotCookies, cookies, raw)
+		}
+		count("ok")
+	})
+}
+
+// TestHegelResponseWrittenReadByNetHTTP: a fasthttp.Response with a status,
+// headers, Set-Cookie cookies and body, written with WriteTo, is read by
+// net/http with the same parts.
+func TestHegelResponseWrittenReadByNetHTTP(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		var resp fasthttp.Response
+		code := pick(tc, statusCodes...)
+		resp.SetStatusCode(code)
+		want := map[string][]string{}
+		seen := map[string]bool{}
+		for _, h := range genHeaders(tc, seen) {
+			canon := textproto.CanonicalMIMEHeaderKey(h.key)
+			if strings.Contains(h.value, "\xff") || strings.TrimSpace(h.value) != h.value || h.value == "" || canon == "Date" {
+				continue // Response.Write sets Date itself
+			}
+			resp.Header.Add(h.key, h.value)
+			want[canon] = append(want[canon], h.value)
+		}
+		var wantCookies []cookieView
+		for k := pick(tc, 0, 0, 1, 2); k > 0; k-- {
+			var c fasthttp.Cookie
+			v := cookieView{name: pick(tc, cookieNames...), value: pick(tc, "abc", "", "x=y", "0123456789", "a b"), sameSite: "unset"}
+			c.SetKey(v.name)
+			c.SetValue(v.value)
+			if chance(tc, 50) {
+				c.SetPath(pick(tc, "/", "/a/b"))
+				v.path = string(c.Path())
+			}
+			if chance(tc, 30) {
+				v.maxAge = n(tc, 1, 1000)
+				c.SetMaxAge(v.maxAge)
+			}
+			if chance(tc, 30) {
+				v.httpOnly = true
+				c.SetHTTPOnly(true)
+			}
+			resp.Header.SetCookie(&c)
+			replaced := false
+			for i := range wantCookies {
+				if wantCookies[i].name == v.name {
+					wantCookies[i], replaced = v, true // SetCookie replaces a cookie of the same name
+				}
+			}
+			if !replaced {
+				wantCookies = append(wantCookies, v)
+			}
+		}
+		body := pick(tc, bodies...)
+		if code == 204 || code == 304 {
+			body = ""
+		}
+		resp.SetBodyString(body)
+		var buf bytes.Buffer
+		if _, err := resp.WriteTo(&buf); err != nil {
+			fail(ht, "WriteTo: %v", err)
+		}
+		raw := buf.String()
+		if id := knownResponseWrite(raw); id != "" {
+			count("known " + id)
+			return
+		}
+		r, err := http.ReadResponse(bufio.NewReader(strings.NewReader(raw)), nil)
+		if err != nil {
+			fail(ht, "net/http rejects fasthttp's response: %v\n%q", err, raw)
+		}
+		data, _ := io.ReadAll(r.Body)
+		if r.StatusCode != code {
+			fail(ht, "status %d, want %d\n%q", r.StatusCode, code, raw)
+		}
+		if string(data) != body {
+			fail(ht, "body %q, want %q\n%q", data, body, raw)
+		}
+		for k, vals := range want {
+			if got := r.Header.Values(k); fmt.Sprint(got) != fmt.Sprint(vals) {
+				fail(ht, "header %s: net/http reads %q, set %q\n%q", k, got, vals, raw)
+			}
+		}
+		var gotCookies []cookieView
+		for _, c := range r.Cookies() {
+			gotCookies = append(gotCookies, netCookieView(c))
+		}
+		if showCookies(gotCookies) != showCookies(wantCookies) {
+			fail(ht, "cookies: net/http reads\n%sset\n%s%q", showCookies(gotCookies), showCookies(wantCookies), raw)
+		}
+		count("ok")
+	})
+}
+
+func ascii(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..a879200
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,157 @@
+package hegel
+
+import (
+	"net/http"
+	"os"
+	"strings"
+)
+
+// Gates for the recorded bugs (bugs.toml). A case that has a known bug's
+// shape is counted, not judged. HEGEL_NO_KNOWN=1 disables the gates.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// closeToken reports a Connection value that carries the close token other
+// than as exactly "close": fasthttp compares the whole value with "close".
+func closeToken(connection string) bool {
+	if connection == "close" {
+		return false
+	}
+	for _, tok := range strings.Split(connection, ",") {
+		if strings.EqualFold(strings.TrimSpace(tok), "close") {
+			return true
+		}
+	}
+	return false
+}
+
+// hasCloseToken reports a Connection value with a close token.
+func hasCloseToken(connection string) bool {
+	return connection == "close" || closeToken(connection)
+}
+
+func knownRequest(r request, raw string) string {
+	if noKnown {
+		return ""
+	}
+	if closeToken(r.connection) {
+		return "fasthttp/3"
+	}
+	if r.connection2 != "" && (hasCloseToken(r.connection) || hasCloseToken(r.connection2) || r.proto == "HTTP/1.0") {
+		return "fasthttp/3" // a later Connection header cancels an earlier close; HTTP/1.0 keep-alive is looked for in the first only
+	}
+	return ""
+}
+
+func knownResponse(r response, raw string) string {
+	if noKnown {
+		return ""
+	}
+	if closeToken(r.connection) {
+		return "fasthttp/3"
+	}
+	for _, c := range r.setCookies {
+		if id := knownSetCookie(c, c.raw()); id != "" {
+			return id
+		}
+	}
+	return ""
+}
+
+func numeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func knownSetCookie(c setCookie, raw string) string {
+	if noKnown {
+		return ""
+	}
+	if strings.HasPrefix(c.maxAge, "-") {
+		return "fasthttp/1"
+	}
+	if c.maxAge != "" && !numeric(c.maxAge) {
+		return "fasthttp/2"
+	}
+	if !c.expires.IsZero() && c.expiresFmt == 2 {
+		return "fasthttp/2"
+	}
+	if c.sameSite == "Foo" || c.sameSite == "empty" {
+		return "fasthttp/5"
+	}
+	if c.flagValue != "" && (c.secure || c.httpOnly || c.partitioned) {
+		return "fasthttp/7"
+	}
+	return ""
+}
+
+func knownCookieWrite(want cookieView, raw string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
+
+func knownCookieRead(c http.Cookie, raw string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
+
+func knownQuery(q string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
+
+func knownURI(u uriSpec, s string) string {
+	if noKnown {
+		return ""
+	}
+	if strings.Contains(u.host, "%25") {
+		return "fasthttp/6"
+	}
+	return ""
+}
+
+func knownDate(text string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
+
+func knownIPv4(s string) string {
+	if noKnown {
+		return ""
+	}
+	for _, part := range strings.Split(s, ".") {
+		if len(part) > 1 && part[0] == '0' {
+			return "fasthttp/4"
+		}
+	}
+	return ""
+}
+
+func knownRequestWrite(raw string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
+
+func knownResponseWrite(raw string) string {
+	if noKnown {
+		return ""
+	}
+	return ""
+}
