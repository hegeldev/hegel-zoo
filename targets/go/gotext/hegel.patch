diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..7ace099
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,187 @@
+package gotext_test
+
+// Deterministic pins for the recorded bugs (bugs.toml). Each asserts the
+// GNU gettext behaviour and fails while the bug is open; the properties
+// name the shape by the matching switch of the known value in
+// hegel_zoo_test.go.
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/leonelquinteros/gotext"
+	"github.com/leonelquinteros/gotext/plurals"
+)
+
+const arabicHeader = "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=6; plural=n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5;\\n\"\n"
+
+const frenchHeader = "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=2; plural=n>1;\\n\"\n"
+
+func parsePO(src string) *gotext.Po {
+	p := gotext.NewPo()
+	p.Parse([]byte(src))
+	return p
+}
+
+// gotext/1: a fuzzy translation is not a translation (msgfmt leaves it out
+// of the MO; GNU gettext returns the msgid).
+func TestHegelPinFuzzyTranslationsAreNotUsed(t *testing.T) {
+	p := parsePO(frenchHeader + "\n#, fuzzy\nmsgid \"fz\"\nmsgstr \"FZ\"\n\n#, fuzzy, no-c-format\nmsgid \"apple\"\nmsgid_plural \"apples\"\nmsgstr[0] \"A0\"\nmsgstr[1] \"A1\"\n")
+	if got := p.Get("fz"); got != "fz" {
+		t.Errorf("Get of a fuzzy entry = %q, expected the msgid %q", got, "fz")
+	}
+	if p.IsTranslated("fz") {
+		t.Errorf("IsTranslated of a fuzzy entry is true")
+	}
+	if got := p.GetN("apple", "apples", 2); got != "apples" {
+		t.Errorf("GetN of a fuzzy plural entry = %q, expected %q", got, "apples")
+	}
+}
+
+// gotext/2: an untranslated plural lookup picks the singular for n == 1 and
+// the plural otherwise (GNU ngettext; gotext's own GetNC and Locale rule),
+// whatever the catalog's plural rule says.
+func TestHegelPinUntranslatedPluralFallsBackByOne(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"item\"\nmsgid_plural \"items\"\nmsgstr[0] \"\"\nmsgstr[1] \"\"\n")
+	if got := p.GetN("missing", "missings", 0); got != "missings" {
+		t.Errorf("GetN(missing, missings, 0) = %q under plural=n>1, expected %q (GetNC gives %q)", got, "missings", p.GetNC("missing", "missings", 0, "c"))
+	}
+	if got := p.GetN("item", "items", 0); got != "items" {
+		t.Errorf("GetN(item, items, 0) of an untranslated entry = %q, expected %q", got, "items")
+	}
+	if got := string(p.AppendN(nil, "missing", "missings", 0)); got != "missings" {
+		t.Errorf("AppendN(missing, missings, 0) = %q, expected %q", got, "missings")
+	}
+	ar := parsePO(arabicHeader)
+	if got := ar.GetN("missing", "missings", 1); got != "missing" {
+		t.Errorf("GetN(missing, missings, 1) under the Arabic rule = %q, expected %q", got, "missing")
+	}
+}
+
+// gotext/3: a singular entry looked up as a plural answers text, never the
+// empty string: C libintl gives the entry's translation (its only form),
+// Python's gettext the untranslated plural msgid; an untranslated entry
+// gives the msgid for n == 1 and the plural msgid otherwise.
+func TestHegelPinSingularEntriesAnswerPluralLookups(t *testing.T) {
+	p := parsePO(arabicHeader + "\nmsgid \"plain\"\nmsgstr \"PLAIN\"\n\nmsgid \"blank\"\nmsgstr \"\"\n\nmsgctxt \"c\"\nmsgid \"ctx\"\nmsgstr \"CTX\"\n")
+	cases := []struct {
+		got  string
+		want []string
+		what string
+	}{
+		{p.GetN("plain", "plains", 2), []string{"PLAIN", "plains"}, "GetN(plain, plains, 2)"},
+		{p.GetN("blank", "blanks", 5), []string{"blanks"}, "GetN(blank, blanks, 5)"},
+		{p.GetNC("ctx", "ctxs", 2, "c"), []string{"CTX", "ctxs"}, "GetNC(ctx, ctxs, 2, c)"},
+		{string(p.AppendN(nil, "plain", "plains", 2)), []string{"PLAIN", "plains"}, "AppendN(plain, plains, 2)"},
+	}
+	for _, c := range cases {
+		ok := false
+		for _, w := range c.want {
+			ok = ok || c.got == w
+		}
+		if !ok {
+			t.Errorf("%s = %q, expected one of %q", c.what, c.got, c.want)
+		}
+	}
+}
+
+// gotext/4: IsTranslated of a singular entry does not depend on the
+// catalog's plural rule.
+func TestHegelPinIsTranslatedIgnoresThePluralRule(t *testing.T) {
+	p := parsePO(arabicHeader + "\nmsgid \"plain\"\nmsgstr \"PLAIN\"\n\nmsgctxt \"c\"\nmsgid \"ctx\"\nmsgstr \"CTX\"\n")
+	if !p.IsTranslated("plain") {
+		t.Errorf("IsTranslated(plain) is false under the Arabic rule although msgstr is %q", p.Get("plain"))
+	}
+	if !p.IsTranslatedC("ctx", "c") {
+		t.Errorf("IsTranslatedC(ctx, c) is false under the Arabic rule although msgstr is %q", p.GetC("ctx", "c"))
+	}
+	l := gotext.NewLocale("/nowhere", "ar")
+	l.AddTranslator("default", p)
+	if !l.IsTranslated("plain") {
+		t.Errorf("Locale.IsTranslated(plain) is false under the Arabic rule")
+	}
+}
+
+// gotext/5: in a C plural expression a bare `n` or `n % k` is a non-zero
+// test, and the value of the expression `n` is n.
+func TestHegelPinBareTestsAreNonZeroTests(t *testing.T) {
+	cases := []struct {
+		expr string
+		n    uint32
+		want int
+	}{
+		{"n ? 1 : 0", 2, 1},
+		{"n ? 1 : 0", 0, 0},
+		{"(n % 10) ? 1 : 0", 3, 1},
+		{"(n % 10) ? 1 : 0", 10, 0},
+		{"n", 2, 2},
+		{"n && n != 1 ? 1 : 0", 5, 1},
+	}
+	for _, c := range cases {
+		e, err := plurals.Compile(c.expr)
+		if err != nil {
+			t.Errorf("Compile(%q): %v", c.expr, err)
+			continue
+		}
+		if got := e.Eval(c.n); got != c.want {
+			t.Errorf("Compile(%q).Eval(%d) = %d, C gives %d", c.expr, c.n, got, c.want)
+		}
+	}
+}
+
+// gotext/6: MarshalText writes non-ASCII text intact.
+func TestHegelPinMarshalTextKeepsNonASCII(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"na\u00efve\"\nmsgstr \"\u00f1 \u65e5\u672c \U0001f389\"\n")
+	text, err := p.MarshalText()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !utf8.Valid(text) {
+		t.Errorf("MarshalText output is not valid UTF-8: %q", text)
+	}
+	if !strings.Contains(string(text), "\u00f1 \u65e5\u672c \U0001f389") {
+		t.Errorf("MarshalText output lacks the translation: %q", text)
+	}
+	p2 := parsePO(string(text))
+	if got := p2.Get("na\u00efve"); got != "\u00f1 \u65e5\u672c \U0001f389" {
+		t.Errorf("after MarshalText, Get(na\u00efve) = %q", got)
+	}
+}
+
+// gotext/7: MarshalText escapes a backslash before a quote.
+func TestHegelPinMarshalTextEscapesBackslashBeforeQuote(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"k\"\nmsgstr \"a\\\\\\\"b\"\n")
+	if got := p.Get("k"); got != "a\\\"b" {
+		t.Fatalf("the PO parser reads the translation as %q", got)
+	}
+	text, err := p.MarshalText()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p2 := parsePO(string(text))
+	if got := p2.Get("k"); got != "a\\\"b" {
+		t.Errorf("after MarshalText, Get(k) = %q, expected %q (written as %s)", got, "a\\\"b", text)
+	}
+}
+
+// gotext/8: an entry without `#:` lines has no references of its own; the
+// previous entry's are not inherited, and MarshalText writes them once.
+func TestHegelPinReferencesStayWithTheirEntry(t *testing.T) {
+	p := parsePO(frenchHeader + "\n#: main.go:1\nmsgid \"a\"\nmsgstr \"A\"\n\nmsgid \"b\"\nmsgstr \"B\"\n\nmsgctxt \"c\"\nmsgid \"d\"\nmsgstr \"D\"\n")
+	if refs := p.GetRefs("b"); len(refs) != 0 {
+		t.Errorf("GetRefs(b) = %q for an entry without #: lines, expected none", refs)
+	}
+	if tr := p.GetDomain().GetCtxTranslations()["c"]["d"]; tr == nil {
+		t.Errorf("the context entry c/d is missing")
+	} else if len(tr.Refs) != 0 {
+		t.Errorf("the context entry c/d has references %q, expected none", tr.Refs)
+	}
+	text, err := p.MarshalText()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := strings.Count(string(text), "#: main.go:1"); n != 1 {
+		t.Errorf("MarshalText writes %d \"#: main.go:1\" lines, expected 1:\n%s", n, text)
+	}
+}
diff --git a/hegel_zoo_catalogs_test.go b/hegel_zoo_catalogs_test.go
new file mode 100644
index 0000000..8670bfb
--- /dev/null
+++ b/hegel_zoo_catalogs_test.go
@@ -0,0 +1,732 @@
+package gotext_test
+
+// The catalog record (a PO file's content), its generators and the spelling of a catalog as
+// PO text. The population is the one the first harness drew (the same pool words, piece
+// atoms, plural rules, contexts, references and headers, at the same chances and counts),
+// drawn by the halving and fair-bit idioms so that the nominal rates are realised (the figure
+// beside every weight is the probe's at HEGEL_TEST_CASES=3000, seed 1). The shape of gotext/1
+// (a fuzzy entry) and of gotext/6 (a non-ASCII string, in the MarshalText property) are
+// weights of the entry and text generators, zero under HEGEL_NO_KNOWN=1 where the property
+// reaches the bug (catalogsOver).
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- records
+
+// entry is one message of a catalog.
+type entry struct {
+	hasCtx    bool
+	ctx       string
+	id        string
+	hasPlural bool
+	plural    string
+	forms     []string // one for a singular entry, nplurals for a plural one
+	fuzzy     bool
+	refs      []string
+	comments  []string // translator and extracted comments (spelled before the entry)
+	prev      string   // a `#| msgid` previous-string comment
+	flags     []string // other flags (c-format ...)
+}
+
+// catalog is a PO file's content: the header fields in their spelled order, the comments
+// before the header entry, the plural rule (nplurals and the expression; plural "" when the
+// Plural-Forms header is absent and the Germanic rule applies) and the entries, with
+// distinct (context, msgid) keys.
+type catalog struct {
+	headers  [][2]string
+	comments []string
+	nplurals int
+	plural   string
+	entries  []entry
+}
+
+func (c catalog) key(e entry) string { return e.ctx + "\x04" + e.id }
+
+// byKey indexes the entries by (context, msgid).
+func (c catalog) byKey() map[string]entry {
+	m := map[string]entry{}
+	for _, e := range c.entries {
+		m[c.key(e)] = e
+	}
+	return m
+}
+
+// header is the value of a header field, "" when absent.
+func (c catalog) header(name string) string {
+	for _, h := range c.headers {
+		if h[0] == name {
+			return h[1]
+		}
+	}
+	return ""
+}
+
+func (e entry) GoString() string {
+	var b strings.Builder
+	b.WriteString("{")
+	if e.hasCtx {
+		fmt.Fprintf(&b, "ctx:%q ", e.ctx)
+	}
+	fmt.Fprintf(&b, "id:%q", e.id)
+	if e.hasPlural {
+		fmt.Fprintf(&b, " plural:%q", e.plural)
+	}
+	fmt.Fprintf(&b, " forms:%q", e.forms)
+	if e.fuzzy {
+		b.WriteString(" fuzzy")
+	}
+	if len(e.refs) > 0 {
+		fmt.Fprintf(&b, " refs:%q", e.refs)
+	}
+	if len(e.comments) > 0 {
+		fmt.Fprintf(&b, " comments:%q", e.comments)
+	}
+	if e.prev != "" {
+		fmt.Fprintf(&b, " prev:%q", e.prev)
+	}
+	if len(e.flags) > 0 {
+		fmt.Fprintf(&b, " flags:%q", e.flags)
+	}
+	b.WriteString("}")
+	return b.String()
+}
+
+func (c catalog) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "catalog{nplurals:%d plural:%q headers:%q comments:%q entries:[", c.nplurals, c.plural, c.headers, c.comments)
+	for i, e := range c.entries {
+		if i > 0 {
+			b.WriteString(", ")
+		}
+		b.WriteString(e.GoString())
+	}
+	b.WriteString("]}")
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- texts
+
+// wordPool is the pool of whole strings (the first harness's, byte for byte): three hold
+// characters outside ASCII ("na\u00efve", "\u65e5\u672c\u8a9e", "\U0001f600 ok"), the shape
+// of gotext/6.
+var wordPool = []string{"apple", "file", "Hello, world", "Save", "%d item", "%s: %d", "na\u00efve", "\u65e5\u672c\u8a9e", "\U0001f600 ok", "tab\there", "line\nbreak", "quote\"d", "back\\slash", "100%%", "trailing\n", " lead", "a:b", "#hash", "msgid", "x"}
+
+func nonASCII(s string) bool {
+	for _, r := range s {
+		if r >= utf8.RuneSelf {
+			return true
+		}
+	}
+	return false
+}
+
+// texts are the text generators of a catalog population at a weight of the non-ASCII
+// alternatives (1 the plain population; 0 past the shape of gotext/6, for the MarshalText
+// property under HEGEL_NO_KNOWN=1; more for the narrow property of gotext/6).
+type texts struct {
+	word  hegel.Generator[string] // a pool word
+	piece hegel.Generator[string] // one piece of a pieced string
+	ctx   hegel.Generator[string] // a context
+}
+
+// The piece atoms (the first harness's).
+var (
+	pieceWords    = evenHalves("a", "b", "word", "Z", "0", "-", ".", "'")
+	pieceNonASCII = evenHalves("\u00e9", "\u00df", "\u4e2d", "\U0001f389", "\u00a0")
+	pieceFormats  = evenHalves("%d", "%s", "%%", "%v", "%(name)s")
+)
+
+// textsAt is the text generators with the non-ASCII alternatives at weight w (the pool words
+// at one each, the piece atoms as the first harness's twelve-face die: four faces a word,
+// one each a newline, a tab, a quote, a backslash, a non-ASCII character, a format verb, a
+// space and a carriage return; the contexts at one each).
+func textsAt(w int) texts {
+	weights := make([]int, len(wordPool))
+	for i, s := range wordPool {
+		weights[i] = 1
+		if nonASCII(s) {
+			weights[i] = w
+		}
+	}
+	return texts{
+		word:  halvesOver(weights, wordPool...),
+		piece: halvesGens([]int{4, 1, 1, 1, 1, w, 1, 1, 1}, pieceWords, hegel.Just("\n"), hegel.Just("\t"), hegel.Just("\""), hegel.Just("\\"), pieceNonASCII, pieceFormats, hegel.Just(" "), hegel.Just("\r")),
+		ctx:   halvesOver([]int{1, 1, 1, 1, w}, "menu", "verb", "noun", "ctx with space", "\u65e5"),
+	}
+}
+
+// pieced is a string of one to six pieces.
+func (tx texts) pieced() hegel.Generator[string] {
+	return hegel.Map(countedHalves(tx.piece, 1, 6), func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// text is a msgid, msgid_plural or plural form: a pool word 60 (realised: see the probe) or
+// a pieced string 40.
+func (tx texts) text() hegel.Generator[string] {
+	return dieChoice(hzW(60, tx.word), hzW(40, tx.pieced()))
+}
+
+// form is a singular translation: empty 15, else a text (a pool word 51, pieced 34).
+func (tx texts) form() hegel.Generator[string] {
+	return dieChoice(hzW(15, hegel.Just("")), hzW(51, tx.word), hzW(34, tx.pieced()))
+}
+
+var (
+	plainTexts = textsAt(1)
+	asciiTexts = textsAt(0)
+)
+
+// --------------------------------------------------------------------------- plural rules
+
+// pluralForm is a Plural-Forms header's content.
+type pluralForm struct {
+	nplurals int
+	plural   string
+}
+
+// realPluralForms are the Plural-Forms expressions of GNU gettext's manual and of gotext's own
+// fixtures.
+var realPluralForms = []pluralForm{
+	{1, "0"},
+	{2, "n != 1"},
+	{2, "(n != 1)"},
+	{2, "n>1"},
+	{2, "(n > 1)"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n != 0 ? 1 : 2"},
+	{3, "n==1 ? 0 : n==2 ? 1 : 2"},
+	{3, "n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n%10>=2 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{3, "(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2"},
+	{3, "n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{4, "n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3"},
+	{6, "n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5"},
+	{2, "n == 1 ? 0 : 1"},
+	{2, "(n==1) ? 0 : 1"},
+	{4, "(n==1 || n==11) ? 0 : (n==2 || n==12) ? 1 : (n > 2 && n < 20) ? 2 : 3"},
+	{5, "(n==1) ? 0 : (n==2) ? 1 : (n<7) ? 2 : (n<11) ? 3 : 4"},
+	{2, "(n%10!=1 || n%100==11)"},
+	{3, "(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2)"},
+}
+
+// anyRule is one of the twenty, evenly.
+var anyRule = evenHalves(realPluralForms...)
+
+// rulesWhere is the rules satisfying pred, evenly.
+func rulesWhere(pred func(pluralForm) bool) hegel.Generator[pluralForm] {
+	var out []pluralForm
+	for _, pf := range realPluralForms {
+		if pred(pf) {
+			out = append(out, pf)
+		}
+	}
+	return evenHalves(out...)
+}
+
+// --------------------------------------------------------------------------- entries
+
+// refGen is one `#:` reference; refsList one to three of them; someRefs the references of an
+// entry: one to three 35 percent of the time.
+var (
+	refGen = hegel.FlatMap(evenHalves("main.go", "pkg/a.go", "cmd/x/y.go"), func(f string) hegel.Generator[string] {
+		return hegel.Map(hegel.Integers(1, 999), func(l int) string { return f + ":" + strconv.Itoa(l) })
+	})
+	refsList = countedHalves(refGen, 1, 3)
+	someRefs = dieMaybe(35, refsList)
+	noRefs   = hegel.Just[[]string](nil)
+)
+
+// entryGen is the entries of a catalog of np plural forms: a context 30, a plural entry at
+// the weight plural (45 by default) with its forms untranslated 10 / partly 10 / fully 80,
+// fuzzy at the weight fuzzy (12; zero under HEGEL_NO_KNOWN=1 in the property that reaches
+// gotext/1), references from refs (someRefs: one to three 35), a comment 25, a previous
+// msgid 10, a flag 15.
+func entryGen(tx texts, fuzzy, plural, np int, refs hegel.Generator[[]string]) hegel.Generator[entry] {
+	text := tx.text()
+	forms := dieChoice(
+		hzW(10, hegel.Just(make([]string, np))),
+		hzW(10, hzCounted(dieMaybe(50, text), np, np)),
+		hzW(80, hzCounted(text, np, np)),
+	)
+	ctx := dieMaybe(30, tx.ctx)
+	pluralText := dieMaybe(plural, text)
+	form := hzOne(tx.form())
+	fuzzyCoin := dieCoin(fuzzy)
+	comments := dieMaybe(25, hzOne(evenHalves("# translator note", "#. extracted comment", "# two words")))
+	prev := dieMaybe(10, evenHalves("old id", "older"))
+	flags := dieMaybe(15, hzOne(evenHalves("no-c-format", "no-python-format")))
+	return hegel.Composite(func(tc hegel.TestCase) entry {
+		e := entry{ctx: hegel.Draw(tc, ctx), id: hegel.Draw(tc, text), plural: hegel.Draw(tc, pluralText)}
+		e.hasCtx, e.hasPlural = e.ctx != "", e.plural != ""
+		if e.hasPlural {
+			e.forms = hegel.Draw(tc, forms)
+		} else {
+			e.forms = hegel.Draw(tc, form)
+		}
+		e.fuzzy = hegel.Draw(tc, fuzzyCoin)
+		e.refs = hegel.Draw(tc, refs)
+		e.comments = hegel.Draw(tc, comments)
+		e.prev = hegel.Draw(tc, prev)
+		e.flags = hegel.Draw(tc, flags)
+		return e
+	})
+}
+
+// fitNewlines makes an entry msgfmt accepts: a translation begins and ends with a newline
+// exactly when the msgid does (so does the msgid_plural), and a partly translated entry
+// leaves no form empty when the msgid has such a newline (msgfmt checks every form of a
+// translated entry).
+func fitNewlines(e entry) entry {
+	lead, trail := strings.HasPrefix(e.id, "\n"), strings.HasSuffix(e.id, "\n")
+	forms := make([]string, len(e.forms))
+	for i, f := range e.forms {
+		if f != "" {
+			f = strings.Trim(f, "\n")
+			if f == "" {
+				f = "x"
+			}
+			if lead {
+				f = "\n" + f
+			}
+			if trail {
+				f += "\n"
+			}
+		}
+		forms[i] = f
+	}
+	if forms[0] != "" && (lead || trail) {
+		for i, f := range forms {
+			if f == "" {
+				if lead {
+					f = "\n"
+				}
+				f += "x"
+				if trail {
+					f += "\n"
+				}
+				forms[i] = f
+			}
+		}
+	}
+	e.forms = forms
+	if e.hasPlural {
+		pl := strings.Trim(e.plural, "\n")
+		if pl == "" {
+			pl = "xs"
+		}
+		if lead {
+			pl = "\n" + pl
+		}
+		if trail {
+			pl += "\n"
+		}
+		e.plural = pl
+	}
+	return e
+}
+
+// distinct keeps the first entry of every (context, msgid) key.
+func distinct(c catalog, es []entry) []entry {
+	seen := map[string]bool{}
+	var out []entry
+	for _, e := range es {
+		if seen[c.key(e)] {
+			continue
+		}
+		seen[c.key(e)] = true
+		out = append(out, e)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- catalogs
+
+// shuffleKeys are the seven draws of a Fisher-Yates shuffle of up to eight headers (the
+// header i swaps with the drawn position of 0..i).
+var shuffleKeys = hzTuple(rangeHalves(0, 1), rangeHalves(0, 2), rangeHalves(0, 3), rangeHalves(0, 4), rangeHalves(0, 5), rangeHalves(0, 6), rangeHalves(0, 7))
+
+// shuffled is the headers in the drawn order.
+func shuffled(hdr [][2]string, keys []int) [][2]string {
+	out := append([][2]string{}, hdr...)
+	for i := len(out) - 1; i > 0; i-- {
+		j := keys[i-1]
+		out[i], out[j] = out[j], out[i]
+	}
+	return out
+}
+
+// catalogsOver is the catalogs of a population: the texts, the fuzzy and plural weights of
+// the entries, lo to 7 entries, the plural rule from rules; the references per entry
+// (someRefs) or, with refsPerCatalog, all or none by one coin at 35 for the whole catalog (no
+// entry without references then follows one with them: past the shape of gotext/8). The
+// headers: Project-Id-Version, Language, MIME-Version, Content-Type and
+// Content-Transfer-Encoding always, Plural-Forms 90 (else the Germanic rule), X-Generator 30,
+// Last-Translator 30, in a drawn order; the comments before the header 40, half of them with
+// a fuzzy flag line (msgfmt keeps a fuzzy header).
+func catalogsOver(tx texts, fuzzy, plural, lo int, rules hegel.Generator[pluralForm], refsPerCatalog bool) hegel.Generator[catalog] {
+	entries := map[int]hegel.Generator[entry]{}
+	withRefs := map[int]hegel.Generator[entry]{}
+	withoutRefs := map[int]hegel.Generator[entry]{}
+	for np := 1; np <= 6; np++ {
+		entries[np] = entryGen(tx, fuzzy, plural, np, someRefs)
+		withRefs[np] = entryGen(tx, fuzzy, plural, np, refsList)
+		withoutRefs[np] = entryGen(tx, fuzzy, plural, np, noRefs)
+	}
+	refsCoin := dieCoin(35)
+	langs := evenHalves("en", "de", "de_DE", "pl", "ar", "fr", "ru", "cs", "ja")
+	versions := evenHalves("hegel 1.0", "PACKAGE VERSION", "x")
+	hasPF := dieCoin(90)
+	xgen := dieMaybe(30, evenHalves("hegel", "Poedit 3.0", "a: b: c"))
+	lastTr := dieCoin(30)
+	comments := dieChoice(hzW(60, hegel.Just(0)), hzW(20, hegel.Just(2)), hzW(20, hegel.Just(3)))
+	return hegel.Composite(func(tc hegel.TestCase) catalog {
+		pf := hegel.Draw(tc, rules)
+		c := catalog{nplurals: pf.nplurals, plural: pf.plural}
+		hdr := [][2]string{
+			{"Project-Id-Version", hegel.Draw(tc, versions)},
+			{"Language", hegel.Draw(tc, langs)},
+			{"MIME-Version", "1.0"},
+			{"Content-Type", "text/plain; charset=UTF-8"},
+			{"Content-Transfer-Encoding", "8bit"},
+		}
+		if hegel.Draw(tc, hasPF) {
+			hdr = append(hdr, [2]string{"Plural-Forms", fmt.Sprintf("nplurals=%d; plural=%s;", c.nplurals, c.plural)})
+		} else {
+			c.nplurals, c.plural = 2, ""
+		}
+		if x := hegel.Draw(tc, xgen); x != "" {
+			hdr = append(hdr, [2]string{"X-Generator", x})
+		}
+		if hegel.Draw(tc, lastTr) {
+			hdr = append(hdr, [2]string{"Last-Translator", "Someone <someone@example.com>"})
+		}
+		c.headers = shuffled(hdr, hegel.Draw(tc, shuffleKeys))
+		c.comments = []string{"# Translations for hegel.", "# Copyright (C) 2026", "#, fuzzy"}[:hegel.Draw(tc, comments)]
+		from := entries
+		if refsPerCatalog {
+			from = withoutRefs
+			if hegel.Draw(tc, refsCoin) {
+				from = withRefs
+			}
+		}
+		es := hegel.Draw(tc, countedHalves(from[c.nplurals], lo, 7))
+		for i := range es {
+			es[i] = fitNewlines(es[i])
+		}
+		c.entries = distinct(c, es)
+		return c
+	})
+}
+
+// The catalog populations of the wide properties: plainCatalogs with fuzzy entries (the
+// msgunfmt, gob and broken-input properties, where a fuzzy entry is no shape),
+// lookupCatalogs with the fuzzy weight zero under HEGEL_NO_KNOWN=1 (the catalog property,
+// gotext/1), marshalCatalogs without fuzzy entries and, under HEGEL_NO_KNOWN=1, without
+// non-ASCII text (gotext/6) and with the references all or none per catalog (gotext/8) (the
+// MarshalText property).
+var (
+	plainCatalogs   = catalogsOver(plainTexts, 12, 45, 0, anyRule, false)
+	lookupCatalogs  = catalogsOver(plainTexts, hzUnless(hzNoKnown, 12), 45, 0, anyRule, false)
+	marshalCatalogs = catalogsOver(textsAt(hzUnless(hzNoKnown, 1)), 0, 45, 0, anyRule, hzNoKnown)
+)
+
+// --------------------------------------------------------------------------- spelling
+
+// spelling is how a catalog is spelled as PO text: the separator after the keywords, an
+// obsolete entry at the end, and per string (catalogStrings' order) whether it is split over
+// continuation lines, by lines or at drawn cuts, and which of its letters are octal escapes.
+type spelling struct {
+	sep      string
+	obsolete bool
+	strs     []stringSpelling
+}
+
+type stringSpelling struct {
+	split   bool
+	byLines bool
+	cuts    []int // the lengths in runes of the pieces when split not by lines
+	octal   []int // the positions (among the letters) spelled as octal escapes
+}
+
+func (s spelling) GoString() string {
+	return fmt.Sprintf("spelling{sep:%q obsolete:%v strs:%+v}", s.sep, s.obsolete, s.strs)
+}
+
+// catalogStrings are the strings of a catalog in spelled order: per entry the context, the
+// msgid, the msgid_plural and the forms.
+func catalogStrings(c catalog) []string {
+	var out []string
+	for _, e := range c.entries {
+		if e.hasCtx {
+			out = append(out, e.ctx)
+		}
+		out = append(out, e.id)
+		if e.hasPlural {
+			out = append(out, e.plural)
+		}
+		out = append(out, e.forms...)
+	}
+	return out
+}
+
+// letters is the count of bytes an octal escape may spell (the first harness's range: ASCII
+// 'A' to 'z').
+func letters(s string) int {
+	n := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 'A' && s[i] <= 'z' {
+			n++
+		}
+	}
+	return n
+}
+
+// octalsFor is the letters of s spelled as octal escapes, each at 3 percent: the count by
+// the binomial weights of the string's letters (none, one, two or more), the positions among
+// the letters evenly.
+func octalsFor(s string) hegel.Generator[[]int] {
+	l := letters(s)
+	if l == 0 {
+		return hegel.Just[[]int](nil)
+	}
+	w0 := int(math.Round(1000 * math.Pow(0.97, float64(l))))
+	w1 := int(math.Round(1000 * float64(l) * 0.03 * math.Pow(0.97, float64(l-1))))
+	w2 := 1000 - w0 - w1
+	if w2 < 0 {
+		w2 = 0
+	}
+	return hegel.FlatMap(dieInts(0, w0, w1, w2), func(k int) hegel.Generator[[]int] {
+		return hzCounted(rangeHalves(0, l-1), k, k)
+	})
+}
+
+// stringSpellingFor is the spelling of one string: on one line 60, else split 40, by lines
+// 60 when it has newlines, else at cuts drawn one after another (Integers, as the first
+// harness drew them); empty strings are spelled `""` without a draw.
+func stringSpellingFor(s string) hegel.Generator[stringSpelling] {
+	if s == "" {
+		return hegel.Just(stringSpelling{})
+	}
+	octal := octalsFor(s)
+	runes := utf8.RuneCountInString(s)
+	return hegel.FlatMap(dieCoin(40), func(split bool) hegel.Generator[stringSpelling] {
+		if !split {
+			return hegel.Map(octal, func(o []int) stringSpelling { return stringSpelling{octal: o} })
+		}
+		return hegel.FlatMap(dieCoin(60), func(byLines bool) hegel.Generator[stringSpelling] {
+			if byLines && strings.Count(s, "\n") > 0 {
+				return hegel.Map(octal, func(o []int) stringSpelling { return stringSpelling{split: true, byLines: true, octal: o} })
+			}
+			return hegel.Composite(func(tc hegel.TestCase) stringSpelling {
+				ss := stringSpelling{split: true}
+				for rest := runes; rest > 0; {
+					cut := hegel.Draw(tc, hegel.Integers(1, rest))
+					ss.cuts = append(ss.cuts, cut)
+					rest -= cut
+				}
+				ss.octal = hegel.Draw(tc, octal)
+				return ss
+			})
+		})
+	})
+}
+
+var (
+	separators   = halvesOver([]int{2, 1, 1}, " ", "\t", "  ")
+	obsoleteCoin = dieCoin(30)
+)
+
+// spellingFor is the spelling of a catalog.
+func spellingFor(c catalog) hegel.Generator[spelling] {
+	strs := catalogStrings(c)
+	gens := make([]hegel.Generator[stringSpelling], len(strs))
+	for i, s := range strs {
+		gens[i] = stringSpellingFor(s)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) spelling {
+		sp := spelling{sep: hegel.Draw(tc, separators), obsolete: hegel.Draw(tc, obsoleteCoin)}
+		for _, g := range gens {
+			sp.strs = append(sp.strs, hegel.Draw(tc, g))
+		}
+		return sp
+	})
+}
+
+// poEscape spells s as the inside of a PO quoted string on one line, the letters at the
+// octal positions as octal escapes (a hex escape would swallow a following hex digit in C).
+func poEscape(s string, octal []int) string {
+	var b strings.Builder
+	letter := 0
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '"':
+			b.WriteString(`\"`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		case '\r':
+			b.WriteString(`\r`)
+		default:
+			if r >= 'A' && r <= 'z' {
+				at := false
+				for _, p := range octal {
+					if p == letter {
+						at = true
+					}
+				}
+				letter++
+				if at {
+					fmt.Fprintf(&b, `\%03o`, r)
+					continue
+				}
+			}
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// poString spells s as a PO string: one line, or `""` followed by continuation lines (split
+// at rune boundaries, by lines or at the cuts).
+func poString(s string, ss stringSpelling) string {
+	if s == "" || !ss.split {
+		return "\"" + poEscape(s, ss.octal) + "\""
+	}
+	var pieces []string
+	if ss.byLines {
+		for _, line := range strings.SplitAfter(s, "\n") {
+			if line != "" {
+				pieces = append(pieces, line)
+			}
+		}
+	} else {
+		rest := s
+		for _, cut := range ss.cuts {
+			i := 0
+			for k := 0; k < cut && i < len(rest); k++ {
+				_, size := utf8.DecodeRuneInString(rest[i:])
+				i += size
+			}
+			pieces = append(pieces, rest[:i])
+			rest = rest[i:]
+		}
+		if rest != "" {
+			pieces = append(pieces, rest)
+		}
+	}
+	// The octal positions count letters over the whole string.
+	var b strings.Builder
+	b.WriteString("\"\"")
+	seen := 0
+	for _, p := range pieces {
+		var local []int
+		for _, o := range ss.octal {
+			if o >= seen && o < seen+letters(p) {
+				local = append(local, o-seen)
+			}
+		}
+		b.WriteString("\n\"" + poEscape(p, local) + "\"")
+		seen += letters(p)
+	}
+	return b.String()
+}
+
+// spellPO writes the catalog as a PO file in the spelling.
+func spellPO(c catalog, sp spelling) string {
+	var b strings.Builder
+	for _, cm := range c.comments {
+		b.WriteString(cm + "\n")
+	}
+	b.WriteString("msgid \"\"\nmsgstr \"\"\n")
+	for _, h := range c.headers {
+		b.WriteString("\"" + h[0] + ": " + poEscape(h[1], nil) + "\\n\"\n")
+	}
+	sep := sp.sep
+	next := 0
+	str := func(s string) string {
+		ss := stringSpelling{}
+		if next < len(sp.strs) {
+			ss = sp.strs[next]
+		}
+		next++
+		return poString(s, ss)
+	}
+	for _, e := range c.entries {
+		b.WriteString("\n")
+		for _, cm := range e.comments {
+			b.WriteString(cm + "\n")
+		}
+		if len(e.refs) > 0 {
+			b.WriteString("#: " + strings.Join(e.refs, " ") + "\n")
+		}
+		flags := append([]string{}, e.flags...)
+		if e.fuzzy {
+			flags = append([]string{"fuzzy"}, flags...)
+		}
+		if len(flags) > 0 {
+			b.WriteString("#, " + strings.Join(flags, ", ") + "\n")
+		}
+		if e.prev != "" {
+			b.WriteString("#| msgid \"" + poEscape(e.prev, nil) + "\"\n")
+		}
+		if e.hasCtx {
+			b.WriteString("msgctxt" + sep + str(e.ctx) + "\n")
+		}
+		b.WriteString("msgid" + sep + str(e.id) + "\n")
+		if e.hasPlural {
+			b.WriteString("msgid_plural" + sep + str(e.plural) + "\n")
+			for i, f := range e.forms {
+				b.WriteString("msgstr[" + strconv.Itoa(i) + "]" + sep + str(f) + "\n")
+			}
+		} else {
+			b.WriteString("msgstr" + sep + str(e.forms[0]) + "\n")
+		}
+	}
+	if sp.obsolete {
+		// An obsolete entry, ignored by everyone.
+		b.WriteString("\n#~ msgid \"obsolete\"\n#~ msgstr \"OBSOLETE\"\n")
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- msgfmt flags
+
+// msgfmtFlags are the options a catalog is compiled with: --no-hash 30, --endianness=big 30.
+type msgfmtFlags struct {
+	noHash    bool
+	bigEndian bool
+}
+
+func (f msgfmtFlags) args() []string {
+	var out []string
+	if f.noHash {
+		out = append(out, "--no-hash")
+	}
+	if f.bigEndian {
+		out = append(out, "--endianness=big")
+	}
+	return out
+}
+
+var msgfmtFlagsGen = hegel.FlatMap(dieCoin(30), func(noHash bool) hegel.Generator[msgfmtFlags] {
+	return hegel.Map(dieCoin(30), func(big bool) msgfmtFlags { return msgfmtFlags{noHash: noHash, bigEndian: big} })
+})
+
+// sortedStrings is a sorted copy.
+func sortedStrings(xs []string) []string {
+	out := append([]string{}, xs...)
+	sort.Strings(out)
+	return out
+}
diff --git a/hegel_zoo_idioms_test.go b/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..73f7c97
--- /dev/null
+++ b/hegel_zoo_idioms_test.go
@@ -0,0 +1,619 @@
+package gotext_test
+
+// The generator idioms the properties share, copied from the excelize/graphql-go/cobra/
+// cascadia/carbon/orb/chi/go-debian/gin/cellbuf/kong/roaring/mergo harness
+// (hegel_zoo_idioms_test.go there) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (HEGEL_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin and go/kong: evenHalves,
+// rangeHalves, countedHalves, halvesOver, halvesGens, evenGens) halve a range by fair bits,
+// and the figure beside every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	from   hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, from: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](parts ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(parts))
+		for i, g := range parts {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](parts ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range parts {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].from
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].from
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var subtrees []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			subtrees = append(subtrees, hegel.Just(vs[i]))
+		} else {
+			subtrees = append(subtrees, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(subtrees)), func(i int) hegel.Generator[T] { return subtrees[i] })
+	}
+	choices := make([]hzChoice[T], len(subtrees))
+	for i, g := range subtrees {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- added for
+// go/kong (halvesOver, halvesGens) and go/mergo (evenGens): weighted and even choices over
+// generators drawn by halving.
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves (the go/kong helper): the entries are cut where the cumulative weight is
+// nearest half, a fair-bit choice between the two parts at their summed weights (dieChoice),
+// and each part again, down to one value. Every split is two-way; an entry of weight zero is
+// never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	gens := make([]hegel.Generator[T], len(values))
+	for i, v := range values {
+		gens[i] = hegel.Just(v)
+	}
+	return halvesGens(weights, gens...)
+}
+
+// halvesGens is halvesOver over generators: the alternatives of a weighted choice at their
+// weights, drawn by halving (the first the shrink target).
+func halvesGens[T any](weights []int, gens ...hegel.Generator[T]) hegel.Generator[T] {
+	if len(weights) != len(gens) {
+		panic("halvesGens: weights and generators differ in length")
+	}
+	var ws []int
+	var gs []hegel.Generator[T]
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			gs = append(gs, gens[i])
+		}
+	}
+	if len(gs) == 0 {
+		panic("halvesGens: every alternative has weight 0")
+	}
+	if len(gs) == 1 {
+		return gs[0]
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(gs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesGens(ws[:cut], gs[:cut]...)), hzW(total-left, halvesGens(ws[cut:], gs[cut:]...)))
+}
+
+// evenGens is halvesGens at one weight each.
+func evenGens[T any](gens ...hegel.Generator[T]) hegel.Generator[T] {
+	ws := make([]int, len(gens))
+	for i := range ws {
+		ws[i] = 1
+	}
+	return halvesGens(ws, gens...)
+}
diff --git a/hegel_zoo_locale_test.go b/hegel_zoo_locale_test.go
new file mode 100644
index 0000000..7c2334a
--- /dev/null
+++ b/hegel_zoo_locale_test.go
@@ -0,0 +1,189 @@
+package gotext_test
+
+// Locale lookup on disk: AddDomain reads the first existing of
+// <path>/<ll_CC>/LC_MESSAGES/<dom>.po, <ll>/LC_MESSAGES, <ll_CC>/, <ll>/ (po before mo),
+// where ll_CC is the language simplified from the given tag; GetActualLanguage reports which
+// language directory was used.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/leonelquinteros/gotext"
+	"hegel.dev/go/hegel"
+)
+
+// place is a directory a domain file may be in, with the language it stands for.
+type place struct {
+	path string
+	lang string
+}
+
+// localeFile is a domain file: its place, its extension and the translation it holds.
+type localeFile struct {
+	place place
+	ext   string
+	text  string
+}
+
+// localeCase is a language tag (ll, cc, one of eight forms), a domain name, and which of
+// the four places' .po and .mo files exist (eight coins, 40 each, in place order).
+type localeCase struct {
+	ll, cc string
+	form   int
+	dom    string
+	exists []bool
+}
+
+func (c localeCase) GoString() string {
+	return fmt.Sprintf("localeCase{tag:%q dom:%q exists:%v}", c.tag(), c.dom, c.exists)
+}
+
+var localeCases = hegel.Composite(func(tc hegel.TestCase) localeCase {
+	return localeCase{
+		ll:     hegel.Draw(tc, evenHalves("es", "de", "pt")),
+		cc:     hegel.Draw(tc, evenHalves("ES", "AR", "BR")),
+		form:   hegel.Draw(tc, rangeHalves(0, 7)),
+		dom:    hegel.Draw(tc, evenHalves("default", "messages", "app")),
+		exists: hegel.Draw(tc, hzCounted(dieCoin(40), 8, 8)),
+	}
+})
+
+// tag is the language tag given to NewLocale.
+func (c localeCase) tag() string {
+	full := c.ll + "_" + c.cc
+	return []string{full, full + ".UTF-8", full + "@euro", full + ".ISO-8859-1@x", " " + full + " ", full + ":en", c.ll, c.ll + ".UTF-8"}[c.form]
+}
+
+// simplified is the language the tag simplifies to.
+func (c localeCase) simplified() string {
+	full := c.ll + "_" + c.cc
+	if strings.HasPrefix(strings.TrimSpace(c.tag()), full) {
+		return full
+	}
+	return c.ll
+}
+
+// places are the directories searched, in the documented order.
+func (c localeCase) places(dir string) []place {
+	s := c.simplified()
+	ps := []place{{filepath.Join(dir, s, "LC_MESSAGES", c.dom), s}}
+	if len(s) > 2 {
+		ps = append(ps, place{filepath.Join(dir, c.ll, "LC_MESSAGES", c.dom), c.ll})
+	}
+	ps = append(ps, place{filepath.Join(dir, s, c.dom), s})
+	if len(s) > 2 {
+		ps = append(ps, place{filepath.Join(dir, c.ll, c.dom), c.ll})
+	}
+	return ps
+}
+
+// files are the domain files that exist: per place a .po and a .mo by the coins.
+func (c localeCase) files(dir string) []localeFile {
+	var fs []localeFile
+	for i, p := range c.places(dir) {
+		for j, ext := range []string{"po", "mo"} {
+			if c.exists[2*i+j] {
+				fs = append(fs, localeFile{p, ext, fmt.Sprintf("file %d %s", i, ext)})
+			}
+		}
+	}
+	return fs
+}
+
+// localeRun is a case in its directory.
+type localeRun struct {
+	localeCase
+	dir string
+}
+
+func (r localeRun) GoString() string {
+	return r.localeCase.GoString() + " files:" + fmt.Sprint(r.files(r.dir))
+}
+
+// localeExpected: "language" NewLocale's language is the simplified tag; "get" Get("k") is
+// the translation of the first po file in place order, else of the first mo file, else "k";
+// "domain" the default domain is the domain when a file was found, else ""; "actual"
+// GetActualLanguage is the language of the first place with an mo file, else with a po file,
+// else "".
+func localeExpected(r localeRun, k known) checks {
+	out := checks{}
+	out.set("language", r.simplified())
+	files := r.files(r.dir)
+	want, wantLang := "k", ""
+	found := false
+	for _, ext := range []string{"po", "mo"} {
+		for _, p := range r.places(r.dir) {
+			for _, f := range files {
+				if f.place == p && f.ext == ext && !found {
+					want, found = f.text, true
+				}
+			}
+		}
+	}
+	for _, ext := range []string{"mo", "po"} {
+		for _, p := range r.places(r.dir) {
+			for _, f := range files {
+				if f.place == p && f.ext == ext && wantLang == "" {
+					wantLang = p.lang
+				}
+			}
+		}
+	}
+	out.set("get", want)
+	if found {
+		out.set("domain", r.dom)
+	} else {
+		out.set("domain", "")
+	}
+	out.set("actual", wantLang)
+	return out
+}
+
+func localeActual(r *localeRun) checks {
+	out := checks{}
+	l := gotext.NewLocale(r.dir, r.tag())
+	out.set("language", l.GetLanguage())
+	l.AddDomain(r.dom)
+	out.set("get", l.Get("k"))
+	out.set("domain", l.GetDomain())
+	out.set("actual", l.GetActualLanguage(r.dom))
+	return out
+}
+
+var localeDirs atomic.Int64
+
+// TestHegelLocaleFindsTheDocumentedFile: AddDomain reads the first existing of
+// <path>/<ll_CC>/LC_MESSAGES/<dom>.po, <ll>/LC_MESSAGES, <ll_CC>/, <ll>/ (po before mo),
+// where ll_CC is the language simplified from the given tag; GetActualLanguage reports which
+// language directory was used.
+func TestHegelLocaleFindsTheDocumentedFile(t *testing.T) {
+	if !haveMsgfmt {
+		t.Skip("msgfmt makes the MO files")
+	}
+	base := t.TempDir()
+	judged(t, localeCases, func(j *hzCaseJudge, c localeCase) {
+		dir := filepath.Join(base, strconv.Itoa(int(localeDirs.Add(1))))
+		os.MkdirAll(dir, 0o755)
+		r := localeRun{localeCase: c, dir: dir}
+		for _, f := range r.files(dir) {
+			os.MkdirAll(filepath.Dir(f.place.path), 0o755)
+			po := "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"k\"\nmsgstr \"" + f.text + "\"\n"
+			if f.ext == "po" {
+				os.WriteFile(f.place.path+".po", []byte(po), 0o644)
+			} else {
+				mo, msgs, err := msgfmt(dir, po)
+				if err != nil {
+					j.Fail("generator", "GENERATOR: msgfmt: %v %s", err, msgs)
+				}
+				os.WriteFile(f.place.path+".mo", mo, 0o644)
+			}
+		}
+		judgeBy(j, &r, localeExpected, localeActual)
+	})
+}
diff --git a/hegel_zoo_lookup_test.go b/hegel_zoo_lookup_test.go
new file mode 100644
index 0000000..939d08b
--- /dev/null
+++ b/hegel_zoo_lookup_test.go
@@ -0,0 +1,407 @@
+package gotext_test
+
+// The catalog property: a generated PO file compiled by msgfmt; gotext's Po and Mo parsers
+// answer Get/GetC/GetN/GetNC and IsTranslated* as GNU gettext (Python's GNUTranslations on
+// the MO) does, and agree with each other; the headers read back. The model (lookupExpected)
+// is the oracle's answers plus gotext's documented differences, a set of acceptable strings
+// per query and side, with the switch set threaded: kFuzzyUsed (gotext/1), kPluralFallback
+// (gotext/2), kSingularPluralEmpty (gotext/3) and kIsTranslatedIndex (gotext/4) are replicas
+// of the library's rules at the lines named in hegel_zoo_test.go.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/leonelquinteros/gotext"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the case
+
+// lookupCase is a catalog, its spelling, the msgfmt flags, per entry the coin for a second
+// context query ("menu") on a context-less entry, the number of the missing msgid and the
+// drawn value of n.
+type lookupCase struct {
+	cat     catalog
+	spell   spelling
+	flags   msgfmtFlags
+	menu    []bool
+	missing int
+	extraN  int
+}
+
+func (c lookupCase) GoString() string {
+	return fmt.Sprintf("lookupCase{cat:%s flags:%+v menu:%v missing:%d extraN:%d}\npo:\n%s", c.cat.GoString(), c.flags, c.menu, c.missing, c.extraN, spellPO(c.cat, c.spell))
+}
+
+// lookupCasesOver is the cases over a catalog population.
+func lookupCasesOver(cats hegel.Generator[catalog]) hegel.Generator[lookupCase] {
+	menu := dieCoin(50)
+	return hegel.Composite(func(tc hegel.TestCase) lookupCase {
+		c := lookupCase{cat: hegel.Draw(tc, cats)}
+		c.spell = hegel.Draw(tc, spellingFor(c.cat))
+		c.flags = hegel.Draw(tc, msgfmtFlagsGen)
+		c.menu = hegel.Draw(tc, hzCounted(menu, len(c.cat.entries), len(c.cat.entries)))
+		c.missing = hegel.Draw(tc, hegel.Integers(0, 99))
+		c.extraN = hegel.Draw(tc, hegel.Integers(0, 1000))
+		return c
+	})
+}
+
+var lookupCases = lookupCasesOver(lookupCatalogs)
+
+// ns are the values of n the plural lookups are made at.
+func (c lookupCase) ns() []int { return []int{0, 1, 2, 3, 5, 11, 21, 100, 101, c.extraN} }
+
+// queries are the lookups of a case: per entry Get, GetC in its context, GetC in another
+// context (always for a context entry, by the menu coin for a context-less one), GetN and
+// GetNC at every n; the same for a missing msgid.
+func (c lookupCase) queries() []query {
+	var qs []query
+	ns := c.ns()
+	for i, e := range c.cat.entries {
+		qs = append(qs, query{Kind: "get", ID: e.id}, query{Kind: "getc", Ctx: e.ctx, ID: e.id})
+		if e.hasCtx {
+			qs = append(qs, query{Kind: "getc", Ctx: "other", ID: e.id})
+		} else if c.menu[i] {
+			qs = append(qs, query{Kind: "getc", Ctx: "menu", ID: e.id})
+		}
+		pl := e.plural
+		if !e.hasPlural {
+			pl = e.id + "s"
+		}
+		for _, n := range ns {
+			qs = append(qs, query{Kind: "getn", ID: e.id, Plural: pl, N: n}, query{Kind: "getnc", Ctx: e.ctx, ID: e.id, Plural: pl, N: n})
+		}
+	}
+	missing := "missing " + strconv.Itoa(c.missing)
+	qs = append(qs, query{Kind: "get", ID: missing}, query{Kind: "getc", Ctx: "menu", ID: missing})
+	for _, n := range ns {
+		qs = append(qs, query{Kind: "getn", ID: missing, Plural: missing + "s", N: n}, query{Kind: "getnc", Ctx: "menu", ID: missing, Plural: missing + "s", N: n})
+	}
+	return qs
+}
+
+// lookupRun is a case with its PO text and the oracle's answers.
+type lookupRun struct {
+	lookupCase
+	po string
+	o  oracle
+}
+
+func (r lookupRun) GoString() string { return r.lookupCase.GoString() }
+
+// --------------------------------------------------------------------------- the model
+
+var sides = []string{"Po", "Mo"}
+
+// usable reports whether the parser of a side answers from the entry: the Po parser reads
+// every entry but, documented, a fuzzy one is not a translation (under kFuzzyUsed it is,
+// gotext/1); msgfmt leaves a fuzzy or untranslated entry (msgstr or msgstr[0] empty) out of
+// the MO.
+func usable(e entry, side string, k known) bool {
+	if side == "Po" {
+		return !e.fuzzy || k[kFuzzyUsed]
+	}
+	return !e.fuzzy && e.forms[0] != ""
+}
+
+// answers is the set of acceptable answers to the query on a side: GNU gettext's (the
+// oracle's, gnu) always, plus gotext's documented differences: a plural entry looked up
+// without n answers its first form (GNU's MO key is "msgid\x00msgid_plural"); a singular
+// entry looked up as a plural answers its translation (C libintl does the same for an
+// out-of-range form index, Python falls back to the msgid); an empty translated form answers
+// the untranslated text, the msgid for n == 1 and the entry's own msgid_plural otherwise (GNU
+// answers ""). The replicas: under kPluralFallback the untranslated text is picked by the
+// catalog's plural index (0 the msgid, else the plural; the caller's plural for a missing
+// entry under GetN, the entry's own for a present one under GetN and GetNC); under
+// kSingularPluralEmpty a singular entry at a plural index other than 0 answers "".
+func answers(r lookupRun, byKey map[string]entry, i int, q query, side string, k known) []string {
+	gnu := r.o.Answers[i]
+	set := []string{gnu}
+	plural := q.Kind == "getn" || q.Kind == "getnc"
+	idx := r.o.Idx[strconv.Itoa(q.N)]
+	e, present := byKey[q.Ctx+"\x04"+q.ID]
+	if !present || !usable(e, side, k) {
+		if plural && q.Kind == "getn" && k[kPluralFallback] {
+			if idx == 0 {
+				return append(set, q.ID)
+			}
+			return append(set, q.Plural)
+		}
+		return set
+	}
+	if !plural {
+		if e.forms[0] != "" {
+			set = append(set, e.forms[0])
+		}
+		return set
+	}
+	if e.hasPlural {
+		f := ""
+		if idx < len(e.forms) {
+			f = e.forms[idx]
+		}
+		if f != "" {
+			return append(set, f)
+		}
+		if q.N == 1 {
+			set = append(set, e.id)
+		} else {
+			set = append(set, e.plural)
+		}
+		if k[kPluralFallback] {
+			if idx == 0 {
+				set = append(set, e.id)
+			} else {
+				set = append(set, e.plural)
+			}
+		}
+		return set
+	}
+	if e.forms[0] != "" {
+		set = append(set, e.forms[0])
+	} else if k[kPluralFallback] && idx == 0 {
+		set = append(set, e.id)
+	}
+	if k[kSingularPluralEmpty] && idx != 0 {
+		set = append(set, "")
+	}
+	return set
+}
+
+// agreement is the set of acceptable values of the two sides' agreement check from their
+// answer sets: "same" when the sets are equal, "differ" when disjoint, both otherwise.
+func agreement(po, mo []string) []string {
+	same := hzSet(po...) == hzSet(mo...)
+	overlap := false
+	for _, a := range po {
+		for _, b := range mo {
+			if a == b {
+				overlap = true
+			}
+		}
+	}
+	switch {
+	case same:
+		return []string{"same"}
+	case overlap:
+		return []string{"same", "differ"}
+	}
+	return []string{"differ"}
+}
+
+// lookupExpected states the checks of a case: "<kind> <i> <side>" the answers to query i on
+// the side, "agree <i>" whether the sides agree, "istr <e> <side>" IsTranslated(C) of a
+// singular entry e (usable with a non-empty translation; under kIsTranslatedIndex only when
+// the catalog's plural index of 1 is 0, gotext/4), "istrn <e> n<n> <side>" IsTranslatedN(C)
+// of a plural entry at n (usable with a non-empty form at the index), "header <name> <side>"
+// the header's value, "language <side>" and "pluralforms <side>" the domain's fields.
+func lookupExpected(r lookupRun, k known) checks {
+	out := checks{}
+	byKey := r.cat.byKey()
+	for i, q := range r.queries() {
+		var sets [][]string
+		for _, side := range sides {
+			set := answers(r, byKey, i, q, side, k)
+			sets = append(sets, set)
+			out[fmt.Sprintf("%s %03d %s", q.Kind, i, side)] = hzSet(set...)
+		}
+		out[fmt.Sprintf("agree %03d", i)] = hzSet(agreement(sets[0], sets[1])...)
+	}
+	idx1 := r.o.Idx["1"]
+	for ei, e := range r.cat.entries {
+		for _, side := range sides {
+			u := usable(e, side, k)
+			if !e.hasPlural {
+				out.set(fmt.Sprintf("istr %02d %s", ei, side), u && e.forms[0] != "" && (!k[kIsTranslatedIndex] || idx1 == 0))
+				continue
+			}
+			for _, n := range r.ns() {
+				idx := r.o.Idx[strconv.Itoa(n)]
+				out.set(fmt.Sprintf("istrn %02d n%d %s", ei, n, side), u && idx < len(e.forms) && e.forms[idx] != "")
+			}
+		}
+	}
+	for _, side := range sides {
+		for _, h := range r.cat.headers {
+			out.set("header "+h[0]+" "+side, h[1])
+			if h[0] == "Language" {
+				out.set("language "+side, h[1])
+			}
+			if h[0] == "Plural-Forms" {
+				out.set("pluralforms "+side, h[1])
+			}
+		}
+	}
+	return out
+}
+
+// parsed is a parsed catalog on one side.
+type parsed struct {
+	name string
+	tr   gotext.Translator
+	intr gotext.IsTranslatedIntrospector
+}
+
+func ask(p parsed, q query) string {
+	switch q.Kind {
+	case "get":
+		return p.tr.Get(q.ID)
+	case "getc":
+		return p.tr.GetC(q.ID, q.Ctx)
+	case "getn":
+		return p.tr.GetN(q.ID, q.Plural, q.N)
+	}
+	return p.tr.GetNC(q.ID, q.Plural, q.N, q.Ctx)
+}
+
+// lookupActual asks the library the same questions.
+func lookupActual(r *lookupRun, mo []byte) checks {
+	out := checks{}
+	poObj := gotext.NewPo()
+	poObj.Parse([]byte(r.po))
+	moObj := gotext.NewMo()
+	moObj.Parse(mo)
+	ps := []parsed{{"Po", poObj, poObj}, {"Mo", moObj, moObj}}
+	for i, q := range r.queries() {
+		var got []string
+		for _, p := range ps {
+			got = append(got, ask(p, q))
+			out.set(fmt.Sprintf("%s %03d %s", q.Kind, i, p.name), got[len(got)-1])
+		}
+		if got[0] == got[1] {
+			out.set(fmt.Sprintf("agree %03d", i), "same")
+		} else {
+			out.set(fmt.Sprintf("agree %03d", i), "differ")
+		}
+	}
+	for ei, e := range r.cat.entries {
+		for _, p := range ps {
+			if !e.hasPlural {
+				got := p.intr.IsTranslated(e.id)
+				if e.hasCtx {
+					got = p.intr.IsTranslatedC(e.id, e.ctx)
+				}
+				out.set(fmt.Sprintf("istr %02d %s", ei, p.name), got)
+				continue
+			}
+			for _, n := range r.ns() {
+				var got bool
+				if e.hasCtx {
+					got = p.intr.IsTranslatedNC(e.id, n, e.ctx)
+				} else {
+					got = p.intr.IsTranslatedN(e.id, n)
+				}
+				out.set(fmt.Sprintf("istrn %02d n%d %s", ei, n, p.name), got)
+			}
+		}
+	}
+	for _, p := range ps {
+		d := p.tr.GetDomain()
+		for _, h := range r.cat.headers {
+			out.set("header "+h[0]+" "+p.name, d.Headers.Get(h[0]))
+			if h[0] == "Language" {
+				out.set("language "+p.name, d.Language)
+			}
+			if h[0] == "Plural-Forms" {
+				out.set("pluralforms "+p.name, d.PluralForms)
+			}
+		}
+	}
+	return out
+}
+
+// explain names the query or entry of every differing check.
+func (r lookupRun) explain(got, want checks) string {
+	qs := r.queries()
+	var parts []string
+	for _, k := range sortedKeys(want) {
+		g, ok := got[k]
+		if ok && agreeValue(k, g, want[k]) {
+			continue
+		}
+		words := strings.Fields(k)
+		if len(words) < 2 {
+			continue
+		}
+		i, err := strconv.Atoi(words[1])
+		if err != nil {
+			continue
+		}
+		switch words[0] {
+		case "get", "getc", "getn", "getnc", "agree":
+			if i < len(qs) {
+				e, present := r.cat.byKey()[qs[i].Ctx+"\x04"+qs[i].ID]
+				if present {
+					parts = append(parts, fmt.Sprintf("%s: %s on entry %s", k, qs[i], e.GoString()))
+				} else {
+					parts = append(parts, fmt.Sprintf("%s: %s on no entry", k, qs[i]))
+				}
+			}
+		case "istr", "istrn":
+			if i < len(r.cat.entries) {
+				parts = append(parts, fmt.Sprintf("%s: entry %s", k, r.cat.entries[i].GoString()))
+			}
+		}
+		if len(parts) >= 6 {
+			break
+		}
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return "\n" + strings.Join(parts, "\n")
+}
+
+// --------------------------------------------------------------------------- the property
+
+// lookupJudged runs a lookup property over the cases: the PO spelled and compiled (a
+// rejection is a generator failure), the oracle asked once, the library judged by dropping
+// (the shapes are some lookups of a case). A narrow property gives the region of its bug:
+// the shape needs the oracle's answers (the catalog's plural index at every n), so the case
+// is classified after the oracle and assumed away when it is not in the region (regionOf's
+// rule: by default the cases with that shape, under HEGEL_NO_KNOWN=1 those with none; the
+// rejections counted "filtered <id> as <shape>").
+func lookupJudged(t *testing.T, cases hegel.Generator[lookupCase], expected func(lookupRun, known) checks, region string) {
+	t.Helper()
+	dir := t.TempDir()
+	judged(t, cases, func(j *hzCaseJudge, c lookupCase) {
+		r := lookupRun{lookupCase: c, po: spellPO(c.cat, c.spell)}
+		mo, msgs, err := msgfmt(dir, r.po, c.flags.args()...)
+		if err != nil {
+			j.Fail("generator", "GENERATOR: msgfmt rejects the generated PO: %v\n%s\npo:\n%s", err, msgs, r.po)
+		}
+		r.o = pyLookup(j.ht, dir, mo, r.queries(), c.ns())
+		for _, e := range c.cat.entries {
+			if e.fuzzy {
+				hzTally("fuzzy entry drawn")
+				break
+			}
+		}
+		if region != "" {
+			got := shapeID(r, expected)
+			if got != hzShaped(region, "") {
+				if got == "" {
+					got = "none"
+				}
+				hzTally("filtered " + region)
+				hzTally("filtered " + region + " as " + got)
+				j.ht.Assume(false)
+			}
+		}
+		judgeByDropping(j, &r, expected, func(r *lookupRun) checks { return lookupActual(r, mo) })
+	})
+}
+
+// TestHegelCatalogsAgreeWithGettext: a generated PO file compiled by msgfmt; gotext's Po and
+// Mo parsers answer Get/GetC/GetN/GetNC and IsTranslated* as GNU gettext (Python's
+// GNUTranslations on the MO) does, and agree with each other; the headers read back.
+func TestHegelCatalogsAgreeWithGettext(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	lookupJudged(t, lookupCases, lookupExpected, "")
+}
diff --git a/hegel_zoo_marshal_test.go b/hegel_zoo_marshal_test.go
new file mode 100644
index 0000000..c33f68c
--- /dev/null
+++ b/hegel_zoo_marshal_test.go
@@ -0,0 +1,829 @@
+package gotext_test
+
+// The round trips: MarshalText (a parsed PO written back is a PO msgfmt accepts, parses to
+// the same domain, and writes the same again; the model describeCatalog states the domain
+// from the catalog record with kMarshalNonASCII, gotext/6, and kBackslashQuote, gotext/7,
+// threaded), msgunfmt (the Mo parser's domain is msgunfmt's PO parsed), gob
+// (MarshalBinary/UnmarshalBinary of a domain and of a Locale) and the broken inputs (mutated
+// PO text, MO bytes and expressions never panic).
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/leonelquinteros/gotext"
+	"github.com/leonelquinteros/gotext/plurals"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the model
+
+// reparseK is what a string of the catalog reads back as after MarshalText: itself; under
+// kMarshalNonASCII every character outside ASCII as U+FFFD (only its first byte was written,
+// strconv.Unquote reads the invalid byte as the replacement character); under
+// kBackslashQuote with every `\"` as `"` (one pass: `\\"` reads as `\"`).
+func reparseK(s string, k known) string {
+	if k[kBackslashQuote] {
+		s = strings.ReplaceAll(s, `\"`, `"`)
+	}
+	if k[kMarshalNonASCII] {
+		s = strings.Map(func(r rune) rune {
+			if r >= utf8.RuneSelf {
+				return utf8.RuneError
+			}
+			return r
+		}, s)
+	}
+	return s
+}
+
+// escapeK is EscapeSpecialCharacters (domain.go :903-957) transcribed with the switches: a
+// backslash is doubled and a quote escaped (documented), except, under kBackslashQuote, a
+// backslash before a quote and a quote after a backslash, written as they are; every other
+// byte of a rune start is written as it is, which under kMarshalNonASCII is the first byte of
+// the character (documented: the whole character); then a single trailing newline as `\n`,
+// several lines as continuation lines.
+func escapeK(s string, k known) string {
+	var b strings.Builder
+	for i, r := range s {
+		switch r {
+		case '\\':
+			b.WriteByte('\\')
+			if !k[kBackslashQuote] || i+1 >= len(s) || s[i+1] != '"' {
+				b.WriteByte('\\')
+			}
+		case '"':
+			if !k[kBackslashQuote] || i == 0 || s[i-1] != '\\' {
+				b.WriteByte('\\')
+			}
+			b.WriteByte('"')
+		default:
+			if k[kMarshalNonASCII] {
+				b.WriteByte(s[i])
+			} else {
+				b.WriteRune(r)
+			}
+		}
+	}
+	s = b.String()
+	if strings.Count(s, "\n") == 0 {
+		return s
+	}
+	if strings.Count(s, "\n") == 1 && strings.HasSuffix(s, "\n") {
+		return strings.ReplaceAll(s, "\n", "\\n")
+	}
+	elems := strings.Split(s, "\n")
+	var endsWithEOL bool
+	if elems[len(elems)-1] == "" {
+		elems = elems[:len(elems)-1]
+		endsWithEOL = true
+	}
+	data := []string{`"`}
+	for i, v := range elems {
+		l := fmt.Sprintf(`"%s\n"`, v)
+		if i == len(elems)-1 && !endsWithEOL {
+			l = fmt.Sprintf(`"%s"`, v)
+		}
+		if i == len(elems)-1 {
+			l = strings.TrimSuffix(l, `"`)
+		}
+		data = append(data, l)
+	}
+	return strings.Join(data, "\n")
+}
+
+// entryStrings are the strings of an entry MarshalText writes.
+func entryStrings(e entry) []string {
+	var out []string
+	if e.hasCtx {
+		out = append(out, e.ctx)
+	}
+	out = append(out, e.id)
+	if e.hasPlural {
+		out = append(out, e.plural)
+	}
+	return append(out, e.forms...)
+}
+
+// entryRefs are the references of every entry as the PO parser reads them: its own `#:`
+// references; under kRefsLeak an entry without them has those of the nearest earlier entry
+// that had any (po.go: the reference buffer is set by a `#:` line and never cleared).
+func entryRefs(c catalog, k known) [][]string {
+	out := make([][]string, len(c.entries))
+	var last []string
+	for i, e := range c.entries {
+		if len(e.refs) > 0 {
+			last = e.refs
+			out[i] = e.refs
+		} else if k[kRefsLeak] {
+			out[i] = last
+		}
+	}
+	return out
+}
+
+// pathAndLine is extractPathAndLine (domain.go :716): the first reference's path and line,
+// "" and 0 without one.
+func pathAndLine(refs []string) (string, int) {
+	if len(refs) == 0 {
+		return "", 0
+	}
+	ref := refs[0]
+	if i := strings.IndexByte(ref, ':'); i >= 0 {
+		line, _ := strconv.Atoi(ref[i+1:])
+		return ref[:i], line
+	}
+	return ref, 0
+}
+
+// describeCatalog states describeDomain's text of the catalog as the Po parser reads it (k
+// none: with the references, withRefs) or as it reads MarshalText's output (reparseK over
+// every string of every entry; inMO instead keeps only the entries msgfmt compiles, without
+// references, the Mo parser's domain). Where two entries read back to one key the later of
+// them in MarshalText's order wins (domain.go :843-864: by the first reference's path and
+// line, the context and the msgid, of the entries as parsed), and carries its own
+// references (MarshalText writes every entry's `#:` line; the entries without one come
+// first in its order, so nothing leaks on the second parse). The winner is one, so the
+// statement is one text (a slice for the callers' sake).
+func describeCatalog(c catalog, k known, inMO bool) []string {
+	type tr struct {
+		ctx, id, plural string
+		forms           []string
+		refs            []string
+		order           int
+	}
+	refs := entryRefs(c, k)
+	var trs []tr
+	for i, e := range c.entries {
+		if inMO && (e.fuzzy || e.forms[0] == "") {
+			continue
+		}
+		t := tr{ctx: reparseK(e.ctx, k), id: reparseK(e.id, k), refs: refs[i], order: i}
+		if e.hasPlural {
+			t.plural = reparseK(e.plural, k)
+		}
+		for _, f := range e.forms {
+			t.forms = append(t.forms, reparseK(f, k))
+		}
+		trs = append(trs, t)
+	}
+	// MarshalText's order of the parsed entries (their original keys).
+	less := func(a, b int) bool {
+		ea, eb := c.entries[a], c.entries[b]
+		pa, la := pathAndLine(refs[a])
+		pb, lb := pathAndLine(refs[b])
+		if pa != pb {
+			return pa < pb
+		}
+		if la != lb {
+			return la < lb
+		}
+		if ea.ctx != eb.ctx {
+			return ea.ctx < eb.ctx
+		}
+		return ea.id < eb.id
+	}
+	winner := map[string]int{}
+	for i, t := range trs {
+		key := t.ctx + "\x04" + t.id
+		if w, ok := winner[key]; !ok || less(trs[w].order, t.order) {
+			winner[key] = i
+		}
+	}
+	var plain, ctx []tr
+	for _, i := range winner {
+		if trs[i].ctx == "" {
+			plain = append(plain, trs[i])
+		} else {
+			ctx = append(ctx, trs[i])
+		}
+	}
+	byKey := func(xs []tr) func(i, j int) bool {
+		return func(i, j int) bool {
+			if xs[i].ctx != xs[j].ctx {
+				return xs[i].ctx < xs[j].ctx
+			}
+			return xs[i].id < xs[j].id
+		}
+	}
+	sort.Slice(plain, byKey(plain))
+	sort.Slice(ctx, byKey(ctx))
+	var b strings.Builder
+	fmt.Fprintf(&b, "language=%q plural-forms=%q\n", c.header("Language"), c.header("Plural-Forms"))
+	names := make([]string, 0, len(c.headers))
+	for _, h := range c.headers {
+		names = append(names, h[0])
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		fmt.Fprintf(&b, "header %q = %q\n", n, []string{c.header(n)})
+	}
+	write := func(prefix string, t tr) {
+		fmt.Fprintf(&b, "%s id=%q plural=%q", prefix, t.id, t.plural)
+		for i, f := range t.forms {
+			fmt.Fprintf(&b, " [%d]=%q", i, f)
+		}
+		if !inMO {
+			fmt.Fprintf(&b, " refs=%q", t.refs)
+		}
+		b.WriteString("\n")
+	}
+	for _, t := range plain {
+		write("tr", t)
+	}
+	for _, t := range ctx {
+		write(fmt.Sprintf("ctx %q", t.ctx), t)
+	}
+	return []string{b.String()}
+}
+
+// marshalCase is a catalog and its spelling.
+type marshalCase struct {
+	cat   catalog
+	spell spelling
+}
+
+func (c marshalCase) GoString() string {
+	return fmt.Sprintf("marshalCase{cat:%s}\npo:\n%s", c.cat.GoString(), spellPO(c.cat, c.spell))
+}
+
+// marshalCasesOver is the cases over a catalog population.
+func marshalCasesOver(cats hegel.Generator[catalog]) hegel.Generator[marshalCase] {
+	return hegel.FlatMap(cats, func(c catalog) hegel.Generator[marshalCase] {
+		return hegel.Map(spellingFor(c), func(sp spelling) marshalCase { return marshalCase{cat: c, spell: sp} })
+	})
+}
+
+// backslashQuote reports a backslash before a quote in a string of the catalog's entries
+// (the shape of gotext/7).
+func backslashQuote(c catalog) bool {
+	for _, e := range c.entries {
+		for _, s := range entryStrings(e) {
+			if strings.Contains(s, `\"`) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// catalogNonASCII reports a character outside ASCII in a string of the catalog's entries (the
+// shape of gotext/6).
+func catalogNonASCII(c catalog) bool {
+	for _, e := range c.entries {
+		for _, s := range entryStrings(e) {
+			if nonASCII(s) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// refsLeak reports an entry with `#:` references followed by one without (the shape of
+// gotext/8).
+func refsLeak(c catalog) bool {
+	seen := false
+	for _, e := range c.entries {
+		if len(e.refs) > 0 {
+			seen = true
+		} else if seen {
+			return true
+		}
+	}
+	return false
+}
+
+// marshalCases are the MarshalText property's cases: the marshal catalogs (no fuzzy entry;
+// under HEGEL_NO_KNOWN=1 no non-ASCII text, gotext/6, and the references all or none,
+// gotext/8) without a backslash before a quote under HEGEL_NO_KNOWN=1 (gotext/7, filtered:
+// measured 8 percent of the catalogs).
+var marshalCases = hzOnly(hzNoKnown, "gotext/7", marshalCasesOver(marshalCatalogs), func(c marshalCase) bool { return !backslashQuote(c.cat) })
+
+// marshalRun is a case with its PO text and what the library left: the marshalled text, the
+// two descriptions and the second text (the explanation of a failure).
+type marshalRun struct {
+	marshalCase
+	po         string
+	text       string
+	d1, d2     string
+	text2      string
+	msgfmtMsgs string
+}
+
+func (r marshalRun) GoString() string { return r.marshalCase.GoString() }
+
+// marshalExpected: "parsed" the Po parser's domain is the catalog's, references included
+// (under kRefsLeak with the leaked ones); "reparsed" MarshalText's output parses to the same
+// domain (under the switches, to the corrupted one); "msgfmt" accepts the output (under
+// kMarshalNonASCII with a non-ASCII string it rejects the invalid bytes, and where two keys
+// read back alike the duplicate message);
+// "idempotent" a second MarshalText is the first (under the switches, only when every
+// string's escape is a fixpoint of its reparse and no keys collide, and either way when a
+// key reads back differently, which may reorder the entries).
+func marshalExpected(r marshalRun, k known) checks {
+	out := checks{}
+	var parsedK known
+	parsedK[kRefsLeak] = k[kRefsLeak]
+	out.set("parsed", describeCatalog(r.cat, parsedK, false)[0])
+	out.set("reparsed", describeCatalog(r.cat, k, false)[0])
+	idem, collide, reordered := true, false, false
+	keys := map[string]bool{}
+	for _, e := range r.cat.entries {
+		for _, s := range entryStrings(e) {
+			if escapeK(reparseK(s, k), k) != escapeK(s, k) {
+				idem = false
+			}
+		}
+		key := reparseK(e.ctx, k) + "\x04" + reparseK(e.id, k)
+		if key != e.ctx+"\x04"+e.id {
+			reordered = true
+		}
+		if keys[key] {
+			collide = true
+		}
+		keys[key] = true
+	}
+	if (k[kMarshalNonASCII] && catalogNonASCII(r.cat)) || collide {
+		// invalid bytes, or two entries written alike ("duplicate message definition")
+		out.set("msgfmt", "rejects")
+	} else {
+		out.set("msgfmt", "accepts")
+	}
+	switch {
+	case !idem || collide:
+		out.set("idempotent", false)
+	case reordered:
+		// MarshalText orders the entries by context and msgid after their first reference,
+		// so a key that reads back differently may move; the model does not state the order
+		out["idempotent"] = hzSet("true", "false")
+	default:
+		out.set("idempotent", true)
+	}
+	return out
+}
+
+func marshalActual(r *marshalRun, dir string) checks {
+	out := checks{}
+	p1 := gotext.NewPo()
+	p1.Parse([]byte(r.po))
+	text, err := p1.MarshalText()
+	if err != nil {
+		out.set("marshal", "error: "+err.Error())
+		return out
+	}
+	r.text = string(text)
+	p2 := gotext.NewPo()
+	p2.Parse(text)
+	r.d1, r.d2 = describeDomain(p1.GetDomain(), true), describeDomain(p2.GetDomain(), true)
+	out.set("parsed", r.d1)
+	out.set("reparsed", r.d2)
+	if haveMsgfmt {
+		if _, msgs, err := msgfmt(dir, r.text); err != nil {
+			r.msgfmtMsgs = msgs
+			out.set("msgfmt", "rejects")
+		} else {
+			out.set("msgfmt", "accepts")
+		}
+	}
+	text2, _ := p2.MarshalText()
+	r.text2 = string(text2)
+	out.set("idempotent", r.text2 == r.text)
+	return out
+}
+
+func (r marshalRun) explain(got, want checks) string {
+	var parts []string
+	for _, name := range []string{"parsed", "reparsed"} {
+		if g, ok := got[name]; ok && !agreeValue(name, g, want[name]) {
+			from := r.d1
+			if name == "reparsed" {
+				from = r.d2
+			}
+			parts = append(parts, fmt.Sprintf("%s differs from the model at %s", name, firstDiff(from, hzMembers(want[name])[0])))
+		}
+	}
+	if g, ok := got["idempotent"]; ok && !agreeValue("idempotent", g, want["idempotent"]) {
+		parts = append(parts, "second MarshalText:\n"+r.text2)
+	}
+	if r.msgfmtMsgs != "" {
+		parts = append(parts, "msgfmt: "+strings.TrimSpace(r.msgfmtMsgs))
+	}
+	return "\nmarshalled:\n" + r.text + "\n" + strings.Join(parts, "\n")
+}
+
+// marshalJudged runs a MarshalText property over the cases.
+func marshalJudged(t *testing.T, cases hegel.Generator[marshalCase]) {
+	t.Helper()
+	dir := t.TempDir()
+	judged(t, cases, func(j *hzCaseJudge, c marshalCase) {
+		r := marshalRun{marshalCase: c, po: spellPO(c.cat, c.spell)}
+		if catalogNonASCII(c.cat) {
+			hzTally("non-ASCII drawn")
+		}
+		if backslashQuote(c.cat) {
+			hzTally("backslash-quote drawn")
+		}
+		if refsLeak(c.cat) {
+			hzTally("refs leak drawn")
+		}
+		for _, e := range c.cat.entries {
+			hzTally("entry drawn")
+			if len(e.refs) > 0 {
+				hzTally("entry with refs drawn")
+			}
+		}
+		judgeBy(j, &r, marshalExpected, func(r *marshalRun) checks { return marshalActual(r, dir) })
+	})
+}
+
+// TestHegelMarshalTextRoundTrips: a parsed PO holds the catalog's entries with their own
+// references; written with MarshalText it is a PO file msgfmt accepts, and parses back to the
+// same domain (headers, translations, contexts, references); a second MarshalText is
+// identical.
+func TestHegelMarshalTextRoundTrips(t *testing.T) {
+	marshalJudged(t, marshalCases)
+}
