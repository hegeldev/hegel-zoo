+// ---------------------------------------------------------------------------
+// Locale lookup on disk.
+
+// TestHegelLocaleFindsTheDocumentedFile: AddDomain reads the first existing
+// of <path>/<ll_CC>/LC_MESSAGES/<dom>.po, <ll>/LC_MESSAGES, <ll_CC>/, <ll>/
+// (po before mo), where ll_CC is the language simplified from the given
+// tag; GetActualLanguage reports which language directory was used.
+var localeDirs atomic.Int64
+
+func TestHegelLocaleFindsTheDocumentedFile(t *testing.T) {
+	if !haveMsgfmt {
+		t.Skip("msgfmt makes the MO files")
+	}
+	base := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		dir := filepath.Join(base, strconv.Itoa(int(localeDirs.Add(1))))
+		os.MkdirAll(dir, 0o755)
+		ll := pick(ht, "es", "de", "pt")
+		cc := pick(ht, "ES", "AR", "BR")
+		full := ll + "_" + cc
+		tag := pick(ht, full, full+".UTF-8", full+"@euro", full+".ISO-8859-1@x", " "+full+" ", full+":en", ll, ll+".UTF-8")
+		simplified := ll
+		if strings.HasPrefix(strings.TrimSpace(tag), full) {
+			simplified = full
+		}
+		dom := pick(ht, "default", "messages", "app")
+		type place struct {
+			path string
+			lang string
+		}
+		var places []place
+		for _, l := range []string{simplified} {
+			places = append(places, place{filepath.Join(dir, l, "LC_MESSAGES", dom), l})
+		}
+		if len(simplified) > 2 {
+			places = append(places, place{filepath.Join(dir, ll, "LC_MESSAGES", dom), ll})
+		}
+		places = append(places, place{filepath.Join(dir, simplified, dom), simplified})
+		if len(simplified) > 2 {
+			places = append(places, place{filepath.Join(dir, ll, dom), ll})
+		}
+		// Files: each place may have a .po, a .mo, both or none.
+		type file struct {
+			place place
+			ext   string
+			text  string
+		}
+		var files []file
+		for i, p := range places {
+			for _, ext := range []string{"po", "mo"} {
+				if chance(ht, 40) {
+					text := fmt.Sprintf("file %d %s", i, ext)
+					files = append(files, file{p, ext, text})
+				}
+			}
+		}
+		for _, f := range files {
+			os.MkdirAll(filepath.Dir(f.place.path), 0o755)
+			po := "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"k\"\nmsgstr \"" + f.text + "\"\n"
+			if f.ext == "po" {
+				os.WriteFile(f.place.path+".po", []byte(po), 0o644)
+			} else {
+				mo, msgs, err := msgfmt(dir, po)
+				if err != nil {
+					fail(ht, "msgfmt: %v %s", err, msgs)
+				}
+				os.WriteFile(f.place.path+".mo", mo, 0o644)
+			}
+		}
+		// Expected: po files in place order, then mo files in place order.
+		var want *file
+		for _, ext := range []string{"po", "mo"} {
+			for _, p := range places {
+				for i := range files {
+					if files[i].place == p && files[i].ext == ext && want == nil {
+						want = &files[i]
+					}
+				}
+			}
+		}
+		// GetActualLanguage: every place with an mo, then every place with a po.
+		var wantLang string
+		for _, ext := range []string{"mo", "po"} {
+			for _, p := range places {
+				for _, f := range files {
+					if f.place == p && f.ext == ext && wantLang == "" {
+						wantLang = p.lang
+					}
+				}
+			}
+		}
+		l := gotext.NewLocale(dir, tag)
+		note(ht, "tag %q simplified %q dom %q files %v", tag, simplified, dom, files)
+		if l.GetLanguage() != simplified {
+			fail(ht, "NewLocale(%q).GetLanguage() = %q, expected %q", tag, l.GetLanguage(), simplified)
+		}
+		l.AddDomain(dom)
+		got := l.Get("k")
+		if want == nil {
+			if got != "k" {
+				fail(ht, "with no files Get(%q) = %q", "k", got)
+			}
+			if l.GetDomain() != "" {
+				fail(ht, "with no files the default domain is %q", l.GetDomain())
+			}
+		} else {
+			if got != want.text {
+				fail(ht, "Get(k) = %q, expected %q (files %v)", got, want.text, files)
+			}
+			if l.GetDomain() != dom {
+				fail(ht, "default domain %q, expected %q", l.GetDomain(), dom)
+			}
+		}
+		if al := l.GetActualLanguage(dom); al != wantLang {
+			fail(ht, "GetActualLanguage(%q) = %q, expected %q (files %v)", dom, al, wantLang, files)
+		}
+	})
+}
