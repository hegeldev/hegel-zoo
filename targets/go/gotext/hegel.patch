+// ---------------------------------------------------------------------------
+// Broken inputs.
+
+func mutate(tc hegel.TestCase, b []byte) []byte {
+	b = append([]byte{}, b...)
+	for k := n(tc, 1, 4); k > 0; k-- {
+		if len(b) == 0 {
+			return b
+		}
+		i := n(tc, 0, len(b)-1)
+		switch n(tc, 1, 5) {
+		case 1:
+			j := i + n(tc, 0, min(40, len(b)-i))
+			b = append(b[:i:i], b[j:]...)
+		case 2:
+			b[i] = byte(n(tc, 0, 255))
+		case 3:
+			j := i + n(tc, 0, min(40, len(b)-i))
+			b = append(b[:j:j], append([]byte{}, b[i:]...)...)
+		case 4:
+			b = append(b[:i:i], append([]byte(pick(tc, "msgid", "\"", "\\", "msgstr[", "[9]", "\n", "%", "msgctxt", "\x00", "\x04", "(", "?", ":")), b[i:]...)...)
+		default:
+			b[i] ^= 1 << uint(n(tc, 0, 7))
+		}
+	}
+	return b
+}
+
+// TestHegelBrokenInputsNeverPanic: mutated PO text, MO bytes and plural
+// expressions never panic, and every lookup afterwards answers.
+func TestHegelBrokenInputsNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genCatalog(ht, true)
+		po := []byte(spellPO(ht, c))
+		switch n(ht, 1, 3) {
+		case 1:
+			bad := mutate(ht, po)
+			note(ht, "po:\n%s", bad)
+			p := gotext.NewPo()
+			p.Parse(bad)
+			p.Get("x")
+			p.GetN("x", "y", n(ht, -3, 7))
+			p.GetC("x", "c")
+			p.GetNC("x", "y", n(ht, -3, 7), "c")
+			p.IsTranslatedN("x", n(ht, -3, 7))
+			if text, err := p.MarshalText(); err == nil {
+				gotext.NewPo().Parse(text)
+			}
+			if data, err := p.MarshalBinary(); err == nil {
+				gotext.NewPo().UnmarshalBinary(data)
+			}
+		case 2:
+			if !haveMsgfmt {
+				return
+			}
+			dir := t.TempDir()
+			mo, msgs, err := msgfmt(dir, string(po))
+			if err != nil {
+				fail(ht, "GENERATOR: msgfmt rejects the generated PO: %v\n%s\npo:\n%s", err, msgs, po)
+			}
+			bad := mutate(ht, mo)
+			note(ht, "mo: %x", bad)
+			m := gotext.NewMo()
+			m.Parse(bad)
+			m.Get("x")
+			m.GetN("x", "y", n(ht, -3, 7))
+			m.GetNC("x", "y", n(ht, -3, 7), "c")
+			m.IsTranslatedNC("x", n(ht, -3, 7), "c")
+		default:
+			g := &pgen{tc: ht, bare: true}
+			expr := string(mutate(ht, []byte(g.renderExpr(g.expr(3, 4)))))
+			note(ht, "expression: %q", expr)
+			if e, err := plurals.Compile(expr); err == nil {
+				for _, nv := range []uint32{0, 1, 2, 7, 100, 4294967295} {
+					e.Eval(nv)
+				}
+			}
+			// The header form too.
+			p := gotext.NewPo()
+			p.Parse([]byte("msgid \"\"\nmsgstr \"\"\n\"Plural-Forms: nplurals=3; plural=" + strings.ReplaceAll(expr, "\n", " ") + ";\\n\"\n\nmsgid \"a\"\nmsgid_plural \"b\"\nmsgstr[0] \"A\"\nmsgstr[1] \"B\"\n"))
+			for _, nv := range []int{0, 1, 2, 7, 100, -1} {
+				p.GetN("a", "b", nv)
+			}
+		}
+	})
+}
