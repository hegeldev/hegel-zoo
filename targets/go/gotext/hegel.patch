diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..78ad39d
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,165 @@
+package gotext_test
+
+// Deterministic pins for the recorded bugs (bugs.toml). Each asserts the
+// GNU gettext behaviour and fails while the bug is open; the properties skip
+// the shape behind the matching Known gate in hegel_test.go.
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/leonelquinteros/gotext"
+	"github.com/leonelquinteros/gotext/plurals"
+)
+
+const arabicHeader = "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=6; plural=n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5;\\n\"\n"
+
+const frenchHeader = "msgid \"\"\nmsgstr \"\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=2; plural=n>1;\\n\"\n"
+
+func parsePO(src string) *gotext.Po {
+	p := gotext.NewPo()
+	p.Parse([]byte(src))
+	return p
+}
+
+// gotext/1: a fuzzy translation is not a translation (msgfmt leaves it out
+// of the MO; GNU gettext returns the msgid).
+func TestHegelPinFuzzyTranslationsAreNotUsed(t *testing.T) {
+	p := parsePO(frenchHeader + "\n#, fuzzy\nmsgid \"fz\"\nmsgstr \"FZ\"\n\n#, fuzzy, no-c-format\nmsgid \"apple\"\nmsgid_plural \"apples\"\nmsgstr[0] \"A0\"\nmsgstr[1] \"A1\"\n")
+	if got := p.Get("fz"); got != "fz" {
+		t.Errorf("Get of a fuzzy entry = %q, expected the msgid %q", got, "fz")
+	}
+	if p.IsTranslated("fz") {
+		t.Errorf("IsTranslated of a fuzzy entry is true")
+	}
+	if got := p.GetN("apple", "apples", 2); got != "apples" {
+		t.Errorf("GetN of a fuzzy plural entry = %q, expected %q", got, "apples")
+	}
+}
+
+// gotext/2: an untranslated plural lookup picks the singular for n == 1 and
+// the plural otherwise (GNU ngettext; gotext's own GetNC and Locale rule),
+// whatever the catalog's plural rule says.
+func TestHegelPinUntranslatedPluralFallsBackByOne(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"item\"\nmsgid_plural \"items\"\nmsgstr[0] \"\"\nmsgstr[1] \"\"\n")
+	if got := p.GetN("missing", "missings", 0); got != "missings" {
+		t.Errorf("GetN(missing, missings, 0) = %q under plural=n>1, expected %q (GetNC gives %q)", got, "missings", p.GetNC("missing", "missings", 0, "c"))
+	}
+	if got := p.GetN("item", "items", 0); got != "items" {
+		t.Errorf("GetN(item, items, 0) of an untranslated entry = %q, expected %q", got, "items")
+	}
+	if got := string(p.AppendN(nil, "missing", "missings", 0)); got != "missings" {
+		t.Errorf("AppendN(missing, missings, 0) = %q, expected %q", got, "missings")
+	}
+	ar := parsePO(arabicHeader)
+	if got := ar.GetN("missing", "missings", 1); got != "missing" {
+		t.Errorf("GetN(missing, missings, 1) under the Arabic rule = %q, expected %q", got, "missing")
+	}
+}
+
+// gotext/3: a singular entry looked up as a plural answers text, never the
+// empty string: C libintl gives the entry's translation (its only form),
+// Python's gettext the untranslated plural msgid; an untranslated entry
+// gives the msgid for n == 1 and the plural msgid otherwise.
+func TestHegelPinSingularEntriesAnswerPluralLookups(t *testing.T) {
+	p := parsePO(arabicHeader + "\nmsgid \"plain\"\nmsgstr \"PLAIN\"\n\nmsgid \"blank\"\nmsgstr \"\"\n\nmsgctxt \"c\"\nmsgid \"ctx\"\nmsgstr \"CTX\"\n")
+	cases := []struct {
+		got  string
+		want []string
+		what string
+	}{
+		{p.GetN("plain", "plains", 2), []string{"PLAIN", "plains"}, "GetN(plain, plains, 2)"},
+		{p.GetN("blank", "blanks", 5), []string{"blanks"}, "GetN(blank, blanks, 5)"},
+		{p.GetNC("ctx", "ctxs", 2, "c"), []string{"CTX", "ctxs"}, "GetNC(ctx, ctxs, 2, c)"},
+		{string(p.AppendN(nil, "plain", "plains", 2)), []string{"PLAIN", "plains"}, "AppendN(plain, plains, 2)"},
+	}
+	for _, c := range cases {
+		ok := false
+		for _, w := range c.want {
+			ok = ok || c.got == w
+		}
+		if !ok {
+			t.Errorf("%s = %q, expected one of %q", c.what, c.got, c.want)
+		}
+	}
+}
+
+// gotext/4: IsTranslated of a singular entry does not depend on the
+// catalog's plural rule.
+func TestHegelPinIsTranslatedIgnoresThePluralRule(t *testing.T) {
+	p := parsePO(arabicHeader + "\nmsgid \"plain\"\nmsgstr \"PLAIN\"\n\nmsgctxt \"c\"\nmsgid \"ctx\"\nmsgstr \"CTX\"\n")
+	if !p.IsTranslated("plain") {
+		t.Errorf("IsTranslated(plain) is false under the Arabic rule although msgstr is %q", p.Get("plain"))
+	}
+	if !p.IsTranslatedC("ctx", "c") {
+		t.Errorf("IsTranslatedC(ctx, c) is false under the Arabic rule although msgstr is %q", p.GetC("ctx", "c"))
+	}
+	l := gotext.NewLocale("/nowhere", "ar")
+	l.AddTranslator("default", p)
+	if !l.IsTranslated("plain") {
+		t.Errorf("Locale.IsTranslated(plain) is false under the Arabic rule")
+	}
+}
+
+// gotext/5: in a C plural expression a bare `n` or `n % k` is a non-zero
+// test, and the value of the expression `n` is n.
+func TestHegelPinBareTestsAreNonZeroTests(t *testing.T) {
+	cases := []struct {
+		expr string
+		n    uint32
+		want int
+	}{
+		{"n ? 1 : 0", 2, 1},
+		{"n ? 1 : 0", 0, 0},
+		{"(n % 10) ? 1 : 0", 3, 1},
+		{"(n % 10) ? 1 : 0", 10, 0},
+		{"n", 2, 2},
+		{"n && n != 1 ? 1 : 0", 5, 1},
+	}
+	for _, c := range cases {
+		e, err := plurals.Compile(c.expr)
+		if err != nil {
+			t.Errorf("Compile(%q): %v", c.expr, err)
+			continue
+		}
+		if got := e.Eval(c.n); got != c.want {
+			t.Errorf("Compile(%q).Eval(%d) = %d, C gives %d", c.expr, c.n, got, c.want)
+		}
+	}
+}
+
+// gotext/6: MarshalText writes non-ASCII text intact.
+func TestHegelPinMarshalTextKeepsNonASCII(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"na\u00efve\"\nmsgstr \"\u00f1 \u65e5\u672c \U0001f389\"\n")
+	text, err := p.MarshalText()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !utf8.Valid(text) {
+		t.Errorf("MarshalText output is not valid UTF-8: %q", text)
+	}
+	if !strings.Contains(string(text), "\u00f1 \u65e5\u672c \U0001f389") {
+		t.Errorf("MarshalText output lacks the translation: %q", text)
+	}
+	p2 := parsePO(string(text))
+	if got := p2.Get("na\u00efve"); got != "\u00f1 \u65e5\u672c \U0001f389" {
+		t.Errorf("after MarshalText, Get(na\u00efve) = %q", got)
+	}
+}
+
+// gotext/7: MarshalText escapes a backslash before a quote.
+func TestHegelPinMarshalTextEscapesBackslashBeforeQuote(t *testing.T) {
+	p := parsePO(frenchHeader + "\nmsgid \"k\"\nmsgstr \"a\\\\\\\"b\"\n")
+	if got := p.Get("k"); got != "a\\\"b" {
+		t.Fatalf("the PO parser reads the translation as %q", got)
+	}
+	text, err := p.MarshalText()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p2 := parsePO(string(text))
+	if got := p2.Get("k"); got != "a\\\"b" {
+		t.Errorf("after MarshalText, Get(k) = %q, expected %q (written as %s)", got, "a\\\"b", text)
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..858540b
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,619 @@
+package gotext_test
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/leonelquinteros/gotext"
+	"github.com/leonelquinteros/gotext/plurals"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plural-form expressions.
+
+// TestHegelExpressionsEvaluateAsC: plurals.Compile(expr).Eval(n) is
+// the value of the C expression (Python's gettext.c2py) for every n.
+func TestHegelExpressionsEvaluateAsC(t *testing.T) {
+	if !havePython {
+		t.Skip("python3 with gettext is the oracle")
+	}
+	property(t, func(ht *hegel.T) {
+		g := &pgen{tc: ht, bare: !Known.bareTests}
+		var exprs []string
+		for k := n(ht, 1, 6); k > 0; k-- {
+			switch n(ht, 1, 6) {
+			case 1:
+				exprs = append(exprs, pick(ht, realPluralForms...).plural)
+			case 2, 3:
+				exprs = append(exprs, g.renderTestOnly(g.test(n(ht, 0, 2))))
+			default:
+				e := g.expr(n(ht, 1, 3), n(ht, 2, 6))
+				if e.isConst {
+					e = &pexpr{test: g.test(1), a: &pexpr{isConst: true, c: 0}, b: &pexpr{isConst: true, c: 1}}
+				}
+				exprs = append(exprs, g.renderExpr(e))
+			}
+		}
+		ns := sampleNs(ht)
+		note(ht, "expressions: %q", exprs)
+		want := pyPlural(ht, exprs, ns)
+		for i, expr := range exprs {
+			vals, ok := want[i].([]any)
+			if !ok {
+				fail(ht, "GENERATOR: Python rejects %q: %v", expr, want[i])
+			}
+			compiled, err := plurals.Compile(expr)
+			if err != nil {
+				fail(ht, "plurals.Compile(%q) fails: %v (C evaluates it)", expr, err)
+			}
+			for j, nv := range ns {
+				got := compiled.Eval(uint32(nv))
+				if float64(got) != vals[j].(float64) {
+					fail(ht, "Compile(%q).Eval(%d) = %d, C gives %v", expr, nv, got, vals[j])
+				}
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Catalogs against msgfmt and GNUTranslations.
+
+type parsed struct {
+	name string
+	tr   gotext.Translator
+	intr gotext.IsTranslatedIntrospector
+}
+
+// TestHegelCatalogsAgreeWithGettext: a generated PO file compiled by msgfmt;
+// gotext's Po and Mo parsers answer Get/GetC/GetN/GetNC and IsTranslated*
+// as GNU gettext (Python's GNUTranslations on the MO) does, and agree with
+// each other; the headers read back.
+func TestHegelCatalogsAgreeWithGettext(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := genCatalog(ht, !Known.fuzzyUsed)
+		po := spellPO(ht, c)
+		note(ht, "po:\n%s", po)
+		var extra []string
+		if chance(ht, 30) {
+			extra = append(extra, "--no-hash")
+		}
+		if chance(ht, 30) {
+			extra = append(extra, "--endianness=big")
+		}
+		mo, msgs, err := msgfmt(dir, po, extra...)
+		if err != nil {
+			fail(ht, "GENERATOR: msgfmt rejects the generated PO: %v\n%s\npo:\n%s", err, msgs, po)
+		}
+		ns := []int{0, 1, 2, 3, 5, 11, 21, 100, 101, n(ht, 0, 1000)}
+		var qs []query
+		for _, e := range c.entries {
+			qs = append(qs, query{Kind: "get", ID: e.id}, query{Kind: "getc", Ctx: e.ctx, ID: e.id})
+			if e.hasCtx {
+				qs = append(qs, query{Kind: "getc", Ctx: "other", ID: e.id})
+			} else if chance(ht, 50) {
+				qs = append(qs, query{Kind: "getc", Ctx: "menu", ID: e.id})
+			}
+			pl := e.plural
+			if !e.hasPlural {
+				pl = e.id + "s"
+			}
+			for _, nv := range ns {
+				qs = append(qs, query{Kind: "getn", ID: e.id, Plural: pl, N: nv}, query{Kind: "getnc", Ctx: e.ctx, ID: e.id, Plural: pl, N: nv})
+			}
+		}
+		missing := "missing " + strconv.Itoa(n(ht, 0, 99))
+		qs = append(qs, query{Kind: "get", ID: missing}, query{Kind: "getc", Ctx: "menu", ID: missing})
+		for _, nv := range ns {
+			qs = append(qs, query{Kind: "getn", ID: missing, Plural: missing + "s", N: nv}, query{Kind: "getnc", Ctx: "menu", ID: missing, Plural: missing + "s", N: nv})
+		}
+		res := pyLookup(ht, dir, mo, qs, ns)
+
+		poObj := gotext.NewPo()
+		poObj.Parse([]byte(po))
+		moObj := gotext.NewMo()
+		moObj.Parse(mo)
+		sides := []parsed{{"Po", poObj, poObj}, {"Mo", moObj, moObj}}
+
+		byKey := map[string]entry{}
+		for _, e := range c.entries {
+			byKey[c.key(e)] = e
+		}
+		ask := func(p parsed, q query) string {
+			switch q.Kind {
+			case "get":
+				return p.tr.Get(q.ID)
+			case "getc":
+				return p.tr.GetC(q.ID, q.Ctx)
+			case "getn":
+				return p.tr.GetN(q.ID, q.Plural, q.N)
+			default:
+				return p.tr.GetNC(q.ID, q.Plural, q.N, q.Ctx)
+			}
+		}
+		for i, q := range qs {
+			want := res.Answers[i]
+			e, present := byKey[q.Ctx+"\x04"+q.ID]
+			answers := map[string]string{}
+			for _, p := range sides {
+				got := ask(p, q)
+				answers[p.name] = got
+				if got == want {
+					continue
+				}
+				fallback := q.ID
+				if (q.Kind == "getn" || q.Kind == "getnc") && q.N != 1 {
+					fallback = q.Plural
+				}
+				// An empty translated form: GNU returns the empty string,
+				// gotext the untranslated text (Translation.GetN's rule: the
+				// msgid or the entry's own msgid_plural, not the caller's).
+				if want == "" && (got == q.ID || got == q.Plural || (present && got == e.plural)) {
+					continue
+				}
+				// A fuzzy entry is not in the MO; the PO parser uses it
+				// while gotext/1 is open.
+				if present && e.fuzzy && Known.fuzzyUsed && p.name == "Po" {
+					continue
+				}
+				// A plural entry whose msgstr[0] is empty is untranslated to
+				// msgfmt (left out of the MO); gotext's PO parser keeps the
+				// other forms and uses them (a documented difference).
+				if present && e.hasPlural && e.forms[0] == "" && p.name == "Po" {
+					continue
+				}
+				// GNU picks the untranslated form with n == 1; gotext's
+				// GetN with the catalog's rule (gotext/2).
+				if Known.pluralFallback && (q.Kind == "getn" || q.Kind == "getnc") && (want == q.ID || want == q.Plural) && (got == q.ID || got == q.Plural) {
+					continue
+				}
+				// A singular entry looked up with a plural n (gotext/3).
+				if Known.singularPluralEmpty && (q.Kind == "getn" || q.Kind == "getnc") && present && !e.hasPlural && got == "" {
+					continue
+				}
+				// A singular entry looked up as a plural: C libintl answers
+				// its translation for an out-of-range form index (Python
+				// falls back to the msgid); gotext's answer for form 0.
+				if (q.Kind == "getn" || q.Kind == "getnc") && present && !e.hasPlural && got == e.forms[0] && got != "" {
+					continue
+				}
+				// A plural entry looked up without n: GNU's MO key is
+				// "msgid\x00msgid_plural", so gettext(msgid) misses; gotext
+				// answers the first form (its documented Get on the entry).
+				if (q.Kind == "get" || q.Kind == "getc") && present && e.hasPlural && got == e.forms[0] && got != "" {
+					continue
+				}
+				fail(ht, "%s: %s%s = %q, GNU gettext gives %q (untranslated fallback %q)\npo:\n%s", p.name, q.Kind, describeQuery(q), got, want, fallback, po)
+			}
+			if answers["Po"] != answers["Mo"] {
+				if present && e.fuzzy && Known.fuzzyUsed {
+					continue
+				}
+				if Known.pluralFallback && (q.Kind == "getn" || q.Kind == "getnc") {
+					continue
+				}
+				if Known.singularPluralEmpty && (q.Kind == "getn" || q.Kind == "getnc") && present && !e.hasPlural {
+					continue
+				}
+				if present && e.hasPlural && e.forms[0] == "" {
+					continue
+				}
+				fail(ht, "Po and Mo disagree on %s%s: %q vs %q\npo:\n%s", q.Kind, describeQuery(q), answers["Po"], answers["Mo"], po)
+			}
+		}
+		// IsTranslated*.
+		for _, e := range c.entries {
+			for _, p := range sides {
+				inMO := !e.fuzzy && e.forms[0] != "" // msgfmt leaves fuzzy and untranslated entries out
+				usable := inMO || p.name == "Po"
+				if e.fuzzy && Known.fuzzyUsed {
+					continue
+				}
+				if !e.hasPlural {
+					want := usable && e.forms[0] != ""
+					got := p.intr.IsTranslated(e.id)
+					if e.hasCtx {
+						got = p.intr.IsTranslatedC(e.id, e.ctx)
+					}
+					if got != want && !(Known.isTranslatedIndex && res.Idx["1"] != 0) {
+						fail(ht, "%s: IsTranslated(C)(%q, ctx %q) = %v, expected %v (msgstr %q)\npo:\n%s", p.name, e.id, e.ctx, got, want, e.forms[0], po)
+					}
+					continue
+				}
+				for _, nv := range ns {
+					idx := res.Idx[strconv.Itoa(nv)]
+					want := usable && idx < len(e.forms) && e.forms[idx] != ""
+					var got bool
+					if e.hasCtx {
+						got = p.intr.IsTranslatedNC(e.id, nv, e.ctx)
+					} else {
+						got = p.intr.IsTranslatedN(e.id, nv)
+					}
+					if got != want {
+						fail(ht, "%s: IsTranslatedN(C)(%q, %d, ctx %q) = %v, expected %v (form %d = %q)\npo:\n%s", p.name, e.id, nv, e.ctx, got, want, idx, e.forms[idx], po)
+					}
+				}
+			}
+		}
+		// Headers.
+		for _, p := range sides {
+			d := p.tr.GetDomain()
+			for _, h := range c.headers {
+				if got := d.Headers.Get(h[0]); got != h[1] {
+					fail(ht, "%s: header %q = %q, expected %q\npo:\n%s", p.name, h[0], got, h[1], po)
+				}
+				if h[0] == "Language" && d.Language != h[1] {
+					fail(ht, "%s: Language = %q, expected %q", p.name, d.Language, h[1])
+				}
+				if h[0] == "Plural-Forms" && d.PluralForms != h[1] {
+					fail(ht, "%s: PluralForms = %q, expected %q", p.name, d.PluralForms, h[1])
+				}
+			}
+		}
+	})
+}
+
+func describeQuery(q query) string {
+	switch q.Kind {
+	case "get":
+		return fmt.Sprintf("(%q)", q.ID)
+	case "getc":
+		return fmt.Sprintf("(%q, ctx %q)", q.ID, q.Ctx)
+	case "getn":
+		return fmt.Sprintf("(%q, %q, %d)", q.ID, q.Plural, q.N)
+	default:
+		return fmt.Sprintf("(%q, %q, %d, ctx %q)", q.ID, q.Plural, q.N, q.Ctx)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Round trips.
+
+// TestHegelMarshalTextRoundTrips: a parsed PO written with MarshalText is a
+// PO file msgfmt accepts, and parses back to the same domain (headers,
+// translations, contexts, references).
+func TestHegelMarshalTextRoundTrips(t *testing.T) {
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := genCatalog(ht, false)
+		if Known.marshalNonASCII {
+			asciiOnly(c)
+		}
+		if Known.marshalBackslash {
+			noBackslashQuote(c)
+		}
+		po := spellPO(ht, c)
+		note(ht, "po:\n%s", po)
+		p1 := gotext.NewPo()
+		p1.Parse([]byte(po))
+		text, err := p1.MarshalText()
+		if err != nil {
+			fail(ht, "MarshalText: %v", err)
+		}
+		note(ht, "marshalled:\n%s", text)
+		p2 := gotext.NewPo()
+		p2.Parse(text)
+		d1, d2 := describeDomain(p1.GetDomain(), true), describeDomain(p2.GetDomain(), true)
+		if d1 != d2 {
+			fail(ht, "MarshalText output parses differently: %s\nmarshalled:\n%s\npo:\n%s", firstDiff(d1, d2), text, po)
+		}
+		if haveMsgfmt {
+			if _, msgs, err := msgfmt(dir, string(text)); err != nil {
+				fail(ht, "msgfmt rejects MarshalText output: %v\n%s\nmarshalled:\n%s", err, msgs, text)
+			}
+		}
+		// Idempotent.
+		text2, _ := p2.MarshalText()
+		if string(text2) != string(text) {
+			fail(ht, "MarshalText is not idempotent:\nfirst:\n%s\nsecond:\n%s", text, text2)
+		}
+	})
+}
