+// --------------------------------------------------------------------------- gob
+
+var gobNs = []int{0, 1, 2, 5, 21, 101}
+
+// gobRun is a case with its PO text and the first difference the gob round trip made.
+type gobRun struct {
+	marshalCase
+	po   string
+	diff string
+}
+
+func (r gobRun) GoString() string { return r.marshalCase.GoString() }
+
+// gobExpected: "gob" the domain survives MarshalBinary/UnmarshalBinary; "getn <e> n<n>" every
+// plural lookup answers the same after; "locale language" and "locale domain" a Locale
+// holding it round-trips; "getd <e>" and "getdc <e>" its lookups answer the same.
+func gobExpected(r gobRun, k known) checks {
+	out := checks{}
+	out.set("gob", "same")
+	for ei := range r.cat.entries {
+		for _, n := range gobNs {
+			out.set(fmt.Sprintf("getn %02d n%d", ei, n), "same")
+		}
+		out.set(fmt.Sprintf("getd %02d", ei), "same")
+		if r.cat.entries[ei].hasCtx {
+			out.set(fmt.Sprintf("getdc %02d", ei), "same")
+		}
+	}
+	out.set("locale language", "xx_XX")
+	out.set("locale domain", "default")
+	return out
+}
+
+func sameOr(a, b string) string {
+	if a == b {
+		return "same"
+	}
+	return fmt.Sprintf("differ: %q became %q", a, b)
+}
+
+func gobActual(r *gobRun) checks {
+	out := checks{}
+	p1 := gotext.NewPo()
+	p1.Parse([]byte(r.po))
+	data, err := p1.MarshalBinary()
+	if err != nil {
+		out.set("gob", "MarshalBinary: "+err.Error())
+		return out
+	}
+	p2 := gotext.NewPo()
+	if err := p2.UnmarshalBinary(data); err != nil {
+		out.set("gob", "UnmarshalBinary: "+err.Error())
+		return out
+	}
+	d1, d2 := describeDomain(p1.GetDomain(), true), describeDomain(p2.GetDomain(), true)
+	if d1 == d2 {
+		out.set("gob", "same")
+	} else {
+		out.set("gob", "differ")
+		r.diff = firstDiff(d1, d2)
+	}
+	for ei, e := range r.cat.entries {
+		for _, n := range gobNs {
+			out.set(fmt.Sprintf("getn %02d n%d", ei, n), sameOr(p1.GetN(e.id, e.plural, n), p2.GetN(e.id, e.plural, n)))
+		}
+	}
+	l1 := gotext.NewLocale("/nowhere", "xx_XX")
+	l1.AddTranslator("default", p1)
+	mo := gotext.NewMo()
+	mo.Parse([]byte(r.po)) // not an MO: stays empty
+	l1.AddTranslator("extra", mo)
+	ldata, err := l1.MarshalBinary()
+	if err != nil {
+		out.set("locale language", "MarshalBinary: "+err.Error())
+		return out
+	}
+	l2 := &gotext.Locale{}
+	if err := l2.UnmarshalBinary(ldata); err != nil {
+		out.set("locale language", "UnmarshalBinary: "+err.Error())
+		return out
+	}
+	out.set("locale language", l2.GetLanguage())
+	out.set("locale domain", l2.GetDomain())
+	for ei, e := range r.cat.entries {
+		out.set(fmt.Sprintf("getd %02d", ei), sameOr(l1.GetD("default", e.id), l2.GetD("default", e.id)))
+		if e.hasCtx {
+			out.set(fmt.Sprintf("getdc %02d", ei), sameOr(l1.GetDC("default", e.id, e.ctx), l2.GetDC("default", e.id, e.ctx)))
+		}
+	}
+	return out
+}
+
+func (r gobRun) explain(got, want checks) string {
+	if r.diff != "" {
+		return "\ngob round trip changes the domain at " + r.diff
+	}
+	return ""
+}
+
+// TestHegelBinaryRoundTrips: MarshalBinary/UnmarshalBinary preserve a domain (Po and Mo)
+// and a Locale with several domains.
+func TestHegelBinaryRoundTrips(t *testing.T) {
+	judged(t, plainCases, func(j *hzCaseJudge, c marshalCase) {
+		r := gobRun{marshalCase: c, po: spellPO(c.cat, c.spell)}
+		judgeBy(j, &r, gobExpected, gobActual)
+	})
+}
