+// TestHegelMsgunfmtAgreesWithMo: msgunfmt's PO of an MO file parses to the
+// same domain as gotext's Mo parser reads from the MO.
+func TestHegelMsgunfmtAgreesWithMo(t *testing.T) {
+	if !haveMsgfmt || !haveMsgunfmt {
+		t.Skip("msgfmt and msgunfmt are the oracles")
+	}
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := genCatalog(ht, true)
+		po := spellPO(ht, c)
+		note(ht, "po:\n%s", po)
+		mo, msgs, err := msgfmt(dir, po)
+		if err != nil {
+			fail(ht, "GENERATOR: msgfmt rejects the generated PO: %v\n%s\npo:\n%s", err, msgs, po)
+		}
+		un, err := msgunfmt(dir, mo)
+		if err != nil {
+			fail(ht, "msgunfmt: %v\n%s", err, un)
+		}
+		if strings.TrimSpace(un) == "" {
+			return // msgunfmt prints nothing for a catalog with only a header
+		}
+		m := gotext.NewMo()
+		m.Parse(mo)
+		p := gotext.NewPo()
+		p.Parse([]byte(un))
+		dm, dp := describeDomain(m.GetDomain(), false), describeDomain(p.GetDomain(), false)
+		if dm != dp {
+			fail(ht, "Mo parse and msgunfmt's PO differ: %s\nmsgunfmt:\n%s\npo:\n%s", firstDiff(dm, dp), un, po)
+		}
+	})
+}
+
+// TestHegelBinaryRoundTrips: MarshalBinary/UnmarshalBinary preserve a
+// domain (Po and Mo) and a Locale with several domains.
+func TestHegelBinaryRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genCatalog(ht, true)
+		po := spellPO(ht, c)
+		note(ht, "po:\n%s", po)
+		p1 := gotext.NewPo()
+		p1.Parse([]byte(po))
+		data, err := p1.MarshalBinary()
+		if err != nil {
+			fail(ht, "MarshalBinary: %v", err)
+		}
+		p2 := gotext.NewPo()
+		if err := p2.UnmarshalBinary(data); err != nil {
+			fail(ht, "UnmarshalBinary: %v", err)
+		}
+		d1, d2 := describeDomain(p1.GetDomain(), true), describeDomain(p2.GetDomain(), true)
+		if d1 != d2 {
+			fail(ht, "gob round trip changes the domain: %s\npo:\n%s", firstDiff(d1, d2), po)
+		}
+		// The plural rule survives too.
+		for _, nv := range []int{0, 1, 2, 5, 21, 101} {
+			for _, e := range c.entries {
+				if a, b := p1.GetN(e.id, e.plural, nv), p2.GetN(e.id, e.plural, nv); a != b {
+					fail(ht, "after the gob round trip GetN(%q, %q, %d) = %q, was %q", e.id, e.plural, nv, b, a)
+				}
+			}
+		}
+		// A Locale holding it under two domain names.
+		l1 := gotext.NewLocale("/nowhere", "xx_XX")
+		l1.AddTranslator("default", p1)
+		mo := gotext.NewMo()
+		mo.Parse([]byte(po)) // not an MO: stays empty
+		l1.AddTranslator("extra", mo)
+		ldata, err := l1.MarshalBinary()
+		if err != nil {
+			fail(ht, "Locale.MarshalBinary: %v", err)
+		}
+		l2 := &gotext.Locale{}
+		if err := l2.UnmarshalBinary(ldata); err != nil {
+			fail(ht, "Locale.UnmarshalBinary: %v", err)
+		}
+		if l2.GetLanguage() != "xx_XX" || l2.GetDomain() != "default" {
+			fail(ht, "Locale round trip: language %q domain %q", l2.GetLanguage(), l2.GetDomain())
+		}
+		for _, e := range c.entries {
+			if a, b := l1.GetD("default", e.id), l2.GetD("default", e.id); a != b {
+				fail(ht, "after the Locale gob round trip GetD(%q) = %q, was %q", e.id, b, a)
+			}
+			if e.hasCtx {
+				if a, b := l1.GetDC("default", e.id, e.ctx), l2.GetDC("default", e.id, e.ctx); a != b {
+					fail(ht, "after the Locale gob round trip GetDC(%q, %q) = %q, was %q", e.id, e.ctx, b, a)
+				}
+			}
+		}
+	})
+}
