+// --------------------------------------------------------------------------- msgunfmt
+
+// plainCases are catalogs with fuzzy entries and their spellings (the msgunfmt, gob and
+// broken-input properties).
+var plainCases = marshalCasesOver(plainCatalogs)
+
+// unfmtRun is a case with its PO text and what msgunfmt and the parsers gave.
+type unfmtRun struct {
+	marshalCase
+	po     string
+	un     string
+	dm, dp string
+}
+
+func (r unfmtRun) GoString() string { return r.marshalCase.GoString() }
+
+// compiled is whether msgfmt compiles an entry into the MO.
+func compiled(e entry) bool { return !e.fuzzy && e.forms[0] != "" }
+
+// unfmtExpected: "msgfmt" accepts the PO; "mo" the Mo parser's domain is the catalog's
+// compiled entries; "msgunfmt" decompiles it ("blank" with no entry: msgunfmt prints nothing
+// for a catalog with only a header); "same" the msgunfmt PO parses to the Mo parser's domain.
+func unfmtExpected(r unfmtRun, k known) checks {
+	out := checks{}
+	out.set("msgfmt", "accepts")
+	out.set("mo", describeCatalog(r.cat, hzKnownNone, true)[0])
+	any := false
+	for _, e := range r.cat.entries {
+		any = any || compiled(e)
+	}
+	if !any {
+		out.set("msgunfmt", "blank")
+		return out
+	}
+	out.set("msgunfmt", "ok")
+	out.set("same", "same")
+	return out
+}
+
+func unfmtActual(r *unfmtRun, dir string) checks {
+	out := checks{}
+	mo, _, err := msgfmt(dir, r.po)
+	if err != nil {
+		out.set("msgfmt", "rejects")
+		return out
+	}
+	out.set("msgfmt", "accepts")
+	m := gotext.NewMo()
+	m.Parse(mo)
+	r.dm = describeDomain(m.GetDomain(), false)
+	out.set("mo", r.dm)
+	un, err := msgunfmt(dir, mo)
+	r.un = un
+	if err != nil {
+		out.set("msgunfmt", "error: "+err.Error())
+		return out
+	}
+	if strings.TrimSpace(un) == "" {
+		out.set("msgunfmt", "blank")
+		return out
+	}
+	out.set("msgunfmt", "ok")
+	p := gotext.NewPo()
+	p.Parse([]byte(un))
+	r.dp = describeDomain(p.GetDomain(), false)
+	if r.dm == r.dp {
+		out.set("same", "same")
+	} else {
+		out.set("same", "differ")
+	}
+	return out
+}
+
+func (r unfmtRun) explain(got, want checks) string {
+	var parts []string
+	if g, ok := got["mo"]; ok && !agreeValue("mo", g, want["mo"]) {
+		parts = append(parts, "Mo parse differs from the model at "+firstDiff(r.dm, hzMembers(want["mo"])[0]))
+	}
+	if g, ok := got["same"]; ok && g != want["same"] {
+		parts = append(parts, "Mo parse and msgunfmt's PO differ at "+firstDiff(r.dm, r.dp))
+	}
+	return "\nmsgunfmt:\n" + r.un + "\n" + strings.Join(parts, "\n")
+}
+
+// TestHegelMsgunfmtAgreesWithMo: the Mo parser reads the catalog's compiled entries from the
+// MO, and msgunfmt's PO of the MO parses to the same domain.
+func TestHegelMsgunfmtAgreesWithMo(t *testing.T) {
+	if !haveMsgfmt || !haveMsgunfmt {
+		t.Skip("msgfmt and msgunfmt are the oracles")
+	}
+	dir := t.TempDir()
+	judged(t, plainCases, func(j *hzCaseJudge, c marshalCase) {
+		r := unfmtRun{marshalCase: c, po: spellPO(c.cat, c.spell)}
+		judgeBy(j, &r, unfmtExpected, func(r *unfmtRun) checks { return unfmtActual(r, dir) })
+	})
+}
