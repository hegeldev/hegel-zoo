+// --------------------------------------------------------------------------- broken inputs
+
+// mutation is one edit of a byte string: delete a span, set a byte, duplicate a span, insert
+// a token, flip a bit; at a position taken modulo the length.
+type mutation struct {
+	kind  string
+	at    int
+	span  int
+	b     int
+	token string
+	bit   int
+}
+
+var mutationGen = hegel.Composite(func(tc hegel.TestCase) mutation {
+	return mutation{
+		kind:  hegel.Draw(tc, evenHalves("delete", "set", "dup", "insert", "flip")),
+		at:    hegel.Draw(tc, hegel.Integers(0, 1<<20-1)),
+		span:  hegel.Draw(tc, hegel.Integers(0, 40)),
+		b:     hegel.Draw(tc, hegel.Integers(0, 255)),
+		token: hegel.Draw(tc, evenHalves("msgid", "\"", "\\", "msgstr[", "[9]", "\n", "%", "msgctxt", "\x00", "\x04", "(", "?", ":")),
+		bit:   hegel.Draw(tc, hegel.Integers(0, 7)),
+	}
+})
+
+// mutate applies the mutations in turn.
+func mutate(b []byte, muts []mutation) []byte {
+	b = append([]byte{}, b...)
+	for _, m := range muts {
+		if len(b) == 0 {
+			return b
+		}
+		i := m.at % len(b)
+		j := i + min(m.span, len(b)-i)
+		switch m.kind {
+		case "delete":
+			b = append(b[:i:i], b[j:]...)
+		case "set":
+			b[i] = byte(m.b)
+		case "dup":
+			b = append(b[:j:j], append([]byte{}, b[i:]...)...)
+		case "insert":
+			b = append(b[:i:i], append([]byte(m.token), b[i:]...)...)
+		default:
+			b[i] ^= 1 << uint(m.bit)
+		}
+	}
+	return b
+}
+
+// brokenCase is a catalog, which of its forms is mutated (the PO text, the MO msgfmt
+// compiles, or a plural expression of depth 3 over 4 forms with bare tests), one to four
+// mutations, and the values of n the lookups are made at.
+type brokenCase struct {
+	marshalCase
+	which string
+	muts  []mutation
+	ns    []int
+	expr  pluralExpr
+}
+
+func (c brokenCase) GoString() string {
+	return fmt.Sprintf("brokenCase{which:%s muts:%+v ns:%v expr:%q cat:%s}\npo:\n%s", c.which, c.muts, c.ns, c.expr.text, c.cat.GoString(), spellPO(c.cat, c.spell))
+}
+
+var brokenExprGen = hegel.FlatMap(brokenExpr[[2]int{3, 4}], func(e *pexpr) hegel.Generator[pluralExpr] {
+	return hegel.Map(spacingGen, func(sp spacing) pluralExpr {
+		p := pluralExpr{kind: "ternary", expr: e, sp: sp}
+		p.text = render(p)
+		return p
+	})
+})
+
+var brokenCases = hegel.Composite(func(tc hegel.TestCase) brokenCase {
+	return brokenCase{
+		marshalCase: hegel.Draw(tc, plainCases),
+		which:       hegel.Draw(tc, evenHalves("po", "mo", "expr")),
+		muts:        hegel.Draw(tc, countedHalves(mutationGen, 1, 4)),
+		ns:          hegel.Draw(tc, hzCounted(hegel.Integers(-3, 7), 4, 4)),
+		expr:        hegel.Draw(tc, brokenExprGen),
+	}
+})
+
+// brokenRun is a case with the mutated input and what the library panicked with.
+type brokenRun struct {
+	brokenCase
+	input  []byte
+	panics string
+}
+
+func (r brokenRun) GoString() string { return r.brokenCase.GoString() }
+
+// brokenExpected: "outcome" every call returns.
+func brokenExpected(r brokenRun, k known) checks {
+	return checks{"outcome": hzValue("ok")}
+}
+
+func brokenActual(r *brokenRun, dir string) checks {
+	out := checks{}
+	panicked := hzCall(func() {
+		switch r.which {
+		case "po":
+			p := gotext.NewPo()
+			p.Parse(r.input)
+			p.Get("x")
+			p.GetN("x", "y", r.ns[0])
+			p.GetC("x", "c")
+			p.GetNC("x", "y", r.ns[1], "c")
+			p.IsTranslatedN("x", r.ns[2])
+			if text, err := p.MarshalText(); err == nil {
+				gotext.NewPo().Parse(text)
+			}
+			if data, err := p.MarshalBinary(); err == nil {
+				gotext.NewPo().UnmarshalBinary(data)
+			}
+		case "mo":
+			m := gotext.NewMo()
+			m.Parse(r.input)
+			m.Get("x")
+			m.GetN("x", "y", r.ns[0])
+			m.GetNC("x", "y", r.ns[1], "c")
+			m.IsTranslatedNC("x", r.ns[2], "c")
+		default:
+			expr := string(r.input)
+			if e, err := plurals.Compile(expr); err == nil {
+				for _, nv := range []uint32{0, 1, 2, 7, 100, 4294967295} {
+					e.Eval(nv)
+				}
+			}
+			// The header form too.
+			p := gotext.NewPo()
+			p.Parse([]byte("msgid \"\"\nmsgstr \"\"\n\"Plural-Forms: nplurals=3; plural=" + strings.ReplaceAll(expr, "\n", " ") + ";\\n\"\n\nmsgid \"a\"\nmsgid_plural \"b\"\nmsgstr[0] \"A\"\nmsgstr[1] \"B\"\n"))
+			for _, nv := range []int{0, 1, 2, 7, 100, -1} {
+				p.GetN("a", "b", nv)
+			}
+		}
+	})
+	if panicked != nil {
+		r.panics = fmt.Sprint(panicked)
+	}
+	out.set("outcome", outcomeOf(panicked))
+	return out
+}
+
+func (r brokenRun) explain(got, want checks) string {
+	return fmt.Sprintf("\npanic: %s\ninput: %q", r.panics, r.input)
+}
+
+// TestHegelBrokenInputsNeverPanic: mutated PO text, MO bytes and plural expressions never
+// panic, and every lookup afterwards answers.
+func TestHegelBrokenInputsNeverPanic(t *testing.T) {
+	dir := t.TempDir()
+	judged(t, brokenCases, func(j *hzCaseJudge, c brokenCase) {
+		r := brokenRun{brokenCase: c}
+		po := []byte(spellPO(c.cat, c.spell))
+		switch c.which {
+		case "po":
+			r.input = mutate(po, c.muts)
+		case "mo":
+			if !haveMsgfmt {
+				j.ht.Assume(false)
+			}
+			mo, msgs, err := msgfmt(dir, string(po))
+			if err != nil {
+				j.Fail("generator", "GENERATOR: msgfmt rejects the generated PO: %v\n%s\npo:\n%s", err, msgs, po)
+			}
+			r.input = mutate(mo, c.muts)
+		default:
+			r.input = mutate([]byte(c.expr.text), c.muts)
+		}
+		hzTally("broken " + c.which)
+		judgeBy(j, &r, brokenExpected, func(r *brokenRun) checks { return brokenActual(r, dir) })
+	})
+}
diff --git a/hegel_zoo_plurals_test.go b/hegel_zoo_plurals_test.go
new file mode 100644
index 0000000..3eb2d8d
--- /dev/null
+++ b/hegel_zoo_plurals_test.go
@@ -0,0 +1,497 @@
+package gotext_test
+
+// Plural-form expressions (the C grammar gettext uses): the records of a test and of an
+// expression, their generators per depth (the kong form: tables of generators over a bounded
+// depth, built by pure functions), the renderer over a drawn spacing, the two evaluators (C's
+// and gotext's, the replica of gotext/5) and the wide property judging plurals.Compile
+// against Python's gettext.c2py.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/leonelquinteros/gotext/plurals"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- records
+
+// ptest is a boolean test in a plural expression.
+type ptest struct {
+	kind    string // cmp, and, or, bare
+	op      string // for cmp: == != < > <= >=
+	mod     int    // for cmp/bare: 0 for `n`, else `n % mod`
+	val     int    // for cmp: the constant
+	flipped bool   // for cmp: `val op operand`
+	l, r    *ptest // for and/or
+	paren   bool   // spelled in parentheses
+}
+
+// pexpr is a plural expression: a constant or a ternary.
+type pexpr struct {
+	isConst bool
+	c       int
+	test    *ptest
+	a, b    *pexpr
+	paren   bool
+}
+
+// hasBare reports a bare test in the tree (the shape of gotext/5).
+func (t *ptest) hasBare() bool {
+	if t == nil {
+		return false
+	}
+	return t.kind == "bare" || t.l.hasBare() || t.r.hasBare()
+}
+
+func (e *pexpr) hasBare() bool {
+	if e == nil || e.isConst {
+		return false
+	}
+	return e.test.hasBare() || e.a.hasBare() || e.b.hasBare()
+}
+
+// --------------------------------------------------------------------------- generators
+
+// The operand of a test: `n` 50, else `n % k` for k of a small table.
+var operandGen = dieChoice(hzW(50, hegel.Just(0)), hzW(50, evenHalves(10, 100, 2, 3, 5, 7, 1000, 6, 11)))
+
+// The constant of a comparison: one of four ranges evenly (0..3, 0..25, a table around the
+// decades, 0..5000; the ranges by Integers as the first harness drew them).
+var cmpValGen = evenGens(hegel.Integers(0, 3), hegel.Integers(0, 25), evenHalves(10, 11, 12, 14, 19, 20, 99, 100, 101), hegel.Integers(0, 5000))
+
+var cmpOpGen = evenHalves("==", "!=", "<", ">", "<=", ">=")
+
+// cmpTest is a comparison: flipped 20, in parentheses 30.
+var cmpTest = hegel.Composite(func(tc hegel.TestCase) *ptest {
+	return &ptest{kind: "cmp", op: hegel.Draw(tc, cmpOpGen), mod: hegel.Draw(tc, operandGen), val: hegel.Draw(tc, cmpValGen), flipped: hegel.Draw(tc, dieCoin(20)), paren: hegel.Draw(tc, dieCoin(30))}
+})
+
+// bareTest is a bare `n` or `n % k` (a non-zero test in C), in parentheses 50.
+var bareTest = hegel.Composite(func(tc hegel.TestCase) *ptest {
+	return &ptest{kind: "bare", mod: hegel.Draw(tc, operandGen), paren: hegel.Draw(tc, dieCoin(50))}
+})
+
+// testGens are the tests of depth 0, 1 and 2 with a bare test at the weight bare against a
+// comparison at 85 (15 by default, the first harness's chance): a leaf at depth 0, at a
+// deeper depth a leaf 55 or an and/or of two tests of the depth below 45, in parentheses 40.
+func testGens(bare int) []hegel.Generator[*ptest] {
+	leaf := dieChoice(hzW(bare, bareTest), hzW(85, cmpTest))
+	gens := []hegel.Generator[*ptest]{leaf}
+	kind := evenHalves("and", "or")
+	parens := dieCoin(40)
+	for depth := 1; depth <= 2; depth++ {
+		below := gens[depth-1]
+		andOr := hegel.Composite(func(tc hegel.TestCase) *ptest {
+			return &ptest{kind: hegel.Draw(tc, kind), l: hegel.Draw(tc, below), r: hegel.Draw(tc, below), paren: hegel.Draw(tc, parens)}
+		})
+		gens = append(gens, dieChoice(hzW(55, leaf), hzW(45, andOr)))
+	}
+	return gens
+}
+
+// exprGens are the expressions by depth (0 to 3) and nplurals (2 to 6) over the tests: a
+// constant below nplurals at depth 0, else a constant 35 or a ternary 65 whose test is of a
+// drawn depth 0..2, in parentheses 20, whose true branch is a constant 70 or an expression
+// of the depth below (in parentheses half the time) and whose false branch is an expression
+// of the depth below.
+func exprGens(tests []hegel.Generator[*ptest]) map[[2]int]hegel.Generator[*pexpr] {
+	gens := map[[2]int]hegel.Generator[*pexpr]{}
+	testAt := hegel.FlatMap(rangeHalves(0, 2), func(d int) hegel.Generator[*ptest] { return tests[d] })
+	parens, aParens, aConst := dieCoin(20), dieCoin(50), dieCoin(70)
+	for np := 2; np <= 6; np++ {
+		constant := hegel.Map(rangeHalves(0, np-1), func(c int) *pexpr { return &pexpr{isConst: true, c: c} })
+		gens[[2]int{0, np}] = constant
+		for depth := 1; depth <= 3; depth++ {
+			below := gens[[2]int{depth - 1, np}]
+			ternary := hegel.Composite(func(tc hegel.TestCase) *pexpr {
+				e := &pexpr{test: hegel.Draw(tc, testAt), paren: hegel.Draw(tc, parens)}
+				if hegel.Draw(tc, aConst) {
+					e.a = hegel.Draw(tc, constant)
+				} else {
+					e.a = hegel.Draw(tc, below)
+					e.a.paren = e.a.paren || hegel.Draw(tc, aParens)
+				}
+				e.b = hegel.Draw(tc, below)
+				return e
+			})
+			gens[[2]int{depth, np}] = dieChoice(hzW(35, constant), hzW(65, ternary))
+		}
+	}
+	return gens
+}
+
+// The tables of the wide property (a bare test at 15, zero under HEGEL_NO_KNOWN=1) and of the
+// broken-input property (always 15).
+var (
+	wideTests  = testGens(hzUnless(hzNoKnown, 15))
+	wideExprs  = exprGens(wideTests)
+	brokenTest = testGens(15)
+	brokenExpr = exprGens(brokenTest)
+)
+
+// spacing is the whitespace around the tokens of a rendered expression: eight drawn
+// spacings ("" 1, " " 2, "  " 1) used in turn.
+type spacing struct{ seq []string }
+
+var spacingGen = hegel.Map(hzCounted(halvesOver([]int{1, 2, 1}, "", " ", "  "), 8, 8), func(s []string) spacing { return spacing{seq: s} })
+
+// pluralExpr is one expression of a case: a real Plural-Forms rule, a test alone (its value
+// in C is 0 or 1) or a ternary, rendered in its spacing (text, what the library compiles)
+// and, for the oracle, with every bare test spelled as its non-zero comparison (cText:
+// Python's gettext.c2py reads a bare operand as its value, "n || x" as "n or x" which is n,
+// "(n)" as n, where C and libintl's plural evaluator read a non-zero test; the normalised
+// spelling has no bare operand and Python's value of it is C's).
+type pluralExpr struct {
+	kind  string // real, test, ternary
+	real  string
+	test  *ptest
+	expr  *pexpr
+	sp    spacing
+	text  string
+	cText string
+}
+
+func (e pluralExpr) GoString() string { return fmt.Sprintf("%s %q", e.kind, e.text) }
+
+// normalisedTest is the test with every bare operand as its non-zero comparison.
+func normalisedTest(t *ptest) *ptest {
+	if t == nil {
+		return nil
+	}
+	n := *t
+	if t.kind == "bare" {
+		n.kind, n.op, n.val = "cmp", "!=", 0
+	}
+	n.l, n.r = normalisedTest(t.l), normalisedTest(t.r)
+	return &n
+}
+
+func normalisedExpr(e *pexpr) *pexpr {
+	if e == nil {
+		return nil
+	}
+	n := *e
+	n.test, n.a, n.b = normalisedTest(e.test), normalisedExpr(e.a), normalisedExpr(e.b)
+	return &n
+}
+
+// normalised is the expression for the oracle.
+func normalised(e pluralExpr) pluralExpr {
+	e.test, e.expr = normalisedTest(e.test), normalisedExpr(e.expr)
+	return e
+}
+
+// hasBare reports a bare test (the shape of gotext/5).
+func (e pluralExpr) hasBare() bool { return e.test.hasBare() || e.expr.hasBare() }
+
+// exprsOver are the expressions of a case over the tables: a real rule at the weight real
+// (1), a test alone of depth 0..2 2, a ternary of depth 1..3 and nplurals 2..6 3 (a drawn
+// constant replaced by `test ? 0 : 1`, the first harness's rule).
+func exprsOver(tests []hegel.Generator[*ptest], exprs map[[2]int]hegel.Generator[*pexpr], real int) hegel.Generator[pluralExpr] {
+	realRule := hegel.Map(anyRule, func(pf pluralForm) pluralExpr { return pluralExpr{kind: "real", real: pf.plural} })
+	testOnly := hegel.FlatMap(rangeHalves(0, 2), func(d int) hegel.Generator[pluralExpr] {
+		return hegel.Map(tests[d], func(t *ptest) pluralExpr { return pluralExpr{kind: "test", test: t} })
+	})
+	ternary := hegel.FlatMap(rangeHalves(1, 3), func(d int) hegel.Generator[pluralExpr] {
+		return hegel.FlatMap(rangeHalves(2, 6), func(np int) hegel.Generator[pluralExpr] {
+			return hegel.FlatMap(exprs[[2]int{d, np}], func(e *pexpr) hegel.Generator[pluralExpr] {
+				if !e.isConst {
+					return hegel.Just(pluralExpr{kind: "ternary", expr: e})
+				}
+				return hegel.Map(tests[1], func(t *ptest) pluralExpr {
+					return pluralExpr{kind: "ternary", expr: &pexpr{test: t, a: &pexpr{isConst: true, c: 0}, b: &pexpr{isConst: true, c: 1}}}
+				})
+			})
+		})
+	})
+	kinds := dieChoice(hzW(real, realRule), hzW(2, testOnly), hzW(3, ternary))
+	return hegel.FlatMap(kinds, func(e pluralExpr) hegel.Generator[pluralExpr] {
+		return hegel.Map(spacingGen, func(sp spacing) pluralExpr {
+			e.sp = sp
+			e.text = render(e)
+			e.cText = render(normalised(e))
+			return e
+		})
+	})
+}
+
+// --------------------------------------------------------------------------- rendering
+
+// render spells the expression in its spacing.
+func render(e pluralExpr) string {
+	cur := 0
+	switch e.kind {
+	case "real":
+		return e.real
+	case "test":
+		return renderTest(e.test, 1, e.sp, &cur)
+	}
+	return renderExpr(e.expr, e.sp, &cur)
+}
+
+func (s spacing) next(cur *int) string {
+	v := s.seq[*cur%len(s.seq)]
+	*cur++
+	return v
+}
+
+func renderOperand(mod int, sp spacing, cur *int) string {
+	if mod == 0 {
+		return "n"
+	}
+	return "n" + sp.next(cur) + "%" + sp.next(cur) + strconv.Itoa(mod)
+}
+
+// testPrec: or 1, and 2, cmp/bare 3.
+func testPrec(t *ptest) int {
+	switch t.kind {
+	case "or":
+		return 1
+	case "and":
+		return 2
+	}
+	return 3
+}
+
+func renderTest(t *ptest, minPrec int, sp spacing, cur *int) string {
+	var s string
+	switch t.kind {
+	case "bare":
+		s = renderOperand(t.mod, sp, cur)
+	case "cmp":
+		if t.flipped {
+			s = strconv.Itoa(t.val) + sp.next(cur) + t.op + sp.next(cur) + renderOperand(t.mod, sp, cur)
+		} else {
+			s = renderOperand(t.mod, sp, cur) + sp.next(cur) + t.op + sp.next(cur) + strconv.Itoa(t.val)
+		}
+	case "and":
+		s = renderTest(t.l, 2, sp, cur) + sp.next(cur) + "&&" + sp.next(cur) + renderTest(t.r, 3, sp, cur)
+	case "or":
+		s = renderTest(t.l, 1, sp, cur) + sp.next(cur) + "||" + sp.next(cur) + renderTest(t.r, 2, sp, cur)
+	}
+	if t.paren || testPrec(t) < minPrec {
+		return "(" + sp.next(cur) + s + sp.next(cur) + ")"
+	}
+	return s
+}
+
+func renderExpr(e *pexpr, sp spacing, cur *int) string {
+	var s string
+	if e.isConst {
+		s = strconv.Itoa(e.c)
+	} else {
+		a := renderExpr(e.a, sp, cur)
+		if !e.a.isConst && !e.a.paren {
+			a = "(" + a + ")"
+		}
+		s = renderTest(e.test, 1, sp, cur) + sp.next(cur) + "?" + sp.next(cur) + a + sp.next(cur) + ":" + sp.next(cur) + renderExpr(e.b, sp, cur)
+	}
+	if e.paren {
+		return "(" + sp.next(cur) + s + sp.next(cur) + ")"
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- evaluators
+
+// evalTest is the value of a test at n: C's (a bare operand is a non-zero test) or, under
+// gotextRule, gotext's (plurals/compiler.go: a bare `n` compiles to equal{1}, a bare `n % k`
+// to pipe{mod, equal{0}}; the shape of gotext/5).
+func evalTest(t *ptest, n uint64, gotextRule bool) bool {
+	v := n
+	if t.mod != 0 {
+		v = n % uint64(t.mod)
+	}
+	switch t.kind {
+	case "bare":
+		if gotextRule {
+			if t.mod != 0 {
+				return v == 0
+			}
+			return v == 1
+		}
+		return v != 0
+	case "and":
+		return evalTest(t.l, n, gotextRule) && evalTest(t.r, n, gotextRule)
+	case "or":
+		return evalTest(t.l, n, gotextRule) || evalTest(t.r, n, gotextRule)
+	}
+	a, b := v, uint64(t.val)
+	if t.flipped {
+		a, b = b, a
+	}
+	switch t.op {
+	case "==":
+		return a == b
+	case "!=":
+		return a != b
+	case "<":
+		return a < b
+	case ">":
+		return a > b
+	case "<=":
+		return a <= b
+	}
+	return a >= b
+}
+
+func evalExpr(e *pexpr, n uint64, gotextRule bool) int {
+	if e.isConst {
+		return e.c
+	}
+	if evalTest(e.test, n, gotextRule) {
+		return evalExpr(e.a, n, gotextRule)
+	}
+	return evalExpr(e.b, n, gotextRule)
+}
+
+// evalRendered is the value of a case's expression at n under either rule; a real rule has
+// no tree (its value is the oracle's).
+func evalRendered(e pluralExpr, n uint64, gotextRule bool) (int, bool) {
+	switch e.kind {
+	case "test":
+		if evalTest(e.test, n, gotextRule) {
+			return 1, true
+		}
+		return 0, true
+	case "ternary":
+		return evalExpr(e.expr, n, gotextRule), true
+	}
+	return 0, false
+}
+
+// --------------------------------------------------------------------------- the property
+
+// sampleNs are the values of n the expressions are compared at: 0..45, the decades and
+// hundreds around the rules' breakpoints, the extremes of uint32, and three drawn.
+var fixedNs = func() []int {
+	ns := []int{}
+	for i := 0; i <= 45; i++ {
+		ns = append(ns, i)
+	}
+	return append(ns, 99, 100, 101, 102, 105, 110, 111, 112, 119, 120, 121, 199, 200, 201, 211, 1000, 1001, 1011, 12345, 2147483647, 4294967295)
+}()
+
+// exprCase is a case of the expressions property: one to six expressions and three drawn
+// values of n.
+type exprCase struct {
+	exprs []pluralExpr
+	extra []int
+}
+
+func (c exprCase) GoString() string {
+	var parts []string
+	for _, e := range c.exprs {
+		parts = append(parts, e.GoString())
+	}
+	return fmt.Sprintf("exprCase{exprs:[%s] extra:%v}", strings.Join(parts, ", "), c.extra)
+}
+
+func (c exprCase) ns() []int { return append(append([]int{}, fixedNs...), c.extra...) }
+
+var exprCases = hegel.Composite(func(tc hegel.TestCase) exprCase {
+	return exprCase{exprs: hegel.Draw(tc, countedHalves(exprsOver(wideTests, wideExprs, 1), 1, 6)), extra: hegel.Draw(tc, hzCounted(hegel.Integers(0, 1000000), 3, 3))}
+})
+
+// exprRun is a case with the oracle's answers: Python's value of every expression (in its
+// normalised spelling) at every n (a string where Python rejects the expression, a generator
+// failure).
+type exprRun struct {
+	exprCase
+	python []any
+}
+
+func (r exprRun) GoString() string { return r.exprCase.GoString() }
+
+// exprExpected: every expression compiles ("compile i"), and its value at every n ("eval i
+// n=N") is Python's (of the normalised spelling: C's); under kBareTests the value of an
+// expression with a bare test is gotext's evaluator's where it differs from C's.
+func exprExpected(r exprRun, k known) checks {
+	out := checks{}
+	for i, e := range r.exprs {
+		vals, ok := r.python[i].([]any)
+		if !ok {
+			continue
+		}
+		out.set("compile "+strconv.Itoa(i), "ok")
+		for j, n := range r.ns() {
+			want := int(vals[j].(float64))
+			if k[kBareTests] {
+				if g, ok := evalRendered(e, uint64(n), true); ok {
+					if c, _ := evalRendered(e, uint64(n), false); c != g {
+						want = g
+					}
+				}
+			}
+			out.set(fmt.Sprintf("eval %d n=%d", i, n), want)
+		}
+	}
+	return out
+}
+
+func exprActual(r *exprRun) checks {
+	out := checks{}
+	for i, e := range r.exprs {
+		compiled, err := plurals.Compile(e.text)
+		if err != nil {
+			out.set("compile "+strconv.Itoa(i), "error: "+err.Error())
+			continue
+		}
+		out.set("compile "+strconv.Itoa(i), "ok")
+		for _, n := range r.ns() {
+			out.set(fmt.Sprintf("eval %d n=%d", i, n), compiled.Eval(uint32(n)))
+		}
+	}
+	return out
+}
+
+func (r exprRun) explain(got, want checks) string {
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			var i int
+			fmt.Sscanf(k, "%*s %d", &i)
+			if i < len(r.exprs) {
+				return fmt.Sprintf("\nexpression %d: %q", i, r.exprs[i].text)
+			}
+		}
+	}
+	return ""
+}
+
+// TestHegelExpressionsEvaluateAsC: plurals.Compile(expr).Eval(n) is the value of the C
+// expression (Python's gettext.c2py) for every n.
+func TestHegelExpressionsEvaluateAsC(t *testing.T) {
+	if !havePython {
+		t.Skip("python3 with gettext is the oracle")
+	}
+	judged(t, exprCases, func(j *hzCaseJudge, c exprCase) {
+		var texts []string
+		for _, e := range c.exprs {
+			texts = append(texts, e.cText)
+		}
+		r := exprRun{exprCase: c, python: pyPlural(j.ht, texts, c.ns())}
+		for i, p := range r.python {
+			vals, ok := p.([]any)
+			if !ok {
+				j.Fail("generator", "GENERATOR: Python rejects %q: %v", c.exprs[i].cText, p)
+			}
+			// The model's C evaluator against the oracle (a defect of the model, not of
+			// the library).
+			for jn, n := range c.ns() {
+				if v, ok := evalRendered(c.exprs[i], uint64(n), false); ok && v != int(vals[jn].(float64)) {
+					j.Fail("model", "MODEL: the C evaluator gives %d for %q at n=%d, Python %v", v, c.exprs[i].cText, n, vals[jn])
+				}
+			}
+		}
+		for _, e := range c.exprs {
+			if e.hasBare() {
+				hzTally("bare test drawn")
+				break
+			}
+		}
+		judgeBy(j, &r, exprExpected, exprActual)
+	})
+}
diff --git a/hegel_zoo_shapes_test.go b/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..fa14735
--- /dev/null
+++ b/hegel_zoo_shapes_test.go
@@ -0,0 +1,387 @@
+package gotext_test
+
+// One narrow property per recorded bug (bugs.toml), over the shape region of the bug by the
+// classifier (regionOf on the record for the MarshalText shapes, lookupJudged's region after
+// the oracle for the lookup shapes, the evaluators for the expressions): each fails every
+// run by default naming the bug, and under HEGEL_NO_KNOWN=1 draws the neighbouring region
+// past the shape (hzShaped) and passes. Where an earlier bug would be named first, the
+// generator or the check set is restricted to the bug's own.
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// restrictedTo is the model over the checks keep admits (a narrow property's check set).
+func restrictedTo(expected func(lookupRun, known) checks, keep func(string) bool) func(lookupRun, known) checks {
+	return func(r lookupRun, k known) checks {
+		out := checks{}
+		for name, v := range expected(r, k) {
+			if keep(name) {
+				out[name] = v
+			}
+		}
+		return out
+	}
+}
+
+// classIn is whether a check's class is one of the given.
+func classIn(classes ...string) func(string) bool {
+	return func(name string) bool {
+		for _, c := range classes {
+			if classOf(name) == c {
+				return true
+			}
+		}
+		return false
+	}
+}
+
+// arabic is the one rule of the twenty whose plural(1) is not 0 (plural(1) = 1): the shape of
+// gotext/4.
+func arabic(pf pluralForm) bool { return strings.HasPrefix(pf.plural, "n==0 ? 0 : n==1 ? 1") }
+
+// fallsBackByOne is a rule whose plural index is 0 exactly for n == 1, where the catalog's
+// rule and GNU's n == 1 pick the same untranslated form: the nine of the twenty (n != 1 in
+// four spellings, n==1 ? 0 : n==2 ? 1 : 2, the Romanian, Lithuanian-like, Czech and Welsh
+// rules); the other eleven have an index 0 for some n != 1 (0, n>1 at 0, the Slavic and
+// Baltic rules at 21 and 101, the Scottish at 11, the Arabic at 0 and 1) or not at 1 (the
+// Arabic), the shape of gotext/2 at the values the lookups are made at.
+func fallsBackByOne(pf pluralForm) bool {
+	switch pf.plural {
+	case "n != 1", "(n != 1)", "n == 1 ? 0 : 1", "(n==1) ? 0 : 1",
+		"n==1 ? 0 : n==2 ? 1 : 2",
+		"n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2",
+		"n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2",
+		"(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2",
+		"(n==1) ? 0 : (n==2) ? 1 : (n<7) ? 2 : (n<11) ? 3 : 4":
+		return true
+	}
+	return false
+}
+
+func notArabic(pf pluralForm) bool { return !arabic(pf) }
+
+// --------------------------------------------------------------------------- gotext/1
+
+// TestHegelFuzzyEntriesAreLeftOut: the shape region of gotext/1 - a catalog with fuzzy
+// entries (70 percent of one to seven, none under HEGEL_NO_KNOWN=1) under a rule other than
+// the Arabic (gotext/4 would be named on the same IsTranslated checks) - through the lookups
+// gotext/2 and gotext/3 do not touch: Get and GetC on both sides, their agreement,
+// IsTranslated(C) and IsTranslatedN(C), the headers. A fuzzy entry is not a translation:
+// msgfmt leaves it out of the MO and GNU gettext answers the msgid; gotext's PO parser
+// answers its translation.
+func TestHegelFuzzyEntriesAreLeftOut(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	expected := restrictedTo(lookupExpected, func(name string) bool {
+		if classIn("get", "getc", "istr", "istrn", "header", "language", "pluralforms")(name) {
+			return true
+		}
+		return false
+	})
+	cats := catalogsOver(plainTexts, hzShaped(70, 0), 45, 1, rulesWhere(notArabic), false)
+	lookupJudged(t, lookupCasesOver(cats), expected, "gotext/1")
+}
+
+// --------------------------------------------------------------------------- gotext/2
+
+// TestHegelUntranslatedPluralsFallBackByOne: the shape region of gotext/2 - a catalog under
+// one of the eleven rules whose plural index is 0 for some n != 1 or not for 1 (past the
+// shape under HEGEL_NO_KNOWN=1: the nine rules whose index is 0 exactly at 1), its entries
+// all plural there (a singular entry would be gotext/3) - through every lookup. GetN of a
+// missing msgid, and GetN and GetNC of an untranslated form, pick the untranslated text by
+// n == 1 as GNU ngettext and gotext's own GetNC of a missing msgid do, not by the catalog's
+// rule.
+func TestHegelUntranslatedPluralsFallBackByOne(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	rules := rulesWhere(func(pf pluralForm) bool { return fallsBackByOne(pf) == hzShaped(false, true) })
+	cats := catalogsOver(plainTexts, 0, hzShaped(45, 100), 0, rules, false)
+	lookupJudged(t, lookupCasesOver(cats), lookupExpected, "gotext/2")
+}
+
+// --------------------------------------------------------------------------- gotext/3
+
+// TestHegelSingularEntriesAnswerPluralLookups: the shape region of gotext/3 - a catalog of
+// one to seven entries, singular 70 percent (all plural under HEGEL_NO_KNOWN=1), under one
+// of the nine rules whose plural index is 0 exactly at 1 (gotext/2 would be named first
+// under the others) - through every lookup. GetN and GetNC of a singular entry answer its
+// translation (C libintl) or the untranslated text (GNU gettext's Python), never "".
+func TestHegelSingularEntriesAnswerPluralLookups(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	cats := catalogsOver(plainTexts, 0, hzShaped(30, 100), 1, rulesWhere(fallsBackByOne), false)
+	lookupJudged(t, lookupCasesOver(cats), lookupExpected, "gotext/3")
+}
+
+// --------------------------------------------------------------------------- gotext/4
+
+// TestHegelIsTranslatedIgnoresThePluralRule: the shape region of gotext/4 - a catalog of
+// one to seven entries, singular 70 percent, under the Arabic rule, the one of the twenty
+// whose plural(1) is not 0 (under HEGEL_NO_KNOWN=1 the other nineteen) - through the
+// IsTranslated checks alone (gotext/2 would be named on the plural lookups). IsTranslated
+// and IsTranslatedC of a singular entry with a translation are true whatever the rule says
+// of 1.
+func TestHegelIsTranslatedIgnoresThePluralRule(t *testing.T) {
+	if !haveMsgfmt || !havePython {
+		t.Skip("msgfmt and python3 are the oracles")
+	}
+	expected := restrictedTo(lookupExpected, classIn("istr", "istrn", "header", "language", "pluralforms"))
+	rules := rulesWhere(func(pf pluralForm) bool { return arabic(pf) == hzShaped(true, false) })
+	cats := catalogsOver(plainTexts, 0, hzShaped(30, 45), 1, rules, false)
+	lookupJudged(t, lookupCasesOver(cats), expected, "gotext/4")
+}
+
+// --------------------------------------------------------------------------- gotext/5
+
+// TestHegelBareTestsAreNonZeroTests: the shape region of gotext/5 - tests alone and
+// ternaries (no real rule) whose tests are bare `n` or `n % k` 80 against 85 (never under
+// HEGEL_NO_KNOWN=1), where the bare test decides a value - through the C evaluation. A bare
+// operand is a non-zero test in C (and in libintl), not n == 1 or n % k == 0.
+func TestHegelBareTestsAreNonZeroTests(t *testing.T) {
+	if !havePython {
+		t.Skip("python3 with gettext is the oracle")
+	}
+	tests := testGens(hzShaped(80, 0))
+	exprs := exprGens(tests)
+	cases := hegel.Composite(func(tc hegel.TestCase) exprCase {
+		return exprCase{exprs: hegel.Draw(tc, countedHalves(exprsOver(tests, exprs, 0), 1, 6)), extra: hegel.Draw(tc, hzCounted(hegel.Integers(0, 1000000), 3, 3))}
+	})
+	// The classifier needs the oracle's values only where the switch leaves them, so the
+	// region is by the evaluators: an expression whose value differs between the rules.
+	shaped := func(c exprCase) string {
+		for _, e := range c.exprs {
+			for _, n := range c.ns() {
+				if g, ok := evalRendered(e, uint64(n), true); ok {
+					if v, _ := evalRendered(e, uint64(n), false); v != g {
+						return "gotext/5"
+					}
+				}
+			}
+		}
+		return ""
+	}
+	region := hzOnly(true, "gotext/5", cases, func(c exprCase) bool {
+		got := shaped(c)
+		if got == hzShaped("gotext/5", "") {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered gotext/5 as " + got)
+		return false
+	})
+	judged(t, region, func(j *hzCaseJudge, c exprCase) {
+		var texts []string
+		for _, e := range c.exprs {
+			texts = append(texts, e.cText)
+		}
+		r := exprRun{exprCase: c, python: pyPlural(j.ht, texts, c.ns())}
+		for i, p := range r.python {
+			if _, ok := p.([]any); !ok {
+				j.Fail("generator", "GENERATOR: Python rejects %q: %v", c.exprs[i].cText, p)
+			}
+		}
+		judgeBy(j, &r, exprExpected, exprActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gotext/6
+
+// marshalShape is the MarshalText model over a case record alone (the classifier's view).
+func marshalShape(c marshalCase, k known) checks {
+	return marshalExpected(marshalRun{marshalCase: c}, k)
+}
+
+// TestHegelMarshalTextKeepsNonASCII: the shape region of gotext/6 - a catalog of one to
+// seven entries whose strings hold characters outside ASCII (the non-ASCII pool words, piece
+// atoms and context at four times their plain weight; none under HEGEL_NO_KNOWN=1) -
+// through the MarshalText round trip. The output holds every character whole, parses back to
+// the same domain, msgfmt accepts it and a second MarshalText is the same.
+func TestHegelMarshalTextKeepsNonASCII(t *testing.T) {
+	cats := catalogsOver(textsAt(hzShaped(4, 0)), 0, 45, 1, anyRule, false)
+	marshalJudged(t, regionOf("gotext/6", marshalShape, marshalCasesOver(cats)))
+}
+
+// --------------------------------------------------------------------------- gotext/7
+
+// splice is where the shape of gotext/7 goes: the entry (a drawn one; a catalog without
+// entries gets one of three msgids with an empty translation), the run of one to three
+// backslashes, the field among the entry's strings that hold more than newlines (the
+// context, msgid, msgid_plural and non-empty forms; a context is added when none does) and
+// the rune position inside it (spliceAt keeps the newline edges msgfmt checks). The shape
+// is the backslashes followed by a quote; past it, under HEGEL_NO_KNOWN=1, a quote followed
+// by the backslashes.
+type splice struct {
+	entry      int
+	backslash  int
+	field      int
+	at         int
+	fallbackID string
+}
+
+func (s splice) shape() string {
+	run := strings.Repeat(`\`, s.backslash)
+	return hzShaped(run+`"`, `"`+run)
+}
+
+// spliceable are the fields of the entry the shape may go in.
+func spliceable(e *entry) []*string {
+	var fields []*string
+	if e.hasCtx {
+		fields = append(fields, &e.ctx)
+	}
+	fields = append(fields, &e.id)
+	if e.hasPlural {
+		fields = append(fields, &e.plural)
+	}
+	for i := range e.forms {
+		fields = append(fields, &e.forms[i])
+	}
+	var out []*string
+	for _, f := range fields {
+		if strings.Trim(*f, "\n") != "" {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// spliceAt puts shape into s at a rune boundary between s's leading and trailing newlines.
+func spliceAt(s, shape string, at int) string {
+	lead := len(s) - len(strings.TrimLeft(s, "\n"))
+	trail := len(s) - len(strings.TrimRight(s, "\n"))
+	body := s[lead : len(s)-trail]
+	i := 0
+	for k := at % (utf8.RuneCountInString(body) + 1); k > 0; k-- {
+		_, size := utf8.DecodeRuneInString(body[i:])
+		i += size
+	}
+	return s[:lead] + body[:i] + shape + body[i:] + s[len(s)-trail:]
+}
+
+// spliced is the catalog with the shape in.
+func spliced(c catalog, s splice) catalog {
+	entries := make([]entry, len(c.entries))
+	for i, e := range c.entries {
+		entries[i] = e
+		entries[i].forms = append([]string{}, e.forms...)
+	}
+	if len(entries) == 0 {
+		entries = append(entries, entry{id: s.fallbackID, forms: []string{""}})
+	}
+	e := &entries[s.entry%len(entries)]
+	fields := spliceable(e)
+	if len(fields) == 0 {
+		e.hasCtx, e.ctx = true, s.shape()
+	} else {
+		f := fields[s.field%len(fields)]
+		*f = spliceAt(*f, s.shape(), s.at)
+	}
+	c.entries = entries
+	return c
+}
+
+// spliceGen is the splice for a catalog: the entry and the field evenly, the position
+// evenly over the longest field (taken modulo the field's length).
+func spliceGen(c catalog) hegel.Generator[splice] {
+	entries := max(len(c.entries), 1)
+	longest := 0
+	for _, e := range c.entries {
+		for _, s := range entryStrings(e) {
+			longest = max(longest, utf8.RuneCountInString(s))
+		}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) splice {
+		return splice{
+			entry:      hegel.Draw(tc, rangeHalves(0, entries-1)),
+			backslash:  hegel.Draw(tc, rangeHalves(1, 3)),
+			field:      hegel.Draw(tc, rangeHalves(0, 8)),
+			at:         hegel.Draw(tc, rangeHalves(0, longest)),
+			fallbackID: hegel.Draw(tc, evenHalves("apple", "file", "Save")),
+		}
+	})
+}
+
+// TestHegelMarshalTextRoundTripsBackslashBeforeQuote: the shape region of gotext/7 - a
+// catalog of ASCII strings (gotext/6 would be named first) one of whose strings (a context,
+// msgid, msgid_plural or translation) holds a run of backslashes followed by a quote -
+// through the round trip of TestHegelMarshalTextRoundTrips. Under HEGEL_NO_KNOWN=1 the run
+// of backslashes follows the quote instead.
+func TestHegelMarshalTextRoundTripsBackslashBeforeQuote(t *testing.T) {
+	cats := hegel.FlatMap(catalogsOver(asciiTexts, 0, 45, 0, anyRule, false), func(c catalog) hegel.Generator[catalog] {
+		return hegel.Map(spliceGen(c), func(s splice) catalog { return spliced(c, s) })
+	})
+	marshalJudged(t, regionOf("gotext/7", marshalShape, marshalCasesOver(cats)))
+}
+
+// --------------------------------------------------------------------------- gotext/8
+
+// leak is where the shape of gotext/8 goes: the entry (of the first to the last but one)
+// that keeps or gets `#:` references, the references it gets when it has none, and the
+// entry after it, which loses its own: an entry with references followed by one without. A
+// catalog left with one entry by distinct gets a second, of one of three msgids (the first
+// that is not the key already there) with an empty translation.
+type leak struct {
+	entry      int
+	refs       []string
+	fallbackID int
+}
+
+var fallbackIDs = []string{"apple", "file", "Save"}
+
+// leaked is the catalog with the shape in.
+func leaked(c catalog, l leak) catalog {
+	entries := append([]entry{}, c.entries...)
+	for len(entries) < 2 {
+		for j := range fallbackIDs {
+			e := entry{id: fallbackIDs[(l.fallbackID+j)%len(fallbackIDs)], forms: []string{""}}
+			if len(entries) == 0 || c.key(entries[0]) != c.key(e) {
+				entries = append(entries, e)
+				break
+			}
+		}
+	}
+	i := l.entry % (len(entries) - 1)
+	if len(entries[i].refs) == 0 {
+		entries[i].refs = l.refs
+	}
+	entries[i+1].refs = nil
+	c.entries = entries
+	return c
+}
+
+// leakGen is the leak for a catalog: the entry evenly, the references one to three.
+func leakGen(c catalog) hegel.Generator[leak] {
+	return hegel.Composite(func(tc hegel.TestCase) leak {
+		return leak{
+			entry:      hegel.Draw(tc, rangeHalves(0, max(len(c.entries)-2, 0))),
+			refs:       hegel.Draw(tc, refsList),
+			fallbackID: hegel.Draw(tc, rangeHalves(0, 2)),
+		}
+	})
+}
+
+// TestHegelReferencesStayWithTheirEntry: the shape region of gotext/8 - a catalog of two to
+// seven entries of ASCII strings (gotext/6 would be named first; a backslash before a quote
+// is left to gotext/7 by the classifier) in which an entry with `#:` references is followed
+// by one without - through the round trip of TestHegelMarshalTextRoundTrips: the parsed
+// domain holds every entry's own references and MarshalText writes them with their entry.
+// Under HEGEL_NO_KNOWN=1 the references of a catalog are all or none instead.
+func TestHegelReferencesStayWithTheirEntry(t *testing.T) {
+	cats := catalogsOver(asciiTexts, 0, 45, 2, anyRule, hzNoKnown)
+	if !hzNoKnown {
+		cats = hegel.FlatMap(cats, func(c catalog) hegel.Generator[catalog] {
+			return hegel.Map(leakGen(c), func(l leak) catalog { return leaked(c, l) })
+		})
+	}
+	marshalJudged(t, regionOf("gotext/8", marshalShape, marshalCasesOver(cats)))
+}
diff --git a/hegel_zoo_test.go b/hegel_zoo_test.go
new file mode 100644
index 0000000..e909988
--- /dev/null
+++ b/hegel_zoo_test.go
@@ -0,0 +1,1180 @@
+package gotext_test
+
+// Hegel properties for gotext (leonelquinteros/gotext), written for the Hegel zoo: plural-form
+// expressions against Python's gettext.c2py (the C semantics), PO/MO catalogs against GNU
+// msgfmt, msgunfmt and Python's GNUTranslations, and gotext's own round trips (MarshalText,
+// gob, Locale lookup on disk). See targets/go/gotext/README.md.
+//
+// Oracles on this machine: msgfmt/msgunfmt (gettext-tools) and python3; a property skips when
+// its oracle is missing. The oracle is asked once per case, before the library, and its
+// answers are part of the case the model reads.
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier), the oracle drivers (msgfmt,
+// msgunfmt, pyPlural, pyLookup) and the description of a domain (describeDomain, firstDiff);
+// hegel_zoo_catalogs_test.go the catalog record, its generators and the PO spelling;
+// hegel_zoo_plurals_test.go the plural-expression records, generators, renderers, the two
+// evaluators and the wide property on expressions; hegel_zoo_lookup_test.go the lookup model
+// (the oracle plus the documented differences, the switch set threaded) and the wide property
+// on catalogs; hegel_zoo_marshal_test.go the MarshalText model and property, the msgunfmt, gob
+// and broken-input properties; hegel_zoo_locale_test.go the Locale lookup on disk;
+// hegel_zoo_shapes_test.go one narrow property per recorded bug; hegel_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES, HEGEL_SEED
+// and HEGEL_VERBOSE are passed through hzOpts; a panic in the code under test is turned into
+// a failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has (the broken-input property catches the library's panics itself
+// into the check value "panic", judged like any other value; Recover is the net under
+// everything else). HEGEL_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record their
+// mismatches instead of failing and print the counts. The model states the documented
+// behaviour (every switch of the known value below off) and the properties judge the library
+// against it; the shape of a recorded bug is named by the classifier shapeBy, which runs the
+// model per switch on the case record, fails by default "(the shape of gotext/N)", and under
+// HEGEL_NO_KNOWN=1 the shapes are not drawn (a weight of zero: fuzzy entries, bare tests,
+// non-ASCII text in the MarshalText property), filtered out (hzOnly: a backslash before a
+// quote there) or the checks they cover are dropped from the case (judgeByDropping: the
+// plural fallback, the singular entries under a plural lookup, IsTranslated under a rule
+// whose plural(1) is not 0), and in the narrow properties the region past the shape is drawn
+// (hzShaped, regionOf), so that a run looks past the known bugs. The eighth switch, the
+// leak of `#:` references to the following entries (gotext/8), is drawn by the MarshalText
+// property at its natural rate and, under HEGEL_NO_KNOWN=1, not drawn (the references of a
+// catalog are then all or none).
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/leonelquinteros/gotext"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector), and asks for one failure per run for the shrink budget.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	if hzShrinkBudget > 0 {
+		// The shrink budget: one failure per run (the engine otherwise generates on while
+		// the cases fail, ten times the count on a property that always fails, and its
+		// re-run of the failures before shrinking would meet a rejected attempt and end the
+		// run as "flaky" with nothing printed).
+		opts = append(opts, hegel.WithReportMultipleFailures(false))
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize ... go/mergo judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+	fails  int  // failing judgements so far (the shrink budget)
+	budget int  // the failing judgements allowed, set at the first failure
+	armed  bool // past the budget: reject the next attempt before it draws
+	cycles int  // the attempts so rejected
+}
+
+// hzShrinkBudget bounds the shrinking of a failure: the engine (hegel-go v0.6.33 over
+// libhegel) keeps every attempt of a shrink in memory and has no budget for it (go/mergo
+// measured 1.6 GB and 65 s for a shrink of a case of 3000 draws in a module of its own, more
+// inside a test binary). A catalog case here is some hundreds to about 1500 draws (the probe
+// counts them) and every attempt of the catalog properties runs msgfmt and Python (about a
+// tenth of a second under load), so after a budget of failing judgements the next attempt is
+// rejected before its first draw (Assume: counted "budget skipped"), which ends the shrink:
+// the engine ends a shrink at an attempt rejected before it drew, then replays the last
+// failing attempt exactly for its report ("budget replayed", printed as usual). Were the
+// engine to shrink on past the undrawn rejection, the drawn attempt that fails arms the next
+// undrawn rejection, and after hzShrinkCycles such cycles every attempt is rejected undrawn
+// and the run ends without a message ("budget exhausted"). The budget is hzShrinkBudget
+// bytes of the first failure's message: the attempts allowed are the bytes over the
+// message's length, between 100 and 3000 (a catalog failure prints two to four KB: 100 to
+// 200 attempts, ten to twenty seconds with the oracles). HEGEL_SHRINK_BUDGET sets the
+// bytes, 0 for no budget. Collect mode records every failure and never shrinks.
+var hzShrinkBudget = func() int {
+	if s := os.Getenv("HEGEL_SHRINK_BUDGET"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v >= 0 {
+			return v
+		}
+	}
+	return 400000
+}()
+
+// hzShrinkCycles bounds the alternation past the budget.
+const hzShrinkCycles = 100
+
+// hzShrinkAttempts is the failing judgements the budget allows for a first failure of n
+// bytes.
+func hzShrinkAttempts(n int) int {
+	if n < 1 {
+		n = 1
+	}
+	b := hzShrinkBudget / n
+	if b < 100 {
+		return 100
+	}
+	if b > 3000 {
+		return 3000
+	}
+	return b
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// observe records a message of a class that is not a failure (a replica disagreement):
+// counted, and its first two messages kept.
+func (c *hzCollector) observe(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept; otherwise it is fatal, within the shrink budget.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	c.mu.Lock()
+	if c.fails == 0 && hzShrinkBudget > 0 {
+		c.budget = hzShrinkAttempts(len(msg))
+	}
+	if c.budget > 0 && c.fails >= c.budget {
+		// past the budget: the attempt that drew is the engine's replay of the last failure
+		// (the undrawn rejection before it ended the shrink) and prints as usual; were it a
+		// shrink attempt instead, the next attempt is rejected before drawing again
+		c.armed = true
+		c.counts["budget replayed"]++
+		c.mu.Unlock()
+		ht.Fatalf("%s", msg)
+	}
+	c.fails++
+	if c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+	ht.Fatalf("%s", msg)
+}
+
+// skip is whether the attempt is to be rejected before it draws (the budget spent and the
+// previous attempt drawn); past hzShrinkCycles, always.
+func (c *hzCollector) skip() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.budget == 0 || c.fails < c.budget {
+		return false
+	}
+	if c.cycles >= hzShrinkCycles {
+		c.counts["budget exhausted"]++
+		return true
+	}
+	if !c.armed {
+		return false
+	}
+	c.armed = false
+	c.cycles++
+	c.counts["budget skipped"]++
+	return true
+}
+
+// rearm: an attempt past the budget that drew and did not fail arms the next.
+func (c *hzCollector) rearm() {
+	c.mu.Lock()
+	if c.budget > 0 && c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml), indexed by the constants below (the index of a switch
+// is the bug's id minus one: hzKnownID(i) = "gotext/<i+1>"). The replicas (the lookup model
+// in hegel_zoo_lookup_test.go, the evaluators in hegel_zoo_plurals_test.go, the MarshalText
+// model in hegel_zoo_marshal_test.go) are pure functions of (case, oracle answers, known):
+// with every switch off (hzKnownNone) they state the documented behaviour (GNU gettext's
+// answers plus gotext's documented differences) and are what the properties judge the
+// library against; with a switch on they reproduce that bug as a replica of the library's
+// rule, transcribed from the source at the point named beside the switch. The classifier
+// runs the model with several sets to name the shape of a case before the library's answers
+// are judged; the pins assert the documented behaviour and fail while the bug exists.
+type known [8]bool
+
+const (
+	// gotext/1: the PO parser uses fuzzy translations (po.go parseComment :357-369 keeps
+	// only "#:" lines, a "#," flag line is dropped, so a fuzzy entry is stored and answered
+	// like any other; msgfmt leaves it out of the MO and GNU gettext answers the msgid)
+	kFuzzyUsed = 0
+	// gotext/2: GetN picks the untranslated form with the catalog's plural rule (domain.go
+	// GetN :428 "pluralForm := do.pluralForm(n)", :441 "if pluralForm == 0 { return str }
+	// return plural", and for a present entry :436 Translation.GetN(pluralForm), translation.go
+	// :79 "if n == 0 { return t.ID }; return t.PluralID"), where GNU ngettext, GetNC :585 and
+	// Locale.GetND :325 pick by n == 1; with no Plural-Forms header the Germanic rule
+	// (domain.go pluralForm :225) agrees with n == 1 and the shape is not reached
+	kPluralFallback = 1
+	// gotext/3: GetN and GetNC of a singular entry answer "" when the plural index is not 0
+	// (translation.go GetN :72-84: no Trs[n], n != 0, "return t.PluralID", the empty
+	// PluralID of a singular entry)
+	kSingularPluralEmpty = 2
+	// gotext/4: IsTranslated consults the plural index of 1 (domain.go :618 "return
+	// do.IsTranslatedN(str, 1)", :630 "pluralForm := do.pluralForm(n)", so a singular entry
+	// under a rule with plural(1) != 0, the Arabic rule of the twenty here, is never
+	// translated; IsTranslatedC :637 the same)
+	kIsTranslatedIndex = 3
+	// gotext/5: a bare `n` or `n % k` test means n == 1 / n % k == 0 instead of non-zero
+	// (plurals/compiler.go: a lone operand compiles to equal{1} and a lone modulo to
+	// pipe{mod, equal{0}}, where C reads a non-zero test)
+	kBareTests = 4
+	// gotext/6: MarshalText keeps only the first byte of every multi-byte character
+	// (domain.go EscapeSpecialCharacters :905-930 "for i := range s { switch s[i] ... default:
+	// escaped.WriteByte(s[i])" writes one byte per rune index; the output reads back with
+	// U+FFFD per character, msgfmt rejects it and a second MarshalText differs)
+	kMarshalNonASCII = 5
+	// gotext/7: MarshalText writes `\"` for a backslash followed by a quote (domain.go
+	// EscapeSpecialCharacters: case '\\' writes one backslash when the next byte is '"', case
+	// '"' writes no backslash when the previous byte is '\\'), which reads back as `"`: one
+	// pass of `\"` -> `"` over every string
+	kBackslashQuote = 6
+	// gotext/8: the PO parser never clears its reference buffer, so an entry without `#:`
+	// inherits the previous entry's references (po.go parseComment :365 sets refBuffer on a
+	// `#:` line, the flush after every entry :348-352 builds the next translation from it,
+	// "NewTranslationWithRefs(strings.Split(po.domain.refBuffer, \" \"))", without clearing
+	// it; only the next `#:` line replaces it; context entries inherit too, and MarshalText
+	// writes the leaked lines)
+	kRefsLeak    = 7
+	hzKnownCount = 8
+)
+
+// hzKnownRead are the switches the model reads, in bug order: the classifier sweeps these.
+var hzKnownRead = []int{kFuzzyUsed, kPluralFallback, kSingularPluralEmpty, kIsTranslatedIndex, kBareTests, kMarshalNonASCII, kBackslashQuote, kRefsLeak}
+
+// hzKnownID is the bug id of a switch ("gotext/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "gotext/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "gotext/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for _, i := range hzKnownRead {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape gotext/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape via hole", the latter two with the id), the cases skipped for them under
+// HEGEL_NO_KNOWN=1 ("known gotext/N"), the cases whose checks were dropped ("dropped
+// gotext/N") and the checks ("dropped check <class>"), the draws the filters rejected
+// ("filtered <name>"), the replica's agreement with the library on the shaped cases ("replica
+// agreement", "replica disagreement"), the properties' own tallies of what their cases
+// reached (the rates of the report), and the cases assumed away for an unrecorded candidate
+// bug ("candidate/go/gotext-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize ... go/mergo judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of gotext/N)", and under HEGEL_NO_KNOWN=1
+// skips the case instead (counted as known) or drops the checks the shape covers (Dropped).
+// The wide and the narrow properties share their judge functions and so this. The classifier
+// that names the shape is computed from the case record alone (the model run with several
+// sets of switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the shaped cases filtered out), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped gotext/N") and the case goes on
+// (judgeByDropping: the catalog property, whose shapes gotext/2, /3 and /4 are some lookups
+// of a case).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The broken-input property catches the panics of the
+// library's calls itself (hzCall) into the check value "panic" so that they are judged like
+// any other value; this is the net under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	if !hzCollecting {
+		// The narrow properties fail by design and each shrinks its failure; run them two at
+		// a time (go test's -parallel, the CPU count). In collect mode they run one after the
+		// other, the judge's counters being global.
+		t.Parallel()
+	}
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		if col.skip() {
+			ht.Assume(false)
+		}
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+		col.rearm()
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon ... go/mergo form: every value here is text; a model states a set
+// of acceptable values per check and the library's value agrees by membership).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole map for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two. Every value is a set of strings spelled
+// `{"a" | "b"}` (hzSet: the members quoted, sorted, unique); the library's is a set of one
+// (hzValue). The checks of this target are named in the model files: "get 003 Po" (a lookup by
+// query index and side), "agree 003" (the two sides agree), "istr 02 Po", "istrn 02 n5 Po",
+// "header Language Po", "eval 2 n=17", "compile 2", "parsed", "reparsed", "msgfmt",
+// "idempotent", "mo", "gob", "outcome" and the Locale checks.
+type checks map[string]string
+
+// hzSet spells a set of acceptable values; hzValue a set of one.
+func hzSet(vals ...string) string {
+	sort.Strings(vals)
+	var parts []string
+	for i, v := range vals {
+		if i > 0 && v == vals[i-1] {
+			continue
+		}
+		parts = append(parts, strconv.Quote(v))
+	}
+	return "{" + strings.Join(parts, " | ") + "}"
+}
+
+func hzValue(v any) string { return hzSet(fmt.Sprint(v)) }
+
+// hzMembers reads a set back (a value that is not a set is a set of itself).
+func hzMembers(s string) []string {
+	if !strings.HasPrefix(s, "{") || !strings.HasSuffix(s, "}") {
+		return []string{s}
+	}
+	rest := s[1 : len(s)-1]
+	var out []string
+	for rest != "" {
+		q, err := strconv.QuotedPrefix(rest)
+		if err != nil {
+			return []string{s}
+		}
+		v, _ := strconv.Unquote(q)
+		out = append(out, v)
+		rest = strings.TrimPrefix(rest[len(q):], " | ")
+	}
+	return out
+}
+
+func (c checks) set(name string, v any) { c[name] = hzValue(v) }
+
+// add merges the checks of a part of a case under a prefix ("<prefix> <name>").
+func (c checks) add(prefix string, part checks) {
+	for k, v := range part {
+		c[prefix+" "+k] = v
+	}
+}
+
+// checkOrder is the order the checks of a case are reported in when it fails (and the first
+// differing one classes the failure): the whole-case checks, then the lookups before the
+// agreement of the sides, the rest by name.
+var checkOrder = map[string]int{
+	"outcome": 0, "compile": 1, "parsed": 2, "reparsed": 3, "msgfmt": 4, "idempotent": 5, "mo": 6, "gob": 7,
+	"get": 20, "getc": 21, "getn": 22, "getnc": 23, "agree": 24, "istr": 25, "istrn": 26, "header": 27, "language": 28, "pluralforms": 29,
+}
+
+func checkLess(a, b string) bool {
+	ap, an := splitCheck(a)
+	bp, bn := splitCheck(b)
+	ar, aok := checkOrder[classOf(a)]
+	br, bok := checkOrder[classOf(b)]
+	if !aok {
+		ar = 100
+	}
+	if !bok {
+		br = 100
+	}
+	if ar != br {
+		return ar < br
+	}
+	if ap != bp {
+		return ap < bp
+	}
+	return an < bn
+}
+
+// splitCheck is the prefix and the last word of a check name.
+func splitCheck(name string) (string, string) {
+	if i := strings.LastIndexByte(name, ' '); i > 0 {
+		return name[:i], name[i+1:]
+	}
+	return "", name
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two model statements agree: the same checks, each value equal
+// (the classifier's comparison; the sets are spelled canonically).
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeValue reports whether the library's value of a check agrees with a model's: every
+// member of the library's set is a member of the model's.
+func agreeValue(name, got, want string) bool {
+	if got == want {
+		return true
+	}
+	ws := hzMembers(want)
+	for _, g := range hzMembers(got) {
+		found := false
+		for _, w := range ws {
+			if g == w {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeChecks reports whether the library's values agree with a model's: the same checks,
+// each by agreeValue.
+func agreeChecks(got, want checks) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, v := range want {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order; the long values (a description) are cut, the explanation of a case shows the
+// difference.
+func diffChecks(a, b checks) string {
+	var parts []string
+	cut := func(s string) string {
+		if len(s) > 300 {
+			return s[:300] + "..."
+		}
+		return s
+	}
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || !agreeValue(k, a[k], w) {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, cut(a[k])))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, cut(a[k]), cut(w)))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, cut(b[k])))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("gotext/?", a defect of the model). The
+// order matters where two shapes meet (a fuzzy singular entry under the Arabic rule meets
+// gotext/1 and gotext/4; a non-ASCII string with a backslash before a quote gotext/6 and
+// gotext/7): sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "gotext/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule; in collect mode
+// also every switch that alone moves the model ("sufficient gotext/N": the overlaps).
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+		if rule != "sufficiency" {
+			hzTally("shape via " + rule + " " + shape)
+		}
+		if hzCollecting {
+			none := expected(c, hzKnownNone)
+			var ids []string
+			for _, i := range hzKnownRead {
+				if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+					hzTally("sufficient " + hzKnownID(i))
+					ids = append(ids, hzKnownID(i))
+				}
+			}
+			if len(ids) > 1 {
+				hzTally("sufficient together " + strings.Join(ids, "+"))
+			}
+		}
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the name's first word.
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// explainer is a case record that explains a failure in its own terms (the query a check
+// stands for, the PO text, the first difference of two descriptions); the verdict appends it.
+type explainer interface {
+	explain(got, want checks) string
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agreeChecks(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.observe("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if agreeChecks(got, want) {
+		if shape != "" {
+			// named by the classifier but passing: the replica's sets differ from the
+			// documented ones on checks where the library's one value is in both
+			hzTally("shaped pass")
+			j.col.observe("shaped pass", "%s against %s for\n%#v", diffChecks(expected(c, hzKnownAll), want), shape, c)
+		}
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	more := ""
+	if e, ok := any(c).(explainer); ok {
+		more = e.explain(got, want)
+	}
+	j.Fail(classOf(class), "%s for\n%#v%s", diffChecks(got, want), c, more)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library (the case is one
+// shape, skipped whole under HEGEL_NO_KNOWN=1 where the generators let one through). The
+// case is passed by pointer: actual records on it what the library left (the explanation of
+// a failure).
+func judgeBy[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// documented reports, by default and outside collect mode, that the library's values are
+// the documented ones: the case passes and there is no shape to name, so the classifier
+// (several model runs) is not run; under HEGEL_NO_KNOWN=1 the shape is needed first (a case
+// is skipped or its checks dropped before the comparison), and in collect mode the counts
+// are. The shrinking of a failure replays mostly passing cases, which this keeps cheap.
+func documented(got, want checks) bool {
+	return !hzNoKnown && !hzCollecting && agreeChecks(restrict(got, want), want)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi, go/go-debian, go/roaring form; the catalog property
+// here): by default the shape is named and every check judged; under HEGEL_NO_KNOWN=1 the
+// checks the shapes cover (those on which the replica with every switch on differs from the
+// documented model, or which it does not state) are dropped from the case
+// (hzCaseJudge.Dropped, counted "dropped gotext/N") and the rest judged, the case not
+// skipped.
+func judgeByDropping[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(*c, expected)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(*c, hzKnownAll)
+		kept := checks{}
+		for name, v := range want {
+			if w, ok := all[name]; ok && w == v {
+				kept[name] = v
+			} else {
+				hzTally("dropped check " + classOf(name))
+			}
+		}
+		want = kept
+		verdict(j, *c, got, want, "", expected)
+		return
+	}
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs. The
+// rejections are also counted by the shape the case had ("filtered <id> as <shape>", "as
+// none" for no shape), which says what the surroundings bring in.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool {
+		got := shapeID(c, expected)
+		if got == want {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered " + id + " as " + got)
+		return false
+	})
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered gotext/N" by the shape it had), g itself otherwise: the
+// form of a wide property's filter where the shapes are a property of the record alone
+// (kept with the harness; the wide properties here draw past the shapes or drop the checks).
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCall runs a library call and returns what it panicked with (nil when it returned): the
+// broken-input property turns it into the outcome check.
+func hzCall(f func()) (panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	f()
+	return nil
+}
+
+// outcomeOf is the library's outcome check value.
+func outcomeOf(panicked any) string {
+	if panicked != nil {
+		return "panic"
+	}
+	return "ok"
+}
+
+// --------------------------------------------------------------------------- oracles
+
+var (
+	haveMsgfmt   = exec.Command("msgfmt", "--version").Run() == nil
+	haveMsgunfmt = exec.Command("msgunfmt", "--version").Run() == nil
+	havePython   = exec.Command("python3", "-c", "import gettext").Run() == nil
+)
+
+// msgfmt compiles a PO text; returns the MO bytes and msgfmt's messages.
+func msgfmt(dir string, po string, extra ...string) ([]byte, string, error) {
+	poPath := dir + "/in.po"
+	moPath := dir + "/out.mo"
+	if err := os.WriteFile(poPath, []byte(po), 0o644); err != nil {
+		return nil, "", err
+	}
+	os.Remove(moPath)
+	args := append([]string{"-o", moPath}, extra...)
+	args = append(args, poPath)
+	cmd := exec.Command("msgfmt", args...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return nil, string(out), err
+	}
+	mo, err := os.ReadFile(moPath)
+	return mo, string(out), err
+}
+
+// msgunfmt decompiles an MO file back to PO text.
+func msgunfmt(dir string, mo []byte) (string, error) {
+	moPath := dir + "/un.mo"
+	if err := os.WriteFile(moPath, mo, 0o644); err != nil {
+		return "", err
+	}
+	out, err := exec.Command("msgunfmt", moPath).CombinedOutput()
+	return string(out), err
+}
+
+// The Python oracle: gettext.c2py evaluates C plural expressions.
+const pluralOracle = `
+import sys, json, gettext
+req = json.load(sys.stdin)
+out = []
+for e in req["exprs"]:
+    try:
+        f = gettext.c2py(e)
+        out.append([f(n) for n in req["ns"]])
+    except Exception as ex:
+        out.append("error: " + str(ex))
+json.dump(out, sys.stdout)
+`
+
+// pyPlural evaluates exprs at ns with Python; a string result is an error.
+func pyPlural(t testing.TB, exprs []string, ns []int) []any {
+	req, _ := json.Marshal(map[string]any{"exprs": exprs, "ns": ns})
+	cmd := exec.Command("python3", "-c", pluralOracle)
+	cmd.Stdin = bytes.NewReader(req)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python oracle: %v\n%s", err, stderr.String())
+	}
+	var res []any
+	if err := json.Unmarshal(out, &res); err != nil {
+		t.Fatalf("python oracle output: %v\n%s", err, out)
+	}
+	return res
+}
+
+// The Python lookup oracle: GNUTranslations on the msgfmt output answers
+// gettext/ngettext/pgettext/npgettext, and the catalog plural index for each n.
+const lookupOracle = `
+import sys, json, gettext
+req = json.load(sys.stdin)
+t = gettext.GNUTranslations(open(req["mo"], "rb"))
+out = {"answers": [], "idx": {}}
+for q in req["queries"]:
+    kind = q["kind"]
+    if kind == "get":
+        out["answers"].append(t.gettext(q["id"]))
+    elif kind == "getc":
+        out["answers"].append(t.pgettext(q["ctx"], q["id"]))
+    elif kind == "getn":
+        out["answers"].append(t.ngettext(q["id"], q["plural"], q["n"]))
+    elif kind == "getnc":
+        out["answers"].append(t.npgettext(q["ctx"], q["id"], q["plural"], q["n"]))
+for n in req["ns"]:
+    out["idx"][str(n)] = t.plural(n)
+json.dump(out, sys.stdout)
+`
+
+// query is one lookup: Kind get, getc, getn or getnc.
+type query struct {
+	Kind   string `json:"kind"`
+	Ctx    string `json:"ctx"`
+	ID     string `json:"id"`
+	Plural string `json:"plural"`
+	N      int    `json:"n"`
+}
+
+func (q query) String() string {
+	switch q.Kind {
+	case "get":
+		return fmt.Sprintf("Get(%q)", q.ID)
+	case "getc":
+		return fmt.Sprintf("GetC(%q, ctx %q)", q.ID, q.Ctx)
+	case "getn":
+		return fmt.Sprintf("GetN(%q, %q, %d)", q.ID, q.Plural, q.N)
+	}
+	return fmt.Sprintf("GetNC(%q, %q, %d, ctx %q)", q.ID, q.Plural, q.N, q.Ctx)
+}
+
+// oracle is GNU gettext's answers to the queries of a case (Python's GNUTranslations on the
+// MO msgfmt compiled) and the catalog's plural index for each n, asked once per case before
+// the library and read by the model.
+type oracle struct {
+	Answers []string       `json:"answers"`
+	Idx     map[string]int `json:"idx"`
+}
+
+func pyLookup(t testing.TB, dir string, mo []byte, queries []query, ns []int) oracle {
+	moPath := dir + "/py.mo"
+	if err := os.WriteFile(moPath, mo, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	req, _ := json.Marshal(map[string]any{"mo": moPath, "queries": queries, "ns": ns})
+	cmd := exec.Command("python3", "-c", lookupOracle)
+	cmd.Stdin = bytes.NewReader(req)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python lookup oracle: %v\n%s", err, stderr.String())
+	}
+	var res oracle
+	if err := json.Unmarshal(out, &res); err != nil {
+		t.Fatalf("python lookup oracle output: %v\n%s", err, out)
+	}
+	return res
+}
+
+// --------------------------------------------------------------------------- describing
+// gotext's state
+
+// describeDomain dumps a domain's translations, contexts and headers in a canonical order
+// (comments and references aside when withRefs is false); describeCatalog
+// (hegel_zoo_marshal_test.go) states the same text from the catalog record.
+func describeDomain(d *gotext.Domain, withRefs bool) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "language=%q plural-forms=%q\n", d.Language, d.PluralForms)
+	keys := make([]string, 0, len(d.Headers))
+	for k := range d.Headers {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		fmt.Fprintf(&b, "header %q = %q\n", k, d.Headers[k])
+	}
+	writeTr := func(prefix string, trs map[string]*gotext.Translation) {
+		ids := make([]string, 0, len(trs))
+		for id := range trs {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			if id == "" {
+				continue // the header entry: its fields are compared as headers
+			}
+			tr := trs[id]
+			idx := make([]int, 0, len(tr.Trs))
+			for i := range tr.Trs {
+				idx = append(idx, i)
+			}
+			sort.Ints(idx)
+			fmt.Fprintf(&b, "%s id=%q plural=%q", prefix, tr.ID, tr.PluralID)
+			for _, i := range idx {
+				fmt.Fprintf(&b, " [%d]=%q", i, tr.Trs[i])
+			}
+			if withRefs {
+				fmt.Fprintf(&b, " refs=%q", tr.Refs)
+			}
+			b.WriteString("\n")
+		}
+	}
+	writeTr("tr", d.GetTranslations())
+	ctxs := d.GetCtxTranslations()
+	names := make([]string, 0, len(ctxs))
+	for c := range ctxs {
+		names = append(names, c)
+	}
+	sort.Strings(names)
+	for _, c := range names {
+		writeTr(fmt.Sprintf("ctx %q", c), ctxs[c])
+	}
+	return b.String()
+}
+
+func firstDiff(a, b string) string {
+	al := strings.Split(a, "\n")
+	bl := strings.Split(b, "\n")
+	for i := 0; i < len(al) || i < len(bl); i++ {
+		var x, y string
+		if i < len(al) {
+			x = al[i]
+		}
+		if i < len(bl) {
+			y = bl[i]
+		}
+		if x != y {
+			return fmt.Sprintf("line %d:\n  a: %s\n  b: %s", i+1, x, y)
+		}
+	}
+	return "(no difference)"
+}
