+package gotext_test
+
+// Hegel properties for gotext: plural-form expressions against Python's
+// gettext.c2py (the C semantics), PO/MO catalogs against GNU msgfmt,
+// msgunfmt and Python's GNUTranslations, and gotext's own round trips
+// (MarshalText, gob, Locale lookup).
+//
+// Oracles on this machine: msgfmt/msgunfmt (gettext-tools) and python3; a
+// property skips when its oracle is missing.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/leonelquinteros/gotext"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	fuzzyUsed           bool // gotext/1: the PO parser uses fuzzy translations
+	pluralFallback      bool // gotext/2: GetN picks the untranslated form with the catalog's rule, not n == 1 as GNU and GetNC do
+	singularPluralEmpty bool // gotext/3: GetN/GetNC of a singular entry answer "" when the plural index is not 0
+	isTranslatedIndex   bool // gotext/4: IsTranslated of a singular entry consults the plural index of 1 (false for Arabic)
+	bareTests           bool // gotext/5: a bare `n` / `n % k` test means n == 1 / n % k == 0 instead of non-zero
+	marshalNonASCII     bool // gotext/6: MarshalText keeps only the first byte of every multi-byte character
+	marshalBackslash    bool // gotext/7: MarshalText writes a backslash before a quote unescaped, so `\"` reads back as `"`
+}{fuzzyUsed: true, pluralFallback: true, singularPluralEmpty: true, isTranslatedIndex: true, bareTests: true, marshalNonASCII: true, marshalBackslash: true}
+
+// mapStrings applies fix to every string of the catalog.
+func mapStrings(c *catalog, fix func(string) string) {
+	for i := range c.entries {
+		e := &c.entries[i]
+		e.ctx, e.id, e.plural = fix(e.ctx), fix(e.id), fix(e.plural)
+		for j := range e.forms {
+			e.forms[j] = fix(e.forms[j])
+		}
+	}
+	for i := range c.headers {
+		c.headers[i][1] = fix(c.headers[i][1])
+	}
+}
+
+// noBackslashQuote removes every backslash that precedes a quote
+// (gotext/7).
+func noBackslashQuote(c *catalog) {
+	mapStrings(c, func(s string) string { return strings.ReplaceAll(s, `\"`, `"`) })
+}
+
+// asciiOnly replaces every non-ASCII character of the catalog's strings
+// (gotext/6).
+func asciiOnly(c *catalog) {
+	mapStrings(c, func(s string) string {
+		return strings.Map(func(r rune) rune {
+			if r >= 128 {
+				return 'x'
+			}
+			return r
+		}, s)
+	})
+}
+
+var (
+	haveMsgfmt   = exec.Command("msgfmt", "--version").Run() == nil
+	haveMsgunfmt = exec.Command("msgunfmt", "--version").Run() == nil
+	havePython   = exec.Command("python3", "-c", "import gettext").Run() == nil
+)
+
+// ---------------------------------------------------------------------------
+// Plural-form expressions (the C grammar gettext uses).
+
+// The Plural-Forms expressions of GNU gettext's manual and of gotext's own
+// fixtures.
+var realPluralForms = []struct {
+	nplurals int
+	plural   string
+}{
+	{1, "0"},
+	{2, "n != 1"},
+	{2, "(n != 1)"},
+	{2, "n>1"},
+	{2, "(n > 1)"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n != 0 ? 1 : 2"},
+	{3, "n==1 ? 0 : n==2 ? 1 : 2"},
+	{3, "n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n%10>=2 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{3, "n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{3, "(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2"},
+	{3, "n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2"},
+	{4, "n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3"},
+	{6, "n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5"},
+	{2, "n == 1 ? 0 : 1"},
+	{2, "(n==1) ? 0 : 1"},
+	{4, "(n==1 || n==11) ? 0 : (n==2 || n==12) ? 1 : (n > 2 && n < 20) ? 2 : 3"},
+	{5, "(n==1) ? 0 : (n==2) ? 1 : (n<7) ? 2 : (n<11) ? 3 : 4"},
+	{2, "(n%10!=1 || n%100==11)"},
+	{3, "(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2)"},
+}
+
+// ptest is a boolean test in a plural expression.
+type ptest struct {
+	kind    string // cmp, and, or, bare
+	op      string // for cmp: == != < > <= >=
+	mod     int    // for cmp/bare: 0 for `n`, else `n % mod`
+	val     int    // for cmp: the constant
+	flipped bool   // for cmp: `val op operand`
+	l, r    *ptest // for and/or
+	paren   bool   // spelled in parentheses
+}
+
+// pexpr is a plural expression: a constant or a ternary.
+type pexpr struct {
+	isConst bool
+	c       int
+	test    *ptest
+	a, b    *pexpr
+	paren   bool
+}
+
+type pgen struct {
+	tc   hegel.TestCase
+	bare bool // allow bare `n` / `n % k` tests (a non-zero test in C)
+}
+
+func (g *pgen) operand() int {
+	if chance(g.tc, 50) {
+		return 0
+	}
+	return pick(g.tc, 10, 100, 2, 3, 5, 7, 1000, 6, 11)
+}
+
+func (g *pgen) test(depth int) *ptest {
+	if depth <= 0 || chance(g.tc, 55) {
+		if g.bare && chance(g.tc, 15) {
+			return &ptest{kind: "bare", mod: g.operand(), paren: chance(g.tc, 50)}
+		}
+		t := &ptest{kind: "cmp", op: pick(g.tc, "==", "!=", "<", ">", "<=", ">="), mod: g.operand()}
+		switch n(g.tc, 0, 3) {
+		case 0:
+			t.val = n(g.tc, 0, 3)
+		case 1:
+			t.val = n(g.tc, 0, 25)
+		case 2:
+			t.val = pick(g.tc, 10, 11, 12, 14, 19, 20, 99, 100, 101)
+		default:
+			t.val = n(g.tc, 0, 5000)
+		}
+		t.flipped = chance(g.tc, 20)
+		t.paren = chance(g.tc, 30)
+		return t
+	}
+	kind := pick(g.tc, "and", "or")
+	t := &ptest{kind: kind, l: g.test(depth - 1), r: g.test(depth - 1), paren: chance(g.tc, 40)}
+	return t
+}
+
+func (g *pgen) expr(depth int, nplurals int) *pexpr {
+	if depth <= 0 || chance(g.tc, 35) {
+		return &pexpr{isConst: true, c: n(g.tc, 0, nplurals-1)}
+	}
+	e := &pexpr{test: g.test(n(g.tc, 0, 2)), paren: chance(g.tc, 20)}
+	if chance(g.tc, 70) {
+		e.a = &pexpr{isConst: true, c: n(g.tc, 0, nplurals-1)}
+	} else {
+		e.a = g.expr(depth-1, nplurals)
+		e.a.paren = e.a.paren || chance(g.tc, 50)
+	}
+	e.b = g.expr(depth-1, nplurals)
+	return e
+}
+
+func (g *pgen) sp() string {
+	return pick(g.tc, "", " ", " ", "  ")
+}
+
+func (g *pgen) renderOperand(mod int) string {
+	if mod == 0 {
+		return "n"
+	}
+	return "n" + g.sp() + "%" + g.sp() + strconv.Itoa(mod)
+}
+
+// prec: or 1, and 2, cmp/bare 3.
+func testPrec(t *ptest) int {
+	switch t.kind {
+	case "or":
+		return 1
+	case "and":
+		return 2
+	}
+	return 3
+}
+
+func (g *pgen) renderTest(t *ptest, minPrec int) string {
+	var s string
+	switch t.kind {
+	case "bare":
+		s = g.renderOperand(t.mod)
+	case "cmp":
+		if t.flipped {
+			s = strconv.Itoa(t.val) + g.sp() + t.op + g.sp() + g.renderOperand(t.mod)
+		} else {
+			s = g.renderOperand(t.mod) + g.sp() + t.op + g.sp() + strconv.Itoa(t.val)
+		}
+	case "and":
+		s = g.renderTest(t.l, 2) + g.sp() + "&&" + g.sp() + g.renderTest(t.r, 3)
+	case "or":
+		s = g.renderTest(t.l, 1) + g.sp() + "||" + g.sp() + g.renderTest(t.r, 2)
+	}
+	if t.paren || testPrec(t) < minPrec {
+		return "(" + g.sp() + s + g.sp() + ")"
+	}
+	return s
+}
+
+func (g *pgen) renderExpr(e *pexpr) string {
+	var s string
+	if e.isConst {
+		s = strconv.Itoa(e.c)
+	} else {
+		a := g.renderExpr(e.a)
+		if !e.a.isConst && !e.a.paren {
+			a = "(" + a + ")"
+		}
+		s = g.renderTest(e.test, 1) + g.sp() + "?" + g.sp() + a + g.sp() + ":" + g.sp() + g.renderExpr(e.b)
+	}
+	if e.paren {
+		return "(" + g.sp() + s + g.sp() + ")"
+	}
+	return s
+}
+
+// A test-only plural (its value in C is 0 or 1).
+func (g *pgen) renderTestOnly(t *ptest) string {
+	return g.renderTest(t, 1)
+}
+
+// Sample values of n for the plural comparisons.
+func sampleNs(tc hegel.TestCase) []int {
+	ns := []int{}
+	for i := 0; i <= 45; i++ {
+		ns = append(ns, i)
+	}
+	ns = append(ns, 99, 100, 101, 102, 105, 110, 111, 112, 119, 120, 121, 199, 200, 201, 211, 1000, 1001, 1011, 12345, 2147483647, 4294967295)
+	for k := 0; k < 3; k++ {
+		ns = append(ns, n(tc, 0, 1000000))
+	}
+	return ns
+}
+
+// The Python oracle: gettext.c2py evaluates C plural expressions.
+const pluralOracle = `
+import sys, json, gettext
+req = json.load(sys.stdin)
+out = []
+for e in req["exprs"]:
+    try:
+        f = gettext.c2py(e)
+        out.append([f(n) for n in req["ns"]])
+    except Exception as ex:
+        out.append("error: " + str(ex))
+json.dump(out, sys.stdout)
+`
+
+// pyPlural evaluates exprs at ns with Python; a string result is an error.
+func pyPlural(t testing.TB, exprs []string, ns []int) []any {
+	req, _ := json.Marshal(map[string]any{"exprs": exprs, "ns": ns})
+	cmd := exec.Command("python3", "-c", pluralOracle)
+	cmd.Stdin = bytes.NewReader(req)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python oracle: %v\n%s", err, stderr.String())
+	}
+	var res []any
+	if err := json.Unmarshal(out, &res); err != nil {
+		t.Fatalf("python oracle output: %v\n%s", err, out)
+	}
+	return res
+}
+
+// ---------------------------------------------------------------------------
+// Catalogs.
+
+type entry struct {
+	hasCtx    bool
+	ctx       string
+	id        string
+	hasPlural bool
+	plural    string
+	forms     []string // one for a singular entry, nplurals for a plural one
+	fuzzy     bool
+	refs      []string
+	comments  []string // translator and extracted comments (spelled before the entry)
+	prev      string   // a `#| msgid` previous-string comment
+	flags     []string // other flags (c-format …)
+}
+
+type catalog struct {
+	headers  [][2]string
+	comments []string // comments before the header entry
+	nplurals int
+	plural   string
+	entries  []entry
+}
+
+func (c *catalog) key(e entry) string { return e.ctx + "\x04" + e.id }
+
+var wordPool = []string{"apple", "file", "Hello, world", "Save", "%d item", "%s: %d", "naïve", "日本語", "😀 ok", "tab\there", "line\nbreak", "quote\"d", "back\\slash", "100%%", "trailing\n", " lead", "a:b", "#hash", "msgid", "x"}
+
+func genText(tc hegel.TestCase, allowEmpty bool) string {
+	if allowEmpty && chance(tc, 15) {
+		return ""
+	}
+	if chance(tc, 60) {
+		return pick(tc, wordPool...)
+	}
+	var b strings.Builder
+	for k := n(tc, 1, 6); k > 0; k-- {
+		switch n(tc, 1, 12) {
+		case 1:
+			b.WriteString("\n")
+		case 2:
+			b.WriteString("\t")
+		case 3:
+			b.WriteString("\"")
+		case 4:
+			b.WriteString("\\")
+		case 5:
+			b.WriteString(pick(tc, "é", "ß", "中", "🎉", "\u00a0"))
+		case 6:
+			b.WriteString(pick(tc, "%d", "%s", "%%", "%v", "%(name)s"))
+		case 7:
+			b.WriteString(" ")
+		case 8:
+			b.WriteString("\r")
+		default:
+			b.WriteString(pick(tc, "a", "b", "word", "Z", "0", "-", ".", "'"))
+		}
+	}
+	return b.String()
+}
+
+// genCatalog draws a catalog whose entries have distinct (context, msgid)
+// keys; fuzzy entries only when allowFuzzy.
+func genCatalog(tc hegel.TestCase, allowFuzzy bool) *catalog {
+	c := &catalog{}
+	pf := pick(tc, realPluralForms...)
+	c.nplurals, c.plural = pf.nplurals, pf.plural
+	lang := pick(tc, "en", "de", "de_DE", "pl", "ar", "fr", "ru", "cs", "ja")
+	hdr := [][2]string{
+		{"Project-Id-Version", pick(tc, "hegel 1.0", "PACKAGE VERSION", "x")},
+		{"Language", lang},
+		{"MIME-Version", "1.0"},
+		{"Content-Type", "text/plain; charset=UTF-8"},
+		{"Content-Transfer-Encoding", "8bit"},
+	}
+	if chance(tc, 90) {
+		hdr = append(hdr, [2]string{"Plural-Forms", fmt.Sprintf("nplurals=%d; plural=%s;", c.nplurals, c.plural)})
+	} else {
+		// No Plural-Forms header: the Germanic rule applies.
+		c.nplurals, c.plural = 2, ""
+	}
+	if chance(tc, 30) {
+		hdr = append(hdr, [2]string{"X-Generator", pick(tc, "hegel", "Poedit 3.0", "a: b: c")})
+	}
+	if chance(tc, 30) {
+		hdr = append(hdr, [2]string{"Last-Translator", "Someone <someone@example.com>"})
+	}
+	// Random order, but Content-Type first is common.
+	for i := len(hdr) - 1; i > 0; i-- {
+		j := n(tc, 0, i)
+		hdr[i], hdr[j] = hdr[j], hdr[i]
+	}
+	c.headers = hdr
+	if chance(tc, 40) {
+		c.comments = []string{"# Translations for hegel.", "# Copyright (C) 2026", "#, fuzzy"}
+		if !allowFuzzy || chance(tc, 50) {
+			c.comments = c.comments[:2]
+		}
+	}
+	seen := map[string]bool{"\x04": true}
+	for k := n(tc, 0, 7); k > 0; k-- {
+		var e entry
+		if chance(tc, 30) {
+			e.hasCtx = true
+			e.ctx = pick(tc, "menu", "verb", "noun", "ctx with space", "日")
+		}
+		for tries := 0; tries < 10; tries++ {
+			e.id = genText(tc, false)
+			if e.id != "" && !strings.ContainsAny(e.id, "\x00\x04") && !seen[c.key(e)] {
+				break
+			}
+			e.id = ""
+		}
+		if e.id == "" {
+			continue
+		}
+		seen[c.key(e)] = true
+		if chance(tc, 45) {
+			e.hasPlural = true
+			e.plural = genText(tc, false)
+			if e.plural == "" || strings.ContainsAny(e.plural, "\x00\x04") {
+				e.plural = e.id + "s"
+			}
+			e.forms = make([]string, c.nplurals)
+			mode := n(tc, 1, 10)
+			for i := range e.forms {
+				switch {
+				case mode <= 1: // untranslated
+				case mode == 2 && chance(tc, 50): // partially translated
+				default:
+					e.forms[i] = genText(tc, false)
+				}
+			}
+		} else {
+			e.forms = []string{genText(tc, true)}
+		}
+		for i, f := range e.forms {
+			if strings.ContainsAny(f, "\x00\x04") {
+				f = "x"
+			}
+			// msgfmt insists a translation begins and ends with a newline
+			// exactly when the msgid does.
+			if f != "" {
+				f = strings.TrimLeft(f, "\n")
+				f = strings.TrimRight(f, "\n")
+				if f == "" {
+					f = "x"
+				}
+				if strings.HasPrefix(e.id, "\n") {
+					f = "\n" + f
+				}
+				if strings.HasSuffix(e.id, "\n") {
+					f += "\n"
+				}
+			}
+			e.forms[i] = f
+		}
+		// A partially translated entry may not leave a form empty when the
+		// msgid begins or ends with a newline: msgfmt checks every form of
+		// a translated entry for the newlines.
+		if e.forms[0] != "" && (strings.HasPrefix(e.id, "\n") || strings.HasSuffix(e.id, "\n")) {
+			for i, f := range e.forms {
+				if f == "" {
+					if strings.HasPrefix(e.id, "\n") {
+						f = "\n"
+					}
+					f += "x"
+					if strings.HasSuffix(e.id, "\n") {
+						f += "\n"
+					}
+					e.forms[i] = f
+				}
+			}
+		}
+		if e.hasPlural {
+			// msgid_plural too begins and ends with a newline exactly when
+			// the msgid does.
+			pl := strings.Trim(e.plural, "\n")
+			if pl == "" {
+				pl = "xs"
+			}
+			if strings.HasPrefix(e.id, "\n") {
+				pl = "\n" + pl
+			}
+			if strings.HasSuffix(e.id, "\n") {
+				pl += "\n"
+			}
+			e.plural = pl
+		}
+		e.fuzzy = allowFuzzy && chance(tc, 12)
+		if chance(tc, 35) {
+			for r := n(tc, 1, 3); r > 0; r-- {
+				e.refs = append(e.refs, pick(tc, "main.go", "pkg/a.go", "cmd/x/y.go")+":"+strconv.Itoa(n(tc, 1, 999)))
+			}
+		}
+		if chance(tc, 25) {
+			e.comments = append(e.comments, pick(tc, "# translator note", "#. extracted comment", "# two words"))
+		}
+		if chance(tc, 10) {
+			e.prev = pick(tc, "old id", "older")
+		}
+		if chance(tc, 15) {
+			e.flags = append(e.flags, pick(tc, "no-c-format", "no-python-format"))
+		}
+		c.entries = append(c.entries, e)
+	}
+	return c
+}
+
+// poEscape spells s as the inside of a PO quoted string on one line.
+func poEscape(tc hegel.TestCase, s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '"':
+			b.WriteString(`\"`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		case '\r':
+			b.WriteString(`\r`)
+		default:
+			if tc != nil && r < 128 && r >= 'A' && r <= 'z' && chance(tc, 3) {
+				// Rarely, an octal escape (a hex escape would swallow a
+				// following hex digit in C).
+				fmt.Fprintf(&b, `\%03o`, r)
+				continue
+			}
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// poString spells s as a PO string: one line, or `""` followed by
+// continuation lines (split at rune boundaries, preferably after `\n`).
+func poString(tc hegel.TestCase, s string) string {
+	if s == "" || chance(tc, 60) {
+		return "\"" + poEscape(tc, s) + "\""
+	}
+	var pieces []string
+	if chance(tc, 60) && strings.Count(s, "\n") > 0 {
+		for _, line := range strings.SplitAfter(s, "\n") {
+			if line != "" {
+				pieces = append(pieces, line)
+			}
+		}
+	} else {
+		rest := s
+		for rest != "" {
+			cut := n(tc, 1, utf8.RuneCountInString(rest))
+			i := 0
+			for k := 0; k < cut; k++ {
+				_, size := utf8.DecodeRuneInString(rest[i:])
+				i += size
+			}
+			pieces = append(pieces, rest[:i])
+			rest = rest[i:]
+		}
+	}
+	var b strings.Builder
+	b.WriteString("\"\"")
+	for _, p := range pieces {
+		b.WriteString("\n\"" + poEscape(tc, p) + "\"")
+	}
+	return b.String()
+}
+
+// spellPO writes the catalog as a PO file.
+func spellPO(tc hegel.TestCase, c *catalog) string {
+	var b strings.Builder
+	for _, cm := range c.comments {
+		b.WriteString(cm + "\n")
+	}
+	b.WriteString("msgid \"\"\nmsgstr \"\"\n")
+	for _, h := range c.headers {
+		b.WriteString("\"" + h[0] + ": " + poEscape(nil, h[1]) + "\\n\"\n")
+	}
+	sep := pick(tc, " ", " ", "\t", "  ")
+	for _, e := range c.entries {
+		b.WriteString("\n")
+		for _, cm := range e.comments {
+			b.WriteString(cm + "\n")
+		}
+		if len(e.refs) > 0 {
+			b.WriteString("#: " + strings.Join(e.refs, " ") + "\n")
+		}
+		flags := append([]string{}, e.flags...)
+		if e.fuzzy {
+			flags = append([]string{"fuzzy"}, flags...)
+		}
+		if len(flags) > 0 {
+			b.WriteString("#, " + strings.Join(flags, ", ") + "\n")
+		}
+		if e.prev != "" {
+			b.WriteString("#| msgid \"" + poEscape(nil, e.prev) + "\"\n")
+		}
+		if e.hasCtx {
+			b.WriteString("msgctxt" + sep + poString(tc, e.ctx) + "\n")
+		}
+		b.WriteString("msgid" + sep + poString(tc, e.id) + "\n")
+		if e.hasPlural {
+			b.WriteString("msgid_plural" + sep + poString(tc, e.plural) + "\n")
+			for i, f := range e.forms {
+				b.WriteString("msgstr[" + strconv.Itoa(i) + "]" + sep + poString(tc, f) + "\n")
+			}
+		} else {
+			b.WriteString("msgstr" + sep + poString(tc, e.forms[0]) + "\n")
+		}
+	}
+	if chance(tc, 30) {
+		// An obsolete entry, ignored by everyone.
+		b.WriteString("\n#~ msgid \"obsolete\"\n#~ msgstr \"OBSOLETE\"\n")
+	}
+	return b.String()
+}
+
+// msgfmt compiles a PO text; returns the MO bytes and msgfmt's messages.
+func msgfmt(dir string, po string, extra ...string) ([]byte, string, error) {
+	poPath := dir + "/in.po"
+	moPath := dir + "/out.mo"
+	if err := os.WriteFile(poPath, []byte(po), 0o644); err != nil {
+		return nil, "", err
+	}
+	os.Remove(moPath)
+	args := append([]string{"-o", moPath}, extra...)
+	args = append(args, poPath)
+	cmd := exec.Command("msgfmt", args...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return nil, string(out), err
+	}
+	mo, err := os.ReadFile(moPath)
+	return mo, string(out), err
+}
+
+// msgunfmt decompiles an MO file back to PO text.
+func msgunfmt(dir string, mo []byte) (string, error) {
+	moPath := dir + "/un.mo"
+	if err := os.WriteFile(moPath, mo, 0o644); err != nil {
+		return "", err
+	}
+	out, err := exec.Command("msgunfmt", moPath).CombinedOutput()
+	return string(out), err
+}
+
+// The Python lookup oracle: GNUTranslations on the msgfmt output answers
+// gettext/ngettext/pgettext/npgettext, and the catalog plural index for
+// each n.
+const lookupOracle = `
+import sys, json, gettext
+req = json.load(sys.stdin)
+t = gettext.GNUTranslations(open(req["mo"], "rb"))
+out = {"answers": [], "idx": {}}
+for q in req["queries"]:
+    kind = q["kind"]
+    if kind == "get":
+        out["answers"].append(t.gettext(q["id"]))
+    elif kind == "getc":
+        out["answers"].append(t.pgettext(q["ctx"], q["id"]))
+    elif kind == "getn":
+        out["answers"].append(t.ngettext(q["id"], q["plural"], q["n"]))
+    elif kind == "getnc":
+        out["answers"].append(t.npgettext(q["ctx"], q["id"], q["plural"], q["n"]))
+for n in req["ns"]:
+    out["idx"][str(n)] = t.plural(n)
+json.dump(out, sys.stdout)
+`
+
+type query struct {
+	Kind   string `json:"kind"`
+	Ctx    string `json:"ctx"`
+	ID     string `json:"id"`
+	Plural string `json:"plural"`
+	N      int    `json:"n"`
+}
+
+type lookupResult struct {
+	Answers []string       `json:"answers"`
+	Idx     map[string]int `json:"idx"`
+}
+
+func pyLookup(t testing.TB, dir string, mo []byte, queries []query, ns []int) lookupResult {
+	moPath := dir + "/py.mo"
+	if err := os.WriteFile(moPath, mo, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	req, _ := json.Marshal(map[string]any{"mo": moPath, "queries": queries, "ns": ns})
+	cmd := exec.Command("python3", "-c", lookupOracle)
+	cmd.Stdin = bytes.NewReader(req)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python lookup oracle: %v\n%s", err, stderr.String())
+	}
+	var res lookupResult
+	if err := json.Unmarshal(out, &res); err != nil {
+		t.Fatalf("python lookup oracle output: %v\n%s", err, out)
+	}
+	return res
+}
+
+// ---------------------------------------------------------------------------
+// Describing gotext's state.
+
+// describeDomain dumps a domain's translations, contexts and headers in a
+// canonical order (comments and references aside when withRefs is false).
+func describeDomain(d *gotext.Domain, withRefs bool) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "language=%q plural-forms=%q\n", d.Language, d.PluralForms)
+	keys := make([]string, 0, len(d.Headers))
+	for k := range d.Headers {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		fmt.Fprintf(&b, "header %q = %q\n", k, d.Headers[k])
+	}
+	writeTr := func(prefix string, trs map[string]*gotext.Translation) {
+		ids := make([]string, 0, len(trs))
+		for id := range trs {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			if id == "" {
+				continue // the header entry: its fields are compared as headers
+			}
+			tr := trs[id]
+			idx := make([]int, 0, len(tr.Trs))
+			for i := range tr.Trs {
+				idx = append(idx, i)
+			}
+			sort.Ints(idx)
+			fmt.Fprintf(&b, "%s id=%q plural=%q", prefix, tr.ID, tr.PluralID)
+			for _, i := range idx {
+				fmt.Fprintf(&b, " [%d]=%q", i, tr.Trs[i])
+			}
+			if withRefs {
+				fmt.Fprintf(&b, " refs=%q", tr.Refs)
+			}
+			b.WriteString("\n")
+		}
+	}
+	writeTr("tr", d.GetTranslations())
+	ctxs := d.GetCtxTranslations()
+	names := make([]string, 0, len(ctxs))
+	for c := range ctxs {
+		names = append(names, c)
+	}
+	sort.Strings(names)
+	for _, c := range names {
+		writeTr(fmt.Sprintf("ctx %q", c), ctxs[c])
+	}
+	return b.String()
+}
+
+func firstDiff(a, b string) string {
+	al := strings.Split(a, "\n")
+	bl := strings.Split(b, "\n")
+	for i := 0; i < len(al) || i < len(bl); i++ {
+		var x, y string
+		if i < len(al) {
+			x = al[i]
+		}
+		if i < len(bl) {
+			y = bl[i]
+		}
+		if x != y {
+			return fmt.Sprintf("line %d:\n  a: %s\n  b: %s", i+1, x, y)
+		}
+	}
+	return "(no difference)"
+}
