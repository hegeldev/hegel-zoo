+// A frame produced by the reference tool at a random level (with or without
+// checksum, with --long windows, small block sizes, or as several
+// concatenated frames) decompresses with klauspost's Decoder — DecodeAll,
+// the streaming Reader, and WriteTo — to the input.
+func TestHegelReferenceToolOutputDecodesWithKlauspost(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		dir := t.TempDir()
+		c := hegel.Draw(ht, cliCases)
+		dict := c.dict.bytes(t)
+		dictPath := dictFile(t, dir, dict)
+		var datas, frames [][]byte
+		var descs []string
+		for _, f := range c.frames {
+			data := f.data.bytes()
+			args := append(dictArgs(dictPath), f.args()...)
+			frame, err := zstdCLIFile(t, dir, data, args...)
+			if err != nil {
+				fail(ht, "reference zstd failed: %v", err)
+			}
+			datas = append(datas, data)
+			frames = append(frames, frame)
+			descs = append(descs, strings.Join(f.args(), " "))
+		}
+		stream := bytes.Join(frames, nil)
+		want := bytes.Join(datas, nil)
+		note(ht, "stream %s", short(stream))
+
+		dopts := append([]zstd.DOption{zstd.WithDecoderConcurrency(c.concurrency), zstd.WithDecoderLowmem(c.lowMem)}, c.dict.decoderOptions(dict)...)
+		dec, err := zstd.NewReader(nil, dopts...)
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		defer dec.Close()
+		got, err := dec.DecodeAll(stream, nil)
+		if err != nil {
+			fail(ht, "DecodeAll rejects the reference tool's output (%s): %v", strings.Join(descs, " | "), err)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "DecodeAll decodes the reference tool's output differently: %s", diffAt(got, want))
+		}
+
+		if err := dec.Reset(bytes.NewReader(stream)); err != nil {
+			fail(ht, "Reset: %v", err)
+		}
+		if c.writeTo {
+			var b bytes.Buffer
+			_, err = dec.WriteTo(&b)
+			got = b.Bytes()
+		} else {
+			got, err = io.ReadAll(dec)
+		}
+		if err != nil {
+			fail(ht, "streaming decode rejects the reference tool's output (%s): %v", strings.Join(descs, " | "), err)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "streaming decode differs: %s", diffAt(got, want))
+		}
+
+		var h zstd.Header
+		if err := h.Decode(frames[0]); err != nil {
+			fail(ht, "Header.Decode on the reference tool's frame: %v", err)
+		}
+		if re, err := h.AppendTo(nil); err != nil || !bytes.Equal(re, frames[0][:h.HeaderSize]) {
+			fail(ht, "Header.AppendTo re-encodes the reference tool's header %x as %x (%v)", frames[0][:h.HeaderSize], re, err)
+		}
+		if h.HasCheckSum == c.frames[0].noCheck {
+			fail(ht, "Header.HasCheckSum = %v for a frame written with %q", h.HasCheckSum, descs[0])
+		}
+		if !c.frames[0].noContentSize && (!h.HasFCS || h.FrameContentSize != uint64(len(datas[0]))) {
+			fail(ht, "Header: HasFCS=%v FrameContentSize=%d for %d bytes written with %q", h.HasFCS, h.FrameContentSize, len(datas[0]), descs[0])
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Properties: corrupted streams.  Both decoders of one format implement the
+// same specification, so a damaged stream must be accepted by both (with
+// identical output) or rejected by both.
+
+// mutation is one corruption of a stream: the kind, the byte it hits (at,
+// taken modulo the length), and the bit or value it uses; an empty stream
+// gets the value appended instead.
+type mutation struct {
+	kind mutationKind
+	at   int
+	bit  int
+	val  byte
+}
+
+type mutationKind int
+
+const (
+	flipBit mutationKind = iota
+	setByte
+	truncate
+	insertByte
+	deleteByte
+)
+
+var mutations = hegel.Composite(func(tc hegel.TestCase) mutation {
+	return mutation{
+		kind: hegel.Draw(tc, hegel.SampledFrom([]mutationKind{flipBit, setByte, truncate, insertByte, deleteByte})),
+		at:   hegel.Draw(tc, hegel.Integers(0, 65535)),
+		bit:  hegel.Draw(tc, hegel.Integers(0, 7)),
+		val:  byte(hegel.Draw(tc, hegel.Integers(0, 255))),
+	}
+})
+
+// apply returns a copy of b with the corruption and a description.
+func (m mutation) apply(b []byte) ([]byte, string) {
+	c := append([]byte{}, b...)
+	if len(c) == 0 {
+		return append(c, m.val), "append a byte to the empty stream"
+	}
+	i := m.at % len(c)
+	switch m.kind {
+	case flipBit:
+		c[i] ^= 1 << m.bit
+		return c, fmt.Sprintf("flip bit %d of byte %d", m.bit, i)
+	case setByte:
+		c[i] = m.val
+		return c, fmt.Sprintf("set byte %d to %#x", i, m.val)
+	case truncate:
+		return c[:i], fmt.Sprintf("truncate to %d bytes", i)
+	case insertByte:
+		c = append(c[:i], append([]byte{m.val}, c[i:]...)...)
+		return c, fmt.Sprintf("insert %#x at %d", m.val, i)
+	default:
+		c = append(c[:i], c[i+1:]...)
+		return c, fmt.Sprintf("delete byte %d", i)
+	}
+}
+
+func (m mutation) String() string {
+	return fmt.Sprintf("%v at %d (bit %d, value %#x)", []string{"flip bit", "set byte", "truncate", "insert", "delete"}[m.kind], m.at, m.bit, m.val)
+}
+
+func verdict(err error) string {
+	if err == nil {
+		return "accepted"
+	}
+	return "rejected (" + err.Error() + ")"
+}
+
+var formats = hegel.SampledFrom([]string{"flate", "gzip", "zlib"})
+
+// compressWith writes data as a flate, gzip or zlib stream at the level with
+// the standard library's writer (std) or klauspost's.
+func compressWith(format string, std bool, level int, data []byte) ([]byte, error) {
+	var b bytes.Buffer
+	var w io.WriteCloser
+	var err error
+	switch {
+	case format == "flate" && std:
+		w, err = stdflate.NewWriter(&b, level)
+	case format == "flate":
+		w, err = flate.NewWriter(&b, level)
+	case format == "gzip" && std:
+		w, err = stdgzip.NewWriterLevel(&b, level)
+	case format == "gzip":
+		w, err = gzip.NewWriterLevel(&b, level)
+	case std:
+		w, err = stdzlib.NewWriterLevel(&b, level)
+	default:
+		w, err = zlib.NewWriterLevel(&b, level)
+	}
+	if err != nil {
+		return nil, err
+	}
+	w.Write(data)
+	w.Close()
+	return b.Bytes(), nil
+}
+
+// readBoth reads a flate, gzip or zlib stream with the standard library's
+// reader and klauspost's.
+func readBoth(format string, stream []byte) (sGot []byte, sErr error, kGot []byte, kErr error) {
+	read := func(open func() (io.Reader, error)) ([]byte, error) {
+		r, err := open()
+		if err != nil {
+			return nil, err
+		}
+		return io.ReadAll(r)
+	}
+	switch format {
+	case "flate":
+		sGot, sErr = read(func() (io.Reader, error) { return stdflate.NewReader(bytes.NewReader(stream)), nil })
+		kGot, kErr = read(func() (io.Reader, error) { return flate.NewReader(bytes.NewReader(stream)), nil })
+	case "gzip":
+		sGot, sErr = read(func() (io.Reader, error) { return stdgzip.NewReader(bytes.NewReader(stream)) })
+		kGot, kErr = read(func() (io.Reader, error) { return gzip.NewReader(bytes.NewReader(stream)) })
+	default:
+		sGot, sErr = read(func() (io.Reader, error) { return stdzlib.NewReader(bytes.NewReader(stream)) })
+		kGot, kErr = read(func() (io.Reader, error) { return zlib.NewReader(bytes.NewReader(stream)) })
+	}
+	return
+}
+
+// truncatedMatchShape names compress/3 when the standard library reports a
+// raw deflate stream as cut short and klauspost accepts it (a clean end on a
+// stream cut inside a match); "" otherwise.
+func truncatedMatchShape(format string, sErr, kErr error) string {
+	if format == "flate" && errors.Is(sErr, io.ErrUnexpectedEOF) && kErr == nil {
+		return "compress/3"
+	}
+	return ""
+}
+
+func writerName(std bool) string {
+	if std {
+		return "stdlib"
+	}
+	return "klauspost"
+}
+
+// corruptCase: a stream of the format from either writer at the level, and
+// the corruption applied to it.
+type corruptCase struct {
+	data   dataSpec
+	level  int
+	format string
+	std    bool
+	mut    mutation
+}
+
+var corruptCases = hegel.Composite(func(tc hegel.TestCase) corruptCase {
+	return corruptCase{data: hegel.Draw(tc, smallDataSpecs), level: hegel.Draw(tc, levels), format: hegel.Draw(tc, formats), std: hegel.Draw(tc, hegel.Booleans()), mut: hegel.Draw(tc, mutations)}
+})
+
+func (c corruptCase) GoString() string {
+	return fmt.Sprintf("%s stream (level %d, %s writer) of %v: %v", c.format, c.level, writerName(c.std), c.data, c.mut)
+}
+
+// A flate, gzip or zlib stream with one corruption gets the same verdict
+// from klauspost's reader and the standard library's, and the same output
+// when both accept it.
+func TestHegelCorruptStreamsGetTheSameVerdictAsStdlib(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, corruptCases)
+		data := c.data.bytes()
+		clean, err := compressWith(c.format, c.std, c.level, data)
+		if err != nil {
+			fail(ht, "writer: %v", err)
+		}
+		stream, how := c.mut.apply(clean)
+		note(ht, "%s -> %s", how, short(stream))
+
+		sGot, sErr, kGot, kErr := readBoth(c.format, stream)
+		if c.format == "gzip" && len(stream) > 3 && stream[3]&0xe0 != 0 && sErr == nil && errors.Is(kErr, gzip.ErrHeader) {
+			// A reserved FLG bit (RFC 1952 2.3.1.2: bits 5-7 must be zero):
+			// klauspost refuses the header, compress/gzip ignores the bits and
+			// reads the member. The specification is on klauspost's side; the
+			// oracle's leniency is tolerated (a verdict, not a skip).
+			note(ht, "reserved FLG bit %#x: klauspost refuses the header, compress/gzip ignores it (tolerated)", stream[3]&0xe0)
+			return
+		}
+		if (sErr == nil) != (kErr == nil) {
+			mismatch(ht, truncatedMatchShape(c.format, sErr, kErr), "%s verdicts differ after %q: stdlib %s, klauspost %s\n stream %s", c.format, how, verdict(sErr), verdict(kErr), short(stream))
+		}
+		if sErr == nil && !bytes.Equal(sGot, kGot) {
+			fail(ht, "%s outputs differ after %q: %s", c.format, how, diffAt(sGot, kGot))
+		}
+	})
+}
+
+// cliQuickSpec: a frame from the tool at a level 1-19, checksummed or not.
+type cliQuickSpec struct {
+	level   int
+	noCheck bool
+}
+
+func (q cliQuickSpec) args() []string {
+	args := []string{fmt.Sprintf("-%d", q.level)}
+	if q.noCheck {
+		args = append(args, "--no-check")
+	}
+	return args
+}
+
+// zstdSource is where the frame of a corruption case comes from: klauspost's
+// EncodeAll under random options (with zero frames, so that empty data has a
+// frame to corrupt), or the reference tool.
+type zstdSource struct {
+	enc *encoderSpec
+	cli *cliQuickSpec
+}
+
+var zstdSources = hegel.OneOf(
+	hegel.Map(plainEncoderSpecs, func(e encoderSpec) zstdSource { e.zeroFrames = true; return zstdSource{enc: &e} }),
+	hegel.Map(hegel.Composite(func(tc hegel.TestCase) cliQuickSpec {
+		return cliQuickSpec{level: hegel.Draw(tc, hegel.Integers(1, 19)), noCheck: hegel.Draw(tc, chance(30))}
+	}), func(q cliQuickSpec) zstdSource { return zstdSource{cli: &q} }),
+)
+
+func (s zstdSource) String() string {
+	if s.cli != nil {
+		return "zstd " + strings.Join(s.cli.args(), " ")
+	}
+	return "EncodeAll " + s.enc.String()
+}
+
+// zstdCorruptCase: a frame of the data from the source, and the corruption.
+type zstdCorruptCase struct {
+	data dataSpec
+	src  zstdSource
+	mut  mutation
+}
+
+var zstdCorruptCases = hegel.Composite(func(tc hegel.TestCase) zstdCorruptCase {
+	return zstdCorruptCase{data: hegel.Draw(tc, smallDataSpecs), src: hegel.Draw(tc, zstdSources), mut: hegel.Draw(tc, mutations)}
+})
+
+func (c zstdCorruptCase) GoString() string {
+	return fmt.Sprintf("frame from %v of %v: %v", c.src, c.data, c.mut)
+}
+
+// A zstd frame with one corruption that klauspost's Decoder accepts is
+// accepted by the reference tool with the same output (klauspost is never
+// more lenient than the reference), and DecodeAll and the streaming reader
+// agree with each other.  The reference tool is itself lenient about a few
+// things the specification forbids (reserved bits, padding bits, a frame
+// content size that does not match), so it accepting what klauspost rejects
+// is not compared.
+func TestHegelCorruptFramesAcceptedByKlauspostAreAcceptedByReferenceTool(t *testing.T) {
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zstdCorruptCases)
+		data := c.data.bytes()
+		var frame []byte
+		var err error
+		if c.src.cli != nil {
+			frame, err = zstdCLIFile(t, dir, data, c.src.cli.args()...)
+			if err != nil {
+				fail(ht, "reference zstd: %v", err)
+			}
+		} else {
+			enc, err := zstd.NewWriter(nil, c.src.enc.options(nil)...)
+			if err != nil {
+				fail(ht, "NewWriter: %v", err)
+			}
+			frame = enc.EncodeAll(data, nil)
+			enc.Close()
+		}
+		stream, how := c.mut.apply(frame)
+		note(ht, "%s -> %s", how, short(stream))
+		// Empty input: no frames at all. The tool calls it an unexpected end of
+		// file, klauspost returns nothing without error (as the standard
+		// library's readers do for an empty io.Reader). Not compared.
+		ht.Assume(len(stream) > 0)
+
+		// Both decoders under the same window cap: klauspost's default is
+		// zstd.MaxWindowSize (512 MiB, WithDecoderMaxWindow), the tool's 128 MiB
+		// (its --memory default), so a corrupted Window_Descriptor asking for a
+		// window in between (a valid frame, tiny content) is "Frame requires
+		// too much memory for decoding" for the tool while klauspost decodes it:
+		// a resource limit, not a verdict on the frame.
+		cliGot, cliErr := zstdCLI(t, stream, "-d", "-c", "-q", fmt.Sprintf("--memory=%d", zstd.MaxWindowSize))
+		dec, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(1))
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		defer dec.Close()
+		kGot, kErr := dec.DecodeAll(stream, nil)
+		if err := dec.Reset(bytes.NewReader(stream)); err != nil {
+			fail(ht, "Reset: %v", err)
+		}
+		sGot, sErr := io.ReadAll(dec)
+		if (kErr == nil) != (sErr == nil) {
+			fail(ht, "DecodeAll %s but the streaming Decoder %s after %q\n stream %s", verdict(kErr), verdict(sErr), how, short(stream))
+		}
+		if kErr == nil && !bytes.Equal(kGot, sGot) {
+			fail(ht, "DecodeAll and the streaming Decoder disagree after %q: %s", how, diffAt(kGot, sGot))
+		}
+		if kErr != nil {
+			note(ht, "klauspost rejects (%v); reference %s", kErr, verdict(cliErr))
+			return
+		}
+		if cliErr != nil {
+			fail(ht, "klauspost accepts a frame the reference tool rejects after %q: %v\n stream %s", how, cliErr, short(stream))
+		}
+		if !bytes.Equal(cliGot, kGot) {
+			fail(ht, "outputs differ after %q: %s", how, diffAt(cliGot, kGot))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Properties: S2 / Snappy.
+
+// blockEncoders: the S2 and Snappy block encoders; the last three write
+// Snappy-compatible blocks.
+var blockEncoders = []string{"s2.Encode", "s2.EncodeBetter", "s2.EncodeBest", "s2.EncodeSnappy", "s2.EncodeSnappyBetter", "snappy.Encode"}
+
+func encodeBlock(name string, data []byte) []byte {
+	switch name {
+	case "s2.EncodeBetter":
+		return s2.EncodeBetter(nil, data)
+	case "s2.EncodeBest":
+		return s2.EncodeBest(nil, data)
+	case "s2.EncodeSnappy":
+		return s2.EncodeSnappy(nil, data)
+	case "s2.EncodeSnappyBetter":
+		return s2.EncodeSnappyBetter(nil, data)
+	case "snappy.Encode":
+		return snappy.Encode(nil, data)
+	}
+	return s2.Encode(nil, data)
+}
+
+func snappyCompatible(name string) bool { return strings.Contains(name, "nappy") }
+
+// dictEncoders: the Dict's block encoders.
+var dictEncoders = []string{"Encode", "EncodeBetter", "EncodeBest"}
+
+func encodeWithDict(d *s2.Dict, name string, data []byte) []byte {
+	switch name {
+	case "EncodeBetter":
+		return d.EncodeBetter(nil, data)
+	case "EncodeBest":
+		return d.EncodeBest(nil, data)
+	}
+	return d.Encode(nil, data)
+}
+
+// s2BlockCase: the data and its block encoder, a dictionary (or none) and
+// the Dict encoder for the dictionary round trip, and a second input for the
+// concatenation.
+type s2BlockCase struct {
+	data        dataSpec
+	encoder     string
+	dict        *dictSpec
+	dictEncoder string
+	other       dataSpec
+}
+
+var s2BlockCases = hegel.Composite(func(tc hegel.TestCase) s2BlockCase {
+	return s2BlockCase{
+		data:        hegel.Draw(tc, dataSpecs),
+		encoder:     hegel.Draw(tc, hegel.SampledFrom(blockEncoders)),
+		dict:        hegel.Draw(tc, dicts),
+		dictEncoder: hegel.Draw(tc, hegel.SampledFrom(dictEncoders)),
+		other:       hegel.Draw(tc, dataSpecs),
+	}
+})
+
+func (c s2BlockCase) GoString() string {
+	return fmt.Sprintf("%s of %v, %v with Dict.%s, other %v", c.encoder, c.data, c.dict, c.dictEncoder, c.other)
+}
+
+// Every S2 and Snappy block encoder's output decodes to the input with the
+// matching decoders, DecodedLen reads the right length, MaxEncodedLen bounds
+// the size, and concatenated S2 blocks decode to concatenated data.
+func TestHegelS2AndSnappyBlocksRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, s2BlockCases)
+		data := c.data.bytes()
+		name := c.encoder
+		block := encodeBlock(name, data)
+		note(ht, "block %s", short(block))
+		if len(block) > s2.MaxEncodedLen(len(data)) {
+			fail(ht, "%s produced %d bytes, MaxEncodedLen says %d", name, len(block), s2.MaxEncodedLen(len(data)))
+		}
+		if l, err := s2.DecodedLen(block); err != nil || l != len(data) {
+			fail(ht, "s2.DecodedLen = %d, %v; want %d", l, err, len(data))
+		}
+		got, err := s2.Decode(nil, block)
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "s2.Decode of %s output: %v, %s", name, err, diffAt(got, data))
+		}
+		if snappyCompatible(name) {
+			// Snappy-compatible output must decode with the Snappy decoders too.
+			got, err = snappy.Decode(nil, block)
+			if err != nil || !bytes.Equal(got, data) {
+				fail(ht, "snappy.Decode of %s output: %v, %s", name, err, diffAt(got, data))
+			}
+			got, err = snappy.DecodeStrict(nil, block)
+			if err != nil || !bytes.Equal(got, data) {
+				fail(ht, "snappy.DecodeStrict of %s output: %v, %s", name, err, diffAt(got, data))
+			}
+		}
+		// Dictionary round trip (MakeDict refuses a dictionary under 16 bytes).
+		if dict := c.dict.bytes(data); len(dict) > 0 && len(dict) <= 65536 {
+			if d := s2.MakeDict(dict, nil); d != nil {
+				db := encodeWithDict(d, c.dictEncoder, data)
+				got, err = d.Decode(nil, db)
+				if err != nil || !bytes.Equal(got, data) {
+					fail(ht, "Dict.Decode of a dictionary-encoded block: %v, %s", err, diffAt(got, data))
+				}
+			}
+		}
+		// Concatenation of two blocks.
+		if !snappyCompatible(name) {
+			other := c.other.bytes()
+			b2 := s2.Encode(nil, other)
+			cat, err := s2.ConcatBlocks(nil, block, b2)
+			if err != nil {
+				fail(ht, "ConcatBlocks: %v", err)
+			}
+			got, err = s2.Decode(nil, cat)
+			if err != nil || !bytes.Equal(got, append(append([]byte{}, data...), other...)) {
+				fail(ht, "Decode of ConcatBlocks: %v, %s", err, diffAt(got, append(append([]byte{}, data...), other...)))
+			}
+		}
+	})
+}
+
+// s2StreamCase: the data and the S2 writer's options (Snappy compatibility,
+// the compression mode, a block size as a power of two, padding, uncompressed
+// blocks), the S2 writer's chunking and the Snappy writer's.
+type s2StreamCase struct {
+	data         dataSpec
+	snappyCompat bool
+	compression  string // "", "better" or "best"
+	blockLog     *int   // WriterBlockSize(1 << blockLog); capped at 16 under Snappy compatibility
+	padding      *int
+	uncompressed bool
+	chunks       chunkPlan
+	snappyChunks chunkPlan
+}
+
+var s2StreamCases = hegel.Composite(func(tc hegel.TestCase) s2StreamCase {
+	return s2StreamCase{
+		data:         hegel.Draw(tc, dataSpecs),
+		snappyCompat: hegel.Draw(tc, chance(40)),
+		compression:  hegel.Draw(tc, hegel.SampledFrom([]string{"", "better", "best"})),
+		blockLog:     hegel.Draw(tc, optional(30, hegel.Integers(12, 20))),
+		padding:      hegel.Draw(tc, optional(30, hegel.Integers(1, 4096))),
+		uncompressed: hegel.Draw(tc, chance(30)),
+		chunks:       hegel.Draw(tc, chunkPlans),
+		snappyChunks: hegel.Draw(tc, chunkPlans),
+	}
+})
+
+// options renders the S2 writer's options (with WriterConcurrency(1) always).
+func (c s2StreamCase) options() []s2.WriterOption {
+	var wopts []s2.WriterOption
+	if c.snappyCompat {
+		wopts = append(wopts, s2.WriterSnappyCompat())
+	}
+	switch c.compression {
+	case "better":
+		wopts = append(wopts, s2.WriterBetterCompression())
+	case "best":
+		wopts = append(wopts, s2.WriterBestCompression())
+	}
+	if c.blockLog != nil {
+		// Snappy-compatible output is limited to 4 KiB..64 KiB blocks (documented).
+		log := *c.blockLog
+		if c.snappyCompat {
+			log = min(log, 16)
+		}
+		wopts = append(wopts, s2.WriterBlockSize(1<<log))
+	}
+	if c.padding != nil {
+		wopts = append(wopts, s2.WriterPadding(*c.padding))
+	}
+	if c.uncompressed {
+		wopts = append(wopts, s2.WriterUncompressed())
+	}
+	return append(wopts, s2.WriterConcurrency(1))
+}
+
+func (c s2StreamCase) GoString() string {
+	var opts []string
+	if c.snappyCompat {
+		opts = append(opts, "snappy")
+	}
+	if c.compression != "" {
+		opts = append(opts, c.compression)
+	}
+	if c.blockLog != nil {
+		opts = append(opts, fmt.Sprintf("blocklog=%d", *c.blockLog))
+	}
+	if c.padding != nil {
+		opts = append(opts, fmt.Sprintf("padding=%d", *c.padding))
+	}
+	if c.uncompressed {
+		opts = append(opts, "uncompressed")
+	}
+	return fmt.Sprintf("options [%s], data %v, chunks %v / snappy %v", strings.Join(opts, ","), c.data, c.chunks, c.snappyChunks)
+}
+
+// S2 and Snappy streams written with random chunking and flushes read back
+// to the input through the matching stream readers; a Snappy-format S2
+// stream reads with the Snappy reader.
+func TestHegelS2AndSnappyStreamsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, s2StreamCases)
+		data := c.data.bytes()
+		var b bytes.Buffer
+		w := s2.NewWriter(&b, c.options()...)
+		if err := c.chunks.write(w, data); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		stream := b.Bytes()
+		got, err := io.ReadAll(s2.NewReader(bytes.NewReader(stream)))
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "s2.Reader: %v, %s", err, diffAt(got, data))
+		}
+		if c.snappyCompat {
+			got, err = io.ReadAll(snappy.NewReader(bytes.NewReader(stream)))
+			if err != nil || !bytes.Equal(got, data) {
+				fail(ht, "snappy.Reader on a Snappy-compatible S2 stream: %v, %s", err, diffAt(got, data))
+			}
+		}
+		// The Snappy stream writer read by both readers.
+		var sb bytes.Buffer
+		sw := snappy.NewBufferedWriter(&sb)
+		if err := c.snappyChunks.write(sw, data); err != nil {
+			fail(ht, "snappy Write: %v", err)
+		}
+		if err := sw.Close(); err != nil {
+			fail(ht, "snappy Close: %v", err)
+		}
+		got, err = io.ReadAll(snappy.NewReader(bytes.NewReader(sb.Bytes())))
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "snappy.Reader on snappy's stream: %v, %s", err, diffAt(got, data))
+		}
+		got, err = io.ReadAll(s2.NewReader(bytes.NewReader(sb.Bytes())))
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "s2.Reader on snappy's stream: %v, %s", err, diffAt(got, data))
+		}
+	})
+}
