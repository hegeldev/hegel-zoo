+// A zstd frame produced by klauspost's Encoder under random options, by
+// EncodeAll or by a streaming Writer with random chunking and flushes,
+// decompresses with the reference `zstd -d` to the input, and klauspost's own
+// Decoder agrees; the frame header klauspost parses from it is consistent
+// with the options.
+func TestHegelZstdEncoderOutputDecodesWithReferenceTool(t *testing.T) {
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zstdEncodeCases)
+		data := c.data.bytes()
+		dict := c.enc.dict.bytes(t)
+		dictPath := dictFile(t, dir, dict)
+		desc := c.enc.String()
+		enc, err := zstd.NewWriter(nil, c.enc.options(dict)...)
+		if err != nil {
+			fail(ht, "NewWriter(%s): %v", desc, err)
+		}
+		defer enc.Close()
+
+		var frame []byte
+		streaming := c.mode != encodeAll
+		withSize := c.mode == streamResetContentSize
+		if streaming {
+			var b bytes.Buffer
+			if withSize {
+				enc.ResetContentSize(&b, int64(len(data)))
+			} else {
+				enc.Reset(&b)
+			}
+			if err := c.chunks.write(enc, data); err != nil {
+				fail(ht, "Write: %v", err)
+			}
+			if err := enc.Close(); err != nil {
+				fail(ht, "Close: %v", err)
+			}
+			frame = b.Bytes()
+		} else {
+			frame = enc.EncodeAll(data, nil)
+		}
+		note(ht, "frame %s", short(frame))
+
+		got, err := zstdCLI(t, frame, append([]string{"-d", "-c", "-q"}, dictArgs(dictPath)...)...)
+		if err != nil {
+			fail(ht, "reference zstd rejects klauspost's frame (%s, %v): %v\n frame %s", desc, c.mode, err, short(frame))
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "reference zstd decodes klauspost's frame differently (%s): %s", desc, diffAt(got, data))
+		}
+
+		dopts := append([]zstd.DOption{zstd.WithDecoderConcurrency(1)}, c.enc.dict.decoderOptions(dict)...)
+		dec, err := zstd.NewReader(nil, dopts...)
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		defer dec.Close()
+		back, err := dec.DecodeAll(frame, nil)
+		if err != nil || !bytes.Equal(back, data) {
+			fail(ht, "klauspost's own Decoder on its frame (%s): %v, %s", desc, err, diffAt(back, data))
+		}
+
+		if len(frame) == 0 {
+			return // no frame (zero frames off), nothing more to check; not reached while they are on by default
+		}
+		var h zstd.Header
+		if err := h.Decode(frame); err != nil {
+			fail(ht, "Header.Decode on klauspost's frame: %v", err)
+		}
+		if h.Skippable {
+			fail(ht, "Header says skippable for a data frame")
+		}
+		if re, err := h.AppendTo(nil); err != nil || !bytes.Equal(re, frame[:h.HeaderSize]) {
+			fail(ht, "Header.AppendTo re-encodes klauspost's header %x as %x (%v)", frame[:h.HeaderSize], re, err)
+		}
+		if h.HasCheckSum == c.enc.noCRC {
+			// compress/4: the canned empty frame of EncodeAll (zero frames are on
+			// by default) carries no checksum whatever WithEncoderCRC says.
+			shape := ""
+			if len(data) == 0 && !streaming {
+				shape = "compress/4"
+			}
+			mismatch(ht, shape, "Header.HasCheckSum = %v for options %s", h.HasCheckSum, desc)
+		}
+		if !streaming && len(data) > 0 && c.enc.singleSegment && !h.SingleSegment {
+			fail(ht, "EncodeAll with WithSingleSegment wrote a frame without the single-segment flag (%s)", desc)
+		}
+		if (!streaming && len(data) > 0 || withSize) && h.HasFCS && h.FrameContentSize != uint64(len(data)) {
+			fail(ht, "Header.FrameContentSize = %d for %d bytes (%s)", h.FrameContentSize, len(data), desc)
+		}
+		if len(data) > 0 && !streaming && len(data) >= 256 && !h.HasFCS {
+			fail(ht, "EncodeAll of %d bytes wrote no Frame_Content_Size (%s)", len(data), desc)
+		}
+	})
+}
