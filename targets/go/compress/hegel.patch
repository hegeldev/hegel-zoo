+// dictFile writes the dictionary to dir for the tool and returns its path
+// ("" for no dictionary).
+func dictFile(t testing.TB, dir string, dict []byte) string {
+	if dict == nil {
+		return ""
+	}
+	path := filepath.Join(dir, "dict")
+	if err := os.WriteFile(path, dict, 0o644); err != nil {
+		t.Fatalf("write dict: %v", err)
+	}
+	return path
+}
