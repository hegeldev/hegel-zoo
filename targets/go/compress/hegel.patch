+// ---------------------------------------------------------------------------
+// Pins.  Each records one difference found while writing the properties
+// above; they are listed in targets/go/compress/bugs.toml and expected to
+// fail until fixed upstream.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// compress/1: a gzip Header with the zero ModTime is written as MTIME
+// 0xFFFFFFFF-ish wrap-around of time.Time{}.Unix() (the year 2042) instead
+// of 0 ("no time stamp is available", RFC 1952 §2.3.1), which is what
+// compress/gzip writes and what compress/gzip then reads back as a real date.
+func TestHegelPinZeroModTimeIsWrittenAsZero(t *testing.T) {
+	defer guard(t)
+	var b bytes.Buffer
+	w := gzip.NewWriter(&b)
+	w.Write([]byte("x"))
+	w.Close()
+	mtime := b.Bytes()[4:8]
+	if !bytes.Equal(mtime, []byte{0, 0, 0, 0}) {
+		t.Fatalf("MTIME bytes %x for a zero ModTime; want 00000000", mtime)
+	}
+	r, err := stdgzip.NewReader(bytes.NewReader(b.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !r.ModTime.IsZero() {
+		t.Fatalf("compress/gzip reads ModTime %v from the stream", r.ModTime)
+	}
+}
+
+// compress/3: a raw deflate stream cut off inside a match (after the length
+// code, before the distance code or its extra bits is complete) is reported
+// as a clean end of stream: Read returns io.EOF, so the truncation goes
+// unnoticed; compress/flate returns io.ErrUnexpectedEOF, as it does for every
+// other truncation point (and so does klauspost for the other points).
+func TestHegelPinTruncatedStreamIsAnUnexpectedEOF(t *testing.T) {
+	defer guard(t)
+	var b bytes.Buffer
+	w, _ := stdflate.NewWriter(&b, 6)
+	w.Write(bytes.Repeat([]byte("hello world "), 50))
+	w.Close()
+	full := b.Bytes() // 21 bytes
+	for cut := len(full) - 1; cut >= 1; cut-- {
+		got, err := io.ReadAll(flate.NewReader(bytes.NewReader(full[:cut])))
+		if err == nil {
+			t.Fatalf("stream %x truncated to %d bytes decodes to %d bytes with a nil error; compress/flate: %v",
+				full, cut, len(got), func() error { _, e := io.ReadAll(stdflate.NewReader(bytes.NewReader(full[:cut]))); return e }())
+		}
+	}
+}
+
+// compress/4: EncodeAll of an empty input with WithZeroFrames(true) writes a
+// canned frame without a content checksum although WithEncoderCRC is on (the
+// default); the streaming Encoder's empty frame and the reference tool both
+// carry the checksum (28b52ffd 04 68 01000099e9d851 / 28b52ffd 24 00 010000 99e9d851).
+func TestHegelPinZeroFrameCarriesTheChecksum(t *testing.T) {
+	defer guard(t)
+	enc, err := zstd.NewWriter(nil, zstd.WithZeroFrames(true), zstd.WithEncoderCRC(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enc.Close()
+	frame := enc.EncodeAll(nil, nil)
+	var h zstd.Header
+	if err := h.Decode(frame); err != nil {
+		t.Fatal(err)
+	}
+	if !h.HasCheckSum {
+		t.Fatalf("zero frame %x has no checksum with WithEncoderCRC(true)", frame)
+	}
+}
+
+// compress/2: reading a member whose MTIME field is 0 gives ModTime
+// 1970-01-01T00:00:00Z instead of the zero time.Time compress/gzip returns
+// (MTIME 0 means "not set").
+func TestHegelPinZeroMTimeReadsAsZeroTime(t *testing.T) {
+	defer guard(t)
+	var b bytes.Buffer
+	w := stdgzip.NewWriter(&b) // zero ModTime -> MTIME 0
+	w.Write([]byte("x"))
+	w.Close()
+	r, err := gzip.NewReader(bytes.NewReader(b.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !r.ModTime.IsZero() {
+		t.Fatalf("ModTime = %v for MTIME 0; want the zero time", r.ModTime)
+	}
+}
