+// A zlib stream written by klauspost (levels, optional dictionary) inflates
+// with compress/zlib and vice versa; a stream needing a dictionary is
+// refused without it by both.
+func TestHegelZlibInteroperatesWithStdlib(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zlibCases)
+		data := c.data.bytes()
+		dict := c.dict.bytes(data)
+		level := c.level
+
+		var kb bytes.Buffer
+		w, err := zlib.NewWriterLevelDict(&kb, level, dict)
+		if err != nil {
+			fail(ht, "NewWriterLevelDict(%d): %v", level, err)
+		}
+		if err := c.kChunks.write(w, data); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		sr, err := stdzlib.NewReaderDict(bytes.NewReader(kb.Bytes()), dict)
+		if err != nil {
+			fail(ht, "compress/zlib cannot open klauspost's stream: %v", err)
+		}
+		got, err := io.ReadAll(sr)
+		if err != nil {
+			fail(ht, "compress/zlib cannot read klauspost's stream: %v", err)
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "compress/zlib reads klauspost's stream differently: %s", diffAt(got, data))
+		}
+
+		var sb bytes.Buffer
+		sw, err := stdzlib.NewWriterLevelDict(&sb, stdLevel(level, dict), dict)
+		if err != nil {
+			fail(ht, "compress/zlib NewWriterLevelDict(%d): %v", level, err)
+		}
+		if err := c.sChunks.write(sw, data); err != nil {
+			fail(ht, "compress/zlib Write: %v", err)
+		}
+		if err := sw.Close(); err != nil {
+			fail(ht, "compress/zlib Close: %v", err)
+		}
+		kr, err := zlib.NewReaderDict(bytes.NewReader(sb.Bytes()), dict)
+		if err != nil {
+			fail(ht, "klauspost cannot open compress/zlib's stream: %v", err)
+		}
+		got, err = io.ReadAll(kr)
+		if err != nil {
+			fail(ht, "klauspost cannot read compress/zlib's stream: %v", err)
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "klauspost reads compress/zlib's stream differently: %s", diffAt(got, data))
+		}
+
+		if len(dict) > 0 {
+			// without the dictionary both must refuse the stream
+			_, ke := zlib.NewReader(bytes.NewReader(sb.Bytes()))
+			_, se := stdzlib.NewReader(bytes.NewReader(kb.Bytes()))
+			if (ke == nil) != (se == nil) {
+				fail(ht, "missing-dictionary verdicts differ: klauspost %v, compress/zlib %v", ke, se)
+			}
+		}
+	})
+}
