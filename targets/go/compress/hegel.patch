+
+// trainDict builds one zstd dictionary with the reference tool from fixed
+// text samples (the training is deterministic for fixed input), so cases
+// can use a dictionary both sides know.
+func trainDict(t testing.TB) []byte {
+	trainedOnce.Do(func() {
+		dir, err := os.MkdirTemp("", "hegel-zstd-dict")
+		if err != nil {
+			t.Fatalf("MkdirTemp: %v", err)
+		}
+		defer os.RemoveAll(dir)
+		r := rand.New(rand.NewSource(7))
+		args := []string{"-q", "--train", "--maxdict=8192", "-o", filepath.Join(dir, "dict")}
+		for i := 0; i < 40; i++ {
+			p := filepath.Join(dir, fmt.Sprintf("s%d", i))
+			if err := os.WriteFile(p, fill(r, kindText, 2000+r.Intn(3000)), 0o644); err != nil {
+				t.Fatalf("write sample: %v", err)
+			}
+			args = append(args, p)
+		}
+		out, err := exec.Command(zstdPath(t), args...).CombinedOutput()
+		if err != nil {
+			t.Fatalf("zstd --train: %v: %s", err, out)
+		}
+		trainedDict, err = os.ReadFile(filepath.Join(dir, "dict"))
+		if err != nil {
+			t.Fatalf("read dict: %v", err)
+		}
+	})
+	return trainedDict
+}
+
+// zstdDict is a case's zstd dictionary: none, the trained dictionary, or raw
+// content (registered with ID 0, which is what the reference tool uses for
+// raw content) filled from a seed.
+type zstdDict struct {
+	kind zstdDictKind
+	seed int64
+	fill dataKind
+	size int
+}
+
+type zstdDictKind int
+
+const (
+	dictNone zstdDictKind = iota
+	dictTrained
+	dictRaw
+)
+
+// bytes is the dictionary's content (nil for none).
+func (d zstdDict) bytes(t testing.TB) []byte {
+	switch d.kind {
+	case dictTrained:
+		return trainDict(t)
+	case dictRaw:
+		return fill(rand.New(rand.NewSource(d.seed)), d.fill, d.size)
+	}
+	return nil
+}
+
+// encoderOptions registers the dictionary with an Encoder.
+func (d zstdDict) encoderOptions(dict []byte) []zstd.EOption {
+	switch d.kind {
+	case dictTrained:
+		return []zstd.EOption{zstd.WithEncoderDict(dict)}
+	case dictRaw:
+		return []zstd.EOption{zstd.WithEncoderDictRaw(0, dict)}
+	}
+	return nil
+}
+
+// decoderOptions registers the dictionary with a Decoder.
+func (d zstdDict) decoderOptions(dict []byte) []zstd.DOption {
+	switch d.kind {
+	case dictTrained:
+		return []zstd.DOption{zstd.WithDecoderDicts(dict)}
+	case dictRaw:
+		return []zstd.DOption{zstd.WithDecoderDictRaw(0, dict)}
+	}
+	return nil
+}
