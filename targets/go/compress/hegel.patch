+func (d zstdDict) String() string {
+	switch d.kind {
+	case dictTrained:
+		return "traineddict"
+	case dictRaw:
+		return fmt.Sprintf("rawdict(%d %s, seed %d)", d.size, kindNames[d.fill], d.seed)
+	}
+	return "nodict"
+}
