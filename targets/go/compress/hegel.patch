+// dictArgs is the tool's flag for the dictionary (none for no dictionary).
+func dictArgs(path string) []string {
+	if path == "" {
+		return nil
+	}
+	return []string{"-D", path}
+}
+
+// encoderSpec is klauspost's Encoder configuration as drawn; options renders
+// it (with WithEncoderConcurrency(1) always). zeroFrames passes
+// WithZeroFrames(true), which is the default at this commit, so EncodeAll of
+// no data writes the canned empty frame with or without it.
+type encoderSpec struct {
+	level         zstd.EncoderLevel
+	noCRC         bool
+	dict          zstdDict
+	zeroFrames    bool
+	singleSegment bool
+	windowLog     *int // WithWindowSize(1 << windowLog)
+	noEntropy     bool
+	allLitEntropy bool
+	padding       *int
+	lowMem        bool
+}
+
+func (e encoderSpec) options(dict []byte) []zstd.EOption {
+	opts := []zstd.EOption{zstd.WithEncoderLevel(e.level), zstd.WithEncoderConcurrency(1)}
+	if e.noCRC {
+		opts = append(opts, zstd.WithEncoderCRC(false))
+	}
+	opts = append(opts, e.dict.encoderOptions(dict)...)
+	if e.zeroFrames {
+		opts = append(opts, zstd.WithZeroFrames(true))
+	}
+	if e.singleSegment {
+		opts = append(opts, zstd.WithSingleSegment(true))
+	}
+	if e.windowLog != nil {
+		opts = append(opts, zstd.WithWindowSize(1<<*e.windowLog))
+	}
+	if e.noEntropy {
+		opts = append(opts, zstd.WithNoEntropyCompression(true))
+	}
+	if e.allLitEntropy {
+		opts = append(opts, zstd.WithAllLitEntropyCompression(true))
+	}
+	if e.padding != nil {
+		opts = append(opts, zstd.WithEncoderPadding(*e.padding))
+	}
+	if e.lowMem {
+		opts = append(opts, zstd.WithLowerEncoderMem(true))
+	}
+	return opts
+}
+
+func (e encoderSpec) String() string {
+	desc := []string{e.level.String()}
+	if e.noCRC {
+		desc = append(desc, "nocrc")
+	}
+	desc = append(desc, e.dict.String())
+	if e.zeroFrames {
+		desc = append(desc, "zeroframes")
+	}
+	if e.singleSegment {
+		desc = append(desc, "singlesegment")
+	}
+	if e.windowLog != nil {
+		desc = append(desc, fmt.Sprintf("window=%d", 1<<*e.windowLog))
+	}
+	if e.noEntropy {
+		desc = append(desc, "noentropy")
+	}
+	if e.allLitEntropy {
+		desc = append(desc, "alllitentropy")
+	}
+	if e.padding != nil {
+		desc = append(desc, fmt.Sprintf("padding=%d", *e.padding))
+	}
+	if e.lowMem {
+		desc = append(desc, "lowmem")
+	}
+	return strings.Join(desc, ",")
+}
+
+// encoderSpecs: the level, the checksum off 30% of the time, a dictionary
+// from dictGen, and each of the other options 20-30% of the time.
+func encoderSpecs(dictGen hegel.Generator[zstdDict]) hegel.Generator[encoderSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) encoderSpec {
+		return encoderSpec{
+			level:         hegel.Draw(tc, zstdLevels),
+			noCRC:         hegel.Draw(tc, chance(30)),
+			dict:          hegel.Draw(tc, dictGen),
+			zeroFrames:    hegel.Draw(tc, chance(30)),
+			singleSegment: hegel.Draw(tc, chance(30)),
+			windowLog:     hegel.Draw(tc, optional(30, hegel.Integers(10, 22))),
+			noEntropy:     hegel.Draw(tc, chance(20)),
+			allLitEntropy: hegel.Draw(tc, chance(20)),
+			padding:       hegel.Draw(tc, optional(20, hegel.Integers(1, 64))),
+			lowMem:        hegel.Draw(tc, chance(20)),
+		}
+	})
+}
