+func genColorString(tc hegel.TestCase) string {
+	switch n(tc, 0, 2) {
+	case 0:
+		return genRGBHex(tc, true)
+	case 1:
+		return strconv.Itoa(n(tc, 0, 255))
+	default:
+		return pick(tc, []string{"", "red", "#abcd"})
+	}
+}
