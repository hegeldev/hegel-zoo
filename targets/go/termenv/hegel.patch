+// ---------------------------------------------------------------- template helpers
+
+// tplSpec: a template calling one helper: an attribute helper, Foreground or Background with a
+// colour string, or Color with a foreground and a background string.
+type tplSpec struct {
+	helper  string
+	colours []string
+}
+
+// source is the template text over the given text.
+func (s tplSpec) source(text string) string {
+	var sb strings.Builder
+	sb.WriteString("{{ " + s.helper)
+	for _, c := range s.colours {
+		fmt.Fprintf(&sb, " %q", c)
+	}
+	fmt.Fprintf(&sb, " %q }}", text)
+	return sb.String()
+}
+
+// isBackground reports whether the i-th colour string is a background.
+func (s tplSpec) isBackground(i int) bool { return s.helper == "Background" || i == 1 }
+
+// params are the SGR parameters the helper adds in the profile by the table (a string naming
+// no colour adds nothing).
+func (s tplSpec) params(p termenv.Profile) []string {
+	if code, ok := attrCodes[s.helper]; ok {
+		return []string{code}
+	}
+	var params []string
+	for i, cs := range s.colours {
+		if c := p.Color(cs); c != nil {
+			params = append(params, seqOf(c, s.isBackground(i)))
+		}
+	}
+	return params
+}
+
+// shapes names termenv/2 when a colour string is an RGB colour of the profile with a
+// truncated channel.
+func (s tplSpec) shapes(p termenv.Profile) []string {
+	for _, cs := range s.colours {
+		if truncatedRGB(p.Color(cs)) {
+			return []string{"termenv/2"}
+		}
+	}
+	return nil
+}
+
+var (
+	// colourStrings: a hex colour, a number 0-255 or a string naming no colour, as often as
+	// each other.
+	colourStrings = hegel.OneOf(
+		seqHexes,
+		hegel.Map(channels, strconv.Itoa),
+		hegel.SampledFrom([]string{"", "red", "#abcd"}),
+	)
+	tplSpecs = hegel.OneOf(
+		hegel.Map(hegel.SampledFrom(attrNames), func(name string) tplSpec { return tplSpec{helper: name} }),
+		hegel.Map(colourStrings, func(c string) tplSpec { return tplSpec{"Foreground", []string{c}} }),
+		hegel.Map(colourStrings, func(c string) tplSpec { return tplSpec{"Background", []string{c}} }),
+		hegel.Map(many(colourStrings, 2, 2), func(cs []string) tplSpec { return tplSpec{"Color", cs} }),
+	)
+	tplTexts = hegel.SampledFrom([]string{"x", "hello", "日本"})
+)
+
+// tplCase: a template in a profile over a text.
+type tplCase struct {
+	p    termenv.Profile
+	text string
+	tpl  tplSpec
+}
+
+func (c tplCase) GoString() string {
+	return fmt.Sprintf("%s template %s", c.p.Name(), c.tpl.source(c.text))
+}
+
+var tplCases = hegel.Composite(func(tc hegel.TestCase) tplCase {
+	return tplCase{p: hegel.Draw(tc, profileGen), text: hegel.Draw(tc, tplTexts), tpl: hegel.Draw(tc, tplSpecs)}
+})
+
+func TestHegelTemplateHelpersRenderStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tplCases)
+		src := c.tpl.source(c.text)
+		tmpl, err := template.New("t").Funcs(termenv.TemplateFuncs(c.p)).Parse(src)
+		if err != nil {
+			fail(ht, "parse %s: %v", src, err)
+		}
+		var buf bytes.Buffer
+		if err := tmpl.Execute(&buf, nil); err != nil {
+			fail(ht, "execute %s: %v", src, err)
+		}
+		if got, want := buf.String(), styledModel(c.p, c.tpl.params(c.p), c.text); got != want {
+			mismatch(ht, c.tpl.shapes(c.p), "%s %s = %q, want %q", c.p.Name(), src, got, want)
+		}
+	})
+}
+
+// ---------------------------------------------------------------- the terminal's colours
+
+type fakeEnv map[string]string
+
+func (e fakeEnv) Environ() []string {
+	var out []string
+	for k, v := range e {
+		out = append(out, k+"="+v)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (e fakeEnv) Getenv(k string) string { return e[k] }
+
+// fakeTTY answers the OSC 10/11 and cursor-position queries with a canned reply.
+type fakeTTY struct {
+	in  *bytes.Buffer
+	out bytes.Buffer
+}
+
+func (f *fakeTTY) Read(p []byte) (int, error)  { return f.in.Read(p) }
+func (f *fakeTTY) Write(p []byte) (int, error) { return f.out.Write(p) }
+func (f *fakeTTY) Fd() uintptr                 { return 0 }
+
+func newOutput(reply string, env fakeEnv) (*termenv.Output, *fakeTTY) {
+	f := &fakeTTY{in: bytes.NewBufferString(reply)}
+	return termenv.NewOutput(f, termenv.WithUnsafe(), termenv.WithTTY(true), termenv.WithEnvironment(env)), f
+}
+
+// x11Colour reads an X11 colour spec as a terminal answers OSC 10/11: rgb:<r>/<g>/<b> or
+// rgba:<r>/<g>/<b>/<a>, each component one to four hex digits of which the top byte is the
+// channel (a single digit doubled). The second result is false for anything else.
+func x11Colour(body string) (termenv.RGBColor, bool) {
+	comps := 3
+	rest, ok := strings.CutPrefix(body, "rgb:")
+	if !ok {
+		rest, ok = strings.CutPrefix(body, "rgba:")
+		comps = 4
+	}
+	if !ok {
+		return "", false
+	}
+	h := strings.Split(rest, "/")
+	if len(h) != comps {
+		return "", false
+	}
+	var ch [3]int
+	for i, c := range h {
+		if len(c) < 1 || len(c) > 4 {
+			return "", false
+		}
+		v, err := strconv.ParseUint(c, 16, 16)
+		if err != nil {
+			return "", false
+		}
+		if i < 3 {
+			if len(c) == 1 {
+				ch[i] = int(v) * 17
+			} else {
+				ch[i] = int(v) >> (4 * (len(c) - 2))
+			}
+		}
+	}
+	return termenv.RGBColor(hexOf(ch[0], ch[1], ch[2])), true
+}
+
+// parserPanics reports whether xTermColor, given garbage after "rgb:" of the length it
+// accepts, panics: fewer than three components, or one of the first three shorter than two
+// characters (termenv/6).
+func parserPanics(garbage string) bool {
+	h := strings.Split(garbage, "/")
+	return len(h) < 3 || len(h[0]) < 2 || len(h[1]) < 2 || len(h[2]) < 2
+}
+
+type answerKind int
+
+const (
+	noAnswer      answerKind = iota // only the cursor reply follows the query
+	rgbAnswer                       // rgb:<r>/<g>/<b> of the colour, widths hex digits per component
+	rgbaAnswer                      // rgba:<rrrr>/<gggg>/<bbbb>/<alpha>
+	garbageAnswer                   // rgb: followed by garbage
+)
+
+// answer: what the terminal says to the OSC 10/11 query. Four-digit components are what every
+// real terminal sends; one to three digits are valid X11 too, and rgba: replies exist
+// (termenv/7); garbage of the length the parser accepts panics it or is read as a colour
+// (termenv/6, termenv/7).
+type answer struct {
+	kind    answerKind
+	widths  [3]int
+	alpha   string
+	garbage string
+}
+
+// body renders the answer's text after the OSC number and semicolon ("" for no answer).
+func (a answer) body(c rgb) string {
+	comp := func(v, width int) string {
+		if width == 1 {
+			return fmt.Sprintf("%x", v>>4)
+		}
+		return fmt.Sprintf("%02x%02x", v, v)[:width]
+	}
+	switch a.kind {
+	case rgbAnswer:
+		return fmt.Sprintf("rgb:%s/%s/%s", comp(c.r, a.widths[0]), comp(c.g, a.widths[1]), comp(c.b, a.widths[2]))
+	case rgbaAnswer:
+		return fmt.Sprintf("rgba:%s/%s/%s/%s", comp(c.r, 4), comp(c.g, 4), comp(c.b, 4), a.alpha)
+	case garbageAnswer:
+		return "rgb:" + a.garbage
+	}
+	return ""
+}
+
+// shapes names the recorded bugs the answer has the shape of: a component of fewer than
+// four digits or an rgba: reply, which the parser rejects by length (termenv/7); garbage of
+// the accepted length (14 or 15 characters), which panics the parser (termenv/6) or is read as
+// a colour (termenv/7) unless it happens to be valid X11.
+func (a answer) shapes() []string {
+	switch a.kind {
+	case rgbAnswer:
+		return shapeIf(a.widths != [3]int{4, 4, 4}, "termenv/7")
+	case rgbaAnswer:
+		return []string{"termenv/7"}
+	case garbageAnswer:
+		if _, ok := x11Colour(a.body(rgb{})); ok || len(a.garbage) < 14 || len(a.garbage) > 15 {
+			return nil
+		}
+		if parserPanics(a.garbage) {
+			return []string{"termenv/6"}
+		}
+		return []string{"termenv/7"}
+	}
+	return nil
+}
+
+var (
+	fourDigits   = [3]int{4, 4, 4}
+	noAnswers    = hegel.Just(answer{})
+	widthOptions = hegel.SampledFrom([]int{4, 1, 2, 3})
+	anyWidths    = hegel.Composite(func(tc hegel.TestCase) [3]int {
+		return [3]int{hegel.Draw(tc, widthOptions), hegel.Draw(tc, widthOptions), hegel.Draw(tc, widthOptions)}
+	})
+	// replyWidths: four digits per component seven times in ten, else one to four each; under
+	// HEGEL_NO_KNOWN=1 always four (termenv/7).
+	replyWidths = shaped(weighted(choice[[3]int]{70, hegel.Just(fourDigits)}, choice[[3]int]{30, anyWidths}), hegel.Just(fourDigits))
+	rgbAnswers  = hegel.Map(replyWidths, func(w [3]int) answer { return answer{kind: rgbAnswer, widths: w} })
+	rgbaAnswers = hegel.Map(hexText(4), func(alpha string) answer { return answer{kind: rgbaAnswer, alpha: alpha} })
+	// garbageAnswers: rgb: and 14 or 15 hex digits and slashes, the length the parser accepts
+	// (termenv/6, termenv/7); under HEGEL_NO_KNOWN=1 up to 13 hex digits, which it rejects.
+	garbageAnswers = shaped(
+		garbageOf(hegel.Text().Alphabet("0123456789abcdef/").MinSize(14).MaxSize(15)),
+		garbageOf(hegel.Text().Alphabet("0123456789abcdef").MaxSize(13)),
+	)
+	// answers: no answer three times in ten, an rgb: reply five, an rgba: reply and garbage
+	// once each; under HEGEL_NO_KNOWN=1 no rgba: reply.
+	answers = shaped(
+		weighted(choice[answer]{30, noAnswers}, choice[answer]{50, rgbAnswers}, choice[answer]{10, rgbaAnswers}, choice[answer]{10, garbageAnswers}),
+		weighted(choice[answer]{30, noAnswers}, choice[answer]{60, rgbAnswers}, choice[answer]{10, garbageAnswers}),
+	)
+)
+
+func garbageOf(texts hegel.Generator[string]) hegel.Generator[answer] {
+	return hegel.Map(texts, func(s string) answer { return answer{kind: garbageAnswer, garbage: s} })
+}
+
+// fgbgSpec: the COLORFGBG variable, fg;bg or fg;default;bg.
+type fgbgSpec struct {
+	fg, bg      int
+	withDefault bool
+}
+
+func (s fgbgSpec) value() string {
+	if s.withDefault {
+		return fmt.Sprintf("%d;default;%d", s.fg, s.bg)
+	}
+	return fmt.Sprintf("%d;%d", s.fg, s.bg)
+}
+
+// inPalette reports whether a COLORFGBG value names an ANSI colour.
+func inPalette(v int) bool { return v >= 0 && v <= 15 }
+
+// fallbackColour is the colour COLORFGBG names, or the default when it is outside 0-15
+// (termenv/5).
+func fallbackColour(v int, def termenv.ANSIColor) termenv.Color {
+	if inPalette(v) {
+		return termenv.ANSIColor(v)
+	}
+	return def
+}
+
+var (
+	paletteValues = hegel.Integers(0, 15)
+	// outsideValues: a COLORFGBG number outside 0-15, above first (termenv/5).
+	outsideValues = hegel.OneOf(hegel.Integers(16, 300), hegel.Integers(-9, -1))
+	// fgbgValues: inside 0-15 seventeen times in twenty; under HEGEL_NO_KNOWN=1 always.
+	fgbgValues = shaped(weighted(choice[int]{85, paletteValues}, choice[int]{15, outsideValues}), paletteValues)
+	fgbgSpecs  = fgbgSpecsOf(fgbgValues, fgbgValues)
+	// cursorReplies: the cursor position reply that follows every query.
+	cursorReplies = hegel.Composite(func(tc hegel.TestCase) string {
+		return fmt.Sprintf("\x1b[%d;%dR", hegel.Draw(tc, hegel.Integers(1, 999)), hegel.Draw(tc, hegel.Integers(1, 999)))
+	})
+	terminators = hegel.SampledFrom([]string{"\a", "\x1b\\"})
+	junks       = maybe(20, hegel.SampledFrom([]string{"x", "\r\n", "junk"}))
+	queryTerms  = hegel.SampledFrom([]string{"xterm", "xterm-256color", "alacritty", "foot"})
+	muxTerms    = hegel.SampledFrom([]string{"screen", "screen-256color", "tmux-256color", "dumb"})
+)
+
+// fgbgSpecsOf: a COLORFGBG with the foreground and background from the generators, in the
+// fg;default;bg form three times in ten.
+func fgbgSpecsOf(fgs, bgs hegel.Generator[int]) hegel.Generator[fgbgSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) fgbgSpec {
+		return fgbgSpec{fg: hegel.Draw(tc, fgs), bg: hegel.Draw(tc, bgs), withDefault: hegel.Draw(tc, chance(30))}
+	})
+}
+
+// outputCase: a terminal's answer to a colour query: the colour it would report, the TERM,
+// COLORFGBG (nil for unset), the answer and its terminator, junk before it, which colour is
+// queried, the cursor reply, and the multiplexer TERM under which nothing must be queried.
+type outputCase struct {
+	colour  rgb
+	term    string
+	fgbg    *fgbgSpec
+	ans     answer
+	tail    string
+	junk    string
+	queryFG bool
+	cursor  string
+	mux     string
+}
+
+func (c outputCase) env() fakeEnv {
+	env := fakeEnv{"TERM": c.term}
+	if c.fgbg != nil {
+		env["COLORFGBG"] = c.fgbg.value()
+	}
+	return env
+}
+
+func (c outputCase) muxEnv() fakeEnv {
+	env := c.env()
+	env["TERM"] = c.mux
+	return env
+}
+
+func (c outputCase) osc() int {
+	if c.queryFG {
+		return 10
+	}
+	return 11
+}
+
+// reply is what the fake terminal has to say: the junk, the answer (if any) and the cursor
+// reply.
+func (c outputCase) reply() string {
+	reply := c.junk
+	if c.ans.kind != noAnswer {
+		reply += fmt.Sprintf("\x1b]%d;%s%s", c.osc(), c.ans.body(c.colour), c.tail)
+	}
+	return reply + c.cursor
+}
+
+// wantFG and wantBG are the colours without an answer: COLORFGBG's, else grey and black.
+func (c outputCase) wantFG() termenv.Color {
+	if c.fgbg != nil {
+		return fallbackColour(c.fgbg.fg, 7)
+	}
+	return termenv.ANSIColor(7)
+}
+
+func (c outputCase) wantBG() termenv.Color {
+	if c.fgbg != nil {
+		return fallbackColour(c.fgbg.bg, 0)
+	}
+	return termenv.ANSIColor(0)
+}
+
+// want is the queried colour: the answer's when it is valid X11, else the fallback.
+func (c outputCase) want() termenv.Color {
+	if col, ok := x11Colour(c.ans.body(c.colour)); ok {
+		return col
+	}
+	if c.queryFG {
+		return c.wantFG()
+	}
+	return c.wantBG()
+}
+
+// shapes names the recorded bugs the case has the shape of: the answer's, and a COLORFGBG
+// outside 0-15 (termenv/5) for the foreground (read under the multiplexer TERM in every case)
+// or for a queried background that no answer covers.
+func (c outputCase) shapes() []string {
+	shapes := c.ans.shapes()
+	if c.fgbg != nil && (!inPalette(c.fgbg.fg) || !inPalette(c.fgbg.bg) && !c.queryFG && c.ans.kind == noAnswer) {
+		shapes = appendShape(shapes, "termenv/5")
+	}
+	return shapes
+}
+
+func (c outputCase) GoString() string {
+	which := "background"
+	if c.queryFG {
+		which = "foreground"
+	}
+	return fmt.Sprintf("%s of %v from reply %q; multiplexer %s", which, c.env().Environ(), c.reply(), c.mux)
+}
+
+// outputCasesWith draws an outputCase whose answer, COLORFGBG and queried colour come from the
+// generators given (the wide property's own otherwise).
+func outputCasesWith(ans hegel.Generator[answer], fgbgs hegel.Generator[*fgbgSpec], queryFGs hegel.Generator[bool]) hegel.Generator[outputCase] {
+	return hegel.Composite(func(tc hegel.TestCase) outputCase {
+		return outputCase{
+			colour:  hegel.Draw(tc, anyColours),
+			term:    hegel.Draw(tc, queryTerms),
+			fgbg:    hegel.Draw(tc, fgbgs),
+			ans:     hegel.Draw(tc, ans),
+			tail:    hegel.Draw(tc, terminators),
+			junk:    hegel.Draw(tc, junks),
+			queryFG: hegel.Draw(tc, queryFGs),
+			cursor:  hegel.Draw(tc, cursorReplies),
+			mux:     hegel.Draw(tc, muxTerms),
+		}
+	})
+}
+
+var outputCases = outputCasesWith(answers, optional(50, fgbgSpecs), chance(50))
+
+func isDark(hex string) bool {
+	c, _ := colorful.Hex(hex)
+	_, _, l := c.Hsl()
+	return l < 0.5
+}
+
+// outputMatches reads the queried colour through the fake TTY and checks it, the queries
+// written, the reply's consumption, HasDarkBackground (for a background query) and that a
+// multiplexer or dumb terminal is never queried; every mismatch names the case's shapes.
+func outputMatches(ht *hegel.T, c outputCase) {
+	shapes := c.shapes()
+	reply, env := c.reply(), c.env()
+	o, f := newOutput(reply, env)
+	got, panicked := catching(func() termenv.Color {
+		if c.queryFG {
+			return o.ForegroundColor()
+		}
+		return o.BackgroundColor()
+	})
+	if panicked != nil {
+		mismatch(ht, shapes, "colour query on reply %q panics: %v", reply, panicked)
+	}
+	want := c.want()
+	if got != want {
+		mismatch(ht, shapes, "colour from reply %q with %v = %#v, want %#v", reply, env.Environ(), got, want)
+	}
+	if wantQ := fmt.Sprintf("\x1b]%d;?\x1b\\\x1b[6n", c.osc()); f.out.String() != wantQ {
+		fail(ht, "queries written %q, want %q", f.out.String(), wantQ)
+	}
+	if f.in.Len() != 0 {
+		mismatch(ht, shapes, "%d bytes of the reply %q left unread", f.in.Len(), reply)
+	}
+	if !c.queryFG {
+		// HasDarkBackground re-queries; give it the same reply.
+		o2, _ := newOutput(reply, env)
+		dark, panicked := catching(o2.HasDarkBackground)
+		if panicked != nil {
+			mismatch(ht, shapes, "HasDarkBackground with %v panics: %v", env.Environ(), panicked)
+		}
+		if wantDark := isDark(termenv.ConvertToRGB(want).Hex()); dark != wantDark {
+			mismatch(ht, shapes, "HasDarkBackground with %#v = %v, want %v", want, dark, wantDark)
+		}
+	}
+	// A multiplexer or dumb terminal is never queried.
+	o3, f3 := newOutput(reply, c.muxEnv())
+	got3, panicked := catching(o3.ForegroundColor)
+	if panicked != nil {
+		mismatch(ht, shapes, "%s: ForegroundColor panics: %v", c.mux, panicked)
+	}
+	if got3 != c.wantFG() || f3.out.Len() != 0 {
+		mismatch(ht, shapes, "%s: ForegroundColor = %#v (want %#v), wrote %q", c.mux, got3, c.wantFG(), f3.out.String())
+	}
+}
+
+func TestHegelOutputReadsTheTerminalsColours(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		outputMatches(ht, hegel.Draw(ht, outputCases))
+	})
+}
+
+// ---------------------------------------------------------------- the environment rules
+
+// envCase: the variables that decide the colour profile (nil for unset) and whether the output
+// is a TTY.
+type envCase struct {
+	term      string
+	colorterm *string
+	noColor   *string
+	clicolor  *string
+	force     *string
+	tty       bool
+}
+
+func (c envCase) env() fakeEnv {
+	env := fakeEnv{"TERM": c.term}
+	for name, v := range map[string]*string{"COLORTERM": c.colorterm, "NO_COLOR": c.noColor, "CLICOLOR": c.clicolor, "CLICOLOR_FORCE": c.force} {
+		if v != nil {
+			env[name] = *v
+		}
+	}
+	return env
+}
+
+func (c envCase) GoString() string { return fmt.Sprintf("env %v tty %v", c.env().Environ(), c.tty) }
+
+var envCases = hegel.Composite(func(tc hegel.TestCase) envCase {
+	return envCase{
+		term:      hegel.Draw(tc, hegel.SampledFrom([]string{"xterm-256color", "xterm", "dumb", "linux", "alacritty", "screen"})),
+		colorterm: hegel.Draw(tc, optional(30, hegel.SampledFrom([]string{"truecolor", "24bit", "yes", "no"}))),
+		noColor:   hegel.Draw(tc, optional(30, hegel.SampledFrom([]string{"1", "true", "0", ""}))),
+		clicolor:  hegel.Draw(tc, optional(30, hegel.SampledFrom([]string{"0", "1", ""}))),
+		force:     hegel.Draw(tc, optional(30, hegel.SampledFrom([]string{"0", "1", "true", ""}))),
+		tty:       hegel.Draw(tc, chance(80)),
+	}
+})
+
+func TestHegelEnvColorProfileFollowsNoColorAndCliColor(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, envCases)
+		env, tty := c.env(), c.tty
+		f := &fakeTTY{in: new(bytes.Buffer)}
+		o := termenv.NewOutput(f, termenv.WithTTY(tty), termenv.WithEnvironment(env))
+		base := o.ColorProfile()
+		if !tty && base != termenv.Ascii {
+			fail(ht, "ColorProfile without a TTY = %s", base.Name())
+		}
+		forced := env["CLICOLOR_FORCE"] != "" && env["CLICOLOR_FORCE"] != "0"
+		noColor := env["NO_COLOR"] != "" || env["CLICOLOR"] == "0" && !forced
+		if got := o.EnvNoColor(); got != noColor {
+			fail(ht, "EnvNoColor with %v = %v, want %v", env.Environ(), got, noColor)
+		}
+		want := base
+		switch {
+		case noColor:
+			want = termenv.Ascii
+		case forced && base == termenv.Ascii:
+			want = termenv.ANSI
+		}
+		if got := o.EnvColorProfile(); got != want {
+			fail(ht, "EnvColorProfile with %v = %s, want %s", env.Environ(), got.Name(), want.Name())
+		}
+		if o.Profile != want {
+			fail(ht, "NewOutput's profile = %s, EnvColorProfile %s", o.Profile.Name(), want.Name())
+		}
+		// Spot rules the comments state.
+		if tty {
+			ct := strings.ToLower(env["COLORTERM"])
+			switch {
+			case (ct == "truecolor" || ct == "24bit") && !strings.HasPrefix(env["TERM"], "screen"):
+				if base != termenv.TrueColor {
+					fail(ht, "COLORTERM=%s TERM=%s: %s", env["COLORTERM"], env["TERM"], base.Name())
+				}
+			case ct == "yes" || ct == "true":
+				if base != termenv.ANSI256 {
+					fail(ht, "COLORTERM=%s: %s", env["COLORTERM"], base.Name())
+				}
+			case env["TERM"] == "dumb":
+				if base != termenv.Ascii {
+					fail(ht, "TERM=dumb: %s", base.Name())
+				}
+			case strings.Contains(env["TERM"], "256color"):
+				if base != termenv.ANSI256 {
+					fail(ht, "TERM=%s: %s", env["TERM"], base.Name())
+				}
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// termenv/1: the grey candidate of the 256-colour conversion averages cube indices.
+func TestHegelPinConvertGreys(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		hex  string
+		want int
+	}{{"#808080", 244}, {"#bcbcbc", 250}, {"#121212", 233}, {"#eeeeee", 255}} {
+		if got := termenv.ANSI256.Convert(termenv.RGBColor(c.hex)); got != termenv.ANSI256Color(c.want) {
+			t.Errorf("ANSI256.Convert(%q) = %v, want ANSI256Color(%d)", c.hex, got, c.want)
+		}
+	}
+}
