+// termenv/6: a malformed colour reply of the right length panics the parser (upstream #144).
+func TestHegelPinMalformedColourReplyPanics(t *testing.T) {
+	defer guard(t)
+	for _, reply := range []string{"\x1b]10;rgb:111111111111111\a", "\x1b]10;rgb:1/11111111111/1\a", "\x1b]10;rgb:11111111111/1111\a"} {
