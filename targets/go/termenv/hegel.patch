+// termenv/2: RGBColor.Sequence truncates a channel by one for 24 of the 256 values (upstream #217).
+func TestHegelPinRGBSequenceTruncation(t *testing.T) {
+	defer guard(t)
+	if got, want := termenv.RGBColor("#657084").Sequence(false), "38;2;101;112;132"; got != want {
+		t.Errorf("RGBColor(%q).Sequence(false) = %q, want %q", "#657084", got, want)
+	}
+	bad := 0
+	for v := 0; v < 256; v++ {
+		if got, want := termenv.RGBColor(hexOf(v, 0, 0)).Sequence(false), fmt.Sprintf("38;2;%d;0;0", v); got != want {
+			bad++
+		}
+	}
+	if bad != 0 {
+		t.Errorf("%d of 256 channel values come out one too low", bad)
+	}
+}
