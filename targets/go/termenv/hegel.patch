+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	if got := termenv.String("Hello").Bold().Foreground(termenv.ANSI256.Color("#ff0000")).String(); got != "\x1b[1;38;5;196mHello\x1b[0m" {
+		t.Errorf("styled = %q", got)
+	}
+	if got := termenv.ANSI.Convert(termenv.RGBColor("#ff0000")); got != termenv.ANSIColor(9) {
+		t.Errorf("ANSI.Convert(red) = %v", got)
+	}
+	if got := termenv.TrueColor.Color("#abcdef").Sequence(true); got != "48;2;171;205;239" {
+		t.Errorf("sequence = %q", got)
+	}
+	for i := 0; i < 256; i++ {
+		if got := termenv.ANSI256Color(i).String(); got != paletteHex(i) {
+			t.Errorf("palette %d: %s vs %s", i, got, paletteHex(i))
+		}
+	}
+}
