diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..6bd3ff1
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,185 @@
+package termenv_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the model of the wide property that reaches it, so that each bug
+// has a property that finds it every run (the wide properties in hegel_test.go reach the
+// shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region
+// the bug does not touch instead (the cube colours, exact channels, a nil colour, numbers in
+// the palette, COLORFGBG values in 0-15, short garbage, four-digit replies) and passes.
+
+import (
+	"testing"
+
+	"github.com/muesli/termenv"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- termenv/1
+
+// greyIndices: the palette greys 233-255, whose own hex the 256-colour conversion does not
+// convert back to their index (termenv/1); under HEGEL_NO_KNOWN=1 the cube entries and grey
+// 232, which it does.
+var greyIndices = shaped(hegel.Integers(233, 255), hegel.Integers(16, 232))
+
+// TestHegelPaletteGreysConvertBackToTheirIndex: the hex of a palette grey converts to that
+// grey in ANSI256, as the documented algorithm (nearest grey by the channel average) says;
+// the code's grey candidate is always #080808, so 23 of the 24 greys land on a cube colour or
+// on 232 (termenv/1).
+func TestHegelPaletteGreysConvertBackToTheirIndex(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		i := hegel.Draw(ht, greyIndices)
+		hex := paletteHex(i)
+		if got := termenv.ANSI256.Convert(termenv.RGBColor(hex)); got != termenv.ANSI256Color(i) {
+			mismatch(ht, shapeIf(i > 232, "termenv/1"), "ANSI256.Convert(%q) = %v, want ANSI256Color(%d)", hex, got, i)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/2
+
+var (
+	// replacedChannels: the value put into one channel of a truncated colour: one of the 24
+	// values RGBColor.Sequence writes one too low (termenv/2); under HEGEL_NO_KNOWN=1 an
+	// exact one.
+	replacedChannels = shaped(hegel.SampledFrom(inexactChannels), hegel.SampledFrom(exactChannels))
+	// truncatedColours: an RGB colour with the channel at a drawn position replaced by a
+	// replacedChannels value (the other channels from seqChannels), as a foreground or
+	// background.
+	truncatedColours = hegel.Composite(func(tc hegel.TestCase) colourCase {
+		ch := [3]int{hegel.Draw(tc, seqChannels), hegel.Draw(tc, seqChannels), hegel.Draw(tc, seqChannels)}
+		ch[hegel.Draw(tc, hegel.Integers(0, 2))] = hegel.Draw(tc, replacedChannels)
+		return colourCase{c: termenv.RGBColor(hexOf(ch[0], ch[1], ch[2])), bg: hegel.Draw(tc, chance(50))}
+	})
+)
+
+// TestHegelRGBSequencesCarryEveryChannelValue: the SGR sequence of an RGB colour carries its
+// channels as written in the hex; RGBColor.Sequence goes through float64 and truncates, so 24
+// of the 256 values come out one too low (termenv/2).
+func TestHegelRGBSequencesCarryEveryChannelValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sequenceMatches(ht, hegel.Draw(ht, truncatedColours))
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/3
+
+var (
+	// nopColourSteps: a Foreground or Background of NoColor, documented as a nop (termenv/3);
+	// under HEGEL_NO_KNOWN=1 of a nil colour, the other nop.
+	nopColourSteps = hegel.Composite(func(tc hegel.TestCase) step {
+		return step{bg: hegel.Draw(tc, chance(50)), colour: shaped[termenv.Color](termenv.NoColor{}, nil)}
+	})
+	// nopStyleCases: a style of one to four attributes in a colour profile with a nop colour
+	// step inserted at a drawn position (modulo the count plus one).
+	nopStyleCases = hegel.Composite(func(tc hegel.TestCase) styleCase {
+		attrs := hegel.Draw(tc, many(attrSteps, 1, 4))
+		at := hegel.Draw(tc, positions) % (len(attrs) + 1)
+		nop := hegel.Draw(tc, nopColourSteps)
+		steps := append(append(append([]step{}, attrs[:at]...), nop), attrs[at:]...)
+		return styleCase{p: hegel.Draw(tc, colourProfiles), text: hegel.Draw(tc, styleTexts), steps: steps}
+	})
+)
+
+// TestHegelNoColorInAStyleIsANop: a NoColor foreground or background adds nothing to a
+// style's SGR sequence, as the documentation says (and as a nil colour does); Style appends
+// its empty Sequence, so the rendered sequence carries an empty parameter, a reset
+// (termenv/3).
+func TestHegelNoColorInAStyleIsANop(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		styledMatches(ht, hegel.Draw(ht, nopStyleCases))
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/4
+
+// outsideTexts: a profile and a number outside 0-255 as text, which names no colour
+// (termenv/4); under HEGEL_NO_KNOWN=1 a number inside, naming its palette colour.
+var outsideTexts = hegel.Composite(func(tc hegel.TestCase) profileText {
+	return profileText{p: hegel.Draw(tc, profileGen), ct: hegel.Draw(tc, shaped(outOfRangeTexts, hegel.OneOf(ansiTexts, ansi256Texts)))}
+})
+
+// TestHegelProfileColorRejectsNumbersOutsideThePalette: Profile.Color of a number outside the
+// documented 0-255 is nil in every profile; the code accepts any integer, and the colour it
+// returns panics in String() and in ANSI's Convert (termenv/4).
+func TestHegelProfileColorRejectsNumbersOutsideThePalette(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		colourTextMatches(ht, hegel.Draw(ht, outsideTexts))
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/5
+
+var (
+	// outsideFGBGs: a COLORFGBG whose foreground, background or both are outside 0-15
+	// (termenv/5); under HEGEL_NO_KNOWN=1 both inside.
+	outsideFGBGs = shaped(
+		hegel.OneOf(fgbgSpecsOf(outsideValues, paletteValues), fgbgSpecsOf(paletteValues, outsideValues), fgbgSpecsOf(outsideValues, outsideValues)),
+		fgbgSpecsOf(paletteValues, paletteValues),
+	)
+	// fgbgCases: a background query the terminal does not answer, so that both colours fall
+	// back to COLORFGBG (the foreground under the multiplexer TERM).
+	fgbgCases = outputCasesWith(noAnswers, hegel.Map(outsideFGBGs, ptrTo[fgbgSpec]), hegel.Just(false))
+)
+
+// TestHegelColorFGBGOutsideThePaletteFallsBackToTheDefaults: when the terminal does not
+// answer and COLORFGBG holds a number outside 0-15, the colour is the default (grey, black)
+// and HasDarkBackground is that of the default; the code returns ANSIColor of any integer,
+// which panics in ConvertToRGB (termenv/5).
+func TestHegelColorFGBGOutsideThePaletteFallsBackToTheDefaults(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		outputMatches(ht, hegel.Draw(ht, fgbgCases))
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/6
+
+var (
+	// malformedAnswers: rgb: followed by 14 or 15 hex digits and slashes that leave fewer than
+	// three components or one shorter than two characters, at the length the parser accepts
+	// (termenv/6); under HEGEL_NO_KNOWN=1 up to 13 hex digits, which it rejects.
+	malformedAnswers = shaped(
+		hegel.Filter(garbageOf(hegel.Text().Alphabet("0123456789abcdef/").MinSize(14).MaxSize(15)), func(a answer) bool { return parserPanics(a.garbage) }),
+		garbageOf(hegel.Text().Alphabet("0123456789abcdef").MaxSize(13)),
+	)
+	malformedCases = outputCasesWith(malformedAnswers, optional(50, fgbgSpecsOf(paletteValues, paletteValues)), chance(50))
+)
+
+// TestHegelMalformedColourRepliesFallBack: a reply that is not an X11 colour is no answer, so
+// the colour falls back to COLORFGBG or the default and the reply is consumed; the parser
+// judges a reply by its length and slices its components, so garbage of the right length
+// panics it (termenv/6).
+func TestHegelMalformedColourRepliesFallBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		outputMatches(ht, hegel.Draw(ht, malformedCases))
+	})
+}
+
+// --------------------------------------------------------------------------- termenv/7
+
+var (
+	// shortWidths: one to four digits per component with at least one component (at a drawn
+	// position) of fewer than four.
+	shortWidths = hegel.Composite(func(tc hegel.TestCase) [3]int {
+		w := hegel.Draw(tc, anyWidths)
+		w[hegel.Draw(tc, hegel.Integers(0, 2))] = hegel.Draw(tc, hegel.SampledFrom([]int{2, 1, 3}))
+		return w
+	})
+	// shortAnswers: an rgb: reply with a component of fewer than four digits, or an rgba:
+	// reply (termenv/7); under HEGEL_NO_KNOWN=1 the four-digit rgb: reply every terminal
+	// sends.
+	shortAnswers = shaped(
+		hegel.OneOf(hegel.Map(shortWidths, func(w [3]int) answer { return answer{kind: rgbAnswer, widths: w} }), rgbaAnswers),
+		hegel.Just(answer{kind: rgbAnswer, widths: fourDigits}),
+	)
+	shortCases = outputCasesWith(shortAnswers, optional(50, fgbgSpecsOf(paletteValues, paletteValues)), chance(50))
+)
+
+// TestHegelColourRepliesOfEveryComponentWidthAreRead: an rgb: reply with one to four hex
+// digits per component, or an rgba: reply, is the terminal's colour (X11's syntax, top byte
+// of each component) and is consumed whole; the parser accepts only 24- or 25-byte replies,
+// so the others fall back to COLORFGBG, and an rgba: reply is left half unread (termenv/7).
+func TestHegelColourRepliesOfEveryComponentWidthAreRead(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		outputMatches(ht, hegel.Draw(ht, shortCases))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..94e1bf9
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1524 @@
+// Hegel properties for muesli/termenv: colour conversion between profiles, the SGR sequences
+// of colours and styles, Profile.Color's parsing, the template helpers, and Output's reading of
+// the terminal's colours through a fake TTY.
+//
+// Oracles: the xterm 256-colour palette (computed, not copied), the SGR parameter table, the
+// documented conversion algorithm (tmux's colour_find_rgb with the HSLuv tie-break the code
+// chooses), the documented NO_COLOR/CLICOLOR rules, X11's rgb: reply format for OSC 10/11, and
+// a fake terminal that answers the queries.
+//
+// Every property draws one case record built from the binding's combinators and renders it
+// with pure functions. The shapes of the recorded bugs (bugs.toml) are drawn at their natural
+// rate, so the properties that meet them fail, naming the shape, and are the expected failures
+// mapped to the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over
+// its shape region alone, and the TestHegelPin tests below are the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run that looks past
+// the bugs. TERMENV_COLLECT=1 turns failures into a tally.
+package termenv_test
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"text/template"
+
+	"github.com/lucasb-eyer/go-colorful"
+	"github.com/muesli/termenv"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the shapes are left out of the generators (shaped)
+// and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("TERMENV_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a failure: normally ht.Fatalf, in collect mode it records the message and
+// abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the shapes of the recorded
+// bugs named (none for a plain failure): the failure names the shapes, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// catching runs f and returns its value and the value of a panic in the code under test (nil
+// for none), so that a panic that is a recorded shape can be named by the property.
+func catching[T any](f func() T) (v T, panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	v = f()
+	return v, nil
+}
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// hexText: n hex digits.
+func hexText(n int) hegel.Generator[string] {
+	return hegel.Text().Alphabet("0123456789abcdef").MinSize(n).MaxSize(n)
+}
+
+// ---------------------------------------------------------------- the xterm palette
+
+var basic16 = []string{
+	"#000000", "#800000", "#008000", "#808000", "#000080", "#800080", "#008080", "#c0c0c0",
+	"#808080", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#ff00ff", "#00ffff", "#ffffff",
+}
+
+var cubeLevels = [6]int{0x00, 0x5f, 0x87, 0xaf, 0xd7, 0xff}
+
+// paletteRGB is the xterm palette: 16 basic colours, the 6x6x6 cube, 24 greys.
+func paletteRGB(i int) (int, int, int) {
+	switch {
+	case i < 16:
+		v, _ := strconv.ParseUint(basic16[i][1:], 16, 32)
+		return int(v >> 16), int(v >> 8 & 0xff), int(v & 0xff)
+	case i < 232:
+		i -= 16
+		return cubeLevels[i/36], cubeLevels[i/6%6], cubeLevels[i%6]
+	default:
+		g := 8 + 10*(i-232)
+		return g, g, g
+	}
+}
+
+func hexOf(r, g, b int) string { return fmt.Sprintf("#%02x%02x%02x", r, g, b) }
+
+func paletteHex(i int) string {
+	r, g, b := paletteRGB(i)
+	return hexOf(r, g, b)
+}
+
+func hsluvDist(r1, g1, b1, r2, g2, b2 int) float64 {
+	a := colorful.Color{R: float64(r1) / 255, G: float64(g1) / 255, B: float64(b1) / 255}
+	b := colorful.Color{R: float64(r2) / 255, G: float64(g2) / 255, B: float64(b2) / 255}
+	return a.DistanceHSLuv(b)
+}
+
+// to256 is the documented conversion (tmux's colour_find_rgb: nearest cube colour, nearest grey
+// from the average of the channels, then the nearer of the two - by HSLuv distance here, as the
+// code chooses).
+func to256(r, g, b int) int {
+	v2ci := func(v int) int {
+		if v < 48 {
+			return 0
+		}
+		if v < 115 {
+			return 1
+		}
+		return (v - 35) / 40
+	}
+	qr, qg, qb := v2ci(r), v2ci(g), v2ci(b)
+	cr, cg, cb := cubeLevels[qr], cubeLevels[qg], cubeLevels[qb]
+	ci := 36*qr + 6*qg + qb
+	avg := (r + g + b) / 3
+	grayIdx := 23
+	if avg <= 238 {
+		grayIdx = (avg - 3) / 10
+		if grayIdx < 0 {
+			grayIdx = 0
+		}
+	}
+	gv := 8 + 10*grayIdx
+	if hsluvDist(r, g, b, cr, cg, cb) <= hsluvDist(r, g, b, gv, gv, gv) {
+		return 16 + ci
+	}
+	return 232 + grayIdx
+}
+
+// greyShape reports whether the 256-colour conversion of (r, g, b) meets termenv/1: the
+// documented algorithm picks a grey (the code averages the cube indices instead of the
+// channels, so its grey candidate is always grey 232, #080808), or that wrong candidate is
+// nearer than the nearest cube colour, so the code picks 232 instead of it.
+func greyShape(r, g, b int) bool {
+	want := to256(r, g, b)
+	if want >= 232 {
+		return true
+	}
+	cr, cg, cb := paletteRGB(want)
+	return hsluvDist(r, g, b, cr, cg, cb) > hsluvDist(r, g, b, 8, 8, 8)
+}
+
+// to16 is the code's documented rule for 256 -> 16: the nearest basic colour by HSLuv distance.
+func to16(i int) int {
+	r, g, b := paletteRGB(i)
+	best, bestD := 0, -1.0
+	for k := 0; k < 16; k++ {
+		kr, kg, kb := paletteRGB(k)
+		if d := hsluvDist(r, g, b, kr, kg, kb); bestD < 0 || d < bestD {
+			best, bestD = k, d
+		}
+	}
+	return best
+}
+
+var profiles = []termenv.Profile{termenv.TrueColor, termenv.ANSI256, termenv.ANSI, termenv.Ascii}
+
+var (
+	profileGen = hegel.SampledFrom(profiles)
+	// colourProfiles: the profiles that render colours (Ascii renders nothing).
+	colourProfiles = hegel.SampledFrom(profiles[:3])
+	channels       = hegel.Integers(0, 255)
+)
+
+// paletteIndices: an entry of the xterm palette; under HEGEL_NO_KNOWN=1 not one of the greys
+// 233-255, whose own hex does not convert back to their index (termenv/1).
+var paletteIndices = shaped(hegel.Integers(0, 255), hegel.Integers(0, 232))
+
+func TestHegelPaletteConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		i := hegel.Draw(ht, paletteIndices)
+		hex := paletteHex(i)
+		// The library's table agrees with the computed palette.
+		if i < 16 {
+			if got := termenv.ANSIColor(i).String(); got != hex {
+				fail(ht, "ANSIColor(%d).String() = %q, palette %q", i, got, hex)
+			}
+		}
+		if got := termenv.ANSI256Color(i).String(); got != hex {
+			fail(ht, "ANSI256Color(%d).String() = %q, palette %q", i, got, hex)
+		}
+		if got := termenv.ConvertToRGB(termenv.ANSI256Color(i)).Hex(); got != hex {
+			fail(ht, "ConvertToRGB(ANSI256Color(%d)).Hex() = %q, palette %q", i, got, hex)
+		}
+		// Identities.
+		for _, p := range profiles[:3] {
+			if i < 16 {
+				if got := p.Convert(termenv.ANSIColor(i)); got != termenv.ANSIColor(i) {
+					fail(ht, "%s.Convert(ANSIColor(%d)) = %v", p.Name(), i, got)
+				}
+			}
+			want := termenv.Color(termenv.ANSI256Color(i))
+			if p == termenv.ANSI {
+				want = termenv.ANSIColor(to16(i))
+			}
+			if got := p.Convert(termenv.ANSI256Color(i)); got != want {
+				fail(ht, "%s.Convert(ANSI256Color(%d)) = %v, want %v", p.Name(), i, got, want)
+			}
+		}
+		if got := termenv.Ascii.Convert(termenv.ANSI256Color(i)); got != (termenv.NoColor{}) {
+			fail(ht, "Ascii.Convert = %v", got)
+		}
+		// The palette entry's own RGB converts back to its index (greys 233-255: termenv/1).
+		if got := termenv.TrueColor.Convert(termenv.RGBColor(hex)); got != termenv.RGBColor(hex) {
+			fail(ht, "TrueColor.Convert(%q) = %v", hex, got)
+		}
+		if i >= 16 {
+			if got := termenv.ANSI256.Convert(termenv.RGBColor(hex)); got != termenv.ANSI256Color(i) {
+				mismatch(ht, shapeIf(i > 232, "termenv/1"), "ANSI256.Convert(%q) = %v, want ANSI256Color(%d)", hex, got, i)
+			}
+		} else if got := termenv.ANSI.Convert(termenv.RGBColor(hex)); got != termenv.ANSIColor(i) {
+			fail(ht, "ANSI.Convert(%q) = %v, want ANSIColor(%d)", hex, got, i)
+		}
+	})
+}
+
+// rgb is a colour by its channels.
+type rgb struct{ r, g, b int }
+
+func (c rgb) hex() string { return hexOf(c.r, c.g, c.b) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c rgb) GoString() string { return c.hex() }
+
+var (
+	anyColours = hegel.Composite(func(tc hegel.TestCase) rgb {
+		return rgb{hegel.Draw(tc, channels), hegel.Draw(tc, channels), hegel.Draw(tc, channels)}
+	})
+	greyColours = hegel.Map(channels, func(v int) rgb { return rgb{v, v, v} })
+	// colours: a random colour three times in four, a grey once (where the algorithm has two
+	// candidates); under HEGEL_NO_KNOWN=1 random colours whose conversion does not meet
+	// termenv/1 (4% of them do).
+	colours = shaped(
+		weighted(choice[rgb]{75, anyColours}, choice[rgb]{25, greyColours}),
+		hegel.Filter(anyColours, func(c rgb) bool { return !greyShape(c.r, c.g, c.b) }),
+	)
+)
+
+func TestHegelConvertFollowsTheDocumentedAlgorithm(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		col := hegel.Draw(ht, colours)
+		r, g, b := col.r, col.g, col.b
+		hex := col.hex()
+		c := termenv.RGBColor(hex)
+		want := to256(r, g, b)
+		got := termenv.ANSI256.Convert(c)
+		if got != termenv.ANSI256Color(want) {
+			// The code averages the cube indices instead of the channels, so its grey
+			// candidate is always #080808: a grey is (almost) never chosen, and #080808 wins
+			// over a dark cube colour: termenv/1.
+			mismatch(ht, shapeIf(greyShape(r, g, b), "termenv/1"), "ANSI256.Convert(%q) = %v, want ANSI256Color(%d) (%s)", hex, got, want, paletteHex(want))
+		}
+		g256, ok := got.(termenv.ANSI256Color)
+		if !ok || g256 < 16 {
+			fail(ht, "ANSI256.Convert(%q) = %v, not a colour in 16-255", hex, got)
+		}
+		// Idempotent, and 16 colours through 256.
+		for _, p := range profiles {
+			once := p.Convert(c)
+			if twice := p.Convert(once); twice != once {
+				fail(ht, "%s.Convert is not idempotent on %q: %v then %v", p.Name(), hex, once, twice)
+			}
+		}
+		if got16, want16 := termenv.ANSI.Convert(c), termenv.ANSI.Convert(got); got16 != want16 {
+			fail(ht, "ANSI.Convert(%q) = %v, but through ANSI256 %v", hex, got16, want16)
+		}
+		a16, ok := termenv.ANSI.Convert(c).(termenv.ANSIColor)
+		if !ok || a16 < 0 || a16 > 15 {
+			fail(ht, "ANSI.Convert(%q) = %v", hex, termenv.ANSI.Convert(c))
+		}
+		// FromColor goes through the hex string.
+		if got := termenv.TrueColor.FromColor(color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}); got != c {
+			fail(ht, "TrueColor.FromColor(%s) = %v", hex, got)
+		}
+	})
+}
+
+// ---------------------------------------------------------------- sequences and styles
+
+// exactChannel reports whether v survives the float round trip in RGBColor.Sequence
+// (termenv/2 for the others).
+func exactChannel(v int) bool {
+	c, _ := colorful.Hex(hexOf(v, v, v))
+	return int(uint8(c.R*255)) == v
+}
+
+// exactChannels and inexactChannels: the 232 channel values RGBColor.Sequence writes as they
+// are and the 24 it writes one too low (termenv/2).
+var exactChannels, inexactChannels = func() (exact, inexact []int) {
+	for v := 0; v < 256; v++ {
+		if exactChannel(v) {
+			exact = append(exact, v)
+		} else {
+			inexact = append(inexact, v)
+		}
+	}
+	return exact, inexact
+}()
+
+// seqChannels: a channel of an RGB colour whose sequence is rendered; under HEGEL_NO_KNOWN=1
+// one of the values that survive the float round trip (termenv/2).
+var seqChannels = shaped(channels, hegel.SampledFrom(exactChannels))
+
+// rgbHexes: #rrggbb from the channels 85% of the time, else #rgb (every channel v*17, always
+// exact).
+func rgbHexes(ch hegel.Generator[int]) hegel.Generator[string] {
+	long := hegel.Composite(func(tc hegel.TestCase) string {
+		return hexOf(hegel.Draw(tc, ch), hegel.Draw(tc, ch), hegel.Draw(tc, ch))
+	})
+	digits := hegel.Integers(0, 15)
+	short := hegel.Composite(func(tc hegel.TestCase) string {
+		return fmt.Sprintf("#%x%x%x", hegel.Draw(tc, digits), hegel.Draw(tc, digits), hegel.Draw(tc, digits))
+	})
+	return weighted(choice[string]{85, long}, choice[string]{15, short})
+}
+
+var (
+	// seqHexes: the hex of an RGB colour whose SGR sequence is checked against the table.
+	seqHexes = rgbHexes(seqChannels)
+	// anyHexes: the hex of an RGB colour that is only converted (the conversion is the model).
+	anyHexes = rgbHexes(channels)
+)
+
+func seqOf(c termenv.Color, bg bool) string {
+	off := 0
+	if bg {
+		off = 10
+	}
+	switch v := c.(type) {
+	case termenv.ANSIColor:
+		if v < 8 {
+			return strconv.Itoa(30 + off + int(v))
+		}
+		return strconv.Itoa(90 + off + int(v) - 8)
+	case termenv.ANSI256Color:
+		return fmt.Sprintf("%d;5;%d", 38+off, int(v))
+	case termenv.RGBColor:
+		r, g, b := hexRGB(string(v))
+		return fmt.Sprintf("%d;2;%d;%d;%d", 38+off, r, g, b)
+	}
+	return ""
+}
+
+// hexRGB reads #rrggbb and #rgb.
+func hexRGB(h string) (int, int, int) {
+	h = h[1:]
+	if len(h) == 3 {
+		h = string([]byte{h[0], h[0], h[1], h[1], h[2], h[2]})
+	}
+	v, _ := strconv.ParseUint(h, 16, 32)
+	return int(v >> 16), int(v >> 8 & 0xff), int(v & 0xff)
+}
+
+// truncatedRGB reports whether the colour is an RGBColor with a channel RGBColor.Sequence
+// writes one too low: the shape of termenv/2.
+func truncatedRGB(c termenv.Color) bool {
+	v, ok := c.(termenv.RGBColor)
+	if !ok || len(v) != 7 {
+		return false
+	}
+	r, g, b := hexRGB(string(v))
+	return !exactChannel(r) || !exactChannel(g) || !exactChannel(b)
+}
+
+var (
+	ansiColours    = hegel.Map(hegel.Integers(0, 15), func(i int) termenv.Color { return termenv.ANSIColor(i) })
+	ansi256Colours = hegel.Map(channels, func(i int) termenv.Color { return termenv.ANSI256Color(i) })
+	rgbColours     = hegel.Map(seqHexes, func(h string) termenv.Color { return termenv.RGBColor(h) })
+	// seqColours: a colour of every kind, for its sequence.
+	seqColours = hegel.OneOf(ansiColours, ansi256Colours, rgbColours)
+)
+
+// colourCase: a colour and whether it is a background.
+type colourCase struct {
+	c  termenv.Color
+	bg bool
+}
+
+var colourCases = hegel.Composite(func(tc hegel.TestCase) colourCase {
+	return colourCase{c: hegel.Draw(tc, seqColours), bg: hegel.Draw(tc, chance(50))}
+})
+
+// sequenceMatches checks the colour's SGR sequence against the table.
+func sequenceMatches(ht *hegel.T, cc colourCase) {
+	if got, want := cc.c.Sequence(cc.bg), seqOf(cc.c, cc.bg); got != want {
+		mismatch(ht, shapeIf(truncatedRGB(cc.c), "termenv/2"), "%T(%v).Sequence(%v) = %q, want %q", cc.c, cc.c, cc.bg, got, want)
+	}
+}
+
+func TestHegelColourSequencesFollowTheSGRTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, colourCases)
+		sequenceMatches(ht, cc)
+		if rgb, ok := cc.c.(termenv.RGBColor); ok {
+			r, g, b := hexRGB(string(rgb))
+			if got := termenv.ConvertToRGB(rgb).Hex(); got != hexOf(r, g, b) {
+				fail(ht, "ConvertToRGB(%q).Hex() = %q", rgb, got)
+			}
+		}
+	})
+}
+
+var (
+	attrNames = []string{"Bold", "Faint", "Italic", "Underline", "Overline", "Blink", "Reverse", "CrossOut"}
+	attrCodes = map[string]string{"Bold": "1", "Faint": "2", "Italic": "3", "Underline": "4", "Overline": "53", "Blink": "5", "Reverse": "7", "CrossOut": "9"}
+	attrFuncs = map[string]func(termenv.Style) termenv.Style{
+		"Bold": termenv.Style.Bold, "Faint": termenv.Style.Faint, "Italic": termenv.Style.Italic, "Underline": termenv.Style.Underline,
+		"Overline": termenv.Style.Overline, "Blink": termenv.Style.Blink, "Reverse": termenv.Style.Reverse, "CrossOut": termenv.Style.CrossOut,
+	}
+)
+
+// step is one Style method call: an attribute, or a Foreground or Background colour (nil for
+// none).
+type step struct {
+	attr   string
+	bg     bool
+	colour termenv.Color
+}
+
+func (s step) String() string {
+	if s.attr != "" {
+		return s.attr
+	}
+	if s.bg {
+		return fmt.Sprintf("Background(%#v)", s.colour)
+	}
+	return fmt.Sprintf("Foreground(%#v)", s.colour)
+}
+
+func (s step) apply(st termenv.Style) termenv.Style {
+	if s.attr != "" {
+		return attrFuncs[s.attr](st)
+	}
+	if s.bg {
+		return st.Background(s.colour)
+	}
+	return st.Foreground(s.colour)
+}
+
+// param is the SGR parameter the step adds by the table: an attribute's code, a colour's
+// sequence; nothing for a nil colour or a NoColor (documented as a nop, termenv/3).
+func (s step) param() (string, bool) {
+	if s.attr != "" {
+		return attrCodes[s.attr], true
+	}
+	switch s.colour.(type) {
+	case nil, termenv.NoColor:
+		return "", false
+	}
+	return seqOf(s.colour, s.bg), true
+}
+
+var (
+	nilColours = hegel.Just[termenv.Color](nil)
+	noColours  = hegel.Just[termenv.Color](termenv.NoColor{})
+	// styleColours: the colour of a Foreground or Background step: none, an ANSI colour, an
+	// ANSI256 colour, an RGB colour, or NoColor (termenv/3; not under HEGEL_NO_KNOWN=1).
+	styleColours = shaped(
+		weighted(
+			choice[termenv.Color]{20, nilColours}, choice[termenv.Color]{20, ansiColours}, choice[termenv.Color]{20, ansi256Colours},
+			choice[termenv.Color]{34, rgbColours}, choice[termenv.Color]{6, noColours},
+		),
+		weighted(
+			choice[termenv.Color]{20, nilColours}, choice[termenv.Color]{20, ansiColours}, choice[termenv.Color]{20, ansi256Colours},
+			choice[termenv.Color]{40, rgbColours},
+		),
+	)
+	attrSteps   = hegel.Map(hegel.SampledFrom(attrNames), func(name string) step { return step{attr: name} })
+	colourSteps = hegel.Composite(func(tc hegel.TestCase) step {
+		return step{bg: hegel.Draw(tc, chance(50)), colour: hegel.Draw(tc, styleColours)}
+	})
+	// steps: an attribute four times in five, a colour once.
+	steps      = weighted(choice[step]{80, attrSteps}, choice[step]{20, colourSteps})
+	styleTexts = hegel.SampledFrom([]string{"", "x", "hello", "日本", "a b", "\x1b[1m"})
+)
+
+// styleCase: a Style built through its methods in a profile, and two texts for String(a, b).
+type styleCase struct {
+	p     termenv.Profile
+	text  string
+	steps []step
+	parts []string
+}
+
+func (c styleCase) GoString() string {
+	return fmt.Sprintf("%s style of %q: %v; parts %q", c.p.Name(), c.text, c.steps, c.parts)
+}
+
+// build applies the steps and collects the SGR parameters the table gives them.
+func (c styleCase) build() (termenv.Style, []string) {
+	st := c.p.String(c.text)
+	var params []string
+	for _, s := range c.steps {
+		st = s.apply(st)
+		if param, ok := s.param(); ok {
+			params = append(params, param)
+		}
+	}
+	return st, params
+}
+
+// shapes names the recorded bugs the style has the shape of, in a profile that renders: a
+// NoColor step (termenv/3), an RGB colour with a truncated channel (termenv/2).
+func (c styleCase) shapes() []string {
+	if c.p == termenv.Ascii {
+		return nil
+	}
+	var shapes []string
+	for _, s := range c.steps {
+		if _, ok := s.colour.(termenv.NoColor); ok {
+			shapes = appendShape(shapes, "termenv/3")
+		}
+		if truncatedRGB(s.colour) {
+			shapes = appendShape(shapes, "termenv/2")
+		}
+	}
+	return shapes
+}
+
+// appendShape adds a shape once.
+func appendShape(shapes []string, id string) []string {
+	for _, s := range shapes {
+		if s == id {
+			return shapes
+		}
+	}
+	return append(shapes, id)
+}
+
+func styledModel(p termenv.Profile, seqs []string, text string) string {
+	if p == termenv.Ascii || len(seqs) == 0 {
+		return text
+	}
+	return "\x1b[" + strings.Join(seqs, ";") + "m" + text + "\x1b[0m"
+}
+
+var styleCases = hegel.Composite(func(tc hegel.TestCase) styleCase {
+	return styleCase{
+		p:     hegel.Draw(tc, profileGen),
+		text:  hegel.Draw(tc, styleTexts),
+		steps: hegel.Draw(tc, many(steps, 0, 5)),
+		parts: hegel.Draw(tc, many(styleTexts, 2, 2)),
+	}
+})
+
+// styledMatches checks the style's String() against the SGR model and returns it.
+func styledMatches(ht *hegel.T, c styleCase) (termenv.Style, string) {
+	st, params := c.build()
+	got := st.String()
+	if want := styledModel(c.p, params, c.text); got != want {
+		mismatch(ht, c.shapes(), "%s Style %v on %q = %q, want %q", c.p.Name(), c.steps, c.text, got, want)
+	}
+	return st, got
+}
+
+func TestHegelStyledFollowsTheSGRTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, styleCases)
+		st, got := styledMatches(ht, c)
+		if got2 := st.Styled(c.text); got2 != got {
+			fail(ht, "Styled(%q) = %q, String() = %q", c.text, got2, got)
+		}
+		// String(a, b) joins with a space; Width is the text's width.
+		joined := strings.Join(c.parts, " ")
+		if got := termenv.String(c.parts...).String(); got != joined {
+			fail(ht, "String(%q) = %q", c.parts, got)
+		}
+		if w := c.p.String(c.text).Width(); w != termenv.String(c.text).Width() {
+			fail(ht, "Width differs between profiles: %d vs %d", w, termenv.String(c.text).Width())
+		}
+	})
+}
+
+// ---------------------------------------------------------------- Profile.Color
+
+// colourText: a string for Profile.Color and the colour it names (nil for none); outOfRange
+// marks a number outside 0-255, which names no colour (termenv/4).
+type colourText struct {
+	s          string
+	colour     termenv.Color
+	outOfRange bool
+}
+
+func (ct colourText) GoString() string { return fmt.Sprintf("%q", ct.s) }
+
+var (
+	hexTexts     = hegel.Map(anyHexes, func(h string) colourText { return colourText{s: h, colour: termenv.RGBColor(h)} })
+	ansiTexts    = hegel.Map(hegel.Integers(0, 15), func(i int) colourText { return colourText{s: strconv.Itoa(i), colour: termenv.ANSIColor(i)} })
+	ansi256Texts = hegel.Map(hegel.Integers(16, 255), func(i int) colourText { return colourText{s: strconv.Itoa(i), colour: termenv.ANSI256Color(i)} })
+	invalidTexts = hegel.Map(hegel.SampledFrom([]string{"", "#", "#abcd", "#gggggg", "red", "1e2", "0x10", " 5", "5 ", "#12345", "#1234567", "rgb:00/00/00"}), func(s string) colourText { return colourText{s: s} })
+	// outOfRange: a number outside the documented 0-255, above it first.
+	outOfRange      = hegel.OneOf(hegel.Integers(256, 99999), hegel.Integers(-99999, -1))
+	outOfRangeTexts = hegel.Map(outOfRange, func(i int) colourText { return colourText{s: strconv.Itoa(i), outOfRange: true} })
+	// colourTexts: a hex colour, an ANSI number, an ANSI256 number, an invalid string or a
+	// number out of range (termenv/4; not under HEGEL_NO_KNOWN=1), as often as each other.
+	colourTexts = shaped(
+		hegel.OneOf(hexTexts, ansiTexts, ansi256Texts, invalidTexts, outOfRangeTexts),
+		hegel.OneOf(hexTexts, ansiTexts, ansi256Texts, invalidTexts),
+	)
+)
+
+// profileText: a profile and a string for its Color.
+type profileText struct {
+	p  termenv.Profile
+	ct colourText
+}
+
+func (pt profileText) GoString() string { return fmt.Sprintf("%s.Color(%q)", pt.p.Name(), pt.ct.s) }
+
+var profileTexts = hegel.Composite(func(tc hegel.TestCase) profileText {
+	return profileText{p: hegel.Draw(tc, profileGen), ct: hegel.Draw(tc, colourTexts)}
+})
+
+// colourTextMatches checks Profile.Color on the text against the colour it names converted to
+// the profile, nil for none (Ascii.Convert does not look at the hex string, so an invalid hex
+// is NoColor there too).
+func colourTextMatches(ht *hegel.T, pt profileText) {
+	p, ct := pt.p, pt.ct
+	shapes := shapeIf(ct.outOfRange, "termenv/4")
+	got, panicked := catching(func() termenv.Color { return p.Color(ct.s) })
+	if panicked != nil {
+		mismatch(ht, shapes, "%s.Color(%q) panics: %v", p.Name(), ct.s, panicked)
+	}
+	var want termenv.Color
+	switch {
+	case ct.colour != nil:
+		want = p.Convert(ct.colour)
+	case p == termenv.Ascii && strings.HasPrefix(ct.s, "#"):
+		want = termenv.NoColor{}
+	}
+	if want == nil {
+		if got != nil {
+			mismatch(ht, shapes, "%s.Color(%q) = %#v, want nil", p.Name(), ct.s, got)
+		}
+		return // the verdict on a string that names no colour
+	}
+	if got != want {
+		fail(ht, "%s.Color(%q) = %#v, want %#v", p.Name(), ct.s, got, want)
+	}
+	if p == termenv.Ascii {
+		if got != (termenv.NoColor{}) {
+			fail(ht, "Ascii.Color(%q) = %#v", ct.s, got)
+		}
+	} else if _, ok := got.(termenv.NoColor); ok {
+		fail(ht, "%s.Color(%q) = NoColor", p.Name(), ct.s)
+	}
+}
+
+func TestHegelProfileColorParsesTheDocumentedForms(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		colourTextMatches(ht, hegel.Draw(ht, profileTexts))
+	})
+}
