+// termenv/1: the grey candidate of the 256-colour conversion averages cube indices.
+func TestHegelPinConvertGreys(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		hex  string
+		want int
+	}{{"#808080", 244}, {"#bcbcbc", 250}, {"#121212", 233}, {"#eeeeee", 255}} {
+		if got := termenv.ANSI256.Convert(termenv.RGBColor(c.hex)); got != termenv.ANSI256Color(c.want) {
+			t.Errorf("ANSI256.Convert(%q) = %v, want ANSI256Color(%d)", c.hex, got, c.want)
+		}
+	}
+}
