+// ---------------------------------------------------------------- template helpers
+
+func TestHegelTemplateHelpersRenderStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := pick(ht, profiles)
+		text := pick(ht, []string{"x", "hello", "日本"})
+		var tpl string
+		var seqs []string
+		switch n(ht, 0, 3) {
+		case 0:
+			name := pick(ht, []string{"Bold", "Faint", "Italic", "Underline", "Overline", "Blink", "Reverse", "CrossOut"})
+			tpl = fmt.Sprintf("{{ %s %q }}", name, text)
+			seqs = []string{map[string]string{"Bold": "1", "Faint": "2", "Italic": "3", "Underline": "4", "Overline": "53", "Blink": "5", "Reverse": "7", "CrossOut": "9"}[name]}
+		case 1:
+			fg := genColorString(ht)
+			tpl = fmt.Sprintf("{{ Foreground %q %q }}", fg, text)
+			if c := p.Color(fg); c != nil {
+				seqs = append(seqs, seqOf(c, false))
+			}
+		case 2:
+			bg := genColorString(ht)
+			tpl = fmt.Sprintf("{{ Background %q %q }}", bg, text)
+			if c := p.Color(bg); c != nil {
+				seqs = append(seqs, seqOf(c, true))
+			}
+		default:
+			fg, bg := genColorString(ht), genColorString(ht)
+			tpl = fmt.Sprintf("{{ Color %q %q %q }}", fg, bg, text)
+			if c := p.Color(fg); c != nil {
+				seqs = append(seqs, seqOf(c, false))
+			}
+			if c := p.Color(bg); c != nil {
+				seqs = append(seqs, seqOf(c, true))
+			}
+		}
+		note(ht, "profile %s template %s", p.Name(), tpl)
+		tmpl, err := template.New("t").Funcs(termenv.TemplateFuncs(p)).Parse(tpl)
+		if err != nil {
+			fail(ht, "parse %s: %v", tpl, err)
+		}
+		var buf bytes.Buffer
+		if err := tmpl.Execute(&buf, nil); err != nil {
+			fail(ht, "execute %s: %v", tpl, err)
+		}
+		if p != termenv.Ascii {
+			for _, s := range seqs {
+				if s == "" {
+					count("nocolor-skipped") // termenv/3 via a Convert to NoColor cannot happen here; kept for symmetry
+					return
+				}
+			}
+		}
+		if got, want := buf.String(), styledModel(p, seqs, text); got != want {
+			fail(ht, "%s %s = %q, want %q", p.Name(), tpl, got, want)
+		}
+		count("ok")
+	})
+}
