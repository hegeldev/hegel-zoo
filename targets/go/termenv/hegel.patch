+// ---------------------------------------------------------------- the terminal's colours
+
+type fakeEnv map[string]string
+
+func (e fakeEnv) Environ() []string {
+	var out []string
+	for k, v := range e {
+		out = append(out, k+"="+v)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (e fakeEnv) Getenv(k string) string { return e[k] }
+
+// fakeTTY answers the OSC 10/11 and cursor-position queries with a canned reply.
+type fakeTTY struct {
+	in  *bytes.Buffer
+	out bytes.Buffer
+}
+
+func (f *fakeTTY) Read(p []byte) (int, error)  { return f.in.Read(p) }
+func (f *fakeTTY) Write(p []byte) (int, error) { return f.out.Write(p) }
+func (f *fakeTTY) Fd() uintptr                 { return 0 }
+
+func newOutput(reply string, env fakeEnv) (*termenv.Output, *fakeTTY) {
+	f := &fakeTTY{in: bytes.NewBufferString(reply)}
+	return termenv.NewOutput(f, termenv.WithUnsafe(), termenv.WithTTY(true), termenv.WithEnvironment(env)), f
+}
+
+// x11Reply renders an rgb: reply with four-digit components (the form every terminal sends).
+func x11Reply(osc int, r, g, b int, tail string) string {
+	return fmt.Sprintf("\x1b]%d;rgb:%02x%02x/%02x%02x/%02x%02x%s", osc, r, r, g, g, b, b, tail)
+}
+
+func cursorReply(tc hegel.TestCase) string {
+	return fmt.Sprintf("\x1b[%d;%dR", n(tc, 1, 999), n(tc, 1, 999))
+}
+
+func isDark(hex string) bool {
+	c, _ := colorful.Hex(hex)
+	_, _, l := c.Hsl()
+	return l < 0.5
+}
+
+func TestHegelOutputReadsTheTerminalsColours(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r, g, b := n(ht, 0, 255), n(ht, 0, 255), n(ht, 0, 255)
+		hex := hexOf(r, g, b)
+		env := fakeEnv{"TERM": pick(ht, []string{"xterm", "xterm-256color", "alacritty", "foot"})}
+		var wantFG, wantBG termenv.Color = termenv.ANSIColor(7), termenv.ANSIColor(0)
+		if chance(ht, 50) {
+			f, bb := n(ht, 0, 15), n(ht, 0, 15)
+			env["COLORFGBG"] = fmt.Sprintf("%d;%d", f, bb)
+			if chance(ht, 30) {
+				env["COLORFGBG"] = fmt.Sprintf("%d;default;%d", f, bb)
+			}
+			wantFG, wantBG = termenv.ANSIColor(f), termenv.ANSIColor(bb)
+		}
+		answers := chance(ht, 70)
+		tail := pick(ht, []string{"\a", "\x1b\\"})
+		junk := ""
+		if chance(ht, 20) {
+			junk = pick(ht, []string{"x", "\r\n", "junk"})
+		}
+		queryFG := chance(ht, 50)
+		osc := 11
+		if queryFG {
+			osc = 10
+		}
+		reply := junk
+		if answers {
+			reply += x11Reply(osc, r, g, b, tail)
+		}
+		reply += cursorReply(ht)
+		note(ht, "env %v reply %q", env.Environ(), reply)
+
+		o, f := newOutput(reply, env)
+		var got termenv.Color
+		if queryFG {
+			got = o.ForegroundColor()
+		} else {
+			got = o.BackgroundColor()
+		}
+		want := wantBG
+		if queryFG {
+			want = wantFG
+		}
+		if answers {
+			want = termenv.RGBColor(hex)
+		}
+		if got != want {
+			fail(ht, "colour from reply %q with %v = %#v, want %#v", reply, env.Environ(), got, want)
+		}
+		if wantQ := fmt.Sprintf("\x1b]%d;?\x1b\\\x1b[6n", osc); f.out.String() != wantQ {
+			fail(ht, "queries written %q, want %q", f.out.String(), wantQ)
+		}
+		if f.in.Len() != 0 {
+			fail(ht, "%d bytes of the reply %q left unread", f.in.Len(), reply)
+		}
+		if !queryFG {
+			// HasDarkBackground re-queries; give it the same reply.
+			o2, _ := newOutput(reply, env)
+			wantDark := isDark(termenv.ConvertToRGB(want).Hex())
+			if dark := o2.HasDarkBackground(); dark != wantDark {
+				fail(ht, "HasDarkBackground with %#v = %v, want %v", want, dark, wantDark)
+			}
+		}
+		// A multiplexer or dumb terminal is never queried.
+		env2 := fakeEnv{"TERM": pick(ht, []string{"screen", "screen-256color", "tmux-256color", "dumb"})}
+		for k, v := range env {
+			if k != "TERM" {
+				env2[k] = v
+			}
+		}
+		o3, f3 := newOutput(reply, env2)
+		if got := o3.ForegroundColor(); got != wantFG || f3.out.Len() != 0 {
+			fail(ht, "%s: ForegroundColor = %#v (want %#v), wrote %q", env2["TERM"], got, wantFG, f3.out.String())
+		}
+		count("ok")
+	})
+}
