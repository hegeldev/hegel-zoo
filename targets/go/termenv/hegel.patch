+// ---------------------------------------------------------------- the environment rules
+
+func TestHegelEnvColorProfileFollowsNoColorAndCliColor(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		env := fakeEnv{"TERM": pick(ht, []string{"xterm-256color", "xterm", "dumb", "linux", "alacritty", "screen"})}
+		if chance(ht, 30) {
+			env["COLORTERM"] = pick(ht, []string{"truecolor", "24bit", "yes", "no"})
+		}
+		if chance(ht, 30) {
+			env["NO_COLOR"] = pick(ht, []string{"1", "true", "0", ""})
+		}
+		if chance(ht, 30) {
+			env["CLICOLOR"] = pick(ht, []string{"0", "1", ""})
+		}
+		if chance(ht, 30) {
+			env["CLICOLOR_FORCE"] = pick(ht, []string{"0", "1", "true", ""})
+		}
+		tty := chance(ht, 80)
+		note(ht, "env %v tty %v", env.Environ(), tty)
+		f := &fakeTTY{in: new(bytes.Buffer)}
+		o := termenv.NewOutput(f, termenv.WithTTY(tty), termenv.WithEnvironment(env))
+		base := o.ColorProfile()
+		if !tty && base != termenv.Ascii {
+			fail(ht, "ColorProfile without a TTY = %s", base.Name())
+		}
+		if !tty {
+			count("no-tty")
+		}
+		forced := env["CLICOLOR_FORCE"] != "" && env["CLICOLOR_FORCE"] != "0"
+		noColor := env["NO_COLOR"] != "" || env["CLICOLOR"] == "0" && !forced
+		if got := o.EnvNoColor(); got != noColor {
+			fail(ht, "EnvNoColor with %v = %v, want %v", env.Environ(), got, noColor)
+		}
+		want := base
+		switch {
+		case noColor:
+			want = termenv.Ascii
+		case forced && base == termenv.Ascii:
+			want = termenv.ANSI
+		}
+		if got := o.EnvColorProfile(); got != want {
+			fail(ht, "EnvColorProfile with %v = %s, want %s", env.Environ(), got.Name(), want.Name())
+		}
+		if o.Profile != want {
+			fail(ht, "NewOutput's profile = %s, EnvColorProfile %s", o.Profile.Name(), want.Name())
+		}
+		// Spot rules the comments state.
+		if tty {
+			ct := strings.ToLower(env["COLORTERM"])
+			switch {
+			case (ct == "truecolor" || ct == "24bit") && !strings.HasPrefix(env["TERM"], "screen"):
+				if base != termenv.TrueColor {
+					fail(ht, "COLORTERM=%s TERM=%s: %s", env["COLORTERM"], env["TERM"], base.Name())
+				}
+			case ct == "yes" || ct == "true":
+				if base != termenv.ANSI256 {
+					fail(ht, "COLORTERM=%s: %s", env["COLORTERM"], base.Name())
+				}
+			case env["TERM"] == "dumb":
+				if base != termenv.Ascii {
+					fail(ht, "TERM=dumb: %s", base.Name())
+				}
+			case strings.Contains(env["TERM"], "256color"):
+				if base != termenv.ANSI256 {
+					fail(ht, "TERM=%s: %s", env["TERM"], base.Name())
+				}
+			}
+		}
+		count("ok")
+	})
+}
