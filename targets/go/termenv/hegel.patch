+// termenv/3: a NoColor (or invalid RGBColor) in a style adds an empty SGR parameter, a reset.
+func TestHegelPinNoColorInAStyle(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		got, want string
+	}{
+		{termenv.String("x").Bold().Foreground(termenv.NoColor{}).String(), "\x1b[1mx\x1b[0m"},
+		{termenv.String("x").Foreground(termenv.NoColor{}).Bold().String(), "\x1b[1mx\x1b[0m"},
+		{termenv.String("x").Foreground(termenv.Ascii.Convert(termenv.ANSIColor(1))).Underline().String(), "\x1b[4mx\x1b[0m"},
+		{termenv.String("x").Bold().Background(termenv.RGBColor("#zz")).String(), "\x1b[1mx\x1b[0m"},
+	} {
+		if c.got != c.want {
+			t.Errorf("styled = %q, want %q", c.got, c.want)
+		}
+	}
+}
