+// termenv/4: Profile.Color accepts numbers outside 0-255, and the colour then panics.
+func TestHegelPinProfileColorOutOfRange(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"256", "300", "-1", "99999"} {
+		c := termenv.TrueColor.Color(s)
+		if c == nil {
+			continue
+		}
+		t.Errorf("TrueColor.Color(%q) = %#v (sequence %q), want nil", s, c, c.Sequence(false))
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("TrueColor.Color(%q).String() panics: %v", s, r)
+				}
+			}()
+			_ = c.(fmt.Stringer).String()
+		}()
+	}
+}
