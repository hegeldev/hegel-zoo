+// termenv/7: colour replies are judged by byte length: two-digit and rgba: replies are
+// rejected, five- and three-digit components accepted.
+func TestHegelPinColourReplyComponentWidths(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		reply string
+		want  termenv.Color
+	}{
+		{"\x1b]11;rgb:12/34/56\a", termenv.RGBColor("#123456")},
+		{"\x1b]11;rgb:1/3/5\a", termenv.RGBColor("#113355")},
+		{"\x1b]11;rgba:1212/3434/5656/ffff\a", termenv.RGBColor("#123456")},
+		{"\x1b]11;rgb:12121/3434/565\a", termenv.ANSIColor(0)},
+	} {
+		o, _ := newOutput(c.reply+"\x1b[1;1R", fakeEnv{"TERM": "xterm"})
+		if got := o.BackgroundColor(); got != c.want {
+			t.Errorf("BackgroundColor with reply %q = %#v, want %#v", c.reply, got, c.want)
+		}
+	}
+}
