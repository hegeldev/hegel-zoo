+// Hegel properties for muesli/termenv: colour conversion between profiles, the SGR sequences
+// of colours and styles, Profile.Color's parsing, the template helpers, and Output's reading of
+// the terminal's colours through a fake TTY.
+//
+// Oracles: the xterm 256-colour palette (computed, not copied), the SGR parameter table, the
+// documented conversion algorithm (tmux's colour_find_rgb with the HSLuv tie-break the code
+// chooses), the documented NO_COLOR/CLICOLOR rules, X11's rgb: reply format for OSC 10/11, and
+// a fake terminal that answers the queries. TERMENV_COLLECT=1 turns failures into a tally.
+package termenv_test
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"text/template"
+
+	"github.com/lucasb-eyer/go-colorful"
+	"github.com/muesli/termenv"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("TERMENV_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- the xterm palette
+
+var basic16 = []string{
+	"#000000", "#800000", "#008000", "#808000", "#000080", "#800080", "#008080", "#c0c0c0",
+	"#808080", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#ff00ff", "#00ffff", "#ffffff",
+}
+
+var cubeLevels = [6]int{0x00, 0x5f, 0x87, 0xaf, 0xd7, 0xff}
+
+// paletteRGB is the xterm palette: 16 basic colours, the 6x6x6 cube, 24 greys.
+func paletteRGB(i int) (int, int, int) {
+	switch {
+	case i < 16:
+		v, _ := strconv.ParseUint(basic16[i][1:], 16, 32)
+		return int(v >> 16), int(v >> 8 & 0xff), int(v & 0xff)
+	case i < 232:
+		i -= 16
+		return cubeLevels[i/36], cubeLevels[i/6%6], cubeLevels[i%6]
+	default:
+		g := 8 + 10*(i-232)
+		return g, g, g
+	}
+}
+
+func hexOf(r, g, b int) string { return fmt.Sprintf("#%02x%02x%02x", r, g, b) }
+
+func paletteHex(i int) string {
+	r, g, b := paletteRGB(i)
+	return hexOf(r, g, b)
+}
+
+func hsluvDist(r1, g1, b1, r2, g2, b2 int) float64 {
+	a := colorful.Color{R: float64(r1) / 255, G: float64(g1) / 255, B: float64(b1) / 255}
+	b := colorful.Color{R: float64(r2) / 255, G: float64(g2) / 255, B: float64(b2) / 255}
+	return a.DistanceHSLuv(b)
+}
+
+// to256 is the documented conversion (tmux's colour_find_rgb: nearest cube colour, nearest grey
+// from the average of the channels, then the nearer of the two — by HSLuv distance here, as the
+// code chooses).
+func to256(r, g, b int) int {
+	v2ci := func(v int) int {
+		if v < 48 {
+			return 0
+		}
+		if v < 115 {
+			return 1
+		}
+		return (v - 35) / 40
+	}
+	qr, qg, qb := v2ci(r), v2ci(g), v2ci(b)
+	cr, cg, cb := cubeLevels[qr], cubeLevels[qg], cubeLevels[qb]
+	ci := 36*qr + 6*qg + qb
+	avg := (r + g + b) / 3
+	grayIdx := 23
+	if avg <= 238 {
+		grayIdx = (avg - 3) / 10
+		if grayIdx < 0 {
+			grayIdx = 0
+		}
+	}
+	gv := 8 + 10*grayIdx
+	if hsluvDist(r, g, b, cr, cg, cb) <= hsluvDist(r, g, b, gv, gv, gv) {
+		return 16 + ci
+	}
+	return 232 + grayIdx
+}
+
+// to16 is the code's documented rule for 256 → 16: the nearest basic colour by HSLuv distance.
+func to16(i int) int {
+	r, g, b := paletteRGB(i)
+	best, bestD := 0, -1.0
+	for k := 0; k < 16; k++ {
+		kr, kg, kb := paletteRGB(k)
+		if d := hsluvDist(r, g, b, kr, kg, kb); bestD < 0 || d < bestD {
+			best, bestD = k, d
+		}
+	}
+	return best
+}
+
+var profiles = []termenv.Profile{termenv.TrueColor, termenv.ANSI256, termenv.ANSI, termenv.Ascii}
+
+func TestHegelPaletteConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		i := n(ht, 0, 255)
+		hex := paletteHex(i)
+		note(ht, "palette %d = %s", i, hex)
+		// The library's table agrees with the computed palette.
+		if i < 16 {
+			if got := termenv.ANSIColor(i).String(); got != hex {
+				fail(ht, "ANSIColor(%d).String() = %q, palette %q", i, got, hex)
+			}
+		}
+		if got := termenv.ANSI256Color(i).String(); got != hex {
+			fail(ht, "ANSI256Color(%d).String() = %q, palette %q", i, got, hex)
+		}
+		if got := termenv.ConvertToRGB(termenv.ANSI256Color(i)).Hex(); got != hex {
+			fail(ht, "ConvertToRGB(ANSI256Color(%d)).Hex() = %q, palette %q", i, got, hex)
+		}
+		// Identities.
+		for _, p := range profiles[:3] {
+			if i < 16 {
+				if got := p.Convert(termenv.ANSIColor(i)); got != termenv.ANSIColor(i) {
+					fail(ht, "%s.Convert(ANSIColor(%d)) = %v", p.Name(), i, got)
+				}
+			}
+			want := termenv.Color(termenv.ANSI256Color(i))
+			if p == termenv.ANSI {
+				want = termenv.ANSIColor(to16(i))
+			}
+			if got := p.Convert(termenv.ANSI256Color(i)); got != want {
+				fail(ht, "%s.Convert(ANSI256Color(%d)) = %v, want %v", p.Name(), i, got, want)
+			}
+		}
+		if got := termenv.Ascii.Convert(termenv.ANSI256Color(i)); got != (termenv.NoColor{}) {
+			fail(ht, "Ascii.Convert = %v", got)
+		}
+		// The palette entry's own RGB converts back to its index (greys 233–255: termenv/1).
+		if got := termenv.TrueColor.Convert(termenv.RGBColor(hex)); got != termenv.RGBColor(hex) {
+			fail(ht, "TrueColor.Convert(%q) = %v", hex, got)
+		}
+		if i >= 16 {
+			if i > 232 {
+				count("grey-skipped")
+			} else if got := termenv.ANSI256.Convert(termenv.RGBColor(hex)); got != termenv.ANSI256Color(i) {
+				fail(ht, "ANSI256.Convert(%q) = %v, want ANSI256Color(%d)", hex, got, i)
+			}
+		} else if got := termenv.ANSI.Convert(termenv.RGBColor(hex)); got != termenv.ANSIColor(i) {
+			fail(ht, "ANSI.Convert(%q) = %v, want ANSIColor(%d)", hex, got, i)
+		}
+		count("ok")
+	})
+}
+
+func TestHegelConvertFollowsTheDocumentedAlgorithm(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r, g, b := n(ht, 0, 255), n(ht, 0, 255), n(ht, 0, 255)
+		if chance(ht, 25) {
+			g, b = r, r // greys are where the algorithm has two candidates
+		}
+		hex := hexOf(r, g, b)
+		c := termenv.RGBColor(hex)
+		note(ht, "colour %s", hex)
+		want := to256(r, g, b)
+		got := termenv.ANSI256.Convert(c)
+		if want >= 232 {
+			// The code averages the cube indices instead of the channels, so its grey
+			// candidate is always #080808 and a grey is (almost) never chosen: termenv/1.
+			count("grey-expected")
+		} else if got == termenv.ANSI256Color(232) {
+			count("grey-232-chosen") // the same defect: #080808 wins over a dark cube colour
+		} else if got != termenv.ANSI256Color(want) {
+			fail(ht, "ANSI256.Convert(%q) = %v, want ANSI256Color(%d) (%s)", hex, got, want, paletteHex(want))
+		}
+		g256, ok := got.(termenv.ANSI256Color)
+		if !ok || g256 < 16 {
+			fail(ht, "ANSI256.Convert(%q) = %v, not a colour in 16–255", hex, got)
+		}
+		// Idempotent, and 16 colours through 256.
+		for _, p := range profiles {
+			once := p.Convert(c)
+			if twice := p.Convert(once); twice != once {
+				fail(ht, "%s.Convert is not idempotent on %q: %v then %v", p.Name(), hex, once, twice)
+			}
+		}
+		if got16, want16 := termenv.ANSI.Convert(c), termenv.ANSI.Convert(got); got16 != want16 {
+			fail(ht, "ANSI.Convert(%q) = %v, but through ANSI256 %v", hex, got16, want16)
+		}
+		a16, ok := termenv.ANSI.Convert(c).(termenv.ANSIColor)
+		if !ok || a16 < 0 || a16 > 15 {
+			fail(ht, "ANSI.Convert(%q) = %v", hex, termenv.ANSI.Convert(c))
+		}
+		// FromColor goes through the hex string.
+		if got := termenv.TrueColor.FromColor(color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}); got != c {
+			fail(ht, "TrueColor.FromColor(%s) = %v", hex, got)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- sequences and styles
+
+// exactChannel reports whether v survives the float round trip in RGBColor.Sequence
+// (termenv/2 for the others).
+func exactChannel(v int) bool {
+	c, _ := colorful.Hex(hexOf(v, v, v))
+	return int(uint8(c.R*255)) == v
+}
+
+func seqOf(c termenv.Color, bg bool) string {
+	off := 0
+	if bg {
+		off = 10
+	}
+	switch v := c.(type) {
+	case termenv.ANSIColor:
+		if v < 8 {
+			return strconv.Itoa(30 + off + int(v))
+		}
+		return strconv.Itoa(90 + off + int(v) - 8)
+	case termenv.ANSI256Color:
+		return fmt.Sprintf("%d;5;%d", 38+off, int(v))
+	case termenv.RGBColor:
+		r, g, b := hexRGB(string(v))
+		return fmt.Sprintf("%d;2;%d;%d;%d", 38+off, r, g, b)
+	}
+	return ""
+}
+
+// hexRGB reads #rrggbb and #rgb.
+func hexRGB(h string) (int, int, int) {
+	h = h[1:]
+	if len(h) == 3 {
+		h = string([]byte{h[0], h[0], h[1], h[1], h[2], h[2]})
+	}
+	v, _ := strconv.ParseUint(h, 16, 32)
+	return int(v >> 16), int(v >> 8 & 0xff), int(v & 0xff)
+}
+
+func genRGBHex(tc hegel.TestCase, exact bool) string {
+	ch := func() int {
+		for {
+			v := n(tc, 0, 255)
+			if !exact || exactChannel(v) {
+				return v
+			}
+		}
+	}
+	if chance(tc, 15) {
+		// #rgb: every channel is v*17, always exact
+		return fmt.Sprintf("#%x%x%x", n(tc, 0, 15), n(tc, 0, 15), n(tc, 0, 15))
+	}
+	return hexOf(ch(), ch(), ch())
+}
+
+func TestHegelColourSequencesFollowTheSGRTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		bg := chance(ht, 50)
+		var c termenv.Color
+		switch n(ht, 0, 2) {
+		case 0:
+			c = termenv.ANSIColor(n(ht, 0, 15))
+		case 1:
+			c = termenv.ANSI256Color(n(ht, 0, 255))
+		default:
+			c = termenv.RGBColor(genRGBHex(ht, true))
+		}
+		note(ht, "%T %v bg=%v", c, c, bg)
+		if got, want := c.Sequence(bg), seqOf(c, bg); got != want {
+			fail(ht, "%T(%v).Sequence(%v) = %q, want %q", c, c, bg, got, want)
+		}
+		if rgb, ok := c.(termenv.RGBColor); ok {
+			r, g, b := hexRGB(string(rgb))
+			if got := termenv.ConvertToRGB(rgb).Hex(); got != hexOf(r, g, b) {
+				fail(ht, "ConvertToRGB(%q).Hex() = %q", rgb, got)
+			}
+		}
+		count("ok")
+	})
+}
+
+type styleStep struct {
+	name string
+	seq  string // expected parameter text, "" for none
+}
+
+func genColor(tc hegel.TestCase, allowNoColor bool) (termenv.Color, string) {
+	switch n(tc, 0, 4) {
+	case 0:
+		return nil, ""
+	case 1:
+		c := termenv.ANSIColor(n(tc, 0, 15))
+		return c, "ansi"
+	case 2:
+		c := termenv.ANSI256Color(n(tc, 0, 255))
+		return c, "ansi256"
+	case 3:
+		if allowNoColor && chance(tc, 30) {
+			return termenv.NoColor{}, "nocolor"
+		}
+		return termenv.RGBColor(genRGBHex(tc, true)), "rgb"
+	default:
+		return termenv.RGBColor(genRGBHex(tc, true)), "rgb"
+	}
+}
+
+// genStyle builds a Style through its methods and returns the parameter texts the SGR table
+// gives for each step (a nil colour adds nothing; NoColor is documented as a nop).
+func genStyle(tc hegel.TestCase, p termenv.Profile, text string, allowNoColor bool) (termenv.Style, []string, bool) {
+	st := p.String(text)
+	var seqs []string
+	sawNoColor := false
+	for i := n(tc, 0, 5); i > 0; i-- {
+		switch n(tc, 0, 9) {
+		case 0:
+			st = st.Bold()
+			seqs = append(seqs, "1")
+		case 1:
+			st = st.Faint()
+			seqs = append(seqs, "2")
+		case 2:
+			st = st.Italic()
+			seqs = append(seqs, "3")
+		case 3:
+			st = st.Underline()
+			seqs = append(seqs, "4")
+		case 4:
+			st = st.Overline()
+			seqs = append(seqs, "53")
+		case 5:
+			st = st.Blink()
+			seqs = append(seqs, "5")
+		case 6:
+			st = st.Reverse()
+			seqs = append(seqs, "7")
+		case 7:
+			st = st.CrossOut()
+			seqs = append(seqs, "9")
+		default:
+			c, kind := genColor(tc, allowNoColor)
+			bg := chance(tc, 50)
+			if bg {
+				st = st.Background(c)
+			} else {
+				st = st.Foreground(c)
+			}
+			switch kind {
+			case "":
+			case "nocolor":
+				sawNoColor = true
+			default:
+				seqs = append(seqs, seqOf(c, bg))
+			}
+		}
+	}
+	return st, seqs, sawNoColor
+}
+
+func styledModel(p termenv.Profile, seqs []string, text string) string {
+	if p == termenv.Ascii || len(seqs) == 0 {
+		return text
+	}
+	return "\x1b[" + strings.Join(seqs, ";") + "m" + text + "\x1b[0m"
+}
+
+var texts = []string{"", "x", "hello", "日本", "a b", "\x1b[1m"}
+
+func TestHegelStyledFollowsTheSGRTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := pick(ht, profiles)
+		text := pick(ht, texts)
+		st, seqs, sawNoColor := genStyle(ht, p, text, true)
+		note(ht, "profile %s text %q steps %v", p.Name(), text, seqs)
+		got := st.String()
+		if sawNoColor && p != termenv.Ascii {
+			count("nocolor-skipped") // termenv/3
+		} else if want := styledModel(p, seqs, text); got != want {
+			fail(ht, "%s Style %v on %q = %q, want %q", p.Name(), seqs, text, got, want)
+		}
+		if got2 := st.Styled(text); got2 != got {
+			fail(ht, "Styled(%q) = %q, String() = %q", text, got2, got)
+		}
+		// String(a, b) joins with a space; Width is the text's width.
+		parts := []string{pick(ht, texts), pick(ht, texts)}
+		joined := strings.Join(parts, " ")
+		if got := termenv.String(parts...).String(); got != joined {
+			fail(ht, "String(%q) = %q", parts, got)
+		}
+		if w := p.String(text).Width(); w != termenv.String(text).Width() {
+			fail(ht, "Width differs between profiles: %d vs %d", w, termenv.String(text).Width())
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- Profile.Color
+
+func TestHegelProfileColorParsesTheDocumentedForms(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := pick(ht, profiles)
+		var s string
+		var want termenv.Color
+		switch n(ht, 0, 4) {
+		case 0:
+			s = genRGBHex(ht, false)
+			want = p.Convert(termenv.RGBColor(s))
+		case 1:
+			i := n(ht, 0, 15)
+			s = strconv.Itoa(i)
+			want = p.Convert(termenv.ANSIColor(i))
+		case 2:
+			i := n(ht, 16, 255)
+			s = strconv.Itoa(i)
+			want = p.Convert(termenv.ANSI256Color(i))
+		case 3:
+			s = pick(ht, []string{"", "#", "#abcd", "#gggggg", "red", "1e2", "0x10", " 5", "5 ", "#12345", "#1234567", "rgb:00/00/00"})
+			want = nil
+		default:
+			// Out of the documented 0–255 range: nil expected (termenv/4 pinned).
+			count("out-of-range-skipped")
+			return
+		}
+		note(ht, "%s.Color(%q)", p.Name(), s)
+		got := p.Color(s)
+		if want == nil {
+			if p == termenv.Ascii && strings.HasPrefix(s, "#") {
+				want = termenv.NoColor{} // Ascii.Convert does not look at the hex string
+			} else if got != nil {
+				fail(ht, "%s.Color(%q) = %#v, want nil", p.Name(), s, got)
+			}
+		}
+		if want == nil {
+			count("invalid")
+			return
+		}
+		if got != want {
+			fail(ht, "%s.Color(%q) = %#v, want %#v", p.Name(), s, got, want)
+		}
+		if p == termenv.Ascii {
+			if got != (termenv.NoColor{}) {
+				fail(ht, "Ascii.Color(%q) = %#v", s, got)
+			}
+		} else if _, ok := got.(termenv.NoColor); ok {
+			fail(ht, "%s.Color(%q) = NoColor", p.Name(), s)
+		}
+		count("ok")
+	})
+}
