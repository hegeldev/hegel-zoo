+// TestHegelPrintedProgramsParseAndRunTheSame: Query.String() of a parsed program is accepted
+// by gojq and by jq, prints the same again, and runs to the same outcome as the original text.
+func TestHegelPrintedProgramsParseAndRunTheSame(t *testing.T) {
+	needJQ(t)
+	property(t, func(ht *hegel.T) {
+		progText, _, inputText, _, varText := drawCase(ht)
+		q, err := Parse(progText)
+		if err != nil {
+			note(ht, "program does not parse (checked by the differential): %v", err)
+			return
+		}
+		printed := q.String()
+		note(ht, "program: %s\nprinted: %s\ninput: %s", progText, printed, inputText)
+		q2, err := Parse(printed)
+		if err != nil {
+			ht.Fatalf("Query.String() output does not parse\n  original: %s\n  printed:  %s\n  error: %v", progText, printed, err)
+		}
+		if p2 := q2.String(); p2 != printed {
+			ht.Fatalf("Query.String() is not a fixpoint\n  original: %s\n  printed:  %s\n  again:    %s", progText, printed, p2)
+		}
+		gin := asNumbers(inputText)
+		gvar := asNumbers(varText)
+		g1, t1 := runGojq(progText, gin, map[string]any{"v": gvar})
+		g2, _ := runGojq(printed, gin, map[string]any{"v": gvar})
+		if collect && t1 > time.Second {
+			fmt.Printf("SLOW gojq %v: %s ⟵ %s ($v %s)\n", t1, progText, inputText, varText)
+		}
+		if g1.status == "timeout" || g2.status == "timeout" {
+			return
+		}
+		if !sameOutcome(g1, g2) {
+			ht.Fatalf("printed program runs differently in gojq\n  original: %s → %s\n  printed:  %s → %s\n  input: %s", progText, g1, printed, g2, inputText)
+		}
+		j1, t1 := runJQ(progText, inputText, map[string]string{"v": varText})
+		j2, t2 := runJQ(printed, inputText, map[string]string{"v": varText})
+		if j1.status == "timeout" || j2.status == "timeout" || t1 > 5*time.Second || t2 > 5*time.Second {
+			return
+		}
+		if j2.status == "compile" && j1.status != "compile" {
+			ht.Fatalf("jq rejects gojq's printed form of a program jq accepted\n  original: %s\n  printed:  %s\n  jq: %s", progText, printed, j2.detail)
+		}
+	})
+}
