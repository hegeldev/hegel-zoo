+// TestHegelStringFormatsAgreeWithJq: the @formats, tostring/tojson and string functions on
+// generated (literal, canonical) values agree with jq, including numbers, which both print
+// as the literal text for canonical literals.
+const computedGuard = `numbers | . * 3 / 7 | select(fabs >= 0.0001 and fabs < 1e16)`
+
+func TestHegelStringFormatsAgreeWithJq(t *testing.T) {
+	needJQ(t)
+	formats := []string{
+		"tostring", "tojson", "@text", "@json", "@html", "@uri", "@base64", "@base64 | @base64d", "@base32", "@base32 | @base32d", "@sh",
+		"[.] | @csv", "[.] | @tsv", "[.[]?] | @csv", "[.[]?] | @tsv", "[.[]?] | @sh", "\"<\\(.)>\"", "@json \"v=\\(.)\"", "@html \"v=\\(.)\"",
+		"@uri \"v=\\(.)\"", "@sh \"v=\\(.)\"", "@base64 \"v=\\(.)\"", "@csv \"v=\\([.])\"", "@tsv \"v=\\([.])\"", "tojson | fromjson",
+		"tostring | length", "tojson | utf8bytelength", "tojson | explode | implode", "tostring | ascii_downcase", "tostring | ascii_upcase",
+		"tostring | split(\"\")", "tostring | [splits(\"[,:]\")]", "tostring | test(\"^[0-9]\")", "tostring | ltrimstr(\"-\")", "tostring | tonumber?",
+		"[.[]? | tostring] | join(\"|\")", "[.[]?] | join(\",\")?", "tostring | trim", "tostring | .[1:3]", "tostring | indices(\"a\")",
+		"tostring | gsub(\"\"; \"-\")", "tostring | [match(\"\"; \"g\") | .offset]", "tostring | sub(\"(?<x>.)\"; \"[\\(.x)]\")", "tostring | ascii",
+		"tostring | @base32d", "tojson | @sh", "tojson | @uri | @base64", "[tostring, tojson] | @csv", "[tostring, tojson] | @tsv",
+		// computed floats print the same in both within [1e-4, 1e16): both use the shortest
+		// round-trip digits; outside, jq switches to exponent notation earlier than gojq
+		computedGuard + " | tostring", computedGuard + " | tojson", computedGuard + " | [.] | @csv", computedGuard + " | @sh",
+		computedGuard + " | \"\\(.)\"", computedGuard + " | @text", computedGuard + " | tostring | tonumber",
+		"[.[]? | numbers] | map(. * 3 / 7) | map(select(fabs >= 0.0001 and fabs < 1e16)) | map(tostring)",
+	}
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		text := render(v)
+		f := pick(ht, formats)
+		note(ht, "input: %s\nformat: %s", text, f)
+		if strings.Contains(f, `""`) && !isASCII(text) {
+			return // jq's duplicate empty matches on multibyte strings, see simpleRegexes
+		}
+		numbers := chance(ht, 50)
+		g, j, ok := runBoth(ht, f, text, "null", numbers)
+		if !ok {
+			return
+		}
+		if !sameOutcome(g, j) {
+			disagree(ht, "gojq and jq disagree on %s\n  input: %s\n  gojq: %s\n  jq:   %s", f, text, g, j)
+		}
+	})
+}
