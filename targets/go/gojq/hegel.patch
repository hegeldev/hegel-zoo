+// TestHegelProgramsAgreeWithJq: a generated program on a generated input produces the same
+// outputs and the same kind of ending (values / runtime error / compile error) in gojq and jq.
+func TestHegelProgramsAgreeWithJq(t *testing.T) {
+	needJQ(t)
+	property(t, func(ht *hegel.T) {
+		progText, _, inputText, _, varText := drawCase(ht)
+		numbers := chance(ht, 50)
+		note(ht, "program: %s\ninput: %s\n$v: %s\nnumbers=%v", progText, inputText, varText, numbers)
+		if collect {
+			fmt.Printf("CASE %s ⟵ %s\n", progText, inputText)
+		}
+		g, j, ok := runBoth(ht, progText, inputText, varText, numbers)
+		if !ok {
+			return
+		}
+		if collect {
+			d := ""
+			if g.status != "ok" {
+				d = g.detail
+			}
+			fmt.Printf("STATUS %s %d %s\n", g.status, len(g.outs), d)
+		}
+		if !sameOutcome(g, j) {
+			disagree(ht, "gojq and jq disagree\n  program: %s\n  input:   %s\n  $v:      %s\n  gojq: %s\n  jq:   %s", progText, inputText, varText, g, j)
+		}
+	})
+}
