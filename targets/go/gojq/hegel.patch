+	for _, text := range []string{"0.5", "1", "2", "3.5", "10", "-1.5"} {
+		g, _ := runGojq("[gamma, lgamma] | .[0] - .[1] | fabs < 1e-9", asNumbers(text), nil)
+		j, _ := runJQ("[gamma, lgamma] | .[0] - .[1] | fabs < 1e-9", text, nil)
+		if !sameOutcome(g, j) || len(g.outs) != 1 || g.outs[0] != "true" {
+			gv, _ := runGojq("[gamma, lgamma]", asNumbers(text), nil)
+			jv, _ := runJQ("[gamma, lgamma]", text, nil)
+			t.Errorf("%s | [gamma, lgamma]: gojq %s, jq %s", text, gv, jv)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- helpers
+
+func mustRun(t *testing.T, progText string, input any) []any {
+	t.Helper()
+	q, err := Parse(progText)
+	if err != nil {
+		t.Fatalf("parse %q: %v", progText, err)
+	}
+	iter := q.Run(input)
+	var outs []any
+	for {
+		v, ok := iter.Next()
+		if !ok {
+			break
+		}
+		outs = append(outs, v)
+	}
+	return outs
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= utf8.RuneSelf {
+			return false
+		}
+	}
+	return true
+}
