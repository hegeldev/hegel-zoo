+// TestHegelCompareIsATotalOrderAgreeingWithJq: Compare is antisymmetric and transitive over
+// generated values (in int/float64 and json.Number spellings), equal spellings of a number
+// compare equal, and its order is jq's sort order.
+func TestHegelCompareIsATotalOrderAgreeingWithJq(t *testing.T) {
+	needJQ(t)
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 2, 6)
+		vals := make([]any, k)
+		texts := make([]string, k)
+		for i := range vals {
+			vals[i] = genValue(ht, 2)
+			texts[i] = render(vals[i])
+		}
+		note(ht, "values: %s", strings.Join(texts, " "))
+		// spellings
+		alt := make([]any, k)
+		for i := range vals {
+			if chance(ht, 50) {
+				alt[i] = asNumbers(texts[i])
+			} else {
+				alt[i] = vals[i]
+			}
+		}
+		for i := range vals {
+			if c := Compare(vals[i], alt[i]); c != 0 {
+				ht.Fatalf("Compare(%s, same value as %T) = %d", texts[i], alt[i], c)
+			}
+			for j := range vals {
+				a, b := Compare(alt[i], alt[j]), Compare(alt[j], alt[i])
+				if a != -b {
+					ht.Fatalf("Compare not antisymmetric: Compare(%s, %s) = %d, reversed %d", texts[i], texts[j], a, b)
+				}
+				for l := range vals {
+					if Compare(alt[i], alt[j]) <= 0 && Compare(alt[j], alt[l]) <= 0 && Compare(alt[i], alt[l]) > 0 {
+						ht.Fatalf("Compare not transitive on %s, %s, %s", texts[i], texts[j], texts[l])
+					}
+				}
+			}
+		}
+		sorted := append([]any{}, alt...)
+		sort.SliceStable(sorted, func(i, j int) bool { return Compare(sorted[i], sorted[j]) < 0 })
+		j, _ := runJQ("sort", "["+strings.Join(texts, ",")+"]", nil)
+		if j.status != "ok" || len(j.outs) != 1 {
+			ht.Fatalf("jq sort failed: %s", j)
+		}
+		if got := canon(sorted); got != j.outs[0] {
+			ht.Fatalf("Compare order differs from jq's sort\n  values: %s\n  gojq:   %s\n  jq:     %s", strings.Join(texts, " "), got, j.outs[0])
+		}
+	})
+}
