diff --git a/hegel/Oracle.java b/hegel/Oracle.java
new file mode 100644
index 0000000..596bc3e
--- /dev/null
+++ b/hegel/Oracle.java
@@ -0,0 +1,87 @@
+// The Hegel zoo's oracle for magiconair/properties: java.util.Properties in a
+// child process. One request per line on stdin, one answer per line on
+// stdout. Strings travel as "x" followed by the hex of their UTF-8 bytes
+// (so the empty string is "x").
+//
+//   load <text> [iso]      -> ok <n> <key> <value> ...   (sorted by key)
+//   store <key> <value> ... -> ok <text>
+//   anything else, or an exception -> error <message>
+//
+// Run as `java Oracle.java` (the source launcher, Java 11+).
+
+import java.io.ByteArrayInputStream;
+import java.io.FileDescriptor;
+import java.io.FileOutputStream;
+import java.io.InputStreamReader;
+import java.io.PrintStream;
+import java.io.StringWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.Properties;
+import java.util.TreeMap;
+
+public class Oracle {
+    static String hex(String s) {
+        byte[] b = s.getBytes(StandardCharsets.UTF_8);
+        StringBuilder sb = new StringBuilder("x");
+        for (byte x : b) {
+            sb.append(String.format("%02x", x & 0xff));
+        }
+        return sb.toString();
+    }
+
+    static byte[] unhexBytes(String s) {
+        if (s.isEmpty() || s.charAt(0) != 'x') {
+            throw new IllegalArgumentException("bad string field: " + s);
+        }
+        byte[] b = new byte[(s.length() - 1) / 2];
+        for (int i = 0; i < b.length; i++) {
+            b[i] = (byte) Integer.parseInt(s.substring(1 + 2 * i, 3 + 2 * i), 16);
+        }
+        return b;
+    }
+
+    static String unhex(String s) {
+        return new String(unhexBytes(s), StandardCharsets.UTF_8);
+    }
+
+    public static void main(String[] args) throws Exception {
+        java.io.BufferedReader in = new java.io.BufferedReader(
+            new InputStreamReader(System.in, StandardCharsets.UTF_8));
+        PrintStream out = new PrintStream(new FileOutputStream(FileDescriptor.out), true, "UTF-8");
+        String line;
+        while ((line = in.readLine()) != null) {
+            try {
+                String[] f = line.trim().split(" ");
+                if (f[0].equals("load")) {
+                    byte[] b = unhexBytes(f[1]);
+                    boolean iso = f.length > 2 && f[2].equals("iso");
+                    Properties p = new Properties();
+                    p.load(new InputStreamReader(new ByteArrayInputStream(b),
+                        iso ? StandardCharsets.ISO_8859_1 : StandardCharsets.UTF_8));
+                    TreeMap<String, String> m = new TreeMap<>();
+                    for (String k : p.stringPropertyNames()) {
+                        m.put(k, p.getProperty(k));
+                    }
+                    StringBuilder sb = new StringBuilder("ok " + m.size());
+                    for (Map.Entry<String, String> e : m.entrySet()) {
+                        sb.append(' ').append(hex(e.getKey())).append(' ').append(hex(e.getValue()));
+                    }
+                    out.println(sb);
+                } else if (f[0].equals("store")) {
+                    Properties p = new Properties();
+                    for (int i = 1; i + 1 < f.length; i += 2) {
+                        p.setProperty(unhex(f[i]), unhex(f[i + 1]));
+                    }
+                    StringWriter w = new StringWriter();
+                    p.store(w, null);
+                    out.println("ok " + hex(w.toString()));
+                } else {
+                    out.println("error " + hex("unknown request: " + f[0]));
+                }
+            } catch (Exception e) {
+                out.println("error " + hex(e.toString()));
+            }
+        }
+    }
+}
