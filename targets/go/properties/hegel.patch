+package hegel
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..51f3c26
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,140 @@
+package hegel
+
+import (
+	"bytes"
+	"reflect"
+	"testing"
+
+	"github.com/magiconair/properties"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expected maps are what java.util.Properties.load
+// gives for the same text (checked with OpenJDK 25) and what the format's
+// specification, the Properties javadoc, says.
+
+func loadUTF8(t *testing.T, text string) map[string]string {
+	t.Helper()
+	m, err := goLoad(text, false)
+	if err != nil {
+		t.Fatalf("load %q: %v", text, err)
+	}
+	return m
+}
+
+func expectLoad(t *testing.T, text string, want map[string]string) {
+	t.Helper()
+	got, err := goLoad(text, false)
+	if err != nil {
+		t.Errorf("load %q: %v; Java gives %v", text, err, want)
+		return
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("load %q = %q; Java gives %q", text, got, want)
+	}
+}
+
+// properties/1: a backslash before a line end continues the logical line
+// wherever it is, in the key too.
+func TestHegelPinKeyContinuation(t *testing.T) {
+	expectLoad(t, "a\\\nb=c", map[string]string{"ab": "c"})
+	expectLoad(t, "a\\\n  b c", map[string]string{"ab": "c"})
+}
+
+// properties/2: a backslash at the very end of the input is dropped, not
+// an error.
+func TestHegelPinTrailingBackslashAtEOF(t *testing.T) {
+	expectLoad(t, "a=b\\", map[string]string{"a": "b"})
+	expectLoad(t, "a\\", map[string]string{"a": ""})
+}
+
+// properties/3: a line beginning with the separator has the empty key.
+func TestHegelPinEmptyKey(t *testing.T) {
+	expectLoad(t, "=v", map[string]string{"": "v"})
+	expectLoad(t, ":x\nk=y", map[string]string{"": "x", "k": "y"})
+}
+
+// properties/4: a continuation before CR LF joins the next line; the LF is
+// part of the line terminator, not a line of its own.
+func TestHegelPinCRLFContinuation(t *testing.T) {
+	expectLoad(t, "a=b\\\r\nc", map[string]string{"a": "bc"})
+	expectLoad(t, "a=b\\\r\n  c\r\nd=e", map[string]string{"a": "bc", "d": "e"})
+}
+
+// properties/9: a continuation between the key and the separator: the
+// separator still belongs to the logical line's separator, not to the value.
+func TestHegelPinSeparatorAfterContinuation(t *testing.T) {
+	expectLoad(t, "a \\\n= v", map[string]string{"a": "v"})
+	expectLoad(t, "a \\\n  :", map[string]string{"a": ""})
+}
+
+// properties/5: two \u literals forming a surrogate pair are one
+// supplementary character.
+func TestHegelPinSurrogatePair(t *testing.T) {
+	expectLoad(t, "k=\\uD83D\\uDE00", map[string]string{"k": "\U0001F600"})
+	expectLoad(t, "\\uD801\\uDC0A=v", map[string]string{"\U0001040A": "v"})
+}
+
+// properties/6: Write does not escape a key's leading # or !, so the line is
+// a comment when read back (by this package as much as by Java).
+func TestHegelPinWriteEscapesCommentMarkers(t *testing.T) {
+	for _, key := range []string{"!a", "#b"} {
+		p := properties.NewProperties()
+		p.DisableExpansion = true
+		p.MustSet(key, "v")
+		var buf bytes.Buffer
+		if _, err := p.Write(&buf, properties.UTF8); err != nil {
+			t.Fatal(err)
+		}
+		got := loadUTF8(t, buf.String())
+		if want := map[string]string{key: "v"}; !reflect.DeepEqual(got, want) {
+			t.Errorf("Write(%q = v) wrote %q, which loads as %q (Java: the same, a comment line); want %q", key, buf.String(), got, want)
+		}
+	}
+}
+
+// properties/7: Write with ISO_8859_1 emits characters U+0080-U+00FF as
+// their UTF-8 bytes instead of the single Latin-1 byte, so an ISO-8859-1
+// reader (Java's, or this package's Load) sees two characters.
+func TestHegelPinWriteISOLatin1(t *testing.T) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	p.MustSet("\u00e9", "\u00fc")
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, properties.ISO_8859_1); err != nil {
+		t.Fatal(err)
+	}
+	if want := "\xe9 = \xfc\n"; buf.String() != want {
+		t.Errorf("Write(ISO_8859_1) = %q; want the Latin-1 bytes %q", buf.String(), want)
+	}
+	got, err := goLoad(buf.String(), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := map[string]string{"\u00e9": "\u00fc"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("Write(ISO_8859_1) then Load(ISO_8859_1) = %q; want %q", got, want)
+	}
+}
+
+// properties/8: Write with ISO_8859_1 emits a leading Unicode whitespace
+// character above U+00FF (U+2028, U+3000, ...) raw instead of as \uXXXX,
+// because the leading-whitespace case comes before the range cases.
+func TestHegelPinWriteISOLeadingUnicodeSpace(t *testing.T) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	p.MustSet("k", "\u2028x")
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, properties.ISO_8859_1); err != nil {
+		t.Fatal(err)
+	}
+	if want := "k = \\u2028x\n"; buf.String() != want {
+		t.Errorf("Write(ISO_8859_1) = %q; want %q", buf.String(), want)
+	}
+	got, err := goLoad(buf.String(), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := map[string]string{"k": "\u2028x"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("Write(ISO_8859_1) then Load(ISO_8859_1) = %q; want %q", got, want)
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..0b2a6f1
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,379 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/magiconair/properties"
+)
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// word pieces for keys and values: plain text, the characters the format
+// cares about (separators, comment markers, whitespace), non-ASCII.
+var plainPieces = []string{"a", "b", "key", "x1", "-", ".", "_", "A", "0", "ab", "é", "日", "ß"}
+var rawSpecialPieces = []string{" ", "\t", "\f", "=", ":", "#", "!", "\\"}
+
+// escPieces are escape sequences as they appear in a .properties text.
+var escPieces = []string{
+	`\ `, `\:`, `\=`, `\#`, `\!`, `\\`, `\n`, `\t`, `\r`, `\f`,
+	`\a`, `\q`, `\0`, `\"`, `\'`, `\-`,
+}
+
+// genUnicodeLiteral is a \uXXXX literal; sometimes a surrogate pair, which
+// Java combines into one supplementary character.
+func genUnicodeLiteral(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1:
+		return fmt.Sprintf(`\u%04X\u%04X`, 0xD800+n(tc, 0, 0x3FF), 0xDC00+n(tc, 0, 0x3FF))
+	case 2:
+		return fmt.Sprintf(`\u%04x`, n(tc, 1, 0x7F))
+	case 3:
+		return fmt.Sprintf(`\u%04X`, pick(tc, 0x20, 0x3D, 0x3A, 0x23, 0x21, 0x5C, 0x0A, 0x0D, 0x09, 0x0C))
+	default:
+		r := n(tc, 0x80, 0xFFFF)
+		if r >= 0xD800 && r <= 0xDFFF {
+			r = 0x263A
+		}
+		if chance(tc, 50) {
+			return fmt.Sprintf(`\u%04x`, r)
+		}
+		return fmt.Sprintf(`\u%04X`, r)
+	}
+}
+
+// genKeyText generates the text of a key, escapes included.
+func genKeyText(tc hegel.TestCase) string {
+	var b strings.Builder
+	k := n(tc, 1, 3)
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 12) {
+		case 1, 2, 3, 4, 5, 6:
+			b.WriteString(pick(tc, plainPieces...))
+		case 7, 8:
+			b.WriteString(pick(tc, escPieces...))
+		case 9:
+			b.WriteString(genUnicodeLiteral(tc))
+		case 10:
+			b.WriteString(pick(tc, rawSpecialPieces...))
+		case 11:
+			b.WriteString(genContinuation(tc))
+		default:
+			b.WriteString(pick(tc, "1", "2", "kk", "K"))
+		}
+	}
+	return b.String()
+}
+
+// genValueText generates the text of a value, escapes included.
+func genValueText(tc hegel.TestCase) string {
+	var b strings.Builder
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 12) {
+		case 1, 2, 3, 4, 5:
+			b.WriteString(pick(tc, plainPieces...))
+		case 6, 7:
+			b.WriteString(pick(tc, escPieces...))
+		case 8:
+			b.WriteString(genUnicodeLiteral(tc))
+		case 9, 10:
+			b.WriteString(pick(tc, rawSpecialPieces...))
+		case 11:
+			b.WriteString(genContinuation(tc))
+		default:
+			b.WriteString(pick(tc, " ", "  ", "\t"))
+		}
+	}
+	return b.String()
+}
+
+// genContinuation is a backslash before a line end, then the next line's
+// leading whitespace (which the format drops).
+func genContinuation(tc hegel.TestCase) string {
+	return `\` + pick(tc, "\n", "\n", "\r\n", "\r") + pick(tc, "", "", " ", "\t", "   ")
+}
+
+func genSeparator(tc hegel.TestCase) string {
+	return pick(tc, "=", "=", ":", " ", " = ", "\t:\t", " =", "= ", "  ", "\f", ":=", "==", ": ", "\t")
+}
+
+func genEOL(tc hegel.TestCase) string {
+	return pick(tc, "\n", "\n", "\n", "\r\n", "\r")
+}
+
+// genText generates a .properties text. Under HEGEL_NO_KNOWN the shapes of
+// the known bugs are avoided (the text is regenerated until it has none).
+func genText(tc hegel.TestCase) string {
+	for {
+		text := genTextOnce(tc)
+		if !noKnown {
+			return text
+		}
+		if !shapeOf(text).hasKnown() {
+			return text
+		}
+	}
+}
+
+func genTextOnce(tc hegel.TestCase) string {
+	var b strings.Builder
+	k := n(tc, 0, 6)
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 20) {
+		case 1, 2:
+			b.WriteString(pick(tc, "", " ", "\t", "\f", "   "))
+			b.WriteString(pick(tc, "#", "!"))
+			b.WriteString(pick(tc, "", " comment", " a=b", ` end\`, " \\u00", "日"))
+		case 3:
+			b.WriteString(pick(tc, "", " ", "\t", "\f"))
+		case 4:
+			// a value-only line
+			b.WriteString(genSeparator(tc))
+			b.WriteString(genValueText(tc))
+		default:
+			if chance(tc, 15) {
+				b.WriteString(pick(tc, " ", "\t", "\f"))
+			}
+			b.WriteString(genKeyText(tc))
+			if chance(tc, 85) {
+				b.WriteString(genSeparator(tc))
+				b.WriteString(genValueText(tc))
+			}
+		}
+		if i < k-1 || chance(tc, 70) {
+			b.WriteString(genEOL(tc))
+		} else if chance(tc, 20) {
+			b.WriteString(`\`) // a backslash at the very end
+		}
+	}
+	return b.String()
+}
+
+// genMap generates a key/value map with arbitrary characters.
+func genMap(tc hegel.TestCase) map[string]string {
+	m := map[string]string{}
+	k := n(tc, 1, 5)
+	for i := 0; i < k; i++ {
+		key := genRaw(tc, 1, 3)
+		if key == "" {
+			continue
+		}
+		m[key] = genRaw(tc, 0, 4)
+	}
+	return m
+}
+
+// genRaw generates a string of raw characters (no escapes: this is a value
+// in memory, not text).
+func genRaw(tc hegel.TestCase, lo, hi int) string {
+	var b strings.Builder
+	k := n(tc, lo, hi)
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 10) {
+		case 1, 2, 3, 4, 5:
+			b.WriteString(pick(tc, plainPieces...))
+		case 6, 7:
+			b.WriteString(pick(tc, rawSpecialPieces...))
+		case 8:
+			b.WriteString(pick(tc, "\n", "\r", "\r\n", "\u00a0", "\u0085", "\u2028", "\x00", "\x01", "\x7f"))
+		case 9:
+			b.WriteRune(rune(n(tc, 0x80, 0xFFFF)))
+		default:
+			b.WriteString(pick(tc, "😀", "\U0001F600x", "\U00010000"))
+		}
+	}
+	s := b.String()
+	// Lone surrogates cannot be generated by the rune draw above (a rune in
+	// D800-DFFF is written as U+FFFD by WriteRune); nothing else to filter.
+	return s
+}
+
+// ---------------------------------------------------------------------------
+// Running the Go side.
+
+// goLoad loads text with the package under test, expansion disabled (Java
+// has no expansion).
+func goLoad(text string, iso bool) (map[string]string, error) {
+	e := properties.UTF8
+	if iso {
+		e = properties.ISO_8859_1
+	}
+	l := &properties.Loader{Encoding: e, DisableExpansion: true}
+	p, err := l.LoadBytes([]byte(text))
+	if err != nil {
+		return nil, err
+	}
+	return p.Map(), nil
+}
+
+// goWrite writes the map with the package under test.
+func goWrite(m map[string]string, e properties.Encoding) (string, error) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	for _, k := range sortedKeys(m) {
+		if _, _, err := p.Set(k, m[k]); err != nil {
+			return "", err
+		}
+	}
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, e); err != nil {
+		return "", err
+	}
+	return buf.String(), nil
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelLoadMatchesJava: the same text, loaded by both, gives the same
+// map, or both reject it.
+func TestHegelLoadMatchesJava(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		text := genText(ht)
+		// One text in five is read as ISO-8859-1 by both (each byte a
+		// character; the UTF-8 pieces become two or three characters).
+		iso := chance(ht, 20)
+		want, jerr := o.load(text, iso)
+		if jerr != nil {
+			if _, ok := jerr.(*javaError); !ok {
+				fail(ht, "%v", jerr)
+			}
+		}
+		got, gerr := goLoad(text, iso)
+		switch {
+		case jerr != nil && gerr != nil:
+			count("both reject")
+			return
+		case jerr != nil:
+			if k := knownLoad(text, "java rejects"); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "Java rejects (%v), properties accepts:\n%stext: %q", jerr, showMap(got), text)
+		case gerr != nil:
+			if k := knownLoad(text, "go rejects"); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "properties rejects (%v), Java accepts:\n%stext: %q", gerr, showMap(want), text)
+		}
+		if d := diffMaps(got, want); d != "" {
+			if k := knownLoad(text, d); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "maps differ: %s\nproperties:\n%sJava:\n%stext: %q\nISO-8859-1: %v", d, showMap(got), showMap(want), text, iso)
+		}
+		if iso {
+			count("ISO-8859-1")
+		}
+		if len(want) == 0 {
+			count("empty")
+		} else {
+			count("entries")
+		}
+	})
+}
+
+// TestHegelWriteReadByJava: what the package writes (UTF-8 and ISO-8859-1),
+// Java reads back as the same map.
+func TestHegelWriteReadByJava(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		m := genMap(ht)
+		iso := chance(ht, 30)
+		e := properties.UTF8
+		if iso {
+			e = properties.ISO_8859_1
+		}
+		text, err := goWrite(m, e)
+		if err != nil {
+			fail(ht, "Write: %v\nmap:\n%s", err, showMap(m))
+		}
+		if iso && hasAstral(m) {
+			count("astral in ISO-8859-1: written as ? (documented)")
+			return
+		}
+		got, jerr := o.load(text, iso)
+		if jerr != nil {
+			if _, ok := jerr.(*javaError); !ok {
+				fail(ht, "%v", jerr)
+			}
+			if k := knownWrite(m, iso); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "Java rejects what Write produced (%v)\nmap:\n%stext: %q", jerr, showMap(m), text)
+		}
+		if d := diffMaps(got, m); d != "" {
+			if k := knownWrite(m, iso); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "Java reads a different map from Write's text: %s\nwritten:\n%sJava read:\n%stext: %q\nencoding ISO-8859-1: %v", d, showMap(m), showMap(got), text, iso)
+		}
+		if iso {
+			count("ISO-8859-1")
+		} else {
+			count("UTF-8")
+		}
+	})
+}
+
+// TestHegelReadJavaStore: what Java stores, the package reads back as the
+// same map.
+func TestHegelReadJavaStore(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		m := genMap(ht)
+		if hasLoneSurrogateRisk(m) {
+			count("skipped: not representable in Java")
+			return
+		}
+		text, err := o.store(m)
+		if err != nil {
+			fail(ht, "%v\nmap:\n%s", err, showMap(m))
+		}
+		got, gerr := goLoad(text, false)
+		if gerr != nil {
+			fail(ht, "properties rejects what Java stored (%v)\nmap:\n%stext: %q", gerr, showMap(m), text)
+		}
+		if d := diffMaps(got, m); d != "" {
+			if k := knownRead(text); k != "" {
+				count("known " + k)
+				return
+			}
+			fail(ht, "properties reads a different map from Java's text: %s\nstored:\n%sproperties read:\n%stext: %q", d, showMap(m), showMap(got), text)
+		}
+		count("ok")
+	})
+}
+
+func hasAstral(m map[string]string) bool {
+	for k, v := range m {
+		for _, r := range k + v {
+			if r > 0xFFFF {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasLoneSurrogateRisk reports a map no Java string can carry unchanged
+// through UTF-8: none is generated, kept for clarity.
+func hasLoneSurrogateRisk(m map[string]string) bool {
+	for k, v := range m {
+		if strings.ContainsRune(k+v, '\uFFFD') {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..32a76b1
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,322 @@
+package hegel
+
+// Hegel property tests for magiconair/properties. Generated .properties
+// texts are loaded by this package and by java.util.Properties (a child
+// JVM, Oracle.java) and must give the same key/value map; what this package
+// writes, Java must read back unchanged, and what Java stores, this package
+// must read back unchanged.
+//
+// Needs java (11 or later; the source launcher runs Oracle.java).
+
+import (
+	"bufio"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// The Java oracle: one child JVM per test binary, one request line in, one
+// answer line out. Strings travel as "x" + hex(UTF-8).
+
+type oracle struct {
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   io.WriteCloser
+	out  *bufio.Reader
+	errs strings.Builder
+}
+
+var (
+	theOracle     *oracle
+	theOracleErr  error
+	theOracleOnce sync.Once
+)
+
+func getOracle(t testing.TB) *oracle {
+	t.Helper()
+	theOracleOnce.Do(func() {
+		if _, err := exec.LookPath("java"); err != nil {
+			theOracleErr = fmt.Errorf("java not found: %v", err)
+			return
+		}
+		cmd := exec.Command("java", "Oracle.java")
+		cmd.Env = append(os.Environ(), "LC_ALL=C.UTF-8")
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			theOracleErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			theOracleErr = err
+			return
+		}
+		o := &oracle{cmd: cmd, in: in, out: bufio.NewReaderSize(out, 1<<20)}
+		cmd.Stderr = &o.errs
+		if err := cmd.Start(); err != nil {
+			theOracleErr = fmt.Errorf("starting java: %v", err)
+			return
+		}
+		// A first request proves the oracle compiled and answers.
+		if _, err := o.load("a=b", false); err != nil {
+			theOracleErr = fmt.Errorf("oracle does not answer: %v\n%s", err, o.errs.String())
+			return
+		}
+		theOracle = o
+	})
+	if theOracleErr != nil {
+		t.Fatalf("%v", theOracleErr)
+	}
+	return theOracle
+}
+
+func enc(s string) string { return "x" + hex.EncodeToString([]byte(s)) }
+
+func dec(s string) (string, error) {
+	if !strings.HasPrefix(s, "x") {
+		return "", fmt.Errorf("bad string field %q", s)
+	}
+	b, err := hex.DecodeString(s[1:])
+	return string(b), err
+}
+
+// call sends one request line and reads one answer line.
+func (o *oracle) call(req string) (string, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if _, err := io.WriteString(o.in, req+"\n"); err != nil {
+		return "", fmt.Errorf("oracle write: %v\n%s", err, o.errs.String())
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return "", fmt.Errorf("oracle read: %v\n%s", err, o.errs.String())
+	}
+	return strings.TrimRight(line, "\r\n"), nil
+}
+
+// javaError is an exception thrown by java.util.Properties.
+type javaError struct{ msg string }
+
+func (e *javaError) Error() string { return "java: " + e.msg }
+
+// load runs Properties.load on text (read as UTF-8, or ISO-8859-1 when iso)
+// and returns the map. A Java exception is a *javaError.
+func (o *oracle) load(text string, iso bool) (map[string]string, error) {
+	req := "load " + enc(text)
+	if iso {
+		req += " iso"
+	}
+	ans, err := o.call(req)
+	if err != nil {
+		return nil, err
+	}
+	f := strings.Split(ans, " ")
+	switch f[0] {
+	case "error":
+		msg, _ := dec(f[1])
+		return nil, &javaError{msg}
+	case "ok":
+		k, _ := strconv.Atoi(f[1])
+		if len(f) != 2+2*k {
+			return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+		}
+		m := make(map[string]string, k)
+		for i := 0; i < k; i++ {
+			key, err1 := dec(f[2+2*i])
+			val, err2 := dec(f[3+2*i])
+			if err1 != nil || err2 != nil {
+				return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+			}
+			m[key] = val
+		}
+		return m, nil
+	}
+	return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+}
+
+// store runs Properties.store(Writer) on the map and returns the text.
+func (o *oracle) store(m map[string]string) (string, error) {
+	var b strings.Builder
+	b.WriteString("store")
+	for _, k := range sortedKeys(m) {
+		b.WriteString(" " + enc(k) + " " + enc(m[k]))
+	}
+	ans, err := o.call(b.String())
+	if err != nil {
+		return "", err
+	}
+	f := strings.SplitN(ans, " ", 2)
+	if f[0] == "error" {
+		msg, _ := dec(f[1])
+		return "", &javaError{msg}
+	}
+	if f[0] != "ok" || len(f) != 2 {
+		return "", fmt.Errorf("oracle: malformed answer %q", ans)
+	}
+	return dec(f[1])
+}
+
+func sortedKeys(m map[string]string) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// showMap spells a map one entry per line, quoted.
+func showMap(m map[string]string) string {
+	if len(m) == 0 {
+		return "  (empty)\n"
+	}
+	var b strings.Builder
+	for _, k := range sortedKeys(m) {
+		fmt.Fprintf(&b, "  %q = %q\n", k, m[k])
+	}
+	return b.String()
+}
+
+// diffMaps names the first difference between two maps.
+func diffMaps(got, want map[string]string) string {
+	for _, k := range sortedKeys(want) {
+		g, ok := got[k]
+		if !ok {
+			return fmt.Sprintf("key %q missing", k)
+		}
+		if g != want[k] {
+			return fmt.Sprintf("key %q: got %q, want %q", k, g, want[k])
+		}
+	}
+	for _, k := range sortedKeys(got) {
+		if _, ok := want[k]; !ok {
+			return fmt.Sprintf("extra key %q = %q", k, got[k])
+		}
+	}
+	return ""
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..6cdc117
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,183 @@
+package hegel
+
+import (
+	"os"
+	"strings"
+	"unicode"
+)
+
+// The gates for the recorded bugs (bugs.toml). Each names the bug that
+// explains a disagreement, or returns "". They are coarse, on the shape of
+// the text: a text with a shape that triggers a bug is not judged at all.
+// Under HEGEL_NO_KNOWN=1 the generator avoids those shapes, so that a round
+// looks past the known bugs. The pins in hegel_pins_test.go reproduce each
+// bug deterministically.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// knownLoad gates TestHegelLoadMatchesJava: text is the input, what is the
+// disagreement.
+func knownLoad(text, what string) string {
+	sh := shapeOf(text)
+	switch {
+	case sh.eofBackslash:
+		return "properties/2"
+	case sh.keyContinued:
+		return "properties/1"
+	case sh.crlfContinued:
+		return "properties/4"
+	case sh.sepContinued:
+		return "properties/9"
+	case sh.emptyKey:
+		return "properties/3"
+	case surrogateLiteral(text):
+		return "properties/5"
+	}
+	return ""
+}
+
+// surrogateLiteral reports a \uD800-\uDBFF literal (the first half of a
+// surrogate pair) in the text.
+func surrogateLiteral(text string) bool {
+	for i := 0; i+5 < len(text); i++ {
+		if text[i] == '\\' && text[i+1] == 'u' && (text[i+2] == 'd' || text[i+2] == 'D') &&
+			strings.IndexByte("89abAB", text[i+3]) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// knownWrite gates TestHegelWriteReadByJava.
+func knownWrite(m map[string]string, iso bool) string {
+	for k, v := range m {
+		if k[0] == '#' || k[0] == '!' {
+			return "properties/6"
+		}
+		if iso {
+			for _, r := range k + v {
+				if r >= 0x80 && r <= 0xFF {
+					return "properties/7"
+				}
+			}
+			for _, s := range []string{k, v} {
+				if r := firstRune(s); r > 0xFF && unicode.IsSpace(r) {
+					return "properties/8"
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func firstRune(s string) rune {
+	for _, r := range s {
+		return r
+	}
+	return 0
+}
+
+// knownRead gates TestHegelReadJavaStore.
+func knownRead(text string) string {
+	return ""
+}
+
+// shape is what a scan of the text in java.util.Properties' terms finds.
+type shape struct {
+	keyContinued  bool // a backslash-newline while still in a key
+	crlfContinued bool // a backslash before CR LF
+	eofBackslash  bool // the text ends in an unescaped backslash (not in a comment)
+	emptyKey      bool // a logical line whose key is empty (begins with = or :)
+	sepContinued  bool // a backslash-newline between the key and the value
+	surrogate     bool // a \uD800-\uDBFF literal
+}
+
+// hasKnown reports whether the text has the shape of any recorded bug.
+func (sh shape) hasKnown() bool {
+	return sh.keyContinued || sh.crlfContinued || sh.eofBackslash || sh.emptyKey || sh.sepContinued || sh.surrogate
+}
+
+// shapeOf scans text as Java's LineReader and key/value split do.
+func shapeOf(text string) shape {
+	var sh shape
+	sh.surrogate = surrogateLiteral(text)
+	i := 0
+	for i < len(text) {
+		// Skip blank lines and leading whitespace.
+		for i < len(text) && strings.IndexByte(" \t\f\r\n", text[i]) >= 0 {
+			i++
+		}
+		if i >= len(text) {
+			break
+		}
+		if text[i] == '#' || text[i] == '!' {
+			for i < len(text) && text[i] != '\n' && text[i] != '\r' {
+				i++
+			}
+			continue
+		}
+		// A logical line: key, separator zone (whitespace, one = or :,
+		// whitespace), value; continuations join physical lines.
+		inKey := true
+		inSep := false
+		sepSeen := false
+		first := true
+		for i < len(text) {
+			c := text[i]
+			if inSep && (c == ' ' || c == '\t' || c == '\f' || (!sepSeen && (c == '=' || c == ':'))) {
+				if c == '=' || c == ':' {
+					sepSeen = true
+				}
+				i++
+				continue
+			}
+			if inSep && c != '\\' && c != '\n' && c != '\r' {
+				inSep = false // the value begins
+			}
+			if c == '\\' {
+				if i+1 >= len(text) {
+					sh.eofBackslash = true
+					i++
+					break
+				}
+				if text[i+1] == '\n' || text[i+1] == '\r' {
+					if inKey {
+						sh.keyContinued = true
+					}
+					if inSep {
+						sh.sepContinued = true
+					}
+					if text[i+1] == '\r' && i+2 < len(text) && text[i+2] == '\n' {
+						sh.crlfContinued = true
+						i += 3
+					} else {
+						i += 2
+					}
+					for i < len(text) && strings.IndexByte(" \t\f", text[i]) >= 0 {
+						i++
+					}
+					first = false
+					continue
+				}
+				inSep = false
+				i += 2
+				first = false
+				continue
+			}
+			if c == '\n' || c == '\r' {
+				break
+			}
+			if inKey && strings.IndexByte(" \t\f=:", c) >= 0 {
+				if first && (c == '=' || c == ':') {
+					sh.emptyKey = true
+				}
+				inKey = false
+				inSep = true
+				sepSeen = c == '=' || c == ':'
+			}
+			first = false
+			i++
+		}
+	}
+	return sh
+}
