+package hegel
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..51f3c26
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,140 @@
+package hegel
+
+import (
+	"bytes"
+	"reflect"
+	"testing"
+
+	"github.com/magiconair/properties"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expected maps are what java.util.Properties.load
+// gives for the same text (checked with OpenJDK 25) and what the format's
+// specification, the Properties javadoc, says.
+
+func loadUTF8(t *testing.T, text string) map[string]string {
+	t.Helper()
+	m, err := goLoad(text, false)
+	if err != nil {
+		t.Fatalf("load %q: %v", text, err)
+	}
+	return m
+}
+
+func expectLoad(t *testing.T, text string, want map[string]string) {
+	t.Helper()
+	got, err := goLoad(text, false)
+	if err != nil {
+		t.Errorf("load %q: %v; Java gives %v", text, err, want)
+		return
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("load %q = %q; Java gives %q", text, got, want)
+	}
+}
+
+// properties/1: a backslash before a line end continues the logical line
+// wherever it is, in the key too.
+func TestHegelPinKeyContinuation(t *testing.T) {
+	expectLoad(t, "a\\\nb=c", map[string]string{"ab": "c"})
+	expectLoad(t, "a\\\n  b c", map[string]string{"ab": "c"})
+}
+
+// properties/2: a backslash at the very end of the input is dropped, not
+// an error.
+func TestHegelPinTrailingBackslashAtEOF(t *testing.T) {
+	expectLoad(t, "a=b\\", map[string]string{"a": "b"})
+	expectLoad(t, "a\\", map[string]string{"a": ""})
+}
+
+// properties/3: a line beginning with the separator has the empty key.
+func TestHegelPinEmptyKey(t *testing.T) {
+	expectLoad(t, "=v", map[string]string{"": "v"})
+	expectLoad(t, ":x\nk=y", map[string]string{"": "x", "k": "y"})
+}
+
+// properties/4: a continuation before CR LF joins the next line; the LF is
+// part of the line terminator, not a line of its own.
+func TestHegelPinCRLFContinuation(t *testing.T) {
+	expectLoad(t, "a=b\\\r\nc", map[string]string{"a": "bc"})
+	expectLoad(t, "a=b\\\r\n  c\r\nd=e", map[string]string{"a": "bc", "d": "e"})
+}
+
+// properties/9: a continuation between the key and the separator: the
+// separator still belongs to the logical line's separator, not to the value.
+func TestHegelPinSeparatorAfterContinuation(t *testing.T) {
+	expectLoad(t, "a \\\n= v", map[string]string{"a": "v"})
+	expectLoad(t, "a \\\n  :", map[string]string{"a": ""})
+}
+
+// properties/5: two \u literals forming a surrogate pair are one
+// supplementary character.
+func TestHegelPinSurrogatePair(t *testing.T) {
+	expectLoad(t, "k=\\uD83D\\uDE00", map[string]string{"k": "\U0001F600"})
+	expectLoad(t, "\\uD801\\uDC0A=v", map[string]string{"\U0001040A": "v"})
+}
+
+// properties/6: Write does not escape a key's leading # or !, so the line is
+// a comment when read back (by this package as much as by Java).
+func TestHegelPinWriteEscapesCommentMarkers(t *testing.T) {
+	for _, key := range []string{"!a", "#b"} {
+		p := properties.NewProperties()
+		p.DisableExpansion = true
+		p.MustSet(key, "v")
+		var buf bytes.Buffer
+		if _, err := p.Write(&buf, properties.UTF8); err != nil {
+			t.Fatal(err)
+		}
+		got := loadUTF8(t, buf.String())
+		if want := map[string]string{key: "v"}; !reflect.DeepEqual(got, want) {
+			t.Errorf("Write(%q = v) wrote %q, which loads as %q (Java: the same, a comment line); want %q", key, buf.String(), got, want)
+		}
+	}
+}
+
+// properties/7: Write with ISO_8859_1 emits characters U+0080-U+00FF as
+// their UTF-8 bytes instead of the single Latin-1 byte, so an ISO-8859-1
+// reader (Java's, or this package's Load) sees two characters.
+func TestHegelPinWriteISOLatin1(t *testing.T) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	p.MustSet("\u00e9", "\u00fc")
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, properties.ISO_8859_1); err != nil {
+		t.Fatal(err)
+	}
+	if want := "\xe9 = \xfc\n"; buf.String() != want {
+		t.Errorf("Write(ISO_8859_1) = %q; want the Latin-1 bytes %q", buf.String(), want)
+	}
+	got, err := goLoad(buf.String(), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := map[string]string{"\u00e9": "\u00fc"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("Write(ISO_8859_1) then Load(ISO_8859_1) = %q; want %q", got, want)
+	}
+}
+
+// properties/8: Write with ISO_8859_1 emits a leading Unicode whitespace
+// character above U+00FF (U+2028, U+3000, ...) raw instead of as \uXXXX,
+// because the leading-whitespace case comes before the range cases.
+func TestHegelPinWriteISOLeadingUnicodeSpace(t *testing.T) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	p.MustSet("k", "\u2028x")
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, properties.ISO_8859_1); err != nil {
+		t.Fatal(err)
+	}
+	if want := "k = \\u2028x\n"; buf.String() != want {
+		t.Errorf("Write(ISO_8859_1) = %q; want %q", buf.String(), want)
+	}
+	got, err := goLoad(buf.String(), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := map[string]string{"k": "\u2028x"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("Write(ISO_8859_1) then Load(ISO_8859_1) = %q; want %q", got, want)
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..325d6ae
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,530 @@
+package hegel
+
+// The generators and the wide properties.
+//
+// A .properties text is drawn as lines rendered by pure functions: a line is
+// a key line (leading whitespace, the key text, a separator and the value
+// text), a comment, a blank or a value-only line, each with its line end,
+// and the last one ends with its line end, with nothing, or with a bare
+// backslash; key and value texts are pieces (plain words, escapes, \uXXXX
+// literals, raw special characters, continuations) joined. The grammar is
+// built once with the shapes of the recorded load bugs on (the default: a
+// continuation inside a key, properties/1; the bare backslash tail, /2; a
+// value-only line, whose separator is the empty key, /3; a continuation
+// before CR LF, /4; a surrogate pair literal, /5) and once with them off
+// (HEGEL_NO_KNOWN=1, and the context lines of the narrow properties); what
+// the pieces' interplay still produces with them off (a raw = as a key's
+// first piece, a raw backslash before a line end or at the end) is filtered
+// out of the text, at a raw rate of a few percent.
+//
+// A map for the Write and store properties is drawn from piece pools shaped
+// per encoding: no supplementary character under ISO-8859-1 (written as ?,
+// which the package documents) and, with the shapes off, no key beginning
+// with # or ! (properties/6), no Latin-1 character under ISO-8859-1 (/7) and
+// no string beginning with a Unicode space above U+00FF under ISO-8859-1
+// (/8).
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/magiconair/properties"
+)
+
+// ---------------------------------------------------------------------------
+// Pieces of a text.
+
+var (
+	// plainPool: words for keys and values: plain text and non-ASCII letters.
+	plainPool = []string{"a", "b", "key", "x1", "-", ".", "_", "A", "0", "ab", "\u00e9", "\u65e5", "\u00df"}
+	// rawSpecialPool: the characters the format cares about, raw: whitespace,
+	// the separators, the comment markers, the escape character.
+	rawSpecialPool = []string{" ", "\t", "\f", "=", ":", "#", "!", "\\"}
+	// escPool: escape sequences as they appear in a text: the special
+	// characters escaped, the named escapes, unknown escapes (whose backslash
+	// is dropped).
+	escPool = []string{`\ `, `\:`, `\=`, `\#`, `\!`, `\\`, `\n`, `\t`, `\r`, `\f`, `\a`, `\q`, `\0`, `\"`, `\'`, `\-`}
+
+	plainPieces      = hegel.SampledFrom(plainPool)
+	rawSpecialPieces = hegel.SampledFrom(rawSpecialPool)
+	escPieces        = hegel.SampledFrom(escPool)
+	digitPieces      = hegel.SampledFrom([]string{"1", "2", "kk", "K"})
+	valueWsPieces    = hegel.SampledFrom([]string{" ", "  ", "\t"})
+	indents          = hegel.SampledFrom([]string{" ", "\t", "\f"})
+	contIndents      = hegel.SampledFrom([]string{"", "", " ", "\t", "   "})
+	lineEnds         = hegel.SampledFrom([]string{"\n", "\n", "\n", "\r\n", "\r"})
+	// separators: every spelling of the key/value separator: = or : with or
+	// without whitespace, whitespace alone, doubled.
+	separators = hegel.SampledFrom([]string{"=", "=", ":", " ", " = ", "\t:\t", " =", "= ", "  ", "\f", ":=", "==", ": ", "\t"})
+	// sepChars: the separators with a = or : in them.
+	sepChars = hegel.SampledFrom([]string{"=", "=", ":", " = ", "\t:\t", " =", "= ", ":=", "==", ": "})
+)
+
+// hexLiteral is the \uXXXX literal of cp, in upper case when upper.
+func hexLiteral(cp int, upper bool) string {
+	if upper {
+		return fmt.Sprintf(`\u%04X`, cp)
+	}
+	return fmt.Sprintf(`\u%04x`, cp)
+}
+
+var (
+	// asciiLiterals: a \u literal of U+0001-U+007F.
+	asciiLiterals = hegel.Map(hegel.Integers(1, 0x7F), func(cp int) string { return hexLiteral(cp, false) })
+	// specialLiterals: a \u literal of a special character (space, the
+	// separators, the markers, the backslash, the line ends, tab, form feed).
+	specialLiterals = hegel.Map(hegel.SampledFrom([]int{0x20, 0x3D, 0x3A, 0x23, 0x21, 0x5C, 0x0A, 0x0D, 0x09, 0x0C}), func(cp int) string { return hexLiteral(cp, true) })
+	// bmpLiterals: a \u literal of U+0080-U+FFFF (a surrogate code point, which
+	// Go cannot spell, becomes U+263A), in upper case half of the time.
+	bmpLiterals = hegel.Map(pairs(hegel.Integers(0x80, 0xFFFF), chance(50)), func(p pair[int, bool]) string {
+		cp := p.a
+		if cp >= 0xD800 && cp <= 0xDFFF {
+			cp = 0x263A
+		}
+		return hexLiteral(cp, p.b)
+	})
+	// surrogatePairs: a high and a low surrogate literal, one supplementary
+	// character to Java (the shape of properties/5).
+	surrogatePairs = hegel.Map(pairs(hegel.Integers(0, 0x3FF), hegel.Integers(0, 0x3FF)), func(p pair[int, int]) string {
+		return hexLiteral(0xD800+p.a, true) + hexLiteral(0xDC00+p.b, true)
+	})
+)
+
+// continuationsBefore: a backslash before one of the line ends, then the
+// next line's leading whitespace (which the format drops).
+func continuationsBefore(ends ...string) hegel.Generator[string] {
+	return cat(lit(`\`), hegel.SampledFrom(ends), contIndents)
+}
+
+var (
+	// continuations: a continuation before LF or CR.
+	continuations = continuationsBefore("\n", "\n", "\r")
+	// crlfContinuations: a continuation before CR LF (the shape of properties/4).
+	crlfContinuations = continuationsBefore("\r\n")
+)
+
+// ---------------------------------------------------------------------------
+// The text grammar.
+
+// line is a line body and its line end.
+type line struct{ body, end string }
+
+// lineEndsAfter: the line end after a body: none when the body ends in CR
+// (the CR is the line end; a LF after it would make it CR LF), else any.
+func lineEndsAfter(body string) hegel.Generator[string] {
+	if strings.HasSuffix(body, "\r") {
+		return lit("")
+	}
+	return lineEnds
+}
+
+func joinLines(ls []line) string {
+	var b strings.Builder
+	for _, l := range ls {
+		b.WriteString(l.body)
+		b.WriteString(l.end)
+	}
+	return b.String()
+}
+
+// How the last line of a text ends.
+const (
+	tailLineEnd   = iota // with its line end
+	tailNone             // with nothing
+	tailBackslash        // with a bare backslash (the shape of properties/2)
+)
+
+// textSpec: the lines of a text and how the last one ends.
+type textSpec struct {
+	lines []line
+	tail  int
+}
+
+func (s textSpec) render() string {
+	var b strings.Builder
+	for i, l := range s.lines {
+		b.WriteString(l.body)
+		switch {
+		case i < len(s.lines)-1 || s.tail == tailLineEnd:
+			b.WriteString(l.end)
+		case s.tail == tailBackslash:
+			b.WriteString(`\`)
+		}
+	}
+	return b.String()
+}
+
+// grammar: the generators of a .properties text, built once per shapes flag.
+type grammar struct {
+	literals hegel.Generator[string] // a \uXXXX literal
+	keys     hegel.Generator[string] // the text of a key, escapes included
+	texts    hegel.Generator[string] // a text of one to six lines
+	context  hegel.Generator[string] // up to two lines with their line ends, free of every shape
+}
+
+// newGrammar builds the grammar with the shapes of the recorded load bugs
+// drawn (shapesOn) or left out. The weights are the old generator's dice.
+func newGrammar(shapesOn bool) grammar {
+	literalChoices := []choice[string]{{1, asciiLiterals}, {1, specialLiterals}, {7, bmpLiterals}}
+	if shapesOn {
+		literalChoices = append(literalChoices, choice[string]{1, surrogatePairs}) // properties/5
+	}
+	literals := weighted(literalChoices...)
+	conts := continuations
+	if shapesOn {
+		conts = continuationsBefore("\n", "\n", "\r\n", "\r") // before CR LF too: properties/4
+	}
+	keyPieces := func(specials hegel.Generator[string]) hegel.Generator[string] {
+		choices := []choice[string]{{6, plainPieces}, {2, escPieces}, {1, literals}, {1, specials}, {1, digitPieces}}
+		if shapesOn {
+			choices = append(choices, choice[string]{1, conts}) // a continuation inside a key: properties/1
+		}
+		return weighted(choices...)
+	}
+	firstSpecials := rawSpecialPieces
+	if !shapesOn {
+		firstSpecials = hegel.SampledFrom(without(rawSpecialPool, "=", ":", " ", "\t", "\f")) // a raw separator first (after whitespace or not): the empty key, properties/3
+	}
+	keys := cat(keyPieces(firstSpecials), joined(many(keyPieces(rawSpecialPieces), 0, 2)))
+	values := joined(many(weighted(
+		choice[string]{5, plainPieces}, choice[string]{2, escPieces}, choice[string]{1, literals},
+		choice[string]{2, rawSpecialPieces}, choice[string]{1, conts}, choice[string]{1, valueWsPieces}), 0, 4))
+	keyLines := cat(maybe(15, indents), keys, maybe(85, cat(separators, values)))
+	comments := cat(
+		hegel.SampledFrom([]string{"", " ", "\t", "\f", "   "}),
+		hegel.SampledFrom([]string{"#", "!"}),
+		hegel.SampledFrom([]string{"", " comment", " a=b", ` end\`, ` \u00`, "\u65e5"}),
+	)
+	blanks := hegel.SampledFrom([]string{"", " ", "\t", "\f"})
+	lineChoices := []choice[string]{{16, keyLines}, {2, comments}, {1, blanks}}
+	if shapesOn {
+		lineChoices = append(lineChoices, choice[string]{1, cat(separators, values)}) // a value-only line: the empty key, properties/3
+	}
+	ends := func(body string) hegel.Generator[string] {
+		if !shapesOn {
+			return lineEndsAfter(body) // a continuation before CR at the end of the body would meet a LF: CR LF, properties/4
+		}
+		return lineEnds
+	}
+	lines := hegel.FlatMap(weighted(lineChoices...), func(body string) hegel.Generator[line] {
+		return hegel.Map(ends(body), func(end string) line { return line{body, end} })
+	})
+	tailChoices := []choice[int]{{70, hegel.Just(tailLineEnd)}, {24, hegel.Just(tailNone)}}
+	if shapesOn {
+		tailChoices = append(tailChoices, choice[int]{6, hegel.Just(tailBackslash)}) // properties/2
+	}
+	texts := hegel.Map(pairs(many(lines, 1, 6), weighted(tailChoices...)), func(p pair[[]line, int]) string {
+		return textSpec{p.a, p.b}.render()
+	})
+	context := hegel.Map(many(lines, 0, 2), joinLines)
+	if !shapesOn {
+		texts = hegel.Filter(texts, shapeFree)
+		context = hegel.Filter(context, shapeFree)
+	}
+	return grammar{literals: literals, keys: keys, texts: texts, context: context}
+}
+
+var (
+	shapedGrammar = newGrammar(true)
+	plainGrammar  = newGrammar(false)
+	// wide is the grammar of the wide load property: the shapes on by default.
+	wide = shaped(shapedGrammar, plainGrammar)
+)
+
+// loadCase: a text and how it is read, as UTF-8 or as ISO-8859-1 (each byte
+// a character; the UTF-8 pieces become two or three characters).
+type loadCase struct {
+	text string
+	iso  bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c loadCase) GoString() string { return fmt.Sprintf("text %q\nISO-8859-1 %v", c.text, c.iso) }
+
+// loadCasesOf reads the texts as ISO-8859-1 one time in five.
+func loadCasesOf(texts hegel.Generator[string]) hegel.Generator[loadCase] {
+	return hegel.Map(pairs(texts, chance(20)), func(p pair[string, bool]) loadCase { return loadCase{p.a, p.b} })
+}
+
+var loadCases = loadCasesOf(wide.texts)
+
+// ---------------------------------------------------------------------------
+// Maps: strings of raw characters (no escapes: values in memory, not text).
+
+// rawOpts shapes the pools a map's strings are drawn from.
+type rawOpts struct {
+	latin1  bool // U+0080-U+00FF (under ISO-8859-1 the shape of properties/7)
+	astral  bool // supplementary characters (written as ? under ISO-8859-1, documented)
+	markers bool // # or ! as a key's first character (properties/6)
+	spaces  bool // a Unicode space above U+00FF as a string's first character (under ISO-8859-1 the shape of properties/8)
+}
+
+var (
+	// controlPool: line ends, Unicode whitespace, control characters.
+	controlPool  = []string{"\n", "\r", "\r\n", "\u00a0", "\u0085", "\u2028", "\x00", "\x01", "\x7f"}
+	astralPieces = hegel.SampledFrom([]string{"\U0001F600", "\U0001F600x", "\U00010000"})
+)
+
+// noLeadingSpace rewrites a Unicode space above U+00FF as U+263A.
+func noLeadingSpace(s string) string {
+	if r := firstRune(s); r > 0xFF && unicode.IsSpace(r) {
+		return "\u263a"
+	}
+	return s
+}
+
+// piecesOf: a piece of a string: a plain word five times in ten, a raw
+// special character twice, a control or whitespace character once, a
+// character of the Basic Multilingual Plane once (a surrogate code point is
+// U+FFFD, as WriteRune spells it), a supplementary character once when the
+// options allow it. The first piece of a key has no comment marker, and the
+// first piece of a string no Unicode space above U+00FF, when the options
+// exclude them.
+func piecesOf(o rawOpts, first, key bool) hegel.Generator[string] {
+	plain, specials, controls, lo := plainPool, rawSpecialPool, controlPool, 0x80
+	if !o.latin1 {
+		plain = without(plain, "\u00e9", "\u00df")
+		controls = without(controls, "\u00a0", "\u0085")
+		lo = 0x100
+	}
+	if first && key && !o.markers {
+		specials = without(specials, "#", "!")
+	}
+	runes := hegel.Map(hegel.Integers(lo, 0xFFFF), func(cp int) string { return string(rune(cp)) })
+	if first && !o.spaces {
+		controls = without(controls, "\u2028")
+		runes = hegel.Map(runes, noLeadingSpace)
+	}
+	choices := []choice[string]{
+		{5, hegel.SampledFrom(plain)}, {2, hegel.SampledFrom(specials)}, {1, hegel.SampledFrom(controls)}, {1, runes},
+	}
+	if o.astral {
+		choices = append(choices, choice[string]{1, astralPieces})
+	}
+	return weighted(choices...)
+}
+
+// keysOf: a key of one to three pieces.
+func keysOf(o rawOpts) hegel.Generator[string] {
+	return cat(piecesOf(o, true, true), joined(many(piecesOf(o, false, false), 0, 2)))
+}
+
+// valuesOf: a value of up to four pieces, empty one time in five.
+func valuesOf(o rawOpts) hegel.Generator[string] {
+	return weighted(
+		choice[string]{20, lit("")},
+		choice[string]{80, cat(piecesOf(o, true, false), joined(many(piecesOf(o, false, false), 0, 3)))},
+	)
+}
+
+// mapsOf: one to five entries.
+func mapsOf(o rawOpts) hegel.Generator[map[string]string] {
+	return hegel.Maps(keysOf(o), valuesOf(o)).MinSize(1).MaxSize(5)
+}
+
+// writeOpts: the pools of a map written under the encoding: no supplementary
+// character under ISO-8859-1; with the shapes off, no key beginning with #
+// or ! and, under ISO-8859-1, no Latin-1 character and no leading Unicode
+// space above U+00FF.
+func writeOpts(iso, shapesOn bool) rawOpts {
+	return rawOpts{latin1: !iso || shapesOn, astral: !iso, markers: shapesOn, spaces: !iso || shapesOn}
+}
+
+// at indexes the per-encoding generators.
+func at(iso bool) int {
+	if iso {
+		return 1
+	}
+	return 0
+}
+
+var (
+	// storeMaps: the maps Java stores, from the whole pools.
+	storeMaps = mapsOf(rawOpts{latin1: true, astral: true, markers: true, spaces: true})
+	// writeMaps: the maps the package writes, per encoding (UTF-8, ISO-8859-1),
+	// the shapes on by default.
+	writeMaps = [2]hegel.Generator[map[string]string]{mapsOf(writeOpts(false, !noKnown)), mapsOf(writeOpts(true, !noKnown))}
+	// cleanWriteMaps: the same with the shapes off (the surroundings of the
+	// narrow properties' entries).
+	cleanWriteMaps = [2]hegel.Generator[map[string]string]{mapsOf(writeOpts(false, false)), mapsOf(writeOpts(true, false))}
+)
+
+// writeCase: a map and the encoding it is written with.
+type writeCase struct {
+	m   map[string]string
+	iso bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c writeCase) GoString() string { return fmt.Sprintf("map\n%sISO-8859-1 %v", showMap(c.m), c.iso) }
+
+// perEncoding: a case of the encoding's generator, ISO-8859-1 three times
+// in ten.
+func perEncoding(gens [2]hegel.Generator[writeCase]) hegel.Generator[writeCase] {
+	return hegel.FlatMap(chance(30), func(iso bool) hegel.Generator[writeCase] { return gens[at(iso)] })
+}
+
+// casesOf pairs the maps with the encoding.
+func casesOf(maps hegel.Generator[map[string]string], iso bool) hegel.Generator[writeCase] {
+	return hegel.Map(maps, func(m map[string]string) writeCase { return writeCase{m, iso} })
+}
+
+var writeCases = perEncoding([2]hegel.Generator[writeCase]{casesOf(writeMaps[0], false), casesOf(writeMaps[1], true)})
+
+// ---------------------------------------------------------------------------
+// Running the Go side.
+
+func encodingOf(iso bool) properties.Encoding {
+	if iso {
+		return properties.ISO_8859_1
+	}
+	return properties.UTF8
+}
+
+// goLoad loads text with the package under test, expansion disabled (Java
+// has no expansion).
+func goLoad(text string, iso bool) (map[string]string, error) {
+	l := &properties.Loader{Encoding: encodingOf(iso), DisableExpansion: true}
+	p, err := l.LoadBytes([]byte(text))
+	if err != nil {
+		return nil, err
+	}
+	return p.Map(), nil
+}
+
+// goWrite writes the map with the package under test.
+func goWrite(m map[string]string, e properties.Encoding) (string, error) {
+	p := properties.NewProperties()
+	p.DisableExpansion = true
+	for _, k := range sortedKeys(m) {
+		if _, _, err := p.Set(k, m[k]); err != nil {
+			return "", err
+		}
+	}
+	var buf bytes.Buffer
+	if _, err := p.Write(&buf, e); err != nil {
+		return "", err
+	}
+	return buf.String(), nil
+}
+
+func hasAstral(m map[string]string) bool {
+	for k, v := range m {
+		for _, r := range k + v {
+			if r > 0xFFFF {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// loadAgrees judges a text: the package and Java give the same map, or both
+// reject it; a disagreement names shape, the recorded bug the text has the
+// shape of ("" for none).
+func loadAgrees(ht *hegel.T, o *oracle, text string, iso bool, shape string) {
+	want, jerr := o.load(text, iso)
+	if jerr != nil {
+		if _, ok := jerr.(*javaError); !ok {
+			fail(ht, "%v", jerr)
+		}
+	}
+	got, gerr := goLoad(text, iso)
+	switch {
+	case jerr != nil && gerr != nil:
+		count("both reject")
+		return
+	case jerr != nil:
+		mismatch(ht, shape, "Java rejects (%v), properties accepts:\n%stext: %q", jerr, showMap(got), text)
+	case gerr != nil:
+		mismatch(ht, shape, "properties rejects (%v), Java accepts:\n%stext: %q", gerr, showMap(want), text)
+	}
+	if d := diffMaps(got, want); d != "" {
+		mismatch(ht, shape, "maps differ: %s\nproperties:\n%sJava:\n%stext: %q\nISO-8859-1: %v", d, showMap(got), showMap(want), text, iso)
+	}
+	if iso {
+		count("ISO-8859-1")
+	}
+	if len(want) == 0 {
+		count("empty")
+	} else {
+		count("entries")
+	}
+}
+
+// TestHegelLoadMatchesJava: the same text, loaded by both, gives the same
+// map, or both reject it.
+func TestHegelLoadMatchesJava(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, loadCases)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// writeAgrees judges a map: written by the package under the encoding, Java
+// reads it back as the same map; a disagreement names shape, the recorded
+// bug the map has the shape of ("" for none).
+func writeAgrees(ht *hegel.T, o *oracle, m map[string]string, iso bool, shape string) {
+	text, err := goWrite(m, encodingOf(iso))
+	if err != nil {
+		fail(ht, "Write: %v\nmap:\n%s", err, showMap(m))
+	}
+	// A supplementary character under ISO-8859-1 is written as ? (documented);
+	// none is drawn, this is a guard.
+	ht.Assume(!(iso && hasAstral(m)))
+	got, jerr := o.load(text, iso)
+	if jerr != nil {
+		if _, ok := jerr.(*javaError); !ok {
+			fail(ht, "%v", jerr)
+		}
+		mismatch(ht, shape, "Java rejects what Write produced (%v)\nmap:\n%stext: %q", jerr, showMap(m), text)
+	}
+	if d := diffMaps(got, m); d != "" {
+		mismatch(ht, shape, "Java reads a different map from Write's text: %s\nwritten:\n%sJava read:\n%stext: %q\nencoding ISO-8859-1: %v", d, showMap(m), showMap(got), text, iso)
+	}
+	if iso {
+		count("ISO-8859-1")
+	} else {
+		count("UTF-8")
+	}
+}
+
+// TestHegelWriteReadByJava: what the package writes (UTF-8 and ISO-8859-1),
+// Java reads back as the same map.
+func TestHegelWriteReadByJava(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, writeCases)
+		writeAgrees(ht, o, c.m, c.iso, knownWrite(c.m, c.iso))
+	})
+}
+
+// TestHegelReadJavaStore: what Java stores, the package reads back as the
+// same map.
+func TestHegelReadJavaStore(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, storeMaps)
+		text, err := o.store(m)
+		if err != nil {
+			fail(ht, "%v\nmap:\n%s", err, showMap(m))
+		}
+		got, gerr := goLoad(text, false)
+		if gerr != nil {
+			fail(ht, "properties rejects what Java stored (%v)\nmap:\n%stext: %q", gerr, showMap(m), text)
+		}
+		if d := diffMaps(got, m); d != "" {
+			fail(ht, "properties reads a different map from Java's text: %s\nstored:\n%sproperties read:\n%stext: %q", d, showMap(m), showMap(got), text)
+		}
+		count("ok")
+	})
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..7ff4c7b
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,285 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents (a shaped line between context lines
+// free of every shape; a map with one shaped entry among clean ones), judged
+// by the oracle of the wide property that found it, so that each bug has a
+// property that finds it every run (the wide properties reach the shapes at
+// their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring
+// region the bug does not touch instead (the continuation inside the value,
+// an escaped backslash at the end, an escaped separator starting the key, a
+// continuation before LF or CR, a literal of the Basic Multilingual Plane,
+// a continuation after the separator, a comment marker or a Unicode space
+// not at the start, a Latin Extended letter) and passes.
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	// safeKeyPieces: pieces that neither end a key nor begin a continuation
+	// (plain words, escapes, literals without a surrogate pair, digits), so
+	// that what follows them is still inside the key.
+	safeKeyPieces = weighted(choice[string]{6, plainPieces}, choice[string]{2, escPieces}, choice[string]{1, plainGrammar.literals}, choice[string]{1, digitPieces})
+	// safeValuePieces: value pieces that end in no backslash.
+	safeValuePieces = weighted(choice[string]{5, plainPieces}, choice[string]{2, escPieces}, choice[string]{1, plainGrammar.literals}, choice[string]{1, valueWsPieces})
+	safeKeys        = joined(many(safeKeyPieces, 1, 3))
+	// tailValues: a value after the shaped piece: the wide grammar's value
+	// pieces less the raw backslash (which before the line end would be a
+	// continuation of its own, before CR LF the shape of properties/4).
+	tailValues = joined(many(weighted(
+		choice[string]{5, plainPieces}, choice[string]{2, escPieces}, choice[string]{1, plainGrammar.literals},
+		choice[string]{2, hegel.SampledFrom(without(rawSpecialPool, `\`))}, choice[string]{1, continuations}, choice[string]{1, valueWsPieces}), 0, 4))
+)
+
+// framed puts a line body, with its line end (none after a CR, which would
+// make CR LF with a LF), between context lines free of every shape.
+func framed(bodies hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.FlatMap(bodies, func(body string) hegel.Generator[string] {
+		return cat(plainGrammar.context, lit(body), lineEndsAfter(body), plainGrammar.context)
+	})
+}
+
+// --------------------------------------------------------------------------- properties/1
+
+// keyContinuationTexts: a key line whose key holds a continuation after one
+// or two pieces that keep the key open (properties/1); under HEGEL_NO_KNOWN=1
+// the continuation is inside the value, after the separator and one or two
+// value pieces.
+var keyContinuationTexts = loadCasesOf(framed(shaped(
+	cat(maybe(15, indents), joined(many(safeKeyPieces, 1, 2)), continuations, plainGrammar.keys, maybe(85, cat(separators, tailValues))),
+	cat(maybe(15, indents), safeKeys, sepChars, joined(many(safeValuePieces, 1, 2)), continuations, tailValues),
+)))
+
+// TestHegelKeyContinuationJoinsTheLines: a backslash before a line end
+// continues the logical line wherever it is, in the key too, as Java reads
+// it; the lexer keeps the line end in the key (properties/1).
+func TestHegelKeyContinuationJoinsTheLines(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, keyContinuationTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/2
+
+// trailingBackslashTexts: a last line (a key line, or nothing) ending in a
+// bare backslash at the end of the input (properties/2); under
+// HEGEL_NO_KNOWN=1 in an escaped backslash.
+var trailingBackslashTexts = loadCasesOf(cat(
+	plainGrammar.context,
+	weighted(choice[string]{1, lit("")}, choice[string]{9, cat(maybe(15, indents), safeKeys, maybe(85, cat(separators, tailValues)))}),
+	shaped(lit(`\`), lit(`\\`)),
+))
+
+// TestHegelTrailingBackslashAtEOFIsDropped: a backslash as the last byte of
+// the input is dropped, as Java's LineReader drops it; the lexer reports a
+// premature EOF (properties/2).
+func TestHegelTrailingBackslashAtEOFIsDropped(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, trailingBackslashTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/3
+
+// emptyKeyTexts: a line beginning with the separator, after leading
+// whitespace or not (properties/3); under HEGEL_NO_KNOWN=1 beginning with an
+// escaped separator or space, which starts the key.
+var emptyKeyTexts = loadCasesOf(framed(shaped(
+	cat(maybe(15, indents), sepChars, tailValues),
+	cat(maybe(15, indents), hegel.SampledFrom([]string{`\=`, `\:`, `\ `}), safeKeys, maybe(85, cat(separators, tailValues))),
+)))
+
+// TestHegelSeparatorFirstLineHasTheEmptyKey: a line beginning with = or :
+// has the empty key, as Java reads it (the key ends at the first unescaped
+// separator, so it may be empty); the lexer emits no key and the parser
+// fails (properties/3).
+func TestHegelSeparatorFirstLineHasTheEmptyKey(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyKeyTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/4
+
+// crlfContinuationTexts: a key line whose value holds a continuation before
+// CR LF and goes on with one to three pieces (properties/4); under
+// HEGEL_NO_KNOWN=1 the continuation is before LF or CR.
+var crlfContinuationTexts = loadCasesOf(framed(cat(
+	maybe(15, indents), safeKeys, sepChars, joined(many(safeValuePieces, 0, 2)),
+	shaped(crlfContinuations, continuations),
+	joined(many(safeValuePieces, 1, 3)),
+)))
+
+// TestHegelCRLFContinuationJoinsTheLines: CR LF is one line terminator, so a
+// continuation before it joins the next line to the value, as Java reads
+// it; the lexer consumes the CR only and reads the next line as a key
+// (properties/4).
+func TestHegelCRLFContinuationJoinsTheLines(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, crlfContinuationTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/5
+
+// surrogatePairTexts: a key line with a surrogate pair literal in its value
+// or in its key, between up to two pieces on each side (properties/5); under
+// HEGEL_NO_KNOWN=1 a literal of the Basic Multilingual Plane.
+var surrogatePairTexts = func() hegel.Generator[loadCase] {
+	literal := shaped(surrogatePairs, bmpLiterals)
+	inValue := cat(maybe(15, indents), safeKeys, sepChars, joined(many(safeValuePieces, 0, 2)), literal, joined(many(safeValuePieces, 0, 2)))
+	inKey := cat(maybe(15, indents), joined(many(safeKeyPieces, 0, 2)), literal, joined(many(safeKeyPieces, 0, 2)), maybe(85, cat(separators, tailValues)))
+	return loadCasesOf(framed(hegel.OneOf(inValue, inKey)))
+}()
+
+// TestHegelSurrogatePairLiteralsDecodeToOneCharacter: two \u literals
+// forming a UTF-16 surrogate pair are one supplementary character, as Java
+// decodes them (the literal is a UTF-16 code unit); the lexer appends each
+// half as a rune of its own, two U+FFFD (properties/5).
+func TestHegelSurrogatePairLiteralsDecodeToOneCharacter(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, surrogatePairTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/9
+
+// separatorAfterContinuationTexts: a key, whitespace, a continuation, then
+// the separator and a value (properties/9); under HEGEL_NO_KNOWN=1 the
+// continuation comes after the separator.
+var separatorAfterContinuationTexts = loadCasesOf(framed(shaped(
+	cat(maybe(15, indents), safeKeys, hegel.SampledFrom([]string{" ", "\t", "  ", "\f"}), continuations, hegel.SampledFrom([]string{"=", ":", "= ", ": ", "=\t"}), tailValues),
+	cat(maybe(15, indents), safeKeys, sepChars, continuations, tailValues),
+)))
+
+// TestHegelSeparatorAfterContinuationSplitsTheLine: Java joins the physical
+// lines first and then splits the logical line at its separator, so a
+// continuation between the key and the separator changes nothing; the lexer
+// looks for the separator before the continuation is processed and reads
+// the separator into the value (properties/9).
+func TestHegelSeparatorAfterContinuationSplitsTheLine(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, separatorAfterContinuationTexts)
+		loadAgrees(ht, o, c.text, c.iso, knownLoad(c.text))
+	})
+}
+
+// --------------------------------------------------------------------------- the Write shapes
+
+// headsOf: the start of a string before a shaped piece: nothing one time in
+// three, else a clean first piece and up to one more.
+func headsOf(o rawOpts) hegel.Generator[string] {
+	return weighted(choice[string]{1, lit("")}, choice[string]{2, cat(piecesOf(o, true, true), joined(many(piecesOf(o, false, false), 0, 1)))})
+}
+
+// tailsOf: up to two pieces after a shaped piece.
+func tailsOf(o rawOpts) hegel.Generator[string] { return joined(many(piecesOf(o, false, false), 0, 2)) }
+
+// mapWith: a clean map of the encoding plus one entry of the key and value
+// generators.
+func mapWith(iso bool, keys, values hegel.Generator[string]) hegel.Generator[writeCase] {
+	base := cleanWriteMaps[at(iso)]
+	return hegel.Composite(func(tc hegel.TestCase) writeCase {
+		m := hegel.Draw(tc, base)
+		m[hegel.Draw(tc, keys)] = hegel.Draw(tc, values)
+		return writeCase{m, iso}
+	})
+}
+
+// entryWith: a clean map of the encoding plus an entry whose value (first)
+// or key holds the shaped piece between a head and a tail.
+func entryWith(iso bool, piece hegel.Generator[string]) hegel.Generator[writeCase] {
+	o := writeOpts(iso, false)
+	around := cat(headsOf(o), piece, tailsOf(o))
+	return hegel.OneOf(mapWith(iso, keysOf(o), around), mapWith(iso, around, valuesOf(o)))
+}
+
+// --------------------------------------------------------------------------- properties/6
+
+var markers = hegel.SampledFrom([]string{"#", "!"})
+
+// leadingMarkerCases: a map with a key beginning with # or ! (properties/6),
+// under either encoding; under HEGEL_NO_KNOWN=1 the marker comes after a
+// clean first piece.
+var leadingMarkerCases = perEncoding(func() (gens [2]hegel.Generator[writeCase]) {
+	for _, iso := range []bool{false, true} {
+		o := writeOpts(iso, false)
+		key := shaped(cat(markers, tailsOf(o)), cat(piecesOf(o, true, true), markers, tailsOf(o)))
+		gens[at(iso)] = mapWith(iso, key, valuesOf(o))
+	}
+	return gens
+}())
+
+// TestHegelWrittenLeadingCommentMarkersReadBack: a key beginning with # or !
+// is written escaped, as Java's store writes it, so that the line is a
+// property when read back; Write leaves the marker bare and Java (and the
+// package itself) reads a comment (properties/6).
+func TestHegelWrittenLeadingCommentMarkersReadBack(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, leadingMarkerCases)
+		writeAgrees(ht, o, c.m, c.iso, knownWrite(c.m, c.iso))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/7
+
+// latin1Cases: a map written as ISO-8859-1 with a character of U+0080-U+00FF
+// in a key or a value (properties/7); under HEGEL_NO_KNOWN=1 a Latin Extended
+// letter (U+0100-U+024F), which is written as its \uXXXX literal.
+var latin1Cases = entryWith(true, hegel.Map(shaped(hegel.Integers(0x80, 0xFF), hegel.Integers(0x100, 0x24F)), func(cp int) string { return string(rune(cp)) }))
+
+// TestHegelWrittenLatin1ReadsBackUnderISO88591: under ISO-8859-1 a character
+// of U+0080-U+00FF is one byte of the output, so Java reading it as
+// ISO-8859-1 gets the character back; Write emits its UTF-8 bytes and Java
+// reads two characters (properties/7).
+func TestHegelWrittenLatin1ReadsBackUnderISO88591(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, latin1Cases)
+		writeAgrees(ht, o, c.m, c.iso, knownWrite(c.m, c.iso))
+	})
+}
+
+// --------------------------------------------------------------------------- properties/8
+
+// unicodeSpaces: the White_Space characters above U+00FF.
+var unicodeSpaces = hegel.SampledFrom([]string{
+	"\u1680", "\u2000", "\u2001", "\u2002", "\u2003", "\u2004", "\u2005", "\u2006", "\u2007",
+	"\u2008", "\u2009", "\u200a", "\u2028", "\u2029", "\u202f", "\u205f", "\u3000",
+})
+
+// leadingSpaceCases: a map written as ISO-8859-1 with a key or a value
+// beginning with a Unicode space above U+00FF (properties/8); under
+// HEGEL_NO_KNOWN=1 the space comes after a clean first piece.
+var leadingSpaceCases = func() hegel.Generator[writeCase] {
+	o := writeOpts(true, false)
+	around := cat(shaped(lit(""), cat(piecesOf(o, true, true), joined(many(piecesOf(o, false, false), 0, 1)))), unicodeSpaces, tailsOf(o))
+	return hegel.OneOf(mapWith(true, keysOf(o), around), mapWith(true, around, valuesOf(o)))
+}()
+
+// TestHegelWrittenLeadingUnicodeSpaceReadsBackUnderISO88591: under
+// ISO-8859-1 a character above U+00FF is written as its \uXXXX literal
+// wherever it is, so Java reads it back; Write emits a leading Unicode space
+// raw, as UTF-8 bytes, and Java reads three characters (properties/8).
+func TestHegelWrittenLeadingUnicodeSpaceReadsBackUnderISO88591(t *testing.T) {
+	o := getOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, leadingSpaceCases)
+		writeAgrees(ht, o, c.m, c.iso, knownWrite(c.m, c.iso))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..8f291ea
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,451 @@
+package hegel
+
+// Hegel property tests for magiconair/properties. Generated .properties
+// texts are loaded by this package and by java.util.Properties (a child
+// JVM, Oracle.java) and must give the same key/value map; what this package
+// writes, Java must read back unchanged, and what Java stores, this package
+// must read back unchanged.
+//
+// Every property draws one case (a text and its encoding, a map and its
+// encoding) from the generator values of hegel_props_test.go: a text is
+// lines rendered by pure functions from drawn pieces, a map is drawn from
+// piece pools shaped per encoding. The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the wide properties that
+// meet them fail, naming the shape (mismatch, below), and are the expected
+// failures mapped to the bugs (STYLE.md rule 11); hegel_shapes_test.go has
+// one property per bug over its shape region alone, and hegel_pins_test.go
+// the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, known.go) for a run that looks past the bugs.
+//
+// Needs java (11 or later; the source launcher runs Oracle.java).
+
+import (
+	"bufio"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+// property runs fn as a Hegel property, turning a panic in the harness or
+// the code under test into a failure of the current test case (hegel-go
+// re-raises panics after shrinking, which would abort the test binary and
+// hide every later test); Hegel's own control-flow panics pass. It prints
+// the counts of the noted case kinds at the end.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// hegelOpts passes HEGEL_TEST_CASES through (hegel-go reads no environment
+// variable itself).
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with Java on a case whose shape is that of
+// the recorded bug shape names ("" for none): the failure names the shape,
+// and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is counted and
+// skipped instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown && shape != "" {
+		count("skipped, the shape of " + shape)
+		ht.Assume(false)
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// cat draws one string from each generator and joins them: the pieces of a
+// line.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// joined is the strings of g concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ss []string) string { return strings.Join(ss, "") })
+}
+
+// without is the pool less the values.
+func without(pool []string, drop ...string) []string {
+	var out []string
+	for _, s := range pool {
+		keep := true
+		for _, d := range drop {
+			keep = keep && s != d
+		}
+		if keep {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// The Java oracle: one child JVM per test binary, one request line in, one
+// answer line out. Strings travel as "x" + hex(UTF-8).
+
+type oracle struct {
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   io.WriteCloser
+	out  *bufio.Reader
+	errs strings.Builder
+}
+
+var (
+	theOracle     *oracle
+	theOracleErr  error
+	theOracleOnce sync.Once
+)
+
+func getOracle(t testing.TB) *oracle {
+	t.Helper()
+	theOracleOnce.Do(func() {
+		if _, err := exec.LookPath("java"); err != nil {
+			theOracleErr = fmt.Errorf("java not found: %v", err)
+			return
+		}
+		cmd := exec.Command("java", "Oracle.java")
+		cmd.Env = append(os.Environ(), "LC_ALL=C.UTF-8")
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			theOracleErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			theOracleErr = err
+			return
+		}
+		o := &oracle{cmd: cmd, in: in, out: bufio.NewReaderSize(out, 1<<20)}
+		cmd.Stderr = &o.errs
+		if err := cmd.Start(); err != nil {
+			theOracleErr = fmt.Errorf("starting java: %v", err)
+			return
+		}
+		// A first request proves the oracle compiled and answers.
+		if _, err := o.load("a=b", false); err != nil {
+			theOracleErr = fmt.Errorf("oracle does not answer: %v\n%s", err, o.errs.String())
+			return
+		}
+		theOracle = o
+	})
+	if theOracleErr != nil {
+		t.Fatalf("%v", theOracleErr)
+	}
+	return theOracle
+}
+
+func enc(s string) string { return "x" + hex.EncodeToString([]byte(s)) }
+
+func dec(s string) (string, error) {
+	if !strings.HasPrefix(s, "x") {
+		return "", fmt.Errorf("bad string field %q", s)
+	}
+	b, err := hex.DecodeString(s[1:])
+	return string(b), err
+}
+
+// call sends one request line and reads one answer line.
+func (o *oracle) call(req string) (string, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if _, err := io.WriteString(o.in, req+"\n"); err != nil {
+		return "", fmt.Errorf("oracle write: %v\n%s", err, o.errs.String())
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return "", fmt.Errorf("oracle read: %v\n%s", err, o.errs.String())
+	}
+	return strings.TrimRight(line, "\r\n"), nil
+}
+
+// javaError is an exception thrown by java.util.Properties.
+type javaError struct{ msg string }
+
+func (e *javaError) Error() string { return "java: " + e.msg }
+
+// load runs Properties.load on text (read as UTF-8, or ISO-8859-1 when iso)
+// and returns the map. A Java exception is a *javaError.
+func (o *oracle) load(text string, iso bool) (map[string]string, error) {
+	req := "load " + enc(text)
+	if iso {
+		req += " iso"
+	}
+	ans, err := o.call(req)
+	if err != nil {
+		return nil, err
+	}
+	f := strings.Split(ans, " ")
+	switch f[0] {
+	case "error":
+		msg, _ := dec(f[1])
+		return nil, &javaError{msg}
+	case "ok":
+		k, _ := strconv.Atoi(f[1])
+		if len(f) != 2+2*k {
+			return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+		}
+		m := make(map[string]string, k)
+		for i := 0; i < k; i++ {
+			key, err1 := dec(f[2+2*i])
+			val, err2 := dec(f[3+2*i])
+			if err1 != nil || err2 != nil {
+				return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+			}
+			m[key] = val
+		}
+		return m, nil
+	}
+	return nil, fmt.Errorf("oracle: malformed answer %q", ans)
+}
+
+// store runs Properties.store(Writer) on the map and returns the text.
+func (o *oracle) store(m map[string]string) (string, error) {
+	var b strings.Builder
+	b.WriteString("store")
+	for _, k := range sortedKeys(m) {
+		b.WriteString(" " + enc(k) + " " + enc(m[k]))
+	}
+	ans, err := o.call(b.String())
+	if err != nil {
+		return "", err
+	}
+	f := strings.SplitN(ans, " ", 2)
+	if f[0] == "error" {
+		msg, _ := dec(f[1])
+		return "", &javaError{msg}
+	}
+	if f[0] != "ok" || len(f) != 2 {
+		return "", fmt.Errorf("oracle: malformed answer %q", ans)
+	}
+	return dec(f[1])
+}
+
+func sortedKeys(m map[string]string) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// showMap spells a map one entry per line, quoted.
+func showMap(m map[string]string) string {
+	if len(m) == 0 {
+		return "  (empty)\n"
+	}
+	var b strings.Builder
+	for _, k := range sortedKeys(m) {
+		fmt.Fprintf(&b, "  %q = %q\n", k, m[k])
+	}
+	return b.String()
+}
+
+// diffMaps names the first difference between two maps.
+func diffMaps(got, want map[string]string) string {
+	for _, k := range sortedKeys(want) {
+		g, ok := got[k]
+		if !ok {
+			return fmt.Sprintf("key %q missing", k)
+		}
+		if g != want[k] {
+			return fmt.Sprintf("key %q: got %q, want %q", k, g, want[k])
+		}
+	}
+	for _, k := range sortedKeys(got) {
+		if _, ok := want[k]; !ok {
+			return fmt.Sprintf("extra key %q = %q", k, got[k])
+		}
+	}
+	return ""
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..2529090
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,187 @@
+package hegel
+
+import (
+	"os"
+	"strings"
+	"unicode"
+)
+
+// The shapes of the recorded bugs (bugs.toml), scanned in java.util.Properties'
+// terms. knownLoad and knownWrite name the bug whose shape a case has, or
+// return "": by default a property that meets a shape fails naming it
+// (mismatch, hegel_test.go), and under HEGEL_NO_KNOWN=1 the generators leave
+// the shapes out (hegel_props_test.go) and a disagreement on one that slipped
+// through is skipped. The pins in hegel_pins_test.go reproduce each bug
+// deterministically, and hegel_shapes_test.go has a property per bug.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs, read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// knownLoad names the recorded load bug whose shape the text has.
+func knownLoad(text string) string {
+	sh := shapeOf(text)
+	switch {
+	case sh.eofBackslash:
+		return "properties/2"
+	case sh.keyContinued:
+		return "properties/1"
+	case sh.crlfContinued:
+		return "properties/4"
+	case sh.sepContinued:
+		return "properties/9"
+	case sh.emptyKey:
+		return "properties/3"
+	case sh.surrogate:
+		return "properties/5"
+	}
+	return ""
+}
+
+// surrogateLiteral reports a \uD800-\uDBFF literal (the first half of a
+// surrogate pair) in the text.
+func surrogateLiteral(text string) bool {
+	for i := 0; i+5 < len(text); i++ {
+		if text[i] == '\\' && text[i+1] == 'u' && (text[i+2] == 'd' || text[i+2] == 'D') &&
+			strings.IndexByte("89abAB", text[i+3]) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// knownWrite names the recorded Write bug whose shape the map has under the
+// encoding.
+func knownWrite(m map[string]string, iso bool) string {
+	for k, v := range m {
+		if strings.HasPrefix(k, "#") || strings.HasPrefix(k, "!") {
+			return "properties/6"
+		}
+		if iso {
+			for _, r := range k + v {
+				if r >= 0x80 && r <= 0xFF {
+					return "properties/7"
+				}
+			}
+			for _, s := range []string{k, v} {
+				if r := firstRune(s); r > 0xFF && unicode.IsSpace(r) {
+					return "properties/8"
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func firstRune(s string) rune {
+	for _, r := range s {
+		return r
+	}
+	return 0
+}
+
+// shape is what a scan of the text in java.util.Properties' terms finds.
+type shape struct {
+	keyContinued  bool // a backslash-newline while still in a key
+	crlfContinued bool // a backslash before CR LF
+	eofBackslash  bool // the text ends in an unescaped backslash (not in a comment)
+	emptyKey      bool // a logical line whose key is empty (begins with = or :)
+	sepContinued  bool // a backslash-newline between the key and its = or :
+	surrogate     bool // a \uD800-\uDBFF literal
+}
+
+// hasKnown reports whether the text has the shape of any recorded bug.
+func (sh shape) hasKnown() bool {
+	return sh.keyContinued || sh.crlfContinued || sh.eofBackslash || sh.emptyKey || sh.sepContinued || sh.surrogate
+}
+
+// shapeFree reports whether the text has the shape of no recorded bug.
+func shapeFree(text string) bool { return !shapeOf(text).hasKnown() }
+
+// shapeOf scans text as Java's LineReader and key/value split do. A
+// continuation in the separator zone is the shape of properties/9 only when
+// no = or : has been seen yet and one follows the continuation (the lexer
+// reads it into the value); a continuation after the separator, or before a
+// plain value, is read as Java reads it.
+func shapeOf(text string) shape {
+	var sh shape
+	sh.surrogate = surrogateLiteral(text)
+	i := 0
+	for i < len(text) {
+		// Skip blank lines and leading whitespace.
+		for i < len(text) && strings.IndexByte(" \t\f\r\n", text[i]) >= 0 {
+			i++
+		}
+		if i >= len(text) {
+			break
+		}
+		if text[i] == '#' || text[i] == '!' {
+			for i < len(text) && text[i] != '\n' && text[i] != '\r' {
+				i++
+			}
+			continue
+		}
+		// A logical line: key, separator zone (whitespace, one = or :,
+		// whitespace), value; continuations join physical lines.
+		inKey := true
+		inSep := false
+		sepSeen := false
+		first := true
+		for i < len(text) {
+			c := text[i]
+			if inSep && (c == ' ' || c == '\t' || c == '\f' || (!sepSeen && (c == '=' || c == ':'))) {
+				if c == '=' || c == ':' {
+					sepSeen = true
+				}
+				i++
+				continue
+			}
+			if inSep && c != '\\' && c != '\n' && c != '\r' {
+				inSep = false // the value begins
+			}
+			if c == '\\' {
+				if i+1 >= len(text) {
+					sh.eofBackslash = true
+					i++
+					break
+				}
+				if text[i+1] == '\n' || text[i+1] == '\r' {
+					next := i + 2
+					if text[i+1] == '\r' && next < len(text) && text[next] == '\n' {
+						sh.crlfContinued = true
+						next++
+					}
+					for next < len(text) && strings.IndexByte(" \t\f", text[next]) >= 0 {
+						next++
+					}
+					if inKey {
+						sh.keyContinued = true
+					}
