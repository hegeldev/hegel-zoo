+// --------------------------------------------------------------------------- complex paths
+
+// glob matches tidwall/match's syntax on runes: * any run, ? one rune.
+func glob(pattern, s string) bool {
+	p, t := []rune(pattern), []rune(s)
+	var rec func(i, j int) bool
+	rec = func(i, j int) bool {
+		for i < len(p) {
+			switch p[i] {
+			case '*':
+				for k := j; k <= len(t); k++ {
+					if rec(i+1, k) {
+						return true
+					}
+				}
+				return false
+			case '?':
+				if j >= len(t) {
+					return false
+				}
+				i, j = i+1, j+1
+			default:
+				if j >= len(t) || p[i] != t[j] {
+					return false
+				}
+				i, j = i+1, j+1
+			}
+		}
+		return j == len(t)
+	}
+	return rec(0, 0)
+}
+
+// gjsonEscape writes a literal component for gjson (every metacharacter escaped).
+func gjsonEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if strings.ContainsRune(`.\*?|#@!:[]{}()`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// TestHegelComplexPathsSetEveryMatch: `arr.#.key` sets the key in every element that has it,
+// a wildcard component sets the first key in document order that matches, no match leaves the
+// document as it was, and Delete refuses complex paths.
+func TestHegelComplexPathsSetEveryMatch(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		root := genRoot(ht)
+		doc := genDoc(ht, root)
+		val := genValue(ht)
+		if val.nonFinite || val.isRaw {
+			c.count("gated:value")
+			return
+		}
+		// walk to a container through simple parts (no -1, no forced keys, no empty keys)
+		var prefix []string
+		cur := root
+		for steps := n(ht, 0, 3); steps > 0; steps-- {
+			if cur.kind == 'o' && len(cur.keys) > 0 {
+				i := n(ht, 0, len(cur.keys)-1)
+				if cur.keys[i] == "" {
+					break
+				}
+				prefix = append(prefix, gjsonEscape(cur.keys[i]))
+				cur = cur.vals[i]
+			} else if cur.kind == 'a' && len(cur.elems) > 0 {
+				i := n(ht, 0, len(cur.elems)-1)
+				prefix = append(prefix, strconv.Itoa(i))
+				cur = cur.elems[i]
+			} else {
+				break
+			}
+			if !(cur.kind == 'o' || cur.kind == 'a') {
+				return
+			}
+		}
+		expect := root.clone()
+		ecur := expect
+		for _, p := range prefix {
+			if ecur.kind == 'o' {
+				ecur = ecur.vals[ecur.find(unescapeG(p))]
+			} else {
+				i, _ := strconv.Atoi(p)
+				ecur = ecur.elems[i]
+			}
+		}
+		var tail string
+		changed := false
+		switch {
+		case cur.kind == 'a':
+			// #.key over the elements
+			var keys []string
+			for _, e := range cur.elems {
+				if e.kind == 'o' {
+					keys = append(keys, e.keys...)
+				}
+			}
+			var k string
+			if len(keys) > 0 && chance(ht, 85) {
+				k = pick(ht, keys)
+			} else {
+				k = genKey(ht)
+			}
+			if k == "" || k == "-1" {
+				return
+			}
+			if _, digits := isIndex(part{key: k}); digits {
+				// #.N on arrays of arrays is an index; keep to object keys
+				k += "k"
+			}
+			tail = "#." + gjsonEscape(k)
+			for _, e := range ecur.elems {
+				if e.kind == 'o' {
+					if i := e.find(k); i >= 0 {
+						e.vals[i] = val.expect
+						changed = true
+					}
+				}
+			}
+			c.count("hash-key")
+		default:
+			if len(cur.keys) == 0 {
+				return
+			}
+			k := pick(ht, cur.keys)
+			if k == "" || strings.ContainsAny(k, "*?\\") {
+				return
+			}
+			rs := []rune(k)
+			pat := make([]rune, 0, len(rs))
+			wild := false
+			for i, r := range rs {
+				switch {
+				case chance(ht, 25):
+					pat = append(pat, '?')
+					wild = true
+				case chance(ht, 15):
+					pat = append(pat, '*')
+					wild = true
+					for i+1 < len(rs) && chance(ht, 50) {
+						i++
+					}
+				default:
+					pat = append(pat, r)
+				}
+			}
+			if !wild {
+				pat = append(pat, '*')
+			}
+			pattern := string(pat)
+			var esc strings.Builder
+			for _, r := range pattern {
+				if r != '*' && r != '?' && strings.ContainsRune(`.\|#@!:[]{}()`, r) {
+					esc.WriteByte('\\')
+				}
+				esc.WriteRune(r)
+			}
+			tail = esc.String()
+			for i, key := range ecur.keys {
+				if glob(pattern, key) {
+					ecur.vals[i] = val.expect
+					changed = true
+					break
+				}
+			}
+			c.count("wildcard")
+		}
+		path := strings.Join(append(prefix, tail), ".")
+		if strings.Count(path, "#") > 1 && Known.nestedHashCorrupts {
+			c.count("gated:nested-hash")
+			return
+		}
+		out, err := Set(doc, path, val.v)
+		what := fmt.Sprintf("Set(%s, %q, %s)", show(doc), path, describe(val))
+		if err != nil {
+			c.fail(ht, "%s returned an error: %v", what, err)
+			return
+		}
+		if !changed {
+			c.count("no-match")
+			if out != doc {
+				c.fail(ht, "%s = %s changed a document with no match", what, show(out))
+			}
+		} else {
+			if !json.Valid([]byte(out)) {
+				c.fail(ht, "%s produced invalid JSON %s", what, show(out))
+				return
+			}
+			got, _ := decode(out)
+			if !same(got, expect) {
+				c.fail(ht, "%s = %s, want %s", what, show(out), show(compactOf(expect)))
+				return
+			}
+		}
+		dout, derr := Delete(doc, path)
+		if derr == nil || dout != doc {
+			c.fail(ht, "Delete(%s, %q) = %s, %v; want the input back with an error", show(doc), path, show(dout), derr)
+		}
+	})
+}
+
+func unescapeG(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			i++
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- robustness
+
+const pathAlphabet = "abkxz019 _-:.*?\\|#@!\"[](){},~%<>=+'/é😀"
+
+// capDigits keeps every digit run short: a large index asks sjson for that many nulls (and a
+// wrapped one for 2^63 of them). A backslash does not end a run, since sjson strips it.
+func capDigits(s string) string {
+	var b strings.Builder
+	run := 0
+	for _, r := range s {
+		switch {
+		case r >= '0' && r <= '9':
+			run++
+			if run > 3 {
+				r = 'x'
+			}
+		case r == '\\':
+		default:
+			run = 0
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
