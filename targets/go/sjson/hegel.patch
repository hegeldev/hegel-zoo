diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..bdd262d
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,154 @@
+package sjson_test
+
+// One plain test per recorded bug (bugs.toml). Each asserts the correct behaviour, so it fails
+// while the bug exists and passes once upstream fixes it; target.toml lists them as expected
+// failures.
+
+import (
+	"encoding/json"
+	"math"
+	"testing"
+
+	. "github.com/tidwall/sjson"
+)
+
+// sjson/1: atoui wraps around on a large index; the padding loop then runs for the wrapped
+// count (with [1] and 9223372036854775808 that is 2^63-1 nulls, and with [] and
+// 99999999999999999999 about 7.8e18: both exhaust memory), or the value lands at a small index.
+// The pin uses only the two indices whose wrapped count is 0 or 1; do not add others.
+func TestHegelPinHugeIndexIsAnError(t *testing.T) {
+	for _, idx := range []string{"18446744073709551617", "9223372036854775808"} {
+		out, err := Set(`[]`, idx, 1)
+		if err == nil {
+			t.Errorf("Set([], %q, 1) = %q with no error; want an error (or an array of that length)", idx, out)
+		}
+	}
+}
+
+// sjson/2: float64 values go through strconv.FormatFloat, which writes NaN, +Inf and -Inf;
+// encoding/json refuses them (json: unsupported value).
+func TestHegelPinNonFiniteFloatsAreRefused(t *testing.T) {
+	for _, f := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		out, err := Set(`{}`, "a", f)
+		if err == nil && !json.Valid([]byte(out)) {
+			t.Errorf("Set({}, a, %v) = %q, invalid JSON and no error", f, out)
+		}
+		out, err = Set(`{}`, "a", float32(f))
+		if err == nil && !json.Valid([]byte(out)) {
+			t.Errorf("Set({}, a, float32(%v)) = %q, invalid JSON and no error", f, out)
+		}
+	}
+}
+
+// sjson/3: with Optimistic and ReplaceInPlace, a string value that needs escaping and fits in
+// the buffer is not written at all: the input comes back unchanged with a nil error.
+func TestHegelPinInPlaceWritesEscapedStrings(t *testing.T) {
+	doc := []byte(`{"a":"xyz","b":1}`)
+	out, err := SetBytesOptions(doc, "a", "q\"", &Options{Optimistic: true, ReplaceInPlace: true})
+	if err != nil {
+		t.Fatalf("error: %v", err)
+	}
+	if want := `{"a":"q\"","b":1}`; string(out) != want {
+		t.Fatalf("SetBytesOptions(%s, a, q\") in place = %s, want %s", `{"a":"xyz","b":1}`, out, want)
+	}
+}
+
+// sjson/4: an empty path component is the key "" in an existing object but counts as numeric
+// (index 0) when a container has to be created, and appends to an existing array.
+func TestHegelPinEmptyComponentIsTheEmptyKey(t *testing.T) {
+	if out, err := Set(`{}`, "a.", 1); err != nil || out != `{"a":{"":1}}` {
+		t.Errorf("Set({}, \"a.\", 1) = %q, %v; want {\"a\":{\"\":1}} like Set({\"a\":{}}, \"a.\", 1)", out, err)
+	}
+	if out, err := Set(`{"a":[1,2]}`, "a.", 9); err == nil {
+		t.Errorf("Set({\"a\":[1,2]}, \"a.\", 9) = %q with no error; want the non-numeric key error", out)
+	}
+}
+
+// sjson/5: a colon forces a string key, which an array cannot hold; :N errors when element N
+// is missing but silently replaces it when it exists.
+func TestHegelPinForcedKeyOnArrayIsAnError(t *testing.T) {
+	if out, err := Set(`[1]`, ":0", 2); err == nil {
+		t.Errorf("Set([1], \":0\", 2) = %q with no error, while Set([1], \":1\", 2) errors", out)
+	}
+	if out, err := Delete(`[1,2]`, ":0"); err != nil || out != `[1,2]` {
+		t.Errorf("Delete([1,2], \":0\") = %q, %v; want the input back", out, err)
+	}
+}
+
+// sjson/6: -1 appends to an array and creates one under a missing key, but under a scalar or
+// on an empty document it creates an object with the key "-1".
+func TestHegelPinMinusOneCreatesAnArrayEverywhere(t *testing.T) {
+	if out, err := Set(``, "-1", 1); err != nil || out != `[1]` {
+		t.Errorf("Set(\"\", \"-1\", 1) = %q, %v; want [1]", out, err)
+	}
+	if out, err := Set(`{"a":5}`, "a.-1", 1); err != nil || out != `{"a":[1]}` {
+		t.Errorf("Set({\"a\":5}, \"a.-1\", 1) = %q, %v; want {\"a\":[1]} like Set({}, \"a.-1\", 1)", out, err)
+	}
+}
+
+// sjson/7: [ and { are simple characters for sjson's path parser but start a multipath for
+// gjson, which sjson uses to find the key, and ! followed by a JSON literal is a literal value
+// there; the key is never found and a duplicate is appended.
+func TestHegelPinKeysStartingWithABracketAreFound(t *testing.T) {
+	for _, k := range []string{"[a", "{a", "[", "{", "!1", "!true", "![", "!-"} {
+		doc := `{"` + k + `":1}`
+		out, err := Set(doc, k, 2)
+		want := `{"` + k + `":2}`
+		if err != nil || out != want {
+			t.Errorf("Set(%s, %q, 2) = %q, %v; want %s", doc, k, out, err, want)
+		}
+	}
+}
+
+// sjson/8: for a path with two # segments gjson reports Indexes of 0 (it does not track nested
+// positions); setComplexPath writes the value at each of them, so the front of the document is
+// overwritten.
+func TestHegelPinNestedHashPathsDoNotCorruptTheDocument(t *testing.T) {
+	doc := `[{"k":[{"x":1}]},{"k":[{"x":2},{"y":3}]}]`
+	out, err := Set(doc, "#.k.#.x", 9)
+	if err != nil {
+		return // refusing the path is fine
+	}
+	if want := `[{"k":[{"x":9}]},{"k":[{"x":9},{"y":3}]}]`; out != want {
+		t.Fatalf("Set(%s, \"#.k.#.x\", 9) = %q; want %s (or an error)", doc, out, want)
+	}
+}
+
+// sjson/9: parsePath lets a backslash escape any character and strips it from the component,
+// so `\0` is the numeric component 0 for sjson; gjson, asked to find the element with the
+// escaped text, treats it as a key and finds nothing in an array, so Set appends instead of
+// replacing element 0 and Delete leaves the array alone.
+func TestHegelPinEscapedDigitsAreStillAnIndex(t *testing.T) {
+	if out, err := Set(`[1,2]`, `\0`, 9); err != nil || out != `[9,2]` {
+		t.Errorf("Set([1,2], `\\0`, 9) = %q, %v; want [9,2] like Set([1,2], \"0\", 9)", out, err)
+	}
+	if out, err := Delete(`[1,2]`, `\0`); err != nil || out != `[2]` {
+		t.Errorf("Delete([1,2], `\\0`) = %q, %v; want [2]", out, err)
+	}
+}
+
+// sjson/10: deleteTailItem walks back from the key's closing quote to its opening quote and
+// skips any quote preceded by a backslash; when the key starts with an escaped quote the opening
+// quote is skipped too, and the walk goes on into the members before it.
+func TestHegelPinDeletingAKeyStartingWithAQuoteKeepsTheRest(t *testing.T) {
+	if out, err := Delete(`{"a":1,"\"":2}`, `"`); err != nil || out != `{"a":1}` {
+		t.Errorf("Delete({\"a\":1,\"\\\"\":2}, `\"`) = %q, %v; want {\"a\":1}", out, err)
+	}
+	if out, err := Delete(`{"\"":2,"a":1}`, `"`); err != nil || out != `{"a":1}` {
+		t.Errorf("Delete({\"\\\"\":2,\"a\":1}, `\"`) = %q, %v; want {\"a\":1}", out, err)
+	}
+	if out, err := Delete(`{"a":1,"\"x":2}`, `"x`); err != nil || out != `{"a":1}` {
+		t.Errorf("Delete({\"a\":1,\"\\\"x\":2}, `\"x`) = %q, %v; want {\"a\":1}", out, err)
+	}
+}
+
+// sjson/11: Delete of the component -1 asks gjson for "#" to find the last index; on an object
+// that is the member named "#", whose value is taken for the array length.
+func TestHegelPinMinusOneOnAnObjectIsTheKey(t *testing.T) {
+	if out, err := Delete(`{"#":true,"-1":1}`, "-1"); err != nil || out != `{"#":true}` {
+		t.Errorf("Delete({\"#\":true,\"-1\":1}, \"-1\") = %q, %v; want {\"#\":true}", out, err)
+	}
+	if out, err := Delete(`{"#":2,"1":5,"-1":1}`, "-1"); err != nil || out != `{"#":2,"1":5}` {
+		t.Errorf("Delete({\"#\":2,\"1\":5,\"-1\":1}, \"-1\") = %q, %v; want {\"#\":2,\"1\":5}", out, err)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..2bdded0
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,587 @@
+package sjson_test
+
+// One narrow property per recorded bug (targets/go/sjson/bugs.toml): random documents and
+// values with the bug's path shape, judged by the model of hegel_test.go. Each draws the
+// shape of its bug by default and fails on it (the pin beside it is the regression example);
+// under HEGEL_NO_KNOWN=1 it draws the neighbouring region instead and passes.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// withMember puts a member at a position of the object (modulo its size), dropping any
+// member of that key first.
+func withMember(o *node, at int, key string, val *node) {
+	if i := o.find(key); i >= 0 {
+		o.keys = append(o.keys[:i], o.keys[i+1:]...)
+		o.vals = append(o.vals[:i], o.vals[i+1:]...)
+	}
+	pos := at % (len(o.keys) + 1)
+	o.keys = append(o.keys[:pos], append([]string{key}, o.keys[pos:]...)...)
+	o.vals = append(o.vals[:pos], append([]*node{val}, o.vals[pos:]...)...)
+}
+
+// narrowApis is the API a narrow property about a path shape calls: any of the four, but not
+// the in-place one for a string that needs escapes (that is sjson/3's own property).
+func narrowApis(val value) hegel.Generator[int] {
+	if val.needsEsc {
+		return hegel.Integers(0, 2)
+	}
+	return hegel.Integers(0, 3)
+}
+
+func setString(api int, doc document, parts []part, val value) string {
+	path, _, _ := joinPath(parts)
+	return fmt.Sprintf("%s(%s, %q, %s)", apiNames[api], show(doc.text()), path, describe(val))
+}
+
+func deleteString(api int, doc document, parts []part) string {
+	path, _, _ := joinPath(parts)
+	return fmt.Sprintf("%s(%s, %q)", deleteNames[api], show(doc.text()), path)
+}
+
+var (
+	nonEmptyArrays = hegel.Map(many(nodes, 1, 5), arrNode)
+	plainKeys      = word("abkxz019_", 1, 4) // optimistic for sjson, nothing to escape
+	existingSpecs  = partSpecsOf(hegel.Just("existing"))
+	// prefixes: none, one or two existing components leading into the document.
+	prefixes = hegel.FlatMap(
+		weighted(choice[int]{2, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}),
+		func(n int) hegel.Generator[[]partSpec] { return many(existingSpecs, n, n) })
+)
+
+// --------------------------------------------------------------------------- sjson/1
+
+// wrappingIndexCase: an array document and an index text at or above 2^63 (an index past
+// the end of any array, whose count wraps in sjson); past: an index that fits, at or just
+// past the end.
+type wrappingIndexCase struct {
+	doc   document
+	index string
+	val   value
+	api   int
+}
+
+func (c wrappingIndexCase) GoString() string {
+	return setString(c.api, c.doc, []part{{key: c.index}}, c.val)
+}
+
+var wrappingIndexCases = hegel.Composite(func(tc hegel.TestCase) wrappingIndexCase {
+	doc := hegel.Draw(tc, docsOf(arrayRoots))
+	fitting := hegel.Map(hegel.Integers(0, 3), func(w int) string { return strconv.Itoa(len(doc.root.elems) + w) })
+	val := hegel.Draw(tc, finiteValues)
+	return wrappingIndexCase{doc: doc, index: hegel.Draw(tc, shaped(hugeIndexTexts, fitting)), val: val, api: hegel.Draw(tc, narrowApis(val))}
+})
+
+// TestHegelWrappingIndexIsAnError: an index at or above 2^63 on an array is an error with the
+// input returned, like any index the document cannot be padded to; an index that fits pads
+// the array with nulls.
+func TestHegelWrappingIndexIsAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wrappingIndexCases)
+		parts := []part{{key: c.index}}
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, c.api, shapesOf("sjson/1", setShapes(c.doc.root, parts, c.val, c.api)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/2
+
+// nonFiniteCase: any document and path with NaN or an infinity; past: a finite float.
+type nonFiniteCase struct {
+	doc   document
+	parts []partSpec
+	val   value
+	api   int
+}
+
+func (c nonFiniteCase) GoString() string {
+	return setString(c.api, c.doc, plan(c.doc.root, c.parts), c.val)
+}
+
+var nonFiniteCases = hegel.Composite(func(tc hegel.TestCase) nonFiniteCase {
+	return nonFiniteCase{
+		doc:   hegel.Draw(tc, documents),
+		parts: hegel.Draw(tc, deleteParts),
+		val:   hegel.Draw(tc, shaped(nonFinites, float64s)),
+		api:   hegel.Draw(tc, hegel.Integers(0, 3)),
+	}
+})
+
+// TestHegelNonFiniteValuesAreAnError: Set of NaN or an infinity is an error with the input
+// returned, as encoding/json refuses them; a finite float is written in Go's shortest form.
+func TestHegelNonFiniteValuesAreAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nonFiniteCases)
+		parts := plan(c.doc.root, c.parts)
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, c.api, shapesOf("sjson/2", setShapes(c.doc.root, parts, c.val, c.api)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/3
+
+// inPlaceCase: an object with a string member long enough for a short replacement to fit in
+// place, and a replacement that needs escaping; past: a plain replacement.
+type inPlaceCase struct {
+	doc document
+	key string
+	val value
+}
+
+func (c inPlaceCase) GoString() string {
+	return setString(3, c.doc, []part{{key: c.key}}, c.val)
+}
+
+var (
+	// escapables: one character that makes a string need escaping (a quote, a backslash,
+	// controls, non-ASCII, a byte that is not UTF-8).
+	escapables     = hegel.SampledFrom([]string{`"`, `\`, "\n", "\t", "\x00", "\x1f", "\u00e9", "\U0001F600", "\xff"})
+	escapedStrings = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, word("abkxz019 ", 0, 3)) + hegel.Draw(tc, escapables)
+	})
+	plainStrings = word("abkxz019 ", 0, 4)
+	paddings     = word("abkxz019 ", 8, 16)
+	inPlaceCases = hegel.Composite(func(tc hegel.TestCase) inPlaceCase {
+		root := hegel.Draw(tc, objectRoots)
+		key := hegel.Draw(tc, plainKeys)
+		withMember(root, hegel.Draw(tc, positions), key, strNode(hegel.Draw(tc, paddings)))
+		s := hegel.Draw(tc, shaped(escapedStrings, plainStrings))
+		return inPlaceCase{
+			doc: document{root: root, style: hegel.Draw(tc, styles)},
+			key: key,
+			val: value{v: s, expect: fromMarshal(s), needsEsc: mustEscape(s)},
+		}
+	})
+)
+
+// TestHegelInPlaceStringsKeepTheirEscapes: SetBytesOptions{Optimistic, ReplaceInPlace} of a
+// string that needs escaping over a longer string member writes it (escaped), as it does a
+// plain string.
+func TestHegelInPlaceStringsKeepTheirEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, inPlaceCases)
+		parts := []part{{key: c.key}}
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, 3, shapesOf("sjson/3", setShapes(c.doc.root, parts, c.val, 3)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/4
+
+// emptyPartCase: a path into the document ending in an empty component, so that the empty
+// key is asked of a created container, an existing object, an array or a scalar; past: a
+// non-empty key at the end.
+type emptyPartCase struct {
+	doc    document
+	prefix []partSpec
+	last   string
+	val    value
+	api    int
+}
+
+func (c emptyPartCase) parts() []part {
+	return append(plan(c.doc.root, c.prefix), part{key: c.last})
+}
+
+func (c emptyPartCase) GoString() string {
+	return setString(c.api, c.doc, c.parts(), c.val)
+}
+
+var emptyPartCases = hegel.Composite(func(tc hegel.TestCase) emptyPartCase {
+	val := hegel.Draw(tc, finiteValues)
+	return emptyPartCase{
+		doc:    hegel.Draw(tc, documents),
+		prefix: hegel.Draw(tc, prefixes),
+		last:   hegel.Draw(tc, shaped(hegel.Just(""), partKeys)),
+		val:    val,
+		api:    hegel.Draw(tc, narrowApis(val)),
+	}
+})
+
+// TestHegelEmptyComponentIsAKey: an empty path component is the key "" wherever it is
+// applied: a created container is an object with that key, an existing object gets or
+// replaces the member, an array refuses it as non-numeric, a scalar is replaced by the
+// object.
+func TestHegelEmptyComponentIsAKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyPartCases)
+		parts := c.parts()
+		last := contexts(c.doc.root, parts)[len(parts)-1]
+		switch {
+		case last.missing:
+			count("created container")
+		case last.cur == nil:
+			count("empty document")
+		case last.cur.kind == 'o':
+			count("existing object")
+		case last.cur.kind == 'a':
+			count("array")
+		default:
+			count("scalar")
+		}
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, c.api, shapesOf("sjson/4", setShapes(c.doc.root, parts, c.val, c.api)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/5
+
+// forcedKeyCase: a non-empty array and a forced key that spells one of its indices; past: an
+// object and a forced key.
+type forcedKeyCase struct {
+	doc document
+	key string
+	val value
+	api int
+}
+
+func (c forcedKeyCase) GoString() string {
+	return setString(c.api, c.doc, []part{{key: c.key, force: true}}, c.val)
+}
+
+var forcedKeyCases = hegel.Composite(func(tc hegel.TestCase) forcedKeyCase {
+	doc := hegel.Draw(tc, shaped(docsOf(nonEmptyArrays), docsOf(objectRoots)))
+	key := hegel.Draw(tc, treeKeys)
+	if doc.root.kind == 'a' {
+		key = strconv.Itoa(hegel.Draw(tc, positions) % len(doc.root.elems))
+	}
+	val := hegel.Draw(tc, finiteValues)
+	return forcedKeyCase{doc: doc, key: key, val: val, api: hegel.Draw(tc, narrowApis(val))}
+})
+
+// TestHegelForcedKeyOnAnArrayIsAnError: a colon-forced key is a key, so on an array it is the
+// non-numeric key error whether or not an element of that index exists; on an object it
+// sets the member.
+func TestHegelForcedKeyOnAnArrayIsAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, forcedKeyCases)
+		parts := []part{{key: c.key, force: true}}
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, c.api, shapesOf("sjson/5", setShapes(c.doc.root, parts, c.val, c.api)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/6
+
+// appendUnderCase: -1 applied to a scalar: the document itself (a scalar or blank), or a
+// scalar put into a container document at the member or element the prefix names; past: -1
+// applied to an array in the same places.
+type appendUnderCase struct {
+	doc    document
+	prefix []part
+	val    value
+	api    int
+}
+
+func (c appendUnderCase) parts() []part {
+	return append(append([]part{}, c.prefix...), part{key: "-1"})
+}
+
+func (c appendUnderCase) GoString() string {
+	return setString(c.api, c.doc, c.parts(), c.val)
+}
+
+var (
+	smallArrays = hegel.Map(many(nodes, 0, 4), arrNode)
+	// bareDocs: a document that is a scalar or blank; appendUnderCases: that, or a container
+	// document with the target put under a key or at an index.
+	bareDocs         = weighted(choice[document]{1, blankDocs}, choice[document]{2, docsOf(scalars)})
+	appendUnderCases = hegel.Composite(func(tc hegel.TestCase) appendUnderCase {
+		val := hegel.Draw(tc, finiteValues)
+		c := appendUnderCase{val: val, api: hegel.Draw(tc, narrowApis(val))}
+		if hegel.Draw(tc, chance(60)) {
+			c.doc = hegel.Draw(tc, shaped(bareDocs, docsOf(arrayRoots)))
+			return c
+		}
+		root := hegel.Draw(tc, roots)
+		target := hegel.Draw(tc, shaped(scalars, smallArrays))
+		at := hegel.Draw(tc, positions)
+		var key string
+		if root.kind == 'o' {
+			key = hegel.Draw(tc, partKeys)
+			withMember(root, at, key, target)
+		} else {
+			pos := at % (len(root.elems) + 1)
+			root.elems = append(root.elems[:pos], append([]*node{target}, root.elems[pos:]...)...)
+			key = strconv.Itoa(pos)
+		}
+		c.doc = document{root: root, style: hegel.Draw(tc, styles)}
+		c.prefix = []part{{key: key}}
+		return c
+	})
+)
+
+// TestHegelMinusOneUnderAScalarMakesAnArray: -1 under a scalar or the empty document replaces
+// it with a one-element array, as -1 under a new path does; under an array it appends.
+func TestHegelMinusOneUnderAScalarMakesAnArray(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, appendUnderCases)
+		parts := c.parts()
+		if last := contexts(c.doc.root, parts)[len(parts)-1]; last.cur == nil {
+			count("empty document")
+		} else {
+			count(string(last.cur.kind))
+		}
+		judgeSet(ht, c.doc.root, c.doc.text(), parts, c.val, c.api, shapesOf("sjson/6", setShapes(c.doc.root, parts, c.val, c.api)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/7
+
+// bracketKeyCase: an object with a member whose key starts with [ or {, or with ! and the
+// start of a JSON literal, and that key unescaped as the path; past: an ordinary key.
+type bracketKeyCase struct {
+	doc document
+	key string
+	val value
+	api int
+	del int
+}
+
+func (c bracketKeyCase) GoString() string {
+	return setString(c.api, c.doc, []part{{key: c.key}}, c.val)
+}
+
+var (
+	swallowedStarts = hegel.SampledFrom([]string{"[", "{", "!1", "!9", "!true", "!false", "!null", "![", "!{", "!-", "!+", `!"`})
+	swallowedKeys   = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, swallowedStarts) + hegel.Draw(tc, word(keyAlphabet, 0, 3))
+	})
+	bracketKeyCases = hegel.Composite(func(tc hegel.TestCase) bracketKeyCase {
+		root := hegel.Draw(tc, objectRoots)
+		key := hegel.Draw(tc, shaped(swallowedKeys, plainKeys))
+		withMember(root, hegel.Draw(tc, positions), key, hegel.Draw(tc, nodes))
+		val := hegel.Draw(tc, finiteValues)
+		return bracketKeyCase{
+			doc: document{root: root, style: hegel.Draw(tc, styles)},
+			key: key,
+			val: val,
+			api: hegel.Draw(tc, narrowApis(val)),
+			del: hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})
+)
+
+// TestHegelBracketKeysAreFound: a key starting with a bracket or a bang is found by its
+// unescaped spelling, as sjson accepts it: Set replaces the member, Delete removes it.
+func TestHegelBracketKeysAreFound(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bracketKeyCases)
+		parts := []part{{key: c.key}}
+		root, doc := c.doc.root, c.doc.text()
+		judgeSet(ht, root, doc, parts, c.val, c.api, shapesOf("sjson/7", setShapes(root, parts, c.val, c.api)))
+		judgeDelete(ht, root, doc, parts, c.del, shapesOf("sjson/7", deleteShapes(root, parts)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/8
+
+// nestedHashCase: an array of objects whose member k is an array of objects with a member x,
+// and the path #.k.#.x; past: #.k.i.x with an index for the second #.
+type nestedHashCase struct {
+	doc  document
+	k, x string
+	idx  int
+	val  value
+}
+
+func (c nestedHashCase) prog() []cpart {
+	second := cpart{hash: true}
+	if noKnown {
+		second = cpart{text: strconv.Itoa(c.idx)}
+	}
+	return []cpart{{hash: true}, {text: c.k}, second, {text: c.x}}
+}
+
+func (c nestedHashCase) GoString() string {
+	return fmt.Sprintf("Set(%s, %q, %s)", show(c.doc.text()), renderComplex(c.prog()), describe(c.val))
+}
+
+var nestedHashCases = hegel.Composite(func(tc hegel.TestCase) nestedHashCase {
+	k, x := hegel.Draw(tc, partKeys), hegel.Draw(tc, partKeys)
+	extras := func(o *node) {
+		for n := hegel.Draw(tc, hegel.Integers(0, 2)); n > 0; n-- {
+			key := hegel.Draw(tc, treeKeys)
+			if key != k && key != x {
+				o.set(key, hegel.Draw(tc, nodes))
+			}
+		}
+	}
+	root := arrNode(nil)
+	for n := hegel.Draw(tc, hegel.Integers(1, 3)); n > 0; n-- {
+		inner := arrNode(nil)
+		for m := hegel.Draw(tc, hegel.Integers(0, 3)); m > 0; m-- {
+			o := objNode()
+			if hegel.Draw(tc, chance(70)) {
+				o.put(x, hegel.Draw(tc, nodes))
+			}
+			extras(o)
+			inner.elems = append(inner.elems, o)
+		}
+		o := objNode()
+		o.put(k, inner)
+		extras(o)
+		root.elems = append(root.elems, o)
+	}
+	return nestedHashCase{
+		doc: document{root: root, style: hegel.Draw(tc, styles)},
+		k:   k,
+		x:   x,
+		idx: hegel.Draw(tc, hegel.Integers(0, 3)),
+		val: hegel.Draw(tc, finiteValues),
+	}
+})
+
+// TestHegelTwoHashSegmentsSetEveryMatch: #.k.#.x sets x in every element of every k, as
+// #.k.i.x does in the i-th, and leaves a document with no match as it was.
+func TestHegelTwoHashSegmentsSetEveryMatch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nestedHashCases)
+		prog := c.prog()
+		judgeComplex(ht, c.doc.root, c.doc.text(), prog, c.val, shapesOf("sjson/8", complexShapes(prog)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/9
+
+// escapedIndexCase: a non-empty array and an index of it with one digit escaped; past: the
+// plain digits.
+type escapedIndexCase struct {
+	doc document
+	at  int
+	pos int
+	val value
+	api int
+	del int
+}
+
+func (c escapedIndexCase) part() part {
+	text := strconv.Itoa(c.at % len(c.doc.root.elems))
+	p := part{key: text}
+	if !noKnown {
+		p.esc = make([]int, len(text))
+		p.esc[c.pos%len(text)] = 99
+	}
+	return p
+}
+
+func (c escapedIndexCase) GoString() string {
+	return setString(c.api, c.doc, []part{c.part()}, c.val)
+}
+
+var escapedIndexCases = hegel.Composite(func(tc hegel.TestCase) escapedIndexCase {
+	val := hegel.Draw(tc, finiteValues)
+	return escapedIndexCase{
+		doc: hegel.Draw(tc, docsOf(nonEmptyArrays)),
+		at:  hegel.Draw(tc, positions),
+		pos: hegel.Draw(tc, positions),
+		val: val,
+		api: hegel.Draw(tc, narrowApis(val)),
+		del: hegel.Draw(tc, hegel.Integers(0, 3)),
+	}
+})
+
+// TestHegelEscapedDigitsIndexTheArray: an index with an escaped digit is the same index
+// (sjson strips the backslash): Set replaces the element and Delete removes it, as with the
+// plain digits.
+func TestHegelEscapedDigitsIndexTheArray(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, escapedIndexCases)
+		parts := []part{c.part()}
+		root, doc := c.doc.root, c.doc.text()
+		judgeSet(ht, root, doc, parts, c.val, c.api, shapesOf("sjson/9", setShapes(root, parts, c.val, c.api)))
+		judgeDelete(ht, root, doc, parts, c.del, shapesOf("sjson/9", deleteShapes(root, parts)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/10
+
+// quoteKeyCase: an object with a member whose key starts with a quote, at any position, and
+// Delete of it; past: a key starting with any other character.
+type quoteKeyCase struct {
+	doc document
+	key string
+	api int
+}
+
+func (c quoteKeyCase) GoString() string {
+	return deleteString(c.api, c.doc, []part{{key: c.key}})
+}
+
+var (
+	quoteKeys   = hegel.Map(word(keyAlphabet, 0, 3), func(s string) string { return `"` + s })
+	noQuoteKeys = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, word(strings.ReplaceAll(keyAlphabet, `"`, ""), 1, 1)) + hegel.Draw(tc, word(keyAlphabet, 0, 3))
+	})
+	quoteKeyCases = hegel.Composite(func(tc hegel.TestCase) quoteKeyCase {
+		root := hegel.Draw(tc, objectRoots)
+		key := hegel.Draw(tc, shaped(quoteKeys, noQuoteKeys))
+		withMember(root, hegel.Draw(tc, positions), key, hegel.Draw(tc, nodes))
+		return quoteKeyCase{
+			doc: document{root: root, style: hegel.Draw(tc, styles)},
+			key: key,
+			api: hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})
+)
+
+// TestHegelQuoteKeyDeleteKeepsTheRest: Delete of a key starting with a quote removes that
+// member and keeps every other, wherever it is, as Delete of any other key does.
+func TestHegelQuoteKeyDeleteKeepsTheRest(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, quoteKeyCases)
+		parts := []part{{key: c.key}}
+		judgeDelete(ht, c.doc.root, c.doc.text(), parts, c.api, shapesOf("sjson/10", deleteShapes(c.doc.root, parts)))
+	})
+}
+
+// --------------------------------------------------------------------------- sjson/11
+
+// hashMemberCase: an object with a member named # whose value reads as a positive integer,
+// perhaps a member -1 and perhaps a member named for that integer less one, and Delete of
+// -1; past: Delete of -1 on an array.
+type hashMemberCase struct {
+	doc document
+	api int
+}
+
+func (c hashMemberCase) GoString() string {
+	return deleteString(c.api, c.doc, []part{{key: "-1"}})
+}
+
+var (
+	// hashValues: what gjson's "#" on an object reads as a positive count.
+	hashValues = hegel.OneOf(
+		hegel.Map(hegel.Integers(1, 5), func(n int) *node { return numNode(strconv.Itoa(n)) }),
+		hegel.Map(hegel.Just("true"), litNode),
+		hegel.Map(hegel.Integers(1, 5), func(n int) *node { return strNode(strconv.Itoa(n)) }),
+		hegel.Map(hegel.Integers(1, 5), func(n int) *node { return numNode(strconv.Itoa(n) + ".7") }),
+	)
+	hashMemberDocs = hegel.Composite(func(tc hegel.TestCase) document {
+		root := hegel.Draw(tc, objectRoots)
+		hash := hegel.Draw(tc, hashValues)
+		withMember(root, hegel.Draw(tc, positions), "#", hash)
+		if hegel.Draw(tc, chance(60)) {
+			withMember(root, hegel.Draw(tc, positions), "-1", hegel.Draw(tc, nodes))
+		}
+		if hegel.Draw(tc, chance(60)) {
+			withMember(root, hegel.Draw(tc, positions), strconv.FormatInt(hashCount(root)-1, 10), hegel.Draw(tc, nodes))
+		}
+		return document{root: root, style: hegel.Draw(tc, styles)}
+	})
+	hashMemberCases = hegel.Composite(func(tc hegel.TestCase) hashMemberCase {
+		return hashMemberCase{doc: hegel.Draw(tc, shaped(hashMemberDocs, docsOf(arrayRoots))), api: hegel.Draw(tc, hegel.Integers(0, 3))}
+	})
+)
+
+// TestHegelMinusOneDeleteOnAnObjectIsTheKey: Delete of -1 on an object removes the member
+// named -1 (or nothing), whatever a member named # holds; on an array it removes the last
+// element.
+func TestHegelMinusOneDeleteOnAnObjectIsTheKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hashMemberCases)
+		parts := []part{{key: "-1"}}
+		judgeDelete(ht, c.doc.root, c.doc.text(), parts, c.api, shapesOf("sjson/11", deleteShapes(c.doc.root, parts)))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..fa6e8fe
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2362 @@
+package sjson_test
+
+// Hegel property tests for sjson (github.com/tidwall/sjson), written for the Hegel zoo.
+// See targets/go/sjson/README.md.
+//
+// Oracle: an ordered JSON tree with a model of sjson's path semantics (keys, indices, `-1`
+// appends, `:`-forced keys, escapes, containers created on the way, scalars replaced by
+// containers), encoding/json for validity and for the values sjson marshals, and gjson (sjson's
+// own locator) only to find the byte range of an existing value. Every generated operation is
+// built from the tree together with the result it must produce.
+//
+// Generators: every generator is a package-level value built from hegel's combinators. A
+// document is a tree drawn from a recursive Composite (scalars first, then arrays and objects
+// of the recursion, keys from an alphabet of path metacharacters) and a style record of two
+// tapes (whitespace, escape choices) rendered by a pure writer. A path is a list of part
+// records whose kind - an existing member, a drawn key, an index past the end, -1, an empty
+// component, a huge index - is resolved against the live tree by a pure planner, positions
+// taken modulo the live size so that a shrunk path stays coherent. A value is one of the Go
+// kinds sjson accepts, nil and small integers first. Each property draws one case record.
+//
+// Known shapes: the recorded bugs (bugs.toml) are drawn by default and the properties fail on
+// them naming the bug (the pins beside them are the regression examples); HEGEL_NO_KNOWN=1
+// (noKnown, read once) switches the shapes off: the generators and the planner then keep to
+// the neighbouring regions and what is left of a shape is skipped and counted.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/tidwall/gjson"
+	. "github.com/tidwall/sjson"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collected ends a case whose mismatch was recorded in collect mode.
+type collected struct{}
+
+// counts tallies the classes of the cases of the running property; in collect mode the
+// mismatches are recorded instead of failing and printed when the property ends.
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+	msgs     []string
+	bad      int
+)
+
+func property(t *testing.T, fn func(ht *hegel.T), opts ...hegel.Option) {
+	t.Helper()
+	countsMu.Lock()
+	counts, msgs, bad = map[string]int{}, nil, 0
+	countsMu.Unlock()
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", t.Name(), bad, strings.Join(parts, " "))
+		for _, m := range msgs {
+			fmt.Printf("MISMATCH %s: %s\n", t.Name(), m)
+		}
+	})
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hegelOpts(), opts...)...)
+}
+
+func count(class string) {
+	countsMu.Lock()
+	counts[class]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message and ends the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		countsMu.Lock()
+		bad++
+		if len(msgs) < 25 {
+			msgs = append(msgs, msg)
+		}
+		countsMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case whose known shapes are named
+// (none for a plain failure): the shapes are counted and the failure names them; under
+// HEGEL_NO_KNOWN=1 such a case is assumed away instead.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		for _, s := range shapes {
+			count("shape " + s)
+		}
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// skipKnown skips, under HEGEL_NO_KNOWN=1, a case with a known shape before the library is
+// called, as the old gates did; the rate of each shape so skipped is counted.
+func skipKnown(ht *hegel.T, shapes []string) {
+	if !noKnown || len(shapes) == 0 {
+		return
+	}
+	for _, s := range shapes {
+		count("skipped " + s)
+	}
+	ht.Assume(false)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch is off: the generators draw the shape of every recorded bug and the property
+// that meets one fails naming it. Under HEGEL_NO_KNOWN=1 every switch is on: the generators,
+// the planner and the renderer keep to the neighbouring regions, and what is left of a shape
+// is skipped and counted (skipKnown).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: one switch per recorded bug; on means "keep the shape out".
+var Known = struct {
+	hugeIndexWraps       bool // sjson/1: an index at or above 2^63 wraps in atoui, so the value lands at a small index (or the padding runs the process out of memory: that form stays behind capDigits)
+	nonFiniteWritten     bool // sjson/2: NaN and the infinities are written as NaN/+Inf/-Inf, invalid JSON
+	inPlaceDropsEscapes  bool // sjson/3: ReplaceInPlace silently leaves the document unchanged for a string that needs escaping
+	emptyPartIsIndexZero bool // sjson/4: an empty path component is index 0 when a container is created, the key "" in an existing object, an append on an array
+	forcedKeyHitsIndex   bool // sjson/5: :N on an array replaces element N when it exists (and errors when it does not)
+	minusOneOnScalar     bool // sjson/6: -1 makes an object with the key "-1" when the parent is a scalar or the document is empty
+	bracketKeyNotFound   bool // sjson/7: an unescaped key starting with [ or {, or with ! and a JSON literal, is never found, so a duplicate key is appended
+	nestedHashCorrupts   bool // sjson/8: a path with two # segments writes the value at offset 0 and corrupts the document
+	escapedIndexAppends  bool // sjson/9: an index with an escaped digit (\0) is numeric for sjson but not for gjson, so Set appends and Delete does nothing
+	quoteKeyDeleteCuts   bool // sjson/10: Delete of a key starting with a quote cuts the members before it, or leaves the key with no value
+	minusOneReadsHashKey bool // sjson/11: Delete of -1 on an object with a member named # takes that member for the array length
+}{
+	hugeIndexWraps:       noKnown,
+	nonFiniteWritten:     noKnown,
+	inPlaceDropsEscapes:  noKnown,
+	emptyPartIsIndexZero: noKnown,
+	forcedKeyHitsIndex:   noKnown,
+	minusOneOnScalar:     noKnown,
+	bracketKeyNotFound:   noKnown,
+	nestedHashCorrupts:   noKnown,
+	escapedIndexAppends:  noKnown,
+	quoteKeyDeleteCuts:   noKnown,
+	minusOneReadsHashKey: noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapesOf names the recorded bug a narrow property (hegel_shapes_test.go) is about, with
+// any other known shape its case has; under HEGEL_NO_KNOWN=1 the property draws past its
+// bug, and only the other shapes are left (the judge then skips and counts the case).
+func shapesOf(id string, others []string) []string {
+	if noKnown {
+		return others
+	}
+	shapes := []string{id}
+	for _, s := range others {
+		if s != id {
+			shapes = append(shapes, s)
+		}
+	}
+	return shapes
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// word is lo to hi runes of the alphabet (a list of runes, not Text().Alphabet, since the
+// robustness alphabet holds a byte that is not UTF-8, which Text refuses; as the old helper
+// did, that byte stands for U+FFFD).
+func word(alphabet string, lo, hi int) hegel.Generator[string] {
+	return hegel.Map(many(hegel.SampledFrom([]rune(alphabet)), lo, hi), func(rs []rune) string { return string(rs) })
+}
+
+// tape is a list of up to n coins (0..99) read modulo its length by a pure renderer: an
+// empty tape means every decision falls the plain way.
+func tape(n int) hegel.Generator[[]int] {
+	return many(hegel.Integers(0, 99), 0, n)
+}
+
+// coinAt reads the i-th coin of a tape (0 when the tape is empty).
+func coinAt(t []int, i int) int {
+	if len(t) == 0 {
+		return 0
+	}
+	return t[i%len(t)]
+}
+
+// positions: an index into a container of unknown size, taken modulo the live size.
+var positions = hegel.Integers(0, 11)
+
+// --------------------------------------------------------------------------- the JSON tree
+
+// node is an ordered JSON value. Scalars keep their token text; numbers compare as exact
+// rationals so that 1e21 and 1000000000000000000000 are the same value.
+type node struct {
+	kind  byte // 'o' object, 'a' array, 's' string, 'n' number, 't' true, 'f' false, 'z' null
+	raw   string
+	str   string
+	keys  []string
+	vals  []*node
+	elems []*node
+}
+
+func strNode(s string) *node   { return &node{kind: 's', str: s} }
+func numNode(raw string) *node { return &node{kind: 'n', raw: raw} }
+func litNode(raw string) *node {
+	switch raw {
+	case "true":
+		return &node{kind: 't', raw: raw}
+	case "false":
+		return &node{kind: 'f', raw: raw}
+	}
+	return &node{kind: 'z', raw: "null"}
+}
+func arrNode(elems []*node) *node { return &node{kind: 'a', elems: elems} }
+func objNode() *node              { return &node{kind: 'o'} }
+
+func (o *node) put(key string, v *node) {
+	o.keys = append(o.keys, key)
+	o.vals = append(o.vals, v)
+}
+
+// set replaces the member or appends it.
+func (o *node) set(key string, v *node) {
+	if i := o.find(key); i >= 0 {
+		o.vals[i] = v
+		return
+	}
+	o.put(key, v)
+}
+
+func (o *node) find(key string) int {
+	for i, k := range o.keys {
+		if k == key {
+			return i
+		}
+	}
+	return -1
+}
+
+func (nd *node) isContainer() bool { return nd != nil && (nd.kind == 'o' || nd.kind == 'a') }
+
+func (nd *node) clone() *node {
+	if nd == nil {
+		return nil
+	}
+	c := &node{kind: nd.kind, raw: nd.raw, str: nd.str}
+	for i := range nd.keys {
+		c.put(nd.keys[i], nd.vals[i].clone())
+	}
+	for _, e := range nd.elems {
+		c.elems = append(c.elems, e.clone())
+	}
+	return c
+}
+
+// member is one object member as drawn; an object keeps the first of two equal keys.
+type member struct {
+	key string
+	val *node
+}
+
+func objOf(ms []member) *node {
+	o := objNode()
+	for _, m := range ms {
+		if o.find(m.key) < 0 {
+			o.put(m.key, m.val)
+		}
+	}
+	return o
+}
+
+// --------------------------------------------------------------------------- rendering
+
+// style is how a tree is written: the whitespace between tokens (a tape of gaps read in
+// order, empty for compact output) and the escape choices of its strings (a tape of coins,
+// one per rune, empty for the plain spelling of every character).
+type style struct {
+	ws  []string
+	esc []int
+}
+
+// writer renders a tree in a style; it is a pure function of the two.
+type writer struct {
+	b      strings.Builder
+	st     style
+	wi, ei int
+}
+
+func render(nd *node, st style) string {
+	w := &writer{st: st}
+	w.value(nd)
+	return w.b.String()
+}
+
+// compactOf is the plain rendering (no whitespace, the simplest escapes).
+func compactOf(nd *node) string { return render(nd, style{}) }
+
+func (w *writer) gap() string {
+	if len(w.st.ws) == 0 {
+		return ""
+	}
+	s := w.st.ws[w.wi%len(w.st.ws)]
+	w.wi++
+	return s
+}
+
+func (w *writer) coin() int {
+	x := coinAt(w.st.esc, w.ei)
+	w.ei++
+	return x
+}
+
+func (w *writer) value(nd *node) {
+	switch nd.kind {
+	case 'o':
+		w.b.WriteByte('{')
+		for i := range nd.keys {
+			if i > 0 {
+				w.b.WriteByte(',')
+			}
+			w.b.WriteString(w.gap())
+			w.str(nd.keys[i])
+			w.b.WriteString(w.gap())
+			w.b.WriteByte(':')
+			w.b.WriteString(w.gap())
+			w.value(nd.vals[i])
+			w.b.WriteString(w.gap())
+		}
+		if len(nd.keys) == 0 {
+			w.b.WriteString(w.gap())
+		}
+		w.b.WriteByte('}')
+	case 'a':
+		w.b.WriteByte('[')
+		for i, e := range nd.elems {
+			if i > 0 {
+				w.b.WriteByte(',')
+			}
+			w.b.WriteString(w.gap())
+			w.value(e)
+			w.b.WriteString(w.gap())
+		}
+		if len(nd.elems) == 0 {
+			w.b.WriteString(w.gap())
+		}
+		w.b.WriteByte(']')
+	case 's':
+		w.str(nd.str)
+	default:
+		w.b.WriteString(nd.raw)
+	}
+}
+
+// str writes s as a JSON string token; one coin per rune decides between its spellings
+// (the plain one when the coin is low): \u for a quote or backslash, the long form of a
+// control character, an escaped slash, a surrogate pair for an astral rune, \u for any other
+// non-ASCII rune.
+func (w *writer) str(s string) {
+	b := &w.b
+	b.WriteByte('"')
+	for _, r := range s {
+		x := w.coin()
+		switch {
+		case r == '"' || r == '\\':
+			if x >= 70 {
+				fmt.Fprintf(b, `\u%04x`, r)
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(r)
+			}
+		case r < 0x20:
+			switch {
+			case r == '\n' && x < 70:
+				b.WriteString(`\n`)
+			case r == '\t' && x < 70:
+				b.WriteString(`\t`)
+			case r == '\r' && x < 70:
+				b.WriteString(`\r`)
+			case x >= 85:
+				fmt.Fprintf(b, `\u%04X`, r)
+			default:
+				fmt.Fprintf(b, `\u%04x`, r)
+			}
+		case r == '/' && x >= 70:
+			b.WriteString(`\/`)
+		case r > 0xFFFF && x >= 60:
+			hi, lo := (r-0x10000)>>10+0xD800, (r-0x10000)&0x3FF+0xDC00
+			fmt.Fprintf(b, `\u%04x\u%04x`, hi, lo)
+		case r > 0x7F && r <= 0xFFFF && x >= 70:
+			fmt.Fprintf(b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func ratOf(raw string) *big.Rat {
+	r, ok := new(big.Rat).SetString(raw)
+	if !ok {
+		return nil
+	}
+	return r
+}
+
+// same is structural equality with ordered keys and exact numbers.
+func same(a, b *node) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	if a.kind != b.kind {
+		return false
+	}
+	switch a.kind {
+	case 'o':
+		if len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i := range a.keys {
+			if a.keys[i] != b.keys[i] || !same(a.vals[i], b.vals[i]) {
+				return false
+			}
+		}
+		return true
+	case 'a':
+		if len(a.elems) != len(b.elems) {
+			return false
+		}
+		for i := range a.elems {
+			if !same(a.elems[i], b.elems[i]) {
+				return false
+			}
+		}
+		return true
+	case 's':
+		return a.str == b.str
+	case 'n':
+		ra, rb := ratOf(a.raw), ratOf(b.raw)
+		return ra != nil && rb != nil && ra.Cmp(rb) == 0
+	}
+	return true
+}
+
+// decode reads valid JSON into an ordered tree (nil, false for invalid input).
+func decode(s string) (*node, bool) {
+	dec := json.NewDecoder(strings.NewReader(s))
+	dec.UseNumber()
+	nd, err := decodeValue(dec)
+	if err != nil {
+		return nil, false
+	}
+	if _, err := dec.Token(); err == nil {
+		return nil, false // trailing tokens
+	}
+	return nd, true
+}
+
+func decodeValue(dec *json.Decoder) (*node, error) {
+	tok, err := dec.Token()
+	if err != nil {
+		return nil, err
+	}
+	switch v := tok.(type) {
+	case json.Delim:
+		switch v {
+		case '{':
+			o := objNode()
+			for dec.More() {
+				kt, err := dec.Token()
+				if err != nil {
+					return nil, err
+				}
+				k, ok := kt.(string)
+				if !ok {
+					return nil, fmt.Errorf("key %v", kt)
+				}
+				val, err := decodeValue(dec)
+				if err != nil {
+					return nil, err
+				}
+				o.put(k, val)
+			}
+			if _, err := dec.Token(); err != nil {
+				return nil, err
+			}
+			return o, nil
+		case '[':
+			a := arrNode(nil)
+			for dec.More() {
+				val, err := decodeValue(dec)
+				if err != nil {
+					return nil, err
+				}
+				a.elems = append(a.elems, val)
+			}
+			if _, err := dec.Token(); err != nil {
+				return nil, err
+			}
+			return a, nil
+		}
+		return nil, fmt.Errorf("delim %v", v)
+	case string:
+		return strNode(v), nil
+	case json.Number:
+		return numNode(string(v)), nil
+	case bool:
+		if v {
+			return litNode("true"), nil
+		}
+		return litNode("false"), nil
+	case nil:
+		return litNode("null"), nil
+	}
+	return nil, fmt.Errorf("token %v", tok)
+}
+
+// --------------------------------------------------------------------------- generators: trees
+
+// Keys draw from an alphabet full of path metacharacters: sjson's dot and colon, gjson's
+// wildcards, pipes, hashes, modifiers, multipath brackets, literals, quotes and backslashes.
+const keyAlphabet = "abkxz019 _-:.*?\\|#@!\"[](){},~%<>=+'/\t\néß😀"
+
+const textAlphabet = "abc xyz019 \t\n\r\"\\/.*?|#@!<>&é中😀\x00\x01 "
+
+var (
+	// treeKeys: a word of the alphabet, or one of the keys that are also path syntax (the
+	// empty key, -1, digits, gjson's #).
+	treeKeys = weighted(
+		choice[string]{17, word(keyAlphabet, 1, 5)},
+		choice[string]{3, hegel.SampledFrom([]string{"", "-1", "0", "1", "2", "7", "12", "#"})},
+	)
+	texts = word(textAlphabet, 0, 8)
+
+	// numberTexts: small integers most of the time, then every textual form a number has.
+	numberTexts = weighted(
+		choice[string]{3, hegel.Map(hegel.Integers(0, 20), strconv.Itoa)},
+		choice[string]{1, hegel.Map(hegel.Integers(-1000, 1000), strconv.Itoa)},
+		choice[string]{1, hegel.SampledFrom([]string{"0", "-0", "1e2", "1E-2", "-1.5e+3", "0.1", "123456789012345678901234567890", "1e400", "9007199254740993"})},
+		choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d.%d", hegel.Draw(tc, hegel.Integers(-99, 99)), hegel.Draw(tc, hegel.Integers(0, 999)))
+		})},
+		choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%de%d", hegel.Draw(tc, hegel.Integers(-9, 9)), hegel.Draw(tc, hegel.Integers(-30, 30)))
+		})},
+	)
+
+	// scalars: null first, then the literals, numbers and strings.
+	scalars = hegel.OneOf(
+		hegel.Map(hegel.Just("null"), litNode),
+		hegel.Map(hegel.SampledFrom([]string{"true", "false", "null"}), litNode),
+		hegel.Map(numberTexts, numNode),
+		hegel.Map(texts, strNode),
+	)
+)
+
+// nodes is a JSON value: a scalar, or an array or object of up to four values, containers
+// rarer with depth (a third of the root's children, a tenth of theirs, none below); roots is
+// an object or array of up to five members or elements (objectRoots and arrayRoots are the
+// two apart). The recursion is a forward-declared Composite with a depth counter restored on
+// the way out, and the four are built by one initialiser since package-level generators
+// cannot refer to each other in a cycle.
+var nodes, roots, objectRoots, arrayRoots = func() (nodes, roots, objects, arrays hegel.Generator[*node]) {
+	var values, shallow, deep hegel.Generator[*node]
+	depth := 1
+	values = hegel.Composite(func(tc hegel.TestCase) *node {
+		g := scalars
+		switch depth {
+		case 1:
+			g = shallow
+		case 2:
+			g = deep
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, g)
+	})
+	members := hegel.Composite(func(tc hegel.TestCase) member {
+		return member{key: hegel.Draw(tc, treeKeys), val: hegel.Draw(tc, values)}
+	})
+	arraysOf := func(max int) hegel.Generator[*node] {
+		return hegel.Map(many(values, 0, max), arrNode)
+	}
+	objectsOf := func(max int) hegel.Generator[*node] {
+		return hegel.Map(many(members, 0, max), objOf)
+	}
+	shallow = weighted(choice[*node]{65, scalars}, choice[*node]{17, arraysOf(4)}, choice[*node]{18, objectsOf(4)})
+	deep = weighted(choice[*node]{90, scalars}, choice[*node]{5, arraysOf(4)}, choice[*node]{5, objectsOf(4)})
+	objects, arrays = objectsOf(5), arraysOf(5)
+	return values, hegel.OneOf(objects, arrays), objects, arrays
+}()
+
+// --------------------------------------------------------------------------- generators: documents
+
+// document is the input of an operation: a tree with the style it is written in, or (root
+// nil) a blank text.
+type document struct {
+	root  *node
+	blank string
+	style style
+}
+
+func (d document) text() string {
+	if d.root == nil {
+		return d.blank
+	}
+	return render(d.root, d.style)
+}
+
+var (
+	gaps   = hegel.SampledFrom([]string{"", " ", "\n", "\t", "  ", "\r\n"})
+	styles = hegel.Composite(func(tc hegel.TestCase) style {
+		return style{ws: hegel.Draw(tc, many(gaps, 0, 12)), esc: hegel.Draw(tc, tape(16))}
+	})
+	blankDocs = hegel.Map(hegel.SampledFrom([]string{"", " ", "\n\t"}), func(s string) document { return document{blank: s} })
+
+	// containerDocs: a rendered object or array; documents: that, or rarely a scalar or a
+	// blank document.
+	containerDocs = docsOf(roots)
+	documents     = weighted(
+		choice[document]{18, containerDocs},
+		choice[document]{1, docsOf(scalars)},
+		choice[document]{1, blankDocs},
+	)
+)
+
+// docsOf is a tree from g written in a drawn style.
+func docsOf(g hegel.Generator[*node]) hegel.Generator[document] {
+	return hegel.Composite(func(tc hegel.TestCase) document {
+		return document{root: hegel.Draw(tc, g), style: hegel.Draw(tc, styles)}
+	})
+}
+
+// --------------------------------------------------------------------------- generators: values
+
+// value is what Set is given, with the tree it must produce and its class for the shapes.
+type value struct {
+	v         any
+	expect    *node
+	raw       string // for SetRaw: the raw JSON text
+	isRaw     bool
+	needsEsc  bool // a string sjson must run through json.Marshal
+	nonFinite bool
+}
+
+func mustEscape(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < ' ' || s[i] > 0x7f || s[i] == '"' || s[i] == '\\' {
+			return true
+		}
+	}
+	return false
+}
+
+func fromMarshal(v any) *node {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	nd, ok := decode(string(b))
+	if !ok {
+		panic("marshal produced invalid JSON")
+	}
+	return nd
+}
+
+// marshalled is a value whose tree is what encoding/json writes for it.
+func marshalled[T any](g hegel.Generator[T]) hegel.Generator[value] {
+	return hegel.Map(g, func(x T) value { return value{v: x, expect: fromMarshal(x)} })
+}
+
+func describe(val value) string {
+	if val.isRaw {
+		return "raw " + show(val.raw)
+	}
+	return fmt.Sprintf("%T(%v)", val.v, val.v)
+}
+
+var (
+	nils      = hegel.Map(hegel.Just("null"), func(raw string) value { return value{v: nil, expect: litNode(raw)} })
+	ints      = marshalled(hegel.Integers(-1000000, 1000000))
+	bools     = marshalled(hegel.Booleans())
+	int64s    = marshalled(hegel.SampledFrom([]int64{0, math.MaxInt64, math.MinInt64}))
+	typedInts = hegel.OneOf(
+		marshalled(hegel.Map(hegel.Integers(-128, 127), func(x int) int8 { return int8(x) })),
+		marshalled(hegel.Map(hegel.Integers(0, 255), func(x int) uint8 { return uint8(x) })),
+		marshalled(hegel.Just(uint64(math.MaxUint64))),
+		marshalled(hegel.Map(hegel.Integers(0, 1000), func(x int) uint { return uint(x) })),
+	)
+	float64s = hegel.Map(hegel.SampledFrom([]float64{0, math.Copysign(0, -1), 0.1, 1.5, -2.25, 1e21, 1e-7, 123456.789, math.MaxFloat64, math.SmallestNonzeroFloat64, 9007199254740993}),
+		func(f float64) value { return value{v: f, expect: numNode(strconv.FormatFloat(f, 'g', -1, 64))} })
+	nonFinites = hegel.Map(hegel.SampledFrom([]float64{math.NaN(), math.Inf(1), math.Inf(-1)}),
+		func(f float64) value { return value{v: f, nonFinite: true} })
+	float32s = hegel.Map(hegel.SampledFrom([]float64{0.1, 3.25, -1e10, 1e-3}),
+		func(x float64) value {
+			f := float32(x)
+			return value{v: f, expect: numNode(strconv.FormatFloat(float64(f), 'g', -1, 64))}
+		})
+	// strs: a text, one time in ten with a byte that is not UTF-8 after it; plainStrs: a text
+	// of the characters sjson writes without json.Marshal.
+	strs = hegel.Composite(func(tc hegel.TestCase) value {
+		s := hegel.Draw(tc, texts)
+		if hegel.Draw(tc, chance(10)) {
+			s += "\xff"
+		}
+		return value{v: s, expect: fromMarshal(s), needsEsc: mustEscape(s)}
+	})
+	plainTexts  = word("abc xyz019 /.*?|#@!<>& ", 0, 8)
+	plainStrs   = hegel.Map(plainTexts, func(s string) value { return value{v: s, expect: fromMarshal(s)} })
+	byteStrs    = hegel.Map(texts, func(s string) value { return value{v: []byte(s), expect: fromMarshal(s), needsEsc: mustEscape(s)} })
+	plainBytes  = hegel.Map(plainTexts, func(s string) value { return value{v: []byte(s), expect: fromMarshal(s)} })
+	stringLists = marshalled(hegel.Map(many(texts, 0, 3), func(xs []string) []string {
+		if xs == nil {
+			return []string{}
+		}
+		return xs
+	}))
+	intMaps = marshalled(hegel.Map(hegel.Maps(texts, hegel.Integers(0, 9)).MaxSize(3), func(m map[string]int) map[string]any {
+		out := map[string]any{}
+		for k, v := range m {
+			out[k] = v
+		}
+		return out
+	}))
+	raws = hegel.Composite(func(tc hegel.TestCase) value {
+		nd := hegel.Draw(tc, nodes)
+		return value{expect: nd, raw: render(nd, hegel.Draw(tc, styles)), isRaw: true}
+	})
+)
+
+// valuesOf is one of the Go kinds sjson accepts, nil and small integers first; nonFinite
+// adds NaN and the infinities (sjson/2's shape), escapes draws strings and byte strings
+// that need escaping (sjson/3's shape in place) rather than plain ones.
+func valuesOf(nonFinite, escapes bool) hegel.Generator[value] {
+	gens := []hegel.Generator[value]{nils, ints, bools, int64s, typedInts, float64s}
+	if nonFinite {
+		gens = append(gens, nonFinites)
+	}
+	gens = append(gens, float32s)
+	if escapes {
+		gens = append(gens, strs, strs, byteStrs)
+	} else {
+		gens = append(gens, plainStrs, plainStrs, plainBytes)
+	}
+	return hegel.OneOf(append(gens, stringLists, intMaps, raws)...)
+}
+
+var (
+	values       = valuesOf(!Known.nonFiniteWritten, true)
+	finiteValues = valuesOf(false, true)
+	plainValues  = valuesOf(false, false)
+)
+
+func show(s string) string {
+	if len(s) > 300 {
+		s = s[:300] + "..."
+	}
+	return strconv.Quote(s)
+}
+
+// --------------------------------------------------------------------------- paths
+
+// part is one component of an sjson path: key is the text sjson compares with (after
+// unescaping), force the leading colon, esc the coins of the optional escapes of its runes.
+type part struct {
+	key   string
+	force bool
+	esc   []int
+}
+
+func allDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return s != ""
+}
+
+func isIndex(p part) (int, bool) {
+	if p.force || !allDigits(p.key) {
+		return 0, false
+	}
+	v, err := strconv.ParseInt(p.key, 10, 64)
+	if err != nil {
+		return 0, false
+	}
+	return int(v), true
+}
+
+// isHuge reports a numeric component at or above 2^63: an index past the end of any array,
+// which would need more nulls than any document can hold.
+func isHuge(p part) bool {
+	if p.force || !allDigits(p.key) {
+		return false
+	}
+	_, err := strconv.ParseInt(p.key, 10, 64)
+	return err != nil
+}
+
+func isAppend(p part) bool { return !p.force && p.key == "-1" }
+
+// gjsonSwallows reports whether gjson reads an unescaped component starting like key as a
+// multipath ([ or {) or a literal (! followed by a number, a string, a container, true, false
+// or null) instead of a key.
+func gjsonSwallows(key string) bool {
+	if key == "" {
+		return false
+	}
+	if key[0] == '[' || key[0] == '{' {
+		return true
+	}
+	if key[0] != '!' || len(key) == 1 {
+		return false
+	}
+	c := key[1]
+	if c >= '0' && c <= '9' || strings.IndexByte(`+-"[{`, c) >= 0 {
+		return true
+	}
+	rest := key[1:]
+	for _, lit := range []string{"true", "false", "null"} {
+		if strings.HasPrefix(rest, lit) {
+			return true
+		}
+	}
+	return false
+}
+
+// escapePart writes a component for sjson (and gjson): the characters both treat as syntax
+// are always escaped, brackets and bangs when their coin says so, ordinary characters rarely
+// (escapedOrdinary reports the last). Under HEGEL_NO_KNOWN=1 a leading bracket or bang that
+// gjson would swallow is always escaped (sjson/7) and the digits of an index never are
+// (sjson/9).
+func escapePart(p part) (text string, escapedOrdinary bool) {
+	var b strings.Builder
+	if p.force {
+		b.WriteByte(':')
+	}
+	numeric := allDigits(p.key)
+	i := 0
+	for _, r := range p.key {
+		x := coinAt(p.esc, i)
+		switch {
+		case strings.ContainsRune(`.\*?|#@`, r):
+			b.WriteByte('\\')
+		case r == ':' && (i == 0 || x >= 70):
+			b.WriteByte('\\')
+		case strings.ContainsRune(`[]{}()!,`, r) && (x >= 50 || (i == 0 && Known.bracketKeyNotFound && gjsonSwallows(p.key))):
+			b.WriteByte('\\')
+		case x >= 96 && !(Known.escapedIndexAppends && numeric):
+			b.WriteByte('\\')
+			escapedOrdinary = true
+		}
+		b.WriteRune(r)
+		i++
+	}
+	return b.String(), escapedOrdinary
+}
+
+// partFlags records the shapes of a rendered component that the recorded bugs are about.
+type partFlags struct {
+	leadingBracket bool // unescaped, starting with [ or {, or ! and a literal (sjson/7)
+	escapedIndex   bool // numeric with an escaped digit (sjson/9)
+}
+
+// joinPath renders the parts as an sjson path and as the same path for gjson, which has no
+// forced keys.
+func joinPath(parts []part) (sjsonPath, gjsonPath string, flags []partFlags) {
+	var sp, gp []string
+	for _, p := range parts {
+		e, escaped := escapePart(p)
+		sp = append(sp, e)
+		if p.force {
+			e = e[1:]
+		}
+		gp = append(gp, e)
+		var f partFlags
+		if gjsonSwallows(p.key) && e[0] != '\\' {
+			f.leadingBracket = true
+		}
+		if _, ok := isIndex(p); ok && escaped {
+			f.escapedIndex = true
+		}
+		flags = append(flags, f)
+	}
+	return strings.Join(sp, "."), strings.Join(gp, "."), flags
+}
+
+// gjsonEscape writes a literal component for gjson (every metacharacter escaped).
+func gjsonEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if strings.ContainsRune(`.\*?|#@!:[]{}()`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// partSpec is one drawn component before it is resolved against the tree: its kind, and the
+// draws the kind uses (a position taken modulo the live size, a key text, the force flag, the
+// escape coins).
+type partSpec struct {
+	kind  string // existing, key, index, append, empty, huge
+	text  string
+	at    int
+	force bool
+	esc   []int
+}
+
+var (
+	partKeys    = word(keyAlphabet, 1, 5)
+	escapeTapes = tape(6)
+
+	two63 = new(big.Int).Lsh(big.NewInt(1), 63)
+	two64 = new(big.Int).Lsh(big.NewInt(1), 64)
+
+	// hugeIndexTexts: the wrapping form of sjson/1, an index text at or above 2^63 whose
+	// value wraps in sjson's atoui (and in gjson's parser at 2^64) to a small or a negative
+	// count: 2^64-w for w in 1..1000 (wraps to -w), 2^64+w for w in 0..3 (wraps to w) and
+	// 2^63+k for k in 100..1100 (wraps to MinInt64+k). The wrapped count minus the array's
+	// length never overflows and pads at most three nulls, where a text that wraps to a large
+	// count (99999999999999999999, or 2^63 on a non-empty array) asks for 10^18 of them and
+	// runs the process out of memory: that form stays behind capDigits.
+	hugeIndexTexts = hegel.OneOf(
+		hegel.Map(hegel.Integers(1, 1000), func(w int) string { return offsetText(two64, -w) }),
+		hegel.Map(hegel.Integers(0, 3), func(w int) string { return offsetText(two64, w) }),
+		hegel.Map(hegel.Integers(100, 1100), func(k int) string { return offsetText(two63, k) }),
+	)
+)
+
+func offsetText(base *big.Int, d int) string {
+	return new(big.Int).Add(base, big.NewInt(int64(d))).String()
+}
+
+// partKindsOf is the kind of a component: an existing member most often (existing percent
+// of the time), then a drawn key, an index past the end, an append, and (when drawn) an
+// empty component (sjson/4) and a huge index (sjson/1).
+func partKindsOf(existing int, empty, huge bool) hegel.Generator[string] {
+	cs := []choice[string]{
+		{existing, hegel.Just("existing")},
+		{20, hegel.Just("key")},
+		{12, hegel.Just("index")},
+		{10, hegel.Just("append")},
+	}
+	if empty {
+		cs = append(cs, choice[string]{5, hegel.Just("empty")})
+	}
+	if huge {
+		cs = append(cs, choice[string]{3, hegel.Just("huge")})
+	}
+	return weighted(cs...)
+}
+
+// partSpecsOf draws a component of one of the kinds with the draws that kind uses.
+func partSpecsOf(kinds hegel.Generator[string]) hegel.Generator[partSpec] {
+	return hegel.FlatMap(kinds, func(kind string) hegel.Generator[partSpec] {
+		return hegel.Composite(func(tc hegel.TestCase) partSpec {
+			s := partSpec{kind: kind}
+			switch kind {
+			case "existing", "index":
+				s.at = hegel.Draw(tc, positions)
+			case "key":
+				s.text = hegel.Draw(tc, partKeys)
+			case "huge":
+				s.text = hegel.Draw(tc, hugeIndexTexts)
+			}
+			s.force = hegel.Draw(tc, chance(10))
+			if kind != "append" && kind != "empty" {
+				s.esc = hegel.Draw(tc, escapeTapes)
+			}
+			return s
+		})
+	})
+}
+
+// pathLengths: short paths most often, since a long one is mostly new containers (and
+// Lists draws its longest sizes most).
+var pathLengths = weighted(
+	choice[int]{5, hegel.Just(1)},
+	choice[int]{4, hegel.Just(2)},
+	choice[int]{3, hegel.Just(3)},
+	choice[int]{2, hegel.Just(4)},
+	choice[int]{1, hegel.Just(5)},
+	choice[int]{1, hegel.Just(6)},
+)
+
+func pathsOf(kinds hegel.Generator[string]) hegel.Generator[[]partSpec] {
+	return hegel.FlatMap(pathLengths, func(n int) hegel.Generator[[]partSpec] { return many(partSpecsOf(kinds), n, n) })
+}
+
+var (
+	// setParts: the path of a Set; deleteParts: the same without the huge index (Delete of
+	// one is a no-op for sjson and the model alike) and mostly through existing members, so
+	// that there is something to delete.
+	setParts    = pathsOf(partKindsOf(50, !Known.emptyPartIsIndexZero, !Known.hugeIndexWraps))
+	deleteParts = pathsOf(partKindsOf(110, !Known.emptyPartIsIndexZero, false))
+)
+
+// advance is the node the part leads to: a member or element that exists, or nothing (the
+// path is then building new containers, or has left a scalar behind).
+func advance(cur *node, missing bool, p part) (*node, bool) {
+	if missing || cur == nil {
+		return nil, true
+	}
+	switch cur.kind {
+	case 'o':
+		if j := cur.find(p.key); j >= 0 {
+			return cur.vals[j], false
+		}
+	case 'a':
+		if i, ok := isIndex(p); ok && i < len(cur.elems) {
+			return cur.elems[i], false
+		}
+	}
+	return nil, true
+}
+
+// plan resolves the drawn components against the tree: an existing member is picked by its
+// position modulo the live size (a digit index where there is nothing to pick), an index past
+// the end is the live length plus a little, a key, -1, "" and a huge index are themselves.
+// Under HEGEL_NO_KNOWN=1 a forced key that would hit an array element loses its colon
+// (sjson/5) and a -1 under a scalar or the empty document becomes a small index (sjson/6).
+func plan(root *node, specs []partSpec) []part {
+	cur, missing := root, false
+	var parts []part
+	for _, s := range specs {
+		p := part{force: s.force, esc: s.esc}
+		switch s.kind {
+		case "existing":
+			switch {
+			case !missing && cur != nil && cur.kind == 'o' && len(cur.keys) > 0:
+				p.key = cur.keys[s.at%len(cur.keys)]
+			case !missing && cur != nil && cur.kind == 'a' && len(cur.elems) > 0:
+				p.key = strconv.Itoa(s.at % len(cur.elems))
+			default:
+				p.key = strconv.Itoa(s.at % 4)
+			}
+		case "index":
+			if !missing && cur != nil && cur.kind == 'a' {
+				p.key = strconv.Itoa(len(cur.elems) + s.at%4)
+			} else {
+				p.key = strconv.Itoa(s.at % 4)
+			}
+		case "append":
+			p.key = "-1"
+		case "empty":
+			p.key = ""
+		default: // key, huge
+			p.key = s.text
+		}
+		if Known.forcedKeyHitsIndex && p.force && !missing && cur != nil && cur.kind == 'a' {
+			if i, ok := isIndex(part{key: p.key}); ok && i < len(cur.elems) {
+				p.force = false
+			}
+		}
+		if Known.minusOneOnScalar && isAppend(p) && !missing && !cur.isContainer() {
+			p.key = strconv.Itoa(s.at % 4)
+		}
+		parts = append(parts, p)
+		cur, missing = advance(cur, missing, p)
+	}
+	return parts
+}
+
+// partCtx is where a part is applied: the node it is looked up in, or nothing when the path
+// is building new containers (missing) - the empty document is cur nil without missing.
+type partCtx struct {
+	cur     *node
+	missing bool
+}
+
+func contexts(root *node, parts []part) []partCtx {
+	cur, missing := root, false
+	out := make([]partCtx, len(parts))
+	for i, p := range parts {
+		out[i] = partCtx{cur, missing}
+		cur, missing = advance(cur, missing, p)
+	}
+	return out
+}
+
+// hashCount is the value gjson's "#" gives on the object: its member named "#" read as an
+// integer (true is 1), which sjson's Delete of -1 takes for an array length (sjson/11).
+func hashCount(o *node) int64 {
+	j := o.find("#")
+	if j < 0 {
+		return 0
+	}
+	return gjson.Parse(compactOf(o.vals[j])).Int()
+}
+
+// setShapes names the recorded bugs whose shape a Set has.
+func setShapes(root *node, parts []part, val value, api int) []string {
+	_, _, flags := joinPath(parts)
+	ctx := contexts(root, parts)
+	var shapes []string
+	add := func(id string, ok bool) {
+		if ok && !slices.Contains(shapes, id) {
+			shapes = append(shapes, id)
+		}
+	}
+	for i, p := range parts {
+		c := ctx[i]
+		obj := !c.missing && c.cur != nil && c.cur.kind == 'o'
+		arr := !c.missing && c.cur != nil && c.cur.kind == 'a'
+		bare := !c.missing && !obj && !arr // the empty document, or a scalar
+		idx, isIdx := isIndex(part{key: p.key})
+		add("sjson/1", isHuge(p) && !obj)
+		add("sjson/4", p.key == "" && !p.force && !obj)
+		add("sjson/5", p.force && arr && isIdx && idx < len(c.cur.elems))
+		add("sjson/6", isAppend(p) && bare)
+		add("sjson/7", flags[i].leadingBracket && obj && c.cur.find(p.key) >= 0)
+		add("sjson/9", flags[i].escapedIndex && arr)
+	}
+	add("sjson/2", val.nonFinite)
+	add("sjson/3", api == 3 && val.needsEsc)
+	return shapes
+}
+
+// deleteShapes names the recorded bugs whose shape a Delete has.
+func deleteShapes(root *node, parts []part) []string {
+	_, _, flags := joinPath(parts)
+	ctx := contexts(root, parts)
+	var shapes []string
+	add := func(id string, ok bool) {
+		if ok && !slices.Contains(shapes, id) {
+			shapes = append(shapes, id)
+		}
+	}
+	for i, p := range parts {
+		c := ctx[i]
+		obj := !c.missing && c.cur != nil && c.cur.kind == 'o'
+		arr := !c.missing && c.cur != nil && c.cur.kind == 'a'
+		idx, isIdx := isIndex(part{key: p.key})
+		add("sjson/4", p.key == "" && !p.force && !obj)
+		add("sjson/5", p.force && arr && isIdx && idx < len(c.cur.elems))
+		add("sjson/7", flags[i].leadingBracket && obj && c.cur.find(p.key) >= 0)
+		add("sjson/9", flags[i].escapedIndex && arr)
+		add("sjson/10", i == len(parts)-1 && strings.HasPrefix(p.key, `"`) && obj && c.cur.find(p.key) >= 0)
+		add("sjson/11", isAppend(p) && obj && hashCount(c.cur) > 0)
+	}
+	return shapes
+}
+
+// --------------------------------------------------------------------------- the model
+
+var (
+	errNonNumeric = fmt.Errorf("cannot set array element for non-numeric key")
+	errHugeIndex  = fmt.Errorf("index past the end of any array")
+	errEmptyPath  = fmt.Errorf("path cannot be empty")
+	errNonFinite  = fmt.Errorf("json: unsupported value")
+)
+
+// build makes the containers a new path creates: numeric parts become arrays padded with null,
+// -1 an array with one element, anything else an object; a huge index cannot be satisfied.
+func build(parts []part, v *node) (*node, error) {
+	if len(parts) == 0 {
+		return v, nil
+	}
+	p := parts[0]
+	if isHuge(p) {
+		return nil, errHugeIndex
+	}
+	sub, err := build(parts[1:], v)
+	if err != nil {
+		return nil, err
+	}
+	if i, ok := isIndex(p); ok {
+		a := arrNode(nil)
+		for ; i > 0; i-- {
+			a.elems = append(a.elems, litNode("null"))
+		}
+		a.elems = append(a.elems, sub)
+		return a, nil
+	}
+	if isAppend(p) {
+		return arrNode([]*node{sub}), nil
+	}
+	o := objNode()
+	o.put(p.key, sub)
+	return o, nil
+}
+
+// setModel applies Set to the tree (nil for an empty or scalar document) and reports whether the
+// last part replaced an existing value.
+func setModel(nd *node, parts []part, v *node) (out *node, replaced bool, err error) {
+	p, rest := parts[0], parts[1:]
+	if !nd.isContainer() {
+		// a scalar (or nothing) is replaced by the container the first part asks for
+		if _, ok := isIndex(p); ok || isAppend(p) || isHuge(p) {
+			nd = arrNode(nil)
+		} else {
+			nd = objNode()
+		}
+	}
+	switch nd.kind {
+	case 'o':
+		if i := nd.find(p.key); i >= 0 {
+			if len(rest) == 0 {
+				nd.vals[i] = v
+				return nd, true, nil
+			}
+			sub, rep, err := setModel(nd.vals[i], rest, v)
+			if err != nil {
+				return nil, false, err
+			}
+			nd.vals[i] = sub
+			return nd, rep, nil
+		}
+		sub, err := build(rest, v)
+		if err != nil {
+			return nil, false, err
+		}
+		nd.put(p.key, sub)
+		return nd, false, nil
+	default:
+		if isHuge(p) {
+			return nil, false, errHugeIndex
+		}
+		if i, ok := isIndex(p); ok {
+			if i < len(nd.elems) {
+				if len(rest) == 0 {
+					nd.elems[i] = v
+					return nd, true, nil
+				}
+				sub, rep, err := setModel(nd.elems[i], rest, v)
+				if err != nil {
+					return nil, false, err
+				}
+				nd.elems[i] = sub
+				return nd, rep, nil
+			}
+			sub, err := build(rest, v)
+			if err != nil {
+				return nil, false, err
+			}
+			for len(nd.elems) < i {
+				nd.elems = append(nd.elems, litNode("null"))
+			}
+			nd.elems = append(nd.elems, sub)
+			return nd, false, nil
+		}
+		if isAppend(p) {
+			sub, err := build(rest, v)
+			if err != nil {
+				return nil, false, err
+			}
+			nd.elems = append(nd.elems, sub)
+			return nd, false, nil
+		}
+		return nil, false, errNonNumeric
+	}
+}
+
+// deleteModel applies Delete; changed is false when nothing on the path exists.
+func deleteModel(nd *node, parts []part) (changed bool) {
+	p, rest := parts[0], parts[1:]
+	if nd == nil {
+		return false
+	}
+	switch nd.kind {
+	case 'o':
+		i := nd.find(p.key)
+		if i < 0 {
+			return false
+		}
+		if len(rest) == 0 {
+			nd.keys = append(nd.keys[:i], nd.keys[i+1:]...)
+			nd.vals = append(nd.vals[:i], nd.vals[i+1:]...)
+			return true
+		}
+		return deleteModel(nd.vals[i], rest)
+	case 'a':
+		i, ok := isIndex(p)
+		if !ok {
+			if !isAppend(p) || len(nd.elems) == 0 {
+				return false
+			}
+			i = len(nd.elems) - 1
+		}
+		if i >= len(nd.elems) {
+			return false
+		}
+		if len(rest) == 0 {
+			nd.elems = append(nd.elems[:i], nd.elems[i+1:]...)
+			return true
+		}
+		return deleteModel(nd.elems[i], rest)
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the library's entry points
+
+// callSet runs one of the Set entry points; api chooses the API.
+func callSet(doc, path string, val value, api int) (string, error) {
+	switch api {
+	case 0:
+		if val.isRaw {
+			return SetRaw(doc, path, val.raw)
+		}
+		return Set(doc, path, val.v)
+	case 1:
+		if val.isRaw {
+			b, err := SetRawBytes([]byte(doc), path, []byte(val.raw))
+			return string(b), err
+		}
+		b, err := SetBytes([]byte(doc), path, val.v)
+		return string(b), err
+	case 2:
+		if val.isRaw {
+			return SetRawOptions(doc, path, val.raw, &Options{Optimistic: true})
+		}
+		return SetOptions(doc, path, val.v, &Options{Optimistic: true})
+	default:
+		buf := make([]byte, len(doc)) // cap == len: in-place only when the result fits
+		copy(buf, doc)
+		if val.isRaw {
+			b, err := SetRawBytesOptions(buf, path, []byte(val.raw), &Options{Optimistic: true, ReplaceInPlace: true})
+			return string(b), err
+		}
+		b, err := SetBytesOptions(buf, path, val.v, &Options{Optimistic: true, ReplaceInPlace: true})
+		return string(b), err
+	}
+}
+
+var apiNames = []string{"Set", "SetBytes", "SetOptions{Optimistic}", "SetBytesOptions{Optimistic,ReplaceInPlace}"}
+
+func callDelete(doc, path string, api int) (string, error) {
+	switch api {
+	case 0:
+		return Delete(doc, path)
+	case 1:
+		b, err := DeleteBytes([]byte(doc), path)
+		return string(b), err
+	case 2:
+		return DeleteOptions(doc, path, &Options{Optimistic: true})
+	default:
+		buf := make([]byte, len(doc))
+		copy(buf, doc)
+		b, err := DeleteBytesOptions(buf, path, &Options{Optimistic: true, ReplaceInPlace: true})
+		return string(b), err
+	}
+}
+
+var deleteNames = []string{"Delete", "DeleteBytes", "DeleteOptions{Optimistic}", "DeleteBytesOptions{Optimistic,ReplaceInPlace}"}
+
+// --------------------------------------------------------------------------- judges
+
+// judgeSet checks one Set against the model: the modelled tree (or the modelled error, with
+// the input returned); a replacement keeps every byte around the old value and writes a raw
+// value verbatim. The path's and the value's known shapes are named on a mismatch.
+func judgeSet(ht *hegel.T, root *node, doc string, parts []part, val value, api int, shapes []string) {
+	skipKnown(ht, shapes)
+	path, gpath, flags := joinPath(parts)
+	var expect *node
+	var replaced bool
+	var merr error
+	switch {
+	case path == "":
+		merr = errEmptyPath
+	case val.nonFinite:
+		merr = errNonFinite
+	default:
+		expect, replaced, merr = setModel(root.clone(), parts, val.expect)
+	}
+	out, err := callSet(doc, path, val, api)
+	what := fmt.Sprintf("%s(%s, %q, %s)", apiNames[api], show(doc), path, describe(val))
+	if merr != nil {
+		count("error")
+		if err == nil {
+			mismatch(ht, shapes, "%s succeeded with %s; the model says: %v", what, show(out), merr)
+		}
+		if out != doc {
+			mismatch(ht, shapes, "%s failed (%v) but returned %s, not the input", what, err, show(out))
+		}
+		return
+	}
+	if err != nil {
+		mismatch(ht, shapes, "%s returned an error: %v (model: %s)", what, err, show(compactOf(expect)))
+	}
+	if !json.Valid([]byte(out)) {
+		mismatch(ht, shapes, "%s produced invalid JSON %s", what, show(out))
+	}
+	got, _ := decode(out)
+	if !same(got, expect) {
+		mismatch(ht, shapes, "%s = %s, want %s", what, show(out), show(compactOf(expect)))
+	}
+	switch {
+	case replaced:
+		count("replaced")
+	case contexts(root, parts)[len(parts)-1].missing:
+		count("created")
+	case root == nil:
+		count("empty-document")
+	default:
+		count("created-at-the-end")
+	}
+	if val.isRaw {
+		count("raw")
+	}
+	leadingBracket := false
+	for _, f := range flags {
+		leadingBracket = leadingBracket || f.leadingBracket
+	}
+	if replaced && root != nil && !hasAppend(parts) && !leadingBracket {
+		// the rest of the document is untouched, byte for byte
+		res := gjson.Get(doc, gpath)
+		if !res.Exists() || res.Index <= 0 || doc[res.Index:res.Index+len(res.Raw)] != res.Raw {
+			count("locator-missed")
+			return
+		}
+		pre, post := doc[:res.Index], doc[res.Index+len(res.Raw):]
+		if !strings.HasPrefix(out, pre) || !strings.HasSuffix(out, post) || len(out) < len(pre)+len(post) {
+			mismatch(ht, shapes, "%s = %s does not keep the bytes around the replaced value %s of %s", what, show(out), show(res.Raw), show(doc))
+		}
+		mid := out[len(pre) : len(out)-len(post)]
+		if val.isRaw && mid != val.raw {
+			mismatch(ht, shapes, "%s wrote %s for the raw value %s", what, show(mid), show(val.raw))
+		}
+		count("bytes-around-kept")
+	}
+}
+
+func hasAppend(parts []part) bool {
+	for _, p := range parts {
+		if isAppend(p) {
+			return true
+		}
+	}
+	return false
+}
+
+// judgeDelete checks one Delete against the model: the member or element is removed, or the
+// input comes back unchanged when nothing is at the path.
+func judgeDelete(ht *hegel.T, root *node, doc string, parts []part, api int, shapes []string) {
+	skipKnown(ht, shapes)
+	path, _, _ := joinPath(parts)
+	out, err := callDelete(doc, path, api)
+	what := fmt.Sprintf("%s(%s, %q)", deleteNames[api], show(doc), path)
+	if path == "" {
+		count("empty-path")
+		if err == nil || out != doc {
+			fail(ht, "%s = %s, %v; the empty path is an error that returns the input", what, show(out), err)
+		}
+		return
+	}
+	expect := root.clone()
+	changed := deleteModel(expect, parts)
+	if err != nil {
+		mismatch(ht, shapes, "%s returned an error: %v", what, err)
+	}
+	if !changed {
+		count("no-change")
+		if out != doc {
+			mismatch(ht, shapes, "%s = %s changed a document with nothing at that path", what, show(out))
+		}
+		return
+	}
+	if !json.Valid([]byte(out)) {
+		mismatch(ht, shapes, "%s produced invalid JSON %s", what, show(out))
+	}
+	got, _ := decode(out)
+	if !same(got, expect) {
+		mismatch(ht, shapes, "%s = %s, want %s", what, show(out), show(compactOf(expect)))
+	}
+	if hasAppend(parts) {
+		count("deleted-last")
+	} else {
+		count("deleted")
+	}
+}
+
+// --------------------------------------------------------------------------- properties: Set and Delete
+
+// setCase: a document, the drawn components of a path into it, a value and the API to use.
