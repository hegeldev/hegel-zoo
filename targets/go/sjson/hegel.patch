+// Set then Delete of a new key gives the document back (semantically); Set of an existing value
+// then Set of the old value back gives the exact bytes back when the old value is raw.
+func TestHegelSetThenDeleteRestoresTheDocument(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		root := genRoot(ht)
+		doc := genDoc(ht, root)
+		val := genValue(ht)
+		if val.nonFinite {
+			return
+		}
+		if root.kind == 'o' {
+			k := genKey(ht)
+			for root.find(k) >= 0 {
+				k += "y"
+			}
+			if k == "" || gjsonSwallows(k) || (k[0] == '"' && Known.quoteKeyDeleteCuts) || (k == "-1" && root.find("#") >= 0 && Known.minusOneReadsHashKey) {
+				return
+			}
+			path := escapePartAll(k)
+			out, err := callSet(doc, path, val, n(ht, 0, 2))
+			if err != nil {
+				c.fail(ht, "Set(%s, %q, %s): %v", show(doc), path, describe(val), err)
+				return
+			}
+			back, err := Delete(out, path)
+			if err != nil {
+				c.fail(ht, "Delete(%s, %q): %v", show(out), path, err)
+				return
+			}
+			got, ok := decode(back)
+			if !ok || !same(got, root) {
+				c.fail(ht, "Set then Delete of %q on %s gives %s", path, show(doc), show(back))
+				return
+			}
+			c.count("object")
+		} else {
+			out, err := callSet(doc, "-1", val, n(ht, 0, 2))
+			if err != nil {
+				c.fail(ht, "Set(%s, \"-1\", %s): %v", show(doc), describe(val), err)
+				return
+			}
+			back, err := Delete(out, "-1")
+			if err != nil {
+				c.fail(ht, "Delete(%s, \"-1\"): %v", show(out), err)
+				return
+			}
+			got, ok := decode(back)
+			if !ok || !same(got, root) {
+				c.fail(ht, "append then Delete(-1) on %s gives %s", show(doc), show(back))
+				return
+			}
+			c.count("array")
+		}
+		// replacing an existing value with its own raw text is the identity
+		if len(root.keys)+len(root.elems) > 0 {
+			var path string
+			if root.kind == 'o' {
+				i := n(ht, 0, len(root.keys)-1)
+				if root.keys[i] == "" || gjsonSwallows(root.keys[i]) {
+					return
+				}
+				path = escapePartAll(root.keys[i])
+			} else {
+				i := n(ht, 0, len(root.elems)-1)
+				path = strconv.Itoa(i)
+			}
+			res := gjson.Get(doc, gjsonEscape(unescapeG(path)))
+			if !res.Exists() || res.Index <= 0 {
+				c.count("locator-missed")
+				return
+			}
+			same1, err := SetRaw(doc, path, res.Raw)
+			if err != nil || same1 != doc {
+				c.fail(ht, "SetRaw(%s, %q, its own raw %s) = %s, %v", show(doc), path, show(res.Raw), show(same1), err)
+				return
+			}
+			c.count("identity")
+		}
+	})
+}
+
+// escapePartAll escapes every metacharacter (sjson's and gjson's) and a leading colon.
+func escapePartAll(s string) string {
+	var b strings.Builder
+	for i, r := range s {
+		if strings.ContainsRune(`.\*?|#@!:[]{}()`, r) || (i == 0 && r == ':') {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
