+func TestHegelSetFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		root, doc := genDocument(ht)
+		plan := genSetPath(ht, root)
+		val := genValue(ht)
+		which := n(ht, 0, 3)
+		path, gpath, flags := joinPath(ht, plan.parts)
+		leadingBracket := flags.leadingBracket
+		throughScalar, forcedHit := pathShape(root, plan.parts)
+
+		// gates for the recorded bugs
+		switch {
+		case val.nonFinite && Known.nonFiniteWritten:
+			c.count("gated:non-finite")
+			return
+		case plan.hasEmpty && Known.emptyPartIsIndexZero:
+			c.count("gated:empty-part")
+			return
+		case forcedHit && Known.forcedKeyHitsIndex:
+			c.count("gated:forced-key-hits-index")
+			return
+		case leadingBracket && Known.bracketKeyNotFound:
+			c.count("gated:leading-bracket")
+			return
+		case flags.escapedIndex && Known.escapedIndexAppends:
+			c.count("gated:escaped-index")
+			return
+		case which == 3 && val.needsEsc && Known.inPlaceDropsEscapes:
+			c.count("gated:in-place-escaped-string")
+			return
+		}
+		if plan.hasAppend && Known.minusOneOnScalar {
+			// -1 directly under a scalar or an empty document makes an object (sjson/6)
+			cur := root
+			for _, p := range plan.parts {
+				if cur == nil || !(cur.kind == 'o' || cur.kind == 'a') {
+					if isAppend(p) {
+						c.count("gated:append-under-scalar")
+						return
+					}
+					break
+				}
+				if cur.kind == 'o' {
+					j := cur.find(p.key)
+					if j < 0 {
+						break
+					}
+					cur = cur.vals[j]
+				} else {
+					j, ok := isIndex(p)
+					if !ok || j >= len(cur.elems) {
+						break
+					}
+					cur = cur.elems[j]
+				}
+			}
+		}
+
+		expect, replaced, merr := setModel(root.clone(), plan.parts, val.expect)
+		out, err := callSet(doc, path, val, which)
+		what := fmt.Sprintf("%s(%s, %q, %s)", apiNames[which], show(doc), path, describe(val))
+		if merr != nil {
+			c.count("error")
+			if err == nil {
+				c.fail(ht, "%s succeeded with %s; the model says: %v", what, show(out), merr)
+				return
+			}
+			if out != doc {
+				c.fail(ht, "%s failed (%v) but returned %s, not the input", what, err, show(out))
+			}
+			return
+		}
+		if err != nil {
+			c.fail(ht, "%s returned an error: %v (model: %s)", what, err, show(compactOf(expect)))
+			return
+		}
+		if !json.Valid([]byte(out)) {
+			c.fail(ht, "%s produced invalid JSON %s", what, show(out))
+			return
+		}
+		got, _ := decode(out)
+		if !same(got, expect) {
+			c.fail(ht, "%s = %s, want %s", what, show(out), show(compactOf(expect)))
+			return
+		}
+		switch {
+		case replaced:
+			c.count("replaced")
+		case throughScalar:
+			c.count("through-scalar")
+		case root == nil:
+			c.count("empty-document")
+		default:
+			c.count("created")
+		}
+		if val.isRaw {
+			c.count("raw")
+		}
+		if replaced && root != nil && !plan.hasAppend && !leadingBracket {
+			// the rest of the document is untouched, byte for byte
+			res := gjson.Get(doc, gpath)
+			if !res.Exists() || res.Index <= 0 || doc[res.Index:res.Index+len(res.Raw)] != res.Raw {
+				c.count("locator-missed")
+				return
+			}
+			pre, post := doc[:res.Index], doc[res.Index+len(res.Raw):]
+			if !strings.HasPrefix(out, pre) || !strings.HasSuffix(out, post) || len(out) < len(pre)+len(post) {
+				c.fail(ht, "%s = %s does not keep the bytes around the replaced value %s of %s", what, show(out), show(res.Raw), show(doc))
+				return
+			}
+			mid := out[len(pre) : len(out)-len(post)]
+			if val.isRaw && mid != val.raw {
+				c.fail(ht, "%s wrote %s for the raw value %s", what, show(mid), show(val.raw))
+				return
+			}
+			c.count("bytes-around-kept")
+		}
+	})
+}
+
+func describe(val value) string {
+	if val.isRaw {
+		return "raw " + show(val.raw)
+	}
+	return fmt.Sprintf("%T(%v)", val.v, val.v)
+}
