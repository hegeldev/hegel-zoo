index 0000000..b9a975a
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1707 @@
+package sjson_test
+
+// Hegel property tests for sjson (github.com/tidwall/sjson), written for the Hegel zoo.
+// See targets/go/sjson/README.md.
+//
+// Oracle: an ordered JSON tree with a model of sjson's path semantics (keys, indices, `-1`
+// appends, `:`-forced keys, escapes, containers created on the way, scalars replaced by
+// containers), encoding/json for validity and for the values sjson marshals, and gjson (sjson's
+// own locator) only to find the byte range of an existing value. Every generated operation is
+// built from the tree together with the result it must produce.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/tidwall/gjson"
+	. "github.com/tidwall/sjson"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// word draws lo..hi runes from alphabet.
+func word(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	pool := []rune(alphabet)
+	idx := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, len(pool)-1)).MinSize(lo).MaxSize(hi))
+	var b strings.Builder
+	for _, i := range idx {
+		b.WriteRune(pool[i])
+	}
+	return b.String()
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	nonFiniteWritten     bool // sjson/2: NaN and the infinities are written as NaN/+Inf/-Inf, invalid JSON
+	inPlaceDropsEscapes  bool // sjson/3: ReplaceInPlace silently leaves the document unchanged for a string that needs escaping
+	emptyPartIsIndexZero bool // sjson/4: an empty path component is index 0 when a container is created, the key "" in an existing object, an append on an array
+	forcedKeyHitsIndex   bool // sjson/5: :N on an array replaces element N when it exists (and errors when it does not)
+	minusOneOnScalar     bool // sjson/6: -1 makes an object with the key "-1" when the parent is a scalar or the document is empty
+	bracketKeyNotFound   bool // sjson/7: an unescaped key starting with [ or {, or with ! and a JSON literal, is never found, so a duplicate key is appended
+	nestedHashCorrupts   bool // sjson/8: a path with two # segments writes the value at offset 0 and corrupts the document
+	escapedIndexAppends  bool // sjson/9: an index with an escaped digit (\0) is numeric for sjson but not for gjson, so Set appends and Delete does nothing
+	quoteKeyDeleteCuts   bool // sjson/10: Delete of a key starting with a quote cuts the members before it, or leaves the key with no value
+	minusOneReadsHashKey bool // sjson/11: Delete of -1 on an object with a member named # takes that member for the array length
+}{
+	nonFiniteWritten:     true,
+	inPlaceDropsEscapes:  true,
+	emptyPartIsIndexZero: true,
+	forcedKeyHitsIndex:   true,
+	minusOneOnScalar:     true,
+	bracketKeyNotFound:   true,
+	nestedHashCorrupts:   true,
+	escapedIndexAppends:  true,
+	quoteKeyDeleteCuts:   true,
+	minusOneReadsHashKey: true,
+}
+
+// --------------------------------------------------------------------------- the JSON tree
+
+// node is an ordered JSON value. Scalars keep their token text; numbers compare as exact
+// rationals so that 1e21 and 1000000000000000000000 are the same value.
+type node struct {
+	kind  byte // 'o' object, 'a' array, 's' string, 'n' number, 't' true, 'f' false, 'z' null
+	raw   string
+	str   string
+	keys  []string
+	vals  []*node
+	elems []*node
+}
+
+func strNode(s string) *node   { return &node{kind: 's', str: s} }
+func numNode(raw string) *node { return &node{kind: 'n', raw: raw} }
+func litNode(raw string) *node {
+	switch raw {
+	case "true":
+		return &node{kind: 't', raw: raw}
+	case "false":
+		return &node{kind: 'f', raw: raw}
+	}
+	return &node{kind: 'z', raw: "null"}
+}
+func arrNode(elems []*node) *node { return &node{kind: 'a', elems: elems} }
+func objNode() *node              { return &node{kind: 'o'} }
+
+func (o *node) put(key string, v *node) {
+	o.keys = append(o.keys, key)
+	o.vals = append(o.vals, v)
+}
+
+func (o *node) find(key string) int {
+	for i, k := range o.keys {
+		if k == key {
+			return i
+		}
+	}
+	return -1
+}
+
+func (nd *node) clone() *node {
+	if nd == nil {
+		return nil
+	}
+	c := &node{kind: nd.kind, raw: nd.raw, str: nd.str}
+	for i := range nd.keys {
+		c.put(nd.keys[i], nd.vals[i].clone())
+	}
+	for _, e := range nd.elems {
+		c.elems = append(c.elems, e.clone())
+	}
+	return c
+}
+
+// render writes the value; ws supplies the whitespace between tokens ("" for compact output),
+// and strings are written with escapes chosen by esc (nil for encoding/json's form).
+func (nd *node) render(b *strings.Builder, ws func() string, esc func(string) string) {
+	switch nd.kind {
+	case 'o':
+		b.WriteByte('{')
+		for i := range nd.keys {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			b.WriteString(esc(nd.keys[i]))
+			b.WriteString(ws())
+			b.WriteByte(':')
+			b.WriteString(ws())
+			nd.vals[i].render(b, ws, esc)
+			b.WriteString(ws())
+		}
+		if len(nd.keys) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte('}')
+	case 'a':
+		b.WriteByte('[')
+		for i, e := range nd.elems {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			e.render(b, ws, esc)
+			b.WriteString(ws())
+		}
+		if len(nd.elems) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte(']')
+	case 's':
+		b.WriteString(esc(nd.str))
+	default:
+		b.WriteString(nd.raw)
+	}
+}
+
+func marshalString(s string) string {
+	b, _ := json.Marshal(s)
+	return string(b)
+}
+
+func compactOf(nd *node) string {
+	var b strings.Builder
+	nd.render(&b, func() string { return "" }, marshalString)
+	return b.String()
+}
+
+func ratOf(raw string) *big.Rat {
+	r, ok := new(big.Rat).SetString(raw)
+	if !ok {
+		return nil
+	}
+	return r
+}
+
+// same is structural equality with ordered keys and exact numbers.
+func same(a, b *node) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	if a.kind != b.kind {
+		return false
+	}
+	switch a.kind {
+	case 'o':
+		if len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i := range a.keys {
+			if a.keys[i] != b.keys[i] || !same(a.vals[i], b.vals[i]) {
+				return false
+			}
+		}
+		return true
+	case 'a':
+		if len(a.elems) != len(b.elems) {
+			return false
+		}
+		for i := range a.elems {
+			if !same(a.elems[i], b.elems[i]) {
+				return false
+			}
+		}
+		return true
+	case 's':
+		return a.str == b.str
+	case 'n':
+		ra, rb := ratOf(a.raw), ratOf(b.raw)
+		return ra != nil && rb != nil && ra.Cmp(rb) == 0
+	}
+	return true
+}
+
+// decode reads valid JSON into an ordered tree (nil, false for invalid input).
+func decode(s string) (*node, bool) {
+	dec := json.NewDecoder(strings.NewReader(s))
+	dec.UseNumber()
+	nd, err := decodeValue(dec)
+	if err != nil {
+		return nil, false
+	}
+	if _, err := dec.Token(); err == nil {
+		return nil, false // trailing tokens
+	}
+	return nd, true
+}
+
+func decodeValue(dec *json.Decoder) (*node, error) {
+	tok, err := dec.Token()
+	if err != nil {
+		return nil, err
+	}
+	switch v := tok.(type) {
+	case json.Delim:
+		switch v {
+		case '{':
+			o := objNode()
+			for dec.More() {
+				kt, err := dec.Token()
+				if err != nil {
+					return nil, err
+				}
+				k, ok := kt.(string)
+				if !ok {
+					return nil, fmt.Errorf("key %v", kt)
+				}
+				val, err := decodeValue(dec)
+				if err != nil {
+					return nil, err
+				}
+				o.put(k, val)
+			}
+			if _, err := dec.Token(); err != nil {
+				return nil, err
+			}
+			return o, nil
+		case '[':
+			a := arrNode(nil)
+			for dec.More() {
+				val, err := decodeValue(dec)
+				if err != nil {
+					return nil, err
+				}
+				a.elems = append(a.elems, val)
+			}
+			if _, err := dec.Token(); err != nil {
+				return nil, err
+			}
+			return a, nil
+		}
+		return nil, fmt.Errorf("delim %v", v)
+	case string:
+		return strNode(v), nil
+	case json.Number:
+		return numNode(string(v)), nil
+	case bool:
+		if v {
+			return litNode("true"), nil
+		}
+		return litNode("false"), nil
+	case nil:
+		return litNode("null"), nil
+	}
+	return nil, fmt.Errorf("token %v", tok)
+}
+
+// --------------------------------------------------------------------------- generators
+
+// Keys draw from an alphabet full of path metacharacters: sjson's dot and colon, gjson's
+// wildcards, pipes, hashes, modifiers, multipath brackets, literals, quotes and backslashes.
+const keyAlphabet = "abkxz019 _-:.*?\\|#@!\"[](){},~%<>=+'/\t\néß😀"
+
+const textAlphabet = "abc xyz019 \t\n\r\"\\/.*?|#@!<>&é中😀\x00\x01 "
+
+// jsonString writes s as a JSON string token, choosing escapes at random.
+func jsonString(tc hegel.TestCase, s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"' || r == '\\':
+			if chance(tc, 30) {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(r)
+			}
+		case r < 0x20:
+			switch {
+			case r == '\n' && chance(tc, 70):
+				b.WriteString(`\n`)
+			case r == '\t' && chance(tc, 70):
+				b.WriteString(`\t`)
+			case r == '\r' && chance(tc, 70):
+				b.WriteString(`\r`)
+			case chance(tc, 50):
+				fmt.Fprintf(&b, `\u%04X`, r)
+			default:
+				fmt.Fprintf(&b, `\u%04x`, r)
+			}
+		case r == '/' && chance(tc, 30):
+			b.WriteString(`\/`)
+		case r > 0xFFFF && chance(tc, 40):
+			hi, lo := (r-0x10000)>>10+0xD800, (r-0x10000)&0x3FF+0xDC00
+			fmt.Fprintf(&b, `\u%04x\u%04x`, hi, lo)
+		case r > 0x7F && r <= 0xFFFF && chance(tc, 30):
+			fmt.Fprintf(&b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func genKey(tc hegel.TestCase) string {
+	switch n(tc, 1, 20) {
+	case 1:
+		return ""
+	case 2:
+		return "-1"
+	case 3:
+		return strconv.Itoa(n(tc, 0, 12))
+	}
+	return word(tc, keyAlphabet, 1, 5)
+}
+
+func genText(tc hegel.TestCase) string { return word(tc, textAlphabet, 0, 8) }
+
+func genNumberRaw(tc hegel.TestCase) string {
+	switch n(tc, 0, 6) {
+	case 0:
+		return strconv.Itoa(n(tc, -1000, 1000))
+	case 1:
+		return pick(tc, []string{"0", "-0", "1e2", "1E-2", "-1.5e+3", "0.1", "123456789012345678901234567890", "1e400", "9007199254740993"})
+	case 2:
+		return fmt.Sprintf("%d.%d", n(tc, -99, 99), n(tc, 0, 999))
+	case 3:
+		return fmt.Sprintf("%de%d", n(tc, -9, 9), n(tc, -30, 30))
+	default:
+		return strconv.Itoa(n(tc, 0, 20))
+	}
+}
+
+// genNode builds a value; containers are shallower with depth.
+func genNode(tc hegel.TestCase, depth int) *node {
+	limit := 60 - depth*25
+	if limit < 0 {
+		limit = 0
+	}
+	if chance(tc, limit) {
+		if chance(tc, 50) {
+			o := objNode()
+			for i := n(tc, 0, 4); i > 0; i-- {
+				k := genKey(tc)
+				if o.find(k) >= 0 {
+					continue
+				}
+				o.put(k, genNode(tc, depth+1))
+			}
+			return o
+		}
+		var elems []*node
+		for i := n(tc, 0, 4); i > 0; i-- {
+			elems = append(elems, genNode(tc, depth+1))
+		}
+		return arrNode(elems)
+	}
+	switch n(tc, 0, 5) {
+	case 0, 1:
+		return strNode(genText(tc))
+	case 2, 3:
+		return numNode(genNumberRaw(tc))
+	default:
+		return litNode(pick(tc, []string{"true", "false", "null"}))
+	}
+}
+
+func genRoot(tc hegel.TestCase) *node {
+	if chance(tc, 50) {
+		o := objNode()
+		for i := n(tc, 0, 5); i > 0; i-- {
+			k := genKey(tc)
+			if o.find(k) >= 0 {
+				continue
+			}
+			o.put(k, genNode(tc, 1))
+		}
+		return o
+	}
+	var elems []*node
+	for i := n(tc, 0, 5); i > 0; i-- {
+		elems = append(elems, genNode(tc, 1))
+	}
+	return arrNode(elems)
+}
+
+// genDoc renders the tree with random whitespace and escape choices.
+func genDoc(tc hegel.TestCase, root *node) string {
+	var b strings.Builder
+	style := n(tc, 0, 2)
+	ws := func() string {
+		switch style {
+		case 0:
+			return ""
+		case 1:
+			return pick(tc, []string{"", " ", "\n", "\t", "  ", "\r\n"})
+		default:
+			return " "
+		}
+	}
+	esc := func(s string) string { return jsonString(tc, s) }
+	root.render(&b, ws, esc)
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- paths
+
+// part is one component of an sjson path: key is the text sjson compares with (after
+// unescaping), force the leading colon.
+type part struct {
+	key   string
+	force bool
+}
+
+func isIndex(p part) (int, bool) {
+	if p.force || p.key == "" {
+		return 0, false
+	}
+	for i := 0; i < len(p.key); i++ {
+		if p.key[i] < '0' || p.key[i] > '9' {
+			return 0, false
+		}
+	}
+	v, err := strconv.Atoi(p.key)
+	if err != nil {
+		return 0, false
+	}
+	return v, true
+}
+
+func isAppend(p part) bool { return !p.force && p.key == "-1" }
+
+// escapePart writes a component for sjson (and gjson): the characters both treat as syntax are
+// always escaped, brackets and bangs sometimes, ordinary characters rarely (escapedOrdinary
+// reports the last).
+func escapePart(tc hegel.TestCase, p part) (text string, escapedOrdinary bool) {
+	var b strings.Builder
+	if p.force {
+		b.WriteByte(':')
+	}
+	for i, r := range p.key {
+		switch {
+		case strings.ContainsRune(`.\*?|#@`, r):
+			b.WriteByte('\\')
+		case r == ':' && (i == 0 || chance(tc, 30)):
+			b.WriteByte('\\')
+		case strings.ContainsRune(`[]{}()!,`, r) && chance(tc, 50):
+			b.WriteByte('\\')
+		case chance(tc, 4):
+			b.WriteByte('\\')
+			escapedOrdinary = true
+		}
+		b.WriteRune(r)
+	}
+	return b.String(), escapedOrdinary
+}
+
+// pathFlags records the shapes of a rendered path that the recorded bugs are about.
+type pathFlags struct {
+	leadingBracket bool // an unescaped component starting with [ or {, or ! and a literal (sjson/7)
+	escapedIndex   bool // a numeric component with an escaped digit (sjson/9)
+}
+
+// gjsonSwallows reports whether gjson reads an unescaped component starting like key as a
+// multipath ([ or {) or a literal (! followed by a number, a string, a container, true, false
+// or null) instead of a key.
+func gjsonSwallows(key string) bool {
+	if key == "" {
+		return false
+	}
+	if key[0] == '[' || key[0] == '{' {
+		return true
+	}
+	if key[0] != '!' || len(key) == 1 {
+		return false
+	}
+	c := key[1]
+	if c >= '0' && c <= '9' || strings.IndexByte(`+-"[{`, c) >= 0 {
+		return true
+	}
+	rest := key[1:]
+	for _, lit := range []string{"true", "false", "null"} {
+		if strings.HasPrefix(rest, lit) {
+			return true
+		}
+	}
+	return false
+}
+
+// joinPath renders the parts as an sjson path (and, with gjsonToo, the same path for gjson,
+// which has no forced keys).
+func joinPath(tc hegel.TestCase, parts []part) (sjsonPath, gjsonPath string, flags pathFlags) {
+	var sp, gp []string
+	for _, p := range parts {
+		e, escaped := escapePart(tc, p)
+		sp = append(sp, e)
+		if p.force {
+			e = e[1:]
+		}
+		gp = append(gp, e)
+		if gjsonSwallows(p.key) && e[0] != '\\' {
+			flags.leadingBracket = true
+		}
+		if _, ok := isIndex(p); ok && escaped {
+			flags.escapedIndex = true
+		}
+	}
+	return strings.Join(sp, "."), strings.Join(gp, "."), flags
+}
+
+// pathPlan is a generated simple path with what the model says about it.
+type pathPlan struct {
+	parts     []part
+	hasEmpty  bool // a component is "" (sjson/4)
+	hasAppend bool // a -1 component
+	hasForce  bool
+}
+
+// genSetPath walks the tree and builds a path for Set: mostly through existing members, ending
+// on an existing value, a new key, an index past the end, an append, or a chain of new parts.
+func genSetPath(tc hegel.TestCase, root *node) pathPlan {
+	var plan pathPlan
+	cur := root
+	add := func(p part) {
+		plan.parts = append(plan.parts, p)
+		if p.key == "" {
+			plan.hasEmpty = true
+		}
+		if isAppend(p) {
+			plan.hasAppend = true
+		}
+		if p.force {
+			plan.hasForce = true
+		}
+	}
+	for steps := 0; steps < 6; steps++ {
+		last := steps == 5 || chance(tc, 35)
+		switch {
+		case cur != nil && cur.kind == 'o' && len(cur.keys) > 0 && chance(tc, 70):
+			i := n(tc, 0, len(cur.keys)-1)
+			k := cur.keys[i]
+			_, digits := isIndex(part{key: k})
+			add(part{key: k, force: (digits && chance(tc, 50)) || chance(tc, 10)})
+			cur = cur.vals[i]
+		case cur != nil && cur.kind == 'a' && len(cur.elems) > 0 && chance(tc, 70):
+			i := n(tc, 0, len(cur.elems)-1)
+			if chance(tc, 15) {
+				add(part{key: "-1"})
+				cur = nil // an append: whatever follows is built new
+			} else {
+				add(part{key: strconv.Itoa(i)})
+				cur = cur.elems[i]
+			}
+		case cur != nil && cur.kind == 'a' && chance(tc, 60):
+			// past the end (pads with null), an append, or a non-numeric key (an error)
+			switch n(tc, 0, 5) {
+			case 0:
+				add(part{key: strconv.Itoa(len(cur.elems) + n(tc, 0, 3))})
+			case 1, 2:
+				add(part{key: "-1"})
+			case 3:
+				add(part{key: strconv.Itoa(n(tc, 0, 3)), force: true})
+			default:
+				add(part{key: genKey(tc)})
+			}
+			cur = nil
+		case cur != nil && cur.kind == 'o':
+			k := genKey(tc)
+			for cur.find(k) >= 0 {
+				k += "x"
+			}
+			_, digits := isIndex(part{key: k})
+			add(part{key: k, force: digits && chance(tc, 50)})
+			cur = nil
+		default:
+			// under a scalar or a new member: anything goes
+			switch n(tc, 0, 4) {
+			case 0:
+				add(part{key: strconv.Itoa(n(tc, 0, 3))})
+			case 1:
+				add(part{key: "-1"})
+			default:
+				k := genKey(tc)
+				_, digits := isIndex(part{key: k})
+				add(part{key: k, force: digits && chance(tc, 50)})
+			}
+			cur = nil
+		}
+		if last {
+			break
+		}
+	}
+	return plan
+}
+
+// --------------------------------------------------------------------------- the model
+
+var errNonNumeric = fmt.Errorf("cannot set array element for non-numeric key")
+
+// build makes the containers a new path creates: numeric parts become arrays padded with null,
+// -1 an array with one element, anything else an object.
+func build(parts []part, v *node) *node {
+	if len(parts) == 0 {
+		return v
+	}
+	p := parts[0]
+	if i, ok := isIndex(p); ok {
+		a := arrNode(nil)
+		for ; i > 0; i-- {
+			a.elems = append(a.elems, litNode("null"))
+		}
+		a.elems = append(a.elems, build(parts[1:], v))
+		return a
+	}
+	if isAppend(p) {
+		return arrNode([]*node{build(parts[1:], v)})
+	}
+	o := objNode()
+	o.put(p.key, build(parts[1:], v))
+	return o
+}
+
+// setModel applies Set to the tree (nil for an empty or scalar document) and reports whether the
+// last part replaced an existing value.
+func setModel(nd *node, parts []part, v *node) (out *node, replaced bool, err error) {
+	p, rest := parts[0], parts[1:]
+	if nd == nil || !(nd.kind == 'o' || nd.kind == 'a') {
+		// a scalar (or nothing) is replaced by the container the first part asks for
+		if _, ok := isIndex(p); ok || isAppend(p) {
+			nd = arrNode(nil)
+		} else {
+			nd = objNode()
+		}
+	}
+	switch nd.kind {
+	case 'o':
+		if i := nd.find(p.key); i >= 0 {
+			if len(rest) == 0 {
+				nd.vals[i] = v
+				return nd, true, nil
+			}
+			sub, rep, err := setModel(nd.vals[i], rest, v)
+			if err != nil {
+				return nil, false, err
+			}
+			nd.vals[i] = sub
+			return nd, rep, nil
+		}
+		nd.put(p.key, build(rest, v))
+		return nd, false, nil
+	default:
+		if i, ok := isIndex(p); ok {
+			if i < len(nd.elems) {
+				if len(rest) == 0 {
+					nd.elems[i] = v
+					return nd, true, nil
+				}
+				sub, rep, err := setModel(nd.elems[i], rest, v)
+				if err != nil {
+					return nil, false, err
+				}
+				nd.elems[i] = sub
+				return nd, rep, nil
+			}
+			for len(nd.elems) < i {
+				nd.elems = append(nd.elems, litNode("null"))
+			}
+			nd.elems = append(nd.elems, build(rest, v))
+			return nd, false, nil
+		}
+		if isAppend(p) {
+			nd.elems = append(nd.elems, build(rest, v))
+			return nd, false, nil
+		}
+		return nil, false, errNonNumeric
+	}
+}
+
+// deleteModel applies Delete; changed is false when nothing on the path exists.
+func deleteModel(nd *node, parts []part) (changed bool) {
+	p, rest := parts[0], parts[1:]
+	if nd == nil {
+		return false
+	}
+	switch nd.kind {
+	case 'o':
+		i := nd.find(p.key)
+		if i < 0 {
+			return false
+		}
+		if len(rest) == 0 {
+			nd.keys = append(nd.keys[:i], nd.keys[i+1:]...)
+			nd.vals = append(nd.vals[:i], nd.vals[i+1:]...)
+			return true
+		}
+		return deleteModel(nd.vals[i], rest)
+	case 'a':
+		i, ok := isIndex(p)
+		if !ok {
+			if !isAppend(p) || len(nd.elems) == 0 {
+				return false
+			}
+			i = len(nd.elems) - 1
+		}
+		if i >= len(nd.elems) {
+			return false
+		}
+		if len(rest) == 0 {
+			nd.elems = append(nd.elems[:i], nd.elems[i+1:]...)
+			return true
+		}
+		return deleteModel(nd.elems[i], rest)
+	}
+	return false
+}
+
+// appendUnderHashObject reports whether a -1 component is looked up in an object that has a
+// member named "#" (sjson/11).
+func appendUnderHashObject(root *node, parts []part) bool {
+	cur := root
+	for _, p := range parts {
+		if cur == nil || !(cur.kind == 'o' || cur.kind == 'a') {
+			return false
+		}
+		if cur.kind == 'o' {
+			if isAppend(p) && cur.find("#") >= 0 {
+				return true
+			}
+			j := cur.find(p.key)
+			if j < 0 {
+				return false
+			}
+			cur = cur.vals[j]
+			continue
+		}
+		j, ok := isIndex(p)
+		if !ok {
+			if isAppend(p) && len(cur.elems) > 0 {
+				j = len(cur.elems) - 1
+			} else {
+				return false
+			}
+		}
+		if j >= len(cur.elems) {
+			return false
+		}
+		cur = cur.elems[j]
+	}
+	return false
+}
+
+// scalarOnPath reports whether the path passes through a scalar (or a null) before its end,
+// and whether an append component is followed by more parts under an existing array.
+func pathShape(root *node, parts []part) (throughScalar, forcedIndexHit bool) {
+	cur := root
+	for i, p := range parts {
+		if cur == nil || !(cur.kind == 'o' || cur.kind == 'a') {
+			if cur != nil || i > 0 {
+				throughScalar = true
+			}
+			return
+		}
+		if cur.kind == 'o' {
+			j := cur.find(p.key)
+			if j < 0 {
+				return
+			}
+			cur = cur.vals[j]
+			continue
+		}
+		if p.force {
+			if v, err := strconv.Atoi(p.key); err == nil && v >= 0 && v < len(cur.elems) && len(p.key) > 0 {
+				forcedIndexHit = true
+			}
+			return
+		}
+		j, ok := isIndex(p)
+		if !ok || j >= len(cur.elems) {
+			return
+		}
+		cur = cur.elems[j]
+	}
+	return
+}
+
+// --------------------------------------------------------------------------- values
+
+// value is what Set is given, with the tree it must produce and its class for gating.
+type value struct {
+	v         any
+	expect    *node
+	raw       string // for SetRaw: the raw JSON text
+	isRaw     bool
+	needsEsc  bool // a string sjson must run through json.Marshal
+	nonFinite bool
+}
+
+func mustEscape(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < ' ' || s[i] > 0x7f || s[i] == '"' || s[i] == '\\' {
+			return true
+		}
+	}
+	return false
+}
+
+func fromMarshal(v any) *node {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	nd, ok := decode(string(b))
+	if !ok {
+		panic("marshal produced invalid JSON")
+	}
+	return nd
+}
+
+func genValue(tc hegel.TestCase) value {
+	switch n(tc, 0, 14) {
+	case 0:
+		return value{v: nil, expect: litNode("null")}
+	case 1:
+		b := chance(tc, 50)
+		return value{v: b, expect: fromMarshal(b)}
+	case 2:
+		i := n(tc, -1000000, 1000000)
+		return value{v: i, expect: fromMarshal(i)}
+	case 3:
+		i := int64(n(tc, 0, 1)) * math.MaxInt64
+		if chance(tc, 50) {
+			i = math.MinInt64
+		}
+		return value{v: i, expect: fromMarshal(i)}
+	case 4:
+		switch n(tc, 0, 3) {
+		case 0:
+			x := int8(n(tc, -128, 127))
+			return value{v: x, expect: fromMarshal(x)}
+		case 1:
+			x := uint8(n(tc, 0, 255))
+			return value{v: x, expect: fromMarshal(x)}
+		case 2:
+			x := uint64(math.MaxUint64)
+			return value{v: x, expect: fromMarshal(x)}
+		default:
+			x := uint(n(tc, 0, 1000))
+			return value{v: x, expect: fromMarshal(x)}
+		}
+	case 5:
+		f := pick(tc, []float64{0, math.Copysign(0, -1), 0.1, 1.5, -2.25, 1e21, 1e-7, 123456.789, math.MaxFloat64, math.SmallestNonzeroFloat64, 9007199254740993})
+		return value{v: f, expect: numNode(strconv.FormatFloat(f, 'g', -1, 64))}
+	case 6:
+		f := pick(tc, []float64{math.NaN(), math.Inf(1), math.Inf(-1)})
+		return value{v: f, expect: nil, nonFinite: true}
+	case 7:
+		f := float32(pick(tc, []float64{0.1, 3.25, -1e10, 1e-3}))
+		return value{v: f, expect: numNode(strconv.FormatFloat(float64(f), 'g', -1, 64))}
+	case 8, 9:
+		s := genText(tc)
+		if chance(tc, 10) {
+			s += "\xff"
+		}
+		return value{v: s, expect: fromMarshal(s), needsEsc: mustEscape(s)}
+	case 10:
+		s := genText(tc)
+		return value{v: []byte(s), expect: fromMarshal(s), needsEsc: mustEscape(s)}
+	case 11:
+		xs := []string{}
+		for i := n(tc, 0, 3); i > 0; i-- {
+			xs = append(xs, genText(tc))
+		}
+		return value{v: xs, expect: fromMarshal(xs)}
+	case 12:
+		m := map[string]any{}
+		for i := n(tc, 0, 3); i > 0; i-- {
+			m[genText(tc)] = n(tc, 0, 9)
+		}
+		return value{v: m, expect: fromMarshal(m)}
+	default:
+		nd := genNode(tc, 1)
+		raw := genDoc(tc, nd)
+		return value{expect: nd, raw: raw, isRaw: true}
+	}
+}
+
+func show(s string) string {
+	if len(s) > 300 {
+		s = s[:300] + "..."
+	}
+	return strconv.Quote(s)
+}
+
+// --------------------------------------------------------------------------- properties
+
+// callSet runs one of the Set entry points; which chooses the API.
+func callSet(doc, path string, val value, which int) (string, error) {
+	switch which {
+	case 0:
+		if val.isRaw {
+			return SetRaw(doc, path, val.raw)
+		}
+		return Set(doc, path, val.v)
+	case 1:
+		if val.isRaw {
+			b, err := SetRawBytes([]byte(doc), path, []byte(val.raw))
+			return string(b), err
+		}
+		b, err := SetBytes([]byte(doc), path, val.v)
+		return string(b), err
+	case 2:
+		if val.isRaw {
+			return SetRawOptions(doc, path, val.raw, &Options{Optimistic: true})
+		}
+		return SetOptions(doc, path, val.v, &Options{Optimistic: true})
+	default:
+		buf := make([]byte, len(doc)) // cap == len: in-place only when the result fits
+		copy(buf, doc)
+		if val.isRaw {
+			b, err := SetRawBytesOptions(buf, path, []byte(val.raw), &Options{Optimistic: true, ReplaceInPlace: true})
+			return string(b), err
+		}
+		b, err := SetBytesOptions(buf, path, val.v, &Options{Optimistic: true, ReplaceInPlace: true})
+		return string(b), err
+	}
+}
+
+var apiNames = []string{"Set", "SetBytes", "SetOptions{Optimistic}", "SetBytesOptions{Optimistic,ReplaceInPlace}"}
+
+// genDocument makes the input: a rendered tree, or (rarely) an empty, blank or scalar document.
+func genDocument(tc hegel.TestCase) (root *node, doc string) {
+	switch n(tc, 0, 19) {
+	case 0:
+		return nil, pick(tc, []string{"", " ", "\n\t"})
+	case 1:
+		nd := genNode(tc, 9)
+		return nd, genDoc(tc, nd)
+	default:
+		root = genRoot(tc)
+		return root, genDoc(tc, root)
+	}
+}
