+func TestHegelNothingPanicsOnArbitraryInput(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		var doc string
+		valid := true
+		switch n(ht, 0, 3) {
+		case 0:
+			doc = word(ht, "{}[]\":,.-+eE0123456789tfnul\\/uabxyz \t\n\x00\x7f\xff", 0, 24)
+			valid = json.Valid([]byte(doc))
+		case 1:
+			root := genRoot(ht)
+			bs := []byte(genDoc(ht, root))
+			for round := n(ht, 1, 3); round > 0 && len(bs) > 0; round-- {
+				pos := n(ht, 0, len(bs)-1)
+				switch n(ht, 0, 2) {
+				case 0:
+					bs = append(bs[:pos], bs[pos+1:]...)
+				case 1:
+					junk := " \t{}[]\",:.-0e\\\"tn"
+					bs[pos] = junk[n(ht, 0, len(junk)-1)]
+				default:
+					bs = bs[:pos]
+				}
+			}
+			doc = string(bs)
+			valid = json.Valid(bs)
+		default:
+			root := genRoot(ht)
+			doc = genDoc(ht, root)
+		}
+		path := capDigits(word(ht, pathAlphabet, 0, 12))
+		val := genValue(ht)
+		for which := 0; which <= 3; which++ {
+			out, err := callSet(doc, path, val, which)
+			if valid && err == nil && !val.nonFinite && strings.Count(path, "#") <= 1 && !json.Valid([]byte(out)) {
+				c.fail(ht, "%s(%s, %q, %s) = %s, invalid JSON from a valid document", apiNames[which], show(doc), path, describe(val), show(out))
+				return
+			}
+			callDelete(doc, path, which)
+		}
+		if valid {
+			c.count("valid")
+		} else {
+			c.count("invalid")
+		}
+	})
+}
