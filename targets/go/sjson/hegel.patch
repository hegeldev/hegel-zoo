+
+// --------------------------------------------------------------------------- complex paths
+
+// glob matches tidwall/match's syntax on runes: * any run, ? one rune.
+func glob(pattern, s string) bool {
+	p, t := []rune(pattern), []rune(s)
+	var rec func(i, j int) bool
+	rec = func(i, j int) bool {
+		for i < len(p) {
+			switch p[i] {
+			case '*':
+				for k := j; k <= len(t); k++ {
+					if rec(i+1, k) {
+						return true
+					}
+				}
+				return false
+			case '?':
+				if j >= len(t) {
+					return false
+				}
+				i, j = i+1, j+1
+			default:
+				if j >= len(t) || p[i] != t[j] {
+					return false
+				}
+				i, j = i+1, j+1
+			}
+		}
+		return j == len(t)
+	}
+	return rec(0, 0)
+}
+
+// cpart is one component of a complex path: "#" (every element of an array; on an object,
+// gjson's lookup of the member named "#"), a key or index, or a wildcard pattern.
+type cpart struct {
+	text string
+	hash bool
+	wild bool
+}
+
+func (cp cpart) String() string {
+	switch {
+	case cp.hash:
+		return "#"
+	case cp.wild:
+		return escapeGlob(cp.text)
+	}
+	return gjsonEscape(cp.text)
+}
+
+// escapeGlob writes a wildcard pattern for gjson: every metacharacter but the wildcards
+// escaped.
+func escapeGlob(pattern string) string {
+	var b strings.Builder
+	for _, r := range pattern {
+		if strings.ContainsRune(`.\|#@!:[]{}()`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// walk applies one component to every node of the set, as gjson reads it.
+func walk(set []*node, cp cpart) []*node {
+	var out []*node
+	for _, nd := range set {
+		switch {
+		case !nd.isContainer():
+		case cp.hash:
+			if nd.kind == 'a' {
+				out = append(out, nd.elems...)
+			} else if j := nd.find("#"); j >= 0 {
+				out = append(out, nd.vals[j])
+			}
+		case cp.wild:
+			if nd.kind == 'o' {
+				for i, k := range nd.keys {
+					if glob(cp.text, k) {
+						out = append(out, nd.vals[i])
+						break
+					}
+				}
+			}
+		case nd.kind == 'o':
+			if j := nd.find(cp.text); j >= 0 {
+				out = append(out, nd.vals[j])
+			}
+		default:
+			if i, ok := isIndex(part{key: cp.text}); ok && i < len(nd.elems) {
+				out = append(out, nd.elems[i])
+			}
+		}
+	}
+	return out
+}
+
+// setLast writes v into every slot the last component names in the set; changed reports
+// whether there was one.
+func setLast(set []*node, cp cpart, v *node) (changed bool) {
+	for _, nd := range set {
+		switch {
+		case !nd.isContainer():
+		case cp.hash:
+			if nd.kind == 'a' {
+				for i := range nd.elems {
+					nd.elems[i] = v
+					changed = true
+				}
+			} else if j := nd.find("#"); j >= 0 {
+				nd.vals[j] = v
+				changed = true
+			}
+		case cp.wild:
+			if nd.kind == 'o' {
+				for i, k := range nd.keys {
+					if glob(cp.text, k) {
+						nd.vals[i] = v
+						changed = true
+						break
+					}
+				}
+			}
+		case nd.kind == 'o':
+			if j := nd.find(cp.text); j >= 0 {
+				nd.vals[j] = v
+				changed = true
+			}
+		default:
+			if i, ok := isIndex(part{key: cp.text}); ok && i < len(nd.elems) {
+				nd.elems[i] = v
+				changed = true
+			}
+		}
+	}
+	return changed
+}
+
+// applyComplex is the model of Set with a complex path: the value is written at every match.
+func applyComplex(root *node, prog []cpart, v *node) bool {
+	set := []*node{root}
+	for _, cp := range prog[:len(prog)-1] {
+		set = walk(set, cp)
+	}
+	return setLast(set, prog[len(prog)-1], v)
+}
+
+func renderComplex(prog []cpart) string {
+	var parts []string
+	for _, cp := range prog {
+		parts = append(parts, cp.String())
+	}
+	return strings.Join(parts, ".")
+}
+
+func hashes(prog []cpart) int {
+	n := 0
+	for _, cp := range prog {
+		if cp.hash {
+			n++
+		}
+	}
+	return n
+}
+
+func anyContainer(set []*node) bool {
+	for _, nd := range set {
+		if nd.isContainer() {
+			return true
+		}
+	}
+	return false
+}
+
+func firstOfKind(set []*node, kind byte) *node {
+	for _, nd := range set {
+		if nd != nil && nd.kind == kind && len(nd.keys)+len(nd.elems) > 0 {
+			return nd
+		}
+	}
+	return nil
+}
+
+// stepSpec is one drawn step of the prefix of a complex path: an existing key or index by
+// position modulo the live size, or "#".
+type stepSpec struct {
+	kind string // key, index, hash
+	at   int
+}
+
+// tailSpec is the drawn end of a complex path: the key of a "#.key" tail by position modulo
+// the keys the elements have (or a fresh one), or the coins that turn a key into a wildcard
+// pattern.
+type tailSpec struct {
+	at       int
+	fresh    string
+	useFresh bool
+	wild     []int
+}
+
+var (
+	stepSpecs = hegel.FlatMap(
+		weighted(choice[string]{5, hegel.Just("key")}, choice[string]{3, hegel.Just("index")}, choice[string]{2, hegel.Just("hash")}),
+		func(kind string) hegel.Generator[stepSpec] {
+			return hegel.Map(positions, func(at int) stepSpec { return stepSpec{kind: kind, at: at} })
+		})
+	tailSpecs = hegel.Composite(func(tc hegel.TestCase) tailSpec {
+		return tailSpec{at: hegel.Draw(tc, positions), fresh: hegel.Draw(tc, partKeys), useFresh: hegel.Draw(tc, chance(15)), wild: hegel.Draw(tc, tape(8))}
+	})
+)
+
+// globOf turns a key into a wildcard pattern: one coin per rune makes it a ? or a * (which
+// may swallow the runes after it); a glob metacharacter in the key stands as a ?; a pattern
+// without a wildcard gets a * at its end.
+func globOf(key string, wild []int) string {
+	rs := []rune(key)
+	var pat []rune
+	hasWild := false
+	ti := 0
+	coin := func() int {
+		x := coinAt(wild, ti)
+		ti++
+		return x
+	}
+	for i := 0; i < len(rs); i++ {
+		r := rs[i]
+		x := coin()
+		switch {
+		case x >= 75:
+			pat = append(pat, '?')
+			hasWild = true
+		case x >= 60:
+			pat = append(pat, '*')
+			hasWild = true
+			for i+1 < len(rs) && coin() >= 50 {
+				i++
+			}
+		case strings.ContainsRune(`*?\`, r):
+			pat = append(pat, '?')
+			hasWild = true
+		default:
+			pat = append(pat, r)
+		}
+	}
+	if !hasWild {
+		pat = append(pat, '*')
+	}
+	return string(pat)
+}
+
+// planComplex resolves the steps and the tail against the tree into the components of the
+// path: a step that no node of the live set fits (a key of an empty object, an index into no
+// array, a "#" on scalars, a step that leads only to scalars) is a no-op. The tail is
+// "#.key" when the set holds an array (the key one that its object elements have, or a fresh
+// one, never an index), a wildcard pattern made from a key of the first object otherwise.
+// Under HEGEL_NO_KNOWN=1 the prefix uses no "#", so the path has one segment of it (sjson/8).
+func planComplex(root *node, steps []stepSpec, tail tailSpec) []cpart {
+	set := []*node{root}
+	var prog []cpart
+	for _, s := range steps {
+		var cp cpart
+		switch s.kind {
+		case "hash":
+			if Known.nestedHashCorrupts {
+				continue
+			}
+			cp = cpart{hash: true}
+		case "key":
+			o := firstOfKind(set, 'o')
+			if o == nil {
+				continue
+			}
+			k := o.keys[s.at%len(o.keys)]
+			if k == "" {
+				continue
+			}
+			cp = cpart{text: k}
+		default:
+			a := firstOfKind(set, 'a')
+			if a == nil {
+				continue
+			}
+			cp = cpart{text: strconv.Itoa(s.at % len(a.elems))}
+		}
+		next := walk(set, cp)
+		if !anyContainer(next) {
+			continue
+		}
+		set, prog = next, append(prog, cp)
+	}
+	hasArray := false
+	var keys []string
+	for _, nd := range set {
+		if nd != nil && nd.kind == 'a' {
+			hasArray = true
+			for _, e := range nd.elems {
+				if e.kind == 'o' {
+					for _, k := range e.keys {
+						if !slices.Contains(keys, k) {
+							keys = append(keys, k)
+						}
+					}
+				}
+			}
+		}
+	}
+	if hasArray {
+		k := tail.fresh
+		if !tail.useFresh && len(keys) > 0 {
+			k = keys[tail.at%len(keys)]
+		}
+		if k == "" || k == "-1" || allDigits(k) {
+			k += "k" // an index, an append or the empty key would not be a key of the elements
+		}
+		return append(prog, cpart{hash: true}, cpart{text: k})
+	}
+	pattern := "*"
+	if o := firstOfKind(set, 'o'); o != nil {
+		pattern = globOf(o.keys[tail.at%len(o.keys)], tail.wild)
+	}
+	return append(prog, cpart{text: pattern, wild: true})
+}
+
+type complexCase struct {
+	doc   document
+	val   value
+	steps []stepSpec
+	tail  tailSpec
+}
+
+func (c complexCase) GoString() string {
+	return fmt.Sprintf("Set(%s, %q, %s)", show(c.doc.text()), renderComplex(planComplex(c.doc.root, c.steps, c.tail)), describe(c.val))
+}
+
+var complexCases = hegel.Composite(func(tc hegel.TestCase) complexCase {
+	return complexCase{
+		doc:   hegel.Draw(tc, containerDocs),
+		val:   hegel.Draw(tc, finiteValues),
+		steps: hegel.Draw(tc, many(stepSpecs, 0, 3)),
+		tail:  hegel.Draw(tc, tailSpecs),
+	}
+})
+
+// judgeComplex checks a Set with a complex path against the model (every match set, no match
+// leaves the document as it was) and that Delete refuses the path with the input unchanged.
+func judgeComplex(ht *hegel.T, root *node, doc string, prog []cpart, val value, shapes []string) {
+	skipKnown(ht, shapes)
+	path := renderComplex(prog)
+	expect := root.clone()
+	changed := applyComplex(expect, prog, val.expect)
+	out, err := callSet(doc, path, val, 0)
+	what := fmt.Sprintf("Set(%s, %q, %s)", show(doc), path, describe(val))
+	if err != nil {
+		mismatch(ht, shapes, "%s returned an error: %v", what, err)
+	}
+	if !changed {
+		count("no-match")
+		if out != doc {
+			mismatch(ht, shapes, "%s = %s changed a document with no match", what, show(out))
+		}
+	} else {
+		if prog[len(prog)-1].wild {
+			count("wildcard")
+		} else {
+			count("hash-key")
+		}
+		if !json.Valid([]byte(out)) {
+			mismatch(ht, shapes, "%s produced invalid JSON %s", what, show(out))
+		}
+		got, _ := decode(out)
+		if !same(got, expect) {
+			mismatch(ht, shapes, "%s = %s, want %s", what, show(out), show(compactOf(expect)))
+		}
+	}
+	dout, derr := Delete(doc, path)
+	if derr == nil || dout != doc {
+		fail(ht, "Delete(%s, %q) = %s, %v; want the input back with an error", show(doc), path, show(dout), derr)
+	}
+}
+
+// complexShapes names the recorded bug whose shape a complex path has: two "#" segments
+// (sjson/8).
+func complexShapes(prog []cpart) []string {
+	if hashes(prog) > 1 {
+		return []string{"sjson/8"}
+	}
+	return nil
+}
+
+// TestHegelComplexPathsSetEveryMatch: `arr.#.key` sets the key in every element that has it,
+// a wildcard component sets the first key in document order that matches, no match leaves the
+// document as it was, and Delete refuses complex paths.
+func TestHegelComplexPathsSetEveryMatch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, complexCases)
+		prog := planComplex(c.doc.root, c.steps, c.tail)
+		judgeComplex(ht, c.doc.root, c.doc.text(), prog, c.val, complexShapes(prog))
+	})
+}
+
+// --------------------------------------------------------------------------- robustness
+
+const pathAlphabet = "abkxz019 _-:.*?\\|#@!\"[](){},~%<>=+'/é😀"
+
+// capDigits keeps every digit run short: a large index asks sjson for that many nulls (and a
+// wrapped one for 2^63 of them: sjson/1's padding form, a resource exhaustion that stays out
+// under HEGEL_NO_KNOWN=1 too; the wrapping form is drawn by the Set model property). A
+// backslash does not end a run, since sjson strips it.
+func capDigits(s string) string {
+	var b strings.Builder
+	run := 0
+	for _, r := range s {
+		switch {
+		case r >= '0' && r <= '9':
+			run++
+			if run > 3 {
+				r = 'x'
+			}
+		case r == '\\':
+		default:
+			run = 0
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// corruption is one change to the bytes of a rendered document: a byte dropped, replaced by
+// a piece of JSON syntax, or the rest cut off; positions are taken modulo the live length.
+type corruption struct {
+	op   string // drop, replace, truncate
+	at   int
+	junk int
+}
+
+const junkBytes = " \t{}[]\",:.-0e\\\"tn"
+
+// robustDoc is the input of the robustness property: junk text, a rendered document with
+// some corruptions, or a clean one.
+type robustDoc struct {
+	kind string // junk, corrupt, clean
+	junk string
+	doc  document
+	cuts []corruption
+}
+
+func (r robustDoc) text() string {
+	switch r.kind {
+	case "junk":
+		return r.junk
+	case "clean":
+		return r.doc.text()
+	}
+	bs := []byte(r.doc.text())
+	for _, c := range r.cuts {
+		if len(bs) == 0 {
+			break
+		}
+		pos := c.at % len(bs)
+		switch c.op {
+		case "drop":
+			bs = slices.Delete(bs, pos, pos+1)
+		case "replace":
+			bs[pos] = junkBytes[c.junk%len(junkBytes)]
+		default:
+			bs = bs[:pos]
+		}
+	}
+	return string(bs)
+}
+
+var (
+	junkTexts   = word("{}[]\":,.-+eE0123456789tfnul\\/uabxyz \t\n\x00\x7f\xff", 0, 24)
+	corruptions = hegel.Composite(func(tc hegel.TestCase) corruption {
+		return corruption{
+			op:   hegel.Draw(tc, hegel.SampledFrom([]string{"drop", "replace", "truncate"})),
+			at:   hegel.Draw(tc, hegel.Integers(0, 999)),
+			junk: hegel.Draw(tc, hegel.Integers(0, len(junkBytes)-1)),
+		}
+	})
+	cleanDocs  = hegel.Map(containerDocs, func(d document) robustDoc { return robustDoc{kind: "clean", doc: d} })
+	robustDocs = hegel.OneOf(
+		hegel.Map(junkTexts, func(s string) robustDoc { return robustDoc{kind: "junk", junk: s} }),
+		hegel.Composite(func(tc hegel.TestCase) robustDoc {
+			return robustDoc{kind: "corrupt", doc: hegel.Draw(tc, containerDocs), cuts: hegel.Draw(tc, many(corruptions, 1, 3))}
+		}),
+		cleanDocs,
+		cleanDocs,
+	)
+	robustPaths = hegel.Map(word(pathAlphabet, 0, 12), capDigits)
+)
+
+type robustCase struct {
+	doc  robustDoc
+	path string
+	val  value
+}
+
+func (c robustCase) GoString() string {
+	return fmt.Sprintf("Set(%s, %q, %s)", show(c.doc.text()), c.path, describe(c.val))
+}
+
+var robustCases = hegel.Composite(func(tc hegel.TestCase) robustCase {
+	return robustCase{doc: hegel.Draw(tc, robustDocs), path: hegel.Draw(tc, robustPaths), val: hegel.Draw(tc, values)}
+})
+
+// TestHegelNothingPanicsOnArbitraryInput: random bytes, corrupted documents, random paths
+// (digit runs capped, since an index asks for that many nulls) and random values through
+// every entry point; a valid document with a nil error gives valid JSON. A non-finite value
+// (sjson/2) and a path with two # segments (sjson/8) are the shapes that give invalid JSON;
+// under HEGEL_NO_KNOWN=1 that one check is skipped for them and counted.
+func TestHegelNothingPanicsOnArbitraryInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, robustCases)
+		doc := c.doc.text()
+		valid := json.Valid([]byte(doc))
+		var shapes []string
+		if c.val.nonFinite {
+			shapes = append(shapes, "sjson/2")
+		}
+		if strings.Count(c.path, "#") > 1 {
+			shapes = append(shapes, "sjson/8")
+		}
+		for api := 0; api <= 3; api++ {
+			out, err := callSet(doc, c.path, c.val, api)
+			if valid && err == nil && !json.Valid([]byte(out)) {
+				if noKnown && len(shapes) > 0 {
+					count("skipped validity check: " + strings.Join(shapes, ", "))
+				} else {
+					mismatch(ht, shapes, "%s(%s, %q, %s) = %s, invalid JSON from a valid document", apiNames[api], show(doc), c.path, describe(c.val), show(out))
+				}
+			}
+			callDelete(doc, c.path, api)
+		}
+		if valid {
+			count("valid")
+		} else {
+			count("invalid")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- round trips
+
+// restoreCase: a rendered container, a value, a key to add to an object root, the API to add
+// it with, and a position of an existing member for the identity check.
+type restoreCase struct {
+	doc document
+	val value
+	key string
+	api int
+	at  int
+}
+
+func (c restoreCase) GoString() string {
+	path := "-1"
+	if c.doc.root.kind == 'o' {
+		path = gjsonEscape(c.newKey())
+	}
+	return fmt.Sprintf("%s(%s, %q, %s)", apiNames[c.api], show(c.doc.text()), path, describe(c.val))
+}
+
+// newKey is the drawn key made new (a suffix while it exists).
+func (c restoreCase) newKey() string {
+	k := c.key
+	for c.doc.root.find(k) >= 0 {
+		k += "y"
+	}
+	return k
+}
+
+var restoreCases = hegel.Composite(func(tc hegel.TestCase) restoreCase {
+	return restoreCase{
+		doc: hegel.Draw(tc, containerDocs),
+		val: hegel.Draw(tc, values),
+		key: hegel.Draw(tc, treeKeys),
+		api: hegel.Draw(tc, hegel.Integers(0, 2)),
+		at:  hegel.Draw(tc, positions),
+	}
+})
+
+// TestHegelSetThenDeleteRestoresTheDocument: Set of a new key (or an append) then Delete of it
+// gives the tree back; SetRaw of an existing value's own raw text is the identity on the
+// bytes. A new key starting with a quote (sjson/10) and the key -1 on an object with a #
+// member (sjson/11) are the shapes Delete gets wrong.
+func TestHegelSetThenDeleteRestoresTheDocument(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, restoreCases)
+		root, doc := c.doc.root, c.doc.text()
+		if root.kind == 'o' {
+			k := c.newKey()
+			path := gjsonEscape(k)
+			if path == "" {
+				// the empty path is a documented error
+				count("empty-path")
+				if out, err := callSet(doc, path, c.val, c.api); err == nil || out != doc {
+					fail(ht, "Set(%s, \"\", %s) = %s, %v; the empty path is an error that returns the input", show(doc), describe(c.val), show(out), err)
+				}
+			} else {
+				var shapes []string
+				if k[0] == '"' {
+					shapes = append(shapes, "sjson/10")
+				}
+				if k == "-1" && hashCount(root) > 0 {
+					shapes = append(shapes, "sjson/11")
+				}
+				skipKnown(ht, shapes)
+				out, err := callSet(doc, path, c.val, c.api)
+				if err != nil {
+					fail(ht, "Set(%s, %q, %s): %v", show(doc), path, describe(c.val), err)
+				}
+				back, err := Delete(out, path)
+				if err != nil {
+					fail(ht, "Delete(%s, %q): %v", show(out), path, err)
+				}
+				got, ok := decode(back)
+				if !ok || !same(got, root) {
+					mismatch(ht, shapes, "Set then Delete of %q on %s gives %s", path, show(doc), show(back))
+				}
+				count("object")
+			}
+		} else {
+			out, err := callSet(doc, "-1", c.val, c.api)
+			if err != nil {
+				fail(ht, "Set(%s, \"-1\", %s): %v", show(doc), describe(c.val), err)
+			}
+			back, err := Delete(out, "-1")
+			if err != nil {
+				fail(ht, "Delete(%s, \"-1\"): %v", show(out), err)
+			}
+			got, ok := decode(back)
+			if !ok || !same(got, root) {
+				fail(ht, "append then Delete(-1) on %s gives %s", show(doc), show(back))
+			}
+			count("array")
+		}
+		// replacing an existing value with its own raw text is the identity
+		if len(root.keys)+len(root.elems) == 0 {
+			return
+		}
+		var path string
+		if root.kind == 'o' {
+			key := root.keys[c.at%len(root.keys)]
+			if key == "" {
+				count("identity-skipped: the empty key is the empty path")
+				return
+			}
+			path = gjsonEscape(key)
+		} else {
+			path = strconv.Itoa(c.at % len(root.elems))
+		}
+		res := gjson.Get(doc, path)
+		if !res.Exists() || res.Index <= 0 {
+			count("locator-missed")
+			return
+		}
+		same1, err := SetRaw(doc, path, res.Raw)
+		if err != nil || same1 != doc {
+			fail(ht, "SetRaw(%s, %q, its own raw %s) = %s, %v", show(doc), path, show(res.Raw), show(same1), err)
+		}
+		count("identity")
+	})
+}
