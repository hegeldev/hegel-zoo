new file mode 100644
index 0000000..854dd76
--- /dev/null
+++ b/expfmt/hegel_test.go
@@ -0,0 +1,179 @@
+package expfmt_test
+
+// Hegel property tests for prometheus/common's expfmt package, written for the Hegel zoo. See
+// targets/go/prometheus-common/README.md.
+//
+// Oracle: the Prometheus exposition format specification (docs/instrumenting/exposition_formats,
+// the "text-based format" section) and the OpenMetrics 1.0 specification, with the package's
+// own documentation: a model writer renders generated metric families to the text format with
+// the freedom the specification allows (whitespace, value spellings, optional HELP/TYPE lines,
+// label order, quoted names) and the parser must recover the families; the package's writers
+// must produce text the parser reads back to the same families and text the reference Python
+// parsers (prometheus_client, the Prometheus and the OpenMetrics one) read to the same samples;
+// content negotiation must return what was asked for.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// a summary's _count line is converted with uint64(value) without a check: "-1" becomes
+	// 18446744073709551615 and "1.5" becomes 1, while a histogram rejects a negative count and
+	// keeps a fractional one as a float
+	summaryCountUnchecked bool
+	// a double quote inside an unquoted metric or label name toggles quoting instead of ending
+	// the name: `foo"bar" 1` parses as the metric foobar, `a{x"y"="1"}` as the label xy
+	quoteInsideName bool
+	// ExtractSamples with a nil *DecodeOptions panics on the first sample without a timestamp
+	extractSamplesNilPanics bool
+	// the OpenMetrics _created line omits the metric's timestamp, so a family whose samples
+	// carry timestamps is written with a mix the OpenMetrics parser rejects
+	createdLineLacksTimestamp bool
+	// an exemplar with no labels is not written to OpenMetrics output at all
+	exemplarWithoutLabelsDropped bool
+	// a gauge histogram is written to OpenMetrics with _count and _sum lines instead of the
+	// _gcount and _gsum the type requires, so the parser reads three families
+	gaugeHistogramUsesCountSum bool
+	// blanks or tabs after a sample's value or timestamp are a parse error ("expected integer
+	// as timestamp, got \"\"", "spurious string after timestamp"), though the format says
+	// leading and trailing whitespace is ignored
+	trailingWhitespaceRejected bool
+	// a sample line of a summary or histogram family that has no quantile/le label (or one
+	// with the value NaN) and is not _sum or _count is accepted and its value dropped: "# TYPE
+	// s summary\ns 1\n" gives a summary metric with nothing in it and no error
+	lineWithoutQuantileDropped bool
+	// a summary or histogram sample whose metric name is inside the braces ({"a",...}) is
+	// booked with the summary state of the family of the *previous* line: the label signature
+	// differs from that of unbraced lines (one summary splits into several metrics) and, when
+	// no summary line was parsed before, a label after the name panics on a nil map
+	bracedNameUsesPreviousFamily bool
+	// a counter without the _total suffix is declared "unknown" in OpenMetrics output, but its
+	// exemplar is still written, which OpenMetrics allows on counters and buckets only
+	unknownCounterKeepsExemplar bool
+}{
+	summaryCountUnchecked:        true,
+	quoteInsideName:              true,
+	extractSamplesNilPanics:      true,
+	createdLineLacksTimestamp:    true,
+	exemplarWithoutLabelsDropped: true,
+	gaugeHistogramUsesCountSum:   true,
+	trailingWhitespaceRejected:   true,
+	lineWithoutQuantileDropped:   true,
+	bracedNameUsesPreviousFamily: true,
+	unknownCounterKeepsExemplar:  true,
+}
