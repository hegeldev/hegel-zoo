+package expfmt_test
+
+// The model: a canonical form of a metric family (cFamily), generators for it, a converter to
+// the dto proto messages, a canonicaliser of dto messages, and a model writer that renders
+// canonical families to the text exposition format with the freedom the specification allows.
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+
+	dto "github.com/prometheus/client_model/go"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/prometheus/common/model"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- canonical form
+
+type cLabel struct{ N, V string }
+
+type cQuant struct{ Q, V float64 }
+
+type cBucket struct{ UB, C float64 }
+
+type cExemplar struct {
+	Labels []cLabel
+	Value  float64
+	TS     *int64 // nanoseconds
+}
+
+type cMetric struct {
+	Labels []cLabel
+	TS     *int64 // milliseconds
+	// counter, gauge, untyped
+	Value float64
+	// summary and histogram
+	Count     float64
+	Sum       float64
+	Quantiles []cQuant
+	Buckets   []cBucket
+	// OpenMetrics extras
+	Exemplar        *cExemplar   // counter
+	BucketExemplars []*cExemplar // histogram, parallel to Buckets
+	Created         *int64       // nanoseconds
+}
+
+type cFamily struct {
+	Name    string
+	Help    string
+	HasHelp bool
+	Unit    string
+	Type    dto.MetricType
+	Metrics []cMetric
+}
+
+func feq(a, b float64) bool { return a == b || (math.IsNaN(a) && math.IsNaN(b)) }
+
+func i64eq(a, b *int64) bool { return (a == nil && b == nil) || (a != nil && b != nil && *a == *b) }
+
+func labelsEq(a, b []cLabel) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func metricEq(a, b cMetric) bool {
+	if !labelsEq(a.Labels, b.Labels) || !i64eq(a.TS, b.TS) || !feq(a.Value, b.Value) || !feq(a.Count, b.Count) || !feq(a.Sum, b.Sum) {
+		return false
+	}
+	if len(a.Quantiles) != len(b.Quantiles) || len(a.Buckets) != len(b.Buckets) {
+		return false
+	}
+	for i := range a.Quantiles {
+		if !feq(a.Quantiles[i].Q, b.Quantiles[i].Q) || !feq(a.Quantiles[i].V, b.Quantiles[i].V) {
+			return false
+		}
+	}
+	for i := range a.Buckets {
+		if !feq(a.Buckets[i].UB, b.Buckets[i].UB) || !feq(a.Buckets[i].C, b.Buckets[i].C) {
+			return false
+		}
+	}
+	return true
+}
+
+func familyEq(a, b cFamily) bool {
+	if a.Name != b.Name || a.HasHelp != b.HasHelp || (a.HasHelp && a.Help != b.Help) || a.Type != b.Type || len(a.Metrics) != len(b.Metrics) {
+		return false
+	}
+	for i := range a.Metrics {
+		if !metricEq(a.Metrics[i], b.Metrics[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (f cFamily) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s %s help=%v/%q", f.Name, f.Type, f.HasHelp, f.Help)
+	for _, m := range f.Metrics {
+		fmt.Fprintf(&b, " [%v ts=%v v=%v count=%v sum=%v q=%v b=%v]", m.Labels, ptrStr(m.TS), m.Value, m.Count, m.Sum, m.Quantiles, m.Buckets)
+	}
+	return b.String()
+}
+
+func ptrStr(p *int64) string {
+	if p == nil {
+		return "-"
+	}
+	return strconv.FormatInt(*p, 10)
+}
+
+// canonOf turns a dto family into the canonical form, using the effective values the writers
+// use (a float count if non-zero, else the integer one).
+func canonOf(mf *dto.MetricFamily) cFamily {
+	f := cFamily{Name: mf.GetName(), Type: mf.GetType(), Unit: mf.GetUnit()}
+	if mf.Help != nil {
+		f.HasHelp, f.Help = true, mf.GetHelp()
+	}
+	for _, m := range mf.Metric {
+		c := cMetric{TS: m.TimestampMs}
+		for _, l := range m.Label {
+			c.Labels = append(c.Labels, cLabel{l.GetName(), l.GetValue()})
+		}
+		switch mf.GetType() {
+		case dto.MetricType_COUNTER:
+			c.Value = m.GetCounter().GetValue()
+		case dto.MetricType_GAUGE:
+			c.Value = m.GetGauge().GetValue()
+		case dto.MetricType_UNTYPED:
+			c.Value = m.GetUntyped().GetValue()
+		case dto.MetricType_SUMMARY:
+			s := m.GetSummary()
+			c.Count, c.Sum = float64(s.GetSampleCount()), s.GetSampleSum()
+			for _, q := range s.Quantile {
+				c.Quantiles = append(c.Quantiles, cQuant{q.GetQuantile(), q.GetValue()})
+			}
+		case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+			h := m.GetHistogram()
+			c.Count = h.GetSampleCountFloat()
+			if c.Count == 0 {
+				c.Count = float64(h.GetSampleCount())
+			}
+			c.Sum = h.GetSampleSum()
+			for _, b := range h.Bucket {
+				v := b.GetCumulativeCountFloat()
+				if v == 0 {
+					v = float64(b.GetCumulativeCount())
+				}
+				c.Buckets = append(c.Buckets, cBucket{b.GetUpperBound(), v})
+			}
+		}
+		f.Metrics = append(f.Metrics, c)
+	}
+	return f
+}
+
+// histogramConsistent checks the promise of the parser: the counts of a parsed histogram are
+// all integers or all floats, floats being used iff some count is not a whole number.
+func histogramConsistent(h *dto.Histogram) error {
+	if h == nil {
+		return nil
+	}
+	anyFloatField := h.SampleCountFloat != nil
+	anyIntField := h.SampleCount != nil
+	fractional := h.GetSampleCountFloat() != math.Trunc(h.GetSampleCountFloat())
+	for _, b := range h.Bucket {
+		anyFloatField = anyFloatField || b.CumulativeCountFloat != nil
+		anyIntField = anyIntField || b.CumulativeCount != nil
+		if b.GetCumulativeCountFloat() != math.Trunc(b.GetCumulativeCountFloat()) {
+			fractional = true
+		}
+	}
+	if anyFloatField && anyIntField {
+		return fmt.Errorf("mixed integer and float counts: %v", h)
+	}
+	if anyFloatField && !fractional {
+		return fmt.Errorf("float counts without a fractional value: %v", h)
+	}
+	return nil
+}
+
+// toDTO converts a canonical family to the proto message. Integral counts go to the integer
+// fields, others to the float fields (a whole float count is put in the float field when
+// floatWhole is set, to exercise the writer's fallback).
+func toDTO(f cFamily, floatWhole bool) *dto.MetricFamily {
+	mf := &dto.MetricFamily{Name: proto.String(f.Name), Type: f.Type.Enum()}
+	if f.HasHelp {
+		mf.Help = proto.String(f.Help)
+	}
+	if f.Unit != "" {
+		mf.Unit = proto.String(f.Unit)
+	}
+	for _, c := range f.Metrics {
+		m := &dto.Metric{TimestampMs: c.TS}
+		for _, l := range c.Labels {
+			m.Label = append(m.Label, &dto.LabelPair{Name: proto.String(l.N), Value: proto.String(l.V)})
+		}
+		var created *timestamppb.Timestamp
+		if c.Created != nil {
+			created = timestamppb.New(nsTime(*c.Created))
+		}
+		switch f.Type {
+		case dto.MetricType_COUNTER:
+			m.Counter = &dto.Counter{Value: proto.Float64(c.Value), CreatedTimestamp: created, Exemplar: exemplarDTO(c.Exemplar)}
+		case dto.MetricType_GAUGE:
+			m.Gauge = &dto.Gauge{Value: proto.Float64(c.Value)}
+		case dto.MetricType_UNTYPED:
+			m.Untyped = &dto.Untyped{Value: proto.Float64(c.Value)}
+		case dto.MetricType_SUMMARY:
+			s := &dto.Summary{SampleCount: proto.Uint64(uint64(c.Count)), SampleSum: proto.Float64(c.Sum), CreatedTimestamp: created}
+			for _, q := range c.Quantiles {
+				s.Quantile = append(s.Quantile, &dto.Quantile{Quantile: proto.Float64(q.Q), Value: proto.Float64(q.V)})
+			}
+			m.Summary = s
+		case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+			h := &dto.Histogram{SampleSum: proto.Float64(c.Sum), CreatedTimestamp: created}
+			if c.Count == math.Trunc(c.Count) && !floatWhole {
+				h.SampleCount = proto.Uint64(uint64(c.Count))
+			} else {
+				h.SampleCountFloat = proto.Float64(c.Count)
+			}
+			for i, b := range c.Buckets {
+				db := &dto.Bucket{UpperBound: proto.Float64(b.UB)}
+				if b.C == math.Trunc(b.C) && !floatWhole {
+					db.CumulativeCount = proto.Uint64(uint64(b.C))
+				} else {
+					db.CumulativeCountFloat = proto.Float64(b.C)
+				}
+				if i < len(c.BucketExemplars) {
+					db.Exemplar = exemplarDTO(c.BucketExemplars[i])
+				}
+				h.Bucket = append(h.Bucket, db)
+			}
+			m.Histogram = h
+		}
+		mf.Metric = append(mf.Metric, m)
+	}
+	return mf
+}
+
+func exemplarDTO(e *cExemplar) *dto.Exemplar {
+	if e == nil {
+		return nil
+	}
+	d := &dto.Exemplar{Value: proto.Float64(e.Value)}
+	for _, l := range e.Labels {
+		d.Label = append(d.Label, &dto.LabelPair{Name: proto.String(l.N), Value: proto.String(l.V)})
+	}
+	if e.TS != nil {
+		d.Timestamp = timestamppb.New(nsTime(*e.TS))
+	}
+	return d
+}
+
+// --------------------------------------------------------------------------- generators
+
+var legacyNames = []string{"a", "http_requests_total", "node_cpu:rate5m", "_x", "Z9", "go_gc_duration_seconds", "b_total", "up", "process_start_time_seconds", "x1", "y2", "z3", "req_seconds", "foo_bytes"}
+
+var utf8Names = []string{"a.b", "http requests", "métrique", "a\"q", "x\\y", "名前", "with,comma", "br{ace}", "eq=ual", "1starts_digit", "a\nb", "sp ace.total"}
+
+var legacyLabelNames = []string{"a", "b", "c", "instance", "job", "code", "_l", "L9", "method"}
+
+var utf8LabelNames = []string{"a.b", "label name", "läbel", "q\"uote", "back\\slash", "5x", "x,y"}
+
+var labelValues = []string{"", "x", "v1", "x\"y", "a\\b", "line\nbreak", "üñí", "\U0001F642", "\t", "}", ",", "=", "1.5", "# not a comment", "a\\nb", "\\", "\"", "  spaced  "}
+
+var helpTexts = []string{"help", "Total number of requests.", "with \\ backslash", "two\nlines", "quote \" inside", "unicode éà", "tab\there", "ends with backslash \\", "\\n literal"}
+
+var someValues = []float64{0, 1, -1, 2, 42, -7, 0.5, 1.5, 123.456, 1e6, 1e21, 1e-7, 9007199254740992, -2.5e-3, math.Inf(1), math.Inf(-1), math.NaN(), 3.141592653589793, 100000, 12345678901234}
+
+func genValue(tc hegel.TestCase) float64 {
+	if chance(tc, 70) {
+		return pick(tc, someValues)
+	}
+	return float64(drawInt(tc, -1000000, 1000000)) / float64(pick(tc, []int{1, 1, 3, 100, 7}))
+}
+
+// genCount draws a non-negative whole count below 2^53.
+func genCount(tc hegel.TestCase) float64 {
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		return 0
+	case 1:
+		return float64(drawInt(tc, 1, 20))
+	case 2:
+		return float64(drawInt(tc, 0, 1<<30))
+	}
+	return float64(pick(tc, []int64{1 << 40, 1<<53 - 1, 4503599627370496, 999999999999}))
+}
+
+func genLabels(tc hegel.TestCase, utf8 bool, exclude map[string]bool) []cLabel {
+	n := drawInt(tc, 0, 3)
+	var out []cLabel
+	seen := map[string]bool{}
+	for i := 0; i < n; i++ {
+		var name string
+		if utf8 && chance(tc, 30) {
+			name = pick(tc, utf8LabelNames)
+		} else {
+			name = pick(tc, legacyLabelNames)
+		}
+		if seen[name] || exclude[name] {
+			continue
+		}
+		seen[name] = true
+		out = append(out, cLabel{name, pick(tc, labelValues)})
+	}
+	return out
+}
+
+func labelKey(ls []cLabel) string {
+	cp := append([]cLabel{}, ls...)
+	sort.Slice(cp, func(i, j int) bool { return cp[i].N < cp[j].N })
+	return fmt.Sprint(cp)
+}
+
+// genOpts steers the generators.
+type genOpts struct {
+	utf8         bool // UTF-8 metric and label names allowed
+	gaugeHist    bool // gauge histograms allowed
+	floatCounts  bool // fractional histogram counts allowed
+	emptyFamily  bool // families without metrics allowed
+	omValid      bool // OpenMetrics constraints: _total counters, monotone buckets, +Inf bucket, quantiles in [0,1], non-negative sums
+	timestamps   bool
+	openMetrics  bool // exemplars, created timestamps, units
+	forceInfLast bool // histogram buckets end with +Inf
+	// summaries and histograms get legacy names (their sample lines are never written with the
+	// name inside the braces while Known.bracedNameUsesPreviousFamily)
+	noBracedComplex bool
+}
+
+// genFamilies draws 1-4 families with distinct names that are not suffix-related.
+func genFamilies(tc hegel.TestCase, o genOpts) []cFamily {
+	n := drawInt(tc, 1, 4)
+	var out []cFamily
+	names := map[string]bool{}
+	for i := 0; i < n; i++ {
+		f := genFamily(tc, o)
+		if !nameFree(f.Name, names) {
+			continue
+		}
+		names[f.Name] = true
+		out = append(out, f)
+	}
+	if len(out) == 0 {
+		f := genFamily(tc, o)
+		f.Name = "only"
+		out = append(out, f)
+	}
+	return out
+}
+
+// nameFree: n is not taken and neither a suffixed form of a taken name nor a base of one.
+func nameFree(n string, taken map[string]bool) bool {
+	if taken[n] {
+		return false
+	}
+	for _, s := range []string{"_sum", "_count", "_bucket", "_total", "_created", "_gsum", "_gcount", "_info"} {
+		if taken[n+s] || (strings.HasSuffix(n, s) && taken[strings.TrimSuffix(n, s)]) {
+			return false
+		}
+	}
+	return true
+}
+
+var metricTypes = []dto.MetricType{dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED, dto.MetricType_SUMMARY, dto.MetricType_HISTOGRAM}
+
+func genFamily(tc hegel.TestCase, o genOpts) cFamily {
+	f := cFamily{Type: pick(tc, metricTypes)}
+	if o.gaugeHist && chance(tc, 15) {
+		f.Type = dto.MetricType_GAUGE_HISTOGRAM
+	}
+	if o.utf8 && chance(tc, 35) {
+		f.Name = pick(tc, utf8Names)
+	} else {
+		f.Name = pick(tc, legacyNames)
+	}
+	if o.noBracedComplex && Known.bracedNameUsesPreviousFamily && (f.Type == dto.MetricType_SUMMARY || f.Type == dto.MetricType_HISTOGRAM || f.Type == dto.MetricType_GAUGE_HISTOGRAM) {
+		f.Name = pick(tc, legacyNames)
+	}
+	if o.omValid {
+		f.Name = strings.TrimSuffix(f.Name, "_total")
+		if f.Type == dto.MetricType_COUNTER && chance(tc, 80) {
+			f.Name += "_total"
+		}
+		if o.openMetrics && chance(tc, 25) && f.Type != dto.MetricType_COUNTER {
+			f.Unit = pick(tc, []string{"seconds", "bytes", "total"})
+			if !strings.HasSuffix(f.Name, "_"+f.Unit) {
+				f.Name += "_" + f.Unit
+			}
+		}
+	}
+	if chance(tc, 60) {
+		f.HasHelp, f.Help = true, pick(tc, helpTexts)
+	}
+	exclude := map[string]bool{model.MetricNameLabel: true}
+	if f.Type == dto.MetricType_SUMMARY {
+		exclude[model.QuantileLabel] = true
+	}
+	if f.Type == dto.MetricType_HISTOGRAM || f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+		exclude[model.BucketLabel] = true
+	}
+	n := drawInt(tc, 1, 3)
+	if o.emptyFamily && chance(tc, 10) {
+		n = 0
+	}
+	seen := map[string]bool{}
+	for i := 0; i < n; i++ {
+		m := cMetric{Labels: genLabels(tc, o.utf8, exclude)}
+		k := labelKey(m.Labels)
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		if o.timestamps && chance(tc, 30) {
+			ts := int64(drawInt(tc, -1000, 2000000000000))
+			if ts == 0 {
+				ts = 1
+			}
+			m.TS = &ts
+		}
+		switch f.Type {
+		case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+			m.Value = genValue(tc)
+			if o.omValid && f.Type == dto.MetricType_COUNTER {
+				m.Value = genCount(tc) + pick(tc, []float64{0, 0.5, 0.25})
+			}
+			if o.openMetrics && f.Type == dto.MetricType_COUNTER && chance(tc, 40) {
+				// (a counter without _total is written as unknown, on which an exemplar is
+				// invalid: Known.unknownCounterKeepsExemplar)
+				if strings.HasSuffix(f.Name, "_total") || !Known.unknownCounterKeepsExemplar {
+					m.Exemplar = genExemplar(tc)
+				}
+			}
+		case dto.MetricType_SUMMARY:
+			m.Count, m.Sum = genCount(tc), genValue(tc)
+			if o.omValid {
+				m.Sum = math.Abs(genCount(tc) + 0.5)
+			}
+			seenQ := map[float64]bool{}
+			for j := drawInt(tc, 0, 3); j > 0; j-- {
+				q := pick(tc, []float64{0.5, 0.9, 0.99, 0.01, 0, 1})
+				if !o.omValid && chance(tc, 20) {
+					// any finite quantile: a NaN one would be dropped silently
+					// (Known.lineWithoutQuantileDropped)
+					if v := genValue(tc); !math.IsNaN(v) && !math.IsInf(v, 0) {
+						q = v
+					}
+				}
+				if o.omValid && seenQ[q] {
+					continue
+				}
+				seenQ[q] = true
+				m.Quantiles = append(m.Quantiles, cQuant{q, genValue(tc)})
+				if o.omValid {
+					m.Quantiles[len(m.Quantiles)-1].V = math.Abs(genCount(tc))
+				}
+			}
+		case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+			m.Sum = genValue(tc)
+			if o.omValid {
+				m.Sum = math.Abs(genCount(tc) + 0.5)
+			}
+			nb := drawInt(tc, 0, 4)
+			var cum float64
+			for j := 0; j < nb; j++ {
+				ub := pick(tc, []float64{0.005, 0.01, 0.1, 0.5, 1, 2.5, 10, 100, 1e6, -1, 0, 1.5})
+				if o.omValid {
+					ub = float64(j) + pick(tc, []float64{0, 0.5})
+				}
+				cnt := genCount(tc)
+				if o.floatCounts && chance(tc, 30) {
+					cnt += 0.5
+				}
+				if o.omValid {
+					cum += cnt
+					cnt = cum
+				}
+				m.Buckets = append(m.Buckets, cBucket{ub, cnt})
+				if o.openMetrics && chance(tc, 30) {
+					m.BucketExemplars = append(m.BucketExemplars, genExemplar(tc))
+				} else {
+					m.BucketExemplars = append(m.BucketExemplars, nil)
+				}
+			}
+			m.Count = genCount(tc)
+			if o.floatCounts && chance(tc, 20) {
+				m.Count += 0.5
+			}
+			if o.omValid {
+				m.Count = cum + genCount(tc)
+			}
+			if o.forceInfLast || (o.omValid && chance(tc, 85)) || chance(tc, 50) {
+				m.Buckets = append(m.Buckets, cBucket{math.Inf(1), m.Count})
+				m.BucketExemplars = append(m.BucketExemplars, nil)
+			}
+		}
+		if o.openMetrics && chance(tc, 30) && f.Type != dto.MetricType_GAUGE && f.Type != dto.MetricType_UNTYPED {
+			cr := int64(drawInt(tc, 1, 2000000000)) * 1000000000
+			if chance(tc, 50) {
+				cr += int64(drawInt(tc, 0, 999)) * 1000000
+			}
+			m.Created = &cr
+		}
+		f.Metrics = append(f.Metrics, m)
+	}
+	return f
+}
+
+func genExemplar(tc hegel.TestCase) *cExemplar {
+	e := &cExemplar{Value: genValue(tc)}
+	if math.IsNaN(e.Value) || math.IsInf(e.Value, 0) {
+		e.Value = 0.5
+	}
+	for i := drawInt(tc, 0, 2); i > 0; i-- {
+		// (no quotes or backslashes in the values: the reference parser's exemplar grammar
+		// does not read escapes)
+		e.Labels = append(e.Labels, cLabel{pick(tc, []string{"trace_id", "span_id", "t"}), pick(tc, []string{"abc123", "x", "1", "d q"})})
+	}
+	if len(e.Labels) == 2 && e.Labels[0].N == e.Labels[1].N {
+		e.Labels = e.Labels[:1]
+	}
+	if chance(tc, 50) {
+		ts := int64(drawInt(tc, 1, 2000000000))*1000000000 + int64(drawInt(tc, 0, 999))*1000000
+		e.TS = &ts
+	}
+	return e
+}
+
+// --------------------------------------------------------------------------- model writer
+
+// renderOpts: the freedom taken when rendering to the text format.
+type renderOpts struct {
+	plain       bool // spaces only, lower-case type keywords, no comments or blank lines, grouped families
+	quoteLegacy bool // quote legacy-valid names too (inside braces)
+	interleave  bool // interleave the sample lines of different families
+}
+
+type renderer struct {
+	tc       hegel.TestCase
+	o        renderOpts
+	noBraces bool // set while rendering summary/histogram sample lines
+}
+
+func (r renderer) sep() string {
+	if r.o.plain {
+		return " "
+	}
+	return pick(r.tc, []string{" ", " ", "\t", "  ", " \t "})
+}
+
+func (r renderer) maybeSpace() string {
+	if r.o.plain || chance(r.tc, 70) {
+		return ""
+	}
+	return pick(r.tc, []string{" ", "\t"})
+}
+
+func escapeValue(s string) string {
+	return strings.NewReplacer("\\", `\\`, "\n", `\n`, "\"", `\"`).Replace(s)
+}
+
+func escapeHelp(s string) string {
+	return strings.NewReplacer("\\", `\\`, "\n", `\n`).Replace(s)
+}
+
+// name renders a metric or label name: unquoted when legacy-valid (unless quoting is asked
+// for), quoted otherwise.
+func (r renderer) name(n string, label bool) (string, bool) {
+	valid := model.LegacyValidation.IsValidMetricName(n)
+	if label {
+		valid = model.LegacyValidation.IsValidLabelName(n)
+	}
+	if valid && !(r.o.quoteLegacy && !r.noBraces && chance(r.tc, 40)) {
+		return n, false
+	}
+	return `"` + escapeValue(n) + `"`, true
+}
+
+// floatText renders a sample value in one of the spellings strconv.ParseFloat accepts.
+func (r renderer) floatText(v float64) string {
+	switch {
+	case math.IsNaN(v):
+		return pick(r.tc, []string{"NaN", "nan", "NAN"})
+	case math.IsInf(v, 1):
+		return pick(r.tc, []string{"+Inf", "Inf", "inf", "+inf", "Infinity"})
+	case math.IsInf(v, -1):
+		return pick(r.tc, []string{"-Inf", "-inf"})
+	}
+	s := strconv.FormatFloat(v, 'g', -1, 64)
+	switch drawInt(r.tc, 0, 5) {
+	case 0:
+		return strconv.FormatFloat(v, 'e', -1, 64)
+	case 1:
+		if v == math.Trunc(v) && math.Abs(v) < 1e15 && !strings.ContainsAny(s, "e.") {
+			return s + ".0"
+		}
+	case 2:
+		if v >= 0 {
+			return "+" + s
+		}
+	case 3:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	}
+	return s
+}
+
+// canonicalFloat is the spelling the package's writers use for quantile and le labels.
+func canonicalFloat(v float64) string {
+	switch {
+	case math.IsNaN(v):
+		return "NaN"
+	case math.IsInf(v, 1):
+		return "+Inf"
+	case math.IsInf(v, -1):
+		return "-Inf"
+	}
+	return strconv.FormatFloat(v, 'g', -1, 64)
+}
+
+// sampleLine renders one sample: name, labels (with an optional extra label at a random
+// position), value, optional timestamp.
+func (r renderer) sampleLine(name string, labels []cLabel, extra *cLabel, value string, ts *int64) string {
+	var b strings.Builder
+	if !r.o.plain && chance(r.tc, 10) {
+		b.WriteString(r.sep())
+	}
+	n, quoted := r.name(name, false)
+	all := append([]cLabel{}, labels...)
+	if extra != nil {
+		at := drawInt(r.tc, 0, len(all))
+		all = append(all[:at], append([]cLabel{*extra}, all[at:]...)...)
+	}
+	if quoted {
+		b.WriteString("{" + r.maybeSpace() + n)
+		for _, l := range all {
+			b.WriteString("," + r.maybeSpace())
+			r.label(&b, l)
+		}
+		b.WriteString(r.maybeSpace() + "}")
+	} else {
+		b.WriteString(n)
+		if len(all) > 0 || (!r.o.plain && chance(r.tc, 10)) {
+			b.WriteString("{" + r.maybeSpace())
+			for i, l := range all {
+				if i > 0 {
+					b.WriteString("," + r.maybeSpace())
+				}
+				r.label(&b, l)
+			}
+			b.WriteString(r.maybeSpace() + "}")
+		}
+	}
+	b.WriteString(r.sep() + value)
+	if ts != nil {
+		b.WriteString(r.sep() + strconv.FormatInt(*ts, 10))
+	}
+	if !r.o.plain && !Known.trailingWhitespaceRejected && chance(r.tc, 15) {
+		b.WriteString(r.sep())
+	}
+	b.WriteString("\n")
+	return b.String()
+}
+
+func (r renderer) label(b *strings.Builder, l cLabel) {
+	n, _ := r.name(l.N, true)
+	b.WriteString(n + r.maybeSpace() + "=" + r.maybeSpace() + `"` + escapeValue(l.V) + `"`)
+}
+
+func (r renderer) typeKeyword(t dto.MetricType) string {
+	kw := map[dto.MetricType]string{dto.MetricType_COUNTER: "counter", dto.MetricType_GAUGE: "gauge", dto.MetricType_UNTYPED: "untyped", dto.MetricType_SUMMARY: "summary", dto.MetricType_HISTOGRAM: "histogram"}[t]
+	if !r.o.plain && chance(r.tc, 20) {
+		kw = strings.ToUpper(kw)
+	}
+	if !r.o.plain && chance(r.tc, 10) {
+		kw = strings.ToUpper(kw[:1]) + kw[1:]
+	}
+	return kw
+}
+
+// render writes the families to text. It returns the text and the families the parser must
+// produce (HELP omitted where the line was not written, empty families dropped, UNTYPED where
+// no TYPE line was written).
+func (r renderer) render(fs []cFamily) (string, []cFamily) {
+	var expected []cFamily
+	var blocks [][]string // sample lines per family, headers separately
+	var headers []string
+	for _, f := range fs {
+		e := f
+		var head []string
+		n, _ := r.name(f.Name, false)
+		if f.HasHelp && (r.o.plain || chance(r.tc, 85)) {
+			head = append(head, "# HELP"+r.sep()+n+r.sep()+escapeHelp(f.Help)+"\n")
+		} else {
+			e.HasHelp, e.Help = false, ""
+		}
+		if f.Type != dto.MetricType_UNTYPED || r.o.plain || chance(r.tc, 70) {
+			head = append(head, "# TYPE"+r.sep()+n+r.sep()+r.typeKeyword(f.Type)+"\n")
+		}
+		if !r.o.plain && chance(r.tc, 50) && len(head) == 2 {
+			head[0], head[1] = head[1], head[0]
+		}
+		var lines []string
+		for _, m := range f.Metrics {
+			switch f.Type {
+			case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+				lines = append(lines, r.sampleLine(f.Name, m.Labels, nil, r.floatText(m.Value), m.TS))
+			case dto.MetricType_SUMMARY:
+				r.noBraces = Known.bracedNameUsesPreviousFamily
+				var ls []string
+				for _, q := range m.Quantiles {
+					ls = append(ls, r.sampleLine(f.Name, m.Labels, &cLabel{model.QuantileLabel, canonicalFloat(q.Q)}, r.floatText(q.V), m.TS))
+				}
+				// the quantile lines keep their order (the parser appends them as read); the
+				// _sum and _count lines go anywhere
+				for _, extra := range []string{r.sampleLine(f.Name+"_sum", m.Labels, nil, r.floatText(m.Sum), m.TS), r.sampleLine(f.Name+"_count", m.Labels, nil, r.floatText(m.Count), m.TS)} {
+					at := len(ls)
+					if !r.o.plain {
+						at = drawInt(r.tc, 0, len(ls))
+					}
+					ls = append(ls[:at], append([]string{extra}, ls[at:]...)...)
+				}
+				lines = append(lines, ls...)
+			case dto.MetricType_HISTOGRAM:
+				r.noBraces = Known.bracedNameUsesPreviousFamily
+				var ls []string
+				for _, b := range m.Buckets {
+					ls = append(ls, r.sampleLine(f.Name+"_bucket", m.Labels, &cLabel{model.BucketLabel, canonicalFloat(b.UB)}, r.floatText(b.C), m.TS))
+				}
+				ls = append(ls, r.sampleLine(f.Name+"_sum", m.Labels, nil, r.floatText(m.Sum), m.TS))
+				ls = append(ls, r.sampleLine(f.Name+"_count", m.Labels, nil, r.floatText(m.Count), m.TS))
+				if !r.o.plain && chance(r.tc, 30) {
+					// the _sum and _count lines may come first; the buckets keep their order
+					ls = append(ls[len(ls)-2:], ls[:len(ls)-2]...)
+				}
+				lines = append(lines, ls...)
+			}
+		}
+		r.noBraces = false
+		if len(f.Metrics) > 0 {
+			expected = append(expected, e)
+		}
+		headers = append(headers, strings.Join(head, ""))
+		blocks = append(blocks, lines)
+	}
+	var b strings.Builder
+	if r.o.interleave && len(fs) > 1 {
+		// all headers first (a TYPE line after a family's samples is an error), then the
+		// sample lines of the families interleaved
+		for _, h := range headers {
+			b.WriteString(h)
+		}
+		idx := make([]int, len(blocks))
+		for {
+			var open []int
+			for i := range blocks {
+				if idx[i] < len(blocks[i]) {
+					open = append(open, i)
+				}
+			}
+			if len(open) == 0 {
+				break
+			}
+			i := pick(r.tc, open)
+			b.WriteString(blocks[i][idx[i]])
+			idx[i]++
+			r.filler(&b)
+		}
+	} else {
+		for i := range fs {
+			r.filler(&b)
+			b.WriteString(headers[i])
+			for _, l := range blocks[i] {
+				b.WriteString(l)
+				r.filler(&b)
+			}
+		}
+	}
+	// the expected metrics of a histogram/summary family are in first-seen order, which is the
+	// generated order for every layout above
+	return b.String(), expected
+}
+
+// filler writes blank lines and comments between lines.
+func (r renderer) filler(b *strings.Builder) {
+	if r.o.plain || !chance(r.tc, 20) {
+		return
+	}
+	b.WriteString(pick(r.tc, []string{"\n", "  \n", "# a comment\n", "#\n", "# \n", "#comment without space\n", "# HELP\n", "# TYPE\n", "\t# tabbed comment\n"}))
+}
+
+func shuffle[T any](tc hegel.TestCase, xs []T) {
+	for i := len(xs) - 1; i > 0; i-- {
+		j := drawInt(tc, 0, i)
+		xs[i], xs[j] = xs[j], xs[i]
+	}
+}
+
+// mutate applies one random edit to a text.
+func mutate(tc hegel.TestCase, s string) string {
+	alphabet := []string{`"`, "{", "}", "=", ",", " ", "\t", "\n", "#", `\`, "a", "1", "-", ".", "e", "_", ":", "+", "\xff"}
+	if len(s) == 0 {
+		return pick(tc, alphabet)
+	}
+	i := drawInt(tc, 0, len(s)-1)
+	switch drawInt(tc, 0, 5) {
+	case 0:
+		return s[:i] + pick(tc, alphabet) + s[i:]
+	case 1:
+		return s[:i] + s[i+1:]
+	case 2:
+		return s[:i] + pick(tc, alphabet) + s[i+1:]
+	case 3:
+		j := drawInt(tc, 0, len(s)-1)
+		if i > j {
+			i, j = j, i
+		}
+		if i == j {
+			return s
+		}
+		return s[:i] + s[j:j+1] + s[i+1:j] + s[i:i+1] + s[j+1:]
+	case 4:
+		return strings.TrimSuffix(s, "\n")
+	}
+	lines := strings.SplitAfter(s, "\n")
+	if len(lines) > 1 {
+		k := drawInt(tc, 0, len(lines)-1)
+		lines = append(lines[:k], append([]string{lines[k]}, lines[k:]...)...)
+	}
+	return strings.Join(lines, "")
+}
diff --git a/expfmt/hegel_pins_test.go b/expfmt/hegel_pins_test.go
new file mode 100644
index 0000000..00bcb98
--- /dev/null
+++ b/expfmt/hegel_pins_test.go
@@ -0,0 +1,179 @@
+package expfmt_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// its bug exists (target.toml lists them as expected failures).
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+
+	dto "github.com/prometheus/client_model/go"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+)
+
+// prometheus-common/1: a summary's _count is a non-negative whole number; "-1" and "1.5" are
+// not silently converted (a histogram rejects the negative count).
+func TestHegelPinSummaryCountIsChecked(t *testing.T) {
+	for _, s := range []string{"# TYPE s summary\ns_count -1\n", "# TYPE s summary\ns_count 1.5\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err != nil {
+			continue
+		}
+		if f := fams["s"]; f != nil && len(f.Metric) == 1 {
+			c := f.Metric[0].GetSummary().GetSampleCount()
+			t.Errorf("%q accepted with sample_count %d; want an error", s, c)
+		}
+	}
+}
+
+// prometheus-common/2: a metric or label name is a token of name characters; a double quote
+// inside an unquoted name is an error, not a toggle of quoting.
+func TestHegelPinQuoteInsideNameRejected(t *testing.T) {
+	for _, s := range []string{"foo\"bar\" 1\n", "a{x\"y\"=\"1\"} 1\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err == nil {
+			t.Errorf("%q accepted as %v; want an error", s, fams)
+		}
+	}
+}
+
+// prometheus-common/3: ExtractSamples without options works for samples without a timestamp
+// as it does for samples with one.
+func TestHegelPinExtractSamplesNilOptions(t *testing.T) {
+	fams, err := parseText("a 1\nb 2 1000\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("ExtractSamples(nil, ...) panics: %v", r)
+		}
+	}()
+	v, err := expfmt.ExtractSamples(nil, fams["b"])
+	if err != nil || len(v) != 1 {
+		t.Fatalf("ExtractSamples(nil, b) = %v, %v", v, err)
+	}
+	v, err = expfmt.ExtractSamples(nil, fams["a"])
+	if err != nil || len(v) != 1 {
+		t.Errorf("ExtractSamples(nil, a) = %v, %v", v, err)
+	}
+}
+
+// prometheus-common/4: the _created line of a metric with a timestamp carries that timestamp
+// (OpenMetrics: all lines of a MetricPoint have the same timestamp).
+func TestHegelPinCreatedLineHasTheTimestamp(t *testing.T) {
+	ts := int64(1234567890123)
+	mf := &dto.MetricFamily{Name: proto.String("a_total"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		TimestampMs: &ts,
+		Counter:     &dto.Counter{Value: proto.Float64(2), CreatedTimestamp: timestamppb.New(time.Unix(1, 500000000))},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf, expfmt.WithCreatedLines()); err != nil {
+		t.Fatal(err)
+	}
+	for _, l := range strings.Split(strings.TrimSpace(b.String()), "\n") {
+		if strings.HasPrefix(l, "a_created ") && !strings.HasSuffix(l, " 1.234567890123e+09") {
+			t.Errorf("created line without the metric's timestamp: %q in\n%s", l, b.String())
+		}
+	}
+}
+
+// prometheus-common/5: an exemplar with no labels is written ("# {} value").
+func TestHegelPinExemplarWithoutLabelsWritten(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("a_total"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		Counter: &dto.Counter{Value: proto.Float64(2), Exemplar: &dto.Exemplar{Value: proto.Float64(0.5)}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(b.String(), " # {} 0.5") {
+		t.Errorf("exemplar without labels dropped:\n%s", b.String())
+	}
+}
+
+// prometheus-common/6: a gauge histogram in OpenMetrics has _gcount and _gsum lines.
+func TestHegelPinGaugeHistogramUsesGcountGsum(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("h"), Type: dto.MetricType_GAUGE_HISTOGRAM.Enum(), Metric: []*dto.Metric{{
+		Histogram: &dto.Histogram{SampleCount: proto.Uint64(2), SampleSum: proto.Float64(3), Bucket: []*dto.Bucket{{UpperBound: proto.Float64(1), CumulativeCount: proto.Uint64(1)}}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	out := b.String()
+	if !strings.Contains(out, "h_gcount 2") || !strings.Contains(out, "h_gsum 3.0") || strings.Contains(out, "h_count") || strings.Contains(out, "h_sum") {
+		t.Errorf("gauge histogram written with _count/_sum:\n%s", out)
+	}
+}
+
+// prometheus-common/7: "Leading and trailing whitespace is ignored" (the text format
+// specification): blanks after the value or the timestamp are not an error.
+func TestHegelPinTrailingWhitespaceIgnored(t *testing.T) {
+	for _, s := range []string{"foo 1 \n", "foo 1\t\n", "foo 1 2 \n", "foo{a=\"b\"} 1 2\t\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err != nil {
+			t.Errorf("%q: %v", s, err)
+			continue
+		}
+		if f := fams["foo"]; f == nil || len(f.Metric) != 1 || f.Metric[0].GetUntyped().GetValue() != 1 {
+			t.Errorf("%q parsed as %v", s, fams)
+		}
+	}
+}
+
+// prometheus-common/8: a sample of a summary or histogram family must be a quantile/bucket
+// line, _sum or _count; anything else is an error, not a silently dropped value.
+func TestHegelPinSummaryLineWithoutQuantileRejected(t *testing.T) {
+	for _, s := range []string{"# TYPE s summary\ns 1\n", "# TYPE s summary\ns{a=\"b\"} 1\n", "# TYPE h histogram\nh 1\n", "# TYPE s summary\ns{quantile=\"NaN\"} 1\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err == nil {
+			t.Errorf("%q accepted as %v; want an error", s, fams)
+		}
+	}
+}
+
+// prometheus-common/9: a summary sample with the metric name inside the braces is the same
+// sample as with the name outside; parsing it never panics.
+func TestHegelPinBracedNameSameSummary(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v", r)
+		}
+	}()
+	fams, err := parseText("# TYPE a summary\n# TYPE b gauge\n{\"a\",x=\"y\",quantile=\"0.5\"} 1\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := len(fams["a"].GetMetric()); n != 1 {
+		t.Errorf("%d metrics", n)
+	}
+	fams, err = parseText("# TYPE a summary\n# TYPE b gauge\n{\"a_sum\"} 1\n{\"a_count\"} 2\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := len(fams["a"].GetMetric()); n != 1 {
+		t.Errorf("a_sum and a_count with the name in braces give %d metrics, want 1: %v", n, fams["a"])
+	}
+}
+
+// prometheus-common/10: a counter written as "unknown" (no _total suffix) gets no exemplar,
+// since OpenMetrics allows exemplars on counters and histogram buckets only.
+func TestHegelPinUnknownCounterHasNoExemplar(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("a"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		Counter: &dto.Counter{Value: proto.Float64(2), Exemplar: &dto.Exemplar{Value: proto.Float64(0.5), Label: []*dto.LabelPair{{Name: proto.String("t"), Value: proto.String("1")}}}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(b.String(), "# TYPE a unknown") && strings.Contains(b.String(), " # {") {
+		t.Errorf("an unknown-typed sample carries an exemplar:\n%s", b.String())
+	}
+}
diff --git a/expfmt/hegel_props_test.go b/expfmt/hegel_props_test.go
new file mode 100644
index 0000000..ed130e4
--- /dev/null
+++ b/expfmt/hegel_props_test.go
@@ -0,0 +1,827 @@
+package expfmt_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	dto "github.com/prometheus/client_model/go"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+	"hegel.dev/go/hegel"
+)
+
+func nsTime(ns int64) time.Time { return time.Unix(0, ns).UTC() }
+
+// parseText parses with a fresh parser under the scheme.
+func parseText(s string, scheme model.ValidationScheme) (map[string]*dto.MetricFamily, error) {
+	p := expfmt.NewTextParser(scheme)
+	return p.TextToMetricFamilies(strings.NewReader(s))
+}
+
+// sortedCanon canonicalises a parsed map in name order.
+func sortedCanon(m map[string]*dto.MetricFamily) []cFamily {
+	names := make([]string, 0, len(m))
+	for n := range m {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	out := make([]cFamily, 0, len(names))
+	for _, n := range names {
+		out = append(out, canonOf(m[n]))
+	}
+	return out
+}
+
+func sortFamilies(fs []cFamily) []cFamily {
+	cp := append([]cFamily{}, fs...)
+	sort.Slice(cp, func(i, j int) bool { return cp[i].Name < cp[j].Name })
+	return cp
+}
+
+func familiesEq(a, b []cFamily) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !familyEq(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// namesValid reports whether every metric and label name of the families passes the scheme.
+func namesValid(fs []cFamily, scheme model.ValidationScheme) bool {
+	for _, f := range fs {
+		if !scheme.IsValidMetricName(f.Name) {
+			return false
+		}
+		for _, m := range f.Metrics {
+			for _, l := range m.Labels {
+				if !scheme.IsValidLabelName(l.N) {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+// TestHegelParseFollowsTheFormat: generated families rendered by the model writer with the
+// freedom of the specification are parsed back to the same families (fresh and reused parser,
+// both validation schemes); mutated texts are either rejected with a ParseError or parsed to
+// something the package's own writer reproduces.
+func TestHegelParseFollowsTheFormat(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		o := genOpts{utf8: chance(ht, 50), floatCounts: chance(ht, 40), emptyFamily: true, timestamps: true, noBracedComplex: true}
+		fs := genFamilies(ht, o)
+		r := renderer{tc: ht, o: renderOpts{quoteLegacy: chance(ht, 30), interleave: chance(ht, 25)}}
+		text, want := r.render(fs)
+		scheme := model.UTF8Validation
+		if chance(ht, 30) {
+			scheme = model.LegacyValidation
+		}
+		valid := namesValid(fs, scheme)
+		got, err := parseText(text, scheme)
+		if !valid {
+			if err == nil {
+				c.failClass(ht, "legacy accept", "%s parser accepted UTF-8 names:\n%s", scheme, text)
+			} else {
+				c.count("legacy rejects")
+			}
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "reject", "parse error %v for the valid text:\n%s", err, text)
+			return
+		}
+		if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+			c.failClass(ht, "families", "parsed\n  %v\nwant\n  %v\ntext:\n%s", g, w, text)
+			return
+		}
+		for _, f := range got {
+			for _, m := range f.Metric {
+				if e := histogramConsistent(m.Histogram); e != nil {
+					c.failClass(ht, "histogram counts", "%v in:\n%s", e, text)
+					return
+				}
+			}
+		}
+		// a reused parser gives the same result
+		got2, err2 := reused.TextToMetricFamilies(strings.NewReader(text))
+		if err2 != nil || !familiesEq(sortedCanon(got2), sortedCanon(got)) {
+			c.failClass(ht, "reuse", "reused parser: err=%v, families %v, fresh %v", err2, sortedCanon(got2), sortedCanon(got))
+			return
+		}
+		// the decoder sees the same families
+		format := expfmt.FmtText.WithEscapingScheme(model.NoEscaping)
+		dec := expfmt.NewDecoder(strings.NewReader(text), format)
+		var decoded []cFamily
+		for {
+			var mf dto.MetricFamily
+			e := dec.Decode(&mf)
+			if e == io.EOF {
+				break
+			}
+			if e != nil {
+				c.failClass(ht, "decoder", "Decode: %v for:\n%s", e, text)
+				return
+			}
+			decoded = append(decoded, canonOf(&mf))
+		}
+		if !familiesEq(sortFamilies(decoded), sortedCanon(got)) {
+			c.failClass(ht, "decoder", "decoder families %v, parser %v", sortFamilies(decoded), sortedCanon(got))
+			return
+		}
+		c.count(fmt.Sprintf("families %d", len(want)))
+		if o.utf8 {
+			c.count("utf8 names")
+		}
+
+		// mutation
+		if chance(ht, 50) {
+			mut := mutate(ht, text)
+			if mut == text {
+				return
+			}
+			mgot, merr := parseText(mut, model.UTF8Validation)
+			if merr != nil {
+				var pe expfmt.ParseError
+				if !errors.As(merr, &pe) {
+					c.failClass(ht, "error type", "mutated text: error %T %v is not a ParseError", merr, merr)
+					return
+				}
+				lines := strings.Count(mut, "\n") + 1
+				if pe.Line < 1 || pe.Line > lines {
+					c.failClass(ht, "error line", "mutated text: line %d of %d in %v", pe.Line, lines, merr)
+					return
+				}
+				c.count("mutation rejected")
+				return
+			}
+			c.count("mutation accepted")
+			// what was accepted is written and read back unchanged
+			var b bytes.Buffer
+			names := make([]string, 0, len(mgot))
+			for n := range mgot {
+				names = append(names, n)
+			}
+			sort.Strings(names)
+			for _, n := range names {
+				if _, e := expfmt.MetricFamilyToText(&b, mgot[n]); e != nil {
+					c.failClass(ht, "write accepted", "MetricFamilyToText(%v): %v (from mutated text %q)", mgot[n], e, mut)
+					return
+				}
+			}
+			again, aerr := parseText(b.String(), model.UTF8Validation)
+			if aerr != nil {
+				c.failClass(ht, "reparse accepted", "the writer's output of an accepted text fails to parse: %v\nmutated: %q\nwritten: %q", aerr, mut, b.String())
+				return
+			}
+			var wantAgain []cFamily
+			for _, f := range sortedCanon(mgot) {
+				wantAgain = append(wantAgain, expectedAfterText(f))
+			}
+			if !familiesEq(sortedCanon(again), wantAgain) {
+				c.failClass(ht, "reparse accepted", "accepted text %q parses to %v, its rendering %q to %v", mut, sortedCanon(mgot), b.String(), sortedCanon(again))
+			}
+		}
+	})
+}
+
+// expectedAfterText is the canonical form the text writer + parser round trip must yield:
+// gauge histograms become histograms and a missing +Inf bucket is added with the count.
+func expectedAfterText(f cFamily) cFamily {
+	e := f
+	e.Metrics = nil
+	if e.Type == dto.MetricType_GAUGE_HISTOGRAM {
+		e.Type = dto.MetricType_HISTOGRAM
+	}
+	for _, m := range f.Metrics {
+		mm := m
+		if f.Type == dto.MetricType_HISTOGRAM || f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+			mm.Buckets = append([]cBucket{}, m.Buckets...)
+			inf := false
+			for _, b := range m.Buckets {
+				if math.IsInf(b.UB, 1) {
+					inf = true
+				}
+			}
+			if !inf {
+				mm.Buckets = append(mm.Buckets, cBucket{math.Inf(1), m.Count})
+			}
+		}
+		e.Metrics = append(e.Metrics, mm)
+	}
+	return e
+}
+
+// flatSamples turns a model.Vector into sorted "name{labels} value ts" strings.
+func flatSamples(v model.Vector) []string {
+	out := make([]string, 0, len(v))
+	for _, s := range v {
+		out = append(out, fmt.Sprintf("%s %s %d", s.Metric.String(), canonicalFloat(float64(s.Value)), int64(s.Timestamp)))
+	}
+	sort.Strings(out)
+	return out
+}
+
+// TestHegelTextRoundTrips: families written by MetricFamilyToText (and the text Encoder) are
+// parsed back to the same families, the byte count is right, ExtractSamples agrees before and
+// after, and every sample line is one extracted sample.
+func TestHegelTextRoundTrips(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts{utf8: chance(ht, 50), gaugeHist: true, floatCounts: chance(ht, 40), timestamps: true}
+		fs := genFamilies(ht, o)
+		floatWhole := chance(ht, 20)
+		var b bytes.Buffer
+		var want []cFamily
+		for _, f := range fs {
+			mf := toDTO(f, floatWhole)
+			before := b.Len()
+			n, err := expfmt.MetricFamilyToText(&b, mf)
+			if err != nil {
+				c.failClass(ht, "write", "MetricFamilyToText(%v): %v", f, err)
+				return
+			}
+			if n != b.Len()-before {
+				c.failClass(ht, "written", "MetricFamilyToText wrote %d bytes, reported %d", b.Len()-before, n)
+				return
+			}
+			want = append(want, expectedAfterText(f))
+			// the encoder for the text format writes the same bytes (names that need no escaping)
+			if namesValid([]cFamily{f}, model.LegacyValidation) {
+				var eb bytes.Buffer
+				enc := expfmt.NewEncoder(&eb, expfmt.FmtText)
+				if err := enc.Encode(mf); err != nil {
+					c.failClass(ht, "encoder", "Encode: %v", err)
+					return
+				}
+				if eb.String() != b.String()[before:] {
+					c.failClass(ht, "encoder", "Encoder wrote %q, MetricFamilyToText %q", eb.String(), b.String()[before:])
+					return
+				}
+			} else {
+				var eb bytes.Buffer
+				enc := expfmt.NewEncoder(&eb, expfmt.FmtText.WithEscapingScheme(model.NoEscaping))
+				if err := enc.Encode(mf); err != nil {
+					c.failClass(ht, "encoder", "Encode (UTF-8): %v", err)
+					return
+				}
+				if eb.String() != b.String()[before:] {
+					c.failClass(ht, "encoder utf8", "Encoder (allow-utf-8) wrote %q, MetricFamilyToText %q", eb.String(), b.String()[before:])
+					return
+				}
+			}
+		}
+		text := b.String()
+		got, err := parseText(text, model.UTF8Validation)
+		if err != nil {
+			c.failClass(ht, "reparse", "the writer's output does not parse: %v\n%s", err, text)
+			return
+		}
+		if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+			c.failClass(ht, "round trip", "parsed\n  %v\nwant\n  %v\ntext:\n%s", g, w, text)
+			return
+		}
+		for _, f := range got {
+			for _, m := range f.Metric {
+				if e := histogramConsistent(m.Histogram); e != nil {
+					c.failClass(ht, "histogram counts", "%v in:\n%s", e, text)
+					return
+				}
+			}
+		}
+		// samples: one per non-comment line, the same before and after
+		opts := &expfmt.DecodeOptions{}
+		var origDTO []*dto.MetricFamily
+		for _, f := range fs {
+			origDTO = append(origDTO, toDTO(f, floatWhole))
+		}
+		v1, err1 := expfmt.ExtractSamples(opts, origDTO...)
+		var parsedDTO []*dto.MetricFamily
+		for _, n := range sortedNames(got) {
+			parsedDTO = append(parsedDTO, got[n])
+		}
+		v2, err2 := expfmt.ExtractSamples(opts, parsedDTO...)
+		if err1 != nil || err2 != nil {
+			c.failClass(ht, "extract", "ExtractSamples: %v / %v", err1, err2)
+			return
+		}
+		s1, s2 := flatSamples(v1), flatSamples(v2)
+		if strings.Join(s1, "\n") != strings.Join(s2, "\n") {
+			c.failClass(ht, "extract", "samples before\n  %v\nafter\n  %v\ntext:\n%s", s1, s2, text)
+			return
+		}
+		lines := 0
+		for _, l := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+			if !strings.HasPrefix(l, "#") {
+				lines++
+			}
+		}
+		if lines != len(v1) {
+			c.failClass(ht, "sample lines", "%d sample lines, %d extracted samples\n%s", lines, len(v1), text)
+			return
+		}
+		// the sample decoder reads the same samples
+		sd := expfmt.SampleDecoder{Dec: expfmt.NewDecoder(strings.NewReader(text), expfmt.FmtText.WithEscapingScheme(model.NoEscaping)), Opts: opts}
+		var all model.Vector
+		for {
+			var vec model.Vector
+			e := sd.Decode(&vec)
+			if e == io.EOF {
+				break
+			}
+			if e != nil {
+				c.failClass(ht, "sample decoder", "SampleDecoder: %v", e)
+				return
+			}
+			all = append(all, vec...)
+		}
+		if s3 := flatSamples(all); strings.Join(s3, "\n") != strings.Join(s1, "\n") {
+			c.failClass(ht, "sample decoder", "SampleDecoder samples\n  %v\nExtractSamples\n  %v", s3, s1)
+			return
+		}
+		for _, f := range fs {
+			c.count("type " + f.Type.String())
+		}
+	})
+}
+
+func sortedNames(m map[string]*dto.MetricFamily) []string {
+	names := make([]string, 0, len(m))
+	for n := range m {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// omLine is a parsed OpenMetrics sample line of the writer's output (the model's reading).
+type omLine struct {
+	name     string
+	labels   string // the raw label text
+	value    string
+	ts       string
+	exemplar string
+}
+
+// splitOM splits the writer's output into lines by kind, checking the line grammar the
+// specification fixes (ordering of HELP/TYPE/UNIT, the EOF line, no empty lines).
+func splitOM(text string) (comments []string, samples []omLine, err error) {
+	if !strings.HasSuffix(text, "# EOF\n") {
+		return nil, nil, fmt.Errorf("missing # EOF")
+	}
+	for _, l := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+		if l == "" {
+			return nil, nil, fmt.Errorf("empty line")
+		}
+		if l == "# EOF" {
+			continue
+		}
+		if strings.HasPrefix(l, "# ") {
+			comments = append(comments, l)
+			continue
+		}
+		var s omLine
+		rest := l
+		if strings.HasPrefix(rest, "{") {
+			i := strings.Index(rest, "} ")
+			if i < 0 {
+				return nil, nil, fmt.Errorf("unterminated braces: %q", l)
+			}
+			s.name = ""
+			s.labels = rest[:i+1]
+			rest = rest[i+2:]
+		} else {
+			i := strings.IndexAny(rest, "{ ")
+			if i < 0 {
+				return nil, nil, fmt.Errorf("no value: %q", l)
+			}
+			s.name = rest[:i]
+			rest = rest[i:]
+			if strings.HasPrefix(rest, "{") {
+				j := strings.Index(rest, "} ")
+				if j < 0 {
+					return nil, nil, fmt.Errorf("unterminated braces: %q", l)
+				}
+				s.labels = rest[:j+1]
+				rest = rest[j+2:]
+			} else {
+				rest = rest[1:]
+			}
+		}
+		if i := strings.Index(rest, " # "); i >= 0 {
+			s.exemplar = rest[i+3:]
+			rest = rest[:i]
+		}
+		parts := strings.Split(rest, " ")
+		s.value = parts[0]
+		if len(parts) > 1 {
+			s.ts = parts[1]
+		}
+		if len(parts) > 2 {
+			return nil, nil, fmt.Errorf("too many tokens: %q", l)
+		}
+		samples = append(samples, s)
+	}
+	return comments, samples, nil
+}
+
+// TestHegelOpenMetricsIsWellFormed: MetricFamilyToOpenMetrics output has the line structure
+// the specification fixes, one sample line per sample with the right suffixes, integer counts,
+// floats with a point or exponent, timestamps in seconds, exemplars and created lines where
+// asked; the Encoder writes the same bytes and Close adds the EOF line; the package's own text
+// parser reads the output without exemplars/created lines back to the families.
+func TestHegelOpenMetricsIsWellFormed(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts{utf8: chance(ht, 30), gaugeHist: chance(ht, 20), omValid: true, timestamps: chance(ht, 50), openMetrics: true}
+		fs := genFamilies(ht, o)
+		created := chance(ht, 50)
+		var eopts []expfmt.EncoderOption
+		if created {
+			eopts = append(eopts, expfmt.WithCreatedLines())
+		}
+		var b, eb bytes.Buffer
+		enc := expfmt.NewEncoder(&eb, expfmt.FmtOpenMetrics_1_0_0.WithEscapingScheme(model.NoEscaping), eopts...)
+		for _, f := range fs {
+			mf := toDTO(f, false)
+			before := b.Len()
+			n, err := expfmt.MetricFamilyToOpenMetrics(&b, mf, eopts...)
+			if err != nil {
+				c.failClass(ht, "write", "MetricFamilyToOpenMetrics(%v): %v", f, err)
+				return
+			}
+			if n != b.Len()-before {
+				c.failClass(ht, "written", "wrote %d bytes, reported %d", b.Len()-before, n)
+				return
+			}
+			if err := enc.Encode(mf); err != nil {
+				c.failClass(ht, "encoder", "Encode: %v", err)
+				return
+			}
+		}
+		expfmt.FinalizeOpenMetrics(&b)
+		if err := enc.(expfmt.Closer).Close(); err != nil {
+			c.failClass(ht, "encoder", "Close: %v", err)
+			return
+		}
+		if eb.String() != b.String() {
+			c.failClass(ht, "encoder", "Encoder wrote\n%s\nMetricFamilyToOpenMetrics\n%s", eb.String(), b.String())
+			return
+		}
+		text := b.String()
+		comments, samples, err := splitOM(text)
+		if err != nil {
+			c.failClass(ht, "structure", "%v in:\n%s", err, text)
+			return
+		}
+		// expected sample lines
+		var want []string
+		for _, f := range fs {
+			base := f.Name
+			if f.Type == dto.MetricType_COUNTER && strings.HasSuffix(base, "_total") {
+				base = strings.TrimSuffix(base, "_total")
+			}
+			typ := map[dto.MetricType]string{dto.MetricType_COUNTER: "counter", dto.MetricType_GAUGE: "gauge", dto.MetricType_UNTYPED: "unknown", dto.MetricType_SUMMARY: "summary", dto.MetricType_HISTOGRAM: "histogram", dto.MetricType_GAUGE_HISTOGRAM: "gaugehistogram"}[f.Type]
+			if f.Type == dto.MetricType_COUNTER && !strings.HasSuffix(f.Name, "_total") {
+				typ = "unknown"
+			}
+			_ = typ
+			for _, m := range f.Metrics {
+				ts := ""
+				if m.TS != nil {
+					ts = canonicalOMFloat(float64(*m.TS) / 1000)
+				}
+				switch f.Type {
+				case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+					want = append(want, f.Name+" "+canonicalOMFloat(m.Value)+" "+ts)
+				case dto.MetricType_SUMMARY:
+					for _, q := range m.Quantiles {
+						want = append(want, f.Name+" "+canonicalOMFloat(q.V)+" "+ts)
+					}
+					want = append(want, f.Name+"_sum "+canonicalOMFloat(m.Sum)+" "+ts)
+					want = append(want, f.Name+"_count "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+				case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+					cnt, sum := "_count", "_sum"
+					if f.Type == dto.MetricType_GAUGE_HISTOGRAM && !Known.gaugeHistogramUsesCountSum {
+						cnt, sum = "_gcount", "_gsum"
+					}
+					inf := false
+					for _, bk := range m.Buckets {
+						want = append(want, f.Name+"_bucket "+fmt.Sprintf("%d", uint64(bk.C))+" "+ts)
+						if math.IsInf(bk.UB, 1) {
+							inf = true
+						}
+					}
+					if !inf {
+						want = append(want, f.Name+"_bucket "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+					}
+					want = append(want, f.Name+sum+" "+canonicalOMFloat(m.Sum)+" "+ts)
+					want = append(want, f.Name+cnt+" "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+				}
+				if created && m.Created != nil && f.Type != dto.MetricType_GAUGE && f.Type != dto.MetricType_UNTYPED {
+					cts := ts
+					if Known.createdLineLacksTimestamp {
+						cts = ""
+					}
+					want = append(want, base+"_created "+canonicalOMFloat(float64(*m.Created)/1e9)+" "+cts)
+				}
+			}
+		}
+		var got []string
+		for _, s := range samples {
+			name := s.name
+			if name == "" {
+				// quoted name inside the braces
+				name = unquoteFirst(s.labels)
+			}
+			got = append(got, name+" "+s.value+" "+s.ts)
+		}
+		sort.Strings(want)
+		sort.Strings(got)
+		if strings.Join(got, "\n") != strings.Join(want, "\n") {
+			c.failClass(ht, "sample lines", "lines\n  %v\nwant\n  %v\ntext:\n%s", got, want, text)
+			return
+		}
+		// comment lines: HELP, TYPE, UNIT per family in that order, names as the type demands
+		wantComments := 0
+		for _, f := range fs {
+			if f.HasHelp {
+				wantComments++
+			}
+			wantComments++
+			if f.Unit != "" {
+				wantComments++
+			}
+		}
+		if len(comments) != wantComments {
+			c.failClass(ht, "comments", "%d comment lines, want %d:\n%s", len(comments), wantComments, text)
+			return
+		}
+		// exemplars: written iff present with labels (Known.exemplarWithoutLabelsDropped)
+		wantEx := 0
+		for _, f := range fs {
+			for _, m := range f.Metrics {
+				exs := append([]*cExemplar{m.Exemplar}, m.BucketExemplars...)
+				for _, e := range exs {
+					if e != nil && (len(e.Labels) > 0 || !Known.exemplarWithoutLabelsDropped) {
+						wantEx++
+					}
+				}
+			}
+		}
+		gotEx := 0
+		for _, s := range samples {
+			if s.exemplar != "" {
+				gotEx++
+				parts := strings.SplitN(s.exemplar, "} ", 2)
+				if len(parts) != 2 || !strings.HasPrefix(parts[0], "{") {
+					c.failClass(ht, "exemplar", "exemplar %q lacks a label set", s.exemplar)
+					return
+				}
+				toks := strings.Split(parts[1], " ")
+				if len(toks) > 2 || !omFloatOK(toks[0]) || (len(toks) == 2 && !omFloatOK(toks[1])) {
+					c.failClass(ht, "exemplar", "exemplar %q: bad value or timestamp", s.exemplar)
+					return
+				}
+			}
+		}
+		if gotEx != wantEx {
+			c.failClass(ht, "exemplar", "%d exemplars written, want %d:\n%s", gotEx, wantEx, text)
+			return
+		}
+		// every value and timestamp is a float with a point or an exponent, or a whole count
+		for _, s := range samples {
+			if !omFloatOK(s.value) && !isDigits(s.value) {
+				c.failClass(ht, "float", "value %q in %q", s.value, text)
+				return
+			}
+			if s.ts != "" && !omFloatOK(s.ts) {
+				c.failClass(ht, "float", "timestamp %q", s.ts)
+				return
+			}
+		}
+		// the package's own text parser reads a plain output (no exemplars, timestamps or
+		// created lines) back to the families, gauge histograms and _total aside
+		plain := !created && !o.timestamps
+		for _, f := range fs {
+			for _, m := range f.Metrics {
+				if m.Exemplar != nil {
+					plain = false
+				}
+				for _, e := range m.BucketExemplars {
+					if e != nil {
+						plain = false
+					}
+				}
+			}
+			// (counters are written with _total moved to the samples, or as "unknown", a type
+			// the text format does not have)
+			if f.Type == dto.MetricType_GAUGE_HISTOGRAM || f.Type == dto.MetricType_COUNTER || f.Type == dto.MetricType_UNTYPED {
+				plain = false
+			}
+		}
+		if plain {
+			got, err := parseText(text, model.UTF8Validation)
+			if err != nil {
+				c.failClass(ht, "text parse", "the text parser rejects plain OpenMetrics output: %v\n%s", err, text)
+				return
+			}
+			var want []cFamily
+			for _, f := range fs {
+				e := expectedAfterText(f)
+				e.Unit = ""
+				want = append(want, e)
+			}
+			if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+				c.failClass(ht, "text parse", "text parser reads\n  %v\nwant\n  %v\n%s", g, w, text)
+				return
+			}
+			c.count("text parser reads OM")
+		}
+		for _, f := range fs {
+			c.count("type " + f.Type.String())
+		}
+		if created {
+			c.count("created lines")
+		}
+	})
+}
+
+func canonicalOMFloat(v float64) string {
+	s := canonicalFloat(v)
+	if !strings.ContainsAny(s, "e.") && !math.IsNaN(v) && !math.IsInf(v, 0) {
+		s += ".0"
+	}
+	return s
+}
+
+func omFloatOK(s string) bool {
+	if s == "NaN" || s == "+Inf" || s == "-Inf" {
+		return true
+	}
+	if !strings.ContainsAny(s, "e.") {
+		return false
+	}
+	_, err := parseFloatStrict(s)
+	return err == nil
+}
+
+func parseFloatStrict(s string) (float64, error) {
+	if strings.ContainsAny(s, "pP_xX") {
+		return 0, fmt.Errorf("bad float")
+	}
+	var f float64
+	_, err := fmt.Sscanf(s, "%g", &f)
+	return f, err
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// unquoteFirst extracts the quoted metric name at the start of a brace group.
+func unquoteFirst(braces string) string {
+	s := strings.TrimPrefix(braces, "{")
+	if !strings.HasPrefix(s, `"`) {
+		return ""
+	}
+	var b strings.Builder
+	esc := false
+	for _, r := range s[1:] {
+		if esc {
+			switch r {
+			case 'n':
+				b.WriteRune('\n')
+			default:
+				b.WriteRune(r)
+			}
+			esc = false
+			continue
+		}
+		if r == '\\' {
+			esc = true
+			continue
+		}
+		if r == '"' {
+			break
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// TestHegelNegotiationReturnsWhatWasAsked: the Format helpers and content negotiation.
+func TestHegelNegotiationReturnsWhatWasAsked(t *testing.T) {
+	c := newCollector(t)
+	formats := []expfmt.Format{expfmt.FmtText, expfmt.FmtProtoDelim, expfmt.FmtProtoText, expfmt.FmtProtoCompact, expfmt.FmtOpenMetrics_1_0_0, expfmt.FmtOpenMetrics_0_0_1}
+	types := []expfmt.FormatType{expfmt.TypeProtoCompact, expfmt.TypeProtoDelim, expfmt.TypeProtoText, expfmt.TypeTextPlain, expfmt.TypeOpenMetrics}
+	schemes := []model.EscapingScheme{model.NoEscaping, model.UnderscoreEscaping, model.DotsEscaping, model.ValueEncodingEscaping}
+	property(t, func(ht *hegel.T) {
+		// NewFormat inverts FormatType
+		ft := pick(ht, types)
+		if got := expfmt.NewFormat(ft).FormatType(); got != ft {
+			c.failClass(ht, "newformat", "NewFormat(%v).FormatType() = %v", ft, got)
+			return
+		}
+		// escaping scheme round trip keeps the type
+		f := pick(ht, formats)
+		s := pick(ht, schemes)
+		g := f.WithEscapingScheme(s)
+		if g.ToEscapingScheme() != s {
+			c.failClass(ht, "escaping", "%q.WithEscapingScheme(%v) = %q, ToEscapingScheme %v", f, s, g, g.ToEscapingScheme())
+			return
+		}
+		if g.FormatType() != f.FormatType() {
+			c.failClass(ht, "escaping type", "%q has type %v, %q has %v", f, f.FormatType(), g, g.FormatType())
+			return
+		}
+		s2 := pick(ht, schemes)
+		if h := g.WithEscapingScheme(s2); h.ToEscapingScheme() != s2 || strings.Count(string(h), "escaping=") != 1 {
+			c.failClass(ht, "escaping twice", "%q.WithEscapingScheme(%v) = %q", g, s2, h)
+			return
+		}
+		// negotiation: an Accept header naming an accepted format gets it
+		accepted := make([]expfmt.Format, 0, 3)
+		for i := drawInt(ht, 1, 3); i > 0; i-- {
+			accepted = append(accepted, pick(ht, formats))
+		}
+		asked := pick(ht, accepted)
+		h := http.Header{}
+		acceptHeader := string(asked)
+		if chance(ht, 30) {
+			acceptHeader = strings.ReplaceAll(acceptHeader, "; charset=utf-8", "")
+		}
+		if chance(ht, 30) {
+			acceptHeader += ";q=0.9"
+		}
+		if chance(ht, 30) {
+			acceptHeader = "image/png, " + acceptHeader
+		}
+		h.Set("Accept", acceptHeader)
+		got := expfmt.NegotiateAccept(h, accepted...)
+		if got.FormatType() != asked.FormatType() || !strings.HasPrefix(string(got), string(asked)) {
+			c.failClass(ht, "negotiate", "Accept %q with %v: got %q, want %q", acceptHeader, accepted, got, asked)
+			return
+		}
+		if got.ToEscapingScheme() != model.NameEscapingScheme {
+			c.failClass(ht, "negotiate escaping", "Accept %q: escaping %v, want the default %v", acceptHeader, got.ToEscapingScheme(), model.NameEscapingScheme)
+			return
+		}
+		// an escaping parameter in the header is echoed
+		h.Set("Accept", string(asked)+"; escaping="+s.String())
+		got = expfmt.NegotiateAccept(h, accepted...)
+		if got.ToEscapingScheme() != s && s != model.NoEscaping {
+			c.failClass(ht, "negotiate escaping", "Accept with escaping=%v: got %q", s, got)
+			return
+		}
+		// no match: the text format if accepted, else the first
+		h.Set("Accept", "image/png")
+		got = expfmt.NegotiateAccept(h, accepted...)
+		wantFallback := accepted[0]
+		for _, a := range accepted {
+			if a.FormatType() == expfmt.TypeTextPlain {
+				wantFallback = a
+				break
+			}
+		}
+		if !strings.HasPrefix(string(got), string(wantFallback)) {
+			c.failClass(ht, "fallback", "Accept image/png with %v: got %q, want %q", accepted, got, wantFallback)
+			return
+		}
+		// ResponseFormat recognises what the text and proto encoders label their output with
+		rh := http.Header{}
+		rh.Set("Content-Type", string(g))
+		rf := expfmt.ResponseFormat(rh)
+		switch f.FormatType() {
+		case expfmt.TypeTextPlain, expfmt.TypeProtoDelim:
+			if rf.FormatType() != f.FormatType() {
+				c.failClass(ht, "response", "ResponseFormat(%q) = %q", g, rf)
+				return
+			}
+		}
+		c.count(fmt.Sprintf("format %d", f.FormatType()))
+	})
+}
