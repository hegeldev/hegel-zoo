--- /dev/null
+++ b/expfmt/hegel_model_test.go
@@ -0,0 +1,1189 @@
+package expfmt_test
+
+// The model: a canonical form of a metric family (cFamily), a grammar of families built once
+// per option set (generator values), a converter to the dto proto messages, a canonicaliser of
+// dto messages, and a model writer that renders canonical families to the text exposition
+// format with the freedom the specification allows, as a pure function of the families, a style
+// record and a drawn tape.
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+
+	dto "github.com/prometheus/client_model/go"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/prometheus/common/model"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- canonical form
+
+type cLabel struct{ N, V string }
+
+type cQuant struct{ Q, V float64 }
+
+type cBucket struct{ UB, C float64 }
+
+type cExemplar struct {
+	Labels []cLabel
+	Value  float64
+	TS     *int64 // nanoseconds
+}
+
+type cMetric struct {
+	Labels []cLabel
+	TS     *int64 // milliseconds
+	// counter, gauge, untyped
+	Value float64
+	// summary and histogram
+	Count     float64
+	Sum       float64
+	Quantiles []cQuant
+	Buckets   []cBucket
+	// OpenMetrics extras
+	Exemplar        *cExemplar   // counter
+	BucketExemplars []*cExemplar // histogram, parallel to Buckets
+	Created         *int64       // nanoseconds
+}
+
+type cFamily struct {
+	Name    string
+	Help    string
+	HasHelp bool
+	Unit    string
+	Type    dto.MetricType
+	Metrics []cMetric
+}
+
+func feq(a, b float64) bool { return a == b || (math.IsNaN(a) && math.IsNaN(b)) }
+
+func i64eq(a, b *int64) bool { return (a == nil && b == nil) || (a != nil && b != nil && *a == *b) }
+
+func labelsEq(a, b []cLabel) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func metricEq(a, b cMetric) bool {
+	if !labelsEq(a.Labels, b.Labels) || !i64eq(a.TS, b.TS) || !feq(a.Value, b.Value) || !feq(a.Count, b.Count) || !feq(a.Sum, b.Sum) {
+		return false
+	}
+	if len(a.Quantiles) != len(b.Quantiles) || len(a.Buckets) != len(b.Buckets) {
+		return false
+	}
+	for i := range a.Quantiles {
+		if !feq(a.Quantiles[i].Q, b.Quantiles[i].Q) || !feq(a.Quantiles[i].V, b.Quantiles[i].V) {
+			return false
+		}
+	}
+	for i := range a.Buckets {
+		if !feq(a.Buckets[i].UB, b.Buckets[i].UB) || !feq(a.Buckets[i].C, b.Buckets[i].C) {
+			return false
+		}
+	}
+	return true
+}
+
+func familyEq(a, b cFamily) bool {
+	if a.Name != b.Name || a.HasHelp != b.HasHelp || (a.HasHelp && a.Help != b.Help) || a.Type != b.Type || len(a.Metrics) != len(b.Metrics) {
+		return false
+	}
+	for i := range a.Metrics {
+		if !metricEq(a.Metrics[i], b.Metrics[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (f cFamily) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s %s help=%v/%q", f.Name, f.Type, f.HasHelp, f.Help)
+	for _, m := range f.Metrics {
+		fmt.Fprintf(&b, " [%v ts=%v v=%v count=%v sum=%v q=%v b=%v]", m.Labels, ptrStr(m.TS), m.Value, m.Count, m.Sum, m.Quantiles, m.Buckets)
+	}
+	return b.String()
+}
+
+func ptrStr(p *int64) string {
+	if p == nil {
+		return "-"
+	}
+	return strconv.FormatInt(*p, 10)
+}
+
+func isComplex(t dto.MetricType) bool {
+	return t == dto.MetricType_SUMMARY || t == dto.MetricType_HISTOGRAM || t == dto.MetricType_GAUGE_HISTOGRAM
+}
+
+// canonOf turns a dto family into the canonical form, using the effective values the writers
+// use (a float count if non-zero, else the integer one).
+func canonOf(mf *dto.MetricFamily) cFamily {
+	f := cFamily{Name: mf.GetName(), Type: mf.GetType(), Unit: mf.GetUnit()}
+	if mf.Help != nil {
+		f.HasHelp, f.Help = true, mf.GetHelp()
+	}
+	for _, m := range mf.Metric {
+		c := cMetric{TS: m.TimestampMs}
+		for _, l := range m.Label {
+			c.Labels = append(c.Labels, cLabel{l.GetName(), l.GetValue()})
+		}
+		switch mf.GetType() {
+		case dto.MetricType_COUNTER:
+			c.Value = m.GetCounter().GetValue()
+		case dto.MetricType_GAUGE:
+			c.Value = m.GetGauge().GetValue()
+		case dto.MetricType_UNTYPED:
+			c.Value = m.GetUntyped().GetValue()
+		case dto.MetricType_SUMMARY:
+			s := m.GetSummary()
+			c.Count, c.Sum = float64(s.GetSampleCount()), s.GetSampleSum()
+			for _, q := range s.Quantile {
+				c.Quantiles = append(c.Quantiles, cQuant{q.GetQuantile(), q.GetValue()})
+			}
+		case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+			h := m.GetHistogram()
+			c.Count = h.GetSampleCountFloat()
+			if c.Count == 0 {
+				c.Count = float64(h.GetSampleCount())
+			}
+			c.Sum = h.GetSampleSum()
+			for _, b := range h.Bucket {
+				v := b.GetCumulativeCountFloat()
+				if v == 0 {
+					v = float64(b.GetCumulativeCount())
+				}
+				c.Buckets = append(c.Buckets, cBucket{b.GetUpperBound(), v})
+			}
+		}
+		f.Metrics = append(f.Metrics, c)
+	}
+	return f
+}
+
+// histogramConsistent checks the promise of the parser: the counts of a parsed histogram are
+// all integers or all floats, floats being used iff some count is not a whole number.
+func histogramConsistent(h *dto.Histogram) error {
+	if h == nil {
+		return nil
+	}
+	anyFloatField := h.SampleCountFloat != nil
+	anyIntField := h.SampleCount != nil
+	fractional := h.GetSampleCountFloat() != math.Trunc(h.GetSampleCountFloat())
+	for _, b := range h.Bucket {
+		anyFloatField = anyFloatField || b.CumulativeCountFloat != nil
+		anyIntField = anyIntField || b.CumulativeCount != nil
+		if b.GetCumulativeCountFloat() != math.Trunc(b.GetCumulativeCountFloat()) {
+			fractional = true
+		}
+	}
+	if anyFloatField && anyIntField {
+		return fmt.Errorf("mixed integer and float counts: %v", h)
+	}
+	if anyFloatField && !fractional {
+		return fmt.Errorf("float counts without a fractional value: %v", h)
+	}
+	return nil
+}
+
+// toDTO converts a canonical family to the proto message. Integral counts go to the integer
+// fields, others to the float fields (a whole float count is put in the float field when
+// floatWhole is set, to exercise the writer's fallback).
+func toDTO(f cFamily, floatWhole bool) *dto.MetricFamily {
+	mf := &dto.MetricFamily{Name: proto.String(f.Name), Type: f.Type.Enum()}
+	if f.HasHelp {
+		mf.Help = proto.String(f.Help)
+	}
+	if f.Unit != "" {
+		mf.Unit = proto.String(f.Unit)
+	}
+	for _, c := range f.Metrics {
+		m := &dto.Metric{TimestampMs: c.TS}
+		for _, l := range c.Labels {
+			m.Label = append(m.Label, &dto.LabelPair{Name: proto.String(l.N), Value: proto.String(l.V)})
+		}
+		var created *timestamppb.Timestamp
+		if c.Created != nil {
+			created = timestamppb.New(nsTime(*c.Created))
+		}
+		switch f.Type {
+		case dto.MetricType_COUNTER:
+			m.Counter = &dto.Counter{Value: proto.Float64(c.Value), CreatedTimestamp: created, Exemplar: exemplarDTO(c.Exemplar)}
+		case dto.MetricType_GAUGE:
+			m.Gauge = &dto.Gauge{Value: proto.Float64(c.Value)}
+		case dto.MetricType_UNTYPED:
+			m.Untyped = &dto.Untyped{Value: proto.Float64(c.Value)}
+		case dto.MetricType_SUMMARY:
+			s := &dto.Summary{SampleCount: proto.Uint64(uint64(c.Count)), SampleSum: proto.Float64(c.Sum), CreatedTimestamp: created}
+			for _, q := range c.Quantiles {
+				s.Quantile = append(s.Quantile, &dto.Quantile{Quantile: proto.Float64(q.Q), Value: proto.Float64(q.V)})
+			}
+			m.Summary = s
+		case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+			h := &dto.Histogram{SampleSum: proto.Float64(c.Sum), CreatedTimestamp: created}
+			if c.Count == math.Trunc(c.Count) && !floatWhole {
+				h.SampleCount = proto.Uint64(uint64(c.Count))
+			} else {
+				h.SampleCountFloat = proto.Float64(c.Count)
+			}
+			for i, b := range c.Buckets {
+				db := &dto.Bucket{UpperBound: proto.Float64(b.UB)}
+				if b.C == math.Trunc(b.C) && !floatWhole {
+					db.CumulativeCount = proto.Uint64(uint64(b.C))
+				} else {
+					db.CumulativeCountFloat = proto.Float64(b.C)
+				}
+				if i < len(c.BucketExemplars) {
+					db.Exemplar = exemplarDTO(c.BucketExemplars[i])
+				}
+				h.Bucket = append(h.Bucket, db)
+			}
+			m.Histogram = h
+		}
+		mf.Metric = append(mf.Metric, m)
+	}
+	return mf
+}
+
+func exemplarDTO(e *cExemplar) *dto.Exemplar {
+	if e == nil {
+		return nil
+	}
+	d := &dto.Exemplar{Value: proto.Float64(e.Value)}
+	for _, l := range e.Labels {
+		d.Label = append(d.Label, &dto.LabelPair{Name: proto.String(l.N), Value: proto.String(l.V)})
+	}
+	if e.TS != nil {
+		d.Timestamp = timestamppb.New(nsTime(*e.TS))
+	}
+	return d
+}
+
+// --------------------------------------------------------------------------- pools
+
+var legacyNames = []string{"a", "http_requests_total", "node_cpu:rate5m", "_x", "Z9", "go_gc_duration_seconds", "b_total", "up", "process_start_time_seconds", "x1", "y2", "z3", "req_seconds", "foo_bytes"}
+
+var utf8Names = []string{"a.b", "http requests", "métrique", "a\"q", "x\\y", "名前", "with,comma", "br{ace}", "eq=ual", "1starts_digit", "a\nb", "sp ace.total"}
+
+var legacyLabelNames = []string{"a", "b", "c", "instance", "job", "code", "_l", "L9", "method"}
+
+var utf8LabelNames = []string{"a.b", "label name", "läbel", "q\"uote", "back\\slash", "5x", "x,y"}
+
+var labelValues = []string{"", "x", "v1", "x\"y", "a\\b", "line\nbreak", "üñí", "\U0001F642", "\t", "}", ",", "=", "1.5", "# not a comment", "a\\nb", "\\", "\"", "  spaced  "}
+
+var helpTexts = []string{"help", "Total number of requests.", "with \\ backslash", "two\nlines", "quote \" inside", "unicode éà", "tab\there", "ends with backslash \\", "\\n literal"}
+
+var someValues = []float64{0, 1, -1, 2, 42, -7, 0.5, 1.5, 123.456, 1e6, 1e21, 1e-7, 9007199254740992, -2.5e-3, math.Inf(1), math.Inf(-1), math.NaN(), 3.141592653589793, 100000, 12345678901234}
+
+// badCounts: summary counts that are not non-negative whole numbers (the shape of
+// prometheus-common/1: the parser must reject them, as it rejects a histogram's).
+var badCounts = []float64{-1, 1.5, -7, 0.5, 2.5, -1000000, math.NaN(), math.Inf(1)}
+
+var standardQuantiles = []float64{0.5, 0.9, 0.99, 0.01, 0, 1}
+
+var upperBounds = []float64{0.005, 0.01, 0.1, 0.5, 1, 2.5, 10, 100, 1e6, -1, 0, 1.5}
+
+var metricTypes = []dto.MetricType{dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED, dto.MetricType_SUMMARY, dto.MetricType_HISTOGRAM}
+
+var (
+	legacyName      = hegel.SampledFrom(legacyNames)
+	utf8Name        = hegel.SampledFrom(utf8Names)
+	legacyLabelName = hegel.SampledFrom(legacyLabelNames)
+	utf8LabelName   = hegel.SampledFrom(utf8LabelNames)
+	labelValue      = hegel.SampledFrom(labelValues)
+	helpText        = hegel.SampledFrom(helpTexts)
+	tableValue      = hegel.SampledFrom(someValues)
+	// ratioValue: a bounded integer over a small denominator.
+	ratioValue = hegel.Map(pairs(hegel.Integers(-1000000, 1000000), hegel.SampledFrom([]int{1, 1, 3, 100, 7})), func(p pair[int, int]) float64 {
+		return float64(p.a) / float64(p.b)
+	})
+	// values: a sample value, from the table 70% of the time.
+	values = weighted(choice[float64]{70, tableValue}, choice[float64]{30, ratioValue})
+	// finiteValues: values with NaN and the infinities replaced by 0.5 (exemplar values).
+	finiteValues = hegel.Map(values, func(v float64) float64 {
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			return 0.5
+		}
+		return v
+	})
+	// counts: a non-negative whole count below 2^53: zero, small, medium or one of the large ones.
+	counts = weighted(
+		choice[float64]{1, hegel.Just(0.0)},
+		choice[float64]{1, asFloat(hegel.Integers(1, 20))},
+		choice[float64]{1, asFloat(hegel.Integers(0, 1<<30))},
+		choice[float64]{1, hegel.SampledFrom([]float64{1 << 40, 1<<53 - 1, 4503599627370496, 999999999999})},
+	)
+	// halves: a fractional part for OpenMetrics counters and buckets.
+	halves = hegel.SampledFrom([]float64{0, 0.5, 0.25})
+	// omValues: a non-negative fractional value (an OpenMetrics-valid sum).
+	omValues = hegel.Map(counts, func(c float64) float64 { return c + 0.5 })
+	// tsValues: a millisecond timestamp, never zero.
+	tsValues = hegel.Map(hegel.Integers(int64(-1000), int64(2000000000000)), func(ts int64) int64 {
+		if ts == 0 {
+			return 1
+		}
+		return ts
+	})
+	// seconds and millis of a created or exemplar timestamp, in nanoseconds.
+	secondsNS = hegel.Map(hegel.Integers(int64(1), int64(2000000000)), func(s int64) int64 { return s * 1000000000 })
+	millisNS  = hegel.Map(hegel.Integers(int64(0), int64(999)), func(ms int64) int64 { return ms * 1000000 })
+	// createdNS: whole seconds, with milliseconds half of the time.
+	createdNS = hegel.Map(pairs(secondsNS, maybe(50, millisNS)), func(p pair[int64, int64]) int64 { return p.a + p.b })
+	// exemplarNS: seconds and milliseconds.
+	exemplarNS = hegel.Map(pairs(secondsNS, millisNS), func(p pair[int64, int64]) int64 { return p.a + p.b })
+	// exemplar labels: no quotes or backslashes in the values, since the reference parser's
+	// exemplar grammar does not read escapes.
+	exemplarLabel = hegel.Map(pairs(hegel.SampledFrom([]string{"trace_id", "span_id", "t"}), hegel.SampledFrom([]string{"abc123", "x", "1", "d q"})), func(p pair[string, string]) cLabel {
+		return cLabel{p.a, p.b}
+	})
+	units = hegel.SampledFrom([]string{"seconds", "bytes", "total"})
+)
+
+func asFloat(g hegel.Generator[int]) hegel.Generator[float64] {
+	return hegel.Map(g, func(n int) float64 { return float64(n) })
+}
+
+func distinctLabels(ls []cLabel) []cLabel {
+	return distinctBy(ls, func(l cLabel) string { return l.N })
+}
+
+func labelKey(ls []cLabel) string {
+	cp := append([]cLabel{}, ls...)
+	sort.Slice(cp, func(i, j int) bool { return cp[i].N < cp[j].N })
+	return fmt.Sprint(cp)
+}
+
+// --------------------------------------------------------------------------- grammar
+
+// genOpts shapes the grammar of families; a grammar is built once per option set.
+type genOpts struct {
+	utf8        bool // UTF-8 metric and label names allowed
+	gaugeHist   bool // gauge histograms among the types (when types is nil)
+	floatCounts bool // fractional histogram counts allowed
+	emptyFamily bool // families without metrics allowed
+	omValid     bool // OpenMetrics constraints: monotone buckets, quantiles in [0,1], non-negative sums; counters get _total totalPct percent of the time
+	timestamps  bool // sample timestamps, on 30% of the metrics
+	openMetrics bool // exemplars, created timestamps, units
+	// summaries and histograms get legacy names while Known.bracedNameUsesPreviousFamily (their
+	// sample lines are never written with the name inside the braces then)
+	noBracedComplex bool
+	// hostile: the shapes of the recorded parser bugs that make a text invalid, so that the
+	// parser must reject it: summary counts that are negative or fractional
+	// (prometheus-common/1) and NaN quantiles and upper bounds (prometheus-common/8); each is
+	// left out while its Known switch is on
+	hostile bool
+	// the narrow properties' knobs
+	types             []dto.MetricType // the types drawn (nil: the five plain ones, plus gauge histograms when gaugeHist)
+	totalPct          int              // omValid: percentage of counters named _total
+	allTimestamps     bool             // every metric carries a timestamp
+	allExemplars      bool             // openMetrics: every counter and bucket carries an exemplar
+	noExemplars       bool             // openMetrics: no exemplars at all
+	bareExemplars     bool             // openMetrics: exemplars carry no labels
+	labelledExemplars bool             // openMetrics: exemplars carry at least one label
+	allCreated        bool             // openMetrics: every counter, summary and histogram carries a created timestamp
+}
+
+// labelsOf: up to three distinct labels, with UTF-8 names 30% of the time when allowed.
+func labelsOf(utf8 bool) hegel.Generator[[]cLabel] {
+	names := legacyLabelName
+	if utf8 {
+		names = weighted(choice[string]{70, legacyLabelName}, choice[string]{30, utf8LabelName})
+	}
+	label := hegel.Map(pairs(names, labelValue), func(p pair[string, string]) cLabel { return cLabel{p.a, p.b} })
+	return hegel.Map(hegel.Lists(label).MaxSize(3), distinctLabels)
+}
+
+// exemplarsOf: an exemplar with a finite value, up to two distinct labels (at least one under
+// HEGEL_NO_KNOWN=1, the shape of prometheus-common/5 being label-less exemplars; none when
+// bare) and a timestamp half of the time.
+func exemplarsOf(o genOpts) hegel.Generator[*cExemplar] {
+	labels := hegel.Map(hegel.Lists(exemplarLabel).MaxSize(2), distinctLabels)
+	if Known.exemplarWithoutLabelsDropped || o.labelledExemplars {
+		labels = hegel.Map(hegel.Lists(exemplarLabel).MinSize(1).MaxSize(2), distinctLabels)
+	}
+	if o.bareExemplars {
+		labels = hegel.Just[[]cLabel](nil)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) *cExemplar {
+		return &cExemplar{Value: hegel.Draw(tc, finiteValues), Labels: hegel.Draw(tc, labels), TS: hegel.Draw(tc, optional(50, exemplarNS))}
+	})
+}
+
+// exemplarSlots: an exemplar pct percent of the time (always when allExemplars), none otherwise.
+func exemplarSlots(o genOpts, pct int) hegel.Generator[*cExemplar] {
+	if !o.openMetrics || o.noExemplars {
+		return hegel.Just[*cExemplar](nil)
+	}
+	if o.allExemplars {
+		return exemplarsOf(o)
+	}
+	return maybe(pct, exemplarsOf(o))
+}
+
+// bucketSpec: a histogram bucket as drawn; under omValid the upper bound is the bucket's
+// index plus half, and the counts are made cumulative, when the metric is built.
+type bucketSpec struct {
+	ub   float64
+	half bool
+	cnt  float64
+	ex   *cExemplar
+}
+
+// metricOf: a metric of the type under the options.
+func metricOf(o genOpts, t dto.MetricType) hegel.Generator[cMetric] {
+	labels := labelsOf(o.utf8)
+	ts := hegel.Just[*int64](nil)
+	switch {
+	case o.allTimestamps:
+		ts = ptrs(tsValues)
+	case o.timestamps:
+		ts = optional(30, tsValues)
+	}
+	created := hegel.Just[*int64](nil)
+	if o.openMetrics && t != dto.MetricType_GAUGE && t != dto.MetricType_UNTYPED {
+		created = optional(30, createdNS)
+		if o.allCreated {
+			created = ptrs(createdNS)
+		}
+	}
+	// the OpenMetrics _created line of a metric with a timestamp lacks it (prometheus-common/4):
+	// under HEGEL_NO_KNOWN=1 a metric with a created timestamp carries no sample timestamp
+	fixCreated := func(m cMetric) cMetric {
+		if Known.createdLineLacksTimestamp && m.TS != nil {
+			m.Created = nil
+		}
+		return m
+	}
+	switch t {
+	case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+		value := values
+		if o.omValid && t == dto.MetricType_COUNTER {
+			value = hegel.Map(pairs(counts, halves), func(p pair[float64, float64]) float64 { return p.a + p.b })
+		}
+		exemplar := hegel.Just[*cExemplar](nil)
+		if t == dto.MetricType_COUNTER {
+			exemplar = exemplarSlots(o, 40)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cMetric {
+			return fixCreated(cMetric{Labels: hegel.Draw(tc, labels), TS: hegel.Draw(tc, ts), Value: hegel.Draw(tc, value), Exemplar: hegel.Draw(tc, exemplar), Created: hegel.Draw(tc, created)})
+		})
+	case dto.MetricType_SUMMARY:
+		count, sum, quantileValue := counts, values, values
+		if o.omValid {
+			sum, quantileValue = omValues, hegel.Map(counts, math.Abs)
+		}
+		if o.hostile && !Known.summaryCountUnchecked {
+			count = weighted(choice[float64]{80, counts}, choice[float64]{20, hegel.SampledFrom(badCounts)})
+		}
+		quantile := hegel.SampledFrom(standardQuantiles)
+		if !o.omValid {
+			// any finite quantile too (the parser keeps whatever it reads)
+			finite := hegel.Map(values, func(v float64) float64 {
+				if math.IsNaN(v) || math.IsInf(v, 0) {
+					return 0.5
+				}
+				return v
+			})
+			quantile = weighted(choice[float64]{80, hegel.SampledFrom(standardQuantiles)}, choice[float64]{20, finite})
+			if o.hostile && !Known.lineWithoutQuantileDropped {
+				quantile = weighted(choice[float64]{75, hegel.SampledFrom(standardQuantiles)}, choice[float64]{20, finite}, choice[float64]{5, hegel.Just(math.NaN())})
+			}
+		}
+		quant := hegel.Map(pairs(quantile, quantileValue), func(p pair[float64, float64]) cQuant { return cQuant{p.a, p.b} })
+		var quantiles hegel.Generator[[]cQuant] = hegel.Lists(quant).MaxSize(3)
+		if o.omValid {
+			quantiles = hegel.Map(quantiles, func(qs []cQuant) []cQuant {
+				return distinctBy(qs, func(q cQuant) string { return canonicalFloat(q.Q) })
+			})
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cMetric {
+			return fixCreated(cMetric{Labels: hegel.Draw(tc, labels), TS: hegel.Draw(tc, ts), Count: hegel.Draw(tc, count), Sum: hegel.Draw(tc, sum), Quantiles: hegel.Draw(tc, quantiles), Created: hegel.Draw(tc, created)})
+		})
+	}
+	// histograms
+	sum := values
+	if o.omValid {
+		sum = omValues
+	}
+	ubs := hegel.SampledFrom(upperBounds)
+	if o.hostile && !Known.lineWithoutQuantileDropped {
+		ubs = weighted(choice[float64]{95, hegel.SampledFrom(upperBounds)}, choice[float64]{5, hegel.Just(math.NaN())})
+	}
+	fraction := hegel.Just(0.0)
+	if o.floatCounts {
+		fraction = maybe(30, hegel.Just(0.5))
+	}
+	countFraction := hegel.Just(0.0)
+	if o.floatCounts {
+		countFraction = maybe(20, hegel.Just(0.5))
+	}
+	bucketCount := hegel.Map(pairs(counts, fraction), func(p pair[float64, float64]) float64 { return p.a + p.b })
+	bucketExemplar, halfBound := exemplarSlots(o, 30), chance(50)
+	bucket := hegel.Composite(func(tc hegel.TestCase) bucketSpec {
+		return bucketSpec{ub: hegel.Draw(tc, ubs), half: hegel.Draw(tc, halfBound), cnt: hegel.Draw(tc, bucketCount), ex: hegel.Draw(tc, bucketExemplar)}
+	})
+	buckets := hegel.Lists(bucket).MaxSize(4)
+	count := hegel.Map(pairs(counts, countFraction), func(p pair[float64, float64]) float64 { return p.a + p.b })
+	infLast := chance(50)
+	if o.omValid {
+		infLast = chance(85)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) cMetric {
+		m := cMetric{Labels: hegel.Draw(tc, labels), TS: hegel.Draw(tc, ts), Sum: hegel.Draw(tc, sum), Created: hegel.Draw(tc, created)}
+		var cum float64
+		for j, b := range hegel.Draw(tc, buckets) {
+			ub, cnt := b.ub, b.cnt
+			if o.omValid {
+				ub = float64(j)
+				if b.half {
+					ub += 0.5
+				}
+				cum += cnt
+				cnt = cum
+			}
+			m.Buckets = append(m.Buckets, cBucket{ub, cnt})
+			m.BucketExemplars = append(m.BucketExemplars, b.ex)
+		}
+		m.Count = hegel.Draw(tc, count)
+		if o.omValid {
+			m.Count += cum
+		}
+		if hegel.Draw(tc, infLast) {
+			m.Buckets = append(m.Buckets, cBucket{math.Inf(1), m.Count})
+			m.BucketExemplars = append(m.BucketExemplars, nil)
+		}
+		return fixCreated(m)
+	})
+}
+
+// familyOfType: a family of the type under the options: a name (legacy, or UTF-8 35% of the
+// time when allowed; legacy for summaries and histograms under noBracedComplex while
+// Known.bracedNameUsesPreviousFamily), the OpenMetrics suffixes under omValid, help 60% of the
+// time, one to three metrics with distinct label sets (none 10% of the time under emptyFamily).
+func familyOfType(o genOpts, t dto.MetricType) hegel.Generator[cFamily] {
+	names := legacyName
+	if o.utf8 && !(o.noBracedComplex && Known.bracedNameUsesPreviousFamily && isComplex(t)) {
+		names = weighted(choice[string]{65, legacyName}, choice[string]{35, utf8Name})
+	}
+	totalSuffix, unit := hegel.Just(false), hegel.Just("")
+	if o.omValid && t == dto.MetricType_COUNTER {
+		totalSuffix = chance(o.totalPct)
+	}
+	if o.omValid && o.openMetrics && t != dto.MetricType_COUNTER {
+		unit = maybe(25, units)
+	}
+	help := optional(60, helpText)
+	metrics := hegel.Map(hegel.Lists(metricOf(o, t)).MinSize(1).MaxSize(3), func(ms []cMetric) []cMetric {
+		return distinctBy(ms, func(m cMetric) string { return labelKey(m.Labels) })
+	})
+	if o.emptyFamily {
+		metrics = weighted(choice[[]cMetric]{10, hegel.Just[[]cMetric](nil)}, choice[[]cMetric]{90, metrics})
+	}
+	// an exemplar on a counter without _total, which is written as unknown, is invalid
+	// OpenMetrics (prometheus-common/10): left out under HEGEL_NO_KNOWN=1
+	fixExemplars := func(f cFamily) cFamily {
+		if Known.unknownCounterKeepsExemplar && t == dto.MetricType_COUNTER && !strings.HasSuffix(f.Name, "_total") {
+			for i := range f.Metrics {
+				f.Metrics[i].Exemplar = nil
+			}
+		}
+		return f
+	}
+	return hegel.Composite(func(tc hegel.TestCase) cFamily {
+		f := cFamily{Type: t, Name: hegel.Draw(tc, names)}
+		if o.omValid {
+			f.Name = strings.TrimSuffix(f.Name, "_total")
+			if hegel.Draw(tc, totalSuffix) {
+				f.Name += "_total"
+			}
+			if u := hegel.Draw(tc, unit); u != "" {
+				f.Unit = u
+				if !strings.HasSuffix(f.Name, "_"+u) {
+					f.Name += "_" + u
+				}
+			}
+		}
+		if h := hegel.Draw(tc, help); h != nil {
+			f.HasHelp, f.Help = true, *h
+		}
+		f.Metrics = hegel.Draw(tc, metrics)
+		return fixExemplars(f)
+	})
+}
+
+// nameFree: n is not taken and neither a suffixed form of a taken name nor a base of one.
+func nameFree(n string, taken map[string]bool) bool {
+	if taken[n] {
+		return false
+	}
+	for _, s := range []string{"_sum", "_count", "_bucket", "_total", "_created", "_gsum", "_gcount", "_info"} {
+		if taken[n+s] || (strings.HasSuffix(n, s) && taken[strings.TrimSuffix(n, s)]) {
+			return false
+		}
+	}
+	return true
+}
+
+// distinctFamilies drops the families whose names clash with (or are suffix-related to) an
+// earlier one's.
+func distinctFamilies(fs []cFamily) []cFamily {
+	taken := map[string]bool{}
+	var out []cFamily
+	for _, f := range fs {
+		if nameFree(f.Name, taken) {
+			taken[f.Name] = true
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// buildFamilies: one to four families of distinct, non-suffix-related names, of the types the
+// options name (a gauge histogram 15% of the time when gaugeHist).
+func buildFamilies(o genOpts) hegel.Generator[[]cFamily] {
+	types := o.types
+	if types == nil {
+		types = metricTypes
+	}
+	byType := map[dto.MetricType]hegel.Generator[cFamily]{}
+	for _, t := range types {
+		byType[t] = familyOfType(o, t)
+	}
+	typeGen := hegel.SampledFrom(types)
+	if o.types == nil && o.gaugeHist {
+		byType[dto.MetricType_GAUGE_HISTOGRAM] = familyOfType(o, dto.MetricType_GAUGE_HISTOGRAM)
+		typeGen = weighted(choice[dto.MetricType]{85, hegel.SampledFrom(types)}, choice[dto.MetricType]{15, hegel.Just(dto.MetricType_GAUGE_HISTOGRAM)})
+	}
+	family := hegel.FlatMap(typeGen, func(t dto.MetricType) hegel.Generator[cFamily] { return byType[t] })
+	return hegel.Map(hegel.Lists(family).MinSize(1).MaxSize(4), distinctFamilies)
+}
+
+var (
+	grammarsMu sync.Mutex
+	grammars   = map[string]hegel.Generator[[]cFamily]{}
+)
+
+// familiesOf: the grammar of families under the options, built once.
+func familiesOf(o genOpts) hegel.Generator[[]cFamily] {
+	key := fmt.Sprintf("%+v", o)
+	grammarsMu.Lock()
+	defer grammarsMu.Unlock()
+	g, ok := grammars[key]
+	if !ok {
+		g = buildFamilies(o)
+		grammars[key] = g
+	}
+	return g
+}
+
+// --------------------------------------------------------------------------- model writer
+
+// textStyle: the freedom taken when rendering to the text format, and the shapes of the
+// recorded parser bugs the rendering may carry; the local choices (separators, spellings,
+// positions, fillers) come from the tape.
+type textStyle struct {
+	plain      bool  // spaces only, lower-case type keywords, headers always, no comments or blank lines, grouped families, _sum/_count last
+	quotePct   int   // legacy-valid names are quoted (inside braces) this percent of the time
+	interleave bool  // interleave the sample lines of different families
+	trailingWS bool  // a separator after every sample's value or timestamp (prometheus-common/7)
+	strays     []int // a stray bare sample line for the summary/histogram metrics at these positions, modulo their number (prometheus-common/8)
+	toggles    []int // a quote pair toggled into the unquoted metric names of the sample lines at these positions, modulo their number (prometheus-common/2)
+	tape       []int
+}
+
+// plainStyle is the plainest rendering, the ref test's Prometheus text.
+var plainStyle = textStyle{plain: true}
+
+// stylesOf: the model writer's style for the parse property: legacy names quoted 40% of the
+// time in 30% of the cases, families interleaved 25% of the time, and the shapes of the
+// recorded parser bugs at their natural rate (left out under HEGEL_NO_KNOWN=1).
+var styles = hegel.Composite(func(tc hegel.TestCase) textStyle {
+	return textStyle{
+		quotePct:   hegel.Draw(tc, maybe(30, hegel.Just(40))),
+		interleave: hegel.Draw(tc, chance(25)),
+		trailingWS: hegel.Draw(tc, shaped(chance(15), hegel.Just(false))),
+		strays:     hegel.Draw(tc, shaped(maybe(10, many(positions, 1, 2)), hegel.Just[[]int](nil))),
+		toggles:    hegel.Draw(tc, shaped(maybe(10, many(positions, 1, 2)), hegel.Just[[]int](nil))),
+		tape:       hegel.Draw(tc, tapes),
+	}
+})
+
+func (st textStyle) GoString() string {
+	var parts []string
+	if st.plain {
+		parts = append(parts, "plain")
+	}
+	if st.quotePct > 0 {
+		parts = append(parts, fmt.Sprintf("quote %d%%", st.quotePct))
+	}
+	if st.interleave {
+		parts = append(parts, "interleaved")
+	}
+	if st.trailingWS {
+		parts = append(parts, "trailing whitespace")
+	}
+	if len(st.strays) > 0 {
+		parts = append(parts, fmt.Sprintf("strays %v", st.strays))
+	}
+	if len(st.toggles) > 0 {
+		parts = append(parts, fmt.Sprintf("toggles %v", st.toggles))
+	}
+	parts = append(parts, fmt.Sprintf("tape %v", st.tape))
+	return strings.Join(parts, ", ")
+}
+
+// rendered: a text, the families the parser must produce from it, the shapes that make the text
+// invalid (the parser must reject it) and the shapes of valid text the parser is known to
+// mishandle.
+type rendered struct {
+	text   string
+	want   []cFamily
+	reject []string
+	risky  []string
+}
+
+// writer renders families, reading the tape in order.
+type writer struct {
+	st textStyle
+	at int
+}
+
+// next is the next tape value in 0..n-1 (0 on an empty tape).
+func (w *writer) next(n int) int {
+	if len(w.st.tape) == 0 {
+		return 0
+	}
+	v := w.st.tape[w.at%len(w.st.tape)]
+	w.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (w *writer) coin(pct int) bool { return w.next(100) >= 100-pct }
+
+func (w *writer) sep() string {
+	if w.st.plain {
+		return " "
+	}
+	return []string{" ", " ", "\t", "  ", " \t "}[w.next(5)]
+}
+
+func (w *writer) maybeSpace() string {
+	if w.st.plain || !w.coin(30) {
+		return ""
+	}
+	return []string{" ", "\t"}[w.next(2)]
+}
+
+func escapeValue(s string) string {
+	return strings.NewReplacer("\\", `\\`, "\n", `\n`, "\"", `\"`).Replace(s)
+}
+
+func escapeHelp(s string) string {
+	return strings.NewReplacer("\\", `\\`, "\n", `\n`).Replace(s)
+}
+
+// name renders a metric or label name: unquoted when legacy-valid (unless quoting is asked
+// for), quoted otherwise. The sample lines of summaries and histograms keep legacy names
+// unquoted while Known.bracedNameUsesPreviousFamily.
+func (w *writer) name(n string, label, complexLine bool) (string, bool) {
+	valid := model.LegacyValidation.IsValidMetricName(n)
+	if label {
+		valid = model.LegacyValidation.IsValidLabelName(n)
+	}
+	if valid && !(w.st.quotePct > 0 && !(complexLine && Known.bracedNameUsesPreviousFamily) && w.coin(w.st.quotePct)) {
+		return n, false
+	}
+	return `"` + escapeValue(n) + `"`, true
+}
+
+// floatText renders a sample value in one of the spellings strconv.ParseFloat accepts; the
+// first spelling is the package's own.
+func (w *writer) floatText(v float64) string {
+	switch {
+	case math.IsNaN(v):
+		return []string{"NaN", "nan", "NAN"}[w.next(3)]
+	case math.IsInf(v, 1):
+		return []string{"+Inf", "Inf", "inf", "+inf", "Infinity"}[w.next(5)]
+	case math.IsInf(v, -1):
+		return []string{"-Inf", "-inf"}[w.next(2)]
+	}
+	s := strconv.FormatFloat(v, 'g', -1, 64)
+	switch w.next(6) {
+	case 1:
+		return strconv.FormatFloat(v, 'e', -1, 64)
+	case 2:
+		if v == math.Trunc(v) && math.Abs(v) < 1e15 && !strings.ContainsAny(s, "e.") {
+			return s + ".0"
+		}
+	case 3:
+		if v >= 0 {
+			return "+" + s
+		}
+	case 4:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	}
+	return s
+}
+
+// canonicalFloat is the spelling the package's writers use for quantile and le labels.
+func canonicalFloat(v float64) string {
+	switch {
+	case math.IsNaN(v):
+		return "NaN"
+	case math.IsInf(v, 1):
+		return "+Inf"
+	case math.IsInf(v, -1):
+		return "-Inf"
+	}
+	return strconv.FormatFloat(v, 'g', -1, 64)
+}
+
+// line: a rendered sample line, the family it belongs to and whether it is a summary or
+// histogram line with the name inside the braces.
+type line struct {
+	text   string
+	fam    int
+	braced bool
+}
+
+// sampleLine renders one sample: name, labels (with an optional extra label at a position
+// from the tape), value, optional timestamp, and the trailing separator of the style.
+func (w *writer) sampleLine(fam int, complexLine bool, name string, labels []cLabel, extra *cLabel, value string, ts *int64) line {
+	var b strings.Builder
+	if !w.st.plain && w.coin(10) {
+		b.WriteString(w.sep())
+	}
+	n, quoted := w.name(name, false, complexLine)
+	all := append([]cLabel{}, labels...)
+	if extra != nil {
+		at := w.next(len(all) + 1)
+		all = append(all[:at], append([]cLabel{*extra}, all[at:]...)...)
+	}
+	if quoted {
+		b.WriteString("{" + w.maybeSpace() + n)
+		for _, l := range all {
+			b.WriteString("," + w.maybeSpace())
+			w.label(&b, l)
+		}
+		b.WriteString(w.maybeSpace() + "}")
+	} else {
+		b.WriteString(n)
+		if len(all) > 0 || (!w.st.plain && w.coin(10)) {
+			b.WriteString("{" + w.maybeSpace())
+			for i, l := range all {
+				if i > 0 {
+					b.WriteString("," + w.maybeSpace())
+				}
+				w.label(&b, l)
+			}
+			b.WriteString(w.maybeSpace() + "}")
+		}
+	}
+	b.WriteString(w.sep() + value)
+	if ts != nil {
+		b.WriteString(w.sep() + strconv.FormatInt(*ts, 10))
+	}
+	if w.st.trailingWS {
+		b.WriteString(w.sep())
+	}
+	b.WriteString("\n")
+	return line{text: b.String(), fam: fam, braced: quoted && complexLine}
+}
+
+func (w *writer) label(b *strings.Builder, l cLabel) {
+	n, _ := w.name(l.N, true, false)
+	b.WriteString(n + w.maybeSpace() + "=" + w.maybeSpace() + `"` + escapeValue(l.V) + `"`)
+}
+
+func (w *writer) typeKeyword(t dto.MetricType) string {
+	kw := map[dto.MetricType]string{dto.MetricType_COUNTER: "counter", dto.MetricType_GAUGE: "gauge", dto.MetricType_UNTYPED: "untyped", dto.MetricType_SUMMARY: "summary", dto.MetricType_HISTOGRAM: "histogram"}[t]
+	if !w.st.plain && w.coin(20) {
+		kw = strings.ToUpper(kw)
+	}
+	if !w.st.plain && w.coin(10) {
+		kw = strings.ToUpper(kw[:1]) + kw[1:]
+	}
+	return kw
+}
+
+// filler writes blank lines and comments between lines.
+func (w *writer) filler(b *strings.Builder) {
+	if w.st.plain || !w.coin(20) {
+		return
+	}
+	b.WriteString([]string{"\n", "  \n", "# a comment\n", "#\n", "# \n", "#comment without space\n", "# HELP\n", "# TYPE\n", "\t# tabbed comment\n"}[w.next(9)])
+}
+
+// unquotedName matches the unquoted metric name a sample line starts with.
+var unquotedName = regexp.MustCompile(`^[ \t]*([a-zA-Z_:][a-zA-Z0-9_:]*)`)
+
+// toggleQuotes puts a quote pair into the unquoted metric name of a sample line (`foo` becomes
+// `f"oo"`, which the format does not allow); a line whose name is quoted is left alone.
+func toggleQuotes(s string) string {
+	m := unquotedName.FindStringSubmatchIndex(s)
+	if m == nil {
+		return s
+	}
+	n := s[m[2]:m[3]]
+	return s[:m[2]] + n[:1] + `"` + n[1:] + `"` + s[m[3]:]
+}
+
+// insertAt puts x into xs at position at.
+func insertAt[T any](xs []T, at int, x T) []T {
+	return append(xs[:at], append([]T{x}, xs[at:]...)...)
+}
+
+// render writes the families to text with the style. The expected families have HELP omitted
+// where the line was not written, empty families dropped, and UNTYPED where no TYPE line was
+// written; the text is to be rejected when it carries a stray line, a toggled quote, a bad
+// summary count or a NaN quantile or bound.
+func (st textStyle) render(fs []cFamily) rendered {
+	w := &writer{st: st}
+	var r rendered
+	nComplex := 0
+	for _, f := range fs {
+		if isComplex(f.Type) {
+			nComplex += len(f.Metrics)
+		}
+	}
+	strayAt := map[int]bool{}
+	for _, s := range st.strays {
+		if nComplex > 0 {
+			strayAt[s%nComplex] = true
+		}
+	}
+	complexIdx := 0
+	var headers []string // per family
+	var blocks [][]line  // sample lines per family
+	nLines := 0
+	for fi, f := range fs {
+		e := f
+		var head []string
+		n, _ := w.name(f.Name, false, false)
+		if f.HasHelp && (st.plain || !w.coin(15)) {
+			head = append(head, "# HELP"+w.sep()+n+w.sep()+escapeHelp(f.Help)+"\n")
+		} else {
+			e.HasHelp, e.Help = false, ""
+		}
+		if f.Type != dto.MetricType_UNTYPED || st.plain || !w.coin(30) {
+			head = append(head, "# TYPE"+w.sep()+n+w.sep()+w.typeKeyword(f.Type)+"\n")
+		}
+		if !st.plain && len(head) == 2 && w.coin(50) {
+			head[0], head[1] = head[1], head[0]
+		}
+		var lines []line
+		for _, m := range f.Metrics {
+			switch f.Type {
+			case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+				lines = append(lines, w.sampleLine(fi, false, f.Name, m.Labels, nil, w.floatText(m.Value), m.TS))
+			case dto.MetricType_SUMMARY:
+				if !isWholeCount(m.Count) {
+					r.reject = append(r.reject, "prometheus-common/1")
+				}
+				var ls []line
+				for _, q := range m.Quantiles {
+					if math.IsNaN(q.Q) {
+						r.reject = append(r.reject, "prometheus-common/8")
+					}
+					ls = append(ls, w.sampleLine(fi, true, f.Name, m.Labels, &cLabel{model.QuantileLabel, canonicalFloat(q.Q)}, w.floatText(q.V), m.TS))
+				}
+				// the quantile lines keep their order (the parser appends them as read); the
+				// _sum and _count lines go anywhere
+				for _, extra := range []line{w.sampleLine(fi, true, f.Name+"_sum", m.Labels, nil, w.floatText(m.Sum), m.TS), w.sampleLine(fi, true, f.Name+"_count", m.Labels, nil, w.floatText(m.Count), m.TS)} {
+					at := len(ls)
+					if !st.plain {
+						at = w.next(len(ls) + 1)
+					}
+					ls = insertAt(ls, at, extra)
+				}
+				if strayAt[complexIdx] {
+					// a bare sample line of the family: not a quantile, _sum or _count line
+					ls = append(ls, w.sampleLine(fi, true, f.Name, m.Labels, nil, w.floatText(m.Sum), m.TS))
+					r.reject = append(r.reject, "prometheus-common/8")
+				}
+				complexIdx++
+				lines = append(lines, ls...)
+			case dto.MetricType_HISTOGRAM:
+				var ls []line
+				for _, b := range m.Buckets {
+					if math.IsNaN(b.UB) {
+						r.reject = append(r.reject, "prometheus-common/8")
+					}
+					ls = append(ls, w.sampleLine(fi, true, f.Name+"_bucket", m.Labels, &cLabel{model.BucketLabel, canonicalFloat(b.UB)}, w.floatText(b.C), m.TS))
+				}
+				ls = append(ls, w.sampleLine(fi, true, f.Name+"_sum", m.Labels, nil, w.floatText(m.Sum), m.TS))
+				ls = append(ls, w.sampleLine(fi, true, f.Name+"_count", m.Labels, nil, w.floatText(m.Count), m.TS))
+				if !st.plain && w.coin(30) {
+					// the _sum and _count lines may come first; the buckets keep their order
+					ls = append(ls[len(ls)-2:], ls[:len(ls)-2]...)
+				}
+				if strayAt[complexIdx] {
+					ls = append(ls, w.sampleLine(fi, true, f.Name, m.Labels, nil, w.floatText(m.Sum), m.TS))
+					r.reject = append(r.reject, "prometheus-common/8")
+				}
+				complexIdx++
+				lines = append(lines, ls...)
+			}
+		}
+		if len(f.Metrics) > 0 {
+			r.want = append(r.want, e)
+		}
+		headers = append(headers, strings.Join(head, ""))
+		blocks = append(blocks, lines)
+		nLines += len(lines)
+	}
+	// the toggled quotes, by line position over all the sample lines
+	toggleAt := map[int]bool{}
+	for _, t := range st.toggles {
+		if nLines > 0 {
+			toggleAt[t%nLines] = true
+		}
+	}
+	idx := 0
+	for _, block := range blocks {
+		for i := range block {
+			if toggleAt[idx] {
+				if t := toggleQuotes(block[i].text); t != block[i].text {
+					block[i].text = t
+					r.reject = append(r.reject, "prometheus-common/2")
+				}
+			}
+			idx++
+		}
+	}
+	if st.trailingWS && nLines > 0 {
+		r.risky = append(r.risky, "prometheus-common/7")
+	}
+	// layout: grouped, or all headers first (a TYPE line after a family's samples is an
+	// error) and then the sample lines of the families interleaved; a summary or histogram
+	// line with the name inside the braces right after a line of another family is the shape
+	// of prometheus-common/9
+	var b strings.Builder
+	prev := -1
+	put := func(l line) {
+		if l.braced && l.fam != prev {
+			r.risky = append(r.risky, "prometheus-common/9")
+		}
+		b.WriteString(l.text)
+		prev = l.fam
+	}
+	if st.interleave && len(fs) > 1 {
+		for i, h := range headers {
+			b.WriteString(h)
+			if h != "" {
+				prev = i
+			}
+		}
+		idx := make([]int, len(blocks))
+		for {
+			var open []int
+			for i := range blocks {
+				if idx[i] < len(blocks[i]) {
+					open = append(open, i)
+				}
+			}
+			if len(open) == 0 {
+				break
+			}
+			i := open[w.next(len(open))]
+			put(blocks[i][idx[i]])
+			idx[i]++
+			w.filler(&b)
+		}
+	} else {
+		for i := range fs {
+			w.filler(&b)
+			b.WriteString(headers[i])
+			if headers[i] != "" {
+				prev = i
+			}
+			for _, l := range blocks[i] {
+				put(l)
+				w.filler(&b)
+			}
+		}
+	}
+	// the expected metrics of a histogram/summary family are in first-seen order, which is the
+	// generated order for every layout above
+	r.text = b.String()
+	r.reject = distinctBy(r.reject, func(s string) string { return s })
+	r.risky = distinctBy(r.risky, func(s string) string { return s })
+	return r
+}
+
+// isWholeCount: a count a summary may carry (the parser stores it in a uint64).
+func isWholeCount(c float64) bool {
+	return !math.IsNaN(c) && !math.IsInf(c, 0) && c >= 0 && c == math.Trunc(c)
+}
+
+// --------------------------------------------------------------------------- edits
+
+// edit: one change to a text: an inserted piece, a deleted byte, a replaced byte, two swapped
+// bytes, the trailing newline removed or a duplicated line; positions are taken modulo the
+// live size when applied.
+type edit struct {
+	kind   int
+	at, to int
+	piece  string
+}
+
+var editPieces = []string{`"`, "{", "}", "=", ",", " ", "\t", "\n", "#", `\`, "a", "1", "-", ".", "e", "_", ":", "+", "\xff"}
+
+var edits = hegel.Composite(func(tc hegel.TestCase) edit {
+	return edit{kind: hegel.Draw(tc, hegel.Integers(0, 5)), at: hegel.Draw(tc, positions), to: hegel.Draw(tc, positions), piece: hegel.Draw(tc, hegel.SampledFrom(editPieces))}
+})
+
+// apply makes the edit to the text.
+func (e edit) apply(s string) string {
+	if len(s) == 0 {
+		return e.piece
+	}
+	i := e.at % len(s)
+	switch e.kind {
+	case 0:
+		return s[:i] + e.piece + s[i:]
+	case 1:
+		return s[:i] + s[i+1:]
+	case 2:
+		return s[:i] + e.piece + s[i+1:]
+	case 3:
+		j := e.to % len(s)
+		if i > j {
+			i, j = j, i
+		}
+		if i == j {
+			return s
+		}
+		return s[:i] + s[j:j+1] + s[i+1:j] + s[i:i+1] + s[j+1:]
+	case 4:
+		return strings.TrimSuffix(s, "\n")
+	}
+	lines := strings.SplitAfter(s, "\n")
+	if len(lines) > 1 {
+		k := e.at % len(lines)
+		lines = insertAt(lines, k, lines[k])
+	}
+	return strings.Join(lines, "")
+}
+
+func applyEdits(s string, es []edit) string {
+	for _, e := range es {
+		s = e.apply(s)
+	}
+	return s
+}
diff --git a/expfmt/hegel_pins_test.go b/expfmt/hegel_pins_test.go
new file mode 100644
index 0000000..00bcb98
--- /dev/null
+++ b/expfmt/hegel_pins_test.go
@@ -0,0 +1,179 @@
+package expfmt_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// its bug exists (target.toml lists them as expected failures).
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+
+	dto "github.com/prometheus/client_model/go"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+)
+
+// prometheus-common/1: a summary's _count is a non-negative whole number; "-1" and "1.5" are
+// not silently converted (a histogram rejects the negative count).
+func TestHegelPinSummaryCountIsChecked(t *testing.T) {
+	for _, s := range []string{"# TYPE s summary\ns_count -1\n", "# TYPE s summary\ns_count 1.5\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err != nil {
+			continue
+		}
+		if f := fams["s"]; f != nil && len(f.Metric) == 1 {
+			c := f.Metric[0].GetSummary().GetSampleCount()
+			t.Errorf("%q accepted with sample_count %d; want an error", s, c)
+		}
+	}
+}
+
+// prometheus-common/2: a metric or label name is a token of name characters; a double quote
+// inside an unquoted name is an error, not a toggle of quoting.
+func TestHegelPinQuoteInsideNameRejected(t *testing.T) {
+	for _, s := range []string{"foo\"bar\" 1\n", "a{x\"y\"=\"1\"} 1\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err == nil {
+			t.Errorf("%q accepted as %v; want an error", s, fams)
+		}
+	}
+}
+
+// prometheus-common/3: ExtractSamples without options works for samples without a timestamp
+// as it does for samples with one.
+func TestHegelPinExtractSamplesNilOptions(t *testing.T) {
+	fams, err := parseText("a 1\nb 2 1000\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("ExtractSamples(nil, ...) panics: %v", r)
+		}
+	}()
+	v, err := expfmt.ExtractSamples(nil, fams["b"])
+	if err != nil || len(v) != 1 {
+		t.Fatalf("ExtractSamples(nil, b) = %v, %v", v, err)
+	}
+	v, err = expfmt.ExtractSamples(nil, fams["a"])
+	if err != nil || len(v) != 1 {
+		t.Errorf("ExtractSamples(nil, a) = %v, %v", v, err)
+	}
+}
+
+// prometheus-common/4: the _created line of a metric with a timestamp carries that timestamp
+// (OpenMetrics: all lines of a MetricPoint have the same timestamp).
+func TestHegelPinCreatedLineHasTheTimestamp(t *testing.T) {
+	ts := int64(1234567890123)
+	mf := &dto.MetricFamily{Name: proto.String("a_total"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		TimestampMs: &ts,
+		Counter:     &dto.Counter{Value: proto.Float64(2), CreatedTimestamp: timestamppb.New(time.Unix(1, 500000000))},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf, expfmt.WithCreatedLines()); err != nil {
+		t.Fatal(err)
+	}
+	for _, l := range strings.Split(strings.TrimSpace(b.String()), "\n") {
+		if strings.HasPrefix(l, "a_created ") && !strings.HasSuffix(l, " 1.234567890123e+09") {
+			t.Errorf("created line without the metric's timestamp: %q in\n%s", l, b.String())
+		}
+	}
+}
+
+// prometheus-common/5: an exemplar with no labels is written ("# {} value").
+func TestHegelPinExemplarWithoutLabelsWritten(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("a_total"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		Counter: &dto.Counter{Value: proto.Float64(2), Exemplar: &dto.Exemplar{Value: proto.Float64(0.5)}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(b.String(), " # {} 0.5") {
+		t.Errorf("exemplar without labels dropped:\n%s", b.String())
+	}
+}
+
+// prometheus-common/6: a gauge histogram in OpenMetrics has _gcount and _gsum lines.
+func TestHegelPinGaugeHistogramUsesGcountGsum(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("h"), Type: dto.MetricType_GAUGE_HISTOGRAM.Enum(), Metric: []*dto.Metric{{
+		Histogram: &dto.Histogram{SampleCount: proto.Uint64(2), SampleSum: proto.Float64(3), Bucket: []*dto.Bucket{{UpperBound: proto.Float64(1), CumulativeCount: proto.Uint64(1)}}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	out := b.String()
+	if !strings.Contains(out, "h_gcount 2") || !strings.Contains(out, "h_gsum 3.0") || strings.Contains(out, "h_count") || strings.Contains(out, "h_sum") {
+		t.Errorf("gauge histogram written with _count/_sum:\n%s", out)
+	}
+}
+
+// prometheus-common/7: "Leading and trailing whitespace is ignored" (the text format
+// specification): blanks after the value or the timestamp are not an error.
+func TestHegelPinTrailingWhitespaceIgnored(t *testing.T) {
+	for _, s := range []string{"foo 1 \n", "foo 1\t\n", "foo 1 2 \n", "foo{a=\"b\"} 1 2\t\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err != nil {
+			t.Errorf("%q: %v", s, err)
+			continue
+		}
+		if f := fams["foo"]; f == nil || len(f.Metric) != 1 || f.Metric[0].GetUntyped().GetValue() != 1 {
+			t.Errorf("%q parsed as %v", s, fams)
+		}
+	}
+}
+
+// prometheus-common/8: a sample of a summary or histogram family must be a quantile/bucket
+// line, _sum or _count; anything else is an error, not a silently dropped value.
+func TestHegelPinSummaryLineWithoutQuantileRejected(t *testing.T) {
+	for _, s := range []string{"# TYPE s summary\ns 1\n", "# TYPE s summary\ns{a=\"b\"} 1\n", "# TYPE h histogram\nh 1\n", "# TYPE s summary\ns{quantile=\"NaN\"} 1\n"} {
+		fams, err := parseText(s, model.UTF8Validation)
+		if err == nil {
+			t.Errorf("%q accepted as %v; want an error", s, fams)
+		}
+	}
+}
+
+// prometheus-common/9: a summary sample with the metric name inside the braces is the same
+// sample as with the name outside; parsing it never panics.
+func TestHegelPinBracedNameSameSummary(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v", r)
+		}
+	}()
+	fams, err := parseText("# TYPE a summary\n# TYPE b gauge\n{\"a\",x=\"y\",quantile=\"0.5\"} 1\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := len(fams["a"].GetMetric()); n != 1 {
+		t.Errorf("%d metrics", n)
+	}
+	fams, err = parseText("# TYPE a summary\n# TYPE b gauge\n{\"a_sum\"} 1\n{\"a_count\"} 2\n", model.UTF8Validation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := len(fams["a"].GetMetric()); n != 1 {
+		t.Errorf("a_sum and a_count with the name in braces give %d metrics, want 1: %v", n, fams["a"])
+	}
+}
+
+// prometheus-common/10: a counter written as "unknown" (no _total suffix) gets no exemplar,
+// since OpenMetrics allows exemplars on counters and histogram buckets only.
+func TestHegelPinUnknownCounterHasNoExemplar(t *testing.T) {
+	mf := &dto.MetricFamily{Name: proto.String("a"), Type: dto.MetricType_COUNTER.Enum(), Metric: []*dto.Metric{{
+		Counter: &dto.Counter{Value: proto.Float64(2), Exemplar: &dto.Exemplar{Value: proto.Float64(0.5), Label: []*dto.LabelPair{{Name: proto.String("t"), Value: proto.String("1")}}}},
+	}}}
+	var b bytes.Buffer
+	if _, err := expfmt.MetricFamilyToOpenMetrics(&b, mf); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(b.String(), "# TYPE a unknown") && strings.Contains(b.String(), " # {") {
+		t.Errorf("an unknown-typed sample carries an exemplar:\n%s", b.String())
+	}
+}
diff --git a/expfmt/hegel_props_test.go b/expfmt/hegel_props_test.go
new file mode 100644
index 0000000..69b0836
--- /dev/null
+++ b/expfmt/hegel_props_test.go
@@ -0,0 +1,1058 @@
+package expfmt_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	dto "github.com/prometheus/client_model/go"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+	"hegel.dev/go/hegel"
+)
+
+func nsTime(ns int64) time.Time { return time.Unix(0, ns).UTC() }
+
+// parseText parses with a fresh parser under the scheme.
+func parseText(s string, scheme model.ValidationScheme) (map[string]*dto.MetricFamily, error) {
+	p := expfmt.NewTextParser(scheme)
+	return p.TextToMetricFamilies(strings.NewReader(s))
+}
+
+// parsing runs a parse and returns what it panicked with, if anything (the parser panics on a
+// nil map in the shape of prometheus-common/9).
+func parsing(parse func() (map[string]*dto.MetricFamily, error)) (fams map[string]*dto.MetricFamily, err error, panicked any) {
+	panicked = recovering(func() { fams, err = parse() })
+	return fams, err, panicked
+}
+
+// sortedCanon canonicalises a parsed map in name order.
+func sortedCanon(m map[string]*dto.MetricFamily) []cFamily {
+	out := make([]cFamily, 0, len(m))
+	for _, n := range sortedNames(m) {
+		out = append(out, canonOf(m[n]))
+	}
+	return out
+}
+
+func sortFamilies(fs []cFamily) []cFamily {
+	cp := append([]cFamily{}, fs...)
+	sort.Slice(cp, func(i, j int) bool { return cp[i].Name < cp[j].Name })
+	return cp
+}
+
+func familiesEq(a, b []cFamily) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !familyEq(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// namesValid reports whether every metric and label name of the families passes the scheme.
+func namesValid(fs []cFamily, scheme model.ValidationScheme) bool {
+	for _, f := range fs {
+		if !scheme.IsValidMetricName(f.Name) {
+			return false
+		}
+		for _, m := range f.Metrics {
+			for _, l := range m.Labels {
+				if !scheme.IsValidLabelName(l.N) {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- parsing
+
+// parseCase: families, the style the model writer renders them in, the validation scheme and
+// the edits made to the text afterwards.
+type parseCase struct {
+	fs     []cFamily
+	style  textStyle
+	legacy bool // parse under LegacyValidation
+	edits  []edit
+}
+
+func (c parseCase) scheme() model.ValidationScheme {
+	if c.legacy {
+		return model.LegacyValidation
+	}
+	return model.UTF8Validation
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c parseCase) GoString() string {
+	r := c.style.render(c.fs)
+	return fmt.Sprintf("scheme %v, style %#v, edits %+v\nfamilies %v\ntext:\n%s", c.scheme(), c.style, c.edits, c.fs, r.text)
+}
+
+// parseCasesOf: the families of the grammar rendered by the model writer with the style,
+// parsed under the legacy scheme 30% of the time, with up to two edits half of the time.
+func parseCasesOf(families hegel.Generator[[]cFamily], style hegel.Generator[textStyle]) hegel.Generator[parseCase] {
+	return hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{
+			fs:     hegel.Draw(tc, families),
+			style:  hegel.Draw(tc, style),
+			legacy: hegel.Draw(tc, chance(30)),
+			edits:  hegel.Draw(tc, maybe(50, many(edits, 1, 2))),
+		}
+	})
+}
+
+// parseFlags: whether UTF-8 names and fractional histogram counts are allowed, drawn first so
+// that the grammar can be built for them.
+type parseFlags struct{ utf8, floatCounts bool }
+
+var parseFlagsGen = hegel.Map(pairs(chance(50), chance(40)), func(p pair[bool, bool]) parseFlags { return parseFlags{p.a, p.b} })
+
+// parseCases: the wide parse case: families of every type with the freedom of the format and
+// the shapes of the recorded parser bugs at their natural rate.
+var parseCases = hegel.FlatMap(parseFlagsGen, func(f parseFlags) hegel.Generator[parseCase] {
+	return parseCasesOf(familiesOf(genOpts{utf8: f.utf8, floatCounts: f.floatCounts, emptyFamily: true, timestamps: true, noBracedComplex: true, hostile: true}), styles)
+})
+
+// TestHegelParseFollowsTheFormat: generated families rendered by the model writer with the
+// freedom of the specification are parsed back to the same families (fresh and reused parser,
+// both validation schemes); an invalid text is rejected with a ParseError; mutated texts are
+// either rejected with a ParseError or parsed to something the package's own writer reproduces.
+func TestHegelParseFollowsTheFormat(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, parseCases))
+	})
+}
+
+// judgeParse is the oracle of TestHegelParseFollowsTheFormat on one case.
+func judgeParse(ht *hegel.T, c *collector, reused *expfmt.TextParser, pc parseCase) {
+	r := pc.style.render(pc.fs)
+	text, want := r.text, r.want
+	scheme := pc.scheme()
+	valid := namesValid(pc.fs, scheme)
+	got, err, panicked := parsing(func() (map[string]*dto.MetricFamily, error) { return parseText(text, scheme) })
+	if panicked != nil {
+		c.mismatch(ht, r.risky, "panic", "the parser panics: %v\n%s", panicked, text)
+		return
+	}
+	if !valid {
+		if err == nil {
+			c.failClass(ht, "legacy accept", "%s parser accepted UTF-8 names:\n%s", scheme, text)
+		} else {
+			c.count("legacy rejects")
+		}
+		return
+	}
+	if len(r.reject) > 0 {
+		// the text is not valid: a ParseError within the text is the answer
+		if err == nil {
+			c.mismatch(ht, r.reject, "accept invalid", "the parser accepted an invalid text as %v:\n%s", sortedCanon(got), text)
+			return
+		}
+		if e := parseErrorInRange(err, text); e != "" {
+			c.failClass(ht, "error type", "invalid text: %s", e)
+			return
+		}
+		c.count("invalid rejected")
+		return
+	}
+	if err != nil {
+		c.mismatch(ht, r.risky, "reject", "parse error %v for the valid text:\n%s", err, text)
+		return
+	}
+	if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+		c.mismatch(ht, r.risky, "families", "parsed\n  %v\nwant\n  %v\ntext:\n%s", g, w, text)
+		return
+	}
+	for _, f := range got {
+		for _, m := range f.Metric {
+			if e := histogramConsistent(m.Histogram); e != nil {
+				c.failClass(ht, "histogram counts", "%v in:\n%s", e, text)
+				return
+			}
+		}
+	}
+	// a reused parser gives the same result
+	got2, err2, panicked2 := parsing(func() (map[string]*dto.MetricFamily, error) {
+		return reused.TextToMetricFamilies(strings.NewReader(text))
+	})
+	if panicked2 != nil {
+		c.mismatch(ht, r.risky, "panic", "the reused parser panics: %v\n%s", panicked2, text)
+		return
+	}
+	if err2 != nil || !familiesEq(sortedCanon(got2), sortedCanon(got)) {
+		c.mismatch(ht, r.risky, "reuse", "reused parser: err=%v, families %v, fresh %v", err2, sortedCanon(got2), sortedCanon(got))
+		return
+	}
+	// the decoder sees the same families
+	format := expfmt.FmtText.WithEscapingScheme(model.NoEscaping)
+	dec := expfmt.NewDecoder(strings.NewReader(text), format)
+	var decoded []cFamily
+	for {
+		var mf dto.MetricFamily
+		e := dec.Decode(&mf)
+		if e == io.EOF {
+			break
+		}
+		if e != nil {
+			c.failClass(ht, "decoder", "Decode: %v for:\n%s", e, text)
+			return
+		}
+		decoded = append(decoded, canonOf(&mf))
+	}
+	if !familiesEq(sortFamilies(decoded), sortedCanon(got)) {
+		c.failClass(ht, "decoder", "decoder families %v, parser %v", sortFamilies(decoded), sortedCanon(got))
+		return
+	}
+	c.count(fmt.Sprintf("families %d", len(want)))
+	if !namesValid(pc.fs, model.LegacyValidation) {
+		c.count("utf8 names")
+	}
+
+	// mutation
+	mut := applyEdits(text, pc.edits)
+	if mut == text {
+		return
+	}
+	mgot, merr := parseText(mut, model.UTF8Validation)
+	if merr != nil {
+		if e := parseErrorInRange(merr, mut); e != "" {
+			c.failClass(ht, "error type", "mutated text: %s", e)
+			return
+		}
+		c.count("mutation rejected")
+		return
+	}
+	c.count("mutation accepted")
+	// what was accepted is written and read back unchanged
+	var b bytes.Buffer
+	for _, n := range sortedNames(mgot) {
+		if _, e := expfmt.MetricFamilyToText(&b, mgot[n]); e != nil {
+			c.failClass(ht, "write accepted", "MetricFamilyToText(%v): %v (from mutated text %q)", mgot[n], e, mut)
+			return
+		}
+	}
+	again, aerr := parseText(b.String(), model.UTF8Validation)
+	if aerr != nil {
+		c.failClass(ht, "reparse accepted", "the writer's output of an accepted text fails to parse: %v\nmutated: %q\nwritten: %q", aerr, mut, b.String())
+		return
+	}
+	var wantAgain []cFamily
+	for _, f := range sortedCanon(mgot) {
+		wantAgain = append(wantAgain, expectedAfterText(f))
+	}
+	if !familiesEq(sortedCanon(again), wantAgain) {
+		c.failClass(ht, "reparse accepted", "accepted text %q parses to %v, its rendering %q to %v", mut, sortedCanon(mgot), b.String(), sortedCanon(again))
+	}
+}
+
+// parseErrorInRange checks that a parser error is a ParseError whose line is within the text;
+// it returns a description of what is wrong, or "".
+func parseErrorInRange(err error, text string) string {
+	var pe expfmt.ParseError
+	if !errors.As(err, &pe) {
+		return fmt.Sprintf("error %T %v is not a ParseError", err, err)
+	}
+	lines := strings.Count(text, "\n") + 1
+	if pe.Line < 1 || pe.Line > lines {
+		return fmt.Sprintf("line %d of %d in %v", pe.Line, lines, err)
+	}
+	return ""
+}
+
+// expectedAfterText is the canonical form the text writer + parser round trip must yield:
+// gauge histograms become histograms and a missing +Inf bucket is added with the count.
+func expectedAfterText(f cFamily) cFamily {
+	e := f
+	e.Metrics = nil
+	if e.Type == dto.MetricType_GAUGE_HISTOGRAM {
+		e.Type = dto.MetricType_HISTOGRAM
+	}
+	for _, m := range f.Metrics {
+		mm := m
+		if f.Type == dto.MetricType_HISTOGRAM || f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+			mm.Buckets = append([]cBucket{}, m.Buckets...)
+			inf := false
+			for _, b := range m.Buckets {
+				if math.IsInf(b.UB, 1) {
+					inf = true
+				}
+			}
+			if !inf {
+				mm.Buckets = append(mm.Buckets, cBucket{math.Inf(1), m.Count})
+			}
+		}
+		e.Metrics = append(e.Metrics, mm)
+	}
+	return e
+}
+
+// flatSamples turns a model.Vector into sorted "name{labels} value ts" strings.
+func flatSamples(v model.Vector) []string {
+	out := make([]string, 0, len(v))
+	for _, s := range v {
+		out = append(out, fmt.Sprintf("%s %s %d", s.Metric.String(), canonicalFloat(float64(s.Value)), int64(s.Timestamp)))
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --------------------------------------------------------------------------- the text writer
+
+// roundTripCase: families for the text writer, whether whole histogram counts go to the float
+// fields, and whether ExtractSamples and the SampleDecoder get nil options (the shape of
+// prometheus-common/3 when a sample lacks a timestamp).
+type roundTripCase struct {
+	fs         []cFamily
+	floatWhole bool
+	nilOpts    bool
+}
+
+func (c roundTripCase) GoString() string {
+	return fmt.Sprintf("floatWhole %v, nilOpts %v\nfamilies %v", c.floatWhole, c.nilOpts, c.fs)
+}
+
+// needsOptions reports whether extracting the families' samples reads the options: some
+// metric has no timestamp, or a family is a summary or histogram (whose extractors read the
+// options' timestamp before looking at the metric's) - the shape of prometheus-common/3 with
+// nil options.
+func needsOptions(fs []cFamily) bool {
+	for _, f := range fs {
+		if isComplex(f.Type) {
+			return true
+		}
+		for _, m := range f.Metrics {
+			if m.TS == nil {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// roundTripCasesOf: whole float counts 20% of the time; nil options 30% of the time (never under
+// HEGEL_NO_KNOWN=1) unless fixed.
+func roundTripCasesOf(families hegel.Generator[[]cFamily], nilOpts hegel.Generator[bool]) hegel.Generator[roundTripCase] {
+	return hegel.Composite(func(tc hegel.TestCase) roundTripCase {
+		return roundTripCase{fs: hegel.Draw(tc, families), floatWhole: hegel.Draw(tc, chance(20)), nilOpts: hegel.Draw(tc, nilOpts)}
+	})
+}
+
+var roundTripCases = hegel.FlatMap(parseFlagsGen, func(f parseFlags) hegel.Generator[roundTripCase] {
+	return roundTripCasesOf(familiesOf(genOpts{utf8: f.utf8, gaugeHist: true, floatCounts: f.floatCounts, timestamps: true}), shaped(chance(30), hegel.Just(false)))
+})
+
+// TestHegelTextRoundTrips: families written by MetricFamilyToText (and the text Encoder) are
+// parsed back to the same families, the byte count is right, ExtractSamples agrees before and
+// after (with or without options), and every sample line is one extracted sample.
+func TestHegelTextRoundTrips(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeRoundTrip(ht, c, hegel.Draw(ht, roundTripCases))
+	})
+}
+
+// judgeRoundTrip is the oracle of TestHegelTextRoundTrips on one case.
+func judgeRoundTrip(ht *hegel.T, c *collector, rc roundTripCase) {
+	fs := rc.fs
+	var b bytes.Buffer
+	var want []cFamily
+	for _, f := range fs {
+		mf := toDTO(f, rc.floatWhole)
+		before := b.Len()
+		n, err := expfmt.MetricFamilyToText(&b, mf)
+		if err != nil {
+			c.failClass(ht, "write", "MetricFamilyToText(%v): %v", f, err)
+			return
+		}
+		if n != b.Len()-before {
+			c.failClass(ht, "written", "MetricFamilyToText wrote %d bytes, reported %d", b.Len()-before, n)
+			return
+		}
+		want = append(want, expectedAfterText(f))
+		// the encoder for the text format writes the same bytes (names that need no escaping)
+		var eb bytes.Buffer
+		format, class := expfmt.FmtText, "encoder"
+		if !namesValid([]cFamily{f}, model.LegacyValidation) {
+			format, class = expfmt.FmtText.WithEscapingScheme(model.NoEscaping), "encoder utf8"
+		}
+		enc := expfmt.NewEncoder(&eb, format)
+		if err := enc.Encode(mf); err != nil {
+			c.failClass(ht, class, "Encode: %v", err)
+			return
+		}
+		if eb.String() != b.String()[before:] {
+			c.failClass(ht, class, "Encoder (%s) wrote %q, MetricFamilyToText %q", format, eb.String(), b.String()[before:])
+			return
+		}
+	}
+	text := b.String()
+	got, err := parseText(text, model.UTF8Validation)
+	if err != nil {
+		c.failClass(ht, "reparse", "the writer's output does not parse: %v\n%s", err, text)
+		return
+	}
+	if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+		c.failClass(ht, "round trip", "parsed\n  %v\nwant\n  %v\ntext:\n%s", g, w, text)
+		return
+	}
+	for _, f := range got {
+		for _, m := range f.Metric {
+			if e := histogramConsistent(m.Histogram); e != nil {
+				c.failClass(ht, "histogram counts", "%v in:\n%s", e, text)
+				return
+			}
+		}
+	}
+	// samples: one per non-comment line, the same before and after; a nil *DecodeOptions is
+	// the zero options (prometheus-common/3 when a sample lacks a timestamp)
+	opts := &expfmt.DecodeOptions{}
+	if rc.nilOpts {
+		opts = nil
+	}
+	nilShape := shapeIf(rc.nilOpts && needsOptions(fs), "prometheus-common/3")
+	var origDTO []*dto.MetricFamily
+	for _, f := range fs {
+		origDTO = append(origDTO, toDTO(f, rc.floatWhole))
+	}
+	var parsedDTO []*dto.MetricFamily
+	for _, n := range sortedNames(got) {
+		parsedDTO = append(parsedDTO, got[n])
+	}
+	var v1, v2 model.Vector
+	var err1, err2 error
+	if p := recovering(func() {
+		v1, err1 = expfmt.ExtractSamples(opts, origDTO...)
+		v2, err2 = expfmt.ExtractSamples(opts, parsedDTO...)
+	}); p != nil {
+		c.mismatch(ht, nilShape, "extract", "ExtractSamples(%v, ...) panics: %v\n%s", opts, p, text)
+		return
+	}
+	if err1 != nil || err2 != nil {
+		c.failClass(ht, "extract", "ExtractSamples: %v / %v", err1, err2)
+		return
+	}
+	s1, s2 := flatSamples(v1), flatSamples(v2)
+	if strings.Join(s1, "\n") != strings.Join(s2, "\n") {
+		c.failClass(ht, "extract", "samples before\n  %v\nafter\n  %v\ntext:\n%s", s1, s2, text)
+		return
+	}
+	lines := 0
+	for _, l := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+		if !strings.HasPrefix(l, "#") {
+			lines++
+		}
+	}
+	if lines != len(v1) {
+		c.failClass(ht, "sample lines", "%d sample lines, %d extracted samples\n%s", lines, len(v1), text)
+		return
+	}
+	// the sample decoder reads the same samples
+	sd := expfmt.SampleDecoder{Dec: expfmt.NewDecoder(strings.NewReader(text), expfmt.FmtText.WithEscapingScheme(model.NoEscaping)), Opts: opts}
+	var all model.Vector
+	var sdErr error
+	if p := recovering(func() {
+		for {
+			var vec model.Vector
+			e := sd.Decode(&vec)
+			if e == io.EOF {
+				break
+			}
+			if e != nil {
+				sdErr = e
+				break
+			}
+			all = append(all, vec...)
+		}
+	}); p != nil {
+		c.mismatch(ht, nilShape, "sample decoder", "SampleDecoder with options %v panics: %v\n%s", opts, p, text)
+		return
+	}
+	if sdErr != nil {
+		c.failClass(ht, "sample decoder", "SampleDecoder: %v", sdErr)
+		return
+	}
+	if s3 := flatSamples(all); strings.Join(s3, "\n") != strings.Join(s1, "\n") {
+		c.failClass(ht, "sample decoder", "SampleDecoder samples\n  %v\nExtractSamples\n  %v", s3, s1)
+		return
+	}
+	for _, f := range fs {
+		c.count("type " + f.Type.String())
+	}
+}
+
+func sortedNames(m map[string]*dto.MetricFamily) []string {
+	names := make([]string, 0, len(m))
+	for n := range m {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// --------------------------------------------------------------------------- OpenMetrics
+
+// omLine is a parsed OpenMetrics sample line of the writer's output (the model's reading).
+type omLine struct {
+	name     string
+	labels   string // the raw label text
+	value    string
+	ts       string
+	exemplar string
+}
+
+// splitOM splits the writer's output into lines by kind, checking the line grammar the
+// specification fixes (ordering of HELP/TYPE/UNIT, the EOF line, no empty lines).
+func splitOM(text string) (comments []string, samples []omLine, err error) {
+	if !strings.HasSuffix(text, "# EOF\n") {
+		return nil, nil, fmt.Errorf("missing # EOF")
+	}
+	for _, l := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+		if l == "" {
+			return nil, nil, fmt.Errorf("empty line")
+		}
+		if l == "# EOF" {
+			continue
+		}
+		if strings.HasPrefix(l, "# ") {
+			comments = append(comments, l)
+			continue
+		}
+		var s omLine
+		rest := l
+		if strings.HasPrefix(rest, "{") {
+			i := strings.Index(rest, "} ")
+			if i < 0 {
+				return nil, nil, fmt.Errorf("unterminated braces: %q", l)
+			}
+			s.name = ""
+			s.labels = rest[:i+1]
+			rest = rest[i+2:]
+		} else {
+			i := strings.IndexAny(rest, "{ ")
+			if i < 0 {
+				return nil, nil, fmt.Errorf("no value: %q", l)
+			}
+			s.name = rest[:i]
+			rest = rest[i:]
+			if strings.HasPrefix(rest, "{") {
+				j := strings.Index(rest, "} ")
+				if j < 0 {
+					return nil, nil, fmt.Errorf("unterminated braces: %q", l)
+				}
+				s.labels = rest[:j+1]
+				rest = rest[j+2:]
+			} else {
+				rest = rest[1:]
+			}
+		}
+		if i := strings.Index(rest, " # "); i >= 0 {
+			s.exemplar = rest[i+3:]
+			rest = rest[:i]
+		}
+		parts := strings.Split(rest, " ")
+		s.value = parts[0]
+		if len(parts) > 1 {
+			s.ts = parts[1]
+		}
+		if len(parts) > 2 {
+			return nil, nil, fmt.Errorf("too many tokens: %q", l)
+		}
+		samples = append(samples, s)
+	}
+	return comments, samples, nil
+}
+
+// omCase: OpenMetrics-valid families, whether created lines are asked for and whether the
+// grammar drew timestamps.
+type omCase struct {
+	fs         []cFamily
+	created    bool
+	timestamps bool
+}
+
+func (c omCase) GoString() string {
+	return fmt.Sprintf("created lines %v, timestamps %v\nfamilies %v", c.created, c.timestamps, c.fs)
+}
+
+// omFlags: the grammar's knobs for the OpenMetrics property.
+type omFlags struct{ utf8, gaugeHist, timestamps bool }
+
+// omFlagsGen: UTF-8 names 30%, gauge histograms 20% (none under HEGEL_NO_KNOWN=1, the shape
+// of prometheus-common/6), timestamps 50%.
+var omFlagsGen = hegel.Composite(func(tc hegel.TestCase) omFlags {
+	return omFlags{utf8: hegel.Draw(tc, chance(30)), gaugeHist: hegel.Draw(tc, shaped(chance(20), hegel.Just(false))), timestamps: hegel.Draw(tc, chance(50))}
+})
+
+// omCasesWith: the families, with created lines asked for as drawn.
+func omCasesWith(families hegel.Generator[[]cFamily], created hegel.Generator[bool], timestamps bool) hegel.Generator[omCase] {
+	return hegel.Composite(func(tc hegel.TestCase) omCase {
+		return omCase{fs: hegel.Draw(tc, families), created: hegel.Draw(tc, created), timestamps: timestamps}
+	})
+}
+
+// omCases: the wide OpenMetrics case, created lines asked for half of the time.
+var omCases = hegel.FlatMap(omFlagsGen, func(f omFlags) hegel.Generator[omCase] {
+	return omCasesWith(familiesOf(genOpts{utf8: f.utf8, gaugeHist: f.gaugeHist, omValid: true, totalPct: 80, timestamps: f.timestamps, openMetrics: true}), chance(50), f.timestamps)
+})
+
+// TestHegelOpenMetricsIsWellFormed: MetricFamilyToOpenMetrics output has the line structure
+// the specification fixes, one sample line per sample with the right suffixes (_gcount/_gsum
+// for gauge histograms), integer counts, floats with a point or exponent, timestamps in
+// seconds, exemplars where the type allows them (counters and buckets, with or without labels)
+// and created lines with the metric's timestamp where asked; the Encoder writes the same bytes
+// and Close adds the EOF line; the package's own text parser reads the output without
+// exemplars/created lines back to the families.
+func TestHegelOpenMetricsIsWellFormed(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeOpenMetrics(ht, c, hegel.Draw(ht, omCases))
+	})
+}
+
+// omShapes names the recorded OpenMetrics writer bugs whose shapes the case has: a created
+// line for a metric with a timestamp (/4), an exemplar without labels (/5), a gauge histogram
+// (/6), an exemplar on a counter without _total (/10).
+func omShapes(oc omCase) []string {
+	var created, bare, gaugeHist, unknownEx bool
+	for _, f := range oc.fs {
+		if f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+			gaugeHist = true
+		}
+		for _, m := range f.Metrics {
+			if oc.created && m.Created != nil && m.TS != nil && f.Type != dto.MetricType_GAUGE && f.Type != dto.MetricType_UNTYPED {
+				created = true
+			}
+			for _, e := range append([]*cExemplar{m.Exemplar}, m.BucketExemplars...) {
+				if e != nil && len(e.Labels) == 0 {
+					bare = true
+				}
+			}
+			if m.Exemplar != nil && !strings.HasSuffix(f.Name, "_total") {
+				unknownEx = true
+			}
+		}
+	}
+	var shapes []string
+	shapes = append(shapes, shapeIf(created, "prometheus-common/4")...)
+	shapes = append(shapes, shapeIf(bare, "prometheus-common/5")...)
+	shapes = append(shapes, shapeIf(gaugeHist, "prometheus-common/6")...)
+	shapes = append(shapes, shapeIf(unknownEx, "prometheus-common/10")...)
+	return shapes
+}
+
+// judgeOpenMetrics is the oracle of TestHegelOpenMetricsIsWellFormed on one case.
+func judgeOpenMetrics(ht *hegel.T, c *collector, oc omCase) {
+	fs, created := oc.fs, oc.created
+	shapes := omShapes(oc)
+	var eopts []expfmt.EncoderOption
+	if created {
+		eopts = append(eopts, expfmt.WithCreatedLines())
+	}
+	var b, eb bytes.Buffer
+	enc := expfmt.NewEncoder(&eb, expfmt.FmtOpenMetrics_1_0_0.WithEscapingScheme(model.NoEscaping), eopts...)
+	for _, f := range fs {
+		mf := toDTO(f, false)
+		before := b.Len()
+		n, err := expfmt.MetricFamilyToOpenMetrics(&b, mf, eopts...)
+		if err != nil {
+			c.failClass(ht, "write", "MetricFamilyToOpenMetrics(%v): %v", f, err)
+			return
+		}
+		if n != b.Len()-before {
+			c.failClass(ht, "written", "wrote %d bytes, reported %d", b.Len()-before, n)
+			return
+		}
+		if err := enc.Encode(mf); err != nil {
+			c.failClass(ht, "encoder", "Encode: %v", err)
+			return
+		}
+	}
+	expfmt.FinalizeOpenMetrics(&b)
+	if err := enc.(expfmt.Closer).Close(); err != nil {
+		c.failClass(ht, "encoder", "Close: %v", err)
+		return
+	}
+	if eb.String() != b.String() {
+		c.failClass(ht, "encoder", "Encoder wrote\n%s\nMetricFamilyToOpenMetrics\n%s", eb.String(), b.String())
+		return
+	}
+	text := b.String()
+	comments, samples, err := splitOM(text)
+	if err != nil {
+		c.failClass(ht, "structure", "%v in:\n%s", err, text)
+		return
+	}
+	// expected sample lines
+	var want []string
+	wantEx := 0
+	for _, f := range fs {
+		base := f.Name
+		if f.Type == dto.MetricType_COUNTER && strings.HasSuffix(base, "_total") {
+			base = strings.TrimSuffix(base, "_total")
+		}
+		// a counter without _total is written as unknown, on which an exemplar is invalid
+		exemplarsAllowed := f.Type == dto.MetricType_HISTOGRAM || f.Type == dto.MetricType_GAUGE_HISTOGRAM || (f.Type == dto.MetricType_COUNTER && strings.HasSuffix(f.Name, "_total"))
+		for _, m := range f.Metrics {
+			ts := ""
+			if m.TS != nil {
+				ts = canonicalOMFloat(float64(*m.TS) / 1000)
+			}
+			switch f.Type {
+			case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+				want = append(want, f.Name+" "+canonicalOMFloat(m.Value)+" "+ts)
+			case dto.MetricType_SUMMARY:
+				for _, q := range m.Quantiles {
+					want = append(want, f.Name+" "+canonicalOMFloat(q.V)+" "+ts)
+				}
+				want = append(want, f.Name+"_sum "+canonicalOMFloat(m.Sum)+" "+ts)
+				want = append(want, f.Name+"_count "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+			case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+				cnt, sum := "_count", "_sum"
+				if f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+					cnt, sum = "_gcount", "_gsum"
+				}
+				inf := false
+				for _, bk := range m.Buckets {
+					want = append(want, f.Name+"_bucket "+fmt.Sprintf("%d", uint64(bk.C))+" "+ts)
+					if math.IsInf(bk.UB, 1) {
+						inf = true
+					}
+				}
+				if !inf {
+					want = append(want, f.Name+"_bucket "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+				}
+				want = append(want, f.Name+sum+" "+canonicalOMFloat(m.Sum)+" "+ts)
+				want = append(want, f.Name+cnt+" "+fmt.Sprintf("%d", uint64(m.Count))+" "+ts)
+			}
+			if created && m.Created != nil && f.Type != dto.MetricType_GAUGE && f.Type != dto.MetricType_UNTYPED {
+				// the _created line belongs to the metric's point and carries its timestamp
+				want = append(want, base+"_created "+canonicalOMFloat(float64(*m.Created)/1e9)+" "+ts)
+			}
+			if exemplarsAllowed {
+				for _, e := range append([]*cExemplar{m.Exemplar}, m.BucketExemplars...) {
+					if e != nil {
+						wantEx++
+					}
+				}
+			}
+		}
+	}
+	var got []string
+	for _, s := range samples {
+		name := s.name
+		if name == "" {
+			// quoted name inside the braces
+			name = unquoteFirst(s.labels)
+		}
+		got = append(got, name+" "+s.value+" "+s.ts)
+	}
+	sort.Strings(want)
+	sort.Strings(got)
+	if strings.Join(got, "\n") != strings.Join(want, "\n") {
+		c.mismatch(ht, shapes, "sample lines", "lines\n  %v\nwant\n  %v\ntext:\n%s", got, want, text)
+		return
+	}
+	// comment lines: HELP, TYPE, UNIT per family in that order, names as the type demands
+	wantComments := 0
+	for _, f := range fs {
+		if f.HasHelp {
+			wantComments++
+		}
+		wantComments++
+		if f.Unit != "" {
+			wantComments++
+		}
+	}
+	if len(comments) != wantComments {
+		c.failClass(ht, "comments", "%d comment lines, want %d:\n%s", len(comments), wantComments, text)
+		return
+	}
+	// exemplars: written iff present, on counters and buckets only, with or without labels
+	gotEx := 0
+	for _, s := range samples {
+		if s.exemplar != "" {
+			gotEx++
+			parts := strings.SplitN(s.exemplar, "} ", 2)
+			if len(parts) != 2 || !strings.HasPrefix(parts[0], "{") {
+				c.failClass(ht, "exemplar", "exemplar %q lacks a label set", s.exemplar)
+				return
+			}
+			toks := strings.Split(parts[1], " ")
+			if len(toks) > 2 || !omFloatOK(toks[0]) || (len(toks) == 2 && !omFloatOK(toks[1])) {
+				c.failClass(ht, "exemplar", "exemplar %q: bad value or timestamp", s.exemplar)
+				return
+			}
+		}
+	}
+	if gotEx != wantEx {
+		c.mismatch(ht, shapes, "exemplar", "%d exemplars written, want %d:\n%s", gotEx, wantEx, text)
+		return
+	}
+	// every value and timestamp is a float with a point or an exponent, or a whole count
+	for _, s := range samples {
+		if !omFloatOK(s.value) && !isDigits(s.value) {
+			c.failClass(ht, "float", "value %q in %q", s.value, text)
+			return
+		}
+		if s.ts != "" && !omFloatOK(s.ts) {
+			c.failClass(ht, "float", "timestamp %q", s.ts)
+			return
+		}
+	}
+	// the package's own text parser reads a plain output (no exemplars, timestamps or
+	// created lines) back to the families, gauge histograms and _total aside
+	plain := !created && !oc.timestamps
+	for _, f := range fs {
+		for _, m := range f.Metrics {
+			if m.Exemplar != nil {
+				plain = false
+			}
+			for _, e := range m.BucketExemplars {
+				if e != nil {
+					plain = false
+				}
+			}
+		}
+		// (counters are written with _total moved to the samples, or as "unknown", a type
+		// the text format does not have)
+		if f.Type == dto.MetricType_GAUGE_HISTOGRAM || f.Type == dto.MetricType_COUNTER || f.Type == dto.MetricType_UNTYPED {
+			plain = false
+		}
+	}
+	if plain {
+		got, err := parseText(text, model.UTF8Validation)
+		if err != nil {
+			c.failClass(ht, "text parse", "the text parser rejects plain OpenMetrics output: %v\n%s", err, text)
+			return
+		}
+		var want []cFamily
+		for _, f := range fs {
+			e := expectedAfterText(f)
+			e.Unit = ""
+			want = append(want, e)
+		}
+		if g, w := sortedCanon(got), sortFamilies(want); !familiesEq(g, w) {
+			c.failClass(ht, "text parse", "text parser reads\n  %v\nwant\n  %v\n%s", g, w, text)
+			return
+		}
+		c.count("text parser reads OM")
+	}
+	for _, f := range fs {
+		c.count("type " + f.Type.String())
+	}
+	if created {
+		c.count("created lines")
+	}
+}
+
+func canonicalOMFloat(v float64) string {
+	s := canonicalFloat(v)
+	if !strings.ContainsAny(s, "e.") && !math.IsNaN(v) && !math.IsInf(v, 0) {
+		s += ".0"
+	}
+	return s
+}
+
+func omFloatOK(s string) bool {
+	if s == "NaN" || s == "+Inf" || s == "-Inf" {
+		return true
+	}
+	if !strings.ContainsAny(s, "e.") {
+		return false
+	}
+	_, err := parseFloatStrict(s)
+	return err == nil
+}
+
+func parseFloatStrict(s string) (float64, error) {
+	if strings.ContainsAny(s, "pP_xX") {
+		return 0, fmt.Errorf("bad float")
+	}
+	var f float64
+	_, err := fmt.Sscanf(s, "%g", &f)
+	return f, err
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// unquoteFirst extracts the quoted metric name at the start of a brace group.
+func unquoteFirst(braces string) string {
+	s := strings.TrimPrefix(braces, "{")
+	if !strings.HasPrefix(s, `"`) {
+		return ""
+	}
+	var b strings.Builder
+	esc := false
+	for _, r := range s[1:] {
+		if esc {
+			switch r {
+			case 'n':
+				b.WriteRune('\n')
+			default:
+				b.WriteRune(r)
+			}
+			esc = false
+			continue
+		}
+		if r == '\\' {
+			esc = true
+			continue
+		}
+		if r == '"' {
+			break
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- negotiation
+
+var (
+	formats = []expfmt.Format{expfmt.FmtText, expfmt.FmtProtoDelim, expfmt.FmtProtoText, expfmt.FmtProtoCompact, expfmt.FmtOpenMetrics_1_0_0, expfmt.FmtOpenMetrics_0_0_1}
+	types   = []expfmt.FormatType{expfmt.TypeProtoCompact, expfmt.TypeProtoDelim, expfmt.TypeProtoText, expfmt.TypeTextPlain, expfmt.TypeOpenMetrics}
+	schemes = []model.EscapingScheme{model.NoEscaping, model.UnderscoreEscaping, model.DotsEscaping, model.ValueEncodingEscaping}
+)
+
+// negotiationCase: a format type, a format and two escaping schemes, one to three accepted
+// formats with the one asked for (an index modulo their number) and the dressing of the
+// Accept header.
+type negotiationCase struct {
+	ft         expfmt.FormatType
+	f          expfmt.Format
+	s, s2      model.EscapingScheme
+	accepted   []expfmt.Format
+	asked      int
+	noCharset  bool
+	quality    bool
+	afterOther bool
+}
+
+func (c negotiationCase) GoString() string {
+	return fmt.Sprintf("type %v, format %q, schemes %v/%v, accepted %v asked %d, noCharset %v, q %v, afterOther %v", c.ft, c.f, c.s, c.s2, c.accepted, c.asked, c.noCharset, c.quality, c.afterOther)
+}
+
+var negotiationCases = hegel.Composite(func(tc hegel.TestCase) negotiationCase {
+	return negotiationCase{
+		ft:         hegel.Draw(tc, hegel.SampledFrom(types)),
+		f:          hegel.Draw(tc, hegel.SampledFrom(formats)),
+		s:          hegel.Draw(tc, hegel.SampledFrom(schemes)),
+		s2:         hegel.Draw(tc, hegel.SampledFrom(schemes)),
+		accepted:   hegel.Draw(tc, many(hegel.SampledFrom(formats), 1, 3)),
+		asked:      hegel.Draw(tc, positions),
+		noCharset:  hegel.Draw(tc, chance(30)),
+		quality:    hegel.Draw(tc, chance(30)),
+		afterOther: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// TestHegelNegotiationReturnsWhatWasAsked: the Format helpers and content negotiation.
+func TestHegelNegotiationReturnsWhatWasAsked(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nc := hegel.Draw(ht, negotiationCases)
+		// NewFormat inverts FormatType
+		if got := expfmt.NewFormat(nc.ft).FormatType(); got != nc.ft {
+			c.failClass(ht, "newformat", "NewFormat(%v).FormatType() = %v", nc.ft, got)
+			return
+		}
+		// escaping scheme round trip keeps the type
+		f, s := nc.f, nc.s
+		g := f.WithEscapingScheme(s)
+		if g.ToEscapingScheme() != s {
+			c.failClass(ht, "escaping", "%q.WithEscapingScheme(%v) = %q, ToEscapingScheme %v", f, s, g, g.ToEscapingScheme())
+			return
+		}
+		if g.FormatType() != f.FormatType() {
+			c.failClass(ht, "escaping type", "%q has type %v, %q has %v", f, f.FormatType(), g, g.FormatType())
+			return
+		}
+		if h := g.WithEscapingScheme(nc.s2); h.ToEscapingScheme() != nc.s2 || strings.Count(string(h), "escaping=") != 1 {
+			c.failClass(ht, "escaping twice", "%q.WithEscapingScheme(%v) = %q", g, nc.s2, h)
+			return
+		}
+		// negotiation: an Accept header naming an accepted format gets it
+		accepted := nc.accepted
+		asked := accepted[nc.asked%len(accepted)]
+		h := http.Header{}
+		acceptHeader := string(asked)
+		if nc.noCharset {
+			acceptHeader = strings.ReplaceAll(acceptHeader, "; charset=utf-8", "")
+		}
+		if nc.quality {
+			acceptHeader += ";q=0.9"
+		}
+		if nc.afterOther {
+			acceptHeader = "image/png, " + acceptHeader
+		}
+		h.Set("Accept", acceptHeader)
+		got := expfmt.NegotiateAccept(h, accepted...)
+		if got.FormatType() != asked.FormatType() || !strings.HasPrefix(string(got), string(asked)) {
+			c.failClass(ht, "negotiate", "Accept %q with %v: got %q, want %q", acceptHeader, accepted, got, asked)
+			return
+		}
+		if got.ToEscapingScheme() != model.NameEscapingScheme {
+			c.failClass(ht, "negotiate escaping", "Accept %q: escaping %v, want the default %v", acceptHeader, got.ToEscapingScheme(), model.NameEscapingScheme)
+			return
+		}
+		// an escaping parameter in the header is echoed
+		h.Set("Accept", string(asked)+"; escaping="+s.String())
+		got = expfmt.NegotiateAccept(h, accepted...)
+		if got.ToEscapingScheme() != s && s != model.NoEscaping {
+			c.failClass(ht, "negotiate escaping", "Accept with escaping=%v: got %q", s, got)
+			return
+		}
+		// no match: the text format if accepted, else the first
+		h.Set("Accept", "image/png")
+		got = expfmt.NegotiateAccept(h, accepted...)
+		wantFallback := accepted[0]
+		for _, a := range accepted {
+			if a.FormatType() == expfmt.TypeTextPlain {
+				wantFallback = a
+				break
+			}
+		}
+		if !strings.HasPrefix(string(got), string(wantFallback)) {
+			c.failClass(ht, "fallback", "Accept image/png with %v: got %q, want %q", accepted, got, wantFallback)
+			return
+		}
+		// ResponseFormat recognises what the text and proto encoders label their output with
+		rh := http.Header{}
+		rh.Set("Content-Type", string(g))
+		rf := expfmt.ResponseFormat(rh)
+		switch f.FormatType() {
+		case expfmt.TypeTextPlain, expfmt.TypeProtoDelim:
+			if rf.FormatType() != f.FormatType() {
+				c.failClass(ht, "response", "ResponseFormat(%q) = %q", g, rf)
+				return
+			}
+		}
+		c.count(fmt.Sprintf("format %d", f.FormatType()))
+	})
+}
diff --git a/expfmt/hegel_ref_test.go b/expfmt/hegel_ref_test.go
new file mode 100644
index 0000000..9b619f5
--- /dev/null
+++ b/expfmt/hegel_ref_test.go
@@ -0,0 +1,474 @@
+package expfmt_test
+
+// Reference test: the prometheus_client Python parsers (the Prometheus text one and the
+// OpenMetrics one) read what the model writer and the package's writers produce to the same
+// samples. Runs when python3 with prometheus_client is on PATH, skipped otherwise.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	dto "github.com/prometheus/client_model/go"
+	"hegel.dev/go/hegel"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+)
+
+const pyScript = `
+import json, sys, math
+from prometheus_client.parser import text_string_to_metric_families as prom
+from prometheus_client.openmetrics.parser import text_string_to_metric_families as om
+def num(v):
+    if isinstance(v, float) and (math.isnan(v) or math.isinf(v)):
+        return repr(v)
+    return float(v)
+out = []
+for item in json.load(sys.stdin):
+    fn = prom if item["kind"] == "prom" else om
+    try:
+        fams = []
+        for m in fn(item["text"]):
+            samples = []
+            for s in m.samples:
+                ex = None
+                if s.exemplar is not None:
+                    ex = {"labels": dict(s.exemplar.labels), "value": num(s.exemplar.value)}
+                ts = None
+                if s.timestamp is not None and item["kind"] == "prom":
+                    ts = float(s.timestamp)
+                samples.append({"name": s.name, "labels": dict(s.labels), "value": num(s.value), "ts": ts, "exemplar": ex})
+            fams.append({"name": m.name, "type": m.type, "help": m.documentation, "unit": m.unit, "samples": samples})
+        out.append({"families": fams})
+    except Exception as e:
+        out.append({"error": type(e).__name__ + ": " + str(e)})
+json.dump(out, sys.stdout)
+`
+
+type pyExemplar struct {
+	Labels map[string]string `json:"labels"`
+	Value  any               `json:"value"`
+}
+
+type pySample struct {
+	Name     string            `json:"name"`
+	Labels   map[string]string `json:"labels"`
+	Value    any               `json:"value"`
+	TS       *float64          `json:"ts"`
+	Exemplar *pyExemplar       `json:"exemplar"`
+}
+
+type pyFamily struct {
+	Name    string     `json:"name"`
+	Type    string     `json:"type"`
+	Help    string     `json:"help"`
+	Unit    string     `json:"unit"`
+	Samples []pySample `json:"samples"`
+}
+
+type pyResult struct {
+	Families []pyFamily `json:"families"`
+	Error    string     `json:"error"`
+}
+
+func pyValue(v any) float64 {
+	switch x := v.(type) {
+	case float64:
+		return x
+	case string:
+		switch x {
+		case "nan":
+			return math.NaN()
+		case "inf":
+			return math.Inf(1)
+		case "-inf":
+			return math.Inf(-1)
+		}
+	}
+	return math.NaN()
+}
+
+// sampleKey renders a sample as "name{sorted labels} value" for comparison.
+func sampleKey(name string, labels map[string]string, value float64) string {
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var b strings.Builder
+	b.WriteString(name + "{")
+	for i, k := range keys {
+		if i > 0 {
+			b.WriteString(",")
+		}
+		b.WriteString(k + "=" + strconv.Quote(labels[k]))
+	}
+	b.WriteString("} " + canonicalFloat(value))
+	return b.String()
+}
+
+// goSamples flattens Go metric families with ExtractSamples into keys and a timestamp map.
+// prometheus_client names the samples of a counter family "<family>_total" when the family
+// name lacks the suffix; the Go names are adjusted the same way. ExtractSamples adds a +Inf
+// bucket sample to a histogram without one; that sample is left out.
+func goSamples(fams []*dto.MetricFamily, dropAddedInf bool) ([]string, map[string]int64, error) {
+	var keys []string
+	ts := map[string]int64{}
+	for _, f := range fams {
+		v, err := expfmt.ExtractSamples(&expfmt.DecodeOptions{}, f)
+		if err != nil {
+			return nil, nil, err
+		}
+		added := map[string]bool{}
+		for _, m := range f.Metric {
+			h := m.GetHistogram()
+			if h == nil {
+				continue
+			}
+			inf := false
+			for _, b := range h.Bucket {
+				if math.IsInf(b.GetUpperBound(), 1) {
+					inf = true
+				}
+			}
+			if !inf && dropAddedInf {
+				labels := map[string]string{"le": "+Inf"}
+				for _, l := range m.Label {
+					labels[l.GetName()] = l.GetValue()
+				}
+				cnt := h.GetSampleCountFloat()
+				if cnt == 0 {
+					cnt = float64(h.GetSampleCount())
+				}
+				added[sampleKey(f.GetName()+"_bucket", labels, cnt)] = true
+			}
+		}
+		for _, s := range v {
+			labels := map[string]string{}
+			name := ""
+			for k, val := range s.Metric {
+				if k == model.MetricNameLabel {
+					name = string(val)
+					continue
+				}
+				labels[string(k)] = string(val)
+			}
+			if f.GetType() == dto.MetricType_COUNTER && name == f.GetName() && !strings.HasSuffix(name, "_total") {
+				name += "_total"
+			}
+			k := sampleKey(name, labels, float64(s.Value))
+			if added[k] {
+				delete(added, k)
+				continue
+			}
+			keys = append(keys, k)
+			ts[k] = int64(s.Timestamp)
+		}
+	}
+	sort.Strings(keys)
+	return keys, ts, nil
+}
+
+// diffLines lists the lines only in a and only in b.
+func diffLines(a, b []string) string {
+	in := func(xs []string) map[string]int {
+		m := map[string]int{}
+		for _, x := range xs {
+			m[x]++
+		}
+		return m
+	}
+	ma, mb := in(a), in(b)
+	var out []string
+	for _, x := range a {
+		if ma[x] > mb[x] {
+			out = append(out, "  only left:  "+x)
+			ma[x]--
+		}
+	}
+	for _, x := range b {
+		if mb[x] > ma[x] {
+			out = append(out, "  only right: "+x)
+			mb[x]--
+		}
+	}
+	return strings.Join(out, "\n")
+}
+
+// refCase: the families of one batch item: Prometheus text families with the model writer's
+// plain style (a tape for the value spellings and label positions), and OpenMetrics-valid
+// families for the package's OpenMetrics writer.
+type refCase struct {
+	prom  []cFamily
+	style textStyle
+	om    []cFamily
+}
+
+func (c refCase) GoString() string {
+	return fmt.Sprintf("prometheus families %v (style %#v)\nopenmetrics families %v", c.prom, c.style, c.om)
+}
+
+// plainStyles: the plain style with a tape.
+var plainStyles = hegel.Map(tapes, func(t []int) textStyle { return textStyle{plain: true, tape: t} })
+
+// refFlags: the grammars' knobs: UTF-8 names 40%/30%, fractional counts 30%, OpenMetrics
+// timestamps 40%.
+type refFlags struct{ utf8, floatCounts, omUTF8, omTimestamps bool }
+
+var refFlagsGen = hegel.Composite(func(tc hegel.TestCase) refFlags {
+	return refFlags{utf8: hegel.Draw(tc, chance(40)), floatCounts: hegel.Draw(tc, chance(30)), omUTF8: hegel.Draw(tc, chance(30)), omTimestamps: hegel.Draw(tc, chance(40))}
+})
+
+var refCases = hegel.FlatMap(refFlagsGen, func(f refFlags) hegel.Generator[refCase] {
+	prom := familiesOf(genOpts{utf8: f.utf8, floatCounts: f.floatCounts, timestamps: true, noBracedComplex: true})
+	om := familiesOf(genOpts{utf8: f.omUTF8, omValid: true, totalPct: 80, timestamps: f.omTimestamps, openMetrics: true})
+	return hegel.Composite(func(tc hegel.TestCase) refCase {
+		return refCase{prom: hegel.Draw(tc, prom), style: hegel.Draw(tc, plainStyles), om: hegel.Draw(tc, om)}
+	})
+})
+
+// TestHegelPrometheusClientAgrees generates the batch with the hegel generators inside one
+// property of a fixed case count, then runs python3 once on all of it.
+func TestHegelPrometheusClientAgrees(t *testing.T) {
+	if err := exec.Command("python3", "-c", "import prometheus_client.openmetrics.parser").Run(); err != nil {
+		t.Skip("python3 with prometheus_client not available: " + err.Error())
+	}
+	type item struct {
+		Kind string `json:"kind"`
+		Text string `json:"text"`
+	}
+	var items []item
+	var promFams [][]*dto.MetricFamily // parsed by Go, for the prom items
+	var omFams [][]cFamily             // the families written, for the om items
+	var mu sync.Mutex                  // hegel may run the cases concurrently
+	// Generate the batch with hegel's generators, 150 texts of each kind.
+	hegel.Test(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, refCases)
+		// Prometheus text: the model writer's plain rendering, parsed by Go first
+		text := rc.style.render(rc.prom).text
+		fams, err := parseText(text, model.UTF8Validation)
+		if err != nil {
+			t.Fatalf("Go rejects the model text: %v\n%s", err, text)
+		}
+		var list []*dto.MetricFamily
+		for _, n := range sortedNames(fams) {
+			list = append(list, fams[n])
+		}
+		// Go's own text writer output too
+		var b bytes.Buffer
+		for _, f := range list {
+			expfmt.MetricFamilyToText(&b, f)
+		}
+		// OpenMetrics: the package's writer on OpenMetrics-valid families
+		var ob bytes.Buffer
+		for _, f := range rc.om {
+			if _, err := expfmt.MetricFamilyToOpenMetrics(&ob, toDTO(f, false)); err != nil {
+				t.Fatalf("MetricFamilyToOpenMetrics: %v", err)
+			}
+		}
+		expfmt.FinalizeOpenMetrics(&ob)
+		mu.Lock()
+		items = append(items, item{"prom", text}, item{"prom", b.String()}, item{"om", ob.String()})
+		promFams = append(promFams, list, list) // the second is the writer's text, where the +Inf buckets are materialised
+		omFams = append(omFams, rc.om)
+		mu.Unlock()
+	}, hegel.WithTestCases(150))
+
+	in, _ := json.Marshal(items)
+	cmd := exec.Command("python3", "-c", pyScript)
+	cmd.Stdin = bytes.NewReader(in)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python: %v\n%s", err, stderr.String())
+	}
+	var results []pyResult
+	if err := json.Unmarshal(out, &results); err != nil {
+		t.Fatalf("python output: %v\n%s", err, out)
+	}
+	if len(results) != len(items) {
+		t.Fatalf("%d results for %d items", len(results), len(items))
+	}
+	pi, oi := 0, 0
+	failures := 0
+	report := func(format string, args ...any) {
+		failures++
+		if failures <= 10 {
+			t.Errorf(format, args...)
+		}
+	}
+	for i, res := range results {
+		if items[i].Kind == "prom" {
+			list := promFams[pi]
+			pi++
+			if res.Error != "" {
+				report("prometheus_client rejects text Go accepts: %s\n%s", res.Error, items[i].Text)
+				continue
+			}
+			goKeys, goTS, err := goSamples(list, pi%2 == 1)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var pyKeys []string
+			pyTS := map[string]*float64{}
+			for _, f := range res.Families {
+				for _, s := range f.Samples {
+					k := sampleKey(s.Name, s.Labels, pyValue(s.Value))
+					pyKeys = append(pyKeys, k)
+					pyTS[k] = s.TS
+				}
+			}
+			sort.Strings(pyKeys)
+			if strings.Join(goKeys, "\n") != strings.Join(pyKeys, "\n") {
+				report("samples differ for:\n%s\nGo (left) vs Python (right):\n%s", items[i].Text, diffLines(goKeys, pyKeys))
+				continue
+			}
+			for k, ts := range goTS {
+				p := pyTS[k]
+				if ts == 0 && p == nil {
+					continue
+				}
+				if p == nil || math.Abs(float64(ts)/1000-*p) > 1e-3 {
+					report("timestamp of %s: Go %d ms, Python %v", k, ts, p)
+				}
+			}
+		} else {
+			fs := omFams[oi]
+			oi++
+			// the recorded OpenMetrics writer bugs whose shapes the families have (/5, /10)
+			tag := ""
+			if s := omShapes(omCase{fs: fs}); len(s) > 0 {
+				tag = " (the shape of " + strings.Join(s, ", ") + ")"
+			}
+			if res.Error != "" {
+				report("prometheus_client's OpenMetrics parser rejects the writer's output: %s\n%s"+tag, res.Error, items[i].Text)
+				continue
+			}
+			// families: name (counters without _total), type, help, unit; samples with exemplars
+			var want []string
+			for _, f := range fs {
+				name, typ := f.Name, strings.ToLower(strings.TrimPrefix(f.Type.String(), "GAUGE_"))
+				if f.Type == dto.MetricType_GAUGE_HISTOGRAM {
+					typ = "gaugehistogram"
+				}
+				if f.Type == dto.MetricType_UNTYPED {
+					typ = "unknown"
+				}
+				if f.Type == dto.MetricType_COUNTER {
+					if strings.HasSuffix(name, "_total") {
+						name = strings.TrimSuffix(name, "_total")
+					} else {
+						typ = "unknown"
+					}
+				}
+				want = append(want, fmt.Sprintf("%s %s %q %q", name, typ, f.Help, f.Unit))
+			}
+			var got []string
+			for _, f := range res.Families {
+				got = append(got, fmt.Sprintf("%s %s %q %q", f.Name, f.Type, f.Help, f.Unit))
+			}
+			sort.Strings(want)
+			sort.Strings(got)
+			if strings.Join(want, "\n") != strings.Join(got, "\n") {
+				report("families differ for:\n%s\nwant:\n  %s\nPython:\n  %s"+tag, items[i].Text, strings.Join(want, "\n  "), strings.Join(got, "\n  "))
+				continue
+			}
+			// samples
+			var wantS, gotS []string
+			for _, f := range fs {
+				for _, m := range f.Metrics {
+					labels := map[string]string{}
+					for _, l := range m.Labels {
+						labels[l.N] = l.V
+					}
+					with := func(k, v string) map[string]string {
+						cp := map[string]string{}
+						for a, b := range labels {
+							cp[a] = b
+						}
+						cp[k] = v
+						return cp
+					}
+					switch f.Type {
+					case dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED:
+						// a counter without _total is written as unknown, which carries no exemplar
+						ex := m.Exemplar
+						if !strings.HasSuffix(f.Name, "_total") {
+							ex = nil
+						}
+						wantS = append(wantS, sampleKey(f.Name, labels, m.Value)+exemplarKey(ex))
+					case dto.MetricType_SUMMARY:
+						for _, q := range m.Quantiles {
+							wantS = append(wantS, sampleKey(f.Name, with("quantile", canonicalOMFloat(q.Q)), q.V))
+						}
+						wantS = append(wantS, sampleKey(f.Name+"_sum", labels, m.Sum), sampleKey(f.Name+"_count", labels, m.Count))
+					case dto.MetricType_HISTOGRAM, dto.MetricType_GAUGE_HISTOGRAM:
+						inf := false
+						for j, bk := range m.Buckets {
+							var ex *cExemplar
+							if j < len(m.BucketExemplars) {
+								ex = m.BucketExemplars[j]
+							}
+							wantS = append(wantS, sampleKey(f.Name+"_bucket", with("le", canonicalOMFloat(bk.UB)), bk.C)+exemplarKey(ex))
+							if math.IsInf(bk.UB, 1) {
+								inf = true
+							}
+						}
+						if !inf {
+							wantS = append(wantS, sampleKey(f.Name+"_bucket", with("le", "+Inf"), m.Count))
+						}
+						wantS = append(wantS, sampleKey(f.Name+"_sum", labels, m.Sum), sampleKey(f.Name+"_count", labels, m.Count))
+					}
+				}
+			}
+			for _, f := range res.Families {
+				for _, s := range f.Samples {
+					k := sampleKey(s.Name, s.Labels, pyValue(s.Value))
+					if s.Exemplar != nil {
+						k += exemplarKey(&cExemplar{Labels: mapLabels(s.Exemplar.Labels), Value: pyValue(s.Exemplar.Value)})
+					}
+					gotS = append(gotS, k)
+				}
+			}
+			sort.Strings(wantS)
+			sort.Strings(gotS)
+			if strings.Join(wantS, "\n") != strings.Join(gotS, "\n") {
+				report("OpenMetrics samples differ for:\n%s\nwant (left) vs Python (right):\n%s"+tag, items[i].Text, diffLines(wantS, gotS))
+			}
+		}
+	}
+	if failures > 10 {
+		t.Errorf("%d failures in all", failures)
+	}
+	t.Logf("%d Prometheus texts and %d OpenMetrics texts compared", pi, oi)
+}
+
+func mapLabels(m map[string]string) []cLabel {
+	var out []cLabel
+	for k, v := range m {
+		out = append(out, cLabel{k, v})
+	}
+	return out
+}
+
+// exemplarKey renders an exemplar (sorted labels and value) or "" for none; an exemplar
+// without labels is "# {} value".
+func exemplarKey(e *cExemplar) string {
+	if e == nil {
+		return ""
+	}
+	m := map[string]string{}
+	for _, l := range e.Labels {
+		m[l.N] = l.V
+	}
+	return " # " + sampleKey("", m, e.Value)
+}
diff --git a/expfmt/hegel_shapes_test.go b/expfmt/hegel_shapes_test.go
new file mode 100644
index 0000000..8643072
--- /dev/null
+++ b/expfmt/hegel_shapes_test.go
@@ -0,0 +1,251 @@
+package expfmt_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the oracle of the wide property that found it, so that each bug
+// has a property that finds it every run (the wide properties in hegel_props_test.go reach the
+// shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the
+// bug does not touch instead (a whole summary count, names without quote pairs, options for
+// timestamped samples, created lines for metrics without timestamps, exemplars with labels,
+// plain histograms, no trailing blanks, no stray lines, unquoted legacy names, _total
+// counters) and passes.
+
+import (
+	"testing"
+
+	dto "github.com/prometheus/client_model/go"
+
+	"github.com/prometheus/common/expfmt"
+	"github.com/prometheus/common/model"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	summaries      = []dto.MetricType{dto.MetricType_SUMMARY}
+	complexTypes   = []dto.MetricType{dto.MetricType_SUMMARY, dto.MetricType_HISTOGRAM}
+	gauges         = []dto.MetricType{dto.MetricType_GAUGE}
+	countersOnly   = []dto.MetricType{dto.MetricType_COUNTER}
+	exemplarOwners = []dto.MetricType{dto.MetricType_COUNTER, dto.MetricType_HISTOGRAM}
+)
+
+// narrowStyles: the model writer's freedom without quoting, interleaving or the shapes of the
+// parser bugs; the narrow parse properties add their own shape.
+var narrowStyles = hegel.Map(tapes, func(t []int) textStyle { return textStyle{tape: t} })
+
+// narrowParseCases: families rendered with the style, parsed under UTF8Validation, no edits.
+func narrowParseCases(families hegel.Generator[[]cFamily], style hegel.Generator[textStyle]) hegel.Generator[parseCase] {
+	return hegel.Map(pairs(families, style), func(p pair[[]cFamily, textStyle]) parseCase { return parseCase{fs: p.a, style: p.b} })
+}
+
+// --------------------------------------------------------------------------- prometheus-common/1
+
+// summaryCountCases: a summary family whose first metric's count is negative, fractional or not
+// finite (under HEGEL_NO_KNOWN=1 a whole one), rendered by the model writer.
+var summaryCountCases = narrowParseCases(
+	hegel.Map(pairs(familiesOf(genOpts{types: summaries}), shaped(hegel.SampledFrom(badCounts), counts)), func(p pair[[]cFamily, float64]) []cFamily {
+		p.a[0].Metrics[0].Count = p.b
+		return p.a
+	}),
+	narrowStyles,
+)
+
+// TestHegelSummaryCountsAreChecked: a summary _count that is not a non-negative whole number is
+// a ParseError, as a histogram's negative count is; the parser converts it with uint64(value)
+// unchecked (prometheus-common/1).
+func TestHegelSummaryCountsAreChecked(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, summaryCountCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/2
+
+// toggledNameCases: legacy-named families with a quote pair toggled into one or two of the
+// sample lines' metric names (none under HEGEL_NO_KNOWN=1).
+var toggledNameCases = narrowParseCases(
+	familiesOf(genOpts{}),
+	hegel.Map(pairs(tapes, shaped(many(positions, 1, 2), hegel.Just[[]int](nil))), func(p pair[[]int, []int]) textStyle {
+		return textStyle{tape: p.a, toggles: p.b}
+	}),
+)
+
+// TestHegelQuoteInsideNameIsRejected: a double quote inside an unquoted metric name ends the
+// token or fails, so `f"oo" 1` is a ParseError; the parser toggles quoting and reads foo
+// (prometheus-common/2).
+func TestHegelQuoteInsideNameIsRejected(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, toggledNameCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/3
+
+// nilOptionCases: families of every type without timestamps (under HEGEL_NO_KNOWN=1 counters,
+// gauges and untyped families with a timestamp on every sample, the region the extractors read
+// no option in), extracted with a nil *DecodeOptions.
+var nilOptionCases = roundTripCasesOf(
+	familiesOf(shaped(genOpts{gaugeHist: true}, genOpts{allTimestamps: true, types: []dto.MetricType{dto.MetricType_COUNTER, dto.MetricType_GAUGE, dto.MetricType_UNTYPED}})),
+	hegel.Just(true),
+)
+
+// TestHegelExtractSamplesWorksWithoutOptions: ExtractSamples (and the SampleDecoder) with a nil
+// *DecodeOptions works for samples without a timestamp as it does for samples with one; it
+// panics on the first sample without one, and on every summary or histogram
+// (prometheus-common/3).
+func TestHegelExtractSamplesWorksWithoutOptions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeRoundTrip(ht, c, hegel.Draw(ht, nilOptionCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/4
+
+// createdLineCases: counters, summaries and histograms with a created timestamp on every
+// metric and a sample timestamp on every metric (under HEGEL_NO_KNOWN=1 on none), written with
+// created lines.
+var createdLineCases = omCasesWith(
+	familiesOf(shaped(
+		genOpts{omValid: true, totalPct: 80, openMetrics: true, noExemplars: true, allCreated: true, allTimestamps: true, types: complexTypes},
+		genOpts{omValid: true, totalPct: 80, openMetrics: true, noExemplars: true, allCreated: true, types: complexTypes},
+	)),
+	hegel.Just(true), !noKnown,
+)
+
+// TestHegelCreatedLinesCarryTheTimestamp: the _created line of a metric with a timestamp
+// carries that timestamp, as every line of an OpenMetrics MetricPoint does; the writer leaves
+// it out (prometheus-common/4).
+func TestHegelCreatedLinesCarryTheTimestamp(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeOpenMetrics(ht, c, hegel.Draw(ht, createdLineCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/5
+
+// bareExemplarCases: _total counters and histograms with an exemplar on every sample and bucket,
+// none of them with labels (under HEGEL_NO_KNOWN=1 all of them with labels).
+var bareExemplarCases = omCasesWith(
+	familiesOf(genOpts{omValid: true, totalPct: 100, openMetrics: true, allExemplars: true, bareExemplars: !noKnown, labelledExemplars: noKnown, types: exemplarOwners}),
+	hegel.Just(false), false,
+)
+
+// TestHegelExemplarsWithoutLabelsAreWritten: an exemplar with no labels is written as "# {}
+// value", which OpenMetrics allows and the reference parser reads; the writer drops it
+// (prometheus-common/5).
+func TestHegelExemplarsWithoutLabelsAreWritten(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeOpenMetrics(ht, c, hegel.Draw(ht, bareExemplarCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/6
+
+// gaugeHistogramCases: gauge histograms (under HEGEL_NO_KNOWN=1 plain histograms).
+var gaugeHistogramCases = omCasesWith(
+	familiesOf(genOpts{omValid: true, types: shaped([]dto.MetricType{dto.MetricType_GAUGE_HISTOGRAM}, []dto.MetricType{dto.MetricType_HISTOGRAM})}),
+	hegel.Just(false), false,
+)
+
+// TestHegelGaugeHistogramsUseGcountGsum: a gauge histogram's count and sum are its _gcount and
+// _gsum samples in OpenMetrics; the writer emits _count and _sum under `# TYPE h
+// gaugehistogram` (prometheus-common/6).
+func TestHegelGaugeHistogramsUseGcountGsum(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeOpenMetrics(ht, c, hegel.Draw(ht, gaugeHistogramCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/7
+
+// trailingWhitespaceCases: families with timestamps on some samples, every sample line ending
+// in blanks or tabs after the value or the timestamp (under HEGEL_NO_KNOWN=1 none).
+var trailingWhitespaceCases = narrowParseCases(
+	familiesOf(genOpts{timestamps: true}),
+	hegel.Map(tapes, func(t []int) textStyle { return textStyle{tape: t, trailingWS: !noKnown} }),
+)
+
+// TestHegelTrailingWhitespaceIsIgnored: "Leading and trailing whitespace is ignored" (the text
+// format specification): blanks after the value or the timestamp are not an error and the
+// families parse as without them; the parser reads an empty timestamp or a spurious string
+// (prometheus-common/7).
+func TestHegelTrailingWhitespaceIsIgnored(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, trailingWhitespaceCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/8
+
+// strayLineCases: summaries and histograms with a stray bare sample line (no quantile or le
+// label, not _sum or _count) after one or two of their metrics (none under HEGEL_NO_KNOWN=1).
+var strayLineCases = narrowParseCases(
+	familiesOf(genOpts{types: complexTypes}),
+	hegel.Map(pairs(tapes, shaped(many(positions, 1, 2), hegel.Just[[]int](nil))), func(p pair[[]int, []int]) textStyle {
+		return textStyle{tape: p.a, strays: p.b}
+	}),
+)
+
+// TestHegelSummaryLinesWithoutQuantileAreRejected: a sample of a summary or histogram family
+// that is neither a quantile/bucket line nor _sum or _count is a ParseError; the parser accepts
+// it, creates an empty metric for its label set and drops the value (prometheus-common/8).
+func TestHegelSummaryLinesWithoutQuantileAreRejected(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, strayLineCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/9
+
+// bracedNameCases: a gauge family followed by summaries and histograms (UTF-8 names allowed),
+// every legacy name quoted inside the braces and the families' sample lines interleaved, so
+// that a summary or histogram line with the name in the braces follows a line of another
+// family; under HEGEL_NO_KNOWN=1 the summaries and histograms get legacy names and are never
+// quoted.
+var bracedNameCases = narrowParseCases(
+	hegel.Map(pairs(familiesOf(genOpts{types: gauges}), familiesOf(genOpts{utf8: true, noBracedComplex: true, types: complexTypes})), func(p pair[[]cFamily, []cFamily]) []cFamily {
+		return distinctFamilies(append(p.a, p.b...))
+	}),
+	hegel.Map(tapes, func(t []int) textStyle { return textStyle{tape: t, quotePct: shaped(100, 0), interleave: true} }),
+)
+
+// TestHegelBracedNamesParseLikePlainOnes: a summary or histogram sample with the metric name
+// inside the braces is the same sample as with the name outside, whatever the previous line
+// was, and parsing never panics; the parser books it with the previous line's family state
+// (prometheus-common/9).
+func TestHegelBracedNamesParseLikePlainOnes(t *testing.T) {
+	c := newCollector(t)
+	reused := expfmt.NewTextParser(model.UTF8Validation)
+	property(t, func(ht *hegel.T) {
+		judgeParse(ht, c, &reused, hegel.Draw(ht, bracedNameCases))
+	})
+}
+
+// --------------------------------------------------------------------------- prometheus-common/10
+
+// unknownCounterCases: counters without the _total suffix (with it under HEGEL_NO_KNOWN=1),
+// every sample carrying a labelled exemplar.
+var unknownCounterCases = omCasesWith(
+	familiesOf(genOpts{omValid: true, totalPct: shaped(0, 100), openMetrics: true, allExemplars: true, labelledExemplars: true, types: countersOnly}),
+	hegel.Just(false), false,
+)
+
+// TestHegelUnknownCountersHaveNoExemplar: a counter written as "unknown" (no _total suffix)
+// gets no exemplar, since OpenMetrics allows exemplars on counters and histogram buckets only;
+// the writer keeps it (prometheus-common/10).
+func TestHegelUnknownCountersHaveNoExemplar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeOpenMetrics(ht, c, hegel.Draw(ht, unknownCounterCases))
+	})
+}
diff --git a/expfmt/hegel_test.go b/expfmt/hegel_test.go
new file mode 100644
index 0000000..a9ff2ca
--- /dev/null
+++ b/expfmt/hegel_test.go
@@ -0,0 +1,316 @@
+package expfmt_test
+
+// Hegel property tests for prometheus/common's expfmt package, written for the Hegel zoo. See
+// targets/go/prometheus-common/README.md.
+//
+// Oracle: the Prometheus exposition format specification (docs/instrumenting/exposition_formats,
+// the "text-based format" section) and the OpenMetrics 1.0 specification, with the package's
+// own documentation: a model writer renders generated metric families to the text format with
+// the freedom the specification allows (whitespace, value spellings, optional HELP/TYPE lines,
+// label order, quoted names) and the parser must recover the families; the package's writers
+// must produce text the parser reads back to the same families and text the reference Python
+// parsers (prometheus_client, the Prometheus and the OpenMetrics one) read to the same samples;
+// content negotiation must return what was asked for.
+//
+// Every property draws one case record (hegel_model_test.go has the grammar, built once per
+// option set, and the pure model writer, which reads a drawn tape for the choices the format
+// leaves free; an empty tape is the plainest rendering). The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the properties that meet them fail, naming the
+// shape, and are the expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_shapes_test.go has one property per bug over its shape region alone, and
+// hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// recovering runs fn and returns the value it panicked with, if any (the library under test
+// panics in two recorded shapes, and the panic is attributed to the shape rather than aborting
+// the case anonymously).
+func recovering(fn func()) (panicked any) {
+	defer func() { panicked = recover() }()
+	fn()
+	return nil
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass reports a plain failure of a class: in collect mode the class is counted and only
+// its first two messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose text or families have the
+// shapes of the recorded bugs named (none for a plain failure): the failure names the shapes,
+// and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then,
+// since the generators leave the shapes out).
+func (c *collector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape; under HEGEL_NO_KNOWN=1 the gates of Known are on: the shapes are left out of the
+// generators (shaped, the per-option grammars) and a mismatch that still has a known shape is
+// skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of the recorded bugs (bugs.toml); on means the shape is left out
+// of the generators, which is so only under HEGEL_NO_KNOWN=1. The pins assert the documented
+// behaviour and fail while the bug exists; hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	// prometheus-common/1: a summary's _count line is converted with uint64(value) without a
+	// check: "-1" becomes 18446744073709551615 and "1.5" becomes 1, while a histogram rejects a
+	// negative count and keeps a fractional one as a float
+	summaryCountUnchecked bool
+	// prometheus-common/2: a double quote inside an unquoted metric or label name toggles
+	// quoting instead of ending the name: `foo"bar" 1` parses as the metric foobar
+	quoteInsideName bool
+	// prometheus-common/3: ExtractSamples with a nil *DecodeOptions panics on the first sample
+	// without a timestamp
+	extractSamplesNilPanics bool
+	// prometheus-common/4: the OpenMetrics _created line omits the metric's timestamp, so a
+	// family whose samples carry timestamps is written with a mix the OpenMetrics parser rejects
+	createdLineLacksTimestamp bool
+	// prometheus-common/5: an exemplar with no labels is not written to OpenMetrics output
+	exemplarWithoutLabelsDropped bool
+	// prometheus-common/6: a gauge histogram is written to OpenMetrics with _count and _sum
+	// lines instead of the _gcount and _gsum the type requires
+	gaugeHistogramUsesCountSum bool
+	// prometheus-common/7: blanks or tabs after a sample's value or timestamp are a parse error,
+	// though the format says leading and trailing whitespace is ignored
+	trailingWhitespaceRejected bool
+	// prometheus-common/8: a sample line of a summary or histogram family that has no
+	// quantile/le label (or one with the value NaN) and is not _sum or _count is accepted and
+	// its value dropped
+	lineWithoutQuantileDropped bool
+	// prometheus-common/9: a summary or histogram sample whose metric name is inside the braces
+	// ({"a",...}) is booked with the summary state of the family of the *previous* line: one
+	// summary splits into several metrics and, on a fresh parser, a label after the name panics
+	// on a nil map
+	bracedNameUsesPreviousFamily bool
+	// prometheus-common/10: a counter without the _total suffix is declared "unknown" in
+	// OpenMetrics output, but its exemplar is still written, which OpenMetrics allows on
+	// counters and buckets only
+	unknownCounterKeepsExemplar bool
+}{
+	summaryCountUnchecked:        noKnown,
+	quoteInsideName:              noKnown,
+	extractSamplesNilPanics:      noKnown,
+	createdLineLacksTimestamp:    noKnown,
+	exemplarWithoutLabelsDropped: noKnown,
+	gaugeHistogramUsesCountSum:   noKnown,
+	trailingWhitespaceRejected:   noKnown,
+	lineWithoutQuantileDropped:   noKnown,
+	bracedNameUsesPreviousFamily: noKnown,
+	unknownCounterKeepsExemplar:  noKnown,
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// ptrs: pointers to the values of g.
+func ptrs[T any](g hegel.Generator[T]) hegel.Generator[*T] { return hegel.Map(g, ptrTo[T]) }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, ptrs(g))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tapes: up to sixty values of 0 to 99, read in order (recycled) by the model writer for the
+// choices the format leaves free; an empty tape answers 0 to every question, the plainest
+// rendering.
+var tapes = many(hegel.Integers(0, 99), 0, 60)
+
+// distinctBy keeps the first element of every key.
+func distinctBy[T any](xs []T, key func(T) string) []T {
+	seen := map[string]bool{}
+	var out []T
+	for _, x := range xs {
+		k := key(x)
+		if !seen[k] {
+			seen[k] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
