+// ---------------------------------------------------------------------------
+// Validity, clamping, hex parsing and the color.Color interface.
+
+func TestHegelValidityHexAndRGBA(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genAnyColor(ht)
+		note(ht, "c = %s", cstr(c))
+		valid := 0 <= c.R && c.R <= 1 && 0 <= c.G && c.G <= 1 && 0 <= c.B && c.B <= 1
+		if c.IsValid() != valid {
+			fail(ht, "IsValid(%s) = %v", cstr(c), c.IsValid())
+		}
+		cl := c.Clamped()
+		if !cl.IsValid() || (valid && cl != c) || cl != fromV3(vec3{clamp01(c.R), clamp01(c.G), clamp01(c.B)}) {
+			fail(ht, "Clamped(%s) = %s", cstr(c), cstr(cl))
+		}
+		if valid {
+			r, g, b, a := c.RGBA()
+			want := [3]uint32{uint32(c.R*65535 + 0.5), uint32(c.G*65535 + 0.5), uint32(c.B*65535 + 0.5)}
+			if a != 0xffff || [3]uint32{r, g, b} != want {
+				fail(ht, "RGBA(%s) = %v %v %v %v, want %v", cstr(c), r, g, b, a, want)
+			}
+			r8, g8, b8 := c.RGB255()
+			want8 := [3]uint8{uint8(math.Round(c.R * 255)), uint8(math.Round(c.G * 255)), uint8(math.Round(c.B * 255))}
+			if [3]uint8{r8, g8, b8} != want8 {
+				fail(ht, "RGB255(%s) = %v, want %v", cstr(c), [3]uint8{r8, g8, b8}, want8)
+			}
+			if hex := c.Hex(); hex != fmt.Sprintf("#%02x%02x%02x", want8[0], want8[1], want8[2]) {
+				fail(ht, "Hex(%s) = %q", cstr(c), hex)
+			}
+		}
+		// MakeColor undoes the premultiplication of any colour with alpha.
+		r16, g16, b16, a16 := uint32(n(ht, 0, 65535)), uint32(n(ht, 0, 65535)), uint32(n(ht, 0, 65535)), uint32(n(ht, 0, 65535))
+		if chance(ht, 10) {
+			a16 = 0
+		}
+		src := premultiplied{r16 * a16 / 0xffff, g16 * a16 / 0xffff, b16 * a16 / 0xffff, a16}
+		mc, ok := colorful.MakeColor(src)
+		if a16 == 0 {
+			if ok || mc != (colorful.Color{}) {
+				fail(ht, "MakeColor of alpha 0 = %s, %v", cstr(mc), ok)
+			}
+		} else {
+			if !ok || !mc.IsValid() {
+				fail(ht, "MakeColor(%v) = %s, %v", src, cstr(mc), ok)
+			}
+			// The premultiplied channel lost up to 0xffff/a of precision.
+			tol := 1.0/float64(a16) + 1.0/65535 + 1e-12
+			if !colorClose(mc, colorful.Color{R: float64(r16) / 65535, G: float64(g16) / 65535, B: float64(b16) / 65535}, tol) {
+				fail(ht, "MakeColor(%v) = %s, want about %v/65535 (tolerance %v)", src, cstr(mc), [3]uint32{r16, g16, b16}, tol)
+			}
+		}
+		// Hex parsing: 3 and 6 digits in either case; anything else is an error.
+		s := genHexString(ht)
+		got, err := colorful.Hex(s)
+		want, wantOK := parseHexModel(s)
+		if wantOK != (err == nil) {
+			fail(ht, "Hex(%q) = %s, %v; model accepts: %v", s, cstr(got), err, wantOK)
+		}
+		if wantOK && !colorClose(got, want, tight) {
+			fail(ht, "Hex(%q) = %s, model %s", s, cstr(got), cstr(want))
+		}
+		if !wantOK && got != (colorful.Color{}) {
+			fail(ht, "Hex(%q) failed with %v but returned %s", s, err, cstr(got))
+		}
+		var hc colorful.HexColor
+		if jerr := json.Unmarshal([]byte(strconvQuote(s)), &hc); (jerr == nil) != wantOK {
+			fail(ht, "HexColor JSON of %q: %v; model accepts: %v", s, jerr, wantOK)
+		}
+	})
+}
+
+type premultiplied [4]uint32
+
+func (p premultiplied) RGBA() (r, g, b, a uint32) { return p[0], p[1], p[2], p[3] }
+
+func strconvQuote(s string) string {
+	b, _ := json.Marshal(s)
+	return string(b)
+}
+
+// genHexString draws mostly valid hex strings and some broken ones.
+func genHexString(tc hegel.TestCase) string {
+	const digits = "0123456789abcdefABCDEF"
+	var sb strings.Builder
+	k := pick(tc, 3, 6, 6, 6, 3, 4, 5, 8, 0, 1, 2, 7)
+	if chance(tc, 85) {
+		sb.WriteByte('#')
+	}
+	for i := 0; i < k; i++ {
+		if chance(tc, 3) {
+			sb.WriteRune(pick(tc, 'g', 'x', ' ', '-', '+', 'z', '#', '.'))
+		} else {
+			sb.WriteByte(digits[n(tc, 0, len(digits)-1)])
+		}
+	}
+	return sb.String()
+}
+
+// parseHexModel accepts "#rgb" and "#rrggbb" with hex digits of either case.
+func parseHexModel(s string) (colorful.Color, bool) {
+	if len(s) != 4 && len(s) != 7 || s[0] != '#' {
+		return colorful.Color{}, false
+	}
+	hex := func(b byte) (int, bool) {
+		switch {
+		case '0' <= b && b <= '9':
+			return int(b - '0'), true
+		case 'a' <= b && b <= 'f':
+			return int(b-'a') + 10, true
+		case 'A' <= b && b <= 'F':
+			return int(b-'A') + 10, true
+		}
+		return 0, false
+	}
+	var v [3]float64
+	if len(s) == 4 {
+		for i := 0; i < 3; i++ {
+			d, ok := hex(s[1+i])
+			if !ok {
+				return colorful.Color{}, false
+			}
+			v[i] = float64(d) / 15
+		}
+	} else {
+		for i := 0; i < 3; i++ {
+			d1, ok1 := hex(s[1+2*i])
+			d2, ok2 := hex(s[2+2*i])
+			if !ok1 || !ok2 {
+				return colorful.Color{}, false
+			}
+			v[i] = float64(d1*16+d2) / 255
+		}
+	}
+	return fromV3(v), true
+}
+
+// ---------------------------------------------------------------------------
+// Random colours, palettes and sorting.
+
+func TestHegelPalettesAndSorting(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		rnd := &lcg{s: uint64(n(ht, 0, 1_000_000_000))}
+		// Single random colours land in their documented ranges and are valid.
+		for i := 0; i < 8; i++ {
+			c := colorful.FastWarmColorWithRand(rnd)
+			_, s, v := c.Hsv()
+			if !c.IsValid() || s < 0.5-1e-9 || s > 0.8+1e-9 || v < 0.3-1e-9 || v > 0.6+1e-9 {
+				fail(ht, "FastWarmColor = %s (s %v v %v)", cstr(c), s, v)
+			}
+			c = colorful.FastHappyColorWithRand(rnd)
+			_, s, v = c.Hsv()
+			if !c.IsValid() || s < 0.7-1e-9 || s > 1+1e-9 || v < 0.6-1e-9 || v > 0.9+1e-9 {
+				fail(ht, "FastHappyColor = %s (s %v v %v)", cstr(c), s, v)
+			}
+			c = colorful.WarmColorWithRand(rnd)
+			_, ch, l := c.Hcl()
+			if !c.IsValid() || ch < 0.1-1e-6 || ch > 0.4+1e-6 || l < 0.2-1e-6 || l > 0.5+1e-6 {
+				fail(ht, "WarmColor = %s (c %v l %v)", cstr(c), ch, l)
+			}
+			c = colorful.HappyColorWithRand(rnd)
+			_, ch, l = c.Hcl()
+			if !c.IsValid() || ch < 0.5-1e-6 || ch > 0.8+1e-6 || l < 0.5-1e-6 || l > 0.8+1e-6 {
+				fail(ht, "HappyColor = %s (c %v l %v)", cstr(c), ch, l)
+			}
+		}
+		// Palettes: the asked count, all valid, in the documented ranges.
+		k := n(ht, 0, 12)
+		for _, p := range []struct {
+			name                   string
+			cs                     []colorful.Color
+			smin, smax, vmin, vmax float64
+		}{
+			{"FastWarmPalette", colorful.FastWarmPaletteWithRand(k, rnd), 0.55, 0.75, 0.35, 0.55},
+			{"FastHappyPalette", colorful.FastHappyPaletteWithRand(k, rnd), 0.8, 1, 0.65, 0.85},
+		} {
+			if len(p.cs) != k {
+				fail(ht, "%s(%d) has %d colours", p.name, k, len(p.cs))
+			}
+			for i, c := range p.cs {
+				h, s, v := c.Hsv()
+				wantH := float64(i) * 360 / float64(k)
+				if !c.IsValid() || s < p.smin-1e-9 || s > p.smax+1e-9 || v < p.vmin-1e-9 || v > p.vmax+1e-9 || !angleClose(h, wantH, 1e-6) {
+					fail(ht, "%s(%d)[%d] = %s (h %v s %v v %v), hue expected %v", p.name, k, i, cstr(c), h, s, v, wantH)
+				}
+			}
+		}
+		if k > 0 {
+			for _, p := range []struct {
+				name string
+				f    func(int, colorful.RandInterface) ([]colorful.Color, error)
+			}{
+				{"WarmPalette", colorful.WarmPaletteWithRand},
+				{"HappyPalette", colorful.HappyPaletteWithRand},
+				{"SoftPalette", colorful.SoftPaletteWithRand},
+			} {
+				cs, err := p.f(k, rnd)
+				if err != nil || len(cs) != k {
+					fail(ht, "%s(%d): %d colours, %v", p.name, k, len(cs), err)
+				}
+				for i, c := range cs {
+					if !c.IsValid() {
+						fail(ht, "%s(%d)[%d] = %s is not valid", p.name, k, i, cstr(c))
+					}
+				}
+			}
+		}
+		// Sorted is a permutation that starts at the darkest colour.
+		m := n(ht, 0, 9)
+		cs := make([]colorful.Color, m)
+		for i := range cs {
+			if i > 0 && chance(ht, 15) {
+				cs[i] = cs[n(ht, 0, i-1)]
+			} else {
+				cs[i] = genColor(ht)
+			}
+		}
+		orig := append([]colorful.Color(nil), cs...)
+		sorted := colorful.Sorted(cs)
+		if !sameMultiset(orig, cs) {
+			fail(ht, "Sorted changed its input: %v -> %v", orig, cs)
+		}
+		if !sameMultiset(orig, sorted) {
+			fail(ht, "Sorted(%v) = %v is not a permutation", orig, sorted)
+		}
+		if m > 0 {
+			var black colorful.Color
+			best := math.MaxFloat64
+			for _, c := range orig {
+				best = math.Min(best, black.DistanceCIEDE2000(c))
+			}
+			if d := black.DistanceCIEDE2000(sorted[0]); d > best+1e-12 {
+				fail(ht, "Sorted(%v) starts with %s (distance from black %v), the darkest is at %v", orig, cstr(sorted[0]), d, best)
+			}
+		}
+	})
+}
+
+func sameMultiset(a, b []colorful.Color) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	key := func(cs []colorful.Color) []string {
+		ks := make([]string, len(cs))
+		for i, c := range cs {
+			ks[i] = cstr(c)
+		}
+		sort.Strings(ks)
+		return ks
+	}
+	ka, kb := key(a), key(b)
+	for i := range ka {
+		if ka[i] != kb[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// The white points of the wide-gamut spaces and the Bradford adaptation.
+
+func TestHegelWhitePointsAndAdaptation(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Bradford is invertible.
+		x, y, z := unit(ht), unit(ht), unit(ht)*1.1
+		bx, by, bz := colorful.D50ToD65(colorful.D65ToD50(x, y, z))
+		// The two matrices agree to about seven digits only (see the README).
+		if !tripleClose(vec3{bx, by, bz}, vec3{x, y, z}, 1e-6) {
+			fail(ht, "D50ToD65(D65ToD50(%v %v %v)) = %v %v %v", x, y, z, bx, by, bz)
+		}
+		if got := triple(colorful.D65ToD50(x, y, z)); !tripleClose(got, mul(mD65ToD50, vec3{x, y, z}), tight) {
+			fail(ht, "D65ToD50(%v %v %v) = %v, CSS matrix %v", x, y, z, got, mul(mD65ToD50, vec3{x, y, z}))
+		}
+		if got := triple(colorful.D50ToD65(x, y, z)); !tripleClose(got, mul(mD50ToD65, vec3{x, y, z}), 1e-6) {
+			fail(ht, "D50ToD65(%v %v %v) = %v, inverse CSS matrix %v", x, y, z, got, mul(mD50ToD65, vec3{x, y, z}))
+		}
+		// Greys stay greys in every RGB space sharing the D65 white, and in
+		// ProPhoto (D50) through the adaptation.
+		g := unit(ht)
+		grey := colorful.Color{R: g, G: g, B: g}
+		for _, s := range []struct {
+			name string
+			f    func(colorful.Color) (float64, float64, float64)
+		}{
+			{"DisplayP3", colorful.Color.DisplayP3},
+			{"A98Rgb", colorful.Color.A98Rgb},
+			{"Rec2020", colorful.Color.Rec2020},
+			{"ProPhotoRgb", colorful.Color.ProPhotoRgb},
+		} {
+			r, gg, b := s.f(grey)
+			if !approx(r, gg, 1e-4) || !approx(gg, b, 1e-4) {
+				fail(ht, "%s of grey %v = (%v %v %v)", s.name, g, r, gg, b)
+			}
+		}
+		// The library's white is (1, 1, 1) in every wide-gamut space.
+		white := colorful.Color{R: 1, G: 1, B: 1}
+		for _, s := range []struct {
+			name string
+			f    func(colorful.Color) (float64, float64, float64)
+		}{
+			{"DisplayP3", colorful.Color.DisplayP3},
+			{"A98Rgb", colorful.Color.A98Rgb},
+			{"Rec2020", colorful.Color.Rec2020},
+			{"ProPhotoRgb", colorful.Color.ProPhotoRgb},
+		} {
+			if got := triple(s.f(white)); !tripleClose(got, vec3{1, 1, 1}, 1e-4) {
+				fail(ht, "%s of white = %v", s.name, got)
+			}
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..ca66ea6
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,313 @@
+package colorful_test
+
+// Hegel properties for go-colorful: colour-space conversions against an
+// independent model of the standard formulas (sRGB, CIE XYZ/xyY/L*a*b*/
+// L*u*v*, their cylindrical forms, Oklab, CIE94 and CIEDE2000) and against
+// Python's colorsys (HSV/HSL), plus the library's own round trips, blends,
+// distances, palettes and sorting.
+//
+// python3 is the only external oracle; the property needing it skips when
+// it is missing.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	colorful "github.com/lucasb-eyer/go-colorful"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	hueZeroed  bool // go-colorful/1: LabToHcl and LuvToLuvLCh report hue 0 when a ≈ b or |a| ≤ 1e-4, whatever the chroma
+	hue360     bool // go-colorful/2: Hsv() and Hsl() return h == 360 for a hue just below 360, and Hsv(360, s, v) is grey
+	luvLChGrey bool // go-colorful/3: BlendLuvLCh has no grey rule (BlendHsv, BlendHcl and BlendOkLch take the other colour's hue)
+	okLabRound bool // go-colorful/4: the OkLab inverse matrices do not invert the forward ones; OkLab(c.OkLab()) is off by up to 4e-3
+}{hueZeroed: true, hue360: true, luvLChGrey: true, okLabRound: true}
+
+// okTol is the tolerance of an RGB comparison through the OkLab inverse.
+func okTol() float64 {
+	if Known.okLabRound {
+		return 5e-3
+	}
+	return loose
+}
+
+// okLabTol is the tolerance of an OkLab-coordinate comparison through the
+// inverse.
+func okLabTol() float64 {
+	if Known.okLabRound {
+		return 5e-4
+	}
+	return loose
+}
+
+// hueShape is the input shape of go-colorful/1: a rectangular pair whose
+// hue the library zeroes.
+func hueShape(a, b float64) bool { return math.Abs(b-a) <= 1e-4 || math.Abs(a) <= 1e-4 }
+
+// hclShape and lchShape say whether a colour's Lab (Luv) pair has that shape.
+func hclShape(c colorful.Color) bool { _, a, b := c.Lab(); return hueShape(a, b) }
+func lchShape(c colorful.Color) bool { _, u, v := c.Luv(); return hueShape(u, v) }
+
+// hclShapeW and lchShapeW are the same under another reference white.
+func hclShapeW(c colorful.Color, w [3]float64) bool {
+	_, a, b := c.LabWhiteRef(w)
+	return hueShape(a, b)
+}
+func lchShapeW(c colorful.Color, w [3]float64) bool {
+	_, u, v := c.LuvWhiteRef(w)
+	return hueShape(u, v)
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// unit draws a number in [0, 1]: an 8-bit or 4-bit level, a fine random
+// value, or an edge (the transfer-function thresholds, near 0 and 1).
+func unit(tc hegel.TestCase) float64 {
+	switch n(tc, 0, 9) {
+	case 0, 1, 2:
+		return float64(n(tc, 0, 255)) / 255
+	case 3:
+		return float64(n(tc, 0, 15)) / 15
+	case 4:
+		return pick(tc, 0.0, 1.0, 0.5, 1e-7, 1-1e-7, 0.04045, 0.04045+1e-9, 0.04045-1e-9, 0.0031308, 0.5-1e-16, 0.5+1e-16, 0.25, 0.75, 1e-3, 0.999)
+	default:
+		return float64(n(tc, 0, 1_000_000_000)) / 1e9
+	}
+}
+
+// genColor draws a valid sRGB colour, with a bias towards greys, colours
+// with two equal channels (the HSV sector edges), primaries and near-greys.
+func genColor(tc hegel.TestCase) colorful.Color {
+	r, g, b := unit(tc), unit(tc), unit(tc)
+	switch n(tc, 0, 9) {
+	case 0: // grey
+		g, b = r, r
+	case 1: // two equal channels
+		switch n(tc, 0, 2) {
+		case 0:
+			g = r
+		case 1:
+			b = r
+		default:
+			b = g
+		}
+	case 2: // near grey
+		d := float64(n(tc, -1000, 1000)) / 1e9
+		g = clamp01(r + d)
+		b = clamp01(r - d)
+	case 3: // primaries and secondaries
+		r, g, b = float64(n(tc, 0, 1)), float64(n(tc, 0, 1)), float64(n(tc, 0, 1))
+	}
+	return colorful.Color{R: r, G: g, B: b}
+}
+
+// genAnyColor draws a colour whose channels may lie outside [0, 1].
+func genAnyColor(tc hegel.TestCase) colorful.Color {
+	if chance(tc, 60) {
+		return genColor(tc)
+	}
+	f := func() float64 { return float64(n(tc, -500_000_000, 1_500_000_000)) / 1e9 }
+	return colorful.Color{R: f(), G: f(), B: f()}
+}
+
+func clamp01(v float64) float64 { return math.Max(0, math.Min(1, v)) }
+
+// signed draws a number in [-m, m] at a resolution of 1e-9.
+func signed(tc hegel.TestCase, m float64) float64 {
+	return float64(n(tc, -1_000_000_000, 1_000_000_000)) / 1e9 * m
+}
+
+// t01 draws an interpolation parameter with the ends and the middle favoured.
+func t01(tc hegel.TestCase) float64 {
+	if chance(tc, 40) {
+		return pick(tc, 0.0, 1.0, 0.5)
+	}
+	return float64(n(tc, 0, 1_000_000)) / 1e6
+}
+
+// ---------------------------------------------------------------------------
+// Comparisons.
+
+func approx(a, b, tol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) || math.IsInf(a, 0) || math.IsInf(b, 0) {
+		return false
+	}
+	return math.Abs(a-b) <= tol
+}
+
+func colorClose(a, b colorful.Color, tol float64) bool {
+	return approx(a.R, b.R, tol) && approx(a.G, b.G, tol) && approx(a.B, b.B, tol)
+}
+
+// angleClose compares two angles in degrees modulo 360.
+func angleClose(a, b, tol float64) bool {
+	d := math.Mod(math.Abs(a-b), 360)
+	return d <= tol || 360-d <= tol
+}
+
+func triple(a, b, c float64) [3]float64 { return [3]float64{a, b, c} }
+
+func tripleClose(a, b [3]float64, tol float64) bool {
+	return approx(a[0], b[0], tol) && approx(a[1], b[1], tol) && approx(a[2], b[2], tol)
+}
+
+func cstr(c colorful.Color) string { return fmt.Sprintf("{%.17g %.17g %.17g}", c.R, c.G, c.B) }
+
+// ---------------------------------------------------------------------------
+// Python's colorsys.
+
+var havePython = func() bool {
+	_, err := exec.LookPath("python3")
+	return err == nil
+}()
+
+const colorsysScript = `
+import sys, json, colorsys
+q = json.load(sys.stdin)
+out = {
+  "hsv": [list(colorsys.rgb_to_hsv(*c)) for c in q["rgb"]],
+  "hls": [list(colorsys.rgb_to_hls(*c)) for c in q["rgb"]],
+  "fromhsv": [list(colorsys.hsv_to_rgb(*c)) for c in q["hsv"]],
+  "fromhls": [list(colorsys.hls_to_rgb(*c)) for c in q["hls"]],
+}
+json.dump(out, sys.stdout)
+`
+
+type colorsysAnswer struct {
+	HSV     [][3]float64 `json:"hsv"`
+	HLS     [][3]float64 `json:"hls"`
+	FromHSV [][3]float64 `json:"fromhsv"`
+	FromHLS [][3]float64 `json:"fromhls"`
+}
+
+// colorsys asks Python for the HSV and HLS of every rgb triple and the RGB
+// of every hsv and hls triple (hue as a fraction of the circle).
+func colorsys(rgb, hsv, hls [][3]float64) (colorsysAnswer, error) {
+	var ans colorsysAnswer
+	q, _ := json.Marshal(map[string]any{"rgb": rgb, "hsv": hsv, "hls": hls})
+	cmd := exec.Command("python3", "-c", colorsysScript)
+	cmd.Stdin = bytes.NewReader(q)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		return ans, fmt.Errorf("python3: %v: %s", err, stderr.String())
+	}
+	if err := json.Unmarshal(out, &ans); err != nil {
+		return ans, fmt.Errorf("python3 output: %v", err)
+	}
+	return ans, nil
+}
+
+// ---------------------------------------------------------------------------
+// A deterministic RandInterface for the generators and palettes.
+
+type lcg struct{ s uint64 }
+
+func (r *lcg) Float64() float64 {
+	r.s = r.s*6364136223846793005 + 1442695040888963407
+	return float64(r.s>>11) / (1 << 53)
+}
+
+func (r *lcg) Intn(n int) int {
+	r.s = r.s*6364136223846793005 + 1442695040888963407
+	return int(r.s>>33) % n
+}
