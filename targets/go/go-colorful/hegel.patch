+// ---------------------------------------------------------------------------
+// Distances.
+
+func TestHegelDistancesBehave(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a, b, c := genColor(ht), genColor(ht), genColor(ht)
+		if chance(ht, 10) {
+			b = a
+		}
+		note(ht, "a = %s b = %s c = %s", cstr(a), cstr(b), cstr(c))
+		la, lb := mXYZToLab(mToXYZ(v3(a)), mD65), mXYZToLab(mToXYZ(v3(b)), mD65)
+		// Against the model.
+		if d, m := a.DistanceCIE94(b), mCIE94(la, lb); !approx(d, m, loose) {
+			fail(ht, "DistanceCIE94(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		if d, m := a.DistanceCIEDE2000(b), mCIEDE2000(la, lb, 1, 1, 1); !approx(d, m, loose) {
+			fail(ht, "DistanceCIEDE2000(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		kl, kc, kh := pick(ht, 1.0, 2.0, 0.5), pick(ht, 1.0, 2.0, 0.5), pick(ht, 1.0, 2.0, 0.5)
+		if d, m := a.DistanceCIEDE2000klch(b, kl, kc, kh), mCIEDE2000(la, lb, kl, kc, kh); !approx(d, m, loose) {
+			fail(ht, "DistanceCIEDE2000klch(%s, %s, %v %v %v) = %v, model %v", cstr(a), cstr(b), kl, kc, kh, d, m)
+		}
+		if d, m := a.DistanceRiemersma(b), mRiemersma(v3(a), v3(b)); !approx(d, m, tight) {
+			fail(ht, "DistanceRiemersma(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		euclid := func(x, y vec3) float64 { return math.Sqrt(sq(x[0]-y[0]) + sq(x[1]-y[1]) + sq(x[2]-y[2])) }
+		if d, m := a.DistanceLab(b), euclid(la, lb); !approx(d, m, loose) {
+			fail(ht, "DistanceLab(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		if d, m := a.DistanceLuv(b), euclid(mXYZToLuv(mToXYZ(v3(a)), mD65), mXYZToLuv(mToXYZ(v3(b)), mD65)); !approx(d, m, loose) {
+			fail(ht, "DistanceLuv(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		if d, m := a.DistanceLinearRgb(b), euclid(mToLinear(v3(a)), mToLinear(v3(b))); !approx(d, m, tight) {
+			fail(ht, "DistanceLinearRgb(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		if d, m := a.DistanceRgb(b), euclid(v3(a), v3(b)); !approx(d, m, tight) {
+			fail(ht, "DistanceRgb(%s, %s) = %v, model %v", cstr(a), cstr(b), d, m)
+		}
+		if a.DistanceCIE76(b) != a.DistanceLab(b) || a.DistanceLinearRGB(b) != a.DistanceLinearRgb(b) {
+			fail(ht, "DistanceCIE76/DistanceLinearRGB differ from their twins for %s, %s", cstr(a), cstr(b))
+		}
+		// Metric laws: identity, symmetry (CIE94 is asymmetric by design),
+		// and the triangle inequality for the Euclidean ones.
+		type dist struct {
+			name string
+			f    func(x, y colorful.Color) float64
+			sym  bool
+			tri  bool
+		}
+		dists := []dist{
+			{"DistanceRgb", colorful.Color.DistanceRgb, true, true},
+			{"DistanceLinearRgb", colorful.Color.DistanceLinearRgb, true, true},
+			{"DistanceLab", colorful.Color.DistanceLab, true, true},
+			{"DistanceLuv", colorful.Color.DistanceLuv, true, true},
+			{"DistanceHSLuv", colorful.Color.DistanceHSLuv, true, true},
+			{"DistanceHPLuv", colorful.Color.DistanceHPLuv, true, true},
+			{"DistanceRiemersma", colorful.Color.DistanceRiemersma, true, false},
+			{"DistanceCIE94", colorful.Color.DistanceCIE94, false, false},
+			{"DistanceCIEDE2000", colorful.Color.DistanceCIEDE2000, true, false},
+		}
+		for _, d := range dists {
+			dab := d.f(a, b)
+			if math.IsNaN(dab) || dab < 0 {
+				fail(ht, "%s(%s, %s) = %v", d.name, cstr(a), cstr(b), dab)
+			}
+			if daa := d.f(a, a); !approx(daa, 0, 1e-9) {
+				fail(ht, "%s(a, a) = %v for %s", d.name, daa, cstr(a))
+			}
+			if d.sym && !approx(dab, d.f(b, a), 1e-9) {
+				fail(ht, "%s(%s, %s) = %v but reversed %v", d.name, cstr(a), cstr(b), dab, d.f(b, a))
+			}
+			if d.tri && d.f(a, c) > dab+d.f(b, c)+1e-9 {
+				fail(ht, "%s: d(a, c) = %v > d(a, b) + d(b, c) = %v + %v for %s %s %s", d.name, d.f(a, c), dab, d.f(b, c), cstr(a), cstr(b), cstr(c))
+			}
+		}
+		// AlmostEqualRgb is the L1 test against 3/255.
+		l1 := math.Abs(a.R-b.R) + math.Abs(a.G-b.G) + math.Abs(a.B-b.B)
+		if a.AlmostEqualRgb(b) != (l1 < 3*colorful.Delta) {
+			fail(ht, "AlmostEqualRgb(%s, %s) = %v with L1 %v", cstr(a), cstr(b), a.AlmostEqualRgb(b), l1)
+		}
+	})
+}
+
+func sq(v float64) float64 { return v * v }
+
+// The model and the library on Sharma's CIEDE2000 pairs (four decimals).
+func TestHegelCIEDE2000MatchesSharmaData(t *testing.T) {
+	for i, p := range sharmaPairs {
+		l1 := vec3{p.lab1[0] / 100, p.lab1[1] / 100, p.lab1[2] / 100}
+		l2 := vec3{p.lab2[0] / 100, p.lab2[1] / 100, p.lab2[2] / 100}
+		if m := mCIEDE2000(l1, l2, 1, 1, 1) * 100; math.Abs(m-p.dE) > 5e-5 {
+			t.Errorf("pair %d: model %.4f, Sharma %.4f", i, m, p.dE)
+		}
+		c1 := colorful.Lab(l1[0], l1[1], l1[2])
+		c2 := colorful.Lab(l2[0], l2[1], l2[2])
+		// Through RGB and back the Lab values move by ~1e-12 only.
+		if d := c1.DistanceCIEDE2000(c2) * 100; math.Abs(d-p.dE) > 5e-5 {
+			t.Errorf("pair %d: DistanceCIEDE2000 %.4f, Sharma %.4f", i, d, p.dE)
+		}
+	}
+}
