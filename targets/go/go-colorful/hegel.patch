+// Blends.
+
+func TestHegelBlendsInterpolate(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c1, c2 := genColor(ht), genColor(ht)
+		if chance(ht, 10) {
+			c2 = c1
+		}
+		tt := t01(ht)
+		note(ht, "c1 = %s c2 = %s t = %v", cstr(c1), cstr(c2), tt)
+		type blend struct {
+			name  string
+			f     func(a, b colorful.Color, t float64) colorful.Color
+			clamp bool
+		}
+		blends := []blend{
+			{"BlendRgb", colorful.Color.BlendRgb, false},
+			{"BlendLinearRgb", colorful.Color.BlendLinearRgb, false},
+			{"BlendHsv", colorful.Color.BlendHsv, false},
+			{"BlendLab", colorful.Color.BlendLab, false},
+			{"BlendLuv", colorful.Color.BlendLuv, false},
+			{"BlendHcl", colorful.Color.BlendHcl, true},
+			{"BlendLuvLCh", colorful.Color.BlendLuvLCh, false},
+			{"BlendOkLab", colorful.Color.BlendOkLab, false},
+			{"BlendOkLch", colorful.Color.BlendOkLch, true},
+			{"BlendDisplayP3", colorful.Color.BlendDisplayP3, false},
+			{"BlendA98Rgb", colorful.Color.BlendA98Rgb, false},
+			{"BlendProPhotoRgb", colorful.Color.BlendProPhotoRgb, false},
+			{"BlendRec2020", colorful.Color.BlendRec2020, false},
+		}
+		for _, b := range blends {
+			tol := 1e-6
+			switch b.name {
+			case "BlendOkLab", "BlendOkLch":
+				tol = okTol()
+				if _, k1, _ := c1.OkLch(); k1 <= 0.00015 {
+					tol = math.Max(tol, 1e-3)
+				}
+				if _, k2, _ := c2.OkLch(); k2 <= 0.00015 {
+					tol = math.Max(tol, 1e-3)
+				}
+			case "BlendProPhotoRgb":
+				tol = 1e-4 // the Bradford pair, see above
+			case "BlendHcl":
+				if Known.hueZeroed && (hclShape(c1) || hclShape(c2)) {
+					continue
+				}
+				// The grey rule (pull request #60) gives an end of chroma
+				// below 1.5e-4 the other end's hue, moving it a little.
+				if _, k1, _ := c1.Hcl(); k1 <= 0.00015 {
+					tol = 1e-3
+				}
+				if _, k2, _ := c2.Hcl(); k2 <= 0.00015 {
+					tol = 1e-3
+				}
+			case "BlendLuvLCh":
+				if Known.hueZeroed && (lchShape(c1) || lchShape(c2)) {
+					continue
+				}
+			case "BlendHsv":
+				h1, _, _ := c1.Hsv()
+				h2, _, _ := c2.Hsv()
+				if Known.hue360 && (h1 == 360 || h2 == 360) {
+					continue
+				}
+			}
+			// Ends.
+			if got := b.f(c1, c2, 0); !colorClose(got, c1, tol) {
+				fail(ht, "%s(c1, c2, 0) = %s, c1 = %s", b.name, cstr(got), cstr(c1))
+			}
+			if got := b.f(c1, c2, 1); !colorClose(got, c2, tol) {
+				fail(ht, "%s(c1, c2, 1) = %s, c2 = %s", b.name, cstr(got), cstr(c2))
+			}
+			// A colour blended with itself stays.
+			if got := b.f(c1, c1, tt); !colorClose(got, c1, tol) {
+				fail(ht, "%s(c1, c1, %v) = %s, c1 = %s", b.name, tt, cstr(got), cstr(c1))
+			}
+			// Symmetry: blend(c1, c2, t) == blend(c2, c1, 1 - t) — except for
+			// opposite hues in a cylindrical space, where the shorter arc is
+			// ambiguous and each order picks its own.
+			if got, rev := b.f(c1, c2, tt), b.f(c2, c1, 1-tt); !colorClose(got, rev, tol) && !antipodal(b.name, c1, c2) {
+				if !(b.name == "BlendLuvLCh" && Known.luvLChGrey) {
+					fail(ht, "%s(c1, c2, %v) = %s but %s(c2, c1, %v) = %s", b.name, tt, cstr(got), b.name, 1-tt, cstr(rev))
+				}
+			}
+			if b.clamp && !b.f(c1, c2, tt).IsValid() {
+				fail(ht, "%s(c1, c2, %v) = %s is not valid although the blend clamps", b.name, tt, cstr(b.f(c1, c2, tt)))
+			}
+		}
+		// Linear spaces: the midpoint of the coordinates.
+		mid := func(x, y vec3) vec3 { return vec3{(x[0] + y[0]) / 2, (x[1] + y[1]) / 2, (x[2] + y[2]) / 2} }
+		if got, want := v3(c1.BlendRgb(c2, 0.5)), mid(v3(c1), v3(c2)); !tripleClose(got, want, tight) {
+			fail(ht, "BlendRgb midpoint of %s %s = %v, want %v", cstr(c1), cstr(c2), got, want)
+		}
+		if got, want := triple(c1.BlendLab(c2, 0.5).Lab()), mid(triple(c1.Lab()), triple(c2.Lab())); !tripleClose(got, want, loose) {
+			fail(ht, "BlendLab midpoint of %s %s has Lab %v, want %v", cstr(c1), cstr(c2), got, want)
+		}
+		if got, want := triple(c1.BlendLuv(c2, 0.5).Luv()), mid(triple(c1.Luv()), triple(c2.Luv())); !tripleClose(got, want, loose) {
+			fail(ht, "BlendLuv midpoint of %s %s has Luv %v, want %v", cstr(c1), cstr(c2), got, want)
+		}
+		if got, want := triple(c1.BlendOkLab(c2, 0.5).OkLab()), mid(triple(c1.OkLab()), triple(c2.OkLab())); !tripleClose(got, want, okLabTol()) {
+			fail(ht, "BlendOkLab midpoint of %s %s has OkLab %v, want %v", cstr(c1), cstr(c2), got, want)
+		}
+		if got, want := triple(c1.BlendLinearRgb(c2, 0.5).LinearRgb()), mid(triple(c1.LinearRgb()), triple(c2.LinearRgb())); !tripleClose(got, want, loose) {
+			fail(ht, "BlendLinearRgb midpoint of %s %s has LinearRgb %v, want %v", cstr(c1), cstr(c2), got, want)
+		}
+		// Cylindrical spaces: the hue walks the shorter arc, chroma and
+		// lightness linearly; a grey end takes the other end's hue.
+		h1, s1, v1 := c1.Hsv()
+		h2, s2, v2 := c2.Hsv()
+		if s1 > 1e-9 && s2 > 1e-9 && v1 > 1e-9 && v2 > 1e-9 && !(Known.hue360 && (h1 == 360 || h2 == 360)) {
+			want := colorful.Hsv(arc(h1, h2, tt), s1+tt*(s2-s1), v1+tt*(v2-v1))
+			if got := c1.BlendHsv(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendHsv(%s, %s, %v) = %s, shorter-arc model %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		} else if s1 <= 1e-9 && s2 > 1e-9 && v1 > 1e-9 && v2 > 1e-9 && !(Known.hue360 && h2 == 360) {
+			want := colorful.Hsv(h2, s1+tt*(s2-s1), v1+tt*(v2-v1))
+			if got := c1.BlendHsv(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendHsv(grey %s, %s, %v) = %s, expected the hue of c2: %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		}
+		H1, C1, L1 := c1.Hcl()
+		H2, C2, L2 := c2.Hcl()
+		hclGate := Known.hueZeroed && (hclShape(c1) || hclShape(c2))
+		lchGate := Known.hueZeroed && (lchShape(c1) || lchShape(c2))
+		if hclGate {
+			C1, C2 = 0, 0
+		}
+		if C1 > 1e-3 && C2 > 1e-3 {
+			want := colorful.Hcl(arc(H1, H2, tt), C1+tt*(C2-C1), L1+tt*(L2-L1)).Clamped()
+			if got := c1.BlendHcl(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendHcl(%s, %s, %v) = %s, shorter-arc model %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		} else if C1 <= 1e-4 && C2 > 1e-3 {
+			want := colorful.Hcl(H2, C1+tt*(C2-C1), L1+tt*(L2-L1)).Clamped()
+			if got := c1.BlendHcl(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendHcl(grey %s, %s, %v) = %s, expected the hue of c2: %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		}
+		L1, C1, H1 = c1.LuvLCh()
+		L2, C2, H2 = c2.LuvLCh()
+		if lchGate {
+			C1, C2 = 0, 0
+		}
+		if C1 > 1e-3 && C2 > 1e-3 {
+			want := colorful.LuvLCh(L1+tt*(L2-L1), C1+tt*(C2-C1), arc(H1, H2, tt))
+			if got := c1.BlendLuvLCh(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendLuvLCh(%s, %s, %v) = %s, shorter-arc model %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		} else if C1 <= 1e-4 && C2 > 1e-3 && !Known.luvLChGrey {
+			want := colorful.LuvLCh(L1+tt*(L2-L1), C1+tt*(C2-C1), H2)
+			if got := c1.BlendLuvLCh(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendLuvLCh(grey %s, %s, %v) = %s, expected the hue of c2: %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		}
+		L1, C1, H1 = c1.OkLch()
+		L2, C2, H2 = c2.OkLch()
+		if C1 > 1e-3 && C2 > 1e-3 {
+			want := colorful.OkLch(L1+tt*(L2-L1), C1+tt*(C2-C1), arc(H1, H2, tt)).Clamped()
+			if got := c1.BlendOkLch(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendOkLch(%s, %s, %v) = %s, shorter-arc model %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		} else if C1 <= 1e-4 && C2 > 1e-3 {
+			want := colorful.OkLch(L1+tt*(L2-L1), C1+tt*(C2-C1), H2).Clamped()
+			if got := c1.BlendOkLch(c2, tt); !colorClose(got, want, loose) {
+				fail(ht, "BlendOkLch(grey %s, %s, %v) = %s, expected the hue of c2: %s", cstr(c1), cstr(c2), tt, cstr(got), cstr(want))
+			}
+		}
+	})
+}
+
+// antipodal says whether the two colours' hues in the blend's space are
+// (within rounding) 180 degrees apart.
+func antipodal(blend string, c1, c2 colorful.Color) bool {
+	var h1, h2 float64
+	switch blend {
+	case "BlendHsv":
+		h1, _, _ = c1.Hsv()
+		h2, _, _ = c2.Hsv()
+	case "BlendHcl":
+		h1, _, _ = c1.Hcl()
+		h2, _, _ = c2.Hcl()
+	case "BlendLuvLCh":
+		_, _, h1 = c1.LuvLCh()
+		_, _, h2 = c2.LuvLCh()
+	case "BlendOkLch":
+		_, _, h1 = c1.OkLch()
+		_, _, h2 = c2.OkLch()
+	default:
+		return false
+	}
+	return math.Abs(math.Mod(math.Abs(h1-h2), 360)-180) < 1e-6
+}
+
+// arc interpolates two angles along the shorter arc.
+func arc(a, b, t float64) float64 {
+	d := math.Mod(b-a+540, 360) - 180
+	h := math.Mod(a+t*d+360, 360)
+	return h
+}
