diff --git a/hegel_model_test.go b/hegel_model_test.go
new file mode 100644
index 0000000..01ee349
--- /dev/null
+++ b/hegel_model_test.go
@@ -0,0 +1,330 @@
+package colorful_test
+
+// An independent model of the colour-space formulas go-colorful implements:
+// the sRGB transfer function and matrix (IEC 61966-2-1 / CSS Color 4), CIE
+// xyY, L*a*b*, L*u*v* and their cylindrical forms (CIE 15:2004, with the
+// library's scaling: L*, a*, b*, u*, v* divided by 100), Oklab (Ottosson
+// 2020), the Bradford D65/D50 adaptation (CSS Color 4), CIE94 (graphic
+// arts) and CIEDE2000 (Sharma, Wu and Dalal 2005), plus the Riemersma
+// metric (compuphase.com/cmetric.htm).
+
+import "math"
+
+type vec3 = [3]float64
+type mat3 = [3]vec3
+
+func mul(m mat3, v vec3) vec3 {
+	return vec3{
+		m[0][0]*v[0] + m[0][1]*v[1] + m[0][2]*v[2],
+		m[1][0]*v[0] + m[1][1]*v[1] + m[1][2]*v[2],
+		m[2][0]*v[0] + m[2][1]*v[1] + m[2][2]*v[2],
+	}
+}
+
+// inv inverts a 3x3 matrix by cofactors.
+func inv(m mat3) mat3 {
+	a, b, c := m[0][0], m[0][1], m[0][2]
+	d, e, f := m[1][0], m[1][1], m[1][2]
+	g, h, i := m[2][0], m[2][1], m[2][2]
+	det := a*(e*i-f*h) - b*(d*i-f*g) + c*(d*h-e*g)
+	return mat3{
+		{(e*i - f*h) / det, (c*h - b*i) / det, (b*f - c*e) / det},
+		{(f*g - d*i) / det, (a*i - c*g) / det, (c*d - a*f) / det},
+		{(d*h - e*g) / det, (b*g - a*h) / det, (a*e - b*d) / det},
+	}
+}
+
+// The library's reference whites.
+var (
+	mD65 = vec3{0.95047, 1.00000, 1.08883}
+	mD50 = vec3{0.96422, 1.00000, 0.82521}
+)
+
+// sRGB (D65) to XYZ, CSS Color 4 / IEC 61966-2-1 with the primaries' exact
+// rational derivation.
+var mRGB2XYZ = mat3{
+	{0.41239079926595934, 0.357584339383878, 0.1804807884018343},
+	{0.21263900587151027, 0.715168678767756, 0.07219231536073371},
+	{0.01933081871559182, 0.11919477979462598, 0.9505321522496607},
+}
+var mXYZ2RGB = inv(mRGB2XYZ)
+
+func mLinearize(v float64) float64 {
+	if v <= 0.04045 {
+		return v / 12.92
+	}
+	return math.Pow((v+0.055)/1.055, 2.4)
+}
+
+func mDelinearize(v float64) float64 {
+	if v <= 0.0031308 {
+		return 12.92 * v
+	}
+	return 1.055*math.Pow(v, 1/2.4) - 0.055
+}
+
+func mToLinear(c vec3) vec3 { return vec3{mLinearize(c[0]), mLinearize(c[1]), mLinearize(c[2])} }
+
+func mFromLinear(c vec3) vec3 {
+	return vec3{mDelinearize(c[0]), mDelinearize(c[1]), mDelinearize(c[2])}
+}
+
+func mToXYZ(c vec3) vec3   { return mul(mRGB2XYZ, mToLinear(c)) }
+func mFromXYZ(x vec3) vec3 { return mFromLinear(mul(mXYZ2RGB, x)) }
+
+// xyY; black takes the white's chromaticity (Lindbloom).
+func mXYZToxyY(x vec3, w vec3) vec3 {
+	s := x[0] + x[1] + x[2]
+	if math.Abs(s) < 1e-14 {
+		ws := w[0] + w[1] + w[2]
+		return vec3{w[0] / ws, w[1] / ws, x[1]}
+	}
+	return vec3{x[0] / s, x[1] / s, x[1]}
+}
+
+func mxyYToXYZ(c vec3) vec3 {
+	if math.Abs(c[1]) < 1e-14 {
+		return vec3{0, c[2], 0}
+	}
+	return vec3{c[2] / c[1] * c[0], c[2], c[2] / c[1] * (1 - c[0] - c[1])}
+}
+
+// L*a*b* (CIE 15:2004), scaled by 1/100.
+const (
+	labEps   = 216.0 / 24389.0 // (6/29)^3
+	labKappa = 24389.0 / 27.0  // (29/3)^3
+)
+
+func labF(t float64) float64 {
+	if t > labEps {
+		return math.Cbrt(t)
+	}
+	return (labKappa*t + 16) / 116
+}
+
+func labFInv(t float64) float64 {
+	if t > 6.0/29.0 {
+		return t * t * t
+	}
+	return (116*t - 16) / labKappa
+}
+
+func mXYZToLab(x vec3, w vec3) vec3 {
+	fx, fy, fz := labF(x[0]/w[0]), labF(x[1]/w[1]), labF(x[2]/w[2])
+	return vec3{(116*fy - 16) / 100, 500 * (fx - fy) / 100, 200 * (fy - fz) / 100}
+}
+
+func mLabToXYZ(c vec3, w vec3) vec3 {
+	L, a, b := c[0]*100, c[1]*100, c[2]*100
+	fy := (L + 16) / 116
+	fx := fy + a/500
+	fz := fy - b/200
+	return vec3{w[0] * labFInv(fx), w[1] * labFInv(fy), w[2] * labFInv(fz)}
+}
+
+// L*u*v* (CIE 15:2004), scaled by 1/100.
+func uvPrime(x vec3) (float64, float64) {
+	d := x[0] + 15*x[1] + 3*x[2]
+	if d == 0 {
+		return 0, 0
+	}
+	return 4 * x[0] / d, 9 * x[1] / d
+}
+
+func mXYZToLuv(x vec3, w vec3) vec3 {
+	yr := x[1] / w[1]
+	var L float64
+	if yr > labEps {
+		L = 116*math.Cbrt(yr) - 16
+	} else {
+		L = labKappa * yr
+	}
+	up, vp := uvPrime(x)
+	un, vn := uvPrime(w)
+	return vec3{L / 100, 13 * L * (up - un) / 100, 13 * L * (vp - vn) / 100}
+}
+
+func mLuvToXYZ(c vec3, w vec3) vec3 {
+	L, u, v := c[0]*100, c[1]*100, c[2]*100
+	if L == 0 {
+		return vec3{0, 0, 0}
+	}
+	var Y float64
+	if L > labKappa*labEps {
+		Y = w[1] * math.Pow((L+16)/116, 3)
+	} else {
+		Y = w[1] * L / labKappa
+	}
+	un, vn := uvPrime(w)
+	up := u/(13*L) + un
+	vp := v/(13*L) + vn
+	X := Y * 9 * up / (4 * vp)
+	Z := Y * (12 - 3*up - 20*vp) / (4 * vp)
+	return vec3{X, Y, Z}
+}
+
+// Polar forms: (L, a, b) -> (h, C, L) for HCL, (L, C, h) for LCh(uv).
+func mPolar(a, b float64) (h, c float64) {
+	c = math.Hypot(a, b)
+	h = math.Atan2(b, a) * 180 / math.Pi
+	if h < 0 {
+		h += 360
+	}
+	if h >= 360 {
+		h -= 360
+	}
+	return h, c
+}
+
+func mRect(h, c float64) (a, b float64) {
+	r := h * math.Pi / 180
+	return c * math.Cos(r), c * math.Sin(r)
+}
+
+// Oklab (Ottosson 2020): XYZ -> LMS -> cube root -> Lab.
+var mOkM1 = mat3{
+	{0.8189330101, 0.3618667424, -0.1288597137},
+	{0.0329845436, 0.9293118715, 0.0361456387},
+	{0.0482003018, 0.2643662691, 0.6338517070},
+}
+var mOkM2 = mat3{
+	{0.2104542553, 0.7936177850, -0.0040720468},
+	{1.9779984951, -2.4285922050, 0.4505937099},
+	{0.0259040371, 0.7827717662, -0.8086757660},
+}
+var (
+	mOkM1Inv = inv(mOkM1)
+	mOkM2Inv = inv(mOkM2)
+)
+
+func mXYZToOkLab(x vec3) vec3 {
+	lms := mul(mOkM1, x)
+	for i := range lms {
+		lms[i] = math.Cbrt(lms[i])
+	}
+	return mul(mOkM2, lms)
+}
+
+func mOkLabToXYZ(c vec3) vec3 {
+	lms := mul(mOkM2Inv, c)
+	for i := range lms {
+		lms[i] = lms[i] * lms[i] * lms[i]
+	}
+	return mul(mOkM1Inv, lms)
+}
+
+// Bradford adaptation between D65 and D50 (CSS Color 4 matrices).
+var mD65ToD50 = mat3{
+	{1.0479298208405488, 0.022946793341019088, -0.05019222954313557},
+	{0.029627815688159344, 0.990434484573249, -0.01707382502938514},
+	{-0.009243058152591178, 0.015055144896577895, 0.7518742899580008},
+}
+var mD50ToD65 = inv(mD65ToD50)
+
+// CIE94 (graphic arts, kL = 1, K1 = 0.045, K2 = 0.015) on L*a*b* in the
+// 0..100 scale, with the library's 1/100 result scaling; the first colour
+// is the reference.
+func mCIE94(lab1, lab2 vec3) float64 {
+	L1, a1, b1 := lab1[0]*100, lab1[1]*100, lab1[2]*100
+	L2, a2, b2 := lab2[0]*100, lab2[1]*100, lab2[2]*100
+	dL := L1 - L2
+	C1 := math.Hypot(a1, b1)
+	C2 := math.Hypot(a2, b2)
+	dC := C1 - C2
+	dH2 := (a1-a2)*(a1-a2) + (b1-b2)*(b1-b2) - dC*dC
+	sC := 1 + 0.045*C1
+	sH := 1 + 0.015*C1
+	return math.Sqrt(dL*dL+(dC/sC)*(dC/sC)+dH2/(sH*sH)) / 100
+}
+
+// CIEDE2000 (Sharma, Wu and Dalal 2005) on L*a*b* in the 0..100 scale, with
+// the library's 1/100 result scaling.
+func mCIEDE2000(lab1, lab2 vec3, kL, kC, kH float64) float64 {
+	deg := func(r float64) float64 { return r * 180 / math.Pi }
+	rad := func(d float64) float64 { return d * math.Pi / 180 }
+	L1, a1, b1 := lab1[0]*100, lab1[1]*100, lab1[2]*100
+	L2, a2, b2 := lab2[0]*100, lab2[1]*100, lab2[2]*100
+	C1 := math.Hypot(a1, b1)
+	C2 := math.Hypot(a2, b2)
+	Cbar := (C1 + C2) / 2
+	c7 := math.Pow(Cbar, 7)
+	G := 0.5 * (1 - math.Sqrt(c7/(c7+math.Pow(25, 7))))
+	a1p := (1 + G) * a1
+	a2p := (1 + G) * a2
+	C1p := math.Hypot(a1p, b1)
+	C2p := math.Hypot(a2p, b2)
+	hue := func(ap, b float64) float64 {
+		if ap == 0 && b == 0 {
+			return 0
+		}
+		h := deg(math.Atan2(b, ap))
+		if h < 0 {
+			h += 360
+		}
+		return h
+	}
+	h1p := hue(a1p, b1)
+	h2p := hue(a2p, b2)
+	dLp := L2 - L1
+	dCp := C2p - C1p
+	var dhp float64
+	switch {
+	case C1p*C2p == 0:
+		dhp = 0
+	case math.Abs(h2p-h1p) <= 180:
+		dhp = h2p - h1p
+	case h2p-h1p > 180:
+		dhp = h2p - h1p - 360
+	default:
+		dhp = h2p - h1p + 360
+	}
+	dHp := 2 * math.Sqrt(C1p*C2p) * math.Sin(rad(dhp/2))
+	Lbar := (L1 + L2) / 2
+	Cbarp := (C1p + C2p) / 2
+	var hbar float64
+	switch {
+	case C1p*C2p == 0:
+		hbar = h1p + h2p
+	case math.Abs(h1p-h2p) <= 180:
+		hbar = (h1p + h2p) / 2
+	case h1p+h2p < 360:
+		hbar = (h1p + h2p + 360) / 2
+	default:
+		hbar = (h1p + h2p - 360) / 2
+	}
+	T := 1 - 0.17*math.Cos(rad(hbar-30)) + 0.24*math.Cos(rad(2*hbar)) + 0.32*math.Cos(rad(3*hbar+6)) - 0.20*math.Cos(rad(4*hbar-63))
+	dTheta := 30 * math.Exp(-((hbar-275)/25)*((hbar-275)/25))
+	cp7 := math.Pow(Cbarp, 7)
+	RC := 2 * math.Sqrt(cp7/(cp7+math.Pow(25, 7)))
+	SL := 1 + 0.015*(Lbar-50)*(Lbar-50)/math.Sqrt(20+(Lbar-50)*(Lbar-50))
+	SC := 1 + 0.045*Cbarp
+	SH := 1 + 0.015*Cbarp*T
+	RT := -math.Sin(rad(2*dTheta)) * RC
+	tL := dLp / (kL * SL)
+	tC := dCp / (kC * SC)
+	tH := dHp / (kH * SH)
+	return math.Sqrt(tL*tL+tC*tC+tH*tH+RT*tC*tH) / 100
+}
+
+// Riemersma's metric on 0..1 channels (the 0..255 formula scaled by 1/255).
+func mRiemersma(c1, c2 vec3) float64 {
+	rbar := (c1[0] + c2[0]) / 2
+	dR, dG, dB := c1[0]-c2[0], c1[1]-c2[1], c1[2]-c2[2]
+	return math.Sqrt((2+rbar)*dR*dR + 4*dG*dG + (2+(1-rbar))*dB*dB)
+}
+
+// Sharma's CIEDE2000 test pairs (L*a*b* 0..100; pairs 1, 2, 3, 7, 17, 25 and
+// 34 of the 34) — a check of the model itself, and of the library on the
+// same data.
+var sharmaPairs = []struct {
+	lab1, lab2 vec3
+	dE         float64
+}{
+	{vec3{50.0000, 2.6772, -79.7751}, vec3{50.0000, 0.0000, -82.7485}, 2.0425},
+	{vec3{50.0000, 3.1571, -77.2803}, vec3{50.0000, 0.0000, -82.7485}, 2.8615},
+	{vec3{50.0000, 2.8361, -74.0200}, vec3{50.0000, 0.0000, -82.7485}, 3.4412},
+	{vec3{50.0000, 0.0000, 0.0000}, vec3{50.0000, -1.0000, 2.0000}, 2.3669},
+	{vec3{50.0000, 2.5000, 0.0000}, vec3{73.0000, 25.0000, -18.0000}, 27.1492},
+	{vec3{60.2574, -34.0099, 36.2677}, vec3{60.4626, -34.1751, 39.4387}, 1.2644},
+	{vec3{2.0776, 0.0795, -1.1350}, vec3{0.9033, -0.0636, -0.5514}, 0.9082},
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..1f06a9e
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,96 @@
+package colorful_test
+
+// Deterministic pins for the recorded bugs (bugs.toml). Each asserts the
+// correct behaviour and fails while the bug is open; the properties skip
+// the shape behind the matching Known gate in hegel_test.go.
+
+import (
+	"math"
+	"testing"
+
+	colorful "github.com/lucasb-eyer/go-colorful"
+)
+
+// go-colorful/1: the hue of L*a*b* (L*u*v*) coordinates is atan2(b, a),
+// whatever the chroma; a colour made at hue 45° or 90° reads back with it.
+func TestHegelPinHclHueIsAtan2(t *testing.T) {
+	if h, c, _ := colorful.LabToHcl(0.5, 0.3, 0.3); !approx(h, 45, 1e-9) || !approx(c, 0.3*math.Sqrt2, 1e-9) {
+		t.Errorf("LabToHcl(0.5, 0.3, 0.3) = (%v %v), expected (45 %v)", h, c, 0.3*math.Sqrt2)
+	}
+	if h, _, _ := colorful.LabToHcl(0.5, 0.00005, 0.5); !approx(h, 90, 1e-2) {
+		t.Errorf("LabToHcl(0.5, 0.00005, 0.5) hue = %v, expected about 90", h)
+	}
+	if h, _, _ := colorful.LabToHcl(0.5, -0.2, -0.2); !approx(h, 225, 1e-9) {
+		t.Errorf("LabToHcl(0.5, -0.2, -0.2) hue = %v, expected 225", h)
+	}
+	if _, _, h := colorful.LuvToLuvLCh(0.5, 0.3, 0.3); !approx(h, 45, 1e-9) {
+		t.Errorf("LuvToLuvLCh(0.5, 0.3, 0.3) hue = %v, expected 45", h)
+	}
+	for _, hue := range []float64{45, 90, 225, 270} {
+		c := colorful.Hcl(hue, 0.3, 0.6)
+		if h, _, _ := c.Hcl(); !angleClose(h, hue, 1e-6) {
+			t.Errorf("Hcl(%v, 0.3, 0.6).Hcl() hue = %v", hue, h)
+		}
+		if back := colorful.Hcl(c.Hcl()); !colorClose(back, c, 1e-9) {
+			t.Errorf("Hcl round trip of Hcl(%v, 0.3, 0.6) = %s gives %s", hue, cstr(c), cstr(back))
+		}
+		c = colorful.LuvLCh(0.6, 0.3, hue)
+		if _, _, h := c.LuvLCh(); !angleClose(h, hue, 1e-6) {
+			t.Errorf("LuvLCh(0.6, 0.3, %v).LuvLCh() hue = %v", hue, h)
+		}
+	}
+}
+
+// go-colorful/2: Hsv and Hsl hues lie in [0, 360), and a colour round-trips
+// through Hsv even when its hue is a rounding error below 360.
+func TestHegelPinHsvHueBelow360(t *testing.T) {
+	c := colorful.Color{R: 1, G: 0.4999999999999999, B: 0.5}
+	h, s, v := c.Hsv()
+	if !(0 <= h && h < 360) {
+		t.Errorf("Hsv of %s has hue %v, outside [0, 360)", cstr(c), h)
+	}
+	if back := colorful.Hsv(h, s, v); !colorClose(back, c, 1e-9) {
+		t.Errorf("Hsv(%v %v %v) = %s, expected %s", h, s, v, cstr(back), cstr(c))
+	}
+	if h, _, _ := c.Hsl(); !(0 <= h && h < 360) {
+		t.Errorf("Hsl of %s has hue %v, outside [0, 360)", cstr(c), h)
+	}
+}
+
+// go-colorful/3: blending from a grey in LuvLCh takes the other colour's
+// hue, as BlendHsv, BlendHcl and BlendOkLch do (pull request #60).
+func TestHegelPinBlendLuvLChFromGreyKeepsTheHue(t *testing.T) {
+	grey := colorful.Color{R: 0.5, G: 0.5, B: 0.5}
+	blue := colorful.Color{R: 0.2, G: 0.3, B: 0.9}
+	_, _, hb := blue.LuvLCh()
+	for _, tt := range []float64{0.25, 0.5, 0.75} {
+		got := grey.BlendLuvLCh(blue, tt)
+		_, c, h := got.LuvLCh()
+		if c > 1e-3 && !angleClose(h, hb, 1) {
+			t.Errorf("BlendLuvLCh(grey, blue, %v) = %s has hue %v, blue's is %v", tt, cstr(got), h, hb)
+		}
+		if got.R > got.B {
+			t.Errorf("BlendLuvLCh(grey, blue, %v) = %s is redder than blue", tt, cstr(got))
+		}
+	}
+}
+
+// go-colorful/4: OkLab and OkLch invert each other to double precision, as
+// the other CIE spaces do, so blends start and end at their ends.
+func TestHegelPinOkLabRoundTrips(t *testing.T) {
+	for _, c := range []colorful.Color{{R: 0, G: 1, B: 1}, {R: 0, G: 1, B: 0}, {R: 1, G: 1, B: 0.0196078431372549}, {R: 0.5, G: 0.2, B: 0.7}} {
+		if back := colorful.OkLab(c.OkLab()); !colorClose(back, c, 1e-6) {
+			t.Errorf("OkLab round trip of %s gives %s", cstr(c), cstr(back))
+		}
+		if back := colorful.OkLch(c.OkLch()); !colorClose(back, c, 1e-6) {
+			t.Errorf("OkLch round trip of %s gives %s", cstr(c), cstr(back))
+		}
+		if got := c.BlendOkLab(colorful.Color{R: 1}, 0); !colorClose(got, c, 1e-6) {
+			t.Errorf("BlendOkLab(%s, red, 0) = %s", cstr(c), cstr(got))
+		}
+	}
+	x, y, z := colorful.OkLabToXyz(colorful.XyzToOkLab(0.3, 0.4, 0.5))
+	if !approx(x, 0.3, 1e-9) || !approx(y, 0.4, 1e-9) || !approx(z, 0.5, 1e-9) {
+		t.Errorf("OkLabToXyz(XyzToOkLab(0.3, 0.4, 0.5)) = (%v %v %v)", x, y, z)
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..2d19f0b
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,1060 @@
+package colorful_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+	"testing"
+
+	colorful "github.com/lucasb-eyer/go-colorful"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	tight = 1e-9 // double-precision agreement of the same formulas
+	loose = 1e-6 // agreement after an inverse involving powers and cube roots
+)
+
+// v3 packs a colour as a vector for the model.
+func v3(c colorful.Color) vec3 { return vec3{c.R, c.G, c.B} }
+
+func fromV3(v vec3) colorful.Color { return colorful.Color{R: v[0], G: v[1], B: v[2]} }
+
+// ---------------------------------------------------------------------------
+// Conversions agree with the model.
+
+func TestHegelConversionsMatchTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genColor(ht)
+		note(ht, "c = %s", cstr(c))
+		rgb := v3(c)
+		check := func(what string, got, want vec3, tol float64) {
+			if !tripleClose(got, want, tol) {
+				fail(ht, "%s of %s = %v, model %v", what, cstr(c), got, want)
+			}
+		}
+		check("LinearRgb", triple(c.LinearRgb()), mToLinear(rgb), tight)
+		xyz := mToXYZ(rgb)
+		check("Xyz", triple(c.Xyz()), xyz, tight)
+		check("Xyy", triple(c.Xyy()), mXYZToxyY(xyz, mD65), tight)
+		check("XyyWhiteRef(D50)", triple(c.XyyWhiteRef(colorful.D50)), mXYZToxyY(xyz, mD50), tight)
+		lab := mXYZToLab(xyz, mD65)
+		check("Lab", triple(c.Lab()), lab, tight)
+		check("LabWhiteRef(D50)", triple(c.LabWhiteRef(colorful.D50)), mXYZToLab(xyz, mD50), tight)
+		luv := mXYZToLuv(xyz, mD65)
+		check("Luv", triple(c.Luv()), luv, tight)
+		check("LuvWhiteRef(D50)", triple(c.LuvWhiteRef(colorful.D50)), mXYZToLuv(xyz, mD50), tight)
+		check("OkLab", triple(c.OkLab()), mXYZToOkLab(xyz), loose)
+		check("XyzD50", triple(c.XyzD50()), mul(mD65ToD50, xyz), tight)
+
+		// The polar forms: compared through their rectangular coordinates,
+		// so that a hue of anything at zero chroma is fine.
+		h, ch, l := c.Hcl()
+		a, b := mRect(h, ch)
+		if !(approx(l, lab[0], tight) && approx(a, lab[1], loose) && approx(b, lab[2], loose)) {
+			if !(Known.hueZeroed && (math.Abs(lab[2]-lab[1]) <= 1e-4 || math.Abs(lab[1]) <= 1e-4)) {
+				fail(ht, "Hcl of %s = (%v %v %v), i.e. Lab (%v %v %v); model Lab %v", cstr(c), h, ch, l, l, a, b, lab)
+			}
+		}
+		l, ch, h = c.LuvLCh()
+		u, v := mRect(h, ch)
+		if !(approx(l, luv[0], tight) && approx(u, luv[1], loose) && approx(v, luv[2], loose)) {
+			if !(Known.hueZeroed && (math.Abs(luv[2]-luv[1]) <= 1e-4 || math.Abs(luv[1]) <= 1e-4)) {
+				fail(ht, "LuvLCh of %s = (%v %v %v), i.e. Luv (%v %v %v); model Luv %v", cstr(c), l, ch, h, l, u, v, luv)
+			}
+		}
+		ok := mXYZToOkLab(xyz)
+		l, ch, h = c.OkLch()
+		a, b = mRect(h, ch)
+		if !(approx(l, ok[0], loose) && approx(a, ok[1], loose) && approx(b, ok[2], loose)) {
+			fail(ht, "OkLch of %s = (%v %v %v), i.e. OkLab (%v %v %v); model %v", cstr(c), l, ch, h, l, a, b, ok)
+		}
+		if h < 0 || h >= 360 {
+			fail(ht, "OkLch hue of %s = %v, outside [0, 360)", cstr(c), h)
+		}
+		h, _, _ = c.Hcl()
+		if h < 0 || h >= 360 {
+			fail(ht, "Hcl hue of %s = %v, outside [0, 360)", cstr(c), h)
+		}
+
+		// Constructors from model coordinates give the colour back.
+		check("Xyz(model)", v3(colorful.Xyz(xyz[0], xyz[1], xyz[2])), rgb, loose)
+		check("Lab(model)", v3(colorful.Lab(lab[0], lab[1], lab[2])), rgb, loose)
+		check("Luv(model)", v3(colorful.Luv(luv[0], luv[1], luv[2])), rgb, loose)
+		check("OkLab(model)", v3(colorful.OkLab(ok[0], ok[1], ok[2])), rgb, okTol())
+		xyy := mXYZToxyY(xyz, mD65)
+		check("Xyy(model)", v3(colorful.Xyy(xyy[0], xyy[1], xyy[2])), rgb, loose)
+		lin := mToLinear(rgb)
+		check("LinearRgb(model)", v3(colorful.LinearRgb(lin[0], lin[1], lin[2])), rgb, loose)
+		d50 := mul(mD65ToD50, xyz)
+		check("XyzD50(model)", v3(colorful.XyzD50(d50[0], d50[1], d50[2])), rgb, 1e-4)
+
+		// The fast linearisation is within its advertised half a percent.
+		fr, fg, fb := c.FastLinearRgb()
+		for i, f := range []float64{fr, fg, fb} {
+			if math.Abs(f-lin[i]) > 0.005 && math.Abs(f-lin[i]) > 0.005*lin[i] {
+				fail(ht, "FastLinearRgb of %s channel %d = %v, exact %v", cstr(c), i, f, lin[i])
+			}
+		}
+		// The inverse approximation errs by up to 0.0055 near black (README).
+		back := colorful.FastLinearRgb(lin[0], lin[1], lin[2])
+		for i, f := range []float64{back.R, back.G, back.B} {
+			if math.Abs(f-rgb[i]) > 0.006 {
+				fail(ht, "FastLinearRgb(%v) channel %d = %v, exact %v", lin, i, f, rgb[i])
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// HSV and HSL agree with Python's colorsys.
+
+func TestHegelHsvHslAgreeWithColorsys(t *testing.T) {
+	if !havePython {
+		t.Skip("python3 not found")
+	}
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 24)
+		cs := make([]colorful.Color, k)
+		rgb := make([][3]float64, k)
+		hsv := make([][3]float64, k)
+		hls := make([][3]float64, k)
+		for i := range cs {
+			cs[i] = genColor(ht)
+			rgb[i] = v3(cs[i])
+			// Hue as a fraction, saturation and value/lightness in [0, 1].
+			h := float64(n(ht, 0, 359_999_999)) / 360e6
+			if chance(ht, 15) {
+				h = pick(ht, 0.0, 1.0/6, 1.0/3, 0.5, 2.0/3, 5.0/6, 0.999999999)
+			}
+			hsv[i] = [3]float64{h, unit(ht), unit(ht)}
+			hls[i] = [3]float64{h, unit(ht), unit(ht)}
+		}
+		ans, err := colorsys(rgb, hsv, hls)
+		if err != nil {
+			fail(ht, "ORACLE: %v", err)
+		}
+		for i, c := range cs {
+			h, s, v := c.Hsv()
+			ph, ps, pv := ans.HSV[i][0]*360, ans.HSV[i][1], ans.HSV[i][2]
+			if s > 0 && !angleClose(h, ph, 1e-7) || !approx(s, ps, tight) || !approx(v, pv, tight) {
+				fail(ht, "Hsv of %s = (%v %v %v), colorsys (%v %v %v)", cstr(c), h, s, v, ph, ps, pv)
+			}
+			if !(0 <= h && h < 360) && !(Known.hue360 && h == 360) {
+				fail(ht, "Hsv hue of %s = %v, outside [0, 360)", cstr(c), h)
+			}
+			h, s, l := c.Hsl()
+			ph, pl, ps := ans.HLS[i][0]*360, ans.HLS[i][1], ans.HLS[i][2]
+			if s > 0 && !angleClose(h, ph, 1e-7) || !approx(s, ps, tight) || !approx(l, pl, tight) {
+				fail(ht, "Hsl of %s = (%v %v %v), colorsys (h %v l %v s %v)", cstr(c), h, s, l, ph, pl, ps)
+			}
+			if !(0 <= h && h < 360) && !(Known.hue360 && h == 360) {
+				fail(ht, "Hsl hue of %s = %v, outside [0, 360)", cstr(c), h)
+			}
+		}
+		for i := range hsv {
+			got := colorful.Hsv(hsv[i][0]*360, hsv[i][1], hsv[i][2])
+			want := fromV3(ans.FromHSV[i])
+			if !colorClose(got, want, 1e-9) {
+				fail(ht, "Hsv(%v %v %v) = %s, colorsys %s", hsv[i][0]*360, hsv[i][1], hsv[i][2], cstr(got), cstr(want))
+			}
+			got = colorful.Hsl(hls[i][0]*360, hls[i][2], hls[i][1])
+			want = fromV3(ans.FromHLS[i])
+			if !colorClose(got, want, 1e-9) {
+				fail(ht, "Hsl(%v %v %v) = %s, colorsys %s", hls[i][0]*360, hls[i][2], hls[i][1], cstr(got), cstr(want))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Every space round-trips.
+
+func TestHegelSpacesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genColor(ht)
+		note(ht, "c = %s", cstr(c))
+		check := func(what string, back colorful.Color, tol float64) {
+			if !colorClose(back, c, tol) {
+				fail(ht, "%s round trip of %s gives %s", what, cstr(c), cstr(back))
+			}
+		}
+		if h, _, _ := c.Hsv(); !(Known.hue360 && h == 360) {
+			check("Hsv", colorful.Hsv(c.Hsv()), tight)
+		}
+		if h, _, _ := c.Hsl(); !(Known.hue360 && h == 360) {
+			check("Hsl", colorful.Hsl(c.Hsl()), tight)
+		}
+		// The sRGB curve is discontinuous by 3e-8 at its threshold, 0.04045 = 12.92 * 0.0031308.
+		check("LinearRgb", colorful.LinearRgb(c.LinearRgb()), 1e-7)
+		check("Xyz", colorful.Xyz(c.Xyz()), loose)
+		check("Xyy", colorful.Xyy(c.Xyy()), loose)
+		check("Lab", colorful.Lab(c.Lab()), loose)
+		check("Luv", colorful.Luv(c.Luv()), loose)
+		check("OkLab", colorful.OkLab(c.OkLab()), okTol())
+		check("OkLch", colorful.OkLch(c.OkLch()), okTol())
+		// The Bradford pair agrees to about seven digits (README), 1e-5 in RGB near black.
+		check("XyzD50", colorful.XyzD50(c.XyzD50()), 1e-4)
+		check("DisplayP3", colorful.DisplayP3(c.DisplayP3()), loose)
+		check("A98Rgb", colorful.A98Rgb(c.A98Rgb()), loose)
+		check("ProPhotoRgb", colorful.ProPhotoRgb(c.ProPhotoRgb()), 1e-4)
+		check("Rec2020", colorful.Rec2020(c.Rec2020()), loose)
+		check("LabWhiteRef(D50)", viaWhite(c.LabWhiteRef, colorful.LabWhiteRef, colorful.D50), loose)
+		check("LuvWhiteRef(D50)", viaWhite(c.LuvWhiteRef, colorful.LuvWhiteRef, colorful.D50), loose)
+		if !(Known.hueZeroed && hclShape(c)) {
+			check("Hcl", colorful.Hcl(c.Hcl()), loose)
+		}
+		if !(Known.hueZeroed && hclShapeW(c, colorful.D50)) {
+			check("HclWhiteRef(D50)", viaWhite(c.HclWhiteRef, colorful.HclWhiteRef, colorful.D50), loose)
+		}
+		if !(Known.hueZeroed && lchShapeW(c, colorful.D50)) {
+			check("LuvLChWhiteRef(D50)", viaWhite(c.LuvLChWhiteRef, colorful.LuvLChWhiteRef, colorful.D50), loose)
+		}
+		if !(Known.hueZeroed && lchShape(c)) {
+			check("LuvLCh", colorful.LuvLCh(c.LuvLCh()), loose)
+			// HSLuv and HPLuv go through LCh(uv); the constructors clamp,
+			// which is a no-op for a valid colour.
+			check("HSLuv", colorful.HSLuv(c.HSLuv()), 1e-5)
+			check("HPLuv", colorful.HPLuv(c.HPLuv()), 1e-5)
+		}
+		// Hex is 8-bit: back within half a level.
+		back, err := colorful.Hex(c.Hex())
+		if err != nil {
+			fail(ht, "Hex(%q) of %s: %v", c.Hex(), cstr(c), err)
+		}
+		if !colorClose(back, c, 0.5/255+1e-12) {
+			fail(ht, "Hex round trip of %s through %q gives %s", cstr(c), c.Hex(), cstr(back))
+		}
+		// color.Color is 16-bit.
+		mc, ok := colorful.MakeColor(c)
+		if !ok || !colorClose(mc, c, 0.5/65535+1e-12) {
+			fail(ht, "MakeColor(%s) = %s, %v", cstr(c), cstr(mc), ok)
+		}
+		// HexColor through JSON.
+		js, err := json.Marshal(colorful.HexColor(c))
+		if err != nil {
+			fail(ht, "HexColor JSON of %s: %v", cstr(c), err)
+		}
+		var hc colorful.HexColor
+		if err := json.Unmarshal(js, &hc); err != nil {
+			fail(ht, "HexColor JSON %s of %s: %v", js, cstr(c), err)
+		}
+		if string(js) != `"`+c.Hex()+`"` || !colorClose(colorful.Color(hc), c, 0.5/255+1e-12) || hc.String() != c.Hex() {
+			fail(ht, "HexColor JSON round trip of %s: %s -> %s (String %q)", cstr(c), js, cstr(colorful.Color(hc)), hc.String())
+		}
+		var sc colorful.HexColor
+		if err := sc.Scan(c.Hex()); err != nil || !colorClose(colorful.Color(sc), c, 0.5/255+1e-12) {
+			fail(ht, "HexColor Scan of %q: %s, %v", c.Hex(), cstr(colorful.Color(sc)), err)
+		}
+		if val, err := sc.Value(); err != nil || val != c.Hex() {
+			fail(ht, "HexColor Value of %s: %v, %v", cstr(c), val, err)
+		}
+		var dc colorful.HexColor
+		if err := dc.Decode(strings.ToUpper(c.Hex())); err != nil || !colorClose(colorful.Color(dc), c, 0.5/255+1e-12) {
+			fail(ht, "HexColor Decode of %q: %s, %v", strings.ToUpper(c.Hex()), cstr(colorful.Color(dc)), err)
+		}
+	})
+}
+
+// viaWhite decomposes a colour in a space with a reference white and builds
+// it back from the same white.
+func viaWhite(get func([3]float64) (float64, float64, float64), build func(float64, float64, float64, [3]float64) colorful.Color, w [3]float64) colorful.Color {
+	a, b, c := get(w)
+	return build(a, b, c, w)
+}
+
+// ---------------------------------------------------------------------------
+// Coordinates round-trip too: a colour built from generated coordinates in
+// a space, if valid, has those coordinates.
+
+func TestHegelCoordinatesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch pick(ht, "lab", "luv", "hcl", "luvlch", "oklab", "oklch", "hsv", "hsl", "xyz", "xyy", "hsluv", "hpluv") {
+		case "lab":
+			l, a, b := unit(ht), signed(ht, 1.2), signed(ht, 1.2)
+			c := colorful.Lab(l, a, b)
+			if !c.IsValid() {
+				return
+			}
+			if !tripleClose(triple(c.Lab()), vec3{l, a, b}, loose) {
+				fail(ht, "Lab(%v %v %v) = %s, whose Lab is %v", l, a, b, cstr(c), triple(c.Lab()))
+			}
+		case "luv":
+			l, u, v := unit(ht), signed(ht, 1.5), signed(ht, 1.5)
+			c := colorful.Luv(l, u, v)
+			// At L* = 0 the chromatic coordinates carry no information
+			// (u* = 13 L* (u' - u'n)), so only (0, 0, 0) round-trips.
+			if !c.IsValid() || l < 1e-9 {
+				return
+			}
+			if !tripleClose(triple(c.Luv()), vec3{l, u, v}, loose) {
+				fail(ht, "Luv(%v %v %v) = %s, whose Luv is %v", l, u, v, cstr(c), triple(c.Luv()))
+			}
+		case "hcl":
+			h, ch, l := hue(ht), unit(ht)*1.4, unit(ht)
+			if chance(ht, 25) {
+				// The a* ≈ b* diagonal and the a* ≈ 0 axis.
+				h = pick(ht, 45.0, 225.0, 90.0, 270.0, 45.00001, 89.9999)
+			}
+			c := colorful.Hcl(h, ch, l)
+			if !c.IsValid() || ch < 1e-3 {
+				return
+			}
+			gh, gc, gl := c.Hcl()
+			if !(angleClose(gh, h, 1e-6) && approx(gc, ch, loose) && approx(gl, l, loose)) {
+				_, a, b := colorful.HclToLab(h, ch, l)
+				if !(Known.hueZeroed && (math.Abs(b-a) <= 1e-4 || math.Abs(a) <= 1e-4)) {
+					fail(ht, "Hcl(%v %v %v) = %s, whose Hcl is (%v %v %v)", h, ch, l, cstr(c), gh, gc, gl)
+				}
+			}
+		case "luvlch":
+			l, ch, h := unit(ht), unit(ht)*1.8, hue(ht)
+			if chance(ht, 25) {
+				h = pick(ht, 45.0, 225.0, 90.0, 270.0, 45.00001, 89.9999)
+			}
+			c := colorful.LuvLCh(l, ch, h)
+			if !c.IsValid() || ch < 1e-3 || l < 1e-9 { // L* = 0: see the Luv case
+				return
+			}
+			gl, gc, gh := c.LuvLCh()
+			if !(angleClose(gh, h, 1e-6) && approx(gc, ch, loose) && approx(gl, l, loose)) {
+				_, u, v := colorful.LuvLChToLuv(l, ch, h)
+				if !(Known.hueZeroed && (math.Abs(v-u) <= 1e-4 || math.Abs(u) <= 1e-4)) {
+					fail(ht, "LuvLCh(%v %v %v) = %s, whose LuvLCh is (%v %v %v)", l, ch, h, cstr(c), gl, gc, gh)
+				}
+			}
+		case "oklab":
+			l, a, b := unit(ht), signed(ht, 0.5), signed(ht, 0.5)
+			c := colorful.OkLab(l, a, b)
+			if !c.IsValid() {
+				return
+			}
+			if !tripleClose(triple(c.OkLab()), vec3{l, a, b}, okLabTol()) {
+				fail(ht, "OkLab(%v %v %v) = %s, whose OkLab is %v", l, a, b, cstr(c), triple(c.OkLab()))
+			}
+		case "oklch":
+			l, ch, h := unit(ht), unit(ht)*0.5, hue(ht)
+			c := colorful.OkLch(l, ch, h)
+			if !c.IsValid() || ch < 1e-3 {
+				return
+			}
+			gl, gc, gh := c.OkLch()
+			ga, gb := mRect(gh, gc)
+			a, b := mRect(h, ch)
+			if !(approx(ga, a, okLabTol()) && approx(gb, b, okLabTol()) && approx(gl, l, okLabTol())) {
+				fail(ht, "OkLch(%v %v %v) = %s, whose OkLch is (%v %v %v)", l, ch, h, cstr(c), gl, gc, gh)
+			}
+		case "hsv":
+			h, s, v := hue(ht), unit(ht), unit(ht)
+			c := colorful.Hsv(h, s, v)
+			if !c.IsValid() {
+				fail(ht, "Hsv(%v %v %v) = %s is not valid", h, s, v, cstr(c))
+			}
+			gh, gs, gv := c.Hsv()
+			// Below a chroma of 1e-6 the hue is ill-conditioned in float64.
+			if s == 0 || v == 0 || s*v < 1e-6 {
+				gh = h
+			}
+			if s > 0 && v == 0 {
+				gs = s
+			}
+			if !(angleClose(gh, h, 1e-6) && approx(gs, s, loose) && approx(gv, v, loose)) {
+				fail(ht, "Hsv(%v %v %v) = %s, whose Hsv is (%v %v %v)", h, s, v, cstr(c), gh, gs, gv)
+			}
+		case "hsl":
+			h, s, l := hue(ht), unit(ht), unit(ht)
+			c := colorful.Hsl(h, s, l)
+			if !c.IsValid() {
+				fail(ht, "Hsl(%v %v %v) = %s is not valid", h, s, l, cstr(c))
+			}
+			gh, gs, gl := c.Hsl()
+			if s == 0 || l == 0 || l == 1 {
+				gh, gs = h, s
+			}
+			if (1-math.Abs(2*l-1))*s < 1e-6 {
+				gh = h
+			}
+			if !(angleClose(gh, h, 1e-6) && approx(gs, s, loose) && approx(gl, l, loose)) {
+				fail(ht, "Hsl(%v %v %v) = %s, whose Hsl is (%v %v %v)", h, s, l, cstr(c), gh, gs, gl)
+			}
+		case "xyz":
+			x, y, z := unit(ht), unit(ht), unit(ht)*1.1
+			c := colorful.Xyz(x, y, z)
+			if !c.IsValid() {
+				return
+			}
+			if !tripleClose(triple(c.Xyz()), vec3{x, y, z}, loose) {
+				fail(ht, "Xyz(%v %v %v) = %s, whose Xyz is %v", x, y, z, cstr(c), triple(c.Xyz()))
+			}
+		case "xyy":
+			x, y, Y := unit(ht)*0.8, 0.01+unit(ht)*0.8, unit(ht)
+			c := colorful.Xyy(x, y, Y)
+			if !c.IsValid() || Y < 1e-6 {
+				return
+			}
+			if !tripleClose(triple(c.Xyy()), vec3{x, y, Y}, loose) {
+				fail(ht, "Xyy(%v %v %v) = %s, whose Xyy is %v", x, y, Y, cstr(c), triple(c.Xyy()))
+			}
+		case "hsluv":
+			h, s, l := hue(ht), unit(ht), unit(ht)
+			c := colorful.HSLuv(h, s, l)
+			if !c.IsValid() {
+				fail(ht, "HSLuv(%v %v %v) = %s is not valid (the constructor is documented to clamp)", h, s, l, cstr(c))
+			}
+			gh, gs, gl := c.HSLuv()
+			if l <= 1e-3 || l >= 1-1e-3 || s <= 1e-3 || (Known.hueZeroed && (lchShape(c) || lchShapeHS(colorful.HSLuvToLuvLCh(h, s, l)))) {
+				return
+			}
+			if !(angleClose(gh, h, 1e-4) && approx(gs, s, 1e-5) && approx(gl, l, 1e-6)) {
+				fail(ht, "HSLuv(%v %v %v) = %s, whose HSLuv is (%v %v %v)", h, s, l, cstr(c), gh, gs, gl)
+			}
+		case "hpluv":
+			h, s, l := hue(ht), unit(ht), unit(ht)
+			c := colorful.HPLuv(h, s, l)
+			if !c.IsValid() {
+				fail(ht, "HPLuv(%v %v %v) = %s is not valid (the constructor is documented to clamp)", h, s, l, cstr(c))
+			}
+			gh, gs, gl := c.HPLuv()
+			if l <= 1e-3 || l >= 1-1e-3 || s <= 1e-3 || (Known.hueZeroed && (lchShape(c) || lchShapeHS(colorful.HPLuvToLuvLCh(h, s, l)))) {
+				return
+			}
+			if !(angleClose(gh, h, 1e-4) && approx(gs, s, 1e-5) && approx(gl, l, 1e-6)) {
+				fail(ht, "HPLuv(%v %v %v) = %s, whose HPLuv is (%v %v %v)", h, s, l, cstr(c), gh, gs, gl)
+			}
+		}
+	})
+}
+
+// lchShapeHS says whether LCh(uv) coordinates (as HSLuv computes them with
+// its own white) have the go-colorful/1 shape.
+func lchShapeHS(l, c, h float64) bool {
+	u, v := mRect(h, c)
+	_ = l
+	return hueShape(u, v)
+}
+
+// hue draws an angle in [0, 360).
+func hue(tc hegel.TestCase) float64 {
+	if chance(tc, 20) {
+		return pick(tc, 0.0, 60.0, 120.0, 180.0, 240.0, 300.0, 359.999999, 0.000001, 30.0, 45.0, 90.0, 270.0)
+	}
+	return float64(n(tc, 0, 359_999_999)) / 1e6
+}
