diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..33d108f
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,175 @@
+package gronx_test
+
+// The second oracle: croniter (Python), driven as one persistent child: a command and
+// hex-encoded arguments per line in, one JSON object per line out. Expressions cross in gronx's
+// own normalised form (seconds first, six or seven segments), which croniter reads with
+// second_at_beginning=True; instants cross as Unix seconds plus a fixed UTC offset in seconds.
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"sync"
+	"time"
+)
+
+const pythonScript = `
+import sys, json, warnings
+warnings.simplefilter("ignore")
+from datetime import datetime, timezone, timedelta
+from croniter import croniter
+
+def hx(s):
+    return bytes.fromhex(s)
+
+def tz(off):
+    return timezone(timedelta(seconds=int(off)))
+
+def at(u, off):
+    return datetime.fromtimestamp(int(u), tz(off))
+
+def handle(cmd, a):
+    expr = a[0].decode()
+    if cmd == "V":  # valid: expr
+        return {"valid": bool(croniter.is_valid(expr, second_at_beginning=True))}
+    base = at(a[1], a[2])
+    if cmd == "M":  # match: expr, unix, offset
+        return {"due": bool(croniter.match(expr, base, second_at_beginning=True))}
+    c = croniter(expr, base, second_at_beginning=True)
+    try:
+        r = c.get_next(datetime) if cmd == "N" else c.get_prev(datetime)
+        return {"time": int(r.timestamp())}
+    except Exception as e:
+        return {"none": True, "message": str(e)}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with croniter is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...[]byte) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString(a)
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("croniter oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("croniter oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("croniter oracle reply %q: %v", raw, err))
+	}
+}
+
+func s(x string) []byte { return []byte(x) }
+
+type validReply struct {
+	reply
+	Valid bool `json:"valid"`
+}
+
+type dueReply struct {
+	reply
+	Due bool `json:"due"`
+}
+
+type tickReply struct {
+	reply
+	Time int64 `json:"time"`
+	None bool  `json:"none"`
+}
+
+// offsetOf is the fixed UTC offset of t's zone at t, in seconds.
+func offsetOf(t time.Time) []byte {
+	_, off := t.Zone()
+	return s(strconv.Itoa(off))
+}
+
+func unixOf(t time.Time) []byte { return s(strconv.FormatInt(t.Unix(), 10)) }
+
+func croniterValid(expr string) validReply {
+	var r validReply
+	ask(&r, "V", s(expr))
+	return r
+}
+
+func croniterMatch(expr string, t time.Time) dueReply {
+	var r dueReply
+	ask(&r, "M", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
+
+// croniterNext and croniterPrev: the tick strictly after / before t; None when croniter finds
+// nothing (its search stops after fifty years).
+func croniterNext(expr string, t time.Time) tickReply {
+	var r tickReply
+	ask(&r, "N", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
+
+func croniterPrev(expr string, t time.Time) tickReply {
+	var r tickReply
+	ask(&r, "P", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..98b68fe
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,147 @@
+package gronx_test
+
+// One plain test per recorded bug (bugs.toml); each asserts the correct behaviour and fails
+// while the bug exists, so it is listed under [expected_failures] in target.toml.
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/adhocore/gronx"
+)
+
+// gronx/1
+func TestHegelPinBatchDueUsesTheDayUnion(t *testing.T) {
+	g := gronx.New()
+	monday := time.Date(2026, 3, 16, 0, 0, 0, 0, time.UTC) // a Monday that is not the 1st
+	due, err := g.IsDue("0 0 1 * 1", monday)
+	if err != nil || !due {
+		t.Fatalf("IsDue = %v, %v; the weekday matches", due, err)
+	}
+	b := g.BatchDue([]string{"0 0 1 * 1"}, monday)
+	if b[0].Err != nil || !b[0].Due {
+		t.Errorf("BatchDue = %v, %v; IsDue says due (day-of-month or weekday)", b[0].Due, b[0].Err)
+	}
+}
+
+// gronx/2
+func TestHegelPinValidityDoesNotDependOnTheTime(t *testing.T) {
+	today := fmt.Sprintf("0 0 * * %d,99", int(time.Now().Weekday()))
+	if gronx.IsValid(today) {
+		t.Errorf("IsValid(%q) = true; 99 is out of the weekday bounds (and false tomorrow)", today)
+	}
+	g := gronx.New()
+	monday := time.Date(2026, 3, 16, 0, 0, 0, 0, time.UTC)
+	if _, err := g.IsDue("0 0 * * 1,99", monday); err == nil {
+		t.Errorf("IsDue(\"0 0 * * 1,99\", a Monday) reports no error; on a Tuesday it does")
+	}
+	tuesday := monday.AddDate(0, 0, 1)
+	if _, err := g.IsDue("99 0 * * 1", tuesday); err == nil {
+		t.Errorf("IsDue(\"99 0 * * 1\", a Tuesday) reports no error; on a Monday it does")
+	}
+}
+
+// gronx/3
+func TestHegelPinImpossibleModifiersAreInvalid(t *testing.T) {
+	for _, expr := range []string{"0 0 * * 9#1", "0 0 * * 1#6", "0 0 32W * *", "0 0 0W * *", "0 0 * * 15L"} {
+		if gronx.IsValid(expr) {
+			t.Errorf("IsValid(%q) = true", expr)
+		}
+	}
+}
+
+// gronx/4
+func TestHegelPinTrailingNewlineIsWhitespace(t *testing.T) {
+	if gronx.IsValid("0 0 * * * ") != true {
+		t.Fatalf("a trailing space is trimmed")
+	}
+	if !gronx.IsValid("0 0 * * *\n") {
+		t.Errorf("IsValid(\"0 0 * * *\\n\") = false; whitespace is otherwise collapsed with \\s+")
+	}
+}
+
+// gronx/5
+func TestHegelPinTagsKeepTheirCase(t *testing.T) {
+	if err := gronx.AddTag("@PinTagCase", "1 2 * * *"); err != nil {
+		t.Fatalf("AddTag: %v", err)
+	}
+	if !gronx.IsValid("@PinTagCase") {
+		t.Errorf("IsValid(\"@PinTagCase\") = false right after AddTag registered it")
+	}
+}
+
+// gronx/6
+func TestHegelPinInclusiveNextTickIsTruncated(t *testing.T) {
+	ref := time.Date(2026, 3, 15, 0, 0, 0, 123456789, time.UTC)
+	want := ref.Truncate(time.Second)
+	prev, err := gronx.PrevTickBefore("0 0 * * *", ref, true)
+	if err != nil || !prev.Equal(want) {
+		t.Fatalf("PrevTickBefore = %v, %v; truncated", prev, err)
+	}
+	next, err := gronx.NextTickAfter("0 0 * * *", ref, true)
+	if err != nil || !next.Equal(want) {
+		t.Errorf("NextTickAfter(incl) = %v, %v; want %v (as PrevTickBefore gives)", next, err, want)
+	}
+}
+
+// gronx/7
+func TestHegelPinSteppedYearsAreReachable(t *testing.T) {
+	ref := time.Date(2026, 3, 15, 0, 0, 0, 0, time.UTC)
+	next, err := gronx.NextTickAfter("0 0 1 1 * 2000/5", ref, false)
+	want := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+	if err != nil || !next.Equal(want) {
+		t.Errorf("NextTickAfter(\"0 0 1 1 * 2000/5\") = %v, %v; want %v", next, err, want)
+	}
+}
+
+// gronx/8
+func TestHegelPinAddTagRefusesInvalidExpressions(t *testing.T) {
+	if err := gronx.AddTag("@pintagbad", "0 0 * * 99"); err == nil {
+		t.Errorf("AddTag(\"@pintagbad\", \"0 0 * * 99\") = nil; IsValid of the tag: %v", gronx.IsValid("@pintagbad"))
+	}
+}
+
+// gronx/9
+func TestHegelPinAutumnTransitionKeepsEveryTick(t *testing.T) {
+	london, err := time.LoadLocation("Europe/London")
+	if err != nil {
+		t.Skip(err)
+	}
+	ref := time.Date(2020, 10, 25, 0, 49, 19, 0, london) // BST; clocks go back at 02:00 BST
+	want := time.Date(2020, 10, 25, 0, 0, 0, 0, time.UTC) // 01:00 BST
+	got, err := gronx.NextTickAfter("*/15 * * * *", ref, false)
+	if err != nil || !got.Equal(want) {
+		t.Errorf("NextTickAfter(@15minutes, %v) = %v, %v; want %v (01:00 BST)", ref, got, err, want.In(london))
+	}
+}
+
+// gronx/10
+func TestHegelPinMidnightGapIsCrossed(t *testing.T) {
+	santiago, err := time.LoadLocation("America/Santiago")
+	if err != nil {
+		t.Skip(err)
+	}
+	ref := time.Date(2021, 9, 4, 22, 21, 4, 0, santiago) // Saturday; Sunday starts at 01:00
+	got, err := gronx.NextTickAfter("* * 3 * 7", ref, false)
+	if err != nil {
+		t.Fatalf("NextTickAfter(\"* * 3 * 7\", %v) = %v", ref, err)
+	}
+	if !got.After(ref) || got.Weekday() != time.Sunday {
+		t.Errorf("NextTickAfter = %v; want the first second of Sunday", got)
+	}
+}
+
+// gronx/11
+func TestHegelPinTicksExcludeTheReference(t *testing.T) {
+	ref := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC) // the only tick of the expression
+	if due, err := gronx.New().IsDue("0 0 1 1 * 2026", ref); err != nil || !due {
+		t.Fatalf("IsDue = %v, %v", due, err)
+	}
+	if next, err := gronx.NextTickAfter("0 0 1 1 * 2026", ref, false); err == nil {
+		t.Errorf("NextTickAfter(excluding the reference) = %v, nil; want an error (no later tick)", next)
+	}
+	if prev, err := gronx.PrevTickBefore("0 0 1 1 * 2026", ref, false); err == nil {
+		t.Errorf("PrevTickBefore(excluding the reference) = %v, nil; want an error (no earlier tick)", prev)
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..6069567
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1480 @@
+package gronx_test
+
+// Hegel property tests for adhocore/gronx, written for the Hegel zoo.
+// See targets/go/gronx/README.md.
+//
+// Oracles: a model of the documented expression grammar (5, 6 and 7 segments, lists, ranges,
+// steps, names, tags, the L/W/# modifiers, the Vixie rule for day-of-month against weekday) that
+// says which expressions are valid, whether a wall-clock time is due, and which instant is the
+// next or previous due one (a day walk, then the hour/minute/second sets); croniter (Python) as
+// a second voice on the subset of the grammar both libraries share.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/adhocore/gronx"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// gronx/1: BatchDue checks every segment and ignores the day-of-month/weekday union that
+	// IsDue applies, so "0 0 1 * 1" is due on a Monday for IsDue and not for BatchDue.
+	batchIgnoresUnion bool
+	// gronx/2: an out-of-range or malformed item is only reported when the check reaches it:
+	// IsDue("0 0 * * 1,99") is (true, nil) on a Monday and an error on other days, and IsValid,
+	// which checks against the time the process started, follows the same rule.
+	errorsDependOnRef bool
+	// gronx/3: modifiers with impossible values (9#1, 1#6, 32W, 0W, 15L) are valid and never due,
+	// or due on the wrong day (0W, 15L).
+	nonsenseAccepted bool
+	// gronx/4: an expression ending in a newline is invalid, although whitespace inside is
+	// collapsed with \s+ and trailing spaces and tabs are trimmed.
+	newlineInvalid bool
+	// gronx/5: AddTag stores the tag as given but the lookup lowercases the expression, so a tag
+	// with an upper-case letter can never be used.
+	tagCaseUnusable bool
+	// gronx/6: NextTickAfter with inclRefTime returns the reference time with its sub-second
+	// part when it is due, where every other result (and PrevTickBefore) is truncated.
+	inclKeepsFraction bool
+	// gronx/7: isUnreachableYear strips the step from a year item, so "2000/5" (2000, 2005,
+	// ...) is reported unreachable for NextTickAfter.
+	steppedYearUnreachable bool
+	// gronx/8: AddTag checks only the number of segments, so an invalid expression is registered
+	// as a tag (and IsValid of the tag is then false).
+	addTagUnchecked bool
+	// gronx/9: in a zone with daylight saving, NextTickAfter lands on the second reading of an
+	// ambiguous wall clock, skipping up to an hour of ticks before the autumn transition
+	// (@15minutes from 00:49 BST gives 01:00 GMT; 01:00, 01:15, 01:30 and 01:45 BST are lost).
+	fallBackSkipsTicks bool
+	// gronx/10: when a day has no midnight (America/Santiago's spring transition at 00:00),
+	// NextTickAfter across it gives up with "tried so hard".
+	midnightGapGivesUp bool
+	// gronx/11: with inclRefTime false, NextTickAfter and PrevTickBefore return the reference
+	// itself, without an error, when it is due and no other tick exists ("the superfluous err").
+	lastTickIsTheReference bool
+}{true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- the model
+
+// Segment positions in the normalised seven-segment form.
+const (
+	pSec = iota
+	pMin
+	pHour
+	pDom
+	pMon
+	pDow
+	pYear
+)
+
+var bounds = [7][2]int{{0, 59}, {0, 59}, {0, 23}, {1, 31}, {1, 12}, {0, 7}, {0, 9999}}
+
+var monthNames = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var dayNames = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+var tags = map[string]string{
+	"@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+	"@daily": "0 0 * * *", "@hourly": "0 * * * *", "@always": "* * * * *", "@5minutes": "*/5 * * * *",
+	"@10minutes": "*/10 * * * *", "@15minutes": "*/15 * * * *", "@30minutes": "0,30 * * * *",
+	"@everysecond": "* * * * * *",
+}
+
+// item is one comma-separated alternative of a segment.
+type item struct {
+	kind string // num range starstep numstep rangestep L W dowL hash bad
+	a, b int
+	step int
+	text string
+	// valid: the grammar accepts it (gronx rejects everything else with an error).
+	valid bool
+	// nonsense: gronx accepts it although its value is impossible (gronx/3).
+	nonsense bool
+}
+
+type seg struct {
+	pos   int
+	star  bool // "*" or "?"
+	text  string
+	items []item
+}
+
+func (sg seg) valid() bool {
+	if sg.star {
+		return true
+	}
+	for _, it := range sg.items {
+		if !it.valid {
+			return false
+		}
+	}
+	return len(sg.items) > 0
+}
+
+func (sg seg) nonsense() bool {
+	for _, it := range sg.items {
+		if it.nonsense {
+			return true
+		}
+	}
+	return false
+}
+
+// expr is a generated expression with its model.
+type expr struct {
+	text     string // as handed to gronx
+	segs     [7]seg // normalised (year star when absent)
+	written  int    // 5, 6 or 7 segments in the text (0 for a tag)
+	yearForm bool   // six segments with a year
+	tag      string // the tag used, if any
+	newline  bool   // ends in a newline
+}
+
+func (e *expr) valid() bool {
+	for _, sg := range e.segs {
+		if !sg.valid() {
+			return false
+		}
+	}
+	return true
+}
+
+func (e *expr) nonsense() bool {
+	for _, sg := range e.segs {
+		if sg.nonsense() {
+			return true
+		}
+	}
+	return false
+}
+
+// restricted reports whether a segment takes part in a check (not * or ?).
+func (e *expr) restricted(pos int) bool { return !e.segs[pos].star }
+
+// isolatedInvalid: exactly one restricted segment, holding exactly one (invalid) item, so
+// gronx's check cannot bail out before reaching it (gronx/2 does not apply).
+func (e *expr) isolatedInvalid() bool {
+	k := 0
+	for pos := range e.segs {
+		if e.restricted(pos) {
+			k++
+		}
+	}
+	if k != 1 {
+		return false
+	}
+	for pos := range e.segs {
+		if e.restricted(pos) {
+			return len(e.segs[pos].items) == 1 && !e.segs[pos].items[0].valid
+		}
+	}
+	return false
+}
+
+// normalised is the six- or seven-segment text gronx works with (and croniter reads with
+// seconds first).
+func (e *expr) normalised() string {
+	parts := []string{}
+	for pos := 0; pos < 6; pos++ {
+		parts = append(parts, e.segs[pos].text)
+	}
+	if e.written == 7 || e.yearForm {
+		parts = append(parts, e.segs[pYear].text)
+	}
+	return strings.Join(parts, " ")
+}
+
+// intersect is gronx's rule (Vixie's): with both day segments restricted the day matches when
+// either does, unless the day-of-month starts with '*' or is '?', or the weekday starts with
+// "*/", in which case both must match.
+func (e *expr) intersect() bool {
+	dom, dow := e.segs[pDom].text, e.segs[pDow].text
+	return strings.HasPrefix(dow, "*/") || strings.HasPrefix(dom, "*") || dom == "?"
+}
+
+// itemMatches: the plain (numeric) items at a position. Weekday values are 0..6 as time gives
+// them; 7 in the expression is Sunday.
+func itemMatches(it item, pos, v int) bool {
+	lo, hi := bounds[pos][0], bounds[pos][1]
+	dow := pos == pDow
+	switch it.kind {
+	case "num":
+		if dow {
+			return it.a%7 == v
+		}
+		return it.a == v
+	case "range":
+		a, b := it.a, it.b
+		if dow {
+			if a == 7 && b != 7 {
+				a = 0
+			}
+			for x := a; x <= b; x++ {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return a <= v && v <= b
+	case "starstep":
+		return (v-lo)%it.step == 0
+	case "numstep":
+		a := it.a
+		if dow {
+			// gronx (and croniter) run an open step over 0..6 only: "5/2" is Friday alone, and a
+			// leading 7 is Sunday
+			if a == 7 {
+				a = 0
+			}
+			for x := a; x <= 6; x += it.step {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return v >= a && (v-a)%it.step == 0 && v <= hi
+	case "rangestep":
+		a, b := it.a, it.b
+		if dow {
+			if a == 7 && b != 7 {
+				a = 0
+			}
+			for x := a; x <= b; x += it.step {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return a <= v && v <= b && (v-a)%it.step == 0
+	}
+	return false
+}
+
+func lastDayOf(y int, m time.Month, loc *time.Location) int {
+	return time.Date(y, m+1, 0, 12, 0, 0, 0, loc).Day()
+}
+
+func weekdayOf(y int, m time.Month, d int, loc *time.Location) int {
+	return int(time.Date(y, m, d, 12, 0, 0, 0, loc).Weekday())
+}
+
+// nearestWeekday is the day the item "aW" fires in the month: a itself when it is a weekday,
+// else the closest weekday, the earlier one first, never outside the month; 0 when a is beyond
+// the month's end.
+func nearestWeekday(a, last int, y int, m time.Month, loc *time.Location) int {
+	if a > last {
+		return 0
+	}
+	for _, off := range []int{0, -1, 1, -2, 2} {
+		d := a + off
+		if d < 1 || d > last {
+			continue
+		}
+		if w := weekdayOf(y, m, d, loc); w >= 1 && w <= 5 {
+			return d
+		}
+	}
+	return 0
+}
+
+// segMatchesDay: the day-of-month or weekday segment against a date.
+func (e *expr) segMatchesDay(pos int, y int, m time.Month, d int, loc *time.Location) bool {
+	sg := e.segs[pos]
+	if sg.star {
+		return true
+	}
+	last := lastDayOf(y, m, loc)
+	w := weekdayOf(y, m, d, loc)
+	for _, it := range sg.items {
+		switch it.kind {
+		case "L":
+			if d == last {
+				return true
+			}
+		case "W":
+			if nearestWeekday(it.a, last, y, m, loc) == d {
+				return true
+			}
+		case "dowL":
+			if w == it.a%7 && d+7 > last {
+				return true
+			}
+		case "hash":
+			if w == it.a%7 && (d-1)/7 == it.b-1 {
+				return true
+			}
+		default:
+			v := d
+			if pos == pDow {
+				v = w
+			}
+			if itemMatches(it, pos, v) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (e *expr) fieldMatches(pos, v int) bool {
+	sg := e.segs[pos]
+	if sg.star {
+		return true
+	}
+	for _, it := range sg.items {
+		if itemMatches(it, pos, v) {
+			return true
+		}
+	}
+	return false
+}
+
+// dayMatches: month, year and the two day segments under the intersect/union rule.
+func (e *expr) dayMatches(y int, m time.Month, d int, loc *time.Location) bool {
+	if !e.fieldMatches(pMon, int(m)) || !e.fieldMatches(pYear, y) {
+		return false
+	}
+	domR, dowR := e.restricted(pDom), e.restricted(pDow)
+	dom := e.segMatchesDay(pDom, y, m, d, loc)
+	dow := e.segMatchesDay(pDow, y, m, d, loc)
+	if domR && dowR && !e.intersect() {
+		return dom || dow
+	}
+	return dom && dow
+}
+
+// due: the model of IsDue for a wall-clock time.
+func (e *expr) due(t time.Time) bool {
+	return e.fieldMatches(pSec, t.Second()) && e.fieldMatches(pMin, t.Minute()) &&
+		e.fieldMatches(pHour, t.Hour()) && e.dayMatches(t.Year(), t.Month(), t.Day(), t.Location())
+}
+
+// values of a time field in ascending order.
+func (e *expr) values(pos int) []int {
+	var out []int
+	for v := bounds[pos][0]; v <= bounds[pos][1]; v++ {
+		if e.fieldMatches(pos, v) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// next: the earliest instant after start (at or after with incl) that is due, walking days up to
+// the horizon year; ok=false when none. Fixed-offset zones only (wall clocks are monotonic).
+func (e *expr) next(start time.Time, incl bool, horizonYear int) (time.Time, bool) {
+	start = start.Truncate(time.Second)
+	loc := start.Location()
+	hs, ms, ss := e.values(pHour), e.values(pMin), e.values(pSec)
+	if len(hs) == 0 || len(ms) == 0 || len(ss) == 0 {
+		return time.Time{}, false
+	}
+	day := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, loc)
+	for day.Year() <= horizonYear {
+		y, m, d := day.Date()
+		if e.dayMatches(y, m, d, loc) {
+			for _, h := range hs {
+				for _, mi := range ms {
+					for _, sc := range ss {
+						t := time.Date(y, m, d, h, mi, sc, 0, loc)
+						if t.After(start) || (incl && t.Equal(start)) {
+							return t, true
+						}
+					}
+				}
+			}
+		}
+		day = day.AddDate(0, 0, 1)
+	}
+	return time.Time{}, false
+}
+
+// prev: the latest instant before start (at or before with incl) that is due.
+func (e *expr) prev(start time.Time, incl bool, horizonYear int) (time.Time, bool) {
+	start = start.Truncate(time.Second)
+	loc := start.Location()
+	hs, ms, ss := e.values(pHour), e.values(pMin), e.values(pSec)
+	if len(hs) == 0 || len(ms) == 0 || len(ss) == 0 {
+		return time.Time{}, false
+	}
+	day := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, loc)
+	for day.Year() >= horizonYear {
+		y, m, d := day.Date()
+		if e.dayMatches(y, m, d, loc) {
+			for i := len(hs) - 1; i >= 0; i-- {
+				for j := len(ms) - 1; j >= 0; j-- {
+					for k := len(ss) - 1; k >= 0; k-- {
+						t := time.Date(y, m, d, hs[i], ms[j], ss[k], 0, loc)
+						if t.Before(start) || (incl && t.Equal(start)) {
+							return t, true
+						}
+					}
+				}
+			}
+		}
+		day = day.AddDate(0, 0, -1)
+	}
+	return time.Time{}, false
+}
+
+// --------------------------------------------------------------------------- generators
+
+var yearRe = regexp.MustCompile(`\d{4}`)
+
+// genItem draws one alternative for a segment. invalid asks for one the grammar rejects;
+// nonsense for an impossible modifier value gronx accepts.
+func genItem(tc hegel.TestCase, pos int, invalid, nonsense bool) item {
+	lo, hi := bounds[pos][0], bounds[pos][1]
+	if pos == pYear {
+		lo, hi = 1990, 2100
+	}
+	num := func() int { return n(tc, lo, hi) }
+	name := func(v int) string {
+		if pos == pMon && chance(tc, 30) {
+			return monthNames[v-1]
+		}
+		if pos == pDow && v <= 6 && chance(tc, 30) {
+			return dayNames[v]
+		}
+		return strconv.Itoa(v)
+	}
+	if invalid {
+		blo, bhi := bounds[pos][0], bounds[pos][1]
+		switch n(tc, 0, 9) {
+		case 0:
+			v := bhi + n(tc, 1, 40)
+			return item{kind: "bad", text: strconv.Itoa(v)}
+		case 1:
+			return item{kind: "bad", text: fmt.Sprintf("%d-%d", bhi+n(tc, 1, 5), bhi+n(tc, 6, 9))}
+		case 2:
+			return item{kind: "bad", text: fmt.Sprintf("*/%d", -n(tc, 0, 3))}
+		case 3:
+			return item{kind: "bad", text: pick(tc, []string{"x", "1-", "-1", "/2", "1/", "1--2", "1-2-3", "**", "*a", "5/2/1"})}
+		case 4:
+			if pos == pDow {
+				return item{kind: "bad", text: pick(tc, []string{"L", "#1", "1#", "LW", "W"})}
+			}
+			if pos == pDom {
+				return item{kind: "bad", text: pick(tc, []string{"LW", "W", "1#2", "1L", "L1"})}
+			}
+			return item{kind: "bad", text: pick(tc, []string{"L", "5W", "1#2", "5L"})}
+		case 5:
+			// a reversed range (a leading 7 in the weekday segment is Sunday, so keep a > 7 there)
+			a, b := n(tc, lo+1, hi), 0
+			if pos == pDow {
+				a = n(tc, 1, 6)
+			}
+			b = n(tc, lo, a-1)
+			return item{kind: "bad", text: fmt.Sprintf("%d-%d", a, b)}
+		case 6:
+			return item{kind: "bad", text: fmt.Sprintf("%d/%d", num(), 0)}
+		case 7:
+			return item{kind: "bad", text: pick(tc, []string{"SUNDAY", "JANUARY", "MONDAY", "sept", "Tues"})}
+		case 8:
+			// a stepped range with a reversed order, which gronx rejects even for 7-x in the weekday
+			a := n(tc, lo+1, hi)
+			return item{kind: "bad", text: fmt.Sprintf("%d-%d/%d", a, n(tc, lo, a-1), n(tc, 1, 5))}
+		default:
+			return item{kind: "bad", text: fmt.Sprintf("%d,%d", blo-1-n(tc, 0, 3), num())}
+		}
+	}
+	if nonsense {
+		switch {
+		case pos == pDom:
+			v := pick(tc, []int{0, 32, 33, 40, -1, -5})
+			return item{kind: "W", a: v, text: fmt.Sprintf("%dW", v), valid: true, nonsense: true}
+		case pos == pDow && chance(tc, 50):
+			v := pick(tc, []int{8, 9, 15, 100})
+			return item{kind: "dowL", a: v, text: fmt.Sprintf("%dL", v), valid: true, nonsense: true}
+		default:
+			a, k := n(tc, 0, 7), n(tc, 1, 5)
+			if chance(tc, 50) {
+				a = pick(tc, []int{8, 9, 12, -1})
+			} else {
+				k = pick(tc, []int{0, 6, 7, 9, -1})
+			}
+			return item{kind: "hash", a: a, b: k, text: fmt.Sprintf("%d#%d", a, k), valid: true, nonsense: true}
+		}
+	}
+	r := n(tc, 0, 99)
+	switch {
+	case r < 35:
+		v := num()
+		return item{kind: "num", a: v, text: name(v), valid: true}
+	case r < 55:
+		a := num()
+		b := n(tc, a, hi)
+		if pos == pDow && chance(tc, 15) {
+			// 7-x means Sunday to x; x-7 includes Sunday after Saturday
+			if chance(tc, 50) {
+				a, b = 7, n(tc, 0, 7)
+			} else {
+				a, b = n(tc, 0, 7), 7
+			}
+		}
+		return item{kind: "range", a: a, b: b, text: name(a) + "-" + name(b), valid: true}
+	case r < 68:
+		st := n(tc, 1, hi-lo+1)
+		if chance(tc, 30) {
+			st = pick(tc, []int{1, 2, 3, 5, 10, 15})
+		}
+		return item{kind: "starstep", step: st, text: "*/" + strconv.Itoa(st), valid: true}
+	case r < 78:
+		a := num()
+		if pos == pDom || pos == pMon {
+			if chance(tc, 15) {
+				a = 0 // gronx takes 0/s below the lower bound of the day and month fields
+			}
+		}
+		st := n(tc, 1, hi-lo+1)
+		return item{kind: "numstep", a: a, step: st, text: fmt.Sprintf("%d/%d", a, st), valid: true}
+	case r < 86:
+		a := num()
+		b := n(tc, a, hi)
+		st := n(tc, 1, hi-lo+1)
+		return item{kind: "rangestep", a: a, b: b, step: st, text: fmt.Sprintf("%d-%d/%d", a, b, st), valid: true}
+	}
+	// modifiers where they belong, a plain value elsewhere
+	switch pos {
+	case pDom:
+		if chance(tc, 40) {
+			return item{kind: "L", text: "L", valid: true}
+		}
+		a := n(tc, 1, 31)
+		return item{kind: "W", a: a, text: fmt.Sprintf("%dW", a), valid: true}
+	case pDow:
+		if chance(tc, 50) {
+			a := n(tc, 0, 7)
+			return item{kind: "dowL", a: a, text: fmt.Sprintf("%dL", a), valid: true}
+		}
+		a, k := n(tc, 0, 7), n(tc, 1, 5)
+		return item{kind: "hash", a: a, b: k, text: fmt.Sprintf("%d#%d", a, k), valid: true}
+	}
+	v := num()
+	return item{kind: "num", a: v, text: name(v), valid: true}
+}
+
+func genSeg(tc hegel.TestCase, pos int, invalid, nonsense bool) seg {
+	sg := seg{pos: pos}
+	if !invalid && !nonsense && chance(tc, 45) {
+		sg.star = true
+		sg.text = "*"
+		if (pos == pDom || pos == pDow) && chance(tc, 25) {
+			sg.text = "?"
+		}
+		return sg
+	}
+	k := 1
+	if chance(tc, 30) {
+		k = n(tc, 2, 4)
+	}
+	bad := n(tc, 0, k-1)
+	var parts []string
+	for i := 0; i < k; i++ {
+		it := genItem(tc, pos, invalid && i == bad, nonsense && i == bad)
+		sg.items = append(sg.items, it)
+		parts = append(parts, it.text)
+	}
+	sg.text = strings.Join(parts, ",")
+	return sg
+}
+
+// randomCase mixes the letter case of names and modifiers (gronx upper-cases the expression).
+func randomCase(tc hegel.TestCase, s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if r >= 'A' && r <= 'Z' && chance(tc, 40) {
+			b.WriteRune(r + 32)
+		} else {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// normaliseText mimics gronx's normalisation to derive the segments a text yields: upper-case,
+// names to numbers.
+func upperNames(s string) string {
+	s = strings.ToUpper(s)
+	for i, nm := range dayNames {
+		s = strings.ReplaceAll(s, nm, strconv.Itoa(i))
+	}
+	for i, nm := range monthNames {
+		s = strings.ReplaceAll(s, nm, strconv.Itoa(i+1))
+	}
+	return s
+}
+
+// genExpr draws an expression. mode: "valid", "invalid" (one item the grammar rejects),
+// "nonsense" (one impossible modifier), "tag" (a built-in tag).
+func genExpr(tc hegel.TestCase, mode string) *expr {
+	e := &expr{}
+	if mode == "tag" {
+		names := make([]string, 0, len(tags))
+		for k := range tags {
+			names = append(names, k)
+		}
+		sort.Strings(names)
+		e.tag = pick(tc, names)
+		e.text = randomCase(tc, strings.ToUpper(e.tag))
+		parts := strings.Split(tags[e.tag], " ")
+		if len(parts) == 5 {
+			parts = append([]string{"0"}, parts...)
+		}
+		e.written = 0
+		for pos := 0; pos < 7; pos++ {
+			if pos >= len(parts) {
+				e.segs[pos] = seg{pos: pos, star: true, text: "*"}
+				continue
+			}
+			e.segs[pos] = parseSeg(pos, parts[pos])
+		}
+		return e
+	}
+	e.written = pick(tc, []int{5, 5, 5, 6, 6, 7})
+	e.yearForm = e.written == 6 && chance(tc, 40)
+	present := map[int]bool{pMin: true, pHour: true, pDom: true, pMon: true, pDow: true}
+	if e.written == 7 || e.written == 6 && !e.yearForm {
+		present[pSec] = true
+	}
+	if e.written == 7 || e.yearForm {
+		present[pYear] = true
+	}
+	// which segment carries the invalid or nonsense item
+	var cands []int
+	for pos := 0; pos < 7; pos++ {
+		if !present[pos] {
+			continue
+		}
+		if mode == "nonsense" && pos != pDom && pos != pDow {
+			continue
+		}
+		cands = append(cands, pos)
+	}
+	special := -1
+	if mode == "invalid" || mode == "nonsense" {
+		special = pick(tc, cands)
+	}
+	var parts []string
+	for pos := 0; pos < 7; pos++ {
+		if !present[pos] {
+			e.segs[pos] = seg{pos: pos, star: true, text: "*"}
+			if pos == pSec {
+				e.segs[pos] = seg{pos: pos, text: "0", items: []item{{kind: "num", a: 0, text: "0", valid: true}}}
+			}
+			continue
+		}
+		sg := genSeg(tc, pos, mode == "invalid" && pos == special, mode == "nonsense" && pos == special)
+		if pos == pYear && e.yearForm && !yearRe.MatchString(upperNames(sg.text)) {
+			// the sixth segment must look like a year to be read as one
+			sg = seg{pos: pos, text: strconv.Itoa(n(tc, 1990, 2100))}
+			sg.items = []item{{kind: "num", a: atoi(sg.text), text: sg.text, valid: true}}
+		}
+		if pos == pDow && e.written == 6 && !e.yearForm && yearRe.MatchString(upperNames(sg.text)) {
+			// a weekday segment with four digits in it would be read as a year: keep it simple
+			sg = seg{pos: pos, star: true, text: "*"}
+		}
+		parts = append(parts, randomCase(tc, sg.text))
+		// the model sees the upper-cased, name-replaced text
+		sg.text = upperNames(sg.text)
+		e.segs[pos] = sg
+	}
+	// whitespace: single spaces, tabs, runs, leading and trailing blanks
+	sep := " "
+	switch n(tc, 0, 9) {
+	case 0:
+		sep = "\t"
+	case 1:
+		sep = "  "
+	case 2:
+		sep = " \t "
+	}
+	e.text = strings.Join(parts, sep)
+	if chance(tc, 15) {
+		e.text = pick(tc, []string{" ", "\t", "  \t"}) + e.text
+	}
+	if chance(tc, 15) {
+		e.text = e.text + pick(tc, []string{" ", "\t", " \t"})
+	}
+	if chance(tc, 4) {
+		e.text += "\n"
+		e.newline = true
+	}
+	return e
+}
+
+func atoi(s string) int {
+	v, _ := strconv.Atoi(s)
+	return v
+}
+
+// parseSeg builds the model of a segment from clean text (the tags' expansions).
+func parseSeg(pos int, text string) seg {
+	sg := seg{pos: pos, text: text}
+	if text == "*" || text == "?" {
+		sg.star = true
+		return sg
+	}
+	for _, part := range strings.Split(text, ",") {
+		switch {
+		case strings.HasPrefix(part, "*/"):
+			sg.items = append(sg.items, item{kind: "starstep", step: atoi(part[2:]), text: part, valid: true})
+		case strings.Contains(part, "-"):
+			ab := strings.SplitN(part, "-", 2)
+			sg.items = append(sg.items, item{kind: "range", a: atoi(ab[0]), b: atoi(ab[1]), text: part, valid: true})
+		default:
+			sg.items = append(sg.items, item{kind: "num", a: atoi(part), text: part, valid: true})
+		}
+	}
+	return sg
+}
+
+// --------------------------------------------------------------------------- instants
+
+var fixedZones = []*time.Location{
+	time.UTC,
+	time.FixedZone("+0545", 5*3600+45*60),
+	time.FixedZone("-0330", -(3*3600 + 30*60)),
+	time.FixedZone("+14", 14*3600),
+	time.FixedZone("-12", -12*3600),
+}
+
+// genInstant draws a start instant in loc: years 1995..2090 with a bias to the edges of months,
+// leap days and year ends; whole seconds unless frac.
+func genInstant(tc hegel.TestCase, loc *time.Location, frac bool) time.Time {
+	y := n(tc, 2020, 2032)
+	if chance(tc, 20) {
+		y = n(tc, 1995, 2090)
+	}
+	m := time.Month(n(tc, 1, 12))
+	d := n(tc, 1, 31)
+	switch n(tc, 0, 5) {
+	case 0:
+		d = pick(tc, []int{28, 29, 30, 31})
+	case 1:
+		d = 1
+		m = pick(tc, []time.Month{1, 2, 3, 12})
+	}
+	h, mi, sc := n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59)
+	if chance(tc, 30) {
+		h, mi, sc = pick(tc, []int{0, 23}), pick(tc, []int{0, 59}), pick(tc, []int{0, 59})
+	}
+	ns := 0
+	if frac && chance(tc, 30) {
+		ns = n(tc, 1, 999999999)
+	}
+	return time.Date(y, m, d, h, mi, sc, ns, loc)
+}
+
+// --------------------------------------------------------------------------- croniter subset
+
+// croniterCompatible: the shapes both libraries read the same way. Out: "?" (croniter reads it
+// as the reference's day), 7 as a weekday (refused in lists and in the six-segment form), ranges
+// via 7 and steps from 7, "0/s" below the day and month bounds, W beyond the 28th or in a list or
+// beside a weekday, n#k beside literals or a day-of-month (croniter intersects, gronx unions),
+// gronx's intersect rule for a stepped day-of-month against a weekday (croniter unions),
+// last-weekday items (croniter writes them the other way round), single-value ranges ("16-16",
+// which croniter misreads), open steps "N/S" (croniter wraps them: "12/1" fires in January),
+// year steps (counted from 1970 by croniter), years outside 1970..2099.
+func croniterCompatible(e *expr) bool {
+	for pos, sg := range e.segs {
+		if sg.text == "?" {
+			return false // croniter reads ? as the day of the reference
+		}
+		if sg.star {
+			continue
+		}
+		for _, it := range sg.items {
+			switch it.kind {
+			case "dowL":
+				return false
+			case "hash":
+				if len(sg.items) > 1 || e.restricted(pDom) || it.a == 7 {
+					return false // croniter: no literals beside n#k, no 7#k, and n#k intersects the day-of-month
+				}
+			case "W":
+				if it.a > 28 || len(sg.items) > 1 || e.restricted(pDow) {
+					return false // croniter takes W only as the whole segment and intersects it with the weekday
+				}
+			case "starstep":
+				if pos == pYear {
+					return false // croniter counts year steps from 1970, gronx from 0
+				}
+			case "range", "rangestep":
+				if pos == pDow && (it.a == 7 || it.b == 7) {
+					return false
+				}
+				if it.a == it.b {
+					return false // croniter misreads "16-16" and "4-4/2"
+				}
+				if pos == pYear && (it.a < 1970 || it.b > 2099) {
+					return false
+				}
+			case "numstep":
+				return false // croniter reads "12/1" and "59/36" as wrapping or open ranges
+			case "num":
+				if pos == pYear && (it.a < 1970 || it.a > 2099) {
+					return false
+				}
+				if pos == pDow && it.a == 7 {
+					return false // croniter refuses 7 in a list and in the six-segment form
+				}
+			}
+		}
+	}
+	if e.restricted(pDom) && e.restricted(pDow) && e.intersect() {
+		return false
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelValidityFollowsTheGrammar: IsValid agrees with the grammar, and IsDue reports an
+// error for exactly the invalid expressions (where gronx's check reaches the fault).
+func TestHegelValidityFollowsTheGrammar(t *testing.T) {
+	col := newCollector(t)
+	g := gronx.New()
+	property(t, func(ht *hegel.T) {
+		mode := pick(ht, []string{"valid", "valid", "valid", "invalid", "invalid", "nonsense", "tag"})
+		e := genExpr(ht, mode)
+		loc := pick(ht, fixedZones)
+		ref := genInstant(ht, loc, false)
+		valid := gronx.IsValid(e.text)
+		_, err := g.IsDue(e.text, ref)
+		if e.newline && Known.newlineInvalid {
+			col.count("newline-gated")
+			return
+		}
+		switch {
+		case e.valid() && !e.nonsense():
+			col.count(mode + "-valid")
+			if !valid {
+				col.fail(ht, "IsValid(%q) = false; the grammar accepts it", e.text)
+			}
+			if err != nil {
+				col.fail(ht, "IsDue(%q) = %v; the grammar accepts it", e.text, err)
+			}
+		case e.nonsense():
+			if Known.nonsenseAccepted {
+				col.count("nonsense-gated")
+				return
+			}
+			col.count("nonsense")
+			if valid {
+				col.fail(ht, "IsValid(%q) = true; an impossible modifier value", e.text)
+			}
+		case e.isolatedInvalid():
+			col.count("invalid-isolated")
+			if valid {
+				col.fail(ht, "IsValid(%q) = true; the grammar rejects it", e.text)
+			}
+			if err == nil {
+				col.fail(ht, "IsDue(%q) = no error; the grammar rejects it", e.text)
+			}
+		default:
+			if Known.errorsDependOnRef {
+				col.count("invalid-gated")
+				return
+			}
+			col.count("invalid")
+			if valid {
+				col.fail(ht, "IsValid(%q) = true; the grammar rejects it", e.text)
+			}
+			if err == nil {
+				col.fail(ht, "IsDue(%q) = no error; the grammar rejects it", e.text)
+			}
+		}
+		// a wrong number of segments is always an error
+		if mode == "valid" && chance(ht, 10) {
+			bad := e.text + " * * *"
+			if chance(ht, 50) {
+				bad = strings.Join(strings.Fields(e.text)[1:], " ")
+				if e.written > 5 {
+					bad = strings.Join(strings.Fields(e.text)[e.written-4:], " ")
+				}
+			}
+			col.count("segment-count")
+			if gronx.IsValid(bad) {
+				col.fail(ht, "IsValid(%q) = true with %d segments", bad, len(strings.Fields(bad)))
+			}
+			if _, err := g.IsDue(bad, ref); err == nil {
+				col.fail(ht, "IsDue(%q) = no error with %d segments", bad, len(strings.Fields(bad)))
+			}
+		}
+	})
+}
