+// TestHegelNextAndPrevTicksFollowTheModel: NextTickAfter and PrevTickBefore, with and without
+// the reference instant, equal the model's earliest/latest due instant in fixed-offset zones;
+// an expression with no due instant is an error; croniter agrees on the shared subset.
+func TestHegelNextAndPrevTicksFollowTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		e := genExpr(ht, pick(ht, []string{"valid", "valid", "valid", "tag"}))
+		if !e.valid() || e.nonsense() || (e.newline && Known.newlineInvalid) {
+			return
+		}
+		loc := pick(ht, fixedZones)
+		ref := genInstant(ht, loc, true)
+		incl := chance(ht, 40)
+		trunc := ref.Truncate(time.Second)
+		if chance(ht, 30) {
+			// start exactly on a due instant, where incl matters
+			if d, ok := e.next(ref, true, ref.Year()+6); ok {
+				ref = d
+				if chance(ht, 50) {
+					ref = ref.Add(time.Duration(n(ht, 1, 999)) * time.Millisecond)
+				}
+				trunc = ref.Truncate(time.Second)
+			}
+		}
+		if e.restricted(pYear) && Known.steppedYearUnreachable && strippedUnreachable(e, ref.Year()) {
+			col.count("stepped-year-gated")
+			return
+		}
+		horizon := ref.Year() + 120
+		wantNext, okNext := e.next(ref, incl, horizon)
+		gotNext, errNext := gronx.NextTickAfter(e.text, ref, incl)
+		refDue := e.due(trunc)
+		switch {
+		case !okNext:
+			if errNext == nil && !incl && refDue && gotNext.Equal(trunc) && Known.lastTickIsTheReference {
+				col.count("next-last-tick-gated")
+				break
+			}
+			col.count("next-none")
+			if errNext == nil {
+				col.fail(ht, "NextTickAfter(%q, %v, %v) = %v; model: nothing until %d", e.text, ref, incl, gotNext, horizon)
+			}
+		case errNext != nil:
+			col.fail(ht, "NextTickAfter(%q, %v, %v) = %v; model %v", e.text, ref, incl, errNext, wantNext)
+		case !gotNext.Equal(wantNext):
+			if incl && wantNext.Equal(trunc) && gotNext.Equal(ref) && Known.inclKeepsFraction {
+				col.count("next-incl-fraction-gated")
+			} else {
+				col.fail(ht, "NextTickAfter(%q, %v, %v) = %v; model %v", e.text, ref, incl, gotNext, wantNext)
+			}
+		default:
+			col.count("next-ok")
+			if gotNext.Location() != loc {
+				col.fail(ht, "NextTickAfter(%q, %v) came back in %v", e.text, ref, gotNext.Location())
+			}
+		}
+		wantPrev, okPrev := e.prev(ref, incl, ref.Year()-120)
+		gotPrev, errPrev := gronx.PrevTickBefore(e.text, ref, incl)
+		switch {
+		case !okPrev:
+			if errPrev == nil && !incl && refDue && gotPrev.Equal(trunc) && Known.lastTickIsTheReference {
+				col.count("prev-last-tick-gated")
+				break
+			}
+			col.count("prev-none")
+			if errPrev == nil {
+				col.fail(ht, "PrevTickBefore(%q, %v, %v) = %v; model: nothing since %d", e.text, ref, incl, gotPrev, ref.Year()-120)
+			}
+		case errPrev != nil:
+			col.fail(ht, "PrevTickBefore(%q, %v, %v) = %v; model %v", e.text, ref, incl, errPrev, wantPrev)
+		case !gotPrev.Equal(wantPrev):
+			col.fail(ht, "PrevTickBefore(%q, %v, %v) = %v; model %v", e.text, ref, incl, gotPrev, wantPrev)
+		default:
+			col.count("prev-ok")
+		}
+		if croniterCompatible(e) && !incl {
+			// croniter: strictly after / before the instant, within fifty years
+			if okNext && wantNext.Year() < ref.Year()+45 {
+				col.count("croniter-next")
+				r := croniterNext(e.normalised(), trunc)
+				if !r.Ok || r.None {
+					col.fail(ht, "croniter next(%q, %v) failed: %s %s", e.normalised(), trunc, r.Error, r.Message)
+				} else if r.Time != wantNext.Unix() {
+					col.fail(ht, "croniter next(%q, %v) = %v; model %v", e.normalised(), trunc, time.Unix(r.Time, 0).In(loc), wantNext)
+				}
+			}
+			if okPrev && wantPrev.Year() > ref.Year()-45 && wantPrev.Year() >= 1970 {
+				col.count("croniter-prev")
+				r := croniterPrev(e.normalised(), trunc)
+				if !r.Ok || r.None {
+					col.fail(ht, "croniter prev(%q, %v) failed: %s %s", e.normalised(), trunc, r.Error, r.Message)
+				} else if r.Time != wantPrev.Unix() {
+					col.fail(ht, "croniter prev(%q, %v) = %v; model %v", e.normalised(), trunc, time.Unix(r.Time, 0).In(loc), wantPrev)
+				}
+			}
+		}
+	})
+}
+
+// TestHegelTicksInDSTZonesAreDueAndMinimal: in zones with daylight saving, NextTickAfter's
+// result is later than the reference, is due, and no instant between them is due (checked at
+// the model at one-second steps when the gap is short, else at the minute); likewise
+// PrevTickBefore.
+func TestHegelTicksInDSTZonesAreDueAndMinimal(t *testing.T) {
+	col := newCollector(t)
+	g := gronx.New()
+	zones := []string{"America/New_York", "Europe/Berlin", "Australia/Lord_Howe", "America/Santiago", "Europe/London"}
+	property(t, func(ht *hegel.T) {
+		e := genExpr(ht, pick(ht, []string{"valid", "valid", "tag"}))
+		if !e.valid() || e.nonsense() || (e.newline && Known.newlineInvalid) {
+			return
+		}
+		loc, err := time.LoadLocation(pick(ht, zones))
+		if err != nil {
+			return
+		}
+		ref := genInstant(ht, loc, false)
+		if chance(ht, 60) {
+			// near a transition of this year
+			ref = nearTransition(ht, ref, loc)
+		}
+		if e.restricted(pYear) {
+			col.count("year-skipped")
+			return
+		}
+		// bound the search: the fixed-zone model in UTC says roughly how far the next tick is
+		probe, ok := e.next(ref.UTC(), false, ref.Year()+8)
+		if !ok || probe.Sub(ref) > 3*24*time.Hour {
+			col.count("far-or-none")
+			return
+		}
+		if Known.midnightGapGivesUp && midnightMissing(ref, 4) {
+			col.count("midnight-gap-gated")
+			return
+		}
+		col.count("checked")
+		got, err := gronx.NextTickAfter(e.text, ref, false)
+		if err != nil {
+			col.fail(ht, "NextTickAfter(%q, %v) in %v = %v", e.text, ref, loc, err)
+			return
+		}
+		if !got.After(ref) {
+			col.fail(ht, "NextTickAfter(%q, %v) = %v is not after", e.text, ref, got)
+			return
+		}
+		if due, err := g.IsDue(e.text, got); err != nil || !due {
+			col.fail(ht, "NextTickAfter(%q, %v) = %v is not due (%v, %v)", e.text, ref, got, due, err)
+			return
+		}
+		if !e.due(got) {
+			col.fail(ht, "NextTickAfter(%q, %v) = %v; the model says not due", e.text, ref, got)
+		}
+		// nothing due in between
+		step := time.Second
+		if got.Sub(ref) > 6*time.Hour {
+			step = time.Minute
+		}
+		for x := ref.Add(step).Truncate(step); x.Before(got); x = x.Add(step) {
+			if e.due(x) {
+				if ambiguous(x) && Known.fallBackSkipsTicks {
+					col.count("ambiguous-hour-gated")
+					return
+				}
+				col.fail(ht, "NextTickAfter(%q, %v) = %v but %v is due first", e.text, ref, got, x)
+				return
+			}
+		}
+	})
+}
+
+// ambiguous: the wall clock of x occurs twice (a fall-back transition), i.e. another instant
+// an hour or half an hour away reads the same.
+func ambiguous(x time.Time) bool {
+	for _, delta := range []time.Duration{time.Hour, -time.Hour, 30 * time.Minute, -30 * time.Minute} {
+		o := x.Add(delta)
+		if o.Year() == x.Year() && o.YearDay() == x.YearDay() && o.Hour() == x.Hour() && o.Minute() == x.Minute() && o.Second() == x.Second() {
+			return true
+		}
+	}
+	return false
+}
+
+// midnightMissing: one of the next days days from ref has no 00:00:00 wall clock in its zone.
+func midnightMissing(ref time.Time, days int) bool {
+	loc := ref.Location()
+	y, m, d := ref.Date()
+	for i := 0; i <= days; i++ {
+		x := time.Date(y, m, d+i, 0, 0, 0, 0, loc)
+		if x.Hour() != 0 || x.Minute() != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// strippedUnreachable mimics gronx/7: with the steps stripped, every year item lies before the
+// reference year although a stepped item reaches beyond it.
+func strippedUnreachable(e *expr, year int) bool {
+	stepped := false
+	for _, it := range e.segs[pYear].items {
+		switch it.kind {
+		case "starstep":
+			return false
+		case "numstep":
+			if it.a < bounds[pYear][0]+1 {
+				return false // "0/s" is recognised
+			}
+			if it.a >= year {
+				return false
+			}
+			stepped = true
+		case "num":
+			if it.a >= year {
+				return false
+			}
+		case "range", "rangestep":
+			if it.a >= year || it.b >= year {
+				return false
+			}
+		}
+	}
+	return stepped
+}
+
+// nearTransition moves ref into the day of a DST transition of its year, within a few hours of
+// it, when the zone has one.
+func nearTransition(tc hegel.TestCase, ref time.Time, loc *time.Location) time.Time {
+	y := ref.Year()
+	t := time.Date(y, 1, 1, 0, 0, 0, 0, loc)
+	_, off := t.Zone()
+	var trans []time.Time
+	for t.Year() == y {
+		nt := t.Add(time.Hour)
+		if _, o := nt.Zone(); o != off {
+			off = o
+			trans = append(trans, nt)
+		}
+		t = nt
+	}
+	if len(trans) == 0 {
+		return ref
+	}
+	tr := pick(tc, trans)
+	return tr.Add(time.Duration(n(tc, -180, 180)) * time.Minute).Add(time.Duration(n(tc, 0, 59)) * time.Second)
+}
+
+// TestHegelBatchDueAgreesWithIsDue: BatchDue on a list of expressions gives each the Due and
+// error IsDue gives it, with duplicates and tags.
+func TestHegelBatchDueAgreesWithIsDue(t *testing.T) {
+	col := newCollector(t)
+	g := gronx.New()
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 6)
+		var exprs []*expr
+		for i := 0; i < k; i++ {
+			if i > 0 && chance(ht, 20) {
+				exprs = append(exprs, exprs[n(ht, 0, i-1)])
+				continue
+			}
+			exprs = append(exprs, genExpr(ht, pick(ht, []string{"valid", "valid", "valid", "tag", "invalid"})))
+		}
+		loc := pick(ht, fixedZones)
+		ref := genInstant(ht, loc, true)
+		if chance(ht, 50) {
+			if d, ok := exprs[0].next(ref, true, ref.Year()+6); ok {
+				ref = d
+			}
+		}
+		texts := make([]string, k)
+		for i, e := range exprs {
+			texts[i] = e.text
+		}
+		batch := g.BatchDue(texts, ref)
+		if len(batch) != k {
+			col.fail(ht, "BatchDue gave %d results for %d expressions", len(batch), k)
+			return
+		}
+		for i, e := range exprs {
+			if batch[i].Expr != e.text {
+				col.fail(ht, "BatchDue result %d carries %q for %q", i, batch[i].Expr, e.text)
+			}
+			due, err := g.IsDue(e.text, ref)
+			if !e.valid() || e.nonsense() || e.newline {
+				// the order of the segment checks differs, so which fault is reported may too
+				col.count("invalid")
+				if (err == nil) != (batch[i].Err == nil) && !Known.errorsDependOnRef {
+					col.fail(ht, "BatchDue(%q) err %v; IsDue err %v", e.text, batch[i].Err, err)
+				}
+				continue
+			}
+			if e.restricted(pDom) && e.restricted(pDow) && !e.intersect() && Known.batchIgnoresUnion {
+				col.count("union-gated")
+				continue
+			}
+			col.count("valid")
+			if err != nil || batch[i].Err != nil {
+				col.fail(ht, "BatchDue(%q) err %v; IsDue err %v", e.text, batch[i].Err, err)
+				continue
+			}
+			if batch[i].Due != due {
+				col.fail(ht, "BatchDue(%q, %v) = %v; IsDue %v (model %v)", e.text, ref, batch[i].Due, due, e.due(ref))
+			}
+		}
+	})
+}
+
+var tagSeq atomic.Int64
+
+// TestHegelTagsExpandToTheirExpression: a tag added with AddTag behaves as its expression for
+// IsValid, IsDue, Segments and the ticks; adding it twice is a conflict; an invalid expression
+// is refused and leaves no tag; the built-in tags are read in any case.
+func TestHegelTagsExpandToTheirExpression(t *testing.T) {
+	col := newCollector(t)
+	g := gronx.New()
+	property(t, func(ht *hegel.T) {
+		e := genExpr(ht, pick(ht, []string{"valid", "valid", "invalid"}))
+		if e.newline {
+			return
+		}
+		lower := "abcdefghijklmnopqrstuvwxyz"
+		alphabet := lower + "0123456789_-"
+		if chance(ht, 25) {
+			alphabet += "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+		}
+		name := "@" + word(ht, alphabet, 1, 8) + strconv.FormatInt(tagSeq.Add(1), 36)
+		if chance(ht, 30) {
+			name = word(ht, alphabet, 1, 8) + strconv.FormatInt(tagSeq.Add(1), 36) // tags need no @
+		}
+		hasUpper := strings.ToLower(name) != name
+		err := gronx.AddTag(name, e.text)
+		loc := pick(ht, fixedZones)
+		ref := genInstant(ht, loc, false)
+		if !e.valid() {
+			col.count("invalid")
+			if err == nil && !Known.addTagUnchecked {
+				col.fail(ht, "AddTag(%q, %q) accepted an invalid expression", name, e.text)
+			}
+			if gronx.IsValid(name) && (err != nil || e.isolatedInvalid() || !Known.errorsDependOnRef) {
+				col.fail(ht, "IsValid(%q) = true for a tag of the invalid %q (AddTag: %v)", name, e.text, err)
+			}
+			return
+		}
+		if err != nil {
+			col.fail(ht, "AddTag(%q, %q) = %v", name, e.text, err)
+			return
+		}
+		if err := gronx.AddTag(name, e.text); err == nil {
+			col.fail(ht, "AddTag(%q) twice: no conflict error", name)
+		}
+		if hasUpper && Known.tagCaseUnusable {
+			col.count("upper-gated")
+			return
+		}
+		col.count("tag")
+		if !gronx.IsValid(name) {
+			col.fail(ht, "IsValid(%q) = false for a tag of %q", name, e.text)
+			return
+		}
+		segs, err := gronx.Segments(name)
+		if err != nil || strings.Join(segs, " ") != e.normalised() {
+			col.fail(ht, "Segments(%q) = %q, %v; expression %q", name, segs, err, e.normalised())
+		}
+		d1, err1 := g.IsDue(name, ref)
+		d2, err2 := g.IsDue(e.text, ref)
+		if d1 != d2 || (err1 == nil) != (err2 == nil) {
+			col.fail(ht, "IsDue(%q) = %v, %v; IsDue(%q) = %v, %v", name, d1, err1, e.text, d2, err2)
+		}
+		if e.restricted(pYear) {
+			return
+		}
+		n1, e1 := gronx.NextTickAfter(name, ref, false)
+		n2, e2 := gronx.NextTickAfter(e.text, ref, false)
+		if !n1.Equal(n2) || (e1 == nil) != (e2 == nil) {
+			col.fail(ht, "NextTickAfter(%q) = %v, %v; NextTickAfter(%q) = %v, %v", name, n1, e1, e.text, n2, e2)
+		}
+	})
+}
+
+// word draws lo..hi runes from alphabet.
+func word(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	pool := []rune(alphabet)
+	idx := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, len(pool)-1)).MinSize(lo).MaxSize(hi))
+	var b strings.Builder
+	for _, i := range idx {
+		b.WriteRune(pool[i])
+	}
+	return b.String()
+}
