new file mode 100644
index 0000000..309d7ee
--- /dev/null
+++ b/hegel_zoo_props_test.go
@@ -0,0 +1,248 @@
+package gronx_test
+
+// The seven wide properties: each draws a case record (hegel_zoo_cases_test.go), runs the
+// classifier on it (the model per switch, hegel_zoo_model_test.go) to name the recorded bug
+// whose shape the case has, then asks the library (and croniter, once, on the shared subset)
+// the questions the model answered, and judges the answers against the documented ones,
+// failing "(the shape of gronx/N)" on a named case. Under HEGEL_NO_KNOWN=1 the shapes are off:
+// the newline and the nonsense mode at weight zero, the invalid mode reduced to a lone invalid
+// item every walk reaches (gronx/2's shape needs an item the walk can miss), the fraction off
+// when the reference is included (gronx/6), the tag property's invalid mode and capitals at
+// weight zero (gronx/8, gronx/5), and the rest filtered out on the classifier (withoutShapes:
+// gronx/7 and gronx/11 in the tick property, gronx/9 and gronx/10 in the DST property) or
+// dropped per check (judgeByDropping: gronx/1 in the batch property, whose shape is one entry
+// of a list); gronx/12's extra-part texts are at weight zero in the bad pool, gronx/13 is
+// filtered out on the classifier in the DST property.
+
+import (
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/adhocore/gronx"
+)
+
+var gron = gronx.New()
+
+// okOrError spells a call that returns only an error.
+func okOrError(err error) string {
+	if err != nil {
+		return errValue
+	}
+	return "ok"
+}
+
+// tickOf spells a tick call's answer.
+func tickOf(t time.Time, err error) string {
+	if err != nil {
+		return errValue
+	}
+	return tickValue(t)
+}
+
+// croniterDue spells croniter's match: the boolean, or its refusal.
+func croniterDue(r dueReply) string {
+	if !r.Ok {
+		return "refused: " + r.Error + " " + r.Message
+	}
+	return strconv.FormatBool(r.Due)
+}
+
+// croniterTick spells croniter's tick: the Unix seconds, "none", or its refusal.
+func croniterTick(r tickReply) string {
+	if !r.Ok {
+		return "refused: " + r.Error + " " + r.Message
+	}
+	if r.None {
+		return "none"
+	}
+	return strconv.FormatInt(r.Time, 10)
+}
+
+// segmentsOf spells Segments' answer.
+func segmentsOf(segs []string, err error) string {
+	if err != nil {
+		return errValue
+	}
+	return strings.Join(segs, " ")
+}
+
+// The library's answers to each family's questions (the wide and the narrow properties
+// share them).
+
+func validityActual(c *validityCase) checks {
+	got := checks{}
+	got.set("valid", gronx.IsValid(c.e.text))
+	_, err := gron.IsDue(c.e.text, c.ref)
+	got.set("due error", err != nil)
+	if c.count != countNone {
+		bad := c.countText()
+		got.set("count valid", gronx.IsValid(bad))
+		_, err := gron.IsDue(bad, c.ref)
+		got.set("count error", err != nil)
+	}
+	return got
+}
+
+func segmentsActual(c *segmentsCase) checks {
+	got := checks{}
+	got.set("segments", segmentsOf(gronx.Segments(c.e.text)))
+	return got
+}
+
+// dueActual asks croniter first (once), then the library.
+func dueActual(c *dueCase) checks {
+	got := checks{}
+	if croniterCompatible(c.e) {
+		got.set("croniter", croniterDue(croniterMatch(c.e.normalised(), c.ref)))
+	}
+	due, err := gron.IsDue(c.e.text, c.ref)
+	got.set("due", dueValue(due, err != nil))
+	return got
+}
+
+// ticksActual asks croniter first (once per direction: strictly after or before the
+// truncated instant, within its reach), then the library.
+func ticksActual(c *ticksCase) checks {
+	got := checks{}
+	trunc := c.ref.Truncate(time.Second)
+	if croniterCompatible(c.e) && !c.incl {
+		if c.facts.okNext[0] && c.facts.next[0].Year() < c.ref.Year()+45 {
+			got.set("croniter next", croniterTick(croniterNext(c.e.normalised(), trunc)))
+		}
+		if c.facts.okPrev[0] && c.facts.prev[0].Year() > c.ref.Year()-45 && c.facts.prev[0].Year() >= 1970 {
+			got.set("croniter prev", croniterTick(croniterPrev(c.e.normalised(), trunc)))
+		}
+	}
+	got.set("next", tickOf(gronx.NextTickAfter(c.e.text, c.ref, c.incl)))
+	got.set("prev", tickOf(gronx.PrevTickBefore(c.e.text, c.ref, c.incl)))
+	return got
+}
+
+func dstActual(c *dstCase) checks {
+	got := checks{}
+	got.set("next", tickOf(gronx.NextTickAfter(c.e.text, c.ref, false)))
+	got.set("prev", tickOf(gronx.PrevTickBefore(c.e.text, c.ref, false)))
+	return got
+}
+
+func batchActual(c *batchCase) checks {
+	got := checks{}
+	exprs := c.exprs()
+	texts := make([]string, len(exprs))
+	for i, e := range exprs {
+		texts[i] = e.text
+	}
+	batch := gron.BatchDue(texts, c.ref)
+	if len(batch) != len(exprs) {
+		got.set("length", len(batch))
+		return got
+	}
+	for i, b := range batch {
+		got.set("expr "+strconv.Itoa(i), b.Expr)
+		got.set("batch "+strconv.Itoa(i), dueValue(b.Due, b.Err != nil))
+	}
+	return got
+}
+
+var tagSeq atomic.Int64
+
+// tagsActual registers the tag (its name is the drawn base and a counter, so that every
+// name is new) and asks the library about it.
+func tagsActual(c *tagsCase) checks {
+	got := checks{}
+	got.set("addtag", okOrError(gronx.AddTag(c.tag, c.e.text)))
+	got.set("readd", okOrError(gronx.AddTag(c.tag, c.e.text)))
+	got.set("valid", gronx.IsValid(c.tag))
+	got.set("segments", segmentsOf(gronx.Segments(c.tag)))
+	due, err := gron.IsDue(c.tag, c.ref)
+	got.set("due", dueValue(due, err != nil))
+	if c.e.valid() && !c.e.restricted(pYear) {
+		got.set("next", tickOf(gronx.NextTickAfter(c.tag, c.ref, false)))
+	}
+	return got
+}
+
+// nextTagName is the name the case registers: the drawn base and the counter. The counter is
+// written at a fixed width, since the base may end in digits and letters: with a bare suffix
+// "@a1" + "z" and "@a" + "1z" are the same tag, and a case failed on a conflict that its replay,
+// with a fresh counter, could not reproduce (a bare --- FAIL once in forty rounds).
+func nextTagName(c *tagsCase) {
+	seq := strconv.FormatInt(tagSeq.Add(1), 36)
+	c.tag = c.name.base() + strings.Repeat("0", 6-len(seq)) + seq
+}
+
+// TestHegelValidityFollowsTheGrammar: IsValid is true for exactly the expressions the grammar
+// accepts, IsDue reports an error for exactly the ones it rejects, and a wrong number of
+// segments is always an error.
+func TestHegelValidityFollowsTheGrammar(t *testing.T) {
+	judged(t, withoutShapes(validityExpected, validityCases), func(j *hzCaseJudge, c validityCase) {
+		judgeBy(j, &c, validityExpected, validityActual)
+	})
+}
+
+// TestHegelSegmentsNormaliseAsDocumented: Segments gives the normalised six or seven segments
+// (a 0 second prepended to five segments and to six with a year, names replaced, whitespace
+// collapsed, tags expanded).
+func TestHegelSegmentsNormaliseAsDocumented(t *testing.T) {
+	judged(t, withoutShapes(segmentsExpected, segmentsCases), func(j *hzCaseJudge, c segmentsCase) {
+		judgeBy(j, &c, segmentsExpected, segmentsActual)
+	})
+}
+
+// TestHegelIsDueFollowsTheModel: IsDue equals the model at random instants and at instants
+// the model says are due, is an error for an invalid expression, and croniter agrees with
+// the model on the shared subset (asked once, before the library).
+func TestHegelIsDueFollowsTheModel(t *testing.T) {
+	judged(t, withoutShapes(dueExpected, dueCases), func(j *hzCaseJudge, c dueCase) {
+		judgeBy(j, &c, dueExpected, dueActual)
+	})
+}
+
+// TestHegelNextAndPrevTicksFollowTheModel: NextTickAfter and PrevTickBefore, with and
+// without the reference instant, equal the model's earliest and latest due instants in
+// fixed-offset zones, come back in the reference's zone, and are errors for an expression
+// with no due instant; croniter agrees with the model on the shared subset (asked once,
+// before the library).
+func TestHegelNextAndPrevTicksFollowTheModel(t *testing.T) {
+	// (a stepped year whose ticks the model finds none of within its horizon, years 0..9999,
+	// is out: the library searches on, expr.yearStarStepped)
+	cases := hzOnly(true, "beyond the model's horizon", withoutShapes(ticksExpected, ticksCases), func(c ticksCase) bool {
+		return !c.e.yearStarStepped() || (c.facts.okNext[0] && c.facts.okPrev[0])
+	})
+	judged(t, cases, func(j *hzCaseJudge, c ticksCase) {
+		judgeBy(j, &c, ticksExpected, ticksActual)
+	})
+}
+
+// TestHegelTicksInDSTZonesAreDueAndMinimal: in zones with daylight saving, NextTickAfter and
+// PrevTickBefore (the reference excluded) equal the exact model's earliest and latest due
+// instants: the due wall clocks of the days the date fields accept, at every offset in effect
+// that day, where the wall clock exists.
+func TestHegelTicksInDSTZonesAreDueAndMinimal(t *testing.T) {
+	judged(t, withoutShapes(dstExpected, dstCases), func(j *hzCaseJudge, c dstCase) {
+		judgeBy(j, &c, dstExpected, dstActual)
+	})
+}
+
+// TestHegelBatchDueAgreesWithIsDue: BatchDue on a list of expressions carries each text back
+// and gives each the Due and error IsDue gives it (the model's), with duplicates and tags.
+// Under HEGEL_NO_KNOWN=1 the entries of gronx/1's shape are dropped from the case (a batch
+// of several entries has one too often for a filter).
+func TestHegelBatchDueAgreesWithIsDue(t *testing.T) {
+	judged(t, batchCases, func(j *hzCaseJudge, c batchCase) {
+		judgeByDropping(j, &c, batchExpected, batchActual, []int{kBatchIgnoresUnion})
+	})
+}
+
+// TestHegelTagsExpandToTheirExpression: a tag added with AddTag behaves as its expression for
+// IsValid, Segments, IsDue and NextTickAfter; adding it twice is a conflict; an invalid
+// expression is refused and leaves no tag.
+func TestHegelTagsExpandToTheirExpression(t *testing.T) {
+	judged(t, withoutShapes(tagsExpected, tagsCases), func(j *hzCaseJudge, c tagsCase) {
+		nextTagName(&c)
+		judgeBy(j, &c, tagsExpected, tagsActual)
+	})
+}
diff --git a/hegel_zoo_shapes_test.go b/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..abad418
--- /dev/null
+++ b/hegel_zoo_shapes_test.go
@@ -0,0 +1,681 @@
+package gronx_test
+
+// The eleven narrow properties, one per recorded bug: each draws the region of its bug's
+// shape by construction (and under HEGEL_NO_KNOWN=1 the neighbouring region past it,
+// hzShaped), keeps the cases the classifier names as that bug (regionOf: by default the shape,
+// under HEGEL_NO_KNOWN=1 the cases with no shape), and judges them with the family's expected
+// function and the library's answers (hegel_zoo_props_test.go). Each fails every run by
+// default naming its bug and passes under HEGEL_NO_KNOWN=1. Where an earlier bug in bug order
+// would be named first, the construction keeps that bug's shape out (said at each).
+
+import (
+	"strconv"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+func numItem(v int) item { return item{kind: "num", a: v, text: strconv.Itoa(v), valid: true} }
+
+var starSeg = segSpec{star: "*"}
+
+// plainSpec is an expression record of the given segments with single spaces and no
+// blanks (the narrow properties vary what their bug depends on).
+func plainSpec(mode string, form written, segs [7]segSpec) exprSpec {
+	return exprSpec{mode: mode, form: form, special: -1, segs: segs, sep: " "}
+}
+
+// --------------------------------------------------------------------------- gronx/1
+
+// unionDaySeg is a listed day segment under the union rule: its first item is not "*/s"
+// (the day-of-month must not start with "*", the weekday not with "*/"), the rest as any
+// valid segment's.
+func unionDaySeg(pos int) hegel.Generator[segSpec] {
+	first := halvesGens([]int{35, 20, 10, 8, 14}, numAt(pos), rangeAt(pos), numStepAt(pos), rangeStepAt(pos), modAt(pos))
+	return withCoins(hegel.FlatMap(first, func(it item) hegel.Generator[segSpec] {
+		return hegel.Map(dieChoice(hzW(70, hegel.Just[[]item](nil)), hzW(30, countedHalves(validItemGen[pos], 1, 3))), func(rest []item) segSpec {
+			return segSpec{items: append([]item{it}, rest...)}
+		})
+	}))
+}
+
+// unionExprs is a five-segment expression with both day segments listed under the union
+// rule.
+var unionExprs = hegel.Composite(func(tc hegel.TestCase) exprSpec {
+	var segs [7]segSpec
+	segs[pMin] = hegel.Draw(tc, segGen[segValid][pMin])
+	segs[pHour] = hegel.Draw(tc, segGen[segValid][pHour])
+	segs[pDom] = hegel.Draw(tc, unionDaySeg(pDom))
+	segs[pMon] = hegel.Draw(tc, segGen[segValid][pMon])
+	segs[pDow] = hegel.Draw(tc, unionDaySeg(pDow))
+	return plainSpec(modeValid, form5, segs)
+})
+
+// dayMatchTick is the first due instant at or after ref (within six years, by days) on a
+// day where the two day segments match as asked: one of them (unionOnly) or both; ok false
+// when none is found.
+func dayMatchTick(e *expr, ref time.Time, unionOnly bool) (time.Time, bool) {
+	v := e.view(false)
+	t, incl := ref, true
+	for i := 0; i < 400; i++ {
+		d, ok := v.tickAfter(t, incl)
+		if !ok || d.Year() > ref.Year()+6 {
+			return ref, false
+		}
+		if v.dueIntersect(d) != unionOnly {
+			return d, true
+		}
+		// the next day
+		t, incl = time.Date(d.Year(), d.Month(), d.Day()+1, 0, 0, 0, 0, d.Location()), true
+	}
+	return ref, false
+}
+
+// unionBatches is a batch of one such expression at a reference the model finds due on a day
+// where only one day segment matches (the shape: BatchDue intersects); under HEGEL_NO_KNOWN=1
+// on a day where both match (BatchDue and IsDue agree). A case where no such day is found
+// within six years is filtered out by regionOf (measured rejection 1 or 2 in 3000).
+var unionBatches = hegel.FlatMap(unionExprs, func(s exprSpec) hegel.Generator[batchCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[batchCase] {
+		return hegel.Map(fracInstant, func(i instantSpec) batchCase {
+			e := s.build()
+			c := batchCase{entries: []batchEntry{{dup: -1, spec: s}}, zone: z, inst: i, atDue: true, built: []*expr{e}}
+			c.ref = i.at(fixedZones[z])
+			c.ref, c.moved = dayMatchTick(e, c.ref, hzShaped(true, false))
+			return c
+		})
+	})
+})
+
+// TestHegelBatchesApplyTheDayUnion: BatchDue gives an expression with both day segments
+// restricted the Due IsDue gives it on a day where only one of them matches (gronx/1).
+func TestHegelBatchesApplyTheDayUnion(t *testing.T) {
+	judged(t, regionOf("gronx/1", batchExpected, unionBatches), func(j *hzCaseJudge, c batchCase) {
+		judgeBy(j, &c, batchExpected, batchActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/2
+
+// hiddenInvalidCases is an expression whose only listed segment holds a value due at the
+// reference followed by an item the grammar rejects (the shape: IsDue returns at the due
+// item and never reads the invalid one), every other segment "*" or "?" (in the
+// six-with-year form the year is the reference's, so that it is read as a year and is due,
+// and is never the listed segment: a sixth segment without four digits is read as the
+// weekday); under HEGEL_NO_KNOWN=1 the invalid item alone (every walk reaches it). The
+// invalid item is drawn without gronx/12's extra-part texts (strictBadItemGen).
+var hiddenInvalidCases = hegel.FlatMap(formTable, func(form written) hegel.Generator[validityCase] {
+	positions := form.candidates(modeInvalid)
+	if form.yearForm {
+		positions = positions[:len(positions)-1] // the year, the last position
+	}
+	return hegel.FlatMap(evenHalves(positions...), func(pos int) hegel.Generator[validityCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[validityCase] {
+			return hegel.FlatMap(wholeInstant, func(i instantSpec) hegel.Generator[validityCase] {
+				ref := i.at(fixedZones[z])
+				due := numItem(libValueByPos(ref, pos))
+				return hegel.FlatMap(strictBadItemGen[pos], func(bad item) hegel.Generator[validityCase] {
+					items := hzShaped[[]item]([]item{due, bad}, []item{bad})
+					return hegel.Composite(func(tc hegel.TestCase) validityCase {
+						var segs [7]segSpec
+						for p := 0; p < 7; p++ {
+							if !form.present(p) {
+								continue
+							}
+							if p == pos {
+								segs[p] = hegel.Draw(tc, itemsAt(items...))
+								continue
+							}
+							if p == pYear && form.yearForm {
+								segs[p] = segSpec{items: []item{numItem(ref.Year())}}
+								continue
+							}
+							segs[p] = hegel.Draw(tc, starAt(p))
+						}
+						s := plainSpec(modeInvalid, form, segs)
+						s.special = pos
+						return validityCase{spec: s, zone: z, inst: i, count: countNone, e: s.build(), ref: ref}
+					})
+				})
+			})
+		})
+	})
+})
+
+// TestHegelInvalidItemsAreReportedWherever: IsDue reports an item the grammar rejects
+// wherever it stands in its segment, also behind an item that is due (gronx/2).
+func TestHegelInvalidItemsAreReportedWherever(t *testing.T) {
+	judged(t, regionOf("gronx/2", validityExpected, hiddenInvalidCases), func(j *hzCaseJudge, c validityCase) {
+		judgeBy(j, &c, validityExpected, validityActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/3
+
+// nonsenseAloneCases is an expression whose only listed segment is one impossible modifier
+// in a day segment (the shape), every other segment "*" (so that the walk reaches it and
+// gronx/2 is not named first); under HEGEL_NO_KNOWN=1 one modifier in bounds.
+var nonsenseAloneCases = hegel.FlatMap(evenHalves(pDom, pDow), func(pos int) hegel.Generator[validityCase] {
+	return hegel.FlatMap(hzShaped[hegel.Generator[item]](nonsenseItemGen[pos], modAt(pos)), func(it item) hegel.Generator[validityCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[validityCase] {
+			return hegel.FlatMap(wholeInstant, func(i instantSpec) hegel.Generator[validityCase] {
+				return hegel.Map(itemsAt(it), func(sg segSpec) validityCase {
+					segs := [7]segSpec{pMin: starSeg, pHour: starSeg, pDom: starSeg, pMon: starSeg, pDow: starSeg}
+					segs[pos] = sg
+					s := plainSpec(modeNonsense, form5, segs)
+					s.special = pos
+					return validityCase{spec: s, zone: z, inst: i, count: countNone, e: s.build(), ref: i.at(fixedZones[z])}
+				})
+			})
+		})
+	})
+})
+
+// TestHegelImpossibleModifiersAreRefused: IsValid is false and IsDue an error on a modifier
+// value out of bounds (gronx/3).
+func TestHegelImpossibleModifiersAreRefused(t *testing.T) {
+	judged(t, regionOf("gronx/3", validityExpected, nonsenseAloneCases), func(j *hzCaseJudge, c validityCase) {
+		judgeBy(j, &c, validityExpected, validityActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/4
+
+// newlineCases is a valid expression ending in a newline (the shape); under HEGEL_NO_KNOWN=1
+// ending in a blank instead.
+var newlineCases = hegel.FlatMap(exprDraw{modes: hegel.Just(modeValid), forms: formTable}.gen(), func(s exprSpec) hegel.Generator[segmentsCase] {
+	return hegel.Map(hzShaped[hegel.Generator[string]](hegel.Just(""), evenHalves(" ", "\t", " \t")), func(trail string) segmentsCase {
+		s.newline, s.trail = hzShaped(true, false), trail
+		return segmentsCase{spec: s, e: s.build()}
+	})
+})
+
+// TestHegelTrailingNewlinesAreTrimmed: Segments reads an expression ending in a newline as
+// the same expression without it (gronx/4).
+func TestHegelTrailingNewlinesAreTrimmed(t *testing.T) {
+	judged(t, regionOf("gronx/4", segmentsExpected, newlineCases), func(j *hzCaseJudge, c segmentsCase) {
+		judgeBy(j, &c, segmentsExpected, segmentsActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/5
+
+// capitalTagCases is a valid expression under a tag name of lower-case letters with one
+// forced to a capital (the shape); under HEGEL_NO_KNOWN=1 none.
+var capitalTagCases = hegel.FlatMap(exprDraw{modes: hegel.Just(modeValid), forms: formTable}.gen(), func(s exprSpec) hegel.Generator[tagsCase] {
+	return hegel.FlatMap(nameSpecsOf(0), func(n nameSpec) hegel.Generator[tagsCase] {
+		return hegel.FlatMap(hzShaped[hegel.Generator[int]](rangeHalves(0, len(n.letters)-1), hegel.Just(-1)), func(capital int) hegel.Generator[tagsCase] {
+			n.capital = capital
+			return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[tagsCase] {
+				return hegel.Map(wholeInstant, func(i instantSpec) tagsCase {
+					return builtTagsCase(s, n, z, i)
+				})
+			})
+		})
+	})
+})
+
+// builtTagsCase is the tag property's record from its parts.
+func builtTagsCase(s exprSpec, n nameSpec, z int, i instantSpec) tagsCase {
+	c := tagsCase{spec: s, name: n, zone: z, inst: i}
+	c.e = s.build()
+	c.ref = i.at(fixedZones[z])
+	if c.e.valid() && !c.e.nonsense() && !c.e.restricted(pYear) {
+		c.facts = tickFactsOf(c.e, c.ref, false)
+	}
+	return c
+}
+
+// TestHegelUpperCaseTagsAreUsable: a tag added under a name with a capital letter is read
+// like any other (gronx/5).
+func TestHegelUpperCaseTagsAreUsable(t *testing.T) {
+	judged(t, regionOf("gronx/5", tagsExpected, capitalTagCases), func(j *hzCaseJudge, c tagsCase) {
+		nextTagName(&c)
+		judgeBy(j, &c, tagsExpected, tagsActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/6
+
+// yearlessForms is the forms without a year segment (the ticks always exist: gronx/7 and
+// gronx/11 cannot be named).
+var yearlessForms = halvesOver([]int{5, 2}, form5, form6)
+
+// inclusiveFractionCases is a valid expression without a year, the reference included and
+// moved onto a due instant with 1..999 milliseconds added (the shape); under HEGEL_NO_KNOWN=1
+// on the whole second. A case whose due instant is not found within six years is filtered
+// out by regionOf.
+var inclusiveFractionCases = hegel.FlatMap(exprDraw{modes: hegel.Just(modeValid), forms: yearlessForms}.gen(), func(s exprSpec) hegel.Generator[ticksCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[ticksCase] {
+		return hegel.FlatMap(wholeInstant, func(i instantSpec) hegel.Generator[ticksCase] {
+			return hegel.Map(hzShaped[hegel.Generator[int]](hzInts(1, 999), hegel.Just(0)), func(ms int) ticksCase {
+				c := ticksCase{spec: s, zone: z, inst: i, incl: true, atDue: true, ms: ms}
+				c.e = s.build()
+				c.ref = i.at(fixedZones[z])
+				if d, ok := movedToDue(c.e, c.ref); ok {
+					c.ref, c.moved = d.Add(time.Duration(ms)*time.Millisecond), true
+				}
+				c.facts = tickFactsOf(c.e, c.ref, c.incl)
+				return c
+			})
+		})
+	})
+})
+
+// TestHegelInclusiveTicksAreWholeSeconds: NextTickAfter with the reference included returns
+// the reference's second, not its fraction, when it is due (gronx/6).
+func TestHegelInclusiveTicksAreWholeSeconds(t *testing.T) {
+	judged(t, regionOf("gronx/6", ticksExpected, inclusiveFractionCases), func(j *hzCaseJudge, c ticksCase) {
+		judgeBy(j, &c, ticksExpected, ticksActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/7
+
+// yearForms is the forms with a year segment.
+var yearForms = halvesOver([]int{4, 5}, form6y, form7)
+
+// steppedYearCases is an expression whose year segment is one stepped item "a/s" with a
+// before the reference's year (the shape: isUnreachableYear strips the step and sees only a)
+// and a step of 1..100; under HEGEL_NO_KNOWN=1 with a at or after the reference's year. The
+// reference is excluded (gronx/6 and gronx/11 cannot be named); a case with no due day (a
+// date the other segments never accept) is filtered out by regionOf.
+var steppedYearCases = hegel.FlatMap(yearForms, func(form written) hegel.Generator[ticksCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[ticksCase] {
+		return hegel.FlatMap(fracInstant, func(i instantSpec) hegel.Generator[ticksCase] {
+			y := i.at(fixedZones[z]).Year()
+			return hegel.FlatMap(hzShaped[hegel.Generator[int]](hzInts(1990, y-1), hzInts(y, 2100)), func(a int) hegel.Generator[ticksCase] {
+				return hegel.FlatMap(hzInts(1, 100), func(step int) hegel.Generator[ticksCase] {
+					year := item{kind: "numstep", a: a, step: step, text: strconv.Itoa(a) + "/" + strconv.Itoa(step), valid: true}
+					return hegel.Composite(func(tc hegel.TestCase) ticksCase {
+						var segs [7]segSpec
+						for p := 0; p < 7; p++ {
+							if !form.present(p) {
+								continue
+							}
+							if p == pYear {
+								segs[p] = segSpec{items: []item{year}}
+								continue
+							}
+							segs[p] = hegel.Draw(tc, segGen[segValid][p])
+						}
+						s := plainSpec(modeValid, form, segs)
+						c := ticksCase{spec: s, zone: z, inst: i, incl: false}
+						c.e = s.build()
+						c.ref = i.at(fixedZones[z])
+						c.facts = tickFactsOf(c.e, c.ref, c.incl)
+						return c
+					})
+				})
+			})
+		})
+	})
+})
+
+// TestHegelSteppedYearsTick: NextTickAfter finds the next year of a stepped year segment
+// that starts before the reference (gronx/7).
+func TestHegelSteppedYearsTick(t *testing.T) {
+	judged(t, regionOf("gronx/7", ticksExpected, steppedYearCases), func(j *hzCaseJudge, c ticksCase) {
+		judgeBy(j, &c, ticksExpected, ticksActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/8
+
+// invalidTagCases is an expression with one invalid item alone (every walk reaches it, so
+// gronx/2 is not named first; drawn without gronx/12's extra-part texts, which gronx reads
+// as valid) under a lower-case tag name (gronx/5 is not); under HEGEL_NO_KNOWN=1 a valid
+// expression.
+var invalidTagCases = hegel.FlatMap(exprDraw{modes: hzShaped[hegel.Generator[string]](hegel.Just(modeInvalid), hegel.Just(modeValid)), forms: formTable, alone: true, aloneAt: -1, strict: true}.gen(), func(s exprSpec) hegel.Generator[tagsCase] {
+	return hegel.FlatMap(nameSpecsOf(0), func(n nameSpec) hegel.Generator[tagsCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[tagsCase] {
+			return hegel.Map(wholeInstant, func(i instantSpec) tagsCase {
+				return builtTagsCase(s, n, z, i)
+			})
+		})
+	})
+})
+
+// TestHegelAddedTagsAreValidated: AddTag refuses an invalid expression (gronx/8).
+func TestHegelAddedTagsAreValidated(t *testing.T) {
+	judged(t, regionOf("gronx/8", tagsExpected, invalidTagCases), func(j *hzCaseJudge, c tagsCase) {
+		nextTagName(&c)
+		judgeBy(j, &c, tagsExpected, tagsActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/9
+
+// fallBackZones is the zones whose time.Date picks the later reading of a repeated wall
+// clock (a positive UTC offset: Europe/London, Europe/Berlin, Australia/Lord_Howe; in
+// America/New_York it picks the earlier one and bump's guard then gives the right tick, so
+// the bug does not show there) as indexes into dstZones.
+var fallBackZones = evenHalves(4, 1, 2)
+
+// minuteExprs is an expression with ticks every few minutes: "*/15", "*/5", "*/10", "*/20",
+// "*/30" or "0" as the minute, the rest "*".
+var minuteExprs = hegel.Map(evenHalves(
+	item{kind: "starstep", step: 15, text: "*/15", valid: true},
+	item{kind: "starstep", step: 5, text: "*/5", valid: true},
+	item{kind: "starstep", step: 10, text: "*/10", valid: true},
+	item{kind: "starstep", step: 20, text: "*/20", valid: true},
+	item{kind: "starstep", step: 30, text: "*/30", valid: true},
+	numItem(0),
+), func(it item) exprSpec {
+	return plainSpec(modeValid, form5, [7]segSpec{pMin: {items: []item{it}}, pHour: starSeg, pDom: starSeg, pMon: starSeg, pDow: starSeg})
+})
+
+// fallBacks is the transitions of the year where the clocks go back, with the length of the
+// repeated period in minutes.
+func fallBacks(loc *time.Location, y int) ([]time.Time, []int) {
+	var out []time.Time
+	var repeat []int
+	for _, tr := range transitionsOf(loc, y) {
+		_, before := tr.Add(-time.Second).Zone()
+		_, after := tr.Zone()
+		if after < before {
+			out = append(out, tr)
+			repeat = append(repeat, (before-after)/60)
+		}
+	}
+	return out, repeat
+}
+
+// fallBackCases is such an expression at a reference inside the first reading of a repeated
+// period (the shape: the search's time.Date lands on the second reading); under
+// HEGEL_NO_KNOWN=1 after the repeated period (1..180 minutes past its end: from inside the
+// second reading PrevTickBefore still crosses the fold, where the minute bump cycles in
+// Lord Howe's half hour). A year without a fall-back is filtered out by regionOf.
+var fallBackCases = hegel.FlatMap(minuteExprs, func(s exprSpec) hegel.Generator[dstCase] {
+	return hegel.FlatMap(fallBackZones, func(z int) hegel.Generator[dstCase] {
+		return hegel.FlatMap(hzInts(1995, 2090), func(y int) hegel.Generator[dstCase] {
+			trans, repeat := fallBacks(dstZones[z], y)
+			if len(trans) == 0 {
+				c := dstCase{spec: s, zone: z, e: s.build(), ref: time.Date(y, 7, 1, 12, 0, 0, 0, dstZones[z])}
+				c.instant.ref = c.ref
+				c.facts = dstFactsOf(c.e, c.ref)
+				return hegel.Just(c)
+			}
+			return hegel.FlatMap(rangeHalves(0, len(trans)-1), func(i int) hegel.Generator[dstCase] {
+				minutes := hzShaped[hegel.Generator[int]](hzInts(-repeat[i], -1), hzInts(repeat[i]+1, repeat[i]+180))
+				return hegel.FlatMap(minutes, func(m int) hegel.Generator[dstCase] {
+					return hegel.Map(hzInts(0, 59), func(sec int) dstCase {
+						c := dstCase{spec: s, zone: z, e: s.build()}
+						c.instant = dstInstant{near: true, moved: true, move: nearSpec{index: i, minutes: m, seconds: sec}}
+						c.ref = trans[i].Add(time.Duration(m)*time.Minute + time.Duration(sec)*time.Second)
+						c.instant.ref = c.ref
+						c.facts = dstFactsOf(c.e, c.ref)
+						return c
+					})
+				})
+			})
+		})
+	})
+})
+
+// TestHegelFallBackHoursKeepTheirTicks: from a reference in the first reading of a repeated
+// hour, NextTickAfter and PrevTickBefore give the ticks of that reading (gronx/9).
+func TestHegelFallBackHoursKeepTheirTicks(t *testing.T) {
+	judged(t, regionOf("gronx/9", dstExpected, fallBackCases), func(j *hzCaseJudge, c dstCase) {
+		judgeBy(j, &c, dstExpected, dstActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/10
+
+// gapDays is the days of the year in the zone that start after midnight (the clocks go
+// forward at midnight), as instants at their first wall clock.
+func gapDays(loc *time.Location, y int) []time.Time {
+	var out []time.Time
+	for _, tr := range transitionsOf(loc, y) {
+		yy, m, d := tr.Date()
+		if start := time.Date(yy, m, d, 0, 0, 0, 0, loc); start.Hour() != 0 || start.Minute() != 0 {
+			out = append(out, tr)
+		}
+	}
+	return out
+}
+
+// midnightGapCases is an expression due at a drawn minute of a day one to five days after a
+// day without midnight in America/Santiago, from a reference on the day before that day
+// (the shape: the day bump's time.Date never enters it); under HEGEL_NO_KNOWN=1 from a
+// reference on the day itself (after its first hour). A year without such a day is filtered
+// out by regionOf.
+var midnightGapCases = hegel.FlatMap(hzInts(1995, 2090), func(y int) hegel.Generator[dstCase] {
+	loc := dstZones[3]
+	gaps := gapDays(loc, y)
+	if len(gaps) == 0 {
+		// (2015: Chile stayed on summer time) a plain case, filtered out by regionOf
+		s := plainSpec(modeValid, form5, [7]segSpec{pMin: {items: []item{numItem(0)}}, pHour: {items: []item{numItem(12)}}, pDom: starSeg, pMon: starSeg, pDow: starSeg})
+		c := dstCase{spec: s, zone: 3, e: s.build(), ref: time.Date(y, 7, 1, 11, 0, 0, 0, loc)}
+		c.instant.ref = c.ref
+		c.facts = dstFactsOf(c.e, c.ref)
+		return hegel.Just(c)
+	}
+	return hegel.FlatMap(rangeHalves(0, len(gaps)-1), func(i int) hegel.Generator[dstCase] {
+		gap := gaps[i]
+		return hegel.FlatMap(hzInts(1, 5), func(after int) hegel.Generator[dstCase] {
+			return hegel.FlatMap(hzInts(0, 23), func(h int) hegel.Generator[dstCase] {
+				return hegel.FlatMap(hzInts(0, 59), func(mi int) hegel.Generator[dstCase] {
+					day := gap.Day() + after
+					if last := daysIn(gap.Year(), int(gap.Month())); day > last {
+						day = last
+					}
+					s := plainSpec(modeValid, form5, [7]segSpec{pMin: {items: []item{numItem(mi)}}, pHour: {items: []item{numItem(h)}}, pDom: {items: []item{numItem(day)}}, pMon: starSeg, pDow: starSeg})
+					refDay := hzShaped(-1, 0)
+					return hegel.FlatMap(hzShaped[hegel.Generator[int]](hzInts(0, 23), hzInts(1, 23)), func(rh int) hegel.Generator[dstCase] {
+						return hegel.FlatMap(hzInts(0, 59), func(rm int) hegel.Generator[dstCase] {
+							return hegel.Map(hzInts(0, 59), func(rs int) dstCase {
+								c := dstCase{spec: s, zone: 3, e: s.build()}
+								c.ref = time.Date(gap.Year(), gap.Month(), gap.Day()+refDay, rh, rm, rs, 0, loc)
+								c.instant = dstInstant{inst: instantSpec{y: c.ref.Year(), m: int(c.ref.Month()), d: c.ref.Day(), h: rh, mi: rm, s: rs}, ref: c.ref}
+								c.facts = dstFactsOf(c.e, c.ref)
+								return c
+							})
+						})
+					})
+				})
+			})
+		})
+	})
+})
+
+// TestHegelMidnightGapsAreCrossed: NextTickAfter crosses a day that starts after midnight
+// to a tick past it (gronx/10).
+func TestHegelMidnightGapsAreCrossed(t *testing.T) {
+	judged(t, regionOf("gronx/10", dstExpected, midnightGapCases), func(j *hzCaseJudge, c dstCase) {
+		judgeBy(j, &c, dstExpected, dstActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/11
+
+// singleTickCases is an expression restricted to one instant (every field a value, the
+// weekday "*") with the reference on it and excluded (the shape: no other tick exists, the
+// reference is returned); under HEGEL_NO_KNOWN=1 included (the reference is the answer).
+var singleTickCases = hegel.FlatMap(yearForms, func(form written) hegel.Generator[ticksCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[ticksCase] {
+		return hegel.Map(wholeInstant, func(i instantSpec) ticksCase {
+			if !form.present(pSec) {
+				i.s = 0 // the prepended second
+			}
+			ref := i.at(fixedZones[z])
+			y, m, d := ref.Date()
+			segs := [7]segSpec{
+				pSec:  {items: []item{numItem(ref.Second())}},
+				pMin:  {items: []item{numItem(ref.Minute())}},
+				pHour: {items: []item{numItem(ref.Hour())}},
+				pDom:  {items: []item{numItem(d)}},
+				pMon:  {items: []item{numItem(int(m))}},
+				pDow:  starSeg,
+				pYear: {items: []item{numItem(y)}},
+			}
+			s := plainSpec(modeValid, form, segs)
+			c := ticksCase{spec: s, zone: z, inst: i, incl: hzShaped(false, true), atDue: true}
+			c.e = s.build()
+			c.ref = ref
+			c.moved = true
+			c.facts = tickFactsOf(c.e, c.ref, c.incl)
+			return c
+		})
+	})
+})
+
+// TestHegelExcludedReferencesAreNotReturned: with the reference excluded, NextTickAfter and
+// PrevTickBefore on an expression with the reference as its only tick are errors, not the
+// reference (gronx/11).
+func TestHegelExcludedReferencesAreNotReturned(t *testing.T) {
+	judged(t, regionOf("gronx/11", ticksExpected, singleTickCases), func(j *hzCaseJudge, c ticksCase) {
+		judgeBy(j, &c, ticksExpected, ticksActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/12
+
+// extraItemAt is an item with extra "-" or "/" parts (the five texts evenly: "1-2-3",
+// "5/2/1", "1-2-3/1", "1-2/3/4", "*/2/3"); under HEGEL_NO_KNOWN=1 a valid item of the
+// position.
+func extraItemAt(pos int) hegel.Generator[item] {
+	return hzShaped[hegel.Generator[item]](hegel.Map(evenHalves(extraTexts...), badItem), validItemGen[pos])
+}
+
+// extraPartCases is an expression of a random form with such an item alone in one of its
+// segments (never the year of the six-with-year form, which a text without four digits
+// turns into a weekday), the other segments drawn valid (a year within six years of the
+// reference; the weekday "*" when the item is in the day-of-month, which the walk skips
+// under the union when the weekday is due), at a reference where those are due (the first
+// instant within six years the expression with "*" in its place is due, the drawn instant
+// when there is none): so that every walk reaches the item, and gronx/2 is not named first.
+// A case the walk does not reach the item at is filtered out by regionOf.
+var extraPartCases = hegel.FlatMap(formTable, func(form written) hegel.Generator[validityCase] {
+	positions := form.candidates(modeInvalid)
+	if form.yearForm {
+		positions = positions[:len(positions)-1]
+	}
+	return hegel.FlatMap(evenHalves(positions...), func(pos int) hegel.Generator[validityCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[validityCase] {
+			return hegel.FlatMap(wholeInstant, func(i instantSpec) hegel.Generator[validityCase] {
+				return hegel.FlatMap(extraItemAt(pos), func(it item) hegel.Generator[validityCase] {
+					return hegel.Composite(func(tc hegel.TestCase) validityCase {
+						ref := i.at(fixedZones[z])
+						var segs [7]segSpec
+						for p := 0; p < 7; p++ {
+							if !form.present(p) {
+								continue
+							}
+							switch {
+							case p == pos:
+								segs[p] = hegel.Draw(tc, itemsAt(it))
+							case p == pYear:
+								segs[p] = segSpec{items: []item{numItem(hegel.Draw(tc, hzInts(ref.Year(), ref.Year()+5)))}}
+							case p == pDow && pos == pDom:
+								segs[p] = hegel.Draw(tc, starAt(p))
+							default:
+								segs[p] = hegel.Draw(tc, segGen[segValid][p])
+							}
+						}
+						s := plainSpec(hzShaped(modeInvalid, modeValid), form, segs)
+						s.special = hzShaped(pos, -1)
+						rest := s
+						rest.segs[pos] = starSeg
+						if d, ok := rest.build().view(false).tickAfter(ref, true); ok && d.Year() <= ref.Year()+6 {
+							ref = d
+						}
+						return validityCase{spec: s, zone: z, inst: i, count: countNone, e: s.build(), ref: ref}
+					})
+				})
+			})
+		})
+	})
+})
+
+// TestHegelExtraItemPartsAreErrors: an item with more "-" or "/" parts than the grammar
+// allows is invalid and an error from IsDue wherever it stands (gronx/12).
+func TestHegelExtraItemPartsAreErrors(t *testing.T) {
+	judged(t, regionOf("gronx/12", validityExpected, extraPartCases), func(j *hzCaseJudge, c validityCase) {
+		judgeBy(j, &c, validityExpected, validityActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gronx/13
+
+// springForwards is the instants of the year where the zone's clocks go forward, to the
+// minute (transitionsOf finds them to the hour).
+func springForwards(loc *time.Location, y int) []time.Time {
+	var out []time.Time
+	for _, tr := range transitionsOf(loc, y) {
+		_, before := tr.Add(-time.Hour).Zone()
+		_, after := tr.Zone()
+		if after <= before {
+			continue
+		}
+		exact := tr
+		for x := tr.Add(-time.Hour); x.Before(tr); x = x.Add(time.Minute) {
+			if _, o := x.Zone(); o == after {
+				exact = x
+				break
+			}
+		}
+		out = append(out, exact)
+	}
+	return out
+}
+
+// halfHourExprs is an expression with hour 2 and ticks in its second half: the minute "*",
+// "*/10", "*/15", 30, 45 or "30-59", the rest "*" (five segments, or six with second 2).
+var halfHourExprs = hegel.FlatMap(evenHalves(
+	starSeg,
+	segSpec{items: []item{{kind: "starstep", step: 10, text: "*/10", valid: true}}},
+	segSpec{items: []item{{kind: "starstep", step: 15, text: "*/15", valid: true}}},
+	segSpec{items: []item{numItem(30)}},
+	segSpec{items: []item{numItem(45)}},
+	segSpec{items: []item{{kind: "range", a: 30, b: 59, text: "30-59", valid: true}}},
+), func(minute segSpec) hegel.Generator[exprSpec] {
+	return hegel.Map(evenHalves(form5, form6), func(form written) exprSpec {
+		segs := [7]segSpec{pMin: minute, pHour: {items: []item{numItem(2)}}, pDom: starSeg, pMon: starSeg, pDow: starSeg}
+		if form.count == 6 {
+			segs[pSec] = segSpec{items: []item{numItem(2)}}
+		}
+		return plainSpec(modeValid, form, segs)
+	})
+})
+
+// halfHourGapCases is such an expression in Australia/Lord_Howe at a reference in the half
+// hour before the year's spring-forward, 01:30 to 01:59 +10:30 (02:00 +10:30 becomes 02:30
+// +11: the shape, an hour after the reference is 03:00 to 03:29 +11, over the half hour of
+// hour 2 that exists; from 01:00 to 01:29 an hour later is 02:30 to 02:59 +11, hour 2, and
+// the search is right); under HEGEL_NO_KNOWN=1 at the same wall clock the day before. A
+// reference the search comes back right from is filtered out by regionOf.
+var halfHourGapCases = hegel.FlatMap(halfHourExprs, func(s exprSpec) hegel.Generator[dstCase] {
+	return hegel.FlatMap(hzInts(1995, 2090), func(y int) hegel.Generator[dstCase] {
+		trans := springForwards(dstZones[2], y)
+		if len(trans) == 0 {
+			c := dstCase{spec: s, zone: 2, e: s.build(), ref: time.Date(y, 7, 1, 12, 0, 0, 0, dstZones[2])}
+			c.instant.ref = c.ref
+			c.facts = dstFactsOf(c.e, c.ref)
+			return hegel.Just(c)
+		}
+		return hegel.FlatMap(rangeHalves(0, len(trans)-1), func(i int) hegel.Generator[dstCase] {
+			minutes := hzShaped[hegel.Generator[int]](hzInts(-30, -1), hzInts(-1470, -1441))
+			return hegel.FlatMap(minutes, func(m int) hegel.Generator[dstCase] {
+				return hegel.Map(hzInts(0, 59), func(sec int) dstCase {
+					c := dstCase{spec: s, zone: 2, e: s.build()}
+					c.instant = dstInstant{near: true, moved: true, move: nearSpec{index: i, minutes: m, seconds: sec}}
+					c.ref = trans[i].Add(time.Duration(m)*time.Minute + time.Duration(sec)*time.Second)
+					c.instant.ref = c.ref
+					c.facts = dstFactsOf(c.e, c.ref)
+					return c
+				})
+			})
+		})
+	})
+})
+
+// TestHegelHalfHourGapsKeepTheirTicks: across a spring-forward by half an hour the ticks in
+// the half hour that exists are returned (gronx/13).
+func TestHegelHalfHourGapsKeepTheirTicks(t *testing.T) {
+	judged(t, regionOf("gronx/13", dstExpected, halfHourGapCases), func(j *hzCaseJudge, c dstCase) {
+		judgeBy(j, &c, dstExpected, dstActual)
+	})
+}
