+// TestHegelSegmentsNormaliseAsDocumented: Segments gives the normalised six or seven segments
+// (a 0 second prepended to five segments and to six with a year, names replaced, whitespace
+// collapsed, tags expanded), and errors for other counts.
+func TestHegelSegmentsNormaliseAsDocumented(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		e := genExpr(ht, pick(ht, []string{"valid", "valid", "invalid", "tag"}))
+		if e.newline && Known.newlineInvalid {
+			col.count("newline-gated")
+			return
+		}
+		got, err := gronx.Segments(e.text)
+		if err != nil {
+			col.fail(ht, "Segments(%q) = %v", e.text, err)
+			return
+		}
+		want := strings.Split(e.normalised(), " ")
+		if e.tag != "" {
+			col.count("tag")
+		} else {
+			col.count(fmt.Sprintf("written-%d-year-%v", e.written, e.yearForm))
+		}
+		if strings.Join(got, "\x00") != strings.Join(want, "\x00") {
+			col.fail(ht, "Segments(%q) = %q; model %q", e.text, got, want)
+		}
+	})
+}
