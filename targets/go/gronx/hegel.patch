diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..33d108f
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,175 @@
+package gronx_test
+
+// The second oracle: croniter (Python), driven as one persistent child: a command and
+// hex-encoded arguments per line in, one JSON object per line out. Expressions cross in gronx's
+// own normalised form (seconds first, six or seven segments), which croniter reads with
+// second_at_beginning=True; instants cross as Unix seconds plus a fixed UTC offset in seconds.
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"sync"
+	"time"
+)
+
+const pythonScript = `
+import sys, json, warnings
+warnings.simplefilter("ignore")
+from datetime import datetime, timezone, timedelta
+from croniter import croniter
+
+def hx(s):
+    return bytes.fromhex(s)
+
+def tz(off):
+    return timezone(timedelta(seconds=int(off)))
+
+def at(u, off):
+    return datetime.fromtimestamp(int(u), tz(off))
+
+def handle(cmd, a):
+    expr = a[0].decode()
+    if cmd == "V":  # valid: expr
+        return {"valid": bool(croniter.is_valid(expr, second_at_beginning=True))}
+    base = at(a[1], a[2])
+    if cmd == "M":  # match: expr, unix, offset
+        return {"due": bool(croniter.match(expr, base, second_at_beginning=True))}
+    c = croniter(expr, base, second_at_beginning=True)
+    try:
+        r = c.get_next(datetime) if cmd == "N" else c.get_prev(datetime)
+        return {"time": int(r.timestamp())}
+    except Exception as e:
+        return {"none": True, "message": str(e)}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with croniter is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...[]byte) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString(a)
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("croniter oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("croniter oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("croniter oracle reply %q: %v", raw, err))
+	}
+}
+
+func s(x string) []byte { return []byte(x) }
+
+type validReply struct {
+	reply
+	Valid bool `json:"valid"`
+}
+
+type dueReply struct {
+	reply
+	Due bool `json:"due"`
+}
+
+type tickReply struct {
+	reply
+	Time int64 `json:"time"`
+	None bool  `json:"none"`
+}
+
+// offsetOf is the fixed UTC offset of t's zone at t, in seconds.
+func offsetOf(t time.Time) []byte {
+	_, off := t.Zone()
+	return s(strconv.Itoa(off))
+}
+
+func unixOf(t time.Time) []byte { return s(strconv.FormatInt(t.Unix(), 10)) }
+
+func croniterValid(expr string) validReply {
+	var r validReply
+	ask(&r, "V", s(expr))
+	return r
+}
+
+func croniterMatch(expr string, t time.Time) dueReply {
+	var r dueReply
+	ask(&r, "M", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
+
+// croniterNext and croniterPrev: the tick strictly after / before t; None when croniter finds
+// nothing (its search stops after fifty years).
+func croniterNext(expr string, t time.Time) tickReply {
+	var r tickReply
+	ask(&r, "N", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
+
+func croniterPrev(expr string, t time.Time) tickReply {
+	var r tickReply
+	ask(&r, "P", s(expr), unixOf(t), offsetOf(t))
+	return r
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..76b81d9
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,175 @@
+package gronx_test
+
+// One plain test per recorded bug (bugs.toml); each asserts the correct behaviour and fails
+// while the bug exists, so it is listed under [expected_failures] in target.toml.
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/adhocore/gronx"
+)
+
+// gronx/1
+func TestHegelPinBatchDueUsesTheDayUnion(t *testing.T) {
+	g := gronx.New()
+	monday := time.Date(2026, 3, 16, 0, 0, 0, 0, time.UTC) // a Monday that is not the 1st
+	due, err := g.IsDue("0 0 1 * 1", monday)
+	if err != nil || !due {
+		t.Fatalf("IsDue = %v, %v; the weekday matches", due, err)
+	}
+	b := g.BatchDue([]string{"0 0 1 * 1"}, monday)
+	if b[0].Err != nil || !b[0].Due {
+		t.Errorf("BatchDue = %v, %v; IsDue says due (day-of-month or weekday)", b[0].Due, b[0].Err)
+	}
+}
+
+// gronx/2
+func TestHegelPinValidityDoesNotDependOnTheTime(t *testing.T) {
+	today := fmt.Sprintf("0 0 * * %d,99", int(time.Now().Weekday()))
+	if gronx.IsValid(today) {
+		t.Errorf("IsValid(%q) = true; 99 is out of the weekday bounds (and false tomorrow)", today)
+	}
+	g := gronx.New()
+	monday := time.Date(2026, 3, 16, 0, 0, 0, 0, time.UTC)
+	if _, err := g.IsDue("0 0 * * 1,99", monday); err == nil {
+		t.Errorf("IsDue(\"0 0 * * 1,99\", a Monday) reports no error; on a Tuesday it does")
+	}
+	tuesday := monday.AddDate(0, 0, 1)
+	if _, err := g.IsDue("99 0 * * 1", tuesday); err == nil {
+		t.Errorf("IsDue(\"99 0 * * 1\", a Tuesday) reports no error; on a Monday it does")
+	}
+}
+
+// gronx/3
+func TestHegelPinImpossibleModifiersAreInvalid(t *testing.T) {
+	for _, expr := range []string{"0 0 * * 9#1", "0 0 * * 1#6", "0 0 32W * *", "0 0 0W * *", "0 0 * * 15L"} {
+		if gronx.IsValid(expr) {
+			t.Errorf("IsValid(%q) = true", expr)
+		}
+	}
+}
+
+// gronx/4
+func TestHegelPinTrailingNewlineIsWhitespace(t *testing.T) {
+	if gronx.IsValid("0 0 * * * ") != true {
+		t.Fatalf("a trailing space is trimmed")
+	}
+	if !gronx.IsValid("0 0 * * *\n") {
+		t.Errorf("IsValid(\"0 0 * * *\\n\") = false; whitespace is otherwise collapsed with \\s+")
+	}
+}
+
+// gronx/5
+func TestHegelPinTagsKeepTheirCase(t *testing.T) {
+	if err := gronx.AddTag("@PinTagCase", "1 2 * * *"); err != nil {
+		t.Fatalf("AddTag: %v", err)
+	}
+	if !gronx.IsValid("@PinTagCase") {
+		t.Errorf("IsValid(\"@PinTagCase\") = false right after AddTag registered it")
+	}
+}
+
+// gronx/6
+func TestHegelPinInclusiveNextTickIsTruncated(t *testing.T) {
+	ref := time.Date(2026, 3, 15, 0, 0, 0, 123456789, time.UTC)
+	want := ref.Truncate(time.Second)
+	prev, err := gronx.PrevTickBefore("0 0 * * *", ref, true)
+	if err != nil || !prev.Equal(want) {
+		t.Fatalf("PrevTickBefore = %v, %v; truncated", prev, err)
+	}
+	next, err := gronx.NextTickAfter("0 0 * * *", ref, true)
+	if err != nil || !next.Equal(want) {
+		t.Errorf("NextTickAfter(incl) = %v, %v; want %v (as PrevTickBefore gives)", next, err, want)
+	}
+}
+
+// gronx/7
+func TestHegelPinSteppedYearsAreReachable(t *testing.T) {
+	ref := time.Date(2026, 3, 15, 0, 0, 0, 0, time.UTC)
+	next, err := gronx.NextTickAfter("0 0 1 1 * 2000/5", ref, false)
+	want := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+	if err != nil || !next.Equal(want) {
+		t.Errorf("NextTickAfter(\"0 0 1 1 * 2000/5\") = %v, %v; want %v", next, err, want)
+	}
+}
+
+// gronx/8
+func TestHegelPinAddTagRefusesInvalidExpressions(t *testing.T) {
+	if err := gronx.AddTag("@pintagbad", "0 0 * * 99"); err == nil {
+		t.Errorf("AddTag(\"@pintagbad\", \"0 0 * * 99\") = nil; IsValid of the tag: %v", gronx.IsValid("@pintagbad"))
+	}
+}
+
+// gronx/9
+func TestHegelPinAutumnTransitionKeepsEveryTick(t *testing.T) {
+	london, err := time.LoadLocation("Europe/London")
+	if err != nil {
+		t.Skip(err)
+	}
+	ref := time.Date(2020, 10, 25, 0, 49, 19, 0, london) // BST; clocks go back at 02:00 BST
+	want := time.Date(2020, 10, 25, 0, 0, 0, 0, time.UTC) // 01:00 BST
+	got, err := gronx.NextTickAfter("*/15 * * * *", ref, false)
+	if err != nil || !got.Equal(want) {
+		t.Errorf("NextTickAfter(@15minutes, %v) = %v, %v; want %v (01:00 BST)", ref, got, err, want.In(london))
+	}
+}
+
+// gronx/10
+func TestHegelPinMidnightGapIsCrossed(t *testing.T) {
+	santiago, err := time.LoadLocation("America/Santiago")
+	if err != nil {
+		t.Skip(err)
+	}
+	ref := time.Date(2021, 9, 4, 22, 21, 4, 0, santiago) // Saturday; Sunday starts at 01:00
+	got, err := gronx.NextTickAfter("* * 3 * 7", ref, false)
+	if err != nil {
+		t.Fatalf("NextTickAfter(\"* * 3 * 7\", %v) = %v", ref, err)
+	}
+	if !got.After(ref) || got.Weekday() != time.Sunday {
+		t.Errorf("NextTickAfter = %v; want the first second of Sunday", got)
+	}
+}
+
+// gronx/11
+func TestHegelPinTicksExcludeTheReference(t *testing.T) {
+	ref := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC) // the only tick of the expression
+	if due, err := gronx.New().IsDue("0 0 1 1 * 2026", ref); err != nil || !due {
+		t.Fatalf("IsDue = %v, %v", due, err)
+	}
+	if next, err := gronx.NextTickAfter("0 0 1 1 * 2026", ref, false); err == nil {
+		t.Errorf("NextTickAfter(excluding the reference) = %v, nil; want an error (no later tick)", next)
+	}
+	if prev, err := gronx.PrevTickBefore("0 0 1 1 * 2026", ref, false); err == nil {
+		t.Errorf("PrevTickBefore(excluding the reference) = %v, nil; want an error (no earlier tick)", prev)
+	}
+}
+
+// gronx/12
+func TestHegelPinExtraItemPartsAreRefused(t *testing.T) {
+	if gronx.IsValid("1-2-3 * * * *") {
+		t.Errorf("IsValid(\"1-2-3 * * * *\") = true; a range has two parts (gronx reads 1-2 and ignores the 3)")
+	}
+	ref := time.Date(2026, 3, 16, 0, 0, 0, 0, time.UTC)
+	if due, err := gronx.New().IsDue("5/2/1 * * * *", ref); err == nil {
+		t.Errorf("IsDue(\"5/2/1 * * * *\", %v) = %v, nil; want an error (a step has two parts; gronx reads 5/2)", ref, due)
+	}
+}
+
+// gronx/13
+func TestHegelPinHalfHourGapKeepsItsTicks(t *testing.T) {
+	lordHowe, err := time.LoadLocation("Australia/Lord_Howe")
+	if err != nil {
+		t.Skip(err)
+	}
+	ref := time.Date(2029, 10, 7, 1, 35, 47, 0, lordHowe) // +10:30; at 02:00 the clocks go to 02:30 +11
+	want := time.Date(2029, 10, 7, 2, 30, 2, 0, lordHowe) // the first second 2 of hour 2, which starts at 02:30 +11
+	if due, err := gronx.New().IsDue("2 * 2 * * *", want); err != nil || !due {
+		t.Fatalf("IsDue(\"2 * 2 * * *\", %v) = %v, %v", want, due, err)
+	}
+	got, err := gronx.NextTickAfter("2 * 2 * * *", ref, false)
+	if err != nil || !got.Equal(want) {
+		t.Errorf("NextTickAfter(\"2 * 2 * * *\", %v) = %v, %v; want %v (the half hour 02:30-02:59 +11 exists)", ref, got, err, want)
+	}
+}
diff --git a/hegel_zoo_cases_test.go b/hegel_zoo_cases_test.go
new file mode 100644
index 0000000..50f1b55
--- /dev/null
+++ b/hegel_zoo_cases_test.go
@@ -0,0 +1,1441 @@
+package gronx_test
+
+// The case records of the properties, their generators and their pure builders.
+//
+// Every property draws a record of plain values (the alternatives chosen, the numbers drawn,
+// the coins) and builds its case from it with no further draw: the expression from an
+// exprSpec (the written form, the segments as lists of items, the special segment that
+// carries the invalid or nonsense item, the separators, the case coins of the names, the
+// newline), the reference instant from an instantSpec (the fields and the specials: a month's
+// end, the first of a winter month, the edge hours, the fraction), and for the DST property
+// the transition the instant is moved near. The generators are package-level values from
+// the idioms (hzDie, hzChance, the die* and halving helpers), every choice at the share the
+// old generator gave it, with the realised figure beside the weight (the probe of the
+// rewrite: 3000 cases per property, the mean of HEGEL_SEED=7 and 8; the engine's 1-bit
+// choices realise up to five points off their nominal share depending on the draws around
+// them and the seed, so a figure within that is left as it is); the simplest alternative
+// comes first (the shrink target). The draws per case of that probe (hegel.Integers calls,
+// mean / max): validity 173 / 423, segments 125 / 360, due 175 / 468, ticks 168 / 479,
+// DST 159 / 426, batch 452 / 1342, tags 197 / 564; the narrow properties of gronx/1 to
+// gronx/11: 158 / 459, 63 / 142, 43 / 105, 144 / 383, 191 / 442, 164 / 404, 156 / 395,
+// 96 / 192, 17 / 51, 7 / 7, 34 / 88. The population is the old generator's (the same strings,
+// the same chances and counts) plus the additions of the standard: the due and tick
+// properties draw the nonsense mode at the validity property's share and the due property
+// the invalid mode at one in ten; the tag property draws no newline (the old property
+// returned on one).
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+var yearRe = regexp.MustCompile(`\d{4}`)
+
+// --------------------------------------------------------------------------- items
+
+// valueBounds is the range a plain value is drawn from at the position (years 1990..2100).
+func valueBounds(pos int) (int, int) {
+	if pos == pYear {
+		return 1990, 2100
+	}
+	return bounds[pos][0], bounds[pos][1]
+}
+
+// spell is the value as the expression writes it: its name when named (months; weekdays
+// 0..6), else the number.
+func spell(pos, v int, named bool) string {
+	if named && pos == pMon {
+		return monthNames[v-1]
+	}
+	if named && pos == pDow && v <= 6 {
+		return dayNames[v]
+	}
+	return strconv.Itoa(v)
+}
+
+// nameCoin is the coin that spells a value by its name: 30 percent where the field has one
+// (measured 30.4: 1073 of 3534 values with a name, seed 7), draw-free elsewhere.
+func nameCoin(pos, v int) hegel.Generator[bool] {
+	if pos == pMon || (pos == pDow && v <= 6) {
+		return dieCoin(30)
+	}
+	return hegel.Just(false)
+}
+
+// numAt is a plain value at the position.
+func numAt(pos int) hegel.Generator[item] {
+	lo, hi := valueBounds(pos)
+	return hegel.FlatMap(hzInts(lo, hi), func(v int) hegel.Generator[item] {
+		return hegel.Map(nameCoin(pos, v), func(named bool) item {
+			return item{kind: "num", a: v, text: spell(pos, v, named), valid: true}
+		})
+	})
+}
+
+// rangeAt is "a-b" with a <= b; in the weekday segment, 15 percent of the time (measured
+// 14.6: 140 of 960 weekday ranges, seed 7), a range through 7: "7-x" (Sunday to x) or "x-7" (x to Sunday after Saturday), each
+// half the time.
+func rangeAt(pos int) hegel.Generator[item] {
+	lo, hi := valueBounds(pos)
+	plain := hegel.FlatMap(hzInts(lo, hi), func(a int) hegel.Generator[[]int] {
+		return hegel.Map(hzInts(a, hi), func(b int) []int { return []int{a, b} })
+	})
+	ends := plain
+	if pos == pDow {
+		seven := hegel.FlatMap(dieCoin(50), func(from bool) hegel.Generator[[]int] {
+			if from {
+				return hegel.Map(hzInts(0, 7), func(b int) []int { return []int{7, b} })
+			}
+			return hegel.Map(hzInts(0, 7), func(a int) []int { return []int{a, 7} })
+		})
+		ends = dieChoice(hzW(85, plain), hzW(15, seven))
+	}
+	return hegel.FlatMap(ends, func(ab []int) hegel.Generator[item] {
+		return hegel.FlatMap(nameCoin(pos, ab[0]), func(na bool) hegel.Generator[item] {
+			return hegel.Map(nameCoin(pos, ab[1]), func(nb bool) item {
+				return item{kind: "range", a: ab[0], b: ab[1], text: spell(pos, ab[0], na) + "-" + spell(pos, ab[1], nb), valid: true}
+			})
+		})
+	})
+}
+
+// stepAt is a step: any of the field's width 70 percent of the time, one of the common
+// steps 30 (the common set holds 60.4 of the steps drawn in the validity property, the
+// any-width draws that land in it included: 1896 of 3140).
+func stepAt(pos int) hegel.Generator[int] {
+	lo, hi := bounds[pos][0], bounds[pos][1]
+	return dieChoice(hzW(70, hzInts(1, hi-lo+1)), hzW(30, evenHalves(1, 2, 3, 5, 10, 15)))
+}
+
+// starStepAt is "*/s".
+func starStepAt(pos int) hegel.Generator[item] {
+	return hegel.Map(stepAt(pos), func(st int) item {
+		return item{kind: "starstep", step: st, text: "*/" + strconv.Itoa(st), valid: true}
+	})
+}
+
+// numStepAt is "a/s"; in the day-of-month and month segments a is 0 15 percent of the time
+// (measured 18.8 on the day-of-month, 41 of 218 at seed 7: gronx takes "0/s" below the
+// lower bound of those fields).
+func numStepAt(pos int) hegel.Generator[item] {
+	lo, hi := valueBounds(pos)
+	start := hzInts(lo, hi)
+	if pos == pDom || pos == pMon {
+		start = dieChoice(hzW(85, hzInts(lo, hi)), hzW(15, hegel.Just(0)))
+	}
+	return hegel.FlatMap(start, func(a int) hegel.Generator[item] {
+		return hegel.Map(hzInts(1, bounds[pos][1]-bounds[pos][0]+1), func(st int) item {
+			return item{kind: "numstep", a: a, step: st, text: fmt.Sprintf("%d/%d", a, st), valid: true}
+		})
+	})
+}
+
+// rangeStepAt is "a-b/s".
+func rangeStepAt(pos int) hegel.Generator[item] {
+	lo, hi := valueBounds(pos)
+	return hegel.FlatMap(hzInts(lo, hi), func(a int) hegel.Generator[item] {
+		return hegel.FlatMap(hzInts(a, hi), func(b int) hegel.Generator[item] {
+			return hegel.Map(hzInts(1, bounds[pos][1]-bounds[pos][0]+1), func(st int) item {
+				return item{kind: "rangestep", a: a, b: b, step: st, text: fmt.Sprintf("%d-%d/%d", a, b, st), valid: true}
+			})
+		})
+	})
+}
+
+// modAt is a modifier where it belongs: "L" (40 percent, measured 42.6 of L and W in the
+// valid mode) or "nW" in the day-of-month, "nL" (50 percent, measured 48.0: 274 to 297 at
+// seed 7) or "n#k" in the weekday; a plain value elsewhere.
+func modAt(pos int) hegel.Generator[item] {
+	switch pos {
+	case pDom:
+		return dieChoice(
+			hzW(40, hegel.Just(item{kind: "L", text: "L", valid: true})),
+			hzW(60, hegel.Map(hzInts(1, 31), func(a int) item {
+				return item{kind: "W", a: a, text: fmt.Sprintf("%dW", a), valid: true}
+			})),
+		)
+	case pDow:
+		return dieChoice(
+			hzW(50, hegel.Map(hzInts(0, 7), func(a int) item {
+				return item{kind: "dowL", a: a, text: fmt.Sprintf("%dL", a), valid: true}
+			})),
+			hzW(50, hegel.FlatMap(hzInts(0, 7), func(a int) hegel.Generator[item] {
+				return hegel.Map(hzInts(1, 5), func(k int) item {
+					return item{kind: "hash", a: a, b: k, text: fmt.Sprintf("%d#%d", a, k), valid: true}
+				})
+			})),
+		)
+	}
+	return numAt(pos)
+}
+
+// validItemAt is one alternative of a segment the grammar accepts: a plain value 35 percent,
+// a range 20, "*/s" 13, "a/s" 10, "a-b/s" 8, a modifier 14 (measured on the minute segment,
+// where the modifier is a plain value, the invalid mode's items set aside: 51.4, 19.1, 12.6,
+// 9.3, 7.5; on the day-of-month L 5.0 and W 16.5 of the items, the nonsense mode's "nW"
+// included).
+func validItemAt(pos int) hegel.Generator[item] {
+	return halvesGens([]int{35, 20, 13, 10, 8, 14},
+		numAt(pos), rangeAt(pos), starStepAt(pos), numStepAt(pos), rangeStepAt(pos), modAt(pos))
+}
+
+func badItem(text string) item { return item{kind: "bad", text: text} }
+
+// The fixed texts of the invalid alternatives (the old generator's tables, in its order).
+// The malformed texts: the old generator's ten, of which "1-2-3" and "5/2/1" have extra
+// parts gronx ignores (gronx/12), plus three more of that shape ("1-2-3/1", "1-2/3/4",
+// "*/2/3"): the form keeps its tenth of the invalid items, each text one thirteenth of the
+// form (one tenth before) and the five extra-part texts at weight zero under HEGEL_NO_KNOWN=1
+// (the eight others then one eighth each).
+var (
+	extraTexts = []string{"1-2-3", "5/2/1", "1-2-3/1", "1-2/3/4", "*/2/3"}
+	plainTexts = []string{"x", "1-", "-1", "/2", "1/", "1--2", "**", "*a"}
+	badTexts   = halvesOver([]int{2, 2, 2, 2, 2, 2, hzUnless(hzNoKnown, 2), 2, 2, hzUnless(hzNoKnown, 2),
+		hzUnless(hzNoKnown, 2), hzUnless(hzNoKnown, 2), hzUnless(hzNoKnown, 2)},
+		"x", "1-", "-1", "/2", "1/", "1--2", "1-2-3", "**", "*a", "5/2/1", "1-2-3/1", "1-2/3/4", "*/2/3")
+	badModsDow  = []string{"L", "#1", "1#", "LW", "W"}
+	badModsDom  = []string{"LW", "W", "1#2", "1L", "L1"}
+	badModsRest = []string{"L", "5W", "1#2", "5L"}
+	badNames    = []string{"SUNDAY", "JANUARY", "MONDAY", "sept", "Tues"}
+)
+
+// badItemAt is one alternative the grammar rejects, ten forms at one weight each (the old
+// generator's ten cases; measured 7.5 to 11.8 each, in this order: 9.8, 11.1, 11.8, 7.5,
+// 11.1, 8.9, 10.0, 10.7, 10.1, 8.9): a value past the upper bound, a range
+// past it, "*/0" or a negative step, a malformed text, a modifier where it does not belong
+// (or a malformed one where it does), a reversed range, a zero step from a value, a name
+// that is not one, a reversed stepped range, and a value below the lower bound in a pair.
+func badItemAt(pos int) hegel.Generator[item] {
+	return evenGens(badItemForms(pos, badTexts)...)
+}
+
+// strictBadItemAt is badItemAt without the extra-part texts (the narrow property of gronx/2
+// must not draw gronx/12's shape).
+func strictBadItemAt(pos int) hegel.Generator[item] {
+	return evenGens(badItemForms(pos, evenHalves(plainTexts...))...)
+}
+
+// badItemForms is the ten forms, the malformed texts drawn from the given table.
+func badItemForms(pos int, texts hegel.Generator[string]) []hegel.Generator[item] {
+	lo, hi := valueBounds(pos)
+	blo, bhi := bounds[pos][0], bounds[pos][1]
+	mods := badModsRest
+	switch pos {
+	case pDow:
+		mods = badModsDow
+	case pDom:
+		mods = badModsDom
+	}
+	revLo, revHi := lo+1, hi
+	if pos == pDow {
+		// a leading 7 in the weekday segment is Sunday, so a reversed range keeps a > 7 out
+		revLo, revHi = 1, 6
+	}
+	reversed := hegel.FlatMap(hzInts(revLo, revHi), func(a int) hegel.Generator[[]int] {
+		return hegel.Map(hzInts(lo, a-1), func(b int) []int { return []int{a, b} })
+	})
+	return []hegel.Generator[item]{
+		hegel.Map(hzInts(1, 40), func(v int) item { return badItem(strconv.Itoa(bhi + v)) }),
+		hegel.FlatMap(hzInts(1, 5), func(a int) hegel.Generator[item] {
+			return hegel.Map(hzInts(6, 9), func(b int) item { return badItem(fmt.Sprintf("%d-%d", bhi+a, bhi+b)) })
+		}),
+		hegel.Map(hzInts(0, 3), func(s int) item { return badItem(fmt.Sprintf("*/%d", -s)) }),
+		hegel.Map(texts, badItem),
+		hegel.Map(evenHalves(mods...), badItem),
+		hegel.Map(reversed, func(ab []int) item { return badItem(fmt.Sprintf("%d-%d", ab[0], ab[1])) }),
+		hegel.Map(hzInts(lo, hi), func(v int) item { return badItem(fmt.Sprintf("%d/0", v)) }),
+		hegel.Map(evenHalves(badNames...), badItem),
+		hegel.FlatMap(reversed, func(ab []int) hegel.Generator[item] {
+			return hegel.Map(hzInts(1, 5), func(s int) item { return badItem(fmt.Sprintf("%d-%d/%d", ab[0], ab[1], s)) })
+		}),
+		hegel.FlatMap(hzInts(0, 3), func(k int) hegel.Generator[item] {
+			return hegel.Map(hzInts(lo, hi), func(v int) item { return badItem(fmt.Sprintf("%d,%d", blo-1-k, v)) })
+		}),
+	}
+}
+
+// nonsenseItemAt is one impossible modifier gronx accepts (gronx/3): in the day-of-month
+// "nW" with n 0, past 31 or negative; in the weekday, half the time "nL" with n past 7
+// (measured 58.2 of the weekday's nonsense: 275 "nL" to 198 "n#k" in the validity property),
+// else "n#k" with n past 7 or negative (half) or k outside 1..5.
+func nonsenseItemAt(pos int) hegel.Generator[item] {
+	if pos == pDom {
+		return hegel.Map(evenHalves(0, 32, 33, 40, -1, -5), func(v int) item {
+			return item{kind: "W", a: v, text: fmt.Sprintf("%dW", v), valid: true, nonsense: true}
+		})
+	}
+	hash := hegel.FlatMap(hzInts(0, 7), func(a int) hegel.Generator[item] {
+		return hegel.FlatMap(hzInts(1, 5), func(k int) hegel.Generator[item] {
+			return hegel.FlatMap(dieCoin(50), func(badDay bool) hegel.Generator[item] {
+				if badDay {
+					return hegel.Map(evenHalves(8, 9, 12, -1), func(a int) item {
+						return item{kind: "hash", a: a, b: k, text: fmt.Sprintf("%d#%d", a, k), valid: true, nonsense: true}
+					})
+				}
+				return hegel.Map(evenHalves(0, 6, 7, 9, -1), func(k int) item {
+					return item{kind: "hash", a: a, b: k, text: fmt.Sprintf("%d#%d", a, k), valid: true, nonsense: true}
+				})
+			})
+		})
+	})
+	return dieChoice(
+		hzW(50, hegel.Map(evenHalves(8, 9, 15, 100), func(v int) item {
+			return item{kind: "dowL", a: v, text: fmt.Sprintf("%dL", v), valid: true, nonsense: true}
+		})),
+		hzW(50, hash),
+	)
+}
+
+// --------------------------------------------------------------------------- segments
+
+// segSpec is a drawn segment: "*" or "?", or a list of items; and the case coins of the
+// letters of its text (a coin per upper-case letter: lowered when true).
+type segSpec struct {
+	star  string // "*", "?" or "" for a list
+	items []item
+	lower []bool
+}
+
+func (s segSpec) text() string {
+	if s.star != "" {
+		return s.star
+	}
+	parts := make([]string, len(s.items))
+	for i, it := range s.items {
+		parts[i] = it.text
+	}
+	return strings.Join(parts, ",")
+}
+
+// cased is the text with the case coins applied (gronx upper-cases the expression).
+func (s segSpec) cased() string { return applyCase(s.text(), s.lower) }
+
+// applyCase lowers the upper-case letters of the text whose coin is true.
+func applyCase(text string, lower []bool) string {
+	var b strings.Builder
+	i := 0
+	for _, r := range text {
+		if r >= 'A' && r <= 'Z' {
+			if i < len(lower) && lower[i] {
+				r += 32
+			}
+			i++
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// upperLetters counts the letters the case coins apply to.
+func upperLetters(s string) int {
+	n := 0
+	for _, r := range s {
+		if r >= 'A' && r <= 'Z' {
+			n++
+		}
+	}
+	return n
+}
+
+// lowerCoins is the case coins of a text: one per upper-case letter, true 40 percent of the
+// time (measured 41.0: 3711 lowered to 5343 kept).
+func lowerCoins(s string) hegel.Generator[[]bool] {
+	n := upperLetters(s)
+	return hzCounted(dieCoin(40), n, n)
+}
+
+// The modes of a segment: every item valid; one item the grammar rejects; one impossible
+// modifier; one item the grammar rejects, alone (the lone invalid item of HEGEL_NO_KNOWN=1's
+// invalid population, which every walk reaches); the same without gronx/12's extra-part
+// texts (the narrow property of gronx/8).
+const (
+	segValid = iota
+	segInvalid
+	segNonsense
+	segInvalidAlone
+	segInvalidStrict
+)
+
+// itemCount is the number of items of a listed segment: one 70 percent of the time
+// (measured 64 to 71 by position in the valid mode, the weekday lowest), else two to four
+// evenly.
+var itemCount = dieChoice(hzW(70, hegel.Just(1)), hzW(30, rangeHalves(2, 4)))
+
+// starAt is the segment that takes part in no check: "*", or "?" in the day segments a
+// quarter of the time (measured 24.2 on the day-of-month, 23.9 on the weekday).
+func starAt(pos int) hegel.Generator[segSpec] {
+	if pos == pDom || pos == pDow {
+		return dieChoice(hzW(75, hegel.Just(segSpec{star: "*"})), hzW(25, hegel.Just(segSpec{star: "?"})))
+	}
+	return hegel.Just(segSpec{star: "*"})
+}
+
+// listAt is a listed segment of the mode: the items (as many as count says), the special one
+// (the invalid or the nonsense item) at a drawn index, and the case coins of the text.
+func listAt(pos, mode int, count hegel.Generator[int]) hegel.Generator[segSpec] {
+	return hegel.FlatMap(count, func(k int) hegel.Generator[segSpec] {
+		at := hegel.Just(-1)
+		if mode != segValid {
+			at = hzInts(0, k-1)
+		}
+		return hegel.FlatMap(at, func(special int) hegel.Generator[segSpec] {
+			return withCoins(hegel.Composite(func(tc hegel.TestCase) segSpec {
+				items := make([]item, k)
+				for i := range items {
+					g := validItemGen[pos]
+					if i == special && (mode == segInvalid || mode == segInvalidAlone) {
+						g = badItemGen[pos]
+					}
+					if i == special && mode == segInvalidStrict {
+						g = strictBadItemGen[pos]
+					}
+					if i == special && mode == segNonsense {
+						g = nonsenseItemGen[pos]
+					}
+					items[i] = hegel.Draw(tc, g)
+				}
+				return segSpec{items: items}
+			}))
+		})
+	})
+}
+
+// withCoins adds the case coins of the segment's text.
+func withCoins(g hegel.Generator[segSpec]) hegel.Generator[segSpec] {
+	return hegel.FlatMap(g, func(s segSpec) hegel.Generator[segSpec] {
+		return hegel.Map(lowerCoins(s.text()), func(lower []bool) segSpec {
+			s.lower = lower
+			return s
+		})
+	})
+}
+
+// itemsAt is a listed segment of the given items (the narrow properties' constructions),
+// with the case coins.
+func itemsAt(items ...item) hegel.Generator[segSpec] {
+	return withCoins(hegel.Just(segSpec{items: items}))
+}
+
+// segAt is a segment of the mode: a valid one is "*" or "?" 45 percent of the time, else a
+// list (measured in the valid mode, by position, seconds to weekday: 48.9, 49.8, 40.3, 45.2,
+// 43.9, 45.4; the year of a seven-segment form realised 38 at the weight 45, so its weight
+// is 52: measured 47.9).
+func segAt(pos, mode int) hegel.Generator[segSpec] {
+	switch mode {
+	case segInvalidAlone, segInvalidStrict:
+		return listAt(pos, mode, hegel.Just(1))
+	case segInvalid, segNonsense:
+		return listAt(pos, mode, itemCount)
+	}
+	star := 45
+	if pos == pYear {
+		star = 52
+	}
+	return dieChoice(hzW(star, starAt(pos)), hzW(100-star, listAt(pos, segValid, itemCount)))
+}
+
+// The generators by position and mode (nonsense only in the day segments).
+var (
+	validItemGen, badItemGen, strictBadItemGen, nonsenseItemGen [7]hegel.Generator[item]
+	segGen                                                      [5][7]hegel.Generator[segSpec]
+)
+
+func init() {
+	for pos := 0; pos < 7; pos++ {
+		validItemGen[pos] = validItemAt(pos)
+		badItemGen[pos] = badItemAt(pos)
+		strictBadItemGen[pos] = strictBadItemAt(pos)
+		if pos == pDom || pos == pDow {
+			nonsenseItemGen[pos] = nonsenseItemAt(pos)
+		}
+		segGen[segValid][pos] = segAt(pos, segValid)
+		segGen[segInvalid][pos] = segAt(pos, segInvalid)
+		segGen[segInvalidAlone][pos] = segAt(pos, segInvalidAlone)
+		segGen[segInvalidStrict][pos] = segAt(pos, segInvalidStrict)
+		if pos == pDom || pos == pDow {
+			segGen[segNonsense][pos] = segAt(pos, segNonsense)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- expressions
+
+// The modes of an expression: every item valid; one item the grammar rejects; one
+// impossible modifier gronx accepts; a built-in tag.
+const (
+	modeValid    = "valid"
+	modeInvalid  = "invalid"
+	modeNonsense = "nonsense"
+	modeTag      = "tag"
+)
+
+// written is the form of the text: five segments; six without a year (seconds first); six
+// with a year; seven. The old generator drew 5, 5, 5, 6, 6, 7 and read a six as a year 40
+// percent of the time: 50, 20, 13.3 and 16.7 percent (measured 47.9, 20.7, 14.3, 17.0 of
+// the expressions that are not tags).
+type written struct {
+	count    int
+	yearForm bool
+}
+
+var (
+	form5  = written{count: 5}
+	form6  = written{count: 6}
+	form6y = written{count: 6, yearForm: true}
+	form7  = written{count: 7}
+
+	formTable = halvesOver([]int{15, 6, 4, 5}, form5, form6, form6y, form7)
+	// the DST property's forms: the year-restricted expressions out (the old property skipped
+	// them; a seven-segment form keeps its "*" year), so the six-with-year form is out and the
+	// seven-segment form keeps its 45 percent of a star year: 60, 24, 0, 9 (measured 65.4,
+	// 24.7, 0, 10.0)
+	dstFormTable = halvesOver([]int{60, 24, 0, 9}, form5, form6, form6y, form7)
+)
+
+func (w written) present(pos int) bool {
+	switch pos {
+	case pSec:
+		return w.count == 7 || (w.count == 6 && !w.yearForm)
+	case pYear:
+		return w.count == 7 || w.yearForm
+	}
+	return true
+}
+
+// exprSpec is a drawn expression: the mode, the form, the segments, the special segment
+// (the one carrying the invalid or nonsense item, -1 for none), the separators and the
+// blanks, the newline; or the built-in tag with the case coins of its name.
+type exprSpec struct {
+	mode     string
+	form     written
+	special  int
+	segs     [7]segSpec
+	sep      string
+	lead     string
+	trail    string
+	newline  bool
+	tag      int    // the index into tagTable (mode tag)
+	tagLower []bool // the case coins of the tag's name
+}
+
+// The separators and blanks: a single space 70 percent of the time (measured 70.2), a tab,
+// two spaces or " \t " 10 each (10.5, 9.9, 9.4); a leading blank 15 percent of the time
+// (measured 16.5), a trailing one 15 (16.7), each one of three.
+var (
+	sepTable   = dieTree([]int{7, 1, 1, 1}, " ", "\t", "  ", " \t ")
+	leadTable  = dieMaybe(15, evenHalves(" ", "\t", "  \t"))
+	trailTable = dieMaybe(15, evenHalves(" ", "\t", " \t"))
+)
+
+// candidates is the segments that may carry the special item: the present ones, the day
+// segments alone for the nonsense mode.
+func (w written) candidates(mode string) []int {
+	var out []int
+	for pos := 0; pos < 7; pos++ {
+		if !w.present(pos) {
+			continue
+		}
+		if mode == modeNonsense && pos != pDom && pos != pDow {
+			continue
+		}
+		out = append(out, pos)
+	}
+	return out
+}
+
+// exprDraw says how a property draws its expressions: the modes (a table at weights), the
+// forms, the newline percentage, whether a present year segment is forced to "*" (the DST
+// property), and the lone-item form of the invalid mode (HEGEL_NO_KNOWN=1): the invalid item
+// alone in its segment, every other segment "*" (or "?"), at the segment aloneAt (-1: any
+// present one) in the forms aloneForms.
+type exprDraw struct {
+	modes      hegel.Generator[string]
+	forms      hegel.Generator[written]
+	newlinePct int
+	yearStar   bool
+	alone      bool
+	aloneAt    int
+	aloneForms hegel.Generator[written]
+	// strict: the lone invalid item is drawn without gronx/12's extra-part texts
+	strict bool
+}
+
+// builtExpr draws an expression of the mode and form: the special segment evenly among the
+// candidates, each present segment in its mode, a six-with-year form's sixth segment made a
+// year when it does not look like one (four digits), a weekday segment with four digits in
+// the six-without-year form made "*" (it would be read as a year); then the separators.
+func (d exprDraw) builtExpr(mode string, form written) hegel.Generator[exprSpec] {
+	alone := d.alone && mode == modeInvalid
+	cands := form.candidates(mode)
+	if alone && d.aloneAt >= 0 {
+		cands = []int{d.aloneAt}
+	}
+	special := hegel.Just(-1)
+	if mode == modeInvalid || mode == modeNonsense {
+		special = evenHalves(cands...)
+	}
+	return hegel.FlatMap(special, func(sp int) hegel.Generator[exprSpec] {
+		return hegel.Composite(func(tc hegel.TestCase) exprSpec {
+			e := exprSpec{mode: mode, form: form, special: sp}
+			for pos := 0; pos < 7; pos++ {
+				if !form.present(pos) {
+					continue
+				}
+				if pos == pYear && d.yearStar {
+					e.segs[pos] = segSpec{star: "*"}
+					continue
+				}
+				var sg segSpec
+				switch {
+				case pos == sp && mode == modeInvalid && alone && d.strict:
+					sg = hegel.Draw(tc, segGen[segInvalidStrict][pos])
+				case pos == sp && mode == modeInvalid && alone:
+					sg = hegel.Draw(tc, segGen[segInvalidAlone][pos])
+				case pos == sp && mode == modeInvalid:
+					sg = hegel.Draw(tc, segGen[segInvalid][pos])
+				case pos == sp && mode == modeNonsense:
+					sg = hegel.Draw(tc, segGen[segNonsense][pos])
+				case alone:
+					sg = hegel.Draw(tc, starAt(pos))
+				default:
+					sg = hegel.Draw(tc, segGen[segValid][pos])
+				}
+				if pos == pYear && form.yearForm && !yearRe.MatchString(upperNames(sg.text())) {
+					y := hegel.Draw(tc, hzInts(1990, 2100))
+					sg = segSpec{items: []item{{kind: "num", a: y, text: strconv.Itoa(y), valid: true}}}
+				}
+				if pos == pDow && form.count == 6 && !form.yearForm && yearRe.MatchString(upperNames(sg.text())) {
+					sg = segSpec{star: "*"}
+				}
+				e.segs[pos] = sg
+			}
+			e.sep = hegel.Draw(tc, sepTable)
+			e.lead = hegel.Draw(tc, leadTable)
+			e.trail = hegel.Draw(tc, trailTable)
+			e.newline = hegel.Draw(tc, dieCoin(d.newlinePct))
+			return e
+		})
+	})
+}
+
+// tagExpr is a built-in tag, evenly (measured 5.1 to 10.4 each of twelve: 44 "@5minutes" to
+// 90 "@daily" of 866 in the validity property; the engine's bias on a twelve-way draw), with
+// the case coins of its upper-cased name.
+var tagExpr = hegel.FlatMap(rangeHalves(0, len(tagTable)-1), func(i int) hegel.Generator[exprSpec] {
+	return hegel.Map(lowerCoins(strings.ToUpper(tagTable[i].name)), func(lower []bool) exprSpec {
+		return exprSpec{mode: modeTag, tag: i, tagLower: lower}
+	})
+})
+
+// gen is the expressions so drawn.
+func (d exprDraw) gen() hegel.Generator[exprSpec] {
+	return hegel.FlatMap(d.modes, func(mode string) hegel.Generator[exprSpec] {
+		if mode == modeTag {
+			return tagExpr
+		}
+		forms := d.forms
+		if d.alone && mode == modeInvalid && d.aloneForms != nil {
+			forms = d.aloneForms
+		}
+		return hegel.FlatMap(forms, func(form written) hegel.Generator[exprSpec] {
+			return d.builtExpr(mode, form)
+		})
+	})
+}
+
+// newlinePct is the newline's share by default (4 percent, measured 4.1 of the expressions
+// that are not tags) and under
+// HEGEL_NO_KNOWN=1 (zero: gronx/4's shape).
+var newlinePct = hzUnless(hzNoKnown, 4)
+
+// The forms of the lone invalid item: aloneForms where every walk must reach it (the
+// validity and due properties), the forms without a written year, whose year segment would
+// be a value the backward walk bails out at; secondAloneForms where the forward loop must
+// start at it (the batch property), the forms with a seconds segment (a five-segment form's
+// prepended "0" is before everything).
+var (
+	aloneForms       = halvesOver([]int{15, 6, 0, 5}, form5, form6, form6y, form7)
+	secondAloneForms = halvesOver([]int{2, 1}, form6, form7)
+)
+
+// upperNames mimics gronx's normalisation of a segment's text: upper-cased, names to
+// numbers.
+func upperNames(s string) string {
+	s = strings.ToUpper(s)
+	for i, nm := range dayNames {
+		s = strings.ReplaceAll(s, nm, strconv.Itoa(i))
+	}
+	for i, nm := range monthNames {
+		s = strings.ReplaceAll(s, nm, strconv.Itoa(i+1))
+	}
+	return s
+}
+
+func atoi(s string) int {
+	v, _ := strconv.Atoi(s)
+	return v
+}
+
+// parseSeg builds the model of a segment from clean text (the tags' expansions).
+func parseSeg(pos int, text string) seg {
+	sg := seg{pos: pos, text: text}
+	if text == "*" || text == "?" {
+		sg.star = true
+		return sg
+	}
+	for _, part := range strings.Split(text, ",") {
+		switch {
+		case strings.HasPrefix(part, "*/"):
+			sg.items = append(sg.items, item{kind: "starstep", step: atoi(part[2:]), text: part, valid: true})
+		case strings.Contains(part, "-"):
+			ab := strings.SplitN(part, "-", 2)
+			sg.items = append(sg.items, item{kind: "range", a: atoi(ab[0]), b: atoi(ab[1]), text: part, valid: true})
+		default:
+			sg.items = append(sg.items, item{kind: "num", a: atoi(part), text: part, valid: true})
+		}
+	}
+	return sg
+}
+
+// build is the expression of the record: the text as handed to gronx and its model.
+func (s exprSpec) build() *expr {
+	e := &expr{}
+	if s.mode == modeTag {
+		t := tagTable[s.tag]
+		e.tag = t.name
+		e.text = applyCase(strings.ToUpper(t.name), s.tagLower)
+		parts := strings.Split(t.expr, " ")
+		if len(parts) == 5 {
+			parts = append([]string{"0"}, parts...)
+		}
+		for pos := 0; pos < 7; pos++ {
+			if pos >= len(parts) {
+				e.segs[pos] = seg{pos: pos, star: true, text: "*"}
+				continue
+			}
+			e.segs[pos] = parseSeg(pos, parts[pos])
+		}
+		return e
+	}
+	e.written = s.form.count
+	e.yearForm = s.form.yearForm
+	var parts []string
+	for pos := 0; pos < 7; pos++ {
+		if !s.form.present(pos) {
+			e.segs[pos] = seg{pos: pos, star: true, text: "*"}
+			if pos == pSec {
+				e.segs[pos] = seg{pos: pos, text: "0", items: []item{{kind: "num", a: 0, text: "0", valid: true}}}
+			}
+			continue
+		}
+		sg := s.segs[pos]
+		parts = append(parts, sg.cased())
+		e.segs[pos] = seg{pos: pos, star: sg.star != "", text: upperNames(sg.text()), items: sg.items}
+	}
+	e.text = s.lead + strings.Join(parts, s.sep) + s.trail
+	if s.newline {
+		e.text += "\n"
+		e.newline = true
+	}
+	return e
+}
+
+func (s exprSpec) GoString() string {
+	e := s.build()
+	if s.mode == modeTag {
+		return fmt.Sprintf("tag %q (%s)", e.text, tagTable[s.tag].expr)
+	}
+	form := strconv.Itoa(s.form.count)
+	if s.form.yearForm {
+		form += "+year"
+	}
+	more := ""
+	if s.special >= 0 {
+		more = fmt.Sprintf(", %s in segment %d", s.mode, s.special)
+	}
+	return fmt.Sprintf("%q (%s segments%s)", e.text, form, more)
+}
+
+// --------------------------------------------------------------------------- instants
+
+var fixedZones = []*time.Location{
+	time.UTC,
+	time.FixedZone("+0545", 5*3600+45*60),
+	time.FixedZone("-0330", -(3*3600 + 30*60)),
+	time.FixedZone("+14", 14*3600),
+	time.FixedZone("-12", -12*3600),
+}
+
+// fixedZone is one of the five fixed-offset zones, evenly (measured 19.4 to 20.5).
+var fixedZone = rangeHalves(0, len(fixedZones)-1)
+
+// The specials of an instant: none; the day one of the month's ends; the first of a winter
+// month (January, February, March, December).
+const (
+	plainDay = iota
+	monthEnd
+	firstOfWinter
+)
+
+// instantSpec is a drawn wall-clock time: the year in 2020..2032 80 percent of the time
+// (measured 81.6) else 1995..2090, the month and day (a month's end one time in six, measured
+// 17.2; the first of a winter month one in six, 17.3), the clock (its edges, 0 or 23 hours,
+// 0 or 59 minutes and seconds, 30 percent of the time, measured 29.1), and when asked a
+// fraction of a second 30 percent of the time (measured 30.6).
+type instantSpec struct {
+	y, m, d, h, mi, s, ns int
+	special               int
+	edge                  bool
+}
+
+func instantOf(frac bool) hegel.Generator[instantSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) instantSpec {
+		var i instantSpec
+		i.y = hegel.Draw(tc, dieChoice(hzW(80, hzInts(2020, 2032)), hzW(20, hzInts(1995, 2090))))
+		i.special = hegel.Draw(tc, dieTree([]int{4, 1, 1}, plainDay, monthEnd, firstOfWinter))
+		switch i.special {
+		case monthEnd:
+			i.m = hegel.Draw(tc, hzInts(1, 12))
+			i.d = hegel.Draw(tc, evenHalves(28, 29, 30, 31))
+		case firstOfWinter:
+			i.m = hegel.Draw(tc, evenHalves(1, 2, 3, 12))
+			i.d = 1
+		default:
+			i.m = hegel.Draw(tc, hzInts(1, 12))
+			i.d = hegel.Draw(tc, hzInts(1, 31))
+		}
+		i.edge = hegel.Draw(tc, dieCoin(30))
+		if i.edge {
+			i.h = hegel.Draw(tc, evenHalves(0, 23))
+			i.mi = hegel.Draw(tc, evenHalves(0, 59))
+			i.s = hegel.Draw(tc, evenHalves(0, 59))
+		} else {
+			i.h = hegel.Draw(tc, hzInts(0, 23))
+			i.mi = hegel.Draw(tc, hzInts(0, 59))
+			i.s = hegel.Draw(tc, hzInts(0, 59))
+		}
+		if frac {
+			i.ns = hegel.Draw(tc, dieMaybe(30, hzInts(1, 999999999)))
+		}
+		return i
+	})
+}
+
+var (
+	wholeInstant = instantOf(false)
+	fracInstant  = instantOf(true)
+)
+
+// at is the instant in the zone (time.Date normalises a day past the month's end, as the
+// old generator let it).
+func (i instantSpec) at(loc *time.Location) time.Time {
+	return time.Date(i.y, time.Month(i.m), i.d, i.h, i.mi, i.s, i.ns, loc)
+}
+
+func (i instantSpec) GoString() string {
+	more := ""
+	switch i.special {
+	case monthEnd:
+		more = ", a month's end"
+	case firstOfWinter:
+		more = ", the first of a winter month"
+	}
+	if i.edge {
+		more += ", an edge clock"
+	}
+	return fmt.Sprintf("%04d-%02d-%02d %02d:%02d:%02d.%09d%s", i.y, i.m, i.d, i.h, i.mi, i.s, i.ns, more)
+}
+
+// spellTime is an instant in a failure message: its wall clock, zone and fraction.
+func spellTime(t time.Time) string {
+	return t.Format("2006-01-02 15:04:05.999999999 -07:00 MST")
+}
+
+// --------------------------------------------------------------------------- the moved
+// reference
+
+// movedToDue is the instant the model finds due at or after ref within six years (the old
+// generator's horizon), or ref itself; moved reports which. The nonsense reading of the
+// expression is used (a valid expression reads the same either way; an impossible modifier
+// is then where gronx would find a tick).
+func movedToDue(e *expr, ref time.Time) (time.Time, bool) {
+	if d, ok := e.view(true).tickAfter(ref, true); ok && d.Year() <= ref.Year()+6 {
+		return d, true
+	}
+	return ref, false
+}
+
+// --------------------------------------------------------------------------- validity
+
+// The segment-count variant of a valid expression: none; three segments appended; the
+// leading segments removed down to four.
+const (
+	countNone = iota
+	countMore
+	countFewer
+)
+
+// validityCase: an expression at the validity property's modes (valid three in seven,
+// invalid two, nonsense one, tag one: measured 41.8, 27.5, 16.3, 14.4), a fixed zone, a
+// whole-second reference, and for a valid expression one time in ten (measured 9.3 of the
+// valid mode, 3.9 of the cases) a segment-count variant, more or fewer each half the time
+// (measured 58.5 more: 137 to 97).
+type validityCase struct {
+	spec  exprSpec
+	zone  int
+	inst  instantSpec
+	count int
+	e     *expr
+	ref   time.Time
+}
+
+// validityModes is the mode table of the validity property: valid three in seven, invalid
+// two, nonsense one, tag one (the valid mode realised 40.9 at the weights 3:2:1:1, so they
+// are 63:40:20:20: measured 41.8, 27.5, 16.3, 14.4); the nonsense mode is at weight zero
+// under HEGEL_NO_KNOWN=1 (gronx/3's shape); the segment-count variant is drawn for the valid
+// mode only.
+var validityModes = halvesOver([]int{63, 40, hzUnless(hzNoKnown, 20), 20}, modeValid, modeInvalid, modeNonsense, modeTag)
+
+var validityExprs = exprDraw{modes: validityModes, forms: formTable, newlinePct: newlinePct, alone: hzNoKnown, aloneAt: -1, aloneForms: aloneForms}.gen()
+
+var validityCases = hegel.FlatMap(validityExprs, func(s exprSpec) hegel.Generator[validityCase] {
+	count := hegel.Just(countNone)
+	if s.mode == modeValid {
+		count = dieChoice(hzW(90, hegel.Just(countNone)), hzW(10, evenHalves(countMore, countFewer)))
+	}
+	return hegel.FlatMap(count, func(cnt int) hegel.Generator[validityCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[validityCase] {
+			return hegel.Map(wholeInstant, func(i instantSpec) validityCase {
+				c := validityCase{spec: s, zone: z, inst: i, count: cnt}
+				c.e = s.build()
+				c.ref = i.at(fixedZones[z])
+				return c
+			})
+		})
+	})
+})
+
+// countText is the text of the segment-count variant.
+func (c validityCase) countText() string {
+	switch c.count {
+	case countMore:
+		return c.e.text + " * * *"
+	case countFewer:
+		fields := strings.Fields(c.e.text)
+		if c.e.written > 5 {
+			return strings.Join(fields[c.e.written-4:], " ")
+		}
+		return strings.Join(fields[1:], " ")
+	}
+	return ""
+}
+
+func (c validityCase) GoString() string {
+	more := ""
+	if c.count != countNone {
+		more = fmt.Sprintf(", count variant %q", c.countText())
+	}
+	return fmt.Sprintf("validityCase{%#v at %s %s%s}", c.spec, spellTime(c.ref), fixedZones[c.zone], more)
+}
+
+// --------------------------------------------------------------------------- segments
+
+// segmentsCase: an expression at the segments property's modes (valid two in four, invalid
+// one, tag one: measured 48.0, 27.4, 24.6).
+type segmentsCase struct {
+	spec exprSpec
+	e    *expr
+}
+
+var segmentsModes = halvesOver([]int{2, 1, 1}, modeValid, modeInvalid, modeTag)
+
+var segmentsCases = hegel.Map(exprDraw{modes: segmentsModes, forms: formTable, newlinePct: newlinePct}.gen(), func(s exprSpec) segmentsCase {
+	return segmentsCase{spec: s, e: s.build()}
+})
+
+func (c segmentsCase) GoString() string { return fmt.Sprintf("segmentsCase{%#v}", c.spec) }
+
+// --------------------------------------------------------------------------- due
+
+// dueCase: an expression at the due property's modes (the old valid three in four and tag
+// one, plus nonsense at one in seven and invalid at one in ten: valid 56.8, tag 18.9,
+// invalid 10, nonsense 14.3 percent; measured 57.2, 16.7, 10.6, 15.6), a fixed zone, a
+// reference with a fraction, moved half the time (asked 50.7; found within six years 38.4)
+// to an instant the model finds due within six years plus 0..999 milliseconds.
+type dueCase struct {
+	spec  exprSpec
+	zone  int
+	inst  instantSpec
+	atDue bool
+	ms    int
+	e     *expr
+	ref   time.Time
+	moved bool
+}
+
+var dueModes = halvesOver([]int{159, 53, 28, hzUnless(hzNoKnown, 40)}, modeValid, modeTag, modeInvalid, modeNonsense)
+
+var dueExprs = exprDraw{modes: dueModes, forms: formTable, newlinePct: newlinePct, alone: hzNoKnown, aloneAt: -1, aloneForms: aloneForms}.gen()
+
+var dueCases = hegel.FlatMap(dueExprs, func(s exprSpec) hegel.Generator[dueCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[dueCase] {
+		return hegel.FlatMap(fracInstant, func(i instantSpec) hegel.Generator[dueCase] {
+			return hegel.FlatMap(dieCoin(50), func(atDue bool) hegel.Generator[dueCase] {
+				ms := hegel.Just(0)
+				if atDue {
+					ms = hzInts(0, 999)
+				}
+				return hegel.Map(ms, func(m int) dueCase {
+					c := dueCase{spec: s, zone: z, inst: i, atDue: atDue, ms: m}
+					c.e = s.build()
+					c.ref = i.at(fixedZones[z])
+					if atDue {
+						if d, ok := movedToDue(c.e, c.ref); ok {
+							c.ref, c.moved = d.Add(time.Duration(m)*time.Millisecond), true
+						}
+					}
+					return c
+				})
+			})
+		})
+	})
+})
+
+func (c dueCase) GoString() string {
+	more := ""
+	if c.moved {
+		more = " (moved to a due instant)"
+	}
+	return fmt.Sprintf("dueCase{%#v at %s %s%s}", c.spec, spellTime(c.ref), fixedZones[c.zone], more)
+}
+
+// --------------------------------------------------------------------------- ticks
+
+// ticksCase: an expression at the tick property's modes (the old valid three in four and tag
+// one, plus nonsense at one in seven: 64.3, 21.4, 14.3 percent; measured 63.0, 23.2, 13.8),
+// a fixed zone, a reference with a fraction, the reference included 40 percent of the time
+// (measured 39.4), and 30 percent of the time (asked 30.7; found within six years 26.2) the
+// reference moved onto an instant the model finds due within six years, half of those
+// (measured 50.6) with 1..999 milliseconds added (where the inclusion matters); the model's
+// ticks computed once.
+type ticksCase struct {
+	spec  exprSpec
+	zone  int
+	inst  instantSpec
+	incl  bool
+	atDue bool
+	ms    int
+	e     *expr
+	ref   time.Time
+	moved bool
+	facts tickFacts
+}
+
+var ticksModes = halvesOver([]int{9, 3, hzUnless(hzNoKnown, 2)}, modeValid, modeTag, modeNonsense)
+
+var ticksExprs = exprDraw{modes: ticksModes, forms: formTable, newlinePct: newlinePct}.gen()
+
+var ticksCases = hegel.FlatMap(ticksExprs, func(s exprSpec) hegel.Generator[ticksCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[ticksCase] {
+		return hegel.FlatMap(dieCoin(40), func(incl bool) hegel.Generator[ticksCase] {
+			// under HEGEL_NO_KNOWN=1 a reference that is included has no fraction (gronx/6's shape)
+			return hegel.FlatMap(instantOf(!(hzNoKnown && incl)), func(i instantSpec) hegel.Generator[ticksCase] {
+				return hegel.FlatMap(dieCoin(30), func(atDue bool) hegel.Generator[ticksCase] {
+					ms := hegel.Just(0)
+					if atDue {
+						ms = dieMaybe(hzUnless(hzNoKnown && incl, 50), hzInts(1, 999))
+					}
+					return hegel.Map(ms, func(m int) ticksCase {
+						c := ticksCase{spec: s, zone: z, inst: i, incl: incl, atDue: atDue, ms: m}
+						c.e = s.build()
+						c.ref = i.at(fixedZones[z])
+						if atDue {
+							if d, ok := movedToDue(c.e, c.ref); ok {
+								c.ref, c.moved = d.Add(time.Duration(m)*time.Millisecond), true
+							}
+						}
+						c.facts = tickFactsOf(c.e, c.ref, c.incl)
+						return c
+					})
+				})
+			})
+		})
+	})
+})
+
+func (c ticksCase) GoString() string {
+	more := ""
+	if c.moved {
+		more = ", moved to a due instant"
+	}
+	return fmt.Sprintf("ticksCase{%#v at %s %s, incl %v%s}", c.spec, spellTime(c.ref), fixedZones[c.zone], c.incl, more)
+}
+
+// --------------------------------------------------------------------------- DST
+
+var dstZoneNames = []string{"America/New_York", "Europe/Berlin", "Australia/Lord_Howe", "America/Santiago", "Europe/London"}
+
+var dstZones = func() []*time.Location {
+	out := make([]*time.Location, len(dstZoneNames))
+	for i, name := range dstZoneNames {
+		loc, err := time.LoadLocation(name)
+		if err != nil {
+			panic(err)
+		}
+		out[i] = loc
+	}
+	return out
+}()
+
+// dstZone is one of the five zones with daylight saving, evenly (measured 19.4 to 20.8).
+var dstZone = rangeHalves(0, len(dstZones)-1)
+
+// transitionsOf is the instants the zone's offset changes during the year, found by the hour.
+func transitionsOf(loc *time.Location, y int) []time.Time {
+	t := time.Date(y, 1, 1, 0, 0, 0, 0, loc)
+	_, off := t.Zone()
+	var trans []time.Time
+	for t.Year() == y {
+		nt := t.Add(time.Hour)
+		if _, o := nt.Zone(); o != off {
+			off = o
+			trans = append(trans, nt)
+		}
+		t = nt
+	}
+	return trans
+}
+
+// nearSpec is a reference moved near a transition of its year: the transition's index
+// among the year's, the minutes (-180..180) and seconds (0..59) added to it; none when the
+// year has no transition.
+type nearSpec struct {
+	index   int
+	minutes int
+	seconds int
+}
+
+// nearOf draws the move for a year of n transitions.
+func nearOf(n int) hegel.Generator[nearSpec] {
+	return hegel.FlatMap(rangeHalves(0, n-1), func(i int) hegel.Generator[nearSpec] {
+		return hegel.FlatMap(hzInts(-180, 180), func(m int) hegel.Generator[nearSpec] {
+			return hegel.Map(hzInts(0, 59), func(s int) nearSpec { return nearSpec{index: i, minutes: m, seconds: s} })
+		})
+	})
+}
+
+// dstInstant is a reference in the zone: an instant, moved near a transition of its year 60
+// percent of the time (measured 58.8); the DST property redraws it up to dstRedraws times
+// until the documented next tick lies within three days (the old property skipped the rest;
+// the filter after the redraws rejects what is still far).
+type dstInstant struct {
+	inst  instantSpec
+	near  bool
+	move  nearSpec
+	moved bool
+	ref   time.Time
+}
+
+func dstInstantOf(loc *time.Location) hegel.Generator[dstInstant] {
+	return hegel.FlatMap(wholeInstant, func(i instantSpec) hegel.Generator[dstInstant] {
+		return hegel.FlatMap(dieCoin(60), func(near bool) hegel.Generator[dstInstant] {
+			d := dstInstant{inst: i, near: near, ref: i.at(loc)}
+			if !near {
+				return hegel.Just(d)
+			}
+			trans := transitionsOf(loc, d.ref.Year())
+			if len(trans) == 0 {
+				return hegel.Just(d)
+			}
+			return hegel.Map(nearOf(len(trans)), func(m nearSpec) dstInstant {
+				d.move, d.moved = m, true
+				d.ref = trans[m.index].Add(time.Duration(m.minutes)*time.Minute + time.Duration(m.seconds)*time.Second)
+				return d
+			})
+		})
+	})
+}
+
+func (d dstInstant) GoString() string {
+	if d.moved {
+		return fmt.Sprintf("%s (transition %d %+d min %d s)", spellTime(d.ref), d.move.index, d.move.minutes, d.move.seconds)
+	}
+	return spellTime(d.ref)
+}
+
+// dstReach is how far the documented next tick may lie from the reference for the case to
+// be kept (the old property's bound).
+const dstReach = 3 * 24 * time.Hour
+
+// dstCase: an expression at the DST property's modes (valid two in three, tag one: measured
+// 66.5, 33.5), a zone with daylight saving, a reference (see dstInstant), the model's ticks
+// and the replica's search computed once. The old property skipped a case whose next tick
+// lay beyond three days (a third of them, the cost of its second-stepping check): here such
+// a reference is drawn again (redraws 1), and when the second is far too the reference is
+// moved to 1 second to 3 days before the next tick of the second (redraws 2, before > 0); a
+// case still far (an expression with no tick) is filtered out.
+type dstCase struct {
+	spec    exprSpec
+	zone    int
+	instant dstInstant
+	redraws int
+	before  int
+	e       *expr
+	ref     time.Time
+	facts   dstFacts
+}
+
+var dstModes = halvesOver([]int{2, 1}, modeValid, modeTag)
+
+// nearTick reports whether the documented next tick lies within reach.
+func nearTick(e *expr, ref time.Time) bool {
+	next, ok := e.view(false).tickAfter(ref, false)
+	return ok && next.Sub(ref) <= dstReach
+}
+
+var dstExprs = exprDraw{modes: dstModes, forms: dstFormTable, newlinePct: newlinePct, yearStar: true}.gen()
+
+var dstCases = hzOnly(true, "far tick",
+	hegel.FlatMap(dstExprs, func(s exprSpec) hegel.Generator[dstCase] {
+		return hegel.FlatMap(dstZone, func(z int) hegel.Generator[dstCase] {
+			loc := dstZones[z]
+			return hegel.Composite(func(tc hegel.TestCase) dstCase {
+				c := dstCase{spec: s, zone: z, e: s.build()}
+				c.instant = hegel.Draw(tc, dstInstantOf(loc))
+				c.ref = c.instant.ref
+				if !nearTick(c.e, c.ref) {
+					c.instant = hegel.Draw(tc, dstInstantOf(loc))
+					c.ref = c.instant.ref
+					c.redraws = 1
+					hzTally("dst redrawn")
+				}
+				if !nearTick(c.e, c.ref) {
+					if next, ok := c.e.view(false).tickAfter(c.ref, false); ok {
+						c.before = hegel.Draw(tc, hzInts(1, int(dstReach/time.Second)))
+						c.ref = next.Add(-time.Duration(c.before) * time.Second)
+						c.redraws = 2
+						hzTally("dst moved before a tick")
+					}
+				}
+				c.facts = dstFactsOf(c.e, c.ref)
+				return c
+			})
+		})
+	}),
+	func(c dstCase) bool { return nearTick(c.e, c.ref) })
+
+func (c dstCase) GoString() string {
+	more := ""
+	switch c.redraws {
+	case 1:
+		more = ", redrawn once"
+	case 2:
+		more = fmt.Sprintf(", moved to %d s before a tick", c.before)
+	}
+	return fmt.Sprintf("dstCase{%#v at %#v in %s%s}", c.spec, c.instant, dstZoneNames[c.zone], more)
+}
+
+// --------------------------------------------------------------------------- batch
+
+// batchEntry is one expression of a batch: a duplicate of an earlier entry (its index) or
+// a drawn expression.
+type batchEntry struct {
+	dup  int // -1 for a drawn expression
+	spec exprSpec
+}
+
+// batchCase: one to six entries evenly (measured 15.8 to 18.0 each), each after the first a
+// duplicate of an earlier one 20 percent of the time (measured 18.0 of the entries after the
+// first: 2706 of 15037) else an expression at the batch property's modes (valid three in
+// five, tag one, invalid one: measured 60.4, 18.9, 20.7 of the drawn entries), a fixed zone,
+// a reference with a fraction, moved half the time (asked 50.4; found within six years 38.5)
+// onto an instant the model finds the first expression due within six years.
+type batchCase struct {
+	entries []batchEntry
+	zone    int
+	inst    instantSpec
+	atDue   bool
+	built   []*expr
+	ref     time.Time
+	moved   bool
+}
+
+var batchModes = halvesOver([]int{3, 1, 1}, modeValid, modeTag, modeInvalid)
+
+// batchExpr is one entry's expression; under HEGEL_NO_KNOWN=1 an invalid one is a lone
+// invalid item in the seconds segment (the loop starts there) of a form that has one.
+var batchExpr = exprDraw{modes: batchModes, forms: formTable, newlinePct: newlinePct, alone: hzNoKnown, aloneAt: pSec, aloneForms: secondAloneForms}.gen()
+
+var batchEntries = hegel.FlatMap(rangeHalves(1, 6), func(k int) hegel.Generator[[]batchEntry] {
+	return hegel.Composite(func(tc hegel.TestCase) []batchEntry {
+		out := make([]batchEntry, k)
+		for i := range out {
+			out[i].dup = -1
+			if i > 0 && hegel.Draw(tc, dieCoin(20)) {
+				out[i].dup = hegel.Draw(tc, hzInts(0, i-1))
+				continue
+			}
+			out[i].spec = hegel.Draw(tc, batchExpr)
+		}
+		return out
+	})
+})
+
+var batchCases = hegel.FlatMap(batchEntries, func(entries []batchEntry) hegel.Generator[batchCase] {
+	return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[batchCase] {
+		return hegel.FlatMap(fracInstant, func(i instantSpec) hegel.Generator[batchCase] {
+			return hegel.Map(dieCoin(50), func(atDue bool) batchCase {
+				c := batchCase{entries: entries, zone: z, inst: i, atDue: atDue}
+				c.built = make([]*expr, len(entries))
+				for j, en := range entries {
+					if en.dup >= 0 {
+						c.built[j] = c.built[en.dup]
+						continue
+					}
+					c.built[j] = en.spec.build()
+				}
+				c.ref = i.at(fixedZones[z])
+				if atDue {
+					c.ref, c.moved = movedToDue(c.built[0], c.ref)
+				}
+				return c
+			})
+		})
+	})
+})
+
+// exprs is the built expressions in order (a duplicate shares its original's).
+func (c batchCase) exprs() []*expr { return c.built }
+
+func (c batchCase) GoString() string {
+	parts := make([]string, len(c.entries))
+	for i, en := range c.entries {
+		if en.dup >= 0 {
+			parts[i] = fmt.Sprintf("%d: = %d", i, en.dup)
+			continue
+		}
+		parts[i] = fmt.Sprintf("%d: %#v", i, en.spec)
+	}
+	more := ""
+	if c.moved {
+		more = " (moved to a due instant of the first)"
+	}
+	return fmt.Sprintf("batchCase{%s at %s %s%s}", strings.Join(parts, "; "), spellTime(c.ref), fixedZones[c.zone], more)
+}
+
+// --------------------------------------------------------------------------- tags
+
+// The alphabets of a tag's name: lower-case letters, digits, "_" and "-"; a quarter of the
+// time (measured 26.3) with the upper-case letters.
+const (
+	tagLowerAlphabet = "abcdefghijklmnopqrstuvwxyz0123456789_-"
+	tagUpperAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+)
+
+// nameSpec is a drawn tag name: whether the alphabet has capitals (a quarter of the time;
+// never under HEGEL_NO_KNOWN=1: gronx/5's shape), whether the name starts with "@" (70
+// percent of the time, measured 67.3: tags need no "@"), one to eight letters (evenly;
+// measured 11.6 to 13.1 each) as indexes into the alphabet, and for the narrow property of
+// gronx/5 the index of a letter forced to a capital (-1 for none); the property appends a
+// counter so that every name is new.
+type nameSpec struct {
+	upper   bool
+	at      bool
+	letters []int
+	capital int
+}
+
+var nameSpecs = nameSpecsOf(hzUnless(hzNoKnown, 25))
+
+// nameSpecsOf is a name whose alphabet has capitals upperPct percent of the time.
+func nameSpecsOf(upperPct int) hegel.Generator[nameSpec] {
+	return hegel.FlatMap(dieCoin(upperPct), func(upper bool) hegel.Generator[nameSpec] {
+		alphabet := tagLowerAlphabet
+		if upper {
+			alphabet += tagUpperAlphabet
+		}
+		return hegel.FlatMap(dieCoin(70), func(at bool) hegel.Generator[nameSpec] {
+			return hegel.Map(countedHalves(hzInts(0, len(alphabet)-1), 1, 8), func(letters []int) nameSpec {
+				return nameSpec{upper: upper, at: at, letters: letters, capital: -1}
+			})
+		})
+	})
+}
+
+// base is the name without the counter.
+func (n nameSpec) base() string {
+	alphabet := tagLowerAlphabet
+	if n.upper {
+		alphabet += tagUpperAlphabet
+	}
+	var b strings.Builder
+	if n.at {
+		b.WriteByte('@')
+	}
+	for i, x := range n.letters {
+		if i == n.capital {
+			b.WriteByte(tagUpperAlphabet[x%len(tagUpperAlphabet)])
+			continue
+		}
+		b.WriteByte(alphabet[x])
+	}
+	return b.String()
+}
+
+// hasUpper reports whether the name has a capital (the counter is lower-case base 36).
+func (n nameSpec) hasUpper() bool {
+	base := n.base()
+	return strings.ToLower(base) != base
+}
+
+// tagsCase: an expression at the tag property's modes (valid two in three, invalid one:
+// measured 67.9, 32.1; no newline: the old property returned on one), a tag name, a fixed
+// zone and a whole-second reference; the property fills the name (the base and the counter)
+// before judging; the model's next tick computed once for a valid expression without a year.
+type tagsCase struct {
+	spec  exprSpec
+	name  nameSpec
+	zone  int
+	inst  instantSpec
+	e     *expr
+	ref   time.Time
+	facts tickFacts
+	tag   string // the registered name, filled by the property
+}
+
+// tagsModes is the tag property's modes (the invalid mode at weight zero under
+// HEGEL_NO_KNOWN=1: gronx/8's shape).
+var tagsModes = halvesOver([]int{2, hzUnless(hzNoKnown, 1)}, modeValid, modeInvalid)
+
+var tagsExprs = exprDraw{modes: tagsModes, forms: formTable}.gen()
+
+var tagsCases = hegel.FlatMap(tagsExprs, func(s exprSpec) hegel.Generator[tagsCase] {
+	return hegel.FlatMap(nameSpecs, func(n nameSpec) hegel.Generator[tagsCase] {
+		return hegel.FlatMap(fixedZone, func(z int) hegel.Generator[tagsCase] {
+			return hegel.Map(wholeInstant, func(i instantSpec) tagsCase {
+				c := tagsCase{spec: s, name: n, zone: z, inst: i}
+				c.e = s.build()
+				c.ref = i.at(fixedZones[z])
+				if c.e.valid() && !c.e.nonsense() && !c.e.restricted(pYear) {
+					c.facts = tickFactsOf(c.e, c.ref, false)
+				}
+				return c
+			})
+		})
+	})
+})
+
+func (c tagsCase) hasUpper() bool { return c.name.hasUpper() }
+
+func (c tagsCase) GoString() string {
+	name := c.tag
+	if name == "" {
+		name = c.name.base() + "<n>"
+	}
+	return fmt.Sprintf("tagsCase{%q = %#v at %s %s}", name, c.spec, spellTime(c.ref), fixedZones[c.zone])
+}
diff --git a/hegel_zoo_idioms_test.go b/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..3d17fd8
--- /dev/null
+++ b/hegel_zoo_idioms_test.go
@@ -0,0 +1,619 @@
+package gronx_test
+
+// The generator idioms the properties share, copied from the excelize/graphql-go/cobra/
+// cascadia/carbon/orb/chi/go-debian/gin/cellbuf/kong/roaring/mergo/gotext/go-envconfig harness
+// (hegel_zoo_idioms_test.go there) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (HEGEL_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin and go/kong: evenHalves,
+// rangeHalves, countedHalves, halvesOver, halvesGens, evenGens) halve a range by fair bits,
+// and the figure beside every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	from   hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, from: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](parts ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(parts))
+		for i, g := range parts {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](parts ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range parts {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].from
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].from
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var subtrees []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			subtrees = append(subtrees, hegel.Just(vs[i]))
+		} else {
+			subtrees = append(subtrees, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(subtrees)), func(i int) hegel.Generator[T] { return subtrees[i] })
+	}
+	choices := make([]hzChoice[T], len(subtrees))
+	for i, g := range subtrees {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- added for
+// go/kong (halvesOver, halvesGens) and go/mergo (evenGens): weighted and even choices over
+// generators drawn by halving.
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves (the go/kong helper): the entries are cut where the cumulative weight is
+// nearest half, a fair-bit choice between the two parts at their summed weights (dieChoice),
+// and each part again, down to one value. Every split is two-way; an entry of weight zero is
+// never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	gens := make([]hegel.Generator[T], len(values))
+	for i, v := range values {
+		gens[i] = hegel.Just(v)
+	}
+	return halvesGens(weights, gens...)
+}
+
+// halvesGens is halvesOver over generators: the alternatives of a weighted choice at their
+// weights, drawn by halving (the first the shrink target).
+func halvesGens[T any](weights []int, gens ...hegel.Generator[T]) hegel.Generator[T] {
+	if len(weights) != len(gens) {
+		panic("halvesGens: weights and generators differ in length")
+	}
+	var ws []int
+	var gs []hegel.Generator[T]
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			gs = append(gs, gens[i])
+		}
+	}
+	if len(gs) == 0 {
+		panic("halvesGens: every alternative has weight 0")
+	}
+	if len(gs) == 1 {
+		return gs[0]
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(gs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesGens(ws[:cut], gs[:cut]...)), hzW(total-left, halvesGens(ws[cut:], gs[cut:]...)))
+}
+
+// evenGens is halvesGens at one weight each.
+func evenGens[T any](gens ...hegel.Generator[T]) hegel.Generator[T] {
+	ws := make([]int, len(gens))
+	for i := range ws {
+		ws[i] = 1
+	}
+	return halvesGens(ws, gens...)
+}
diff --git a/hegel_zoo_model_test.go b/hegel_zoo_model_test.go
new file mode 100644
index 0000000..5ee20a7
--- /dev/null
+++ b/hegel_zoo_model_test.go
@@ -0,0 +1,2095 @@
+package gronx_test
+
+// The model of gronx's documented behaviour and the replicas of its recorded bugs.
+//
+// The expression model (item, seg, expr; a view of it with or without gronx/3's reading of
+// the impossible modifiers) states what the README documents: the grammar (five, six or
+// seven segments, lists, ranges, steps, names, tags, the L/W/nL/n#k modifiers), whether a
+// wall-clock time is due (the Vixie day rule), and the next or previous due instant, exactly,
+// in any zone: a walk over the calendar from the reference's day over the days the date
+// fields accept, on each day the due wall clocks in order mapped to instants at every UTC
+// offset in effect that day, kept when the wall clock exists at that offset, the earliest
+// (latest) kept instant being the answer. In fixed-offset zones this is the old day walk; in
+// zones with daylight saving it is the exact statement the old property approximated.
+//
+// The replica (the lib* functions) is gronx transcribed: normalize and Segments (gronx.go),
+// isSyntaxValid, IsValid and SegmentsDue (gronx.go), CheckDue and isOffsetDue (checker.go),
+// inStep, inRange, isValidMonthDay and isValidWeekDay (validator.go), BatchDue's loop
+// (batch.go), NextTickAfter, loop, bumpUntilDue, bump and isUnreachableYear (next.go),
+// PrevTickBefore and bumpReverse (prev.go), with two instruments: an overlay that makes the
+// items the documented grammar rejects fail where gronx's walk evaluates them (so that the
+// replica of gronx/2 is "an invalid item is an error only when the walk reaches it", not
+// gronx's parser; an invalid item gronx's parser itself accepts is a candidate, see the
+// properties), and a trace of the wall clocks the search's time.Date calls land on (an
+// ambiguous one is gronx/9's ingredient, a missing midnight gronx/10's).
+//
+// The seven expected functions at the end are pure functions of a case and the switch set
+// returning every value the property checks: with every switch off the documented values,
+// with a switch on the replica's where the bug applies; the classifier in hegel_zoo_test.go
+// runs them per switch before the library is called.
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/adhocore/gronx"
+)
+
+// --------------------------------------------------------------------------- the grammar
+
+// Segment positions in the normalised seven-segment form.
+const (
+	pSec = iota
+	pMin
+	pHour
+	pDom
+	pMon
+	pDow
+	pYear
+)
+
+var bounds = [7][2]int{{0, 59}, {0, 59}, {0, 23}, {1, 31}, {1, 12}, {0, 7}, {0, 9999}}
+
+var monthNames = []string{"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"}
+var dayNames = []string{"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"}
+
+// tagTable is the built-in tags in a fixed order (a generator must not iterate a map).
+var tagTable = []struct{ name, expr string }{
+	{"@yearly", "0 0 1 1 *"}, {"@annually", "0 0 1 1 *"}, {"@monthly", "0 0 1 * *"}, {"@weekly", "0 0 * * 0"},
+	{"@daily", "0 0 * * *"}, {"@hourly", "0 * * * *"}, {"@always", "* * * * *"}, {"@5minutes", "*/5 * * * *"},
+	{"@10minutes", "*/10 * * * *"}, {"@15minutes", "*/15 * * * *"}, {"@30minutes", "0,30 * * * *"},
+	{"@everysecond", "* * * * * *"},
+}
+
+// item is one comma-separated alternative of a segment.
+type item struct {
+	kind string // num range starstep numstep rangestep L W dowL hash bad
+	a, b int
+	step int
+	text string
+	// valid: the grammar accepts it (gronx rejects everything else with an error).
+	valid bool
+	// nonsense: the grammar rejects it (an impossible modifier value) but gronx accepts it
+	// (gronx/3); valid is true for it so that the kind's reading is available.
+	nonsense bool
+}
+
+// bad reports whether the item is one the model treats as invalid: the grammar rejects it,
+// or it is nonsense and the view does not read nonsense as gronx does.
+func (it item) bad(nonsenseOK bool) bool { return !it.valid || (it.nonsense && !nonsenseOK) }
+
+// lenientRead is gronx's reading of an item with more "-" or "/" parts than the grammar
+// allows (gronx/12), and whether the item is one: inStep (validator.go :11-39) splits the
+// text on "/" and takes parts[1] as the step and parts[0] as the range, inRange (:62-73)
+// splits on "-" and takes parts[0] and parts[1]; the parts beyond are never read, so "1-2-3"
+// is the range 1-2, "1-2-3/1" the stepped range 1-2/1, "5/2/1" the open step 5/2, "1-2/3/4"
+// the stepped range 1-2/3 and "*/2/3" the star step */2. The item is one of the shape when
+// the parts read are numbers (a "*" base for the star step), there are parts beyond, and the
+// grammar rejects the text.
+func (it item) lenientRead() (item, bool) {
+	if it.valid {
+		return it, false
+	}
+	parts := strings.Split(it.text, "/")
+	sub := strings.Split(parts[0], "-")
+	if len(parts) <= 2 && len(sub) <= 2 {
+		return it, false
+	}
+	read := item{text: it.text, valid: true}
+	if len(parts) > 1 {
+		step, err := strconv.Atoi(parts[1])
+		if err != nil || step <= 0 {
+			return it, false
+		}
+		read.step = step
+	}
+	if sub[0] == "*" {
+		if len(parts) < 2 || len(sub) > 1 {
+			return it, false
+		}
+		read.kind = "starstep"
+		return read, true
+	}
+	a, err := strconv.Atoi(sub[0])
+	if err != nil {
+		return it, false
+	}
+	read.a = a
+	if len(sub) > 1 {
+		b, err := strconv.Atoi(sub[1])
+		if err != nil || b < a {
+			return it, false
+		}
+		read.b = b
+	}
+	switch {
+	case len(sub) > 1 && len(parts) > 1:
+		read.kind = "rangestep"
+	case len(sub) > 1:
+		read.kind = "range"
+	case len(parts) > 1:
+		read.kind = "numstep"
+	default:
+		return it, false
+	}
+	return read, true
+}
+
+// extra reports whether the item is of gronx/12's shape.
+func (it item) extra() bool {
+	_, ok := it.lenientRead()
+	return ok
+}
+
+type seg struct {
+	pos   int
+	star  bool // "*" or "?"
+	text  string
+	items []item
+}
+
+func (sg seg) valid() bool {
+	if sg.star {
+		return true
+	}
+	for _, it := range sg.items {
+		if !it.valid {
+			return false
+		}
+	}
+	return len(sg.items) > 0
+}
+
+func (sg seg) nonsense() bool {
+	for _, it := range sg.items {
+		if it.nonsense {
+			return true
+		}
+	}
+	return false
+}
+
+// expr is a built expression with its model.
+type expr struct {
+	text     string // as handed to gronx
+	segs     [7]seg // normalised (year star when absent)
+	written  int    // 5, 6 or 7 segments in the text (0 for a tag)
+	yearForm bool   // six segments with a year
+	tag      string // the tag used, if any
+	newline  bool   // ends in a newline
+}
+
+func (e *expr) valid() bool {
+	for _, sg := range e.segs {
+		if !sg.valid() {
+			return false
+		}
+	}
+	return true
+}
+
+func (e *expr) nonsense() bool {
+	for _, sg := range e.segs {
+		if sg.nonsense() {
+			return true
+		}
+	}
+	return false
+}
+
+// yearStarStepped reports whether the year segment holds a "*/s" item: the due years then
+// go on past the model's horizon (years 0..9999), while the library's search goes on past
+// it (NextTickAfter("* 41 * 5 10,12 */15 */2065", 2030) is in the year 14455 and
+// PrevTickBefore in -12390), so the model's "no tick" is not an answer there.
+func (e *expr) yearStarStepped() bool {
+	for _, it := range e.segs[pYear].items {
+		if it.kind == "starstep" {
+			return true
+		}
+	}
+	return false
+}
+
+// hasExtra reports whether some item is of gronx/12's shape.
+func (e *expr) hasExtra() bool {
+	for _, sg := range e.segs {
+		for _, it := range sg.items {
+			if it.extra() {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// restricted reports whether a segment takes part in a check (not * or ?).
+func (e *expr) restricted(pos int) bool { return !e.segs[pos].star }
+
+// isolatedInvalid: exactly one restricted segment, holding exactly one (invalid) item, so
+// gronx's check cannot bail out before reaching it (gronx/2 does not apply).
+func (e *expr) isolatedInvalid() bool {
+	k := 0
+	for pos := range e.segs {
+		if e.restricted(pos) {
+			k++
+		}
+	}
+	if k != 1 {
+		return false
+	}
+	for pos := range e.segs {
+		if e.restricted(pos) {
+			return len(e.segs[pos].items) == 1 && !e.segs[pos].items[0].valid
+		}
+	}
+	return false
+}
+
+// normalised is the six- or seven-segment text gronx works with (and croniter reads with
+// seconds first).
+func (e *expr) normalised() string {
+	return strings.Join(e.docSegments(), " ")
+}
+
+// docSegments is the normalised segments as the documentation gives them: six, or seven
+// when a year is written.
+func (e *expr) docSegments() []string {
+	parts := []string{}
+	for pos := 0; pos < 6; pos++ {
+		parts = append(parts, e.segs[pos].text)
+	}
+	if e.written == 7 || e.yearForm {
+		parts = append(parts, e.segs[pYear].text)
+	}
+	return parts
+}
+
+// intersect is gronx's rule (Vixie's): with both day segments restricted the day matches when
+// either does, unless the day-of-month starts with '*' or is '?', or the weekday starts with
+// "*/", in which case both must match.
+func (e *expr) intersect() bool {
+	dom, dow := e.segs[pDom].text, e.segs[pDow].text
+	return strings.HasPrefix(dow, "*/") || strings.HasPrefix(dom, "*") || dom == "?"
+}
+
+// union reports whether the day rule is the union: both day segments restricted and not
+// intersecting.
+func (e *expr) union() bool {
+	return e.restricted(pDom) && e.restricted(pDow) && !e.intersect()
+}
+
+// view is the expression read with or without gronx/3's reading of the impossible
+// modifiers (nonsenseOK): the documented model treats them as invalid (matching nothing,
+// an error wherever an item's validity is asked); gronx reads nW for any n through its
+// weekday offsets, nL as n modulo 7 and n#k with n above 7 or k outside 1..5 as never due.
+type view struct {
+	e          *expr
+	nonsenseOK bool
+	// lenient: an item with extra "-" or "/" parts is read as gronx reads it (gronx/12)
+	// instead of being rejected.
+	lenient bool
+}
+
+func (e *expr) view(nonsenseOK bool) view { return view{e: e, nonsenseOK: nonsenseOK} }
+
+// rejects reports whether the view treats the item as invalid.
+func (v view) rejects(it item) bool {
+	if v.lenient && it.extra() {
+		return false
+	}
+	return it.bad(v.nonsenseOK)
+}
+
+// read is the item as the view reads it (its lenient reading under gronx/12).
+func (v view) read(it item) item {
+	if v.lenient {
+		if r, ok := it.lenientRead(); ok {
+			return r
+		}
+	}
+	return it
+}
+
+// hasBad reports whether some item is invalid in the view.
+func (v view) hasBad() bool {
+	for _, sg := range v.e.segs {
+		for _, it := range sg.items {
+			if v.rejects(it) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// badAt is the overlay the replica takes: whether item idx of the segment at pos is one the
+// view rejects (the replica reads the rest itself, an item of gronx/12's shape with inRange
+// and inStep's parts[0] and parts[1]).
+func (v view) badAt(pos, idx int) bool {
+	if pos < 0 || pos > 6 || idx < 0 || idx >= len(v.e.segs[pos].items) {
+		return false
+	}
+	return v.rejects(v.e.segs[pos].items[idx])
+}
+
+// --------------------------------------------------------------------------- matching
+
+// itemMatches: the plain (numeric) items at a position. Weekday values are 0..6 as time gives
+// them; 7 in the expression is Sunday.
+func itemMatches(it item, pos, v int) bool {
+	lo, hi := bounds[pos][0], bounds[pos][1]
+	dow := pos == pDow
+	switch it.kind {
+	case "num":
+		if dow {
+			return it.a%7 == v
+		}
+		return it.a == v
+	case "range":
+		a, b := it.a, it.b
+		if dow {
+			if a == 7 && b != 7 {
+				a = 0
+			}
+			for x := a; x <= b; x++ {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return a <= v && v <= b
+	case "starstep":
+		return (v-lo)%it.step == 0
+	case "numstep":
+		a := it.a
+		if dow {
+			// gronx (and croniter) run an open step over 0..6 only: "5/2" is Friday alone, and a
+			// leading 7 is Sunday
+			if a == 7 {
+				a = 0
+			}
+			for x := a; x <= 6; x += it.step {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return v >= a && (v-a)%it.step == 0 && v <= hi
+	case "rangestep":
+		a, b := it.a, it.b
+		if dow {
+			if a == 7 && b != 7 {
+				a = 0
+			}
+			for x := a; x <= b; x += it.step {
+				if x%7 == v {
+					return true
+				}
+			}
+			return false
+		}
+		return a <= v && v <= b && (v-a)%it.step == 0
+	}
+	return false
+}
+
+// The calendar, by arithmetic (the same in every zone).
+func isLeap(y int) bool { return y%4 == 0 && (y%100 != 0 || y%400 == 0) }
+
+func daysIn(y, m int) int {
+	switch m {
+	case 2:
+		if isLeap(y) {
+			return 29
+		}
+		return 28
+	case 4, 6, 9, 11:
+		return 30
+	}
+	return 31
+}
+
+// weekdayOf is the weekday of a date (Sunday 0).
+func weekdayOf(y, m, d int) int {
+	return int(time.Date(y, time.Month(m), d, 12, 0, 0, 0, time.UTC).Weekday())
+}
+
+// wDay is the day the item "aW" fires in a month of last days: a itself when it is a
+// weekday, else the closest weekday, the earlier one first, never outside the month; 0 when
+// a is beyond the month's end or no offset lands on a weekday. For a in 1..31 this is the
+// documented reading; for 0 and negative a it is gronx's (validator.go :126-144, gronx/3),
+// which the view reads only with nonsenseOK.
+func wDay(a, last int, wd func(d int) int) int {
+	if a > last {
+		return 0
+	}
+	for _, off := range []int{0, -1, 1, -2, 2} {
+		d := a + off
+		if d < 1 || d > last {
+			continue
+		}
+		if w := wd(d); w >= 1 && w <= 5 {
+			return d
+		}
+	}
+	return 0
+}
+
+// segMatchesDay: the day-of-month or weekday segment against a date of weekday w in a
+// month of last days (wd gives the weekday of another day of the month).
+func (v view) segMatchesDay(pos, d, w, last int, wd func(int) int) bool {
+	sg := v.e.segs[pos]
+	if sg.star {
+		return true
+	}
+	for _, it := range sg.items {
+		if v.rejects(it) {
+			continue
+		}
+		it = v.read(it)
+		switch it.kind {
+		case "L":
+			if d == last {
+				return true
+			}
+		case "W":
+			if wDay(it.a, last, wd) == d {
+				return true
+			}
+		case "dowL":
+			// validator.go :156-162: the weekday modulo 7, the last such day of the month
+			if it.a >= 0 && w == it.a%7 && d+7 > last {
+				return true
+			}
+		case "hash":
+			// validator.go :181-185: a day above 7 or an occurrence outside 1..5 is never due
+			if it.a >= 0 && it.a <= 7 && it.b >= 1 && it.b <= 5 && w == it.a%7 && (d-1)/7 == it.b-1 {
+				return true
+			}
+		default:
+			x := d
+			if pos == pDow {
+				x = w
+			}
+			if itemMatches(it, pos, x) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (v view) fieldMatches(pos, x int) bool {
+	sg := v.e.segs[pos]
+	if sg.star {
+		return true
+	}
+	for _, it := range sg.items {
+		if v.rejects(it) {
+			continue
+		}
+		if itemMatches(v.read(it), pos, x) {
+			return true
+		}
+	}
+	return false
+}
+
+// dayRule: the two day segments under the intersect/union rule (the month and year are the
+// caller's), for a date of weekday w in a month of last days.
+func (v view) dayRule(y, m, d, w, last int, forceIntersect bool) bool {
+	wd := func(x int) int { return (w + (x - d) + 7*31) % 7 }
+	dom := v.segMatchesDay(pDom, d, w, last, wd)
+	dow := v.segMatchesDay(pDow, d, w, last, wd)
+	if v.e.union() && !forceIntersect {
+		return dom || dow
+	}
+	return dom && dow
+}
+
+// dayMatches: month, year and the two day segments.
+func (v view) dayMatches(y, m, d int, forceIntersect bool) bool {
+	if !v.fieldMatches(pMon, m) || !v.fieldMatches(pYear, y) {
+		return false
+	}
+	return v.dayRule(y, m, d, weekdayOf(y, m, d), daysIn(y, m), forceIntersect)
+}
+
+// due: the model of IsDue for a wall-clock time (its fields in its own zone).
+func (v view) due(t time.Time) bool { return v.dueBy(t, false) }
+
+// dueIntersect is due with the union rule off: BatchDue's reading (gronx/1).
+func (v view) dueIntersect(t time.Time) bool { return v.dueBy(t, true) }
+
+func (v view) dueBy(t time.Time, forceIntersect bool) bool {
+	return v.fieldMatches(pSec, t.Second()) && v.fieldMatches(pMin, t.Minute()) &&
+		v.fieldMatches(pHour, t.Hour()) && v.dayMatches(t.Year(), int(t.Month()), t.Day(), forceIntersect)
+}
+
+// values of a time field in ascending order.
+func (v view) values(pos int) []int {
+	var out []int
+	for x := bounds[pos][0]; x <= bounds[pos][1]; x++ {
+		if v.fieldMatches(pos, x) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the ticks
+
+// wallIter walks the due wall clocks of a day in order (or in reverse), from the first one
+// past a threshold.
+type wallIter struct {
+	hs, ms, ss []int
+	i, j, k    int
+	reverse    bool
+	done       bool
+}
+
+func (w *wallIter) cur() (int, int, int) { return w.hs[w.i], w.ms[w.j], w.ss[w.k] }
+
+// advance moves to the next wall clock in the walk's direction.
+func (w *wallIter) advance() {
+	if w.reverse {
+		w.k--
+		if w.k >= 0 {
+			return
+		}
+		w.k = len(w.ss) - 1
+		w.j--
+		if w.j >= 0 {
+			return
+		}
+		w.j = len(w.ms) - 1
+		w.i--
+		if w.i < 0 {
+			w.done = true
+		}
+		return
+	}
+	w.k++
+	if w.k < len(w.ss) {
+		return
+	}
+	w.k = 0
+	w.j++
+	if w.j < len(w.ms) {
+		return
+	}
+	w.j = 0
+	w.i++
+	if w.i >= len(w.hs) {
+		w.done = true
+	}
+}
+
+// lowerBound is the first index of xs with a value >= x (len(xs) when none).
+func lowerBound(xs []int, x int) int {
+	for i, v := range xs {
+		if v >= x {
+			return i
+		}
+	}
+	return len(xs)
+}
+
+// wallsFrom is the walk of the due wall clocks after (at or after, with incl) the wall
+// clock (th, tm, ts); prune false walks from the first wall clock of the day.
+func wallsFrom(hs, ms, ss []int, prune bool, th, tm, ts int, incl bool) *wallIter {
+	w := &wallIter{hs: hs, ms: ms, ss: ss}
+	if !prune {
+		return w
+	}
+	// (h, mi, s) > (th, tm, ts), or >= with incl, in lexicographic order
+	w.i = lowerBound(hs, th)
+	if w.i >= len(hs) {
+		w.done = true
+		return w
+	}
+	if hs[w.i] > th {
+		return w
+	}
+	w.j = lowerBound(ms, tm)
+	if w.j >= len(ms) {
+		w.j = 0
+		w.i++
+		w.done = w.i >= len(hs)
+		return w
+	}
+	if ms[w.j] > tm {
+		return w
+	}
+	if incl {
+		w.k = lowerBound(ss, ts)
+	} else {
+		w.k = lowerBound(ss, ts+1)
+	}
+	if w.k >= len(ss) {
+		w.k = 0
+		w.j++
+		if w.j >= len(ms) {
+			w.j = 0
+			w.i++
+			w.done = w.i >= len(hs)
+		}
+	}
+	return w
+}
+
+// wallsBefore is the reverse walk: the due wall clocks before (at or before, with incl)
+// the wall clock, from the last one.
+func wallsBefore(hs, ms, ss []int, prune bool, th, tm, ts int, incl bool) *wallIter {
+	w := &wallIter{hs: hs, ms: ms, ss: ss, reverse: true, i: len(hs) - 1, j: len(ms) - 1, k: len(ss) - 1}
+	if !prune {
+		return w
+	}
+	// the last (h, mi, s) < (th, tm, ts), or <= with incl
+	w.i = lowerBound(hs, th+1) - 1 // the last h <= th
+	if w.i < 0 {
+		w.done = true
+		return w
+	}
+	if hs[w.i] < th {
+		return w
+	}
+	w.j = lowerBound(ms, tm+1) - 1
+	if w.j < 0 {
+		w.j = len(ms) - 1
+		w.i--
+		w.done = w.i < 0
+		return w
+	}
+	if ms[w.j] < tm {
+		return w
+	}
+	if incl {
+		w.k = lowerBound(ss, ts+1) - 1
+	} else {
+		w.k = lowerBound(ss, ts) - 1
+	}
+	if w.k < 0 {
+		w.k = len(ss) - 1
+		w.j--
+		if w.j < 0 {
+			w.j = len(ms) - 1
+			w.i--
+			w.done = w.i < 0
+		}
+	}
+	return w
+}
+
+// offsetsOfDay is the UTC offsets (seconds) in effect during the day in the zone: those at
+// the instants around its start, its noon and its end (two on a transition day).
+func offsetsOfDay(loc *time.Location, y, m, d int) []int {
+	noon := time.Date(y, time.Month(m), d, 12, 0, 0, 0, loc)
+	var out []int
+	for _, delta := range []time.Duration{-13 * time.Hour, -12 * time.Hour, 0, 12 * time.Hour, 13 * time.Hour} {
+		_, off := noon.Add(delta).Zone()
+		seen := false
+		for _, o := range out {
+			if o == off {
+				seen = true
+			}
+		}
+		if !seen {
+			out = append(out, off)
+		}
+	}
+	return out
+}
+
+// reads reports whether the instant's wall clock in the zone is the given one.
+func reads(t time.Time, loc *time.Location, y, m, d, h, mi, s int) bool {
+	t = t.In(loc)
+	ty, tm, td := t.Date()
+	th, tmi, ts := t.Clock()
+	return ty == y && int(tm) == m && td == d && th == h && tmi == mi && ts == s
+}
+
+// cmpDate orders a date against (y, m, d): -1 before, 0 the day, 1 after.
+func cmpDate(ty int, tm time.Month, td, y, m, d int) int {
+	switch {
+	case ty != y:
+		if ty < y {
+			return -1
+		}
+		return 1
+	case int(tm) != m:
+		if int(tm) < m {
+			return -1
+		}
+		return 1
+	case td != d:
+		if td < d {
+			return -1
+		}
+		return 1
+	}
+	return 0
+}
+
+// instantOfDay is the earliest (reverse: the latest) instant of the day in loc whose wall
+// clock is due and which lies after (reverse: before) start, at or after (before) with incl:
+// per offset in effect that day, the first due wall clock past start's reading at that
+// offset whose instant reads that wall clock in the zone (it exists at that offset), and the
+// earliest (latest) of them.
+func (v view) instantOfDay(loc *time.Location, y, m, d int, hs, ms, ss []int, start time.Time, incl, reverse bool) (time.Time, bool) {
+	var best time.Time
+	found := false
+	for _, o := range offsetsOfDay(loc, y, m, d) {
+		off := time.Duration(o) * time.Second
+		reading := start.UTC().Add(off)
+		ry, rm, rd := reading.Date()
+		c := cmpDate(ry, rm, rd, y, m, d)
+		th, tmi, ts := reading.Clock()
+		var w *wallIter
+		if reverse {
+			if c < 0 {
+				continue
+			}
+			w = wallsBefore(hs, ms, ss, c == 0, th, tmi, ts, incl)
+		} else {
+			if c > 0 {
+				continue
+			}
+			w = wallsFrom(hs, ms, ss, c == 0, th, tmi, ts, incl)
+		}
+		for ; !w.done; w.advance() {
+			h, mi, s := w.cur()
+			inst := time.Date(y, time.Month(m), d, h, mi, s, 0, time.UTC).Add(-off)
+			if !reads(inst, loc, y, m, d, h, mi, s) {
+				continue
+			}
+			if !found || (!reverse && inst.Before(best)) || (reverse && inst.After(best)) {
+				best, found = inst, true
+			}
+			break
+		}
+	}
+	return best.In(loc), found
+}
+
+// tickAfter: the earliest instant after start (at or after with incl) that is due, in
+// start's zone, walking the years to 9999 (the year field's bound); ok=false when none.
+// Without a year restriction the day rule repeats every 400 years, so the walk stops there.
+func (v view) tickAfter(start time.Time, incl bool) (time.Time, bool) {
+	loc := start.Location()
+	start = start.Truncate(time.Second)
+	hs, ms, ss := v.values(pHour), v.values(pMin), v.values(pSec)
+	if len(hs) == 0 || len(ms) == 0 || len(ss) == 0 {
+		return time.Time{}, false
+	}
+	y0, m0, d0 := start.Date()
+	for y := y0; y <= 9999; y++ {
+		if !v.e.restricted(pYear) && y >= y0+400 {
+			break
+		}
+		if !v.fieldMatches(pYear, y) {
+			continue
+		}
+		wd := weekdayOf(y, 1, 1)
+		for m := 1; m <= 12; m++ {
+			last := daysIn(y, m)
+			if (y == y0 && m < int(m0)) || !v.fieldMatches(pMon, m) {
+				wd = (wd + last) % 7
+				continue
+			}
+			for d := 1; d <= last; d++ {
+				w := (wd + d - 1) % 7
+				if y == y0 && m == int(m0) && d < d0 {
+					continue
+				}
+				if !v.dayRule(y, m, d, w, last, false) {
+					continue
+				}
+				if t, ok := v.instantOfDay(loc, y, m, d, hs, ms, ss, start, incl, false); ok {
+					return t, true
+				}
+			}
+			wd = (wd + last) % 7
+		}
+	}
+	return time.Time{}, false
+}
+
+// tickBefore: the latest instant before start (at or before with incl) that is due, walking
+// the years down to 0.
+func (v view) tickBefore(start time.Time, incl bool) (time.Time, bool) {
+	loc := start.Location()
+	start = start.Truncate(time.Second)
+	hs, ms, ss := v.values(pHour), v.values(pMin), v.values(pSec)
+	if len(hs) == 0 || len(ms) == 0 || len(ss) == 0 {
+		return time.Time{}, false
+	}
+	y0, m0, d0 := start.Date()
+	for y := y0; y >= 0; y-- {
+		if !v.e.restricted(pYear) && y <= y0-400 {
+			break
+		}
+		if !v.fieldMatches(pYear, y) {
+			continue
+		}
+		wd := weekdayOf(y, 12, 31)
+		for m := 12; m >= 1; m-- {
+			last := daysIn(y, m)
+			if (y == y0 && m > int(m0)) || !v.fieldMatches(pMon, m) {
+				wd = (wd - last%7 + 7) % 7
+				continue
+			}
+			for d := last; d >= 1; d-- {
+				w := (wd - (last - d) + 7*31) % 7
+				if y == y0 && m == int(m0) && d > d0 {
+					continue
+				}
+				if !v.dayRule(y, m, d, w, last, false) {
+					continue
+				}
+				if t, ok := v.instantOfDay(loc, y, m, d, hs, ms, ss, start, incl, true); ok {
+					return t, true
+				}
+			}
+			wd = (wd - last%7 + 7) % 7
+		}
+	}
+	return time.Time{}, false
+}
+
+// --------------------------------------------------------------------------- the replica
+
+var (
+	libLiterals = strings.NewReplacer(
+		"SUN", "0", "MON", "1", "TUE", "2", "WED", "3", "THU", "4", "FRI", "5", "SAT", "6",
+		"JAN", "1", "FEB", "2", "MAR", "3", "APR", "4", "MAY", "5", "JUN", "6", "JUL", "7",
+		"AUG", "8", "SEP", "9", "OCT", "10", "NOV", "11", "DEC", "12",
+	)
+	libSpaceRe = regexp.MustCompile(`\s+`)
+	libYearRe  = regexp.MustCompile(`\d{4}`)
+	libDashRe  = regexp.MustCompile(`/.*$`)
+)
+
+// libTag is the built-in tag's expression (gronx.go :16-30; the tags the tag property adds
+// are not part of the replica: their expected values are stated from the expression).
+func libTag(lower string) (string, bool) {
+	for _, t := range tagTable {
+		if t.name == lower {
+			return t.expr, true
+		}
+	}
+	return "", false
+}
+
+// libNormalize is normalize (gronx.go :53-63): " \t" trimmed, the tag looked up by the
+// lower-cased text, every \s+ run a space, upper-cased, the names replaced, split on spaces.
+func libNormalize(text string) []string {
+	expr := strings.Trim(text, " \t")
+	if e, ok := libTag(strings.ToLower(expr)); ok {
+		expr = e
+	}
+	expr = libSpaceRe.ReplaceAllString(expr, " ")
+	expr = libLiterals.Replace(strings.ToUpper(expr))
+	return strings.Split(strings.ReplaceAll(expr, "  ", " "), " ")
+}
+
+// libSegments is Segments (gronx.go :99-113): five to seven segments, a 0 second prepended
+// to five and to six whose sixth has four digits; ok false for another count.
+func libSegments(text string) ([]string, bool) {
+	segs := libNormalize(text)
+	if len(segs) < 5 || len(segs) > 7 {
+		return nil, false
+	}
+	if len(segs) == 5 || (len(segs) == 6 && libYearRe.MatchString(segs[5])) {
+		segs = append([]string{"0"}, segs...)
+	}
+	return segs, true
+}
+
+// libSyntaxValid is isSyntaxValid (gronx.go :194-222): no empty segment, no empty part, a
+// part with "/" has exactly two sides and a non-empty right side.
+func libSyntaxValid(segs []string) bool {
+	for _, seg := range segs {
+		if seg == "" {
+			return false
+		}
+		for _, part := range strings.Split(seg, ",") {
+			if part == "" {
+				return false
+			}
+			if strings.ContainsAny(part, "*/") && strings.Contains(part, "/") {
+				sides := strings.Split(part, "/")
+				if len(sides) != 2 || sides[1] == "" {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+// errBad is the overlay's error: the documented grammar rejects the item.
+var errBad = errors.New("invalid item (the documented grammar)")
+
+// overlay says which items the documented grammar rejects, by segment position and item
+// index in the segment array handed to the replica; nil for none.
+type overlay func(pos, idx int) bool
+
+// libTrace records what the replica's walk did: the wall clocks the search's time.Date
+// calls produced that are ambiguous (gronx/9's ingredient) or that are not the midnight asked
+// for (gronx/10's: a day without midnight), and other gaps (a wall clock that is not the one
+// asked for, at another hour).
+type libTrace struct {
+	ambiguous, midnightGap, otherGap int
+	// hourSkipped counts the hour bumps whose added hour moved the wall clock by two hours:
+	// over a spring-forward (the skipped hour exists in part when the clocks go forward by
+	// half an hour, Australia/Lord_Howe: gronx/13)
+	hourSkipped int
+}
+
+// libIsValid is IsValid (gronx.go :171-190) over the segments: isSyntaxValid, then CheckDue
+// of every segment in order against ref (the package-level checker's reference, gronx.go
+// :167), false at the first error.
+func libIsValid(segs []string, ref time.Time, bad overlay) bool {
+	if !libSyntaxValid(segs) {
+		return false
+	}
+	for pos, seg := range segs {
+		if _, err := libCheckDue(seg, pos, ref, bad); err != nil {
+			return false
+		}
+	}
+	return true
+}
+
+// libSegmentsDue is SegmentsDue (gronx.go :117-160): the segments from the last to the
+// first, * and ? skipped, the weekday segment checked together with the day-of-month under
+// the union (either due: the day-of-month check is skipped, its error with it), returning
+// at the first segment not due or in error.
+func libSegmentsDue(segs []string, ref time.Time, bad overlay) (bool, error) {
+	skipMonthDayCheck := false
+	for i := 0; i < len(segs); i++ {
+		pos := len(segs) - 1 - i
+		seg := segs[pos]
+		isMonthDay, isWeekday := pos == 3, pos == 5
+		if seg == "*" || seg == "?" {
+			continue
+		}
+		if isMonthDay && skipMonthDayCheck {
+			continue
+		}
+		if isWeekday {
+			monthDaySeg := segs[3]
+			intersect := strings.Index(seg, "*/") == 0 || strings.Index(monthDaySeg, "*") == 0 || monthDaySeg == "?"
+			if !intersect {
+				due, err := libCheckDue(seg, pos, ref, bad)
+				if err != nil {
+					return false, err
+				}
+				monthDayDue, err := libCheckDue(monthDaySeg, 3, ref, bad)
+				if due || monthDayDue {
+					skipMonthDayCheck = true
+					continue
+				}
+				if err != nil {
+					return false, err
+				}
+			}
+		}
+		if due, err := libCheckDue(seg, pos, ref, bad); !due {
+			return due, err
+		}
+	}
+	return true, nil
+}
+
+// libCheckDue is CheckDue (checker.go :34-61): the comma items in order, returning at the
+// first due one or, for an item without L/W/# (or outside the day segments), at the first
+// error; an L/W/# item in a day segment goes through isValidMonthDay/isValidWeekDay instead
+// when isOffsetDue is not due. The overlay makes an item the grammar rejects an error where
+// gronx evaluates it.
+func libCheckDue(segment string, pos int, ref time.Time, bad overlay) (due bool, err error) {
+	last := -1
+	val, loc := libValueByPos(ref, pos), ref.Location()
+	isMonthDay, isWeekDay := pos == 3, pos == 5
+	for idx, offset := range strings.Split(segment, ",") {
+		if bad != nil && bad(pos, idx) {
+			return false, errBad
+		}
+		mod := (isMonthDay || isWeekDay) && strings.ContainsAny(offset, "LW#")
+		if due, err = libOffsetDue(offset, val, pos); due || (!mod && err != nil) {
+			return
+		}
+		if !mod {
+			continue
+		}
+		if last == -1 {
+			last = time.Date(ref.Year(), ref.Month(), 1, 0, 0, 0, 0, loc).AddDate(0, 1, 0).Add(-time.Second).Day()
+		}
+		if isMonthDay {
+			due, err = libMonthDay(offset, last, ref)
+		} else if isWeekDay {
+			due, err = libWeekDay(offset, last, ref)
+		}
+		if due || err != nil {
+			return due, err
+		}
+	}
+	return false, nil
+}
+
+// libOffsetDue is isOffsetDue (checker.go :63-90).
+func libOffsetDue(offset string, val, pos int) (bool, error) {
+	if offset == "*" || offset == "?" {
+		return true, nil
+	}
+	bnds, isWeekDay := libBoundsByPos(pos), pos == 5
+	if strings.Contains(offset, "/") {
+		return libInStep(val, offset, bnds, isWeekDay)
+	}
+	if strings.Contains(offset, "-") {
+		return libInRange(val, offset, bnds, isWeekDay)
+	}
+	nval, err := strconv.Atoi(offset)
+	if err != nil {
+		return false, err
+	}
+	if nval < bnds[0] || nval > bnds[1] {
+		return false, fmt.Errorf("segment#%d: '%s' out of bounds(%d, %d)", pos, offset, bnds[0], bnds[1])
+	}
+	if !isWeekDay && (val == 0 || nval == 0) {
+		return nval == 0 && val == 0, nil
+	}
+	return nval == val || (isWeekDay && nval == 7 && val == 0), nil
+}
+
+// libValueByPos is valueByPos (checker.go :92-110); libBoundsByPos boundsByPos (:112-129).
+func libValueByPos(ref time.Time, pos int) int {
+	switch pos {
+	case 0:
+		return ref.Second()
+	case 1:
+		return ref.Minute()
+	case 2:
+		return ref.Hour()
+	case 3:
+		return ref.Day()
+	case 4:
+		return int(ref.Month())
+	case 5:
+		return int(ref.Weekday())
+	case 6:
+		return ref.Year()
+	}
+	return 0
+}
+
+func libBoundsByPos(pos int) []int {
+	switch pos {
+	case 0, 1:
+		return []int{0, 59}
+	case 2:
+		return []int{0, 23}
+	case 3:
+		return []int{1, 31}
+	case 4:
+		return []int{1, 12}
+	case 5:
+		return []int{0, 7}
+	case 6:
+		return []int{0, 9999}
+	}
+	return []int{0, 0}
+}
+
+// libInStep is inStep (validator.go :11-60).
+func libInStep(val int, s string, bnds []int, isWeekDay bool) (bool, error) {
+	parts := strings.Split(s, "/")
+	step, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return false, err
+	}
+	if step <= 0 {
+		return false, errors.New("step can't be 0")
+	}
+	if strings.Index(s, "*/") == 0 {
+		return (val-bnds[0])%step == 0, nil
+	}
+	if strings.Index(s, "0/") == 0 {
+		return val%step == 0, nil
+	}
+	sub, end := strings.Split(parts[0], "-"), val
+	start, err := strconv.Atoi(sub[0])
+	if err != nil {
+		return false, err
+	}
+	if len(sub) > 1 {
+		end, err = strconv.Atoi(sub[1])
+		if err != nil {
+			return false, err
+		}
+	}
+	if (len(sub) > 1 && end < start) || start < bnds[0] || end > bnds[1] {
+		return false, fmt.Errorf("step '%s' out of bounds(%d, %d)", parts[0], bnds[0], bnds[1])
+	}
+	if isWeekDay {
+		if start == 7 && end != 7 {
+			start = 0
+		}
+		if val == 0 {
+			return libInStepRange(0, start, end, step) || libInStepRange(7, start, end, step), nil
+		}
+	}
+	return libInStepRange(val, start, end, step), nil
+}
+
+// libInRange is inRange (validator.go :62-99).
+func libInRange(val int, s string, bnds []int, isWeekDay bool) (bool, error) {
+	parts := strings.Split(s, "-")
+	start, err := strconv.Atoi(parts[0])
+	if err != nil {
+		return false, err
+	}
+	end, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return false, err
+	}
+	if start < bnds[0] || start > bnds[1] || end < bnds[0] || end > bnds[1] {
+		return false, fmt.Errorf("range '%s' out of bounds(%d, %d)", s, bnds[0], bnds[1])
+	}
+	if isWeekDay {
+		if start == 7 && end != 7 {
+			start = 0
+		}
+		if end == 7 && val == 0 {
+			val = 7
+		}
+	}
+	if end < start {
+		return false, fmt.Errorf("range '%s' out of bounds(%d, %d)", s, bnds[0], bnds[1])
+	}
+	return start <= val && val <= end, nil
+}
+
+// libInStepRange is inStepRange (validator.go :101-108).
+func libInStepRange(val, start, end, step int) bool {
+	for i := start; i <= end && i <= val; i += step {
+		if i == val {
+			return true
+		}
+	}
+	return false
+}
+
+// libMonthDay is isValidMonthDay (validator.go :110-145).
+func libMonthDay(val string, last int, ref time.Time) (valid bool, err error) {
+	day, loc := ref.Day(), ref.Location()
+	if val == "L" {
+		return day == last, nil
+	}
+	pos := strings.Index(val, "W")
+	if pos < 1 {
+		return false, errors.New("invalid offset value: " + val)
+	}
+	nval, err := strconv.Atoi(val[0:pos])
+	if err != nil {
+		return false, err
+	}
+	if nval > last {
+		return false, nil
+	}
+	for _, i := range []int{0, -1, 1, -2, 2} {
+		incr := i + nval
+		if incr > 0 && incr <= last {
+			iref := time.Date(ref.Year(), ref.Month(), incr, ref.Hour(), ref.Minute(), ref.Second(), 0, loc)
+			week := int(iref.Weekday())
+			if week > 0 && week < 6 && iref.Month() == ref.Month() {
+				valid = day == iref.Day()
+				break
+			}
+		}
+	}
+	return valid, nil
+}
+
+// libWeekDay is isValidWeekDay (validator.go :147-186).
+func libWeekDay(val string, last int, ref time.Time) (bool, error) {
+	loc := ref.Location()
+	if pos := strings.Index(val, "L"); pos > 0 {
+		nval, err := strconv.Atoi(val[0:pos])
+		if err != nil {
+			return false, err
+		}
+		for i := 0; i < 7; i++ {
+			day := last - i
+			dref := time.Date(ref.Year(), ref.Month(), day, ref.Hour(), ref.Minute(), ref.Second(), 0, loc)
+			if int(dref.Weekday()) == nval%7 {
+				return ref.Day() == day, nil
+			}
+		}
+	}
+	pos := strings.Index(val, "#")
+	parts := strings.Split(strings.ReplaceAll(val, "7#", "0#"), "#")
+	if pos < 1 || len(parts) < 2 {
+		return false, errors.New("invalid offset value: " + val)
+	}
+	day, err := strconv.Atoi(parts[0])
+	if err != nil {
+		return false, err
+	}
+	nth, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return false, err
+	}
+	if day < 0 || day > 7 || nth < 1 || nth > 5 || int(ref.Weekday()) != day {
+		return false, nil
+	}
+	return (ref.Day()-1)/7 == nth-1, nil
+}
+
+// libBatchEntry is BatchDue's check of one expression (batch.go :39-47) over its segments:
+// every segment in order, * and ? skipped, stopping at the first not due or in error.
+func libBatchEntry(segs []string, ref time.Time, bad overlay) (bool, error) {
+	due := true
+	var err error
+	for pos, seg := range segs {
+		if seg != "*" && seg != "?" {
+			if due, err = libCheckDue(seg, pos, ref, bad); !due || err != nil {
+				break
+			}
+		}
+	}
+	return due, err
+}
+
+// libUnreachableYear is isUnreachableYear (next.go :126-144): the segment is unreachable
+// when every number of every item, the "/..." part stripped (dashRe :124), lies before the
+// reference year (after it, in reverse); "*/" and "0/" items make it reachable.
+func libUnreachableYear(year string, ref time.Time, reverse bool) bool {
+	if year == "*" || year == "?" {
+		return false
+	}
+	edge := ref.Year()
+	for _, offset := range strings.Split(year, ",") {
+		if strings.Index(offset, "*/") == 0 || strings.Index(offset, "0/") == 0 {
+			return false
+		}
+		for _, part := range strings.Split(libDashRe.ReplaceAllString(offset, ""), "-") {
+			val, err := strconv.Atoi(part)
+			if err != nil || (!reverse && val >= edge) || (reverse && val <= edge) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// libNext is NextTickAfter (next.go :24-42): IsDue at start (an error, or due with
+// inclRefTime: start itself is returned), the unreachable-year check on the truncated start,
+// loop, and the "superfluous" error cleared when the result is due.
+func libNext(segs []string, start time.Time, incl bool, bad overlay, tr *libTrace) (time.Time, error) {
+	next := start.Truncate(time.Second)
+	due, err := libSegmentsDue(segs, start, bad)
+	if err != nil || (due && incl) {
+		return start, err
+	}
+	if len(segs) > 6 && libUnreachableYear(segs[6], next, false) {
+		return next, fmt.Errorf("unreachable year segment: %s", segs[6])
+	}
+	next, err = libLoop(segs, next, incl, false, bad, tr)
+	if err != nil {
+		if d, e := libSegmentsDue(segs, next, bad); e == nil && d {
+			err = nil
+		}
+	}
+	return next, err
+}
+
+// libPrev is PrevTickBefore (prev.go :14-32): as libNext in reverse, the truncated prev
+// returned with inclRefTime.
+func libPrev(segs []string, start time.Time, incl bool, bad overlay, tr *libTrace) (time.Time, error) {
+	prev := start.Truncate(time.Second)
+	due, err := libSegmentsDue(segs, start, bad)
+	if err != nil || (due && incl) {
+		return prev, err
+	}
+	if len(segs) > 6 && libUnreachableYear(segs[6], prev, true) {
+		return prev, fmt.Errorf("unreachable year segment: %s", segs[6])
+	}
+	prev, err = libLoop(segs, prev, incl, true, bad, tr)
+	if err != nil {
+		if d, e := libSegmentsDue(segs, prev, bad); e == nil && d {
+			err = nil
+		}
+	}
+	return prev, err
+}
+
+// libLoop is loop (next.go :44-122): 500 iterations, each walking the segments from the
+// last, bumping the candidate until the segment is due (bumpUntilDue) and starting over
+// after a bump; the weekday segment bumped together with the day-of-month under the union,
+// the closer of the two kept; a candidate equal to the start by wall-clock text is moved a
+// second when the start is excluded.
+func libLoop(segments []string, start time.Time, incl bool, reverse bool, bad overlay, tr *libTrace) (next time.Time, err error) {
+	iter, next, bumped := 500, start, false
+	var last time.Time
+	stuck := false
+over:
+	for iter > 0 {
+		iter--
+		// (the shortcut: an iteration that starts where the previous one started repeats it
+		// exactly, so the loop ends as it would after its 500: "tried so hard"; the bumps that
+		// make no progress, a missing midnight, are what gets here)
+		if stuck && next.Equal(last) {
+			break
+		}
+		last, stuck = next, true
+		skipMonthDayForIter := false
+		for i := 0; i < len(segments); i++ {
+			pos := len(segments) - 1 - i
+			seg := segments[pos]
+			isMonthDay, isWeekday := pos == 3, pos == 5
+			if seg == "*" || seg == "?" {
+				continue
+			}
+			if !isWeekday {
+				if isMonthDay && skipMonthDayForIter {
+					continue
+				}
+				if next, bumped, err = libBumpUntilDue(seg, pos, next, reverse, bad, tr); bumped {
+					goto over
+				}
+				continue
+			}
+			monthDaySeg := segments[3]
+			intersect := strings.Index(seg, "*/") == 0 || strings.Index(monthDaySeg, "*") == 0 || monthDaySeg == "?"
+			nextForWeekDay := next
+			nextForWeekDay, bumped, err = libBumpUntilDue(seg, pos, nextForWeekDay, reverse, bad, tr)
+			if !bumped {
+				next = nextForWeekDay
+				if !intersect {
+					skipMonthDayForIter = true
+				}
+				continue
+			}
+			if intersect {
+				next = nextForWeekDay
+				goto over
+			}
+			nextForMonthDay := next
+			nextForMonthDay, bumped, err = libBumpUntilDue(monthDaySeg, 3, nextForMonthDay, reverse, bad, tr)
+			monthDayIsClosestToNextThanWeekDay := reverse && nextForMonthDay.After(nextForWeekDay) ||
+				!reverse && nextForMonthDay.Before(nextForWeekDay)
+			if monthDayIsClosestToNextThanWeekDay {
+				next = nextForMonthDay
+				if !bumped {
+					skipMonthDayForIter = true
+					continue
+				}
+			} else {
+				next = nextForWeekDay
+			}
+			goto over
+		}
+		if !incl && next.Format(gronx.FullDateFormat) == start.Format(gronx.FullDateFormat) {
+			delta := time.Second
+			if reverse {
+				delta = -time.Second
+			}
+			next = next.Add(delta)
+			continue
+		}
+		return
+	}
+	return start, errors.New("tried so hard")
+}
+
+// libLimit is limit (next.go :150).
+var libLimit = map[int]int{0: 60, 1: 60, 2: 24, 3: 62, 4: 12, 5: 366, 6: 100}
+
+// libBumpUntilDue is bumpUntilDue (next.go :152-169): the candidate bumped at the segment's
+// unit until the segment is due, at most the limit times (an error of CheckDue is ignored).
+func libBumpUntilDue(segment string, pos int, ref time.Time, reverse bool, bad overlay, tr *libTrace) (time.Time, bool, error) {
+	iter := libLimit[pos]
+	for iter > 0 {
+		if ok, _ := libCheckDue(segment, pos, ref, bad); ok {
+			return ref, iter != libLimit[pos], nil
+		}
+		was := ref
+		if reverse {
+			ref = libBumpReverse(ref, pos, tr)
+		} else {
+			ref = libBump(ref, pos, tr)
+		}
+		iter--
+		if ref.Equal(was) {
+			// (the shortcut: a bump that makes no progress, a day whose midnight time.Date
+			// normalises into the evening before, repeats until the limit)
+			break
+		}
+	}
+	return ref, true, errors.New("tried so hard")
+}
+
+// dated is time.Date with the trace: the wall clock it produced is recorded when it is
+// ambiguous (the zone reads it twice) and when it is not the one asked for (a gap: at
+// midnight, gronx/10's ingredient; at another hour, counted apart).
+func dated(tr *libTrace, y int, m time.Month, d, h, mi, s int, loc *time.Location) time.Time {
+	t := time.Date(y, m, d, h, mi, s, 0, loc)
+	if tr != nil {
+		if ambiguous(t) {
+			tr.ambiguous++
+		}
+		if th, tm, ts := t.Clock(); th != h || tm != mi || ts != s || t.Day() != d {
+			if h == 0 && mi == 0 && s == 0 {
+				tr.midnightGap++
+			} else {
+				tr.otherGap++
+			}
+		}
+	}
+	return t
+}
+
+// ambiguous: the wall clock of x occurs twice (a fall-back transition), i.e. another instant
+// an hour or half an hour away reads the same.
+func ambiguous(x time.Time) bool {
+	for _, delta := range []time.Duration{time.Hour, -time.Hour, 30 * time.Minute, -30 * time.Minute} {
+		o := x.Add(delta)
+		if o.Year() == x.Year() && o.YearDay() == x.YearDay() && o.Hour() == x.Hour() && o.Minute() == x.Minute() && o.Second() == x.Second() {
+			return true
+		}
+	}
+	return false
+}
+
+// libBump is bump (next.go :171-202).
+func libBump(ref time.Time, pos int, tr *libTrace) time.Time {
+	loc := ref.Location()
+	switch pos {
+	case 0:
+		ref = ref.Add(time.Second)
+	case 1:
+		minTime := ref.Add(time.Minute)
+		next := dated(tr, minTime.Year(), minTime.Month(), minTime.Day(), minTime.Hour(), minTime.Minute(), 0, loc)
+		if !next.After(ref) {
+			next = next.Add(time.Hour)
+		}
+		ref = next
+	case 2:
+		hTime := ref.Add(time.Hour)
+		if tr != nil && hTime.Hour() == (ref.Hour()+2)%24 {
+			tr.hourSkipped++
+		}
+		next := dated(tr, hTime.Year(), hTime.Month(), hTime.Day(), hTime.Hour(), 0, 0, loc)
+		if !next.After(ref) {
+			next = next.Add(time.Hour)
+		}
+		ref = next
+	case 3, 5:
+		dTime := ref.AddDate(0, 0, 1)
+		ref = dated(tr, dTime.Year(), dTime.Month(), dTime.Day(), 0, 0, 0, loc)
+	case 4:
+		ref = dated(tr, ref.Year(), ref.Month(), 1, 0, 0, 0, loc)
+		ref = ref.AddDate(0, 1, 0)
+	case 6:
+		yTime := ref.AddDate(1, 0, 0)
+		ref = dated(tr, yTime.Year(), 1, 1, 0, 0, 0, loc)
+	}
+	return ref
+}
+
+// libBumpReverse is bumpReverse (prev.go :34-57).
+func libBumpReverse(ref time.Time, pos int, tr *libTrace) time.Time {
+	loc := ref.Location()
+	switch pos {
+	case 0:
+		ref = ref.Add(-time.Second)
+	case 1:
+		minTime := ref.Add(-time.Minute)
+		ref = dated(tr, minTime.Year(), minTime.Month(), minTime.Day(), minTime.Hour(), minTime.Minute(), 59, loc)
+	case 2:
+		hTime := ref.Add(-time.Hour)
+		if tr != nil && hTime.Hour() == (ref.Hour()+22)%24 {
+			tr.hourSkipped++
+		}
+		ref = dated(tr, hTime.Year(), hTime.Month(), hTime.Day(), hTime.Hour(), 59, 59, loc)
+	case 3, 5:
+		dTime := ref.AddDate(0, 0, -1)
+		ref = dated(tr, dTime.Year(), dTime.Month(), dTime.Day(), 23, 59, 59, loc)
+	case 4:
+		ref = dated(tr, ref.Year(), ref.Month(), 1, 0, 0, 0, loc)
+		ref = ref.Add(-time.Second)
+	case 6:
+		yTime := ref.AddDate(-1, 0, 0)
+		ref = dated(tr, yTime.Year(), 12, 31, 23, 59, 59, loc)
+	}
+	return ref
+}
+
+// --------------------------------------------------------------------------- the checker's
+// reference
+
+// hzStart is the reference of gronx's package-level validity checker (gronx.go :167 captures
+// time.Now() at gronx's package init): time.Now() at this package's init, some milliseconds
+// later, corrected to the second gronx's checker reads by asking IsValid about each field:
+// IsValid("S,99 * * * * *") is true exactly when S is the checker's second (99 is reached
+// and refused unless S is due, gronx/2), and so for the other fields. The replica of
+// gronx/2's IsValid walk is then exact; hzStartDrift is the correction's size in seconds
+// (zero when time.Now() read the same second).
+var hzStart, hzStartDrift = calibrateStart()
+
+func calibrateStart() (time.Time, int) {
+	now := time.Now()
+	find := func(lo, hi int, form func(int) string) int {
+		for v := lo; v <= hi; v++ {
+			if gronx.IsValid(form(v)) {
+				return v
+			}
+		}
+		return -1
+	}
+	sec := find(0, 59, func(v int) string { return fmt.Sprintf("%d,99 * * * * *", v) })
+	min := find(0, 59, func(v int) string { return fmt.Sprintf("* %d,99 * * * *", v) })
+	hour := find(0, 23, func(v int) string { return fmt.Sprintf("* * %d,99 * * *", v) })
+	day := find(1, 31, func(v int) string { return fmt.Sprintf("* * * %d,99 * *", v) })
+	month := find(1, 12, func(v int) string { return fmt.Sprintf("* * * * %d,99 *", v) })
+	year := find(now.Year()-1, now.Year()+1, func(v int) string { return fmt.Sprintf("* * * * * * %d,99999", v) })
+	if sec < 0 || min < 0 || hour < 0 || day < 0 || month < 0 || year < 0 {
+		return now, 0
+	}
+	t := time.Date(year, time.Month(month), day, hour, min, sec, 0, time.Local)
+	return t, int(t.Sub(now.Truncate(time.Second)) / time.Second)
+}
+
+// --------------------------------------------------------------------------- the checks
+
+func init() {
+	for i, name := range []string{"valid", "due error", "count valid", "count error", "segments", "due", "croniter",
+		"next", "prev", "croniter next", "croniter prev", "addtag", "readd"} {
+		checkRank[name] = i
+	}
+}
+
+// tickValue spells a tick: the instant (with its fraction, if any) and the zone it came
+// back in; errValue an error.
+func tickValue(t time.Time) string {
+	return t.Format(time.RFC3339Nano) + " " + t.Location().String()
+}
+
+const errValue = "error"
+
+// dueValue spells IsDue's answer.
+func dueValue(due bool, err bool) string {
+	if err {
+		return errValue
+	}
+	return strconv.FormatBool(due)
+}
+
+// --------------------------------------------------------------------------- the common
+// pieces of the expected functions
+
+// readingOf is the expression's view under the switch set: nonsense read as gronx does
+// under kNonsenseAccepted (gronx/3), rejected otherwise.
+func readingOf(e *expr, k known) view {
+	return view{e: e, nonsenseOK: k[kNonsenseAccepted], lenient: k[kExtraPartsIgnored]}
+}
+
+// isDueOutcome is IsDue(expr, ref) under the switch set: an error for an expression with a
+// trailing newline under kNewlineInvalid (gronx/4: the empty last segment is walked first);
+// for an expression with an invalid item, an error (documented) or, under kErrorsDependOnRef
+// (gronx/2), the replica's walk from the last segment, an error only when it reaches the
+// item; else the model's due.
+func isDueOutcome(e *expr, ref time.Time, k known) (due bool, err bool) {
+	v := readingOf(e, k)
+	if e.newline && k[kNewlineInvalid] {
+		return false, true
+	}
+	if v.hasBad() {
+		if !k[kErrorsDependOnRef] {
+			return false, true
+		}
+		d, er := libSegmentsDue(e.docSegments(), ref, v.badAt)
+		return d, er != nil
+	}
+	return v.due(ref), false
+}
+
+// isValidOutcome is IsValid(expr) under the switch set: false with a trailing newline under
+// kNewlineInvalid; for an expression with an invalid item false (documented) or, under
+// kErrorsDependOnRef, the replica's forward walk at the checker's reference (gronx/2: false
+// only when it reaches the item); else isSyntaxValid's verdict (true for every item of the
+// grammar; under kExtraPartsIgnored an item with extra parts is no longer invalid, and the
+// verdict is false exactly on the extra "/" parts, gronx/12).
+func isValidOutcome(e *expr, k known) bool {
+	v := readingOf(e, k)
+	if e.newline && k[kNewlineInvalid] {
+		return false
+	}
+	if v.hasBad() {
+		if !k[kErrorsDependOnRef] {
+			return false
+		}
+		return libIsValid(e.docSegments(), hzStart, v.badAt)
+	}
+	return libSyntaxValid(e.docSegments())
+}
+
+// --------------------------------------------------------------------------- validity
+
+// validityExpected: "valid" IsValid's answer, "due error" whether IsDue errors at the
+// reference, and for a case with a wrong segment count drawn, "count valid" (false) and
+// "count error" (true), which no switch changes.
+func validityExpected(c validityCase, k known) checks {
+	out := checks{}
+	out.set("valid", isValidOutcome(c.e, k))
+	_, err := isDueOutcome(c.e, c.ref, k)
+	out.set("due error", err)
+	if c.count != countNone {
+		out.set("count valid", false)
+		out.set("count error", true)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- segments
+
+// segmentsExpected: "segments" the normalised segments joined with spaces (a 0 second
+// prepended to five and to six with a year, names replaced, whitespace collapsed, tags
+// expanded) or "error"; under kNewlineInvalid a trailing newline leaves an empty last
+// segment (gronx/4: the replica's Segments on the text).
+func segmentsExpected(c segmentsCase, k known) checks {
+	out := checks{}
+	if c.e.newline && k[kNewlineInvalid] {
+		segs, ok := libSegments(c.e.text)
+		if !ok {
+			out.set("segments", errValue)
+		} else {
+			out.set("segments", strings.Join(segs, " "))
+		}
+		return out
+	}
+	out.set("segments", c.e.normalised())
+	return out
+}
+
+// --------------------------------------------------------------------------- due
+
+// dueExpected: "due" IsDue's answer ("error", "true", "false") at the reference; on the
+// croniter subset "croniter", croniter's match, whose expected value is the documented
+// model's answer whatever the switches say (croniter is the model's second voice, not the
+// library's).
+func dueExpected(c dueCase, k known) checks {
+	out := checks{}
+	due, err := isDueOutcome(c.e, c.ref, k)
+	out.set("due", dueValue(due, err))
+	if croniterCompatible(c.e) {
+		out.set("croniter", c.e.view(false).due(c.ref))
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- ticks
+
+// tickFacts is the model's ticks for a reference and inclusion, computed once per case by
+// the generator (the model is pure; the classifier's many runs then compose them): per
+// reading (the documented one, and gronx/3's for a nonsense expression) the next and
+// previous due instants.
+type tickFacts struct {
+	// by reading: bit 0 nonsense read as gronx does (gronx/3), bit 1 extra parts ignored
+	// (gronx/12); 0 is the documented reading
+	next, prev     [4]time.Time
+	okNext, okPrev [4]bool
+}
+
+func tickFactsOf(e *expr, ref time.Time, incl bool) tickFacts {
+	var f tickFacts
+	nonsense, extra := e.nonsense(), e.hasExtra()
+	for r := 0; r < 4; r++ {
+		n, l := r&1 == 1, r&2 == 2
+		switch {
+		case n && !nonsense:
+			f.next[r], f.okNext[r], f.prev[r], f.okPrev[r] = f.next[r-1], f.okNext[r-1], f.prev[r-1], f.okPrev[r-1]
+		case l && !extra:
+			f.next[r], f.okNext[r], f.prev[r], f.okPrev[r] = f.next[r-2], f.okNext[r-2], f.prev[r-2], f.okPrev[r-2]
+		default:
+			v := view{e: e, nonsenseOK: n, lenient: l}
+			f.next[r], f.okNext[r] = v.tickAfter(ref, incl)
+			f.prev[r], f.okPrev[r] = v.tickBefore(ref, incl)
+		}
+	}
+	return f
+}
+
+func (f tickFacts) reading(k known) int {
+	r := 0
+	if k[kNonsenseAccepted] {
+		r |= 1
+	}
+	if k[kExtraPartsIgnored] {
+		r |= 2
+	}
+	return r
+}
+
+// ticksExpected: "next" and "prev" NextTickAfter's and PrevTickBefore's answers (the instant
+// with its zone, or "error"), with and without the reference; on the croniter subset, when
+// the reference is excluded and the model's tick lies within croniter's reach, "croniter
+// next" and "croniter prev", croniter's answers in Unix seconds, expected to be the
+// documented model's. The switches: gronx/3 (the nonsense reading), gronx/12 (the lenient
+// reading of an item with extra parts), gronx/2 (an unreached invalid item: the ticks of the
+// expression with the item matching nothing), gronx/4 (an error), gronx/6 (the reference
+// returned with its fraction when due and included), gronx/7 (the unreachable-year error on
+// a stepped year), gronx/11 (the reference returned when it is due, excluded and the only
+// tick).
+func ticksExpected(c ticksCase, k known) checks {
+	out := checks{}
+	trunc := c.ref.Truncate(time.Second)
+	due, err := isDueOutcome(c.e, c.ref, k)
+	r := c.facts.reading(k)
+	next, prev := errValue, errValue
+	switch {
+	case err:
+	case due && c.incl:
+		// next.go :27-28, prev.go :17-18
+		next, prev = tickValue(trunc), tickValue(trunc)
+		if k[kInclKeepsFraction] && c.ref.Nanosecond() != 0 {
+			next = tickValue(c.ref)
+		}
+	default:
+		yearSeg := c.e.segs[pYear].text
+		switch {
+		case k[kSteppedYearUnreachable] && c.e.restricted(pYear) && libUnreachableYear(yearSeg, trunc, false):
+			// next.go :32-34
+		case c.facts.okNext[r]:
+			next = tickValue(c.facts.next[r])
+		case k[kLastTickIsTheReference] && !c.incl && due:
+			// next.go :37-40
+			next = tickValue(trunc)
+		}
+		switch {
+		case k[kSteppedYearUnreachable] && c.e.restricted(pYear) && libUnreachableYear(yearSeg, trunc, true):
+			// prev.go :22-24 (never a difference: a stepped year reaches only later years)
+		case c.facts.okPrev[r]:
+			prev = tickValue(c.facts.prev[r])
+		case k[kLastTickIsTheReference] && !c.incl && due:
+			// prev.go :27-30
+			prev = tickValue(trunc)
+		}
+	}
+	out.set("next", next)
+	out.set("prev", prev)
+	if croniterCompatible(c.e) && !c.incl {
+		if c.facts.okNext[0] && c.facts.next[0].Year() < c.ref.Year()+45 {
+			out.set("croniter next", c.facts.next[0].Unix())
+		}
+		if c.facts.okPrev[0] && c.facts.prev[0].Year() > c.ref.Year()-45 && c.facts.prev[0].Year() >= 1970 {
+			out.set("croniter prev", c.facts.prev[0].Unix())
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- DST
+
+// dstFacts is the model's ticks in a zone with daylight saving and the replica's search
+// with its trace, computed once per case by the generator.
+type dstFacts struct {
+	next, prev     time.Time
+	okNext, okPrev bool
+	libNext        time.Time
+	libNextErr     bool
+	nextTrace      libTrace
+	libPrev        time.Time
+	libPrevErr     bool
+	prevTrace      libTrace
+}
+
+// halfHourGap is gronx/13's ingredient: the search stepped over a wall-clock hour with an
+// hour bump and met no repeated hour and no missing midnight (those are gronx/9's and
+// gronx/10's). At Australia/Lord_Howe's spring-forward the clocks go from 02:00 +10:30 to
+// 02:30 +11, so hour 2 exists from 02:30: the hour bump (next.go :184-190) adds an hour to
+// a reference in 01:30-01:59 +10:30 and lands in 03:00-03:29 +11, hour 3, and the search for
+// an hour segment "2" runs to the next day (NextTickAfter("2 * 2 * * *", 2029-10-07
+// 01:35:47 +10:30) is the next day's 02:00:02 +11 while 02:30:02 +11 of the 7th is due; so
+// are "30 2 * * *" and "45 2 * * *", since the walk from the last segment bumps the hour
+// before the minute; from 01:00-01:29 an hour later is 02:30-02:59 +11 and the search is
+// right). Backwards
+// (prev.go :43-45) an hour before a reference in 03:00-03:29 +11 is a wall clock in the gap,
+// 02:00-02:29, whose instant is in hour 1 +10:30: PrevTickBefore("* 2 * * *", 2029-10-07
+// 03:02:01 +11) is the day before's 02:59:00 +10:30; from 03:30 +11 on the hour before is
+// 02:30-02:59 +11 and the search is right. The minute bump (next.go :178-183) reaches the
+// half hour: from 01:59 +10:30 it builds 02:00 with time.Date, which normalises into 02:30
+// +11, so a search whose hour segment is "*" ("45 * * * *" from 01:50 +10:30 gives 02:45
+// +11) comes back right.
+func (tr libTrace) halfHourGap() bool {
+	return tr.hourSkipped > 0 && tr.ambiguous == 0 && tr.midnightGap == 0
+}
+
+func dstFactsOf(e *expr, ref time.Time) dstFacts {
+	var f dstFacts
+	v := e.view(false)
+	f.next, f.okNext = v.tickAfter(ref, false)
+	f.prev, f.okPrev = v.tickBefore(ref, false)
+	if !v.hasBad() {
+		segs := e.docSegments()
+		var err error
+		f.libNext, err = libNext(segs, ref, false, nil, &f.nextTrace)
+		f.libNextErr = err != nil
+		f.libPrev, err = libPrev(segs, ref, false, nil, &f.prevTrace)
+		f.libPrevErr = err != nil
+	}
+	return f
+}
+
+// dstExpected: "next" and "prev", the exact model's instants in the zone (or "error"),
+// the reference excluded. The switches: gronx/4 (an error on a newline), gronx/11 (the
+// reference returned when due and the only tick), and gronx/9 and gronx/10: the replica's
+// search (loop, bump, bumpReverse transcribed, run in the zone) gives the library's answer
+// when its time.Date calls landed on an ambiguous wall clock (9) or on a day without the
+// midnight asked for (10); each switch alone takes the search's answer on its ingredient, so
+// a search with both is named 9; and gronx/13: the search's answer when an hour bump stepped
+// over a wall-clock hour and neither of those ingredients was met (libTrace.halfHourGap).
+func dstExpected(c dstCase, k known) checks {
+	out := checks{}
+	due, err := isDueOutcome(c.e, c.ref, k)
+	trunc := c.ref.Truncate(time.Second)
+	next, prev := errValue, errValue
+	if !err {
+		f := c.facts
+		if f.okNext {
+			next = tickValue(f.next)
+		} else if k[kLastTickIsTheReference] && due {
+			next = tickValue(trunc)
+		}
+		if f.okPrev {
+			prev = tickValue(f.prev)
+		} else if k[kLastTickIsTheReference] && due {
+			prev = tickValue(trunc)
+		}
+		if (k[kFallBackSkipsTicks] && f.nextTrace.ambiguous > 0) || (k[kMidnightGapGivesUp] && f.nextTrace.midnightGap > 0) ||
+			(k[kHalfHourGapSkipped] && f.nextTrace.halfHourGap()) {
+			next = errValue
+			if !f.libNextErr {
+				next = tickValue(f.libNext)
+			}
+		}
+		if (k[kFallBackSkipsTicks] && f.prevTrace.ambiguous > 0) || (k[kMidnightGapGivesUp] && f.prevTrace.midnightGap > 0) ||
+			(k[kHalfHourGapSkipped] && f.prevTrace.halfHourGap()) {
+			prev = errValue
+			if !f.libPrevErr {
+				prev = tickValue(f.libPrev)
+			}
+		}
+	}
+	out.set("next", next)
+	out.set("prev", prev)
+	return out
+}
+
+// --------------------------------------------------------------------------- batch
+
+// batchExpected: per entry i, "expr i" the text carried back and "batch i" BatchDue's
+// answer ("error", "true", "false"): the documented one is IsDue's. The switches: gronx/1
+// (BatchDue's loop intersects the two day segments where IsDue unions them), gronx/2 (an
+// invalid item is an error only when the loop, the segments in order stopping at the first
+// not due, reaches it; the Due of such an entry is then the loop's), gronx/3 (nonsense
+// read as gronx does), gronx/4 (a trailing newline: the replica's segments, with the empty
+// last one, which the loop reaches only when the segments before it are due).
+func batchExpected(c batchCase, k known) checks {
+	out := checks{}
+	for i, e := range c.exprs() {
+		out.set(fmt.Sprintf("expr %d", i), e.text)
+		v := readingOf(e, k)
+		newline := e.newline && k[kNewlineInvalid]
+		segs, ok := e.docSegments(), true
+		if newline {
+			segs, ok = libSegments(e.text)
+		}
+		value := errValue
+		switch {
+		case !ok:
+		case v.hasBad() || newline:
+			if k[kErrorsDependOnRef] {
+				bad := v.badAt
+				if newline {
+					bad = shiftedOverlay(e, v, segs)
+				}
+				due, err := libBatchEntry(segs, c.ref, bad)
+				switch {
+				case err != nil:
+				case k[kBatchIgnoresUnion]:
+					value = strconv.FormatBool(due)
+				default:
+					value = strconv.FormatBool(v.due(c.ref))
+				}
+			}
+		case k[kBatchIgnoresUnion]:
+			value = strconv.FormatBool(v.dueIntersect(c.ref))
+		default:
+			value = strconv.FormatBool(v.due(c.ref))
+		}
+		out.set(fmt.Sprintf("batch %d", i), value)
+	}
+	return out
+}
+
+// shiftedOverlay is the overlay for the replica's segments of an expression with a trailing
+// newline (gronx/4): the empty last segment is bad, and the model's items keep their badness
+// where their positions are unchanged (a sixth or seventh segment written: the empty segment
+// is a year, or one too many). When no second was prepended because the empty segment took
+// the year's place, the items stand one position to the left and the replica's checker
+// reads them there as the library does (a month "15" is a fine day of month, a weekday
+// "3#2" an unparsable month): the model's badness is of the written position.
+func shiftedOverlay(e *expr, v view, segs []string) overlay {
+	shifted := e.written == 5 || e.yearForm
+	return func(pos, idx int) bool {
+		if pos < len(segs) && segs[pos] == "" {
+			return true
+		}
+		return !shifted && v.badAt(pos, idx)
+	}
+}
+
+// --------------------------------------------------------------------------- tags
+
+// tagsExpected: "addtag" AddTag's answer ("ok", "error"), "readd" a second AddTag's,
+// "valid" IsValid of the tag, "segments" Segments of the tag, "due" IsDue of the tag at the
+// reference, and for a valid expression without a year "next" NextTickAfter of the tag with
+// the reference excluded. The documented values are the expression's (an invalid expression
+// is refused and no tag exists). The switches: gronx/8 (an invalid expression is registered:
+// the tag then answers as the expression does), gronx/5 (a name with a capital is never
+// found: the segment-count error), gronx/2 (the registered invalid expression's answers
+// depend on the walk), gronx/3.
+func tagsExpected(c tagsCase, k known) checks {
+	out := checks{}
+	v := readingOf(c.e, k)
+	bad := v.hasBad()
+	if bad && !k[kAddTagUnchecked] {
+		out.set("addtag", errValue)
+		out.set("readd", errValue)
+		out.set("valid", false)
+		out.set("segments", errValue)
+		out.set("due", errValue)
+		return out
+	}
+	out.set("addtag", "ok")
+	out.set("readd", errValue)
+	// (the tick is asked of an expression of the grammar: not of a registered invalid one,
+	// nor of one gronx reads leniently)
+	tickWanted := c.e.valid() && !c.e.restricted(pYear)
+	if c.hasUpper() && k[kTagCaseUnusable] {
+		out.set("valid", false)
+		out.set("segments", errValue)
+		out.set("due", errValue)
+		if tickWanted {
+			out.set("next", errValue)
+		}
+		return out
+	}
+	out.set("valid", isValidOutcome(c.e, k))
+	out.set("segments", c.e.normalised())
+	due, err := isDueOutcome(c.e, c.ref, k)
+	out.set("due", dueValue(due, err))
+	if tickWanted {
+		next := errValue
+		if c.facts.okNext[0] {
+			next = tickValue(c.facts.next[0])
+		}
+		out.set("next", next)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- croniter
+// subset
+
+// croniterCompatible: the shapes both libraries read the same way (a pure function of the
+// expression). Out: invalid and nonsense expressions, "?" (croniter reads it as the
+// reference's day), 7 as a weekday (refused in lists and in the six-segment form), ranges
+// via 7 and steps from 7, "0/s" below the day and month bounds, W beyond the 28th or in a
+// list or beside a weekday, n#k beside literals or a day-of-month (croniter intersects,
+// gronx unions), gronx's intersect rule for a stepped day-of-month against a weekday
+// (croniter unions), last-weekday items (croniter writes them the other way round),
+// single-value ranges ("16-16", which croniter misreads), open steps "N/S" (croniter wraps
+// them: "12/1" fires in January), year steps (counted from 1970 by croniter), years outside
+// 1970..2099.
+func croniterCompatible(e *expr) bool {
+	if !e.valid() || e.nonsense() {
+		return false
+	}
+	for pos, sg := range e.segs {
+		if sg.text == "?" {
+			return false // croniter reads ? as the day of the reference
+		}
+		if sg.star {
+			continue
+		}
+		for _, it := range sg.items {
+			switch it.kind {
+			case "dowL":
+				return false
+			case "hash":
+				if len(sg.items) > 1 || e.restricted(pDom) || it.a == 7 {
+					return false // croniter: no literals beside n#k, no 7#k, and n#k intersects the day-of-month
+				}
+			case "W":
+				if it.a > 28 || len(sg.items) > 1 || e.restricted(pDow) {
+					return false // croniter takes W only as the whole segment and intersects it with the weekday
+				}
+			case "starstep":
+				if pos == pYear {
+					return false // croniter counts year steps from 1970, gronx from 0
+				}
+			case "range", "rangestep":
+				if pos == pDow && (it.a == 7 || it.b == 7) {
+					return false
+				}
+				if it.a == it.b {
+					return false // croniter misreads "16-16" and "4-4/2"
+				}
+				if pos == pYear && (it.a < 1970 || it.b > 2099) {
+					return false
+				}
+			case "numstep":
+				return false // croniter reads "12/1" and "59/36" as wrapping or open ranges
+			case "num":
+				if pos == pYear && (it.a < 1970 || it.a > 2099) {
+					return false
+				}
+				if pos == pDow && it.a == 7 {
+					return false // croniter refuses 7 in a list and in the six-segment form
+				}
+			}
+		}
+	}
+	if e.restricted(pDom) && e.restricted(pDow) {
+		if e.intersect() {
+			return false
+		}
+		if e.restricted(pYear) {
+			return false // croniter's match and prev lose the union under a year
+		}
+		// croniter's union is lost when a "*/s" item is anywhere in the day of month and the
+		// weekday covers all seven days: match("4 0 4 17-23,*/15 * 0-6", Monday the 5th) is
+		// false, with "0-5" or without the "*/15" true
+		for _, pos := range []int{pDom, pDow} {
+			for _, it := range e.segs[pos].items {
+				if it.kind == "starstep" {
+					return false
+				}
+			}
+		}
+		if len(view{e: e}.values(pDow)) == 7 {
+			return false
+		}
+	}
+	return true
+}
