+// TestHegelIsDueFollowsTheModel: IsDue for valid expressions equals the model at random
+// instants, at instants the model says are due (found by the model's next), and croniter agrees
+// on the shared subset.
+func TestHegelIsDueFollowsTheModel(t *testing.T) {
+	col := newCollector(t)
+	g := gronx.New()
+	property(t, func(ht *hegel.T) {
+		e := genExpr(ht, pick(ht, []string{"valid", "valid", "valid", "tag"}))
+		if !e.valid() || e.nonsense() || (e.newline && Known.newlineInvalid) {
+			return
+		}
+		loc := pick(ht, fixedZones)
+		ref := genInstant(ht, loc, true)
+		// half the time, move to an instant the model says is due, so due cases are common
+		if chance(ht, 50) {
+			if d, ok := e.next(ref, true, ref.Year()+6); ok {
+				ref = d.Add(time.Duration(n(ht, 0, 999)) * time.Millisecond)
+				col.count("at-due")
+			} else {
+				col.count("never-due-nearby")
+			}
+		} else {
+			col.count("random")
+		}
+		want := e.due(ref)
+		got, err := g.IsDue(e.text, ref)
+		if err != nil {
+			col.fail(ht, "IsDue(%q, %v) = %v", e.text, ref, err)
+			return
+		}
+		if got != want {
+			col.fail(ht, "IsDue(%q, %v) = %v; model %v", e.text, ref, got, want)
+		}
+		if croniterCompatible(e) {
+			col.count("croniter")
+			r := croniterMatch(e.normalised(), ref)
+			if !r.Ok {
+				col.fail(ht, "croniter refused %q: %s %s", e.normalised(), r.Error, r.Message)
+			} else if r.Due != want {
+				col.fail(ht, "croniter match(%q, %v) = %v; model %v (gronx %v)", e.normalised(), ref, r.Due, want, got)
+			}
+		}
+	})
+}
