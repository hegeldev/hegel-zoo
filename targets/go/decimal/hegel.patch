+// multiplied by 10^20).
+func TestHegelPowWithPrecisionHonoursThePrecision(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		base := n(ht, 2, 99)
+		k := int(math.Ceil(18/math.Log10(float64(base)))) + n(ht, 0, 3)
+		y, _ := NewFromString(strconv.Itoa(k) + ".5")
+		p := n(ht, 0, 6)
+		x := New(int64(base), 0)
+		got, err := x.PowWithPrecision(y, int32(p))
+		if err != nil {
