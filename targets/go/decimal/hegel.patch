+func withSwitches(trim, sci bool, f func()) {
+	oldTrim, oldSci := TrimTrailingZeros, UseScientificNotation
+	TrimTrailingZeros, UseScientificNotation = trim, sci
+	defer func() { TrimTrailingZeros, UseScientificNotation = oldTrim, oldSci }()
+	f()
+}
