+func TestHegelRoundingAgreesWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDecimal(ht, 25, -30, 15)
+		r := ratOf(d)
+		places := n(ht, -12, 20)
+		switch n(ht, 0, 9) {
+		case 0:
+			sameValue(ht, fmt.Sprintf("Round(%s, %d)", repr(d), places), d.Round(int32(places)), roundTo(r, places, "half_away"))
+		case 1:
+			sameValue(ht, fmt.Sprintf("RoundBank(%s, %d)", repr(d), places), d.RoundBank(int32(places)), roundTo(r, places, "half_even"))
+		case 2:
+			sameValue(ht, fmt.Sprintf("RoundCeil(%s, %d)", repr(d), places), d.RoundCeil(int32(places)), roundTo(r, places, "ceil"))
+			sameValue(ht, fmt.Sprintf("RoundFloor(%s, %d)", repr(d), places), d.RoundFloor(int32(places)), roundTo(r, places, "floor"))
+		case 3:
+			sameValue(ht, fmt.Sprintf("RoundUp(%s, %d)", repr(d), places), d.RoundUp(int32(places)), roundTo(r, places, "up"))
+			sameValue(ht, fmt.Sprintf("RoundDown(%s, %d)", repr(d), places), d.RoundDown(int32(places)), roundTo(r, places, "down"))
+		case 4:
+			if places >= 0 {
+				sameValue(ht, fmt.Sprintf("Truncate(%s, %d)", repr(d), places), d.Truncate(int32(places)), roundTo(r, places, "down"))
+			}
+			sameValue(ht, "Floor "+repr(d), d.Floor(), roundTo(r, 0, "floor"))
+			sameValue(ht, "Ceil "+repr(d), d.Ceil(), roundTo(r, 0, "ceil"))
+		case 5:
+			// RoundCash: to the nearest multiple of the interval in cents, halves away from zero.
+			interval := pick(ht, []uint8{5, 10, 25, 50, 100})
+			k := big.NewRat(100/int64(interval), 1)
+			want := new(big.Rat).SetInt(roundRat(new(big.Rat).Mul(r, k), "half_away"))
+			want.Quo(want, k)
+			got := d.RoundCash(interval)
+			sameValue(ht, fmt.Sprintf("RoundCash(%s, %d)", repr(d), interval), got, want)
+			if s := d.StringFixedCash(interval); s != fixed(want, 2) {
+				ht.Fatalf("StringFixedCash(%s, %d) = %q, want %q", repr(d), interval, s, fixed(want, 2))
+			}
+			if bad := uint8(n(ht, 0, 255)); bad != 5 && bad != 10 && bad != 25 && bad != 50 && bad != 100 {
+				if s := call(func() string { return d.RoundCash(bad).String() }); !strings.HasPrefix(s, "panic:") {
+					ht.Fatalf("RoundCash(%s, %d) = %q, want a panic", repr(d), bad, s)
+				}
+			}
+		case 6:
+			// StringFixed / StringFixedBank: the rounded value with exactly `places` decimals.
+			if s, want := d.StringFixed(int32(places)), fixed(roundTo(r, places, "half_away"), places); s != want {
+				ht.Fatalf("StringFixed(%s, %d) = %q, want %q", repr(d), places, s, want)
+			}
+			if s, want := d.StringFixedBank(int32(places)), fixed(roundTo(r, places, "half_even"), places); s != want {
+				ht.Fatalf("StringFixedBank(%s, %d) = %q, want %q", repr(d), places, s, want)
+			}
+		case 7:
+			// Rounding is idempotent and monotone, and the result lies within one unit.
+			unit := ratPow10(-places)
+			for _, m := range []struct {
+				name string
+				f    func(Decimal, int32) Decimal
+			}{{"Round", Decimal.Round}, {"RoundBank", Decimal.RoundBank}, {"RoundCeil", Decimal.RoundCeil}, {"RoundFloor", Decimal.RoundFloor}, {"RoundUp", Decimal.RoundUp}, {"RoundDown", Decimal.RoundDown}} {
+				once := m.f(d, int32(places))
+				twice := m.f(once, int32(places))
+				if !once.Equal(twice) {
+					ht.Fatalf("%s(%s, %d) is not idempotent: %s then %s", m.name, repr(d), places, repr(once), repr(twice))
+				}
+				diff := new(big.Rat).Sub(ratOf(once), r)
+				if diff.Abs(diff).Cmp(unit) >= 0 {
+					ht.Fatalf("%s(%s, %d) = %s is more than a unit away", m.name, repr(d), places, repr(once))
+				}
+				if scaled := new(big.Rat).Mul(ratOf(once), unit); false && !scaled.IsInt() {
+					ht.Fatalf("unreachable")
+				}
+				if k := new(big.Rat).Mul(ratOf(once), ratPow10(places)); !k.IsInt() {
+					ht.Fatalf("%s(%s, %d) = %s is not a multiple of 10^%d", m.name, repr(d), places, repr(once), -places)
+				}
+			}
+		case 8:
+			// Directed roundings bracket the value; Round and RoundBank pick one of them.
+			lo, hi := d.RoundFloor(int32(places)), d.RoundCeil(int32(places))
+			if lo.GreaterThan(d) || hi.LessThan(d) || lo.GreaterThan(hi) {
+				ht.Fatalf("RoundFloor/RoundCeil(%s, %d) = %s, %s do not bracket it", repr(d), places, repr(lo), repr(hi))
+			}
+			for _, x := range []Decimal{d.Round(int32(places)), d.RoundBank(int32(places)), d.RoundUp(int32(places)), d.RoundDown(int32(places))} {
+				if !x.Equal(lo) && !x.Equal(hi) {
+					ht.Fatalf("rounding %s at %d gave %s, neither %s nor %s", repr(d), places, repr(x), repr(lo), repr(hi))
+				}
+			}
+			if d.RoundUp(int32(places)).Abs().LessThan(d.Abs()) || d.RoundDown(int32(places)).Abs().GreaterThan(d.Abs()) {
+				ht.Fatalf("RoundUp/RoundDown(%s, %d) point the wrong way", repr(d), places)
+			}
+		case 9:
+			// Floor <= d <= Ceil, both integers within one of d; Truncate is towards zero.
+			fl, ce := d.Floor(), d.Ceil()
+			if !fl.IsInteger() || !ce.IsInteger() || fl.GreaterThan(d) || ce.LessThan(d) || ce.Sub(fl).GreaterThan(New(1, 0)) {
+				ht.Fatalf("Floor/Ceil(%s) = %s, %s", repr(d), repr(fl), repr(ce))
+			}
+			if d.IsInteger() != fl.Equal(ce) {
+				ht.Fatalf("IsInteger(%s) = %v but Floor %s, Ceil %s", repr(d), d.IsInteger(), repr(fl), repr(ce))
+			}
+		}
+	})
+}
