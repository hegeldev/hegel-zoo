+// ---------------------------------------------------------------------------------------
+// Trigonometry against the math package (arguments up to 100 in magnitude; larger ones
+// are decimal/5).
+
+func TestHegelTrigAgreesWithMath(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := genDecimal(ht, 8, -8, 2)
+		f := floatOf(x)
+		ht.Assume(math.Abs(f) <= 100)
+		const tol = 1e-12
+		if s := floatOf(x.Sin()); math.Abs(s-math.Sin(f)) > tol {
+			ht.Fatalf("Sin(%s) = %v, math.Sin %v", repr(x), s, math.Sin(f))
+		}
+		if c := floatOf(x.Cos()); math.Abs(c-math.Cos(f)) > tol {
+			ht.Fatalf("Cos(%s) = %v, math.Cos %v", repr(x), c, math.Cos(f))
+		}
+		if cf := math.Cos(f); math.Abs(cf) > 0.05 {
+			tf := math.Tan(f)
+			if tn := floatOf(x.Tan()); math.Abs(tn-tf) > tol*(1+tf*tf) {
+				ht.Fatalf("Tan(%s) = %v, math.Tan %v", repr(x), tn, tf)
+			}
+		}
+		big := genDecimal(ht, 8, -8, 6)
+		if a, fb := floatOf(big.Atan()), floatOf(big); math.Abs(a-math.Atan(fb)) > tol {
+			ht.Fatalf("Atan(%s) = %v, math.Atan %v", repr(big), a, math.Atan(fb))
+		}
+		// Odd/even symmetry and the Pythagorean identity, in the decimal domain.
+		if !x.Sin().Neg().Equal(x.Neg().Sin()) || !x.Cos().Equal(x.Neg().Cos()) {
+			ht.Fatalf("Sin/Cos of %s are not odd/even", repr(x))
+		}
+		one := x.Sin().Mul(x.Sin()).Add(x.Cos().Mul(x.Cos()))
+		if one.Sub(New(1, 0)).Abs().GreaterThan(New(1, -12)) {
+			ht.Fatalf("sin^2 + cos^2 of %s = %s", repr(x), one)
+		}
+	})
+}
