+// ---------------------------------------------------------------------------------------
+// The Python decimal oracle (200 digits) for exp, ln and power.
+
+const pyOracle = `
+import sys, json
+from decimal import Decimal, getcontext
+c = getcontext()
+c.prec = 200
+c.Emax = 999999999
+c.Emin = -999999999
+for line in sys.stdin:
+    q = json.loads(line)
+    a = [Decimal(s) for s in q["args"]]
+    op = q["op"]; r = None; err = None
+    try:
+        if op == "exp": r = a[0].exp()
+        elif op == "ln": r = a[0].ln()
+        elif op == "power": r = a[0] ** a[1]
+        else: err = "unknown op " + op
+    except Exception as e:
+        err = repr(e)
+    print(json.dumps({"result": None if r is None else format(r, "f"), "adjusted": None if r is None else r.adjusted(), "error": err}), flush=True)
+`
+
+type pyReq struct {
+	Op   string   `json:"op"`
+	Args []string `json:"args"`
+}
+
+type pyResp struct {
+	Result   *string `json:"result"`
+	Adjusted *int    `json:"adjusted"`
+	Error    *string `json:"error"`
+}
+
+var (
+	pyOnce sync.Once
+	pyIn   *bufio.Writer
+	pyOut  *bufio.Reader
+	pyErr  error
+	pyMu   sync.Mutex
+)
+
+func python() (*bufio.Writer, *bufio.Reader, error) {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyOracle)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = err
+			return
+		}
+		pyIn, pyOut = bufio.NewWriter(in), bufio.NewReader(out)
+	})
+	return pyIn, pyOut, pyErr
+}
+
+// truth asks Python for op(args) at 200 digits: the value as a big.Rat and its adjusted
+// exponent (the power of ten of the leading digit).
+func truth(op string, args ...string) (*big.Rat, int) {
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	in, out, err := python()
+	if err != nil {
+		panic("python3 oracle: " + err.Error())
+	}
+	b, _ := json.Marshal(pyReq{Op: op, Args: args})
+	in.Write(b)
+	in.WriteByte('\n')
+	if err := in.Flush(); err != nil {
+		panic("python3 oracle write: " + err.Error())
+	}
+	line, err := out.ReadBytes('\n')
+	if err != nil {
+		panic("python3 oracle read: " + err.Error())
+	}
+	var r pyResp
+	if err := json.Unmarshal(line, &r); err != nil {
+		panic("python3 oracle: bad reply " + string(line))
+	}
+	if r.Error != nil {
+		panic("python3 oracle: " + *r.Error)
+	}
+	v, ok := new(big.Rat).SetString(*r.Result)
+	if !ok {
+		panic("python3 oracle: unparsable " + *r.Result)
+	}
+	return v, *r.Adjusted
+}
+
+// withinUnits reports whether got is within tol units of 10^-places of want.
+func withinUnits(got Decimal, want *big.Rat, places int, tol int64) bool {
+	diff := new(big.Rat).Sub(ratOf(got), want)
+	diff.Abs(diff)
+	bound := new(big.Rat).Mul(ratPow10(-places), big.NewRat(tol, 1))
+	return diff.Cmp(bound) <= 0
+}
+
+// floatOf is a float64 near d, for bounding the domains.
+func floatOf(d Decimal) float64 { f, _ := ratOf(d).Float64(); return f }
+
+func TestHegelExpAndLnAgreeWithPythonDecimal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 0, 2) {
+		case 0:
+			// ExpTaylor(p): p digits after the point (2 units of slack: e^230 is off by 1.6).
+			x := genDecimal(ht, 8, -10, 2)
+			ht.Assume(math.Abs(floatOf(x)) <= 100)
+			p := n(ht, -5, 30)
+			got, err := x.ExpTaylor(int32(p))
+			if err != nil {
+				ht.Fatalf("ExpTaylor(%s, %d): %v", repr(x), p, err)
+			}
+			want, _ := truth("exp", x.String())
+			if !withinUnits(got, want, p, 2) {
+				ht.Fatalf("ExpTaylor(%s, %d) = %s, want %s", repr(x), p, got, want.FloatString(p+6))
+			}
+		case 1:
+			// ExpHullAbrham(p): p significant digits, within 1 ulp; positive arguments above
+			// the small-argument shortcut (decimal/1) — negative ones are decimal/2.
+			x := genDecimal(ht, 6, -8, 1)
+			p := n(ht, 1, 25)
+			fx := floatOf(x)
+			ht.Assume(fx > 9*math.Pow(10, -float64(p+1)) && fx <= 100)
+			got, err := x.ExpHullAbrham(uint32(p))
+			if err != nil {
+				ht.Fatalf("ExpHullAbrham(%s, %d): %v", repr(x), p, err)
+			}
+			want, adj := truth("exp", x.String())
+			if !withinUnits(got, want, p-1-adj, 1) {
+				ht.Fatalf("ExpHullAbrham(%s, %d) = %s, want %s (1 ulp = 1E%d)", repr(x), p, got, want.FloatString(p+2-adj), adj-p+1)
+			}
+		case 2:
+			// Ln(p): p digits after the point, within 1 unit.
+			x := genDecimal(ht, 8, -25, 25)
+			ht.Assume(x.Sign() > 0)
+			p := n(ht, -5, 30)
+			got, err := x.Ln(int32(p))
+			if err != nil {
+				ht.Fatalf("Ln(%s, %d): %v", repr(x), p, err)
+			}
+			want, _ := truth("ln", x.String())
+			if !withinUnits(got, want, p, 1) {
+				ht.Fatalf("Ln(%s, %d) = %s, want %s", repr(x), p, got, want.FloatString(p+6))
+			}
+			// Ln of a non-positive number is an error.
+			if _, err := x.Neg().Ln(int32(p)); err == nil {
+				ht.Fatalf("Ln(%s) succeeded", repr(x.Neg()))
+			}
+			if _, err := Zero.Ln(int32(p)); err == nil {
+				ht.Fatalf("Ln(0) succeeded")
+			}
+		}
+	})
+}
+
+func TestHegelFractionalPowersAgreeWithPythonDecimal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Positive bases with up to 4 digits, non-integer exponents with up to 3 digits, results
+		// between 1E-6 and 1E6 (larger integer-part powers are decimal/4); PowWithPrecision is
+		// held to its precision for positive exponents only (negative ones are decimal/10).
+		x := genDecimal(ht, 4, -3, 0).Abs()
+		y := genDecimal(ht, 3, -2, -1)
+		ht.Assume(!x.IsZero() && !y.IsInteger())
+		fx, fy := floatOf(x), floatOf(y)
+		ht.Assume(math.Abs(math.Log10(fx)*fy) <= 6)
+		want, _ := truth("power", x.String(), y.String())
+		p := n(ht, 0, 15)
+		got, err := x.PowWithPrecision(y, int32(p))
+		if err != nil {
+			ht.Fatalf("PowWithPrecision(%s, %s, %d): %v", repr(x), repr(y), p, err)
+		}
+		if y.Sign() > 0 && !withinUnits(got, want, p, 1) {
+			ht.Fatalf("PowWithPrecision(%s, %s, %d) = %s, want %s", repr(x), repr(y), p, got, want.FloatString(p+6))
+		}
+		// Pow documents no precision for fractional exponents: only gross errors are caught.
+		pw := x.Pow(y)
+		rel := new(big.Rat).Sub(ratOf(pw), want)
+		rel.Abs(rel)
+		rel.Quo(rel, want)
+		if rel.Cmp(big.NewRat(1, 1000000)) > 0 {
+			ht.Fatalf("Pow(%s, %s) = %s, want %s (relative error %s)", repr(x), repr(y), pw, want.FloatString(20), rel.FloatString(12))
+		}
+		// A negative base with a fractional exponent is an error (Pow: zero).
+		if _, err := x.Neg().PowWithPrecision(y, int32(p)); err == nil {
+			ht.Fatalf("PowWithPrecision(%s, %s) succeeded", repr(x.Neg()), repr(y))
+		}
+		if !x.Neg().Pow(y).IsZero() {
+			ht.Fatalf("Pow(%s, %s) = %s, want 0", repr(x.Neg()), repr(y), repr(x.Neg().Pow(y)))
+		}
+	})
+}
