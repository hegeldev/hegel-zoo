+		}
+		want, _ := truth("power", x.String(), y.String())
+		if !withinUnits(got, want, p, 1) {
+			ht.Fatalf("PowWithPrecision(%d, %s, %d) = %s, want %s", base, y, p, got, want.FloatString(p+4))
+		}
+	})
+}
+
+// decimal/5: Sin/Cos/Tan of large arguments are unbounded — the octant index j is turned
+// into a decimal through float64(j), which loses digits beyond 2^53:
+// New(1, 17).Sin() is -2102.65…, New(1, 20).Sin() has 250 integer digits.
+func TestHegelTrigOfLargeArgumentsStaysBounded(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := n(ht, 100, 999)
+		k := n(ht, 15, 26)
+		x := New(int64(c), int32(k))
+		one := New(1, 0)
+		if s, cs := x.Sin(), x.Cos(); s.Abs().GreaterThan(one) || cs.Abs().GreaterThan(one) {
+			ht.Fatalf("Sin(%s) = %s, Cos = %s", x, s.StringFixed(6), cs.StringFixed(6))
+		}
+	})
+}
+
+// decimal/6: PowInt32(math.MinInt32) is 1 for every base — abs(int32) overflows, so the
+// exponent loop never runs and 1/1 is returned; PowBigInt gets the same exponent right.
+func TestHegelPowInt32OfTheSmallestExponentIsNotOne(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := New(int64(n(ht, 2, 1000)), 0)
+		got, err := x.PowInt32(math.MinInt32)
+		if err != nil {
+			ht.Fatalf("PowInt32(%s, MinInt32): %v", repr(x), err)
+		}
+		if !got.LessThan(New(1, 0)) {
+			ht.Fatalf("PowInt32(%s, MinInt32) = %s, want a value below 1 (0 at %d places)", repr(x), got, PowPrecisionNegativeExponent)
+		}
+	})
+}
+
+// decimal/7: IntPart wraps silently beyond int64 ("returns the integer component"):
+// RequireFromString("1E19").IntPart() is -8446744073709551616.
+func TestHegelIntPartKeepsTheSign(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := New(int64(n(ht, 1, 999)), int32(n(ht, 17, 40)))
+		if x.Coefficient().Cmp(big.NewInt(0)) == 0 || x.BigInt().IsInt64() {
+			ht.Assume(false)
+		}
+		if got := x.IntPart(); got < 0 {
+			ht.Fatalf("IntPart(%s) = %d", x, got)
+		}
+	})
+}
+
+// decimal/9: PowInt32 and PowBigInt of zero with a negative exponent panic ("decimal
+// division by 0") — the doc says an error is returned only for 0^0; Pow returns 0 and
+// PowWithPrecision an error for the same input.
+func TestHegelPowInt32OfZeroWithANegativeExponentReturnsAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := -n(ht, 1, 100)
+		zero := New(0, int32(n(ht, -5, 5)))
+		got := call(func() string {
+			r, err := zero.PowInt32(int32(k))
+			return fmt.Sprintf("%s, %v", repr(r), err)
+		})
+		if chance(ht, 50) {
+			got = call(func() string {
+				r, err := zero.PowBigInt(big.NewInt(int64(k)))
+				return fmt.Sprintf("%s, %v", repr(r), err)
+			})
+		}
+		if strings.HasPrefix(got, "panic:") {
+			ht.Fatalf("0 ^ %d: %s", k, got)
+		}
+	})
+}
+
+// decimal/10: PowWithPrecision with a negative non-integer exponent rounds 1/x^k, the
+// integer-part factor, to the requested places before multiplying it by the fractional
+// factor: NewFromFloat(0.03).PowWithPrecision(NewFromFloat(-1.4), 0) is 134.17…, the true
+// value 135.53 (33 instead of 33.333… times 0.03^-0.4).
+func TestHegelPowWithPrecisionHonoursThePrecisionForNegativeExponents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := New(int64(n(ht, 2, 99)), int32(-n(ht, 1, 2)))
+		ht.Assume(x.LessThan(New(1, 0)))
+		y, _ := NewFromString("-" + strconv.Itoa(n(ht, 1, 3)) + "." + strconv.Itoa(n(ht, 1, 9)))
+		p := n(ht, 0, 3)
+		got, err := x.PowWithPrecision(y, int32(p))
+		if err != nil {
+			ht.Fatalf("PowWithPrecision(%s, %s, %d): %v", x, y, p, err)
+		}
+		want, _ := truth("power", x.String(), y.String())
+		if !withinUnits(got, want, p, 1) {
+			ht.Fatalf("PowWithPrecision(%s, %s, %d) = %s, want %s", x, y, p, got, want.FloatString(p+4))
+		}
+	})
+}
+
+// decimal/8: Shift wraps the exponent silently where Mul panics on the same overflow
+// ("better to panic than give incorrect results, as Decimals are usually used for money"):
+// New(1, math.MaxInt32).Shift(1) has exponent -2147483648.
+func TestHegelShiftRefusesExponentOverflow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := math.MaxInt32 - n(ht, 0, 100)
+		s := n(ht, 1, 200)
+		ht.Assume(int64(e)+int64(s) > math.MaxInt32)
+		x := New(int64(n(ht, 1, 99)), int32(e))
+		got := call(func() string { return strconv.Itoa(int(x.Shift(int32(s)).Exponent())) })
+		if !strings.HasPrefix(got, "panic:") {
+			ht.Fatalf("Shift(%s, %d) has exponent %s, want %d or a panic", repr(x), s, got, int64(e)+int64(s))
+		}
+	})
+}
