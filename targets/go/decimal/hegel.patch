+// ---------------------------------------------------------------------------------------
+// Division, remainder and rounding against big.Rat.
+
+func TestHegelDivisionAgreesWithBigRat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a, b := genDecimal(ht, 20, -20, 20), genDecimal(ht, 12, -15, 15)
+		ra, rb := ratOf(a), ratOf(b)
+		if b.IsZero() {
+			for _, s := range []string{
+				call(func() string { return a.Div(b).String() }),
+				call(func() string { return a.Mod(b).String() }),
+				call(func() string { return a.DivRound(b, 3).String() }),
+				call(func() string { q, _ := a.QuoRem(b, 3); return q.String() }),
+			} {
+				if !strings.HasPrefix(s, "panic: decimal division by 0") {
+					ht.Fatalf("division of %s by zero gave %q, want a panic", repr(a), s)
+				}
+			}
+			return
+		}
+		exact := new(big.Rat).Quo(ra, rb)
+		prec := n(ht, -6, 25)
+		switch n(ht, 0, 3) {
+		case 0:
+			// QuoRem: d = d2*q + r, q an integer multiple of 10^-precision with the sign of
+			// the quotient, |r| < |d2|*10^-precision, r with the sign of d (or zero).
+			q, r := a.QuoRem(b, int32(prec))
+			rq, rr := ratOf(q), ratOf(r)
+			scaled := new(big.Rat).Mul(rq, ratPow10(prec))
+			want := new(big.Rat).SetInt(roundRat(new(big.Rat).Mul(exact, ratPow10(prec)), "down"))
+			if scaled.Cmp(want) != 0 {
+				ht.Fatalf("QuoRem(%s, %s, %d) quotient %s, want %s", repr(a), repr(b), prec, repr(q), ratStr(new(big.Rat).Mul(want, ratPow10(-prec))))
+			}
+			back := new(big.Rat).Mul(rb, rq)
+			back.Add(back, rr)
+			if back.Cmp(ra) != 0 {
+				ht.Fatalf("QuoRem(%s, %s, %d) = %s, %s: d2*q + r = %s", repr(a), repr(b), prec, repr(q), repr(r), ratStr(back))
+			}
+			bound := new(big.Rat).Abs(rb)
+			bound.Mul(bound, ratPow10(-prec))
+			if new(big.Rat).Abs(rr).Cmp(bound) >= 0 || (rr.Sign() != 0 && rr.Sign() != ra.Sign()) {
+				ht.Fatalf("QuoRem(%s, %s, %d) remainder %s out of range", repr(a), repr(b), prec, repr(r))
+			}
+			if q.Exponent() != int32(-prec) {
+				ht.Fatalf("QuoRem(%s, %s, %d) quotient exponent %d", repr(a), repr(b), prec, q.Exponent())
+			}
+		case 1:
+			sameValue(ht, fmt.Sprintf("DivRound(%s, %s, %d)", repr(a), repr(b), prec), a.DivRound(b, int32(prec)), roundTo(exact, prec, "half_away"))
+		case 2:
+			// Div rounds to DivisionPrecision places; Mod is the remainder at precision 0.
+			old := DivisionPrecision
+			defer func() { DivisionPrecision = old }()
+			DivisionPrecision = n(ht, 0, 20)
+			sameValue(ht, fmt.Sprintf("Div(%s, %s) at %d", repr(a), repr(b), DivisionPrecision), a.Div(b), roundTo(exact, DivisionPrecision, "half_away"))
+			q := new(big.Rat).SetInt(roundRat(exact, "down"))
+			rem := new(big.Rat).Sub(ra, new(big.Rat).Mul(rb, q))
+			sameValue(ht, fmt.Sprintf("Mod(%s, %s)", repr(a), repr(b)), a.Mod(b), rem)
+		case 3:
+			// Division by a power of ten is a shift; x/x = 1; (x/y)*y rounds back to x when exact.
+			if p := n(ht, -10, 10); true {
+				ten := New(1, int32(p))
+				sameValue(ht, fmt.Sprintf("%s / 1E%d", repr(a), p), a.DivRound(ten, 30), new(big.Rat).Mul(ra, ratPow10(-p)))
+			}
+			if !a.IsZero() && !a.Div(a).Equal(New(1, 0)) {
+				ht.Fatalf("%s / itself = %s", repr(a), repr(a.Div(a)))
+			}
+		}
+	})
+}
