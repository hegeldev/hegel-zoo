+// ---------------------------------------------------------------------------------------
+// Powers with integer exponents (exact, or 1/x^n rounded to PowPrecisionNegativeExponent).
+
+func ratPow(r *big.Rat, k int) *big.Rat {
+	res := big.NewRat(1, 1)
+	for i := 0; i < k; i++ {
+		res.Mul(res, r)
+	}
+	return res
+}
+
+func TestHegelIntegerPowersAreExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := genDecimal(ht, 6, -6, 3)
+		k := n(ht, -12, 12)
+		rx := ratOf(x)
+		var want *big.Rat
+		zeroCase := x.IsZero()
+		if !zeroCase {
+			if k >= 0 {
+				want = ratPow(rx, k)
+			} else {
+				want = roundTo(new(big.Rat).Quo(big.NewRat(1, 1), ratPow(rx, -k)), PowPrecisionNegativeExponent, "half_away")
+			}
+		}
+		// The exponent in its several spellings: 3, 3.0, 30E-1.
+		y := New(int64(k), 0)
+		if chance(ht, 50) {
+			pad := n(ht, 1, 3)
+			y = New(int64(k)*int64(pow10(pad).Int64()), int32(-pad))
+		}
+		what := fmt.Sprintf("%s ^ %s", repr(x), repr(y))
+		pw := x.Pow(y)
+		pwp, errp := x.PowWithPrecision(y, int32(n(ht, 0, 20)))
+		if zeroCase && k < 0 {
+			// 0^negative: PowWithPrecision errs, Pow is zero; PowInt32/PowBigInt are decimal/9.
+			if errp == nil || !pw.IsZero() {
+				ht.Fatalf("%s: PowWithPrecision error %v, Pow %s", what, errp, repr(pw))
+			}
+			return
+		}
+		p32, err32 := x.PowInt32(int32(k))
+		pbig, errbig := x.PowBigInt(big.NewInt(int64(k)))
+		if zeroCase {
+			// 0^0 is an error (Pow: zero), 0^positive is 0.
+			if k == 0 {
+				if err32 == nil || errbig == nil || errp == nil || !pw.IsZero() {
+					ht.Fatalf("%s: errors %v %v %v, Pow %s", what, err32, errbig, errp, repr(pw))
+				}
+			} else if err32 != nil || errbig != nil || errp != nil || !p32.IsZero() || !pbig.IsZero() || !pw.IsZero() || !pwp.IsZero() {
+				ht.Fatalf("%s: %s %s %s %s (%v %v %v)", what, repr(p32), repr(pbig), repr(pw), repr(pwp), err32, errbig, errp)
+			}
+			return
+		}
+		if err32 != nil || errbig != nil || errp != nil {
+			ht.Fatalf("%s: unexpected errors %v %v %v", what, err32, errbig, errp)
+		}
+		sameValue(ht, "PowInt32 "+what, p32, want)
+		sameValue(ht, "PowBigInt "+what, pbig, want)
+		sameValue(ht, "Pow "+what, pw, want)
+		if k >= 0 {
+			sameValue(ht, "PowWithPrecision "+what, pwp, want)
+		}
+	})
+}
