+package decimal_test
+
+// Hegel properties for github.com/shopspring/decimal (the Hegel zoo, targets/go/decimal).
+//
+// Oracles: math/big.Rat for everything exact (constructors, arithmetic, division with
+// remainder, the rounding family, formatting, parsing, integer powers); Python's decimal
+// module at 200 digits, run as a child process, for ExpTaylor, ExpHullAbrham, Ln and the
+// fractional powers; the math package for the trigonometric functions.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	. "github.com/shopspring/decimal"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	return int(hegel.Draw(tc, hegel.Integers[int64](int64(lo), int64(hi))))
+}
+func chance(tc hegel.TestCase, pct int) bool  { return n(tc, 1, 100) <= pct }
+func pick[T any](tc hegel.TestCase, xs []T) T { return xs[n(tc, 0, len(xs)-1)] }
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// call runs f and returns its result, or "panic: <message>" if it panicked.
+func call(f func() string) (s string) {
+	defer func() {
+		if r := recover(); r != nil {
+			s = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	return f()
+}
+
+// ---------------------------------------------------------------------------------------
+// Generators and the big.Rat model.
+
+func genDigits(tc hegel.TestCase, maxDigits int) string {
+	if chance(tc, 10) {
+		return "0"
+	}
+	k := n(tc, 1, maxDigits)
+	var sb strings.Builder
+	sb.WriteByte(byte('1' + n(tc, 0, 8)))
+	for i := 1; i < k; i++ {
+		sb.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	return sb.String()
+}
+
+// genDecimal draws coefficient × 10^exp with up to maxDigits digits and exp in [expLo, expHi].
+func genDecimal(tc hegel.TestCase, maxDigits, expLo, expHi int) Decimal {
+	if chance(tc, 5) {
+		var zero Decimal // the zero value must behave as 0
+		return zero
+	}
+	c, _ := new(big.Int).SetString(genDigits(tc, maxDigits), 10)
+	if chance(tc, 50) {
+		c.Neg(c)
+	}
+	return NewFromBigInt(c, int32(n(tc, expLo, expHi)))
+}
+
+func iabs(x int) int {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
+
+func pow10(e int) *big.Int {
+	return new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(iabs(e))), nil)
+}
+
+func ratPow10(e int) *big.Rat {
+	if e >= 0 {
+		return new(big.Rat).SetInt(pow10(e))
+	}
+	return new(big.Rat).SetFrac(big.NewInt(1), pow10(e))
+}
+
+// ratOf is the exact value of d, from its coefficient and exponent.
+func ratOf(d Decimal) *big.Rat {
+	r := new(big.Rat).SetInt(d.Coefficient())
+	return r.Mul(r, ratPow10(int(d.Exponent())))
+}
+
+// repr is the representation of d, independent of the package's formatting switches.
+func repr(d Decimal) string { return d.Coefficient().String() + "E" + strconv.Itoa(int(d.Exponent())) }
+
+func ratStr(r *big.Rat) string {
+	if r.IsInt() {
+		return r.Num().String()
+	}
+	return r.FloatString(40)
+}
+
+// roundRat rounds r to an integer: "down" (towards zero), "up" (away from zero), "floor",
+// "ceil", "half_away" (halves away from zero) or "half_even".
+func roundRat(r *big.Rat, mode string) *big.Int {
+	q, m := new(big.Int).QuoRem(r.Num(), r.Denom(), new(big.Int))
+	if m.Sign() == 0 {
+		return q
+	}
+	sign := big.NewInt(int64(r.Sign()))
+	twice := new(big.Int).Abs(m)
+	twice.Lsh(twice, 1)
+	half := twice.Cmp(r.Denom()) // -1 below, 0 at, 1 above the half
+	away := func() *big.Int { return q.Add(q, sign) }
+	switch mode {
+	case "down":
+		return q
+	case "up":
+		return away()
+	case "floor":
+		if r.Sign() < 0 {
+			return away()
+		}
+		return q
+	case "ceil":
+		if r.Sign() > 0 {
+			return away()
+		}
+		return q
+	case "half_away":
+		if half >= 0 {
+			return away()
+		}
+		return q
+	case "half_even":
+		if half > 0 || (half == 0 && q.Bit(0) == 1) {
+			return away()
+		}
+		return q
+	}
+	panic("unknown rounding " + mode)
+}
+
+// roundTo rounds r to a multiple of 10^-places.
+func roundTo(r *big.Rat, places int, mode string) *big.Rat {
+	scaled := new(big.Rat).Mul(r, ratPow10(places))
+	res := new(big.Rat).SetInt(roundRat(scaled, mode))
+	return res.Mul(res, ratPow10(-places))
+}
+
+// fixed formats r, an exact multiple of 10^-places, with exactly places fraction digits
+// (places <= 0: as an integer).
+func fixed(r *big.Rat, places int) string {
+	if places <= 0 {
+		if !r.IsInt() {
+			panic("fixed: not an integer: " + r.String())
+		}
+		return r.Num().String()
+	}
+	m := new(big.Rat).Mul(r, ratPow10(places))
+	if !m.IsInt() {
+		panic("fixed: not a multiple of 10^-places: " + r.String())
+	}
+	s := new(big.Int).Abs(m.Num()).String()
+	for len(s) <= places {
+		s = "0" + s
+	}
+	out := s[:len(s)-places] + "." + s[len(s)-places:]
+	if m.Sign() < 0 {
+		out = "-" + out
+	}
+	return out
+}
+
+// text is the model of Decimal.String for a coefficient and an exponent, under the two
+// package switches TrimTrailingZeros and UseScientificNotation.
+func text(c *big.Int, exp int, trim, sci bool) string {
+	if exp >= 0 {
+		if sci && exp > 0 {
+			return scientific(c, exp)
+		}
+		return new(big.Int).Mul(c, pow10(exp)).String()
+	}
+	s := new(big.Int).Abs(c).String()
+	var intPart, frac string
+	if len(s) > -exp {
+		intPart, frac = s[:len(s)+exp], s[len(s)+exp:]
+	} else {
+		intPart, frac = "0", strings.Repeat("0", -exp-len(s))+s
+	}
+	if trim {
+		frac = strings.TrimRight(frac, "0")
+	}
+	out := intPart
+	if frac != "" {
+		out += "." + frac
+	}
+	if c.Sign() < 0 {
+		out = "-" + out
+	}
+	return out
+}
+
+// scientific is the model of ScientificNotationString: one leading digit, the remaining
+// significant digits after the point, "E" and the adjusted exponent; zero is "0".
+func scientific(c *big.Int, exp int) string {
+	if c.Sign() == 0 {
+		return "0"
+	}
+	s := new(big.Int).Abs(c).String()
+	out := s[:1]
+	if len(s) > 1 {
+		out += "." + s[1:]
+	}
+	out += "E" + strconv.Itoa(exp+len(s)-1)
+	if c.Sign() < 0 {
+		out = "-" + out
+	}
+	return out
+}
+
+func sameValue(ht *hegel.T, what string, got Decimal, want *big.Rat) {
+	if ratOf(got).Cmp(want) != 0 {
+		ht.Fatalf("%s = %s (%s), want %s", what, got.String(), repr(got), ratStr(want))
+	}
+}
+
+// ---------------------------------------------------------------------------------------
+// Constructors, accessors and predicates.
+
+func TestHegelConstructorsAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 0, 6) {
+		case 0:
+			v := int64(hegel.Draw(ht, hegel.Integers[int64](math.MinInt64, math.MaxInt64)))
+			e := int32(n(ht, -50, 50))
+			d := New(v, e)
+			if d.Coefficient().Cmp(big.NewInt(v)) != 0 || d.Exponent() != e {
+				ht.Fatalf("New(%d, %d) = %s", v, e, repr(d))
+			}
+			if NewFromInt(v).Coefficient().Cmp(big.NewInt(v)) != 0 || NewFromInt(v).Exponent() != 0 {
+				ht.Fatalf("NewFromInt(%d) = %s", v, repr(NewFromInt(v)))
+			}
+			if NewFromInt32(int32(v)).Coefficient().Int64() != int64(int32(v)) {
+				ht.Fatalf("NewFromInt32(%d) = %s", int32(v), repr(NewFromInt32(int32(v))))
+			}
+			u := uint64(v)
+			if NewFromUint64(u).Coefficient().Cmp(new(big.Int).SetUint64(u)) != 0 || NewFromUint64(u).Exponent() != 0 {
+				ht.Fatalf("NewFromUint64(%d) = %s", u, repr(NewFromUint64(u)))
+			}
+		case 1:
+			c, _ := new(big.Int).SetString(genDigits(ht, 40), 10)
+			if chance(ht, 50) {
+				c.Neg(c)
+			}
+			e := int32(n(ht, -100, 100))
+			d := NewFromBigInt(c, e)
+			if d.Coefficient().Cmp(c) != 0 || d.Exponent() != e {
+				ht.Fatalf("NewFromBigInt(%s, %d) = %s", c, e, repr(d))
+			}
+			c.Add(c, big.NewInt(1)) // the constructor copies its argument
+			if d.Coefficient().Cmp(c) == 0 {
+				ht.Fatalf("NewFromBigInt shares the caller's big.Int")
+			}
+			// Coefficient() returns a copy too.
+			d.Coefficient().SetInt64(7)
+			if d.Coefficient().Cmp(new(big.Int).Sub(c, big.NewInt(1))) != 0 {
+				ht.Fatalf("Coefficient() shares the decimal's big.Int")
+			}
+			cp := d.Copy()
+			if repr(cp) != repr(d) {
+				ht.Fatalf("Copy of %s = %s", repr(d), repr(cp))
+			}
+		case 2:
+			num := genDecimal(ht, 12, 0, 0).Coefficient()
+			den, _ := new(big.Int).SetString(genDigits(ht, 8), 10)
+			ht.Assume(den.Sign() != 0)
+			if chance(ht, 30) {
+				den.Neg(den)
+			}
+			prec := n(ht, -3, 12)
+			r := new(big.Rat).SetFrac(num, den)
+			got := NewFromBigRat(r, int32(prec))
+			sameValue(ht, fmt.Sprintf("NewFromBigRat(%s, %d)", r, prec), got, roundTo(r, prec, "half_away"))
+		case 3:
+			d := genDecimal(ht, 30, -40, 40)
+			r := ratOf(d)
+			digits := len(new(big.Int).Abs(d.Coefficient()).String())
+			if d.NumDigits() != digits {
+				ht.Fatalf("NumDigits of %s = %d, want %d", repr(d), d.NumDigits(), digits)
+			}
+			if d.IsInteger() != r.IsInt() {
+				ht.Fatalf("IsInteger of %s = %v, want %v", repr(d), d.IsInteger(), r.IsInt())
+			}
+			if d.Sign() != r.Sign() || d.IsZero() != (r.Sign() == 0) || d.IsPositive() != (r.Sign() > 0) || d.IsNegative() != (r.Sign() < 0) {
+				ht.Fatalf("Sign/IsZero/IsPositive/IsNegative of %s = %d %v %v %v", repr(d), d.Sign(), d.IsZero(), d.IsPositive(), d.IsNegative())
+			}
+			if ratOf(d).Cmp(d.Rat()) != 0 {
+				ht.Fatalf("Rat of %s = %s, want %s", repr(d), d.Rat(), ratStr(r))
+			}
+			// BigInt is the integer part, truncated towards zero.
+			trunc := roundRat(r, "down")
+			if d.BigInt().Cmp(trunc) != 0 {
+				ht.Fatalf("BigInt of %s = %s, want %s", repr(d), d.BigInt(), trunc)
+			}
+			if trunc.IsInt64() && d.IntPart() != trunc.Int64() { // beyond int64: decimal/7
+				ht.Fatalf("IntPart of %s = %d, want %s", repr(d), d.IntPart(), trunc)
+			}
+			if d.Coefficient().IsInt64() && d.CoefficientInt64() != d.Coefficient().Int64() {
+				ht.Fatalf("CoefficientInt64 of %s = %d", repr(d), d.CoefficientInt64())
+			}
+		case 4:
+			// Float64 is the nearest float64 (big.Rat.Float64 is exact).
+			d := genDecimal(ht, 25, -30, 30)
+			want, exact := ratOf(d).Float64()
+			got, gotExact := d.Float64()
+			if got != want || gotExact != exact || d.InexactFloat64() != want {
+				ht.Fatalf("Float64 of %s = %v %v, want %v %v", repr(d), got, gotExact, want, exact)
+			}
+		case 5:
+			// RescalePair rescales to the smaller exponent, keeping both values.
+			a, b := genDecimal(ht, 10, -20, 20), genDecimal(ht, 10, -20, 20)
+			ra, rb := RescalePair(a, b)
+			minExp := a.Exponent()
+			if b.Exponent() < minExp {
+				minExp = b.Exponent()
+			}
+			if ra.Exponent() != minExp || rb.Exponent() != minExp || ratOf(ra).Cmp(ratOf(a)) != 0 || ratOf(rb).Cmp(ratOf(b)) != 0 {
+				ht.Fatalf("RescalePair(%s, %s) = %s, %s", repr(a), repr(b), repr(ra), repr(rb))
+			}
+		case 6:
+			var z Decimal
+			if z.String() != "0" || !z.IsZero() || z.Coefficient().Sign() != 0 || z.Exponent() != 0 || z.NumDigits() != 1 || !z.IsInteger() || !z.Equal(Zero) {
+				ht.Fatalf("the zero value misbehaves: %q %v %v", z.String(), z.NumDigits(), z.Exponent())
+			}
+			x := genDecimal(ht, 10, -10, 10)
+			if !z.Add(x).Equal(x) || !x.Sub(z).Equal(x) || !z.Mul(x).IsZero() || z.Cmp(x) != -x.Sign() || !z.Neg().IsZero() || !z.Abs().IsZero() {
+				ht.Fatalf("the zero value misbehaves in arithmetic with %s", repr(x))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Arithmetic and comparison against big.Rat.
+
+func TestHegelArithmeticAgreesWithBigRat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a, b := genDecimal(ht, 25, -30, 30), genDecimal(ht, 25, -30, 30)
+		ra, rb := ratOf(a), ratOf(b)
+		switch n(ht, 0, 9) {
+		case 0:
+			sameValue(ht, fmt.Sprintf("%s + %s", repr(a), repr(b)), a.Add(b), new(big.Rat).Add(ra, rb))
+		case 1:
+			sameValue(ht, fmt.Sprintf("%s - %s", repr(a), repr(b)), a.Sub(b), new(big.Rat).Sub(ra, rb))
+		case 2:
+			sameValue(ht, fmt.Sprintf("%s * %s", repr(a), repr(b)), a.Mul(b), new(big.Rat).Mul(ra, rb))
+		case 3:
+			sameValue(ht, "Neg "+repr(a), a.Neg(), new(big.Rat).Neg(ra))
+			sameValue(ht, "Abs "+repr(a), a.Abs(), new(big.Rat).Abs(ra))
+		case 4:
+			c := ra.Cmp(rb)
+			if a.Cmp(b) != c || a.Compare(b) != c || a.Equal(b) != (c == 0) || a.Equals(b) != (c == 0) ||
+				a.GreaterThan(b) != (c > 0) || a.GreaterThanOrEqual(b) != (c >= 0) || a.LessThan(b) != (c < 0) || a.LessThanOrEqual(b) != (c <= 0) {
+				ht.Fatalf("comparisons of %s and %s disagree with %d", repr(a), repr(b), c)
+			}
+		case 5:
+			k := n(ht, -20, 20)
+			sameValue(ht, fmt.Sprintf("Shift(%s, %d)", repr(a), k), a.Shift(int32(k)), new(big.Rat).Mul(ra, ratPow10(k)))
+		case 6:
+			rest := []Decimal{b}
+			for i := n(ht, 0, 4); i > 0; i-- {
+				rest = append(rest, genDecimal(ht, 25, -30, 30))
+			}
+			all := append([]Decimal{a}, rest...)
+			mn, mx, sum := ratOf(all[0]), ratOf(all[0]), new(big.Rat)
+			for _, d := range all {
+				r := ratOf(d)
+				if r.Cmp(mn) < 0 {
+					mn = r
+				}
+				if r.Cmp(mx) > 0 {
+					mx = r
+				}
+				sum.Add(sum, r)
+			}
+			sameValue(ht, "Min", Min(a, rest...), mn)
+			sameValue(ht, "Max", Max(a, rest...), mx)
+			sameValue(ht, "Sum", Sum(a, rest...), sum)
+			avg := new(big.Rat).Quo(sum, big.NewRat(int64(len(all)), 1))
+			sameValue(ht, "Avg", Avg(a, rest...), roundTo(avg, DivisionPrecision, "half_away"))
+		case 7:
+			// Add/Sub keep the smaller exponent; Mul adds the exponents.
+			s := a.Add(b)
+			minExp := a.Exponent()
+			if b.Exponent() < minExp {
+				minExp = b.Exponent()
+			}
+			if s.Exponent() != minExp || a.Sub(b).Exponent() != minExp {
+				ht.Fatalf("%s + %s has exponent %d, want %d", repr(a), repr(b), s.Exponent(), minExp)
+			}
+			if a.Mul(b).Exponent() != a.Exponent()+b.Exponent() {
+				ht.Fatalf("%s * %s has exponent %d", repr(a), repr(b), a.Mul(b).Exponent())
+			}
+		case 8:
+			// Immutability: operations leave their receivers alone.
+			before := repr(a)
+			_ = a.Add(b)
+			_ = a.Neg()
+			_ = a.Abs()
+			_ = a.Round(int32(n(ht, -5, 5)))
+			_ = a.Floor()
+			_ = a.Truncate(2)
+			if repr(a) != before {
+				ht.Fatalf("%s was mutated into %s", before, repr(a))
+			}
+		case 9:
+			// Algebraic identities.
+			if !a.Add(b).Sub(b).Equal(a) || !a.Sub(a).IsZero() || !a.Mul(b).Equal(b.Mul(a)) || !a.Neg().Neg().Equal(a) || !a.Abs().Equal(a.Neg().Abs()) {
+				ht.Fatalf("identities fail for %s and %s", repr(a), repr(b))
+			}
+		}
+	})
+}
