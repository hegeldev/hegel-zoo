+func TestHegelEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDecimal(ht, 30, -40, 40)
+		switch n(ht, 0, 5) {
+		case 0:
+			// JSON: quoted (or bare) String(); both forms parse; null leaves the value alone.
+			old := MarshalJSONWithoutQuotes
+			defer func() { MarshalJSONWithoutQuotes = old }()
+			MarshalJSONWithoutQuotes = chance(ht, 50)
+			b, err := d.MarshalJSON()
+			if err != nil {
+				ht.Fatalf("MarshalJSON of %s: %v", repr(d), err)
+			}
+			want := d.String()
+			if !MarshalJSONWithoutQuotes {
+				want = `"` + want + `"`
+			}
+			if string(b) != want {
+				ht.Fatalf("MarshalJSON of %s = %s, want %s", repr(d), b, want)
+			}
+			var back Decimal
+			if err := back.UnmarshalJSON(b); err != nil {
+				ht.Fatalf("UnmarshalJSON of %s: %v", b, err)
+			}
+			sameValue(ht, "UnmarshalJSON(MarshalJSON("+repr(d)+"))", back, ratOf(d))
+			keep := back
+			if err := back.UnmarshalJSON([]byte("null")); err != nil || repr(back) != repr(keep) {
+				ht.Fatalf("UnmarshalJSON(null) changed %s into %s (%v)", repr(keep), repr(back), err)
+			}
+			pair := jsonPair{D: d, N: NullDecimal{Decimal: d, Valid: chance(ht, 50)}}
+			if chance(ht, 50) {
+				pair.P = &d
+			}
+			enc, err := json.Marshal(pair)
+			if err != nil {
+				ht.Fatalf("json.Marshal: %v", err)
+			}
+			var dec jsonPair
+			if err := json.Unmarshal(enc, &dec); err != nil {
+				ht.Fatalf("json.Unmarshal(%s): %v", enc, err)
+			}
+			if !dec.D.Equal(d) || dec.N.Valid != pair.N.Valid || (dec.N.Valid && !dec.N.Decimal.Equal(d)) || (pair.P != nil) != (dec.P != nil) || (dec.P != nil && !dec.P.Equal(d)) {
+				ht.Fatalf("json round trip of %s through %s gave %+v", repr(d), enc, dec)
+			}
+			if !pair.N.Valid && !strings.Contains(string(enc), `"n":null`) {
+				ht.Fatalf("an invalid NullDecimal encodes as %s", enc)
+			}
+		case 1:
+			// Text and Value: String(); Scan accepts strings, bytes (quoted or not), floats and ints.
+			b, err := d.MarshalText()
+			if err != nil || string(b) != d.String() {
+				ht.Fatalf("MarshalText of %s = %q (%v)", repr(d), b, err)
+			}
+			var back Decimal
+			if err := back.UnmarshalText(b); err != nil || !back.Equal(d) {
+				ht.Fatalf("UnmarshalText(%q) = %s (%v)", b, repr(back), err)
+			}
+			v, err := d.Value()
+			if err != nil || v != d.String() {
+				ht.Fatalf("Value of %s = %v (%v)", repr(d), v, err)
+			}
+			for _, in := range []interface{}{d.String(), []byte(d.String()), `"` + d.String() + `"`, []byte(`"` + d.String() + `"`)} {
+				var s Decimal
+				if err := s.Scan(in); err != nil || !s.Equal(d) {
+					ht.Fatalf("Scan(%v) = %s (%v)", in, repr(s), err)
+				}
+			}
+			var s Decimal
+			i := int64(hegel.Draw(ht, hegel.Integers[int64](math.MinInt64, math.MaxInt64)))
+			if err := s.Scan(i); err != nil || !s.Equal(NewFromInt(i)) {
+				ht.Fatalf("Scan(int64 %d) = %s (%v)", i, repr(s), err)
+			}
+			if err := s.Scan(uint64(i)); err != nil || !s.Equal(NewFromUint64(uint64(i))) {
+				ht.Fatalf("Scan(uint64 %d) = %s (%v)", uint64(i), repr(s), err)
+			}
+			f := math.Float64frombits(uint64(i))
+			if !math.IsNaN(f) && !math.IsInf(f, 0) {
+				if err := s.Scan(f); err != nil || !s.Equal(NewFromFloat(f)) {
+					ht.Fatalf("Scan(float64 %v) = %s (%v)", f, repr(s), err)
+				}
+			}
+			if err := s.Scan(struct{}{}); err == nil {
+				ht.Fatalf("Scan of a struct succeeded")
+			}
+		case 2:
+			// Binary and gob keep the exact representation.
+			b, err := d.MarshalBinary()
+			if err != nil {
+				ht.Fatalf("MarshalBinary of %s: %v", repr(d), err)
+			}
+			g, err := d.GobEncode()
+			if err != nil || string(g) != string(b) {
+				ht.Fatalf("GobEncode of %s = %v, MarshalBinary %v (%v)", repr(d), g, b, err)
+			}
+			var back, gob Decimal
+			if err := back.UnmarshalBinary(b); err != nil || repr(back) != repr(d) {
+				ht.Fatalf("UnmarshalBinary(MarshalBinary(%s)) = %s (%v)", repr(d), repr(back), err)
+			}
+			if err := gob.GobDecode(g); err != nil || repr(gob) != repr(d) {
+				ht.Fatalf("GobDecode(GobEncode(%s)) = %s (%v)", repr(d), repr(gob), err)
+			}
+			if len(b) >= 4 {
+				var short Decimal
+				if err := short.UnmarshalBinary(b[:n(ht, 0, 3)]); err == nil {
+					ht.Fatalf("UnmarshalBinary accepted a short buffer")
+				}
+			}
+		case 3:
+			// NullDecimal: null/empty <-> invalid; otherwise like Decimal.
+			nd := NullDecimal{Decimal: d, Valid: chance(ht, 50)}
+			v, err := nd.Value()
+			if err != nil || (nd.Valid && v != d.String()) || (!nd.Valid && v != nil) {
+				ht.Fatalf("NullDecimal.Value = %v (%v)", v, err)
+			}
+			b, _ := nd.MarshalJSON()
+			var back NullDecimal
+			if err := back.UnmarshalJSON(b); err != nil || back.Valid != nd.Valid || (nd.Valid && !back.Decimal.Equal(d)) {
+				ht.Fatalf("NullDecimal JSON round trip of %s (valid %v) through %s: %+v (%v)", repr(d), nd.Valid, b, back, err)
+			}
+			tb, _ := nd.MarshalText()
+			var tback NullDecimal
+			if err := tback.UnmarshalText(tb); err != nil || tback.Valid != nd.Valid || (nd.Valid && !tback.Decimal.Equal(d)) {
+				ht.Fatalf("NullDecimal text round trip of %s (valid %v) through %q: %+v (%v)", repr(d), nd.Valid, tb, tback, err)
+			}
+			var sc NullDecimal
+			if err := sc.Scan(nil); err != nil || sc.Valid {
+				ht.Fatalf("NullDecimal.Scan(nil) = %+v (%v)", sc, err)
+			}
+			if err := sc.Scan(d.String()); err != nil || !sc.Valid || !sc.Decimal.Equal(d) {
+				ht.Fatalf("NullDecimal.Scan(%q) = %+v (%v)", d.String(), sc, err)
+			}
+			sv, err := nd.EncodeSpanner()
+			if err != nil || (nd.Valid && sv != d.String()) || (!nd.Valid && sv != nil) {
+				ht.Fatalf("NullDecimal.EncodeSpanner = %v (%v)", sv, err)
+			}
+			var sd NullDecimal
+			str := d.String()
+			if err := sd.DecodeSpanner(&str); err != nil || !sd.Valid || !sd.Decimal.Equal(d) {
+				ht.Fatalf("NullDecimal.DecodeSpanner(&%q) = %+v (%v)", str, sd, err)
+			}
+			if nn := NewNullDecimal(d); !nn.Valid || !nn.Decimal.Equal(d) {
+				ht.Fatalf("NewNullDecimal(%s) = %+v", repr(d), nn)
+			}
+		case 4:
+			// Spanner: String() out, Scan in.
+			v, err := d.EncodeSpanner()
+			if err != nil || v != d.String() {
+				ht.Fatalf("EncodeSpanner of %s = %v (%v)", repr(d), v, err)
+			}
+			var back Decimal
+			if err := back.DecodeSpanner(v); err != nil || !back.Equal(d) {
+				ht.Fatalf("DecodeSpanner(%v) = %s (%v)", v, repr(back), err)
+			}
+		case 5:
+			// Text/JSON round trips hold under every formatting switch.
+			withSwitches(chance(ht, 50), chance(ht, 50), func() {
+				b, _ := d.MarshalJSON()
+				var back Decimal
+				if err := back.UnmarshalJSON(b); err != nil || !back.Equal(d) {
+					ht.Fatalf("JSON round trip of %s through %s (trim %v, sci %v): %s (%v)", repr(d), b, TrimTrailingZeros, UseScientificNotation, repr(back), err)
+				}
+			})
+		}
+	})
+}
