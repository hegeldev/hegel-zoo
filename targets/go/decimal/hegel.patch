+// ---------------------------------------------------------------------------------------
+// Floats.
+
+func genFloat64(tc hegel.TestCase) float64 {
+	for {
+		var f float64
+		switch n(tc, 0, 3) {
+		case 0:
+			f = math.Float64frombits(uint64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64))))
+		case 1:
+			f = float64(n(tc, -1000000, 1000000)) / float64(pick(tc, []int{1, 10, 100, 1000, 8, 64, 3}))
+		case 2:
+			f, _ = strconv.ParseFloat(genDigits(tc, 17)+"e"+strconv.Itoa(n(tc, -320, 300)), 64)
+		case 3:
+			f = pick(tc, []float64{0, math.Copysign(0, -1), 0.1, 0.5, 1, 1.5, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-310, 123.456, 2.5, -2.5, 0.125, 1e15, 1e16, 9007199254740993})
+		}
+		if !math.IsNaN(f) && !math.IsInf(f, 0) {
+			return f
+		}
+	}
+}
+
+func TestHegelFloatConversionsAgreeWithStrconv(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genFloat64(ht)
+		switch n(ht, 0, 3) {
+		case 0:
+			// NewFromFloat holds the shortest decimal that round-trips (upstream's own property).
+			want, err := NewFromString(strconv.FormatFloat(f, 'e', -1, 64))
+			if err != nil {
+				ht.Fatalf("model: %v", err)
+			}
+			got := NewFromFloat(f)
+			if !got.Equal(want) {
+				ht.Fatalf("NewFromFloat(%v) = %s, want %s", f, repr(got), repr(want))
+			}
+			if back, exact := got.Float64(); back != f && !(f == 0 && back == 0) || !exact && got.NumDigits() < 16 && false {
+				ht.Fatalf("NewFromFloat(%v).Float64() = %v", f, back)
+			}
+		case 1:
+			f32 := float32(f)
+			if math.IsInf(float64(f32), 0) {
+				return
+			}
+			want, _ := NewFromString(strconv.FormatFloat(float64(f32), 'e', -1, 32))
+			if got := NewFromFloat32(f32); !got.Equal(want) {
+				ht.Fatalf("NewFromFloat32(%v) = %s, want %s", f32, repr(got), repr(want))
+			}
+		case 2:
+			// NewFromFloatWithExponent: the exact float rounded half away from zero at 10^exp.
+			exp := n(ht, -30, 30)
+			exact := new(big.Rat).SetFloat64(f)
+			got := NewFromFloatWithExponent(f, int32(exp))
+			sameValue(ht, fmt.Sprintf("NewFromFloatWithExponent(%v, %d)", f, exp), got, roundTo(exact, -exp, "half_away"))
+			if got.Exponent() < int32(exp) && exact.Cmp(ratOf(got)) != 0 {
+				ht.Fatalf("NewFromFloatWithExponent(%v, %d) = %s: finer than asked yet inexact", f, exp, repr(got))
+			}
+		case 3:
+			// NaN and infinities panic, as documented.
+			for _, bad := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+				if s := call(func() string { return NewFromFloat(bad).String() }); !strings.HasPrefix(s, "panic:") {
+					ht.Fatalf("NewFromFloat(%v) = %q", bad, s)
+				}
+				if s := call(func() string { return NewFromFloatWithExponent(bad, 2).String() }); !strings.HasPrefix(s, "panic:") {
+					ht.Fatalf("NewFromFloatWithExponent(%v) = %q", bad, s)
+				}
+			}
+		}
+	})
+}
