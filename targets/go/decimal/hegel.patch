+// numberGrammar is the grammar NewFromString documents by example: an optional sign, digits
+// with an optional point (at least one digit), an optional exponent.
+var numberGrammar = regexp.MustCompile(`^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$`)
+
+// parseModel returns the coefficient and exponent NewFromString should produce, or ok=false.
+func parseModel(s string) (c *big.Int, exp int64, ok bool) {
+	m := numberGrammar.FindStringSubmatch(s)
+	if m == nil || m[2]+m[3] == "" {
+		return nil, 0, false
+	}
+	exp = 0
+	if m[4] != "" {
+		e, err := strconv.ParseInt(m[4], 10, 32)
+		if err != nil {
+			return nil, 0, false
+		}
+		exp = e
+	}
+	exp -= int64(len(m[3]))
+	if exp < math.MinInt32 || exp > math.MaxInt32 {
+		return nil, 0, false
+	}
+	c, _ = new(big.Int).SetString(m[2]+m[3], 10)
+	if m[1] == "-" {
+		c.Neg(c)
+	}
+	return c, exp, true
+}
+
+func TestHegelNewFromStringAgreesWithTheGrammar(t *testing.T) {
+	pieces := []string{"", "+", "-", ".", ".", "e", "E", " ", "_", "x", "٣", " ", "e+", "e-", "1e5", "0", "00", "9", "1234567890123456789", "12345678901234567890123"}
+	property(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		if chance(ht, 60) {
+			// Mostly well-formed: [sign] digits [. digits] [e [sign] digits], with mutations.
+			sb.WriteString(pick(ht, []string{"", "", "+", "-"}))
+			sb.WriteString(pick(ht, []string{"", genDigits(ht, 25), genDigits(ht, 25), "0" + genDigits(ht, 3)}))
+			if chance(ht, 60) {
+				sb.WriteString(".")
+				sb.WriteString(pick(ht, []string{"", genDigits(ht, 25), strings.Repeat("0", n(ht, 1, 5)) + genDigits(ht, 10)}))
+			}
+			if chance(ht, 40) {
+				sb.WriteString(pick(ht, []string{"e", "E"}))
+				sb.WriteString(pick(ht, []string{"", "+", "-"}))
+				sb.WriteString(pick(ht, []string{"", strconv.Itoa(n(ht, 0, 60)), strconv.Itoa(n(ht, 0, math.MaxInt32)), "9999999999", "2147483648", "2147483647"}))
+			}
+			if chance(ht, 15) {
+				sb.WriteString(pick(ht, pieces))
+			}
+		} else {
+			for i := n(ht, 1, 6); i > 0; i-- {
+				if chance(ht, 50) {
+					sb.WriteString(pick(ht, pieces))
+				} else {
+					sb.WriteString(genDigits(ht, 6))
+				}
+			}
+		}
+		s := sb.String()
+		wantC, wantE, ok := parseModel(s)
+		d, err := NewFromString(s)
+		if (err == nil) != ok {
+			ht.Fatalf("NewFromString(%q): err %v, grammar says valid=%v", s, err, ok)
+		}
+		if ok && (d.Coefficient().Cmp(wantC) != 0 || int64(d.Exponent()) != wantE) {
+			ht.Fatalf("NewFromString(%q) = %s, want %sE%d", s, repr(d), wantC, wantE)
+		}
+		// RequireFromString panics exactly when NewFromString errs.
+		if p := call(func() string { return repr(RequireFromString(s)) }); strings.HasPrefix(p, "panic:") == ok {
+			ht.Fatalf("RequireFromString(%q) = %q, NewFromString err %v", s, p, err)
+		}
+		// NewFromFormattedString strips the matches first.
+		re := regexp.MustCompile(`[ _,]`)
+		fd, ferr := NewFromFormattedString(s, re)
+		sd, serr := NewFromString(re.ReplaceAllString(s, ""))
+		if (ferr == nil) != (serr == nil) || (ferr == nil && repr(fd) != repr(sd)) {
+			ht.Fatalf("NewFromFormattedString(%q) = %s (%v), NewFromString of the stripped text %s (%v)", s, repr(fd), ferr, repr(sd), serr)
+		}
+		// UnmarshalJSON and UnmarshalText agree with NewFromString (the quotes stripped).
+		var uj, ut Decimal
+		jerr := uj.UnmarshalJSON([]byte(`"` + s + `"`))
+		terr := ut.UnmarshalText([]byte(s))
+		if !strings.Contains(s, `"`) && ((jerr == nil) != ok || (ok && repr(uj) != repr(d))) {
+			ht.Fatalf("UnmarshalJSON(%q) = %s (%v)", `"`+s+`"`, repr(uj), jerr)
+		}
+		if (terr == nil) != ok || (ok && repr(ut) != repr(d)) {
+			ht.Fatalf("UnmarshalText(%q) = %s (%v)", s, repr(ut), terr)
+		}
+	})
+}
