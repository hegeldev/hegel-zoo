+func TestHegelStringsAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDecimal(ht, 30, -40, 40)
+		c, e := d.Coefficient(), int(d.Exponent())
+		trim, sci := chance(ht, 50), chance(ht, 50)
+		withSwitches(trim, sci, func() {
+			s := d.String()
+			if want := text(c, e, trim, sci); s != want {
+				ht.Fatalf("String of %s (trim %v, sci %v) = %q, want %q", repr(d), trim, sci, s, want)
+			}
+			// The text parses back to the same value, and to the same representation unless
+			// trailing zeros were trimmed or a positive exponent was expanded.
+			back, err := NewFromString(s)
+			if err != nil {
+				ht.Fatalf("String of %s = %q does not parse: %v", repr(d), s, err)
+			}
+			sameValue(ht, fmt.Sprintf("parse(String(%s)) = parse(%q)", repr(d), s), back, ratOf(d))
+			if !d.IsZero() && ((e < 0 && !trim) || (e > 0 && sci) || e == 0) {
+				if repr(back) != repr(d) {
+					ht.Fatalf("String of %s = %q parses back as %s", repr(d), s, repr(back))
+				}
+			}
+			if sn := d.ScientificNotationString(); sn != scientific(c, e) {
+				ht.Fatalf("ScientificNotationString of %s = %q, want %q", repr(d), sn, scientific(c, e))
+			}
+			if back, err := NewFromString(d.ScientificNotationString()); err != nil || ratOf(back).Cmp(ratOf(d)) != 0 {
+				ht.Fatalf("ScientificNotationString of %s = %q does not round-trip (%v)", repr(d), d.ScientificNotationString(), err)
+			}
+			// StringFixed never uses scientific notation, whatever the switch.
+			places := n(ht, -5, 10)
+			if fs := d.StringFixed(int32(places)); fs != fixed(roundTo(ratOf(d), places, "half_away"), places) {
+				ht.Fatalf("StringFixed(%s, %d) with sci %v = %q", repr(d), places, sci, fs)
+			}
+			// Deprecated StringScaled: the truncated value's text.
+			if ss := d.StringScaled(int32(-places)); ss != text(roundRat(new(big.Rat).Mul(ratOf(d), ratPow10(places)), "down"), -places, trim, sci) {
+				ht.Fatalf("StringScaled(%s, %d) = %q", repr(d), -places, ss)
+			}
+			// The text of a non-negative number is the text of its negation without the sign.
+			if neg := d.Neg().String(); d.IsNegative() && s != "-"+neg || !d.IsNegative() && !d.IsZero() && neg != "-"+s {
+				ht.Fatalf("String of %s = %q but of its negation %q", repr(d), s, neg)
+			}
+		})
+	})
+}
