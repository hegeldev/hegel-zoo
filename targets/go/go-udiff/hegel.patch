new file mode 100644
index 0000000..13a6ab0
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,134 @@
+package hegel
+
+// Hegel property tests for go-udiff: the unified diffs it writes must apply
+// with GNU patch and git apply and reproduce the new text; its edits must
+// apply with Apply; ApplyUnified and Merge must agree with them.
+//
+// Needs patch and git.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
diff --git a/hegel/hegel_udiff_test.go b/hegel/hegel_udiff_test.go
new file mode 100644
index 0000000..a0f46eb
--- /dev/null
+++ b/hegel/hegel_udiff_test.go
@@ -0,0 +1,530 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/aymanbagabas/go-udiff"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// lineWords is the alphabet of line contents (without the newline): a few
+// letters, so that the texts repeat and the LCS has choices; blank lines and
+// whitespace-only lines; lines that look like diff syntax; non-ASCII; and a
+// carriage return, which makes a CRLF line.
+var lineWords = []string{
+	"a", "b", "c", "d", "e", "f",
+	"", " ", "\t", "  x", "a ", "a\t",
+	"+", "-", "--- a/f", "+++ b/f", "@@ -1 +1 @@", "\\ No newline at end of file",
+	"é", "日本", "\U0001F600", "é",
+	"a\r", "\r",
+}
+
+func genLine(tc hegel.TestCase) string {
+	if chance(tc, 85) {
+		return pick(tc, lineWords...)
+	}
+	// a longer line
+	k := n(tc, 2, 4)
+	parts := make([]string, k)
+	for i := range parts {
+		parts[i] = pick(tc, lineWords[:6]...)
+	}
+	return strings.Join(parts, " ")
+}
+
+// genLines draws up to eight lines, sometimes up to twenty.
+func genLines(tc hegel.TestCase) []string {
+	k := n(tc, 0, 8)
+	if chance(tc, 20) {
+		k = n(tc, 8, 20)
+	}
+	lines := make([]string, k)
+	for i := range lines {
+		lines[i] = genLine(tc)
+	}
+	return lines
+}
+
+// join makes a text from lines, with or without a final newline.
+func join(lines []string, finalNewline bool) string {
+	if len(lines) == 0 {
+		return ""
+	}
+	s := strings.Join(lines, "\n")
+	if finalNewline {
+		s += "\n"
+	}
+	return s
+}
+
+// mutate derives new lines from old ones with a few edits: replacements,
+// deletions, insertions, moves.
+func mutate(tc hegel.TestCase, lines []string) []string {
+	out := append([]string(nil), lines...)
+	k := n(tc, 1, 3)
+	if chance(tc, 25) {
+		k = n(tc, 3, 7)
+	}
+	for ; k > 0; k-- {
+		switch pick(tc, 0, 1, 2, 3) {
+		case 0: // replace
+			if len(out) > 0 {
+				out[n(tc, 0, len(out)-1)] = genLine(tc)
+			}
+		case 1: // delete
+			if len(out) > 0 {
+				i := n(tc, 0, len(out)-1)
+				out = append(out[:i], out[i+1:]...)
+			}
+		case 2: // insert
+			i := n(tc, 0, len(out))
+			out = append(out[:i], append([]string{genLine(tc)}, out[i:]...)...)
+		case 3: // move a line
+			if len(out) > 1 {
+				i, j := n(tc, 0, len(out)-1), n(tc, 0, len(out)-1)
+				l := out[i]
+				out = append(out[:i], out[i+1:]...)
+				out = append(out[:j], append([]string{l}, out[j:]...)...)
+			}
+		}
+	}
+	return out
+}
+
+// genPair draws an old text and a new one, usually a mutation of it.
+func genPair(tc hegel.TestCase) (old, new string) {
+	oldLines := genLines(tc)
+	var newLines []string
+	if chance(tc, 75) {
+		newLines = mutate(tc, oldLines)
+	} else {
+		newLines = genLines(tc)
+	}
+	return join(oldLines, chance(tc, 70)), join(newLines, chance(tc, 70))
+}
+
+// ---------------------------------------------------------------------------
+// Oracles: GNU patch and git apply on a file holding old.
+
+var scratch string
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "udiff-hegel-")
+	if err != nil {
+		panic(err)
+	}
+	scratch = dir
+	code := m.Run()
+	os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+// applyWith writes old to scratch/f and the diff to scratch/d, runs the
+// tool, and returns f's content afterwards (an absent file reads as "").
+func applyWith(tool string, old, diff string, contextLines int) (string, error) {
+	f := filepath.Join(scratch, "f")
+	d := filepath.Join(scratch, "d")
+	os.Remove(f)
+	os.Remove(filepath.Join(scratch, "f.orig"))
+	os.Remove(filepath.Join(scratch, "f.rej"))
+	if err := os.WriteFile(f, []byte(old), 0o644); err != nil {
+		return "", err
+	}
+	if err := os.WriteFile(d, []byte(diff), 0o644); err != nil {
+		return "", err
+	}
+	var cmd *exec.Cmd
+	switch tool {
+	case "patch":
+		// --binary: no CRLF heuristics; --fuzz=0: hunks must match exactly;
+		// -p1 strips a/ and b/.
+		cmd = exec.Command("patch", "--binary", "--fuzz=0", "-p1", "-s", "-i", d)
+	case "git":
+		args := []string{"apply", "--whitespace=nowarn"}
+		if contextLines == 0 {
+			args = append(args, "--unidiff-zero")
+		}
+		args = append(args, d)
+		cmd = exec.Command("git", args...)
+		cmd.Env = append(os.Environ(), "GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_SYSTEM=/dev/null", "GIT_CEILING_DIRECTORIES="+filepath.Dir(scratch))
+	default:
+		panic(tool)
+	}
+	cmd.Dir = scratch
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	cmd.Stdout = &stderr
+	if err := cmd.Run(); err != nil {
+		return "", fmt.Errorf("%s: %v: %s", tool, err, strings.TrimSpace(stderr.String()))
+	}
+	got, err := os.ReadFile(f)
+	if os.IsNotExist(err) {
+		return "", nil
+	}
+	return string(got), err
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelUnifiedApplies: the unified diff of old and new, with any number
+// of context lines, from line edits or from character edits, applies to old
+// with GNU patch and with git apply and gives new.
+func TestHegelUnifiedApplies(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		old, new := genPair(tc)
+		var edits []udiff.Edit
+		how := "lines"
+		if chance(tc, 30) {
+			edits = udiff.Strings(old, new)
+			how = "strings"
+		} else {
+			edits = udiff.Lines(old, new)
+		}
+		ctx := pick(tc, 3, 3, 0, 1, 2, 5)
+		diff, err := udiff.ToUnified("a/f", "b/f", old, edits, ctx)
+		if err != nil {
+			fail(ht, "ToUnified(%s edits): %v\nold %q\nnew %q", how, err, old, new)
+		}
+		if old == new {
+			if diff != "" {
+				fail(ht, "equal texts, diff %q", diff)
+			}
+			count("equal")
+			return
+		}
+		if diff == "" {
+			fail(ht, "different texts, empty diff (%s)\nold %q\nnew %q", how, old, new)
+		}
+		if ctx == 3 && how == "lines" {
+			if u := udiff.Unified("a/f", "b/f", old, new); u != diff {
+				fail(ht, "Unified differs from ToUnified(Lines, 3)\n%q\n%q", u, diff)
+			}
+		}
+		count("context " + fmt.Sprint(ctx))
+		if id := known(old, new, diff); id != "" {
+			count("known " + id)
+			return
+		}
+		for _, tool := range []string{"patch", "git"} {
+			got, err := applyWith(tool, old, diff, ctx)
+			if err != nil {
+				fail(ht, "%s rejects the diff (%s edits, context %d): %v\nold %q\nnew %q\ndiff:\n%s", tool, how, ctx, err, old, new, diff)
+			}
+			if got != new {
+				fail(ht, "%s gives %q, want %q (%s edits, context %d)\nold %q\ndiff:\n%s", tool, got, new, how, ctx, old, diff)
+			}
+		}
+	})
+}
+
+// genEdits draws sorted, disjoint edits of old at rune boundaries, with
+// replacements that may contain newlines, and the text they produce.
+func genEdits(tc hegel.TestCase, old string) ([]udiff.Edit, string) {
+	var bounds []int
+	for i := 0; i <= len(old); i++ {
+		if i == len(old) || utf8.RuneStart(old[i]) {
+			bounds = append(bounds, i)
+		}
+	}
+	var edits []udiff.Edit
+	var out strings.Builder
+	last := 0
+	for k := n(tc, 1, 4); k > 0; k-- {
+		// choose Start >= last and End >= Start among the boundaries
+		var from []int
+		for _, b := range bounds {
+			if b >= last {
+				from = append(from, b)
+			}
+		}
+		if len(from) == 0 {
+			break
+		}
+		start := pick(tc, from...)
+		end := start
+		if chance(tc, 60) {
+			var ends []int
+			for _, b := range from {
+				if b >= start {
+					ends = append(ends, b)
+				}
+			}
+			end = pick(tc, ends...)
+		}
+		var repl string
+		if chance(tc, 70) {
+			parts := n(tc, 1, 3)
+			for i := 0; i < parts; i++ {
+				repl += pick(tc, lineWords...)
+				if i < parts-1 || chance(tc, 40) {
+					repl += "\n"
+				}
+			}
+		}
+		if start == end && repl == "" {
+			continue // a no-op edit
+		}
+		if len(edits) > 0 && edits[len(edits)-1].End == start && edits[len(edits)-1].Start == start {
+			continue // two insertions at one point: order-dependent
+		}
+		edits = append(edits, udiff.Edit{Start: start, End: end, New: repl})
+		out.WriteString(old[last:start])
+		out.WriteString(repl)
+		last = end
+	}
+	out.WriteString(old[last:])
+	return edits, out.String()
+}
+
+// TestHegelArbitraryEdits: Apply of arbitrary disjoint edits (given in any
+// order) is the replacement, and the unified diff made from them applies
+// with patch and git apply to the same text.
+func TestHegelArbitraryEdits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		old := join(genLines(tc), chance(tc, 70))
+		edits, want := genEdits(tc, old)
+		if len(edits) == 0 {
+			count("no edits")
+			return
+		}
+		count(fmt.Sprintf("%d edits", len(edits)))
+		given := append([]udiff.Edit(nil), edits...)
+		distinct := true
+		for i := 1; i < len(edits); i++ {
+			if edits[i].Start == edits[i-1].Start {
+				distinct = false
+			}
+		}
+		if distinct && chance(tc, 50) {
+			for i := range given {
+				j := n(tc, 0, i)
+				given[i], given[j] = given[j], given[i]
+			}
+		}
+		got, err := udiff.Apply(old, given)
+		if err != nil {
+			fail(ht, "Apply: %v\nold %q\nedits %v", err, old, given)
+		}
+		if got != want {
+			fail(ht, "Apply = %q, want %q\nold %q\nedits %v", got, want, old, given)
+		}
+		ctx := pick(tc, 3, 0, 1, 2)
+		diff, err := udiff.ToUnified("a/f", "b/f", old, given, ctx)
+		if err != nil {
+			fail(ht, "ToUnified: %v\nold %q\nedits %v", err, old, given)
+		}
+		if old == want {
+			// edits that change nothing (a replacement by itself)
+			if diff != "" && !strings.Contains(diff, "\n-") && !strings.Contains(diff, "\n+") {
+				fail(ht, "no-op edits, diff without changes:\n%s", diff)
+			}
+			count("no-op edits")
+			return
+		}
+		if id := known(old, want, diff); id != "" {
+			count("known " + id)
+			return
+		}
+		for _, tool := range []string{"patch", "git"} {
+			res, err := applyWith(tool, old, diff, ctx)
+			if err != nil {
+				fail(ht, "%s rejects the diff (context %d): %v\nold %q\nwant %q\nedits %v\ndiff:\n%s", tool, ctx, err, old, want, given, diff)
+			}
+			if res != want {
+				fail(ht, "%s gives %q, want %q (context %d)\nold %q\nedits %v\ndiff:\n%s", tool, res, want, ctx, old, given, diff)
+			}
+		}
+	})
+}
+
+// TestHegelEditsApply: Lines, Strings and Bytes edits are sorted, disjoint,
+// within bounds, at line or rune boundaries, and Apply gives new.
+func TestHegelEditsApply(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		old, new := genPair(tc)
+		checkEdits := func(how string, edits []udiff.Edit, boundary func(int) bool) {
+			last := 0
+			for i, e := range edits {
+				if e.Start < last || e.End < e.Start || e.End > len(old) {
+					fail(ht, "%s edit %d out of order or bounds: %v (len %d)\nold %q\nnew %q", how, i, e, len(old), old, new)
+				}
+				if e.Start == e.End && e.New == "" {
+					fail(ht, "%s edit %d is a no-op: %v\nold %q\nnew %q", how, i, e, old, new)
+				}
+				if !boundary(e.Start) || !boundary(e.End) {
+					fail(ht, "%s edit %d not on a boundary: %v\nold %q\nnew %q", how, i, e, old, new)
+				}
+				last = e.End
+			}
+			got, err := udiff.Apply(old, edits)
+			if err != nil {
+				fail(ht, "Apply(%s edits): %v\nold %q\nnew %q\nedits %v", how, err, old, new, edits)
+			}
+			if got != new {
+				fail(ht, "Apply(%s edits) = %q, want %q\nold %q\nedits %v", how, got, new, old, edits)
+			}
+		}
+		lineStart := func(i int) bool { return i == 0 || i == len(old) || old[i-1] == '\n' }
+		runeStart := func(i int) bool { return i == len(old) || utf8.RuneStart(old[i]) }
+		checkEdits("Lines", udiff.Lines(old, new), lineStart)
+		checkEdits("Strings", udiff.Strings(old, new), runeStart)
+		// Bytes on the same texts.
+		bedits := udiff.Bytes([]byte(old), []byte(new))
+		got, err := udiff.ApplyBytes([]byte(old), bedits)
+		if err != nil {
+			fail(ht, "ApplyBytes: %v\nold %q\nnew %q\nedits %v", err, old, new, bedits)
+		}
+		if string(got) != new {
+			fail(ht, "ApplyBytes = %q, want %q\nold %q\nedits %v", got, new, old, bedits)
+		}
+		if strings.Contains(old, "\n") && strings.Contains(new, "\n") {
+			count("multi-line")
+		}
+		if !utf8.ValidString(old) || !utf8.ValidString(new) {
+			count("invalid UTF-8")
+		}
+	})
+}
+
+// TestHegelApplyUnified: the package's own ApplyUnified inverts Unified.
+func TestHegelApplyUnified(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		old, new := genPair(tc)
+		diff := udiff.Unified("a/f", "b/f", old, new)
+		if id := knownApplyUnified(old, new, diff); id != "" {
+			count("known " + id)
+			return
+		}
+		got, err := udiff.ApplyUnified(diff, old)
+		if err != nil {
+			fail(ht, "ApplyUnified: %v\nold %q\nnew %q\ndiff:\n%s", err, old, new, diff)
+		}
+		if got != new {
+			fail(ht, "ApplyUnified = %q, want %q\nold %q\ndiff:\n%s", got, new, old, diff)
+		}
+	})
+}
+
+// TestHegelMerge: two edit lists changing different lines of a text of
+// distinct lines merge (or are reported as a conflict) and the merge applies
+// to the combined result; Merge(x, x) and Merge(x, nil) are x.
+func TestHegelMerge(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := n(tc, 1, 8)
+		lines := make([]string, k)
+		for i := range lines {
+			lines[i] = fmt.Sprintf("line %d", i)
+		}
+		old := join(lines, true)
+		// Each of the two sides changes some lines, disjoint sets.
+		side := func(taken map[int]bool) ([]string, string) {
+			out := append([]string(nil), lines...)
+			var ops []string
+			for tries := n(tc, 1, 3); tries > 0; tries-- {
+				i := n(tc, 0, k-1)
+				if taken[i] {
+					continue
+				}
+				taken[i] = true
+				switch pick(tc, "replace", "delete", "insert") {
+				case "replace":
+					out[i] = fmt.Sprintf("changed %d %s", i, pick(tc, "x", "y"))
+					ops = append(ops, fmt.Sprintf("replace %d", i))
+				case "delete":
+					out[i] = ""
+					ops = append(ops, fmt.Sprintf("delete %d", i))
+				case "insert":
+					out[i] = fmt.Sprintf("inserted before %d %s\n%s", i, pick(tc, "x", "y"), out[i])
+					ops = append(ops, fmt.Sprintf("insert %d", i))
+				}
+			}
+			return out, strings.Join(ops, ", ")
+		}
+		text := func(ls []string) string {
+			var b strings.Builder
+			for _, l := range ls {
+				if l != "" {
+					b.WriteString(l + "\n")
+				}
+			}
+			return b.String()
+		}
+		taken := map[int]bool{}
+		xl, xops := side(taken)
+		yl, yops := side(taken)
+		if chance(tc, 20) {
+			// Both sides replace one line differently: a conflict, which
+			// Merge must report.
+			i := n(tc, 0, k-1)
+			xl[i] = fmt.Sprintf("changed %d x", i)
+			yl[i] = fmt.Sprintf("changed %d y", i)
+			x, y := udiff.Lines(old, text(xl)), udiff.Lines(old, text(yl))
+			if merged, ok := udiff.Merge(x, y); ok {
+				got, err := udiff.Apply(old, merged)
+				fail(ht, "Merge of conflicting edits succeeded: %v (Apply: %q, %v)\nold %q\nx %v\ny %v", merged, got, err, old, x, y)
+			}
+			count("conflict reported")
+			return
+		}
+		// Combined: per line, whichever side changed it.
+		both := make([]string, k)
+		for i := range lines {
+			both[i] = lines[i]
+			if xl[i] != lines[i] {
+				both[i] = xl[i]
+			}
+			if yl[i] != lines[i] {
+				both[i] = yl[i]
+			}
+		}
+		xt, yt, bt := text(xl), text(yl), text(both)
+		x, y := udiff.Lines(old, xt), udiff.Lines(old, yt)
+		merged, ok := udiff.Merge(x, y)
+		if !ok {
+			count("conflict")
+			return
+		}
+		count("merged")
+		got, err := udiff.Apply(old, merged)
+		if err != nil {
+			fail(ht, "Apply(merged): %v\nold %q\nx (%s) %v\ny (%s) %v\nmerged %v", err, old, xops, x, yops, y, merged)
+		}
+		if got != bt {
+			fail(ht, "Apply(merged) = %q, want %q\nold %q\nx (%s) %v\ny (%s) %v\nmerged %v", got, bt, old, xops, x, yops, y, merged)
+		}
+		if m, ok := udiff.Merge(x, x); !ok || !sameEdits(m, x) {
+			fail(ht, "Merge(x, x) = %v, %v; want x = %v", m, ok, x)
+		}
+		if m, ok := udiff.Merge(x, nil); !ok || !sameEdits(m, x) {
+			fail(ht, "Merge(x, nil) = %v, %v; want x = %v", m, ok, x)
+		}
+	})
+}
+
+func sameEdits(a, b []udiff.Edit) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
