@@ -0,0 +1,71 @@
+package hegel
+
+import (
+	"os"
+	"strings"
+)
+
+// Gates for the recorded bugs (bugs.toml). A case that has a known bug's
+// shape is counted, not judged. HEGEL_NO_KNOWN=1 disables the gates.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// known returns the id of a recorded bug whose shape the unified diff of
+// old and new has, or "".
+func known(old, new, diff string) string {
+	if noKnown {
+		return ""
+	}
+	if emptyRangeClaimsOneLine(diff) {
+		return "go-udiff/1"
+	}
+	return ""
+}
+
+// emptyRangeClaimsOneLine reports whether a hunk header writes a side
+// without a count (one line) while the hunk has no line on that side.
+func emptyRangeClaimsOneLine(diff string) bool {
+	lines := strings.Split(diff, "\n")
+	for i := 0; i < len(lines); i++ {
+		h := lines[i]
+		if !strings.HasPrefix(h, "@@ ") {
+			continue
+		}
+		from, to := 0, 0
+		for j := i + 1; j < len(lines) && !strings.HasPrefix(lines[j], "@@ "); j++ {
+			switch {
+			case strings.HasPrefix(lines[j], "-"):
+				from++
+			case strings.HasPrefix(lines[j], "+"):
+				to++
+			case strings.HasPrefix(lines[j], " "):
+				from++
+				to++
+			}
+		}
+		fields := strings.Fields(h) // "@@", "-a[,b]", "+c[,d]", "@@"
+		if len(fields) < 4 {
+			continue
+		}
+		if !strings.Contains(fields[1], ",") && from == 0 || !strings.Contains(fields[2], ",") && to == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// knownApplyUnified is the gate for ApplyUnified.
+func knownApplyUnified(old, new, diff string) string {
+	if noKnown {
+		return ""
+	}
+	for _, l := range strings.Split(diff, "\n") {
+		if strings.HasPrefix(l, " ") {
+			return "go-udiff/2"
+		}
+	}
+	if strings.Contains(diff, "\n\\ No newline at end of file\n") {
+		return "go-udiff/3"
+	}
+	return ""
+}
