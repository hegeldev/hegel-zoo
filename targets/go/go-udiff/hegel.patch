diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..2d89735
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,106 @@
+package hegel
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/aymanbagabas/go-udiff"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are GNU diff's headers, what GNU patch
+// and git apply accept, and the documented behaviour.
+
+func hunkHeader(t *testing.T, diff string) string {
+	t.Helper()
+	for _, l := range strings.Split(diff, "\n") {
+		if strings.HasPrefix(l, "@@") {
+			return l
+		}
+	}
+	t.Fatalf("no hunk header in %q", diff)
+	return ""
+}
+
+// go-udiff/1: with zero context lines, a hunk that only deletes or only
+// inserts has an empty range on one side, which the unified format writes
+// as "N,0" (GNU diff -U0: "@@ -2 +1,0 @@"); the package writes "+2", a range
+// of one line, and patch and git apply reject the diff as malformed.
+func TestHegelPinZeroContextEmptyRange(t *testing.T) {
+	old, new := "a\nb\nc\n", "a\nc\n"
+	d, err := udiff.ToUnified("a/f", "b/f", old, udiff.Lines(old, new), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h := hunkHeader(t, d); h != "@@ -2 +1,0 @@" {
+		t.Errorf("deleting line 2 with no context: header %q; GNU diff -U0 writes %q, and patch rejects the package's diff as malformed", h, "@@ -2 +1,0 @@")
+	}
+	old, new = "a\nc\n", "a\nb\nc\n"
+	d, err = udiff.ToUnified("a/f", "b/f", old, udiff.Lines(old, new), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h := hunkHeader(t, d); h != "@@ -1,0 +2 @@" {
+		t.Errorf("inserting a line 2 with no context: header %q; GNU diff -U0 writes %q", h, "@@ -1,0 +2 @@")
+	}
+}
+
+// go-udiff/2: ApplyUnified rejects context lines, so it cannot apply any
+// diff Unified makes of a file with an unchanged line near a change.
+func TestHegelPinApplyUnifiedContextLines(t *testing.T) {
+	old, new := "a\nb\nc\n", "a\nB\nc\n"
+	d := udiff.Unified("a/f", "b/f", old, new)
+	got, err := udiff.ApplyUnified(d, old)
+	if err != nil {
+		t.Fatalf("ApplyUnified(Unified(old, new), old): %v\n%s", err, d)
+	}
+	if got != new {
+		t.Errorf("ApplyUnified = %q, want %q", got, new)
+	}
+}
+
+// go-udiff/3: ApplyUnified rejects the "\ No newline at end of file" marker
+// that Unified writes for texts without a final newline.
+func TestHegelPinApplyUnifiedNoNewlineMarker(t *testing.T) {
+	for _, c := range []struct{ old, new string }{{"a", "b"}, {"a\n", "a"}, {"a", "a\n"}} {
+		d := udiff.Unified("a/f", "b/f", c.old, c.new)
+		got, err := udiff.ApplyUnified(d, c.old)
+		if err != nil {
+			t.Errorf("ApplyUnified(Unified(%q, %q)): %v\n%s", c.old, c.new, err, d)
+			continue
+		}
+		if got != c.new {
+			t.Errorf("ApplyUnified(Unified(%q, %q)) = %q", c.old, c.new, got)
+		}
+	}
+}
+
+// go-udiff/4: Bytes decodes its inputs as UTF-8 and works on the runes, so
+// bytes that are not UTF-8 all become U+FFFD: two different slices compare
+// equal, and an edit's New carries the replacement character instead of the
+// bytes of after.
+func TestHegelPinBytesNotUTF8(t *testing.T) {
+	if e := udiff.Bytes([]byte("\xff"), []byte("\x80")); len(e) == 0 {
+		t.Errorf("Bytes(%q, %q) = no edits; the slices differ", "\xff", "\x80")
+	}
+	before, after := []byte("a\n"), []byte("\xff\n")
+	got, err := udiff.ApplyBytes(before, udiff.Bytes(before, after))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, after) {
+		t.Errorf("ApplyBytes(before, Bytes(before, after)) = %q, want after = %q", got, after)
+	}
+	// Offsets are computed from the runes' UTF-8 lengths, so a byte that is
+	// not UTF-8 (1 byte, read as U+FFFD, 3 bytes) shifts the edits past the
+	// end of the slice.
+	before, after = []byte("a\xffb\n"), []byte("a\xffc\n")
+	e := udiff.Bytes(before, after)
+	got, err = udiff.ApplyBytes(before, e)
+	if err != nil {
+		t.Errorf("ApplyBytes(%q, Bytes(...) = %v): %v", before, e, err)
+	} else if !bytes.Equal(got, after) {
+		t.Errorf("ApplyBytes(%q, %v) = %q, want %q", before, e, got, after)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..72c974c
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,86 @@
+package hegel
+
+// Hegel property tests for go-udiff: the unified diffs it writes must apply
+// with GNU patch and git apply and reproduce the new text; its edits must
+// apply with Apply; ApplyUnified and Merge must agree with them.
+//
+// Needs patch and git.
+
+import (
+	"os"
+	"reflect"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness: hegel-go reads no environment variable, so HEGEL_TEST_CASES goes
+// through hegelOpts; a panic in the code under test is turned into a failure
+// of the current case (hegel-go would re-raise it after shrinking and abort
+// the test binary).
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// ---------------------------------------------------------------------------
+// Generator helpers.
+
+// weighted chooses among generators in proportion to integer weights with
+// one draw; it shrinks towards the first choice, so the simplest comes first.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x < pct })
+}
diff --git a/hegel/hegel_udiff_test.go b/hegel/hegel_udiff_test.go
new file mode 100644
index 0000000..388a168
--- /dev/null
+++ b/hegel/hegel_udiff_test.go
@@ -0,0 +1,607 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/aymanbagabas/go-udiff"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Generators. The drawn values are small data (lines, edit lists, flags);
+// pure functions render them into texts and edits.
+
+// lineWords is the alphabet of line contents (without the newline): a few
+// letters, so that the texts repeat and the LCS has choices; blank lines and
+// whitespace-only lines; lines that look like diff syntax; non-ASCII; and a
+// carriage return, which makes a CRLF line.
+var lineWords = []string{
+	"a", "b", "c", "d", "e", "f",
+	"", " ", "\t", "  x", "a ", "a\t",
+	"+", "-", "--- a/f", "+++ b/f", "@@ -1 +1 @@", "\\ No newline at end of file",
+	"é", "日本", "\U0001F600", "e\u0301", // the decomposed form of the first accented word
+	"a\r", "\r",
+}
+
+var (
+	word     = hegel.SampledFrom(lineWords)
+	longLine = hegel.Map(hegel.Lists(hegel.SampledFrom(lineWords[:6])).MinSize(2).MaxSize(4), func(ws []string) string { return strings.Join(ws, " ") })
+	line     = weighted(choice[string]{85, word}, choice[string]{15, longLine})
+	// lines: up to eight, sometimes eight to twenty.
+	lines = weighted(choice[[]string]{80, hegel.Lists(line).MaxSize(8)}, choice[[]string]{20, hegel.Lists(line).MinSize(8).MaxSize(20)})
+)
+
+// doc is a text: its lines, and whether the last one lacks its newline.
+type doc struct {
+	lines          []string
+	noFinalNewline bool
+}
+
+func (d doc) String() string { return join(d.lines, !d.noFinalNewline) }
+
+var docs = hegel.Composite(func(tc hegel.TestCase) doc {
+	return doc{hegel.Draw(tc, lines), hegel.Draw(tc, chance(30))}
+})
+
+// join makes a text from lines, with or without a final newline.
+func join(lines []string, finalNewline bool) string {
+	if len(lines) == 0 {
+		return ""
+	}
+	s := strings.Join(lines, "\n")
+	if finalNewline {
+		s += "\n"
+	}
+	return s
+}
+
+// lineEdit is one change to a list of lines; positions are taken modulo the
+// live number of lines when it is applied.
+type lineEdit struct {
+	op     string // replace, delete, insert, move
+	at, to int
+	line   string
+}
+
+var (
+	position = hegel.Integers(0, 23)
+	replaces = hegel.Composite(func(tc hegel.TestCase) lineEdit {
+		return lineEdit{op: "replace", at: hegel.Draw(tc, position), line: hegel.Draw(tc, line)}
+	})
+	deletes = hegel.Map(position, func(i int) lineEdit { return lineEdit{op: "delete", at: i} })
+	inserts = hegel.Composite(func(tc hegel.TestCase) lineEdit {
+		return lineEdit{op: "insert", at: hegel.Draw(tc, position), line: hegel.Draw(tc, line)}
+	})
+	moves = hegel.Composite(func(tc hegel.TestCase) lineEdit {
+		return lineEdit{op: "move", at: hegel.Draw(tc, position), to: hegel.Draw(tc, position)}
+	})
+	lineEdits = hegel.OneOf(replaces, deletes, inserts, moves)
+	// a few edits, sometimes several
+	edits = weighted(
+		choice[[]lineEdit]{75, hegel.Lists(lineEdits).MinSize(1).MaxSize(3)},
+		choice[[]lineEdit]{25, hegel.Lists(lineEdits).MinSize(3).MaxSize(7)},
+	)
+)
+
+// mutate applies the edits to the lines.
+func mutate(lines []string, edits []lineEdit) []string {
+	out := slices.Clone(lines)
+	for _, e := range edits {
+		switch e.op {
+		case "replace":
+			if len(out) > 0 {
+				out[e.at%len(out)] = e.line
+			}
+		case "delete":
+			if len(out) > 0 {
+				i := e.at % len(out)
+				out = slices.Delete(out, i, i+1)
+			}
+		case "insert":
+			out = slices.Insert(out, e.at%(len(out)+1), e.line)
+		case "move":
+			if len(out) > 1 {
+				i, j := e.at%len(out), e.to%len(out)
+				l := out[i]
+				out = slices.Delete(out, i, i+1)
+				out = slices.Insert(out, j, l)
+			}
+		}
+	}
+	return out
+}
+
+// newLines says where the new text's lines come from: edits of the old
+// lines, or an independent list.
+type newLines struct {
+	edits       []lineEdit
+	fresh       []string
+	independent bool
+}
+
+// pair is an old text and a new one, usually a mutation of it.
+type pair struct {
+	old               doc
+	new               newLines
+	newNoFinalNewline bool
+}
+
+func (p pair) texts() (old, new string) {
+	nl := p.new.fresh
+	if !p.new.independent {
+		nl = mutate(p.old.lines, p.new.edits)
+	}
+	return p.old.String(), join(nl, !p.newNoFinalNewline)
+}
+
+var (
+	derived     = hegel.Map(edits, func(es []lineEdit) newLines { return newLines{edits: es} })
+	independent = hegel.Map(lines, func(ls []string) newLines { return newLines{fresh: ls, independent: true} })
+	newTexts    = weighted(choice[newLines]{75, derived}, choice[newLines]{25, independent})
+	pairs       = hegel.Composite(func(tc hegel.TestCase) pair {
+		return pair{old: hegel.Draw(tc, docs), new: hegel.Draw(tc, newTexts), newNoFinalNewline: hegel.Draw(tc, chance(30))}
+	})
+)
+
+// ---------------------------------------------------------------------------
+// Oracles: GNU patch and git apply on a file holding old.
+
+var scratch string
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "udiff-hegel-")
+	if err != nil {
+		panic(err)
+	}
+	scratch = dir
+	code := m.Run()
+	os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+// applyWith writes old to scratch/f and the diff to scratch/d, runs the
+// tool, and returns f's content afterwards (an absent file reads as "").
+func applyWith(tool string, old, diff string, contextLines int) (string, error) {
+	f := filepath.Join(scratch, "f")
+	d := filepath.Join(scratch, "d")
+	os.Remove(f)
+	os.Remove(filepath.Join(scratch, "f.orig"))
+	os.Remove(filepath.Join(scratch, "f.rej"))
+	if err := os.WriteFile(f, []byte(old), 0o644); err != nil {
+		return "", err
+	}
+	if err := os.WriteFile(d, []byte(diff), 0o644); err != nil {
+		return "", err
+	}
+	var cmd *exec.Cmd
+	switch tool {
+	case "patch":
+		// --binary: no CRLF heuristics; --fuzz=0: hunks must match exactly;
+		// -p1 strips a/ and b/.
+		cmd = exec.Command("patch", "--binary", "--fuzz=0", "-p1", "-s", "-i", d)
+	case "git":
+		args := []string{"apply", "--whitespace=nowarn"}
+		if contextLines == 0 {
+			args = append(args, "--unidiff-zero")
+		}
+		args = append(args, d)
+		cmd = exec.Command("git", args...)
+		cmd.Env = append(os.Environ(), "GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_SYSTEM=/dev/null", "GIT_CEILING_DIRECTORIES="+filepath.Dir(scratch))
+	default:
+		panic(tool)
+	}
+	cmd.Dir = scratch
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	cmd.Stdout = &stderr
+	if err := cmd.Run(); err != nil {
+		return "", fmt.Errorf("%s: %v: %s", tool, err, strings.TrimSpace(stderr.String()))
+	}
+	got, err := os.ReadFile(f)
+	if os.IsNotExist(err) {
+		return "", nil
+	}
+	return string(got), err
+}
+
+// applies checks that patch and git apply both accept the diff on old and
+// leave new.
+func applies(ht *hegel.T, old, new, diff string, ctx int, what string) {
+	for _, tool := range []string{"patch", "git"} {
+		got, err := applyWith(tool, old, diff, ctx)
+		if err != nil {
+			ht.Fatalf("%s rejects the diff (%s, context %d): %v\nold %q\nnew %q\ndiff:\n%s", tool, what, ctx, err, old, new, diff)
+		}
+		if got != new {
+			ht.Fatalf("%s gives %q, want %q (%s, context %d)\nold %q\ndiff:\n%s", tool, got, new, what, ctx, old, diff)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+var (
+	// the edits a unified diff is made from: line edits, or character edits
+	differs  = weighted(choice[string]{70, hegel.Just("lines")}, choice[string]{30, hegel.Just("strings")})
+	contexts = hegel.SampledFrom([]int{3, 3, 0, 1, 2, 5})
+)
+
+// TestHegelUnifiedApplies: the unified diff of old and new, with any number
+// of context lines, from line edits or from character edits, applies to old
+// with GNU patch and with git apply and gives new.
+func TestHegelUnifiedApplies(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		old, new := hegel.Draw(ht, pairs).texts()
+		how := hegel.Draw(ht, differs)
+		ctx := hegel.Draw(ht, contexts)
+		edits := udiff.Lines(old, new)
+		if how == "strings" {
+			edits = udiff.Strings(old, new)
+		}
+		diff, err := udiff.ToUnified("a/f", "b/f", old, edits, ctx)
+		if err != nil {
+			ht.Fatalf("ToUnified(%s edits): %v\nold %q\nnew %q", how, err, old, new)
+		}
+		if old == new {
+			if diff != "" {
+				ht.Fatalf("equal texts, diff %q", diff)
+			}
+			return
+		}
+		if diff == "" {
+			ht.Fatalf("different texts, empty diff (%s)\nold %q\nnew %q", how, old, new)
+		}
+		if ctx == 3 && how == "lines" {
+			if u := udiff.Unified("a/f", "b/f", old, new); u != diff {
+				ht.Fatalf("Unified differs from ToUnified(Lines, 3)\n%q\n%q", u, diff)
+			}
+		}
+		ht.Assume(known(old, new, diff) == "")
+		applies(ht, old, new, diff, ctx, how+" edits")
+	})
+}
+
+// editSpec places one edit of a text: start is the at-th rune boundary at
+// or after the previous edit's end, span counts boundaries from there to the
+// end (0: an insertion), repl is the replacement, and key orders the edits
+// as they are given to Apply.
+type editSpec struct {
+	at, span int
+	repl     string
+	key      int
+}
+
+var (
+	// a replacement: nothing, or one to three lines, the last with or
+	// without its newline
+	replacement = weighted(
+		choice[string]{30, hegel.Just("")},
+		choice[string]{70, hegel.Composite(func(tc hegel.TestCase) string {
+			s := strings.Join(hegel.Draw(tc, hegel.Lists(word).MinSize(1).MaxSize(3)), "\n")
+			if hegel.Draw(tc, chance(40)) {
+				s += "\n"
+			}
+			return s
+		})},
+	)
+	span      = weighted(choice[int]{40, hegel.Just(0)}, choice[int]{60, hegel.Integers(1, 24)})
+	editSpecs = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) editSpec {
+		return editSpec{
+			at:   hegel.Draw(tc, hegel.Integers(0, 47)),
+			span: hegel.Draw(tc, span),
+			repl: hegel.Draw(tc, replacement),
+			key:  hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})).MinSize(1).MaxSize(4)
+)
+
+// place turns the specs into sorted, disjoint edits of old at rune
+// boundaries, their keys, and the text they produce. A no-op edit and a
+// second insertion at the same point (order-dependent) are dropped.
+func place(old string, specs []editSpec) ([]udiff.Edit, []int, string) {
+	var bounds []int
+	for i := 0; i <= len(old); i++ {
+		if i == len(old) || utf8.RuneStart(old[i]) {
+			bounds = append(bounds, i)
+		}
+	}
+	var edits []udiff.Edit
+	var keys []int
+	var out strings.Builder
+	last := 0
+	for _, s := range specs {
+		from := bounds[sort.SearchInts(bounds, last):] // boundaries at or after last; len(old) is one
+		si := s.at % len(from)
+		start := from[si]
+		rest := from[si:]
+		end := rest[s.span%len(rest)]
+		if start == end && s.repl == "" {
+			continue
+		}
+		if n := len(edits); n > 0 && edits[n-1].End == start && edits[n-1].Start == start {
+			continue
+		}
+		edits = append(edits, udiff.Edit{Start: start, End: end, New: s.repl})
+		keys = append(keys, s.key)
+		out.WriteString(old[last:start])
+		out.WriteString(s.repl)
+		last = end
+	}
+	out.WriteString(old[last:])
+	return edits, keys, out.String()
+}
+
+// ordered gives the edits in the order of their keys (a stable sort, so
+// equal keys keep the sorted order) when their starts are distinct; two
+// edits at one start are order-dependent and stay as they are.
+func ordered(edits []udiff.Edit, keys []int) []udiff.Edit {
+	for i := 1; i < len(edits); i++ {
+		if edits[i].Start == edits[i-1].Start {
+			return slices.Clone(edits)
+		}
+	}
+	idx := make([]int, len(edits))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.SliceStable(idx, func(i, j int) bool { return keys[idx[i]] < keys[idx[j]] })
+	given := make([]udiff.Edit, len(edits))
+	for i, j := range idx {
+		given[i] = edits[j]
+	}
+	return given
+}
+
+var editContexts = hegel.SampledFrom([]int{3, 0, 1, 2})
+
+// TestHegelArbitraryEdits: Apply of arbitrary disjoint edits (given in any
+// order) is the replacement, and the unified diff made from them applies
+// with patch and git apply to the same text.
+func TestHegelArbitraryEdits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		old := hegel.Draw(ht, docs).String()
+		edits, keys, want := place(old, hegel.Draw(ht, editSpecs))
+		ht.Assume(len(edits) > 0)
+		given := ordered(edits, keys)
+		got, err := udiff.Apply(old, given)
+		if err != nil {
+			ht.Fatalf("Apply: %v\nold %q\nedits %v", err, old, given)
+		}
+		if got != want {
+			ht.Fatalf("Apply = %q, want %q\nold %q\nedits %v", got, want, old, given)
+		}
+		ctx := hegel.Draw(ht, editContexts)
+		diff, err := udiff.ToUnified("a/f", "b/f", old, given, ctx)
+		if err != nil {
+			ht.Fatalf("ToUnified: %v\nold %q\nedits %v", err, old, given)
+		}
+		if old == want {
+			// edits that change nothing (a replacement by itself)
+			if diff != "" && !strings.Contains(diff, "\n-") && !strings.Contains(diff, "\n+") {
+				ht.Fatalf("no-op edits, diff without changes:\n%s", diff)
+			}
+			return
+		}
+		ht.Assume(known(old, want, diff) == "")
+		applies(ht, old, want, diff, ctx, fmt.Sprintf("%d edits %v", len(given), given))
+	})
+}
+
+var differences = hegel.SampledFrom([]string{"Lines", "Strings", "Bytes"})
+
+// TestHegelEditsApply: Lines, Strings and Bytes edits are sorted, disjoint,
+// within bounds, at line or rune boundaries, never no-ops, and Apply (or
+// ApplyBytes) gives new.
+func TestHegelEditsApply(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		old, new := hegel.Draw(ht, pairs).texts()
+		how := hegel.Draw(ht, differences)
+		lineStart := func(i int) bool { return i == 0 || i == len(old) || old[i-1] == '\n' }
+		runeStart := func(i int) bool { return i == len(old) || utf8.RuneStart(old[i]) }
+		var edits []udiff.Edit
+		boundary := runeStart
+		switch how {
+		case "Lines":
+			edits, boundary = udiff.Lines(old, new), lineStart
+		case "Strings":
+			edits = udiff.Strings(old, new)
+		case "Bytes":
+			edits = udiff.Bytes([]byte(old), []byte(new))
+		}
+		last := 0
+		for i, e := range edits {
+			if e.Start < last || e.End < e.Start || e.End > len(old) {
+				ht.Fatalf("%s edit %d out of order or bounds: %v (len %d)\nold %q\nnew %q", how, i, e, len(old), old, new)
+			}
+			if e.Start == e.End && e.New == "" {
+				ht.Fatalf("%s edit %d is a no-op: %v\nold %q\nnew %q", how, i, e, old, new)
+			}
+			if !boundary(e.Start) || !boundary(e.End) {
+				ht.Fatalf("%s edit %d not on a boundary: %v\nold %q\nnew %q", how, i, e, old, new)
+			}
+			last = e.End
+		}
+		var got string
+		var err error
+		if how == "Bytes" {
+			var b []byte
+			b, err = udiff.ApplyBytes([]byte(old), edits)
+			got = string(b)
+		} else {
+			got, err = udiff.Apply(old, edits)
+		}
+		if err != nil {
+			ht.Fatalf("Apply(%s edits): %v\nold %q\nnew %q\nedits %v", how, err, old, new, edits)
+		}
+		if got != new {
+			ht.Fatalf("Apply(%s edits) = %q, want %q\nold %q\nedits %v", how, got, new, old, edits)
+		}
+	})
+}
+
+// disjointPairs: old and new share no line and both end with a newline, so
+// Unified writes neither a context line nor the no-newline marker: the
+// shape ApplyUnified can apply while go-udiff/2 and /3 are open. The rest
+// of the domain still comes through pairs (and is discarded while known).
+var (
+	oldOnly       = hegel.Lists(hegel.SampledFrom(lineWords[:12])).MaxSize(8)
+	newOnly       = hegel.Lists(hegel.SampledFrom(lineWords[12:])).MaxSize(8)
+	disjointPairs = hegel.Composite(func(tc hegel.TestCase) pair {
+		return pair{old: doc{lines: hegel.Draw(tc, oldOnly)}, new: newLines{fresh: hegel.Draw(tc, newOnly), independent: true}}
+	})
+	applyUnifiedPairs = weighted(choice[pair]{75, disjointPairs}, choice[pair]{25, pairs})
+)
+
+// TestHegelApplyUnified: the package's own ApplyUnified inverts Unified.
+func TestHegelApplyUnified(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		old, new := hegel.Draw(ht, applyUnifiedPairs).texts()
+		diff := udiff.Unified("a/f", "b/f", old, new)
+		ht.Assume(knownApplyUnified(old, new, diff) == "")
+		got, err := udiff.ApplyUnified(diff, old)
+		if err != nil {
+			ht.Fatalf("ApplyUnified: %v\nold %q\nnew %q\ndiff:\n%s", err, old, new, diff)
+		}
+		if got != new {
+			ht.Fatalf("ApplyUnified = %q, want %q\nold %q\ndiff:\n%s", got, new, old, diff)
+		}
+	})
+}
+
+// lineOp is one side's change of one line of the merge base: the line is
+// taken modulo the number of lines; a line already changed is skipped.
+type lineOp struct {
+	at int
+	op string // replace, delete, insert
+	v  string // x or y, so that the two sides' texts differ
+}
+
+var lineOps = hegel.Composite(func(tc hegel.TestCase) lineOp {
+	return lineOp{
+		at: hegel.Draw(tc, hegel.Integers(0, 7)),
+		op: hegel.Draw(tc, hegel.SampledFrom([]string{"replace", "delete", "insert"})),
+		v:  hegel.Draw(tc, hegel.SampledFrom([]string{"x", "y"})),
+	}
+})
+
+// mergeCase: a base of k distinct lines, each side's ops, and whether both
+// sides also replace one line differently (a conflict).
+type mergeCase struct {
+	k          int
+	x, y       []lineOp
+	conflict   bool
+	conflictAt int
+}
+
+var mergeCases = hegel.Composite(func(tc hegel.TestCase) mergeCase {
+	return mergeCase{
+		k:          hegel.Draw(tc, hegel.Integers(1, 8)),
+		x:          hegel.Draw(tc, hegel.Lists(lineOps).MinSize(1).MaxSize(3)),
+		y:          hegel.Draw(tc, hegel.Lists(lineOps).MinSize(1).MaxSize(3)),
+		conflict:   hegel.Draw(tc, chance(20)),
+		conflictAt: hegel.Draw(tc, hegel.Integers(0, 7)),
+	}
+})
+
+// sides renders the base lines and each side's lines; the two sides change
+// disjoint lines (x's ops take theirs first). A deleted line is "".
+func (m mergeCase) sides() (base, xl, yl []string) {
+	base = make([]string, m.k)
+	for i := range base {
+		base[i] = fmt.Sprintf("line %d", i)
+	}
+	taken := map[int]bool{}
+	apply := func(ops []lineOp) []string {
+		out := slices.Clone(base)
+		for _, o := range ops {
+			i := o.at % m.k
+			if taken[i] {
+				continue
+			}
+			taken[i] = true
+			switch o.op {
+			case "replace":
+				out[i] = fmt.Sprintf("changed %d %s", i, o.v)
+			case "delete":
+				out[i] = ""
+			case "insert":
+				out[i] = fmt.Sprintf("inserted before %d %s\n%s", i, o.v, out[i])
+			}
+		}
+		return out
+	}
+	xl = apply(m.x)
+	yl = apply(m.y)
+	if m.conflict {
+		i := m.conflictAt % m.k
+		xl[i] = fmt.Sprintf("changed %d x", i)
+		yl[i] = fmt.Sprintf("changed %d y", i)
+	}
+	return base, xl, yl
+}
+
+// text joins the lines that are left with newlines.
+func text(ls []string) string {
+	var b strings.Builder
+	for _, l := range ls {
+		if l != "" {
+			b.WriteString(l + "\n")
+		}
+	}
+	return b.String()
+}
+
+// TestHegelMerge: two edit lists changing different lines of a text of
+// distinct lines merge and the merge applies to the combined result; both
+// sides replacing one line differently is reported as a conflict;
+// Merge(x, x) and Merge(x, nil) are x.
+func TestHegelMerge(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, mergeCases)
+		base, xl, yl := m.sides()
+		old := join(base, true)
+		x, y := udiff.Lines(old, text(xl)), udiff.Lines(old, text(yl))
+		if m.conflict {
+			if merged, ok := udiff.Merge(x, y); ok {
+				got, err := udiff.Apply(old, merged)
+				ht.Fatalf("Merge of conflicting edits succeeded: %v (Apply: %q, %v)\nold %q\nx %v\ny %v", merged, got, err, old, x, y)
+			}
+			return
+		}
+		// Combined: per line, whichever side changed it.
+		both := slices.Clone(base)
+		for i := range base {
+			if xl[i] != base[i] {
+				both[i] = xl[i]
+			}
+			if yl[i] != base[i] {
+				both[i] = yl[i]
+			}
+		}
+		merged, ok := udiff.Merge(x, y)
+		ht.Assume(ok) // never seen: disjoint line changes do not overlap
+		got, err := udiff.Apply(old, merged)
+		if err != nil {
+			ht.Fatalf("Apply(merged): %v\nold %q\nx %v\ny %v\nmerged %v", err, old, x, y, merged)
+		}
+		if got != text(both) {
+			ht.Fatalf("Apply(merged) = %q, want %q\nold %q\nx %v\ny %v\nmerged %v", got, text(both), old, x, y, merged)
+		}
+		if mm, ok := udiff.Merge(x, x); !ok || !slices.Equal(mm, x) {
+			ht.Fatalf("Merge(x, x) = %v, %v; want x = %v", mm, ok, x)
+		}
+		if mm, ok := udiff.Merge(x, nil); !ok || !slices.Equal(mm, x) {
+			ht.Fatalf("Merge(x, nil) = %v, %v; want x = %v", mm, ok, x)
+		}
+	})
+}
