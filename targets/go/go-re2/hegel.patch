+package re2_test
+
+// Hegel property tests for wasilibs/go-re2, written for the Hegel zoo.
+// See targets/go/go-re2/README.md.
+//
+// Oracle: the standard library's regexp package. go-re2 is documented as a drop-in replacement
+// for it ("almost fully compatible ... with just a few behavior differences": invalid UTF-8 in
+// the input, and reflect.DeepEqual on Regexp values), and both implement the RE2 syntax with
+// leftmost-first (or, after Longest, leftmost-longest) semantics, so on a pattern both accept
+// and a valid UTF-8 text every method must return the same value. The generator draws patterns
+// from the shared grammar; a small list of documented or upstream-RE2 syntax differences
+// (`\C`, huge repeat counts, non-ASCII group names, `\p{Cn}`) is kept out of it.
+//
+// A case is drawn as data: the pattern is a small syntax tree rendered to its source by a pure
+// function (hegel_gen_test.go), the text a string over a fixed alphabet, the replacement
+// template a list of pieces; each property draws one record holding them.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). The shapes of the recorded bugs are drawn by default and switched
+// off by HEGEL_NO_KNOWN=1 (see the end of this file).
+
+import (
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time. WeightedBooleans shrinks toward
+// false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// The shapes of the recorded bugs (bugs.toml). By default the properties draw them and fail on
+// them, naming the shape: the property that found a bug is its expected failure, mapped to the
+// bug, and the pin in hegel_pins_test.go is the regression example beside it (STYLE.md rule
+// 11); each bug also has a property over its shape region alone (hegel_shapes_test.go).
+// HEGEL_NO_KNOWN=1 switches the known shapes off, for a run that looks past the bugs: the
+// generators then leave the limit 0 out (go-re2/1), draw no character above U+007F beside \B
+// (go-re2/2) and no newline beside a negated class under CompilePOSIX (go-re2/3), and a
+// mismatch of a FindAll...Submatch... method with a positive limit on a pattern that can match
+// the empty string (go-re2/4) is skipped.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs. Read once; the generators consult it
+// when they are built, the checks when they judge a mismatch.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// caseShape names the recorded bug whose shape a pattern and text have, or "": go-re2/2, \B
+// matches between the bytes of a multi-byte character (regexp: never inside a character), so
+// Split cuts characters and MatchString says true where regexp says false; go-re2/3,
+// CompilePOSIX lets a negated class match a newline (regexp: not without syntax.ClassNL).
+func caseShape(p pat, text string) string {
+	if p.nonBoundary && utf8.RuneCountInString(text) != len(text) {
+		return "go-re2/2"
+	}
+	if p.posix && p.negatedClass && strings.Contains(text, "\n") {
+		return "go-re2/3"
+	}
+	return ""
+}
+
+// limitShape names the recorded bug whose shape a FindAll call with the limit has, or "":
+// go-re2/1, the FindAll methods return every match when n is 0 (regexp: nil); go-re2/4, the
+// FindAll...Submatch... methods count an empty match they skip (one abutting the previous
+// match) against a positive n, so they return fewer matches than regexp.
+func limitShape(lim int, submatch, hasEmpty bool) string {
+	if lim == 0 {
+		return "go-re2/1"
+	}
+	if submatch && lim > 0 && hasEmpty {
+		return "go-re2/4"
+	}
+	return ""
+}
