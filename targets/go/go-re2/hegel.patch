diff --git a/hegel_experimental_test.go b/hegel_experimental_test.go
new file mode 100644
index 0000000..2d6f953
--- /dev/null
+++ b/hegel_experimental_test.go
@@ -0,0 +1,181 @@
+package re2_test
+
+// The experimental package: CompileSet against each pattern's own MatchString, and
+// CompileLatin1 against regexp on the text transcoded to UTF-8.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	re2 "github.com/wasilibs/go-re2"
+	"github.com/wasilibs/go-re2/experimental"
+)
+
+// setCase: one to four patterns regexp accepts, a text over the pool they may all be run on,
+// and a limit taken modulo their number.
+type setCase struct {
+	pats  []pat
+	text  string
+	limit int
+}
+
+var setCases = hegel.FlatMap(
+	hegel.Lists(hegel.Filter(patterns, func(p pat) bool { _, err := regexp.Compile(p.src); return err == nil })).MinSize(1).MaxSize(4),
+	func(ps []pat) hegel.Generator[setCase] {
+		pool := alphabet
+		for _, p := range ps {
+			pool = poolFor(p, pool)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) setCase {
+			return setCase{pats: ps, text: hegel.Draw(tc, texts(pool)), limit: hegel.Draw(tc, hegel.Integers(0, 3))}
+		})
+	},
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c setCase) GoString() string {
+	srcs := make([]string, len(c.pats))
+	for i, p := range c.pats {
+		srcs[i] = p.src
+	}
+	return fmt.Sprintf("patterns %q text %q limit %d", srcs, c.text, 1+c.limit%len(c.pats))
+}
+
+// shape names the recorded bug whose shape the set's patterns and text have (a \B pattern on
+// a text with a multi-byte character, go-re2/2), or "".
+func (c setCase) shape() string {
+	for _, p := range c.pats {
+		if s := caseShape(p, c.text); s != "" {
+			return s
+		}
+	}
+	return ""
+}
+
+// TestHegelSetAgreesWithEachPattern: a Set reports exactly the patterns that match, and with
+// a limit n at most n of them. A disagreement with a known shape names it, and under
+// HEGEL_NO_KNOWN=1 is skipped.
+func TestHegelSetAgreesWithEachPattern(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, setCases)
+		text := tcase.text
+		exprs := make([]string, 0, len(tcase.pats))
+		var want []int
+		for i, p := range tcase.pats {
+			g, err := regexp.Compile(p.src)
+			ht.Assume(err == nil) // drawn accepted
+			if _, err := re2.Compile(p.src); err != nil {
+				ht.Fatalf("Compile(%q): go-re2 rejects what regexp accepts: %v", p.src, err)
+			}
+			exprs = append(exprs, p.src)
+			if g.MatchString(text) {
+				want = append(want, i)
+			}
+		}
+		fail := func(format string, args ...any) {
+			shape := tcase.shape()
+			if noKnown {
+				ht.Assume(shape == "")
+			}
+			if shape != "" {
+				format += " (the shape of " + shape + ")"
+			}
+			ht.Fatalf(format, args...)
+		}
+		set, err := experimental.CompileSet(exprs)
+		if err != nil {
+			ht.Fatalf("CompileSet(%q): %v", exprs, err)
+		}
+		got, err := set.FindAllStringWithError(text, -1)
+		if err != nil {
+			ht.Fatalf("Set(%q).FindAllString(%q): %v", exprs, text, err)
+		}
+		sort.Ints(got)
+		if !slices.Equal(got, want) {
+			fail("Set(%q).FindAllString(%q, -1) = %v, want %v", exprs, text, got, want)
+		}
+		gotB := set.FindAll([]byte(text), -1)
+		sort.Ints(gotB)
+		if !slices.Equal(gotB, want) {
+			fail("Set(%q).FindAll(%q, -1) = %v, want %v", exprs, text, gotB, want)
+		}
+		if got := set.FindAllString(text, 0); got != nil {
+			ht.Fatalf("Set(%q).FindAllString(%q, 0) = %v, want nil", exprs, text, got)
+		}
+		lim := 1 + tcase.limit%len(exprs)
+		limited := set.FindAllString(text, lim)
+		if len(limited) != min(lim, len(want)) {
+			fail("Set(%q).FindAllString(%q, %d) = %v, want %d of %v", exprs, text, lim, limited, min(lim, len(want)), want)
+		}
+		for _, i := range limited {
+			if !slices.Contains(want, i) {
+				fail("Set(%q).FindAllString(%q, %d) = %v, includes a pattern that does not match (want %v)", exprs, text, lim, limited, want)
+			}
+		}
+	})
+}
+
+// latin1 transcodes a string of characters below U+0100 to one byte per character.
+func latin1(s string) (string, bool) {
+	b := make([]byte, 0, len(s))
+	for _, r := range s {
+		if r > 0xff {
+			return "", false
+		}
+		b = append(b, byte(r))
+	}
+	return string(b), true
+}
+
+var latinCases = patTexts(latinPatterns, latinAlphabet)
+
+// TestHegelLatin1AgreesWithRegexp: CompileLatin1 on a Latin-1 text finds what regexp finds on
+// the same characters in UTF-8, with offsets counted in bytes of each encoding.
+func TestHegelLatin1AgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, latinCases)
+		p, text := tcase.p, tcase.text
+		lpat, ok1 := latin1(p.src)
+		ltext, ok2 := latin1(text)
+		ht.Assume(ok1 && ok2) // the Latin dialect stays below U+0100
+		g, eg := regexp.Compile(p.src)
+		r, er := experimental.CompileLatin1(lpat)
+		if (eg == nil) != (er == nil) {
+			ht.Fatalf("CompileLatin1(%q): regexp err=%v, go-re2 err=%v", p.src, eg, er)
+		}
+		ht.Assume(eg == nil) // rejected by both
+		// offset[i] is the UTF-8 offset of Latin-1 offset i.
+		offset := make([]int, len(ltext)+1)
+		for i := range ltext {
+			offset[i+1] = offset[i] + len(string(rune(ltext[i])))
+		}
+		want := g.FindAllStringSubmatchIndex(text, -1)
+		got := r.FindAllStringSubmatchIndex(ltext, -1)
+		if len(got) != len(want) {
+			ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v, regexp %v", p.src, text, got, want)
+		}
+		for i := range got {
+			if len(got[i]) != len(want[i]) {
+				ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v, regexp %v", p.src, text, got, want)
+			}
+			for j := range got[i] {
+				w := want[i][j]
+				gv := got[i][j]
+				if gv >= 0 {
+					gv = offset[gv]
+				}
+				if gv != w {
+					ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v (in Latin-1 offsets), regexp %v (in UTF-8 offsets)", p.src, text, got, want)
+				}
+			}
+		}
+		if got, want := r.MatchString(ltext), g.MatchString(text); got != want {
+			ht.Fatalf("CompileLatin1(%q).MatchString(%q) = %v, regexp %v", p.src, text, got, want)
+		}
+	})
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..1b0e9a9
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,692 @@
+package re2_test
+
+// The pattern, text and template generators. A pattern is drawn as a small syntax tree from
+// the RE2 grammar both regexp and go-re2 accept (see hegel_test.go for what is kept out), in
+// one of three dialects, and rendered to its source by a pure function that also numbers the
+// capturing groups; POSIX patterns come from the ERE subset CompilePOSIX takes. A text is a
+// string over the alphabet (narrowed by poolFor under HEGEL_NO_KNOWN=1); a template is a
+// list of pieces rendered against the pattern's group count.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// alphabet: the runes texts and literals are made of. Case pairs (k/K/Kelvin sign, s/S/long s)
+// exercise simple case folding; é/É and 日 exercise \b, \w and Unicode classes; 😀 is four bytes.
+var alphabet = []rune{'a', 'b', 'A', 'B', 'k', 'K', 'K', 's', 'S', 'ſ', '0', '1', ' ', '\n', '-', '_', 'é', 'É', '日', '😀', '.'}
+
+// sortedAlphabet is the alphabet in code point order, for class ranges.
+var sortedAlphabet = slices.Sorted(slices.Values(alphabet))
+
+// latinAlphabet: the alphabet below U+0100, for the Latin-1 property.
+var latinAlphabet = keep(alphabet, func(r rune) bool { return r < 0x100 })
+
+var sortedLatinAlphabet = slices.Sorted(slices.Values(latinAlphabet))
+
+// keep returns the runes of pool that satisfy ok.
+func keep(pool []rune, ok func(rune) bool) []rune {
+	var xs []rune
+	for _, r := range pool {
+		if ok(r) {
+			xs = append(xs, r)
+		}
+	}
+	return xs
+}
+
+var groupNames = []string{"n", "x1", "_a", "a_b", "N"}
+
+// pat is a rendered pattern: its source, the number of capturing groups and their names, and
+// the two shapes of recorded bugs (caseShape).
+type pat struct {
+	src          string
+	groups       int      // number of capturing groups
+	names        []string // names[i] is the name of group i (names[0] = "")
+	posix        bool     // drawn from the POSIX dialect
+	nonBoundary  bool     // has a \B assertion (go-re2/2)
+	negatedClass bool     // has a [^...] class (go-re2/3 under CompilePOSIX)
+}
+
+// --------------------------------------------------------------------------- the dialects
+
+// dialect selects the grammar a pattern is drawn from.
+type dialect int
+
+const (
+	perlDialect  dialect = iota // the full RE2 syntax
+	latinDialect                // literals below U+0100 and no Unicode classes, for CompileLatin1
+	posixDialect                // the ERE subset CompilePOSIX takes: no Perl escapes, flags, non-capturing groups or lazy quantifiers
+)
+
+func (d dialect) letters() []rune {
+	if d == latinDialect {
+		return latinAlphabet
+	}
+	return alphabet
+}
+
+func (d dialect) sorted() []rune {
+	if d == latinDialect {
+		return sortedLatinAlphabet
+	}
+	return sortedAlphabet
+}
+
+// --------------------------------------------------------------------------- the syntax tree
+
+// literal is one rune of the alphabet in one of its spellings.
+type spelling int
+
+const (
+	plain    spelling = iota // the character itself, QuoteMeta'd outside a class
+	escaped                  // \n for a newline, otherwise plain
+	hexBrace                 // \x{e9}
+	hex2                     // \x41 for a character below U+0080, otherwise plain
+	octal                    // \101 for a character below U+0080, otherwise plain
+)
+
+type literal struct {
+	r     rune
+	spell spelling
+}
+
+// write renders the literal; inside a class the metacharacters of a class are escaped, outside
+// QuoteMeta does it.
+func (l literal) write(sb *strings.Builder, inClass bool) {
+	switch {
+	case l.spell == hexBrace:
+		fmt.Fprintf(sb, `\x{%x}`, l.r)
+	case l.spell == hex2 && l.r < 0x80:
+		fmt.Fprintf(sb, `\x%02x`, l.r)
+	case l.spell == octal && l.r < 0x80:
+		fmt.Fprintf(sb, `\%03o`, l.r)
+	case l.spell == escaped && l.r == '\n':
+		sb.WriteString(`\n`)
+	case inClass:
+		if strings.ContainsRune(`\]^-[`, l.r) {
+			sb.WriteByte('\\')
+		}
+		sb.WriteRune(l.r)
+	default:
+		sb.WriteString(regexp.QuoteMeta(string(l.r)))
+	}
+}
+
+// classItem is one member of a bracket class; only the fields its kind uses are drawn.
+type classItemKind int
+
+const (
+	itemLiteral classItemKind = iota
+	itemRange                 // lo-hi over the sorted alphabet
+	itemNamed                 // \d, [:alpha:], \pL and the like, written as is
+)
+
+type classItem struct {
+	kind   classItemKind
+	lit    literal
+	lo, hi int    // itemRange: indices into the sorted alphabet, lo <= hi
+	name   string // itemNamed
+}
+
+type class struct {
+	negated bool
+	items   []classItem
+}
+
+func (c class) write(sb *strings.Builder, d dialect) {
+	sb.WriteByte('[')
+	if c.negated {
+		sb.WriteByte('^')
+	}
+	for _, it := range c.items {
+		switch it.kind {
+		case itemLiteral:
+			it.lit.write(sb, true)
+		case itemRange:
+			sorted := d.sorted()
+			literal{sorted[it.lo], escaped}.write(sb, true)
+			sb.WriteByte('-')
+			literal{sorted[it.hi], escaped}.write(sb, true)
+		case itemNamed:
+			sb.WriteString(it.name)
+		}
+	}
+	sb.WriteByte(']')
+}
+
+// quantifier follows an atom; the zero value is none, which is what maybe shrinks to.
+type quantKind int
+
+const (
+	qNone quantKind = iota
+	qStar
+	qPlus
+	qOpt
+	qExact   // {n}
+	qAtLeast // {n,}
+	qRange   // {n,m}
+)
+
+type quantifier struct {
+	kind     quantKind
+	lo, span int // qExact, qAtLeast: lo; qRange: lo,lo+span
+	lazy     bool
+}
+
+func (q quantifier) write(sb *strings.Builder) {
+	switch q.kind {
+	case qNone:
+		return
+	case qStar:
+		sb.WriteByte('*')
+	case qPlus:
+		sb.WriteByte('+')
+	case qOpt:
+		sb.WriteByte('?')
+	case qExact:
+		fmt.Fprintf(sb, "{%d}", q.lo)
+	case qAtLeast:
+		fmt.Fprintf(sb, "{%d,}", q.lo)
+	case qRange:
+		fmt.Fprintf(sb, "{%d,%d}", q.lo, q.lo+q.span)
+	}
+	if q.lazy {
+		sb.WriteByte('?')
+	}
+}
+
+// group is a parenthesised alternation; only the fields its kind uses are drawn.
+type groupKind int
+
+const (
+	gCapture    groupKind = iota // (...)
+	gNamed                       // (?P<name>...) or (?<name>...)
+	gNonCapture                  // (?:...)
+	gFlagged                     // (?i:...) and the like
+)
+
+type group struct {
+	kind  groupKind
+	name  string // gNamed
+	angle bool   // gNamed: (?<name> rather than (?P<name>
+	flags string // gFlagged: the opening, "(?i:"
+	body  alt
+}
+
+// open writes the opening of the group and numbers it when it captures.
+func (g group) open(sb *strings.Builder, p *pat) {
+	switch g.kind {
+	case gCapture:
+		p.groups++
+		p.names = append(p.names, "")
+		sb.WriteByte('(')
+	case gNamed:
+		p.groups++
+		p.names = append(p.names, g.name)
+		if g.angle {
+			fmt.Fprintf(sb, "(?<%s>", g.name)
+		} else {
+			fmt.Fprintf(sb, "(?P<%s>", g.name)
+		}
+	case gNonCapture:
+		sb.WriteString("(?:")
+	case gFlagged:
+		sb.WriteString(g.flags)
+	}
+}
+
+// atom is one element of a concatenation; only the fields its kind uses are drawn.
+type atomKind int
+
+const (
+	atomLiteral atomKind = iota
+	atomDot              // .
+	atomNamed            // \d, \pL, ^, \b, (?i): written as is
+	atomClass            // [...]
+	atomQuoted           // \Q...\E, or \Q to the end of the pattern
+	atomGroup            // (...)
+)
+
+type atom struct {
+	kind     atomKind
+	lit      literal
+	text     string // atomNamed
+	class    class
+	runes    []rune // atomQuoted
+	unclosed bool   // atomQuoted: no \E, the rest of the pattern is literal
+	group    group
+}
+
+// quantPct is how often a quantifier follows the atom: 40% of the time for the quantifiable
+// atoms, 8% (20% of 40%) for an assertion, never for a flag setting or an unclosed \Q.
+func (a atom) quantPct(d dialect) int {
+	switch a.kind {
+	case atomNamed:
+		if strings.HasPrefix(a.text, "(?") {
+			return 0
+		}
+		if slices.Contains(assertions, a.text) {
+			if d == posixDialect {
+				return 0
+			}
+			return 8
+		}
+	case atomQuoted:
+		if a.unclosed {
+			return 0
+		}
+	}
+	return 40
+}
+
+func (a atom) write(sb *strings.Builder, p *pat, d dialect) {
+	switch a.kind {
+	case atomLiteral:
+		a.lit.write(sb, false)
+	case atomDot:
+		sb.WriteByte('.')
+	case atomNamed:
+		if a.text == `\B` {
+			p.nonBoundary = true
+		}
+		sb.WriteString(a.text)
+	case atomClass:
+		if a.class.negated {
+			p.negatedClass = true
+		}
+		a.class.write(sb, d)
+	case atomQuoted:
+		sb.WriteString(`\Q`)
+		sb.WriteString(string(a.runes))
+		if !a.unclosed {
+			sb.WriteString(`\E`)
+		}
+	case atomGroup:
+		a.group.open(sb, p)
+		a.group.body.write(sb, p, d)
+		sb.WriteByte(')')
+	}
+}
+
+type piece struct {
+	atom  atom
+	quant quantifier
+}
+
+// cat is a concatenation of pieces; alt an alternation of concatenations (an empty cat is an
+// empty branch).
+type (
+	cat []piece
+	alt []cat
+)
+
+func (a alt) write(sb *strings.Builder, p *pat, d dialect) {
+	for i, c := range a {
+		if i > 0 {
+			sb.WriteByte('|')
+		}
+		for _, pc := range c {
+			pc.atom.write(sb, p, d)
+			pc.quant.write(sb)
+		}
+	}
+}
+
+// size counts the pieces of the tree, those inside groups included.
+func (a alt) size() int {
+	n := 0
+	for _, c := range a {
+		for _, pc := range c {
+			n++
+			if pc.atom.kind == atomGroup {
+				n += pc.atom.group.body.size()
+			}
+		}
+	}
+	return n
+}
+
+// render turns the tree into a pat.
+func render(a alt, d dialect) pat {
+	p := pat{names: []string{""}, posix: d == posixDialect}
+	var sb strings.Builder
+	a.write(&sb, &p, d)
+	p.src = sb.String()
+	return p
+}
+
+// --------------------------------------------------------------------------- the grammar
+
+var (
+	perlEscapes    = []string{`\d`, `\D`, `\w`, `\W`, `\s`, `\S`}
+	unicodeClasses = []string{`\pL`, `\PL`, `\p{L}`, `\p{Lu}`, `\p{Ll}`, `\p{Nd}`, `\p{Han}`, `\p{Latin}`, `\p{Greek}`, `\p{Zs}`, `\p{Any}`, `\p{^Lu}`, `\P{Han}`, `\pN`, `\p{So}`}
+	assertions     = []string{`^`, `$`, `\A`, `\z`, `\b`, `\B`}
+	posixAnchors   = []string{`^`, `$`}
+	flagSettings   = []string{`(?i)`, `(?m)`, `(?s)`, `(?U)`, `(?-i)`, `(?i-s)`, `(?ms)`, `(?-U)`}
+	groupFlags     = []string{"(?i:", "(?s:", "(?m:", "(?U:", "(?-i:", "(?is:", "(?i-s:", "(?-m:"}
+	posixNames     = []string{`[:alpha:]`, `[:^digit:]`, `[:word:]`, `[:space:]`, `[:upper:]`, `[:lower:]`, `[:punct:]`, `[:^alnum:]`}
+	classEscapes   = []string{`\d`, `\w`, `\s`, `\D`, `\W`, `\S`}
+	classUnicode   = []string{`\pL`, `\p{Greek}`, `\PL`, `\p{Lu}`, `\p{Han}`, `\pN`}
+)
+
+// named is an atom or class item written as one of the strings.
+func namedAtoms(xs []string) hegel.Generator[atom] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) atom { return atom{kind: atomNamed, text: s} })
+}
+
+func namedItems(xs []string) hegel.Generator[classItem] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) classItem { return classItem{kind: itemNamed, name: s} })
+}
+
+// spellings: the plain spelling most of the time; POSIX has no hex or octal escapes.
+func spellings(d dialect) hegel.Generator[spelling] {
+	if d == posixDialect {
+		return weighted(choice[spelling]{90, hegel.Just(plain)}, choice[spelling]{10, hegel.Just(escaped)})
+	}
+	return weighted(
+		choice[spelling]{62, hegel.Just(plain)},
+		choice[spelling]{10, hegel.Just(escaped)},
+		choice[spelling]{10, hegel.Just(hexBrace)},
+		choice[spelling]{10, hegel.Just(hex2)},
+		choice[spelling]{8, hegel.Just(octal)},
+	)
+}
+
+// quants: the six quantifiers evenly, lazy 30% of the time outside POSIX.
+func quants(d dialect) hegel.Generator[quantifier] {
+	bodies := hegel.OneOf(
+		hegel.Just(quantifier{kind: qStar}),
+		hegel.Just(quantifier{kind: qPlus}),
+		hegel.Just(quantifier{kind: qOpt}),
+		hegel.Map(hegel.Integers(0, 3), func(n int) quantifier { return quantifier{kind: qExact, lo: n} }),
+		hegel.Map(hegel.Integers(0, 3), func(n int) quantifier { return quantifier{kind: qAtLeast, lo: n} }),
+		hegel.Composite(func(tc hegel.TestCase) quantifier {
+			return quantifier{kind: qRange, lo: hegel.Draw(tc, hegel.Integers(0, 2)), span: hegel.Draw(tc, hegel.Integers(0, 2))}
+		}),
+	)
+	lazies := hegel.Just(false)
+	if d != posixDialect {
+		lazies = chance(30)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) quantifier {
+		q := hegel.Draw(tc, bodies)
+		q.lazy = hegel.Draw(tc, lazies)
+		return q
+	})
+}
+
+// heads: the opening of a group, the plain capture first; POSIX has only that.
+func heads(d dialect) hegel.Generator[group] {
+	if d == posixDialect {
+		return hegel.Just(group{kind: gCapture})
+	}
+	return headsOf(groupFlags)
+}
+
+// headsOf: a capturing, named, non-capturing or, given flags, flagged group opening.
+func headsOf(flags []string) hegel.Generator[group] {
+	named := hegel.Composite(func(tc hegel.TestCase) group {
+		return group{kind: gNamed, name: hegel.Draw(tc, hegel.SampledFrom(groupNames)), angle: hegel.Draw(tc, chance(50))}
+	})
+	choices := []choice[group]{
+		{4, hegel.Just(group{kind: gCapture})},
+		{2, named},
+		{2, hegel.Just(group{kind: gNonCapture})},
+	}
+	if len(flags) > 0 {
+		choices = append(choices, choice[group]{2, hegel.Map(hegel.SampledFrom(flags), func(f string) group { return group{kind: gFlagged, flags: f} })})
+	}
+	return weighted(choices...)
+}
+
+// literalsOf draws one rune of the dialect's alphabet in one of its spellings.
+func literalsOf(d dialect) hegel.Generator[literal] {
+	letters, spells := hegel.SampledFrom(d.letters()), spellings(d)
+	return hegel.Composite(func(tc hegel.TestCase) literal {
+		return literal{r: hegel.Draw(tc, letters), spell: hegel.Draw(tc, spells)}
+	})
+}
+
+func literalAtom(l literal) atom { return atom{kind: atomLiteral, lit: l} }
+
+// grammar returns the pattern generator of a dialect. Groups nest at most maxDepth deep: the
+// generator refers to itself through alts, and the depth counter in the closure tracks the
+// live recursion (hegel-go's ExampleComposite_recursive); at the bound a group becomes a
+// literal.
+func grammar(d dialect) hegel.Generator[pat] {
+	const maxDepth, maxPieces = 3, 12
+	depth := 0
+	var alts hegel.Generator[alt]
+
+	letters, literals := hegel.SampledFrom(d.letters()), literalsOf(d)
+	literalAtoms := hegel.Map(literals, literalAtom)
+
+	// class items: literals first, then ranges over the sorted alphabet, then the names the
+	// dialect allows.
+	sorted := d.sorted()
+	ranges := hegel.Composite(func(tc hegel.TestCase) classItem {
+		lo := hegel.Draw(tc, hegel.Integers(0, len(sorted)-1))
+		return classItem{kind: itemRange, lo: lo, hi: hegel.Draw(tc, hegel.Integers(lo, len(sorted)-1))}
+	})
+	literalItems := hegel.Map(literals, func(l literal) classItem { return classItem{kind: itemLiteral, lit: l} })
+	var items hegel.Generator[classItem]
+	switch d {
+	case posixDialect:
+		items = weighted(choice[classItem]{7, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(posixNames)})
+	case latinDialect:
+		items = weighted(choice[classItem]{6, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(classEscapes)}, choice[classItem]{1, namedItems(posixNames)})
+	default:
+		items = weighted(choice[classItem]{4, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(classEscapes)}, choice[classItem]{1, namedItems(posixNames)}, choice[classItem]{2, namedItems(classUnicode)})
+	}
+	classAtoms := hegel.Composite(func(tc hegel.TestCase) atom {
+		return atom{kind: atomClass, class: class{
+			negated: hegel.Draw(tc, chance(30)),
+			items:   hegel.Draw(tc, hegel.Lists(items).MinSize(1).MaxSize(3)),
+		}}
+	})
+
+	quoted := hegel.Composite(func(tc hegel.TestCase) atom {
+		return atom{kind: atomQuoted, runes: hegel.Draw(tc, hegel.Lists(letters).MaxSize(3)), unclosed: hegel.Draw(tc, chance(15))}
+	})
+
+	groupHeads := heads(d)
+	groups := hegel.Composite(func(tc hegel.TestCase) atom {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, literalAtoms)
+		}
+		g := hegel.Draw(tc, groupHeads)
+		depth++
+		defer func() { depth-- }()
+		g.body = hegel.Draw(tc, alts)
+		return atom{kind: atomGroup, group: g}
+	})
+
+	// atoms: literals first and most often, groups last.
+	dot := hegel.Just(atom{kind: atomDot})
+	var atoms hegel.Generator[atom]
+	switch d {
+	case posixDialect:
+		atoms = weighted(
+			choice[atom]{4, literalAtoms},
+			choice[atom]{1, dot},
+			choice[atom]{2, classAtoms},
+			choice[atom]{1, namedAtoms(posixAnchors)},
+			choice[atom]{2, groups},
+		)
+	default:
+		unicode := choice[atom]{4, namedAtoms(unicodeClasses)}
+		if d == latinDialect {
+			unicode = choice[atom]{4, literalAtoms}
+		}
+		atoms = weighted(
+			choice[atom]{28, literalAtoms},
+			choice[atom]{6, dot},
+			choice[atom]{7, namedAtoms(perlEscapes)},
+			unicode,
+			choice[atom]{10, classAtoms},
+			choice[atom]{9, namedAtoms(assertions)},
+			choice[atom]{3, namedAtoms(flagSettings)},
+			choice[atom]{3, quoted},
+			choice[atom]{30, groups},
+		)
+	}
+
+	quantifiers := quants(d)
+	pieces := hegel.FlatMap(atoms, func(a atom) hegel.Generator[piece] {
+		return hegel.Map(maybe(a.quantPct(d), quantifiers), func(q quantifier) piece { return piece{atom: a, quant: q} })
+	})
+	cats := hegel.Map(hegel.Lists(pieces).MaxSize(4), func(ps []piece) cat { return ps })
+	// alts: one branch most of the time, else two or three, some of them empty.
+	branches := weighted(choice[cat]{12, hegel.Just(cat(nil))}, choice[cat]{88, cats})
+	alts = weighted(
+		choice[alt]{70, hegel.Map(cats, func(c cat) alt { return alt{c} })},
+		choice[alt]{30, hegel.Map(hegel.Lists(branches).MinSize(2).MaxSize(3), func(cs []cat) alt { return cs })},
+	)
+	// A pattern has at most maxPieces pieces in all: nested groups make the tail of the
+	// unbounded tree long, and a pattern much longer than the text matches little.
+	small := hegel.Filter(alts, func(a alt) bool { return a.size() <= maxPieces })
+	return hegel.Map(small, func(a alt) pat { return render(a, d) })
+}
+
+var (
+	patterns      = grammar(perlDialect)
+	latinPatterns = grammar(latinDialect)
+	posixPatterns = grammar(posixDialect)
+)
+
+// --------------------------------------------------------------------------- texts
+
+// textShape is a text over a pool: up to ten characters, a quarter of the time followed by a
+// repeat of a prefix of themselves, so that matches recur.
+type textShape struct {
+	base string
+	dup  int // -1: no repeat; otherwise the prefix repeated is base[:dup] in runes (modulo the length)
+}
+
+func (t textShape) String() string {
+	rs := []rune(t.base)
+	if t.dup >= 0 && len(rs) > 0 {
+		rs = append(rs, rs[:t.dup%(len(rs)+1)]...)
+	}
+	return string(rs)
+}
+
+// dups: no repeat three quarters of the time, else the prefix length repeated.
+var dups = weighted(choice[int]{75, hegel.Just(-1)}, choice[int]{25, hegel.Integers(0, 10)})
+
+// texts draws a text over the pool.
+func texts(pool []rune) hegel.Generator[string] {
+	base := hegel.Text().Alphabet(string(pool)).MaxSize(10)
+	shapes := hegel.Composite(func(tc hegel.TestCase) textShape {
+		return textShape{base: hegel.Draw(tc, base), dup: hegel.Draw(tc, dups)}
+	})
+	return hegel.Map(shapes, textShape.String)
+}
+
+// poolFor is the text pool for a pattern: the whole pool, so that the shapes of the recorded
+// bugs are drawn, or under HEGEL_NO_KNOWN=1 the pool without the characters that make them:
+// none above U+007F beside \B (go-re2/2), no newline beside a negated class under
+// CompilePOSIX (go-re2/3).
+func poolFor(p pat, pool []rune) []rune {
+	if !noKnown {
+		return pool
+	}
+	if p.nonBoundary {
+		pool = keep(pool, func(r rune) bool { return r < 0x80 })
+	}
+	if p.posix && p.negatedClass {
+		pool = keep(pool, func(r rune) bool { return r != '\n' })
+	}
+	return pool
+}
+
+// patText is a pattern and a text drawn over the pool it may be run on.
+type patText struct {
+	p    pat
+	text string
+}
+
+func patTexts(patterns hegel.Generator[pat], pool []rune) hegel.Generator[patText] {
+	return hegel.FlatMap(patterns, func(p pat) hegel.Generator[patText] {
+		return hegel.Map(texts(poolFor(p, pool)), func(t string) patText { return patText{p: p, text: t} })
+	})
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c patText) GoString() string { return fmt.Sprintf("pattern %q text %q", c.p.src, c.text) }
+
+// --------------------------------------------------------------------------- templates
+
+// tmplPiece is one piece of a replacement template: literal text, $$ and $-references, some
+// of them to groups that do not exist or names that are not there, some malformed.
+type tmplKind int
+
+const (
+	tText      tmplKind = iota // written as is
+	tNum                       // $n, n up to one past the last group
+	tBraceNum                  // ${n}
+	tNumX                      // $nx: a name that is not a number
+	tName                      // $name
+	tBraceName                 // ${name}
+)
+
+type tmplPiece struct {
+	kind tmplKind
+	s    string // tText, tName, tBraceName
+	n    int    // tNum, tBraceNum, tNumX
+}
+
+func (t tmplPiece) String() string {
+	switch t.kind {
+	case tNum:
+		return fmt.Sprintf("$%d", t.n)
+	case tBraceNum:
+		return fmt.Sprintf("${%d}", t.n)
+	case tNumX:
+		return fmt.Sprintf("$%dx", t.n)
+	case tName:
+		return "$" + t.s
+	case tBraceName:
+		return "${" + t.s + "}"
+	}
+	return t.s
+}
+
+func textPieces(xs []string) hegel.Generator[tmplPiece] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) tmplPiece { return tmplPiece{kind: tText, s: s} })
+}
+
+func numPieces(kind tmplKind, hi int) hegel.Generator[tmplPiece] {
+	return hegel.Map(hegel.Integers(0, hi), func(n int) tmplPiece { return tmplPiece{kind: kind, n: n} })
+}
+
+// templates draws a replacement template for a pattern with the number of groups: up to four
+// pieces, literal text first.
+func templates(groups int) hegel.Generator[string] {
+	names := hegel.SampledFrom(groupNames)
+	pieces := weighted(
+		choice[tmplPiece]{3, textPieces([]string{"x", "-", "<", ">", "é"})},
+		choice[tmplPiece]{1, hegel.Just(tmplPiece{kind: tText, s: "$$"})},
+		choice[tmplPiece]{2, numPieces(tNum, groups+1)},
+		choice[tmplPiece]{1, numPieces(tBraceNum, groups+1)},
+		choice[tmplPiece]{1, numPieces(tNumX, groups)},
+		choice[tmplPiece]{1, hegel.OneOf(
+			hegel.Map(names, func(s string) tmplPiece { return tmplPiece{kind: tName, s: s} }),
+			hegel.Map(names, func(s string) tmplPiece { return tmplPiece{kind: tBraceName, s: s} }),
+		)},
+		choice[tmplPiece]{1, textPieces([]string{"$", "${", "${1", "$ ", "${}", "$10", "${0}", "$01", "${nope}"})},
+		choice[tmplPiece]{2, textPieces([]string{"$0", "${0}x"})},
+	)
+	return hegel.Map(hegel.Lists(pieces).MaxSize(4), func(ps []tmplPiece) string {
+		var sb strings.Builder
+		for _, p := range ps {
+			sb.WriteString(p.String())
+		}
+		return sb.String()
+	})
+}
diff --git a/hegel_methods_test.go b/hegel_methods_test.go
new file mode 100644
index 0000000..324c74f
--- /dev/null
+++ b/hegel_methods_test.go
@@ -0,0 +1,328 @@
+package re2_test
+
+import (
+	"fmt"
+	"reflect"
+	"regexp"
+	"regexp/syntax"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	re2 "github.com/wasilibs/go-re2"
+)
+
+// check compares one method's results and reports a mismatch with the pattern and text, naming
+// the recorded bug whose shape the case has (caseShape, or for a FindAll call limitShape);
+// under HEGEL_NO_KNOWN=1 a mismatch with a known shape is skipped instead of failing.
+type check struct {
+	ht    *hegel.T
+	p     pat
+	text  string
+	shape string // the recorded bug whose shape the pattern and text have, or ""
+}
+
+func newCheck(ht *hegel.T, p pat, text string) *check {
+	return &check{ht: ht, p: p, text: text, shape: caseShape(p, text)}
+}
+
+func (k *check) eq(method string, got, want any) { k.eqShaped(method, "", got, want) }
+
+// eqShaped is eq with the shape of the call itself (a FindAll limit's), which takes precedence
+// over the case's.
+func (k *check) eqShaped(method, shape string, got, want any) {
+	if reflect.DeepEqual(got, want) {
+		return
+	}
+	if shape == "" {
+		shape = k.shape
+	}
+	if noKnown {
+		k.ht.Assume(shape == "")
+	}
+	if shape != "" {
+		shape = " (the shape of " + shape + ")"
+	}
+	k.ht.Fatalf("%s: pattern %q text %q:\n  go-re2 %#v\n  regexp %#v%s", method, k.p.src, k.text, got, want, shape)
+}
+
+// findAll compares the eight FindAll methods and Split with the limit; hasEmpty says whether
+// the pattern can match the empty string (nullable), which with a positive limit is the shape
+// of go-re2/4 for the Submatch methods.
+func (k *check) findAll(r *re2.Regexp, g *regexp.Regexp, lim int, hasEmpty bool) {
+	text, b := k.text, []byte(k.text)
+	s := fmt.Sprintf("(%d)", lim)
+	plain, sub := limitShape(lim, false, hasEmpty), limitShape(lim, true, hasEmpty)
+	k.eqShaped("FindAllString"+s, plain, r.FindAllString(text, lim), g.FindAllString(text, lim))
+	k.eqShaped("FindAllStringIndex"+s, plain, r.FindAllStringIndex(text, lim), g.FindAllStringIndex(text, lim))
+	k.eqShaped("FindAll"+s, plain, r.FindAll(b, lim), g.FindAll(b, lim))
+	k.eqShaped("FindAllIndex"+s, plain, r.FindAllIndex(b, lim), g.FindAllIndex(b, lim))
+	k.eq("Split"+s, r.Split(text, lim), g.Split(text, lim))
+	k.eqShaped("FindAllStringSubmatch"+s, sub, r.FindAllStringSubmatch(text, lim), g.FindAllStringSubmatch(text, lim))
+	k.eqShaped("FindAllStringSubmatchIndex"+s, sub, r.FindAllStringSubmatchIndex(text, lim), g.FindAllStringSubmatchIndex(text, lim))
+	k.eqShaped("FindAllSubmatch"+s, sub, r.FindAllSubmatch(b, lim), g.FindAllSubmatch(b, lim))
+	k.eqShaped("FindAllSubmatchIndex"+s, sub, r.FindAllSubmatchIndex(b, lim), g.FindAllSubmatchIndex(b, lim))
+}
+
+// compileBoth compiles the pattern with both packages: a disagreement on acceptance is a
+// mismatch, and a pattern both reject has nothing more to compare.
+func compileBoth(ht *hegel.T, p pat, posix bool) (*regexp.Regexp, *re2.Regexp) {
+	var (
+		g   *regexp.Regexp
+		r   *re2.Regexp
+		eg  error
+		er  error
+		how = "Compile"
+	)
+	if posix {
+		how = "CompilePOSIX"
+		g, eg = regexp.CompilePOSIX(p.src)
+		r, er = re2.CompilePOSIX(p.src)
+	} else {
+		g, eg = regexp.Compile(p.src)
+		r, er = re2.Compile(p.src)
+	}
+	if (eg == nil) != (er == nil) {
+		ht.Fatalf("%s(%q): regexp err=%v, go-re2 err=%v", how, p.src, eg, er)
+	}
+	ht.Assume(eg == nil) // rejected by both
+	return g, r
+}
+
+// limits are the n the FindAll methods are called with; under HEGEL_NO_KNOWN=1 without the 0
+// of go-re2/1.
+var limits = func() []int {
+	if noKnown {
+		return []int{-1, 1, 2, 3}
+	}
+	return []int{-1, 0, 1, 2, 3}
+}()
+
+// nullable reports whether the pattern can match the empty string somewhere (assertions
+// count as matching empty), which is when a FindAll scan can meet an empty match abutting the
+// previous one.
+func nullable(pattern string) bool {
+	re, err := syntax.Parse(pattern, syntax.Perl)
+	if err != nil {
+		return true
+	}
+	var walk func(re *syntax.Regexp) bool
+	walk = func(re *syntax.Regexp) bool {
+		switch re.Op {
+		case syntax.OpLiteral, syntax.OpCharClass, syntax.OpAnyChar, syntax.OpAnyCharNotNL:
+			return false
+		case syntax.OpNoMatch:
+			return false
+		case syntax.OpStar, syntax.OpQuest:
+			return true
+		case syntax.OpPlus, syntax.OpCapture:
+			return walk(re.Sub[0])
+		case syntax.OpRepeat:
+			return re.Min == 0 || walk(re.Sub[0])
+		case syntax.OpConcat:
+			for _, s := range re.Sub {
+				if !walk(s) {
+					return false
+				}
+			}
+			return true
+		case syntax.OpAlternate:
+			for _, s := range re.Sub {
+				if walk(s) {
+					return true
+				}
+			}
+			return false
+		default: // OpEmptyMatch and the assertions
+			return true
+		}
+	}
+	return walk(re)
+}
+
+// --------------------------------------------------------------------------- cases
+
+// methodCase: a pattern, a text over the pool it may be run on, and a replacement template
+// for its groups.
+type methodCase struct {
+	p          pat
+	text, tmpl string
+}
+
+var methodCases = hegel.FlatMap(patterns, func(p pat) hegel.Generator[methodCase] {
+	return hegel.Composite(func(tc hegel.TestCase) methodCase {
+		return methodCase{p: p, text: hegel.Draw(tc, texts(poolFor(p, alphabet))), tmpl: hegel.Draw(tc, templates(p.groups))}
+	})
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c methodCase) GoString() string {
+	return fmt.Sprintf("pattern %q text %q template %q", c.p.src, c.text, c.tmpl)
+}
+
+var (
+	perlCases  = patTexts(patterns, alphabet)
+	posixCases = patTexts(posixPatterns, alphabet)
+)
+
+// --------------------------------------------------------------------------- properties
+
+// methodsAgree judges one case: every matching, finding, replacing and splitting method of
+// go-re2 returns what regexp's does on the pattern and text.
+func methodsAgree(ht *hegel.T, tcase methodCase) {
+	p, text, tmpl := tcase.p, tcase.text, tcase.tmpl
+	g, r := compileBoth(ht, p, false)
+	k := newCheck(ht, p, text)
+	b := []byte(text)
+
+	k.eq("String", r.String(), g.String())
+	k.eq("NumSubexp", r.NumSubexp(), g.NumSubexp())
+	k.eq("SubexpNames", r.SubexpNames(), g.SubexpNames())
+	for _, name := range append(append([]string(nil), groupNames...), "", "zz") {
+		k.eq("SubexpIndex("+name+")", r.SubexpIndex(name), g.SubexpIndex(name))
+	}
+
+	k.eq("MatchString", r.MatchString(text), g.MatchString(text))
+	k.eq("Match", r.Match(b), g.Match(b))
+	k.eq("FindString", r.FindString(text), g.FindString(text))
+	k.eq("FindStringIndex", r.FindStringIndex(text), g.FindStringIndex(text))
+	k.eq("Find", r.Find(b), g.Find(b))
+	k.eq("FindIndex", r.FindIndex(b), g.FindIndex(b))
+	k.eq("FindStringSubmatch", r.FindStringSubmatch(text), g.FindStringSubmatch(text))
+	k.eq("FindStringSubmatchIndex", r.FindStringSubmatchIndex(text), g.FindStringSubmatchIndex(text))
+	k.eq("FindSubmatch", r.FindSubmatch(b), g.FindSubmatch(b))
+	k.eq("FindSubmatchIndex", r.FindSubmatchIndex(b), g.FindSubmatchIndex(b))
+
+	hasEmpty := nullable(p.src)
+	for _, lim := range limits {
+		k.findAll(r, g, lim, hasEmpty)
+	}
+
+	k.eq("ReplaceAllString("+tmpl+")", r.ReplaceAllString(text, tmpl), g.ReplaceAllString(text, tmpl))
+	k.eq("ReplaceAll("+tmpl+")", r.ReplaceAll(b, []byte(tmpl)), g.ReplaceAll(b, []byte(tmpl)))
+	k.eq("ReplaceAllLiteralString("+tmpl+")", r.ReplaceAllLiteralString(text, tmpl), g.ReplaceAllLiteralString(text, tmpl))
+	k.eq("ReplaceAllLiteral("+tmpl+")", r.ReplaceAllLiteral(b, []byte(tmpl)), g.ReplaceAllLiteral(b, []byte(tmpl)))
+	var seenR, seenG []string
+	wrap := func(seen *[]string) func(string) string {
+		return func(m string) string {
+			*seen = append(*seen, m)
+			return "<" + strings.ToUpper(m) + ">"
+		}
+	}
+	k.eq("ReplaceAllStringFunc", r.ReplaceAllStringFunc(text, wrap(&seenR)), g.ReplaceAllStringFunc(text, wrap(&seenG)))
+	k.eq("ReplaceAllStringFunc calls", seenR, seenG)
+	var seenRB, seenGB [][]byte
+	wrapB := func(seen *[][]byte) func([]byte) []byte {
+		return func(m []byte) []byte {
+			*seen = append(*seen, append([]byte(nil), m...))
+			return append(append([]byte("<"), m...), '>')
+		}
+	}
+	k.eq("ReplaceAllFunc", r.ReplaceAllFunc(b, wrapB(&seenRB)), g.ReplaceAllFunc(b, wrapB(&seenGB)))
+	k.eq("ReplaceAllFunc calls", seenRB, seenGB)
+
+	// Expand over the match regexp found (both agree on it by now, or the case has failed).
+	if m := g.FindStringSubmatchIndex(text); m != nil {
+		k.eq("ExpandString("+tmpl+")", string(r.ExpandString(nil, tmpl, text, m)), string(g.ExpandString(nil, tmpl, text, m)))
+		k.eq("Expand("+tmpl+")", string(r.Expand([]byte("pre"), []byte(tmpl), b, m)), string(g.Expand([]byte("pre"), []byte(tmpl), b, m)))
+	}
+}
+
+// TestHegelMethodsAgreeWithRegexp: every matching, finding, replacing and splitting method
+// of go-re2 returns what regexp's does, on a generated pattern and text. The case draws the
+// shapes of go-re2/1, /2 and /4 at their natural rate; the limit 0 on a pattern that matches
+// (go-re2/1) is half the cases, so the property fails every run and shrinks to it.
+func TestHegelMethodsAgreeWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		methodsAgree(ht, hegel.Draw(ht, methodCases))
+	})
+}
+
+// TestHegelLongestAgreesWithRegexp: after Longest (and for CompilePOSIX, which implies it)
+// the leftmost-longest results agree. FindAllSubmatch(2) on a pattern that can match the empty
+// string is the shape of go-re2/4, reached in about one case in two hundred.
+func TestHegelLongestAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, perlCases)
+		p, text := tcase.p, tcase.text
+		g, r := compileBoth(ht, p, false)
+		g.Longest()
+		r.Longest()
+		k := newCheck(ht, p, text)
+		b := []byte(text)
+		k.eq("Longest MatchString", r.MatchString(text), g.MatchString(text))
+		k.eq("Longest FindStringSubmatchIndex", r.FindStringSubmatchIndex(text), g.FindStringSubmatchIndex(text))
+		k.eq("Longest FindAllStringSubmatchIndex", r.FindAllStringSubmatchIndex(text, -1), g.FindAllStringSubmatchIndex(text, -1))
+		k.eqShaped("Longest FindAllSubmatch(2)", limitShape(2, true, nullable(p.src)), r.FindAllSubmatch(b, 2), g.FindAllSubmatch(b, 2))
+		k.eq("Longest ReplaceAllString", r.ReplaceAllString(text, "<$0>"), g.ReplaceAllString(text, "<$0>"))
+		k.eq("Longest Split", r.Split(text, -1), g.Split(text, -1))
+		// Longest is idempotent.
+		r.Longest()
+		k.eq("Longest twice FindAllStringIndex", r.FindAllStringIndex(text, -1), g.FindAllStringIndex(text, -1))
+	})
+}
+
+// posixAgree judges one case: CompilePOSIX accepts the ERE pattern as regexp's does and
+// matches it the same (leftmost-longest, line anchors).
+func posixAgree(ht *hegel.T, p pat, text string) {
+	g, r := compileBoth(ht, p, true)
+	k := newCheck(ht, p, text)
+	k.eq("POSIX NumSubexp", r.NumSubexp(), g.NumSubexp())
+	k.eq("POSIX MatchString", r.MatchString(text), g.MatchString(text))
+	k.eq("POSIX FindStringSubmatchIndex", r.FindStringSubmatchIndex(text), g.FindStringSubmatchIndex(text))
+	k.eq("POSIX FindAllStringSubmatchIndex", r.FindAllStringSubmatchIndex(text, -1), g.FindAllStringSubmatchIndex(text, -1))
+	k.eq("POSIX FindAllString(2)", r.FindAllString(text, 2), g.FindAllString(text, 2))
+	k.eq("POSIX ReplaceAllString", r.ReplaceAllString(text, "<$0>"), g.ReplaceAllString(text, "<$0>"))
+	k.eq("POSIX Split", r.Split(text, -1), g.Split(text, -1))
+}
+
+// TestHegelPOSIXAgreesWithRegexp: CompilePOSIX accepts the same ERE patterns and matches them
+// the same, on a generated ERE pattern and text. A negated class beside a text with a newline
+// (go-re2/3) is about one case in a hundred.
+func TestHegelPOSIXAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, posixCases)
+		posixAgree(ht, tcase.p, tcase.text)
+	})
+}
+
+// TestHegelPackageFunctionsAgreeWithRegexp: MatchString, Match, QuoteMeta and MustCompile's
+// panic on the package level, and Copy.
+func TestHegelPackageFunctionsAgreeWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, perlCases)
+		p, text := tcase.p, tcase.text
+		k := newCheck(ht, p, text)
+		mg, eg := regexp.MatchString(p.src, text)
+		mr, er := re2.MatchString(p.src, text)
+		k.eq("MatchString error", er != nil, eg != nil)
+		k.eq("MatchString", mr, mg)
+		bg, eg2 := regexp.Match(p.src, []byte(text))
+		br, er2 := re2.Match(p.src, []byte(text))
+		k.eq("Match error", er2 != nil, eg2 != nil)
+		k.eq("Match", br, bg)
+		k.eq("QuoteMeta", re2.QuoteMeta(text), regexp.QuoteMeta(text))
+		qg := regexp.MustCompile(regexp.QuoteMeta(text))
+		qr := re2.MustCompile(re2.QuoteMeta(text))
+		k.eq("QuoteMeta FindAllStringIndex", qr.FindAllStringIndex(text+text, -1), qg.FindAllStringIndex(text+text, -1))
+		if eg != nil {
+			// rejected by both: MustCompile panics in both, and that is the verdict
+			pg := catch(func() { regexp.MustCompile(p.src) })
+			pr := catch(func() { re2.MustCompile(p.src) })
+			k.eq("MustCompile panics", pr != nil, pg != nil)
+			return
+		}
+		r := re2.MustCompile(p.src)
+		cp := r.Copy()
+		k.eq("Copy FindAllStringSubmatchIndex", cp.FindAllStringSubmatchIndex(text, -1), r.FindAllStringSubmatchIndex(text, -1))
+		k.eq("Copy SubexpNames", cp.SubexpNames(), r.SubexpNames())
+	})
+}
+
+// catch runs f and returns the value it panicked with, or nil.
+func catch(f func()) (r any) {
+	defer func() { r = recover() }()
+	f()
+	return nil
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..c3c99fe
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,75 @@
+package re2_test
+
+// One plain test per recorded bug (bugs.toml): each asserts regexp's behaviour and fails while
+// the bug exists; target.toml lists them as expected failures.
+
+import (
+	"reflect"
+	"regexp"
+	"testing"
+	"unicode/utf8"
+
+	re2 "github.com/wasilibs/go-re2"
+)
+
+// go-re2/1: the FindAll methods with n == 0 return every match; regexp returns nil.
+func TestHegelPinFindAllWithZeroLimitIsNil(t *testing.T) {
+	r := re2.MustCompile(`a`)
+	if got := r.FindAllString("aXa", 0); got != nil {
+		t.Errorf("FindAllString(\"aXa\", 0) = %q, want nil (regexp: %#v)", got, regexp.MustCompile(`a`).FindAllString("aXa", 0))
+	}
+	if got := r.FindAllStringSubmatchIndex("aXa", 0); got != nil {
+		t.Errorf("FindAllStringSubmatchIndex(\"aXa\", 0) = %v, want nil", got)
+	}
+	if got := r.FindAllIndex([]byte("aXa"), 0); got != nil {
+		t.Errorf("FindAllIndex(\"aXa\", 0) = %v, want nil", got)
+	}
+}
+
+// go-re2/2: \B matches between the bytes of a multi-byte character, so Split cuts a character
+// into invalid UTF-8 pieces; regexp never matches inside a character.
+func TestHegelPinNonBoundaryStaysBetweenCharacters(t *testing.T) {
+	if re2.MustCompile(`\B`).MatchString("1ſA") {
+		t.Errorf("MatchString(`\\B`, %q) = true, want false: the word boundaries are at 0, 1, 3 and 4, and \\B cannot hold inside the ſ", "1ſA")
+	}
+	for _, text := range []string{"bſ", "b日", "bKb", "ſbbbſ"} {
+		want := regexp.MustCompile(`\B`).FindAllStringIndex(text, -1)
+		got := re2.MustCompile(`\B`).FindAllStringIndex(text, -1)
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("FindAllStringIndex(`\\B`, %q) = %v, want %v", text, got, want)
+		}
+		for _, piece := range re2.MustCompile(`\B`).Split(text, -1) {
+			if !utf8.ValidString(piece) {
+				t.Errorf("Split(`\\B`, %q) has the piece %q, which is not valid UTF-8", text, piece)
+			}
+		}
+	}
+}
+
+// go-re2/3: under CompilePOSIX a negated class matches a newline; regexp's does not (the POSIX
+// syntax has no ClassNL).
+func TestHegelPinPOSIXNegatedClassExcludesNewline(t *testing.T) {
+	for _, p := range []string{`[^a]`, `[^a]+`, `[^[:alpha:]]`} {
+		want := regexp.MustCompilePOSIX(p).FindAllStringIndex("b\nc", -1)
+		got := re2.MustCompilePOSIX(p).FindAllStringIndex("b\nc", -1)
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("CompilePOSIX(%q).FindAllStringIndex(\"b\\nc\") = %v, want %v", p, got, want)
+		}
+	}
+}
+
+// go-re2/4: the FindAll...Submatch... methods count an empty match they skip against n.
+func TestHegelPinSubmatchLimitCountsDeliveredMatches(t *testing.T) {
+	g := regexp.MustCompile(`a*`)
+	r := re2.MustCompile(`a*`)
+	if got, want := r.FindAllStringSubmatch("baaab", 3), g.FindAllStringSubmatch("baaab", 3); !reflect.DeepEqual(got, want) {
+		t.Errorf("FindAllStringSubmatch(`a*`, \"baaab\", 3) = %q, want %q", got, want)
+	}
+	if got, want := r.FindAllStringSubmatchIndex("baaab", 3), g.FindAllStringSubmatchIndex("baaab", 3); !reflect.DeepEqual(got, want) {
+		t.Errorf("FindAllStringSubmatchIndex(`a*`, \"baaab\", 3) = %v, want %v", got, want)
+	}
+	// The plain FindAll methods get it right.
+	if got, want := r.FindAllStringIndex("baaab", 3), g.FindAllStringIndex("baaab", 3); !reflect.DeepEqual(got, want) {
+		t.Errorf("FindAllStringIndex(`a*`, \"baaab\", 3) = %v, want %v", got, want)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..fa4f6c1
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,313 @@
+package re2_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the checks of the wide properties, so that each bug has a
+// property that finds it every run (the wide properties reach the shapes of go-re2/2, /3 and
+// /4 in less than one case in a hundred). Under HEGEL_NO_KNOWN=1 each draws the neighbouring
+// region the bug does not touch instead (a non-zero limit, an ASCII character after the word
+// character, a text without a newline, a quantifier that cannot match the empty string) and
+// passes.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// without keeps the strings not containing sub.
+func without(xs []string, sub string) []string {
+	var out []string
+	for _, x := range xs {
+		if !strings.Contains(x, sub) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+var (
+	asciiAlphabet  = keep(alphabet, func(r rune) bool { return r < 0x80 })
+	multiByteRunes = keep(alphabet, func(r rune) bool { return r >= 0x80 })
+	wordRunes      = keep(alphabet, func(r rune) bool { return r < 0x80 && syntaxWord(r) })
+	// the flag settings and flagged groups without (?U), which would make a lazy quantifier
+	// greedy
+	nonSwappingFlags      = without(flagSettings, "U")
+	nonSwappingGroupFlags = without(groupFlags, "U")
+)
+
+// syntaxWord is the \w of both packages: ASCII letters, digits and the underscore.
+func syntaxWord(r rune) bool {
+	return r == '_' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z'
+}
+
+// short draws a text of up to three characters over the pool.
+func short(pool []rune) hegel.Generator[string] {
+	return hegel.Text().Alphabet(string(pool)).MaxSize(3)
+}
+
+// limitCase is a pattern, a text and the n of a FindAll call.
+type limitCase struct {
+	p     pat
+	text  string
+	limit int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c limitCase) GoString() string {
+	return fmt.Sprintf("pattern %q text %q limit %d", c.p.src, c.text, c.limit)
+}
+
+// --------------------------------------------------------------------------- framing
+
+// framing puts a concatenation into a pattern: as it is, in a group, after a flag setting,
+// beside a literal alternative. None of them changes whether the pieces match.
+type framing struct {
+	group      *group   // nil: no group around the pieces
+	flag       string   // "": no flag setting before them
+	other      *literal // nil: no second branch
+	otherFirst bool     // the second branch written first
+}
+
+func (f framing) pattern(c cat) alt {
+	if f.group != nil {
+		g := *f.group
+		g.body = alt{c}
+		c = cat{piece{atom: atom{kind: atomGroup, group: g}}}
+	}
+	if f.flag != "" {
+		c = append(cat{piece{atom: atom{kind: atomNamed, text: f.flag}}}, c...)
+	}
+	if f.other == nil {
+		return alt{c}
+	}
+	o := cat{piece{atom: literalAtom(*f.other)}}
+	if f.otherFirst {
+		return alt{o, c}
+	}
+	return alt{c, o}
+}
+
+// framingsOf draws a framing with the flag settings and flagged groups given: the pieces as
+// they are most of the time.
+func framingsOf(flags, gflags []string) hegel.Generator[framing] {
+	others := hegel.Map(literalsOf(perlDialect), func(l literal) *literal { return &l })
+	return hegel.Composite(func(tc hegel.TestCase) framing {
+		return framing{
+			group:      hegel.Draw(tc, hegel.Optional(headsOf(gflags))),
+			flag:       hegel.Draw(tc, maybe(20, hegel.SampledFrom(flags))),
+			other:      hegel.Draw(tc, maybe(25, others)),
+			otherFirst: hegel.Draw(tc, chance(50)),
+		}
+	})
+}
+
+var (
+	framings            = framingsOf(flagSettings, groupFlags)
+	nonSwappingFramings = framingsOf(nonSwappingFlags, nonSwappingGroupFlags)
+)
+
+// --------------------------------------------------------------------------- go-re2/1
+
+// zeroLimitCases: a text and a pattern that matches it (the literal of a substring of it in
+// the alphabet's spellings, framed), with the limit 0; under HEGEL_NO_KNOWN=1 with a limit of
+// -1, 1, 2 or 3.
+var zeroLimitCases = hegel.Composite(func(tc hegel.TestCase) limitCase {
+	text := hegel.Draw(tc, texts(alphabet))
+	rs := []rune(text)
+	from := hegel.Draw(tc, hegel.Integers(0, len(rs)))
+	to := hegel.Draw(tc, hegel.Integers(from, len(rs)))
+	spells := hegel.Draw(tc, hegel.Lists(spellings(perlDialect)).MinSize(to-from).MaxSize(to-from))
+	c := make(cat, to-from)
+	for i, r := range rs[from:to] {
+		c[i] = piece{atom: literalAtom(literal{r: r, spell: spells[i]})}
+	}
+	p := render(hegel.Draw(tc, framings).pattern(c), perlDialect)
+	return limitCase{p: p, text: text, limit: hegel.Draw(tc, shaped(hegel.Just(0), hegel.SampledFrom([]int{-1, 1, 2, 3})))}
+})
+
+// TestHegelFindAllWithZeroLimitAgreesWithRegexp: the FindAll methods and Split with n = 0 on a
+// pattern that matches the text return what regexp's do (nil). go-re2's FindAll methods return
+// every match (go-re2/1).
+func TestHegelFindAllWithZeroLimitAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroLimitCases)
+		g, r := compileBoth(ht, c.p, false)
+		newCheck(ht, c.p, c.text).findAll(r, g, c.limit, nullable(c.p.src))
+	})
+}
+
+// --------------------------------------------------------------------------- go-re2/2
+
+// nonBoundaryCases: a pattern whose \B can hold with nothing consumed after it (\B, repeated
+// at least once, then nothing or a lazily optional atom, framed), a text with a word character
+// right before a multi-byte one, and a template. Under HEGEL_NO_KNOWN=1 the text is ASCII.
+var (
+	atLeastOnce = maybe(40, hegel.SampledFrom([]quantifier{{kind: qPlus}, {kind: qPlus, lazy: true}, {kind: qExact, lo: 1}, {kind: qAtLeast, lo: 1}}))
+	lazyOptions = hegel.SampledFrom([]quantifier{{kind: qStar, lazy: true}, {kind: qOpt, lazy: true}})
+	tailAtoms   = hegel.OneOf(
+		hegel.Map(literalsOf(perlDialect), literalAtom),
+		hegel.Just(atom{kind: atomDot}),
+		namedAtoms(perlEscapes),
+		namedAtoms(unicodeClasses),
+	)
+	tails = maybe(40, hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{atom: hegel.Draw(tc, tailAtoms), quant: hegel.Draw(tc, lazyOptions)}
+	}))
+	nonBoundaryCases = hegel.Composite(func(tc hegel.TestCase) methodCase {
+		c := cat{piece{atom: atom{kind: atomNamed, text: `\B`}, quant: hegel.Draw(tc, atLeastOnce)}}
+		if tail := hegel.Draw(tc, tails); tail.quant.kind != qNone { // drawn, not maybe's zero
+			c = append(c, tail)
+		}
+		p := render(hegel.Draw(tc, nonSwappingFramings).pattern(c), perlDialect)
+		pool := shaped(alphabet, asciiAlphabet)
+		text := hegel.Draw(tc, short(pool)) +
+			string(hegel.Draw(tc, hegel.SampledFrom(wordRunes))) +
+			string(hegel.Draw(tc, hegel.SampledFrom(shaped(multiByteRunes, asciiAlphabet)))) +
+			hegel.Draw(tc, short(pool))
+		return methodCase{p: p, text: text, tmpl: hegel.Draw(tc, templates(p.groups))}
+	})
+)
+
+// TestHegelNonBoundaryOnMultiByteTextAgreesWithRegexp: a \B pattern on a text with a word
+// character before a multi-byte one matches, finds, splits and replaces as regexp does.
+// go-re2 finds \B between the bytes of the multi-byte character (go-re2/2), so Split cuts it
+// and ReplaceAll writes inside it.
+func TestHegelNonBoundaryOnMultiByteTextAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nonBoundaryCases)
+		p, text, tmpl := c.p, c.text, c.tmpl
+		g, r := compileBoth(ht, p, false)
+		k := newCheck(ht, p, text)
+		k.eq("MatchString", r.MatchString(text), g.MatchString(text))
+		k.eq("FindStringIndex", r.FindStringIndex(text), g.FindStringIndex(text))
+		k.findAll(r, g, -1, true)
+		k.eq("ReplaceAllString("+tmpl+")", r.ReplaceAllString(text, tmpl), g.ReplaceAllString(text, tmpl))
+		k.eq("ReplaceAllLiteralString("+tmpl+")", r.ReplaceAllLiteralString(text, tmpl), g.ReplaceAllLiteralString(text, tmpl))
+	})
+}
+
+// --------------------------------------------------------------------------- go-re2/3
+
+// posixNewlineCases: a negated bracket class whose items leave the newline out (literals
+// other than it, ranges above it in the sorted alphabet, the POSIX names that do not hold
+// it), quantified or in a group some of the time, and a text with a newline; under
+// HEGEL_NO_KNOWN=1 a text without one.
+var (
+	newlineIndex = slices.Index(sortedAlphabet, '\n')
+	// the POSIX names whose class does not hold the newline, decided by regexp
+	newlineFreeNames = keepStrings(posixNames, func(name string) bool {
+		return !regexp.MustCompilePOSIX("[" + name + "]").MatchString("\n")
+	})
+	newlineFreeItems = weighted(
+		choice[classItem]{7, hegel.Map(hegel.SampledFrom(keep(alphabet, func(r rune) bool { return r != '\n' })), func(r rune) classItem {
+			return classItem{kind: itemLiteral, lit: literal{r: r, spell: plain}}
+		})},
+		choice[classItem]{2, hegel.Composite(func(tc hegel.TestCase) classItem {
+			lo := hegel.Draw(tc, hegel.Integers(newlineIndex+1, len(sortedAlphabet)-1))
+			return classItem{kind: itemRange, lo: lo, hi: hegel.Draw(tc, hegel.Integers(lo, len(sortedAlphabet)-1))}
+		})},
+		choice[classItem]{1, namedItems(newlineFreeNames)},
+	)
+	posixQuants       = maybe(50, hegel.SampledFrom([]quantifier{{kind: qStar}, {kind: qPlus}, {kind: qOpt}}))
+	posixNewlineCases = hegel.Composite(func(tc hegel.TestCase) patText {
+		c := class{negated: true, items: hegel.Draw(tc, hegel.Lists(newlineFreeItems).MinSize(1).MaxSize(3))}
+		a := alt{cat{piece{atom: atom{kind: atomClass, class: c}, quant: hegel.Draw(tc, posixQuants)}}}
+		if hegel.Draw(tc, chance(30)) {
+			a = alt{cat{piece{atom: atom{kind: atomGroup, group: group{kind: gCapture, body: a}}}}}
+		}
+		pool := shaped(alphabet, keep(alphabet, func(r rune) bool { return r != '\n' }))
+		text := hegel.Draw(tc, short(pool)) +
+			hegel.Draw(tc, shaped[hegel.Generator[string]](hegel.Just("\n"), hegel.Text().Alphabet(string(pool)).MinSize(1).MaxSize(1))) +
+			hegel.Draw(tc, short(pool))
+		return patText{p: render(a, posixDialect), text: text}
+	})
+)
+
+// keepStrings returns the strings that satisfy ok.
+func keepStrings(xs []string, ok func(string) bool) []string {
+	var out []string
+	for _, x := range xs {
+		if ok(x) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// TestHegelPOSIXNegatedClassOnNewlineAgreesWithRegexp: under CompilePOSIX a negated class
+// that does not name the newline is matched on a text with one as regexp matches it (not at
+// the newline: the POSIX syntax has no ClassNL). go-re2's matches the newline (go-re2/3).
+func TestHegelPOSIXNegatedClassOnNewlineAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, posixNewlineCases)
+		posixAgree(ht, c.p, c.text)
+	})
+}
+
+// --------------------------------------------------------------------------- go-re2/4
+
+// submatchLimitCases: a pattern matching any number of one character x (a literal in one of
+// its spellings, a class of it or \Qx\E, under * or {0,}, in a group some of the time, around
+// the atom or around the quantified piece), a text of a prefix without x, a run of x, a
+// character that is not x and a suffix, and the limit that reaches the empty match after the
+// run: one per character of the prefix, one for the run, one more. Under HEGEL_NO_KNOWN=1 the
+// quantifier is + or {1,}, so no match is empty.
+var (
+	anyNumber          = hegel.SampledFrom([]quantifier{{kind: qStar}, {kind: qAtLeast, lo: 0}})
+	atLeastOne         = hegel.SampledFrom([]quantifier{{kind: qPlus}, {kind: qAtLeast, lo: 1}})
+	runQuants          = shaped(anyNumber, atLeastOne)
+	plainHeads         = headsOf(nil)
+	submatchLimitCases = hegel.Composite(func(tc hegel.TestCase) limitCase {
+		x := hegel.Draw(tc, hegel.SampledFrom(alphabet))
+		a := hegel.Draw(tc, hegel.OneOf(
+			hegel.Map(spellings(perlDialect), func(s spelling) atom { return literalAtom(literal{r: x, spell: s}) }),
+			hegel.Just(atom{kind: atomClass, class: class{items: []classItem{{kind: itemLiteral, lit: literal{r: x, spell: plain}}}}}),
+			hegel.Just(atom{kind: atomQuoted, runes: []rune{x}}),
+		))
+		q := hegel.Draw(tc, runQuants)
+		var tree alt
+		switch head := hegel.Draw(tc, hegel.Optional(plainHeads)); {
+		case head == nil:
+			tree = alt{cat{piece{atom: a, quant: q}}}
+		case hegel.Draw(tc, chance(50)): // the group around the quantified piece: (x*)
+			head.body = alt{cat{piece{atom: a, quant: q}}}
+			tree = alt{cat{piece{atom: atom{kind: atomGroup, group: *head}}}}
+		default: // the group around the atom: (x)*
+			head.body = alt{cat{piece{atom: a}}}
+			tree = alt{cat{piece{atom: atom{kind: atomGroup, group: *head}, quant: q}}}
+		}
+		notX := keep(alphabet, func(r rune) bool { return r != x })
+		prefix := hegel.Draw(tc, short(notX))
+		text := prefix +
+			strings.Repeat(string(x), hegel.Draw(tc, hegel.Integers(1, 3))) +
+			string(hegel.Draw(tc, hegel.SampledFrom(notX))) +
+			hegel.Draw(tc, short(alphabet))
+		return limitCase{p: render(tree, perlDialect), text: text, limit: utf8.RuneCountInString(prefix) + 2}
+	})
+)
+
+// TestHegelSubmatchLimitPastEmptyMatchAgreesWithRegexp: the FindAll...Submatch... methods
+// with a positive n on a pattern that can match the empty string return the same n matches as
+// regexp's, an empty match abutting the previous one skipped by both. go-re2 counts the skipped
+// match against n and returns one match too few (go-re2/4); the plain FindAll methods agree.
+func TestHegelSubmatchLimitPastEmptyMatchAgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, submatchLimitCases)
+		g, r := compileBoth(ht, c.p, false)
+		newCheck(ht, c.p, c.text).findAll(r, g, c.limit, nullable(c.p.src))
+	})
+}
