diff --git a/hegel_experimental_test.go b/hegel_experimental_test.go
new file mode 100644
index 0000000..d9d29ac
--- /dev/null
+++ b/hegel_experimental_test.go
@@ -0,0 +1,159 @@
+package re2_test
+
+// The experimental package: CompileSet against each pattern's own MatchString, and
+// CompileLatin1 against regexp on the text transcoded to UTF-8.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	re2 "github.com/wasilibs/go-re2"
+	"github.com/wasilibs/go-re2/experimental"
+)
+
+// setCase: one to four patterns regexp accepts, a text over the pool they may all be run on,
+// and a limit taken modulo their number.
+type setCase struct {
+	pats  []pat
+	text  string
+	limit int
+}
+
+var setCases = hegel.FlatMap(
+	hegel.Lists(hegel.Filter(patterns, func(p pat) bool { _, err := regexp.Compile(p.src); return err == nil })).MinSize(1).MaxSize(4),
+	func(ps []pat) hegel.Generator[setCase] {
+		pool := alphabet
+		for _, p := range ps {
+			pool = poolFor(p, pool)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) setCase {
+			return setCase{pats: ps, text: hegel.Draw(tc, texts(pool)), limit: hegel.Draw(tc, hegel.Integers(0, 3))}
+		})
+	},
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c setCase) GoString() string {
+	srcs := make([]string, len(c.pats))
+	for i, p := range c.pats {
+		srcs[i] = p.src
+	}
+	return fmt.Sprintf("patterns %q text %q limit %d", srcs, c.text, 1+c.limit%len(c.pats))
+}
+
+// TestHegelSetAgreesWithEachPattern: a Set reports exactly the patterns that match, and with
+// a limit n at most n of them.
+func TestHegelSetAgreesWithEachPattern(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, setCases)
+		text := tcase.text
+		exprs := make([]string, 0, len(tcase.pats))
+		var want []int
+		for i, p := range tcase.pats {
+			g, err := regexp.Compile(p.src)
+			ht.Assume(err == nil) // drawn accepted
+			if _, err := re2.Compile(p.src); err != nil {
+				ht.Fatalf("Compile(%q): go-re2 rejects what regexp accepts: %v", p.src, err)
+			}
+			exprs = append(exprs, p.src)
+			if g.MatchString(text) {
+				want = append(want, i)
+			}
+		}
+		set, err := experimental.CompileSet(exprs)
+		if err != nil {
+			ht.Fatalf("CompileSet(%q): %v", exprs, err)
+		}
+		got, err := set.FindAllStringWithError(text, -1)
+		if err != nil {
+			ht.Fatalf("Set(%q).FindAllString(%q): %v", exprs, text, err)
+		}
+		sort.Ints(got)
+		if !slices.Equal(got, want) {
+			ht.Fatalf("Set(%q).FindAllString(%q, -1) = %v, want %v", exprs, text, got, want)
+		}
+		gotB := set.FindAll([]byte(text), -1)
+		sort.Ints(gotB)
+		if !slices.Equal(gotB, want) {
+			ht.Fatalf("Set(%q).FindAll(%q, -1) = %v, want %v", exprs, text, gotB, want)
+		}
+		if got := set.FindAllString(text, 0); got != nil {
+			ht.Fatalf("Set(%q).FindAllString(%q, 0) = %v, want nil", exprs, text, got)
+		}
+		lim := 1 + tcase.limit%len(exprs)
+		limited := set.FindAllString(text, lim)
+		if len(limited) != min(lim, len(want)) {
+			ht.Fatalf("Set(%q).FindAllString(%q, %d) = %v, want %d of %v", exprs, text, lim, limited, min(lim, len(want)), want)
+		}
+		for _, i := range limited {
+			if !slices.Contains(want, i) {
+				ht.Fatalf("Set(%q).FindAllString(%q, %d) = %v, includes a pattern that does not match (want %v)", exprs, text, lim, limited, want)
+			}
+		}
+	})
+}
+
+// latin1 transcodes a string of characters below U+0100 to one byte per character.
+func latin1(s string) (string, bool) {
+	b := make([]byte, 0, len(s))
+	for _, r := range s {
+		if r > 0xff {
+			return "", false
+		}
+		b = append(b, byte(r))
+	}
+	return string(b), true
+}
+
+var latinCases = patTexts(latinPatterns, latinAlphabet)
+
+// TestHegelLatin1AgreesWithRegexp: CompileLatin1 on a Latin-1 text finds what regexp finds on
+// the same characters in UTF-8, with offsets counted in bytes of each encoding.
+func TestHegelLatin1AgreesWithRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, latinCases)
+		p, text := tcase.p, tcase.text
+		lpat, ok1 := latin1(p.src)
+		ltext, ok2 := latin1(text)
+		ht.Assume(ok1 && ok2) // the Latin dialect stays below U+0100
+		g, eg := regexp.Compile(p.src)
+		r, er := experimental.CompileLatin1(lpat)
+		if (eg == nil) != (er == nil) {
+			ht.Fatalf("CompileLatin1(%q): regexp err=%v, go-re2 err=%v", p.src, eg, er)
+		}
+		ht.Assume(eg == nil) // rejected by both
+		// offset[i] is the UTF-8 offset of Latin-1 offset i.
+		offset := make([]int, len(ltext)+1)
+		for i := range ltext {
+			offset[i+1] = offset[i] + len(string(rune(ltext[i])))
+		}
+		want := g.FindAllStringSubmatchIndex(text, -1)
+		got := r.FindAllStringSubmatchIndex(ltext, -1)
+		if len(got) != len(want) {
+			ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v, regexp %v", p.src, text, got, want)
+		}
+		for i := range got {
+			if len(got[i]) != len(want[i]) {
+				ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v, regexp %v", p.src, text, got, want)
+			}
+			for j := range got[i] {
+				w := want[i][j]
+				gv := got[i][j]
+				if gv >= 0 {
+					gv = offset[gv]
+				}
+				if gv != w {
+					ht.Fatalf("CompileLatin1(%q).FindAllStringSubmatchIndex(%q) = %v (in Latin-1 offsets), regexp %v (in UTF-8 offsets)", p.src, text, got, want)
+				}
+			}
+		}
+		if got, want := r.MatchString(ltext), g.MatchString(text); got != want {
+			ht.Fatalf("CompileLatin1(%q).MatchString(%q) = %v, regexp %v", p.src, text, got, want)
+		}
+	})
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..48f1d69
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,675 @@
+package re2_test
+
+// The pattern, text and template generators. A pattern is drawn as a small syntax tree from
+// the RE2 grammar both regexp and go-re2 accept (see hegel_test.go for what is kept out), in
+// one of three dialects, and rendered to its source by a pure function that also numbers the
+// capturing groups; POSIX patterns come from the ERE subset CompilePOSIX takes. A text is a
+// string over the alphabet, narrowed by poolFor while a recorded bug stands; a template is a
+// list of pieces rendered against the pattern's group count.
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// alphabet: the runes texts and literals are made of. Case pairs (k/K/Kelvin sign, s/S/long s)
+// exercise simple case folding; é/É and 日 exercise \b, \w and Unicode classes; 😀 is four bytes.
+var alphabet = []rune{'a', 'b', 'A', 'B', 'k', 'K', 'K', 's', 'S', 'ſ', '0', '1', ' ', '\n', '-', '_', 'é', 'É', '日', '😀', '.'}
+
+// sortedAlphabet is the alphabet in code point order, for class ranges.
+var sortedAlphabet = slices.Sorted(slices.Values(alphabet))
+
+// latinAlphabet: the alphabet below U+0100, for the Latin-1 property.
+var latinAlphabet = keep(alphabet, func(r rune) bool { return r < 0x100 })
+
+var sortedLatinAlphabet = slices.Sorted(slices.Values(latinAlphabet))
+
+// keep returns the runes of pool that satisfy ok.
+func keep(pool []rune, ok func(rune) bool) []rune {
+	var xs []rune
+	for _, r := range pool {
+		if ok(r) {
+			xs = append(xs, r)
+		}
+	}
+	return xs
+}
+
+var groupNames = []string{"n", "x1", "_a", "a_b", "N"}
+
+// pat is a rendered pattern: its source, the number of capturing groups and their names, and
+// the two shapes the Known switches gate.
+type pat struct {
+	src          string
+	groups       int      // number of capturing groups
+	names        []string // names[i] is the name of group i (names[0] = "")
+	posix        bool     // drawn from the POSIX dialect
+	nonBoundary  bool     // has a \B assertion (go-re2/2)
+	negatedClass bool     // has a [^...] class (go-re2/3 under CompilePOSIX)
+}
+
+// --------------------------------------------------------------------------- the dialects
+
+// dialect selects the grammar a pattern is drawn from.
+type dialect int
+
+const (
+	perlDialect  dialect = iota // the full RE2 syntax
+	latinDialect                // literals below U+0100 and no Unicode classes, for CompileLatin1
+	posixDialect                // the ERE subset CompilePOSIX takes: no Perl escapes, flags, non-capturing groups or lazy quantifiers
+)
+
+func (d dialect) letters() []rune {
+	if d == latinDialect {
+		return latinAlphabet
+	}
+	return alphabet
+}
+
+func (d dialect) sorted() []rune {
+	if d == latinDialect {
+		return sortedLatinAlphabet
+	}
+	return sortedAlphabet
+}
+
+// --------------------------------------------------------------------------- the syntax tree
+
+// literal is one rune of the alphabet in one of its spellings.
+type spelling int
+
+const (
+	plain    spelling = iota // the character itself, QuoteMeta'd outside a class
+	escaped                  // \n for a newline, otherwise plain
+	hexBrace                 // \x{e9}
+	hex2                     // \x41 for a character below U+0080, otherwise plain
+	octal                    // \101 for a character below U+0080, otherwise plain
+)
+
+type literal struct {
+	r     rune
+	spell spelling
+}
+
+// write renders the literal; inside a class the metacharacters of a class are escaped, outside
+// QuoteMeta does it.
+func (l literal) write(sb *strings.Builder, inClass bool) {
+	switch {
+	case l.spell == hexBrace:
+		fmt.Fprintf(sb, `\x{%x}`, l.r)
+	case l.spell == hex2 && l.r < 0x80:
+		fmt.Fprintf(sb, `\x%02x`, l.r)
+	case l.spell == octal && l.r < 0x80:
+		fmt.Fprintf(sb, `\%03o`, l.r)
+	case l.spell == escaped && l.r == '\n':
+		sb.WriteString(`\n`)
+	case inClass:
+		if strings.ContainsRune(`\]^-[`, l.r) {
+			sb.WriteByte('\\')
+		}
+		sb.WriteRune(l.r)
+	default:
+		sb.WriteString(regexp.QuoteMeta(string(l.r)))
+	}
+}
+
+// classItem is one member of a bracket class; only the fields its kind uses are drawn.
+type classItemKind int
+
+const (
+	itemLiteral classItemKind = iota
+	itemRange                 // lo-hi over the sorted alphabet
+	itemNamed                 // \d, [:alpha:], \pL and the like, written as is
+)
+
+type classItem struct {
+	kind   classItemKind
+	lit    literal
+	lo, hi int    // itemRange: indices into the sorted alphabet, lo <= hi
+	name   string // itemNamed
+}
+
+type class struct {
+	negated bool
+	items   []classItem
+}
+
+func (c class) write(sb *strings.Builder, d dialect) {
+	sb.WriteByte('[')
+	if c.negated {
+		sb.WriteByte('^')
+	}
+	for _, it := range c.items {
+		switch it.kind {
+		case itemLiteral:
+			it.lit.write(sb, true)
+		case itemRange:
+			sorted := d.sorted()
+			literal{sorted[it.lo], escaped}.write(sb, true)
+			sb.WriteByte('-')
+			literal{sorted[it.hi], escaped}.write(sb, true)
+		case itemNamed:
+			sb.WriteString(it.name)
+		}
+	}
+	sb.WriteByte(']')
+}
+
+// quantifier follows an atom; the zero value is none, which is what maybe shrinks to.
+type quantKind int
+
+const (
+	qNone quantKind = iota
+	qStar
+	qPlus
+	qOpt
+	qExact   // {n}
+	qAtLeast // {n,}
+	qRange   // {n,m}
+)
+
+type quantifier struct {
+	kind     quantKind
+	lo, span int // qExact, qAtLeast: lo; qRange: lo,lo+span
+	lazy     bool
+}
+
+func (q quantifier) write(sb *strings.Builder) {
+	switch q.kind {
+	case qNone:
+		return
+	case qStar:
+		sb.WriteByte('*')
+	case qPlus:
+		sb.WriteByte('+')
+	case qOpt:
+		sb.WriteByte('?')
+	case qExact:
+		fmt.Fprintf(sb, "{%d}", q.lo)
+	case qAtLeast:
+		fmt.Fprintf(sb, "{%d,}", q.lo)
+	case qRange:
+		fmt.Fprintf(sb, "{%d,%d}", q.lo, q.lo+q.span)
+	}
+	if q.lazy {
+		sb.WriteByte('?')
+	}
+}
+
+// group is a parenthesised alternation; only the fields its kind uses are drawn.
+type groupKind int
+
+const (
+	gCapture    groupKind = iota // (...)
+	gNamed                       // (?P<name>...) or (?<name>...)
+	gNonCapture                  // (?:...)
+	gFlagged                     // (?i:...) and the like
+)
+
+type group struct {
+	kind  groupKind
+	name  string // gNamed
+	angle bool   // gNamed: (?<name> rather than (?P<name>
+	flags string // gFlagged: the opening, "(?i:"
+	body  alt
+}
+
+// open writes the opening of the group and numbers it when it captures.
+func (g group) open(sb *strings.Builder, p *pat) {
+	switch g.kind {
+	case gCapture:
+		p.groups++
+		p.names = append(p.names, "")
+		sb.WriteByte('(')
+	case gNamed:
+		p.groups++
+		p.names = append(p.names, g.name)
+		if g.angle {
+			fmt.Fprintf(sb, "(?<%s>", g.name)
+		} else {
+			fmt.Fprintf(sb, "(?P<%s>", g.name)
+		}
+	case gNonCapture:
+		sb.WriteString("(?:")
+	case gFlagged:
+		sb.WriteString(g.flags)
+	}
+}
+
+// atom is one element of a concatenation; only the fields its kind uses are drawn.
+type atomKind int
+
+const (
+	atomLiteral atomKind = iota
+	atomDot              // .
+	atomNamed            // \d, \pL, ^, \b, (?i): written as is
+	atomClass            // [...]
+	atomQuoted           // \Q...\E, or \Q to the end of the pattern
+	atomGroup            // (...)
+)
+
+type atom struct {
+	kind     atomKind
+	lit      literal
+	text     string // atomNamed
+	class    class
+	runes    []rune // atomQuoted
+	unclosed bool   // atomQuoted: no \E, the rest of the pattern is literal
+	group    group
+}
+
+// quantPct is how often a quantifier follows the atom: 40% of the time for the quantifiable
+// atoms, 8% (20% of 40%) for an assertion, never for a flag setting or an unclosed \Q.
+func (a atom) quantPct(d dialect) int {
+	switch a.kind {
+	case atomNamed:
+		if strings.HasPrefix(a.text, "(?") {
+			return 0
+		}
+		if slices.Contains(assertions, a.text) {
+			if d == posixDialect {
+				return 0
+			}
+			return 8
+		}
+	case atomQuoted:
+		if a.unclosed {
+			return 0
+		}
+	}
+	return 40
+}
+
+func (a atom) write(sb *strings.Builder, p *pat, d dialect) {
+	switch a.kind {
+	case atomLiteral:
+		a.lit.write(sb, false)
+	case atomDot:
+		sb.WriteByte('.')
+	case atomNamed:
+		if a.text == `\B` {
+			p.nonBoundary = true
+		}
+		sb.WriteString(a.text)
+	case atomClass:
+		if a.class.negated {
+			p.negatedClass = true
+		}
+		a.class.write(sb, d)
+	case atomQuoted:
+		sb.WriteString(`\Q`)
+		sb.WriteString(string(a.runes))
+		if !a.unclosed {
+			sb.WriteString(`\E`)
+		}
+	case atomGroup:
+		a.group.open(sb, p)
+		a.group.body.write(sb, p, d)
+		sb.WriteByte(')')
+	}
+}
+
+type piece struct {
+	atom  atom
+	quant quantifier
+}
+
+// cat is a concatenation of pieces; alt an alternation of concatenations (an empty cat is an
+// empty branch).
+type (
+	cat []piece
+	alt []cat
+)
+
+func (a alt) write(sb *strings.Builder, p *pat, d dialect) {
+	for i, c := range a {
+		if i > 0 {
+			sb.WriteByte('|')
+		}
+		for _, pc := range c {
+			pc.atom.write(sb, p, d)
+			pc.quant.write(sb)
+		}
+	}
+}
+
+// size counts the pieces of the tree, those inside groups included.
+func (a alt) size() int {
+	n := 0
+	for _, c := range a {
+		for _, pc := range c {
+			n++
+			if pc.atom.kind == atomGroup {
+				n += pc.atom.group.body.size()
+			}
+		}
+	}
+	return n
+}
+
+// render turns the tree into a pat.
+func render(a alt, d dialect) pat {
+	p := pat{names: []string{""}, posix: d == posixDialect}
+	var sb strings.Builder
+	a.write(&sb, &p, d)
+	p.src = sb.String()
+	return p
+}
+
+// --------------------------------------------------------------------------- the grammar
+
+var (
+	perlEscapes    = []string{`\d`, `\D`, `\w`, `\W`, `\s`, `\S`}
+	unicodeClasses = []string{`\pL`, `\PL`, `\p{L}`, `\p{Lu}`, `\p{Ll}`, `\p{Nd}`, `\p{Han}`, `\p{Latin}`, `\p{Greek}`, `\p{Zs}`, `\p{Any}`, `\p{^Lu}`, `\P{Han}`, `\pN`, `\p{So}`}
+	assertions     = []string{`^`, `$`, `\A`, `\z`, `\b`, `\B`}
+	posixAnchors   = []string{`^`, `$`}
+	flagSettings   = []string{`(?i)`, `(?m)`, `(?s)`, `(?U)`, `(?-i)`, `(?i-s)`, `(?ms)`, `(?-U)`}
+	groupFlags     = []string{"(?i:", "(?s:", "(?m:", "(?U:", "(?-i:", "(?is:", "(?i-s:", "(?-m:"}
+	posixNames     = []string{`[:alpha:]`, `[:^digit:]`, `[:word:]`, `[:space:]`, `[:upper:]`, `[:lower:]`, `[:punct:]`, `[:^alnum:]`}
+	classEscapes   = []string{`\d`, `\w`, `\s`, `\D`, `\W`, `\S`}
+	classUnicode   = []string{`\pL`, `\p{Greek}`, `\PL`, `\p{Lu}`, `\p{Han}`, `\pN`}
+)
+
+// named is an atom or class item written as one of the strings.
+func namedAtoms(xs []string) hegel.Generator[atom] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) atom { return atom{kind: atomNamed, text: s} })
+}
+
+func namedItems(xs []string) hegel.Generator[classItem] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) classItem { return classItem{kind: itemNamed, name: s} })
+}
+
+// spellings: the plain spelling most of the time; POSIX has no hex or octal escapes.
+func spellings(d dialect) hegel.Generator[spelling] {
+	if d == posixDialect {
+		return weighted(choice[spelling]{90, hegel.Just(plain)}, choice[spelling]{10, hegel.Just(escaped)})
+	}
+	return weighted(
+		choice[spelling]{62, hegel.Just(plain)},
+		choice[spelling]{10, hegel.Just(escaped)},
+		choice[spelling]{10, hegel.Just(hexBrace)},
+		choice[spelling]{10, hegel.Just(hex2)},
+		choice[spelling]{8, hegel.Just(octal)},
+	)
+}
+
+// quants: the six quantifiers evenly, lazy 30% of the time outside POSIX.
+func quants(d dialect) hegel.Generator[quantifier] {
+	bodies := hegel.OneOf(
+		hegel.Just(quantifier{kind: qStar}),
+		hegel.Just(quantifier{kind: qPlus}),
+		hegel.Just(quantifier{kind: qOpt}),
+		hegel.Map(hegel.Integers(0, 3), func(n int) quantifier { return quantifier{kind: qExact, lo: n} }),
+		hegel.Map(hegel.Integers(0, 3), func(n int) quantifier { return quantifier{kind: qAtLeast, lo: n} }),
+		hegel.Composite(func(tc hegel.TestCase) quantifier {
+			return quantifier{kind: qRange, lo: hegel.Draw(tc, hegel.Integers(0, 2)), span: hegel.Draw(tc, hegel.Integers(0, 2))}
+		}),
+	)
+	lazies := hegel.Just(false)
+	if d != posixDialect {
+		lazies = chance(30)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) quantifier {
+		q := hegel.Draw(tc, bodies)
+		q.lazy = hegel.Draw(tc, lazies)
+		return q
+	})
+}
+
+// heads: the opening of a group, the plain capture first; POSIX has only that.
+func heads(d dialect) hegel.Generator[group] {
+	capture := hegel.Just(group{kind: gCapture})
+	if d == posixDialect {
+		return capture
+	}
+	named := hegel.Composite(func(tc hegel.TestCase) group {
+		return group{kind: gNamed, name: hegel.Draw(tc, hegel.SampledFrom(groupNames)), angle: hegel.Draw(tc, chance(50))}
+	})
+	flagged := hegel.Map(hegel.SampledFrom(groupFlags), func(f string) group { return group{kind: gFlagged, flags: f} })
+	return weighted(
+		choice[group]{4, capture},
+		choice[group]{2, named},
+		choice[group]{2, hegel.Just(group{kind: gNonCapture})},
+		choice[group]{2, flagged},
+	)
+}
+
+// grammar returns the pattern generator of a dialect. Groups nest at most maxDepth deep: the
+// generator refers to itself through alts, and the depth counter in the closure tracks the
+// live recursion (hegel-go's ExampleComposite_recursive); at the bound a group becomes a
+// literal.
+func grammar(d dialect) hegel.Generator[pat] {
+	const maxDepth, maxPieces = 3, 12
+	depth := 0
+	var alts hegel.Generator[alt]
+
+	letters, spells := hegel.SampledFrom(d.letters()), spellings(d)
+	literals := hegel.Composite(func(tc hegel.TestCase) literal {
+		return literal{r: hegel.Draw(tc, letters), spell: hegel.Draw(tc, spells)}
+	})
+	literalAtoms := hegel.Map(literals, func(l literal) atom { return atom{kind: atomLiteral, lit: l} })
+
+	// class items: literals first, then ranges over the sorted alphabet, then the names the
+	// dialect allows.
+	sorted := d.sorted()
+	ranges := hegel.Composite(func(tc hegel.TestCase) classItem {
+		lo := hegel.Draw(tc, hegel.Integers(0, len(sorted)-1))
+		return classItem{kind: itemRange, lo: lo, hi: hegel.Draw(tc, hegel.Integers(lo, len(sorted)-1))}
+	})
+	literalItems := hegel.Map(literals, func(l literal) classItem { return classItem{kind: itemLiteral, lit: l} })
+	var items hegel.Generator[classItem]
+	switch d {
+	case posixDialect:
+		items = weighted(choice[classItem]{7, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(posixNames)})
+	case latinDialect:
+		items = weighted(choice[classItem]{6, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(classEscapes)}, choice[classItem]{1, namedItems(posixNames)})
+	default:
+		items = weighted(choice[classItem]{4, literalItems}, choice[classItem]{2, ranges}, choice[classItem]{1, namedItems(classEscapes)}, choice[classItem]{1, namedItems(posixNames)}, choice[classItem]{2, namedItems(classUnicode)})
+	}
+	classAtoms := hegel.Composite(func(tc hegel.TestCase) atom {
+		return atom{kind: atomClass, class: class{
+			negated: hegel.Draw(tc, chance(30)),
+			items:   hegel.Draw(tc, hegel.Lists(items).MinSize(1).MaxSize(3)),
+		}}
+	})
+
+	quoted := hegel.Composite(func(tc hegel.TestCase) atom {
+		return atom{kind: atomQuoted, runes: hegel.Draw(tc, hegel.Lists(letters).MaxSize(3)), unclosed: hegel.Draw(tc, chance(15))}
+	})
+
+	groupHeads := heads(d)
+	groups := hegel.Composite(func(tc hegel.TestCase) atom {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, literalAtoms)
+		}
+		g := hegel.Draw(tc, groupHeads)
+		depth++
+		defer func() { depth-- }()
+		g.body = hegel.Draw(tc, alts)
+		return atom{kind: atomGroup, group: g}
+	})
+
+	// atoms: literals first and most often, groups last.
+	dot := hegel.Just(atom{kind: atomDot})
+	var atoms hegel.Generator[atom]
+	switch d {
+	case posixDialect:
+		atoms = weighted(
+			choice[atom]{4, literalAtoms},
+			choice[atom]{1, dot},
+			choice[atom]{2, classAtoms},
+			choice[atom]{1, namedAtoms(posixAnchors)},
+			choice[atom]{2, groups},
+		)
+	default:
+		unicode := choice[atom]{4, namedAtoms(unicodeClasses)}
+		if d == latinDialect {
+			unicode = choice[atom]{4, literalAtoms}
+		}
+		atoms = weighted(
+			choice[atom]{28, literalAtoms},
+			choice[atom]{6, dot},
+			choice[atom]{7, namedAtoms(perlEscapes)},
+			unicode,
+			choice[atom]{10, classAtoms},
+			choice[atom]{9, namedAtoms(assertions)},
+			choice[atom]{3, namedAtoms(flagSettings)},
+			choice[atom]{3, quoted},
+			choice[atom]{30, groups},
+		)
+	}
+
+	quantifiers := quants(d)
+	pieces := hegel.FlatMap(atoms, func(a atom) hegel.Generator[piece] {
+		return hegel.Map(maybe(a.quantPct(d), quantifiers), func(q quantifier) piece { return piece{atom: a, quant: q} })
+	})
+	cats := hegel.Map(hegel.Lists(pieces).MaxSize(4), func(ps []piece) cat { return ps })
+	// alts: one branch most of the time, else two or three, some of them empty.
+	branches := weighted(choice[cat]{12, hegel.Just(cat(nil))}, choice[cat]{88, cats})
+	alts = weighted(
+		choice[alt]{70, hegel.Map(cats, func(c cat) alt { return alt{c} })},
+		choice[alt]{30, hegel.Map(hegel.Lists(branches).MinSize(2).MaxSize(3), func(cs []cat) alt { return cs })},
+	)
+	// A pattern has at most maxPieces pieces in all: nested groups make the tail of the
+	// unbounded tree long, and a pattern much longer than the text matches little.
+	small := hegel.Filter(alts, func(a alt) bool { return a.size() <= maxPieces })
+	return hegel.Map(small, func(a alt) pat { return render(a, d) })
+}
+
+var (
+	patterns      = grammar(perlDialect)
+	latinPatterns = grammar(latinDialect)
+	posixPatterns = grammar(posixDialect)
+)
+
+// --------------------------------------------------------------------------- texts
+
+// textShape is a text over a pool: up to ten characters, a quarter of the time followed by a
+// repeat of a prefix of themselves, so that matches recur.
+type textShape struct {
+	base string
+	dup  int // -1: no repeat; otherwise the prefix repeated is base[:dup] in runes (modulo the length)
+}
+
+func (t textShape) String() string {
+	rs := []rune(t.base)
+	if t.dup >= 0 && len(rs) > 0 {
+		rs = append(rs, rs[:t.dup%(len(rs)+1)]...)
+	}
+	return string(rs)
+}
+
+// dups: no repeat three quarters of the time, else the prefix length repeated.
+var dups = weighted(choice[int]{75, hegel.Just(-1)}, choice[int]{25, hegel.Integers(0, 10)})
+
+// texts draws a text over the pool.
+func texts(pool []rune) hegel.Generator[string] {
+	base := hegel.Text().Alphabet(string(pool)).MaxSize(10)
+	shapes := hegel.Composite(func(tc hegel.TestCase) textShape {
+		return textShape{base: hegel.Draw(tc, base), dup: hegel.Draw(tc, dups)}
+	})
+	return hegel.Map(shapes, textShape.String)
+}
+
+// poolFor narrows the text pool for a pattern while a recorded bug stands: no character above
+// U+007F beside \B (go-re2/2), no newline beside a negated class under CompilePOSIX
+// (go-re2/3). The whole pool is used once the switch is off.
+func poolFor(p pat, pool []rune) []rune {
+	if Known.nonBoundaryInsideRune && p.nonBoundary {
+		pool = keep(pool, func(r rune) bool { return r < 0x80 })
+	}
+	if Known.posixClassNewline && p.posix && p.negatedClass {
+		pool = keep(pool, func(r rune) bool { return r != '\n' })
+	}
+	return pool
+}
+
+// patText is a pattern and a text drawn over the pool it may be run on.
+type patText struct {
+	p    pat
+	text string
+}
+
+func patTexts(patterns hegel.Generator[pat], pool []rune) hegel.Generator[patText] {
+	return hegel.FlatMap(patterns, func(p pat) hegel.Generator[patText] {
+		return hegel.Map(texts(poolFor(p, pool)), func(t string) patText { return patText{p: p, text: t} })
+	})
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c patText) GoString() string { return fmt.Sprintf("pattern %q text %q", c.p.src, c.text) }
+
+// --------------------------------------------------------------------------- templates
+
+// tmplPiece is one piece of a replacement template: literal text, $$ and $-references, some
+// of them to groups that do not exist or names that are not there, some malformed.
+type tmplKind int
+
+const (
+	tText      tmplKind = iota // written as is
+	tNum                       // $n, n up to one past the last group
+	tBraceNum                  // ${n}
+	tNumX                      // $nx: a name that is not a number
+	tName                      // $name
+	tBraceName                 // ${name}
+)
+
+type tmplPiece struct {
+	kind tmplKind
+	s    string // tText, tName, tBraceName
+	n    int    // tNum, tBraceNum, tNumX
+}
+
+func (t tmplPiece) String() string {
+	switch t.kind {
+	case tNum:
+		return fmt.Sprintf("$%d", t.n)
+	case tBraceNum:
+		return fmt.Sprintf("${%d}", t.n)
+	case tNumX:
+		return fmt.Sprintf("$%dx", t.n)
+	case tName:
+		return "$" + t.s
+	case tBraceName:
+		return "${" + t.s + "}"
+	}
+	return t.s
+}
+
+func textPieces(xs []string) hegel.Generator[tmplPiece] {
+	return hegel.Map(hegel.SampledFrom(xs), func(s string) tmplPiece { return tmplPiece{kind: tText, s: s} })
+}
+
+func numPieces(kind tmplKind, hi int) hegel.Generator[tmplPiece] {
+	return hegel.Map(hegel.Integers(0, hi), func(n int) tmplPiece { return tmplPiece{kind: kind, n: n} })
+}
+
+// templates draws a replacement template for a pattern with the number of groups: up to four
+// pieces, literal text first.
+func templates(groups int) hegel.Generator[string] {
+	names := hegel.SampledFrom(groupNames)
+	pieces := weighted(
+		choice[tmplPiece]{3, textPieces([]string{"x", "-", "<", ">", "é"})},
+		choice[tmplPiece]{1, hegel.Just(tmplPiece{kind: tText, s: "$$"})},
+		choice[tmplPiece]{2, numPieces(tNum, groups+1)},
+		choice[tmplPiece]{1, numPieces(tBraceNum, groups+1)},
+		choice[tmplPiece]{1, numPieces(tNumX, groups)},
+		choice[tmplPiece]{1, hegel.OneOf(
+			hegel.Map(names, func(s string) tmplPiece { return tmplPiece{kind: tName, s: s} }),
+			hegel.Map(names, func(s string) tmplPiece { return tmplPiece{kind: tBraceName, s: s} }),
+		)},
+		choice[tmplPiece]{1, textPieces([]string{"$", "${", "${1", "$ ", "${}", "$10", "${0}", "$01", "${nope}"})},
+		choice[tmplPiece]{2, textPieces([]string{"$0", "${0}x"})},
+	)
+	return hegel.Map(hegel.Lists(pieces).MaxSize(4), func(ps []tmplPiece) string {
+		var sb strings.Builder
+		for _, p := range ps {
+			sb.WriteString(p.String())
+		}
+		return sb.String()
+	})
+}
