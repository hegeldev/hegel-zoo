+// carbon/22: persian.FromStdTime uses the Julian calendar before 1582-10-15.
+func TestHegelPinPersianRoundTripBeforeGregorianReform(t *testing.T) {
+	c := carbon.Parse("1582-10-04", "UTC")
+	back := c.Persian().ToGregorian("UTC").Time
+	if back.Format("2006-01-02") != "1582-10-04" {
+		t.Errorf("1582-10-04 -> Persian %s -> %s", c.Persian().String(), back.Format("2006-01-02"))
+	}
+	c = carbon.Parse("1000-01-01", "UTC")
+	if got := c.Persian().String(); got != "0378-10-11" {
+		t.Errorf("Persian of 1000-01-01 = %s, want 0378-10-11 (2820-year cycle on the proleptic Gregorian date)", got)
+	}
