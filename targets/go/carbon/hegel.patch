+// carbon/19: Persian years 1..473 are shifted.
+func TestHegelPinPersianEpochIs622(t *testing.T) {
+	if got := carbon.CreateFromPersian(1, 1, 1).ToDateString(); got != "0622-03-22" {
+		t.Errorf("1 Farvardin 1 = %s, want 0622-03-22", got)
+	}
+	if p := carbon.Parse("1094-06-01", "UTC").Persian(); !p.IsValid() {
+		t.Errorf("Persian of 1094-06-01 is invalid")
+	}
+	a := carbon.CreateFromPersian(473, 1, 1)
+	b := carbon.CreateFromPersian(474, 1, 1)
