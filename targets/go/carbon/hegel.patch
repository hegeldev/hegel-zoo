+// outputWeights: the 49 entries evenly (2.04 nominal each; the engine's
+// weighted choice over a long table lumps differently every run: these
+// weights, damped over six runs of 3000, realise 0.3 to 6.6 per entry in a
+// run, every entry drawn, the mean over the runs 1.2 to 2.9). The timestamp
+// entries (carbon/10) and ToRfc7231String (carbon/8: its abbreviation is the
+// zone's in UTC too, "UTC" where RFC 7231 wants "GMT", so no moment is past
+// its shape) have weight zero under HEGEL_NO_KNOWN=1.
+var outputWeights = func() []int {
+	w := []int{
+		1, 1, 2, 2, 4, 4, 7, 9, 4, 9,
+		6, 8, 9, 6, 9, 13, 9, 11, 8, 7,
+		4, 13, 11, 10, 10, 12, 15, 11, 10, 11,
+		10, 9, 9, 9, 12, 13, 10, 14, 8, 11,
+		15, 13, 17, 16, 17, 19, 19, 17, 10,
+	}
+	for i, o := range outputs {
+		if o.timestamp || o.name == "ToRfc7231String" {
+			w[i] = hzUnless(hzNoKnown, w[i])
+		}
+	}
+	return w
+}()
+
+var outputList = weightedOver(outputWeights, outputs...)
+
+// tzArg is the optional timezone argument of an output call: none, a good
+// zone (the output is in that zone; the receiver is untouched), or a bad name
+// (the output is empty; the receiver is untouched). The arguments are the
+// shape of carbon/14 and are not drawn under HEGEL_NO_KNOWN=1.
+type tzArg struct {
+	kind string // "", "good", "bad"
+	name string
+}
+
+func (a tzArg) String() string {
+	if a.kind == "" {
+		return ""
+	}
+	return strconv.Quote(a.name)
+}
+
+var tzArgs = hzWeighted(
+	hzW(70, via("tz none", hegel.Just(tzArg{}))), // 70 nominal: weight 70 realises 69.3
+	hzW(hzUnless(hzNoKnown, 33), via("tz good", hegel.Map(zoneList, func(z string) tzArg { return tzArg{kind: "good", name: z} }))),                    // 20 nominal: weight 33 realises 19.1 to 21.4
+	hzW(hzUnless(hzNoKnown, 22), via("tz bad", hegel.Map(hzSampled("Nowhere/City", ""), func(z string) tzArg { return tzArg{kind: "bad", name: z} }))), // 10 nominal: weight 22 realises 10.7 (15 and 18 realised 7.8 to 8.3)
+)
+
+// outputCase is a moment, an output and a timezone argument.
+type outputCase struct {
+	m  moment
+	o  output
+	tz tagged[tzArg]
+}
+
+func (c outputCase) GoString() string { return fmt.Sprintf("%#v %s(%s)", c.m, c.o.name, c.tz.v) }
+
+// utcMoments: the moments re-read in UTC (the same instants; the region past
+// the shape of carbon/8 for the outputs with a UTC marker).
+var utcMoments = hegel.Map(moments, func(m moment) moment {
+	return moment{zone: "UTC", t: m.t.In(time.UTC), drawn: m.drawn}
+})
+
+// outputCases: an output, a moment (in UTC under HEGEL_NO_KNOWN=1 for the
+// outputs with a UTC marker, where the local wall clock is the UTC one) and a
+// timezone argument.
+var outputCases = hegel.FlatMap(outputList, func(o output) hegel.Generator[outputCase] {
+	ms := moments
+	if hzNoKnown && o.literalZ {
+		ms = utcMoments
+	}
+	return hegel.Composite(func(tc hegel.TestCase) outputCase {
+		return outputCase{m: hegel.Draw(tc, ms), o: o, tz: hegel.Draw(tc, tzArgs)}
+	})
+})
+
+// viewed is the time an output call prints and the zone it is parsed back in:
+// the moment's, or the argument's zone.
+func (c outputCase) viewed() (time.Time, string) {
+	if c.tz.v.kind == "good" {
+		return c.m.t.In(zones[c.tz.v.name]), c.tz.v.name
+	}
+	return c.m.t, c.m.zone
+}
+
+// outputLimit names the Go time limit a case meets, or "": a two-digit year
+// outside 1969-2068, an abbreviation-only zone that is not alphabetic, a
+// sub-minute (LMT) offset, a nanosecond timestamp outside 1700-2200. The
+// parse-back checks are omitted (counted by name); the output itself is
+// still checked.
+func outputLimit(c outputCase) string {
+	tm, _ := c.viewed()
+	_, off := tm.Zone()
+	switch {
+	case c.o.twoDigitY && (tm.Year() < 1969 || tm.Year() > 2068):
+		return "two-digit-year-out-of-range"
+	case c.o.abbrev && !alphaAbbrev(tm):
+		return "abbreviation-not-alphabetic"
+	case off%60 != 0:
+		return "sub-minute-offset"
+	case c.o.layout == carbon.TimestampNanoLayout && (tm.Year() < 1700 || tm.Year() > 2200):
+		return "nano-timestamp-out-of-range"
+	}
+	return ""
+}
+
+// utcMarked is the documented text of an output with a UTC marker: the UTC
+// wall clock in the layout, and "GMT" for RFC 7231 (whose layout has the MST
+// token).
+func utcMarked(o output, tm time.Time) string {
+	if o.name == "ToRfc7231String" {
+		return tm.UTC().Format("Mon, 02 Jan 2006 15:04:05") + " GMT"
+	}
+	return tm.UTC().Format(o.layout)
+}
+
+// timestampText is the text of a timestamp layout.
+func timestampText(layout string, tm time.Time) string {
+	switch layout {
+	case carbon.TimestampMilliLayout:
+		return strconv.FormatInt(tm.UnixMilli(), 10)
+	case carbon.TimestampMicroLayout:
+		return strconv.FormatInt(tm.UnixMicro(), 10)
+	case carbon.TimestampNanoLayout:
+		return strconv.FormatInt(tm.UnixNano(), 10)
+	}
+	return strconv.FormatInt(tm.Unix(), 10)
+}
+
+// outputWant is the instant an output reads back to: truncated to the
+// precision, the start of the day for a date, the clock on 0000-01-01 for a
+// time alone.
+func outputWant(o output, tm time.Time) time.Time {
+	switch {
+	case o.precision == 86400e9:
+		return startOfDay(tm)
+	case o.timeOnly:
+		t := truncTo(tm, o.precision)
+		return time.Date(0, time.January, 1, t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), tm.Location())
+	}
+	return truncTo(tm, o.precision)
+}
+
+// readForm prints a parsed output: the instant and the zone the result reports.
+func readForm(t time.Time, zone string) string { return stampInstant(t) + " in " + zone }
+
+// outputsExpected: the output is the time in its documented layout (in the
+// argument's zone when given; empty for a bad zone), the receiver untouched;
+// Parse (unless the layout is not a default one) and ParseByLayout read it
+// back to the instant at the precision in the zone - for an output with a
+// UTC marker the documented text is the UTC wall clock with the marker, and
+// a Zulu or GMT text is the UTC instant whatever zone the parser is given.
+// Under carbon/8 the outputs with a UTC marker print the local wall clock in
+// the layout (outputer.go:480, 535-568, 700: c.StdTime().Format(layout)),
+// and the marker is a literal of the layout in parsing as in printing: the
+// replica reads that text back as the library does, ParseByLayout by Go's
+// parse of it in the zone (parser.go:57), which for the Zulu and HTTP texts
+// is the local wall clock read in the zone - the original instant, except
+// in the first of a repeated hour, where Go's Date picks the other offset -
+// and for RFC 7231's local abbreviation (the zone's own, "UTC" in UTC) the
+// original instant too; Parse reads the local clock as UTC (the default
+// RFC 3339 and RFC 1123 layouts take the Z and the GMT as the zone). Under
+// carbon/10 ParseByLayout of a timestamp layout is an error (parser.go:57
+// with "unix"). Under carbon/14 the receiver's zone is the argument's, or its
+// state an error for a bad name (outputer.go:20 and every output: c.loc,
+// c.Error = parseTimezone(timezone...)).
+func outputsExpected(c outputCase, k known) checks {
+	o := c.o
+	tm, zone := c.viewed()
+	loc := tm.Location()
+	out := checks{}
+	out["receiver"] = stampTime(c.m.t)
+	if k[kOutputZoneMovesReceiver] {
+		switch c.tz.v.kind {
+		case "good":
+			out["receiver"] = stampTime(tm)
+		case "bad":
+			out["receiver"] = "error"
+		}
+	}
+	if c.tz.v.kind == "bad" {
+		out[o.name] = ""
+		return out
+	}
+	var s string
+	switch {
+	case o.timestamp:
+		s = timestampText(o.layout, tm)
+	case o.literalZ && k[kUtcMarkerOnLocalTime]:
+		s = tm.Format(o.layout)
+	case o.literalZ:
+		s = utcMarked(o, tm)
+	default:
+		s = tm.Format(o.layout)
+	}
+	out[o.name] = s
+	if outputLimit(c) != "" {
+		return out
+	}
+	want := outputWant(o, tm)
+	parse, byLayout := readForm(want, zone), readForm(want, zone)
+	if o.literalZ && k[kUtcMarkerOnLocalTime] {
+		// The library's chain: its text (the local wall clock with the
+		// marker) read back in the zone by Go (parser.go:57).
+		byLayout = "error"
+		if back, err := time.ParseInLocation(o.layout, s, loc); err == nil {
+			byLayout = readForm(back, zone)
+		}
+		if o.literalMarker {
+			parse = readForm(time.Date(want.Year(), want.Month(), want.Day(), want.Hour(), want.Minute(), want.Second(), want.Nanosecond(), time.UTC), zone)
+		}
+	}
+	if o.timestamp && k[kUnixLayoutsUnreadable] {
+		byLayout = "error"
+	}
+	if !o.notDefault {
+		out["Parse"] = parse
+	}
+	out["ParseByLayout"] = byLayout
+	return out
+}
+
+func outputsActual(c outputCase) checks {
+	o := c.o
+	_, zone := c.viewed()
+	cb := carbonOf(c.m)
+	var s string
+	if c.tz.v.kind == "" {
+		s = o.out(cb)
+	} else {
+		s = o.out(cb, c.tz.v.name)
+	}
+	out := checks{}
+	out[o.name] = s
+	out["receiver"] = stamp(cb)
+	if c.tz.v.kind == "bad" || outputLimit(c) != "" {
+		return out
+	}
+	read := func(back *carbon.Carbon) string {
+		if back == nil {
+			return "<nil>"
+		}
+		if back.HasError() {
+			return "error"
+		}
+		return readForm(back.StdTime(), back.Timezone())
+	}
+	if !o.notDefault {
+		out["Parse"] = read(carbon.Parse(s, zone))
+	}
+	out["ParseByLayout"] = read(carbon.ParseByLayout(s, o.layout, zone))
+	return out
+}
+
+func judgeOutputs(j *hzCaseJudge, c outputCase) {
+	tallyDrawn(append(c.m.drawn, c.tz.via, "output "+c.o.name)...)
+	if limit := outputLimit(c); limit != "" {
+		hzTally("limit " + limit)
+	}
+	judgeBy(j, c, outputsExpected, outputsActual)
+}
+
+func TestHegelOutputStringsParseBack(t *testing.T) {
+	judged(t, outputCases, judgeOutputs)
+}
diff --git a/hegel_idioms_test.go b/hegel_idioms_test.go
new file mode 100644
index 0000000..c83d677
--- /dev/null
+++ b/hegel_idioms_test.go
@@ -0,0 +1,184 @@
+package carbon_test
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra and go/cascadia harness (hegel_idioms_test.go there; go/bubbles' internal/zootest/gen.go
+// before it) with the hz prefix: hegel-go has no weighted choice, biased coin, tuple or
+// counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the first alternative (excelize measured the first of a 2:18:10
+// choice drawn 40% of the time when another draw precedes or follows it, 7% alone), so the
+// rates are what the collector (HEGEL_COLLECT=1) measures; weightedOver and evenInts are the
+// tuned forms of a table and a range (hegel_moments_test.go explains the tuning).
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
diff --git a/hegel_models_test.go b/hegel_models_test.go
new file mode 100644
index 0000000..8ba691c
--- /dev/null
+++ b/hegel_models_test.go
@@ -0,0 +1,191 @@
+package carbon_test
+
+// The zones and the models every property family shares: the IANA zones
+// the generators draw from, the month lengths, the printers of times and
+// Carbons, the NoOverflow and exact-addition models, the day-of-week and
+// week models, the seasons and the zodiac, the English names.
+
+import (
+	"fmt"
+	"math"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+)
+
+// zoneNames are the IANA zones the properties draw from: whole-hour offsets,
+// half- and quarter-hour offsets, southern-hemisphere DST, a zone without an
+// alphabetic abbreviation (Sao Paulo prints "-03"), and UTC.
+var zoneNames = []string{
+	"UTC", "Asia/Shanghai", "America/New_York", "Europe/London", "Australia/Sydney",
+	"Asia/Kolkata", "America/St_Johns", "Pacific/Chatham", "Europe/Berlin",
+	"America/Sao_Paulo", "Asia/Tokyo", "America/Los_Angeles", "Asia/Kathmandu",
+}
+
+var zones = func() map[string]*time.Location {
+	m := map[string]*time.Location{}
+	for _, name := range zoneNames {
+		loc, err := time.LoadLocation(name)
+		if err != nil {
+			panic(fmt.Sprintf("LoadLocation(%s): %v", name, err))
+		}
+		m[name] = loc
+	}
+	return m
+}()
+
+var weekdays = []time.Weekday{time.Sunday, time.Monday, time.Tuesday, time.Wednesday, time.Thursday, time.Friday, time.Saturday}
+
+func daysIn(year int, month time.Month) int {
+	return time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC).Day()
+}
+
+func showTime(t time.Time) string { return t.Format("2006-01-02 15:04:05.999999999 -07:00 MST") }
+
+func showCarbon(c *carbon.Carbon) string {
+	if c == nil {
+		return "<nil>"
+	}
+	if c.HasError() {
+		return "<error: " + c.Error.Error() + ">"
+	}
+	if c.IsEmpty() {
+		return "<empty>"
+	}
+	return showTime(c.StdTime()) + " in " + c.Timezone()
+}
+
+// sameInstant compares a Carbon with a time.Time (instant and location).
+func sameInstant(c *carbon.Carbon, want time.Time) bool {
+	return c != nil && !c.HasError() && c.StdTime().Equal(want)
+}
+
+// sameWallClock compares a Carbon with a time.Time field by field, in the
+// time's location.
+func sameWallClock(c *carbon.Carbon, want time.Time) bool {
+	if c == nil || c.HasError() {
+		return false
+	}
+	got := c.StdTime().In(want.Location())
+	return got.Equal(want) && got.Format(time.RFC3339Nano) == want.Format(time.RFC3339Nano)
+}
+
+// ---------------------------------------------------------------------------
+// Models.
+
+// modelAddMonthsNoOverflow adds months, clamping the day to the target
+// month's length ("without overflowing month").
+func modelAddMonthsNoOverflow(t time.Time, months int) time.Time {
+	y, m, d := t.Date()
+	h, mi, s := t.Clock()
+	first := time.Date(y, m+time.Month(months), 1, 0, 0, 0, 0, time.UTC)
+	last := daysIn(first.Year(), first.Month())
+	if d > last {
+		d = last
+	}
+	return time.Date(first.Year(), first.Month(), d, h, mi, s, t.Nanosecond(), t.Location())
+}
+
+// modelAddSeconds adds k seconds exactly (no Duration in between).
+func modelAddSeconds(t time.Time, k int64) time.Time {
+	return time.Unix(t.Unix()+k, int64(t.Nanosecond())).In(t.Location())
+}
+
+// modelAddNanos adds k units of `unit` nanoseconds each, exactly.
+func modelAddNanos(t time.Time, k int64, unit int64) time.Time {
+	secs := k / (1e9 / unit)
+	rem := k % (1e9 / unit)
+	return time.Unix(t.Unix()+secs, int64(t.Nanosecond())+rem*unit).In(t.Location())
+}
+
+// overflowsDuration reports whether k*unit does not fit a time.Duration.
+func overflowsDuration(k int64, unit time.Duration) bool {
+	if k == 0 {
+		return false
+	}
+	limit := int64(math.MaxInt64) / int64(unit)
+	return k > limit || k < -limit
+}
+
+func startOfDay(t time.Time) time.Time {
+	y, m, d := t.Date()
+	return time.Date(y, m, d, 0, 0, 0, 0, t.Location())
+}
+
+func endOfDay(t time.Time) time.Time {
+	y, m, d := t.Date()
+	return time.Date(y, m, d, 23, 59, 59, 999999999, t.Location())
+}
+
+// modelDayOfWeek is the 1-based day of the week counted from weekStartsAt.
+func modelDayOfWeek(t time.Time, ws time.Weekday) int {
+	return (int(t.Weekday())-int(ws)+7)%7 + 1
+}
+
+func modelStartOfWeek(t time.Time, ws time.Weekday) time.Time {
+	back := (int(t.Weekday()) - int(ws) + 7) % 7
+	y, m, d := t.Date()
+	return time.Date(y, m, d-back, 0, 0, 0, 0, t.Location())
+}
+
+func modelEndOfWeek(t time.Time, ws time.Weekday) time.Time {
+	we := time.Weekday((int(ws) + 6) % 7)
+	fwd := (int(we) - int(t.Weekday()) + 7) % 7
+	y, m, d := t.Date()
+	return time.Date(y, m, d+fwd, 23, 59, 59, 999999999, t.Location())
+}
+
+// modelWeekOfMonth: week 1 holds the 1st; weeks start at ws.
+func modelWeekOfMonth(t time.Time, ws time.Weekday) int {
+	first := time.Date(t.Year(), t.Month(), 1, 0, 0, 0, 0, t.Location())
+	days := t.Day() + modelDayOfWeek(first, ws) - 1
+	return (days + 6) / 7
+}
+
+func modelQuarter(m time.Month) int { return (int(m)-1)/3 + 1 }
+
+// modelIsLongYear: an ISO year has 53 weeks iff December 28 is in week 53.
+func modelIsLongYear(year int) bool {
+	_, w := time.Date(year, time.December, 28, 0, 0, 0, 0, time.UTC).ISOWeek()
+	return w == 53
+}
+
+// seasons by the meteorological division: spring March-May, summer
+// June-August, autumn September-November, winter December-February.
+func modelSeason(m time.Month) string {
+	switch m {
+	case time.March, time.April, time.May:
+		return "Spring"
+	case time.June, time.July, time.August:
+		return "Summer"
+	case time.September, time.October, time.November:
+		return "Autumn"
+	}
+	return "Winter"
+}
+
+// the tropical zodiac by the dates the library documents (Aries from
+// March 21 ... Pisces to March 20).
+var zodiac = []struct {
+	name         string
+	fromM, fromD int
+	toM, toD     int
+}{
+	{"Aries", 3, 21, 4, 19}, {"Taurus", 4, 20, 5, 20}, {"Gemini", 5, 21, 6, 21}, {"Cancer", 6, 22, 7, 22},
+	{"Leo", 7, 23, 8, 22}, {"Virgo", 8, 23, 9, 22}, {"Libra", 9, 23, 10, 23}, {"Scorpio", 10, 24, 11, 22},
+	{"Sagittarius", 11, 23, 12, 21}, {"Capricorn", 12, 22, 1, 19}, {"Aquarius", 1, 20, 2, 18}, {"Pisces", 2, 19, 3, 20},
+}
+
+func modelConstellation(m time.Month, d int) string {
+	for _, z := range zodiac {
+		if (int(m) == z.fromM && d >= z.fromD) || (int(m) == z.toM && d <= z.toD) {
+			return z.name
+		}
+	}
+	return ""
+}
+
+var englishMonths = []string{"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
+var englishDays = []string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
+
+func isLeap(y int) bool { return y%400 == 0 || (y%4 == 0 && y%100 != 0) }
diff --git a/hegel_moments_test.go b/hegel_moments_test.go
new file mode 100644
index 0000000..f3d2af4
--- /dev/null
+++ b/hegel_moments_test.go
@@ -0,0 +1,367 @@
+package carbon_test
+
+// The records the core properties draw (a moment is a wall-clock time in one
+// of thirteen zones; the cases are moments with week settings, amounts,
+// duration strings, pairs and triples of moments) and the package-level
+// generators they are drawn from. The population is the one the original
+// per-call generators (now gone) drew: the same zones, year mix, day and
+// clock specials and nanosecond mix; the formatting and
+// calendar properties draw the same moments (the calendar ones through
+// momentsIn with their own zone and year populations).
+//
+// The weights are nominal and the figure beside each is what the probe
+// measured over 3000 cases of the case generator with a fixed seed (the
+// engine favours the first alternative of a weighted choice drawn inside a
+// larger case, and index 1 of a SampledFrom table): the comment "N nominal:
+// weight w realises r" records the tuning. Under HEGEL_NO_KNOWN=1 the
+// alternatives that are the shape of a recorded bug have weight zero or are
+// replaced by the region past them (hzUnless, hzShaped); the relations that
+// are a shape are filtered out by the classifiers (hegel_core_test.go).
+//
+// Every alternative tags the value with its name (tagged, via) so that the
+// judge can count the realised rates ("drawn <name>" in the collector).
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// tagged is a drawn value with the name of the alternative it came from.
+type tagged[T any] struct {
+	v   T
+	via string
+}
+
+// via tags the values of g with name.
+func via[T any](name string, g hegel.Generator[T]) hegel.Generator[tagged[T]] {
+	return hegel.Map(g, func(v T) tagged[T] { return tagged[T]{v: v, via: name} })
+}
+
+// tallyDrawn counts the alternatives a case was drawn from (the realised rates).
+func tallyDrawn(tags ...string) {
+	for _, tag := range tags {
+		if tag != "" {
+			hzTally("drawn " + tag)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Moments.
+
+// moment is a wall-clock time in a zone (t's location is zones[zone]).
+type moment struct {
+	zone  string
+	t     time.Time
+	drawn []string
+}
+
+func (m moment) GoString() string { return showTime(m.t) + " in " + m.zone }
+
+// carbonOf is the Carbon made from the moment (CreateFromStdTime keeps the location).
+func carbonOf(m moment) *carbon.Carbon { return carbon.CreateFromStdTime(m.t) }
+
+// momentAt is the moment of t in m's zone (t need not be in that location yet).
+func momentAt(m moment, t time.Time, drawn ...string) moment {
+	return moment{zone: m.zone, t: t.In(m.t.Location()), drawn: drawn}
+}
+
+// zoneList: the thirteen zones evenly (13 at 7.7 nominal: the tuned weights realise
+// 6.2 to 9.4, UTC 7.2; UTC first is the shrink target).
+var zoneList = weightedOver([]int{4, 4, 7, 10, 8, 11, 10, 9, 13, 12, 12, 10, 11}, zoneNames...)
+
+// years favours the modern range but reaches the library's whole 1..9999 (the
+// order of genYear: the first alternative shrinks to year 1, the zero time).
+var years = hzWeighted(
+	hzW(5, via("year 1-9999", hzInts(1, 9999))),                                                                     // 10 nominal: weight 5 realises 11.0
+	hzW(13, via("year 1800-2200", hzInts(1800, 2200))),                                                              // 15 nominal: weight 13 realises 17.0
+	hzW(6, via("year special", hzSampled(1, 100, 400, 1000, 1582, 1900, 1969, 1970, 1999, 2000, 2038, 2100, 9999))), // 5 nominal: weight 6 realises 5.3
+	hzW(85, via("year 1970-2050", hzInts(1970, 2050))),                                                              // 70 nominal: weight 85 realises 66.7
+)
+
+// months: uniform over the twelve (12 at 8.3 nominal: the tuned weights realise 6.8 to 10.8).
+var months = evenInts(1, 3, 5, 8, 11, 8, 11, 12, 10, 11, 10, 14, 10)
+
+// daysOf: a day of the month, favouring the ends of months (where the overflow rules live).
+func daysOf(y int, m time.Month) hegel.Generator[tagged[int]] {
+	last := daysIn(y, m)
+	return hzWeighted(
+		hzW(69, via("day uniform", hzInts(1, last))),                // 75 nominal: weight 69 realises 76.6
+		hzW(33, via("day special", hzSampled(1, 28, last-1, last))), // 25 nominal: weight 33 realises 23.4
+	)
+}
+
+// clock is a time of day.
+type clock struct{ h, mi, s int }
+
+func clockOf(v []int) clock { return clock{h: v[0], mi: v[1], s: v[2]} }
+
+// clocks: uniform, or one of the special readings.
+var clocks = hzWeighted(
+	hzW(81, via("clock uniform", hegel.Map(hzTuple(hzInts(0, 23), hzInts(0, 59), hzInts(0, 59)), clockOf))),              // 85 nominal: weight 81 realises 86.9
+	hzW(20, via("clock special", hegel.Map(hzTuple(hzSampled(0, 12, 23), hzSampled(0, 59), hzSampled(0, 59)), clockOf))), // 15 nominal: weight 20 realises 13.1
+)
+
+func timesInt(k int) func(int) int { return func(v int) int { return v * k } }
+
+// nanos: a nanosecond-of-second, often zero, often whole milliseconds or
+// microseconds, sometimes anything (genNanos' six-way die).
+var nanos = hzWeighted(
+	hzW(14, via("nanos zero", hegel.Just(0))),                                                 // 33 nominal: weight 14 realises 35.2
+	hzW(12, via("nanos millis", hegel.Map(hzInts(0, 999), timesInt(1e6)))),                    // 17 nominal: weight 12 realises 15.8
+	hzW(11, via("nanos micros", hegel.Map(hzInts(0, 999999), timesInt(1e3)))),                 // 17 nominal: weight 11 realises 16.1
+	hzW(14, via("nanos special", hzSampled(1, 999, 999999, 999999999, 500000000, 100000000))), // 17 nominal: weight 14 realises 15.3
+	hzW(14, via("nanos any", hzInts(0, 999999999))),                                           // 17 nominal: weight 14 realises 17.6
+)
+
+// momentsIn: a moment in one of the zones, in one of the years, with a
+// nanosecond part unless whole (the calendar properties draw their own zone
+// and year populations: the lunar table's years, UTC and the five-digit
+// Julian-day years under HEGEL_NO_KNOWN=1).
+func momentsIn(zoneGen hegel.Generator[string], yearGen hegel.Generator[tagged[int]], whole bool) hegel.Generator[moment] {
+	return hegel.Composite(func(tc hegel.TestCase) moment {
+		zone := hegel.Draw(tc, zoneGen)
+		y := hegel.Draw(tc, yearGen)
+		m := time.Month(hegel.Draw(tc, months))
+		d := hegel.Draw(tc, daysOf(y.v, m))
+		c := hegel.Draw(tc, clocks)
+		ns := tagged[int]{v: 0, via: "nanos whole"}
+		if !whole {
+			ns = hegel.Draw(tc, nanos)
+		}
+		return moment{
+			zone:  zone,
+			t:     time.Date(y.v, m, d.v, c.v.h, c.v.mi, c.v.s, ns.v, zones[zone]),
+			drawn: []string{y.via, d.via, c.via, ns.via},
+		}
+	})
+}
+
+// momentsOf: a moment of the thirteen zones and the year mix.
+func momentsOf(whole bool) hegel.Generator[moment] { return momentsIn(zoneList, years, whole) }
+
+// moments: any moment; wholeMoments: one on a whole second (the region past
+// the shape of carbon/2); exactMoments: the one the differences in small
+// units draw (whole under HEGEL_NO_KNOWN=1).
+var (
+	moments      = momentsOf(false)
+	wholeMoments = momentsOf(true)
+	exactMoments = hzShaped(moments, wholeMoments)
+)
+
+// nearOf: a moment within a few days of m in its zone, with its own
+// nanosecond part unless whole (genNear).
+func nearOf(m moment, whole bool) hegel.Generator[moment] {
+	secs := hzWeighted(
+		hzW(80, via("near uniform", hzInts(-4*86400, 4*86400))),                                                   // 80 nominal: realises 83.6
+		hzW(20, via("near special", hzSampled(0, 1, -1, 86400, -86400, 3600, -3600, 60, -60, 7*86400, -7*86400))), // 20 nominal: realises 16.4
+	)
+	return hegel.Composite(func(tc hegel.TestCase) moment {
+		s := hegel.Draw(tc, secs)
+		ns := tagged[int]{v: 0, via: "nanos whole"}
+		if !whole {
+			ns = hegel.Draw(tc, nanos)
+		}
+		return momentAt(m, time.Unix(m.t.Unix()+int64(s.v), int64(ns.v)), s.via, ns.via)
+	})
+}
+
+// secondsFrom: m moved by lo..hi whole seconds (the nanosecond part kept).
+func secondsFrom(m moment, lo, hi int) hegel.Generator[moment] {
+	return hegel.Map(hzInts(lo, hi), func(s int) moment {
+		return momentAt(m, modelAddSeconds(m.t, int64(s)), "seconds uniform")
+	})
+}
+
+// datesFrom: m moved by whole years, months and days and then by seconds.
+func datesFrom(m moment, ys, ms, ds, secs int) hegel.Generator[moment] {
+	return hegel.Map(hzTuple(hzInts(-ys, ys), hzInts(-ms, ms), hzInts(-ds, ds), hzInts(-secs, secs)), func(v []int) moment {
+		return momentAt(m, m.t.AddDate(v[0], v[1], v[2]).Add(time.Duration(v[3])*time.Second), "dates shifted")
+	})
+}
+
+// nudgedBy: m moved by one of the nanosecond amounts.
+func nudgedBy(m moment, amounts []int64) hegel.Generator[moment] {
+	return hegel.Map(hegel.SampledFrom(amounts), func(d int64) moment {
+		return momentAt(m, m.t.Add(time.Duration(d)), "nudged")
+	})
+}
+
+// inZone: the same instant read in a drawn zone.
+func inZone(m moment) hegel.Generator[moment] {
+	return hegel.Map(zoneList, func(zone string) moment {
+		return moment{zone: zone, t: m.t.In(zones[zone]), drawn: []string{"zone changed"}}
+	})
+}
+
+// independent: a moment of its own in the zone of m.
+func independent(m moment) hegel.Generator[moment] {
+	return hegel.Map(moments, func(o moment) moment {
+		return moment{zone: m.zone, t: o.t.In(m.t.Location()), drawn: append([]string{"independent"}, o.drawn...)}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Week settings, amounts, duration strings.
+
+// weekStarts: a week start, evenly (7 at 14.3 nominal: the tuned weights realise 11.9 to
+// 16.1; Sunday first).
+var weekStarts = weightedOver([]int{7, 12, 16, 16, 15, 22, 20}, weekdays...)
+
+// weekends: each day a weekend day 30% of the time (a coin of 38 realises 29 to 33: the
+// engine favours the low side of the die).
+var weekends = hegel.Map(hzTuple(hzCoin(38), hzCoin(38), hzCoin(38), hzCoin(38), hzCoin(38), hzCoin(38), hzCoin(38)), func(on []bool) []time.Weekday {
+	var days []time.Weekday
+	for i, wd := range weekdays {
+		if on[i] {
+			days = append(days, wd)
+		}
+	}
+	return days
+})
+
+// calendarAmounts: a count of years, months, weeks or days (genCalendar's k).
+var calendarAmounts = hzWeighted(
+	hzW(73, via("amount uniform", hzInts(-600, 600))),                                 // 80 nominal: weight 73 realises 77.7
+	hzW(33, via("amount special", hzSampled(0, 1, -1, 12, -12, 100, 4, 3000, -3000))), // 20 nominal: weight 33 realises 22.3
+)
+
+// clockUnit is one of the clock travellers' units.
+type clockUnit struct {
+	name  string
+	title string // the singular form's name in the method names (AddHour, AddMilli...)
+	d     time.Duration
+}
+
+var clockUnits = []clockUnit{
+	{"hour", "Hour", time.Hour}, {"minute", "Minute", time.Minute}, {"second", "Second", time.Second},
+	{"milli", "Milli", time.Millisecond}, {"micro", "Micro", time.Microsecond}, {"nano", "Nano", time.Nanosecond},
+}
+
+// clockUnitList: the six units evenly (6 at 16.7 nominal: the tuned weights realise 14.0 to 19.2).
+var clockUnitList = weightedOver([]int{5, 16, 21, 24, 31, 29}, clockUnits...)
+
+// amountSpecials and bigMultipliers: the special counts and the multipliers
+// of the large counts; the ones that overflow a time.Duration in the unit
+// (the shape of carbon/6) are dropped under HEGEL_NO_KNOWN=1 (withinDuration).
+var (
+	amountSpecials = []int64{0, 1, -1, 24, -24, 60, 3600, 86400, 1000, 1000000, 1000000000}
+	bigMultipliers = []int64{1000, 1000000, 300000000}
+)
+
+// withinDuration keeps the amounts k of the list with k*unit (times up to
+// span) inside a time.Duration.
+func withinDuration(list []int64, unit time.Duration, span int64) []int64 {
+	var kept []int64
+	for _, k := range list {
+		if !overflowsDuration(k*span, unit) {
+			kept = append(kept, k)
+		}
+	}
+	return kept
+}
+
+// clockAmountsOf: the count for a unit, up to about 9500 years: small, a
+// special, or large and sometimes multiplied (the multiplied counts beyond
+// the Duration range are the shape of carbon/6).
+func clockAmountsOf(u clockUnit) hegel.Generator[tagged[int64]] {
+	specials := hzShaped(amountSpecials, withinDuration(amountSpecials, u.d, 1))
+	multipliers := hzShaped(bigMultipliers, withinDuration(bigMultipliers, u.d, 1000000))
+	byMultiplier := hegel.Just(int64(1)) // no multiplier fits (hours under HEGEL_NO_KNOWN=1): weight zero below
+	if len(multipliers) > 0 {
+		byMultiplier = hegel.SampledFrom(multipliers)
+	}
+	multiplied := hzWeighted(
+		hzW(58, hegel.Just(int64(1))),
+		hzW(hzUnless(len(multipliers) == 0, 42), byMultiplier),
+	)
+	return hzWeighted(
+		hzW(11, via("amount small", hegel.Map(hzInts(-1000, 1000), func(k int) int64 { return int64(k) }))),                                                                                     // 25 nominal: weight 11 realises 23.8
+		hzW(33, via("amount special", hegel.SampledFrom(specials))),                                                                                                                             // 25 nominal: weight 33 realises 25.0
+		hzW(80, via("amount large", hegel.Map(hzTuple(hegel.Map(hzInts(-1000000, 1000000), func(k int) int64 { return int64(k) }), multiplied), func(v []int64) int64 { return v[0] * v[1] }))), // 50 nominal: weight 80 realises 51.2, multiplied 30% of them (weight 42 realises 32)
+	)
+}
+
+// setFields are the fields a setter case writes: in range, or (20%) out of
+// range, which time.Date normalises.
+type setFields struct {
+	y, m, d, h, mi, s, ms, us, ns int
+	drawn                         string
+}
+
+var setFieldsIn = hegel.Map(hzTuple(hzInts(1, 12), hzInts(1, 31), hzInts(0, 23), hzInts(0, 59), hzInts(0, 59)), func(v []int) setFields {
+	return setFields{m: v[0], d: v[1], h: v[2], mi: v[3], s: v[4], drawn: "fields in range"}
+})
+
+var setFieldsOut = hegel.Map(hzTuple(hzSampled(0, 13, 14, -1), hzSampled(0, 32, 40, -1), hzSampled(24, -1, 25), hzSampled(60, -1), hzSampled(60, -1, 61)), func(v []int) setFields {
+	return setFields{m: v[0], d: v[1], h: v[2], mi: v[3], s: v[4], drawn: "fields out of range"}
+})
+
+// setterFields: the year from years, the date and clock in range 80% of the
+// time, and the fractions uniform.
+var setterFields = hegel.Composite(func(tc hegel.TestCase) setFields {
+	y := hegel.Draw(tc, years)
+	f := hegel.Draw(tc, hzWeighted(hzW(72, setFieldsIn), hzW(38, setFieldsOut))) // 80/20 nominal: realises 79.9/20.1
+	f.y = y.v
+	f.ms, f.us, f.ns = hegel.Draw(tc, hzInts(0, 999)), hegel.Draw(tc, hzInts(0, 999999)), hegel.Draw(tc, hzInts(0, 999999999))
+	return f
+})
+
+// duration is a Go duration string and its value (ok false for an unparsable one).
+type duration struct {
+	s     string
+	d     time.Duration
+	ok    bool
+	drawn string
+}
+
+var durationUnits = []struct {
+	suffix string
+	d      time.Duration
+}{{"h", time.Hour}, {"m", time.Minute}, {"s", time.Second}, {"ms", time.Millisecond}, {"us", time.Microsecond}, {"ns", time.Nanosecond}}
+
+// durationPart: one "<count><unit>" part.
+var durationPart = hegel.Map(hzTuple(hzInts(0, 5000), hzInts(0, 5)), func(v []int) duration {
+	u := durationUnits[v[1]]
+	return duration{s: fmt.Sprintf("%d%s", v[0], u.suffix), d: time.Duration(v[0]) * u.d, ok: true}
+})
+
+// durationParts: one to three parts, negated 30% of the time (a coin of 46 realises 31).
+var durationParts = hegel.Map(hzTuple(hegel.Map(hzCounted(durationPart, 1, 3), func(parts []duration) duration {
+	var b strings.Builder
+	var total time.Duration
+	for _, p := range parts {
+		b.WriteString(p.s)
+		total += p.d
+	}
+	return duration{s: b.String(), d: total, ok: true, drawn: "duration parts"}
+}), hegel.Map(hzCoin(46), func(neg bool) duration { return duration{ok: neg} })), func(v []duration) duration {
+	d := v[0]
+	if v[1].ok {
+		d.s, d.d, d.drawn = "-"+d.s, -d.d, "duration parts negated"
+	}
+	return d
+})
+
+// durationFractions: the fractional spellings.
+var durationFractions = hegel.Map(hzSampled("1.5h", "0.25s", "2.5ms", "1h30m", "-0.5m"), func(s string) duration {
+	d, _ := time.ParseDuration(s)
+	return duration{s: s, d: d, ok: true, drawn: "duration fraction"}
+})
+
+// durationBad: the unparsable strings (the shape of carbon/7).
+var durationBad = hegel.Map(hzSampled("", "bogus", "1x", "h", "1.5", "--1h", "1h1"), func(s string) duration {
+	return duration{s: s, drawn: "duration bad"}
+})
+
+// durations: a bad string one time in ten, else parts, 15% of them replaced
+// by a fractional spelling (genDuration).
+var durations = hzWeighted(
+	hzW(hzUnless(hzNoKnown, 2), durationBad), // 10 nominal: weight 2 realises 10.7
+	hzW(95, durationParts),                   // 76.5 nominal: weight 95 realises 77.9
+	hzW(30, durationFractions),               // 13.5 nominal: weight 30 realises 11.4
+)
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..8899e16
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,466 @@
+package carbon_test
+
+// One deterministic pin per recorded bug (bugs.toml). Each asserts the
+// correct behaviour and fails while the bug exists; the properties draw the
+// bug's shape meanwhile and fail naming it (the switch of the known value
+// in hegel_test.go is the bug's replica, off by default).
+
+import (
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"github.com/dromara/carbon/v2/calendar/hebrew"
+	"github.com/dromara/carbon/v2/calendar/julian"
+	"github.com/dromara/carbon/v2/calendar/lunar"
+	"github.com/dromara/carbon/v2/calendar/persian"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panicked: %v", what, r)
+		}
+	}()
+	f()
+}
+
+// carbon/1: ToWeekString, ToShortWeekString and Format's D index the
+// Sunday-first names with DayOfWeek, which counts from weekStartsAt.
+func TestHegelPinSundayIsSundayWithSundayWeekStart(t *testing.T) {
+	sun := carbon.CreateFromDate(2024, 3, 10, "UTC").SetWeekStartsAt(carbon.Sunday) // a Sunday
+	if got := sun.ToWeekString(); got != "Sunday" {
+		t.Errorf("ToWeekString of Sunday 2024-03-10 with a Sunday week start = %q, want Sunday", got)
