+// carbon/18: 1403 is a leap year in the official Iranian calendar.
+func TestHegelPinPersian1404StartsOnMarch21(t *testing.T) {
+	if got := carbon.CreateFromPersian(1404, 1, 1).ToDateString(); got != "2025-03-21" {
+		t.Errorf("1 Farvardin 1404 = %s, want 2025-03-21", got)
+	}
+	if !persian.NewPersian(1403, 12, 30).IsValid() {
+		t.Errorf("30 Esfand 1403 is invalid; 1403 is a leap year")
+	}
+	if got := carbon.Parse("2025-03-21", "UTC").Persian().String(); got != "1404-01-01" {
+		t.Errorf("Persian of 2025-03-21 = %s, want 1404-01-01", got)
+	}
