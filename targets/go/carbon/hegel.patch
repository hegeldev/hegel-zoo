+// carbon/14: output methods with a timezone argument change the receiver.
+func TestHegelPinOutputWithTimezoneLeavesReceiver(t *testing.T) {
+	c := carbon.CreateFromDateTime(2024, 1, 1, 12, 0, 0, "UTC")
+	if got := c.ToDateTimeString("Asia/Tokyo"); got != "2024-01-01 21:00:00" {
+		t.Errorf("ToDateTimeString(Tokyo) = %q", got)
+	}
+	if c.Timezone() != "UTC" || c.ToDateTimeString() != "2024-01-01 12:00:00" {
+		t.Errorf("the receiver moved to %s: %s", c.Timezone(), c.ToDateTimeString())
+	}
+	_ = c.ToDateString("Nowhere/Land")
+	if c.HasError() || !c.IsValid() {
+		t.Errorf("the receiver was poisoned by a bad zone argument: %v", c.Error)
+	}
+	var z *carbon.Carbon
+	noPanic(t, "nil.ToDateTimeString(\"UTC\")", func() { _ = z.ToDateTimeString("UTC") })
+	noPanic(t, "nil.SetLayout(\"\")", func() { _ = z.SetLayout("") })
+}
