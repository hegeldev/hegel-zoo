+// carbon/12: Language.translate indexes slice[-1] for a "now" resource with a bar.
+func TestHegelPinTranslateOfNowResourceWithBar(t *testing.T) {
+	lang := carbon.NewLanguage().SetLocale("en").SetResources(map[string]string{"now": "just now|right now"})
+	a := carbon.CreateFromDate(2020, 8, 5, "UTC").SetLanguage(lang)
+	b := carbon.CreateFromDate(2020, 8, 5, "UTC")
+	noPanic(t, "DiffForHumans with a two-part \"now\" resource", func() {
+		if got := a.DiffForHumans(b); got != "just now" && got != "right now" {
+			t.Errorf("DiffForHumans = %q", got)
+		}
+	})
