+package carbon_test
+
+// The narrow properties of the core families: each draws the shape of one
+// recorded bug every run (the pure construction of the region, or the wide
+// generator filtered by the classifier where a construction cannot be pure),
+// shares the judge, the model and the library calls of its wide property
+// (hegel_core_test.go), and so fails naming the bug every run by default;
+// under HEGEL_NO_KNOWN=1 it draws the neighbouring region past the shape
+// (hzShaped) and passes. The collector's "shape carbon/N" and "filtered
+// carbon/N" counters measure the hit and rejection rates.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// regionOf is the cases of the region of the recorded bug id, by the
+// classifier: by default only the cases with that shape, under
+// HEGEL_NO_KNOWN=1 only the cases with none (the rejections are counted as
+// "filtered <id>").
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// ---------------------------------------------------------------------------
+// carbon/1: the week names follow the week start.
+
+// weekNameCases: a getter case whose week start is not Monday (the shape of
+// carbon/1 for every day of the week), or Monday under HEGEL_NO_KNOWN=1.
+var weekNameCases = hegel.Composite(func(tc hegel.TestCase) getterCase {
+	return getterCase{
+		m:       hegel.Draw(tc, moments),
+		ws:      hegel.Draw(tc, hzShaped(hzSampled(time.Sunday, time.Tuesday, time.Wednesday, time.Thursday, time.Friday, time.Saturday), hegel.Just(time.Monday))),
+		weekend: hegel.Draw(tc, weekends),
+	}
+})
+
+func TestHegelWeekNamesIgnoreTheWeekStart(t *testing.T) {
+	judged(t, weekNameCases, judgeGetters)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/2: the differences in seconds and the extrema keep the sub-second parts.
+
+// subSecondCase: a pair whose elapsed time is d seconds less a fraction (the
+// shape of carbon/2 for DiffInSeconds and its kin) and the extrema of a among
+// that end and the instant exactly d seconds the other way (the shape of
+// carbon/2 for Closest and Farthest, which tie by whole seconds).
+type subSecondCase struct {
+	pair pairCase
+	ext  extremaCase
+}
+
+func (c subSecondCase) GoString() string {
+	return fmt.Sprintf("%#v; others %#v and %#v", c.pair, c.ext.others[0], c.ext.others[1])
+}
+
+// nanosBelow and nanosAbove: a nanosecond part on the given side of n (n
+// itself when there is no room: the whole-second region under HEGEL_NO_KNOWN=1).
+func nanosBelow(n int) hegel.Generator[int] {
+	if n == 0 {
+		return hegel.Just(0)
+	}
+	return hzInts(0, n-1)
+}
+
+func nanosAbove(n int) hegel.Generator[int] {
+	if n >= 999999999 {
+		return hegel.Just(n)
+	}
+	return hzInts(n+1, 999999999)
+}
+
+// subSecondCases: a on a nanosecond part n1 (whole under HEGEL_NO_KNOWN=1), b
+// d whole seconds away with a nanosecond part short of n1 on the side that
+// makes the exact gap less than d seconds; the extrema of a among b and the
+// instant d seconds the other way.
+var subSecondCases = hegel.Composite(func(tc hegel.TestCase) subSecondCase {
+	whole := hegel.Draw(tc, wholeMoments)
+	n1 := hegel.Draw(tc, hzShaped(hzInts(1, 999999998), hegel.Just(0)))
+	a := momentAt(whole, time.Unix(whole.t.Unix(), int64(n1)), "sub-second a")
+	d := int64(hegel.Draw(tc, hzInts(1, 100000)))
+	n2 := hegel.Draw(tc, hzShaped(nanosBelow(n1), hegel.Just(0)))
+	if hegel.Draw(tc, hzCoin(50)) {
+		d = -d
+		n2 = hegel.Draw(tc, hzShaped(nanosAbove(n1), hegel.Just(0)))
+	}
+	b := momentAt(a, time.Unix(a.t.Unix()+d, int64(n2)), "short of d seconds")
+	back := momentAt(a, time.Unix(a.t.Unix()-d, int64(n1)), "exactly d seconds")
+	return subSecondCase{pair: pairCase{a: a, b: b}, ext: extremaCase{m: a, others: []moment{b, back}}}
+})
+
+func subSecondExpected(c subSecondCase, k known) checks {
+	out := checks{}
+	for name, v := range smallUnitsExpected(c.pair, k) {
+		out[name] = v
+	}
+	for name, v := range extremaExpected(c.ext, k) {
+		out[name] = v
+	}
+	return out
