+// ---------------------------------------------------------------------------
+// Differences.
+
+type pairCase struct {
+	a, b moment
+}
+
+func (c pairCase) GoString() string { return fmt.Sprintf("%#v -> %#v", c.a, c.b) }
+
+func (c pairCase) drawn() []string { return append(append([]string{}, c.a.drawn...), c.b.drawn...) }
+
+// pairsOf: a from first, b from second(a).
+func pairsOf(first hegel.Generator[moment], second func(moment) hegel.Generator[moment]) hegel.Generator[pairCase] {
+	return hegel.Composite(func(tc hegel.TestCase) pairCase {
+		a := hegel.Draw(tc, first)
+		return pairCase{a: a, b: hegel.Draw(tc, second(a))}
+	})
+}
+
+// order is the earlier and the later of two instants and the sign of b - a.
+func order(a, b time.Time) (s, e time.Time, sign int64) {
+	if b.Before(a) {
+		return b, a, -1
+	}
+	return a, b, 1
+}
+
+// wholeSteps is the largest k >= 0 with step(s, k) at or before e (s at or
+// before e), by doubling and bisection: the count of whole units from s to e.
+func wholeSteps(s, e time.Time, step func(time.Time, int) time.Time) int64 {
+	lo, hi := int64(0), int64(1)
+	for !step(s, int(hi)).After(e) {
+		hi *= 2
+	}
+	for lo+1 < hi {
+		mid := (lo + hi) / 2
+		if step(s, int(mid)).After(e) {
+			hi = mid
+		} else {
+			lo = mid
+		}
+	}
+	return lo
+}
+
+func addYears(t time.Time, k int) time.Time  { return t.AddDate(k, 0, 0) }
+func addMonths(t time.Time, k int) time.Time { return t.AddDate(0, k, 0) }
+func addDays(t time.Time, k int) time.Time   { return t.AddDate(0, 0, k) }
+func addWeeks(t time.Time, k int) time.Time  { return t.AddDate(0, 0, 7*k) }
+
+// modelDiffYears: the whole years from the earlier instant to the later, both
+// read in the receiver's zone, or (carbon/4) each in its own zone
+// (difference.go:29: years := e.Year() - s.Year(), then one correction, which
+// is enough for years).
+func modelDiffYears(a, b moment, k known) int64 {
+	s, e := a.t, b.t
+	if !k[kDiffLocalFieldsPerZone] {
+		e = e.In(s.Location())
+	}
+	s, e, sign := order(s, e)
+	if !k[kDiffLocalFieldsPerZone] {
+		return sign * wholeSteps(s, e, addYears)
+	}
+	years := e.Year() - s.Year()
+	if s.AddDate(years, 0, 0).After(e) {
+		years--
+	}
+	return sign * int64(years)
+}
+
+// modelDiffMonths: the whole months (AddDate's overflowing months) from the
+// earlier instant to the later in the receiver's zone, or (carbon/4) with
+// each side's fields in its own zone, or (carbon/30) the field estimate
+// corrected downwards once (difference.go:61-64: months := 12*dy + dm; if
+// s.AddDate(0, months, 0).After(e) { months-- }).
+func modelDiffMonths(a, b moment, k known) int64 {
+	s, e := a.t, b.t
+	if !k[kDiffLocalFieldsPerZone] {
+		e = e.In(s.Location())
+	}
+	s, e, sign := order(s, e)
+	if !k[kDiffMonthsCorrectsOnce] {
+		return sign * wholeSteps(s, e, addMonths)
+	}
+	months := (e.Year()-s.Year())*12 + int(e.Month()-s.Month())
+	if s.AddDate(0, months, 0).After(e) {
+		months--
+	}
+	return sign * int64(months)
+}
+
+// modelDiffSeconds: the elapsed seconds truncated towards zero, or (carbon/2)
+// the difference of the whole-second timestamps (difference.go:175:
+// end.Timestamp() - c.Timestamp()).
+func modelDiffSeconds(a, b moment, k known) int64 {
+	dsec := b.t.Unix() - a.t.Unix()
+	if k[kDiffFloorsToSeconds] {
+		return dsec
+	}
+	dnano := int64(b.t.Nanosecond() - a.t.Nanosecond())
+	if dsec > 0 && dnano < 0 {
+		dsec--
+	} else if dsec < 0 && dnano > 0 {
+		dsec++
+	}
+	return dsec
+}
+
+// modelDiffDays: the whole calendar days (span 1) or weeks (span 7) from the
+// earlier instant to the later in its zone, or (carbon/3) the whole-second
+// difference divided by 86400 or 604800 (difference.go:109, 87).
+func modelDiffDays(a, b moment, k known, span int) int64 {
+	if k[kDiffDaysBySeconds] {
+		return (b.t.Unix() - a.t.Unix()) / int64(86400*span)
+	}
+	s, e, sign := order(a.t, b.t)
+	if span == 7 {
+		return sign * wholeSteps(s, e, addWeeks)
+	}
+	return sign * wholeSteps(s, e, addDays)
+}
+
+func abs64(x int64) int64 {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
+
+// yearPairs: the pairs of the differences in years and months: b independent
+// or shifted from a by years, months, days and seconds, read in a's zone or
+// (carbon/4, 30% of the time) in a drawn zone.
+var yearPairs = pairsOf(moments, func(a moment) hegel.Generator[moment] {
+	zone := hzWeighted(
+		hzW(64, via("same zone", hegel.Just(a.zone))),             // 70 nominal: weight 64 realises 73.2
+		hzW(hzUnless(hzNoKnown, 40), via("other zone", zoneList)), // 30 nominal: weight 40 realises 26.8
+	)
+	b := hzWeighted(
+		hzW(32, via("independent", moments)),                      // 50 nominal: weight 32 realises 52.6
+		hzW(88, via("shifted", datesFrom(a, 80, 30, 40, 100000))), // 50 nominal: weight 88 realises 47.4
+	)
+	return hegel.Map(hzTuple(hegel.Map(zone, func(z tagged[string]) moment { return moment{zone: z.v, drawn: []string{z.via}} }), hegel.Map(b, func(o tagged[moment]) moment {
+		return moment{zone: o.v.zone, t: o.v.t, drawn: append([]string{o.via}, o.v.drawn...)}
+	})), func(v []moment) moment {
+		z, o := v[0], v[1]
+		return moment{zone: z.zone, t: o.t.In(zones[z.zone]), drawn: append(z.drawn, o.drawn...)}
+	})
+})
+
+// exactYearPairs: under HEGEL_NO_KNOWN=1 the pairs in the region of carbon/30
+// (the end within the days a month's overflow spans of the start's day) are
+// filtered out.
+var exactYearPairs = hzOnly(hzNoKnown, "carbon/30", yearPairs, func(c pairCase) bool { return shapeID(c, yearsExpected) == "" })
+
+// yearsExpected: DiffInYears and DiffInMonths each way and their absolute values.
+func yearsExpected(c pairCase, k known) checks {
+	out := checks{}
+	years, months := modelDiffYears(c.a, c.b, k), modelDiffMonths(c.a, c.b, k)
+	out.set("DiffInYears", years)
+	out.set("DiffInMonths", months)
+	out.set("DiffInYears back", modelDiffYears(c.b, c.a, k))
+	out.set("DiffInMonths back", modelDiffMonths(c.b, c.a, k))
+	out.set("DiffAbsInYears", abs64(years))
+	out.set("DiffAbsInMonths", abs64(months))
+	return out
+}
+
+func yearsActual(c pairCase) checks {
+	ca, cb := carbonOf(c.a), carbonOf(c.b)
+	out := checks{}
+	out.set("DiffInYears", ca.DiffInYears(cb))
+	out.set("DiffInMonths", ca.DiffInMonths(cb))
+	out.set("DiffInYears back", cb.DiffInYears(ca))
+	out.set("DiffInMonths back", cb.DiffInMonths(ca))
+	out.set("DiffAbsInYears", ca.DiffAbsInYears(cb))
+	out.set("DiffAbsInMonths", ca.DiffAbsInMonths(cb))
+	return out
+}
