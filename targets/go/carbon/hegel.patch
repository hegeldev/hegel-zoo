+package carbon_test
+
+// One deterministic pin per recorded bug (bugs.toml). Each asserts the
+// correct behaviour and fails while the bug exists; the matching Known
+// switch in hegel_gen_test.go keeps the properties clean meanwhile.
+
+import (
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"github.com/dromara/carbon/v2/calendar/hebrew"
+	"github.com/dromara/carbon/v2/calendar/julian"
+	"github.com/dromara/carbon/v2/calendar/lunar"
+	"github.com/dromara/carbon/v2/calendar/persian"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panicked: %v", what, r)
+		}
+	}()
+	f()
+}
+
+// carbon/1: ToWeekString, ToShortWeekString and Format's D index the
+// Sunday-first names with DayOfWeek, which counts from weekStartsAt.
+func TestHegelPinSundayIsSundayWithSundayWeekStart(t *testing.T) {
+	sun := carbon.CreateFromDate(2024, 3, 10, "UTC").SetWeekStartsAt(carbon.Sunday) // a Sunday
+	if got := sun.ToWeekString(); got != "Sunday" {
+		t.Errorf("ToWeekString of Sunday 2024-03-10 with a Sunday week start = %q, want Sunday", got)
+	}
+	if got := sun.ToShortWeekString(); got != "Sun" {
+		t.Errorf("ToShortWeekString = %q, want Sun", got)
+	}
+	if got := sun.Format("D l"); got != "Sun Sunday" {
+		t.Errorf("Format(\"D l\") = %q, want \"Sun Sunday\"", got)
+	}
+	wed := carbon.CreateFromDate(2020, 8, 5, "UTC").SetWeekStartsAt(carbon.Saturday) // a Wednesday
+	if got := wed.ToWeekString(); got != "Wednesday" {
+		t.Errorf("ToWeekString of Wednesday 2020-08-05 with a Saturday week start = %q, want Wednesday", got)
+	}
+}
+
+// carbon/2: DiffInSeconds is the difference of the whole-second timestamps,
+// and Closest/Farthest compare with it.
+func TestHegelPinDiffInSecondsOfSubSecondGap(t *testing.T) {
+	a := carbon.CreateFromDateTimeNano(2024, 1, 1, 0, 0, 0, 900000000, "UTC")
+	b := carbon.CreateFromDateTimeNano(2024, 1, 1, 0, 0, 1, 100000000, "UTC")
+	if got := a.DiffInSeconds(b); got != 0 {
+		t.Errorf("DiffInSeconds of instants 0.2 s apart = %d, want 0", got)
+	}
+	c := carbon.CreateFromDateTimeNano(2024, 1, 1, 10, 0, 0, 0, "UTC")
+	near := carbon.CreateFromDateTimeNano(2024, 1, 1, 9, 59, 59, 500000000, "UTC") // 0.5 s away
+	far := carbon.CreateFromDateTimeNano(2024, 1, 1, 10, 0, 0, 900000000, "UTC")   // 0.9 s away
+	if got := c.Closest(far, near); !got.Eq(near) {
+		t.Errorf("Closest = %s, want the instant 0.5 s away", got.ToDateTimeNanoString())
+	}
+	if got := c.Farthest(near, far); !got.Eq(far) {
+		t.Errorf("Farthest = %s, want the instant 0.9 s away", got.ToDateTimeNanoString())
+	}
+}
+
+// carbon/3: DiffInDays divides elapsed seconds by 86400.
+func TestHegelPinDiffInDaysAcrossDST(t *testing.T) {
+	a := carbon.CreateFromDate(2024, 3, 10, "America/New_York")
+	b := carbon.CreateFromDate(2024, 3, 11, "America/New_York") // the clocks moved forward in between
+	if got := a.DiffInDays(b); got != 1 {
+		t.Errorf("DiffInDays(2024-03-10, 2024-03-11) in New York = %d, want 1", got)
+	}
+	a = carbon.CreateFromDate(2024, 10, 27, "Europe/London")
+	b = carbon.CreateFromDate(2024, 11, 3, "Europe/London") // 7 calendar days, 169 hours
+	if got := a.DiffInWeeks(b); got != 1 {
+		t.Errorf("DiffInWeeks(2024-10-27, 2024-11-03) in London = %d, want 1", got)
+	}
+}
+
+// carbon/4: DiffInYears and DiffInMonths read each side's fields in its own zone.
+func TestHegelPinDiffInYearsAcrossZones(t *testing.T) {
+	s := carbon.CreateFromDateTime(2023, 12, 31, 20, 0, 0, "UTC")
+	e := carbon.CreateFromDateTime(2024, 1, 1, 3, 0, 0, "Asia/Shanghai") // 2023-12-31 19:00 UTC, an hour before s
+	if got := s.DiffInYears(e); got != 0 {
+		t.Errorf("DiffInYears of instants an hour apart = %d, want 0", got)
+	}
+	if got := s.DiffInMonths(e); got != 0 {
+		t.Errorf("DiffInMonths of instants an hour apart = %d, want 0", got)
+	}
+	s = carbon.CreateFromDateTime(2020, 1, 31, 23, 0, 0, "UTC")
+	e = carbon.CreateFromDateTime(2020, 3, 1, 1, 0, 0, "Asia/Shanghai") // 2020-02-29 17:00 UTC
+	if got, same := s.DiffInMonths(e), s.DiffInMonths(carbon.CreateFromStdTime(e.StdTime().UTC())); got != same || got != 0 {
+		t.Errorf("DiffInMonths = %d with the end in Shanghai, %d with the same instant in UTC; want 0 and 0", got, same)
+	}
+}
+
+// carbon/5: IsSagittarius starts on November 22.
+func TestHegelPinNovember22IsScorpioOnly(t *testing.T) {
+	d := carbon.CreateFromDate(2024, 11, 22, "UTC")
+	if d.Constellation() != "Scorpio" || !d.IsScorpio() {
+		t.Errorf("November 22: Constellation %q, IsScorpio %v", d.Constellation(), d.IsScorpio())
+	}
+	if d.IsSagittarius() {
+		t.Errorf("IsSagittarius(November 22) = true, but the sign is Scorpio")
+	}
+}
+
+// carbon/6: AddHours..AddNanoseconds multiply into a time.Duration.
+func TestHegelPinAddHoursBeyondDurationRange(t *testing.T) {
+	c := carbon.CreateFromDate(2000, 1, 1, "UTC")
+	want := time.Unix(c.Timestamp()+3000000*3600, 0).UTC() // 2342-02-28
+	if got := c.AddHours(3000000); !got.StdTime().Equal(want) {
+		t.Errorf("AddHours(3000000) = %s, want %s", got.ToDateTimeString(), want.Format("2006-01-02 15:04:05"))
+	}
+	want = time.Unix(c.Timestamp()+10000000000, 0).UTC() // 2316-11-21
+	if got := c.AddSeconds(10000000000); !got.StdTime().Equal(want) {
+		t.Errorf("AddSeconds(1e10) = %s, want %s", got.ToDateTimeString(), want.Format("2006-01-02 15:04:05"))
+	}
+}
+
+// carbon/7: AddDuration with a bad string sets Error on the receiver.
+func TestHegelPinAddDurationErrorStaysOnResult(t *testing.T) {
+	c := carbon.CreateFromDate(2000, 1, 1, "UTC")
+	r := c.AddDuration("bogus")
+	if r == nil || !r.HasError() {
+		t.Fatalf("AddDuration(\"bogus\") did not fail")
+	}
+	if c.HasError() || c.ToDateString() != "2000-01-01" {
+		t.Errorf("the receiver was poisoned: error %v, date %q", c.Error, c.ToDateString())
+	}
+}
