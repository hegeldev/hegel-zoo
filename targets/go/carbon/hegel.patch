+// The formatting and parsing properties, still on the older generators
+// (genZone, genTime, genFormat, genFreeFormat) and the Known switches of
+// hegel_gen_test.go: they run clean against the pinned commit (the recorded
+// bugs are gated by Known and counted). The core properties moved to
+// hegel_core_test.go; the pins in hegel_pins_test.go are expected to fail
+// while their bugs are open.
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Formatting and parsing.
+
+func TestHegelFormatAgreesWithModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		ws := pick(tc, weekdays...)
+		c.SetWeekStartsAt(ws)
+		f := genFreeFormat(tc)
+		note(ht, "%s Format(%q) weekStartsAt=%s", showTime(tm), f, ws)
+		// parts 2 and 3 replace this: the property still follows the recorded bugs
+		if ws != time.Monday && Known.weekNamesFollowWeekStart && strings.Contains(strings.NewReplacer(`\D`, "").Replace(f), "D") {
+			count(ht, "known-carbon/1")
+			return
+		}
+		want := modelFormat(tm, f, ws)
+		if got := c.Format(f); got != want {
+			fail(ht, "Format(%q) of %s = %q, want %q", f, showTime(tm), got, want)
+		}
+		// the layout constants and their format twins print the same
+		twins := []struct{ layout, format string }{
+			{carbon.DateTimeLayout, carbon.DateTimeFormat}, {carbon.DateLayout, carbon.DateFormat}, {carbon.TimeLayout, carbon.TimeFormat},
+			{carbon.ShortDateTimeLayout, carbon.ShortDateTimeFormat}, {carbon.RFC3339Layout, carbon.RFC3339Format}, {carbon.ISO8601Layout, carbon.ISO8601Format},
+			{carbon.RFC1123Layout, carbon.RFC1123Format}, {carbon.RFC822ZLayout, carbon.RFC822ZFormat}, {carbon.CookieLayout, carbon.CookieFormat},
+			{carbon.KitchenLayout, carbon.KitchenFormat}, {carbon.RFC850Layout, carbon.RFC850Format}, {carbon.HttpLayout, carbon.HttpFormat},
+			{carbon.FormattedDateLayout, carbon.FormattedDateFormat}, {carbon.DayDateTimeLayout, carbon.DayDateTimeFormat},
+		}
+		for _, tw := range twins {
+			// parts 2 and 3 replace this: the property still follows the recorded bugs
+			if ws != time.Monday && Known.weekNamesFollowWeekStart && strings.Contains(tw.format, "D") {
+				continue
+			}
+			if got, want := c.Format(tw.format), tm.Format(tw.layout); got != want {
+				fail(ht, "Format(%q) = %q but Format(layout %q) = %q for %s", tw.format, got, tw.layout, want, showTime(tm))
+			}
+			if got, want := c.Layout(tw.layout), tm.Format(tw.layout); got != want {
+				fail(ht, "Layout(%q) = %q, want %q for %s", tw.layout, got, want, showTime(tm))
+			}
+		}
+	})
+}
+
+// alphaAbbrev reports whether the zone abbreviation is letters only (Go
+// cannot parse "+0545" or "-03" through the MST token).
+func alphaAbbrev(tm time.Time) bool {
+	name, _ := tm.Zone()
+	for _, r := range name {
+		if r < 'A' || r > 'Z' {
+			return false
+		}
+	}
+	return name != ""
+}
+
+func truncTo(tm time.Time, precision int64) time.Time {
+	y, m, d := tm.Date()
+	h, mi, s := tm.Clock()
+	ns := int64(tm.Nanosecond()) / precision * precision
+	if precision >= 1e9 {
+		ns = 0
+		step := int(precision / 1e9)
+		secs := (h*3600 + mi*60 + s) / step * step
+		h, mi, s = secs/3600, secs%3600/60, secs%60
+	}
+	return time.Date(y, m, d, h, mi, s, int(ns), tm.Location())
+}
+
+func TestHegelFormatParsesBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		zoneName, loc := genZone(tc)
+		tm := genTime(tc, loc)
+		c := carbon.CreateFromStdTime(tm)
+		spec := genFormat(tc)
+		note(ht, "%s Format(%q)", showTime(tm), spec.format)
+		if spec.twoDigitY && (tm.Year() < 1969 || tm.Year() > 2068) {
+			count(ht, "two-digit-year-out-of-range")
+			return
+		}
+		if spec.zone == "Z" && !alphaAbbrev(tm) {
+			count(ht, "abbreviation-not-alphabetic")
+			return
+		}
+		if _, off := tm.Zone(); off%60 != 0 && spec.zone != "" {
+			count(ht, "sub-minute-offset")
+			return
+		}
+		s := c.Format(spec.format)
+		back := carbon.ParseByFormat(s, spec.format, zoneName)
+		if back == nil || back.HasError() {
+			fail(ht, "ParseByFormat(%q, %q) failed: %s", s, spec.format, showCarbon(back))
+		}
+		want := truncTo(tm, spec.precision)
+		if spec.zone != "" {
+			if !back.StdTime().Equal(want) {
+				fail(ht, "ParseByFormat(%q, %q) = %s, want the instant %s", s, spec.format, showCarbon(back), showTime(want))
+			}
+		} else if got := back.StdTime().In(loc).Format("2006-01-02 15:04:05.999999999"); got != want.Format("2006-01-02 15:04:05.999999999") {
+			fail(ht, "ParseByFormat(%q, %q) = %s, want the wall clock %s", s, spec.format, showCarbon(back), showTime(want))
+		}
+		if back.Timezone() != zoneName {
+			fail(ht, "ParseByFormat(%q, %q) in %s reports zone %s", s, spec.format, zoneName, back.Timezone())
+		}
+		// ParseByFormats with the right format somewhere in the list
+		list := []string{"Y", spec.format, "H:i"}
+		if back2 := carbon.ParseByFormats(s, list, zoneName); back2 == nil || back2.HasError() || !back2.StdTime().Equal(back.StdTime()) {
+			fail(ht, "ParseByFormats(%q, %q) = %s, ParseByFormat gave %s", s, list, showCarbon(back2), showCarbon(back))
+		}
+	})
+}
+
