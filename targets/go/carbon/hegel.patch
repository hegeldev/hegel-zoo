+		t.Errorf("DiffInMonths(1989-01-31 23:59:59, 2006-12-01 01:59:14) = %d, want 213 (AddMonths(213) = %s, AddMonths(214) = %s)", k, s.AddMonths(213).ToDateTimeString(), s.AddMonths(214).ToDateTimeString())
+	}
+	s = carbon.CreateFromDateTime(2023, 1, 31, 12, 0, 0, "UTC")
+	e = carbon.CreateFromDateTime(2023, 3, 2, 6, 0, 0, "UTC")
+	if k := s.DiffInMonths(e); s.AddMonths(int(k)).Gt(e) {
+		t.Errorf("DiffInMonths(2023-01-31 12:00, 2023-03-02 06:00) = %d, but AddMonths(%d) = %s is after the end", k, k, s.AddMonths(int(k)).ToDateTimeString())
+	}
+}
+
+// carbon/31: the Persian date of a day that begins with a DST gap.
+func TestHegelPinPersianDateOnADstGapDay(t *testing.T) {
+	// Sao Paulo's summer time began at 00:00 on 1994-10-16: the day has no
+	// midnight, and time.Date puts it at 23:00 the day before.
+	c := carbon.CreateFromDateTime(1994, 10, 16, 12, 0, 0, "America/Sao_Paulo")
+	before := carbon.CreateFromDateTime(1994, 10, 15, 12, 0, 0, "America/Sao_Paulo")
+	if got, prev := c.Persian().String(), before.Persian().String(); got == prev {
+		t.Errorf("Persian date of 1994-10-16 in Sao Paulo = %s, the same as the day before", got)
+	}
+	if got := c.Persian().String(); got != "1373-07-24" {
+		t.Errorf("Persian date of 1994-10-16 = %s, want 1373-07-24", got)
+	}
+	if got := persian.NewPersian(1373, 7, 24).ToGregorian("America/Sao_Paulo").Time; got.Year() != 1994 || got.Month() != 10 || got.Day() != 16 {
+		t.Errorf("NewPersian(1373, 7, 24).ToGregorian(Sao Paulo) = %s, want 1994-10-16", got.Format("2006-01-02 15:04 -07:00"))
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..4e7dee1
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,391 @@
+package carbon_test
+
+// Hegel properties for github.com/dromara/carbon/v2: every Carbon method
+// against Go's standard time package and against models written from the
+// methods' own doc comments (calendar arithmetic, boundaries, differences,
+// comparisons, the PHP-style Format letters, the default Parse layouts, the
+// JSON/SQL wrapper types). No external tool is needed.
+//
+// The core properties (hegel_core_test.go) draw their moments, pairs and
+// amounts as records from package-level generators (hegel_moments_test.go),
+// judge the library against models that state the documented behaviour and
+// name the shape of the recorded bug a case has before the library is called
+// (the harness below); their narrow companions (hegel_core_shapes_test.go)
+// draw each shape on purpose. The formatting properties
+// (hegel_format_test.go, narrow companions in hegel_format_shapes_test.go)
+// do the same with formats, round trips and the output methods, and the
+// calendar properties (hegel_calendar_test.go, narrow companions in
+// hegel_calendar_shapes_test.go, reference algorithms and tables in
+// hegel_calendar_refs_test.go) with the Hebrew, Persian, Julian and lunar
+// calendars. hegel_models_test.go has the zones and the models they share.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+// hegelOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to
+// the engine, which reads no environment variable itself.
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+// ---------------------------------------------------------------------------
+// The harness of the core properties (the go/excelize, go/graphql-go, go/cobra
+// and go/cascadia judge; hegel_idioms_test.go has the generator idioms).
+// hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is
+// passed through hegelOpts; a panic in the code under test is turned into a
+// failure of the current test case by hzProperty. HEGEL_COLLECT=1 (or
+// ZOO_COLLECT=1) makes the properties record their mismatches instead of
+// failing and print the counts. The model takes the set of recorded bugs it
+// follows as a value (known); the properties judge the library against the
+// documented behaviour (hzKnownNone), name the shape of the recorded bug a
+// case has before the library is called (hzCaseJudge.Shape) and skip the
+// shapes under HEGEL_NO_KNOWN=1 (hzNoKnown).
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and
+// prints them at the end in collect mode ("COLLECT TestHegel...: N mismatches;
+// class=count ..."), with the judge's counters (hzStats) and the first two
+// messages of each mismatch class.
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica
+// disagreement): counted, and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// ---------------------------------------------------------------------------
+// The switches of the recorded bugs.
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the
+// constants below in bug order. The model of each core property is a pure
+// function of (case, known): with every switch off (hzKnownNone) it states
+// the documented behaviour (the doc comments, Go's time package, the
+// calendar), which is what the properties judge the library against; with a
+// switch on it reproduces that bug as a replica of the library's rule. The
+// classifier of each property runs the model with several sets to name the
+// shape of a case before the library is called; the pins assert the
+// documented behaviour and fail while the bug exists. The core models follow
+// 1-7, 9, 11 and 28-30, the formatting models 8, 10, 12-14 and the calendar
+// models 15-24, 26, 27, 29 and 31; the switch of carbon/25 acts in no model
+// (its pin covers it).
+type known [31]bool
+
+const (
+	kWeekNamesFollowWeekStart   = iota // carbon/1: ToWeekString, ToShortWeekString and Format's D index the Sunday-first names with DayOfWeek, which counts from weekStartsAt, so with a Sunday week start a Sunday is called "Monday".
+	kDiffFloorsToSeconds               // carbon/2: DiffInSeconds (and Hours, Minutes, Closest, Farthest) is the difference of the two whole-second timestamps, so instants 0.2 s apart differ by "1 second" and Closest picks by whole seconds.
+	kDiffDaysBySeconds                 // carbon/3: DiffInDays and DiffInWeeks divide the elapsed seconds by 86400, so a day with a DST change is not a day.
+	kDiffLocalFieldsPerZone            // carbon/4: DiffInYears and DiffInMonths read each side's calendar fields in its own zone, so two instants an hour apart in different zones can be "1 year" apart.
+	kSagittariusStartsNov22            // carbon/5: IsSagittarius starts on November 22, which IsScorpio and Constellation still give to Scorpio.
+	kAddUnitsOverflowDuration          // carbon/6: AddHours..AddNanoseconds multiply the amount into a time.Duration, which wraps beyond +-292 years.
+	kAddDurationPoisonsReceiver        // carbon/7: AddDuration/SubDuration with an unparsable string set Error on the receiver instead of on the result.
+	kUtcMarkerOnLocalTime              // carbon/8: ToHttpString and the ToIso8601Zulu*String methods print the receiver's local wall clock followed by "GMT" or "Z", misstating the instant for every zone but UTC.
+	kSetDefaultResetsWeekStart         // carbon/9: SetDefault resets the default week start to Sunday whenever the caller does not set WeekStartsAt, because the empty check compares a Weekday's String to "".
+	kUnixLayoutsUnreadable             // carbon/10: The unix, unixMilli, unixMicro and unixNano pseudo-layouts are produced by Layout, MarshalJSON and Format S/U/V/X but cannot be read back by ParseByLayout or ParseByFormat.
+	kZeroCarbonPanics                  // carbon/11: The zero Carbon{} is IsValid but panics with a nil Location in StartOfDay, SetYear, AddMonthsNoOverflow and IsLongYear, and reports its week start as Sunday.
+	kTranslateIndexesBelowZero         // carbon/12: Language.translate panics with index -1 when a locale's "now" resource contains a | separator.
+	kFormatLiteralsUnprotected         // carbon/13: ParseByFormat copies format literals into the Go layout unprotected, so "1" or letters spelled with backslashes are read as layout tokens.
+	kOutputZoneMovesReceiver           // carbon/14: Every To*String, Format and Layout call with a timezone argument reassigns the receiver's location and Error, so an output call with a bad zone poisons the value, and several setters panic on a nil receiver.
+	kLunarUsesDefaultZone              // carbon/15: CreateFromLunar and Lunar.ToGregorian build Beijing midnight and read it in the default zone, so in UTC the lunar date comes back a day early and CreateFromLunar(...).Lunar() is not the identity.
+	kLunarPanicsOutsideTable           // carbon/16: Lunar() panics with an index out of range for Gregorian dates outside 1900-2100 instead of returning an invalid Lunar.
+	kLunarAcceptsAnyMonthAndDay        // carbon/17: NewLunar validates only the year: month 13, day 31 and a leap flag in a year without a leap month are accepted (and month 13 panics in ToDateString).
+	kPersian1403NotLeap                // carbon/18: the Persian calendar's 2820-year cycle makes 1403 a common year and 1404 a leap year; the official calendar has the reverse, so every day of 1404 is off by one.
+	kPersianEarlyYearsShifted          // carbon/19: Persian years 1..473 are shifted by a year (truncating division in getPersianJdn); year 473 is 730 days long.
+	kLunarMidnightOffset               // carbon/20: lunar.FromStdTime measures whole days from 1900-01-31 in the time's zone with Truncate, so in the hours after midnight in a zone whose offset differs from 1900's it returns the previous lunar day.
+	kLunar2033LeapMonth                // carbon/21: the lunar table gives 2033 a leap 7th month; the Hong Kong Observatory has a leap 11th month.
+	kPersianPreReformIsJulian          // carbon/22: persian.FromStdTime reads a pre-1582-10-15 time.Time as a Julian-calendar date while ToGregorian writes proleptic Gregorian.
+	kJulianDigitHeuristic              // carbon/23: NewJulian tells JD from MJD by counting digits, so MJDs below 9998.5 (before 1886-04-03) or from 99999.5 (2132-09-01 on) become JD 0.
+	kJulianPreReformCalendar           // carbon/24: julian.FromStdTime uses the Julian calendar before 1582-10-15, so the JD of a time.Time is not monotonic across the reform and ten dates collide.
+	kFormatLIsEnglish                  // carbon/25: Format "l" always prints the English weekday name while "D", "F" and "M" follow the locale.
+	kFaSundayMisnamed                  // carbon/26: persian.FaWeeks names Sunday with Thursday's name less its first letter instead of Yekshanbeh.
+	kAdarUnnumbered                    // carbon/27: The Hebrew month 12 of a leap year is named "Adar" (and its Hebrew form) instead of Adar I, so Adar I and Adar II cannot be told apart by name.
+	kZeroTimeIsBetweenAnything         // carbon/28: BetweenIncludedStart/End/Both answer true whenever the receiver and the included bound are the zero time, before looking at the other bound or its validity.
+	kJulianIgnoresZone                 // carbon/29: julian.FromStdTime reads the local wall clock as if it were UTC, so the JD of an instant depends on the zone it is expressed in.
+	kDiffMonthsCorrectsOnce            // carbon/30: DiffInMonths subtracts at most one month when the calendar estimate overshoots, so from the 29th-31st it can return k although AddMonths(k) is after the end.
+	kPersianMidnightInGap              // carbon/31: persian.FromStdTime and Persian.ToGregorian build the day's local midnight with time.Date, which on a day that begins with a DST gap Go places at 23:00 of the day before, so both faces are a day early there.
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("carbon/N"); hzKnownIndex the switch of a bug id (-1 for none or the hole).
+func hzKnownID(i int) string { return "carbon/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "carbon/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have
+// ("shape carbon/N" per case), the rule of the classifier that named them
+// ("shape via sufficiency", "shape via necessity", "shape hole"), the cases
+// skipped for them under HEGEL_NO_KNOWN=1 ("known carbon/N"), the checks
+// dropped for them under HEGEL_NO_KNOWN=1 ("dropped carbon/N"), the draws
+// hzOnly rejected ("filtered <name>"), the alternatives the generators drew
+// ("drawn <name>", for the realised rates), the replica's agreement with the
+// library on the shaped cases ("replica agreement", "replica disagreement")
+// and the cases skipped for an unrecorded candidate bug
+// ("candidate/go/carbon-N"); printed and reset by the collector, under
+// hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go,
+// go/cobra and go/cascadia judge, with the collector's mismatch classes): it
+// names the recorded bug whose shape the case has, so that a mismatch or a
+// library panic fails "(the shape of carbon/N)", and under HEGEL_NO_KNOWN=1
+// skips the case instead (counted as known). The wide and the narrow
+// properties of a family share their judge function and so this. The
+// classifier that names the shape is computed from the case alone (the model
+// run with several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is one check of a case rather than the whole case (the
+// week names of the getters, whose week start is drawn for every other check): by default
+// the shape is named and the check is made (false); under HEGEL_NO_KNOWN=1 the check is
+// dropped (true, counted as "dropped carbon/N") and the case goes on.
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
