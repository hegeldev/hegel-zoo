+// carbon/17: NewLunar validates only the year.
+func TestHegelPinLunarRejectsInvalidDates(t *testing.T) {
+	if l := lunar.NewLunar(2020, 13, 1, false); l.IsValid() {
+		t.Errorf("NewLunar(2020, 13, 1) is valid")
+	}
+	noPanic(t, "ToDateString of month 13", func() { _ = lunar.NewLunar(2020, 13, 1, false).ToDateString() })
+	if l := lunar.NewLunar(2020, 2, 30, false); l.IsValid() {
+		t.Errorf("NewLunar(2020, 2, 30) is valid; the month has 29 days")
