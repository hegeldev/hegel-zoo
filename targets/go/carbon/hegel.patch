+// carbon/20: lunar.FromStdTime in the hours after midnight.
+func TestHegelPinLunarDateAtLocalMidnight(t *testing.T) {
+	early := carbon.Parse("2020-06-15 00:30:00", "America/New_York").Lunar().String()
+	noon := carbon.Parse("2020-06-15 12:00:00", "America/New_York").Lunar().String()
+	if early != noon || noon != "2020-04-24" {
+		t.Errorf("Lunar of 2020-06-15 in New York: 00:30 -> %s, 12:00 -> %s, want 2020-04-24 (leap 4th month)", early, noon)
+	}
+	if got := carbon.Parse("1988-07-01 00:10:00", "Asia/Shanghai").Lunar().String(); got != "1988-05-18" {
+		t.Errorf("Lunar of 1988-07-01 00:10 in Shanghai (summer time) = %s, want 1988-05-18", got)
