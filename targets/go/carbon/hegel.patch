+// ---------------------------------------------------------------------------
+// carbon/11: the zero Carbon is usable.
+
+// zeroMethod is a method called on the zero time: the documented result (that
+// of a Carbon made from time.Time{}: 0001-01-01 00:00:00 UTC, a Monday, with
+// the default week start) and the result on the zero struct Carbon{} under
+// carbon/11 ("panic", or the value its missing settings give).
+type zeroMethod struct {
+	call   func(*carbon.Carbon) any
+	want   any
+	bugged string
+}
+
+// zeroTime is the zero time and its stamp.
+var zeroTime = time.Time{}
+
+func stampZeroDate(month time.Month, day, h, mi, s, ns int) string {
