+// carbon/6: the clock travellers beyond the Duration range.
+
+// durationLimit is the largest count of a unit a time.Duration holds.
+func durationLimit(u clockUnit) int { return int(time.Duration(1<<63-1) / u.d) }
+
+// overflowingCases: a unit of an hour down to a microsecond (a nanosecond
+// count cannot overflow) and a count past the Duration limit, up to a hundred
+// times it, either sign (within the limit under HEGEL_NO_KNOWN=1).
+var overflowingCases = hegel.Composite(func(tc hegel.TestCase) clockCase {
+	m := hegel.Draw(tc, moments)
+	unit := hegel.Draw(tc, weightedOver([]int{5, 16, 21, 24, 31}, clockUnits[:5]...))
+	limit := durationLimit(unit)
+	k := hegel.Draw(tc, hzShaped(hzInts(limit+1, 100*limit), hzInts(1, limit)))
+	if hegel.Draw(tc, hzCoin(50)) {
+		k = -k
+	}
+	return clockCase{m: m, unit: unit, k: tagged[int64]{v: int64(k), via: hzShaped("beyond the limit", "within the limit")}}
+})
