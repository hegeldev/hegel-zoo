+// zoneNames are the IANA zones the properties draw from: whole-hour offsets,
+// half- and quarter-hour offsets, southern-hemisphere DST, a zone without an
+// alphabetic abbreviation (Sao Paulo prints "-03"), and UTC.
+var zoneNames = []string{
+	"UTC", "Asia/Shanghai", "America/New_York", "Europe/London", "Australia/Sydney",
+	"Asia/Kolkata", "America/St_Johns", "Pacific/Chatham", "Europe/Berlin",
+	"America/Sao_Paulo", "Asia/Tokyo", "America/Los_Angeles", "Asia/Kathmandu",
+}
+
+var zones = func() map[string]*time.Location {
+	m := map[string]*time.Location{}
+	for _, name := range zoneNames {
+		loc, err := time.LoadLocation(name)
+		if err != nil {
+			panic(fmt.Sprintf("LoadLocation(%s): %v", name, err))
+		}
+		m[name] = loc
+	}
+	return m
+}()
+
+var weekdays = []time.Weekday{time.Sunday, time.Monday, time.Tuesday, time.Wednesday, time.Thursday, time.Friday, time.Saturday}
+
+func genZone(tc hegel.TestCase) (string, *time.Location) {
+	name := pick(tc, zoneNames...)
+	return name, zones[name]
+}
+
+// genYear favours the modern range but reaches the library's whole 1..9999.
+func genYear(tc hegel.TestCase) int {
+	switch n(tc, 1, 20) {
+	case 1, 2:
+		return n(tc, 1, 9999)
+	case 3, 4, 5:
+		return n(tc, 1800, 2200)
+	case 6:
+		return pick(tc, 1, 100, 400, 1000, 1582, 1900, 1969, 1970, 1999, 2000, 2038, 2100, 9999)
+	default:
+		return n(tc, 1970, 2050)
+	}
+}
+
+func daysIn(year int, month time.Month) int {
+	return time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC).Day()
+}
+
+// genNanos draws a nanosecond-of-second: often zero, often whole
+// milliseconds or microseconds, sometimes anything.
+func genNanos(tc hegel.TestCase) int {
+	switch n(tc, 1, 6) {
+	case 1, 2:
+		return 0
+	case 3:
+		return n(tc, 0, 999) * 1e6
+	case 4:
+		return n(tc, 0, 999999) * 1e3
+	case 5:
+		return pick(tc, 1, 999, 999999, 999999999, 500000000, 100000000)
+	default:
+		return n(tc, 0, 999999999)
+	}
+}
+
+// genTime draws a wall-clock time in loc. Day-of-month is valid for the
+// month; the ends of months are favoured because that is where the
+// overflow rules live.
+func genTime(tc hegel.TestCase, loc *time.Location) time.Time {
+	y := genYear(tc)
+	m := time.Month(n(tc, 1, 12))
+	last := daysIn(y, m)
+	var d int
+	switch n(tc, 1, 4) {
+	case 1:
+		d = pick(tc, 1, 28, last-1, last)
+	default:
+		d = n(tc, 1, last)
+	}
+	h, mi, s := n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59)
+	if chance(tc, 15) {
+		h, mi, s = pick(tc, 0, 12, 23), pick(tc, 0, 59), pick(tc, 0, 59)
+	}
+	return time.Date(y, m, d, h, mi, s, genNanos(tc), loc)
+}
+
+// genCarbon draws a Carbon and the time.Time it was made from.
+func genCarbon(tc hegel.TestCase) (*carbon.Carbon, time.Time) {
+	_, loc := genZone(tc)
+	t := genTime(tc, loc)
+	return carbon.CreateFromStdTime(t), t
+}
+
+// genNear draws a second time within a few days of t (same location).
+func genNear(tc hegel.TestCase, t time.Time) time.Time {
+	secs := n(tc, -4*86400, 4*86400)
+	if chance(tc, 20) {
+		secs = pick(tc, 0, 1, -1, 86400, -86400, 3600, -3600, 60, -60, 7*86400, -7*86400)
+	}
+	return time.Unix(t.Unix()+int64(secs), int64(genNanos(tc))).In(t.Location())
+}
+
+func showTime(t time.Time) string { return t.Format("2006-01-02 15:04:05.999999999 -07:00 MST") }
+
+func showCarbon(c *carbon.Carbon) string {
+	if c == nil {
+		return "<nil>"
+	}
+	if c.HasError() {
+		return "<error: " + c.Error.Error() + ">"
+	}
+	if c.IsEmpty() {
+		return "<empty>"
+	}
+	return showTime(c.StdTime()) + " in " + c.Timezone()
+}
+
+// sameInstant compares a Carbon with a time.Time (instant and location).
+func sameInstant(c *carbon.Carbon, want time.Time) bool {
+	return c != nil && !c.HasError() && c.StdTime().Equal(want)
+}
+
+// sameWallClock compares a Carbon with a time.Time field by field, in the
+// time's location.
+func sameWallClock(c *carbon.Carbon, want time.Time) bool {
+	if c == nil || c.HasError() {
+		return false
+	}
+	got := c.StdTime().In(want.Location())
+	return got.Equal(want) && got.Format(time.RFC3339Nano) == want.Format(time.RFC3339Nano)
+}
+
+// ---------------------------------------------------------------------------
+// Models.
+
+// modelAddMonthsNoOverflow adds months, clamping the day to the target
+// month's length ("without overflowing month").
+func modelAddMonthsNoOverflow(t time.Time, months int) time.Time {
+	y, m, d := t.Date()
+	h, mi, s := t.Clock()
+	first := time.Date(y, m+time.Month(months), 1, 0, 0, 0, 0, time.UTC)
+	last := daysIn(first.Year(), first.Month())
+	if d > last {
+		d = last
+	}
+	return time.Date(first.Year(), first.Month(), d, h, mi, s, t.Nanosecond(), t.Location())
+}
+
+// modelAddSeconds adds k seconds exactly (no Duration in between).
+func modelAddSeconds(t time.Time, k int64) time.Time {
+	return time.Unix(t.Unix()+k, int64(t.Nanosecond())).In(t.Location())
+}
+
+// modelAddNanos adds k units of `unit` nanoseconds each, exactly.
+func modelAddNanos(t time.Time, k int64, unit int64) time.Time {
+	secs := k / (1e9 / unit)
+	rem := k % (1e9 / unit)
+	return time.Unix(t.Unix()+secs, int64(t.Nanosecond())+rem*unit).In(t.Location())
+}
+
+// overflowsDuration reports whether k*unit does not fit a time.Duration.
+func overflowsDuration(k int64, unit time.Duration) bool {
+	if k == 0 {
+		return false
+	}
+	limit := int64(math.MaxInt64) / int64(unit)
+	return k > limit || k < -limit
+}
+
+func startOfDay(t time.Time) time.Time {
+	y, m, d := t.Date()
+	return time.Date(y, m, d, 0, 0, 0, 0, t.Location())
+}
+
+func endOfDay(t time.Time) time.Time {
+	y, m, d := t.Date()
+	return time.Date(y, m, d, 23, 59, 59, 999999999, t.Location())
+}
+
+// modelDayOfWeek is the 1-based day of the week counted from weekStartsAt.
+func modelDayOfWeek(t time.Time, ws time.Weekday) int {
+	return (int(t.Weekday())-int(ws)+7)%7 + 1
+}
+
+func modelStartOfWeek(t time.Time, ws time.Weekday) time.Time {
+	back := (int(t.Weekday()) - int(ws) + 7) % 7
+	y, m, d := t.Date()
+	return time.Date(y, m, d-back, 0, 0, 0, 0, t.Location())
+}
+
+func modelEndOfWeek(t time.Time, ws time.Weekday) time.Time {
+	we := time.Weekday((int(ws) + 6) % 7)
+	fwd := (int(we) - int(t.Weekday()) + 7) % 7
+	y, m, d := t.Date()
+	return time.Date(y, m, d+fwd, 23, 59, 59, 999999999, t.Location())
+}
+
+// modelWeekOfMonth: week 1 holds the 1st; weeks start at ws.
+func modelWeekOfMonth(t time.Time, ws time.Weekday) int {
+	first := time.Date(t.Year(), t.Month(), 1, 0, 0, 0, 0, t.Location())
+	days := t.Day() + modelDayOfWeek(first, ws) - 1
+	return (days + 6) / 7
+}
+
+func modelQuarter(m time.Month) int { return (int(m)-1)/3 + 1 }
+
+// modelIsLongYear: an ISO year has 53 weeks iff December 28 is in week 53.
+func modelIsLongYear(year int) bool {
+	_, w := time.Date(year, time.December, 28, 0, 0, 0, 0, time.UTC).ISOWeek()
+	return w == 53
+}
+
+// seasons by the meteorological division: spring March-May, summer
+// June-August, autumn September-November, winter December-February.
+func modelSeason(m time.Month) string {
+	switch m {
+	case time.March, time.April, time.May:
+		return "Spring"
+	case time.June, time.July, time.August:
+		return "Summer"
+	case time.September, time.October, time.November:
+		return "Autumn"
+	}
+	return "Winter"
+}
+
+// the tropical zodiac by the dates the library documents (Aries from
+// March 21 ... Pisces to March 20).
+var zodiac = []struct {
+	name         string
+	fromM, fromD int
+	toM, toD     int
+}{
+	{"Aries", 3, 21, 4, 19}, {"Taurus", 4, 20, 5, 20}, {"Gemini", 5, 21, 6, 21}, {"Cancer", 6, 22, 7, 22},
+	{"Leo", 7, 23, 8, 22}, {"Virgo", 8, 23, 9, 22}, {"Libra", 9, 23, 10, 23}, {"Scorpio", 10, 24, 11, 22},
+	{"Sagittarius", 11, 23, 12, 21}, {"Capricorn", 12, 22, 1, 19}, {"Aquarius", 1, 20, 2, 18}, {"Pisces", 2, 19, 3, 20},
+}
+
+func modelConstellation(m time.Month, d int) string {
+	for _, z := range zodiac {
+		if (int(m) == z.fromM && d >= z.fromD) || (int(m) == z.toM && d <= z.toD) {
+			return z.name
+		}
+	}
+	return ""
+}
+
+var englishMonths = []string{"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
+var englishDays = []string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
+
+func ordinalSuffix(day int) string {
+	switch day {
+	case 1, 21, 31:
+		return "st"
+	case 2, 22:
+		return "nd"
+	case 3, 23:
+		return "rd"
+	}
+	return "th"
+}
+
+// modelFormat renders a PHP-style format from the letters' documented
+// meanings (formatMap and Format's switch in outputer.go).
+func modelFormat(t time.Time, format string, ws time.Weekday) string {
+	var b strings.Builder
+	for i := 0; i < len(format); i++ {
+		ch := format[i]
+		switch ch {
+		case '\\':
+			if i+1 < len(format) {
+				b.WriteByte(format[i+1])
+				i++
+			}
+		case 'd':
+			b.WriteString(fmt.Sprintf("%02d", t.Day()))
+		case 'D':
+			b.WriteString(englishDays[t.Weekday()][:3])
+		case 'j':
+			b.WriteString(fmt.Sprintf("%d", t.Day()))
+		case 'l':
+			b.WriteString(englishDays[t.Weekday()])
+		case 'F':
+			b.WriteString(englishMonths[t.Month()-1])
+		case 'm':
+			b.WriteString(fmt.Sprintf("%02d", int(t.Month())))
+		case 'M':
+			b.WriteString(englishMonths[t.Month()-1][:3])
+		case 'n':
+			b.WriteString(fmt.Sprintf("%d", int(t.Month())))
+		case 'Y':
+			b.WriteString(t.Format("2006"))
+		case 'y':
+			b.WriteString(t.Format("06"))
+		case 'a':
+			b.WriteString(t.Format("pm"))
+		case 'A':
+			b.WriteString(t.Format("PM"))
+		case 'g':
+			b.WriteString(t.Format("3"))
+		case 'h':
+			b.WriteString(t.Format("03"))
+		case 'H':
+			b.WriteString(fmt.Sprintf("%02d", t.Hour()))
+		case 'G':
+			b.WriteString(fmt.Sprintf("%d", t.Hour()))
+		case 'i':
+			b.WriteString(fmt.Sprintf("%02d", t.Minute()))
+		case 's':
+			b.WriteString(fmt.Sprintf("%02d", t.Second()))
+		case 'O':
+			b.WriteString(t.Format("-0700"))
+		case 'P':
+			b.WriteString(t.Format("-07:00"))
+		case 'Q':
+			b.WriteString(t.Format("Z0700"))
+		case 'R':
+			b.WriteString(t.Format("Z07:00"))
+		case 'Z':
+			b.WriteString(t.Format("MST"))
+		case 'u':
+			b.WriteString(fmt.Sprintf("%03d", t.Nanosecond()/1e6))
+		case 'v':
+			b.WriteString(fmt.Sprintf("%06d", t.Nanosecond()/1e3))
+		case 'x':
+			b.WriteString(fmt.Sprintf("%09d", t.Nanosecond()))
+		case 'S':
+			b.WriteString(fmt.Sprintf("%d", t.Unix()))
+		case 'U':
+			b.WriteString(fmt.Sprintf("%d", t.UnixMilli()))
+		case 'V':
+			b.WriteString(fmt.Sprintf("%d", t.UnixMicro()))
+		case 'X':
+			b.WriteString(fmt.Sprintf("%d", t.UnixNano()))
+		case 'W':
+			_, w := t.ISOWeek()
+			b.WriteString(fmt.Sprintf("%d", w))
+		case 'N':
+			b.WriteString(fmt.Sprintf("%d", modelDayOfWeek(t, ws)))
+		case 'w':
+			b.WriteString(fmt.Sprintf("%d", modelDayOfWeek(t, ws)-1))
+		case 'K':
+			b.WriteString(ordinalSuffix(t.Day()))
+		case 'L':
+			if isLeap(t.Year()) {
+				b.WriteString("1")
+			} else {
+				b.WriteString("0")
+			}
+		case 't':
+			b.WriteString(fmt.Sprintf("%d", daysIn(t.Year(), t.Month())))
+		case 'z':
+			b.WriteString(t.Location().String())
+		case 'o':
+			_, off := t.Zone()
+			b.WriteString(fmt.Sprintf("%d", off))
+		case 'q':
+			b.WriteString(fmt.Sprintf("%d", modelQuarter(t.Month())))
+		case 'c':
+			b.WriteString(fmt.Sprintf("%d", t.Year()/100+1))
+		default:
+			b.WriteByte(ch)
+		}
+	}
+	return b.String()
+}
+
+func isLeap(y int) bool { return y%400 == 0 || (y%4 == 0 && y%100 != 0) }
+
+// formatLetters are every letter Format interprets.
+const formatLetters = "dDjlFmMnYyaAghHGisOPQRZuvxSUVXWNwKLtzoqc"
+
+// parseableDateLetters / time letters: the letters ParseByFormat can read
+// back (those with a Go layout token); fractions must follow a '.'.
+var (
+	yearLetters   = []string{"Y", "y"}
+	monthLetters  = []string{"m", "n", "M", "F"}
+	dayLetters    = []string{"d", "j"}
+	hourLetters24 = []string{"H"}
+	hourLetters12 = []string{"g", "h"}
+	ampmLetters   = []string{"a", "A"}
+	zoneLetters   = []string{"O", "P", "Q", "R", "Z"}
+	separators    = []string{"-", "/", " ", ", ", ":", ".", "T", "@", "_"}
+)
+
+// genFormat draws a format whose letters ParseByFormat can read back, with
+// non-alphanumeric separators (and escaped letters) between the fields, and
+// reports the precision (in nanoseconds) the format keeps and which zone
+// letter, if any, it carries.
+type formatSpec struct {
+	format    string
+	precision int64 // 1e9 seconds, 1e6 millis, 1e3 micros, 1 nanos
+	zone      string
+	twoDigitY bool
+	weekday   bool
+}
+
+func genFormat(tc hegel.TestCase) formatSpec {
+	sep := func() string {
+		s := pick(tc, "-", "/", " ", ", ", ":", ".", " ", "-")
+		if chance(tc, 10) {
+			s += "\\" + pick(tc, "T", "a", "d", "Y", "x", "Z")
+		}
+		return s
+	}
+	var parts []string
+	spec := formatSpec{precision: 1e9}
+	y := pick(tc, yearLetters...)
+	spec.twoDigitY = y == "y"
+	date := []string{y, pick(tc, monthLetters...), pick(tc, dayLetters...)}
+	if chance(tc, 30) {
+		date[0], date[2] = date[2], date[0]
+	}
+	parts = append(parts, date[0]+sep()+date[1]+sep()+date[2])
+	if chance(tc, 30) {
+		spec.weekday = true
+		parts = append(parts, pick(tc, "D", "l"))
+	}
+	var tm string
+	if chance(tc, 60) {
+		tm = "H:i:s"
+	} else {
+		tm = pick(tc, hourLetters12...) + ":i:s" + pick(tc, " ", "") + pick(tc, ampmLetters...)
+	}
+	switch n(tc, 1, 5) {
+	case 1:
+		tm = strings.Replace(tm, ":s", ":s.u", 1)
+		spec.precision = 1e6
+	case 2:
+		tm = strings.Replace(tm, ":s", ":s.v", 1)
+		spec.precision = 1e3
+	case 3:
+		tm = strings.Replace(tm, ":s", ":s.x", 1)
+		spec.precision = 1
+	}
+	parts = append(parts, tm)
+	if chance(tc, 50) {
+		spec.zone = pick(tc, zoneLetters...)
+		parts = append(parts, spec.zone)
+	}
+	spec.format = strings.Join(parts, " ")
+	return spec
+}
+
+// genFreeFormat draws any string of format letters and literals for the
+// Format model.
+func genFreeFormat(tc hegel.TestCase) string {
+	var b strings.Builder
+	for i, k := 0, n(tc, 1, 12); i < k; i++ {
+		switch n(tc, 1, 10) {
+		case 1:
+			b.WriteString("\\" + string(formatLetters[n(tc, 0, len(formatLetters)-1)]))
+		case 2:
+			b.WriteString(pick(tc, " ", "-", ":", "/", ".", ",", "'", "[", "]", "|", "1", "0", "_", "*"))
+		default:
+			b.WriteByte(formatLetters[n(tc, 0, len(formatLetters)-1)])
+		}
+	}
+	return b.String()
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	// carbon/1: ToWeekString, ToShortWeekString and Format's D index the
+	// Sunday-first names with DayOfWeek, which counts from weekStartsAt, so
+	// with a Sunday week start a Sunday is called "Monday".
+	weekNamesFollowWeekStart bool
+	// carbon/2: DiffInSeconds (and Hours, Minutes, Closest, Farthest) is the
+	// difference of the two whole-second timestamps, so instants 0.2 s apart
+	// differ by "1 second" and Closest picks by whole seconds.
+	diffFloorsToSeconds bool
+	// carbon/3: DiffInDays and DiffInWeeks divide the elapsed seconds by
+	// 86400, so a day with a DST change is not a day.
+	diffDaysBySeconds bool
+	// carbon/4: DiffInYears and DiffInMonths read each side's calendar
+	// fields in its own zone, so two instants an hour apart in different
+	// zones can be "1 year" apart.
+	diffLocalFieldsPerZone bool
+	// carbon/5: IsSagittarius starts on November 22, which IsScorpio and
+	// Constellation still give to Scorpio.
+	sagittariusStartsNov22 bool
+	// carbon/6: AddHours..AddNanoseconds multiply the amount into a
+	// time.Duration, which wraps beyond +-292 years.
+	addUnitsOverflowDuration bool
+	// carbon/7: AddDuration/SubDuration with an unparsable string set Error
+	// on the receiver instead of on the result.
+	addDurationPoisonsReceiver bool
+	// carbon/8: ToHttpString and the ToIso8601Zulu*String methods print the
+	// receiver's local wall clock followed by "GMT" or "Z", misstating the
+	// instant for every zone but UTC.
+	utcMarkerOnLocalTime bool
+	// carbon/15: CreateFromLunar and Lunar.ToGregorian build Beijing midnight
+	// and read it in the default zone, so in UTC the lunar date comes back a
+	// day early and CreateFromLunar(...).Lunar() is not the identity.
+	lunarUsesDefaultZone bool
+	// carbon/17: NewLunar validates only the year: month 13, day 31 and a
+	// leap flag in a year without a leap month are accepted (and month 13
+	// panics in ToDateString).
+	lunarAcceptsAnyMonthAndDay bool
+	// carbon/18: the Persian calendar's 2820-year cycle makes 1403 a common
+	// year and 1404 a leap year; the official calendar has the reverse, so
+	// every day of 1404 is off by one.
+	persian1403NotLeap bool
+	// carbon/19: Persian years 1..473 are shifted by a year (truncating
+	// division in getPersianJdn); year 473 is 730 days long.
+	persianEarlyYearsShifted bool
+	// carbon/20: lunar.FromStdTime measures whole days from 1900-01-31 in
+	// the time's zone with Truncate, so in the hours after midnight in a zone
+	// whose offset differs from 1900's it returns the previous lunar day.
+	lunarMidnightOffset bool
+	// carbon/21: the lunar table gives 2033 a leap 7th month; the Hong Kong
+	// Observatory has a leap 11th month.
+	lunar2033LeapMonth bool
+	// carbon/22: persian.FromStdTime reads a pre-1582-10-15 time.Time as a
+	// Julian-calendar date while ToGregorian writes proleptic Gregorian.
+	persianPreReformIsJulian bool
+	// carbon/23: NewJulian tells JD from MJD by counting digits, so MJDs
+	// below 9998.5 (before 1886-04-03) or from 99999.5 (2132-09-01 on)
+	// become JD 0.
+	julianDigitHeuristic bool
+	// carbon/24: julian.FromStdTime uses the Julian calendar before
+	// 1582-10-15, so the JD of a time.Time is not monotonic across the
+	// reform and ten dates collide.
+	julianPreReformCalendar bool
+	// carbon/28: BetweenIncludedStart/End/Both answer true whenever the
+	// receiver and the included bound are the zero time, before looking at
+	// the other bound or its validity.
+	zeroTimeIsBetweenAnything bool
+	// carbon/29: julian.FromStdTime reads the local wall clock as if it were
+	// UTC, so the JD of an instant depends on the zone it is expressed in.
+	julianIgnoresZone bool
+	// carbon/30: DiffInMonths subtracts at most one month when the
+	// calendar estimate overshoots, so from the 29th-31st it can return k
+	// although AddMonths(k) is after the end.
+	diffMonthsCorrectsOnce bool
+}{
+	diffMonthsCorrectsOnce:     true,
+	julianIgnoresZone:          true,
+	zeroTimeIsBetweenAnything:  true,
+	utcMarkerOnLocalTime:       true,
+	lunarUsesDefaultZone:       true,
+	lunarAcceptsAnyMonthAndDay: true,
+	persian1403NotLeap:         true,
+	persianEarlyYearsShifted:   true,
+	lunarMidnightOffset:        true,
+	lunar2033LeapMonth:         true,
+	persianPreReformIsJulian:   true,
+	julianDigitHeuristic:       true,
+	julianPreReformCalendar:    true,
+	weekNamesFollowWeekStart:   true,
+	diffFloorsToSeconds:        true,
+	diffDaysBySeconds:          true,
+	diffLocalFieldsPerZone:     true,
+	sagittariusStartsNov22:     true,
+	addUnitsOverflowDuration:   true,
+	addDurationPoisonsReceiver: true,
+}
