+		check("CreateFromDateTimeMilli", carbon.CreateFromDateTimeMilli(y, int(m), d, h, mi, s, ns/1e6, zoneName), time.Date(y, m, d, h, mi, s, ns/1e6*1e6, loc))
+		check("CreateFromDateTimeMicro", carbon.CreateFromDateTimeMicro(y, int(m), d, h, mi, s, ns/1e3, zoneName), time.Date(y, m, d, h, mi, s, ns/1e3*1e3, loc))
+		check("CreateFromDateTimeNano", carbon.CreateFromDateTimeNano(y, int(m), d, h, mi, s, ns, zoneName), tm)
+		check("CreateFromDate", carbon.CreateFromDate(y, int(m), d, zoneName), time.Date(y, m, d, 0, 0, 0, 0, loc))
+		check("CreateFromDateMilli", carbon.CreateFromDateMilli(y, int(m), d, ns/1e6, zoneName), time.Date(y, m, d, 0, 0, 0, ns/1e6*1e6, loc))
+		check("CreateFromDateMicro", carbon.CreateFromDateMicro(y, int(m), d, ns/1e3, zoneName), time.Date(y, m, d, 0, 0, 0, ns/1e3*1e3, loc))
+		check("CreateFromDateNano", carbon.CreateFromDateNano(y, int(m), d, ns, zoneName), time.Date(y, m, d, 0, 0, 0, ns, loc))
+		// out-of-range fields normalise like time.Date
+		m2, d2 := n(tc, -5, 20), n(tc, -40, 70)
+		check("CreateFromDate(normalised)", carbon.CreateFromDate(y, m2, d2, zoneName), time.Date(y, time.Month(m2), d2, 0, 0, 0, 0, loc))
+		// Parse of the canonical strings
+		check("Parse(ToDateTimeNanoString)", carbon.Parse(tm.Format(carbon.DateTimeNanoLayout), zoneName), tm)
+		check("Parse(ToDateString)", carbon.Parse(tm.Format(carbon.DateLayout), zoneName), startOfDay(tm))
+		if _, off := tm.Zone(); off%60 == 0 {
+			check("Parse(RFC3339Nano)", carbon.Parse(tm.Format(time.RFC3339Nano), zoneName), tm)
+		} else {
+			count(ht, "sub-minute-offset")
+		}
+		// bad inputs
+		if got := carbon.CreateFromDate(y, int(m), d, "Nowhere/Land"); got == nil || !got.HasError() || got.IsValid() {
+			fail(ht, "CreateFromDate with a bad zone: %s", showCarbon(got))
+		}
+		if got := carbon.Parse("not a date", zoneName); got == nil || !got.HasError() || got.IsValid() {
+			fail(ht, "Parse of garbage: %s", showCarbon(got))
+		}
+		if got := carbon.Parse("", zoneName); got == nil || !got.IsEmpty() || got.IsValid() || got.HasError() {
+			fail(ht, "Parse of the empty string: %s", showCarbon(got))
+		}
+		// the constants
+		if !carbon.MinValue().StdTime().Equal(time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC)) || !carbon.ZeroValue().IsZero() || !carbon.MinValue().IsZero() {
+			fail(ht, "MinValue/ZeroValue: %s %s", showCarbon(carbon.MinValue()), showCarbon(carbon.ZeroValue()))
+		}
+		if !carbon.MaxValue().StdTime().Equal(time.Date(9999, 12, 31, 23, 59, 59, 999999999, time.UTC)) {
+			fail(ht, "MaxValue: %s", showCarbon(carbon.MaxValue()))
+		}
+		if !carbon.EpochValue().IsEpoch() || carbon.EpochValue().Timestamp() != 0 {
+			fail(ht, "EpochValue: %s", showCarbon(carbon.EpochValue()))
+		}
+	})
+}
+
+type wrapped struct {
+	A *carbon.DateTime       `json:"a"`
+	B *carbon.DateTimeMilli  `json:"b"`
+	C *carbon.DateTimeMicro  `json:"c"`
+	D *carbon.DateTimeNano   `json:"d"`
+	E *carbon.Date           `json:"e"`
+	F *carbon.DateMilli      `json:"f"`
+	G *carbon.Time           `json:"g"`
+	H *carbon.TimeNano       `json:"h"`
+	I *carbon.Timestamp      `json:"i"`
+	J *carbon.TimestampMilli `json:"j"`
+	K *carbon.TimestampMicro `json:"k"`
+	L *carbon.TimestampNano  `json:"l"`
+}
+
+func TestHegelWrapperTypesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		if tm.IsZero() {
+			return
+		}
+		note(ht, "%s", showTime(tm))
+		w := wrapped{
+			A: carbon.NewDateTime(c), B: carbon.NewDateTimeMilli(c), C: carbon.NewDateTimeMicro(c), D: carbon.NewDateTimeNano(c),
+			E: carbon.NewDate(c), F: carbon.NewDateMilli(c), G: carbon.NewTime(c), H: carbon.NewTimeNano(c),
+			I: carbon.NewTimestamp(c), J: carbon.NewTimestampMilli(c), K: carbon.NewTimestampMicro(c), L: carbon.NewTimestampNano(c),
+		}
+		if tm.Year() < 1700 || tm.Year() > 2200 {
+			w.L = nil
+		}
+		b1, err := json.Marshal(w)
+		if err != nil {
+			fail(ht, "Marshal: %v", err)
+		}
+		var back wrapped
+		if err := json.Unmarshal(b1, &back); err != nil {
+			fail(ht, "Unmarshal(%s): %v", b1, err)
+		}
+		b2, err := json.Marshal(back)
+		if err != nil {
+			fail(ht, "Marshal again: %v", err)
+		}
+		if string(b1) != string(b2) {
+			fail(ht, "JSON round trip changed the text\n first  %s\n second %s", b1, b2)
+		}
+		// the text carries the local wall clock in the layouts and the instant in the timestamps
+		wantText := fmt.Sprintf(`{"a":%q,"b":%q,"c":%q,"d":%q,"e":%q,"f":%q,"g":%q,"h":%q,"i":%d,"j":%d,"k":%d,"l":%s}`,
+			tm.Format(carbon.DateTimeLayout), tm.Format(carbon.DateTimeMilliLayout), tm.Format(carbon.DateTimeMicroLayout), tm.Format(carbon.DateTimeNanoLayout),
+			tm.Format(carbon.DateLayout), tm.Format(carbon.DateMilliLayout), tm.Format(carbon.TimeLayout), tm.Format(carbon.TimeNanoLayout),
+			tm.Unix(), tm.UnixMilli(), tm.UnixMicro(), map[bool]string{true: fmt.Sprint(tm.UnixNano()), false: "null"}[w.L != nil])
+		if string(b1) != wantText {
+			fail(ht, "Marshal = %s\n   want %s", b1, wantText)
+		}
+		if !back.I.StdTime().Equal(time.Unix(tm.Unix(), 0)) || !back.J.StdTime().Equal(time.UnixMilli(tm.UnixMilli())) || !back.K.StdTime().Equal(time.UnixMicro(tm.UnixMicro())) {
+			fail(ht, "timestamp wrappers read back %s %s %s", showCarbon(back.I.Carbon), showCarbon(back.J.Carbon), showCarbon(back.K.Carbon))
+		}
+		if back.I.Int64() != tm.Unix() || back.J.Int64() != tm.UnixMilli() || back.I.String() != fmt.Sprint(tm.Unix()) {
+			fail(ht, "timestamp wrappers Int64/String: %d %d %s", back.I.Int64(), back.J.Int64(), back.I.String())
+		}
+		if back.A.String() != tm.Format(carbon.DateTimeLayout) || back.E.String() != tm.Format(carbon.DateLayout) {
+			fail(ht, "layout wrappers String: %q %q", back.A.String(), back.E.String())
+		}
+		// sql: Value gives the time, Scan takes it back
+		v, err := w.D.Value()
+		if err != nil || !v.(time.Time).Equal(tm) {
+			fail(ht, "Value = %v, %v", v, err)
+		}
+		var scanned carbon.DateTimeNano
+		if err := scanned.Scan(tm); err != nil || !scanned.StdTime().Equal(tm) {
+			fail(ht, "Scan(time.Time) = %s, %v", showCarbon(scanned.Carbon), err)
+		}
+		var scanned2 carbon.Carbon
+		if err := scanned2.Scan(tm.Format(carbon.DateTimeNanoLayout)); err != nil || scanned2.ToDateTimeNanoString() != tm.Format(carbon.DateTimeNanoLayout) {
+			fail(ht, "Carbon.Scan(string) = %s, %v", showCarbon(&scanned2), err)
+		}
+		var scanned3 carbon.Timestamp
+		if err := scanned3.Scan(nil); err != nil || scanned3.Carbon != nil {
+			fail(ht, "Scan(nil) = %s, %v", showCarbon(scanned3.Carbon), err)
+		}
+		// a plain Carbon marshals with the default layout and reads back
+		bc, err := json.Marshal(c)
+		if err != nil || string(bc) != fmt.Sprintf("%q", tm.Format(carbon.DateTimeLayout)) {
+			fail(ht, "Marshal(Carbon) = %s, %v", bc, err)
+		}
+		var cb carbon.Carbon
+		if err := json.Unmarshal(bc, &cb); err != nil || cb.ToDateTimeString() != tm.Format(carbon.DateTimeLayout) {
+			fail(ht, "Unmarshal(%s) = %s, %v", bc, showCarbon(&cb), err)
+		}
+	})
+}
