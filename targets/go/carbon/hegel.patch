+package carbon_test
+
+// The narrow properties of the formatting families: each draws the shape of
+// one recorded bug every run (the ingredient forced, the surroundings
+// random; the classifier filters where a construction cannot be pure),
+// shares the judge, the model and the library calls of its wide property
+// (hegel_format_test.go), and so fails naming the bug every run by default;
+// under HEGEL_NO_KNOWN=1 it draws the region past the shape (hzShaped) and
+// passes. The collector's "shape carbon/N" and "filtered carbon/N" counters
+// measure the hit and rejection rates.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// outputsWhere is the output entries the predicate keeps.
+func outputsWhere(keep func(output) bool) []output {
+	var out []output
+	for _, o := range outputs {
+		if keep(o) {
+			out = append(out, o)
+		}
+	}
+	return out
+}
+
+var (
+	markedOutputs    = outputsWhere(func(o output) bool { return o.literalZ })
+	literalOutputs   = outputsWhere(func(o output) bool { return o.literalMarker })
+	timestampOutputs = outputsWhere(func(o output) bool { return o.timestamp })
+	plainOutputs     = outputsWhere(func(o output) bool { return !o.literalZ && !o.timestamp })
+)
+
+// evenOutputs: the entries evenly (the first weights lower, as in the tables
+// of hegel_moments_test.go).
+func evenOutputs(entries []output) hegel.Generator[output] {
+	weights := make([]int, len(entries))
+	for i := range weights {
+		weights[i] = 5
+	}
+	weights[0] = 2
+	if len(weights) > 1 {
+		weights[1] = 3
+	}
+	return weightedOver(weights, entries...)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/8: the outputs with a UTC marker are in UTC.
+
+// zuluCases: one of the six marked outputs on a moment outside UTC (under
+// HEGEL_NO_KNOWN=1 one of the five with a literal marker on a moment in UTC:
+// ToRfc7231String prints "UTC" there, an instance of the shape), no timezone
+// argument; the classifier keeps the cases whose local wall clock differs
+// from the UTC one (a Zulu output of a moment in UTC, or in London in
+// winter, prints the right text: filtered out).
+var zuluCases = regionOf("carbon/8", outputsExpected, hegel.Composite(func(tc hegel.TestCase) outputCase {
+	return outputCase{
+		m:  hegel.Draw(tc, hzShaped(moments, utcMoments)),
+		o:  hegel.Draw(tc, evenOutputs(hzShaped(markedOutputs, literalOutputs))),
+		tz: tagged[tzArg]{via: "tz none"},
+	}
+}))
+
+func TestHegelZuluOutputsAreUtc(t *testing.T) {
+	judged(t, zuluCases, judgeOutputs)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/10: the timestamp layouts and letters read back.
+
+// timestampCase is an output call with a timestamp layout read back by
+// ParseByLayout, or a Format with a timestamp letter read back by
+// ParseByFormat (one of the two per case).
+type timestampCase struct {
+	out *outputCase
+	rt  *roundTripCase
+}
+
+func (c timestampCase) GoString() string {
+	if c.out != nil {
+		return fmt.Sprintf("%#v", *c.out)
+	}
+	return fmt.Sprintf("%#v", *c.rt)
+}
+
+func timestampExpected(c timestampCase, k known) checks {
+	if c.out != nil {
+		return outputsExpected(*c.out, k)
+	}
+	return roundTripExpected(*c.rt, k)
+}
+
+func timestampActual(c timestampCase) checks {
+	if c.out != nil {
+		return outputsActual(*c.out)
+	}
+	return roundTripActual(*c.rt)
+}
+
+// timestampCases: a timestamp layout through Layout and ParseByLayout, or a
+// timestamp letter through Format and ParseByFormat, half each (weights 3
+// and 3 realise 49.5 and 50.5; 2 and 3 realised 38 and 62; a nanosecond-precision output or format
+// under HEGEL_NO_KNOWN=1); the cases
+// past a Go time limit (a nanosecond timestamp outside 1700-2200, a
+// sub-minute offset) are filtered out by the classifier.
+var timestampCases = regionOf("carbon/10", timestampExpected, hzWeighted(
+	hzW(3, hegel.Composite(func(tc hegel.TestCase) timestampCase {
+		c := outputCase{m: hegel.Draw(tc, moments), o: hegel.Draw(tc, evenOutputs(hzShaped(timestampOutputs, plainOutputs[:5]))), tz: tagged[tzArg]{via: "tz none"}}
+		return timestampCase{out: &c}
+	})),
+	hzW(3, hegel.Map(withinLimits(roundTripCasesOf(hzShaped(timestampRoundTrips, plainRoundTrips))), func(c roundTripCase) timestampCase { return timestampCase{rt: &c} })),
+))
+
+func TestHegelTimestampLayoutsReadBack(t *testing.T) {
+	judged(t, timestampCases, func(j *hzCaseJudge, c timestampCase) {
+		if c.out != nil {
+			tallyDrawn("output " + c.out.o.name)
+		} else {
+			tallyDrawn(c.rt.f.drawn...)
+		}
+		judgeBy(j, c, timestampExpected, timestampActual)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// carbon/13: the literals of a format are literal when parsing.
+
+// evenLiterals: the literals evenly (the first weights lower).
+func evenLiterals(ls []literal) hegel.Generator[literal] {
+	weights := make([]int, len(ls))
+	for i := range weights {
+		weights[i] = 5
+	}
+	weights[0], weights[1] = 2, 3
+	return weightedOver(weights, ls...)
+}
+
+// shapedTails: a shape literal after a space, appended after every field of
+// the format (one past the shape under HEGEL_NO_KNOWN=1), where the token it
+// spells is read after the field it stands for and overrides it.
+var shapedTails = hegel.Map(hzShaped(evenLiterals(shapeEscapes), evenLiterals(pastEscapes)), func(e literal) tagged[literal] {
+	return tagged[literal]{v: literal{" " + e.written, " " + e.rendered}, via: "forced " + e.written}
+})
+
+// literalCases: a round-trip format with today's separators, a four-digit
+// year (the two-digit one is not the matter here and meets a Go time limit
+// outside 1969-2068) and a shape literal at its end; the classifier keeps the cases the copied literal
+// misreads (a literal that reads what the field holds, "01" in January,
+// "PM" in the afternoon, parses right: filtered out).
+var literalCases = regionOf("carbon/13", roundTripExpected, withinLimits(roundTripCasesOf(plainRoundTripsWith(separators, separators, shapedTails, hegel.Just("Y")))))
+
+func TestHegelFormatLiteralsAreLiteralWhenParsing(t *testing.T) {
