+	out.set("DaysInYear", cb.DaysInYear())
+	out.set("Quarter", cb.Quarter())
+	out.set("Century", cb.Century())
+	out.set("Decade", cb.Decade())
+	out.set("IsLeapYear", cb.IsLeapYear())
+	out.set("IsLongYear", cb.IsLongYear())
+	out.set("WeekOfYear", cb.WeekOfYear())
+	out.set("DayOfWeek", cb.DayOfWeek())
+	out.set("Week", cb.Week())
+	out.set("WeekOfMonth", cb.WeekOfMonth())
+	out.set("WeekStartsAt", cb.WeekStartsAt())
+	out.set("WeekEndsAt", cb.WeekEndsAt())
+	out.set("Timestamp", cb.Timestamp())
+	out.set("TimestampMilli", cb.TimestampMilli())
+	out.set("TimestampMicro", cb.TimestampMicro())
+	if y := c.m.t.Year(); y >= 1700 && y <= 2200 {
+		out.set("TimestampNano", cb.TimestampNano())
+	}
+	out.set("ZoneName", cb.ZoneName())
+	out.set("ZoneOffset", cb.ZoneOffset())
+	out.set("Timezone", cb.Timezone())
+	out.set("IsDST", cb.IsDST())
+	out.set("IsAM", cb.IsAM())
+	out.set("IsPM", cb.IsPM())
+	out.set("IsWeekend", cb.IsWeekend())
+	out.set("IsWeekday", cb.IsWeekday())
+	months := []func() bool{cb.IsJanuary, cb.IsFebruary, cb.IsMarch, cb.IsApril, cb.IsMay, cb.IsJune, cb.IsJuly, cb.IsAugust, cb.IsSeptember, cb.IsOctober, cb.IsNovember, cb.IsDecember}
+	for i, f := range months {
+		out.set("Is"+englishMonths[i], f())
+	}
+	days := []func() bool{cb.IsSunday, cb.IsMonday, cb.IsTuesday, cb.IsWednesday, cb.IsThursday, cb.IsFriday, cb.IsSaturday}
+	for i, f := range days {
