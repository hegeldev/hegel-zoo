+// carbon/5: IsSagittarius starts on November 22.
+func TestHegelPinNovember22IsScorpioOnly(t *testing.T) {
+	d := carbon.CreateFromDate(2024, 11, 22, "UTC")
+	if d.Constellation() != "Scorpio" || !d.IsScorpio() {
+		t.Errorf("November 22: Constellation %q, IsScorpio %v", d.Constellation(), d.IsScorpio())
+	}
+	if d.IsSagittarius() {
+		t.Errorf("IsSagittarius(November 22) = true, but the sign is Scorpio")
+	}
+}
