+// carbon/13: format2layout copies literals into the Go layout unprotected.
+func TestHegelPinFormatLiteralsAreLiteralWhenParsing(t *testing.T) {
+	c := carbon.CreateFromDate(2024, 3, 9, "UTC")
+	s := c.Format("Y-m-d 1")
+	if s != "2024-03-09 1" {
+		t.Fatalf("Format(\"Y-m-d 1\") = %q", s)
+	}
+	if back := carbon.ParseByFormat(s, "Y-m-d 1", "UTC"); back == nil || back.HasError() || !back.Eq(c) {
+		t.Errorf("ParseByFormat(%q, \"Y-m-d 1\") = %s, want 2024-03-09", s, showCarbon(back))
+	}
+	c = carbon.CreateFromDateTime(2020, 8, 5, 13, 14, 15, "Asia/Shanghai")
+	f := "\\M\\S\\T Y-m-d H:i:s"
+	s = c.Format(f)
+	if s != "MST 2020-08-05 13:14:15" {
+		t.Fatalf("Format(%q) = %q", f, s)
+	}
+	if back := carbon.ParseByFormat(s, f, "Asia/Shanghai"); back == nil || back.HasError() || !back.Eq(c) {
+		t.Errorf("ParseByFormat(%q, %q) = %s, want %s", s, f, showCarbon(back), showCarbon(c))
+	}
+}
