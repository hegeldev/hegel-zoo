+type clockCase struct {
+	m    moment
+	unit clockUnit
+	k    tagged[int64]
+}
+
+func (c clockCase) GoString() string { return fmt.Sprintf("%#v +%d %ss", c.m, c.k.v, c.unit.name) }
+
+var clockCases = hegel.Composite(func(tc hegel.TestCase) clockCase {
+	m := hegel.Draw(tc, moments)
+	unit := hegel.Draw(tc, clockUnitList)
+	return clockCase{m: m, unit: unit, k: hegel.Draw(tc, clockAmountsOf(unit))}
+})
