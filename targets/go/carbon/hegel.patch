+func TestHegelOutputStringsParseBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		zoneName, loc := genZone(tc)
+		tm := genTime(tc, loc)
+		c := carbon.CreateFromStdTime(tm)
+		o := outputs[n(tc, 0, len(outputs)-1)]
+		note(ht, "%s %s", showTime(tm), o.name)
+		s := o.out(c)
+		if want := tm.Format(o.layout); s != want {
+			fail(ht, "%s = %q, want Format(%q) = %q", o.name, s, o.layout, want)
+		}
+		if o.twoDigitY && (tm.Year() < 1969 || tm.Year() > 2068) {
+			count(ht, "two-digit-year-out-of-range")
+			return
+		}
+		if o.abbrev && !alphaAbbrev(tm) {
+			count(ht, "abbreviation-not-alphabetic")
+			return
+		}
+		if _, off := tm.Zone(); off%60 != 0 {
+			count(ht, "sub-minute-offset")
+			return
+		}
+		if o.literalZ && !(tm.Location() == time.UTC) {
+			if Known.utcMarkerOnLocalTime {
+				count(ht, "known-carbon/8")
+				return
+			}
+		}
+		if o.precision < 0 {
+			// time-only layouts: the fields must read back
+			back := carbon.Parse(s, zoneName)
+			if back == nil || back.HasError() {
+				fail(ht, "Parse(%q) of %s failed: %s", s, o.name, showCarbon(back))
+			}
+			want, err := time.ParseInLocation(o.layout, s, loc)
+			if err != nil || !back.StdTime().Equal(want) {
+				fail(ht, "Parse(%q) of %s = %s, want %s (%v)", s, o.name, showCarbon(back), showTime(want), err)
+			}
+			return
+		}
+		want := truncTo(tm, o.precision)
+		if o.precision == 86400e9 {
+			want = startOfDay(tm)
+		}
+		if o.notDefault {
+			count(ht, "not-a-default-layout")
+		} else {
+			back := carbon.Parse(s, zoneName)
+			if back == nil || back.HasError() {
+				fail(ht, "Parse(%q) of %s failed: %s", s, o.name, showCarbon(back))
+			}
+			if !back.StdTime().Equal(want) {
+				fail(ht, "Parse(%q) of %s = %s, want %s", s, o.name, showCarbon(back), showTime(want))
+			}
+			if back.Timezone() != zoneName {
+				fail(ht, "Parse(%q) in %s reports zone %s", s, zoneName, back.Timezone())
+			}
+		}
+		// ParseByLayout with the exact layout agrees
+		back2 := carbon.ParseByLayout(s, o.layout, zoneName)
+		if back2 == nil || back2.HasError() || !back2.StdTime().Equal(want) {
+			fail(ht, "ParseByLayout(%q, %q) = %s, want %s", s, o.layout, showCarbon(back2), showTime(want))
+		}
+	})
+}
