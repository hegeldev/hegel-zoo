+// ---------------------------------------------------------------------------
+// Creators and the wrapper types.
+
+type creatorCase struct {
+	m      moment
+	m2, d2 int // out-of-range month and day for the normalising creator
+}
+
+func (c creatorCase) GoString() string { return fmt.Sprintf("%#v month %d day %d", c.m, c.m2, c.d2) }
+
+var creatorCases = hegel.Composite(func(tc hegel.TestCase) creatorCase {
+	return creatorCase{m: hegel.Draw(tc, moments), m2: hegel.Draw(tc, hzInts(-5, 20)), d2: hegel.Draw(tc, hzInts(-40, 70))}
+})
+
+// creatorsExpected: every creator makes the instant of its arguments in the
+// named zone (the timestamps at their precision, the date creators at
+// midnight), out-of-range fields normalise like time.Date, Parse reads the
+// canonical strings, bad inputs are errors or empty, and the constants are
+// what they say.
+func creatorsExpected(c creatorCase, _ known) checks {
+	m := c.m
+	tm := m.t
+	loc := tm.Location()
+	y, mo, d := tm.Date()
+	h, mi, s := tm.Clock()
+	ns := tm.Nanosecond()
+	out := checks{}
+	at := func(name string, t time.Time) { out[name] = stampTime(t.In(loc)) }
+	at("CreateFromStdTime", tm)
+	at("CreateFromStdTime(tz)", tm)
+	at("NewCarbon", tm)
+	at("CreateFromTimestamp", time.Unix(tm.Unix(), 0))
+	at("CreateFromTimestampMilli", time.UnixMilli(tm.UnixMilli()))
+	at("CreateFromTimestampMicro", time.UnixMicro(tm.UnixMicro()))
+	if y >= 1700 && y <= 2200 {
+		at("CreateFromTimestampNano", tm)
+	}
+	at("CreateFromDateTime", time.Date(y, mo, d, h, mi, s, 0, loc))
+	at("CreateFromDateTimeMilli", time.Date(y, mo, d, h, mi, s, ns/1e6*1e6, loc))
+	at("CreateFromDateTimeMicro", time.Date(y, mo, d, h, mi, s, ns/1e3*1e3, loc))
+	at("CreateFromDateTimeNano", tm)
+	at("CreateFromDate", time.Date(y, mo, d, 0, 0, 0, 0, loc))
+	at("CreateFromDateMilli", time.Date(y, mo, d, 0, 0, 0, ns/1e6*1e6, loc))
+	at("CreateFromDateMicro", time.Date(y, mo, d, 0, 0, 0, ns/1e3*1e3, loc))
+	at("CreateFromDateNano", time.Date(y, mo, d, 0, 0, 0, ns, loc))
+	at("CreateFromDate(normalised)", time.Date(y, time.Month(c.m2), c.d2, 0, 0, 0, 0, loc))
+	at("Parse(ToDateTimeNanoString)", tm)
+	at("Parse(ToDateString)", startOfDay(tm))
+	if _, off := tm.Zone(); off%60 == 0 {
+		at("Parse(RFC3339Nano)", tm)
+	}
+	out["CreateFromDate(bad zone)"] = "error"
+	out["Parse(garbage)"] = "error"
+	out["Parse(empty)"] = "<empty>"
+	out["MinValue"] = stampTime(time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC)) + " zero"
+	out["ZeroValue"] = "zero"
+	out["MaxValue"] = stampTime(time.Date(9999, 12, 31, 23, 59, 59, 999999999, time.UTC))
+	out["EpochValue"] = "epoch 0"
+	return out
+}
+
+func creatorsActual(c creatorCase) checks {
+	tm, zoneName := c.m.t, c.m.zone
+	y, mo, d := tm.Date()
+	h, mi, s := tm.Clock()
+	ns := tm.Nanosecond()
+	out := checks{}
+	got := func(name string, r *carbon.Carbon) { out[name] = stamp(r) }
+	got("CreateFromStdTime", carbon.CreateFromStdTime(tm))
+	got("CreateFromStdTime(tz)", carbon.CreateFromStdTime(tm.UTC(), zoneName))
+	got("NewCarbon", carbon.NewCarbon(tm))
+	got("CreateFromTimestamp", carbon.CreateFromTimestamp(tm.Unix(), zoneName))
+	got("CreateFromTimestampMilli", carbon.CreateFromTimestampMilli(tm.UnixMilli(), zoneName))
+	got("CreateFromTimestampMicro", carbon.CreateFromTimestampMicro(tm.UnixMicro(), zoneName))
+	if y >= 1700 && y <= 2200 {
+		got("CreateFromTimestampNano", carbon.CreateFromTimestampNano(tm.UnixNano(), zoneName))
+	}
+	got("CreateFromDateTime", carbon.CreateFromDateTime(y, int(mo), d, h, mi, s, zoneName))
+	got("CreateFromDateTimeMilli", carbon.CreateFromDateTimeMilli(y, int(mo), d, h, mi, s, ns/1e6, zoneName))
+	got("CreateFromDateTimeMicro", carbon.CreateFromDateTimeMicro(y, int(mo), d, h, mi, s, ns/1e3, zoneName))
+	got("CreateFromDateTimeNano", carbon.CreateFromDateTimeNano(y, int(mo), d, h, mi, s, ns, zoneName))
+	got("CreateFromDate", carbon.CreateFromDate(y, int(mo), d, zoneName))
+	got("CreateFromDateMilli", carbon.CreateFromDateMilli(y, int(mo), d, ns/1e6, zoneName))
+	got("CreateFromDateMicro", carbon.CreateFromDateMicro(y, int(mo), d, ns/1e3, zoneName))
+	got("CreateFromDateNano", carbon.CreateFromDateNano(y, int(mo), d, ns, zoneName))
+	got("CreateFromDate(normalised)", carbon.CreateFromDate(y, c.m2, c.d2, zoneName))
+	got("Parse(ToDateTimeNanoString)", carbon.Parse(tm.Format(carbon.DateTimeNanoLayout), zoneName))
+	got("Parse(ToDateString)", carbon.Parse(tm.Format(carbon.DateLayout), zoneName))
+	if _, off := tm.Zone(); off%60 == 0 {
+		got("Parse(RFC3339Nano)", carbon.Parse(tm.Format(time.RFC3339Nano), zoneName))
+	}
+	bad := carbon.CreateFromDate(y, int(mo), d, "Nowhere/Land")
+	out["CreateFromDate(bad zone)"] = stamp(bad)
+	if bad != nil && bad.IsValid() {
+		out["CreateFromDate(bad zone)"] = "valid"
+	}
+	garbage := carbon.Parse("not a date", zoneName)
+	out["Parse(garbage)"] = stamp(garbage)
+	if garbage != nil && garbage.IsValid() {
+		out["Parse(garbage)"] = "valid"
+	}
+	empty := carbon.Parse("", zoneName)
+	out["Parse(empty)"] = stamp(empty)
+	if empty != nil && (empty.IsValid() || empty.HasError()) {
+		out["Parse(empty)"] = "valid"
+	}
+	out["MinValue"] = stamp(carbon.MinValue()) + map[bool]string{true: " zero", false: " not zero"}[carbon.MinValue().IsZero()]
+	out["ZeroValue"] = map[bool]string{true: "zero", false: "not zero"}[carbon.ZeroValue().IsZero()]
+	out["MaxValue"] = stamp(carbon.MaxValue())
+	out["EpochValue"] = fmt.Sprintf("%s %d", map[bool]string{true: "epoch", false: "not epoch"}[carbon.EpochValue().IsEpoch()], carbon.EpochValue().Timestamp())
+	return out
+}
+
+func TestHegelCreatorsAgreeWithTime(t *testing.T) {
+	judged(t, creatorCases, func(j *hzCaseJudge, c creatorCase) {
+		tallyDrawn(c.m.drawn...)
+		judgeBy(j, c, creatorsExpected, creatorsActual)
+	})
+}
+
+type wrapped struct {
+	A *carbon.DateTime       `json:"a"`
+	B *carbon.DateTimeMilli  `json:"b"`
+	C *carbon.DateTimeMicro  `json:"c"`
+	D *carbon.DateTimeNano   `json:"d"`
+	E *carbon.Date           `json:"e"`
+	F *carbon.DateMilli      `json:"f"`
+	G *carbon.Time           `json:"g"`
+	H *carbon.TimeNano       `json:"h"`
+	I *carbon.Timestamp      `json:"i"`
+	J *carbon.TimestampMilli `json:"j"`
+	K *carbon.TimestampMicro `json:"k"`
+	L *carbon.TimestampNano  `json:"l"`
+}
+
+// wrapperLayouts are the layout wrappers of the wrapped struct in field order.
+var wrapperLayouts = []string{carbon.DateTimeLayout, carbon.DateTimeMilliLayout, carbon.DateTimeMicroLayout, carbon.DateTimeNanoLayout, carbon.DateLayout, carbon.DateMilliLayout, carbon.TimeLayout, carbon.TimeNanoLayout}
+
+// readBack is the JSON a layout wrapper prints after its text was read back:
+// the text is parsed in the default zone (UTC), and a wrapper holding the zero
+// instant marshals as null (so the first day of year 1 reads back as null in
+// every zone); otherwise the same text.
+func readBack(layout, text string) string {
+	if t, err := time.ParseInLocation(layout, text, time.UTC); err == nil && t.IsZero() {
+		return "null"
+	}
+	return fmt.Sprintf("%q", text)
+}
+
+// wrappersExpected: the wrapper types marshal the local wall clock in their
+// layouts and the instant in the timestamps, read back to the same text
+// (readBack) and the same instants at their precision; Value gives the time
+// and Scan takes it back; a plain Carbon marshals with the default layout and
+// reads back.
+func wrappersExpected(m moment, _ known) checks {
+	tm := m.t
+	out := checks{}
+	nano := "null"
+	if tm.Year() >= 1700 && tm.Year() <= 2200 {
+		nano = fmt.Sprint(tm.UnixNano())
+	}
+	texts := make([]string, len(wrapperLayouts))
+	first, again := make([]string, len(wrapperLayouts)), make([]string, len(wrapperLayouts))
+	for i, layout := range wrapperLayouts {
+		texts[i] = tm.Format(layout)
+		first[i] = fmt.Sprintf("%q", texts[i])
+		again[i] = readBack(layout, texts[i])
+	}
+	stamps := fmt.Sprintf(`"i":%d,"j":%d,"k":%d,"l":%s}`, tm.Unix(), tm.UnixMilli(), tm.UnixMicro(), nano)
+	out["Marshal"] = fmt.Sprintf(`{"a":%s,"b":%s,"c":%s,"d":%s,"e":%s,"f":%s,"g":%s,"h":%s,`, first[0], first[1], first[2], first[3], first[4], first[5], first[6], first[7]) + stamps
+	out["Marshal again"] = fmt.Sprintf(`{"a":%s,"b":%s,"c":%s,"d":%s,"e":%s,"f":%s,"g":%s,"h":%s,`, again[0], again[1], again[2], again[3], again[4], again[5], again[6], again[7]) + stamps
+	out["Timestamp read back"] = stampInstant(time.Unix(tm.Unix(), 0))
+	out["TimestampMilli read back"] = stampInstant(time.UnixMilli(tm.UnixMilli()))
+	out["TimestampMicro read back"] = stampInstant(time.UnixMicro(tm.UnixMicro()))
+	out["Timestamp Int64"] = fmt.Sprintf("%d %d %d", tm.Unix(), tm.UnixMilli(), tm.Unix())
+	strA, strE := texts[0], texts[4]
+	if again[0] == "null" {
+		strA = ""
+	}
+	if again[4] == "null" {
+		strE = ""
+	}
+	out["layout wrappers String"] = strA + " " + strE
+	out["Value"] = stampInstant(tm)
+	out["Scan(time.Time)"] = stampInstant(tm)
+	out["Carbon.Scan(string)"] = tm.Format(carbon.DateTimeNanoLayout)
+	out["Scan(nil)"] = "nil"
+	out["Marshal(Carbon)"] = fmt.Sprintf("%q", tm.Format(carbon.DateTimeLayout))
+	out["Unmarshal(Carbon)"] = tm.Format(carbon.DateTimeLayout)
+	return out
+}
+
+func wrappersActual(m moment) checks {
+	tm := m.t
+	cb := carbonOf(m)
+	out := checks{}
+	w := wrapped{
+		A: carbon.NewDateTime(cb), B: carbon.NewDateTimeMilli(cb), C: carbon.NewDateTimeMicro(cb), D: carbon.NewDateTimeNano(cb),
+		E: carbon.NewDate(cb), F: carbon.NewDateMilli(cb), G: carbon.NewTime(cb), H: carbon.NewTimeNano(cb),
+		I: carbon.NewTimestamp(cb), J: carbon.NewTimestampMilli(cb), K: carbon.NewTimestampMicro(cb), L: carbon.NewTimestampNano(cb),
+	}
+	if tm.Year() < 1700 || tm.Year() > 2200 {
+		w.L = nil
+	}
+	b1, err := json.Marshal(w)
+	if err != nil {
+		out["Marshal"] = "error " + err.Error()
+		return out
+	}
+	out["Marshal"] = string(b1)
+	var back wrapped
+	if err := json.Unmarshal(b1, &back); err != nil {
+		out["Marshal again"] = "unmarshal error " + err.Error()
+		return out
+	}
+	b2, err := json.Marshal(back)
+	if err != nil {
+		out["Marshal again"] = "error " + err.Error()
+		return out
+	}
+	out["Marshal again"] = string(b2)
+	out["Timestamp read back"] = stampInstant(back.I.StdTime())
+	out["TimestampMilli read back"] = stampInstant(back.J.StdTime())
+	out["TimestampMicro read back"] = stampInstant(back.K.StdTime())
+	out["Timestamp Int64"] = fmt.Sprintf("%d %d %s", back.I.Int64(), back.J.Int64(), back.I.String())
+	out["layout wrappers String"] = back.A.String() + " " + back.E.String()
+	if v, err := w.D.Value(); err != nil {
+		out["Value"] = "error " + err.Error()
+	} else if t, ok := v.(time.Time); ok {
+		out["Value"] = stampInstant(t)
+	} else {
+		out["Value"] = fmt.Sprintf("%T", v)
+	}
+	var scanned carbon.DateTimeNano
+	if err := scanned.Scan(tm); err != nil {
+		out["Scan(time.Time)"] = "error " + err.Error()
+	} else {
+		out["Scan(time.Time)"] = stampInstant(scanned.StdTime())
+	}
+	var scanned2 carbon.Carbon
+	if err := scanned2.Scan(tm.Format(carbon.DateTimeNanoLayout)); err != nil {
+		out["Carbon.Scan(string)"] = "error " + err.Error()
+	} else {
+		out["Carbon.Scan(string)"] = scanned2.ToDateTimeNanoString()
+	}
+	var scanned3 carbon.Timestamp
+	if err := scanned3.Scan(nil); err != nil {
+		out["Scan(nil)"] = "error " + err.Error()
+	} else if scanned3.Carbon != nil {
+		out["Scan(nil)"] = stamp(scanned3.Carbon)
+	} else {
+		out["Scan(nil)"] = "nil"
+	}
+	bc, err := json.Marshal(cb)
+	if err != nil {
+		out["Marshal(Carbon)"] = "error " + err.Error()
+	} else {
+		out["Marshal(Carbon)"] = string(bc)
+	}
+	var cbk carbon.Carbon
+	if err := json.Unmarshal(bc, &cbk); err != nil {
+		out["Unmarshal(Carbon)"] = "error " + err.Error()
+	} else {
+		out["Unmarshal(Carbon)"] = cbk.ToDateTimeString()
+	}
+	return out
+}
+
+func TestHegelWrapperTypesRoundTrip(t *testing.T) {
+	judged(t, moments, func(j *hzCaseJudge, m moment) {
+		tallyDrawn(m.drawn...)
+		// The wrappers marshal the zero time as null by design; the round trip is of a value.
+		if m.t.IsZero() {
+			hzTally("zero time skipped")
+		}
+		j.ht.Assume(!m.t.IsZero())
+		judgeBy(j, m, wrappersExpected, wrappersActual)
+	})
+}
