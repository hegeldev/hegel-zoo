+// genDuration draws a Go duration string and its value.
+func genDuration(tc hegel.TestCase) (string, time.Duration, bool) {
+	if chance(tc, 10) {
+		return pick(tc, "", "bogus", "1x", "h", "1.5", "--1h", "1h1"), 0, false
+	}
+	var parts []string
+	var total time.Duration
+	for i, k := 0, n(tc, 1, 3); i < k; i++ {
+		v := n(tc, 0, 5000)
+		u := pick(tc, "h", "m", "s", "ms", "us", "ns")
+		mult := map[string]time.Duration{"h": time.Hour, "m": time.Minute, "s": time.Second, "ms": time.Millisecond, "us": time.Microsecond, "ns": time.Nanosecond}[u]
+		parts = append(parts, fmt.Sprintf("%d%s", v, u))
+		total += time.Duration(v) * mult
+	}
+	s := strings.Join(parts, "")
+	if chance(tc, 30) {
+		s = "-" + s
+		total = -total
+	}
+	if chance(tc, 15) {
+		s = pick(tc, "1.5h", "0.25s", "2.5ms", "1h30m", "-0.5m")
+		total, _ = time.ParseDuration(s)
+	}
+	return s, total, true
+}
