+}
+
+var zeroMethods = map[string]zeroMethod{
+	"StartOfDay":          {func(c *carbon.Carbon) any { return c.StartOfDay() }, stampTime(zeroTime), "panic"},
+	"EndOfDay":            {func(c *carbon.Carbon) any { return c.EndOfDay() }, stampZeroDate(1, 1, 23, 59, 59, 999999999), "panic"},
+	"StartOfWeek":         {func(c *carbon.Carbon) any { return c.StartOfWeek() }, stampTime(zeroTime), "panic"},
+	"StartOfMonth":        {func(c *carbon.Carbon) any { return c.StartOfMonth() }, stampTime(zeroTime), "panic"},
+	"EndOfMonth":          {func(c *carbon.Carbon) any { return c.EndOfMonth() }, stampZeroDate(1, 31, 23, 59, 59, 999999999), "panic"},
+	"StartOfQuarter":      {func(c *carbon.Carbon) any { return c.StartOfQuarter() }, stampTime(zeroTime), "panic"},
+	"StartOfYear":         {func(c *carbon.Carbon) any { return c.StartOfYear() }, stampTime(zeroTime), "panic"},
+	"EndOfYear":           {func(c *carbon.Carbon) any { return c.EndOfYear() }, stampZeroDate(12, 31, 23, 59, 59, 999999999), "panic"},
+	"SetYear":             {func(c *carbon.Carbon) any { return c.SetYear(2020) }, stampTime(time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)), "panic"},
+	"SetMonth":            {func(c *carbon.Carbon) any { return c.SetMonth(2) }, stampZeroDate(2, 1, 0, 0, 0, 0), "panic"},
+	"SetDay":              {func(c *carbon.Carbon) any { return c.SetDay(2) }, stampZeroDate(1, 2, 0, 0, 0, 0), "panic"},
+	"SetHour":             {func(c *carbon.Carbon) any { return c.SetHour(1) }, stampZeroDate(1, 1, 1, 0, 0, 0), "panic"},
+	"SetDate":             {func(c *carbon.Carbon) any { return c.SetDate(2020, 1, 1) }, stampTime(time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)), "panic"},
+	"SetTime":             {func(c *carbon.Carbon) any { return c.SetTime(1, 2, 3) }, stampZeroDate(1, 1, 1, 2, 3, 0), "panic"},
+	"AddMonthsNoOverflow": {func(c *carbon.Carbon) any { return c.AddMonthsNoOverflow(1) }, stampZeroDate(2, 1, 0, 0, 0, 0), "panic"},
+	"AddYearsNoOverflow":  {func(c *carbon.Carbon) any { return c.AddYearsNoOverflow(1) }, stampTime(time.Date(2, 1, 1, 0, 0, 0, 0, time.UTC)), "panic"},
+	"IsLongYear":          {func(c *carbon.Carbon) any { return c.IsLongYear() }, modelIsLongYear(1), "panic"},
+	"DaysInMonth":         {func(c *carbon.Carbon) any { return c.DaysInMonth() }, 31, "panic"},
+	"WeekOfMonth":         {func(c *carbon.Carbon) any { return c.WeekOfMonth() }, modelWeekOfMonth(zeroTime, time.Monday), "panic"},
+	"WeekStartsAt":        {func(c *carbon.Carbon) any { return c.WeekStartsAt() }, time.Monday, time.Sunday.String()},
+	"DayOfWeek":           {func(c *carbon.Carbon) any { return c.DayOfWeek() }, modelDayOfWeek(zeroTime, time.Monday), fmt.Sprint(modelDayOfWeek(zeroTime, time.Sunday))},
