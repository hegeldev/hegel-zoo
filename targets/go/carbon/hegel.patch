+func TestHegelDiffInYearsAndMonthsBracketTheEnd(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		loc := tm.Location()
+		if chance(tc, 30) {
+			_, loc = genZone(tc)
+		}
+		var t2 time.Time
+		if chance(tc, 50) {
+			t2 = genTime(tc, loc)
+		} else {
+			t2 = tm.AddDate(n(tc, -80, 80), n(tc, -30, 30), n(tc, -40, 40)).Add(time.Duration(n(tc, -100000, 100000)) * time.Second).In(loc)
+		}
+		c2 := carbon.CreateFromStdTime(t2)
+		note(ht, "%s -> %s", showTime(tm), showTime(t2))
+		if loc != tm.Location() && Known.diffLocalFieldsPerZone {
+			count(ht, "known-carbon/4")
+			return
+		}
+		years, months := c.DiffInYears(c2), c.DiffInMonths(c2)
+		bracket(ht, "DiffInYears", tm, t2, years, func(t time.Time, k int) time.Time { return t.AddDate(k, 0, 0) })
+		s, e := tm, t2
+		if t2.Before(tm) {
+			s, e = t2, tm
+		}
+		if s.Day() >= 29 && e.Day() <= 3 && Known.diffMonthsCorrectsOnce {
+			count(ht, "known-carbon/30")
+		} else {
+			bracket(ht, "DiffInMonths", tm, t2, months, func(t time.Time, k int) time.Time { return t.AddDate(0, k, 0) })
+		}
+		if c2.DiffInYears(c) != -years || c2.DiffInMonths(c) != -months {
+			fail(ht, "not antisymmetric: %d/%d forward, %d/%d back", years, months, c2.DiffInYears(c), c2.DiffInMonths(c))
+		}
+		if c.DiffAbsInYears(c2) != abs64(years) || c.DiffAbsInMonths(c2) != abs64(months) {
+			fail(ht, "DiffAbsInYears/Months = %d/%d, want %d/%d", c.DiffAbsInYears(c2), c.DiffAbsInMonths(c2), abs64(years), abs64(months))
+		}
+	})
+}
+
+func abs64(x int64) int64 {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
