+func TestHegelComparisonsAgreeWithInstants(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		gen := func() (*carbon.Carbon, time.Time) {
+			var t2 time.Time
+			switch n(tc, 1, 4) {
+			case 1:
+				_, loc := genZone(tc)
+				t2 = tm.In(loc)
+			case 2:
+				t2 = genNear(tc, tm)
+			case 3:
+				_, loc := genZone(tc)
+				t2 = genTime(tc, loc)
+			default:
+				t2 = tm.Add(time.Duration(pick(tc, 1, -1, 1000, -1000, 1e9, -1e9)))
+			}
+			return carbon.CreateFromStdTime(t2), t2
+		}
+		c2, t2 := gen()
+		c3, t3 := gen()
+		note(ht, "%s | %s | %s", showTime(tm), showTime(t2), showTime(t3))
+		check := func(what string, got, want bool) {
+			if got != want {
+				fail(ht, "%s = %v, want %v\n a %s\n b %s\n c %s", what, got, want, showTime(tm), showTime(t2), showTime(t3))
+			}
+		}
+		check("Eq", c.Eq(c2), tm.Equal(t2))
+		check("Ne", c.Ne(c2), !tm.Equal(t2))
+		check("Gt", c.Gt(c2), tm.After(t2))
+		check("Lt", c.Lt(c2), tm.Before(t2))
+		check("Gte", c.Gte(c2), !tm.Before(t2))
+		check("Lte", c.Lte(c2), !tm.After(t2))
+		check(`Compare("=")`, c.Compare("=", c2), tm.Equal(t2))
+		check(`Compare("<>")`, c.Compare("<>", c2), !tm.Equal(t2))
+		check(`Compare("!=")`, c.Compare("!=", c2), !tm.Equal(t2))
+		check(`Compare(">")`, c.Compare(">", c2), tm.After(t2))
+		check(`Compare(">=")`, c.Compare(">=", c2), !tm.Before(t2))
+		check(`Compare("<")`, c.Compare("<", c2), tm.Before(t2))
+		check(`Compare("<=")`, c.Compare("<=", c2), !tm.After(t2))
+		check(`Compare("?")`, c.Compare("?", c2), false)
+		ordered := !t2.After(t3)
+		check("Between", c.Between(c2, c3), ordered && tm.After(t2) && tm.Before(t3))
+		if Known.zeroTimeIsBetweenAnything && (tm.IsZero() || t2.IsZero() || t3.IsZero()) {
+			count(ht, "known-carbon/28")
+			return
+		}
+		check("BetweenIncludedStart", c.BetweenIncludedStart(c2, c3), ordered && !tm.Before(t2) && tm.Before(t3))
+		check("BetweenIncludedEnd", c.BetweenIncludedEnd(c2, c3), ordered && tm.After(t2) && !tm.After(t3))
+		check("BetweenIncludedBoth", c.BetweenIncludedBoth(c2, c3), ordered && !tm.Before(t2) && !tm.After(t3))
+		if t2.Location() == tm.Location() {
+			a, b := tm, t2
+			check("IsSameCentury", c.IsSameCentury(c2), a.Year()/100 == b.Year()/100)
+			check("IsSameDecade", c.IsSameDecade(c2), a.Year()%100/10 == b.Year()%100/10)
+			check("IsSameYear", c.IsSameYear(c2), a.Year() == b.Year())
+			check("IsSameQuarter", c.IsSameQuarter(c2), a.Year() == b.Year() && modelQuarter(a.Month()) == modelQuarter(b.Month()))
+			check("IsSameMonth", c.IsSameMonth(c2), a.Year() == b.Year() && a.Month() == b.Month())
+			check("IsSameDay", c.IsSameDay(c2), a.Format("2006-01-02") == b.Format("2006-01-02"))
+			check("IsSameHour", c.IsSameHour(c2), a.Format("2006-01-02 15") == b.Format("2006-01-02 15"))
+			check("IsSameMinute", c.IsSameMinute(c2), a.Format("2006-01-02 15:04") == b.Format("2006-01-02 15:04"))
+			check("IsSameSecond", c.IsSameSecond(c2), a.Format("2006-01-02 15:04:05") == b.Format("2006-01-02 15:04:05"))
+		}
+	})
+}
