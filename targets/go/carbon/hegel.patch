+	add("SubWeeks", tm.AddDate(0, 0, -7*k))
+	add("AddDays", tm.AddDate(0, 0, k))
+	add("SubDays", tm.AddDate(0, 0, -k))
+	add("AddYear", tm.AddDate(1, 0, 0))
+	add("SubYear", tm.AddDate(-1, 0, 0))
+	add("AddYearNoOverflow", modelAddMonthsNoOverflow(tm, 12))
+	add("AddQuarter", tm.AddDate(0, 3, 0))
+	add("AddMonth", tm.AddDate(0, 1, 0))
+	add("SubMonth", tm.AddDate(0, -1, 0))
