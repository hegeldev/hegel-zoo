+// ---------------------------------------------------------------------------
+// Persian.
+
+type persianCase struct {
+	m      moment
+	locale tagged[string]
+}
+
+func (c persianCase) GoString() string { return fmt.Sprintf("%#v locale=%s", c.m, c.locale.v) }
+
+// persianLocales: en or fa, half each (50/50 nominal: weights 2 and 4 realise
+// 49.1/50.9 in the wide property, 51.7/48.3 in the narrow ones; 2 and 3
+// realised 54.3/45.7).
+var persianLocales = localesOf("en", "fa", 2, 4)
+
+// persianLocalesFor: the locale of a moment: en on a Sunday under
+// HEGEL_NO_KNOWN=1 (fa on a Sunday is the shape of carbon/26).
+func persianLocalesFor(m moment) hegel.Generator[tagged[string]] {
+	if hzNoKnown && m.t.Weekday() == time.Sunday {
+		return via("locale en", hegel.Just("en"))
+	}
+	return persianLocales
+}
+
+// gapDay is a calendar day of a zone that begins with a DST gap: its
+// midnight does not exist, and time.Date of it is 23:00 (or later) of the
+// day before, the shape of carbon/31.
+type gapDay struct {
+	zone string
+	y    int
+	m    time.Month
+	d    int
+}
+
+// gapDays: the gap days of the thirteen zones from 1800 to 2100, found once
+// at init by scanning every day of every zone (1.4 million time.Date calls,
+// 120 ms): 54 with Go's bundled zone data - Sao Paulo 45 (its summer time
+// began at 00:00 from 1931 to 2018, and 1914-01-01 moved from LMT), St John's
+// 8 (1935-03-30's 52-second move and the summer times of 1936-1942 at 00:00),
+// London 1 (1847-12-01, 75 seconds from LMT to GMT); no other zone has one,
+// so the ordinary moments hold such a day about once in 3000 draws. The list
+// is data of the test: the narrow property draws from it and the wide one a
+// few percent of the time.
+var gapDays = func() []gapDay {
+	var days []gapDay
+	for _, zone := range zoneNames {
+		loc := zones[zone]
+		for y := 1800; y <= 2100; y++ {
+			for m := time.January; m <= time.December; m++ {
+				for d := 1; d <= daysIn(y, m); d++ {
+					if time.Date(y, m, d, 0, 0, 0, 0, loc).Day() != d {
+						days = append(days, gapDay{zone: zone, y: y, m: m, d: d})
+					}
+				}
+			}
+		}
+	}
+	if len(days) == 0 {
+		panic("gapDays: no day of the thirteen zones begins with a DST gap")
+	}
+	return days
+}()
+
+// gapDayMomentsAt: a moment of a gap day moved by shift days (0: the gap day
+// itself; 1: the day after, whose midnight exists), in the day's own zone,
+// with the clock and nanosecond mix. A clock inside the gap itself (the
+// first hour of Sao Paulo's gap days) is moved by Go to the day before and
+// so misses the shape: the narrow property's classifier filters it out, the
+// wide property counts it as an ordinary moment.
+func gapDayMomentsAt(shift int) hegel.Generator[moment] {
+	return hegel.Composite(func(tc hegel.TestCase) moment {
+		g := hegel.Draw(tc, hegel.SampledFrom(gapDays))
+		c := hegel.Draw(tc, clocks)
+		ns := hegel.Draw(tc, nanos)
+		return moment{
+			zone:  g.zone,
+			t:     time.Date(g.y, g.m, g.d+shift, c.v.h, c.v.mi, c.v.s, ns.v, zones[g.zone]),
+			drawn: []string{"gap day " + g.zone, c.via, ns.via},
+		}
+	})
+}
+
+var gapDayMoments = gapDayMomentsAt(0)
+
+// persianMoments: the moments, or a moment of a gap day (the shape of
+// carbon/31, too rare in the moments to be drawn by chance; never under
+// HEGEL_NO_KNOWN=1). Of the gap-day draws about seven in ten are named
+// carbon/31: the rest are Sundays with the Farsi locale (named carbon/26
+// first; 31 of Sao Paulo's 45 gap days are Sundays) and clocks inside the
+// gap.
+var persianMoments = hzWeighted(
+	hzW(97, moments), // 97 nominal: realises 97.5
+	hzW(hzUnless(hzNoKnown, 3), gapDayMoments), // 3 nominal: weight 3 realises 2.5 (76 of 3000 draws, 53 of them named carbon/31)
+)
+
+// persianCases: a moment and a locale; under HEGEL_NO_KNOWN=1 the dates of
+// carbon/18 (2025-03-20 to 2026-03-20), 19 (621-03-22 to 1095-03-20), 22
+// (before 1582-10-15) and 31 (a day beginning with a DST gap) are filtered
+// out by the classifier.
+var persianCases = withoutShapes(persianExpected, persianCasesFrom(persianMoments))
+
+func persianValue(y, m, d int, ok bool) string {
+	if !ok {
+		return "invalid"
+	}
+	return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
+}
+
+func persianLibValue(p *persian.Persian) string {
+	if p == nil || !p.IsValid() {
+		return "invalid"
+	}
+	return p.String()
+}
+
+// persianDayOf is the calendar day the Persian package reads for the day
+// (y, m, d) of loc: the day itself or, under carbon/31, the date of
+// time.Date(y, m, d, 0, 0, 0, 0, loc), the day's local midnight FromStdTime
+// hands to julian.FromStdTime (persian.go:49), which Go places at the last
+// instant before the gap, on the day before, where the day begins with a
+// DST gap (computed, as Go computes it; everywhere else the day itself).
+func persianDayOf(y int, m time.Month, d int, loc *time.Location, k known) (int, time.Month, int) {
+	if k[kPersianMidnightInGap] {
+		return time.Date(y, m, d, 0, 0, 0, 0, loc).Date()
+	}
+	return y, m, d
+}
+
+// persianGregorianDate is the date ToGregorian(zone) prints for a day
+// number: the day itself or, under carbon/31, the date of its local
+// midnight built with time.Date (persian.go:80), the day before where the
+// day begins with a DST gap in loc.
+func persianGregorianDate(jdn int, loc *time.Location, k known) string {
+	t := jdnTime(jdn)
+	y, m, d := persianDayOf(t.Year(), t.Month(), t.Day(), loc, k)
+	return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
+}
+
+// persianExpected: FromStdTime and Persian() read the day's number (of the
+// day the package reads, persianDayOf: the day before under carbon/31 where
+// the day begins with a DST gap; proleptic, or by the historical rule of
+// carbon/22) through the cycle (floor division with the official deviation
+// of 1403/1404; the cycle alone under carbon/18; the library's integer
+// arithmetic under carbon/19: persianFromJDN), the library's own result
+// read back (the round trip), and the documented date constructed with
+// NewPersian: its validity, the conversion back in the zone (the date of
+// the day's local midnight under 31, persianGregorianDate) and in the
+// default zone (UTC, where no day begins with a gap), the leap year, the
+// month's length, the Nowruz of its year where the official table has it
+// (in the zone, under 31 likewise), and its names in the locale, the
+// weekday that of the library's Gregorian date in UTC (persian.go:143, so
+// shifted with 18 and 19) and Sunday's Farsi name the table's misspelling
+// under carbon/26 (persian.go:26).
+func persianExpected(c persianCase, k known) checks {
+	tm, loc := c.m.t, c.locale.v
+	gy, gm, gd := tm.Date()
+	out := checks{}
+	ry, rm, rd := persianDayOf(gy, gm, gd, tm.Location(), k)
+	jdn := gregJDN(ry, int(rm), rd)
+	if k[kPersianPreReformIsJulian] {
+		jdn = libHistoricalJDN(ry, int(rm), rd)
+	}
+	ly, lm, ld := persianFromJDN(jdn, k)
+	lok := persianValid(ly, lm, ld, k)
+	out["FromStdTime"] = persianValue(ly, lm, ld, lok)
+	out["Persian()"] = out["FromStdTime"]
+	out["round trip"] = "invalid"
+	if lok {
+		out["round trip"] = persianGregorianDate(persianToJDN(ly, lm, ld, k), tm.Location(), k)
+	}
+	py, pm, pd := persianFromJDN(gregJDN(gy, int(gm), gd), hzKnownNone)
+	if !persianValid(py, pm, pd, hzKnownNone) {
+		// before the epoch (and the zero time): no Persian date
+		out["IsValid"] = "false"
+		out["ToGregorian"] = "error"
+		out["CreateFromPersian"] = "error"
+		out["IsLeapYear"] = "false"
+		out["ToMonthString"] = ""
+		out["ToWeekString"] = ""
+		return out
+	}
+	valid := persianValid(py, pm, pd, k)
+	out.set("IsValid", valid)
+	out["ToGregorian"] = "error"
+	out["CreateFromPersian"] = "error"
+	out["IsLeapYear"] = "false"
+	out["ToMonthString"] = ""
+	out["ToWeekString"] = ""
+	if valid {
+		back := persianToJDN(py, pm, pd, k)
+		out["ToGregorian"] = persianGregorianDate(back, tm.Location(), k)
+		out["CreateFromPersian"] = jdnDate(back)
+		out.set("IsLeapYear", persianLeap(py, k))
+		out["ToMonthString"] = persianMonthsOf[loc][pm-1]
+		weekday := jdnTime(back).Weekday()
+		name := persianWeeksOf[loc][weekday]
+		if k[kFaSundayMisnamed] && loc == "fa" && weekday == time.Sunday {
+			name = libFaSunday
+		}
+		out["ToWeekString"] = name
+	}
+	last := persianDaysInMonth(py, pm, hzKnownNone)
+	out["month length"] = monthLength(last, persianValid(py, pm, last, k), persianValid(py, pm, last+1, k))
+	if _, ok := nowruz[py]; ok {
+		out["Nowruz"] = persianGregorianDate(persianToJDN(py, 1, 1, k), tm.Location(), k)
+	}
+	return out
+}
+
+func persianActual(c persianCase) checks {
+	tm, loc := c.m.t, persian.Locale(c.locale.v)
+	gy, gm, gd := tm.Date()
+	out := checks{}
+	p := persian.FromStdTime(tm)
+	out["FromStdTime"] = persianLibValue(p)
+	out["Persian()"] = persianLibValue(carbonOf(c.m).Persian())
+	out["round trip"] = "invalid"
+	if p != nil && p.IsValid() {
+		out["round trip"] = gregorianDate(persian.NewPersian(p.Year(), p.Month(), p.Day()).ToGregorian(c.m.zone))
+	}
+	py, pm, pd := persianFromJDN(gregJDN(gy, int(gm), gd), hzKnownNone)
+	np := persian.NewPersian(py, pm, pd)
+	out.set("IsValid", np.IsValid())
+	out["ToGregorian"] = gregorianDate(np.ToGregorian(c.m.zone))
+	out["CreateFromPersian"] = carbonDate(carbon.CreateFromPersian(py, pm, pd))
+	out.set("IsLeapYear", np.IsLeapYear())
+	out["ToMonthString"] = np.ToMonthString(loc)
+	out["ToWeekString"] = np.ToWeekString(loc)
+	if !persianValid(py, pm, pd, hzKnownNone) {
+		return out
+	}
+	last := persianDaysInMonth(py, pm, hzKnownNone)
+	out["month length"] = monthLength(last, persian.NewPersian(py, pm, last).IsValid(), persian.NewPersian(py, pm, last+1).IsValid())
+	if _, ok := nowruz[py]; ok {
+		out["Nowruz"] = gregorianDate(persian.NewPersian(py, 1, 1).ToGregorian(c.m.zone))
+	}
+	return out
+}
+
+func judgePersian(j *hzCaseJudge, c persianCase) {
+	tallyDrawn(append(c.m.drawn, c.locale.via)...)
+	shape := classify(j, c, persianExpected)
+	j.Shape(shape)
+	verdictNamed(j, c, persianActual(c), persianExpected(c, hzKnownNone), shape, persianExpected)
+}
+
+func TestHegelPersianCalendarAgreesWithBirashk(t *testing.T) {
+	judged(t, persianCases, judgePersian)
+}
+
+// ---------------------------------------------------------------------------
+// Julian day numbers (on whole-second moments: the JD has microsecond
+// resolution at best).
+
+type julianCase struct{ m moment }
+
+func (c julianCase) GoString() string { return fmt.Sprintf("%#v", c.m) }
+
+// fiveDigitYears: the years whose modified Julian days have five digits
+// (1887-2131, inside the region past carbon/23), in the mix of years.
+var fiveDigitYears = hzWeighted(
+	hzW(16, via("year 1887-2131", hzInts(1887, 2131))),                               // 25 nominal: weight 16 realises 24.2 (14 realised 23.1)
+	hzW(4, via("year special", hzSampled(1900, 1969, 1970, 1999, 2000, 2038, 2100))), // 5 nominal: weight 4 realises 3.4 (6 realised 6.3, 5 4.3)
+	hzW(84, via("year 1970-2050", hzInts(1970, 2050))),                               // 70 nominal: weight 84 realises 72.4 (85 realised 70.6)
+)
+
+// julianMoments: whole-second moments; under HEGEL_NO_KNOWN=1 in UTC (the
+// region past carbon/29) and in the five-digit years (past 23, and so past
+// 24's reform).
+var julianMoments = hzShaped(wholeMoments, momentsIn(hegel.Just("UTC"), fiveDigitYears, true))
+
+var julianCases = hegel.Map(julianMoments, func(m moment) julianCase { return julianCase{m: m} })
+
+// jdValue prints a Julian day against the instant's: "within" the tolerance
+// of 2e-5 days (1.7 s), or the value and the instant's.
+func jdValue(x, want float64) string {
+	if math.Abs(x-want) <= 2e-5 {
+		return "within 2e-5 days of the instant's"
+	}
+	return fmt.Sprintf("%.6f (the instant's is %.6f)", x, want)
+}
+
+// dayNumberValue prints a Julian day against the day number of the UTC
+// date: within half a day, or the two.
+func dayNumberValue(x float64, jdn int) string {
+	if math.Abs(x-float64(jdn)) <= 0.5+2e-5 {
+		return "within half a day of the UTC date's day number"
+	}
+	return fmt.Sprintf("%.6f (the day number is %d)", x, jdn)
+}
+
+// readBackValue prints a time read back from a Julian day against the moment:
+// "closes" within a second, else the time.
+func readBackValue(back, want time.Time) string {
+	if back.Sub(want).Abs() <= time.Second {
+		return "closes"
+	}
+	return stampTime(back)
+}
+
+// instantJD is the documented Julian day of an instant: unix/86400 + 2440587.5.
+func instantJD(t time.Time) float64 { return float64(t.Unix())/86400 + 2440587.5 }
+
+// julianDayExpected: JD(), MJD(), Carbon.Julian() and the day number of the
+// UTC date, from the library's formula under the switches (libJulianJD:
+// the wall clock as UT under carbon/29, the Julian calendar before the
+// reform under 24).
+func julianDayExpected(c julianCase, k known) checks {
+	tm := c.m.t
+	want := instantJD(tm)
+	jd, mjd := libJulianJD(tm, k)
+	out := checks{}
+	out["JD"] = jdValue(jd, want)
+	out["MJD"] = jdValue(mjd, want-2400000.5)
+	out["Julian()"] = jdValue(jd, want)
+	uy, um, ud := tm.UTC().Date()
+	out["day number"] = dayNumberValue(jd, gregJDN(uy, int(um), ud))
+	return out
+}
+
+// julianReadBackExpected: the JD and the MJD read back by NewJulian and
+// ToGregorian(zone), and by CreateFromJulian (the default zone, UTC), close
+// on the instant within a second; under carbon/23 the digit heuristic
+// (libNewJulian) reads the MJD as day zero outside five digits (and a
+// seven-character negative one as a JD), under 24 and 29 the decoding is
+// the library's (julianToGregorian).
+func julianReadBackExpected(c julianCase, k known) checks {
+	tm, loc := c.m.t, c.m.t.Location()
+	jd, mjd := libJulianJD(tm, k)
+	out := checks{}
+	fromJD, fromMJD := jd, mjd+2400000.5
+	if k[kJulianDigitHeuristic] {
+		fromJD, _ = libNewJulian(jd)
+		fromMJD, _ = libNewJulian(mjd)
+	}
+	out["NewJulian(JD)"] = readBackValue(julianToGregorian(fromJD, loc, k), tm)
+	out["NewJulian(MJD)"] = readBackValue(julianToGregorian(fromMJD, loc, k), tm)
+	out["CreateFromJulian(JD)"] = readBackValue(julianToGregorian(fromJD, time.UTC, k), tm)
+	out["CreateFromJulian(MJD)"] = readBackValue(julianToGregorian(fromMJD, time.UTC, k), tm)
+	return out
+}
+
+func julianExpected(c julianCase, k known) checks {
+	out := julianDayExpected(c, k)
+	for name, v := range julianReadBackExpected(c, k) {
+		out[name] = v
+	}
+	return out
+}
+
+func julianDayActual(c julianCase) checks {
+	tm := c.m.t
+	want := instantJD(tm)
+	j := julian.FromStdTime(tm)
+	out := checks{}
+	out["JD"] = jdValue(j.JD(), want)
+	out["MJD"] = jdValue(j.MJD(), want-2400000.5)
+	out["Julian()"] = jdValue(carbonOf(c.m).Julian().JD(), want)
+	uy, um, ud := tm.UTC().Date()
+	out["day number"] = dayNumberValue(j.JD(), gregJDN(uy, int(um), ud))
+	return out
+}
+
+func julianReadBackActual(c julianCase) checks {
+	tm := c.m.t
+	j := julian.FromStdTime(tm)
+	out := checks{}
+	out["NewJulian(JD)"] = readBackValue(julian.NewJulian(j.JD()).ToGregorian(c.m.zone).Time, tm)
+	out["NewJulian(MJD)"] = readBackValue(julian.NewJulian(j.MJD()).ToGregorian(c.m.zone).Time, tm)
+	created := func(f float64) string {
+		cb := carbon.CreateFromJulian(f)
+		if cb.HasError() {
+			return "error"
+		}
+		return readBackValue(cb.StdTime(), tm)
+	}
+	out["CreateFromJulian(JD)"] = created(j.JD())
+	out["CreateFromJulian(MJD)"] = created(j.MJD())
+	return out
+}
+
+func julianActual(c julianCase) checks {
+	out := julianDayActual(c)
+	for name, v := range julianReadBackActual(c) {
+		out[name] = v
+	}
+	return out
+}
+
+func judgeJulian(j *hzCaseJudge, c julianCase) {
+	tallyDrawn(c.m.drawn...)
+	shape := classify(j, c, julianExpected)
+	j.Shape(shape)
+	verdictNamed(j, c, julianActual(c), julianExpected(c, hzKnownNone), shape, julianExpected)
+}
+
+func TestHegelJulianDayAgreesWithTheInstant(t *testing.T) {
+	judged(t, julianCases, judgeJulian)
+}
+
+// ---------------------------------------------------------------------------
+// Lunar (Chinese) calendar.
+
+// lunarDate is a lunar date as NewLunar takes it (possible or not).
+type lunarDate struct {
+	y, m, d int
+	leap    bool
+}
+
+func (l lunarDate) String() string {
+	s := fmt.Sprintf("%04d-%02d-%02d", l.y, l.m, l.d)
+	if l.leap {
+		s += " leap"
+	}
+	return s
+}
+
+type lunarCase struct {
+	m     moment
+	probe tagged[lunarDate]
+}
+
+func (c lunarCase) GoString() string { return fmt.Sprintf("%#v probe=%s", c.m, c.probe.v) }
+
+// lunarYears: the table's years 1900-2100 uniform, the special years (the
+// table's ends, 2033 and its neighbour, recent years) a fifth, and years
+// outside the table (the shape of carbon/16, never under HEGEL_NO_KNOWN=1)
+// a tenth, with the years beside the table reachable.
+var lunarYears = hzWeighted(
+	hzW(67, via("lunar year table", hzInts(1900, 2100))),                                          // 70 nominal: weight 67 realises 74.2 (70 realised 75.1; the runs differ by 3 points)
+	hzW(24, via("lunar year special", hzSampled(1900, 1901, 2033, 2034, 2099, 2100, 2020, 2023))), // 20 nominal: weight 24 realises 14.0 (21 realised 17.3, 24 20.3 in another run)
+	hzW(hzUnless(hzNoKnown, 12), via("lunar year outside", hzWeighted( // 10 nominal: weight 12 realises 11.8 (11 realised 7.1 and 7.6, 13 12.4)
+		hzW(4, hzInts(1, 1899)),
+		hzW(2, hzSampled(1899, 2101)),
+		hzW(4, hzInts(2101, 9999)),
+	))),
+)
+
+// eastZones: the zones at or east of +08:00 in every year, where Beijing
+// midnight is the date itself (the region past carbon/15).
+var eastZones = weightedOver([]int{2, 3, 5, 5}, "Asia/Shanghai", "Australia/Sydney", "Pacific/Chatham", "Asia/Tokyo")
+
+// lunarMoments: the thirteen zones (the shapes of carbon/15 and 20 need
+// the twelve beyond Shanghai; the four east of Beijing under
+// HEGEL_NO_KNOWN=1) and the lunar years.
+var lunarMoments = momentsIn(hzShaped(zoneList, eastZones), lunarYears, false)
+
+// lunarModelOf is FromStdTime of a moment under the switches: the day
+// count (the calendar's, or the library's elapsed-time count under
+// carbon/20), the walk over the table (libLunarFromCount; off the table a
+// panic under carbon/16, else no date), the labels (the library's under
+// carbon/21, else the Observatory's); the zero time is no date
+// (lunar.go:84-86).
+func lunarModelOf(t time.Time, k known) (lunarDate, string) {
+	if t.IsZero() {
+		return lunarDate{}, "invalid"
+	}
+	count := lunarCalendarCount(t)
+	if k[kLunarMidnightOffset] {
+		count = libLunarCount(t)
+	}
+	y, m, d, leap, ok := libLunarFromCount(count)
+	if !ok {
+		if k[kLunarPanicsOutsideTable] {
+			return lunarDate{}, "panic"
+		}
+		return lunarDate{}, "invalid"
+	}
+	if !k[kLunar2033LeapMonth] {
+		m, leap = lunarDocLabel(y, m, leap)
+	}
+	return lunarDate{y: y, m: m, d: d, leap: leap}, "ok"
+}
+
+// lunarDocOf is the documented lunar date of a moment's calendar date, ok
+// false outside the table.
+func lunarDocOf(t time.Time) (lunarDate, bool) {
+	l, state := lunarModelOf(t, hzKnownNone)
+	return l, state == "ok"
+}
+
+func lunarLeapMonthOf(year int, k known) int {
+	if k[kLunar2033LeapMonth] {
+		return libLunarLeapMonth(year)
+	}
+	return lunarDocLeapMonth(year)
+}
+
+// lunarDaysInOf is the length of a labelled month of a table year.
+func lunarDaysInOf(year, month int, leap bool, k known) int {
+	lm, ll := month, leap
+	if !k[kLunar2033LeapMonth] {
+		lm, ll = lunarLibLabel(year, month, leap)
+	}
+	if ll {
+		return libLunarDaysInLeapMonth(year)
+	}
+	return libLunarDaysInMonth(year, lm)
+}
+
+// lunarValid is IsValid of a lunar date: the year in the table, the month
+// one of the twelve, the leap flag only on the year's leap month, the day
+// within the month (the note of carbon/17), or under carbon/17 the year
+// alone (lunar.go:276-284).
+func lunarValid(p lunarDate, k known) bool {
+	if p.y < lunarMinYear || p.y > lunarMaxYear {
+		return false
+	}
+	if k[kLunarAcceptsAnyMonthAndDay] {
+		return true
+	}
+	if p.m < 1 || p.m > 12 {
+		return false
+	}
+	if p.leap && p.m != lunarLeapMonthOf(p.y, k) {
+		return false
+	}
+	return p.d >= 1 && p.d <= lunarDaysInOf(p.y, p.m, p.leap, k)
+}
+
+// lunarToGregorianValue is the date ToGregorian(zone) of a lunar date
+// gives, viewed in loc: for an invalid date none ("error"); else the
+// calendar date of the day count (the library's arithmetic on the fields,
+// libLunarCountOf: with the labels mapped to the table's unless carbon/21,
+// on whatever fields carbon/17 lets through) or, under carbon/15, the date
+// Beijing midnight of that day has in loc (lunar.go:150-151).
+func lunarToGregorianValue(p lunarDate, loc *time.Location, k known) string {
+	if !lunarValid(p, k) {
+		return "error"
+	}
+	lm, ll := p.m, p.leap
+	if !k[kLunar2033LeapMonth] {
+		lm, ll = lunarLibLabel(p.y, p.m, p.leap)
+	}
+	count := libLunarCountOf(p.y, lm, p.d, ll)
+	if k[kLunarUsesDefaultZone] {
+		return time.Unix(int64(count+1)*86400+lunarEpochUnix, 0).In(loc).Format("2006-01-02")
+	}
+	return lunarEpochDate.AddDate(0, 0, count).Format("2006-01-02")
+}
+
+// lunarProbeBase: the moment's own lunar date (the year of the moment with
+// month 1 and day 1, an invalid year, when the moment is outside the table),
+// the year's 29-day months and the months that are not its leap month (the
+// impossible probes' ingredients; month 1 alone outside the table).
+func lunarProbeBase(m moment) (own lunarDate, short, notLeap []int) {
+	own, ok := lunarDocOf(m.t)
+	if !ok {
+		return lunarDate{y: m.t.Year(), m: 1, d: 1}, []int{1}, []int{1}
+	}
+	for mm := 1; mm <= 12; mm++ {
+		if lunarDaysInOf(own.y, mm, false, hzKnownNone) == 29 {
+			short = append(short, mm)
+		}
+		if mm != lunarDocLeapMonth(own.y) {
+			notLeap = append(notLeap, mm)
+		}
+	}
+	return own, short, notLeap
+}
+
+// lunarProbesFor: the probe date beside a moment: the moment's own lunar
+// date half the time (the year of the moment with month 1 and day 1, an
+// invalid year, when the moment is outside the table), else an impossible
+// one of four kinds, an eighth each (the shape of carbon/17, never under
+// HEGEL_NO_KNOWN=1): month 13 or 0, the 30th of a 29-day month, the leap
+// flag on a month that is not the year's leap month (every month in a year
+// without one), day 31.
+func lunarProbesFor(m moment) hegel.Generator[tagged[lunarDate]] {
+	own, short, notLeap := lunarProbeBase(m)
+	return hzWeighted(
+		hzW(38, via("probe own", hegel.Just(own))), // 50 nominal: weight 38 realises 51.7 (50 realised 60.2)
+		hzW(hzUnless(hzNoKnown, 16), via("probe month 13 or 0", hegel.Map(hzTuple(hzSampled(13, 0), hzInts(1, 29)), func(v []int) lunarDate { // 12.5 nominal: weight 16 realises 11.9 (13 realised 10.4)
+			return lunarDate{y: own.y, m: v[0], d: v[1]}
+		}))),
+		hzW(hzUnless(hzNoKnown, 17), via("probe 30th of a short month", hegel.Map(hegel.SampledFrom(short), func(mm int) lunarDate { // 12.5 nominal: weight 17 realises 12.5 (13 realised 12.4)
+			return lunarDate{y: own.y, m: mm, d: 30}
+		}))),
+		hzW(hzUnless(hzNoKnown, 21), via("probe leap flag", hegel.Map(hzTuple(hegel.SampledFrom(notLeap), hzInts(1, 29)), func(v []int) lunarDate { // 12.5 nominal: weight 21 realises 12.5 (13 realised 8.9)
+			return lunarDate{y: own.y, m: v[0], d: v[1], leap: true}
+		}))),
+		hzW(hzUnless(hzNoKnown, 21), via("probe day 31", hegel.Map(hzInts(1, 12), func(mm int) lunarDate { // 12.5 nominal: weight 21 realises 11.4 (13 realised 8.2)
+			return lunarDate{y: own.y, m: mm, d: 31}
+		}))),
+	)
+}
+
+// lunarCasesFrom: a lunar case over the moments with the probes; under
+// HEGEL_NO_KNOWN=1 the moments with a date shape (carbon/16's dates beside
+// the table, 20's flipping clocks, 21's relabelled 2033) are filtered out by
+// the classifier.
+func lunarCasesFrom(ms hegel.Generator[moment], probes func(moment) hegel.Generator[tagged[lunarDate]]) hegel.Generator[lunarCase] {
+	return withoutShapes(lunarDatesExpected, hegel.Composite(func(tc hegel.TestCase) lunarCase {
+		m := hegel.Draw(tc, ms)
+		return lunarCase{m: m, probe: hegel.Draw(tc, probes(m))}
+	}))
+}
+
+var lunarCases = lunarCasesFrom(lunarMoments, lunarProbesFor)
+
+func lunarStateValue(l lunarDate, state string) string {
+	if state != "ok" {
+		return state
+	}
+	return l.String()
+}
+
+// lunarDatesExpected: the checks of the dates ("date ..."): FromStdTime and
+// Lunar() of the moment, its leap month and flag, the next day, the New
+// Year of its lunar year read in Shanghai (the Observatory's table, which
+// the library's agrees with), and the probe's validity, rendering (the
+// library's, lunarDateString; a panic on a month outside the names under
+// carbon/17) and leap month.
+func lunarDatesExpected(c lunarCase, k known) checks {
+	tm := c.m.t
+	out := checks{}
+	l, state := lunarModelOf(tm, k)
+	out["date FromStdTime"] = lunarStateValue(l, state)
+	out["date Lunar()"] = out["date FromStdTime"]
+	n, nstate := lunarModelOf(tm.AddDate(0, 0, 1), k)
+	out["date next day"] = lunarStateValue(n, nstate)
+	if state == "ok" {
+		out.set("date IsLeapMonth", l.leap)
+		out.set("date LeapMonth", lunarLeapMonthOf(l.y, k))
+		if ny, ok := chineseNewYear[l.y]; ok {
+			out["date New Year"] = ny
+		} else {
+			out["date New Year"] = lunarEpochDate.AddDate(0, 0, libLunarDaysBefore[l.y-lunarMinYear]).Format("2006-01-02")
+		}
+	} else {
+		out["date IsLeapMonth"] = lunarStateValue(lunarDate{}, state)
+		out["date LeapMonth"] = out["date IsLeapMonth"]
+	}
+	p := c.probe.v
+	valid := lunarValid(p, k)
+	out.set("date probe IsValid", valid)
+	out["date probe ToDateString"] = ""
+	out["date probe LeapMonth"] = "0"
+	if valid {
+		out["date probe ToDateString"] = "panic"
+		if p.m >= 1 && p.m <= 12 {
+			out["date probe ToDateString"] = lunarDateString(p.y, p.m, p.d, p.leap)
+		}
+		out.set("date probe LeapMonth", lunarLeapMonthOf(p.y, k))
+	}
+	return out
+}
+
+// lunarZonesExpected: the checks of the zones ("zone ..."): the probe
+// converted back in the moment's zone and by CreateFromLunar in the default
+// zone (UTC), where carbon/15 reads Beijing midnight.
+func lunarZonesExpected(c lunarCase, k known) checks {
+	return checks{
+		"zone ToGregorian":     lunarToGregorianValue(c.probe.v, zones[c.m.zone], k),
+		"zone CreateFromLunar": lunarToGregorianValue(c.probe.v, time.UTC, k),
+	}
+}
+
+// lunarToGregorianExpected is the zone check that stays under HEGEL_NO_KNOWN=1.
+func lunarToGregorianExpected(c lunarCase, k known) checks {
+	return checks{"zone ToGregorian": lunarToGregorianValue(c.probe.v, zones[c.m.zone], k)}
+}
+
+func lunarExpected(c lunarCase, k known) checks {
+	out := lunarDatesExpected(c, k)
+	for name, v := range lunarZonesExpected(c, k) {
+		out[name] = v
+	}
+	return out
+}
+
+func lunarLibValue(l *lunar.Lunar) string {
+	if l == nil || !l.IsValid() {
+		return "invalid"
+	}
+	return lunarDate{y: l.Year(), m: l.Month(), d: l.Day(), leap: l.IsLeapMonth()}.String()
+}
+
+func lunarActual(c lunarCase) checks {
+	tm := c.m.t
+	out := checks{}
+	var l *lunar.Lunar
+	out["date FromStdTime"] = recovered(func() string {
+		l = lunar.FromStdTime(tm)
+		return lunarLibValue(l)
+	})
+	out["date Lunar()"] = recovered(func() string { return lunarLibValue(carbonOf(c.m).Lunar()) })
+	out["date next day"] = recovered(func() string { return lunarLibValue(lunar.FromStdTime(tm.AddDate(0, 0, 1))) })
+	if l != nil && l.IsValid() {
+		out.set("date IsLeapMonth", l.IsLeapMonth())
+		out.set("date LeapMonth", l.LeapMonth())
+		out["date New Year"] = gregorianDate(lunar.NewLunar(l.Year(), 1, 1, false).ToGregorian("Asia/Shanghai"))
+	} else {
+		out["date IsLeapMonth"] = out["date FromStdTime"]
+		out["date LeapMonth"] = out["date FromStdTime"]
+	}
+	p := c.probe.v
+	np := lunar.NewLunar(p.y, p.m, p.d, p.leap)
+	out.set("date probe IsValid", np.IsValid())
+	out["date probe ToDateString"] = recovered(np.ToDateString)
+	out.set("date probe LeapMonth", np.LeapMonth())
+	out["zone ToGregorian"] = gregorianDate(np.ToGregorian(c.m.zone))
+	out["zone CreateFromLunar"] = carbonDate(carbon.CreateFromLunar(p.y, p.m, p.d, p.leap))
+	return out
+}
+
+// judgeLunar: the shape of the dates (carbon/16, 17, 20, 21) is named first
+// and skips the case under HEGEL_NO_KNOWN=1 (the generators keep that rare);
+// the shape of the zones, carbon/15, is one check of nearly every case
+// (CreateFromLunar reads Beijing midnight in UTC, the default zone, and
+// ToGregorian in nine of the thirteen zones), so it names the case only
+// when the dates do not, and under HEGEL_NO_KNOWN=1 the CreateFromLunar
+// check is dropped (counted) while ToGregorian is judged in the east zones.
+func judgeLunar(j *hzCaseJudge, c lunarCase) {
+	tallyDrawn(append(c.m.drawn, c.probe.via)...)
+	shape := classify(j, c, lunarDatesExpected)
+	j.Shape(shape)
+	want := lunarExpected(c, hzKnownNone)
+	if hzNoKnown {
+		delete(want, "zone CreateFromLunar")
+		hzTally("dropped carbon/15")
+		j.Shape(shapeID(c, lunarToGregorianExpected))
+	} else if zoneShape := shapeID(c, lunarZonesExpected); zoneShape != "" {
+		hzTally("shape via zones")
+		j.Shape(zoneShape)
+		if shape == "" {
+			shape = zoneShape
+		}
+	}
+	if shape != "" {
+		hzTally("named " + shape) // once per case (a probe's shape is tallied by the dates and by the zones)
+	}
+	verdictNamed(j, c, lunarActual(c), want, shape, lunarExpected)
+}
+
+func TestHegelLunarCalendarRoundTripsAndMatchesTheTables(t *testing.T) {
+	judged(t, lunarCases, judgeLunar)
+}
