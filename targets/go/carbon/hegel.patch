+// boundaryExpected: the starts and ends of the units in the moment's zone,
+// each keeping the week start; the receiver is untouched.
+func boundaryExpected(c boundaryCase, _ known) checks {
+	tm, ws := c.m.t, c.ws
+	loc := tm.Location()
+	y, m, d := tm.Date()
+	h, mi, s := tm.Clock()
+	date := func(y int, m time.Month, d, h, mi, s, ns int) time.Time {
+		return time.Date(y, m, d, h, mi, s, ns, loc)
+	}
+	q := modelQuarter(m)
+	seasonStartMonth := time.Month(int(m) / 3 * 3) // 3, 6, 9, 12 (0 for Jan/Feb)
+	seasonStartYear := y
+	if m == time.January || m == time.February {
+		seasonStartMonth, seasonStartYear = time.December, y-1
+	}
+	seasonEndYear, seasonEndMonth := seasonStartYear, seasonStartMonth+2
+	if seasonStartMonth == time.December {
+		seasonEndYear, seasonEndMonth = seasonStartYear+1, time.February
+	}
+	out := checks{}
+	at := func(name string, t time.Time) { out[name] = stampTime(t) + " ws=" + ws.String() }
+	at("StartOfCentury", date(y/100*100, 1, 1, 0, 0, 0, 0))
+	at("EndOfCentury", date(y/100*100+99, 12, 31, 23, 59, 59, 999999999))
+	at("StartOfDecade", date(y/10*10, 1, 1, 0, 0, 0, 0))
+	at("EndOfDecade", date(y/10*10+9, 12, 31, 23, 59, 59, 999999999))
+	at("StartOfYear", date(y, 1, 1, 0, 0, 0, 0))
+	at("EndOfYear", date(y, 12, 31, 23, 59, 59, 999999999))
+	at("StartOfQuarter", date(y, time.Month(3*q-2), 1, 0, 0, 0, 0))
+	at("EndOfQuarter", date(y, time.Month(3*q), daysIn(y, time.Month(3*q)), 23, 59, 59, 999999999))
+	at("StartOfMonth", date(y, m, 1, 0, 0, 0, 0))
+	at("EndOfMonth", date(y, m, daysIn(y, m), 23, 59, 59, 999999999))
+	at("StartOfWeek", modelStartOfWeek(tm, ws))
+	at("EndOfWeek", modelEndOfWeek(tm, ws))
+	at("StartOfDay", date(y, m, d, 0, 0, 0, 0))
+	at("EndOfDay", date(y, m, d, 23, 59, 59, 999999999))
+	at("StartOfHour", date(y, m, d, h, 0, 0, 0))
+	at("EndOfHour", date(y, m, d, h, 59, 59, 999999999))
+	at("StartOfMinute", date(y, m, d, h, mi, 0, 0))
+	at("EndOfMinute", date(y, m, d, h, mi, 59, 999999999))
+	at("StartOfSecond", date(y, m, d, h, mi, s, 0))
+	at("EndOfSecond", date(y, m, d, h, mi, s, 999999999))
+	at("StartOfSeason", date(seasonStartYear, seasonStartMonth, 1, 0, 0, 0, 0))
+	at("EndOfSeason", date(seasonEndYear, seasonEndMonth, daysIn(seasonEndYear, seasonEndMonth), 23, 59, 59, 999999999))
+	out["receiver"] = stampTime(tm)
+	return out
+}
