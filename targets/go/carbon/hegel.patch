+func TestHegelDiffStringsAgreeWithModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		loc := tm.Location()
+		tm = time.Unix(tm.Unix(), 0).In(loc) // whole seconds (carbon/2)
+		c = carbon.CreateFromStdTime(tm)
+		var t2 time.Time
+		switch n(tc, 1, 3) {
+		case 1:
+			t2 = time.Unix(genNear(tc, tm).Unix(), 0).In(loc)
+		case 2:
+			t2 = tm.AddDate(n(tc, -30, 30), n(tc, -20, 20), n(tc, -40, 40))
+		default:
+			t2 = modelAddSeconds(tm, int64(n(tc, -90*86400, 90*86400)))
+		}
+		_, o1 := tm.Zone()
+		_, o2 := t2.Zone()
+		if o1 != o2 {
+			count(ht, "known-carbon/3")
+			return
+		}
+		c2 := carbon.CreateFromStdTime(t2)
+		note(ht, "%s -> %s", showTime(tm), showTime(t2))
+		unit, value := modelDiffUnit(tm, t2)
+		var want string
+		if unit == "now" {
+			want = "just now"
+		} else if abs64(value) == 1 {
+			want = "1 " + unit
+		} else {
+			want = fmt.Sprintf("%d %ss", abs64(value), unit)
+		}
+		if got := c.DiffAbsInString(c2); got != want {
+			fail(ht, "DiffAbsInString = %q, want %q\n a %s\n b %s", got, want, showTime(tm), showTime(t2))
+		}
+		wantHumans := want
+		if unit != "now" {
+			if value > 0 {
+				wantHumans = want + " before"
+			} else {
+				wantHumans = want + " after"
+			}
+		}
+		if got := c.DiffForHumans(c2); got != wantHumans {
+			fail(ht, "DiffForHumans = %q, want %q\n a %s\n b %s", got, wantHumans, showTime(tm), showTime(t2))
+		}
+		wantSigned := want
+		if unit != "now" && value < 0 {
+			wantSigned = fmt.Sprintf("%d %ss", value, unit)
+			if value == -1 {
+				wantSigned = "-1 " + unit
+			}
+		}
+		if got := c.DiffInString(c2); got != wantSigned {
+			fail(ht, "DiffInString = %q, want %q\n a %s\n b %s", got, wantSigned, showTime(tm), showTime(t2))
+		}
+	})
+}
