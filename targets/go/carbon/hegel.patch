+// bracket checks that k whole `step`s from a reach b but k+1 do not
+// (b at or after a), or the mirror image for b before a.
+func bracket(ht *hegel.T, what string, a, b time.Time, k int64, step func(time.Time, int) time.Time) {
+	s, e := a, b
+	if b.Before(a) {
+		s, e = b, a
+		if k > 0 {
+			fail(ht, "%s = %d but the end is before the start\n a %s\n b %s", what, k, showTime(a), showTime(b))
+		}
+		k = -k
+	} else if k < 0 {
+		fail(ht, "%s = %d but the end is after the start\n a %s\n b %s", what, k, showTime(a), showTime(b))
+	}
+	if step(s, int(k)).After(e) || !step(s, int(k)+1).After(e) {
+		fail(ht, "%s = %d, but %s + %d = %s and + %d = %s around %s", what, k, showTime(s), k, showTime(step(s, int(k))), k+1, showTime(step(s, int(k)+1)), showTime(e))
+	}
+}
