+}
+
+// carbon/26: the Farsi name of Sunday.
+func TestHegelPinPersianSundayNameInFarsi(t *testing.T) {
+	if got, want := persian.FaWeeks[0], "\u06cc\u06a9\u0634\u0646\u0628\u0647"; got != want {
+		t.Errorf("FaWeeks[0] = %q, want %q (Yekshanbeh)", got, want)
+	}
+}
+
+// carbon/27: month 12 of a leap year is Adar I.
+func TestHegelPinHebrewAdarNamesInLeapYear(t *testing.T) {
+	m12 := hebrew.NewHebrew(5784, 12, 1).ToMonthString()
+	m13 := hebrew.NewHebrew(5784, 13, 1).ToMonthString()
+	common := hebrew.NewHebrew(5785, 12, 1).ToMonthString()
+	if m12 == m13 || m12 == common {
+		t.Errorf("leap year 5784: month 12 %q, month 13 %q; common year month 12 %q", m12, m13, common)
+	}
+}
+
+// carbon/28: the zero-time shortcut in BetweenIncluded*.
+func TestHegelPinZeroTimeIsNotBetweenAnEmptyRange(t *testing.T) {
+	z := carbon.ZeroValue()
+	if z.BetweenIncludedStart(z, z) {
+		t.Errorf("zero.BetweenIncludedStart(zero, zero) = true; the end is excluded")
+	}
+	if z.BetweenIncludedEnd(z, z) {
+		t.Errorf("zero.BetweenIncludedEnd(zero, zero) = true; the start is excluded")
+	}
+	bad := carbon.Parse("not a date")
+	if z.BetweenIncludedBoth(z, bad) || z.BetweenIncludedStart(z, bad) {
+		t.Errorf("zero is between zero and an invalid Carbon")
+	}
+	later := carbon.CreateFromDate(2000, 1, 1, "UTC")
+	if z.BetweenIncludedEnd(z, later) {
+		t.Errorf("zero.BetweenIncludedEnd(zero, 2000) = true; the start is excluded")
+	}
+}
+
+// carbon/29: the Julian day of an instant depends on its zone.
+func TestHegelPinJulianDayIsZoneIndependent(t *testing.T) {
+	a := carbon.CreateFromDateTime(2020, 8, 5, 12, 0, 0, "Asia/Shanghai")
+	b := carbon.CreateFromDateTime(2020, 8, 5, 4, 0, 0, "UTC") // the same instant
+	if !a.Eq(b) {
+		t.Fatalf("not the same instant")
+	}
+	if a.Julian().JD() != b.Julian().JD() {
+		t.Errorf("JD in Shanghai %.6f, JD in UTC %.6f for one instant (want %.6f)", a.Julian().JD(), b.Julian().JD(), float64(a.Timestamp())/86400+2440587.5)
+	}
+	if got := a.Julian().ToGregorian("UTC").Time; !got.Equal(b.StdTime()) {
+		t.Errorf("Shanghai noon -> Julian -> UTC = %s, want 04:00 UTC", got)
+	}
+}
+
+// carbon/30: DiffInMonths overshoots from the end of a month.
+func TestHegelPinDiffInMonthsNeverPassesTheEnd(t *testing.T) {
+	s := carbon.CreateFromDateTime(1989, 1, 31, 23, 59, 59, "UTC")
+	e := carbon.CreateFromDateTime(2006, 12, 1, 1, 59, 14, "UTC")
+	k := s.DiffInMonths(e)
+	if s.AddMonths(int(k)).Gt(e) {
+		t.Errorf("DiffInMonths = %d, but AddMonths(%d) = %s is after the end %s", k, k, s.AddMonths(int(k)).ToDateTimeString(), e.ToDateTimeString())
+	}
+	if k != 213 {
+		t.Errorf("DiffInMonths(1989-01-31 23:59:59, 2006-12-01 01:59:14) = %d, want 213 (AddMonths(213) = %s, AddMonths(214) = %s)", k, s.AddMonths(213).ToDateTimeString(), s.AddMonths(214).ToDateTimeString())
+	}
+	s = carbon.CreateFromDateTime(2023, 1, 31, 12, 0, 0, "UTC")
+	e = carbon.CreateFromDateTime(2023, 3, 2, 6, 0, 0, "UTC")
+	if k := s.DiffInMonths(e); s.AddMonths(int(k)).Gt(e) {
+		t.Errorf("DiffInMonths(2023-01-31 12:00, 2023-03-02 06:00) = %d, but AddMonths(%d) = %s is after the end", k, k, s.AddMonths(int(k)).ToDateTimeString())
+	}
+}
