+}
+
+// stringPairs: the pairs of the difference strings: b near a, shifted by
+// dates, or up to 90 days away, in a's zone; whole seconds and outside the
+// regions of carbon/3 and carbon/30 under HEGEL_NO_KNOWN=1.
+var stringPairs = hzOnly(hzNoKnown, "carbon/3", pairsOf(exactMoments, func(a moment) hegel.Generator[moment] {
+	return hzWeighted(
+		hzW(14, nearOf(a, hzNoKnown)),                // 33 nominal: weight 14 realises 31.0
+		hzW(39, datesFrom(a, 30, 20, 40, 0)),         // 33 nominal: weight 39 realises 31.5
+		hzW(66, secondsFrom(a, -90*86400, 90*86400)), // 33 nominal: weight 66 realises 37.5
+	)
+}), func(c pairCase) bool { return shapeID(c, stringsExpected) == "" })
+
+// modelDiff is the first non-zero unit of the difference, largest first, as
+// DiffForHumans documents and diff() computes (difference.go:293-337), each
+// unit by its model.
+func modelDiff(a, b moment, k known) (unit string, value int64) {
+	if v := modelDiffYears(a, b, k); v != 0 {
+		return "year", v
+	}
+	if v := modelDiffMonths(a, b, k); v != 0 {
+		return "month", v
+	}
+	if v := modelDiffDays(a, b, k, 7); v != 0 {
+		return "week", v
+	}
+	if v := modelDiffDays(a, b, k, 1); v != 0 {
+		return "day", v
+	}
+	secs := modelDiffSeconds(a, b, k)
+	if v := secs / 3600; v != 0 {
+		return "hour", v
+	}
+	if v := secs / 60; v != 0 {
+		return "minute", v
+	}
+	if secs != 0 {
+		return "second", secs
+	}
+	return "now", 0
+}
+
+// stringsExpected: DiffAbsInString, DiffForHumans and DiffInString from the
+// unit and value ("just now", "1 year", "3 months", "before"/"after", the
+// signed form).
+func stringsExpected(c pairCase, k known) checks {
+	unit, value := modelDiff(c.a, c.b, k)
+	var abs string
+	if unit == "now" {
+		abs = "just now"
+	} else if abs64(value) == 1 {
+		abs = "1 " + unit
+	} else {
+		abs = fmt.Sprintf("%d %ss", abs64(value), unit)
+	}
+	humans := abs
+	if unit != "now" && value > 0 {
+		humans = abs + " before"
+	} else if unit != "now" {
+		humans = abs + " after"
+	}
+	signed := abs
+	if unit != "now" && value < 0 {
+		signed = fmt.Sprintf("%d %ss", value, unit)
+		if value == -1 {
+			signed = "-1 " + unit
+		}
+	}
+	return checks{"DiffAbsInString": abs, "DiffForHumans": humans, "DiffInString": signed}
+}
+
+func stringsActual(c pairCase) checks {
+	ca, cb := carbonOf(c.a), carbonOf(c.b)
+	return checks{"DiffAbsInString": ca.DiffAbsInString(cb), "DiffForHumans": ca.DiffForHumans(cb), "DiffInString": ca.DiffInString(cb)}
+}
+
+func TestHegelDiffStringsAgreeWithModel(t *testing.T) {
+	judged(t, stringPairs, func(j *hzCaseJudge, c pairCase) {
+		tallyDrawn(c.drawn()...)
+		judgeBy(j, c, stringsExpected, stringsActual)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Comparisons and extrema.
+
+// compareCase is a receiver a and two operands b and c (the bounds of the
+// Between checks); a bound of kind "error" or "empty" is an invalid Carbon
+// (Parse of "nonsense" or of "") instead of its moment (the narrow property
+// of carbon/28 draws those; the wide property draws moments only).
+type compareCase struct {
+	a, b, c moment
+	bk, ck  string
+}
+
+func (c compareCase) GoString() string {
+	return fmt.Sprintf("%#v | %s | %s", c.a, boundString(c.b, c.bk), boundString(c.c, c.ck))
+}
+
+func boundString(m moment, kind string) string {
+	if kind != "" {
+		return kind
+	}
+	return fmt.Sprintf("%#v", m)
+}
+
+// boundOf is the Carbon of a bound.
+func boundOf(m moment, kind string) *carbon.Carbon {
+	switch kind {
+	case "error":
+		return carbon.Parse("nonsense")
+	case "empty":
+		return carbon.Parse("")
+	}
+	return carbonOf(m)
+}
+
+func (c compareCase) drawn() []string {
+	return append(append(append([]string{}, c.a.drawn...), c.b.drawn...), c.c.drawn...)
+}
+
+// relatedTo: a moment for a comparison with a: the same instant in a drawn
+// zone, near a, independent in any zone, or a nanosecond nudge away.
+func relatedTo(a moment) hegel.Generator[moment] {
+	return hzWeighted(
+		hzW(13, inZone(a)),        // 25 nominal: weight 13 realises 27.4
+		hzW(28, nearOf(a, false)), // 25 nominal: weight 28 realises 25.4
+		hzW(29, moments),          // 25 nominal: weight 29 realises 23.4
+		hzW(42, nudgedBy(a, []int64{1, -1, 1000, -1000, 1e9, -1e9})), // 25 nominal: weight 42 realises 24.2
+	)
+}
+
+// compareCases: a and two moments related to it; under HEGEL_NO_KNOWN=1 the
+// region of carbon/28 (the zero time as the receiver and an included bound)
+// is filtered out.
+var compareCases = hzOnly(hzNoKnown, "carbon/28", hegel.Composite(func(tc hegel.TestCase) compareCase {
+	a := hegel.Draw(tc, moments)
+	return compareCase{a: a, b: hegel.Draw(tc, relatedTo(a)), c: hegel.Draw(tc, relatedTo(a))}
+}), func(c compareCase) bool { return shapeID(c, compareExpected) == "" })
+
+// compareExpected: the comparisons are those of the instants (false with an
+// invalid operand); Between and its variants are false for an inverted range
+// or an invalid operand and otherwise ask whether the instant is inside, or
+// (carbon/28) answer true before the validity check when the receiver and an
+// included bound are the zero time (comparer.go:457, 474, 491, after the
+// inverted-range check of 454, whose Gt is false for an invalid bound); the
+// IsSame* checks compare the fields when the zones are the same.
+func compareExpected(c compareCase, k known) checks {
+	tm, t2, t3 := c.a.t, c.b.t, c.c.t
+	bValid, cValid := c.bk == "", c.ck == ""
+	out := checks{}
+	// every comparison with an invalid operand is false
+	out.set("Eq", bValid && tm.Equal(t2))
+	out.set("Ne", bValid && !tm.Equal(t2))
+	out.set("Gt", bValid && tm.After(t2))
+	out.set("Lt", bValid && tm.Before(t2))
+	out.set("Gte", bValid && !tm.Before(t2))
+	out.set("Lte", bValid && !tm.After(t2))
+	out.set(`Compare("=")`, bValid && tm.Equal(t2))
+	out.set(`Compare("<>")`, bValid && !tm.Equal(t2))
+	out.set(`Compare("!=")`, bValid && !tm.Equal(t2))
+	out.set(`Compare(">")`, bValid && tm.After(t2))
+	out.set(`Compare(">=")`, bValid && !tm.Before(t2))
+	out.set(`Compare("<")`, bValid && tm.Before(t2))
+	out.set(`Compare("<=")`, bValid && !tm.After(t2))
+	out.set(`Compare("?")`, false)
+	// the range is inverted only when both bounds are valid (Gt of an invalid operand is false)
+	inverted := bValid && cValid && t2.After(t3)
+	valid := bValid && cValid
+	zero := k[kZeroTimeIsBetweenAnything] && tm.IsZero()
+	out.set("Between", !inverted && valid && tm.After(t2) && tm.Before(t3))
+	out.set("BetweenIncludedStart", !inverted && ((zero && bValid && t2.IsZero()) || (valid && !tm.Before(t2) && tm.Before(t3))))
+	out.set("BetweenIncludedEnd", !inverted && ((zero && cValid && t3.IsZero()) || (valid && tm.After(t2) && !tm.After(t3))))
+	out.set("BetweenIncludedBoth", !inverted && ((zero && ((bValid && t2.IsZero()) || (cValid && t3.IsZero()))) || (valid && !tm.Before(t2) && !tm.After(t3))))
+	if bValid && t2.Location() == tm.Location() {
+		a, b := tm, t2
+		out.set("IsSameCentury", a.Year()/100 == b.Year()/100)
+		out.set("IsSameDecade", a.Year()%100/10 == b.Year()%100/10)
+		out.set("IsSameYear", a.Year() == b.Year())
+		out.set("IsSameQuarter", a.Year() == b.Year() && modelQuarter(a.Month()) == modelQuarter(b.Month()))
+		out.set("IsSameMonth", a.Year() == b.Year() && a.Month() == b.Month())
+		out.set("IsSameDay", a.Format("2006-01-02") == b.Format("2006-01-02"))
+		out.set("IsSameHour", a.Format("2006-01-02 15") == b.Format("2006-01-02 15"))
+		out.set("IsSameMinute", a.Format("2006-01-02 15:04") == b.Format("2006-01-02 15:04"))
+		out.set("IsSameSecond", a.Format("2006-01-02 15:04:05") == b.Format("2006-01-02 15:04:05"))
+	}
+	return out
+}
+
+func compareActual(c compareCase) checks {
+	ca, c2, c3 := carbonOf(c.a), boundOf(c.b, c.bk), boundOf(c.c, c.ck)
+	out := checks{}
+	out.set("Eq", ca.Eq(c2))
+	out.set("Ne", ca.Ne(c2))
+	out.set("Gt", ca.Gt(c2))
+	out.set("Lt", ca.Lt(c2))
+	out.set("Gte", ca.Gte(c2))
+	out.set("Lte", ca.Lte(c2))
+	for _, op := range []string{"=", "<>", "!=", ">", ">=", "<", "<=", "?"} {
+		out.set(fmt.Sprintf("Compare(%q)", op), ca.Compare(op, c2))
+	}
+	out.set("Between", ca.Between(c2, c3))
+	out.set("BetweenIncludedStart", ca.BetweenIncludedStart(c2, c3))
+	out.set("BetweenIncludedEnd", ca.BetweenIncludedEnd(c2, c3))
+	out.set("BetweenIncludedBoth", ca.BetweenIncludedBoth(c2, c3))
+	if c.bk == "" && c.b.t.Location() == c.a.t.Location() {
+		out.set("IsSameCentury", ca.IsSameCentury(c2))
+		out.set("IsSameDecade", ca.IsSameDecade(c2))
+		out.set("IsSameYear", ca.IsSameYear(c2))
+		out.set("IsSameQuarter", ca.IsSameQuarter(c2))
+		out.set("IsSameMonth", ca.IsSameMonth(c2))
+		out.set("IsSameDay", ca.IsSameDay(c2))
+		out.set("IsSameHour", ca.IsSameHour(c2))
+		out.set("IsSameMinute", ca.IsSameMinute(c2))
+		out.set("IsSameSecond", ca.IsSameSecond(c2))
+	}
+	return out
+}
