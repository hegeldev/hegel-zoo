+// smallUnitPairs: the pairs of the differences in small units: b near a or
+// up to 400 days away, in a's zone; on whole seconds under HEGEL_NO_KNOWN=1
+// (carbon/2), and then outside the region of carbon/3 (a day or week count
+// that the elapsed seconds and the calendar disagree on).
+var smallUnitPairs = hzOnly(hzNoKnown, "carbon/3", pairsOf(exactMoments, func(a moment) hegel.Generator[moment] {
+	return hzWeighted(
+		hzW(32, nearOf(a, hzNoKnown)),                  // 50 nominal: weight 32 realises 49.5
+		hzW(76, secondsFrom(a, -400*86400, 400*86400)), // 50 nominal: weight 76 realises 50.5
+	)
+}), func(c pairCase) bool { return shapeID(c, smallUnitsExpected) == "" })
+
+// smallUnitsExpected: the differences in seconds, minutes and hours are the
+// truncated elapsed time, in days and weeks the calendar count, in Duration
+// the exact difference.
+func smallUnitsExpected(c pairCase, k known) checks {
+	out := checks{}
+	secs := modelDiffSeconds(c.a, c.b, k)
+	out.set("DiffInSeconds", secs)
+	out.set("DiffAbsInSeconds", abs64(secs))
+	out.set("DiffInMinutes", secs/60)
+	out.set("DiffAbsInMinutes", abs64(secs/60))
+	out.set("DiffInHours", secs/3600)
+	out.set("DiffAbsInHours", abs64(secs/3600))
+	out.set("DiffInDuration", c.b.t.Sub(c.a.t))
+	out.set("DiffAbsInDuration", c.b.t.Sub(c.a.t).Abs())
+	days, weeks := modelDiffDays(c.a, c.b, k, 1), modelDiffDays(c.a, c.b, k, 7)
+	out.set("DiffInDays", days)
+	out.set("DiffInWeeks", weeks)
+	out.set("DiffAbsInDays", abs64(days))
+	out.set("DiffAbsInWeeks", abs64(weeks))
+	return out
+}
