+// movedCases: a plain output (not a marked or a timestamp one, whose own
+// shapes would be named first) with a good or a bad timezone argument (none
+// under HEGEL_NO_KNOWN=1); the classifier keeps the cases where the argument
+// moves the receiver (a good zone that is the moment's own does not).
+var movedCases = regionOf("carbon/14", outputsExpected, hegel.Composite(func(tc hegel.TestCase) outputCase {
+	return outputCase{
+		m:  hegel.Draw(tc, moments),
+		o:  hegel.Draw(tc, evenOutputs(plainOutputs)),
+		tz: hegel.Draw(tc, hzShaped(hzWeighted(hzW(2, via("tz good", hegel.Map(zoneList, func(z string) tzArg { return tzArg{kind: "good", name: z} }))), hzW(2, via("tz bad", hegel.Map(hzSampled("Nowhere/City", ""), func(z string) tzArg { return tzArg{kind: "bad", name: z} })))), via("tz none", hegel.Just(tzArg{})))),
+	}
+}))
+
+func TestHegelOutputWithTimezoneLeavesTheReceiver(t *testing.T) {
+	judged(t, movedCases, judgeOutputs)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/25: Format's l is localised.
+
+// localisedCases: a free format with an unescaped l among random pieces,
+// under one of the other locales ("en" under HEGEL_NO_KNOWN=1), with the
+// Monday week start so that the twins' D is not the shape of carbon/1.
+var localisedCases = hegel.Composite(func(tc hegel.TestCase) formatCase {
+	pieces := hegel.Draw(tc, hzSeq(hzCounted(freePieces, 0, 5), hzOne(via("piece l", hegel.Just(letterPiece('l')))), hzCounted(freePieces, 0, 5)))
+	f := freeFormat{}
+	for _, p := range pieces {
+		f.f = append(f.f, p.v)
+		f.drawn = append(f.drawn, p.via)
+	}
+	return formatCase{
+		m:      hegel.Draw(tc, moments),
+		ws:     time.Monday,
+		locale: hegel.Draw(tc, hzShaped(via("locale other", hegel.SampledFrom(otherLocales)), via("locale en", hegel.Just("en")))),
+		f:      f,
+	}
+})
+
+func TestHegelFormatWeekdayNameIsLocalised(t *testing.T) {
+	judged(t, localisedCases, judgeFormat)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/12: DiffForHumans reads the "now" resource.
+
+// nowCase is a Language of a locale whose "now" resource is the words joined
+// by "|" (two or three words, the shape of carbon/12; one word under
+// HEGEL_NO_KNOWN=1) and two moments in the same second (the difference is
+// "now").
+type nowCase struct {
+	locale string
+	words  []string
+	a, b   moment
+}
+
+func (c nowCase) GoString() string {
+	return fmt.Sprintf("%s now=%q %#v -> %#v", c.locale, strings.Join(c.words, "|"), c.a, c.b)
+}
+
+var nowWords = hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz").MinSize(1).MaxSize(8)
+
+var nowCases = hegel.Composite(func(tc hegel.TestCase) nowCase {
+	a := hegel.Draw(tc, moments)
+	ns := hegel.Draw(tc, nanos)
+	return nowCase{
+		locale: hegel.Draw(tc, hegel.SampledFrom(locales)),
+		words:  hegel.Draw(tc, hzShaped(hzCounted(nowWords, 2, 3), hzOne(nowWords))),
+		a:      a,
+		b:      momentAt(a, time.Unix(a.t.Unix(), int64(ns.v)), ns.via),
+	}
+})
+
+// nowForm is the value the checks carry: "a form of now" when the text is one
+// of the words (the pin accepts either form), else the text itself.
+func nowForm(words []string, s string) string {
+	for _, w := range words {
+		if s == w {
+			return "a form of now"
+		}
+	}
+	return s
+}
+
+// nowExpected: the three difference strings of two moments in the same second
+// are a form of the "now" resource (the note: the first form), or
+// (carbon/12) a panic when the resource has more than one form
+// (language.go:198-207: translate splits on "|" and indexes slice[value-1]
+// with the value 0 of "now").
+func nowExpected(c nowCase, k known) checks {
+	want := "a form of now"
+	if k[kTranslateIndexesBelowZero] && len(c.words) > 1 {
+		want = "panic"
+	}
+	return checks{"DiffForHumans": want, "DiffInString": want, "DiffAbsInString": want}
+}
+
+func nowActual(c nowCase) checks {
+	lang := carbon.NewLanguage().SetLocale(c.locale).SetResources(map[string]string{"now": strings.Join(c.words, "|")})
+	ca, cb := carbonOf(c.a).SetLanguage(lang), carbonOf(c.b)
+	call := func(f func() string) (result string) {
+		defer func() {
+			if r := recover(); r != nil {
+				result = "panic"
+			}
+		}()
+		return nowForm(c.words, f())
+	}
+	return checks{
+		"DiffForHumans":   call(func() string { return ca.DiffForHumans(cb) }),
+		"DiffInString":    call(func() string { return ca.DiffInString(cb) }),
+		"DiffAbsInString": call(func() string { return ca.DiffAbsInString(cb) }),
+	}
+}
+
+func TestHegelDiffForHumansReadsTheNowResource(t *testing.T) {
+	judged(t, nowCases, func(j *hzCaseJudge, c nowCase) {
+		tallyDrawn("locale "+c.locale, fmt.Sprintf("words %d", len(c.words)))
+		judgeBy(j, c, nowExpected, nowActual)
+	})
+}
diff --git a/hegel_format_test.go b/hegel_format_test.go
new file mode 100644
index 0000000..1cbf2e7
--- /dev/null
+++ b/hegel_format_test.go
@@ -0,0 +1,1118 @@
+package carbon_test
+
+// The formatting and parsing properties: Format against a model of every
+// letter, Format and Layout against their documented twins, ParseByFormat
+// reading Format back, and the To...String outputs against their layouts and
+// through Parse and ParseByLayout. The records (a format as a list of pieces
+// rendered by a pure String, a round-trip format with its precision and
+// flags, an output entry with its layout and flags, a timezone argument) are
+// drawn from package-level generators over part 1's moments; each family has
+// a model expected(c, k) of every checked value that follows the recorded
+// bugs in k as replicas of the library's code (outputer.go, parser.go,
+// helper.go), and the classifier of hegel_core_test.go (shapeBy) names the
+// shape of a case from the model alone, before the library is called.
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// The letters: the documentation of Format written down.
+
+// formatLetters are every letter Format interprets.
+const formatLetters = "dDjlFmMnYyaAghHGisOPQRZuvxSUVXWNwKLtzoqc"
+
+// letterLayouts: the Go layout token of each letter that has one (the
+// documented twins; formatMap in helper.go, which format2layout copies into
+// the layout ParseByFormat parses with). The letters W, N, K, L, G, w, t, z,
+// o, q and c have no token and are rendered by Format itself.
+var letterLayouts = map[byte]string{
+	'd': "02", 'D': "Mon", 'j': "2", 'l': "Monday", 'F': "January", 'm': "01", 'M': "Jan", 'n': "1",
+	'Y': "2006", 'y': "06", 'a': "pm", 'A': "PM", 'g': "3", 'h': "03", 'H': "15", 'i': "04", 's': "05",
+	'O': "-0700", 'P': "-07:00", 'Q': "Z0700", 'R': "Z07:00", 'Z': "MST",
+	'u': "999", 'v': "999999", 'x': "999999999",
+	'S': carbon.TimestampLayout, 'U': carbon.TimestampMilliLayout, 'V': carbon.TimestampMicroLayout, 'X': carbon.TimestampNanoLayout,
+}
+
+// the letters ParseByFormat can read back (those with a Go layout token), by field
+var (
+	yearLetters   = []string{"Y", "y"}
+	monthLetters  = []string{"m", "n", "M", "F"}
+	dayLetters    = []string{"d", "j"}
+	hourLetters24 = []string{"H"}
+	hourLetters12 = []string{"g", "h"}
+	ampmLetters   = []string{"a", "A"}
+	zoneLetters   = []string{"O", "P", "Q", "R", "Z"}
+	timestampLtrs = []string{"S", "U", "V", "X"}
+)
+
+func ordinalSuffix(day int) string {
+	switch day {
+	case 1, 21, 31:
+		return "st"
+	case 2, 22:
+		return "nd"
+	case 3, 23:
+		return "rd"
+	}
+	return "th"
+}
+
+// ---------------------------------------------------------------------------
+// The locales: the library's own lang/*.json resources, read once (the test
+// runs in the module root), sorted; the model reads weeks, short_weeks,
+// months and short_months split on "|" as the library does (getResourceItem).
+
+type localeTable struct {
+	weeks, shortWeeks, months, shortMonths []string
+}
+
+var locales, localeTables = func() ([]string, map[string]localeTable) {
+	files, err := filepath.Glob("lang/*.json")
+	if err != nil || len(files) == 0 {
+		panic("no lang/*.json resources in the module root")
+	}
+	sort.Strings(files)
+	names := make([]string, 0, len(files))
+	tables := map[string]localeTable{}
+	for _, f := range files {
+		bs, err := os.ReadFile(f)
+		if err != nil {
+			panic(err)
+		}
+		var res map[string]string
+		if err := json.Unmarshal(bs, &res); err != nil {
+			panic(fmt.Sprintf("%s: %v", f, err))
+		}
+		name := strings.TrimSuffix(filepath.Base(f), ".json")
+		names = append(names, name)
+		tables[name] = localeTable{
+			weeks:       strings.Split(res["weeks"], "|"),
+			shortWeeks:  strings.Split(res["short_weeks"], "|"),
+			months:      strings.Split(res["months"], "|"),
+			shortMonths: strings.Split(res["short_months"], "|"),
+		}
+	}
+	return names, tables
+}()
+
+// otherLocales are the locales but "en".
+var otherLocales = func() []string {
+	var out []string
+	for _, l := range locales {
+		if l != "en" {
+			out = append(out, l)
+		}
+	}
+	return out
+}()
+
+// localeNames: "en" 70% of the time, one of the other 33 otherwise (a new
+// dimension of the population; the shape of carbon/25 needs the other ones).
+var localeNames = hzWeighted(
+	hzW(60, via("locale en", hegel.Just("en"))),                   // 70 nominal: weight 60 realises 68.0 to 71.2
+	hzW(45, via("locale other", hegel.SampledFrom(otherLocales))), // 30 nominal: weight 45 realises 28.8 to 32.0
+)
+
+// ---------------------------------------------------------------------------
+// Formats as pieces.
+
+// piece is one piece of a format: a letter, an escaped character, or a
+// literal run; written is its text in the format, rendered what Format prints
+// for an escaped character or a literal (a letter's value comes from the
+// model).
+type piece struct {
+	letter   byte
+	written  string
+	rendered string
+}
+
+func letterPiece(ch byte) piece  { return piece{letter: ch, written: string(ch)} }
+func escapedPiece(ch byte) piece { return piece{written: `\` + string(ch), rendered: string(ch)} }
+
+// literal is a literal of a format as the user writes it and as Format
+// renders it (`\M\S\T` renders "MST"; "1" renders "1").
+type literal struct {
+	written, rendered string
+}
+
+func literalPiece(l literal) piece { return piece{written: l.written, rendered: l.rendered} }
+
+// format is a list of pieces; String is the format text.
+type format []piece
+
+func (f format) String() string {
+	var b strings.Builder
+	for _, p := range f {
+		b.WriteString(p.written)
+	}
+	return b.String()
+}
+
+// has reports whether the format has the letter unescaped.
+func (f format) has(letter byte) bool {
+	for _, p := range f {
+		if p.letter == letter {
+			return true
+		}
+	}
+	return false
+}
+
+// parseFormat splits a format text into pieces (the twins and the pins' formats).
+func parseFormat(s string) format {
+	var f format
+	for i := 0; i < len(s); i++ {
+		switch {
+		case s[i] == '\\' && i+1 < len(s):
+			f = append(f, escapedPiece(s[i+1]))
+			i++
+		case strings.IndexByte(formatLetters, s[i]) >= 0:
+			f = append(f, letterPiece(s[i]))
+		default:
+			f = append(f, literalPiece(literal{string(s[i]), string(s[i])}))
+		}
+	}
+	return f
+}
+
+// renderLetter is the documented value of a letter for the time, the week
+// start and the locale; under carbon/1 the D is the locale's short name at the
+// day of the week counted from the week start (outputer.go:759, 105:
+// short_weeks[c.DayOfWeek()%7]); under carbon/25 the l is the English name
+// whatever the locale (outputer.go:779 formats the "Monday" token).
+func renderLetter(t time.Time, ch byte, ws time.Weekday, locale string, k known) string {
+	loc := localeTables[locale]
+	switch ch {
+	case 'd':
+		return fmt.Sprintf("%02d", t.Day())
+	case 'D':
+		if k[kWeekNamesFollowWeekStart] {
+			return loc.shortWeeks[modelDayOfWeek(t, ws)%7]
+		}
+		return loc.shortWeeks[t.Weekday()]
+	case 'j':
+		return fmt.Sprintf("%d", t.Day())
+	case 'l':
+		if k[kFormatLIsEnglish] {
+			return englishDays[t.Weekday()]
+		}
+		return loc.weeks[t.Weekday()]
+	case 'F':
+		return loc.months[t.Month()-1]
+	case 'm':
+		return fmt.Sprintf("%02d", int(t.Month()))
+	case 'M':
+		return loc.shortMonths[t.Month()-1]
+	case 'n':
+		return fmt.Sprintf("%d", int(t.Month()))
+	case 'Y':
+		return t.Format("2006")
+	case 'y':
+		return t.Format("06")
+	case 'a':
+		return t.Format("pm")
+	case 'A':
+		return t.Format("PM")
+	case 'g':
+		return t.Format("3")
+	case 'h':
+		return t.Format("03")
+	case 'H':
+		return fmt.Sprintf("%02d", t.Hour())
+	case 'G':
+		return fmt.Sprintf("%d", t.Hour())
+	case 'i':
+		return fmt.Sprintf("%02d", t.Minute())
+	case 's':
+		return fmt.Sprintf("%02d", t.Second())
+	case 'O':
+		return t.Format("-0700")
+	case 'P':
+		return t.Format("-07:00")
+	case 'Q':
+		return t.Format("Z0700")
+	case 'R':
+		return t.Format("Z07:00")
+	case 'Z':
+		return t.Format("MST")
+	case 'u':
+		return fmt.Sprintf("%03d", t.Nanosecond()/1e6)
+	case 'v':
+		return fmt.Sprintf("%06d", t.Nanosecond()/1e3)
+	case 'x':
+		return fmt.Sprintf("%09d", t.Nanosecond())
+	case 'S':
+		return fmt.Sprintf("%d", t.Unix())
+	case 'U':
+		return fmt.Sprintf("%d", t.UnixMilli())
+	case 'V':
+		return fmt.Sprintf("%d", t.UnixMicro())
+	case 'X':
+		return fmt.Sprintf("%d", t.UnixNano())
+	case 'W':
+		_, w := t.ISOWeek()
+		return fmt.Sprintf("%d", w)
+	case 'N':
+		return fmt.Sprintf("%d", modelDayOfWeek(t, ws))
+	case 'w':
+		return fmt.Sprintf("%d", modelDayOfWeek(t, ws)-1)
+	case 'K':
+		return ordinalSuffix(t.Day())
+	case 'L':
+		if isLeap(t.Year()) {
+			return "1"
+		}
+		return "0"
+	case 't':
+		return fmt.Sprintf("%d", daysIn(t.Year(), t.Month()))
+	case 'z':
+		return t.Location().String()
+	case 'o':
+		_, off := t.Zone()
+		return fmt.Sprintf("%d", off)
+	case 'q':
+		return fmt.Sprintf("%d", modelQuarter(t.Month()))
+	case 'c':
+		return fmt.Sprintf("%d", t.Year()/100+1)
+	}
+	panic("renderLetter: not a format letter: " + string(ch))
+}
+
+// modelFormat renders a format: the letters by their documented meanings
+// (renderLetter), the escaped characters and literals as written.
+func modelFormat(t time.Time, f format, ws time.Weekday, locale string, k known) string {
+	var b strings.Builder
+	for _, p := range f {
+		if p.letter != 0 {
+			b.WriteString(renderLetter(t, p.letter, ws, locale, k))
+		} else {
+			b.WriteString(p.rendered)
+		}
+	}
+	return b.String()
+}
+
+// format2layoutReplica is the library's conversion of a format into the Go
+// layout ParseByFormat parses with (helper.go:93-130): a letter's token, an
+// escaped character and every other character copied verbatim, so that a
+// literal that spells a token is read as a field (carbon/13).
+func format2layoutReplica(format string) string {
+	var b strings.Builder
+	for i := 0; i < len(format); i++ {
+		if layout, ok := letterLayouts[format[i]]; ok {
+			b.WriteString(layout)
+			continue
+		}
+		if format[i] == '\\' {
+			if i+1 < len(format) {
+				b.WriteByte(format[i+1])
+				i++
+			}
+			continue
+		}
+		b.WriteByte(format[i])
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Free formats: any pieces, for the Format property (genFreeFormat's shape:
+// one to twelve pieces, a letter 80%, an escaped letter 10%, a literal from
+// the pool 10%, the pool byte for byte).
+
+var freePieces = hzWeighted(
+	hzW(74, via("piece letter", hegel.Map(hzInts(0, len(formatLetters)-1), func(i int) piece { return letterPiece(formatLetters[i]) }))),                                                   // 80 nominal: weight 74 realises 79.7 to 81.0
+	hzW(13, via("piece escaped", hegel.Map(hzInts(0, len(formatLetters)-1), func(i int) piece { return escapedPiece(formatLetters[i]) }))),                                                 // 10 nominal: weight 13 realises 9.1 to 10.5
+	hzW(13, via("piece literal", hegel.Map(hzSampled(" ", "-", ":", "/", ".", ",", "'", "[", "]", "|", "1", "0", "_", "*"), func(s string) piece { return literalPiece(literal{s, s}) }))), // 10 nominal: weight 13 realises 9.6 to 10.8
+)
+
+// freeFormat is a free format and the alternatives its pieces came from.
+type freeFormat struct {
+	f     format
+	drawn []string
+}
+
+var freeFormats = hegel.Map(hzCounted(freePieces, 1, 12), func(ps []tagged[piece]) freeFormat {
+	out := freeFormat{}
+	for _, p := range ps {
+		out.f = append(out.f, p.v)
+		out.drawn = append(out.drawn, p.via)
+	}
+	return out
+})
+
+// twins are the layout constants and their format twins, which print the same
+// in the English locale (the documentation's pairs).
+var twins = []struct{ name, layout, format string }{
+	{"DateTime", carbon.DateTimeLayout, carbon.DateTimeFormat}, {"Date", carbon.DateLayout, carbon.DateFormat}, {"Time", carbon.TimeLayout, carbon.TimeFormat},
+	{"ShortDateTime", carbon.ShortDateTimeLayout, carbon.ShortDateTimeFormat}, {"RFC3339", carbon.RFC3339Layout, carbon.RFC3339Format}, {"ISO8601", carbon.ISO8601Layout, carbon.ISO8601Format},
+	{"RFC1123", carbon.RFC1123Layout, carbon.RFC1123Format}, {"RFC822Z", carbon.RFC822ZLayout, carbon.RFC822ZFormat}, {"Cookie", carbon.CookieLayout, carbon.CookieFormat},
+	{"Kitchen", carbon.KitchenLayout, carbon.KitchenFormat}, {"RFC850", carbon.RFC850Layout, carbon.RFC850Format}, {"Http", carbon.HttpLayout, carbon.HttpFormat},
+	{"FormattedDate", carbon.FormattedDateLayout, carbon.FormattedDateFormat}, {"DayDateTime", carbon.DayDateTimeLayout, carbon.DayDateTimeFormat},
+}
+
+// formatCase is a moment, a week start, a locale and a free format.
+type formatCase struct {
+	m      moment
+	ws     time.Weekday
+	locale tagged[string]
+	f      freeFormat
+}
+
+func (c formatCase) GoString() string {
+	return fmt.Sprintf("%#v Format(%q) weekStartsAt=%s locale=%s", c.m, c.f.f.String(), c.ws, c.locale.v)
+}
+
+var formatCases = hegel.Composite(func(tc hegel.TestCase) formatCase {
+	return formatCase{m: hegel.Draw(tc, moments), ws: hegel.Draw(tc, weekStarts), locale: hegel.Draw(tc, localeNames), f: hegel.Draw(tc, freeFormats)}
+})
+
+// formatExpected: Format of the free format by the model, each twin format by
+// the model and each twin layout by Go (the two print the same in the English
+// locale with the default week start, and under a locale the twin's D, l, F
+// and M follow it).
+func formatExpected(c formatCase, k known) checks {
+	out := checks{}
+	out["Format"] = modelFormat(c.m.t, c.f.f, c.ws, c.locale.v, k)
+	for _, tw := range twins {
+		out["Format "+tw.name] = modelFormat(c.m.t, parseFormat(tw.format), c.ws, c.locale.v, k)
+		out["Layout "+tw.name] = c.m.t.Format(tw.layout)
+	}
+	return out
+}
+
+func formatActual(c formatCase) checks {
+	cb := carbonOf(c.m)
+	cb.SetWeekStartsAt(c.ws)
+	cb.SetLocale(c.locale.v)
+	out := checks{}
+	out["Format"] = cb.Format(c.f.f.String())
+	for _, tw := range twins {
+		out["Format "+tw.name] = cb.Format(tw.format)
+		out["Layout "+tw.name] = cb.Layout(tw.layout)
+	}
+	return out
+}
+
+// dropShaped deletes from want, under HEGEL_NO_KNOWN=1, the checks that any
+// switch of the model moves (counted as "dropped carbon/N"): the shapes of
+// carbon/1 and 25 are checks of a case (a D under a week start, an l under a
+// locale, in the free format or in a twin) whose other checks still run.
+func dropShaped[T any](c T, expected func(T, known) checks, want checks) {
+	none := expected(c, hzKnownNone)
+	for i := 0; i < hzKnownCount; i++ {
+		only := expected(c, hzKnownOnly(i))
+		dropped := false
+		for _, name := range sortedKeys(none) {
+			if only[name] != none[name] {
+				delete(want, name)
+				dropped = true
+			}
+		}
+		if dropped {
+			hzTally("dropped " + hzKnownID(i))
+		}
+	}
+}
+
+// judgeFormat: the shape of carbon/1 (a D with a non-Monday week start) or
+// carbon/25 (an l under a locale other than English) is named by default;
+// under HEGEL_NO_KNOWN=1 the checks they move are dropped and the case goes on.
+func judgeFormat(j *hzCaseJudge, c formatCase) {
+	tallyDrawn(append(append(c.m.drawn, c.locale.via), c.f.drawn...)...)
+	shape := classify(j, c, formatExpected)
+	want := formatExpected(c, hzKnownNone)
+	if hzNoKnown {
+		dropShaped(c, formatExpected, want)
+	} else {
+		j.Shape(shape)
+	}
+	verdict(j, c, formatActual(c), want, shape, formatExpected)
+}
+
+func TestHegelFormatAgreesWithModel(t *testing.T) {
+	judged(t, formatCases, judgeFormat)
+}
+
+// ---------------------------------------------------------------------------
+// Round-trip formats: formats ParseByFormat can read back (genFormat's shape).
+
+// roundTripFormat is a format whose letters have Go tokens: the precision it
+// keeps, whether it fixes the instant (a zone letter or a timestamp) or only
+// the wall clock, and the flags of the Go time limits.
+type roundTripFormat struct {
+	f         format
+	precision int64 // 1e9 seconds, 1e6 millis, 1e3 micros, 1 nanos
+	instant   bool
+	twoDigitY bool
+	weekday   bool
+	zone      byte // the zone letter, or 0
+	timestamp byte // the timestamp letter when the format is one alone, or 0
+	drawn     []string
+}
+
+func (f roundTripFormat) String() string { return f.f.String() }
+
+// pastEscapes are today's escaped letters appended to a separator (no Go
+// token is spelled by them); shapeEscapes are the literals that spell a Go
+// layout token once copied into the layout (the shape of carbon/13): raw
+// digits, and letters spelled with backslashes. Every character of a spelled
+// token is escaped so that none is read as a format letter. A token read
+// before its field is overridden by the field (a "01" before the m parses
+// right), so the shape in a separator reaches the bug only for the tokens of
+// no field (MST, -07, Z07, PM) or of a field already read; the narrow
+// property appends the literal after every field. The weekday tokens (Mon,
+// Monday) are not in the pool: Go's parser reads and ignores a weekday name.
+var (
+	pastEscapes  = []literal{{`\T`, "T"}, {`\a`, "a"}, {`\d`, "d"}, {`\Y`, "Y"}, {`\x`, "x"}, {`\Z`, "Z"}}
+	shapeEscapes = []literal{
+		{"1", "1"}, {"01", "01"}, {"2", "2"}, {"02", "02"}, {"06", "06"}, {"15", "15"},
+		{`\M\S\T`, "MST"}, {`\J\a\n`, "Jan"}, {`\P\M`, "PM"}, {`\p\m`, "pm"},
+		{"-07", "-07"}, {`\Z07`, "Z07"}, {`\J\a\n\u\a\r\y`, "January"},
+	}
+)
+
+// separatorEscapes: the escape appended to a separator one time in ten: one
+// past the shape, or (carbon/13) one of the shape.
+var separatorEscapes = hzWeighted(
+	hzW(38, via("escape past", hegel.SampledFrom(pastEscapes))),                        // 50 nominal: weight 38 realises 49.1 to 52.5
+	hzW(hzUnless(hzNoKnown, 62), via("escape shape", hegel.SampledFrom(shapeEscapes))), // 50 nominal: weight 62 realises 47.5 to 50.9
+)
+
+// noTail is the empty trailing literal of the plain round-trip formats.
+var noTail = hegel.Just(tagged[literal]{})
+
+// separators: one of today's pool (byte for byte: the space and the hyphen
+// twice), with an escape appended 10% of the time.
+var separators = hegel.Composite(func(tc hegel.TestCase) tagged[literal] {
+	base := hegel.Draw(tc, hzSampled("-", "/", " ", ", ", ":", ".", " ", "-"))
+	if !hegel.Draw(tc, hzCoin(13)) { // 10 nominal: a coin of 13 realises 8.3 to 10.7 (the escape, over the two separators)
+		return tagged[literal]{v: literal{base, base}, via: "separator plain"}
+	}
+	e := hegel.Draw(tc, separatorEscapes)
+	return tagged[literal]{v: literal{base + e.v.written, base + e.v.rendered}, via: e.via}
+})
+
+func lettersOf(s string) format {
+	var f format
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(formatLetters, s[i]) >= 0 {
+			f = append(f, letterPiece(s[i]))
+		} else {
+			f = append(f, literalPiece(literal{string(s[i]), string(s[i])}))
+		}
+	}
+	return f
+}
+
+var (
+	yearLetterList    = weightedOver([]int{2, 3}, yearLetters...)          // 2 at 50 nominal: realises 48.3 to 51.7
+	monthLetterList   = weightedOver([]int{2, 3, 3, 5}, monthLetters...)   // 4 at 25 nominal: realises 19.6 to 29.7 (the lumps of a run)
+	dayLetterList     = weightedOver([]int{2, 3}, dayLetters...)           // 2 at 50 nominal: realises 49 to 51
+	hour12List        = weightedOver([]int{2, 4}, hourLetters12...)        // 2 at 50 nominal: realises 47.8 to 56.9 for g
+	ampmList          = weightedOver([]int{2, 5}, ampmLetters...)          // 2 at 50 nominal: realises 44.8 to 54.8 for a
+	zoneLetterList    = weightedOver([]int{3, 4, 4, 5, 6}, zoneLetters...) // 5 at 20 nominal: realises 16.1 to 23.5
+	weekdayLetterList = weightedOver([]int{2, 3}, "D", "l")                // 2 at 50 nominal: realises 43.6 to 46.1 for D
+	fractionList      = weightedOver([]int{5, 4, 5, 4}, "", "u", "v", "x") // none 2 in 5, each letter 1 in 5: realises 40.5, 21.0, 15.1 to 17.1, 18.5
+)
+
+// plainRoundTripsWith: a date part of a year letter from years, month and
+// day letters in one of two orders joined by the two drawn separators, a weekday 30% of the time, a
+// time part with the 24-hour clock 60% or the 12-hour one with am/pm, a
+// fraction letter two times in five, a zone letter half the time, and the
+// drawn trailing literal after everything (none in the wide property).
+func plainRoundTripsWith(first, second, tail hegel.Generator[tagged[literal]], years hegel.Generator[string]) hegel.Generator[roundTripFormat] {
+	return hegel.Composite(func(tc hegel.TestCase) roundTripFormat {
+		return drawPlainRoundTrip(tc, first, second, tail, years)
+	})
+}
+
+// plainRoundTrips: the plain round-trip formats with today's separators.
+var plainRoundTrips = plainRoundTripsWith(separators, separators, noTail, yearLetterList)
+
+func drawPlainRoundTrip(tc hegel.TestCase, first, second, tail hegel.Generator[tagged[literal]], years hegel.Generator[string]) roundTripFormat {
+	spec := roundTripFormat{precision: 1e9}
+	y := hegel.Draw(tc, years)
+	spec.twoDigitY = y == "y"
+	date := []string{y, hegel.Draw(tc, monthLetterList), hegel.Draw(tc, dayLetterList)}
+	spec.drawn = append(spec.drawn, "year "+y, "month "+date[1], "day "+date[2])
+	if hegel.Draw(tc, hzCoin(39)) { // 30 nominal: a coin of 39 realises 29.9 to 31.4
+		date[0], date[2] = date[2], date[0]
+		spec.drawn = append(spec.drawn, "date swapped")
+	}
+	sep1, sep2 := hegel.Draw(tc, first), hegel.Draw(tc, second)
+	spec.drawn = append(spec.drawn, sep1.via, sep2.via)
+	f := format{letterPiece(date[0][0]), literalPiece(sep1.v), letterPiece(date[1][0]), literalPiece(sep2.v), letterPiece(date[2][0])}
+	if hegel.Draw(tc, hzCoin(39)) { // 30 nominal: a coin of 39 realises 27.9 to 28.3
+		spec.weekday = true
+		wd := hegel.Draw(tc, weekdayLetterList)
+		f = append(f, literalPiece(literal{" ", " "}), letterPiece(wd[0]))
+		spec.drawn = append(spec.drawn, "weekday "+wd)
+	}
+	var tm string
+	if hegel.Draw(tc, hzCoin(78)) { // 60 nominal: a coin of 78 realises 56.7 to 61.3
+		tm = "H:i:s"
+		spec.drawn = append(spec.drawn, "clock 24-hour")
+	} else {
+		h, ap := hegel.Draw(tc, hour12List), hegel.Draw(tc, ampmList)
+		tm = h + ":i:s" + hegel.Draw(tc, hzSampled(" ", "")) + ap
+		spec.drawn = append(spec.drawn, "clock 12-hour", "hour "+h, "ampm "+ap)
+	}
+	frac := hegel.Draw(tc, fractionList)
+	spec.drawn = append(spec.drawn, "fraction "+frac)
+	switch frac {
+	case "u":
+		tm, spec.precision = strings.Replace(tm, ":s", ":s.u", 1), 1e6
+	case "v":
+		tm, spec.precision = strings.Replace(tm, ":s", ":s.v", 1), 1e3
+	case "x":
+		tm, spec.precision = strings.Replace(tm, ":s", ":s.x", 1), 1
+	}
+	f = append(f, literalPiece(literal{" ", " "}))
+	f = append(f, lettersOf(tm)...)
+	if hegel.Draw(tc, hzCoin(66)) { // 50 nominal: a coin of 66 realises 45.2 to 48.5 (64 realised 41.9 to 46.7, 68 53.6)
+		spec.zone = hegel.Draw(tc, zoneLetterList)[0]
+		spec.instant = true
+		f = append(f, literalPiece(literal{" ", " "}), letterPiece(spec.zone))
+		spec.drawn = append(spec.drawn, "zone letter", "zone "+string(spec.zone))
+	}
+	if t := hegel.Draw(tc, tail); t.v.written != "" {
+		f = append(f, literalPiece(t.v))
+		spec.drawn = append(spec.drawn, t.via)
+	}
+	spec.f = f
+	return spec
+}
+
+// timestampRoundTrips: a timestamp letter alone (the shape of carbon/10: the
+// instant at the letter's precision, which ParseByFormat cannot read). A
+// timestamp beside other fields is not drawn: the documentation does not say
+// which field would decide the instant.
+var timestampRoundTrips = hegel.Map(weightedOver([]int{2, 4, 5, 5}, timestampLtrs...), func(s string) roundTripFormat {
+	precision := map[string]int64{"S": 1e9, "U": 1e6, "V": 1e3, "X": 1}[s]
+	return roundTripFormat{f: format{letterPiece(s[0])}, precision: precision, instant: true, timestamp: s[0], drawn: []string{"timestamp " + s}}
+})
+
+// roundTripFormats: a plain format, or (5% nominal, zero under
+// HEGEL_NO_KNOWN=1) a timestamp letter alone.
+var roundTripFormats = hzWeighted(
+	hzW(95, plainRoundTrips),                         // 95 nominal: realises 94.1 to 94.8
+	hzW(hzUnless(hzNoKnown, 7), timestampRoundTrips), // 5 nominal: weight 7 realises 5.2 to 5.9 (6 realised 2.7 to 4.4)
+)
+
+// roundTripCase is a moment and a round-trip format.
+type roundTripCase struct {
+	m moment
+	f roundTripFormat
+}
+
+func (c roundTripCase) GoString() string { return fmt.Sprintf("%#v Format(%q)", c.m, c.f.String()) }
+
+// alphaAbbrev reports whether the zone abbreviation is letters only (Go
+// cannot parse "+0545" or "-03" through the MST token).
+func alphaAbbrev(tm time.Time) bool {
+	name, _ := tm.Zone()
+	for _, r := range name {
+		if r < 'A' || r > 'Z' {
+			return false
+		}
+	}
+	return name != ""
+}
+
+// roundTripLimit names the Go time limit a case meets, or "": a two-digit
+// year outside 1969-2068, a Z letter on a non-alphabetic abbreviation, a
+// sub-minute (LMT) offset with a zone letter, a nanosecond timestamp outside
+// 1700-2200 (int64). These are not known-bug gates and stay.
+func roundTripLimit(c roundTripCase) string {
+	tm, f := c.m.t, c.f
+	_, off := tm.Zone()
+	switch {
+	case f.twoDigitY && (tm.Year() < 1969 || tm.Year() > 2068):
+		return "two-digit-year-out-of-range"
+	case f.zone == 'Z' && !alphaAbbrev(tm):
+		return "abbreviation-not-alphabetic"
+	case f.zone != 0 && off%60 != 0:
+		return "sub-minute-offset"
+	case f.timestamp == 'X' && (tm.Year() < 1700 || tm.Year() > 2200):
+		return "nano-timestamp-out-of-range"
+	}
+	return ""
+}
+
+// withinLimits: the cases of g within the Go time limits (the cases past a
+// limit are filtered out, counted by the limit's name).
+func withinLimits(g hegel.Generator[roundTripCase]) hegel.Generator[roundTripCase] {
+	return hzOnly(true, "go-time-limit", g, func(c roundTripCase) bool {
+		if limit := roundTripLimit(c); limit != "" {
+			hzTally("limit " + limit)
+			return false
+		}
+		return true
+	})
+}
+
+// roundTripCasesOf: a moment and a format from formats.
+func roundTripCasesOf(formats hegel.Generator[roundTripFormat]) hegel.Generator[roundTripCase] {
+	return hegel.Composite(func(tc hegel.TestCase) roundTripCase {
+		return roundTripCase{m: hegel.Draw(tc, moments), f: hegel.Draw(tc, formats)}
+	})
+}
+
+// roundTripCases: a moment and a round-trip format within the Go time limits
+// (about 16% are filtered out).
+var roundTripCases = withinLimits(roundTripCasesOf(roundTripFormats))
+
+// truncTo is the instant truncated to the precision (nanoseconds, or
+// seconds for 1e9 and above), on the instant itself rather than through
+// time.Date on the wall clock, which in the hour a zone repeats when its
+// summer time ends may pick the other offset.
+func truncTo(tm time.Time, precision int64) time.Time {
+	ns := int64(tm.Nanosecond())
+	if precision < 1e9 {
+		return tm.Add(-time.Duration(ns % precision))
+	}
+	_, _, sec := tm.Clock()
+	return tm.Add(-time.Duration(ns) - time.Duration(int64(sec)%(precision/1e9))*time.Second)
+}
+
+const wallLayout = "2006-01-02 15:04:05.999999999"
+
+// parsedForm prints what a round-trip format recovers: the instant when the
+// format fixes it, else the wall clock in the zone.
+func parsedForm(f roundTripFormat, t time.Time, loc *time.Location) string {
+	if f.instant {
+		return stampInstant(t)
+	}
+	return t.In(loc).Format(wallLayout)
+}
+
+// goParse is Go's parse of s with the layout in loc, in the form of the
+// round-trip checks: the value and the zone the result reports.
+func goParse(f roundTripFormat, layout, s string, loc *time.Location, zone string) (string, string) {
+	tt, err := time.ParseInLocation(layout, s, loc)
+	if err != nil {
+		return "error", ""
+	}
+	return parsedForm(f, tt, loc), zone
+}
+
+// roundTripExpected: ParseByFormat (and ParseByFormats with the format among
+// two wrong ones) recover the instant, or the wall clock, to the format's
+// precision, in the zone; or (carbon/13) the parse is Go's with the layout
+// format2layout makes of the format (parser.go:84-85), which reads a copied
+// literal as a field; or (carbon/10) a timestamp letter is a pseudo-layout
+// time.ParseInLocation rejects (parser.go:85 with "unix"), except that
+// ParseByFormats' first try, "Y", reads a four-digit timestamp as a year.
+func roundTripExpected(c roundTripCase, k known) checks {
+	tm, f := c.m.t, c.f
+	loc := tm.Location()
+	out := checks{}
+	if f.timestamp != 0 && k[kUnixLayoutsUnreadable] {
+		out["ParseByFormat"], out["ParseByFormats"], out["zone"] = "error", "error", ""
+		// ParseByFormats tries "Y" first: a timestamp of exactly four digits
+		// (the seconds 1000 to 9999 after the epoch, and so on) reads as a year.
+		out["ParseByFormats"], _ = goParse(f, "2006", timestampText(letterLayouts[f.timestamp], tm), loc, c.m.zone)
+		return out
+	}
+	if k[kFormatLiteralsUnprotected] {
+		s := modelFormat(tm, f.f, time.Monday, "en", hzKnownNone)
+		v, zone := goParse(f, format2layoutReplica(f.String()), s, loc, c.m.zone)
+		out["ParseByFormat"], out["zone"] = v, zone
+		out["ParseByFormats"] = "error"
+		for _, alt := range []string{"Y", f.String(), "H:i"} {
+			if v, _ := goParse(f, format2layoutReplica(alt), s, loc, c.m.zone); v != "error" {
+				out["ParseByFormats"] = v
+				break
+			}
+		}
+		return out
+	}
+	want := parsedForm(f, truncTo(tm, f.precision), loc)
+	out["ParseByFormat"], out["ParseByFormats"], out["zone"] = want, want, c.m.zone
+	return out
+}
+
+func roundTripActual(c roundTripCase) checks {
+	tm, f := c.m.t, c.f
+	loc := tm.Location()
+	s := carbonOf(c.m).Format(f.String())
+	out := checks{}
+	read := func(back *carbon.Carbon) (string, string) {
+		if back == nil {
+			return "<nil>", ""
+		}
+		if back.HasError() {
+			return "error", back.Timezone()
+		}
+		return parsedForm(f, back.StdTime(), loc), back.Timezone()
+	}
+	out["ParseByFormat"], out["zone"] = read(carbon.ParseByFormat(s, f.String(), c.m.zone))
+	out["ParseByFormats"], _ = read(carbon.ParseByFormats(s, []string{"Y", f.String(), "H:i"}, c.m.zone))
+	return out
+}
+
+func TestHegelFormatParsesBack(t *testing.T) {
+	judged(t, roundTripCases, func(j *hzCaseJudge, c roundTripCase) {
+		tallyDrawn(append(c.m.drawn, c.f.drawn...)...)
+		judgeBy(j, c, roundTripExpected, roundTripActual)
+	})
+}
