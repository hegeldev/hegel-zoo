+// ---------------------------------------------------------------------------
+// carbon/3: the difference in days counts calendar days.
+
+// transition is a change of a zone's offset: the first instant with the new
+// offset and the change in seconds.
+type transition struct {
+	at    time.Time
+	delta int
+}
+
+// zoneTransitions: the offset changes of every zone from 1971 to 2037, found
+// by scanning the days and bisecting the second.
+var zoneTransitions = func() map[string][]transition {
+	out := map[string][]transition{}
+	for _, name := range zoneNames {
+		loc := zones[name]
+		offsetAt := func(unix int64) int {
+			_, off := time.Unix(unix, 0).In(loc).Zone()
+			return off
+		}
+		day := time.Date(1971, time.January, 1, 0, 0, 0, 0, loc).Unix()
+		end := time.Date(2038, time.January, 1, 0, 0, 0, 0, loc).Unix()
+		for ; day < end; day += 86400 {
+			before, after := offsetAt(day), offsetAt(day+86400)
+			if before == after {
+				continue
+			}
+			lo, hi := day, day+86400
+			for lo+1 < hi {
+				mid := (lo + hi) / 2
+				if offsetAt(mid) == before {
+					lo = mid
+				} else {
+					hi = mid
+				}
+			}
+			out[name] = append(out[name], transition{at: time.Unix(hi, 0).In(loc), delta: after - before})
+		}
+	}
+	return out
+}()
+
+// transitionZones: the zones with an offset change, in the order of zoneNames.
+var transitionZones = func() []string {
+	var names []string
+	for _, name := range zoneNames {
+		if len(zoneTransitions[name]) > 0 {
+			names = append(names, name)
+		}
+	}
+	return names
+}()
+
+// dstPair is a pair of moments k calendar days apart around a transition of
+// their zone (or, under HEGEL_NO_KNOWN=1, twenty days before it).
+type dstPair struct {
+	pairCase
+	zone  string
+	at    transition
+	k, u  int
+	delta int
+}
+
+func (c dstPair) GoString() string {
+	return fmt.Sprintf("%#v (%s changes by %ds at %s; %d calendar days)", c.pairCase, c.zone, c.at.delta, showTime(c.at.at), c.k)
+}
+
+// dstPairs: a zone with transitions and one of them; the start u seconds (up
+// to three days) before it, the end k (4 to 10) calendar days after the start
+// and then a fraction of the change past: short of the change when the clocks
+// went forward (the elapsed seconds fall a day short of the calendar), back
+// into the previous day by up to the change when they went back (the
+// calendar falls a day short of the seconds); half the pairs reversed.
+var dstPairs = hegel.Composite(func(tc hegel.TestCase) dstPair {
+	zone := hegel.Draw(tc, hegel.SampledFrom(transitionZones))
+	tr := hegel.Draw(tc, hegel.SampledFrom(zoneTransitions[zone]))
+	u := hegel.Draw(tc, hzInts(1, 3*86400)) + hzShaped(0, 20*86400)
+	k := hegel.Draw(tc, hzInts(4, 10))
+	delta := hegel.Draw(tc, hzInts(1, abs(tr.delta)))
+	if tr.delta > 0 {
+		delta--
+	} else {
+		delta = -delta
+	}
+	s := moment{zone: zone, t: time.Unix(tr.at.Unix()-int64(u), 0).In(zones[zone])}
+	e := momentAt(s, s.t.AddDate(0, 0, k).Add(time.Duration(delta)*time.Second))
+	pair := pairCase{a: s, b: e}
+	if hegel.Draw(tc, hzCoin(50)) {
+		pair = pairCase{a: e, b: s}
+	}
+	return dstPair{pairCase: pair, zone: zone, at: tr, k: k, u: u, delta: delta}
+})
+
+func abs(x int) int {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
+
+func dstExpected(c dstPair, k known) checks { return smallUnitsExpected(c.pairCase, k) }
+
+func dstActual(c dstPair) checks { return smallUnitsActual(c.pairCase) }
+
+func TestHegelDiffInDaysCountsCalendarDays(t *testing.T) {
+	judged(t, dstPairs, func(j *hzCaseJudge, c dstPair) {
+		tallyDrawn("zone " + c.zone)
+		judgeBy(j, c, dstExpected, dstActual)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// carbon/4: the difference in years and months is zone independent.
+
+// zonePair is a pair of instants less than the offset difference of two zones
+// apart, straddling a month start in the zone ahead: the end in the zone
+// ahead (where the month has begun) and the start, later, in the zone behind
+// (where it has not), or under HEGEL_NO_KNOWN=1 both in the zone behind.
+type zonePair struct {
+	pairCase
+	ahead, behind string
+	gap, eps      int
+}
+
+func (c zonePair) GoString() string {
+	return fmt.Sprintf("%#v (%s is %ds ahead of %s at the month start; the end %ds in, the start %ds later)", c.pairCase, c.ahead, c.offsetDifference(), c.behind, c.gap, c.eps)
+}
+
+func (c zonePair) offsetDifference() int {
+	_, a := c.b.t.In(zones[c.ahead]).Zone()
+	_, b := c.b.t.In(zones[c.behind]).Zone()
+	return a - b
+}
+
+// zonePairs: a year and a month (January a third of the time, where the year
+// changes too) and two zones; the one ahead at that month's start is the end's
+// zone; the end is gap seconds into the month there, the start eps seconds
+// later, both less than the offset difference, so that in the zone behind
+// both fall in the previous month. The two zones must differ in offset there
+// (filtered by the classifier otherwise: the same zone, or UTC and London in
+// winter).
+var zonePairs = regionOf("carbon/4", zonePairExpected, hegel.Composite(func(tc hegel.TestCase) zonePair {
+	y := hegel.Draw(tc, years)
+	m := time.Month(hegel.Draw(tc, hzWeighted(hzW(1, hegel.Just(1)), hzW(2, months))))
+	zoneA, zoneB := hegel.Draw(tc, zoneList), hegel.Draw(tc, zoneList)
+	start := time.Date(y.v, m, 1, 0, 0, 0, 0, zones[zoneA])
+	_, offA := start.Zone()
+	_, offB := start.In(zones[zoneB]).Zone()
+	if offA < offB {
+		zoneA, zoneB, offA, offB = zoneB, zoneA, offB, offA
+		start = time.Date(y.v, m, 1, 0, 0, 0, 0, zones[zoneA])
+	}
+	d := offA - offB
+	if d < 2 {
+		d = 2 // no region: the classifier rejects the case
+	}
+	gap := hegel.Draw(tc, hzInts(0, d-2))
+	eps := hegel.Draw(tc, hzInts(1, d-1-gap))
+	endZone := hzShaped(zoneA, zoneB)
+	e := moment{zone: endZone, t: start.Add(time.Duration(gap) * time.Second).In(zones[endZone]), drawn: []string{y.via}}
+	s := moment{zone: zoneB, t: start.Add(time.Duration(gap+eps) * time.Second).In(zones[zoneB])}
+	return zonePair{pairCase: pairCase{a: s, b: e}, ahead: zoneA, behind: zoneB, gap: gap, eps: eps}
+}))
+
+func zonePairExpected(c zonePair, k known) checks { return yearsExpected(c.pairCase, k) }
+
+func zonePairActual(c zonePair) checks { return yearsActual(c.pairCase) }
+
+func TestHegelDiffInYearsIsZoneIndependent(t *testing.T) {
+	judged(t, zonePairs, func(j *hzCaseJudge, c zonePair) {
+		tallyDrawn(c.b.drawn...)
+		judgeBy(j, c, zonePairExpected, zonePairActual)
+	})
+}
