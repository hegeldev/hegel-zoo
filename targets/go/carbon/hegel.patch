+// carbon/8: ToHttpString and ToIso8601Zulu*String print local time with a UTC marker.
+func TestHegelPinZuluAndHttpStringsAreUtc(t *testing.T) {
+	c := carbon.CreateFromDateTime(2024, 1, 1, 12, 0, 0, "Asia/Tokyo") // 03:00 UTC
+	if got := c.ToIso8601ZuluString(); got != "2024-01-01T03:00:00Z" {
+		t.Errorf("ToIso8601ZuluString = %q, want 2024-01-01T03:00:00Z", got)
+	}
+	if got := c.ToIso8601ZuluMilliString(); got != "2024-01-01T03:00:00Z" && got != "2024-01-01T03:00:00.000Z" {
+		t.Errorf("ToIso8601ZuluMilliString = %q, want 2024-01-01T03:00:00Z", got)
+	}
+	if got := c.ToHttpString(); got != "Mon, 01 Jan 2024 03:00:00 GMT" {
+		t.Errorf("ToHttpString = %q, want \"Mon, 01 Jan 2024 03:00:00 GMT\"", got)
+	}
+}
