+func TestHegelClockAdditionAgreesWithUnix(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		// amounts up to about 9500 years in every unit
