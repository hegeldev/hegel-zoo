+// modelDiffUnit is the first non-zero unit of the difference, largest
+// first, as DiffForHumans documents ("1 year", "3 months", ...).
+func modelDiffUnit(a, b time.Time) (unit string, value int64) {
+	sign := int64(1)
+	s, e := a, b
+	if b.Before(a) {
+		s, e, sign = b, a, -1
+	}
+	whole := func(step func(time.Time, int) time.Time) int64 {
+		lo, hi := int64(0), int64(1)
+		for !step(s, int(hi)).After(e) {
+			hi *= 2
+		}
+		for lo+1 < hi {
+			mid := (lo + hi) / 2
+			if step(s, int(mid)).After(e) {
+				hi = mid
+			} else {
+				lo = mid
+			}
+		}
+		return lo
+	}
+	if y := whole(func(t time.Time, k int) time.Time { return t.AddDate(k, 0, 0) }); y > 0 {
+		return "year", sign * y
+	}
+	if m := whole(func(t time.Time, k int) time.Time { return t.AddDate(0, k, 0) }); m > 0 {
+		return "month", sign * m
+	}
+	secs := e.Unix() - s.Unix()
+	switch {
+	case secs/604800 > 0:
+		return "week", sign * (secs / 604800)
+	case secs/86400 > 0:
+		return "day", sign * (secs / 86400)
+	case secs/3600 > 0:
+		return "hour", sign * (secs / 3600)
+	case secs/60 > 0:
+		return "minute", sign * (secs / 60)
+	case secs > 0:
+		return "second", sign * secs
+	}
+	return "now", 0
+}
