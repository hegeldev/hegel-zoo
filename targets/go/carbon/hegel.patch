+// carbon/6: AddHours..AddNanoseconds multiply into a time.Duration.
+func TestHegelPinAddHoursBeyondDurationRange(t *testing.T) {
+	c := carbon.CreateFromDate(2000, 1, 1, "UTC")
+	want := time.Unix(c.Timestamp()+3000000*3600, 0).UTC() // 2342-02-28
+	if got := c.AddHours(3000000); !got.StdTime().Equal(want) {
+		t.Errorf("AddHours(3000000) = %s, want %s", got.ToDateTimeString(), want.Format("2006-01-02 15:04:05"))
+	}
+	want = time.Unix(c.Timestamp()+10000000000, 0).UTC() // 2316-11-21
+	if got := c.AddSeconds(10000000000); !got.StdTime().Equal(want) {
+		t.Errorf("AddSeconds(1e10) = %s, want %s", got.ToDateTimeString(), want.Format("2006-01-02 15:04:05"))
+	}
+}
+
+// carbon/7: AddDuration with a bad string sets Error on the receiver.
+func TestHegelPinAddDurationErrorStaysOnResult(t *testing.T) {
+	c := carbon.CreateFromDate(2000, 1, 1, "UTC")
+	r := c.AddDuration("bogus")
+	if r == nil || !r.HasError() {
+		t.Fatalf("AddDuration(\"bogus\") did not fail")
+	}
+	if c.HasError() || c.ToDateString() != "2000-01-01" {
+		t.Errorf("the receiver was poisoned: error %v, date %q", c.Error, c.ToDateString())
+	}
+}
