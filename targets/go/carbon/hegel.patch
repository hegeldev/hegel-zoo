+// zeroReceivers: the ways to a Carbon at the zero time: the zero struct (the
+// shape of carbon/11) or, under HEGEL_NO_KNOWN=1, the creators.
+var zeroReceivers = map[string]func() *carbon.Carbon{
+	"Carbon{}":               func() *carbon.Carbon { return &carbon.Carbon{} },
+	"NewCarbon(time.Time{})": func() *carbon.Carbon { return carbon.NewCarbon(time.Time{}) },
+	"ZeroValue()":            func() *carbon.Carbon { return carbon.ZeroValue() },
+}
