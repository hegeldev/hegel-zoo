+	}
+	gy, gm, gd, gh, gmi, gs := cb.DateTime()
+	out.set("DateTime", []int{gy, gm, gd, gh, gmi, gs})
+	gy, gm, gd, gh, gmi, gs, gns := cb.DateTimeNano()
+	out.set("DateTimeNano", []int{gy, gm, gd, gh, gmi, gs, gns})
+	gy, gm, gd, gms := cb.DateMilli()
+	out.set("DateMilli", []int{gy, gm, gd, gms})
+	gh, gmi, gs, gus := cb.TimeMicro()
+	out.set("TimeMicro", []int{gh, gmi, gs, gus})
+	out.set("StdTime", stampTime(cb.StdTime()))
+	out.set("IsValid", cb.IsValid())
+	out.set("IsZero", cb.IsZero())
+	out.set("IsEpoch", cb.IsEpoch())
+	out.set("Copy", stamp(cb.Copy()))
+	out.set("ToWeekString", cb.ToWeekString())
+	out.set("ToShortWeekString", cb.ToShortWeekString())
