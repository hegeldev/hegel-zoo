+package carbon_test
+
+// The calendar sub-packages (hebrew, persian, julian, lunar) against
+// reference algorithms written from the literature: Reingold & Dershowitz for
+// the Hebrew calendar, the Birashk 2820-year cycle (Fourmilab) for the
+// Persian calendar, Fliegel & Van Flandern for Julian day numbers, and the
+// lunar calendar's own table read back through its round trip plus the
+// Hong Kong Observatory's leap months.
+
+import (
+	"fmt"
+	"math"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"github.com/dromara/carbon/v2/calendar/hebrew"
+	"github.com/dromara/carbon/v2/calendar/julian"
+	"github.com/dromara/carbon/v2/calendar/lunar"
+	"github.com/dromara/carbon/v2/calendar/persian"
+	"hegel.dev/go/hegel"
+)
+
+func floorDiv(a, b int) int {
+	q := a / b
+	if a%b != 0 && (a < 0) != (b < 0) {
+		q--
+	}
+	return q
+}
+
+func mod(a, b int) int { return a - b*floorDiv(a, b) }
+
+// gregJDN is the Julian day number (at noon) of a proleptic Gregorian date.
+func gregJDN(y, m, d int) int {
+	a := (14 - m) / 12
+	yy := y + 4800 - a
+	mm := m + 12*a - 3
+	return d + (153*mm+2)/5 + 365*yy + yy/4 - yy/100 + yy/400 - 32045
+}
+
+// gregToRD is the rata die (fixed day number, 0001-01-01 = 1) of a
+// proleptic Gregorian date.
+func gregToRD(y, m, d int) int {
+	prior := y - 1
+	rd := 365*prior + floorDiv(prior, 4) - floorDiv(prior, 100) + floorDiv(prior, 400)
+	rd += (367*m - 362) / 12
+	if m > 2 {
+		if isLeap(y) {
+			rd--
+		} else {
+			rd -= 2
+		}
+	}
+	return rd + d
+}
+
+func rdToTime(rd int) time.Time { return time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC).AddDate(0, 0, rd-1) }
+
+// --- Hebrew (Reingold & Dershowitz; months numbered Nisan = 1, Tishri = 7).
+
+func hebLeap(y int) bool { return (7*y+1)%19 < 7 }
+
+func hebElapsedDays(year int) int {
+	monthsElapsed := 235*((year-1)/19) + 12*((year-1)%19) + (7*((year-1)%19)+1)/19
+	partsElapsed := 204 + 793*(monthsElapsed%1080)
+	hoursElapsed := 5 + 12*monthsElapsed + 793*(monthsElapsed/1080) + partsElapsed/1080
+	day := 1 + 29*monthsElapsed + hoursElapsed/24
+	parts := 1080*(hoursElapsed%24) + partsElapsed%1080
+	alt := day
+	if parts >= 19440 || (day%7 == 2 && parts >= 9924 && !hebLeap(year)) || (day%7 == 1 && parts >= 16789 && hebLeap(year-1)) {
+		alt = day + 1
+	}
+	switch alt % 7 {
+	case 0, 3, 5:
+		alt++
+	}
+	return alt
+}
+
+func hebDaysInYear(y int) int { return hebElapsedDays(y+1) - hebElapsedDays(y) }
+
+func hebLastMonth(y int) int {
+	if hebLeap(y) {
+		return 13
+	}
+	return 12
+}
+
+func hebDaysInMonth(y, m int) int {
+	switch m {
+	case 2, 4, 6, 10, 13:
+		return 29
+	case 12:
+		if !hebLeap(y) {
+			return 29
+		}
+		return 30
+	case 8:
+		if hebDaysInYear(y)%10 == 5 {
+			return 30
+		}
+		return 29
+	case 9:
+		if hebDaysInYear(y)%10 == 3 {
+			return 29
+		}
+		return 30
+	}
+	return 30
+}
+
+// hebToRD: the epoch constant is fixed once from a known date (1 Tishri
+// 5780 = Monday 2019-09-30) so the algorithm's own epoch convention does
+// not matter.
+var hebEpochRD = func() int {
+	raw := func(y, m, d int) int {
+		rd := d
+		if m < 7 {
+			for mm := 7; mm <= hebLastMonth(y); mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+			for mm := 1; mm < m; mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+		} else {
+			for mm := 7; mm < m; mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+		}
+		return rd + hebElapsedDays(y)
+	}
+	off := gregToRD(2019, 9, 30) - raw(5780, 7, 1)
+	// two more anchors: 15 Nisan 5784 = 2024-04-23, 1 Tishri 5785 = 2024-10-03
+	if raw(5784, 1, 15)+off != gregToRD(2024, 4, 23) || raw(5785, 7, 1)+off != gregToRD(2024, 10, 3) {
+		panic("hebrew reference does not reproduce the anchor dates")
+	}
+	return off
+}()
+
+func hebToRD(y, m, d int) int {
+	rd := d
+	if m < 7 {
+		for mm := 7; mm <= hebLastMonth(y); mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+		for mm := 1; mm < m; mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+	} else {
+		for mm := 7; mm < m; mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+	}
+	return rd + hebElapsedDays(y) + hebEpochRD
+}
+
+func rdToHeb(rd int) (y, m, d int) {
+	y = (rd-hebToRD(1, 7, 1))*98496/35975351 + 1
+	for hebToRD(y+1, 7, 1) <= rd {
+		y++
+	}
+	for hebToRD(y, 7, 1) > rd {
+		y--
+	}
+	order := []int{7, 8, 9, 10, 11, 12, 13, 1, 2, 3, 4, 5, 6}
+	for _, mm := range order {
+		if mm == 13 && !hebLeap(y) {
+			continue
+		}
+		start := hebToRD(y, mm, 1)
+		if rd < start+hebDaysInMonth(y, mm) {
+			return y, mm, rd - start + 1
+		}
+	}
+	panic("rdToHeb: no month")
+}
+
+func TestHegelHebrewCalendarAgreesWithReingoldDershowitz(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		zoneName, loc := genZone(tc)
+		tm := genTime(tc, loc)
+		if tm.Year() < 2 || tm.Year() >= 6239 {
+			count(ht, "outside-hebrew-years-1..9999")
+			return
+		}
+		y, m, d := tm.Date()
+		note(ht, "%s", showTime(tm))
+		rd := gregToRD(y, int(m), d)
+		hy, hm, hd := rdToHeb(rd)
+		h := hebrew.FromStdTime(tm)
+		if !h.IsValid() || h.Year() != hy || h.Month() != hm || h.Day() != hd {
+			fail(ht, "Hebrew of %s = %s (valid %v), want %d-%02d-%02d", showTime(tm), h.String(), h.IsValid(), hy, hm, hd)
+		}
+		c := carbon.CreateFromStdTime(tm)
+		if got := c.Hebrew(); got.String() != h.String() {
+			fail(ht, "Carbon.Hebrew() = %s, hebrew.FromStdTime = %s", got.String(), h.String())
+		}
+		if !hebrew.NewHebrew(hy, hm, hd).IsValid() {
+			fail(ht, "NewHebrew(%d, %d, %d) invalid", hy, hm, hd)
+		}
+		back := hebrew.NewHebrew(hy, hm, hd).ToGregorian(zoneName).Time
+		if by, bm, bd := back.Date(); by != y || bm != m || bd != d {
+			fail(ht, "NewHebrew(%d, %d, %d).ToGregorian() = %s, want %04d-%02d-%02d", hy, hm, hd, showTime(back), y, m, d)
+		}
+		if cb := carbon.CreateFromHebrew(hy, hm, hd); cb.HasError() || cb.ToDateString() != fmt.Sprintf("%04d-%02d-%02d", y, m, d) {
+			fail(ht, "CreateFromHebrew(%d, %d, %d) = %s", hy, hm, hd, showCarbon(cb))
+		}
+		// the year's shape
+		if h.IsLeapYear() != hebLeap(hy) {
+			fail(ht, "IsLeapYear(%d) = %v, want %v", hy, h.IsLeapYear(), hebLeap(hy))
+		}
+		if hebrew.NewHebrew(hy, 13, 1).IsValid() != hebLeap(hy) {
+			fail(ht, "NewHebrew(%d, 13, 1).IsValid() = %v, leap %v", hy, hebrew.NewHebrew(hy, 13, 1).IsValid(), hebLeap(hy))
+		}
+		if hebrew.NewHebrew(hy, hm, hebDaysInMonth(hy, hm)+1).IsValid() {
+			fail(ht, "NewHebrew(%d, %d, %d) should be invalid (the month has %d days)", hy, hm, hebDaysInMonth(hy, hm)+1, hebDaysInMonth(hy, hm))
+		}
+		if !hebrew.NewHebrew(hy, hm, hebDaysInMonth(hy, hm)).IsValid() {
+			fail(ht, "NewHebrew(%d, %d, %d) should be valid", hy, hm, hebDaysInMonth(hy, hm))
+		}
+		// the next day is the next Hebrew day
+		next := hebrew.FromStdTime(tm.AddDate(0, 0, 1))
+		if next.IsValid() {
+			if next.Day() != hd+1 && !(next.Day() == 1 && hd == hebDaysInMonth(hy, hm)) {
+				fail(ht, "Hebrew of the next day is %s after %s", next.String(), h.String())
+			}
+		}
+	})
+}
+
+// --- Persian (Birashk 2820-year cycle, Fourmilab's formulation).
+
+func perToJDN(year, month, day int) int {
+	epbase := year - 474
+	if year < 0 {
+		epbase = year - 473
+	}
+	epyear := 474 + mod(epbase, 2820)
+	var mdays int
+	if month <= 7 {
+		mdays = (month - 1) * 31
+	} else {
+		mdays = (month-1)*30 + 6
+	}
+	return day + mdays + floorDiv(epyear*682-110, 2816) + (epyear-1)*365 + floorDiv(epbase, 2820)*1029983 + 1948320
+}
+
+func perLeap(year int) bool { return perToJDN(year+1, 1, 1)-perToJDN(year, 1, 1) == 366 }
+
+func jdnToPer(jdn int) (int, int, int) {
+	depoch := jdn - perToJDN(475, 1, 1)
+	cycle := floorDiv(depoch, 1029983)
+	cyear := mod(depoch, 1029983)
+	var ycycle int
+	if cyear == 1029982 {
+		ycycle = 2820
+	} else {
+		aux1 := cyear / 366
+		aux2 := mod(cyear, 366)
+		ycycle = floorDiv(2134*aux1+2816*aux2+2815, 1028522) + aux1 + 1
+	}
+	year := ycycle + 2820*cycle + 474
+	if year <= 0 {
+		year--
+	}
+	yday := jdn - perToJDN(year, 1, 1) + 1
+	var month int
+	if yday <= 186 {
+		month = (yday-1)/31 + 1
+	} else {
+		month = (yday-187)/30 + 7
+	}
+	day := jdn - perToJDN(year, month, 1) + 1
+	return year, month, day
+}
+
+func perDaysInMonth(y, m int) int {
+	switch {
+	case m <= 6:
+		return 31
+	case m <= 11:
+		return 30
+	case perLeap(y):
+		return 30
+	}
+	return 29
+}
+
+// the official (astronomical) Iranian calendar's Nowruz for recent years
+var nowruz = map[int]string{
+	1398: "2019-03-21", 1399: "2020-03-20", 1400: "2021-03-21", 1401: "2022-03-21", 1402: "2023-03-21",
+	1403: "2024-03-20", 1404: "2025-03-21", 1405: "2026-03-21", 1406: "2027-03-21", 1407: "2028-03-20", 1408: "2029-03-20",
+}
+
+func TestHegelPersianCalendarAgreesWithBirashk(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		zoneName, loc := genZone(tc)
+		tm := genTime(tc, loc)
+		y, m, d := tm.Date()
+		note(ht, "%s", showTime(tm))
+		if y < 1583 {
+			if Known.persianPreReformIsJulian || Known.persianEarlyYearsShifted {
+				count(ht, "known-carbon/19,22")
+				return
+			}
+		}
+		if y < 622 || (y == 622 && (m < 3 || (m == 3 && d < 22))) {
+			count(ht, "before-the-persian-epoch")
+			return
+		}
+		py, pm, pd := jdnToPer(gregJDN(y, int(m), d))
+		if py > 9999 {
+			count(ht, "beyond-persian-9999")
+			return
+		}
+		p := persian.FromStdTime(tm)
+		if !p.IsValid() || p.Year() != py || p.Month() != pm || p.Day() != pd {
+			fail(ht, "Persian of %s = %s (valid %v), want %d-%02d-%02d", showTime(tm), p.String(), p.IsValid(), py, pm, pd)
+		}
+		c := carbon.CreateFromStdTime(tm)
+		if got := c.Persian(); got.String() != p.String() {
+			fail(ht, "Carbon.Persian() = %s, persian.FromStdTime = %s", got.String(), p.String())
+		}
+		if Known.persian1403NotLeap && (py == 1403 || py == 1404) {
+			count(ht, "known-carbon/18")
+			return
+		}
+		back := persian.NewPersian(py, pm, pd).ToGregorian(zoneName).Time
+		if by, bm, bd := back.Date(); by != y || bm != m || bd != d {
+			fail(ht, "NewPersian(%d, %d, %d).ToGregorian() = %s, want %04d-%02d-%02d", py, pm, pd, showTime(back), y, m, d)
+		}
+		if cb := carbon.CreateFromPersian(py, pm, pd); cb.HasError() || cb.ToDateString() != fmt.Sprintf("%04d-%02d-%02d", y, m, d) {
+			fail(ht, "CreateFromPersian(%d, %d, %d) = %s", py, pm, pd, showCarbon(cb))
+		}
+		if p.IsLeapYear() != perLeap(py) {
+			fail(ht, "IsLeapYear(%d) = %v, want %v", py, p.IsLeapYear(), perLeap(py))
+		}
+		last := perDaysInMonth(py, pm)
+		if !persian.NewPersian(py, pm, last).IsValid() || persian.NewPersian(py, pm, last+1).IsValid() {
+			fail(ht, "month %d of %d has %d days; valid(%d)=%v valid(%d)=%v", pm, py, last, last, persian.NewPersian(py, pm, last).IsValid(), last+1, persian.NewPersian(py, pm, last+1).IsValid())
+		}
+		if g, ok := nowruz[py]; ok {
+			if got := persian.NewPersian(py, 1, 1).ToGregorian(zoneName).Time.Format("2006-01-02"); got != g {
+				fail(ht, "1 Farvardin %d = %s, the official calendar has %s", py, got, g)
+			}
+		}
+	})
+}
+
+// --- Julian day numbers.
+
+func TestHegelJulianDayAgreesWithTheInstant(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		zoneName, loc := genZone(tc)
+		tm := genTime(tc, loc)
+		tm = time.Unix(tm.Unix(), 0).In(loc) // whole seconds: JD has microsecond resolution at best
+		y, m, d := tm.Date()
+		note(ht, "%s", showTime(tm))
+		if y < 1583 && Known.julianPreReformCalendar {
+			count(ht, "known-carbon/24")
+			return
+		}
+		if loc != time.UTC && Known.julianIgnoresZone {
+			count(ht, "known-carbon/29")
+			return
+		}
+		want := float64(tm.Unix())/86400 + 2440587.5
+		j := julian.FromStdTime(tm)
+		if math.Abs(j.JD()-want) > 2e-5 {
+			fail(ht, "JD of %s = %.6f, want %.6f", showTime(tm), j.JD(), want)
+		}
+		if math.Abs(j.MJD()-(want-2400000.5)) > 2e-5 {
+			fail(ht, "MJD of %s = %.6f, want %.6f", showTime(tm), j.MJD(), want-2400000.5)
+		}
+		if math.Abs(j.JD()-float64(gregJDN(y, int(m), d))) > 0.5+2e-5 {
+			fail(ht, "JD of %s = %.6f, but the day number of the date is %d", showTime(tm), j.JD(), gregJDN(y, int(m), d))
+		}
+		c := carbon.CreateFromStdTime(tm)
+		if got := c.Julian(); got.JD() != j.JD() {
+			fail(ht, "Carbon.Julian().JD() = %v, julian.FromStdTime = %v", got.JD(), j.JD())
+		}
+		// back from the JD (within a second) and from the MJD
+		back := julian.NewJulian(j.JD()).ToGregorian(zoneName).Time
+		if back.Sub(tm).Abs() > time.Second {
+			fail(ht, "NewJulian(%.6f).ToGregorian() = %s, want %s", j.JD(), showTime(back), showTime(tm))
+		}
+		if cb := carbon.CreateFromJulian(j.JD()); cb.HasError() || cb.StdTime().Sub(tm).Abs() > time.Second {
+			fail(ht, "CreateFromJulian(%.6f) = %s, want %s", j.JD(), showCarbon(cb), showTime(tm))
+		}
+		if (j.MJD() < 9998.5 || j.MJD() >= 99999.5) && Known.julianDigitHeuristic {
+			count(ht, "known-carbon/23")
+			return
+		}
+		back = julian.NewJulian(j.MJD()).ToGregorian(zoneName).Time
+		if back.Sub(tm).Abs() > time.Second {
+			fail(ht, "NewJulian(MJD %.6f).ToGregorian() = %s, want %s", j.MJD(), showTime(back), showTime(tm))
+		}
+	})
+}
