+// carbon/11: the zero Carbon struct is valid but has no Location.
+func TestHegelPinZeroCarbonDoesNotPanic(t *testing.T) {
+	var c carbon.Carbon
+	noPanic(t, "StartOfDay of a zero Carbon", func() { c.StartOfDay() })
+	noPanic(t, "SetYear of a zero Carbon", func() { c.Copy().SetYear(2020) })
+	noPanic(t, "AddMonthsNoOverflow of a zero Carbon", func() { c.AddMonthsNoOverflow(1) })
+	noPanic(t, "IsLongYear of a zero Carbon", func() { c.IsLongYear() })
+	if c.IsValid() && c.WeekStartsAt() != carbon.DefaultWeekStartsAt {
+		t.Errorf("a valid zero Carbon starts its week on %s, the default is %s", c.WeekStartsAt(), carbon.DefaultWeekStartsAt)
+	}
+}
