+// ---------------------------------------------------------------------------
+// carbon/9: SetDefault keeps the week start.
+
+// defaultCase is a Default passed to SetDefault: each field set or left
+// empty; the week start left empty (the shape of carbon/9) or set under
+// HEGEL_NO_KNOWN=1.
+type defaultCase struct {
+	d     carbon.Default
+	wsSet bool
+}
+
+func (c defaultCase) GoString() string {
+	ws := "unset"
+	if c.wsSet {
+		ws = c.d.WeekStartsAt.String()
+	}
+	return fmt.Sprintf("SetDefault{Layout:%q Timezone:%q Locale:%q WeekStartsAt:%s WeekendDays:%v}", c.d.Layout, c.d.Timezone, c.d.Locale, ws, c.d.WeekendDays)
+}
+
+var (
+	defaultLayouts = hzSampled(carbon.DateLayout, carbon.DateTimeMilliLayout, carbon.TimeLayout, carbon.RFC3339Layout)
+	defaultLocales = hzSampled("zh-CN", "de", "ja", "fr")
+	defaultCases   = hegel.Composite(func(tc hegel.TestCase) defaultCase {
+		c := defaultCase{d: carbon.Default{
+			Layout:      hegel.Draw(tc, hzMaybe(50, defaultLayouts)),
+			Timezone:    hegel.Draw(tc, hzMaybe(50, zoneList)),
+			Locale:      hegel.Draw(tc, hzMaybe(50, defaultLocales)),
+			WeekendDays: hegel.Draw(tc, hzMaybe(50, nonEmptyWeekends)),
+		}}
+		if c.wsSet = hzShaped(false, true); c.wsSet {
+			c.d.WeekStartsAt = hegel.Draw(tc, weekStarts)
+		}
+		return c
+	})
+)
+
+// nonEmptyWeekends: one to three weekend days, distinct.
+var nonEmptyWeekends = hegel.Map(hzCounted(weekStarts, 1, 3), func(days []time.Weekday) []time.Weekday {
+	seen := map[time.Weekday]bool{}
+	var out []time.Weekday
+	for _, d := range days {
+		if !seen[d] {
+			seen[d] = true
+			out = append(out, d)
+		}
+	}
+	return out
+})
+
+// defaultExpected: SetDefault sets the defaults whose fields are given and
+// leaves the others (the reset values: the date-time layout, UTC, "en",
+// Monday, Saturday and Sunday), and a new Carbon takes them; or (carbon/9)
+// sets the week start whatever the field holds, Sunday when it is not given
+// (default.go:40-42: d.WeekStartsAt.String() != "" is true of Sunday).
+func defaultExpected(c defaultCase, k known) checks {
+	layout, tz, locale, ws, weekend := carbon.DateTimeLayout, "UTC", "en", time.Monday, []time.Weekday{time.Saturday, time.Sunday}
+	if c.d.Layout != "" {
+		layout = c.d.Layout
+	}
+	if c.d.Timezone != "" {
+		tz = c.d.Timezone
+	}
+	if c.d.Locale != "" {
+		locale = c.d.Locale
+	}
+	if c.wsSet || k[kSetDefaultResetsWeekStart] {
+		ws = c.d.WeekStartsAt
+	}
+	if len(c.d.WeekendDays) > 0 {
+		weekend = c.d.WeekendDays
+	}
+	out := checks{}
+	out.set("DefaultLayout", layout)
+	out.set("DefaultTimezone", tz)
+	out.set("DefaultLocale", locale)
+	out.set("DefaultWeekStartsAt", ws)
+	out.set("DefaultWeekendDays", weekend)
+	out.set("new WeekStartsAt", ws)
+	out.set("new WeekEndsAt", time.Weekday((int(ws)+6)%7))
+	out.set("new Timezone", tz)
+	out.set("new Locale", locale)
+	out.set("new CurrentLayout", layout)
+	return out
+}
+
+func defaultActual(c defaultCase) checks {
+	carbon.ResetDefault()
+	defer carbon.ResetDefault()
+	carbon.SetDefault(c.d)
+	fresh := carbon.Now()
+	out := checks{}
+	out.set("DefaultLayout", carbon.DefaultLayout)
+	out.set("DefaultTimezone", carbon.DefaultTimezone)
+	out.set("DefaultLocale", carbon.DefaultLocale)
+	out.set("DefaultWeekStartsAt", carbon.DefaultWeekStartsAt)
+	out.set("DefaultWeekendDays", carbon.DefaultWeekendDays)
+	out.set("new WeekStartsAt", fresh.WeekStartsAt())
+	out.set("new WeekEndsAt", fresh.WeekEndsAt())
+	out.set("new Timezone", fresh.Timezone())
+	out.set("new Locale", fresh.Locale())
+	out.set("new CurrentLayout", fresh.CurrentLayout())
+	return out
+}
+
+func TestHegelSetDefaultKeepsTheWeekStart(t *testing.T) {
+	judged(t, defaultCases, func(j *hzCaseJudge, c defaultCase) {
+		judgeBy(j, c, defaultExpected, defaultActual)
+	})
+}
