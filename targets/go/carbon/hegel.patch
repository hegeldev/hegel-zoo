+func TestHegelAddDurationAgreesWithParseDuration(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		s, d, ok := genDuration(tc)
+		note(ht, "%s AddDuration(%q)", showTime(tm), s)
+		got := c.AddDuration(s)
+		got2 := c.SubDuration(s)
+		if !ok {
+			if got == nil || !got.HasError() {
+				fail(ht, "AddDuration(%q) accepted: %s", s, showCarbon(got))
+			}
+			if Known.addDurationPoisonsReceiver {
+				count(ht, "known-carbon/7")
+				return
+			}
+			if c.HasError() {
+				fail(ht, "AddDuration(%q) set Error on the receiver", s)
+			}
+			return
+		}
+		if !sameInstant(got, tm.Add(d)) {
+			fail(ht, "AddDuration(%q) of %s = %s, want %s", s, showTime(tm), showCarbon(got), showTime(tm.Add(d)))
+		}
+		if !sameInstant(got2, tm.Add(-d)) {
+			fail(ht, "SubDuration(%q) of %s = %s, want %s", s, showTime(tm), showCarbon(got2), showTime(tm.Add(-d)))
+		}
+		if !sameInstant(c, tm) || c.HasError() {
+			fail(ht, "the receiver changed: %s", showCarbon(c))
+		}
+	})
+}
