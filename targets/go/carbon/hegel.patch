+func TestHegelExtremaAgreeWithInstants(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		k := n(tc, 1, 5)
+		var cs []*carbon.Carbon
+		var ts []time.Time
+		for i := 0; i < k; i++ {
+			var t2 time.Time
+			switch n(tc, 1, 3) {
+			case 1:
+				t2 = genNear(tc, tm)
+			case 2:
+				_, loc := genZone(tc)
+				t2 = genTime(tc, loc)
+			default:
+				t2 = tm.Add(time.Duration(pick(tc, 0, 1, -1, 500e6, -500e6, 900e6, -900e6, 1e9, -1e9, 2e9)))
+			}
+			if Known.diffFloorsToSeconds && t2.Nanosecond() != 0 {
+				count(ht, "known-carbon/2")
+				t2 = time.Unix(t2.Unix(), 0).In(t2.Location())
+			}
+			cs = append(cs, carbon.CreateFromStdTime(t2))
+			ts = append(ts, t2)
+		}
+		if Known.diffFloorsToSeconds && tm.Nanosecond() != 0 {
+			count(ht, "known-carbon/2")
+			tm = time.Unix(tm.Unix(), 0).In(tm.Location())
+			c = carbon.CreateFromStdTime(tm)
+		}
+		note(ht, "%s among %d", showTime(tm), k)
+		maxI, minI, closeI, farI := 0, 0, 0, 0
+		// exact distance in nanoseconds as a float (time.Sub saturates at 292 years)
+		dist := func(x time.Time) float64 {
+			return math.Abs(float64(x.Unix()-tm.Unix())*1e9 + float64(x.Nanosecond()-tm.Nanosecond()))
+		}
+		for i := range ts {
+			if !ts[i].Before(ts[maxI]) {
+				maxI = i
+			}
+			if !ts[i].After(ts[minI]) {
+				minI = i
+			}
+			if dist(ts[i]) < dist(ts[closeI]) {
+				closeI = i
+			}
+			if dist(ts[i]) > dist(ts[farI]) {
+				farI = i
+			}
+		}
+		if got := carbon.Max(cs[0], cs[1:]...); !got.StdTime().Equal(ts[maxI]) {
+			fail(ht, "Max = %s, want %s", showCarbon(got), showTime(ts[maxI]))
+		}
+		if got := carbon.Min(cs[0], cs[1:]...); !got.StdTime().Equal(ts[minI]) {
+			fail(ht, "Min = %s, want %s", showCarbon(got), showTime(ts[minI]))
+		}
+		if got := c.Closest(cs[0], cs[1:]...); dist(got.StdTime()) != dist(ts[closeI]) {
+			fail(ht, "Closest to %s = %s, want %s", showTime(tm), showCarbon(got), showTime(ts[closeI]))
+		}
+		if got := c.Farthest(cs[0], cs[1:]...); dist(got.StdTime()) != dist(ts[farI]) {
+			fail(ht, "Farthest from %s = %s, want %s", showTime(tm), showCarbon(got), showTime(ts[farI]))
+		}
+	})
+}
