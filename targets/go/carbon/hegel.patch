+// modelAddUnits adds k units exactly.
+func modelAddUnits(t time.Time, k int64, unit time.Duration) time.Time {
+	if unit >= time.Second {
+		return modelAddSeconds(t, k*int64(unit/time.Second))
+	}
+	return modelAddNanos(t, k, int64(unit))
+}
+
+// clockExpected: the clock travellers add k units exactly, or (carbon/6) as
+// the product time.Duration(k) * unit, which wraps beyond the Duration range
+// (traveler.go:366 and the five like it; Sub is Add of -k); the singular
+// forms add one unit; the receiver is untouched.
+func clockExpected(c clockCase, k known) checks {
+	tm, u, n := c.m.t, c.unit.d, c.k.v
+	out := checks{}
+	if k[kAddUnitsOverflowDuration] {
+		out["Add"] = stampTime(tm.Add(time.Duration(n) * u))
+		out["Sub"] = stampTime(tm.Add(time.Duration(-n) * u))
+	} else {
+		out["Add"] = stampTime(modelAddUnits(tm, n, u))
+		out["Sub"] = stampTime(modelAddUnits(tm, -n, u))
+	}
+	out["receiver"] = stampTime(tm)
+	for _, cu := range clockUnits {
+		out["Add"+cu.title] = stampTime(tm.Add(cu.d))
+		out["Sub"+cu.title] = stampTime(tm.Add(-cu.d))
+	}
+	return out
+}
+
+func clockActual(c clockCase) checks {
+	cb, n := carbonOf(c.m), int(c.k.v)
+	add := map[string]func(int) *carbon.Carbon{
+		"hour": cb.AddHours, "minute": cb.AddMinutes, "second": cb.AddSeconds,
+		"milli": cb.AddMilliseconds, "micro": cb.AddMicroseconds, "nano": cb.AddNanoseconds,
+	}
+	sub := map[string]func(int) *carbon.Carbon{
+		"hour": cb.SubHours, "minute": cb.SubMinutes, "second": cb.SubSeconds,
+		"milli": cb.SubMilliseconds, "micro": cb.SubMicroseconds, "nano": cb.SubNanoseconds,
+	}
+	out := checks{}
+	out["Add"] = stamp(add[c.unit.name](n))
+	out["Sub"] = stamp(sub[c.unit.name](n))
+	out["receiver"] = stamp(cb)
+	ones := []struct {
+		name     string
+		add, sub *carbon.Carbon
+	}{
+		{"Hour", cb.AddHour(), cb.SubHour()}, {"Minute", cb.AddMinute(), cb.SubMinute()}, {"Second", cb.AddSecond(), cb.SubSecond()},
+		{"Milli", cb.AddMillisecond(), cb.SubMillisecond()}, {"Micro", cb.AddMicrosecond(), cb.SubMicrosecond()}, {"Nano", cb.AddNanosecond(), cb.SubNanosecond()},
+	}
+	for _, o := range ones {
+		out["Add"+o.name] = stamp(o.add)
+		out["Sub"+o.name] = stamp(o.sub)
+	}
+	return out
+}
