+// carbon/9: SetDefault without WeekStartsAt resets the default to Sunday.
+func TestHegelPinSetDefaultKeepsWeekStart(t *testing.T) {
+	defer carbon.ResetDefault()
+	carbon.ResetDefault()
+	carbon.SetDefault(carbon.Default{Timezone: "UTC"})
+	if carbon.DefaultWeekStartsAt != carbon.Monday {
+		t.Errorf("after SetDefault{Timezone} the default week start is %s, want Monday", carbon.DefaultWeekStartsAt)
+	}
+	if got := carbon.CreateFromDate(2020, 8, 5, "UTC").StartOfWeek().ToDateString(); got != "2020-08-03" {
+		t.Errorf("StartOfWeek of Wednesday 2020-08-05 = %s, want Monday 2020-08-03", got)
+	}
+}
