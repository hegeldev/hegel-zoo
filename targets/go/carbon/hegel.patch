+			du = time.Hour
+			got, got2 = c.AddHours(int(k)), c.SubHours(int(k))
+			want, want2 = modelAddSeconds(tm, k*3600), modelAddSeconds(tm, -k*3600)
+		case "minute":
+			du = time.Minute
+			got, got2 = c.AddMinutes(int(k)), c.SubMinutes(int(k))
+			want, want2 = modelAddSeconds(tm, k*60), modelAddSeconds(tm, -k*60)
+		case "second":
+			du = time.Second
+			got, got2 = c.AddSeconds(int(k)), c.SubSeconds(int(k))
+			want, want2 = modelAddSeconds(tm, k), modelAddSeconds(tm, -k)
+		case "milli":
+			du = time.Millisecond
+			got, got2 = c.AddMilliseconds(int(k)), c.SubMilliseconds(int(k))
+			want, want2 = modelAddNanos(tm, k, 1e6), modelAddNanos(tm, -k, 1e6)
+		case "micro":
+			du = time.Microsecond
+			got, got2 = c.AddMicroseconds(int(k)), c.SubMicroseconds(int(k))
+			want, want2 = modelAddNanos(tm, k, 1e3), modelAddNanos(tm, -k, 1e3)
+		case "nano":
+			du = time.Nanosecond
+			got, got2 = c.AddNanoseconds(int(k)), c.SubNanoseconds(int(k))
+			want, want2 = modelAddNanos(tm, k, 1), modelAddNanos(tm, -k, 1)
