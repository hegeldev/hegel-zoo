+package carbon_test
+
+// The core properties: every Carbon method family against a model of its
+// documented behaviour. Each family has a case record (hegel_moments_test.go),
+// a model expected(c, k) that returns every checked value (the check's name
+// to its printed value) and follows the recorded bugs in k as replicas of the
+// library's code, an actual(c) that asks the library the same questions, and
+// a judge that names the shape of a case before the library is called
+// (shapeBy: the first bug whose switch alone moves the model, else the first
+// whose switch is needed, else a hole), judges the library against the
+// documented values (expected with no switch) and counts the replica's
+// agreement with the library on the shaped cases.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Checks, stamps and the classifier.
+
+// checks is the set of values a model states or the library gives, by check name.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// diffChecks lists the checks on which a and b differ.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if a[k] != b[k] {
+			parts = append(parts, fmt.Sprintf("%s: %s vs %s", k, a[k], b[k]))
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s: (none) vs %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// stamp prints a Carbon result: its wall clock, offset and zone (one instant
+// in one zone prints one way), or its error state.
+func stamp(c *carbon.Carbon) string {
+	if c == nil {
+		return "<nil>"
+	}
+	if c.HasError() {
+		return "error"
+	}
+	if c.IsEmpty() {
+		return "<empty>"
+	}
+	return showTime(c.StdTime()) + " in " + c.Timezone()
+}
+
+// stampTime is stamp of the Carbon a time would make.
+func stampTime(t time.Time) string { return showTime(t) + " in " + t.Location().String() }
+
+// stampInstant prints the instant alone.
+func stampInstant(t time.Time) string { return t.UTC().Format("2006-01-02 15:04:05.999999999") }
+
+// shapeBy names the recorded bug whose shape the case has, from the model
+// alone: none when every switch leaves the model unchanged; else the first bug
+// in bug order whose switch alone moves the model from the documented values
+// ("sufficiency"), else the first whose switch is needed by the full set
+// ("necessity"), else a hole ("carbon/?", a defect of the model).
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "carbon/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape to the judge and counts the classifier's rule.
+func classify[T any](j *hzCaseJudge, c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// verdict judges the library's values against the documented ones (the first
+// difference fails, naming the shape) after counting, on a shaped case, whether
+// the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); sameChecks(got, replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%#v: %s", c, diffChecks(got, replica))
+		}
+	}
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok {
+			j.Fail(k, "%s was not checked for %#v", k, c)
+		} else if g != want[k] {
+			j.Fail(k, "%s = %s, want %s for %#v", k, g, want[k], c)
+		}
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(j, c, expected)
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// ---------------------------------------------------------------------------
+// Getters.
+
+type getterCase struct {
+	m       moment
+	ws      time.Weekday
+	weekend []time.Weekday
+}
+
+func (c getterCase) GoString() string {
+	return fmt.Sprintf("%#v weekStartsAt=%s weekend=%v", c.m, c.ws, c.weekend)
+}
+
+var getterCases = hegel.Composite(func(tc hegel.TestCase) getterCase {
+	return getterCase{m: hegel.Draw(tc, moments), ws: hegel.Draw(tc, weekStarts), weekend: hegel.Draw(tc, weekends)}
+})
+
+// gettersExpected: every getter from the time's fields; the week names from
+// the weekday, or (carbon/1) from the Sunday-first table indexed with the
+// day of the week counted from the week start (outputer.go:85, 105:
+// weeks[c.DayOfWeek()%DaysPerWeek]).
+func gettersExpected(c getterCase, k known) checks {
+	tm, ws := c.m.t, c.ws
+	out := checks{}
+	y, m, d := tm.Date()
+	h, mi, s := tm.Clock()
+	out.set("Year", y)
+	out.set("Month", int(m))
+	out.set("MonthOfYear", int(m))
+	out.set("Day", d)
+	out.set("DayOfMonth", d)
+	out.set("Hour", h)
+	out.set("Minute", mi)
+	out.set("Second", s)
+	out.set("Millisecond", tm.Nanosecond()/1e6)
+	out.set("Microsecond", tm.Nanosecond()/1e3)
+	out.set("Nanosecond", tm.Nanosecond())
+	out.set("DayOfYear", tm.YearDay())
+	out.set("DaysInMonth", daysIn(y, m))
+	out.set("DaysInYear", map[bool]int{true: 366, false: 365}[isLeap(y)])
+	out.set("Quarter", modelQuarter(m))
+	out.set("Century", y/100+1)
+	out.set("Decade", y%100/10*10)
+	out.set("IsLeapYear", isLeap(y))
+	out.set("IsLongYear", modelIsLongYear(y))
+	_, isoWeek := tm.ISOWeek()
+	out.set("WeekOfYear", isoWeek)
+	out.set("DayOfWeek", modelDayOfWeek(tm, ws))
+	out.set("Week", modelDayOfWeek(tm, ws)-1)
+	out.set("WeekOfMonth", modelWeekOfMonth(tm, ws))
+	out.set("WeekStartsAt", ws)
+	out.set("WeekEndsAt", time.Weekday((int(ws)+6)%7))
+	out.set("Timestamp", tm.Unix())
+	out.set("TimestampMilli", tm.UnixMilli())
+	out.set("TimestampMicro", tm.UnixMicro())
+	if y >= 1700 && y <= 2200 {
+		out.set("TimestampNano", tm.UnixNano())
+	}
+	name, off := tm.Zone()
+	out.set("ZoneName", name)
+	out.set("ZoneOffset", off)
+	out.set("Timezone", tm.Location().String())
+	out.set("IsDST", tm.IsDST())
+	out.set("IsAM", h < 12)
+	out.set("IsPM", h >= 12)
+	isWeekend := false
+	for _, wd := range c.weekend {
+		if wd == tm.Weekday() {
+			isWeekend = true
+		}
+	}
+	out.set("IsWeekend", isWeekend)
+	out.set("IsWeekday", !isWeekend)
+	for i, name := range englishMonths {
+		out.set("Is"+name, int(m) == i+1)
+	}
+	for i, name := range englishDays {
+		out.set("Is"+name, int(tm.Weekday()) == i)
+	}
+	out.set("DateTime", []int{y, int(m), d, h, mi, s})
+	out.set("DateTimeNano", []int{y, int(m), d, h, mi, s, tm.Nanosecond()})
+	out.set("DateMilli", []int{y, int(m), d, tm.Nanosecond() / 1e6})
+	out.set("TimeMicro", []int{h, mi, s, tm.Nanosecond() / 1e3})
+	out.set("StdTime", stampTime(tm))
+	out.set("IsValid", true)
+	out.set("IsZero", tm.IsZero())
+	out.set("IsEpoch", tm.Unix() == 0 && tm.Nanosecond() == 0)
+	out.set("Copy", stampTime(tm))
+	weekName := englishDays[tm.Weekday()]
+	if k[kWeekNamesFollowWeekStart] {
+		weekName = englishDays[modelDayOfWeek(tm, ws)%7]
+	}
+	out.set("ToWeekString", weekName)
+	out.set("ToShortWeekString", weekName[:3])
+	out.set("ToMonthString", englishMonths[m-1])
+	out.set("ToShortMonthString", englishMonths[m-1][:3])
+	return out
+}
+
+func gettersActual(c getterCase) checks {
+	cb := carbonOf(c.m)
+	cb.SetWeekStartsAt(c.ws)
+	cb.SetWeekendDays(c.weekend)
+	out := checks{}
+	out.set("Year", cb.Year())
+	out.set("Month", cb.Month())
