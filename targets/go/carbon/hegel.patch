+package carbon_test
+
+// The narrow properties of the calendar families: each draws the shape of
+// one recorded bug every run (the ingredient forced, the surroundings
+// random; the classifier filters where a construction cannot be pure),
+// shares the judge, the model and the library calls of its wide property
+// (hegel_calendar_test.go), and so fails naming the bug every run by
+// default; under HEGEL_NO_KNOWN=1 it draws the region past the shape
+// (hzShaped) and passes. The collector's "shape carbon/N" and "filtered
+// carbon/N" counters measure the hit and rejection rates.
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2/calendar/julian"
+	"hegel.dev/go/hegel"
+)
+
+// regionWhere is regionOf with a shape function (the lunar family names its
+// shape over two models).
+func regionWhere[T any](id string, shape func(T) string, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shape(c) == want })
+}
+
+// lunarShapeOf is the shape judgeLunar names: the dates' first, else the
+// zones' (ToGregorian alone under HEGEL_NO_KNOWN=1, where CreateFromLunar
+// is dropped).
+func lunarShapeOf(c lunarCase) string {
+	if s := shapeID(c, lunarDatesExpected); s != "" {
+		return s
+	}
+	if hzNoKnown {
+		return shapeID(c, lunarToGregorianExpected)
+	}
+	return shapeID(c, lunarZonesExpected)
+}
+
+// ownProbes: the moment's own lunar date as the probe (the probe of every
+// lunar narrow property but carbon/17's).
+func ownProbes(m moment) hegel.Generator[tagged[lunarDate]] {
+	own, ok := lunarDocOf(m.t)
+	if !ok {
+		own = lunarDate{y: m.t.Year(), m: 1, d: 1}
+	}
+	return via("probe own", hegel.Just(own))
+}
+
+// lunarTableYears: the table's years as lunarYears draws them, without the
+// years outside.
+var lunarTableYears = hzWeighted(
+	hzW(66, via("lunar year table", hzInts(1900, 2100))),                                          // 78 nominal: weight 66 realises 80.5 in carbon/15's property, 75.5 in 20's (70 realised 86.7, 63 74.5)
+	hzW(30, via("lunar year special", hzSampled(1900, 1901, 2033, 2034, 2099, 2100, 2020, 2023))), // 22 nominal: weight 30 realises 19.5 and 24.5 (21 realised 13.3, 35 25.5)
+)
+
+// noonMoments: a moment at noon (no clock of carbon/20 flips at noon) in
+// one of the zones and years.
+func noonMoments(zoneGen hegel.Generator[string], yearGen hegel.Generator[tagged[int]]) hegel.Generator[moment] {
+	return hegel.Composite(func(tc hegel.TestCase) moment {
+		zone := hegel.Draw(tc, zoneGen)
+		y := hegel.Draw(tc, yearGen)
+		m := time.Month(hegel.Draw(tc, months))
+		d := hegel.Draw(tc, daysOf(y.v, m))
+		return moment{zone: zone, t: time.Date(y.v, m, d.v, 12, 0, 0, 0, zones[zone]), drawn: []string{y.via, d.via, "clock noon"}}
+	})
+}
+
+// momentsBetween: a moment on a date from the first to the last given
+// (uniform over the days, the first the shrink target), in one of the
+// zones, with the clock and nanosecond mix (whole seconds when whole).
+func momentsBetween(zoneGen hegel.Generator[string], first, last string, whole bool) hegel.Generator[moment] {
+	a, err := time.Parse("2006-01-02", first)
+	b, err2 := time.Parse("2006-01-02", last)
+	if err != nil || err2 != nil || b.Before(a) {
+		panic("momentsBetween: bad range " + first + " to " + last)
+	}
+	days := int(b.Sub(a).Hours() / 24)
+	return hegel.Composite(func(tc hegel.TestCase) moment {
+		zone := hegel.Draw(tc, zoneGen)
+		day := a.AddDate(0, 0, hegel.Draw(tc, hzInts(0, days)))
+		c := hegel.Draw(tc, clocks)
+		ns := tagged[int]{v: 0, via: "nanos whole"}
+		if !whole {
+			ns = hegel.Draw(tc, nanos)
+		}
+		return moment{
+			zone:  zone,
+			t:     time.Date(day.Year(), day.Month(), day.Day(), c.v.h, c.v.mi, c.v.s, ns.v, zones[zone]),
+			drawn: []string{"day in range", c.via, ns.via},
+		}
+	})
+}
+
+// persianCasesFrom: a Persian case over the moments (the locale per moment).
+func persianCasesFrom(ms hegel.Generator[moment]) hegel.Generator[persianCase] {
+	return hegel.Composite(func(tc hegel.TestCase) persianCase {
+		m := hegel.Draw(tc, ms)
+		return persianCase{m: m, locale: hegel.Draw(tc, persianLocalesFor(m))}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// carbon/15: a lunar date is a date in every zone.
+
+// westZones: the nine zones west of +08:00, where Beijing midnight is the
+// previous day (the shape of carbon/15).
+var westZones = weightedOver([]int{2, 3, 5, 5, 5, 5, 5, 5, 5}, "UTC", "America/New_York", "Europe/London", "Asia/Kolkata", "America/St_Johns", "Europe/Berlin", "America/Sao_Paulo", "America/Los_Angeles", "Asia/Kathmandu")
+
+// lunarZoneCases: a lunar date (the moment's own, at noon of a table year)
+// converted back in a west zone, and by CreateFromLunar; the east zones
+// under HEGEL_NO_KNOWN=1. The classifier keeps the cases the zones shape
+// (the relabelled 2033 dates, named carbon/21 first, are filtered out).
+var lunarZoneCases = regionWhere("carbon/15", lunarShapeOf, lunarCasesFrom(noonMoments(hzShaped(westZones, eastZones), lunarTableYears), ownProbes))
+
+func TestHegelLunarDatesAreDatesInEveryZone(t *testing.T) {
+	judged(t, lunarZoneCases, judgeLunar)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/16: a moment outside the table is an invalid lunar date, not a panic.
+
+// outsideYears: the years outside 1900-2100, the ones beside the table often.
+var outsideYears = hzWeighted(
+	hzW(4, via("lunar year outside", hzInts(1, 1899))),
+	hzW(2, via("lunar year beside", hzSampled(1899, 2101))),
+	hzW(4, via("lunar year outside", hzInts(2101, 9999))),
+)
+
+// outsideMoments: a moment of a year outside the table (two in three), or
+// of January 1900, before the table's 1900-01-31 (one in three).
+var outsideMoments = hzWeighted(
+	hzW(4, momentsIn(zoneList, outsideYears, false)),
+	hzW(2, hegel.Composite(func(tc hegel.TestCase) moment {
+		zone := hegel.Draw(tc, zoneList)
+		d := hegel.Draw(tc, hzInts(1, 30))
+		c := hegel.Draw(tc, clocks)
+		ns := hegel.Draw(tc, nanos)
+		return moment{zone: zone, t: time.Date(1900, time.January, d, c.v.h, c.v.mi, c.v.s, ns.v, zones[zone]), drawn: []string{"January 1900", c.via, ns.via}}
+	})),
+)
+
+// lunarOutsideCases: an outside moment with its (invalid) own probe; a
+// table moment in an east zone (past carbon/15 too) under HEGEL_NO_KNOWN=1.
+// The classifier filters out the January 2101 dates that are still in
+// lunar 2100.
+var lunarOutsideCases = regionWhere("carbon/16", lunarShapeOf, lunarCasesFrom(hzShaped(outsideMoments, momentsIn(eastZones, lunarTableYears, false)), ownProbes))
+
+func TestHegelLunarOutsideTheTableIsAnError(t *testing.T) {
+	judged(t, lunarOutsideCases, judgeLunar)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/17: NewLunar rejects impossible dates.
+
+// impossibleProbes: the four impossible kinds of lunarProbesFor, evenly;
+// the own date under HEGEL_NO_KNOWN=1.
+func impossibleProbes(m moment) hegel.Generator[tagged[lunarDate]] {
+	own, short, notLeap := lunarProbeBase(m) // January 1900 is before the table: an invalid own date, month 1 alone
+	impossible := hzWeighted(
+		hzW(2, via("probe month 13 or 0", hegel.Map(hzTuple(hzSampled(13, 0), hzInts(1, 29)), func(v []int) lunarDate { // 25 nominal each: weights 2, 5, 4, 5 realise 26.6/28.7/20.4/24.3 (2, 3, 3, 3 realised 34.0/21.2/23.5/21.3)
+			return lunarDate{y: own.y, m: v[0], d: v[1]}
+		}))),
+		hzW(5, via("probe 30th of a short month", hegel.Map(hegel.SampledFrom(short), func(mm int) lunarDate {
+			return lunarDate{y: own.y, m: mm, d: 30}
+		}))),
+		hzW(4, via("probe leap flag", hegel.Map(hzTuple(hegel.SampledFrom(notLeap), hzInts(1, 29)), func(v []int) lunarDate {
+			return lunarDate{y: own.y, m: v[0], d: v[1], leap: true}
+		}))),
+		hzW(5, via("probe day 31", hegel.Map(hzInts(1, 12), func(mm int) lunarDate {
+			return lunarDate{y: own.y, m: mm, d: 31}
+		}))),
+	)
+	return hzShaped(impossible, via("probe own", hegel.Just(own)))
+}
+
+// lunarImpossibleCases: a noon moment of a table year in Shanghai (no other
+// shape there but 2033's, which the classifier filters out) with an
+// impossible probe.
+var lunarImpossibleCases = regionWhere("carbon/17", lunarShapeOf, lunarCasesFrom(noonMoments(hegel.Just("Asia/Shanghai"), lunarTableYears), impossibleProbes))
+
+func TestHegelNewLunarRejectsImpossibleDates(t *testing.T) {
+	judged(t, lunarImpossibleCases, judgeLunar)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/18: 1403 is the leap year.
+
+// persian1403Cases: a moment of 2025-03-20 to 2026-03-20 (30 Esfand 1403
+// and the year 1404, a day off under the cycle); the year after under
+// HEGEL_NO_KNOWN=1.
+var persian1403Cases = regionOf("carbon/18", persianExpected, persianCasesFrom(hzShaped(
+	momentsBetween(zoneList, "2025-03-20", "2026-03-20", false),
+	momentsBetween(zoneList, "2026-03-21", "2027-03-20", false),
+)))
+
+func TestHegelPersian1403IsTheLeapYear(t *testing.T) {
+	judged(t, persian1403Cases, judgePersian)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/19: the Persian years start in 622.
+
+// persianEarlyCases: a moment of 621-03-22 (the library's 1 Farvardin 1) to
+// 1095-03-20 (the end of the absorbed year 473); after the reform under
+// HEGEL_NO_KNOWN=1.
+var persianEarlyCases = regionOf("carbon/19", persianExpected, persianCasesFrom(hzShaped(
+	momentsBetween(zoneList, "0621-03-22", "1095-03-20", false),
+	momentsBetween(zoneList, "1583-01-01", "2000-12-31", false),
+)))
+
+func TestHegelPersianYearsStartIn622(t *testing.T) {
+	judged(t, persianEarlyCases, judgePersian)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/20: the lunar day changes at midnight.
+
+// flipZones: the ten zones with a flipping hour in most years: not UTC
+// (never), Shanghai (its 1986-1991 and 1940-1941 summers only) or Tokyo
+// (its 1948-1951 summers only).
+var flipZones = weightedOver([]int{2, 3, 5, 5, 5, 5, 5, 5, 5, 5}, "America/New_York", "Europe/London", "Australia/Sydney", "Asia/Kolkata", "America/St_Johns", "Pacific/Chatham", "Europe/Berlin", "America/Sao_Paulo", "America/Los_Angeles", "Asia/Kathmandu")
+
+// lunarFlipMinutes: the minutes of the first three hours of a date in a
+// zone at which the library's day count (libLunarCount) falls a day short of
+// the calendar's: the shape of carbon/20 (every flip of the thirteen zones
+// is in the first 2:30 of the day, the double summer time of St John's).
+func lunarFlipMinutes(zone string, y int, m time.Month, d int) []int {
+	var flip []int
+	for min := 0; min < 180; min++ {
+		t := time.Date(y, m, d, min/60, min%60, 0, 0, zones[zone])
+		if libLunarCount(t) != lunarCalendarCount(t) {
+			flip = append(flip, min)
+		}
+	}
+	return flip
+}
+
+// flipMoments: a date of a table year in a flip zone and a minute of its
+// flipping range; a date with no flipping minute (a zone at its 1900
+// offset: a summer-time zone in winter) is moved on a month at a time until
+// one is found in the year, so that the shape is reached except in the
+// years a zone had no summer time (the classifier filters those); a minute
+// from 03:00 on, in an east zone (past carbon/15 too), under HEGEL_NO_KNOWN=1.
+var flipMoments = hegel.Composite(func(tc hegel.TestCase) moment {
+	zone := hegel.Draw(tc, hzShaped(flipZones, eastZones))
+	y := hegel.Draw(tc, lunarTableYears)
+	m := time.Month(hegel.Draw(tc, months))
+	d := hegel.Draw(tc, daysOf(y.v, m))
+	date := time.Date(y.v, m, d.v, 0, 0, 0, 0, time.UTC)
+	flip := lunarFlipMinutes(zone, y.v, m, d.v)
+	for step := 1; step < 12 && len(flip) == 0; step++ {
+		next := date.AddDate(0, 0, 30*step)
+		if next.Year() > lunarMaxYear {
+			break
+		}
+		flip = lunarFlipMinutes(zone, next.Year(), next.Month(), next.Day())
+		if len(flip) > 0 {
+			date = next
+		}
+	}
+	minutes := hzInts(0, 179) // no flipping minute: the case has no shape and is filtered out
+	if len(flip) > 0 {
+		minutes = hegel.SampledFrom(flip)
+	}
+	min := hegel.Draw(tc, hzShaped(minutes, hzInts(180, 1439)))
+	s := hegel.Draw(tc, hzInts(0, 59))
+	ns := hegel.Draw(tc, nanos)
+	return moment{
+		zone:  zone,
+		t:     time.Date(date.Year(), date.Month(), date.Day(), min/60, min%60, s, ns.v, zones[zone]),
+		drawn: []string{y.via, d.via, fmt.Sprintf("flip minutes %d", len(flip)), ns.via},
+	}
+})
+
+var lunarFlipCases = regionWhere("carbon/20", lunarShapeOf, lunarCasesFrom(flipMoments, ownProbes))
+
+func TestHegelLunarDayChangesAtMidnight(t *testing.T) {
+	judged(t, lunarFlipCases, judgeLunar)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/21: the leap month of 2033 is the eleventh.
+
+// lunar2033Cases: a noon moment of 2033-08-25 (the library's leap 7th
+// month) to 2034-01-19 (the end of its 11th), in any zone; lunar 2034
+// (2034-02-19 to 2035-02-07: the twelfth month of 2033 still has the shape
+// by its LeapMonth), in an east zone (past carbon/15 too), under
+// HEGEL_NO_KNOWN=1.
+var lunar2033Cases = regionWhere("carbon/21", lunarShapeOf, lunarCasesFrom(hegel.Map(hzShaped(
+	momentsBetween(zoneList, "2033-08-25", "2034-01-19", false),
+	momentsBetween(eastZones, "2034-02-19", "2035-02-07", false),
+), func(m moment) moment {
+	y, mo, d := m.t.Date()
+	return moment{zone: m.zone, t: time.Date(y, mo, d, 12, 0, 0, 0, m.t.Location()), drawn: m.drawn[:1]}
+}), ownProbes))
+
+func TestHegelLunar2033LeapMonthIsTheEleventh(t *testing.T) {
+	judged(t, lunar2033Cases, judgeLunar)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/22: the Persian conversion round-trips before the reform.
+
+// persianPreReformCases: a moment of 1095-03-21 (Persian year 474, past
+// carbon/19) to 1582-10-14; from the reform on under HEGEL_NO_KNOWN=1.
+var persianPreReformCases = regionOf("carbon/22", persianExpected, persianCasesFrom(hzShaped(
+	momentsBetween(zoneList, "1095-03-21", "1582-10-14", false),
+	momentsBetween(zoneList, "1582-10-15", "2024-12-31", false),
+)))
+
+func TestHegelPersianRoundTripsBeforeTheReform(t *testing.T) {
+	judged(t, persianPreReformCases, judgePersian)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/23: a Julian day reads back at any magnitude.
+
+// julianMagnitudeCases: a whole-second moment before 1886-04-03 (a modified
+// Julian day of four digits or fewer) or from 2132-09-01 (six), in any
+// zone, half each; a five-digit one in UTC under HEGEL_NO_KNOWN=1.
+var julianMagnitudeCases = regionOf("carbon/23", julianExpected, hegel.Map(hzShaped(
+	hzWeighted(
+		hzW(2, momentsBetween(zoneList, "0001-01-01", "1886-04-02", true)),
+		hzW(2, momentsBetween(zoneList, "2132-09-01", "9999-12-31", true)),
+	),
+	momentsBetween(hegel.Just("UTC"), "1887-01-01", "2131-12-31", true),
+), func(m moment) julianCase { return julianCase{m: m} }))
+
+func TestHegelJulianDayReadsBackAtAnyMagnitude(t *testing.T) {
+	judged(t, julianMagnitudeCases, judgeJulian)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/24: the Julian day is proleptic before the reform.
+
+// julianPreReformCases: a whole-second moment before 1582-10-15 in any
+// zone, judged on the day-number checks alone (the read-backs would name
+// carbon/23 first: every such moment has a short modified Julian day);
+// from the reform on, in UTC (past carbon/29 too), under HEGEL_NO_KNOWN=1.
+var julianPreReformCases = regionOf("carbon/24", julianDayExpected, hegel.Map(hzShaped(
+	momentsBetween(zoneList, "0001-01-01", "1582-10-14", true),
+	momentsBetween(hegel.Just("UTC"), "1582-10-15", "2200-12-31", true),
+), func(m moment) julianCase { return julianCase{m: m} }))
+
+func TestHegelJulianDayIsProlepticBeforeTheReform(t *testing.T) {
+	judged(t, julianPreReformCases, func(j *hzCaseJudge, c julianCase) {
+		tallyDrawn(c.m.drawn...)
+		shape := classify(j, c, julianDayExpected)
+		j.Shape(shape)
+		verdictNamed(j, c, julianDayActual(c), julianDayExpected(c, hzKnownNone), shape, julianDayExpected)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// carbon/26: Sunday is Yekshanbeh.
+
+// onWeekday moves a moment to the next day of the week given (the same
+// clock).
+func onWeekday(m moment, wd time.Weekday) moment {
+	fwd := (int(wd) - int(m.t.Weekday()) + 7) % 7
+	return momentAt(m, m.t.AddDate(0, 0, fwd), m.drawn...)
+}
+
+// persianSundayCases: a Sunday of 1583 to 2024 (past the other Persian
+// shapes) with the Farsi locale; the following Monday under HEGEL_NO_KNOWN=1.
+var persianSundayCases = regionOf("carbon/26", persianExpected, hegel.Map(momentsBetween(zoneList, "1583-01-01", "2024-12-31", false), func(m moment) persianCase {
+	return persianCase{m: onWeekday(m, hzShaped(time.Sunday, time.Monday)), locale: tagged[string]{v: "fa", via: "locale fa"}}
+}))
+
+func TestHegelPersianSundayIsYekshanbeh(t *testing.T) {
+	judged(t, persianSundayCases, judgePersian)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/27: the Adars of a leap year are numbered.
+
+// rdToTime is the UTC midnight of a rata die.
+func rdToTime(rd int) time.Time { return time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC).AddDate(0, 0, rd-1) }
+
+// hebrewAdarCases: a day of month 12 of a Hebrew leap year (the leap year
+// at or after the drawn Gregorian year's), with a clock, in a zone, in a
+// locale; a day of its month 13 under HEGEL_NO_KNOWN=1.
+var hebrewAdarCases = regionOf("carbon/27", hebrewExpected, hegel.Composite(func(tc hegel.TestCase) hebrewCase {
+	hy := hegel.Draw(tc, years).v + 3760
+	if hy > 9980 {
+		hy = 9980
+	}
+	for !hebLeap(hy) {
+		hy++
+	}
+	hm := hzShaped(12, 13)
+	hd := hegel.Draw(tc, hzInts(1, hebDaysInMonth(hy, hm)))
+	zone := hegel.Draw(tc, zoneList)
+	c := hegel.Draw(tc, clocks)
+	ns := hegel.Draw(tc, nanos)
+	date := rdToTime(hebToRD(hy, hm, hd))
+	m := moment{zone: zone, t: time.Date(date.Year(), date.Month(), date.Day(), c.v.h, c.v.mi, c.v.s, ns.v, zones[zone]), drawn: []string{fmt.Sprintf("hebrew month %d", hm), c.via, ns.via}}
+	return hebrewCase{m: m, locale: hegel.Draw(tc, hebrewLocales)}
+}))
+
+func TestHegelHebrewAdarsAreNumberedInLeapYears(t *testing.T) {
+	judged(t, hebrewAdarCases, judgeHebrew)
+}
+
+// ---------------------------------------------------------------------------
+// carbon/29: the Julian day is zone-independent.
+
+// julianPairCase is a moment and the same instant in UTC.
+type julianPairCase struct{ m moment }
+
+func (c julianPairCase) GoString() string { return fmt.Sprintf("%#v and the same instant in UTC", c.m) }
+
+// julianPairExpected: the Julian days of the two are equal and read back to
+// the same instant; under carbon/29 they differ by the offset (libJulianJD
+// reads the wall clock) and so read back apart.
+func julianPairExpected(c julianPairCase, k known) checks {
+	a, _ := libJulianJD(c.m.t, k)
+	b, _ := libJulianJD(c.m.t.UTC(), k)
+	out := checks{}
+	out.set("JD equal", a == b)
+	out.set("ToGregorian(UTC) equal", julianToGregorian(a, time.UTC, k).Equal(julianToGregorian(b, time.UTC, k)))
+	return out
+}
+
+func julianPairActual(c julianPairCase) checks {
+	a := julian.FromStdTime(c.m.t)
+	b := julian.FromStdTime(c.m.t.UTC())
+	out := checks{}
+	out.set("JD equal", a.JD() == b.JD())
+	out.set("ToGregorian(UTC) equal", julian.NewJulian(a.JD()).ToGregorian("UTC").Time.Equal(julian.NewJulian(b.JD()).ToGregorian("UTC").Time))
+	return out
+}
+
+// julianPairCases: a whole-second moment at a non-zero offset (UTC and
+// London in winter are at zero: filtered out); a moment in UTC under
+// HEGEL_NO_KNOWN=1.
+var julianPairCases = regionOf("carbon/29", julianPairExpected, hegel.Map(hzShaped(
+	hzOnly(true, "zero offset", wholeMoments, func(m moment) bool { _, off := m.t.Zone(); return off != 0 }),
+	momentsIn(hegel.Just("UTC"), years, true),
+), func(m moment) julianPairCase { return julianPairCase{m: m} }))
+
+func TestHegelJulianDayIsZoneIndependent(t *testing.T) {
+	judged(t, julianPairCases, func(j *hzCaseJudge, c julianPairCase) {
+		tallyDrawn(c.m.drawn...)
+		judgeBy(j, c, julianPairExpected, julianPairActual)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// carbon/31: the Persian date of a day that begins with a DST gap.
+
+// persianGapCases: a moment of a gap day (gapDays) in its zone, with a
+// clock, nanoseconds and a locale (en on a Sunday: fa there is the shape of
+// carbon/26, which comes first by id, and 31 of Sao Paulo's 45 gap days are
+// Sundays); the day after under HEGEL_NO_KNOWN=1 (no rejection there). The
+// classifier filters out the clocks inside the gap, which Go moves to the
+// day before (the first hour of Sao Paulo's gap days, the first 75 seconds
+// of London's: 11.2 percent of the draws, the engine favouring hour 0).
+var persianGapCases = regionOf("carbon/31", persianExpected, hegel.Composite(func(tc hegel.TestCase) persianCase {
+	m := hegel.Draw(tc, hzShaped(gapDayMoments, gapDayMomentsAt(1)))
+	locale := persianLocales
+	if m.t.Weekday() == time.Sunday {
+		locale = via("locale en", hegel.Just("en"))
+	}
+	return persianCase{m: m, locale: hegel.Draw(tc, locale)}
+}))
+
+func TestHegelPersianDateIgnoresTheDstGap(t *testing.T) {
+	judged(t, persianGapCases, judgePersian)
+}
diff --git a/hegel_calendar_test.go b/hegel_calendar_test.go
new file mode 100644
index 0000000..5da83a7
--- /dev/null
+++ b/hegel_calendar_test.go
@@ -0,0 +1,993 @@
+package carbon_test
+
+// The calendar properties: the hebrew, persian, julian and lunar
+// sub-packages against models of their documented behaviour, each a case
+// record (a moment with a locale, a whole-second moment, a moment with a
+// probe lunar date) drawn from the package-level generators, a model
+// expected(c, k) of every checked value that follows the recorded bugs in k
+// as replicas of the library's rules (hegel_calendar_refs_test.go has the
+// reference algorithms, the tables and the replicas), an actual(c) that
+// asks the library, and the judge of hegel_core_test.go (the shape named
+// before the library is called, the documented values judged, the replica's
+// agreement counted). The shapes: carbon/27 for the Hebrew names; 18, 19, 22,
+// 26 and 31 for the Persian conversion and names; 23, 24 and 29 for the
+// Julian day; 15, 16, 17, 20 and 21 for the lunar calendar. Under
+// HEGEL_NO_KNOWN=1 the date-shaped cases are filtered out by the classifier
+// (withoutShapes), the locale and zone populations avoid the rest, the one
+// shape too rare to draw by chance (31's days beginning with a DST gap) is
+// an alternative of weight zero, and the two checks whose shape is one check
+// of a case (the Adar name, CreateFromLunar in the default zone) are dropped.
+
+import (
+	"fmt"
+	"math"
+	"testing"
+	"time"
+
+	"github.com/dromara/carbon/v2"
+	"github.com/dromara/carbon/v2/calendar"
+	"github.com/dromara/carbon/v2/calendar/hebrew"
+	"github.com/dromara/carbon/v2/calendar/julian"
+	"github.com/dromara/carbon/v2/calendar/lunar"
+	"github.com/dromara/carbon/v2/calendar/persian"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Shared pieces.
+
+// withoutShapes is the cases of g with no shape by the classifier under
+// HEGEL_NO_KNOWN=1 (each rejection counted "filtered carbon/N" by the shape
+// it had), g itself otherwise: the form of a family whose shapes are
+// relations of the moment (a date in a range, a clock in a flipping hour).
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// localesOf: two locales of a calendar's naming methods, half each (the
+// first the shrink target).
+func localesOf(a, b string, wa, wb int) hegel.Generator[tagged[string]] {
+	return hzWeighted(
+		hzW(wa, via("locale "+a, hegel.Just(a))),
+		hzW(wb, via("locale "+b, hegel.Just(b))),
+	)
+}
+
+// verdictNamed is verdict with the checks the named shape moves compared
+// first, so that the failure of a case with the shapes of two bugs reports a
+// check of the one it names: a Julian case before 1886 in a zone has the
+// shapes of carbon/23 (its MJD read-back), 24 and 29 (its JD) and is named
+// 23, while "JD" sorts before "NewJulian(MJD)".
+func verdictNamed[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if i := hzKnownIndex(shape); i >= 0 {
+		none, moved := expected(c, hzKnownNone), expected(c, hzKnownOnly(i))
+		if sameChecks(none, moved) {
+			none, moved = expected(c, hzKnownAll), expected(c, hzKnownAllBut(i))
+		}
+		for _, k := range sortedKeys(want) {
+			if moved[k] == none[k] {
+				continue
+			}
+			if g, ok := got[k]; !ok {
+				j.Fail(k, "%s was not checked for %#v", k, c)
+			} else if g != want[k] {
+				j.Fail(k, "%s = %s, want %s for %#v", k, g, want[k], c)
+			}
+			delete(want, k)
+		}
+	}
+	verdict(j, c, got, want, shape, expected)
+}
+
+// gregorianDate prints a calendar package result: its date, or "error" for
+// an empty one.
+func gregorianDate(g *calendar.Gregorian) string {
+	if g == nil || g.Error != nil || g.Time.IsZero() {
+		return "error"
+	}
+	return g.Time.Format("2006-01-02")
+}
+
+// carbonDate prints a Carbon's date, or "error".
+func carbonDate(c *carbon.Carbon) string {
+	if c == nil || c.HasError() {
+		return "error"
+	}
+	return c.ToDateString()
+}
+
+// monthLength describes a month's length as the validity of its last day
+// and the day after: the length when they are as the calendar has them,
+// else what was found.
+func monthLength(last int, lastValid, afterValid bool) string {
+	if lastValid && !afterValid {
+		return fmt.Sprint(last)
+	}
+	return fmt.Sprintf("not %d (day %d valid %v, day %d valid %v)", last, last, lastValid, last+1, afterValid)
+}
+
+// recovered runs a library call that may panic, giving "panic" for it.
+func recovered(f func() string) (s string) {
+	defer func() {
+		if r := recover(); r != nil {
+			s = "panic"
+		}
+	}()
+	return f()
+}
+
+// ---------------------------------------------------------------------------
+// Hebrew.
+
+type hebrewCase struct {
+	m      moment
+	locale tagged[string]
+}
+
+func (c hebrewCase) GoString() string { return fmt.Sprintf("%#v locale=%s", c.m, c.locale.v) }
+
+// hebrewLocales: en or he, half each (50/50 nominal: weights 2 and 4 realise
+// 47.6/52.4 in the wide property and 50.9/49.1 in carbon/27's narrow one;
+// 2 and 3 realised 57.9/42.1, 2 and 5 44.9/55.1).
+var hebrewLocales = localesOf("en", "he", 2, 4)
+
+var hebrewCases = hegel.Composite(func(tc hegel.TestCase) hebrewCase {
+	return hebrewCase{m: hegel.Draw(tc, moments), locale: hegel.Draw(tc, hebrewLocales)}
+})
+
+// hebrewDocOf is the documented Hebrew date of a moment: Reingold &
+// Dershowitz on the calendar date, in the library's Hebrew years 1-9999; ok
+// false past them (the library's FromStdTime computes the year and IsValid
+// rejects it) and for the zero time, which the library treats as no time
+// (hebrew.go:48-50 returns nil, calendar.go:80-82 an empty Hebrew).
+func hebrewDocOf(t time.Time) (y, m, d int, ok bool) {
+	if t.IsZero() {
+		return 0, 0, 0, false
+	}
+	gy, gm, gd := t.Date()
+	y, m, d = rdToHeb(gregToRD(gy, int(gm), gd))
+	return y, m, d, y >= 1 && y <= 9999
+}
+
+func hebrewValue(y, m, d int, ok bool) string {
+	if !ok {
+		return "invalid"
+	}
+	return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
+}
+
+func hebrewLibValue(h *hebrew.Hebrew) string {
+	if h == nil || !h.IsValid() {
+		return "invalid"
+	}
+	return h.String()
+}
+
+// hebrewExpected: the conversion both ways on the calendar date, the year's
+// shape, the month's length, the next day, and the names in the locale;
+// month 12 of a leap year is Adar I (hebrewAdarI) or, under carbon/27, the
+// table's "Adar" of every year (hebrew.go:26-27, 144-155: EnMonths[month-1]).
+func hebrewExpected(c hebrewCase, k known) checks {
+	tm, loc := c.m.t, c.locale.v
+	out := checks{}
+	hy, hm, hd, ok := hebrewDocOf(tm)
+	out["FromStdTime"] = hebrewValue(hy, hm, hd, ok)
+	out["Hebrew()"] = out["FromStdTime"]
+	ny, nm, nd, nok := hebrewDocOf(tm.AddDate(0, 0, 1))
+	out["next day"] = hebrewValue(ny, nm, nd, nok)
+	out.set("IsValid", ok)
+	if !ok {
+		out["CreateFromHebrew"] = "error"
+		return out
+	}
+	date := tm.Format("2006-01-02")
+	out["ToGregorian"] = date
+	out["CreateFromHebrew"] = date
+	out.set("IsLeapYear", hebLeap(hy))
+	out.set("month 13 valid", hebLeap(hy))
+	out["month length"] = monthLength(hebDaysInMonth(hy, hm), true, false)
+	name := hebrewMonthsOf[loc][hm-1]
+	if hm == 12 && hebLeap(hy) && !k[kAdarUnnumbered] {
+		name = hebrewAdarI[loc]
+	}
+	out["ToMonthString"] = name
+	out["ToWeekString"] = hebrewWeeksOf[loc][tm.Weekday()]
+	return out
+}
+
+func hebrewActual(c hebrewCase) checks {
+	tm, loc := c.m.t, hebrew.Locale(c.locale.v)
+	out := checks{}
+	out["FromStdTime"] = hebrewLibValue(hebrew.FromStdTime(tm))
+	out["Hebrew()"] = hebrewLibValue(carbonOf(c.m).Hebrew())
+	out["next day"] = hebrewLibValue(hebrew.FromStdTime(tm.AddDate(0, 0, 1)))
+	hy, hm, hd, ok := hebrewDocOf(tm)
+	h := hebrew.NewHebrew(hy, hm, hd)
+	out.set("IsValid", h.IsValid())
+	out["CreateFromHebrew"] = carbonDate(carbon.CreateFromHebrew(hy, hm, hd))
+	if !ok {
+		return out
+	}
+	out["ToGregorian"] = gregorianDate(h.ToGregorian(c.m.zone))
+	out.set("IsLeapYear", h.IsLeapYear())
+	out.set("month 13 valid", hebrew.NewHebrew(hy, 13, 1).IsValid())
+	last := hebDaysInMonth(hy, hm)
+	out["month length"] = monthLength(last, hebrew.NewHebrew(hy, hm, last).IsValid(), hebrew.NewHebrew(hy, hm, last+1).IsValid())
+	// The name of month 12 in a leap year is compared as the pin
+	// (TestHegelPinHebrewAdarNamesInLeapYear) reads the documentation: any
+	// name that differs from month 13's and from the common year's "Adar"
+	// stands for the model's "Adar Aleph" (the note gives that form, but the
+	// documentation fixes none).
+	name := h.ToMonthString(loc)
+	if hm == 12 && hebLeap(hy) && name != hebrewMonthsOf[c.locale.v][12] && name != hebrewMonthsOf[c.locale.v][11] {
+		name = hebrewAdarI[c.locale.v]
+	}
+	out["ToMonthString"] = name
+	out["ToWeekString"] = h.ToWeekString(loc)
+	return out
+}
+
+// judgeHebrew: the family's one shape, carbon/27, is the name of month 12 in
+// a leap year; under HEGEL_NO_KNOWN=1 that check is dropped and the case
+// goes on.
+func judgeHebrew(j *hzCaseJudge, c hebrewCase) {
+	tallyDrawn(append(c.m.drawn, c.locale.via)...)
+	shape := classify(j, c, hebrewExpected)
+	want := hebrewExpected(c, hzKnownNone)
+	if j.Dropped(shape) {
+		delete(want, "ToMonthString")
+	}
+	verdictNamed(j, c, hebrewActual(c), want, shape, hebrewExpected)
+}
+
+func TestHegelHebrewCalendarAgreesWithReingoldDershowitz(t *testing.T) {
+	judged(t, hebrewCases, judgeHebrew)
+}
