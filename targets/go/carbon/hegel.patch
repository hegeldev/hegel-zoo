+func TestHegelBoundariesAgreeWithModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		c, tm := genCarbon(tc)
+		ws := pick(tc, weekdays...)
+		c.SetWeekStartsAt(ws)
+		note(ht, "%s weekStartsAt=%s", showTime(tm), ws)
+		loc := tm.Location()
+		y, m, d := tm.Date()
+		h, mi, s := tm.Clock()
+		date := func(y int, m time.Month, d, h, mi, s, ns int) time.Time {
+			return time.Date(y, m, d, h, mi, s, ns, loc)
+		}
+		last := func(y int, m time.Month) int { return daysIn(y, m) }
+		q := modelQuarter(m)
+		seasonStartMonth := time.Month(int(m) / 3 * 3) // 3, 6, 9, 12 (0 for Jan/Feb)
+		seasonStartYear := y
+		if m == time.January || m == time.February {
+			seasonStartMonth, seasonStartYear = time.December, y-1
+		}
+		seasonEndYear, seasonEndMonth := seasonStartYear, seasonStartMonth+2
+		if seasonStartMonth == time.December {
+			seasonEndYear, seasonEndMonth = seasonStartYear+1, time.February
+		}
+		cases := map[string]struct {
+			got  *carbon.Carbon
+			want time.Time
+		}{
+			"StartOfCentury": {c.StartOfCentury(), date(y/100*100, 1, 1, 0, 0, 0, 0)},
+			"EndOfCentury":   {c.EndOfCentury(), date(y/100*100+99, 12, 31, 23, 59, 59, 999999999)},
+			"StartOfDecade":  {c.StartOfDecade(), date(y/10*10, 1, 1, 0, 0, 0, 0)},
+			"EndOfDecade":    {c.EndOfDecade(), date(y/10*10+9, 12, 31, 23, 59, 59, 999999999)},
+			"StartOfYear":    {c.StartOfYear(), date(y, 1, 1, 0, 0, 0, 0)},
+			"EndOfYear":      {c.EndOfYear(), date(y, 12, 31, 23, 59, 59, 999999999)},
+			"StartOfQuarter": {c.StartOfQuarter(), date(y, time.Month(3*q-2), 1, 0, 0, 0, 0)},
+			"EndOfQuarter":   {c.EndOfQuarter(), date(y, time.Month(3*q), last(y, time.Month(3*q)), 23, 59, 59, 999999999)},
+			"StartOfMonth":   {c.StartOfMonth(), date(y, m, 1, 0, 0, 0, 0)},
+			"EndOfMonth":     {c.EndOfMonth(), date(y, m, last(y, m), 23, 59, 59, 999999999)},
+			"StartOfWeek":    {c.StartOfWeek(), modelStartOfWeek(tm, ws)},
+			"EndOfWeek":      {c.EndOfWeek(), modelEndOfWeek(tm, ws)},
+			"StartOfDay":     {c.StartOfDay(), date(y, m, d, 0, 0, 0, 0)},
+			"EndOfDay":       {c.EndOfDay(), date(y, m, d, 23, 59, 59, 999999999)},
+			"StartOfHour":    {c.StartOfHour(), date(y, m, d, h, 0, 0, 0)},
+			"EndOfHour":      {c.EndOfHour(), date(y, m, d, h, 59, 59, 999999999)},
+			"StartOfMinute":  {c.StartOfMinute(), date(y, m, d, h, mi, 0, 0)},
+			"EndOfMinute":    {c.EndOfMinute(), date(y, m, d, h, mi, 59, 999999999)},
+			"StartOfSecond":  {c.StartOfSecond(), date(y, m, d, h, mi, s, 0)},
+			"EndOfSecond":    {c.EndOfSecond(), date(y, m, d, h, mi, s, 999999999)},
+			"StartOfSeason":  {c.StartOfSeason(), date(seasonStartYear, seasonStartMonth, 1, 0, 0, 0, 0)},
+			"EndOfSeason":    {c.EndOfSeason(), date(seasonEndYear, seasonEndMonth, last(seasonEndYear, seasonEndMonth), 23, 59, 59, 999999999)},
+		}
+		for name, r := range cases {
+			if !sameInstant(r.got, r.want) || r.got.Timezone() != loc.String() {
+				fail(ht, "%s of %s = %s, want %s", name, showTime(tm), showCarbon(r.got), showTime(r.want))
+			}
+			if r.got.WeekStartsAt() != ws {
+				fail(ht, "%s lost the week start (%s, want %s)", name, r.got.WeekStartsAt(), ws)
+			}
+		}
+		if !sameInstant(c, tm) {
+			fail(ht, "the receiver changed: %s", showCarbon(c))
+		}
+	})
+}
