+package carbon_test
+
+// The data of the calendar models (hegel_calendar_test.go): the reference
+// algorithms written from the literature (Reingold & Dershowitz for the
+// Hebrew calendar, the Birashk 2820-year cycle in Fourmilab's formulation
+// for the Persian calendar with the official calendar's deviation of
+// 1403/1404, Fliegel & Van Flandern day numbers), the Hong Kong
+// Observatory's leap months and New Year dates, the lunar calendar's own
+// table read back through the library's clean region, the month and weekday
+// names of the Persian and Hebrew calendars, and the replicas of the
+// library's rules that the switches of the recorded bugs select: the
+// Persian package's integer arithmetic (carbon/19) and historical day number
+// (22), the Julian package's day-number formula (24, 29), digit heuristic
+// (23) and decoding, and the lunar package's day count (20), table walk (16,
+// 21) and date arithmetic (15, 17). Every replica names the library lines it
+// follows.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"time"
+
+	"github.com/dromara/carbon/v2/calendar/lunar"
+)
+
+func floorDiv(a, b int) int {
+	q := a / b
+	if a%b != 0 && (a < 0) != (b < 0) {
+		q--
+	}
+	return q
+}
+
+func mod(a, b int) int { return a - b*floorDiv(a, b) }
+
+// gregJDN is the Julian day number (at noon) of a proleptic Gregorian date.
+func gregJDN(y, m, d int) int {
+	a := (14 - m) / 12
+	yy := y + 4800 - a
+	mm := m + 12*a - 3
+	return d + (153*mm+2)/5 + 365*yy + yy/4 - yy/100 + yy/400 - 32045
+}
+
+// jdnTime is the proleptic Gregorian date of a Julian day number, at
+// midnight UTC (2000-01-01 is JDN 2451545).
+func jdnTime(jdn int) time.Time {
+	return time.Date(2000, time.January, 1+jdn-2451545, 0, 0, 0, 0, time.UTC)
+}
+
+func jdnDate(jdn int) string { return jdnTime(jdn).Format("2006-01-02") }
+
+// gregToRD is the rata die (fixed day number, 0001-01-01 = 1) of a
+// proleptic Gregorian date.
+func gregToRD(y, m, d int) int {
+	prior := y - 1
+	rd := 365*prior + floorDiv(prior, 4) - floorDiv(prior, 100) + floorDiv(prior, 400)
+	rd += (367*m - 362) / 12
+	if m > 2 {
+		if isLeap(y) {
+			rd--
+		} else {
+			rd -= 2
+		}
+	}
+	return rd + d
+}
+
+// ---------------------------------------------------------------------------
+// Hebrew (Reingold & Dershowitz; months numbered Nisan = 1, Tishri = 7).
+
+func hebLeap(y int) bool { return (7*y+1)%19 < 7 }
+
+func hebElapsedDays(year int) int {
+	monthsElapsed := 235*((year-1)/19) + 12*((year-1)%19) + (7*((year-1)%19)+1)/19
+	partsElapsed := 204 + 793*(monthsElapsed%1080)
+	hoursElapsed := 5 + 12*monthsElapsed + 793*(monthsElapsed/1080) + partsElapsed/1080
+	day := 1 + 29*monthsElapsed + hoursElapsed/24
+	parts := 1080*(hoursElapsed%24) + partsElapsed%1080
+	alt := day
+	if parts >= 19440 || (day%7 == 2 && parts >= 9924 && !hebLeap(year)) || (day%7 == 1 && parts >= 16789 && hebLeap(year-1)) {
+		alt = day + 1
+	}
+	switch alt % 7 {
+	case 0, 3, 5:
+		alt++
+	}
+	return alt
+}
+
+func hebDaysInYear(y int) int { return hebElapsedDays(y+1) - hebElapsedDays(y) }
+
+func hebLastMonth(y int) int {
+	if hebLeap(y) {
+		return 13
+	}
+	return 12
+}
+
+func hebDaysInMonth(y, m int) int {
+	switch m {
+	case 2, 4, 6, 10, 13:
+		return 29
+	case 12:
+		if !hebLeap(y) {
+			return 29
+		}
+		return 30
+	case 8:
+		if hebDaysInYear(y)%10 == 5 {
+			return 30
+		}
+		return 29
+	case 9:
+		if hebDaysInYear(y)%10 == 3 {
+			return 29
+		}
+		return 30
+	}
+	return 30
+}
+
+// hebToRD: the epoch constant is fixed once from a known date (1 Tishri
+// 5780 = Monday 2019-09-30) so the algorithm's own epoch convention does
+// not matter.
+var hebEpochRD = func() int {
+	raw := func(y, m, d int) int {
+		rd := d
+		if m < 7 {
+			for mm := 7; mm <= hebLastMonth(y); mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+			for mm := 1; mm < m; mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+		} else {
+			for mm := 7; mm < m; mm++ {
+				rd += hebDaysInMonth(y, mm)
+			}
+		}
+		return rd + hebElapsedDays(y)
+	}
+	off := gregToRD(2019, 9, 30) - raw(5780, 7, 1)
+	// two more anchors: 15 Nisan 5784 = 2024-04-23, 1 Tishri 5785 = 2024-10-03
+	if raw(5784, 1, 15)+off != gregToRD(2024, 4, 23) || raw(5785, 7, 1)+off != gregToRD(2024, 10, 3) {
+		panic("hebrew reference does not reproduce the anchor dates")
+	}
+	return off
+}()
+
+func hebToRD(y, m, d int) int {
+	rd := d
+	if m < 7 {
+		for mm := 7; mm <= hebLastMonth(y); mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+		for mm := 1; mm < m; mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+	} else {
+		for mm := 7; mm < m; mm++ {
+			rd += hebDaysInMonth(y, mm)
+		}
+	}
+	return rd + hebElapsedDays(y) + hebEpochRD
+}
+
+func rdToHeb(rd int) (y, m, d int) {
+	y = (rd-hebToRD(1, 7, 1))*98496/35975351 + 1
+	for hebToRD(y+1, 7, 1) <= rd {
+		y++
+	}
+	for hebToRD(y, 7, 1) > rd {
+		y--
+	}
+	order := []int{7, 8, 9, 10, 11, 12, 13, 1, 2, 3, 4, 5, 6}
+	for _, mm := range order {
+		if mm == 13 && !hebLeap(y) {
+			continue
+		}
+		start := hebToRD(y, mm, 1)
+		if rd < start+hebDaysInMonth(y, mm) {
+			return y, mm, rd - start + 1
+		}
+	}
+	panic("rdToHeb: no month")
+}
+
+// The month names (Nisan first, Adar Bet thirteenth) and the weekday names
+// of the Hebrew calendar, written from the calendar: the English
+// transliterations the library prints are legitimate variants (Iyyar for
+// Iyar, Teveth for Tevet, Adar Bet for Adar II) and are kept as they are so
+// that the names check them, the Hebrew spellings are the common full ones
+// (with the vav doubled in Sivan and Heshvan); the weekdays print in
+// English, not transliterated (Yom Rishon), as the library documents them.
+// Month 12 of a leap year is Adar I (Adar Aleph), hebrewAdarI: the note of
+// carbon/27 gives the forms.
+var (
+	hebrewEnMonths = []string{"Nisan", "Iyyar", "Sivan", "Tammuz", "Av", "Elul", "Tishri", "Heshvan", "Kislev", "Teveth", "Shevat", "Adar", "Adar Bet"}
+	hebrewHeMonths = []string{
+		"\u05e0\u05d9\u05e1\u05df", "\u05d0\u05d9\u05d9\u05e8", "\u05e1\u05d9\u05d5\u05d5\u05df", "\u05ea\u05de\u05d5\u05d6", "\u05d0\u05d1", "\u05d0\u05dc\u05d5\u05dc",
+		"\u05ea\u05e9\u05e8\u05d9", "\u05d7\u05e9\u05d5\u05d5\u05df", "\u05db\u05e1\u05dc\u05d5", "\u05d8\u05d1\u05ea", "\u05e9\u05d1\u05d8", "\u05d0\u05d3\u05e8", "\u05d0\u05d3\u05e8 \u05d1",
+	}
+	hebrewAdarI    = map[string]string{"en": "Adar Aleph", "he": "\u05d0\u05d3\u05e8 \u05d0\u05f3"}
+	hebrewEnWeeks  = []string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
+	hebrewHeWeeks  = []string{"\u05e8\u05d0\u05e9\u05d5\u05df", "\u05e9\u05e0\u05d9", "\u05e9\u05dc\u05d9\u05e9\u05d9", "\u05e8\u05d1\u05d9\u05e2\u05d9", "\u05d7\u05de\u05d9\u05e9\u05d9", "\u05e9\u05d9\u05e9\u05d9", "\u05e9\u05d1\u05ea"}
+	hebrewMonthsOf = map[string][]string{"en": hebrewEnMonths, "he": hebrewHeMonths}
+	hebrewWeeksOf  = map[string][]string{"en": hebrewEnWeeks, "he": hebrewHeWeeks}
+)
+
+// ---------------------------------------------------------------------------
+// Persian (Birashk 2820-year cycle, Fourmilab's formulation, with floor
+// division), and the official calendar's deviation from it.
+
+const persianEpoch = 1948320 // the day before 1 Farvardin 1 (622-03-22), persian.go:18
+
+func perToJDN(year, month, day int) int {
+	epbase := year - 474
+	if year < 0 {
+		epbase = year - 473
+	}
+	epyear := 474 + mod(epbase, 2820)
+	return day + perMonthDays(month) + floorDiv(epyear*682-110, 2816) + (epyear-1)*365 + floorDiv(epbase, 2820)*1029983 + persianEpoch
+}
+
+// perMonthDays is the day of the year before month m (31-day months to
+// Mehr, 30-day ones after; persian.go:218-223).
+func perMonthDays(month int) int {
+	if month <= 7 {
+		return (month - 1) * 31
+	}
+	return (month-1)*30 + 6
+}
+
+func perLeap(year int) bool { return perToJDN(year+1, 1, 1)-perToJDN(year, 1, 1) == 366 }
+
+// jdnToPer is the cycle's closed-form inverse (the reference the
+// parametrised conversion below is checked against).
+func jdnToPer(jdn int) (int, int, int) {
+	depoch := jdn - perToJDN(475, 1, 1)
+	cycle := floorDiv(depoch, 1029983)
+	cyear := mod(depoch, 1029983)
+	var ycycle int
+	if cyear == 1029982 {
+		ycycle = 2820
+	} else {
+		aux1 := cyear / 366
+		aux2 := mod(cyear, 366)
+		ycycle = floorDiv(2134*aux1+2816*aux2+2815, 1028522) + aux1 + 1
+	}
+	year := ycycle + 2820*cycle + 474
+	if year <= 0 {
+		year--
+	}
+	yday := jdn - perToJDN(year, 1, 1) + 1
+	var month int
+	if yday <= 186 {
+		month = (yday-1)/31 + 1
+	} else {
+		month = (yday-187)/30 + 7
+	}
+	day := jdn - perToJDN(year, month, 1) + 1
+	return year, month, day
+}
+
+// The official (astronomical) Iranian calendar's Nowruz for recent years.
+var nowruz = map[int]string{
+	1398: "2019-03-21", 1399: "2020-03-20", 1400: "2021-03-21", 1401: "2022-03-21", 1402: "2023-03-21",
+	1403: "2024-03-20", 1404: "2025-03-21", 1405: "2026-03-21", 1406: "2027-03-21", 1407: "2028-03-20", 1408: "2029-03-20",
+}
+
+// persianDeviation: the years in which the official calendar's leap years
+// differ from the 2820-year cycle's, with the official reading (carbon/18):
+// the Nowruz dates 1398-1408 above establish that the cycle and the official
+// calendar agree for 1398-1402 and 1405-1408 and differ in 1403 (official
+// leap, cycle common) and 1404 (the reverse); beyond the table's reach the
+// model follows the cycle (the note of carbon/18 says it deviates again
+// around 1436, which no Nowruz date here establishes).
+var persianDeviation = []struct {
+	year int
+	leap bool
+}{{1403, true}, {1404, false}}
+
+// perShift is the days 1 Farvardin of a year falls after the cycle's: the
+// leap days the official calendar had before the year that the cycle did
+// not, less the reverse.
+func perShift(year int) int {
+	shift := 0
+	for _, d := range persianDeviation {
+		if d.year < year {
+			if d.leap {
+				shift++
+			}
+			if perLeap(d.year) {
+				shift--
+			}
+		}
+	}
+	return shift
+}
+
+// persianYearStart is the Julian day number of 1 Farvardin of a year under
+// the switches: the cycle by floor division (perToJDN) or, under carbon/19,
+// the library's integer arithmetic (libPersianJdn), with the official
+// deviation (perShift) unless carbon/18 follows the cycle alone.
+func persianYearStart(year int, k known) int {
+	start := perToJDN(year, 1, 1)
+	if k[kPersianEarlyYearsShifted] {
+		start = libPersianJdn(year, 1, 1)
+	}
+	if !k[kPersian1403NotLeap] {
+		start += perShift(year)
+	}
+	return start
+}
+
+// persianToJDN, persianLeap, persianDaysInMonth, persianValid: the
+// library's rules (persian.go:212-225 getPersianJdn, 177-184 IsLeapYear,
+// 154-173 IsValid) over persianYearStart.
+func persianToJDN(year, month, day int, k known) int {
+	return persianYearStart(year, k) + perMonthDays(month) + day - 1
+}
+
+func persianLeap(year int, k known) bool {
+	return persianYearStart(year+1, k)-persianYearStart(year, k) > 365
+}
+
+func persianDaysInMonth(year, month int, k known) int {
+	switch {
+	case month <= 6:
+		return 31
+	case month <= 11:
+		return 30
+	case persianLeap(year, k):
+		return 30
+	}
+	return 29
+}
+
+func persianValid(year, month, day int, k known) bool {
+	if year < 1 || year > 9999 || month <= 0 || month > 12 || day <= 0 || day > 31 {
+		return false
+	}
+	if month > 6 && month <= 11 && day > 30 {
+		return false
+	}
+	if month == 12 {
+		if (!persianLeap(year, k) && day > 29) || (persianLeap(year, k) && day > 30) {
+			return false
+		}
+	}
+	return true
+}
+
+// persianFromJDN is persian.go:187-209 (getPersianYear: the range estimate,
+// then a binary search over the year starts) and 228-238 (jdn2persian: the
+// month by the day of the year, 186 days to the end of Shahrivar) over
+// persianYearStart; a year of -1 (no year holds the day) is an invalid date.
+func persianFromJDN(jdn int, k known) (year, month, day int) {
+	// The library's getPersianYear first estimates the year as 474 + days/365
+	// and gives up when that is over 9999, which cuts the years from 9521 on;
+	// they are past Gregorian 9999 (Persian 9378 is the last reached from a
+	// Gregorian year the library accepts), so the model leaves the estimate out.
+	year = -1
+	low, high := 1, 9999
+	for low <= high {
+		mid := (low + high) / 2
+		yearStart := persianYearStart(mid, k)
+		nextYearStart := persianYearStart(mid+1, k)
+		if jdn >= yearStart && jdn < nextYearStart {
+			year = mid
+			break
+		}
+		if jdn < yearStart {
+			high = mid - 1
+		} else {
+			low = mid + 1
+		}
+	}
+	if year < 0 {
+		return -1, 0, 0
+	}
+	days := jdn - persianYearStart(year, k) + 1
+	if days <= 186 {
+		month = (days-1)/31 + 1
+	} else {
+		month = (days-186-1)/30 + 7
+	}
+	day = jdn - (persianYearStart(year, k) + perMonthDays(month)) + 1
+	return year, month, day
+}
+
+// libPersianJdn is persian.go:212-225 (getPersianJdn) as the library has it:
+// Go's truncating division and remainder, and the extra decrement of the
+// cycle offset for years before 474, which together shift years 1-473 a
+// year early and make year 473 730 days long (carbon/19).
+func libPersianJdn(year, month, day int) int {
+	yearOffset := year - 474
+	if yearOffset < 0 {
+		yearOffset--
+	}
+	cycleYear := 474 + (yearOffset % 2820)
+	return day + perMonthDays(month) + (cycleYear*682-110)/2816 + (cycleYear-1)*365 + yearOffset/2820*1029983 + persianEpoch
+}
+
+// libHistoricalJDN is the day number persian.FromStdTime converts from
+// (persian.go:49): the Julian package's JD of the date's midnight, rounded,
+// which is the Julian calendar's day number before 1582-10-15 (carbon/22).
+func libHistoricalJDN(y, m, d int) int {
+	jd, _ := libJulianJD(time.Date(y, time.Month(m), d, 0, 0, 0, 0, time.UTC), hzKnownOnly(kJulianPreReformCalendar))
+	return int(math.Round(jd))
+}
+
+// persianRefsChecked: the documented conversion (the cycle with the
+// deviation) inverts itself, agrees with the closed form outside the
+// deviation years, reproduces every Nowruz date of the table and makes 1403
+// the leap year; the cycle alone makes 1404 the leap year.
+var persianRefsChecked = func() bool {
+	none := hzKnownNone
+	for y := 1; y <= 9999; y += 7 {
+		for _, m := range []int{1, 7, 12} {
+			d := persianDaysInMonth(y, m, none)
+			if yy, mm, dd := persianFromJDN(persianToJDN(y, m, d, none), none); yy != y || mm != m || dd != d {
+				panic(fmt.Sprintf("persian reference: %d-%d-%d reads back as %d-%d-%d", y, m, d, yy, mm, dd))
+			}
+			if y < 1403 || y > 1404 {
+				if ry, rm, rd := jdnToPer(persianToJDN(y, m, d, none)); ry != y || rm != m || rd != d {
+					panic(fmt.Sprintf("persian reference: the closed form reads %d-%d-%d as %d-%d-%d", y, m, d, ry, rm, rd))
+				}
+			}
+		}
+	}
+	for y, want := range nowruz {
+		if got := jdnDate(persianToJDN(y, 1, 1, none)); got != want {
+			panic(fmt.Sprintf("persian reference: 1 Farvardin %d = %s, the official calendar has %s", y, got, want))
+		}
+	}
+	if !persianLeap(1403, none) || persianLeap(1404, none) || perLeap(1403) || !perLeap(1404) {
+		panic("persian reference: the deviation of 1403/1404 is not as recorded")
+	}
+	if gregJDN(2000, 1, 1) != 2451545 || gregJDN(622, 3, 22) != persianEpoch+1 {
+		panic("persian reference: the day numbers are off")
+	}
+	return true
+}()
+
+// The month names (Farvardin first) and the weekday names (Sunday first)
+// of the Persian calendar, in English transliteration and in Farsi, written
+// from the calendar; Tuesday's Farsi name is spelled with a space between
+// its two words, as the library spells it (the joined spelling with a
+// zero-width non-joiner is the other common one). Sunday is Yekshanbeh,
+// which carbon/26 misnames.
+var (
+	persianEnMonths = []string{"Farvardin", "Ordibehesht", "Khordad", "Tir", "Mordad", "Shahrivar", "Mehr", "Aban", "Azar", "Dey", "Bahman", "Esfand"}
+	persianFaMonths = []string{
+		"\u0641\u0631\u0648\u0631\u062f\u06cc\u0646", "\u0627\u0631\u062f\u06cc\u0628\u0647\u0634\u062a", "\u062e\u0631\u062f\u0627\u062f", "\u062a\u06cc\u0631",
+		"\u0645\u0631\u062f\u0627\u062f", "\u0634\u0647\u0631\u06cc\u0648\u0631", "\u0645\u0647\u0631", "\u0622\u0628\u0627\u0646",
+		"\u0622\u0630\u0631", "\u062f\u06cc", "\u0628\u0647\u0645\u0646", "\u0627\u0633\u0641\u0646\u062f",
+	}
+	persianEnWeeks = []string{"Yekshanbeh", "Doshanbeh", "Seshanbeh", "Chaharshanbeh", "Panjshanbeh", "Jomeh", "Shanbeh"}
+	persianFaWeeks = []string{
+		"\u06cc\u06a9\u0634\u0646\u0628\u0647", "\u062f\u0648\u0634\u0646\u0628\u0647", "\u0633\u0647 \u0634\u0646\u0628\u0647", "\u0686\u0647\u0627\u0631\u0634\u0646\u0628\u0647",
+		"\u067e\u0646\u062c\u0634\u0646\u0628\u0647", "\u062c\u0645\u0639\u0647", "\u0634\u0646\u0628\u0647",
+	}
+	persianMonthsOf = map[string][]string{"en": persianEnMonths, "fa": persianFaMonths}
+	persianWeeksOf  = map[string][]string{"en": persianEnWeeks, "fa": persianFaWeeks}
+	// libFaSunday is persian.FaWeeks[0]: Panjshanbeh less its first letter (carbon/26).
+	libFaSunday = "\u0646\u062c\u0634\u0646\u0628\u0647"
+)
+
+// ---------------------------------------------------------------------------
+// Julian day numbers: the library's formula, constructor and decoding.
+
+// parseFloat64 is julian.go:146-149: a value rounded to n decimals.
+func parseFloat64(f float64, n int) float64 {
+	p10 := math.Pow10(n)
+	return math.Round(f*p10) / p10
+}
+
+// libJulianJD is julian.go:47-73 (FromStdTime) under the switches, as the
+// pair JD() and MJD() print (six decimals): the day number from the
+// calendar fields by the Meeus formula, read from the local wall clock
+// under carbon/29 (the UTC clock otherwise) and with the Julian calendar
+// before 1582-10-15 under carbon/24 (the Gregorian correction for every date
+// otherwise); the zero time is the constant of julian.go:49-53 (the Julian
+// calendar's 0001-01-01, two days before the proleptic date's number).
+func libJulianJD(t time.Time, k known) (jd, mjd float64) {
+	if t.IsZero() {
+		jd = 1721423.5
+		if !k[kJulianPreReformCalendar] {
+			jd = 1721425.5
+		}
+		return parseFloat64(jd, 6), parseFloat64(jd-2400000.5, 6)
+	}
+	if !k[kJulianIgnoresZone] {
+		t = t.UTC()
+	}
+	y := t.Year()
+	m := int(t.Month())
+	d := float64(t.Day()) + ((float64(t.Second())/60+float64(t.Minute()))/60+float64(t.Hour()))/24
+	n := 0
+	f := false
+	if (y > 1582) || (y == 1582 && m > 10) || (y == 1582 && m == 10 && int(d) >= 15) {
+		f = true
+	}
+	if !k[kJulianPreReformCalendar] {
+		f = true
+	}
+	if m <= 2 {
+		m += 12
+		y--
+	}
+	if f {
+		n = y / 100
+		n = 2 - n + n/4
+	}
+	jd = float64(int(365.25*(float64(y)+4716))) + float64(int(30.6001*(float64(m)+1))) + d + float64(n) - 1524.5
+	return parseFloat64(jd, 6), parseFloat64(jd-2400000.5, 6)
+}
+
+// libNewJulian is julian.go:26-44 (NewJulian): the digits of the ceiling
+// decide between a modified Julian day (five) and a Julian day (seven), and
+// anything else is day zero (carbon/23).
+func libNewJulian(f float64) (jd, mjd float64) {
+	switch len(strconv.Itoa(int(math.Ceil(f)))) {
+	case 5:
+		return f + 2400000.5, f
+	case 7:
+		return f, f - 2400000.5
+	}
+	return 0, 0
+}
+
+// libJulianDecode is julian.go:88-116 (ToGregorian's arithmetic): the
+// calendar fields of a Julian day, Gregorian from JD 2299161 (1582-10-15)
+// and Julian before.
+func libJulianDecode(jd float64) (year, month, day, hour, minute, second int) {
+	d := int(jd + 0.5)
+	f := jd + 0.5 - float64(d)
+	if d >= 2299161 {
+		c := int((float64(d) - 1867216.25) / 36524.25)
+		d += 1 + c - c/4
+	}
+	d += 1524
+	year = int((float64(d) - 122.1) / 365.25)
+	d -= int(365.25 * float64(year))
+	month = int(float64(d) / 30.601)
+	d -= int(30.601 * float64(month))
+	day = d
+	if month > 13 {
+		month -= 13
+		year -= 4715
+	} else {
+		month -= 1
+		year -= 4716
+	}
+	f *= 24
+	hour = int(f)
+	f -= float64(hour)
+	f *= 60
+	minute = int(f)
+	f -= float64(minute)
+	f *= 60
+	second = int(math.Round(f))
+	return
+}
+
+// julianToGregorian is ToGregorian(zone) of a Julian day under the switches:
+// the instant jd names (the documented value, exact to the second) or, under
+// carbon/24, the library's decoding (Julian before the reform); viewed in
+// the zone, or, under carbon/29, the decoded fields placed in the zone as a
+// wall clock (julian.go:117, time.Date(..., loc) of the UT fields).
+func julianToGregorian(jd float64, loc *time.Location, k known) time.Time {
+	var fields time.Time
+	if k[kJulianPreReformCalendar] {
+		y, m, d, h, mi, s := libJulianDecode(jd)
+		fields = time.Date(y, time.Month(m), d, h, mi, s, 0, time.UTC)
+	} else {
+		fields = time.Unix(int64(math.Round((jd-2440587.5)*86400)), 0).UTC()
+	}
+	if k[kJulianIgnoresZone] {
+		y, m, d := fields.Date()
+		h, mi, s := fields.Clock()
+		return time.Date(y, m, d, h, mi, s, 0, loc)
+	}
+	return fields.In(loc)
+}
+
+// ---------------------------------------------------------------------------
+// The lunar (Chinese) calendar: the library's table read back, its walk,
+// and the Hong Kong Observatory's tables.
+
+// Leap months by the Hong Kong Observatory's tables (0: none).
+var lunarLeapMonths = map[int]int{
+	2001: 4, 2004: 2, 2006: 7, 2009: 5, 2012: 4, 2014: 9, 2017: 6, 2020: 4, 2023: 2, 2025: 6, 2028: 5, 2031: 3, 2033: 11, 2036: 6,
+	2039: 5, 2042: 2, 2044: 7, 2047: 5, 2050: 3, 2052: 8, 2055: 6, 2058: 4, 2061: 3, 2063: 7, 2066: 5, 2069: 4, 2071: 8, 2074: 6,
+	2077: 4, 2080: 3, 2082: 7, 2085: 5, 2088: 4, 2090: 8, 2093: 6, 2096: 4, 2099: 2, 2019: 0, 2021: 0, 2022: 0, 2024: 0, 2026: 0, 2027: 0,
+}
+
+// Chinese New Year by the same tables.
+var chineseNewYear = map[int]string{
+	1900: "1900-01-31", 1950: "1950-02-17", 1984: "1984-02-02", 2000: "2000-02-05", 2010: "2010-02-14", 2019: "2019-02-05", 2020: "2020-01-25",
+	2021: "2021-02-12", 2022: "2022-02-01", 2023: "2023-01-22", 2024: "2024-02-10", 2025: "2025-01-29", 2026: "2026-02-17", 2027: "2027-02-06",
+	2028: "2028-01-26", 2029: "2029-02-13", 2030: "2030-02-03", 2033: "2033-01-31", 2050: "2050-01-23", 2100: "2100-02-09",
+}
+
+const (
+	lunarMinYear = 1900
+	lunarMaxYear = 2100
+	// lunarEpochUnix is lunar.go:150's constant: 1900-01-31 00:00 at +08:00,
+	// the instant ToGregorian counts days from (lunar 1900-01-01).
+	lunarEpochUnix = -2206512000
+)
+
+var lunarEpochDate = time.Date(1900, time.January, 31, 0, 0, 0, 0, time.UTC)
+
+// lunarYearBits is the library's table entry of a lunar year (lunar.go:34-56:
+// the leap month in the low nibble, bits 15 to 4 the long months 1 to 12,
+// bit 16 the length of the leap month), read back through the clean region
+// of the library's round trip: the leap month from LeapMonth, and the length
+// of month m (for any m, 0 to 13, as getDaysInMonth reads the bit) as the
+// days ToGregorian adds for the leap flag on that month (lunar.go:141-147:
+// offset += days of the month), in Asia/Shanghai, where Beijing midnight is
+// the date itself.
+func lunarOffsetPlusDay(y, m, d int, leap bool) int {
+	g := lunar.NewLunar(y, m, d, leap).ToGregorian("Asia/Shanghai")
+	return int((g.Time.Unix() - lunarEpochUnix) / 86400)
+}
+
+var lunarYearBits = func() []int {
+	bits := make([]int, lunarMaxYear-lunarMinYear+1)
+	for y := lunarMinYear; y <= lunarMaxYear; y++ {
+		b := lunar.NewLunar(y, 1, 1, false).LeapMonth()
+		for m := 0; m <= 12; m++ {
+			if lunarOffsetPlusDay(y, m, 1, true)-lunarOffsetPlusDay(y, m, 1, false) == 30 {
+				b |= 0x10000 >> uint(m)
+			}
+		}
+		bits[y-lunarMinYear] = b
+	}
+	return bits
+}()
+
+// The library's table readers, lunar.go:498-529, over the bits read back.
+func libLunarLeapMonth(year int) int { return lunarYearBits[year-lunarMinYear] & 0xf }
+
+func libLunarDaysInMonth(year, month int) int {
+	if (lunarYearBits[year-lunarMinYear] & (0x10000 >> uint(month))) != 0 {
+		return 30
+	}
+	return 29
+}
+
+func libLunarDaysInLeapMonth(year int) int {
+	if libLunarLeapMonth(year) == 0 {
+		return 0
+	}
+	if lunarYearBits[year-lunarMinYear]&0x10000 != 0 {
+		return 30
+	}
+	return 29
+}
+
+// libLunarDaysInYear and libLunarDaysBefore are lunar.go:465-496 (the
+// 348-day base plus the long months plus the leap month, and the running
+// total since 1900).
+var libLunarDaysInYear, libLunarDaysBefore = func() ([]int, []int) {
+	inYear := make([]int, len(lunarYearBits))
+	before := make([]int, len(lunarYearBits))
+	total := 0
+	for i := range inYear {
+		before[i] = total
+		days := 348
+		for b := 0x8000; b > 0x8; b >>= 1 {
+			if lunarYearBits[i]&b != 0 {
+				days++
+			}
+		}
+		inYear[i] = days + libLunarDaysInLeapMonth(lunarMinYear+i)
+		total += inYear[i]
+	}
+	return inYear, before
+}()
+
+// lunarTableDays is the count of days the table covers (1900-01-31 to
+// 2101-01-28); the first day of lunar 2101 runs off it.
+var lunarTableDays = libLunarDaysBefore[len(libLunarDaysBefore)-1] + libLunarDaysInYear[len(libLunarDaysInYear)-1]
+
+// libLunarOffsetInYear is lunar.go:437-451: the days before month m of a
+// year, the leap month's days added once the loop passes it.
+func libLunarOffsetInYear(year, month int) int {
+	flag := false
+	offset := 0
+	for m := 1; m < month; m++ {
+		leapMonth := libLunarLeapMonth(year)
+		if !flag {
+			if leapMonth <= m && leapMonth > 0 {
+				offset += libLunarDaysInLeapMonth(year)
+				flag = true
+			}
+		}
+		offset += libLunarDaysInMonth(year, m)
+	}
+	return offset
+}
+
+// libLunarCountOf is lunar.go:141-150 (ToGregorian's day arithmetic) on the
+// fields as given, whatever they are: the days from 1900-01-31 to the date
+// (offset + day - 1), the leap flag adding the length of the month's bit.
+func libLunarCountOf(year, month, day int, leap bool) int {
+	days := libLunarDaysInMonth(year, month)
+	offset := libLunarOffsetInYear(year, month)
+	offset += libLunarDaysBefore[year-lunarMinYear]
+	if leap {
+		offset += days
+	}
+	return offset + day - 1
+}
+
+// libLunarCount is lunar.go:89, the day count of carbon/20: the elapsed time
+// from 1900-01-31 00:00 in the moment's zone (at that zone's 1900 offset) to
+// the moment truncated to an absolute hour, in days, truncated.
+func libLunarCount(t time.Time) int {
+	return int(t.Truncate(time.Hour).Sub(time.Date(lunarMinYear, 1, 31, 0, 0, 0, 0, t.Location())).Hours() / 24)
+}
+
+// lunarCalendarCount is the documented count: the calendar days from
+// 1900-01-31 to the moment's date.
+func lunarCalendarCount(t time.Time) int {
+	y, m, d := t.Date()
+	return gregJDN(y, int(m), d) - gregJDN(1900, 1, 31)
+}
+
+// libLunarFromCount is lunar.go:87-125 (FromStdTime after the day count):
+// the walk over the years, then the months with the leap month inserted
+// after its number; ok is false where the walk indexes the table outside
+// 1900-2100 (a count before 1900-01-31 or from 2101-01-29: carbon/16's
+// panic).
+func libLunarFromCount(offset int) (year, month, day int, isLeapMonth, ok bool) {
+	daysInYear, daysInMonth, leapMonth := 365, 30, 0
+	for year = lunarMinYear; year <= lunarMaxYear && offset > 0; year++ {
+		daysInYear = libLunarDaysInYear[year-lunarMinYear]
+		offset -= daysInYear
+	}
+	if offset < 0 {
+		offset += daysInYear
+		year--
+	}
+	if year < lunarMinYear || year > lunarMaxYear {
+		return 0, 0, 0, false, false
+	}
+	leapMonth = libLunarLeapMonth(year)
+	for month = 1; month <= 12 && offset > 0; month++ {
+		if leapMonth > 0 && month == (leapMonth+1) && !isLeapMonth {
+			month--
+			isLeapMonth = true
+			daysInMonth = libLunarDaysInLeapMonth(year)
+		} else {
+			daysInMonth = libLunarDaysInMonth(year, month)
+		}
+		offset -= daysInMonth
+		if isLeapMonth && month == (leapMonth+1) {
+			isLeapMonth = false
+		}
+	}
+	if offset == 0 && leapMonth > 0 && month == leapMonth+1 {
+		if isLeapMonth {
+			isLeapMonth = false
+		} else {
+			isLeapMonth = true
+			month--
+		}
+	}
+	if offset < 0 {
+		offset += daysInMonth
+		month--
+	}
+	day = offset + 1
+	return year, month, day, isLeapMonth, true
+}
+
+// lunarDocLabel is the documented label of the library's (month, leap) of a
+// lunar year: the same, except in 2033, where the table's leap month is the
+// seventh and the Observatory's the eleventh (carbon/21) with the month
+// lengths unchanged, so the sixth to twelfth positions of the year carry
+// the labels 8, 9, 10, 11, leap 11, 12 instead of leap 7, 8, 9, 10, 11, 12.
+// lunarLibLabel is the inverse.
+func lunarDocLabel(year, month int, leap bool) (int, bool) {
+	if year != 2033 {
+		return month, leap
+	}
+	switch {
+	case month == 7 && leap:
+		return 8, false
+	case month >= 8 && month <= 10 && !leap:
+		return month + 1, false
+	case month == 11 && !leap:
+		return 11, true
+	}
+	return month, leap
+}
+
+func lunarLibLabel(year, month int, leap bool) (int, bool) {
+	if year != 2033 {
+		return month, leap
+	}
+	switch {
+	case month == 8 && !leap:
+		return 7, true
+	case month >= 9 && month <= 11 && !leap:
+		return month - 1, false
+	case month == 11 && leap:
+		return 11, false
+	}
+	return month, leap
+}
+
+// lunarDocLeapMonth is the Observatory's leap month where the table has the
+// year, else the library's (which agrees with the table in every other year
+// it has: checked below).
+func lunarDocLeapMonth(year int) int {
+	if m, ok := lunarLeapMonths[year]; ok {
+		return m
+	}
+	return libLunarLeapMonth(year)
+}
+
+// The library's rendering of a lunar date (lunar.go:12-14, 211-273): the
+// year's digits as numerals, the month's name with the leap prefix, and the
+// day's form; the data of ToDateString's documented value.
+var (
+	lunarNumerals   = []string{"\u96f6", "\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u4e03", "\u516b", "\u4e5d"}
+	lunarMonthNames = []string{"\u6b63", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u4e03", "\u516b", "\u4e5d", "\u5341", "\u5341\u4e00", "\u814a"}
+)
+
+func lunarDateString(year, month, day int, leap bool) string {
+	ys := ""
+	for _, r := range strconv.Itoa(year) {
+		ys += lunarNumerals[r-'0']
+	}
+	ms := lunarMonthNames[month-1] + "\u6708"
+	if leap {
+		ms = "\u95f0" + ms
+	}
+	num := lunarNumerals[day%10]
+	var ds string
+	switch {
+	case day == 30:
+		ds = "\u4e09\u5341"
+	case day > 20:
+		ds = "\u5eff" + num
+	case day == 20:
+		ds = "\u4e8c\u5341"
+	case day > 10:
+		ds = "\u5341" + num
+	case day == 10:
+		ds = "\u521d\u5341"
+	case day < 10:
+		ds = "\u521d" + num
+	}
+	return ys + "\u5e74" + ms + ds
+}
+
+// lunarRefsChecked: the table read back is consistent (the running totals
+// match the library's own day arithmetic), the walk reproduces the library
+// at noon in Shanghai on every day of the table, the Observatory's leap
+// months and New Year dates agree with the library except 2033's leap month,
+// and the relabelled 2033 reads as the note of carbon/21 says.
+var lunarRefsChecked = func() bool {
+	sh, _ := time.LoadLocation("Asia/Shanghai")
+	for y := lunarMinYear; y <= lunarMaxYear; y++ {
+		if libLunarDaysBefore[y-lunarMinYear] != lunarOffsetPlusDay(y, 1, 1, false)-1 {
+			panic(fmt.Sprintf("lunar table: the days before %d differ", y))
+		}
+		if want, ok := lunarLeapMonths[y]; ok && y != 2033 && want != libLunarLeapMonth(y) {
+			panic(fmt.Sprintf("lunar table: the leap month of %d is %d, the Observatory has %d", y, libLunarLeapMonth(y), want))
+		}
+		if want, ok := chineseNewYear[y]; ok && lunarEpochDate.AddDate(0, 0, libLunarDaysBefore[y-lunarMinYear]).Format("2006-01-02") != want {
+			panic(fmt.Sprintf("lunar table: the New Year of %d differs from the Observatory's %s", y, want))
+		}
+	}
+	for count := 0; count < lunarTableDays; count++ {
+		y, m, d, leap, ok := libLunarFromCount(count)
+		l := lunar.FromStdTime(lunarEpochDate.AddDate(0, 0, count).In(sh).Add(12 * time.Hour))
+		if !ok || l.Year() != y || l.Month() != m || l.Day() != d || l.IsLeapMonth() != leap {
+			panic(fmt.Sprintf("lunar walk: day %d reads %d-%02d-%02d leap %v, the library %s leap %v", count, y, m, d, leap, l.String(), l.IsLeapMonth()))
+		}
+	}
+	if _, _, _, _, ok := libLunarFromCount(-1); ok {
+		panic("lunar walk: a day before the table reads")
+	}
+	if _, _, _, _, ok := libLunarFromCount(lunarTableDays); ok {
+		panic("lunar walk: the day after the table reads")
+	}
+	for _, c := range []struct {
+		date       string
+		month, day int
+		leap       bool
+	}{{"2033-09-01", 8, 8, false}, {"2033-12-25", 11, 4, true}, {"2033-08-25", 8, 1, false}, {"2034-01-19", 11, 29, true}, {"2034-01-20", 12, 1, false}} {
+		t, _ := time.Parse("2006-01-02", c.date)
+		y, m, d, leap, _ := libLunarFromCount(lunarCalendarCount(t))
+		m, leap = lunarDocLabel(y, m, leap)
+		if y != 2033 || m != c.month || d != c.day || leap != c.leap {
+			panic(fmt.Sprintf("lunar 2033: %s reads %d-%02d-%02d leap %v", c.date, y, m, d, leap))
+		}
+	}
+	return true
+}()
