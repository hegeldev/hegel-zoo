+		}
+		if !sameInstant(got2, want2) {
+			fail(ht, "Sub %d %ss from %s = %s, want %s", k, unit, showTime(tm), showCarbon(got2), showTime(want2))
+		}
+		if !sameInstant(c, tm) {
+			fail(ht, "the receiver changed: %s", showCarbon(c))
+		}
+		// the singular forms
+		one := map[string]struct {
+			got  *carbon.Carbon
+			want time.Time
+		}{
+			"AddHour":        {c.AddHour(), tm.Add(time.Hour)},
+			"SubHour":        {c.SubHour(), tm.Add(-time.Hour)},
+			"AddMinute":      {c.AddMinute(), tm.Add(time.Minute)},
+			"SubMinute":      {c.SubMinute(), tm.Add(-time.Minute)},
+			"AddSecond":      {c.AddSecond(), tm.Add(time.Second)},
+			"SubSecond":      {c.SubSecond(), tm.Add(-time.Second)},
+			"AddMillisecond": {c.AddMillisecond(), tm.Add(time.Millisecond)},
+			"SubMillisecond": {c.SubMillisecond(), tm.Add(-time.Millisecond)},
+			"AddMicrosecond": {c.AddMicrosecond(), tm.Add(time.Microsecond)},
+			"SubMicrosecond": {c.SubMicrosecond(), tm.Add(-time.Microsecond)},
+			"AddNanosecond":  {c.AddNanosecond(), tm.Add(time.Nanosecond)},
+			"SubNanosecond":  {c.SubNanosecond(), tm.Add(-time.Nanosecond)},
+		}
+		for name, r := range one {
+			if !sameInstant(r.got, r.want) {
+				fail(ht, "%s of %s = %s, want %s", name, showTime(tm), showCarbon(r.got), showTime(r.want))
+			}
+		}
+	})
+}
