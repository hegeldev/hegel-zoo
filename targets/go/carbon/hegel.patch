+// calendarExpected: the calendar travellers are AddDate, the NoOverflow ones
+// clamp the day to the target month; the receiver is untouched.
+func calendarExpected(c calendarCase, _ known) checks {
+	tm, k := c.m.t, c.k.v
+	out := checks{}
