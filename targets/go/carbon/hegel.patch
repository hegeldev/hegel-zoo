+// carbon/10: the timestamp pseudo-layouts print but never parse.
+func TestHegelPinUnixLayoutReadsBack(t *testing.T) {
+	c := carbon.CreateFromDateTime(2020, 8, 5, 13, 14, 15, "UTC")
+	s := c.Layout(carbon.TimestampLayout)
+	if s != "1596633255" {
+		t.Fatalf("Layout(TimestampLayout) = %q", s)
+	}
+	if back := carbon.ParseByLayout(s, carbon.TimestampLayout, "UTC"); back == nil || back.HasError() || !back.Eq(c) {
+		t.Errorf("ParseByLayout(%q, TimestampLayout) = %s", s, showCarbon(back))
+	}
+	if back := carbon.ParseByFormat(c.Format("S"), "S", "UTC"); back == nil || back.HasError() || !back.Eq(c) {
+		t.Errorf("ParseByFormat(%q, \"S\") = %s", c.Format("S"), showCarbon(back))
+	}
+	c2 := carbon.NewDateTime(c.Copy().SetLayout(carbon.TimestampLayout))
+	if got := c2.String(); got != "2020-08-05 13:14:15" {
+		t.Errorf("DateTime wrapper String() = %q", got)
+	}
+}
