+	out.set("DiffInSeconds", ca.DiffInSeconds(cb))
+	out.set("DiffAbsInSeconds", ca.DiffAbsInSeconds(cb))
+	out.set("DiffInMinutes", ca.DiffInMinutes(cb))
+	out.set("DiffAbsInMinutes", ca.DiffAbsInMinutes(cb))
+	out.set("DiffInHours", ca.DiffInHours(cb))
+	out.set("DiffAbsInHours", ca.DiffAbsInHours(cb))
+	out.set("DiffInDuration", ca.DiffInDuration(cb))
+	out.set("DiffAbsInDuration", ca.DiffAbsInDuration(cb))
+	out.set("DiffInDays", ca.DiffInDays(cb))
+	out.set("DiffInWeeks", ca.DiffInWeeks(cb))
+	out.set("DiffAbsInDays", ca.DiffAbsInDays(cb))
