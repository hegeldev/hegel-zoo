new file mode 100644
index 0000000..7991cc2
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,137 @@
+package carbon_test
+
+// Hegel properties for github.com/dromara/carbon/v2: every Carbon method
+// against Go's standard time package and against models written from the
+// methods' own doc comments (calendar arithmetic, boundaries, differences,
+// comparisons, the PHP-style Format letters, the default Parse layouts, the
+// JSON/SQL wrapper types). No external tool is needed.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	if lo > hi {
+		panic(fmt.Sprintf("n(%d, %d): empty range", lo, hi))
+	}
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
