+// carbon/21: the 2033 leap month.
+func TestHegelPinLunar2033LeapMonthIsEleventh(t *testing.T) {
+	if got := lunar.NewLunar(2033, 1, 1, false).LeapMonth(); got != 11 {
+		t.Errorf("leap month of 2033 = %d, the Hong Kong Observatory has 11", got)
+	}
+	if got := lunar.NewLunar(2033, 8, 15, false).ToGregorian("Asia/Shanghai").Time.Format("2006-01-02"); got != "2033-09-08" {
+		t.Errorf("Mid-Autumn 2033 = %s, want 2033-09-08", got)
