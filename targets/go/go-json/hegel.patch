+// ---------------------------------------------------------------------------
+// go-json/22: numbers out of float64 range.
+
+// hugeLits: a well-formed number with an exponent of 309 to 999 (outside float64 range, the
+// shape of go-json/22 and /26) or, under HEGEL_NO_KNOWN=1, of 0 to 307.
+var hugeLits = hegel.Composite(func(tc hegel.TestCase) string {
+	return numLit{
+		neg:   hegel.Draw(tc, chance(30)),
+		whole: hegel.Draw(tc, hegel.Map(hegel.Integers(1, 9), strconv.Itoa)),
+		frac:  hegel.Draw(tc, maybe(30, digitText(1, 3))),
+		exp:   hegel.Draw(tc, hegel.Map(pairs(expMarks, shaped(hegel.Integers(309, 999), hegel.Integers(0, 307))), func(p pair[string, int]) string { return p.a + strconv.Itoa(p.b) })),
+	}.String()
+})
