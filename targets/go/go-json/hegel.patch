+package json_test
+
+import (
+	"bytes"
+	"math"
+	"strings"
+	"testing"
+
+	json "github.com/goccy/go-json"
+)
+
+// ---------------------------------------------------------------------------
+// Pins.  Each records one difference from encoding/json found while writing
+// the properties above; they are listed in targets/go/go-json/bugs.toml and
+// expected to fail until fixed upstream.  The pins recover from panics so that
+// one crash cannot hide the others.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// hgFirstWord is a TextUnmarshaler whose first word is an int, so a stray
+// zeroing write is visible without a crash.
+type hgFirstWord struct{ A, B int }
+
+func (x hgFirstWord) MarshalText() ([]byte, error)  { return []byte("fw"), nil }
+func (x *hgFirstWord) UnmarshalText(b []byte) error { x.A = 42; return nil }
+
+// go-json/1: `null` into a TextUnmarshaler value is a no-op in encoding/json,
+// but go-json zeroes the first machine word of the value (for a struct whose
+// first field is a string that leaves a dangling string header, and reading it
+// crashes).
+func TestHegelPinNullIntoTextUnmarshalerKeepsTheValue(t *testing.T) {
+	defer guard(t)
+	x := hgFirstWord{7, 8}
+	if err := json.Unmarshal([]byte(`null`), &x); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if x != (hgFirstWord{7, 8}) {
+		t.Fatalf("null into a TextUnmarshaler value changed it to %+v (encoding/json leaves {7 8})", x)
+	}
+	s := hgText{"keep"}
+	if err := json.Unmarshal([]byte(`null`), &s); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if s.V != "keep" || len(s.V) != 4 {
+		t.Fatalf("null into a TextUnmarshaler value changed it to %q", s.V)
+	}
+}
+
+// go-json/2: integers beyond int64/uint64 wrap around silently instead of
+// producing an UnmarshalTypeError.
+func TestHegelPinInt64OverflowIsAnError(t *testing.T) {
+	defer guard(t)
+	var i int64
+	if err := json.Unmarshal([]byte(`9223372036854775808`), &i); err == nil {
+		t.Fatalf("9223372036854775808 into int64 gave %d and no error (encoding/json reports an overflow)", i)
+	}
+	var u uint64
+	if err := json.Unmarshal([]byte(`18446744073709551616`), &u); err == nil {
+		t.Fatalf("18446744073709551616 into uint64 gave %d and no error", u)
+	}
+	var s struct {
+		N int64 `json:"n,string"`
+	}
+	if err := json.Unmarshal([]byte(`{"n":"9223372036854775808"}`), &s); err == nil {
+		t.Fatalf("quoted 9223372036854775808 into int64 gave %d and no error", s.N)
+	}
+	var f float32
+	if err := json.Unmarshal([]byte(`3.5e38`), &f); err == nil {
+		t.Fatalf("3.5e38 into float32 gave %v and no error", f)
+	}
+}
+
+// go-json/3: float32 NaN and infinities are written as the bare tokens NaN,
+// +Inf and -Inf (invalid JSON) with a nil error; float64 ones are rejected
+// like encoding/json does.
+func TestHegelPinFloat32NaNAndInfAreRejected(t *testing.T) {
+	defer guard(t)
+	for _, f := range []float32{float32(math.NaN()), float32(math.Inf(1)), float32(math.Inf(-1))} {
+		b, err := json.Marshal(struct{ F float32 }{f})
+		if err == nil {
+			t.Fatalf("Marshal of float32 %v produced %q and no error (encoding/json: unsupported value)", f, b)
+		}
+	}
+}
+
+// go-json/4: a NUL byte ends the input -- everything after it is ignored, so
+// `1\x00garbage` is accepted by Unmarshal, Valid, Compact and Indent.
+func TestHegelPinNulByteDoesNotTerminateTheInput(t *testing.T) {
+	defer guard(t)
+	in := []byte("1\x00garbage")
+	var v any
+	if err := json.Unmarshal(in, &v); err == nil {
+		t.Fatalf("Unmarshal accepted %q as %v (encoding/json: invalid character after top-level value)", in, v)
+	}
+	if json.Valid(in) {
+		t.Fatalf("Valid accepted %q", in)
+	}
+	in = []byte("[1,2]\x00{")
+	if json.Valid(in) {
+		t.Fatalf("Valid accepted %q", in)
+	}
+}
+
+type hgSeventeen struct {
+	F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16 int
+	Lower                                                                 int `json:"lower"`
+}
+
+type hgSixteen struct {
+	F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15 int
+	Lower                                                            int `json:"lower"`
+}
+
+// go-json/5: keys are matched case-insensitively (like encoding/json) only for
+// structs with at most sixteen fields; with seventeen or more, "LOWER" no
+// longer matches `json:"lower"`.
+func TestHegelPinFieldMatchingIsCaseInsensitiveForLargeStructs(t *testing.T) {
+	defer guard(t)
+	var small hgSixteen
+	if err := json.Unmarshal([]byte(`{"LOWER":1}`), &small); err != nil || small.Lower != 1 {
+		t.Fatalf("sixteen fields: Lower=%d err=%v", small.Lower, err)
+	}
+	var big hgSeventeen
+	if err := json.Unmarshal([]byte(`{"LOWER":1}`), &big); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if big.Lower != 1 {
+		t.Fatalf("seventeen fields: \"LOWER\" did not match the field tagged \"lower\" (Lower=%d; encoding/json sets 1)", big.Lower)
+	}
+}
+
+// go-json/6: integers in string form -- `,string` fields and integer map keys
+// -- are parsed by prefix and with leading zeros misread: "1e2" gives 1, "5x"
+// gives 5, "05" gives 0, " 5" is accepted, while "+5" (valid for strconv) is
+// rejected.
+func TestHegelPinQuotedIntegersAreParsedStrictly(t *testing.T) {
+	defer guard(t)
+	type s struct {
+		N int `json:"n,string"`
+	}
+	for _, c := range []struct {
+		text string
+		want int
+		ok   bool
+	}{{`{"n":"05"}`, 5, true}, {`{"n":"+5"}`, 5, true}, {`{"n":"1e2"}`, 0, false}, {`{"n":"5x"}`, 0, false}, {`{"n":" 5"}`, 0, false}, {`{"n":"5.0"}`, 0, false}} {
+		var v s
+		err := json.Unmarshal([]byte(c.text), &v)
+		if (err == nil) != c.ok || (c.ok && v.N != c.want) {
+			t.Fatalf("%s: got N=%d err=%v; encoding/json gives N=%d ok=%v", c.text, v.N, err, c.want, c.ok)
+		}
+	}
+	m := map[int]int{}
+	if err := json.Unmarshal([]byte(`{"01":1}`), &m); err != nil || m[1] != 1 {
+		t.Fatalf(`{"01":1} into map[int]int gave %v err=%v (encoding/json: map[1:1])`, m, err)
+	}
+	m = map[int]int{}
+	if err := json.Unmarshal([]byte(`{" 1":1}`), &m); err == nil {
+		t.Fatalf(`{" 1":1} into map[int]int gave %v and no error (encoding/json rejects the key)`, m)
+	}
+}
+
+// go-json/7: the number grammar is lenient: leading zeros ("01", "00",
+// "-01"), a trailing dot ("1.", "0.", "1.e5") and a lone "-" (into an
+// integer) are accepted.
+func TestHegelPinNumberGrammarIsStrict(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"01", "00", "-01", "1.", "0.", "1.e5", "[01]", `{"a":1.}`} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %q as %v (encoding/json rejects it)", text, v)
+		}
+		if json.Valid([]byte(text)) {
+			t.Fatalf("Valid accepted %q", text)
+		}
+	}
+	var i int
+	if err := json.Unmarshal([]byte("-"), &i); err == nil {
+		t.Fatalf("Unmarshal accepted \"-\" into int as %d", i)
+	}
+}
+
+// go-json/8: an unquoted `null` is accepted as an object key and becomes the
+// empty string: {null:1} decodes to map[:1].
+func TestHegelPinBareNullIsNotAnObjectKey(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{`{null:1}`, `{"a":1,null:2}`} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %s as %v (encoding/json: invalid character 'n' looking for beginning of object key string)", text, v)
+		}
+		m := map[string]any{}
+		if err := json.Unmarshal([]byte(text), &m); err == nil {
+			t.Fatalf("Unmarshal into a map accepted %s as %v", text, m)
+		}
+	}
+}
+
+// go-json/9: a nil pointer to a TextMarshaler at top level marshals to the
+// empty output (not valid JSON) with a nil error; encoding/json writes null.
+func TestHegelPinNilTextMarshalerPointerMarshalsAsNull(t *testing.T) {
+	defer guard(t)
+	b, err := json.Marshal((*hgText)(nil))
+	if err != nil || string(b) != "null" {
+		t.Fatalf("Marshal((*hgText)(nil)) = %q, %v; encoding/json gives null", b, err)
+	}
+}
+
+// go-json/10: the stream Decoder is more lenient than Unmarshal: it accepts a
+// truncated literal at the end of the input ("tru" decodes as true, "nul" as
+// null, "fals" as false), skips a comma or colon in front of a value (",1"
+// decodes as 1) and accepts \u escapes with non-hex digits ("\uZZZZ").
+// Valid, which is built on the stream decoder, inherits all of it; Unmarshal
+// rejects every one of these texts.
+func TestHegelPinDecoderRejectsTruncatedLiteralsAndLeadingPunctuation(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"tru", "nul", "fals", ",1", ":1", " ,[1]", `,"a"`, `"\uZZZZ"`, `"\u[0008"`} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %q", text)
+		}
+		var sv any
+		if err := json.NewDecoder(strings.NewReader(text)).Decode(&sv); err == nil {
+			t.Fatalf("Decoder.Decode accepted %q as %v (encoding/json rejects it, as Unmarshal does)", text, sv)
+		}
+		if json.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) is true although Unmarshal rejects it", text)
+		}
+	}
+}
+
+// go-json/24: a stray ] or } after a complete top-level value is not an
+// error for Valid ("null]", "[1]]", "1]garbage" are all valid) nor for
+// Decoder.Token, which returns the bracket as a Delim.
+func TestHegelPinStrayClosingBracketIsAnError(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"null]", "[1]]", "1]garbage", `{"a":1}}`} {
+		if json.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) is true (encoding/json: false)", text)
+		}
+	}
+	d := json.NewDecoder(strings.NewReader("null}"))
+	if _, err := d.Token(); err != nil {
+		t.Fatalf("first token: %v", err)
+	}
+	if tok, err := d.Token(); err == nil {
+		t.Fatalf("Token returned %v for a stray } (encoding/json: invalid character '}' looking for beginning of value)", tok)
+	}
+}
+
+// go-json/11: raw control characters (U+0000..U+001F) inside a string are
+// accepted by Unmarshal, Valid, Compact and Indent; RFC 8259 and encoding/json
+// require them to be escaped.
+func TestHegelPinRawControlCharactersInStringsAreRejected(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"\"\x01\"", "\"a\nb\"", "[\"\x1f\"]", "{\"k\x02\":1}"} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %q as %q", text, v)
+		}
+		if json.Valid([]byte(text)) {
+			t.Fatalf("Valid accepted %q", text)
+		}
+		var b bytes.Buffer
+		if err := json.Compact(&b, []byte(text)); err == nil {
+			t.Fatalf("Compact accepted %q", text)
+		}
+	}
+}
+
+// go-json/12: Compact and Indent do not validate escape sequences inside
+// strings: `"\x41"`, `"\a"`, `"\uZZZZ"` and a truncated `"\u004"` pass
+// through.
+func TestHegelPinCompactValidatesEscapes(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{`"\x41"`, `"\a"`, `"\uZZZZ"`, `"\u004"`, `["\'"]`} {
+		var b bytes.Buffer
+		if err := json.Compact(&b, []byte(text)); err == nil {
+			t.Fatalf("Compact accepted %s as %s (encoding/json: invalid escape sequence)", text, b.String())
+		}
+		b.Reset()
+		if err := json.Indent(&b, []byte(text), "", " "); err == nil {
+			t.Fatalf("Indent accepted %s", text)
+		}
+	}
+}
+
+// go-json/13: floats printed in exponent form get a two-digit exponent
+// ("1e-07") where encoding/json prints "1e-7".
+func TestHegelPinFloatExponentsAreNotZeroPadded(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		v    any
+		want string
+	}{{1e-7, "1e-7"}, {-1.5e-8, "-1.5e-8"}, {float32(1e-9), "1e-9"}, {[]float64{5e-7}, "[5e-7]"}} {
+		b, err := json.Marshal(c.v)
+		if err != nil || string(b) != c.want {
+			t.Fatalf("Marshal(%v) = %s, %v; encoding/json gives %s", c.v, b, err, c.want)
+		}
+	}
+}
+
+// go-json/14: map keys are sorted by their quoted, escaped encoding rather
+// than by the key, so ">" (escaped as \u003e) sorts after "?", "\n" after
+// " ", and -- because the closing quote takes part in the comparison -- "b "
+// sorts before "b" and " " before the empty key.
+func TestHegelPinMapKeysSortByKeyNotByEscapedKey(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		m    map[string]int
+		want string
+	}{
+		{map[string]int{">": 1, "?": 2}, `{">":1,"?":2}`},
+		{map[string]int{"\n": 1, " ": 2}, `{"\n":1," ":2}`},
+		{map[string]int{"<": 1, "=": 2}, `{"<":1,"=":2}`},
+		{map[string]int{"": 1, " ": 2}, `{"":1," ":2}`},
+		{map[string]int{"b": 1, "b ": 2}, `{"b":1,"b ":2}`},
+		{map[string]int{"b": 1, "b!": 2}, `{"b":1,"b!":2}`},
+	} {
+		b, err := json.Marshal(c.m)
+		if err != nil || string(b) != c.want {
+			t.Fatalf("Marshal(%v) = %s, %v; encoding/json gives %s", c.m, b, err, c.want)
+		}
+	}
+}
+
+// go-json/15: omitempty does not omit a zero-length array field.
+func TestHegelPinOmitEmptySkipsZeroLengthArrays(t *testing.T) {
+	defer guard(t)
+	b, err := json.Marshal(struct {
+		A [0]int `json:"a,omitempty"`
+	}{})
+	if err != nil || string(b) != "{}" {
+		t.Fatalf("Marshal = %s, %v; encoding/json gives {}", b, err)
+	}
+}
+
+type hgPtrMarsh struct{ V int }
+
+func (m *hgPtrMarsh) MarshalJSON() ([]byte, error) { return []byte(`"ptr"`), nil }
+
+// go-json/16: elements of a non-addressable array get their pointer-receiver
+// MarshalJSON called; encoding/json (which cannot take their address) encodes
+// the struct fields.  Slices and addressable arrays agree.
+func TestHegelPinArrayElementsAreNotAddressable(t *testing.T) {
+	defer guard(t)
+	b, err := json.Marshal([2]hgPtrMarsh{{1}, {2}})
+	if err != nil || string(b) != `[{"V":1},{"V":2}]` {
+		t.Fatalf("Marshal([2]hgPtrMarsh) = %s, %v; encoding/json gives [{\"V\":1},{\"V\":2}]", b, err)
+	}
+	b, err = json.Marshal(struct{ A [1]hgPtrMarsh }{})
+	if err != nil || string(b) != `{"A":[{"V":0}]}` {
+		t.Fatalf("Marshal(struct{A [1]hgPtrMarsh}) = %s, %v; encoding/json gives {\"A\":[{\"V\":0}]}", b, err)
+	}
+}
+
+// go-json/17: HTMLEscape decodes and re-encodes its input instead of
+// escaping the bytes in place: whitespace is dropped, `\/` and `\uXXXX`
+// escapes are rewritten, object keys are re-sorted and invalid input produces
+// no output at all.
+func TestHegelPinHTMLEscapeOnlyEscapes(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct{ in, want string }{
+		{` [1, 2] `, ` [1, 2] `},
+		{`"\/"`, `"\/"`},
+		{`{"b":1,"a":2}`, `{"b":1,"a":2}`},
+		{`"é<"`, `"é\u003c"`},
+		{`[1,`, `[1,`},
+	} {
+		var b bytes.Buffer
+		json.HTMLEscape(&b, []byte(c.in))
+		if b.String() != c.want {
+			t.Fatalf("HTMLEscape(%q) = %q; encoding/json gives %q", c.in, b.String(), c.want)
+		}
+	}
+}
+
+// go-json/18: Indent drops trailing whitespace, which encoding/json documents
+// as preserved.
+func TestHegelPinIndentKeepsTrailingWhitespace(t *testing.T) {
+	defer guard(t)
+	var b bytes.Buffer
+	if err := json.Indent(&b, []byte("{\"a\":1}  \n"), "", " "); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if want := "{\n \"a\": 1\n}  \n"; b.String() != want {
+		t.Fatalf("Indent = %q; encoding/json gives %q", b.String(), want)
+	}
+}
+
+// go-json/19: after an UnmarshalTypeError encoding/json keeps decoding the
+// rest of the document and still reports the error; go-json stops at the
+// first mismatch and leaves the remaining fields untouched.
+func TestHegelPinUnmarshalKeepsGoingAfterATypeError(t *testing.T) {
+	defer guard(t)
+	var s []int
+	err := json.Unmarshal([]byte(`[1,"x",3]`), &s)
+	if err == nil {
+		t.Fatalf("no error for [1,\"x\",3] into []int")
+	}
+	if len(s) != 3 || s[0] != 1 || s[2] != 3 {
+		t.Fatalf("[1,\"x\",3] into []int left %v (encoding/json fills [1 0 3] and reports the error)", s)
+	}
+	var in hgInner
+	err = json.Unmarshal([]byte(`{"a":"x","b":"y"}`), &in)
+	if err == nil || in.B != "y" {
+		t.Fatalf("{\"a\":\"x\",\"b\":\"y\"} into hgInner: err=%v B=%q (encoding/json sets B and reports the error)", err, in.B)
+	}
+}
+
+// go-json/20: `null` into a json.Number is an error ("parsing \"\": invalid
+// syntax") instead of the no-op encoding/json performs.
+func TestHegelPinNullIntoNumberIsANoOp(t *testing.T) {
+	defer guard(t)
+	num := json.Number("7")
+	if err := json.Unmarshal([]byte(`null`), &num); err != nil || num != "7" {
+		t.Fatalf("null into Number: err=%v value=%q; encoding/json leaves 7 with no error", err, num)
+	}
+}
+
+// go-json/21: `null` into a []byte leaves the old value in place instead of
+// setting the slice to nil.
+func TestHegelPinNullIntoByteSliceClearsIt(t *testing.T) {
+	defer guard(t)
+	b := []byte{1, 2}
+	if err := json.Unmarshal([]byte(`null`), &b); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if b != nil {
+		t.Fatalf("null into []byte left %v (encoding/json sets nil)", b)
+	}
+	s := struct{ B []byte }{[]byte{1}}
+	if err := json.Unmarshal([]byte(`{"B":null}`), &s); err != nil || s.B != nil {
+		t.Fatalf("{\"B\":null} left B=%v err=%v", s.B, err)
+	}
+}
+
+// go-json/23: U+0008 and U+000C are written as `\u0008` and `\u000c`;
+// encoding/json (since Go 1.22) writes the short escapes `\b` and `\f`.
+func TestHegelPinBackspaceAndFormFeedUseShortEscapes(t *testing.T) {
+	defer guard(t)
+	b, err := json.Marshal("a\bb\fc")
+	if err != nil || string(b) != `"a\bb\fc"` {
+		t.Fatalf("Marshal(\"a\\bb\\fc\") = %s, %v; encoding/json gives \"a\\bb\\fc\"", b, err)
+	}
+}
+
+type hgPadded struct {
+	S  string `json:"s"`
+	I8 int8   `json:"i8"`
+}
+
+// go-json/25: the stream Decoder fails on valid input when a \uXXXX escape in
+// a struct field key straddles its internal read-buffer refill (at 512 and
+// 1024 bytes): "invalid character u as escaped char" or "expected colon after
+// object key".  Unmarshal decodes the same bytes fine.
+func TestHegelPinDecoderHandlesEscapedKeysAcrossBufferRefills(t *testing.T) {
+	defer guard(t)
+	for _, pad := range []int{495, 497, 501, 503, 1006, 1007, 1008, 1014, 1016} {
+		text := `{"s":"` + strings.Repeat("a", pad) + `","\u0069\u0038":2}`
+		var u hgPadded
+		if err := json.Unmarshal([]byte(text), &u); err != nil || u.I8 != 2 {
+			t.Fatalf("pad %d: Unmarshal: %+v %v", pad, u, err)
+		}
+		var v hgPadded
+		if err := json.NewDecoder(strings.NewReader(text)).Decode(&v); err != nil {
+			t.Fatalf("pad %d: Decoder.Decode of a %d-byte valid document: %v (Unmarshal accepts it)", pad, len(text), err)
+		}
+		if v.I8 != 2 {
+			t.Fatalf("pad %d: Decoder.Decode lost the escaped key: %+v", pad, v)
+		}
+	}
+}
+
+// go-json/22: Valid, Compact and Indent reject syntactically valid numbers
+// that do not fit a float64 (1e400), because they are implemented by decoding
+// into interface{}.
+func TestHegelPinValidAcceptsNumbersOutOfFloat64Range(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"1e400", "[1e999]", `{"a":-1e400}`} {
+		if !json.Valid([]byte(text)) {
+			t.Fatalf("Valid(%s) is false (encoding/json: true, the text is well-formed)", text)
+		}
+		var b bytes.Buffer
+		if err := json.Compact(&b, []byte(text)); err != nil {
+			t.Fatalf("Compact(%s): %v", text, err)
+		}
+	}
+}
