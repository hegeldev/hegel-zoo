+// ---------------------------------------------------------------------------
+// go-json/24: stray closers.
+
+// strayCases: a valid value followed by whitespace, a stray ] or } (the shape of go-json/24)
+// or, under HEGEL_NO_KNOWN=1, a letter, and a tail.
+var strayCases = hegel.Composite(func(tc hegel.TestCase) tailCase {
+	return tailCase{
+		text: hegel.Draw(tc, plainTexts),
+		gap:  hegel.Draw(tc, maybe(50, wsRuns)) + hegel.Draw(tc, shaped(hegel.SampledFrom([]string{"]", "}"}), hegel.Just("x"))),
+		tail: hegel.Draw(tc, maybe(40, hegel.SampledFrom([]string{"garbage", "1", "]", " "}))),
+	}
+})
+
+// A stray closing bracket after a complete value is an error for Valid and for
+// Decoder.Token, as in encoding/json (go-json's Valid accepts it and Token returns it as a
+// Delim, go-json/24).
+func TestHegelStrayClosingBracketsAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, strayCases).String()
+		shapes := known("go-json/24")
+		if gv, wv := json.Valid([]byte(text)), std.Valid([]byte(text)); gv != wv {
+			mismatch(ht, shapes, "Valid(%q): go-json %v, encoding/json %v", text, gv, wv)
+		}
+		gd, wd := json.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+		for i := 0; i < 400; i++ {
+			gt, ge := gd.Token()
+			wt, we := wd.Token()
+			if (ge == nil) != (we == nil) || (we == nil && !reflect.DeepEqual(gt, wt)) {
+				mismatch(ht, shapes, "Token #%d of %q: go-json %#v (%v), encoding/json %#v (%v)", i, text, gt, ge, wt, we)
+			}
+			if we != nil {
+				break
+			}
+		}
+	})
+}
