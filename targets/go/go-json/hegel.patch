+// ---------------------------------------------------------------------------
+// go-json/17: HTMLEscape.
+
+// htmlCase: a JSON text for HTMLEscape: encoding/json's compact encoding of a small tree of
+// safe strings and small integers (under HEGEL_NO_KNOWN=1) and, by default, that text with
+// whitespace before or after it, or truncated (the shape of go-json/17: go-json decodes and
+// re-encodes the text instead of escaping in place).
+type htmlCase struct {
+	tree any
+	ws   string
+	lead bool
+	cut  int
+	kind int
+}
+
+func (c htmlCase) text() string {
+	s := stdJSON(c.tree)
+	if noKnown {
+		return s
+	}
+	switch c.kind % 3 {
+	case 0:
+		if c.lead {
+			return c.ws + s
+		}
+		return s + c.ws
+	case 1:
+		return s[:c.cut%len(s)]
+	default:
+		return strings.ReplaceAll(s, ",", ", ")
+	}
+}
+
+func (c htmlCase) GoString() string { return strconv.Quote(c.text()) }
+
+var (
+	safeStrs  = hegel.Text().Alphabet("abcxyzABCXYZ0189 !#$%'()*+,-./:;=?@[]^_`{|}~").MaxSize(6)
+	safeTrees = weighted(
+		choice[any]{1, asAny(hegel.Map(hegel.Integers(-1000000, 1000000), func(x int) float64 { return float64(x) }))},
+		choice[any]{1, asAny(safeStrs)},
+		choice[any]{1, asAny(hegel.Map(many(asAny(safeStrs), 0, 3), nonNil[any]))},
+		// (keys of the plain alphabet: a key with a space or a quote sorts one way as a key and
+		// another once quoted, the shape of go-json/14, which the re-encoding would show)
+		choice[any]{1, asAny(hegel.Map(hegel.Maps(hegel.Text().Alphabet(keyAlphabet).MaxSize(4), asAny(hegel.Integers(0, 99))).MaxSize(3), nonNilMap[string, any]))},
+	)
+	htmlCases = hegel.Composite(func(tc hegel.TestCase) htmlCase {
+		return htmlCase{
+			tree: hegel.Draw(tc, safeTrees),
+			ws:   hegel.Draw(tc, wsRuns),
+			lead: hegel.Draw(tc, chance(50)),
+			cut:  hegel.Draw(tc, positions),
+			kind: hegel.Draw(tc, hegel.Integers(0, 2)),
+		}
+	})
+)
+
+// HTMLEscape escapes the HTML-significant characters of a text in place and leaves every
+// other byte, whitespace and invalid input included, as it is, like encoding/json's
+// (go-json decodes and re-encodes, go-json/17).
+func TestHegelHTMLEscapeOnlyEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, htmlCases).text()
+		var gb, wb bytes.Buffer
+		json.HTMLEscape(&gb, []byte(text))
+		std.HTMLEscape(&wb, []byte(text))
+		if gb.String() != wb.String() {
+			mismatch(ht, known("go-json/17"), "HTMLEscape(%q): go-json %q, encoding/json %q", text, gb.String(), wb.String())
+		}
+	})
+}
