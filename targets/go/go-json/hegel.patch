+// Indent keeps the whitespace after the value, as encoding/json documents and does (go-json
+// drops it, go-json/18).
+func TestHegelIndentKeepsTrailingWhitespace(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, trailingCases)
+		validAgrees(ht, shaped(c.text+c.ws, c.ws+c.text), c.prefix, c.indent, known("go-json/18"))
+	})
+}
