+// go-json on its own: Unmarshal(Marshal(v)) re-encodes to the same bytes, for
+// the struct universe and for interface{} trees.
+func TestHegelMarshalUnmarshalRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		if chance(ht, 60) {
+			v := genRich(ht)
+			text, err := json.Marshal(v)
+			if err != nil {
+				ht.Fatalf("Marshal: %v", err)
+			}
+			note(ht, "text: %s", short(text))
+			var back hgRich
+			if err := json.Unmarshal(text, &back); err != nil {
+				ht.Fatalf("Unmarshal of Marshal output: %v", err)
+			}
+			again, err := json.Marshal(back)
+			if err != nil || string(again) != string(text) {
+				ht.Fatalf("round trip differs (%v):\n first  %s\n second %s", err, short(text), short(again))
+			}
+			return
+		}
+		v := genAny(ht, 3)
+		text, err := json.Marshal(v)
+		if err != nil {
+			ht.Fatalf("Marshal: %v", err)
+		}
+		note(ht, "text: %s", short(text))
+		var back any
+		if err := json.Unmarshal(text, &back); err != nil {
+			ht.Fatalf("Unmarshal of Marshal output: %v", err)
+		}
+		if !reflect.DeepEqual(v, back) {
+			ht.Fatalf("round trip differs:\n original %#v\n back     %#v", v, back)
+		}
+	})
+}
