+// ---------------------------------------------------------------------------
+// go-json/26: numbers out of float64 range into a json.Number.
+
+// numberHolder: a struct member of type json.Number.
+type numberHolder struct {
+	N json.Number `json:"n"`
+}
+
+// A well-formed number outside float64 range decodes into a json.Number as its literal, as
+// in encoding/json, which stores any number's text (go-json validates it as a float64 and
+// fails, go-json/26); at top level, as a struct member or as an array element.
+func TestHegelNumbersOutOfRangeFitInNumber(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pairs(hugeLits, hegel.Integers(0, 2)))
+		switch c.b {
+		case 0:
+			decodesLike(ht, c.a, json.Number(""), known("go-json/26"))
+		case 1:
+			decodesLike(ht, `{"n":`+c.a+`}`, numberHolder{}, known("go-json/26"))
+		default:
+			decodesLike(ht, "["+c.a+"]", []json.Number(nil), known("go-json/26"))
+		}
+	})
+}
