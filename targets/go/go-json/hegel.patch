+package json_test
+
+// Hegel property tests for github.com/goccy/go-json.
+//
+// The oracle is the standard library's encoding/json, loaded here as `std`:
+// go-json's README promises a "fast JSON encoder/decoder compatible with
+// encoding/json", so wherever the two disagree on a byte of output, a decoded
+// value, or whether an input is valid, one of them is wrong -- and the standard
+// library is the reference.  The properties below generate random Go values
+// (a rich struct universe plus interface{} trees) and random JSON texts (with
+// random whitespace, escapes and number spellings) and compare
+// Marshal/MarshalIndent/Encoder, Unmarshal into interface{} and into structs,
+// Valid/Compact/Indent, and Decoder streams.  Every difference found while
+// writing the tests is pinned by a TestHegelPin* test at the bottom; the
+// generators avoid those pinned shapes and say so in a comment where they do.
+//
+// Known, documented design differences (UnorderedMap, DisableNormalizeUTF8's
+// `\ufffd` spelling of invalid UTF-8, DecodeFieldPriorityFirstWin) are not
+// exercised.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	json "github.com/goccy/go-json"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The struct universe.
+
+// hgText is a TextMarshaler (value receiver) / TextUnmarshaler (pointer
+// receiver) pair; it is used both as a field and as a map key type below.
+type hgText struct{ V string }
+
+func (x hgText) MarshalText() ([]byte, error) { return []byte("t:" + x.V), nil }
+
+func (x *hgText) UnmarshalText(b []byte) error {
+	s := string(b)
+	if !strings.HasPrefix(s, "t:") {
+		return fmt.Errorf("hgText: bad text %q", s)
+	}
+	x.V = s[2:]
+	return nil
+}
+
+// hgKey is a TextMarshaler map key whose text sorts like its number.
+type hgKey struct{ K uint8 }
+
+func (k hgKey) MarshalText() ([]byte, error) { return []byte(fmt.Sprintf("k%03d", k.K)), nil }
+
+func (k *hgKey) UnmarshalText(b []byte) error {
+	v, err := strconv.Atoi(strings.TrimPrefix(string(b), "k"))
+	if err != nil || v < 0 || v > 255 {
+		return fmt.Errorf("hgKey: bad key %q", b)
+	}
+	k.K = uint8(v)
+	return nil
+}
+
+// hgMarsh is a value-receiver Marshaler whose output is deliberately loosely
+// formatted (both libraries must compact it) with a pointer-receiver
+// Unmarshaler.
+type hgMarsh struct{ V int32 }
+
+func (m hgMarsh) MarshalJSON() ([]byte, error) {
+	return []byte(fmt.Sprintf(" { \"v\" : %d } ", m.V)), nil
+}
+
+func (m *hgMarsh) UnmarshalJSON(b []byte) error {
+	var w struct {
+		V int32 `json:"v"`
+	}
+	if err := std.Unmarshal(b, &w); err != nil {
+		return err
+	}
+	m.V = w.V
+	return nil
+}
+
+type hgInner struct {
+	A int      `json:"a"`
+	B string   `json:"b,omitempty"`
+	C *float64 `json:"c,omitempty"`
+}
+
+// HgEmbedded is exported so that it can be embedded and decoded into.
+type HgEmbedded struct {
+	E1 uint16   `json:"e1"`
+	E2 []string `json:"e2,omitempty"`
+}
+
+// hgRich exercises most of the encoding/json struct vocabulary: embedding,
+// pointers, every integer width, both float widths, the `string` option on
+// integers and on a string, omitempty on scalars and containers, []byte, a
+// fixed array, slices of structs, maps with string / integer / TextMarshaler
+// keys, Number, RawMessage, Marshaler and TextMarshaler fields, interface{},
+// `-`, `-,` and an unexported field.  It has more than sixteen fields (see
+// TestHegelPinFieldMatchingIsCaseInsensitiveForLargeStructs); the generators
+// never vary the case of its keys.
+type hgRich struct {
+	HgEmbedded
+	P     *hgInner         `json:"p"`
+	I8    int8             `json:"i8"`
+	I16   int16            `json:"i16,omitempty"`
+	I32   int32            `json:"i32,string"`
+	I64   int64            `json:"i64"`
+	U8    uint8            `json:"u8"`
+	U32   uint32           `json:"u32,omitempty"`
+	U64   uint64           `json:"u64,string"`
+	F32   float32          `json:"f32"`
+	F64   float64          `json:"f64,omitempty"`
+	S     string           `json:"s"`
+	SS    string           `json:"ss,string"`
+	B     bool             `json:"b,omitempty"`
+	Bs    []byte           `json:"bs"`
+	Arr   [3]int16         `json:"arr"`
+	Sl    []hgInner        `json:"sl,omitempty"`
+	M     map[string]int   `json:"m,omitempty"`
+	MI    map[int32]string `json:"mi"`
+	MT    map[hgKey]bool   `json:"mt,omitempty"`
+	N     json.Number      `json:"n,omitempty"`
+	R     json.RawMessage  `json:"r,omitempty"`
+	T     hgText           `json:"t"`
+	TP    *hgText          `json:"tp,omitempty"`
+	J     hgMarsh          `json:"j"`
+	Any   any              `json:"any"`
+	Skip  int              `json:"-"`
+	Dash  int              `json:"-,"`
+	Lower int              `json:"lower"`
+	NoTag int
+	//lint:ignore U1000 deliberately unexported, must be ignored by both encoders
+	hidden int
+}
+
+// ---------------------------------------------------------------------------
+// Generators for Go values.
+
+var stringPieces = []string{
+	"", "a", "Z", "0", "hello", "x y", " ", "\"", "\\", "/", "<", ">", "&", "'",
+	"\n", "\t", "\r", "\x00", "\x01", "\x1f", "\x7f",
+	"é", "日本", "😀", "\u2028", "\u2029", "\ufffd", "ÿ", "\U0010ffff", "\u00a0",
+	"{", "}", "[", "]", ",", ":", "null", "true", "1e5", "-0",
+}
+
+// genStr returns a valid-UTF-8 string built from pieces that cover ASCII
+// punctuation, quotes and backslashes, control characters, HTML-significant
+// characters, U+2028/2029 and non-BMP runes.  Invalid UTF-8 is not generated:
+// go-json documents that it spells the replacement as `\ufffd` where
+// encoding/json writes the raw U+FFFD bytes (see DisableNormalizeUTF8), and
+// the two decode identically.  U+0008 and U+000C are left to genTextStr
+// because go-json spells them `\u0008`/`\u000c` (see
+// TestHegelPinBackspaceAndFormFeedUseShortEscapes).
+func genStr(tc hegel.TestCase) string {
+	k := n(tc, 0, 6)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		if chance(tc, 15) {
+			b.WriteRune(rune(n(tc, 0x20, 0x2fff)))
+		} else {
+			b.WriteString(pick(tc, stringPieces))
+		}
+	}
+	return b.String()
+}
+
+const keyAlphabet = "abcxyzABCXYZ0189-_.:/#$%'()*+,;=?@[]^{}|~éü日"
+
+// genKey returns a non-empty map key from an alphabet that never needs
+// escaping and has no byte below '"', so that sorting the keys and sorting
+// their quoted encodings agree (see TestHegelPinMapKeysSortByKeyNotByEscapedKey,
+// which also covers the empty key and keys that are prefixes of each other).
+func genKey(tc hegel.TestCase) string {
+	runes := []rune(keyAlphabet)
+	k := n(tc, 1, 5)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteRune(pick(tc, runes))
+	}
+	return b.String()
+}
+
+// genTextStr is genStr plus the two control characters the encoders disagree
+// on; it is used for JSON texts that are only decoded.
+func genTextStr(tc hegel.TestCase) string {
+	s := genStr(tc)
+	if chance(tc, 15) {
+		s += pick(tc, []string{"\b", "\f", "a\bb\fc"})
+	}
+	return s
+}
+
+func genStrings(tc hegel.TestCase) []string {
+	k := n(tc, 0, 3)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = genStr(tc)
+	}
+	return out
+}
+
+func genBytes(tc hegel.TestCase) []byte {
+	k := n(tc, 0, 8)
+	out := make([]byte, k)
+	for i := range out {
+		out[i] = byte(n(tc, 0, 255))
+	}
+	return out
+}
+
+func genUint64(tc hegel.TestCase) uint64 {
+	switch n(tc, 0, 3) {
+	case 0:
+		return uint64(n(tc, 0, 1000))
+	case 1:
+		return uint64(n(tc, 0, math.MaxUint32))
+	default:
+		return uint64(n(tc, 0, math.MaxUint32))<<32 | uint64(n(tc, 0, math.MaxUint32))
+	}
+}
+
+func genInt64(tc hegel.TestCase) int64 {
+	switch n(tc, 0, 3) {
+	case 0:
+		return int64(n(tc, -1000, 1000))
+	case 1:
+		return pick(tc, []int64{math.MinInt64, math.MaxInt64, -1 << 53, 1 << 53, 1<<53 + 1, -(1<<53 + 1)})
+	default:
+		return int64(genUint64(tc))
+	}
+}
+
+// inPinnedExponentBand reports whether encoding/json prints f with a one-digit
+// negative exponent (1e-9 <= |f| < 1e-6), which go-json zero-pads to two
+// digits; see TestHegelPinFloatExponentsAreNotZeroPadded.
+func inPinnedExponentBand(f float64) bool {
+	a := math.Abs(f)
+	return a >= 1e-9 && a < 1e-6
+}
+
+func genFloat(tc hegel.TestCase) float64 {
+	for tries := 0; ; tries++ {
+		if tries == 32 {
+			return 0
+		}
+		var f float64
+		switch n(tc, 0, 7) {
+		case 0:
+			f = 0
+		case 1:
+			f = math.Copysign(0, -1)
+		case 2:
+			f = float64(n(tc, -1000000, 1000000))
+		case 3:
+			f = float64(n(tc, -1000000, 1000000)) / math.Pow10(n(tc, 0, 6))
+		case 4:
+			// tiny: below 1e-9, so that both libraries agree on the exponent width
+			f = math.Ldexp(1+float64(n(tc, 0, 1<<20))/float64(1<<20), -n(tc, 31, 1074))
+		case 5:
+			// huge: at or above 1e21, where encoding/json switches to exponent form
+			f = float64(n(tc, 1, 999999)) * math.Pow10(n(tc, 21, 300))
+		case 6:
+			f = math.Float64frombits(genUint64(tc))
+		default:
+			f = pick(tc, []float64{0.1, 0.5, 1.0 / 3, 1e20, 1e21, 123456789012345680000, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-10, 1e-100, 2.5e-300})
+		}
+		if chance(tc, 30) {
+			f = -f
+		}
+		if math.IsNaN(f) || math.IsInf(f, 0) || inPinnedExponentBand(f) {
+			continue
+		}
+		return f
+	}
+}
+
+// genFloat32 avoids NaN and the infinities (see
+// TestHegelPinFloat32NaNAndInfAreRejected) and the pinned exponent band.
+func genFloat32(tc hegel.TestCase) float32 {
+	for tries := 0; ; tries++ {
+		if tries == 32 {
+			return 0
+		}
+		f := float32(genFloat(tc))
+		if chance(tc, 20) {
+			f = math.Float32frombits(uint32(n(tc, 0, math.MaxUint32)))
+		}
+		g := float64(f)
+		if math.IsNaN(g) || math.IsInf(g, 0) || inPinnedExponentBand(g) {
+			continue
+		}
+		return f
+	}
+}
+
+func genInner(tc hegel.TestCase) hgInner {
+	in := hgInner{A: n(tc, -100000, 100000)}
+	if chance(tc, 50) {
+		in.B = genStr(tc)
+	}
+	if chance(tc, 40) {
+		c := genFloat(tc)
+		in.C = &c
+	}
+	return in
+}
+
+// genAny returns an interface{} tree of the kinds encoding/json itself
+// produces: nil, bool, float64, string, []any and map[string]any.
+func genAny(tc hegel.TestCase, depth int) any {
+	top := 9
+	if depth <= 0 {
+		top = 5
+	}
+	switch n(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2, 3:
+		return genFloat(tc)
+	case 4, 5:
+		return genStr(tc)
+	case 6, 7:
+		k := n(tc, 0, 4)
+		out := make([]any, k)
+		for i := range out {
+			out[i] = genAny(tc, depth-1)
+		}
+		return out
+	default:
+		k := n(tc, 0, 4)
+		out := make(map[string]any, k)
+		for i := 0; i < k; i++ {
+			out[genKey(tc)] = genAny(tc, depth-1)
+		}
+		return out
+	}
+}
+
+func genRich(tc hegel.TestCase) hgRich {
+	var r hgRich
+	r.E1 = uint16(n(tc, 0, 65535))
+	if chance(tc, 50) {
+		r.E2 = genStrings(tc)
+	}
+	if chance(tc, 60) {
+		in := genInner(tc)
+		r.P = &in
+	}
+	r.I8 = int8(n(tc, -128, 127))
+	r.I16 = int16(n(tc, -32768, 32767))
+	r.I32 = int32(wide(tc, math.MinInt32, math.MaxInt32))
+	r.I64 = genInt64(tc)
+	r.U8 = uint8(n(tc, 0, 255))
+	r.U32 = uint32(n(tc, 0, math.MaxUint32))
+	r.U64 = genUint64(tc)
+	r.F32 = genFloat32(tc)
+	r.F64 = genFloat(tc)
+	r.S = genStr(tc)
+	r.SS = genStr(tc)
+	r.B = chance(tc, 50)
+	if chance(tc, 70) {
+		r.Bs = genBytes(tc)
+	}
+	for i := range r.Arr {
+		r.Arr[i] = int16(n(tc, -300, 300))
+	}
+	if chance(tc, 50) {
+		r.Sl = make([]hgInner, n(tc, 0, 3))
+		for i := range r.Sl {
+			r.Sl[i] = genInner(tc)
+		}
+	}
+	if chance(tc, 50) {
+		r.M = map[string]int{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			r.M[genKey(tc)] = n(tc, -1000, 1000)
+		}
+	}
+	if chance(tc, 60) {
+		r.MI = map[int32]string{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			r.MI[int32(wide(tc, math.MinInt32, math.MaxInt32))] = genStr(tc)
+		}
+	}
+	if chance(tc, 40) {
+		r.MT = map[hgKey]bool{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			r.MT[hgKey{uint8(n(tc, 0, 255))}] = chance(tc, 50)
+		}
+	}
+	if chance(tc, 50) {
+		r.N = json.Number(genNumLit(tc))
+	}
+	if chance(tc, 50) {
+		// Raw U+2028/U+2029 inside a RawMessage are spelled as escapes: with
+		// HTML escaping off, go-json (like encoding/json before Go 1.25's
+		// rewrite) copies them through while today's encoding/json escapes
+		// them, and neither reading is wrong.
+		raw := emitText(tc, genTree(tc, 2), false)
+		raw = strings.ReplaceAll(raw, "\u2028", `\u2028`)
+		raw = strings.ReplaceAll(raw, "\u2029", `\u2029`)
+		r.R = json.RawMessage(raw)
+	}
+	r.T = hgText{genStr(tc)}
+	if chance(tc, 40) {
+		r.TP = &hgText{genStr(tc)}
+	}
+	r.J = hgMarsh{int32(wide(tc, math.MinInt32, math.MaxInt32))}
+	if chance(tc, 60) {
+		r.Any = genAny(tc, 2)
+	}
+	r.Skip = n(tc, 1, 100)
+	r.Dash = n(tc, 1, 100)
+	r.Lower = n(tc, -100, 100)
+	r.NoTag = n(tc, -100, 100)
+	r.hidden = n(tc, 1, 100)
+	return r
+}
+
+// genTop picks a top-level value for the encoders from the whole universe.
+func genTop(tc hegel.TestCase) any {
+	switch n(tc, 0, 9) {
+	case 0, 1, 2:
+		return genRich(tc)
+	case 3:
+		r := genRich(tc)
+		return &r
+	case 4, 5:
+		return genAny(tc, 3)
+	case 6:
+		out := make([]hgInner, n(tc, 0, 3))
+		for i := range out {
+			out[i] = genInner(tc)
+		}
+		return out
+	case 7:
+		out := map[string]hgInner{}
+		for i := n(tc, 0, 3); i > 0; i-- {
+			out[genKey(tc)] = genInner(tc)
+		}
+		return out
+	case 8:
+		out := map[hgKey]any{}
+		for i := n(tc, 0, 3); i > 0; i-- {
+			out[hgKey{uint8(n(tc, 0, 255))}] = genAny(tc, 1)
+		}
+		return out
+	default:
+		return [2]hgMarsh{{int32(n(tc, -5, 5))}, {int32(n(tc, -5, 5))}}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Generators for JSON texts.
+//
+// A tree is nil | bool | jnum | string | []any | jobj; jnum is a number
+// literal kept verbatim, jobj is an ordered list of pairs (duplicates
+// allowed, rarely).  emitText renders a tree with random whitespace, random
+// escape choices and the given number spellings.
+
+type jnum string
+
+type jpair struct {
+	k string
+	v any
+}
+
+type jobj []jpair
+
+// genNumLit returns a random valid JSON number literal whose magnitude stays
+// far inside float64 range (at most 20 integer digits and a two-digit
+// exponent), because go-json's Valid/Compact/Indent reject out-of-range
+// numbers (see TestHegelPinValidAcceptsNumbersOutOfFloat64Range).
+func genNumLit(tc hegel.TestCase) string {
+	var b strings.Builder
+	if chance(tc, 30) {
+		b.WriteByte('-')
+	}
+	k := n(tc, 1, 20)
+	if chance(tc, 40) {
+		k = 1
+	}
+	if k == 1 {
+		b.WriteByte(byte('0' + n(tc, 0, 9)))
+	} else {
+		b.WriteByte(byte('1' + n(tc, 0, 8)))
+		for i := 1; i < k; i++ {
+			b.WriteByte(byte('0' + n(tc, 0, 9)))
+		}
+	}
+	if chance(tc, 40) {
+		b.WriteByte('.')
+		for i := n(tc, 1, 6); i > 0; i-- {
+			b.WriteByte(byte('0' + n(tc, 0, 9)))
+		}
+	}
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, []string{"e", "E"}))
+		b.WriteString(pick(tc, []string{"", "+", "-"}))
+		for i := n(tc, 1, 2); i > 0; i-- {
+			b.WriteByte(byte('0' + n(tc, 0, 9)))
+		}
+	}
+	return b.String()
+}
+
+func genTree(tc hegel.TestCase, depth int) any {
+	top := 9
+	if depth <= 0 {
+		top = 5
+	}
+	switch n(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2, 3:
+		return jnum(genNumLit(tc))
+	case 4, 5:
+		return genTextStr(tc)
+	case 6, 7:
+		k := n(tc, 0, 4)
+		out := make([]any, k)
+		for i := range out {
+			out[i] = genTree(tc, depth-1)
+		}
+		return out
+	default:
+		k := n(tc, 0, 4)
+		out := make(jobj, 0, k)
+		for i := 0; i < k; i++ {
+			key := genTextStr(tc)
+			if i > 0 && chance(tc, 10) {
+				key = out[n(tc, 0, i-1)].k // a duplicate key: the last one wins
+			}
+			out = append(out, jpair{key, genTree(tc, depth-1)})
+		}
+		return out
+	}
+}
+
+// toTree converts a value decoded by encoding/json with UseNumber into a tree
+// whose objects are in random order.
+func toTree(tc hegel.TestCase, v any) any {
+	switch x := v.(type) {
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys) // deterministic before the drawn shuffle
+		out := make(jobj, 0, len(x))
+		for _, k := range keys {
+			out = append(out, jpair{k, toTree(tc, x[k])})
+		}
+		for i := len(out) - 1; i > 0; i-- {
+			j := n(tc, 0, i)
+			out[i], out[j] = out[j], out[i]
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = toTree(tc, e)
+		}
+		return out
+	case json.Number:
+		return jnum(x)
+	default:
+		return x
+	}
+}
+
+func ws(tc hegel.TestCase) string {
+	if chance(tc, 75) {
+		return ""
+	}
+	var b strings.Builder
+	for i := n(tc, 1, 3); i > 0; i-- {
+		b.WriteByte(pick(tc, []byte{' ', ' ', '\t', '\n', '\r'}))
+	}
+	return b.String()
+}
+
+func hexEscape(tc hegel.TestCase, u uint16) string {
+	s := fmt.Sprintf("\\u%04x", u)
+	if chance(tc, 30) {
+		s = strings.ToUpper(s[2:])
+		s = "\\u" + s
+	}
+	return s
+}
+
+// emitString writes s as a JSON string literal with random escape choices;
+// with plain set it uses no \u escapes except for control characters (see
+// TestHegelPinDecoderHandlesEscapedKeysAcrossBufferRefills).
+func emitString(tc hegel.TestCase, s string, b *strings.Builder, plain bool) {
+	b.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			if plain {
+				b.WriteString(`\"`)
+			} else {
+				b.WriteString(pick(tc, []string{`\"`, `\u0022`}))
+			}
+		case r == '\\':
+			if plain {
+				b.WriteString(`\\`)
+			} else {
+				b.WriteString(pick(tc, []string{`\\`, `\u005c`}))
+			}
+		case r < 0x20:
+			short := map[rune]string{'\b': `\b`, '\f': `\f`, '\n': `\n`, '\r': `\r`, '\t': `\t`}
+			if e, ok := short[r]; ok && chance(tc, 60) {
+				b.WriteString(e)
+			} else {
+				b.WriteString(hexEscape(tc, uint16(r)))
+			}
+		case r == '/' && !plain && chance(tc, 40):
+			b.WriteString(`\/`)
+		case r == '\ufffd' && !plain && chance(tc, 50):
+			// a lone low surrogate escape decodes to U+FFFD in both libraries
+			// (only low surrogates: two neighbours must never form a pair)
+			b.WriteString(pick(tc, []string{`\udc00`, `\uDFFF`}))
+		case !plain && chance(tc, 12):
+			if r > 0xffff {
+				r1, r2 := (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00
+				b.WriteString(hexEscape(tc, uint16(r1)))
+				b.WriteString(hexEscape(tc, uint16(r2)))
+			} else {
+				b.WriteString(hexEscape(tc, uint16(r)))
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func emit(tc hegel.TestCase, v any, b *strings.Builder, plain bool) {
+	b.WriteString(ws(tc))
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case jnum:
+		b.WriteString(string(x))
+	case string:
+		emitString(tc, x, b, plain)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				b.WriteString(ws(tc))
+				b.WriteByte(',')
+			}
+			emit(tc, e, b, plain)
+		}
+		b.WriteString(ws(tc))
+		b.WriteByte(']')
+	case jobj:
+		b.WriteByte('{')
+		for i, p := range x {
+			if i > 0 {
+				b.WriteString(ws(tc))
+				b.WriteByte(',')
+			}
+			b.WriteString(ws(tc))
+			emitString(tc, p.k, b, plain)
+			b.WriteString(ws(tc))
+			b.WriteByte(':')
+			emit(tc, p.v, b, plain)
+		}
+		b.WriteString(ws(tc))
+		b.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("emit: unexpected %T", v))
+	}
+}
+
+// emitText renders a tree; trailing whitespace is optional because go-json's
+// Indent drops it (see TestHegelPinIndentKeepsTrailingWhitespace).
+func emitText(tc hegel.TestCase, tree any, trailing bool) string {
+	var b strings.Builder
+	emit(tc, tree, &b, false)
+	if trailing {
+		b.WriteString(ws(tc))
+	}
+	return b.String()
+}
+
+// emitTextPlain renders a tree with random whitespace but without optional
+// escapes, for the stream Decoder (see
+// TestHegelPinDecoderHandlesEscapedKeysAcrossBufferRefills).
+func emitTextPlain(tc hegel.TestCase, tree any) string {
+	var b strings.Builder
+	emit(tc, tree, &b, true)
+	b.WriteString(ws(tc))
+	return b.String()
+}
+
+// canonTree parses encoding/json's own encoding of v into a tree (numbers kept
+// verbatim) so that it can be re-rendered with random formatting.
+func canonTree(tc hegel.TestCase, canon []byte) any {
+	d := std.NewDecoder(bytes.NewReader(canon))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		panic(fmt.Sprintf("canonTree: %v for %s", err, canon))
+	}
+	return toTree(tc, v)
+}
+
+// pinnedValidShape reports whether s is one of the invalid texts go-json's
+// Valid is known to accept: a value preceded by a comma or colon
+// (TestHegelPinDecoderRejectsTruncatedLiteralsAndLeadingPunctuation) or a
+// complete value followed by a stray ] or }
+// (TestHegelPinStrayClosingBracketIsAnError).  It is decided with the
+// oracle's decoder only.
+func pinnedValidShape(s string) bool {
+	t := strings.TrimLeft(s, " \t\n\r")
+	if t == "" || t[0] == ',' || t[0] == ':' {
+		return t != ""
+	}
+	d := std.NewDecoder(strings.NewReader(s))
+	var v any
+	if err := d.Decode(&v); err != nil {
+		return false
+	}
+	rest, _ := readRest(d.Buffered())
+	rest = strings.TrimLeft(rest, " \t\n\r")
+	return rest != "" && (rest[0] == ']' || rest[0] == '}')
+}
+
+func readRest(r interface{ Read([]byte) (int, error) }) (string, error) {
+	var b bytes.Buffer
+	_, err := b.ReadFrom(r)
+	return b.String(), err
+}
+
+// inEscape reports whether inserting at position i of s would land inside a
+// backslash escape (right after the backslash, or inside the four hex digits
+// of a \u escape); go-json's stream decoder accepts \u escapes with non-hex
+// digits (TestHegelPinDecoderRejectsTruncatedLiteralsAndLeadingPunctuation).
+func inEscape(s string, i int) bool {
+	for j := i - 1; j >= 0 && j >= i-6; j-- {
+		if s[j] == '\\' {
+			if j == i-1 || (j+1 < len(s) && s[j+1] == 'u' && i <= j+6) {
+				return true
+			}
+			return false
+		}
+	}
+	return false
+}
+
+// inNumber reports whether position i of s is strictly inside a number token,
+// where an insertion would split it into a pinned lenient-grammar shape such
+// as "-0." followed by a stray bracket.
+func inNumber(s string, i int) bool {
+	num := func(c byte) bool {
+		return c >= '0' && c <= '9' || c == '.' || c == '-' || c == '+' || c == 'e' || c == 'E'
+	}
+	return i > 0 && i < len(s) && num(s[i-1]) && num(s[i])
+}
+
+// mutate applies one structural edit to a JSON text: it deletes or duplicates
+// one bracket, brace, comma, colon, quote or whitespace byte (never an
+// escaped one), or inserts one such punctuation byte anywhere except inside
+// an escape or a number.  Digits and letters are left alone so that the
+// result never lands in the pinned lenient-number-grammar shapes, and a
+// result in a pinnedValidShape is discarded in favour of the original text.
+func mutate(tc hegel.TestCase, s string) string {
+	m := mutateOnce(tc, s)
+	if pinnedValidShape(m) {
+		return s
+	}
+	return m
+}
+
+func mutateOnce(tc hegel.TestCase, s string) string {
+	const structural = "[]{},:\""
+	var idx []int
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(structural+" \t\n\r", s[i]) >= 0 {
+			idx = append(idx, i)
+		}
+	}
+	switch n(tc, 0, 2) {
+	case 0:
+		if len(idx) == 0 {
+			return s
+		}
+		i := pick(tc, idx)
+		if i > 0 && s[i-1] == '\\' {
+			return s // deleting an escaped quote would leave `\ ` etc.
+		}
+		return s[:i] + s[i+1:]
+	case 1:
+		i := n(tc, 0, len(s))
+		if inEscape(s, i) || inNumber(s, i) {
+			return s
+		}
+		return s[:i] + string(structural[n(tc, 0, len(structural)-1)]) + s[i:]
+	default:
+		if len(idx) == 0 {
+			return s
+		}
+		i := pick(tc, idx)
+		return s[:i+1] + s[i:]
+	}
+}
+
+var indents = []string{"", " ", "\t", "  ", "xx", "\n"}
+
+func short(b []byte) string {
+	s := string(b)
+	if len(s) > 300 {
+		return s[:300] + "..."
+	}
+	return s
+}
+
+func stdJSON(v any) string {
+	b, err := std.Marshal(v)
+	if err != nil {
+		return "ERR:" + err.Error()
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// Marshal, MarshalIndent and Encoder produce byte-for-byte what encoding/json
+// produces, for random values from the whole universe, with and without HTML
+// escaping and indentation.
+func TestHegelMarshalMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genTop(ht)
+		note(ht, "value (%T): %s", v, short([]byte(stdJSON(v))))
+
+		g, ge := json.Marshal(v)
+		w, we := std.Marshal(v)
+		if (ge == nil) != (we == nil) {
+			ht.Fatalf("Marshal error mismatch: go-json %v, encoding/json %v", ge, we)
+		}
+		if string(g) != string(w) {
+			ht.Fatalf("Marshal differs:\n go-json       %s\n encoding/json %s", short(g), short(w))
+		}
+
+		prefix, indent := pick(ht, indents), pick(ht, indents)
+		gi, gie := json.MarshalIndent(v, prefix, indent)
+		wi, wie := std.MarshalIndent(v, prefix, indent)
+		if (gie == nil) != (wie == nil) || string(gi) != string(wi) {
+			ht.Fatalf("MarshalIndent(%q, %q) differs:\n go-json       %q %v\n encoding/json %q %v", prefix, indent, short(gi), gie, short(wi), wie)
+		}
+
+		var gb, wb bytes.Buffer
+		genc, wenc := json.NewEncoder(&gb), std.NewEncoder(&wb)
+		escape := chance(ht, 50)
+		genc.SetEscapeHTML(escape)
+		wenc.SetEscapeHTML(escape)
+		if chance(ht, 50) {
+			p, i := pick(ht, indents), pick(ht, indents)
+			genc.SetIndent(p, i)
+			wenc.SetIndent(p, i)
+		}
+		second := genAny(ht, 1)
+		for _, x := range []any{v, second} {
+			ge, we := genc.Encode(x), wenc.Encode(x)
+			if (ge == nil) != (we == nil) {
+				ht.Fatalf("Encoder.Encode error mismatch: go-json %v, encoding/json %v", ge, we)
+			}
+		}
+		if gb.String() != wb.String() {
+			ht.Fatalf("Encoder output differs (escapeHTML=%v):\n go-json       %q\n encoding/json %q", escape, short(gb.Bytes()), short(wb.Bytes()))
+		}
+
+		// MarshalWithOption(DisableHTMLEscape) is the package-level spelling of
+		// SetEscapeHTML(false).
+		if we == nil {
+			opt, err := json.MarshalWithOption(v, json.DisableHTMLEscape())
+			var ref bytes.Buffer
+			enc := std.NewEncoder(&ref)
+			enc.SetEscapeHTML(false)
+			_ = enc.Encode(v)
+			want := strings.TrimSuffix(ref.String(), "\n")
+			if err != nil || string(opt) != want {
+				ht.Fatalf("MarshalWithOption(DisableHTMLEscape) differs:\n go-json       %q %v\n encoding/json %q", short(opt), err, short([]byte(want)))
+			}
+		}
+	})
+}
+
+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := emitText(ht, genTree(ht, 3), true)
+		note(ht, "text: %q", short([]byte(text)))
+
+		var g, w any
+		ge := json.Unmarshal([]byte(text), &g)
+		we := std.Unmarshal([]byte(text), &w)
+		if we != nil {
+			ht.Fatalf("generator produced a text encoding/json rejects: %v", we)
+		}
+		if ge != nil {
+			ht.Fatalf("go-json rejects a valid text: %v", ge)
+		}
+		if !reflect.DeepEqual(g, w) {
+			ht.Fatalf("Unmarshal into interface{} differs:\n go-json       %#v\n encoding/json %#v", g, w)
+		}
+
+		gd, wd := json.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+		gd.UseNumber()
+		wd.UseNumber()
+		var gn, wn any
+		ge, we = gd.Decode(&gn), wd.Decode(&wn)
+		if ge != nil || we != nil {
+			ht.Fatalf("UseNumber decode errors: go-json %v, encoding/json %v", ge, we)
+		}
+		if !reflect.DeepEqual(gn, wn) {
+			ht.Fatalf("UseNumber decode differs:\n go-json       %#v\n encoding/json %#v", gn, wn)
+		}
+		if !json.Valid([]byte(text)) {
+			ht.Fatalf("Valid is false for a text Unmarshal accepted")
+		}
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (and back to the original encoding), and
+// DisallowUnknownFields rejects exactly the texts with an unknown key.
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genRich(ht)
+		canon, err := std.Marshal(v)
+		if err != nil {
+			ht.Fatalf("encoding/json cannot encode the generated value: %v", err)
+		}
+		tree := canonTree(ht, canon).(jobj)
+		unknown := chance(ht, 30)
+		if unknown {
+			at := n(ht, 0, len(tree))
+			tree = append(tree[:at], append(jobj{{"zz_unknown", genTree(ht, 1)}}, tree[at:]...)...)
+		}
+		text := emitText(ht, tree, true)
+		note(ht, "canonical: %s", short(canon))
+		note(ht, "text:      %s", short([]byte(text)))
+
+		// Unmarshal into fresh values: prefilled targets are not used because
+		// of TestHegelPinNullIntoByteSliceClearsIt.
+		var a, b hgRich
+		ea, eb := json.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+		if eb != nil {
+			ht.Fatalf("encoding/json rejects its own re-rendered encoding: %v", eb)
+		}
+		if ea != nil {
+			ht.Fatalf("go-json rejects the text: %v", ea)
+		}
+		ja, jb := stdJSON(a), stdJSON(b)
+		if ja != jb {
+			ht.Fatalf("decoded structs differ:\n go-json       %s\n encoding/json %s", short([]byte(ja)), short([]byte(jb)))
+		}
+		// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+		// out of the comparison with the original encoding.
+		v.R, a.R = nil, nil
+		canonNoRaw := stdJSON(v)
+		if stdJSON(a) != canonNoRaw {
+			ht.Fatalf("round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+		}
+
+		// The stream Decoder gets the same tree without optional escapes (see
+		// TestHegelPinDecoderHandlesEscapedKeysAcrossBufferRefills).
+		plain := emitTextPlain(ht, tree)
+		var da, db hgRich
+		gd, wd := json.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+		gd.DisallowUnknownFields()
+		wd.DisallowUnknownFields()
+		ea, eb = gd.Decode(&da), wd.Decode(&db)
+		if (eb != nil) != unknown {
+			ht.Fatalf("encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+		}
+		if (ea != nil) != unknown {
+			ht.Fatalf("go-json DisallowUnknownFields: unknown key present=%v but err=%v", unknown, ea)
+		}
+		da.R = nil
+		if !unknown && stdJSON(da) != canonNoRaw {
+			ht.Fatalf("Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+		}
+	})
+}
+
+// Valid, Compact and Indent agree with encoding/json on random valid texts and
+// on texts with one structural mutation (which are usually invalid).
+func TestHegelValidCompactIndentMatchEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := emitText(ht, genTree(ht, 3), false)
+		if chance(ht, 50) {
+			text = mutate(ht, text)
+		}
+		note(ht, "text: %q", short([]byte(text)))
+
+		gv, wv := json.Valid([]byte(text)), std.Valid([]byte(text))
+		if gv != wv {
+			ht.Fatalf("Valid differs: go-json %v, encoding/json %v", gv, wv)
+		}
+
+		var gb, wb bytes.Buffer
+		ge, we := json.Compact(&gb, []byte(text)), std.Compact(&wb, []byte(text))
+		if (ge == nil) != (we == nil) {
+			ht.Fatalf("Compact error mismatch: go-json %v, encoding/json %v", ge, we)
+		}
+		if we == nil && gb.String() != wb.String() {
+			ht.Fatalf("Compact differs:\n go-json       %q\n encoding/json %q", short(gb.Bytes()), short(wb.Bytes()))
+		}
+
+		// Oracle caveat: Go 1.27.1's encoding/json.Indent loops forever on
+		// some invalid inputs (a ~470-byte mutated text with prefix "\n" and
+		// an empty indent, quoted in the README), so it is only run on texts
+		// it considers valid; for the others its contract is simply an error.
+		prefix, indent := pick(ht, indents), pick(ht, indents)
+		gb.Reset()
+		wb.Reset()
+		ge = json.Indent(&gb, []byte(text), prefix, indent)
+		we = fmt.Errorf("invalid JSON")
+		if wv {
+			we = std.Indent(&wb, []byte(text), prefix, indent)
+		}
+		if (ge == nil) != (we == nil) {
+			ht.Fatalf("Indent error mismatch: go-json %v, encoding/json %v", ge, we)
+		}
+		if we == nil && gb.String() != wb.String() {
+			ht.Fatalf("Indent(%q, %q) differs:\n go-json       %q\n encoding/json %q", prefix, indent, short(gb.Bytes()), short(wb.Bytes()))
+		}
+	})
+}
+
+// A Decoder reading a stream of values (optionally followed by garbage) yields
+// the same values, errors, More() answers and Token() sequence as
+// encoding/json's Decoder.
+func TestHegelDecoderStreamMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		var b strings.Builder
+		for i := 0; i < k; i++ {
+			text := emitText(ht, genTree(ht, 2), false)
+			if i > 0 {
+				// The separator is dropped only between two values that are
+				// self-delimiting on both sides (e.g. "...]" then "{...", or "...}" then "[...").
+				prev := b.String()
+				next := strings.TrimLeft(text, " \t\r\n")
+				if chance(ht, 70) || next == "" || !strings.ContainsRune("]}\"", rune(prev[len(prev)-1])) || !strings.ContainsRune("[{\"", rune(next[0])) {
+					b.WriteString(pick(ht, []string{" ", "\n", "\t", " \r\n"}))
+				}
+			}
+			b.WriteString(text)
+		}
+		if chance(ht, 30) {
+			// Trailing garbage; a stray ] or } and a truncated literal are
+			// pinned shapes and left out.
+			// (an unterminated { or " is left out too: after it More() at
+			// EOF is false in go-json and in encoding/json before Go 1.25,
+			// true in today's encoding/json).
+			b.WriteString(pick(ht, []string{" x", ",", "\x01", " -"}))
+		} else if chance(ht, 50) {
+			b.WriteString(ws(ht))
+		}
+		stream := b.String()
+		note(ht, "stream: %q", short([]byte(stream)))
+
+		gd, wd := json.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+		for i := 0; i <= k; i++ {
+			var gv, wv any
+			ge, we := gd.Decode(&gv), wd.Decode(&wv)
+			if (ge == nil) != (we == nil) {
+				ht.Fatalf("Decode #%d error mismatch: go-json %v, encoding/json %v", i, ge, we)
+			}
+			if we != nil {
+				break
+			}
+			if !reflect.DeepEqual(gv, wv) {
+				ht.Fatalf("Decode #%d differs:\n go-json       %#v\n encoding/json %#v", i, gv, wv)
+			}
+			if gm, wm := gd.More(), wd.More(); gm != wm {
+				ht.Fatalf("More() after value #%d: go-json %v, encoding/json %v", i, gm, wm)
+			}
+		}
+
+		gd, wd = json.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+		for i := 0; i < 400; i++ {
+			gt, ge := gd.Token()
+			wt, we := wd.Token()
+			if (ge == nil) != (we == nil) {
+				ht.Fatalf("Token #%d error mismatch: go-json %v (%v), encoding/json %v (%v)", i, gt, ge, wt, we)
+			}
+			if we != nil {
+				break
+			}
+			if !reflect.DeepEqual(gt, wt) {
+				ht.Fatalf("Token #%d differs: go-json %#v, encoding/json %#v", i, gt, wt)
+			}
+			if gm, wm := gd.More(), wd.More(); gm != wm {
+				ht.Fatalf("More() after token #%d (%v): go-json %v, encoding/json %v", i, wt, gm, wm)
+			}
+		}
+	})
+}
