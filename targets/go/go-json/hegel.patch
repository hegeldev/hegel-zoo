+// Valid, Compact and Indent judge the syntax of a number, not its range, as encoding/json
+// does (go-json rejects a well-formed number outside float64 range, go-json/22).
+func TestHegelValidAcceptsWellFormedNumbersOutOfRange(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pairs(hugeLits, contexts))
+		validAgrees(ht, embedded(c.b, c.a), "", " ", known("go-json/22"))
