+// ---------------------------------------------------------------------------
+// go-json/21: null into []byte.
+
+// bytesCase: a []byte holding some bytes, and the text decoded into it: null (the shape of
+// go-json/21: go-json keeps the old bytes) or, under HEGEL_NO_KNOWN=1, a base64 string; at
+// top level or as a struct member.
+type bytesCase struct {
+	init   []byte
+	text   string
+	nested bool
+}
+
+var bytesCases = hegel.Composite(func(tc hegel.TestCase) bytesCase {
