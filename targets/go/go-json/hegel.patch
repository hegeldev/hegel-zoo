index 0000000..821559f
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2144 @@
+package json_test
+
+// Hegel property tests for github.com/goccy/go-json.
+//
+// The oracle is the standard library's encoding/json, loaded here as `std`:
+// go-json's README promises a "fast JSON encoder/decoder compatible with
+// encoding/json", so wherever the two disagree on a byte of output, a decoded
+// value, or whether an input is valid, one of them is wrong -- and the standard
+// library is the reference.  Every property draws one case record: Go values
+// come from a rich struct universe and interface{} trees, JSON texts from a
+// tree rendered by a pure writer whose whitespace, escape choices and key
+// order come from a drawn tape (an empty tape is the compact, plainly escaped,
+// sorted text, so that is what a case shrinks to), edits of a text from a
+// drawn list applied modulo the live text.  The properties compare
+// Marshal/MarshalIndent/Encoder, Unmarshal into interface{} and into structs,
+// Valid/Compact/Indent on valid and edited texts, Decoder streams, and
+// go-json's own round trip.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate,
+// so the properties that meet them fail, naming the shape, and are the
+// expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_shapes_test.go has one property per bug over its shape region alone,
+// and hegel_pins_test.go the regression examples.  HEGEL_NO_KNOWN=1 switches
+// the known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Known, documented design differences (UnorderedMap, DisableNormalizeUTF8's
+// `\ufffd` spelling of invalid UTF-8, DecodeFieldPriorityFirstWin) are not
+// exercised; see the README's catalogue.
+//
+// Set ZOO_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	json "github.com/goccy/go-json"
+	"hegel.dev/go/hegel"
+)
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on and the shapes are left
+// out of the generators (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded go-json bugs; on means the shape is left out,
+// which is so only under HEGEL_NO_KNOWN=1.
+var Known = struct {
+	nonFiniteFloat32   bool // go-json/3: a float32 NaN or infinity is written as a bare token with a nil error
+	nulEndsInput       bool // go-json/4: a NUL byte ends the input, the rest is ignored
+	largeStructKeyCase bool // go-json/5: keys are matched case-insensitively only for structs of up to 16 fields
+	lenientNumbers     bool // go-json/7: leading zeros, a trailing dot, a missing integer digit (-.5) are accepted
+	bareNullKeys       bool // go-json/8: an unquoted null is accepted as an object key
+	nilTextMarshalers  bool // go-json/9: a nil pointer to a TextMarshaler marshals as "" at top level (and in slices and maps)
+	lenientDecoder     bool // go-json/10: the stream Decoder (and Valid) accept truncated literals at EOF, a leading , or :, and \u with non-hex digits
+	rawControlChars    bool // go-json/11: raw control characters inside strings are accepted
+	compactEscapes     bool // go-json/12: Compact and Indent do not validate escapes
+	paddedExponents    bool // go-json/13: floats in [1e-9, 1e-6) are written with a two-digit exponent
+	escapedKeyOrder    bool // go-json/14: map keys are sorted by their quoted, escaped encoding
+	omitEmptyArrays    bool // go-json/15: omitempty keeps a zero-length array
+	arrayMarshalers    bool // go-json/16: elements of a non-addressable array get their pointer-receiver MarshalJSON
+	indentTrailingWS   bool // go-json/18: Indent drops trailing whitespace
+	nullIntoBytes      bool // go-json/21: null into a []byte keeps the old value
+	outOfRangeNumbers  bool // go-json/22: Valid, Compact and Indent reject numbers outside float64 range
+	longEscapes        bool // go-json/23: \b and \f are written as \u0008 and \u000c
+	strayClosers       bool // go-json/24: a stray ] or } after a top-level value is fine for Valid and Token
+	escapedKeyRefills  bool // go-json/25: the stream Decoder fails on a \u escape in a struct key across its buffer refill
+	numberIntoNumber   bool // go-json/26: a well-formed number outside float64 range into a json.Number is an error
+}{
+	nonFiniteFloat32:   noKnown,
+	nulEndsInput:       noKnown,
+	largeStructKeyCase: noKnown,
+	lenientNumbers:     noKnown,
+	bareNullKeys:       noKnown,
+	nilTextMarshalers:  noKnown,
+	lenientDecoder:     noKnown,
+	rawControlChars:    noKnown,
+	compactEscapes:     noKnown,
+	paddedExponents:    noKnown,
+	escapedKeyOrder:    noKnown,
+	omitEmptyArrays:    noKnown,
+	arrayMarshalers:    noKnown,
+	indentTrailingWS:   noKnown,
+	nullIntoBytes:      noKnown,
+	outOfRangeNumbers:  noKnown,
+	longEscapes:        noKnown,
+	strayClosers:       noKnown,
+	escapedKeyRefills:  noKnown,
+	numberIntoNumber:   noKnown,
+}
+
+// outOfRange reports a json.Number that does not fit a float64 (the shape of go-json/22 for
+// the text helpers, of go-json/26 for the decoders).
+func outOfRange(n json.Number) bool {
+	_, err := strconv.ParseFloat(string(n), 64)
+	return n != "" && err != nil
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// collected is the panic value fail() raises in collect mode; property()
+// swallows it so that the case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("ZOO_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the shapes of the
+// recorded bugs named (none for a plain failure): the failure names the shapes, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 60 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// ptrs: pointers to the values of g.
+func ptrs[T any](g hegel.Generator[T]) hegel.Generator[*T] { return hegel.Map(g, ptrTo[T]) }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, ptrs(g))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements, and both libraries write a nil slice or map as null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure writer consumes in order, recycled
+// modulo its length, for the choices a JSON text leaves free (whitespace, an escape's
+// spelling, the order of an object's members). An empty tape answers 0 to every question,
+// so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// ---------------------------------------------------------------------------
+// The struct universe.
+
+// hgText is a TextMarshaler (value receiver) / TextUnmarshaler (pointer
+// receiver) pair; it is used both as a field and as a map key type below.
+type hgText struct{ V string }
+
+func (x hgText) MarshalText() ([]byte, error) { return []byte("t:" + x.V), nil }
+
+func (x *hgText) UnmarshalText(b []byte) error {
+	s := string(b)
+	if !strings.HasPrefix(s, "t:") {
+		return fmt.Errorf("hgText: bad text %q", s)
+	}
+	x.V = s[2:]
+	return nil
+}
+
+// hgKey is a TextMarshaler map key whose text sorts like its number.
+type hgKey struct{ K uint8 }
+
+func (k hgKey) MarshalText() ([]byte, error) { return []byte(fmt.Sprintf("k%03d", k.K)), nil }
+
+func (k *hgKey) UnmarshalText(b []byte) error {
+	v, err := strconv.Atoi(strings.TrimPrefix(string(b), "k"))
+	if err != nil || v < 0 || v > 255 {
+		return fmt.Errorf("hgKey: bad key %q", b)
+	}
+	k.K = uint8(v)
+	return nil
+}
+
+// hgMarsh is a value-receiver Marshaler whose output is deliberately loosely
+// formatted (both libraries must compact it) with a pointer-receiver
+// Unmarshaler.
+type hgMarsh struct{ V int32 }
+
+func (m hgMarsh) MarshalJSON() ([]byte, error) {
+	return []byte(fmt.Sprintf(" { \"v\" : %d } ", m.V)), nil
+}
+
+func (m *hgMarsh) UnmarshalJSON(b []byte) error {
+	var w struct {
+		V int32 `json:"v"`
+	}
+	if err := std.Unmarshal(b, &w); err != nil {
+		return err
+	}
+	m.V = w.V
+	return nil
+}
+
+type hgInner struct {
+	A int      `json:"a"`
+	B string   `json:"b,omitempty"`
+	C *float64 `json:"c,omitempty"`
+}
+
+// HgEmbedded is exported so that it can be embedded and decoded into.
+type HgEmbedded struct {
+	E1 uint16   `json:"e1"`
+	E2 []string `json:"e2,omitempty"`
+}
+
+// hgRich exercises most of the encoding/json struct vocabulary: embedding,
+// pointers, every integer width, both float widths, the `string` option on
+// integers and on a string, omitempty on scalars and containers, []byte, a
+// fixed array, slices of structs, maps with string / integer / TextMarshaler
+// keys, Number, RawMessage, Marshaler and TextMarshaler fields, interface{},
+// `-`, `-,` and an unexported field.  It has more than sixteen fields (the
+// shape of go-json/5, which the struct property reaches by upper-casing keys:
+// they are pairwise distinct even case-insensitively).
+type hgRich struct {
+	HgEmbedded
+	P     *hgInner         `json:"p"`
+	I8    int8             `json:"i8"`
+	I16   int16            `json:"i16,omitempty"`
+	I32   int32            `json:"i32,string"`
+	I64   int64            `json:"i64"`
+	U8    uint8            `json:"u8"`
+	U32   uint32           `json:"u32,omitempty"`
+	U64   uint64           `json:"u64,string"`
+	F32   float32          `json:"f32"`
+	F64   float64          `json:"f64,omitempty"`
+	S     string           `json:"s"`
+	SS    string           `json:"ss,string"`
+	B     bool             `json:"b,omitempty"`
+	Bs    []byte           `json:"bs"`
+	Arr   [3]int16         `json:"arr"`
+	Sl    []hgInner        `json:"sl,omitempty"`
+	M     map[string]int   `json:"m,omitempty"`
+	MI    map[int32]string `json:"mi"`
+	MT    map[hgKey]bool   `json:"mt,omitempty"`
+	N     json.Number      `json:"n,omitempty"`
+	R     json.RawMessage  `json:"r,omitempty"`
+	T     hgText           `json:"t"`
+	TP    *hgText          `json:"tp,omitempty"`
+	J     hgMarsh          `json:"j"`
+	Any   any              `json:"any"`
+	Skip  int              `json:"-"`
+	Dash  int              `json:"-,"`
+	Lower int              `json:"lower"`
+	NoTag int
+	//lint:ignore U1000 deliberately unexported, must be ignored by both encoders
+	hidden int
+}
+
+// hgOmitEmpty has a zero-length array under omitempty (the shape of go-json/15) beside other
+// omitempty fields; hgOmitArrays is the neighbouring region, arrays with elements.
+type hgOmitEmpty struct {
+	Z [0]int `json:"z,omitempty"`
+	A [2]int `json:"a,omitempty"`
+	S []int  `json:"s,omitempty"`
+	X string `json:"x,omitempty"`
+}
+
+type hgOmitArrays struct {
+	A [2]int `json:"a,omitempty"`
+	S []int  `json:"s,omitempty"`
+	X string `json:"x,omitempty"`
+}
+
+// ---------------------------------------------------------------------------
+// Generators for Go values.
+
+var stringPieces = []string{
+	"", "a", "Z", "0", "hello", "x y", " ", "\"", "\\", "/", "<", ">", "&", "'",
+	"\n", "\t", "\r", "\x00", "\x01", "\x1f", "\x7f",
+	"é", "日本", "😀", "\u2028", "\u2029", "\ufffd", "ÿ", "\U0010ffff", "\u00a0",
+	"{", "}", "[", "]", ",", ":", "null", "true", "1e5", "-0",
+}
+
+// keyAlphabet never needs escaping and has no byte below '"', so that sorting the keys and
+// sorting their quoted encodings agree; by default map keys also draw the characters that
+// are escaped, a space, a quote and a line separator (the shape of go-json/14), and may be
+// empty.
+const keyAlphabet = "abcxyzABCXYZ0189-_.:/#$%'()*+,;=?@[]^{}|~éü日"
+
+var (
+	// encodePieces: the pieces of a string the encoders write: the pieces above and, by
+	// default, U+0008 and U+000C, which go-json spells as long escapes (go-json/23).
+	encodePieces = shaped(append(append([]string{}, stringPieces...), "\b", "\f", "a\bb\fc"), stringPieces)
+	// strPieces: a piece of a string: one of the pieces seventeen times in twenty, else a rune
+	// of the first Unicode blocks.
+	strPieces = weighted(
+		choice[string]{85, hegel.SampledFrom(encodePieces)},
+		choice[string]{15, hegel.Map(hegel.Integers[rune](0x20, 0x2fff), func(r rune) string { return string(r) })},
+	)
+	// strs: up to six pieces: a valid-UTF-8 string covering ASCII punctuation, quotes and
+	// backslashes, control characters, HTML-significant characters, U+2028/2029 and non-BMP
+	// runes. Invalid UTF-8 is not generated (the two libraries write it differently, see the
+	// README's catalogue).
+	strs = hegel.Map(many(strPieces, 0, 6), func(ps []string) string { return strings.Join(ps, "") })
+	// mapKeys: a map key of up to five characters; see keyAlphabet.
+	mapKeys = shaped(hegel.Text().Alphabet(keyAlphabet+" !\"\\<>&\n\u2028").MaxSize(5), hegel.Text().Alphabet(keyAlphabet).MinSize(1).MaxSize(5))
+	// textStrs: strs with a few more control characters three times in twenty, for JSON
+	// texts that are only decoded.
+	textStrs = hegel.Map(pairs(strs, maybe(15, hegel.SampledFrom([]string{"\b", "\f", "a\bb\fc", "\x0b"}))), func(p pair[string, string]) string { return p.a + p.b })
+	strLists = many(strs, 0, 3)
+	// byteSlices: up to eight bytes, empty but not nil when there are none.
+	byteSlices = hegel.Map(hegel.Binary(0, 8), nonNil[byte])
+)
+
+var (
+	u32s = hegel.Integers[uint32](0, math.MaxUint32)
+	i32s = hegel.Integers[int32](math.MinInt32, math.MaxInt32)
+	// uint64s: within a thousand once in four, within 32 bits once, else of any width.
+	uint64s = weighted(
+		choice[uint64]{1, hegel.Integers[uint64](0, 1000)},
+		choice[uint64]{1, hegel.Integers[uint64](0, math.MaxUint32)},
+		choice[uint64]{2, hegel.Map(pairs(u32s, u32s), func(p pair[uint32, uint32]) uint64 { return uint64(p.a)<<32 | uint64(p.b) })},
+	)
+	// int64s: within a thousand once in four, at an edge of int64 or of the exact float64
+	// integers once, else the bits of a uint64.
+	int64s = weighted(
+		choice[int64]{1, hegel.Integers[int64](-1000, 1000)},
+		choice[int64]{1, hegel.SampledFrom([]int64{math.MinInt64, math.MaxInt64, -1 << 53, 1 << 53, 1<<53 + 1, -(1<<53 + 1)})},
+		choice[int64]{2, hegel.Map(uint64s, func(u uint64) int64 { return int64(u) })},
+	)
+)
+
+var floatEdges = []float64{0.1, 0.5, 1.0 / 3, 1e20, 1e21, 123456789012345680000, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-10, 1e-100, 2.5e-300}
+
+func isFinite(f float64) bool { return !math.IsNaN(f) && !math.IsInf(f, 0) }
+
+// inExponentBand reports whether encoding/json prints f with a one-digit negative exponent
+// (1e-9 <= |f| < 1e-6), which go-json zero-pads to two digits (go-json/13).
+func inExponentBand(f float64) bool {
+	a := math.Abs(f)
+	return a >= 1e-9 && a < 1e-6
+}
+
+// floatBases: a finite float64 within the range of a float of `bits` bits, of nine kinds as
+// often as each other: zero, a negative zero, an integer within a million, a decimal of up to
+// six places, a tiny value (down to the width's smallest denormal), a value of the exponent
+// band [1e-9, 1e-6) (the shape of go-json/13; under HEGEL_NO_KNOWN=1 the decade below it), a
+// huge value at or above 1e21 (where encoding/json switches to exponent form), the float of
+// random bits (NaN and the infinities filtered out, one draw in two thousand), or an edge.
+func floatBases(bits int) hegel.Generator[float64] {
+	maxExp, tinyExp, edges := 300, 1074, floatEdges
+	bitFloats := hegel.Map(uint64s, math.Float64frombits)
+	if bits == 32 {
+		maxExp, tinyExp, edges = 32, 149, nil
+		for _, e := range floatEdges {
+			if e <= math.MaxFloat32 {
+				edges = append(edges, e)
+			}
+		}
+		bitFloats = hegel.Map(u32s, func(u uint32) float64 { return float64(math.Float32frombits(u)) })
+	}
+	ldexp := func(p pair[int, int]) float64 { return math.Ldexp(1+float64(p.a)/float64(1<<20), -p.b) }
+	mantissas := hegel.Integers(0, 1<<20)
+	return weighted(
+		choice[float64]{1, hegel.Just(0.0)},
+		choice[float64]{1, hegel.Just(math.Copysign(0, -1))},
+		choice[float64]{1, hegel.Map(hegel.Integers(-1000000, 1000000), func(x int) float64 { return float64(x) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(-1000000, 1000000), hegel.Integers(0, 6)), func(p pair[int, int]) float64 { return float64(p.a) / math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Map(pairs(mantissas, hegel.Integers(1, tinyExp)), ldexp)},
+		choice[float64]{1, hegel.Map(pairs(mantissas, shaped(hegel.Integers(21, 29), hegel.Integers(31, 39))), ldexp)},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(1, 999999), hegel.Integers(21, maxExp)), func(p pair[int, int]) float64 { return float64(p.a) * math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Filter(bitFloats, isFinite)},
+		choice[float64]{1, hegel.SampledFrom(edges)},
+	)
+}
+
+// signed negates three times in ten.
+func signed(g hegel.Generator[float64]) hegel.Generator[float64] {
+	return hegel.Map(pairs(g, chance(30)), func(p pair[float64, bool]) float64 {
+		if p.b {
+			return -p.a
+		}
+		return p.a
+	})
+}
+
+// pastBand keeps the values outside the exponent band (under HEGEL_NO_KNOWN=1; the tiny and
+// random-bit kinds reach it once in a few hundred draws).
+func pastBand[T float32 | float64](g hegel.Generator[T]) hegel.Generator[T] {
+	if !Known.paddedExponents {
+		return g
+	}
+	return hegel.Filter(g, func(f T) bool { return !inExponentBand(float64(f)) })
+}
+
+var (
+	floats = pastBand(signed(floatBases(64)))
+	// finiteFloat32s: a signed float32 base (a tiny value may round to zero).
+	finiteFloat32s = pastBand(hegel.Map(signed(floatBases(32)), func(f float64) float32 { return float32(f) }))
+	// float32s: finite eight times in nine, else NaN or an infinity (the shape of go-json/3;
+	// finite only under HEGEL_NO_KNOWN=1).
+	float32s = shaped(weighted(
+		choice[float32]{8, finiteFloat32s},
+		choice[float32]{1, hegel.SampledFrom([]float32{float32(math.NaN()), float32(math.Inf(1)), float32(math.Inf(-1))})},
+	), finiteFloat32s)
+	inners = hegel.Composite(func(tc hegel.TestCase) hgInner {
+		return hgInner{A: hegel.Draw(tc, hegel.Integers(-100000, 100000)), B: hegel.Draw(tc, maybe(50, strs)), C: hegel.Draw(tc, optional(40, floats))}
+	})
+	innerLists = hegel.Map(many(inners, 0, 3), nonNil[hgInner])
+)
+
+// anyTrees: an interface{} tree of the kinds encoding/json itself produces (nil, bool,
+// float64, string, []any and map[string]any) with at most maxDepth levels of containers. A
+// node is a leaf (nil or a bool once in six each, a float or a string twice) three times in
+// five, else a list of up to four nodes or a map of up to four once each. The depth counter
+// lives in the closure and is restored by defer, so an aborted draw cannot leave it stale.
+func anyTrees(maxDepth int) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(floats)},
+		choice[any]{2, asAny(strs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	maps := hegel.Map(hegel.Maps(mapKeys, child).MaxSize(4), nonNilMap[string, any])
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(maps)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var anyTrees3, anyTrees2, anyTrees1 = anyTrees(3), anyTrees(2), anyTrees(1)
+
+var (
+	hgKeys       = hegel.Map(hegel.Integers(0, 255), func(k int) hgKey { return hgKey{uint8(k)} })
+	hgTexts      = hegel.Map(strs, func(s string) hgText { return hgText{s} })
+	hgMarshes    = hegel.Map(i32s, func(v int32) hgMarsh { return hgMarsh{v} })
+	int16Triples = hegel.Map(many(hegel.Integers(-300, 300), 3, 3), func(xs []int) (a [3]int16) {
+		for i, x := range xs {
+			a[i] = int16(x)
+		}
+		return a
+	})
+	numbers = hegel.Map(numLits, func(l string) json.Number { return json.Number(l) })
+	// rawMessages: a tree of two levels rendered with a tape. Raw U+2028/U+2029 are spelled
+	// as escapes: with HTML escaping off, go-json (like encoding/json before Go 1.25's
+	// rewrite) copies them through while today's encoding/json escapes them, and neither
+	// reading is wrong (see the README's oracle caveat).
+	rawMessages = hegel.Map(pairs(trees2, tapes), func(p pair[any, []int]) json.RawMessage {
+		raw := render(p.a, p.b, false, false)
+		raw = strings.ReplaceAll(raw, "\u2028", "\\u2028")
+		raw = strings.ReplaceAll(raw, "\u2029", "\\u2029")
+		return json.RawMessage(raw)
+	})
+	// richesWith: an hgRich whose F32 comes from f32s; the optional fields present half of the
+	// time or so. riches is for the encoders (a non-finite F32 is the shape of go-json/3),
+	// finiteRiches for the decoders, whose texts encoding/json has to be able to write.
+	richesWith = func(f32s hegel.Generator[float32]) hegel.Generator[hgRich] {
+		return hegel.Composite(func(tc hegel.TestCase) hgRich {
+			return hgRich{
+				HgEmbedded: HgEmbedded{
+					E1: uint16(hegel.Draw(tc, hegel.Integers(0, 65535))),
+					E2: hegel.Draw(tc, maybe(50, strLists)),
+				},
+				P:      hegel.Draw(tc, optional(60, inners)),
+				I8:     int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+				I16:    int16(hegel.Draw(tc, hegel.Integers(-32768, 32767))),
+				I32:    hegel.Draw(tc, i32s),
+				I64:    hegel.Draw(tc, int64s),
+				U8:     uint8(hegel.Draw(tc, hegel.Integers(0, 255))),
+				U32:    hegel.Draw(tc, u32s),
+				U64:    hegel.Draw(tc, uint64s),
+				F32:    hegel.Draw(tc, f32s),
+				F64:    hegel.Draw(tc, floats),
+				S:      hegel.Draw(tc, strs),
+				SS:     hegel.Draw(tc, strs),
+				B:      hegel.Draw(tc, hegel.Booleans()),
+				Bs:     hegel.Draw(tc, maybe(70, byteSlices)),
+				Arr:    hegel.Draw(tc, int16Triples),
+				Sl:     hegel.Draw(tc, maybe(50, innerLists)),
+				M:      hegel.Draw(tc, maybe(50, hegel.Map(hegel.Maps(mapKeys, hegel.Integers(-1000, 1000)).MaxSize(4), nonNilMap[string, int]))),
+				MI:     hegel.Draw(tc, maybe(60, hegel.Map(hegel.Maps(i32s, strs).MaxSize(4), nonNilMap[int32, string]))),
+				MT:     hegel.Draw(tc, maybe(40, hegel.Map(hegel.Maps(hgKeys, hegel.Booleans()).MaxSize(4), nonNilMap[hgKey, bool]))),
+				N:      hegel.Draw(tc, maybe(50, numbers)),
+				R:      hegel.Draw(tc, maybe(50, rawMessages)),
+				T:      hegel.Draw(tc, hgTexts),
+				TP:     hegel.Draw(tc, optional(40, hgTexts)),
+				J:      hegel.Draw(tc, hgMarshes),
+				Any:    hegel.Draw(tc, maybe(60, anyTrees2)),
+				Skip:   hegel.Draw(tc, hegel.Integers(1, 100)),
+				Dash:   hegel.Draw(tc, hegel.Integers(1, 100)),
+				Lower:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+				NoTag:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+				hidden: hegel.Draw(tc, hegel.Integers(1, 100)),
+			}
+		})
+	}
+	riches       = richesWith(float32s)
+	finiteRiches = richesWith(finiteFloat32s)
+	smallMarshes = hegel.Map(hegel.Integers(-5, 5), func(v int) hgMarsh { return hgMarsh{int32(v)} })
+	marshPairs   = hegel.Map(pairs(smallMarshes, smallMarshes), func(p pair[hgMarsh, hgMarsh]) [2]hgMarsh { return [2]hgMarsh{p.a, p.b} })
+	// ptrMarshArrays: an array of two pointer-receiver Marshalers, whose elements are not
+	// addressable (the shape of go-json/16); under HEGEL_NO_KNOWN=1 a slice of them.
+	ptrMarshArrays = shaped(
+		asAny(hegel.Map(pairs(hegel.Integers(-5, 5), hegel.Integers(-5, 5)), func(p pair[int, int]) [2]hgPtrMarsh { return [2]hgPtrMarsh{{p.a}, {p.b}} })),
+		asAny(hegel.Map(many(hegel.Integers(-5, 5), 0, 3), func(vs []int) []hgPtrMarsh {
+			out := make([]hgPtrMarsh, len(vs))
+			for i, v := range vs {
+				out[i] = hgPtrMarsh{v}
+			}
+			return out
+		})),
+	)
+	// omitEmpties: a struct with a zero-length array under omitempty (the shape of
+	// go-json/15); under HEGEL_NO_KNOWN=1 one with arrays of elements only.
+	omitEmpties = shaped(
+		asAny(hegel.Composite(func(tc hegel.TestCase) hgOmitEmpty {
+			return hgOmitEmpty{A: hegel.Draw(tc, intPairs), S: hegel.Draw(tc, maybe(50, many(hegel.Integers(-5, 5), 0, 2))), X: hegel.Draw(tc, maybe(50, strs))}
+		})),
+		asAny(hegel.Composite(func(tc hegel.TestCase) hgOmitArrays {
+			return hgOmitArrays{A: hegel.Draw(tc, intPairs), S: hegel.Draw(tc, maybe(50, many(hegel.Integers(-5, 5), 0, 2))), X: hegel.Draw(tc, maybe(50, strs))}
+		})),
+	)
+	intPairs = hegel.Map(pairs(hegel.Integers(-5, 5), hegel.Integers(-5, 5)), func(p pair[int, int]) [2]int { return [2]int{p.a, p.b} })
+	// textPtrs: a pointer to a TextMarshaler at top level, nil half of the time (the shape of
+	// go-json/9); never nil under HEGEL_NO_KNOWN=1.
+	textPtrs = shaped(optional(50, hgTexts), ptrs(hgTexts))
+	// tops: a top-level value for the encoders from the whole universe: an interface{} tree
+	// twice in thirteen, a struct three times, a pointer to one, a slice of structs, a
+	// string-keyed and a TextMarshaler-keyed map, an array of Marshalers, a pointer to a
+	// TextMarshaler, an omitempty struct and an array of pointer Marshalers once each.
+	tops = weighted(
+		choice[any]{2, anyTrees3},
+		choice[any]{3, asAny(riches)},
+		choice[any]{1, asAny(ptrs(riches))},
+		choice[any]{1, asAny(innerLists)},
+		choice[any]{1, asAny(hegel.Map(hegel.Maps(mapKeys, inners).MaxSize(3), nonNilMap[string, hgInner]))},
+		choice[any]{1, asAny(hegel.Map(hegel.Maps(hgKeys, anyTrees1).MaxSize(3), nonNilMap[hgKey, any]))},
+		choice[any]{1, asAny(marshPairs)},
+		choice[any]{1, asAny(textPtrs)},
+		choice[any]{1, omitEmpties},
+		choice[any]{1, ptrMarshArrays},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Generators for JSON texts.
+//
+// A tree is nil | bool | jnum | string | []any | jobj; jnum is a number
+// literal kept verbatim, jobj is an ordered list of pairs (duplicates
+// allowed, rarely).  render writes a tree with the whitespace and escape
+// choices of a tape.  A jraw leaf is a string literal written as it is,
+// malformed or not (hegel_shapes_test.go builds them).
+
+type jnum string
+
+type jraw string
+
+type jpair struct {
+	k string
+	v any
+}
+
+type jobj []jpair
+
+const digits = "0123456789"
+
+func digitText(lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(digits).MinSize(lo).MaxSize(hi)
+}
+
+// numLit is a JSON number literal: an optional minus, the integer digits, a fraction and an
+// exponent (each "" when absent).
+type numLit struct {
+	neg              bool
+	whole, frac, exp string
+}
+
+func (l numLit) String() string {
+	var b strings.Builder
+	if l.neg {
+		b.WriteByte('-')
+	}
+	b.WriteString(l.whole)
+	if l.frac != "" {
+		b.WriteByte('.')
+		b.WriteString(l.frac)
+	}
+	b.WriteString(l.exp)
+	return b.String()
+}
+
+var (
+	// wholes: one digit two times in five, else up to twenty digits without a leading zero.
+	wholes = weighted(
+		choice[string]{40, hegel.Map(hegel.Integers(0, 9), strconv.Itoa)},
+		choice[string]{60, hegel.Map(pairs(hegel.Integers(1, 9), digitText(0, 19)), func(p pair[int, string]) string { return strconv.Itoa(p.a) + p.b })},
+	)
+	expMarks = hegel.SampledFrom([]string{"e", "E"})
+	expSigns = hegel.SampledFrom([]string{"", "+", "-"})
+	// expDigits: one or two digits, and by default three once in six (an exponent of 309 or
+	// more takes the literal out of float64 range, the shape of go-json/22); under
+	// HEGEL_NO_KNOWN=1 two at most, so every literal stays inside the range.
+	expDigits = shaped(weighted(choice[string]{5, digitText(1, 2)}, choice[string]{1, digitText(3, 3)}), digitText(1, 2))
+	exps      = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, expMarks) + hegel.Draw(tc, expSigns) + hegel.Draw(tc, expDigits)
+	})
+	// numLits: a valid JSON number literal: negative three times in ten, a fraction of up to
+	// six digits two times in five, an exponent three times in ten.
+	numLits = hegel.Composite(func(tc hegel.TestCase) string {
+		return numLit{
+			neg:   hegel.Draw(tc, chance(30)),
+			whole: hegel.Draw(tc, wholes),
+			frac:  hegel.Draw(tc, maybe(40, digitText(1, 6))),
+			exp:   hegel.Draw(tc, maybe(30, exps)),
+		}.String()
+	})
+	jnums = hegel.Map(numLits, func(l string) jnum { return jnum(l) })
+)
+
+// objEntry is a drawn member of an object: its key, or (once in ten, past the first member)
+// the key of an earlier member, pos modulo their count - a duplicate key, of which the last
+// wins.
+type objEntry struct {
+	key string
+	dup bool
+	pos int
+	v   any
+}
+
+func toObj(es []objEntry) jobj {
+	out := make(jobj, 0, len(es))
+	for i, e := range es {
+		k := e.key
+		if e.dup && i > 0 {
+			k = out[e.pos%i].k
+		}
+		out = append(out, jpair{k, e.v})
+	}
+	return out
+}
+
+// trees: a JSON tree with at most maxDepth levels of containers. A node is a leaf (null or
+// a bool once in ten each, a number or a string twice) three times in five, else an array
+// of up to four nodes or an object of up to four members once each; the depth counter lives
+// in the closure like anyTrees'.
+func trees(maxDepth int) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(jnums)},
+		choice[any]{2, asAny(textStrs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	entries := hegel.Composite(func(tc hegel.TestCase) objEntry {
+		return objEntry{key: hegel.Draw(tc, textStrs), dup: hegel.Draw(tc, chance(10)), pos: hegel.Draw(tc, positions), v: hegel.Draw(tc, child)}
+	})
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	objs := hegel.Map(many(entries, 0, 4), toObj)
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(objs)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var trees3, trees2, trees1 = trees(3), trees(2), trees(1)
+
+// ---------------------------------------------------------------------------
+// The writer: a pure function of a tree and a tape.
+
+var wsBytes = []byte{' ', ' ', '\t', '\n', '\r'}
+
+// ws is whitespace once in four: one to three of space (twice as likely), tab, newline and
+// return.
+func (t *tape) ws() string {
+	if !t.coin(25) {
+		return ""
+	}
+	n := 1 + t.next(3)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteByte(wsBytes[t.next(len(wsBytes))])
+	}
+	return b.String()
+}
+
+// hexEscape is the \u escape of u, in upper case three times in ten.
+func (t *tape) hexEscape(u uint16) string {
+	s := fmt.Sprintf("\\u%04x", u)
+	if t.coin(30) {
+		s = "\\u" + strings.ToUpper(s[2:])
+	}
+	return s
+}
+
+var shortEscapes = map[rune]string{'\b': `\b`, '\f': `\f`, '\n': `\n`, '\r': `\r`, '\t': `\t`}
+
+// writeString writes s as a JSON string literal with the tape's escape choices; with plain
+// set it uses no \u escapes except for control characters.
+func (t *tape) writeString(s string, b *strings.Builder, plain bool) {
+	b.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			if !plain && t.coin(50) {
+				b.WriteString(`\u0022`)
+			} else {
+				b.WriteString(`\"`)
+			}
+		case r == '\\':
+			if !plain && t.coin(50) {
+				b.WriteString(`\u005c`)
+			} else {
+				b.WriteString(`\\`)
+			}
+		case r < 0x20:
+			if e, ok := shortEscapes[r]; ok && t.coin(60) {
+				b.WriteString(e)
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		case r == '/' && !plain && t.coin(40):
+			b.WriteString(`\/`)
+		case r == '\ufffd' && !plain && t.coin(50):
+			// a lone low surrogate escape decodes to U+FFFD in both libraries
+			// (only low surrogates: two neighbours must never form a pair)
+			b.WriteString([]string{`\udc00`, `\uDFFF`}[t.next(2)])
+		case !plain && t.coin(12):
+			if r > 0xffff {
+				r1, r2 := (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00
+				b.WriteString(t.hexEscape(uint16(r1)))
+				b.WriteString(t.hexEscape(uint16(r2)))
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func (t *tape) write(v any, b *strings.Builder, plain bool) {
+	b.WriteString(t.ws())
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case jnum:
+		b.WriteString(string(x))
+	case jraw:
+		b.WriteString(string(x))
+	case string:
+		t.writeString(x, b, plain)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			t.write(e, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte(']')
+	case jobj:
+		b.WriteByte('{')
+		for i, p := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			b.WriteString(t.ws())
+			t.writeString(p.k, b, plain)
+			b.WriteString(t.ws())
+			b.WriteByte(':')
+			t.write(p.v, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("write: unexpected %T", v))
+	}
+}
+
+// render is tree as JSON text with the whitespace and escape choices of the tape (an empty
+// tape: no whitespace, the short escapes); with plain no optional \u escapes, with trailing
+// whitespace after the value.
+func render(tree any, tp []int, plain, trailing bool) string {
+	t := &tape{vals: tp}
+	var b strings.Builder
+	t.write(tree, &b, plain)
+	if trailing {
+		b.WriteString(t.ws())
+	}
+	return b.String()
+}
+
+// treeOf parses encoding/json's own encoding of a value into a tree (numbers kept verbatim)
+// whose objects' members are ordered by a rank the tape gives each (equal ranks, and so an
+// empty tape, keep the sorted order), so that it can be re-rendered with random formatting
+// and key order.
+func treeOf(canon []byte, ranks *tape) any {
+	d := std.NewDecoder(bytes.NewReader(canon))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		panic(fmt.Sprintf("treeOf: %v for %s", err, canon))
+	}
+	return ordered(v, ranks)
+}
+
+func ordered(v any, ranks *tape) any {
+	switch x := v.(type) {
+	case map[string]any:
+		ks := make([]string, 0, len(x))
+		for k := range x {
+			ks = append(ks, k)
+		}
+		sort.Strings(ks) // deterministic before the ranks apply
+		rank := make(map[string]int, len(ks))
+		for _, k := range ks {
+			rank[k] = ranks.next(100)
+		}
+		sort.SliceStable(ks, func(i, j int) bool { return rank[ks[i]] < rank[ks[j]] })
+		out := make(jobj, 0, len(ks))
+		for _, k := range ks {
+			out = append(out, jpair{k, ordered(x[k], ranks)})
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = ordered(e, ranks)
+		}
+		return out
+	case std.Number:
+		return jnum(x)
+	default:
+		return x
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs in a JSON text, named on a mismatch.
+
+var (
+	strictNumber  = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$`)
+	lenientNumber = regexp.MustCompile(`^-?([0-9]+|[0-9]*\.[0-9]*)([eE][+-]?[0-9]+)?$`)
+	numberBytes   = "0123456789.eE+-"
+)
+
+func isHex(c byte) bool { return strings.IndexByte("0123456789abcdefABCDEF", c) >= 0 }
+
+func isWS(c byte) bool { return c == ' ' || c == '\t' || c == '\n' || c == '\r' }
+
+// literalPrefix reports whether s is a proper, non-empty prefix of true, false or null.
+func literalPrefix(s string) bool {
+	for _, lit := range []string{"true", "false", "null"} {
+		if s != "" && len(s) < len(lit) && strings.HasPrefix(lit, s) {
+			return true
+		}
+	}
+	return false
+}
+
+// textShapes names the recorded bugs whose shape a JSON text (valid or not) has, for Valid,
+// Unmarshal, Compact and Indent: a NUL byte outside a string, which ends the input
+// (go-json/4); a number spelt leniently - a leading zero, a trailing dot, no digit before the
+// dot - (go-json/7; encoding/json rejects the text); a number that is well formed but outside
+// float64 range (go-json/22; encoding/json's Valid accepts it); a bare null in key position
+// (go-json/8); a comma or colon before the first value, a truncated literal at the end, or a
+// \u escape with four non-hex characters (go-json/10, which Valid inherits from the stream
+// decoder); a raw control character inside a string (go-json/11); a malformed escape
+// (go-json/12: Compact and Indent copy it through); a stray ] or } after a complete value
+// (go-json/24). Trailing whitespace (go-json/18) matters to Indent alone and is named there.
+func textShapes(s string) []string {
+	var shapes []string
+	has := map[string]bool{}
+	add := func(id string) {
+		if !has[id] {
+			has[id] = true
+			shapes = append(shapes, id)
+		}
+	}
+	in := false
+	first := true
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case in:
+			switch {
+			case c == '"':
+				in = false
+			case c == 0:
+				// a NUL inside a string ends the input for go-json and both reject the text
+			case c < 0x20:
+				add("go-json/11")
+			case c == '\\':
+				if i+1 >= len(s) {
+					continue
+				}
+				i++
+				e := s[i]
+				switch {
+				case e == 'u':
+					n, bad := 0, false
+					for n < 4 && i+1+n < len(s) && s[i+1+n] != '"' {
+						if !isHex(s[i+1+n]) {
+							bad = true
+						}
+						n++
+					}
+					if n < 4 {
+						add("go-json/12")
+					} else if bad {
+						add("go-json/10")
+						add("go-json/12")
+					}
+					i += n
+				case strings.IndexByte(`"\/bfnrt`, e) < 0:
+					add("go-json/12")
+				}
+			}
+		case c == '"':
+			in = true
+			first = false
+		case isWS(c):
+		case c == 0:
+			add("go-json/4")
+		case c == '-' || (c >= '0' && c <= '9'):
+			j := i
+			for j < len(s) && strings.IndexByte(numberBytes, s[j]) >= 0 {
+				j++
+			}
+			tok := s[i:j]
+			switch {
+			case strictNumber.MatchString(tok):
+				if _, err := strconv.ParseFloat(tok, 64); err != nil {
+					add("go-json/22")
+				}
+			case lenientNumber.MatchString(tok):
+				add("go-json/7")
+			}
+			i = j - 1
+			first = false
+		case (c == ',' || c == ':') && first:
+			add("go-json/10")
+			first = false
+		case c >= 'a' && c <= 'z':
+			j := i
+			for j < len(s) && s[j] >= 'a' && s[j] <= 'z' {
+				j++
+			}
+			tok := s[i:j]
+			if tok == "null" {
+				k := j
+				for k < len(s) && isWS(s[k]) {
+					k++
+				}
+				if k < len(s) && s[k] == ':' {
+					add("go-json/8")
+				}
+			}
+			if j == len(s) && literalPrefix(tok) {
+				add("go-json/10")
+			}
+			i = j - 1
+			first = false
+		default:
+			first = false
+		}
+	}
+	// a complete value followed by a stray closer (decided with the oracle's decoder)
+	d := std.NewDecoder(strings.NewReader(s))
+	var v any
+	if err := d.Decode(&v); err == nil {
+		// (InputOffset rather than Buffered: Go 1.27's Buffered is empty after
+		// some values even when input remains.)
+		rest := strings.TrimLeft(s[d.InputOffset():], " \t\n\r")
+		if rest != "" && (rest[0] == ']' || rest[0] == '}') {
+			add("go-json/24")
+		}
+	}
+	return shapes
+}
+
+// escapedKeyIn reports a \u escape inside a key of the text's top-level object (a struct
+// field's key): in a text of about 500 bytes or more the shape of go-json/25 (the stream
+// Decoder's struct key matcher reads the escape across its buffer refill).
+func escapedKeyIn(s string) bool {
+	in, escaped, depth := false, false, 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case !in:
+			switch c {
+			case '"':
+				in, escaped = true, false
+			case '{', '[':
+				depth++
+			case '}', ']':
+				depth--
+			}
+		case c == '"':
+			in = false
+			if escaped && depth == 1 {
+				k := i + 1
+				for k < len(s) && isWS(s[k]) {
+					k++
+				}
+				if k < len(s) && s[k] == ':' {
+					return true
+				}
+			}
+		case c == '\\':
+			if i+1 < len(s) && s[i+1] == 'u' {
+				escaped = true
+			}
+			i++
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs in a Go value, named on a mismatch of the encoders.
+
+var (
+	textMarshalerType = reflect.TypeOf((*interface{ MarshalText() ([]byte, error) })(nil)).Elem()
+	marshalerType     = reflect.TypeOf((*json.Marshaler)(nil)).Elem()
+)
+
+// keyOrderDiffers reports whether the string keys sort differently by key and by their
+// quoted, escaped encoding (with or without HTML escaping): the shape of go-json/14.
+func keyOrderDiffers(keys []string) bool {
+	if len(keys) < 2 {
+		return false
+	}
+	byKey := append([]string(nil), keys...)
+	sort.Strings(byKey)
+	for _, html := range []bool{true, false} {
+		enc := make(map[string]string, len(keys))
+		for _, k := range keys {
+			var b bytes.Buffer
+			e := std.NewEncoder(&b)
+			e.SetEscapeHTML(html)
+			_ = e.Encode(k)
+			enc[k] = b.String()
+		}
+		byEnc := append([]string(nil), keys...)
+		sort.Slice(byEnc, func(i, j int) bool { return enc[byEnc[i]] < enc[byEnc[j]] })
+		for i := range byKey {
+			if byKey[i] != byEnc[i] {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// marshalShapes names the recorded bugs whose shape a value has for the encoders: a float32
+// NaN or infinity (go-json/3); a nil pointer to a TextMarshaler at top level, in a slice or
+// as a map value (go-json/9; in a struct field it is written as null, correctly); a float of
+// either width in the exponent band (go-json/13); a string-keyed map whose keys sort
+// differently once escaped (go-json/14); a zero-length array under omitempty (go-json/15); a
+// non-addressable array of pointer-receiver Marshalers (go-json/16); a string holding U+0008
+// or U+000C (go-json/23); none for a plain value.
+func marshalShapes(v any) []string {
+	var shapes []string
+	has := map[string]bool{}
+	add := func(id string) {
+		if !has[id] {
+			has[id] = true
+			shapes = append(shapes, id)
+		}
+	}
+	var walk func(v reflect.Value, inField bool)
+	walk = func(v reflect.Value, inField bool) {
+		if !v.IsValid() {
+			return
+		}
+		switch v.Kind() {
+		case reflect.Float32:
+			f := v.Float()
+			if !isFinite(f) {
+				add("go-json/3")
+			} else if inExponentBand(f) {
+				add("go-json/13")
+			}
+		case reflect.Float64:
+			if inExponentBand(v.Float()) {
+				add("go-json/13")
+			}
+		case reflect.String:
+			if strings.ContainsAny(v.String(), "\b\f") {
+				add("go-json/23")
+			}
+		case reflect.Pointer:
+			if v.IsNil() {
+				if !inField && v.Type().Implements(textMarshalerType) {
+					add("go-json/9")
+				}
+				return
+			}
+			walk(v.Elem(), false)
+		case reflect.Interface:
+			if !v.IsNil() {
+				walk(v.Elem(), inField)
+			}
+		case reflect.Map:
+			var keys []string
+			it := v.MapRange()
+			for it.Next() {
+				if it.Key().Kind() == reflect.String {
+					keys = append(keys, it.Key().String())
+					if strings.ContainsAny(it.Key().String(), "\b\f") {
+						add("go-json/23")
+					}
+				}
+				walk(it.Value(), false)
+			}
+			if keyOrderDiffers(keys) {
+				add("go-json/14")
+			}
+		case reflect.Array:
+			elem := v.Type().Elem()
+			if !v.CanAddr() && elem.Kind() == reflect.Struct && !elem.Implements(marshalerType) && reflect.PointerTo(elem).Implements(marshalerType) {
+				add("go-json/16")
+			}
+			for i := 0; i < v.Len(); i++ {
+				walk(v.Index(i), false)
+			}
+		case reflect.Slice:
+			if v.Type().Elem().Kind() == reflect.Uint8 {
+				return // []byte and RawMessage
+			}
+			for i := 0; i < v.Len(); i++ {
+				walk(v.Index(i), false)
+			}
+		case reflect.Struct:
+			for i := 0; i < v.NumField(); i++ {
+				f := v.Type().Field(i)
+				if !f.IsExported() {
+					continue
+				}
+				if f.Type.Kind() == reflect.Array && f.Type.Len() == 0 && strings.Contains(f.Tag.Get("json"), ",omitempty") {
+					add("go-json/15")
+				}
+				walk(v.Field(i), true)
+			}
+		}
+	}
+	walk(reflect.ValueOf(v), false)
+	return shapes
+}
+
+// nonFiniteFloat32 reports whether a value holds a float32 NaN or infinity (go-json/3, the
+// one shape of the universe that breaks go-json's own round trip).
+func nonFiniteFloat32(v any) bool {
+	for _, s := range marshalShapes(v) {
+		if s == "go-json/3" {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Mutations of a JSON text.
+
+// structural: the bytes an edit deletes, duplicates or inserts: brackets, braces, commas,
+// colons, quotes, a space, letters of the literals, digits, signs, a dot, an exponent mark,
+// an x and a backslash; a tab too (inserted into a string it is the shape of go-json/11) and
+// a NUL (which ends the input for go-json, go-json/4), except under HEGEL_NO_KNOWN=1.
+var structural = shaped("[]{},:\" true0-+.eEx\\\t\x00", "[]{},:\" true0-+.eEx\\")
+
+type mutKind int
+
+const (
+	mutTruncate  mutKind = iota // cut the text at a rune boundary
+	mutDelete                   // delete one structural or whitespace byte
+	mutDuplicate                // duplicate one
+	mutInsert                   // insert a structural byte at a rune boundary
+)
+
+var mutKindNames = []string{"truncate", "delete", "duplicate", "insert"}
+
+// mutation is one structural edit of a JSON text: at is an index into the text (truncate,
+// insert) or into its structural and whitespace bytes (delete, duplicate), taken modulo the
+// live count when applied, so a second edit fits the text the first one left. Edits inside
+// a multi-byte character would leave invalid UTF-8, whose decoding the two libraries differ
+// on.
+type mutation struct {
+	kind mutKind
+	at   int
+	ch   byte
+}
+
+func (m mutation) String() string {
+	if m.kind == mutInsert {
+		return fmt.Sprintf("insert %q at %d", m.ch, m.at)
+	}
+	return fmt.Sprintf("%s at %d", mutKindNames[m.kind], m.at)
+}
+
+func runeBoundary(s string, i int) int {
+	for i < len(s) && !utf8.RuneStart(s[i]) {
+		i++
+	}
+	return i
+}
+
+func structuralIndices(s string) []int {
+	var idx []int
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(structural+" \t\n\r", s[i]) >= 0 {
+			idx = append(idx, i)
+		}
+	}
+	return idx
+}
+
+// mutationsOf: a mutation of s, each kind as often as the others, its index drawn against s.
+func mutationsOf(s string) hegel.Generator[mutation] {
+	bounds := hegel.Integers(0, len(s))
+	inIdx := hegel.Integers(0, max(len(structuralIndices(s))-1, 0))
+	return weighted(
+		choice[mutation]{1, hegel.Map(bounds, func(i int) mutation { return mutation{kind: mutTruncate, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDelete, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDuplicate, at: i} })},
+		choice[mutation]{1, hegel.Map(pairs(bounds, hegel.SampledFrom([]byte(structural))), func(p pair[int, byte]) mutation {
+			return mutation{kind: mutInsert, at: p.a, ch: p.b}
+		})},
+	)
+}
+
+func (m mutation) apply(s string) string {
+	switch m.kind {
+	case mutTruncate:
+		return s[:runeBoundary(s, m.at%(len(s)+1))]
+	case mutDelete, mutDuplicate:
+		idx := structuralIndices(s)
+		if len(idx) == 0 {
+			return s
+		}
+		i := idx[m.at%len(idx)]
+		if m.kind == mutDelete {
+			return s[:i] + s[i+1:]
+		}
+		return s[:i+1] + s[i:]
+	default:
+		i := runeBoundary(s, m.at%(len(s)+1))
+		return s[:i] + string(m.ch) + s[i:]
+	}
+}
+
+// applyAll applies the edits in turn.
+func applyAll(s string, edits []mutation) string {
+	for _, m := range edits {
+		s = m.apply(s)
+	}
+	return s
+}
+
+// ---------------------------------------------------------------------------
+// The rest of the harness.
+
+var indents = hegel.SampledFrom([]string{"", " ", "\t", "  ", "xx", "\n"})
+
+func short(b []byte) string {
+	s := string(b)
+	if len(s) > 300 {
+		return s[:300] + "..."
+	}
+	return s
+}
+
+// diffAt shows the first difference between two texts with some context.
+func diffAt(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := max(i-40, 0)
+	cut := func(s string) string {
+		if lo >= len(s) {
+			return ""
+		}
+		return s[lo:min(i+60, len(s))]
+	}
+	return fmt.Sprintf("at byte %d:\n   go-json       %q\n   encoding/json %q", i, cut(a), cut(b))
+}
+
+func stdJSON(v any) string {
+	b, err := std.Marshal(v)
+	if err != nil {
+		return "ERR:" + err.Error()
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Cases: one record per property, drawn once.
+
+// marshalCase: the value, MarshalIndent's prefix and indent, the Encoder's second value,
+// whether its HTML escaping is on, and whether and how it indents.
+type marshalCase struct {
+	v        any
+	prefix   string
+	indent   string
+	second   any
+	escape   bool
+	indented bool
+	prefix2  string
+	indent2  string
+}
+
+func (c marshalCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s\nprefix %q indent %q; second %s; escape=%v indented=%v prefix2 %q indent2 %q",
+		c.v, short([]byte(stdJSON(c.v))), c.prefix, c.indent, short([]byte(stdJSON(c.second))), c.escape, c.indented, c.prefix2, c.indent2)
+}
+
+var marshalCases = hegel.Composite(func(tc hegel.TestCase) marshalCase {
+	return marshalCase{
+		v:        hegel.Draw(tc, tops),
+		prefix:   hegel.Draw(tc, indents),
+		indent:   hegel.Draw(tc, indents),
+		second:   hegel.Draw(tc, anyTrees1),
+		escape:   hegel.Draw(tc, chance(50)),
+		indented: hegel.Draw(tc, chance(50)),
+		prefix2:  hegel.Draw(tc, indents),
+		indent2:  hegel.Draw(tc, indents),
+	}
+})
+
+// textCase: a tree of three levels and the tape of its rendering (with trailing whitespace).
+type textCase struct {
+	tree any
+	tape []int
+}
+
+func (c textCase) text() string { return render(c.tree, c.tape, false, true) }
+
+func (c textCase) GoString() string {
+	return fmt.Sprintf("text %q (tape of %d)", short([]byte(c.text())), len(c.tape))
+}
+
+var textCases = hegel.Composite(func(tc hegel.TestCase) textCase {
+	return textCase{tree: hegel.Draw(tc, trees3), tape: hegel.Draw(tc, tapes)}
+})
+
+// structCase: the value; a second value the decoders' targets are prefilled with two times
+// in five (encoding/json merges into it: a null clears a pointer, map, slice or interface,
+// an omitted member keeps the old value; a prefilled []byte met by null is the shape of
+// go-json/21, so under HEGEL_NO_KNOWN=1 the prefill's is nil); the ranks of the keys (a
+// tape: equal ranks keep the sorted order); an unknown member three times in ten, inserted
+// at a position modulo the member count; the coins that upper-case the keys once in five
+// (recycled over the members; encoding/json matches keys case-insensitively, go-json only for
+// structs of up to sixteen fields, go-json/5, so none under HEGEL_NO_KNOWN=1); and the tapes
+// of the two renderings.
+type structCase struct {
+	v       hgRich
+	prefill *hgRich
+	ranks   []int
+	unknown *any
+	at      int
+	upper   []bool
+	tape    []int
+	tape2   []int
+}
+
+// render is encoding/json's encoding of the value re-rendered twice: the tree in the drawn
+// key order, with the unknown member and the upper-cased keys, written with each tape; the
+// second rendering, for the stream Decoder, has no optional \u escapes under HEGEL_NO_KNOWN=1
+// (an escaped key across the Decoder's buffer refill is the shape of go-json/25). cased
+// reports whether a key changed.
+func (c structCase) render(canon []byte) (text, plain string, cased bool) {
+	tree := treeOf(canon, &tape{vals: c.ranks}).(jobj)
+	if c.unknown != nil {
+		at := c.at % (len(tree) + 1)
+		tree = append(tree[:at], append(jobj{{"zz_unknown", *c.unknown}}, tree[at:]...)...)
+	}
+	if len(c.upper) > 0 {
+		for i := range tree {
+			if up := strings.ToUpper(tree[i].k); c.upper[i%len(c.upper)] && up != tree[i].k {
+				tree[i].k = up
+				cased = true
+			}
+		}
+	}
+	return render(tree, c.tape, false, true), render(tree, c.tape2, Known.escapedKeyRefills, true), cased
+}
+
+// shapes names the recorded bugs whose shape the case has: an upper-cased key (go-json/5),
+// a prefilled []byte met by null (go-json/21), an escaped key in a Decoder text of about
+// 500 bytes or more (go-json/25).
+func (c structCase) shapes(plain string, cased bool) []string {
+	shapes := shapeIf(cased, "go-json/5")
+	shapes = append(shapes, shapeIf(c.prefill != nil && len(c.prefill.Bs) > 0 && c.v.Bs == nil, "go-json/21")...)
+	return append(shapes, shapeIf(len(plain) >= 490 && escapedKeyIn(plain), "go-json/25")...)
+}
+
+func (c structCase) GoString() string {
+	canon := stdJSON(c.v)
+	text, plain, _ := c.render([]byte(canon))
+	s := fmt.Sprintf("canonical: %s\ntext:      %s\nplain:     %s\nunknown=%v at %d, upper %v", short([]byte(canon)), short([]byte(text)), short([]byte(plain)), c.unknown != nil, c.at, c.upper)
+	if c.prefill != nil {
+		s += fmt.Sprintf("\nprefilled: %s", short([]byte(stdJSON(*c.prefill))))
+	}
+	return s
+}
+
+// prefills: the value a decoder's target holds before the decode, whose Bs is nil under
+// HEGEL_NO_KNOWN=1 (go-json/21).
+var prefills = hegel.Map(finiteRiches, func(r hgRich) hgRich {
+	if Known.nullIntoBytes {
+		r.Bs = nil
+	}
+	return r
+})
+
+var structCases = hegel.Composite(func(tc hegel.TestCase) structCase {
+	return structCase{
+		v:       hegel.Draw(tc, finiteRiches),
+		prefill: hegel.Draw(tc, optional(40, prefills)),
+		ranks:   hegel.Draw(tc, tapes),
+		unknown: hegel.Draw(tc, optional(30, trees1)),
+		at:      hegel.Draw(tc, positions),
+		upper:   hegel.Draw(tc, shaped(maybe(20, many(hegel.Booleans(), 1, 32)), hegel.Just([]bool(nil)))),
+		tape:    hegel.Draw(tc, tapes),
+		tape2:   hegel.Draw(tc, tapes),
+	}
+})
+
+// discarded reports whether an edited text is left out under HEGEL_NO_KNOWN=1: one with the
+// shape of a recorded bug (textShapes). The edit generator filters such edits out; the
+// property keeps the check as a guard.
+func discarded(m string) bool { return noKnown && len(textShapes(m)) > 0 }
+
+// validCase: a tree rendered with a tape (trailing whitespace half of the time by default,
+// the shape of go-json/18 for Indent; never under HEGEL_NO_KNOWN=1) and up to two edits of
+// the text, drawn against it and applied in turn.
+type validCase struct {
+	tree     any
+	tape     []int
+	trailing bool
+	text     string // the rendering
+	edits    []mutation
+}
+
+// edited is the text after its edits.
+func (c validCase) edited() string { return applyAll(c.text, c.edits) }
+
+func (c validCase) GoString() string {
+	s := fmt.Sprintf("text %q", short([]byte(c.text)))
+	if len(c.edits) > 0 {
+		s += fmt.Sprintf("; %v -> %q", c.edits, short([]byte(c.edited())))
+	}
+	return s
+}
+
+var validCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) validCase {
+	c := validCase{tree: hegel.Draw(tc, trees3), tape: hegel.Draw(tc, tapes), trailing: hegel.Draw(tc, shaped(chance(50), hegel.Just(false)))}
+	c.text = render(c.tree, c.tape, false, c.trailing)
+	return c
+}), func(c validCase) hegel.Generator[validCase] {
+	edits := many(mutationsOf(c.text), 0, 2)
+	if noKnown {
+		edits = hegel.Filter(edits, func(es []mutation) bool { return !discarded(applyAll(c.text, es)) })
+	}
+	return hegel.Map(edits, func(es []mutation) validCase {
+		c.edits = es
+		return c
+	})
+})
+
+// streamValue: a value of a stream: its tree of two levels, the tape of its rendering, and
+// the separator before it, kept seven times in ten; else written only when the two values
+// are not self-delimiting on both sides (e.g. "...]" then "{...", or "...}" then "[...").
+type streamValue struct {
+	tree    any
+	tape    []int
+	sep     string
+	keepSep bool
+}
+
+// streamCase: a lead before the first value (empty, or by default a comma or colon once in
+// eight, which go-json's stream decoder skips, go-json/10), one to four values, then garbage
+// three times in ten (else trailing whitespace once in eight).
+type streamCase struct {
+	lead    string
+	values  []streamValue
+	garbage string
+	trail   string
+}
+
+// render writes the stream.
+func (c streamCase) render() string {
+	var b strings.Builder
+	b.WriteString(c.lead)
+	for i, v := range c.values {
+		text := render(v.tree, v.tape, false, false)
+		if i > 0 {
+			prev := b.String()
+			next := strings.TrimLeft(text, " \t\r\n")
+			if v.keepSep || next == "" || !strings.ContainsRune("]}\"", rune(prev[len(prev)-1])) || !strings.ContainsRune("[{\"", rune(next[0])) {
+				b.WriteString(v.sep)
+			}
+		}
+		b.WriteString(text)
+	}
+	if c.garbage != "" {
+		b.WriteString(c.garbage)
+	} else {
+		b.WriteString(c.trail)
+	}
+	return b.String()
+}
+
+// shapes names the recorded bugs whose shape the stream has: a comma or colon before a value
+// (the lead, or a separator; go-json/10), garbage that is a truncated literal (go-json/10), a
+// stray closer (go-json/24) or a NUL byte (go-json/4).
+func (c streamCase) shapes() []string {
+	var shapes []string
+	punct := c.lead != ""
+	for _, v := range c.values[1:] {
+		punct = punct || strings.ContainsAny(v.sep, ",:")
+	}
+	g := strings.TrimSpace(c.garbage)
+	shapes = append(shapes, shapeIf(punct || literalPrefix(g), "go-json/10")...)
+	shapes = append(shapes, shapeIf(g == "]" || g == "}", "go-json/24")...)
+	return append(shapes, shapeIf(strings.Contains(c.garbage, "\x00"), "go-json/4")...)
+}
+
+func (c streamCase) GoString() string {
+	return fmt.Sprintf("stream %q (%d values, lead %q, garbage %q)", short([]byte(c.render())), len(c.values), c.lead, c.garbage)
+}
+
+var (
+	// garbageTails: what may follow a stream: a letter, a comma, a control character or a
+	// sign (syntax errors to both). An unterminated { or " is left out: after it More() at
+	// EOF was false in encoding/json before Go 1.25 and is true in today's, see the README's
+	// oracle caveat. By default also a stray closer (go-json/24), a truncated literal
+	// (go-json/10) and a NUL byte followed by more (go-json/4).
+	garbageTails = hegel.SampledFrom(shaped(
+		[]string{" x", ",", "\x01", " -", " ]", " }", " tru", " nul", " fals", " \x00 2", "\x00x"},
+		[]string{" x", ",", "\x01", " -"},
+	))
+	// separators: whitespace, and by default a comma or a colon between whitespace once in
+	// three (go-json/10).
+	separators = hegel.SampledFrom(shaped(
+		[]string{" ", "\n", "\t", " \r\n", " , ", " : "},
+		[]string{" ", "\n", "\t", " \r\n"},
+	))
+	leads        = shaped(maybe(12, hegel.SampledFrom([]string{",", ":", " ,", ": "})), hegel.Just(""))
+	wsRuns       = hegel.Map(many(hegel.SampledFrom(wsBytes), 1, 3), func(bs []byte) string { return string(bs) })
+	streamValues = hegel.Composite(func(tc hegel.TestCase) streamValue {
+		return streamValue{tree: hegel.Draw(tc, trees2), tape: hegel.Draw(tc, tapes), sep: hegel.Draw(tc, separators), keepSep: hegel.Draw(tc, chance(70))}
+	})
+	streamCases = hegel.Composite(func(tc hegel.TestCase) streamCase {
+		return streamCase{lead: hegel.Draw(tc, leads), values: hegel.Draw(tc, many(streamValues, 1, 4)), garbage: hegel.Draw(tc, maybe(30, garbageTails)), trail: hegel.Draw(tc, maybe(12, wsRuns))}
+	})
+)
+
+// roundTripCase: an interface{} tree two times in five, else a struct of the universe.
+type roundTripCase struct{ v any }
+
+func (c roundTripCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s", c.v, short([]byte(stdJSON(c.v))))
+}
+
+var roundTripCases = hegel.Map(weighted(
+	choice[any]{2, anyTrees3},
+	choice[any]{3, asAny(riches)},
+), func(v any) roundTripCase { return roundTripCase{v} })
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// Marshal, MarshalIndent and Encoder produce byte-for-byte what encoding/json
+// produces, for random values from the whole universe, with and without HTML
+// escaping and indentation. The universe draws the shapes of go-json/3, /9,
+// /13, /14, /15, /16 and /23 at their natural rates (marshalShapes), so this
+// property fails while any of them is open.
+func TestHegelMarshalMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, marshalCases)
+		v := c.v
+		shapes := marshalShapes(v)
+
+		g, ge := json.Marshal(v)
+		w, we := std.Marshal(v)
+		if (ge == nil) != (we == nil) {
+			mismatch(ht, shapes, "Marshal error mismatch: go-json %v, encoding/json %v", ge, we)
+		}
+		if string(g) != string(w) {
+			mismatch(ht, shapes, "Marshal differs %s", diffAt(string(g), string(w)))
+		}
+
+		gi, gie := json.MarshalIndent(v, c.prefix, c.indent)
+		wi, wie := std.MarshalIndent(v, c.prefix, c.indent)
+		if (gie == nil) != (wie == nil) || string(gi) != string(wi) {
+			mismatch(ht, shapes, "MarshalIndent(%q, %q) differs (%v, %v) %s", c.prefix, c.indent, gie, wie, diffAt(string(gi), string(wi)))
+		}
+
+		var gb, wb bytes.Buffer
+		genc, wenc := json.NewEncoder(&gb), std.NewEncoder(&wb)
+		genc.SetEscapeHTML(c.escape)
+		wenc.SetEscapeHTML(c.escape)
+		if c.indented {
+			genc.SetIndent(c.prefix2, c.indent2)
+			wenc.SetIndent(c.prefix2, c.indent2)
+		}
+		second := c.second
+		both := append(shapes, marshalShapes(second)...)
+		for _, x := range []any{v, second} {
+			ge, we := genc.Encode(x), wenc.Encode(x)
+			if (ge == nil) != (we == nil) {
+				mismatch(ht, both, "Encoder.Encode error mismatch: go-json %v, encoding/json %v", ge, we)
+			}
+		}
+		if gb.String() != wb.String() {
+			mismatch(ht, both, "Encoder output differs (escapeHTML=%v) %s", c.escape, diffAt(gb.String(), wb.String()))
+		}
+
+		// MarshalWithOption(DisableHTMLEscape) is the package-level spelling of
+		// SetEscapeHTML(false).
+		if we == nil {
+			opt, err := json.MarshalWithOption(v, json.DisableHTMLEscape())
+			var ref bytes.Buffer
+			enc := std.NewEncoder(&ref)
+			enc.SetEscapeHTML(false)
+			_ = enc.Encode(v)
+			want := strings.TrimSuffix(ref.String(), "\n")
+			if err != nil || string(opt) != want {
+				mismatch(ht, shapes, "MarshalWithOption(DisableHTMLEscape) differs (%v) %s", err, diffAt(string(opt), want))
+			}
+		}
+	})
+}
+
+// interfaceDecodesLike judges one text encoding/json accepts: Unmarshal into interface{}
+// and Decoder.UseNumber give exactly the value encoding/json gives (reflect.DeepEqual, and
+// the re-encoding, since DeepEqual takes -0 and +0 for equal), and Valid accepts it. A text
+// encoding/json rejects (a number outside float64 range) both must reject, the verdict of
+// the case.
+func interfaceDecodesLike(ht *hegel.T, text string, shapes []string) {
+	var g, w any
+	ge := json.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if we != nil {
+		if ge == nil {
+			mismatch(ht, shapes, "go-json accepts a text encoding/json rejects (%v)", we)
+		}
+		return
+	}
+	if ge != nil {
+		mismatch(ht, shapes, "go-json rejects a valid text: %v", ge)
+	}
+	if !reflect.DeepEqual(g, w) || stdJSON(g) != stdJSON(w) {
+		mismatch(ht, shapes, "Unmarshal into interface{} differs:\n go-json       %#v\n encoding/json %#v", g, w)
+	}
+
+	gd, wd := json.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+	gd.UseNumber()
+	wd.UseNumber()
+	var gn, wn any
+	ge, we = gd.Decode(&gn), wd.Decode(&wn)
+	if ge != nil || we != nil {
+		mismatch(ht, shapes, "UseNumber decode errors: go-json %v, encoding/json %v", ge, we)
+	}
+	if !reflect.DeepEqual(gn, wn) {
+		mismatch(ht, shapes, "UseNumber decode differs:\n go-json       %#v\n encoding/json %#v", gn, wn)
+	}
+	if !json.Valid([]byte(text)) {
+		mismatch(ht, shapes, "Valid is false for a text Unmarshal accepted: %q", short([]byte(text)))
+	}
+}
+
+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, textCases)
+		text := c.text()
+		interfaceDecodesLike(ht, text, textShapes(text))
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (into a fresh target, and back to the original
+// encoding, or into a prefilled one), and DisallowUnknownFields rejects exactly
+// the texts with an unknown key. The case draws upper-cased keys (go-json/5), a
+// prefilled []byte met by null (go-json/21), escaped keys in a long Decoder
+// text (go-json/25) and a Number outside float64 range (go-json/26) at their
+// natural rates, so this property fails while any of them is open.
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, structCases)
+		v := c.v
+		ht.Assume(!(Known.numberIntoNumber && outOfRange(v.N)))
+		canon, err := std.Marshal(v)
+		if err != nil {
+			fail(ht, "encoding/json cannot encode the generated value: %v", err)
+		}
+		text, plain, cased := c.render(canon)
+		shapes := append(c.shapes(plain, cased), shapeIf(outOfRange(v.N), "go-json/26")...)
+		unknown := c.unknown != nil
+
+		var a, b hgRich
+		if c.prefill != nil {
+			a, b = *c.prefill, *c.prefill
+		}
+		ea, eb := json.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+		if eb != nil {
+			fail(ht, "encoding/json rejects its own re-rendered encoding: %v", eb)
+		}
+		if ea != nil {
+			mismatch(ht, shapes, "go-json rejects the text: %v", ea)
+		}
+		ja, jb := stdJSON(a), stdJSON(b)
+		if ja != jb {
+			mismatch(ht, shapes, "decoded structs differ %s\n text %q", diffAt(ja, jb), short([]byte(text)))
+		}
+		// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+		// out of the comparison with the original encoding (which holds for
+		// a fresh target; a prefilled one keeps its omitted members).
+		v.R, a.R = nil, nil
+		canonNoRaw := stdJSON(v)
+		if c.prefill == nil && stdJSON(a) != canonNoRaw {
+			mismatch(ht, shapes, "round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+		}
+
+		// The stream Decoder gets the same tree rendered again.
+		var da, db hgRich
+		gd, wd := json.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+		gd.DisallowUnknownFields()
+		wd.DisallowUnknownFields()
+		ea, eb = gd.Decode(&da), wd.Decode(&db)
+		if (eb != nil) != unknown {
+			fail(ht, "encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+		}
+		if (ea != nil) != unknown {
+			mismatch(ht, shapes, "go-json DisallowUnknownFields: unknown key present=%v but err=%v\n text %q", unknown, ea, short([]byte(plain)))
+		}
+		da.R = nil
+		if !unknown && stdJSON(da) != canonNoRaw {
+			mismatch(ht, shapes, "Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+		}
+	})
+}
+
+// validAgrees judges one text, valid or not: Valid, Compact and Indent agree with
+// encoding/json on the verdict and on the output. Oracle caveat: Go 1.27.1's
+// encoding/json.Indent loops forever on some invalid inputs (a ~470-byte mutated text with
+// prefix "\n" and an empty indent, quoted in the README), so it is only run on texts it
+// considers valid; for the others its contract is simply an error.
+func validAgrees(ht *hegel.T, text, prefix, indent string, shapes []string) {
+	gv, wv := json.Valid([]byte(text)), std.Valid([]byte(text))
+	if gv != wv {
+		mismatch(ht, shapes, "Valid differs: go-json %v, encoding/json %v: %q", gv, wv, short([]byte(text)))
+	}
+
+	var gb, wb bytes.Buffer
+	ge, we := json.Compact(&gb, []byte(text)), std.Compact(&wb, []byte(text))
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shapes, "Compact error mismatch: go-json %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+	}
+	if we == nil && gb.String() != wb.String() {
+		mismatch(ht, shapes, "Compact differs %s", diffAt(gb.String(), wb.String()))
+	}
+
+	gb.Reset()
+	wb.Reset()
+	ge = json.Indent(&gb, []byte(text), prefix, indent)
+	if !wv {
+		if ge == nil {
+			mismatch(ht, shapes, "Indent accepts a text encoding/json rejects: %q -> %q", short([]byte(text)), short(gb.Bytes()))
+		}
+		return
+	}
+	if ge != nil {
+		mismatch(ht, shapes, "Indent rejects a valid text: %v: %q", ge, short([]byte(text)))
+	}
+	if indentOracleBroken(text, prefix, indent) {
+		return
+	}
+	we = std.Indent(&wb, []byte(text), prefix, indent)
+	if we != nil || gb.String() != wb.String() {
+		mismatch(ht, shapes, "Indent(%q, %q) differs (%v) %s", prefix, indent, we, diffAt(gb.String(), wb.String()))
+	}
+}
+
+// indentOracleBroken reports the inputs on which Go 1.27.1's encoding/json.Indent is wrong
+// or never returns (v2_indent.go, the placeholder replacement of a prefix or indent with
+// characters other than space and tab): when the trailing whitespace of the text has a
+// newline followed by spaces, the spaces are overwritten with copies of the prefix and
+// indent, and with an empty indent the loop doing it never ends (Indent(&b, "null\n  ",
+// "\n", "") hangs). Only the trailing whitespace is affected: the lines of the formatted
+// value begin with exactly the placeholders. The Indent comparison is skipped there; Valid
+// and Compact are still compared.
+func indentOracleBroken(text, prefix, indent string) bool {
+	placeholders := strings.Trim(prefix, " \t") != "" || strings.Trim(indent, " \t") != ""
+	trailing := text[len(strings.TrimRight(text, " \t\n\r")):]
+	return placeholders && strings.Contains(trailing, "\n")
+}
+
+// indentCases: a text case and Indent's prefix and indent.
+type indentCase struct {
+	validCase
+	prefix, indent string
+}
+
+var indentCases = hegel.Composite(func(tc hegel.TestCase) indentCase {
+	return indentCase{validCase: hegel.Draw(tc, validCases), prefix: hegel.Draw(tc, indents), indent: hegel.Draw(tc, indents)}
+})
+
+// Valid, Compact and Indent agree with encoding/json on random valid texts and
+// on texts with up to two structural edits (which are usually invalid). The
+// edits draw the shapes of go-json/4, /7, /8, /10, /11, /12, /22 and /24, and the
+// trailing whitespace that of go-json/18, at their natural rates (textShapes),
+// so this property fails while any of them is open.
+func TestHegelValidCompactIndentMatchEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indentCases)
+		text := c.edited()
+		if discarded(text) {
+			text = c.text // the generator filtered the discarded shapes out; this is the guard
+		}
+		// trailing whitespace after a valid value is the shape of go-json/18 for Indent
+		shapes := append(textShapes(text), shapeIf(strings.TrimRight(text, " \t\n\r") != text && std.Valid([]byte(text)), "go-json/18")...)
+		validAgrees(ht, text, c.prefix, c.indent, shapes)
+	})
+}
+
+// A Decoder reading a stream of values (optionally after a lead and followed by
+// garbage) yields the same values, errors, More() answers and Token() sequence
+// as encoding/json's Decoder. The stream draws a comma or colon before a value
+// and a truncated literal (go-json/10), a stray closer (go-json/24) and a NUL
+// byte (go-json/4) at their natural rates, so this property fails while any of
+// them is open.
+func TestHegelDecoderStreamMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, streamCases)
+		stream := c.render()
+		shapes := c.shapes()
+		k := len(c.values)
+
+		gd, wd := json.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+		for i := 0; i <= k; i++ {
+			var gv, wv any
+			ge, we := gd.Decode(&gv), wd.Decode(&wv)
+			if (ge == nil) != (we == nil) {
+				mismatch(ht, shapes, "Decode #%d error mismatch: go-json %v, encoding/json %v: %q", i, ge, we, short([]byte(stream)))
+			}
+			if we != nil {
+				break
+			}
+			if !reflect.DeepEqual(gv, wv) {
+				mismatch(ht, shapes, "Decode #%d differs:\n go-json       %#v\n encoding/json %#v\n stream %q", i, gv, wv, short([]byte(stream)))
+			}
+			if gm, wm := gd.More(), wd.More(); gm != wm {
+				mismatch(ht, shapes, "More() after value #%d: go-json %v, encoding/json %v: %q", i, gm, wm, short([]byte(stream)))
+			}
+		}
+
+		gd, wd = json.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+		for i := 0; i < 400; i++ {
+			gt, ge := gd.Token()
+			wt, we := wd.Token()
+			if (ge == nil) != (we == nil) {
+				mismatch(ht, shapes, "Token #%d error mismatch: go-json %v (%v), encoding/json %v (%v): %q", i, gt, ge, wt, we, short([]byte(stream)))
+			}
+			if we != nil {
+				break
+			}
+			if !reflect.DeepEqual(gt, wt) {
+				mismatch(ht, shapes, "Token #%d differs: go-json %#v, encoding/json %#v: %q", i, gt, wt, short([]byte(stream)))
+			}
+			if gm, wm := gd.More(), wd.More(); gm != wm {
+				mismatch(ht, shapes, "More() after token #%d (%v): go-json %v, encoding/json %v: %q", i, wt, gm, wm, short([]byte(stream)))
+			}
+		}
+	})
+}
+
+// go-json on its own: Unmarshal(Marshal(v)) re-encodes to the same bytes, for
+// the struct universe and for interface{} trees. A float32 NaN or infinity is
+// written as a bare token that does not read back (go-json/3), so this property
+// fails while that is open.
+func TestHegelMarshalUnmarshalRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, roundTripCases)
+		switch v := c.v.(type) {
+		case hgRich:
+			ht.Assume(!(Known.numberIntoNumber && outOfRange(v.N)))
+			shapes := append(shapeIf(nonFiniteFloat32(v), "go-json/3"), shapeIf(outOfRange(v.N), "go-json/26")...)
+			text, err := json.Marshal(v)
+			if err != nil {
+				mismatch(ht, shapes, "Marshal: %v", err)
+			}
+			var back hgRich
+			if err := json.Unmarshal(text, &back); err != nil {
+				mismatch(ht, shapes, "Unmarshal of Marshal output: %v\n text %s", err, short(text))
+			}
+			again, err := json.Marshal(back)
+			if err != nil || string(again) != string(text) {
+				mismatch(ht, shapes, "round trip differs (%v) %s", err, diffAt(string(text), string(again)))
+			}
+		default:
+			text, err := json.Marshal(v)
+			if err != nil {
+				fail(ht, "Marshal: %v", err)
+			}
+			var back any
+			if err := json.Unmarshal(text, &back); err != nil {
+				fail(ht, "Unmarshal of Marshal output: %v\n text %s", err, short(text))
+			}
+			if !reflect.DeepEqual(v, back) {
+				fail(ht, "round trip differs:\n original %#v\n back     %#v", v, back)
+			}
+		}
+	})
+}
