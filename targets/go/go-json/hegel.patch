+// ---------------------------------------------------------------------------
+// go-json/15: omitempty and zero-length arrays.
+
+// omitempty omits a zero-length array like every other empty value, as in encoding/json
+// (go-json writes it, go-json/15).
+func TestHegelOmitEmptyOmitsZeroLengthArrays(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, omitEmpties), known("go-json/15"))
+	})
+}
