+		text:   hegel.Draw(tc, shaped(hegel.Just("null"), hegel.Map(hegel.Binary(0, 4), func(b []byte) string { return `"` + base64.StdEncoding.EncodeToString(b) + `"` }))),
+		nested: hegel.Draw(tc, chance(50)),
