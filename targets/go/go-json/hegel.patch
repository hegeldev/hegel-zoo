+// go-json/7: the number grammar is lenient: leading zeros ("01", "00",
+// "-01"), a trailing dot ("1.", "0.", "1.e5") and a lone "-" (into an
+// integer) are accepted.
+func TestHegelPinNumberGrammarIsStrict(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"01", "00", "-01", "1.", "0.", "1.e5", "[01]", `{"a":1.}`} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %q as %v (encoding/json rejects it)", text, v)
+		}
+		if json.Valid([]byte(text)) {
+			t.Fatalf("Valid accepted %q", text)
+		}
+	}
