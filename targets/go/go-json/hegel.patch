+// ---------------------------------------------------------------------------
+// go-json/14: map key order.
+
+// keyPairCase: two map keys that sort one way as strings and the other way once quoted and
+// escaped (the shape of go-json/14: a shared stem followed by > and ?, a newline and a space,
+// nothing and a space, < and =, a quote and #) or, under HEGEL_NO_KNOWN=1, two keys of the
+// plain alphabet.
+type keyPairCase struct {
+	stem string
+	form int
+	k1   string
+	k2   string
+}
+
+var keyPairForms = [][2]string{{">", "?"}, {"\n", " "}, {"", " "}, {"<", "="}, {`"`, "#"}, {"&", "'"}}
+
+func (c keyPairCase) keys() (string, string) {
+	if noKnown {
+		return c.k1, c.k2
+	}
+	f := keyPairForms[c.form%len(keyPairForms)]
+	return c.stem + f[0], c.stem + f[1]
+}
+
+func (c keyPairCase) value() map[string]int {
+	a, b := c.keys()
+	return map[string]int{a: 1, b: 2}
+}
+
+func (c keyPairCase) GoString() string { return fmt.Sprintf("%#v", c.value()) }
+
+var keyPairCases = hegel.Composite(func(tc hegel.TestCase) keyPairCase {
+	plain := hegel.Text().Alphabet(keyAlphabet).MinSize(1).MaxSize(4)
+	return keyPairCase{
+		stem: hegel.Draw(tc, hegel.Text().Alphabet(keyAlphabet).MaxSize(3)),
+		form: hegel.Draw(tc, hegel.Integers(0, len(keyPairForms)-1)),
+		k1:   hegel.Draw(tc, plain),
+		k2:   hegel.Draw(tc, plain),
+	}
+})
+
+// Map keys are written in the order of the keys themselves, as in encoding/json (go-json
+// sorts them by their quoted, escaped encoding, go-json/14).
+func TestHegelMapKeysSortByKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, keyPairCases).value(), known("go-json/14"))
+	})
+}
