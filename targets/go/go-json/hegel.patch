+// go-json/11: raw control characters (U+0000..U+001F) inside a string are
+// accepted by Unmarshal, Valid, Compact and Indent; RFC 8259 and encoding/json
+// require them to be escaped.
+func TestHegelPinRawControlCharactersInStringsAreRejected(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"\"\x01\"", "\"a\nb\"", "[\"\x1f\"]", "{\"k\x02\":1}"} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal accepted %q as %q", text, v)
