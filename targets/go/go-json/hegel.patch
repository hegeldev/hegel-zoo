+// ---------------------------------------------------------------------------
+// go-json/16: pointer-receiver Marshalers in arrays.
+
+// ptrMarshCases: pointer-receiver Marshalers in a non-addressable array, bare or as a struct
+// field (the shape of go-json/16) or, under HEGEL_NO_KNOWN=1, in a slice or behind a pointer
+// to the array, where the elements are addressable.
+var ptrMarshCases = hegel.Map(pairs(pairs(hegel.Integers(-5, 5), hegel.Integers(-5, 5)), chance(50)), func(p pair[pair[int, int], bool]) any {
+	arr := [2]hgPtrMarsh{{p.a.a}, {p.a.b}}
+	if noKnown {
+		if p.b {
+			return &arr
+		}
+		return arr[:]
+	}
+	if p.b {
+		return struct{ A [2]hgPtrMarsh }{arr}
+	}
+	return arr
+})
+
+// The elements of a non-addressable array of pointer-receiver Marshalers are encoded from
+// their fields, as in encoding/json (go-json calls the pointer method, go-json/16).
+func TestHegelNonAddressableArrayElementsEncodeTheirFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, ptrMarshCases), known("go-json/16"))
+	})
+}
