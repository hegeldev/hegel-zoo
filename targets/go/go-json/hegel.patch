+package json_test
+
+// One property per recorded bug (bugs.toml), each drawing the shape region of its bug and
+// nothing else, so that it fails deterministically while the bug is open and names it
+// (STYLE.md rule 11); under HEGEL_NO_KNOWN=1 each draws the neighbouring region instead and
+// must pass. The pins in hegel_pins_test.go stay beside them as the regression examples.
+
+import (
+	"bytes"
+	"encoding/base64"
+	std "encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	json "github.com/goccy/go-json"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Helpers of the narrow properties.
+
+// decodesLike judges Unmarshal of one text into a target of type T holding init in both
+// libraries: the same error presence and the same value (DeepEqual and the re-encoding) when
+// encoding/json decoded the text or stopped at a type error (it fills the rest, go-json/19);
+// after a syntax error the target's state is not part of the contract (encoding/json checks
+// the syntax before it writes anything, go-json writes as it reads).
+func decodesLike[T any](ht *hegel.T, text string, init T, shapes []string) {
+	g, w := init, init
+	ge := json.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shapes, "Unmarshal %q into %T: go-json %v, encoding/json %v (values %s / %s)", short([]byte(text)), init, ge, we, stdJSON(g), stdJSON(w))
+	}
+	var typeErr *std.UnmarshalTypeError
+	if we != nil && !errors.As(we, &typeErr) {
+		return
+	}
+	if !reflect.DeepEqual(g, w) || stdJSON(g) != stdJSON(w) {
+		mismatch(ht, shapes, "Unmarshal %q into %T differs:\n go-json       %s (%+v)\n encoding/json %s (%+v)", short([]byte(text)), init, stdJSON(g), g, stdJSON(w), w)
+	}
+}
+
+// marshalsLike judges Marshal of one value in both libraries: the same error presence and
+// the same bytes.
+func marshalsLike(ht *hegel.T, v any, shapes []string) {
+	g, ge := json.Marshal(v)
+	w, we := std.Marshal(v)
+	if (ge == nil) != (we == nil) || string(g) != string(w) {
+		mismatch(ht, shapes, "Marshal(%T) differs: go-json %q (%v), encoding/json %q (%v)", v, short(g), ge, short(w), we)
+	}
+}
+
+// contexts: where a literal is embedded in a JSON text: at top level, as the element of an
+// array, as the value of a member, or between other elements.
+var contexts = hegel.Integers(0, 3)
+
+var contextForms = []string{"%s", "[%s]", `{"k":%s}`, `[1,%s,"s"]`}
+
+func embedded(kind int, lit string) string {
+	return fmt.Sprintf(contextForms[kind%len(contextForms)], lit)
+}
+
+// plainTexts: a tree of one level rendered compactly, the value a stray tail is appended to.
+var plainTexts = hegel.Map(trees1, func(tree any) string { return render(tree, nil, true, false) })
+
+// hexDigits and nonHex: the four characters of a \u escape, valid or (the shape of
+// go-json/10 and /12) not.
+var (
+	hexDigits = hegel.Text().Alphabet("0123456789abcdefABCDEF").MinSize(4).MaxSize(4)
+	nonHex    = hegel.Text().Alphabet("ghijklmnopqrstuvwxyzGHZ!#$%&()*+,-.:;<=>?@[]^_`{|}~ ").MinSize(4).MaxSize(4)
+)
+
+// words: a string body of a few ASCII letters, digits and spaces, without characters that
+// need escaping; smallInts: a member value.
+var (
+	words     = hegel.Text().Alphabet("abcxyzABCXYZ0189 ").MaxSize(4)
+	smallInts = hegel.Integers(0, 99)
+)
+
+// ---------------------------------------------------------------------------
+// go-json/1: null into a TextUnmarshaler.
+
+// firstWordCase: a TextUnmarshaler value whose first word is an int, and the text decoded
+// into it: null (the shape of go-json/1: go-json zeroes the first word) or, under
+// HEGEL_NO_KNOWN=1, a string (UnmarshalText sets A to 42); at top level or as the member of
+// a struct.
+type firstWordCase struct {
+	v      hgFirstWord
+	text   string
+	nested bool
+}
+
+var firstWordCases = hegel.Composite(func(tc hegel.TestCase) firstWordCase {
+	return firstWordCase{
+		v:      hgFirstWord{A: hegel.Draw(tc, hegel.Integers(1, 1000)), B: hegel.Draw(tc, hegel.Integers(1, 1000))},
+		text:   hegel.Draw(tc, shaped(hegel.Just("null"), hegel.Map(words, strconv.Quote))),
+		nested: hegel.Draw(tc, chance(50)),
+	}
+})
+
+// A null decoded into a TextUnmarshaler value leaves it as it was, like encoding/json (in
+// go-json it zeroes the value's first word, go-json/1).
+func TestHegelNullIntoTextUnmarshalerKeepsTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, firstWordCases)
+		if c.nested {
+			type holder struct {
+				T hgFirstWord `json:"t"`
+				N int         `json:"n"`
+			}
+			decodesLike(ht, `{"t":`+c.text+`,"n":5}`, holder{T: c.v, N: 1}, known("go-json/1"))
+			return
+		}
+		decodesLike(ht, c.text, c.v, known("go-json/1"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/2: integers and floats out of range.
+
+// rangeCase: a number literal and the target it is decoded into (int64, uint64, a quoted
+// int64, float32): outside the target's range (the shape of go-json/2: go-json wraps or gives
+// an infinity without an error) or, under HEGEL_NO_KNOWN=1, inside it.
+type rangeCase struct {
+	text  string
+	check func(ht *hegel.T)
+}
+
+func (c rangeCase) GoString() string { return fmt.Sprintf("literal %s", c.text) }
+
+func intoInt64(text string) rangeCase {
+	return rangeCase{text, func(ht *hegel.T) { decodesLike(ht, text, int64(0), known("go-json/2")) }}
+}
+
+func intoUint64(text string) rangeCase {
+	return rangeCase{text, func(ht *hegel.T) { decodesLike(ht, text, uint64(0), known("go-json/2")) }}
+}
+
+func intoQuotedInt64(text string) rangeCase {
+	type quoted struct {
+		N int64 `json:"n,string"`
+	}
+	return rangeCase{text, func(ht *hegel.T) { decodesLike(ht, `{"n":"`+text+`"}`, quoted{}, known("go-json/2")) }}
+}
+
+func intoFloat32(text string) rangeCase {
+	return rangeCase{text, func(ht *hegel.T) { decodesLike(ht, text, float32(0), known("go-json/2")) }}
+}
+
+var (
+	aboveInt64 = hegel.Map(hegel.Integers[uint64](1<<63, math.MaxUint64), func(u uint64) string { return strconv.FormatUint(u, 10) })
+	belowInt64 = hegel.Map(hegel.Integers[uint64](1<<63+1, math.MaxUint64), func(u uint64) string { return "-" + strconv.FormatUint(u, 10) })
+	// aboveUint64: twenty-one digits or so: a uint64 followed by a digit.
+	aboveUint64 = hegel.Map(pairs(hegel.Integers[uint64](1<<63, math.MaxUint64), hegel.Integers(0, 9)), func(p pair[uint64, int]) string {
+		return strconv.FormatUint(p.a, 10) + strconv.Itoa(p.b)
+	})
+	aboveFloat32 = hegel.Map(pairs(hegel.Integers(35, 99), hegel.Integers(38, 300)), func(p pair[int, int]) string { return fmt.Sprintf("%d.%de%d", p.a/10, p.a%10, p.b) })
+	int64Lits    = hegel.Map(int64s, func(i int64) string { return strconv.FormatInt(i, 10) })
+	uint64Lits   = hegel.Map(uint64s, func(u uint64) string { return strconv.FormatUint(u, 10) })
+	float32Lits  = hegel.Map(finiteFloat32s, func(f float32) string { return strconv.FormatFloat(float64(f), 'g', -1, 32) })
+	rangeCases   = weighted(
+		choice[rangeCase]{1, hegel.Map(shaped(aboveInt64, int64Lits), intoInt64)},
+		choice[rangeCase]{1, hegel.Map(shaped(belowInt64, int64Lits), intoInt64)},
+		choice[rangeCase]{1, hegel.Map(shaped(aboveUint64, uint64Lits), intoUint64)},
+		choice[rangeCase]{1, hegel.Map(shaped(aboveInt64, int64Lits), intoQuotedInt64)},
+		choice[rangeCase]{1, hegel.Map(shaped(aboveFloat32, float32Lits), intoFloat32)},
+	)
+)
+
+// A number outside the range of its integer or float32 target is an error, as in
+// encoding/json (go-json wraps integers and gives float32 an infinity, go-json/2).
+func TestHegelNumbersOutOfRangeAreAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		hegel.Draw(ht, rangeCases).check(ht)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/3: non-finite float32.
+
+// float32Holder: a float32 in a struct, a slice or a map, the ways a value reaches Marshal.
+type float32Holder struct {
+	F float32 `json:"f"`
+}
+
+var (
+	nonFinite32s = hegel.SampledFrom([]float32{float32(math.NaN()), float32(math.Inf(1)), float32(math.Inf(-1))})
+	float32Cases = hegel.Map(pairs(shaped(nonFinite32s, finiteFloat32s), hegel.Integers(0, 2)), func(p pair[float32, int]) any {
+		return []any{float32Holder{p.a}, []float32{p.a}, map[string]float32{"f": p.a}}[p.b]
+	})
+)
+
+// Marshal of a float32 NaN or infinity is an error, as in encoding/json (go-json writes a
+// bare NaN, +Inf or -Inf token, go-json/3).
+func TestHegelNonFiniteFloat32sAreRejectedByMarshal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, float32Cases), known("go-json/3"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/4: NUL bytes.
+
+// tailCase: a valid value followed by a NUL byte and a tail (the shape of go-json/4: go-json
+// stops at the NUL and accepts the text) or, under HEGEL_NO_KNOWN=1, by a space and the tail.
+type tailCase struct {
+	text, gap, tail string
+}
+
+func (c tailCase) String() string { return c.text + c.gap + c.tail }
+
+var nulCases = hegel.Composite(func(tc hegel.TestCase) tailCase {
+	return tailCase{
+		text: hegel.Draw(tc, plainTexts),
+		gap:  hegel.Draw(tc, shaped(hegel.SampledFrom([]string{"\x00", " \x00", "\x00 "}), hegel.Just(" "))),
+		tail: hegel.Draw(tc, hegel.SampledFrom([]string{"garbage", "{", "1", "\"", "x"})),
+	}
+})
+
+// Bytes after a NUL are still input: Unmarshal, Valid, Compact and Indent reject the text
+// like encoding/json (go-json ends the input at the NUL, go-json/4).
+func TestHegelNulBytesDoNotEndTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, nulCases).String()
+		decodesLike[any](ht, text, nil, known("go-json/4"))
+		validAgrees(ht, text, "", " ", known("go-json/4"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/5: case-insensitive keys of large structs.
+
+// caseCase: the members of an object decoded into a struct of seventeen fields (the shape
+// of go-json/5: go-json matches keys case-sensitively past sixteen fields) or, under
+// HEGEL_NO_KNOWN=1, of sixteen: "LOWER" for the field tagged lower, and a few of the others
+// with the case of their keys flipped as the coins say.
+type caseCase struct {
+	lower  int
+	others []pair[int, bool] // field index 1..15 and whether its key is lower-cased
+	vals   []int
+}
+
+func (c caseCase) text() string {
+	members := []string{fmt.Sprintf(`"LOWER":%d`, c.lower)}
+	for i, o := range c.others {
+		k := fmt.Sprintf("F%d", o.a)
+		if o.b {
+			k = strings.ToLower(k)
+		}
+		members = append(members, fmt.Sprintf(`"%s":%d`, k, c.vals[i%len(c.vals)]))
+	}
+	return "{" + strings.Join(members, ",") + "}"
+}
+
+func (c caseCase) GoString() string { return c.text() }
+
+var caseCases = hegel.Composite(func(tc hegel.TestCase) caseCase {
+	return caseCase{
+		lower:  hegel.Draw(tc, hegel.Integers(1, 1000)),
+		others: hegel.Draw(tc, many(pairs(hegel.Integers(1, 15), hegel.Booleans()), 0, 4)),
+		vals:   hegel.Draw(tc, many(hegel.Integers(-100, 100), 1, 4)),
+	}
+})
+
+// Keys match struct fields case-insensitively whatever the number of fields, as in
+// encoding/json (go-json matches case-sensitively past sixteen fields, go-json/5).
+func TestHegelKeyCaseIsIgnoredForLargeStructs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, caseCases)
+		if noKnown {
+			decodesLike(ht, c.text(), hgSixteen{}, nil)
+			return
+		}
+		decodesLike(ht, c.text(), hgSeventeen{}, known("go-json/5"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/6: quoted integers.
+
+// quotedIntCase: the text inside the quotes of a `,string` integer field or of an integer map
+// key: a spelling strconv rejects or misreads (the shape of go-json/6: a leading zero, a
+// plus sign, an exponent, a trailing letter, a space, a fraction) or, under HEGEL_NO_KNOWN=1,
+// a plain decimal integer; and whether it is the field or the key.
+type quotedIntCase struct {
+	digits string
+	form   int
+	asKey  bool
+}
+
+var quotedForms = []string{"0%s", "+%s", "%se2", "%sx", " %s", "%s.0", "%s ", "-0%s"}
+
+func (c quotedIntCase) spelling() string {
+	if noKnown {
+		return c.digits
+	}
+	return fmt.Sprintf(quotedForms[c.form%len(quotedForms)], c.digits)
+}
+
+func (c quotedIntCase) GoString() string { return fmt.Sprintf("%q asKey=%v", c.spelling(), c.asKey) }
+
+type quotedIntHolder struct {
+	N int `json:"n,string"`
+}
+
+var quotedIntCases = hegel.Composite(func(tc hegel.TestCase) quotedIntCase {
+	return quotedIntCase{
+		digits: hegel.Draw(tc, hegel.Map(hegel.Integers(-99, 99), strconv.Itoa)),
+		form:   hegel.Draw(tc, hegel.Integers(0, len(quotedForms)-1)),
+		asKey:  hegel.Draw(tc, chance(30)),
+	}
+})
+
+// An integer in string form (a `,string` field, an integer map key) is parsed like
+// encoding/json parses it, with strconv's grammar (go-json reads a prefix and misreads
+// leading zeros, go-json/6).
+func TestHegelQuotedIntegersFollowTheNumberGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, quotedIntCases)
+		if c.asKey {
+			decodesLike(ht, fmt.Sprintf(`{"%s":1}`, c.spelling()), map[int]int{}, known("go-json/6"))
+			return
+		}
+		decodesLike(ht, fmt.Sprintf(`{"n":"%s"}`, c.spelling()), quotedIntHolder{}, known("go-json/6"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/7: the number grammar.
+
+// lenientLits: a number spelt outside the JSON grammar: with a leading zero, a trailing dot
+// (before an exponent or not), or with no digit before the dot (the shape of go-json/7).
+var lenientLits = weighted(
+	choice[string]{1, hegel.Map(pairs(chance(30), digitText(1, 6)), func(p pair[bool, string]) string { return map[bool]string{false: "0", true: "-0"}[p.a] + p.b })},
+	choice[string]{1, hegel.Map(pairs(wholes, maybe(50, exps)), func(p pair[string, string]) string { return p.a + "." + p.b })},
+	choice[string]{1, hegel.Map(digitText(1, 6), func(d string) string { return "-." + d })},
+)
+
+var numberGrammarCases = pairs(shaped(lenientLits, numLits), contexts)
+
+// Unmarshal and Valid accept exactly the numbers of the JSON grammar, as encoding/json does
+// (go-json also takes leading zeros, a trailing dot and -.5, go-json/7).
+func TestHegelLenientNumberSpellingsAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, numberGrammarCases)
+		text := embedded(c.b, c.a)
+		decodesLike[any](ht, text, nil, known("go-json/7"))
+		validAgrees(ht, text, "", " ", known("go-json/7"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/8: bare null keys.
+
+// nullKeyCase: an object of one to three members whose member at a drawn position (modulo
+// the count) has the bare word null for its key (the shape of go-json/8) or, under
+// HEGEL_NO_KNOWN=1, the string "null".
+type nullKeyCase struct {
+	keys []string
+	vals []int
+	at   int
+}
+
+func (c nullKeyCase) text() string {
+	members := make([]string, len(c.keys))
+	for i, k := range c.keys {
+		key := strconv.Quote(k)
+		if i == c.at%len(c.keys) {
+			key = shaped("null", `"null"`)
+		}
+		members[i] = fmt.Sprintf("%s:%d", key, c.vals[i%len(c.vals)])
+	}
+	return "{" + strings.Join(members, ",") + "}"
+}
+
+func (c nullKeyCase) GoString() string { return c.text() }
+
+var nullKeyCases = hegel.Composite(func(tc hegel.TestCase) nullKeyCase {
+	return nullKeyCase{keys: hegel.Draw(tc, many(words, 1, 3)), vals: hegel.Draw(tc, many(smallInts, 1, 3)), at: hegel.Draw(tc, positions)}
+})
+
+// An object key is a string: a bare null in key position is a syntax error, as in
+// encoding/json (go-json takes it for the empty key, go-json/8).
+func TestHegelBareNullIsNotAnObjectKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, nullKeyCases).text()
+		decodesLike[any](ht, text, nil, known("go-json/8"))
+		decodesLike(ht, text, map[string]any{}, known("go-json/8"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/9: nil TextMarshaler pointers.
+
+// textPtrCases: a pointer to a TextMarshaler, nil (the shape of go-json/9: go-json writes
+// nothing for it) or, under HEGEL_NO_KNOWN=1, to a value; at top level, in a slice or as a
+// map value.
+var textPtrCases = hegel.Map(pairs(shaped(hegel.Just[*hgText](nil), ptrs(hgTexts)), hegel.Integers(0, 2)), func(p pair[*hgText, int]) any {
+	return []any{p.a, []*hgText{p.a}, map[string]*hgText{"k": p.a}}[p.b]
+})
+
+// A nil pointer to a TextMarshaler marshals as null wherever it stands, as in encoding/json
+// (go-json writes the empty output at top level and "" in slices and maps, go-json/9).
+func TestHegelNilTextMarshalerPointersMarshalAsNull(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, textPtrCases), known("go-json/9"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/10: the stream Decoder's leniency.
+
+// decoderTexts: a text the stream Decoder is lenient about: a literal cut short at the end of
+// the input, a comma or colon before a value, a \u escape with four non-hex characters (the
+// shape of go-json/10); under HEGEL_NO_KNOWN=1 the same texts made right: the whole literal,
+// no punctuation, hex digits.
+var (
+	literals     = hegel.SampledFrom([]string{"true", "false", "null"})
+	cutLiterals  = hegel.Map(pairs(literals, hegel.Integers(1, 3)), func(p pair[string, int]) string { return p.a[:min(p.b, len(p.a)-1)] })
+	punctLeads   = hegel.SampledFrom([]string{",", ":", " ,", ": ", ",,"})
+	decoderTexts = weighted(
+		choice[string]{1, shaped(cutLiterals, literals)},
+		choice[string]{1, hegel.Map(pairs(shaped(punctLeads, hegel.Just("")), plainTexts), func(p pair[string, string]) string { return p.a + p.b })},
+		choice[string]{1, hegel.Map(pairs(shaped(nonHex, hexDigits), contexts), func(p pair[string, int]) string { return embedded(p.b, `"\u`+p.a+`"`) })},
+	)
+)
+
+// The stream Decoder and Valid are as strict as Unmarshal and encoding/json: a truncated
+// literal, a comma or colon before a value and a \u escape with non-hex digits are errors
+// (go-json's Decoder takes them all, go-json/10).
+func TestHegelDecoderIsAsStrictAsUnmarshal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, decoderTexts)
+		shapes := known("go-json/10")
+		decodesLike[any](ht, text, nil, shapes)
+		var g, w any
+		ge := json.NewDecoder(strings.NewReader(text)).Decode(&g)
+		we := std.NewDecoder(strings.NewReader(text)).Decode(&w)
+		if (ge == nil) != (we == nil) || !reflect.DeepEqual(g, w) {
+			mismatch(ht, shapes, "Decoder.Decode %q: go-json %#v (%v), encoding/json %#v (%v)", text, g, ge, w, we)
+		}
+		if gv, wv := json.Valid([]byte(text)), std.Valid([]byte(text)); gv != wv {
+			mismatch(ht, shapes, "Valid %q: go-json %v, encoding/json %v", text, gv, wv)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/11: raw control characters.
+
+// controlCase: a string with a control character (U+0001..U+001F) between two words, raw
+// inside the quotes (the shape of go-json/11) or, under HEGEL_NO_KNOWN=1, escaped; as a
+// value or as a key.
+type controlCase struct {
+	before, after string
+	ctrl          rune
+	asKey         bool
+	ctx           int
+}
+
+func (c controlCase) literal() string {
+	if noKnown {
+		return render(c.before+string(c.ctrl)+c.after, nil, true, false)
+	}
+	return `"` + c.before + string(c.ctrl) + c.after + `"`
+}
+
+func (c controlCase) text() string {
+	if c.asKey {
+		return "{" + c.literal() + ":1}"
+	}
+	return embedded(c.ctx, c.literal())
+}
+
+func (c controlCase) GoString() string { return strconv.Quote(c.text()) }
+
+var controlCases = hegel.Composite(func(tc hegel.TestCase) controlCase {
+	return controlCase{
+		before: hegel.Draw(tc, words),
+		after:  hegel.Draw(tc, words),
+		ctrl:   hegel.Draw(tc, hegel.Integers[rune](1, 0x1f)),
+		asKey:  hegel.Draw(tc, chance(30)),
+		ctx:    hegel.Draw(tc, contexts),
+	}
+})
+
+// A raw control character inside a string is a syntax error for Unmarshal, Valid, Compact
+// and Indent, as in encoding/json and RFC 8259 (go-json accepts it, go-json/11).
+func TestHegelRawControlCharactersInStringsAreInvalid(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, controlCases).text()
+		decodesLike[any](ht, text, nil, known("go-json/11"))
+		validAgrees(ht, text, "", " ", known("go-json/11"))
+	})
+}
