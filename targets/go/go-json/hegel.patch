+// ---------------------------------------------------------------------------
+// go-json/25: escaped keys across the Decoder's buffer refill.
+
+// refillCase: an hgPadded document whose string member pads the text so that the key of the
+// second member lies near the stream Decoder's buffer refills at 512 and 1024 bytes, the key
+// written with \u escapes (the shape of go-json/25) or, under HEGEL_NO_KNOWN=1, plainly.
+type refillCase struct {
+	pad int
+	i8  int
+}
+
+// escapedI8 is the key i8 spelt with two \u escapes.
+var escapedI8 = fmt.Sprintf(`"\u%04x\u%04x"`, 'i', '8')
+
+func (c refillCase) text() string {
+	return `{"s":"` + strings.Repeat("a", c.pad) + `",` + shaped(escapedI8, `"i8"`) + `:` + strconv.Itoa(c.i8) + `}`
+}
+
+func (c refillCase) GoString() string { return fmt.Sprintf("pad %d, i8 %d", c.pad, c.i8) }
+
+var refillCases = hegel.Composite(func(tc hegel.TestCase) refillCase {
+	return refillCase{pad: hegel.Draw(tc, weighted(choice[int]{1, hegel.Integers(480, 520)}, choice[int]{1, hegel.Integers(990, 1030)})), i8: hegel.Draw(tc, hegel.Integers(-128, 127))}
+})
+
+// The stream Decoder reads a valid document however its bytes fall against its buffer
+// refills, like Unmarshal and encoding/json (go-json fails on a \u escape in a struct key
+// there, go-json/25).
+func TestHegelDecoderReadsEscapedKeysAcrossBufferRefills(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, refillCases)
+		text := c.text()
+		shapes := known("go-json/25")
+		decodesLike(ht, text, hgPadded{}, shapes)
+		var g, w hgPadded
+		ge := json.NewDecoder(strings.NewReader(text)).Decode(&g)
+		we := std.NewDecoder(strings.NewReader(text)).Decode(&w)
+		if (ge == nil) != (we == nil) || g != w {
+			mismatch(ht, shapes, "Decoder.Decode of a %d-byte document (pad %d): go-json %+v (%v), encoding/json %+v (%v)", len(text), c.pad, g, ge, w, we)
+		}
+	})
+}
