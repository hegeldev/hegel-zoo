+// ---------------------------------------------------------------------------
+// go-json/12: escapes in Compact and Indent.
+
+// escapeCase: a string literal with an escape: a bad one (a letter outside the escape set, a
+// \u with non-hex or too few digits; the shape of go-json/12) or, under HEGEL_NO_KNOWN=1, a
+// good one; in a context.
+var (
+	badEscapes = weighted(
+		choice[string]{1, hegel.Map(hegel.Text().Alphabet("axg'qzABC0 ").MinSize(1).MaxSize(2), func(s string) string { return `\` + s })},
+		choice[string]{1, hegel.Map(nonHex, func(s string) string { return `\u` + s })},
+		choice[string]{1, hegel.Map(hegel.Text().Alphabet("0123456789abcdef").MinSize(1).MaxSize(3), func(s string) string { return `\u` + s })},
+	)
+	goodEscapes = weighted(
+		choice[string]{1, hegel.SampledFrom([]string{`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`})},
+		choice[string]{1, hegel.Map(hexDigits, func(s string) string { return `\u` + s })},
+	)
+	// nonHexTails: what follows the escape, without hex digits (which would complete a short
+	// \u escape).
+	nonHexTails = hegel.Text().Alphabet("xyzXYZ ").MaxSize(3)
+	escapeCases = hegel.Composite(func(tc hegel.TestCase) pair[string, int] {
+		lit := `"` + hegel.Draw(tc, words) + hegel.Draw(tc, shaped(badEscapes, goodEscapes)) + hegel.Draw(tc, nonHexTails) + `"`
+		return pair[string, int]{lit, hegel.Draw(tc, contexts)}
+	})
+)
+
+// Compact and Indent reject a malformed escape inside a string, as encoding/json does
+// (go-json copies it through, go-json/12).
+func TestHegelCompactAndIndentValidateEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, escapeCases)
+		text := embedded(c.b, c.a)
+		shapes := known("go-json/12")
+		var gb, wb bytes.Buffer
+		ge, we := json.Compact(&gb, []byte(text)), std.Compact(&wb, []byte(text))
+		if (ge == nil) != (we == nil) || gb.String() != wb.String() {
+			mismatch(ht, shapes, "Compact %q: go-json %q (%v), encoding/json %q (%v)", text, gb.String(), ge, wb.String(), we)
+		}
+		if we == nil {
+			return
+		}
+		var ib bytes.Buffer
+		if ge := json.Indent(&ib, []byte(text), "", " "); ge == nil {
+			mismatch(ht, shapes, "Indent accepts %q as %q (encoding/json rejects it: %v)", text, ib.String(), we)
+		}
+	})
+}
