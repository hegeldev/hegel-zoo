+// ---------------------------------------------------------------------------
+// go-json/19: decoding past a type error.
+
+// typeErrorCase: an array of integers decoded into []int with the element at a drawn position
+// (modulo the count) replaced by a string (the shape of go-json/19: go-json stops there), or
+// an object decoded into hgInner whose a member is a string; under HEGEL_NO_KNOWN=1 the same
+// texts with the numbers in place.
+type typeErrorCase struct {
+	ints    []int
+	at      int
+	word    string
+	asInner bool
+}
+
+func (c typeErrorCase) text() string {
+	if c.asInner {
+		return fmt.Sprintf(`{"a":%s,"b":%q}`, shaped(strconv.Quote(c.word), strconv.Itoa(c.ints[0])), c.word)
+	}
+	parts := make([]string, len(c.ints))
+	for i, n := range c.ints {
+		parts[i] = strconv.Itoa(n)
+	}
+	if !noKnown {
+		parts[c.at%len(parts)] = strconv.Quote(c.word)
+	}
+	return "[" + strings.Join(parts, ",") + "]"
+}
+
+func (c typeErrorCase) GoString() string { return c.text() }
+
+var typeErrorCases = hegel.Composite(func(tc hegel.TestCase) typeErrorCase {
+	return typeErrorCase{
+		ints:    hegel.Draw(tc, many(hegel.Integers(-100, 100), 1, 4)),
+		at:      hegel.Draw(tc, positions),
+		word:    hegel.Draw(tc, words),
+		asInner: hegel.Draw(tc, chance(40)),
+	}
+})
+
+// After a type error Unmarshal keeps decoding the rest of the document and reports the
+// error at the end, as encoding/json does (go-json stops at the error, go-json/19).
+func TestHegelDecodingContinuesAfterATypeError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, typeErrorCases)
+		if c.asInner {
+			decodesLike(ht, c.text(), hgInner{}, known("go-json/19"))
+			return
+		}
+		decodesLike(ht, c.text(), []int(nil), known("go-json/19"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// go-json/20: null into Number.
+
+// numberCase: a json.Number holding a literal, and the text decoded into it: null (the shape
+// of go-json/20: go-json reports a syntax error) or, under HEGEL_NO_KNOWN=1, another literal;
+// at top level or as a struct member.
+type numberCase struct {
+	init   string
+	text   string
+	nested bool
+}
+
+var numberCases = hegel.Composite(func(tc hegel.TestCase) numberCase {
+	return numberCase{init: hegel.Draw(tc, numLits), text: hegel.Draw(tc, shaped(hegel.Just("null"), numLits)), nested: hegel.Draw(tc, chance(50))}
+})
+
+// A null decoded into a json.Number leaves it as it was without an error, as in
+// encoding/json (go-json reports a syntax error, go-json/20).
+func TestHegelNullIntoNumberIsANoOp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, numberCases)
+		if c.nested {
+			type holder struct {
+				N json.Number `json:"n"`
+			}
+			decodesLike(ht, `{"n":`+c.text+`}`, holder{json.Number(c.init)}, known("go-json/20"))
+			return
+		}
+		decodesLike(ht, c.text, json.Number(c.init), known("go-json/20"))
+	})
+}
