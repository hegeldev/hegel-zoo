+// go-json/23: \b and \f.
+
+// shortEscapeCases: a string with a backspace or a form feed between two words (the shape of
+// go-json/23) or, under HEGEL_NO_KNOWN=1, a newline, return or tab; as a value, a struct
+// member or a map key.
+var shortEscapeCases = hegel.Composite(func(tc hegel.TestCase) any {
+	s := hegel.Draw(tc, words) + hegel.Draw(tc, shaped(hegel.SampledFrom([]string{"\b", "\f"}), hegel.SampledFrom([]string{"\n", "\r", "\t"}))) + hegel.Draw(tc, words)
+	return []any{s, struct{ S string }{s}, map[string]int{s: 1}}[hegel.Draw(tc, hegel.Integers(0, 2))]
+})
+
+// U+0008 and U+000C are written with their short escapes \b and \f, as encoding/json writes
+// them (go-json writes the long \u escapes, go-json/23).
+func TestHegelBackspaceAndFormFeedUseShortEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, shortEscapeCases), known("go-json/23"))
+	})
+}
