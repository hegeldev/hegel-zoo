+// ---------------------------------------------------------------------------
+// go-json/18: Indent and trailing whitespace.
+
+// trailingCases: a valid text with trailing whitespace (the shape of go-json/18) or, under
+// HEGEL_NO_KNOWN=1, with leading whitespace, and Indent's prefix and indent.
+type trailingCase struct {
+	text, ws, prefix, indent string
+}
+
+var trailingCases = hegel.Composite(func(tc hegel.TestCase) trailingCase {
+	return trailingCase{text: hegel.Draw(tc, plainTexts), ws: hegel.Draw(tc, wsRuns), prefix: hegel.Draw(tc, indents), indent: hegel.Draw(tc, indents)}
+})
