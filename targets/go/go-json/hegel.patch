+// ---------------------------------------------------------------------------
+// go-json/13: small exponents.
+
+// bandFloats: a float of the exponent band [1e-9, 1e-6) (the shape of go-json/13) or, under
+// HEGEL_NO_KNOWN=1, of the decade below it or of the range printed without an exponent; as a
+// float64 or a float32, at top level, in a slice or in a struct.
+var (
+	bandFloats = hegel.Map(pairs(hegel.Integers(0, 1<<20), shaped(hegel.Integers(21, 29), hegel.Integers(31, 39))), func(p pair[int, int]) float64 { return math.Ldexp(1+float64(p.a)/float64(1<<20), -p.b) })
+	bandCases  = hegel.Map(pairs(signed(bandFloats), hegel.Integers(0, 3)), func(p pair[float64, int]) any {
+		return []any{p.a, float32(p.a), []float64{p.a}, struct{ F float32 }{float32(p.a)}}[p.b]
+	})
+)
+
+// A float printed in exponent form has its exponent written with as few digits as
+// encoding/json uses (go-json pads it to two, go-json/13).
+func TestHegelSmallExponentsAreNotZeroPadded(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		marshalsLike(ht, hegel.Draw(ht, bandCases), known("go-json/13"))
+	})
+}
