+func TestHegelMPLNoCopyleftExceptionIsInRange(t *testing.T) {
+	c := newCollector(t)
+	region := shaped(
+		weighted(
+			choice[mplCase]{1, mplCases(hegel.Just("MPL-2.0-no-copyleft-exception"), pick("MPL-1.0+", "MPL-1.1+"))},
+			choice[mplCase]{1, mplCases(pick("MPL-1.0+", "MPL-1.1+"), pick("MPL-2.0-no-copyleft-exception", "MPL-2.0-no-copyleft-exception+"))},
+		),
+		mplCases(pick("MPL-1.0+", "MPL-1.1+", "MPL-1.0", "MPL-2.0"), pick("MPL-1.1", "MPL-2.0", "MPL-1.0+", "MPL-2.0+")),
+	)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, region)
+		checkSatisfies(c, ht, m.test.text(), m.list(), "go-spdx/15")
+	})
+}
+
+// endingCase is an input that is a tail on its own, or a tree, a keyword and the tail.
+type endingCase struct {
+	prefix exprCase
+	bare   bool
+	op     string
+	tail   string
+}
+
+func (e endingCase) text() string {
+	if e.bare {
+		return e.tail
+	}
+	return e.prefix.text() + " " + e.op + " " + e.tail
+}
+
+func (e endingCase) GoString() string { return fmt.Sprintf("%q", e.text()) }
+
+func endingCases(tails hegel.Generator[string]) hegel.Generator[endingCase] {
+	return hegel.Composite(func(tc hegel.TestCase) endingCase {
+		return endingCase{
+			prefix: hegel.Draw(tc, shapeCases(subTrees)),
+			bare:   hegel.Draw(tc, chance(30)),
+			op:     hegel.Draw(tc, pick("AND", "OR")),
+			tail:   hegel.Draw(tc, tails),
+		}
+	})
+}
+
+var (
+	// a tail that ends after "(" or a DocumentRef
+	openTails = pick("(", "DocumentRef-x", "DocumentRef-x:", "( (", "DocumentRef-x:LicenseRef-y AND DocumentRef-z", "(MIT AND (")
+	// a tail that ends after a keyword, an unfinished reference or an unmatched parenthesis
+	closedTails = pick("MIT AND", "MIT OR", "MIT WITH", "(MIT", "MIT )", "LicenseRef-", "MIT WITH Classpath-exception-2.0 AND")
+)
+
+// go-spdx/16: an input ending after "(" or a DocumentRef, with ValidateLicenses,
+// ExtractLicenses and Satisfies; past it, inputs ending after a keyword or an unmatched
+// parenthesis, which are errors.
+func TestHegelParserNeverPanics(t *testing.T) {
+	c := newCollector(t)
+	ex := extractCache{}
+	region := endingCases(shaped(openTails, closedTails))
+	property(t, func(ht *hegel.T) {
+		e := hegel.Draw(ht, region)
+		s := e.text()
+		checkNormalize(c, ht, ex, s, "go-spdx/16")
+		checkSatisfies(c, ht, s, []string{"MIT"}, "go-spdx/16")
+	})
+}
diff --git a/spdxexp/hegel_test.go b/spdxexp/hegel_test.go
