+package spdxexp_test
+
+// Hegel property tests for github/go-spdx (spdxexp), written for the Hegel zoo. See
+// targets/go/go-spdx/README.md.
+//
+// Oracle: the SPDX license expression grammar (SPDX 2.3, Annex D) with the leniencies the
+// package documents (case-insensitive identifiers, `-only`/`-or-later`/`+` normalization), the
+// README's semantics of Satisfies (an expression is satisfied when one of its OR alternatives
+// has every ANDed license covered by an allowed license; a license is covered by the same
+// license, or through the version ranges of spdxlicenses.LicenseRanges when one side carries
+// `+`) and the documented behaviour of ValidateLicenses and its options, restated as a model
+// (hegel_model_test.go). The model's parser and DNF expansion follow the package's own
+// algorithm where a recorded bug is reproduced (Known switches), so that every remaining
+// difference is a new finding.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on (or the generator avoids the shape); the pins assert the documented behaviour and fail
+// while the bug exists.
+var Known = struct {
+	// appendTerms appends to a slice with spare capacity, so the AND-terms of an expression
+	// like ((A AND B) AND C) AND (D OR E) all end with the last alternative; the generator
+	// keeps expressions to four licenses, where no slice has spare capacity
+	appendAliasing bool
+	// expandOrTerm ignores a LicenseRef term of an OR: dropped alternative (false negative), and
+	// an OR of only LicenseRefs under AND expands to nothing and is ignored (false positive)
+	orDropsLicenseRef bool
+	// expandOrTerm keeps only the first AND-term of an AND alternative that contains an OR
+	orKeepsFirstAndTerm bool
+	// expandOrTerm indexes [0] of an empty expansion: Satisfies panics
+	emptyAndTermPanics bool
+	// the parser dereferences a nil token when the input ends after "(" or a DocumentRef:
+	// ValidateLicenses("MIT AND (") panics
+	endOfInputPanics bool
+	// the MIT fast path of Satisfies answers by string equality only: MIT vs MIT+ is false, MIT
+	// vs "MIT " is false
+	mitFastPath bool
+	// the fast paths of Satisfies return true without validating the allowed list
+	fastPathsSkipAllowedValidation bool
+	// the WITH fast path of ValidateLicenses rejects without parsing: "MIT+ WITH X",
+	// "(MIT WITH X)" are invalid
+	withFastPathRejects bool
+	// ValidateLicensesOptions are decided from the surface of the string (no space = atomic,
+	// three fields = WITH), so they do not apply inside expressions or parentheses
+	optionsBySurface bool
+	// a lower-case "with" is accepted by the WITH fast paths, and by nothing else
+	foldWithAccepted bool
+	// any identifier with an -only or -or-later suffix is normalized to the base identifier
+	// (MIT-only, Apache-2.0-or-later), and the -or-later rewrite swallows the next character
+	suffixNormalized bool
+	// "LicenseRef-x WITH exception" is a syntax error (the grammar allows it)
+	licenseRefWithRejected bool
+	// AND/OR/WITH are matched as prefixes: "MIT ANDMIT" is MIT AND MIT
+	keywordGlue bool
+	// an atomic deprecated "+" identifier is normalized to itself ("GPL-2.0+"), in an
+	// expression to "GPL-2.0-or-later"
+	atomicPlusNotNormalized bool
+	// ExtractLicenses returns map keys: random order; pin only
+	extractOrderRandom bool
+	// the second MPL range group (MPL-2.0-no-copyleft-exception) is unreachable; pin only, the
+	// model uses the first matching group as the code does
+	mplSecondGroupUnreachable bool
+}{
+	appendAliasing:                 true,
+	orDropsLicenseRef:              true,
+	orKeepsFirstAndTerm:            true,
+	emptyAndTermPanics:             true,
+	endOfInputPanics:               true,
+	mitFastPath:                    true,
+	fastPathsSkipAllowedValidation: true,
+	withFastPathRejects:            true,
+	optionsBySurface:               true,
+	foldWithAccepted:               true,
+	suffixNormalized:               true,
+	licenseRefWithRejected:         true,
+	keywordGlue:                    true,
+	atomicPlusNotNormalized:        true,
+	extractOrderRandom:             true,
+	mplSecondGroupUnreachable:      true,
+}
