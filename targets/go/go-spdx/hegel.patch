@@ -0,0 +1,806 @@
+package spdxexp_test
+
+// The model: expression trees, a tokenizer and parser of SPDX license expressions with the
+// package's documented leniencies, canonical rendering, license compatibility through the
+// version ranges, the DNF expansion, and the documented behaviour of Satisfies, ExtractLicenses
+// and ValidateAndNormalizeLicensesWithOptions. Every place where the package departs from the
+// documentation is a Known switch (hegel_test.go): off by default, when the model says what the
+// documentation and the grammar say; on under HEGEL_NO_KNOWN=1, when the model reproduces the
+// package as coded.
+
+import (
+	"errors"
+	"regexp"
+	"slices"
+	"strings"
+
+	"github.com/github/go-spdx/v2/spdxexp"
+	"github.com/github/go-spdx/v2/spdxexp/spdxlicenses"
+)
+
+// --------------------------------------------------------------------------- trees
+
+const (
+	opAtom = iota
+	opAnd
+	opOr
+)
+
+type atom struct {
+	ref    bool
+	id     string // canonical license id (licenses)
+	plus   bool
+	exc    string // canonical exception id, "" if none
+	hasDoc bool
+	doc    string
+	lref   string
+}
+
+type expr struct {
+	op   int
+	a    *atom
+	l, r *expr
+}
+
+func (a *atom) String() string {
+	var s string
+	if a.ref {
+		s = "LicenseRef-" + a.lref
+		if a.hasDoc {
+			s = "DocumentRef-" + a.doc + ":" + s
+		}
+	} else {
+		s = a.id
+		if a.plus && !strings.HasSuffix(strings.ToLower(a.id), "-or-later") {
+			s += "+"
+		}
+	}
+	if a.exc != "" {
+		s += " WITH " + a.exc
+	}
+	return s
+}
+
+func prec(e *expr) int {
+	switch e.op {
+	case opAnd:
+		return 2
+	case opOr:
+		return 1
+	}
+	return 3
+}
+
+// String is the canonical rendering: canonical identifiers, upper-case operators, parentheses
+// only where a lower-precedence operator is an operand of a higher one.
+func (e *expr) String() string {
+	if e.op == opAtom {
+		return e.a.String()
+	}
+	op := " AND "
+	if e.op == opOr {
+		op = " OR "
+	}
+	l, r := e.l.String(), e.r.String()
+	if e.l.op != opAtom && prec(e.l) < prec(e) {
+		l = "(" + l + ")"
+	}
+	if e.r.op != opAtom && prec(e.r) < prec(e) {
+		r = "(" + r + ")"
+	}
+	return l + op + r
+}
+
+func (e *expr) atoms() []*atom {
+	if e.op == opAtom {
+		return []*atom{e.a}
+	}
+	return append(e.l.atoms(), e.r.atoms()...)
+}
+
+func (e *expr) isExpression() bool { return e.op != opAtom }
+
+// --------------------------------------------------------------------------- identifiers
+
+func active(id string) (string, bool) {
+	ok, c := spdxlicenses.IsActiveLicense(id)
+	return c, ok
+}
+
+func deprecated(id string) (string, bool) {
+	ok, c := spdxlicenses.IsDeprecatedLicense(id)
+	return c, ok
+}
+
+func exception(id string) (string, bool) {
+	ok, c := spdxlicenses.IsException(id)
+	return c, ok
+}
+
+// --------------------------------------------------------------------------- tokenizer
+
+const (
+	tokOp = iota
+	tokDocRef
+	tokLicRef
+	tokLicense
+	tokException
+)
+
+type tok struct {
+	role int
+	val  string
+}
+
+var reID = regexp.MustCompile(`^[A-Za-z0-9.-]+`)
+
+// tokenize follows scan.go: spaces only; operators; DocumentRef-/LicenseRef- prefixes with an
+// idstring; identifiers looked up case-insensitively in the active, exception and deprecated
+// lists, with the documented "+" normalization and, under Known.suffixNormalized, the package's
+// -only / -or-later rewrites of any identifier.
+func tokenize(s string) ([]tok, error) {
+	var out []tok
+	i := 0
+	for i < len(s) {
+		for i < len(s) && s[i] == ' ' {
+			i++
+		}
+		if i >= len(s) {
+			break
+		}
+		rest := s[i:]
+		matched := false
+		for _, op := range []string{"WITH", "AND", "OR", "(", ")", ":", "+"} {
+			if !strings.HasPrefix(rest, op) {
+				continue
+			}
+			if !Known.keywordGlue && len(op) > 1 {
+				// a keyword must be followed by a space, a parenthesis or the end
+				j := i + len(op)
+				if j < len(s) && s[j] != ' ' && s[j] != '(' && s[j] != ')' {
+					continue
+				}
+			}
+			if op == "+" && i > 0 && s[i-1] == ' ' {
+				return nil, errors.New("unexpected space before +")
+			}
+			out = append(out, tok{tokOp, op})
+			i += len(op)
+			matched = true
+			break
+		}
+		if matched {
+			continue
+		}
+		if strings.HasPrefix(rest, "DocumentRef-") || strings.HasPrefix(rest, "LicenseRef-") {
+			role := tokDocRef
+			pre := "DocumentRef-"
+			if strings.HasPrefix(rest, "LicenseRef-") {
+				role, pre = tokLicRef, "LicenseRef-"
+			}
+			id := reID.FindString(rest[len(pre):])
+			if id == "" {
+				return nil, errors.New("expected id")
+			}
+			out = append(out, tok{role, id})
+			i += len(pre) + len(id)
+			continue
+		}
+		id := reID.FindString(rest)
+		if id == "" {
+			return nil, errors.New("unexpected character")
+		}
+		i += len(id)
+		if c, ok := active(id); ok {
+			out = append(out, tok{tokLicense, c})
+			continue
+		}
+		if c, ok := exception(id); ok {
+			out = append(out, tok{tokException, c})
+			continue
+		}
+		if Known.suffixNormalized {
+			if strings.HasSuffix(id, "-only") {
+				if c, ok := active(id[:len(id)-5]); ok {
+					out = append(out, tok{tokLicense, c})
+					continue
+				}
+			}
+		}
+		if i < len(s) && s[i] == '+' {
+			if c, ok := active(id + "-or-later"); ok {
+				out = append(out, tok{tokLicense, c})
+				i++ // the + is consumed
+				continue
+			}
+		}
+		if Known.suffixNormalized && strings.HasSuffix(id, "-or-later") {
+			if c, ok := active(id[:len(id)-9]); ok {
+				// the rewrite puts a "+" in place of "-or-later" and drops the next character
+				out = append(out, tok{tokLicense, c}, tok{tokOp, "+"})
+				if i < len(s) {
+					i++
+				}
+				continue
+			}
+		}
+		if c, ok := deprecated(id); ok {
+			out = append(out, tok{tokLicense, c})
+			continue
+		}
+		return nil, errors.New("unknown license " + id)
+	}
+	return out, nil
+}
+
+// --------------------------------------------------------------------------- parser
+
+type mparser struct {
+	toks []tok
+	i    int
+}
+
+func (p *mparser) peek() *tok {
+	if p.i < len(p.toks) {
+		return &p.toks[p.i]
+	}
+	return nil
+}
+
+func (p *mparser) op(v string) bool {
+	t := p.peek()
+	if t != nil && t.role == tokOp && t.val == v {
+		p.i++
+		return true
+	}
+	return false
+}
+
+var errSyntax = errors.New("syntax error")
+
+// errEndOfInput marks the inputs that end after "(" or after a DocumentRef (with or without
+// its ":"), where the package's parser dereferences a nil token: a syntax error by the grammar,
+// a panic as coded (Known.endOfInputPanics; see panicsOn).
+var errEndOfInput = errors.New("syntax error: the input ends after ( or a DocumentRef")
+
+// panicsOn reports whether the package panics on a parse error of the model.
+func panicsOn(err error) bool { return Known.endOfInputPanics && errors.Is(err, errEndOfInput) }
+
+// parseExpr parses s as parse.go does: OR of ANDs of atoms, right-recursive, parentheses,
+// "+" and "WITH exception" after a license (after a reference too, by the grammar; a syntax
+// error under Known.licenseRefWithRejected), DocumentRef ":" LicenseRef.
+func parseExpr(s string) (*expr, error) {
+	if len(s) == 0 {
+		return nil, errors.New("empty")
+	}
+	toks, err := tokenize(s)
+	if err != nil {
+		return nil, err
+	}
+	if len(toks) == 0 {
+		return nil, errors.New("no tokens")
+	}
+	p := &mparser{toks: toks}
+	e, err := p.orExpr()
+	if err != nil {
+		return nil, err
+	}
+	if p.i != len(toks) {
+		return nil, errSyntax
+	}
+	return e, nil
+}
+
+func (p *mparser) orExpr() (*expr, error) {
+	l, err := p.andExpr()
+	if err != nil {
+		return nil, err
+	}
+	if !p.op("OR") {
+		return l, nil
+	}
+	if p.peek() == nil {
+		// "expected expression following OR, but found none": an error, not a panic
+		return nil, errSyntax
+	}
+	r, err := p.orExpr()
+	if err != nil {
+		return nil, err
+	}
+	return &expr{op: opOr, l: l, r: r}, nil
+}
+
+func (p *mparser) andExpr() (*expr, error) {
+	l, err := p.atomExpr()
+	if err != nil {
+		return nil, err
+	}
+	if !p.op("AND") {
+		return l, nil
+	}
+	if p.peek() == nil {
+		// "expected expression following AND, but found none": an error, not a panic
+		return nil, errSyntax
+	}
+	r, err := p.andExpr()
+	if err != nil {
+		return nil, err
+	}
+	return &expr{op: opAnd, l: l, r: r}, nil
+}
+
+func (p *mparser) atomExpr() (*expr, error) {
+	if p.op("(") {
+		e, err := p.orExpr()
+		if err != nil {
+			return nil, err
+		}
+		if !p.op(")") {
+			return nil, errSyntax
+		}
+		return e, nil
+	}
+	t := p.peek()
+	if t == nil {
+		// parseAtom -> parseParenthesizedExpression -> parseOperator on a nil token
+		return nil, errEndOfInput
+	}
+	switch t.role {
+	case tokDocRef:
+		p.i++
+		if p.peek() == nil {
+			return nil, errEndOfInput
+		}
+		if !p.op(":") {
+			return nil, errSyntax
+		}
+		lt := p.peek()
+		if lt == nil {
+			return nil, errEndOfInput
+		}
+		if lt.role != tokLicRef {
+			return nil, errSyntax
+		}
+		p.i++
+		a := &atom{ref: true, hasDoc: true, doc: t.val, lref: lt.val}
+		return p.withPart(a)
+	case tokLicRef:
+		p.i++
+		a := &atom{ref: true, lref: t.val}
+		return p.withPart(a)
+	case tokLicense:
+		p.i++
+		a := &atom{id: t.val, plus: strings.HasSuffix(strings.ToLower(t.val), "-or-later")}
+		if p.op("+") {
+			a.plus = true
+		}
+		return p.withPart(a)
+	}
+	return nil, errSyntax
+}
+
+func (p *mparser) withPart(a *atom) (*expr, error) {
+	if p.op("WITH") {
+		if a.ref && Known.licenseRefWithRejected {
+			return nil, errSyntax
+		}
+		et := p.peek()
+		if et == nil || et.role != tokException {
+			return nil, errSyntax
+		}
+		p.i++
+		a.exc = et.val
+	}
+	return &expr{op: opAtom, a: a}, nil
+}
+
+// --------------------------------------------------------------------------- compatibility
+
+type rangePos struct {
+	group, version int
+}
+
+func simplify(id string) string {
+	if strings.HasSuffix(id, "-or-later") {
+		return id[:len(id)-9]
+	}
+	return id
+}
+
+// rangesOf finds the license in spdxlicenses.LicenseRanges (-or-later stripped): every group
+// it appears in (MPL-1.0 and MPL-1.1 are in two), or only the first under
+// Known.mplSecondGroupUnreachable, as getLicenseRange does.
+func rangesOf(id string) []rangePos {
+	simple := simplify(id)
+	var out []rangePos
+	for i, group := range spdxlicenses.LicenseRanges() {
+		for j, version := range group {
+			if slices.Contains(version, simple) {
+				out = append(out, rangePos{i, j})
+				if Known.mplSecondGroupUnreachable {
+					return out
+				}
+			}
+		}
+	}
+	return out
+}
+
+// shared is the version positions of a and b in a group both belong to, if any.
+func shared(a, b []rangePos) (va, vb int, ok bool) {
+	for _, ra := range a {
+		for _, rb := range b {
+			if ra.group == rb.group {
+				return ra.version, rb.version, true
+			}
+		}
+	}
+	return 0, 0, false
+}
+
+func sameGroup(a, b []rangePos) bool {
+	_, _, ok := shared(a, b)
+	return ok
+}
+
+// inRange: the simple license s is in the range of the plus license p (same group and same
+// or later version), or the two are the same identifier.
+func inRange(s, p *atom) bool {
+	if s.id == p.id {
+		return true
+	}
+	vs, vp, ok := shared(rangesOf(s.id), rangesOf(p.id))
+	return ok && vs >= vp
+}
+
+// compatible: the expression atom e is covered by the allowed atom a (node.go, licensesAre-
+// Compatible and licenseRefsAreCompatible; a reference's exception, which the grammar allows,
+// must match like a license's).
+func compatible(e, a *atom) bool {
+	if e.ref || a.ref {
+		return e.ref && a.ref && e.lref == a.lref && e.hasDoc == a.hasDoc && (!e.hasDoc || e.doc == a.doc) && e.exc == a.exc
+	}
+	if e.exc != a.exc {
+		return false
+	}
+	if strings.EqualFold(e.String(), a.String()) {
+		return true
+	}
+	switch {
+	case e.plus && a.plus:
+		return sameGroup(rangesOf(e.id), rangesOf(a.id))
+	case a.plus:
+		return inRange(e, a)
+	case e.plus:
+		return inRange(a, e)
+	}
+	if e.id == a.id {
+		return true
+	}
+	ve, va, ok := shared(rangesOf(e.id), rangesOf(a.id))
+	return ok && ve == va
+}
+
+// --------------------------------------------------------------------------- expansion
+
+// eval is the documented meaning: AND/OR over "some allowed license covers the atom".
+func eval(e *expr, allowed []*atom) bool {
+	switch e.op {
+	case opAnd:
+		return eval(e.l, allowed) && eval(e.r, allowed)
+	case opOr:
+		return eval(e.l, allowed) || eval(e.r, allowed)
+	}
+	for _, a := range allowed {
+		if compatible(e.a, a) {
+			return true
+		}
+	}
+	return false
+}
+
+// dnf mirrors satisfies.go's expand/expandOr/expandAnd/appendTerms/mergeTerms, including the
+// recorded bugs while their switches are on (with every switch off it is the meaning, eval);
+// panics reports the index-out-of-range of expandOrTerm.
+func dnf(e *expr) (terms [][]*atom, panics bool) {
+	if e.op == opAtom {
+		return [][]*atom{{e.a}}, false
+	}
+	if e.op == opOr {
+		return expandOr(e)
+	}
+	return expandAnd(e)
+}
+
+func expandOr(e *expr) ([][]*atom, bool) {
+	var out [][]*atom
+	var pan bool
+	for _, t := range []*expr{e.l, e.r} {
+		switch {
+		case t.op == opAtom && t.a.ref && Known.orDropsLicenseRef:
+			// dropped
+		case t.op == opAtom:
+			out = append(out, []*atom{t.a})
+		case t.op == opOr:
+			ts, p := expandOr(t)
+			out = append(out, ts...)
+			pan = pan || p
+		default:
+			ts, p := expandAnd(t)
+			pan = pan || p
+			if Known.orKeepsFirstAndTerm {
+				if len(ts) == 0 {
+					if Known.emptyAndTermPanics {
+						pan = true
+					}
+					continue
+				}
+				out = append(out, ts[0])
+			} else {
+				out = append(out, ts...)
+			}
+		}
+	}
+	return out, pan
+}
+
+func expandAndTerm(t *expr) ([][]*atom, bool) {
+	switch t.op {
+	case opAtom:
+		return [][]*atom{{t.a}}, false
+	case opAnd:
+		return expandAnd(t)
+	}
+	return expandOr(t)
+}
+
+func expandAnd(e *expr) ([][]*atom, bool) {
+	left, p1 := expandAndTerm(e.l)
+	right, p2 := expandAndTerm(e.r)
+	pan := p1 || p2
+	if len(left) > 1 || len(right) > 1 {
+		return appendTerms(left, right), pan
+	}
+	return mergeTerms(left, right), pan
+}
+
+// appendTerms is the package's: every right term appended to every left term. As coded the
+// left term itself is appended to, so when it has spare capacity every result shares its
+// backing array and all end with the last right term (Known.appendAliasing; the model's slices
+// are built by the same operations on pointers of the same size, so Go grows them alike);
+// otherwise each result is built on a copy.
+func appendTerms(left, right [][]*atom) [][]*atom {
+	var result [][]*atom
+	for _, r := range right {
+		for _, l := range left {
+			tmp := l
+			if !Known.appendAliasing {
+				tmp = slices.Clone(l)
+			}
+			tmp = append(tmp, r...)
+			result = append(result, tmp)
+		}
+	}
+	return result
+}
+
+// mergeTerms is the package's: every left term extended by every right term in place (an
+// empty side is ignored).
+func mergeTerms(left, right [][]*atom) [][]*atom {
+	results := left
+	for _, r := range right {
+		for j, l := range results {
+			results[j] = append(l, r...)
+		}
+	}
+	return results
+}
+
+func termsSatisfied(terms [][]*atom, allowed []*atom) bool {
+	for _, term := range terms {
+		ok := true
+		for _, e := range term {
+			found := false
+			for _, a := range allowed {
+				if compatible(e, a) {
+					found = true
+					break
+				}
+			}
+			if !found {
+				ok = false
+				break
+			}
+		}
+		if ok {
+			return true
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- Satisfies
+
+type satResult struct {
+	ok     bool
+	err    bool
+	panics bool
+	// pure is the documented meaning (eval), for the collect classes
+	pure bool
+}
+
+func isAtomicSurface(s string) bool { return !strings.Contains(s, " ") }
+
+// withSurface: the three-field "license WITH exception" shape the fast paths look for.
+func withSurface(s string) (lic, exc string, ok bool) {
+	parts := strings.Fields(s)
+	if len(parts) != 3 {
+		return "", "", false
+	}
+	if Known.foldWithAccepted {
+		ok = strings.EqualFold(parts[1], "WITH")
+	} else {
+		ok = parts[1] == "WITH"
+	}
+	return parts[0], parts[2], ok
+}
+
+func anyFold(xs []string, s string) bool {
+	for _, x := range xs {
+		if strings.EqualFold(x, s) {
+			return true
+		}
+	}
+	return false
+}
+
+// modelSatisfies follows Satisfies in satisfies.go: the fast paths (Known), the parse of the
+// expression and of the allowed list, and the verdict - the documented meaning (eval), or the
+// package's expansion (dnf) while one of its bugs is reproduced.
+func modelSatisfies(test string, allowed []string) satResult {
+	if len(allowed) == 0 {
+		return satResult{err: true}
+	}
+	if Known.mitFastPath && strings.EqualFold(test, "MIT") {
+		return satResult{ok: anyFold(allowed, "MIT"), pure: anyFold(allowed, "MIT")}
+	}
+	test = strings.TrimSpace(test)
+	if Known.fastPathsSkipAllowedValidation {
+		if isAtomicSurface(test) {
+			_, okA := active(test)
+			_, okD := deprecated(test)
+			if (okA || okD) && anyFold(allowed, test) {
+				return satResult{ok: true, pure: true}
+			}
+		}
+		if lic, exc, ok := withSurface(test); ok {
+			_, okL := active(lic)
+			_, okE := exception(exc)
+			if okL && okE && anyFold(allowed, test) {
+				return satResult{ok: true, pure: true}
+			}
+		}
+	}
+	e, err := parseExpr(test)
+	if err != nil {
+		return satResult{err: true, panics: panicsOn(err)}
+	}
+	var as []*atom
+	for _, s := range allowed {
+		ae, err := parseExpr(s)
+		if err != nil {
+			return satResult{err: true, panics: panicsOn(err)}
+		}
+		if ae.isExpression() {
+			return satResult{err: true}
+		}
+		as = append(as, ae.a)
+	}
+	terms, pan := dnf(e)
+	pure := eval(e, as)
+	ok := pure
+	if Known.orDropsLicenseRef || Known.orKeepsFirstAndTerm || Known.appendAliasing {
+		ok = termsSatisfied(terms, as)
+	}
+	return satResult{ok: ok, panics: pan, pure: pure}
+}
+
+// --------------------------------------------------------------------------- ExtractLicenses
+
+// modelExtract is what ExtractLicenses returns for a parsed expression: its licenses as
+// canonical strings, without duplicates, in order of appearance (the README's example).
+func modelExtract(e *expr) []string {
+	var out []string
+	for _, a := range e.atoms() {
+		if s := a.String(); !slices.Contains(out, s) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// extractAgrees: the package's list is the model's; as a sequence, or as a set under
+// Known.extractOrderRandom (map keys come out in a random order).
+func extractAgrees(want, got []string) bool {
+	if Known.extractOrderRandom {
+		return slices.Equal(sortedSet(want), sortedSet(got)) && len(got) == len(sortedSet(got))
+	}
+	return slices.Equal(want, got)
+}
+
+func sortedSet(xs []string) []string {
+	out := slices.Clone(xs)
+	slices.Sort(out)
+	return slices.Compact(out)
+}
+
+// --------------------------------------------------------------------------- Validate
+
+// modelValidate follows ValidateAndNormalizeLicensesWithOptions for one input: the normalized
+// string, or "" and invalid; panics reports an input on which the parser panics.
+func modelValidate(s string, o spdxexp.ValidateLicensesOptions) (norm string, valid bool, panics bool) {
+	if strings.EqualFold(s, "MIT") {
+		return "MIT", true, false
+	}
+	s = strings.TrimSpace(s)
+	atomic := isAtomicSurface(s)
+	if atomic {
+		if c, ok := active(s); ok {
+			return c, true, false
+		}
+		if c, ok := deprecated(s); ok {
+			if o.FailDeprecatedLicenses {
+				return "", false, false
+			}
+			if Known.atomicPlusNotNormalized || !strings.HasSuffix(c, "+") {
+				return c, true, false
+			}
+		}
+		if o.FailAllLicenseRefs && strings.HasPrefix(s, "LicenseRef-") {
+			return "", false, false
+		}
+		if o.FailAllDocumentRefs && strings.HasPrefix(s, "DocumentRef-") {
+			return "", false, false
+		}
+	} else if lic, exc, ok := withSurface(s); ok {
+		if ce, ok := exception(exc); ok {
+			if cl, ok := active(lic); ok {
+				return cl + " WITH " + ce, true, false
+			}
+			if !o.FailDeprecatedLicenses {
+				// a deprecated "+" identifier is kept as written by this fast path too, where
+				// the parser would give the -or-later form (go-spdx/13)
+				if cl, ok := deprecated(lic); ok && (Known.atomicPlusNotNormalized || !strings.HasSuffix(cl, "+")) {
+					return cl + " WITH " + ce, true, false
+				}
+			}
+		}
+		if Known.withFastPathRejects {
+			return "", false, false
+		}
+	}
+	if o.FailComplexExpressions && !atomic && Known.optionsBySurface {
+		return "", false, false
+	}
+	e, err := parseExpr(s)
+	if err != nil {
+		return "", false, panicsOn(err)
+	}
+	if !Known.optionsBySurface {
+		if o.FailComplexExpressions && e.isExpression() {
+			return "", false, false
+		}
+		for _, a := range e.atoms() {
+			if o.FailAllLicenseRefs && a.ref {
+				return "", false, false
+			}
+			if o.FailAllDocumentRefs && a.ref && a.hasDoc {
+				return "", false, false
+			}
+			if _, dep := deprecated(a.id); o.FailDeprecatedLicenses && !a.ref && dep {
+				return "", false, false
+			}
+		}
+	}
+	return e.String(), true, false
+}
diff --git a/spdxexp/hegel_pins_test.go b/spdxexp/hegel_pins_test.go
new file mode 100644
index 0000000..363f9b0
--- /dev/null
+++ b/spdxexp/hegel_pins_test.go
@@ -0,0 +1,208 @@
+package spdxexp_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/github/go-spdx/v2/spdxexp"
+)
+
+func sat(t *testing.T, e string, allowed []string, want bool) {
+	t.Helper()
+	got, err := spdxexp.Satisfies(e, allowed)
+	if err != nil {
+		t.Errorf("Satisfies(%q, %q) = %v; want %v", e, allowed, err, want)
+		return
+	}
+	if got != want {
+		t.Errorf("Satisfies(%q, %q) = %v; want %v", e, allowed, got, want)
+	}
+}
+
+// go-spdx/1: a LicenseRef term of an OR is dropped from the expansion: a false negative, and a
+// false positive when the OR sits under an AND.
+func TestHegelPinSatisfiesLicenseRefInOr(t *testing.T) {
+	sat(t, "LicenseRef-x OR MIT", []string{"LicenseRef-x"}, true)
+	sat(t, "MIT OR LicenseRef-x", []string{"LicenseRef-x"}, true)
+	sat(t, "MIT AND (LicenseRef-a OR LicenseRef-b)", []string{"MIT"}, false)
+	sat(t, "MIT AND (LicenseRef-a OR LicenseRef-b)", []string{"MIT", "LicenseRef-b"}, true)
+	sat(t, "(LicenseRef-a OR LicenseRef-b) AND MIT", []string{"MIT", "LicenseRef-a"}, true)
+}
+
+// go-spdx/2: the terms of an AND with an OR on the left are built by appending to a slice with
+// spare capacity, so every alternative ends with the last one.
+func TestHegelPinSatisfiesAndOfOrKeepsAllTerms(t *testing.T) {
+	e := "((MIT AND ISC) AND BSD-3-Clause) AND (Apache-2.0 OR GPL-3.0-only)"
+	sat(t, e, []string{"MIT", "ISC", "BSD-3-Clause", "Apache-2.0"}, true)
+	sat(t, e, []string{"MIT", "ISC", "BSD-3-Clause", "GPL-3.0-only"}, true)
+}
+
+// go-spdx/3: an OR alternative that is an AND containing an OR keeps only its first term.
+func TestHegelPinSatisfiesOrKeepsAllAndTerms(t *testing.T) {
+	e := "MIT OR ((ISC OR BSD-3-Clause) AND Apache-2.0)"
+	sat(t, e, []string{"BSD-3-Clause", "Apache-2.0"}, true)
+	sat(t, e, []string{"ISC", "Apache-2.0"}, true)
+}
+
+// go-spdx/4: Satisfies panics when an OR alternative is an AND whose left side is an OR of
+// LicenseRefs.
+func TestHegelPinSatisfiesDoesNotPanic(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("Satisfies panicked: %v", r)
+		}
+	}()
+	sat(t, "MIT OR ((LicenseRef-a OR LicenseRef-b) AND ISC)", []string{"ISC", "LicenseRef-a"}, true)
+}
+
+// go-spdx/16: the parser dereferences a nil token when the input ends after "(" or a
+// DocumentRef.
+func TestHegelPinParserDoesNotPanic(t *testing.T) {
+	for _, s := range []string{"(", "MIT AND (", "DocumentRef-x", "DocumentRef-x:", "MIT OR DocumentRef-x"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("ValidateLicenses(%q) panicked: %v", s, r)
+				}
+			}()
+			if ok, _ := spdxexp.ValidateLicenses([]string{s}); ok {
+				t.Errorf("ValidateLicenses(%q) = valid", s)
+			}
+		}()
+	}
+}
+
+// go-spdx/5: ValidateLicensesOptions are decided from the shape of the string, not from the
+// parsed expression: references, deprecated licenses and complex expressions pass when they
+// are inside an expression or parentheses.
+func TestHegelPinValidateOptionsApplyInsideExpressions(t *testing.T) {
+	cases := []struct {
+		in string
+		o  spdxexp.ValidateLicensesOptions
+	}{
+		{"MIT OR LicenseRef-x", spdxexp.ValidateLicensesOptions{FailAllLicenseRefs: true}},
+		{"(LicenseRef-x)", spdxexp.ValidateLicensesOptions{FailAllLicenseRefs: true}},
+		{"MIT OR DocumentRef-d:LicenseRef-x", spdxexp.ValidateLicensesOptions{FailAllDocumentRefs: true}},
+		{"GPL-2.0 AND MIT", spdxexp.ValidateLicensesOptions{FailDeprecatedLicenses: true}},
+		{"(GPL-2.0)", spdxexp.ValidateLicensesOptions{FailDeprecatedLicenses: true}},
+		{"(MIT)AND(ISC)", spdxexp.ValidateLicensesOptions{FailComplexExpressions: true}},
+	}
+	for _, tc := range cases {
+		if ok, inv := spdxexp.ValidateLicensesWithOptions([]string{tc.in}, tc.o); ok {
+			t.Errorf("ValidateLicensesWithOptions(%q, %+v) = valid %q; the option should reject it", tc.in, tc.o, inv)
+		}
+	}
+}
+
+// go-spdx/6: the WITH fast path of ValidateLicenses rejects valid expressions without parsing
+// them.
+func TestHegelPinValidateWithFastPath(t *testing.T) {
+	for _, s := range []string{"MIT+ WITH Classpath-exception-2.0", "Apache-1.0+ WITH LLVM-exception", "(MIT WITH Classpath-exception-2.0)", "(GPL-2.0 WITH Bison-exception-2.2)"} {
+		if ok, inv := spdxexp.ValidateLicenses([]string{s}); !ok {
+			t.Errorf("ValidateLicenses(%q) = invalid %q; Satisfies parses it", s, inv)
+		}
+	}
+}
+
+// go-spdx/7: the MIT fast path of Satisfies compares strings: MIT is not satisfied by MIT+ nor
+// by "MIT " while ISC is by ISC+ and "ISC ".
+func TestHegelPinSatisfiesMITLikeOthers(t *testing.T) {
+	sat(t, "MIT", []string{"MIT+"}, true)
+	sat(t, "MIT", []string{"MIT "}, true)
+	sat(t, "ISC", []string{"ISC+"}, true)
+	sat(t, "ISC", []string{"ISC "}, true)
+}
+
+// go-spdx/8: the README says an invalid entry in the allowed list produces an error; the fast
+// paths return true first.
+func TestHegelPinSatisfiesValidatesAllowedList(t *testing.T) {
+	for _, e := range []string{"MIT", "ISC", "MIT WITH Classpath-exception-2.0"} {
+		allowed := []string{e, "BOGUS"}
+		if ok, err := spdxexp.Satisfies(e, allowed); err == nil {
+			t.Errorf("Satisfies(%q, %q) = %v, nil; the README promises an error for an invalid allowed license", e, allowed, ok)
+		}
+	}
+}
+
+// go-spdx/9: identifiers with an -only or -or-later suffix that are not on the list are
+// accepted as the base identifier, and the -or-later rewrite swallows the following character.
+func TestHegelPinSuffixIdentifiersRejected(t *testing.T) {
+	for _, s := range []string{"MIT-only", "Apache-2.0-or-later", "MIT-or-later", "GPL-2.0-only+"} {
+		if ok, _ := spdxexp.ValidateLicenses([]string{s}); ok {
+			n, _ := spdxexp.ValidateAndNormalizeLicensesWithOptions([]string{s}, spdxexp.ValidateLicensesOptions{})
+			t.Errorf("ValidateLicenses(%q) = valid (normalized %q); it is not an SPDX identifier", s, n)
+		}
+	}
+	if ok, inv := spdxexp.ValidateLicenses([]string{"(Apache-2.0-or-later) AND MIT"}); !ok {
+		t.Errorf("(Apache-2.0-or-later) AND MIT: invalid %q while Apache-2.0-or-later AND MIT is valid", inv)
+	}
+}
+
+// go-spdx/10: "LicenseRef-x WITH exception" is valid SPDX (simple-expression WITH
+// license-exception-id) but a syntax error here.
+func TestHegelPinLicenseRefWithException(t *testing.T) {
+	s := "LicenseRef-x WITH Classpath-exception-2.0"
+	if ok, inv := spdxexp.ValidateLicenses([]string{s}); !ok {
+		t.Errorf("ValidateLicenses(%q) = invalid %q; the grammar allows a LicenseRef WITH an exception", s, inv)
+	}
+}
+
+// go-spdx/11: AND, OR and WITH are matched as prefixes: "MIT ANDMIT" is MIT AND MIT.
+func TestHegelPinKeywordsNeedSeparation(t *testing.T) {
+	for _, s := range []string{"MIT ANDMIT", "MIT ORISC", "MIT WITHClasspath-exception-2.0"} {
+		if ok, _ := spdxexp.ValidateLicenses([]string{s}); ok {
+			t.Errorf("ValidateLicenses(%q) = valid; the keyword is glued to an identifier", s)
+		}
+	}
+}
+
+// go-spdx/12: a lower-case "with" is accepted by the WITH fast paths only.
+func TestHegelPinLowercaseWithConsistent(t *testing.T) {
+	s := "MIT with Classpath-exception-2.0"
+	okV, _ := spdxexp.ValidateLicenses([]string{s})
+	_, errE := spdxexp.ExtractLicenses(s)
+	if okV != (errE == nil) {
+		t.Errorf("ValidateLicenses(%q) = %v but ExtractLicenses parses it: %v", s, okV, errE)
+	}
+	a, errA := spdxexp.Satisfies(s, []string{"MIT WITH Classpath-exception-2.0"})
+	_, errB := spdxexp.Satisfies(s, []string{"MIT"})
+	if (errA == nil) != (errB == nil) {
+		t.Errorf("Satisfies(%q) = %v, %v against its own text but %v against MIT", s, a, errA, errB)
+	}
+}
+
+// go-spdx/13: an atomic deprecated "+" identifier is normalized to itself, in an expression to
+// the -or-later identifier.
+func TestHegelPinPlusNormalizationConsistent(t *testing.T) {
+	n1, _ := spdxexp.ValidateAndNormalizeLicensesWithOptions([]string{"GPL-2.0+"}, spdxexp.ValidateLicensesOptions{})
+	n2, _ := spdxexp.ValidateAndNormalizeLicensesWithOptions([]string{"(GPL-2.0+)"}, spdxexp.ValidateLicensesOptions{})
+	if len(n1) != 1 || len(n2) != 1 || n1[0] != n2[0] {
+		t.Errorf("GPL-2.0+ normalizes to %q alone and to %q in parentheses", n1, n2)
+	}
+}
+
+// go-spdx/14: ExtractLicenses returns the licenses in a random order (the README shows a
+// fixed one).
+func TestHegelPinExtractLicensesDeterministic(t *testing.T) {
+	seen := map[string]bool{}
+	for i := 0; i < 50; i++ {
+		l, err := spdxexp.ExtractLicenses("(MIT AND APACHE-2.0) OR (APACHE-2.0) OR ISC OR BSD-3-Clause")
+		if err != nil {
+			t.Fatal(err)
+		}
+		seen[strings.Join(l, ",")] = true
+	}
+	if len(seen) != 1 {
+		t.Errorf("ExtractLicenses returned %d different orders in 50 calls", len(seen))
+	}
+}
+
+// go-spdx/15: the second MPL range group, which places MPL-2.0-no-copyleft-exception after
+// MPL-1.1, is never reached because MPL-1.0 and MPL-1.1 are found in the first group.
+func TestHegelPinMPLNoCopyleftExceptionInRange(t *testing.T) {
+	sat(t, "MPL-2.0-no-copyleft-exception", []string{"MPL-1.0+"}, true)
+	sat(t, "MPL-2.0-no-copyleft-exception", []string{"MPL-1.1+"}, true)
+}
diff --git a/spdxexp/hegel_props_test.go b/spdxexp/hegel_props_test.go
new file mode 100644
index 0000000..387194d
--- /dev/null
+++ b/spdxexp/hegel_props_test.go
@@ -0,0 +1,1175 @@
+package spdxexp_test
+
+// Generators and the five wide properties on Satisfies, ValidateLicenses and ExtractLicenses.
+//
+// Every generator is a package-level value. An atom is a record (pool identifier, case form,
+// suffix spelling, LicenseRef/DocumentRef form, WITH exception part) rendered by atomSpec.text;
+// an expression is a tree of such records from depth-indexed generators, where the recorded
+// bug shapes (a LicenseRef alternative of an OR, an OR of references under an AND, an OR
+// alternative that is an AND containing an OR, the same with an OR of references on the left,
+// a left-nested AND chain of five licenses) are explicit alternatives beside the plain ones;
+// the whitespace and parentheses are a spelling record of tapes read modulo the node count by
+// the pure render; the allowed list is a record derived from the tree (its own atoms in
+// several forms, pool strangers, range neighbours, invalid entries and expressions); a
+// mutation is a list of edit records applied modulo the live length.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/github/go-spdx/v2/spdxexp"
+	"github.com/github/go-spdx/v2/spdxexp/spdxlicenses"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- pools
+
+// raw identifiers as a user writes them; active, deprecated, and deprecated "+" bases
+var licensePool = []string{
+	"MIT", "ISC", "Apache-2.0", "Apache-1.0", "Apache-1.1", "BSD-3-Clause", "BSD-2-Clause",
+	"GPL-2.0-only", "GPL-3.0-only", "GPL-2.0-or-later", "GPL-3.0-or-later", "GPL-1.0-or-later",
+	"LGPL-2.1-only", "LGPL-3.0-only", "LGPL-2.1-or-later", "LGPL-2.0-or-later",
+	"MPL-2.0", "MPL-1.1", "MPL-1.0", "MPL-2.0-no-copyleft-exception", "EPL-1.0", "EPL-2.0", "CC-BY-4.0", "CC-BY-3.0",
+	"AGPL-3.0-only", "AGPL-3.0-or-later", "Zlib", "0BSD", "Unlicense", "CDDL-1.0", "CDDL-1.1",
+	"GPL-2.0", "GPL-3.0", "GPL-1.0", "LGPL-2.1", "LGPL-2.0", "LGPL-3.0", "AGPL-3.0", "eCos-2.0", "Nunit",
+	"GFDL-1.1", "GFDL-1.2-only", "GFDL-1.3-or-later", "OSL-2.0", "OSL-3.0", "AFL-2.1", "AFL-3.0",
+}
+
+// the deprecated "+" identifiers, which the scanner reads as the -or-later licenses
+var deprecatedPlusPool = []string{"GPL-2.0+", "GPL-3.0+", "LGPL-2.1+", "GPL-1.0+", "LGPL-2.0+", "LGPL-3.0+"}
+
+var exceptionPool = []string{"Classpath-exception-2.0", "Bison-exception-2.2", "GCC-exception-3.1", "LLVM-exception", "389-exception", "Autoconf-exception-3.0"}
+
+var (
+	lrefPool = []string{"a", "b", "c.d-1", "A"}
+	docPool  = []string{"doc", "d2"}
+)
+
+// TestHegelPoolsAreKnown makes sure the pools name identifiers the package knows, so that the
+// generated expressions are valid.
+func TestHegelPoolsAreKnown(t *testing.T) {
+	for _, id := range licensePool {
+		_, a := active(id)
+		_, d := deprecated(id)
+		if !a && !d {
+			t.Errorf("%q is neither active nor deprecated in this version", id)
+		}
+	}
+	for _, id := range deprecatedPlusPool {
+		if _, d := deprecated(id); !d {
+			t.Errorf("%q is not deprecated in this version", id)
+		}
+		if _, a := active(strings.TrimSuffix(id, "+") + "-or-later"); !a {
+			t.Errorf("%q has no active -or-later form in this version", id)
+		}
+	}
+	for _, id := range exceptionPool {
+		if _, ok := exception(id); !ok {
+			t.Errorf("%q is not an exception in this version", id)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- atoms
+
+// excSpec is the "WITH exception" part of an atom: the exception, its case form, the WITH
+// keyword as written and the spaces around it. The zero value is no exception.
+type excSpec struct {
+	id   string
+	form int
+	with string // "WITH", or "with" (go-spdx/12)
+	gapL string // " " or "  "
+	gapR string // " ", "  ", or "" (the keyword glued to the exception, go-spdx/11)
+}
+
+// atomSpec is a license or a reference as a user writes it.
+type atomSpec struct {
+	ref    bool
+	raw    string  // license: the pool identifier (a deprecated "+" one too, go-spdx/13); reference: the LicenseRef idstring
+	doc    string  // reference: the DocumentRef idstring, "" for none
+	form   int     // 0 as written, 1 lower-case, 2 upper-case
+	suffix string  // license: "", "+", or an unlisted "-only" / "-or-later" (go-spdx/9)
+	exc    excSpec // on a reference: go-spdx/10
+}
+
+func cased(s string, form int) string {
+	switch form {
+	case 1:
+		return strings.ToLower(s)
+	case 2:
+		return strings.ToUpper(s)
+	}
+	return s
+}
+
+func (a atomSpec) text() string {
+	var s string
+	if a.ref {
+		s = "LicenseRef-" + a.raw
+		if a.doc != "" {
+			s = "DocumentRef-" + a.doc + ":" + s
+		}
+	} else {
+		s = cased(a.raw, a.form) + a.suffix
+	}
+	if a.exc.id != "" {
+		s += a.exc.gapL + a.exc.with + a.exc.gapR + cased(a.exc.id, a.exc.form)
+	}
+	return s
+}
+
+// canonical is the model's reading of the atom on its own: nil when the grammar, as the model
+// states it under the current switches, rejects it.
+func (a atomSpec) canonical() *atom {
+	e, err := parseExpr(a.text())
+	if err != nil || e.isExpression() {
+		return nil
+	}
+	return e.a
+}
+
+func (a atomSpec) GoString() string { return fmt.Sprintf("%q", a.text()) }
+
+var (
+	caseForms  = pick(0, 0, 0, 0, 0, 0, 0, 0, 1, 2) // as written four times in five
+	licenseIDs = weighted(
+		choice[string]{12, hegel.SampledFrom(licensePool)},
+		choice[string]{1, hegel.SampledFrom(deprecatedPlusPool)},
+		choice[string]{1, hegel.Just("MIT")}, // the fast path's license, often
+	)
+	suffixes = weighted(
+		choice[string]{68, hegel.Just("")},
+		choice[string]{28, hegel.Just("+")},
+		choice[string]{2, hegel.Just("-only")},
+		choice[string]{2, hegel.Just("-or-later")},
+	)
+	withKeywords = weighted(choice[string]{94, hegel.Just("WITH")}, choice[string]{6, hegel.Just("with")})
+	gapsBefore   = weighted(choice[string]{85, hegel.Just(" ")}, choice[string]{15, hegel.Just("  ")})
+	gapsAfter    = weighted(choice[string]{80, hegel.Just(" ")}, choice[string]{14, hegel.Just("  ")}, choice[string]{6, hegel.Just("")})
+	excSpecs     = hegel.Composite(func(tc hegel.TestCase) excSpec {
+		return excSpec{
+			id:   hegel.Draw(tc, hegel.SampledFrom(exceptionPool)),
+			form: hegel.Draw(tc, caseForms),
+			with: hegel.Draw(tc, withKeywords),
+			gapL: hegel.Draw(tc, gapsBefore),
+			gapR: hegel.Draw(tc, gapsAfter),
+		}
+	})
+	licenseAtoms = hegel.Composite(func(tc hegel.TestCase) atomSpec {
+		return atomSpec{
+			raw:    hegel.Draw(tc, licenseIDs),
+			form:   hegel.Draw(tc, caseForms),
+			suffix: hegel.Draw(tc, suffixes),
+			exc:    hegel.Draw(tc, maybe(15, excSpecs)),
+		}
+	})
+	refAtoms = hegel.Composite(func(tc hegel.TestCase) atomSpec {
+		return atomSpec{
+			ref: true,
+			raw: hegel.Draw(tc, hegel.SampledFrom(lrefPool)),
+			doc: hegel.Draw(tc, maybe(40, hegel.SampledFrom(docPool))),
+			exc: hegel.Draw(tc, maybe(8, excSpecs)),
+		}
+	})
+	atoms = weighted(choice[atomSpec]{85, licenseAtoms}, choice[atomSpec]{15, refAtoms})
+)
+
+// --------------------------------------------------------------------------- trees
+
+// node is an expression tree of atom records.
+type node struct {
+	op   int
+	atom atomSpec
+	l, r *node
+}
+
+func leaf(a atomSpec) *node { return &node{op: opAtom, atom: a} }
+
+func binary(op int, l, r *node) *node { return &node{op: op, l: l, r: r} }
+
+func (e *node) atoms() []atomSpec {
+	if e.op == opAtom {
+		return []atomSpec{e.atom}
+	}
+	return append(e.l.atoms(), e.r.atoms()...)
+}
+
+// canonical is the model's tree of the node's atoms, nil when the grammar rejects one.
+func (e *node) canonical() *expr {
+	if e.op == opAtom {
+		a := e.atom.canonical()
+		if a == nil {
+			return nil
+		}
+		return &expr{op: opAtom, a: a}
+	}
+	l, r := e.l.canonical(), e.r.canonical()
+	if l == nil || r == nil {
+		return nil
+	}
+	return &expr{op: e.op, l: l, r: r}
+}
+
+func prec2(e *node) int {
+	switch e.op {
+	case opAnd:
+		return 2
+	case opOr:
+		return 1
+	}
+	return 3
+}
+
+var (
+	atomNodes    = hegel.Map(atoms, leaf)
+	licenseNodes = hegel.Map(licenseAtoms, leaf)
+	refNodes     = hegel.Map(refAtoms, leaf)
+)
+
+// binaries is a node of op over l and r.
+func binaries(op int, l, r hegel.Generator[*node]) hegel.Generator[*node] {
+	return hegel.Composite(func(tc hegel.TestCase) *node {
+		return binary(op, hegel.Draw(tc, l), hegel.Draw(tc, r))
+	})
+}
+
+// sided is a node of op with x on one side and y on the other, x on the left first.
+func sided(op int, x, y hegel.Generator[*node]) hegel.Generator[*node] {
+	return hegel.Composite(func(tc hegel.TestCase) *node {
+		a, b := hegel.Draw(tc, x), hegel.Draw(tc, y)
+		if hegel.Draw(tc, chance(50)) {
+			return binary(op, b, a)
+		}
+		return binary(op, a, b)
+	})
+}
+
+// nodeKit is a set of leaf generators (any atom, licenses only, references only) with the
+// recorded Satisfies shapes built from them; wideKit draws every atom shape, plainKit (in
+// hegel_shapes_test.go) only well-formed atoms.
+type nodeKit struct {
+	atoms, licenses, refs hegel.Generator[*node]
+}
+
+var wideKit = nodeKit{atoms: atomNodes, licenses: licenseNodes, refs: refNodes}
+
+// refInOr: an OR with a LicenseRef alternative (go-spdx/1).
+func (k nodeKit) refInOr(sub hegel.Generator[*node]) hegel.Generator[*node] {
+	return sided(opOr, k.refs, sub)
+}
+
+// refOrUnderAnd: an AND with an OR of LicenseRefs as one side (go-spdx/1, the false positive).
+func (k nodeKit) refOrUnderAnd(sub hegel.Generator[*node]) hegel.Generator[*node] {
+	return sided(opAnd, binaries(opOr, k.refs, k.refs), sub)
+}
+
+// orOfAndWithOr: an OR alternative that is an AND containing an OR (go-spdx/3).
+func (k nodeKit) orOfAndWithOr(sub hegel.Generator[*node]) hegel.Generator[*node] {
+	return sided(opOr, sided(opAnd, binaries(opOr, k.atoms, k.atoms), k.atoms), sub)
+}
+
+// orOfAndOfRefOr: an OR alternative that is an AND whose left side is an OR of LicenseRefs
+// (go-spdx/4).
+func (k nodeKit) orOfAndOfRefOr(sub hegel.Generator[*node]) hegel.Generator[*node] {
+	return sided(opOr, binaries(opAnd, binaries(opOr, k.refs, k.refs), k.atoms), sub)
+}
+
+// nestedAndChain: ((a AND b) AND c) AND (d OR e), five licenses with a left-nested AND
+// (go-spdx/2).
+func (k nodeKit) nestedAndChain() hegel.Generator[*node] {
+	return binaries(opAnd,
+		binaries(opAnd, binaries(opAnd, k.licenses, k.licenses), k.licenses),
+		binaries(opOr, k.licenses, k.licenses))
+}
+
+// levels is the expression grammar by depth: level 0 is an atom, level d an atom, an AND or
+// an OR of level d-1 trees, or (with shapes) one of the recorded shapes around level d-1 trees.
+func (k nodeKit) levels(depth int, shapes bool) []hegel.Generator[*node] {
+	levels := []hegel.Generator[*node]{k.atoms}
+	for d := 1; d <= depth; d++ {
+		sub := levels[d-1]
+		choices := []choice[*node]{
+			{40, k.atoms},
+			{16, binaries(opAnd, sub, sub)},
+			{16, binaries(opOr, sub, sub)},
+		}
+		if shapes {
+			choices = append(choices,
+				choice[*node]{7, k.refInOr(sub)},
+				choice[*node]{5, k.refOrUnderAnd(sub)},
+				choice[*node]{6, k.orOfAndWithOr(sub)},
+				choice[*node]{6, k.orOfAndOfRefOr(sub)},
+				// under HEGEL_NO_KNOWN=1 the generator keeps to four licenses (go-spdx/2)
+				choice[*node]{shaped(4, 0), k.nestedAndChain()},
+			)
+		}
+		levels = append(levels, weighted(choices...))
+	}
+	return levels
+}
+
+var exprLevels = wideKit.levels(3, true)
+
+// exprs: trees of depth up to three; under HEGEL_NO_KNOWN=1 of depth up to two and at most
+// four licenses, where no slice of the package's expansion has spare capacity (go-spdx/2).
+var exprs = shaped[hegel.Generator[*node]](
+	exprLevels[3],
+	hegel.Filter(exprLevels[2], func(e *node) bool { return len(e.atoms()) <= 4 }),
+)
+
+// --------------------------------------------------------------------------- spelling
+
+// gap is the spaces around an AND or OR keyword.
+type gap struct{ before, after string }
+
+// spelling is how a tree is written: the gaps around its keywords and the parentheses around
+// its nodes, as tapes read modulo their length in order of appearance (empty tapes: single
+// spaces, parentheses only where needed); tight writes no spaces at all and parenthesises every
+// operand ("(MIT)AND(ISC)", an expression without a space: go-spdx/5); lead and trail are
+// spaces around the whole.
+type spelling struct {
+	gaps        []gap
+	parens      []int // 0 none, 1 "(x)", 2 "( x )"
+	tight       bool
+	lead, trail string
+}
+
+var (
+	gapPairs = hegel.Composite(func(tc hegel.TestCase) gap {
+		return gap{
+			before: hegel.Draw(tc, weighted(choice[string]{84, hegel.Just(" ")}, choice[string]{13, hegel.Just("  ")}, choice[string]{3, hegel.Just("")})),
+			after:  hegel.Draw(tc, gapsAfter),
+		}
+	})
+	parenStyles = weighted(choice[int]{70, hegel.Just(0)}, choice[int]{22, hegel.Just(1)}, choice[int]{8, hegel.Just(2)})
+	spellings   = hegel.Composite(func(tc hegel.TestCase) spelling {
+		return spelling{
+			gaps:   hegel.Draw(tc, counted(gapPairs, 0, 3)),
+			parens: hegel.Draw(tc, counted(parenStyles, 0, 5)),
+			tight:  hegel.Draw(tc, chance(5)),
+			lead:   hegel.Draw(tc, maybe(10, hegel.Just(" "))),
+			trail:  hegel.Draw(tc, maybe(10, hegel.Just(" "))),
+		}
+	})
+)
+
+// marks is what a rendering has that the grammar does not allow: a keyword touching an
+// identifier (go-spdx/11 on the right of it), an unlisted -only/-or-later suffix (go-spdx/9),
+// a lower-case with (go-spdx/12). A clean rendering is one the model must parse back to the
+// tree it was rendered from.
+type marks struct {
+	glue, suffix, lowerWith bool
+}
+
+func (m marks) clean() bool { return !m.glue && !m.suffix && !m.lowerWith }
+
+type renderer struct {
+	sp         spelling
+	gapI, posI int
+	marks      marks
+}
+
+func isIdentByte(c byte) bool {
+	return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9'
+}
+
+func (r *renderer) gap() gap {
+	if r.sp.tight {
+		return gap{}
+	}
+	if len(r.sp.gaps) == 0 {
+		return gap{" ", " "}
+	}
+	g := r.sp.gaps[r.gapI%len(r.sp.gaps)]
+	r.gapI++
+	return g
+}
+
+func (r *renderer) paren() int {
+	if len(r.sp.parens) == 0 {
+		return 0
+	}
+	p := r.sp.parens[r.posI%len(r.sp.parens)]
+	r.posI++
+	return p
+}
+
+// node renders e under parent (nil at the root). An operand that binds looser than its parent,
+// or an operand of its parent's own operator on the left (the parser is right-recursive), is
+// parenthesised whatever the tape says, so that the text parses back to the tree.
+func (r *renderer) node(e *node, parent *node) string {
+	p := r.paren()
+	var s string
+	if e.op == opAtom {
+		a := e.atom
+		s = a.text()
+		if a.suffix == "-only" || a.suffix == "-or-later" {
+			r.marks.suffix = true
+		}
+		if a.exc.id != "" {
+			if a.exc.with != "WITH" {
+				r.marks.lowerWith = true
+			}
+			if a.exc.gapR == "" {
+				r.marks.glue = true
+			}
+		}
+	} else {
+		g := r.gap()
+		l := r.node(e.l, e)
+		rt := r.node(e.r, e)
+		kw := "AND"
+		if e.op == opOr {
+			kw = "OR"
+		}
+		if g.before == "" && isIdentByte(l[len(l)-1]) || g.after == "" && isIdentByte(rt[0]) {
+			r.marks.glue = true
+		}
+		s = l + g.before + kw + g.after + rt
+	}
+	if parent != nil && (r.sp.tight || e.op != opAtom && (prec2(e) < prec2(parent) || e.op == parent.op && parent.l == e)) {
+		p = max(p, 1)
+	}
+	switch p {
+	case 1:
+		s = "(" + s + ")"
+	case 2:
+		s = "( " + s + " )"
+	}
+	return s
+}
+
+// render is the text of the tree under the spelling, and its marks.
+func render(e *node, sp spelling) (string, marks) {
+	r := &renderer{sp: sp}
+	s := sp.lead + r.node(e, nil) + sp.trail
+	return s, r.marks
+}
+
+// exprCase is a tree and its spelling.
+type exprCase struct {
+	tree *node
+	sp   spelling
+}
+
+func (c exprCase) text() string {
+	s, _ := render(c.tree, c.sp)
+	return s
+}
+
+func (c exprCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+var exprCases = hegel.Composite(func(tc hegel.TestCase) exprCase {
+	return exprCase{tree: hegel.Draw(tc, exprs), sp: hegel.Draw(tc, spellings)}
+})
+
+// --------------------------------------------------------------------------- allowed lists
+
+// ownEntry is one of the tree's atoms in the allowed list: at indexes the atoms modulo their
+// count; form is the canonical text, the text as written, the canonical text lower- or
+// upper-cased, padded with spaces, or with a "+" added (the last two: go-spdx/7).
+type ownEntry struct{ at, form int }
+
+// neighbour is a license of the range group of one of the tree's atoms: the k-th of the
+// group's licenses modulo their count, with or without "+" (go-spdx/15 among them).
+type neighbour struct {
+	at, k int
+	plus  bool
+}
+
+// allowedSpec is the allowed list derived from a tree.
+type allowedSpec struct {
+	empty      bool
+	own        []ownEntry
+	strangers  []atomSpec
+	neighbours []neighbour
+	extras     []string // invalid entries and expressions
+	rotate     int
+}
+
+// ownText is the own entry's text for the atom.
+func ownText(a atomSpec, form int) string {
+	text := a.text()
+	if c := a.canonical(); c != nil {
+		text = c.String()
+	}
+	switch form {
+	case 1:
+		return a.text()
+	case 2:
+		return strings.ToLower(text)
+	case 3:
+		return strings.ToUpper(text)
+	case 4:
+		return " " + text + " "
+	case 5:
+		if a.ref || a.suffix != "" {
+			return text
+		}
+		lic, rest, _ := strings.Cut(text, " ")
+		if strings.HasSuffix(lic, "+") || strings.HasSuffix(lic, "-or-later") {
+			return text
+		}
+		if rest != "" {
+			return lic + "+ " + rest
+		}
+		return lic + "+"
+	}
+	return text
+}
+
+// groupMates is every license of every range group the license belongs to.
+func groupMates(id string) []string {
+	var out []string
+	simple := simplify(id)
+	for _, group := range spdxlicenses.LicenseRanges() {
+		for _, version := range group {
+			if slices.Contains(version, simple) {
+				for _, v := range group {
+					out = append(out, v...)
+				}
+				break
+			}
+		}
+	}
+	return out
+}
+
+func (a allowedSpec) list(e *node) []string {
+	if a.empty {
+		return nil
+	}
+	atoms := e.atoms()
+	var out []string
+	for _, o := range a.own {
+		out = append(out, ownText(atoms[o.at%len(atoms)], o.form))
+	}
+	for _, s := range a.strangers {
+		out = append(out, s.text())
+	}
+	for _, nb := range a.neighbours {
+		at := atoms[nb.at%len(atoms)]
+		c := at.canonical()
+		if at.ref || c == nil {
+			continue
+		}
+		mates := groupMates(c.id)
+		if len(mates) == 0 {
+			continue
+		}
+		lic := mates[nb.k%len(mates)]
+		if nb.plus {
+			lic += "+"
+		}
+		out = append(out, lic)
+	}
+	out = append(out, a.extras...)
+	if len(out) > 1 {
+		k := a.rotate % len(out)
+		out = append(out[k:], out[:k]...)
+	}
+	return out
+}
+
+var (
+	ownEntries = hegel.Composite(func(tc hegel.TestCase) ownEntry {
+		return ownEntry{at: hegel.Draw(tc, hegel.Integers(0, 7)), form: hegel.Draw(tc, pick(0, 0, 0, 1, 2, 3, 4, 5))}
+	})
+	neighbours = hegel.Composite(func(tc hegel.TestCase) neighbour {
+		return neighbour{at: hegel.Draw(tc, hegel.Integers(0, 7)), k: hegel.Draw(tc, hegel.Integers(0, 5)), plus: hegel.Draw(tc, chance(50))}
+	})
+	extraEntries = pick("BOGUS", "MIT AND ISC", "MIT OR ISC", "", "MIT+ WITH", "LicenseRef-", "DocumentRef-x", "MIT AND (", "(",
+		"DocumentRef-x:", "MIT-only", "mit with Classpath-exception-2.0", "MIT ANDISC")
+	allowedSpecs = hegel.Composite(func(tc hegel.TestCase) allowedSpec {
+		return allowedSpec{
+			empty:      hegel.Draw(tc, chance(3)),
+			own:        hegel.Draw(tc, counted(ownEntries, 0, 4)),
+			strangers:  hegel.Draw(tc, counted(atoms, 0, 3)),
+			neighbours: hegel.Draw(tc, counted(neighbours, 0, 1)),
+			extras:     hegel.Draw(tc, maybe(15, counted(extraEntries, 1, 2))),
+			rotate:     hegel.Draw(tc, hegel.Integers(0, 7)),
+		}
+	})
+)
+
+// cleanAllowed is an allowed list of valid entries derived from a tree: canonical forms of its
+// grammatical atoms (a license without exception lower- or upper-cased at times) and of pool
+// strangers; "MIT" when nothing is left.
+type cleanAllowed struct {
+	own       []ownEntry // form 0 canonical, 1 lower-case, 2 upper-case
+	strangers []atomSpec
+	rotate    int
+}
+
+func (a cleanAllowed) list(e *node) []string {
+	atoms := e.atoms()
+	var out []string
+	add := func(s atomSpec, form int) {
+		c := s.canonical()
+		if c == nil {
+			return
+		}
+		text := c.String()
+		if !c.ref && c.exc == "" {
+			text = cased(text, form)
+		}
+		out = append(out, text)
+	}
+	for _, o := range a.own {
+		add(atoms[o.at%len(atoms)], o.form)
+	}
+	for _, s := range a.strangers {
+		add(s, 0)
+	}
+	if len(out) == 0 {
+		return []string{"MIT"}
+	}
+	k := a.rotate % len(out)
+	return append(out[k:], out[:k]...)
+}
+
+// cleanAllowedOf is a clean allowed list with strangers from the given atoms.
+func cleanAllowedOf(strangers hegel.Generator[atomSpec]) hegel.Generator[cleanAllowed] {
+	return hegel.Composite(func(tc hegel.TestCase) cleanAllowed {
+		return cleanAllowed{
+			own: hegel.Draw(tc, counted(hegel.Composite(func(tc hegel.TestCase) ownEntry {
+				return ownEntry{at: hegel.Draw(tc, hegel.Integers(0, 7)), form: hegel.Draw(tc, caseForms)}
+			}), 0, 4)),
+			strangers: hegel.Draw(tc, counted(strangers, 0, 3)),
+			rotate:    hegel.Draw(tc, hegel.Integers(0, 7)),
+		}
+	})
+}
+
+var cleanAllowedSpecs = cleanAllowedOf(atoms)
+
+// --------------------------------------------------------------------------- mutations
+
+const (
+	editDelete = iota
+	editTruncate
+	editRecase
+	editReplace
+	editInsert
+)
+
+// edit is one change to a text: at and to are positions taken modulo the live length, piece
+// what an insert or replace puts in.
+type edit struct {
+	kind   int
+	at, to int
+	piece  string
+}
+
+func (e edit) GoString() string {
+	kind := [...]string{"delete", "truncate", "recase", "replace", "insert"}[e.kind]
+	switch e.kind {
+	case editTruncate:
+		return fmt.Sprintf("truncate at %d to %d", e.at, e.to)
+	case editReplace, editInsert:
+		return fmt.Sprintf("%s %q at %d", kind, e.piece, e.at)
+	}
+	return fmt.Sprintf("%s at %d", kind, e.at)
+}
+
+var mutPool = []string{" AND ", " OR ", " WITH ", "(", ")", "+", " ", "MIT", "mit", "BOGUS", "LicenseRef-z", "DocumentRef-q:", "DocumentRef-q", ":", "-only", "-or-later", " and ", " with ", "Classpath-exception-2.0", "\t", "GPL-2.0", "AND",
+	" AND MIT", " OR LicenseRef-z", " WITH Classpath-exception-2.0", " AND (", " OR DocumentRef-q", "GPL-2.0+", " AND (MIT WITH Classpath-exception-2.0)"}
+
+var (
+	// an insert or a change of case leaves most of the structure; the others cut into it
+	editKinds = weighted(
+		choice[int]{15, hegel.Just(editDelete)},
+		choice[int]{10, hegel.Just(editTruncate)},
+		choice[int]{25, hegel.Just(editRecase)},
+		choice[int]{15, hegel.Just(editReplace)},
+		choice[int]{35, hegel.Just(editInsert)},
+	)
+	edits = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{
+			kind:  hegel.Draw(tc, editKinds),
+			at:    hegel.Draw(tc, hegel.Integers(0, 79)),
+			to:    hegel.Draw(tc, hegel.Integers(0, 79)),
+			piece: hegel.Draw(tc, hegel.SampledFrom(mutPool)),
+		}
+	})
+	editLists = many(edits, 1, 2)
+)
+
+// mutate applies the edits to s in turn; an edit of the empty text is its piece.
+func mutate(s string, es []edit) string {
+	for _, e := range es {
+		if s == "" {
+			s = e.piece
+			continue
+		}
+		i := e.at % len(s)
+		switch e.kind {
+		case editDelete:
+			s = s[:i] + s[i+1:]
+		case editTruncate:
+			j := i + e.to%(len(s)-i+1)
+			s = s[:i] + s[j:]
+		case editRecase:
+			if c := s[i]; c >= 'a' && c <= 'z' {
+				s = s[:i] + strings.ToUpper(s[i:i+1]) + s[i+1:]
+			} else if c >= 'A' && c <= 'Z' {
+				s = s[:i] + strings.ToLower(s[i:i+1]) + s[i+1:]
+			}
+		case editReplace:
+			s = s[:i] + e.piece + s[i+1:]
+		case editInsert:
+			i = e.at % (len(s) + 1)
+			s = s[:i] + e.piece + s[i:]
+		}
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- judgements
+
+// The model's judgement of the package's answer on a case: "agree", or "<class>: want ...".
+// A judgement is what the wide and the narrow properties fail on, and what explains (in
+// hegel_test.go) re-evaluates under each bug's switches to name the shapes of the case.
+
+func judgeSatisfies(s string, allowed []string, got bool, err error, pan any) string {
+	want := modelSatisfies(s, allowed)
+	switch {
+	case want.panics:
+		if pan != nil {
+			return "agree"
+		}
+		return fmt.Sprintf("panic: want a panic, got %v, %v", got, err)
+	case pan != nil:
+		return fmt.Sprintf("panic: the package panics: %v", pan)
+	case want.err:
+		if err != nil {
+			return "agree"
+		}
+		return fmt.Sprintf("no error: want an error, got %v", got)
+	case err != nil:
+		return fmt.Sprintf("error: want %v, got an error: %v", want.ok, err)
+	case got != want.ok:
+		return fmt.Sprintf("verdict: want %v", want.ok)
+	}
+	return "agree"
+}
+
+func judgeValidate(inputs []string, o spdxexp.ValidateLicensesOptions, norm, invalid []string, pan, pan2 any) string {
+	var wantNorm, wantInvalid []string
+	for _, s := range inputs {
+		nm, ok, panics := modelValidate(s, o)
+		if panics {
+			if pan != nil && pan2 != nil {
+				return "agree"
+			}
+			return fmt.Sprintf("panic: want a panic, got %q invalid %q", norm, invalid)
+		}
+		if !ok {
+			wantInvalid = append(wantInvalid, strings.TrimSpace(s))
+			continue
+		}
+		if !slices.Contains(wantNorm, nm) {
+			wantNorm = append(wantNorm, nm)
+		}
+	}
+	if pan != nil || pan2 != nil {
+		return fmt.Sprintf("panic: the package panics: %v %v", pan, pan2)
+	}
+	if !slices.Equal(norm, wantNorm) || !slices.Equal(invalid, wantInvalid) {
+		return fmt.Sprintf("options: want %q invalid %q", wantNorm, wantInvalid)
+	}
+	return "agree"
+}
+
+// extraction is ExtractLicenses's answer to one text.
+type extraction struct {
+	licenses []string
+	err      error
+	pan      any
+}
+
+// extractCache remembers ExtractLicenses's answer per text for one property run, so that a
+// case keeps its verdict when the shrinker revisits it (the order of the answer is that of a
+// map's keys, go-spdx/14, and a verdict that changed on replay would make the run flaky).
+type extractCache map[string]extraction
+
+func (c extractCache) extract(s string) extraction {
+	if x, ok := c[s]; ok {
+		return x
+	}
+	var x extraction
+	x.pan = catch(func() { x.licenses, x.err = spdxexp.ExtractLicenses(s) })
+	c[s] = x
+	return x
+}
+
+func judgeNormalize(s string, norm, invalid []string, pan any, x extraction) string {
+	wantNorm, wantValid, wantPanic := modelValidate(s, spdxexp.ValidateLicensesOptions{})
+	switch {
+	case wantPanic:
+		if pan != nil && x.pan != nil {
+			return "agree"
+		}
+		return fmt.Sprintf("panic: want a panic, got %q invalid %q and the licenses %q, %v", norm, invalid, x.licenses, x.err)
+	case pan != nil || x.pan != nil:
+		return fmt.Sprintf("panic: the package panics: %v %v", pan, x.pan)
+	case !wantValid:
+		if len(invalid) != 1 || len(norm) != 0 {
+			return "validity: want invalid"
+		}
+	case len(invalid) != 0 || len(norm) != 1 || norm[0] != wantNorm:
+		return fmt.Sprintf("normalize: want %q", wantNorm)
+	}
+	// ExtractLicenses has no fast path: it follows the grammar whatever the validation said
+	e, err := parseExpr(s)
+	if err != nil {
+		if x.err == nil {
+			return fmt.Sprintf("extract: want an error, got %q", x.licenses)
+		}
+		return "agree"
+	}
+	want := modelExtract(e)
+	switch {
+	case x.err != nil:
+		return fmt.Sprintf("extract: want %q, got an error: %v", want, x.err)
+	case extractAgrees(want, x.licenses):
+		return "agree"
+	case slices.Equal(sortedSet(want), sortedSet(x.licenses)) && len(x.licenses) == len(sortedSet(x.licenses)):
+		return fmt.Sprintf("extract order: want %q", want)
+	}
+	return fmt.Sprintf("extract set: want %q", want)
+}
+
+func classOf(judgement string) string {
+	class, _, _ := strings.Cut(judgement, ":")
+	return class
+}
+
+// --------------------------------------------------------------------------- checks
+
+// checkNormalize judges ValidateAndNormalizeLicensesWithOptions and ExtractLicenses on one
+// text: valid or invalid as the model says, the normalized text the canonical rendering, the
+// extracted licenses the atoms in order of appearance (as a set under
+// Known.extractOrderRandom). bug names the narrow property's bug ("" in a wide one).
+func checkNormalize(c *collector, ht *hegel.T, ex extractCache, s, bug string) {
+	var norm, invalid []string
+	pan := catch(func() {
+		norm, invalid = spdxexp.ValidateAndNormalizeLicensesWithOptions([]string{s}, spdxexp.ValidateLicensesOptions{})
+	})
+	x := ex.extract(s)
+	judge := func() string { return judgeNormalize(s, norm, invalid, pan, x) }
+	if j := judge(); j != "agree" {
+		c.mismatch(ht, shapesOf(bug, explains(judge)), classOf(j), "ValidateAndNormalize(%q) = %q invalid %q (panic %v), ExtractLicenses = %q, %v (panic %v): %s", s, norm, invalid, pan, x.licenses, x.err, x.pan, j)
+		return
+	}
+	if e, err := parseExpr(s); err != nil {
+		c.count("invalid agreed")
+	} else if e.isExpression() {
+		c.count("ok expression")
+	} else {
+		c.count("ok atom")
+	}
+}
+
+// checkValidate judges ValidateAndNormalizeLicensesWithOptions and ValidateLicensesWithOptions
+// on the inputs under the options against the model: the normalized list in order without
+// duplicates, the invalid list in order.
+func checkValidate(c *collector, ht *hegel.T, inputs []string, o spdxexp.ValidateLicensesOptions, bug string) {
+	var norm, invalid, inv2 []string
+	var ok bool
+	pan := catch(func() { norm, invalid = spdxexp.ValidateAndNormalizeLicensesWithOptions(inputs, o) })
+	pan2 := catch(func() { ok, inv2 = spdxexp.ValidateLicensesWithOptions(inputs, o) })
+	judge := func() string { return judgeValidate(inputs, o, norm, invalid, pan, pan2) }
+	if j := judge(); j != "agree" {
+		c.mismatch(ht, shapesOf(bug, explains(judge)), classOf(j), "ValidateAndNormalize(%q, %+v) = %q invalid %q (panics %v %v): %s", inputs, o, norm, invalid, pan, pan2, j)
+		return
+	}
+	if pan == nil && (ok != (len(invalid) == 0) || !slices.Equal(inv2, invalid)) {
+		c.failClass(ht, "validate", "ValidateLicensesWithOptions(%q, %+v) = %v %q; ValidateAndNormalize says invalid %q", inputs, o, ok, inv2, invalid)
+		return
+	}
+	if len(invalid) == 0 {
+		c.count("all valid")
+	} else {
+		c.count("some invalid")
+	}
+}
+
+// satisfies is Satisfies with its panic recovered.
+func satisfies(s string, allowed []string) (got bool, err error, pan any) {
+	pan = catch(func() { got, err = spdxexp.Satisfies(s, allowed) })
+	return got, err, pan
+}
+
+// checkSatisfies judges Satisfies on the expression and the allowed list against the model:
+// an error for an empty or invalid allowed list or an invalid expression, otherwise the
+// documented verdict.
+func checkSatisfies(c *collector, ht *hegel.T, s string, allowed []string, bug string) {
+	got, err, pan := satisfies(s, allowed)
+	judge := func() string { return judgeSatisfies(s, allowed, got, err, pan) }
+	if j := judge(); j != "agree" {
+		c.mismatch(ht, shapesOf(bug, explains(judge)), classOf(j), "Satisfies(%q, %q) = %v, %v (panic %v): %s", s, allowed, got, err, pan, j)
+		return
+	}
+	want := modelSatisfies(s, allowed)
+	switch {
+	case want.err:
+		c.count("error agreed")
+	case want.ok != want.pure:
+		c.count(fmt.Sprintf("known: expansion differs from the meaning (%v)", want.pure))
+	default:
+		c.count(fmt.Sprintf("agreed %v", got))
+	}
+}
+
+// --------------------------------------------------------------------------- properties
+
+// A generated expression is valid, normalizes to the canonical rendering of its tree, and its
+// licenses are the tree's atoms in order; a rendering with a recorded shape (an unlisted
+// suffix, a glued keyword, a lower-case with, a deprecated "+" identifier alone, a WITH
+// expression with "+" or in parentheses, a reference with an exception) gets what the grammar
+// and the documentation say of it.
+func TestHegelNormalizeFollowsTheGrammar(t *testing.T) {
+	c := newCollector(t)
+	ex := extractCache{}
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, exprCases)
+		s, m := render(ec.tree, ec.sp)
+		if m.clean() {
+			// the model must read a clean rendering back as the tree it came from
+			want := ec.tree.canonical()
+			got, err := parseExpr(s)
+			switch {
+			case want == nil && err == nil:
+				c.failClass(ht, "model", "model: %q parsed as %v, but one of its atoms does not parse alone", s, got)
+				return
+			case want != nil && (err != nil || got.String() != want.String()):
+				c.failClass(ht, "model", "model: %q parsed as %v, want %s (%v)", s, got, want, err)
+				return
+			}
+		}
+		checkNormalize(c, ht, ex, s, "")
+	})
+}
+
+// edgeInputs: strings at the grammar's boundary for the validation properties.
+var edgeInputs = []string{"BOGUS", "MIT AND", "(MIT", "MIT)", "MIT WITH", "MIT WITH MIT", "Classpath-exception-2.0", "mit and isc",
+	"MIT+ WITH Classpath-exception-2.0", "(MIT WITH Classpath-exception-2.0)", "GPL-2.0+", "gpl-2.0+", "MIT-only", "Apache-2.0-or-later",
+	"LicenseRef-x WITH Classpath-exception-2.0", "MIT ANDISC", "MIT with Classpath-exception-2.0", "(MIT)AND(ISC)", "MIT\tAND ISC", "  MIT  ",
+	"MIT AND (", "DocumentRef-x", "MIT OR DocumentRef-x:"}
+
+// validateInput is one input of a validation call: a generated expression, or an edge string.
+type validateInput struct {
+	expr   exprCase
+	edge   string
+	isEdge bool
+}
+
+func (v validateInput) text() string {
+	if v.isEdge {
+		return v.edge
+	}
+	return v.expr.text()
+}
+
+type validateCase struct {
+	inputs []validateInput
+	opts   spdxexp.ValidateLicensesOptions
+}
+
+func (c validateCase) texts() []string {
+	out := make([]string, len(c.inputs))
+	for i, in := range c.inputs {
+		out[i] = in.text()
+	}
+	return out
+}
+
+func (c validateCase) GoString() string { return fmt.Sprintf("%q with %+v", c.texts(), c.opts) }
+
+var (
+	validateInputs = weighted(
+		choice[validateInput]{7, hegel.Map(exprCases, func(e exprCase) validateInput { return validateInput{expr: e} })},
+		choice[validateInput]{3, hegel.Map(hegel.SampledFrom(edgeInputs), func(s string) validateInput { return validateInput{edge: s, isEdge: true} })},
+	)
+	optionSets = hegel.Composite(func(tc hegel.TestCase) spdxexp.ValidateLicensesOptions {
+		return spdxexp.ValidateLicensesOptions{
+			FailComplexExpressions: hegel.Draw(tc, chance(30)),
+			FailDeprecatedLicenses: hegel.Draw(tc, chance(30)),
+			FailAllLicenseRefs:     hegel.Draw(tc, chance(30)),
+			FailAllDocumentRefs:    hegel.Draw(tc, chance(30)),
+		}
+	})
+	validateCases = hegel.Composite(func(tc hegel.TestCase) validateCase {
+		return validateCase{inputs: hegel.Draw(tc, many(validateInputs, 1, 3)), opts: hegel.Draw(tc, optionSets)}
+	})
+)
+
+// ValidateLicensesWithOptions follows the options as the documentation states them: applied
+// to the parsed expression, inside expressions and parentheses too.
+func TestHegelValidateOptions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		vc := hegel.Draw(ht, validateCases)
+		checkValidate(c, ht, vc.texts(), vc.opts, "")
+	})
+}
+
+// satCase is an expression and an allowed list derived from it.
+type satCase struct {
+	expr    exprCase
+	allowed allowedSpec
+}
+
+func (c satCase) list() []string { return c.allowed.list(c.expr.tree) }
+
+func (c satCase) GoString() string { return fmt.Sprintf("%q with %q", c.expr.text(), c.list()) }
+
+var satCases = hegel.Composite(func(tc hegel.TestCase) satCase {
+	return satCase{expr: hegel.Draw(tc, exprCases), allowed: hegel.Draw(tc, allowedSpecs)}
+})
+
+// Satisfies agrees with the model: an error for an empty or invalid allowed list or an invalid
+// expression, otherwise the documented verdict (one OR alternative with every ANDed license
+// covered).
+func TestHegelSatisfiesFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, satCases)
+		checkSatisfies(c, ht, sc.expr.text(), sc.list(), "")
+	})
+}
+
+// monoCase is an expression, a valid allowed list and one more valid license put at the front
+// or the back of it.
+type monoCase struct {
+	expr    exprCase
+	allowed cleanAllowed
+	extra   atomSpec
+	front   bool
+}
+
+func (c monoCase) lists() (base, more []string) {
+	base = c.allowed.list(c.expr.tree)
+	extra := "MIT"
+	if a := c.extra.canonical(); a != nil {
+		extra = a.String()
+	}
+	if c.front {
+		return base, append([]string{extra}, base...)
+	}
+	return base, append(slices.Clone(base), extra)
+}
+
+func (c monoCase) GoString() string {
+	base, more := c.lists()
+	return fmt.Sprintf("%q with %q then %q", c.expr.text(), base, more)
+}
+
+var monoCases = hegel.Composite(func(tc hegel.TestCase) monoCase {
+	return monoCase{
+		expr:    hegel.Draw(tc, exprCases),
+		allowed: hegel.Draw(tc, cleanAllowedSpecs),
+		extra:   hegel.Draw(tc, licenseAtoms),
+		front:   hegel.Draw(tc, chance(50)),
+	}
+})
+
+// Satisfies is monotone in the allowed list: adding a license never turns true into false, nor
+// a verdict into an error; it never panics.
+func TestHegelSatisfiesMonotone(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, monoCases)
+		s := mc.expr.text()
+		base, more := mc.lists()
+		a, err1, pan1 := satisfies(s, base)
+		b, err2, pan2 := satisfies(s, more)
+		judge := func() string {
+			w1, w2 := modelSatisfies(s, base), modelSatisfies(s, more)
+			switch {
+			case w1.panics || w2.panics:
+				if (pan1 != nil) == w1.panics && (pan2 != nil) == w2.panics {
+					return "agree"
+				}
+				return fmt.Sprintf("panic: want panics %v/%v, got %v/%v", w1.panics, w2.panics, pan1, pan2)
+			case pan1 != nil || pan2 != nil:
+				return fmt.Sprintf("panic: the package panics: %v / %v", pan1, pan2)
+			case err1 == nil && err2 == nil:
+				if a && !b {
+					return "monotone: true, then false with a license added"
+				}
+				return "agree"
+			case (err1 != nil) == w1.err && (err2 != nil) == w2.err:
+				return "agree"
+			}
+			return fmt.Sprintf("error: want errors %v/%v, got %v/%v", w1.err, w2.err, err1, err2)
+		}
+		if j := judge(); j != "agree" {
+			c.mismatch(ht, explains(judge), classOf(j), "Satisfies(%q, %q) = %v, %v; with %q = %v, %v: %s", s, base, a, err1, more, b, err2, j)
+			return
+		}
+		if err1 != nil {
+			c.count("error agreed")
+		} else {
+			c.count(fmt.Sprintf("%v -> %v", a, b))
+		}
+	})
+}
+
+// mutCase is an expression, edits of its text and a valid allowed list.
+type mutCase struct {
+	expr    exprCase
+	edits   []edit
+	allowed cleanAllowed
+}
+
+func (c mutCase) text() string { return mutate(c.expr.text(), c.edits) }
+
+func (c mutCase) GoString() string {
+	return fmt.Sprintf("%q from %q by %#v with %q", c.text(), c.expr.text(), c.edits, c.allowed.list(c.expr.tree))
+}
+
+var mutCases = hegel.Composite(func(tc hegel.TestCase) mutCase {
+	return mutCase{expr: hegel.Draw(tc, exprCases), edits: hegel.Draw(tc, editLists), allowed: hegel.Draw(tc, cleanAllowedSpecs)}
+})
+
+// A mutated expression: the model (the grammar with the package's leniencies) and the package
+// agree on validity, and on the verdict when valid; neither call panics.
+func TestHegelMutationsAgree(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, mutCases)
+		s := mc.text()
+		allowed := mc.allowed.list(mc.expr.tree)
+		var ok bool
+		pan := catch(func() { ok, _ = spdxexp.ValidateLicenses([]string{s}) })
+		judge := func() string {
+			_, valid, panics := modelValidate(s, spdxexp.ValidateLicensesOptions{})
+			switch {
+			case panics:
+				if pan != nil {
+					return "agree"
+				}
+				return fmt.Sprintf("panic: want a panic, got %v", ok)
+			case pan != nil:
+				return fmt.Sprintf("panic: the package panics: %v", pan)
+			case ok != valid:
+				return fmt.Sprintf("validity: want %v", valid)
+			}
+			return "agree"
+		}
+		if j := judge(); j != "agree" {
+			c.mismatch(ht, explains(judge), classOf(j), "ValidateLicenses(%q) = %v (panic %v): %s", s, ok, pan, j)
+			return
+		}
+		checkSatisfies(c, ht, s, allowed, "")
+		if ok {
+			c.count("valid agreed")
+		} else {
+			c.count("invalid agreed")
+		}
+	})
+}
