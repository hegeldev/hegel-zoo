index 0000000..23a04ba
--- /dev/null
+++ b/spdxexp/hegel_test.go
@@ -0,0 +1,372 @@
+package spdxexp_test
+
+// Hegel property tests for github/go-spdx (spdxexp), written for the Hegel zoo. See
+// targets/go/go-spdx/README.md.
+//
+// Oracle: the SPDX license expression grammar (SPDX 2.3, Annex D) with the leniencies the
+// package documents (case-insensitive identifiers, `-only`/`-or-later`/`+` normalization), the
+// README's semantics of Satisfies (an expression is satisfied when one of its OR alternatives
+// has every ANDed license covered by an allowed license; a license is covered by the same
+// license, or through the version ranges of spdxlicenses.LicenseRanges when one side carries
+// `+`) and the documented behaviour of ValidateLicenses and its options, restated as a model
+// (hegel_model_test.go). The model also knows how to reproduce the package's own algorithm
+// where a recorded bug departs from the documentation (the Known switches), which is what
+// names the bug a failing case has (explains, below) and what a HEGEL_NO_KNOWN=1 run compares
+// against.
+//
+// The generators (hegel_props_test.go) are package-level values: atoms and trees are records
+// rendered by pure functions, the allowed list is a record derived from the tree, mutations are
+// edit records applied modulo the live length. The shapes of the recorded bugs (bugs.toml) are
+// drawn as explicit alternatives by default, so the wide properties that meet them fail naming
+// the bug and are the expected failures mapped to it; hegel_shapes_test.go has one narrow
+// property per bug over its shape region, and hegel_pins_test.go the regression examples.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// catch runs f and returns what it panicked with, nil when it returned.
+func catch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is failClass on a case whose recorded shapes are named (none for a plain failure):
+// the shapes are counted and the failure names them; under HEGEL_NO_KNOWN=1 a shaped case is
+// assumed away instead.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	for _, s := range shapes {
+		c.count("shape " + s)
+	}
+	if len(shapes) > 0 {
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the model says what the documentation and the SPDX grammar say, the generators draw every
+// recorded shape and the properties that meet one fail naming the bug (the wide properties are
+// then the expected failures mapped to the bugs, beside the pins); under HEGEL_NO_KNOWN=1 the
+// switches of Known are on, the model reproduces the package's behaviour, the generator keeps
+// off the one shape the model only reproduces by accident (appendAliasing), and the narrow
+// properties of hegel_shapes_test.go draw the region beside each bug instead of its shape.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// knownSwitches: the recorded bugs (bugs.toml). The model reproduces a behaviour while its
+// switch is on, which is so only under HEGEL_NO_KNOWN=1; the pins assert the documented
+// behaviour and fail while the bug exists.
+type knownSwitches struct {
+	// appendTerms appends to a slice with spare capacity, so the AND-terms of an expression
+	// like ((A AND B) AND C) AND (D OR E) all end with the last alternative (go-spdx/2); the
+	// model mirrors the package's slice operations while this is on, and the generator keeps
+	// expressions to four licenses, where no slice has spare capacity
+	appendAliasing bool
+	// expandOrTerm ignores a LicenseRef term of an OR: dropped alternative (false negative), and
+	// an OR of only LicenseRefs under AND expands to nothing and is ignored (false positive)
+	// (go-spdx/1)
+	orDropsLicenseRef bool
+	// expandOrTerm keeps only the first AND-term of an AND alternative that contains an OR
+	// (go-spdx/3)
+	orKeepsFirstAndTerm bool
+	// expandOrTerm indexes [0] of an empty expansion: Satisfies panics (go-spdx/4)
+	emptyAndTermPanics bool
+	// the parser dereferences a nil token when the input ends after "(" or a DocumentRef:
+	// ValidateLicenses("MIT AND (") panics (go-spdx/16)
+	endOfInputPanics bool
+	// the MIT fast path of Satisfies answers by string equality only: MIT vs MIT+ is false, MIT
+	// vs "MIT " is false (go-spdx/7)
+	mitFastPath bool
+	// the fast paths of Satisfies return true without validating the allowed list (go-spdx/8)
+	fastPathsSkipAllowedValidation bool
+	// the WITH fast path of ValidateLicenses rejects without parsing: "MIT+ WITH X",
+	// "(MIT WITH X)" are invalid (go-spdx/6)
+	withFastPathRejects bool
+	// ValidateLicensesOptions are decided from the surface of the string (no space = atomic,
+	// three fields = WITH), so they do not apply inside expressions or parentheses (go-spdx/5)
+	optionsBySurface bool
+	// a lower-case "with" is accepted by the WITH fast paths, and by nothing else (go-spdx/12)
+	foldWithAccepted bool
+	// any identifier with an -only or -or-later suffix is normalized to the base identifier
+	// (MIT-only, Apache-2.0-or-later), and the -or-later rewrite swallows the next character
+	// (go-spdx/9)
+	suffixNormalized bool
+	// "LicenseRef-x WITH exception" is a syntax error (the grammar allows it) (go-spdx/10)
+	licenseRefWithRejected bool
+	// AND/OR/WITH are matched as prefixes: "MIT ANDMIT" is MIT AND MIT (go-spdx/11)
+	keywordGlue bool
+	// an atomic deprecated "+" identifier is normalized to itself ("GPL-2.0+"), in an
+	// expression to "GPL-2.0-or-later" (go-spdx/13)
+	atomicPlusNotNormalized bool
+	// ExtractLicenses returns map keys: random order, so the model compares sets (go-spdx/14)
+	extractOrderRandom bool
+	// the second MPL range group (MPL-2.0-no-copyleft-exception) is unreachable: the model
+	// uses the first matching group as the code does instead of every group (go-spdx/15)
+	mplSecondGroupUnreachable bool
+}
+
+var Known = knownSwitches{
+	appendAliasing:                 noKnown,
+	orDropsLicenseRef:              noKnown,
+	orKeepsFirstAndTerm:            noKnown,
+	emptyAndTermPanics:             noKnown,
+	endOfInputPanics:               noKnown,
+	mitFastPath:                    noKnown,
+	fastPathsSkipAllowedValidation: noKnown,
+	withFastPathRejects:            noKnown,
+	optionsBySurface:               noKnown,
+	foldWithAccepted:               noKnown,
+	suffixNormalized:               noKnown,
+	licenseRefWithRejected:         noKnown,
+	keywordGlue:                    noKnown,
+	atomicPlusNotNormalized:        noKnown,
+	extractOrderRandom:             noKnown,
+	mplSecondGroupUnreachable:      noKnown,
+}
+
+// bugSwitches: for each recorded bug, the switches whose reproduction is the bug (own) and the
+// switches that must already reproduce for the own ones to show (deps: the fast path for the
+// lower-case with of Satisfies, the two expansion bugs for the panic they combine into).
+var bugSwitches = []struct {
+	id   string
+	deps func(k *knownSwitches)
+	own  func(k *knownSwitches, on bool)
+}{
+	{"go-spdx/1", nil, func(k *knownSwitches, on bool) { k.orDropsLicenseRef = on }},
+	{"go-spdx/2", nil, func(k *knownSwitches, on bool) { k.appendAliasing = on }},
+	{"go-spdx/3", nil, func(k *knownSwitches, on bool) { k.orKeepsFirstAndTerm = on }},
+	{"go-spdx/4", func(k *knownSwitches) { k.orDropsLicenseRef, k.orKeepsFirstAndTerm = true, true },
+		func(k *knownSwitches, on bool) { k.emptyAndTermPanics = on }},
+	{"go-spdx/5", nil, func(k *knownSwitches, on bool) { k.optionsBySurface = on }},
+	{"go-spdx/6", nil, func(k *knownSwitches, on bool) { k.withFastPathRejects = on }},
+	{"go-spdx/7", nil, func(k *knownSwitches, on bool) { k.mitFastPath = on }},
+	{"go-spdx/8", nil, func(k *knownSwitches, on bool) { k.fastPathsSkipAllowedValidation = on }},
+	{"go-spdx/9", nil, func(k *knownSwitches, on bool) { k.suffixNormalized = on }},
+	{"go-spdx/10", nil, func(k *knownSwitches, on bool) { k.licenseRefWithRejected = on }},
+	{"go-spdx/11", nil, func(k *knownSwitches, on bool) { k.keywordGlue = on }},
+	{"go-spdx/12", func(k *knownSwitches) { k.fastPathsSkipAllowedValidation = true },
+		func(k *knownSwitches, on bool) { k.foldWithAccepted = on }},
+	{"go-spdx/13", nil, func(k *knownSwitches, on bool) { k.atomicPlusNotNormalized = on }},
+	{"go-spdx/14", nil, func(k *knownSwitches, on bool) { k.extractOrderRandom = on }},
+	{"go-spdx/15", nil, func(k *knownSwitches, on bool) { k.mplSecondGroupUnreachable = on }},
+	{"go-spdx/16", nil, func(k *knownSwitches, on bool) { k.endOfInputPanics = on }},
+}
+
+// explains names the recorded bugs whose shape a case has: those whose switches change what
+// the model expects of the case (expect is the model's expectation as a string, computed under
+// the switches as explains sets them). By default a bug's switches are turned on (after its
+// dependencies) to see whether its reproduction changes the expectation; under HEGEL_NO_KNOWN=1
+// they are turned off. The switches are restored afterwards.
+func explains(expect func() string) []string {
+	saved := Known
+	defer func() { Known = saved }()
+	var shapes []string
+	for _, b := range bugSwitches {
+		base := saved
+		if !noKnown && b.deps != nil {
+			b.deps(&base)
+		}
+		Known = base
+		before := expect()
+		Known = base
+		b.own(&Known, !noKnown)
+		if expect() != before {
+			shapes = append(shapes, b.id)
+		}
+	}
+	return shapes
+}
+
+// shapesOf names the bug a narrow property is about together with every other recorded shape
+// the case has - or nothing under HEGEL_NO_KNOWN=1, when the property draws the neighbouring
+// region and a disagreement is a plain failure.
+func shapesOf(id string, others []string) []string {
+	if noKnown {
+		return nil
+	}
+	var shapes []string
+	if id != "" {
+		shapes = append(shapes, id)
+	}
+	for _, s := range others {
+		if s != id {
+			shapes = append(shapes, s)
+		}
+	}
+	return shapes
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table (the first is the shrink target).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// counted is a list of lo to hi elements whose count is drawn first (Lists with only a MaxSize
+// almost never draws the empty list).
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(k int) hegel.Generator[[]T] { return many(g, k, k) })
+}
