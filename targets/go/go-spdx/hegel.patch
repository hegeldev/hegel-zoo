+// orAndCase is the shape of go-spdx/3 with its allowed list: an OR of a sub-expression and an
+// AND of y with an inner OR of x1 and x2 (or x1 alone, past the shape), against a list that
+// has y and the inner OR's second alternative, at times the first one or the sub-expression's
+// licenses too, and plain strangers.
+type orAndCase struct {
+	x1, x2, y                     atomSpec
+	sub                           *node
+	innerOr                       bool
+	swapInner, swapAnd, swapOuter bool
+	keepFirst, keepSub            bool
+	strangers                     []atomSpec
+	sp                            spelling
+	rotate                        int
+}
+
+func (o orAndCase) tree() *node {
+	inner := leaf(o.x1)
+	if o.innerOr {
+		inner = binary(opOr, leaf(o.x1), leaf(o.x2))
+		if o.swapInner {
+			inner = binary(opOr, leaf(o.x2), leaf(o.x1))
+		}
+	}
+	and := binary(opAnd, inner, leaf(o.y))
+	if o.swapAnd {
+		and = binary(opAnd, leaf(o.y), inner)
+	}
+	if o.swapOuter {
+		return binary(opOr, o.sub, and)
+	}
+	return binary(opOr, and, o.sub)
+}
+
+func (o orAndCase) text() string {
+	s, _ := render(o.tree(), o.sp)
+	return s
+}
+
+func (o orAndCase) list() []string {
+	var out []string
+	add := func(a atomSpec) {
+		if c := a.canonical(); c != nil {
+			out = append(out, c.String())
+		}
+	}
+	add(o.y)
+	if o.innerOr {
+		add(o.x2)
+	}
+	if o.keepFirst {
+		add(o.x1)
+	}
+	if o.keepSub {
+		for _, a := range o.sub.atoms() {
+			add(a)
+		}
+	}
+	for _, a := range o.strangers {
+		add(a)
+	}
+	if len(out) == 0 {
+		return []string{"MIT"}
+	}
+	k := o.rotate % len(out)
+	return append(out[k:], out[:k]...)
+}
+
+func (o orAndCase) GoString() string { return fmt.Sprintf("%q with %q", o.text(), o.list()) }
+
+var orAndCases = hegel.Composite(func(tc hegel.TestCase) orAndCase {
+	return orAndCase{
+		x1:        hegel.Draw(tc, plainLicenseAtoms),
+		x2:        hegel.Draw(tc, plainLicenseAtoms),
+		y:         hegel.Draw(tc, plainLicenseAtoms),
+		sub:       hegel.Draw(tc, licenseSubTrees),
+		innerOr:   shaped(true, false),
+		swapInner: hegel.Draw(tc, chance(50)),
+		swapAnd:   hegel.Draw(tc, chance(50)),
+		swapOuter: hegel.Draw(tc, chance(50)),
+		keepFirst: hegel.Draw(tc, chance(30)),
+		keepSub:   hegel.Draw(tc, chance(30)),
+		strangers: hegel.Draw(tc, counted(plainAtoms, 0, 2)),
+		sp:        hegel.Draw(tc, plainSpellings),
+		rotate:    hegel.Draw(tc, hegel.Integers(0, 7)),
+	}
+})
