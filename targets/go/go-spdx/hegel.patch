+package spdxexp_test
+
+// Sixteen narrow properties, one per recorded bug: each draws the bug's shape region with
+// random contents and is judged by the same model as the wide properties, so that it fails on
+// the bug's shape by default and names it. Under HEGEL_NO_KNOWN=1 each draws the neighbouring
+// region past the shape instead, and passes.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/github/go-spdx/v2/spdxexp"
+	"hegel.dev/go/hegel"
+)
+
+// The random contents around a shape are well-formed: plain atoms (a license with a "+" or a
+// WITH exception at times, a reference), and spellings without glued keywords, so that a
+// narrow property meets its own bug and no other.
+var (
+	plainExcSpecs = hegel.Map(excSpecs, func(e excSpec) excSpec {
+		e.with = "WITH"
+		if e.gapR == "" {
+			e.gapR = " "
+		}
+		return e
+	})
+	// a license as written, without suffix or exception
+	simpleLicenseAtoms = hegel.Composite(func(tc hegel.TestCase) atomSpec {
+		return atomSpec{raw: hegel.Draw(tc, hegel.SampledFrom(licensePool)), form: hegel.Draw(tc, caseForms)}
+	})
+	plainLicenseAtoms = hegel.Composite(func(tc hegel.TestCase) atomSpec {
+		return atomSpec{
+			raw:    hegel.Draw(tc, hegel.SampledFrom(licensePool)),
+			form:   hegel.Draw(tc, caseForms),
+			suffix: hegel.Draw(tc, maybe(30, hegel.Just("+"))),
+			exc:    hegel.Draw(tc, maybe(15, plainExcSpecs)),
+		}
+	})
+	plainRefAtoms = hegel.Map(refAtoms, func(a atomSpec) atomSpec { a.exc = excSpec{}; return a })
+	plainAtoms    = weighted(choice[atomSpec]{85, plainLicenseAtoms}, choice[atomSpec]{15, plainRefAtoms})
+	plainKit      = nodeKit{atoms: hegel.Map(plainAtoms, leaf), licenses: hegel.Map(plainLicenseAtoms, leaf), refs: hegel.Map(plainRefAtoms, leaf)}
+	plainLevels   = plainKit.levels(2, false)
+	subTrees      = plainLevels[1]
+	// the kit of licenses only, for the shapes whose references are the shape itself
+	licenseKit      = nodeKit{atoms: plainKit.licenses, licenses: plainKit.licenses, refs: plainKit.refs}
+	licenseSubTrees = licenseKit.levels(1, false)[1]
+	// a valid allowed list with plain strangers
+	plainCleanAllowedSpecs = cleanAllowedOf(plainAtoms)
+	binaryTrees            = weighted(choice[*node]{1, binaries(opAnd, subTrees, subTrees)}, choice[*node]{1, binaries(opOr, subTrees, subTrees)})
+	separatedGaps          = hegel.Composite(func(tc hegel.TestCase) gap {
+		return gap{before: hegel.Draw(tc, gapsBefore), after: hegel.Draw(tc, gapsBefore)}
+	})
+	plainSpellings = hegel.Map(spellings, func(sp spelling) spelling {
+		gaps := slices.Clone(sp.gaps)
+		for i := range gaps {
+			if gaps[i].after == "" {
+				gaps[i].after = " "
+			}
+		}
+		sp.gaps, sp.tight = gaps, false
+		return sp
+	})
+)
+
+// shapeCases: a tree generator with a plain spelling.
+func shapeCases(trees hegel.Generator[*node]) hegel.Generator[exprCase] {
+	return hegel.Composite(func(tc hegel.TestCase) exprCase {
+		return exprCase{tree: hegel.Draw(tc, trees), sp: hegel.Draw(tc, plainSpellings)}
+	})
+}
+
+// cleanSatCase is an expression with a valid allowed list derived from it.
+type cleanSatCase struct {
+	expr    exprCase
+	allowed cleanAllowed
+}
+
+func (c cleanSatCase) list() []string { return c.allowed.list(c.expr.tree) }
+
+func (c cleanSatCase) GoString() string { return fmt.Sprintf("%q with %q", c.expr.text(), c.list()) }
+
+func cleanSatCases(trees hegel.Generator[*node]) hegel.Generator[cleanSatCase] {
+	return hegel.Composite(func(tc hegel.TestCase) cleanSatCase {
+		return cleanSatCase{expr: hegel.Draw(tc, shapeCases(trees)), allowed: hegel.Draw(tc, plainCleanAllowedSpecs)}
+	})
+}
+
+var activeLicenseIDs = hegel.Filter(hegel.SampledFrom(licensePool), func(id string) bool { _, ok := active(id); return ok })
+
+// go-spdx/1: an OR with a LicenseRef alternative, or an OR of LicenseRefs under an AND; past
+// it, an OR whose alternatives are licenses.
+func TestHegelLicenseRefAlternativesCount(t *testing.T) {
+	c := newCollector(t)
+	region := shaped(
+		weighted(choice[*node]{1, plainKit.refInOr(subTrees)}, choice[*node]{1, plainKit.refOrUnderAnd(subTrees)}),
+		sided(opOr, plainKit.licenses, subTrees),
+	)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, cleanSatCases(region))
+		checkSatisfies(c, ht, sc.expr.text(), sc.list(), "go-spdx/1")
+	})
+}
+
+// coverAllowed is a valid allowed list that covers the tree's atoms but for a few dropped
+// ones (indexes modulo the atom count) and, with dropLast, the last atom (the last
+// alternative of the OR a nested AND chain ends with, go-spdx/2), with plain strangers; "MIT"
+// when nothing is left.
+type coverAllowed struct {
+	dropLast  bool
+	dropped   []int
+	strangers []atomSpec
+	rotate    int
+}
+
+func (a coverAllowed) list(e *node) []string {
+	atoms := e.atoms()
+	var out []string
+	for i, s := range atoms {
+		if a.dropLast && i == len(atoms)-1 || slices.ContainsFunc(a.dropped, func(d int) bool { return d%len(atoms) == i }) {
+			continue
+		}
+		if c := s.canonical(); c != nil {
+			out = append(out, c.String())
+		}
+	}
+	for _, s := range a.strangers {
+		if c := s.canonical(); c != nil {
+			out = append(out, c.String())
+		}
+	}
+	if len(out) == 0 {
+		return []string{"MIT"}
+	}
+	k := a.rotate % len(out)
+	return append(out[k:], out[:k]...)
+}
+
+// coverSatCase is an expression with a covering allowed list.
+type coverSatCase struct {
+	expr    exprCase
+	allowed coverAllowed
+}
+
+func (c coverSatCase) list() []string { return c.allowed.list(c.expr.tree) }
+
+func (c coverSatCase) GoString() string { return fmt.Sprintf("%q with %q", c.expr.text(), c.list()) }
+
+func coverSatCases(trees hegel.Generator[*node]) hegel.Generator[coverSatCase] {
+	return hegel.Composite(func(tc hegel.TestCase) coverSatCase {
+		return coverSatCase{
+			expr: hegel.Draw(tc, shapeCases(trees)),
+			allowed: coverAllowed{
+				dropLast:  hegel.Draw(tc, chance(50)),
+				dropped:   hegel.Draw(tc, counted(hegel.Integers(0, 9), 0, 2)),
+				strangers: hegel.Draw(tc, counted(plainAtoms, 0, 2)),
+				rotate:    hegel.Draw(tc, hegel.Integers(0, 7)),
+			},
+		}
+	})
+}
+
+// go-spdx/2: five or more licenses with nested ANDs, against a list covering all of them but
+// a few; past it, four licenses in the same form.
+func TestHegelAndTermsKeepTheirOwnAlternatives(t *testing.T) {
+	c := newCollector(t)
+	region := shaped(
+		weighted(
+			choice[*node]{2, licenseKit.nestedAndChain()},
+			choice[*node]{1, sided(opAnd, licenseKit.nestedAndChain(), licenseSubTrees)},
+			choice[*node]{1, sided(opOr, licenseKit.nestedAndChain(), licenseSubTrees)},
+		),
