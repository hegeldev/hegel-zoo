+package hegel
+
+// Generators: a type system, root data for it, and an operation against it.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	hzFieldNames = []string{"a", "b", "c", "d", "e", "f", "id", "name", "x", "y", "value", "items"}
+	hzArgNames   = []string{"n", "s", "flag", "in", "list", "id", "e", "f"}
+	hzEnumNames  = []string{"RED", "GREEN", "BLUE", "ALPHA", "beta", "x1", "NORTH"}
+	hzStrings    = []string{"", "a", "hello", "with space", "quote\"d", "back\\slash", "new\nline", "tab\tx", "unicode é中", "0", "-1", "true", "null"}
+	hzDescs      = []string{"a description", "another one", "with \"quotes\"", "two\nlines", "trailing space "}
+)
+
+func hzUniqueName(tc hegel.TestCase, pool []string, used map[string]bool) string {
+	name := hzPick(tc, pool)
+	for used[name] {
+		name += "2"
+	}
+	used[name] = true
+	return name
+}
+
+// --------------------------------------------------------------------------- type system
+
+// hzGenRef wraps a named type in list and non-null wrappers.
+func hzGenRef(tc hegel.TestCase, name string, allowList bool) *hzRef {
+	r := hzNamed(name)
+	if hzChance(tc, 40) {
+		r = hzNonNullOf(r)
+	}
+	if allowList && hzChance(tc, 30) {
+		r = hzListOf(r)
+		if hzChance(tc, 30) {
+			r = hzNonNullOf(r)
+		}
+		if hzChance(tc, 15) {
+			r = hzListOf(r)
+		}
+	}
+	return r
+}
+
+func hzGenDesc(tc hegel.TestCase) string {
+	if hzChance(tc, 25) {
+		return hzPick(tc, hzDescs)
+	}
+	return ""
+}
+
+// hzGenSchema generates a type system: 1-2 enums, 0-2 input objects, 0-2 interfaces, Query and
+// 2-3 objects, 0-1 union.
+func hzGenSchema(tc hegel.TestCase) *hzSchema {
+	s := &hzSchema{}
+	for i := 0; i < hzDrawInt(tc, 1, 2); i++ {
+		e := &hzEnumDef{name: fmt.Sprintf("E%d", i+1), desc: hzGenDesc(tc)}
+		used := map[string]bool{}
+		for j := 0; j < hzDrawInt(tc, 2, 4); j++ {
+			e.values = append(e.values, hzUniqueName(tc, hzEnumNames, used))
+		}
+		s.enums = append(s.enums, e)
+	}
+	nIn := hzDrawInt(tc, 0, 2)
+	for i := 0; i < nIn; i++ {
+		s.inputs = append(s.inputs, &hzInputDef{name: fmt.Sprintf("In%d", i+1), desc: hzGenDesc(tc)})
+	}
+	inputNames := make([]string, 0, len(s.enums)+nIn+5)
+	inputNames = append(inputNames, hzScalars...)
+	for _, e := range s.enums {
+		inputNames = append(inputNames, e.name)
+	}
+	leafNames := append([]string{}, inputNames...)
+	for _, in := range s.inputs {
+		inputNames = append(inputNames, in.name)
+	}
+	for i, in := range s.inputs {
+		used := map[string]bool{}
+		// Fields refer to leaf types and earlier input objects; a nullable self-reference too
+		// (a non-null cycle would be invalid).
+		pool := append([]string{}, leafNames...)
+		for _, earlier := range s.inputs[:i] {
+			pool = append(pool, earlier.name)
+		}
+		for j := 0; j < hzDrawInt(tc, 1, 3); j++ {
+			f := &hzInputField{name: hzUniqueName(tc, hzArgNames, used), def: hzNoDefault, desc: hzGenDesc(tc)}
+			if hzChance(tc, 15) {
+				// No default: graphql-core cannot build a self-referencing default.
+				f.typ = hzNamed(in.name)
+				if hzChance(tc, 50) {
+					f.typ = hzListOf(f.typ)
+				}
+			} else {
+				f.typ = hzGenRef(tc, hzPick(tc, pool), true)
+				if hzChance(tc, 35) {
+					f.def = hzGenValue(tc, s, f.typ, hzValOpts{strict: true})
+				}
+			}
+			in.fields = append(in.fields, f)
+		}
+	}
+	// Named output types: objects first (names), so fields can refer to them.
+	nObj := hzDrawInt(tc, 2, 3)
+	objNames := []string{"Query"}
+	for i := 0; i < nObj; i++ {
+		objNames = append(objNames, fmt.Sprintf("O%d", i+1))
+	}
+	nIf := hzDrawInt(tc, 0, 2)
+	for i := 0; i < nIf; i++ {
+		s.ifaces = append(s.ifaces, &hzIfaceDef{name: fmt.Sprintf("I%d", i+1), desc: hzGenDesc(tc)})
+	}
+	if hzChance(tc, 50) {
+		u := &hzUnionDef{name: "U1", desc: hzGenDesc(tc)}
+		for _, name := range objNames[1:] {
+			if hzChance(tc, 60) {
+				u.members = append(u.members, name)
+			}
+		}
+		if len(u.members) == 0 {
+			u.members = []string{hzPick(tc, objNames[1:])}
+		}
+		s.unions = append(s.unions, u)
+	}
+	outputNames := append([]string{}, leafNames...)
+	outputNames = append(outputNames, objNames[1:]...)
+	for _, i := range s.ifaces {
+		outputNames = append(outputNames, i.name)
+	}
+	for _, u := range s.unions {
+		outputNames = append(outputNames, u.name)
+	}
+	genField := func(used map[string]bool, prefix string) *hzFieldDef {
+		f := &hzFieldDef{desc: hzGenDesc(tc)}
+		if hzChance(tc, 25) {
+			f.name = hzUniqueName(tc, []string{"echo" + prefix, "echo" + prefix + "A", "echo" + prefix + "B"}, used)
+			f.echo = true
+			f.typ = hzNamed("String")
+		} else {
+			pool := hzFieldNames
+			if prefix != "" {
+				pool = []string{prefix + "a", prefix + "b", prefix + "c"}
+			}
+			f.name = hzUniqueName(tc, pool, used)
+			f.typ = hzGenRef(tc, hzPick(tc, outputNames), true)
+		}
+		nArgs := 0
+		if f.echo {
+			nArgs = hzDrawInt(tc, 1, 3)
+		} else if hzChance(tc, 40) {
+			nArgs = hzDrawInt(tc, 1, 2)
+		}
+		usedArgs := map[string]bool{}
+		for j := 0; j < nArgs; j++ {
+			a := &hzArg{name: hzUniqueName(tc, hzArgNames, usedArgs), def: hzNoDefault, desc: hzGenDesc(tc)}
+			a.typ = hzGenRef(tc, hzPick(tc, inputNames), true)
+			if hzChance(tc, 40) {
+				a.def = hzGenValue(tc, s, a.typ, hzValOpts{strict: true})
+			}
+			f.args = append(f.args, a)
+		}
+		if hzChance(tc, 15) {
+			f.deprecated = hzPick(tc, []string{"No longer supported", "use b", "gone \"soon\""})
+		}
+		return f
+	}
+	for _, i := range s.ifaces {
+		used := map[string]bool{}
+		for j := 0; j < hzDrawInt(tc, 1, 2); j++ {
+			i.fields = append(i.fields, genField(used, strings.ToLower(i.name)))
+		}
+	}
+	for _, name := range objNames {
+		o := &hzObjectDef{name: name, desc: hzGenDesc(tc)}
+		used := map[string]bool{}
+		if name != "Query" {
+			for _, i := range s.ifaces {
+				if hzChance(tc, 50) {
+					o.ifaces = append(o.ifaces, i.name)
+					for _, f := range i.fields {
+						if !used[f.name] {
+							used[f.name] = true
+							o.fields = append(o.fields, f)
+						}
+					}
+				}
+			}
+		}
+		for j := 0; j < hzDrawInt(tc, 1, 4); j++ {
+			o.fields = append(o.fields, genField(used, ""))
+		}
+		s.objects = append(s.objects, o)
+	}
+	// Every interface has an implementation.
+	for _, i := range s.ifaces {
+		if len(s.possibleTypes(i.name)) == 0 {
+			o := s.object(hzPick(tc, objNames[1:]))
+			o.ifaces = append(o.ifaces, i.name)
+			for _, f := range i.fields {
+				if s.field(o.name, f.name) == nil {
+					o.fields = append(o.fields, f)
+				}
+			}
+		}
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- input values
+
+// hzValOpts says what an input value is for: strict values are valid, the others include a
+// few invalid ones (out-of-range ints, wrong kinds, unknown enum values and fields); literal
+// values are printed into the operation, variable values are passed as variables.
+type hzValOpts struct {
+	strict   bool
+	literal  bool
+	variable bool
+}
+
+// hzGenValue generates an input value of the type.
+func hzGenValue(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	v := hzGenValueInner(tc, s, r, o)
+	if o.strict && !hzValidValue(s, r, v) {
+		panic(fmt.Sprintf("generator: invalid strict value %s for %s", hzLiteral(v), r))
+	}
+	return v
+}
+
+func hzGenValueInner(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	if r.isNonNull() {
+		return hzGenValueNonNull(tc, s, r.of, o)
+	}
+	if hzChance(tc, 15) {
+		if o.literal && HZKnown.nullLiteralSyntaxError {
+			hzAvoid("nullLiteralSyntaxError")
+		} else {
+			return nil
+		}
+	}
+	return hzGenValueNonNull(tc, s, r, o)
+}
+
+func hzGenValueNonNull(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	if r.isList() {
+		if !r.of.nullable().isList() && hzChance(tc, 25) {
+			// A single non-list value coerces to a list of one.
+			return hzGenValueNonNull(tc, s, r.of.nullable(), o)
+		}
+		n := hzDrawInt(tc, 0, 3)
+		out := make([]any, 0, n)
+		for i := 0; i < n; i++ {
+			out = append(out, hzGenValueInner(tc, s, r.of, o))
+		}
+		return out
+	}
+	if !o.strict && hzChance(tc, 8) {
+		return hzGenWrongInput(tc, s, r.name, o)
+	}
+	switch r.name {
+	case "Int":
+		return hzPick(tc, []int{0, 1, -1, 7, 42, -100, 2147483647, -2147483648})
+	case "Float":
+		if hzChance(tc, 40) {
+			return hzPick(tc, []int{0, 3, -2, 1000})
+		}
+		return hzPick(tc, []float64{0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75})
+	case "String":
+		return hzPick(tc, hzStrings)
+	case "Boolean":
+		return hzChance(tc, 50)
+	case "ID":
+		if hzChance(tc, 30) {
+			return hzPick(tc, []int{1, 42, 0})
+		}
+		return hzPick(tc, []string{"id1", "x", "", "42"})
+	}
+	if e := s.enum(r.name); e != nil {
+		return hzEnumVal(hzPick(tc, e.values))
+	}
+	in := s.input(r.name)
+	if in == nil {
+		panic("hzGenValue: unknown input type " + r.name)
+	}
+	m := map[string]any{}
+	for _, f := range in.fields {
+		required := f.typ.isNonNull() && f.def == hzNoDefault
+		if f.typ.isNonNull() && f.def != hzNoDefault && HZKnown.nonNullArgDefaultRequired {
+			hzAvoid("nonNullArgDefaultRequired")
+			required = true
+		}
+		if required || hzChance(tc, 60) {
+			v := hzGenValueInner(tc, s, f.typ, o)
+			if v == nil && f.def != hzNoDefault && o.variable && HZKnown.nullVariableUsesDefault {
+				hzAvoid("nullVariableUsesDefault")
+				v = hzGenValueNonNull(tc, s, f.typ.nullable(), o)
+			}
+			m[f.name] = v
+		}
+	}
+	if !o.strict && hzChance(tc, 6) {
+		m["unknown"] = 1
+	}
+	return m
+}
+
+// hzGenWrongInput is a value of the wrong kind for the named input type.
+func hzGenWrongInput(tc hegel.TestCase, s *hzSchema, name string, o hzValOpts) any {
+	if o.variable && HZKnown.laxVariableCoercion {
+		// Only the kinds graphql-go rejects too.
+		hzAvoid("laxVariableCoercion")
+		switch name {
+		case "Int":
+			return hzPick(tc, []any{2147483648, -2147483649, 4.0})
+		case "Float":
+			return hzPick(tc, []any{"abc", hzEnumVal("RED")})
+		case "String", "Boolean", "ID":
+			return hzGenOutputLeaf(tc, s, name)
+		}
+	}
+	switch name {
+	case "Int":
+		if o.literal && HZKnown.intLiteralRangeUnchecked {
+			hzAvoid("intLiteralRangeUnchecked")
+			return hzPick(tc, []any{1.5, "3", true, 4.0})
+		}
+		return hzPick(tc, []any{2147483648, -2147483649, 2147483648, -2147483649, 1.5, "3", true, 4.0})
+	case "Float":
+		return hzPick(tc, []any{"1.5", true, hzEnumVal("RED")})
+	case "String":
+		return hzPick(tc, []any{1, true, 1.5, hzEnumVal("RED")})
+	case "Boolean":
+		return hzPick(tc, []any{"true", 1, 0})
+	case "ID":
+		return hzPick(tc, []any{true, 1.5, hzEnumVal("RED")})
+	}
+	if e := s.enum(name); e != nil {
+		return hzPick(tc, []any{hzEnumVal("NOPE"), hzPick(tc, e.values), 1, hzEnumVal(strings.ToLower(e.values[0]))})
+	}
+	return hzPick(tc, []any{1, "x", []any{}})
+}
+
+// --------------------------------------------------------------------------- root data
+
+// hzGenData generates root data for an object type: a map with __typename and a value for
+// each field (mostly of the right kind; a few of the wrong kind, nulls and missing fields).
+func hzGenData(tc hegel.TestCase, s *hzSchema, typeName string, depth int) map[string]any {
+	o := s.object(typeName)
+	m := map[string]any{"__typename": typeName}
+	if hzChance(tc, 3) {
+		delete(m, "__typename")
+	}
+	for _, f := range o.fields {
+		if f.echo || hzChance(tc, 10) {
+			continue // missing: resolves to null
+		}
+		m[f.name] = hzGenOutput(tc, s, f.typ, depth)
+	}
+	return m
+}
+
+func hzGenOutput(tc hegel.TestCase, s *hzSchema, r *hzRef, depth int) any {
+	if r.isNonNull() {
+		if hzChance(tc, 5) {
+			return nil
+		}
+		return hzGenOutput(tc, s, r.of, depth)
+	}
+	if hzChance(tc, 12) {
+		return nil
+	}
+	if r.isList() {
+		if hzChance(tc, 4) {
+			return hzGenOutputLeaf(tc, s, "Int")
+		}
+		n := hzDrawInt(tc, 0, 3)
+		out := make([]any, 0, n)
+		for i := 0; i < n; i++ {
+			out = append(out, hzGenOutput(tc, s, r.of, depth))
+		}
+		return out
+	}
+	if s.isLeaf(r.name) {
+		if hzChance(tc, 18) {
+			return hzGenWrongOutput(tc, s, r.name)
+		}
+		return hzGenOutputLeaf(tc, s, r.name)
+	}
+	if depth <= 0 {
+		return nil
+	}
+	if s.object(r.name) != nil {
+		if hzChance(tc, 3) {
+			return hzGenOutputLeaf(tc, s, "String")
+		}
+		return hzGenData(tc, s, r.name, depth-1)
+	}
+	possible := s.possibleTypes(r.name)
+	if hzChance(tc, 5) || len(possible) == 0 {
+		// A type that is not possible for the abstract type.
+		return hzGenData(tc, s, hzPick(tc, s.objects).name, depth-1)
+	}
+	return hzGenData(tc, s, hzPick(tc, possible), depth-1)
+}
+
+func hzGenOutputLeaf(tc hegel.TestCase, s *hzSchema, name string) any {
+	switch name {
+	case "Int":
+		return hzPick(tc, []int{0, 1, -1, 7, 42, -100, 2147483647, -2147483648})
+	case "Float":
+		if hzChance(tc, 40) {
+			return hzPick(tc, []int{0, 3, -2, 1000})
+		}
+		return hzPick(tc, []float64{0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75})
+	case "String":
+		return hzPick(tc, hzStrings)
+	case "Boolean":
+		return hzChance(tc, 50)
+	case "ID":
+		if hzChance(tc, 30) {
+			return hzPick(tc, []int{1, 42, 0})
+		}
+		return hzPick(tc, []string{"id1", "x", "", "42"})
+	}
+	return hzPick(tc, s.enum(name).values)
+}
+
+// hzGenWrongOutput is a resolved value of the wrong kind for the leaf type. Values marked
+// with a switch are left out while it is on.
+func hzGenWrongOutput(tc hegel.TestCase, s *hzSchema, name string) any {
+	type wrong struct {
+		v      any
+		avoid  *bool
+		reason string
+	}
+	var pool []wrong
+	add := func(v any, avoid *bool, reason string) { pool = append(pool, wrong{v, avoid, reason}) }
+	switch name {
+	case "Int":
+		add("3", nil, "")
+		add(4.0, nil, "")
+		add(true, nil, "")
+		add(2147483648, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(-2147483649, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		for _, f := range []float64{1.5, -2.25, 0.5, 7.75, 1e-3} {
+			add(f, &HZKnown.intSerializeTruncates, "intSerializeTruncates")
+		}
+	case "Float":
+		add("1.5", nil, "")
+		add(true, nil, "")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(map[string]any{}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+	case "String":
+		add(1, nil, "")
+		add(true, nil, "")
+		add(1.5, nil, "")
+		add([]any{"a"}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{"a": 1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	case "Boolean":
+		add(1, nil, "")
+		add(0, nil, "")
+		add(2.5, nil, "")
+		for _, v := range []any{"true", "", "x", "false", "0", []any{}, map[string]any{}} {
+			add(v, &HZKnown.boolSerializeLax, "boolSerializeLax")
+		}
+	case "ID":
+		add(1, nil, "")
+		add(true, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(1.5, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add([]any{1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	default:
+		e := s.enum(name)
+		add("NOPE", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(1, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(strings.ToLower(e.values[0]), &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(true, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{e.values[0]}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+		add(map[string]any{}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+	}
+	w := hzPick(tc, pool)
+	if w.avoid != nil && *w.avoid {
+		hzAvoid(w.reason)
+		return hzGenOutputLeaf(tc, s, name)
+	}
+	return w.v
+}
+
+// --------------------------------------------------------------------------- operations
+
+type hzVarDef struct {
+	name     string
+	typ      *hzRef
+	def      any  // hzNoDefault for none
+	value    any  // the runtime value, when provided
+	provided bool // in the variables map
+}
+
+type hzFragDef struct {
+	name string
+	on   string
+	body string
+}
+
+// hzQuery is a generated operation with its variables.
+type hzQuery struct {
+	text      string
+	vars      []*hzVarDef
+	variables map[string]any // nil when none provided
+	operation string         // OperationName, "" when unset
+	fields    int            // field selections
+	features  map[string]int // counts of the generated features, for the collector
+}
+
+type hzQueryGen struct {
+	tc     hegel.TestCase
+	s      *hzSchema
+	q      *hzQuery
+	frags  []*hzFragDef
+	fragN  int
+	aliasN int
+	budget int
+}
+
+func (g *hzQueryGen) feature(name string) { g.q.features[name]++ }
+
+// hzGenQuery generates an operation against the schema: a selection tree of aliased fields
+// with literal and variable arguments, __typename, inline fragments and fragment spreads,
+// @skip/@include, and optionally a second operation selected by name.
+func hzGenQuery(tc hegel.TestCase, s *hzSchema) *hzQuery {
+	g := &hzQueryGen{tc: tc, s: s, q: &hzQuery{features: map[string]int{}}, budget: 25}
+	return hzGenQueryWith(tc, s, g)
+}
+
+// hzGenQueryWith generates the operation with a given generator state (kept for the
+// mutations of TestHegelValidate).
+func hzGenQueryWith(tc hegel.TestCase, s *hzSchema, g *hzQueryGen) *hzQuery {
+	body := g.selectionSet("Query", 3, false)
+	var b strings.Builder
+	named := hzChance(tc, 50)
+	second := hzChance(tc, 10)
+	if named || second {
+		b.WriteString("query Q1")
+	} else if len(g.q.vars) > 0 || hzChance(tc, 50) {
+		b.WriteString("query")
+	}
+	if len(g.q.vars) > 0 {
+		parts := make([]string, len(g.q.vars))
+		for i, v := range g.q.vars {
+			parts[i] = "$" + v.name + ": " + v.typ.String()
+			if v.def != hzNoDefault {
+				parts[i] += " = " + hzLiteral(v.def)
+			}
+		}
+		b.WriteString("(" + strings.Join(parts, ", ") + ")")
+	}
+	if b.Len() > 0 {
+		b.WriteString(" ")
+	}
+	b.WriteString(body)
+	b.WriteString("\n")
+	for _, f := range g.frags {
+		b.WriteString("fragment " + f.name + " on " + f.on + " " + f.body + "\n")
+	}
+	if second {
+		b.WriteString("query Other { __typename }\n")
+		g.q.operation = "Q1"
+		g.feature("operationName")
+	}
+	g.q.text = b.String()
+	for _, v := range g.q.vars {
+		if v.provided {
+			if g.q.variables == nil {
+				g.q.variables = map[string]any{}
+			}
+			g.q.variables[v.name] = hzGoValue(v.value)
+		}
+	}
+	return g.q
+}
+
+// applicable type conditions for a fragment inside a selection on typeName.
+func (g *hzQueryGen) conditions(typeName string) []string {
+	s := g.s
+	out := []string{typeName}
+	if o := s.object(typeName); o != nil {
+		out = append(out, o.ifaces...)
+		for _, u := range s.unions {
+			for _, m := range u.members {
+				if m == typeName {
+					out = append(out, u.name)
+				}
+			}
+		}
+		return out
+	}
+	out = append(out, s.possibleTypes(typeName)...)
+	// Other abstract types sharing a possible type.
+	for _, i := range s.ifaces {
+		if i.name != typeName && s.overlap(i.name, typeName) {
+			out = append(out, i.name)
+		}
+	}
+	for _, u := range s.unions {
+		if u.name != typeName && s.overlap(u.name, typeName) {
+			out = append(out, u.name)
+		}
+	}
+	return out
+}
+
+// directive is an optional @skip/@include; a variable condition only where allowed (on a
+// selection with a fresh alias, while mergedFirstPredicateWins is on).
+func (g *hzQueryGen) directive(allowVar bool) string {
+	tc := g.tc
+	if !hzChance(tc, 20) {
+		return ""
+	}
+	g.feature("directive")
+	name := hzPick(tc, []string{"skip", "include"})
+	var cond string
+	switch hzDrawInt(tc, 1, 3) {
+	case 1:
+		cond = "true"
+	case 2:
+		cond = "false"
+	default:
+		if !allowVar && HZKnown.mergedFirstPredicateWins {
+			hzAvoid("mergedFirstPredicateWins")
+			cond = "false"
+			break
+		}
+		v := g.variable(hzNonNullOf(hzNamed("Boolean")), true)
+		cond = "$" + v.name
+		g.feature("variableDirective")
+	}
+	return " @" + name + "(if: " + cond + ")"
+}
+
+// variable declares a new variable of the type, with a runtime value (mostly valid) or none.
+func (g *hzQueryGen) variable(typ *hzRef, strict bool) *hzVarDef {
+	tc := g.tc
+	v := &hzVarDef{name: fmt.Sprintf("v%d", len(g.q.vars)+1), typ: typ, def: hzNoDefault}
+	if hzChance(tc, 30) {
+		if typ.isNonNull() && HZKnown.nonNullVarDefaultRejected {
+			hzAvoid("nonNullVarDefaultRejected")
+		} else {
+			v.def = hzGenValue(tc, g.s, typ, hzValOpts{strict: true, literal: true})
+			g.feature("variableDefault")
+		}
+	}
+	if hzChance(tc, 92) || (typ.isNonNull() && hzChance(tc, 85)) {
+		v.provided = true
+		v.value = hzGenValue(tc, g.s, typ, hzValOpts{strict: strict, variable: true})
+		if v.value == nil && HZKnown.nullVariableUsesDefault {
+			hzAvoid("nullVariableUsesDefault")
+			v.provided = false
+		}
+	}
+	g.q.vars = append(g.q.vars, v)
+	g.feature("variable")
+	return v
+}
+
+// argument value: a literal or a variable.
+func (g *hzQueryGen) argValue(typ *hzRef) string {
+	tc := g.tc
+	if hzChance(tc, 35) {
+		vt := typ
+		if !typ.isNonNull() && hzChance(tc, 30) {
+			vt = hzNonNullOf(typ)
+		}
+		v := g.variable(vt, hzChance(tc, 85))
+		return "$" + v.name
+	}
+	val := hzGenValue(tc, g.s, typ, hzValOpts{strict: hzChance(tc, 90), literal: true})
+	if val == nil {
+		g.feature("nullLiteral")
+	}
+	return hzLiteral(val)
+}
+
+func (g *hzQueryGen) arguments(f *hzFieldDef) string {
+	tc := g.tc
+	var parts []string
+	for _, a := range f.args {
+		required := a.typ.isNonNull() && a.def == hzNoDefault
+		if a.typ.isNonNull() && a.def != hzNoDefault && HZKnown.nonNullArgDefaultRequired {
+			hzAvoid("nonNullArgDefaultRequired")
+			required = true
+		}
+		if required || hzChance(tc, 65) {
+			parts = append(parts, a.name+": "+g.argValue(a.typ))
+		}
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+// selectionSet generates { ... } for a composite type; depth bounds the nesting; inWrapped
+// says the set is directly under a field of a list or non-null type.
+func (g *hzQueryGen) selectionSet(typeName string, depth int, inWrapped bool) string {
+	tc, s := g.tc, g.s
+	fields := s.fields(typeName)
+	var leafFields, compositeFields []*hzFieldDef
+	for _, f := range fields {
+		if s.isLeaf(f.typ.named()) {
+			leafFields = append(leafFields, f)
+		} else {
+			compositeFields = append(compositeFields, f)
+		}
+	}
+	n := hzDrawInt(tc, 1, 4)
+	var sels []string
+	for i := 0; i < n && g.budget > 0; i++ {
+		switch roll := hzDrawInt(tc, 1, 100); {
+		case roll <= 10 || (len(fields) == 0 && roll <= 60):
+			sels = append(sels, "__typename"+g.directive(false))
+			g.feature("__typename")
+		case roll <= 60:
+			var pool []*hzFieldDef
+			if depth > 0 && len(compositeFields) > 0 && hzChance(tc, 50) {
+				pool = compositeFields
+			} else {
+				pool = leafFields
+			}
+			if len(pool) == 0 {
+				pool = fields
+				if depth <= 0 {
+					pool = leafFields
+				}
+			}
+			if len(pool) == 0 {
+				continue
+			}
+			f := hzPick(tc, pool)
+			g.budget--
+			g.q.fields++
+			aliased := len(f.args) > 0 || hzChance(tc, 40)
+			sel := f.name + g.arguments(f) + g.directive(aliased)
+			if aliased {
+				g.aliasN++
+				sel = fmt.Sprintf("f%d: %s", g.aliasN, sel)
+				g.feature("alias")
+			} else if hzChance(tc, 15) && s.isLeaf(f.typ.named()) {
+				// The same leaf field twice: merged.
+				sels = append(sels, sel)
+				g.feature("duplicateField")
+			}
+			if !s.isLeaf(f.typ.named()) {
+				sel += " " + g.selectionSet(f.typ.named(), depth-1, f.typ.of != nil)
+			}
+			sels = append(sels, sel)
+		case roll <= 80:
+			cond := hzPick(tc, g.conditions(typeName))
+			noCondition := hzChance(tc, 20)
+			if noCondition && inWrapped && HZKnown.noConditionFragmentInWrap {
+				hzAvoid("noConditionFragmentInWrap")
+				noCondition = false
+			}
+			if noCondition {
+				sels = append(sels, "..."+g.directive(false)+" "+g.selectionSet(typeName, depth, false))
+				g.feature("inlineFragmentNoCondition")
+			} else {
+				sels = append(sels, "... on "+cond+g.directive(false)+" "+g.selectionSet(cond, depth, false))
+				g.feature("inlineFragment")
+			}
+		default:
+			cond := hzPick(tc, g.conditions(typeName))
+			var frag *hzFragDef
+			for _, fr := range g.frags {
+				if fr.on == cond && hzChance(tc, 50) {
+					frag = fr
+				}
+			}
+			if frag == nil {
+				g.fragN++
+				frag = &hzFragDef{name: fmt.Sprintf("F%d", g.fragN), on: cond}
+				frag.body = g.selectionSet(cond, depth, false)
+				g.frags = append(g.frags, frag)
+			}
+			sels = append(sels, "..."+frag.name+g.directive(false))
+			g.feature("fragmentSpread")
+		}
+	}
+	if len(sels) == 0 {
+		sels = append(sels, "__typename")
+	}
+	return "{ " + strings.Join(sels, " ") + " }"
+}
diff --git a/hegel/hegel_zoo_intro_test.go b/hegel/hegel_zoo_intro_test.go
new file mode 100644
index 0000000..b793dda
--- /dev/null
+++ b/hegel/hegel_zoo_intro_test.go
@@ -0,0 +1,248 @@
+package hegel
+
+// TestHegelIntrospection: the introspection of a generated schema must agree with
+// graphql-core's introspection of the same schema built from SDL.
+
+import (
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// hzIntroQuery is graphql-core's introspection query without the newer fields (specifiedByURL,
+// isRepeatable, schema description, input value deprecation).
+const hzIntroQuery = `query IntrospectionQuery {
+  __schema {
+    queryType { name } mutationType { name } subscriptionType { name }
+    types { ...FullType }
+  }
+}
+fragment FullType on __Type {
+  kind name description
+  fields(includeDeprecated: true) {
+    name description args { ...InputValue } type { ...TypeRef } isDeprecated deprecationReason
+  }
+  inputFields { ...InputValue }
+  interfaces { ...TypeRef }
+  enumValues(includeDeprecated: true) { name description isDeprecated deprecationReason }
+  possibleTypes { ...TypeRef }
+}
+fragment InputValue on __InputValue { name description type { ...TypeRef } defaultValue }
+fragment TypeRef on __Type {
+  kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType {
+  kind name ofType { kind name ofType { kind name } } } } } } }
+}`
+
+var hzIntLikeRe = regexp.MustCompile(`^-?(0|[1-9][0-9]*)$`)
+
+// hzTypeRefInfo: the innermost kind and name of a TypeRef, and whether a LIST wraps it.
+func hzTypeRefInfo(v any) (kind, name string, list bool) {
+	for {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return
+		}
+		kind, _ = m["kind"].(string)
+		name, _ = m["name"].(string)
+		if kind == "LIST" {
+			list = true
+		}
+		if m["ofType"] == nil {
+			return
+		}
+		v = m["ofType"]
+	}
+}
+
+func hzSortByName(l []any) {
+	sort.Slice(l, func(i, j int) bool {
+		a, _ := l[i].(map[string]any)["name"].(string)
+		b, _ := l[j].(map[string]any)["name"].(string)
+		return a < b
+	})
+}
+
+// hzIntroNormalize makes an introspection result comparable: the introspection types and
+// the directives are left out, lists are sorted by name, the built-in scalars'
+// descriptions are not judged, a default value of null (which the Go API cannot express)
+// counts as none, an integer-like ID default is the same quoted or bare, an interface's own
+// interfaces are not judged. goSide applies the
+// recorded bugs' normalisations while their switches are on; the avoidance is counted.
+func hzIntroNormalize(v any, goSide bool) any {
+	root, ok := v.(map[string]any)
+	if !ok {
+		return v
+	}
+	s, _ := root["__schema"].(map[string]any)
+	types, _ := s["types"].([]any)
+	var kept []any
+	for _, t := range types {
+		tm, _ := t.(map[string]any)
+		name, _ := tm["name"].(string)
+		if strings.HasPrefix(name, "__") {
+			continue
+		}
+		if hzIsScalar(name) {
+			tm["description"] = "not judged"
+		}
+		hzIntroNormalizeDesc(tm, goSide)
+		if tm["kind"] == "INTERFACE" {
+			// Interfaces implementing interfaces (spec 2021) are not judged: graphql-go has none.
+			tm["interfaces"] = nil
+		}
+		for _, k := range []string{"fields", "inputFields", "enumValues", "possibleTypes", "interfaces"} {
+			l, _ := tm[k].([]any)
+			hzSortByName(l)
+			for _, f := range l {
+				fm, _ := f.(map[string]any)
+				hzIntroNormalizeDesc(fm, goSide)
+				if k == "inputFields" {
+					hzIntroNormalizeDefault(fm, goSide)
+				}
+				args, _ := fm["args"].([]any)
+				hzSortByName(args)
+				for _, a := range args {
+					am, _ := a.(map[string]any)
+					hzIntroNormalizeDesc(am, goSide)
+					hzIntroNormalizeDefault(am, goSide)
+				}
+			}
+		}
+		kept = append(kept, tm)
+	}
+	hzSortByName(kept)
+	s["types"] = kept
+	return v
+}
+
+func hzIntroNormalizeDesc(m map[string]any, goSide bool) {
+	if m == nil {
+		return
+	}
+	if d, ok := m["description"].(string); ok && d == "" && goSide && HZKnown.introEmptyDescription {
+		hzAvoid("introEmptyDescription")
+		m["description"] = nil
+	}
+}
+
+// hzIntroNormalizeDefault normalises the defaultValue of an input value (an argument or an
+// input field).
+func hzIntroNormalizeDefault(m map[string]any, goSide bool) {
+	if m == nil {
+		return
+	}
+	d, ok := m["defaultValue"].(string)
+	if !ok {
+		return
+	}
+	kind, name, list := hzTypeRefInfo(m["type"])
+	if d == "null" && !goSide {
+		m["defaultValue"] = nil
+		return
+	}
+	if name == "ID" && !list {
+		if u := strings.Trim(d, `"`); hzIntLikeRe.MatchString(u) {
+			m["defaultValue"] = u
+		}
+	}
+	if (kind == "ENUM" || kind == "INPUT_OBJECT" || list) && HZKnown.introDefaultValueUntyped {
+		// Both sides: the value is not compared.
+		if goSide {
+			hzAvoid("introDefaultValueUntyped")
+		}
+		m["defaultValue"] = "not compared"
+	}
+}
+
+func TestHegelIntrospection(t *testing.T) {
+	o := hzStartOracle(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		s := hzGenSchema(ht)
+		sdl := hzSDL(s)
+		schema, err := hzBuild(s)
+		if err != nil {
+			ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+		}
+		py, err := o.execute(sdl, nil, hzIntroQuery, nil, "")
+		if err != nil {
+			ht.Fatalf("oracle: %v", err)
+		}
+		if py.SchemaError != "" {
+			ht.Fatalf("graphql-core rejects the SDL: %s\n%s", py.SchemaError, sdl)
+		}
+		var r *graphql.Result
+		if p := hzCatch(func() {
+			r = graphql.Do(graphql.Params{Schema: schema, RequestString: hzIntroQuery})
+		}); p != nil {
+			c.failClass(ht, "panic", "introspection panics: %v\nSDL:\n%s", p, sdl)
+			return
+		}
+		if len(r.Errors) > 0 || len(py.Errors) > 0 {
+			c.failClass(ht, "errors", "introspection errors: graphql-go %v, graphql-core %v\nSDL:\n%s", r.Errors, py.Errors, sdl)
+			return
+		}
+		gb, _ := hzJSONMarshal(r.Data)
+		g := hzIntroNormalize(hzNormalizeJSON(gb), true)
+		p := hzIntroNormalize(hzNormalizeJSON(py.Data), false)
+		if !reflect.DeepEqual(g, p) {
+			c.failClass(ht, "introspection", "introspection differs\n%s\nSDL:\n%s", hzFirstDiff(g, p), sdl)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// hzFirstDiff describes the first difference between two normalised JSON values.
+func hzFirstDiff(a, b any) string {
+	var walk func(path string, a, b any) string
+	walk = func(path string, a, b any) string {
+		switch av := a.(type) {
+		case map[string]any:
+			bv, ok := b.(map[string]any)
+			if !ok {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			keys := map[string]bool{}
+			for k := range av {
+				keys[k] = true
+			}
+			for k := range bv {
+				keys[k] = true
+			}
+			sorted := make([]string, 0, len(keys))
+			for k := range keys {
+				sorted = append(sorted, k)
+			}
+			sort.Strings(sorted)
+			for _, k := range sorted {
+				if d := walk(path+"."+k, av[k], bv[k]); d != "" {
+					return d
+				}
+			}
+			return ""
+		case []any:
+			bv, ok := b.([]any)
+			if !ok || len(av) != len(bv) {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			for i := range av {
+				if d := walk(fmt.Sprintf("%s[%d]", path, i), av[i], bv[i]); d != "" {
+					return d
+				}
+			}
+			return ""
+		}
+		if !reflect.DeepEqual(a, b) {
+			return fmt.Sprintf("%s: graphql-go %#v, graphql-core %#v", path, a, b)
+		}
+		return ""
+	}
+	return walk("", a, b)
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..55d028a
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,218 @@
+package hegel
+
+// The graphql-core oracle: one python3 process per test, fed JSON lines
+// {sdl, data, query, variables, operation} and answering with the execution result (data and
+// formatted errors) of the same operation against the same schema and root data.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json
+import graphql
+from graphql import build_schema, graphql_sync, parse, validate
+from graphql.type import GraphQLObjectType
+
+def canonical(v):
+    if v is None:
+        return "null"
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if isinstance(v, float):
+        return "%.4f" % v
+    if isinstance(v, str):
+        return json.dumps(v, ensure_ascii=False)
+    if isinstance(v, (list, tuple)):
+        return "[" + ",".join(canonical(x) for x in v) + "]"
+    if isinstance(v, dict):
+        # graphql-go leaves null-valued input fields out of its maps: absent and null compare equal.
+        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + canonical(v[k]) for k in sorted(v) if v[k] is not None) + "}"
+    return "<" + type(v).__name__ + ">"
+
+def echo(src, info, **args):
+    return canonical(args)
+
+def make_schema(sdl):
+    schema = build_schema(sdl)
+    for name, t in schema.type_map.items():
+        if isinstance(t, GraphQLObjectType) and not name.startswith("__"):
+            t.is_type_of = (lambda n: (lambda v, info: isinstance(v, dict) and v.get("__typename") == n))(name)
+            for fname, f in t.fields.items():
+                if fname.startswith("echo"):
+                    f.resolve = echo
+    return schema
+
+def fmt_error(e):
+    d = {"message": e.message, "path": list(e.path) if e.path else None}
+    d["locations"] = [[l.line, l.column] for l in e.locations] if e.locations else None
+    return d
+
+def main():
+    sys.stdout.write(json.dumps({"hello": True, "version": graphql.__version__, "python": sys.version.split()[0]}) + "\n")
+    sys.stdout.flush()
+    for line in sys.stdin:
+        req = json.loads(line)
+        out = {}
+        try:
+            try:
+                schema = make_schema(req["sdl"])
+            except Exception as e:
+                out["schema_error"] = type(e).__name__ + ": " + str(e)[:400]
+                sys.stdout.write(json.dumps(out) + "\n")
+                sys.stdout.flush()
+                continue
+            mode = req.get("mode", "execute")
+            if mode == "validate":
+                try:
+                    doc = parse(req["query"])
+                except Exception as e:
+                    out["errors"] = [{"message": "syntax: " + str(e)[:300], "path": None, "locations": None}]
+                else:
+                    out["errors"] = [fmt_error(e) for e in validate(schema, doc)]
+            else:
+                r = graphql_sync(schema, req["query"], root_value=req.get("data"),
+                                 variable_values=req.get("variables"), operation_name=req.get("operation"))
+                out["data"] = r.data
+                out["errors"] = [fmt_error(e) for e in (r.errors or [])]
+        except Exception as e:
+            out["fatal"] = repr(e)[:400]
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+main()
+`
+
+type hzOracleError struct {
+	Message   string  `json:"message"`
+	Path      []any   `json:"path"`
+	Locations [][]int `json:"locations"`
+}
+
+type hzOracleReply struct {
+	SchemaError string          `json:"schema_error"`
+	Data        json.RawMessage `json:"data"`
+	Errors      []hzOracleError `json:"errors"`
+	Fatal       string          `json:"fatal"`
+}
+
+type hzOracle struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	hello, err := o.out.ReadString('\n')
+	if err != nil {
+		t.Fatalf("python graphql-core oracle did not start: %v", err)
+	}
+	var h struct {
+		Version string `json:"version"`
+		Python  string `json:"python"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(hello)), &h); err != nil {
+		t.Fatalf("bad oracle greeting %q: %v", hello, err)
+	}
+	t.Logf("oracle: python %s graphql-core %s", h.Python, h.Version)
+	if !strings.HasPrefix(h.Version, "3.") {
+		t.Fatalf("python graphql-core %s is not the 3.x the oracle expects", h.Version)
+	}
+	// Smoke test.
+	r, err := o.execute("type Query { a: Int, echoA(x: Int = 4): String }", map[string]any{"a": 3}, "{ a echoA }", nil, "")
+	if err != nil || r.SchemaError != "" || string(r.Data) != `{"a": 3, "echoA": "{\"x\":4}"}` || len(r.Errors) != 0 {
+		t.Fatalf("python graphql-core oracle not working: %+v %v", r, err)
+	}
+	return o
+}
+
+// execute runs the operation against the schema (SDL) with the root data and variables.
+func (o *hzOracle) execute(sdl string, data any, query string, variables map[string]any, operation string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "execute", "sdl": sdl, "data": data, "query": query, "variables": variables, "operation": hzNilIfEmpty(operation)})
+}
+
+// validate parses and validates the document against the schema (SDL).
+func (o *hzOracle) validate(sdl string, query string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "validate", "sdl": sdl, "query": query})
+}
+
+func hzNilIfEmpty(s string) any {
+	if s == "" {
+		return nil
+	}
+	return s
+}
+
+func (o *hzOracle) ask(m map[string]any) (*hzOracleReply, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	req, err := hzJSONMarshal(m)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading oracle reply: %v", err)
+	}
+	var r hzOracleReply
+	if err := json.Unmarshal([]byte(strings.TrimSpace(line)), &r); err != nil {
+		return nil, fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if r.Fatal != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Fatal)
+	}
+	return &r, nil
+}
+
+// hzJSONMarshal is json.Marshal without HTML escaping and without a trailing newline.
+func hzJSONMarshal(v any) ([]byte, error) {
+	var b bytes.Buffer
+	enc := json.NewEncoder(&b)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	return bytes.TrimRight(b.Bytes(), "\n"), nil
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..5c309e2
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,245 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the behaviour the GraphQL
+// specification (and graphql-js/graphql-core) gives. They fail while the bug exists and are
+// listed as expected failures in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"github.com/graphql-go/graphql/language/parser"
+	"github.com/graphql-go/graphql/language/source"
+)
+
+// hzPinSchema: Query { echo(n: Int = 5, id: [Int!]! = [1], z: Int, b: Boolean, s: String): String
+// (echo resolves to the canonical JSON of its arguments), a: Int, i: Int, f: Float, str: String,
+// bool: Boolean, d: ID, e: E, n: Int!, l: [Int], name: [O3]!, one: O3 } with O3 { v: Int }.
+func hzPinSchema(t *testing.T) graphql.Schema {
+	t.Helper()
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	o3 := graphql.NewObject(graphql.ObjectConfig{Name: "O3", Fields: graphql.Fields{"v": &graphql.Field{Type: graphql.Int}}})
+	echo := &graphql.Field{Type: graphql.String, Args: graphql.FieldConfigArgument{
+		"n":  &graphql.ArgumentConfig{Type: graphql.Int, DefaultValue: 5},
+		"id": &graphql.ArgumentConfig{Type: graphql.NewNonNull(graphql.NewList(graphql.NewNonNull(graphql.Int))), DefaultValue: []any{1}},
+		"z":  &graphql.ArgumentConfig{Type: graphql.Int},
+		"b":  &graphql.ArgumentConfig{Type: graphql.Boolean},
+		"s":  &graphql.ArgumentConfig{Type: graphql.String},
+	}, Resolve: func(p graphql.ResolveParams) (any, error) { return hzCanonical(p.Args), nil }}
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"echo": echo,
+		"a":    &graphql.Field{Type: graphql.Int},
+		"i":    &graphql.Field{Type: graphql.Int},
+		"f":    &graphql.Field{Type: graphql.Float},
+		"str":  &graphql.Field{Type: graphql.String},
+		"bool": &graphql.Field{Type: graphql.Boolean},
+		"d":    &graphql.Field{Type: graphql.ID},
+		"e":    &graphql.Field{Type: e},
+		"n":    &graphql.Field{Type: graphql.NewNonNull(graphql.Int)},
+		"l":    &graphql.Field{Type: graphql.NewList(graphql.Int)},
+		"name": &graphql.Field{Type: graphql.NewNonNull(graphql.NewList(o3))},
+		"one":  &graphql.Field{Type: o3},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return schema
+}
+
+func hzPinDo(t *testing.T, query string, vars map[string]any, data map[string]any) (*graphql.Result, string) {
+	t.Helper()
+	r := graphql.Do(graphql.Params{Schema: hzPinSchema(t), RequestString: query, VariableValues: vars, RootObject: data})
+	b, _ := hzJSONMarshal(r)
+	return r, string(b)
+}
+
+func hzPinEcho(r *graphql.Result) string {
+	m, _ := r.Data.(map[string]any)
+	s, _ := m["echo"].(string)
+	return s
+}
+
+// graphql-go/1: the null literal is a syntax error.
+func TestHegelPinNullLiteral(t *testing.T) {
+	src := source.NewSource(&source.Source{Body: []byte(`{ echo(z: null) }`)})
+	if _, err := parser.Parse(parser.ParseParams{Source: src}); err != nil {
+		t.Errorf("parsing `{ echo(z: null) }`: %v", err)
+	}
+}
+
+// graphql-go/2: a non-null argument with a default value must still be provided.
+func TestHegelPinNonNullArgDefault(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ echo }` with echo(id: [Int!]! = [1]) gives %s", js)
+	}
+}
+
+// graphql-go/3: a non-null variable with a default value is rejected.
+func TestHegelPinNonNullVariableDefault(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean! = true) { echo(id: 3) @skip(if: $v) }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("query($v: Boolean! = true) gives %s", js)
+	}
+}
+
+// graphql-go/4: a variable given the value null takes its default value, or the argument's.
+func TestHegelPinNullVariableValue(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Int = 7) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":7`) {
+		t.Errorf("$v: Int = 7 given null gives n = 7: %s", js)
+	}
+	r, js = hzPinDo(t, `query($v: Int) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":5`) {
+		t.Errorf("$v: Int given null for echo(n: Int = 5) gives n = 5: %s", js)
+	}
+}
+
+// graphql-go/5: variable values of the wrong kind are coerced instead of rejected.
+func TestHegelPinLaxVariableCoercion(t *testing.T) {
+	for _, c := range []struct {
+		query string
+		vars  map[string]any
+	}{
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": "4"}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": 1.5}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": true}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": "x"}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": []any{}}},
+		{`query($v: String) { echo(id: 3, s: $v) }`, map[string]any{"v": 1}},
+	} {
+		r, js := hzPinDo(t, c.query, c.vars, nil)
+		if len(r.Errors) == 0 {
+			t.Errorf("%s with %s is accepted: %s", c.query, hzCanonical(c.vars), js)
+		}
+	}
+}
+
+// graphql-go/6: an Int literal outside 32 bits is accepted.
+func TestHegelPinIntLiteralRange(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo(id: 3, z: 3000000000) }`, nil, nil)
+	if len(r.Errors) == 0 {
+		t.Errorf("z: 3000000000 for an Int argument is accepted: %s", js)
+	}
+}
+
+// graphql-go/7: a field selected twice is dropped when the first selection is excluded by a
+// variable-driven @skip.
+func TestHegelPinMergedSkipVariable(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean!) { a @skip(if: $v) a }`, map[string]any{"v": true}, map[string]any{"a": 1})
+	m, _ := r.Data.(map[string]any)
+	if m == nil || m["a"] != 1 {
+		t.Errorf("`a @skip(if: $v) a` with v = true gives %s, without a", js)
+	}
+}
+
+// graphql-go/8: an inline fragment without a type condition under a list-typed field is
+// rejected.
+func TestHegelPinInlineFragmentNoCondition(t *testing.T) {
+	r, js := hzPinDo(t, `{ name { ... { v } } }`, nil, map[string]any{"name": []any{map[string]any{"v": 2}}})
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ name { ... { v } } }` with name: [O3]! gives %s", js)
+	}
+}
+
+// graphql-go/9: Enum.Serialize of a slice value panics.
+func TestHegelPinEnumSerializeSlice(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	if r := hzCatch(func() { e.Serialize([]any{"RED"}) }); r != nil {
+		t.Errorf("Enum.Serialize([]any{\"RED\"}) panics: %v", r)
+	}
+}
+
+// graphql-go/10: a leaf value that cannot be serialized becomes null without a field error.
+func TestHegelPinLeafSerializeError(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": "abc"})
+	if len(r.Errors) == 0 {
+		t.Errorf("Int field resolving to \"abc\" gives %s, without an error", js)
+	}
+}
+
+// graphql-go/11: Int serialization truncates a fractional float.
+func TestHegelPinIntTruncation(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": 1.5})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["i"] == 1 {
+		t.Errorf("Int field resolving to 1.5 gives %s", js)
+	}
+}
+
+// graphql-go/12: Boolean serialization turns any string but "" and "false" into true.
+func TestHegelPinBooleanString(t *testing.T) {
+	r, js := hzPinDo(t, `{ bool }`, nil, map[string]any{"bool": "x"})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["bool"] == true {
+		t.Errorf("Boolean field resolving to \"x\" gives %s", js)
+	}
+}
+
+// graphql-go/13: String serialization prints a slice with fmt.
+func TestHegelPinStringOfSlice(t *testing.T) {
+	r, js := hzPinDo(t, `{ str }`, nil, map[string]any{"str": []any{"a"}})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["str"] == "[a]" {
+		t.Errorf("String field resolving to []any{\"a\"} gives %s", js)
+	}
+}
+
+// graphql-go/14: when a non-null root field is null, the errors of the other root fields are
+// dropped.
+func TestHegelPinRootPropagationErrors(t *testing.T) {
+	r, js := hzPinDo(t, `{ l n }`, nil, map[string]any{"l": 5})
+	if len(r.Errors) != 2 {
+		t.Errorf("`{ l n }` with l = 5 (not a list) and n missing gives %s: the error of l is missing", js)
+	}
+}
+
+// graphql-go/15: introspection prints the default value of an enum, list or input object
+// argument as a quoted fmt string.
+func TestHegelPinIntrospectionDefaultValue(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"f": &graphql.Field{Type: graphql.Int, Args: graphql.FieldConfigArgument{
+			"e": &graphql.ArgumentConfig{Type: e, DefaultValue: "RED"},
+			"l": &graphql.ArgumentConfig{Type: graphql.NewList(graphql.Int), DefaultValue: []any{1, 2}},
+		}},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := graphql.Do(graphql.Params{Schema: schema, RequestString: `{ __type(name: "Query") { fields { args { name defaultValue } } } }`})
+	b, _ := hzJSONMarshal(r.Data)
+	js := string(b)
+	if !strings.Contains(js, `"defaultValue":"RED"`) || !strings.Contains(js, `"defaultValue":"[1, 2]"`) {
+		t.Errorf("introspection of e: E = RED and l: [Int] = [1, 2] gives %s", js)
+	}
+}
+
+// graphql-go/16: introspection gives an empty string, not null, for a missing description.
+func TestHegelPinIntrospectionEmptyDescription(t *testing.T) {
+	r, js := hzPinDo(t, `{ __type(name: "O3") { description fields { description } } }`, nil, nil)
+	m, _ := r.Data.(map[string]any)
+	tm, _ := m["__type"].(map[string]any)
+	if tm == nil || tm["description"] != nil {
+		t.Errorf("introspection of a type without a description gives %s", js)
+	}
+}
+
+// graphql-go/17: the same directive twice on one selection passes validation.
+func TestHegelPinDuplicateDirectives(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, `{ a @skip(if: true) @skip(if: false) }`); ok {
+		t.Errorf("`{ a @skip(if: true) @skip(if: false) }` passes validation")
+	}
+}
+
+// graphql-go/18: a type definition in an executable document passes validation.
+func TestHegelPinSDLInExecutable(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, "{ a }\ntype Extra { a: Int }"); ok {
+		t.Errorf("a document with a type definition passes validation (and then cannot be executed)")
+	}
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..041fc6e
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,243 @@
+package hegel
+
+// The properties: the execution of generated operations against generated schemas and root
+// data must agree with graphql-core's.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// hzNormalize makes the JSON of a result comparable: json.Number integers stay, floats that
+// are whole numbers become integers, other floats their shortest form.
+func hzNormalize(v any) any {
+	switch v := v.(type) {
+	case json.Number:
+		s := string(v)
+		if !strings.ContainsAny(s, ".eE") {
+			return s
+		}
+		f, err := strconv.ParseFloat(s, 64)
+		if err != nil {
+			return s
+		}
+		if f == math.Trunc(f) && math.Abs(f) < 1e15 {
+			return strconv.FormatInt(int64(f), 10)
+		}
+		return strconv.FormatFloat(f, 'g', -1, 64)
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = hzNormalize(x)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = hzNormalize(x)
+		}
+		return out
+	}
+	return v
+}
+
+func hzNormalizeJSON(b []byte) any {
+	if len(b) == 0 {
+		return nil
+	}
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return "unparseable: " + string(b)
+	}
+	return hzNormalize(v)
+}
+
+func hzPathString(path []any) string {
+	parts := make([]string, len(path))
+	for i, p := range path {
+		parts[i] = fmt.Sprint(hzNormalize(p))
+	}
+	return strings.Join(parts, ".")
+}
+
+var hzQuotedRe = regexp.MustCompile(`"[^"]*"`)
+
+// hzSubset: is the sorted multiset a contained in the sorted multiset b?
+func hzSubset(a, b []string) bool {
+	j := 0
+	for _, x := range a {
+		for j < len(b) && b[j] < x {
+			j++
+		}
+		if j >= len(b) || b[j] != x {
+			return false
+		}
+		j++
+	}
+	return true
+}
+
+func hzAllEmpty(xs []string) bool {
+	for _, x := range xs {
+		if x != "" {
+			return false
+		}
+	}
+	return true
+}
+
+// hzResult is one implementation's outcome, in comparable form.
+type hzResult struct {
+	data     any      // normalised; nil when absent
+	hasData  bool     // the data key is not null
+	paths    []string // error paths, sorted ("" for a request error)
+	messages []string
+}
+
+func hzGoResult(r *graphql.Result) *hzResult {
+	out := &hzResult{}
+	if r.Data != nil {
+		b, _ := hzJSONMarshal(r.Data)
+		out.data = hzNormalizeJSON(b)
+		out.hasData = true
+	}
+	for _, e := range r.Errors {
+		out.paths = append(out.paths, hzPathString(e.Path))
+		out.messages = append(out.messages, e.Message)
+	}
+	sort.Strings(out.paths)
+	return out
+}
+
+func hzPyResult(r *hzOracleReply) *hzResult {
+	out := &hzResult{}
+	if len(r.Data) > 0 && string(r.Data) != "null" {
+		out.data = hzNormalizeJSON(r.Data)
+		out.hasData = true
+	}
+	for _, e := range r.Errors {
+		out.paths = append(out.paths, hzPathString(e.Path))
+		out.messages = append(out.messages, e.Message)
+	}
+	sort.Strings(out.paths)
+	return out
+}
+
+func (r *hzResult) String() string {
+	b, _ := hzJSONMarshal(r.data)
+	return fmt.Sprintf("data=%s errors=%q messages=%q", b, r.paths, r.messages)
+}
+
+// TestHegelExecute: graphql.Do on a generated schema, root data and operation must give the
+// same data and the same error paths as graphql-core.
+func TestHegelExecute(t *testing.T) {
+	o := hzStartOracle(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		s := hzGenSchema(ht)
+		sdl := hzSDL(s)
+		schema, err := hzBuild(s)
+		if err != nil {
+			ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+		}
+		data := hzGenData(ht, s, "Query", 4)
+		q := hzGenQuery(ht, s)
+		for f := range q.features {
+			c.count("feature " + f)
+		}
+		py, err := o.execute(sdl, data, q.text, q.variables, q.operation)
+		if err != nil {
+			ht.Fatalf("oracle: %v", err)
+		}
+		if py.SchemaError != "" {
+			ht.Fatalf("graphql-core rejects the SDL: %s\n%s", py.SchemaError, sdl)
+		}
+		var goRes *graphql.Result
+		if r := hzCatch(func() {
+			goRes = graphql.Do(graphql.Params{
+				Schema:         schema,
+				RequestString:  q.text,
+				VariableValues: q.variables,
+				OperationName:  q.operation,
+				RootObject:     data,
+			})
+		}); r != nil {
+			c.failClass(ht, "panic", "graphql.Do panics: %v\nquery:\n%s\nvariables: %s\nSDL:\n%s", r, q.text, hzCanonical(q.variables), sdl)
+			return
+		}
+		g, p := hzGoResult(goRes), hzPyResult(py)
+		dataJSON, _ := hzJSONMarshal(data)
+		context := func() string {
+			return fmt.Sprintf("query:\n%s\nvariables: %s\noperation: %q\ndata: %s\nSDL:\n%s\ngraphql-go: %v\ngraphql-core: %v",
+				q.text, hzCanonical(q.variables), q.operation, dataJSON, sdl, g, p)
+		}
+		for _, m := range g.messages {
+			if strings.Contains(m, "runtime error") {
+				// A recovered panic reported as a GraphQL error.
+				c.failClass(ht, "runtime error", "graphql-go reports a runtime error\n%s", context())
+				return
+			}
+		}
+		if !g.hasData && !p.hasData {
+			if len(goRes.Errors) > 0 {
+				m := goRes.Errors[0].Message
+				if i := strings.Index(m, "\n"); i > 0 {
+					m = m[:i]
+				}
+				c.count("reject: " + hzQuotedRe.ReplaceAllString(m, `"_"`))
+			}
+			if len(py.Errors) > 0 {
+				m := py.Errors[0].Message
+				if i := strings.Index(m, "\n"); i > 0 {
+					m = m[:i]
+				}
+				c.count("reject-core: " + hzQuotedRe.ReplaceAllString(m, `"_"`))
+			}
+			if hzAllEmpty(g.paths) && hzAllEmpty(p.paths) {
+				c.count("both reject")
+				return
+			}
+			// Execution errors that made the data null: the paths must agree (while
+			// rootPropagationDropsErrors is on, graphql-go's must be among graphql-core's).
+			if !reflect.DeepEqual(g.paths, p.paths) {
+				if HZKnown.rootPropagationDropsErrors && hzSubset(g.paths, p.paths) {
+					hzAvoid("rootPropagationDropsErrors")
+					return
+				}
+				c.failClass(ht, "error paths", "error paths differ (data null)\n%s", context())
+				return
+			}
+			c.count("both reject, paths agree")
+			return
+		}
+		if g.hasData != p.hasData {
+			c.failClass(ht, "reject", "one side rejects the request\n%s", context())
+			return
+		}
+		if !reflect.DeepEqual(g.data, p.data) {
+			c.failClass(ht, "data", "data differs\n%s", context())
+			return
+		}
+		if !reflect.DeepEqual(g.paths, p.paths) {
+			c.failClass(ht, "error paths", "error paths differ\n%s", context())
+			return
+		}
+		if len(g.paths) > 0 {
+			c.count("errors agree")
+		} else {
+			c.count("ok")
+		}
+	})
+}
