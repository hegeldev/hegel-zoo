+package hegel
+
+// Hegel property tests for graphql-go/graphql, written for the Hegel zoo. See
+// targets/go/graphql-go/README.md. They live in a package of their own (hegel/) and drive the
+// public API: graphql.NewSchema on a generated type system (objects, interfaces, unions, enums,
+// input objects, lists and non-nulls, arguments with default values) and graphql.Do with
+// generated operations, variables and root data.
+//
+// Oracle: graphql-core (python), the reference implementation's port, given the same schema
+// as SDL, the same root data as JSON and the same operation: the data and the error paths must
+// agree.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	nullLiteralSyntaxError      bool // the null literal is a syntax error (Unexpected Name "null")
+	nonNullArgDefaultRequired   bool // a non-null argument or input field with a default value must still be provided
+	nonNullVarDefaultRejected   bool // a non-null variable with a default value is rejected (an obsolete rule)
+	nullVariableUsesDefault     bool // a variable given the value null takes its default or the argument's, instead of null
+	laxVariableCoercion         bool // variable values of the wrong kind are coerced instead of rejected (Int from "3", true or 1.5, Boolean from "x" or 1, String/ID from anything)
+	intLiteralRangeUnchecked    bool // an Int literal outside 32 bits is accepted
+	mergedFirstPredicateWins    bool // a selection reached twice is dropped when the first is excluded by a variable-driven @skip/@include (the plan keeps the first predicate only)
+	noConditionFragmentInWrap   bool // an inline fragment without a type condition under a list or non-null field is rejected ("objects of type T can never be of type [T]" or "T!")
+	enumSerializePanics         bool // Enum.Serialize of a slice or map value panics (hash of unhashable type), reported as a runtime error
+	leafSerializeSilentNull     bool // a leaf value that cannot be serialized (Int out of range or non-numeric, unknown enum value, non-numeric Float) becomes null without a field error
+	intSerializeTruncates       bool // Int serialization truncates a fractional float (1.5 gives 1)
+	boolSerializeLax            bool // Boolean serialization turns any string but "" and "false" into true, and slices and maps into false
+	stringSerializeAnything     bool // String and ID serialization print slices, maps, booleans and floats with fmt (%v) instead of failing
+	rootPropagationDropsErrors  bool // when a non-null root field is null, the field errors collected before are dropped from the result
+	introDefaultValueUntyped    bool // introspection prints the default value of an enum, list or input object argument as a quoted fmt string (astFromValue gets the Argument, not its type)
+	introEmptyDescription       bool // introspection gives an empty string, not null, for a type, field, argument or enum value without a description
+	duplicateDirectivesAccepted bool // the same directive twice on one selection passes validation (no UniqueDirectivesPerLocation rule)
+	sdlInExecutableAccepted     bool // a type definition in an executable document passes validation (no ExecutableDefinitions rule); execution then fails
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- type system
+
+// hzRef is a type reference: a named type, a list or a non-null wrapper.
+type hzRef struct {
+	name string // named type, when of == nil
+	list bool   // [of]
+	of   *hzRef // the wrapped type of a list or a non-null
+}
+
+func hzNamed(name string) *hzRef   { return &hzRef{name: name} }
+func hzListOf(of *hzRef) *hzRef    { return &hzRef{list: true, of: of} }
+func hzNonNullOf(of *hzRef) *hzRef { return &hzRef{of: of} }
+
+func (r *hzRef) isNonNull() bool { return r.of != nil && !r.list }
+func (r *hzRef) isList() bool    { return r.list }
+
+// nullable strips one non-null wrapper.
+func (r *hzRef) nullable() *hzRef {
+	if r.isNonNull() {
+		return r.of
+	}
+	return r
+}
+
+// named is the innermost named type.
+func (r *hzRef) named() string {
+	for r.of != nil {
+		r = r.of
+	}
+	return r.name
+}
+
+func (r *hzRef) String() string {
+	switch {
+	case r.list:
+		return "[" + r.of.String() + "]"
+	case r.of != nil:
+		return r.of.String() + "!"
+	}
+	return r.name
+}
+
+type hzArg struct {
+	name string
+	typ  *hzRef
+	def  any // default value (hzNoDefault when none)
+	desc string
+}
+
+type hzFieldDef struct {
+	name       string
+	typ        *hzRef
+	args       []*hzArg
+	desc       string
+	deprecated string // deprecation reason, "" for none
+	echo       bool   // resolved to the canonical JSON of its arguments
+}
+
+type hzEnumDef struct {
+	name   string
+	values []string
+	desc   string
+}
+
+type hzInputField struct {
+	name string
+	typ  *hzRef
+	def  any
+	desc string
+}
+
+type hzInputDef struct {
+	name   string
+	fields []*hzInputField
+	desc   string
+}
+
+type hzIfaceDef struct {
+	name   string
+	fields []*hzFieldDef
+	desc   string
+}
+
+type hzObjectDef struct {
+	name   string
+	ifaces []string
+	fields []*hzFieldDef
+	desc   string
+}
+
+type hzUnionDef struct {
+	name    string
+	members []string
+	desc    string
+}
+
+// hzSchema is a generated type system; Query is the root.
+type hzSchema struct {
+	enums   []*hzEnumDef
+	inputs  []*hzInputDef
+	ifaces  []*hzIfaceDef
+	objects []*hzObjectDef
+	unions  []*hzUnionDef
+}
+
+// hzNoDefault marks an argument or input field without a default value (nil is the literal
+// null default).
+type hzNoDefaultT struct{}
+
+var hzNoDefault = hzNoDefaultT{}
+
+// hzEnumVal is an enum value in a generated value (printed bare in literals, a string in JSON).
+type hzEnumVal string
+
+var hzScalars = []string{"Int", "Float", "String", "Boolean", "ID"}
+
+func hzIsScalar(name string) bool {
+	for _, s := range hzScalars {
+		if s == name {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *hzSchema) enum(name string) *hzEnumDef {
+	for _, e := range s.enums {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) input(name string) *hzInputDef {
+	for _, e := range s.inputs {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) iface(name string) *hzIfaceDef {
+	for _, e := range s.ifaces {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) object(name string) *hzObjectDef {
+	for _, e := range s.objects {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) union(name string) *hzUnionDef {
+	for _, e := range s.unions {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) isLeaf(name string) bool { return hzIsScalar(name) || s.enum(name) != nil }
+
+func (s *hzSchema) isAbstract(name string) bool { return s.iface(name) != nil || s.union(name) != nil }
+
+// fields of an object or interface type (nil for others).
+func (s *hzSchema) fields(name string) []*hzFieldDef {
+	if o := s.object(name); o != nil {
+		return o.fields
+	}
+	if i := s.iface(name); i != nil {
+		return i.fields
+	}
+	return nil
+}
+
+func (s *hzSchema) field(typeName, fieldName string) *hzFieldDef {
+	for _, f := range s.fields(typeName) {
+		if f.name == fieldName {
+			return f
+		}
+	}
+	return nil
+}
+
+// possibleTypes of an object (itself), interface or union.
+func (s *hzSchema) possibleTypes(name string) []string {
+	if s.object(name) != nil {
+		return []string{name}
+	}
+	if u := s.union(name); u != nil {
+		return u.members
+	}
+	var out []string
+	for _, o := range s.objects {
+		for _, i := range o.ifaces {
+			if i == name {
+				out = append(out, o.name)
+			}
+		}
+	}
+	return out
+}
+
+// overlap: do two composite types share a possible type (fragment spread applicability).
+func (s *hzSchema) overlap(a, b string) bool {
+	for _, x := range s.possibleTypes(a) {
+		for _, y := range s.possibleTypes(b) {
+			if x == y {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- SDL
+
+func hzQuote(s string) string {
+	b, _ := hzJSONMarshal(s)
+	return string(b)
+}
+
+// hzLiteral prints a value as a GraphQL literal (the SDL form of a default value).
+func hzLiteral(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(v)
+	case float64:
+		return hzFloatLiteral(v)
+	case string:
+		return hzQuote(v)
+	case hzEnumVal:
+		return string(v)
+	case []any:
+		parts := make([]string, len(v))
+		for i, x := range v {
+			parts[i] = hzLiteral(x)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			parts[i] = k + ": " + hzLiteral(v[k])
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	panic(fmt.Sprintf("hzLiteral: %T", v))
+}
+
+// hzFloatLiteral prints a float with a fraction or an exponent, as a FloatValue token.
+func hzFloatLiteral(f float64) string {
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	if !strings.ContainsAny(s, ".eE") {
+		s += ".0"
+	}
+	return s
+}
+
+func hzDesc(desc, indent string) string {
+	if desc == "" {
+		return ""
+	}
+	return indent + hzQuote(desc) + "\n"
+}
+
+func hzArgsSDL(args []*hzArg) string {
+	if len(args) == 0 {
+		return ""
+	}
+	parts := make([]string, len(args))
+	for i, a := range args {
+		s := a.name + ": " + a.typ.String()
+		if a.def != hzNoDefault {
+			s += " = " + hzLiteral(a.def)
+		}
+		if a.desc != "" {
+			s = hzQuote(a.desc) + " " + s
+		}
+		parts[i] = s
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func hzFieldsSDL(fields []*hzFieldDef) string {
+	var b strings.Builder
+	for _, f := range fields {
+		b.WriteString(hzDesc(f.desc, "  "))
+		b.WriteString("  " + f.name + hzArgsSDL(f.args) + ": " + f.typ.String())
+		if f.deprecated != "" {
+			b.WriteString(" @deprecated(reason: " + hzQuote(f.deprecated) + ")")
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+// hzSDL prints the schema in the schema definition language, for graphql-core's build_schema.
+func hzSDL(s *hzSchema) string {
+	var b strings.Builder
+	for _, e := range s.enums {
+		b.WriteString(hzDesc(e.desc, ""))
+		b.WriteString("enum " + e.name + " {\n")
+		for _, v := range e.values {
+			b.WriteString("  " + v + "\n")
+		}
+		b.WriteString("}\n\n")
+	}
+	for _, in := range s.inputs {
+		b.WriteString(hzDesc(in.desc, ""))
+		b.WriteString("input " + in.name + " {\n")
+		for _, f := range in.fields {
+			b.WriteString(hzDesc(f.desc, "  "))
+			b.WriteString("  " + f.name + ": " + f.typ.String())
+			if f.def != hzNoDefault {
+				b.WriteString(" = " + hzLiteral(f.def))
+			}
+			b.WriteString("\n")
+		}
+		b.WriteString("}\n\n")
+	}
+	for _, i := range s.ifaces {
+		b.WriteString(hzDesc(i.desc, ""))
+		b.WriteString("interface " + i.name + " {\n" + hzFieldsSDL(i.fields) + "}\n\n")
+	}
+	for _, o := range s.objects {
+		b.WriteString(hzDesc(o.desc, ""))
+		b.WriteString("type " + o.name)
+		if len(o.ifaces) > 0 {
+			b.WriteString(" implements " + strings.Join(o.ifaces, " & "))
+		}
+		b.WriteString(" {\n" + hzFieldsSDL(o.fields) + "}\n\n")
+	}
+	for _, u := range s.unions {
+		b.WriteString(hzDesc(u.desc, ""))
+		b.WriteString("union " + u.name + " = " + strings.Join(u.members, " | ") + "\n\n")
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- Go schema
+
+// hzGoValue turns a generated value into the Go value graphql-go holds for a variable.
+func hzGoValue(v any) any {
+	switch v := v.(type) {
+	case hzEnumVal:
+		return string(v)
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = hzGoValue(x)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = hzGoValue(x)
+		}
+		return out
+	}
+	return v
+}
+
+// hzGoDefault turns a generated default value into the coerced Go value graphql-go holds for
+// it (build_schema coerces the SDL literal: an Int literal is a float64 for Float and a string
+// for ID).
+func hzGoDefault(s *hzSchema, r *hzRef, v any) any {
+	if v == nil {
+		return nil
+	}
+	if r.isNonNull() {
+		return hzGoDefault(s, r.of, v)
+	}
+	if r.isList() {
+		items, ok := v.([]any)
+		if !ok {
+			items = []any{v}
+		}
+		out := make([]any, len(items))
+		for i, x := range items {
+			out[i] = hzGoDefault(s, r.of, x)
+		}
+		return out
+	}
+	switch r.name {
+	case "Float":
+		if i, ok := v.(int); ok {
+			return float64(i)
+		}
+	case "ID":
+		if i, ok := v.(int); ok {
+			return strconv.Itoa(i)
+		}
+	}
+	if in := s.input(r.name); in != nil {
+		// Literal coercion fills in the defaults of absent fields.
+		m := v.(map[string]any)
+		out := make(map[string]any, len(m))
+		for _, f := range in.fields {
+			if x, ok := m[f.name]; ok {
+				out[f.name] = hzGoDefault(s, f.typ, x)
+			} else if f.def != hzNoDefault {
+				out[f.name] = hzGoDefault(s, f.typ, f.def)
+			}
+		}
+		return out
+	}
+	return hzGoValue(v)
+}
+
+// hzValidValue: is v a valid input value of the type (nulls only in nullable positions, the
+// right kinds, required input fields present)? A check on the generators' strict values.
+func hzValidValue(s *hzSchema, r *hzRef, v any) bool {
+	if v == nil {
+		return !r.isNonNull()
+	}
+	if r.isNonNull() {
+		return hzValidValue(s, r.of, v)
+	}
+	if r.isList() {
+		items, ok := v.([]any)
+		if !ok {
+			return hzValidValue(s, r.of, v)
+		}
+		for _, x := range items {
+			if !hzValidValue(s, r.of, x) {
+				return false
+			}
+		}
+		return true
+	}
+	switch r.name {
+	case "Int":
+		_, ok := v.(int)
+		return ok
+	case "Float":
+		_, isInt := v.(int)
+		_, isFloat := v.(float64)
+		return isInt || isFloat
+	case "String":
+		_, ok := v.(string)
+		return ok
+	case "Boolean":
+		_, ok := v.(bool)
+		return ok
+	case "ID":
+		_, isInt := v.(int)
+		_, isString := v.(string)
+		return isInt || isString
+	}
+	if e := s.enum(r.name); e != nil {
+		ev, ok := v.(hzEnumVal)
+		if !ok {
+			return false
+		}
+		for _, name := range e.values {
+			if name == string(ev) {
+				return true
+			}
+		}
+		return false
+	}
+	in := s.input(r.name)
+	m, ok := v.(map[string]any)
+	if in == nil || !ok {
+		return false
+	}
+	for k, x := range m {
+		var f *hzInputField
+		for _, g := range in.fields {
+			if g.name == k {
+				f = g
+			}
+		}
+		if f == nil || !hzValidValue(s, f.typ, x) {
+			return false
+		}
+	}
+	for _, f := range in.fields {
+		if _, present := m[f.name]; !present && f.typ.isNonNull() && f.def == hzNoDefault {
+			return false
+		}
+	}
+	return true
+}
+
+type hzGoTypes map[string]graphql.Type
+
+func (ts hzGoTypes) ref(r *hzRef) graphql.Type {
+	switch {
+	case r.list:
+		return graphql.NewList(ts.ref(r.of))
+	case r.of != nil:
+		return graphql.NewNonNull(ts.ref(r.of))
+	}
+	t, ok := ts[r.name]
+	if !ok {
+		panic("hzGoTypes: unknown type " + r.name)
+	}
+	return t
+}
+
+func (ts hzGoTypes) field(s *hzSchema, f *hzFieldDef) *graphql.Field {
+	gf := &graphql.Field{
+		Type:              ts.ref(f.typ),
+		Description:       f.desc,
+		DeprecationReason: f.deprecated,
+	}
+	if len(f.args) > 0 {
+		gf.Args = graphql.FieldConfigArgument{}
+		for _, a := range f.args {
+			ac := &graphql.ArgumentConfig{Type: ts.ref(a.typ), Description: a.desc}
+			if a.def != hzNoDefault {
+				ac.DefaultValue = hzGoDefault(s, a.typ, a.def)
+			}
+			gf.Args[a.name] = ac
+		}
+	}
+	if f.echo {
+		gf.Resolve = func(p graphql.ResolveParams) (any, error) {
+			return hzCanonical(p.Args), nil
+		}
+	}
+	return gf
+}
+
+// hzBuild builds the graphql-go schema of a generated type system. Every object type checks
+// the __typename of its values (IsTypeOf), as graphql-core's default type resolver reads it.
+func hzBuild(s *hzSchema) (graphql.Schema, error) {
+	ts := hzGoTypes{
+		"Int": graphql.Int, "Float": graphql.Float, "String": graphql.String,
+		"Boolean": graphql.Boolean, "ID": graphql.ID,
+	}
+	for _, e := range s.enums {
+		values := graphql.EnumValueConfigMap{}
+		for _, v := range e.values {
+			values[v] = &graphql.EnumValueConfig{Value: v}
+		}
+		ts[e.name] = graphql.NewEnum(graphql.EnumConfig{Name: e.name, Values: values, Description: e.desc})
+	}
+	for _, i := range s.ifaces {
+		ts[i.name] = graphql.NewInterface(graphql.InterfaceConfig{Name: i.name, Fields: graphql.Fields{}, Description: i.desc})
+	}
+	for _, o := range s.objects {
+		name := o.name
+		var ifaces []*graphql.Interface
+		for _, i := range o.ifaces {
+			ifaces = append(ifaces, ts[i].(*graphql.Interface))
+		}
+		ts[o.name] = graphql.NewObject(graphql.ObjectConfig{
+			Name:        o.name,
+			Fields:      graphql.Fields{},
+			Interfaces:  ifaces,
+			Description: o.desc,
+			IsTypeOf: func(p graphql.IsTypeOfParams) bool {
+				m, ok := p.Value.(map[string]any)
+				return ok && m["__typename"] == name
+			},
+		})
+	}
+	for _, u := range s.unions {
+		var members []*graphql.Object
+		for _, m := range u.members {
+			members = append(members, ts[m].(*graphql.Object))
+		}
+		ts[u.name] = graphql.NewUnion(graphql.UnionConfig{Name: u.name, Types: members, Description: u.desc})
+	}
+	for _, in := range s.inputs {
+		ts[in.name] = graphql.NewInputObject(graphql.InputObjectConfig{Name: in.name, Fields: graphql.InputObjectConfigFieldMap{}, Description: in.desc})
+	}
+	// Fields, once every type exists.
+	for _, i := range s.ifaces {
+		it := ts[i.name].(*graphql.Interface)
+		for _, f := range i.fields {
+			it.AddFieldConfig(f.name, ts.field(s, f))
+		}
+	}
+	for _, o := range s.objects {
+		ot := ts[o.name].(*graphql.Object)
+		for _, f := range o.fields {
+			ot.AddFieldConfig(f.name, ts.field(s, f))
+		}
+	}
+	for _, in := range s.inputs {
+		it := ts[in.name].(*graphql.InputObject)
+		for _, f := range in.fields {
+			fc := &graphql.InputObjectFieldConfig{Type: ts.ref(f.typ), Description: f.desc}
+			if f.def != hzNoDefault {
+				fc.DefaultValue = hzGoDefault(s, f.typ, f.def)
+			}
+			it.AddFieldConfig(f.name, fc)
+		}
+	}
+	// Every named type, as build_schema puts every SDL type in the type map.
+	var extra []graphql.Type
+	for name, t := range ts {
+		if name != "Query" && !hzIsScalar(name) {
+			extra = append(extra, t)
+		}
+	}
+	return graphql.NewSchema(graphql.SchemaConfig{Query: ts["Query"].(*graphql.Object), Types: extra})
+}
+
+// --------------------------------------------------------------------------- canonical JSON
+
+// hzCanonical prints coerced argument values in a form both implementations can produce:
+// sorted keys, integers plain, floats with four decimals, strings JSON-quoted.
+func hzCanonical(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(v)
+	case int64:
+		return strconv.FormatInt(v, 10)
+	case float64:
+		return strconv.FormatFloat(v, 'f', 4, 64)
+	case float32:
+		return strconv.FormatFloat(float64(v), 'f', 4, 64)
+	case string:
+		return hzQuote(v)
+	case []any:
+		parts := make([]string, len(v))
+		for i, x := range v {
+			parts[i] = hzCanonical(x)
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case map[string]any:
+		// Null-valued entries are left out, as graphql-go leaves null input fields out of its
+		// maps: absent and null compare equal.
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			if v[k] != nil {
+				keys = append(keys, k)
+			}
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			parts[i] = hzQuote(k) + ":" + hzCanonical(v[k])
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	return fmt.Sprintf("<%T>", v)
+}
