+package hegel
+
+// Generators: root data for a type system, and an operation against it.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	hzFieldNames = []string{"a", "b", "c", "d", "e", "f", "id", "name", "x", "y", "value", "items"}
+	hzArgNames   = []string{"n", "s", "flag", "in", "list", "id", "e", "f"}
+	hzEnumNames  = []string{"RED", "GREEN", "BLUE", "ALPHA", "beta", "x1", "NORTH"}
+	hzStrings    = []string{"", "a", "hello", "with space", "quote\"d", "back\\slash", "new\nline", "tab\tx", "unicode é中", "0", "-1", "true", "null"}
+	hzDescs      = []string{"a description", "another one", "with \"quotes\"", "two\nlines", "trailing space "}
+)
+
+// The type system comes from the package-level generator schemas (hegel_zoo_schema_test.go);
+// the generators below are the old ones TestHegelExecute still draws from (part 2 of the
+// rewrite replaces them).
+
+// --------------------------------------------------------------------------- input values
+
+// hzValOpts says what an input value is for: strict values are valid, the others include a
+// few invalid ones (out-of-range ints, wrong kinds, unknown enum values and fields); literal
+// values are printed into the operation, variable values are passed as variables.
+type hzValOpts struct {
+	strict   bool
+	literal  bool
+	variable bool
+}
+
+// hzGenValue generates an input value of the type.
+func hzGenValue(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	v := hzGenValueInner(tc, s, r, o)
+	if o.strict && !hzValidValue(s, r, v) {
+		panic(fmt.Sprintf("generator: invalid strict value %s for %s", hzLiteral(v), r))
+	}
+	return v
+}
+
+func hzGenValueInner(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	if r.isNonNull() {
+		return hzGenValueNonNull(tc, s, r.of, o)
+	}
+	if hzChance(tc, 15) {
+		if o.literal && HZKnown.nullLiteralSyntaxError {
+			hzAvoid("nullLiteralSyntaxError")
+		} else {
+			return nil
+		}
+	}
+	return hzGenValueNonNull(tc, s, r, o)
+}
+
+func hzGenValueNonNull(tc hegel.TestCase, s *hzSchema, r *hzRef, o hzValOpts) any {
+	if r.isList() {
+		if !r.of.nullable().isList() && hzChance(tc, 25) {
+			// A single non-list value coerces to a list of one.
+			return hzGenValueNonNull(tc, s, r.of.nullable(), o)
+		}
+		n := hzDrawInt(tc, 0, 3)
+		out := make([]any, 0, n)
+		for i := 0; i < n; i++ {
+			out = append(out, hzGenValueInner(tc, s, r.of, o))
+		}
+		return out
+	}
+	if !o.strict && hzChance(tc, 8) {
+		return hzGenWrongInput(tc, s, r.name, o)
+	}
+	switch r.name {
+	case "Int":
+		return hzPick(tc, []int{0, 1, -1, 7, 42, -100, 2147483647, -2147483648})
+	case "Float":
+		if hzChance(tc, 40) {
+			return hzPick(tc, []int{0, 3, -2, 1000})
+		}
+		return hzPick(tc, []float64{0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75})
+	case "String":
+		return hzPick(tc, hzStrings)
+	case "Boolean":
+		return hzChance(tc, 50)
+	case "ID":
+		if hzChance(tc, 30) {
+			return hzPick(tc, []int{1, 42, 0})
+		}
+		return hzPick(tc, []string{"id1", "x", "", "42"})
+	}
+	if e := s.enum(r.name); e != nil {
+		return hzEnumVal(hzPick(tc, e.values))
+	}
+	in := s.input(r.name)
+	if in == nil {
+		panic("hzGenValue: unknown input type " + r.name)
+	}
+	m := map[string]any{}
+	for _, f := range in.fields {
+		required := f.typ.isNonNull() && f.def == hzNoDefault
+		if f.typ.isNonNull() && f.def != hzNoDefault && HZKnown.nonNullArgDefaultRequired {
+			hzAvoid("nonNullArgDefaultRequired")
+			required = true
+		}
+		if required || hzChance(tc, 60) {
+			v := hzGenValueInner(tc, s, f.typ, o)
+			if v == nil && f.def != hzNoDefault && o.variable && HZKnown.nullVariableUsesDefault {
+				hzAvoid("nullVariableUsesDefault")
+				v = hzGenValueNonNull(tc, s, f.typ.nullable(), o)
+			}
+			m[f.name] = v
+		}
+	}
+	if !o.strict && hzChance(tc, 6) {
+		m["unknown"] = 1
+	}
+	return m
+}
+
+// hzGenWrongInput is a value of the wrong kind for the named input type.
+func hzGenWrongInput(tc hegel.TestCase, s *hzSchema, name string, o hzValOpts) any {
+	if o.variable && HZKnown.laxVariableCoercion {
+		// Only the kinds graphql-go rejects too.
+		hzAvoid("laxVariableCoercion")
+		switch name {
+		case "Int":
+			return hzPick(tc, []any{2147483648, -2147483649, 4.0})
+		case "Float":
+			return hzPick(tc, []any{"abc", hzEnumVal("RED")})
+		case "String", "Boolean", "ID":
+			return hzGenOutputLeaf(tc, s, name)
+		}
+	}
+	switch name {
+	case "Int":
+		if o.literal && HZKnown.intLiteralRangeUnchecked {
+			hzAvoid("intLiteralRangeUnchecked")
+			return hzPick(tc, []any{1.5, "3", true, 4.0})
+		}
+		return hzPick(tc, []any{2147483648, -2147483649, 2147483648, -2147483649, 1.5, "3", true, 4.0})
+	case "Float":
+		return hzPick(tc, []any{"1.5", true, hzEnumVal("RED")})
+	case "String":
+		return hzPick(tc, []any{1, true, 1.5, hzEnumVal("RED")})
+	case "Boolean":
+		return hzPick(tc, []any{"true", 1, 0})
+	case "ID":
+		return hzPick(tc, []any{true, 1.5, hzEnumVal("RED")})
+	}
+	if e := s.enum(name); e != nil {
+		return hzPick(tc, []any{hzEnumVal("NOPE"), hzPick(tc, e.values), 1, hzEnumVal(strings.ToLower(e.values[0]))})
+	}
+	return hzPick(tc, []any{1, "x", []any{}})
+}
+
+// --------------------------------------------------------------------------- root data
+
+// hzGenData generates root data for an object type: a map with __typename and a value for
+// each field (mostly of the right kind; a few of the wrong kind, nulls and missing fields).
+func hzGenData(tc hegel.TestCase, s *hzSchema, typeName string, depth int) map[string]any {
+	o := s.object(typeName)
+	m := map[string]any{"__typename": typeName}
+	if hzChance(tc, 3) {
+		delete(m, "__typename")
+	}
+	for _, f := range o.fields {
+		if f.echo || hzChance(tc, 10) {
+			continue // missing: resolves to null
+		}
+		m[f.name] = hzGenOutput(tc, s, f.typ, depth)
+	}
+	return m
+}
+
+func hzGenOutput(tc hegel.TestCase, s *hzSchema, r *hzRef, depth int) any {
+	if r.isNonNull() {
+		if hzChance(tc, 5) {
+			return nil
+		}
+		return hzGenOutput(tc, s, r.of, depth)
+	}
+	if hzChance(tc, 12) {
+		return nil
+	}
+	if r.isList() {
+		if hzChance(tc, 4) {
+			return hzGenOutputLeaf(tc, s, "Int")
+		}
+		n := hzDrawInt(tc, 0, 3)
+		out := make([]any, 0, n)
+		for i := 0; i < n; i++ {
+			out = append(out, hzGenOutput(tc, s, r.of, depth))
+		}
+		return out
+	}
+	if s.isLeaf(r.name) {
+		if hzChance(tc, 18) {
+			return hzGenWrongOutput(tc, s, r.name)
+		}
+		return hzGenOutputLeaf(tc, s, r.name)
+	}
+	if depth <= 0 {
+		return nil
+	}
+	if s.object(r.name) != nil {
+		if hzChance(tc, 3) {
+			return hzGenOutputLeaf(tc, s, "String")
+		}
+		return hzGenData(tc, s, r.name, depth-1)
+	}
+	possible := s.possibleTypes(r.name)
+	if hzChance(tc, 5) || len(possible) == 0 {
+		// A type that is not possible for the abstract type.
+		return hzGenData(tc, s, hzPick(tc, s.objects).name, depth-1)
+	}
+	return hzGenData(tc, s, hzPick(tc, possible), depth-1)
+}
+
+func hzGenOutputLeaf(tc hegel.TestCase, s *hzSchema, name string) any {
+	switch name {
+	case "Int":
+		return hzPick(tc, []int{0, 1, -1, 7, 42, -100, 2147483647, -2147483648})
+	case "Float":
+		if hzChance(tc, 40) {
+			return hzPick(tc, []int{0, 3, -2, 1000})
+		}
+		return hzPick(tc, []float64{0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75})
+	case "String":
+		return hzPick(tc, hzStrings)
+	case "Boolean":
+		return hzChance(tc, 50)
+	case "ID":
+		if hzChance(tc, 30) {
+			return hzPick(tc, []int{1, 42, 0})
+		}
+		return hzPick(tc, []string{"id1", "x", "", "42"})
+	}
+	return hzPick(tc, s.enum(name).values)
+}
+
+// hzGenWrongOutput is a resolved value of the wrong kind for the leaf type. Values marked
+// with a switch are left out while it is on.
+func hzGenWrongOutput(tc hegel.TestCase, s *hzSchema, name string) any {
+	type wrong struct {
+		v      any
+		avoid  *bool
+		reason string
+	}
+	var pool []wrong
+	add := func(v any, avoid *bool, reason string) { pool = append(pool, wrong{v, avoid, reason}) }
+	switch name {
+	case "Int":
+		add("3", nil, "")
+		add(4.0, nil, "")
+		add(true, nil, "")
+		add(2147483648, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(-2147483649, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		for _, f := range []float64{1.5, -2.25, 0.5, 7.75, 1e-3} {
+			add(f, &HZKnown.intSerializeTruncates, "intSerializeTruncates")
+		}
+	case "Float":
+		add("1.5", nil, "")
+		add(true, nil, "")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(map[string]any{}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+	case "String":
+		add(1, nil, "")
+		add(true, nil, "")
+		add(1.5, nil, "")
+		add([]any{"a"}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{"a": 1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	case "Boolean":
+		add(1, nil, "")
+		add(0, nil, "")
+		add(2.5, nil, "")
+		for _, v := range []any{"true", "", "x", "false", "0", []any{}, map[string]any{}} {
+			add(v, &HZKnown.boolSerializeLax, "boolSerializeLax")
+		}
+	case "ID":
+		add(1, nil, "")
+		add(true, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(1.5, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add([]any{1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	default:
+		e := s.enum(name)
+		add("NOPE", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(1, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(strings.ToLower(e.values[0]), &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(true, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{e.values[0]}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+		add(map[string]any{}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+	}
+	w := hzPick(tc, pool)
+	if w.avoid != nil && *w.avoid {
+		hzAvoid(w.reason)
+		return hzGenOutputLeaf(tc, s, name)
+	}
+	return w.v
+}
+
+// --------------------------------------------------------------------------- operations
+
+type hzVarDef struct {
+	name     string
+	typ      *hzRef
+	def      any  // hzNoDefault for none
+	value    any  // the runtime value, when provided
+	provided bool // in the variables map
+}
+
+type hzFragDef struct {
+	name string
+	on   string
+	body string
+}
+
+// hzQuery is a generated operation with its variables.
+type hzQuery struct {
+	text      string
+	vars      []*hzVarDef
+	variables map[string]any // nil when none provided
+	operation string         // OperationName, "" when unset
+	fields    int            // field selections
+	features  map[string]int // counts of the generated features, for the collector
+}
+
+type hzQueryGen struct {
+	tc     hegel.TestCase
+	s      *hzSchema
+	q      *hzQuery
+	frags  []*hzFragDef
+	fragN  int
+	aliasN int
+	budget int
+}
+
+func (g *hzQueryGen) feature(name string) { g.q.features[name]++ }
+
+// hzGenQuery generates an operation against the schema: a selection tree of aliased fields
+// with literal and variable arguments, __typename, inline fragments and fragment spreads,
+// @skip/@include, and optionally a second operation selected by name.
+func hzGenQuery(tc hegel.TestCase, s *hzSchema) *hzQuery {
+	g := &hzQueryGen{tc: tc, s: s, q: &hzQuery{features: map[string]int{}}, budget: 25}
+	return hzGenQueryWith(tc, s, g)
+}
+
+// hzGenQueryWith generates the operation with a given generator state (kept for the
+// mutations of TestHegelValidate).
+func hzGenQueryWith(tc hegel.TestCase, s *hzSchema, g *hzQueryGen) *hzQuery {
+	body := g.selectionSet("Query", 3, false)
+	var b strings.Builder
+	named := hzChance(tc, 50)
+	second := hzChance(tc, 10)
+	if named || second {
+		b.WriteString("query Q1")
+	} else if len(g.q.vars) > 0 || hzChance(tc, 50) {
+		b.WriteString("query")
+	}
+	if len(g.q.vars) > 0 {
+		parts := make([]string, len(g.q.vars))
+		for i, v := range g.q.vars {
+			parts[i] = "$" + v.name + ": " + v.typ.String()
+			if v.def != hzNoDefault {
+				parts[i] += " = " + hzLiteral(v.def)
+			}
+		}
+		b.WriteString("(" + strings.Join(parts, ", ") + ")")
+	}
+	if b.Len() > 0 {
+		b.WriteString(" ")
+	}
+	b.WriteString(body)
+	b.WriteString("\n")
+	for _, f := range g.frags {
+		b.WriteString("fragment " + f.name + " on " + f.on + " " + f.body + "\n")
+	}
+	if second {
+		b.WriteString("query Other { __typename }\n")
+		g.q.operation = "Q1"
+		g.feature("operationName")
+	}
+	g.q.text = b.String()
+	for _, v := range g.q.vars {
+		if v.provided {
+			if g.q.variables == nil {
+				g.q.variables = map[string]any{}
+			}
+			g.q.variables[v.name] = hzGoValue(v.value)
+		}
+	}
+	return g.q
+}
+
+// applicable type conditions for a fragment inside a selection on typeName.
+func (g *hzQueryGen) conditions(typeName string) []string {
+	s := g.s
+	out := []string{typeName}
+	if o := s.object(typeName); o != nil {
+		out = append(out, o.ifaces...)
+		for _, u := range s.unions {
+			for _, m := range u.members {
+				if m == typeName {
+					out = append(out, u.name)
+				}
+			}
+		}
+		return out
+	}
+	out = append(out, s.possibleTypes(typeName)...)
+	// Other abstract types sharing a possible type.
+	for _, i := range s.ifaces {
+		if i.name != typeName && s.overlap(i.name, typeName) {
+			out = append(out, i.name)
+		}
+	}
+	for _, u := range s.unions {
+		if u.name != typeName && s.overlap(u.name, typeName) {
+			out = append(out, u.name)
+		}
+	}
+	return out
+}
+
+// directive is an optional @skip/@include; a variable condition only where allowed (on a
+// selection with a fresh alias, while mergedFirstPredicateWins is on).
+func (g *hzQueryGen) directive(allowVar bool) string {
+	tc := g.tc
+	if !hzChance(tc, 20) {
+		return ""
+	}
+	g.feature("directive")
+	name := hzPick(tc, []string{"skip", "include"})
+	var cond string
+	switch hzDrawInt(tc, 1, 3) {
+	case 1:
+		cond = "true"
+	case 2:
+		cond = "false"
+	default:
+		if !allowVar && HZKnown.mergedFirstPredicateWins {
+			hzAvoid("mergedFirstPredicateWins")
+			cond = "false"
+			break
+		}
+		v := g.variable(hzNonNullOf(hzNamed("Boolean")), true)
+		cond = "$" + v.name
+		g.feature("variableDirective")
+	}
+	return " @" + name + "(if: " + cond + ")"
+}
+
+// variable declares a new variable of the type, with a runtime value (mostly valid) or none.
+func (g *hzQueryGen) variable(typ *hzRef, strict bool) *hzVarDef {
+	tc := g.tc
+	v := &hzVarDef{name: fmt.Sprintf("v%d", len(g.q.vars)+1), typ: typ, def: hzNoDefault}
+	if hzChance(tc, 30) {
+		if typ.isNonNull() && HZKnown.nonNullVarDefaultRejected {
+			hzAvoid("nonNullVarDefaultRejected")
+		} else {
+			v.def = hzGenValue(tc, g.s, typ, hzValOpts{strict: true, literal: true})
+			g.feature("variableDefault")
+		}
+	}
+	if hzChance(tc, 92) || (typ.isNonNull() && hzChance(tc, 85)) {
+		v.provided = true
+		v.value = hzGenValue(tc, g.s, typ, hzValOpts{strict: strict, variable: true})
+		if v.value == nil && HZKnown.nullVariableUsesDefault {
+			hzAvoid("nullVariableUsesDefault")
+			v.provided = false
+		}
+	}
+	g.q.vars = append(g.q.vars, v)
+	g.feature("variable")
+	return v
+}
+
+// argument value: a literal or a variable.
+func (g *hzQueryGen) argValue(typ *hzRef) string {
+	tc := g.tc
+	if hzChance(tc, 35) {
+		vt := typ
+		if !typ.isNonNull() && hzChance(tc, 30) {
+			vt = hzNonNullOf(typ)
+		}
+		v := g.variable(vt, hzChance(tc, 85))
+		return "$" + v.name
+	}
+	val := hzGenValue(tc, g.s, typ, hzValOpts{strict: hzChance(tc, 90), literal: true})
+	if val == nil {
+		g.feature("nullLiteral")
+	}
+	return hzLiteral(val)
+}
+
+func (g *hzQueryGen) arguments(f *hzFieldDef) string {
+	tc := g.tc
+	var parts []string
+	for _, a := range f.args {
+		required := a.typ.isNonNull() && a.def == hzNoDefault
+		if a.typ.isNonNull() && a.def != hzNoDefault && HZKnown.nonNullArgDefaultRequired {
+			hzAvoid("nonNullArgDefaultRequired")
+			required = true
+		}
+		if required || hzChance(tc, 65) {
+			parts = append(parts, a.name+": "+g.argValue(a.typ))
+		}
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+// selectionSet generates { ... } for a composite type; depth bounds the nesting; inWrapped
+// says the set is directly under a field of a list or non-null type.
+func (g *hzQueryGen) selectionSet(typeName string, depth int, inWrapped bool) string {
+	tc, s := g.tc, g.s
+	fields := s.fields(typeName)
+	var leafFields, compositeFields []*hzFieldDef
+	for _, f := range fields {
+		if s.isLeaf(f.typ.named()) {
+			leafFields = append(leafFields, f)
+		} else {
+			compositeFields = append(compositeFields, f)
+		}
+	}
+	n := hzDrawInt(tc, 1, 4)
+	var sels []string
+	for i := 0; i < n && g.budget > 0; i++ {
+		switch roll := hzDrawInt(tc, 1, 100); {
+		case roll <= 10 || (len(fields) == 0 && roll <= 60):
+			sels = append(sels, "__typename"+g.directive(false))
+			g.feature("__typename")
+		case roll <= 60:
+			var pool []*hzFieldDef
+			if depth > 0 && len(compositeFields) > 0 && hzChance(tc, 50) {
+				pool = compositeFields
+			} else {
+				pool = leafFields
+			}
+			if len(pool) == 0 {
+				pool = fields
+				if depth <= 0 {
+					pool = leafFields
+				}
+			}
+			if len(pool) == 0 {
+				continue
+			}
+			f := hzPick(tc, pool)
+			g.budget--
+			g.q.fields++
+			aliased := len(f.args) > 0 || hzChance(tc, 40)
+			sel := f.name + g.arguments(f) + g.directive(aliased)
+			if aliased {
+				g.aliasN++
+				sel = fmt.Sprintf("f%d: %s", g.aliasN, sel)
+				g.feature("alias")
+			} else if hzChance(tc, 15) && s.isLeaf(f.typ.named()) {
+				// The same leaf field twice: merged.
+				sels = append(sels, sel)
+				g.feature("duplicateField")
+			}
+			if !s.isLeaf(f.typ.named()) {
+				sel += " " + g.selectionSet(f.typ.named(), depth-1, f.typ.of != nil)
+			}
+			sels = append(sels, sel)
+		case roll <= 80:
+			cond := hzPick(tc, g.conditions(typeName))
+			noCondition := hzChance(tc, 20)
+			if noCondition && inWrapped && HZKnown.noConditionFragmentInWrap {
+				hzAvoid("noConditionFragmentInWrap")
+				noCondition = false
+			}
+			if noCondition {
+				sels = append(sels, "..."+g.directive(false)+" "+g.selectionSet(typeName, depth, false))
+				g.feature("inlineFragmentNoCondition")
+			} else {
+				sels = append(sels, "... on "+cond+g.directive(false)+" "+g.selectionSet(cond, depth, false))
+				g.feature("inlineFragment")
+			}
+		default:
+			cond := hzPick(tc, g.conditions(typeName))
+			var frag *hzFragDef
+			for _, fr := range g.frags {
+				if fr.on == cond && hzChance(tc, 50) {
+					frag = fr
+				}
+			}
+			if frag == nil {
+				g.fragN++
+				frag = &hzFragDef{name: fmt.Sprintf("F%d", g.fragN), on: cond}
+				frag.body = g.selectionSet(cond, depth, false)
+				g.frags = append(g.frags, frag)
+			}
+			sels = append(sels, "..."+frag.name+g.directive(false))
+			g.feature("fragmentSpread")
+		}
+	}
+	if len(sels) == 0 {
+		sels = append(sels, "__typename")
+	}
+	return "{ " + strings.Join(sels, " ") + " }"
+}
diff --git a/hegel/hegel_zoo_idioms_test.go b/hegel/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..e87f5bb
--- /dev/null
+++ b/hegel/hegel_zoo_idioms_test.go
@@ -0,0 +1,159 @@
+package hegel
+
+// The generator idioms the properties share, copied from the go/excelize harness
+// (hegel/hegel_zoo_gen_test.go there; go/bubbles' internal/zootest/gen.go before it) with
+// the hz prefix of this package: hegel-go has no weighted choice, biased coin, tuple or
+// counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the first alternative (excelize measured the first of a 2:18:10
+// choice drawn 40% of the time when another draw precedes or follows it, 7% alone), so the
+// rates are what the collector (ZOO_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzCount("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/hegel/hegel_zoo_intro_shapes_test.go b/hegel/hegel_zoo_intro_shapes_test.go
new file mode 100644
index 0000000..90f9995
--- /dev/null
+++ b/hegel/hegel_zoo_intro_shapes_test.go
@@ -0,0 +1,177 @@
+package hegel
+
+// The shape regions of the recorded introspection bugs (bugs.toml graphql-go/15 and 16) and
+// the narrow properties over them: each region is a generator over the bug's shape with
+// random contents (a type system drawn by schemasWith, adjusted after the draw), judged
+// exactly like the wide property (judgeIntro, with the classifier introShape naming the
+// bug). Every narrow property fails every run by default; under HEGEL_NO_KNOWN=1 its
+// generator is the region next to the shape instead (hzShaped) and the property passes.
+// The hit rates quoted at each region are the collector's mismatches over its cases
+// (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowIntro runs a narrow property: every drawn case through the wide property's judge.
+func narrowIntro(t *testing.T, cases hegel.Generator[introCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeIntro(j, o, c)
+		col.count("cases")
+	})
+}
+
+func introOf(g hegel.Generator[*hzSchema]) hegel.Generator[introCase] {
+	return hegel.Map(g, func(s *hzSchema) introCase { return introCase{schema: s} })
+}
+
+// described: every description present (the shape of 16 absent).
+var described = schemaShapes{blank: 0, typed: true}
+
+// --------------------------------------------------------------------------- graphql-go/15
+
+// typedRefs: a reference to an enum or input object with any wrappers, or to any input
+// type in a list: the types whose default values the introspection prints as fmt strings.
+func typedRefs(s *hzSchema) hegel.Generator[*hzRef] {
+	var named []string
+	for _, e := range s.enums {
+		named = append(named, e.name)
+	}
+	for _, in := range s.inputs {
+		named = append(named, in.name)
+	}
+	return hzWeighted(hzW(7, refs(named, wrappers)), hzW(3, refs(inputNames(s), listWrappers)))
+}
+
+// scalarRefs: a scalar, plain or non-null (the defaults printed right).
+func scalarRefs(s *hzSchema) hegel.Generator[*hzRef] { return refs(hzScalars, plainWrappers) }
+
+// withDefault: a type system of sh with one more default value, other than null, of a type
+// drawn by typesOf: the argument of a new field of a drawn object (dflt(x: T = v): Int) or
+// the field of a new input object (input InD { x: T = v }), both described.
+func withDefault(sh schemaShapes, typesOf func(*hzSchema) hegel.Generator[*hzRef]) hegel.Generator[*hzSchema] {
+	return hegel.FlatMap(schemasWith(sh), func(s *hzSchema) hegel.Generator[*hzSchema] {
+		return hegel.FlatMap(typesOf(s), func(r *hzRef) hegel.Generator[*hzSchema] {
+			return hegel.FlatMap(strictNonNull(s, r.nullable(), 3), func(v any) hegel.Generator[*hzSchema] {
+				return hzWeighted(
+					hzW(2, hegel.Map(hzInts(0, len(s.objects)-1), func(i int) *hzSchema { return withArgDefault(s, i, r, v) })),
+					hzW(2, hegel.Map(hzInts(0, 0), func(int) *hzSchema { return withInputDefault(s, r, v) })),
+				)
+			})
+		})
+	})
+}
+
+// withArgDefault: the schema with the field dflt(x: r = v): Int added to the i-th object.
+func withArgDefault(s *hzSchema, i int, r *hzRef, v any) *hzSchema {
+	out := *s
+	out.objects = append([]*hzObjectDef{}, s.objects...)
+	o := *s.objects[i]
+	o.fields = append(append([]*hzFieldDef{}, o.fields...), &hzFieldDef{
+		name: "dflt", typ: hzNamed("Int"), desc: "a description",
+		args: []*hzArg{{name: "x", typ: r, def: v, desc: "a description"}},
+	})
+	out.objects[i] = &o
+	return &out
+}
+
+// withInputDefault: the schema with the input object InD { x: r = v } added.
+func withInputDefault(s *hzSchema, r *hzRef, v any) *hzSchema {
+	out := *s
+	out.inputs = append(append([]*hzInputDef{}, s.inputs...), &hzInputDef{
+		name: "InD", desc: "a description",
+		fields: []*hzInputField{{name: "x", typ: r, def: v, desc: "a description"}},
+	})
+	return &out
+}
+
+// typedDefaults: a type system with every description present and a default value, other
+// than null, on an argument or input field of an enum, list or input-object type (one added
+// deliberately, the rest at the natural rate). Past the shape: the same with defaults on
+// scalar types only (one added deliberately). Hit rate 1000 of 1000.
+var typedDefaults = hzShaped(
+	introOf(withDefault(described, typedRefs)),
+	introOf(withDefault(schemaShapes{blank: 0, typed: false}, scalarRefs)),
+)
+
+func TestHegelIntrospectionDefaultsAreLiterals(t *testing.T) { narrowIntro(t, typedDefaults) }
+
+// --------------------------------------------------------------------------- graphql-go/16
+
+// descPlace: a place of a description in a type system, and how to blank it.
+type descPlace struct {
+	kind  string
+	blank func()
+}
+
+// descPlaces: every place the introspection reports a description: the types (the objects
+// first: Query is the shrink target), the fields, the arguments, the input fields, the enum
+// values.
+func descPlaces(s *hzSchema) []descPlace {
+	var out []descPlace
+	fields := func(fs []*hzFieldDef) {
+		for _, f := range fs {
+			f := f
+			out = append(out, descPlace{"field", func() { f.desc = "" }})
+			for _, a := range f.args {
+				a := a
+				out = append(out, descPlace{"argument", func() { a.desc = "" }})
+			}
+		}
+	}
+	for _, o := range s.objects {
+		o := o
+		out = append(out, descPlace{"object", func() { o.desc = "" }})
+		fields(o.fields)
+	}
+	for _, it := range s.ifaces {
+		it := it
+		out = append(out, descPlace{"interface", func() { it.desc = "" }})
+		fields(it.fields)
+	}
+	for _, u := range s.unions {
+		u := u
+		out = append(out, descPlace{"union", func() { u.desc = "" }})
+	}
+	for _, e := range s.enums {
+		e := e
+		out = append(out, descPlace{"enum", func() { e.desc = "" }})
+		for i := range e.values {
+			i := i
+			out = append(out, descPlace{"enum value", func() { e.valueDescs[i] = "" }})
+		}
+	}
+	for _, in := range s.inputs {
+		in := in
+		out = append(out, descPlace{"input", func() { in.desc = "" }})
+		for _, f := range in.fields {
+			f := f
+			out = append(out, descPlace{"input field", func() { f.desc = "" }})
+		}
+	}
+	return out
+}
+
+// missingDescriptions: a type system with defaults on scalar types only and every
+// description present but one, in a drawn place (a field inherited from an interface is one
+// place for both). Past the shape: every description present. Hit rate 1000 of 1000.
+var missingDescriptions = hzShaped(
+	introOf(hegel.FlatMap(schemasWith(schemaShapes{blank: 0, typed: false}), func(s *hzSchema) hegel.Generator[*hzSchema] {
+		return hegel.Map(hzSampled(descPlaces(s)...), func(p descPlace) *hzSchema {
+			p.blank()
+			return s
+		})
+	})),
+	introOf(schemasWith(schemaShapes{blank: 0, typed: false})),
+)
+
+func TestHegelIntrospectionMissingDescriptionsAreNull(t *testing.T) {
+	narrowIntro(t, missingDescriptions)
+}
diff --git a/hegel/hegel_zoo_intro_test.go b/hegel/hegel_zoo_intro_test.go
new file mode 100644
index 0000000..560bd9a
--- /dev/null
+++ b/hegel/hegel_zoo_intro_test.go
@@ -0,0 +1,306 @@
+package hegel
+
+// TestHegelIntrospection: the introspection of a generated schema must agree with
+// graphql-core's introspection of the same schema built from SDL. The shapes of the recorded
+// bugs (graphql-go/15: a default value of an enum, list or input-object type printed as a
+// quoted fmt string; graphql-go/16: a missing description reported as "" instead of null) are
+// drawn by the type-system generator and named by introShape before the library is called;
+// under HEGEL_NO_KNOWN=1 they are not drawn (schemaShapes). The narrow properties of
+// hegel_zoo_intro_shapes_test.go share judgeIntro.
+
+import (
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// hzIntroQuery is graphql-core's introspection query without the newer fields (specifiedByURL,
+// isRepeatable, schema description, input value deprecation).
+const hzIntroQuery = `query IntrospectionQuery {
+  __schema {
+    queryType { name } mutationType { name } subscriptionType { name }
+    types { ...FullType }
+  }
+}
+fragment FullType on __Type {
+  kind name description
+  fields(includeDeprecated: true) {
+    name description args { ...InputValue } type { ...TypeRef } isDeprecated deprecationReason
+  }
+  inputFields { ...InputValue }
+  interfaces { ...TypeRef }
+  enumValues(includeDeprecated: true) { name description isDeprecated deprecationReason }
+  possibleTypes { ...TypeRef }
+}
+fragment InputValue on __InputValue { name description type { ...TypeRef } defaultValue }
+fragment TypeRef on __Type {
+  kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType {
+  kind name ofType { kind name ofType { kind name } } } } } } }
+}`
+
+var hzIntLikeRe = regexp.MustCompile(`^-?(0|[1-9][0-9]*)$`)
+
+// hzTypeRefInfo: the innermost kind and name of a TypeRef, and whether a LIST wraps it.
+func hzTypeRefInfo(v any) (kind, name string, list bool) {
+	for {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return
+		}
+		kind, _ = m["kind"].(string)
+		name, _ = m["name"].(string)
+		if kind == "LIST" {
+			list = true
+		}
+		if m["ofType"] == nil {
+			return
+		}
+		v = m["ofType"]
+	}
+}
+
+func hzSortByName(l []any) {
+	sort.Slice(l, func(i, j int) bool {
+		a, _ := l[i].(map[string]any)["name"].(string)
+		b, _ := l[j].(map[string]any)["name"].(string)
+		return a < b
+	})
+}
+
+// hzIntroNormalize makes an introspection result comparable, on both sides alike, by the
+// facts of the model: the introspection types and the directives are left out, lists are
+// sorted by name, the built-in scalars' descriptions are not judged, a default value of null
+// (which the Go API cannot express) counts as none, an integer-like ID default is the same
+// quoted or bare, an interface's own interfaces are not judged.
+func hzIntroNormalize(v any) any {
+	root, ok := v.(map[string]any)
+	if !ok {
+		return v
+	}
+	s, _ := root["__schema"].(map[string]any)
+	types, _ := s["types"].([]any)
+	var kept []any
+	for _, t := range types {
+		tm, _ := t.(map[string]any)
+		name, _ := tm["name"].(string)
+		if strings.HasPrefix(name, "__") {
+			continue
+		}
+		if hzIsScalar(name) {
+			tm["description"] = "not judged"
+		}
+		if tm["kind"] == "INTERFACE" {
+			// Interfaces implementing interfaces (spec 2021) are not judged: graphql-go has none.
+			tm["interfaces"] = nil
+		}
+		for _, k := range []string{"fields", "inputFields", "enumValues", "possibleTypes", "interfaces"} {
+			l, _ := tm[k].([]any)
+			hzSortByName(l)
+			for _, f := range l {
+				fm, _ := f.(map[string]any)
+				if k == "inputFields" {
+					hzIntroNormalizeDefault(fm)
+				}
+				args, _ := fm["args"].([]any)
+				hzSortByName(args)
+				for _, a := range args {
+					am, _ := a.(map[string]any)
+					hzIntroNormalizeDefault(am)
+				}
+			}
+		}
+		kept = append(kept, tm)
+	}
+	hzSortByName(kept)
+	s["types"] = kept
+	return v
+}
+
+// hzIntroNormalizeDefault normalises the defaultValue of an input value (an argument or an
+// input field): null counts as none, an integer-like ID is bare.
+func hzIntroNormalizeDefault(m map[string]any) {
+	if m == nil {
+		return
+	}
+	d, ok := m["defaultValue"].(string)
+	if !ok {
+		return
+	}
+	if d == "null" {
+		m["defaultValue"] = nil
+		return
+	}
+	_, name, list := hzTypeRefInfo(m["type"])
+	if name == "ID" && !list {
+		if u := strings.Trim(d, `"`); hzIntLikeRe.MatchString(u) {
+			m["defaultValue"] = u
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// introCase: the schema introspected.
+type introCase struct {
+	schema *hzSchema
+}
+
+func (c introCase) GoString() string { return "introspection of\n" + hzSDL(c.schema) }
+
+var introCases = hegel.Map(schemas, func(s *hzSchema) introCase { return introCase{schema: s} })
+
+// introShape names the recorded bug whose shape the schema has: graphql-go/15 (an argument
+// or input field of an enum, list or input-object type with a default value other than
+// null, anywhere) before graphql-go/16 (a description missing anywhere the introspection
+// reports one: a type, a field, an argument, an input field, an enum value). The order
+// matters: by default nearly every schema has 16's shape (descriptions at 25 %), so 15 is
+// named wherever it is present, and the wide property's shrunk failure, a schema with no
+// default, is 16.
+func introShape(c introCase) string {
+	s := c.schema
+	typedDefault := func(typ *hzRef, def any) bool {
+		return def != hzNoDefault && def != nil && typedRef(s, typ)
+	}
+	blank := false
+	for _, e := range s.enums {
+		blank = blank || e.desc == ""
+		for i := range e.values {
+			blank = blank || e.valueDesc(i) == ""
+		}
+	}
+	for _, in := range s.inputs {
+		blank = blank || in.desc == ""
+		for _, f := range in.fields {
+			if typedDefault(f.typ, f.def) {
+				return "graphql-go/15"
+			}
+			blank = blank || f.desc == ""
+		}
+	}
+	fields := func(desc string, fs []*hzFieldDef) {
+		blank = blank || desc == ""
+		for _, f := range fs {
+			blank = blank || f.desc == ""
+			for _, a := range f.args {
+				blank = blank || a.desc == ""
+			}
+		}
+	}
+	for _, it := range s.ifaces {
+		fields(it.desc, it.fields)
+	}
+	for _, o := range s.objects {
+		fields(o.desc, o.fields)
+		for _, f := range o.fields {
+			for _, a := range f.args {
+				if typedDefault(a.typ, a.def) {
+					return "graphql-go/15"
+				}
+			}
+		}
+	}
+	for _, u := range s.unions {
+		blank = blank || u.desc == ""
+	}
+	if blank {
+		return "graphql-go/16"
+	}
+	return ""
+}
+
+// judgeIntro judges one case: the shape named, then graphql-go's introspection of the
+// schema against graphql-core's of the SDL, normalised.
+func judgeIntro(j *hzCaseJudge, o *hzOracle, c introCase) {
+	j.Shape(introShape(c))
+	sdl := hzSDL(c.schema)
+	py, err := o.execute(sdl, nil, hzIntroQuery, nil, "")
+	if err != nil {
+		j.ht.Fatalf("oracle: %v", err)
+	}
+	if py.SchemaError != "" {
+		j.ht.Fatalf("graphql-core rejects the SDL: %s\n%s", py.SchemaError, sdl)
+	}
+	schema, err := hzBuild(c.schema)
+	if err != nil {
+		j.ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+	}
+	r := graphql.Do(graphql.Params{Schema: schema, RequestString: hzIntroQuery})
+	if len(r.Errors) > 0 || len(py.Errors) > 0 {
+		j.Fail("errors", "introspection errors: graphql-go %v, graphql-core %v\nSDL:\n%s", r.Errors, py.Errors, sdl)
+		return
+	}
+	gb, _ := hzJSONMarshal(r.Data)
+	g := hzIntroNormalize(hzNormalizeJSON(gb))
+	p := hzIntroNormalize(hzNormalizeJSON(py.Data))
+	if !reflect.DeepEqual(g, p) {
+		j.Fail("introspection", "introspection differs\n%s\nSDL:\n%s", hzFirstDiff(g, p), sdl)
+		return
+	}
+	j.col.count("ok")
+}
+
+func TestHegelIntrospection(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, introCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeIntro(j, o, c)
+		col.count("cases")
+	})
+}
+
+// hzFirstDiff describes the first difference between two normalised JSON values.
+func hzFirstDiff(a, b any) string {
+	var walk func(path string, a, b any) string
+	walk = func(path string, a, b any) string {
+		switch av := a.(type) {
+		case map[string]any:
+			bv, ok := b.(map[string]any)
+			if !ok {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			keys := map[string]bool{}
+			for k := range av {
+				keys[k] = true
+			}
+			for k := range bv {
+				keys[k] = true
+			}
+			sorted := make([]string, 0, len(keys))
+			for k := range keys {
+				sorted = append(sorted, k)
+			}
+			sort.Strings(sorted)
+			for _, k := range sorted {
+				if d := walk(path+"."+k, av[k], bv[k]); d != "" {
+					return d
+				}
+			}
+			return ""
+		case []any:
+			bv, ok := b.([]any)
+			if !ok || len(av) != len(bv) {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			for i := range av {
+				if d := walk(fmt.Sprintf("%s[%d]", path, i), av[i], bv[i]); d != "" {
+					return d
+				}
+			}
+			return ""
+		}
+		if !reflect.DeepEqual(a, b) {
+			return fmt.Sprintf("%s: graphql-go %#v, graphql-core %#v", path, a, b)
+		}
+		return ""
+	}
+	return walk("", a, b)
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..55d028a
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,218 @@
+package hegel
+
+// The graphql-core oracle: one python3 process per test, fed JSON lines
+// {sdl, data, query, variables, operation} and answering with the execution result (data and
+// formatted errors) of the same operation against the same schema and root data.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json
+import graphql
+from graphql import build_schema, graphql_sync, parse, validate
+from graphql.type import GraphQLObjectType
+
+def canonical(v):
+    if v is None:
+        return "null"
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if isinstance(v, float):
+        return "%.4f" % v
+    if isinstance(v, str):
+        return json.dumps(v, ensure_ascii=False)
+    if isinstance(v, (list, tuple)):
+        return "[" + ",".join(canonical(x) for x in v) + "]"
+    if isinstance(v, dict):
+        # graphql-go leaves null-valued input fields out of its maps: absent and null compare equal.
+        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + canonical(v[k]) for k in sorted(v) if v[k] is not None) + "}"
+    return "<" + type(v).__name__ + ">"
+
+def echo(src, info, **args):
+    return canonical(args)
+
+def make_schema(sdl):
+    schema = build_schema(sdl)
+    for name, t in schema.type_map.items():
+        if isinstance(t, GraphQLObjectType) and not name.startswith("__"):
+            t.is_type_of = (lambda n: (lambda v, info: isinstance(v, dict) and v.get("__typename") == n))(name)
+            for fname, f in t.fields.items():
+                if fname.startswith("echo"):
+                    f.resolve = echo
+    return schema
+
+def fmt_error(e):
+    d = {"message": e.message, "path": list(e.path) if e.path else None}
+    d["locations"] = [[l.line, l.column] for l in e.locations] if e.locations else None
+    return d
+
+def main():
+    sys.stdout.write(json.dumps({"hello": True, "version": graphql.__version__, "python": sys.version.split()[0]}) + "\n")
+    sys.stdout.flush()
+    for line in sys.stdin:
+        req = json.loads(line)
+        out = {}
+        try:
+            try:
+                schema = make_schema(req["sdl"])
+            except Exception as e:
+                out["schema_error"] = type(e).__name__ + ": " + str(e)[:400]
+                sys.stdout.write(json.dumps(out) + "\n")
+                sys.stdout.flush()
+                continue
+            mode = req.get("mode", "execute")
+            if mode == "validate":
+                try:
+                    doc = parse(req["query"])
+                except Exception as e:
+                    out["errors"] = [{"message": "syntax: " + str(e)[:300], "path": None, "locations": None}]
+                else:
+                    out["errors"] = [fmt_error(e) for e in validate(schema, doc)]
+            else:
+                r = graphql_sync(schema, req["query"], root_value=req.get("data"),
+                                 variable_values=req.get("variables"), operation_name=req.get("operation"))
+                out["data"] = r.data
+                out["errors"] = [fmt_error(e) for e in (r.errors or [])]
+        except Exception as e:
+            out["fatal"] = repr(e)[:400]
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+main()
+`
+
+type hzOracleError struct {
+	Message   string  `json:"message"`
+	Path      []any   `json:"path"`
+	Locations [][]int `json:"locations"`
+}
+
+type hzOracleReply struct {
+	SchemaError string          `json:"schema_error"`
+	Data        json.RawMessage `json:"data"`
+	Errors      []hzOracleError `json:"errors"`
+	Fatal       string          `json:"fatal"`
+}
+
+type hzOracle struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	hello, err := o.out.ReadString('\n')
+	if err != nil {
+		t.Fatalf("python graphql-core oracle did not start: %v", err)
+	}
+	var h struct {
+		Version string `json:"version"`
+		Python  string `json:"python"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(hello)), &h); err != nil {
+		t.Fatalf("bad oracle greeting %q: %v", hello, err)
+	}
+	t.Logf("oracle: python %s graphql-core %s", h.Python, h.Version)
+	if !strings.HasPrefix(h.Version, "3.") {
+		t.Fatalf("python graphql-core %s is not the 3.x the oracle expects", h.Version)
+	}
+	// Smoke test.
+	r, err := o.execute("type Query { a: Int, echoA(x: Int = 4): String }", map[string]any{"a": 3}, "{ a echoA }", nil, "")
+	if err != nil || r.SchemaError != "" || string(r.Data) != `{"a": 3, "echoA": "{\"x\":4}"}` || len(r.Errors) != 0 {
+		t.Fatalf("python graphql-core oracle not working: %+v %v", r, err)
+	}
+	return o
+}
+
+// execute runs the operation against the schema (SDL) with the root data and variables.
+func (o *hzOracle) execute(sdl string, data any, query string, variables map[string]any, operation string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "execute", "sdl": sdl, "data": data, "query": query, "variables": variables, "operation": hzNilIfEmpty(operation)})
+}
+
+// validate parses and validates the document against the schema (SDL).
+func (o *hzOracle) validate(sdl string, query string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "validate", "sdl": sdl, "query": query})
+}
+
+func hzNilIfEmpty(s string) any {
+	if s == "" {
+		return nil
+	}
+	return s
+}
+
+func (o *hzOracle) ask(m map[string]any) (*hzOracleReply, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	req, err := hzJSONMarshal(m)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading oracle reply: %v", err)
+	}
+	var r hzOracleReply
+	if err := json.Unmarshal([]byte(strings.TrimSpace(line)), &r); err != nil {
+		return nil, fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if r.Fatal != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Fatal)
+	}
+	return &r, nil
+}
+
+// hzJSONMarshal is json.Marshal without HTML escaping and without a trailing newline.
+func hzJSONMarshal(v any) ([]byte, error) {
+	var b bytes.Buffer
+	enc := json.NewEncoder(&b)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	return bytes.TrimRight(b.Bytes(), "\n"), nil
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..7bd4bfb
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,255 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the behaviour the GraphQL
+// specification (and graphql-js/graphql-core) gives. They fail while the bug exists and are
+// listed as expected failures in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"github.com/graphql-go/graphql/language/parser"
+	"github.com/graphql-go/graphql/language/source"
+)
+
+// hzPinSchema: Query { echo(n: Int = 5, id: [Int!]! = [1], z: Int, b: Boolean, s: String): String
+// (echo resolves to the canonical JSON of its arguments), a: Int, i: Int, f: Float, str: String,
+// bool: Boolean, d: ID, e: E, n: Int!, l: [Int], name: [O3]!, one: O3 } with O3 { v: Int }.
+func hzPinSchema(t *testing.T) graphql.Schema {
+	t.Helper()
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	o3 := graphql.NewObject(graphql.ObjectConfig{Name: "O3", Fields: graphql.Fields{"v": &graphql.Field{Type: graphql.Int}}})
+	echo := &graphql.Field{Type: graphql.String, Args: graphql.FieldConfigArgument{
+		"n":  &graphql.ArgumentConfig{Type: graphql.Int, DefaultValue: 5},
+		"id": &graphql.ArgumentConfig{Type: graphql.NewNonNull(graphql.NewList(graphql.NewNonNull(graphql.Int))), DefaultValue: []any{1}},
+		"z":  &graphql.ArgumentConfig{Type: graphql.Int},
+		"b":  &graphql.ArgumentConfig{Type: graphql.Boolean},
+		"s":  &graphql.ArgumentConfig{Type: graphql.String},
+	}, Resolve: func(p graphql.ResolveParams) (any, error) { return hzCanonical(p.Args), nil }}
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"echo": echo,
+		"a":    &graphql.Field{Type: graphql.Int},
+		"i":    &graphql.Field{Type: graphql.Int},
+		"f":    &graphql.Field{Type: graphql.Float},
+		"str":  &graphql.Field{Type: graphql.String},
+		"bool": &graphql.Field{Type: graphql.Boolean},
+		"d":    &graphql.Field{Type: graphql.ID},
+		"e":    &graphql.Field{Type: e},
+		"n":    &graphql.Field{Type: graphql.NewNonNull(graphql.Int)},
+		"l":    &graphql.Field{Type: graphql.NewList(graphql.Int)},
+		"name": &graphql.Field{Type: graphql.NewNonNull(graphql.NewList(o3))},
+		"one":  &graphql.Field{Type: o3},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return schema
+}
+
+func hzPinDo(t *testing.T, query string, vars map[string]any, data map[string]any) (*graphql.Result, string) {
+	t.Helper()
+	r := graphql.Do(graphql.Params{Schema: hzPinSchema(t), RequestString: query, VariableValues: vars, RootObject: data})
+	b, _ := hzJSONMarshal(r)
+	return r, string(b)
+}
+
+func hzPinEcho(r *graphql.Result) string {
+	m, _ := r.Data.(map[string]any)
+	s, _ := m["echo"].(string)
+	return s
+}
+
+// graphql-go/1: the null literal is a syntax error.
+func TestHegelPinNullLiteral(t *testing.T) {
+	src := source.NewSource(&source.Source{Body: []byte(`{ echo(z: null) }`)})
+	if _, err := parser.Parse(parser.ParseParams{Source: src}); err != nil {
+		t.Errorf("parsing `{ echo(z: null) }`: %v", err)
+	}
+}
+
+// graphql-go/2: a non-null argument with a default value must still be provided.
+func TestHegelPinNonNullArgDefault(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ echo }` with echo(id: [Int!]! = [1]) gives %s", js)
+	}
+}
+
+// graphql-go/3: a non-null variable with a default value is rejected.
+func TestHegelPinNonNullVariableDefault(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean! = true) { echo(id: 3) @skip(if: $v) }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("query($v: Boolean! = true) gives %s", js)
+	}
+}
+
+// graphql-go/4: a variable given the value null takes its default value, or the argument's.
+func TestHegelPinNullVariableValue(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Int = 7) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":7`) {
+		t.Errorf("$v: Int = 7 given null gives n = 7: %s", js)
+	}
+	r, js = hzPinDo(t, `query($v: Int) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":5`) {
+		t.Errorf("$v: Int given null for echo(n: Int = 5) gives n = 5: %s", js)
+	}
+}
+
+// graphql-go/5: variable values of the wrong kind are coerced instead of rejected.
+func TestHegelPinLaxVariableCoercion(t *testing.T) {
+	for _, c := range []struct {
+		query string
+		vars  map[string]any
+	}{
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": "4"}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": 1.5}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": true}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": "x"}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": []any{}}},
+		{`query($v: String) { echo(id: 3, s: $v) }`, map[string]any{"v": 1}},
+	} {
+		r, js := hzPinDo(t, c.query, c.vars, nil)
+		if len(r.Errors) == 0 {
+			t.Errorf("%s with %s is accepted: %s", c.query, hzCanonical(c.vars), js)
+		}
+	}
+}
+
+// graphql-go/6: an Int literal outside 32 bits is accepted.
+func TestHegelPinIntLiteralRange(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo(id: 3, z: 3000000000) }`, nil, nil)
+	if len(r.Errors) == 0 {
+		t.Errorf("z: 3000000000 for an Int argument is accepted: %s", js)
+	}
+}
+
+// graphql-go/7: a field selected twice is dropped when the first selection is excluded by a
+// variable-driven @skip.
+func TestHegelPinMergedSkipVariable(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean!) { a @skip(if: $v) a }`, map[string]any{"v": true}, map[string]any{"a": 1})
+	m, _ := r.Data.(map[string]any)
+	if m == nil || m["a"] != 1 {
+		t.Errorf("`a @skip(if: $v) a` with v = true gives %s, without a", js)
+	}
+}
+
+// graphql-go/8: an inline fragment without a type condition under a list-typed field is
+// rejected.
+func TestHegelPinInlineFragmentNoCondition(t *testing.T) {
+	r, js := hzPinDo(t, `{ name { ... { v } } }`, nil, map[string]any{"name": []any{map[string]any{"v": 2}}})
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ name { ... { v } } }` with name: [O3]! gives %s", js)
+	}
+}
+
+// graphql-go/9: Enum.Serialize of a slice value panics.
+func TestHegelPinEnumSerializeSlice(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	if r := hzCatch(func() { e.Serialize([]any{"RED"}) }); r != nil {
+		t.Errorf("Enum.Serialize([]any{\"RED\"}) panics: %v", r)
+	}
+}
+
+// graphql-go/10: a leaf value that cannot be serialized becomes null without a field error.
+func TestHegelPinLeafSerializeError(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": "abc"})
+	if len(r.Errors) == 0 {
+		t.Errorf("Int field resolving to \"abc\" gives %s, without an error", js)
+	}
+}
+
+// graphql-go/11: Int serialization truncates a fractional float.
+func TestHegelPinIntTruncation(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": 1.5})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["i"] == 1 {
+		t.Errorf("Int field resolving to 1.5 gives %s", js)
+	}
+}
+
+// graphql-go/12: Boolean serialization turns any string but "" and "false" into true.
+func TestHegelPinBooleanString(t *testing.T) {
+	r, js := hzPinDo(t, `{ bool }`, nil, map[string]any{"bool": "x"})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["bool"] == true {
+		t.Errorf("Boolean field resolving to \"x\" gives %s", js)
+	}
+}
+
+// graphql-go/13: String serialization prints a slice with fmt.
+func TestHegelPinStringOfSlice(t *testing.T) {
+	r, js := hzPinDo(t, `{ str }`, nil, map[string]any{"str": []any{"a"}})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["str"] == "[a]" {
+		t.Errorf("String field resolving to []any{\"a\"} gives %s", js)
+	}
+}
+
+// graphql-go/14: when a non-null root field is null, the errors of the other root fields are
+// dropped.
+func TestHegelPinRootPropagationErrors(t *testing.T) {
+	r, js := hzPinDo(t, `{ l n }`, nil, map[string]any{"l": 5})
+	if len(r.Errors) != 2 {
+		t.Errorf("`{ l n }` with l = 5 (not a list) and n missing gives %s: the error of l is missing", js)
+	}
+}
+
+// graphql-go/15: introspection prints the default value of an enum, list or input object
+// argument as a quoted fmt string.
+func TestHegelPinIntrospectionDefaultValue(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"f": &graphql.Field{Type: graphql.Int, Args: graphql.FieldConfigArgument{
+			"e": &graphql.ArgumentConfig{Type: e, DefaultValue: "RED"},
+			"l": &graphql.ArgumentConfig{Type: graphql.NewList(graphql.Int), DefaultValue: []any{1, 2}},
+		}},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := graphql.Do(graphql.Params{Schema: schema, RequestString: `{ __type(name: "Query") { fields { args { name defaultValue } } } }`})
+	b, _ := hzJSONMarshal(r.Data)
+	js := string(b)
+	if !strings.Contains(js, `"defaultValue":"RED"`) || !strings.Contains(js, `"defaultValue":"[1, 2]"`) {
+		t.Errorf("introspection of e: E = RED and l: [Int] = [1, 2] gives %s", js)
+	}
+}
+
+// graphql-go/16: introspection gives an empty string, not null, for a missing description.
+func TestHegelPinIntrospectionEmptyDescription(t *testing.T) {
+	r, js := hzPinDo(t, `{ __type(name: "O3") { description fields { description } } }`, nil, nil)
+	m, _ := r.Data.(map[string]any)
+	tm, _ := m["__type"].(map[string]any)
+	if tm == nil || tm["description"] != nil {
+		t.Errorf("introspection of a type without a description gives %s", js)
+	}
+}
+
+// graphql-go/17: the same directive twice on one selection passes validation.
+func TestHegelPinDuplicateDirectives(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, `{ a @skip(if: true) @skip(if: false) }`); ok {
+		t.Errorf("`{ a @skip(if: true) @skip(if: false) }` passes validation")
+	}
+}
+
+// graphql-go/18: a type definition in an executable document passes validation.
+func TestHegelPinSDLInExecutable(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, "{ a }\ntype Extra { a: Int }"); ok {
+		t.Errorf("a document with a type definition passes validation (and then cannot be executed)")
+	}
+}
+
+// graphql-go/19: a field conflict reached through a fragment spread inside a fragment
+// passes validation.
+func TestHegelPinTransitiveFragmentFieldConflict(t *testing.T) {
+	schema := hzPinSchema(t)
+	doc := "{ y: a ...F2 } fragment F2 on Query { ...F7 } fragment F7 on Query { y: __typename }"
+	if ok, _ := hzGoValidate(&schema, doc); ok {
+		t.Errorf("%s passes validation (y: a and y: __typename conflict through F2 -> F7)", doc)
+	}
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..4a8d387
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,243 @@
+package hegel
+
+// The properties: the execution of generated operations against generated schemas and root
+// data must agree with graphql-core's.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// hzNormalize makes the JSON of a result comparable: json.Number integers stay, floats that
+// are whole numbers become integers, other floats their shortest form.
+func hzNormalize(v any) any {
+	switch v := v.(type) {
+	case json.Number:
+		s := string(v)
+		if !strings.ContainsAny(s, ".eE") {
+			return s
+		}
+		f, err := strconv.ParseFloat(s, 64)
+		if err != nil {
+			return s
+		}
+		if f == math.Trunc(f) && math.Abs(f) < 1e15 {
+			return strconv.FormatInt(int64(f), 10)
+		}
+		return strconv.FormatFloat(f, 'g', -1, 64)
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = hzNormalize(x)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = hzNormalize(x)
+		}
+		return out
+	}
+	return v
+}
+
+func hzNormalizeJSON(b []byte) any {
+	if len(b) == 0 {
+		return nil
+	}
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return "unparseable: " + string(b)
+	}
+	return hzNormalize(v)
+}
+
+func hzPathString(path []any) string {
+	parts := make([]string, len(path))
+	for i, p := range path {
+		parts[i] = fmt.Sprint(hzNormalize(p))
+	}
+	return strings.Join(parts, ".")
+}
+
+var hzQuotedRe = regexp.MustCompile(`"[^"]*"`)
+
+// hzSubset: is the sorted multiset a contained in the sorted multiset b?
+func hzSubset(a, b []string) bool {
+	j := 0
+	for _, x := range a {
+		for j < len(b) && b[j] < x {
+			j++
+		}
+		if j >= len(b) || b[j] != x {
+			return false
+		}
+		j++
+	}
+	return true
+}
+
+func hzAllEmpty(xs []string) bool {
+	for _, x := range xs {
+		if x != "" {
+			return false
+		}
+	}
+	return true
+}
+
+// hzResult is one implementation's outcome, in comparable form.
+type hzResult struct {
+	data     any      // normalised; nil when absent
+	hasData  bool     // the data key is not null
+	paths    []string // error paths, sorted ("" for a request error)
+	messages []string
+}
+
+func hzGoResult(r *graphql.Result) *hzResult {
+	out := &hzResult{}
+	if r.Data != nil {
+		b, _ := hzJSONMarshal(r.Data)
+		out.data = hzNormalizeJSON(b)
+		out.hasData = true
+	}
+	for _, e := range r.Errors {
+		out.paths = append(out.paths, hzPathString(e.Path))
+		out.messages = append(out.messages, e.Message)
+	}
+	sort.Strings(out.paths)
+	return out
+}
+
+func hzPyResult(r *hzOracleReply) *hzResult {
+	out := &hzResult{}
+	if len(r.Data) > 0 && string(r.Data) != "null" {
+		out.data = hzNormalizeJSON(r.Data)
+		out.hasData = true
+	}
+	for _, e := range r.Errors {
+		out.paths = append(out.paths, hzPathString(e.Path))
+		out.messages = append(out.messages, e.Message)
+	}
+	sort.Strings(out.paths)
+	return out
+}
+
+func (r *hzResult) String() string {
+	b, _ := hzJSONMarshal(r.data)
+	return fmt.Sprintf("data=%s errors=%q messages=%q", b, r.paths, r.messages)
+}
+
+// TestHegelExecute: graphql.Do on a generated schema, root data and operation must give the
+// same data and the same error paths as graphql-core.
+func TestHegelExecute(t *testing.T) {
+	o := hzStartOracle(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, schemas)
+		sdl := hzSDL(s)
+		schema, err := hzBuild(s)
+		if err != nil {
+			ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+		}
+		data := hzGenData(ht, s, "Query", 4)
+		q := hzGenQuery(ht, s)
+		for f := range q.features {
+			c.count("feature " + f)
+		}
+		py, err := o.execute(sdl, data, q.text, q.variables, q.operation)
+		if err != nil {
+			ht.Fatalf("oracle: %v", err)
+		}
+		if py.SchemaError != "" {
+			ht.Fatalf("graphql-core rejects the SDL: %s\n%s", py.SchemaError, sdl)
+		}
+		var goRes *graphql.Result
+		if r := hzCatch(func() {
+			goRes = graphql.Do(graphql.Params{
+				Schema:         schema,
+				RequestString:  q.text,
+				VariableValues: q.variables,
+				OperationName:  q.operation,
+				RootObject:     data,
+			})
+		}); r != nil {
+			c.failClass(ht, "panic", "graphql.Do panics: %v\nquery:\n%s\nvariables: %s\nSDL:\n%s", r, q.text, hzCanonical(q.variables), sdl)
+			return
+		}
+		g, p := hzGoResult(goRes), hzPyResult(py)
+		dataJSON, _ := hzJSONMarshal(data)
+		context := func() string {
+			return fmt.Sprintf("query:\n%s\nvariables: %s\noperation: %q\ndata: %s\nSDL:\n%s\ngraphql-go: %v\ngraphql-core: %v",
+				q.text, hzCanonical(q.variables), q.operation, dataJSON, sdl, g, p)
+		}
+		for _, m := range g.messages {
+			if strings.Contains(m, "runtime error") {
+				// A recovered panic reported as a GraphQL error.
+				c.failClass(ht, "runtime error", "graphql-go reports a runtime error\n%s", context())
+				return
+			}
+		}
+		if !g.hasData && !p.hasData {
+			if len(goRes.Errors) > 0 {
+				m := goRes.Errors[0].Message
+				if i := strings.Index(m, "\n"); i > 0 {
+					m = m[:i]
+				}
+				c.count("reject: " + hzQuotedRe.ReplaceAllString(m, `"_"`))
+			}
+			if len(py.Errors) > 0 {
+				m := py.Errors[0].Message
+				if i := strings.Index(m, "\n"); i > 0 {
+					m = m[:i]
+				}
+				c.count("reject-core: " + hzQuotedRe.ReplaceAllString(m, `"_"`))
+			}
+			if hzAllEmpty(g.paths) && hzAllEmpty(p.paths) {
+				c.count("both reject")
+				return
+			}
+			// Execution errors that made the data null: the paths must agree (while
+			// rootPropagationDropsErrors is on, graphql-go's must be among graphql-core's).
+			if !reflect.DeepEqual(g.paths, p.paths) {
+				if HZKnown.rootPropagationDropsErrors && hzSubset(g.paths, p.paths) {
+					hzAvoid("rootPropagationDropsErrors")
+					return
+				}
+				c.failClass(ht, "error paths", "error paths differ (data null)\n%s", context())
+				return
+			}
+			c.count("both reject, paths agree")
+			return
+		}
+		if g.hasData != p.hasData {
+			c.failClass(ht, "reject", "one side rejects the request\n%s", context())
+			return
+		}
+		if !reflect.DeepEqual(g.data, p.data) {
+			c.failClass(ht, "data", "data differs\n%s", context())
+			return
+		}
+		if !reflect.DeepEqual(g.paths, p.paths) {
+			c.failClass(ht, "error paths", "error paths differ\n%s", context())
+			return
+		}
+		if len(g.paths) > 0 {
+			c.count("errors agree")
+		} else {
+			c.count("ok")
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_schema_test.go b/hegel/hegel_zoo_schema_test.go
new file mode 100644
index 0000000..ddd6b2e
--- /dev/null
+++ b/hegel/hegel_zoo_schema_test.go
@@ -0,0 +1,471 @@
+package hegel
+
+// The type-system generator: a package-level generator of hzSchema records built from the
+// combinators (STYLE.md rule 1), with the shape and ranges of the old hzGenSchema: 1-2 enums
+// of 2-4 values, 0-2 input objects of 1-3 fields referring to leaf types and earlier inputs
+// (a nullable self-reference at 15 %, with no default), Query and 2-3 objects of 1-4 fields
+// plus the fields of the interfaces they implement, 0-2 interfaces of 1-2 fields each with
+// an implementation, an optional union of the objects, echo fields with 1-3 arguments at
+// 25 %, arguments at 40 % with defaults at 40 % (35 % on input fields), deprecations at
+// 15 %, descriptions at 25 %. The parts that depend on earlier parts are a chain of
+// hegel.FlatMap (the inputs' fields refer to earlier inputs, the objects' fields to the
+// named output types, the defaults are strict values of the drawn types); every draw builds
+// fresh records (no shared state); the simplest alternative comes first in every choice (no
+// description, no default, no arguments, no deprecation, the plain named type before the
+// wrapped ones) so that shrinking lands on it. The shapes of the recorded introspection bugs
+// are weights of the choices (schemaShapes), zero under HEGEL_NO_KNOWN=1. The narrow
+// introspection properties draw from schemasWith with their own weights.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// schemaShapes: the weights of the recorded bugs' shapes in a type system.
+type schemaShapes struct {
+	// blank is the weight of a missing description against 25 for one present (75 by
+	// default: descriptions at 25 %; 0 under HEGEL_NO_KNOWN=1: every description present,
+	// the enum values' too), the shape of graphql-go/16.
+	blank int
+	// typed says whether an argument or input field of an enum, list or input-object type
+	// gets a default value at the natural rate (false under HEGEL_NO_KNOWN=1: defaults on
+	// scalar types only), the shape of graphql-go/15.
+	typed bool
+}
+
+// schemas: the type systems of the wide properties.
+var schemas = schemasWith(schemaShapes{blank: hzUnless(hzNoKnown, 75), typed: !hzNoKnown})
+
+// schemasWith: a type system with the given shape weights.
+func schemasWith(sh schemaShapes) hegel.Generator[*hzSchema] {
+	return hegel.FlatMap(enumDefs(sh), func(enums []*hzEnumDef) hegel.Generator[*hzSchema] {
+		base := hzSchema{enums: enums}
+		return hegel.FlatMap(inputDefs(sh, base), func(inputs []*hzInputDef) hegel.Generator[*hzSchema] {
+			s := base
+			s.inputs = inputs
+			return outputDefs(sh, s)
+		})
+	})
+}
+
+// --------------------------------------------------------------------------- names
+
+// hzUniqueNames: the drawn names made distinct in their order, a 2 appended while a name is
+// taken (the old hzUniqueName as a pure function over a drawn list); taken are the names in
+// use already (the fields inherited from an interface).
+func hzUniqueNames(names []string, taken []string) []string {
+	used := map[string]bool{}
+	for _, t := range taken {
+		used[t] = true
+	}
+	out := make([]string, len(names))
+	for i, n := range names {
+		for used[n] {
+			n += "2"
+		}
+		used[n] = true
+		out[i] = n
+	}
+	return out
+}
+
+// numbered: prefix1, prefix2, ... prefixN.
+func numbered(prefix string, n int) []string {
+	out := make([]string, n)
+	for i := range out {
+		out[i] = fmt.Sprintf("%s%d", prefix, i+1)
+	}
+	return out
+}
+
+// leafNames: the scalars and the enums of the schema (the leaf input types).
+func leafNames(s *hzSchema) []string {
+	out := append([]string{}, hzScalars...)
+	for _, e := range s.enums {
+		out = append(out, e.name)
+	}
+	return out
+}
+
+// inputNames: the input types of the schema (the leaf types and the input objects).
+func inputNames(s *hzSchema) []string {
+	out := leafNames(s)
+	for _, in := range s.inputs {
+		out = append(out, in.name)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the parts
+
+// descriptions: none first (at the shape's weight), or one of the table.
+func descriptions(sh schemaShapes) hegel.Generator[string] {
+	return hzWeighted(hzW(sh.blank, hegel.Just("")), hzW(25, hzSampled(hzDescs...)))
+}
+
+// deprecations: no deprecation reason first, one at 15 %.
+var deprecations = hzMaybe(15, hzSampled("No longer supported", "use b", "gone \"soon\""))
+
+// hzWrap wraps a named type reference in list and non-null wrappers.
+type hzWrap func(*hzRef) *hzRef
+
+func hzPlain(r *hzRef) *hzRef { return r }
+
+// The wrappers of a named type, the plain name first; the weights (thousandths) are the
+// products of the old draw: non-null 40 %, a list 30 %, the list non-null 30 %, a second
+// list 15 %.
+var (
+	plainWraps = []hzChoice[hzWrap]{
+		hzW(420, hegel.Just(hzWrap(hzPlain))),
+		hzW(280, hegel.Just(hzWrap(hzNonNullOf))),
+	}
+	listWraps = []hzChoice[hzWrap]{
+		hzW(107, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(r) }))),
+		hzW(71, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(hzNonNullOf(r)) }))),
+		hzW(46, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzNonNullOf(hzListOf(r)) }))),
+		hzW(31, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzNonNullOf(hzListOf(hzNonNullOf(r))) }))),
+		hzW(19, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(hzListOf(r)) }))),
+		hzW(13, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(hzListOf(hzNonNullOf(r))) }))),
+		hzW(8, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(hzNonNullOf(hzListOf(r))) }))),
+		hzW(5, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(hzNonNullOf(hzListOf(hzNonNullOf(r)))) }))),
+	}
+	wrappers      = hzWeighted(append(append([]hzChoice[hzWrap]{}, plainWraps...), listWraps...)...)
+	plainWrappers = hzWeighted(plainWraps...)
+	listWrappers  = hzWeighted(listWraps...)
+)
+
+// refs: a reference to one of the named types with the wrappers.
+func refs(names []string, ws hegel.Generator[hzWrap]) hegel.Generator[*hzRef] {
+	return hegel.FlatMap(hzSampled(names...), func(n string) hegel.Generator[*hzRef] {
+		return hegel.Map(ws, func(w hzWrap) *hzRef { return w(hzNamed(n)) })
+	})
+}
+
+// typedRef: is the type an enum, an input object or a list, whatever the wrappers (the
+// default values graphql-go's introspection prints as fmt strings, graphql-go/15)?
+func typedRef(s *hzSchema, r *hzRef) bool {
+	return r.nullable().isList() || s.enum(r.named()) != nil || s.input(r.named()) != nil
+}
+
+// defaults: no default first, or at pct percent a strict value of the type; on an enum, list
+// or input-object type only while the shape is drawn (sh.typed).
+func defaults(sh schemaShapes, s *hzSchema, r *hzRef, pct int) hegel.Generator[any] {
+	if typedRef(s, r) && !sh.typed {
+		return hegel.Just[any](hzNoDefault)
+	}
+	return hzWeighted(hzW(100-pct, hegel.Just[any](hzNoDefault)), hzW(pct, strictValues(s, r)))
+}
+
+// --------------------------------------------------------------------------- strict values
+
+func sampledAny(xs ...any) hegel.Generator[any] { return hzSampled(xs...) }
+
+// strictValues: a valid input value of the type in the schema (null at 15 % in a nullable
+// position, a list of 0-3 items or at 25 % a single item that coerces to a list of one, the
+// scalar tables of the old hzGenValue, an enum value, an input object with its required
+// fields and the others at 60 %): the old hzGenValue with strict: true, for the default
+// values; a self-referencing input field stops three levels down.
+func strictValues(s *hzSchema, r *hzRef) hegel.Generator[any] { return strictValuesAt(s, r, 3) }
+
+func strictValuesAt(s *hzSchema, r *hzRef, depth int) hegel.Generator[any] {
+	if r.isNonNull() {
+		return strictNonNull(s, r.of, depth)
+	}
+	return hzWeighted(hzW(15, hegel.Just[any](nil)), hzW(85, strictNonNull(s, r, depth)))
+}
+
+// strictNonNull: a strict value other than null of the (nullable) type.
+func strictNonNull(s *hzSchema, r *hzRef, depth int) hegel.Generator[any] {
+	if r.isList() {
+		items := hegel.Map(hzCounted(strictValuesAt(s, r.of, depth), 0, 3), func(xs []any) any {
+			if xs == nil {
+				return []any{}
+			}
+			return xs
+		})
+		if r.of.nullable().isList() {
+			return items
+		}
+		return hzWeighted(hzW(75, items), hzW(25, strictNonNull(s, r.of.nullable(), depth)))
+	}
+	switch r.name {
+	case "Int":
+		return sampledAny(0, 1, -1, 7, 42, -100, 2147483647, -2147483648)
+	case "Float":
+		return hzWeighted(hzW(40, sampledAny(0, 3, -2, 1000)), hzW(60, sampledAny(0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75)))
+	case "String":
+		return hegel.Map(hzSampled(hzStrings...), func(v string) any { return v })
+	case "Boolean":
+		return sampledAny(false, true)
+	case "ID":
+		return hzWeighted(hzW(30, sampledAny(1, 42, 0)), hzW(70, sampledAny("id1", "x", "", "42")))
+	}
+	if e := s.enum(r.name); e != nil {
+		return hegel.Map(hzSampled(e.values...), func(v string) any { return hzEnumVal(v) })
+	}
+	in := s.input(r.name)
+	if in == nil {
+		panic("strictValues: unknown input type " + r.name)
+	}
+	// The fields' presence and values depend on each field's type: a record.
+	return hegel.Composite(func(tc hegel.TestCase) any {
+		m := map[string]any{}
+		for _, f := range in.fields {
+			required := f.typ.isNonNull() && f.def == hzNoDefault
+			if !required && depth <= 0 && s.input(f.typ.named()) != nil {
+				continue
+			}
+			if required || hegel.Draw(tc, hzCoin(60)) {
+				m[f.name] = hegel.Draw(tc, strictValuesAt(s, f.typ, depth-1))
+			}
+		}
+		return m
+	})
+}
+
+// --------------------------------------------------------------------------- enums
+
+// enumDefs: 1-2 enums E1, E2 of 2-4 distinct values, each value with a description like
+// the enum's own.
+func enumDefs(sh schemaShapes) hegel.Generator[[]*hzEnumDef] {
+	one := hegel.Composite(func(tc hegel.TestCase) *hzEnumDef {
+		e := &hzEnumDef{desc: hegel.Draw(tc, descriptions(sh))}
+		e.values = hzUniqueNames(hegel.Draw(tc, hzCounted(hzSampled(hzEnumNames...), 2, 4)), nil)
+		e.valueDescs = hegel.Draw(tc, hzCounted(descriptions(sh), len(e.values), len(e.values)))
+		return e
+	})
+	return hegel.Map(hzCounted(one, 1, 2), func(es []*hzEnumDef) []*hzEnumDef {
+		for i, e := range es {
+			e.name = fmt.Sprintf("E%d", i+1)
+		}
+		return es
+	})
+}
+
+// --------------------------------------------------------------------------- input objects
+
+// inputDefs: 0-2 input objects In1, In2, each drawn after the ones before it (its fields
+// refer to the leaf types and the earlier inputs; a default is a strict value of the drawn
+// type, which may be an earlier input).
+func inputDefs(sh schemaShapes, base hzSchema) hegel.Generator[[]*hzInputDef] {
+	return hegel.FlatMap(hzInts(0, 2), func(k int) hegel.Generator[[]*hzInputDef] {
+		return inputsFrom(sh, base, nil, k)
+	})
+}
+
+func inputsFrom(sh schemaShapes, base hzSchema, sofar []*hzInputDef, k int) hegel.Generator[[]*hzInputDef] {
+	if len(sofar) == k {
+		return hegel.Just(sofar)
+	}
+	s := base
+	s.inputs = sofar
+	return hegel.FlatMap(inputDef(sh, &s, fmt.Sprintf("In%d", len(sofar)+1)), func(in *hzInputDef) hegel.Generator[[]*hzInputDef] {
+		return inputsFrom(sh, base, append(sofar[:len(sofar):len(sofar)], in), k)
+	})
+}
+
+// inputDef: an input object of 1-3 distinct fields: a field of a leaf type or an earlier
+// input with the wrappers and a default at 35 %, or at 15 % a nullable self-reference, plain
+// or in a list, with no default (graphql-core cannot build a self-referencing default).
+func inputDef(sh schemaShapes, s *hzSchema, name string) hegel.Generator[*hzInputDef] {
+	pool := inputNames(s)
+	regular := hegel.Composite(func(tc hegel.TestCase) *hzInputField {
+		f := &hzInputField{desc: hegel.Draw(tc, descriptions(sh)), name: hegel.Draw(tc, hzSampled(hzArgNames...))}
+		f.typ = hegel.Draw(tc, refs(pool, wrappers))
+		f.def = hegel.Draw(tc, defaults(sh, s, f.typ, 35))
+		return f
+	})
+	self := hegel.Composite(func(tc hegel.TestCase) *hzInputField {
+		f := &hzInputField{desc: hegel.Draw(tc, descriptions(sh)), name: hegel.Draw(tc, hzSampled(hzArgNames...)), def: hzNoDefault}
+		f.typ = hegel.Draw(tc, hzWeighted(hzW(50, hegel.Just(hzNamed(name))), hzW(50, hegel.Just(hzListOf(hzNamed(name))))))
+		return f
+	})
+	field := hzWeighted(hzW(85, regular), hzW(15, self))
+	return hegel.Composite(func(tc hegel.TestCase) *hzInputDef {
+		in := &hzInputDef{name: name, desc: hegel.Draw(tc, descriptions(sh))}
+		in.fields = hegel.Draw(tc, hzCounted(field, 1, 3))
+		names := make([]string, len(in.fields))
+		for i, f := range in.fields {
+			names[i] = f.name
+		}
+		for i, n := range hzUniqueNames(names, nil) {
+			in.fields[i].name = n
+		}
+		return in
+	})
+}
+
+// --------------------------------------------------------------------------- output types
+
+// outputDefs: Query and 2-3 objects, 0-2 interfaces, an optional union, drawn after the
+// inputs (the fields refer to the named output types, the arguments to the input types).
+func outputDefs(sh schemaShapes, s hzSchema) hegel.Generator[*hzSchema] {
+	ins := inputNames(&s)
+	return hegel.FlatMap(hzTuple(hzInts(2, 3), hzInts(0, 2)), func(n []int) hegel.Generator[*hzSchema] {
+		objNames := append([]string{"Query"}, numbered("O", n[0])...)
+		ifaceNames := numbered("I", n[1])
+		return hegel.FlatMap(unions(sh, objNames[1:]), func(u *hzUnionDef) hegel.Generator[*hzSchema] {
+			outs := append(leafNames(&s), objNames[1:]...)
+			outs = append(outs, ifaceNames...)
+			if u != nil {
+				outs = append(outs, u.name)
+			}
+			return hegel.FlatMap(ifaceDefs(sh, &s, ifaceNames, outs, ins), func(ifaces []*hzIfaceDef) hegel.Generator[*hzSchema] {
+				return hegel.Map(objectDefs(sh, &s, objNames, ifaces, outs, ins), func(objs []*hzObjectDef) *hzSchema {
+					out := s
+					out.ifaces = ifaces
+					out.objects = objs
+					if u != nil {
+						out.unions = []*hzUnionDef{u}
+					}
+					implementAll(&out)
+					return &out
+				})
+			})
+		})
+	})
+}
+
+// unions: no union first, or U1 of the objects at 60 % each (the first object when none).
+func unions(sh schemaShapes, objNames []string) hegel.Generator[*hzUnionDef] {
+	some := hegel.Composite(func(tc hegel.TestCase) *hzUnionDef {
+		u := &hzUnionDef{name: "U1", desc: hegel.Draw(tc, descriptions(sh))}
+		for _, name := range objNames {
+			if hegel.Draw(tc, hzCoin(60)) {
+				u.members = append(u.members, name)
+			}
+		}
+		if len(u.members) == 0 {
+			u.members = []string{objNames[0]}
+		}
+		return u
+	})
+	return hzWeighted(hzW(50, hegel.Just[*hzUnionDef](nil)), hzW(50, some))
+}
+
+// argDefs: an argument of an input type with the wrappers and a default at 40 %.
+func argDefs(sh schemaShapes, s *hzSchema, ins []string) hegel.Generator[*hzArg] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzArg {
+		a := &hzArg{desc: hegel.Draw(tc, descriptions(sh)), name: hegel.Draw(tc, hzSampled(hzArgNames...))}
+		a.typ = hegel.Draw(tc, refs(ins, wrappers))
+		a.def = hegel.Draw(tc, defaults(sh, s, a.typ, 40))
+		return a
+	})
+}
+
+// fieldDefs: a field of an object or interface (prefix "" for an object, the lowercased
+// interface name otherwise): a field of an output type with 1-2 arguments at 40 %, or at
+// 25 % an echo field (a String resolved to the canonical JSON of its 1-3 arguments); a
+// deprecation at 15 %. The argument names are made distinct.
+func fieldDefs(sh schemaShapes, s *hzSchema, prefix string, outs, ins []string) hegel.Generator[*hzFieldDef] {
+	pool := hzFieldNames
+	if prefix != "" {
+		pool = []string{prefix + "a", prefix + "b", prefix + "c"}
+	}
+	echoPool := []string{"echo" + prefix, "echo" + prefix + "A", "echo" + prefix + "B"}
+	distinctArgs := func(f *hzFieldDef) *hzFieldDef {
+		names := make([]string, len(f.args))
+		for i, a := range f.args {
+			names[i] = a.name
+		}
+		for i, n := range hzUniqueNames(names, nil) {
+			f.args[i].name = n
+		}
+		return f
+	}
+	regular := hegel.Composite(func(tc hegel.TestCase) *hzFieldDef {
+		f := &hzFieldDef{desc: hegel.Draw(tc, descriptions(sh)), name: hegel.Draw(tc, hzSampled(pool...))}
+		f.typ = hegel.Draw(tc, refs(outs, wrappers))
+		f.args = hegel.Draw(tc, hzWeighted(hzW(60, hegel.Just[[]*hzArg](nil)), hzW(40, hzCounted(argDefs(sh, s, ins), 1, 2))))
+		f.deprecated = hegel.Draw(tc, deprecations)
+		return distinctArgs(f)
+	})
+	echo := hegel.Composite(func(tc hegel.TestCase) *hzFieldDef {
+		f := &hzFieldDef{desc: hegel.Draw(tc, descriptions(sh)), name: hegel.Draw(tc, hzSampled(echoPool...)), typ: hzNamed("String"), echo: true}
+		f.args = hegel.Draw(tc, hzCounted(argDefs(sh, s, ins), 1, 3))
+		f.deprecated = hegel.Draw(tc, deprecations)
+		return distinctArgs(f)
+	})
+	return hzWeighted(hzW(75, regular), hzW(25, echo))
+}
+
+// distinctFields names the fields distinctly, after the taken names.
+func distinctFields(fields []*hzFieldDef, taken []string) {
+	names := make([]string, len(fields))
+	for i, f := range fields {
+		names[i] = f.name
+	}
+	for i, n := range hzUniqueNames(names, taken) {
+		fields[i].name = n
+	}
+}
+
+// ifaceDefs: the interfaces, of 1-2 fields each.
+func ifaceDefs(sh schemaShapes, s *hzSchema, names []string, outs, ins []string) hegel.Generator[[]*hzIfaceDef] {
+	gens := make([]hegel.Generator[*hzIfaceDef], len(names))
+	for i, name := range names {
+		name := name
+		gens[i] = hegel.Composite(func(tc hegel.TestCase) *hzIfaceDef {
+			it := &hzIfaceDef{name: name, desc: hegel.Draw(tc, descriptions(sh))}
+			it.fields = hegel.Draw(tc, hzCounted(fieldDefs(sh, s, strings.ToLower(name), outs, ins), 1, 2))
+			distinctFields(it.fields, nil)
+			return it
+		})
+	}
+	return hzTuple(gens...)
+}
+
+// objectDefs: the objects (Query first), each implementing every interface at 50 % (with
+// its fields) and adding 1-4 fields of its own.
+func objectDefs(sh schemaShapes, s *hzSchema, names []string, ifaces []*hzIfaceDef, outs, ins []string) hegel.Generator[[]*hzObjectDef] {
+	gens := make([]hegel.Generator[*hzObjectDef], len(names))
+	for i, name := range names {
+		name := name
+		gens[i] = hegel.Composite(func(tc hegel.TestCase) *hzObjectDef {
+			o := &hzObjectDef{name: name, desc: hegel.Draw(tc, descriptions(sh))}
+			if name != "Query" {
+				for _, it := range ifaces {
+					if hegel.Draw(tc, hzCoin(50)) {
+						implement(o, it)
+					}
+				}
+			}
+			own := hegel.Draw(tc, hzCounted(fieldDefs(sh, s, "", outs, ins), 1, 4))
+			taken := make([]string, len(o.fields))
+			for j, f := range o.fields {
+				taken[j] = f.name
+			}
+			distinctFields(own, taken)
+			o.fields = append(o.fields, own...)
+			return o
+		})
+	}
+	return hzTuple(gens...)
+}
+
+// implement adds the interface and its fields (those not present by name) to the object.
+func implement(o *hzObjectDef, it *hzIfaceDef) {
+	o.ifaces = append(o.ifaces, it.name)
+	for _, f := range it.fields {
+		present := false
+		for _, g := range o.fields {
+			if g.name == f.name {
+				present = true
+			}
+		}
+		if !present {
+			o.fields = append(o.fields, f)
+		}
+	}
+}
+
+// implementAll gives every interface without an implementation one: the first object.
+func implementAll(s *hzSchema) {
+	for _, it := range s.ifaces {
+		if len(s.possibleTypes(it.name)) == 0 {
+			implement(s.objects[1], it)
+		}
+	}
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..443c5b3
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,980 @@
+package hegel
+
+// Hegel property tests for graphql-go/graphql, written for the Hegel zoo. See
+// targets/go/graphql-go/README.md. They live in a package of their own (hegel/) and drive the
+// public API: graphql.NewSchema on a generated type system (objects, interfaces, unions, enums,
+// input objects, lists and non-nulls, arguments with default values) and graphql.Do with
+// generated operations, variables and root data.
+//
+// Oracle: graphql-core (python), the reference implementation's port, given the same schema
+// as SDL, the same root data as JSON and the same operation: the data and the error paths must
+// agree.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		avoided := make([]string, 0, len(hzAvoided))
+		for k := range hzAvoided {
+			avoided = append(avoided, k)
+		}
+		sort.Strings(avoided)
+		for _, k := range avoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, hzAvoided[k]))
+		}
+		hzAvoided = map[string]int{}
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that TestHegelExecute's generated cases reach. While
+// a switch is on the generators keep away from the behaviour (and count the avoidance); the
+// pins assert the documented behaviour and fail while the bug exists. The switches of the
+// introspection and validation bugs (graphql-go/15 to 18) are gone: those properties draw
+// the shapes and name them (hzCaseJudge), off under HEGEL_NO_KNOWN=1 (hzNoKnown); part 2
+// of the rewrite does the same for these fourteen.
+var HZKnown = struct {
+	nullLiteralSyntaxError     bool // the null literal is a syntax error (Unexpected Name "null")
+	nonNullArgDefaultRequired  bool // a non-null argument or input field with a default value must still be provided
+	nonNullVarDefaultRejected  bool // a non-null variable with a default value is rejected (an obsolete rule)
+	nullVariableUsesDefault    bool // a variable given the value null takes its default or the argument's, instead of null
+	laxVariableCoercion        bool // variable values of the wrong kind are coerced instead of rejected (Int from "3", true or 1.5, Boolean from "x" or 1, String/ID from anything)
+	intLiteralRangeUnchecked   bool // an Int literal outside 32 bits is accepted
+	mergedFirstPredicateWins   bool // a selection reached twice is dropped when the first is excluded by a variable-driven @skip/@include (the plan keeps the first predicate only)
+	noConditionFragmentInWrap  bool // an inline fragment without a type condition under a list or non-null field is rejected ("objects of type T can never be of type [T]" or "T!")
+	enumSerializePanics        bool // Enum.Serialize of a slice or map value panics (hash of unhashable type), reported as a runtime error
+	leafSerializeSilentNull    bool // a leaf value that cannot be serialized (Int out of range or non-numeric, unknown enum value, non-numeric Float) becomes null without a field error
+	intSerializeTruncates      bool // Int serialization truncates a fractional float (1.5 gives 1)
+	boolSerializeLax           bool // Boolean serialization turns any string but "" and "false" into true, and slices and maps into false
+	stringSerializeAnything    bool // String and ID serialization print slices, maps, booleans and floats with fmt (%v) instead of failing
+	rootPropagationDropsErrors bool // when a non-null root field is null, the field errors collected before are dropped from the result
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// hzStats counts the shapes of the recorded bugs the cases have ("shape graphql-go/N"), the
+// cases skipped for them under HEGEL_NO_KNOWN=1 ("known graphql-go/N"), the draws hzOnly
+// rejected ("filtered <name>") and the cases skipped for an unrecorded candidate bug
+// ("candidate/go/graphql-go-N"); printed and reset by the collector, under hzAvoidedMu.
+var hzStats = map[string]int{}
+
+func hzCount(key string) {
+	hzAvoidedMu.Lock()
+	hzStats[key]++
+	hzAvoidedMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize and go/bubbles judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of graphql-go/N)", and under
+// HEGEL_NO_KNOWN=1 skips the case instead (counted as known). The wide and the narrow
+// properties of a family share their judge function (judgeIntro, judgeValidate) and so
+// this. The classifier that names the shape is computed from the case (and, for Validate,
+// the oracle's verdict on the unmutated document), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzCount("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzCount("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzCount("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- type system
+
+// hzRef is a type reference: a named type, a list or a non-null wrapper.
+type hzRef struct {
+	name string // named type, when of == nil
+	list bool   // [of]
+	of   *hzRef // the wrapped type of a list or a non-null
+}
+
+func hzNamed(name string) *hzRef   { return &hzRef{name: name} }
+func hzListOf(of *hzRef) *hzRef    { return &hzRef{list: true, of: of} }
+func hzNonNullOf(of *hzRef) *hzRef { return &hzRef{of: of} }
+
+func (r *hzRef) isNonNull() bool { return r.of != nil && !r.list }
+func (r *hzRef) isList() bool    { return r.list }
+
+// nullable strips one non-null wrapper.
+func (r *hzRef) nullable() *hzRef {
+	if r.isNonNull() {
+		return r.of
+	}
+	return r
+}
+
+// named is the innermost named type.
+func (r *hzRef) named() string {
+	for r.of != nil {
+		r = r.of
+	}
+	return r.name
+}
+
+func (r *hzRef) String() string {
+	switch {
+	case r.list:
+		return "[" + r.of.String() + "]"
+	case r.of != nil:
+		return r.of.String() + "!"
+	}
+	return r.name
+}
+
+type hzArg struct {
+	name string
+	typ  *hzRef
+	def  any // default value (hzNoDefault when none)
+	desc string
+}
+
+type hzFieldDef struct {
+	name       string
+	typ        *hzRef
+	args       []*hzArg
+	desc       string
+	deprecated string // deprecation reason, "" for none
+	echo       bool   // resolved to the canonical JSON of its arguments
+}
+
+type hzEnumDef struct {
+	name       string
+	values     []string
+	valueDescs []string // the values' descriptions, one per value ("" for none); nil for none at all
+	desc       string
+}
+
+// valueDesc is the description of the i-th value ("" for none).
+func (e *hzEnumDef) valueDesc(i int) string {
+	if i < len(e.valueDescs) {
+		return e.valueDescs[i]
+	}
+	return ""
+}
+
+type hzInputField struct {
+	name string
+	typ  *hzRef
+	def  any
+	desc string
+}
+
+type hzInputDef struct {
+	name   string
+	fields []*hzInputField
+	desc   string
+}
+
+type hzIfaceDef struct {
+	name   string
+	fields []*hzFieldDef
+	desc   string
+}
+
+type hzObjectDef struct {
+	name   string
+	ifaces []string
+	fields []*hzFieldDef
+	desc   string
+}
+
+type hzUnionDef struct {
+	name    string
+	members []string
+	desc    string
+}
+
+// hzSchema is a generated type system; Query is the root.
+type hzSchema struct {
+	enums   []*hzEnumDef
+	inputs  []*hzInputDef
+	ifaces  []*hzIfaceDef
+	objects []*hzObjectDef
+	unions  []*hzUnionDef
+}
+
+// hzNoDefault marks an argument or input field without a default value (nil is the literal
+// null default).
+type hzNoDefaultT struct{}
+
+var hzNoDefault = hzNoDefaultT{}
+
+// hzEnumVal is an enum value in a generated value (printed bare in literals, a string in JSON).
+type hzEnumVal string
+
+var hzScalars = []string{"Int", "Float", "String", "Boolean", "ID"}
+
+func hzIsScalar(name string) bool {
+	for _, s := range hzScalars {
+		if s == name {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *hzSchema) enum(name string) *hzEnumDef {
+	for _, e := range s.enums {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) input(name string) *hzInputDef {
+	for _, e := range s.inputs {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) iface(name string) *hzIfaceDef {
+	for _, e := range s.ifaces {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) object(name string) *hzObjectDef {
+	for _, e := range s.objects {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) union(name string) *hzUnionDef {
+	for _, e := range s.unions {
+		if e.name == name {
+			return e
+		}
+	}
+	return nil
+}
+
+func (s *hzSchema) isLeaf(name string) bool { return hzIsScalar(name) || s.enum(name) != nil }
+
+func (s *hzSchema) isAbstract(name string) bool { return s.iface(name) != nil || s.union(name) != nil }
+
+// fields of an object or interface type (nil for others).
+func (s *hzSchema) fields(name string) []*hzFieldDef {
+	if o := s.object(name); o != nil {
+		return o.fields
+	}
+	if i := s.iface(name); i != nil {
+		return i.fields
+	}
+	return nil
+}
+
+func (s *hzSchema) field(typeName, fieldName string) *hzFieldDef {
+	for _, f := range s.fields(typeName) {
+		if f.name == fieldName {
+			return f
+		}
+	}
+	return nil
+}
+
+// possibleTypes of an object (itself), interface or union.
+func (s *hzSchema) possibleTypes(name string) []string {
+	if s.object(name) != nil {
+		return []string{name}
+	}
+	if u := s.union(name); u != nil {
+		return u.members
+	}
+	var out []string
+	for _, o := range s.objects {
+		for _, i := range o.ifaces {
+			if i == name {
+				out = append(out, o.name)
+			}
+		}
+	}
+	return out
+}
+
+// overlap: do two composite types share a possible type (fragment spread applicability).
+func (s *hzSchema) overlap(a, b string) bool {
+	for _, x := range s.possibleTypes(a) {
+		for _, y := range s.possibleTypes(b) {
+			if x == y {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- SDL
+
+func hzQuote(s string) string {
+	b, _ := hzJSONMarshal(s)
+	return string(b)
+}
+
+// hzLiteral prints a value as a GraphQL literal (the SDL form of a default value).
+func hzLiteral(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(v)
+	case float64:
+		return hzFloatLiteral(v)
+	case string:
+		return hzQuote(v)
+	case hzEnumVal:
+		return string(v)
+	case []any:
+		parts := make([]string, len(v))
+		for i, x := range v {
+			parts[i] = hzLiteral(x)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			parts[i] = k + ": " + hzLiteral(v[k])
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	panic(fmt.Sprintf("hzLiteral: %T", v))
+}
+
+// hzFloatLiteral prints a float with a fraction or an exponent, as a FloatValue token.
+func hzFloatLiteral(f float64) string {
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	if !strings.ContainsAny(s, ".eE") {
+		s += ".0"
+	}
+	return s
+}
+
+func hzDesc(desc, indent string) string {
+	if desc == "" {
+		return ""
+	}
+	return indent + hzQuote(desc) + "\n"
+}
+
+func hzArgsSDL(args []*hzArg) string {
+	if len(args) == 0 {
+		return ""
+	}
+	parts := make([]string, len(args))
+	for i, a := range args {
+		s := a.name + ": " + a.typ.String()
+		if a.def != hzNoDefault {
+			s += " = " + hzLiteral(a.def)
+		}
+		if a.desc != "" {
+			s = hzQuote(a.desc) + " " + s
+		}
+		parts[i] = s
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func hzFieldsSDL(fields []*hzFieldDef) string {
+	var b strings.Builder
+	for _, f := range fields {
+		b.WriteString(hzDesc(f.desc, "  "))
+		b.WriteString("  " + f.name + hzArgsSDL(f.args) + ": " + f.typ.String())
+		if f.deprecated != "" {
+			b.WriteString(" @deprecated(reason: " + hzQuote(f.deprecated) + ")")
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+// hzSDL prints the schema in the schema definition language, for graphql-core's build_schema.
+func hzSDL(s *hzSchema) string {
+	var b strings.Builder
+	for _, e := range s.enums {
+		b.WriteString(hzDesc(e.desc, ""))
+		b.WriteString("enum " + e.name + " {\n")
+		for i, v := range e.values {
+			b.WriteString(hzDesc(e.valueDesc(i), "  "))
+			b.WriteString("  " + v + "\n")
+		}
+		b.WriteString("}\n\n")
+	}
+	for _, in := range s.inputs {
+		b.WriteString(hzDesc(in.desc, ""))
+		b.WriteString("input " + in.name + " {\n")
+		for _, f := range in.fields {
+			b.WriteString(hzDesc(f.desc, "  "))
+			b.WriteString("  " + f.name + ": " + f.typ.String())
+			if f.def != hzNoDefault {
+				b.WriteString(" = " + hzLiteral(f.def))
+			}
+			b.WriteString("\n")
+		}
+		b.WriteString("}\n\n")
+	}
+	for _, i := range s.ifaces {
+		b.WriteString(hzDesc(i.desc, ""))
+		b.WriteString("interface " + i.name + " {\n" + hzFieldsSDL(i.fields) + "}\n\n")
+	}
+	for _, o := range s.objects {
+		b.WriteString(hzDesc(o.desc, ""))
+		b.WriteString("type " + o.name)
+		if len(o.ifaces) > 0 {
+			b.WriteString(" implements " + strings.Join(o.ifaces, " & "))
+		}
+		b.WriteString(" {\n" + hzFieldsSDL(o.fields) + "}\n\n")
+	}
+	for _, u := range s.unions {
+		b.WriteString(hzDesc(u.desc, ""))
+		b.WriteString("union " + u.name + " = " + strings.Join(u.members, " | ") + "\n\n")
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- Go schema
+
+// hzGoValue turns a generated value into the Go value graphql-go holds for a variable.
+func hzGoValue(v any) any {
+	switch v := v.(type) {
+	case hzEnumVal:
+		return string(v)
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = hzGoValue(x)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = hzGoValue(x)
+		}
+		return out
+	}
+	return v
+}
+
+// hzGoDefault turns a generated default value into the coerced Go value graphql-go holds for
+// it (build_schema coerces the SDL literal: an Int literal is a float64 for Float and a string
+// for ID).
+func hzGoDefault(s *hzSchema, r *hzRef, v any) any {
+	if v == nil {
+		return nil
+	}
+	if r.isNonNull() {
+		return hzGoDefault(s, r.of, v)
+	}
+	if r.isList() {
+		items, ok := v.([]any)
+		if !ok {
+			items = []any{v}
+		}
+		out := make([]any, len(items))
+		for i, x := range items {
+			out[i] = hzGoDefault(s, r.of, x)
+		}
+		return out
+	}
+	switch r.name {
+	case "Float":
+		if i, ok := v.(int); ok {
+			return float64(i)
+		}
+	case "ID":
+		if i, ok := v.(int); ok {
+			return strconv.Itoa(i)
+		}
+	}
+	if in := s.input(r.name); in != nil {
+		// Literal coercion fills in the defaults of absent fields.
+		m := v.(map[string]any)
+		out := make(map[string]any, len(m))
+		for _, f := range in.fields {
+			if x, ok := m[f.name]; ok {
+				out[f.name] = hzGoDefault(s, f.typ, x)
+			} else if f.def != hzNoDefault {
+				out[f.name] = hzGoDefault(s, f.typ, f.def)
+			}
+		}
+		return out
+	}
+	return hzGoValue(v)
+}
+
+// hzValidValue: is v a valid input value of the type (nulls only in nullable positions, the
+// right kinds, required input fields present)? A check on the generators' strict values.
+func hzValidValue(s *hzSchema, r *hzRef, v any) bool {
+	if v == nil {
+		return !r.isNonNull()
+	}
+	if r.isNonNull() {
+		return hzValidValue(s, r.of, v)
+	}
+	if r.isList() {
+		items, ok := v.([]any)
+		if !ok {
+			return hzValidValue(s, r.of, v)
+		}
+		for _, x := range items {
+			if !hzValidValue(s, r.of, x) {
+				return false
+			}
+		}
+		return true
+	}
+	switch r.name {
+	case "Int":
+		_, ok := v.(int)
+		return ok
+	case "Float":
+		_, isInt := v.(int)
+		_, isFloat := v.(float64)
+		return isInt || isFloat
+	case "String":
+		_, ok := v.(string)
+		return ok
+	case "Boolean":
+		_, ok := v.(bool)
+		return ok
+	case "ID":
+		_, isInt := v.(int)
+		_, isString := v.(string)
+		return isInt || isString
+	}
+	if e := s.enum(r.name); e != nil {
+		ev, ok := v.(hzEnumVal)
+		if !ok {
+			return false
+		}
+		for _, name := range e.values {
+			if name == string(ev) {
+				return true
+			}
+		}
+		return false
+	}
+	in := s.input(r.name)
+	m, ok := v.(map[string]any)
+	if in == nil || !ok {
+		return false
+	}
+	for k, x := range m {
+		var f *hzInputField
+		for _, g := range in.fields {
+			if g.name == k {
+				f = g
+			}
+		}
+		if f == nil || !hzValidValue(s, f.typ, x) {
+			return false
+		}
+	}
+	for _, f := range in.fields {
+		if _, present := m[f.name]; !present && f.typ.isNonNull() && f.def == hzNoDefault {
+			return false
+		}
+	}
+	return true
+}
+
+type hzGoTypes map[string]graphql.Type
+
+func (ts hzGoTypes) ref(r *hzRef) graphql.Type {
+	switch {
+	case r.list:
+		return graphql.NewList(ts.ref(r.of))
+	case r.of != nil:
+		return graphql.NewNonNull(ts.ref(r.of))
+	}
+	t, ok := ts[r.name]
+	if !ok {
+		panic("hzGoTypes: unknown type " + r.name)
+	}
+	return t
+}
+
+func (ts hzGoTypes) field(s *hzSchema, f *hzFieldDef) *graphql.Field {
+	gf := &graphql.Field{
+		Type:              ts.ref(f.typ),
+		Description:       f.desc,
+		DeprecationReason: f.deprecated,
+	}
+	if len(f.args) > 0 {
+		gf.Args = graphql.FieldConfigArgument{}
+		for _, a := range f.args {
+			ac := &graphql.ArgumentConfig{Type: ts.ref(a.typ), Description: a.desc}
+			if a.def != hzNoDefault {
+				ac.DefaultValue = hzGoDefault(s, a.typ, a.def)
+			}
+			gf.Args[a.name] = ac
+		}
+	}
+	if f.echo {
+		gf.Resolve = func(p graphql.ResolveParams) (any, error) {
+			return hzCanonical(p.Args), nil
+		}
+	}
+	return gf
+}
+
+// hzBuild builds the graphql-go schema of a generated type system. Every object type checks
+// the __typename of its values (IsTypeOf), as graphql-core's default type resolver reads it.
+func hzBuild(s *hzSchema) (graphql.Schema, error) {
+	ts := hzGoTypes{
+		"Int": graphql.Int, "Float": graphql.Float, "String": graphql.String,
+		"Boolean": graphql.Boolean, "ID": graphql.ID,
+	}
+	for _, e := range s.enums {
+		values := graphql.EnumValueConfigMap{}
+		for i, v := range e.values {
+			values[v] = &graphql.EnumValueConfig{Value: v, Description: e.valueDesc(i)}
+		}
+		ts[e.name] = graphql.NewEnum(graphql.EnumConfig{Name: e.name, Values: values, Description: e.desc})
+	}
+	for _, i := range s.ifaces {
+		ts[i.name] = graphql.NewInterface(graphql.InterfaceConfig{Name: i.name, Fields: graphql.Fields{}, Description: i.desc})
+	}
+	for _, o := range s.objects {
+		name := o.name
+		var ifaces []*graphql.Interface
+		for _, i := range o.ifaces {
+			ifaces = append(ifaces, ts[i].(*graphql.Interface))
+		}
+		ts[o.name] = graphql.NewObject(graphql.ObjectConfig{
+			Name:        o.name,
+			Fields:      graphql.Fields{},
+			Interfaces:  ifaces,
+			Description: o.desc,
+			IsTypeOf: func(p graphql.IsTypeOfParams) bool {
+				m, ok := p.Value.(map[string]any)
+				return ok && m["__typename"] == name
+			},
+		})
+	}
+	for _, u := range s.unions {
+		var members []*graphql.Object
+		for _, m := range u.members {
+			members = append(members, ts[m].(*graphql.Object))
+		}
+		ts[u.name] = graphql.NewUnion(graphql.UnionConfig{Name: u.name, Types: members, Description: u.desc})
+	}
+	for _, in := range s.inputs {
+		ts[in.name] = graphql.NewInputObject(graphql.InputObjectConfig{Name: in.name, Fields: graphql.InputObjectConfigFieldMap{}, Description: in.desc})
+	}
+	// Fields, once every type exists.
+	for _, i := range s.ifaces {
+		it := ts[i.name].(*graphql.Interface)
+		for _, f := range i.fields {
+			it.AddFieldConfig(f.name, ts.field(s, f))
+		}
+	}
+	for _, o := range s.objects {
+		ot := ts[o.name].(*graphql.Object)
+		for _, f := range o.fields {
+			ot.AddFieldConfig(f.name, ts.field(s, f))
+		}
+	}
+	for _, in := range s.inputs {
+		it := ts[in.name].(*graphql.InputObject)
+		for _, f := range in.fields {
+			fc := &graphql.InputObjectFieldConfig{Type: ts.ref(f.typ), Description: f.desc}
+			if f.def != hzNoDefault {
+				fc.DefaultValue = hzGoDefault(s, f.typ, f.def)
+			}
+			it.AddFieldConfig(f.name, fc)
+		}
+	}
+	// Every named type, as build_schema puts every SDL type in the type map.
+	var extra []graphql.Type
+	for name, t := range ts {
+		if name != "Query" && !hzIsScalar(name) {
+			extra = append(extra, t)
+		}
+	}
+	return graphql.NewSchema(graphql.SchemaConfig{Query: ts["Query"].(*graphql.Object), Types: extra})
+}
+
+// --------------------------------------------------------------------------- canonical JSON
+
+// hzCanonical prints coerced argument values in a form both implementations can produce:
+// sorted keys, integers plain, floats with four decimals, strings JSON-quoted.
+func hzCanonical(v any) string {
+	switch v := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if v {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(v)
+	case int64:
+		return strconv.FormatInt(v, 10)
+	case float64:
+		return strconv.FormatFloat(v, 'f', 4, 64)
+	case float32:
+		return strconv.FormatFloat(float64(v), 'f', 4, 64)
+	case string:
+		return hzQuote(v)
+	case []any:
+		parts := make([]string, len(v))
+		for i, x := range v {
+			parts[i] = hzCanonical(x)
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case map[string]any:
+		// Null-valued entries are left out, as graphql-go leaves null input fields out of its
+		// maps: absent and null compare equal.
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			if v[k] != nil {
+				keys = append(keys, k)
+			}
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			parts[i] = hzQuote(k) + ":" + hzCanonical(v[k])
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	return fmt.Sprintf("<%T>", v)
+}
diff --git a/hegel/hegel_zoo_validate_shapes_test.go b/hegel/hegel_zoo_validate_shapes_test.go
new file mode 100644
index 0000000..bee6b03
--- /dev/null
+++ b/hegel/hegel_zoo_validate_shapes_test.go
@@ -0,0 +1,266 @@
+package hegel
+
+// The shape regions of the recorded validation bugs (bugs.toml graphql-go/17 and 18) and
+// the narrow properties over them: each region is a generated document (the schema and
+// the operation of the wide property) plus one mutation drawn over the bug's shape with
+// random contents, judged exactly like the wide property (judgeValidate, with the
+// classifier validateShape naming the bug). Every narrow property fails every run by
+// default; under HEGEL_NO_KNOWN=1 its mutation is one from the region next to the shape
+// instead (hzShaped) and the property passes. The hit rates quoted at each region are the
+// collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowValidate runs a narrow property: every drawn case through the wide property's judge.
+func narrowValidate(t *testing.T, cases hegel.Generator[validateCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeValidate(j, o, c)
+		col.count("cases")
+	})
+}
+
+// validQueriesFor: the operations against the schema whose unmutated document is valid:
+// an invalid one hides the bug (both sides reject, the verdicts agree), so a narrow case
+// must start from a valid document. graphql-go's own verdict on the unmutated document
+// stands in for the oracle's, which cannot be asked in a generator: on the generated
+// operations the two agree, the verdicts graphql-go gets wrong being the shapes of
+// graphql-go/17 and 18 (absent from an unmutated document) and of 2, 3 and 8 (kept out of
+// the operations by TestHegelExecute's switches); the oracle's verdict is what the
+// classifier takes in the property. Measured rejection: see the hit rates below.
+func validQueriesFor(s *hzSchema) hegel.Generator[queryState] {
+	schema, err := hzBuild(s)
+	return hzOnly(true, "base invalid", queriesFor(s), func(qs queryState) bool {
+		if err != nil {
+			return false
+		}
+		ok, _ := hzGoValidate(&schema, qs.q.text)
+		return ok
+	})
+}
+
+// narrowCases: a valid generated document plus the one mutation drawn.
+func narrowCases(m hegel.Generator[hzMutation]) hegel.Generator[validateCase] {
+	return casesWith(validQueriesFor, hzOne(m))
+}
+
+// rootLeaf: a leaf field of Query without arguments, or __typename.
+func rootLeaf(s *hzSchema) string {
+	for _, f := range s.fields("Query") {
+		if s.isLeaf(f.typ.named()) && len(f.args) == 0 {
+			return f.name
+		}
+	}
+	return "__typename"
+}
+
+// --------------------------------------------------------------------------- graphql-go/17
+
+// directivePlacement: where the directives go: an inserted root field (aliased zdd, a leaf
+// of Query or __typename), a fragment spread (with its fragment), an inline fragment with
+// a type condition, one without. The operation and a fragment definition are not
+// placements: @skip and @include may not be used there and both sides reject the document
+// for that.
+var directivePlacements = []string{"typename", "leaf", "spread", "inline", "inlineNoCondition"}
+
+// placed inserts the selection of the placement with the directives at the root.
+func placed(s *hzSchema, place, directives, t string) string {
+	switch place {
+	case "typename":
+		return hzInsertRoot(t, "zdd: __typename"+directives)
+	case "leaf":
+		return hzInsertRoot(t, "zdd: "+rootLeaf(s)+directives)
+	case "spread":
+		return hzInsertRoot(t, "...FDup"+directives) + "fragment FDup on Query { __typename }\n"
+	case "inline":
+		return hzInsertRoot(t, "... on Query"+directives+" { __typename }")
+	}
+	return hzInsertRoot(t, "..."+directives+" { __typename }")
+}
+
+// dupDirective: the duplicate-directive mutation drawn: @skip or @include two or three
+// times on one placement, each with a condition true, false or $vdd (a Boolean! variable
+// the mutation declares).
+type dupDirective struct {
+	name  string
+	conds []string
+	place string
+}
+
+func (d dupDirective) apply(g *hzQueryGen, t string) string {
+	var b strings.Builder
+	for _, c := range d.conds {
+		b.WriteString(" @" + d.name + "(if: " + c + ")")
+	}
+	if strings.Contains(b.String(), "$vdd") {
+		t = hzAddVariable(t, "$vdd: Boolean!")
+	}
+	return placed(g.s, d.place, b.String(), t)
+}
+
+var conditions = hzSampled("true", "false", "$vdd")
+
+var dupDirectives = hegel.Composite(func(tc hegel.TestCase) hzMutation {
+	d := dupDirective{
+		name:  hegel.Draw(tc, hzSampled("skip", "include")),
+		conds: hegel.Draw(tc, hzCounted(conditions, 2, 3)),
+		place: hegel.Draw(tc, hzSampled(directivePlacements...)),
+	}
+	return hzMutation{name: "duplicateDirective", apply: d.apply}
+})
+
+// distinctDirectives: the region past the shape: one directive, or @skip and @include
+// once each in either order, on the same placements (valid on both sides).
+var distinctDirectives = hegel.Composite(func(tc hegel.TestCase) hzMutation {
+	names := hegel.Draw(tc, hzSampled([]string{"skip"}, []string{"include"}, []string{"skip", "include"}, []string{"include", "skip"}))
+	conds := hegel.Draw(tc, hzCounted(conditions, len(names), len(names)))
+	place := hegel.Draw(tc, hzSampled(directivePlacements...))
+	return hzMutation{name: "distinctDirectives", apply: func(g *hzQueryGen, t string) string {
+		var b strings.Builder
+		for i, n := range names {
+			b.WriteString(" @" + n + "(if: " + conds[i] + ")")
+		}
+		if strings.Contains(b.String(), "$vdd") {
+			t = hzAddVariable(t, "$vdd: Boolean!")
+		}
+		return placed(g.s, place, b.String(), t)
+	}}
+})
+
+// duplicateDirectives: a valid generated document plus a duplicate directive. Hit rate
+// 1000 of 1000.
+var duplicateDirectives = narrowCases(hzShaped[hegel.Generator[hzMutation]](dupDirectives, distinctDirectives))
+
+func TestHegelValidateDirectivesAreUniquePerLocation(t *testing.T) {
+	narrowValidate(t, duplicateDirectives)
+}
+
+// --------------------------------------------------------------------------- graphql-go/18
+
+// sdlDefinition: a type system definition drawn: its kind, name, an optional description,
+// its items (fields, members, values, locations) and whether it goes before the operation
+// or after it.
+type sdlDefinition struct {
+	kind   string
+	name   string
+	desc   string
+	items  []string
+	before bool
+}
+
+func (d sdlDefinition) text() string {
+	var b strings.Builder
+	if d.desc != "" {
+		b.WriteString(hzQuote(d.desc) + " ")
+	}
+	switch d.kind {
+	case "scalar":
+		b.WriteString("scalar " + d.name)
+	case "union":
+		b.WriteString("union " + d.name + " = " + strings.Join(d.items, " | "))
+	case "schema":
+		b.WriteString("schema { " + strings.Join(d.items, " ") + " }")
+	case "directive":
+		b.WriteString("directive @" + d.name + " on " + strings.Join(d.items, " | "))
+	default: // type, interface, enum, input, extend type
+		b.WriteString(d.kind + " " + d.name + " { " + strings.Join(d.items, " ") + " }")
+	}
+	return b.String()
+}
+
+func (d sdlDefinition) apply(g *hzQueryGen, t string) string {
+	if d.before {
+		return d.text() + "\n" + t
+	}
+	return t + d.text() + "\n"
+}
+
+// The kinds graphql-go's parser accepts in an executable document and graphql-core rejects
+// as not executable, with their items. Left out: `extend` of anything but a type (a syntax
+// error in graphql-go: both reject), a description before `schema` or `extend type` (the
+// same: graphql-go's parser takes a description before the other kinds only), an empty
+// body and an unknown directive location (a syntax error in graphql-core), and a schema
+// definition naming an unknown root type (graphql-go's KnownTypeNames rejects it). The
+// names are a mix of fresh ones and the schema's (a definition's name does not matter to
+// either side).
+var (
+	definitionNames = hzSampled("Extra", "X", "Query", "O1", "E1", "In1", "I1", "Int")
+	fieldItems      = hzSampled("a: Int", "b: String", "z: [Int!]!", "o: O1", "x: Extra", "a(n: Int = 1): Int", "a: Int @deprecated", "e: E1")
+	inputItems      = hzSampled("a: Int", "b: String = \"x\"", "c: [Int]", "d: Int = 1")
+	enumItems       = hzSampled("A", "B", "RED")
+	unionItems      = hzSampled("Query", "O1", "Extra")
+	schemaItems     = hzSampled([]string{"query: Query"}, []string{"query: Query", "mutation: Query"})
+	locationItems   = hzSampled("FIELD", "FRAGMENT_SPREAD", "INLINE_FRAGMENT", "QUERY")
+	directiveNames  = hzSampled("d", "skip", "include")
+	definitionDescs = hzMaybe(30, hzSampled("a definition", "with \"quotes\""))
+	noDesc          = hegel.Just("")
+)
+
+// definitionOf: a definition of the kind with 1-2 items from the table and a description
+// from descs.
+func definitionOf(kind string, descs, names hegel.Generator[string], items hegel.Generator[[]string]) hegel.Generator[sdlDefinition] {
+	return hegel.Composite(func(tc hegel.TestCase) sdlDefinition {
+		return sdlDefinition{
+			kind:   kind,
+			desc:   hegel.Draw(tc, descs),
+			name:   hegel.Draw(tc, names),
+			items:  hegel.Draw(tc, items),
+			before: hegel.Draw(tc, hzCoin(30)),
+		}
+	})
+}
+
+func someOf(g hegel.Generator[string]) hegel.Generator[[]string] { return hzCounted(g, 1, 2) }
+
+var sdlDefinitions = hzWeighted(
+	hzW(4, definitionOf("type", definitionDescs, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("interface", definitionDescs, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("union", definitionDescs, definitionNames, someOf(unionItems))),
+	hzW(2, definitionOf("enum", definitionDescs, definitionNames, someOf(enumItems))),
+	hzW(2, definitionOf("input", definitionDescs, definitionNames, someOf(inputItems))),
+	hzW(2, definitionOf("scalar", definitionDescs, definitionNames, hegel.Just[[]string](nil))),
+	hzW(2, definitionOf("schema", noDesc, hegel.Just(""), schemaItems)),
+	hzW(2, definitionOf("extend type", noDesc, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("directive", definitionDescs, directiveNames, someOf(locationItems))),
+)
+
+var sdlInDocuments = hegel.Map(sdlDefinitions, func(d sdlDefinition) hzMutation {
+	return hzMutation{name: "sdlInDocument", apply: d.apply}
+})
+
+// executableDefinitions: the region past the shape: an executable definition beside the
+// operation (a fragment it spreads at the root: valid on both sides), or an extension
+// graphql-go's parser does not accept (`extend` of a schema, interface, union, enum, input
+// or scalar: a syntax error there, not executable to graphql-core: both reject).
+var executableDefinitions = hzWeighted(
+	hzW(2, hegel.Map(hzCoin(30), func(before bool) hzMutation {
+		return hzMutation{name: "extraFragment", apply: func(g *hzQueryGen, t string) string {
+			frag := "fragment FExtra on Query { __typename }\n"
+			t = hzInsertRoot(t, "...FExtra")
+			if before {
+				return frag + t
+			}
+			return t + frag
+		}}
+	})),
+	hzW(2, hegel.Map(hzSampled("extend schema { query: Query }", "extend interface I1 { a: Int }", "extend union U1 = O1", "extend enum E1 { A }", "extend input In1 { a: Int }", "extend scalar X"), func(def string) hzMutation {
+		return hzMutation{name: "unparsedExtension", apply: func(g *hzQueryGen, t string) string { return t + def + "\n" }}
+	})),
+)
+
+// definitionsInDocuments: a valid generated document plus a type system definition of a
+// drawn kind. Hit rate 1000 of 1000.
+var definitionsInDocuments = narrowCases(hzShaped[hegel.Generator[hzMutation]](sdlInDocuments, executableDefinitions))
+
+func TestHegelValidateDefinitionsAreExecutable(t *testing.T) {
+	narrowValidate(t, definitionsInDocuments)
+}
diff --git a/hegel/hegel_zoo_validate_test.go b/hegel/hegel_zoo_validate_test.go
new file mode 100644
index 0000000..2594cbf
--- /dev/null
+++ b/hegel/hegel_zoo_validate_test.go
@@ -0,0 +1,454 @@
+package hegel
+
+// TestHegelValidate: the validation verdict on a generated document, mutated to break one
+// or two rules, must agree with graphql-core's. Two of the mutations are the shapes of the
+// recorded bugs (graphql-go/17: a duplicate directive on one selection; graphql-go/18: a
+// type definition in the document), drawn from the table at their natural weight and named
+// by validateShape before the library is called; under HEGEL_NO_KNOWN=1 they are left out
+// of the table. The narrow properties of hegel_zoo_validate_shapes_test.go share
+// judgeValidate.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"github.com/graphql-go/graphql/language/parser"
+	"github.com/graphql-go/graphql/language/source"
+	"hegel.dev/go/hegel"
+)
+
+// hzMutation edits the text of an operation; the name is the rule it aims at.
+type hzMutation struct {
+	name  string
+	apply func(g *hzQueryGen, text string) string
+}
+
+// hzRootOpen finds the `{` opening the first operation's selection set: the first brace
+// outside the variable definitions' parentheses and outside string literals (a variable's
+// default value may be an input object literal with braces of its own; the old test took
+// the first brace of the text and then mutated inside the variable definitions, a syntax
+// error both sides reported, which the verdicts agreed on and hid).
+func hzRootOpen(text string) int {
+	depth := 0
+	for i := 0; i < len(text); i++ {
+		switch text[i] {
+		case '"':
+			for i++; i < len(text) && text[i] != '"'; i++ {
+				if text[i] == '\\' {
+					i++
+				}
+			}
+		case '(':
+			depth++
+		case ')':
+			depth--
+		case '{':
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+// hzInsertRoot inserts a selection at the start of the first operation's selection set.
+func hzInsertRoot(text, sel string) string {
+	i := hzRootOpen(text)
+	return text[:i+1] + " " + sel + " " + text[i+1:]
+}
+
+// hzAddVariable adds a variable definition to the first operation.
+func hzAddVariable(text, def string) string {
+	i := hzRootOpen(text)
+	head := text[:i]
+	if strings.HasSuffix(strings.TrimSpace(head), ")") {
+		j := strings.LastIndex(head, ")")
+		return head[:j] + ", " + def + head[j:] + text[i:]
+	}
+	if strings.TrimSpace(head) == "" {
+		return "query (" + def + ") " + text[i:]
+	}
+	return strings.TrimRight(head, " ") + "(" + def + ") " + text[i:]
+}
+
+var hzMutations = []hzMutation{
+	{"unknownField", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zzz") }},
+	{"unknownArgument", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "__typename(zz: 1)") }},
+	{"undefinedFragment", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "...Nope") }},
+	{"unusedFragment", func(g *hzQueryGen, t string) string { return t + "fragment Unused on Query { __typename }\n" }},
+	{"undefinedVariable", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zt: __typename @skip(if: $undef)") }},
+	{"unusedVariable", func(g *hzQueryGen, t string) string { return hzAddVariable(t, "$unused: Int") }},
+	{"duplicateVariable", func(g *hzQueryGen, t string) string {
+		return hzAddVariable(hzAddVariable(t, "$dup: Int"), "$dup: Int")
+	}},
+	{"variableNotInputType", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(hzAddVariable(t, "$vq: Query"), "zq: __typename @skip(if: $vq)")
+	}},
+	{"variableWrongPosition", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(hzAddVariable(t, "$vs: String!"), "zs: __typename @skip(if: $vs)")
+	}},
+	{"variableNullablePosition", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(hzAddVariable(t, "$vn: Boolean"), "zn: __typename @skip(if: $vn)")
+	}},
+	{"leafWithSelection", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zl: __typename { x }") }},
+	{"unknownDirective", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zd: __typename @nope") }},
+	{"misplacedDirective", func(g *hzQueryGen, t string) string {
+		i := hzRootOpen(t)
+		head := t[:i]
+		if strings.TrimSpace(head) == "" {
+			return "query @skip(if: true) " + t[i:]
+		}
+		return strings.TrimRight(head, " ") + " @skip(if: true) " + t[i:]
+	}},
+	{"duplicateDirective", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(t, "zdd: __typename @skip(if: true) @skip(if: false)")
+	}},
+	{"duplicateArgument", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(t, "zda: __typename @skip(if: true, if: false)")
+	}},
+	{"missingDirectiveArgument", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zma: __typename @skip") }},
+	{"wrongDirectiveArgument", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "zwa: __typename @skip(if: 1)") }},
+	{"unknownTypeCondition", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "... on Nope { __typename }") }},
+	{"fragmentOnScalar", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "... on Int { __typename }") }},
+	{"fragmentOnInput", func(g *hzQueryGen, t string) string {
+		if g.s.input("In1") == nil {
+			return t
+		}
+		return hzInsertRoot(t, "... on In1 { __typename }")
+	}},
+	{"impossibleSpread", func(g *hzQueryGen, t string) string { return hzInsertRoot(t, "... on O1 { __typename }") }},
+	{"duplicateFragment", func(g *hzQueryGen, t string) string {
+		if len(g.frags) == 0 {
+			return t
+		}
+		f := g.frags[0]
+		return t + "fragment " + f.name + " on " + f.on + " { __typename }\n"
+	}},
+	{"fragmentCycle", func(g *hzQueryGen, t string) string {
+		return hzInsertRoot(t, "...Cyc") + "fragment Cyc on Query { ...Cyc }\n"
+	}},
+	{"duplicateOperation", func(g *hzQueryGen, t string) string {
+		if !strings.HasPrefix(t, "query Q1") {
+			return t
+		}
+		return t + "query Q1 { __typename }\n"
+	}},
+	{"anonymousWithNamed", func(g *hzQueryGen, t string) string {
+		if strings.HasPrefix(t, "query Q1") {
+			return t
+		}
+		return t + "query Named { __typename }\n"
+	}},
+	{"twoAnonymous", func(g *hzQueryGen, t string) string {
+		if strings.HasPrefix(t, "query Q1") {
+			return t
+		}
+		return t + "{ __typename }\n"
+	}},
+	{"conflictingAlias", func(g *hzQueryGen, t string) string {
+		f := g.s.fields("Query")
+		var leaf *hzFieldDef
+		for _, x := range f {
+			if g.s.isLeaf(x.typ.named()) && len(x.args) == 0 {
+				leaf = x
+			}
+		}
+		if leaf == nil {
+			return t
+		}
+		return hzInsertRoot(t, "zc: __typename zc: "+leaf.name)
+	}},
+	{"conflictingArguments", func(g *hzQueryGen, t string) string {
+		for _, x := range g.s.fields("Query") {
+			if len(x.args) == 1 && x.args[0].typ.String() == "Int" && g.s.isLeaf(x.typ.named()) {
+				return hzInsertRoot(t, fmt.Sprintf("%s(%s: 1) %s(%s: 2)", x.name, x.args[0].name, x.name, x.args[0].name))
+			}
+		}
+		return t
+	}},
+	{"subscriptionNoRoot", func(g *hzQueryGen, t string) string {
+		if strings.HasPrefix(t, "query Q1") {
+			return t + "subscription S { __typename }\n"
+		}
+		return t
+	}},
+	{"mutationNoRoot", func(g *hzQueryGen, t string) string {
+		if strings.HasPrefix(t, "query Q1") {
+			return t + "mutation M { __typename }\n"
+		}
+		return t
+	}},
+	{"sdlInDocument", func(g *hzQueryGen, t string) string { return t + "type Extra { a: Int }\n" }},
+	{"objectFieldNoSelection", func(g *hzQueryGen, t string) string {
+		for _, x := range g.s.fields("Query") {
+			if !g.s.isLeaf(x.typ.named()) && len(x.args) == 0 {
+				return hzInsertRoot(t, "zo: "+x.name)
+			}
+		}
+		return t
+	}},
+	{"unknownInputField", func(g *hzQueryGen, t string) string {
+		for _, x := range g.s.fields("Query") {
+			for _, a := range x.args {
+				if in := g.s.input(a.typ.named()); in != nil && !a.typ.nullable().isList() {
+					return hzInsertRoot(t, fmt.Sprintf("zi: %s(%s: {zz: 1})", x.name, a.name))
+				}
+			}
+		}
+		return t
+	}},
+	{"duplicateInputField", func(g *hzQueryGen, t string) string {
+		for _, x := range g.s.fields("Query") {
+			for _, a := range x.args {
+				if in := g.s.input(a.typ.named()); in != nil && !a.typ.nullable().isList() {
+					f := in.fields[0]
+					v := hzLiteral(hzValidSample(g.s, f.typ))
+					return hzInsertRoot(t, fmt.Sprintf("zdi: %s(%s: {%s: %s, %s: %s})", x.name, a.name, f.name, v, f.name, v))
+				}
+			}
+		}
+		return t
+	}},
+}
+
+// hzValidSample is a fixed valid value of the type (no nulls).
+func hzValidSample(s *hzSchema, r *hzRef) any {
+	r = r.nullable()
+	if r.isList() {
+		return []any{hzValidSample(s, r.of)}
+	}
+	switch r.name {
+	case "Int":
+		return 1
+	case "Float":
+		return 1.5
+	case "String":
+		return "s"
+	case "Boolean":
+		return true
+	case "ID":
+		return "id"
+	}
+	if e := s.enum(r.name); e != nil {
+		return hzEnumVal(e.values[0])
+	}
+	m := map[string]any{}
+	for _, f := range s.input(r.name).fields {
+		if f.typ.isNonNull() && f.def == hzNoDefault {
+			m[f.name] = hzValidSample(s, f.typ)
+		}
+	}
+	return m
+}
+
+// hzGoValidate parses and validates the document: valid, and the first error message.
+func hzGoValidate(schema *graphql.Schema, text string) (bool, string) {
+	src := source.NewSource(&source.Source{Body: []byte(text)})
+	doc, err := parser.Parse(parser.ParseParams{Source: src})
+	if err != nil {
+		return false, "syntax: " + err.Error()
+	}
+	vr := graphql.ValidateDocument(schema, doc, nil)
+	if vr.IsValid {
+		return true, ""
+	}
+	return false, vr.Errors[0].Message
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// queryState: an operation against a schema and the generator state its mutations read
+// (the fragments it declared, the schema).
+type queryState struct {
+	q *hzQuery
+	g *hzQueryGen
+}
+
+// queriesFor: the old operation generator (hzGenQueryWith, drawing imperatively from the
+// test case) as a generator, through hegel.Composite. // part 2 replaces this
+func queriesFor(s *hzSchema) hegel.Generator[queryState] {
+	return hegel.Composite(func(tc hegel.TestCase) queryState {
+		g := &hzQueryGen{tc: tc, s: s, q: &hzQuery{features: map[string]int{}}, budget: 25}
+		return queryState{q: hzGenQueryWith(tc, s, g), g: g}
+	})
+}
+
+// validateCase: a document (an operation against the schema, with the mutations applied)
+// validated by both sides.
+type validateCase struct {
+	schema    *hzSchema
+	query     *hzQuery
+	mutations []hzMutation
+	text      string   // the document after the mutations
+	applied   []string // the names of the mutations that changed the text
+}
+
+func (c validateCase) GoString() string {
+	return fmt.Sprintf("mutations %v\ndocument:\n%s\nSDL:\n%s", c.applied, c.text, hzSDL(c.schema))
+}
+
+// mutated applies the mutations in order to the operation's text.
+func mutated(s *hzSchema, qs queryState, ms []hzMutation) validateCase {
+	c := validateCase{schema: s, query: qs.q, mutations: ms, text: qs.q.text}
+	for _, m := range ms {
+		if nt := m.apply(qs.g, c.text); nt != c.text {
+			c.text = nt
+			c.applied = append(c.applied, m.name)
+		}
+	}
+	return c
+}
+
+// shapeMutations: the mutations that are the shapes of the recorded bugs (graphql-go/17
+// and 18), by name.
+var shapeMutations = map[string]string{"duplicateDirective": "graphql-go/17", "sdlInDocument": "graphql-go/18"}
+
+// mutationTable: hzMutations entire by default (the two shapes at their natural weight: one
+// entry each of 36; a SampledFrom over a table this long is lumpy, the counts are in
+// TestHegelValidate's comment); under HEGEL_NO_KNOWN=1 the two shapes are left out.
+var mutationTable = func() []hzMutation {
+	var out []hzMutation
+	for _, m := range hzMutations {
+		if hzNoKnown && shapeMutations[m.name] != "" {
+			continue
+		}
+		out = append(out, m)
+	}
+	return out
+}()
+
+// mutationLists: 1-2 mutations from the table.
+var mutationLists = hzCounted(hzSampled(mutationTable...), 1, 2)
+
+// casesWith: the cases over a query generator per schema and a mutation-list generator.
+func casesWith(queries func(*hzSchema) hegel.Generator[queryState], ms hegel.Generator[[]hzMutation]) hegel.Generator[validateCase] {
+	return hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[validateCase] {
+		return hegel.FlatMap(queries(s), func(qs queryState) hegel.Generator[validateCase] {
+			return hegel.Map(ms, func(m []hzMutation) validateCase { return mutated(s, qs, m) })
+		})
+	})
+}
+
+var validateCases = casesWith(queriesFor, mutationLists)
+
+// hzFieldConflict: do the oracle's errors include a field conflict (OverlappingFieldsCanBeMerged)?
+func hzFieldConflict(errs []hzOracleError) bool {
+	for _, e := range errs {
+		if strings.HasPrefix(e.Message, "Fields '") && strings.Contains(e.Message, "' conflict because") {
+			return true
+		}
+	}
+	return false
+}
+
+// harmlessMutations: the mutations both sides accept: an operation of a kind the schema has
+// no root type for is not looked at by validation (it fails at execution), on both sides.
+var harmlessMutations = map[string]bool{"mutationNoRoot": true, "subscriptionNoRoot": true}
+
+// validateShape names the recorded bug the case reaches: the unmutated document is valid
+// (baseValid, the oracle's verdict on it: the classifier's input), a mutation applied is
+// one graphql-go misses, and every other mutation applied is harmless; graphql-go/17
+// (duplicateDirective) before graphql-go/18 (sdlInDocument) where both are applied (the
+// order matters only there: either bug alone makes graphql-go accept, 17 is named as the
+// lower). A mutation both sides reject beside them hides the bug, as does an invalid
+// unmutated document: both reject and the verdicts agree.
+func validateShape(c validateCase, baseValid bool) string {
+	if !baseValid {
+		return ""
+	}
+	shape := ""
+	for _, name := range c.applied {
+		id := shapeMutations[name]
+		if id == "" && !harmlessMutations[name] {
+			return ""
+		}
+		if id != "" && (shape == "" || id < shape) {
+			shape = id
+		}
+	}
+	return shape
+}
+
+// judgeValidate judges one case: the oracle's verdict on the unmutated document, the shape
+// named, then graphql-go's verdict on the document against graphql-core's.
+func judgeValidate(j *hzCaseJudge, o *hzOracle, c validateCase) {
+	sdl := hzSDL(c.schema)
+	base, err := o.validate(sdl, c.query.text)
+	if err != nil {
+		j.ht.Fatalf("oracle: %v", err)
+	}
+	if base.SchemaError != "" {
+		j.ht.Fatalf("graphql-core rejects the SDL: %s\n%s", base.SchemaError, sdl)
+	}
+	schema, err := hzBuild(c.schema)
+	if err != nil {
+		j.ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+	}
+	baseValid := len(base.Errors) == 0
+	if !baseValid {
+		j.col.count("base invalid")
+		// graphql-go/19 (recorded from this gate): graphql-go's OverlappingFieldsCanBeMergedRule
+		// does not compare the fields of a selection set with those of a fragment spread from
+		// inside a fragment it spreads: `{ c { f1: a { f2: i2c ...F2 } } } fragment F2 on I2 {
+		// ...F7 } fragment F7 on O2 { f2 { __typename } }` passes ValidateDocument (a direct
+		// `...F7` is caught), where graphql-core reports `Fields 'f2' conflict because 'i2c'
+		// and 'f2' are different fields`. The old operation generator reaches it when its
+		// alias f2 meets a field named f2 (the second f of an object) through nested spreads,
+		// about once in a thousand documents. Until part 2 of the rewrite draws the shape (a
+		// conflict through a transitive spread) on purpose and names it, a case whose
+		// unmutated document has a field conflict graphql-core reports and graphql-go accepts
+		// is skipped and counted: its mutations would be judged on a document graphql-go
+		// already gets wrong, and the pin TestHegelPinTransitiveFragmentFieldConflict keeps
+		// the bug.
+		if hzFieldConflict(base.Errors) {
+			if ok, _ := hzGoValidate(&schema, c.query.text); ok {
+				hzCount("skipped graphql-go/19")
+				j.ht.Assume(false)
+			}
+		}
+	}
+	j.Shape(validateShape(c, baseValid))
+	for _, a := range c.applied {
+		j.col.count("mutation " + a)
+	}
+	py := base
+	if c.text != c.query.text {
+		if py, err = o.validate(sdl, c.text); err != nil {
+			j.ht.Fatalf("oracle: %v", err)
+		}
+	}
+	pyValid := len(py.Errors) == 0
+	pyMsg := ""
+	if !pyValid {
+		pyMsg = py.Errors[0].Message
+	}
+	goValid, goMsg := hzGoValidate(&schema, c.text)
+	if goValid != pyValid {
+		class := "go rejects"
+		if goValid {
+			class = "go accepts"
+		}
+		j.Fail(class+" "+strings.Join(c.applied, "+"), "verdicts differ (%s)\nmutations: %v\ngraphql-go: %v %s\ngraphql-core: %v %s\ndocument:\n%s\nSDL:\n%s",
+			class, c.applied, goValid, goMsg, pyValid, pyMsg, c.text, sdl)
+		return
+	}
+	if goValid {
+		j.col.count("both valid")
+	} else {
+		j.col.count("both invalid")
+	}
+}
+
+func TestHegelValidate(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, validateCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeValidate(j, o, c)
+		col.count("cases")
+	})
+}
