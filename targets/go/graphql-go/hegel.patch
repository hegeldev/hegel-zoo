+package hegel
+
+// The shape regions of the recorded execution bugs (bugs.toml graphql-go/1 to 8) and the
+// narrow properties over them: each region is a generated case of the wide property (a
+// schema with one field added to Query for the shape, root data, an operation drawn with
+// no shape) plus the bug's shape drawn with random contents at the root of the operation,
+// judged exactly like the wide property (judgeExecute, with the classifier executeShape
+// naming the bug). Every narrow property fails every run by default; under
+// HEGEL_NO_KNOWN=1 the construction is one from the region next to the shape instead
+// (hzShaped) and the property passes. The hit rates quoted at each region are the
+// collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000): a shape
+// graphql-go hides behind a request error of its own is reached whatever the data; one
+// seen in the data (4, 5, 6, 7) is hidden when the root data nulls the root object
+// through a non-null field, which the random operation around the shape selects now and
+// then.
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowExecute runs a narrow property: every drawn case through the wide property's judge.
+func narrowExecute(t *testing.T, cases hegel.Generator[executeCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeExecute(j, o, c)
+		col.count("cases")
+	})
+}
+
+// withQueryField: the schema with the field added to Query (copies), and the input
+// objects given.
+func withQueryField(s *hzSchema, f *hzFieldDef, inputs ...*hzInputDef) *hzSchema {
+	out := *s
+	out.inputs = append(append([]*hzInputDef{}, s.inputs...), inputs...)
+	out.objects = append([]*hzObjectDef{}, s.objects...)
+	for i, o := range out.objects {
+		if o.name == "Query" {
+			q := *o
+			q.fields = append(append([]*hzFieldDef{}, o.fields...), f)
+			out.objects[i] = &q
+		}
+	}
+	return &out
+}
+
+// opParts: the construction at the root of an operation: selections put first, variables
+// and fragments declared after the operation's own.
+type opParts struct {
+	sels  []hzSelection
+	vars  []*hzVarDef
+	frags []*hzFragDef
+}
+
+// cleanOperationsFor: an operation against the schema with no shape drawn and no value
+// both sides reject (such a value would hide the shape: both reject, the verdicts agree).
+// Measured rejection: 3 to 5 % of the draws (a wrong kind at 8 % of a tenth of the
+// literals and of 15 % of the runtime values).
+func cleanOperationsFor(s *hzSchema) hegel.Generator[*hzOperation] {
+	return hzOnly(true, "both reject", operationsWith(s, operationShapes{}), func(op *hzOperation) bool {
+		return !factsOf(s, op).rejected
+	})
+}
+
+// around: the construction drawn by parts put around a clean operation against the schema.
+func around(s *hzSchema, parts hegel.Generator[opParts]) hegel.Generator[*hzOperation] {
+	return hegel.FlatMap(cleanOperationsFor(s), func(op *hzOperation) hegel.Generator[*hzOperation] {
+		return hegel.Map(parts, func(p opParts) *hzOperation {
+			out := *op
+			out.selections = append(append([]hzSelection{}, p.sels...), op.selections...)
+			out.vars = append(append([]*hzVarDef{}, op.vars...), p.vars...)
+			out.fragments = append(append([]*hzFragDef{}, op.fragments...), p.frags...)
+			return hzFinish(&out)
+		})
+	})
+}
+
+// field: a selection of the Query field with the arguments.
+func field(name string, args ...hzArgument) hzSelection {
+	return hzSelection{kind: hzField, name: name, alias: "z" + name, args: args}
+}
+
+// variable: a variable definition for the construction, named after the shape.
+func variable(name string, typ *hzRef, def any) *hzVarDef {
+	return &hzVarDef{name: name, typ: typ, def: def}
+}
+
+// given: the variable with the runtime value.
+func given(v *hzVarDef, value any) *hzVarDef {
+	v.provided, v.value = true, value
+	return v
+}
+
+// leafRefs: a nullable leaf type of the schema.
+func leafRefs(s *hzSchema) hegel.Generator[*hzRef] {
+	return refs(leafNames(s), hegel.Just(hzWrap(hzPlain)))
+}
+
+// --------------------------------------------------------------------------- graphql-go/1
+
+// nullLiterals: a literal of the nullable type with a null in it: the value itself, the
+// item of a list of a nullable item type, a nullable field of an input object (with its
+// required fields).
+func nullLiterals(s *hzSchema, r *hzRef) hegel.Generator[any] {
+	choices := []hzChoice[any]{hzW(2, hegel.Just[any](nil))}
+	if r.isList() && !r.of.isNonNull() {
+		choices = append(choices, hzW(2, hegel.Just[any]([]any{nil})))
+	}
+	if in := s.input(r.named()); in != nil && !r.isList() {
+		for _, f := range in.fields {
+			if !f.typ.isNonNull() {
+				m := map[string]any{f.name: nil}
+				for _, g := range in.fields {
+					if g.typ.isNonNull() && g.def == hzNoDefault {
+						m[g.name] = hzValidSample(s, g.typ)
+					}
+				}
+				choices = append(choices, hzW(2, hegel.Just[any](m)))
+			}
+		}
+	}
+	return hzWeighted(choices...)
+}
+
+// nullSchemas: a type system with zn(n: T): Int on Query, T a nullable input type.
+var nullSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	return hegel.Map(refs(inputNames(s), hzWeighted(hzW(2, hegel.Just(hzWrap(hzPlain))), hzW(2, hegel.Just(hzWrap(func(r *hzRef) *hzRef { return hzListOf(r) }))))), func(r *hzRef) *hzSchema {
+		return withQueryField(s, &hzFieldDef{name: "zn", typ: hzNamed("Int"), args: []*hzArg{{name: "n", typ: r, def: hzNoDefault}}})
+	})
+})
+
+// nullPlacements: the literal of the argument's type drawn by values as the argument of
+// zn (two in three), or as the default of a variable passed to it (provided a strict
+// value or not).
+func nullPlacements(s *hzSchema, values func(*hzSchema, *hzRef) hegel.Generator[any]) hegel.Generator[opParts] {
+	r := s.field("Query", "zn").args[0].typ
+	return hzWeighted(
+		hzW(4, hegel.Map(values(s, r), func(v any) opParts { return opParts{sels: []hzSelection{field("zn", hzArgument{"n", v})}} })),
+		hzW(2, hegel.Composite(func(tc hegel.TestCase) opParts {
+			v := variable("z1", r, hegel.Draw(tc, values(s, r)))
+			if hegel.Draw(tc, hzCoin(50)) {
+				given(v, hegel.Draw(tc, strictNonNull(s, r, 3)))
+			}
+			return opParts{sels: []hzSelection{field("zn", hzArgument{"n", v})}, vars: []*hzVarDef{v}}
+		})),
+	)
+}
+
+// pastNull: the region past the shape: a strict literal other than null.
+func pastNull(s *hzSchema, r *hzRef) hegel.Generator[any] { return strictNonNull(s, r, 3) }
+
+// nullLiteralCases: a null literal at the argument of zn or in a variable default (the
+// shape: graphql-go rejects the document). Hit rate 1000 of 1000.
+var nullLiteralCases = executeCasesOver(nullSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, nullPlacements(s, hzShaped(nullLiterals, pastNull)))
+})
+
+func TestHegelExecuteNullLiteralsParse(t *testing.T) { narrowExecute(t, nullLiteralCases) }
+
+// --------------------------------------------------------------------------- graphql-go/2
+
+// defaultedSchemas: a type system with zd(n: T! = v, in: InD): Int on Query and input InD
+// { x: T! = v }, T a leaf type, v a strict value.
+var defaultedSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	return hegel.FlatMap(leafRefs(s), func(r *hzRef) hegel.Generator[*hzSchema] {
+		return hegel.Map(strictNonNull(s, r, 3), func(v any) *hzSchema {
+			in := &hzInputDef{name: "InD", fields: []*hzInputField{{name: "x", typ: hzNonNullOf(r), def: v}}}
+			return withQueryField(s, &hzFieldDef{name: "zd", typ: hzNamed("Int"), args: []*hzArg{
+				{name: "n", typ: hzNonNullOf(r), def: v},
+				{name: "in", typ: hzNamed("InD"), def: hzNoDefault},
+			}}, in)
+		})
+	})
+})
+
+// defaultedPlacements: the non-null defaulted argument left out (two in four), the
+// non-null defaulted input field left out of a literal object, or of a variable's value;
+// omit says whether it is left out (the shape) or given (past it).
+func defaultedPlacements(s *hzSchema, omit bool) hegel.Generator[opParts] {
+	r := s.field("Query", "zd").args[0].typ.of
+	withX := func(v any) map[string]any {
+		if omit {
+			return map[string]any{}
+		}
+		return map[string]any{"x": v}
+	}
+	return hegel.FlatMap(strictNonNull(s, r, 3), func(v any) hegel.Generator[opParts] {
+		return hzWeighted(
+			hzW(4, hegel.Map(hzCoin(50), func(in bool) opParts {
+				args := []hzArgument{}
+				if !omit {
+					args = append(args, hzArgument{"n", v})
+				}
+				if in {
+					args = append(args, hzArgument{"in", map[string]any{"x": v}})
+				}
+				return opParts{sels: []hzSelection{field("zd", args...)}}
+			})),
+			hzW(2, hegel.Just(opParts{sels: []hzSelection{field("zd", hzArgument{"n", v}, hzArgument{"in", withX(v)})}})),
+			hzW(2, hegel.Map(hzInts(0, 0), func(int) opParts {
+				z := given(variable("z1", hzNamed("InD"), hzNoDefault), withX(v))
+				return opParts{sels: []hzSelection{field("zd", hzArgument{"n", v}, hzArgument{"in", z})}, vars: []*hzVarDef{z}}
+			})),
+		)
+	})
+}
+
+// defaultedCases: a non-null argument or input field with a default left out (the shape:
+// graphql-go rejects the document or the variables). Hit rate 1000 of 1000.
+var defaultedCases = executeCasesOver(defaultedSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, defaultedPlacements(s, hzShaped(true, false)))
+})
+
+func TestHegelExecuteDefaultedNonNullArgumentsAreOptional(t *testing.T) {
+	narrowExecute(t, defaultedCases)
+}
+
+// --------------------------------------------------------------------------- graphql-go/3
+
+// nonNullVarSchemas: a type system with zv(n: T!): Int on Query, T a leaf type.
+var nonNullVarSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	return hegel.Map(leafRefs(s), func(r *hzRef) *hzSchema {
+		return withQueryField(s, &hzFieldDef{name: "zv", typ: hzNamed("Int"), args: []*hzArg{{name: "n", typ: hzNonNullOf(r), def: hzNoDefault}}})
+	})
+})
+
+// defaultedVariables: a variable with a default value, of the non-null type (the shape)
+// or the nullable one (past it, allowed in the non-null position by its default), at the
+// argument of zv or (a Boolean) at @skip/@include on __typename; its runtime value
+// provided (strict) at 50 %.
+func defaultedVariables(s *hzSchema, nonNull bool) hegel.Generator[opParts] {
+	r := s.field("Query", "zv").args[0].typ.of
+	typed := func(r *hzRef) *hzRef {
+		if nonNull {
+			return hzNonNullOf(r)
+		}
+		return r
+	}
+	return hegel.Composite(func(tc hegel.TestCase) opParts {
+		sel := field("zv")
+		vr := r
+		if hegel.Draw(tc, hzCoin(50)) {
+			vr = hzNamed("Boolean")
+			sel = hzSelection{kind: hzTypename, directive: &hzDirective{name: hegel.Draw(tc, hzSampled("skip", "include"))}}
+		}
+		v := variable("z1", typed(vr), hegel.Draw(tc, strictNonNull(s, vr, 3)))
+		if hegel.Draw(tc, hzCoin(50)) {
+			given(v, hegel.Draw(tc, strictNonNull(s, vr, 3)))
+		}
+		if sel.kind == hzTypename {
+			sel.directive.cond = v
+		} else {
+			sel.args = []hzArgument{{"n", v}}
+		}
+		return opParts{sels: []hzSelection{sel}, vars: []*hzVarDef{v}}
+	})
+}
+
+// nonNullDefaultCases: a non-null variable with a default value (the shape: graphql-go
+// rejects the document). Hit rate 1000 of 1000.
+var nonNullDefaultCases = executeCasesOver(nonNullVarSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, defaultedVariables(s, hzShaped(true, false)))
+})
+
+func TestHegelExecuteNonNullVariablesTakeDefaults(t *testing.T) {
+	narrowExecute(t, nonNullDefaultCases)
+}
+
+// --------------------------------------------------------------------------- graphql-go/4
+
+// echoSchemas: a type system with the echo field echoZ(n: T, d: T = v, in: InZ): String on
+// Query and input InZ { x: T = v }, T a leaf type, v a strict value.
+var echoSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	return hegel.FlatMap(leafRefs(s), func(r *hzRef) hegel.Generator[*hzSchema] {
+		return hegel.Map(strictNonNull(s, r, 3), func(v any) *hzSchema {
+			in := &hzInputDef{name: "InZ", fields: []*hzInputField{{name: "x", typ: r, def: v}}}
+			return withQueryField(s, &hzFieldDef{name: "echoZ", typ: hzNamed("String"), echo: true, args: []*hzArg{
+				{name: "n", typ: r, def: hzNoDefault},
+				{name: "d", typ: r, def: v},
+				{name: "in", typ: hzNamed("InZ"), def: hzNoDefault},
+			}}, in)
+		})
+	})
+})
+
+// nullVariables: a variable at the echo field where a default applies: its own default
+// at n, the argument's at d, the input field's inside InZ at in; its runtime value null
+// (the shape) or a strict value or none (past it).
+func nullVariables(s *hzSchema, null bool) hegel.Generator[opParts] {
+	r := s.field("Query", "echoZ").args[0].typ
+	at := func(arg string, define func(v any) *hzVarDef) hegel.Generator[opParts] {
+		return hegel.Map(hzTuple(strictNonNull(s, r, 3), hegel.Map(hzCoin(hzUnless(null, 30)), func(b bool) any { return b })), func(vs []any) opParts {
+			z := define(vs[0])
+			if vs[1] == true {
+				z.provided, z.value = false, nil
+			}
+			return opParts{sels: []hzSelection{field("echoZ", hzArgument{arg, z})}, vars: []*hzVarDef{z}}
+		})
+	}
+	value := func(x any) any {
+		if null {
+			return nil
+		}
+		return x
+	}
+	return hzWeighted(
+		hzW(2, at("n", func(v any) *hzVarDef { return given(variable("z1", r, v), value(v)) })),
+		hzW(2, at("d", func(v any) *hzVarDef { return given(variable("z1", r, hzNoDefault), value(v)) })),
+		hzW(2, at("in", func(v any) *hzVarDef {
+			return given(variable("z1", hzNamed("InZ"), hzNoDefault), map[string]any{"x": value(v)})
+		})),
+	)
+}
+
+// nullVariableCases: a null variable value where graphql-go substitutes a default, shown
+// by an echo field (the shape: the data differs). Hit rate: see the test's comment.
+var nullVariableCases = executeCasesOver(echoSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, nullVariables(s, hzShaped(true, false)))
+})
+
+func TestHegelExecuteNullVariablesStayNull(t *testing.T) { narrowExecute(t, nullVariableCases) }
+
+// --------------------------------------------------------------------------- graphql-go/5
+
+// laxSchemas: a type system with zk(n: T): Int on Query, T a built-in scalar.
+var laxSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	return hegel.Map(hzSampled(hzScalars...), func(name string) *hzSchema {
+		return withQueryField(s, &hzFieldDef{name: "zk", typ: hzNamed("Int"), args: []*hzArg{{name: "n", typ: hzNamed(name), def: hzNoDefault}}})
+	})
+})
+
+// laxValues: a runtime value of a kind graphql-go coerces to the scalar (the table of
+// inputValuesWith's wrongKinds).
+func laxValues(s *hzSchema, r *hzRef) hegel.Generator[any] {
+	_, shaped, _ := wrongKinds(s, r.name, inputOpts{variable: true, sh: operationShapes{laxKind: 1}})
+	return sampledAny(shaped...)
+}
+
+// laxVariables: a variable of the scalar type at zk, its value drawn by values.
+func laxVariables(s *hzSchema, values func(*hzSchema, *hzRef) hegel.Generator[any]) hegel.Generator[opParts] {
+	r := s.field("Query", "zk").args[0].typ
+	return hegel.Map(values(s, r), func(v any) opParts {
+		z := given(variable("z1", r, hzNoDefault), v)
+		return opParts{sels: []hzSelection{field("zk", hzArgument{"n", z})}, vars: []*hzVarDef{z}}
+	})
+}
+
+// pastLax: the region past the shape: a strict runtime value.
+func pastLax(s *hzSchema, r *hzRef) hegel.Generator[any] { return strictNonNull(s, r, 3) }
+
+// laxCases: a variable value of the wrong kind graphql-go coerces (the shape: graphql-core
+// rejects the request, graphql-go executes it). Hit rate: see the test's comment.
+var laxCases = executeCasesOver(laxSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, laxVariables(s, hzShaped(laxValues, pastLax)))
+})
+
+func TestHegelExecuteVariablesOfTheWrongKindAreRejected(t *testing.T) { narrowExecute(t, laxCases) }
+
+// --------------------------------------------------------------------------- graphql-go/6
+
+// bigIntSchemas: a type system with zi(n: Int, l: [Int]): Int on Query.
+var bigIntSchemas = hegel.Map(schemas, func(s *hzSchema) *hzSchema {
+	return withQueryField(s, &hzFieldDef{name: "zi", typ: hzNamed("Int"), args: []*hzArg{
+		{name: "n", typ: hzNamed("Int"), def: hzNoDefault},
+		{name: "l", typ: hzListOf(hzNamed("Int")), def: hzNoDefault},
+	}})
+})
+
+// The Int literals just outside 32 bits (the shape) and at the edges (past it).
+var (
+	bigInts  = sampledAny(2147483648, -2147483649, 4294967296, 3000000000)
+	edgeInts = sampledAny(2147483647, -2147483648, 0)
+)
+
+// intPlacements: the Int literal drawn by ints at the argument n of zi (two in five), in
+// the list l, or as the default of a variable at n (provided an edge value or not).
+func intPlacements(ints hegel.Generator[any]) hegel.Generator[opParts] {
+	return hegel.FlatMap(ints, func(v any) hegel.Generator[opParts] {
+		return hzWeighted(
+			hzW(2, hegel.Just(opParts{sels: []hzSelection{field("zi", hzArgument{"n", v})}})),
+			hzW(2, hegel.Just(opParts{sels: []hzSelection{field("zi", hzArgument{"l", []any{v}})}})),
+			hzW(2, hegel.Map(hzMaybe(50, edgeInts), func(given any) opParts {
+				z := variable("z1", hzNamed("Int"), v)
+				if given != nil {
+					z.provided, z.value = true, given
+				}
+				return opParts{sels: []hzSelection{field("zi", hzArgument{"n", z})}, vars: []*hzVarDef{z}}
+			})),
+		)
+	})
+}
+
+// bigIntCases: an Int literal outside 32 bits (the shape: graphql-core rejects the
+// document, graphql-go executes it). Hit rate: see the test's comment.
+var bigIntCases = executeCasesOver(bigIntSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, intPlacements(hzShaped(bigInts, edgeInts)))
+})
+
+func TestHegelExecuteIntLiteralsAre32Bit(t *testing.T) { narrowExecute(t, bigIntCases) }
+
+// --------------------------------------------------------------------------- graphql-go/7
+
+// twinSchemas: a type system with zt: Int on Query.
+var twinSchemas = hegel.Map(schemas, func(s *hzSchema) *hzSchema {
+	return withQueryField(s, &hzFieldDef{name: "zt", typ: hzNamed("Int")})
+})
+
+// rootTwins: a selection at the root twice, the first with @skip or @include on a
+// Boolean! variable whose value excludes it (the shape) or includes it (past it), the
+// second without: the field zt, __typename, zt inside an inline fragment carrying the
+// directive, or a fragment FZ { zt } spread twice.
+func rootTwins(excluding bool) hegel.Generator[opParts] {
+	zt := hzSelection{kind: hzField, name: "zt"}
+	fz := &hzFragDef{name: "FZ", on: "Query", set: []hzSelection{zt}}
+	pairs := hzWeighted(
+		hzW(2, hegel.Just(opParts{sels: []hzSelection{zt, zt}})),
+		hzW(2, hegel.Just(opParts{sels: []hzSelection{{kind: hzTypename}, {kind: hzTypename}}})),
+		hzW(2, hegel.Just(opParts{sels: []hzSelection{{kind: hzInline, set: []hzSelection{zt}}, zt}})),
+		hzW(2, hegel.Just(opParts{sels: []hzSelection{{kind: hzSpread, frag: fz}, {kind: hzSpread, frag: fz}}, frags: []*hzFragDef{fz}})),
+	)
+	return hegel.Map(hzTuple(hegel.Map(pairs, func(p opParts) any { return p }), hegel.Map(hzSampled("skip", "include"), func(n string) any { return n })), func(vs []any) opParts {
+		p, name := vs[0].(opParts), vs[1].(string)
+		z := given(variable("z1", hzNonNullOf(hzNamed("Boolean")), hzNoDefault), (name == "skip") == excluding)
+		sels := append([]hzSelection{}, p.sels...)
+		sels[0].directive = &hzDirective{name: name, cond: z}
+		return opParts{sels: sels, vars: []*hzVarDef{z}, frags: p.frags}
+	})
+}
+
+// twinCases: a root selection twice, the first excluded by a variable-driven directive
+// (the shape: the key is dropped, the data differs). Hit rate: see the test's comment.
+var twinCases = executeCasesOver(twinSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, rootTwins(hzShaped(true, false)))
+})
+
+func TestHegelExecuteSkippedSelectionsMergeWithTheirTwins(t *testing.T) { narrowExecute(t, twinCases) }
+
+// --------------------------------------------------------------------------- graphql-go/8
+
+// wrappedSchemas: a type system with zw: W on Query, W an object type of the schema in a
+// non-null or list wrapper.
+var wrappedSchemas = hegel.FlatMap(schemas, func(s *hzSchema) hegel.Generator[*hzSchema] {
+	var names []string
+	for _, o := range s.objects {
+		names = append(names, o.name)
+	}
+	return hegel.Map(refs(names, hzWeighted(hzW(2, hegel.Just(hzWrap(hzNonNullOf))), hzW(2, listWrappers))), func(r *hzRef) *hzSchema {
+		return withQueryField(s, &hzFieldDef{name: "zw", typ: r})
+	})
+})
+
+// bareFragments: zw { ... { __typename } } (the shape: no type condition directly under
+// the wrapped field) or zw { ... on W { __typename } } (past it).
+func bareFragments(s *hzSchema, bare bool) hegel.Generator[opParts] {
+	cond := s.field("Query", "zw").typ.named()
+	if bare {
+		cond = ""
+	}
+	return hegel.Map(hzInts(0, 0), func(int) opParts {
+		inner := hzSelection{kind: hzInline, cond: cond, set: []hzSelection{{kind: hzTypename}}}
+		return opParts{sels: []hzSelection{{kind: hzField, name: "zw", alias: "zzw", set: []hzSelection{inner}}}}
+	})
+}
+
+// bareFragmentCases: an inline fragment without a type condition directly under a wrapped
+// field (the shape: graphql-go rejects the document). Hit rate 1000 of 1000.
+var bareFragmentCases = executeCasesOver(wrappedSchemas, func(s *hzSchema) hegel.Generator[*hzOperation] {
+	return around(s, bareFragments(s, hzShaped(true, false)))
+})
+
+func TestHegelExecuteInlineFragmentsNeedNoCondition(t *testing.T) {
+	narrowExecute(t, bareFragmentCases)
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..1c254bc
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,170 @@
+package hegel
+
+// Generators: the root data for a type system (the old hzGenData, drawing imperatively from
+// the test case; part 2b of the rewrite replaces it). The type system comes from the
+// package-level generator schemas (hegel_zoo_schema_test.go), the operations from
+// operationsWith (hegel_zoo_operation_test.go).
+
+import (
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	hzFieldNames = []string{"a", "b", "c", "d", "e", "f", "id", "name", "x", "y", "value", "items"}
+	hzArgNames   = []string{"n", "s", "flag", "in", "list", "id", "e", "f"}
+	hzEnumNames  = []string{"RED", "GREEN", "BLUE", "ALPHA", "beta", "x1", "NORTH"}
+	hzStrings    = []string{"", "a", "hello", "with space", "quote\"d", "back\\slash", "new\nline", "tab\tx", "unicode é中", "0", "-1", "true", "null"}
+	hzDescs      = []string{"a description", "another one", "with \"quotes\"", "two\nlines", "trailing space "}
+)
+
+// --------------------------------------------------------------------------- root data
+
+// hzGenData generates root data for an object type: a map with __typename and a value for
+// each field (mostly of the right kind; a few of the wrong kind, nulls and missing fields).
+func hzGenData(tc hegel.TestCase, s *hzSchema, typeName string, depth int) map[string]any {
+	o := s.object(typeName)
+	m := map[string]any{"__typename": typeName}
+	if hzChance(tc, 3) {
+		delete(m, "__typename")
+	}
+	for _, f := range o.fields {
+		if f.echo || hzChance(tc, 10) {
+			continue // missing: resolves to null
+		}
+		m[f.name] = hzGenOutput(tc, s, f.typ, depth)
+	}
+	return m
+}
+
+func hzGenOutput(tc hegel.TestCase, s *hzSchema, r *hzRef, depth int) any {
+	if r.isNonNull() {
+		if hzChance(tc, 5) {
+			return nil
+		}
+		return hzGenOutput(tc, s, r.of, depth)
+	}
+	if hzChance(tc, 12) {
+		return nil
+	}
+	if r.isList() {
+		if hzChance(tc, 4) {
+			return hzGenOutputLeaf(tc, s, "Int")
+		}
+		n := hzDrawInt(tc, 0, 3)
+		out := make([]any, 0, n)
+		for i := 0; i < n; i++ {
+			out = append(out, hzGenOutput(tc, s, r.of, depth))
+		}
+		return out
+	}
+	if s.isLeaf(r.name) {
+		if hzChance(tc, 18) {
+			return hzGenWrongOutput(tc, s, r.name)
+		}
+		return hzGenOutputLeaf(tc, s, r.name)
+	}
+	if depth <= 0 {
+		return nil
+	}
+	if s.object(r.name) != nil {
+		if hzChance(tc, 3) {
+			return hzGenOutputLeaf(tc, s, "String")
+		}
+		return hzGenData(tc, s, r.name, depth-1)
+	}
+	possible := s.possibleTypes(r.name)
+	if hzChance(tc, 5) || len(possible) == 0 {
+		// A type that is not possible for the abstract type.
+		return hzGenData(tc, s, hzPick(tc, s.objects).name, depth-1)
+	}
+	return hzGenData(tc, s, hzPick(tc, possible), depth-1)
+}
+
+func hzGenOutputLeaf(tc hegel.TestCase, s *hzSchema, name string) any {
+	switch name {
+	case "Int":
+		return hzPick(tc, []int{0, 1, -1, 7, 42, -100, 2147483647, -2147483648})
+	case "Float":
+		if hzChance(tc, 40) {
+			return hzPick(tc, []int{0, 3, -2, 1000})
+		}
+		return hzPick(tc, []float64{0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75})
+	case "String":
+		return hzPick(tc, hzStrings)
+	case "Boolean":
+		return hzChance(tc, 50)
+	case "ID":
+		if hzChance(tc, 30) {
+			return hzPick(tc, []int{1, 42, 0})
+		}
+		return hzPick(tc, []string{"id1", "x", "", "42"})
+	}
+	return hzPick(tc, s.enum(name).values)
+}
+
+// hzGenWrongOutput is a resolved value of the wrong kind for the leaf type. Values marked
+// with a switch are left out while it is on.
+func hzGenWrongOutput(tc hegel.TestCase, s *hzSchema, name string) any {
+	type wrong struct {
+		v      any
+		avoid  *bool
+		reason string
+	}
+	var pool []wrong
+	add := func(v any, avoid *bool, reason string) { pool = append(pool, wrong{v, avoid, reason}) }
+	switch name {
+	case "Int":
+		add("3", nil, "")
+		add(4.0, nil, "")
+		add(true, nil, "")
+		add(2147483648, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(-2147483649, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add("", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		for _, f := range []float64{1.5, -2.25, 0.5, 7.75, 1e-3} {
+			add(f, &HZKnown.intSerializeTruncates, "intSerializeTruncates")
+		}
+	case "Float":
+		add("1.5", nil, "")
+		add(true, nil, "")
+		add("abc", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{1}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(map[string]any{}, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+	case "String":
+		add(1, nil, "")
+		add(true, nil, "")
+		add(1.5, nil, "")
+		add([]any{"a"}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{"a": 1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	case "Boolean":
+		add(1, nil, "")
+		add(0, nil, "")
+		add(2.5, nil, "")
+		for _, v := range []any{"true", "", "x", "false", "0", []any{}, map[string]any{}} {
+			add(v, &HZKnown.boolSerializeLax, "boolSerializeLax")
+		}
+	case "ID":
+		add(1, nil, "")
+		add(true, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(1.5, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add([]any{1}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+		add(map[string]any{}, &HZKnown.stringSerializeAnything, "stringSerializeAnything")
+	default:
+		e := s.enum(name)
+		add("NOPE", &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(1, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(strings.ToLower(e.values[0]), &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add(true, &HZKnown.leafSerializeSilentNull, "leafSerializeSilentNull")
+		add([]any{e.values[0]}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+		add(map[string]any{}, &HZKnown.enumSerializePanics, "enumSerializePanics")
+	}
+	w := hzPick(tc, pool)
+	if w.avoid != nil && *w.avoid {
+		hzAvoid(w.reason)
+		return hzGenOutputLeaf(tc, s, name)
+	}
+	return w.v
+}
diff --git a/hegel/hegel_zoo_idioms_test.go b/hegel/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..e87f5bb
--- /dev/null
+++ b/hegel/hegel_zoo_idioms_test.go
@@ -0,0 +1,159 @@
+package hegel
+
+// The generator idioms the properties share, copied from the go/excelize harness
+// (hegel/hegel_zoo_gen_test.go there; go/bubbles' internal/zootest/gen.go before it) with
+// the hz prefix of this package: hegel-go has no weighted choice, biased coin, tuple or
+// counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the first alternative (excelize measured the first of a 2:18:10
+// choice drawn 40% of the time when another draw precedes or follows it, 7% alone), so the
+// rates are what the collector (ZOO_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzCount("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/hegel/hegel_zoo_intro_shapes_test.go b/hegel/hegel_zoo_intro_shapes_test.go
new file mode 100644
index 0000000..90f9995
--- /dev/null
+++ b/hegel/hegel_zoo_intro_shapes_test.go
@@ -0,0 +1,177 @@
+package hegel
+
+// The shape regions of the recorded introspection bugs (bugs.toml graphql-go/15 and 16) and
+// the narrow properties over them: each region is a generator over the bug's shape with
+// random contents (a type system drawn by schemasWith, adjusted after the draw), judged
+// exactly like the wide property (judgeIntro, with the classifier introShape naming the
+// bug). Every narrow property fails every run by default; under HEGEL_NO_KNOWN=1 its
+// generator is the region next to the shape instead (hzShaped) and the property passes.
+// The hit rates quoted at each region are the collector's mismatches over its cases
+// (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowIntro runs a narrow property: every drawn case through the wide property's judge.
+func narrowIntro(t *testing.T, cases hegel.Generator[introCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeIntro(j, o, c)
+		col.count("cases")
+	})
+}
+
+func introOf(g hegel.Generator[*hzSchema]) hegel.Generator[introCase] {
+	return hegel.Map(g, func(s *hzSchema) introCase { return introCase{schema: s} })
+}
+
+// described: every description present (the shape of 16 absent).
+var described = schemaShapes{blank: 0, typed: true}
+
+// --------------------------------------------------------------------------- graphql-go/15
+
+// typedRefs: a reference to an enum or input object with any wrappers, or to any input
+// type in a list: the types whose default values the introspection prints as fmt strings.
+func typedRefs(s *hzSchema) hegel.Generator[*hzRef] {
+	var named []string
+	for _, e := range s.enums {
+		named = append(named, e.name)
+	}
+	for _, in := range s.inputs {
+		named = append(named, in.name)
+	}
+	return hzWeighted(hzW(7, refs(named, wrappers)), hzW(3, refs(inputNames(s), listWrappers)))
+}
+
+// scalarRefs: a scalar, plain or non-null (the defaults printed right).
+func scalarRefs(s *hzSchema) hegel.Generator[*hzRef] { return refs(hzScalars, plainWrappers) }
+
+// withDefault: a type system of sh with one more default value, other than null, of a type
+// drawn by typesOf: the argument of a new field of a drawn object (dflt(x: T = v): Int) or
+// the field of a new input object (input InD { x: T = v }), both described.
+func withDefault(sh schemaShapes, typesOf func(*hzSchema) hegel.Generator[*hzRef]) hegel.Generator[*hzSchema] {
+	return hegel.FlatMap(schemasWith(sh), func(s *hzSchema) hegel.Generator[*hzSchema] {
+		return hegel.FlatMap(typesOf(s), func(r *hzRef) hegel.Generator[*hzSchema] {
+			return hegel.FlatMap(strictNonNull(s, r.nullable(), 3), func(v any) hegel.Generator[*hzSchema] {
+				return hzWeighted(
+					hzW(2, hegel.Map(hzInts(0, len(s.objects)-1), func(i int) *hzSchema { return withArgDefault(s, i, r, v) })),
+					hzW(2, hegel.Map(hzInts(0, 0), func(int) *hzSchema { return withInputDefault(s, r, v) })),
+				)
+			})
+		})
+	})
+}
+
+// withArgDefault: the schema with the field dflt(x: r = v): Int added to the i-th object.
+func withArgDefault(s *hzSchema, i int, r *hzRef, v any) *hzSchema {
+	out := *s
+	out.objects = append([]*hzObjectDef{}, s.objects...)
+	o := *s.objects[i]
+	o.fields = append(append([]*hzFieldDef{}, o.fields...), &hzFieldDef{
+		name: "dflt", typ: hzNamed("Int"), desc: "a description",
+		args: []*hzArg{{name: "x", typ: r, def: v, desc: "a description"}},
+	})
+	out.objects[i] = &o
+	return &out
+}
+
+// withInputDefault: the schema with the input object InD { x: r = v } added.
+func withInputDefault(s *hzSchema, r *hzRef, v any) *hzSchema {
+	out := *s
+	out.inputs = append(append([]*hzInputDef{}, s.inputs...), &hzInputDef{
+		name: "InD", desc: "a description",
+		fields: []*hzInputField{{name: "x", typ: r, def: v, desc: "a description"}},
+	})
+	return &out
+}
+
+// typedDefaults: a type system with every description present and a default value, other
+// than null, on an argument or input field of an enum, list or input-object type (one added
+// deliberately, the rest at the natural rate). Past the shape: the same with defaults on
+// scalar types only (one added deliberately). Hit rate 1000 of 1000.
+var typedDefaults = hzShaped(
+	introOf(withDefault(described, typedRefs)),
+	introOf(withDefault(schemaShapes{blank: 0, typed: false}, scalarRefs)),
+)
+
+func TestHegelIntrospectionDefaultsAreLiterals(t *testing.T) { narrowIntro(t, typedDefaults) }
+
+// --------------------------------------------------------------------------- graphql-go/16
+
+// descPlace: a place of a description in a type system, and how to blank it.
+type descPlace struct {
+	kind  string
+	blank func()
+}
+
+// descPlaces: every place the introspection reports a description: the types (the objects
+// first: Query is the shrink target), the fields, the arguments, the input fields, the enum
+// values.
+func descPlaces(s *hzSchema) []descPlace {
+	var out []descPlace
+	fields := func(fs []*hzFieldDef) {
+		for _, f := range fs {
+			f := f
+			out = append(out, descPlace{"field", func() { f.desc = "" }})
+			for _, a := range f.args {
+				a := a
+				out = append(out, descPlace{"argument", func() { a.desc = "" }})
+			}
+		}
+	}
+	for _, o := range s.objects {
+		o := o
+		out = append(out, descPlace{"object", func() { o.desc = "" }})
+		fields(o.fields)
+	}
+	for _, it := range s.ifaces {
+		it := it
+		out = append(out, descPlace{"interface", func() { it.desc = "" }})
+		fields(it.fields)
+	}
+	for _, u := range s.unions {
+		u := u
+		out = append(out, descPlace{"union", func() { u.desc = "" }})
+	}
+	for _, e := range s.enums {
+		e := e
+		out = append(out, descPlace{"enum", func() { e.desc = "" }})
+		for i := range e.values {
+			i := i
+			out = append(out, descPlace{"enum value", func() { e.valueDescs[i] = "" }})
+		}
+	}
+	for _, in := range s.inputs {
+		in := in
+		out = append(out, descPlace{"input", func() { in.desc = "" }})
+		for _, f := range in.fields {
+			f := f
+			out = append(out, descPlace{"input field", func() { f.desc = "" }})
+		}
+	}
+	return out
+}
+
+// missingDescriptions: a type system with defaults on scalar types only and every
+// description present but one, in a drawn place (a field inherited from an interface is one
+// place for both). Past the shape: every description present. Hit rate 1000 of 1000.
+var missingDescriptions = hzShaped(
+	introOf(hegel.FlatMap(schemasWith(schemaShapes{blank: 0, typed: false}), func(s *hzSchema) hegel.Generator[*hzSchema] {
+		return hegel.Map(hzSampled(descPlaces(s)...), func(p descPlace) *hzSchema {
+			p.blank()
+			return s
+		})
+	})),
+	introOf(schemasWith(schemaShapes{blank: 0, typed: false})),
+)
+
+func TestHegelIntrospectionMissingDescriptionsAreNull(t *testing.T) {
+	narrowIntro(t, missingDescriptions)
+}
diff --git a/hegel/hegel_zoo_intro_test.go b/hegel/hegel_zoo_intro_test.go
new file mode 100644
index 0000000..560bd9a
--- /dev/null
+++ b/hegel/hegel_zoo_intro_test.go
@@ -0,0 +1,306 @@
+package hegel
+
+// TestHegelIntrospection: the introspection of a generated schema must agree with
+// graphql-core's introspection of the same schema built from SDL. The shapes of the recorded
+// bugs (graphql-go/15: a default value of an enum, list or input-object type printed as a
+// quoted fmt string; graphql-go/16: a missing description reported as "" instead of null) are
+// drawn by the type-system generator and named by introShape before the library is called;
+// under HEGEL_NO_KNOWN=1 they are not drawn (schemaShapes). The narrow properties of
+// hegel_zoo_intro_shapes_test.go share judgeIntro.
+
+import (
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"hegel.dev/go/hegel"
+)
+
+// hzIntroQuery is graphql-core's introspection query without the newer fields (specifiedByURL,
+// isRepeatable, schema description, input value deprecation).
+const hzIntroQuery = `query IntrospectionQuery {
+  __schema {
+    queryType { name } mutationType { name } subscriptionType { name }
+    types { ...FullType }
+  }
+}
+fragment FullType on __Type {
+  kind name description
+  fields(includeDeprecated: true) {
+    name description args { ...InputValue } type { ...TypeRef } isDeprecated deprecationReason
+  }
+  inputFields { ...InputValue }
+  interfaces { ...TypeRef }
+  enumValues(includeDeprecated: true) { name description isDeprecated deprecationReason }
+  possibleTypes { ...TypeRef }
+}
+fragment InputValue on __InputValue { name description type { ...TypeRef } defaultValue }
+fragment TypeRef on __Type {
+  kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType {
+  kind name ofType { kind name ofType { kind name } } } } } } }
+}`
+
+var hzIntLikeRe = regexp.MustCompile(`^-?(0|[1-9][0-9]*)$`)
+
+// hzTypeRefInfo: the innermost kind and name of a TypeRef, and whether a LIST wraps it.
+func hzTypeRefInfo(v any) (kind, name string, list bool) {
+	for {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return
+		}
+		kind, _ = m["kind"].(string)
+		name, _ = m["name"].(string)
+		if kind == "LIST" {
+			list = true
+		}
+		if m["ofType"] == nil {
+			return
+		}
+		v = m["ofType"]
+	}
+}
+
+func hzSortByName(l []any) {
+	sort.Slice(l, func(i, j int) bool {
+		a, _ := l[i].(map[string]any)["name"].(string)
+		b, _ := l[j].(map[string]any)["name"].(string)
+		return a < b
+	})
+}
+
+// hzIntroNormalize makes an introspection result comparable, on both sides alike, by the
+// facts of the model: the introspection types and the directives are left out, lists are
+// sorted by name, the built-in scalars' descriptions are not judged, a default value of null
+// (which the Go API cannot express) counts as none, an integer-like ID default is the same
+// quoted or bare, an interface's own interfaces are not judged.
+func hzIntroNormalize(v any) any {
+	root, ok := v.(map[string]any)
+	if !ok {
+		return v
+	}
+	s, _ := root["__schema"].(map[string]any)
+	types, _ := s["types"].([]any)
+	var kept []any
+	for _, t := range types {
+		tm, _ := t.(map[string]any)
+		name, _ := tm["name"].(string)
+		if strings.HasPrefix(name, "__") {
+			continue
+		}
+		if hzIsScalar(name) {
+			tm["description"] = "not judged"
+		}
+		if tm["kind"] == "INTERFACE" {
+			// Interfaces implementing interfaces (spec 2021) are not judged: graphql-go has none.
+			tm["interfaces"] = nil
+		}
+		for _, k := range []string{"fields", "inputFields", "enumValues", "possibleTypes", "interfaces"} {
+			l, _ := tm[k].([]any)
+			hzSortByName(l)
+			for _, f := range l {
+				fm, _ := f.(map[string]any)
+				if k == "inputFields" {
+					hzIntroNormalizeDefault(fm)
+				}
+				args, _ := fm["args"].([]any)
+				hzSortByName(args)
+				for _, a := range args {
+					am, _ := a.(map[string]any)
+					hzIntroNormalizeDefault(am)
+				}
+			}
+		}
+		kept = append(kept, tm)
+	}
+	hzSortByName(kept)
+	s["types"] = kept
+	return v
+}
+
+// hzIntroNormalizeDefault normalises the defaultValue of an input value (an argument or an
+// input field): null counts as none, an integer-like ID is bare.
+func hzIntroNormalizeDefault(m map[string]any) {
+	if m == nil {
+		return
+	}
+	d, ok := m["defaultValue"].(string)
+	if !ok {
+		return
+	}
+	if d == "null" {
+		m["defaultValue"] = nil
+		return
+	}
+	_, name, list := hzTypeRefInfo(m["type"])
+	if name == "ID" && !list {
+		if u := strings.Trim(d, `"`); hzIntLikeRe.MatchString(u) {
+			m["defaultValue"] = u
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// introCase: the schema introspected.
+type introCase struct {
+	schema *hzSchema
+}
+
+func (c introCase) GoString() string { return "introspection of\n" + hzSDL(c.schema) }
+
+var introCases = hegel.Map(schemas, func(s *hzSchema) introCase { return introCase{schema: s} })
+
+// introShape names the recorded bug whose shape the schema has: graphql-go/15 (an argument
+// or input field of an enum, list or input-object type with a default value other than
+// null, anywhere) before graphql-go/16 (a description missing anywhere the introspection
+// reports one: a type, a field, an argument, an input field, an enum value). The order
+// matters: by default nearly every schema has 16's shape (descriptions at 25 %), so 15 is
+// named wherever it is present, and the wide property's shrunk failure, a schema with no
+// default, is 16.
+func introShape(c introCase) string {
+	s := c.schema
+	typedDefault := func(typ *hzRef, def any) bool {
+		return def != hzNoDefault && def != nil && typedRef(s, typ)
+	}
+	blank := false
+	for _, e := range s.enums {
+		blank = blank || e.desc == ""
+		for i := range e.values {
+			blank = blank || e.valueDesc(i) == ""
+		}
+	}
+	for _, in := range s.inputs {
+		blank = blank || in.desc == ""
+		for _, f := range in.fields {
+			if typedDefault(f.typ, f.def) {
+				return "graphql-go/15"
+			}
+			blank = blank || f.desc == ""
+		}
+	}
+	fields := func(desc string, fs []*hzFieldDef) {
+		blank = blank || desc == ""
+		for _, f := range fs {
+			blank = blank || f.desc == ""
+			for _, a := range f.args {
+				blank = blank || a.desc == ""
+			}
+		}
+	}
+	for _, it := range s.ifaces {
+		fields(it.desc, it.fields)
+	}
+	for _, o := range s.objects {
+		fields(o.desc, o.fields)
+		for _, f := range o.fields {
+			for _, a := range f.args {
+				if typedDefault(a.typ, a.def) {
+					return "graphql-go/15"
+				}
+			}
+		}
+	}
+	for _, u := range s.unions {
+		blank = blank || u.desc == ""
+	}
+	if blank {
+		return "graphql-go/16"
+	}
+	return ""
+}
+
+// judgeIntro judges one case: the shape named, then graphql-go's introspection of the
+// schema against graphql-core's of the SDL, normalised.
+func judgeIntro(j *hzCaseJudge, o *hzOracle, c introCase) {
+	j.Shape(introShape(c))
+	sdl := hzSDL(c.schema)
+	py, err := o.execute(sdl, nil, hzIntroQuery, nil, "")
+	if err != nil {
+		j.ht.Fatalf("oracle: %v", err)
+	}
+	if py.SchemaError != "" {
+		j.ht.Fatalf("graphql-core rejects the SDL: %s\n%s", py.SchemaError, sdl)
+	}
+	schema, err := hzBuild(c.schema)
+	if err != nil {
+		j.ht.Fatalf("NewSchema: %v\nSDL:\n%s", err, sdl)
+	}
+	r := graphql.Do(graphql.Params{Schema: schema, RequestString: hzIntroQuery})
+	if len(r.Errors) > 0 || len(py.Errors) > 0 {
+		j.Fail("errors", "introspection errors: graphql-go %v, graphql-core %v\nSDL:\n%s", r.Errors, py.Errors, sdl)
+		return
+	}
+	gb, _ := hzJSONMarshal(r.Data)
+	g := hzIntroNormalize(hzNormalizeJSON(gb))
+	p := hzIntroNormalize(hzNormalizeJSON(py.Data))
+	if !reflect.DeepEqual(g, p) {
+		j.Fail("introspection", "introspection differs\n%s\nSDL:\n%s", hzFirstDiff(g, p), sdl)
+		return
+	}
+	j.col.count("ok")
+}
+
+func TestHegelIntrospection(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, introCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeIntro(j, o, c)
+		col.count("cases")
+	})
+}
+
+// hzFirstDiff describes the first difference between two normalised JSON values.
+func hzFirstDiff(a, b any) string {
+	var walk func(path string, a, b any) string
+	walk = func(path string, a, b any) string {
+		switch av := a.(type) {
+		case map[string]any:
+			bv, ok := b.(map[string]any)
+			if !ok {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			keys := map[string]bool{}
+			for k := range av {
+				keys[k] = true
+			}
+			for k := range bv {
+				keys[k] = true
+			}
+			sorted := make([]string, 0, len(keys))
+			for k := range keys {
+				sorted = append(sorted, k)
+			}
+			sort.Strings(sorted)
+			for _, k := range sorted {
+				if d := walk(path+"."+k, av[k], bv[k]); d != "" {
+					return d
+				}
+			}
+			return ""
+		case []any:
+			bv, ok := b.([]any)
+			if !ok || len(av) != len(bv) {
+				return fmt.Sprintf("%s: graphql-go %v, graphql-core %v", path, a, b)
+			}
+			for i := range av {
+				if d := walk(fmt.Sprintf("%s[%d]", path, i), av[i], bv[i]); d != "" {
+					return d
+				}
+			}
+			return ""
+		}
+		if !reflect.DeepEqual(a, b) {
+			return fmt.Sprintf("%s: graphql-go %#v, graphql-core %#v", path, a, b)
+		}
+		return ""
+	}
+	return walk("", a, b)
+}
diff --git a/hegel/hegel_zoo_operation_test.go b/hegel/hegel_zoo_operation_test.go
new file mode 100644
index 0000000..d826a22
--- /dev/null
+++ b/hegel/hegel_zoo_operation_test.go
@@ -0,0 +1,882 @@
+package hegel
+
+// The operation generator: a package-level generator constructor of hzOperation records (the
+// selection tree, the variable and fragment definitions) built from the combinators
+// (STYLE.md rule 1) and rendered to text by pure functions, with the ranges and rates of the
+// old hzGenQuery: a budget of 25 field selections, a selection tree three fields deep
+// (fragments nest up to three levels more at each), sets of 1-4 selections (__typename
+// 10 %, a field 50 %, an inline fragment 20 %, a fragment spread 20 %), composite fields at
+// 50 % where the depth allows, aliases at 40 % (always on a field with arguments), the same
+// unaliased leaf field twice at 15 %, fragments reused at 50 %, the type condition left off
+// an inline fragment at 20 %, @skip/@include at 20 % with a literal or (one time in three)
+// a variable condition, arguments present at 65 % (required ones always) as a literal
+// (65 %) or a variable (35 %), variable types non-null at 30 % where the argument is
+// nullable, variable defaults at 30 %, runtime values provided at 92 % (99 % for a non-null
+// type), literal values strict at 90 % and runtime values at 85 % (the rest with wrong
+// kinds at 8 % of the scalar positions and an unknown input field at 6 %), a named
+// operation at 50 % and a second one selected by name at 10 %. The shapes of the recorded
+// operation bugs (graphql-go/1 to 8) are weights of the choices (operationShapes), zero
+// under HEGEL_NO_KNOWN=1; the narrow execution properties and TestHegelValidate draw from
+// operationsWith with their own weights. One deviation from the old rates: a variable
+// default is drawn like an argument literal (strict at 90 %), where the old generator drew
+// it strict always, so that the shape of graphql-go/6 reaches variable defaults.
+//
+// The input values (inputValuesWith) are the one generator for the schema's default values
+// (strictValues: strict, with null at 15 %), the literals of the document and the runtime
+// values of the variables, told apart by inputOpts. The live state of one operation draw
+// (the budget left, the fragments and variables declared so far) is a closure of the
+// operation's Composite, the binding's form of a recursive generator with its bound in the
+// closure (ExampleComposite_recursive); the record is complete when the draw ends and the
+// rendering reads nothing else.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- shapes
+
+// operationShapes: the weights of the recorded bugs' shapes in an operation (bugs.toml
+// graphql-go/1 to 8).
+type operationShapes struct {
+	// nullLiteral is the weight of the null literal at a nullable position of a literal
+	// value (an argument, a list item, an input field, a variable default) against 85 for a
+	// value (15 by default; 0 under HEGEL_NO_KNOWN=1): graphql-go/1, a syntax error.
+	nullLiteral int
+	// omitDefaulted says whether a non-null argument (at 35 %) or input field (at 40 %, in
+	// a literal or in a runtime value) with a default value is left out at the natural rate
+	// of the nullable ones (false under HEGEL_NO_KNOWN=1: always present): graphql-go/2.
+	omitDefaulted bool
+	// nonNullDefault is the weight of a default value on a non-null variable against 70 for
+	// none (30 by default, the nullable variables' rate; 0): graphql-go/3.
+	nonNullDefault int
+	// nullVariable is the weight of a null runtime value where graphql-go substitutes a
+	// default and the data shows it: a variable with a non-null default or at an argument
+	// with one, of an echo field, or a nullable input field with a non-null default inside
+	// such a variable's value; against 85 (15 by default, the plain null's rate; 0):
+	// graphql-go/4.
+	nullVariable int
+	// laxKind is the weight of a runtime value of a kind graphql-go coerces instead of
+	// rejecting (an Int from "3", 1.5 or true; a Float from "1.5" or true; a String or an
+	// ID from a number, a boolean or a list; a Boolean from a string, a number or a list)
+	// beside 92 for a strict value and 8 for a kind both sides reject, where wrong kinds
+	// are drawn (4 by default; 0): graphql-go/5.
+	laxKind int
+	// bigInt is the weight of an Int literal outside 32 bits beside 92 for a strict value
+	// and 8 for a literal of a kind both sides reject, where wrong kinds are drawn (4 by
+	// default; 0): graphql-go/6.
+	bigInt int
+	// twin is the weight of a selection repeated with a variable-driven @skip/@include on
+	// the first copy and none on the second, the variable's value excluding it three times
+	// in four, against 85 for the selection alone and 15 for the plain repeat of an
+	// unaliased leaf field (5 by default; 0). While it is positive a variable condition may
+	// also go on any selection at the natural rate (a repeated response key then meets it);
+	// at 0 every variable condition goes on a freshly aliased field, which no other
+	// selection merges with: graphql-go/7.
+	twin int
+	// bareFragment is the weight of leaving the type condition off an inline fragment
+	// directly under a field of a list or non-null type against 80 for a condition (20 by
+	// default, the rate elsewhere; 0): graphql-go/8.
+	bareFragment int
+}
+
+// executeShapes: the operation shapes at their natural rates, none under HEGEL_NO_KNOWN=1.
+var executeShapes = operationShapes{
+	nullLiteral:    hzUnless(hzNoKnown, 15),
+	omitDefaulted:  !hzNoKnown,
+	nonNullDefault: hzUnless(hzNoKnown, 30),
+	nullVariable:   hzUnless(hzNoKnown, 15),
+	laxKind:        hzUnless(hzNoKnown, 4),
+	bigInt:         hzUnless(hzNoKnown, 4),
+	twin:           hzUnless(hzNoKnown, 5),
+	bareFragment:   hzUnless(hzNoKnown, 20),
+}
+
+// --------------------------------------------------------------------------- input values
+
+// inputOpts says what an input value is for: a literal in the document (an argument or a
+// variable default) or a runtime value of a variable; whether it reaches an echo field,
+// whose resolver shows the coerced value in the data; whether a non-null default value
+// applies at its position (the variable's or the argument's); the weight of a wrong kind
+// beside the strict value (0 for strict values); the shapes drawn.
+type inputOpts struct {
+	variable  bool
+	echo      bool
+	defaulted bool
+	wrong     int
+	sh        operationShapes
+}
+
+// strictInputs: the schema's default values: strict values with null at 15 % in a nullable
+// position (a null default is the same on both sides).
+var strictInputs = inputOpts{sh: operationShapes{nullLiteral: 15}}
+
+// hasDefault: a default value other than none and other than null (the one graphql-go
+// substitutes for a null).
+func hasDefault(def any) bool { return def != hzNoDefault && def != nil }
+
+// inputValuesWith: an input value of the type in the schema for the purpose: null where
+// nullable at its weight (the literal's shape, graphql-go/1; the plain 15 % of a runtime
+// value, or the shape of graphql-go/4 where a non-null default applies and an echo field
+// shows it), a list of 0-3 items or at 25 % a single item that coerces to a list of one,
+// a leaf value from the tables of the old hzGenValue with a wrong kind at the option's
+// weight, an enum value, an input object with its required fields, the nullable ones at
+// 60 %, a non-null one with a default left out at the shape's rate (graphql-go/2) and an
+// unknown field at 6 % where wrong kinds are drawn; a self-referencing input field stops
+// three levels down.
+func inputValuesWith(s *hzSchema, r *hzRef, o inputOpts) hegel.Generator[any] {
+	return inputValuesAt(s, r, o, 3)
+}
+
+func inputValuesAt(s *hzSchema, r *hzRef, o inputOpts, depth int) hegel.Generator[any] {
+	if r.isNonNull() {
+		return inputNonNullAt(s, r.of, o, depth)
+	}
+	null := o.sh.nullLiteral
+	if o.variable {
+		null = 15
+		if o.echo && o.defaulted {
+			null = o.sh.nullVariable
+		}
+	}
+	// Null first: for a literal it is the shape of graphql-go/1, where TestHegelExecute's
+	// shrunk failure is meant to land (STYLE.md rule 3's exception; the weight is 0 under
+	// HEGEL_NO_KNOWN=1, and the value is then first).
+	return hzWeighted(hzW(null, hegel.Just[any](nil)), hzW(85, inputNonNullAt(s, r, o, depth)))
+}
+
+// inputNonNullAt: a value other than null of the (nullable) type.
+func inputNonNullAt(s *hzSchema, r *hzRef, o inputOpts, depth int) hegel.Generator[any] {
+	if r.isList() {
+		item := o
+		item.defaulted = false
+		items := hegel.Map(hzCounted(inputValuesAt(s, r.of, item, depth), 0, 3), func(xs []any) any {
+			if xs == nil {
+				return []any{}
+			}
+			return xs
+		})
+		if r.of.nullable().isList() {
+			return items
+		}
+		return hzWeighted(hzW(75, items), hzW(25, inputNonNullAt(s, r.of.nullable(), item, depth)))
+	}
+	if s.isLeaf(r.name) {
+		rejected, shaped, shape := wrongKinds(s, r.name, o)
+		return withWrongKinds(strictLeaf(s, r.name), o.wrong, rejected, shape, shaped)
+	}
+	in := s.input(r.name)
+	if in == nil {
+		panic("inputValues: unknown input type " + r.name)
+	}
+	return withWrongKinds(objectValues(s, in, o, depth), o.wrong, []any{1, "x", []any{}}, 0, nil)
+}
+
+// withWrongKinds: the strict value (92) beside the kinds both sides reject (at the wrong
+// weight) and the shape's kinds (at the shape's weight), where wrong kinds are drawn.
+func withWrongKinds(strict hegel.Generator[any], wrong int, rejected []any, shape int, shaped []any) hegel.Generator[any] {
+	if wrong == 0 {
+		return strict
+	}
+	choices := []hzChoice[any]{hzW(92, strict)}
+	if len(rejected) > 0 {
+		choices = append(choices, hzW(wrong, sampledAny(rejected...)))
+	}
+	if len(shaped) > 0 && shape > 0 {
+		choices = append(choices, hzW(shape, sampledAny(shaped...)))
+	}
+	return hzWeighted(choices...)
+}
+
+// strictLeaf: the leaf tables of the old hzGenValue.
+func strictLeaf(s *hzSchema, name string) hegel.Generator[any] {
+	switch name {
+	case "Int":
+		return sampledAny(0, 1, -1, 7, 42, -100, 2147483647, -2147483648)
+	case "Float":
+		return hzWeighted(hzW(40, sampledAny(0, 3, -2, 1000)), hzW(60, sampledAny(0.5, -1.25, 3.0, 1e3, 2.5e-3, 123456.75)))
+	case "String":
+		return hegel.Map(hzSampled(hzStrings...), func(v string) any { return v })
+	case "Boolean":
+		return sampledAny(false, true)
+	case "ID":
+		return hzWeighted(hzW(30, sampledAny(1, 42, 0)), hzW(70, sampledAny("id1", "x", "", "42")))
+	}
+	return hegel.Map(hzSampled(s.enum(name).values...), func(v string) any { return hzEnumVal(v) })
+}
+
+// wrongKinds: the values of the wrong kind for the leaf type: those both sides reject, and
+// the shape's with its weight (a runtime value graphql-go coerces, graphql-go/5; an Int
+// literal outside 32 bits, graphql-go/6). Verified one by one against both sides: a runtime
+// 4.0 is an Int on both (Go's JSON prints it 4), a String or ID runtime value spelled like
+// an enum value is a string on both, so neither is wrong; a huge literal beyond int64 and a
+// runtime 2147483648 are rejected on both.
+func wrongKinds(s *hzSchema, name string, o inputOpts) (rejected, shaped []any, shape int) {
+	if o.variable {
+		switch name {
+		case "Int":
+			return []any{2147483648, -2147483649, "abc", []any{1}}, []any{"3", 1.5, true}, o.sh.laxKind
+		case "Float":
+			return []any{"abc", []any{1}, hzEnumVal("RED")}, []any{"1.5", true}, o.sh.laxKind
+		case "String":
+			return nil, []any{1, true, 1.5, []any{"a"}}, o.sh.laxKind
+		case "Boolean":
+			return nil, []any{"true", "x", 1, 0, []any{}}, o.sh.laxKind
+		case "ID":
+			return nil, []any{true, 1.5, []any{1}}, o.sh.laxKind
+		}
+		e := s.enum(name)
+		return []any{hzEnumVal("NOPE"), 1, hzEnumVal(strings.ToLower(e.values[0])), true}, nil, 0
+	}
+	switch name {
+	case "Int":
+		return []any{1.5, "3", true, 4.0}, []any{2147483648, -2147483649}, o.sh.bigInt
+	case "Float":
+		return []any{"1.5", true, hzEnumVal("RED")}, nil, 0
+	case "String":
+		return []any{1, true, 1.5, hzEnumVal("RED")}, nil, 0
+	case "Boolean":
+		return []any{"true", 1, 0}, nil, 0
+	case "ID":
+		return []any{true, 1.5, hzEnumVal("RED")}, nil, 0
+	}
+	e := s.enum(name)
+	return []any{hzEnumVal("NOPE"), e.values[0], 1, hzEnumVal(strings.ToLower(e.values[0]))}, nil, 0
+}
+
+// hzAbsent marks an input field left out of an object value while it is drawn.
+type hzAbsentT struct{}
+
+var hzAbsent = hzAbsentT{}
+
+// objectValues: an input object value: the fields' presence and values in order (a tuple,
+// the fields being independent given the options), as a map.
+func objectValues(s *hzSchema, in *hzInputDef, o inputOpts, depth int) hegel.Generator[any] {
+	absent := hegel.Just[any](hzAbsent)
+	gens := make([]hegel.Generator[any], 0, len(in.fields)+1)
+	for _, f := range in.fields {
+		required := f.typ.isNonNull() && f.def == hzNoDefault
+		if !required && depth <= 0 && s.input(f.typ.named()) != nil {
+			gens = append(gens, absent)
+			continue
+		}
+		fo := o
+		fo.defaulted = hasDefault(f.def)
+		value := inputValuesAt(s, f.typ, fo, depth-1)
+		switch {
+		case required:
+			gens = append(gens, value)
+		case f.typ.isNonNull():
+			// Present first; left out is the shape of graphql-go/2.
+			gens = append(gens, hzWeighted(hzW(60, value), hzW(hzUnless(!o.sh.omitDefaulted, 40), absent)))
+		default:
+			gens = append(gens, hzWeighted(hzW(40, absent), hzW(60, value)))
+		}
+	}
+	unknown := hegel.Just[any](false)
+	if o.wrong > 0 {
+		unknown = hegel.Map(hzCoin(6), func(b bool) any { return b })
+	}
+	gens = append(gens, unknown)
+	return hegel.Map(hzTuple(gens...), func(vs []any) any {
+		m := map[string]any{}
+		for i, f := range in.fields {
+			if _, left := vs[i].(hzAbsentT); !left {
+				m[f.name] = vs[i]
+			}
+		}
+		if vs[len(in.fields)] == true {
+			m["unknown"] = 1
+		}
+		return m
+	})
+}
+
+// literalValues: a literal of the document: strict at 90 %, with wrong kinds at 10 %.
+func literalValues(s *hzSchema, sh operationShapes, r *hzRef) hegel.Generator[any] {
+	return hzWeighted(
+		hzW(90, inputValuesWith(s, r, inputOpts{sh: sh})),
+		hzW(10, inputValuesWith(s, r, inputOpts{sh: sh, wrong: 8})),
+	)
+}
+
+// variableValues: a runtime value of a variable: strict at 85 %, with wrong kinds at 15 %.
+func variableValues(s *hzSchema, sh operationShapes, r *hzRef, echo, defaulted bool) hegel.Generator[any] {
+	return hzWeighted(
+		hzW(85, inputValuesWith(s, r, inputOpts{variable: true, echo: echo, defaulted: defaulted, sh: sh})),
+		hzW(15, inputValuesWith(s, r, inputOpts{variable: true, echo: echo, defaulted: defaulted, sh: sh, wrong: 8})),
+	)
+}
+
+// --------------------------------------------------------------------------- the records
+
+// hzSelKind is the kind of a selection.
+type hzSelKind int
+
+const (
+	hzField    hzSelKind = iota // a field: name, alias, args, directive, set when composite
+	hzTypename                  // __typename: directive
+	hzInline                    // an inline fragment: cond ("" for none), directive, set
+	hzSpread                    // a fragment spread: frag, directive
+)
+
+// hzSelection is one selection of a selection set.
+type hzSelection struct {
+	kind      hzSelKind
+	name      string // the field's name
+	alias     string // the field's alias, "" for none
+	args      []hzArgument
+	directive *hzDirective
+	cond      string        // the inline fragment's type condition, "" for none
+	set       []hzSelection // the selection set of a composite field or an inline fragment
+	frag      *hzFragDef    // the fragment spread, shared between its spreads
+}
+
+// hzArgument is an argument of a field: its value is an input value (a literal: nil, int,
+// float64, string, bool, hzEnumVal, []any, map[string]any; or a *hzVarDef, the variable).
+type hzArgument struct {
+	name  string
+	value any
+}
+
+// hzDirective is @skip or @include with its condition: a bool, or a *hzVarDef.
+type hzDirective struct {
+	name string
+	cond any
+}
+
+// hzVarDef is a variable definition: the type, the default (hzNoDefault for none) and the
+// runtime value, when provided.
+type hzVarDef struct {
+	name     string
+	typ      *hzRef
+	def      any
+	value    any
+	provided bool
+}
+
+// hzFragDef is a fragment definition.
+type hzFragDef struct {
+	name string
+	on   string
+	set  []hzSelection
+}
+
+// hzOperation is a generated operation: the root selection set on Query, the variables and
+// the fragments in the order declared, whether it is named (query Q1), whether a second
+// operation follows it (selected by name), whether an anonymous operation without variables
+// writes the query keyword; and, rendered by hzFinish, the document, the operation name and
+// the variables map (nil when none is provided).
+type hzOperation struct {
+	selections []hzSelection
+	vars       []*hzVarDef
+	fragments  []*hzFragDef
+	named      bool
+	second     bool
+	keyword    bool
+	text       string
+	operation  string
+	variables  map[string]any
+}
+
+// responseKey of a field or __typename selection.
+func (sel *hzSelection) responseKey() string {
+	switch {
+	case sel.kind == hzTypename:
+		return "__typename"
+	case sel.alias != "":
+		return sel.alias
+	}
+	return sel.name
+}
+
+// --------------------------------------------------------------------------- the generator
+
+// operationsFor: the operations of the wide property against the schema.
+func operationsFor(s *hzSchema) hegel.Generator[*hzOperation] {
+	return operationsWith(s, executeShapes)
+}
+
+// opState is the live state of one operation draw: the budget of field selections left,
+// the fragments and variables declared so far (numbered in order), the aliases given.
+type opState struct {
+	budget int
+	frags  []*hzFragDef
+	fragN  int
+	vars   []*hzVarDef
+	aliasN int
+}
+
+// operationsWith: an operation against the schema with the given shape weights.
+func operationsWith(s *hzSchema, sh operationShapes) hegel.Generator[*hzOperation] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzOperation {
+		st := &opState{budget: 25}
+		op := &hzOperation{}
+		op.selections = hegel.Draw(tc, selectionSets(s, sh, st, "Query", 3, 3, false))
+		op.named = hegel.Draw(tc, hzCoin(50))
+		op.second = hegel.Draw(tc, hzCoin(10))
+		op.keyword = hegel.Draw(tc, hzCoin(50))
+		op.fragments, op.vars = st.frags, st.vars
+		return hzFinish(op)
+	})
+}
+
+// selectionSets: a selection set of 1-4 selections on the type (a field's with depth
+// levels of composite fields left and fragDepth levels of fragments, inWrapped when
+// directly under a field of a list or non-null type); __typename alone when the budget
+// leaves none.
+func selectionSets(s *hzSchema, sh operationShapes, st *opState, typeName string, depth, fragDepth int, inWrapped bool) hegel.Generator[[]hzSelection] {
+	return hegel.Map(hzCounted(selections(s, sh, st, typeName, depth, fragDepth, inWrapped), 1, 4), func(groups [][]hzSelection) []hzSelection {
+		var out []hzSelection
+		for _, g := range groups {
+			out = append(out, g...)
+		}
+		if len(out) == 0 {
+			out = []hzSelection{{kind: hzTypename}}
+		}
+		return out
+	})
+}
+
+// selections: one roll of the old selectionSet loop: none once the budget is spent,
+// otherwise a selection (__typename 10 %, a field 50 %, an inline fragment 20 %, a fragment
+// spread 20 %, the fragments only while fragDepth allows) alone, or an unaliased leaf field
+// twice at 15 %, or any selection as twins with a variable condition on the first (the
+// shape of graphql-go/7, at its weight).
+func selections(s *hzSchema, sh operationShapes, st *opState, typeName string, depth, fragDepth int, inWrapped bool) hegel.Generator[[]hzSelection] {
+	one := hzWeighted(
+		hzW(10, typenames(s, sh, st)),
+		hzW(50, fieldSelections(s, sh, st, typeName, depth)),
+		hzW(hzUnless(fragDepth <= 0, 20), inlineFragments(s, sh, st, typeName, depth, fragDepth-1, inWrapped)),
+		hzW(hzUnless(fragDepth <= 0, 20), spreads(s, sh, st, typeName, depth, fragDepth-1)),
+	)
+	twinned := hegel.FlatMap(one, func(sel *hzSelection) hegel.Generator[[]hzSelection] {
+		if sel == nil {
+			return hegel.Just[[]hzSelection](nil)
+		}
+		plain := 0
+		if sel.kind == hzField && sel.alias == "" && sel.set == nil {
+			plain = 15
+		}
+		return hzWeighted(
+			hzW(85, hegel.Just([]hzSelection{*sel})),
+			hzW(plain, hegel.Just([]hzSelection{*sel, *sel})),
+			hzW(sh.twin, twins(st, sel, 3, 1)),
+		)
+	})
+	return hegel.Composite(func(tc hegel.TestCase) []hzSelection {
+		if st.budget <= 0 {
+			return nil
+		}
+		return hegel.Draw(tc, twinned)
+	})
+}
+
+// typenames: a __typename selection with an optional directive.
+func typenames(s *hzSchema, sh operationShapes, st *opState) hegel.Generator[*hzSelection] {
+	return hegel.Map(directives(s, sh, st, sh.twin > 0), func(d *hzDirective) *hzSelection {
+		return &hzSelection{kind: hzTypename, directive: d}
+	})
+}
+
+// fieldSelections: a field of the type: from the composite fields at 50 % where the depth
+// allows, else the leaf fields (all the fields where there is no leaf and depth allows;
+// none where nothing fits), aliased at 40 % or when it has arguments, with its arguments,
+// an optional directive (a variable condition only on an aliased field unless twins are
+// drawn) and, for a composite type, its selection set one level deeper; it spends one of
+// the budget.
+func fieldSelections(s *hzSchema, sh operationShapes, st *opState, typeName string, depth int) hegel.Generator[*hzSelection] {
+	fields := s.fields(typeName)
+	var leaf, composite []*hzFieldDef
+	for _, f := range fields {
+		if s.isLeaf(f.typ.named()) {
+			leaf = append(leaf, f)
+		} else {
+			composite = append(composite, f)
+		}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) *hzSelection {
+		pool := leaf
+		if depth > 0 && len(composite) > 0 && hegel.Draw(tc, hzCoin(50)) {
+			pool = composite
+		}
+		if len(pool) == 0 && depth > 0 {
+			pool = fields
+		}
+		if len(pool) == 0 {
+			return nil
+		}
+		f := hegel.Draw(tc, hzSampled(pool...))
+		st.budget--
+		sel := &hzSelection{kind: hzField, name: f.name}
+		aliased := len(f.args) > 0 || hegel.Draw(tc, hzCoin(40))
+		if aliased {
+			st.aliasN++
+			sel.alias = fmt.Sprintf("f%d", st.aliasN)
+		}
+		sel.args = hegel.Draw(tc, argumentsFor(s, sh, st, f))
+		sel.directive = hegel.Draw(tc, directives(s, sh, st, aliased || sh.twin > 0))
+		if !s.isLeaf(f.typ.named()) {
+			sel.set = hegel.Draw(tc, selectionSets(s, sh, st, f.typ.named(), depth-1, 3, f.typ.of != nil))
+		}
+		return sel
+	})
+}
+
+// conditionsFor: the type conditions applicable to a fragment inside a selection on the
+// type: the type itself, its interfaces and unions (an object), its possible types and the
+// other abstract types sharing one (an abstract type).
+func conditionsFor(s *hzSchema, typeName string) []string {
+	out := []string{typeName}
+	if o := s.object(typeName); o != nil {
+		out = append(out, o.ifaces...)
+		for _, u := range s.unions {
+			for _, m := range u.members {
+				if m == typeName {
+					out = append(out, u.name)
+				}
+			}
+		}
+		return out
+	}
+	out = append(out, s.possibleTypes(typeName)...)
+	for _, i := range s.ifaces {
+		if i.name != typeName && s.overlap(i.name, typeName) {
+			out = append(out, i.name)
+		}
+	}
+	for _, u := range s.unions {
+		if u.name != typeName && s.overlap(u.name, typeName) {
+			out = append(out, u.name)
+		}
+	}
+	return out
+}
+
+// inlineFragments: an inline fragment on a drawn condition, or without one at 20 % (at the
+// shape's weight directly under a wrapped field, graphql-go/8), with an optional directive
+// and its selection set at the same depth.
+func inlineFragments(s *hzSchema, sh operationShapes, st *opState, typeName string, depth, fragDepth int, inWrapped bool) hegel.Generator[*hzSelection] {
+	conds := conditionsFor(s, typeName)
+	bare := 20
+	if inWrapped {
+		bare = sh.bareFragment
+	}
+	return hegel.Composite(func(tc hegel.TestCase) *hzSelection {
+		sel := &hzSelection{kind: hzInline, cond: hegel.Draw(tc, hzSampled(conds...))}
+		if hegel.Draw(tc, hzWeighted(hzW(80, hegel.Just(false)), hzW(bare, hegel.Just(true)))) {
+			sel.cond = ""
+		}
+		sel.directive = hegel.Draw(tc, directives(s, sh, st, sh.twin > 0))
+		on := sel.cond
+		if on == "" {
+			on = typeName
+		}
+		sel.set = hegel.Draw(tc, selectionSets(s, sh, st, on, depth, fragDepth, false))
+		return sel
+	})
+}
+
+// spreads: a fragment spread on a drawn condition: an earlier fragment on it, each at
+// 50 % (the last taken), or a new one (numbered before its body is drawn, declared after,
+// so the body cannot spread it), with an optional directive.
+func spreads(s *hzSchema, sh operationShapes, st *opState, typeName string, depth, fragDepth int) hegel.Generator[*hzSelection] {
+	conds := conditionsFor(s, typeName)
+	return hegel.Composite(func(tc hegel.TestCase) *hzSelection {
+		cond := hegel.Draw(tc, hzSampled(conds...))
+		var frag *hzFragDef
+		for _, fr := range st.frags {
+			if fr.on == cond && hegel.Draw(tc, hzCoin(50)) {
+				frag = fr
+			}
+		}
+		if frag == nil {
+			st.fragN++
+			frag = &hzFragDef{name: fmt.Sprintf("F%d", st.fragN), on: cond}
+			frag.set = hegel.Draw(tc, selectionSets(s, sh, st, cond, depth, fragDepth, false))
+			st.frags = append(st.frags, frag)
+		}
+		return &hzSelection{kind: hzSpread, frag: frag, directive: hegel.Draw(tc, directives(s, sh, st, sh.twin > 0))}
+	})
+}
+
+// directives: no directive at 80 %, else @skip or @include with the condition true, false
+// or, where allowed, a fresh Boolean! variable.
+func directives(s *hzSchema, sh operationShapes, st *opState, allowVar bool) hegel.Generator[*hzDirective] {
+	some := hegel.Composite(func(tc hegel.TestCase) *hzDirective {
+		d := &hzDirective{name: hegel.Draw(tc, hzSampled("skip", "include"))}
+		d.cond = hegel.Draw(tc, hzWeighted(
+			hzW(2, hegel.Just[any](true)),
+			hzW(2, hegel.Just[any](false)),
+			hzW(hzUnless(!allowVar, 2), hegel.Map(boolVariables(s, sh, st), func(v *hzVarDef) any { return v })),
+		))
+		return d
+	})
+	return hzMaybe(20, some)
+}
+
+// boolVariables: a Boolean! variable for a directive: a default at the shape's weight
+// (graphql-go/3), a strict runtime value (false first) provided at 99 %.
+func boolVariables(s *hzSchema, sh operationShapes, st *opState) hegel.Generator[*hzVarDef] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzVarDef {
+		v := &hzVarDef{name: fmt.Sprintf("v%d", len(st.vars)+1), typ: hzNonNullOf(hzNamed("Boolean")), def: hzNoDefault}
+		v.def = hegel.Draw(tc, hzWeighted(hzW(70, hegel.Just[any](hzNoDefault)), hzW(sh.nonNullDefault, sampledAny(false, true))))
+		v.provided = hegel.Draw(tc, provided(true))
+		if v.provided {
+			v.value = hegel.Draw(tc, strictLeaf(s, "Boolean"))
+		}
+		st.vars = append(st.vars, v)
+		return v
+	})
+}
+
+// provided: the runtime value is given (first, the plain case) at 92 %, 99 % for a non-null
+// type.
+func provided(nonNull bool) hegel.Generator[bool] {
+	if nonNull {
+		return hzWeighted(hzW(99, hegel.Just(true)), hzW(1, hegel.Just(false)))
+	}
+	return hzWeighted(hzW(92, hegel.Just(true)), hzW(8, hegel.Just(false)))
+}
+
+// twins: the selection twice, the first copy with @skip or @include on a fresh Boolean!
+// variable (no default, provided) whose value excludes the copy at exclude to include, the
+// second copy without a directive: the shape of graphql-go/7 (an including value is the
+// region next to it).
+func twins(st *opState, sel *hzSelection, exclude, include int) hegel.Generator[[]hzSelection] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzSelection {
+		d := &hzDirective{name: hegel.Draw(tc, hzSampled("skip", "include"))}
+		v := &hzVarDef{name: fmt.Sprintf("v%d", len(st.vars)+1), typ: hzNonNullOf(hzNamed("Boolean")), def: hzNoDefault, provided: true}
+		excluding := d.name == "skip"
+		v.value = hegel.Draw(tc, hzWeighted(hzW(exclude, hegel.Just[any](excluding)), hzW(include, hegel.Just[any](!excluding))))
+		d.cond = v
+		st.vars = append(st.vars, v)
+		first, second := *sel, *sel
+		first.directive, second.directive = d, nil
+		return []hzSelection{first, second}
+	})
+}
+
+// argumentsFor: the arguments of the field in order: a required one always, a non-null one
+// with a default present at 65 % or left out at the shape's rate (graphql-go/2), a nullable
+// one at 65 %; the value a literal at 65 % or a variable at 35 %.
+func argumentsFor(s *hzSchema, sh operationShapes, st *opState, f *hzFieldDef) hegel.Generator[[]hzArgument] {
+	gens := make([]hegel.Generator[[]hzArgument], len(f.args))
+	for i, a := range f.args {
+		a := a
+		value := hzWeighted(
+			hzW(65, hegel.Map(literalValues(s, sh, a.typ), func(v any) []hzArgument { return []hzArgument{{name: a.name, value: v}} })),
+			hzW(35, hegel.Map(variablesFor(s, sh, st, a, f.echo), func(v *hzVarDef) []hzArgument { return []hzArgument{{name: a.name, value: v}} })),
+		)
+		none := hegel.Just[[]hzArgument](nil)
+		switch {
+		case a.typ.isNonNull() && a.def == hzNoDefault:
+			gens[i] = value
+		case a.typ.isNonNull():
+			gens[i] = hzWeighted(hzW(65, value), hzW(hzUnless(!sh.omitDefaulted, 35), none))
+		default:
+			gens[i] = hzWeighted(hzW(35, none), hzW(65, value))
+		}
+	}
+	return hzSeq(gens...)
+}
+
+// variablesFor: a variable declared for the argument: its type the argument's, or non-null
+// at 30 % where the argument is nullable; a default at 30 % (at the shape's weight on a
+// non-null type, graphql-go/3), drawn like a literal; a runtime value provided at 92 %
+// (99 % for a non-null type), null where the data would show a default substituted at the
+// shape's weight (graphql-go/4).
+func variablesFor(s *hzSchema, sh operationShapes, st *opState, a *hzArg, echo bool) hegel.Generator[*hzVarDef] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzVarDef {
+		typ := a.typ
+		if !typ.isNonNull() && hegel.Draw(tc, hzCoin(30)) {
+			typ = hzNonNullOf(typ)
+		}
+		v := &hzVarDef{name: fmt.Sprintf("v%d", len(st.vars)+1), typ: typ, def: hzNoDefault}
+		dw := 30
+		if typ.isNonNull() {
+			dw = sh.nonNullDefault
+		}
+		v.def = hegel.Draw(tc, hzWeighted(hzW(70, hegel.Just[any](hzNoDefault)), hzW(dw, literalValues(s, sh, typ))))
+		v.provided = hegel.Draw(tc, provided(typ.isNonNull()))
+		if v.provided {
+			v.value = hegel.Draw(tc, variableValues(s, sh, typ, echo, echo && (hasDefault(v.def) || hasDefault(a.def))))
+		}
+		st.vars = append(st.vars, v)
+		return v
+	})
+}
+
+// --------------------------------------------------------------------------- rendering
+
+// hzFinish renders the operation: the document, the operation name (Q1 when a second
+// operation follows) and the variables map.
+func hzFinish(op *hzOperation) *hzOperation {
+	op.text = renderOperation(op)
+	op.operation = ""
+	if op.second {
+		op.operation = "Q1"
+	}
+	op.variables = nil
+	for _, v := range op.vars {
+		if v.provided {
+			if op.variables == nil {
+				op.variables = map[string]any{}
+			}
+			op.variables[v.name] = hzGoValue(v.value)
+		}
+	}
+	return op
+}
+
+func renderOperation(op *hzOperation) string {
+	var b strings.Builder
+	switch {
+	case op.named || op.second:
+		b.WriteString("query Q1")
+	case len(op.vars) > 0 || op.keyword:
+		b.WriteString("query")
+	}
+	if len(op.vars) > 0 {
+		parts := make([]string, len(op.vars))
+		for i, v := range op.vars {
+			parts[i] = "$" + v.name + ": " + v.typ.String()
+			if v.def != hzNoDefault {
+				parts[i] += " = " + hzLiteral(v.def)
+			}
+		}
+		b.WriteString("(" + strings.Join(parts, ", ") + ")")
+	}
+	if b.Len() > 0 {
+		b.WriteString(" ")
+	}
+	b.WriteString(renderSet(op.selections))
+	b.WriteString("\n")
+	for _, f := range op.fragments {
+		b.WriteString("fragment " + f.name + " on " + f.on + " " + renderSet(f.set) + "\n")
+	}
+	if op.second {
+		b.WriteString("query Other { __typename }\n")
+	}
+	return b.String()
+}
+
+func renderSet(sels []hzSelection) string {
+	parts := make([]string, len(sels))
+	for i := range sels {
+		parts[i] = renderSelection(&sels[i])
+	}
+	return "{ " + strings.Join(parts, " ") + " }"
+}
+
+func renderSelection(sel *hzSelection) string {
+	switch sel.kind {
+	case hzTypename:
+		return "__typename" + renderDirective(sel.directive)
+	case hzInline:
+		on := ""
+		if sel.cond != "" {
+			on = " on " + sel.cond
+		}
+		return "..." + on + renderDirective(sel.directive) + " " + renderSet(sel.set)
+	case hzSpread:
+		return "..." + sel.frag.name + renderDirective(sel.directive)
+	}
+	out := sel.name
+	if sel.alias != "" {
+		out = sel.alias + ": " + out
+	}
+	if len(sel.args) > 0 {
+		parts := make([]string, len(sel.args))
+		for i, a := range sel.args {
+			parts[i] = a.name + ": " + hzLiteral(a.value)
+		}
+		out += "(" + strings.Join(parts, ", ") + ")"
+	}
+	out += renderDirective(sel.directive)
+	if sel.set != nil {
+		out += " " + renderSet(sel.set)
+	}
+	return out
+}
+
+func renderDirective(d *hzDirective) string {
+	if d == nil {
+		return ""
+	}
+	return " @" + d.name + "(if: " + hzLiteral(d.cond) + ")"
+}
+
+// --------------------------------------------------------------------------- features
+
+// features: the names of the operation's features, for the collector (the old generator's
+// feature counts): alias, __typename, inlineFragment, inlineFragmentNoCondition,
+// fragmentSpread, directive, variableDirective, nullLiteral (an argument's), duplicateField
+// (a response key twice in one set), variable, variableDefault, operationName.
+func features(op *hzOperation) []string {
+	set := map[string]bool{}
+	var walk func(sels []hzSelection)
+	walk = func(sels []hzSelection) {
+		keys := map[string]bool{}
+		for i := range sels {
+			sel := &sels[i]
+			switch sel.kind {
+			case hzField:
+				if sel.alias != "" {
+					set["alias"] = true
+				}
+				for _, a := range sel.args {
+					if a.value == nil {
+						set["nullLiteral"] = true
+					}
+				}
+			case hzTypename:
+				set["__typename"] = true
+			case hzInline:
+				if sel.cond == "" {
+					set["inlineFragmentNoCondition"] = true
+				} else {
+					set["inlineFragment"] = true
+				}
+			case hzSpread:
+				set["fragmentSpread"] = true
+			}
+			if sel.kind == hzField || sel.kind == hzTypename {
+				k := sel.responseKey()
+				if keys[k] {
+					set["duplicateField"] = true
+				}
+				keys[k] = true
+			}
+			if sel.directive != nil {
+				set["directive"] = true
+				if _, ok := sel.directive.cond.(*hzVarDef); ok {
+					set["variableDirective"] = true
+				}
+			}
+			walk(sel.set)
+		}
+	}
+	walk(op.selections)
+	for _, f := range op.fragments {
+		walk(f.set)
+	}
+	for _, v := range op.vars {
+		set["variable"] = true
+		if v.def != hzNoDefault {
+			set["variableDefault"] = true
+		}
+	}
+	if op.second {
+		set["operationName"] = true
+	}
+	out := make([]string, 0, len(set))
+	for k := range set {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..55d028a
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,218 @@
+package hegel
+
+// The graphql-core oracle: one python3 process per test, fed JSON lines
+// {sdl, data, query, variables, operation} and answering with the execution result (data and
+// formatted errors) of the same operation against the same schema and root data.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json
+import graphql
+from graphql import build_schema, graphql_sync, parse, validate
+from graphql.type import GraphQLObjectType
+
+def canonical(v):
+    if v is None:
+        return "null"
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if isinstance(v, float):
+        return "%.4f" % v
+    if isinstance(v, str):
+        return json.dumps(v, ensure_ascii=False)
+    if isinstance(v, (list, tuple)):
+        return "[" + ",".join(canonical(x) for x in v) + "]"
+    if isinstance(v, dict):
+        # graphql-go leaves null-valued input fields out of its maps: absent and null compare equal.
+        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + canonical(v[k]) for k in sorted(v) if v[k] is not None) + "}"
+    return "<" + type(v).__name__ + ">"
+
+def echo(src, info, **args):
+    return canonical(args)
+
+def make_schema(sdl):
+    schema = build_schema(sdl)
+    for name, t in schema.type_map.items():
+        if isinstance(t, GraphQLObjectType) and not name.startswith("__"):
+            t.is_type_of = (lambda n: (lambda v, info: isinstance(v, dict) and v.get("__typename") == n))(name)
+            for fname, f in t.fields.items():
+                if fname.startswith("echo"):
+                    f.resolve = echo
+    return schema
+
+def fmt_error(e):
+    d = {"message": e.message, "path": list(e.path) if e.path else None}
+    d["locations"] = [[l.line, l.column] for l in e.locations] if e.locations else None
+    return d
+
+def main():
+    sys.stdout.write(json.dumps({"hello": True, "version": graphql.__version__, "python": sys.version.split()[0]}) + "\n")
+    sys.stdout.flush()
+    for line in sys.stdin:
+        req = json.loads(line)
+        out = {}
+        try:
+            try:
+                schema = make_schema(req["sdl"])
+            except Exception as e:
+                out["schema_error"] = type(e).__name__ + ": " + str(e)[:400]
+                sys.stdout.write(json.dumps(out) + "\n")
+                sys.stdout.flush()
+                continue
+            mode = req.get("mode", "execute")
+            if mode == "validate":
+                try:
+                    doc = parse(req["query"])
+                except Exception as e:
+                    out["errors"] = [{"message": "syntax: " + str(e)[:300], "path": None, "locations": None}]
+                else:
+                    out["errors"] = [fmt_error(e) for e in validate(schema, doc)]
+            else:
+                r = graphql_sync(schema, req["query"], root_value=req.get("data"),
+                                 variable_values=req.get("variables"), operation_name=req.get("operation"))
+                out["data"] = r.data
+                out["errors"] = [fmt_error(e) for e in (r.errors or [])]
+        except Exception as e:
+            out["fatal"] = repr(e)[:400]
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+main()
+`
+
+type hzOracleError struct {
+	Message   string  `json:"message"`
+	Path      []any   `json:"path"`
+	Locations [][]int `json:"locations"`
+}
+
+type hzOracleReply struct {
+	SchemaError string          `json:"schema_error"`
+	Data        json.RawMessage `json:"data"`
+	Errors      []hzOracleError `json:"errors"`
+	Fatal       string          `json:"fatal"`
+}
+
+type hzOracle struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	hello, err := o.out.ReadString('\n')
+	if err != nil {
+		t.Fatalf("python graphql-core oracle did not start: %v", err)
+	}
+	var h struct {
+		Version string `json:"version"`
+		Python  string `json:"python"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(hello)), &h); err != nil {
+		t.Fatalf("bad oracle greeting %q: %v", hello, err)
+	}
+	t.Logf("oracle: python %s graphql-core %s", h.Python, h.Version)
+	if !strings.HasPrefix(h.Version, "3.") {
+		t.Fatalf("python graphql-core %s is not the 3.x the oracle expects", h.Version)
+	}
+	// Smoke test.
+	r, err := o.execute("type Query { a: Int, echoA(x: Int = 4): String }", map[string]any{"a": 3}, "{ a echoA }", nil, "")
+	if err != nil || r.SchemaError != "" || string(r.Data) != `{"a": 3, "echoA": "{\"x\":4}"}` || len(r.Errors) != 0 {
+		t.Fatalf("python graphql-core oracle not working: %+v %v", r, err)
+	}
+	return o
+}
+
+// execute runs the operation against the schema (SDL) with the root data and variables.
+func (o *hzOracle) execute(sdl string, data any, query string, variables map[string]any, operation string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "execute", "sdl": sdl, "data": data, "query": query, "variables": variables, "operation": hzNilIfEmpty(operation)})
+}
+
+// validate parses and validates the document against the schema (SDL).
+func (o *hzOracle) validate(sdl string, query string) (*hzOracleReply, error) {
+	return o.ask(map[string]any{"mode": "validate", "sdl": sdl, "query": query})
+}
+
+func hzNilIfEmpty(s string) any {
+	if s == "" {
+		return nil
+	}
+	return s
+}
+
+func (o *hzOracle) ask(m map[string]any) (*hzOracleReply, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	req, err := hzJSONMarshal(m)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading oracle reply: %v", err)
+	}
+	var r hzOracleReply
+	if err := json.Unmarshal([]byte(strings.TrimSpace(line)), &r); err != nil {
+		return nil, fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if r.Fatal != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Fatal)
+	}
+	return &r, nil
+}
+
+// hzJSONMarshal is json.Marshal without HTML escaping and without a trailing newline.
+func hzJSONMarshal(v any) ([]byte, error) {
+	var b bytes.Buffer
+	enc := json.NewEncoder(&b)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	return bytes.TrimRight(b.Bytes(), "\n"), nil
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..7bd4bfb
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,255 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the behaviour the GraphQL
+// specification (and graphql-js/graphql-core) gives. They fail while the bug exists and are
+// listed as expected failures in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"github.com/graphql-go/graphql/language/parser"
+	"github.com/graphql-go/graphql/language/source"
+)
+
+// hzPinSchema: Query { echo(n: Int = 5, id: [Int!]! = [1], z: Int, b: Boolean, s: String): String
+// (echo resolves to the canonical JSON of its arguments), a: Int, i: Int, f: Float, str: String,
+// bool: Boolean, d: ID, e: E, n: Int!, l: [Int], name: [O3]!, one: O3 } with O3 { v: Int }.
+func hzPinSchema(t *testing.T) graphql.Schema {
+	t.Helper()
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	o3 := graphql.NewObject(graphql.ObjectConfig{Name: "O3", Fields: graphql.Fields{"v": &graphql.Field{Type: graphql.Int}}})
+	echo := &graphql.Field{Type: graphql.String, Args: graphql.FieldConfigArgument{
+		"n":  &graphql.ArgumentConfig{Type: graphql.Int, DefaultValue: 5},
+		"id": &graphql.ArgumentConfig{Type: graphql.NewNonNull(graphql.NewList(graphql.NewNonNull(graphql.Int))), DefaultValue: []any{1}},
+		"z":  &graphql.ArgumentConfig{Type: graphql.Int},
+		"b":  &graphql.ArgumentConfig{Type: graphql.Boolean},
+		"s":  &graphql.ArgumentConfig{Type: graphql.String},
+	}, Resolve: func(p graphql.ResolveParams) (any, error) { return hzCanonical(p.Args), nil }}
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"echo": echo,
+		"a":    &graphql.Field{Type: graphql.Int},
+		"i":    &graphql.Field{Type: graphql.Int},
+		"f":    &graphql.Field{Type: graphql.Float},
+		"str":  &graphql.Field{Type: graphql.String},
+		"bool": &graphql.Field{Type: graphql.Boolean},
+		"d":    &graphql.Field{Type: graphql.ID},
+		"e":    &graphql.Field{Type: e},
+		"n":    &graphql.Field{Type: graphql.NewNonNull(graphql.Int)},
+		"l":    &graphql.Field{Type: graphql.NewList(graphql.Int)},
+		"name": &graphql.Field{Type: graphql.NewNonNull(graphql.NewList(o3))},
+		"one":  &graphql.Field{Type: o3},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return schema
+}
+
+func hzPinDo(t *testing.T, query string, vars map[string]any, data map[string]any) (*graphql.Result, string) {
+	t.Helper()
+	r := graphql.Do(graphql.Params{Schema: hzPinSchema(t), RequestString: query, VariableValues: vars, RootObject: data})
+	b, _ := hzJSONMarshal(r)
+	return r, string(b)
+}
+
+func hzPinEcho(r *graphql.Result) string {
+	m, _ := r.Data.(map[string]any)
+	s, _ := m["echo"].(string)
+	return s
+}
+
+// graphql-go/1: the null literal is a syntax error.
+func TestHegelPinNullLiteral(t *testing.T) {
+	src := source.NewSource(&source.Source{Body: []byte(`{ echo(z: null) }`)})
+	if _, err := parser.Parse(parser.ParseParams{Source: src}); err != nil {
+		t.Errorf("parsing `{ echo(z: null) }`: %v", err)
+	}
+}
+
+// graphql-go/2: a non-null argument with a default value must still be provided.
+func TestHegelPinNonNullArgDefault(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ echo }` with echo(id: [Int!]! = [1]) gives %s", js)
+	}
+}
+
+// graphql-go/3: a non-null variable with a default value is rejected.
+func TestHegelPinNonNullVariableDefault(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean! = true) { echo(id: 3) @skip(if: $v) }`, nil, nil)
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("query($v: Boolean! = true) gives %s", js)
+	}
+}
+
+// graphql-go/4: a variable given the value null takes its default value, or the argument's.
+func TestHegelPinNullVariableValue(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Int = 7) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":7`) {
+		t.Errorf("$v: Int = 7 given null gives n = 7: %s", js)
+	}
+	r, js = hzPinDo(t, `query($v: Int) { echo(n: $v, id: 3) }`, map[string]any{"v": nil}, nil)
+	if strings.Contains(hzPinEcho(r), `"n":5`) {
+		t.Errorf("$v: Int given null for echo(n: Int = 5) gives n = 5: %s", js)
+	}
+}
+
+// graphql-go/5: variable values of the wrong kind are coerced instead of rejected.
+func TestHegelPinLaxVariableCoercion(t *testing.T) {
+	for _, c := range []struct {
+		query string
+		vars  map[string]any
+	}{
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": "4"}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": 1.5}},
+		{`query($v: Int) { echo(id: 3, z: $v) }`, map[string]any{"v": true}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": "x"}},
+		{`query($v: Boolean) { echo(id: 3, b: $v) }`, map[string]any{"v": []any{}}},
+		{`query($v: String) { echo(id: 3, s: $v) }`, map[string]any{"v": 1}},
+	} {
+		r, js := hzPinDo(t, c.query, c.vars, nil)
+		if len(r.Errors) == 0 {
+			t.Errorf("%s with %s is accepted: %s", c.query, hzCanonical(c.vars), js)
+		}
+	}
+}
+
+// graphql-go/6: an Int literal outside 32 bits is accepted.
+func TestHegelPinIntLiteralRange(t *testing.T) {
+	r, js := hzPinDo(t, `{ echo(id: 3, z: 3000000000) }`, nil, nil)
+	if len(r.Errors) == 0 {
+		t.Errorf("z: 3000000000 for an Int argument is accepted: %s", js)
+	}
+}
+
+// graphql-go/7: a field selected twice is dropped when the first selection is excluded by a
+// variable-driven @skip.
+func TestHegelPinMergedSkipVariable(t *testing.T) {
+	r, js := hzPinDo(t, `query($v: Boolean!) { a @skip(if: $v) a }`, map[string]any{"v": true}, map[string]any{"a": 1})
+	m, _ := r.Data.(map[string]any)
+	if m == nil || m["a"] != 1 {
+		t.Errorf("`a @skip(if: $v) a` with v = true gives %s, without a", js)
+	}
+}
+
+// graphql-go/8: an inline fragment without a type condition under a list-typed field is
+// rejected.
+func TestHegelPinInlineFragmentNoCondition(t *testing.T) {
+	r, js := hzPinDo(t, `{ name { ... { v } } }`, nil, map[string]any{"name": []any{map[string]any{"v": 2}}})
+	if r.Data == nil || len(r.Errors) > 0 {
+		t.Errorf("`{ name { ... { v } } }` with name: [O3]! gives %s", js)
+	}
+}
+
+// graphql-go/9: Enum.Serialize of a slice value panics.
+func TestHegelPinEnumSerializeSlice(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	if r := hzCatch(func() { e.Serialize([]any{"RED"}) }); r != nil {
+		t.Errorf("Enum.Serialize([]any{\"RED\"}) panics: %v", r)
+	}
+}
+
+// graphql-go/10: a leaf value that cannot be serialized becomes null without a field error.
+func TestHegelPinLeafSerializeError(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": "abc"})
+	if len(r.Errors) == 0 {
+		t.Errorf("Int field resolving to \"abc\" gives %s, without an error", js)
+	}
+}
+
+// graphql-go/11: Int serialization truncates a fractional float.
+func TestHegelPinIntTruncation(t *testing.T) {
+	r, js := hzPinDo(t, `{ i }`, nil, map[string]any{"i": 1.5})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["i"] == 1 {
+		t.Errorf("Int field resolving to 1.5 gives %s", js)
+	}
+}
+
+// graphql-go/12: Boolean serialization turns any string but "" and "false" into true.
+func TestHegelPinBooleanString(t *testing.T) {
+	r, js := hzPinDo(t, `{ bool }`, nil, map[string]any{"bool": "x"})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["bool"] == true {
+		t.Errorf("Boolean field resolving to \"x\" gives %s", js)
+	}
+}
+
+// graphql-go/13: String serialization prints a slice with fmt.
+func TestHegelPinStringOfSlice(t *testing.T) {
+	r, js := hzPinDo(t, `{ str }`, nil, map[string]any{"str": []any{"a"}})
+	m, _ := r.Data.(map[string]any)
+	if m != nil && m["str"] == "[a]" {
+		t.Errorf("String field resolving to []any{\"a\"} gives %s", js)
+	}
+}
+
+// graphql-go/14: when a non-null root field is null, the errors of the other root fields are
+// dropped.
+func TestHegelPinRootPropagationErrors(t *testing.T) {
+	r, js := hzPinDo(t, `{ l n }`, nil, map[string]any{"l": 5})
+	if len(r.Errors) != 2 {
+		t.Errorf("`{ l n }` with l = 5 (not a list) and n missing gives %s: the error of l is missing", js)
+	}
+}
+
+// graphql-go/15: introspection prints the default value of an enum, list or input object
+// argument as a quoted fmt string.
+func TestHegelPinIntrospectionDefaultValue(t *testing.T) {
+	e := graphql.NewEnum(graphql.EnumConfig{Name: "E", Values: graphql.EnumValueConfigMap{"RED": &graphql.EnumValueConfig{Value: "RED"}}})
+	q := graphql.NewObject(graphql.ObjectConfig{Name: "Query", Fields: graphql.Fields{
+		"f": &graphql.Field{Type: graphql.Int, Args: graphql.FieldConfigArgument{
+			"e": &graphql.ArgumentConfig{Type: e, DefaultValue: "RED"},
+			"l": &graphql.ArgumentConfig{Type: graphql.NewList(graphql.Int), DefaultValue: []any{1, 2}},
+		}},
+	}})
+	schema, err := graphql.NewSchema(graphql.SchemaConfig{Query: q})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := graphql.Do(graphql.Params{Schema: schema, RequestString: `{ __type(name: "Query") { fields { args { name defaultValue } } } }`})
+	b, _ := hzJSONMarshal(r.Data)
+	js := string(b)
+	if !strings.Contains(js, `"defaultValue":"RED"`) || !strings.Contains(js, `"defaultValue":"[1, 2]"`) {
+		t.Errorf("introspection of e: E = RED and l: [Int] = [1, 2] gives %s", js)
+	}
+}
+
+// graphql-go/16: introspection gives an empty string, not null, for a missing description.
+func TestHegelPinIntrospectionEmptyDescription(t *testing.T) {
+	r, js := hzPinDo(t, `{ __type(name: "O3") { description fields { description } } }`, nil, nil)
+	m, _ := r.Data.(map[string]any)
+	tm, _ := m["__type"].(map[string]any)
+	if tm == nil || tm["description"] != nil {
+		t.Errorf("introspection of a type without a description gives %s", js)
+	}
+}
+
+// graphql-go/17: the same directive twice on one selection passes validation.
+func TestHegelPinDuplicateDirectives(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, `{ a @skip(if: true) @skip(if: false) }`); ok {
+		t.Errorf("`{ a @skip(if: true) @skip(if: false) }` passes validation")
+	}
+}
+
+// graphql-go/18: a type definition in an executable document passes validation.
+func TestHegelPinSDLInExecutable(t *testing.T) {
+	schema := hzPinSchema(t)
+	if ok, _ := hzGoValidate(&schema, "{ a }\ntype Extra { a: Int }"); ok {
+		t.Errorf("a document with a type definition passes validation (and then cannot be executed)")
+	}
+}
+
+// graphql-go/19: a field conflict reached through a fragment spread inside a fragment
+// passes validation.
+func TestHegelPinTransitiveFragmentFieldConflict(t *testing.T) {
+	schema := hzPinSchema(t)
+	doc := "{ y: a ...F2 } fragment F2 on Query { ...F7 } fragment F7 on Query { y: __typename }"
+	if ok, _ := hzGoValidate(&schema, doc); ok {
+		t.Errorf("%s passes validation (y: a and y: __typename conflict through F2 -> F7)", doc)
+	}
+}
