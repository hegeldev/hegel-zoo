@@ -0,0 +1,266 @@
+package hegel
+
+// The shape regions of the recorded validation bugs (bugs.toml graphql-go/17 and 18) and
+// the narrow properties over them: each region is a generated document (the schema and
+// the operation of the wide property) plus one mutation drawn over the bug's shape with
+// random contents, judged exactly like the wide property (judgeValidate, with the
+// classifier validateShape naming the bug). Every narrow property fails every run by
+// default; under HEGEL_NO_KNOWN=1 its mutation is one from the region next to the shape
+// instead (hzShaped) and the property passes. The hit rates quoted at each region are the
+// collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowValidate runs a narrow property: every drawn case through the wide property's judge.
+func narrowValidate(t *testing.T, cases hegel.Generator[validateCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeValidate(j, o, c)
+		col.count("cases")
+	})
+}
+
+// validQueriesFor: the operations against the schema whose unmutated document is valid:
+// an invalid one hides the bug (both sides reject, the verdicts agree), so a narrow case
+// must start from a valid document. graphql-go's own verdict on the unmutated document
+// stands in for the oracle's, which cannot be asked in a generator: on the generated
+// operations the two agree, the verdicts graphql-go gets wrong being the shapes of
+// graphql-go/17 and 18 (absent from an unmutated document) and of 1, 2, 3 and 8 (kept out
+// of the operations by queriesFor's shape weights of zero); the oracle's verdict is what
+// the classifier takes in the property. Measured rejection: see the hit rates below.
+func validQueriesFor(s *hzSchema) hegel.Generator[*hzOperation] {
+	schema, err := hzBuild(s)
+	return hzOnly(true, "base invalid", queriesFor(s), func(op *hzOperation) bool {
+		if err != nil {
+			return false
+		}
+		ok, _ := hzGoValidate(&schema, op.text)
+		return ok
+	})
+}
+
+// narrowCases: a valid generated document plus the one mutation drawn.
+func narrowCases(m hegel.Generator[hzMutation]) hegel.Generator[validateCase] {
+	return casesWith(validQueriesFor, hzOne(m))
+}
+
+// rootLeaf: a leaf field of Query without arguments, or __typename.
+func rootLeaf(s *hzSchema) string {
+	for _, f := range s.fields("Query") {
+		if s.isLeaf(f.typ.named()) && len(f.args) == 0 {
+			return f.name
+		}
+	}
+	return "__typename"
+}
+
+// --------------------------------------------------------------------------- graphql-go/17
+
+// directivePlacement: where the directives go: an inserted root field (aliased zdd, a leaf
+// of Query or __typename), a fragment spread (with its fragment), an inline fragment with
+// a type condition, one without. The operation and a fragment definition are not
+// placements: @skip and @include may not be used there and both sides reject the document
+// for that.
+var directivePlacements = []string{"typename", "leaf", "spread", "inline", "inlineNoCondition"}
+
+// placed inserts the selection of the placement with the directives at the root.
+func placed(s *hzSchema, place, directives, t string) string {
+	switch place {
+	case "typename":
+		return hzInsertRoot(t, "zdd: __typename"+directives)
+	case "leaf":
+		return hzInsertRoot(t, "zdd: "+rootLeaf(s)+directives)
+	case "spread":
+		return hzInsertRoot(t, "...FDup"+directives) + "fragment FDup on Query { __typename }\n"
+	case "inline":
+		return hzInsertRoot(t, "... on Query"+directives+" { __typename }")
+	}
+	return hzInsertRoot(t, "..."+directives+" { __typename }")
+}
+
+// dupDirective: the duplicate-directive mutation drawn: @skip or @include two or three
+// times on one placement, each with a condition true, false or $vdd (a Boolean! variable
+// the mutation declares).
+type dupDirective struct {
+	name  string
+	conds []string
+	place string
+}
+
+func (d dupDirective) apply(s *hzSchema, frags []*hzFragDef, t string) string {
+	var b strings.Builder
+	for _, c := range d.conds {
+		b.WriteString(" @" + d.name + "(if: " + c + ")")
+	}
+	if strings.Contains(b.String(), "$vdd") {
+		t = hzAddVariable(t, "$vdd: Boolean!")
+	}
+	return placed(s, d.place, b.String(), t)
+}
+
+var conditions = hzSampled("true", "false", "$vdd")
+
+var dupDirectives = hegel.Composite(func(tc hegel.TestCase) hzMutation {
+	d := dupDirective{
+		name:  hegel.Draw(tc, hzSampled("skip", "include")),
+		conds: hegel.Draw(tc, hzCounted(conditions, 2, 3)),
+		place: hegel.Draw(tc, hzSampled(directivePlacements...)),
+	}
+	return hzMutation{name: "duplicateDirective", apply: d.apply}
+})
+
+// distinctDirectives: the region past the shape: one directive, or @skip and @include
+// once each in either order, on the same placements (valid on both sides).
+var distinctDirectives = hegel.Composite(func(tc hegel.TestCase) hzMutation {
+	names := hegel.Draw(tc, hzSampled([]string{"skip"}, []string{"include"}, []string{"skip", "include"}, []string{"include", "skip"}))
+	conds := hegel.Draw(tc, hzCounted(conditions, len(names), len(names)))
+	place := hegel.Draw(tc, hzSampled(directivePlacements...))
+	return hzMutation{name: "distinctDirectives", apply: func(s *hzSchema, frags []*hzFragDef, t string) string {
+		var b strings.Builder
+		for i, n := range names {
+			b.WriteString(" @" + n + "(if: " + conds[i] + ")")
+		}
+		if strings.Contains(b.String(), "$vdd") {
+			t = hzAddVariable(t, "$vdd: Boolean!")
+		}
+		return placed(s, place, b.String(), t)
+	}}
+})
+
+// duplicateDirectives: a valid generated document plus a duplicate directive. Hit rate
+// 1000 of 1000.
+var duplicateDirectives = narrowCases(hzShaped[hegel.Generator[hzMutation]](dupDirectives, distinctDirectives))
+
+func TestHegelValidateDirectivesAreUniquePerLocation(t *testing.T) {
+	narrowValidate(t, duplicateDirectives)
+}
+
+// --------------------------------------------------------------------------- graphql-go/18
+
+// sdlDefinition: a type system definition drawn: its kind, name, an optional description,
+// its items (fields, members, values, locations) and whether it goes before the operation
+// or after it.
+type sdlDefinition struct {
+	kind   string
+	name   string
+	desc   string
+	items  []string
+	before bool
+}
+
+func (d sdlDefinition) text() string {
+	var b strings.Builder
+	if d.desc != "" {
+		b.WriteString(hzQuote(d.desc) + " ")
+	}
+	switch d.kind {
+	case "scalar":
+		b.WriteString("scalar " + d.name)
+	case "union":
+		b.WriteString("union " + d.name + " = " + strings.Join(d.items, " | "))
+	case "schema":
+		b.WriteString("schema { " + strings.Join(d.items, " ") + " }")
+	case "directive":
+		b.WriteString("directive @" + d.name + " on " + strings.Join(d.items, " | "))
+	default: // type, interface, enum, input, extend type
+		b.WriteString(d.kind + " " + d.name + " { " + strings.Join(d.items, " ") + " }")
+	}
+	return b.String()
+}
+
+func (d sdlDefinition) apply(s *hzSchema, frags []*hzFragDef, t string) string {
+	if d.before {
+		return d.text() + "\n" + t
+	}
+	return t + d.text() + "\n"
+}
+
+// The kinds graphql-go's parser accepts in an executable document and graphql-core rejects
+// as not executable, with their items. Left out: `extend` of anything but a type (a syntax
+// error in graphql-go: both reject), a description before `schema` or `extend type` (the
+// same: graphql-go's parser takes a description before the other kinds only), an empty
+// body and an unknown directive location (a syntax error in graphql-core), and a schema
+// definition naming an unknown root type (graphql-go's KnownTypeNames rejects it). The
+// names are a mix of fresh ones and the schema's (a definition's name does not matter to
+// either side).
+var (
+	definitionNames = hzSampled("Extra", "X", "Query", "O1", "E1", "In1", "I1", "Int")
+	fieldItems      = hzSampled("a: Int", "b: String", "z: [Int!]!", "o: O1", "x: Extra", "a(n: Int = 1): Int", "a: Int @deprecated", "e: E1")
+	inputItems      = hzSampled("a: Int", "b: String = \"x\"", "c: [Int]", "d: Int = 1")
+	enumItems       = hzSampled("A", "B", "RED")
+	unionItems      = hzSampled("Query", "O1", "Extra")
+	schemaItems     = hzSampled([]string{"query: Query"}, []string{"query: Query", "mutation: Query"})
+	locationItems   = hzSampled("FIELD", "FRAGMENT_SPREAD", "INLINE_FRAGMENT", "QUERY")
+	directiveNames  = hzSampled("d", "skip", "include")
+	definitionDescs = hzMaybe(30, hzSampled("a definition", "with \"quotes\""))
+	noDesc          = hegel.Just("")
+)
+
+// definitionOf: a definition of the kind with 1-2 items from the table and a description
+// from descs.
+func definitionOf(kind string, descs, names hegel.Generator[string], items hegel.Generator[[]string]) hegel.Generator[sdlDefinition] {
+	return hegel.Composite(func(tc hegel.TestCase) sdlDefinition {
+		return sdlDefinition{
+			kind:   kind,
+			desc:   hegel.Draw(tc, descs),
+			name:   hegel.Draw(tc, names),
+			items:  hegel.Draw(tc, items),
+			before: hegel.Draw(tc, hzCoin(30)),
+		}
+	})
+}
+
+func someOf(g hegel.Generator[string]) hegel.Generator[[]string] { return hzCounted(g, 1, 2) }
+
+var sdlDefinitions = hzWeighted(
+	hzW(4, definitionOf("type", definitionDescs, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("interface", definitionDescs, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("union", definitionDescs, definitionNames, someOf(unionItems))),
+	hzW(2, definitionOf("enum", definitionDescs, definitionNames, someOf(enumItems))),
+	hzW(2, definitionOf("input", definitionDescs, definitionNames, someOf(inputItems))),
+	hzW(2, definitionOf("scalar", definitionDescs, definitionNames, hegel.Just[[]string](nil))),
+	hzW(2, definitionOf("schema", noDesc, hegel.Just(""), schemaItems)),
+	hzW(2, definitionOf("extend type", noDesc, definitionNames, someOf(fieldItems))),
+	hzW(2, definitionOf("directive", definitionDescs, directiveNames, someOf(locationItems))),
+)
+
+var sdlInDocuments = hegel.Map(sdlDefinitions, func(d sdlDefinition) hzMutation {
+	return hzMutation{name: "sdlInDocument", apply: d.apply}
+})
+
+// executableDefinitions: the region past the shape: an executable definition beside the
+// operation (a fragment it spreads at the root: valid on both sides), or an extension
+// graphql-go's parser does not accept (`extend` of a schema, interface, union, enum, input
+// or scalar: a syntax error there, not executable to graphql-core: both reject).
+var executableDefinitions = hzWeighted(
+	hzW(2, hegel.Map(hzCoin(30), func(before bool) hzMutation {
+		return hzMutation{name: "extraFragment", apply: func(s *hzSchema, frags []*hzFragDef, t string) string {
+			frag := "fragment FExtra on Query { __typename }\n"
+			t = hzInsertRoot(t, "...FExtra")
+			if before {
+				return frag + t
+			}
+			return t + frag
+		}}
+	})),
+	hzW(2, hegel.Map(hzSampled("extend schema { query: Query }", "extend interface I1 { a: Int }", "extend union U1 = O1", "extend enum E1 { A }", "extend input In1 { a: Int }", "extend scalar X"), func(def string) hzMutation {
+		return hzMutation{name: "unparsedExtension", apply: func(s *hzSchema, frags []*hzFragDef, t string) string { return t + def + "\n" }}
+	})),
+)
+
+// definitionsInDocuments: a valid generated document plus a type system definition of a
+// drawn kind. Hit rate 1000 of 1000.
+var definitionsInDocuments = narrowCases(hzShaped[hegel.Generator[hzMutation]](sdlInDocuments, executableDefinitions))
+
+func TestHegelValidateDefinitionsAreExecutable(t *testing.T) {
+	narrowValidate(t, definitionsInDocuments)
+}
