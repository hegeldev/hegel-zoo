+package casbin_test
+
+// The model: a small universe of subjects, roles, objects, actions and domains, generated model
+// specifications (the shape of the request, policy and role definitions, the effect and the
+// matcher) and generated policies, with an evaluation of Enforce written from the documented
+// semantics (casbin.org, "Syntax for models": policy effects, role hierarchies g(_, _) and
+// g(_, _, _), the built-in matching functions).
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- universe
+
+var (
+	users   = []string{"alice", "bob", "carol", "dave"}
+	roles   = []string{"admin", "editor", "viewer"}
+	actions = []string{"read", "write"}
+	domains = []string{"dom1", "dom2"}
+	// plain objects and resource roles
+	plainObjs = []string{"data1", "data2", "data3"}
+	resRoles  = []string{"data_group1", "data_group2"}
+	// objects and patterns for keyMatch (prefix before *) and keyMatch2 (/* and :param)
+	pathObjs     = []string{"/data1", "/data1/x", "/data1/y", "/data2", "/data2/x/z", "/", "/dat", "/data10"}
+	keyMatchPats = []string{"/data1", "/data1/*", "/data2/*", "/*", "/data1/x", "/dat*", "/data2/x/z", "*"}
+	keyMatch2Pat = []string{"/data1", "/data1/*", "/data2/*", "/*", "/data1/:id", "/:res/x", "/:res", "/:a/:b/z", "/data1/x"}
+)
+
+// objects requested and objects written in policies, per object matching mode
+func (s spec) reqObjs() []string {
+	switch {
+	case s.resRoles:
+		return append(append([]string{}, plainObjs...), resRoles...)
+	case s.objMatch == omEq:
+		return plainObjs
+	default:
+		return pathObjs
+	}
+}
+
+func (s spec) polObjs() []string {
+	switch {
+	case s.resRoles:
+		return append(append([]string{}, plainObjs...), resRoles...)
+	case s.objMatch == omEq:
+		return plainObjs
+	case s.objMatch == omKeyMatch:
+		return keyMatchPats
+	default:
+		return keyMatch2Pat
+	}
+}
+
+// --------------------------------------------------------------------------- spec
+
+const (
+	effAllow    = iota // some(where (p.eft == allow))
+	effDeny            // !some(where (p.eft == deny))
+	effBoth            // some(where (p.eft == allow)) && !some(where (p.eft == deny))
+	effPriority        // priority(p.eft) || deny
+)
+
+const (
+	omEq = iota
+	omKeyMatch
+	omKeyMatch2
+)
+
+var effectText = map[int]string{
+	effAllow:    "some(where (p.eft == allow))",
+	effDeny:     "!some(where (p.eft == deny))",
+	effBoth:     "some(where (p.eft == allow)) && !some(where (p.eft == deny))",
+	effPriority: "priority(p.eft) || deny",
+}
+
+// spec is the shape of a generated model.
+type spec struct {
+	domain   bool // r and p carry a dom field, g = _, _, _
+	rbac     bool // g(r.sub, p.sub[, r.dom]) instead of r.sub == p.sub
+	resRoles bool // g2(r.obj, p.obj) instead of the object match
+	eft      bool // p has an eft field
+	effect   int
+	objMatch int  // when !resRoles
+	root     bool // || r.sub == "root"
+	priority bool // p = priority, ...: explicit priorities, effect priority(p.eft) || deny
+}
+
+func genSpec(tc hegel.TestCase) spec {
+	s := spec{
+		domain:   chance(tc, 40),
+		rbac:     chance(tc, 70),
+		resRoles: chance(tc, 25),
+		eft:      chance(tc, 50),
+		effect:   drawInt(tc, effAllow, effPriority),
+		objMatch: drawInt(tc, omEq, omKeyMatch2),
+		root:     chance(tc, 20),
+	}
+	if !s.eft && s.effect != effAllow && chance(tc, 70) {
+		s.eft = true
+	}
+	if chance(tc, 20) {
+		s.priority, s.eft, s.effect = true, true, effPriority
+	}
+	return s
+}
+
+func (s spec) String() string {
+	return fmt.Sprintf("domain=%v rbac=%v resRoles=%v eft=%v effect=%d objMatch=%d root=%v priority=%v", s.domain, s.rbac, s.resRoles, s.eft, s.effect, s.objMatch, s.root, s.priority)
+}
+
+// reqTokens and polTokens are the fields of r and p.
+func (s spec) reqTokens() []string {
+	t := []string{"sub"}
+	if s.domain {
+		t = append(t, "dom")
+	}
+	return append(t, "obj", "act")
+}
+
+func (s spec) polTokens() []string {
+	t := s.reqTokens()
+	if s.priority {
+		t = append([]string{"priority"}, t...)
+	}
+	if s.eft {
+		t = append(t, "eft")
+	}
+	return t
+}
+
+func (s spec) modelText() string {
+	var b strings.Builder
+	b.WriteString("[request_definition]\nr = " + strings.Join(s.reqTokens(), ", ") + "\n\n")
+	b.WriteString("[policy_definition]\np = " + strings.Join(s.polTokens(), ", ") + "\n\n")
+	if s.rbac || s.resRoles {
+		b.WriteString("[role_definition]\n")
+		// a role definition named g2 is only loaded when g is defined too (the section is read
+		// as g, g2, g3, ... until the first missing key), so g is always written
+		{
+			if s.domain {
+				b.WriteString("g = _, _, _\n")
+			} else {
+				b.WriteString("g = _, _\n")
+			}
+		}
+		if s.resRoles {
+			b.WriteString("g2 = _, _\n")
+		}
+		b.WriteString("\n")
+	}
+	b.WriteString("[policy_effect]\ne = " + effectText[s.effect] + "\n\n")
+	var m []string
+	if s.rbac {
+		if s.domain {
+			m = append(m, "g(r.sub, p.sub, r.dom)")
+		} else {
+			m = append(m, "g(r.sub, p.sub)")
+		}
+	} else {
+		m = append(m, "r.sub == p.sub")
+	}
+	if s.domain {
+		m = append(m, "r.dom == p.dom")
+	}
+	switch {
+	case s.resRoles:
+		m = append(m, "g2(r.obj, p.obj)")
+	case s.objMatch == omKeyMatch:
+		m = append(m, "keyMatch(r.obj, p.obj)")
+	case s.objMatch == omKeyMatch2:
+		m = append(m, "keyMatch2(r.obj, p.obj)")
+	default:
+		m = append(m, "r.obj == p.obj")
+	}
+	m = append(m, "r.act == p.act")
+	mt := strings.Join(m, " && ")
+	if s.root {
+		mt += " || r.sub == \"root\""
+	}
+	b.WriteString("[matchers]\nm = " + mt + "\n")
+	return b.String()
+}
+
+// field indexes of p rules
+func (s spec) subIdx() int {
+	if s.priority {
+		return 1
+	}
+	return 0
+}
+func (s spec) domIdx() int { return s.subIdx() + 1 }
+func (s spec) objIdx() int {
+	if s.domain {
+		return s.subIdx() + 2
+	}
+	return s.subIdx() + 1
+}
+func (s spec) actIdx() int { return s.objIdx() + 1 }
+func (s spec) eftIdx() int { return s.actIdx() + 1 }
+
+// --------------------------------------------------------------------------- generated state
+
+// state is a spec with its policy: p rules, g rules and g2 rules, in order and without duplicates.
+type state struct {
+	spec
+	p  [][]string
+	g  [][]string
+	g2 [][]string
+	// links ClearPolicy left in the role managers (Known.clearPolicyKeepsLinks)
+	staleG, staleG2 [][]string
+	// domains the role manager has seen (Known.staleDomains)
+	seenDoms map[string]bool
+}
+
+// links / links2: the role links the role managers hold: the grouping rules plus stale ones.
+func (st *state) links() [][]string  { return append(append([][]string{}, st.g...), st.staleG...) }
+func (st *state) links2() [][]string { return append(append([][]string{}, st.g2...), st.staleG2...) }
+
+func (st *state) noteDomains() {
+	if st.seenDoms == nil {
+		st.seenDoms = map[string]bool{}
+	}
+	if st.domain {
+		for _, r := range st.g {
+			st.seenDoms[r[2]] = true
+		}
+	}
+}
+
+func (s spec) subjects() []string {
+	out := append(append([]string{}, users...), roles...)
+	return out
+}
+
+// genSubject draws a policy subject: a role (when rbac), a user, or root.
+func (s spec) genSubject(tc hegel.TestCase) string {
+	if s.rbac && chance(tc, 60) {
+		return pick(tc, roles)
+	}
+	if s.root && chance(tc, 10) {
+		return "root"
+	}
+	return pick(tc, users)
+}
+
+func (s spec) genEft(tc hegel.TestCase) string {
+	switch drawInt(tc, 1, 10) {
+	case 1:
+		return pick(tc, []string{"", "maybe", "Allow"})
+	case 2, 3, 4:
+		return "deny"
+	default:
+		return "allow"
+	}
+}
+
+func (s spec) genPRule(tc hegel.TestCase) []string {
+	var r []string
+	if s.priority {
+		r = append(r, strconv.Itoa(drawInt(tc, 1, 3)))
+	}
+	r = append(r, s.genSubject(tc))
+	if s.domain {
+		r = append(r, pick(tc, domains))
+	}
+	r = append(r, pick(tc, s.polObjs()), pick(tc, actions))
+	if s.eft {
+		r = append(r, s.genEft(tc))
+	}
+	return r
+}
+
+// genGRule draws a role link: user or role -> role, with a domain when the spec has one.
+func (s spec) genGRule(tc hegel.TestCase) []string {
+	var from string
+	if chance(tc, 30) {
+		from = pick(tc, roles)
+	} else {
+		from = pick(tc, users)
+	}
+	r := []string{from, pick(tc, roles)}
+	if s.domain {
+		r = append(r, pick(tc, domains))
+	}
+	return r
+}
+
+func (s spec) genG2Rule(tc hegel.TestCase) []string {
+	if chance(tc, 20) {
+		return []string{pick(tc, resRoles), pick(tc, resRoles)}
+	}
+	return []string{pick(tc, plainObjs), pick(tc, resRoles)}
+}
+
+func addUnique(rules [][]string, r []string) ([][]string, bool) {
+	k := strings.Join(r, ",")
+	for _, x := range rules {
+		if strings.Join(x, ",") == k {
+			return rules, false
+		}
+	}
+	return append(rules, r), true
+}
+
+func genState(tc hegel.TestCase) *state { return genStateOpts(tc, true) }
+
+// genStateOpts draws a state; the p rules of a model with explicit priorities are kept in
+// priority order (lowest number first, equal priorities in insertion order), as the enforcer
+// keeps them.
+func genStateOpts(tc hegel.TestCase, allowPriority bool) *state {
+	st := &state{spec: genSpec(tc)}
+	if !allowPriority && st.priority {
+		st.priority, st.eft, st.effect = false, chance(tc, 50), drawInt(tc, effAllow, effPriority)
+	}
+	for i, n := 0, drawInt(tc, 0, 8); i < n; i++ {
+		st.p, _ = addUnique(st.p, st.genPRule(tc))
+	}
+	if st.priority {
+		sort.SliceStable(st.p, func(i, j int) bool {
+			a, _ := strconv.Atoi(st.p[i][0])
+			b, _ := strconv.Atoi(st.p[j][0])
+			return a < b
+		})
+	}
+	if st.rbac {
+		for i, n := 0, drawInt(tc, 0, 6); i < n; i++ {
+			st.g, _ = addUnique(st.g, st.genGRule(tc))
+		}
+	}
+	if st.resRoles {
+		for i, n := 0, drawInt(tc, 0, 4); i < n; i++ {
+			st.g2, _ = addUnique(st.g2, st.genG2Rule(tc))
+		}
+	}
+	return st
+}
+
+func (st *state) String() string {
+	var b strings.Builder
+	b.WriteString(st.spec.String() + "\n")
+	for _, r := range st.p {
+		b.WriteString("p, " + strings.Join(r, ", ") + "\n")
+	}
+	for _, r := range st.g {
+		b.WriteString("g, " + strings.Join(r, ", ") + "\n")
+	}
+	for _, r := range st.g2 {
+		b.WriteString("g2, " + strings.Join(r, ", ") + "\n")
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- requests
+
+type request struct {
+	sub, dom, obj, act string
+}
+
+func (r request) vals(s spec) []interface{} {
+	if s.domain {
+		return []interface{}{r.sub, r.dom, r.obj, r.act}
+	}
+	return []interface{}{r.sub, r.obj, r.act}
+}
+
+func (r request) String() string {
+	return fmt.Sprintf("(%s, %s, %s, %s)", r.sub, r.dom, r.obj, r.act)
+}
+
+// universe returns every request of the small universe: every subject (users, roles, root and
+// a stranger), every domain (plus a stranger) when the spec has domains, every object and
+// action (plus a stranger).
+func (s spec) universe() []request {
+	subs := append(append([]string{}, users...), roles...)
+	subs = append(subs, "root", "nobody")
+	doms := []string{""}
+	if s.domain {
+		doms = append(append([]string{}, domains...), "dom9")
+	}
+	acts := append(append([]string{}, actions...), "exec")
+	var out []request
+	for _, su := range subs {
+		for _, d := range doms {
+			for _, o := range s.reqObjs() {
+				for _, a := range acts {
+					out = append(out, request{su, d, o, a})
+				}
+			}
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- role closure
+
+// closure returns the roles reachable from name over links (from, to[, dom]) whose domain is
+// dom (when withDom), transitively, name itself excluded unless a cycle leads back to it.
+// Casbin's default hierarchy depth is 10 levels; the universe is far smaller.
+func closure(links [][]string, name string, withDom bool, dom string) map[string]bool {
+	seen := map[string]bool{}
+	frontier := []string{name}
+	for depth := 0; depth < 10 && len(frontier) > 0; depth++ {
+		var next []string
+		for _, cur := range frontier {
+			for _, l := range links {
+				if l[0] != cur {
+					continue
+				}
+				if withDom && l[2] != dom {
+					continue
+				}
+				if !seen[l[1]] {
+					seen[l[1]] = true
+					next = append(next, l[1])
+				}
+			}
+		}
+		frontier = next
+	}
+	return seen
+}
+
+// hasLink: name1 inherits name2 (a name inherits itself).
+func hasLink(links [][]string, name1, name2 string, withDom bool, dom string) bool {
+	if name1 == name2 {
+		return true
+	}
+	return closure(links, name1, withDom, dom)[name2]
+}
+
+// --------------------------------------------------------------------------- model enforcement
+
+// modelKeyMatch: key2's part before its first * is a prefix of key1; no * means equality.
+func modelKeyMatch(key1, key2 string) bool {
+	i := strings.Index(key2, "*")
+	if i < 0 {
+		return key1 == key2
+	}
+	return strings.HasPrefix(key1, key2[:i])
+}
+
+// matches evaluates the matcher of the spec for one policy rule and one request.
+func (st *state) matches(rule []string, r request) bool {
+	s := st.spec
+	if s.root && r.sub == "root" {
+		return true
+	}
+	if s.rbac {
+		if !hasLink(st.links(), r.sub, rule[s.subIdx()], s.domain, r.dom) {
+			return false
+		}
+	} else if r.sub != rule[s.subIdx()] {
+		return false
+	}
+	if s.domain && r.dom != rule[s.domIdx()] {
+		return false
+	}
+	switch {
+	case s.resRoles:
+		if !hasLink(st.links2(), r.obj, rule[s.objIdx()], false, "") {
+			return false
+		}
+	case s.objMatch == omKeyMatch:
+		if !modelKeyMatch(r.obj, rule[s.objIdx()]) {
+			return false
+		}
+	case s.objMatch == omKeyMatch2:
+		if !patMatch(tokenize(rule[s.objIdx()], styleColon), r.obj, nil, true) {
+			return false
+		}
+	default:
+		if r.obj != rule[s.objIdx()] {
+			return false
+		}
+	}
+	return r.act == rule[s.actIdx()]
+}
+
+const (
+	eAllow = iota
+	eIndeterminate
+	eDeny
+)
+
+func (st *state) ruleEffect(rule []string) int {
+	if !st.eft {
+		return eAllow
+	}
+	switch rule[st.eftIdx()] {
+	case "allow":
+		return eAllow
+	case "deny":
+		return eDeny
+	}
+	return eIndeterminate
+}
+
+// decide returns the model's decision and the index of the rule EnforceEx should report (-1 for
+// none). With an empty policy the matcher is evaluated once against a rule of empty fields.
+func (st *state) decide(r request) (bool, int) {
+	if len(st.p) == 0 {
+		empty := make([]string, len(st.polTokens()))
+		m := st.matches(empty, r)
+		switch st.effect {
+		case effDeny:
+			return true, -1
+		default:
+			return m, -1
+		}
+	}
+	type mr struct {
+		idx int
+		eft int
+	}
+	var matched []mr
+	for i, rule := range st.p {
+		if st.matches(rule, r) {
+			matched = append(matched, mr{i, st.ruleEffect(rule)})
+		}
+	}
+	first := func(eft int) int {
+		for _, m := range matched {
+			if m.eft == eft {
+				return m.idx
+			}
+		}
+		return -1
+	}
+	switch st.effect {
+	case effAllow:
+		i := first(eAllow)
+		return i >= 0, i
+	case effDeny:
+		i := first(eDeny)
+		return i < 0, i
+	case effBoth:
+		if i := first(eDeny); i >= 0 {
+			return false, i
+		}
+		i := first(eAllow)
+		return i >= 0, i
+	default: // priority: the first matched rule with a determinate effect decides
+		for _, m := range matched {
+			if m.eft != eIndeterminate {
+				return m.eft == eAllow, m.idx
+			}
+		}
+		return false, -1
+	}
+}
+
+// --------------------------------------------------------------------------- pattern matching
+
+// The documented pattern languages of keyMatch2..5 and keyGet2/3: "/*" matches anything to the
+// end (including further slashes), ":name" (keyMatch2, keyGet2) and "{name}" (keyMatch3..5,
+// keyGet3) match one or more characters other than "/", everything else is literal. keyMatch4
+// requires repeated names to match the same text; keyMatch5 drops the query string of key1.
+
+const (
+	tLit = iota
+	tStar
+	tParam
+)
+
+type ptok struct {
+	kind int
+	lit  byte
+	name string
+}
+
+const (
+	styleNone = iota
+	styleColon
+	styleBrace
+)
+
+func tokenize(pat string, style int) []ptok {
+	var out []ptok
+	for i := 0; i < len(pat); {
+		c := pat[i]
+		switch {
+		case c == '/' && i+1 < len(pat) && pat[i+1] == '*':
+			out = append(out, ptok{kind: tLit, lit: '/'}, ptok{kind: tStar})
+			i += 2
+		case style == styleColon && c == ':' && i+1 < len(pat) && pat[i+1] != '/':
+			j := i + 1
+			for j < len(pat) && pat[j] != '/' {
+				j++
+			}
+			out = append(out, ptok{kind: tParam, name: pat[i+1 : j]})
+			i = j
+		case style == styleBrace && c == '{':
+			j := strings.IndexByte(pat[i:], '}')
+			if j > 1 && !strings.Contains(pat[i:i+j], "/") {
+				out = append(out, ptok{kind: tParam, name: pat[i+1 : i+j]})
+				i += j + 1
+				continue
+			}
+			out = append(out, ptok{kind: tLit, lit: c})
+			i++
+		default:
+			out = append(out, ptok{kind: tLit, lit: c})
+			i++
+		}
+	}
+	return out
+}
+
+// patMatch matches s against the tokens; bind (may be nil) collects the first binding of each
+// parameter name and, when checkRepeat, a repeated name must bind the same text. Parameters are
+// tried longest-first when greedy, shortest-first otherwise, mirroring the regexps' preference.
+func patMatch(toks []ptok, s string, bind map[string]string, greedy bool) bool {
+	return patMatchFrom(toks, s, bind, greedy, false)
+}
+
+func patMatchFrom(toks []ptok, s string, bind map[string]string, greedy bool, checkRepeat bool) bool {
+	if len(toks) == 0 {
+		return s == ""
+	}
+	t := toks[0]
+	switch t.kind {
+	case tLit:
+		return len(s) > 0 && s[0] == t.lit && patMatchFrom(toks[1:], s[1:], bind, greedy, checkRepeat)
+	case tStar:
+		for n := len(s); n >= 0; n-- {
+			if patMatchFrom(toks[1:], s[n:], bind, greedy, checkRepeat) {
+				return true
+			}
+		}
+		return false
+	default:
+		max := strings.IndexByte(s, '/')
+		if max < 0 {
+			max = len(s)
+		}
+		try := func(n int) bool {
+			val := s[:n]
+			if bind != nil {
+				old, had := bind[t.name]
+				if had && checkRepeat && old != val {
+					return false
+				}
+				if !had {
+					bind[t.name] = val
+				}
+				ok := patMatchFrom(toks[1:], s[n:], bind, greedy, checkRepeat)
+				if !ok && !had {
+					delete(bind, t.name)
+				}
+				return ok
+			}
+			return patMatchFrom(toks[1:], s[n:], bind, greedy, checkRepeat)
+		}
+		if greedy {
+			for n := max; n >= 1; n-- {
+				if try(n) {
+					return true
+				}
+			}
+		} else {
+			for n := 1; n <= max; n++ {
+				if try(n) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+}
