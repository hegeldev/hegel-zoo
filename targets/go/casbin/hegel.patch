+					st.p = append(st.p, r)
+				}
+			}
+			return got, true, err
+		}}
+	case "RemovePolicy":
+		r := pRule()
+		return op{fmt.Sprintf("RemovePolicy(%v)", r), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.RemovePolicy(toAny(r)...)
+			var want bool
+			st.p, want = removeRule(st.p, r)
+			return got, want, err
+		}}
+	case "RemovePolicies":
+		rs := pRules()
+		return op{fmt.Sprintf("RemovePolicies(%s)", strs(rs)), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.RemovePolicies(rs)
+			want := false
+			for _, r := range rs {
+				var ok bool
+				st.p, ok = removeRule(st.p, r)
+				want = want || ok
+			}
+			return got, want, err
+		}}
+	case "RemoveFilteredPolicy":
+		idx, vals := filter(len(st.polTokens()), st.p)
+		return op{fmt.Sprintf("RemoveFilteredPolicy(%d, %q)", idx, vals), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.RemoveFilteredPolicy(idx, vals...)
+			var removed [][]string
+			st.p, removed = removeFiltered(st.p, idx, vals)
+			return got, len(removed) > 0, err
+		}}
+	case "UpdatePolicy":
+		old, nu := pRule(), pRule()
+		if Known.updateKeepsDuplicate && hasRule(st.p, nu) && strings.Join(nu, ",") != strings.Join(old, ",") {
+			// an update to a rule that exists leaves a duplicate: not generated while the bug is there
+			return noOp("UpdatePolicy skipped")
+		}
+		return op{fmt.Sprintf("UpdatePolicy(%v, %v)", old, nu), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.UpdatePolicy(old, nu)
+			var want bool
+			st.p, want = updateRule(st.p, old, nu)
+			return got, want, err
+		}}
+	case "UpdatePolicies":
+		olds := pRules()
+		var nus [][]string
+		for range olds {
+			nus = append(nus, pRule())
+		}
+		if Known.updateKeepsDuplicate {
+			for i, nu := range nus {
+				if hasRule(st.p, nu) || hasRule(nus[:i], nu) || hasRule(olds, nu) {
+					return noOp("UpdatePolicies skipped")
+				}
+			}
+		}
+		return op{fmt.Sprintf("UpdatePolicies(%s -> %s)", strs(olds), strs(nus)), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.UpdatePolicies(olds, nus)
+			// all or nothing
+			tmp := st.p
+			for i, old := range olds {
+				var ok bool
+				if tmp, ok = updateRule(tmp, old, nus[i]); !ok {
+					return got, false, err
+				}
+			}
+			st.p = tmp
+			return got, true, err
+		}}
+	case "UpdateFilteredPolicies":
+		idx, vals := filter(len(st.polTokens()), st.p)
+		nus := pRules()
+		return op{fmt.Sprintf("UpdateFilteredPolicies(%s, %d, %q)", strs(nus), idx, vals), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.UpdateFilteredPolicies(nus, idx, vals...)
+			var removed [][]string
+			if Known.updateFilteredAddsOnly {
+				// nothing is removed and false is returned; the new rules are added all the same
+				for _, r := range nus {
+					if !hasRule(st.p, r) {
+						st.p = append(st.p, r)
+					}
+				}
+				return got, false, err
+			}
+			st.p, removed = removeFiltered(st.p, idx, vals)
+			for _, r := range nus {
+				if !hasRule(st.p, r) {
+					st.p = append(st.p, r)
+				}
+			}
+			return got, len(removed) > 0, err
+		}}
+	case "DeletePermission":
+		r := pRule()
+		n := drawInt(tc, 1, len(r)-1)
+		perm := r[1 : 1+n]
+		return op{fmt.Sprintf("DeletePermission(%q)", perm), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeletePermission(perm...)
+			var removed [][]string
+			st.p, removed = removeFiltered(st.p, 1, perm)
+			return got, len(removed) > 0, err
+		}}
+	case "DeletePermissionsForUser":
+		u := pRule()[0]
+		return op{fmt.Sprintf("DeletePermissionsForUser(%s)", u), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeletePermissionsForUser(u)
+			var removed [][]string
+			st.p, removed = removeFiltered(st.p, 0, []string{u})
+			return got, len(removed) > 0, err
+		}}
+	case "DeleteUser":
+		u := pick(tc, append(append([]string{}, users...), roles...))
+		return op{fmt.Sprintf("DeleteUser(%s)", u), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeleteUser(u)
+			if !hasG && Known.deleteUserNeedsG && err != nil && strings.Contains(err.Error(), "missing required section g") {
+				return got, got, nil // fails before touching the rules
+			}
+			var r1, r2 [][]string
+			if hasG {
+				st.g, r1 = removeFiltered(st.g, 0, []string{u})
+			}
+			st.p, r2 = removeFiltered(st.p, 0, []string{u})
+			return got, len(r1)+len(r2) > 0, err
+		}}
+	case "ClearPolicy":
+		return op{"ClearPolicy()", func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			e.ClearPolicy()
+			if Known.clearPolicyKeepsLinks {
+				st.staleG = append(st.staleG, st.g...)
+				st.staleG2 = append(st.staleG2, st.g2...)
+			}
+			st.p, st.g, st.g2 = nil, nil, nil
+			return true, true, nil
+		}}
+	case "AddGroupingPolicy", "AddRoleForUser":
+		r := gRule()
+		return op{fmt.Sprintf("%s(%v)", kind, r), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			var got bool
+			var err error
+			if kind == "AddRoleForUser" {
+				got, err = e.AddRoleForUser(r[0], r[1], r[2:]...)
+			} else {
+				got, err = e.AddGroupingPolicy(toAny(r)...)
+			}
+			want := !hasRule(st.g, r)
+			if want {
+				st.g = append(st.g, r)
+			}
+			return got, want, err
+		}}
+	case "AddGroupingPolicies":
+		var rs [][]string
+		for i, n := 0, drawInt(tc, 1, 3); i < n; i++ {
+			rs = append(rs, gRule())
+		}
+		return op{fmt.Sprintf("AddGroupingPolicies(%s)", strs(rs)), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.AddGroupingPolicies(rs)
+			for _, r := range rs {
+				if hasRule(st.g, r) {
+					return got, false, err
+				}
+			}
+			for _, r := range rs {
+				if !hasRule(st.g, r) {
+					st.g = append(st.g, r)
+				}
+			}
+			return got, true, err
+		}}
+	case "RemoveGroupingPolicy", "DeleteRoleForUser":
+		r := gRule()
+		return op{fmt.Sprintf("%s(%v)", kind, r), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			var got bool
+			var err error
+			if kind == "DeleteRoleForUser" {
+				got, err = e.DeleteRoleForUser(r[0], r[1], r[2:]...)
+			} else {
+				got, err = e.RemoveGroupingPolicy(toAny(r)...)
+			}
+			var want bool
+			st.g, want = removeRule(st.g, r)
+			return got, want, err
+		}}
+	case "RemoveGroupingPolicies":
+		var rs [][]string
+		for i, n := 0, drawInt(tc, 1, 3); i < n; i++ {
+			rs = append(rs, gRule())
+		}
+		return op{fmt.Sprintf("RemoveGroupingPolicies(%s)", strs(rs)), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.RemoveGroupingPolicies(rs)
+			want := false
+			for _, r := range rs {
+				var ok bool
+				st.g, ok = removeRule(st.g, r)
+				want = want || ok
+			}
+			return got, want, err
+		}}
+	case "RemoveFilteredGroupingPolicy":
+		idx, vals := filter(len(st.g[0:0])+2+boolInt(st.domain), st.g)
+		return op{fmt.Sprintf("RemoveFilteredGroupingPolicy(%d, %q)", idx, vals), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.RemoveFilteredGroupingPolicy(idx, vals...)
+			var removed [][]string
+			st.g, removed = removeFiltered(st.g, idx, vals)
+			return got, len(removed) > 0, err
+		}}
+	case "UpdateGroupingPolicy":
+		old, nu := gRule(), gRule()
+		if Known.updateKeepsDuplicate && hasRule(st.g, nu) && strings.Join(nu, ",") != strings.Join(old, ",") {
+			return noOp("UpdateGroupingPolicy skipped")
+		}
+		return op{fmt.Sprintf("UpdateGroupingPolicy(%v, %v)", old, nu), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.UpdateGroupingPolicy(old, nu)
+			var want bool
+			st.g, want = updateRule(st.g, old, nu)
+			return got, want, err
+		}}
+	case "DeleteRolesForUser":
+		u := gRule()[0]
+		var d []string
+		if st.domain {
+			d = []string{pick(tc, domains)}
+		}
+		return op{fmt.Sprintf("DeleteRolesForUser(%s, %v)", u, d), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeleteRolesForUser(u, d...)
+			var removed [][]string
+			if st.domain {
+				st.g, removed = removeFiltered(st.g, 0, []string{u, "", d[0]})
+			} else {
+				st.g, removed = removeFiltered(st.g, 0, []string{u})
+			}
+			return got, len(removed) > 0, err
+		}}
+	case "DeleteRolesForUserInDomain":
+		u, d := gRule()[0], pick(tc, domains)
+		return op{fmt.Sprintf("DeleteRolesForUserInDomain(%s, %s)", u, d), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeleteRolesForUserInDomain(u, d)
+			var removed [][]string
+			st.g, removed = removeFiltered(st.g, 0, []string{u, "", d})
+			return got, len(removed) > 0, err
+		}}
+	case "DeleteRole":
+		r := pick(tc, roles)
+		return op{fmt.Sprintf("DeleteRole(%s)", r), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			got, err := e.DeleteRole(r)
+			var r1, r2, r3 [][]string
+			st.g, r1 = removeFiltered(st.g, 0, []string{r})
+			st.g, r2 = removeFiltered(st.g, 1, []string{r})
+			st.p, r3 = removeFiltered(st.p, 0, []string{r})
+			return got, len(r1)+len(r2)+len(r3) > 0, err
+		}}
+	case "DeleteAllUsersByDomain", "DeleteDomains":
+		d := pick(tc, append(append([]string{}, domains...), "dom9"))
+		return op{fmt.Sprintf("%s(%s)", kind, d), func(e *casbin.Enforcer, st *state) (bool, bool, error) {
+			var got bool
+			var err error
+			if kind == "DeleteDomains" {
+				got, err = e.DeleteDomains(d)
+				// the domain's role manager is dropped, stale links included
+				st.staleG, _ = removeFiltered(st.staleG, 2, []string{d})
+				delete(st.seenDoms, d)
+			} else {
+				got, err = e.DeleteAllUsersByDomain(d)
+			}
+			st.g, _ = removeFiltered(st.g, 2, []string{d})
+			st.p, _ = removeFiltered(st.p, st.domIdx(), []string{d})
+			return got, true, err
+		}}
+	}
+	panic("unknown op " + kind)
+}
+
+// noOp is an operation that does nothing (a draw the known bugs rule out).
+func noOp(name string) op {
+	return op{name, func(e *casbin.Enforcer, st *state) (bool, bool, error) { return true, true, nil }}
+}
+
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// --------------------------------------------------------------------------- property
+
+// TestHegelMutationsAgreeWithModel: a sequence of management and RBAC API mutations returns what
+// the documented semantics say (added / removed / updated or not), leaves the policy the model
+// has, without duplicate rules, and afterwards Enforce and the implicit roles agree with the
+// model, so the role links were maintained incrementally.
+func TestHegelMutationsAgreeWithModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		st := genStateOpts(ht, false) // explicit priorities reorder the policy on insertion
+		e, err := newEnforcer(st)
+		if err != nil {
+			c.failClass(ht, "build", "%v\n%s", err, st)
+			return
+		}
+		start := st.String()
+		st.noteDomains()
+		var trace []string
+		for i, n := 0, drawInt(ht, 1, 10); i < n; i++ {
+			st.noteDomains()
+			o := genOp(ht, st)
+			trace = append(trace, o.name)
+			var got, want bool
+			var err error
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						err = fmt.Errorf("panic: %v", r)
+					}
+				}()
+				got, want, err = o.run(e, st)
+			}()
+			if err != nil {
+				c.failClass(ht, "error "+strings.SplitN(o.name, "(", 2)[0], "%s: %v\nstart:\n%s\ntrace: %s", o.name, err, start, strings.Join(trace, "; "))
+				return
+			}
+			if got != want {
+				c.failClass(ht, "return "+strings.SplitN(o.name, "(", 2)[0], "%s = %v, model %v\nstart:\n%s\ntrace: %s", o.name, got, want, start, strings.Join(trace, "; "))
+				return
+			}
+		}
+		st.noteDomains()
+		last := strings.SplitN(trace[len(trace)-1], "(", 2)[0]
+		ctx := func() string {
+			return fmt.Sprintf("start:\n%s\ntrace: %s\nmodel now:\n%s", start, strings.Join(trace, "; "), st)
+		}
+		gotP, _ := e.GetPolicy()
+		if joinRules(gotP) != joinRules(st.p) {
+			if strings.Join(ruleKeys(gotP), "|") == strings.Join(ruleKeys(st.p), "|") {
+				c.failClass(ht, "order "+last, "GetPolicy = [%s], model [%s]\n%s", joinRules(gotP), joinRules(st.p), ctx())
+			} else {
+				c.failClass(ht, "policy "+last, "GetPolicy = [%s], model [%s]\n%s", joinRules(gotP), joinRules(st.p), ctx())
+			}
+			return
+		}
+		if len(ruleKeys(gotP)) != len(gotP) {
+			c.failClass(ht, "duplicate "+last, "GetPolicy holds a rule twice: [%s]\n%s", joinRules(gotP), ctx())
+			return
+		}
+		if st.rbac || st.resRoles {
+			gotG, _ := e.GetGroupingPolicy()
+			if joinRules(gotG) != joinRules(st.g) {
+				c.failClass(ht, "grouping "+last, "GetGroupingPolicy = [%s], model [%s]\n%s", joinRules(gotG), joinRules(st.g), ctx())
+				return
+			}
+			if len(ruleKeys(gotG)) != len(gotG) {
+				c.failClass(ht, "duplicate g "+last, "GetGroupingPolicy holds a rule twice: [%s]\n%s", joinRules(gotG), ctx())
+				return
+			}
+			gotG2, _ := e.GetNamedGroupingPolicy("g2")
+			if st.resRoles && joinRules(gotG2) != joinRules(st.g2) {
+				c.failClass(ht, "grouping2 "+last, "GetNamedGroupingPolicy(g2) = [%s], model [%s]\n%s", joinRules(gotG2), joinRules(st.g2), ctx())
+				return
+			}
+		}
+		for _, r := range st.universe() {
+			ok, _ := st.decide(r)
+			got, err := e.Enforce(r.vals(st.spec)...)
+			if err != nil {
+				c.failClass(ht, "enforce error "+last, "Enforce%v: %v\n%s", r, err, ctx())
+				return
+			}
+			if got != ok {
+				c.failClass(ht, "decision "+last, "Enforce%v = %v, model %v\n%s", r, got, ok, ctx())
+				return
+			}
+		}
+		if st.rbac || st.resRoles {
+			doms := []string{""}
+			if st.domain {
+				doms = append(append([]string{}, domains...), "dom9")
+			}
+			for _, name := range append(append([]string{}, users...), roles...) {
+				for _, d := range doms {
+					var args []string
+					if st.domain {
+						args = []string{d}
+					}
+					got, err := e.GetImplicitRolesForUser(name, args...)
+					if err != nil {
+						c.failClass(ht, "roles error "+last, "GetImplicitRolesForUser(%s, %v): %v\n%s", name, args, err, ctx())
+						return
+					}
+					if !sameList(sortedStrings(got), st.implicitRoles(name, d)) {
+						c.failClass(ht, "roles "+last, "GetImplicitRolesForUser(%s, %v) = %q, model %q\n%s", name, args, sortedStrings(got), st.implicitRoles(name, d), ctx())
+						return
+					}
+				}
+			}
+			if st.domain {
+				got, _ := e.GetAllDomains()
+				want := distinctField(st.g, 2)
+				if Known.staleDomains {
+					want = nil
+					for d := range st.seenDoms {
+						want = append(want, d)
+					}
+				}
+				if !sameList(sortedStrings(got), sortedStrings(want)) {
+					c.failClass(ht, "domains "+last, "GetAllDomains() = %q, model %q\n%s", sortedStrings(got), sortedStrings(want), ctx())
+					return
+				}
+			}
+		}
+	})
+}
diff --git a/hegel_persist_test.go b/hegel_persist_test.go
new file mode 100644
index 0000000..c38f00f
--- /dev/null
+++ b/hegel_persist_test.go
@@ -0,0 +1,221 @@
+package casbin_test
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/casbin/casbin/v3"
+	"github.com/casbin/casbin/v3/model"
+	fileadapter "github.com/casbin/casbin/v3/persist/file-adapter"
+	stringadapter "github.com/casbin/casbin/v3/persist/string-adapter"
+	"hegel.dev/go/hegel"
+)
+
+const rbacModelText = `[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`
+
+// oddValues: field values with the characters a CSV line, a comment or a policy key has to
+// cope with. A newline is not among them: the policy file is read line by line.
+var oddValues = []string{
+	"alice", "bob", "data1", "read", "a b", " lead", "trail ", "x,y", `q"uote`, "#hash", "a'b",
+	"üñí", "", "a=b", "tab\tx", `back\slash`, "semi;colon", "[br]", "eq==", "star*",
+	"*", "dot.dot", "colon:x", "  ", "\"", ",", "a, b", "r.sub", "p_sub",
+}
+
+func genOdd(tc hegel.TestCase) string {
+	if chance(tc, 10) {
+		return pick(tc, oddValues) + pick(tc, oddValues)
+	}
+	return pick(tc, oddValues)
+}
+
+// TestHegelPolicySaveLoadRoundTrip: a policy saved by the file adapter and by the string adapter
+// is loaded back as the same rules in the same order, whatever characters the fields hold.
+func TestHegelPolicySaveLoadRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	dir := t.TempDir()
+	var n int
+	property(t, func(ht *hegel.T) {
+		m, err := model.NewModelFromString(rbacModelText)
+		if err != nil {
+			ht.Fatalf("model: %v", err)
+		}
+		e, err := casbin.NewEnforcer(m)
+		if err != nil {
+			ht.Fatalf("NewEnforcer: %v", err)
+		}
+		var p, g [][]string
+		// rules are told apart by their fields joined with "," (Known.commaJoinKey), which
+		// addUnique mirrors
+		for i, k := 0, drawInt(ht, 0, 5); i < k; i++ {
+			r := []string{genOdd(ht), genOdd(ht), genOdd(ht)}
+			if Known.fileTrimsLastField {
+				r[2] = strings.TrimRight(r[2], " \t")
+			}
+			var added bool
+			if p, added = addUnique(p, r); added {
+				ok, err := e.AddPolicy(toAny(r)...)
+				if err != nil || !ok {
+					c.failClass(ht, "add", "AddPolicy(%q) = %v, %v with policy %s", r, ok, err, joinRules(p))
+					return
+				}
+			}
+		}
+		for i, k := 0, drawInt(ht, 0, 3); i < k; i++ {
+			r := []string{genOdd(ht), genOdd(ht)}
+			if Known.fileTrimsLastField {
+				r[1] = strings.TrimRight(r[1], " \t")
+			}
+			if Known.loadRejectsCycles && (r[0] == r[1] || closure(g, r[1], false, "")[r[0]]) {
+				continue // a cycle would not load back
+			}
+			var added bool
+			if g, added = addUnique(g, r); added {
+				ok, err := e.AddGroupingPolicy(toAny(r)...)
+				if err != nil || !ok {
+					c.failClass(ht, "add g", "AddGroupingPolicy(%q) = %v, %v with policy %s", r, ok, err, joinRules(g))
+					return
+				}
+			}
+		}
+		// the enforcer holds what was added
+		gotP, _ := e.GetPolicy()
+		gotG, _ := e.GetGroupingPolicy()
+		if joinRules(gotP) != joinRules(p) || joinRules(gotG) != joinRules(g) {
+			c.failClass(ht, "held", "GetPolicy = [%s] / [%s], added [%s] / [%s]", joinRules(gotP), joinRules(gotG), joinRules(p), joinRules(g))
+			return
+		}
+		// file adapter
+		c.mu.Lock()
+		n++
+		path := filepath.Join(dir, fmt.Sprintf("policy-%d.csv", n))
+		c.mu.Unlock()
+		defer os.Remove(path)
+		fa := fileadapter.NewAdapter(path)
+		if err := fa.SavePolicy(e.GetModel()); err != nil {
+			c.failClass(ht, "save", "SavePolicy: %v for [%s] / [%s]", err, joinRules(p), joinRules(g))
+			return
+		}
+		text, _ := os.ReadFile(path)
+		m2, _ := model.NewModelFromString(rbacModelText)
+		e2, err := casbin.NewEnforcer(m2, fa)
+		if err != nil {
+			c.failClass(ht, "load", "load after save: %v\nfile:\n%s\nrules [%s] / [%s]", err, text, joinRules(p), joinRules(g))
+			return
+		}
+		gotP, _ = e2.GetPolicy()
+		gotG, _ = e2.GetGroupingPolicy()
+		if joinRules(gotP) != joinRules(p) || joinRules(gotG) != joinRules(g) {
+			c.failClass(ht, "file", "after file save/load: [%s] / [%s], saved [%s] / [%s]\nfile:\n%s", joinRules(gotP), joinRules(gotG), joinRules(p), joinRules(g), text)
+			return
+		}
+		// string adapter
+		if Known.stringAdapterEmpty && len(p)+len(g) == 0 {
+			return
+		}
+		sa := stringadapter.NewAdapter("")
+		if err := sa.SavePolicy(e.GetModel()); err != nil {
+			c.failClass(ht, "save string", "string SavePolicy: %v", err)
+			return
+		}
+		m3, _ := model.NewModelFromString(rbacModelText)
+		e3, err := casbin.NewEnforcer(m3, sa)
+		if err != nil {
+			c.failClass(ht, "load string", "string load after save: %v\nline:\n%s\nrules [%s] / [%s]", err, sa.Line, joinRules(p), joinRules(g))
+			return
+		}
+		gotP, _ = e3.GetPolicy()
+		gotG, _ = e3.GetGroupingPolicy()
+		if joinRules(gotP) != joinRules(p) || joinRules(gotG) != joinRules(g) {
+			c.failClass(ht, "string", "after string save/load: [%s] / [%s], saved [%s] / [%s]\nline:\n%s", joinRules(gotP), joinRules(gotG), joinRules(p), joinRules(g), sa.Line)
+			return
+		}
+	})
+}
+
+// TestHegelModelTextRoundTrip: the text of a model (ToText) loads as a model with the same text
+// and the same decisions.
+func TestHegelModelTextRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		st := genState(ht)
+		m, err := model.NewModelFromString(st.modelText())
+		if err != nil {
+			ht.Fatalf("model: %v", err)
+		}
+		text := m.ToText()
+		m2, err := model.NewModelFromString(text)
+		if err != nil {
+			c.failClass(ht, "reload", "ToText does not load: %v\n%s", err, text)
+			return
+		}
+		if t2 := m2.ToText(); t2 != text {
+			if !Known.toTextMapOrder || !sameList(sortedStrings(strings.Split(text, "\n")), sortedStrings(strings.Split(t2, "\n"))) {
+				c.failClass(ht, "text", "ToText differs after a round trip:\n%s\n---\n%s", text, t2)
+				return
+			}
+		}
+		st2 := *st
+		e1, err1 := newEnforcer(st)
+		if err1 != nil {
+			c.failClass(ht, "build", "%v", err1)
+			return
+		}
+		mm, _ := model.NewModelFromString(text)
+		e2, err := casbin.NewEnforcer(mm)
+		if err != nil {
+			c.failClass(ht, "build2", "%v", err)
+			return
+		}
+		for _, r := range st2.p {
+			if _, err := e2.AddPolicy(toAny(r)...); err != nil {
+				c.failClass(ht, "add2", "%v", err)
+				return
+			}
+		}
+		for _, r := range st2.g {
+			if _, err := e2.AddGroupingPolicy(toAny(r)...); err != nil {
+				c.failClass(ht, "add2", "%v", err)
+				return
+			}
+		}
+		for _, r := range st2.g2 {
+			if _, err := e2.AddNamedGroupingPolicy("g2", toAny(r)...); err != nil {
+				c.failClass(ht, "add2", "%v", err)
+				return
+			}
+		}
+		for _, r := range st.universe() {
+			a, err := e1.Enforce(r.vals(st.spec)...)
+			if err != nil {
+				c.failClass(ht, "error", "Enforce%v: %v", r, err)
+				return
+			}
+			b, err := e2.Enforce(r.vals(st.spec)...)
+			if err != nil {
+				c.failClass(ht, "error2", "Enforce%v on the reloaded model: %v\n%s", r, err, text)
+				return
+			}
+			if a != b {
+				c.failClass(ht, "decision", "Enforce%v = %v, %v on the reloaded model\n%s\n%s", r, a, b, strings.TrimSpace(text), st)
+				return
+			}
+		}
+	})
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..5a912bd
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,351 @@
+package casbin_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// the bug exists and passes once it is fixed (then its Known switch and its entry in
+// target.toml's expected_failures come off).
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/casbin/casbin/v3"
+	"github.com/casbin/casbin/v3/model"
+	fileadapter "github.com/casbin/casbin/v3/persist/file-adapter"
+	stringadapter "github.com/casbin/casbin/v3/persist/string-adapter"
+	"github.com/casbin/casbin/v3/util"
+)
+
+const basicModelText = `[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = r.sub == p.sub && r.obj == p.obj && r.act == p.act
+`
+
+const domainModelText = `[request_definition]
+r = sub, dom, obj, act
+
+[policy_definition]
+p = sub, dom, obj, act
+
+[role_definition]
+g = _, _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub, r.dom) && r.dom == p.dom && r.obj == p.obj && r.act == p.act
+`
+
+const domainModelWithG2Text = `[request_definition]
+r = sub, dom, obj, act
+
+[policy_definition]
+p = sub, dom, obj, act
+
+[role_definition]
+g = _, _, _
+g2 = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub, r.dom) && r.dom == p.dom && g2(r.obj, p.obj) && r.act == p.act
+`
+
+func mustEnforcer(t *testing.T, text string) *casbin.Enforcer {
+	t.Helper()
+	m, err := model.NewModelFromString(text)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	e, err := casbin.NewEnforcer(m)
+	if err != nil {
+		t.Fatalf("NewEnforcer: %v", err)
+	}
+	return e
+}
+
+// casbin/1: ClearPolicy clears all policy, the role links included.
+func TestHegelPinClearPolicyClearsRoleLinks(t *testing.T) {
+	e := mustEnforcer(t, rbacModelText)
+	if _, err := e.AddGroupingPolicy("alice", "admin"); err != nil {
+		t.Fatal(err)
+	}
+	e.ClearPolicy()
+	if _, err := e.AddPolicy("admin", "data1", "read"); err != nil {
+		t.Fatal(err)
+	}
+	roles, _ := e.GetImplicitRolesForUser("alice")
+	ok, err := e.Enforce("alice", "data1", "read")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(roles) != 0 || ok {
+		t.Errorf("after ClearPolicy alice still has roles %q and Enforce(alice, data1, read) = %v", roles, ok)
+	}
+}
+
+// casbin/2: an update to a rule that already exists must not leave the policy holding it twice.
+func TestHegelPinUpdatePolicyToExistingRuleKeepsOneCopy(t *testing.T) {
+	e := mustEnforcer(t, rbacModelText)
+	_, _ = e.AddPolicy("alice", "data1", "read")
+	_, _ = e.AddPolicy("bob", "data1", "read")
+	_, _ = e.UpdatePolicy([]string{"alice", "data1", "read"}, []string{"bob", "data1", "read"})
+	p, _ := e.GetPolicy()
+	if len(ruleKeys(p)) != len(p) {
+		t.Errorf("GetPolicy holds a rule twice: %s", joinRules(p))
+	}
+	_, _ = e.AddGroupingPolicy("alice", "admin")
+	_, _ = e.AddGroupingPolicy("bob", "admin")
+	_, _ = e.UpdateGroupingPolicy([]string{"alice", "admin"}, []string{"bob", "admin"})
+	g, _ := e.GetGroupingPolicy()
+	if len(ruleKeys(g)) != len(g) {
+		t.Errorf("GetGroupingPolicy holds a rule twice: %s", joinRules(g))
+	}
+}
+
+// casbin/3: UpdateFilteredPolicies deletes the old rules and adds the new ones.
+func TestHegelPinUpdateFilteredPoliciesRemovesOldRules(t *testing.T) {
+	e := mustEnforcer(t, basicModelText)
+	_, _ = e.AddPolicy("alice", "data1", "read")
+	ok, err := e.UpdateFilteredPolicies([][]string{{"bob", "data2", "write"}}, 0, "alice")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, _ := e.GetPolicy()
+	if !ok || joinRules(p) != "bob,data2,write" {
+		t.Errorf("UpdateFilteredPolicies = %v, policy now [%s]; want true and [bob,data2,write]", ok, joinRules(p))
+	}
+}
+
+// casbin/4: a domain whose role links are all gone is no longer a domain.
+func TestHegelPinRemovedLinksLeaveGetAllDomains(t *testing.T) {
+	e := mustEnforcer(t, domainModelText)
+	_, _ = e.AddGroupingPolicy("alice", "admin", "dom1")
+	_, _ = e.RemoveGroupingPolicy("alice", "admin", "dom1")
+	doms, err := e.GetAllDomains()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(doms) != 0 {
+		t.Errorf("GetAllDomains() = %q after the only link of dom1 was removed", doms)
+	}
+}
+
+// casbin/5: DeleteUser works on a model without a role definition.
+func TestHegelPinDeleteUserWithoutRoleDefinition(t *testing.T) {
+	e := mustEnforcer(t, basicModelText)
+	_, _ = e.AddPolicy("alice", "data1", "read")
+	ok, err := e.DeleteUser("alice")
+	p, _ := e.GetPolicy()
+	if err != nil || !ok || len(p) != 0 {
+		t.Errorf("DeleteUser(alice) = %v, %v; policy now [%s]", ok, err, joinRules(p))
+	}
+}
+
+// casbin/6: a saved policy loads back with its fields intact, trailing whitespace included.
+func TestHegelPinTrailingSpaceSurvivesFileRoundTrip(t *testing.T) {
+	e := mustEnforcer(t, basicModelText)
+	_, _ = e.AddPolicy("alice", "data1", "read ")
+	path := filepath.Join(t.TempDir(), "policy.csv")
+	fa := fileadapter.NewAdapter(path)
+	if err := fa.SavePolicy(e.GetModel()); err != nil {
+		t.Fatal(err)
+	}
+	m, _ := model.NewModelFromString(basicModelText)
+	e2, err := casbin.NewEnforcer(m, fa)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, _ := e2.GetPolicy()
+	if joinRules(p) != "alice,data1,read " {
+		text, _ := os.ReadFile(path)
+		t.Errorf("loaded [%s], saved [alice,data1,read ]; file %q", joinRules(p), text)
+	}
+}
+
+// casbin/7: a role hierarchy the API accepts loads back from the file it was saved to.
+func TestHegelPinAcceptedRoleCycleLoadsBack(t *testing.T) {
+	e := mustEnforcer(t, rbacModelText)
+	ok, err := e.AddGroupingPolicy("admin", "admin")
+	if err != nil {
+		return // rejected up front: consistent
+	}
+	if !ok {
+		t.Fatal("AddGroupingPolicy(admin, admin) = false on an empty policy")
+	}
+	path := filepath.Join(t.TempDir(), "policy.csv")
+	fa := fileadapter.NewAdapter(path)
+	if err := fa.SavePolicy(e.GetModel()); err != nil {
+		t.Fatal(err)
+	}
+	m, _ := model.NewModelFromString(rbacModelText)
+	if _, err := casbin.NewEnforcer(m, fa); err != nil {
+		t.Errorf("the saved policy does not load: %v", err)
+	}
+}
+
+// casbin/8: the string adapter loads the empty policy it saved.
+func TestHegelPinStringAdapterLoadsEmptyPolicy(t *testing.T) {
+	e := mustEnforcer(t, basicModelText)
+	sa := stringadapter.NewAdapter("")
+	if err := sa.SavePolicy(e.GetModel()); err != nil {
+		t.Fatal(err)
+	}
+	m, _ := model.NewModelFromString(basicModelText)
+	if _, err := casbin.NewEnforcer(m, sa); err != nil {
+		t.Errorf("loading the saved empty policy: %v", err)
+	}
+}
+
+// casbin/9: the text of a model is the same on every call.
+func TestHegelPinModelToTextIsStable(t *testing.T) {
+	m, err := model.NewModelFromString(domainModelWithG2Text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := m.ToText()
+	for i := 0; i < 50; i++ {
+		if s := m.ToText(); s != first {
+			t.Fatalf("ToText differs between calls:\n%s\n---\n%s", first, s)
+		}
+	}
+}
+
+// casbin/10: a name with no role links has no domains.
+func TestHegelPinDomainsForUserWithoutLinksIsEmpty(t *testing.T) {
+	e := mustEnforcer(t, domainModelWithG2Text)
+	_, _ = e.AddGroupingPolicy("alice", "admin", "dom1")
+	doms, err := e.GetDomainsForUser("nobody")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(doms) != 0 {
+		t.Errorf("GetDomainsForUser(nobody) = %q", doms)
+	}
+}
+
+// casbin/11: GetImplicitUsersForResourceByDomain returns the domain's rules only.
+func TestHegelPinUsersForResourceByDomainRespectsDomain(t *testing.T) {
+	e := mustEnforcer(t, domainModelText)
+	_, _ = e.AddPolicy("alice", "dom1", "data1", "read")
+	got, err := e.GetImplicitUsersForResourceByDomain("data1", "dom2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 0 {
+		t.Errorf("GetImplicitUsersForResourceByDomain(data1, dom2) = [%s], the only rule is in dom1", joinRules(got))
+	}
+}
+
+// casbin/12: GetImplicitUsersForResource returns users, through every level of the hierarchy.
+func TestHegelPinUsersForResourceFollowsHierarchy(t *testing.T) {
+	e := mustEnforcer(t, rbacModelText)
+	_, _ = e.AddPolicy("admin", "data1", "read")
+	_, _ = e.AddGroupingPolicy("alice", "manager")
+	_, _ = e.AddGroupingPolicy("manager", "admin")
+	got, err := e.GetImplicitUsersForResource("data1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if joinRules(got) != "alice,data1,read" {
+		t.Errorf("GetImplicitUsersForResource(data1) = [%s], want [alice,data1,read]", joinRules(got))
+	}
+}
+
+// casbin/13: two placeholders in one segment are two placeholders.
+func TestHegelPinKeyMatch3TwoPlaceholders(t *testing.T) {
+	if !util.KeyMatch3("/a/x_y", "/a/{p}_{q}") {
+		t.Errorf("KeyMatch3(/a/x_y, /a/{p}_{q}) = false")
+	}
+	if util.KeyMatch3("/a/xy", "/a/{p}_{q}") {
+		t.Errorf("KeyMatch3(/a/xy, /a/{p}_{q}) = true: the segment has no _")
+	}
+	if util.KeyMatch4("/a/xy", "/a/{p}_{q}") {
+		t.Errorf("KeyMatch4(/a/xy, /a/{p}_{q}) = true: the segment has no _")
+	}
+	if util.KeyMatch5("/a/xy", "/a/{p}_{q}") {
+		t.Errorf("KeyMatch5(/a/xy, /a/{p}_{q}) = true: the segment has no _")
+	}
+}
+
+// casbin/15: GetImplicitPermissionsForUser finds the subject of the documented priority policy.
+func TestHegelPinImplicitPermissionsWithPriorityField(t *testing.T) {
+	e := mustEnforcer(t, `[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = priority, sub, obj, act, eft
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = priority(p.eft) || deny
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`)
+	_, _ = e.AddPolicy("1", "admin", "data1", "read", "allow")
+	_, _ = e.AddGroupingPolicy("alice", "admin")
+	got, err := e.GetImplicitPermissionsForUser("alice")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if joinRules(got) != "1,admin,data1,read,allow" {
+		t.Errorf("GetImplicitPermissionsForUser(alice) = [%s], want [1,admin,data1,read,allow]", joinRules(got))
+	}
+}
+
+// casbin/16: GetAllUsersByDomain returns subjects, not priorities.
+func TestHegelPinAllUsersByDomainWithPriorityField(t *testing.T) {
+	e := mustEnforcer(t, `[request_definition]
+r = sub, dom, obj, act
+
+[policy_definition]
+p = priority, sub, dom, obj, act, eft
+
+[role_definition]
+g = _, _, _
+
+[policy_effect]
+e = priority(p.eft) || deny
+
+[matchers]
+m = g(r.sub, p.sub, r.dom) && r.dom == p.dom && r.obj == p.obj && r.act == p.act
+`)
+	_, _ = e.AddPolicy("1", "alice", "dom1", "data1", "read", "allow")
+	got, err := e.GetAllUsersByDomain("dom1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(got, ",") != "alice" {
+		t.Errorf("GetAllUsersByDomain(dom1) = %q, want [alice]", got)
+	}
+}
+
+// casbin/14: rules that differ are different rules, wherever their commas fall.
+func TestHegelPinCommaFieldsKeepRulesApart(t *testing.T) {
+	e := mustEnforcer(t, basicModelText)
+	ok1, _ := e.AddPolicy("x,y", "z", "read")
+	ok2, _ := e.AddPolicy("x", "y,z", "read")
+	p, _ := e.GetPolicy()
+	if !ok1 || !ok2 || len(p) != 2 {
+		t.Errorf("AddPolicy(x,y / z / read) = %v, AddPolicy(x / y,z / read) = %v, policy [%s]", ok1, ok2, strings.ReplaceAll(joinRules(p), "|", "/"))
+	}
+	has, _ := e.HasPolicy("x", "y,z", "write")
+	if has {
+		t.Errorf("HasPolicy(x / y,z / write) = true")
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..e0676b2
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,103 @@
+package casbin_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/casbin/casbin/v3"
+	"github.com/casbin/casbin/v3/model"
+	"hegel.dev/go/hegel"
+)
+
+// newEnforcer builds an enforcer for the state: the model from its text, the rules added one by
+// one through the management API (each addition must report true: the state has no duplicates).
+func newEnforcer(st *state) (*casbin.Enforcer, error) {
+	m, err := model.NewModelFromString(st.modelText())
+	if err != nil {
+		return nil, fmt.Errorf("model: %v", err)
+	}
+	e, err := casbin.NewEnforcer(m)
+	if err != nil {
+		return nil, fmt.Errorf("NewEnforcer: %v", err)
+	}
+	for _, r := range st.p {
+		ok, err := e.AddPolicy(toAny(r)...)
+		if err != nil || !ok {
+			return nil, fmt.Errorf("AddPolicy(%v) = %v, %v", r, ok, err)
+		}
+	}
+	for _, r := range st.g {
+		ok, err := e.AddGroupingPolicy(toAny(r)...)
+		if err != nil || !ok {
+			return nil, fmt.Errorf("AddGroupingPolicy(%v) = %v, %v", r, ok, err)
+		}
+	}
+	for _, r := range st.g2 {
+		ok, err := e.AddNamedGroupingPolicy("g2", toAny(r)...)
+		if err != nil || !ok {
+			return nil, fmt.Errorf("AddNamedGroupingPolicy(g2, %v) = %v, %v", r, ok, err)
+		}
+	}
+	return e, nil
+}
+
+func toAny(r []string) []interface{} {
+	out := make([]interface{}, len(r))
+	for i, x := range r {
+		out[i] = x
+	}
+	return out
+}
+
+// TestHegelEnforceAgreesWithModel: on every request of the universe Enforce, EnforceEx and
+// BatchEnforce decide as the documented semantics of the generated model and policy, and
+// EnforceEx reports the rule that decided.
+func TestHegelEnforceAgreesWithModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		st := genState(ht)
+		e, err := newEnforcer(st)
+		if err != nil {
+			c.failClass(ht, "build", "%v\n%s", err, st)
+			return
+		}
+		c.count(fmt.Sprintf("effect=%d", st.effect))
+		reqs := st.universe()
+		var batch [][]interface{}
+		var want []bool
+		for _, r := range reqs {
+			ok, idx := st.decide(r)
+			got, explain, err := e.EnforceEx(r.vals(st.spec)...)
+			if err != nil {
+				c.failClass(ht, "error", "EnforceEx%v: %v\n%s", r, err, st)
+				return
+			}
+			if got != ok {
+				c.failClass(ht, "decision", "Enforce%v = %v, model %v\n%s", r, got, ok, st)
+				return
+			}
+			var wantExplain []string
+			if idx >= 0 {
+				wantExplain = st.p[idx]
+			}
+			if strings.Join(explain, ",") != strings.Join(wantExplain, ",") {
+				c.failClass(ht, "explain", "EnforceEx%v explains %q, model %q\n%s", r, explain, wantExplain, st)
+				return
+			}
+			batch = append(batch, r.vals(st.spec))
+			want = append(want, ok)
+		}
+		got, err := e.BatchEnforce(batch)
+		if err != nil {
+			c.failClass(ht, "batch", "BatchEnforce: %v\n%s", err, st)
+			return
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				c.failClass(ht, "batch", "BatchEnforce%v = %v, Enforce %v\n%s", reqs[i], got[i], want[i], st)
+				return
+			}
+		}
+	})
+}
diff --git a/hegel_rbac_test.go b/hegel_rbac_test.go
new file mode 100644
index 0000000..a5484fc
--- /dev/null
+++ b/hegel_rbac_test.go
@@ -0,0 +1,514 @@
+package casbin_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- model queries
+
+// reverseClosure returns the names from which name is reachable over links (users of a role).
+func reverseClosure(links [][]string, name string, withDom bool, dom string) map[string]bool {
+	seen := map[string]bool{}
+	frontier := []string{name}
+	for depth := 0; depth < 10 && len(frontier) > 0; depth++ {
+		var next []string
+		for _, cur := range frontier {
+			for _, l := range links {
+				if l[1] != cur {
+					continue
+				}
+				if withDom && l[2] != dom {
+					continue
+				}
+				if !seen[l[0]] {
+					seen[l[0]] = true
+					next = append(next, l[0])
+				}
+			}
+		}
+		frontier = next
+	}
+	return seen
+}
+
+func setMinus(m map[string]bool, name string) []string {
+	var out []string
+	for k := range m {
+		if k != name {
+			out = append(out, k)
+		}
+	}
+	return sortedStrings(out)
+}
+
+func union(a, b map[string]bool) map[string]bool {
+	out := map[string]bool{}
+	for k := range a {
+		out[k] = true
+	}
+	for k := range b {
+		out[k] = true
+	}
+	return out
+}
+
+// implicitRoles: the roles name inherits through g (in dom when the spec has domains) and g2,
+// name itself excluded.
+func (st *state) implicitRoles(name, dom string) []string {
+	return setMinus(union(closure(st.links(), name, st.domain, dom), closure(st.links2(), name, false, "")), name)
+}
+
+func (st *state) implicitUsers(name, dom string) []string {
+	return setMinus(union(reverseClosure(st.links(), name, st.domain, dom), reverseClosure(st.links2(), name, false, "")), name)
+}
+
+// gRolesOf / gUsersOf: direct links.
+func (st *state) gRolesOf(name, dom string) []string {
+	var out []string
+	for _, l := range st.links() {
+		if l[0] == name && (!st.domain || l[2] == dom) {
+			out = append(out, l[1])
+		}
+	}
+	return sortedStrings(out)
+}
+
+func (st *state) gUsersOf(name, dom string) []string {
+	var out []string
+	for _, l := range st.links() {
+		if l[1] == name && (!st.domain || l[2] == dom) {
+			out = append(out, l[0])
+		}
+	}
+	return sortedStrings(out)
+}
+
+// permissionsOf: p rules whose subject is one of subs (in dom when given), in policy order.
+func (st *state) permissionsOf(subs map[string]bool, dom string, useDom bool) [][]string {
+	var out [][]string
+	for _, r := range st.p {
+		if !subs[r[st.subIdx()]] {
+			continue
+		}
+		if useDom && r[st.domIdx()] != dom {
+			continue
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+func distinctField(rules [][]string, idx int) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, r := range rules {
+		if !seen[r[idx]] {
+			seen[r[idx]] = true
+			out = append(out, r[idx])
+		}
+	}
+	return out
+}
+
+func joinRules(rules [][]string) string {
+	var parts []string
+	for _, r := range rules {
+		parts = append(parts, strings.Join(r, ","))
+	}
+	return strings.Join(parts, " | ")
+}
+
+func sameList(a, b []string) bool { return strings.Join(a, "\x00") == strings.Join(b, "\x00") }
+
+// --------------------------------------------------------------------------- property
+
+// TestHegelRBACQueriesAgreeWithModel: the RBAC and management query API (roles, users, implicit
+// roles and users, permissions, implicit permissions, users for a permission, the GetAll*
+// functions, domains) agrees with the model's closures over the generated policy.
+func TestHegelRBACQueriesAgreeWithModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		st := genState(ht)
+		e, err := newEnforcer(st)
+		if err != nil {
+			c.failClass(ht, "build", "%v\n%s", err, st)
+			return
+		}
+		hasG := st.rbac || st.resRoles
+		doms := []string{""}
+		if st.domain {
+			doms = append(append([]string{}, domains...), "dom9")
+		}
+		names := append(append([]string{}, users...), roles...)
+		names = append(names, "root", "nobody", "data1")
+		domArgs := func(d string) []string {
+			if st.domain {
+				return []string{d}
+			}
+			return nil
+		}
+		check := func(class, what string, got, want []string) bool {
+			if !sameList(got, want) {
+				c.failClass(ht, class, "%s = %q, model %q\n%s", what, got, want, st)
+				return false
+			}
+			return true
+		}
+		checkRules := func(class, what string, got, want [][]string, ordered bool) bool {
+			g, w := joinRules(got), joinRules(want)
+			if !ordered {
+				g, w = strings.Join(ruleKeys(got), " | "), strings.Join(ruleKeys(want), " | ")
+			}
+			if g != w {
+				c.failClass(ht, class, "%s = [%s], model [%s]\n%s", what, g, w, st)
+				return false
+			}
+			return true
+		}
+		for _, name := range names {
+			for _, d := range doms {
+				args := domArgs(d)
+				if hasG {
+					got, err := e.GetRolesForUser(name, args...)
+					if err != nil {
+						c.failClass(ht, "error", "GetRolesForUser(%s, %v): %v\n%s", name, args, err, st)
+						return
+					}
+					if !check("GetRolesForUser", fmt.Sprintf("GetRolesForUser(%s, %v)", name, args), sortedStrings(got), st.gRolesOf(name, d)) {
+						return
+					}
+					got, _ = e.GetUsersForRole(name, args...)
+					if !check("GetUsersForRole", fmt.Sprintf("GetUsersForRole(%s, %v)", name, args), sortedStrings(got), st.gUsersOf(name, d)) {
+						return
+					}
+					for _, role := range roles {
+						has, _ := e.HasRoleForUser(name, role, args...)
+						want := false
+						for _, r := range st.gRolesOf(name, d) {
+							if r == role {
+								want = true
+							}
+						}
+						if has != want {
+							c.failClass(ht, "HasRoleForUser", "HasRoleForUser(%s, %s, %v) = %v, model %v\n%s", name, role, args, has, want, st)
+							return
+						}
+					}
+					got, err = e.GetImplicitRolesForUser(name, args...)
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitRolesForUser(%s, %v): %v\n%s", name, args, err, st)
+						return
+					}
+					if !check("GetImplicitRolesForUser", fmt.Sprintf("GetImplicitRolesForUser(%s, %v)", name, args), sortedStrings(got), st.implicitRoles(name, d)) {
+						return
+					}
+					got, err = e.GetImplicitUsersForRole(name, args...)
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitUsersForRole(%s, %v): %v\n%s", name, args, err, st)
+						return
+					}
+					if !check("GetImplicitUsersForRole", fmt.Sprintf("GetImplicitUsersForRole(%s, %v)", name, args), sortedStrings(got), st.implicitUsers(name, d)) {
+						return
+					}
+					perms, err := e.GetImplicitPermissionsForUser(name, args...)
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitPermissionsForUser(%s, %v): %v\n%s", name, args, err, st)
+						return
+					}
+					subs := closure(st.g, name, st.domain, d)
+					subs[name] = true
+					wantPerms := st.permissionsOf(subs, d, st.domain)
+					if Known.implicitPermissionsSubjectIndex && st.priority {
+						wantPerms = nil // the subject is read from field 0, the priority
+					}
+					if !checkRules("GetImplicitPermissionsForUser", fmt.Sprintf("GetImplicitPermissionsForUser(%s, %v)", name, args), perms, wantPerms, true) {
+						return
+					}
+				}
+				perms, err := e.GetPermissionsForUser(name, args...)
+				if err != nil {
+					c.failClass(ht, "error", "GetPermissionsForUser(%s, %v): %v\n%s", name, args, err, st)
+					return
+				}
+				if !checkRules("GetPermissionsForUser", fmt.Sprintf("GetPermissionsForUser(%s, %v)", name, args), perms, st.permissionsOf(map[string]bool{name: true}, d, st.domain), true) {
+					return
+				}
+				// object patterns: rules of the user's subjects in the domain with the action or "*"
+				for _, act := range actions {
+					got, err := e.GetImplicitObjectPatternsForUser(name, d, act)
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitObjectPatternsForUser(%s, %s, %s): %v\n%s", name, d, act, err, st)
+						return
+					}
+					subs := map[string]bool{name: true}
+					if hasG {
+						for _, r := range st.implicitRoles(name, d) {
+							subs[r] = true
+						}
+					}
+					var want []string
+					for _, r := range st.permissionsOf(subs, d, st.domain) {
+						if r[st.actIdx()] == act || r[st.actIdx()] == "*" {
+							want = append(want, r[st.objIdx()])
+						}
+					}
+					if !check("GetImplicitObjectPatternsForUser", fmt.Sprintf("GetImplicitObjectPatternsForUser(%s, %s, %s)", name, d, act), sortedStrings(got), sortedStrings(want)) {
+						return
+					}
+				}
+			}
+		}
+		// users for a permission: every subject of p or g that is not a role, if allowed
+		var candidates []string
+		for _, r := range st.p {
+			candidates = append(candidates, r[st.subIdx()])
+		}
+		for _, r := range st.g {
+			candidates = append(candidates, r[0])
+		}
+		for _, r := range st.g2 {
+			candidates = append(candidates, r[0])
+		}
+		isRole := map[string]bool{}
+		for _, r := range st.g {
+			isRole[r[1]] = true
+		}
+		for _, r := range st.g2 {
+			isRole[r[1]] = true
+		}
+		for _, d := range doms {
+			for _, obj := range st.reqObjs() {
+				for _, act := range actions {
+					perm := []string{obj, act}
+					if st.domain {
+						perm = []string{d, obj, act}
+					}
+					got, err := e.GetImplicitUsersForPermission(perm...)
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitUsersForPermission(%v): %v\n%s", perm, err, st)
+						return
+					}
+					var want []string
+					for _, u := range sortedStrings(candidates) {
+						if isRole[u] {
+							continue
+						}
+						if ok, _ := st.decide(request{u, d, obj, act}); ok {
+							want = append(want, u)
+						}
+					}
+					if !check("GetImplicitUsersForPermission", fmt.Sprintf("GetImplicitUsersForPermission(%v)", perm), sortedStrings(got), sortedStrings(want)) {
+						return
+					}
+				}
+			}
+		}
+		// GetAll*
+		got, _ := e.GetAllSubjects()
+		if !check("GetAllSubjects", "GetAllSubjects()", got, distinctField(st.p, st.subIdx())) {
+			return
+		}
+		got, _ = e.GetAllObjects()
+		if !check("GetAllObjects", "GetAllObjects()", got, distinctField(st.p, st.objIdx())) {
+			return
+		}
+		got, _ = e.GetAllActions()
+		if !check("GetAllActions", "GetAllActions()", got, distinctField(st.p, st.actIdx())) {
+			return
+		}
+		if hasG {
+			got, _ = e.GetAllRoles()
+			wantRoles := append(distinctField(st.g, 1), distinctField(st.g2, 1)...)
+			if !check("GetAllRoles", "GetAllRoles()", sortedStrings(got), sortedStrings(wantRoles)) {
+				return
+			}
+			got, _ = e.GetAllUsers()
+			roleSet := map[string]bool{}
+			for _, r := range wantRoles {
+				roleSet[r] = true
+			}
+			var wantUsers []string
+			for _, s := range distinctField(st.p, st.subIdx()) {
+				if !roleSet[s] {
+					wantUsers = append(wantUsers, s)
+				}
+			}
+			if !check("GetAllUsers", "GetAllUsers()", sortedStrings(got), sortedStrings(wantUsers)) {
+				return
+			}
+		}
+		if st.domain && hasG {
+			got, err := e.GetAllDomains()
+			if err != nil {
+				c.failClass(ht, "error", "GetAllDomains(): %v\n%s", err, st)
+				return
+			}
+			if !check("GetAllDomains", "GetAllDomains()", sortedStrings(got), sortedStrings(distinctField(st.g, 2))) {
+				return
+			}
+			for _, name := range names {
+				got, _ := e.GetDomainsForUser(name)
+				var want []string
+				for _, l := range st.g {
+					if l[0] == name || l[1] == name {
+						want = append(want, l[2])
+					}
+				}
+				if Known.domainsForUserPhantom && st.resRoles {
+					want = append(want, "")
+				}
+				if !check("GetDomainsForUser", fmt.Sprintf("GetDomainsForUser(%s)", name), sortedStrings(got), sortedStrings(want)) {
+					return
+				}
+			}
+			for _, d := range doms {
+				got, err := e.GetAllUsersByDomain(d)
+				if err != nil {
+					c.failClass(ht, "error", "GetAllUsersByDomain(%s): %v\n%s", d, err, st)
+					return
+				}
+				var want []string
+				for _, l := range st.g {
+					if l[2] == d {
+						want = append(want, l[0])
+					}
+				}
+				for _, r := range st.p {
+					if r[st.domIdx()] == d {
+						if Known.usersByDomainSubjectIndex {
+							want = append(want, r[0]) // the priority when there is one
+						} else {
+							want = append(want, r[st.subIdx()])
+						}
+					}
+				}
+				if !check("GetAllUsersByDomain", fmt.Sprintf("GetAllUsersByDomain(%s)", d), sortedStrings(got), sortedStrings(want)) {
+					return
+				}
+				got, _ = e.GetAllRolesByDomain(d)
+				want = nil
+				for _, l := range st.g {
+					if l[2] == d {
+						want = append(want, l[1])
+					}
+				}
+				if !check("GetAllRolesByDomain", fmt.Sprintf("GetAllRolesByDomain(%s)", d), sortedStrings(got), sortedStrings(want)) {
+					return
+				}
+			}
+		}
+		// users for a resource: rules for the object; a role subject expanded to the users that
+		// inherit it (roles excluded), the domain respected when there is one
+		if hasG {
+			for _, obj := range st.reqObjs() {
+				for _, d := range doms {
+					var got [][]string
+					var err error
+					if st.domain {
+						got, err = e.GetImplicitUsersForResourceByDomain(obj, d)
+					} else {
+						got, err = e.GetImplicitUsersForResource(obj)
+					}
+					if err != nil {
+						c.failClass(ht, "error", "GetImplicitUsersForResource(%s, %s): %v\n%s", obj, d, err, st)
+						return
+					}
+					// a role: field 1 of a g rule (in the domain when there is one)
+					roleHere := isRole
+					if st.domain {
+						roleHere = map[string]bool{}
+						for _, l := range st.g {
+							if l[2] == d {
+								roleHere[l[1]] = true
+							}
+						}
+					}
+					var want [][]string
+					for _, r := range st.p {
+						if r[st.objIdx()] != obj {
+							continue
+						}
+						if !roleHere[r[st.subIdx()]] {
+							if st.domain && r[st.domIdx()] != d && !Known.usersForResourceIgnoresDomain {
+								continue
+							}
+							want = append(want, r)
+							continue
+						}
+						if st.domain && r[st.domIdx()] != d {
+							continue
+						}
+						var us []string
+						if Known.usersForResourceDirectUsers {
+							us = st.gUsersOf(r[st.subIdx()], d)
+						} else {
+							for _, u := range st.implicitUsers(r[st.subIdx()], d) {
+								if !roleHere[u] {
+									us = append(us, u)
+								}
+							}
+						}
+						for _, u := range us {
+							nr := append([]string{}, r...)
+							nr[st.subIdx()] = u
+							want = append(want, nr)
+						}
+					}
+					if !checkRules("GetImplicitUsersForResource", fmt.Sprintf("GetImplicitUsersForResource(%s, %s)", obj, d), got, want, false) {
+						return
+					}
+				}
+			}
+		}
+		// filtered policy
+		for i := 0; i < 3; i++ {
+			idx := drawInt(ht, 0, len(st.polTokens())-1)
+			n := drawInt(ht, 1, len(st.polTokens())-idx)
+			vals := make([]string, n)
+			for j := range vals {
+				if chance(ht, 50) && len(st.p) > 0 {
+					vals[j] = pick(ht, st.p)[idx+j]
+				}
+			}
+			got, err := e.GetFilteredPolicy(idx, vals...)
+			if err != nil {
+				c.failClass(ht, "error", "GetFilteredPolicy(%d, %q): %v\n%s", idx, vals, err, st)
+				return
+			}
+			var want [][]string
+			for _, r := range st.p {
+				ok := true
+				for j, v := range vals {
+					if v != "" && r[idx+j] != v {
+						ok = false
+					}
+				}
+				if ok {
+					want = append(want, r)
+				}
+			}
+			if !checkRules("GetFilteredPolicy", fmt.Sprintf("GetFilteredPolicy(%d, %q)", idx, vals), got, want, true) {
+				return
+			}
+		}
+		act := pick(ht, actions)
+		got2, err := e.GetFilteredNamedPolicyWithMatcher("p", fmt.Sprintf("p.act == %q", act))
+		if err != nil {
+			c.failClass(ht, "error", "GetFilteredNamedPolicyWithMatcher: %v\n%s", err, st)
+			return
+		}
+		var want2 [][]string
+		for _, r := range st.p {
+			if r[st.actIdx()] == act {
+				want2 = append(want2, r)
+			}
+		}
+		if !checkRules("GetFilteredNamedPolicyWithMatcher", fmt.Sprintf("GetFilteredNamedPolicyWithMatcher(p.act == %q)", act), got2, want2, true) {
+			return
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..11268f2
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,217 @@
+package casbin_test
+
+// Hegel property tests for casbin, written for the Hegel zoo. See targets/go/casbin/README.md.
+//
+// Oracle: the documented semantics of the model language (matcher expressions over request and
+// policy fields, the role hierarchy g(_, _) and g(_, _, _) with domains, the five policy effects)
+// and of the management and RBAC APIs, evaluated in a small model of generated policies and role
+// links: Enforce must agree with the model on every request of a small universe, the RBAC query
+// functions with the model's closures, the mutation functions with the model's set of rules; the
+// matching functions of the util package must agree with their documented pattern languages; a
+// policy saved and reloaded must be the same policy.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// sortedStrings returns a sorted copy without duplicates.
+func sortedStrings(xs []string) []string {
+	m := map[string]bool{}
+	for _, x := range xs {
+		m[x] = true
+	}
+	out := make([]string, 0, len(m))
+	for x := range m {
+		out = append(out, x)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// ruleKeys renders rules as sorted, de-duplicated strings for set comparison.
+func ruleKeys(rules [][]string) []string {
+	out := make([]string, 0, len(rules))
+	for _, r := range rules {
+		out = append(out, strings.Join(r, ","))
+	}
+	return sortedStrings(out)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// ClearPolicy clears the rules but not the role links: a user keeps inheriting the roles of
+	// the cleared grouping policy
+	clearPolicyKeepsLinks bool
+	// UpdatePolicy / UpdatePolicies / UpdateGroupingPolicy to a rule that already exists leave
+	// the policy holding that rule twice
+	updateKeepsDuplicate bool
+	// UpdateFilteredPolicies without an adapter that implements it (none, or the file adapter)
+	// adds the new rules, removes none of the filtered ones and returns false
+	updateFilteredAddsOnly bool
+	// GetAllDomains keeps listing a domain after its last role link was removed
+	staleDomains bool
+	// DeleteUser on a model without a role definition fails with "missing required section g"
+	// instead of removing the user's rules
+	deleteUserNeedsG bool
+	// the trailing whitespace of a rule's last field is lost by a save/load through the file or
+	// string adapter (the loader trims the line, the writer does not quote it)
+	fileTrimsLastField bool
+	// AddGroupingPolicy accepts a role cycle (a self link included) that LoadPolicy rejects, so
+	// a saved policy fails to load with "cycle detected"
+	loadRejectsCycles bool
+	// the string adapter cannot load the empty policy it saved ("line cannot be empty")
+	stringAdapterEmpty bool
+	// Model.ToText writes the definitions of a section in map order, so the text of one model
+	// differs between calls
+	toTextMapOrder bool
+	// GetDomainsForUser lists the empty domain for every name when the model has a second,
+	// domain-less role definition
+	domainsForUserPhantom bool
+	// GetImplicitUsersForResourceByDomain returns the rules of user subjects in every domain
+	usersForResourceIgnoresDomain bool
+	// GetImplicitUsersForResource expands a role subject to its direct users only, so users two
+	// levels down are missing and intermediate roles are returned as users
+	usersForResourceDirectUsers bool
+	// keyMatch3, keyMatch4 and keyMatch5 read a segment with two placeholders ({a}_{b}) as one
+	bracePatternGreedy bool
+	// rules are keyed by their fields joined with ",", so two rules that differ only in where a
+	// comma-bearing field is split ("x,y","z" and "x","y,z") count as the same rule
+	commaJoinKey bool
+	// GetImplicitPermissionsForUser reads the subject from field 0 of each rule, so with the
+	// documented explicit-priority policy (p = priority, sub, obj, act, eft) it returns nothing
+	implicitPermissionsSubjectIndex bool
+	// GetAllUsersByDomain reads the subject of a p rule from field 0, so with an explicit-priority
+	// policy it returns the priorities as users
+	usersByDomainSubjectIndex bool
+}{
+	implicitPermissionsSubjectIndex: true,
+	usersByDomainSubjectIndex:       true,
+	clearPolicyKeepsLinks:           true,
+	updateKeepsDuplicate:            true,
+	updateFilteredAddsOnly:          true,
+	staleDomains:                    true,
+	deleteUserNeedsG:                true,
+	fileTrimsLastField:              true,
+	loadRejectsCycles:               true,
+	stringAdapterEmpty:              true,
+	toTextMapOrder:                  true,
+	domainsForUserPhantom:           true,
+	usersForResourceIgnoresDomain:   true,
+	usersForResourceDirectUsers:     true,
+	bracePatternGreedy:              true,
+	commaJoinKey:                    true,
+}
diff --git a/hegel_util_test.go b/hegel_util_test.go
new file mode 100644
index 0000000..05d0755
--- /dev/null
+++ b/hegel_util_test.go
@@ -0,0 +1,202 @@
+package casbin_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/casbin/casbin/v3/util"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- generators
+
+var pathSegments = []string{"a", "b", "ab", "x1", "-", "a-b", "id", "res"}
+var paramNames = []string{"id", "res", "x"}
+
+// genPath draws a key1: "/" separated segments, maybe a trailing slash, rarely empty.
+func genPath(tc hegel.TestCase) string {
+	if chance(tc, 3) {
+		return ""
+	}
+	n := drawInt(tc, 0, 4)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteString("/")
+		b.WriteString(pick(tc, pathSegments))
+	}
+	if n == 0 || chance(tc, 15) {
+		b.WriteString("/")
+	}
+	return b.String()
+}
+
+// genPattern draws a key2 in the dialect: segments that are literals, "*", a parameter, or a
+// literal mixed with parameters. open/close are ":"/"" for keyMatch2 and "{"/"}" for the others.
+func genPattern(tc hegel.TestCase, open, close string) string {
+	if chance(tc, 3) {
+		return "*"
+	}
+	param := func() string { return open + pick(tc, paramNames) + close }
+	n := drawInt(tc, 0, 4)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteString("/")
+		switch drawInt(tc, 1, 10) {
+		case 1, 2:
+			b.WriteString("*")
+		case 3, 4, 5:
+			b.WriteString(param())
+		case 6:
+			switch drawInt(tc, 1, 3) {
+			case 1:
+				b.WriteString(pick(tc, pathSegments) + param())
+			case 2:
+				b.WriteString(param() + "_" + param())
+			default:
+				b.WriteString(param() + pick(tc, pathSegments))
+			}
+		default:
+			b.WriteString(pick(tc, pathSegments))
+		}
+	}
+	if n == 0 || chance(tc, 10) {
+		b.WriteString("/")
+	}
+	return b.String()
+}
+
+// hasMixedParam reports a segment of the pattern that holds a parameter and something else,
+// where the documented reading (several placeholders in one segment) and the implementation's
+// regexps can differ.
+func hasMixedParam(pat string, open string) bool {
+	for _, seg := range strings.Split(pat, "/") {
+		if strings.Contains(seg, open) && !(strings.HasPrefix(seg, open) && strings.Count(seg, open) == 1 && (open == ":" || strings.HasSuffix(seg, "}"))) {
+			return true
+		}
+	}
+	return false
+}
+
+// twoBraceParams: a segment of the pattern holds two {name} placeholders.
+func twoBraceParams(pat string) bool {
+	for _, seg := range strings.Split(pat, "/") {
+		if strings.Count(seg, "{") >= 2 {
+			return true
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelKeyMatchPatterns: keyMatch2..5 agree with the documented pattern language ("/*" for
+// the rest, ":name" or "{name}" for a segment part, keyMatch4's repeated names equal, keyMatch5's
+// query string ignored) and keyGet2/keyGet3 return the text a named parameter matched.
+func TestHegelKeyMatchPatterns(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		key1 := genPath(ht)
+		if key1 == "" && chance(ht, 50) {
+			key1 = pick(ht, pathSegments)
+		}
+		// keyMatch2 / keyGet2
+		p2 := genPattern(ht, ":", "")
+		want := p2 == "*" || patMatch(tokenize(p2, styleColon), key1, nil, true)
+		if got := util.KeyMatch2(key1, p2); got != want {
+			cls := "keyMatch2"
+			if hasMixedParam(p2, ":") {
+				cls = "keyMatch2 mixed"
+			}
+			c.failClass(ht, cls, "KeyMatch2(%q, %q) = %v, want %v", key1, p2, got, want)
+		}
+		if p2 != "*" {
+			bind := map[string]string{}
+			if patMatch(tokenize(p2, styleColon), key1, bind, true) {
+				for _, name := range paramNames {
+					if got := util.KeyGet2(key1, p2, name); got != bind[name] {
+						c.failClass(ht, "keyGet2", "KeyGet2(%q, %q, %q) = %q, want %q", key1, p2, name, got, bind[name])
+					}
+				}
+			} else {
+				for _, name := range paramNames {
+					if got := util.KeyGet2(key1, p2, name); got != "" {
+						c.failClass(ht, "keyGet2 nomatch", "KeyGet2(%q, %q, %q) = %q, want none: no match", key1, p2, name, got)
+					}
+				}
+			}
+		}
+		// keyMatch3 / keyMatch4 / keyMatch5 / keyGet3
+		p3 := genPattern(ht, "{", "}")
+		mixed := hasMixedParam(p3, "{")
+		cls := func(base string) string {
+			if mixed {
+				return base + " mixed"
+			}
+			return base
+		}
+		want = p3 == "*" || patMatch(tokenize(p3, styleBrace), key1, nil, true)
+		// two placeholders in one segment: the matchers' greedy regexps read them as one
+		skipMatch := Known.bracePatternGreedy && twoBraceParams(p3)
+		if got := util.KeyMatch3(key1, p3); got != want && !skipMatch {
+			c.failClass(ht, cls("keyMatch3"), "KeyMatch3(%q, %q) = %v, want %v", key1, p3, got, want)
+		}
+		want4 := p3 == "*" || patMatchFrom(tokenize(p3, styleBrace), key1, map[string]string{}, true, true)
+		if got := util.KeyMatch4(key1, p3); got != want4 && !skipMatch {
+			c.failClass(ht, cls("keyMatch4"), "KeyMatch4(%q, %q) = %v, want %v", key1, p3, got, want4)
+		}
+		key5 := key1
+		if chance(ht, 40) {
+			key5 += "?" + pick(ht, []string{"a=1", "x=/y/z", "", "q=*"})
+		}
+		if got := util.KeyMatch5(key5, p3); got != want && !skipMatch {
+			c.failClass(ht, cls("keyMatch5"), "KeyMatch5(%q, %q) = %v, want %v", key5, p3, got, want)
+		}
+		if p3 != "*" {
+			bind := map[string]string{}
+			if patMatch(tokenize(p3, styleBrace), key1, bind, false) {
+				for _, name := range paramNames {
+					if got := util.KeyGet3(key1, p3, name); got != bind[name] {
+						c.failClass(ht, cls("keyGet3"), "KeyGet3(%q, %q, %q) = %q, want %q", key1, p3, name, got, bind[name])
+					}
+				}
+			} else {
+				for _, name := range paramNames {
+					if got := util.KeyGet3(key1, p3, name); got != "" {
+						c.failClass(ht, cls("keyGet3 nomatch"), "KeyGet3(%q, %q, %q) = %q, want none: no match", key1, p3, name, got)
+					}
+				}
+			}
+		}
+	})
+}
+
+// TestHegelKeyMatchPrefix: keyMatch matches when key2's part before its first "*" is a prefix
+// of key1 (equality without a "*"), and keyGet returns the rest of key1 after that prefix.
+func TestHegelKeyMatchPrefix(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		key1 := genPath(ht)
+		key2 := genPath(ht)
+		if chance(ht, 60) {
+			i := drawInt(ht, 0, len(key2))
+			key2 = key2[:i] + "*" + key2[i:]
+			if chance(ht, 20) {
+				key2 = key2[:drawInt(ht, 0, len(key2))]
+			}
+		}
+		if chance(ht, 30) {
+			key1 = key2 + pick(ht, []string{"", "/x", "y"})
+		}
+		want := modelKeyMatch(key1, key2)
+		if got := util.KeyMatch(key1, key2); got != want {
+			c.failClass(ht, "keyMatch", "KeyMatch(%q, %q) = %v, want %v", key1, key2, got, want)
+		}
+		wantGet := ""
+		if i := strings.Index(key2, "*"); i >= 0 && strings.HasPrefix(key1, key2[:i]) {
+			wantGet = key1[i:]
+		}
+		if got := util.KeyGet(key1, key2); got != wantGet {
+			c.failClass(ht, "keyGet", "KeyGet(%q, %q) = %q, want %q", key1, key2, got, wantGet)
+		}
+	})
+}
