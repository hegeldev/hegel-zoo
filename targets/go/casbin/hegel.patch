+package casbin_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/casbin/casbin/v3"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- rule lists
+
+func hasRule(rules [][]string, r []string) bool {
+	k := strings.Join(r, ",")
+	for _, x := range rules {
+		if strings.Join(x, ",") == k {
+			return true
+		}
+	}
+	return false
+}
+
+func removeRule(rules [][]string, r []string) ([][]string, bool) {
+	k := strings.Join(r, ",")
+	for i, x := range rules {
+		if strings.Join(x, ",") == k {
+			return append(append([][]string{}, rules[:i]...), rules[i+1:]...), true
+		}
+	}
+	return rules, false
+}
+
+// filterMatch: the rule matches the filter (empty values match anything).
+func filterMatch(r []string, idx int, vals []string) bool {
+	for i, v := range vals {
+		if idx+i >= len(r) {
+			return false
+		}
+		if v != "" && r[idx+i] != v {
+			return false
+		}
+	}
+	return true
+}
+
+func removeFiltered(rules [][]string, idx int, vals []string) ([][]string, [][]string) {
+	var kept, removed [][]string
+	for _, r := range rules {
+		if filterMatch(r, idx, vals) {
+			removed = append(removed, r)
+		} else {
+			kept = append(kept, r)
+		}
+	}
+	return kept, removed
+}
+
+func updateRule(rules [][]string, old, nu []string) ([][]string, bool) {
+	k := strings.Join(old, ",")
+	for i, x := range rules {
+		if strings.Join(x, ",") == k {
+			out := append([][]string{}, rules...)
+			out[i] = nu
+			return out, true
+		}
+	}
+	return rules, false
+}
+
+// --------------------------------------------------------------------------- operations
+
+type op struct {
+	name string
+	// run applies the operation to the enforcer and the model, returning the enforcer's result,
+	// the model's expected result and an error from the enforcer.
+	run func(e *casbin.Enforcer, st *state) (got, want bool, err error)
+}
+
+func strs(rules [][]string) string { return joinRules(rules) }
+
+// genOp draws an operation for the state.
+func genOp(tc hegel.TestCase, st *state) op {
+	hasG := st.rbac || st.resRoles
+	// a p rule: an existing one (when any) or a fresh draw
+	pRule := func() []string {
+		if len(st.p) > 0 && chance(tc, 50) {
+			return append([]string{}, pick(tc, st.p)...)
+		}
+		return st.genPRule(tc)
+	}
+	gRule := func() []string {
+		if len(st.g) > 0 && chance(tc, 50) {
+			return append([]string{}, pick(tc, st.g)...)
+		}
+		return st.genGRule(tc)
+	}
+	pRules := func() [][]string {
+		var out [][]string
+		for i, n := 0, drawInt(tc, 1, 3); i < n; i++ {
+			out = append(out, pRule())
+		}
+		return out
+	}
+	// a filter over p (or g) fields
+	filter := func(width int, sample [][]string) (int, []string) {
+		idx := drawInt(tc, 0, width-1)
+		n := drawInt(tc, 1, width-idx)
+		vals := make([]string, n)
+		for j := range vals {
+			if chance(tc, 55) && len(sample) > 0 {
+				vals[j] = pick(tc, sample)[idx+j]
+			}
+		}
+		return idx, vals
+	}
+	kinds := []string{"AddPolicy", "AddPolicies", "AddPoliciesEx", "RemovePolicy", "RemovePolicies", "RemoveFilteredPolicy", "UpdatePolicy", "UpdatePolicies", "UpdateFilteredPolicies", "DeletePermission", "DeletePermissionsForUser", "DeleteUser", "ClearPolicy"}
+	if hasG {
