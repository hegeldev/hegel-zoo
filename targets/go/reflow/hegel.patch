+// Hegel properties for muesli/reflow: ANSI-aware word wrapping, unconditional wrapping,
+// indentation, padding, margins, truncation and dedentation.
+//
+// Oracles: models written from the README and the package documentation, mattn/go-runewidth
+// (the library's own width dependency) for cell widths, and a small SGR model — every printable
+// rune of a result carries the style (the SGR sequences since the last reset) it had in the
+// input, so "ANSI sequences do not affect the algorithms" is checked as a semantic statement,
+// not as a byte comparison. REFLOW_COLLECT=1 turns failures into a tally per property.
+package reflow_test
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/mattn/go-runewidth"
+	"github.com/muesli/reflow/ansi"
+	"github.com/muesli/reflow/dedent"
+	"github.com/muesli/reflow/indent"
+	"github.com/muesli/reflow/margin"
+	"github.com/muesli/reflow/padding"
+	"github.com/muesli/reflow/truncate"
+	"github.com/muesli/reflow/wordwrap"
+	"github.com/muesli/reflow/wrap"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("REFLOW_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+// count tallies an outcome for the collect-mode summary.
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- ANSI model
+
+const esc = '\x1b'
+
+// strip removes every escape sequence (ESC up to and including the first terminator, as
+// ansi.IsTerminator defines it).
+func strip(s string) string {
+	var sb strings.Builder
+	in := false
+	for _, c := range s {
+		switch {
+		case c == esc:
+			in = true
+		case in:
+			if ansi.IsTerminator(c) {
+				in = false
+			}
+		default:
+			sb.WriteRune(c)
+		}
+	}
+	return sb.String()
+}
+
+// srune is a printable rune with the SGR style in force where it appears: the concatenation
+// of the SGR sequences (ESC [ ... m) since the last reset (ESC [0m), "" after a reset.
+type srune struct {
+	r     rune
+	style string
+}
+
+// styled reads s into styled runes.
+func styled(s string) []srune {
+	var out []srune
+	style := ""
+	var seq strings.Builder
+	in := false
+	for _, c := range s {
+		switch {
+		case c == esc:
+			in = true
+			seq.Reset()
+			seq.WriteRune(c)
+		case in:
+			seq.WriteRune(c)
+			if ansi.IsTerminator(c) {
+				in = false
+				if c == 'm' {
+					if strings.HasSuffix(seq.String(), "[0m") {
+						style = ""
+					} else {
+						style += seq.String()
+					}
+				}
+			}
+		default:
+			out = append(out, srune{c, style})
+		}
+	}
+	return out
+}
+
+func runesOf(ss []srune) string {
+	var sb strings.Builder
+	for _, x := range ss {
+		sb.WriteRune(x.r)
+	}
+	return sb.String()
+}
+
+// lastSGR is what ansi.Writer.LastSequence should report after s: the SGR sequences since the
+// last reset.
+func lastSGR(s string) string {
+	ss := styled(s + "x")
+	return ss[len(ss)-1].style
+}
+
+func rw(r rune) int { return runewidth.RuneWidth(r) }
+
+// width is the printable cell width of s (sequences excluded), summing per rune as the
+// library does.
+func width(s string) int {
+	w := 0
+	for _, c := range strip(s) {
+		w += rw(c)
+	}
+	return w
+}
+
+func removeSpace(s string) string {
+	return strings.Map(func(r rune) rune {
+		if unicode.IsSpace(r) {
+			return -1
+		}
+		return r
+	}, s)
+}
+
+// ---------------------------------------------------------------- generators
+
+var (
+	wordRunes = []rune{'a', 'b', 'A', '0', '1', 'é', '日', '\U0001F600'}
+	sgrPool   = []string{"\x1b[31m", "\x1b[1m", "\x1b[4m", "\x1b[38;2;249;38;114m", "\x1b[0m", "\x1b[32;1m", "\x1b[0m"}
+)
+
+type docCfg struct {
+	ansi, hyphen, tab bool
+}
+
+// genWord: 1-5 runes, a breakpoint inside when allowed.
+func genWord(tc hegel.TestCase, cfg docCfg) string {
+	var sb strings.Builder
+	k := n(tc, 1, 5)
+	for i := 0; i < k; i++ {
+		if cfg.hyphen && i > 0 && chance(tc, 20) {
+			sb.WriteRune('-')
+		}
+		sb.WriteRune(pick(tc, wordRunes))
+	}
+	return sb.String()
+}
+
+// genDoc: words, runs of spaces, newlines, tabs (when allowed) and SGR sequences attached to
+// words (directly before the first or after the last rune of a word) when allowed.
+func genDoc(tc hegel.TestCase, cfg docCfg) string {
+	var sb strings.Builder
+	k := n(tc, 0, 8)
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 9) {
+		case 0:
+			sb.WriteString("\n")
+		case 1, 2:
+			sb.WriteString(strings.Repeat(" ", n(tc, 1, 3)))
+		case 3:
+			if cfg.tab {
+				sb.WriteString("\t")
+			} else {
+				sb.WriteString(" ")
+			}
+		default:
+			if cfg.ansi && chance(tc, 30) {
+				sb.WriteString(pick(tc, sgrPool))
+			}
+			sb.WriteString(genWord(tc, cfg))
+			if cfg.ansi && chance(tc, 30) {
+				sb.WriteString(pick(tc, sgrPool))
+			}
+		}
+	}
+	return sb.String()
+}
+
+// chunk splits s at random rune boundaries that are not inside an escape sequence.
+func chunk(tc hegel.TestCase, s string) []string {
+	var cuts []int
+	in := false
+	for i, c := range s {
+		if i > 0 && !in {
+			cuts = append(cuts, i)
+		}
+		if c == esc {
+			in = true
+		} else if in && ansi.IsTerminator(c) {
+			in = false
+		}
+	}
+	var chosen []int
+	for _, c := range cuts {
+		if chance(tc, 30) {
+			chosen = append(chosen, c)
+		}
+	}
+	var out []string
+	prev := 0
+	for _, c := range chosen {
+		out = append(out, s[prev:c])
+		prev = c
+	}
+	return append(out, s[prev:])
+}
+
+// splitLines: the segments between newlines; the last one is the text after the final newline
+// ("" when the input ends with one).
+func splitLines(s string) []string { return strings.Split(s, "\n") }
+
+// ---------------------------------------------------------------- word wrapping
+
+// TestHegelWordWrapKeepsLinesWithinTheLimit: wordwrap.String preserves every non-whitespace
+// rune and sequence in order, is transparent to escape sequences, and every output line fits
+// the limit unless it is a single unbreakable word. Lines containing a breakpoint (regexp
+// reflow/1) and limits of 1 and 2 (reflow/2) are pinned and not judged for width.
+func TestHegelWordWrapKeepsLinesWithinTheLimit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genDoc(ht, docCfg{ansi: true, hyphen: true})
+		limit := n(ht, 1, 12)
+		note(ht, "input=%q limit=%d", s, limit)
+		out := wordwrap.String(s, limit)
+		note(ht, "output=%q", out)
+		if removeSpace(out) != removeSpace(s) {
+			fail(ht, "wordwrap.String(%q, %d) = %q: non-whitespace content changed", s, limit, out)
+		}
+		if got, want := strip(out), wordwrap.String(strip(s), limit); got != want {
+			fail(ht, "wordwrap.String(%q, %d) = %q; stripped of sequences %q, but the stripped input wraps to %q", s, limit, out, got, want)
+		}
+		plain := strip(out)
+		if strings.Count(plain, "\n") < strings.Count(s, "\n") {
+			fail(ht, "wordwrap.String(%q, %d) = %q lost a newline", s, limit, out)
+		}
+		if limit <= 2 {
+			count("skip-width-limit-le-2")
+		} else {
+			for _, line := range splitLines(plain) {
+				if width(line) <= limit {
+					continue
+				}
+				if strings.ContainsRune(line, '-') {
+					count("skip-width-breakpoint-line")
+					note(ht, "line %q exceeds the limit with a breakpoint on it: pinned (reflow/1), not judged", line)
+					continue
+				}
+				// The last word of the line and what precedes it.
+				idx := strings.LastIndexFunc(line, unicode.IsSpace)
+				last, before := line[idx+1:], line[:idx+1]
+				if strings.TrimSpace(before) == "" && width(last) > limit {
+					count("unbreakable-line") // a word wider than the limit, possibly after leading spaces
+					continue
+				}
+				if width(last) >= limit && width(before) <= 2 {
+					// Pinned (reflow/2): a word at least as wide as the limit after at most two
+					// cells of content is not moved to its own line.
+					count("skip-width-word-as-wide-as-limit")
+					note(ht, "line %q: a word as wide as the limit after short content: pinned (reflow/2), not judged", line)
+					continue
+				}
+				fail(ht, "wordwrap.String(%q, %d) = %q: line %q is %d wide and breakable", s, limit, out, line, width(line))
+			}
+			if !strings.Contains(s, "-") {
+				if again := wordwrap.String(out, limit); again != out {
+					fail(ht, "wordwrap.String(%q, %d) = %q is not stable: wrapping it again gives %q", s, limit, out, again)
+				}
+			}
+		}
+		// KeepNewlines = false is documented as folding the text into one paragraph first.
+		w := wordwrap.NewWriter(limit)
+		w.KeepNewlines = false
+		_, _ = w.Write([]byte(s))
+		_ = w.Close()
+		folded := strings.ReplaceAll(strings.TrimSpace(s), "\n", " ")
+		if got, want := w.String(), wordwrap.String(folded, limit); got != want {
+			fail(ht, "KeepNewlines=false on %q: %q, want the wrap of the folded text %q = %q", s, got, folded, want)
+		}
+		count("compared")
+	})
+}
+
+// ---------------------------------------------------------------- unconditional wrapping
+
+// wrapModel: the documented rules — tabs become TabWidth spaces, newlines are dropped unless
+// kept, a rune that would exceed the limit starts a new line, and after such a forced break
+// leading whitespace is dropped unless PreserveSpace; escape sequences are copied and have no
+// width.
+func wrapModel(s string, limit int, keepNL, preserve bool, tabw int) string {
+	s = strings.ReplaceAll(s, "\t", strings.Repeat(" ", tabw))
+	if !keepNL {
+		s = strings.ReplaceAll(s, "\n", "")
+	}
+	if limit <= 0 {
+		return s
+	}
+	var out strings.Builder
+	lineLen := 0
+	forceful, in := false, false
+	for _, c := range s {
+		switch {
+		case c == esc:
+			in = true
+		case in:
+			if ansi.IsTerminator(c) {
+				in = false
+			}
+		case c == '\n':
+			out.WriteRune('\n')
+			lineLen = 0
+			forceful = false
+			continue
+		default:
+			w := rw(c)
+			if lineLen+w > limit {
+				out.WriteRune('\n')
+				lineLen = 0
+				forceful = true
+			}
+			if lineLen == 0 {
+				if forceful && !preserve && unicode.IsSpace(c) {
+					continue
+				}
+			} else {
+				forceful = false
+			}
+			lineLen += w
+		}
+		out.WriteRune(c)
+	}
+	return out.String()
+}
+
+// TestHegelWrapFollowsTheDocumentedRules: wrap.Wrap equals the model for every combination of
+// KeepNewlines, PreserveSpace and TabWidth, and writing in chunks equals one write. The
+// chunk that fits the limit whole is pinned (reflow/5, reflow/6) and not judged.
+func TestHegelWrapFollowsTheDocumentedRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genDoc(ht, docCfg{ansi: true, tab: true})
+		limit := n(ht, 1, 12)
+		keepNL, preserve := chance(ht, 70), chance(ht, 50)
+		tabw := n(ht, 1, 4)
+		note(ht, "input=%q limit=%d keepNewlines=%v preserveSpace=%v tabWidth=%d", s, limit, keepNL, preserve, tabw)
+		mk := func() *wrap.Wrap {
+			w := wrap.NewWriter(limit)
+			w.KeepNewlines, w.PreserveSpace, w.TabWidth = keepNL, preserve, tabw
+			return w
+		}
+		w := mk()
+		_, _ = w.Write([]byte(s))
+		got := w.String()
+		want := wrapModel(s, limit, keepNL, preserve, tabw)
+		expanded := strings.ReplaceAll(s, "\t", strings.Repeat(" ", tabw))
+		if !keepNL {
+			expanded = strings.ReplaceAll(expanded, "\n", "")
+		}
+		fits := width(expanded) <= limit
+		if fits && (strings.Contains(s, "\t") || (!keepNL && strings.Contains(s, "\n"))) {
+			count("skip-fast-path-tab-or-newline")
+			note(ht, "input fits the limit whole with a tab or a dropped newline: pinned (reflow/5), not judged")
+		} else {
+			if got != want {
+				fail(ht, "wrap of %q (limit %d, keepNewlines %v, preserveSpace %v, tabWidth %d) = %q, want %q", s, limit, keepNL, preserve, tabw, got, want)
+			}
+			count("compared")
+		}
+		if keepNL && tabw == 4 && !preserve {
+			if got2 := wrap.String(s, limit); got2 != got {
+				fail(ht, "wrap.String(%q, %d) = %q, but the default writer gives %q", s, limit, got2, got)
+			}
+		}
+		if !strings.ContainsAny(s, " \n\t") {
+			// With whitespace in the text a chunk that fits whole is written raw and skips the
+			// whitespace-dropping after a forced break: pinned (reflow/6), not judged.
+			w2 := mk()
+			for _, c := range chunk(ht, s) {
+				_, _ = w2.Write([]byte(c))
+			}
+			if w2.String() != got {
+				fail(ht, "wrap of %q in chunks = %q, in one write %q", s, w2.String(), got)
+			}
+			count("chunked")
+		} else {
+			count("skip-chunked-whitespace")
+		}
+	})
+}
+
+// ---------------------------------------------------------------- indentation
+
+// indentModel: every line that has at least one rune (a newline counts) is prefixed with the
+// indentation; the empty text after a final newline is not.
+func indentModel(ss []srune, prefix string) []srune {
+	var out []srune
+	atStart := true
+	for _, x := range ss {
+		if atStart {
+			for _, p := range prefix {
+				out = append(out, srune{p, ""})
+			}
+			atStart = false
+		}
+		out = append(out, x)
+		if x.r == '\n' {
+			atStart = true
+		}
+	}
+	return out
+}
+
+// TestHegelIndentPrefixesEveryLine: indent.String and the writers prefix every line, the
+// indentation carries no style and every input rune keeps its style; a custom IndentFunc is
+// applied Indent times.
+func TestHegelIndentPrefixesEveryLine(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genDoc(ht, docCfg{ansi: true})
+		ind := n(ht, 0, 4)
+		note(ht, "input=%q indent=%d", s, ind)
+		out := indent.String(s, uint(ind))
+		note(ht, "output=%q", out)
+		want := indentModel(styled(s), strings.Repeat(" ", ind))
+		if got := styled(out); !reflect.DeepEqual(got, want) {
+			fail(ht, "indent.String(%q, %d) = %q: styled runes %v, want %v", s, ind, out, got, want)
+		}
+		if strip(s) == s && out != runesOf(want) {
+			fail(ht, "indent.String(%q, %d) = %q, want %q", s, ind, out, runesOf(want))
+		}
+		dots := indent.NewWriter(uint(ind), func(w io.Writer) { _, _ = w.Write([]byte(".")) })
+		_, _ = dots.Write([]byte(s))
+		if got, want := styled(dots.String()), indentModel(styled(s), strings.Repeat(".", ind)); !reflect.DeepEqual(got, want) {
+			fail(ht, "indent with a '.' IndentFunc of %q (%d) = %q: styled runes %v, want %v", s, ind, dots.String(), got, want)
+		}
+		var fw bytes.Buffer
+		pipe := indent.NewWriterPipe(&fw, uint(ind), nil)
+		_, _ = pipe.Write([]byte(s))
+		if fw.String() != out {
+			fail(ht, "indent.NewWriterPipe forwards %q, indent.String gives %q", fw.String(), out)
+		}
+		count("compared")
+	})
+}
+
+// ---------------------------------------------------------------- padding
+
+// padModel: every line before a newline is padded to the width; the text after the last
+// newline only when it has printable width. Padding runes are marked with style "*" (not
+// judged).
+func padModel(ss []srune, w int, pad rune) []srune {
+	var out []srune
+	lineW := 0
+	flush := func(final bool) {
+		if (!final || lineW > 0) && lineW < w {
+			for i := lineW; i < w; i++ {
+				out = append(out, srune{pad, "*"})
+			}
+		}
+		lineW = 0
+	}
+	for _, x := range ss {
+		if x.r == '\n' {
+			flush(false)
+			out = append(out, srune{'\n', "*"}) // the style of a newline has no visible effect
+			continue
+		}
+		lineW += rw(x.r)
+		out = append(out, x)
+	}
+	flush(true)
+	return out
+}
+
+// sameStyled compares styled runes, "*" in want matching any style; withStyle false compares
+// runes only.
+func sameStyled(got, want []srune, withStyle bool) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range got {
+		if got[i].r != want[i].r {
+			return false
+		}
+		if withStyle && want[i].style != "*" && got[i].style != want[i].style {
+			return false
+		}
+	}
+	return true
+}
+
+// styleCrossesNewline: some rune after a newline is still styled (the shape pinned as reflow/8).
+func styleCrossesNewline(ss []srune) bool {
+	for i := 1; i < len(ss); i++ {
+		if ss[i-1].r == '\n' && ss[i].style != "" {
+			return true
+		}
+	}
+	return false
+}
