+// TestHegelTruncateCutsAtTheWidth: truncate.StringWithTail equals the model, the result is
+// never wider than the width, and its printable text is a prefix of the input plus the tail.
+// A tail wider than the width is pinned (reflow/12) and not judged.
+func TestHegelTruncateCutsAtTheWidth(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genDoc(ht, docCfg{ansi: true})
+		w := n(ht, 0, 12)
+		tail := pick(ht, tailPool)
+		note(ht, "input=%q width=%d tail=%q", s, w, tail)
+		if width(tail) > w {
+			count("skip-tail-wider-than-width")
+			note(ht, "tail wider than the width: pinned (reflow/12), not judged")
+			return
+		}
+		if sw := width(s); sw <= w && sw > w-width(tail) {
+			count("skip-fits-within-the-tail-reserve")
+			note(ht, "the text fits the width but not the width minus the tail: pinned (reflow/18), not judged")
+			return
+		}
+		got := truncate.StringWithTail(s, uint(w), tail)
+		want := truncateModel(s, w, tail)
+		if got != want {
+			fail(ht, "truncate.StringWithTail(%q, %d, %q) = %q, want %q", s, w, tail, got, want)
+		}
+		if width(got) > w && width(s) > w {
+			fail(ht, "truncate.StringWithTail(%q, %d, %q) = %q is %d wide", s, w, tail, got, width(got))
+		}
+		if plain := strip(got); width(s) > w {
+			if !strings.HasSuffix(plain, strip(tail)) || !strings.HasPrefix(strip(s), strings.TrimSuffix(plain, strip(tail))) {
+				fail(ht, "truncate.StringWithTail(%q, %d, %q) = %q: not a prefix of the input plus the tail", s, w, tail, got)
+			}
+		}
+		if tail == "" && truncate.String(s, uint(w)) != got {
+			fail(ht, "truncate.String and StringWithTail(\"\") differ on %q", s)
+		}
+		count("compared")
+	})
