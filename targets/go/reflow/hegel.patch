+	aw := &ansi.Writer{Forward: &fw}
+	_, _ = aw.Write(e[:1])
+	_, _ = aw.Write(e[1:])
+	if fw.String() != "é" {
+		t.Errorf("ansi.Writer: writing %q byte by byte forwards %q", "é", fw.String())
+	}
+}
+
+// TestHegelPinWritersPassInvalidBytesThrough (reflow/16): invalid UTF-8 bytes are replaced by
+// U+FFFD on the way through every writer.
+func TestHegelPinWritersPassInvalidBytesThrough(t *testing.T) {
+	defer guard(t)
+	in := "a\xffb"
+	got := map[string]string{
+		"indent":   indent.String(in, 1),
+		"padding":  padding.String(in, 4),
+		"truncate": truncate.String(in, 4),
+		"wordwrap": wordwrap.String(in, 4),
+		"wrap":     wrap.String(in, 1),
+	}
+	for name, out := range got {
+		if !strings.Contains(out, "\xff") {
+			t.Errorf("%s of %q = %q: the invalid byte was rewritten", name, in, out)
+		}
+	}
+}
+
+// TestHegelPinPrintableRuneWidthMeasuresGraphemeClusters (reflow/17): widths are summed per
+// rune, so ZWJ sequences and emoji modifiers count more than go-runewidth's StringWidth.
+func TestHegelPinPrintableRuneWidthMeasuresGraphemeClusters(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"\U0001F468‍\U0001F469", "\U0001F44D\U0001F3FD", "\U0001F468‍\U0001F469‍\U0001F467"} {
+		if got, want := ansi.PrintableRuneWidth(s), runewidth.StringWidth(s); got != want {
+			t.Errorf("PrintableRuneWidth(%q) = %d, runewidth.StringWidth %d", s, got, want)
+		}
+		if got := truncate.String(s, 2); got != s {
+			t.Errorf("truncate.String(%q, 2) = %q, but the text is %d cells wide", s, got, runewidth.StringWidth(s))
+		}
+	}
+}
+
+// TestHegelPinTruncateKeepsTextThatFits (reflow/18): the tail's width is reserved even when
+// the text fits, so text wider than width - tail is truncated although it fits the width.
+func TestHegelPinTruncateKeepsTextThatFits(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		in   string
+		w    int
+		tail string
+	}{{"ab", 2, "."}, {"Hello", 5, "\u2026"}, {"\u65e5\u672c", 4, "..."}, {"  ", 2, "."}} {
+		if got := truncate.StringWithTail(c.in, uint(c.w), c.tail); got != c.in {
+			t.Errorf("truncate.StringWithTail(%q, %d, %q) = %q, want the input: it is %d cells wide and fits", c.in, c.w, c.tail, got, width(c.in))
+		}
+	}
+}
+
+// TestHegelPinWordWrapFoldsAcrossWrites (reflow/19): with KeepNewlines = false every Write
+// call is trimmed on its own, so whitespace at a chunk boundary disappears.
+func TestHegelPinWordWrapFoldsAcrossWrites(t *testing.T) {
+	defer guard(t)
+	one := wordwrap.NewWriter(10)
+	one.KeepNewlines = false
+	_, _ = one.Write([]byte("a b"))
+	_ = one.Close()
+	two := wordwrap.NewWriter(10)
+	two.KeepNewlines = false
+	_, _ = two.Write([]byte("a "))
+	_, _ = two.Write([]byte("b"))
+	_ = two.Close()
+	if one.String() != two.String() {
+		t.Errorf("wordwrap (KeepNewlines=false) of %q in one write = %q, as %q then %q = %q", "a b", one.String(), "a ", "b", two.String())
+	}
+}
+
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	if got := wordwrap.String("Hello World!", 5); got != "Hello\nWorld!" {
+		t.Errorf("README wordwrap example: %q", got)
+	}
+	if got := wrap.String("Hello World!", 7); got != "Hello W\norld!" {
+		t.Errorf("README wrap example: %q", got)
+	}
+	if got := wrap.String(wordwrap.String("Just an example", 5), 5); got != "Just\nan\nexamp\nle" {
+		t.Errorf("README wrap+wordwrap example: %q", got)
+	}
+	if got := indent.String("Hello World!", 4); got != "    Hello World!" {
+		t.Errorf("README indent example: %q", got)
+	}
+	if got := dedent.String("    Hello World!\n  Hello World!\n"); got != "  Hello World!\nHello World!\n" {
+		t.Errorf("README dedent example: %q", got)
+	}
+	if got := padding.String("Hello", 8); got != "Hello   " {
+		t.Errorf("README padding example: %q", got)
+	}
+	_ = utf8.RuneLen
+}
