+// ---------------------------------------------------------------- dedent
+
+// dedentModel: the smallest indentation of the non-blank lines is removed from every line
+// (blank lines lose what they have, up to that much).
+func dedentModel(s string) string {
+	lines := splitLines(s)
+	common := -1
+	for _, l := range lines {
+		trimmed := strings.TrimLeft(l, " \t")
+		if trimmed == "" {
+			continue
+		}
+		if k := len(l) - len(trimmed); common < 0 || k < common {
+			common = k
+		}
+	}
+	if common <= 0 {
+		return s
+	}
+	for i, l := range lines {
+		k := len(l) - len(strings.TrimLeft(l, " \t"))
+		if k > common {
+			k = common
+		}
+		lines[i] = l[k:]
+	}
+	return strings.Join(lines, "\n")
+}
