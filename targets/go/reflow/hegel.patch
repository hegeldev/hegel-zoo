+		_, _ = w.Write(e[:1])
+		_, _ = w.Write(e[1:])
+		if c, ok := w.(interface{ Close() error }); ok {
+			_ = c.Close()
+		}
+		if !strings.Contains(w.String(), "é") {
+			t.Errorf("%s: writing %q byte by byte gives %q", name, "é", w.String())
+		}
