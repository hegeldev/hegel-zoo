+// ---------------------------------------------------------------- truncation
+
+// truncateModel: the input unchanged when it fits; otherwise the longest prefix (sequences
+// copied, no width) fitting width - tail width, the tail, and a reset if an SGR style is open.
+func truncateModel(s string, w int, tail string) string {
+	if width(s) <= w {
+		return s
+	}
+	budget := w - width(tail)
+	var out strings.Builder
+	cur := 0
+	in := false
+	var seq strings.Builder
+	open := false
+	for _, c := range s {
+		switch {
+		case c == esc:
+			in = true
+			seq.Reset()
+			seq.WriteRune(c)
+		case in:
+			seq.WriteRune(c)
+			if ansi.IsTerminator(c) {
+				in = false
+				if c == 'm' {
+					open = !strings.HasSuffix(seq.String(), "[0m")
+				}
+			}
+		default:
+			cur += rw(c)
+			if cur > budget {
+				out.WriteString(tail)
+				if open {
+					out.WriteString("\x1b[0m")
+				}
+				return out.String()
+			}
+		}
+		out.WriteRune(c)
+	}
+	return out.String()
+}
