+// TestHegelRewriteAgreesWithVersion1: v2 against goldmark v1.8.6 for both configurations.
+func TestHegelRewriteAgreesWithVersion1(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, proseDocs)
+		col.count("cases")
+		skipKnown(ht, col, src, commonMarkShapes)
+		got, want := v1Shape(render(cmP, cmR, src)), v1Shape(renderV1(v1cm, src))
+		which := "CommonMark"
+		if got == want {
+			if k := skipClass(src, gfmShapes); k != "" {
+				// the CommonMark halves agree; under HEGEL_NO_KNOWN=1 the GFM halves are not
+				// compared on the shapes of the GFM bugs
+				col.count(k)
+				return
+			}
+			got, want = v1Shape(render(gfmP, gfmR, src)), v1Shape(renderV1(v1gfm, src))
+			which = "GFM"
+		}
+		if got == want {
+			col.count("ok")
+			return
+		}
+		if c := classify(got, want); c != "" {
+			col.count(c)
+			return
+		}
+		if col.accepted(src, commonMarkShapes, gfmShapes) {
+			return
+		}
+		if v1BlankLineShape(got) == v1BlankLineShape(want) {
+			// v1 kept a space from a whitespace-only line inside indented code; v2 does not
+			col.count("v1-blank-line-in-code")
+			return
+		}
+		// A difference where v2 agrees with the reference implementation (commonmark.js, or
+		// micromark+gfm for the GFM configuration) is a v1 bug that v2 fixed, not a regression:
+		// v1 takes a hyphens-only lazy continuation line as a table delimiter row (">a\n--").
+		lf := strings.ReplaceAll(strings.ReplaceAll(src, "\r\n", "\n"), "\r", "\n")
+		p, r, ref := cmP, cmR, "cm"
+		if which == "GFM" {
+			p, r, ref = gfmP, gfmR, "gfm"
+		}
+		if v2, spec := gfmShape(render(p, r, lf)), gfmShape(oracle(ht, ref, lf)); v2 == spec || classify(v2, spec) != "" || (ref == "gfm" && classifyMicromark(v2, spec) != "") {
+			col.count("v1-bug")
+			return
+		}
+		col.mismatch(ht, bugsOf(src, commonMarkShapes, gfmShapes), "%s src %s\n v2 %s\n v1 %s", which, show(src), show(got), show(want))
+	})
+}
