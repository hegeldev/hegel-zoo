+// linkifyProse: one to six words or GFM autolink literals, each followed by one of the
+// characters an autolink literal may start after (whitespace, punctuation and a space, or
+// one of ( * _ ~).
+var (
+	linkifyPieces = cat(
+		weighted(choice[string]{40, wordTexts}, choice[string]{60, hegel.SampledFrom(bareGfm)}),
+		pick(" ", " ", "\n", ", ", ". ", "(", "*", "_", "~"),
+	)
+	linkifyProse = joined(many(linkifyPieces, 1, 6), "")
+)
