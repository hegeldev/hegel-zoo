+// TestHegelLinkifyAgreesWithGfmAutolinkLiterals: the Linkify extension against micromark's
+// GFM autolink literals, on prose with bare URLs and addresses.
+func TestHegelLinkifyAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		var b strings.Builder
+		for i, count := 0, n(ht, 1, 6); i < count; i++ {
+			if chance(ht, 60) {
+				b.WriteString(pick(ht, bareGfm))
+			} else {
+				b.WriteString(pick(ht, words))
+			}
+			// GFM autolink literals start at a line start, after whitespace or after ( * _ ~.
+			b.WriteString(pick(ht, []string{" ", " ", "\n", ", ", ". ", "(", "*", "_", "~"}))
+		}
+		src := b.String()
+		if k := knownShape(src); k != "" {
+			col.count(k)
+			return
+		}
+		if k := knownLinkifyShape(src); k != "" {
+			col.count(k)
+			return
+		}
+		got := gfmShape(render(linkP, cmR, src))
+		want := gfmShape(oracle(ht, "linkify", src))
+		if got == want {
+			col.count("ok")
+			return
+		}
+		col.count("mismatch")
+		col.fail(ht, "src %s\n goldmark %s\n micromark %s", show(src), show(got), show(want))
+	})
+}
+
+// --------------------------------------------------------------------------- invariants
+
+var (
+	reTag      = regexp.MustCompile(`(?s)<(/?)([a-zA-Z][a-zA-Z0-9]*)((?:\s+[a-zA-Z:-]+(?:="[^"]*")?)*)\s*(/?)>|<!--.*?-->|&([a-zA-Z0-9#]+;)|[<>&"]`)
+	voidTags   = map[string]bool{"hr": true, "br": true, "img": true, "input": true}
+	reBadURL   = regexp.MustCompile(`(?i)^\s*(javascript|vbscript|file|data):`)
+	reAttrPair = regexp.MustCompile(`([a-zA-Z:-]+)="([^"]*)"`)
+	reEntity   = regexp.MustCompile(`^&(#[0-9]{1,7}|#[xX][0-9a-fA-F]{1,6}|[a-zA-Z][a-zA-Z0-9]{1,31});$`)
+)
+
+// checkHTML: balanced tags, quoted attributes, every & an escape, no dangerous href/src.
+func checkHTML(h string) string {
+	var stack []string
+	for _, m := range reTag.FindAllStringSubmatch(h, -1) {
+		t := m[0]
+		switch {
+		case strings.HasPrefix(t, "<!--"):
+			if t != "<!-- raw HTML omitted -->" {
+				return "unexpected comment " + t
+			}
+		case t == "<" || t == ">" || t == "\"":
+			return "bare " + t
+		case t == "&":
+			return "bare &"
+		case strings.HasPrefix(t, "&"):
+			if !reEntity.MatchString(t) {
+				return "bad entity " + t
+			}
+		default:
+			name := strings.ToLower(m[2])
+			if m[1] == "/" {
+				if len(stack) == 0 || stack[len(stack)-1] != name {
+					return "unbalanced " + t
+				}
+				stack = stack[:len(stack)-1]
+				continue
+			}
+			for _, a := range reAttrPair.FindAllStringSubmatch(m[3], -1) {
+				if (a[1] == "href" || a[1] == "src") && (reBadURL.MatchString(a[2]) && !strings.HasPrefix(strings.ToLower(a[2]), "data:image/")) {
+					return "dangerous URL " + t
+				}
+			}
+			if strings.TrimSpace(reAttrPair.ReplaceAllString(m[3], "")) != "" {
+				return "unquoted attribute " + t
+			}
+			if voidTags[name] || m[4] == "/" {
+				continue
+			}
+			stack = append(stack, name)
+		}
+	}
+	if len(stack) != 0 {
+		return "unclosed " + strings.Join(stack, ",")
+	}
+	return ""
+}
