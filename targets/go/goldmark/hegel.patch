+func TestHegelRenderingTimeIsNotSuperLinear(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var parts []string
+		for i, count := 0, n(ht, 1, 4); i < count; i++ {
+			parts = append(parts, pick(ht, units))
+		}
+		unit := strings.Join(parts, "")
+		p, r := allP, allR
+		if chance(ht, 50) {
+			p, r = cmP, cmR
+		}
+		timeIt := func(k int) time.Duration {
+			src := strings.Repeat(unit, k)
+			start := time.Now()
+			render(p, r, src)
+			return time.Since(start)
+		}
+		small, big := timeIt(1500), timeIt(6000)
+		if big > 3*time.Second && big > 25*small {
+			ht.Fatalf("unit %s: 1500 repeats %v, 6000 repeats %v", show(unit), small, big)
+		}
+	})
+}
