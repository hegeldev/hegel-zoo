+	reTableish          = regexp.MustCompile(`(^|\n)[ \t>]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*\r?(\n|$)`)
+	reIndentedDelimiter = regexp.MustCompile(`\n( {4}| {0,3}\t)[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*\r?(\n|$)`)
