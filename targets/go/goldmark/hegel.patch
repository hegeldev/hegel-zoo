+// itemContainer: the line prefix that opens a container and the one that continues it.
+type itemContainer struct{ first, next string }
+
+// tabAfterMarkerInContainer: goldmark/28's shape region. A list marker inside a block quote or
+// an outer list item, whitespace with a tab in it, plain text; half the time a second,
+// space-indented line of the item. The container puts the marker off a tab stop, so the tab's
+// width, and with it the five-column indented-code rule and the item's content indent, depends
+// on whether it is measured from the line start or from the container's content start.
+var tabAfterMarkerInContainer = hegel.Composite(func(tc hegel.TestCase) string {
+	c := hegel.Draw(tc, hegel.SampledFrom([]itemContainer{{"> ", "> "}, {">", ">"}, {">  ", ">  "}, {"- ", "  "}, {"1. ", "   "}, {"> - ", ">   "}}))
+	marker := hegel.Draw(tc, hegel.SampledFrom([]string{"-", "*", "+", "1.", "0)", "12."}))
+	gap := hegel.Draw(tc, hegel.SampledFrom([]string{"\t", "\t\t", " \t", "\t ", "  \t", " \t\t", "\t\t\t"}))
+	plain := hegel.Text().Alphabet("abxy").MinSize(1).MaxSize(4)
+	src := c.first + marker + gap + hegel.Draw(tc, plain) + "\n"
+	if indent := hegel.Draw(tc, hegel.Optional(hegel.SampledFrom([]string{"  ", "    ", "      "}))); indent != nil {
+		src += c.next + *indent + hegel.Draw(tc, plain) + "\n"
+	}
+	return src
+})
+
+// TestHegelTabAfterMarkerInContainerAgreesWithCommonmarkJs: the CommonMark configuration
+// against commonmark.js on goldmark/28's region alone.
