+// --------------------------------------------------------------------------- typographer
+
+// typographerModel: the documented substitutions of runs of - . < > in plain text, longest
+// match first, left to right (quotes are left to the fixtures).
+func typographerModel(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		switch {
+		case strings.HasPrefix(s[i:], "---"):
+			b.WriteString("—")
+			i += 3
+		case strings.HasPrefix(s[i:], "--"):
+			b.WriteString("–")
+			i += 2
+		case strings.HasPrefix(s[i:], "..."):
+			b.WriteString("…")
+			i += 3
+		case strings.HasPrefix(s[i:], "<<"):
+			b.WriteString("«")
+			i += 2
+		case strings.HasPrefix(s[i:], ">>"):
+			b.WriteString("»")
+			i += 2
+		default:
+			b.WriteByte(s[i])
+			i++
+		}
+	}
+	return b.String()
+}
+
+func TestHegelTypographerMatchesTheDocumentedTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var b strings.Builder
+		b.WriteString(pick(ht, []string{"a", "foo", "x"}))
+		for i, count := 0, n(ht, 1, 8); i < count; i++ {
+			b.WriteString(pick(ht, []string{" ", "", "a", "b ", "-", "--", "---", "----", ".", "..", "...", "....", "<<", ">>", "<< ", " >>", "1", ", "}))
+		}
+		b.WriteString(pick(ht, []string{"a", "z", "."}))
+		src := b.String()
+		if strings.Contains(src, "<<a") || strings.Contains(src, "<<b") || strings.Contains(src, "<<1") {
+			return // <a, <b... would be raw HTML or autolink territory
+		}
+		want := "<p>" + typographerModel(src) + "</p>\n"
+		got := render(typoP, cmR, src)
+		if got != want {
+			ht.Fatalf("src %s\n goldmark %s\n model %s", show(src), show(got), show(want))
+		}
+	})
+}
