+
+// tableCells counts the cells of a table row the GFM way: leading and trailing pipes trimmed,
+// unescaped pipes separate.
+func tableCells(line string) int {
+	l := strings.TrimSpace(strings.ReplaceAll(line, "\\|", "  "))
+	l = strings.TrimPrefix(l, "|")
+	l = strings.TrimSuffix(l, "|")
+	return strings.Count(l, "|") + 1
+}
+
+// tableCellCountDiffers: a delimiter row whose cell count differs from the line before it.
+func tableCellCountDiffers(src string) bool {
+	lines := strings.Split(src, "\n")
+	for i := range lines {
+		lines[i] = strings.TrimRight(reMarkerPrefix.ReplaceAllString(lines[i], ""), "\r")
+	}
+	for i := 1; i < len(lines); i++ {
+		if reDelimiterRow.MatchString(lines[i]) && strings.Contains(lines[i]+lines[i-1], "|") && strings.TrimSpace(lines[i-1]) != "" &&
+			tableCells(lines[i]) != tableCells(lines[i-1]) {
+			return true
+		}
+	}
+	return false
+}
+
+// shapeRule is one shape a classifier recognises in a document's source: a recorded bug's,
+// gated by its Known switch (named on a mismatch; skipped before judging under
+// HEGEL_NO_KNOWN=1), or an accepted or ambiguous difference, which excuses a mismatch.
+type shapeRule struct {
+	bug   string // the recorded bug, "" for an accepted or ambiguous difference
+	class string // the counted class
+	on    *bool  // the Known switch; nil for a shape that is always skipped
+	match func(src string) bool
+}
+
+func matching(re *regexp.Regexp) func(string) bool { return re.MatchString }
+
+func containing(s string) func(string) bool {
+	return func(src string) bool { return strings.Contains(src, s) }
+}
+
+// commonMarkShapes: the CommonMark bugs' shapes and one accepted difference, in the order the
+// classifier tries them.
+var commonMarkShapes = []shapeRule{
+	{"goldmark/1", "known-bom", &Known.bomIsText, func(s string) bool { return strings.HasPrefix(s, "\xEF\xBB\xBF") }},
