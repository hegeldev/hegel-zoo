+	reOneStar   = regexp.MustCompile(`(^|[^*])\*([^*]|$)`)
+	reTwoStar   = regexp.MustCompile(`(^|[^*])\*\*([^*]|$)`)
+	reThreeStar = regexp.MustCompile(`(^|[^*])\*\*\*([^*]|$)`)
