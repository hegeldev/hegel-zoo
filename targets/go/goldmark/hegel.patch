+// --------------------------------------------------------------------------- differential properties
+
+func show(s string) string { return strconv.Quote(s) }
+
+// TestHegelCommonMarkAgreesWithCommonmarkJs: the CommonMark configuration against the reference
+// implementation, byte for byte; micromark's verdict is added to every mismatch.
+func TestHegelCommonMarkAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	bareUrls = false
+	defer func() { bareUrls = true }()
+	property(t, func(ht *hegel.T) {
+		src := genDocument(ht)
+		if k := knownShape(src); k != "" {
+			col.count(k)
+			return
+		}
+		got := render(cmP, cmR, src)
+		want := oracle(ht, "cm", src)
+		if got == want {
+			col.count("ok")
+			return
+		}
+		if c := classify(got, want); c != "" {
+			col.count(c)
+			return
+		}
+		if reDefThenRule.MatchString(src) {
+			// commonmark.js writes an empty paragraph for a link reference definition followed by
+			// a "---" line; micromark and goldmark agree it is a bare <hr />
+			col.count("accepted-cmjs-quirk")
+			return
+		}
+		mm := oracle(ht, "mm", src)
+		verdict := "micromark agrees with commonmark.js"
+		if classify(got, mm) != "" || classifyMicromark(got, mm) != "" {
+			verdict = "micromark agrees with goldmark"
+		} else if classify(want, mm) == "" && classifyMicromark(want, mm) == "" {
+			verdict = "micromark differs from both: " + show(mm)
+		}
+		if verdict == "micromark agrees with goldmark" {
+			// commonmark.js alone disagrees: its quirks (README) rather than goldmark's bugs
+			col.count("accepted-cmjs-quirk")
+			return
+		}
+		col.count("mismatch")
+		col.fail(ht, "src %s\n goldmark %s\n commonmark.js %s\n (%s)", show(src), show(got), show(want), verdict)
+	})
+}
