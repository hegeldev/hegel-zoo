+// --------------------------------------------------------------------------- differential properties
+
+func show(s string) string { return strconv.Quote(s) }
+
+// The document generators (hegel_gen_test.go), one per configuration, built at init: the
+// CommonMark and GFM differentials draw no bare URLs or e-mail addresses (GFM autolink
+// literals are the Linkify property's business), the other properties do.
+var (
+	plainDocs = documents(docConfig{bareUrls: false})
+	proseDocs = documents(docConfig{bareUrls: true})
+)
+
+// TestHegelCommonMarkAgreesWithCommonmarkJs: the CommonMark configuration against the reference
+// implementation, byte for byte; micromark's verdict is added to every mismatch, and the
+// recorded bugs whose shape the document has are named.
+func TestHegelCommonMarkAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, plainDocs)
+		col.count("cases")
+		skipKnown(ht, col, src, commonMarkShapes)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// judgeCommonMark counts an agreement between goldmark and commonmark.js or an accepted shape,
+// and fails the case on a mismatch with micromark's verdict attached and the recorded bugs
+// whose shape the source has named.
+func judgeCommonMark(ht *hegel.T, col *collector, src, got, want string) {
+	if got == want {
+		col.count("ok")
+		return
+	}
+	if c := classify(got, want); c != "" {
+		col.count(c)
+		return
+	}
+	if col.accepted(src, commonMarkShapes) {
+		return
+	}
+	if reDefThenRule.MatchString(src) {
+		// commonmark.js writes an empty paragraph for a link reference definition followed by
+		// a "---" line; micromark and goldmark agree it is a bare <hr />
+		col.count("accepted-cmjs-quirk")
+		return
+	}
+	mm := oracle(ht, "mm", src)
+	verdict := "micromark agrees with commonmark.js"
+	if mm == want || classify(want, mm) != "" {
+		// exactly or presentation aside: not a commonmark.js quirk, whatever micromark's
+		// emphasis-stripped reading of goldmark's output says
+	} else if classify(got, mm) != "" || classifyMicromark(got, mm) != "" {
+		verdict = "micromark agrees with goldmark"
+	} else if classifyMicromark(want, mm) == "" {
+		verdict = "micromark differs from both: " + show(mm)
+	}
+	if verdict == "micromark agrees with goldmark" {
+		// commonmark.js alone disagrees: its quirks (README) rather than goldmark's bugs
+		col.count("accepted-cmjs-quirk")
+		return
+	}
+	col.mismatch(ht, bugsOf(src, commonMarkShapes), "src %s\n goldmark %s\n commonmark.js %s\n (%s)", show(src), show(got), show(want), verdict)
+}
