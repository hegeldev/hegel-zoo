+	{"candidate/go/goldmark-3", "candidate-email-after-punctuation", &Known.emailAfterPunctuationNotLinked, matching(reEmailAfterPunct)},
+	{"candidate/go/goldmark-4", "candidate-hyphen-last-segment", &Known.hyphenInLastDomainSegmentEndsLink, matching(reHyphenLastSegment)},
+	// An email autolink whose domain has "_" right before a www./http:// start: the spec allows
+	// "_" in the domain, so the two readings (one email, or text then a URL) are both defensible.
+	{"", "ambiguous-email-domain-underscore", nil, matching(reLinkifyDomainUs)},
+	// micromark starts a new autolink right after ")" where the spec's paragraph on trailing
+	// parentheses only trims trailing ones.
+	{"", "micromark-restart-after-paren", nil, matching(reLinkifyAfterParen)},
+	{"", "ambiguous-uppercase-scheme", nil, containing("HTTP://")},
+	{"", "ambiguous-pipe", nil, containing("|")},
+	// A quote right after a URL: micromark strips it as trailing punctuation, goldmark keeps it;
+	// the GFM list of trailing punctuation has neither ' nor ".
+	{"", "ambiguous-trailing-quote", nil, matching(reLinkifyQuote)},
+}
+
+// gfmShapes: the GFM-only known bugs, micromark's own readings and the shapes the GFM text
+// leaves open.
+var gfmShapes = []shapeRule{
+	{"goldmark/8", "known-table-cell-count", &Known.tableCellCountIgnored, tableCellCountDiffers},
+	{"goldmark/31", "known-strikethrough-run-lengths", &Known.strikethroughRunsDiffer, func(s string) bool {
+		return strings.Contains(s, "~~") && reLoneTilde.MatchString(s)
+	}},
+	{"goldmark/32", "known-escaped-pipe-row-end", &Known.escapedPipeEndsRow, matching(reEscapedPipeEnd)},
+	// micromark opens emphasis on a "*" that the flanking rules refuse when "_" follows it
+	// (`a*_x_*`); commonmark.js and goldmark agree.
+	{"", "micromark-core-quirk", nil, matching(reMixedEmphasis)},
+	{"goldmark/29", "known-indented-delimiter-row", &Known.indentedDelimiterRowMakesTable, matching(reIndentedDelimiter)},
+	// Raw HTML inside image alt text: goldmark and cmark drop it, micromark and commonmark.js
+	// copy it (README).
+	{"", "accepted-alt-raw-html", nil, matching(reAltRawHTML)},
+	// A body row indented four or more columns: micromark ends the table and reads indented
+	// code, goldmark reads a row; the GFM spec says nothing about row indentation.
+	{"", "ambiguous-indented-row", nil, func(s string) bool {
+		return strings.Contains(s, "|") && reIndentedRow.MatchString(s) && reTableish.MatchString(s)
+	}},
+	// A header row of pipes only (micromark: no table; cmark-gfm: a table with an empty header)
+	// and tildes touching emphasis delimiters (micromark reads them differently) are ambiguous.
+	{"", "ambiguous-empty-header", nil, matching(reEmptyHeader)},
+	{"", "ambiguous-tilde-emphasis", nil, matching(reTildeEmphasis)},
+}
+
+// skipClass is the class of the first recorded bug's shape of the lists that the source has
+// and whose switch is on (HEGEL_NO_KNOWN=1); "" otherwise, and always by default.
+func skipClass(src string, lists ...[]shapeRule) string {
+	for _, rules := range lists {
+		for _, r := range rules {
+			if r.on != nil && *r.on && r.match(src) {
+				return r.class
+			}
+		}
+	}
+	return ""
+}
+
+// acceptedClass is the class of the first shape of the lists that the source has, if that is
+// an accepted or ambiguous one; "" otherwise (no shape, or a recorded bug's shape first: the
+// lists are in precedence order, and such a mismatch is named, not excused).
+func acceptedClass(src string, lists ...[]shapeRule) string {
+	for _, rules := range lists {
+		for _, r := range rules {
+			if r.match(src) {
+				if r.on == nil {
+					return r.class
+				}
+				return ""
+			}
+		}
+	}
+	return ""
+}
+
+// bugsOf names every recorded bug of the lists whose shape the source has, switches aside: it
+// is consulted on a mismatch, to say which bug a failing document has the shape of (none: a
+// shape no regex knows).
+func bugsOf(src string, lists ...[]shapeRule) []string {
+	var bugs []string
+	for _, rules := range lists {
+		for _, r := range rules {
+			if r.bug != "" && r.match(src) && !slices.Contains(bugs, r.bug) {
+				bugs = append(bugs, r.bug)
+			}
+		}
+	}
+	return bugs
+}
