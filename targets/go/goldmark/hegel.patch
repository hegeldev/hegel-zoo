+// --------------------------------------------------------------------------- fixtures
+
+// TestHegelPinUpstreamFixturesStillPass: the 652 spec examples through upstream's own driver.
+func TestHegelPinUpstreamFixturesStillPass(t *testing.T) {
+	bs, err := os.ReadFile("testdata/spec.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var specCases []struct {
+		Markdown string `json:"markdown"`
+		HTML     string `json:"html"`
+		Example  int    `json:"example"`
+	}
+	if err := json.Unmarshal(bs, &specCases); err != nil {
+		t.Fatal(err)
+	}
+	var cases []testutil.MarkdownTestCase
+	for _, c := range specCases {
+		cases = append(cases, testutil.MarkdownTestCase{No: c.Example, Markdown: c.Markdown, Expected: c.HTML})
+	}
+	testutil.DoTestCases(testutil.NewMarkdownToStringFunc(cmP, cmR), cases, t)
+}
