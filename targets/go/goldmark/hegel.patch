+package goldmark_test
+
+// Hegel property tests for goldmark v2 (github.com/yuin/goldmark/v2), written for the Hegel zoo.
+// See targets/go/goldmark/README.md.
+//
+// Oracles: commonmark.js 0.31.2 (the reference implementation) and micromark 4 with its GFM
+// table/strikethrough/task-list/autolink-literal extensions, run as one node child process
+// (hegel_oracle.mjs, packages under .hegel/ installed by the target's setup); goldmark v1.8.6,
+// the last release before the v2 rewrite, imported as a module of its own; models of the
+// util package, the typographer table and the auto heading ids.
+//
+// The documents come from the generators of hegel_gen_test.go: a tree of small records
+// rendered to Markdown by pure functions, built once per configuration. The shapes of the
+// recorded bugs (bugs.toml) are drawn at their natural rate: a differential property judges
+// every document and, on a mismatch, names the recorded bugs whose shape the document has
+// (the regexes over-approximate, so a known-shape document the oracle agrees on is simply
+// ok). The wide properties are therefore the expected failures mapped to the bugs they find,
+// beside the pins (hegel_pins_test.go) and the narrow properties, one per bug (the ten below
+// and hegel_shapes_test.go). HEGEL_NO_KNOWN=1 (noKnown, read once) switches the known shapes
+// off: the generators stop drawing a BOM, lone carriage returns and NUL bytes, and the
+// classifiers skip a document of a recorded bug's shape before it is judged.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the differential properties record their
+// mismatches instead of failing (one long run lists every remaining shape at once) and
+// print the class counts, which is how the skip rates are measured.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/yuin/goldmark/v2/ast"
+	"github.com/yuin/goldmark/v2/extension"
+	extast "github.com/yuin/goldmark/v2/extension/ast"
+	"github.com/yuin/goldmark/v2/parser"
+	"github.com/yuin/goldmark/v2/renderer"
+	"github.com/yuin/goldmark/v2/renderer/html"
+	"github.com/yuin/goldmark/v2/testutil"
+	"github.com/yuin/goldmark/v2/util"
+
+	gm1 "github.com/yuin/goldmark"
+	ext1 "github.com/yuin/goldmark/extension"
+	html1 "github.com/yuin/goldmark/renderer/html"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// noKnown: HEGEL_NO_KNOWN=1, read once, switches the shapes of the recorded bugs off (STYLE.md
+// rule 11): the generators stop drawing the shapes of bugs 1, 2 and 7 (a BOM, lone carriage
+// returns, NUL bytes) and the classifiers skip a document of a recorded bug's shape before it is
+// judged. By default every shape is drawn and judged, and a mismatch names the bug.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// collector counts the classes of every generated case (gates, accepted shapes, mismatches)
+// and, in collect mode, records mismatches instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// fail records a mismatch (collect mode) or fails the test case.
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch records a disagreement with the oracle on a case whose recorded shapes are named
+// (none for a document no bug's regex matches): the shapes are counted and the failure names
+// them, so that a wide property's shrunk failure says which bug it found.
+func (c *collector) mismatch(ht *hegel.T, bugs []string, format string, args ...any) {
+	for _, b := range bugs {
+		c.count("shape " + b)
+	}
+	if len(bugs) > 0 {
+		format += "\n (the shape of " + strings.Join(bugs, ", ") + ")"
+	} else {
+		c.count("mismatch-unnamed")
+	}
+	c.count("mismatch")
+	c.fail(ht, format, args...)
+}
+
+// skipKnown counts and assumes away, under HEGEL_NO_KNOWN=1, a document of a recorded bug's
+// shape (skipClass); by default nothing is skipped before judging.
+func skipKnown(ht *hegel.T, col *collector, src string, lists ...[]shapeRule) {
+	if k := skipClass(src, lists...); k != "" {
+		col.count(k)
+		ht.Assume(false)
+	}
+}
+
+// accepted counts a mismatching document of an accepted or ambiguous shape (the differences
+// the README records as not goldmark's bugs) and reports whether it was one; these shapes are
+// consulted after judging, so that a document of the shape the two sides agree on is simply ok.
+func (c *collector) accepted(src string, lists ...[]shapeRule) bool {
+	if k := acceptedClass(src, lists...); k != "" {
+		c.count(k)
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- generator idioms
+// hegel-go has no weighted choice, biased coin, optional with a probability or tuple
+// combinator; these are the zoo's spellings.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value (the empty string for
+// text) otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// counted is a list of lo to hi elements with the count drawn first: Lists with a MaxSize alone
+// almost never draws the empty list, and here the empty case (an empty emphasis, a table of
+// its header alone) is a shape of its own.
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	sizes := make([]hegel.Generator[[]T], hi-lo+1)
+	for k := range sizes {
+		sizes[k] = hegel.Lists(g).MinSize(lo + k).MaxSize(lo + k)
+	}
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(k int) hegel.Generator[[]T] { return sizes[k-lo] })
+}
+
+// joined is the texts of a list generator joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// cat draws one text from each generator and concatenates them (a tuple of texts; a Composite
+// only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// pair holds two independent draws as one value.
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// shaped is the value (a generator, a text) for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it; it needs an explicit type argument
+// when the two are different generator types.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- oracle child
+
+var (
+	oracleOnce sync.Once
+	oracleErr  error
+	oracleMu   sync.Mutex
+	oracleIn   *bufio.Writer
+	oracleOut  *bufio.Reader
+)
+
+func startOracle() {
+	node := os.Getenv("HEGEL_NODE")
+	if node == "" {
+		node = "node"
+	}
+	cmd := exec.Command(node, "hegel_oracle.mjs")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleIn, oracleOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+type fataler interface {
+	Fatalf(format string, args ...any)
+}
+
+// oracle renders src with the named oracle: "cm" commonmark.js, "mm" micromark CommonMark,
+// "gfm" micromark + tables/strikethrough/task lists, "linkify" micromark + autolink literals.
+func oracle(t fataler, mode, src string) string {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("cannot start the node oracle (node 22 and the .hegel/ packages are needed): %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"m": mode, "src": src})
+	oracleIn.Write(req)
+	oracleIn.WriteByte('\n')
+	if err := oracleIn.Flush(); err != nil {
+		t.Fatalf("writing to the oracle: %v", err)
+	}
+	line, err := oracleOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from the oracle: %v", err)
+	}
+	var resp struct {
+		HTML string `json:"html"`
+		Err  string `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad oracle response %q: %v", line, err)
+	}
+	if resp.Err != "" {
+		t.Fatalf("oracle %s failed: %s", mode, resp.Err)
+	}
+	return resp.HTML
+}
+
+// --------------------------------------------------------------------------- goldmark configurations
+
+func render(p parser.Parser, r renderer.Renderer[io.Writer], src string) string {
+	var b bytes.Buffer
+	bs := []byte(src)
+	if err := r.Render(&b, bs, p.Parse(bs)); err != nil {
+		panic(err)
+	}
+	return b.String()
+}
+
+var (
+	// CommonMark as upstream's spec test configures it.
+	cmP = parser.New()
+	cmR = html.New(html.WithXHTML(), html.WithUnsafe())
+	// GFM tables, strikethrough and task lists (linkify has its own property).
+	gfmP = parser.New(parser.WithExtensions(extension.NewTableParser(), extension.NewStrikethroughParser(), extension.NewTaskListItemParser()))
+	gfmR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithExtensions(extension.NewTableHTMLRenderer(), extension.NewStrikethroughHTMLRenderer(), extension.NewTaskListItemHTMLRenderer()))
+	// Linkify alone.
+	linkP = parser.New(parser.WithExtensions(extension.NewLinkifyParser()))
+	// Everything (upstream's fuzz configuration), unsafe and safe renderers.
+	allP = parser.New(parser.WithAutoHeadingID(), parser.WithAttribute(), parser.WithExtensions(
+		extension.NewDefinitionListParser(), extension.NewFootnoteParser(), extension.NewGFMParser(), extension.NewTypographerParser()))
+	allR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithExtensions(
+		extension.NewDefinitionListHTMLRenderer(), extension.NewFootnoteHTMLRenderer(), extension.NewGFMHTMLRenderer()))
+	safeR = html.New(html.WithExtensions(
+		extension.NewDefinitionListHTMLRenderer(), extension.NewFootnoteHTMLRenderer(), extension.NewGFMHTMLRenderer()))
+	hardR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithHardWraps())
+	idP   = parser.New(parser.WithAutoHeadingID())
+	typoP = parser.New(parser.WithExtensions(extension.NewTypographerParser()))
+	// goldmark v1.8.6, the same configurations.
+	v1cm  = gm1.New(gm1.WithRendererOptions(html1.WithXHTML(), html1.WithUnsafe()))
+	v1gfm = gm1.New(gm1.WithRendererOptions(html1.WithXHTML(), html1.WithUnsafe()), gm1.WithExtensions(ext1.Table, ext1.Strikethrough, ext1.TaskList))
+)
+
+func renderV1(md gm1.Markdown, src string) string {
+	var b bytes.Buffer
+	if err := md.Convert([]byte(src), &b); err != nil {
+		panic(err)
+	}
+	return b.String()
+}
+
+// Known bugs: a switch per recorded bug (see bugs.toml). Every switch is off by default, so the
+// generators draw each bug's shape and the classifiers below do not skip it: the property
+// judges the document and a mismatch names the bugs whose shape it has (bugsOf). HEGEL_NO_KNOWN=1
+// turns every switch on: the generators stop drawing a BOM, lone carriage returns and NUL
+// bytes (bugs 1, 2 and 7), and a document matching a bug's regex is counted and assumed away
+// before it is judged (skipClass).
+var Known = struct {
+	bomIsText                          bool // goldmark/1: a leading U+FEFF is kept as text
+	loneCrIsText                       bool // goldmark/2: a carriage return without a newline is not a line ending
+	emptyItemCrlfIsText                bool // goldmark/3: "-\r\n" is not an empty list item
+	altDropsCodeSpans                  bool // goldmark/4: code span text is missing from an image's alt
+	altDropsAutolinks                  bool // goldmark/5: autolink text is missing from an image's alt
+	altHasBreakTags                    bool // goldmark/6: a hard break inside an image's alt is written as <br />
+	nulKeptOnInput                     bool // goldmark/7: U+0000 is replaced on output, not on input (hrefs, autolinks, flanking)
+	tableCellCountIgnored              bool // goldmark/8: a header row with fewer cells than the delimiter row still makes a table
+	quoteSpaceTabBlocks                bool // goldmark/9: after "> " a tab hides list and HTML block starts and mis-indents fences
+	fenceBlankLineSpace                bool // goldmark/10: a whitespace-only line in an indented fence keeps a space
+	openTagEolNotBlock                 bool // goldmark/11: "<div" followed by the end of the line is not an HTML block start
+	strikeCloserAfterMark              bool // goldmark/12: "~~" right after a quote marker can close a strikethrough
+	infoStringTab                      bool // goldmark/13: the language class takes the info string up to a space, not a tab
+	codeSpanKeepsCR                    bool // goldmark/14: a CRLF inside a code span leaves the CR
+	newlineAfterDefinition             bool // goldmark/15: a definition opening a list item makes the list loose
+	tabAfterIndentHidesMarker          bool // goldmark/16: a tab after a list item's content indent hides the next line's block start
+	lowercaseDoctypeNotBlock           bool // goldmark/17: "<!doctype" (lower case) is not an HTML block start
+	fenceTrailingLineDropped           bool // goldmark/21: the last, marker-only line of an unclosed fence inside a container is dropped
+	linkifyStopsAtStar                 bool // goldmark/18: an autolink literal ends at "*" or at a non-ASCII character
+	linkifyEmailAfterUnderscore        bool // goldmark/19: "_foo@bar.baz" links foo@bar.baz only
+	linkifyNeedsTwoDots                bool // goldmark/20: "www.x" is not linked
+	linkifyRestartsAfterParen          bool // goldmark/22: "(" or "~" right after the domain ends an autolink literal
+	linkifyEmailTakesStar              bool // goldmark/24: "*" and "~" are accepted inside an email autolink's local part
+	linkifyDomainUnderscoreEndsLink    bool // goldmark/27: "_" in a www. domain ends the link instead of invalidating it
+	tableChildCountStale               bool // goldmark/23: a table leaves its parent's ChildCount one too high
+	indentedDelimiterRowMakesTable     bool // goldmark/29: a "---" line indented four or more columns makes a table, pipes or not
+	unbalancedParenDestinationAccepted bool // goldmark/25: a destination with an unbalanced "(" is accepted when a title follows
+	invalidTitleLineKept               bool // goldmark/26: an invalid title line of a reference definition still supplies the title
+	tabWidthInsideContainerWrong       bool // goldmark/28: tab widths after a list marker inside a container are computed from the wrong column
+	emptyNestedItemBlankClosesOuter    bool // goldmark/30: a blank line after an empty nested list item closes the enclosing list item too
