diff --git a/hegel_oracle.mjs b/hegel_oracle.mjs
new file mode 100644
index 0000000..f9fe084
--- /dev/null
+++ b/hegel_oracle.mjs
@@ -0,0 +1,43 @@
+// Oracle child for the Hegel tests: commonmark.js (the reference implementation) and micromark
+// (CommonMark, and GFM tables/strikethrough/task lists, and GFM autolink literals), one JSON
+// request per line on stdin, one JSON reply per line on stdout. Raw HTML and dangerous URL
+// schemes are let through: goldmark renders with html.WithUnsafe() in the differentials.
+import * as cm from "./.hegel/node_modules/commonmark/dist/commonmark.js";
+import { micromark } from "./.hegel/node_modules/micromark/index.js";
+import { gfmTable, gfmTableHtml } from "./.hegel/node_modules/micromark-extension-gfm-table/index.js";
+import { gfmStrikethrough, gfmStrikethroughHtml } from "./.hegel/node_modules/micromark-extension-gfm-strikethrough/index.js";
+import { gfmTaskListItem, gfmTaskListItemHtml } from "./.hegel/node_modules/micromark-extension-gfm-task-list-item/index.js";
+import { gfmAutolinkLiteral, gfmAutolinkLiteralHtml } from "./.hegel/node_modules/micromark-extension-gfm-autolink-literal/index.js";
+import { createInterface } from "node:readline";
+
+const parser = new cm.Parser();
+const renderer = new cm.HtmlRenderer();
+const dangerous = { allowDangerousHtml: true, allowDangerousProtocol: true };
+const render = {
+  cm: (src) => renderer.render(parser.parse(src)),
+  mm: (src) => micromark(src, dangerous),
+  gfm: (src) => micromark(src, {
+    ...dangerous,
+    extensions: [gfmTable(), gfmStrikethrough({ singleTilde: true }), gfmTaskListItem()],
+    htmlExtensions: [gfmTableHtml(), gfmStrikethroughHtml(), gfmTaskListItemHtml()],
+  }),
+  linkify: (src) => micromark(src, {
+    ...dangerous,
+    extensions: [gfmAutolinkLiteral()],
+    htmlExtensions: [gfmAutolinkLiteralHtml()],
+  }),
+};
+
+const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on("line", (line) => {
+  let out;
+  try {
+    const req = JSON.parse(line);
+    const fn = render[req.m];
+    if (!fn) throw new Error("unknown mode " + req.m);
+    out = { html: fn(req.src) };
+  } catch (e) {
+    out = { err: String(e && e.stack || e) };
+  }
+  process.stdout.write(JSON.stringify(out) + "\n");
+});
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..1e154a0
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,173 @@
+package goldmark_test
+
+// Pins: one plain test per bug in bugs.toml, asserting the behaviour the CommonMark 0.31.2 or
+// GFM spec calls for (as commonmark.js 0.31.2 and micromark 4 render it). Each fails while its
+// bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"io"
+	"testing"
+
+	"github.com/yuin/goldmark/v2/parser"
+	"github.com/yuin/goldmark/v2/renderer"
+)
+
+func pin(t *testing.T, p parser.Parser, r renderer.Renderer[io.Writer], src, want string) {
+	t.Helper()
+	if got := render(p, r, src); got != want {
+		t.Fatalf("src  %q\ngot  %q\nwant %q", src, got, want)
+	}
+}
+
+// goldmark/1: a leading byte order mark is text.
+func TestHegelPinLeadingBomIsSkipped(t *testing.T) {
+	pin(t, cmP, cmR, "\uFEFF# a", "<h1>a</h1>\n")
+}
+
+// goldmark/2: a lone carriage return is not a line ending.
+func TestHegelPinLoneCarriageReturnEndsALine(t *testing.T) {
+	pin(t, cmP, cmR, "# a\rb", "<h1>a</h1>\n<p>b</p>\n")
+}
+
+// goldmark/3: an empty list item under CRLF line endings is lost.
+func TestHegelPinEmptyItemUnderCrlf(t *testing.T) {
+	pin(t, cmP, cmR, "- a\r\n-\r\n- b\r\n", "<ul>\n<li>a</li>\n<li></li>\n<li>b</li>\n</ul>\n")
+}
+
+// goldmark/4: image alt text drops the text of code spans.
+func TestHegelPinAltKeepsCodeSpanText(t *testing.T) {
+	pin(t, cmP, cmR, "![a `b`](/u)", "<p><img src=\"/u\" alt=\"a b\" /></p>\n")
+}
+
+// goldmark/5: image alt text drops the text of autolinks.
+func TestHegelPinAltKeepsAutolinkText(t *testing.T) {
+	pin(t, cmP, cmR, "![a<http://x.y>](/u)", "<p><img src=\"/u\" alt=\"ahttp://x.y\" /></p>\n")
+}
+
+// goldmark/6: a hard line break inside alt text is written as <br />.
+func TestHegelPinAltHardBreakIsANewline(t *testing.T) {
+	pin(t, cmP, cmR, "![a  \nb](/u)", "<p><img src=\"/u\" alt=\"a\nb\" /></p>\n")
+}
+
+// goldmark/7: U+0000 is replaced on output instead of on input.
+func TestHegelPinNulIsReplacedOnInput(t *testing.T) {
+	pin(t, cmP, cmR, "[a](/\x00)", "<p><a href=\"/%EF%BF%BD\">a</a></p>\n")
+}
+
+// goldmark/8: a table whose delimiter row has a different cell count than the header is accepted.
+func TestHegelPinTableNeedsMatchingCellCounts(t *testing.T) {
+	pin(t, gfmP, gfmR, "| a |\n|-|-|\n| b |", "<p>| a |\n|-|-|\n| b |</p>\n")
+}
+
+// goldmark/9: after "> " a tab prevents block starts.
+func TestHegelPinTabAfterQuoteMarkerStartsBlocks(t *testing.T) {
+	pin(t, cmP, cmR, "> \t- a", "<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n")
+}
+
+// goldmark/10: a whitespace-only line inside an indented fenced code block keeps a space.
+func TestHegelPinBlankLineInIndentedFenceIsEmpty(t *testing.T) {
+	pin(t, cmP, cmR, "  ~~~\n a\n \n  b\n  ~~~", "<pre><code>a\n\nb\n</code></pre>\n")
+}
+
+// goldmark/11: "<div" followed by a line ending is not an HTML block start.
+func TestHegelPinOpenTagAtEndOfLineStartsHtmlBlock(t *testing.T) {
+	pin(t, cmP, cmR, "<div\n\nx", "<div\n<p>x</p>\n")
+}
+
+// goldmark/12: a delimiter run right after a bare block quote marker can close.
+func TestHegelPinDelimiterAfterQuoteMarkerCannotClose(t *testing.T) {
+	pin(t, cmP, cmR, "> **a\n>** b", "<blockquote>\n<p>**a\n** b</p>\n</blockquote>\n")
+}
+
+// goldmark/13: the info string's language is split at spaces only, not tabs.
+func TestHegelPinInfoStringLanguageEndsAtTab(t *testing.T) {
+	pin(t, cmP, cmR, "```js\tx\na\n```", "<pre><code class=\"language-js\">a\n</code></pre>\n")
+}
+
+// goldmark/14: a CRLF inside a code span leaves the carriage return.
+func TestHegelPinCodeSpanCrlfIsASpace(t *testing.T) {
+	pin(t, cmP, cmR, "a `b\r\nc` d", "<p>a <code>b c</code> d</p>\n")
+}
+
+// goldmark/15: a link reference definition opening a list item makes the list loose.
+func TestHegelPinDefinitionInItemKeepsListTight(t *testing.T) {
+	pin(t, cmP, cmR, "- [a]: /u\n  b\n- c", "<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n")
+}
+
+// goldmark/16: a tab after a list item's content indent hides the next line's block start.
+func TestHegelPinTabAfterContentIndentNestsList(t *testing.T) {
+	pin(t, cmP, cmR, "- a\n  \t- b", "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n")
+}
+
+// goldmark/17: a lower-case declaration is not an HTML block start.
+func TestHegelPinLowercaseDoctypeIsHtmlBlock(t *testing.T) {
+	pin(t, cmP, cmR, "<!doctype html>\n", "<!doctype html>\n")
+}
+
+// goldmark/18: an autolink literal ends at "*".
+func TestHegelPinAutolinkLiteralKeepsStar(t *testing.T) {
+	pin(t, linkP, cmR, "www.x.y/a*b", "<p><a href=\"http://www.x.y/a*b\">www.x.y/a*b</a></p>\n")
+}
+
+// goldmark/19: an email autolink literal cannot start with "_".
+func TestHegelPinEmailAutolinkStartsWithUnderscore(t *testing.T) {
+	pin(t, linkP, cmR, "_foo@bar.baz", "<p><a href=\"mailto:_foo@bar.baz\">_foo@bar.baz</a></p>\n")
+}
+
+// goldmark/20: "www.x" is not linked.
+func TestHegelPinWwwAutolinkNeedsOnePeriod(t *testing.T) {
+	pin(t, linkP, cmR, "www.x", "<p><a href=\"http://www.x\">www.x</a></p>\n")
+}
+
+// goldmark/21: the last, marker-only line of an unclosed fence inside a container is dropped.
+func TestHegelPinUnclosedFenceKeepsLastLineInQuote(t *testing.T) {
+	pin(t, cmP, cmR, "> ```\n>\n> ", "<blockquote>\n<pre><code>\n\n</code></pre>\n</blockquote>\n")
+}
+
+// goldmark/22: "(" or "~" right after the domain ends an autolink literal.
+func TestHegelPinAutolinkLiteralKeepsParenAfterDomain(t *testing.T) {
+	pin(t, linkP, cmR, "http://a.b(c", "<p><a href=\"http://a.b(c\">http://a.b(c</a></p>\n")
+}
+
+// goldmark/23: a table leaves its parent's ChildCount one too high.
+func TestHegelPinTableParentChildCount(t *testing.T) {
+	doc := gfmP.Parse([]byte("| a |\n| --- |\n"))
+	n := 0
+	for range doc.Children() {
+		n++
+	}
+	if doc.ChildCount() != n {
+		t.Fatalf("Document.ChildCount() = %d, %d children iterated", doc.ChildCount(), n)
+	}
+}
+
+// goldmark/24: "*" and "~" are accepted inside an email autolink's local part.
+func TestHegelPinEmailAutolinkExcludesStar(t *testing.T) {
+	pin(t, linkP, cmR, "*bar*a@c.d", "<p><em>bar</em><a href=\"mailto:a@c.d\">a@c.d</a></p>\n")
+}
+
+// goldmark/25: a link destination with an unbalanced "(" is accepted when a title follows.
+func TestHegelPinUnbalancedParenInDestinationIsNotALink(t *testing.T) {
+	pin(t, cmP, cmR, "[a](/u( 't')", "<p>[a](/u( 't')</p>\n")
+}
+
+// goldmark/26: an invalid title line of a reference definition still supplies the title.
+func TestHegelPinInvalidTitleLineGivesNoTitle(t *testing.T) {
+	pin(t, cmP, cmR, "[SS]: /u\n'a' x\n\n[SS]", "<p>'a' x</p>\n<p><a href=\"/u\">SS</a></p>\n")
+}
+
+// goldmark/27: "_" in a www. autolink's domain ends the link instead of invalidating it.
+func TestHegelPinUnderscoreInDomainInvalidatesWwwAutolink(t *testing.T) {
+	pin(t, linkP, cmR, "www.example.com_http://ex.am/ple?x=1",
+		"<p>www.example.com_<a href=\"http://ex.am/ple?x=1\">http://ex.am/ple?x=1</a></p>\n")
+}
+
+// goldmark/28: tab widths after a list marker inside a container are computed from the wrong column.
+func TestHegelPinTabWidthAfterMarkerInsideQuote(t *testing.T) {
+	pin(t, cmP, cmR, "> -\t\tb", "<blockquote>\n<ul>\n<li>\n<pre><code>b\n</code></pre>\n</li>\n</ul>\n</blockquote>\n")
+}
+
+// goldmark/29: a "---" line indented four or more columns makes a table, pipes or not.
+func TestHegelPinIndentedDelimiterRowIsNotATable(t *testing.T) {
+	pin(t, gfmP, gfmR, "a\n\t---\nb\n", "<p>a\n---\nb</p>\n")
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..0159e42
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1577 @@
+package goldmark_test
+
+// Hegel property tests for goldmark v2 (github.com/yuin/goldmark/v2), written for the Hegel zoo.
+// See targets/go/goldmark/README.md.
+//
+// Oracles: commonmark.js 0.31.2 (the reference implementation) and micromark 4 with its GFM
+// table/strikethrough/task-list/autolink-literal extensions, run as one node child process
+// (hegel_oracle.mjs, packages under .hegel/ installed by the target's setup); goldmark v1.8.6,
+// the last release before the v2 rewrite, imported as a module of its own; models of the
+// util package, the typographer table and the auto heading ids.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the differential properties record their
+// mismatches instead of failing (one long run lists every remaining shape at once).
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/yuin/goldmark/v2/ast"
+	"github.com/yuin/goldmark/v2/extension"
+	"github.com/yuin/goldmark/v2/parser"
+	"github.com/yuin/goldmark/v2/renderer"
+	"github.com/yuin/goldmark/v2/renderer/html"
+	"github.com/yuin/goldmark/v2/testutil"
+	"github.com/yuin/goldmark/v2/util"
+
+	gm1 "github.com/yuin/goldmark"
+	ext1 "github.com/yuin/goldmark/extension"
+	html1 "github.com/yuin/goldmark/renderer/html"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// word draws lo..hi runes from alphabet.
+func word(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	pool := []rune(alphabet)
+	idx := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, len(pool)-1)).MinSize(lo).MaxSize(hi))
+	var b strings.Builder
+	for _, i := range idx {
+		b.WriteRune(pool[i])
+	}
+	return b.String()
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case (gates, accepted shapes, mismatches)
+// and, in collect mode, records mismatches instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// fail records a mismatch (collect mode) or fails the test case.
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- oracle child
+
+var (
+	oracleOnce sync.Once
+	oracleErr  error
+	oracleMu   sync.Mutex
+	oracleIn   *bufio.Writer
+	oracleOut  *bufio.Reader
+)
+
+func startOracle() {
+	node := os.Getenv("HEGEL_NODE")
+	if node == "" {
+		node = "node"
+	}
+	cmd := exec.Command(node, "hegel_oracle.mjs")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleIn, oracleOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+type fataler interface {
+	Fatalf(format string, args ...any)
+}
+
+// oracle renders src with the named oracle: "cm" commonmark.js, "mm" micromark CommonMark,
+// "gfm" micromark + tables/strikethrough/task lists, "linkify" micromark + autolink literals.
+func oracle(t fataler, mode, src string) string {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("cannot start the node oracle (node 22 and the .hegel/ packages are needed): %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"m": mode, "src": src})
+	oracleIn.Write(req)
+	oracleIn.WriteByte('\n')
+	if err := oracleIn.Flush(); err != nil {
+		t.Fatalf("writing to the oracle: %v", err)
+	}
+	line, err := oracleOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from the oracle: %v", err)
+	}
+	var resp struct {
+		HTML string `json:"html"`
+		Err  string `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad oracle response %q: %v", line, err)
+	}
+	if resp.Err != "" {
+		t.Fatalf("oracle %s failed: %s", mode, resp.Err)
+	}
+	return resp.HTML
+}
+
+// --------------------------------------------------------------------------- goldmark configurations
+
+func render(p parser.Parser, r renderer.Renderer[io.Writer], src string) string {
+	var b bytes.Buffer
+	bs := []byte(src)
+	if err := r.Render(&b, bs, p.Parse(bs)); err != nil {
+		panic(err)
+	}
+	return b.String()
+}
+
+var (
+	// CommonMark as upstream's spec test configures it.
+	cmP = parser.New()
+	cmR = html.New(html.WithXHTML(), html.WithUnsafe())
+	// GFM tables, strikethrough and task lists (linkify has its own property).
+	gfmP = parser.New(parser.WithExtensions(extension.NewTableParser(), extension.NewStrikethroughParser(), extension.NewTaskListItemParser()))
+	gfmR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithExtensions(extension.NewTableHTMLRenderer(), extension.NewStrikethroughHTMLRenderer(), extension.NewTaskListItemHTMLRenderer()))
+	// Linkify alone.
+	linkP = parser.New(parser.WithExtensions(extension.NewLinkifyParser()))
+	// Everything (upstream's fuzz configuration), unsafe and safe renderers.
+	allP = parser.New(parser.WithAutoHeadingID(), parser.WithAttribute(), parser.WithExtensions(
+		extension.NewDefinitionListParser(), extension.NewFootnoteParser(), extension.NewGFMParser(), extension.NewTypographerParser()))
+	allR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithExtensions(
+		extension.NewDefinitionListHTMLRenderer(), extension.NewFootnoteHTMLRenderer(), extension.NewGFMHTMLRenderer()))
+	safeR = html.New(html.WithExtensions(
+		extension.NewDefinitionListHTMLRenderer(), extension.NewFootnoteHTMLRenderer(), extension.NewGFMHTMLRenderer()))
+	hardR = html.New(html.WithXHTML(), html.WithUnsafe(), html.WithHardWraps())
+	idP   = parser.New(parser.WithAutoHeadingID())
+	typoP = parser.New(parser.WithExtensions(extension.NewTypographerParser()))
+	// goldmark v1.8.6, the same configurations.
+	v1cm  = gm1.New(gm1.WithRendererOptions(html1.WithXHTML(), html1.WithUnsafe()))
+	v1gfm = gm1.New(gm1.WithRendererOptions(html1.WithXHTML(), html1.WithUnsafe()), gm1.WithExtensions(ext1.Table, ext1.Strikethrough, ext1.TaskList))
+)
+
+func renderV1(md gm1.Markdown, src string) string {
+	var b bytes.Buffer
+	if err := md.Convert([]byte(src), &b); err != nil {
+		panic(err)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- known bugs and accepted shapes
+
+// Known bugs: each switch keeps a property away from one recorded bug's shape (see bugs.toml).
+var Known = struct {
+	bomIsText                          bool // goldmark/1: a leading U+FEFF is kept as text
+	loneCrIsText                       bool // goldmark/2: a carriage return without a newline is not a line ending
+	emptyItemCrlfIsText                bool // goldmark/3: "-\r\n" is not an empty list item
+	altDropsCodeSpans                  bool // goldmark/4: code span text is missing from an image's alt
+	altDropsAutolinks                  bool // goldmark/5: autolink text is missing from an image's alt
+	altHasBreakTags                    bool // goldmark/6: a hard break inside an image's alt is written as <br />
+	nulKeptOnInput                     bool // goldmark/7: U+0000 is replaced on output, not on input (hrefs, autolinks, flanking)
+	tableCellCountIgnored              bool // goldmark/8: a header row with fewer cells than the delimiter row still makes a table
+	quoteSpaceTabBlocks                bool // goldmark/9: after "> " a tab hides list and HTML block starts and mis-indents fences
+	fenceBlankLineSpace                bool // goldmark/10: a whitespace-only line in an indented fence keeps a space
+	openTagEolNotBlock                 bool // goldmark/11: "<div" followed by the end of the line is not an HTML block start
+	strikeCloserAfterMark              bool // goldmark/12: "~~" right after a quote marker can close a strikethrough
+	infoStringTab                      bool // goldmark/13: the language class takes the info string up to a space, not a tab
+	codeSpanKeepsCR                    bool // goldmark/14: a CRLF inside a code span leaves the CR
+	newlineAfterDefinition             bool // goldmark/15: a definition opening a list item makes the list loose
+	tabAfterIndentHidesMarker          bool // goldmark/16: a tab after a list item's content indent hides the next line's block start
+	lowercaseDoctypeNotBlock           bool // goldmark/17: "<!doctype" (lower case) is not an HTML block start
+	fenceTrailingLineDropped           bool // goldmark/21: the last, marker-only line of an unclosed fence inside a container is dropped
+	linkifyStopsAtStar                 bool // goldmark/18: an autolink literal ends at "*" or at a non-ASCII character
+	linkifyEmailAfterUnderscore        bool // goldmark/19: "_foo@bar.baz" links foo@bar.baz only
+	linkifyNeedsTwoDots                bool // goldmark/20: "www.x" is not linked
+	linkifyRestartsAfterParen          bool // goldmark/22: "(" or "~" right after the domain ends an autolink literal
+	linkifyEmailTakesStar              bool // goldmark/24: "*" and "~" are accepted inside an email autolink's local part
+	linkifyDomainUnderscoreEndsLink    bool // goldmark/27: "_" in a www. domain ends the link instead of invalidating it
+	tableChildCountStale               bool // goldmark/23: a table leaves its parent's ChildCount one too high
+	indentedDelimiterRowMakesTable     bool // goldmark/29: a "---" line indented four or more columns makes a table, pipes or not
+	unbalancedParenDestinationAccepted bool // goldmark/25: a destination with an unbalanced "(" is accepted when a title follows
+	invalidTitleLineKept               bool // goldmark/26: an invalid title line of a reference definition still supplies the title
+	tabWidthInsideContainerWrong       bool // goldmark/28: tab widths after a list marker inside a container are computed from the wrong column
+}{
+	bomIsText:                          true,
+	loneCrIsText:                       true,
+	emptyItemCrlfIsText:                true,
+	altDropsCodeSpans:                  true,
+	altDropsAutolinks:                  true,
+	altHasBreakTags:                    true,
+	nulKeptOnInput:                     true,
+	tableCellCountIgnored:              true,
+	quoteSpaceTabBlocks:                true,
+	fenceBlankLineSpace:                true,
+	openTagEolNotBlock:                 true,
+	strikeCloserAfterMark:              true,
+	infoStringTab:                      true,
+	codeSpanKeepsCR:                    true,
+	newlineAfterDefinition:             true,
+	tabAfterIndentHidesMarker:          true,
+	lowercaseDoctypeNotBlock:           true,
+	fenceTrailingLineDropped:           true,
+	linkifyStopsAtStar:                 true,
+	linkifyEmailAfterUnderscore:        true,
+	linkifyNeedsTwoDots:                true,
+	linkifyRestartsAfterParen:          true,
+	linkifyEmailTakesStar:              true,
+	linkifyDomainUnderscoreEndsLink:    true,
+	tableChildCountStale:               true,
+	indentedDelimiterRowMakesTable:     true,
+	unbalancedParenDestinationAccepted: true,
+	invalidTitleLineKept:               true,
+	tabWidthInsideContainerWrong:       true,
+}
+
+// Generator switches set by the properties.
+var (
+	bareUrls  = true // bare URLs and e-mail addresses in prose (GFM autolink literals)
+	oddSpaces = false
+)
+
+var (
+	reEmptyQuote   = regexp.MustCompile(`<blockquote>\n</blockquote>`)
+	reHTMLBlockEnd = regexp.MustCompile(` ?\n?(</blockquote>|</li>)`)
+	// JavaScript's trim(): commonmark.js trims a paragraph's or heading's content with it, so
+	// Unicode spaces at either end vanish where the spec keeps them.
+	jsSpace       = `[\x{00A0}\x{1680}\x{2000}-\x{200A}\x{2028}\x{2029}\x{202F}\x{205F}\x{3000}\x{FEFF}]+`
+	reJsTrimLead  = regexp.MustCompile(`(<p>|<h[1-6]>|<li>)` + jsSpace)
+	reJsTrimTrail = regexp.MustCompile(jsSpace + `(</p>|</h[1-6]>|</li>|\n)`)
+	// commonmark.js copies raw HTML inside an image's alt text unescaped.
+	reAltAny = regexp.MustCompile(`(?s) alt=".*?"( />| title=)`)
+	// micromark's own readings.
+	reCodeTrailingBlank = regexp.MustCompile(`(\n[ \t]*)+\n</code></pre>`)
+	reTrailingWs        = regexp.MustCompile(`[ \t]+\n`)
+	reXhtmlVoid         = regexp.MustCompile(`<(hr|br|img [^>]*?|input [^>]*?) />`)
+	reInput             = regexp.MustCompile(`<input [^>]*>`)
+	reURLAttr           = regexp.MustCompile(` (href|src)="[^"]*"`)
+	reTrailingTab       = regexp.MustCompile(`[ \t]*\t\n`)
+	rePre               = regexp.MustCompile(`(?s)<pre>.*?</pre>`)
+	reEmptyTitle        = regexp.MustCompile(` title=""`)
+	reAlign             = regexp.MustCompile(` align="(left|center|right)"`)
+	reEmphasis          = regexp.MustCompile(`</?em>|</?strong>|[*_]`)
+	reControl           = regexp.MustCompile(`[\x01-\x08\x0b\x0e-\x1f\x7f]`)
+	reAttr              = regexp.MustCompile(`[a-z]+="[^"]*"`)
+)
+
+type shape struct {
+	name string
+	fn   func(string) string
+}
+
+// Output shapes of known bugs and of accepted differences, applied cumulatively to both sides
+// after the byte-exact comparison has failed.
+var shapes = []shape{
+	{"accepted-empty-quote", func(h string) string { return reEmptyQuote.ReplaceAllString(h, "<blockquote></blockquote>") }},
+	// goldmark (and micromark) copy CRLF line endings verbatim inside code and HTML blocks;
+	// commonmark.js writes LF. The spec does not say.
+	{"accepted-crlf-verbatim", func(h string) string { return strings.ReplaceAll(h, "\r\n", "\n") }},
+	// An HTML block ending the document without a final newline gets none (micromark agrees).
+	{"accepted-html-block-eof", func(h string) string {
+		return reHTMLBlockEnd.ReplaceAllString(strings.TrimSuffix(h, "\n"), "$1")
+	}},
+	{"accepted-js-trim", func(h string) string {
+		h = reJsTrimLead.ReplaceAllString(h, "$1")
+		return reJsTrimTrail.ReplaceAllString(h, "$1")
+	}},
+	// goldmark keeps a % that does not start a %XX escape (as cmark does); commonmark.js writes %25.
+	{"accepted-percent", func(h string) string {
+		return reURLAttr.ReplaceAllStringFunc(h, func(t string) string { return strings.ReplaceAll(t, "%25", "%") })
+	}},
+	// A tab before a soft line break: commonmark.js keeps it, micromark strips it, the spec
+	// speaks of spaces only. Compared with trailing tabs removed outside <pre>.
+	{"accepted-trailing-tab", func(h string) string {
+		return outsidePre(h, func(s string) string { return reTrailingTab.ReplaceAllString(s, "\n") })
+	}},
+	{"accepted-alt-raw-html", func(h string) string {
+		return reAltAny.ReplaceAllStringFunc(h, func(t string) string {
+			if strings.ContainsAny(t, "<&") {
+				return ` alt=""` + t[strings.LastIndex(t, `"`)+1:]
+			}
+			return t
+		})
+	}},
+}
+
+// outsidePre applies fn to the parts of h that are not inside <pre>...</pre>.
+func outsidePre(h string, fn func(string) string) string {
+	var b strings.Builder
+	last := 0
+	for _, m := range rePre.FindAllStringIndex(h, -1) {
+		b.WriteString(fn(h[last:m[0]]))
+		b.WriteString(h[m[0]:m[1]])
+		last = m[1]
+	}
+	b.WriteString(fn(h[last:]))
+	return b.String()
+}
+
+// v1Shape: v1 wrote title="" for an empty title (v2 omits it, as commonmark.js does) and no
+// align on a short row's missing cells.
+func v1Shape(h string) string {
+	return reAlign.ReplaceAllString(reEmptyTitle.ReplaceAllString(h, ""), "")
+}
+
+func classify(got, want string) string {
+	g, w := got, want
+	for _, s := range shapes {
+		g, w = s.fn(g), s.fn(w)
+		if g == w {
+			return s.name
+		}
+	}
+	return ""
+}
+
+// micromark's readings that are its own: whitespace-only lines kept in indented code at EOF,
+// trailing tabs before a soft break stripped, `*_*a` as emphasis (compared with every emphasis
+// delimiter and tag removed), valid control-character references replaced by U+FFFD.
+func classifyMicromark(got, want string) string {
+	f := func(h string) string {
+		h = reCodeTrailingBlank.ReplaceAllString(h, "\n</code></pre>")
+		h = reTrailingWs.ReplaceAllString(h, "\n")
+		h = reEmphasis.ReplaceAllString(h, "")
+		return reControl.ReplaceAllString(h, "\uFFFD")
+	}
+	if f(got) == f(want) {
+		return "accepted-micromark"
+	}
+	return ""
+}
+
+// gfmShape: presentation differences between goldmark's GFM renderers and micromark's
+// (attribute order of the task-list input, void tags, no final newline), plus the CommonMark
+// shapes.
+func gfmShape(h string) string {
+	h = strings.TrimSuffix(h, "\n")
+	h = reInput.ReplaceAllStringFunc(h, func(t string) string {
+		attrs := reAttr.FindAllString(t, -1)
+		sort.Strings(attrs)
+		return "<input " + strings.Join(attrs, " ") + ">"
+	})
+	h = reXhtmlVoid.ReplaceAllString(h, "<$1>")
+	return reEmptyQuote.ReplaceAllString(h, "<blockquote></blockquote>")
+}
+
+var (
+	reLoneCR            = regexp.MustCompile(`\r([^\n]|$)`)
+	reEmptyItemCRLF     = regexp.MustCompile(`(^|\n)[ \t>]*([-+*]|[0-9]{1,9}[.)])\r\n`)
+	reAltCodeSpan       = regexp.MustCompile("(?s)!\\[.*`")
+	reAltAutolink       = regexp.MustCompile(`(?s)!\[.*<[^>\s]*[:@][^>\s]*>`)
+	reAltHardBreak      = regexp.MustCompile(`!\[[^\]]*( {2,}|\\)\r?\n`)
+	reDelimiterRow      = regexp.MustCompile(`^[ \t]{0,3}\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*$`)
+	reQuoteSpaceTab     = regexp.MustCompile(`(^|\n) {0,3}(> ?)*> +\t`)
+	reIndentedFence     = regexp.MustCompile("(^|\n)[ \t>]*[ ]+(```|~~~)")
+	reBlankWithWs       = regexp.MustCompile(`\n[ \t]+\r?\n`)
+	reOpenTagEol        = regexp.MustCompile(`(^|\n)[ \t>]*</?(div|DIV|table|h1|del|span|textarea|script|pre|p)[ \t]*(\r?\n|$)`)
+	reStrikeAfterQ      = regexp.MustCompile(`\n[ \t]*>+[~*_]`)
+	reTabAfterIndent    = regexp.MustCompile("\\n +\\t[ \\t]*(<|#|>|```|~~~|([-+*]|[0-9]{1,9}[.)])[ \\t])")
+	reLowerDoctype      = regexp.MustCompile(`<![a-z]`)
+	reTrailingBlankEOF  = regexp.MustCompile(`\n[ \t>]+$`)
+	reLinkifyStar       = regexp.MustCompile(`(www\.|https?://|ftp://)[^\s<]*(\*|[^\x00-\x7F])`)
+	reLinkifyEmailUs    = regexp.MustCompile(`_[A-Za-z0-9._+-]*@[A-Za-z0-9]`)
+	reLinkifyOneDot     = regexp.MustCompile(`www\.[A-Za-z0-9_-]+\.?([^A-Za-z0-9._-]|$)`)
+	reLinkifyParen      = regexp.MustCompile(`(www\.|https?://)[A-Za-z0-9._-]+[(~]`)
+	reLinkifyEmailStar  = regexp.MustCompile(`[*~][A-Za-z0-9._+-]*@[A-Za-z0-9]`)
+	reLinkifyDomainUs   = regexp.MustCompile(`@[A-Za-z0-9.-]*_`)
+	reLinkifyAfterParen = regexp.MustCompile(`\)[_*~]?(www\.|https?://|[A-Za-z0-9._+-]+@)`)
+	reLinkifyWwwUs      = regexp.MustCompile(`www\.[A-Za-z0-9.-]*_`)
+	reParenDest         = regexp.MustCompile(`\](\([ \t]*|:[ \t]*(\r?\n[ \t>]*)?)<?[^\s)>]*\(`)
+	reTitleLine         = regexp.MustCompile(`\]:[ \t]*(\r?\n[ \t>]*)?(<[^>\n]*>|[^\s]+)[ \t]*\r?\n[ \t>]*['"(]`)
+	reIndentedRow       = regexp.MustCompile(`\n( {4}| {0,3}\t)[ \t]*[^\s\n]`)
+	reAltRawHTML        = regexp.MustCompile(`(?s)!\[.*<[a-zA-Z/!?]`)
+	reLinkifyQuote      = regexp.MustCompile(`(www\.|https?://)[^\s<]*['"]`)
+	reDefThenRule       = regexp.MustCompile(`\]:[^\n]*\n[ \t]{0,3}-{3,}[ \t]*(\r?\n|$)`)
+	reTabAfterMarker    = regexp.MustCompile(`(^|\n)[ \t>]*[ \t>]([-+*]|[0-9]{1,9}[.)])\t`)
+	reTableish          = regexp.MustCompile(`(^|\n)[ \t>]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*\r?(\n|$)`)
+	reIndentedDelimiter = regexp.MustCompile(`\n( {4}| {0,3}\t)[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*\r?(\n|$)`)
+	reMarkerPrefix      = regexp.MustCompile(`^[ \t>]*(([-+*]|[0-9]{1,9}[.)])[ \t]+)?`)
+	reInfoTab           = regexp.MustCompile("(```|~~~)[^\n`]*\t")
+	reCodeSpanCRLF      = regexp.MustCompile("`[^`]*\r\n[^`]*`")
+	reItemDefinition    = regexp.MustCompile(`(^|\n)[ \t]*([-+*]|[0-9]{1,9}[.)])[ \t]+\[[^\]\n]*\]:`)
+	reEmptyHeader       = regexp.MustCompile(`(^|\n)[ \t]*\|[ \t|]*\n[ \t]*\|?[ \t]*:?-+:?`)
+	reTildeEmphasis     = regexp.MustCompile(`~[*_]|[*_]~`)
+	reMixedEmphasis     = regexp.MustCompile(`\*_|_\*`)
+)
+
+// tableCells counts the cells of a table row the GFM way: leading and trailing pipes trimmed,
+// unescaped pipes separate.
+func tableCells(line string) int {
+	l := strings.TrimSpace(strings.ReplaceAll(line, "\\|", "  "))
+	l = strings.TrimPrefix(l, "|")
+	l = strings.TrimSuffix(l, "|")
+	return strings.Count(l, "|") + 1
+}
+
+// tableCellCountDiffers: a delimiter row whose cell count differs from the line before it.
+func tableCellCountDiffers(src string) bool {
+	lines := strings.Split(src, "\n")
+	for i := range lines {
+		lines[i] = strings.TrimRight(reMarkerPrefix.ReplaceAllString(lines[i], ""), "\r")
+	}
+	for i := 1; i < len(lines); i++ {
+		if reDelimiterRow.MatchString(lines[i]) && strings.Contains(lines[i]+lines[i-1], "|") && strings.TrimSpace(lines[i-1]) != "" &&
+			tableCells(lines[i]) != tableCells(lines[i-1]) {
+			return true
+		}
+	}
+	return false
+}
+
+func knownShape(src string) string {
+	if Known.bomIsText && strings.HasPrefix(src, "\uFEFF") {
+		return "known-bom"
+	}
+	if Known.loneCrIsText && reLoneCR.MatchString(src) {
+		return "known-lone-cr"
+	}
+	if Known.emptyItemCrlfIsText && reEmptyItemCRLF.MatchString(src) {
+		return "known-empty-item-crlf"
+	}
+	// Raw HTML inside image alt text: goldmark and cmark drop it, micromark and commonmark.js
+	// copy it (README); the shape is skipped in every property, not only the GFM one.
+	if reAltRawHTML.MatchString(src) {
+		return "accepted-alt-raw-html"
+	}
+	if Known.altDropsCodeSpans && reAltCodeSpan.MatchString(src) {
+		return "known-alt-code-span"
+	}
+	if Known.altDropsAutolinks && reAltAutolink.MatchString(src) {
+		return "known-alt-autolink"
+	}
+	if Known.altHasBreakTags && reAltHardBreak.MatchString(src) {
+		return "known-alt-hard-break"
+	}
+	if Known.nulKeptOnInput && strings.Contains(src, "\x00") {
+		return "known-nul"
+	}
+	if Known.quoteSpaceTabBlocks && reQuoteSpaceTab.MatchString(src) {
+		return "known-quote-space-tab"
+	}
+	if Known.fenceBlankLineSpace && reIndentedFence.MatchString(src) && reBlankWithWs.MatchString(src) {
+		return "known-fence-blank-line"
+	}
+	if Known.openTagEolNotBlock && reOpenTagEol.MatchString(src) {
+		return "known-open-tag-eol"
+	}
+	if Known.infoStringTab && reInfoTab.MatchString(src) {
+		return "known-info-tab"
+	}
+	if Known.codeSpanKeepsCR && reCodeSpanCRLF.MatchString(src) {
+		return "known-code-span-cr"
+	}
+	if Known.newlineAfterDefinition && reItemDefinition.MatchString(src) {
+		return "known-item-definition"
+	}
+	if Known.strikeCloserAfterMark && reStrikeAfterQ.MatchString(src) {
+		return "known-delimiter-after-marker"
+	}
+	if Known.tabAfterIndentHidesMarker && reTabAfterIndent.MatchString(src) {
+		return "known-tab-after-indent"
+	}
+	if Known.lowercaseDoctypeNotBlock && reLowerDoctype.MatchString(src) {
+		return "known-lowercase-doctype"
+	}
+	if Known.fenceTrailingLineDropped && reTrailingBlankEOF.MatchString(src) && strings.ContainsAny(src, "`~") {
+		return "known-fence-trailing-line"
+	}
+	if Known.unbalancedParenDestinationAccepted && reParenDest.MatchString(src) {
+		return "known-paren-in-destination"
+	}
+	if Known.invalidTitleLineKept && reTitleLine.MatchString(src) {
+		return "known-title-line"
+	}
+	if Known.tabWidthInsideContainerWrong && reTabAfterMarker.MatchString(src) {
+		return "known-tab-after-marker-in-container"
+	}
+	return ""
+}
+
+// knownLinkifyShape: the autolink-literal shapes goldmark's Linkify is known to read differently,
+// and two the GFM spec leaves open.
+func knownLinkifyShape(src string) string {
+	if Known.linkifyStopsAtStar && reLinkifyStar.MatchString(src) {
+		return "known-linkify-star-or-non-ascii"
+	}
+	if Known.linkifyEmailAfterUnderscore && reLinkifyEmailUs.MatchString(src) {
+		return "known-linkify-email-underscore"
+	}
+	if Known.linkifyNeedsTwoDots && reLinkifyOneDot.MatchString(src) {
+		return "known-linkify-one-dot"
+	}
+	if Known.linkifyRestartsAfterParen && reLinkifyParen.MatchString(src) {
+		return "known-linkify-paren-after-domain"
+	}
+	if Known.linkifyEmailTakesStar && reLinkifyEmailStar.MatchString(src) {
+		return "known-linkify-email-star"
+	}
+	if Known.linkifyDomainUnderscoreEndsLink && reLinkifyWwwUs.MatchString(src) {
+		return "known-linkify-domain-underscore"
+	}
+	// An email autolink whose domain has "_" right before a www./http:// start: the spec allows
+	// "_" in the domain, so the two readings (one email, or text then a URL) are both defensible.
+	if reLinkifyDomainUs.MatchString(src) {
+		return "ambiguous-email-domain-underscore"
+	}
+	// micromark starts a new autolink right after ")" where the spec's paragraph on trailing
+	// parentheses only trims trailing ones.
+	if reLinkifyAfterParen.MatchString(src) {
+		return "micromark-restart-after-paren"
+	}
+	if strings.Contains(src, "HTTP://") {
+		return "ambiguous-uppercase-scheme"
+	}
+	if strings.Contains(src, "|") {
+		return "ambiguous-pipe"
+	}
+	// A quote right after a URL: micromark strips it as trailing punctuation, goldmark keeps it;
+	// the GFM list of trailing punctuation has neither ' nor ".
+	if reLinkifyQuote.MatchString(src) {
+		return "ambiguous-trailing-quote"
+	}
+	return ""
+}
+
+// knownGfmShape: the GFM-only known bugs.
+func knownGfmShape(src string) string {
+	if Known.tableCellCountIgnored && tableCellCountDiffers(src) {
+		return "known-table-cell-count"
+	}
+	// micromark opens emphasis on a "*" that the flanking rules refuse when "_" follows it
+	// (`a*_x_*`); commonmark.js and goldmark agree.
+	if reMixedEmphasis.MatchString(src) {
+		return "micromark-core-quirk"
+	}
+	if Known.indentedDelimiterRowMakesTable && reIndentedDelimiter.MatchString(src) {
+		return "known-indented-delimiter-row"
+	}
+	// Raw HTML inside image alt text: goldmark and cmark drop it, micromark and commonmark.js
+	// copy it (README).
+	if reAltRawHTML.MatchString(src) {
+		return "accepted-alt-raw-html"
+	}
+	// A body row indented four or more columns: micromark ends the table and reads indented
+	// code, goldmark reads a row; the GFM spec says nothing about row indentation.
+	if strings.Contains(src, "|") && reIndentedRow.MatchString(src) && reTableish.MatchString(src) {
+		return "ambiguous-indented-row"
+	}
+	// A header row of pipes only (micromark: no table; cmark-gfm: a table with an empty header)
+	// and tildes touching emphasis delimiters (micromark reads them differently) are ambiguous.
+	if reEmptyHeader.MatchString(src) {
+		return "ambiguous-empty-header"
+	}
+	if reTildeEmphasis.MatchString(src) {
+		return "ambiguous-tilde-emphasis"
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- Markdown generator
+
+var words = []string{"a", "b", "foo", "bar", "baz", "x", "yz", "qux", "Hello", "world", "α", "日本", "é",
+	"tab", "1", "42", "3.14", "-", "+", "_", "*", "~", "|", "#", "!", ".", ")", "(", "'", "\"", "&", "<", ">", ":", "/"}
+
+var schemes = []string{"http://", "https://", "ftp://", "mailto:", "", "/", "./", "#", "javascript:", "data:image/png;base64,", "vbscript:", "file:///"}
+
+func genURL(tc hegel.TestCase) string {
+	u := pick(tc, schemes) + word(tc, "abcxyz.-_", 0, 8)
+	if chance(tc, 30) {
+		u += "/" + word(tc, "abc%20/?=&#[]{}|^`\\ αß'\"()", 0, 8)
+	}
+	if chance(tc, 10) {
+		sp := ""
+		if chance(tc, 30) {
+			sp = " "
+		}
+		u = "<" + u + sp + ">"
+	}
+	return u
+}
+
+func genTitle(tc hegel.TestCase) string {
+	q := pick(tc, []string{"\"", "'", "("})
+	c := q
+	if q == "(" {
+		c = ")"
+	}
+	return q + word(tc, "abc &\"'()\\", 0, 6) + c
+}
+
+var entities = []string{"&amp;", "&lt;", "&gt;", "&quot;", "&copy;", "&#35;", "&#x41;", "&#X41;", "&nbsp;", "&bogus;",
+	"&amp", "&#0;", "&#xD800;", "&#1114112;", "&ouml", "&ouml;", "&ngE;", "&#x0;", "&AMP;", "&Amp;", "& b", "&;", "&#;", "&#1;"}
+
+var rawInline = []string{"<b>", "</b>", "<a href='x'>", "<a href=\"y\" >", "<br/>", "<!-- c -->", "<!---->", "<?php x ?>",
+	"<!X y>", "<![CDATA[z]]>", "<b x=y>", "<b x = 'y'>", "<3", "< b>", "<b/ >", "<a.b>", "<a-b>", "<b x=\"y\"z>",
+	"<img src=x>", "<!-->", "<!--->", "<!-- -- -->", "<x:y>", "<ab@c.d>", "<foo\nbar>"}
+
+func genCodeSpan(tc hegel.TestCase) string {
+	ticks := strings.Repeat("`", n(tc, 1, 3))
+	inner := word(tc, "ab ` *_[]<&", 0, 8)
+	if chance(tc, 20) {
+		inner = pick(tc, []string{" ", "  ", " a ", "``", " `` ", "a\nb", "\n", " \n "})
+	}
+	return ticks + inner + ticks
+}
+
+var refs = []string{"ref", "Ref", "r e f", "ΑΒΓ", "αβγ", "ﬀ", "a\\]b", "*x*", "x[y", "1", "a  b", "İϴΩKÅ", "ß", "SS"}
+
+var autolinks = []string{"<http://a.b/c?d=1&e=2>", "<https://x.y>", "<mailto:a@b.c>", "<a@b.c>", "<a.b@c.d>", "<x:y>",
+	"<http://a b>", "<http://[::1]/x>", "<made-up+scheme://x>", "<http://a.b/ñ>", "<HTTP://A.B>", "<a:>", "<ab:c>", "<a@b>"}
+
+var bare = []string{"www.example.com", "http://ex.am/ple?x=1", "foo@bar.baz", "ftp://a.b", "HTTP://X.Y/Z", "example.com/a(b)", "x.com.",
+	"www.a.b/c_d_", "http://x.y/(a)", "www.x.y/a.", "mailto:a@b.c", "a@b.c.", "http://a.b/c,", "www.foo.bar/baz;", "https://x.y/a?b=c&d", "www.x.y/π", "xmpp:a@b.c/d"}
+
+// bareGfm: the shapes GFM's autolink literals define (goldmark's Linkify also links ftp:// and
+// documents it; mailto:/xmpp: are read differently by the two).
+var bareGfm = []string{"www.example.com", "http://ex.am/ple?x=1", "foo@bar.baz", "HTTP://X.Y/Z", "example.com/a(b)", "x.com.",
+	"www.a.b/c_d_", "http://x.y/(a)", "www.x.y/a.", "a@b.c.", "http://a.b/c,", "https://x.y/a?b=c&d", "www.x.y/π",
+	"www.x.y/a_", "http://x.y/a~", "www.x.y?a=b&c=d", "http://x.y/a&amp;", "www.x.y/a)", "www.x.y/(a))", "http://x.y/a.b.", "www.x", "a.b@c.d-e.f", "a_b@c.d", "a.@c.d", "a@b.c_", "a@b.c-",
+	"_foo@bar.baz", "www.x.y/a*b", "www.x.y/a~b", "http://x.y/a_b_", "www.x.y/日本", "www.x.y/a&b;", "www.x.y/&amp;", "http://x.y/a:", "www.x.y/a!", "www.x.y/a?"}
+
+var typo = []string{"(c)", "(C)", "(r)", "(tm)", "+-", "...", "--", "---", "!!!!", "????", ",,", "..", "----", "<<", ">>", "'90s", "it's", "'a'", "\"b\""}
+
+var odd = []string{"\u00A0", " ", "", " ", "\x0b", "\uFEFF", "\u3000", "\u200B", "\x0c"}
+
+func genInlineAtom(tc hegel.TestCase, depth int) string {
+	k := n(tc, 0, 99)
+	if k < 30 || depth > 3 {
+		return pick(tc, words)
+	}
+	if k < 34 {
+		if oddSpaces && chance(tc, 40) {
+			return pick(tc, odd)
+		}
+		return pick(tc, []string{" ", "  ", "\n", "  \n", "\\\n", " \\\n", "\t", "\n ", "\n\t"})
+	}
+	if k < 44 {
+		m := pick(tc, []string{"*", "**", "_", "__", "***", "___", "*_", "_*", "~~", "~", "**_", "*__"})
+		inner := genInline(tc, depth+1, n(tc, 0, 3))
+		if chance(tc, 80) {
+			r := []rune(m)
+			for i, j := 0, len(r)-1; i < j; i, j = i+1, j-1 {
+				r[i], r[j] = r[j], r[i]
+			}
+			return m + inner + string(r)
+		}
+		return m + inner + pick(tc, []string{"*", "_", "**", "__", ""})
+	}
+	if k < 50 {
+		return genCodeSpan(tc)
+	}
+	if k < 60 {
+		bang := ""
+		if chance(tc, 30) {
+			bang = "!"
+		}
+		text := genInline(tc, depth+1, n(tc, 0, 3))
+		switch n(tc, 0, 4) {
+		case 0:
+			t := ""
+			if chance(tc, 40) {
+				t = " " + genTitle(tc)
+			}
+			return bang + "[" + text + "](" + genURL(tc) + t + ")"
+		case 1:
+			return bang + "[" + text + "](" + genURL(tc) + pick(tc, []string{"  ", "\n", " \n "}) + genTitle(tc) + pick(tc, []string{"", " ", "\n"}) + ")"
+		case 2:
+			return bang + "[" + text + "][" + pick(tc, refs) + "]"
+		case 3:
+			e := ""
+			if chance(tc, 50) {
+				e = "[]"
+			}
+			return bang + "[" + pick(tc, refs) + "]" + e
+		}
+		return bang + "[" + text + "](" + pick(tc, []string{"", " ", "<>", "()", "(a)", "a b", "<a b>", "a\nb", "\\)", "a)b"}) + ")"
+	}
+	if k < 66 {
+		return pick(tc, autolinks)
+	}
+	if k < 72 {
+		return pick(tc, entities)
+	}
+	if k < 80 {
+		return "\\" + pick(tc, []string{"*", "_", "\\", "`", "[", "]", "(", ")", "#", "<", ">", "&", "!", "a", " ", "-", "|", "~", "\"", "'", "."})
+	}
+	if k < 86 {
+		return pick(tc, rawInline)
+	}
+	if k < 90 {
+		if bareUrls {
+			return pick(tc, bare)
+		}
+		return pick(tc, words)
+	}
+	if k < 94 {
+		return pick(tc, typo)
+	}
+	return word(tc, "*_`[]()!<>#-+&\\ ~|=\"'", 1, 6)
+}
+
+func genInline(tc hegel.TestCase, depth, length int) string {
+	var b strings.Builder
+	for i := 0; i < length; i++ {
+		b.WriteString(genInlineAtom(tc, depth))
+	}
+	return b.String()
+}
+
+func genIndent(tc hegel.TestCase) string {
+	return pick(tc, []string{"", "", "", " ", "  ", "   ", "\t", " \t"})
+}
+
+func genLines(tc hegel.TestCase, depth int, prefix string, count int) string {
+	out := make([]string, 0, count)
+	for i := 0; i < count; i++ {
+		out = append(out, prefix+genIndent(tc)+genInline(tc, depth, n(tc, 1, 6)))
+	}
+	return strings.Join(out, "\n")
+}
+
+var htmlBlocks = []string{"<div>", "<div>\n*x*\n</div>", "<pre>\na\n</pre>", "<!-- c\n-->", "<?x\n?>", "<!X>", "<![CDATA[\n]]>", "<script>\n<x>\n</script>",
+	"<table><tr><td>\n<pre>\n**a**\n</pre>\n</td></tr></table>", "</div>\n*b*", "<DIV CLASS=x>", "<a href=\"x\">\n*y*", "<b>\nc", "<textarea>\n*a*\n</textarea>",
+	"<div\n", "<hr/>", "<foo bar>", "<!DOCTYPE html>", "<!doctype html>", "<del>\n*a*\n</del>", "<span>\n*a*", "<x-y>", "<h1>\nT\n</h1>"}
+
+func genBlockAtom(tc hegel.TestCase, depth int) string {
+	k := n(tc, 0, 99)
+	if k < 25 || depth > 2 {
+		return genLines(tc, depth, "", n(tc, 1, 3))
+	}
+	if k < 33 {
+		return genIndent(tc) + strings.Repeat("#", n(tc, 1, 7)) + pick(tc, []string{" ", "", "  ", "\t"}) + genInline(tc, depth, n(tc, 0, 4)) + pick(tc, []string{"", " #", " ##", "#", " # ", " ###\t"})
+	}
+	if k < 38 {
+		return genLines(tc, depth, "", n(tc, 1, 2)) + "\n" + genIndent(tc) + pick(tc, []string{"=", "===", "-", "---", "- - -", "==== ", "--\t", "= ="})
+	}
+	if k < 43 {
+		return genIndent(tc) + pick(tc, []string{"***", "---", "___", "* * *", "- - -", "_____", "-- -", "**", "--", "*-*", "***a", "---\t"})
+	}
+	if k < 52 {
+		fence := pick(tc, []string{"```", "~~~", "````", "~~~~", "``", "~~"})
+		info := pick(tc, []string{"", "js", " js ", "c++ {x}", "`", "a`b", "js\tx", "a b c"})
+		body := word(tc, "ab *_`~\n  <&", 0, 12)
+		close := ""
+		if chance(tc, 85) {
+			close = fence + pick(tc, []string{"", " ", "  x", "`"})
+		}
+		nl := ""
+		if chance(tc, 80) {
+			nl = "\n"
+		}
+		return genIndent(tc) + fence + info + "\n" + body + nl + close
+	}
+	if k < 57 {
+		s := pick(tc, []string{"    ", "\t", "     ", " \t", "  \t  "}) + word(tc, "ab *_`~ <&#-", 0, 10)
+		if chance(tc, 40) {
+			s += "\n\t" + word(tc, "ab", 0, 4)
+		}
+		return s
+	}
+	if k < 66 {
+		inner := strings.Split(genBlock(tc, depth+1, n(tc, 1, 3)), "\n")
+		for i, l := range inner {
+			inner[i] = pick(tc, []string{">", "> ", ">  ", ">", " >", "  > ", ">\t"}) + l
+		}
+		return strings.Join(inner, "\n")
+	}
+	if k < 80 {
+		ordered := chance(tc, 40)
+		start := 0
+		if ordered {
+			start = n(tc, 0, 12)
+		}
+		bullet := pick(tc, []string{"-", "*", "+"})
+		delim := pick(tc, []string{".", ")"})
+		sep := "\n"
+		if chance(tc, 30) {
+			sep = "\n\n"
+		}
+		var items []string
+		for i, count := 0, n(tc, 1, 4); i < count; i++ {
+			var marker string
+			if ordered {
+				if chance(tc, 80) {
+					marker = strconv.Itoa(start+i) + delim
+				} else {
+					marker = strconv.Itoa(n(tc, 0, 999999999)) + delim
+				}
+			} else if chance(tc, 85) {
+				marker = bullet
+			} else {
+				marker = pick(tc, []string{"-", "*", "+"})
+			}
+			gap := pick(tc, []string{" ", " ", "  ", "   ", "    ", "     ", "\t", ""})
+			body := strings.Split(genBlock(tc, depth+1, n(tc, 1, 2)), "\n")
+			padN := len(gap)
+			if padN < 1 {
+				padN = 1
+			}
+			if padN > 4 {
+				padN = 4
+			}
+			pad := strings.Repeat(" ", len(marker)+padN)
+			for j := 1; j < len(body); j++ {
+				if chance(tc, 80) {
+					body[j] = pad + body[j]
+				} else {
+					body[j] = genIndent(tc) + body[j]
+				}
+			}
+			items = append(items, genIndent(tc)+marker+gap+strings.Join(body, "\n"))
+		}
+		return strings.Join(items, sep)
+	}
+	if k < 87 {
+		return pick(tc, htmlBlocks)
+	}
+	if k < 96 {
+		s := genIndent(tc) + "[" + pick(tc, refs) + "]:" + pick(tc, []string{" ", "", "\n", "  ", "\n  "}) + genURL(tc)
+		if chance(tc, 50) {
+			s += pick(tc, []string{" ", "\n", "  "}) + genTitle(tc)
+		}
+		return s + pick(tc, []string{"", " ", " x", "\n'"})
+	}
+	cols := n(tc, 1, 3)
+	cell := func() string {
+		return pick(tc, []string{" ", "  "}) + strings.ReplaceAll(genInline(tc, depth+1, n(tc, 0, 2)), "\n", " ") + " "
+	}
+	row := func() string {
+		cs := make([]string, cols)
+		for i := range cs {
+			cs[i] = cell()
+		}
+		return pick(tc, []string{"|", "", " |"}) + strings.Join(cs, "|") + pick(tc, []string{"|", "", "| "})
+	}
+	seps := make([]string, cols)
+	for i := range seps {
+		seps[i] = pick(tc, []string{" --- ", ":--", "--:", ":-:", "-", " : "})
+	}
+	lines := []string{row(), pick(tc, []string{"|", ""}) + strings.Join(seps, "|") + pick(tc, []string{"|", ""})}
+	for i, count := 0, n(tc, 0, 3); i < count; i++ {
+		lines = append(lines, row())
+	}
+	return strings.Join(lines, "\n")
+}
+
+func genBlock(tc hegel.TestCase, depth, count int) string {
+	out := make([]string, 0, count)
+	for i := 0; i < count; i++ {
+		out = append(out, genBlockAtom(tc, depth))
+	}
+	return strings.Join(out, pick(tc, []string{"\n\n", "\n\n", "\n", "\n\n\n", "\n \n", "\n\t\n"}))
+}
+
+func genDocument(tc hegel.TestCase) string {
+	s := genBlock(tc, 0, n(tc, 1, 4))
+	if chance(tc, 15) {
+		s = strings.ReplaceAll(s, "\n", "\r\n")
+	} else if !Known.loneCrIsText && chance(tc, 5) {
+		s = strings.ReplaceAll(s, "\n", "\r")
+	}
+	s += pick(tc, []string{"\n", "", "\n\n", "\n   ", " "})
+	if !Known.bomIsText && chance(tc, 5) {
+		s = "\uFEFF" + s
+	}
+	if !Known.nulKeptOnInput && chance(tc, 3) {
+		s = strings.ReplaceAll(s, "a", "\x00")
+	}
+	return s
+}
