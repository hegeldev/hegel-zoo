+var (
+	reEmptyQuote   = regexp.MustCompile(`<blockquote>\n</blockquote>`)
+	reHTMLBlockEnd = regexp.MustCompile(` ?\n?(</blockquote>|</li>)`)
+	// JavaScript's trim(): commonmark.js trims a paragraph's or heading's content with it, so
+	// Unicode spaces at either end vanish where the spec keeps them.
+	jsSpace       = `[\x{00A0}\x{1680}\x{2000}-\x{200A}\x{2028}\x{2029}\x{202F}\x{205F}\x{3000}\x{FEFF}]+`
+	reJsTrimLead  = regexp.MustCompile(`(<p>|<h[1-6]>|<li>)` + jsSpace)
+	reJsTrimTrail = regexp.MustCompile(jsSpace + `(</p>|</h[1-6]>|</li>|\n)`)
+	// commonmark.js copies raw HTML inside an image's alt text unescaped.
+	reAltAny = regexp.MustCompile(`(?s) alt=".*?"( />| title=)`)
+	// micromark's own readings.
+	reCodeTrailingBlank = regexp.MustCompile(`(\n[ \t]*)+\n</code></pre>`)
+	reTrailingWs        = regexp.MustCompile(`[ \t]+\n`)
+	reXhtmlVoid         = regexp.MustCompile(`<(hr|br|img [^>]*?|input [^>]*?) />`)
+	reInput             = regexp.MustCompile(`<input [^>]*>`)
+	reURLAttr           = regexp.MustCompile(` (href|src)="[^"]*"`)
+	reTrailingTab       = regexp.MustCompile(`[ \t]*\t\n`)
+	rePre               = regexp.MustCompile(`(?s)<pre>.*?</pre>`)
+	reEmptyTitle        = regexp.MustCompile(` title=""`)
+	reAlign             = regexp.MustCompile(` align="(left|center|right)"`)
+	reEmphasis          = regexp.MustCompile(`</?em>|</?strong>|[*_]`)
+	reControl           = regexp.MustCompile(`[\x01-\x08\x0b\x0e-\x1f\x7f]`)
+	reAttr              = regexp.MustCompile(`[a-z]+="[^"]*"`)
+)
+
+type shape struct {
+	name string
+	fn   func(string) string
+}
+
+// Output shapes of known bugs and of accepted differences, applied cumulatively to both sides
+// after the byte-exact comparison has failed.
+var shapes = []shape{
+	{"accepted-empty-quote", func(h string) string { return reEmptyQuote.ReplaceAllString(h, "<blockquote></blockquote>") }},
+	// goldmark (and micromark) copy CRLF line endings verbatim inside code and HTML blocks;
+	// commonmark.js writes LF. The spec does not say.
+	{"accepted-crlf-verbatim", func(h string) string { return strings.ReplaceAll(h, "\r\n", "\n") }},
+	// An HTML block ending the document without a final newline gets none (micromark agrees).
+	{"accepted-html-block-eof", func(h string) string {
+		return reHTMLBlockEnd.ReplaceAllString(strings.TrimSuffix(h, "\n"), "$1")
+	}},
+	{"accepted-js-trim", func(h string) string {
+		h = reJsTrimLead.ReplaceAllString(h, "$1")
+		return reJsTrimTrail.ReplaceAllString(h, "$1")
+	}},
+	// goldmark keeps a % that does not start a %XX escape (as cmark does); commonmark.js writes %25.
+	{"accepted-percent", func(h string) string {
+		return reURLAttr.ReplaceAllStringFunc(h, func(t string) string { return strings.ReplaceAll(t, "%25", "%") })
+	}},
+	// A tab before a soft line break: commonmark.js keeps it, micromark strips it, the spec
+	// speaks of spaces only. Compared with trailing tabs removed outside <pre>.
+	{"accepted-trailing-tab", func(h string) string {
+		return outsidePre(h, func(s string) string { return reTrailingTab.ReplaceAllString(s, "\n") })
+	}},
+	{"accepted-alt-raw-html", func(h string) string {
+		return reAltAny.ReplaceAllStringFunc(h, func(t string) string {
+			if strings.ContainsAny(t, "<&") {
+				return ` alt=""` + t[strings.LastIndex(t, `"`)+1:]
+			}
+			return t
+		})
+	}},
+}
+
+// outsidePre applies fn to the parts of h that are not inside <pre>...</pre>.
+func outsidePre(h string, fn func(string) string) string {
+	var b strings.Builder
+	last := 0
+	for _, m := range rePre.FindAllStringIndex(h, -1) {
+		b.WriteString(fn(h[last:m[0]]))
+		b.WriteString(h[m[0]:m[1]])
+		last = m[1]
+	}
+	b.WriteString(fn(h[last:]))
+	return b.String()
+}
+
+// v1Shape: v1 wrote title="" for an empty title (v2 omits it, as commonmark.js does) and no
+// align on a short row's missing cells.
+func v1Shape(h string) string {
+	return reAlign.ReplaceAllString(reEmptyTitle.ReplaceAllString(h, ""), "")
+}
+
+func classify(got, want string) string {
+	g, w := got, want
+	for _, s := range shapes {
+		g, w = s.fn(g), s.fn(w)
+		if g == w {
+			return s.name
+		}
+	}
+	return ""
+}
+
+// micromark's readings that are its own: whitespace-only lines kept in indented code at EOF,
+// trailing tabs before a soft break stripped, `*_*a` as emphasis (compared with every emphasis
+// delimiter and tag removed), valid control-character references replaced by U+FFFD. Applied on
+// top of every accepted shape, so that a document carrying one difference of each kind (a stray
+// "%" in an image's src and an "&#1;" after it) is not a mismatch.
+func classifyMicromark(got, want string) string {
+	f := func(h string) string {
+		for _, s := range shapes {
+			h = s.fn(h)
+		}
+		h = reCodeTrailingBlank.ReplaceAllString(h, "\n</code></pre>")
+		h = reTrailingWs.ReplaceAllString(h, "\n")
+		h = reEmphasis.ReplaceAllString(h, "")
+		return reControl.ReplaceAllString(h, "\uFFFD")
+	}
+	if f(got) == f(want) {
+		return "accepted-micromark"
+	}
+	return ""
+}
+
+// gfmShape: presentation differences between goldmark's GFM renderers and micromark's
+// (attribute order of the task-list input, void tags, no final newline), plus the CommonMark
+// shapes.
+func gfmShape(h string) string {
+	h = strings.TrimSuffix(h, "\n")
+	// micromark writes no line ending between </thead> and <tbody> when the table is the first
+	// block after a link reference definition; goldmark, and micromark elsewhere, write one.
+	h = strings.ReplaceAll(h, "</thead><tbody>", "</thead>\n<tbody>")
+	h = reInput.ReplaceAllStringFunc(h, func(t string) string {
+		attrs := reAttr.FindAllString(t, -1)
+		sort.Strings(attrs)
+		return "<input " + strings.Join(attrs, " ") + ">"
+	})
+	h = reXhtmlVoid.ReplaceAllString(h, "<$1>")
+	return reEmptyQuote.ReplaceAllString(h, "<blockquote></blockquote>")
+}
