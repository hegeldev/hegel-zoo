+	reEmptyNestedItem = regexp.MustCompile(`\n[ \t>]*(  |\t)[ \t]*([-+*]|[0-9]{1,9}[.)])[ \t]*\r?\n([ \t>]*\r?\n)+[ \t>]*(  |\t)[ \t]*\S`)
