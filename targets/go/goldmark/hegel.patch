+
+// --------------------------------------------------------------------------- util models
+
+func isASCIIPunct(c byte) bool {
+	return strings.IndexByte("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", c) >= 0
+}
+
+func isSpecWhitespace(r rune) bool {
+	return unicode.Is(unicode.Zs, r) || r == '\t' || r == '\n' || r == '\f' || r == '\r'
+}
+
+// encodeURIModel: JavaScript's encodeURI on UTF-8 bytes, with % always kept (cmark does the
+// same; commonmark.js writes %25 for a stray %), and & as &amp; (the output is written into an
+// HTML attribute).
+func encodeURIModel(s string) string {
+	const keep = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789;,/?:@&=+$-_.!~*'()#"
+	var b strings.Builder
+	bs := []byte(s)
+	for i := 0; i < len(bs); i++ {
+		c := bs[i]
+		switch {
+		case c == '%':
+			b.WriteByte(c)
+		case c == '&':
+			b.WriteString("&amp;")
+		case strings.IndexByte(keep, c) >= 0:
+			b.WriteByte(c)
+		default:
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+// utilTexts: up to twelve characters from the classes the util models care about: ASCII
+// letters and digits, every kind of whitespace, NUL, URL and HTML specials, non-ASCII letters
+// and spaces, and the special cases of case folding.
+var utilTexts = hegel.Text().Alphabet("aZ09 \t\n\r\x0b\x0c\x00&<>\"'%/?#[]()é中\u00A0 \uFEFF\u3000ßﬀΣς-_.~\u0085\u2028").MaxSize(12)
+
+func TestHegelUtilsMatchTheirModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, utilTexts)
+		// byte classes (the spec's ASCII sets)
+		for i := 0; i < len(s); i++ {
+			c := s[i]
+			if util.IsPunct(c) != (c < 0x80 && isASCIIPunct(c)) {
+				ht.Fatalf("IsPunct(%q) = %v", c, util.IsPunct(c))
+			}
+			// util's whitespace sets differ from each other (README): IsSpace is space, tab, LF, CR;
+			// TrimLeftSpace/TrimRightSpace also trim FF and VT; IsBlank follows IsSpace.
+			if util.IsSpace(c) != (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+				ht.Fatalf("IsSpace(%q) = %v", c, util.IsSpace(c))
+			}
+			if util.IsAlphaNumeric(c) != (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9') {
+				ht.Fatalf("IsAlphaNumeric(%q) = %v", c, util.IsAlphaNumeric(c))
+			}
+		}
+		for _, r := range s {
+			if util.IsPunctRune(r) != (unicode.IsPunct(r) || unicode.IsSymbol(r)) {
+				ht.Fatalf("IsPunctRune(%q) = %v", r, util.IsPunctRune(r))
+			}
+			// U+000B, U+0085, U+2028 and U+2029 are Unicode White_Space but not in the spec's
+			// list; cmark excludes them, commonmark.js and micromark (JavaScript's \s) include them,
+			// goldmark (unicode.IsSpace) includes them: left to the README, not asserted.
+			if r != '\v' && r != 0x85 && r != 0x2028 && r != 0x2029 && util.IsSpaceRune(r) != isSpecWhitespace(r) {
+				ht.Fatalf("IsSpaceRune(%q) = %v, the spec's Unicode whitespace says %v", r, util.IsSpaceRune(r), isSpecWhitespace(r))
+			}
+		}
+		bs := []byte(s)
+		if got, want := string(util.TrimLeftSpace(bs)), strings.TrimLeft(s, " \t\n\r\f\v"); got != want {
+			ht.Fatalf("TrimLeftSpace(%q) = %q, want %q", s, got, want)
+		}
+		if got, want := string(util.TrimRightSpace(bs)), strings.TrimRight(s, " \t\n\r\f\v"); got != want {
+			ht.Fatalf("TrimRightSpace(%q) = %q, want %q", s, got, want)
+		}
+		if got, want := util.IsBlank(bs), strings.Trim(s, " \t\n\r") == ""; got != want {
+			ht.Fatalf("IsBlank(%q) = %v", s, got)
+		}
+		esc := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", "\"", "&quot;", "\x00", "\uFFFD").Replace(s)
+		if got := string(util.EscapeHTML(bs)); got != esc {
+			ht.Fatalf("EscapeHTML(%q) = %q, want %q", s, got, esc)
+		}
+		if got, want := string(util.URLEscape(bs)), encodeURIModel(s); got != want {
+			ht.Fatalf("URLEscape(%q) = %q, want %q", s, got, want)
+		}
+		// ToLinkReference: trimmed, case folded, internal whitespace runs collapsed to one space;
+		// idempotent, insensitive to ASCII case and to the amount of internal whitespace.
+		ref := util.ToLinkReference(bs)
+		if util.ToLinkReference([]byte(ref)) != ref {
+			ht.Fatalf("ToLinkReference not idempotent on %q: %q then %q", s, ref, util.ToLinkReference([]byte(ref)))
+		}
+		if util.ToLinkReference([]byte(strings.ToUpper(s))) != util.ToLinkReference([]byte(strings.ToLower(s))) {
+			ht.Fatalf("ToLinkReference case-sensitive on %q", s)
+		}
+		if strings.Contains(ref, "  ") || strings.ContainsAny(ref, "\t\n\r") || ref != strings.Trim(ref, " \t\n\r") {
+			ht.Fatalf("ToLinkReference(%q) = %q keeps whitespace", s, ref)
+		}
+		// tabs
+		pos := hegel.Draw(ht, hegel.Integers(0, 12))
+		if got, want := util.TabWidth(pos), 4-pos%4; got != want {
+			ht.Fatalf("TabWidth(%d) = %d", pos, got)
+		}
+		// case folding: idempotent, ASCII lower-cased, sharp s -> ss, ff ligature -> ff, sigma forms -> sigma
+		folded := string(util.DoFullUnicodeCaseFolding(bs))
+		if string(util.DoFullUnicodeCaseFolding([]byte(folded))) != folded {
+			ht.Fatalf("case folding not idempotent on %q", s)
+		}
+		model := strings.NewReplacer("ß", "ss", "ﬀ", "ff", "Σ", "σ", "ς", "σ").Replace(strings.Map(func(r rune) rune {
+			if r >= 'A' && r <= 'Z' {
+				return r + 32
+			}
+			return r
+		}, s))
+		if folded != model {
+			ht.Fatalf("DoFullUnicodeCaseFolding(%q) = %q, want %q", s, folded, model)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- typographer
+
+// typographerModel: the documented substitutions of runs of - . < > in plain text, longest
+// match first, left to right (quotes are left to the fixtures).
+func typographerModel(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		switch {
+		case strings.HasPrefix(s[i:], "---"):
+			b.WriteString("—")
+			i += 3
+		case strings.HasPrefix(s[i:], "--"):
+			b.WriteString("–")
+			i += 2
+		case strings.HasPrefix(s[i:], "..."):
+			b.WriteString("…")
+			i += 3
+		case strings.HasPrefix(s[i:], "<<"):
+			b.WriteString("«")
+			i += 2
+		case strings.HasPrefix(s[i:], ">>"):
+			b.WriteString("»")
+			i += 2
+		default:
+			b.WriteByte(s[i])
+			i++
+		}
+	}
+	return b.String()
+}
+
+// typographerTexts: a word, one to eight pieces of the typographer's triggers (runs of hyphens
+// and dots, the guillemet pairs) among letters, digits and spaces, and a closing letter or
+// dot. "<<" right before a letter or digit would be raw HTML or autolink territory and is left
+// out (a filter at a few percent of the raw draws).
+var (
+	typographerPieces = pick(" ", "", "a", "b ", "-", "--", "---", "----", ".", "..", "...", "....", "<<", ">>", "<< ", " >>", "1", ", ")
+	typographerTexts  = hegel.Filter(cat(pick("a", "foo", "x"), joined(many(typographerPieces, 1, 8), ""), pick("a", "z", ".")), func(s string) bool {
+		return !strings.Contains(s, "<<a") && !strings.Contains(s, "<<b") && !strings.Contains(s, "<<1")
+	})
+)
+
+func TestHegelTypographerMatchesTheDocumentedTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, typographerTexts)
+		want := "<p>" + typographerModel(src) + "</p>\n"
+		got := render(typoP, cmR, src)
+		if got != want {
+			ht.Fatalf("src %s\n goldmark %s\n model %s", show(src), show(got), show(want))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- performance
+
+var units = []string{"*", "_", "**", "[", "]", "(", ")", "`", "<", ">", "&", "\\", "#", "-", "> ", "- ", "1. ", "```\n", "~~~\n", "    ",
+	"[a]: /u\n", "[a]", "![a]", "&amp;", "&#x41;", "<a ", "<!--", "|", "~~", "* ", "\n", " \n", "a\n", "\\\n", "[a](", "<http://", "www.", "a@b."}
+
+// repeatCase: a unit of one to four pieces to repeat, and whether the CommonMark configuration
+// renders it (the every-extension one otherwise).
+type repeatCase struct {
+	unit       string
+	commonMark bool
+}
+
+func (c repeatCase) GoString() string {
+	return fmt.Sprintf("unit %q, CommonMark %v", c.unit, c.commonMark)
+}
+
+var repeatCases = hegel.Map(pairs(joined(many(hegel.SampledFrom(units), 1, 4), ""), chance(50)), func(p pair[string, bool]) repeatCase {
+	return repeatCase{unit: p.a, commonMark: p.b}
+})
+
+func TestHegelRenderingTimeIsNotSuperLinear(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, repeatCases)
+		p, r := allP, allR
+		if c.commonMark {
+			p, r = cmP, cmR
+		}
+		timeIt := func(k int) time.Duration {
+			src := strings.Repeat(c.unit, k)
+			start := time.Now()
+			render(p, r, src)
+			return time.Since(start)
+		}
+		small, big := timeIt(1500), timeIt(6000)
+		if big > 3*time.Second && big > 25*small {
+			ht.Fatalf("unit %s: 1500 repeats %v, 6000 repeats %v", show(c.unit), small, big)
+		}
+	})
+}
