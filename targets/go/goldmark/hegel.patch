+// judgeLinkify compares the Linkify extension with micromark's GFM autolink literals on src,
+// presentation differences aside, and fails the case on a mismatch, naming the recorded bugs
+// whose shape the source has.
+func judgeLinkify(ht *hegel.T, col *collector, src string) {
+	got := gfmShape(render(linkP, cmR, src))
+	want := gfmShape(oracle(ht, "linkify", src))
+	if got == want {
+		col.count("ok")
+		return
+	}
+	if col.accepted(src, commonMarkShapes, linkifyShapes) {
+		return
+	}
+	// micromark misreading the CommonMark core of this very document (where goldmark agrees
+	// with commonmark.js) is its own problem, as in the GFM differential.
+	cmjs := oracle(ht, "cm", src)
+	if core := render(cmP, cmR, src); core == cmjs || classify(core, cmjs) != "" {
+		if mm := oracle(ht, "mm", src); mm != cmjs && classify(mm, cmjs) == "" && classifyMicromark(mm, cmjs) == "" {
+			col.count("micromark-core-quirk")
+			return
+		}
+	}
+	col.mismatch(ht, bugsOf(src, commonMarkShapes, linkifyShapes), "src %s\n goldmark %s\n micromark %s", show(src), show(got), show(want))
+}
