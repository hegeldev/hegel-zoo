+// checkAST: parent/sibling links, child counts, owner document, positions inside the source,
+// source segments inside the source and in order; returns "" or the first problem.
+func checkAST(doc ast.Node, src []byte) string {
+	var walk func(nd ast.Node, depth int) string
+	walk = func(nd ast.Node, depth int) string {
+		if depth > 10000 {
+			return "too deep"
+		}
+		if nd.OwnerDocument() != doc && nd != doc {
+			return fmt.Sprintf("%s: owner document is not the document", nd.Kind())
+		}
+		if p := nd.Pos(); p < -1 || p > len(src) {
+			return fmt.Sprintf("%s: Pos %d outside 0..%d", nd.Kind(), p, len(src))
+		}
+		if b, ok := nd.(ast.BlockNode); ok {
+			last := -1
+			for _, s := range b.Source() {
+				if s.Start < 0 || s.Stop < s.Start || s.Stop > len(src) || s.Padding < 0 {
+					return fmt.Sprintf("%s: segment %+v outside the source (%d bytes)", nd.Kind(), s, len(src))
+				}
+				if s.Start < last {
+					return fmt.Sprintf("%s: segments out of order (%d after %d)", nd.Kind(), s.Start, last)
+				}
+				last = s.Stop
+			}
+		}
+		count := 0
+		var prev ast.Node
+		for c := range nd.Children() {
+			count++
+			if c.Parent() != nd {
+				return fmt.Sprintf("%s: child %s has parent %v", nd.Kind(), c.Kind(), c.Parent())
+			}
+			if c.PreviousSibling() != prev {
+				return fmt.Sprintf("%s: child %s has the wrong previous sibling", nd.Kind(), c.Kind())
+			}
+			if prev != nil && prev.NextSibling() != c {
+				return fmt.Sprintf("%s: child %s is not its predecessor's next sibling", nd.Kind(), c.Kind())
+			}
+			if msg := walk(c, depth+1); msg != "" {
+				return msg
+			}
+			prev = c
+		}
+		if prev != nil && prev.NextSibling() != nil {
+			return fmt.Sprintf("%s: last child has a next sibling", nd.Kind())
+		}
+		if (count == 0) == nd.HasChildren() || count != nd.ChildCount() {
+			return fmt.Sprintf("%s: %d children but HasChildren=%v ChildCount=%d", nd.Kind(), count, nd.HasChildren(), nd.ChildCount())
+		}
+		if (count == 0) != (nd.FirstChild() == nil) || (count == 0) != (nd.LastChild() == nil) || (nd.LastChild() != nil && nd.LastChild() != prev) {
+			return fmt.Sprintf("%s: FirstChild/LastChild disagree with the children", nd.Kind())
+		}
+		return ""
+	}
+	return walk(doc, 0)
+}
+
+// hasTable reports whether the tree holds a table: goldmark/23's shape, since the table
+// transformer leaves the parent's ChildCount one too high.
+func hasTable(nd ast.Node) bool {
+	if nd.Kind() == extast.KindTable {
+		return true
+	}
+	for c := range nd.Children() {
+		if hasTable(c) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelAstIsWellFormed: the tree of every extension's parser, Dump, and rendering the same
+// tree twice (and from a string source) gives the same HTML. A tree holding a table has
+// goldmark/23's shape: its ChildCount check fails naming the bug, or under HEGEL_NO_KNOWN=1
+// the document is assumed away.
+func TestHegelAstIsWellFormed(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, proseDocs)
+		col.count("cases")
+		bs := []byte(src)
+		doc := allP.Parse(bs)
+		if doc.Kind() != ast.KindDocument {
+			ht.Fatalf("Parse gives a %s", doc.Kind())
+		}
+		table := hasTable(doc)
+		if Known.tableChildCountStale && table {
+			col.count("known-table-child-count")
+			ht.Assume(false)
+		}
+		if msg := checkAST(doc, bs); msg != "" {
+			var bugs []string
+			if table {
+				bugs = []string{"goldmark/23"}
+			}
+			col.mismatch(ht, bugs, "%s\n src %s", msg, show(src))
+			return
+		}
+		col.count("ok")
+		if doc.Dump(bs) == nil {
+			ht.Fatalf("Dump gives nil")
+		}
+		var b1, b2, b3 bytes.Buffer
+		if err := allR.Render(&b1, bs, doc); err != nil {
+			ht.Fatalf("Render: %v", err)
+		}
+		if err := allR.Render(&b2, bs, doc); err != nil {
+			ht.Fatalf("Render again: %v", err)
+		}
+		if err := allR.RenderStringSource(&b3, src, allP.ParseStringSource(src)); err != nil {
+			ht.Fatalf("RenderStringSource: %v", err)
+		}
+		if b1.String() != b2.String() {
+			ht.Fatalf("rendering the same tree twice differs\n src %s\n 1 %s\n 2 %s", show(src), show(b1.String()), show(b2.String()))
+		}
+		if b1.String() != b3.String() {
+			ht.Fatalf("string source renders differently\n src %s\n bytes %s\n string %s", show(src), show(b1.String()), show(b3.String()))
+		}
+	})
+}
