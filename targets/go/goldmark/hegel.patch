+package goldmark_test
+
+// Generators: a Markdown document is a tree of small records - blocks (paragraphs, ATX and
+// setext headings, thematic breaks, fences, indented code, block quotes, lists, HTML blocks,
+// reference definitions, GFM tables) holding lines of inline atoms (words, whitespace and
+// breaks, emphasis, code spans, links and images, autolinks, entities, escapes, raw HTML,
+// autolink literals, typographer triggers, junk) - rendered to Markdown by pure functions
+// (md), and a document style (line endings, trailer, BOM, NUL) applied last. The grammar is
+// a pair of depth-indexed, memoised generator functions, atomAt(depth) and blockAt(depth),
+// built once per configuration (documents(cfg)); the plain alternative (a word, a paragraph)
+// comes first in every choice, so a shrunk document is a word.
+
+import (
+	"strconv"
+	"strings"
+	"sync"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- piece tables
+
+var words = []string{"a", "b", "foo", "bar", "baz", "x", "yz", "qux", "Hello", "world", "α", "日本", "é",
+	"tab", "1", "42", "3.14", "-", "+", "_", "*", "~", "|", "#", "!", ".", ")", "(", "'", "\"", "&", "<", ">", ":", "/"}
+
+var schemes = []string{"http://", "https://", "ftp://", "mailto:", "", "/", "./", "#", "javascript:", "data:image/png;base64,", "vbscript:", "file:///"}
+
+var entities = []string{"&amp;", "&lt;", "&gt;", "&quot;", "&copy;", "&#35;", "&#x41;", "&#X41;", "&nbsp;", "&bogus;",
+	"&amp", "&#0;", "&#xD800;", "&#1114112;", "&ouml", "&ouml;", "&ngE;", "&#x0;", "&AMP;", "&Amp;", "& b", "&;", "&#;", "&#1;"}
+
+var rawInline = []string{"<b>", "</b>", "<a href='x'>", "<a href=\"y\" >", "<br/>", "<!-- c -->", "<!---->", "<?php x ?>",
+	"<!X y>", "<![CDATA[z]]>", "<b x=y>", "<b x = 'y'>", "<3", "< b>", "<b/ >", "<a.b>", "<a-b>", "<b x=\"y\"z>",
+	"<img src=x>", "<!-->", "<!--->", "<!-- -- -->", "<x:y>", "<ab@c.d>", "<foo\nbar>"}
+
+var refs = []string{"ref", "Ref", "r e f", "ΑΒΓ", "αβγ", "ﬀ", "a\\]b", "*x*", "x[y", "1", "a  b", "İϴΩKÅ", "ß", "SS"}
+
+var autolinks = []string{"<http://a.b/c?d=1&e=2>", "<https://x.y>", "<mailto:a@b.c>", "<a@b.c>", "<a.b@c.d>", "<x:y>",
+	"<http://a b>", "<http://[::1]/x>", "<made-up+scheme://x>", "<http://a.b/ñ>", "<HTTP://A.B>", "<a:>", "<ab:c>", "<a@b>"}
+
+var bare = []string{"www.example.com", "http://ex.am/ple?x=1", "foo@bar.baz", "ftp://a.b", "HTTP://X.Y/Z", "example.com/a(b)", "x.com.",
+	"www.a.b/c_d_", "http://x.y/(a)", "www.x.y/a.", "mailto:a@b.c", "a@b.c.", "http://a.b/c,", "www.foo.bar/baz;", "https://x.y/a?b=c&d", "www.x.y/π", "xmpp:a@b.c/d"}
+
+// bareGfm: the shapes GFM's autolink literals define (goldmark's Linkify also links ftp:// and
+// documents it; mailto:/xmpp: are read differently by the two).
+var bareGfm = []string{"www.example.com", "http://ex.am/ple?x=1", "foo@bar.baz", "HTTP://X.Y/Z", "example.com/a(b)", "x.com.",
+	"www.a.b/c_d_", "http://x.y/(a)", "www.x.y/a.", "a@b.c.", "http://a.b/c,", "https://x.y/a?b=c&d", "www.x.y/π",
+	"www.x.y/a_", "http://x.y/a~", "www.x.y?a=b&c=d", "http://x.y/a&amp;", "www.x.y/a)", "www.x.y/(a))", "http://x.y/a.b.", "www.x", "a.b@c.d-e.f", "a_b@c.d", "a.@c.d", "a@b.c_", "a@b.c-",
+	"_foo@bar.baz", "www.x.y/a*b", "www.x.y/a~b", "http://x.y/a_b_", "www.x.y/日本", "www.x.y/a&b;", "www.x.y/&amp;", "http://x.y/a:", "www.x.y/a!", "www.x.y/a?"}
+
+var typo = []string{"(c)", "(C)", "(r)", "(tm)", "+-", "...", "--", "---", "!!!!", "????", ",,", "..", "----", "<<", ">>", "'90s", "it's", "'a'", "\"b\""}
+
+var odd = []string{"\u00A0", " ", "", " ", "\x0b", "\uFEFF", "\u3000", "\u200B", "\x0c"}
+
+var htmlBlocks = []string{"<div>", "<div>\n*x*\n</div>", "<pre>\na\n</pre>", "<!-- c\n-->", "<?x\n?>", "<!X>", "<![CDATA[\n]]>", "<script>\n<x>\n</script>",
+	"<table><tr><td>\n<pre>\n**a**\n</pre>\n</td></tr></table>", "</div>\n*b*", "<DIV CLASS=x>", "<a href=\"x\">\n*y*", "<b>\nc", "<textarea>\n*a*\n</textarea>",
+	"<div\n", "<hr/>", "<foo bar>", "<!DOCTYPE html>", "<!doctype html>", "<del>\n*a*\n</del>", "<span>\n*a*", "<x-y>", "<h1>\nT\n</h1>"}
+
+// --------------------------------------------------------------------------- inline records
+
+// inline is one inline atom; md renders it to Markdown.
+type inline interface{ md() string }
+
+// text is a leaf: a word, whitespace, an entity, an escape, raw HTML, an autolink, a bare URL,
+// a typographer trigger or junk.
+type text string
+
+func (t text) md() string { return string(t) }
+
+func joinInlines(xs []inline) string {
+	var b strings.Builder
+	for _, x := range xs {
+		b.WriteString(x.md())
+	}
+	return b.String()
+}
+
+// codeSpan: a run of ticks backticks on either side of inner.
+type codeSpan struct {
+	ticks int
+	inner string
+}
+
+func (c codeSpan) md() string {
+	t := strings.Repeat("`", c.ticks)
+	return t + c.inner + t
+}
+
+// emphasis: an opening delimiter run, its content, and a closer that mirrors the opener four
+// times in five and is another run (or nothing) otherwise.
+type emphasis struct {
+	marker string
+	inner  []inline
+	closer string
+}
+
+func (e emphasis) md() string { return e.marker + joinInlines(e.inner) + e.closer }
+
+// link: a link, or an image when bang, in one of six forms. inline: [text](dest "title") with
+// the title present or not; spaced: the title after a line ending or two spaces, with trailing
+// whitespace before the parenthesis; full: [text][ref]; shortcut: [ref]; collapsed: [ref][];
+// odd: an inline link whose destination is one of the spec's edge cases.
+type link struct {
+	bang  bool
+	form  string
+	text  []inline
+	dest  string
+	ws    string
+	title string
+	after string
+	ref   string
+}
+
+func (l link) md() string {
+	b := ""
+	if l.bang {
+		b = "!"
+	}
+	switch l.form {
+	case "inline":
+		t := ""
+		if l.title != "" {
+			t = " " + l.title
+		}
+		return b + "[" + joinInlines(l.text) + "](" + l.dest + t + ")"
+	case "spaced":
+		return b + "[" + joinInlines(l.text) + "](" + l.dest + l.ws + l.title + l.after + ")"
+	case "full":
+		return b + "[" + joinInlines(l.text) + "][" + l.ref + "]"
+	case "shortcut":
+		return b + "[" + l.ref + "]"
+	case "collapsed":
+		return b + "[" + l.ref + "][]"
+	}
+	return b + "[" + joinInlines(l.text) + "](" + l.dest + ")" // odd
+}
+
+// asInline is a text generator as an inline atom generator.
+func asInline(g hegel.Generator[string]) hegel.Generator[inline] {
+	return hegel.Map(g, func(s string) inline { return text(s) })
+}
+
+func reversed(s string) string {
+	r := []rune(s)
+	for i, j := 0, len(r)-1; i < j; i, j = i+1, j-1 {
+		r[i], r[j] = r[j], r[i]
+	}
+	return string(r)
+}
+
+func closingQuote(q string) string {
+	if q == "(" {
+		return ")"
+	}
+	return q
+}
+
+var (
+	wordTexts = hegel.SampledFrom(words)
+	// spaceTexts: the whitespace between words, with soft and hard breaks; oddSpaceTexts mixes
+	// in Unicode spaces, a BOM and a zero-width space two times in five.
+	spaceTexts    = pick(" ", "  ", "\n", "  \n", "\\\n", " \\\n", "\t", "\n ", "\n\t")
+	oddSpaceTexts = weighted(choice[string]{60, spaceTexts}, choice[string]{40, hegel.SampledFrom(odd)})
+	escapeTexts   = cat(lit("\\"), pick("*", "_", "\\", "`", "[", "]", "(", ")", "#", "<", ">", "&", "!", "a", " ", "-", "|", "~", "\"", "'", "."))
+	junkTexts     = hegel.Text().Alphabet("*_`[]()!<>#-+&\\ ~|=\"'").MinSize(1).MaxSize(6)
+	autolinkTexts = hegel.SampledFrom(autolinks)
+	entityTexts   = hegel.SampledFrom(entities)
+	rawTexts      = hegel.SampledFrom(rawInline)
+	bareTexts     = hegel.SampledFrom(bare)
+	typoTexts     = hegel.SampledFrom(typo)
+	refTexts      = hegel.SampledFrom(refs)
+
+	// urls: a scheme and a host, a path three times in ten, in angle brackets one time in ten
+	// (with a space before the closing bracket three times in ten of those).
+	urlHosts  = hegel.Text().Alphabet("abcxyz.-_").MaxSize(8)
+	urlPaths  = hegel.Text().Alphabet("abc%20/?=&#[]{}|^`\\ αß'\"()").MaxSize(8)
+	plainURLs = cat(hegel.SampledFrom(schemes), urlHosts, maybe(30, cat(lit("/"), urlPaths)))
+	urls      = weighted(choice[string]{90, plainURLs}, choice[string]{10, cat(lit("<"), plainURLs, maybe(30, lit(" ")), lit(">"))})
+
+	// titles: a link title in one of the three quoting styles; optionalTitles two times in five.
+	titleQuotes    = pick("\"", "'", "(")
+	titleBodies    = hegel.Text().Alphabet("abc &\"'()\\").MaxSize(6)
+	titles         = hegel.Map(pairs(titleQuotes, titleBodies), func(p pair[string, string]) string { return p.a + p.b + closingQuote(p.a) })
+	optionalTitles = maybe(40, titles)
+
+	// codeSpans: one to three backticks around a short text, or one of the spec's edge cases
+	// (spaces only, inner backticks, line endings) one time in five.
+	codeSpanInners = weighted(
+		choice[string]{80, hegel.Text().Alphabet("ab ` *_[]<&").MaxSize(8)},
+		choice[string]{20, pick(" ", "  ", " a ", "``", " `` ", "a\nb", "\n", " \n ")},
+	)
+	codeSpans = hegel.Map(pairs(hegel.Integers(1, 3), codeSpanInners), func(p pair[int, string]) inline { return codeSpan{p.a, p.b} })
+
+	// emphasisMarkers are the opening runs; emphasisClosers[m] closes the opener m.
+	emphasisMarkers = []string{"*", "**", "_", "__", "***", "___", "*_", "_*", "~~", "~", "**_", "*__"}
+	emphasisClosers = func() map[string]hegel.Generator[string] {
+		closers := map[string]hegel.Generator[string]{}
+		for _, m := range emphasisMarkers {
+			closers[m] = weighted(choice[string]{80, lit(reversed(m))}, choice[string]{20, pick("*", "_", "**", "__", "")})
+		}
+		return closers
+	}()
+
+	bangs     = chance(30)
+	linkWs    = pick("  ", "\n", " \n ")
+	linkAfter = pick("", " ", "\n")
+	oddDests  = pick("", " ", "<>", "()", "(a)", "a b", "<a b>", "a\nb", "\\)", "a)b")
+)
+
+// --------------------------------------------------------------------------- block records
+
+// block is one block; md renders it to Markdown (lines joined by "\n", no final newline).
+type block interface{ md() string }
+
+// line: a line of a paragraph or setext heading, indented or not.
+type line struct {
+	indent  string
+	inlines []inline
+}
+
+func (l line) md() string { return l.indent + joinInlines(l.inlines) }
+
+func joinLines(ls []line) string {
+	out := make([]string, len(ls))
+	for i, l := range ls {
+		out[i] = l.md()
+	}
+	return strings.Join(out, "\n")
+}
+
+type paragraph struct{ lines []line }
+
+func (p paragraph) md() string { return joinLines(p.lines) }
+
+// atxHeading: an indent, one to seven hashes, the gap (a space, nothing, two spaces or a
+// tab), the content and a closing sequence.
+type atxHeading struct {
+	indent  string
+	level   int
+	gap     string
+	inlines []inline
+	tail    string
+}
+
+func (h atxHeading) md() string {
+	return h.indent + strings.Repeat("#", h.level) + h.gap + joinInlines(h.inlines) + h.tail
+}
+
+// setextHeading: one or two lines and an underline (either character, any length, and the
+// spec's near misses).
+type setextHeading struct {
+	lines     []line
+	indent    string
+	underline string
+}
+
+func (h setextHeading) md() string { return joinLines(h.lines) + "\n" + h.indent + h.underline }
+
+type thematicBreak struct{ indent, text string }
+
+func (b thematicBreak) md() string { return b.indent + b.text }
+
+// fence: a fenced code block; the body without its line ending one time in five, unclosed
+// three times in twenty, the closing fence followed by closeTail.
+type fence struct {
+	indent, marker, info, body string
+	noNewline, unclosed        bool
+	closeTail                  string
+}
+
+func (f fence) md() string {
+	s := f.indent + f.marker + f.info + "\n" + f.body
+	if !f.noNewline {
+		s += "\n"
+	}
+	if !f.unclosed {
+		s += f.marker + f.closeTail
+	}
+	return s
+}
+
+// indentedCode: a lead of four or more columns (spaces, a tab, mixtures), a body, and two
+// times in five a tab-indented second line.
+type indentedCode struct{ lead, body, tail string }
+
+func (c indentedCode) md() string { return c.lead + c.body + c.tail }
+
+// blockSeq: blocks joined by one separator (a blank line, one line ending, two blank lines,
+// a whitespace-only line).
+type blockSeq struct {
+	blocks []block
+	sep    string
+}
+
+func (s blockSeq) md() string {
+	out := make([]string, len(s.blocks))
+	for i, b := range s.blocks {
+		out[i] = b.md()
+	}
+	return strings.Join(out, s.sep)
+}
+
+// blockQuote: inner blocks whose every line is prefixed by a quote marker from the tape, read
+// modulo its length.
+type blockQuote struct {
+	prefixes []string
+	inner    blockSeq
+}
+
+func (q blockQuote) md() string {
+	lines := strings.Split(q.inner.md(), "\n")
+	for i, l := range lines {
+		lines[i] = q.prefixes[i%len(q.prefixes)] + l
+	}
+	return strings.Join(lines, "\n")
+}
+
+// list: bullet or ordered items, tight or loose (a blank line between items). An item's
+// marker is the list's (the bullet; start+i and the delimiter) unless odd names another
+// bullet or number; gap is the whitespace after the marker; the item's later lines are
+// indented from the tape cont, read modulo its length: padMark is the item's content column
+// (the marker's width plus one to four columns of gap), anything else an explicit indent.
+type list struct {
+	ordered bool
+	start   int
+	bullet  string
+	delim   string
+	loose   bool
+	items   []listItem
+}
+
+type listItem struct {
+	indent string
+	odd    string
+	gap    string
+	body   blockSeq
+	cont   []string
+}
+
+const padMark = "pad"
+
+func (l list) md() string {
+	items := make([]string, len(l.items))
+	for i, it := range l.items {
+		marker := l.bullet
+		if l.ordered {
+			marker = strconv.Itoa(l.start+i) + l.delim
+		}
+		if it.odd != "" {
+			marker = it.odd
+			if l.ordered {
+				marker += l.delim
+			}
+		}
+		pad := strings.Repeat(" ", len(marker)+min(max(len(it.gap), 1), 4))
+		body := strings.Split(it.body.md(), "\n")
+		for j := 1; j < len(body); j++ {
+			c := it.cont[(j-1)%len(it.cont)]
+			if c == padMark {
+				c = pad
+			}
+			body[j] = c + body[j]
+		}
+		items[i] = it.indent + marker + it.gap + strings.Join(body, "\n")
+	}
+	sep := "\n"
+	if l.loose {
+		sep = "\n\n"
+	}
+	return strings.Join(items, sep)
+}
+
+type htmlBlock string
+
+func (h htmlBlock) md() string { return string(h) }
+
+// definition: a link reference definition; the destination after a gap (a space, nothing, a
+// line ending), a title half the time, and a tail that may spoil it.
+type definition struct {
+	indent, ref, gap, dest, title, tail string
+}
+
+func (d definition) md() string {
+	return d.indent + "[" + d.ref + "]:" + d.gap + d.dest + d.title + d.tail
+}
+
+// table: a header row, a delimiter row of one separator per column between optional outer
+// pipes, and body rows; every row has the table's column count.
+type table struct {
+	header            tableRow
+	seps              []string
+	sepLead, sepTrail string
+	rows              []tableRow
+}
+
+type tableRow struct {
+	lead  string
+	cells []tableCell
+	trail string
+}
+
+type tableCell struct {
+	pad     string
+	inlines []inline
+}
+
+func (c tableCell) md() string {
+	return c.pad + strings.ReplaceAll(joinInlines(c.inlines), "\n", " ") + " "
+}
+
+func (r tableRow) md() string {
+	cells := make([]string, len(r.cells))
+	for i, c := range r.cells {
+		cells[i] = c.md()
+	}
+	return r.lead + strings.Join(cells, "|") + r.trail
+}
+
+func (t table) md() string {
+	lines := []string{t.header.md(), t.sepLead + strings.Join(t.seps, "|") + t.sepTrail}
+	for _, r := range t.rows {
+		lines = append(lines, r.md())
+	}
+	return strings.Join(lines, "\n")
+}
+
+// docStyle: the document's line endings, what follows the last block, and the shapes of bugs
+// 1 and 7: a leading byte order mark, and every "a" replaced by a NUL byte.
+type docStyle struct {
+	lineEnd string
+	trailer string
+	bom     bool
+	nul     bool
+}
+
+type document struct {
+	body  blockSeq
+	style docStyle
+}
+
+func (d document) md() string {
+	s := d.body.md()
+	if d.style.lineEnd != "\n" {
+		s = strings.ReplaceAll(s, "\n", d.style.lineEnd)
+	}
+	s += d.style.trailer
+	if d.style.bom {
+		s = "\xEF\xBB\xBF" + s
+	}
+	if d.style.nul {
+		s = strings.ReplaceAll(s, "a", "\x00")
+	}
+	return s
+}
+
+var (
+	indents         = pick("", "", "", " ", "  ", "   ", "\t", " \t")
+	blockSeps       = pick("\n\n", "\n\n", "\n", "\n\n\n", "\n \n", "\n\t\n")
+	atxLevels       = hegel.Integers(1, 7)
+	atxGaps         = pick(" ", "", "  ", "\t")
+	atxTails        = pick("", " #", " ##", "#", " # ", " ###\t")
+	underlines      = pick("=", "===", "-", "---", "- - -", "==== ", "--\t", "= =")
+	ruleTexts       = pick("***", "---", "___", "* * *", "- - -", "_____", "-- -", "**", "--", "*-*", "***a", "---\t")
+	fenceMarkers    = pick("```", "~~~", "````", "~~~~", "``", "~~")
+	fenceInfos      = pick("", "js", " js ", "c++ {x}", "`", "a`b", "js\tx", "a b c")
+	fenceBodies     = hegel.Text().Alphabet("ab *_`~\n  <&").MaxSize(12)
+	fenceCloseTails = pick("", " ", "  x", "`")
+	fenceNoNewlines = chance(20)
+	fenceUnclosed   = chance(15)
+	codeLeads       = pick("    ", "\t", "     ", " \t", "  \t  ")
+	codeBodies      = hegel.Text().Alphabet("ab *_`~ <&#-").MaxSize(10)
+	codeTails       = maybe(40, cat(lit("\n\t"), hegel.Text().Alphabet("ab").MaxSize(4)))
+	quotePrefixes   = many(pick(">", "> ", ">  ", ">", " >", "  > ", ">\t"), 1, 6)
+	bullets         = pick("-", "*", "+")
+	delims          = pick(".", ")")
+	starts          = hegel.Integers(0, 12)
+	looseness       = chance(30)
+	// oddBullets and oddNumbers: an item's own marker instead of the list's ("" for the list's),
+	// three times in twenty for bullets and one time in five for numbers.
+	oddBullets       = maybe(15, bullets)
+	oddNumbers       = maybe(20, hegel.Map(hegel.Integers(0, 999999999), strconv.Itoa))
+	gaps             = pick(" ", " ", "  ", "   ", "    ", "     ", "\t", "")
+	contTapes        = many(weighted(choice[string]{80, lit(padMark)}, choice[string]{20, indents}), 1, 4)
+	definitionGaps   = pick(" ", "", "\n", "  ", "\n  ")
+	definitionTitles = maybe(50, cat(pick(" ", "\n", "  "), titles))
+	definitionTails  = pick("", " ", " x", "\n'")
+	htmlBlockTexts   = hegel.Map(hegel.SampledFrom(htmlBlocks), func(s string) block { return htmlBlock(s) })
+	cellPads         = pick(" ", "  ")
+	rowLeads         = pick("|", "", " |")
+	rowTrails        = pick("|", "", "| ")
+	sepTexts         = pick(" --- ", ":--", "--:", ":-:", "-", " : ")
+	outerPipes       = pick("|", "")
+
+	// docStyles: LF line endings four times in five, CRLF three times in twenty and a lone CR
+	// one time in twenty (bug 2's shape); a trailer; a BOM one time in twenty (bug 1) and NUL
+	// bytes three times in a hundred (bug 7). Under HEGEL_NO_KNOWN=1 the three shapes are not
+	// drawn.
+	lineEnds = shaped[hegel.Generator[string]](
+		weighted(choice[string]{80, lit("\n")}, choice[string]{15, lit("\r\n")}, choice[string]{5, lit("\r")}),
+		weighted(choice[string]{85, lit("\n")}, choice[string]{15, lit("\r\n")}),
+	)
+	trailers  = pick("\n", "", "\n\n", "\n   ", " ")
+	boms      = shaped(chance(5), hegel.Just(false))
+	nuls      = shaped(chance(3), hegel.Just(false))
+	docStyles = hegel.Composite(func(tc hegel.TestCase) docStyle {
+		return docStyle{lineEnd: hegel.Draw(tc, lineEnds), trailer: hegel.Draw(tc, trailers), bom: hegel.Draw(tc, boms), nul: hegel.Draw(tc, nuls)}
+	})
+)
+
+// --------------------------------------------------------------------------- the grammar
+
+// docConfig selects what the prose holds: bare URLs and e-mail addresses (GFM autolink
+// literals), and Unicode spaces among the whitespace.
+type docConfig struct {
+	bareUrls  bool
+	oddSpaces bool
+}
+
+const (
+	maxInlineDepth = 4 // atoms at this depth are words
+	maxBlockDepth  = 3 // blocks at this depth are paragraphs
+)
+
+// grammar holds one configuration's generators, memoised per depth: atomAt(d) is an inline
+// atom whose nested content comes from atomAt(d+1); blockAt(d) is a block whose nested blocks
+// come from blockAt(d+1) and whose text from atomAt(d).
+type grammar struct {
+	cfg    docConfig
+	atoms  map[int]hegel.Generator[inline]
+	blocks map[int]hegel.Generator[block]
+}
+
+var (
+	docsMu   sync.Mutex
+	docsMemo = map[docConfig]hegel.Generator[string]{}
+)
+
+// documents is the Markdown source generator of a configuration, built once.
+func documents(cfg docConfig) hegel.Generator[string] {
+	docsMu.Lock()
+	defer docsMu.Unlock()
+	if g, ok := docsMemo[cfg]; ok {
+		return g
+	}
+	g := (&grammar{cfg: cfg, atoms: map[int]hegel.Generator[inline]{}, blocks: map[int]hegel.Generator[block]{}}).documents()
+	docsMemo[cfg] = g
+	return g
+}
+
+// atomAt is one inline atom at the depth: a word first, then whitespace, emphasis, a code
+// span, a link or image, an autolink, an entity, an escape, raw HTML, an autolink literal (a
+// word when the configuration has none), a typographer trigger, junk.
+func (g *grammar) atomAt(d int) hegel.Generator[inline] {
+	if a, ok := g.atoms[d]; ok {
+		return a
+	}
+	var a hegel.Generator[inline]
+	if d >= maxInlineDepth {
+		a = asInline(wordTexts)
+	} else {
+		spaces := spaceTexts
+		if g.cfg.oddSpaces {
+			spaces = oddSpaceTexts
+		}
+		bare := wordTexts
+		if g.cfg.bareUrls {
+			bare = bareTexts
+		}
+		a = weighted(
+			choice[inline]{30, asInline(wordTexts)},
+			choice[inline]{4, asInline(spaces)},
+			choice[inline]{10, g.emphasisAt(d)},
+			choice[inline]{6, codeSpans},
+			choice[inline]{10, g.linksAt(d)},
+			choice[inline]{6, asInline(autolinkTexts)},
+			choice[inline]{6, asInline(entityTexts)},
+			choice[inline]{8, asInline(escapeTexts)},
+			choice[inline]{6, asInline(rawTexts)},
+			choice[inline]{4, asInline(bare)},
+			choice[inline]{4, asInline(typoTexts)},
+			choice[inline]{6, asInline(junkTexts)},
+		)
+	}
+	g.atoms[d] = a
+	return a
+}
+
+// emphasisAt: an opener, up to three atoms of the next depth, and the opener's closer.
+func (g *grammar) emphasisAt(d int) hegel.Generator[inline] {
+	inner := counted(g.atomAt(d+1), 0, 3)
+	byMarker := map[string]hegel.Generator[inline]{}
+	for _, m := range emphasisMarkers {
+		closers := emphasisClosers[m]
+		byMarker[m] = hegel.Composite(func(tc hegel.TestCase) inline {
+			return emphasis{marker: m, inner: hegel.Draw(tc, inner), closer: hegel.Draw(tc, closers)}
+		})
+	}
+	return hegel.FlatMap(hegel.SampledFrom(emphasisMarkers), func(m string) hegel.Generator[inline] { return byMarker[m] })
+}
+
+// linksAt: a link or image of one of the six forms, its text up to three atoms of the next
+// depth.
+func (g *grammar) linksAt(d int) hegel.Generator[inline] {
+	texts := counted(g.atomAt(d+1), 0, 3)
+	inlineLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "inline", text: hegel.Draw(tc, texts), dest: hegel.Draw(tc, urls), title: hegel.Draw(tc, optionalTitles)}
+	})
+	spacedLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "spaced", text: hegel.Draw(tc, texts), dest: hegel.Draw(tc, urls), ws: hegel.Draw(tc, linkWs), title: hegel.Draw(tc, titles), after: hegel.Draw(tc, linkAfter)}
+	})
+	fullLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "full", text: hegel.Draw(tc, texts), ref: hegel.Draw(tc, refTexts)}
+	})
+	shortcutLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "shortcut", ref: hegel.Draw(tc, refTexts)}
+	})
+	collapsedLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "collapsed", ref: hegel.Draw(tc, refTexts)}
+	})
+	oddLinks := hegel.Composite(func(tc hegel.TestCase) inline {
+		return link{bang: hegel.Draw(tc, bangs), form: "odd", text: hegel.Draw(tc, texts), dest: hegel.Draw(tc, oddDests)}
+	})
+	return weighted(
+		choice[inline]{20, inlineLinks}, choice[inline]{20, spacedLinks}, choice[inline]{20, fullLinks},
+		choice[inline]{10, shortcutLinks}, choice[inline]{10, collapsedLinks}, choice[inline]{20, oddLinks},
+	)
+}
+
+// linesAt: an indented line of one to six atoms.
+func (g *grammar) linesAt(d int) hegel.Generator[line] {
+	inlines := many(g.atomAt(d), 1, 6)
+	return hegel.Composite(func(tc hegel.TestCase) line {
+		return line{indent: hegel.Draw(tc, indents), inlines: hegel.Draw(tc, inlines)}
+	})
+}
+
+// seqAt: lo to hi blocks of the depth and their separator.
+func (g *grammar) seqAt(d, lo, hi int) hegel.Generator[blockSeq] {
+	blocks := many(g.blockAt(d), lo, hi)
+	return hegel.Composite(func(tc hegel.TestCase) blockSeq {
+		return blockSeq{blocks: hegel.Draw(tc, blocks), sep: hegel.Draw(tc, blockSeps)}
+	})
+}
+
+// blockAt is one block at the depth: a paragraph first, then an ATX heading, a setext heading,
+// a thematic break, a fence, indented code, a block quote, a list, an HTML block, a reference
+// definition, a table; the containers hold blocks of the next depth.
+func (g *grammar) blockAt(d int) hegel.Generator[block] {
+	if b, ok := g.blocks[d]; ok {
+		return b
+	}
+	lines := g.linesAt(d)
+	paragraphs := hegel.Map(many(lines, 1, 3), func(ls []line) block { return paragraph{ls} })
+	var b hegel.Generator[block]
+	if d >= maxBlockDepth {
+		b = paragraphs
+	} else {
+		headingInlines := counted(g.atomAt(d), 0, 4)
+		atxHeadings := hegel.Composite(func(tc hegel.TestCase) block {
+			return atxHeading{indent: hegel.Draw(tc, indents), level: hegel.Draw(tc, atxLevels), gap: hegel.Draw(tc, atxGaps), inlines: hegel.Draw(tc, headingInlines), tail: hegel.Draw(tc, atxTails)}
+		})
+		setextLines := many(lines, 1, 2)
+		setextHeadings := hegel.Composite(func(tc hegel.TestCase) block {
+			return setextHeading{lines: hegel.Draw(tc, setextLines), indent: hegel.Draw(tc, indents), underline: hegel.Draw(tc, underlines)}
+		})
+		thematicBreaks := hegel.Map(pairs(indents, ruleTexts), func(p pair[string, string]) block { return thematicBreak{p.a, p.b} })
+		fences := hegel.Composite(func(tc hegel.TestCase) block {
+			return fence{
+				indent: hegel.Draw(tc, indents), marker: hegel.Draw(tc, fenceMarkers), info: hegel.Draw(tc, fenceInfos), body: hegel.Draw(tc, fenceBodies),
+				noNewline: hegel.Draw(tc, fenceNoNewlines), unclosed: hegel.Draw(tc, fenceUnclosed), closeTail: hegel.Draw(tc, fenceCloseTails),
+			}
+		})
+		indentedCodes := hegel.Composite(func(tc hegel.TestCase) block {
+			return indentedCode{lead: hegel.Draw(tc, codeLeads), body: hegel.Draw(tc, codeBodies), tail: hegel.Draw(tc, codeTails)}
+		})
+		quoted := g.seqAt(d+1, 1, 3)
+		blockQuotes := hegel.Composite(func(tc hegel.TestCase) block {
+			return blockQuote{prefixes: hegel.Draw(tc, quotePrefixes), inner: hegel.Draw(tc, quoted)}
+		})
+		definitions := hegel.Composite(func(tc hegel.TestCase) block {
+			return definition{indent: hegel.Draw(tc, indents), ref: hegel.Draw(tc, refTexts), gap: hegel.Draw(tc, definitionGaps), dest: hegel.Draw(tc, urls), title: hegel.Draw(tc, definitionTitles), tail: hegel.Draw(tc, definitionTails)}
+		})
+		b = weighted(
+			choice[block]{25, paragraphs},
+			choice[block]{8, atxHeadings},
+			choice[block]{5, setextHeadings},
+			choice[block]{5, thematicBreaks},
+			choice[block]{9, fences},
+			choice[block]{5, indentedCodes},
+			choice[block]{9, blockQuotes},
+			choice[block]{14, g.listsAt(d)},
+			choice[block]{7, htmlBlockTexts},
+			choice[block]{9, definitions},
+			choice[block]{4, g.tablesAt(d)},
+		)
+	}
+	g.blocks[d] = b
+	return b
+}
+
+// listsAt: a bullet list three times in five, an ordered one otherwise, of one to four items
+// whose bodies are one or two blocks of the next depth.
+func (g *grammar) listsAt(d int) hegel.Generator[block] {
+	bodies := g.seqAt(d+1, 1, 2)
+	itemsWith := func(odd hegel.Generator[string]) hegel.Generator[[]listItem] {
+		return many(hegel.Composite(func(tc hegel.TestCase) listItem {
+			return listItem{indent: hegel.Draw(tc, indents), odd: hegel.Draw(tc, odd), gap: hegel.Draw(tc, gaps), body: hegel.Draw(tc, bodies), cont: hegel.Draw(tc, contTapes)}
+		}), 1, 4)
+	}
+	bulletItems, orderedItems := itemsWith(oddBullets), itemsWith(oddNumbers)
+	bulletLists := hegel.Composite(func(tc hegel.TestCase) block {
+		return list{bullet: hegel.Draw(tc, bullets), loose: hegel.Draw(tc, looseness), items: hegel.Draw(tc, bulletItems)}
+	})
+	orderedLists := hegel.Composite(func(tc hegel.TestCase) block {
+		return list{ordered: true, start: hegel.Draw(tc, starts), delim: hegel.Draw(tc, delims), loose: hegel.Draw(tc, looseness), items: hegel.Draw(tc, orderedItems)}
+	})
+	return weighted(choice[block]{60, bulletLists}, choice[block]{40, orderedLists})
+}
+
+// tablesAt: a table of one to three columns, with up to three body rows, its cells up to two
+// atoms of the next depth.
+func (g *grammar) tablesAt(d int) hegel.Generator[block] {
+	cellInlines := counted(g.atomAt(d+1), 0, 2)
+	cells := hegel.Composite(func(tc hegel.TestCase) tableCell {
+		return tableCell{pad: hegel.Draw(tc, cellPads), inlines: hegel.Draw(tc, cellInlines)}
+	})
+	byCols := make([]hegel.Generator[block], 4)
+	for cols := 1; cols <= 3; cols++ {
+		rowCells := many(cells, cols, cols)
+		rows := hegel.Composite(func(tc hegel.TestCase) tableRow {
+			return tableRow{lead: hegel.Draw(tc, rowLeads), cells: hegel.Draw(tc, rowCells), trail: hegel.Draw(tc, rowTrails)}
+		})
+		seps := many(sepTexts, cols, cols)
+		bodyRows := counted(rows, 0, 3)
+		byCols[cols] = hegel.Composite(func(tc hegel.TestCase) block {
+			return table{header: hegel.Draw(tc, rows), seps: hegel.Draw(tc, seps), sepLead: hegel.Draw(tc, outerPipes), sepTrail: hegel.Draw(tc, outerPipes), rows: hegel.Draw(tc, bodyRows)}
+		})
+	}
+	return hegel.FlatMap(hegel.Integers(1, 3), func(cols int) hegel.Generator[block] { return byCols[cols] })
+}
+
+// documents: one to four top-level blocks and a document style, rendered.
+func (g *grammar) documents() hegel.Generator[string] {
+	body := g.seqAt(0, 1, 4)
+	return hegel.Map(pairs(body, docStyles), func(p pair[blockSeq, docStyle]) string {
+		return document{body: p.a, style: p.b}.md()
+	})
+}
diff --git a/hegel_oracle.mjs b/hegel_oracle.mjs
new file mode 100644
index 0000000..f9fe084
--- /dev/null
+++ b/hegel_oracle.mjs
@@ -0,0 +1,43 @@
+// Oracle child for the Hegel tests: commonmark.js (the reference implementation) and micromark
+// (CommonMark, and GFM tables/strikethrough/task lists, and GFM autolink literals), one JSON
+// request per line on stdin, one JSON reply per line on stdout. Raw HTML and dangerous URL
+// schemes are let through: goldmark renders with html.WithUnsafe() in the differentials.
+import * as cm from "./.hegel/node_modules/commonmark/dist/commonmark.js";
+import { micromark } from "./.hegel/node_modules/micromark/index.js";
+import { gfmTable, gfmTableHtml } from "./.hegel/node_modules/micromark-extension-gfm-table/index.js";
+import { gfmStrikethrough, gfmStrikethroughHtml } from "./.hegel/node_modules/micromark-extension-gfm-strikethrough/index.js";
+import { gfmTaskListItem, gfmTaskListItemHtml } from "./.hegel/node_modules/micromark-extension-gfm-task-list-item/index.js";
+import { gfmAutolinkLiteral, gfmAutolinkLiteralHtml } from "./.hegel/node_modules/micromark-extension-gfm-autolink-literal/index.js";
+import { createInterface } from "node:readline";
+
+const parser = new cm.Parser();
+const renderer = new cm.HtmlRenderer();
+const dangerous = { allowDangerousHtml: true, allowDangerousProtocol: true };
+const render = {
+  cm: (src) => renderer.render(parser.parse(src)),
+  mm: (src) => micromark(src, dangerous),
+  gfm: (src) => micromark(src, {
+    ...dangerous,
+    extensions: [gfmTable(), gfmStrikethrough({ singleTilde: true }), gfmTaskListItem()],
+    htmlExtensions: [gfmTableHtml(), gfmStrikethroughHtml(), gfmTaskListItemHtml()],
+  }),
+  linkify: (src) => micromark(src, {
+    ...dangerous,
+    extensions: [gfmAutolinkLiteral()],
+    htmlExtensions: [gfmAutolinkLiteralHtml()],
+  }),
+};
+
+const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on("line", (line) => {
+  let out;
+  try {
+    const req = JSON.parse(line);
+    const fn = render[req.m];
+    if (!fn) throw new Error("unknown mode " + req.m);
+    out = { html: fn(req.src) };
+  } catch (e) {
+    out = { err: String(e && e.stack || e) };
+  }
+  process.stdout.write(JSON.stringify(out) + "\n");
+});
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..1d6c034
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,204 @@
+package goldmark_test
+
+// Pins: one plain test per bug in bugs.toml, asserting the behaviour the CommonMark 0.31.2 or
+// GFM spec calls for (as commonmark.js 0.31.2 and micromark 4 render it). Each fails while its
+// bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"io"
+	"testing"
+
+	"github.com/yuin/goldmark/v2/parser"
+	"github.com/yuin/goldmark/v2/renderer"
+)
+
+func pin(t *testing.T, p parser.Parser, r renderer.Renderer[io.Writer], src, want string) {
+	t.Helper()
+	if got := render(p, r, src); got != want {
+		t.Fatalf("src  %q\ngot  %q\nwant %q", src, got, want)
+	}
+}
+
+// goldmark/1: a leading byte order mark is text.
+func TestHegelPinLeadingBomIsSkipped(t *testing.T) {
+	pin(t, cmP, cmR, "\uFEFF# a", "<h1>a</h1>\n")
+}
+
+// goldmark/2: a lone carriage return is not a line ending.
+func TestHegelPinLoneCarriageReturnEndsALine(t *testing.T) {
+	pin(t, cmP, cmR, "# a\rb", "<h1>a</h1>\n<p>b</p>\n")
+}
+
+// goldmark/3: an empty list item under CRLF line endings is lost.
+func TestHegelPinEmptyItemUnderCrlf(t *testing.T) {
+	pin(t, cmP, cmR, "- a\r\n-\r\n- b\r\n", "<ul>\n<li>a</li>\n<li></li>\n<li>b</li>\n</ul>\n")
+}
+
+// goldmark/4: image alt text drops the text of code spans.
+func TestHegelPinAltKeepsCodeSpanText(t *testing.T) {
+	pin(t, cmP, cmR, "![a `b`](/u)", "<p><img src=\"/u\" alt=\"a b\" /></p>\n")
+}
+
+// goldmark/5: image alt text drops the text of autolinks.
+func TestHegelPinAltKeepsAutolinkText(t *testing.T) {
+	pin(t, cmP, cmR, "![a<http://x.y>](/u)", "<p><img src=\"/u\" alt=\"ahttp://x.y\" /></p>\n")
+}
+
+// goldmark/6: a hard line break inside alt text is written as <br />.
+func TestHegelPinAltHardBreakIsANewline(t *testing.T) {
+	pin(t, cmP, cmR, "![a  \nb](/u)", "<p><img src=\"/u\" alt=\"a\nb\" /></p>\n")
+}
+
+// goldmark/7: U+0000 is replaced on output instead of on input.
+func TestHegelPinNulIsReplacedOnInput(t *testing.T) {
+	pin(t, cmP, cmR, "[a](/\x00)", "<p><a href=\"/%EF%BF%BD\">a</a></p>\n")
+}
+
+// goldmark/8: a table whose delimiter row has a different cell count than the header is accepted.
+func TestHegelPinTableNeedsMatchingCellCounts(t *testing.T) {
+	pin(t, gfmP, gfmR, "| a |\n|-|-|\n| b |", "<p>| a |\n|-|-|\n| b |</p>\n")
+}
+
+// goldmark/9: after "> " a tab prevents block starts.
+func TestHegelPinTabAfterQuoteMarkerStartsBlocks(t *testing.T) {
+	pin(t, cmP, cmR, "> \t- a", "<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n")
+}
+
+// goldmark/10: a whitespace-only line inside an indented fenced code block keeps a space.
+func TestHegelPinBlankLineInIndentedFenceIsEmpty(t *testing.T) {
+	pin(t, cmP, cmR, "  ~~~\n a\n \n  b\n  ~~~", "<pre><code>a\n\nb\n</code></pre>\n")
+}
+
+// goldmark/11: "<div" followed by a line ending is not an HTML block start.
+func TestHegelPinOpenTagAtEndOfLineStartsHtmlBlock(t *testing.T) {
+	pin(t, cmP, cmR, "<div\n\nx", "<div\n<p>x</p>\n")
+}
+
+// goldmark/12: a delimiter run right after a bare block quote marker can close.
+func TestHegelPinDelimiterAfterQuoteMarkerCannotClose(t *testing.T) {
+	pin(t, cmP, cmR, "> **a\n>** b", "<blockquote>\n<p>**a\n** b</p>\n</blockquote>\n")
+}
+
+// goldmark/13: the info string's language is split at spaces only, not tabs.
+func TestHegelPinInfoStringLanguageEndsAtTab(t *testing.T) {
+	pin(t, cmP, cmR, "```js\tx\na\n```", "<pre><code class=\"language-js\">a\n</code></pre>\n")
+}
+
+// goldmark/14: a CRLF inside a code span leaves the carriage return.
+func TestHegelPinCodeSpanCrlfIsASpace(t *testing.T) {
+	pin(t, cmP, cmR, "a `b\r\nc` d", "<p>a <code>b c</code> d</p>\n")
+}
+
+// goldmark/15: a link reference definition opening a list item makes the list loose.
+func TestHegelPinDefinitionInItemKeepsListTight(t *testing.T) {
+	pin(t, cmP, cmR, "- [a]: /u\n  b\n- c", "<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n")
+}
+
+// goldmark/16: a tab after a list item's content indent hides the next line's block start.
+func TestHegelPinTabAfterContentIndentNestsList(t *testing.T) {
+	pin(t, cmP, cmR, "- a\n  \t- b", "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n")
+}
+
+// goldmark/17: a lower-case declaration is not an HTML block start.
+func TestHegelPinLowercaseDoctypeIsHtmlBlock(t *testing.T) {
+	pin(t, cmP, cmR, "<!doctype html>\n", "<!doctype html>\n")
+}
+
+// goldmark/18: an autolink literal ends at "*".
+func TestHegelPinAutolinkLiteralKeepsStar(t *testing.T) {
+	pin(t, linkP, cmR, "www.x.y/a*b", "<p><a href=\"http://www.x.y/a*b\">www.x.y/a*b</a></p>\n")
+}
+
+// goldmark/19: an email autolink literal cannot start with "_".
+func TestHegelPinEmailAutolinkStartsWithUnderscore(t *testing.T) {
+	pin(t, linkP, cmR, "_foo@bar.baz", "<p><a href=\"mailto:_foo@bar.baz\">_foo@bar.baz</a></p>\n")
+}
+
+// goldmark/20: "www.x" is not linked.
+func TestHegelPinWwwAutolinkNeedsOnePeriod(t *testing.T) {
+	pin(t, linkP, cmR, "www.x", "<p><a href=\"http://www.x\">www.x</a></p>\n")
+}
+
+// goldmark/21: the last, marker-only line of an unclosed fence inside a container is dropped.
+func TestHegelPinUnclosedFenceKeepsLastLineInQuote(t *testing.T) {
+	pin(t, cmP, cmR, "> ```\n>\n> ", "<blockquote>\n<pre><code>\n\n</code></pre>\n</blockquote>\n")
+}
+
+// goldmark/22: "(" or "~" right after the domain ends an autolink literal.
+func TestHegelPinAutolinkLiteralKeepsParenAfterDomain(t *testing.T) {
+	pin(t, linkP, cmR, "http://a.b(c", "<p><a href=\"http://a.b(c\">http://a.b(c</a></p>\n")
+}
+
+// goldmark/23: a table leaves its parent's ChildCount one too high.
+func TestHegelPinTableParentChildCount(t *testing.T) {
+	doc := gfmP.Parse([]byte("| a |\n| --- |\n"))
+	n := 0
+	for range doc.Children() {
+		n++
+	}
+	if doc.ChildCount() != n {
+		t.Fatalf("Document.ChildCount() = %d, %d children iterated", doc.ChildCount(), n)
+	}
+}
+
+// goldmark/24: "*" and "~" are accepted inside an email autolink's local part.
+func TestHegelPinEmailAutolinkExcludesStar(t *testing.T) {
+	pin(t, linkP, cmR, "*bar*a@c.d", "<p><em>bar</em><a href=\"mailto:a@c.d\">a@c.d</a></p>\n")
+}
+
+// goldmark/25: a link destination with an unbalanced "(" is accepted when a title follows.
+func TestHegelPinUnbalancedParenInDestinationIsNotALink(t *testing.T) {
+	pin(t, cmP, cmR, "[a](/u( 't')", "<p>[a](/u( 't')</p>\n")
+}
+
+// goldmark/26: an invalid title line of a reference definition still supplies the title.
+func TestHegelPinInvalidTitleLineGivesNoTitle(t *testing.T) {
+	pin(t, cmP, cmR, "[SS]: /u\n'a' x\n\n[SS]", "<p>'a' x</p>\n<p><a href=\"/u\">SS</a></p>\n")
+}
+
+// goldmark/27: "_" in a www. autolink's domain ends the link instead of invalidating it.
+func TestHegelPinUnderscoreInDomainInvalidatesWwwAutolink(t *testing.T) {
+	pin(t, linkP, cmR, "www.example.com_http://ex.am/ple?x=1",
+		"<p>www.example.com_<a href=\"http://ex.am/ple?x=1\">http://ex.am/ple?x=1</a></p>\n")
+}
+
+// goldmark/28: tab widths after a list marker inside a container are computed from the wrong column.
+func TestHegelPinTabWidthAfterMarkerInsideQuote(t *testing.T) {
+	pin(t, cmP, cmR, "> -\t\tb", "<blockquote>\n<ul>\n<li>\n<pre><code>b\n</code></pre>\n</li>\n</ul>\n</blockquote>\n")
+}
+
+// goldmark/29: a "---" line indented four or more columns makes a table, pipes or not.
+func TestHegelPinIndentedDelimiterRowIsNotATable(t *testing.T) {
+	pin(t, gfmP, gfmR, "a\n\t---\nb\n", "<p>a\n---\nb</p>\n")
+}
+
+// goldmark/30 (to be recorded): a blank line after an empty nested list item closes the enclosing
+// list item too.
+func TestHegelPinBlankAfterEmptyNestedItemKeepsOuterItemOpen(t *testing.T) {
+	pin(t, cmP, cmR, "- a\n\n  -\n\n  b\n", "<ul>\n<li>\n<p>a</p>\n<ul>\n<li></li>\n</ul>\n<p>b</p>\n</li>\n</ul>\n")
+}
+
+// goldmark/31 (to be recorded): a one-tilde and a two-tilde run are paired as strikethrough.
+func TestHegelPinStrikethroughNeedsMatchingRunLengths(t *testing.T) {
+	pin(t, gfmP, gfmR, "~~a~\n", "<p>~~a~</p>\n")
+}
+
+// goldmark/32 (to be recorded): a table row ending in "\|" loses the pipe, read as the row's
+// closing pipe.
+func TestHegelPinEscapedPipeAtRowEndIsACell(t *testing.T) {
+	pin(t, gfmP, gfmR, "| a |\n| --- |\n| \\|\n",
+		"<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>|</td>\n</tr>\n</tbody>\n</table>\n")
+}
+
+// goldmark/33 (to be recorded): a "***" closer half consumed by a "**" opener is filed under the
+// openers-bottom slot of run length one, so it no longer reaches an earlier "**" opener that the
+// rule of 3 (original lengths 2 and 3) allows.
+func TestHegelPinRuleOfThreeUsesOriginalRunLengths(t *testing.T) {
+	pin(t, cmP, cmR, "**a*b*c **d***e\n", "<p>*<em>a<em>b</em>c <strong>d</strong></em>e</p>\n")
+}
+
+// goldmark/34 (to be recorded): a list of another kind at an empty item's content indent closes
+// the list instead of nesting inside the item (same-kind markers nest).
+func TestHegelPinEmptyItemNestsListOfOtherKind(t *testing.T) {
+	pin(t, cmP, cmR, "-\n  + b\n", "<ul>\n<li>\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n")
+}
