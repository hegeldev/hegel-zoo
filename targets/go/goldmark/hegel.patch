+// TestHegelGfmAgreesWithMicromark: tables, strikethrough (single and double tildes) and task
+// lists against micromark's GFM extensions, on documents whose CommonMark core the two
+// reference implementations agree on.
+func TestHegelGfmAgreesWithMicromark(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, plainDocs)
+		col.count("cases")
+		skipKnown(ht, col, src, commonMarkShapes)
+		// micromark keeps CR line endings in its output; the core comparison is on LF text.
+		src = strings.ReplaceAll(strings.ReplaceAll(src, "\r\n", "\n"), "\r", "\n")
+		skipKnown(ht, col, src, gfmShapes)
+		core := render(cmP, cmR, src)
+		cmjs := oracle(ht, "cm", src)
+		if core != cmjs && classify(core, cmjs) == "" {
+			// the CommonMark differential's business
+			col.count("core-differs")
+			ht.Assume(false)
+		}
+		got := gfmShape(render(gfmP, gfmR, src))
+		want := gfmShape(oracle(ht, "gfm", src))
+		if got == want {
+			col.count("ok")
+			return
+		}
+		if c := classify(got, want); c != "" {
+			col.count(c)
+			return
+		}
+		if c := classifyMicromark(got, want); c != "" {
+			col.count(c)
+			return
+		}
+		if col.accepted(src, commonMarkShapes, gfmShapes) {
+			return
+		}
+		// micromark misreading the CommonMark core of this very document is its own problem.
+		if mm := gfmShape(oracle(ht, "mm", src)); mm != gfmShape(cmjs) && classify(mm, gfmShape(cmjs)) == "" && classifyMicromark(mm, gfmShape(cmjs)) == "" {
+			col.count("micromark-core-quirk")
+			return
+		}
+		col.mismatch(ht, bugsOf(src, commonMarkShapes, gfmShapes), "src %s\n goldmark %s\n micromark+gfm %s", show(src), show(got), show(want))
+	})
+}
+
+// reBlankCodeLines: whitespace-only lines between two line endings.
+var reBlankCodeLines = regexp.MustCompile(`\n([ \t]+\n)+`)
+
+// insidePre applies fn to the parts of h that are inside <pre>...</pre>.
+func insidePre(h string, fn func(string) string) string {
+	var b strings.Builder
+	last := 0
+	for _, m := range rePre.FindAllStringIndex(h, -1) {
+		b.WriteString(h[last:m[0]])
+		b.WriteString(fn(h[m[0]:m[1]]))
+		last = m[1]
+	}
+	b.WriteString(h[last:])
+	return b.String()
+}
+
+// v1BlankLineShape: v1 kept a space from a whitespace-only line inside a code block where v2
+// (and the spec) give an empty line; compared with whitespace-only lines inside <pre> emptied.
+func v1BlankLineShape(h string) string {
+	return insidePre(h, func(s string) string {
+		return reBlankCodeLines.ReplaceAllStringFunc(s, func(m string) string { return strings.Repeat("\n", strings.Count(m, "\n")) })
+	})
+}
