+package goldmark_test
+
+// Narrow properties, one per recorded bug that hegel_test.go has none for (the other ten are
+// there, beside their regions): each draws the bug's shape region with random contents and is
+// judged by the same oracle and judge functions as the wide properties, so that every recorded
+// bug is found by a property of its own and the wide properties' failures can be read against
+// them. Under HEGEL_NO_KNOWN=1 each draws the neighbouring region past the bug's shape (the
+// same construct without the triggering detail) and passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// shortWords: the plain contents of the regions.
+var shortWords = hegel.Text().Alphabet("abxyz").MinSize(1).MaxSize(4)
+
+// perPiece is one of the pieces, each with its own generator built once (a FlatMap whose
+// alternatives are memoised).
+func perPiece(pieces []string, build func(string) hegel.Generator[string]) hegel.Generator[string] {
+	built := map[string]hegel.Generator[string]{}
+	for _, p := range pieces {
+		built[p] = build(p)
+	}
+	return hegel.FlatMap(hegel.SampledFrom(pieces), func(p string) hegel.Generator[string] { return built[p] })
+}
+
+// --------------------------------------------------------------------------- CommonMark
+
+// leadingBom: goldmark/1's region: a document starting with a byte order mark, then a block
+// start that the mark hides when it is read as text; past: the same block without the mark.
+var leadingBom = cat(
+	shaped(lit("\xEF\xBB\xBF"), lit("")),
+	weighted(
+		choice[string]{30, cat(pick("# ", "- ", "> ", "1. ", "    ", "* "), shortWords)},
+		choice[string]{10, pick("***", "---", "[a]: /u\n\n[a]", "```\na\n```", "<div>\na")},
+	),
+	pick("\n", ""),
+)
+
+func TestHegelLeadingBomAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, leadingBom)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// loneCarriageReturn: goldmark/2's region: two block starts separated by a lone carriage
+// return (the third line ending the spec allows), the document ending with one or not; past:
+// separated by LF or CRLF.
+var (
+	crBlocks           = cat(pick("", "# ", "- ", "> ", "1. ", "* "), shortWords)
+	loneCarriageReturn = cat(
+		crBlocks,
+		shaped(lit("\r"), pick("\n", "\r\n")),
+		weighted(choice[string]{30, crBlocks}, choice[string]{10, pick("***", "---", "    a")}),
+		shaped(pick("", "\r", "\n"), pick("", "\n", "\r\n")),
+	)
+)
+
+func TestHegelLoneCarriageReturnAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, loneCarriageReturn)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// emptyItemCrlf: goldmark/3's region: an empty list item ending in CRLF, followed by text,
+// an indented continuation or another item; past: the same item ending in LF.
+var emptyItemCrlf = cat(
+	pick("-", "*", "+", "1.", "1)", "- a\n-", "1. a\n2."),
+	shaped(lit("\r\n"), lit("\n")),
+	pick("", "a", "  a", "- b", "\tb", "2. b"),
+	pick("", "\n"),
+)
+
+func TestHegelEmptyItemUnderCrlfAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, emptyItemCrlf)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// Image alt text (goldmark/4, 5, 6): an image whose alt holds a code span, an autolink or a
+// hard break, with text around it; past: the same content in a link's text, or an image whose
+// alt holds emphasis, the autolink's text, or a soft break instead.
+var (
+	altBefore        = maybe(50, cat(shortWords, lit(" ")))
+	altAfter         = maybe(50, cat(lit(" "), shortWords))
+	altCodeSpan      = cat(altBefore, lit("`"), hegel.Text().Alphabet("ab *").MinSize(1).MaxSize(4), lit("`"), altAfter)
+	altEmphasis      = cat(altBefore, lit("*"), shortWords, lit("*"), altAfter)
+	altAutolink      = cat(altBefore, pick("<http://x.y>", "<a@b.c>", "<https://a.b/c?d=1&e=2>", "<mailto:a@b.c>"), altAfter)
+	altAutolinkText  = cat(altBefore, pick("http://x.y", "a@b.c", "https://a.b/c?d=1&e=2", "mailto:a@b.c"), altAfter)
+	altHardBreak     = cat(shortWords, pick("\\\n", "  \n", "   \n"), shortWords)
+	altSoftBreak     = cat(shortWords, pick("\n", " \n"), shortWords)
+	linkEnds         = pick("](/u)", "](/u \"t\")", "](<a b>)", "](/u 't')")
+	imageAltCodeSpan = cat(shaped[hegel.Generator[string]](
+		cat(lit("!["), altCodeSpan),
+		weighted(choice[string]{50, cat(lit("["), altCodeSpan)}, choice[string]{50, cat(lit("!["), altEmphasis)}),
+	), linkEnds, pick("\n", ""))
+	imageAltAutolink = cat(shaped[hegel.Generator[string]](
+		cat(lit("!["), altAutolink),
+		weighted(choice[string]{50, cat(lit("["), altAutolink)}, choice[string]{50, cat(lit("!["), altAutolinkText)}),
+	), linkEnds, pick("\n", ""))
+	imageAltHardBreak = cat(shaped[hegel.Generator[string]](
+		cat(lit("!["), altHardBreak),
+		weighted(choice[string]{50, cat(lit("["), altHardBreak)}, choice[string]{50, cat(lit("!["), altSoftBreak)}),
+	), linkEnds, pick("\n", ""))
+)
+
+func TestHegelImageAltWithCodeSpanAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, imageAltCodeSpan)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+func TestHegelImageAltWithAutolinkAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, imageAltAutolink)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+func TestHegelImageAltWithHardBreakAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, imageAltHardBreak)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// nulByte: goldmark/7's region: a NUL byte where the U+FFFD the spec substitutes on input
+// matters: in a destination (percent-encoded), inside an autolink, beside an emphasis
+// delimiter (flanking), in a code span, in a heading, in raw HTML; past: U+FFFD itself there.
+var (
+	nulFrames = hegel.SampledFrom([][2]string{
+		{"[a](/", ")"}, {"<http://", ".b>"}, {"<a@b.", ">"}, {"a", "*b*"}, {"*a*", "b"},
+		{"`", "`"}, {"[", "](/u)"}, {"# ", ""}, {"<a href=\"", "\">"}, {"[a]: /", "\n\n[a]"},
+	})
+	nulChars = shaped(lit("\x00"), lit("\xEF\xBF\xBD"))
+	nulByte  = hegel.Map(pairs(nulFrames, nulChars), func(p pair[[2]string, string]) string {
+		return p.a[0] + p.b + p.a[1] + "\n"
+	})
+)
+
+func TestHegelNulInputAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, nulByte)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// openTagAtEol: goldmark/11's region: an HTML block start tag name followed by the end of the
+// line (the fourth of the spec's four endings of a type-6 start); past: followed by ">" or a
+// space.
+var openTagAtEol = cat(
+	pick("<div", "<DIV", "<table", "<p", "<pre", "</div"),
+	shaped(lit("\n"), pick(">\n", " \n", " x>\n")),
+	pick("*a*\n", "a\n", "", "</div>\n", "\n*a*\n"),
+)
+
+func TestHegelOpenTagAtEndOfLineAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, openTagAtEol)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// delimiterAfterQuoteMarker: goldmark/12's region: a delimiter run right after a quote marker
+// (after a line ending in the paragraph's content, where a run followed by a space can close
+// nothing) under a quoted line that opened it; past: a space between the marker and the run.
+var delimiterAfterQuoteMarker = perPiece([]string{"**", "__", "*", "_"}, func(d string) hegel.Generator[string] {
+	return cat(lit("> "), lit(d), shortWords, lit("\n>"), shaped(lit(""), lit(" ")), lit(d), lit(" "), shortWords, pick("\n", ""))
+})
+
+func TestHegelDelimiterAfterQuoteMarkerAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, delimiterAfterQuoteMarker)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// infoStringTab: goldmark/13's region: a fence whose info string has a tab between two words;
+// past: a space.
+var infoStringTab = perPiece([]string{"```", "~~~"}, func(m string) hegel.Generator[string] {
+	return cat(lit(m), shortWords, shaped(lit("\t"), lit(" ")), shortWords, lit("\n"), maybe(50, cat(shortWords, lit("\n"))), lit(m), lit("\n"))
+})
+
+func TestHegelInfoStringTabAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, infoStringTab)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// codeSpanCrlf: goldmark/14's region: a code span spanning a CRLF line ending; past: an LF.
+var codeSpanCrlf = cat(
+	maybe(50, cat(shortWords, lit(" "))),
+	lit("`"), shortWords, shaped(lit("\r\n"), lit("\n")), shortWords, lit("`"),
+	pick("", "\r\n", " b\r\n"),
+)
+
+func TestHegelCodeSpanCrlfAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, codeSpanCrlf)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// definitionInItem: goldmark/15's region: a list item opened by a link reference definition,
+// followed by another item or a continuation; past: the definition before the list.
+var definitionInItem = cat(
+	shaped[hegel.Generator[string]](
+		cat(pick("- ", "* ", "1. "), lit("[a]: /u"), maybe(40, lit(" \"t\""))),
+		cat(lit("[a]: /u"), maybe(40, lit(" \"t\"")), lit("\n"), pick("- ", "* ", "1. "), shortWords),
+	),
+	lit("\n"),
+	pick("- b", "  [a]", "- [a]", "  b", "\n  [a]", "2. b"),
+	pick("\n", ""),
+)
+
+func TestHegelDefinitionInListItemAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, definitionInItem)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// lowercaseDeclaration: goldmark/17's region: "<!" and a lower-case letter opening a line (an
+// HTML block of type 4 since spec 0.31); past: an upper-case letter.
+var lowercaseDeclaration = cat(
+	shaped(pick("<!doctype", "<!x", "<!doctype html"), pick("<!DOCTYPE", "<!X", "<!DOCTYPE html")),
+	pick(">", " a>", ""),
+	pick("\n", "\n*a*\n", "\n*a*"),
+)
+
+func TestHegelLowercaseDeclarationAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, lowercaseDeclaration)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// unclosedFenceInContainer: goldmark/21's region: a fence opened inside a block quote or list
+// item and never closed, with one or two content lines, whose last line is the container's
+// prefix alone, without a final newline; past: the document ends with a line ending. (With
+// no content line micromark reads the prefix-only line as goldmark does, a commonmark.js
+// quirk to the judge.)
+var unclosedFenceInContainer = perPiece([]string{"> ", "- ", "* ", "1. "}, func(p string) hegel.Generator[string] {
+	cont := strings.Repeat(" ", len(p))
+	if p == "> " {
+		cont = "> "
+	}
+	return cat(
+		lit(p), pick("```", "~~~"), maybe(50, lit("js")), lit("\n"),
+		joined(many(cat(lit(cont), hegel.Text().Alphabet("ab `").MaxSize(3), lit("\n")), 1, 2), ""),
+		pick(strings.TrimRight(cont, " "), cont),
+		shaped(lit(""), lit("\n")),
+	)
+})
+
+func TestHegelUnclosedFenceInContainerAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, unclosedFenceInContainer)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// invalidTitleLine: goldmark/26's region: a link reference definition whose title is on the
+// next line with something after it (so the line is not a title and the definition has none);
+// past: the title alone on its line (trailing spaces allowed).
+var invalidTitleLine = cat(
+	lit("[a]: /u\n"),
+	pick("\"t\"", "'t'", "(t)"),
+	shaped(pick(" x", "x", " \"", " (y)"), pick("", " ", "  ")),
+	lit("\n\n[a]"),
+	pick("\n", ""),
+)
+
+func TestHegelInvalidTitleLineAgreesWithCommonmarkJs(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, invalidTitleLine)
+		judgeCommonMark(ht, col, src, render(cmP, cmR, src), oracle(ht, "cm", src))
+	})
+}
+
+// --------------------------------------------------------------------------- GFM tables
+
+// tableText: a table of the header cells, a delimiter row of seps cells (none: no delimiter
+// row, so a paragraph) and the body rows, every row between outer pipes.
+func tableText(header []string, seps int, rows [][]string) string {
+	row := func(cells []string) string { return "| " + strings.Join(cells, " | ") + " |\n" }
+	s := row(header)
+	if seps > 0 {
+		s += "|" + strings.Repeat(" --- |", seps) + "\n"
+	}
+	for _, r := range rows {
+		s += row(r)
+	}
+	return s
+}
+
+// tablesWith is a table of cols columns whose delimiter row has seps cells, with up to two body
+// rows.
+func tablesWith(cols int, seps hegel.Generator[int]) hegel.Generator[string] {
+	cells := many(shortWords, cols, cols)
+	rows := counted(cells, 0, 2)
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		return tableText(hegel.Draw(tc, cells), hegel.Draw(tc, seps), hegel.Draw(tc, rows))
+	})
+}
+
+// byColumns is the table generator of one to three columns, each column count built once.
+func byColumns(build func(cols int) hegel.Generator[string]) hegel.Generator[string] {
+	built := []hegel.Generator[string]{nil, build(1), build(2), build(3)}
+	return hegel.FlatMap(hegel.Integers(1, 3), func(cols int) hegel.Generator[string] { return built[cols] })
+}
+
+// tableCellCount: goldmark/8's region: a header row of one to three cells (words) and a
+// delimiter row of another count; past: of the same count (a table).
+var tableCellCount = byColumns(func(cols int) hegel.Generator[string] {
+	others := hegel.Map(hegel.Integers(1, 2), func(d int) int { return (cols+d-1)%3 + 1 })
+	return tablesWith(cols, shaped(others, hegel.Just(cols)))
+})
+
+func TestHegelTableCellCountAgreesWithMicromark(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeGfm(ht, col, hegel.Draw(ht, tableCellCount))
+	})
+}
+
+// tableDocuments: goldmark/23's region: a document with a GFM table, prose around it or not;
+// past: the same rows without the delimiter row (a paragraph).
+var tableDocuments = cat(
+	maybe(50, cat(shortWords, lit("\n\n"))),
+	byColumns(func(cols int) hegel.Generator[string] {
+		return tablesWith(cols, shaped(hegel.Just(cols), hegel.Just(0)))
+	}),
+	maybe(50, cat(lit("\n"), shortWords, lit("\n"))),
+)
+
+// TestHegelAstIsWellFormedWithTables: checkAST on documents holding a table, goldmark/23's
+// region (the wide property's check, on its shape alone).
+func TestHegelAstIsWellFormedWithTables(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, tableDocuments)
+		bs := []byte(src)
+		doc := allP.Parse(bs)
+		if msg := checkAST(doc, bs); msg != "" {
+			var bugs []string
+			if hasTable(doc) {
+				bugs = []string{"goldmark/23"}
+			}
+			col.mismatch(ht, bugs, "%s\n src %s", msg, show(src))
+			return
+		}
+		col.count("ok")
+	})
+}
+
+// indentedDelimiterRow: goldmark/29's region: a header row with pipes and a delimiter row
+// indented four or more columns (a tab, or spaces); past: indented up to three spaces.
+var indentedDelimiterRow = cat(
+	pick("a | b", "| a | b |", "a|b"),
+	lit("\n"),
+	shaped(pick("\t", "    ", "     ", " \t"), pick("", " ", "  ", "   ")),
+	pick("-|-", "--- | ---", "| --- | --- |", ":-|-:"),
+	pick("\n", "", "\nc | d\n"),
+)
+
+func TestHegelIndentedDelimiterRowAgreesWithMicromark(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeGfm(ht, col, hegel.Draw(ht, indentedDelimiterRow))
+	})
+}
+
+// --------------------------------------------------------------------------- Linkify
+
+var (
+	linkifyBefore = maybe(50, cat(shortWords, lit(" ")))
+	linkifyAfter  = pick("", "\n", " b\n")
+
+	// autolinkLiteralStar: goldmark/18's region: a "*" or a non-ASCII letter inside an
+	// autolink literal's path; past: "_", "~", "-" or "/" there.
+	autolinkLiteralStar = cat(
+		linkifyBefore,
+		pick("www.x.y/a", "http://x.y/a", "https://a.b/c", "www.x.y/"),
+		shaped(pick("*", "\xCF\x80", "\xC3\xA9"), pick("_", "~", "-", "/")),
+		shortWords, linkifyAfter,
+	)
+
+	// emailAfterUnderscore: goldmark/19's region: an e-mail autolink literal starting with
+	// "_"; past: starting with a letter ("-", "+" and "." are candidate/go/goldmark-3).
+	emailAfterUnderscore = cat(
+		linkifyBefore,
+		shaped(lit("_"), pick("", " ")),
+		shortWords, lit("@"), shortWords, lit("."), shortWords, linkifyAfter,
+	)
+
+	// wwwOnePeriod: goldmark/20's region: "www." and one domain segment; past: two.
+	wwwOnePeriod = cat(
+		linkifyBefore,
+		lit("www."), shortWords, shaped(lit(""), cat(lit("."), shortWords)),
+		pick("", "/a", " b", "\n", "/\n"),
+	)
+
+	// parenAfterDomain: goldmark/22's region: "(" or "~" right after an autolink literal's
+	// domain; past: a path first.
+	parenAfterDomain = cat(
+		linkifyBefore,
+		pick("www.a.b", "http://a.b", "https://x.y", "www.x.y.z"),
+		shaped(pick("(", "~"), pick("/", "/c(", "/c~")),
+		shortWords, pick("", ")", "\n", " b\n"),
+	)
+
+	// emailLocalPartStar: goldmark/24's region: "*" or "~" inside an e-mail autolink
+	// literal's local part; past: "+", "-" or "." there.
+	emailLocalPartStar = cat(
+		linkifyBefore,
+		shortWords, shaped(pick("*", "~"), pick("+", "-", ".")), shortWords,
+		lit("@"), shortWords, lit("."), shortWords, linkifyAfter,
+	)
+
+	// underscoreInWwwDomain: goldmark/27's region: "_" in one of the last two segments of a
+	// www. domain (no link at all); past: a hyphen in the second-to-last segment, or none (a
+	// hyphen in the last segment is candidate/go/goldmark-4).
+	underscoreInWwwDomain = cat(
+		linkifyBefore,
+		lit("www."),
+		shaped(pick("a_b.c", "a.b_c", "a_.c", "x._y"), pick("a-b.c", "a-.c", "ab.c", "a.bc")),
+		pick("", "/a", "\n", " b\n"),
+	)
+)
+
+func TestHegelAutolinkLiteralWithStarAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, autolinkLiteralStar))
+	})
+}
+
+func TestHegelEmailAutolinkWithLeadingUnderscoreAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, emailAfterUnderscore))
+	})
+}
+
+func TestHegelWwwAutolinkWithOnePeriodAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, wwwOnePeriod))
+	})
+}
+
+func TestHegelAutolinkLiteralParenAfterDomainAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, parenAfterDomain))
+	})
+}
+
+func TestHegelEmailAutolinkLocalPartAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, emailLocalPartStar))
+	})
+}
+
+func TestHegelUnderscoreInWwwDomainAgreesWithGfmAutolinkLiterals(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgeLinkify(ht, col, hegel.Draw(ht, underscoreInWwwDomain))
+	})
+}
