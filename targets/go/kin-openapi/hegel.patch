+// --------------------------------------------------------------------------- router shapes
+
+var (
+	hzPlainValues   = hegel.SampledFrom([]string{"1", "abc", "x", "A", "a-b"})
+	hzEncodedValues = hegel.SampledFrom([]string{"a%20b", "%C3%A9", "a%25b", "x%2Ey"})
+	hzSlashValues   = hegel.SampledFrom([]string{"%2F", "a%2Fb", "%2f"})
+	hzBasePaths     = hegel.SampledFrom([]string{"https://api.example.com/v1", "https://api.example.com"})
+	// hzFewMethods: up to three distinct methods (GET when none), so that one is left out
+	hzFewMethods = hegel.Map(many(hegel.SampledFrom(hzMethods), 0, 3), func(ms []string) []string {
+		if ms = distinct(ms); len(ms) == 0 {
+			return []string{"GET"}
+		}
+		return ms
+	})
+	// hzTemplated: a template with a variable for sure (the last segment when none was drawn)
+	hzTemplated = hegel.Map(hzSegments, func(segs []string) hzTemplate {
+		segs = append([]string{}, segs...)
+		if (hzTemplate{segs}).concrete() {
+			segs[len(segs)-1] = "{id}"
+		}
+		return uniqueVars(segs)
+	})
+	// hzLiteralTemplates: the drawn segments with every variable made a literal
+	hzLiteralTemplates = hegel.Map(hzSegments, func(segs []string) hzTemplate { return literalOnly(hzTemplate{segs}) })
+)
+
+// literalOnly is the template with every variable replaced by the literal "a".
+func literalOnly(t hzTemplate) hzTemplate {
+	segs := make([]string, len(t.segs))
+	for i, s := range t.segs {
+		if s[0] == '{' {
+			s = "a"
+		}
+		segs[i] = s
+	}
+	return hzTemplate{segs}
+}
+
+// methodNotIn: a method the item lacks.
+func methodNotIn(methods []string) hegel.Generator[string] {
+	var rest []string
+	for _, m := range hzMethods {
+		if !contains(methods, m) {
+			rest = append(rest, m)
+		}
+	}
+	return hegel.SampledFrom(rest)
+}
+
+func contains(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+// oneItemCase: a document of one path item and one request against it.
+func oneItemCase(tmpl hzTemplate, methods []string, server string, req hzRequest) hzRouterCase {
+	return hzRouterCase{doc: docOf([]hzPathItem{{tmpl, methods}}, server), reqs: []hzRequest{req}}
+}
+
+// instancesWith: a request instantiating the only template with the values, of one of its
+// methods.
+func instancesWith(methods []string, vals hegel.Generator[string]) hegel.Generator[hzRequest] {
+	return hegel.Map(pairs(hegel.SampledFrom(methods), many(vals, 1, 3)), func(p pair[string, []string]) hzRequest {
+		return hzRequest{method: p.a, vals: p.b}
+	})
+}
+
+// encodedCasesOf: one templated item, no or the given servers, a request with the values.
+func encodedCasesOf(servers hegel.Generator[string], vals hegel.Generator[string]) hegel.Generator[hzRouterCase] {
+	return hegel.FlatMap(pairs(hzTemplated, hzFewMethods), func(p pair[hzTemplate, []string]) hegel.Generator[hzRouterCase] {
+		return hegel.Map(pairs(servers, instancesWith(p.b, vals)), func(q pair[string, hzRequest]) hzRouterCase {
+			return oneItemCase(p.a, p.b, q.a, q.b)
+		})
+	})
+}
+
+func hzRouterShape(t *testing.T, cases hegel.Generator[hzRouterCase]) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		checkRoutes(ht, c, hegel.Draw(ht, cases))
+	})
+}
+
+// kin-openapi/13: a templated path (past it: a literal one) asked with a method its item lacks
+// must give "method not allowed", not "path not found".
+var hzLegacyMethodOnTemplatedCases = hegel.FlatMap(pairs(shaped(hzTemplated, hzLiteralTemplates), hzFewMethods), func(p pair[hzTemplate, []string]) hegel.Generator[hzRouterCase] {
+	return hegel.Map(pairs(methodNotIn(p.b), many(hzPlainValues, 1, 3)), func(q pair[string, []string]) hzRouterCase {
+		return oneItemCase(p.a, p.b, "", hzRequest{method: q.a, vals: q.b})
+	})
+})
