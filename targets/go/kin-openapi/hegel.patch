+// schemaCasesOf: cases of the schemas with the shape value first and up to three values
+// shaped after the schema.
+func schemaCasesOf(v31 bool, schemas hegel.Generator[hzSchema], first func(hzSchema) any) hegel.Generator[hzSchemaCase] {
+	return hegel.FlatMap(schemas, func(s hzSchema) hegel.Generator[hzSchemaCase] {
+		return hegel.Map(many(valuesOf(s, 2), 0, 3), func(vals []any) hzSchemaCase {
+			return hzSchemaCase{v31, s, append([]any{first(s)}, vals...)}
+		})
+	})
+}
+
+func nullFirst(hzSchema) any { return nil }
+
+func hzSchemaShape(t *testing.T, cases hegel.Generator[hzSchemaCase]) {
+	c := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	hzProperty(t, func(ht *hegel.T) {
+		checkSchema(ht, c, oracle, hegel.Draw(ht, cases))
+	})
+}
