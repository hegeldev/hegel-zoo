+func TestHegelNullableTypeList2020(t *testing.T) { hzSchemaShape(t, hzNullableTypeList2020Cases) }
+
+// kin-openapi/4: a nullable string (past it: a plain string) beside an enum, a not or a
+// oneOf, or a 3.1 type list with null (past it: without) beside an enum, given null; the
