+func TestHegelLegacyMethodOnTemplated(t *testing.T) { hzRouterShape(t, hzLegacyMethodOnTemplatedCases) }
+
+// kin-openapi/14: a concrete path lacking the method (past it: having it) beside a templated
+// path matching it that has the method; the request for the concrete path must not fall
+// through to the templated one.
+var hzLegacyMethodFallsThroughCases = hegel.FlatMap(pairs(hzLiteralTemplates, hzFewMethods), func(p pair[hzTemplate, []string]) hegel.Generator[hzRouterCase] {
+	concrete, methods := p.a, p.b
+	return hegel.Map(pairs(methodNotIn(methods), positions), func(q pair[string, int]) hzRouterCase {
+		segs := append([]string{}, concrete.segs...)
+		segs[q.b%len(segs)] = "{id}"
+		concreteMethods := methods
+		if noKnown {
+			concreteMethods = append(append([]string{}, methods...), q.a)
+		}
+		items := []hzPathItem{{concrete, concreteMethods}, {hzTemplate{segs}, []string{q.a}}}
+		return hzRouterCase{doc: docOf(items, ""), reqs: []hzRequest{{method: q.a, tmpl: 0, vals: []string{"x"}}}}
+	})
+})
+
+func TestHegelLegacyMethodFallsThrough(t *testing.T) {
+	hzRouterShape(t, hzLegacyMethodFallsThroughCases)
+}
+
+// kin-openapi/15: a template ending in variables, asked without its last variables or with a
+// trailing slash (past it: a full instance), must not match with empty parameters.
+var hzLegacyTrailingVariableCases = hegel.Composite(func(tc hegel.TestCase) hzRouterCase {
+	literals := hegel.Draw(tc, many(hzLiteral, 1, 2))
+	vars := hegel.Draw(tc, hegel.Integers(1, 2))
+	methods := hegel.Draw(tc, hzFewMethods)
+	method := hegel.Draw(tc, hegel.SampledFrom(methods))
+	missing := hegel.Draw(tc, hegel.Integers(0, vars))
+	slash := hegel.Draw(tc, chance(50))
+	vals := hegel.Draw(tc, many(hzPlainValues, 1, 2))
+	segs := append([]string{}, literals...)
+	for i := 0; i < vars; i++ {
+		segs = append(segs, "{v}")
+	}
+	tmpl := uniqueVars(segs)
+	if noKnown {
+		return oneItemCase(tmpl, methods, "", hzRequest{method: method, vals: vals})
+	}
+	if missing == 0 && !slash {
+		missing = 1
+	}
+	raw := append([]string{}, literals...)
+	for i := 0; i < vars-missing; i++ {
+		raw = append(raw, vals[i%len(vals)])
+	}
+	if slash {
+		raw = append(raw, "")
+	}
+	return oneItemCase(tmpl, methods, "", hzRequest{method: method, random: raw})
+})
+
+func TestHegelLegacyTrailingVariable(t *testing.T) { hzRouterShape(t, hzLegacyTrailingVariableCases) }
+
+// kin-openapi/16: a parameter value holding a percent-encoded slash (past it: an encoded
+// space) must match the variable as one segment.
+var hzLegacyDecodesBeforeSplitCases = encodedCasesOf(hegel.Just(""), shaped(hzSlashValues, hzEncodedValues))
+
+func TestHegelLegacyDecodesBeforeSplit(t *testing.T) {
+	hzRouterShape(t, hzLegacyDecodesBeforeSplitCases)
+}
+
+// kin-openapi/17: a percent-encoded parameter value (past it: a plain one), no servers, must
+// come back decoded from the gorillamux router.
+var hzGorillamuxEncodedParamsCases = encodedCasesOf(hegel.Just(""), shaped(hzEncodedValues, hzPlainValues))
+
+func TestHegelGorillamuxEncodedParams(t *testing.T) { hzRouterShape(t, hzGorillamuxEncodedParamsCases) }
+
+// kin-openapi/18: a percent-encoded parameter value (past it: a plain one) with servers
+// declared must come back decoded from the legacy router.
+var hzLegacyEncodedWithServersCases = encodedCasesOf(hzBasePaths, shaped(hzEncodedValues, hzPlainValues))
+
+func TestHegelLegacyEncodedWithServers(t *testing.T) {
+	hzRouterShape(t, hzLegacyEncodedWithServersCases)
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..de4493b
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,350 @@
+package hegel
+
+// Hegel property tests for kin-openapi, written for the Hegel zoo. See
+// targets/go/kin-openapi/README.md. They live in a package of their own (hegel/) and drive
+// the public API: openapi3.Schema (JSON round trip, VisitJSON in its built-in and JSON Schema
+// 2020-12 modes), the parameter decoding of openapi3filter and the routers.
+//
+// Oracles: the Python `jsonschema` package (Draft 2020-12) over a JSON-lines subprocess for the
+// schema validator, the OpenAPI specification's serialization rules for parameters, and the
+// library against itself (the two validation modes, the two routers).
+//
+// Every property draws one case record from generator values built with hegel's combinators
+// and renders it with pure functions. The shapes of the recorded bugs (bugs.toml) are drawn at
+// their natural rate, so the wide properties that meet them fail, naming the shape, and are
+// the expected failures mapped to the bugs (STYLE.md rule 11); hegel_zoo_shapes_test.go has one
+// property per bug over its shape region alone, and the pins (hegel_zoo_pins_test.go,
+// hegel_zoo_pins2_test.go) are the regression examples. HEGEL_NO_KNOWN=1 switches the known
+// shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing and print their counts at the end of each test.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape
+// (mismatch); under HEGEL_NO_KNOWN=1 the switches of HZKnown are on: the shapes are left out of
+// the generators (shaped, pastKnown, the malformed pools) and the checks that only a recorded
+// bug can fail are skipped by name, the rest of the case still judged.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// HZKnown: the recorded bugs the generated cases reach. A switch is on only under
+// HEGEL_NO_KNOWN=1; while it is on the generators keep away from the shape or the checks skip it.
+var HZKnown = struct {
+	constNull                bool // kin-openapi/1: a schema's "const": null is dropped by MarshalJSON and read as no const, so it accepts every value
+	nullableFallback2020     bool // kin-openapi/2: EnableJSONSchema2020 falls back to the built-in validator, silently, for any schema holding nullable: true with a type (the translation builds a []string type that the JSON Schema compiler rejects)
+	nullableTypeList2020     bool // kin-openapi/3: EnableJSONSchema2020 loses nullable: true when the type is a list: the translation drops the keyword without adding "null" to the list
+	nullSkipsKeywords        bool // kin-openapi/4: a nullable schema accepts null without applying enum, const, not, oneOf, anyOf or allOf (OpenAPI 3.0.3: "Other Schema Object constraints retain their defined behavior, and therefore may disallow the use of null as a value")
+	nullBranchOverridesType  bool // kin-openapi/5: a typed, non-nullable schema accepts null when a branch of its oneOf, anyOf or allOf is nullable: the type check is skipped for null once the combinator passed
+	intFormatOnNumber2020    bool // kin-openapi/6: EnableJSONSchema2020 applies the int32/int64 format checks to integral values of a number-typed schema (the built-in validator applies them only when the type requires an integer)
+	int64Overflow2020        bool // kin-openapi/7: EnableJSONSchema2020 converts the value to int64 before the int32/int64 range check, so 1e300 passes format int64 (the built-in validator rejects it)
+	multipleOfSlack          bool // kin-openapi/8: multipleOf accepts an exactly representable integer that is not a multiple: 9007199254740992 (2^53) passes multipleOf 10 (the relative slack of 2^-51 exceeds the remainder)
+	notEmptySchema           bool // kin-openapi/9: {"not": {}} and {"oneOf": [{}, {}]} are treated as empty schemas (IsEmpty looks through not and oneOf) and accept every value instead of none
+	paramIntGoSyntax         bool // kin-openapi/10: an integer parameter accepts Go literal syntax: 0x10, 0b11, 0o17, 1_000 (strconv.ParseInt with base 0)
+	paramFloatGoSyntax       bool // kin-openapi/11: a number parameter accepts hexadecimal floats and digit separators: 0x1p-2, 0X1P2, 1_0.5 (strconv.ParseFloat)
+	paramBoolSpellings       bool // kin-openapi/12: a boolean parameter accepts 1, 0, t, f, T, F, TRUE, FALSE, True, False (strconv.ParseBool)
+	legacy404ForTemplated    bool // kin-openapi/13: the legacy router reports "path not found" instead of "method not allowed" for a templated path whose item lacks the method (the method is part of the matched pattern; only literal paths get the granular error)
+	legacyMethodFallsThrough bool // kin-openapi/14: the legacy router routes a request for a concrete path lacking the method to a templated path that has it (POST /x1 with GET /x1 and POST /{id} declared gives /{id})
+	legacyTrailingVariable   bool // kin-openapi/15: the legacy router matches a path that lacks a template's final variable segments, or ends with a slash, giving empty parameters (GET /a matches /a/{x} with x = "")
+	legacyDecodesBeforeSplit bool // kin-openapi/16: the legacy router splits the path into segments after percent-decoding, so %2F in a parameter value acts as a separator (GET /a/b%2Fc does not match /a/{x})
+	gorillamuxEncodedParams  bool // kin-openapi/17: the gorillamux router returns path parameter values percent-encoded as in the request (a%20b), the legacy router decoded (a b)
+	legacyEncodedWithServers bool // kin-openapi/18: the legacy router returns percent-encoded path parameter values when the document has servers (it matches the raw URL then), decoded ones otherwise
+}{
+	constNull:                noKnown,
+	nullableFallback2020:     noKnown,
+	nullableTypeList2020:     noKnown,
+	nullSkipsKeywords:        noKnown,
+	nullBranchOverridesType:  noKnown,
+	intFormatOnNumber2020:    noKnown,
+	int64Overflow2020:        noKnown,
+	multipleOfSlack:          noKnown,
+	notEmptySchema:           noKnown,
+	paramIntGoSyntax:         noKnown,
+	paramFloatGoSyntax:       noKnown,
+	paramBoolSpellings:       noKnown,
+	legacy404ForTemplated:    noKnown,
+	legacyMethodFallsThrough: noKnown,
+	legacyTrailingVariable:   noKnown,
+	legacyDecodesBeforeSplit: noKnown,
+	gorillamuxEncodedParams:  noKnown,
+	legacyEncodedWithServers: noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// hzProperty runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test). Hegel's own control-flow panics pass.
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts what a property met (ZOO_COLLECT=1 prints the counts) and, in collect
+// mode, records mismatches instead of failing.
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bugs shapes name (none for an empty list): the failure names the shapes, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out and the checks only a bug can fail are skipped by name).
+func (c *hzCollector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// deferred draws from a generator assigned later (a recursive grammar's forward reference).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// distinct drops the repeats of a list, keeping the first occurrences.
+func distinct(xs []string) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements, which encoding/json writes as null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// anyList is the strings as a []any (a JSON array).
+func anyList[T any](xs []T) []any {
+	out := make([]any, len(xs))
+	for i, x := range xs {
+		out[i] = x
+	}
+	return out
+}
