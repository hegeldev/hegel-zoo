+package hegel
+
+// Hegel property tests for kin-openapi, written for the Hegel zoo. See
+// targets/go/kin-openapi/README.md. They live in a package of their own (hegel/) and drive
+// the public API: openapi3.Schema (JSON round trip, VisitJSON in its built-in and JSON Schema
+// 2020-12 modes), the parameter decoding of openapi3filter and the routers.
+//
+// Oracles: the Python `jsonschema` package (Draft 2020-12) over a JSON-lines subprocess for the
+// schema validator, the OpenAPI specification's serialization rules for parameters, and the
+// library against itself (the two validation modes, the two routers).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	constNull                bool // a schema's "const": null is dropped by MarshalJSON and read as no const, so it accepts every value
+	nullableFallback2020     bool // EnableJSONSchema2020 falls back to the built-in validator, silently, for any schema holding nullable: true with a type (the translation builds a []string type that the JSON Schema compiler rejects)
+	nullableTypeList2020     bool // EnableJSONSchema2020 loses nullable: true when the type is a list: the translation drops the keyword without adding "null" to the list
+	nullSkipsKeywords        bool // a nullable schema accepts null without applying enum, const, not, oneOf, anyOf or allOf (OpenAPI 3.0.3: "Other Schema Object constraints retain their defined behavior, and therefore may disallow the use of null as a value")
+	nullBranchOverridesType  bool // a typed, non-nullable schema accepts null when a branch of its oneOf, anyOf or allOf is nullable: the type check is skipped for null once the combinator passed
+	intFormatOnNumber2020    bool // EnableJSONSchema2020 applies the int32/int64 format checks to integral values of a number-typed schema (the built-in validator applies them only when the type requires an integer)
+	int64Overflow2020        bool // EnableJSONSchema2020 converts the value to int64 before the int32/int64 range check, so 1e300 passes format int64 (the built-in validator rejects it)
+	multipleOfSlack          bool // multipleOf accepts an exactly representable integer that is not a multiple: 9007199254740992 (2^53) passes multipleOf 10 (the relative slack of 2^-51 exceeds the remainder)
+	notEmptySchema           bool // {"not": {}} and {"oneOf": [{}, {}]} are treated as empty schemas (IsEmpty looks through not and oneOf) and accept every value instead of none
+	paramIntGoSyntax         bool // an integer parameter accepts Go literal syntax: 0x10, 0b11, 0o17, 1_000 (strconv.ParseInt with base 0)
+	paramFloatGoSyntax       bool // a number parameter accepts hexadecimal floats and digit separators: 0x1p-2, 0X1P2, 1_0.5 (strconv.ParseFloat)
+	paramBoolSpellings       bool // a boolean parameter accepts 1, 0, t, f, T, F, TRUE, FALSE, True, False (strconv.ParseBool)
+	gorillamuxEncodedParams  bool // the gorillamux router returns path parameter values percent-encoded as in the request (a%20b), the legacy router decoded (a b)
+	legacy404ForTemplated    bool // the legacy router reports "path not found" instead of "method not allowed" for a templated path whose item lacks the method (the method is part of the matched pattern; only literal paths get the granular error)
+	legacyMethodFallsThrough bool // the legacy router routes a request for a concrete path lacking the method to a templated path that has it (POST /x1 with GET /x1 and POST /{id} declared gives /{id})
+	legacyTrailingVariable   bool // the legacy router matches a path that lacks a template's final variable segment, or ends with a slash, giving an empty parameter (GET /a matches /a/{x} with x = "")
+	legacyDecodesBeforeSplit bool // the legacy router splits the path into segments after percent-decoding, so %2F in a parameter value acts as a separator (GET /a/b%2Fc does not match /a/{x})
+	legacyEncodedWithServers bool // the legacy router returns percent-encoded path parameter values when the document has servers (it matches the raw URL then), decoded ones otherwise
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
