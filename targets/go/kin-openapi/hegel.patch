+// kin-openapi/6: a number with format int32 (past it: double), given integral values beyond
+// int32; the JSON Schema 2020-12 mode must not apply the integer format to numbers.
+var hzBigIntegral = hegel.SampledFrom([]float64{2147483648, -2147483649, 4294967296, 1e10, -1e15})
