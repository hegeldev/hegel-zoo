+var hzIntFormatOnNumberCases = hegel.FlatMap(hegel.Just(hzSchema{"type": "number", "format": shaped("int32", "double")}), func(s hzSchema) hegel.Generator[hzSchemaCase] {
+	return hegel.Map(many(hegel.OneOf(asAny(hzBigIntegral), asAny(hzNumbers)), 0, 3), func(vals []any) hzSchemaCase {
+		return hzSchemaCase{false, s, append([]any{float64(2147483648)}, vals...)}
+	})
+})
