+package hegel
+
+// TestHegelParameters: a generated parameter (location, style, explode, a primitive, array or
+// object schema) and a generated value, serialized by the rules of the OpenAPI 3.0.3 "Style
+// Examples" table into a request; openapi3filter.ValidateParameter must accept the request and
+// decode exactly the value. The decoded value is observed through format validators registered
+// under private names, which record what they are given. A case is one record (hzParamCase):
+// the parameter with its values, the request options and, for a numeric or boolean primitive
+// outside the path, a malformed text sent instead of the value one time in five; the malformed
+// pools hold the Go-syntax and ParseBool spellings the decoders accept (kin-openapi/10, /11,
+// /12) unless HEGEL_NO_KNOWN=1.
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- capture channel
+
+type hzCap struct {
+	slot string
+	val  any
+}
+
+var (
+	hzCapMu   sync.Mutex
+	hzCaptued []hzCap
+)
+
+func hzRecord(slot string, v any) {
+	hzCapMu.Lock()
+	hzCaptued = append(hzCaptued, hzCap{slot, v})
+	hzCapMu.Unlock()
+}
+
+func hzTakeCaptures() []hzCap {
+	hzCapMu.Lock()
+	defer hzCapMu.Unlock()
+	out := hzCaptued
+	hzCaptued = nil
+	return out
+}
+
+var hzSlots = []string{"v", "item", "a", "b", "c"}
+
+func init() {
+	for _, slot := range hzSlots {
+		slot := slot
+		openapi3.DefineStringFormatValidator("hzcaps_"+slot, openapi3.NewCallbackValidator(func(s string) error {
+			hzRecord(slot, s)
+			return nil
+		}))
+		openapi3.DefineIntegerFormatValidator("hzcapi_"+slot, openapi3.NewCallbackValidator(func(v int64) error {
+			hzRecord(slot, v)
+			return nil
+		}))
+		openapi3.DefineNumberFormatValidator("hzcapn_"+slot, openapi3.NewCallbackValidator(func(v float64) error {
+			hzRecord(slot, v)
+			return nil
+		}))
+	}
+}
+
+// --------------------------------------------------------------------------- primitives
+
+type hzPrim struct {
+	typ string // string, integer, number, boolean
+	val any    // string, int64, float64, bool
+}
+
+func (p hzPrim) text() string {
+	switch v := p.val.(type) {
+	case string:
+		return v
+	case int64:
+		return strconv.FormatInt(v, 10)
+	case float64:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	case bool:
+		return strconv.FormatBool(v)
+	}
+	panic("hzPrim")
+}
+
+// schema gives the primitive's schema with the recording format (booleans use enum).
+func (p hzPrim) schema(slot string) *openapi3.Schema {
+	s := openapi3.NewSchema()
+	s.Type = &openapi3.Types{p.typ}
+	switch p.typ {
+	case "string":
+		s.Format = "hzcaps_" + slot
+	case "integer":
+		s.Format = "hzcapi_" + slot
+	case "number":
+		s.Format = "hzcapn_" + slot
+	case "boolean":
+		s.Enum = []any{p.val}
+	}
+	return s
+}
+
+var (
+	hzParamAlphabet = []string{"a", "b", "z", "A", "Z", "0", "9", "-", "_", ".", "~"}
+	// characters that need percent-encoding in a query or are delimiters of some style; a
+	// value never holds the delimiters of its own style (the decoder cannot tell them apart,
+	// nor could anyone)
+	hzParamSpecials = []string{" ", ",", ".", ";", "=", "&", "|", "+", "%", "/", "?", "#", "[", "]", "\u00e9", "\u65e5", "'", "\"", "<", ">", "@", ":", "!", "*", "(", ")", "$"}
+	hzParamInts     = []int64{0, 1, -1, 7, 42, -100, 2147483647, 2147483648, -2147483649, 1 << 62}
+	hzParamFloats   = []float64{0, 1, -1, 1.5, -0.25, 2.5, 1e10, 100, 0.001}
+	hzParamTypes    = []string{"string", "integer", "number", "boolean"}
+	hzParamIns      = []string{"path", "query", "header", "cookie"}
+	hzParamKinds    = []string{"primitive", "primitive", "array", "object"}
+	hzPropKeys      = hegel.SampledFrom([]string{"a", "b", "c"})
+)
+
+// without is the pool without the strings holding a character of avoid.
+func without(pool []string, avoid string) []string {
+	var out []string
+	for _, s := range pool {
+		if !strings.ContainsAny(s, avoid) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// primsOf: a primitive of the type whose text holds none of the avoid characters: a string of
+// one to four characters, each a special one 25% of the time; a pool integer; a pool number
+// (an integral one when "." is avoided); a boolean.
+func primsOf(typ, avoid string) hegel.Generator[hzPrim] {
+	switch typ {
+	case "string":
+		chars := weighted(
+			choice[string]{75, hegel.SampledFrom(without(hzParamAlphabet, avoid))},
+			choice[string]{25, hegel.SampledFrom(without(hzParamSpecials, avoid))},
+		)
+		return hegel.Map(many(chars, 1, 4), func(cs []string) hzPrim { return hzPrim{"string", strings.Join(cs, "")} })
+	case "integer":
+		return hegel.Map(hegel.SampledFrom(hzParamInts), func(v int64) hzPrim { return hzPrim{"integer", v} })
+	case "number":
+		pool := hzParamFloats
+		if strings.Contains(avoid, ".") {
+			pool = nil
+			for _, v := range hzParamFloats {
+				if v == float64(int64(v)) {
+					pool = append(pool, v)
+				}
+			}
+		}
+		return hegel.Map(hegel.SampledFrom(pool), func(v float64) hzPrim { return hzPrim{"number", v} })
+	}
+	return hegel.Map(hegel.Booleans(), func(b bool) hzPrim { return hzPrim{"boolean", b} })
+}
+
+// anyPrimOf: a primitive of any of the four types.
+func anyPrimOf(avoid string) hegel.Generator[hzPrim] {
+	arms := make([]hegel.Generator[hzPrim], len(hzParamTypes))
+	for i, typ := range hzParamTypes {
+		arms[i] = primsOf(typ, avoid)
+	}
+	return hegel.OneOf(arms...)
+}
+
+// --------------------------------------------------------------------------- parameters
+
+// hzLayout: where a parameter lives, what it holds and how it is serialized.
+type hzLayout struct {
+	in      string
+	kind    string // primitive, array, object
+	style   string
+	explode bool
+}
+
+// layoutsOf: the styles a location admits for the kind (OpenAPI 3.0.3 Parameter Object): the
+// path simple, label or matrix, the header simple, the query form (a delimited style for 40%
+// of the arrays, deepObject for 40% of the objects), the cookie form, exploded or not (a
+// cookie array or object never).
+func layoutsOf(in, kind string) hegel.Generator[hzLayout] {
+	styled := func(styles hegel.Generator[string], explode hegel.Generator[bool]) hegel.Generator[hzLayout] {
+		return hegel.Map(pairs(styles, explode), func(p pair[string, bool]) hzLayout { return hzLayout{in, kind, p.a, p.b} })
+	}
+	switch in {
+	case "path":
+		return styled(hegel.SampledFrom([]string{"simple", "label", "matrix"}), chance(50))
+	case "header":
+		return styled(hegel.Just("simple"), chance(50))
+	case "query":
+		form := styled(hegel.Just("form"), chance(50))
+		switch kind {
+		case "array":
+			return weighted(choice[hzLayout]{60, form}, choice[hzLayout]{40, styled(hegel.SampledFrom([]string{"spaceDelimited", "pipeDelimited"}), hegel.Just(false))})
+		case "object":
+			return weighted(choice[hzLayout]{60, form}, choice[hzLayout]{40, hegel.Just(hzLayout{in, kind, "deepObject", true})})
+		}
+		return form
+	}
+	if kind == "primitive" {
+		return styled(hegel.Just("form"), chance(50))
+	}
+	return hegel.Just(hzLayout{in, kind, "form", false})
+}
+
+var hzLayouts = hegel.FlatMap(pairs(hegel.SampledFrom(hzParamIns), hegel.SampledFrom(hzParamKinds)), func(p pair[string, string]) hegel.Generator[hzLayout] {
+	return layoutsOf(p.a, p.b)
+})
+
+// delimiters lists the characters that the layout's style and location use as delimiters,
+// which its values must not contain.
+func (l hzLayout) delimiters() string {
+	d := ""
+	if l.in == "cookie" {
+		d += ";=\"\\\u00e9\u65e5" // the Cookie header's own syntax; net/http drops non-ASCII bytes
+	}
+	if l.in == "header" {
+		d += " " // trimmed
+	}
+	switch l.style {
+	case "label":
+		d += "."
+	case "matrix":
+		d += ";"
+	}
+	if l.kind == "primitive" {
+		return d
+	}
+	d += ","
+	switch l.style {
+	case "spaceDelimited":
+		d += " "
+	case "pipeDelimited":
+		d += "|"
+	}
+	if l.kind == "object" && l.explode {
+		d += "="
+	}
+	return d
+}
+
+// hzParam: a parameter with its value: a primitive, one to three items of one type, or one to
+// three properties named a, b, c.
+type hzParam struct {
+	hzLayout
+	prim  hzPrim
+	items []hzPrim
+	props map[string]hzPrim
+	keys  []string // sorted property names
+}
+
+// paramsOf: the values a parameter of the layout may hold, none of whose texts holds a
+// delimiter of the layout: a primitive (for a location other than the path the empty string one
+// time in ten), items of one drawn type (booleans all alike, since a schema has one items
+// schema and booleans are observed through an enum), or distinct properties.
+func paramsOf(l hzLayout) hegel.Generator[hzParam] {
+	avoid := l.delimiters()
+	switch l.kind {
+	case "primitive":
+		prim := anyPrimOf(avoid)
+		if l.in != "path" {
+			prim = weighted(choice[hzPrim]{10, hegel.Just(hzPrim{"string", ""})}, choice[hzPrim]{90, prim})
+		}
+		return hegel.Map(prim, func(p hzPrim) hzParam { return hzParam{hzLayout: l, prim: p} })
+	case "array":
+		items := hegel.FlatMap(hegel.SampledFrom(hzParamTypes), func(typ string) hegel.Generator[[]hzPrim] {
+			if typ == "boolean" {
+				return hegel.Map(pairs(primsOf(typ, avoid), hegel.Integers(1, 3)), func(p pair[hzPrim, int]) []hzPrim {
+					items := make([]hzPrim, p.b)
+					for i := range items {
+						items[i] = p.a
+					}
+					return items
+				})
+			}
+			return many(primsOf(typ, avoid), 1, 3)
+		})
+		return hegel.Map(items, func(items []hzPrim) hzParam { return hzParam{hzLayout: l, items: items} })
+	}
+	props := hegel.Maps(hzPropKeys, anyPrimOf(avoid)).MinSize(1).MaxSize(3)
+	return hegel.Map(props, func(props map[string]hzPrim) hzParam {
+		return hzParam{hzLayout: l, props: props, keys: sortedKeys(props)}
+	})
+}
+
+var hzParams = hegel.FlatMap(hzLayouts, paramsOf)
+
+func (p hzParam) schema() *openapi3.SchemaRef {
+	switch p.kind {
+	case "primitive":
+		return openapi3.NewSchemaRef("", p.prim.schema("v"))
+	case "array":
+		s := openapi3.NewArraySchema()
+		// every item of one type, the first item's (a schema has one items schema)
+		s.Items = openapi3.NewSchemaRef("", p.items[0].schema("item"))
+		return openapi3.NewSchemaRef("", s)
+	default:
+		s := openapi3.NewObjectSchema()
+		s.Properties = openapi3.Schemas{}
+		for _, k := range p.keys {
+			s.Properties[k] = openapi3.NewSchemaRef("", p.props[k].schema(k))
+		}
+		return openapi3.NewSchemaRef("", s)
+	}
+}
+
+func (p hzParam) itemTexts() []string {
+	out := make([]string, len(p.items))
+	for i, it := range p.items {
+		out[i] = it.text()
+	}
+	return out
+}
+
+// expected captures
+func (p hzParam) expected() []hzCap {
+	switch p.kind {
+	case "primitive":
+		if p.prim.typ == "boolean" {
+			return nil
+		}
+		return []hzCap{{"v", p.prim.val}}
+	case "array":
+		if p.items[0].typ == "boolean" {
+			return nil
+		}
+		var out []hzCap
+		for _, it := range p.items {
+			out = append(out, hzCap{"item", it.val})
+		}
+		return out
+	default:
+		var out []hzCap
+		for _, k := range p.keys {
+			if p.props[k].typ != "boolean" {
+				out = append(out, hzCap{k, p.props[k].val})
+			}
+		}
+		return out
+	}
+}
+
+// --------------------------------------------------------------------------- malformed texts
+
+// hzMalformed: texts that are not a value of the type: by default with the spellings the
+// lenient decoders accept (strconv with base 0, hexadecimal floats and digit separators, the
+// ParseBool spellings: kin-openapi/10, /11, /12), which hzMalformedPast leaves out.
+var hzMalformed = map[string][]string{
+	"integer": {"0x10", "0b11", "0o17", "1_000", " 5", "5 ", "1.0", "1e2", "abc", "true", "--1", "0x", ""},
+	"number":  {"0x1p-2", "0X1P2", "inf", "-Inf", "nan", "NaN", "infinity", "1_0.5", "abc", " 1.5", "1.5 ", "true", "1e", "."},
+	"boolean": {"1", "0", "t", "f", "T", "F", "TRUE", "FALSE", "True", "False", "yes", "no", "abc", ""},
+}
+
+var hzMalformedPast = map[string][]string{
+	"integer": pruned(hzMalformed["integer"], hzGoIntSyntax),
+	"number":  pruned(hzMalformed["number"], hzGoFloatSyntax),
+	"boolean": pruned(hzMalformed["boolean"], hzBoolSpelling),
+}
+
+// pruned is the pool without the texts drop accepts.
+func pruned(pool []string, drop func(string) bool) []string {
+	var out []string
+	for _, s := range pool {
+		if !drop(s) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// the texts the lenient parsers accept (strconv with base 0, hexadecimal floats and digit
+// separators, the ParseBool spellings)
+func hzGoIntSyntax(s string) bool {
+	return strings.HasPrefix(s, "0x") || strings.HasPrefix(s, "0b") || strings.HasPrefix(s, "0o") || strings.Contains(s, "_")
+}
+
+func hzGoFloatSyntax(s string) bool {
+	return strings.HasPrefix(strings.ToLower(s), "0x") || strings.Contains(s, "_")
+}
+
+func hzBoolSpelling(s string) bool {
+	switch s {
+	case "1", "0", "t", "f", "T", "F", "TRUE", "FALSE", "True", "False":
+		return true
+	}
+	return false
+}
+
+// malformedPool: the malformed texts a parameter may be sent instead of its value (a cookie
+// cannot carry the empty text), or none for a string, an array, an object or a path parameter.
+func malformedPool(p hzParam) []string {
+	if p.kind != "primitive" || p.prim.typ == "string" || p.in == "path" {
+		return nil
+	}
+	pool := shaped(hzMalformed, hzMalformedPast)[p.prim.typ]
+	if p.in == "cookie" {
+		pool = pruned(pool, func(s string) bool { return s == "" })
+	}
+	return pool
+}
+
+// --------------------------------------------------------------------------- serialization
+
+const hzParamName = "color"
+
+// serializeSegment gives the raw path segment / header value (OpenAPI 3.0.3 Style Examples).
+func (p hzParam) serializeSegment() string {
+	name := hzParamName
+	switch p.kind {
+	case "primitive":
+		v := p.prim.text()
+		switch p.style {
+		case "simple":
+			return v
+		case "label":
+			return "." + v
+		default: // matrix
+			return ";" + name + "=" + v
+		}
+	case "array":
+		items := p.itemTexts()
+		switch p.style {
+		case "simple":
+			return strings.Join(items, ",")
+		case "label":
+			if p.explode {
+				return "." + strings.Join(items, ".")
+			}
+			return "." + strings.Join(items, ",")
+		default: // matrix
+			if p.explode {
+				var sb strings.Builder
+				for _, it := range items {
+					sb.WriteString(";" + name + "=" + it)
+				}
+				return sb.String()
+			}
+			return ";" + name + "=" + strings.Join(items, ",")
+		}
+	default: // object
+		var flat, pairs []string
+		for _, k := range p.keys {
+			flat = append(flat, k, p.props[k].text())
+			pairs = append(pairs, k+"="+p.props[k].text())
+		}
+		switch p.style {
+		case "simple":
+			if p.explode {
+				return strings.Join(pairs, ",")
+			}
+			return strings.Join(flat, ",")
+		case "label":
+			if p.explode {
+				return "." + strings.Join(pairs, ".")
+			}
+			return "." + strings.Join(flat, ",")
+		default: // matrix
+			if p.explode {
+				return ";" + strings.Join(pairs, ";")
+			}
+			return ";" + name + "=" + strings.Join(flat, ",")
+		}
+	}
+}
+
+// serializeQuery gives the query values (form, spaceDelimited, pipeDelimited, deepObject).
+func (p hzParam) serializeQuery() url.Values {
+	name := hzParamName
+	q := url.Values{}
+	switch p.kind {
+	case "primitive":
+		q.Set(name, p.prim.text())
+	case "array":
+		items := p.itemTexts()
+		switch p.style {
+		case "form":
+			if p.explode {
+				q[name] = items
+			} else {
+				q.Set(name, strings.Join(items, ","))
+			}
+		case "spaceDelimited":
+			q.Set(name, strings.Join(items, " "))
+		case "pipeDelimited":
+			q.Set(name, strings.Join(items, "|"))
+		}
+	default:
+		switch p.style {
+		case "form":
+			if p.explode {
+				for _, k := range p.keys {
+					q.Set(k, p.props[k].text())
+				}
+			} else {
+				var flat []string
+				for _, k := range p.keys {
+					flat = append(flat, k, p.props[k].text())
+				}
+				q.Set(name, strings.Join(flat, ","))
+			}
+		case "deepObject":
+			for _, k := range p.keys {
+				q.Set(name+"["+k+"]", p.props[k].text())
+			}
+		}
+	}
+	return q
+}
+
+// serializeCookie gives the cookie value (form; arrays and objects unexploded).
+func (p hzParam) serializeCookie() string {
+	switch p.kind {
+	case "primitive":
+		return p.prim.text()
+	case "array":
+		return strings.Join(p.itemTexts(), ",")
+	default:
+		var flat []string
+		for _, k := range p.keys {
+			flat = append(flat, k, p.props[k].text())
+		}
+		return strings.Join(flat, ",")
+	}
+}
+
+func (p hzParam) String() string {
+	var val string
+	switch p.kind {
+	case "primitive":
+		val = fmt.Sprintf("%s %#v", p.prim.typ, p.prim.val)
+	case "array":
+		val = fmt.Sprintf("array of %s %v", p.items[0].typ, p.itemTexts())
+	default:
+		var parts []string
+		for _, k := range p.keys {
+			parts = append(parts, fmt.Sprintf("%s: %s %#v", k, p.props[k].typ, p.props[k].val))
+		}
+		val = "object {" + strings.Join(parts, ", ") + "}"
+	}
+	return fmt.Sprintf("in=%s style=%s explode=%v %s", p.in, p.style, p.explode, val)
+}
+
+func hzCapsString(caps []hzCap) string {
+	var parts []string
+	for _, c := range caps {
+		parts = append(parts, fmt.Sprintf("%s=%#v", c.slot, c.val))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func hzCapsEqual(a, b []hzCap, ordered bool) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	if !ordered {
+		sort.Slice(a, func(i, j int) bool { return a[i].slot < a[j].slot })
+		sort.Slice(b, func(i, j int) bool { return b[i].slot < b[j].slot })
+	}
+	for i := range a {
+		if a[i].slot != b[i].slot || a[i].val != b[i].val {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- cases
+
+// hzParamCase: a parameter and the request carrying it: whether it is required, whether the
+// Parameter leaves Style (Explode) unset when it is the location's default, whether the value
+// is sent at all, and the malformed text sent instead of the value ("" for the value itself).
+type hzParamCase struct {
+	p              hzParam
+	required       bool
+	defaultStyle   bool
+	defaultExplode bool
+	present        bool
+	malformed      string
+}
+
+var hzParamCases = hegel.FlatMap(hzParams, func(p hzParam) hegel.Generator[hzParamCase] {
+	malformed := hegel.Just("")
+	if pool := malformedPool(p); pool != nil {
+		malformed = maybe(20, hegel.SampledFrom(pool))
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzParamCase {
+		return hzParamCase{
+			p:              p,
+			required:       hegel.Draw(tc, chance(50)),
+			defaultStyle:   hegel.Draw(tc, chance(30)),
+			defaultExplode: hegel.Draw(tc, chance(30)),
+			present:        hegel.Draw(tc, chance(90)),
+			malformed:      hegel.Draw(tc, malformed),
+		}
+	})
+})
+
+// parameter builds the openapi3.Parameter of the case.
+func (c hzParamCase) parameter() *openapi3.Parameter {
+	p := c.p
+	explode := p.explode
+	param := &openapi3.Parameter{
+		Name:     hzParamName,
+		In:       p.in,
+		Style:    p.style,
+		Explode:  &explode,
+		Required: c.required,
+		Schema:   p.schema(),
+	}
+	if c.defaultStyle {
+		param.Style = "" // the default style of the location
+		if (p.in == "path" || p.in == "header") && p.style != "simple" {
+			param.Style = p.style
+		}
+		if (p.in == "query" || p.in == "cookie") && p.style != "form" {
+			param.Style = p.style
+		}
+	}
+	// the default explode of the location: true for query and cookie, false otherwise
+	if c.defaultExplode && (p.in == "query" || p.in == "cookie") == p.explode {
+		param.Explode = nil
+	}
+	return param
+}
+
+// request builds the request carrying the parameter: the malformed text when there is one,
+// else the serialized value, or nothing when the parameter is absent.
+func (c hzParamCase) request() *openapi3filter.RequestValidationInput {
+	p := c.p
+	req, _ := http.NewRequest("GET", "http://example.com/things", nil)
+	input := &openapi3filter.RequestValidationInput{Request: req, PathParams: map[string]string{}}
+	switch {
+	case !c.present:
+	case c.malformed != "":
+		switch p.in {
+		case "header":
+			req.Header.Set(hzParamName, c.malformed)
+		case "query":
+			req.URL.RawQuery = url.Values{hzParamName: {c.malformed}}.Encode()
+		case "cookie":
+			req.AddCookie(&http.Cookie{Name: hzParamName, Value: c.malformed})
+		}
+	default:
+		switch p.in {
+		case "path":
+			input.PathParams[hzParamName] = p.serializeSegment()
+		case "header":
+			req.Header.Set(hzParamName, p.serializeSegment())
+		case "query":
+			req.URL.RawQuery = p.serializeQuery().Encode()
+		case "cookie":
+			req.AddCookie(&http.Cookie{Name: hzParamName, Value: p.serializeCookie()})
+		}
+	}
+	return input
+}
+
+// shapes names the recorded bug whose shape the malformed text has: a Go integer literal
+// (kin-openapi/10), a Go float literal (/11), a ParseBool spelling (/12).
+func (c hzParamCase) shapes() []string {
+	if c.malformed == "" || !c.present {
+		return nil
+	}
+	switch c.p.prim.typ {
+	case "integer":
+		return shapeIf(hzGoIntSyntax(c.malformed), "kin-openapi/10")
+	case "number":
+		return shapeIf(hzGoFloatSyntax(c.malformed), "kin-openapi/11")
+	case "boolean":
+		return shapeIf(hzBoolSpelling(c.malformed), "kin-openapi/12")
+	}
+	return nil
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hzParamCase) GoString() string {
+	param, input := c.parameter(), c.request()
+	req := input.Request
+	return fmt.Sprintf("%s (Style %q, Explode %v, Required %v) request path=%q query=%q header=%q cookie=%q",
+		c.p, param.Style, param.Explode != nil && *param.Explode, param.Required,
+		input.PathParams[hzParamName], req.URL.RawQuery, req.Header.Get(hzParamName), req.Header.Get("Cookie"))
+}
+
+// --------------------------------------------------------------------------- judge
+
+// checkParam validates the case's request against its parameter: an absent required parameter
+// is rejected and an absent optional one accepted; a malformed text is rejected; the value is
+// accepted and decoded exactly.
+func checkParam(ht *hegel.T, c *hzCollector, pc hzParamCase) {
+	p := pc.p
+	param, input := pc.parameter(), pc.request()
+	desc := pc.GoString()
+
+	hzTakeCaptures()
+	var err error
+	if pn := hzCatch(func() { err = openapi3filter.ValidateParameter(context.Background(), input, param) }); pn != nil {
+		c.failClass(ht, "panic", "%s: ValidateParameter panics: %v", desc, pn)
+		return
+	}
+	caps := hzTakeCaptures()
+	if !pc.present {
+		c.count("absent")
+		if param.Required && err == nil {
+			c.failClass(ht, "required", "%s: absent required parameter accepted", desc)
+		}
+		if !param.Required && err != nil {
+			c.failClass(ht, "absent", "%s: absent optional parameter rejected: %v", desc, err)
+		}
+		return
+	}
+	if pc.malformed != "" {
+		c.count("malformed")
+		if err == nil {
+			c.mismatch(ht, pc.shapes(), "lenient "+p.prim.typ+" "+strconv.Quote(pc.malformed), "%s: malformed %s value %q accepted as %s", desc, p.prim.typ, pc.malformed, hzCapsString(caps))
+		}
+		return
+	}
+	c.count("value")
+	if err != nil {
+		c.failClass(ht, "rejected", "%s: rejected: %s", desc, hzErrStr(err))
+		return
+	}
+	want := p.expected()
+	if !hzCapsEqual(want, caps, p.kind != "object") {
+		c.failClass(ht, "decoded", "%s: decoded %s, want %s", desc, hzCapsString(caps), hzCapsString(want))
+	}
+}
+
+// --------------------------------------------------------------------------- property
+
+func TestHegelParameters(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		checkParam(ht, c, hegel.Draw(ht, hzParamCases))
+	})
+}
diff --git a/hegel/hegel_zoo_pins2_test.go b/hegel/hegel_zoo_pins2_test.go
new file mode 100644
index 0000000..1e328b3
--- /dev/null
+++ b/hegel/hegel_zoo_pins2_test.go
@@ -0,0 +1,112 @@
+package hegel
+
+// Pins for the routers' bugs (kin-openapi/13 to /18).
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/getkin/kin-openapi/routers"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+	"github.com/getkin/kin-openapi/routers/legacy"
+)
+
+// hzPinDoc builds a document from "METHOD /template" declarations and an optional server.
+func hzPinDoc(t *testing.T, server string, decls ...string) hzDoc {
+	t.Helper()
+	d := hzDoc{methods: map[string][]string{}, server: server}
+	for _, decl := range decls {
+		f := strings.Fields(decl)
+		tmpl := hzTemplate{segs: strings.Split(strings.TrimPrefix(f[1], "/"), "/")}
+		if _, ok := d.methods[tmpl.String()]; !ok {
+			d.templates = append(d.templates, tmpl)
+		}
+		d.methods[tmpl.String()] = append(d.methods[tmpl.String()], f[0])
+	}
+	return d
+}
+
+func hzPinRoute(t *testing.T, r routers.Router, method, url string) (res hzRouteResult) {
+	t.Helper()
+	defer func() {
+		if p := recover(); p != nil {
+			res = hzRouteResult{err: "panic"}
+		}
+	}()
+	req, err := http.NewRequest(method, url, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	route, params, err := r.FindRoute(req)
+	return hzRouterResult(route, params, err)
+}
+
+func hzPinLegacy(t *testing.T, d hzDoc) routers.Router {
+	t.Helper()
+	r, err := legacy.NewRouter(d.openapi())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+// kin-openapi/13
+func TestHegelPinLegacy404ForTemplated(t *testing.T) {
+	r := hzPinLegacy(t, hzPinDoc(t, "", "GET /{x}/{name}"))
+	if got := hzPinRoute(t, r, "POST", "https://api.example.com/abc/def"); got.err != "method" {
+		t.Errorf("POST /abc/def against GET /{x}/{name}: legacy router gives %s, want error method", got)
+	}
+}
+
+// kin-openapi/14
+func TestHegelPinLegacyMethodFallsThrough(t *testing.T) {
+	r := hzPinLegacy(t, hzPinDoc(t, "", "GET /x1", "POST /{id}"))
+	if got := hzPinRoute(t, r, "POST", "https://api.example.com/x1"); got.err != "method" {
+		t.Errorf("POST /x1 against GET /x1 and POST /{id}: legacy router gives %s, want error method", got)
+	}
+}
+
+// kin-openapi/15
+func TestHegelPinLegacyTrailingVariable(t *testing.T) {
+	r := hzPinLegacy(t, hzPinDoc(t, "", "GET /a/{x}"))
+	for _, path := range []string{"/a", "/a/"} {
+		if got := hzPinRoute(t, r, "GET", "https://api.example.com"+path); got.err != "path" {
+			t.Errorf("GET %s against /a/{x}: legacy router gives %s, want error path", path, got)
+		}
+	}
+}
+
+// kin-openapi/16
+func TestHegelPinLegacyDecodesBeforeSplit(t *testing.T) {
+	r := hzPinLegacy(t, hzPinDoc(t, "", "GET /a/{x}"))
+	got := hzPinRoute(t, r, "GET", "https://api.example.com/a/b%2Fc")
+	if got.err != "" || (got.params["x"] != "b/c" && got.params["x"] != "b%2Fc") {
+		t.Errorf("GET /a/b%%2Fc against /a/{x}: legacy router gives %s, want the route with x = b/c", got)
+	}
+}
+
+// kin-openapi/17
+func TestHegelPinGorillamuxEncodedParams(t *testing.T) {
+	d := hzPinDoc(t, "", "GET /a/{x}")
+	r, err := gorillamux.NewRouter(d.openapi())
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := hzPinRoute(t, r, "GET", "https://api.example.com/a/b%20c")
+	if got.err != "" || got.params["x"] != "b c" {
+		t.Errorf("GET /a/b%%20c against /a/{x}: gorillamux router gives %s, want x = \"b c\" (the legacy router's value)", got)
+	}
+}
+
+// kin-openapi/18
+func TestHegelPinLegacyEncodedWithServers(t *testing.T) {
+	plain := hzPinRoute(t, hzPinLegacy(t, hzPinDoc(t, "", "GET /a/{x}")), "GET", "https://api.example.com/a/b%20c")
+	if plain.err != "" || plain.params["x"] != "b c" {
+		t.Errorf("without servers: legacy router gives %s, want x = \"b c\"", plain)
+	}
+	served := hzPinRoute(t, hzPinLegacy(t, hzPinDoc(t, "https://api.example.com", "GET /a/{x}")), "GET", "https://api.example.com/a/b%20c")
+	if served.err != "" || served.params["x"] != "b c" {
+		t.Errorf("with a server: legacy router gives %s, want x = \"b c\" as without servers", served)
+	}
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..06c3120
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,203 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the behaviour the specification
+// requires. They fail while the bug exists (expected failures in target.toml) and pass once it
+// is fixed, which is how the zoo notices a fix.
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+)
+
+func hzPinSchema(t *testing.T, src string) *openapi3.Schema {
+	t.Helper()
+	var s openapi3.Schema
+	if err := json.Unmarshal([]byte(src), &s); err != nil {
+		t.Fatalf("unmarshal %s: %v", src, err)
+	}
+	return &s
+}
+
+// hzPinVisit runs VisitJSON, turning a panic into an error.
+func hzPinVisit(s *openapi3.Schema, v any, opts ...openapi3.SchemaValidationOption) (err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = &openapi3.SchemaError{Reason: "panic"}
+		}
+	}()
+	return s.VisitJSON(v, opts...)
+}
+
+// kin-openapi/1
+func TestHegelPinConstNull(t *testing.T) {
+	s := hzPinSchema(t, `{"const":null}`)
+	if b, _ := json.Marshal(s); !strings.Contains(string(b), "const") {
+		t.Errorf(`{"const":null} marshals as %s: the const is lost`, b)
+	}
+	if err := hzPinVisit(s, "a"); err == nil {
+		t.Errorf(`{"const":null} accepts "a"`)
+	}
+	if err := hzPinVisit(s, nil); err != nil {
+		t.Errorf(`{"const":null} rejects null: %v`, err)
+	}
+}
+
+// kin-openapi/2
+func TestHegelPinNullableFallback2020(t *testing.T) {
+	// the same schema in the two spellings must validate alike in the JSON Schema 2020-12 mode
+	explicit := hzPinSchema(t, `{"type":["string","null"],"enum":["a"]}`)
+	nullable := hzPinSchema(t, `{"nullable":true,"type":"string","enum":["a"]}`)
+	for _, v := range []any{nil, "a", "b"} {
+		e1 := hzPinVisit(explicit, v, openapi3.EnableJSONSchema2020())
+		e2 := hzPinVisit(nullable, v, openapi3.EnableJSONSchema2020())
+		if (e1 == nil) != (e2 == nil) {
+			t.Errorf("EnableJSONSchema2020, value %#v: type [string, null] gives %v, nullable: true gives %v", v, e1, e2)
+		}
+	}
+	if err := hzPinVisit(nullable, nil, openapi3.EnableJSONSchema2020()); err == nil {
+		t.Errorf(`{"nullable":true,"type":"string","enum":["a"]} accepts null in the JSON Schema 2020-12 mode`)
+	}
+}
+
+// kin-openapi/3
+func TestHegelPinNullableTypeList2020(t *testing.T) {
+	s := hzPinSchema(t, `{"nullable":true,"type":["array","string"]}`)
+	if err := hzPinVisit(s, nil, openapi3.EnableJSONSchema2020()); err != nil {
+		t.Errorf("nullable schema with a type list rejects null in the JSON Schema 2020-12 mode: %v", err)
+	}
+	if err := hzPinVisit(s, nil); err != nil {
+		t.Errorf("built-in validator rejects null: %v", err)
+	}
+}
+
+// kin-openapi/4
+func TestHegelPinNullableSkipsKeywords(t *testing.T) {
+	for _, src := range []string{
+		`{"nullable":true,"type":"string","enum":["a"]}`,
+		`{"nullable":true,"type":"string","not":{"nullable":true,"type":"string"}}`,
+		`{"nullable":true,"type":"string","oneOf":[{"nullable":true,"type":"string"},{"nullable":true,"type":"string"}]}`,
+		`{"type":["string","null"],"enum":["a"]}`,
+	} {
+		if err := hzPinVisit(hzPinSchema(t, src), nil); err == nil {
+			t.Errorf("%s accepts null", src)
+		}
+	}
+}
+
+// kin-openapi/5
+func TestHegelPinNullBranchOverridesType(t *testing.T) {
+	for _, src := range []string{
+		`{"type":"string","anyOf":[{"type":"string","nullable":true}]}`,
+		`{"type":"integer","minimum":1,"allOf":[{"type":"integer","nullable":true}]}`,
+		`{"type":"object","oneOf":[{"type":"object","nullable":true},{"type":"string"}]}`,
+	} {
+		if err := hzPinVisit(hzPinSchema(t, src), nil); err == nil {
+			t.Errorf("%s accepts null", src)
+		}
+	}
+}
+
+// kin-openapi/6
+func TestHegelPinIntFormatOnNumber2020(t *testing.T) {
+	s := hzPinSchema(t, `{"type":"number","format":"int32"}`)
+	if err := hzPinVisit(s, 3e9); err != nil {
+		t.Errorf("built-in validator rejects 3e9: %v", err)
+	}
+	if err := hzPinVisit(s, 3e9, openapi3.EnableJSONSchema2020()); err != nil {
+		t.Errorf("JSON Schema 2020-12 mode applies the int32 format to a number: %v", err)
+	}
+}
+
+// kin-openapi/7
+func TestHegelPinInt64Overflow2020(t *testing.T) {
+	s := hzPinSchema(t, `{"type":"integer","format":"int64"}`)
+	if err := hzPinVisit(s, 1e300); err == nil {
+		t.Errorf("built-in validator accepts 1e300 as int64")
+	}
+	if err := hzPinVisit(s, 1e300, openapi3.EnableJSONSchema2020()); err == nil {
+		t.Errorf("JSON Schema 2020-12 mode accepts 1e300 as int64")
+	}
+}
+
+// kin-openapi/8
+func TestHegelPinMultipleOfSlack(t *testing.T) {
+	s := hzPinSchema(t, `{"type":"integer","multipleOf":10}`)
+	if err := hzPinVisit(s, 9007199254740990.0); err != nil {
+		t.Errorf("9007199254740990 rejected as a multiple of 10: %v", err)
+	}
+	if err := hzPinVisit(s, 9007199254740992.0); err == nil {
+		t.Errorf("9007199254740992 accepted as a multiple of 10")
+	}
+}
+
+// kin-openapi/9
+func TestHegelPinNotEmptySchema(t *testing.T) {
+	for _, src := range []string{`{"not":{}}`, `{"not":{"items":{}}}`, `{"oneOf":[{},{}]}`} {
+		if err := hzPinVisit(hzPinSchema(t, src), 10.0); err == nil {
+			t.Errorf("%s accepts 10", src)
+		}
+	}
+}
+
+// hzPinQuery validates a query parameter of the given type against the raw value.
+func hzPinQuery(t *testing.T, typ, raw string) error {
+	t.Helper()
+	req, _ := http.NewRequest("GET", "http://example.com/things?"+url.Values{"color": {raw}}.Encode(), nil)
+	s := openapi3.NewSchema()
+	s.Type = &openapi3.Types{typ}
+	param := &openapi3.Parameter{Name: "color", In: "query", Required: true, Schema: openapi3.NewSchemaRef("", s)}
+	input := &openapi3filter.RequestValidationInput{Request: req}
+	var err error
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				err = &openapi3filter.RequestError{Reason: "panic"}
+			}
+		}()
+		err = openapi3filter.ValidateParameter(context.Background(), input, param)
+	}()
+	return err
+}
+
+// kin-openapi/10
+func TestHegelPinParamIntGoSyntax(t *testing.T) {
+	if err := hzPinQuery(t, "integer", "16"); err != nil {
+		t.Errorf("integer 16 rejected: %v", err)
+	}
+	for _, raw := range []string{"0x10", "0b11", "0o17", "1_000"} {
+		if err := hzPinQuery(t, "integer", raw); err == nil {
+			t.Errorf("integer parameter accepts %q", raw)
+		}
+	}
+}
+
+// kin-openapi/11
+func TestHegelPinParamFloatGoSyntax(t *testing.T) {
+	if err := hzPinQuery(t, "number", "0.25"); err != nil {
+		t.Errorf("number 0.25 rejected: %v", err)
+	}
+	for _, raw := range []string{"0x1p-2", "0X1P2", "1_0.5"} {
+		if err := hzPinQuery(t, "number", raw); err == nil {
+			t.Errorf("number parameter accepts %q", raw)
+		}
+	}
+}
+
+// kin-openapi/12
+func TestHegelPinParamBoolSpellings(t *testing.T) {
+	if err := hzPinQuery(t, "boolean", "true"); err != nil {
+		t.Errorf("boolean true rejected: %v", err)
+	}
+	for _, raw := range []string{"1", "0", "t", "f", "T", "F", "TRUE", "FALSE", "True", "False"} {
+		if err := hzPinQuery(t, "boolean", raw); err == nil {
+			t.Errorf("boolean parameter accepts %q", raw)
+		}
+	}
+}
diff --git a/hegel/hegel_zoo_routers_test.go b/hegel/hegel_zoo_routers_test.go
new file mode 100644
index 0000000..bf09c47
--- /dev/null
+++ b/hegel/hegel_zoo_routers_test.go
@@ -0,0 +1,600 @@
+package hegel
+
+// TestHegelRouters: a generated document (path templates of literal and variable segments,
+// operations, optionally a server with a base path) and generated requests; the legacy and
+// the gorillamux routers must find the route the OpenAPI 3.0.3 path matching rules give (a
+// template matches a path of the same number of segments, literal segments equal, a variable
+// taking one non-empty segment; a concrete path wins over templated ones), with the path
+// parameters' values, and report a missing path or a missing method as the rules say. A case
+// is one record (hzRouterCase): the document and one to four requests, each an instance of one
+// of its templates (the template and the segment values are indices and pools applied modulo
+// the live document) or random segments. The shapes of the recorded router bugs
+// (kin-openapi/13 to /18) are drawn at their natural rate and named on a mismatch; under
+// HEGEL_NO_KNOWN=1 the legacy comparison is skipped where only a recorded bug can fail it and
+// the routers' parameter values are decoded before the comparison, as the old test did.
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+	"github.com/getkin/kin-openapi/routers/legacy"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- templates
+
+var (
+	hzLiterals  = []string{"a", "b", "items", "x1", "v2", "a-b", "A"}
+	hzVarNames  = []string{"id", "name", "x"}
+	hzMethods   = []string{"GET", "POST", "PUT", "DELETE", "PATCH"}
+	hzSegValues = []string{"1", "abc", "x", "a-b", "A", "items", "b", "a.b", "a%20b", "%2F", "a%25b", "..", "~", "a+b", "%C3%A9", "x.json"}
+	// hzServers: none half of the time, else a base path or a bare host
+	hzServers = []string{"", "", "https://api.example.com/v1", "https://api.example.com"}
+)
+
+type hzTemplate struct {
+	segs []string // literal, or "{name}"
+}
+
+func (t hzTemplate) String() string { return "/" + strings.Join(t.segs, "/") }
+
+func (t hzTemplate) vars() []string {
+	var out []string
+	for _, s := range t.segs {
+		if strings.HasPrefix(s, "{") {
+			out = append(out, s[1:len(s)-1])
+		}
+	}
+	return out
+}
+
+// match applies the matching rule to decoded path segments.
+func (t hzTemplate) match(segs []string) (map[string]string, bool) {
+	if len(segs) != len(t.segs) {
+		return nil, false
+	}
+	params := map[string]string{}
+	for i, s := range t.segs {
+		if strings.HasPrefix(s, "{") {
+			if segs[i] == "" {
+				return nil, false
+			}
+			params[s[1:len(s)-1]] = segs[i]
+		} else if s != segs[i] {
+			return nil, false
+		}
+	}
+	return params, true
+}
+
+func (t hzTemplate) concrete() bool { return len(t.vars()) == 0 }
+
+func (t hzTemplate) shape() string {
+	var segs []string
+	for _, s := range t.segs {
+		if strings.HasPrefix(s, "{") {
+			s = "{}"
+		}
+		segs = append(segs, s)
+	}
+	return "/" + strings.Join(segs, "/")
+}
+
+// uniqueVars is the template of the segments with a repeated variable name suffixed ({id},
+// {id2}, {id22}): a template names each variable once.
+func uniqueVars(segs []string) hzTemplate {
+	out := make([]string, len(segs))
+	used := map[string]bool{}
+	for i, s := range segs {
+		if strings.HasPrefix(s, "{") {
+			v := s[1 : len(s)-1]
+			for used[v] {
+				v += "2"
+			}
+			used[v] = true
+			s = "{" + v + "}"
+		}
+		out[i] = s
+	}
+	return hzTemplate{out}
+}
+
+var (
+	hzLiteral  = hegel.SampledFrom(hzLiterals)
+	hzVariable = hegel.Map(hegel.SampledFrom(hzVarNames), func(v string) string { return "{" + v + "}" })
+	// hzSegments: one to three segments, a literal 60% and a variable 40% of the time
+	hzSegments  = many(weighted(choice[string]{60, hzLiteral}, choice[string]{40, hzVariable}), 1, 3)
+	hzTemplates = hegel.Map(hzSegments, uniqueVars)
+	// hzMethodSets: the distinct methods drawn, GET when none
+	hzMethodSets = hegel.Map(many(hegel.SampledFrom(hzMethods), 0, 5), func(ms []string) []string {
+		if ms = distinct(ms); len(ms) == 0 {
+			return []string{"GET"}
+		}
+		return ms
+	})
+)
+
+// hzPathItem: a template and the methods its path item declares.
+type hzPathItem struct {
+	tmpl    hzTemplate
+	methods []string
+}
+
+var hzPathItems = hegel.Composite(func(tc hegel.TestCase) hzPathItem {
+	return hzPathItem{tmpl: hegel.Draw(tc, hzTemplates), methods: hegel.Draw(tc, hzMethodSets)}
+})
+
+// --------------------------------------------------------------------------- documents
+
+type hzDoc struct {
+	templates []hzTemplate
+	methods   map[string][]string // template -> methods
+	server    string              // "" for none
+}
+
+// docOf is the document of the items and the server; a later item whose template has the
+// shape of an earlier one is dropped (templates of one shape, variable names aside, are the
+// same path, and the document would be invalid).
+func docOf(items []hzPathItem, server string) hzDoc {
+	d := hzDoc{methods: map[string][]string{}, server: server}
+	seen := map[string]bool{}
+	for _, it := range items {
+		if seen[it.tmpl.shape()] {
+			continue
+		}
+		seen[it.tmpl.shape()] = true
+		d.templates = append(d.templates, it.tmpl)
+		d.methods[it.tmpl.String()] = it.methods
+	}
+	return d
+}
+
+var hzDocs = hegel.Map(pairs(many(hzPathItems, 1, 4), hegel.SampledFrom(hzServers)), func(p pair[[]hzPathItem, string]) hzDoc {
+	return docOf(p.a, p.b)
+})
+
+func (d hzDoc) openapi() *openapi3.T {
+	doc := &openapi3.T{
+		OpenAPI: "3.0.3",
+		Info:    &openapi3.Info{Title: "hz", Version: "1"},
+		Paths:   openapi3.NewPaths(),
+	}
+	if d.server != "" {
+		doc.Servers = openapi3.Servers{{URL: d.server}}
+	}
+	for _, t := range d.templates {
+		item := &openapi3.PathItem{}
+		for _, v := range t.vars() {
+			item.Parameters = append(item.Parameters, &openapi3.ParameterRef{Value: &openapi3.Parameter{
+				Name: v, In: "path", Required: true, Schema: openapi3.NewSchemaRef("", openapi3.NewStringSchema()),
+			}})
+		}
+		for _, m := range d.methods[t.String()] {
+			op := &openapi3.Operation{Responses: openapi3.NewResponses(openapi3.WithStatus(200, &openapi3.ResponseRef{Value: openapi3.NewResponse().WithDescription("ok")}))}
+			item.SetOperation(m, op)
+		}
+		doc.Paths.Set(t.String(), item)
+	}
+	return doc
+}
+
+func (d hzDoc) String() string {
+	var parts []string
+	for _, t := range d.templates {
+		parts = append(parts, fmt.Sprintf("%s %v", t, d.methods[t.String()]))
+	}
+	return fmt.Sprintf("doc [%s] server %q", strings.Join(parts, ", "), d.server)
+}
+
+// --------------------------------------------------------------------------- requests
+
+// hzRequest: a request: with random empty, an instance of the tmpl-th template of the document
+// (modulo their number) whose variables take the vals in turn (recycled), followed by the
+// extra segment when it is not empty, and by a slash when slash is set; else the random
+// segments.
+type hzRequest struct {
+	method string
+	tmpl   int
+	vals   []string
+	extra  string
+	slash  bool
+	random []string
+}
+
+var (
+	hzMethod   = hegel.SampledFrom(hzMethods)
+	hzSegValue = hegel.SampledFrom(hzSegValues)
+	// hzInstances: an instance of a template, with one more segment 15% of the time and a
+	// trailing slash 10% of the time
+	hzInstances = hegel.Composite(func(tc hegel.TestCase) hzRequest {
+		return hzRequest{
+			method: hegel.Draw(tc, hzMethod),
+			tmpl:   hegel.Draw(tc, positions),
+			vals:   hegel.Draw(tc, many(hzSegValue, 1, 3)),
+			extra:  hegel.Draw(tc, maybe(15, hzSegValue)),
+			slash:  hegel.Draw(tc, chance(10)),
+		}
+	})
+	// hzRandomRequests: one to three literal or value segments
+	hzRandomRequests = hegel.Composite(func(tc hegel.TestCase) hzRequest {
+		return hzRequest{
+			method: hegel.Draw(tc, hzMethod),
+			random: hegel.Draw(tc, many(hegel.SampledFrom(append(append([]string{}, hzLiterals...), hzSegValues...)), 1, 3)),
+		}
+	})
+	hzRequests = weighted(choice[hzRequest]{75, hzInstances}, choice[hzRequest]{25, hzRandomRequests})
+)
+
+// rawSegs renders the request's path segments against the document (percent-encoded as sent).
+func (d hzDoc) rawSegs(r hzRequest) []string {
+	if len(r.random) > 0 {
+		return r.random
+	}
+	t := d.templates[r.tmpl%len(d.templates)]
+	var segs []string
+	n := 0
+	for _, s := range t.segs {
+		if strings.HasPrefix(s, "{") {
+			segs = append(segs, r.vals[n%len(r.vals)])
+			n++
+		} else {
+			segs = append(segs, s)
+		}
+	}
+	if r.extra != "" {
+		segs = append(segs, r.extra)
+	}
+	if r.slash {
+		segs = append(segs, "")
+	}
+	return segs
+}
+
+// hzRouterCase: a document and the requests routed against it.
+type hzRouterCase struct {
+	doc  hzDoc
+	reqs []hzRequest
+}
+
+var hzRouterCases = func() hegel.Generator[hzRouterCase] {
+	cases := hegel.Composite(func(tc hegel.TestCase) hzRouterCase {
+		return hzRouterCase{doc: hegel.Draw(tc, hzDocs), reqs: hegel.Draw(tc, many(hzRequests, 1, 4))}
+	})
+	if noKnown {
+		return hegel.Map(cases, pastKnownRoutes)
+	}
+	return cases
+}()
+
+var hzUnslashed = strings.NewReplacer("%2F", "%20", "%2f", "%20")
+
+func unslashed(segs []string) []string {
+	out := make([]string, len(segs))
+	for i, s := range segs {
+		out[i] = hzUnslashed.Replace(s)
+	}
+	return out
+}
+
+// pastKnownRoutes takes the recorded legacy-router bugs' shapes out of a drawn case (applied
+// only under HEGEL_NO_KNOWN=1), keeping each request judged by both routers: a percent-encoded
+// slash becomes an encoded space (kin-openapi/16), a trailing slash goes (/15), a request whose
+// method the matched path item lacks takes one of the item's methods when the matched path is
+// templated or several paths match (/13, /14), and a request whose path is a template's prefix
+// is dropped (/15).
+func pastKnownRoutes(c hzRouterCase) hzRouterCase {
+	var reqs []hzRequest
+	for _, r := range c.reqs {
+		r.slash = false
+		r.vals, r.random, r.extra = unslashed(r.vals), unslashed(r.random), hzUnslashed.Replace(r.extra)
+		raw := c.doc.rawSegs(r)
+		if c.doc.prefixOfTrailingVariable(raw) {
+			continue
+		}
+		if want, ambiguous := c.doc.model(r.method, raw); !ambiguous && want.err == "method" && (c.doc.matchedHasVars(raw) || c.doc.countMatches(raw) > 1) {
+			methods := c.doc.methods[c.doc.matchedTemplate(raw).String()]
+			r.method = methods[r.tmpl%len(methods)]
+		}
+		reqs = append(reqs, r)
+	}
+	c.reqs = reqs
+	return c
+}
+
+// matchedTemplate is the template the rules pick for the path (the concrete one, else the one
+// templated match); the caller knows one exists.
+func (d hzDoc) matchedTemplate(rawSegs []string) hzTemplate {
+	segs := d.decodedSegs(rawSegs)
+	var found hzTemplate
+	for _, t := range d.templates {
+		if _, ok := t.match(segs); ok {
+			if t.concrete() {
+				return t
+			}
+			found = t
+		}
+	}
+	return found
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hzRouterCase) GoString() string {
+	var reqs []string
+	for _, r := range c.reqs {
+		reqs = append(reqs, r.method+" /"+strings.Join(c.doc.rawSegs(r), "/"))
+	}
+	return fmt.Sprintf("%s requests %v", c.doc, reqs)
+}
+
+// --------------------------------------------------------------------------- model
+
+type hzRouteResult struct {
+	template string
+	params   map[string]string
+	err      string // "", "path", "method"
+}
+
+func (r hzRouteResult) String() string {
+	if r.err != "" {
+		return "error " + r.err
+	}
+	keys := make([]string, 0, len(r.params))
+	for k := range r.params {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var parts []string
+	for _, k := range keys {
+		parts = append(parts, k+"="+r.params[k])
+	}
+	return fmt.Sprintf("%s {%s}", r.template, strings.Join(parts, " "))
+}
+
+// hzModelRoute applies the rules; ambiguous says whether several templates match with no
+// concrete one among them (the specification leaves that undefined).
+func (d hzDoc) model(method string, rawSegs []string) (res hzRouteResult, ambiguous bool) {
+	segs := d.decodedSegs(rawSegs)
+	var matches []hzTemplate
+	var paramsOf []map[string]string
+	for _, t := range d.templates {
+		if p, ok := t.match(segs); ok {
+			matches = append(matches, t)
+			paramsOf = append(paramsOf, p)
+		}
+	}
+	if len(matches) == 0 {
+		return hzRouteResult{err: "path"}, false
+	}
+	idx := 0
+	if len(matches) > 1 {
+		idx = -1
+		for i, t := range matches {
+			if t.concrete() {
+				idx = i
+			}
+		}
+		if idx < 0 {
+			return hzRouteResult{}, true
+		}
+	}
+	t := matches[idx]
+	for _, m := range d.methods[t.String()] {
+		if m == method {
+			return hzRouteResult{template: t.String(), params: paramsOf[idx]}, false
+		}
+	}
+	return hzRouteResult{err: "method"}, false
+}
+
+func hzKindOf(r hzRouteResult) string {
+	if r.err != "" {
+		return r.err
+	}
+	return "route"
+}
+
+func (d hzDoc) decodedSegs(rawSegs []string) []string {
+	segs := make([]string, len(rawSegs))
+	for i, s := range rawSegs {
+		segs[i], _ = url.PathUnescape(s)
+	}
+	return segs
+}
+
+// matchedHasVars says whether a matching template (the concrete one if any) has variables.
+func (d hzDoc) matchedHasVars(rawSegs []string) bool {
+	segs := d.decodedSegs(rawSegs)
+	hasVars := false
+	for _, t := range d.templates {
+		if _, ok := t.match(segs); ok {
+			if t.concrete() {
+				return false
+			}
+			hasVars = true
+		}
+	}
+	return hasVars
+}
+
+func (d hzDoc) countMatches(rawSegs []string) int {
+	segs := d.decodedSegs(rawSegs)
+	n := 0
+	for _, t := range d.templates {
+		if _, ok := t.match(segs); ok {
+			n++
+		}
+	}
+	return n
+}
+
+// prefixOfTrailingVariable says whether the path, its trailing slash dropped, is a template
+// minus its final variable segments (one or more), or a template's instance with a trailing
+// slash.
+func (d hzDoc) prefixOfTrailingVariable(rawSegs []string) bool {
+	segs := d.decodedSegs(rawSegs)
+	slash := len(segs) > 0 && segs[len(segs)-1] == ""
+	if slash {
+		segs = segs[:len(segs)-1]
+	}
+	for _, t := range d.templates {
+		if _, ok := t.match(segs); ok && slash {
+			return true
+		}
+		for n := len(t.segs); n >= 1 && strings.HasPrefix(t.segs[n-1], "{"); n-- {
+			if _, ok := (hzTemplate{t.segs[:n-1]}).match(segs); ok {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// legacyShapes names the recorded legacy-router bugs whose shape the request has: a missing
+// method on a templated path (kin-openapi/13), a missing method on a concrete path another
+// template matches (/14), a template's prefix or an instance with a trailing slash (/15), a
+// percent-encoded slash (/16).
+func (d hzDoc) legacyShapes(rawSegs []string, want hzRouteResult) []string {
+	var shapes []string
+	shapes = append(shapes, shapeIf(want.err == "method" && d.matchedHasVars(rawSegs), "kin-openapi/13")...)
+	shapes = append(shapes, shapeIf(want.err == "method" && d.countMatches(rawSegs) > 1, "kin-openapi/14")...)
+	shapes = append(shapes, shapeIf(d.prefixOfTrailingVariable(rawSegs), "kin-openapi/15")...)
+	shapes = append(shapes, shapeIf(strings.Contains(strings.ToLower(strings.Join(rawSegs, "/")), "%2f"), "kin-openapi/16")...)
+	return shapes
+}
+
+// decodedParams is the result with every parameter value percent-decoded.
+func decodedParams(r hzRouteResult) hzRouteResult {
+	if r.err != "" {
+		return r
+	}
+	out := hzRouteResult{template: r.template, params: map[string]string{}}
+	for k, v := range r.params {
+		if dv, err := url.PathUnescape(v); err == nil {
+			v = dv
+		}
+		out.params[k] = v
+	}
+	return out
+}
+
+func hzRouterResult(route *routers.Route, params map[string]string, err error) hzRouteResult {
+	if err != nil {
+		msg := err.Error()
+		var re *routers.RouteError
+		if errors.As(err, &re) {
+			msg = re.Reason
+		}
+		switch {
+		case strings.Contains(msg, routers.ErrPathNotFound.Error()):
+			return hzRouteResult{err: "path"}
+		case strings.Contains(msg, routers.ErrMethodNotAllowed.Error()):
+			return hzRouteResult{err: "method"}
+		}
+		return hzRouteResult{err: "other: " + msg}
+	}
+	return hzRouteResult{template: route.Path, params: params}
+}
+
+// --------------------------------------------------------------------------- judge
+
+// checkRoutes builds both routers for the case's document and routes each request through
+// them, comparing with the model; a request several templated paths match with no concrete
+// one is a no-op step (undefined by the specification).
+func checkRoutes(ht *hegel.T, c *hzCollector, rc hzRouterCase) {
+	d := rc.doc
+	doc := d.openapi()
+	var lr, gr routers.Router
+	var lerr, gerr error
+	if p := hzCatch(func() { lr, lerr = legacy.NewRouter(doc) }); p != nil {
+		c.failClass(ht, "panic", "%s: legacy.NewRouter panics: %v", d, p)
+		return
+	}
+	if p := hzCatch(func() { gr, gerr = gorillamux.NewRouter(doc) }); p != nil {
+		c.failClass(ht, "panic", "%s: gorillamux.NewRouter panics: %v", d, p)
+		return
+	}
+	if lerr != nil || gerr != nil {
+		c.failClass(ht, "new router", "%s: legacy %v, gorillamux %v", d, lerr, gerr)
+		return
+	}
+	base := ""
+	if d.server != "" {
+		u, _ := url.Parse(d.server)
+		base = u.Path
+	}
+	for _, r := range rc.reqs {
+		rawSegs := d.rawSegs(r)
+		rawPath := "/" + strings.Join(rawSegs, "/")
+		req, err := http.NewRequest(r.method, "https://api.example.com"+base+rawPath, nil)
+		if err != nil {
+			c.count("unparsable url")
+			continue
+		}
+		want, ambiguous := d.model(r.method, rawSegs)
+		if ambiguous {
+			c.count("ambiguous")
+			continue
+		}
+		c.count("expect " + hzKindOf(want))
+		desc := fmt.Sprintf("%s request %s %s", d, r.method, req.URL)
+
+		var lroute, groute *routers.Route
+		var lparams, gparams map[string]string
+		if p := hzCatch(func() { lroute, lparams, lerr = lr.FindRoute(req) }); p != nil {
+			c.failClass(ht, "panic", "%s: legacy FindRoute panics: %v", desc, p)
+			return
+		}
+		if p := hzCatch(func() { groute, gparams, gerr = gr.FindRoute(req) }); p != nil {
+			c.failClass(ht, "panic", "%s: gorillamux FindRoute panics: %v", desc, p)
+			return
+		}
+		lgot := hzRouterResult(lroute, lparams, lerr)
+		ggot := hzRouterResult(groute, gparams, gerr)
+
+		lshapes := d.legacyShapes(rawSegs, want)
+		compareLegacy := true
+		if noKnown && len(lshapes) > 0 {
+			// only a recorded bug can fail the legacy comparison here
+			c.count("legacy skipped")
+			compareLegacy = false
+		}
+		var gshapes []string
+		if noKnown {
+			// the routers hand out percent-encoded segments (kin-openapi/17, and /18 with servers)
+			ggot = decodedParams(ggot)
+			if d.server != "" {
+				lgot = decodedParams(lgot)
+			}
+		} else {
+			if d.server != "" && lgot.String() != want.String() && decodedParams(lgot).String() == want.String() {
+				lshapes = append(lshapes, "kin-openapi/18")
+			}
+			if ggot.String() != want.String() && decodedParams(ggot).String() == want.String() {
+				gshapes = append(gshapes, "kin-openapi/17")
+			}
+		}
+		if compareLegacy && lgot.String() != want.String() {
+			c.mismatch(ht, lshapes, "legacy "+hzKindOf(want)+" got "+hzKindOf(lgot), "%s: legacy %s, want %s", desc, lgot, want)
+		}
+		if ggot.String() != want.String() {
+			c.mismatch(ht, gshapes, "gorillamux "+hzKindOf(want)+" got "+hzKindOf(ggot), "%s: gorillamux %s, want %s", desc, ggot, want)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- property
+
+func TestHegelRouters(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		checkRoutes(ht, c, hegel.Draw(ht, hzRouterCases))
+	})
+}
diff --git a/hegel/hegel_zoo_schema_test.go b/hegel/hegel_zoo_schema_test.go
new file mode 100644
index 0000000..8cb9c0c
--- /dev/null
+++ b/hegel/hegel_zoo_schema_test.go
@@ -0,0 +1,1313 @@
+package hegel
+
+// TestHegelSchema: generated OpenAPI schemas (3.0 keywords, some 3.1 spellings) against
+// generated JSON values. The built-in validator (Schema.VisitJSON) and the JSON Schema 2020-12
+// mode (EnableJSONSchema2020) must agree with the Python `jsonschema` package on the schema
+// translated to JSON Schema 2020-12 by the OpenAPI 3.0.3 rules (nullable adds "null" to the
+// type, the boolean exclusive bounds modify minimum/maximum, null is not a value unless the
+// schema permits it, the registered formats). MultiErrors() and FailFast() must not change the
+// verdict, and the schema must survive a JSON round trip.
+//
+// A case is one record (hzSchemaCase): the 3.1 flag, a schema drawn from a grammar built once
+// per flag and depth bound (a schema object is a type and the keyword fragments of that type,
+// each present some of the time, its sub-schemas drawn from the grammar again, bound levels
+// deep), and one to four values drawn from a generator built from the schema (shaped after its
+// type, enum, const, combinators, properties, items and bounds, with deviations, or free 15% of
+// the time). The shapes of the recorded validator bugs (kin-openapi/1 to /9) are drawn at their
+// natural rate and named on a mismatch; under HEGEL_NO_KNOWN=1 pastKnown takes them out of
+// the drawn schema and the two checks only a bug can fail are skipped by name.
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- python oracle
+
+const hzOracleScript = `
+import json, sys
+from jsonschema import Draft202012Validator
+from jsonschema.exceptions import SchemaError
+
+for line in sys.stdin:
+    line = line.strip()
+    if not line:
+        continue
+    req = json.loads(line)
+    out = {}
+    try:
+        v = Draft202012Validator(req["schema"])
+        errs = list(v.iter_errors(req["instance"]))
+        out["valid"] = not errs
+        if errs:
+            e = errs[0]
+            out["error"] = "%s at %s" % (e.message, "/".join(str(p) for p in e.absolute_path))
+    except SchemaError as e:
+        out["schemaError"] = str(e)
+    except RecursionError as e:
+        out["schemaError"] = "recursion: " + str(e)
+    except Exception as e:
+        out["schemaError"] = "%s: %s" % (type(e).__name__, e)
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+type hzOracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+type hzOracleReply struct {
+	Valid       bool   `json:"valid"`
+	Error       string `json:"error"`
+	SchemaError string `json:"schemaError"`
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+func (o *hzOracle) validate(schema, instance any) (hzOracleReply, error) {
+	req, err := json.Marshal(map[string]any{"schema": schema, "instance": instance})
+	if err != nil {
+		return hzOracleReply{}, err
+	}
+	o.in.Write(req)
+	o.in.WriteByte('\n')
+	if err := o.in.Flush(); err != nil {
+		return hzOracleReply{}, err
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		return hzOracleReply{}, fmt.Errorf("oracle: %v", err)
+	}
+	var r hzOracleReply
+	if err := json.Unmarshal(line, &r); err != nil {
+		return hzOracleReply{}, fmt.Errorf("oracle reply %q: %v", line, err)
+	}
+	return r, nil
+}
+
+// --------------------------------------------------------------------------- pools
+
+// hzSchema is a schema as a JSON object (the generator's product; unmarshalled into
+// openapi3.Schema for the library and translated for the oracle).
+type hzSchema = map[string]any
+
+var (
+	hzTypes     = []string{"string", "integer", "number", "boolean", "array", "object"}
+	hzPropNames = []string{"a", "b", "c", "d"}
+	hzPatterns  = []string{`^[a-c]+$`, `^[0-9]{2}$`, `a|b`, `^x.*y$`, `[A-Z]`, `^$`, `(ab)+`, `^[^a-z]*$`}
+	hzStrFmts   = []string{"date", "date-time", "byte", "email", "uuid"}
+	hzStrPool   = []string{"", "a", "b", "ab", "abc", "x1y", "XY", "42", "2020-02-30", "2021-12-31",
+		"2021-12-31T23:59:60Z", "2021-12-31T23:59:59.5+01:00", "aGVsbG8=", "u/w+x==", "héllo", "日本",
+		"\U0001F600", "a\U0001F600b", "\U0001F600\U0001F601", "é́", " ", "\t", "\n", "a b", "abab", "AB"}
+	hzStrChars  = []string{"a", "b", "c", "0", "9", "X", "\U0001F600", "é", "-"}
+	hzNumPool   = []float64{0, 1, -1, 2, 3, 5, 10, -10, 0.5, -0.5, 1.5, 2.5, 0.25, 100, 1e10, 1e300, -1e300, 4503599627370497, 9007199254740992, 0.1, 0.3, 1e-300, 2147483647, 2147483648, -2147483648, -2147483649}
+	hzMultiples = []float64{1, 2, 3, 5, 10, 0.5, 0.25}
+	// hzIntMultiples: the multiples an integer schema takes (a fraction is not a divisor of integers)
+	hzIntMultiples   = []float64{1, 2, 3, 5, 10}
+	hzFractions      = []float64{0.5, 0.25, 0.1, -0.5}
+	hzBoundDeltas    = []float64{0, 0, 1, -1, 0.5, -0.5}
+	hzMultipleShifts = []float64{0.5, 1, 0.25}
+	hzXofKeys        = []string{"oneOf", "anyOf", "allOf"}
+	hzExtraNames     = []string{"a", "b", "c", "d", "extra", "z"}
+)
+
+var (
+	hzTypeName = hegel.SampledFrom(hzTypes)
+	hzPropName = hegel.SampledFrom(hzPropNames)
+	// hzStrings: a pool string, or one time in five up to five characters of a small alphabet
+	hzStrings = weighted(
+		choice[string]{80, hegel.SampledFrom(hzStrPool)},
+		choice[string]{20, hegel.Map(many(hegel.SampledFrom(hzStrChars), 0, 5), func(cs []string) string { return strings.Join(cs, "") })},
+	)
+)
+
+// numbersOf: half of the time a small integer (-12 to 12; with a fraction 40% of the time
+// when numbers are wanted), else a pool number (truncated for integers).
+func numbersOf(integer bool) hegel.Generator[float64] {
+	small := hegel.Map(hegel.Integers(-12, 12), func(n int) float64 { return float64(n) })
+	if !integer {
+		small = hegel.Map(pairs(hegel.Integers(-12, 12), maybe(40, hegel.SampledFrom(hzFractions))), func(p pair[int, float64]) float64 { return float64(p.a) + p.b })
+	}
+	pool := hegel.SampledFrom(hzNumPool)
+	if integer {
+		pool = hegel.Map(pool, math.Trunc)
+	}
+	return weighted(choice[float64]{50, small}, choice[float64]{50, pool})
+}
+
+var (
+	hzIntegers = numbersOf(true)
+	hzNumbers  = numbersOf(false)
+)
+
+// --------------------------------------------------------------------------- values
+
+// hzFreeValues[d]: a JSON value with collections nesting d deep (integers below): null, a
+// boolean, a number, an integer, a string, an array of up to three values or an object of up to
+// three distinct names, once each.
+var hzFreeValues = func() []hegel.Generator[any] {
+	gens := make([]hegel.Generator[any], 4)
+	for d := range gens {
+		elem := asAny(hzIntegers)
+		if d > 0 {
+			elem = gens[d-1]
+		}
+		gens[d] = hegel.OneOf(
+			hegel.Just[any](nil),
+			asAny(hegel.Booleans()),
+			asAny(hzNumbers),
+			asAny(hzIntegers),
+			asAny(hzStrings),
+			hegel.Map(many(elem, 0, 3), func(xs []any) any { return nonNil(xs) }),
+			hegel.Map(hegel.Maps(hzPropName, elem).MaxSize(3), func(m map[string]any) any { return nonNilMap(m) }),
+		)
+	}
+	return gens
+}()
+
+func freeValuesAt(depth int) hegel.Generator[any] {
+	return hzFreeValues[max(0, min(depth, len(hzFreeValues)-1))]
+}
+
+// valuesOf: a JSON value shaped by the schema (type, enum, const, combinators, properties,
+// items, bounds) with random deviations, so that valid and invalid values both come up, or a
+// free value 15% of the time (always for no schema).
+func valuesOf(s hzSchema, depth int) hegel.Generator[any] {
+	free := freeValuesAt(depth)
+	if s == nil {
+		return free
+	}
+	return weighted(choice[any]{15, free}, choice[any]{85, guidedValues(s, depth)})
+}
+
+// guidedValues: one of the schema's enum members 60% of the time, else its const 60% of the
+// time, else a value of one of its combinators' branches half of the time, else a value of its
+// type.
+func guidedValues(s hzSchema, depth int) hegel.Generator[any] {
+	g := typedValues(s, depth)
+	var branches []hegel.Generator[any]
+	for _, key := range hzXofKeys {
+		if subs, ok := s[key].([]any); ok {
+			for _, sub := range subs {
+				branches = append(branches, valuesOf(sub.(hzSchema), depth))
+			}
+		}
+	}
+	if len(branches) > 0 {
+		g = weighted(choice[any]{50, hegel.OneOf(branches...)}, choice[any]{50, g})
+	}
+	if c, ok := s["const"]; ok {
+		g = weighted(choice[any]{60, hegel.Map(hegel.Just(c), hzCopyJSON)}, choice[any]{40, g})
+	}
+	if enum, ok := s["enum"].([]any); ok && len(enum) > 0 {
+		g = weighted(choice[any]{60, hegel.Map(hegel.SampledFrom(enum), hzCopyJSON)}, choice[any]{40, g})
+	}
+	return g
+}
+
+// typedValues: a value of one of the schema's types (any type, or null, when it names none),
+// null 8% of the time below the top level.
+func typedValues(s hzSchema, depth int) hegel.Generator[any] {
+	var types []string
+	switch t := s["type"].(type) {
+	case string:
+		types = []string{t}
+	case []any:
+		for _, x := range t {
+			types = append(types, x.(string))
+		}
+	}
+	if len(types) == 0 {
+		types = append(append([]string{}, hzTypes...), "null")
+	}
+	arms := make([]hegel.Generator[any], len(types))
+	for i, t := range types {
+		arms[i] = ofType(t, s, depth)
+	}
+	g := hegel.OneOf(arms...)
+	if depth > 0 {
+		g = weighted(choice[any]{8, hegel.Just[any](nil)}, choice[any]{92, g})
+	}
+	return g
+}
+
+// ofType: a value of the named type shaped after the schema.
+func ofType(t string, s hzSchema, depth int) hegel.Generator[any] {
+	switch t {
+	case "null":
+		return hegel.Just[any](nil)
+	case "string":
+		return asAny(hzStrings)
+	case "integer":
+		return asAny(boundedValues(s, true))
+	case "number":
+		return asAny(boundedValues(s, false))
+	case "boolean":
+		return asAny(hegel.Booleans())
+	case "array":
+		return arraysOf(s, depth)
+	}
+	return objectsOf(s, depth)
+}
+
+// boundedValues: a number half of the time, else one at or next to a bound of the schema or a
+// multiple of its multipleOf (off by a fraction 30% of the time), rounded for integers.
+func boundedValues(s hzSchema, integer bool) hegel.Generator[float64] {
+	round := func(v float64) float64 {
+		if integer {
+			return math.Round(v)
+		}
+		return v
+	}
+	plain := numbersOf(integer)
+	var near []hegel.Generator[float64]
+	for _, key := range []string{"minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum"} {
+		if b, ok := s[key].(float64); ok {
+			near = append(near, hegel.Map(hegel.SampledFrom(hzBoundDeltas), func(d float64) float64 { return round(b + d) }))
+		}
+	}
+	if m, ok := s["multipleOf"].(float64); ok {
+		near = append(near, hegel.Map(pairs(hegel.Integers(-6, 6), maybe(30, hegel.SampledFrom(hzMultipleShifts))), func(p pair[int, float64]) float64 {
+			return round(m*float64(p.a) + p.b)
+		}))
+	}
+	if len(near) == 0 {
+		return plain
+	}
+	return weighted(choice[float64]{50, plain}, choice[float64]{50, hegel.OneOf(near...)})
+}
+
+// arraysOf: up to four items shaped after the schema's items (integers at the depth bound),
+// each followed by a copy of itself 25% of the time (duplicates for uniqueItems).
+func arraysOf(s hzSchema, depth int) hegel.Generator[any] {
+	elem := asAny(hzIntegers)
+	if depth > 0 {
+		items, _ := s["items"].(hzSchema)
+		elem = valuesOf(items, depth-1)
+	}
+	return hegel.Map(many(pairs(elem, chance(25)), 0, 4), func(ps []pair[any, bool]) any {
+		arr := make([]any, 0, len(ps))
+		for _, p := range ps {
+			arr = append(arr, p.a)
+			if p.b {
+				arr = append(arr, hzCopyJSON(p.a))
+			}
+		}
+		return arr
+	})
+}
+
+// objectsOf: each property 75% of the time, shaped after its schema (integers at the depth
+// bound), and up to two more names with free values.
+func objectsOf(s hzSchema, depth int) hegel.Generator[any] {
+	props, _ := s["properties"].(hzSchema)
+	names := sortedKeys(props)
+	leaf := asAny(hzIntegers)
+	propGens := make([]hegel.Generator[*any], len(names))
+	for i, k := range names {
+		g := leaf
+		if depth > 0 {
+			g = valuesOf(props[k].(hzSchema), depth-1)
+		}
+		propGens[i] = optional(75, g)
+	}
+	extra := leaf
+	if depth > 0 {
+		extra = freeValuesAt(depth - 1)
+	}
+	extras := hegel.Maps(hegel.SampledFrom(hzExtraNames), extra).MaxSize(2)
+	return hegel.Composite(func(tc hegel.TestCase) any {
+		obj := map[string]any{}
+		for i, k := range names {
+			if v := hegel.Draw(tc, propGens[i]); v != nil {
+				obj[k] = *v
+			}
+		}
+		for k, v := range hegel.Draw(tc, extras) {
+			if _, dup := obj[k]; !dup {
+				obj[k] = v
+			}
+		}
+		return obj
+	})
+}
+
+func hzCopyJSON(v any) any {
+	switch v := v.(type) {
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = hzCopyJSON(x)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = hzCopyJSON(x)
+		}
+		return out
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- schemas
+
+// hzTypeSpec: a schema's type: none (typ ""), one type, or (3.1) a list of typ and other.
+type hzTypeSpec struct {
+	typ, other string
+}
+
+// value is the type keyword's value, nil for none.
+func (t hzTypeSpec) value() any {
+	switch {
+	case t.typ == "":
+		return nil
+	case t.other != "" && t.other != t.typ:
+		return []any{t.typ, t.other}
+	}
+	return t.typ
+}
+
+// typeSpecs: no type 15% of the time, else a type, and with the 3.1 spellings a list of it and
+// a second type (or "null") 20% of the time.
+func typeSpecs(v31 bool) hegel.Generator[hzTypeSpec] {
+	others := hegel.Just("")
+	if v31 {
+		others = maybe(20, hegel.SampledFrom(append(append([]string{}, hzTypes...), "null")))
+	}
+	typed := hegel.Map(pairs(hzTypeName, others), func(p pair[string, string]) hzTypeSpec { return hzTypeSpec{p.a, p.b} })
+	return weighted(choice[hzTypeSpec]{15, hegel.Just(hzTypeSpec{})}, choice[hzTypeSpec]{85, typed})
+}
+
+// none is the empty keyword fragment.
+var none = hegel.Just(hzSchema(nil))
+
+// kw is a fragment holding the keyword pct percent of the time.
+func kw[T any](pct int, key string, g hegel.Generator[T]) hegel.Generator[hzSchema] {
+	return maybe(pct, hegel.Map(g, func(v T) hzSchema { return hzSchema{key: v} }))
+}
+
+// counts: a non-negative-integer keyword's value (a float64, as JSON numbers decode).
+func counts(lo, hi int) hegel.Generator[float64] {
+	return hegel.Map(hegel.Integers(lo, hi), func(n int) float64 { return float64(n) })
+}
+
+// merge adds the fragments' entries to s (a later fragment wins).
+func merge(s hzSchema, frags ...hzSchema) hzSchema {
+	for _, f := range frags {
+		for k, v := range f {
+			s[k] = v
+		}
+	}
+	return s
+}
+
+// fragments draws every fragment and merges them (the tuple of independent keyword draws).
+func fragments(frags ...hegel.Generator[hzSchema]) hegel.Generator[hzSchema] {
+	return hegel.Composite(func(tc hegel.TestCase) hzSchema {
+		s := hzSchema{}
+		for _, f := range frags {
+			merge(s, hegel.Draw(tc, f))
+		}
+		return s
+	})
+}
+
+var exclusiveOf = map[string]string{"minimum": "exclusiveMinimum", "maximum": "exclusiveMaximum"}
+
+// boundKws: the bound (minimum or maximum) 40% of the time, with its boolean exclusive form
+// 40% of that; with the 3.1 spellings the numeric exclusive form alone 15% of the time.
+func boundKws(v31, integer bool, key string) hegel.Generator[hzSchema] {
+	nums := numbersOf(integer)
+	excl := exclusiveOf[key]
+	boolForm := hegel.Map(pairs(nums, optional(40, chance(60))), func(p pair[float64, *bool]) hzSchema {
+		s := hzSchema{key: p.a}
+		if p.b != nil {
+			s[excl] = *p.b
+		}
+		return s
+	})
+	if !v31 {
+		return weighted(choice[hzSchema]{60, none}, choice[hzSchema]{40, boolForm})
+	}
+	numForm := hegel.Map(nums, func(v float64) hzSchema { return hzSchema{excl: v} })
+	return weighted(choice[hzSchema]{45, none}, choice[hzSchema]{40, boolForm}, choice[hzSchema]{15, numForm})
+}
+
+// stringKws: the string constraints, each some of the time.
+var stringKws = fragments(
+	kw(30, "minLength", counts(1, 3)),
+	kw(30, "maxLength", counts(0, 5)),
+	kw(25, "pattern", hegel.SampledFrom(hzPatterns)),
+	kw(20, "format", hegel.SampledFrom(hzStrFmts)),
+)
+
+// numberKws: the numeric constraints: the bounds, multipleOf 25% of the time, a format 25% of
+// the time for integers (int32, int64, int16) and 15% for numbers (float, double, and int32,
+// the shape of kin-openapi/6).
+func numberKws(v31, integer bool) hegel.Generator[hzSchema] {
+	multiples, formats, pct := hzMultiples, []string{"float", "double", "int32"}, 15
+	if integer {
+		multiples, formats, pct = hzIntMultiples, []string{"int32", "int64", "int16"}, 25
+	}
+	return fragments(
+		boundKws(v31, integer, "minimum"),
+		boundKws(v31, integer, "maximum"),
+		kw(25, "multipleOf", hegel.SampledFrom(multiples)),
+		kw(pct, "format", hegel.SampledFrom(formats)),
+	)
+}
+
+// arrayKws: items 80% of the time (a sub-schema), the counts 30% each, uniqueItems 30%.
+func arrayKws(sub hegel.Generator[hzSchema]) hegel.Generator[hzSchema] {
+	return fragments(
+		kw(80, "items", sub),
+		kw(30, "minItems", counts(1, 3)),
+		kw(30, "maxItems", counts(0, 4)),
+		kw(30, "uniqueItems", hegel.Just(true)),
+	)
+}
+
+// objectKws: one to three properties 80% of the time, with a required list half of the time
+// (one to four of their names, the undeclared "z" 15% of the time, distinct and sorted);
+// additionalProperties false, true or a sub-schema one time in six each; the counts 20% each.
+func objectKws(sub hegel.Generator[hzSchema]) hegel.Generator[hzSchema] {
+	props := hegel.Map(hegel.Maps(hzPropName, sub).MinSize(1).MaxSize(3), func(m map[string]hzSchema) hzSchema {
+		ps := hzSchema{}
+		for k, v := range m {
+			ps[k] = v
+		}
+		return ps
+	})
+	withRequired := hegel.FlatMap(props, func(ps hzSchema) hegel.Generator[hzSchema] {
+		names := weighted(choice[string]{85, hegel.SampledFrom(sortedKeys(ps))}, choice[string]{15, hegel.Just("z")})
+		required := kw(50, "required", hegel.Map(many(names, 1, 4), func(ns []string) any {
+			ns = distinct(ns)
+			return anyList(sortedKeys(func() map[string]bool {
+				m := map[string]bool{}
+				for _, n := range ns {
+					m[n] = true
+				}
+				return m
+			}()))
+		}))
+		return hegel.Map(required, func(r hzSchema) hzSchema { return merge(hzSchema{"properties": ps}, r) })
+	})
+	additional := weighted(
+		choice[hzSchema]{3, none},
+		choice[hzSchema]{1, hegel.Just(hzSchema{"additionalProperties": false})},
+		choice[hzSchema]{1, hegel.Just(hzSchema{"additionalProperties": true})},
+		choice[hzSchema]{1, hegel.Map(sub, func(s hzSchema) hzSchema { return hzSchema{"additionalProperties": s} })},
+	)
+	return fragments(
+		maybe(80, withRequired),
+		additional,
+		kw(20, "minProperties", counts(1, 3)),
+		kw(20, "maxProperties", counts(0, 3)),
+	)
+}
+
+// enumsFor: an enum of one to three values shaped after the schema so far 12% of the time,
+// or (3.1) a const 8% of the time.
+func enumsFor(s hzSchema, v31 bool) hegel.Generator[hzSchema] {
+	vals := valuesOf(s, 1)
+	enums := hegel.Map(many(vals, 1, 3), func(vs []any) hzSchema { return hzSchema{"enum": vs} })
+	if !v31 {
+		return weighted(choice[hzSchema]{88, none}, choice[hzSchema]{12, enums})
+	}
+	consts := hegel.Map(vals, func(v any) hzSchema { return hzSchema{"const": v} })
+	return weighted(choice[hzSchema]{80, none}, choice[hzSchema]{12, enums}, choice[hzSchema]{8, consts})
+}
+
+// schemaNodes: a schema object: a type, the keyword fragments of that type (none for an array
+// or object at the depth bound, whose leaves stay flat), an enum or const shaped after them,
+// a combinator (15%) and a not (8%) of sub-schemas above the bound, and nullable 15% of the
+// time when there is a type.
+func schemaNodes(v31, leaf bool, sub hegel.Generator[hzSchema]) hegel.Generator[hzSchema] {
+	types := typeSpecs(v31)
+	kws := map[string]hegel.Generator[hzSchema]{
+		"":        none,
+		"boolean": none,
+		"string":  stringKws,
+		"integer": numberKws(v31, true),
+		"number":  numberKws(v31, false),
+		"array":   none,
+		"object":  none,
+	}
+	combinators := none
+	if !leaf {
+		kws["array"], kws["object"] = arrayKws(sub), objectKws(sub)
+		combinators = fragments(
+			maybe(15, hegel.Map(pairs(hegel.SampledFrom(hzXofKeys), many(sub, 1, 3)), func(p pair[string, []hzSchema]) hzSchema {
+				return hzSchema{p.a: anyList(p.b)}
+			})),
+			kw(8, "not", sub),
+		)
+	}
+	nullable := kw(15, "nullable", hegel.Just(true))
+	return hegel.Composite(func(tc hegel.TestCase) hzSchema {
+		t := hegel.Draw(tc, types)
+		s := hzSchema{}
+		if v := t.value(); v != nil {
+			s["type"] = v
+		}
+		merge(s, hegel.Draw(tc, kws[t.typ]))
+		merge(s, hegel.Draw(tc, enumsFor(s, v31)))
+		merge(s, hegel.Draw(tc, combinators))
+		if t.typ != "" {
+			merge(s, hegel.Draw(tc, nullable))
+		}
+		return s
+	})
+}
+
+// schemaGrammar: schemas of the 3.0 keywords (with the 3.1 spellings when v31) whose
+// sub-schemas nest bound levels deep (the counter in the closure tracks the live recursion,
+// hegel-go's ExampleComposite_recursive).
+func schemaGrammar(v31 bool, bound int) hegel.Generator[hzSchema] {
+	var nodes hegel.Generator[hzSchema]
+	full, leaves := schemaNodes(v31, false, deferred(&nodes)), schemaNodes(v31, true, nil)
+	depth := 0
+	nodes = hegel.Composite(func(tc hegel.TestCase) hzSchema {
+		if depth >= bound {
+			return hegel.Draw(tc, leaves)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, full)
+	})
+	return nodes
+}
+
+// hzSchemaGrammars: the grammar of each flag and depth bound 0 to 3.
+var hzSchemaGrammars = func() map[[2]int]hegel.Generator[hzSchema] {
+	m := map[[2]int]hegel.Generator[hzSchema]{}
+	for v31 := 0; v31 <= 1; v31++ {
+		for bound := 0; bound <= 3; bound++ {
+			m[[2]int{v31, bound}] = schemaGrammar(v31 == 1, bound)
+		}
+	}
+	return m
+}()
+
+func schemasOf(v31 bool, bound int) hegel.Generator[hzSchema] {
+	key := [2]int{0, bound}
+	if v31 {
+		key[0] = 1
+	}
+	return hzSchemaGrammars[key]
+}
+
+// pastKnown takes the recorded bugs' shapes out of a drawn schema, sub-schemas first (the
+// avoidances of the old test, applied only under HEGEL_NO_KNOWN=1): a const null becomes "x"
+// (kin-openapi/1); an int32/int64 format on a schema whose type does not require an integer
+// becomes double (/6); a not or a oneOf of two or more in a schema kin-openapi takes for empty
+// gets a type (/9); a schema without a type whose combinators permit null loses its enum, const
+// and not, a type list holding null beside such keywords loses the null, and a nullable schema
+// beside them loses nullable (/4); a typed non-nullable schema loses a combinator with a
+// nullable branch (/5).
+func pastKnown(s hzSchema) hzSchema {
+	for k, v := range s {
+		switch k {
+		case "items", "not", "additionalProperties":
+			if sub, ok := v.(hzSchema); ok {
+				s[k] = pastKnown(sub)
+			}
+		case "properties":
+			for name, sub := range v.(hzSchema) {
+				v.(hzSchema)[name] = pastKnown(sub.(hzSchema))
+			}
+		case "oneOf", "anyOf", "allOf":
+			for i, sub := range v.([]any) {
+				v.([]any)[i] = pastKnown(sub.(hzSchema))
+			}
+		}
+	}
+	if c, ok := s["const"]; ok && c == nil && HZKnown.constNull {
+		s["const"] = "x"
+	}
+	if f, _ := s["format"].(string); (f == "int32" || f == "int64") && !hzRequiresInteger(s) && HZKnown.intFormatOnNumber2020 {
+		s["format"] = "double"
+	}
+	if HZKnown.notEmptySchema && hzIsEmptyForKin(s) {
+		_, hasNot := s["not"]
+		oneOf, _ := s["oneOf"].([]any)
+		if hasNot || len(oneOf) >= 2 {
+			s["type"] = "string"
+		}
+	}
+	_, hasType := s["type"]
+	if !hasType && hzHasAnyKey(s, hzXofKeys...) && HZKnown.nullSkipsKeywords {
+		for _, k := range []string{"enum", "const", "not"} {
+			delete(s, k)
+		}
+	}
+	if ts, ok := s["type"].([]any); ok && hzHasNullType(ts) && hzHasAnyKey(s, "enum", "const", "not", "oneOf", "anyOf", "allOf") && HZKnown.nullSkipsKeywords {
+		for _, x := range ts {
+			if x != "null" {
+				s["type"] = x
+				break
+			}
+		}
+	}
+	if hasType && !hzPermitsNull(s) && HZKnown.nullBranchOverridesType {
+		for _, k := range hzXofKeys {
+			if subs, ok := s[k].([]any); ok {
+				for _, sub := range subs {
+					if hzPermitsNullDeep(sub.(hzSchema)) {
+						delete(s, k)
+						break
+					}
+				}
+			}
+		}
+	}
+	if n, _ := s["nullable"].(bool); n && hzHasAnyKey(s, "enum", "const", "not", "oneOf", "anyOf", "allOf") && HZKnown.nullSkipsKeywords {
+		delete(s, "nullable")
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- cases
+
+// hzSchemaCase: the 3.1 flag, a schema and the values validated against it.
+type hzSchemaCase struct {
+	v31    bool
+	schema hzSchema
+	values []any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hzSchemaCase) GoString() string {
+	vals := make([]string, len(c.values))
+	for i, v := range c.values {
+		vals[i] = hzJSON(v)
+	}
+	return fmt.Sprintf("v31=%v schema %s values %s", c.v31, hzJSON(c.schema), strings.Join(vals, " "))
+}
+
+// casesOf: a schema of the generator with one to four values shaped after it.
+func casesOf(v31 bool, schemas hegel.Generator[hzSchema]) hegel.Generator[hzSchemaCase] {
+	if noKnown {
+		schemas = hegel.Map(schemas, pastKnown)
+	}
+	return hegel.FlatMap(schemas, func(s hzSchema) hegel.Generator[hzSchemaCase] {
+		return hegel.Map(many(valuesOf(s, 3), 1, 4), func(vals []any) hzSchemaCase { return hzSchemaCase{v31, s, vals} })
+	})
+}
+
+// hzSchemaCases: the 3.1 spellings 40% of the time, a depth bound of 0 to 3.
+var hzSchemaCases = hegel.FlatMap(pairs(chance(40), hegel.Integers(0, 3)), func(p pair[bool, int]) hegel.Generator[hzSchemaCase] {
+	return casesOf(p.a, schemasOf(p.a, p.b))
+})
+
+// --------------------------------------------------------------------------- translation
+
+var hzFormatPatterns = map[string]string{
+	"byte":      openapi3.FormatOfStringByte,
+	"date":      openapi3.FormatOfStringDate,
+	"date-time": openapi3.FormatOfStringDateTime,
+}
+
+// hzPermitsNull says whether the schema accepts null by the OpenAPI 3.0.3 rules as
+// kin-openapi reads them: nullable, or a type list holding "null".
+func hzPermitsNull(s hzSchema) bool {
+	if n, ok := s["nullable"].(bool); ok && n {
+		return true
+	}
+	if ts, ok := s["type"].([]any); ok {
+		return hzHasNullType(ts)
+	}
+	return false
+}
+
+// hzToJSONSchema translates a generated OpenAPI schema into JSON Schema 2020-12 for the
+// oracle: nullable becomes a "null" type, boolean exclusive bounds become numeric ones, the
+// formats the library enforces become patterns/bounds, and, for the built-in validator's
+// OpenAPI 3.0 reading (v30), a schema that does not permit null rejects it (3.0: null is not a
+// type). The JSON Schema 2020-12 mode reads the schema as OpenAPI 3.1, where {} accepts null.
+func hzToJSONSchema(s hzSchema, v30 bool) hzSchema {
+	out := hzSchema{}
+	var extra []any
+	for k, v := range s {
+		switch k {
+		case "nullable", "format", "exclusiveMinimum", "exclusiveMaximum", "minimum", "maximum":
+			continue
+		case "items", "not", "additionalProperties":
+			if sub, ok := v.(hzSchema); ok {
+				out[k] = hzToJSONSchema(sub, v30)
+			} else {
+				out[k] = v
+			}
+		case "properties":
+			props := hzSchema{}
+			for name, sub := range v.(hzSchema) {
+				props[name] = hzToJSONSchema(sub.(hzSchema), v30)
+			}
+			out[k] = props
+		case "oneOf", "anyOf", "allOf":
+			subs := make([]any, 0)
+			for _, sub := range v.([]any) {
+				subs = append(subs, hzToJSONSchema(sub.(hzSchema), v30))
+			}
+			out[k] = subs
+		case "pattern":
+			out[k] = hzPyPattern(v.(string))
+		default:
+			out[k] = v
+		}
+	}
+	// bounds
+	min, hasMin := s["minimum"].(float64)
+	max, hasMax := s["maximum"].(float64)
+	switch em := s["exclusiveMinimum"].(type) {
+	case bool:
+		if em && hasMin {
+			out["exclusiveMinimum"] = min
+			hasMin = false
+		}
+	case float64:
+		out["exclusiveMinimum"] = em
+	}
+	switch em := s["exclusiveMaximum"].(type) {
+	case bool:
+		if em && hasMax {
+			out["exclusiveMaximum"] = max
+			hasMax = false
+		}
+	case float64:
+		out["exclusiveMaximum"] = em
+	}
+	if hasMin {
+		out["minimum"] = min
+	}
+	if hasMax {
+		out["maximum"] = max
+	}
+	// type and nullable
+	permitsNull := hzPermitsNull(s)
+	if n, ok := s["nullable"].(bool); ok && n {
+		switch t := s["type"].(type) {
+		case string:
+			out["type"] = []any{t, "null"}
+		case []any:
+			if !hzHasNullType(t) {
+				out["type"] = append(append([]any{}, t...), "null")
+			}
+		}
+	}
+	// formats the library enforces
+	if f, ok := s["format"].(string); ok {
+		if pat, ok := hzFormatPatterns[f]; ok {
+			extra = append(extra, hzSchema{"pattern": hzPyPattern(pat)})
+		}
+		if hzRequiresInteger(s) {
+			switch f {
+			case "int32":
+				extra = append(extra, hzSchema{"minimum": float64(math.MinInt32), "maximum": float64(math.MaxInt32)})
+			case "int64":
+				extra = append(extra, hzSchema{"minimum": float64(math.MinInt64), "maximum": float64(math.MaxInt64)})
+			}
+		}
+	}
+	if v30 && !permitsNull {
+		// OpenAPI 3.0: null is not a value unless the schema permits it; a schema without a
+		// type leaves null to its oneOf/anyOf/allOf (a nullable branch counts)
+		_, hasType := s["type"]
+		if hasType || !hzHasAnyKey(s, hzXofKeys...) {
+			extra = append(extra, hzSchema{"not": hzSchema{"type": "null"}})
+		}
+	}
+	if len(extra) > 0 {
+		return hzSchema{"allOf": append([]any{out}, extra...)}
+	}
+	return out
+}
+
+// hzNullableShapes reports whether nullable appears with a type string (str) or with a type
+// list (list) anywhere in the schema.
+func hzNullableShapes(s hzSchema) (str, list bool) {
+	if n, ok := s["nullable"].(bool); ok && n {
+		switch s["type"].(type) {
+		case string:
+			str = true
+		case []any:
+			list = true
+		}
+	}
+	for _, sub := range hzSubSchemas(s) {
+		a, b := hzNullableShapes(sub)
+		str, list = str || a, list || b
+	}
+	return
+}
+
+// hzPermitsNullDeep is the built-in validator's rule for null: the schema permits null, or it
+// has no type and its oneOf/anyOf/allOf accept null (a nullable branch counts for the parent).
+func hzPermitsNullDeep(s hzSchema) bool {
+	if hzPermitsNull(s) {
+		return true
+	}
+	if _, hasType := s["type"]; hasType {
+		return false
+	}
+	some := func(subs []any) bool {
+		for _, sub := range subs {
+			if hzPermitsNullDeep(sub.(hzSchema)) {
+				return true
+			}
+		}
+		return false
+	}
+	if subs, ok := s["oneOf"].([]any); ok && some(subs) {
+		return true
+	}
+	if subs, ok := s["anyOf"].([]any); ok && some(subs) {
+		return true
+	}
+	if subs, ok := s["allOf"].([]any); ok && len(subs) > 0 {
+		all := true
+		for _, sub := range subs {
+			all = all && hzPermitsNullDeep(sub.(hzSchema))
+		}
+		return all
+	}
+	return false
+}
+
+// hzPyPattern rewrites a pattern for Python's re, whose $ also matches before a trailing
+// newline (ECMA-262 and Go match only at the end): the generated patterns use $ only as an
+// anchor.
+func hzPyPattern(p string) string { return strings.ReplaceAll(p, "$", `\Z`) }
+
+// hzIsEmptyForKin mirrors Schema.IsEmpty: no value keyword, and every sub-schema (items,
+// properties, additionalProperties, not, the oneOf/anyOf/allOf members) empty itself.
+func hzIsEmptyForKin(s hzSchema) bool {
+	for k, v := range s {
+		switch k {
+		case "items", "additionalProperties", "not":
+			if sub, ok := v.(hzSchema); ok {
+				if !hzIsEmptyForKin(sub) {
+					return false
+				}
+			} else if b, ok := v.(bool); ok && !b {
+				return false
+			}
+		case "properties":
+			for _, sub := range v.(hzSchema) {
+				if !hzIsEmptyForKin(sub.(hzSchema)) {
+					return false
+				}
+			}
+		case "oneOf", "anyOf", "allOf":
+			for _, sub := range v.([]any) {
+				if !hzIsEmptyForKin(sub.(hzSchema)) {
+					return false
+				}
+			}
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// hzSubSchemas lists the schema's direct sub-schemas (items, not, additionalProperties, the
+// properties, the combinator members).
+func hzSubSchemas(s hzSchema) []hzSchema {
+	var subs []hzSchema
+	for _, v := range s {
+		switch v := v.(type) {
+		case hzSchema:
+			subs = append(subs, v)
+		case []any:
+			for _, x := range v {
+				if sub, ok := x.(hzSchema); ok {
+					subs = append(subs, sub)
+				}
+			}
+		}
+	}
+	return subs
+}
+
+// hzAnyNode reports whether pred holds of the schema or of a sub-schema at any depth (the
+// properties map is walked, not tested).
+func hzAnyNode(s hzSchema, pred func(hzSchema) bool) bool {
+	if pred(s) {
+		return true
+	}
+	for k, v := range s {
+		if k == "properties" {
+			for _, sub := range v.(hzSchema) {
+				if hzAnyNode(sub.(hzSchema), pred) {
+					return true
+				}
+			}
+			continue
+		}
+		switch v := v.(type) {
+		case hzSchema:
+			if hzAnyNode(v, pred) {
+				return true
+			}
+		case []any:
+			for _, x := range v {
+				if sub, ok := x.(hzSchema); ok && hzAnyNode(sub, pred) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// hzHasKey reports whether key occurs in the schema at any depth.
+func hzHasKey(s hzSchema, key string) bool {
+	return hzAnyNode(s, func(n hzSchema) bool { _, ok := n[key]; return ok })
+}
+
+// hzHasAnyKey reports whether one of the keys occurs in the schema itself.
+func hzHasAnyKey(s hzSchema, keys ...string) bool {
+	for _, k := range keys {
+		if _, ok := s[k]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+// hzHasFormat reports whether the format occurs in the schema at any depth.
+func hzHasFormat(s hzSchema, format string) bool {
+	return hzAnyNode(s, func(n hzSchema) bool { f, _ := n["format"].(string); return f == format })
+}
+
+// hzHasBigNumber reports whether the value holds a number of magnitude at least lim.
+func hzHasBigNumber(v any, lim float64) bool {
+	switch v := v.(type) {
+	case float64:
+		return math.Abs(v) >= lim
+	case []any:
+		for _, x := range v {
+			if hzHasBigNumber(x, lim) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, x := range v {
+			if hzHasBigNumber(x, lim) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hzHasNull reports whether the value is or holds a null.
+func hzHasNull(v any) bool {
+	switch v := v.(type) {
+	case nil:
+		return true
+	case []any:
+		for _, x := range v {
+			if hzHasNull(x) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, x := range v {
+			if hzHasNull(x) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hzHasNullType(ts []any) bool {
+	for _, t := range ts {
+		if t == "null" {
+			return true
+		}
+	}
+	return false
+}
+
+// hzRequiresInteger mirrors the validator's rule for integer formats: the type permits
+// integer and not number.
+func hzRequiresInteger(s hzSchema) bool {
+	switch t := s["type"].(type) {
+	case string:
+		return t == "integer"
+	case []any:
+		hasInt, hasNum := false, false
+		for _, x := range t {
+			hasInt = hasInt || x == "integer"
+			hasNum = hasNum || x == "number"
+		}
+		return hasInt && !hasNum
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- shapes
+
+// The recorded bugs' shapes, named on a mismatch (the classifiers over-approximate: they are
+// consulted only when the library and the oracle already disagree).
+
+// hzNullKeywordShape is the shape of kin-openapi/4: a schema permitting null (nullable, a type
+// list holding null, or no type and combinators that permit null) beside enum, const, not or
+// a combinator.
+func hzNullKeywordShape(n hzSchema) bool {
+	if !hzHasAnyKey(n, "enum", "const", "not", "oneOf", "anyOf", "allOf") {
+		return false
+	}
+	if _, hasType := n["type"]; !hasType {
+		return hzPermitsNullDeep(n) && hzHasAnyKey(n, "enum", "const", "not")
+	}
+	return hzPermitsNull(n)
+}
+
+// hzNullBranchShape is the shape of kin-openapi/5: a typed schema that does not permit null
+// with a combinator whose branch does.
+func hzNullBranchShape(n hzSchema) bool {
+	if _, hasType := n["type"]; !hasType || hzPermitsNull(n) {
+		return false
+	}
+	for _, k := range hzXofKeys {
+		if subs, ok := n[k].([]any); ok {
+			for _, sub := range subs {
+				if hzPermitsNullDeep(sub.(hzSchema)) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// hzEmptyNotShape is the shape of kin-openapi/9: a schema kin-openapi takes for empty holding
+// a not or a oneOf of two or more.
+func hzEmptyNotShape(n hzSchema) bool {
+	if !hzIsEmptyForKin(n) {
+		return false
+	}
+	_, hasNot := n["not"]
+	oneOf, _ := n["oneOf"].([]any)
+	return hasNot || len(oneOf) >= 2
+}
+
+func hzConstNullShape(n hzSchema) bool { c, ok := n["const"]; return ok && c == nil }
+
+func hzIntFormatOnNumberShape(n hzSchema) bool {
+	f, _ := n["format"].(string)
+	return (f == "int32" || f == "int64") && !hzRequiresInteger(n)
+}
+
+// roundTripShapes names the bug a JSON round trip of the schema may meet (kin-openapi/1).
+func roundTripShapes(s hzSchema) []string {
+	return shapeIf(hzAnyNode(s, hzConstNullShape), "kin-openapi/1")
+}
+
+// builtinShapes names the bugs the built-in validator may meet on the value.
+func builtinShapes(s hzSchema, v any) []string {
+	var shapes []string
+	shapes = append(shapes, roundTripShapes(s)...)
+	shapes = append(shapes, shapeIf(hzHasNull(v) && hzAnyNode(s, hzNullKeywordShape), "kin-openapi/4")...)
+	shapes = append(shapes, shapeIf(hzHasNull(v) && hzAnyNode(s, hzNullBranchShape), "kin-openapi/5")...)
+	shapes = append(shapes, shapeIf(hzHasKey(s, "multipleOf") && hzHasBigNumber(v, 1<<51), "kin-openapi/8")...)
+	shapes = append(shapes, shapeIf(hzAnyNode(s, hzEmptyNotShape), "kin-openapi/9")...)
+	return shapes
+}
+
+// jsonschema2020Shapes names the bugs the JSON Schema 2020-12 mode may meet on the value.
+func jsonschema2020Shapes(s hzSchema, v any) []string {
+	var shapes []string
+	shapes = append(shapes, roundTripShapes(s)...)
+	nullStr, nullList := hzNullableShapes(s)
+	shapes = append(shapes, shapeIf(nullStr, "kin-openapi/2")...)
+	shapes = append(shapes, shapeIf(nullList, "kin-openapi/3")...)
+	shapes = append(shapes, shapeIf(hzAnyNode(s, hzIntFormatOnNumberShape), "kin-openapi/6")...)
+	shapes = append(shapes, shapeIf(hzHasFormat(s, "int64") && hzHasBigNumber(v, math.MaxInt64), "kin-openapi/7")...)
+	return shapes
+}
+
+// --------------------------------------------------------------------------- helpers
+
+func hzJSON(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return fmt.Sprintf("%#v", v)
+	}
+	return string(b)
+}
+
+func hzErrStr(err error) string {
+	if err == nil {
+		return "ok"
+	}
+	s := err.Error()
+	if len(s) > 300 {
+		s = s[:300] + "..."
+	}
+	return strings.ReplaceAll(s, "\n", " | ")
+}
+
+// hzNormJSON re-decodes v through JSON so that maps and slices compare with reflect.DeepEqual.
+func hzNormJSON(v any) any {
+	b, _ := json.Marshal(v)
+	var out any
+	json.Unmarshal(b, &out)
+	return out
+}
+
+func hzVerdict(valid bool) string {
+	return map[bool]string{true: "valid", false: "invalid"}[valid]
+}
+
+// --------------------------------------------------------------------------- judge
+
+// checkSchema judges one case: the schema survives a JSON round trip, its own Validate
+// verdict is counted, and on every value the built-in validator agrees with the oracle's 3.0
+// reading, MultiErrors() and FailFast() agree with it, and the JSON Schema 2020-12 mode agrees
+// with the oracle's 3.1 reading. Under HEGEL_NO_KNOWN=1 the 2020 comparison is skipped for a
+// schema holding nullable (kin-openapi/2, /3) and for a value beyond int64 under format int64
+// (/7), and a value of magnitude 2^51 or more is not judged against multipleOf (/8).
+func checkSchema(ht *hegel.T, c *hzCollector, oracle *hzOracle, sc hzSchemaCase) {
+	schema := sc.schema
+	schemaJSON := hzJSON(schema)
+	var s openapi3.Schema
+	if err := json.Unmarshal([]byte(schemaJSON), &s); err != nil {
+		c.failClass(ht, "unmarshal", "schema %s: %v", schemaJSON, err)
+		return
+	}
+	// JSON round trip
+	if back, err := json.Marshal(&s); err != nil {
+		c.failClass(ht, "marshal", "schema %s: %v", schemaJSON, err)
+	} else if !reflect.DeepEqual(hzNormJSON(schema), hzNormJSON(json.RawMessage(back))) {
+		c.mismatch(ht, roundTripShapes(schema), "round trip", "schema %s marshals back as %s", schemaJSON, back)
+	}
+	// the schema's own validation is counted, not judged (a generated required name may be
+	// absent from properties, and so on)
+	if err := s.Validate(context.Background()); err != nil {
+		c.count("schema invalid")
+	} else {
+		c.count("schema valid")
+	}
+	oracleSchema := hzToJSONSchema(schema, true)
+	oracleSchema31 := hzToJSONSchema(schema, false)
+	compare2020 := true
+	if nullStr, nullList := hzNullableShapes(schema); (nullStr && HZKnown.nullableFallback2020) || (nullList && HZKnown.nullableTypeList2020) {
+		c.count("2020 skipped: nullable")
+		compare2020 = false
+	}
+
+	for _, value := range sc.values {
+		value = hzNormJSON(value)
+		if HZKnown.multipleOfSlack && hzHasKey(schema, "multipleOf") && hzHasBigNumber(value, 1<<51) {
+			c.count("value skipped: multipleOf")
+			continue
+		}
+		compare2020Value := compare2020
+		if HZKnown.int64Overflow2020 && hzHasFormat(schema, "int64") && hzHasBigNumber(value, math.MaxInt64) {
+			c.count("2020 skipped: int64")
+			compare2020Value = false
+		}
+		reply, err := oracle.validate(oracleSchema, value)
+		if err != nil {
+			ht.Fatalf("oracle: %v", err)
+		}
+		if reply.SchemaError != "" {
+			c.count("oracle schema error")
+			c.failClass(ht, "oracle schema", "schema %s translated %s: %s", schemaJSON, hzJSON(oracleSchema), reply.SchemaError)
+			return
+		}
+		c.count(hzVerdict(reply.Valid))
+		var got error
+		if p := hzCatch(func() { got = s.VisitJSON(value) }); p != nil {
+			c.failClass(ht, "panic", "schema %s value %s: VisitJSON panics: %v", schemaJSON, hzJSON(value), p)
+			return
+		}
+		if (got == nil) != reply.Valid {
+			c.mismatch(ht, builtinShapes(schema, value), "builtin", "schema %s value %s: built-in %s, oracle %s (%s)", schemaJSON, hzJSON(value), hzErrStr(got), hzVerdict(reply.Valid), reply.Error)
+		}
+		var multi, fast error
+		hzCatch(func() { multi = s.VisitJSON(value, openapi3.MultiErrors()) })
+		hzCatch(func() { fast = s.VisitJSON(value, openapi3.FailFast()) })
+		if (multi == nil) != (got == nil) {
+			c.failClass(ht, "multiError", "schema %s value %s: plain %s, MultiErrors %s", schemaJSON, hzJSON(value), hzErrStr(got), hzErrStr(multi))
+		}
+		if (fast == nil) != (got == nil) {
+			c.failClass(ht, "failFast", "schema %s value %s: plain %s, FailFast %s", schemaJSON, hzJSON(value), hzErrStr(got), hzErrStr(fast))
+		}
+		var got20 error
+		if p := hzCatch(func() { got20 = s.VisitJSON(value, openapi3.EnableJSONSchema2020()) }); p != nil {
+			c.failClass(ht, "panic 2020", "schema %s value %s: VisitJSON(EnableJSONSchema2020) panics: %v", schemaJSON, hzJSON(value), p)
+			return
+		}
+		if !compare2020Value {
+			continue
+		}
+		reply31, err := oracle.validate(oracleSchema31, value)
+		if err != nil {
+			ht.Fatalf("oracle: %v", err)
+		}
+		if reply31.SchemaError != "" {
+			c.failClass(ht, "oracle schema", "schema %s translated %s: %s", schemaJSON, hzJSON(oracleSchema31), reply31.SchemaError)
+			return
+		}
+		if (got20 == nil) != reply31.Valid {
+			c.mismatch(ht, jsonschema2020Shapes(schema, value), "jsonschema2020", "schema %s value %s: JSON Schema 2020 mode %s, oracle (3.1 reading) %s (%s)", schemaJSON, hzJSON(value), hzErrStr(got20), hzVerdict(reply31.Valid), reply31.Error)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- property
+
+func TestHegelSchema(t *testing.T) {
+	c := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	hzProperty(t, func(ht *hegel.T) {
+		checkSchema(ht, c, oracle, hegel.Draw(ht, hzSchemaCases))
+	})
+}
