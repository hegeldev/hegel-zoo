+// kin-openapi/8: a multipleOf m given m*k + 2 with m*k at least 2^53 (past it: small k); an
+// exactly representable non-multiple must be rejected.
+var hzMultipleOfSlackCases = hegel.Composite(func(tc hegel.TestCase) hzSchemaCase {
+	m := hegel.Draw(tc, hegel.SampledFrom([]float64{10, 6, 14, 22, 100}))
