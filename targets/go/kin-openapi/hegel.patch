+// --------------------------------------------------------------------------- parameter shapes
+
+// malformedCasesOf: a primitive parameter of the type in the query, a header or a cookie,
+// sent one of the texts (a cookie never the empty one) instead of a value.
+func malformedCasesOf(typ string, texts []string) hegel.Generator[hzParamCase] {
