+// kin-openapi/7: an integer with format int64, given values beyond int64 (past it: within);
+// the JSON Schema 2020-12 mode must reject them.
+var hzInt64Values = hegel.SampledFrom(shaped(
+	[]float64{1e19, 1e20, 1e300, -1e19, -1e300},
