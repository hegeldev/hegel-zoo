diff --git a/hegel_zoo_engine_test.go b/hegel_zoo_engine_test.go
new file mode 100644
index 0000000..b0bea16
--- /dev/null
+++ b/hegel_zoo_engine_test.go
@@ -0,0 +1,378 @@
+package gin
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- engine options
+//
+// gin.go: RedirectTrailingSlash "enables automatic redirection if the current route can't be
+// matched but a handler for the path with (without) the trailing slash exists. For example
+// if /foo/ is requested but a route only exists for /foo, the client is redirected to /foo
+// with http status code 301 for GET requests and 307 for all other request methods."
+// RedirectFixedPath: "if enabled, the router tries to fix the current request path, if no
+// handle is registered for it. First superfluous path elements like ../ or // are removed.
+// Afterwards the router does a case-insensitive lookup of the cleaned path. If a handle can be
+// found for this route, the router makes a redirection to the corrected path with status code
+// 301 for GET requests and 307 for all other request methods." HandleMethodNotAllowed: "if
+// enabled, the router checks if another method is allowed for the current route, if the
+// current request can not be routed. If this is the case, the request is answered with
+// 'Method Not Allowed' and HTTP status code 405" with an Allow header (RFC 7231 6.5.5).
+// RemoveExtraSlash: "a parameter can be parsed from the URL even with extra slashes".
+// UseRawPath: "the url.RawPath will be used to find parameters"; UnescapePathValues: "the
+// path value will be unescaped".
+
+type hzEngineOpts struct {
+	tsr, fixed, mna, extraSlash, rawPath, unescape bool
+}
+
+func (o hzEngineOpts) apply(e *Engine) {
+	e.RedirectTrailingSlash = o.tsr
+	e.RedirectFixedPath = o.fixed
+	e.HandleMethodNotAllowed = o.mna
+	e.RemoveExtraSlash = o.extraSlash
+	e.UseRawPath = o.rawPath
+	e.UnescapePathValues = o.unescape
+}
+
+func (o hzEngineOpts) String() string {
+	var parts []string
+	add := func(on bool, s string) {
+		if on {
+			parts = append(parts, s)
+		}
+	}
+	add(o.tsr, "tsr")
+	add(o.fixed, "fixedPath")
+	add(o.mna, "405")
+	add(o.extraSlash, "extraSlash")
+	add(o.rawPath, "rawPath")
+	add(o.unescape, "unescape")
+	if len(parts) == 0 {
+		return "plain"
+	}
+	return strings.Join(parts, "+")
+}
+
+// hzResponse is the model's (and the engine's) answer: the status, the body of a served
+// request, the Location of a redirect, the Allow methods of a 405; a code of 0 is the
+// engine's panic (gin/7), whose text the engine's answer carries.
+type hzResponse struct {
+	code     int
+	body     string
+	location string
+	allow    []string
+}
+
+// String is the response as the checks compare it: "200 R2|p=a", "301 -> /a/b", "405 Allow
+// [POST PUT]", "404", "panic: slice bounds out of range" (any other panic with its text).
+func (r hzResponse) String() string {
+	switch {
+	case r.code == 0:
+		if r.body == "" || strings.Contains(r.body, "slice bounds out of range") {
+			return "panic: slice bounds out of range"
+		}
+		return "panic: " + r.body
+	case r.code == 200:
+		return fmt.Sprintf("200 %s", r.body)
+	case r.code == 301 || r.code == 307:
+		return fmt.Sprintf("%d -> %s", r.code, r.location)
+	case r.code == 405:
+		return fmt.Sprintf("405 Allow %v", r.allow)
+	}
+	return fmt.Sprint(r.code)
+}
+
+// hzRedirectLocation is where http.Redirect sends a request whose URL path was changed to
+// newPath: the URL's string, made absolute against the request's directory when it is not,
+// with the path cleaned (a trailing slash kept).
+func hzRedirectLocation(u *url.URL, newPath string) string {
+	u2 := *u
+	u2.Path = newPath
+	s := u2.String()
+	if pu, err := url.Parse(s); err == nil && pu.Scheme == "" && pu.Host == "" {
+		oldpath := newPath
+		if oldpath == "" {
+			oldpath = "/"
+		}
+		if s == "" || s[0] != '/' {
+			dir, _ := path.Split(oldpath)
+			s = dir + s
+		}
+		query := ""
+		if i := strings.LastIndex(s, "?"); i >= 0 {
+			s, query = s[:i], s[i:]
+		}
+		trailing := strings.HasSuffix(s, "/")
+		s = path.Clean(s)
+		if trailing && !strings.HasSuffix(s, "/") {
+			s += "/"
+		}
+		s += query
+	}
+	return s
+}
+
+// hzToggleSlash removes a trailing slash or adds one.
+func hzToggleSlash(p string) string {
+	if len(p) > 1 && strings.HasSuffix(p, "/") {
+		return p[:len(p)-1]
+	}
+	return p + "/"
+}
+
+// hzModelServe is the documented answer to a request under the switches k: 200 by the walk
+// (a path value unescaped with url.PathUnescape; the tree's url.QueryUnescape, which turns a
+// '+' into a space, with gin/5 on: tree.go lines 514 and 567; with gin/14 on, a walk whose
+// pushes overflow the skipped-node stack is the panic answer); else, unless the method is
+// CONNECT or the path is "/" (gin.go line 726), the trailing-slash redirect when a route
+// exists for the path with the slash toggled (documented; the tree's own recommendation
+// step.tsr adds the cases of gin/3; with gin/13 on, a walk that rolled back from a node
+// where the path was exhausted - step.hidden - never looked for the route with the slash,
+// and the tree's recommendation is all there is; with gin/15 on, a route at path + "/"
+// reached through an empty :param value read where the walk was exhausted is not what the
+// tree looks for either, hzEmptyParamAt), then the fixed-path redirect (the fold walk over
+// the cleaned path), then the 405 with the sorted Allow of the other method trees that serve
+// the path, consulted in first-registration order (gin.go lines 742-749) - with gin/7 on,
+// each lookup starting with the skipped-node stack the previous one left and the overflow
+// of that stack the panic answer; else 404. note, when not nil, is told the model's
+// observations ("tsr: documented only", "tsr: tree only", "tsr: hidden by rollback", "tsr:
+// empty param unrecommended", "fixed: same path") - the collector's counts, not checks.
+func hzModelServe(o hzEngineOpts, routes []*hzRoute, method string, u *url.URL, k known, note func(string)) hzResponse {
+	rPath := u.Path
+	unescape := false
+	if o.rawPath && u.RawPath != "" {
+		rPath = u.RawPath
+		unescape = o.unescape
+	}
+	if o.extraSlash {
+		rPath = hzModelCleanPath(rPath)
+	}
+	own := hzByMethod(routes, method)
+	capacity := hzCapacity(routes) // the skipped-node stack's capacity (engine.maxSections)
+	step, stack := hzWalkStack(own, rPath, false, nil, capacity, k)
+	if step.overflow {
+		return hzResponse{code: 0} // panic: slice bounds out of range (gin/14: the walk's own pushes)
+	}
+	if step.ok {
+		m := step.m
+		if unescape {
+			for i, p := range m.params {
+				var v string
+				var err error
+				if k[kPlusUnescapedToSpace] {
+					v, err = url.QueryUnescape(p.Value)
+				} else {
+					v, err = url.PathUnescape(p.Value)
+				}
+				if err == nil {
+					m.params[i].Value = v
+				}
+			}
+		}
+		return hzResponse{code: 200, body: hzExpect(m)}
+	}
+	code := http.StatusMovedPermanently
+	if method != http.MethodGet {
+		code = http.StatusTemporaryRedirect
+	}
+	if method != http.MethodConnect && rPath != "/" {
+		if o.tsr {
+			// documented: a route exists for the path with the slash toggled. Not looked for
+			// by a walk that rolled back from an exhausted node with gin/13 on (hzWalkStack's
+			// hidden: tree.go line 591 before line 628): then only step.tsr can recommend.
+			// With gin/15 on, the route at path + "/" that the walk with the slash reaches
+			// through the :param child of the node where this walk was exhausted, with an
+			// empty value before the slash (route /ab:p/, GET /ab; the "/" route or the
+			// catch-all below the :param), is not recommended either: the tree's check at
+			// that node (lines 628-635) looks only for a "/" child that is a route or a
+			// catch-all, and its rules on the way (lines 478, 533, 545, 642) never reach the
+			// node's own :param child
+			toggled := hzToggleSlash(rPath)
+			exists, doc := false, false
+			if !step.hidden {
+				var m hzMatch
+				m, exists = hzModelMatch(own, toggled, k)
+				doc = exists && !(k[kEmptyParamSlashUnrecommended] && toggled == rPath+"/" && hzEmptyParamAt(m, len(rPath)))
+			}
+			if note != nil {
+				switch {
+				case step.hidden && !step.tsr:
+					if _, would := hzModelMatch(own, toggled, k); would {
+						note("tsr: hidden by rollback")
+					}
+				case exists && !doc && !step.tsr:
+					note("tsr: empty param unrecommended")
+				case doc && !step.tsr:
+					note("tsr: documented only")
+				case step.tsr && !exists:
+					note("tsr: tree only")
+				}
+			}
+			if doc || step.tsr {
+				return hzResponse{code: code, location: hzRedirectLocation(u, hzToggleSlash(u.Path))}
+			}
+		}
+		if o.fixed {
+			if f := hzWalk(own, hzModelCleanPath(u.Path), true, k); f.ok {
+				if note != nil && f.fixed == u.Path {
+					note("fixed: same path")
+				}
+				return hzResponse{code: code, location: hzRedirectLocation(u, f.fixed)}
+			}
+		}
+	}
+	if o.mna {
+		var allowed []string
+		seen := map[string]bool{}
+		for _, r := range routes {
+			if r.method == method || seen[r.method] {
+				continue
+			}
+			seen[r.method] = true
+			if !k[kSkippedNodesLeak] {
+				stack = nil
+			}
+			var s hzStep
+			s, stack = hzWalkStack(hzByMethod(routes, r.method), rPath, false, stack, capacity, k)
+			if s.overflow {
+				return hzResponse{code: 0} // panic: slice bounds out of range
+			}
+			if s.ok {
+				allowed = append(allowed, r.method)
+			}
+		}
+		if len(allowed) > 0 {
+			sort.Strings(allowed)
+			return hzResponse{code: 405, allow: allowed}
+		}
+	}
+	return hzResponse{code: 404}
+}
+
+// hzEmptyParamAt reports whether the match of a path reads a :param with an empty value
+// starting at offset of the path: for the path with a slash added, offset the length of the
+// path without it, the walk with the slash takes the :param child of the node where the walk
+// without it is exhausted, with nothing before the "/" (route /ab:p/ or /ab:p/*rest serving
+// /ab/ with p = ""). The params of a match are in the order of the route's wildcards.
+func hzEmptyParamAt(m hzMatch, offset int) bool {
+	at, next := 0, 0
+	for _, t := range m.route.toks {
+		switch t.kind {
+		case hzStatic:
+			at += len(t.text)
+		case hzParam:
+			v := m.params[next].Value
+			next++
+			if v == "" && at == offset {
+				return true
+			}
+			at += len(v)
+		case hzCatchAll:
+			return false
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- Engine
+
+// engineAnswer is the model's response to one request over the accepted routes, as a string.
+func engineAnswer(o hzEngineOpts, accepted []*hzRoute, r hzRequest, k known, note func(string)) string {
+	u, err := url.ParseRequestURI(r.raw)
+	if err != nil {
+		return "unparsable"
+	}
+	return hzModelServe(o, accepted, r.method, u, k, note).String()
+}
+
+// engineExpected states what the engine must give for the case: the routes the tree rejects
+// (rejected) and, per request, the full response as a string (hzResponse.String: the status
+// with the body, the Location or the Allow; "panic: ..." for the overflow). Documented
+// (every switch off): hzModelServe's reading of the option docs. With switches on: the
+// tree's stops (gin/1, gin/2), its trailing-slash recommendations (gin/3) and those of the
+// fold walk (gin/6), the catch-all the fold walk misses (gin/4), the query unescaping (gin/5),
+// the shared stack (gin/7), the trailing-slash redirect lost to a rollback (gin/13), the
+// stack a chain of mixed segments overflows (gin/14) and the redirect to a path served
+// through an empty :param value (gin/15).
+func engineExpected(c engineCase, k known) checks {
+	w := checks{}
+	accepted, rejected := hzAccepts(c.routes)
+	w["rejected"] = hzShowIDs(rejected)
+	for i, r := range c.requests {
+		w[hzCheckName(i)] = engineAnswer(c.opts, accepted, r, k, nil)
+	}
+	return w
+}
+
+// engineActual asks the library the model's questions: the engine built with the options,
+// the rejected routes, and each request served (a panic caught and reported as the answer).
+// The model's notes are counted here, from the replica with every switch on.
+func engineActual(c engineCase) checks {
+	got := checks{}
+	e, accepted, rejected := hzBuild(c.routes, c.opts.apply)
+	got["rejected"] = hzShowIDs(rejected)
+	for i, r := range c.requests {
+		if _, err := url.ParseRequestURI(r.raw); err != nil {
+			hzTally("noted unparsable raw path")
+			got[hzCheckName(i)] = "unparsable"
+			continue
+		}
+		engineAnswer(c.opts, accepted, r, hzKnownAll, hzTally)
+		var w *httptest.ResponseRecorder
+		var resp hzResponse
+		if p := hzCatch(func() { w = hzServe(e, r.method, r.raw) }); p != nil {
+			resp = hzResponse{code: 0, body: fmt.Sprint(p)}
+		} else {
+			resp = hzResponse{code: w.Code, body: w.Body.String(), location: w.Header().Get("Location")}
+			if w.Code == 405 {
+				resp.allow = strings.Split(w.Header().Get("Allow"), ", ")
+				sort.Strings(resp.allow)
+			}
+		}
+		got[hzCheckName(i)] = resp.String()
+		if resp.code == 0 {
+			hzTally("served panic")
+		} else {
+			hzTally(fmt.Sprintf("served %d", resp.code))
+		}
+	}
+	return got
+}
+
+// engineCases are the cases of the Engine property: the options, a route set and three
+// requests to it (under HEGEL_NO_KNOWN=1 each request filtered by the classifier on its own
+// case).
+var engineCases = hegel.FlatMap(engineOpts, func(o hzEngineOpts) hegel.Generator[engineCase] {
+	return hegel.FlatMap(routeSets, func(routes []*hzRoute) hegel.Generator[engineCase] {
+		return hegel.Map(requestsFor(routes, 25, func(r hzRequest) engineCase { // a method of the list 25: realises 25.1
+			return engineCase{opts: o, routes: routes, requests: []hzRequest{r}}
+		}, engineExpected), func(reqs []hzRequest) engineCase {
+			return engineCase{opts: o, routes: routes, requests: reqs}
+		})
+	})
+})
+
+// judgeEngine is the judge of the Engine family (the wide property and the narrow ones of
+// gin/3 to gin/7, gin/13 and gin/15): judgeBy over engineExpected and engineActual.
+func judgeEngine(j *hzCaseJudge, c engineCase) {
+	judgeBy(j, c, engineExpected, engineActual)
+}
+
+// TestHegelEngine: with every combination of the router options, a request is served,
+// redirected (to a path that is served) or refused as the documentation says, and never
+// panics. The shapes of gin/1 to gin/7 and gin/13 to gin/15 are drawn at their natural rates
+// and fail by default naming the bug; under HEGEL_NO_KNOWN=1 the requests with them are
+// filtered out.
+func TestHegelEngine(t *testing.T) {
+	judged(t, engineCases, judgeEngine)
+}
diff --git a/hegel_zoo_idioms_test.go b/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..f0e81ba
--- /dev/null
+++ b/hegel_zoo_idioms_test.go
@@ -0,0 +1,527 @@
+package gin
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia, go/carbon, go/orb, go/chi and go/go-debian harness
+// (hegel_idioms_test.go there; go/bubbles' internal/zootest/gen.go before it) with the hz
+// prefix: hegel-go has no weighted choice, biased coin, tuple or counted-list combinator.
+// (This target's old draw helpers hzDrawInt, hzChance(tc, pct) and hzPick are gone with the
+// generators that used them: hzChance(num, den) below is the generator of fair bits.) Every
+// generator built from them is a package-level value; the simplest alternative comes first so
+// that shrinking lands on it, except the shape of a recorded bug a wide property must reach
+// every run, which goes first at a solid weight and is never drawn under HEGEL_NO_KNOWN=1.
+// The weights are nominal: a weighted choice drawn alone comes out exact (the engine
+// enumerates a small die), but inside a case with other draws the engine favours the second
+// value of any bounded draw (go/chi measured it at about nine points over its share, whatever
+// the range), so the rates are what the probe and the collector (ZOO_COLLECT=1) measure;
+// hzFair, fairOver, fairInts, evenOver and fairTree (from go/chi) re-roll that favourite face
+// and realise their weights within a point or two, the die* family at the end of this file
+// (from go/go-debian) draws from fair bits, and the figure beside every weight in
+// hegel_zoo_routes_test.go is the measured one.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].gen
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].gen
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var gens []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			gens = append(gens, hegel.Just(vs[i]))
+		} else {
+			gens = append(gens, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(gens)), func(i int) hegel.Generator[T] { return gens[i] })
+	}
+	choices := make([]hzChoice[T], len(gens))
+	for i, g := range gens {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
diff --git a/hegel_zoo_path_test.go b/hegel_zoo_path_test.go
new file mode 100644
index 0000000..9352062
--- /dev/null
+++ b/hegel_zoo_path_test.go
@@ -0,0 +1,59 @@
+package gin
+
+import (
+	"path"
+	"strings"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- cleanPath
+//
+// path.go: "cleanPath is the URL version of path.Clean, it returns a canonical URL path for
+// p, eliminating . and .. elements. The following rules are applied iteratively until no
+// further processing can be done: 1. Replace multiple slashes with a single slash. 2.
+// Eliminate each . path name element (the current directory). 3. Eliminate each inner ..
+// path name element (the parent directory) along with the non-.. element that precedes it.
+// 4. Eliminate .. elements that begin a rooted path: that is, replace "/.." by "/" at the
+// beginning of a path. If the result of this process is an empty string, "/" is returned."
+// Unlike path.Clean it keeps a trailing slash, and a path is always rooted.
+
+// hzModelCleanPath is path.Clean on the rooted path, with the trailing slash kept.
+func hzModelCleanPath(p string) string {
+	if p == "" {
+		return "/"
+	}
+	rooted := p
+	if p[0] != '/' {
+		rooted = "/" + p
+	}
+	out := path.Clean(rooted)
+	// a path ending in "/." is a directory too; one ending in "/.." is not (as in httprouter)
+	trailing := strings.HasSuffix(p, "/") || strings.HasSuffix(rooted, "/.")
+	if trailing && out != "/" {
+		out += "/"
+	}
+	return out
+}
+
+// cleanExpected states what cleanPath must give for the case: the cleaned path (clean) and
+// that cleaning it again changes nothing (idempotent). No switch, no shape.
+func cleanExpected(c cleanCase, _ known) checks {
+	return checks{"clean": hzModelCleanPath(c.text()), "idempotent": "true"}
+}
+
+// cleanActual asks the library.
+func cleanActual(c cleanCase) checks {
+	got := checks{}
+	out := cleanPath(c.text())
+	got["clean"] = out
+	got.set("idempotent", cleanPath(out) == out)
+	return got
+}
+
+// TestHegelCleanPath: cleanPath agrees with path.Clean (trailing slash kept), and is
+// idempotent.
+func TestHegelCleanPath(t *testing.T) {
+	judged(t, cleanCases, func(j *hzCaseJudge, c cleanCase) {
+		judgeBy(j, c, cleanExpected, cleanActual)
+	})
+}
diff --git a/hegel_zoo_pins_test.go b/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..6bbd2e3
--- /dev/null
+++ b/hegel_zoo_pins_test.go
@@ -0,0 +1,215 @@
+package gin
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- pins
+//
+// One test per recorded bug (bugs.toml), asserting the documented behaviour; they are expected
+// failures while the bug exists.
+
+func hzPinEngine(routes ...string) *Engine {
+	e := New()
+	hzPlain(e)
+	for i, r := range routes {
+		e.GET(r, hzHandler(i+1))
+	}
+	return e
+}
+
+// TestHegelPinTrailingSlashShadowsParam: gin/1. A request that matches a :param route is served
+// by it even when a static route differing only by a trailing slash exists.
+func TestHegelPinTrailingSlashShadowsParam(t *testing.T) {
+	e := hzPinEngine("/b/", "/:name")
+	if w := hzServe(e, "GET", "/b"); w.Code != 200 || w.Body.String() != "R2|name=b" {
+		t.Errorf("GET /b with routes /b/ and /:name: %d %q, want 200 R2|name=b", w.Code, w.Body.String())
+	}
+	e = hzPinEngine("/a/b", "/:p/b/")
+	if w := hzServe(e, "GET", "/a/b/"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b/ with routes /a/b and /:p/b/: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	e = New()
+	e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false // RedirectTrailingSlash on
+	e.GET("/b/", hzHandler(1))
+	e.GET("/:name", hzHandler(2))
+	if w := hzServe(e, "GET", "/b"); w.Code != 200 {
+		t.Errorf("GET /b with routes /b/ and /:name and RedirectTrailingSlash: %d (Location %q), want 200", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinParamDeadEnd: gin/2. When a :param branch dead-ends, the router backtracks to the
+// wildcard sibling of an earlier node, as it does after a static mismatch.
+func TestHegelPinParamDeadEnd(t *testing.T) {
+	e := hzPinEngine("/a/:x", "/:p/b/c")
+	if w := hzServe(e, "GET", "/a/b/c"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b/c with routes /a/:x and /:p/b/c: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	e = hzPinEngine("/a/:x/", "/:p/b")
+	if w := hzServe(e, "GET", "/a/b"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b with routes /a/:x/ and /:p/b: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	// with RedirectFixedPath, the case-insensitive lookup (which does backtrack) finds the very
+	// path requested, and the engine redirects the request to itself
+	e = hzPinEngine("/a/:x", "/:p/b/c")
+	e.RedirectFixedPath = true
+	if w := hzServe(e, "GET", "/a/b/c"); w.Code != 200 {
+		t.Errorf("GET /a/b/c with routes /a/:x and /:p/b/c and RedirectFixedPath: %d (Location %q), want 200 R2|p=a", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinTrailingSlashRedirectToNothing: gin/3. RedirectTrailingSlash redirects only when
+// "a handler for the path with (without) the trailing slash exists".
+func TestHegelPinTrailingSlashRedirectToNothing(t *testing.T) {
+	for _, tc := range []struct {
+		routes []string
+		req    string
+	}{
+		{[]string{"/:a/:b"}, "/id/"},
+		{[]string{"/x/:p", "/xy"}, "/x/"},
+	} {
+		e := New()
+		e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false
+		for i, r := range tc.routes {
+			e.GET(r, hzHandler(i+1))
+		}
+		w := hzServe(e, "GET", tc.req)
+		if w.Code != 404 {
+			t.Errorf("GET %s with routes %v: %d (Location %q), want 404: no route exists for the redirect target", tc.req, tc.routes, w.Code, w.Header().Get("Location"))
+		}
+	}
+}
+
+// TestHegelPinFixedPathAfterParam: gin/4. RedirectFixedPath's case-insensitive lookup finds a
+// route with a *catch-all after a :param.
+func TestHegelPinFixedPathAfterParam(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.HandleMethodNotAllowed = false, false
+	e.RedirectFixedPath = true
+	e.GET("/a/:q/*rest", hzHandler(1))
+	if w := hzServe(e, "GET", "/A/x/y"); w.Code != 301 || w.Header().Get("Location") != "/a/x/y" {
+		t.Errorf("GET /A/x/y with route /a/:q/*rest and RedirectFixedPath: %d (Location %q), want 301 to /a/x/y", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinPlusInRawPath: gin/5. With UseRawPath and UnescapePathValues, a '+' in a path
+// value stays a '+' (it is a query-string convention, not a path one).
+func TestHegelPinPlusInRawPath(t *testing.T) {
+	e := New()
+	hzPlain(e)
+	e.UseRawPath, e.UnescapePathValues = true, true
+	e.GET("/:p", hzHandler(1))
+	if w := hzServe(e, "GET", "/a+b%2Fc"); w.Body.String() != "R1|p=a+b/c" {
+		t.Errorf("GET /a+b%%2Fc with route /:p, UseRawPath and UnescapePathValues: %q, want R1|p=a+b/c", w.Body.String())
+	}
+}
+
+// TestHegelPinFixedPathRedirectToNothing: gin/6. RedirectFixedPath redirects only when "a
+// handle can be found" for the fixed path.
+func TestHegelPinFixedPathRedirectToNothing(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.HandleMethodNotAllowed = false, false
+	e.RedirectFixedPath = true
+	e.GET("/a/:p/b", hzHandler(1))
+	for _, req := range []string{"/A/x/", "/a/x/"} {
+		if w := hzServe(e, "GET", req); w.Code != 404 {
+			t.Errorf("GET %s with route /a/:p/b and RedirectFixedPath: %d (Location %q), want 404: no route exists for the redirect target", req, w.Code, w.Header().Get("Location"))
+		}
+	}
+}
+
+// TestHegelPinSkippedNodesLeak: gin/7. The lookups of one request do not see each other's
+// state: with HandleMethodNotAllowed, a request no method serves is a 404, and the engine
+// does not panic.
+func TestHegelPinSkippedNodesLeak(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false, true
+	e.GET("/:name/*rest", hzHandler(1))
+	e.GET("/c/:p", hzHandler(2))
+	e.POST("/x", hzHandler(3))
+	if w := hzServe(e, "GET", "/c/a/b"); w.Code != 404 {
+		t.Errorf("GET /c/a/b with GET /:name/*rest, GET /c/:p and POST /x, HandleMethodNotAllowed: %d (Allow %q), want 404: no method serves it", w.Code, w.Header().Get("Allow"))
+	}
+	// the stack the lookups share has room for the most '/' in a route; every method tree's
+	// lookup leaves an entry, and the fourth overflows it
+	e = New()
+	e.RedirectTrailingSlash, e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false, true
+	for _, m := range []string{"GET", "POST", "PUT", "PATCH", "DELETE"} {
+		e.Handle(m, "/a/b/", hzHandler(1))
+		e.Handle(m, "/a/:x", hzHandler(2))
+	}
+	var code int
+	if r := hzCatch(func() { code = hzServe(e, "GET", "/a/b").Code }); r != nil {
+		t.Errorf("GET /a/b with /a/b/ and /a/:x on five methods, HandleMethodNotAllowed: panic %v, want a response (200 R2|x=b)", r)
+	} else if code != 200 {
+		t.Errorf("GET /a/b with /a/b/ and /a/:x on five methods, HandleMethodNotAllowed: %d, want 200 R2|x=b", code)
+	}
+}
+
+// TestHegelPinParamSiblingHidesTrailingSlash: gin/13. RedirectTrailingSlash redirects a request
+// to the path with a trailing slash when a route exists for it, whether or not a :param route
+// is registered beside the static branch.
+func TestHegelPinParamSiblingHidesTrailingSlash(t *testing.T) {
+	for _, tc := range []struct {
+		routes []string
+		req    string
+	}{
+		{[]string{"/a/*rest", "/:q/x"}, "/a"},
+		{[]string{"/a/", "/ab", "/:q/x"}, "/a"},
+	} {
+		e := New()
+		e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false
+		for i, r := range tc.routes {
+			e.GET(r, hzHandler(i+1))
+		}
+		w := hzServe(e, "GET", tc.req)
+		if w.Code != 301 || w.Header().Get("Location") != tc.req+"/" {
+			t.Errorf("GET %s with routes %v: %d (Location %q), want 301 to %s/ as without the :param route", tc.req, tc.routes, w.Code, w.Header().Get("Location"), tc.req)
+		}
+	}
+}
+
+// TestHegelPinMixedSegmentsOverflowStack: gin/14. Mixed static:param routes beside each other
+// at one position (a documented feature) must not make a request panic.
+func TestHegelPinMixedSegmentsOverflowStack(t *testing.T) {
+	for _, tc := range []struct {
+		routes []string
+		req    string
+		want   string
+	}{
+		{[]string{"/a:p", "/ab:p", "/abc"}, "/abc", "R3"},
+		{[]string{"/ab/", "/aba", "/:p/a", "/a:p", "/ab:p"}, "/ab/", "R1"},
+	} {
+		e := hzPinEngine(tc.routes...)
+		var w *httptest.ResponseRecorder
+		if r := hzCatch(func() { w = hzServe(e, "GET", tc.req) }); r != nil {
+			t.Errorf("GET %s with routes %v: panic %v, want 200 %s", tc.req, tc.routes, r, tc.want)
+		} else if w.Code != 200 || w.Body.String() != tc.want {
+			t.Errorf("GET %s with routes %v: %d %q, want 200 %s", tc.req, tc.routes, w.Code, w.Body.String(), tc.want)
+		}
+	}
+}
+
+// TestHegelPinEmptyParamTrailingSlash: gin/15. RedirectTrailingSlash redirects to the path with
+// the slash when the tree serves it, including through an empty :param value before the slash.
+func TestHegelPinEmptyParamTrailingSlash(t *testing.T) {
+	for _, tc := range []struct {
+		route string
+		req   string
+	}{
+		{"/ab:p/", "/ab"},
+		{"/:p/ab:p/", "/a/ab"},
+	} {
+		e := New()
+		e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false
+		e.GET(tc.route, hzHandler(1))
+		if w := hzServe(e, "GET", tc.req+"/"); w.Code != 200 {
+			t.Fatalf("GET %s/ with route %s: %d, the tree does not serve the path with the slash", tc.req, tc.route, w.Code)
+		}
+		w := hzServe(e, "GET", tc.req)
+		if w.Code != 301 || w.Header().Get("Location") != tc.req+"/" {
+			t.Errorf("GET %s with route %s: %d (Location %q), want 301 to %s/, which the tree serves", tc.req, tc.route, w.Code, w.Header().Get("Location"), tc.req)
+		}
+	}
+}
diff --git a/hegel_zoo_router_shapes_test.go b/hegel_zoo_router_shapes_test.go
new file mode 100644
index 0000000..9b189bc
--- /dev/null
+++ b/hegel_zoo_router_shapes_test.go
@@ -0,0 +1,543 @@
+package gin
+
+// The narrow properties: one per recorded bug of the router (gin/1 to gin/7 and gin/13 to
+// gin/15), each over the region of that bug's shape with random contents (the ingredient
+// forced, the surroundings drawn: the atoms, the prefix, the method, the other options,
+// extra routes), judged by the wide property's model and judge (judgeMatch over
+// matchExpected for gin/1 and gin/2, judgeEngine over engineExpected for the rest). By
+// default each draws the shape and fails every run naming the bug; under HEGEL_NO_KNOWN=1
+// each draws the region past the shape (hzShaped) and passes. Each generator is filtered by
+// the classifier (regionOf: by default the cases it names as that bug, under NO_KNOWN the
+// cases it names as no bug) so that an extra route that spoils the shape is rejected (or,
+// under NO_KNOWN, one that makes it); the rejections measured over 3000 cases ("filtered
+// gin/N" by default / under NO_KNOWN): gin/1 30 / 9, gin/2 5 / 10, gin/3 386 / 34, gin/4
+// 96 / 0, gin/5 17 / 5, gin/6 98 / 0, gin/7 0 / 0, gin/13 133 / 436 (an extra route serving
+// the request or the path with the slash, as /:p or /*rest; under NO_KNOWN an extra :param
+// route beside the static branch), gin/14 0 / 0, gin/15 27 / 11 (an extra static route
+// serving the request or the path with the slash).
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the shared parts
+
+// letterAtoms are the static atoms made of letters (upper-casing changes them, which gin/4
+// and gin/6 need); valueAtoms the :param values of the shapes (no escapes, no dots).
+var (
+	letterAtoms = evenHalves("a", "b", "ab", "abc", "c", "x", "new", "id")
+	valueAtoms  = evenHalves("a", "b", "ab", "abc", "c", "x", "new", "id", "0", "-", "A", "B")
+	prefixes    = dieMaybe(50, hegel.Map(letterAtoms, func(a string) string { return "/" + a })) // a prefix nominal 50: realises 50
+	extraCounts = rangeHalves(0, 2)                                                              // 0 to 2 extra routes, nominal 33 each
+)
+
+// otherAtoms are the letter atoms other than not.
+func otherAtoms(not string) hegel.Generator[string] {
+	var rest []string
+	for _, a := range []string{"a", "b", "ab", "abc", "c", "x", "new", "id"} {
+		if a != not {
+			rest = append(rest, a)
+		}
+	}
+	return evenHalves(rest...)
+}
+
+// shapeRoutes numbers and reads the routes of one method, the shape's first and the extra
+// patterns after them.
+func shapeRoutes(method string, shape []string, extra []string) []*hzRoute {
+	var out []*hzRoute
+	for _, p := range append(append([]string(nil), shape...), extra...) {
+		r := &hzRoute{method: method, pattern: p, id: len(out) + 1}
+		r.toks, r.ok = hzTokenize(p)
+		out = append(out, r)
+	}
+	return out
+}
+
+// drawExtra is zero to two extra patterns of the wide generator.
+func drawExtra(tc hegel.TestCase) []string {
+	return hegel.Draw(tc, hegel.FlatMap(extraCounts, func(n int) hegel.Generator[[]string] { return hzCounted(patterns, n, n) }))
+}
+
+// staticOnly is the patterns without a wildcard (the tokenizer's reading): routes that add
+// no :param child to the tree - so no roll-back point is pushed for them on a walk (gin/14's
+// past region) and no rollback to them hides a node's "/"-child check (gin/13's ground,
+// beside gin/15's) - and no catch-all, which the "/"-child check accepts.
+func staticOnly(extra []string) []string {
+	var out []string
+	for _, p := range extra {
+		toks, ok := hzTokenize(p)
+		if !ok {
+			continue
+		}
+		static := true
+		for _, t := range toks {
+			static = static && t.kind == hzStatic
+		}
+		if static {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// drawOpts is the engine options with the three redirect switches fixed and the other three
+// drawn at the wide property's rates.
+func drawOpts(tc hegel.TestCase, tsr, fixed, mna bool) hzEngineOpts {
+	return hzEngineOpts{
+		tsr: tsr, fixed: fixed, mna: mna,
+		extraSlash: hegel.Draw(tc, dieCoin(30)),
+		rawPath:    hegel.Draw(tc, dieCoin(30)),
+		unescape:   hegel.Draw(tc, dieCoin(60)),
+	}
+}
+
+// --------------------------------------------------------------------------- gin/1
+
+// staticShadowsParamCases: a method, a prefix, an atom X and a :param name; the shape is a
+// static route one slash short of the request beside a :param route that matches it, in the
+// two instances of the bug's note - the route P/X/ with P/:n and the request P/X (the static
+// branch ends one "/" short of its route), or the route P/X/Y with P/:n/Y/ and the request
+// P/X/Y/ (the static branch ends with exactly "/" left); past the shape, the request the
+// static route serves (P/X/ or P/X/Y) or one through the :param with another atom.
+var staticShadowsParamCases = regionOf("gin/1", matchExpected, hegel.Composite(func(tc hegel.TestCase) matchCase {
+	method := hegel.Draw(tc, methodsAt(25))
+	p := hegel.Draw(tc, prefixes)
+	x := hegel.Draw(tc, letterAtoms)
+	n := hegel.Draw(tc, paramNames)
+	z := hegel.Draw(tc, otherAtoms(x))
+	oneShort := hegel.Draw(tc, dieCoin(50)) // the one-slash-short instance nominal 50
+	var shape []string
+	var want, past string
+	if oneShort {
+		shape = []string{p + "/" + x + "/", p + "/:" + n}
+		want = p + "/" + x
+		past = hegel.Draw(tc, evenHalves(p+"/"+x+"/", p+"/"+z))
+	} else {
+		y := hegel.Draw(tc, letterAtoms)
+		shape = []string{p + "/" + x + "/" + y, p + "/:" + n + "/" + y + "/"}
+		want = p + "/" + x + "/" + y + "/"
+		past = hegel.Draw(tc, evenHalves(p+"/"+x+"/"+y, p+"/"+z+"/"+y+"/"))
+	}
+	routes := shapeRoutes(method, shape, drawExtra(tc))
+	return matchCase{routes: routes, requests: []hzRequest{{method: method, raw: hzShaped(want, past)}}}
+}))
+
+// TestHegelStaticBranchesBacktrackToParams (gin/1): a static route one slash away from the
+// request does not shadow a :param route that matches it - the walk backtracks from the
+// static branch as the README documents.
+func TestHegelStaticBranchesBacktrackToParams(t *testing.T) {
+	judged(t, staticShadowsParamCases, judgeMatch)
+}
+
+// --------------------------------------------------------------------------- gin/2
+
+// paramDeadEndCases: the shape is a :param branch that dead-ends beside the :param child of
+// an earlier node that matches, in the note's two instances - the routes P/X/:x and
+// P/:p/Y/Z with the request P/X/Y/Z (the path goes on after the param, which has no
+// children), or P/X/:x/ and P/:p/Y with P/X/Y (the path ends at the param, which has no
+// handler); past the shape, the request the first route serves (P/X/Y, P/X/Y/) or one through
+// the second route's :param with another atom.
+var paramDeadEndCases = regionOf("gin/2", matchExpected, hegel.Composite(func(tc hegel.TestCase) matchCase {
+	method := hegel.Draw(tc, methodsAt(25))
+	p := hegel.Draw(tc, prefixes)
