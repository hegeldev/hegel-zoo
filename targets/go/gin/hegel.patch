index 0000000..0e4e7a0
--- /dev/null
+++ b/hegel_zoo_router_test.go
@@ -0,0 +1,789 @@
+package gin
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- route patterns
+//
+// README ("Parameters in path"): "/user/:name" matches "/user/john" but not "/user/" or
+// "/user"; "/user/:name/*action" matches "/user/john/" and "/user/john/send"; the router
+// "matches static routes before params and params before catch-all" and "supports routes with
+// parameters and static segments at the same position" (since v1.7, e.g. "/user/new" beside
+// "/user/:id"). tree.go: a ':' or '*' starts a wildcard that runs to the next '/'; "\:" is a
+// literal colon; a catch-all is only allowed at the end, after a '/'; two wildcards in one
+// segment, an unnamed wildcard, a catch-all conflicting with a sibling segment, two different
+// wildcards at one position and a second handler for one path all panic at registration.
+
+type hzTokKind int
+
+const (
+	hzStatic hzTokKind = iota
+	hzParam
+	hzCatchAll
+)
+
+type hzTok struct {
+	kind hzTokKind
+	text string // static text, or the wildcard's name
+}
+
+// hzTokenize splits a pattern into static text and wildcards the way tree.go reads it;
+// ok is false for the patterns the tree rejects with a panic.
+func hzTokenize(p string) (toks []hzTok, ok bool) {
+	var static strings.Builder
+	flush := func() {
+		if static.Len() > 0 {
+			toks = append(toks, hzTok{hzStatic, static.String()})
+			static.Reset()
+		}
+	}
+	for i := 0; i < len(p); i++ {
+		c := p[i]
+		switch {
+		case c == '\\':
+			if i+1 < len(p) && p[i+1] == ':' {
+				static.WriteByte(':') // "\:" is a literal colon (the tree unescapes it on the first request)
+				i++
+				continue
+			}
+			return nil, false // invalid escape
+		case c == ':' || c == '*':
+			end := i + 1
+			for end < len(p) && p[end] != '/' {
+				if p[end] == ':' || p[end] == '*' {
+					return nil, false // two wildcards in one segment
+				}
+				end++
+			}
+			if end == i+1 {
+				return nil, false // unnamed
+			}
+			flush()
+			if c == ':' {
+				toks = append(toks, hzTok{hzParam, p[i+1 : end]})
+			} else {
+				if end != len(p) || i == 0 || p[i-1] != '/' {
+					return nil, false // catch-all not at the end, or no '/' before it
+				}
+				// the '/' before the catch-all belongs to it
+				last := &toks[len(toks)-1]
+				last.text = last.text[:len(last.text)-1]
+				if last.text == "" {
+					toks = toks[:len(toks)-1]
+				}
+				toks = append(toks, hzTok{hzCatchAll, p[i+1 : end]})
+			}
+			i = end - 1
+		default:
+			static.WriteByte(c)
+		}
+	}
+	flush()
+	return toks, true
+}
+
+// hzRoute is a registered route: its method, pattern and the id its handler writes.
+type hzRoute struct {
+	method  string
+	pattern string
+	id      int
+	toks    []hzTok
+}
+
+// hzCand is a candidate in the model's search: a route with the position reached in its
+// tokens (tok index and offset within a static text).
+type hzCand struct {
+	r   *hzRoute
+	tok int
+	off int
+}
+
+func (c hzCand) done() bool { return c.tok == len(c.r.toks) }
+
+// hzMatch is what the model (and the engine) says about a path: the route and its params.
+type hzMatch struct {
+	route  *hzRoute
+	params []Param
+}
+
+// hzModelMatch finds the route for path among routes (one method): a depth-first walk over the
+// tree the routes make, node by node, that at every node tries the static child first, then
+// the :param child (the text up to the next '/', never at the very end of the path), then the
+// *catch-all (the rest, which starts with '/'). A failing static branch is abandoned for the
+// wildcard sibling of the nearest node above (backtracking) - except, while the recorded bugs
+// are switched on, where the tree gives up: when the static branch ends where a trailing-slash
+// redirect could be recommended (the path is exhausted one '/' short of a route, or has exactly
+// "/" left), or inside a :param branch (the path is exhausted, or nothing continues from the
+// param).
+func hzModelMatch(routes []*hzRoute, path string) (hzMatch, bool) {
+	s := hzWalk(routes, path, false)
+	return s.m, s.ok
+}
+
+// hzSkip is what the tree remembers when it takes the static child of a node that also has a
+// :param child: the param candidates, the path left at the node and the params so far.
+type hzSkip struct {
+	wild         []hzCand
+	rest         string
+	params       []Param
+	ci           string
+	handlersHere bool
+}
+
+// hzStep is the outcome of the model's walk: a match, or a stop that is hard (the tree does
+// not backtrack to an earlier wildcard) or soft; tsr is the tree's trailing-slash
+// recommendation (exact walk); fixed is the path RedirectFixedPath's lookup returns (fold
+// walk, where ok says that it returned one).
+type hzStep struct {
+	ok       bool
+	m        hzMatch
+	hard     bool
+	tsr      bool
+	fixed    string
+	failPath string // soft stop: the path left where the tree gave up
+	overflow bool   // the skipped-node stack overflowed: the tree panics
+}
+
+// hzWalk runs the model over routes (one method) for path; fold compares static text
+// case-insensitively and applies the rules of findCaseInsensitivePath.
+func hzWalk(routes []*hzRoute, path string, fold bool) hzStep {
+	s, _ := hzWalkStack(routes, path, fold, nil, 0)
+	return s
+}
+
+// hzWalkStack is hzWalk starting with the skipped-node stack another tree's walk left behind
+// (bug 7: getValue does not reset it), and returning the stack as this walk leaves it. A soft
+// stop pops the stack: an entry whose path ends with the path left is resumed at its :param
+// child - in the tree it came from. capacity is the stack's capacity (the most '/' in a
+// route); a push beyond it is the panic of bug 7.
+func hzWalkStack(routes []*hzRoute, path string, fold bool, stack []hzSkip, capacity int) (hzStep, []hzSkip) {
+	w := hzWalker{fold: fold, stack: stack, capacity: capacity}
+	s := hzStep{failPath: path}
+	if len(routes) > 0 {
+		cands := make([]hzCand, 0, len(routes))
+		for _, r := range routes {
+			cands = append(cands, hzCand{r: r})
+		}
+		s = w.node(cands, path, nil, "", true, false)
+	}
+	for !fold && !s.ok && !s.hard && !w.overflow && len(w.stack) > 0 {
+		top := w.stack[len(w.stack)-1]
+		w.stack = w.stack[:len(w.stack)-1]
+		if !strings.HasSuffix(top.ci+top.rest, s.failPath) {
+			continue
+		}
+		s = w.param(top.wild, top.rest, top.params, top.ci, top.handlersHere)
+	}
+	if w.overflow {
+		s = hzStep{overflow: true}
+	}
+	return s, w.stack
+}
+
+type hzWalker struct {
+	fold     bool
+	stack    []hzSkip
+	capacity int
+	overflow bool
+}
+
+func (w *hzWalker) push(s hzSkip) {
+	if w.capacity > 0 && len(w.stack) >= w.capacity {
+		w.overflow = true
+	}
+	w.stack = append(w.stack, s)
+}
+
+// rest is the static text a candidate has left in its current token ("" when a wildcard comes
+// next or the route is done).
+func (c hzCand) rest() string {
+	if c.done() {
+		return ""
+	}
+	if t := c.r.toks[c.tok]; t.kind == hzStatic {
+		return t.text[c.off:]
+	}
+	return ""
+}
+
+// advance moves a candidate over n static bytes.
+func (c hzCand) advance(n int) hzCand {
+	if n == 0 {
+		return c
+	}
+	c.off += n
+	if c.off == len(c.r.toks[c.tok].text) {
+		c.tok, c.off = c.tok+1, 0
+	}
+	return c
+}
+
+// next is the candidate's next token (static text starts at c.off).
+func (c hzCand) next() hzTok { return c.r.toks[c.tok] }
+
+// hzNodePrefix is the text of the tree node the candidates (all at its start) share: their
+// common static text, up to where one of them ends, continues with a wildcard or differs from
+// another. The candidates are exactly the routes through the node, so this is its path.
+func hzNodePrefix(cands []hzCand) string {
+	np := cands[0].rest()
+	for _, c := range cands[1:] {
+		r := c.rest()
+		n := 0
+		for n < len(np) && n < len(r) && np[n] == r[n] {
+			n++
+		}
+		np = np[:n]
+	}
+	return np
+}
+
+func hzLower(b byte) byte {
+	if 'A' <= b && b <= 'Z' {
+		return b + 'a' - 'A'
+	}
+	return b
+}
+
+func hzUpper(b byte) byte {
+	if 'a' <= b && b <= 'z' {
+		return b - 'a' + 'A'
+	}
+	return b
+}
+
+func (w *hzWalker) matched(r *hzRoute, ps []Param, ci string) hzStep {
+	return hzStep{ok: true, m: hzMatch{r, ps}, fixed: ci}
+}
+
+// node walks one tree node: cands are at its start, path is what is left of the request, ci
+// the exact text consumed (fold walk), root says this is the tree's root, prevHandlers that a
+// route ends exactly where this node starts.
+func (w *hzWalker) node(cands []hzCand, path string, params []Param, ci string, root, prevHandlers bool) hzStep {
+	np := hzNodePrefix(cands)
+	same := func(a, b string) bool {
+		if w.fold {
+			return strings.EqualFold(a, b)
+		}
+		return a == b
+	}
+	adv := make([]hzCand, 0, len(cands))
+	handlersHere := false // a route ends exactly at the end of this node
+	for _, c := range cands {
+		a := c.advance(len(np))
+		adv = append(adv, a)
+		if a.done() {
+			handlersHere = true
+		}
+	}
+	// a child at '/' that is a route (a "/" node with handlers) or a catch-all: a redirect to
+	// path + "/" is sound
+	slashChild := func() bool {
+		for _, a := range adv {
+			if a.done() {
+				continue
+			}
+			t := a.next()
+			if t.kind == hzCatchAll || (t.kind == hzStatic && t.text[a.off:] == "/" && a.tok == len(a.r.toks)-1) {
+				return true
+			}
+		}
+		return false
+	}
+
+	switch {
+	case len(path) > len(np) && same(path[:len(np)], np):
+		rest := path[len(np):]
+		ci += np
+		groups := map[byte][]hzCand{} // static children by first byte; a catch-all is the child at '/'
+		var wild []hzCand
+		for _, a := range adv {
+			if a.done() {
+				continue
+			}
+			switch t := a.next(); t.kind {
+			case hzStatic:
+				groups[t.text[a.off]] = append(groups[t.text[a.off]], a)
+			case hzCatchAll:
+				groups['/'] = append(groups['/'], a)
+			case hzParam:
+				wild = append(wild, a)
+			}
+		}
+		keys := []byte{rest[0]}
+		if w.fold {
+			lo, up := hzLower(rest[0]), hzUpper(rest[0])
+			keys = []byte{lo}
+			if up != lo {
+				keys = append(keys, up)
+			}
+		}
+		for _, k := range keys {
+			g := groups[k]
+			if len(g) == 0 {
+				continue
+			}
+			if t := g[0].next(); t.kind == hzCatchAll {
+				ps := append(append([]Param(nil), params...), Param{Key: t.text, Value: rest})
+				return w.matched(g[0].r, ps, ci+rest)
+			}
+			pushed := false
+			if !w.fold && len(wild) > 0 {
+				w.push(hzSkip{wild, rest, params, ci, handlersHere})
+				pushed = true
+			}
+			s := w.node(g, rest, params, ci, false, handlersHere)
+			if s.ok || s.hard || w.overflow {
+				return s
+			}
+			if pushed {
+				w.stack = w.stack[:len(w.stack)-1]
+			}
+			if !w.fold && len(wild) == 0 {
+				return s // the tree rolls back to a node above (soft)
+			}
+		}
+		if len(wild) > 0 {
+			return w.param(wild, rest, params, ci, handlersHere)
+		}
+		// no child continues here
+		if rest == "/" {
+			if w.fold {
+				if handlersHere {
+					return hzStep{ok: true, hard: true, fixed: ci}
+				}
+				return hzStep{}
+			}
+			return hzStep{hard: HZKnown.tsrBlocksBacktrack, tsr: handlersHere}
+		}
+		return hzStep{failPath: rest}
+
+	case same(path, np):
+		ci += np
+		for _, a := range adv {
+			if a.done() {
+				return w.matched(a.r, params, ci)
+			}
+		}
+		if w.fold {
+			if slashChild() {
+				return hzStep{ok: true, hard: true, fixed: ci + "/"}
+			}
+			return hzStep{}
+		}
+		if np == "/" && !root {
+			// a "/" node of its own, reached with exactly "/" left: no rollback, and a redirect to
+			// the path without the slash is recommended whether or not a route ends before it
+			return hzStep{hard: HZKnown.tsrBlocksBacktrack, tsr: prevHandlers || HZKnown.tsrWithoutRoute}
+		}
+		return hzStep{tsr: slashChild(), failPath: path}
+
+	default:
+		// the path ends inside this node, or differs from it
+		short := len(np) == len(path)+1 && np[len(path)] == '/' && same(path, np[:len(path)]) && handlersHere
+		if w.fold {
+			if path == "/" && (prevHandlers || HZKnown.fixedPathWithoutRoute) {
+				return hzStep{ok: true, hard: true, fixed: ci}
+			}
+			if short {
+				return hzStep{ok: true, hard: true, fixed: ci + np}
+			}
+			return hzStep{}
+		}
+		tsr := (path == "/" && (prevHandlers || HZKnown.tsrWithoutRoute)) || short
+		return hzStep{hard: (path == "/" || short) && HZKnown.tsrBlocksBacktrack, tsr: tsr, failPath: path}
+	}
+}
+
+// param walks the :param child of a node: wild are the param candidates, rest the path left
+// at the node, handlersHere says that a route ends at the node.
+func (w *hzWalker) param(wild []hzCand, rest string, params []Param, ci string, handlersHere bool) hzStep {
+	end := strings.IndexByte(rest, '/')
+	if end < 0 {
+		end = len(rest)
+	}
+	val := rest[:end]
+	ps := append(append([]Param(nil), params...), Param{Key: wild[0].next().text, Value: val})
+	var children []hzCand
+	var ends *hzRoute // the route that ends with this param
+	for _, a := range wild {
+		a.tok++
+		if a.done() {
+			ends = a.r
+		} else {
+			children = append(children, a)
+		}
+	}
+	if end < len(rest) {
+		if len(children) > 0 {
+			if w.fold && children[0].next().kind == hzCatchAll && HZKnown.fixedPathParamCatchAll {
+				return hzStep{} // bug 4: the lookup never reaches a catch-all after a :param
+			}
+			return w.node(children, rest[end:], ps, ci+val, false, ends != nil)
+		}
+		// nothing continues from the param: a redirect to the path without its trailing
+		// slash is recommended, sound when the value is not empty (the param route) or a
+		// route ends before the param
+		tsr := len(rest) == end+1 && (val != "" || handlersHere || HZKnown.tsrWithoutRoute)
+		if w.fold {
+			tsr = len(rest) == end+1 && (val != "" || handlersHere || HZKnown.fixedPathWithoutRoute)
+			if tsr {
+				return hzStep{ok: true, hard: true, fixed: ci + val}
+			}
+			return hzStep{}
+		}
+		return hzStep{hard: HZKnown.paramDeadEnd, tsr: tsr}
+	}
+	if ends != nil {
+		return w.matched(ends, ps, ci+val)
+	}
+	// the path is exhausted at the param: a "/" route or a catch-all below it makes a
+	// redirect to path + "/" sound
+	tsr := false
+	for _, ch := range children {
+		t := ch.next()
+		if t.kind == hzCatchAll && !(w.fold && HZKnown.fixedPathParamCatchAll) {
+			tsr = true
+		}
+		if t.kind == hzStatic && t.text == "/" && ch.tok == len(ch.r.toks)-1 {
+			tsr = true
+		}
+	}
+	if w.fold {
+		if tsr {
+			return hzStep{ok: true, hard: true, fixed: ci + val + "/"}
+		}
+		return hzStep{}
+	}
+	return hzStep{hard: HZKnown.paramDeadEnd, tsr: tsr}
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzSegAtoms = []string{"a", "b", "ab", "abc", "c", "x", "new", "user_", "id", "A", "B", "0", "-"}
+
+var hzParamNames = []string{"p", "q", "name"}
+
+// hzGenPattern makes a route pattern: 1-4 segments of static text, params, catch-alls (at the
+// end) and mixed segments such as "user_:name" or "id:id"; sometimes a trailing slash, an
+// escaped colon, or a shape the tree rejects.
+func hzGenPattern(tc hegel.TestCase) string {
+	var sb strings.Builder
+	n := hzDrawInt(tc, 1, 4)
+	for i := 0; i < n; i++ {
+		sb.WriteByte('/')
+		switch hzDrawInt(tc, 0, 11) {
+		case 0, 1, 2, 3, 4:
+			sb.WriteString(hzPick(tc, hzSegAtoms))
+		case 5, 6, 7:
+			sb.WriteString(":" + hzPick(tc, hzParamNames))
+		case 8:
+			sb.WriteString(hzPick(tc, hzSegAtoms) + ":" + hzPick(tc, hzParamNames))
+		case 9:
+			if i == n-1 {
+				sb.WriteString("*rest")
+			} else {
+				sb.WriteString(hzPick(tc, hzSegAtoms))
+			}
+		case 10:
+			// rejected shapes, rarely
+			if hzChance(tc, 30) {
+				sb.WriteString(hzPick(tc, []string{":p:q", ":", "*", "a*rest", ":p*q", "*rest/x", "a\\b"}))
+			} else {
+				sb.WriteString(hzPick(tc, hzSegAtoms))
+			}
+		default:
+			sb.WriteString("test\\:" + hzPick(tc, hzSegAtoms))
+		}
+	}
+	if hzChance(tc, 20) && !strings.Contains(sb.String(), "*") {
+		sb.WriteByte('/')
+	}
+	if hzChance(tc, 5) {
+		return "/"
+	}
+	return sb.String()
+}
+
+var hzPathAtoms = []string{"a", "b", "ab", "abc", "abd", "c", "x", "new", "user_x", "user_", "id", "id1", "A", "B", "0", "-", "", ".", "..", "%41", "a%2Fb", "a+b", "%C3%A9", "test\\:a", "test:a", "y"}
+
+// hzGenPath makes a raw request path: 0-5 segments from the atoms (empty segments give
+// repeated slashes), sometimes a trailing slash, sometimes built from a registered pattern
+// with its wildcards filled in.
+func hzGenPath(tc hegel.TestCase, routes []*hzRoute) string {
+	if len(routes) > 0 && hzChance(tc, 50) {
+		r := hzPick(tc, routes)
+		var statics []string
+		for _, o := range routes {
+			for _, t := range o.toks {
+				if t.kind == hzStatic {
+					for _, seg := range strings.Split(t.text, "/") {
+						if seg != "" {
+							statics = append(statics, seg)
+						}
+					}
+				}
+			}
+		}
+		var sb strings.Builder
+		for _, t := range r.toks {
+			switch t.kind {
+			case hzStatic:
+				sb.WriteString(t.text)
+			case hzParam:
+				if hzChance(tc, 15) {
+					// an empty value, or one with a slash-free surprise
+					sb.WriteString(hzPick(tc, []string{"", "%2F", ".", ".."}))
+				} else if len(statics) > 0 && hzChance(tc, 50) {
+					// a static segment of another route, so that static and param branches clash
+					sb.WriteString(hzPick(tc, statics))
+				} else {
+					sb.WriteString(hzPick(tc, hzPathAtoms[:16]))
+				}
+			case hzCatchAll:
+				sb.WriteByte('/')
+				sb.WriteString(hzPick(tc, []string{"", "a", "a/b", "a/b/", "..", "a//b"}))
+			}
+		}
+		p := sb.String()
+		switch hzDrawInt(tc, 0, 9) {
+		case 0:
+			if strings.HasSuffix(p, "/") && len(p) > 1 {
+				p = p[:len(p)-1]
+			} else {
+				p += "/"
+			}
+		case 1:
+			p += hzPick(tc, []string{"/x", "x", "/", "//"})
+		case 2:
+			p = strings.ToUpper(p)
+		}
+		return p
+	}
+	n := hzDrawInt(tc, 0, 5)
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		sb.WriteByte('/')
+		sb.WriteString(hzPick(tc, hzPathAtoms))
+	}
+	if n == 0 || hzChance(tc, 20) {
+		sb.WriteByte('/')
+	}
+	return sb.String()
+}
+
+var hzMethods = []string{http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete}
+
+var hzAllMethods = []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodHead, http.MethodOptions}
+
+// hzHandler writes the route's id and the params it received.
+func hzHandler(id int) HandlerFunc {
+	return func(c *Context) {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "R%d", id)
+		for _, p := range c.Params {
+			fmt.Fprintf(&sb, "|%s=%s", p.Key, p.Value)
+		}
+		c.String(200, "%s", sb.String())
+	}
+}
+
+// hzBuild registers the routes in order on a fresh engine; a route the tree rejects (a panic)
+// is dropped and the engine rebuilt from the ones before, so that a half-inserted route never
+// stays in the tree. Returns the engine, the accepted routes (in order) and the rejected ones.
+func hzBuild(routes []*hzRoute, configure func(*Engine)) (*Engine, []*hzRoute, []*hzRoute) {
+	accepted := append([]*hzRoute(nil), routes...)
+	var rejected []*hzRoute
+	for {
+		e := New()
+		if configure != nil {
+			configure(e)
+		}
+		bad := -1
+		for i, r := range accepted {
+			if p := hzCatch(func() { e.Handle(r.method, r.pattern, hzHandler(r.id)) }); p != nil {
+				bad = i
+				break
+			}
+		}
+		if bad < 0 {
+			return e, accepted, rejected
+		}
+		rejected = append(rejected, accepted[bad])
+		accepted = append(accepted[:bad:bad], accepted[bad+1:]...)
+	}
+}
+
+// hzGenRoutes makes 1-6 routes with distinct ids.
+func hzGenRoutes(tc hegel.TestCase) []*hzRoute {
+	n := hzDrawInt(tc, 1, 6)
+	routes := make([]*hzRoute, 0, n)
+	if hzChance(tc, 15) {
+		// the same one to three patterns on several methods: many method trees in one request
+		var pats []string
+		for k := hzDrawInt(tc, 1, 3); k > 0; k-- {
+			pats = append(pats, hzGenPattern(tc))
+		}
+		for _, m := range hzAllMethods[:hzDrawInt(tc, 2, len(hzAllMethods))] {
+			for _, p := range pats {
+				routes = append(routes, &hzRoute{method: m, pattern: p, id: len(routes) + 1})
+			}
+		}
+		return routes
+	}
+	for i := 0; i < n; i++ {
+		m := http.MethodGet
+		if hzChance(tc, 25) {
+			m = hzPick(tc, hzMethods)
+		}
+		routes = append(routes, &hzRoute{method: m, pattern: hzGenPattern(tc), id: i + 1})
+	}
+	return routes
+}
+
+// hzServe sends a request with the raw path and returns the response.
+func hzServe(e *Engine, method, rawPath string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, rawPath, nil)
+	w := httptest.NewRecorder()
+	e.ServeHTTP(w, req)
+	return w
+}
+
+// hzExpect is the model's answer for a request, in the handler's format.
+func hzExpect(m hzMatch) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "R%d", m.route.id)
+	for _, p := range m.params {
+		fmt.Fprintf(&sb, "|%s=%s", p.Key, p.Value)
+	}
+	return sb.String()
+}
+
+func hzShowRoutes(routes []*hzRoute) string {
+	var parts []string
+	for _, r := range routes {
+		parts = append(parts, fmt.Sprintf("R%d %s %s", r.id, r.method, r.pattern))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzByMethod returns the accepted routes of one method, tokenized.
+func hzByMethod(routes []*hzRoute, method string) []*hzRoute {
+	var out []*hzRoute
+	for _, r := range routes {
+		if r.method == method {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- properties
+
+// hzPlain turns every redirect and 405 handling off, so that a request is matched or 404.
+func hzPlain(e *Engine) {
+	e.RedirectTrailingSlash = false
+	e.RedirectFixedPath = false
+	e.HandleMethodNotAllowed = false
+}
+
+// TestHegelMatch: with redirects off, a request is served by the route the model picks, with
+// the model's params, or is a 404 when the model finds none.
+func TestHegelMatch(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzGenRoutes(ht)
+		for _, r := range routes {
+			r.toks, _ = hzTokenize(r.pattern)
+		}
+		e, accepted, rejected := hzBuild(routes, hzPlain)
+		for _, r := range rejected {
+			if _, ok := hzTokenize(r.pattern); !ok {
+				c.count("rejected: malformed")
+			} else {
+				c.count("rejected: conflict")
+			}
+		}
+		for k := 0; k < 3; k++ {
+			method := http.MethodGet
+			if hzChance(ht, 20) {
+				method = hzPick(ht, hzMethods)
+			}
+			raw := hzGenPath(ht, hzByMethod(accepted, method))
+			u, err := url.ParseRequestURI(raw)
+			if err != nil {
+				c.count("bad raw path")
+				continue
+			}
+			want, ok := hzModelMatch(hzByMethod(accepted, method), u.Path)
+			w := hzServe(e, method, raw)
+			if !ok {
+				c.count("no route")
+				if w.Code != 404 {
+					c.failClass(ht, "unexpected match", "%s %s (path %q) served %d %q, the model finds no route\n  routes %s", method, raw, u.Path, w.Code, w.Body.String(), hzShowRoutes(accepted))
+				}
+				continue
+			}
+			c.count("matched")
+			if w.Code != 200 {
+				c.failClass(ht, "missed match", "%s %s (path %q) served %d, the model matches %s\n  routes %s", method, raw, u.Path, w.Code, hzExpect(want), hzShowRoutes(accepted))
+				continue
+			}
+			if got := w.Body.String(); got != hzExpect(want) {
+				c.failClass(ht, "route or params", "%s %s (path %q)\n  got  %s\n  want %s\n  routes %s", method, raw, u.Path, got, hzExpect(want), hzShowRoutes(accepted))
+			}
+		}
+	})
+}
+
+// TestHegelRouteOrder: the routes a tree accepts, and what it serves, do not depend on the
+// order of registration.
+func TestHegelRouteOrder(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzGenRoutes(ht)
+		for _, r := range routes {
+			r.toks, _ = hzTokenize(r.pattern)
+		}
+		e1, accepted, _ := hzBuild(routes, hzPlain)
+		if len(accepted) < 2 {
+			c.count("fewer than 2 routes")
+			return
+		}
+		// another order of the accepted routes
+		perm := append([]*hzRoute(nil), accepted...)
+		for i := len(perm) - 1; i > 0; i-- {
+			j := hzDrawInt(ht, 0, i)
+			perm[i], perm[j] = perm[j], perm[i]
+		}
+		e2, accepted2, rejected2 := hzBuild(perm, hzPlain)
+		if len(rejected2) > 0 {
+			c.failClass(ht, "acceptance", "routes accepted in one order, rejected in another\n  order 1 %s\n  order 2 %s\n  rejected %s", hzShowRoutes(accepted), hzShowRoutes(perm), hzShowRoutes(rejected2))
+			return
+		}
+		_ = accepted2
+		c.count("same acceptance")
+		for k := 0; k < 3; k++ {
+			method := http.MethodGet
+			if hzChance(ht, 20) {
+				method = hzPick(ht, hzMethods)
+			}
+			raw := hzGenPath(ht, hzByMethod(accepted, method))
+			if _, err := url.ParseRequestURI(raw); err != nil {
+				continue
+			}
+			w1 := hzServe(e1, method, raw)
+			w2 := hzServe(e2, method, raw)
+			if w1.Code != w2.Code || w1.Body.String() != w2.Body.String() {
+				c.failClass(ht, "serving", "%s %s served differently by two registration orders\n  order 1 %s -> %d %q\n  order 2 %s -> %d %q", method, raw, hzShowRoutes(accepted), w1.Code, w1.Body.String(), hzShowRoutes(perm), w2.Code, w2.Body.String())
+			}
+		}
+	})
+}
diff --git a/hegel_zoo_test.go b/hegel_zoo_test.go
new file mode 100644
index 0000000..83daa84
--- /dev/null
+++ b/hegel_zoo_test.go
@@ -0,0 +1,169 @@
+package gin
+
+// Hegel property tests for gin-gonic/gin's router, written for the Hegel zoo. See
+// targets/go/gin/README.md. They live in package gin (not a subpackage) because the router
+// tree and cleanPath are unexported; every identifier here carries the hz prefix to stay clear
+// of the upstream tests.
+//
+// Oracles: a model of route matching (static text first, then a :param, then a *catch-all,
+// with backtracking) over generated route sets and request paths, walking the tree the routes
+// make node by node; the law that the set of routes a tree accepts, and what the tree matches,
+// do not depend on the order of registration; path.Clean as the oracle of cleanPath; a model
+// of the engine's answer (status, Location, Allow) under every combination of its options.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+func init() {
+	SetMode(ReleaseMode)
+}
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	tsrBlocksBacktrack     bool // 1: a static route one slash away from the request shadows a matching :param route (404, or a redirect)
+	paramDeadEnd           bool // 2: a :param branch that dead-ends is not abandoned for the wildcard sibling of an earlier node (404)
+	tsrWithoutRoute        bool // 3: RedirectTrailingSlash redirects a path ending in "/" to a path that has no route
+	fixedPathParamCatchAll bool // 4: RedirectFixedPath finds no route when a *catch-all follows a :param
+	plusToSpace            bool // 5: UseRawPath with UnescapePathValues turns '+' in a path value into a space
+	fixedPathWithoutRoute  bool // 6: RedirectFixedPath redirects a path ending in "/" to a path that has no route
+	skippedNodesLeak       bool // 7: the skipped-node stack is not reset between the method trees of one request (wrong 405, panic)
+}{true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
