+++ b/binding/hegel_zoo_form_model_test.go
@@ -0,0 +1,722 @@
+package binding
+
+// The models of the binding properties: bindExpected (the FormMapping family) and
+// mapDestExpected (the FormMapDest family), each a pure function of the case and the switch
+// set (known) returning every value the property checks, and the judges that compare the
+// library with them. With every switch off the model states the documented mapping
+// (docs/doc.md: "Bind default value if none provided", "Collection format for arrays", "Bind
+// Uri", the time_format examples, "Bind form-data request with custom struct"; the
+// BindUnmarshaler doc; a nil map is the zero value a user declares and is filled; a
+// destination by value is a user mistake the JSON binding answers with an error; an empty
+// value is the zero of every kind and the default when the tag has one). With a switch on
+// the model reproduces the package's rule for that bug as a replica of form_mapping.go:
+// gin/8 in mapDestExpected (setFormMap, lines 528-550: the map it is given is written into,
+// nil or not, line 536 and line 546; the last value of a list indexed at len-1, line 546),
+// gin/9 in hzBinder.mapping (a nil pointer field is allocated and entered whatever the
+// chain above it, lines 91-106 and 118-134), gin/10 in hzBinder.setField, setCollection and
+// mapping (trySetUsingParser and trySetCustom take value.Addr() before any parse, lines 192
+// and 204, called by setByForm at lines 266, 268, 291, 293, 314 and 316 once the key or a
+// default is there; a pointer field is value.Set at line 103 once something below it is
+// set), gin/11 in hzBinder.setJSON (setWithProperType hands the value, empty or not, to
+// json.Unmarshal for a struct or map, lines 376 and 378) and gin/12 in
+// hzBinder.setCollection (setByForm takes the default for a slice or array only when the
+// key has no values at all, lines 253 and 278).
+
+import (
+	"encoding"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// --------------------------------------------------------------------------- the model
+
+type hzOpt struct {
+	hasDefault bool
+	def        string
+	parser     string
+}
+
+// hzBinder fills a value from a form under the switches k; chain is the struct types being
+// mapped up the chain (the documented guard against entering a type again: gin/9).
+type hzBinder struct {
+	form  map[string][]string
+	tag   string
+	k     known
+	chain []reflect.Type
+}
+
+// hzErrAny stands for "some error" in a model result (the documentation names none): a
+// destination by value, and a nil map by value with a form to put into it.
+var hzErrAny = errors.New("hz: any error")
+
+// hzErrOverflow is the replica's answer where the package recurses without end (gin/9): the
+// process dies of a stack overflow.
+var hzErrOverflow = errors.New("hz: fatal error: stack overflow")
+
+// hzPanic is the replica's answer where the package panics (gin/10): the panic's message.
+type hzPanic struct{ msg string }
+
+func (p hzPanic) Error() string { return "panic: " + p.msg }
+
+// hzModelBind fills a fresh value of type t from the form, as the documentation describes
+// (and as the package does under the switches k), and returns it with the error the binding
+// should report: hzErrAny for a destination by value, an hzPanic or hzErrOverflow where a
+// replica says the package dies.
+func hzModelBind(t reflect.Type, form map[string][]string, tag string, byValue bool, k known) (reflect.Value, error) {
+	v := reflect.New(t)
+	if byValue && !k[kValueDestinationPanics] {
+		return v, hzErrAny
+	}
+	b := &hzBinder{form: form, tag: tag, k: k}
+	_, err := b.mapping(v.Elem(), reflect.StructField{}, !byValue)
+	return v, err
+}
+
+// mapping fills v (a struct, or what a struct field holds) and reports whether it set
+// anything; addressable is false below a destination passed by value, where the package
+// panics the moment it sets (gin/10).
+func (b *hzBinder) mapping(v reflect.Value, f reflect.StructField, addressable bool) (bool, error) {
+	if f.Tag.Get(b.tag) == "-" {
+		return false, nil
+	}
+	if v.Kind() == reflect.Pointer {
+		// a nil pointer is allocated only when something below it is set
+		vp := v
+		isNew := v.IsNil()
+		if isNew {
+			vp = reflect.New(v.Type().Elem())
+		}
+		ok, err := b.mapping(vp.Elem(), f, true)
+		if err != nil {
+			return false, err
+		}
+		if isNew && ok {
+			if !addressable && b.k[kValueDestinationPanics] {
+				return false, hzPanic{"reflect: reflect.Value.Set using unaddressable value"} // form_mapping.go line 103
+			}
+			v.Set(vp)
+		}
+		return ok, nil
+	}
+	isStruct := v.Kind() == reflect.Struct
+	if !isStruct || !f.Anonymous {
+		// a named field is set from its key; an embedded struct only contributes its fields
+		ok, err := b.setField(v, f, addressable)
+		if err != nil {
+			return false, err
+		}
+		if ok {
+			return true, nil
+		}
+	}
+	if isStruct {
+		t := v.Type()
+		for _, above := range b.chain {
+			if above == t {
+				// a type already being mapped up the chain is not entered again: a nil
+				// pointer to it stays nil (the package enters it, allocates its pointer
+				// field and enters again, without end: gin/9)
+				if b.k[kSelfReferenceOverflows] {
+					return false, hzErrOverflow
+				}
+				return false, nil
+			}
+		}
+		b.chain = append(b.chain, t)
+		defer func() { b.chain = b.chain[:len(b.chain)-1] }()
+		// the fields of a struct (named or embedded) are looked up by their own keys
+		isSet := false
+		for i := 0; i < v.NumField(); i++ {
+			sf := t.Field(i)
+			if sf.PkgPath != "" && !sf.Anonymous {
+				continue
+			}
+			ok, err := b.mapping(v.Field(i), sf, addressable)
+			if err != nil {
+				return false, err
+			}
+			isSet = isSet || ok
+		}
+		return isSet, nil
+	}
+	return false, nil
+}
+
+// hzPanicAddr is the package's panic on a destination by value: value.Addr() in
+// trySetUsingParser or trySetCustom (form_mapping.go lines 192 and 204).
+var hzPanicAddr = hzPanic{"reflect.Value.Addr of unaddressable value"}
+
+// setField sets v from the form entry its tag names.
+func (b *hzBinder) setField(v reflect.Value, f reflect.StructField, addressable bool) (bool, error) {
+	name, rest, _ := strings.Cut(f.Tag.Get(b.tag), ",")
+	if name == "" {
+		name = f.Name
+	}
+	if name == "" {
+		return false, nil // the top-level value itself
+	}
+	var opt hzOpt
+	for rest != "" {
+		var o string
+		o, rest, _ = strings.Cut(rest, ",")
+		k, val, _ := strings.Cut(o, "=")
+		switch k {
+		case "default":
+			opt.hasDefault = true
+			opt.def = val
+		case "parser":
+			opt.parser = val
+		}
+	}
+	vs, ok := b.form[name]
+	if !ok && !opt.hasDefault {
+		return false, nil
+	}
+	switch v.Kind() {
+	case reflect.Slice, reflect.Array:
+		return b.setCollection(vs, v, f, opt, addressable)
+	default:
+		if !addressable && b.k[kValueDestinationPanics] {
+			return false, hzPanicAddr
+		}
+		val := ""
+		if len(vs) > 0 && vs[0] != "" {
+			val = vs[0]
+		} else {
+			// absent, or provided empty: the default (TestMappingFormWithEmptyToDefault)
+			val = opt.def
+		}
+		return true, b.setScalar(val, v, f, opt)
+	}
+}
+
+// setCollection sets a slice or array field from its instances (form values), each split by
+// the collection_format's separator.
+func (b *hzBinder) setCollection(vs []string, v reflect.Value, f reflect.StructField, opt hzOpt, addressable bool) (bool, error) {
+	cf := f.Tag.Get("collection_format")
+	empty := len(vs) == 0
+	if !b.k[kEmptyValueWithoutDefault] && len(vs) == 1 && vs[0] == "" && opt.hasDefault {
+		empty = true // provided empty: like a scalar, the default applies (the package: form_mapping.go lines 253 and 278, len(vs) == 0 only)
+	}
+	if empty {
+		if !opt.hasDefault {
+			return false, nil
+		}
+		// the default's instances: ';'-separated for multi and csv (docs), else one value
+		// that the collection_format splits
+		def := opt.def
+		if cf == "" || cf == "multi" || cf == "csv" {
+			def = strings.ReplaceAll(def, ";", ",")
+		}
+		if cf == "" || cf == "multi" {
+			vs = strings.Split(def, ",")
+		} else {
+			vs = []string{def}
+		}
+	}
+	if !addressable && b.k[kValueDestinationPanics] {
+		return false, hzPanicAddr
+	}
+	// a collection type that is itself a BindUnmarshaler / TextUnmarshaler takes the first
+	// instance whole
+	if ok, err := b.custom(vs[0], v, opt); ok {
+		return true, err
+	}
+	sep, known := hzCollectionSep(cf)
+	if !known {
+		return false, fmt.Errorf("%s is not supported in the collection_format. (multi, csv, ssv, tsv, pipes)", cf)
+	}
+	if sep != "" {
+		var split []string
+		for _, s := range vs {
+			split = append(split, strings.Split(s, sep)...)
+		}
+		vs = split
+	}
+	if v.Kind() == reflect.Array {
+		if len(vs) != v.Len() {
+			return false, fmt.Errorf("%q is not valid value for %s", vs, v.Type().String())
+		}
+		// elements are written in place until the first error
+		for i, s := range vs {
+			if err := b.setScalar(s, v.Index(i), f, opt); err != nil {
+				return false, err
+			}
+		}
+		return true, nil
+	}
+	slice := reflect.MakeSlice(v.Type(), len(vs), len(vs))
+	for i, s := range vs {
+		if err := b.setScalar(s, slice.Index(i), f, opt); err != nil {
+			return false, err
+		}
+	}
+	v.Set(slice)
+	return true, nil
+}
+
+// custom applies the parser= interface, then BindUnmarshaler, when v's type implements it.
+func (b *hzBinder) custom(val string, v reflect.Value, opt hzOpt) (bool, error) {
+	pt := reflect.PointerTo(v.Type())
+	if opt.parser == "encoding.TextUnmarshaler" && pt.Implements(hzTextUnmarshaler) {
+		return true, v.Addr().Interface().(encoding.TextUnmarshaler).UnmarshalText([]byte(val))
+	}
+	if pt.Implements(hzBindUnmarshaler) {
+		return true, v.Addr().Interface().(BindUnmarshaler).UnmarshalParam(val)
+	}
+	return false, nil
+}
+
+// setScalar sets one value (a field, or an element of a collection) from its text.
+func (b *hzBinder) setScalar(val string, v reflect.Value, f reflect.StructField, opt hzOpt) error {
+	if ok, err := b.custom(val, v, opt); ok {
+		return err
+	}
+	if v.Kind() != reflect.String {
+		val = strings.TrimSpace(val)
+	}
+	switch v.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if v.Type() == hzTypeDuration {
+			if val == "" {
+				val = "0"
+			}
+			d, err := time.ParseDuration(val)
+			if err != nil {
+				return err
+			}
+			v.SetInt(int64(d))
+			return nil
+		}
+		if val == "" {
+			val = "0"
+		}
+		n, err := strconv.ParseInt(val, 10, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetInt(n)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if val == "" {
+			val = "0"
+		}
+		n, err := strconv.ParseUint(val, 10, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetUint(n)
+	case reflect.Bool:
+		if val == "" {
+			val = "false"
+		}
+		x, err := strconv.ParseBool(val)
+		if err != nil {
+			return err
+		}
+		v.SetBool(x)
+	case reflect.Float32, reflect.Float64:
+		if val == "" {
+			val = "0.0"
+		}
+		x, err := strconv.ParseFloat(val, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetFloat(x)
+	case reflect.String:
+		v.SetString(val)
+	case reflect.Struct:
+		if v.Type() == hzTypeTime {
+			return b.setTime(val, v, f)
+		}
+		return b.setJSON(val, v)
+	case reflect.Map:
+		return b.setJSON(val, v)
+	case reflect.Pointer:
+		if v.IsNil() {
+			v.Set(reflect.New(v.Type().Elem()))
+		}
+		return b.setScalar(val, v.Elem(), f, opt)
+	default:
+		return errUnknownType
+	}
+	return nil
+}
+
+// setJSON: a struct or map value is given as JSON; an empty value leaves it as it is, as an
+// empty value leaves every other kind at its zero (the package hands it to json.Unmarshal:
+// gin/11, form_mapping.go lines 376 and 378).
+func (b *hzBinder) setJSON(val string, v reflect.Value) error {
+	if val == "" && !b.k[kEmptyValueJSONError] {
+		return nil
+	}
+	return json.Unmarshal([]byte(val), v.Addr().Interface())
+}
+
+// setTime follows the time_format / time_utc / time_location tags (docs: "Custom struct
+// binding" examples; the unix formats are case-insensitive).
+func (b *hzBinder) setTime(val string, v reflect.Value, f reflect.StructField) error {
+	format := f.Tag.Get("time_format")
+	if format == "" {
+		format = time.RFC3339
+	}
+	if val == "" {
+		v.Set(reflect.ValueOf(time.Time{}))
+		return nil
+	}
+	switch lf := strings.ToLower(format); lf {
+	case "unix", "unixmilli", "unixmicro", "unixnano":
+		n, err := strconv.ParseInt(val, 10, 64)
+		if err != nil {
+			return err
+		}
+		var t time.Time
+		switch lf {
+		case "unix":
+			t = time.Unix(n, 0)
+		case "unixmilli":
+			t = time.UnixMilli(n)
+		case "unixmicro":
+			t = time.UnixMicro(n)
+		default:
+			t = time.Unix(0, n)
+		}
+		v.Set(reflect.ValueOf(t))
+		return nil
+	}
+	loc := time.Local
+	if utc, _ := strconv.ParseBool(f.Tag.Get("time_utc")); utc {
+		loc = time.UTC
+	}
+	if name := f.Tag.Get("time_location"); name != "" {
+		l, err := time.LoadLocation(name)
+		if err != nil {
+			return err
+		}
+		loc = l
+	}
+	t, err := time.ParseInLocation(format, val, loc)
+	if err != nil {
+		return err
+	}
+	v.Set(reflect.ValueOf(t))
+	return nil
+}
+
+// --------------------------------------------------------------------------- the values
+// as checked
+
+// hzErrClass names the kind of an error, for the collect statistics.
+func hzErrClass(err error) string {
+	if err == nil {
+		return "none"
+	}
+	s := err.Error()
+	switch {
+	case strings.HasPrefix(s, "strconv."):
+		return s[:strings.Index(s, ":")]
+	case strings.Contains(s, "collection_format"):
+		return "collection_format"
+	case strings.Contains(s, "not valid value"):
+		return "array-length"
+	case strings.HasPrefix(s, "parsing time"), strings.Contains(s, "unknown time zone"):
+		return "time"
+	case strings.HasPrefix(s, "time: "):
+		return "duration"
+	case strings.HasPrefix(s, "hzText"):
+		return "hzText"
+	case err == errUnknownType:
+		return "unknown-type"
+	}
+	return "json"
+}
+
+// hzErrText renders an error for comparison.
+func hzErrText(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// hzShowValue renders a value with its pointers followed.
+func hzShowValue(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return "nil"
+		}
+		return "&" + hzShowValue(v.Elem())
+	case reflect.Struct:
+		if v.Type() == hzTypeTime {
+			return v.Interface().(time.Time).String()
+		}
+		var parts []string
+		for i := 0; i < v.NumField(); i++ {
+			parts = append(parts, v.Type().Field(i).Name+":"+hzShowValue(v.Field(i)))
+		}
+		return "{" + strings.Join(parts, " ") + "}"
+	case reflect.Slice:
+		if v.IsNil() {
+			return "nil"
+		}
+		fallthrough
+	case reflect.Array:
+		var parts []string
+		for i := 0; i < v.Len(); i++ {
+			parts = append(parts, hzShowValue(v.Index(i)))
+		}
+		return "[" + strings.Join(parts, " ") + "]"
+	case reflect.Interface:
+		if v.IsNil() {
+			return "nil"
+		}
+		return hzShowValue(v.Elem())
+	}
+	return fmt.Sprintf("%#v", v.Interface())
+}
+
+// hzShowMap renders a map destination: "nil", or its entries in key order.
+func hzShowMap(v reflect.Value) string {
+	if v.IsNil() {
+		return "nil"
+	}
+	return fmt.Sprint(v.Interface())
+}
+
+// hzErrChecks is the error as checked: the message ("error"), or the class ("error class":
+// "some" or "none") where the model says only whether there is one (hzErrAny: a destination
+// by value, a nil map by value with a form to put into it).
+func hzErrChecks(w checks, err error) {
+	switch err {
+	case hzErrAny:
+		w["error class"] = "some"
+	case nil:
+		w["error class"] = "none"
+	default:
+		w["error"] = hzErrText(err)
+	}
+}
+
+// --------------------------------------------------------------------------- FormMapping
+
+// bindExpected states what MapFormWithTag must give for the case: "panic" (the message, ""
+// for none), "error" (the message, "<nil>" for none) and "value" (hzShowValue of the
+// destination; the value reached before an error is checked too). For a destination by
+// value neither can be stated: the documentation only says there is an error, so the model
+// states "error class" ("some"; with gin/10 on, "none" where the package sets nothing and
+// returns nil, or the panic - an error the package meets before its first set is "some" too,
+// and such a case is not a shape), and the value cannot be read back. Documented (every
+// switch off): hzModelBind's reading of the docs. With switches on: the package's panics on
+// a destination by value (gin/10), its JSON error on an empty value for a struct or map
+// (gin/11) and its empty element where a collection's default should apply (gin/12). Where
+// the replica says the package panics, the panic is all the model states.
+func bindExpected(c bindCase, k known) checks {
+	w := checks{"panic": ""}
+	v, err := hzModelBind(c.typ, c.form.form(), c.tag, c.byValue, k)
+	var p hzPanic
+	if errors.As(err, &p) {
+		return checks{"panic": p.msg}
+	}
+	if c.byValue {
+		if err != nil {
+			err = hzErrAny
+		}
+		hzErrChecks(w, err)
+		return w
+	}
+	w["error"] = hzErrText(err)
+	w["value"] = hzShowValue(v.Elem())
+	return w
+}
+
+// bindActual asks the library the model's questions: the destination (a fresh value of the
+// type, by pointer or by value) bound from the form, the panic if any (then all there is),
+// the error (and its class) and the value read back through the pointer.
+func bindActual(c bindCase) checks {
+	var holder reflect.Value
+	var dst any
+	if c.byValue {
+		dst = reflect.New(c.typ).Elem().Interface()
+	} else {
+		holder = reflect.New(c.typ)
+		dst = holder.Interface()
+	}
+	form := c.form.form()
+	var err error
+	if r := hzCatch(func() { err = MapFormWithTag(dst, form, c.tag) }); r != nil {
+		hzTally("panic")
+		return checks{"panic": fmt.Sprint(r)}
+	}
+	hzTally("err=" + hzErrClass(err))
+	got := checks{"panic": "", "error": hzErrText(err), "error class": "none"}
+	if err != nil {
+		got["error class"] = "some"
+	}
+	if !c.byValue {
+		got["value"] = hzShowValue(holder.Elem())
+	}
+	return got
+}
+
+// judgeBind is the judge of the FormMapping family (the wide property and the narrow ones of
+// gin/10, gin/11 and gin/12): judgeBy over bindExpected and bindActual.
+func judgeBind(j *hzCaseJudge, c bindCase) {
+	judgeBy(j, c, bindExpected, bindActual)
+}
+
+// --------------------------------------------------------------------------- FormMapDest
+
+var (
+	hzTypeMapStrSlice = reflect.TypeOf(map[string][]string{})
+
+	// hzEither separates the alternatives of a replica value the package decides by its map
+	// walk (a nil map[string]string given a key without values beside one with: which panic
+	// comes first depends on the order of the form's entries); agreement is membership
+	// (hzAgreesEither).
+	hzEither = " | "
+)
+
+// mapDestExpected states what MapFormWithTag must give for a map destination: "panic" (""
+// for none), "error" (or "error class" "some": a nil map by value with a form to put into
+// it - the documentation names no error for it) and "value" (hzShowMap of the map: stated
+// when the map is a form destination and there is no error). Documented (every switch off):
+// a map[string][]string receives every entry, a map[string]string the last value of each (a
+// key without values has nothing to give); other maps with string keys are an error
+// (ErrConvertMapStringSlice, ErrConvertToMapString); a map with other keys is left alone; a
+// nil map is filled (through the pointer) and stays nil with nothing to put into it. With
+// gin/8 on: the package writes into the nil map ("assignment to entry in nil map", as soon
+// as the form has a key) and indexes an empty value list ("index out of range [-1]").
+func mapDestExpected(c mapDestCase, k known) checks {
+	w := checks{"panic": ""}
+	mt := c.mapType
+	if mt.Key().Kind() != reflect.String {
+		w["error"] = "<nil>"
+		return w
+	}
+	if mt.Elem().Kind() == reflect.Slice && mt != hzTypeMapStrSlice {
+		w["error"] = hzErrText(ErrConvertMapStringSlice)
+		return w
+	}
+	if mt.Elem().Kind() != reflect.Slice && mt != hzTypeMapStr {
+		w["error"] = hzErrText(ErrConvertToMapString)
+		return w
+	}
+	form := c.form.form()
+	emptyLists, fullLists := 0, 0
+	for _, vs := range form {
+		if len(vs) == 0 {
+			emptyLists++
+		} else {
+			fullLists++
+		}
+	}
+	if c.nilMap {
+		if len(form) == 0 {
+			w["error"] = "<nil>"
+			w["value"] = "nil" // nothing to add: left nil
+			return w
+		}
+		if k[kNilMapPanics] {
+			nilMap, index := "assignment to entry in nil map", "runtime error: index out of range [-1]"
+			switch {
+			case mt == hzTypeMapStrSlice, emptyLists == 0:
+				return checks{"panic": nilMap}
+			case fullLists == 0:
+				return checks{"panic": index}
+			}
+			return checks{"panic": nilMap + hzEither + index}
+		}
+		if !c.byPointer {
+			w["error class"] = "some" // a nil map by value cannot be filled
+			return w
+		}
+	}
+	if k[kNilMapPanics] && mt == hzTypeMapStr && emptyLists > 0 {
+		return checks{"panic": "runtime error: index out of range [-1]"}
+	}
+	want := reflect.MakeMap(mt)
+	if !c.nilMap && c.entry != "" {
+		old := c.destination()
+		if old.Kind() == reflect.Pointer {
+			old = old.Elem()
+		}
+		for it := old.MapRange(); it.Next(); {
+			want.SetMapIndex(it.Key(), it.Value())
+		}
+	}
+	for key, vs := range form {
+		if mt.Elem().Kind() == reflect.Slice {
+			want.SetMapIndex(reflect.ValueOf(key), reflect.ValueOf(vs))
+			continue
+		}
+		if len(vs) == 0 {
+			continue // a key without values has nothing to give
+		}
+		want.SetMapIndex(reflect.ValueOf(key), reflect.ValueOf(vs[len(vs)-1]))
+	}
+	w["error"] = "<nil>"
+	w["value"] = hzShowMap(want)
+	return w
+}
+
+// mapDestActual asks the library the model's questions: the destination bound from the
+// form, the panic if any (then all there is), the error (and its class) and the map as left
+// (through the pointer, or the map itself, which the binding shares).
+func mapDestActual(c mapDestCase) checks {
+	dst := c.destination()
+	form := c.form.form()
+	var err error
+	if r := hzCatch(func() { err = MapFormWithTag(dst.Interface(), form, "form") }); r != nil {
+		hzTally("panic")
+		return checks{"panic": fmt.Sprint(r)}
+	}
+	hzTally("err=" + hzErrClass(err))
+	got := checks{"panic": "", "error": hzErrText(err), "error class": "none"}
+	if err != nil {
+		got["error class"] = "some"
+	}
+	m := dst
+	if m.Kind() == reflect.Pointer {
+		m = m.Elem()
+	}
+	got["value"] = hzShowMap(m)
+	return got
+}
+
+// hzAgreesEither is replica agreement where a replica value may list alternatives
+// (hzEither): the library's value is one of them.
+func hzAgreesEither(got, replica checks) bool {
+	if len(got) != len(replica) {
+		return false
+	}
+	for k, want := range replica {
+		g, ok := got[k]
+		if !ok {
+			return false
+		}
+		found := false
+		for _, alt := range strings.Split(want, hzEither) {
+			found = found || g == alt
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// judgeMapDest is the judge of the FormMapDest family (the wide property and the narrow one
+// of gin/8): the shape first, then the library against the documented values, the replica's
+// agreement by membership (verdictBy with hzAgreesEither).
+func judgeMapDest(j *hzCaseJudge, c mapDestCase) {
+	shape := classify(c, mapDestExpected)
+	j.Shape(shape)
+	want := mapDestExpected(c, hzKnownNone)
+	verdictBy(j, c, mapDestActual(c), want, shape, mapDestExpected, hzAgreesEither)
+}
