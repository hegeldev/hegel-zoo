+package binding
+
+// The form mapping (form_mapping.go) against a model of its documentation: docs/doc.md ("Bind
+// default value if none provided", "Collection format for arrays", "Bind Uri", the time_format
+// examples, "Bind form-data request with custom struct"), the BindUnmarshaler doc comment and
+// the shapes the package's own tests establish. Struct types are built at runtime with
+// reflect.StructOf so that the generator controls the field types, tags and nesting.
+
+import (
+	"encoding"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- custom types
+
+// hzHex implements BindUnmarshaler: a hexadecimal integer.
+type hzHex int
+
+func (h *hzHex) UnmarshalParam(param string) error {
+	v, err := strconv.ParseInt(param, 16, 64)
+	if err != nil {
+		return err
+	}
+	*h = hzHex(v)
+	return nil
+}
+
+// hzText implements encoding.TextUnmarshaler: upper-cases its text, rejects a '!'.
+type hzText string
+
+func (h *hzText) UnmarshalText(b []byte) error {
+	if strings.Contains(string(b), "!") {
+		return errors.New("hzText: bang")
+	}
+	*h = hzText(strings.ToUpper(string(b)))
+	return nil
+}
+
+var (
+	hzTypeString   = reflect.TypeOf("")
+	hzTypeInt      = reflect.TypeOf(0)
+	hzTypeInt8     = reflect.TypeOf(int8(0))
+	hzTypeUint16   = reflect.TypeOf(uint16(0))
+	hzTypeBool     = reflect.TypeOf(false)
+	hzTypeFloat64  = reflect.TypeOf(0.0)
+	hzTypeDuration = reflect.TypeOf(time.Duration(0))
+	hzTypeTime     = reflect.TypeOf(time.Time{})
+	hzTypeHex      = reflect.TypeOf(hzHex(0))
+	hzTypeText     = reflect.TypeOf(hzText(""))
+	hzTypeAny      = reflect.TypeOf((*any)(nil)).Elem()
+	hzTypeUintptr  = reflect.TypeOf(uintptr(0))
+	hzTypeMapInt   = reflect.TypeOf(map[string]int{})
+	hzTypeMapStr   = reflect.TypeOf(map[string]string{})
+
+	hzTextUnmarshaler = reflect.TypeOf((*encoding.TextUnmarshaler)(nil)).Elem()
+	hzBindUnmarshaler = reflect.TypeOf((*BindUnmarshaler)(nil)).Elem()
+)
+
+// --------------------------------------------------------------------------- generators
+
+var hzLeafTypes = []reflect.Type{
+	hzTypeString, hzTypeString, hzTypeInt, hzTypeInt, hzTypeInt8, hzTypeUint16, hzTypeBool,
+	hzTypeFloat64, hzTypeDuration, hzTypeTime, hzTypeTime, hzTypeHex, hzTypeText, hzTypeText,
+}
+
+var hzKeyPool = []string{"a", "b", "c", "d", "e", "f", "g", "h"}
+
+// hzGenType draws a field type; depth limits the nesting of structs.
+func hzGenType(tc hegel.TestCase, depth int) reflect.Type {
+	r := hzDrawInt(tc, 1, 100)
+	switch {
+	case r <= 48 || depth >= 2:
+		if hzChance(tc, 1) {
+			return hzPick(tc, []reflect.Type{hzTypeAny, hzTypeUintptr})
+		}
+		return hzPick(tc, hzLeafTypes)
+	case r <= 64:
+		return reflect.SliceOf(hzGenElem(tc, depth))
+	case r <= 72:
+		return reflect.ArrayOf(hzDrawInt(tc, 1, 3), hzGenElem(tc, depth))
+	case r <= 80:
+		if hzChance(tc, 40) {
+			return reflect.PointerTo(hzGenStruct(tc, depth+1))
+		}
+		return reflect.PointerTo(hzPick(tc, hzLeafTypes))
+	case r <= 86:
+		return hzPick(tc, []reflect.Type{hzTypeMapInt, hzTypeMapStr})
+	default:
+		return hzGenStruct(tc, depth+1)
+	}
+}
+
+// hzGenElem draws the element type of a slice or array.
+func hzGenElem(tc hegel.TestCase, depth int) reflect.Type {
+	r := hzDrawInt(tc, 1, 100)
+	switch {
+	case r <= 70 || depth >= 2:
+		return hzPick(tc, hzLeafTypes)
+	case r <= 85:
+		return reflect.PointerTo(hzPick(tc, hzLeafTypes))
+	default:
+		return hzGenStruct(tc, depth+1)
+	}
+}
+
+// hzGenStruct draws a struct type of 1-4 exported fields; tag is the mapping's tag name.
+// Field names are unique inside one struct; keys (tag names) collide on purpose.
+func hzGenStruct(tc hegel.TestCase, depth int) reflect.Type {
+	tag := hzCurrentTag
+	n := hzDrawInt(tc, 1, 4)
+	fields := make([]reflect.StructField, 0, n)
+	for i := 0; i < n; i++ {
+		ft := hzGenType(tc, depth)
+		sf := reflect.StructField{Name: fmt.Sprintf("F%d", i), Type: ft}
+		isStruct := ft.Kind() == reflect.Struct && ft != hzTypeTime ||
+			ft.Kind() == reflect.Pointer && ft.Elem().Kind() == reflect.Struct && ft.Elem() != hzTypeTime
+		if isStruct && hzChance(tc, 35) {
+			sf.Anonymous = true
+		}
+		sf.Tag = reflect.StructTag(hzGenTag(tc, tag, ft))
+		fields = append(fields, sf)
+	}
+	return reflect.StructOf(fields)
+}
+
+// hzCurrentTag is the tag name of the case being generated ("form" or "uri"); hzKeySerial
+// numbers the keys of their own.
+var (
+	hzCurrentTag = "form"
+	hzKeySerial  = 0
+)
+
+// hzGenTag draws the struct tag of a field of type ft.
+func hzGenTag(tc hegel.TestCase, tag string, ft reflect.Type) string {
+	var parts []string
+	timeTag := ""
+	if hzHasTime(ft) && hzChance(tc, 70) {
+		var tt []string
+		if f := hzPick(tc, []string{"", "", "2006-01-02", "unix", "UnixMilli", "unixnano", "15:04:05", "unixmicro"}); f != "" {
+			tt = append(tt, `time_format:"`+f+`"`)
+		}
+		if u := hzPick(tc, []string{"", "", "1", "true", "0", "x"}); u != "" {
+			tt = append(tt, `time_utc:"`+u+`"`)
+		}
+		if l := hzPick(tc, []string{"", "", "", "", "", "", "", "UTC", "UTC", "Asia/Tokyo", "Asia/Tokyo", "Local", "Nowhere/City"}); l != "" {
+			tt = append(tt, `time_location:"`+l+`"`)
+		}
+		timeTag = strings.Join(tt, " ")
+	}
+	r := hzDrawInt(tc, 1, 100)
+	switch {
+	case r <= 8:
+		// no mapping tag at all: the field name is the key
+	case r <= 14:
+		parts = append(parts, tag+`:"-"`)
+	default:
+		name := ""
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 62:
+			// a key of its own (the pool's keys collide across fields on purpose)
+			hzKeySerial++
+			name = fmt.Sprintf("k%d", hzKeySerial)
+		case r <= 80:
+			name = hzPick(tc, hzKeyPool)
+		}
+		opts := []string{name}
+		defaultPct := 40
+		switch leaf := hzLeafOf(ft); {
+		case leaf == hzTypeAny || leaf == hzTypeUintptr:
+			defaultPct = 0 // no text is a value of these
+		case leaf.Kind() == reflect.Struct && leaf != hzTypeTime, leaf.Kind() == reflect.Map:
+			defaultPct = 10 // a JSON default is a rare thing to write
+		}
+		if hzChance(tc, defaultPct) {
+			opts = append(opts, "default="+hzGenDefault(tc, ft, timeTag))
+		}
+		if hzChance(tc, 15) {
+			opts = append(opts, "parser=encoding.TextUnmarshaler")
+		}
+		if hzChance(tc, 8) {
+			opts = append(opts, "omitempty")
+		}
+		if defaultPct > 0 && hzChance(tc, 4) {
+			opts = append(opts, "default")
+		}
+		// a stray option order: the name is always first, as the syntax wants
+		parts = append(parts, tag+`:"`+strings.Join(opts, ",")+`"`)
+	}
+	if hzChance(tc, 10) {
+		other := "uri"
+		if tag == "uri" {
+			other = "form"
+		}
+		parts = append(parts, other+`:"`+hzPick(tc, hzKeyPool)+`"`)
+	}
+	k := ft.Kind()
+	if (k == reflect.Slice || k == reflect.Array || hzChance(tc, 5)) && hzChance(tc, 60) {
+		cf := hzPick(tc, []string{"multi", "csv", "csv", "csv", "ssv", "ssv", "tsv", "pipes", "pipes", "multi", "csv", "ssv", "pipes", "tsv", "csv", "bad"})
+		parts = append(parts, `collection_format:"`+cf+`"`)
+	}
+	if timeTag != "" {
+		parts = append(parts, timeTag)
+	}
+	return strings.Join(parts, " ")
+}
+
+// hzHasTime reports whether a value of type t holds a time.Time reached by the mapping
+// through pointers, slices and arrays (not through structs: those have their own tags).
+func hzHasTime(t reflect.Type) bool {
+	for {
+		switch t.Kind() {
+		case reflect.Pointer, reflect.Slice, reflect.Array:
+			t = t.Elem()
+		default:
+			return t == hzTypeTime
+		}
+	}
+}
+
+// hzLeafOf is the leaf type a value of type t is parsed as (through pointers, slices, arrays).
+func hzLeafOf(t reflect.Type) reflect.Type {
+	for {
+		switch t.Kind() {
+		case reflect.Pointer, reflect.Slice, reflect.Array:
+			t = t.Elem()
+		default:
+			return t
+		}
+	}
+}
+
+// hzFieldValues: form values for a field, fit for its leaf type and time_format (or bad).
+func hzFieldValues(sf reflect.StructField, bad bool) []string {
+	leaf := hzLeafOf(sf.Type)
+	if leaf == hzTypeTime {
+		format := strings.ToLower(sf.Tag.Get("time_format"))
+		switch {
+		case strings.HasPrefix(format, "unix"):
+			if bad {
+				return []string{"1600000000x", "2020-01-02", ""}
+			}
+			return []string{"1600000000", "1600000000123", "0", "-5", " 7 ", ""}
+		case format == "2006-01-02":
+			if bad {
+				return []string{"2020-13-01", "2020-01-02T03:04:05Z", "x"}
+			}
+			return []string{"2020-01-02", "1999-12-31", " 2020-01-02 ", ""}
+		case format == "15:04:05":
+			if bad {
+				return []string{"25:00:00", "2020-01-02", "x"}
+			}
+			return []string{"03:04:05", "23:59:59", ""}
+		}
+	}
+	if leaf.Kind() == reflect.Struct && leaf != hzTypeTime {
+		if bad {
+			return []string{`bad`, `[1]`, `{`, `7`}
+		}
+		return []string{`{}`, `{"zz":1}`, `{"F0":null}`, "", `{"F0":null,"F1":null}`}
+	}
+	if leaf.Kind() == reflect.Map {
+		if bad {
+			return []string{`bad`, `[1]`, `{"a":[]}`, `7`}
+		}
+		if leaf.Elem().Kind() == reflect.Int {
+			return []string{`{"one":1}`, `{}`, "", `{"a":1,"b":-2}`}
+		}
+		return []string{`{"a":"1"}`, `{}`, "", `{"a":"x","b":""}`}
+	}
+	vals := hzValuePool(leaf, bad)
+	if k := sf.Type.Kind(); (k == reflect.Slice || k == reflect.Array) && !bad && leaf != hzTypeString {
+		// instances holding several values, for the collection_format
+		sep, _ := hzCollectionSep(sf.Tag.Get("collection_format"))
+		if sep != "" {
+			one := vals[0]
+			if leaf == hzTypeTime {
+				one = "0"
+			}
+			vals = append(vals, one+sep+one, one+sep+one+sep+one)
+		}
+	}
+	return vals
+}
+
+// hzValuePool: form values that parse as a leaf type, and (bad) ones that do not.
+func hzValuePool(leaf reflect.Type, bad bool) []string {
+	switch {
+	case leaf == hzTypeDuration:
+		if bad {
+			return []string{"x", "10", "1h;2h"}
+		}
+		return []string{"1h", "5ms", "-2s", "", " 3s ", "0"}
+	case leaf == hzTypeTime:
+		if bad {
+			return []string{"bad", "2020-13-01", "1600000000x"}
+		}
+		return []string{"2020-01-02T03:04:05Z", "2020-01-02", "03:04:05", "1600000000",
+			"1600000000123", "", "2020-01-02T03:04:05+09:00", " 2020-01-02 "}
+	case leaf == hzTypeHex:
+		if bad {
+			return []string{"zz", "1.5"}
+		}
+		return []string{"ff", "1A", "", "10"}
+	case leaf == hzTypeText:
+		if bad {
+			return []string{"a!b", "!"}
+		}
+		return []string{"abc", "", "Xy z", "a,b"}
+	case leaf == hzTypeString:
+		return []string{"abc", "", "a b", "a,b", "a|b", "a\tb", " x ", "1;2"}
+	}
+	switch leaf.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Uint16:
+		if bad {
+			return []string{"x", "70000", "-3", "1.5", "1,2", "1 2", "1|2", "1\t2"}
+		}
+		return []string{"0", "7", "12", "100", " 5 ", "", "+2", "1", "9"}
+	case reflect.Bool:
+		if bad {
+			return []string{"yes", "2", "true false"}
+		}
+		return []string{"true", "1", "T", "false", "0", "", " t "}
+	case reflect.Float64:
+		if bad {
+			return []string{"x", "1.5,2", "1,5"}
+		}
+		return []string{"1.5", "-2", "1e3", "", " 2 ", "0", "3"}
+	case reflect.Struct, reflect.Map:
+		if bad {
+			return []string{`bad`, `[1]`, `{`}
+		}
+		return []string{"", `{}`}
+	}
+	return []string{"x", "", "1"}
+}
+
+var hzAnyValues = []string{"0", "7", "x", "", "true", "1.5", "a,b", "a b", "ff", "2020-01-02", `{}`, "1h", " 1 "}
+
+// hzGenDefault draws a default= value for a field of type ft with the time tags timeTag (no
+// commas: the syntax reserves them; a ';' separates the instances of a collection).
+func hzGenDefault(tc hegel.TestCase, ft reflect.Type, timeTag string) string {
+	leaf := hzLeafOf(ft)
+	if hzChance(tc, 8) {
+		return ""
+	}
+	one := func() string {
+		for i := 0; i < 8; i++ {
+			v := hzPick(tc, hzFieldValues(reflect.StructField{Type: leaf, Tag: reflect.StructTag(timeTag)}, hzChance(tc, 4)))
+			if !strings.ContainsAny(v, ",;=\t ") && v != "" {
+				return v
+			}
+		}
+		return "1"
+	}
+	k := ft.Kind()
+	if k == reflect.Slice || k == reflect.Array {
+		n := hzDrawInt(tc, 1, 3)
+		vals := make([]string, n)
+		for i := range vals {
+			vals[i] = one()
+		}
+		sep := hzPick(tc, []string{";", ";", " ", "|"})
+		return strings.Join(vals, sep)
+	}
+	return one()
+}
+
+// hzKeysOf lists the keys the mapping of type t looks up, with the field of each (the first
+// field for a repeated key).
+func hzKeysOf(t reflect.Type, tag string, keys map[string]reflect.StructField, order *[]string) {
+	for t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	if t.Kind() != reflect.Struct || t == hzTypeTime {
+		return
+	}
+	for i := 0; i < t.NumField(); i++ {
+		sf := t.Field(i)
+		tv := sf.Tag.Get(tag)
+		if tv == "-" {
+			continue
+		}
+		name, _, _ := strings.Cut(tv, ",")
+		if name == "" {
+			name = sf.Name
+		}
+		if _, seen := keys[name]; !seen {
+			keys[name] = sf
+			*order = append(*order, name)
+		}
+		hzKeysOf(sf.Type, tag, keys, order)
+	}
+}
+
+// hzGenForm draws the form for a destination of type t.
+func hzGenForm(tc hegel.TestCase, t reflect.Type, tag string) map[string][]string {
+	keys := map[string]reflect.StructField{}
+	var order []string
+	hzKeysOf(t, tag, keys, &order)
+	form := map[string][]string{}
+	for _, k := range order {
+		if !hzChance(tc, 65) {
+			continue
+		}
+		sf := keys[k]
+		n := hzDrawInt(tc, 0, 3)
+		if n == 0 && !hzChance(tc, 30) {
+			n = 1
+		}
+		if ft := sf.Type; ft.Kind() == reflect.Array && hzChance(tc, 60) {
+			n = ft.Len() // as many instances as the array has elements
+		}
+		vals := make([]string, n)
+		for i := range vals {
+			switch r := hzDrawInt(tc, 1, 100); {
+			case r <= 86:
+				vals[i] = hzPick(tc, hzFieldValues(sf, false))
+			case r <= 94:
+				vals[i] = hzPick(tc, hzFieldValues(sf, true))
+			default:
+				vals[i] = hzPick(tc, hzAnyValues)
+			}
+		}
+		form[k] = vals
+	}
+	if hzChance(tc, 25) {
+		form[hzPick(tc, []string{"zz", "F9", "A", "e"})] = []string{hzPick(tc, hzAnyValues)}
+	}
+	return form
+}
+
+// --------------------------------------------------------------------------- the model
+
+type hzOpt struct {
+	hasDefault bool
+	def        string
+	parser     string
+}
+
+type hzBinder struct {
+	form map[string][]string
+	tag  string
+}
+
+// hzErrAny stands for "some error" in a model result.
+var hzErrAny = errors.New("hz: any error")
+
+// hzModelBind fills a fresh value of the pointer type t's element from the form, as the
+// documentation describes, and returns it with the error the binding should report.
+func hzModelBind(t reflect.Type, form map[string][]string, tag string) (reflect.Value, error) {
+	b := &hzBinder{form: form, tag: tag}
+	v := reflect.New(t)
+	_, err := b.mapping(v, reflect.StructField{})
+	return v, err
+}
+
+// mapping fills v (a struct, or what a struct field holds) and reports whether it set anything.
+func (b *hzBinder) mapping(v reflect.Value, f reflect.StructField) (bool, error) {
+	if f.Tag.Get(b.tag) == "-" {
+		return false, nil
+	}
+	if v.Kind() == reflect.Pointer {
+		// a nil pointer is allocated only when something below it is set
+		vp := v
+		isNew := v.IsNil()
+		if isNew {
+			vp = reflect.New(v.Type().Elem())
+		}
+		ok, err := b.mapping(vp.Elem(), f)
+		if err != nil {
+			return false, err
+		}
+		if isNew && ok {
+			v.Set(vp)
+		}
+		return ok, nil
+	}
+	isStruct := v.Kind() == reflect.Struct
+	if !isStruct || !f.Anonymous {
+		// a named field is set from its key; an embedded struct only contributes its fields
+		ok, err := b.setField(v, f)
+		if err != nil {
+			return false, err
+		}
+		if ok {
+			return true, nil
+		}
+	}
+	if isStruct {
+		// the fields of a struct (named or embedded) are looked up by their own keys
+		isSet := false
+		t := v.Type()
+		for i := 0; i < v.NumField(); i++ {
+			sf := t.Field(i)
+			if sf.PkgPath != "" && !sf.Anonymous {
+				continue
+			}
+			ok, err := b.mapping(v.Field(i), sf)
+			if err != nil {
+				return false, err
+			}
+			isSet = isSet || ok
+		}
+		return isSet, nil
+	}
+	return false, nil
+}
+
+// setField sets v from the form entry its tag names.
+func (b *hzBinder) setField(v reflect.Value, f reflect.StructField) (bool, error) {
+	name, rest, _ := strings.Cut(f.Tag.Get(b.tag), ",")
+	if name == "" {
+		name = f.Name
+	}
+	if name == "" {
+		return false, nil // the top-level value itself
+	}
+	var opt hzOpt
+	for rest != "" {
+		var o string
+		o, rest, _ = strings.Cut(rest, ",")
+		k, val, _ := strings.Cut(o, "=")
+		switch k {
+		case "default":
+			opt.hasDefault = true
+			opt.def = val
+		case "parser":
+			opt.parser = val
+		}
+	}
+	vs, ok := b.form[name]
+	if !ok && !opt.hasDefault {
+		return false, nil
+	}
+	switch v.Kind() {
+	case reflect.Slice, reflect.Array:
+		return b.setCollection(vs, v, f, opt)
+	default:
+		val := ""
+		if len(vs) > 0 && vs[0] != "" {
+			val = vs[0]
+		} else {
+			// absent, or provided empty: the default (TestMappingFormWithEmptyToDefault)
+			val = opt.def
+		}
+		return true, b.setScalar(val, v, f, opt)
+	}
+}
+
+// hzCollectionSep is the separator of a collection_format ("" for one value per instance).
+func hzCollectionSep(cf string) (sep string, ok bool) {
+	switch cf {
+	case "", "multi":
+		return "", true
+	case "csv":
+		return ",", true
+	case "ssv":
+		return " ", true
+	case "tsv":
+		return "\t", true
+	case "pipes":
+		return "|", true
+	}
+	return "", false
+}
+
+// setCollection sets a slice or array field from its instances (form values), each split by
+// the collection_format's separator.
+func (b *hzBinder) setCollection(vs []string, v reflect.Value, f reflect.StructField, opt hzOpt) (bool, error) {
+	cf := f.Tag.Get("collection_format")
+	empty := len(vs) == 0
+	if !HZKnown.emptySliceValue && len(vs) == 1 && vs[0] == "" && opt.hasDefault {
+		empty = true // provided empty: like a scalar, the default applies
+	}
+	if empty {
+		if !opt.hasDefault {
+			return false, nil
+		}
+		// the default's instances: ';'-separated for multi and csv (docs), else one value
+		// that the collection_format splits
+		def := opt.def
+		if cf == "" || cf == "multi" || cf == "csv" {
+			def = strings.ReplaceAll(def, ";", ",")
+		}
+		if cf == "" || cf == "multi" {
+			vs = strings.Split(def, ",")
+		} else {
+			vs = []string{def}
+		}
+	}
+	// a collection type that is itself a BindUnmarshaler / TextUnmarshaler takes the first
+	// instance whole
+	if ok, err := b.custom(vs[0], v, opt); ok {
+		return true, err
+	}
+	sep, known := hzCollectionSep(cf)
+	if !known {
+		return false, fmt.Errorf("%s is not supported in the collection_format. (multi, csv, ssv, tsv, pipes)", cf)
+	}
+	if sep != "" {
+		var split []string
+		for _, s := range vs {
+			split = append(split, strings.Split(s, sep)...)
+		}
+		vs = split
+	}
+	if v.Kind() == reflect.Array {
+		if len(vs) != v.Len() {
+			return false, fmt.Errorf("%q is not valid value for %s", vs, v.Type().String())
+		}
+		// elements are written in place until the first error
+		for i, s := range vs {
+			if err := b.setScalar(s, v.Index(i), f, opt); err != nil {
+				return false, err
+			}
+		}
+		return true, nil
+	}
+	slice := reflect.MakeSlice(v.Type(), len(vs), len(vs))
+	for i, s := range vs {
+		if err := b.setScalar(s, slice.Index(i), f, opt); err != nil {
+			return false, err
+		}
+	}
+	v.Set(slice)
+	return true, nil
+}
+
+// custom applies the parser= interface, then BindUnmarshaler, when v's type implements it.
+func (b *hzBinder) custom(val string, v reflect.Value, opt hzOpt) (bool, error) {
+	pt := reflect.PointerTo(v.Type())
+	if opt.parser == "encoding.TextUnmarshaler" && pt.Implements(hzTextUnmarshaler) {
+		return true, v.Addr().Interface().(encoding.TextUnmarshaler).UnmarshalText([]byte(val))
+	}
+	if pt.Implements(hzBindUnmarshaler) {
+		return true, v.Addr().Interface().(BindUnmarshaler).UnmarshalParam(val)
+	}
+	return false, nil
+}
+
+// setScalar sets one value (a field, or an element of a collection) from its text.
+func (b *hzBinder) setScalar(val string, v reflect.Value, f reflect.StructField, opt hzOpt) error {
+	if ok, err := b.custom(val, v, opt); ok {
+		return err
+	}
+	if v.Kind() != reflect.String {
+		val = strings.TrimSpace(val)
+	}
+	switch v.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if v.Type() == hzTypeDuration {
+			if val == "" {
+				val = "0"
+			}
+			d, err := time.ParseDuration(val)
+			if err != nil {
+				return err
+			}
+			v.SetInt(int64(d))
+			return nil
+		}
+		if val == "" {
+			val = "0"
+		}
+		n, err := strconv.ParseInt(val, 10, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetInt(n)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if val == "" {
+			val = "0"
+		}
+		n, err := strconv.ParseUint(val, 10, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetUint(n)
+	case reflect.Bool:
+		if val == "" {
+			val = "false"
+		}
+		x, err := strconv.ParseBool(val)
+		if err != nil {
+			return err
+		}
+		v.SetBool(x)
+	case reflect.Float32, reflect.Float64:
+		if val == "" {
+			val = "0.0"
+		}
+		x, err := strconv.ParseFloat(val, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetFloat(x)
+	case reflect.String:
+		v.SetString(val)
+	case reflect.Struct:
+		if v.Type() == hzTypeTime {
+			return b.setTime(val, v, f)
+		}
+		return b.setJSON(val, v)
+	case reflect.Map:
+		return b.setJSON(val, v)
+	case reflect.Pointer:
+		if v.IsNil() {
+			v.Set(reflect.New(v.Type().Elem()))
+		}
+		return b.setScalar(val, v.Elem(), f, opt)
+	default:
+		return errUnknownType
+	}
+	return nil
+}
+
+// setJSON: a struct or map value is given as JSON; an empty value leaves it as it is, as an
+// empty value leaves every other kind at its zero.
+func (b *hzBinder) setJSON(val string, v reflect.Value) error {
+	if val == "" && !HZKnown.emptyValueJSON {
+		return nil
+	}
+	return json.Unmarshal([]byte(val), v.Addr().Interface())
+}
+
+// setTime follows the time_format / time_utc / time_location tags (docs: "Custom struct
+// binding" examples; the unix formats are case-insensitive).
+func (b *hzBinder) setTime(val string, v reflect.Value, f reflect.StructField) error {
+	format := f.Tag.Get("time_format")
+	if format == "" {
+		format = time.RFC3339
+	}
+	if val == "" {
+		v.Set(reflect.ValueOf(time.Time{}))
+		return nil
+	}
+	switch lf := strings.ToLower(format); lf {
+	case "unix", "unixmilli", "unixmicro", "unixnano":
+		n, err := strconv.ParseInt(val, 10, 64)
+		if err != nil {
+			return err
+		}
+		var t time.Time
+		switch lf {
+		case "unix":
+			t = time.Unix(n, 0)
+		case "unixmilli":
+			t = time.UnixMilli(n)
+		case "unixmicro":
+			t = time.UnixMicro(n)
+		default:
+			t = time.Unix(0, n)
+		}
+		v.Set(reflect.ValueOf(t))
+		return nil
+	}
+	loc := time.Local
+	if utc, _ := strconv.ParseBool(f.Tag.Get("time_utc")); utc {
+		loc = time.UTC
+	}
+	if name := f.Tag.Get("time_location"); name != "" {
+		l, err := time.LoadLocation(name)
+		if err != nil {
+			return err
+		}
+		loc = l
+	}
+	t, err := time.ParseInLocation(format, val, loc)
+	if err != nil {
+		return err
+	}
+	v.Set(reflect.ValueOf(t))
+	return nil
+}
+
+// --------------------------------------------------------------------------- properties
+
+// hzErrClass names the kind of an error, for the collect statistics.
+func hzErrClass(err error) string {
+	if err == nil {
+		return "none"
+	}
+	s := err.Error()
+	switch {
+	case strings.HasPrefix(s, "strconv."):
+		return s[:strings.Index(s, ":")]
+	case strings.Contains(s, "collection_format"):
+		return "collection_format"
+	case strings.Contains(s, "not valid value"):
+		return "array-length"
+	case strings.HasPrefix(s, "parsing time"), strings.Contains(s, "unknown time zone"):
+		return "time"
+	case strings.HasPrefix(s, "time: "):
+		return "duration"
+	case strings.HasPrefix(s, "hzText"):
+		return "hzText"
+	case err == errUnknownType:
+		return "unknown-type"
+	}
+	return "json"
+}
+
+// hzErrText renders an error for comparison.
+func hzErrText(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// hzShowForm renders a form deterministically.
+func hzShowForm(form map[string][]string) string {
+	var parts []string
+	for k, vs := range form {
+		parts = append(parts, fmt.Sprintf("%s=%q", k, vs))
+	}
+	hzSortStrings(parts)
+	return strings.Join(parts, " ")
+}
+
+func hzSortStrings(s []string) {
+	for i := 1; i < len(s); i++ {
+		for j := i; j > 0 && s[j] < s[j-1]; j-- {
+			s[j], s[j-1] = s[j-1], s[j]
+		}
+	}
+}
+
+// TestHegelFormMapping: MapFormWithTag on a runtime-built struct type against the model.
+func TestHegelFormMapping(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		tag := hzPick(tc, []string{"form", "form", "form", "uri"})
+		hzCurrentTag = tag
+		hzKeySerial = 0
+		st := hzGenStruct(tc, 0)
+		form := hzGenForm(tc, st, tag)
+
+		want, wantErr := hzModelBind(st, form, tag)
+		got := reflect.New(st)
+		var gotErr error
+		if r := hzCatch(func() { gotErr = MapFormWithTag(got.Interface(), form, tag) }); r != nil {
+			c.failClass(ht, "panic", "type %v\nform %s\npanic: %v", st, hzShowForm(form), r)
+			return
+		}
+		c.count("err=" + hzErrClass(gotErr))
+		if hzErrText(gotErr) != hzErrText(wantErr) {
+			c.failClass(ht, "error", "type %v\nform %s\n got error %v\nwant error %v", st, hzShowForm(form), gotErr, wantErr)
+			return
+		}
+		if !reflect.DeepEqual(got.Interface(), want.Interface()) {
+			c.failClass(ht, "value", "type %v\nform %s\n got %s\nwant %s\nerror %v", st, hzShowForm(form), hzShowValue(got.Elem()), hzShowValue(want.Elem()), gotErr)
+		}
+	})
+}
+
+// hzShowValue renders a value with its pointers followed.
+func hzShowValue(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return "nil"
+		}
+		return "&" + hzShowValue(v.Elem())
+	case reflect.Struct:
+		if v.Type() == hzTypeTime {
+			return v.Interface().(time.Time).String()
+		}
+		var parts []string
+		for i := 0; i < v.NumField(); i++ {
+			parts = append(parts, v.Type().Field(i).Name+":"+hzShowValue(v.Field(i)))
+		}
+		return "{" + strings.Join(parts, " ") + "}"
+	case reflect.Slice:
+		if v.IsNil() {
+			return "nil"
+		}
+		fallthrough
+	case reflect.Array:
+		var parts []string
+		for i := 0; i < v.Len(); i++ {
+			parts = append(parts, hzShowValue(v.Index(i)))
+		}
+		return "[" + strings.Join(parts, " ") + "]"
+	case reflect.Interface:
+		if v.IsNil() {
+			return "nil"
+		}
+		return hzShowValue(v.Elem())
+	}
+	return fmt.Sprintf("%#v", v.Interface())
+}
+
+// hzModelMapDest: the mapping into a map destination. A map[string][]string receives every
+// entry, a map[string]string the last value of each; other maps with string keys are an error;
+// a map with other keys is left alone (it is not a form destination). Returns the expected
+// map (nil when left alone), the error, and whether the package panics (a recorded bug).
+func hzModelMapDest(dst reflect.Value, form map[string][]string) (want reflect.Value, err error, panics bool) {
+	m := dst
+	if m.Kind() == reflect.Pointer {
+		m = m.Elem()
+	}
+	mt := m.Type()
+	if mt.Key().Kind() != reflect.String {
+		return reflect.Value{}, nil, false
+	}
+	if mt.Elem().Kind() == reflect.Slice && mt != reflect.TypeOf(map[string][]string{}) {
+		return reflect.Value{}, ErrConvertMapStringSlice, false
+	}
+	if mt.Elem().Kind() != reflect.Slice && mt != reflect.TypeOf(map[string]string{}) {
+		return reflect.Value{}, ErrConvertToMapString, false
+	}
+	if m.IsNil() {
+		if HZKnown.formMapPanics && len(form) > 0 {
+			return reflect.Value{}, nil, true
+		}
+		if len(form) == 0 {
+			return reflect.Zero(mt), nil, false // nothing to add: left nil
+		}
+		if dst.Kind() != reflect.Pointer {
+			return reflect.Value{}, hzErrAny, false // a nil map by value cannot be filled
+		}
+	}
+	want = reflect.MakeMap(mt)
+	if !m.IsNil() {
+		for it := m.MapRange(); it.Next(); {
+			want.SetMapIndex(it.Key(), it.Value())
+		}
+	}
+	for k, vs := range form {
+		if mt.Elem().Kind() == reflect.Slice {
+			want.SetMapIndex(reflect.ValueOf(k), reflect.ValueOf(vs))
+			continue
+		}
+		if len(vs) == 0 {
+			if HZKnown.formMapPanics {
+				return reflect.Value{}, nil, true
+			}
+			continue // a key without values has nothing to give
+		}
+		want.SetMapIndex(reflect.ValueOf(k), reflect.ValueOf(vs[len(vs)-1]))
+	}
+	return want, nil, false
+}
+
+// TestHegelFormMapDest: MapFormWithTag into map destinations, by value and by pointer, nil or
+// holding entries, against the model.
+func TestHegelFormMapDest(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		mt := hzPick(tc, []reflect.Type{
+			reflect.TypeOf(map[string]string{}), reflect.TypeOf(map[string]string{}),
+			reflect.TypeOf(map[string][]string{}), reflect.TypeOf(map[string][]string{}),
+			reflect.TypeOf(map[string]int{}), reflect.TypeOf(map[string][]int{}),
+			reflect.TypeOf(map[int]string{}),
+		})
+		// the form: 0-3 keys with 0-3 values each
+		form := map[string][]string{}
+		for i, n := 0, hzDrawInt(tc, 0, 3); i < n; i++ {
+			vals := make([]string, hzDrawInt(tc, 0, 3))
+			for j := range vals {
+				vals[j] = hzPick(tc, hzAnyValues)
+			}
+			form[hzPick(tc, hzKeyPool)] = vals
+		}
+		byPointer := hzChance(tc, 60)
+		nilMap := hzChance(tc, 30)
+		m := reflect.MakeMap(mt)
+		if nilMap {
+			m = reflect.Zero(mt)
+		} else if hzChance(tc, 50) && mt.Key().Kind() == reflect.String {
+			// an entry already there
+			k := reflect.ValueOf(hzPick(tc, hzKeyPool))
+			switch mt.Elem().Kind() {
+			case reflect.String:
+				m.SetMapIndex(k, reflect.ValueOf("old"))
+			case reflect.Int:
+				m.SetMapIndex(k, reflect.ValueOf(1))
+			case reflect.Slice:
+				m.SetMapIndex(k, reflect.Zero(mt.Elem()))
+			}
+		}
+		var dst reflect.Value
+		if byPointer {
+			dst = reflect.New(mt)
+			dst.Elem().Set(m)
+		} else {
+			if nilMap && !hzChance(tc, 30) {
+				dst = reflect.MakeMap(mt) // a nil map by value is rare
+				nilMap = false
+			} else {
+				dst = m
+			}
+		}
+		desc := fmt.Sprintf("%v byPointer=%v nil=%v form %s", mt, byPointer, nilMap, hzShowForm(form))
+		want, wantErr, wantPanic := hzModelMapDest(dst, form)
+
+		var gotErr error
+		r := hzCatch(func() { gotErr = MapFormWithTag(dst.Interface(), form, "form") })
+		c.count(fmt.Sprintf("panic=%v err=%v", r != nil, gotErr != nil))
+		if (r != nil) != wantPanic {
+			c.failClass(ht, "panic", "%s\n got panic %v\nwant panic %v", desc, r, wantPanic)
+			return
+		}
+		if wantPanic {
+			return
+		}
+		if wantErr == hzErrAny {
+			if gotErr == nil {
+				c.failClass(ht, "error", "%s\n got no error, want one", desc)
+			}
+			return
+		}
+		if !errors.Is(gotErr, wantErr) {
+			c.failClass(ht, "error", "%s\n got error %v\nwant error %v", desc, gotErr, wantErr)
+			return
+		}
+		if !want.IsValid() {
+			return
+		}
+		got := dst
+		if got.Kind() == reflect.Pointer {
+			got = got.Elem()
+		}
+		if !reflect.DeepEqual(got.Interface(), want.Interface()) {
+			c.failClass(ht, "value", "%s\n got %v\nwant %v", desc, got.Interface(), want.Interface())
+		}
+	})
+}
