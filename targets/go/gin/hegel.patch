+package binding
+
+// Pins: one test per recorded bug of the binding package (bugs.toml gin/8 ... gin/12), each
+// asserting the documented behaviour; they fail while the bug exists and are listed as
+// expected failures in target.toml.
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestHegelPinNilMapDestination: gin/8. Binding into a nil map (the usual `var m
+// map[string]string; c.ShouldBindQuery(&m)`) must fill it or return an error, not panic; a
+// key without values must not panic either.
+func TestHegelPinNilMapDestination(t *testing.T) {
+	form := map[string][]string{"a": {"1"}, "b": {"2", "3"}}
+	var m map[string]string
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(&m, form, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("nil map[string]string by pointer: panic %v", r)
+	} else if m != nil && !reflect.DeepEqual(m, map[string]string{"a": "1", "b": "3"}) {
+		t.Errorf("nil map[string]string by pointer: got %v", m)
+	}
+	var ms map[string][]string
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(&ms, form, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("nil map[string][]string by pointer: panic %v", r)
+	}
+	got := map[string]string{}
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(got, map[string][]string{"a": {}}, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("key without values: panic %v", r)
+	}
+}
+
+// hzNode: a struct with a pointer to its own type, as a tree node or a linked list has.
+type hzNode struct {
+	Name   string  `form:"name"`
+	Parent *hzNode `form:"parent"`
+}
+
+// TestHegelPinSelfReference: gin/9. Binding a struct with a pointer field of its own type
+// (no `form:"-"`) must not recurse without end: the child process that binds it must exit
+// normally. A fatal stack overflow cannot be recovered in-process, hence the child.
+func TestHegelPinSelfReference(t *testing.T) {
+	if os.Getenv("HZ_SELF_REFERENCE_CHILD") == "1" {
+		var n hzNode
+		err := MapFormWithTag(&n, map[string][]string{"name": {"leaf"}}, "form")
+		fmt.Printf("HZ child: name=%q parent=%v err=%v\n", n.Name, n.Parent, err)
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHegelPinSelfReference$", "-test.v")
+	cmd.Env = append(os.Environ(), "HZ_SELF_REFERENCE_CHILD=1")
+	out, err := cmd.CombinedOutput()
+	s := string(out)
+	if len(s) > 400 {
+		s = s[:400] + " ..."
+	}
+	if err != nil {
+		t.Fatalf("binding a self-referential struct: the child process failed: %v\n%s", err, s)
+	}
+	if !strings.Contains(string(out), `HZ child: name="leaf" parent=<nil> err=<nil>`) {
+		t.Fatalf("binding a self-referential struct: unexpected child output\n%s", s)
+	}
+}
+
+// TestHegelPinValueDestination: gin/10. A destination passed by value cannot be filled; the
+// JSON, XML, YAML and TOML bindings return an error for it, so must the form mapping - not a
+// panic in reflect.
+func TestHegelPinValueDestination(t *testing.T) {
+	type dest struct {
+		A string `form:"a"`
+	}
+	var err error
+	if r := hzCatch(func() { err = MapFormWithTag(dest{}, map[string][]string{"a": {"x"}}, "form") }); r != nil {
+		t.Fatalf("struct by value: panic %v", r)
+	}
+	if err == nil {
+		t.Fatalf("struct by value: no error")
+	}
+}
+
+// TestHegelPinEmptyValueStruct: gin/11. An empty value leaves an int at 0, a string empty, a
+// time.Time zero and a slice with one zero element; a struct or map field given an empty
+// value must be left at its zero too, not fail with a JSON error.
+func TestHegelPinEmptyValueStruct(t *testing.T) {
+	type dest struct {
+		N int             `form:"n"`
+		J struct{ I int } `form:"j"`
+		M map[string]int  `form:"m"`
+	}
+	var d dest
+	if err := MapFormWithTag(&d, map[string][]string{"n": {""}}, "form"); err != nil {
+		t.Fatalf("n=: %v", err)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"j": {""}}, "form"); err != nil {
+		t.Errorf("j= (struct field): error %v", err)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"m": {""}}, "form"); err != nil {
+		t.Errorf("m= (map field): error %v", err)
+	}
+}
+
+// TestHegelPinEmptySliceValueDefault: gin/12. The default applies to a value the client
+// leaves empty (`?age=` gives the default age, TestMappingFormWithEmptyToDefault); so must it
+// for a slice or array field: `?friends=` must give the default friends, not one empty one.
+func TestHegelPinEmptySliceValueDefault(t *testing.T) {
+	type dest struct {
+		Name    string    `form:"name,default=William"`
+		Friends []string  `form:"friends,default=Will;Bill"`
+		Laps    []int     `form:"laps,default=1;2;3" collection_format:"csv"`
+		Pair    [2]string `form:"pair,default=foo bar" collection_format:"ssv"`
+	}
+	var d dest
+	if err := MapFormWithTag(&d, map[string][]string{"name": {""}}, "form"); err != nil {
+		t.Fatalf("name=: error %v", err)
+	}
+	if d.Name != "William" {
+		t.Fatalf("name= gives %q", d.Name)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"friends": {""}}, "form"); err != nil {
+		t.Errorf("friends=: error %v", err)
+	} else if !reflect.DeepEqual(d.Friends, []string{"Will", "Bill"}) {
+		t.Errorf("friends= gives %q, want the default [Will Bill] as name= gives William", d.Friends)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"laps": {""}}, "form"); err != nil {
+		t.Errorf("laps=: error %v", err)
+	} else if !reflect.DeepEqual(d.Laps, []int{1, 2, 3}) {
+		t.Errorf("laps= gives %v, want the default [1 2 3]", d.Laps)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"pair": {""}}, "form"); err != nil {
+		t.Errorf("pair=: error %v", err)
+	} else if d.Pair != [2]string{"foo", "bar"} {
+		t.Errorf("pair= gives %q, want the default [foo bar]", d.Pair)
+	}
+}
diff --git a/binding/hegel_zoo_test.go b/binding/hegel_zoo_test.go
new file mode 100644
index 0000000..ca81d9d
--- /dev/null
+++ b/binding/hegel_zoo_test.go
@@ -0,0 +1,161 @@
+package binding
+
+// Hegel property tests for gin-gonic/gin's binding package (form_mapping.go), written for the
+// Hegel zoo: part 2 of targets/go/gin/README.md. They live in package binding because the
+// mapping's entry points other than MapFormWithTag are unexported; every identifier carries the
+// hz prefix to stay clear of the upstream tests.
+//
+// Oracle: a model of the documented mapping of form values (map[string][]string) into a struct
+// by its `form`/`uri` tags - field names, default=, collection_format, parser=, time_format,
+// time_utc, time_location, BindUnmarshaler - over struct types built at runtime with
+// reflect.StructOf, and of the mapping into a map destination.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists. gin/9 (self-referential pointer fields) and gin/10 (a destination passed by
+// value) have pins only: the generated types have no cycles and are always addressed.
+var HZKnown = struct {
+	formMapPanics   bool // 8: a nil map destination, or a key with no values, panics in the mapping into a map
+	emptyValueJSON  bool // 11: an empty value for a struct or map field is a JSON error instead of leaving the field
+	emptySliceValue bool // 12: an empty value for a slice or array field is not replaced by its default
+}{true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
