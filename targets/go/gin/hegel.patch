+package binding
+
+// The two wide properties of the binding package: the form mapping (form_mapping.go) into
+// struct types built at runtime from drawn specs, and into map destinations, against the
+// models of hegel_zoo_form_model_test.go (the records and generators are in
+// hegel_zoo_forms_test.go, the narrow properties in hegel_zoo_form_shapes_test.go). Each
+// draws the shapes of its recorded bugs at their natural rates and fails by default naming
+// the bug; under HEGEL_NO_KNOWN=1 the shaped cases are filtered out of the generator (the
+// classifier over the case) or not drawn (the destination by value, the nil map with a form,
+// the key without values).
+
+import "testing"
+
+// TestHegelFormMapping: MapFormWithTag on a runtime-built struct type, by pointer (or by
+// value one time in twenty), against the model: the panic (none), the error by message and
+// the value reached. Draws the shapes of gin/10 (the destination by value), gin/11 (an empty
+// value for a struct or map field) and gin/12 (an empty value for a slice or array with a
+// default) at their natural rates.
+func TestHegelFormMapping(t *testing.T) {
+	judged(t, bindCases, judgeBind)
+}
+
+// TestHegelFormMapDest: MapFormWithTag into map destinations of seven types, by value and by
+// pointer, nil or holding an entry, with forms of keys with and without values, against the
+// model: the panic (none), the error and the map left. Draws the shape of gin/8 (a nil map
+// with a form to put into it; a key without values) at its natural rate.
+func TestHegelFormMapDest(t *testing.T) {
+	judged(t, mapDestCases, judgeMapDest)
+}
diff --git a/binding/hegel_zoo_forms_test.go b/binding/hegel_zoo_forms_test.go
new file mode 100644
index 0000000..5b75cdf
--- /dev/null
+++ b/binding/hegel_zoo_forms_test.go
@@ -0,0 +1,978 @@
+package binding
+
+// The records and generators of the binding properties (hegel_zoo_form_model_test.go has the
+// models with the replicas and the judges, hegel_zoo_form_test.go the two wide properties,
+// hegel_zoo_form_shapes_test.go the narrow ones). A case of the FormMapping property is a
+// struct type drawn as a SPEC - a structSpec of fieldSpecs, each a typeSpec tree with a
+// tagSpec record - built into a reflect.Type by the pure typeOf in the record's Map, with the
+// form drawn for the keys that type looks up (a FlatMap from the type) and, one time in
+// twenty, the destination passed by value; a case of FormMapDest is a map destination with a
+// form of pool keys. A drawn case is a value and replays identically: no package-level state
+// is touched during generation (the tag name is drawn first and threaded, the keys of their
+// own are numbered by position in the spec). The population is the one the old hzGen*
+// functions drew (the same lists byte for byte, the same shares); every weight below is
+// nominal and the figure beside it is the realised rate the probe measured over 3000 cases
+// (HEGEL_SEED=7) in context, in percent of the draws of that choice (the engine's dice are not
+// even: hegel_zoo_idioms_test.go). The simplest alternative comes first in every choice, so
+// the shrink target of FormMapping is one string field F0 with no tag, an empty form and the
+// destination by pointer, of FormMapDest a map[string]string by pointer, empty, with an empty
+// form.
+
+import (
+	"encoding"
+	"errors"
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- custom types
+
+// hzHex implements BindUnmarshaler: a hexadecimal integer.
+type hzHex int
+
+func (h *hzHex) UnmarshalParam(param string) error {
+	v, err := strconv.ParseInt(param, 16, 64)
+	if err != nil {
+		return err
+	}
+	*h = hzHex(v)
+	return nil
+}
+
+// hzText implements encoding.TextUnmarshaler: upper-cases its text, rejects a '!'.
+type hzText string
+
+func (h *hzText) UnmarshalText(b []byte) error {
+	if strings.Contains(string(b), "!") {
+		return errors.New("hzText: bang")
+	}
+	*h = hzText(strings.ToUpper(string(b)))
+	return nil
+}
+
+var (
+	hzTypeString   = reflect.TypeOf("")
+	hzTypeInt      = reflect.TypeOf(0)
+	hzTypeInt8     = reflect.TypeOf(int8(0))
+	hzTypeUint16   = reflect.TypeOf(uint16(0))
+	hzTypeBool     = reflect.TypeOf(false)
+	hzTypeFloat64  = reflect.TypeOf(0.0)
+	hzTypeDuration = reflect.TypeOf(time.Duration(0))
+	hzTypeTime     = reflect.TypeOf(time.Time{})
+	hzTypeHex      = reflect.TypeOf(hzHex(0))
+	hzTypeText     = reflect.TypeOf(hzText(""))
+	hzTypeAny      = reflect.TypeOf((*any)(nil)).Elem()
+	hzTypeUintptr  = reflect.TypeOf(uintptr(0))
+	hzTypeMapInt   = reflect.TypeOf(map[string]int{})
+	hzTypeMapStr   = reflect.TypeOf(map[string]string{})
+
+	// hzTypeStruct stands for a struct the spec opens (its fields are a spec of their own)
+	// where a leaf type is asked for: the value pools of a struct do not depend on its fields.
+	hzTypeStruct = reflect.TypeOf(struct{}{})
+
+	hzTextUnmarshaler = reflect.TypeOf((*encoding.TextUnmarshaler)(nil)).Elem()
+	hzBindUnmarshaler = reflect.TypeOf((*BindUnmarshaler)(nil)).Elem()
+)
+
+// --------------------------------------------------------------------------- the pools
+
+// hzLeafTypes are the leaf types of a field (strings, ints, times and the text type twice);
+// hzKeyPool the keys shared between fields on purpose; hzAnyValues the values of a stray key
+// and of a value drawn without regard to the field.
+var (
+	hzLeafTypes = []reflect.Type{
+		hzTypeString, hzTypeString, hzTypeInt, hzTypeInt, hzTypeInt8, hzTypeUint16, hzTypeBool,
+		hzTypeFloat64, hzTypeDuration, hzTypeTime, hzTypeTime, hzTypeHex, hzTypeText, hzTypeText,
+	}
+	hzKeyPool   = []string{"a", "b", "c", "d", "e", "f", "g", "h"}
+	hzAnyValues = []string{"0", "7", "x", "", "true", "1.5", "a,b", "a b", "ff", "2020-01-02", `{}`, "1h", " 1 "}
+)
+
+// The lists of the tags: the time tags, the collection formats (the sixteen-entry table with
+// its repeats), the separators of a collection's default, the stray keys of a form.
+var (
+	hzTimeFormats       = []string{"", "", "2006-01-02", "unix", "UnixMilli", "unixnano", "15:04:05", "unixmicro"}
+	hzTimeUTCs          = []string{"", "", "1", "true", "0", "x"}
+	hzTimeLocations     = []string{"", "", "", "", "", "", "", "UTC", "UTC", "Asia/Tokyo", "Asia/Tokyo", "Local", "Nowhere/City"}
+	hzCollectionFormats = []string{"multi", "csv", "csv", "csv", "ssv", "ssv", "tsv", "pipes", "pipes", "multi", "csv", "ssv", "pipes", "tsv", "csv", "bad"}
+	hzDefaultSeps       = []string{";", ";", " ", "|"}
+	hzStrayKeys         = []string{"zz", "F9", "A", "e"}
+)
+
+// hzLeafOf is the leaf type a value of type t is parsed as (through pointers, slices, arrays).
+func hzLeafOf(t reflect.Type) reflect.Type {
+	for {
+		switch t.Kind() {
+		case reflect.Pointer, reflect.Slice, reflect.Array:
+			t = t.Elem()
+		default:
+			return t
+		}
+	}
+}
+
+// hzFieldValues: form values for a field, fit for its leaf type and time_format (or bad).
+func hzFieldValues(sf reflect.StructField, bad bool) []string {
+	leaf := hzLeafOf(sf.Type)
+	if leaf == hzTypeTime {
+		format := strings.ToLower(sf.Tag.Get("time_format"))
+		switch {
+		case strings.HasPrefix(format, "unix"):
+			if bad {
+				return []string{"1600000000x", "2020-01-02", ""}
+			}
+			return []string{"1600000000", "1600000000123", "0", "-5", " 7 ", ""}
+		case format == "2006-01-02":
+			if bad {
+				return []string{"2020-13-01", "2020-01-02T03:04:05Z", "x"}
+			}
+			return []string{"2020-01-02", "1999-12-31", " 2020-01-02 ", ""}
+		case format == "15:04:05":
+			if bad {
+				return []string{"25:00:00", "2020-01-02", "x"}
+			}
+			return []string{"03:04:05", "23:59:59", ""}
+		}
+	}
+	if leaf.Kind() == reflect.Struct && leaf != hzTypeTime {
+		if bad {
+			return []string{`bad`, `[1]`, `{`, `7`}
+		}
+		return []string{`{}`, `{"zz":1}`, `{"F0":null}`, "", `{"F0":null,"F1":null}`}
+	}
+	if leaf.Kind() == reflect.Map {
+		if bad {
+			return []string{`bad`, `[1]`, `{"a":[]}`, `7`}
+		}
+		if leaf.Elem().Kind() == reflect.Int {
+			return []string{`{"one":1}`, `{}`, "", `{"a":1,"b":-2}`}
+		}
+		return []string{`{"a":"1"}`, `{}`, "", `{"a":"x","b":""}`}
+	}
+	vals := hzValuePool(leaf, bad)
+	if k := sf.Type.Kind(); (k == reflect.Slice || k == reflect.Array) && !bad && leaf != hzTypeString {
+		// instances holding several values, for the collection_format
+		sep, _ := hzCollectionSep(sf.Tag.Get("collection_format"))
+		if sep != "" {
+			one := vals[0]
+			if leaf == hzTypeTime {
+				one = "0"
+			}
+			vals = append(vals, one+sep+one, one+sep+one+sep+one)
+		}
+	}
+	return vals
+}
+
+// hzValuePool: form values that parse as a leaf type, and (bad) ones that do not.
+func hzValuePool(leaf reflect.Type, bad bool) []string {
+	switch {
+	case leaf == hzTypeDuration:
+		if bad {
+			return []string{"x", "10", "1h;2h"}
+		}
+		return []string{"1h", "5ms", "-2s", "", " 3s ", "0"}
+	case leaf == hzTypeTime:
+		if bad {
+			return []string{"bad", "2020-13-01", "1600000000x"}
+		}
+		return []string{"2020-01-02T03:04:05Z", "2020-01-02", "03:04:05", "1600000000",
+			"1600000000123", "", "2020-01-02T03:04:05+09:00", " 2020-01-02 "}
+	case leaf == hzTypeHex:
+		if bad {
+			return []string{"zz", "1.5"}
+		}
+		return []string{"ff", "1A", "", "10"}
+	case leaf == hzTypeText:
+		if bad {
+			return []string{"a!b", "!"}
+		}
+		return []string{"abc", "", "Xy z", "a,b"}
+	case leaf == hzTypeString:
+		return []string{"abc", "", "a b", "a,b", "a|b", "a\tb", " x ", "1;2"}
+	}
+	switch leaf.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Uint16:
+		if bad {
+			return []string{"x", "70000", "-3", "1.5", "1,2", "1 2", "1|2", "1\t2"}
+		}
+		return []string{"0", "7", "12", "100", " 5 ", "", "+2", "1", "9"}
+	case reflect.Bool:
+		if bad {
+			return []string{"yes", "2", "true false"}
+		}
+		return []string{"true", "1", "T", "false", "0", "", " t "}
+	case reflect.Float64:
+		if bad {
+			return []string{"x", "1.5,2", "1,5"}
+		}
+		return []string{"1.5", "-2", "1e3", "", " 2 ", "0", "3"}
+	case reflect.Struct, reflect.Map:
+		if bad {
+			return []string{`bad`, `[1]`, `{`}
+		}
+		return []string{"", `{}`}
+	}
+	return []string{"x", "", "1"}
+}
+
+// hzCollectionSep is the separator of a collection_format ("" for one value per instance).
+func hzCollectionSep(cf string) (sep string, ok bool) {
+	switch cf {
+	case "", "multi":
+		return "", true
+	case "csv":
+		return ",", true
+	case "ssv":
+		return " ", true
+	case "tsv":
+		return "\t", true
+	case "pipes":
+		return "|", true
+	}
+	return "", false
+}
+
+// hzKeysOf lists the keys the mapping of type t looks up, with the field of each (the first
+// field for a repeated key).
+func hzKeysOf(t reflect.Type, tag string, keys map[string]reflect.StructField, order *[]string) {
+	for t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	if t.Kind() != reflect.Struct || t == hzTypeTime {
+		return
+	}
+	for i := 0; i < t.NumField(); i++ {
+		sf := t.Field(i)
+		tv := sf.Tag.Get(tag)
+		if tv == "-" {
+			continue
+		}
+		name, _, _ := strings.Cut(tv, ",")
+		if name == "" {
+			name = sf.Name
+		}
+		if _, seen := keys[name]; !seen {
+			keys[name] = sf
+			*order = append(*order, name)
+		}
+		hzKeysOf(sf.Type, tag, keys, order)
+	}
+}
+
+// --------------------------------------------------------------------------- even tables
+
+// evenHalves is a table at one weight each drawn by halving: a fair-bit choice between the
+// two halves at their sizes (dieChoice), and each half again, down to one value; the first
+// value is the shrink target (package gin's part 1 measured dieTree's three-way splits at 12
+// to 27 for their last face instead of 33, so the even tables are halved). rangeHalves is the
+// integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- the type specs
+
+// typeSpec is the type of a field as drawn: a leaf (leaf set, kind Invalid), or a slice,
+// array (length), pointer (elem) or struct (strct) of it.
+type typeSpec struct {
+	kind   reflect.Kind
+	leaf   reflect.Type
+	length int
+	elem   *typeSpec
+	strct  structSpec
+}
+
+// tagSpec is the struct tag of a field as drawn: the shape of the mapping tag (none - the
+// field name is the key -, skip - `-` -, or named), the kind of the name (a key of its own,
+// numbered k1, k2, ... by position in the spec; a key of the pool; empty - the field name
+// again), the options, the other tag's key, the collection_format and the time tags. text
+// renders it for the mapping tag name.
+type tagSpec struct {
+	shape      string
+	nameKind   string
+	key        string
+	hasDefault bool
+	def        string
+	parser     bool
+	omitempty  bool
+	stray      bool
+	other      string
+	cf         string
+	timed      bool
+	timeFormat string
+	timeUTC    string
+	timeLoc    string
+}
+
+const (
+	tagNone  = "none"
+	tagSkip  = "skip"
+	tagNamed = "named"
+
+	nameOwn   = "own"
+	namePool  = "pool"
+	nameEmpty = "empty"
+)
+
+// fieldSpec is one field: its name (F0, F1, ... by position), its type, its tag and whether
+// it is embedded.
+type fieldSpec struct {
+	name      string
+	typ       typeSpec
+	tag       tagSpec
+	anonymous bool
+}
+
+// structSpec is a struct type as drawn: its fields.
+type structSpec struct {
+	fields []fieldSpec
+}
+
+func leafSpec(t reflect.Type) typeSpec { return typeSpec{leaf: t} }
+
+func pointerTo(t typeSpec) typeSpec { return typeSpec{kind: reflect.Pointer, elem: &t} }
+
+func sliceOf(t typeSpec) typeSpec { return typeSpec{kind: reflect.Slice, elem: &t} }
+
+func arrayOf(n int) func(typeSpec) typeSpec {
+	return func(t typeSpec) typeSpec { return typeSpec{kind: reflect.Array, length: n, elem: &t} }
+}
+
+func structType(s structSpec) typeSpec { return typeSpec{kind: reflect.Struct, strct: s} }
+
+// structish reports whether the field may be embedded: a struct the spec opens, or a pointer
+// to one.
+func (t typeSpec) structish() bool {
+	return t.kind == reflect.Struct || t.kind == reflect.Pointer && t.elem.kind == reflect.Struct
+}
+
+// leafType is the type the field's values are parsed as, through slices, arrays and
+// pointers: the leaf, or hzTypeStruct for a struct the spec opens.
+func (t typeSpec) leafType() reflect.Type {
+	for t.elem != nil {
+		t = *t.elem
+	}
+	if t.kind == reflect.Struct {
+		return hzTypeStruct
+	}
+	return t.leaf
+}
+
+// hasTime reports whether the field's values are times (the time tags apply).
+func (t typeSpec) hasTime() bool { return t.leafType() == hzTypeTime }
+
+// collection reports whether the field is a slice or an array.
+func (t typeSpec) collection() bool { return t.kind == reflect.Slice || t.kind == reflect.Array }
+
+// build is the reflect.Type of the spec for the mapping tag name (pure: reflect caches the
+// types it makes).
+func (t typeSpec) build(tag string) reflect.Type {
+	switch t.kind {
+	case reflect.Slice:
+		return reflect.SliceOf(t.elem.build(tag))
+	case reflect.Array:
+		return reflect.ArrayOf(t.length, t.elem.build(tag))
+	case reflect.Pointer:
+		return reflect.PointerTo(t.elem.build(tag))
+	case reflect.Struct:
+		return typeOf(t.strct, tag)
+	}
+	return t.leaf
+}
+
+// typeOf is the struct type of the spec for the mapping tag name: reflect.StructOf over its
+// fields, each with its type built and its tag rendered.
+func typeOf(s structSpec, tag string) reflect.Type {
+	fields := make([]reflect.StructField, len(s.fields))
+	for i, f := range s.fields {
+		fields[i] = reflect.StructField{Name: f.name, Type: f.typ.build(tag), Tag: reflect.StructTag(f.tag.text(tag)), Anonymous: f.anonymous}
+	}
+	return reflect.StructOf(fields)
+}
+
+// number gives the keys of their own their numbers, in the order the old generator drew
+// them (a field's nested keys before its own), from next on.
+func (s *structSpec) number(next *int) {
+	for i := range s.fields {
+		f := &s.fields[i]
+		f.typ.number(next)
+		if f.tag.shape == tagNamed && f.tag.nameKind == nameOwn {
+			*next++
+			f.tag.key = "k" + strconv.Itoa(*next)
+		}
+	}
+}
+
+func (t *typeSpec) number(next *int) {
+	for t.elem != nil {
+		t = t.elem
+	}
+	if t.kind == reflect.Struct {
+		t.strct.number(next)
+	}
+}
+
+// timeText is the time tags as rendered ("" for none).
+func (t tagSpec) timeText() string {
+	var tt []string
+	if t.timeFormat != "" {
+		tt = append(tt, `time_format:"`+t.timeFormat+`"`)
+	}
+	if t.timeUTC != "" {
+		tt = append(tt, `time_utc:"`+t.timeUTC+`"`)
+	}
+	if t.timeLoc != "" {
+		tt = append(tt, `time_location:"`+t.timeLoc+`"`)
+	}
+	return strings.Join(tt, " ")
+}
+
+// text renders the tag for the mapping tag name: the mapping tag (the name first, then the
+// options in a fixed order, as the syntax wants), the other tag, the collection_format, the
+// time tags.
+func (t tagSpec) text(tag string) string {
+	var parts []string
+	switch t.shape {
+	case tagSkip:
+		parts = append(parts, tag+`:"-"`)
+	case tagNamed:
+		opts := []string{t.key}
+		if t.hasDefault {
+			opts = append(opts, "default="+t.def)
+		}
+		if t.parser {
+			opts = append(opts, "parser=encoding.TextUnmarshaler")
+		}
+		if t.omitempty {
+			opts = append(opts, "omitempty")
+		}
+		if t.stray {
+			opts = append(opts, "default")
+		}
+		parts = append(parts, tag+`:"`+strings.Join(opts, ",")+`"`)
+	}
+	if t.other != "" {
+		other := "uri"
+		if tag == "uri" {
+			other = "form"
+		}
+		parts = append(parts, other+`:"`+t.other+`"`)
+	}
+	if t.cf != "" {
+		parts = append(parts, `collection_format:"`+t.cf+`"`)
+	}
+	if tt := t.timeText(); tt != "" {
+		parts = append(parts, tt)
+	}
+	return strings.Join(parts, " ")
+}
+
+// --------------------------------------------------------------------------- the type
+// generators (one per depth: the top struct is depth 0, a struct inside it 1, a struct
+// inside that 2, whose fields are leaves)
+
+var (
+	leafTypes = evenHalves(hzLeafTypes...) // the fourteen entries, nominal 7.1 each: the single ones realise 6.0 to 8.0 at the top, the doubled ones 13.3 to 14.9
+	oddLeaves = evenHalves(hzTypeAny, hzTypeUintptr)
+	poolKeys  = evenHalves(hzKeyPool...)
+	anyValues = evenHalves(hzAnyValues...)
+
+	// leafSpecs is a leaf type: one of the fourteen, or any/uintptr one time in a hundred.
+	leafSpecs = dieChoice(
+		hzW(99, hegel.Map(leafTypes, leafSpec)),
+		hzW(1, hegel.Map(oddLeaves, leafSpec)), // any/uintptr nominal 1: realises 1.3 at the top, 1.5 and 0.8 below
+	)
+	mapSpecs     = hegel.Map(evenHalves(hzTypeMapInt, hzTypeMapStr), leafSpec) // the two map types, nominal 50 each: realise 48.5 / 51.5
+	arrayLengths = rangeHalves(1, 3)                                           // 1 to 3 elements, nominal 33 each: realise 37.6 / 29.4 / 32.9
+)
+
+// elemSpecsAt is the element type of a slice or array at the depth: a leaf 70, a pointer to
+// a leaf 15, a struct 15 (a leaf only, at depth 2).
+func elemSpecsAt(depth int) hegel.Generator[typeSpec] {
+	leaves := hegel.Map(leafTypes, leafSpec)
+	if depth >= 2 {
+		return leaves
+	}
+	return dieChoice(
+		hzW(70, leaves), // leaf nominal 70: realises 68.0 at the top, 69.9 below
+		hzW(15, hegel.Map(leafTypes, func(t reflect.Type) typeSpec { return pointerTo(leafSpec(t)) })), // pointer nominal 15: realises 13.4 at the top, 12.6 below
+		hzW(15, hegel.Map(structSpecsAt(depth+1), structType)),                                         // struct nominal 15: realises 18.7 at the top, 17.5 below
+	)
+}
+
+// typeSpecsAt is the type of a field at the depth: a leaf 48, a slice 16, an array 8, a
+// pointer 8 (to a leaf 60, to a struct 40), a map 6, a struct 14 (a leaf only, at depth 2).
+func typeSpecsAt(depth int) hegel.Generator[typeSpec] {
+	if depth >= 2 {
+		return leafSpecs
+	}
+	elems := elemSpecsAt(depth)
+	subs := structSpecsAt(depth + 1)
+	return dieChoice(
+		hzW(48, leafSpecs),                 // leaf nominal 48 (above depth 2): realises 47.1 at the top, 48.1 below
+		hzW(16, hegel.Map(elems, sliceOf)), // slice nominal 16: realises 16.6 at the top, 17.1 below
+		hzW(8, hegel.FlatMap(arrayLengths, func(n int) hegel.Generator[typeSpec] { return hegel.Map(elems, arrayOf(n)) })), // array nominal 8: realises 7.6 at the top, 7.9 below
+		hzW(8, dieChoice(
+			hzW(60, hegel.Map(leafTypes, func(t reflect.Type) typeSpec { return pointerTo(leafSpec(t)) })), // pointer to a leaf nominal 60: realises 56 of the pointers at the top, 62 below
+			hzW(40, hegel.Map(subs, func(s structSpec) typeSpec { return pointerTo(structType(s)) })),      // pointer to a struct nominal 40: realises 44 of the pointers at the top, 38 below
+		)), // pointer nominal 8: realises 6.8 at the top, 7.2 below
+		hzW(6, mapSpecs),                     // map nominal 6: realises 6.2 at the top, 6.0 below
+		hzW(14, hegel.Map(subs, structType)), // struct nominal 14: realises 15.9 at the top, 13.8 below
+	)
+}
+
+// tagAdmits reports whether the tag syntax admits a default value: no comma, semicolon,
+// equals sign, tab or space, not empty.
+func tagAdmits(v string) bool { return !strings.ContainsAny(v, ",;=\t ") && v != "" }
+
+// defaultOne is one default value for the leaf type with the time tags: a value of the
+// field's pools (bad four times in a hundred) that admit accepts (tagAdmits in the wide
+// generator), or "1" when the pool has none.
+func defaultOne(leaf reflect.Type, timeText string, admit func(string) bool) hegel.Generator[string] {
+	pool := func(bad bool) hegel.Generator[string] {
+		var vals []string
+		for _, v := range hzFieldValues(reflect.StructField{Type: leaf, Tag: reflect.StructTag(timeText)}, bad) {
+			if admit(v) {
+				vals = append(vals, v)
+			}
+		}
+		if len(vals) == 0 {
+			return hegel.Just("1")
+		}
+		return evenHalves(vals...)
+	}
+	return hegel.FlatMap(dieCoin(4), func(bad bool) hegel.Generator[string] { return pool(bad) }) // a bad default nominal 4: realises 5.7 (measured over the non-string defaults; the fallback "1" counted as fit)
+}
+
+// defaultsFor is the default= value of a field of the type with the time tags: empty eight
+// times in a hundred, else one value, or for a collection one to three values joined by ";",
+// " " or "|".
+func defaultsFor(t typeSpec, timeText string) hegel.Generator[string] {
+	one := defaultOne(t.leafType(), timeText, tagAdmits)
+	value := one
+	if t.collection() {
+		value = hegel.FlatMap(rangeHalves(1, 3), func(n int) hegel.Generator[string] { // 1 to 3 values, nominal 33 each: realise 29.4 / 35.6 / 34.1 (and 0.8 of a value holding a separator)
+			return hegel.FlatMap(hzCounted(one, n, n), func(vals []string) hegel.Generator[string] {
+				return hegel.Map(evenHalves(hzDefaultSeps...), func(sep string) string { return strings.Join(vals, sep) }) // ";" 50, " " 25, "|" 25: realise 48.6 / 26.9 / 24.6 of the joined ones
+			})
+		})
+	}
+	return dieChoice(
+		hzW(8, hegel.Just("")), // the empty default nominal 8: realises 8.6
+		hzW(92, value),
+	)
+}
+
+var (
+	tagShapes = dieChoice(
+		hzW(8, hegel.Just(tagNone)),   // no mapping tag nominal 8: realises 7.8
+		hzW(6, hegel.Just(tagSkip)),   // `-` nominal 6: realises 6.2
+		hzW(86, hegel.Just(tagNamed)), // a named tag nominal 86: realises 86.0
+	)
+	nameKinds = dieChoice(
+		hzW(62, hegel.Just(nameOwn)),   // a key of its own nominal 62: realises 63.6
+		hzW(18, hegel.Just(namePool)),  // a key of the pool nominal 18: realises 16.6
+		hzW(20, hegel.Just(nameEmpty)), // the field name nominal 20: realises 19.8
+	)
+	timeFormats       = evenHalves(hzTimeFormats...)       // the eight entries (two empty), nominal 12.5 each: realise 10.8 to 14.6 (the empty 25.4)
+	timeUTCs          = evenHalves(hzTimeUTCs...)          // the six entries (two empty), nominal 17 each: realise 16.2 to 18.0 (the empty 30.9)
+	timeLocations     = evenHalves(hzTimeLocations...)     // the thirteen entries (seven empty), nominal 7.7 each: the empty 56.1, UTC 20.1, Asia/Tokyo 10.6, Nowhere/City 7.9, Local 5.3
+	collectionFormats = evenHalves(hzCollectionFormats...) // the sixteen entries, nominal 6.3 each: csv 30.7, pipes 17.1, ssv 16.7, tsv 15.2, multi 12.9, bad 7.3
+)
+
+// tagSpecsFor is the tag of a field of the type, drawn in the old generator's order: the time
+// tags (seventy times in a hundred when the values are times), the shape, the name, the
+// default (forty times in a hundred; ten for a struct or map, whose default is JSON; never
+// for any/uintptr), parser 15, omitempty 8, a stray "default" 4 (when a default is
+// possible), the other tag 10, a collection_format sixty times in a hundred for a slice or
+// array and five then sixty for the rest. A Composite: the draws depend on the ones before
+// (the time format shapes the default's pool), and it only draws.
+func tagSpecsFor(t typeSpec) hegel.Generator[tagSpec] {
+	leaf := t.leafType()
+	defaultPct := 40
+	switch {
+	case leaf == hzTypeAny || leaf == hzTypeUintptr:
+		defaultPct = 0 // no text is a value of these
+	case leaf.Kind() == reflect.Struct && leaf != hzTypeTime, leaf.Kind() == reflect.Map:
+		defaultPct = 10 // a JSON default is a rare thing to write
+	}
+	hasTime, collection := t.hasTime(), t.collection()
+	return hegel.Composite(func(tc hegel.TestCase) tagSpec {
+		var s tagSpec
+		if hasTime && hegel.Draw(tc, dieCoin(70)) { // the time tags nominal 70: realises 67.8
+			s.timed = true
+			s.timeFormat = hegel.Draw(tc, timeFormats)
+			s.timeUTC = hegel.Draw(tc, timeUTCs)
+			s.timeLoc = hegel.Draw(tc, timeLocations)
+		}
+		s.shape = hegel.Draw(tc, tagShapes)
+		if s.shape == tagNamed {
+			s.nameKind = hegel.Draw(tc, nameKinds)
+			if s.nameKind == namePool {
+				s.key = hegel.Draw(tc, poolKeys)
+			}
+			if hegel.Draw(tc, dieCoin(defaultPct)) { // a default nominal 40/10/0: realises 40.4 / 10.2 / 0
+				s.hasDefault = true
+				s.def = hegel.Draw(tc, defaultsFor(t, s.timeText()))
+			}
+			s.parser = hegel.Draw(tc, dieCoin(15))   // parser nominal 15: realises 15.6
+			s.omitempty = hegel.Draw(tc, dieCoin(8)) // omitempty nominal 8: realises 8.4
+			if defaultPct > 0 {
+				s.stray = hegel.Draw(tc, dieCoin(4)) // a stray "default" nominal 4: realises 3.7
+			}
+		}
+		if hegel.Draw(tc, dieCoin(10)) { // the other tag nominal 10: realises 9.9
+			s.other = hegel.Draw(tc, poolKeys)
+		}
+		cf := collection
+		if !collection {
+			cf = hegel.Draw(tc, dieCoin(5)) // a collection_format on another field nominal 5 (then 60: 3 of them): realises 2.6
+		}
+		if cf && hegel.Draw(tc, dieCoin(60)) { // a collection_format nominal 60 of the slices and arrays: realises 60.6
+			s.cf = hegel.Draw(tc, collectionFormats)
+		}
+		return s
+	})
+}
+
+// fieldSpecsAt is a field at the depth: its type, embedded thirty-five times in a hundred
+// when the type is a struct or a pointer to one, and its tag (named by position later).
+func fieldSpecsAt(depth int) hegel.Generator[fieldSpec] {
+	return hegel.FlatMap(typeSpecsAt(depth), func(t typeSpec) hegel.Generator[fieldSpec] {
+		anonymous := hegel.Just(false)
+		if t.structish() {
+			anonymous = dieCoin(35) // embedded nominal 35 of the struct-ish fields: realises 34.2
+		}
+		return hegel.FlatMap(anonymous, func(a bool) hegel.Generator[fieldSpec] {
+			return hegel.Map(tagSpecsFor(t), func(s tagSpec) fieldSpec { return fieldSpec{typ: t, tag: s, anonymous: a} })
+		})
+	})
+}
+
+// structSpecsAt is a struct at the depth: one to four fields, named F0, F1, ... by position.
+func structSpecsAt(depth int) hegel.Generator[structSpec] {
+	return hegel.Map(countedHalves(fieldSpecsAt(depth), 1, 4), func(fs []fieldSpec) structSpec { // 1 to 4 fields, nominal 25 each: realise 24.4 / 23.8 / 24.4 / 27.4 at the top
+		for i := range fs {
+			fs[i].name = "F" + strconv.Itoa(i)
+		}
+		return structSpec{fields: fs}
+	})
+}
+
+// structSpecs is the destination type of a FormMapping case: the top struct with its keys of
+// their own numbered.
+var structSpecs = hegel.Map(structSpecsAt(0), func(s structSpec) structSpec {
+	next := 0
+	s.number(&next)
+	return s
+})
+
+// --------------------------------------------------------------------------- the forms
+
+// formValue is one value of a form entry: its text and the pool it came from ("fit" for the
+// field, "bad" for the field, "any" regardless of it).
+type formValue struct {
+	text string
+	kind string
+}
+
+// formEntry is one entry of a form: the key and its values (an entry with no key is an
+// absent one).
+type formEntry struct {
+	key    string
+	values []formValue
+}
+
+// formSpec is a form as drawn: the entries of the keys present, in the order the type looks
+// them up, and a stray entry (no key for none), which overrides an entry of the same key.
+type formSpec struct {
+	entries []formEntry
+	stray   formEntry
+}
+
+// form is the form the library and the model are given.
+func (f formSpec) form() map[string][]string {
+	form := map[string][]string{}
+	for _, e := range f.entries {
+		form[e.key] = e.texts()
+	}
+	if f.stray.key != "" {
+		form[f.stray.key] = f.stray.texts()
+	}
+	return form
+}
+
+func (e formEntry) texts() []string {
+	texts := make([]string, len(e.values))
+	for i, v := range e.values {
+		texts[i] = v.text
+	}
+	return texts
+}
+
+func fitValue(text string) formValue { return formValue{text: text, kind: "fit"} }
+func badValue(text string) formValue { return formValue{text: text, kind: "bad"} }
+func anyValue(text string) formValue { return formValue{text: text, kind: "any"} }
+
+// valueFor is one value of the field: fit for it 86, bad for it 8, any 6.
+func valueFor(sf reflect.StructField) hegel.Generator[formValue] {
+	return dieChoice(
+		hzW(86, hegel.Map(evenHalves(hzFieldValues(sf, false)...), fitValue)), // fit nominal 86: realises 86.0
+		hzW(8, hegel.Map(evenHalves(hzFieldValues(sf, true)...), badValue)),   // bad nominal 8: realises 7.8
+		hzW(6, hegel.Map(anyValues, anyValue)),                                // any nominal 6: realises 6.2
+	)
+}
+
+// valueCounts is the number of values of a present key: 0 to 3, a zero kept three times in
+// ten (one value otherwise); for an array, as many as it has elements six times in ten.
+func valueCounts(sf reflect.StructField) hegel.Generator[int] {
+	counts := hegel.FlatMap(rangeHalves(0, 3), func(n int) hegel.Generator[int] { // 0 to 3, nominal 25 each: the zero kept 30 (nominal 7.5 / 42.5 / 25 / 25: realise 8.1 / 42.4 / 24.9 / 24.6 of the non-array keys)
+		if n > 0 {
+			return hegel.Just(n)
+		}
+		return hegel.Map(dieCoin(30), func(zero bool) int {
+			if zero {
+				return 0
+			}
+			return 1
+		})
+	})
+	if sf.Type.Kind() != reflect.Array {
+		return counts
+	}
+	return hegel.FlatMap(counts, func(n int) hegel.Generator[int] {
+		return hegel.Map(dieCoin(60), func(full bool) int { // the array's length nominal 60: realises 72.7 with the counts that happen to be it
+			if full {
+				return sf.Type.Len()
+			}
+			return n
+		})
+	})
+}
+
+// entryFor is the entry of the key for the field: absent, or present pct times in a hundred
+// with its values.
+func entryFor(key string, sf reflect.StructField, pct int) hegel.Generator[formEntry] {
+	present := hegel.FlatMap(valueCounts(sf), func(n int) hegel.Generator[formEntry] {
+		return hegel.Map(hzCounted(valueFor(sf), n, n), func(vs []formValue) formEntry { return formEntry{key: key, values: vs} })
+	})
+	return dieChoice(
+		hzW(100-pct, hegel.Just(formEntry{})),
+		hzW(pct, present), // present nominal 65: realises 65.5
+	)
+}
+
+// strays is the stray entry of a form: none, or one time in four a key the type does not
+// look up (or "e", which it may) with any value.
+var strays = dieChoice(
+	hzW(75, hegel.Just(formEntry{})),
+	hzW(25, hegel.FlatMap(evenHalves(hzStrayKeys...), func(k string) hegel.Generator[formEntry] { // a stray key nominal 25: realises 23.8
+		return hegel.Map(anyValues, func(v string) formEntry { return formEntry{key: k, values: []formValue{anyValue(v)}} })
+	})),
+)
+
+// formsFor is the form for a destination of the type: an entry per key the type looks up
+// (hzKeysOf), the first present firstPct times in a hundred and the rest 65, then the stray
+// entry.
+func formsFor(t reflect.Type, tag string, firstPct int) hegel.Generator[formSpec] {
+	keys := map[string]reflect.StructField{}
+	var order []string
+	hzKeysOf(t, tag, keys, &order)
+	gens := make([]hegel.Generator[formEntry], len(order))
+	for i, k := range order {
+		pct := 65
+		if i == 0 {
+			pct = firstPct
+		}
+		gens[i] = entryFor(k, keys[k], pct)
+	}
+	return hegel.FlatMap(hzTuple(gens...), func(es []formEntry) hegel.Generator[formSpec] {
+		var present []formEntry
+		for _, e := range es {
+			if e.key != "" {
+				present = append(present, e)
+			}
+		}
+		return hegel.Map(strays, func(s formEntry) formSpec { return formSpec{entries: present, stray: s} })
+	})
+}
+
+// hzShowForm renders a form deterministically.
+func hzShowForm(form map[string][]string) string {
+	var parts []string
+	for k, vs := range form {
+		parts = append(parts, fmt.Sprintf("%s=%q", k, vs))
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, " ")
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// bindCase is a case of the FormMapping property: the mapping tag name, the destination type
+// as drawn and as built, whether the destination is passed by value (the shape of gin/10)
+// and the form.
+type bindCase struct {
+	tag     string
+	spec    structSpec
+	typ     reflect.Type
+	byValue bool
+	form    formSpec
+}
+
+func (c bindCase) GoString() string {
+	how := "by pointer"
+	if c.byValue {
+		how = "by value"
+	}
+	return fmt.Sprintf("bindCase{tag %s; type %v; %s; form %s}", c.tag, c.typ, how, hzShowForm(c.form.form()))
+}
+
+var (
+	tags = dieChoice(
+		hzW(76, hegel.Just("form")), // form nominal 75: weight 76 realises 77.9 (74.9 at seed 8; the first draw of a case, which the engine's dice bend most)
+		hzW(24, hegel.Just("uri")),  // uri nominal 25: realises 22.1
+	)
+
+	// byValues is the destination by value: the shape of gin/10, one time in twenty, never
+	// under HEGEL_NO_KNOWN=1.
+	byValues = dieChoice(
+		hzW(95, hegel.Just(false)),
+		hzW(hzUnless(hzNoKnown, 5), hegel.Just(true)), // by value nominal 5: realises 4.8
+	)
+
+	// bindCases are the cases of the FormMapping property: the tag, the type, the form for it
+	// and the destination's way; under HEGEL_NO_KNOWN=1 the cases the classifier names are
+	// filtered out (withoutShapes: the shapes of gin/11 and gin/12 are properties of the type
+	// and the form together).
+	bindCases = withoutShapes(bindExpected, hegel.FlatMap(tags, func(tag string) hegel.Generator[bindCase] {
+		return hegel.FlatMap(structSpecs, func(spec structSpec) hegel.Generator[bindCase] {
+			t := typeOf(spec, tag)
+			return hegel.FlatMap(formsFor(t, tag, 65), func(form formSpec) hegel.Generator[bindCase] {
+				return hegel.Map(byValues, func(byValue bool) bindCase {
+					return bindCase{tag: tag, spec: spec, typ: t, byValue: byValue, form: form}
+				})
+			})
+		})
+	}))
+)
+
+// mapDestCase is a case of the FormMapDest property: the map type, whether the destination
+// is passed by pointer, whether the map is nil, the key of an entry already there ("" for
+// none) and the form.
+type mapDestCase struct {
+	mapType   reflect.Type
+	byPointer bool
+	nilMap    bool
+	entry     string
+	form      formSpec
+}
+
+func (c mapDestCase) GoString() string {
+	how := "by value"
+	if c.byPointer {
+		how = "by pointer"
+	}
+	state := "empty"
+	switch {
+	case c.nilMap:
+		state = "nil"
+	case c.entry != "":
+		state = "with an entry " + c.entry
+	}
+	return fmt.Sprintf("mapDestCase{%v %s, %s; form %s}", c.mapType, how, state, hzShowForm(c.form.form()))
+}
+
+// destination is the map as the library is given it: a fresh map with the entry, nil when
+// nilMap, the pointer to it when byPointer.
+func (c mapDestCase) destination() reflect.Value {
+	mt := c.mapType
+	m := reflect.MakeMap(mt)
+	if c.nilMap {
+		m = reflect.Zero(mt)
+	} else if c.entry != "" {
+		k := reflect.ValueOf(c.entry)
+		switch mt.Elem().Kind() {
+		case reflect.String:
+			m.SetMapIndex(k, reflect.ValueOf("old"))
+		case reflect.Int:
+			m.SetMapIndex(k, reflect.ValueOf(1))
+		case reflect.Slice:
+			m.SetMapIndex(k, reflect.Zero(mt.Elem()))
+		}
+	}
+	if !c.byPointer {
+		return m
+	}
+	p := reflect.New(mt)
+	p.Elem().Set(m)
+	return p
+}
+
+var (
+	hzMapTypes = []reflect.Type{
+		hzTypeMapStr, hzTypeMapStr,
+		reflect.TypeOf(map[string][]string{}), reflect.TypeOf(map[string][]string{}),
+		hzTypeMapInt, reflect.TypeOf(map[string][]int{}), reflect.TypeOf(map[int]string{}),
+	}
+	mapTypes = evenHalves(hzMapTypes...) // the seven entries, nominal 14.3 each: realise 14.4 to 15.5 (map[string]string 28.2, map[string][]string 26.8)
+
+	// destEntries is an entry of a FormMapDest form: zero to three any values (none never
+	// under HEGEL_NO_KNOWN=1: a key without values is the shape of gin/8) under a pool key.
+	destEntries = destEntriesOf(dieInts(0, hzUnless(hzNoKnown, 1), 1, 1, 1)) // 0 to 3 values, nominal 25 each: realise 24.5 / 23.7 / 24.6 / 27.2
+
+	// destForms is the form of a FormMapDest case: zero to three entries (a repeated key
+	// overrides).
+	destForms = hegel.Map(countedHalves(destEntries, 0, 3), func(es []formEntry) formSpec { return formSpec{entries: es} }) // 0 to 3 entries, nominal 25 each: realise 22.2 / 21.3 / 26.7 / 29.8 (the engine keeps fewer of the short cases)
+
+	// mapDestCases are the cases of the FormMapDest property: the type, the form, by pointer
+	// six times in ten, nil three times in ten (never with a non-empty form under
+	// HEGEL_NO_KNOWN=1: the shape of gin/8), else an entry already there half the time; a nil
+	// map by value is kept three times in ten (a fresh map otherwise). A Composite: the
+	// entry and the by-value coins depend on the draws before.
+	mapDestCases = withoutShapes(mapDestExpected, hegel.Composite(func(tc hegel.TestCase) mapDestCase {
+		c := mapDestCase{mapType: hegel.Draw(tc, mapTypes)}
+		c.form = hegel.Draw(tc, destForms)
+		c.byPointer = hegel.Draw(tc, dieCoin(62))                                                 // by pointer nominal 60: weight 62 realises 62.3 (59.4 at seed 8)
+		c.nilMap = hegel.Draw(tc, dieCoin(hzUnless(hzNoKnown && len(c.form.entries) > 0, 33)))    // nil nominal 30: weight 33 realises 23.6 after the by-value coin below (nominal 22.1 then)
+		if !c.nilMap && hegel.Draw(tc, dieCoin(55)) && c.mapType.Key().Kind() == reflect.String { // an entry nominal 50 of the non-nil string-keyed ones: weight 55 realises 48.2
+			c.entry = hegel.Draw(tc, poolKeys)
+		}
+		if c.nilMap && !c.byPointer && !hegel.Draw(tc, dieCoin(30)) { // a nil map by value kept nominal 30
+			c.nilMap = false
+		}
+		return c
+	}))
+)
+
+// destEntriesOf is an entry of a FormMapDest form with its value count drawn by counts.
+func destEntriesOf(counts hegel.Generator[int]) hegel.Generator[formEntry] {
+	return hegel.FlatMap(counts, func(n int) hegel.Generator[formEntry] {
+		return hegel.FlatMap(hzCounted(hegel.Map(anyValues, anyValue), n, n), func(vs []formValue) hegel.Generator[formEntry] {
+			return hegel.Map(poolKeys, func(k string) formEntry { return formEntry{key: k, values: vs} })
+		})
+	})
+}
diff --git a/binding/hegel_zoo_idioms_test.go b/binding/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..4a0dd43
--- /dev/null
+++ b/binding/hegel_zoo_idioms_test.go
@@ -0,0 +1,527 @@
+package binding
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia, go/carbon, go/orb, go/chi and go/go-debian harness
+// (hegel_idioms_test.go there; go/bubbles' internal/zootest/gen.go before it) with the hz
+// prefix: hegel-go has no weighted choice, biased coin, tuple or counted-list combinator.
+// (This target's old draw helpers hzDrawInt, hzChance(tc, pct) and hzPick are gone with the
+// generators that used them: hzChance(num, den) below is the generator of fair bits.) Every
+// generator built from them is a package-level value; the simplest alternative comes first so
+// that shrinking lands on it, except the shape of a recorded bug a wide property must reach
+// every run, which goes first at a solid weight and is never drawn under HEGEL_NO_KNOWN=1.
+// The weights are nominal: a weighted choice drawn alone comes out exact (the engine
+// enumerates a small die), but inside a case with other draws the engine favours the second
+// value of any bounded draw (go/chi measured it at about nine points over its share, whatever
+// the range), so the rates are what the probe and the collector (ZOO_COLLECT=1) measure;
+// hzFair, fairOver, fairInts, evenOver and fairTree (from go/chi) re-roll that favourite face
+// and realise their weights within a point or two, the die* family at the end of this file
+// (from go/go-debian) draws from fair bits, and the figure beside every weight in
+// hegel_zoo_forms_test.go is the measured one.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].gen
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].gen
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var gens []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			gens = append(gens, hegel.Just(vs[i]))
+		} else {
+			gens = append(gens, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(gens)), func(i int) hegel.Generator[T] { return gens[i] })
+	}
+	choices := make([]hzChoice[T], len(gens))
+	for i, g := range gens {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
diff --git a/binding/hegel_zoo_pins_test.go b/binding/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..a90a412
--- /dev/null
+++ b/binding/hegel_zoo_pins_test.go
@@ -0,0 +1,153 @@
+package binding
+
+// Pins: one test per recorded bug of the binding package (bugs.toml gin/8 ... gin/12), each
+// asserting the documented behaviour; they fail while the bug exists and are listed as
+// expected failures in target.toml.
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestHegelPinNilMapDestination: gin/8. Binding into a nil map (the usual `var m
+// map[string]string; c.ShouldBindQuery(&m)`) must fill it or return an error, not panic; a
+// key without values must not panic either.
+func TestHegelPinNilMapDestination(t *testing.T) {
+	form := map[string][]string{"a": {"1"}, "b": {"2", "3"}}
+	var m map[string]string
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(&m, form, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("nil map[string]string by pointer: panic %v", r)
+	} else if m != nil && !reflect.DeepEqual(m, map[string]string{"a": "1", "b": "3"}) {
+		t.Errorf("nil map[string]string by pointer: got %v", m)
+	}
+	var ms map[string][]string
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(&ms, form, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("nil map[string][]string by pointer: panic %v", r)
+	}
+	got := map[string]string{}
+	if r := hzCatch(func() {
+		if err := MapFormWithTag(got, map[string][]string{"a": {}}, "form"); err != nil {
+			t.Logf("error returned: %v", err)
+		}
+	}); r != nil {
+		t.Errorf("key without values: panic %v", r)
+	}
+}
+
+// hzNode: a struct with a pointer to its own type, as a tree node or a linked list has.
+type hzNode struct {
+	Name   string  `form:"name"`
+	Parent *hzNode `form:"parent"`
+}
+
+// TestHegelPinSelfReference: gin/9. Binding a struct with a pointer field of its own type
+// (no `form:"-"`) must not recurse without end: the child process that binds it must exit
+// normally. A fatal stack overflow cannot be recovered in-process, hence the child.
+func TestHegelPinSelfReference(t *testing.T) {
+	if os.Getenv("HZ_SELF_REFERENCE_CHILD") == "1" {
+		var n hzNode
+		err := MapFormWithTag(&n, map[string][]string{"name": {"leaf"}}, "form")
+		fmt.Printf("HZ child: name=%q parent=%v err=%v\n", n.Name, n.Parent, err)
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHegelPinSelfReference$", "-test.v")
+	cmd.Env = append(os.Environ(), "HZ_SELF_REFERENCE_CHILD=1")
+	out, err := cmd.CombinedOutput()
+	s := string(out)
+	if len(s) > 400 {
+		s = s[:400] + " ..."
+	}
+	if err != nil {
+		t.Fatalf("binding a self-referential struct: the child process failed: %v\n%s", err, s)
+	}
+	if !strings.Contains(string(out), `HZ child: name="leaf" parent=<nil> err=<nil>`) {
+		t.Fatalf("binding a self-referential struct: unexpected child output\n%s", s)
+	}
+}
+
+// TestHegelPinValueDestination: gin/10. A destination passed by value cannot be filled; the
+// JSON, XML, YAML and TOML bindings return an error for it, so must the form mapping - not a
+// panic in reflect.
+func TestHegelPinValueDestination(t *testing.T) {
+	type dest struct {
+		A string `form:"a"`
+	}
+	var err error
+	if r := hzCatch(func() { err = MapFormWithTag(dest{}, map[string][]string{"a": {"x"}}, "form") }); r != nil {
+		t.Fatalf("struct by value: panic %v", r)
+	}
+	if err == nil {
+		t.Fatalf("struct by value: no error")
+	}
+}
+
+// TestHegelPinEmptyValueStruct: gin/11. An empty value leaves an int at 0, a string empty, a
+// time.Time zero and a slice with one zero element; a struct or map field given an empty
+// value must be left at its zero too, not fail with a JSON error.
+func TestHegelPinEmptyValueStruct(t *testing.T) {
+	type dest struct {
+		N int             `form:"n"`
+		J struct{ I int } `form:"j"`
+		M map[string]int  `form:"m"`
+	}
+	var d dest
+	if err := MapFormWithTag(&d, map[string][]string{"n": {""}}, "form"); err != nil {
+		t.Fatalf("n=: %v", err)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"j": {""}}, "form"); err != nil {
+		t.Errorf("j= (struct field): error %v", err)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"m": {""}}, "form"); err != nil {
+		t.Errorf("m= (map field): error %v", err)
+	}
+}
+
+// TestHegelPinEmptySliceValueDefault: gin/12. The default applies to a value the client
+// leaves empty (`?age=` gives the default age, TestMappingFormWithEmptyToDefault); so must it
+// for a slice or array field: `?friends=` must give the default friends, not one empty one.
+func TestHegelPinEmptySliceValueDefault(t *testing.T) {
+	type dest struct {
+		Name    string    `form:"name,default=William"`
+		Friends []string  `form:"friends,default=Will;Bill"`
+		Laps    []int     `form:"laps,default=1;2;3" collection_format:"csv"`
+		Pair    [2]string `form:"pair,default=foo bar" collection_format:"ssv"`
+	}
+	var d dest
+	if err := MapFormWithTag(&d, map[string][]string{"name": {""}}, "form"); err != nil {
+		t.Fatalf("name=: error %v", err)
+	}
+	if d.Name != "William" {
+		t.Fatalf("name= gives %q", d.Name)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"friends": {""}}, "form"); err != nil {
+		t.Errorf("friends=: error %v", err)
+	} else if !reflect.DeepEqual(d.Friends, []string{"Will", "Bill"}) {
+		t.Errorf("friends= gives %q, want the default [Will Bill] as name= gives William", d.Friends)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"laps": {""}}, "form"); err != nil {
+		t.Errorf("laps=: error %v", err)
+	} else if !reflect.DeepEqual(d.Laps, []int{1, 2, 3}) {
+		t.Errorf("laps= gives %v, want the default [1 2 3]", d.Laps)
+	}
+	if err := MapFormWithTag(&d, map[string][]string{"pair": {""}}, "form"); err != nil {
+		t.Errorf("pair=: error %v", err)
+	} else if d.Pair != [2]string{"foo", "bar"} {
+		t.Errorf("pair= gives %q, want the default [foo bar]", d.Pair)
+	}
+}
diff --git a/binding/hegel_zoo_test.go b/binding/hegel_zoo_test.go
new file mode 100644
index 0000000..c416072
--- /dev/null
+++ b/binding/hegel_zoo_test.go
@@ -0,0 +1,624 @@
+package binding
+
+// Hegel property tests for gin-gonic/gin's binding package (form_mapping.go), written for the
+// Hegel zoo: part 2 of targets/go/gin/README.md. They live in package binding because the
+// mapping's entry points other than MapFormWithTag are unexported; every identifier carries
+// the hz prefix to stay clear of the upstream tests (the harness names copied from the
+// go/go-debian series and package gin's part 1 - known, checks, judged, shapeBy, verdict,
+// regionOf and the die* family - are kept as they are there so that the series reads alike).
+//
+// Oracle: a model of the documented mapping of form values (map[string][]string) into a
+// struct by its `form`/`uri` tags - field names, default=, collection_format, parser=,
+// time_format, time_utc, time_location, BindUnmarshaler - over struct types built at runtime
+// with reflect.StructOf from drawn specs, and of the mapping into a map destination.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES and
+// HEGEL_SEED are passed through hegelOpts; a panic in the code under test is turned into a
+// failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has. ZOO_COLLECT=1 (or HEGEL_COLLECT=1) makes the properties record
+// their mismatches instead of failing and print the counts.
+//
+// Every property (hegel_zoo_form_test.go, hegel_zoo_form_shapes_test.go) draws its cases as
+// records from package-level generators (hegel_zoo_forms_test.go), judges the library against
+// a model that states the documented behaviour (every switch of the known value below off)
+// and names the shape of the recorded bug a case has before the library is called (the
+// harness in this file; the replicas of form_mapping.go's rules under the switches are the
+// model of hegel_zoo_form_model_test.go). This file and hegel_zoo_idioms_test.go are package
+// gin's harness files (part 1 of the series) with the package line and this comment changed
+// and without part 1's SetMode init, which does not apply here.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hegelOpts passes HEGEL_TEST_CASES and HEGEL_SEED through to the engine, which reads no
+// environment variable itself (the seed is for the rate measurements of the probe and the
+// collector).
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi and go/go-debian judge; hegel_zoo_idioms_test.go has
+// the generator idioms). The model of each family takes the set of recorded bugs it follows
+// as a value (known); the properties judge the library against the documented behaviour
+// (hzKnownNone), name the shape of the recorded bug a case has before the library is called
+// (hzCaseJudge.Shape, from the classifier shapeBy) and skip, drop or filter the shapes under
+// HEGEL_NO_KNOWN=1 (hzNoKnown).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != "" || os.Getenv("HEGEL_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below in
+// bug order (the id of a switch is "gin/<index+1>"). The model of each property is a pure
+// function of (case, known): with every switch off (hzKnownNone) it states the documented
+// behaviour (the README's matching rules with backtracking, the option docs quoted at the top
+// of hegel_zoo_engine_test.go, url.PathUnescape for a path value) and is what the properties
+// judge the library against; with a switch on it reproduces that bug as a replica of the
+// tree's rule, transcribed from tree.go and gin.go at the point named beside the switch. The
+// classifier of each property runs the model with several sets to name the shape of a case
+// before the library is called; the pins assert the documented behaviour and fail while the
+// bug exists. The model walk (hegel_zoo_router_test.go) follows 1, 2, 3, 4, 6, 13 and 14 (and
+// 7, the stack it is handed); the engine model (hegel_zoo_engine_test.go) 5, 7 and 15 on top
+// of it; 8 to 12 are the binding package's (part 2 of the series) and only exist here so that
+// the ids are complete.
+type known [15]bool
+
+const (
+	// gin/1: a static route one slash away from the request shadows a matching :param route
+	kStaticShadowsParam = iota
+	// gin/2: a :param branch that dead-ends is not abandoned for the wildcard sibling of an earlier node
+	kParamDeadEnd
+	// gin/3: RedirectTrailingSlash redirects a path ending in a slash to a path that has no route
+	kTrailingSlashToNothing
+	// gin/4: RedirectFixedPath never finds a route whose *catch-all follows a :param
+	kFixedPathMissesCatchAll
+	// gin/5: UseRawPath with UnescapePathValues turns a plus in a path value into a space
+	kPlusUnescapedToSpace
+	// gin/6: RedirectFixedPath redirects a path ending in a slash to a path that has no route
+	kFixedPathToNothing
+	// gin/7: the skipped-nodes stack is not reset between the method trees of one request: wrong 405 and a panic
+	kSkippedNodesLeak
+	// gin/8: binding a form into a nil map panics, as does a key without values
+	kNilMapPanics
+	// gin/9: a struct with a pointer field of its own type binds until the stack overflows
+	kSelfReferenceOverflows
+	// gin/10: a destination passed by value panics instead of returning an error
+	kValueDestinationPanics
+	// gin/11: an empty value for a struct or map field is a JSON error
+	kEmptyValueJSONError
+	// gin/12: an empty value for a slice or array field is not replaced by its default
+	kEmptyValueWithoutDefault
+	// gin/13: RedirectTrailingSlash misses the redirect to path + "/" when a :param route is registered beside the static branch
+	kParamSiblingHidesSlashRedirect
+	// gin/14: mixed static:param routes at one position overflow the skipped-nodes stack: a panic on a plain request
+	kMixedSegmentsOverflowStack
+	// gin/15: RedirectTrailingSlash does not recommend a path the tree serves through an empty :param value before the slash
+	kEmptyParamSlashUnrecommended
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("gin/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "gin/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "gin/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape gin/N" per
+// case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// gin/N"), the checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped gin/N"), the draws
+// the filters rejected ("filtered <name>"), the replica's agreement with the library on the
+// shaped cases ("replica agreement", "replica disagreement"), the cases noted for a design
+// exclusion ("noted <what>") and the model's notes on the engine's answers ("tsr: documented
+// only", "tsr: tree only", "tsr: hidden by rollback", "tsr: empty param unrecommended",
+// "fixed: same path"); printed and reset by the collector, under hzStatsMu. (A case assumed
+// away for an unrecorded candidate bug would be counted "candidate/go/gin-N ..." here; none
+// is left.)
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi and go/go-debian judge, with the collector's mismatch
+// classes): it names the recorded bug whose shape the case has, so that a mismatch or a
+// library panic fails "(the shape of gin/N)", and under HEGEL_NO_KNOWN=1 skips the case
+// instead (counted as known). The wide and the narrow properties of a family share their judge
+// function and so this. The classifier that names the shape is computed from the case alone
+// (the model run with several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are filtered
+// out of the requests by the classifier, or the regions past them drawn), and the collector
+// measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped gin/N") and the case goes on
+// (judgeByDropping; no property of this part needs it, the form is kept for part 2).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (shared by every family; the go/carbon, go/orb, go/chi and go/go-debian form:
+// every value here is text compared exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// checkOrder is the order the checks of a case are reported in when it fails (the order the
+// models state them in): the acceptance first, then the requests in order, then the
+// clean-path checks; other names sort by text.
+var checkOrder = map[string]int{
+	"rejected": 0, "acceptance": 1, "r1": 2, "r2": 3, "r3": 4, "r4": 5, "r5": 6, "r6": 7,
+	"clean": 10, "idempotent": 11,
+}
+
+func checkLess(a, b string) bool {
+	ar, aok := checkOrder[a]
+	br, bok := checkOrder[b]
+	if aok && bok && ar != br {
+		return ar < br
+	}
+	if aok != bok {
+		return aok
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two statements agree: the same checks, each value equal.
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || a[k] != w {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, a[k]))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, a[k], w))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("gin/?", a defect of the model). The
+// order matters where two shapes meet (a static branch that stops at a "/" node meets gin/1
+// and gin/3; the leak of gin/7 rides on the stops of gin/1 and gin/2 in the pins' instances):
+// sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "gin/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters and the request filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	verdictBy(j, c, got, want, shape, expected, sameChecks)
+}
+
+// verdictBy is verdict with the family's own notion of replica agreement (none of this
+// target's families needs one; the form is kept from go/chi, whose RouteHeaders replica is a
+// set and agreement is membership).
+func verdictBy[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks, agrees func(got, replica checks) bool) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agrees(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if sameChecks(got, want) {
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || g != want[k] {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	j.Fail(class, "%s for\n%#v", diffChecks(got, want), c)
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi and go/go-debian form): by default the shape is named and
+// every check judged; under HEGEL_NO_KNOWN=1 the checks the shapes cover (those on which the
+// replica with every switch on differs from the documented model, or which it does not
+// state) are dropped from the case (hzCaseJudge.Dropped, counted "dropped gin/N") and the
+// rest judged, the case not skipped. No property of this part needs it (the shapes are
+// filtered out of the requests instead); kept for part 2.
+func judgeByDropping[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	want := expected(c, hzKnownNone)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(c, hzKnownAll)
+		for name, v := range want {
+			if w, ok := all[name]; !ok || w != v {
+				delete(want, name)
+			}
+		}
+		verdict(j, c, actual(c), want, "", expected)
+		return
+	}
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few walks.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered gin/N" by the shape it had), g itself otherwise: the
+// request generators of the wide properties run it on each request alone (a shape here is a
+// property of the routes and one request), so that no case of a wide property is skipped.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
