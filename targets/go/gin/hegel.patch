+package binding
+
+// The narrow properties: one per recorded bug of the binding package (gin/8 to gin/12), each
+// over the region of that bug's shape with random surroundings (the ingredient forced, the
+// rest drawn from the wide generators), judged by the wide property's model and judge
+// (judgeMapDest over mapDestExpected for gin/8, judgeBind over bindExpected for gin/10 to
+// gin/12; gin/9 has a judge of its own, the library called in a child process). By default
+// each draws the shape and fails every run naming the bug; under HEGEL_NO_KNOWN=1 each draws
+// the region past the shape (hzShaped) and passes. The generators of gin/8 and gin/10 to
+// gin/12 are filtered by the classifier (regionOf: by default the cases it names as that bug,
+// under NO_KNOWN the cases it names as no bug), so that a surrounding that spoils the shape -
+// an earlier field whose bad value is the error both models report first, a
+// collection_format the mapping refuses - is rejected; the rejections measured over 3000
+// cases ("filtered gin/N" by default / under NO_KNOWN) are in the comment of each.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- gin/8
+
+// nilMapCases: the shape in the note's two instances - a nil map of one of the two supported
+// types, by pointer, with a form of one to three keys (the nil-map instance), or a
+// map[string]string (by pointer or by value, with or without an entry) given a key whose
+// value list is empty, the last entry of the form so that no other overrides it (the
+// empty-list instance); past the shape, the map is allocated, and every list has a value.
+// Rejections: 0 / 0.
+var nilMapCases = regionOf("gin/8", mapDestExpected, hegel.Composite(func(tc hegel.TestCase) mapDestCase {
+	nilInstance := hegel.Draw(tc, dieCoin(50)) // the nil-map instance nominal 50, the empty-list one otherwise
+	if nilInstance {
+		return mapDestCase{
+			mapType:   hegel.Draw(tc, evenHalves(hzTypeMapStr, hzTypeMapStrSlice)),
+			byPointer: true,
+			nilMap:    hzShaped(true, false),
+			form:      formSpec{entries: hegel.Draw(tc, countedHalves(destEntries, 1, 3))},
+		}
+	}
+	c := mapDestCase{mapType: hzTypeMapStr, byPointer: hegel.Draw(tc, dieCoin(60))}
+	if hegel.Draw(tc, dieCoin(50)) {
+		c.entry = hegel.Draw(tc, poolKeys)
+	}
+	others := hegel.Draw(tc, countedHalves(destEntriesOf(rangeHalves(hzShaped(0, 1), 3)), 0, 2))
+	last := hegel.Draw(tc, destEntriesOf(hzShaped(hegel.Just(0), rangeHalves(1, 3))))
+	c.form = formSpec{entries: append(others, last)}
+	return c
+}))
+
+// TestHegelNilMapsAreAllocated (gin/8): a nil map destination is filled, as a map the user
+// allocated is, and a key without values gives it nothing - no panic either way.
+func TestHegelNilMapsAreAllocated(t *testing.T) {
+	judged(t, nilMapCases, judgeMapDest)
+}
+
+// --------------------------------------------------------------------------- gin/9
+
+// The family of recursive named types (reflect.StructOf cannot make a cycle): a tree node
+// (hzNode, declared in hegel_zoo_pins_test.go: Name and Parent *hzNode), a linked list, a
+// pair of types pointing at each other, a node with two pointer fields; and the twins past
+// the shape, their recursive fields tagged `-` for both mapping tags (the package's own
+// TestMappingIgnoredCircularRef relies on that tag).
+type hzList struct {
+	Next *hzList `form:"next"`
+}
+
+type hzA struct {
+	Name string `form:"name"`
+	B    *hzB   `form:"b"`
+}
+
+type hzB struct {
+	A *hzA `form:"a"`
+}
+
+type hzTwo struct {
+	Name  string `form:"name"`
+	Left  *hzTwo `form:"left"`
+	Right *hzTwo `form:"right"`
+}
+
+type hzNodeCut struct {
+	Name   string     `form:"name"`
+	Parent *hzNodeCut `form:"-" uri:"-"`
+}
+
+type hzListCut struct {
+	Next *hzListCut `form:"-" uri:"-"`
+}
+
+type hzACut struct {
+	Name string  `form:"name"`
+	B    *hzBCut `form:"b"`
+}
+
+type hzBCut struct {
+	A *hzACut `form:"-" uri:"-"`
+}
+
+type hzTwoCut struct {
+	Name  string    `form:"name"`
+	Left  *hzTwoCut `form:"-" uri:"-"`
+	Right *hzTwoCut `form:"-" uri:"-"`
+}
+
+// hzHubs are the recursive types by name, with their twins past the shape.
+var hzHubs = map[string][2]reflect.Type{
+	"node": {reflect.TypeOf(hzNode{}), reflect.TypeOf(hzNodeCut{})},
+	"list": {reflect.TypeOf(hzList{}), reflect.TypeOf(hzListCut{})},
+	"pair": {reflect.TypeOf(hzA{}), reflect.TypeOf(hzACut{})},
+	"two":  {reflect.TypeOf(hzTwo{}), reflect.TypeOf(hzTwoCut{})},
+}
+
+// selfRefCase is a case of the gin/9 property, passed to the child process as JSON (hence
+// the exported fields): the recursive type (Hub), whether its twin past the shape is meant
+// (Cut), whether it sits behind a pointer field of a wrapper struct built with
+// reflect.StructOf (Wrap: F0 a string with LeafTag, F1 the pointer with PtrTag), the mapping
+// tag name and the form, which never holds a recursive key.
+type selfRefCase struct {
+	Hub     string
+	Cut     bool
+	Wrap    bool
+	LeafTag string
+	PtrTag  string
+	Tag     string
+	Form    map[string][]string
+}
+
+// typ is the destination type of the case.
+func (c selfRefCase) typ() reflect.Type {
+	hub := hzHubs[c.Hub][0]
+	if c.Cut {
+		hub = hzHubs[c.Hub][1]
+	}
+	if !c.Wrap {
+		return hub
+	}
+	return reflect.StructOf([]reflect.StructField{
+		{Name: "F0", Type: hzTypeString, Tag: reflect.StructTag(c.LeafTag)},
+		{Name: "F1", Type: reflect.PointerTo(hub), Tag: reflect.StructTag(c.PtrTag)},
+	})
+}
+
+func (c selfRefCase) GoString() string {
+	return fmt.Sprintf("selfRefCase{tag %s; type %v; form %s}", c.Tag, c.typ(), hzShowForm(c.Form))
+}
+
+var (
+	hubNames  = evenHalves("node", "list", "pair", "two")
+	leafTags  = evenHalves(``, `form:"f"`, `form:"leaf"`)
+	ptrTags   = evenHalves(`form:"r"`, ``, `form:"node"`, `form:"r" uri:"r"`)
+	leafTexts = evenHalves("x", "leaf", "", "a b", "7")
+
+	// selfRefForms is the form of a case: zero to three entries over the leaf keys of the
+	// wrapper and the hub under either tag name (F0, f, leaf, Name, name) and a stray key,
+	// each with one leaf text - never a recursive key (parent, next, a, b, left, right, F1,
+	// r, node or their capitalised field names).
+	selfRefForms = hegel.Map(countedHalves(hegel.FlatMap(evenHalves("F0", "f", "leaf", "Name", "name", "zz"), func(k string) hegel.Generator[formEntry] {
+		return hegel.Map(leafTexts, func(v string) formEntry { return formEntry{key: k, values: []formValue{fitValue(v)}} })
+	}), 0, 3), func(es []formEntry) map[string][]string { return formSpec{entries: es}.form() })
+
+	// selfRefCases: the shape is the recursive type reached through a nil pointer field that
+	// no key of the form fills, bare or behind a wrapper's pointer field; past the shape, the
+	// twin whose recursive field is tagged `-`. A Composite: it only draws.
+	selfRefCases = hegel.Composite(func(tc hegel.TestCase) selfRefCase {
+		c := selfRefCase{Hub: hegel.Draw(tc, hubNames), Cut: hzShaped(false, true)}
+		c.Wrap = hegel.Draw(tc, dieCoin(50)) // behind a wrapper nominal 50
+		if c.Wrap {
+			c.LeafTag = hegel.Draw(tc, leafTags)
+			c.PtrTag = hegel.Draw(tc, ptrTags)
+		}
+		c.Tag = hegel.Draw(tc, tags)
+		c.Form = hegel.Draw(tc, selfRefForms)
+		return c
+	})
+)
+
+// selfRefExpected states what binding the case in a child process must give: "exit" (the
+// child's exit code, "0"; with gin/9 on, "2 fatal error: stack overflow" - the replica of
+// mapping's descent into a nil pointer field whatever the chain above it, which is all the
+// model states then), "panic" (""), "error" and "value" (the documented answer: the leaf
+// fields from the form, every pointer to a type already being mapped left nil).
+func selfRefExpected(c selfRefCase, k known) checks {
+	v, err := hzModelBind(c.typ(), c.Form, c.Tag, false, k)
+	if err == hzErrOverflow {
+		return checks{"exit": "2 fatal error: stack overflow"}
+	}
+	return checks{"exit": "0", "panic": "", "error": hzErrText(err), "value": hzShowValue(v.Elem())}
+}
+
+// selfRefActual binds the case in a child process: the test binary re-executed on this test
+// alone with the case in HZ_SELF_REFERENCE_CASE (hzSelfRefChild answers on stdout), the exit
+// code with the fatal error's first line when the child died, else the child's answers.
+func selfRefActual(c selfRefCase) checks {
+	text, err := json.Marshal(c)
+	if err != nil {
+		panic(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHegelSelfReferencesStayNil$")
+	cmd.Env = append(os.Environ(), "HZ_SELF_REFERENCE_CASE="+string(text))
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	start := time.Now()
+	runErr := cmd.Run()
+	hzTally("child ms " + strconv.Itoa(int(time.Since(start).Milliseconds())/10*10))
+	if runErr != nil {
+		code := -1
+		var exitErr *exec.ExitError
+		if ok := isExitError(runErr, &exitErr); ok {
+			code = exitErr.ExitCode()
+		}
+		fatal := ""
+		for _, line := range strings.Split(stderr.String(), "\n") {
+			if strings.HasPrefix(line, "fatal error:") || strings.HasPrefix(line, "panic:") {
+				fatal = " " + line
+				break
+			}
+		}
+		return checks{"exit": strconv.Itoa(code) + fatal}
+	}
+	got := checks{"exit": "0"}
+	for sc := bufio.NewScanner(&stdout); sc.Scan(); {
+		line := sc.Text()
+		for _, name := range []string{"panic", "error", "value"} {
+			if rest, ok := strings.CutPrefix(line, "HZ "+name+": "); ok {
+				got[name] = rest
+			}
+		}
+	}
+	return got
+}
+
+func isExitError(err error, target **exec.ExitError) bool {
+	e, ok := err.(*exec.ExitError)
+	if ok {
+		*target = e
+	}
+	return ok
+}
+
+// hzSelfRefChild is the child's half: the case from its text, bound into a fresh value, the
+// panic, the error and the value printed one per line. The stack is capped at 16 MB so that
+// the overflow of gin/9 is reached in milliseconds rather than at the gigabyte the runtime
+// allows (the fatal error is the same; the pin takes a second per child at the default).
+func hzSelfRefChild(text string) {
+	debug.SetMaxStack(16 << 20)
+	var c selfRefCase
+	if err := json.Unmarshal([]byte(text), &c); err != nil {
+		fmt.Printf("HZ panic: bad case: %v\n", err)
+		return
+	}
+	dst := reflect.New(c.typ())
+	var err error
+	r := hzCatch(func() { err = MapFormWithTag(dst.Interface(), c.Form, c.Tag) })
+	fmt.Printf("HZ panic: %s\n", panicText(r))
+	fmt.Printf("HZ error: %s\n", hzErrText(err))
+	fmt.Printf("HZ value: %s\n", hzShowValue(dst.Elem()))
+}
+
+func panicText(r any) string {
+	if r == nil {
+		return ""
+	}
+	return fmt.Sprint(r)
+}
+
+// judgeSelfRef is the judge of the gin/9 property: judgeBy over selfRefExpected and
+// selfRefActual (the child process).
+func judgeSelfRef(j *hzCaseJudge, c selfRefCase) {
+	judgeBy(j, c, selfRefExpected, selfRefActual)
+}
+
+// TestHegelSelfReferencesStayNil (gin/9): binding a struct with a pointer field of its own
+// type (or of a type that points back) leaves the pointer nil when no key of the form
+// reaches it, and the process lives - the binding runs in a child process, which must exit
+// normally with the documented value. Under HEGEL_NO_KNOWN=1 the recursive fields are tagged
+// `-` and the property passes.
+func TestHegelSelfReferencesStayNil(t *testing.T) {
+	if text := os.Getenv("HZ_SELF_REFERENCE_CASE"); text != "" {
+		hzSelfRefChild(text)
+		return
+	}
+	judged(t, selfRefCases, judgeSelfRef)
+}
+
+// --------------------------------------------------------------------------- gin/10
+
+// valueDestinationCases: a struct passed by value whose first field, of any type of the wide
+// generator with a key of its own and the wide tag options, has its key present with the
+// wide values (a form that matches a field: the package panics at that field's first set -
+// an error it meets before, at a pointer field's bad value, is the "some error" the
+// documentation wants, and the classifier rejects the case; a form matching no field is the
+// no-error instance, which the wide property draws); the surroundings after it. Past the
+// shape, the same by pointer. Rejections: 2.3 / 11.8 (by default a pointer field's bad value
+// erroring before the first set; under NO_KNOWN the shapes of gin/11 and gin/12 in the
+// surroundings).
+var valueDestinationCases = regionOf("gin/10", bindExpected, hegel.Map(
+	shapedBindCases(shapedStructs(typeSpecsAt(0), tagSpecsFor), func(sf reflect.StructField) hegel.Generator[[]formValue] {
+		return hegel.FlatMap(valueCounts(sf), func(n int) hegel.Generator[[]formValue] { return hzCounted(valueFor(sf), n, n) })
+	}),
+	func(c bindCase) bindCase {
+		c.byValue = hzShaped(true, false)
+		return c
+	},
+))
+
+// TestHegelValueDestinationsAreErrors (gin/10): a destination passed by value is answered
+// with an error, as the JSON binding answers it, not with a panic in reflect.
+func TestHegelValueDestinationsAreErrors(t *testing.T) {
+	judged(t, valueDestinationCases, judgeBind)
+}
+
+// --------------------------------------------------------------------------- the shaped
+// structs of gin/11 and gin/12
+
+// shapedStructs is a struct whose first field is the shaped one (its type from shaped, its
+// tag a key of its own, plain, or with the options drawn by decorate), followed by zero to
+// three fields of the wide generator; the keys numbered as in the wide generator (the shaped
+// field's is k1 unless a field inside it comes first). A FlatMap chain: the shaped field,
+// then the surroundings.
+func shapedStructs(shaped hegel.Generator[typeSpec], decorate func(typeSpec) hegel.Generator[tagSpec]) hegel.Generator[structSpec] {
+	return hegel.Map(hegel.FlatMap(shaped, func(t typeSpec) hegel.Generator[structSpec] {
+		return hegel.FlatMap(decorate(t), func(tag tagSpec) hegel.Generator[structSpec] {
+			tag.shape, tag.nameKind = tagNamed, nameOwn
+			return hegel.Map(countedHalves(fieldSpecsAt(0), 0, 3), func(rest []fieldSpec) structSpec { // 0 to 3 more fields, nominal 25 each
+				fields := append([]fieldSpec{{typ: t, tag: tag}}, rest...)
+				for i := range fields {
+					fields[i].name = "F" + strconv.Itoa(i)
+				}
+				return structSpec{fields: fields}
+			})
+		})
+	}), func(s structSpec) structSpec {
+		next := 0
+		s.number(&next)
+		return s
+	})
+}
+
+// shapedKey is the key of the shaped field (the first) of the type.
+func shapedKey(s structSpec) string { return s.fields[0].tag.key }
+
+// withValues is the form with the values of the key replaced.
+func withValues(f formSpec, key string, values []formValue) formSpec {
+	entries := make([]formEntry, len(f.entries))
+	copy(entries, f.entries)
+	for i := range entries {
+		if entries[i].key == key {
+			entries[i].values = values
+		}
+	}
+	return formSpec{entries: entries, stray: f.stray}
+}
+
+// shapedBindCases is a FormMapping case over the shaped structs with the shaped field's key
+// present and its values drawn by valuesFor (given the built field).
+func shapedBindCases(structs hegel.Generator[structSpec], valuesFor func(reflect.StructField) hegel.Generator[[]formValue]) hegel.Generator[bindCase] {
+	return hegel.FlatMap(tags, func(tag string) hegel.Generator[bindCase] {
+		return hegel.FlatMap(structs, func(spec structSpec) hegel.Generator[bindCase] {
+			t := typeOf(spec, tag)
+			key := shapedKey(spec)
+			return hegel.FlatMap(formsFor(t, tag, 100), func(form formSpec) hegel.Generator[bindCase] {
+				return hegel.Map(valuesFor(t.Field(0)), func(vs []formValue) bindCase {
+					return bindCase{tag: tag, spec: spec, typ: t, form: withValues(form, key, vs)}
+				})
+			})
+		})
+	})
+}
+
+// --------------------------------------------------------------------------- gin/11
+
+// emptyValueJSONCases: the shaped field is a struct, a pointer to a struct or a map (the
+// wide generator's), its key present with the empty value; past the shape, with "{}". The
+// surroundings after it, so that its error is the first; a surrounding whose own shape the
+// classifier names before (none: gin/10 is never drawn here) or whose error both models
+// report first (none: the shaped field comes first) does not arise. Rejections: 1.2 / 5.8
+// (the shapes of gin/12 and gin/11 in the surroundings).
+var emptyValueJSONCases = regionOf("gin/11", bindExpected, shapedBindCases(
+	shapedStructs(dieChoice(
+		hzW(1, hegel.Map(structSpecsAt(1), structType)),                                                      // a struct nominal 33
+		hzW(1, hegel.Map(structSpecsAt(1), func(s structSpec) typeSpec { return pointerTo(structType(s)) })), // a pointer to one nominal 33
+		hzW(1, mapSpecs), // a map nominal 33
+	), func(typeSpec) hegel.Generator[tagSpec] { return hegel.Just(tagSpec{}) }),
+	func(reflect.StructField) hegel.Generator[[]formValue] {
+		return hegel.Just([]formValue{fitValue(hzShaped("", "{}"))})
+	},
+))
+
+// TestHegelEmptyValuesLeaveStructsAndMaps (gin/11): an empty value for a struct or map field
+// leaves it at its zero, as an empty value leaves every other kind, instead of failing the
+// binding with a JSON error.
+func TestHegelEmptyValuesLeaveStructsAndMaps(t *testing.T) {
+	judged(t, emptyValueJSONCases, judgeBind)
+}
+
+// --------------------------------------------------------------------------- gin/12
+
+// hzArrayFormats are the collection formats of a shaped array of gin/12 (the table without
+// tsv, whose separator cannot be spelled in a tag, and "bad"); hzDefaultSepOf the separator
+// of an array's default for its format: ";" for multi and csv (the mapping turns it into
+// ","), " " for ssv, "|" for pipes.
+var (
+	hzArrayFormats = []string{"multi", "csv", "csv", "csv", "ssv", "ssv", "pipes", "pipes", "multi", "csv", "ssv", "pipes", "csv"}
+	hzDefaultSepOf = map[string]string{"": ";", "multi": ";", "csv": ";", "ssv": " ", "pipes": "|"}
+)
+
+// nonZero is tagAdmits without the empty value's own parse ("0", "false").
+func nonZero(v string) bool { return tagAdmits(v) && v != "0" && v != "false" }
+
+// collectionDefaultTags is the tag of the shaped field of gin/12: a collection_format six
+// times in ten and a default that reaches the bug. The instances of the documented shape
+// (a slice or array with a default, the key present with an empty value) that do NOT reach
+// it are left out: the empty default (one zero element either way), a default of one value
+// that is the element's own zero ("0", "false": the empty value parses to the same) for a
+// slice or a one-element array, and an array whose default does not split into exactly its
+// length (the length check fails either way, with the same error) - so an array's default
+// has as many values as elements, joined by the separator its format splits, and its format
+// is never tsv or "bad" (hzArrayFormats). Together about a sixth of the unnarrowed draws.
+func collectionDefaultTags(t typeSpec) hegel.Generator[tagSpec] {
+	leaf := t.leafType()
+	formats := collectionFormats
+	if t.kind == reflect.Array {
+		formats = evenHalves(hzArrayFormats...)
+	}
+	return hegel.FlatMap(dieMaybe(60, formats), func(cf string) hegel.Generator[tagSpec] { // a collection_format nominal 60
+		counts, seps := rangeHalves(1, 3), evenHalves(hzDefaultSeps...)
+		if t.kind == reflect.Array {
+			counts, seps = hegel.Just(t.length), hegel.Just(hzDefaultSepOf[cf])
+		}
+		values := hegel.FlatMap(counts, func(n int) hegel.Generator[[]string] {
+			one := defaultOne(leaf, "", tagAdmits)
+			if n == 1 {
+				one = defaultOne(leaf, "", nonZero)
+			}
+			return hzCounted(one, n, n)
+		})
+		return hegel.FlatMap(values, func(vals []string) hegel.Generator[tagSpec] {
+			return hegel.Map(seps, func(sep string) tagSpec { return tagSpec{hasDefault: true, def: strings.Join(vals, sep), cf: cf} })
+		})
+	})
+}
+
+// nonEmptyFit is the fit values of the field without the empty one.
+func nonEmptyFit(sf reflect.StructField) []string {
+	var out []string
+	for _, v := range hzFieldValues(sf, false) {
+		if v != "" {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// emptyCollectionValueCases: the shaped field is a slice or an array of one to three
+// elements of a leaf type (the wide generator's), with a default and its key present with
+// the empty value; past the shape, with a fit value. A collection_format the mapping refuses
+// ("bad") is an error either way, rejected by the classifier. Rejections: 7.5 / 4.7.
+var emptyCollectionValueCases = regionOf("gin/12", bindExpected, shapedBindCases(
+	shapedStructs(dieChoice(
+		hzW(2, hegel.Map(hegel.Map(leafTypes, leafSpec), sliceOf)),                                                                                  // a slice nominal 67
+		hzW(1, hegel.FlatMap(arrayLengths, func(n int) hegel.Generator[typeSpec] { return hegel.Map(hegel.Map(leafTypes, leafSpec), arrayOf(n)) })), // an array nominal 33
+	), collectionDefaultTags),
+	func(sf reflect.StructField) hegel.Generator[[]formValue] {
+		return hegel.Map(hzShaped(hegel.Just(""), evenHalves(nonEmptyFit(sf)...)), func(v string) []formValue { return []formValue{fitValue(v)} })
+	},
+))
+
+// TestHegelEmptyValuesTakeCollectionDefaults (gin/12): an empty value for a slice or array
+// field with a default takes the default, as an empty value for a scalar with one does.
+func TestHegelEmptyValuesTakeCollectionDefaults(t *testing.T) {
+	judged(t, emptyCollectionValueCases, judgeBind)
+}
