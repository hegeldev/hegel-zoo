+package gin
+
+import (
+	"fmt"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- route patterns
+//
+// README ("Parameters in path"): "/user/:name" matches "/user/john" but not "/user/" or
+// "/user"; "/user/:name/*action" matches "/user/john/" and "/user/john/send"; the router
+// "matches static routes before params and params before catch-all" and "supports routes with
+// parameters and static segments at the same position" (since v1.7, e.g. "/user/new" beside
+// "/user/:id"). tree.go: a ':' or '*' starts a wildcard that runs to the next '/'; "\:" is a
+// literal colon; a catch-all is only allowed at the end, after a '/'; two wildcards in one
+// segment, an unnamed wildcard, a catch-all conflicting with a sibling segment, two different
+// wildcards at one position and a second handler for one path all panic at registration.
+
+type hzTokKind int
+
+const (
+	hzStatic hzTokKind = iota
+	hzParam
+	hzCatchAll
+)
+
+type hzTok struct {
+	kind hzTokKind
+	text string // static text, or the wildcard's name
+}
+
+// hzTokenize splits a pattern into static text and wildcards the way tree.go reads it;
+// ok is false for the patterns the tree rejects with a panic.
+func hzTokenize(p string) (toks []hzTok, ok bool) {
+	var static strings.Builder
+	flush := func() {
+		if static.Len() > 0 {
+			toks = append(toks, hzTok{hzStatic, static.String()})
+			static.Reset()
+		}
+	}
+	for i := 0; i < len(p); i++ {
+		c := p[i]
+		switch {
+		case c == '\\':
+			if i+1 < len(p) && p[i+1] == ':' {
+				static.WriteByte(':') // "\:" is a literal colon (the tree unescapes it on the first request)
+				i++
+				continue
+			}
+			return nil, false // invalid escape
+		case c == ':' || c == '*':
+			end := i + 1
+			for end < len(p) && p[end] != '/' {
+				if p[end] == ':' || p[end] == '*' {
+					return nil, false // two wildcards in one segment
+				}
+				end++
+			}
+			if end == i+1 {
+				return nil, false // unnamed
+			}
+			flush()
+			if c == ':' {
+				toks = append(toks, hzTok{hzParam, p[i+1 : end]})
+			} else {
+				if end != len(p) || i == 0 || p[i-1] != '/' {
+					return nil, false // catch-all not at the end, or no '/' before it
+				}
+				// the '/' before the catch-all belongs to it
+				last := &toks[len(toks)-1]
+				last.text = last.text[:len(last.text)-1]
+				if last.text == "" {
+					toks = toks[:len(toks)-1]
+				}
+				toks = append(toks, hzTok{hzCatchAll, p[i+1 : end]})
+			}
+			i = end - 1
+		default:
+			static.WriteByte(c)
+		}
+	}
+	flush()
+	return toks, true
+}
+
+// hzCand is a candidate in the model's search: a route with the position reached in its
+// tokens (tok index and offset within a static text).
+type hzCand struct {
+	r   *hzRoute
+	tok int
+	off int
+}
+
+func (c hzCand) done() bool { return c.tok == len(c.r.toks) }
+
+// --------------------------------------------------------------------------- the acceptance
+// model
+//
+// hzAccepts is the set of routes the tree accepts when the routes are registered in order on
+// a fresh engine, a route the tree rejects dropped and the rest registered as if it had not
+// been tried (hzBuild's rule; the tree's acceptance of a route depends on the routes accepted
+// before it, not on their order: the RouteOrder law). Rejected: a pattern the tokenizer
+// refuses (the panics of findWildcard and insertChild: "only one wildcard per path segment",
+// "wildcards must be named", "catch-all routes are only allowed at the end", "no / before
+// catch-all", "invalid escape string"), and a pattern that conflicts with an accepted route of
+// the same method (hzConflict).
+func hzAccepts(routes []*hzRoute) (accepted, rejected []*hzRoute) {
+	for _, r := range routes {
+		ok := r.ok
+		if ok {
+			for _, q := range accepted {
+				if q.method == r.method && hzConflict(r, q) {
+					ok = false
+					break
+				}
+			}
+		}
+		if ok {
+			accepted = append(accepted, r)
+		} else {
+			rejected = append(rejected, r)
+		}
+	}
+	return accepted, rejected
+}
+
+// hzConflict is whether the tree refuses the pattern of r beside the accepted q, from the
+// two token lists walked together (addRoute walks the tree the accepted routes make and
+// panics at the node where the new path diverges): the same path is "handlers are already
+// registered" (tree.go addRoute, the end of the walk); two different wildcards at one
+// position (two :params of different names, or a :param beside a *catch-all whose slash is
+// already consumed) is the "conflicts with existing wildcard" panic of addRoute; a
+// *catch-all whose slash meets static text of the other route (a sibling segment, or a route
+// ending exactly at that slash) is insertChild's "catch-all wildcard conflicts with existing
+// path segment" when the catch-all comes second and addRoute's wildcard conflict when it
+// comes first. Static text beside a :param at one position is allowed (v1.7), a *catch-all
+// beside a :param whose static text ends before the slash too (/a:p beside /a/*rest), and a
+// route that ends where the other goes on.
+func hzConflict(r, q *hzRoute) bool {
+	a, b := hzCand{r: r}, hzCand{r: q}
+	for {
+		ad, bd := a.done(), b.done()
+		if ad && bd {
+			return true // the same path: a second handler
+		}
+		if ad || bd {
+			return false // one route ends where the other goes on
+		}
+		ta, tb := a.next(), b.next()
+		switch {
+		case ta.kind == hzStatic && tb.kind == hzStatic:
+			ra, rb := a.rest(), b.rest()
+			n := 0
+			for n < len(ra) && n < len(rb) && ra[n] == rb[n] {
+				n++
+			}
+			if n < len(ra) && n < len(rb) {
+				return false // different static text: siblings
+			}
+			a, b = a.advance(n), b.advance(n)
+		case ta.kind == hzParam && tb.kind == hzParam:
+			if ta.text != tb.text {
+				return true // two different wildcards at one position
+			}
+			a.tok++
+			b.tok++
+		case ta.kind == hzCatchAll && tb.kind == hzCatchAll:
+			return true // the same path (both end here)
+		case ta.kind == hzCatchAll:
+			return tb.kind == hzStatic && strings.HasPrefix(b.rest(), "/") // the catch-all's slash meets a sibling segment
+		case tb.kind == hzCatchAll:
+			return ta.kind == hzStatic && strings.HasPrefix(a.rest(), "/")
+		default:
+			return false // a :param beside static text at one position
+		}
+	}
+}
+
+// hzShowIDs lists the ids of the routes ("none" for none).
+func hzShowIDs(routes []*hzRoute) string {
+	if len(routes) == 0 {
+		return "none"
+	}
+	parts := make([]string, len(routes))
+	for i, r := range routes {
+		parts[i] = fmt.Sprintf("R%d", r.id)
+	}
+	return strings.Join(parts, " ")
+}
+
+// --------------------------------------------------------------------------- the tree model
+
+// hzMatch is what the model (and the engine) says about a path: the route and its params.
+type hzMatch struct {
+	route  *hzRoute
+	params []Param
+}
+
+// hzModelMatch finds the route for path among routes (one method) under the switches k: a
+// depth-first walk over the tree the routes make, node by node, that at every node tries the
+// static child first, then the :param child (the text up to the next '/', never at the very
+// end of the path), then the *catch-all (the rest, which starts with '/'). A failing static
+// branch is abandoned for the wildcard sibling of the nearest node above (backtracking) -
+// except, with the switch of the recorded bug on, where the tree gives up: when the static
+// branch ends where a trailing-slash redirect could be recommended (the path is exhausted one
+// '/' short of a route, or has exactly "/" left: gin/1), or inside a :param branch (the path
+// is exhausted, or nothing continues from the param: gin/2).
+func hzModelMatch(routes []*hzRoute, path string, k known) (hzMatch, bool) {
+	s := hzWalk(routes, path, false, k)
+	return s.m, s.ok
+}
+
+// hzSkip is what the tree remembers when it takes the static child of a node that also has a
+// :param child: the param candidates, the path left at the node and the params so far.
+type hzSkip struct {
+	wild         []hzCand
+	rest         string
+	params       []Param
+	ci           string
+	handlersHere bool
+}
+
+// hzStep is the outcome of the model's walk: a match, or a stop that is hard (the tree does
+// not backtrack to an earlier wildcard) or soft; tsr is the tree's trailing-slash
+// recommendation (exact walk); fixed is the path RedirectFixedPath's lookup returns (fold
+// walk, where ok says that it returned one).
+type hzStep struct {
+	ok        bool
+	m         hzMatch
+	hard      bool
+	tsr       bool
+	fixed     string
+	failPath  string // soft stop: the path left where the tree gave up
+	overflow  bool   // the skipped-node stack overflowed (gin/7, gin/14): the tree panics
+	exhausted bool   // soft stop with the path exhausted at a node without a handler, gin/13 on: a pop that resumes comes before the node's "/"-child check
+	hidden    bool   // gin/13: the walk rolled back from such a node, and the redirect to path + "/" was never looked for (hzModelServe's doc is off)
+}
+
+// hzWalk runs the model over routes (one method) for path; fold compares static text
+// case-insensitively and applies the rules of findCaseInsensitivePath.
+func hzWalk(routes []*hzRoute, path string, fold bool, k known) hzStep {
+	s, _ := hzWalkStack(routes, path, fold, nil, 0, k)
+	return s
+}
+
+// hzWalkStack is hzWalk starting with the skipped-node stack another tree's walk left behind
+// (gin/7: getValue does not reset it), and returning the stack as this walk leaves it. The
+// walk's own entries are pushed and resumed inside node (the static child first, then the
+// :param child when it stops softly: the rollback loops of tree.go lines 460, 591 and 648,
+// each "strings.HasSuffix(skippedNode.path, path)"); a soft stop that reaches here pops the
+// entries left by the other tree: one whose path ends with the path left is resumed at its
+// :param child - in the tree it came from. The resumed walk's outcome replaces the stop's,
+// its recommendation included; with gin/13 on, resuming from a stop with the path exhausted
+// at a node without a handler (exhausted) marks the outcome hidden, here as in node: the
+// tree rolled back (line 591) before the "/"-child check of line 628, so the documented
+// redirect to path + "/" was never looked for. capacity is the stack's capacity (the most
+// '/' in a route, engine.maxSections; 0 for a walk whose stack is not modelled): the tree
+// panics at a push beyond it (tree.go line 435, the append past the capacity), which is the
+// overflow answer - of gin/14 when this walk's own pushes fill the stack from an empty one
+// (a chain of mixed static:param nodes inside one section), of gin/7 when only the entries
+// another tree left made the difference; hzWalker.push and overflowed keep the two apart.
+func hzWalkStack(routes []*hzRoute, path string, fold bool, stack []hzSkip, capacity int, k known) (hzStep, []hzSkip) {
+	w := hzWalker{fold: fold, stack: stack, base: len(stack), capacity: capacity, k: k}
+	s := hzStep{failPath: path}
+	if len(routes) > 0 {
+		cands := make([]hzCand, 0, len(routes))
+		for _, r := range routes {
+			cands = append(cands, hzCand{r: r})
+		}
+		s = w.node(cands, path, nil, "", true, false)
+	}
+	if w.overflowed() {
+		return hzStep{overflow: true}, w.stack
+	}
+	hidden := false
+	for !fold && !s.ok && !s.hard && len(w.stack) > 0 {
+		top := w.stack[len(w.stack)-1]
+		w.stack = w.stack[:len(w.stack)-1]
+		if !strings.HasSuffix(top.ci+top.rest, s.failPath) {
+			continue
+		}
+		// the walk resumes in the tree the entry came from (gin/7): its pushes come on top of
+		// the entries left below, and none of them would exist from an empty stack
+		w.resumed, w.base = true, len(w.stack)
+		hidden = hidden || s.exhausted || s.hidden
+		s = w.param(top.wild, top.rest, top.params, top.ci, top.handlersHere)
+		if w.overflowed() {
+			return hzStep{overflow: true}, w.stack
+		}
+	}
+	s.hidden = s.hidden || hidden
+	return s, w.stack
+}
+
+// hzWalker carries the walk's state: the fold mode, the skipped-node stack with its capacity
+// and the switches; rb is the fold walk's rune byte (findCaseInsensitivePathRec's rb[0]):
+// the byte by which the last static child was chosen, which the nodes entered from a :param
+// leave as it is (the replica of gin/4 reads it). The reads of k below are the replicas of
+// the tree's rules, each at the line of tree.go it transcribes. base is the number of
+// entries the stack held on entry (another tree's leftovers, gin/7; the remaining ones once
+// a pop resumed the walk, resumed); full and ownFull record the pushes past the capacity
+// (push), decided by overflowed.
+type hzWalker struct {
+	fold     bool
+	stack    []hzSkip
+	base     int
+	resumed  bool
+	capacity int
+	full     bool // a push found the stack full: gin's rule, the append of tree.go line 435 panics
+	ownFull  bool // a push of the initial walk found it full of this walk's own entries: it overflows from an empty stack too
+	k        known
+	rb       byte
+}
+
+// push is the tree's push of a roll-back point (tree.go lines 433-449, at every node with a
+// :param child whose static child is taken). The stack (c.skippedNodes, gin.go line 254) has
+// room for capacity entries and the append panics past it; the model records the facts and
+// walks on, the panic being decided by overflowed once the walk's own pushes are all known
+// (gin stops at the first; the answer is the same).
+func (w *hzWalker) push(s hzSkip) {
+	if w.capacity > 0 && len(w.stack) >= w.capacity {
+		w.full = true
+		if !w.resumed && len(w.stack)-w.base >= w.capacity {
+			w.ownFull = true
+		}
+	}
+	w.stack = append(w.stack, s)
+}
+
+// overflowed is the tree's panic under the switches: with gin/14 and gin/7 on, any push past
+// the capacity (gin's rule); with gin/14 alone, only a walk whose own pushes from an empty
+// stack fill it (ownFull: a chain of static nodes inside one section each with a :param
+// child, more pushes than the longest route has sections); with gin/7 alone, only a walk the
+// leftover entries of an earlier tree tip over (full but not ownFull: from an empty stack it
+// would not overflow). With both off a request is served or refused, never a panic: the
+// documented stack is as deep as the walk needs.
+func (w *hzWalker) overflowed() bool {
+	if !w.full {
+		return false
+	}
+	if w.ownFull {
+		return w.k[kMixedSegmentsOverflowStack]
+	}
+	return w.k[kSkippedNodesLeak]
+}
+
+// rest is the static text a candidate has left in its current token ("" when a wildcard comes
+// next or the route is done).
+func (c hzCand) rest() string {
+	if c.done() {
+		return ""
+	}
+	if t := c.r.toks[c.tok]; t.kind == hzStatic {
+		return t.text[c.off:]
+	}
+	return ""
+}
+
+// advance moves a candidate over n static bytes.
+func (c hzCand) advance(n int) hzCand {
+	if n == 0 {
+		return c
+	}
+	c.off += n
+	if c.off == len(c.r.toks[c.tok].text) {
+		c.tok, c.off = c.tok+1, 0
+	}
+	return c
+}
+
+// next is the candidate's next token (static text starts at c.off).
+func (c hzCand) next() hzTok { return c.r.toks[c.tok] }
+
+// hzNodePrefix is the text of the tree node the candidates (all at its start) share: their
+// common static text, up to where one of them ends, continues with a wildcard or differs from
+// another. The candidates are exactly the routes through the node, so this is its path.
+func hzNodePrefix(cands []hzCand) string {
+	np := cands[0].rest()
+	for _, c := range cands[1:] {
+		r := c.rest()
+		n := 0
+		for n < len(np) && n < len(r) && np[n] == r[n] {
+			n++
+		}
+		np = np[:n]
+	}
+	return np
+}
+
+func hzLower(b byte) byte {
+	if 'A' <= b && b <= 'Z' {
+		return b + 'a' - 'A'
+	}
+	return b
+}
+
+func hzUpper(b byte) byte {
+	if 'a' <= b && b <= 'z' {
+		return b - 'a' + 'A'
+	}
+	return b
+}
+
+func (w *hzWalker) matched(r *hzRoute, ps []Param, ci string) hzStep {
+	return hzStep{ok: true, m: hzMatch{r, ps}, fixed: ci}
+}
+
+// node walks one tree node: cands are at its start, path is what is left of the request, ci
+// the exact text consumed (fold walk), root says this is the tree's root, prevHandlers that a
+// route ends exactly where this node starts.
+func (w *hzWalker) node(cands []hzCand, path string, params []Param, ci string, root, prevHandlers bool) hzStep {
+	np := hzNodePrefix(cands)
+	same := func(a, b string) bool {
+		if w.fold {
+			return strings.EqualFold(a, b)
+		}
+		return a == b
+	}
+	adv := make([]hzCand, 0, len(cands))
+	handlersHere := false // a route ends exactly at the end of this node
+	for _, c := range cands {
+		a := c.advance(len(np))
+		adv = append(adv, a)
+		if a.done() {
+			handlersHere = true
+		}
+	}
+	// a child at '/' that is a route (a "/" node with handlers) or a catch-all: a redirect to
+	// path + "/" is sound
+	slashChild := func() bool {
+		for _, a := range adv {
+			if a.done() {
+				continue
+			}
+			t := a.next()
+			if t.kind == hzCatchAll || (t.kind == hzStatic && t.text[a.off:] == "/" && a.tok == len(a.r.toks)-1) {
+				return true
+			}
+		}
+		return false
+	}
+
+	switch {
+	case len(path) > len(np) && same(path[:len(np)], np):
+		rest := path[len(np):]
+		ci += np
+		groups := map[byte][]hzCand{} // static children by first byte; a catch-all is the child at '/'
+		var wild []hzCand
+		for _, a := range adv {
+			if a.done() {
+				continue
+			}
+			switch t := a.next(); t.kind {
+			case hzStatic:
+				groups[t.text[a.off]] = append(groups[t.text[a.off]], a)
+			case hzCatchAll:
+				groups['/'] = append(groups['/'], a)
+			case hzParam:
+				wild = append(wild, a)
+			}
+		}
+		keys := []byte{rest[0]}
+		if w.fold {
+			lo, up := hzLower(rest[0]), hzUpper(rest[0])
+			keys = []byte{lo}
+			if up != lo {
+				keys = append(keys, up)
+			}
+		}
+		hidden := false // gin/13: the static branch stopped with the path exhausted at a node without a handler, or a rollback below it resumed from such a stop
+		for _, key := range keys {
+			g := groups[key]
+			if len(g) == 0 {
+				continue
+			}
+			if t := g[0].next(); t.kind == hzCatchAll {
+				ps := append(append([]Param(nil), params...), Param{Key: t.text, Value: rest})
+				return w.matched(g[0].r, ps, ci+rest)
+			}
+			pushed := false
+			if !w.fold && len(wild) > 0 {
+				w.push(hzSkip{wild, rest, params, ci, handlersHere})
+				pushed = true
+			}
+			if w.fold {
+				w.rb = key // the child chosen by its index byte (tree.go lines 785 and 857)
+			}
+			s := w.node(g, rest, params, ci, false, handlersHere)
+			if s.ok || s.hard {
+				return s
+			}
+			if pushed {
+				w.stack = w.stack[:len(w.stack)-1]
+			}
+			if !w.fold && len(wild) == 0 {
+				return s // the tree rolls back to a node above (soft; exhausted and hidden go with it)
+			}
+			hidden = s.exhausted || s.hidden
+		}
+		if len(wild) > 0 {
+			if w.fold && len(groups) > 0 {
+				w.rb = hzUpper(rest[0]) // a node with static children processed the rune before falling back to its :param (lines 825-883)
+			}
+			// the rollback to this node's :param child (tree.go line 594 popping the entry
+			// pushed at line 435; the same for lines 463 and 651): with gin/13 on, resuming
+			// from an exhausted stop hides the recommendation that stop would have made, and
+			// a second rollback (the :param walk failing softly, as /a:p/b beside /a/a/ and
+			// /a/aa with /:p above for GET /a/a) keeps it hidden
+			s := w.param(wild, rest, params, ci, handlersHere)
+			s.hidden = s.hidden || hidden
+			return s
+		}
+		// no child continues here
+		if rest == "/" {
+			if w.fold {
+				if handlersHere {
+					return hzStep{ok: true, hard: true, fixed: ci}
+				}
+				return hzStep{}
+			}
+			// getValue line 478: "value.tsr = path == "/" && n.handlers != nil" and return,
+			// without the rollback of line 459 (gin/1 makes the stop hard)
+			return hzStep{hard: w.k[kStaticShadowsParam], tsr: handlersHere}
+		}
+		return hzStep{failPath: rest}
+
+	case same(path, np):
+		ci += np
+		for _, a := range adv {
+			if a.done() {
+				return w.matched(a.r, params, ci)
+			}
+		}
+		if w.fold {
+			if slashChild() {
+				return hzStep{ok: true, hard: true, fixed: ci + "/"}
+			}
+			return hzStep{}
+		}
+		if np == "/" && !root {
+			// a "/" node of its own, reached with exactly "/" left: getValue lines 616-624
+			// ("path == "/" && n.wildChild && n.nType != root", "path == "/" && n.nType ==
+			// static") recommend the redirect whether or not a route ends before the node
+			// (gin/3) and return without the rollback of line 590 (gin/1)
+			return hzStep{hard: w.k[kStaticShadowsParam], tsr: prevHandlers || w.k[kTrailingSlashToNothing]}
+		}
+		// the path is exhausted at a node without a handler: getValue lines 587-637. The tree
+		// first rolls back (lines 590-603, the path left not being "/") to the last skipped
+		// node whose path ends with it - the pop of hzWalkStack - and only when none matches
+		// checks the node's "/" child (lines 628-635: a "/" route or a catch-all, slashChild).
+		// Documented, the redirect to path + "/" is recommended whenever a route exists there
+		// (hzModelServe's doc, made whether or not the walk rolls back); with gin/13 on the
+		// stop is exhausted, and a rollback that resumes from it (the :param child of the
+		// nearest node above with one, in node; an entry of the shared stack, in
+		// hzWalkStack) hides the recommendation - the param walk decides on its own rules -
+		// so slashChild counts only when nothing on the stack matches
+		return hzStep{tsr: slashChild(), failPath: path, exhausted: w.k[kParamSiblingHidesSlashRedirect]}
+
+	default:
+		// the path ends inside this node, or differs from it
+		short := len(np) == len(path)+1 && np[len(path)] == '/' && same(path, np[:len(path)]) && handlersHere
+		if w.fold {
+			// findCaseInsensitivePathRec line 941: "if path == "/" { return ciPath }" without
+			// checking for a handler (gin/6)
+			if path == "/" && (prevHandlers || w.k[kFixedPathToNothing]) {
+				return hzStep{ok: true, hard: true, fixed: ci}
+			}
+			if short {
+				return hzStep{ok: true, hard: true, fixed: ci + np}
+			}
+			return hzStep{}
+		}
+		// getValue line 642: "value.tsr = path == "/" || (... n.handlers != nil)", the "/"
+		// half without a handler check (gin/3), and line 647: the rollback is skipped when tsr
+		// is set or the path is "/" (gin/1)
+		tsr := (path == "/" && (prevHandlers || w.k[kTrailingSlashToNothing])) || short
+		return hzStep{hard: (path == "/" || short) && w.k[kStaticShadowsParam], tsr: tsr, failPath: path}
+	}
+}
+
+// param walks the :param child of a node: wild are the param candidates, rest the path left
+// at the node, handlersHere says that a route ends at the node.
+func (w *hzWalker) param(wild []hzCand, rest string, params []Param, ci string, handlersHere bool) hzStep {
+	end := strings.IndexByte(rest, '/')
+	if end < 0 {
+		end = len(rest)
+	}
+	val := rest[:end]
+	ps := append(append([]Param(nil), params...), Param{Key: wild[0].next().text, Value: val})
+	var children []hzCand
+	var ends *hzRoute // the route that ends with this param
+	for _, a := range wild {
+		a.tok++
+		if a.done() {
+			ends = a.r
+		} else {
+			children = append(children, a)
+		}
+	}
+	if end < len(rest) {
+		if len(children) > 0 {
+			// findCaseInsensitivePathRec at the empty node that holds the catch-all after a
+			// param (path "", index "/"): a static node clears the rune bytes rb by its
+			// length (line 742), 0 here, so rb[0] is still the byte by which the last static
+			// child was chosen (the nodes entered from a param, lines 902-905, and the
+			// wildChild nodes without static children leave it), and line 744 looks for that
+			// byte among the indices: the "/" child is taken only when that child's text
+			// started with "/" (a node split at the slash by a sibling route, as /ab/:q/*rest
+			// beside /abc), never below the root alone (rb is fresh and lines 763-769 read
+			// nothing for a length of 0) or a child like a/ (gin/4)
+			if w.fold && children[0].next().kind == hzCatchAll && w.k[kFixedPathMissesCatchAll] && w.rb != '/' {
+				return hzStep{}
+			}
+			return w.node(children, rest[end:], ps, ci+val, false, ends != nil)
+		}
+		// nothing continues from the param: a redirect to the path without its trailing
+		// slash is recommended, sound when the value is not empty (the param route) or a
+		// route ends before the param. getValue line 533 ("value.tsr = len(path) == end+1")
+		// recommends it for an empty value too (gin/3), findCaseInsensitivePathRec line 909
+		// likewise (gin/6); both return without the rollback (gin/2)
+		tsr := len(rest) == end+1 && (val != "" || handlersHere || w.k[kTrailingSlashToNothing])
+		if w.fold {
+			tsr = len(rest) == end+1 && (val != "" || handlersHere || w.k[kFixedPathToNothing])
+			if tsr {
+				return hzStep{ok: true, hard: true, fixed: ci + val}
+			}
+			return hzStep{}
+		}
+		return hzStep{hard: w.k[kParamDeadEnd], tsr: tsr}
+	}
+	if ends != nil {
+		return w.matched(ends, ps, ci+val)
+	}
+	// the path is exhausted at the param: a "/" route or a catch-all below it makes a
+	// redirect to path + "/" sound (getValue line 545; findCaseInsensitivePathRec line 923
+	// accepts only the "/" child, not the empty node of a catch-all: gin/4); the tree returns
+	// without the rollback (gin/2)
+	tsr := false
+	for _, ch := range children {
+		t := ch.next()
+		if t.kind == hzCatchAll && !(w.fold && w.k[kFixedPathMissesCatchAll]) {
+			tsr = true
+		}
+		if t.kind == hzStatic && t.text == "/" && ch.tok == len(ch.r.toks)-1 {
+			tsr = true
+		}
+	}
+	if w.fold {
+		if tsr {
+			return hzStep{ok: true, hard: true, fixed: ci + val + "/"}
+		}
+		return hzStep{}
+	}
+	return hzStep{hard: w.k[kParamDeadEnd], tsr: tsr}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// hzHandler writes the route's id and the params it received.
+func hzHandler(id int) HandlerFunc {
+	return func(c *Context) {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "R%d", id)
+		for _, p := range c.Params {
+			fmt.Fprintf(&sb, "|%s=%s", p.Key, p.Value)
+		}
+		c.String(200, "%s", sb.String())
+	}
+}
+
+// hzBuild registers the routes in order on a fresh engine; a route the tree rejects (a panic)
+// is dropped and the engine rebuilt from the ones before, so that a half-inserted route never
+// stays in the tree. Returns the engine, the accepted routes (in order) and the rejected ones.
+// This is the library call: it runs in the property under the judge, never in a generator.
+func hzBuild(routes []*hzRoute, configure func(*Engine)) (*Engine, []*hzRoute, []*hzRoute) {
+	accepted := append([]*hzRoute(nil), routes...)
+	var rejected []*hzRoute
+	for {
+		e := New()
+		if configure != nil {
+			configure(e)
+		}
+		bad := -1
+		for i, r := range accepted {
+			if p := hzCatch(func() { e.Handle(r.method, r.pattern, hzHandler(r.id)) }); p != nil {
+				bad = i
+				break
+			}
+		}
+		if bad < 0 {
+			return e, accepted, rejected
+		}
+		rejected = append(rejected, accepted[bad])
+		accepted = append(accepted[:bad:bad], accepted[bad+1:]...)
+	}
+}
+
+// hzServe sends a request with the raw path and returns the response.
+func hzServe(e *Engine, method, rawPath string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, rawPath, nil)
+	w := httptest.NewRecorder()
+	e.ServeHTTP(w, req)
+	return w
+}
+
+// hzExpect is the model's answer for a request, in the handler's format.
+func hzExpect(m hzMatch) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "R%d", m.route.id)
+	for _, p := range m.params {
+		fmt.Fprintf(&sb, "|%s=%s", p.Key, p.Value)
+	}
+	return sb.String()
+}
+
+func hzShowRoutes(routes []*hzRoute) string {
+	var parts []string
+	for _, r := range routes {
+		parts = append(parts, fmt.Sprintf("R%d %s %s", r.id, r.method, r.pattern))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzByMethod returns the routes of one method.
+func hzByMethod(routes []*hzRoute, method string) []*hzRoute {
+	var out []*hzRoute
+	for _, r := range routes {
+		if r.method == method {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// hzPlain turns every redirect and 405 handling off, so that a request is matched or 404.
+func hzPlain(e *Engine) {
+	e.RedirectTrailingSlash = false
+	e.RedirectFixedPath = false
+	e.HandleMethodNotAllowed = false
+}
+
+// hzCheckName is the check of the i-th request of a case.
+func hzCheckName(i int) string { return fmt.Sprintf("r%d", i+1) }
+
+// hzCapacity is the skipped-node stack's capacity for the routes: the most '/' in a route
+// (engine.maxSections, gin.go line 383, counted by countSections over every route added; the
+// stack is allocated with it at line 254).
+func hzCapacity(routes []*hzRoute) int {
+	capacity := 0
+	for _, r := range routes {
+		if n := strings.Count(r.pattern, "/"); n > capacity {
+			capacity = n
+		}
+	}
+	return capacity
+}
+
+// hzPanicAnswer is the answer of a request the engine panics on, as the checks compare it
+// (hzResponse.String: "panic: slice bounds out of range" for the stack's overflow, the text
+// of any other panic).
+func hzPanicAnswer(p any) string {
+	return hzResponse{code: 0, body: fmt.Sprint(p)}.String()
+}
+
+// --------------------------------------------------------------------------- Match
+
+// matchExpected states what the engine with redirects off must give for the case: the
+// routes the tree rejects (rejected: the acceptance model) and, per request, the response as
+// a string ("200 R2|p=a" for the route the model matches with its params, "404" when it
+// matches none; "unparsable" for a raw path url.ParseRequestURI refuses, which the generator
+// never draws). Documented (every switch off): the README's matching with backtracking.
+// With gin/1 or gin/2 on: the tree's stops instead (a 404 where the model matches); with
+// gin/14 on: the panic of a walk whose pushes outnumber the stack's capacity (the most '/'
+// in a route of any method, hzCapacity).
+func matchExpected(c matchCase, k known) checks {
+	w := checks{}
+	accepted, rejected := hzAccepts(c.routes)
+	w["rejected"] = hzShowIDs(rejected)
+	capacity := hzCapacity(accepted)
+	for i, r := range c.requests {
+		w[hzCheckName(i)] = matchAnswer(accepted, capacity, r, k)
+	}
+	return w
+}
+
+// matchAnswer is the model's response to one request over the accepted routes: the exact
+// walk of its method's tree from an empty stack of the given capacity.
+func matchAnswer(accepted []*hzRoute, capacity int, r hzRequest, k known) string {
+	u, err := url.ParseRequestURI(r.raw)
+	if err != nil {
+		return "unparsable"
+	}
+	s, _ := hzWalkStack(hzByMethod(accepted, r.method), u.Path, false, nil, capacity, k)
+	switch {
+	case s.overflow:
+		return hzResponse{code: 0}.String()
+	case !s.ok:
+		return "404"
+	}
+	return "200 " + hzExpect(s.m)
+}
+
+// matchActual asks the library the model's questions: the engine built with redirects off,
+// the rejected routes, and each request served (a panic caught and reported as the answer).
+func matchActual(c matchCase) checks {
+	got := checks{}
+	e, _, rejected := hzBuild(c.routes, hzPlain)
+	got["rejected"] = hzShowIDs(rejected)
+	for i, r := range c.requests {
+		if _, err := url.ParseRequestURI(r.raw); err != nil {
+			hzTally("noted unparsable raw path")
+			got[hzCheckName(i)] = "unparsable"
+			continue
+		}
+		var w *httptest.ResponseRecorder
+		if p := hzCatch(func() { w = hzServe(e, r.method, r.raw) }); p != nil {
+			got[hzCheckName(i)] = hzPanicAnswer(p)
+			hzTally("served panic")
+		} else if w.Code == 200 {
+			got[hzCheckName(i)] = "200 " + w.Body.String()
+			hzTally("served matched")
+		} else {
+			got[hzCheckName(i)] = fmt.Sprint(w.Code)
+			hzTally(fmt.Sprintf("served %d", w.Code))
+		}
+	}
+	return got
+}
+
+// matchCases are the cases of the Match property: a route set and three requests to it
+// (under HEGEL_NO_KNOWN=1 each request filtered by the classifier on its own case).
+var matchCases = hegel.FlatMap(routeSets, func(routes []*hzRoute) hegel.Generator[matchCase] {
+	return hegel.Map(requestsFor(routes, 20, func(r hzRequest) matchCase { // a method of the list 20: realises 20.2
+		return matchCase{routes: routes, requests: []hzRequest{r}}
+	}, matchExpected), func(reqs []hzRequest) matchCase {
+		return matchCase{routes: routes, requests: reqs}
+	})
+})
+
+// judgeMatch is the judge of the Match family (the wide property and the narrow ones of
+// gin/1, gin/2 and gin/14): judgeBy over matchExpected and matchActual.
+func judgeMatch(j *hzCaseJudge, c matchCase) {
+	judgeBy(j, c, matchExpected, matchActual)
+}
+
+// TestHegelMatch: with redirects off, the tree accepts the routes the acceptance model says,
+// and a request is served by the route the model picks, with the model's params, or is a 404
+// when the model finds none, and never panics. The shapes of gin/1 (a static route one slash
+// from the request shadowing a :param route), gin/2 (a dead-ending :param branch) and gin/14
+// (nested mixed static:param routes overflowing the skipped-node stack) are drawn at their
+// natural rates and fail by default naming the bug; under HEGEL_NO_KNOWN=1 the requests with
+// them are filtered out.
+func TestHegelMatch(t *testing.T) {
+	judged(t, matchCases, judgeMatch)
+}
+
+// --------------------------------------------------------------------------- RouteOrder
+
+// orderExpected states the law: the accepted routes registered in another order are all
+// accepted (acceptance: "same set") and every request is answered the same by both engines
+// (r1...: "same"). A comparison of the library with itself: no switch, no shape.
+func orderExpected(c orderCase, _ known) checks {
+	w := checks{"acceptance": "same set"}
+	for i := range c.requests {
+		w[hzCheckName(i)] = "same"
+	}
+	return w
+}
+
+// permuted is the accepted routes in the case's order (the permutation of the drawn routes'
+// indices, restricted to the accepted ones).
+func (c orderCase) permuted(accepted []*hzRoute) []*hzRoute {
+	in := map[*hzRoute]bool{}
+	for _, r := range accepted {
+		in[r] = true
+	}
+	var out []*hzRoute
+	for _, i := range c.order() {
+		if in[c.routes[i]] {
+			out = append(out, c.routes[i])
+		}
+	}
+	return out
+}
+
+// orderActual builds the engine twice, in the drawn order and the permuted one, and compares
+// the acceptance and the answers (a panic, gin/14's, is an answer: the same tree panics the
+// same way in both orders).
+func orderActual(c orderCase) checks {
+	got := checks{}
+	e1, accepted, _ := hzBuild(c.routes, hzPlain)
+	perm := c.permuted(accepted)
+	e2, _, rejected2 := hzBuild(perm, hzPlain)
+	if len(rejected2) == 0 {
+		got["acceptance"] = "same set"
+	} else {
+		got["acceptance"] = fmt.Sprintf("the order %s rejects %s", hzShowRoutes(perm), hzShowIDs(rejected2))
+	}
+	if len(accepted) < 2 {
+		hzTally("noted fewer than 2 routes")
+	}
+	for i, r := range c.requests {
+		if _, err := url.ParseRequestURI(r.raw); err != nil {
+			hzTally("noted unparsable raw path")
+			got[hzCheckName(i)] = "same"
+			continue
+		}
+		a1, a2 := orderAnswer(e1, r), orderAnswer(e2, r)
+		if a1 == a2 {
+			got[hzCheckName(i)] = "same"
+		} else {
+			got[hzCheckName(i)] = fmt.Sprintf("%s in the drawn order, %s in the order %s", a1, a2, hzShowRoutes(perm))
+		}
+	}
+	return got
+}
+
+// orderAnswer is one engine's answer to a request, as orderActual compares it: the status
+// with the body, or the panic.
+func orderAnswer(e *Engine, r hzRequest) string {
+	var w *httptest.ResponseRecorder
+	if p := hzCatch(func() { w = hzServe(e, r.method, r.raw) }); p != nil {
+		hzTally("served panic")
+		return hzPanicAnswer(p)
+	}
+	return fmt.Sprintf("%d %q", w.Code, w.Body.String())
+}
+
+// swapsFor is the swap indices of a Fisher-Yates permutation of n indices: for i from n-1
+// down to 1, an index of 0..i to swap with i, drawn evenly (every permutation at one weight;
+// the shrink target, every swap with index 0, is a rotation).
+func swapsFor(n int) hegel.Generator[[]int] {
+	var gens []hegel.Generator[int]
+	for i := n - 1; i > 0; i-- {
+		gens = append(gens, rangeHalves(0, i))
+	}
+	return hzTuple(gens...)
+}
+
+// orderCases are the cases of the RouteOrder property: a route set, the swaps of a
+// permutation of its indices (drawn from the count alone, before any library call) and three
+// requests.
+var orderCases = hegel.FlatMap(routeSets, func(routes []*hzRoute) hegel.Generator[orderCase] {
+	return hegel.FlatMap(swapsFor(len(routes)), func(swaps []int) hegel.Generator[orderCase] {
+		return hegel.Map(requestsFor[orderCase](routes, 20, nil, nil), func(reqs []hzRequest) orderCase {
+			return orderCase{routes: routes, swaps: swaps, requests: reqs}
+		})
+	})
+})
+
+// judgeOrder is the judge of the RouteOrder family: judgeBy over orderExpected and
+// orderActual.
+func judgeOrder(j *hzCaseJudge, c orderCase) {
+	judgeBy(j, c, orderExpected, orderActual)
+}
+
+// TestHegelRouteOrder: the routes a tree accepts, and what it serves, do not depend on the
+// order of registration.
+func TestHegelRouteOrder(t *testing.T) {
+	judged(t, orderCases, judgeOrder)
+}
diff --git a/hegel_zoo_routes_test.go b/hegel_zoo_routes_test.go
new file mode 100644
index 0000000..f850bcc
--- /dev/null
+++ b/hegel_zoo_routes_test.go
@@ -0,0 +1,477 @@
+package gin
+
+// The records and generators of the router properties (hegel_zoo_router_test.go has the tree
+// model, the acceptance model and the Match and RouteOrder properties, hegel_zoo_engine_test.go
+// the engine model and property, hegel_zoo_path_test.go the clean-path one,
+// hegel_zoo_router_shapes_test.go the narrow properties). A case is a route set drawn from
+// package-level generators and three requests drawn from it (a FlatMap: a request is often
+// built from a drawn route's own tokens), with the engine's options or a permutation beside
+// them. The population is the one the old hzGen* functions drew (the same atoms byte for
+// byte, the same shares); every weight below is nominal and the figure beside it is the
+// realised rate the probe measured over 3000 cases (HEGEL_SEED=7) in context, in percent of
+// the draws of that choice (the engine's dice are not even: hegel_zoo_idioms_test.go). The
+// simplest alternative comes first in every choice, so the shrink target is one GET route /a,
+// the request GET /a, every option off, the clean path /.
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the atoms
+
+// hzSegAtoms are the static segments of a pattern; hzParamNames the wildcard names;
+// hzRejectedShapes the segment shapes the tree refuses at registration (two wildcards in one
+// segment, an unnamed one, a catch-all not at the end or without a slash before it, a bad
+// escape).
+var (
+	hzSegAtoms       = []string{"a", "b", "ab", "abc", "c", "x", "new", "user_", "id", "A", "B", "0", "-"}
+	hzParamNames     = []string{"p", "q", "name"}
+	hzRejectedShapes = []string{":p:q", ":", "*", "a*rest", ":p*q", "*rest/x", "a\\b"}
+)
+
+// hzPathAtoms are the segments of a free request path (an empty one gives repeated slashes;
+// escapes, dots, a plus, a colon); the first sixteen fill a :param of a built path.
+// hzParamSurprises are the empty and slash-free odd values of a :param, hzCatchAllFills the
+// values of a *catch-all (after its slash), hzSuffixes what is appended to a built path.
+var (
+	hzPathAtoms      = []string{"a", "b", "ab", "abc", "abd", "c", "x", "new", "user_x", "user_", "id", "id1", "A", "B", "0", "-", "", ".", "..", "%41", "a%2Fb", "a+b", "%C3%A9", "test\\:a", "test:a", "y"}
+	hzParamSurprises = []string{"", "%2F", ".", ".."}
+	hzCatchAllFills  = []string{"", "a", "a/b", "a/b/", "..", "a//b"}
+	hzSuffixes       = []string{"/x", "x", "/", "//"}
+)
+
+// hzMethods are the methods of a route or request that is not GET by the plain coin, at the
+// weights hzMethodWeights (the old list had GET three times beside POST, PUT and DELETE);
+// hzAllMethods the methods of the many-trees route sets, in registration order.
+var (
+	hzMethods       = []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete}
+	hzMethodWeights = []int{3, 1, 1, 1}
+	hzAllMethods    = []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodHead, http.MethodOptions}
+)
+
+// hzCleanAtoms are the segments of a clean-path case.
+var hzCleanAtoms = []string{"a", "b", "abc", ".", "..", "...", ".a", "a.", "", "x y", "%2e", "A"}
+
+// --------------------------------------------------------------------------- the records
+
+// hzRoute is a registered route: its method, pattern and the id its handler writes; toks is
+// the model's reading of the pattern (hzTokenize) and ok whether the tokenizer accepts it
+// (both set when the route set is drawn, never changed after).
+type hzRoute struct {
+	method  string
+	pattern string
+	id      int
+	toks    []hzTok
+	ok      bool
+}
+
+// hzRequest is one request: the method and the raw path as sent; from is the id of the route
+// the path was built from (0 for a free path) and decor what was done to it afterwards ("",
+// "toggled", "suffixed", "upper-cased") - how the request was drawn, for the reader of a
+// failure and for the rate probe.
+type hzRequest struct {
+	method string
+	raw    string
+	from   int
+	decor  string
+}
+
+func (r hzRequest) String() string { return r.method + " " + r.raw }
+
+// hzPath is a drawn request path with its construction (hzRequest's from and decor).
+type hzPath struct {
+	raw   string
+	from  int
+	decor string
+}
+
+// hzShowRequests prints the requests as the messages do, a built one with its construction:
+// "GET /a, GET /A/B (from R2, upper-cased)".
+func hzShowRequests(reqs []hzRequest) string {
+	parts := make([]string, len(reqs))
+	for i, r := range reqs {
+		parts[i] = r.String()
+		if r.from > 0 {
+			how := fmt.Sprintf("from R%d", r.from)
+			if r.decor != "" {
+				how += ", " + r.decor
+			}
+			parts[i] += " (" + how + ")"
+		}
+	}
+	return strings.Join(parts, ", ")
+}
+
+// matchCase is a case of the Match property: the drawn routes and the requests.
+type matchCase struct {
+	routes   []*hzRoute
+	requests []hzRequest
+}
+
+func (c matchCase) GoString() string {
+	return fmt.Sprintf("matchCase{routes: %s; requests: %s}", hzShowRoutes(c.routes), hzShowRequests(c.requests))
+}
+
+// orderCase is a case of the RouteOrder property: the drawn routes, the swaps of a
+// Fisher-Yates permutation of their indices (swaps[s] is the index swapped with n-1-s), and
+// the requests.
+type orderCase struct {
+	routes   []*hzRoute
+	swaps    []int
+	requests []hzRequest
+}
+
+func (c orderCase) GoString() string {
+	return fmt.Sprintf("orderCase{routes: %s; order: %v; requests: %s}", hzShowRoutes(c.routes), c.order(), hzShowRequests(c.requests))
+}
+
+// order is the permutation of the drawn routes' indices the swaps make.
+func (c orderCase) order() []int {
+	idx := make([]int, len(c.routes))
+	for i := range idx {
+		idx[i] = i
+	}
+	for s, i := 0, len(idx)-1; i > 0 && s < len(c.swaps); i, s = i-1, s+1 {
+		j := c.swaps[s]
+		idx[i], idx[j] = idx[j], idx[i]
+	}
+	return idx
+}
+
+// engineCase is a case of the Engine property: the options, the drawn routes and the
+// requests.
+type engineCase struct {
+	opts     hzEngineOpts
+	routes   []*hzRoute
+	requests []hzRequest
+}
+
+func (c engineCase) GoString() string {
+	return fmt.Sprintf("engineCase{opts: %s; routes: %s; requests: %s}", c.opts, hzShowRoutes(c.routes), hzShowRequests(c.requests))
+}
+
+// cleanCase is a case of the CleanPath property: a path of atoms, rooted or not, with a
+// slash before the first atom or not, a trailing slash or not.
+type cleanCase struct {
+	rooted   bool
+	lead     bool
+	atoms    []string
+	trailing bool
+}
+
+func (c cleanCase) text() string {
+	var sb strings.Builder
+	if c.rooted {
+		sb.WriteByte('/')
+	}
+	for i, a := range c.atoms {
+		if i > 0 || c.lead {
+			sb.WriteByte('/')
+		}
+		sb.WriteString(a)
+	}
+	if c.trailing {
+		sb.WriteByte('/')
+	}
+	return sb.String()
+}
+
+func (c cleanCase) GoString() string { return fmt.Sprintf("cleanCase(%q)", c.text()) }
+
+// --------------------------------------------------------------------------- the patterns
+
+// evenHalves is a table at one weight each drawn by halving: a fair-bit choice between the
+// two halves at their sizes (dieChoice), and each half again, down to one value; the first
+// value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their last face
+// at 12 to 27 instead of 33 in this harness (measured in context: the third of the three
+// param names 25, the last two of the six method counts 27 together, the last two of the six
+// catch-all fills 12), so the even tables here are halved instead. rangeHalves is the
+// integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+var (
+	segAtoms   = evenHalves(hzSegAtoms...)   // the thirteen atoms, nominal 7.7 each: realise 7.0 to 8.7
+	paramNames = evenHalves(hzParamNames...) // the three names, nominal 33 each: realise 33/34/32
+)
+
+// segmentsAt is one segment of a pattern (the twelve-way choice of the old generator): a
+// static atom 5 of 12, a :param 3, a mixed atom:param 1, a *rest 1 (only in the last
+// position; an atom elsewhere), a rejected shape 1 (three times in ten; an atom otherwise), an
+// escaped colon test\:atom 1. Measured over the segments of 3000 route sets (inner
+// positions / the last one).
+func segmentsAt(last bool) hegel.Generator[string] {
+	catchAll := segAtoms
+	if last {
+		catchAll = hegel.Just("*rest")
+	}
+	return dieChoice(
+		hzW(5, segAtoms), // static nominal 41.7 (55.8 inner with the catch-all slot and the atoms of the rejected slot, 47.5 last): realises 54.5 / 45.8
+		hzW(3, hegel.Map(paramNames, func(n string) string { return ":" + n })), // :param nominal 25: realises 26.9 / 26.6
+		hzW(1, hegel.FlatMap(segAtoms, func(a string) hegel.Generator[string] {
+			return hegel.Map(paramNames, func(n string) string { return a + ":" + n })
+		})), // mixed nominal 8.3: realises 7.6 / 8.0
+		hzW(1, catchAll), // *rest at the end nominal 8.3: realises 8.3
+		hzW(1, dieChoice(hzW(7, segAtoms), hzW(3, evenHalves(hzRejectedShapes...)))), // rejected shapes nominal 2.5 (8.3 of which 30): realise 1.9 / 2.8 (the seven shapes 11 to 21 each of them)
+		hzW(1, hegel.Map(segAtoms, func(a string) string { return "test\\:" + a })),  // escaped colon nominal 8.3: realises 8.7 / 8.6
+	)
+}
+
+var (
+	segCounts = rangeHalves(1, 4) // 1 to 4 segments, nominal 25 each: realise 25/25/26/24
+
+	// patternBodies are the segments of a pattern: the count first, the last segment the one
+	// that may be a catch-all.
+	patternBodies = hegel.FlatMap(segCounts, func(n int) hegel.Generator[[]string] {
+		return hzSeq(hzCounted(segmentsAt(false), n-1, n-1), hzOne(segmentsAt(true)))
+	})
+
+	// patterns is a route pattern: the segments joined by slashes, a trailing slash one time
+	// in five when no catch-all, or the root alone one time in twenty.
+	patterns = dieChoice(
+		hzW(95, hegel.FlatMap(patternBodies, func(segs []string) hegel.Generator[string] {
+			return hegel.Map(dieCoin(20), func(trailing bool) string { // trailing slash nominal 20: realises 21.1 (of the patterns without a catch-all)
+				p := "/" + strings.Join(segs, "/")
+				if trailing && !strings.Contains(p, "*") {
+					p += "/"
+				}
+				return p
+			})
+		})),
+		hzW(5, hegel.Just("/")), // the root nominal 5: realises 4.4 (the engine deduplicates the shortest cases)
+	)
+)
+
+// --------------------------------------------------------------------------- the route sets
+
+// methodsAt is GET, or pct percent of the time a method of hzMethods at hzMethodWeights.
+func methodsAt(pct int) hegel.Generator[string] {
+	return dieChoice(hzW(100-pct, hegel.Just(http.MethodGet)), hzW(pct, dieOver(hzMethodWeights, hzMethods...)))
+}
+
+var (
+	// routeOf is one route: the method (GET, or one of hzMethods a quarter of the time) and
+	// its pattern.
+	routeOf = hegel.FlatMap(methodsAt(25), func(m string) hegel.Generator[hzRoute] { // a method of the list 25 (GET in all 87.5, POST/PUT/DELETE 4.2 each): realises GET 88.6, POST 4.1, PUT 4.0, DELETE 3.4
+		return hegel.Map(patterns, func(p string) hzRoute { return hzRoute{method: m, pattern: p} })
+	})
+
+	// manyTrees is the many-trees shape: the same one to three patterns on the first two to
+	// seven methods of hzAllMethods.
+	manyTrees = hegel.FlatMap(countedHalves(patterns, 1, 3), func(pats []string) hegel.Generator[[]hzRoute] { // 1 to 3 patterns, nominal 33 each: realise 35/34/31
+		return hegel.Map(rangeHalves(2, 7), func(k int) []hzRoute { // 2 to 7 methods, nominal 17 each: realise 15 to 18 (over the 460 many-trees sets of 3000)
+			var rs []hzRoute
+			for _, m := range hzAllMethods[:k] {
+				for _, p := range pats {
+					rs = append(rs, hzRoute{method: m, pattern: p})
+				}
+			}
+			return rs
+		})
+	})
+
+	// routeSets is a route set: one to six routes, or the many-trees shape fifteen times in a
+	// hundred; the routes numbered in order and read by the tokenizer.
+	routeSets = hegel.Map(dieChoice(
+		hzW(85, countedHalves(routeOf, 1, 6)), // 1 to 6 routes, nominal 16.7 each: realise 17/15/14/20/15/19 in the Engine cases; 11/17/18/19/17/18 in the Match cases, where the route set is the first draw and the engine deduplicates the one-route cases
+		hzW(15, manyTrees),                    // the many-trees shape nominal 15: realises 15.4 (Match), 16.8 (Engine)
+	), func(rs []hzRoute) []*hzRoute {
+		out := make([]*hzRoute, len(rs))
+		for i := range rs {
+			r := rs[i]
+			r.id = i + 1
+			r.toks, r.ok = hzTokenize(r.pattern)
+			out[i] = &r
+		}
+		return out
+	})
+)
+
+// --------------------------------------------------------------------------- the requests
+
+var (
+	pathAtoms     = evenHalves(hzPathAtoms...)      // the 26 atoms of a free path, nominal 3.8 each: realise 3.1 to 4.7
+	paramAtoms    = evenHalves(hzPathAtoms[:16]...) // the 16 atoms of a :param value, nominal 6.3 each (the values of a built path, atoms and static segments together, realise 2.6 to 6.5 each)
+	surpriseAtoms = evenHalves(hzParamSurprises...)
+	catchAllFills = evenHalves(hzCatchAllFills...) // the six catch-all values, nominal 17 each: realise 10 to 22 (over the 200 catch-all fillings of 3000 cases)
+	suffixes      = evenHalves(hzSuffixes...)      // the four suffixes at one weight each
+
+	// freePaths is a request path of zero to five atoms (the root for none), with a trailing
+	// slash one time in five.
+	freePaths = hegel.FlatMap(rangeHalves(0, 5), func(n int) hegel.Generator[hzPath] { // 0 to 5 atoms, nominal 16.7 each: realise 17/16/18/17/17/15
+		if n == 0 {
+			return hegel.Just(hzPath{raw: "/"})
+		}
+		return hegel.FlatMap(hzCounted(pathAtoms, n, n), func(atoms []string) hegel.Generator[hzPath] {
+			return hegel.Map(dieCoin(20), func(trailing bool) hzPath { // trailing slash nominal 20: realises 20.8
+				p := "/" + strings.Join(atoms, "/")
+				if trailing {
+					p += "/"
+				}
+				return hzPath{raw: p}
+			})
+		})
+	})
+)
+
+// hzStaticSegments are the static segments of the routes' patterns (the model's reading),
+// the values that make a :param of one route clash with the static branch of another.
+func hzStaticSegments(routes []*hzRoute) []string {
+	var statics []string
+	for _, o := range routes {
+		for _, t := range o.toks {
+			if t.kind == hzStatic {
+				for _, seg := range strings.Split(t.text, "/") {
+					if seg != "" {
+						statics = append(statics, seg)
+					}
+				}
+			}
+		}
+	}
+	return statics
+}
+
+// builtPaths is a request path built from one of the routes (drawn evenly): its static text,
+// a value per :param (an atom, or a static segment of one of the routes as often, or one of
+// the surprises fifteen times in a hundred) and a value after the slash of its *catch-all;
+// then, three times in ten, the trailing slash toggled, a suffix appended or the path
+// upper-cased.
+func builtPaths(routes []*hzRoute) hegel.Generator[hzPath] {
+	values := paramAtoms
+	if statics := hzStaticSegments(routes); len(statics) > 0 {
+		values = dieChoice(hzW(1, paramAtoms), hzW(1, evenHalves(statics...))) // an atom 50, a static segment 50: a static segment (or an atom that is one) realises 50.4 of the values, an atom that is none 35.3
+	}
+	paramValues := dieChoice(hzW(85, values), hzW(15, surpriseAtoms)) // a surprise nominal 15: realises 14.4
+	filled := hegel.FlatMap(evenHalves(routes...), func(r *hzRoute) hegel.Generator[hzPath] {
+		return hegel.Composite(func(tc hegel.TestCase) hzPath {
+			var sb strings.Builder
+			for _, t := range r.toks {
+				switch t.kind {
+				case hzStatic:
+					sb.WriteString(t.text)
+				case hzParam:
+					sb.WriteString(hegel.Draw(tc, paramValues))
+				case hzCatchAll:
+					sb.WriteByte('/')
+					sb.WriteString(hegel.Draw(tc, catchAllFills))
+				}
+			}
+			return hzPath{raw: sb.String(), from: r.id}
+		})
+	})
+	return hegel.FlatMap(filled, func(p hzPath) hegel.Generator[hzPath] {
+		decorated := func(raw, decor string) hzPath { return hzPath{raw: raw, from: p.from, decor: decor} }
+		return dieChoice(
+			hzW(7, hegel.Just(p)), // as built nominal 70: realises 68.4
+			hzW(1, hegel.Just(decorated(hzToggleSlash(p.raw), "toggled"))),                               // the slash toggled nominal 10: realises 11.0
+			hzW(1, hegel.Map(suffixes, func(s string) hzPath { return decorated(p.raw+s, "suffixed") })), // a suffix nominal 10: realises 10.3
+			hzW(1, hegel.Just(decorated(strings.ToUpper(p.raw), "upper-cased"))),                         // upper-cased nominal 10: realises 10.2
+		)
+	})
+}
+
+// hzReadable are the routes whose pattern the tokenizer reads (the model's acceptance of the
+// shape; the tree's conflicts are the acceptance model's business).
+func hzReadable(routes []*hzRoute) []*hzRoute {
+	var out []*hzRoute
+	for _, r := range routes {
+		if r.ok {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// pathsFor is a request path to the routes of one method: built from one of them half the
+// time (always free when there is none), free otherwise.
+func pathsFor(own []*hzRoute) hegel.Generator[hzPath] {
+	if len(own) == 0 {
+		return freePaths
+	}
+	return dieChoice(hzW(1, builtPaths(own)), hzW(1, freePaths)) // built nominal 50: realises 48.9 (Match), 49.4 (Engine)
+}
+
+// requestOf is one request to the routes: the method (GET, or pct percent of the time one of
+// hzMethods), then a path for the drawn routes of that method the tokenizer reads.
+func requestOf(routes []*hzRoute, pct int) hegel.Generator[hzRequest] {
+	return hegel.FlatMap(methodsAt(pct), func(m string) hegel.Generator[hzRequest] {
+		return hegel.Map(pathsFor(hzReadable(hzByMethod(routes, m))), func(p hzPath) hzRequest {
+			return hzRequest{method: m, raw: p.raw, from: p.from, decor: p.decor}
+		})
+	})
+}
+
+// requestsFor is the three requests of a case. Under HEGEL_NO_KNOWN=1 each request is
+// filtered by the classifier of the family on the case of that one request (caseOf makes it,
+// expected is the family's model): a shape here is a property of the routes and one request,
+// so the filter keeps every case and the rejections are counted "filtered gin/N"; nil for
+// caseOf is no filter (a family without shapes).
+func requestsFor[T any](routes []*hzRoute, pct int, caseOf func(hzRequest) T, expected func(T, known) checks) hegel.Generator[[]hzRequest] {
+	one := requestOf(routes, pct)
+	if hzNoKnown && caseOf != nil {
+		one = hegel.Filter(one, func(r hzRequest) bool {
+			id := shapeID(caseOf(r), expected)
+			if id != "" {
+				hzTally("filtered " + id)
+			}
+			return id == ""
+		})
+	}
+	return hzCounted(one, 3, 3)
+}
+
+// --------------------------------------------------------------------------- the options
+// and the clean paths
+
+// engineOpts are the six options as coins: RedirectTrailingSlash 50, RedirectFixedPath 40,
+// HandleMethodNotAllowed 40, RemoveExtraSlash 30, UseRawPath 30, UnescapePathValues 60.
+var engineOpts = hegel.Map(hzTuple(
+	dieCoin(50), // tsr nominal 50: realises 51.6
+	dieCoin(40), // fixedPath nominal 40: realises 39.4
+	dieCoin(40), // 405 nominal 40: realises 41.0
+	dieCoin(30), // extraSlash nominal 30: realises 29.8
+	dieCoin(30), // rawPath nominal 30: realises 29.2
+	dieCoin(60), // unescape nominal 60: realises 59.9
+), func(b []bool) hzEngineOpts {
+	return hzEngineOpts{tsr: b[0], fixed: b[1], mna: b[2], extraSlash: b[3], rawPath: b[4], unescape: b[5]}
+})
+
+var (
+	cleanAtoms = evenHalves(hzCleanAtoms...) // the twelve atoms, nominal 8.3 each: realise 7.8 to 8.7
+
+	// cleanCases is a clean-path case: rooted 85, zero to six atoms, a slash before the first
+	// 30 (drawn only when there is one), a trailing slash 25.
+	cleanCases = hegel.Composite(func(tc hegel.TestCase) cleanCase {
+		var c cleanCase
+		c.rooted = hegel.Draw(tc, dieCoin(85)) // rooted nominal 85: realises 84.5
+		n := hegel.Draw(tc, rangeHalves(0, 6)) // 0 to 6 atoms, nominal 14.3 each: realise 13/16/12/15/15/15/15 (the four cases of no atom deduplicated)
+		if n > 0 {
+			c.lead = hegel.Draw(tc, dieCoin(30)) // a slash before the first nominal 30: realises 29.9
+		}
+		c.atoms = hegel.Draw(tc, hzCounted(cleanAtoms, n, n))
+		c.trailing = hegel.Draw(tc, dieCoin(25)) // trailing nominal 25: realises 25.4
+		return c
+	})
+)
diff --git a/hegel_zoo_test.go b/hegel_zoo_test.go
new file mode 100644
index 0000000..5a1ace9
--- /dev/null
+++ b/hegel_zoo_test.go
@@ -0,0 +1,631 @@
+package gin
+
+// Hegel property tests for gin-gonic/gin's router, written for the Hegel zoo. See
+// targets/go/gin/README.md. They live in package gin (not a subpackage) because the router
+// tree and cleanPath are unexported; every identifier here carries the hz prefix to stay clear
+// of the upstream tests (the harness names copied from the go/go-debian series - known,
+// checks, judged, shapeBy, verdict, regionOf and the die* family - are kept as they are
+// there so that the series reads alike).
+//
+// Oracles: a model of route matching (static text first, then a :param, then a *catch-all,
+// with backtracking) over generated route sets and request paths, walking the tree the routes
+// make node by node; a model of the tree's acceptance (the panics of addRoute); the law that
+// the set of routes a tree accepts, and what the tree matches, do not depend on the order of
+// registration; path.Clean as the oracle of cleanPath; a model of the engine's answer
+// (status, Location, Allow) under every combination of its options.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES and
+// HEGEL_SEED are passed through hegelOpts; a panic in the code under test is turned into a
+// failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has. ZOO_COLLECT=1 (or HEGEL_COLLECT=1) makes the properties record
+// their mismatches instead of failing and print the counts.
+//
+// Every property (hegel_zoo_router_test.go, hegel_zoo_engine_test.go,
+// hegel_zoo_path_test.go) draws its cases as records from package-level generators
+// (hegel_zoo_routes_test.go), judges the library against a model that states the documented
+// behaviour (every switch of the known value below off) and names the shape of the recorded
+// bug a case has before the library is called (the harness in this file; the replicas of the
+// tree's rules under the switches are the model walk of hegel_zoo_router_test.go and the
+// engine model of hegel_zoo_engine_test.go); the narrow companions
+// (hegel_zoo_router_shapes_test.go) draw each shape on purpose. Part 2 of the series (the
+// binding package, binding/hegel_zoo_*_test.go) keeps its own harness until it is rewritten.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+func init() {
+	SetMode(ReleaseMode)
+}
+
+// --------------------------------------------------------------------------- harness
+
+// hegelOpts passes HEGEL_TEST_CASES and HEGEL_SEED through to the engine, which reads no
+// environment variable itself (the seed is for the rate measurements of the probe and the
+// collector).
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi and go/go-debian judge; hegel_zoo_idioms_test.go has
+// the generator idioms). The model of each family takes the set of recorded bugs it follows
+// as a value (known); the properties judge the library against the documented behaviour
+// (hzKnownNone), name the shape of the recorded bug a case has before the library is called
+// (hzCaseJudge.Shape, from the classifier shapeBy) and skip, drop or filter the shapes under
+// HEGEL_NO_KNOWN=1 (hzNoKnown).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != "" || os.Getenv("HEGEL_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below in
+// bug order (the id of a switch is "gin/<index+1>"). The model of each property is a pure
+// function of (case, known): with every switch off (hzKnownNone) it states the documented
+// behaviour (the README's matching rules with backtracking, the option docs quoted at the top
+// of hegel_zoo_engine_test.go, url.PathUnescape for a path value) and is what the properties
+// judge the library against; with a switch on it reproduces that bug as a replica of the
+// tree's rule, transcribed from tree.go and gin.go at the point named beside the switch. The
+// classifier of each property runs the model with several sets to name the shape of a case
+// before the library is called; the pins assert the documented behaviour and fail while the
+// bug exists. The model walk (hegel_zoo_router_test.go) follows 1, 2, 3, 4, 6, 13 and 14 (and
+// 7, the stack it is handed); the engine model (hegel_zoo_engine_test.go) 5, 7 and 15 on top
+// of it; 8 to 12 are the binding package's (part 2 of the series) and only exist here so that
+// the ids are complete.
+type known [15]bool
+
+const (
+	// gin/1: a static route one slash away from the request shadows a matching :param route
+	kStaticShadowsParam = iota
+	// gin/2: a :param branch that dead-ends is not abandoned for the wildcard sibling of an earlier node
+	kParamDeadEnd
+	// gin/3: RedirectTrailingSlash redirects a path ending in a slash to a path that has no route
+	kTrailingSlashToNothing
+	// gin/4: RedirectFixedPath never finds a route whose *catch-all follows a :param
+	kFixedPathMissesCatchAll
+	// gin/5: UseRawPath with UnescapePathValues turns a plus in a path value into a space
+	kPlusUnescapedToSpace
+	// gin/6: RedirectFixedPath redirects a path ending in a slash to a path that has no route
+	kFixedPathToNothing
+	// gin/7: the skipped-nodes stack is not reset between the method trees of one request: wrong 405 and a panic
+	kSkippedNodesLeak
+	// gin/8: binding a form into a nil map panics, as does a key without values
+	kNilMapPanics
+	// gin/9: a struct with a pointer field of its own type binds until the stack overflows
+	kSelfReferenceOverflows
+	// gin/10: a destination passed by value panics instead of returning an error
+	kValueDestinationPanics
+	// gin/11: an empty value for a struct or map field is a JSON error
+	kEmptyValueJSONError
+	// gin/12: an empty value for a slice or array field is not replaced by its default
+	kEmptyValueWithoutDefault
+	// gin/13: RedirectTrailingSlash misses the redirect to path + "/" when a :param route is registered beside the static branch
+	kParamSiblingHidesSlashRedirect
+	// gin/14: mixed static:param routes at one position overflow the skipped-nodes stack: a panic on a plain request
+	kMixedSegmentsOverflowStack
+	// gin/15: RedirectTrailingSlash does not recommend a path the tree serves through an empty :param value before the slash
+	kEmptyParamSlashUnrecommended
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("gin/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "gin/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "gin/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape gin/N" per
+// case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// gin/N"), the checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped gin/N"), the draws
+// the filters rejected ("filtered <name>"), the replica's agreement with the library on the
+// shaped cases ("replica agreement", "replica disagreement"), the cases noted for a design
+// exclusion ("noted <what>") and the model's notes on the engine's answers ("tsr: documented
+// only", "tsr: tree only", "tsr: hidden by rollback", "tsr: empty param unrecommended",
+// "fixed: same path"); printed and reset by the collector, under hzStatsMu. (A case assumed
+// away for an unrecorded candidate bug would be counted "candidate/go/gin-N ..." here; none
+// is left.)
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi and go/go-debian judge, with the collector's mismatch
+// classes): it names the recorded bug whose shape the case has, so that a mismatch or a
+// library panic fails "(the shape of gin/N)", and under HEGEL_NO_KNOWN=1 skips the case
+// instead (counted as known). The wide and the narrow properties of a family share their judge
+// function and so this. The classifier that names the shape is computed from the case alone
+// (the model run with several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are filtered
+// out of the requests by the classifier, or the regions past them drawn), and the collector
+// measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped gin/N") and the case goes on
+// (judgeByDropping; no property of this part needs it, the form is kept for part 2).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (shared by every family; the go/carbon, go/orb, go/chi and go/go-debian form:
+// every value here is text compared exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// checkOrder is the order the checks of a case are reported in when it fails (the order the
+// models state them in): the acceptance first, then the requests in order, then the
+// clean-path checks; other names sort by text.
+var checkOrder = map[string]int{
+	"rejected": 0, "acceptance": 1, "r1": 2, "r2": 3, "r3": 4, "r4": 5, "r5": 6, "r6": 7,
+	"clean": 10, "idempotent": 11,
+}
+
+func checkLess(a, b string) bool {
+	ar, aok := checkOrder[a]
+	br, bok := checkOrder[b]
+	if aok && bok && ar != br {
+		return ar < br
+	}
+	if aok != bok {
+		return aok
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two statements agree: the same checks, each value equal.
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || a[k] != w {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, a[k]))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, a[k], w))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("gin/?", a defect of the model). The
+// order matters where two shapes meet (a static branch that stops at a "/" node meets gin/1
+// and gin/3; the leak of gin/7 rides on the stops of gin/1 and gin/2 in the pins' instances):
+// sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "gin/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters and the request filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	verdictBy(j, c, got, want, shape, expected, sameChecks)
+}
+
+// verdictBy is verdict with the family's own notion of replica agreement (none of this
+// target's families needs one; the form is kept from go/chi, whose RouteHeaders replica is a
+// set and agreement is membership).
+func verdictBy[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks, agrees func(got, replica checks) bool) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agrees(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if sameChecks(got, want) {
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || g != want[k] {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	j.Fail(class, "%s for\n%#v", diffChecks(got, want), c)
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi and go/go-debian form): by default the shape is named and
+// every check judged; under HEGEL_NO_KNOWN=1 the checks the shapes cover (those on which the
+// replica with every switch on differs from the documented model, or which it does not
+// state) are dropped from the case (hzCaseJudge.Dropped, counted "dropped gin/N") and the
+// rest judged, the case not skipped. No property of this part needs it (the shapes are
+// filtered out of the requests instead); kept for part 2.
+func judgeByDropping[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	want := expected(c, hzKnownNone)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(c, hzKnownAll)
+		for name, v := range want {
+			if w, ok := all[name]; !ok || w != v {
+				delete(want, name)
+			}
+		}
+		verdict(j, c, actual(c), want, "", expected)
+		return
+	}
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few walks.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered gin/N" by the shape it had), g itself otherwise: the
+// request generators of the wide properties run it on each request alone (a shape here is a
+// property of the routes and one request), so that no case of a wide property is skipped.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
