diff --git a/hegel_zoo_engine_test.go b/hegel_zoo_engine_test.go
new file mode 100644
index 0000000..f1fabdd
--- /dev/null
+++ b/hegel_zoo_engine_test.go
@@ -0,0 +1,291 @@
+package gin
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- engine options
+//
+// gin.go: RedirectTrailingSlash "enables automatic redirection if the current route can't be
+// matched but a handler for the path with (without) the trailing slash exists. For example
+// if /foo/ is requested but a route only exists for /foo, the client is redirected to /foo
+// with http status code 301 for GET requests and 307 for all other request methods."
+// RedirectFixedPath: "if enabled, the router tries to fix the current request path, if no
+// handle is registered for it. First superfluous path elements like ../ or // are removed.
+// Afterwards the router does a case-insensitive lookup of the cleaned path. If a handle can be
+// found for this route, the router makes a redirection to the corrected path with status code
+// 301 for GET requests and 307 for all other request methods." HandleMethodNotAllowed: "if
+// enabled, the router checks if another method is allowed for the current route, if the
+// current request can not be routed. If this is the case, the request is answered with
+// 'Method Not Allowed' and HTTP status code 405" with an Allow header (RFC 7231 6.5.5).
+// RemoveExtraSlash: "a parameter can be parsed from the URL even with extra slashes".
+// UseRawPath: "the url.RawPath will be used to find parameters"; UnescapePathValues: "the
+// path value will be unescaped".
+
+type hzEngineOpts struct {
+	tsr, fixed, mna, extraSlash, rawPath, unescape bool
+}
+
+func hzGenEngineOpts(tc hegel.TestCase) hzEngineOpts {
+	return hzEngineOpts{
+		tsr:        hzChance(tc, 50),
+		fixed:      hzChance(tc, 40),
+		mna:        hzChance(tc, 40),
+		extraSlash: hzChance(tc, 30),
+		rawPath:    hzChance(tc, 30),
+		unescape:   hzChance(tc, 60),
+	}
+}
+
+func (o hzEngineOpts) apply(e *Engine) {
+	e.RedirectTrailingSlash = o.tsr
+	e.RedirectFixedPath = o.fixed
+	e.HandleMethodNotAllowed = o.mna
+	e.RemoveExtraSlash = o.extraSlash
+	e.UseRawPath = o.rawPath
+	e.UnescapePathValues = o.unescape
+}
+
+func (o hzEngineOpts) String() string {
+	var parts []string
+	add := func(on bool, s string) {
+		if on {
+			parts = append(parts, s)
+		}
+	}
+	add(o.tsr, "tsr")
+	add(o.fixed, "fixedPath")
+	add(o.mna, "405")
+	add(o.extraSlash, "extraSlash")
+	add(o.rawPath, "rawPath")
+	add(o.unescape, "unescape")
+	if len(parts) == 0 {
+		return "plain"
+	}
+	return strings.Join(parts, "+")
+}
+
+// hzResponse is the model's (and the engine's) answer: the status, the body of a served
+// request, the Location of a redirect, the Allow methods of a 405.
+type hzResponse struct {
+	code     int
+	body     string
+	location string
+	allow    []string
+}
+
+func (r hzResponse) String() string {
+	switch {
+	case r.code == 0:
+		return fmt.Sprintf("panic %s", r.body)
+	case r.code == 200:
+		return fmt.Sprintf("200 %s", r.body)
+	case r.code == 301 || r.code == 307:
+		return fmt.Sprintf("%d -> %s", r.code, r.location)
+	case r.code == 405:
+		return fmt.Sprintf("405 Allow %v", r.allow)
+	}
+	return fmt.Sprint(r.code)
+}
+
+// hzRedirectLocation is where http.Redirect sends a request whose URL path was changed to
+// newPath: the URL's string, made absolute against the request's directory when it is not,
+// with the path cleaned (a trailing slash kept).
+func hzRedirectLocation(u *url.URL, newPath string) string {
+	u2 := *u
+	u2.Path = newPath
+	s := u2.String()
+	if pu, err := url.Parse(s); err == nil && pu.Scheme == "" && pu.Host == "" {
+		oldpath := newPath
+		if oldpath == "" {
+			oldpath = "/"
+		}
+		if s == "" || s[0] != '/' {
+			dir, _ := path.Split(oldpath)
+			s = dir + s
+		}
+		query := ""
+		if i := strings.LastIndex(s, "?"); i >= 0 {
+			s, query = s[:i], s[i:]
+		}
+		trailing := strings.HasSuffix(s, "/")
+		s = path.Clean(s)
+		if trailing && !strings.HasSuffix(s, "/") {
+			s += "/"
+		}
+		s += query
+	}
+	return s
+}
+
+// hzToggleSlash removes a trailing slash or adds one.
+func hzToggleSlash(p string) string {
+	if len(p) > 1 && strings.HasSuffix(p, "/") {
+		return p[:len(p)-1]
+	}
+	return p + "/"
+}
+
+// hzModelServe is the documented answer to a request.
+func hzModelServe(o hzEngineOpts, routes []*hzRoute, method string, u *url.URL, note func(string)) hzResponse {
+	rPath := u.Path
+	unescape := false
+	if o.rawPath && u.RawPath != "" {
+		rPath = u.RawPath
+		unescape = o.unescape
+	}
+	if o.extraSlash {
+		rPath = hzModelCleanPath(rPath)
+	}
+	own := hzByMethod(routes, method)
+	// the skipped-node stack's capacity: the most '/' in a route
+	capacity := 0
+	for _, r := range routes {
+		if n := strings.Count(r.pattern, "/"); n > capacity {
+			capacity = n
+		}
+	}
+	step, stack := hzWalkStack(own, rPath, false, nil, capacity)
+	if step.ok {
+		m := step.m
+		if unescape {
+			for i, p := range m.params {
+				// the tree unescapes with url.QueryUnescape, which turns '+' into a space
+				// (bug 5); a path value would take url.PathUnescape
+				var v string
+				var err error
+				if HZKnown.plusToSpace {
+					v, err = url.QueryUnescape(p.Value)
+				} else {
+					v, err = url.PathUnescape(p.Value)
+				}
+				if err == nil {
+					m.params[i].Value = v
+				}
+			}
+		}
+		return hzResponse{code: 200, body: hzExpect(m)}
+	}
+	code := http.StatusMovedPermanently
+	if method != http.MethodGet {
+		code = http.StatusTemporaryRedirect
+	}
+	if method != http.MethodConnect && rPath != "/" {
+		if o.tsr {
+			// documented: a route exists for the path with the slash toggled; the tree's own
+			// recommendation (step.tsr) adds the cases of bug 3
+			_, doc := hzModelMatch(own, hzToggleSlash(rPath))
+			if note != nil && doc != step.tsr {
+				if doc {
+					note("tsr: documented only")
+				} else {
+					note("tsr: tree only")
+				}
+			}
+			if doc || step.tsr {
+				return hzResponse{code: code, location: hzRedirectLocation(u, hzToggleSlash(u.Path))}
+			}
+		}
+		if o.fixed {
+			if f := hzWalk(own, hzModelCleanPath(u.Path), true); f.ok {
+				if note != nil && f.fixed == u.Path {
+					note("fixed: same path")
+				}
+				return hzResponse{code: code, location: hzRedirectLocation(u, f.fixed)}
+			}
+		}
+	}
+	if o.mna {
+		// the other trees, in the order their methods were first registered; each lookup
+		// starts with the stack the previous one left (bug 7)
+		var allowed []string
+		seen := map[string]bool{}
+		for _, r := range routes {
+			if r.method == method || seen[r.method] {
+				continue
+			}
+			seen[r.method] = true
+			if !HZKnown.skippedNodesLeak {
+				stack = nil
+			}
+			var s hzStep
+			s, stack = hzWalkStack(hzByMethod(routes, r.method), rPath, false, stack, capacity)
+			if s.overflow {
+				return hzResponse{code: 0} // panic: slice bounds out of range
+			}
+			if s.ok {
+				allowed = append(allowed, r.method)
+			}
+		}
+		if len(allowed) > 0 {
+			sort.Strings(allowed)
+			return hzResponse{code: 405, allow: allowed}
+		}
+	}
+	return hzResponse{code: 404}
+}
+
+// TestHegelEngine: with every combination of the router options, a request is served,
+// redirected (to a path that is served) or refused as the documentation says.
+func TestHegelEngine(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		o := hzGenEngineOpts(ht)
+		routes := hzGenRoutes(ht)
+		for _, r := range routes {
+			r.toks, _ = hzTokenize(r.pattern)
+		}
+		e, accepted, _ := hzBuild(routes, o.apply)
+		for k := 0; k < 3; k++ {
+			method := http.MethodGet
+			if hzChance(ht, 25) {
+				method = hzPick(ht, hzMethods)
+			}
+			raw := hzGenPath(ht, hzByMethod(accepted, method))
+			u, err := url.ParseRequestURI(raw)
+			if err != nil {
+				continue
+			}
+			want := hzModelServe(o, accepted, method, u, c.count)
+			var w *httptest.ResponseRecorder
+			var got hzResponse
+			if r := hzCatch(func() { w = hzServe(e, method, raw) }); r != nil {
+				got = hzResponse{code: 0, body: fmt.Sprint(r)} // the engine panicked
+			} else {
+				got = hzResponse{code: w.Code, body: w.Body.String(), location: w.Header().Get("Location")}
+			}
+			if got.code == 405 {
+				got.allow = strings.Split(w.Header().Get("Allow"), ", ")
+				sort.Strings(got.allow)
+			}
+			c.count(fmt.Sprintf("%d", want.code))
+			same := got.code == want.code
+			switch want.code {
+			case 0:
+				same = same && strings.Contains(got.body, "slice bounds out of range")
+			case 200:
+				same = same && got.body == want.body
+			case 301, 307:
+				same = same && got.location == want.location
+			case 405:
+				same = same && fmt.Sprint(got.allow) == fmt.Sprint(want.allow)
+			}
+			if !same {
+				class := fmt.Sprintf("%d vs %d", got.code, want.code)
+				if got.code == want.code {
+					class = fmt.Sprintf("%d detail", got.code)
+				}
+				c.failClass(ht, class, "%s %s (path %q, raw %q) under %s\n  got  %s\n  want %s\n  routes %s", method, raw, u.Path, u.RawPath, o, got, want, hzShowRoutes(accepted))
+			}
+		}
+	})
+}
diff --git a/hegel_zoo_path_test.go b/hegel_zoo_path_test.go
new file mode 100644
index 0000000..4ca0284
--- /dev/null
+++ b/hegel_zoo_path_test.go
@@ -0,0 +1,72 @@
+package gin
+
+import (
+	"path"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- cleanPath
+//
+// path.go: "cleanPath is the URL version of path.Clean, it returns a canonical URL path for
+// p, eliminating . and .. elements. The following rules are applied iteratively until no
+// further processing can be done: 1. Replace multiple slashes with a single slash. 2.
+// Eliminate each . path name element (the current directory). 3. Eliminate each inner ..
+// path name element (the parent directory) along with the non-.. element that precedes it.
+// 4. Eliminate .. elements that begin a rooted path: that is, replace "/.." by "/" at the
+// beginning of a path. If the result of this process is an empty string, "/" is returned."
+// Unlike path.Clean it keeps a trailing slash, and a path is always rooted.
+
+// hzModelCleanPath is path.Clean on the rooted path, with the trailing slash kept.
+func hzModelCleanPath(p string) string {
+	if p == "" {
+		return "/"
+	}
+	rooted := p
+	if p[0] != '/' {
+		rooted = "/" + p
+	}
+	out := path.Clean(rooted)
+	// a path ending in "/." is a directory too; one ending in "/.." is not (as in httprouter)
+	trailing := strings.HasSuffix(p, "/") || strings.HasSuffix(rooted, "/.")
+	if trailing && out != "/" {
+		out += "/"
+	}
+	return out
+}
+
+var hzCleanAtoms = []string{"a", "b", "abc", ".", "..", "...", ".a", "a.", "", "x y", "%2e", "A"}
+
+// TestHegelCleanPath: cleanPath agrees with path.Clean (trailing slash kept).
+func TestHegelCleanPath(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		if hzChance(ht, 85) {
+			sb.WriteByte('/')
+		}
+		n := hzDrawInt(ht, 0, 6)
+		for i := 0; i < n; i++ {
+			if i > 0 || hzChance(ht, 30) {
+				sb.WriteByte('/')
+			}
+			sb.WriteString(hzPick(ht, hzCleanAtoms))
+		}
+		if hzChance(ht, 25) {
+			sb.WriteByte('/')
+		}
+		p := sb.String()
+		got := cleanPath(p)
+		want := hzModelCleanPath(p)
+		if got != want {
+			c.failClass(ht, "clean", "cleanPath(%q) = %q, want %q", p, got, want)
+			return
+		}
+		c.count("ok")
+		if again := cleanPath(got); again != got {
+			c.failClass(ht, "idempotence", "cleanPath(%q) = %q, cleanPath of that = %q", p, got, again)
+		}
+	})
+}
diff --git a/hegel_zoo_pins_test.go b/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..bca9466
--- /dev/null
+++ b/hegel_zoo_pins_test.go
@@ -0,0 +1,147 @@
+package gin
+
+import (
+	"testing"
+)
+
+// --------------------------------------------------------------------------- pins
+//
+// One test per recorded bug (bugs.toml), asserting the documented behaviour; they are expected
+// failures while the bug exists.
+
+func hzPinEngine(routes ...string) *Engine {
+	e := New()
+	hzPlain(e)
+	for i, r := range routes {
+		e.GET(r, hzHandler(i+1))
+	}
+	return e
+}
+
+// TestHegelPinTrailingSlashShadowsParam: gin/1. A request that matches a :param route is served
+// by it even when a static route differing only by a trailing slash exists.
+func TestHegelPinTrailingSlashShadowsParam(t *testing.T) {
+	e := hzPinEngine("/b/", "/:name")
+	if w := hzServe(e, "GET", "/b"); w.Code != 200 || w.Body.String() != "R2|name=b" {
+		t.Errorf("GET /b with routes /b/ and /:name: %d %q, want 200 R2|name=b", w.Code, w.Body.String())
+	}
+	e = hzPinEngine("/a/b", "/:p/b/")
+	if w := hzServe(e, "GET", "/a/b/"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b/ with routes /a/b and /:p/b/: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	e = New()
+	e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false // RedirectTrailingSlash on
+	e.GET("/b/", hzHandler(1))
+	e.GET("/:name", hzHandler(2))
+	if w := hzServe(e, "GET", "/b"); w.Code != 200 {
+		t.Errorf("GET /b with routes /b/ and /:name and RedirectTrailingSlash: %d (Location %q), want 200", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinParamDeadEnd: gin/2. When a :param branch dead-ends, the router backtracks to the
+// wildcard sibling of an earlier node, as it does after a static mismatch.
+func TestHegelPinParamDeadEnd(t *testing.T) {
+	e := hzPinEngine("/a/:x", "/:p/b/c")
+	if w := hzServe(e, "GET", "/a/b/c"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b/c with routes /a/:x and /:p/b/c: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	e = hzPinEngine("/a/:x/", "/:p/b")
+	if w := hzServe(e, "GET", "/a/b"); w.Code != 200 || w.Body.String() != "R2|p=a" {
+		t.Errorf("GET /a/b with routes /a/:x/ and /:p/b: %d %q, want 200 R2|p=a", w.Code, w.Body.String())
+	}
+	// with RedirectFixedPath, the case-insensitive lookup (which does backtrack) finds the very
+	// path requested, and the engine redirects the request to itself
+	e = hzPinEngine("/a/:x", "/:p/b/c")
+	e.RedirectFixedPath = true
+	if w := hzServe(e, "GET", "/a/b/c"); w.Code != 200 {
+		t.Errorf("GET /a/b/c with routes /a/:x and /:p/b/c and RedirectFixedPath: %d (Location %q), want 200 R2|p=a", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinTrailingSlashRedirectToNothing: gin/3. RedirectTrailingSlash redirects only when
+// "a handler for the path with (without) the trailing slash exists".
+func TestHegelPinTrailingSlashRedirectToNothing(t *testing.T) {
+	for _, tc := range []struct {
+		routes []string
+		req    string
+	}{
+		{[]string{"/:a/:b"}, "/id/"},
+		{[]string{"/x/:p", "/xy"}, "/x/"},
+	} {
+		e := New()
+		e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false
+		for i, r := range tc.routes {
+			e.GET(r, hzHandler(i+1))
+		}
+		w := hzServe(e, "GET", tc.req)
+		if w.Code != 404 {
+			t.Errorf("GET %s with routes %v: %d (Location %q), want 404: no route exists for the redirect target", tc.req, tc.routes, w.Code, w.Header().Get("Location"))
+		}
+	}
+}
+
+// TestHegelPinFixedPathAfterParam: gin/4. RedirectFixedPath's case-insensitive lookup finds a
+// route with a *catch-all after a :param.
+func TestHegelPinFixedPathAfterParam(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.HandleMethodNotAllowed = false, false
+	e.RedirectFixedPath = true
+	e.GET("/a/:q/*rest", hzHandler(1))
+	if w := hzServe(e, "GET", "/A/x/y"); w.Code != 301 || w.Header().Get("Location") != "/a/x/y" {
+		t.Errorf("GET /A/x/y with route /a/:q/*rest and RedirectFixedPath: %d (Location %q), want 301 to /a/x/y", w.Code, w.Header().Get("Location"))
+	}
+}
+
+// TestHegelPinPlusInRawPath: gin/5. With UseRawPath and UnescapePathValues, a '+' in a path
+// value stays a '+' (it is a query-string convention, not a path one).
+func TestHegelPinPlusInRawPath(t *testing.T) {
+	e := New()
+	hzPlain(e)
+	e.UseRawPath, e.UnescapePathValues = true, true
+	e.GET("/:p", hzHandler(1))
+	if w := hzServe(e, "GET", "/a+b%2Fc"); w.Body.String() != "R1|p=a+b/c" {
+		t.Errorf("GET /a+b%%2Fc with route /:p, UseRawPath and UnescapePathValues: %q, want R1|p=a+b/c", w.Body.String())
+	}
+}
+
+// TestHegelPinFixedPathRedirectToNothing: gin/6. RedirectFixedPath redirects only when "a
+// handle can be found" for the fixed path.
+func TestHegelPinFixedPathRedirectToNothing(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.HandleMethodNotAllowed = false, false
+	e.RedirectFixedPath = true
+	e.GET("/a/:p/b", hzHandler(1))
+	for _, req := range []string{"/A/x/", "/a/x/"} {
+		if w := hzServe(e, "GET", req); w.Code != 404 {
+			t.Errorf("GET %s with route /a/:p/b and RedirectFixedPath: %d (Location %q), want 404: no route exists for the redirect target", req, w.Code, w.Header().Get("Location"))
+		}
+	}
+}
+
+// TestHegelPinSkippedNodesLeak: gin/7. The lookups of one request do not see each other's
+// state: with HandleMethodNotAllowed, a request no method serves is a 404, and the engine
+// does not panic.
+func TestHegelPinSkippedNodesLeak(t *testing.T) {
+	e := New()
+	e.RedirectTrailingSlash, e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false, true
+	e.GET("/:name/*rest", hzHandler(1))
+	e.GET("/c/:p", hzHandler(2))
+	e.POST("/x", hzHandler(3))
+	if w := hzServe(e, "GET", "/c/a/b"); w.Code != 404 {
+		t.Errorf("GET /c/a/b with GET /:name/*rest, GET /c/:p and POST /x, HandleMethodNotAllowed: %d (Allow %q), want 404: no method serves it", w.Code, w.Header().Get("Allow"))
+	}
+	// the stack the lookups share has room for the most '/' in a route; every method tree's
+	// lookup leaves an entry, and the fourth overflows it
+	e = New()
+	e.RedirectTrailingSlash, e.RedirectFixedPath, e.HandleMethodNotAllowed = false, false, true
+	for _, m := range []string{"GET", "POST", "PUT", "PATCH", "DELETE"} {
+		e.Handle(m, "/a/b/", hzHandler(1))
+		e.Handle(m, "/a/:x", hzHandler(2))
+	}
+	var code int
+	if r := hzCatch(func() { code = hzServe(e, "GET", "/a/b").Code }); r != nil {
+		t.Errorf("GET /a/b with /a/b/ and /a/:x on five methods, HandleMethodNotAllowed: panic %v, want a response (200 R2|x=b)", r)
+	} else if code != 200 {
+		t.Errorf("GET /a/b with /a/b/ and /a/:x on five methods, HandleMethodNotAllowed: %d, want 200 R2|x=b", code)
+	}
+}
