+// Hegel property tests for go.etcd.io/bbolt: a random sequence of transactions (puts, deletes,
+// nested buckets, moves, sequences, rollbacks, reopen) against an in-memory model of the key
+// space, with the cursor, ForEach, Stats, Compact and tx.Check() as the observers.
+//
+// A case is drawn as data: a script of transactions, each a list of operations whose buckets
+// and entries are chosen by indices taken modulo the live model when the script is applied, so
+// the shrinker can delete a transaction or a step and the rest still means something.
+package bbolt_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	bolt "go.etcd.io/bbolt"
+	berrors "go.etcd.io/bbolt/errors"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// ---- the model -----------------------------------------------------------------------------
+
+// mbucket models a bucket: values, nested buckets and the sequence counter.
+type mbucket struct {
+	kv  map[string][]byte
+	sub map[string]*mbucket
+	seq uint64
+}
+
+func newMB() *mbucket { return &mbucket{kv: map[string][]byte{}, sub: map[string]*mbucket{}} }
+
+func (m *mbucket) clone() *mbucket {
+	c := &mbucket{kv: make(map[string][]byte, len(m.kv)), sub: make(map[string]*mbucket, len(m.sub)), seq: m.seq}
+	for k, v := range m.kv {
+		c.kv[k] = append([]byte(nil), v...)
+	}
+	for k, s := range m.sub {
+		c.sub[k] = s.clone()
+	}
+	return c
+}
+
+// keys returns every entry name (values and buckets) in order.
+func (m *mbucket) keys() []string {
+	ks := make([]string, 0, len(m.kv)+len(m.sub))
+	for k := range m.kv {
+		ks = append(ks, k)
+	}
+	for k := range m.sub {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// entries counts keys and bucket entries recursively (Stats().KeyN) and buckets inclusive
+// (Stats().BucketN).
+func (m *mbucket) entries() (keyN, bucketN int) {
+	keyN, bucketN = len(m.kv)+len(m.sub), 1
+	for _, s := range m.sub {
+		k, b := s.entries()
+		keyN += k
+		bucketN += b
+	}
+	return
+}
+
+// dump renders the bucket tree as text, for messages and for Compact comparisons.
+func (m *mbucket) dump(prefix string, sb *strings.Builder) {
+	for _, k := range m.keys() {
+		if s, ok := m.sub[k]; ok {
+			fmt.Fprintf(sb, "%s%q/ seq=%d\n", prefix, k, s.seq)
+			s.dump(prefix+"  ", sb)
+		} else {
+			fmt.Fprintf(sb, "%s%q=%q\n", prefix, k, m.kv[k])
+		}
+	}
+}
+
+// hegelDumpBucket renders a real bucket the same way.
+func hegelDumpBucket(b *bolt.Bucket, prefix string, sb *strings.Builder) {
+	c := b.Cursor()
+	for k, v := c.First(); k != nil; k, v = c.Next() {
+		if v == nil {
+			if s := b.Bucket(k); s != nil {
+				fmt.Fprintf(sb, "%s%q/ seq=%d\n", prefix, k, s.Sequence())
+				hegelDumpBucket(s, prefix+"  ", sb)
+				continue
+			}
+		}
+		fmt.Fprintf(sb, "%s%q=%q\n", prefix, k, v)
+	}
+}
+
+func dumpTx(tx *bolt.Tx) string {
+	var sb strings.Builder
+	tx.ForEach(func(name []byte, b *bolt.Bucket) error {
+		fmt.Fprintf(&sb, "%q/ seq=%d\n", name, b.Sequence())
+		hegelDumpBucket(b, "  ", &sb)
+		return nil
+	})
+	return sb.String()
+}
+
+func dumpModel(root *mbucket) string {
+	var sb strings.Builder
+	root.dump("", &sb)
+	return sb.String()
+}
+
+func sortedNames(m map[string]*mbucket) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+func anyTouched(m *mbucket, touched map[*mbucket]bool) bool {
+	if touched[m] {
+		return true
+	}
+	for _, s := range m.sub {
+		if anyTouched(s, touched) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---- a case as data ------------------------------------------------------------------------
+
+// Keys: mostly one to three characters of a small alphabet (so names collide), sometimes one
+// arbitrary byte or a run of 100-2000 equal letters (keys that spill over pages). Values:
+// empty, up to twelve arbitrary bytes, or a run of 1-20 KB.
+var (
+	shortKeys = hegel.Map(hegel.Text().Alphabet("abcxyz09").MinSize(1).MaxSize(3), func(s string) []byte { return []byte(s) })
+	byteKeys  = hegel.Map(hegel.Integers(0, 255), func(b int) []byte { return []byte{byte(b)} })
+	longKeys  = hegel.Composite(func(tc hegel.TestCase) []byte {
+		return bytes.Repeat([]byte{byte('a' + hegel.Draw(tc, hegel.Integers(0, 5)))}, hegel.Draw(tc, hegel.Integers(100, 2000)))
+	})
+	keyBytes = weighted(choice[[]byte]{90, shortKeys}, choice[[]byte]{5, byteKeys}, choice[[]byte]{5, longKeys})
+
+	bigValues = hegel.Composite(func(tc hegel.TestCase) []byte {
+		return bytes.Repeat([]byte{byte(hegel.Draw(tc, hegel.Integers(0, 255)))}, hegel.Draw(tc, hegel.Integers(1000, 20000)))
+	})
+	valueBytes = weighted(choice[[]byte]{5, hegel.Just([]byte{})}, choice[[]byte]{90, hegel.Binary(0, 12)}, choice[[]byte]{5, bigValues})
+)
+
+// where walks from the root into sub-buckets: each index picks a child modulo the live count,
+// and the walk stops early at a bucket without children. Empty is the root.
+type where []int
+
+// wheres may be the root (where buckets are created and deleted); innerWheres try for a
+// bucket, which they reach as soon as the root has one.
+var (
+	wheres      = hegel.Map(hegel.Lists(hegel.Integers(0, 7)).MaxSize(4), func(is []int) where { return is })
+	innerWheres = hegel.Map(hegel.Lists(hegel.Integers(0, 7)).MinSize(1).MaxSize(4), func(is []int) where { return is })
+)
+
+// site is a resolved where: the model bucket and the real one (nil for the root, whose
+// operations go through tx), the path for messages, and the parent and entry name (the root
+// has none).
+type site struct {
+	m      *mbucket
+	b      *bolt.Bucket
+	path   string
+	parent *mbucket
+	pb     *bolt.Bucket // the parent's real bucket, nil when the parent is the root
+	name   string
+}
+
+// walk resolves the path against the model; avoid, when not nil, is a bucket the walk never
+// enters (a MoveBucket destination is never the moved bucket or one of its descendants).
+func (w where) walk(tx *bolt.Tx, root, avoid *mbucket) site {
+	s := site{m: root}
+	for _, i := range w {
+		var names []string
+		for _, name := range sortedNames(s.m.sub) {
+			if s.m.sub[name] != avoid {
+				names = append(names, name)
+			}
+		}
+		if len(names) == 0 {
+			break
+		}
+		name := names[i%len(names)]
+		var b *bolt.Bucket
+		if s.b == nil {
+			b = tx.Bucket([]byte(name))
+		} else {
+			b = s.b.Bucket([]byte(name))
+		}
+		s = site{m: s.m.sub[name], b: b, path: s.path + "/" + name, parent: s.m, pb: s.b, name: name}
+	}
+	return s
+}
+
+// ref names an entry of a bucket: the idx-th entry (modulo the live count) when existing is
+// set and the bucket has entries, otherwise key.
+type ref struct {
+	existing bool
+	idx      int
+	key      []byte
+}
+
+// refs is a ref that names an existing entry pctExisting percent of the time.
+func refs(pctExisting int) hegel.Generator[ref] {
+	return hegel.Composite(func(tc hegel.TestCase) ref {
+		return ref{
+			existing: hegel.Draw(tc, chance(pctExisting)),
+			idx:      hegel.Draw(tc, hegel.Integers(0, 15)),
+			key:      hegel.Draw(tc, keyBytes),
+		}
+	})
+}
+
+func (r ref) resolve(m *mbucket) []byte {
+	if ks := m.keys(); r.existing && len(ks) > 0 {
+		return []byte(ks[r.idx%len(ks)])
+	}
+	return r.key
+}
+
+func (r ref) String() string {
+	if r.existing {
+		return fmt.Sprintf("entry#%d (else %s)", r.idx, short(r.key))
+	}
+	return short(r.key)
+}
+
+// short abbreviates a long key or value for the draw report.
+func short(b []byte) string {
+	if len(b) > 16 {
+		return fmt.Sprintf("<%d bytes of %q>", len(b), b[:1])
+	}
+	return fmt.Sprintf("%q", b)
+}
+
+// opKind is what a step does.
+type opKind int
+
+const (
+	opRead                    opKind = iota // compare the bucket with the model mid-transaction
+	opPut                                   // Put, or the incompatible-value error on a bucket entry
+	opDelete                                // Delete, or the incompatible-value error on a bucket entry
+	opCreateBucket                          // CreateBucket: exists / incompatible errors
+	opCreateBucketIfNotExists               // CreateBucketIfNotExists: incompatible error
+	opDeleteBucket                          // DeleteBucket: not found / incompatible errors
+	opNextSequence                          // NextSequence
+	opSetSequence                           // SetSequence
+	opMoveBucket                            // MoveBucket of a child to another bucket (legal cases only)
+	opMisuse                                // blank names and an oversized key are refused
+	opCursorDelete                          // Cursor.Delete of some entries while iterating
+)
+
+var opNames = [...]string{"read", "put", "delete", "create-bucket", "create-bucket-if-not-exists", "delete-bucket",
+	"next-sequence", "set-sequence", "move-bucket", "misuse", "cursor-delete"}
+
+func (k opKind) String() string { return opNames[k] }
+
+// op is one step of a transaction; only the fields its kind uses are drawn.
+type op struct {
+	kind  opKind
+	at    where  // the bucket operated on; for MoveBucket the bucket moved
+	name  ref    // Put, Delete, CreateBucket*, DeleteBucket: the entry
+	value []byte // Put
+	seq   uint64 // SetSequence
+	to    where  // MoveBucket: the destination, resolved outside the moved bucket
+	picks []int  // CursorDelete: the positions deleted (modulo the entry count)
+}
+
+func (o op) String() string {
+	s := fmt.Sprintf("%s @%v", o.kind, []int(o.at))
+	switch o.kind {
+	case opPut:
+		s += fmt.Sprintf(" %s = %s", o.name, short(o.value))
+	case opDelete, opCreateBucket, opCreateBucketIfNotExists, opDeleteBucket:
+		s += " " + o.name.String()
+	case opSetSequence:
+		s += fmt.Sprintf(" %d", o.seq)
+	case opMoveBucket:
+		s += fmt.Sprintf(" -> @%v", []int(o.to))
+	case opCursorDelete:
+		s += fmt.Sprintf(" positions %v", o.picks)
+	}
+	return s
+}
+
+// named is an op of the kind on a bucket (the root included) and one of its entries.
+func named(kind opKind, names hegel.Generator[ref]) hegel.Generator[op] {
+	return hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: kind, at: hegel.Draw(tc, wheres), name: hegel.Draw(tc, names)}
+	})
+}
+
+// located is an op of the kind on a bucket alone.
+func located(kind opKind, at hegel.Generator[where]) hegel.Generator[op] {
+	return hegel.Map(at, func(w where) op { return op{kind: kind, at: w} })
+}
+
+var (
+	entryRefs = refs(60) // Put, Delete, DeleteBucket: mostly existing entries
+	newRefs   = refs(40) // CreateBucket*: mostly fresh names
+	puts      = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opPut, at: hegel.Draw(tc, innerWheres), name: hegel.Draw(tc, entryRefs), value: hegel.Draw(tc, valueBytes)}
+	})
+	deletes = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opDelete, at: hegel.Draw(tc, innerWheres), name: hegel.Draw(tc, entryRefs)}
+	})
+	setSequences = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opSetSequence, at: hegel.Draw(tc, innerWheres), seq: uint64(hegel.Draw(tc, hegel.Integers(0, 1<<30)))}
+	})
+	moves = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opMoveBucket, at: hegel.Draw(tc, innerWheres), to: hegel.Draw(tc, wheres)}
+	})
+	cursorDeletes = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opCursorDelete, at: hegel.Draw(tc, innerWheres), picks: hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 15)).MaxSize(6))}
+	})
+	// ops: the read first (it changes nothing), then puts most often.
+	ops = weighted(
+		choice[op]{4, located(opRead, innerWheres)},
+		choice[op]{8, puts},
+		choice[op]{2, deletes},
+		choice[op]{2, named(opCreateBucket, newRefs)},
+		choice[op]{2, named(opCreateBucketIfNotExists, newRefs)},
+		choice[op]{2, named(opDeleteBucket, entryRefs)},
+		choice[op]{1, located(opNextSequence, innerWheres)},
+		choice[op]{1, setSequences},
+		choice[op]{2, moves},
+		choice[op]{2, located(opMisuse, wheres)},
+		choice[op]{2, cursorDeletes},
+	)
+)
+
+// txn is one Update: its steps, whether it rolls back by returning an error, whether the
+// database is closed and reopened after it, and the keys probed (Get, Seek, Bucket) in every
+// bucket compared with the model.
+type txn struct {
+	steps    []op
+	rollback bool
+	reopen   bool
+	probes   [][]byte
+}
+
+var txns = hegel.Composite(func(tc hegel.TestCase) txn {
+	return txn{
+		steps:    hegel.Draw(tc, hegel.Lists(ops).MinSize(1).MaxSize(6)),
+		rollback: hegel.Draw(tc, chance(15)),
+		reopen:   hegel.Draw(tc, chance(15)),
+		probes:   hegel.Draw(tc, hegel.Lists(keyBytes).MinSize(2).MaxSize(4)),
+	}
+})
+
+// script is a case: lo to hi transactions on a fresh database.
+type script []txn
+
+func scripts(lo, hi int) hegel.Generator[script] {
+	return hegel.Map(hegel.Lists(txns).MinSize(lo).MaxSize(hi), func(ts []txn) script { return ts })
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (s script) GoString() string {
+	var sb strings.Builder
+	for i, t := range s {
+		fmt.Fprintf(&sb, "tx %d", i)
+		if t.rollback {
+			sb.WriteString(" (rolled back)")
+		}
+		if t.reopen {
+			sb.WriteString(" (then reopened)")
+		}
+		fmt.Fprintf(&sb, " probes %q\n", t.probes)
+		for _, o := range t.steps {
+			sb.WriteString("  " + o.String() + "\n")
+		}
+	}
+	return sb.String()
+}
+
+// ---- checks --------------------------------------------------------------------------------
+
+// compareBucket checks a real bucket against its model: Get, the cursor both ways, Seek at
+// every model key and at the probes, ForEach, Stats, the sequence.
+func compareBucket(ht *hegel.T, b *bolt.Bucket, m *mbucket, path string, probes [][]byte, readOnly bool) {
+	want := m.keys()
+	// Forward and backward walks.
+	var fwd, bwd []string
+	c := b.Cursor()
+	for k, v := c.First(); k != nil; k, v = c.Next() {
+		fwd = append(fwd, string(k))
+		checkEntry(ht, m, path, k, v)
+	}
+	for k, v := c.Last(); k != nil; k, v = c.Prev() {
+		bwd = append(bwd, string(k))
+		checkEntry(ht, m, path, k, v)
+	}
+	if !slices.Equal(fwd, want) {
+		ht.Fatalf("%s: cursor forward %q, model %q", path, fwd, want)
+	}
+	slices.Reverse(bwd)
+	if !slices.Equal(bwd, want) {
+		ht.Fatalf("%s: cursor backward %q, model %q", path, bwd, want)
+	}
+	// Get of every model key and of the probes.
+	for _, k := range want {
+		checkEntry(ht, m, path, []byte(k), b.Get([]byte(k)))
+	}
+	for _, k := range probes {
+		checkEntry(ht, m, path, k, b.Get(k))
+		// Seek: the smallest key >= k.
+		sk, sv := c.Seek(k)
+		var wantSeek string
+		found := false
+		for _, mk := range want {
+			if mk >= string(k) {
+				wantSeek, found = mk, true
+				break
+			}
+		}
+		if found != (sk != nil) || found && string(sk) != wantSeek {
+			ht.Fatalf("%s: Seek(%q) = %q, model %q (%v)", path, k, sk, wantSeek, found)
+		}
+		if found {
+			checkEntry(ht, m, path, sk, sv)
+		}
+	}
+	// ForEach.
+	var fe []string
+	b.ForEach(func(k, v []byte) error {
+		fe = append(fe, string(k))
+		checkEntry(ht, m, path, k, v)
+		return nil
+	})
+	if !slices.Equal(fe, want) {
+		ht.Fatalf("%s: ForEach %q, model %q", path, fe, want)
+	}
+	// Bucket() of every entry.
+	for _, k := range want {
+		_, isSub := m.sub[k]
+		if (b.Bucket([]byte(k)) != nil) != isSub {
+			ht.Fatalf("%s: Bucket(%q) present %v, model bucket %v", path, k, b.Bucket([]byte(k)) != nil, isSub)
+		}
+	}
+	if b.Sequence() != m.seq {
+		ht.Fatalf("%s: Sequence() = %d, model %d", path, b.Sequence(), m.seq)
+	}
+	if readOnly {
+		st := b.Stats()
+		keyN, bucketN := m.entries()
+		if st.KeyN != keyN || st.BucketN != bucketN {
+			ht.Fatalf("%s: Stats KeyN %d BucketN %d, model %d %d", path, st.KeyN, st.BucketN, keyN, bucketN)
+		}
+	}
+	for _, k := range sortedNames(m.sub) {
+		compareBucket(ht, b.Bucket([]byte(k)), m.sub[k], path+"/"+k, probes, readOnly)
+	}
+}
+
+func checkEntry(ht *hegel.T, m *mbucket, path string, k, v []byte) {
+	if _, ok := m.sub[string(k)]; ok {
+		if v != nil {
+			ht.Fatalf("%s: bucket entry %q has value %q", path, k, v)
+		}
+		return
+	}
+	want, ok := m.kv[string(k)]
+	if !ok {
+		if v != nil {
+			ht.Fatalf("%s: %q = %q, not in the model", path, k, v)
+		}
+		return
+	}
+	if v == nil || !bytes.Equal(v, want) {
+		ht.Fatalf("%s: %q = %q (nil %v), model %q", path, k, v, v == nil, want)
+	}
+}
+
+func compareTx(ht *hegel.T, tx *bolt.Tx, root *mbucket, probes [][]byte, readOnly bool) {
+	var names []string
+	tx.ForEach(func(name []byte, b *bolt.Bucket) error {
+		names = append(names, string(name))
+		return nil
+	})
+	if !slices.Equal(names, sortedNames(root.sub)) {
+		ht.Fatalf("top-level buckets %q, model %q", names, sortedNames(root.sub))
+	}
+	for _, k := range names {
+		compareBucket(ht, tx.Bucket([]byte(k)), root.sub[k], "/"+k, probes, readOnly)
+	}
+	for _, k := range probes {
+		if (tx.Bucket(k) != nil) != (root.sub[string(k)] != nil) {
+			ht.Fatalf("tx.Bucket(%q) present %v, model %v", k, tx.Bucket(k) != nil, root.sub[string(k)] != nil)
+		}
+	}
+}
+
+func checkIntegrity(ht *hegel.T, db *bolt.DB, what string) {
+	var errs []string
+	db.View(func(tx *bolt.Tx) error {
+		for e := range tx.Check() {
+			errs = append(errs, e.Error())
+		}
+		return nil
+	})
+	if len(errs) > 0 {
+		ht.Fatalf("tx.Check() after %s: %s", what, strings.Join(errs, "; "))
+	}
+}
+
+func openDB(t testing.TB, dir string, id int) *bolt.DB {
+	db, err := bolt.Open(filepath.Join(dir, fmt.Sprintf("db%d.bolt", id)), 0o600, &bolt.Options{NoSync: true})
+	if err != nil {
+		t.Fatalf("Open: %v", err)
+	}
+	return db
+}
+
+// ---- applying a script ---------------------------------------------------------------------
+
+var errRollback = errors.New("roll back on purpose")
+
+// apply performs the step inside a writable transaction, applying it to the model and
+// checking the immediate result. touched records the buckets modified in this transaction
+// (bbolt/1: a moved bucket must not have been changed earlier in the same transaction).
+//
+// A step whose data does not fit the live state (an operation that needs a bucket landing on
+// the root, a move of the root, into the moved bucket's own parent or onto a clashing name)
+// does nothing: it is a no-op of the script, not a rejection of the case, since the
+// conditions depend on the live state and would otherwise reject most scripts.
+func (o op) apply(ht *hegel.T, tx *bolt.Tx, root *mbucket, touched map[*mbucket]bool, probes [][]byte) {
+	at := o.at.walk(tx, root, nil)
+	m, b, path := at.m, at.b, at.path
+	switch o.kind {
+	case opRead:
+		if b != nil {
+			compareBucket(ht, b, m, path, probes, false)
+		}
+	case opPut:
+		if b == nil {
+			return
+		}
+		k, v := o.name.resolve(m), o.value
+		err := b.Put(k, v)
+		if _, isSub := m.sub[string(k)]; isSub {
+			if !errors.Is(err, berrors.ErrIncompatibleValue) {
+				ht.Fatalf("%s: Put on bucket entry %q: %v", path, k, err)
+			}
+			return
+		}
+		if err != nil {
+			ht.Fatalf("%s: Put(%q, %d bytes): %v", path, k, len(v), err)
+		}
+		m.kv[string(k)] = append([]byte(nil), v...)
+		touched[m] = true
+		if got := b.Get(k); !bytes.Equal(got, v) || got == nil {
+			ht.Fatalf("%s: Get after Put(%q) = %q, want %q", path, k, got, v)
+		}
+	case opDelete:
+		if b == nil {
+			return
+		}
+		k := o.name.resolve(m)
+		err := b.Delete(k)
+		if _, isSub := m.sub[string(k)]; isSub {
+			if !errors.Is(err, berrors.ErrIncompatibleValue) {
+				ht.Fatalf("%s: Delete of bucket entry %q: %v", path, k, err)
+			}
+			return
+		}
+		if err != nil {
+			ht.Fatalf("%s: Delete(%q): %v", path, k, err)
+		}
+		delete(m.kv, string(k))
+		touched[m] = true
+		if got := b.Get(k); got != nil {
+			ht.Fatalf("%s: Get after Delete(%q) = %q", path, k, got)
+		}
+	case opCreateBucket, opCreateBucketIfNotExists:
+		k := o.name.resolve(m)
+		strict := o.kind == opCreateBucket
+		create := func() (*bolt.Bucket, error) {
+			switch {
+			case b == nil && strict:
+				return tx.CreateBucket(k)
+			case b == nil:
+				return tx.CreateBucketIfNotExists(k)
+			case strict:
+				return b.CreateBucket(k)
+			default:
+				return b.CreateBucketIfNotExists(k)
+			}
+		}
+		nb, err := create()
+		_, isSub := m.sub[string(k)]
+		_, isKey := m.kv[string(k)]
+		switch {
+		case isKey:
+			if !errors.Is(err, berrors.ErrIncompatibleValue) {
+				ht.Fatalf("%s: CreateBucket(%q) over a key: %v", path, k, err)
+			}
+		case isSub && strict:
+			if !errors.Is(err, berrors.ErrBucketExists) {
+				ht.Fatalf("%s: CreateBucket(%q) twice: %v", path, k, err)
+			}
+		case isSub:
+			if err != nil || nb == nil {
+				ht.Fatalf("%s: CreateBucketIfNotExists(%q) existing: %v", path, k, err)
+			}
+		default:
+			if err != nil || nb == nil {
+				ht.Fatalf("%s: CreateBucket(%q): %v", path, k, err)
+			}
+			m.sub[string(k)] = newMB()
+			touched[m] = true
+			if b != nil && b.Get(k) != nil {
+				ht.Fatalf("%s: Get(%q) of a new bucket is not nil", path, k)
+			}
+		}
+	case opDeleteBucket:
+		k := o.name.resolve(m)
+		var err error
+		if b == nil {
+			err = tx.DeleteBucket(k)
+		} else {
+			err = b.DeleteBucket(k)
+		}
+		_, isSub := m.sub[string(k)]
+		_, isKey := m.kv[string(k)]
+		switch {
+		case isSub:
+			if err != nil {
+				ht.Fatalf("%s: DeleteBucket(%q): %v", path, k, err)
+			}
+			delete(m.sub, string(k))
+			touched[m] = true
+		case isKey:
+			if !errors.Is(err, berrors.ErrIncompatibleValue) {
+				ht.Fatalf("%s: DeleteBucket(%q) of a key: %v", path, k, err)
+			}
+		default:
+			if !errors.Is(err, berrors.ErrBucketNotFound) {
+				ht.Fatalf("%s: DeleteBucket(%q) missing: %v", path, k, err)
+			}
+		}
+	case opNextSequence:
+		if b == nil {
+			return
+		}
+		got, err := b.NextSequence()
+		if err != nil || got != m.seq+1 {
+			ht.Fatalf("%s: NextSequence = %d, %v; model %d", path, got, err, m.seq+1)
+		}
+		m.seq++
+		touched[m] = true
+	case opSetSequence:
+		if b == nil {
+			return
+		}
+		if err := b.SetSequence(o.seq); err != nil {
+			ht.Fatalf("%s: SetSequence: %v", path, err)
+		}
+		m.seq = o.seq
+		touched[m] = true
+	case opMoveBucket: // legal cases only: the moved bucket untouched in this transaction
+		// (bbolt/1), the destination outside it (bbolt/2, by construction of the walk) and
+		// not its parent (ErrSameBuckets), the name free there
+		if at.parent == nil {
+			return // the root
+		}
+		moved, k := m, at.name
+		if anyTouched(moved, touched) {
+			return
+		}
+		dst := o.to.walk(tx, root, moved)
+		if dst.m == at.parent {
+			return
+		}
+		if _, clash := dst.m.kv[k]; clash {
+			return
+		}
+		if _, clash := dst.m.sub[k]; clash {
+			return
+		}
+		var err error
+		switch {
+		case at.pb == nil:
+			err = tx.MoveBucket([]byte(k), nil, dst.b)
+		case dst.b == nil:
+			err = tx.MoveBucket([]byte(k), at.pb, nil)
+		default:
+			err = at.pb.MoveBucket([]byte(k), dst.b)
+		}
+		if err != nil {
+			ht.Fatalf("MoveBucket(%q) from %s to %s: %v", k, at.path, dst.path, err)
+		}
+		delete(at.parent.sub, k)
+		dst.m.sub[k] = moved
+		touched[at.parent], touched[dst.m] = true, true
+	case opMisuse: // errors on blank names and an oversized key
+		if b != nil {
+			if err := b.Put(nil, []byte("x")); !errors.Is(err, berrors.ErrKeyRequired) {
+				ht.Fatalf("%s: Put(nil): %v", path, err)
+			}
+			if err := b.Put(make([]byte, bolt.MaxKeySize+1), nil); !errors.Is(err, berrors.ErrKeyTooLarge) {
+				ht.Fatalf("%s: Put(too large key): %v", path, err)
+			}
+		}
+		var err error
+		if b == nil {
+			_, err = tx.CreateBucket(nil)
+		} else {
+			_, err = b.CreateBucket([]byte{})
+		}
+		if !errors.Is(err, berrors.ErrBucketNameRequired) {
+			ht.Fatalf("%s: CreateBucket(blank): %v", path, err)
+		}
+	case opCursorDelete: // cursor deletes of the picked positions
+		if b == nil {
+			return
+		}
+		total := len(m.keys())
+		chosen := map[int]bool{}
+		for _, p := range o.picks {
+			if total > 0 {
+				chosen[p%total] = true
+			}
+		}
+		c := b.Cursor()
+		var del []string
+		i := 0
+		for k, _ := c.First(); k != nil; k, _ = c.Next() {
+			pos := i
+			i++
+			if _, isSub := m.sub[string(k)]; isSub {
+				if err := c.Delete(); !errors.Is(err, berrors.ErrIncompatibleValue) {
+					ht.Fatalf("%s: Cursor.Delete on bucket %q: %v", path, k, err)
+				}
+				continue
+			}
+			if chosen[pos] {
+				if err := c.Delete(); err != nil {
+					ht.Fatalf("%s: Cursor.Delete(%q): %v", path, k, err)
+				}
+				del = append(del, string(k))
+			}
+		}
+		for _, k := range del {
+			delete(m.kv, k)
+		}
+		if len(del) > 0 {
+			touched[m] = true
+		}
+	}
+}
+
+// drive applies the script to a fresh model and the database and returns the model. After
+// every transaction tx.Check() is clean and a read-only transaction sees exactly the model.
+func drive(ht *hegel.T, db **bolt.DB, s script) *mbucket {
+	root := newMB()
+	for i, t := range s {
+		before := root.clone()
+		touched := map[*mbucket]bool{}
+		err := (*db).Update(func(tx *bolt.Tx) error {
+			for _, o := range t.steps {
+				o.apply(ht, tx, root, touched, t.probes)
+			}
+			compareTx(ht, tx, root, t.probes, false)
+			if t.rollback {
+				return errRollback
+			}
+			return nil
+		})
+		if t.rollback {
+			if !errors.Is(err, errRollback) {
+				ht.Fatalf("Update returning an error: %v", err)
+			}
+			root = before
+		} else if err != nil {
+			ht.Fatalf("Update: %v", err)
+		}
+		checkIntegrity(ht, *db, fmt.Sprintf("transaction %d", i))
+		if t.reopen {
+			path := (*db).Path()
+			if err := (*db).Close(); err != nil {
+				ht.Fatalf("Close: %v", err)
+			}
+			var err error
+			*db, err = bolt.Open(path, 0o600, &bolt.Options{NoSync: true})
+			if err != nil {
+				ht.Fatalf("reopen: %v", err)
+			}
+		}
+		(*db).View(func(tx *bolt.Tx) error {
+			compareTx(ht, tx, root, t.probes, true)
+			return nil
+		})
+	}
+	return root
+}
