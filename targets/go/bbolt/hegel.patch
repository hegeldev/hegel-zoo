+// TestHegelCompactAndCopyPreserveContents: after random transactions, bolt.Compact into a
+// fresh file and tx.WriteTo into another give databases with exactly the model's contents
+// (and clean tx.Check()).
+func TestHegelCompactAndCopyPreserveContents(t *testing.T) {
+	dir := t.TempDir()
+	id := 0
+	property(t, func(ht *hegel.T) {
+		id += 2
+		db := openDB(t, dir, id)
+		defer func() {
+			db.Close()
+			os.Remove(db.Path())
+		}()
+		s := hegel.Draw(ht, scripts(1, 5))
+		txMaxSize := hegel.Draw(ht, hegel.Integers(0, 1<<20))
+		root := drive(ht, &db, s)
+		want := dumpModel(root)
+		ht.Note("model:\n" + want)
+
+		dst := openDB(t, dir, id+1)
+		defer func() {
+			dst.Close()
+			os.Remove(dst.Path())
+		}()
+		if err := bolt.Compact(dst, db, int64(txMaxSize)); err != nil {
+			ht.Fatalf("Compact: %v", err)
+		}
+		checkIntegrity(ht, dst, "Compact")
+		dst.View(func(tx *bolt.Tx) error {
+			if got := dumpTx(tx); got != want {
+				ht.Fatalf("Compact gave\n%s\nwant\n%s", got, want)
+			}
+			return nil
+		})
+
+		copyPath := filepath.Join(dir, fmt.Sprintf("copy%d.bolt", id))
+		if err := db.View(func(tx *bolt.Tx) error { return tx.CopyFile(copyPath, 0o600) }); err != nil {
+			ht.Fatalf("CopyFile: %v", err)
+		}
+		cp, err := bolt.Open(copyPath, 0o600, &bolt.Options{NoSync: true, ReadOnly: true})
+		if err != nil {
+			ht.Fatalf("Open(copy): %v", err)
+		}
+		defer func() {
+			cp.Close()
+			os.Remove(copyPath)
+		}()
+		checkIntegrity(ht, cp, "CopyFile")
+		cp.View(func(tx *bolt.Tx) error {
+			if got := dumpTx(tx); got != want {
+				ht.Fatalf("CopyFile gave\n%s\nwant\n%s", got, want)
+			}
+			return nil
+		})
+	})
+}
