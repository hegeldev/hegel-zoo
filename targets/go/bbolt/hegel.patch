+// ---- pinned bugs: one plain test per recorded bug ------------------------------------------
+
+// bbolt/1: MoveBucket copies the sub-bucket's header from the parent page and drops the
+// bucket from the parent's in-memory children, so changes made to the sub-bucket earlier in
+// the same transaction (Put, Delete, nested CreateBucket) are lost after the move. Both a
+// bucket committed earlier and one created in the same transaction lose the change.
+func TestHegelMoveBucketKeepsChangesMadeInTheSameTransaction(t *testing.T) {
+	dir := t.TempDir()
+	for id, preexisting := range []bool{false, true} {
+		db := openDB(t, dir, id)
+		defer db.Close()
+		if preexisting {
+			if err := db.Update(func(tx *bolt.Tx) error {
+				a, _ := tx.CreateBucket([]byte("a"))
+				sub, err := a.CreateBucket([]byte("sub"))
+				if err != nil {
+					return err
+				}
+				tx.CreateBucket([]byte("dst"))
+				return sub.Put([]byte("old"), []byte("1"))
+			}); err != nil {
+				t.Fatalf("setup: %v", err)
+			}
+		}
+		err := db.Update(func(tx *bolt.Tx) error {
+			a, _ := tx.CreateBucketIfNotExists([]byte("a"))
+			dst, _ := tx.CreateBucketIfNotExists([]byte("dst"))
+			sub, err := a.CreateBucketIfNotExists([]byte("sub"))
+			if err != nil {
+				return err
+			}
+			if err := sub.Put([]byte("new"), []byte("2")); err != nil {
+				return err
+			}
+			return a.MoveBucket([]byte("sub"), dst)
+		})
+		if err != nil {
+			t.Fatalf("Update: %v", err)
+		}
+		db.View(func(tx *bolt.Tx) error {
+			sub := tx.Bucket([]byte("dst")).Bucket([]byte("sub"))
+			if sub == nil {
+				t.Errorf("dst/sub missing after the move (pre-existing bucket: %v)", preexisting)
+				return nil
+			}
+			if got := sub.Get([]byte("new")); !bytes.Equal(got, []byte("2")) {
+				t.Errorf("dst/sub/new = %q after MoveBucket (pre-existing bucket: %v), want \"2\"", got, preexisting)
+			}
+			return nil
+		})
+	}
+}
+
+// bbolt/2: MoveBucket into the moved bucket itself or into one of its descendants succeeds
+// and the bucket vanishes; with a descendant target tx.Check() then reports unreachable pages.
+func TestHegelMoveBucketRefusesCycles(t *testing.T) {
+	dir := t.TempDir()
+	for id, intoSelf := range []bool{false, true} {
+		db := openDB(t, dir, id)
+		defer db.Close()
+		if err := db.Update(func(tx *bolt.Tx) error {
+			a, _ := tx.CreateBucket([]byte("a"))
+			b, err := a.CreateBucket([]byte("b"))
+			if err != nil {
+				return err
+			}
+			b.Put([]byte("k"), []byte("v"))
+			return a.Put([]byte("x"), []byte("y"))
+		}); err != nil {
+			t.Fatalf("setup: %v", err)
+		}
+		err := db.Update(func(tx *bolt.Tx) error {
+			a := tx.Bucket([]byte("a"))
+			dst := a
+			if !intoSelf {
+				dst = a.Bucket([]byte("b"))
+			}
+			return tx.MoveBucket([]byte("a"), nil, dst)
+		})
+		if err == nil {
+			var errs []string
+			db.View(func(tx *bolt.Tx) error {
+				for e := range tx.Check() {
+					errs = append(errs, e.Error())
+				}
+				return nil
+			})
+			t.Errorf("MoveBucket of \"a\" into %s succeeded; buckets now %q; tx.Check(): %v", map[bool]string{true: "itself", false: "its child a/b"}[intoSelf], topLevel(db), errs)
+		}
+	}
+}
+
+func topLevel(db *bolt.DB) []string {
+	var names []string
+	db.View(func(tx *bolt.Tx) error {
+		return tx.ForEach(func(name []byte, _ *bolt.Bucket) error {
+			names = append(names, string(name))
+			return nil
+		})
+	})
+	return names
+}
