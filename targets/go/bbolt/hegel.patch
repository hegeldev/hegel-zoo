+// ---- the properties ------------------------------------------------------------------------
+
+// TestHegelDatabaseFollowsTheModel: puts, deletes, nested buckets (create, delete, move),
+// sequences, cursor deletes, rollbacks and reopens against the model; after every commit
+// tx.Check() is clean and a read-only transaction sees exactly the model (cursor both ways,
+// Get, Seek, ForEach, Bucket, Sequence, Stats).
+func TestHegelDatabaseFollowsTheModel(t *testing.T) {
+	dir := t.TempDir()
+	id := 0
+	property(t, func(ht *hegel.T) {
+		id++
+		db := openDB(t, dir, id)
+		defer func() {
+			db.Close()
+			os.Remove(db.Path())
+		}()
+		root := drive(ht, &db, hegel.Draw(ht, scripts(1, 8)))
+		ht.Note("final model:\n" + dumpModel(root))
+		// Read-only transactions refuse writes.
+		db.View(func(tx *bolt.Tx) error {
+			if _, err := tx.CreateBucket([]byte("ro")); !errors.Is(err, berrors.ErrTxNotWritable) {
+				ht.Fatalf("CreateBucket in View: %v", err)
+			}
+			for _, name := range sortedNames(root.sub) {
+				b := tx.Bucket([]byte(name))
+				if err := b.Put([]byte("k"), nil); !errors.Is(err, berrors.ErrTxNotWritable) {
+					ht.Fatalf("Put in View: %v", err)
+				}
+				if err := b.Delete([]byte("k")); !errors.Is(err, berrors.ErrTxNotWritable) {
+					ht.Fatalf("Delete in View: %v", err)
+				}
+				if _, err := b.NextSequence(); !errors.Is(err, berrors.ErrTxNotWritable) {
+					ht.Fatalf("NextSequence in View: %v", err)
+				}
+				if err := tx.DeleteBucket([]byte(name)); !errors.Is(err, berrors.ErrTxNotWritable) {
+					ht.Fatalf("DeleteBucket in View: %v", err)
+				}
+			}
+			return nil
+		})
+	})
+}
