+package pflag_test
+
+// 2. The documented grammar: the README's "Command line flag syntax" section
+// plus the doc comments of the unknown-flag handling modes. A case is the
+// flags (a spec each), the mode and interspersed switches, and a list of
+// token records rendered into a command line by a pure function of the
+// flags and the mode; modelParse is the grammar.
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+type gKind int
+
+const (
+	gBool gKind = iota
+	gCount
+	gString
+	gInt
+	gSlice
+	gArray
+	gOptString
+	gOptInt
+)
+
+var gKinds = []gKind{gBool, gCount, gString, gInt, gSlice, gArray, gOptString, gOptInt}
+
+var gKindNames = []string{"bool", "count", "string", "int", "stringSlice", "stringArray", "string[=opt]", "int[=42]"}
+
+// gNoOpt is the no-option default of a kind ("" for value-taking flags).
+var gNoOpt = map[gKind]string{gBool: "true", gCount: "+1", gOptString: "opt", gOptInt: "42"}
+
+type gFlag struct {
+	name  string
+	short byte // 0 for none
+	kind  gKind
+	noOpt string // "" for value-taking flags
+}
+
+func (f gFlag) String() string {
+	s := "--" + f.name
+	if f.short != 0 {
+		s += "/-" + string(f.short)
+	}
+	return s + ":" + gKindNames[f.kind]
+}
+
+// gSpec is a flag as drawn: a name slot, a shorthand slot three times in
+// four (a letter of shortPool, assigned modulo the unused ones) and a kind.
+type gSpec struct {
+	slot  int
+	short *int
+	kind  gKind
+}
+
+var gSpecs = hegel.Composite(func(tc hegel.TestCase) gSpec {
+	return gSpec{slot: hegel.Draw(tc, positions), short: hegel.Draw(tc, optional(75, positions)), kind: hegel.Draw(tc, hegel.SampledFrom(gKinds))}
+})
+
+var shortPool = strings.Split("abcdefgh", "")
+
+// gFlagsOf names the specs and assigns their shorthands: distinct by
+// construction.
+func gFlagsOf(specs []gSpec) []gFlag {
+	slots := make([]int, len(specs))
+	var shortSlots []int
+	for i, s := range specs {
+		slots[i] = s.slot
+		if s.short != nil {
+			shortSlots = append(shortSlots, *s.short)
+		}
+	}
+	names, shorts := assign(flagNames, slots), assign(shortPool, shortSlots)
+	out := make([]gFlag, len(specs))
+	k := 0
+	for i, s := range specs {
+		f := gFlag{name: names[i], kind: s.kind, noOpt: gNoOpt[s.kind]}
+		if s.short != nil {
+			f.short = shorts[k][0]
+			k++
+		}
+		out[i] = f
+	}
+	return out
+}
+
+type gBound struct {
+	b  *bool
+	i  *int
+	s  *string
+	ss *[]string
+}
+
+type gState struct {
+	changed bool
+	b       bool
+	i       int
+	s       string
+	ss      []string
+}
+
+func (st gState) value(k gKind) any {
+	switch k {
+	case gBool:
+		return st.b
+	case gCount, gInt, gOptInt:
+		return st.i
+	case gString, gOptString:
+		return st.s
+	default:
+		return argsOf(st.ss)
+	}
+}
+
+func (b gBound) value(k gKind) any {
+	switch k {
+	case gBool:
+		return *b.b
+	case gCount, gInt, gOptInt:
+		return *b.i
+	case gString, gOptString:
+		return *b.s
+	default:
+		return argsOf(*b.ss)
+	}
+}
+
+func defineG(fs *pflag.FlagSet, f gFlag) gBound {
+	short := ""
+	if f.short != 0 {
+		short = string(f.short)
+	}
+	var b gBound
+	switch f.kind {
+	case gBool:
+		b.b = fs.BoolP(f.name, short, false, "u")
+	case gCount:
+		b.i = fs.CountP(f.name, short, "u")
+	case gString:
+		b.s = fs.StringP(f.name, short, "", "u")
+	case gInt:
+		b.i = fs.IntP(f.name, short, 0, "u")
+	case gSlice:
+		b.ss = fs.StringSliceP(f.name, short, nil, "u")
+	case gArray:
+		b.ss = fs.StringArrayP(f.name, short, nil, "u")
+	case gOptString:
+		b.s = fs.StringP(f.name, short, "", "u")
+		fs.Lookup(f.name).NoOptDefVal = f.noOpt
+	default:
+		b.i = fs.IntP(f.name, short, 0, "u")
+		fs.Lookup(f.name).NoOptDefVal = f.noOpt
+	}
+	return b
+}
+
+var gValues = []string{"1", "0", "-2", "0x10", "true", "false", "t", "yes", "", "a,b", `"a,b",c`, `a"b`, "+1", "3x", "1_0", "-", "x=y", "é"}
+
+type modelErr int
+
+const (
+	errNone modelErr = iota
+	errHelp
+	errUnknown
+	errValueRequired
+	errInvalidValue
+	errSyntax
+)
+
+var modelErrNames = []string{"ok", "help", "unknown flag", "value required", "invalid value", "invalid syntax"}
+
+func classify(err error) modelErr {
+	var (
+		ne *pflag.NotExistError
+		vr *pflag.ValueRequiredError
+		iv *pflag.InvalidValueError
+		is *pflag.InvalidSyntaxError
+	)
+	switch {
+	case err == nil:
+		return errNone
+	case errors.Is(err, pflag.ErrHelp):
+		return errHelp
+	case errors.As(err, &ne):
+		return errUnknown
+	case errors.As(err, &vr):
+		return errValueRequired
+	case errors.As(err, &iv):
+		return errInvalidValue
+	case errors.As(err, &is):
+		return errSyntax
+	}
+	return -1
+}
+
+type gMode int
+
+const (
+	modeError gMode = iota
+	modeIgnore
+	modePass
+)
+
+var gModes = []gMode{modeError, modeIgnore, modePass}
+
+var gModeNames = []string{"error", "ignore", "pass"}
+
+// Tokens -------------------------------------------------------------------
+
+type gTokKind int
+
+const (
+	tokPositional  gTokKind = iota
+	tokLong                 // a known flag, long form
+	tokBundle               // a shorthand bundle
+	tokUnknownLong          // --nope
+	tokOdd                  // --help and syntax errors
+	tokTerminator           // -- and what follows
+)
+
+// gLetter is one letter of a bundle: an unknown shorthand (x, y or h, the
+// pick-th) once in twelve, else the pick-th known shorthand, modulo their
+// number.
+type gLetter struct {
+	unknown bool
+	pick    int
+}
+
+var unknownShorts = []byte("xyh")
+
+// gTok is one token of a command line; which fields matter depends on kind.
+type gTok struct {
+	kind    gTokKind
+	form    int       // long and unknown long: 0 --name, 1 --name=value, 2 --name value; bundle: 0 bare, 1 =value, 2 glued value, 3 separate value
+	flag    int       // long: the flag, modulo their number
+	letters []gLetter // bundle: one to three
+	value   string
+	text    string   // positional, odd
+	tail    []string // terminator
+}
+
+// oddPool: --help and the syntax errors: a third dash, an empty name, and a
+// known-looking name with a trailing dash.
+var oddPool = func() []string {
+	out := []string{"--help", "---x", "--=v"}
+	for _, name := range flagNames {
+		out = append(out, "--"+name+"-")
+	}
+	return out
+}()
+
+var (
+	gValue      = hegel.SampledFrom(gValues)
+	gPositional = hegel.Map(hegel.SampledFrom(positionalPool), func(s string) gTok { return gTok{kind: tokPositional, text: s} })
+	gLong       = hegel.Composite(func(tc hegel.TestCase) gTok {
+		return gTok{kind: tokLong, form: hegel.Draw(tc, hegel.Integers(0, 2)), flag: hegel.Draw(tc, positions), value: hegel.Draw(tc, gValue)}
+	})
+	gLetters = hegel.Composite(func(tc hegel.TestCase) gLetter {
+		return gLetter{unknown: hegel.Draw(tc, chance(8)), pick: hegel.Draw(tc, positions)}
+	})
+	gBundle = hegel.Composite(func(tc hegel.TestCase) gTok {
+		return gTok{kind: tokBundle, letters: hegel.Draw(tc, many(gLetters, 1, 3)), form: hegel.Draw(tc, hegel.Integers(0, 3)), value: hegel.Draw(tc, gValue)}
+	})
+	gUnknownLong = hegel.Composite(func(tc hegel.TestCase) gTok {
+		return gTok{kind: tokUnknownLong, form: hegel.Draw(tc, hegel.Integers(0, 2)), value: hegel.Draw(tc, gValue)}
+	})
+	gOdd        = hegel.Map(hegel.SampledFrom(oddPool), func(s string) gTok { return gTok{kind: tokOdd, text: s} })
+	gTerminator = hegel.Map(many(hegel.SampledFrom(tailPool), 0, 2), func(tail []string) gTok { return gTok{kind: tokTerminator, tail: tail} })
+	// gToks: the tokens by weight, the plain positional first.
+	gToks = weighted(
+		choice[gTok]{17, gPositional},
+		choice[gTok]{30, gLong},
+		choice[gTok]{35, gBundle},
+		choice[gTok]{8, gUnknownLong},
+		choice[gTok]{3, gOdd},
+		choice[gTok]{7, gTerminator},
+	)
+)
+
+// render appends the token's arguments. A bundle when no flag has a
+// shorthand is a no-op. In ignore mode an unknown shorthand is only ever the
+// last letter of a bundle (a letter after it would take its value from the
+// original argument list, which the README does not describe), and glued
+// text follows only a letter that consumes it (otherwise it would be read as
+// more shorthands, and an unknown one there strips an argument the README
+// says nothing about).
+func (t gTok) render(argv []string, flags []gFlag, mode gMode) []string {
+	switch t.kind {
+	case tokPositional, tokOdd:
+		return append(argv, t.text)
+	case tokTerminator:
+		return append(append(argv, "--"), t.tail...)
+	case tokUnknownLong:
+		switch t.form {
+		case 0:
+			return append(argv, "--nope")
+		case 1:
+			return append(argv, "--nope="+t.value)
+		default:
+			return append(argv, "--nope", t.value)
+		}
+	case tokLong:
+		f := flags[t.flag%len(flags)]
+		switch t.form {
+		case 0:
+			return append(argv, "--"+f.name)
+		case 1:
+			return append(argv, "--"+f.name+"="+t.value)
+		default:
+			return append(argv, "--"+f.name, t.value)
+		}
+	}
+	// a shorthand bundle
+	var shorts []byte
+	takesValue := map[byte]bool{}
+	for _, f := range flags {
+		if f.short != 0 {
+			shorts = append(shorts, f.short)
+			takesValue[f.short] = f.noOpt == ""
+		}
+	}
+	if len(shorts) == 0 {
+		return argv
+	}
+	var b strings.Builder
+	b.WriteByte('-')
+	unknownLast := false
+	for _, l := range t.letters {
+		if l.unknown {
+			b.WriteByte(unknownShorts[l.pick%len(unknownShorts)])
+			if mode == modeIgnore {
+				unknownLast = true
+				break
+			}
+			continue
+		}
+		b.WriteByte(shorts[l.pick%len(shorts)])
+	}
+	form := t.form
+	if mode == modeIgnore && form == 2 {
+		last := b.String()[b.Len()-1]
+		if unknownLast || !takesValue[last] {
+			form = 0
+		}
+	}
+	switch form {
+	case 0:
+		return append(argv, b.String())
+	case 1:
+		return append(argv, b.String()+"="+t.value)
+	case 2:
+		return append(argv, b.String()+t.value)
+	default:
+		return append(argv, b.String(), t.value)
+	}
+}
+
+// gCase: one to five flags, a mode (and, in ignore mode, which of its two
+// spellings), interspersed seven times in ten, and up to six tokens.
+type gCase struct {
+	specs        []gSpec
+	mode         gMode
+	allowlist    bool // ignore mode through ParseErrorsAllowlist.UnknownFlags rather than UnknownFlagsHandling
+	interspersed bool
+	toks         []gTok
+}
+
+var gCases = hegel.Composite(func(tc hegel.TestCase) gCase {
+	return gCase{
+		specs:        hegel.Draw(tc, many(gSpecs, 1, 5)),
+		mode:         hegel.Draw(tc, hegel.SampledFrom(gModes)),
+		allowlist:    hegel.Draw(tc, chance(50)),
+		interspersed: hegel.Draw(tc, chance(70)),
+		toks:         hegel.Draw(tc, many(gToks, 0, 6)),
+	}
+})
+
+func (c gCase) flags() []gFlag { return gFlagsOf(c.specs) }
+
+func (c gCase) argv() []string {
+	flags := c.flags()
+	var argv []string
+	for _, t := range c.toks {
+		argv = t.render(argv, flags, c.mode)
+	}
+	return argv
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c gCase) GoString() string {
+	return fmt.Sprintf("flags %v mode=%s interspersed=%v argv=%q", c.flags(), gModeNames[c.mode], c.interspersed, c.argv())
+}
+
+// The model -----------------------------------------------------------------
+
+type gResult struct {
+	err    modelErr
+	args   []string
+	atDash int
+	states []gState
+}
+
+func (r gResult) String() string {
+	if r.err != errNone {
+		return modelErrNames[r.err]
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "args=%q atDash=%d", r.args, r.atDash)
+	for _, st := range r.states {
+		fmt.Fprintf(&b, " {changed=%v b=%v i=%d s=%q ss=%q}", st.changed, st.b, st.i, st.s, st.ss)
+	}
+	return b.String()
+}
+
+func readAsCSV(val string) ([]string, error) {
+	if val == "" {
+		return []string{}, nil
+	}
+	return csv.NewReader(strings.NewReader(val)).Read()
+}
+
+// modelParse is the README's grammar (plus the unknown-flag handling modes as
+// their doc comments describe them).
+func modelParse(flags []gFlag, argv []string, interspersed bool, mode gMode) gResult {
+	states := make([]gState, len(flags))
+	res := gResult{args: []string{}, atDash: -1}
+	byName := map[string]int{}
+	byShort := map[byte]int{}
+	for i, f := range flags {
+		byName[f.name] = i
+		if f.short != 0 {
+			byShort[f.short] = i
+		}
+	}
+	apply := func(i int, value string) modelErr {
+		f := flags[i]
+		st := &states[i]
+		switch f.kind {
+		case gBool:
+			v, err := strconv.ParseBool(value)
+			if err != nil {
+				return errInvalidValue
+			}
+			st.b = v
+		case gCount:
+			if value == "+1" {
+				st.i++
+			} else {
+				v, err := strconv.ParseInt(value, 0, 0)
+				if err != nil {
+					return errInvalidValue
+				}
+				st.i = int(v)
+			}
+		case gInt, gOptInt:
+			v, err := strconv.ParseInt(value, 0, 64)
+			if err != nil {
+				return errInvalidValue
+			}
+			st.i = int(v)
+		case gString, gOptString:
+			st.s = value
+		case gSlice:
+			v, err := readAsCSV(value)
+			if err != nil {
+				return errInvalidValue
+			}
+			if !st.changed {
+				st.ss = v
+			} else {
+				st.ss = append(st.ss, v...)
+			}
+		default:
+			if !st.changed {
+				st.ss = []string{value}
+			} else {
+				st.ss = append(st.ss, value)
+			}
+		}
+		st.changed = true
+		return errNone
+	}
+	// stripValue drops the argument an unknown flag would have taken.
+	stripValue := func(i int) int {
+		if i < len(argv) && !strings.HasPrefix(argv[i], "-") {
+			return i + 1
+		}
+		return i
+	}
+	fin := func(e modelErr) gResult {
+		res.err = e
+		res.states = states
+		return res
+	}
+	for i := 0; i < len(argv); {
+		s := argv[i]
+		i++
+		if s == "" || s[0] != '-' || s == "-" {
+			res.args = append(res.args, s)
+			if !interspersed {
+				res.args = append(res.args, argv[i:]...)
+				return fin(errNone)
+			}
+			continue
+		}
+		if s == "--" {
+			res.atDash = len(res.args)
+			res.args = append(res.args, argv[i:]...)
+			return fin(errNone)
+		}
+		if strings.HasPrefix(s, "--") {
+			name := s[2:]
+			if name[0] == '-' || name[0] == '=' {
+				return fin(errSyntax)
+			}
+			name, val, hasVal := strings.Cut(name, "=")
+			fi, ok := byName[name]
+			if !ok {
+				if name == "help" {
+					return fin(errHelp)
+				}
+				switch mode {
+				case modeIgnore:
+					if !hasVal {
+						i = stripValue(i)
+					}
+					continue
+				case modePass:
+					res.args = append(res.args, s)
+					continue
+				default:
+					return fin(errUnknown)
+				}
+			}
+			var value string
+			switch {
+			case hasVal:
+				value = val
+			case flags[fi].noOpt != "":
+				value = flags[fi].noOpt
+			case i < len(argv):
+				value = argv[i]
+				i++
+			default:
+				return fin(errValueRequired)
+			}
+			if e := apply(fi, value); e != errNone {
+				return fin(e)
+			}
+			continue
+		}
+		// a shorthand bundle
+		sh := s[1:]
+		passed := ""
+		for sh != "" {
+			c := sh[0]
+			fi, ok := byShort[c]
+			if !ok {
+				if c == 'h' {
+					return fin(errHelp)
+				}
+				switch mode {
+				case modeIgnore:
+					if len(sh) > 2 && sh[1] == '=' {
+						sh = ""
+					} else {
+						i = stripValue(i)
+						sh = sh[1:]
+					}
+					continue
+				case modePass:
+					if len(sh) > 2 && sh[1] == '=' {
+						passed += sh
+						sh = ""
+					} else {
+						passed += sh[:1]
+						sh = sh[1:]
+					}
+					continue
+				default:
+					return fin(errUnknown)
+				}
+			}
+			var value string
+			switch {
+			case len(sh) > 2 && sh[1] == '=':
+				value = sh[2:]
+				sh = ""
+			case flags[fi].noOpt != "":
+				value = flags[fi].noOpt
+				sh = sh[1:]
+			case len(sh) > 1:
+				value = sh[1:]
+				sh = ""
+			case i < len(argv):
+				value = argv[i]
+				i++
+				sh = ""
+			default:
+				return fin(errValueRequired)
+			}
+			if e := apply(fi, value); e != errNone {
+				return fin(e)
+			}
+		}
+		if passed != "" {
+			res.args = append(res.args, "-"+passed)
+		}
+	}
+	return fin(errNone)
+}
+
+func TestHegelParseFollowsTheDocumentedGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, gCases)
+		flags, mode, interspersed, argv := c.flags(), c.mode, c.interspersed, c.argv()
+		want := modelParse(flags, argv, interspersed, mode)
+		note(ht, "the grammar says %s", want)
+
+		fs := newSet(interspersed)
+		switch mode {
+		case modeIgnore:
+			if c.allowlist {
+				fs.ParseErrorsAllowlist.UnknownFlags = true
+			} else {
+				fs.ParseErrorsAllowlist.UnknownFlagsHandling = pflag.IgnoreUnknownFlag
+			}
+		case modePass:
+			fs.ParseErrorsAllowlist.UnknownFlagsHandling = pflag.PassUnknownFlagToArgs
+		}
+		bounds := make([]gBound, len(flags))
+		for i, f := range flags {
+			bounds[i] = defineG(fs, f)
+		}
+		err := fs.Parse(argv)
+		got := gResult{err: classify(err), args: argsOf(fs.Args()), atDash: fs.ArgsLenAtDash(), states: make([]gState, len(flags))}
+		if got.err != want.err {
+			fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: %s (%v), the grammar says %s", argv, gModeNames[mode], interspersed, flags, modelErrNames[got.err], err, modelErrNames[want.err])
+		}
+		if err != nil {
+			return
+		}
+		if !reflect.DeepEqual(got.args, want.args) || got.atDash != want.atDash {
+			fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: Args()=%q ArgsLenAtDash()=%d, the grammar says %q / %d", argv, gModeNames[mode], interspersed, flags, got.args, got.atDash, want.args, want.atDash)
+		}
+		for i, f := range flags {
+			gv, wv := bounds[i].value(f.kind), want.states[i].value(f.kind)
+			if !reflect.DeepEqual(gv, wv) {
+				fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: %v = %#v, the grammar says %#v", argv, gModeNames[mode], interspersed, flags, f, gv, wv)
+			}
+			if fs.Changed(f.name) != want.states[i].changed {
+				fail(ht, "Parse(%q) [%s, flags %v]: Changed(%s)=%v, the grammar says %v", argv, gModeNames[mode], flags, f.name, fs.Changed(f.name), want.states[i].changed)
+			}
+			if fl := fs.Lookup(f.name); fl.Changed != want.states[i].changed {
+				fail(ht, "Parse(%q): Lookup(%s).Changed=%v, Changed()=%v", argv, f.name, fl.Changed, fs.Changed(f.name))
+			}
+		}
+		if fs.NFlag() != len(visited(func(f func(string)) { fs.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })) {
+			fail(ht, "Parse(%q): NFlag()=%d but Visit sees %d flags", argv, fs.NFlag(), len(visited(func(f func(string)) { fs.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })))
+		}
+	})
+}
diff --git a/hegel_norm_test.go b/hegel_norm_test.go
new file mode 100644
index 0000000..39d1f6b
--- /dev/null
+++ b/hegel_norm_test.go
@@ -0,0 +1,191 @@
+package pflag_test
+
+// 5. Name normalisation: a normaliser folding _, . and case to a lower-case
+// dashed name, installed before or after the flags are defined; every
+// spelling of a name (its definition, its use on the command line, its
+// lookup) is a drawn tape rendered by respell, so an empty tape is the
+// canonical spelling and the case shrinks to it.
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+func normalize(_ *pflag.FlagSet, name string) pflag.NormalizedName {
+	return pflag.NormalizedName(strings.ToLower(strings.NewReplacer("_", "-", ".", "-").Replace(name)))
+}
+
+var normNames = []string{"my-flag", "other-flag", "third-one", "camel-case", "x-y-z"}
+
+var separators = []string{"-", "_", "."}
+
+// tape is a drawn list of small integers a pure renderer reads by position,
+// recycled modulo its length; an empty tape answers 0 to every question, so
+// the shrunk form of every choice is its first, plainest one.
+type tape []int
+
+// at is the tape's value at position i in 0..n-1.
+func (t tape) at(i, n int) int {
+	if len(t) == 0 {
+		return 0
+	}
+	return t[i%len(t)] % n
+}
+
+// tapes: up to twelve values of 0 to 99.
+var tapes = hegel.Map(many(hegel.Integers(0, 99), 0, 12), func(xs []int) tape { return tape(xs) })
+
+// respell writes the name with the tape's choices: each dash as one of the
+// separators, each letter in upper case three times in ten.
+func respell(name string, t tape) string {
+	var b strings.Builder
+	for i, r := range name {
+		if r == '-' {
+			b.WriteString(separators[t.at(i, 3)])
+			continue
+		}
+		if t.at(i, 100) >= 70 {
+			b.WriteString(strings.ToUpper(string(r)))
+		} else {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// normOp is one use of a flag on the command line: the name-th flag (modulo
+// their number) in the tape's spelling, with its value glued (--name=value)
+// or separate (--name value).
+type normOp struct {
+	name  int
+	spell tape
+	value string
+	glued bool
+}
+
+var normOps = hegel.Composite(func(tc hegel.TestCase) normOp {
+	return normOp{
+		name:  hegel.Draw(tc, positions),
+		spell: hegel.Draw(tc, tapes),
+		value: hegel.Draw(tc, hegel.SampledFrom([]string{"1", "x", "", "a b"})),
+		glued: hegel.Draw(tc, chance(50)),
+	}
+})
+
+// normCase: one to four of the names, the normaliser installed late four
+// times in ten, a spelling for each name's definition, up to five uses, an
+// unknown flag at the end once in five, and a spelling for each lookup.
+type normCase struct {
+	count   int
+	late    bool
+	defs    []tape
+	ops     []normOp
+	unknown string
+	lookups []tape
+}
+
+var normCases = hegel.Composite(func(tc hegel.TestCase) normCase {
+	return normCase{
+		count:   hegel.Draw(tc, hegel.Integers(1, 4)),
+		late:    hegel.Draw(tc, chance(40)),
+		defs:    hegel.Draw(tc, fixed(tapes, 4)),
+		ops:     hegel.Draw(tc, many(normOps, 0, 5)),
+		unknown: hegel.Draw(tc, maybe(20, hegel.SampledFrom([]string{"nope", "my_flag_x"}))),
+		lookups: hegel.Draw(tc, fixed(tapes, 4)),
+	}
+})
+
+func (c normCase) names() []string { return normNames[:c.count] }
+
+// spellings are the names as defined.
+func (c normCase) spellings() map[string]string {
+	out := map[string]string{}
+	for i, name := range c.names() {
+		out[name] = respell(name, c.defs[i])
+	}
+	return out
+}
+
+// argvs renders the canonical command line and the respelt one.
+func (c normCase) argvs() (canon, argv []string) {
+	names := c.names()
+	for _, op := range c.ops {
+		name := names[op.name%len(names)]
+		spelt := respell(name, op.spell)
+		if op.glued {
+			canon = append(canon, "--"+name+"="+op.value)
+			argv = append(argv, "--"+spelt+"="+op.value)
+		} else {
+			canon = append(canon, "--"+name, op.value)
+			argv = append(argv, "--"+spelt, op.value)
+		}
+	}
+	if c.unknown != "" {
+		canon = append(canon, "--"+c.unknown)
+		argv = append(argv, "--"+c.unknown)
+	}
+	return canon, argv
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c normCase) GoString() string {
+	_, argv := c.argvs()
+	return fmt.Sprintf("defined as %q late=%v argv=%q", c.spellings(), c.late, argv)
+}
+
+func TestHegelNormalizedNamesAreInterchangeable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, normCases)
+		names, spellings := c.names(), c.spellings()
+		build := func(spell func(string) string) (*pflag.FlagSet, []*string) {
+			fs := newSet(true)
+			if !c.late {
+				fs.SetNormalizeFunc(normalize)
+			}
+			ptrs := make([]*string, len(names))
+			for i, name := range names {
+				ptrs[i] = fs.String(spell(name), "", "u")
+			}
+			if c.late {
+				fs.SetNormalizeFunc(normalize)
+			}
+			return fs, ptrs
+		}
+		ref, refPtrs := build(func(s string) string { return s })
+		fs, ptrs := build(func(s string) string { return spellings[s] })
+
+		canon, argv := c.argvs()
+		refErr := ref.Parse(canon)
+		err := fs.Parse(argv)
+		if (refErr == nil) != (err == nil) {
+			fail(ht, "Parse(%q) with flags defined as %q: %v; the canonical Parse(%q): %v", argv, spellings, err, canon, refErr)
+		}
+		if err != nil {
+			return
+		}
+		for i, name := range names {
+			if *ptrs[i] != *refPtrs[i] {
+				fail(ht, "Parse(%q): %s = %q, the canonical Parse(%q) gives %q", argv, name, *ptrs[i], canon, *refPtrs[i])
+			}
+			sp := respell(name, c.lookups[i])
+			fl := fs.Lookup(sp)
+			if fl == nil || fl.Name != name {
+				fail(ht, "Lookup(%q) after defining %q: %+v, the normalised flag is %q", sp, spellings[name], fl, name)
+			}
+			if fs.Changed(sp) != ref.Changed(name) {
+				fail(ht, "Changed(%q)=%v, canonical Changed(%q)=%v", sp, fs.Changed(sp), name, ref.Changed(name))
+			}
+		}
+		if !reflect.DeepEqual(argsOf(fs.Args()), argsOf(ref.Args())) {
+			fail(ht, "Parse(%q): Args()=%q, canonical %q", argv, fs.Args(), ref.Args())
+		}
+		if fs.FlagUsages() != ref.FlagUsages() {
+			fail(ht, "FlagUsages differ:\n%s\nvs canonical\n%s", fs.FlagUsages(), ref.FlagUsages())
+		}
+	})
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..48126b0
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,367 @@
+package pflag_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// it judges, so that each bug has a property that finds it every run (the
+// wide properties reach the shapes at their natural rate). Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not
+// touch instead and passes.
+
+import (
+	"fmt"
+	"math"
+	"net"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- pflag/1
+
+var (
+	// crElements: elements holding a carriage return.
+	crElements = hegel.SampledFrom([]string{"cr\rin", "crlf\r\nin", "\r", "a\r\nb\r\nc", "\r\n"})
+	// arrayElements: a lone empty element, or one to three CSV-safe elements
+	// of which the at-th (modulo their number) holds a CR: the shapes of
+	// pflag/1. Under HEGEL_NO_KNOWN=1 one to three CSV-safe elements.
+	arrayElements = shaped[hegel.Generator[[]string]](
+		hegel.OneOf(
+			hegel.Just([]string{""}),
+			hegel.Composite(func(tc hegel.TestCase) []string {
+				elems := hegel.Draw(tc, many(hegel.SampledFrom(csvPool), 1, 3))
+				elems[hegel.Draw(tc, positions)%len(elems)] = hegel.Draw(tc, crElements)
+				return elems
+			}),
+		),
+		many(hegel.SampledFrom(csvPool), 1, 3),
+	)
+)
+
+// TestHegelGetStringArrayReturnsTheBoundElements: a string array is not CSV
+// ("the value of each argument will not try to be separated by comma"), so
+// GetStringArray returns the elements as the bound variable holds them;
+// pflag re-reads the CSV rendering and loses a lone empty element or a CR
+// (pflag/1).
+func TestHegelGetStringArrayReturnsTheBoundElements(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		elems := hegel.Draw(ht, arrayElements)
+		fs := newSet(true)
+		p := fs.StringArray("flag", nil, "u")
+		for _, e := range elems {
+			if err := fs.Set("flag", e); err != nil {
+				fail(ht, "Set(%q): %v", e, err)
+			}
+		}
+		got, err := fs.GetStringArray("flag")
+		if err != nil {
+			fail(ht, "GetStringArray after %q: %v (Value.String()=%q)", elems, err, fs.Lookup("flag").Value.String())
+		}
+		if !reflect.DeepEqual(got, *p) {
+			fail(ht, "after %q the variable holds %q but GetStringArray returns %q (Value.String()=%q)", elems, *p, got, fs.Lookup("flag").Value.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/2
+
+// fExact reports whether %f renders the value exactly.
+func fExact(v float64) bool {
+	back, err := strconv.ParseFloat(fmt.Sprintf("%f", v), 64)
+	return err == nil && back == v
+}
+
+var (
+	// inexactFloats: a value %f rounds (the shape of pflag/2): one of a pool,
+	// or a seven-digit mantissa over 10^7 to 10^12 (filtered: a mantissa
+	// ending in zeros may render exactly). Under HEGEL_NO_KNOWN=1 a value %f
+	// renders exactly.
+	inexactFloats = shaped[hegel.Generator[string]](
+		hegel.Filter(hegel.OneOf(
+			hegel.SampledFrom([]string{"1e-7", "5e-324", "123456789.123456789", "0.1234567", "1e-300", "3.14159265358979", "2.5e-7", "1e-10"}),
+			hegel.Map(pairs(hegel.Integers(1000000, 9999999), hegel.Integers(7, 12)), func(p pair[int, int]) string {
+				return strconv.FormatFloat(float64(p.a)/math.Pow10(p.b), 'g', -1, 64)
+			}),
+		), func(s string) bool { v, _ := strconv.ParseFloat(s, 64); return !fExact(v) }),
+		hegel.SampledFrom(exactFloatPool),
+	)
+	inexactFloatSlices = joined(fromPool2(inexactFloats, parse64), collectAs[float64])
+)
+
+// fromPool2 is fromPool over a generator of texts.
+func fromPool2(texts hegel.Generator[string], parse func(string) any) hegel.Generator[occurrence] {
+	return hegel.Map(texts, func(s string) occurrence { return occurrence{s, parse(s)} })
+}
+
+// TestHegelGetFloat64SliceKeepsEveryDigit: GetFloat64Slice returns the
+// elements the bound variable holds, as every other numeric accessor does;
+// pflag re-reads a %f rendering and rounds them to six decimals (pflag/2).
+func TestHegelGetFloat64SliceKeepsEveryDigit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := hegel.Draw(ht, inexactFloatSlices)
+		fs := newSet(true)
+		p := fs.Float64Slice("flag", nil, "u")
+		if err := fs.Parse([]string{"--flag=" + o.text}); err != nil {
+			fail(ht, "Parse(--flag=%s): %v", o.text, err)
+		}
+		if !reflect.DeepEqual(*p, o.val) {
+			fail(ht, "after --flag=%s the variable holds %v, strconv says %v", o.text, *p, o.val)
+		}
+		got, err := fs.GetFloat64Slice("flag")
+		if err != nil {
+			fail(ht, "GetFloat64Slice after --flag=%s: %v", o.text, err)
+		}
+		if !reflect.DeepEqual(got, *p) {
+			fail(ht, "after --flag=%s the variable holds %v but GetFloat64Slice returns %v (Value.String()=%q)", o.text, *p, got, fs.Lookup("flag").Value.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/3
+
+// defaultCase: an ipMask or ipNet flag left at its default, which is the
+// nil one (the shape of pflag/3) or, under HEGEL_NO_KNOWN=1, a random one.
+type defaultCase struct {
+	mask bool // else net
+	m    net.IPMask
+	n    net.IPNet
+}
+
+var (
+	randomMasks = hegel.Map(maskBytes, func(b []byte) net.IPMask { return net.IPv4Mask(b[0], b[1], b[2], b[3]) })
+	randomNets  = hegel.Map(ipNetOccs, func(o occurrence) net.IPNet { return o.val.(net.IPNet) })
+	// maskDefaults, netDefaults: nil by default, random under HEGEL_NO_KNOWN=1.
+	maskDefaults = shaped[hegel.Generator[net.IPMask]](hegel.Just[net.IPMask](nil), randomMasks)
+	netDefaults  = shaped[hegel.Generator[net.IPNet]](hegel.Just(net.IPNet{}), randomNets)
+	defaultCases = hegel.Composite(func(tc hegel.TestCase) defaultCase {
+		return defaultCase{mask: hegel.Draw(tc, hegel.Booleans()), m: hegel.Draw(tc, maskDefaults), n: hegel.Draw(tc, netDefaults)}
+	})
+)
+
+func (c defaultCase) GoString() string {
+	if c.mask {
+		return fmt.Sprintf("ipMask default %v", c.m)
+	}
+	return fmt.Sprintf("ipNet default %v", c.n.String())
+}
+
+// TestHegelGetMaskAndNetReturnTheDefault: GetIPv4Mask and GetIPNet on a flag
+// not given on the command line return its default, as GetIP does for a nil
+// IP; pflag fails to re-parse the "<nil>" rendering of the nil default
+// (pflag/3).
+func TestHegelGetMaskAndNetReturnTheDefault(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, defaultCases)
+		fs := newSet(true)
+		if c.mask {
+			p := fs.IPMask("flag", c.m, "u")
+			got, err := fs.GetIPv4Mask("flag")
+			if err != nil {
+				fail(ht, "GetIPv4Mask on the default %v: %v (Value.String()=%q)", c.m, err, fs.Lookup("flag").Value.String())
+			}
+			if !reflect.DeepEqual(norm(got), norm(*p)) {
+				fail(ht, "GetIPv4Mask on the default %v returns %v", *p, got)
+			}
+			return
+		}
+		p := fs.IPNet("flag", c.n, "u")
+		got, err := fs.GetIPNet("flag")
+		if err != nil {
+			fail(ht, "GetIPNet on the default %v: %v (Value.String()=%q)", c.n.String(), err, fs.Lookup("flag").Value.String())
+		}
+		if got.String() != p.String() {
+			fail(ht, "GetIPNet on the default %v returns %v", p.String(), got.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/4
+
+// emptyKind defines a collection flag with its empty default.
+type emptyKind struct {
+	name   string
+	define func(fs *pflag.FlagSet, name, usage string)
+}
+
+var (
+	// shownEmptyKinds: the kinds whose empty default the usage shows as
+	// "(default [])" (pflag/4).
+	shownEmptyKinds = []emptyKind{
+		{"boolSlice", func(fs *pflag.FlagSet, n, u string) { fs.BoolSlice(n, nil, u) }},
+		{"durationSlice", func(fs *pflag.FlagSet, n, u string) { fs.DurationSlice(n, nil, u) }},
+		{"float32Slice", func(fs *pflag.FlagSet, n, u string) { fs.Float32Slice(n, nil, u) }},
+		{"float64Slice", func(fs *pflag.FlagSet, n, u string) { fs.Float64Slice(n, nil, u) }},
+		{"int32Slice", func(fs *pflag.FlagSet, n, u string) { fs.Int32Slice(n, nil, u) }},
+		{"int64Slice", func(fs *pflag.FlagSet, n, u string) { fs.Int64Slice(n, nil, u) }},
+		{"uintSlice", func(fs *pflag.FlagSet, n, u string) { fs.UintSlice(n, nil, u) }},
+		{"ipSlice", func(fs *pflag.FlagSet, n, u string) { fs.IPSlice(n, nil, u) }},
+		{"ipNetSlice", func(fs *pflag.FlagSet, n, u string) { fs.IPNetSlice(n, nil, u) }},
+		{"stringToString", func(fs *pflag.FlagSet, n, u string) { fs.StringToString(n, nil, u) }},
+		{"stringToInt", func(fs *pflag.FlagSet, n, u string) { fs.StringToInt(n, nil, u) }},
+		{"stringToInt64", func(fs *pflag.FlagSet, n, u string) { fs.StringToInt64(n, nil, u) }},
+	}
+	// hiddenEmptyKinds: the kinds defaultIsZeroValue knows, for HEGEL_NO_KNOWN=1.
+	hiddenEmptyKinds = []emptyKind{
+		{"stringSlice", func(fs *pflag.FlagSet, n, u string) { fs.StringSlice(n, nil, u) }},
+		{"intSlice", func(fs *pflag.FlagSet, n, u string) { fs.IntSlice(n, nil, u) }},
+		{"stringArray", func(fs *pflag.FlagSet, n, u string) { fs.StringArray(n, nil, u) }},
+	}
+	emptyKinds = shaped(shownEmptyKinds, hiddenEmptyKinds)
+)
+
+// emptyFlag is a collection flag as drawn: its kind (modulo the kinds), a
+// name slot and its usage text.
+type emptyFlag struct {
+	kind  int
+	slot  int
+	usage string
+}
+
+var emptyFlagSets = many(hegel.Composite(func(tc hegel.TestCase) emptyFlag {
+	return emptyFlag{kind: hegel.Draw(tc, positions), slot: hegel.Draw(tc, positions), usage: hegel.Draw(tc, usageTexts)}
+}), 1, 4)
+
+// TestHegelEmptyCollectionDefaultsAreNotShown: a flag whose default is the
+// empty collection has a zero default, so its usage line carries no
+// "(default ...)" - as for stringSlice, intSlice and stringArray; pflag
+// shows "(default [])" for the later slice and map kinds (pflag/4).
+func TestHegelEmptyCollectionDefaultsAreNotShown(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		flags := hegel.Draw(ht, emptyFlagSets)
+		slots := make([]int, len(flags))
+		for i, f := range flags {
+			slots[i] = f.slot
+		}
+		names := assign(flagNames, slots)
+		fs := newSet(true)
+		var kinds []string
+		for i, f := range flags {
+			k := emptyKinds[f.kind%len(emptyKinds)]
+			kinds = append(kinds, k.name)
+			k.define(fs, names[i], f.usage)
+		}
+		note(ht, "kinds %q", kinds)
+		if out := fs.FlagUsages(); strings.Contains(out, "(default") {
+			fail(ht, "empty defaults of %q are shown:\n%s", kinds, out)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/5
+
+const asciiLetters = "abcdefghijklmnopqrstuvwxyz"
+
+var (
+	// wideUsageTexts: ten to twenty-five words of two to four letters, of two
+	// and three bytes each (the shape of pflag/5), or ASCII under
+	// HEGEL_NO_KNOWN=1; enough text to wrap at 40 to 80 columns.
+	wideUsageTexts = hegel.Map(many(text(shaped(wideChars, asciiLetters), 2, 4), 10, 25), func(ws []string) string { return strings.Join(ws, " ") })
+	wideUsageCases = pairs(wideUsageTexts, hegel.Integers(40, 80))
+)
+
+// TestHegelUsageWrapsByColumnWidth: FlagUsagesWrapped wraps the usage text
+// "to cols columns", so a line is filled greedily by the width of its
+// characters; pflag counts bytes, so text of non-ASCII letters wraps early
+// (pflag/5).
+func TestHegelUsageWrapsByColumnWidth(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wideUsageCases)
+		f := uFlag{name: "alpha", kind: uString, usage: c.a}
+		fs := newSet(true)
+		fs.String(f.name, "", f.usage)
+		checkUsage(ht, fs, []uFlag{f}, c.b)
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/6
+
+var (
+	plainValues = []string{"v", "1", "x y", "", "a b c", "\u00e9"}
+	// pairValues: a value in quotes (the shape of pflag/6), or plain under
+	// HEGEL_NO_KNOWN=1.
+	pairValues = shaped[hegel.Generator[string]](
+		hegel.Map(hegel.SampledFrom(plainValues), func(v string) string { return `"` + v + `"` }),
+		hegel.SampledFrom(plainValues),
+	)
+	singlePairs = pairs(hegel.SampledFrom(keyPool), pairValues)
+)
+
+// TestHegelStringToStringSinglePairKeepsItsValue: a single key=value pair
+// sets the key to the value, with its quotes either kept (as the CSV path
+// for two or more pairs keeps them) or stripped (as for a pair quoted as a
+// whole); pflag strips the opening quote alone (pflag/6).
+func TestHegelStringToStringSinglePairKeepsItsValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		kv := hegel.Draw(ht, singlePairs)
+		fs := newSet(true)
+		p := fs.StringToString("flag", nil, "u")
+		arg := kv.a + "=" + kv.b
+		if err := fs.Set("flag", arg); err != nil {
+			fail(ht, "Set(%q): %v", arg, err)
+		}
+		got, ok := (*p)[kv.a]
+		if !ok || (got != kv.b && got != strings.Trim(kv.b, `"`)) {
+			fail(ht, "Set(%q) gives %q=%q: neither %q nor %q", arg, kv.a, got, kv.b, strings.Trim(kv.b, `"`))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- pflag/7
+
+// mapDefaultCase: a stringToInt or stringToInt64 flag with a default of two
+// to six keys (the shape of pflag/7: its text follows map order), or one key
+// under HEGEL_NO_KNOWN=1.
+type mapDefaultCase struct {
+	int64s bool
+	def    map[string]int
+}
+
+var (
+	defKeys         = hegel.SampledFrom([]string{"a", "b", "c", "d", "e", "f"})
+	mapDefaults     = shaped(hegel.Maps(defKeys, hegel.Integers(-100, 100)).MinSize(2).MaxSize(6), hegel.Maps(defKeys, hegel.Integers(-100, 100)).MinSize(1).MaxSize(1))
+	mapDefaultCases = hegel.Composite(func(tc hegel.TestCase) mapDefaultCase {
+		return mapDefaultCase{int64s: hegel.Draw(tc, hegel.Booleans()), def: hegel.Draw(tc, mapDefaults)}
+	})
+)
+
+func (c mapDefaultCase) GoString() string {
+	kind := "stringToInt"
+	if c.int64s {
+		kind = "stringToInt64"
+	}
+	return fmt.Sprintf("%s default %v", kind, c.def)
+}
+
+// TestHegelStringToIntDefaultTextIsSorted: the DefValue of a stringToInt or
+// stringToInt64 flag is its default rendered with the keys sorted, as
+// stringToString renders, and Value.String() is the same text on every
+// call; pflag walks the map, so the text changes between runs and between
+// calls (pflag/7).
+func TestHegelStringToIntDefaultTextIsSorted(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mapDefaultCases)
+		fs := newSet(true)
+		want := mapText(c.def)
+		if c.int64s {
+			def := make(map[string]int64, len(c.def))
+			for k, v := range c.def {
+				def[k] = int64(v)
+			}
+			fs.StringToInt64("flag", def, "u")
+		} else {
+			fs.StringToInt("flag", c.def, "u")
+		}
+		fl := fs.Lookup("flag")
+		if fl.DefValue != want {
+			fail(ht, "DefValue is %q, the sorted rendering is %q", fl.DefValue, want)
+		}
+		for i := 0; i < 20; i++ {
+			if s := fl.Value.String(); s != want {
+				fail(ht, "Value.String() is %q on call %d, the sorted rendering is %q", s, i, want)
+			}
+		}
+	})
+}
diff --git a/hegel_shared_test.go b/hegel_shared_test.go
new file mode 100644
index 0000000..109de38
--- /dev/null
+++ b/hegel_shared_test.go
@@ -0,0 +1,382 @@
+package pflag_test
+
+// 1. The syntax shared with the standard library's flag package: --name,
+// --name=value, --name value, --bool, "--", positionals after the flags. A
+// case is a record of drawn data (the flags, the tokens, the positionals and
+// the tail after "--") rendered into a command line by a pure function; the
+// oracle is flag.FlagSet on the same definitions.
+
+import (
+	"errors"
+	goflag "flag"
+	"fmt"
+	"reflect"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+type sharedKind int
+
+const (
+	shBool sharedKind = iota
+	shInt
+	shInt64
+	shUint
+	shUint64
+	shFloat
+	shString
+	shDuration
+)
+
+var sharedKinds = []sharedKind{shBool, shInt, shInt64, shUint, shUint64, shFloat, shString, shDuration}
+
+type sharedFlag struct {
+	name string
+	kind sharedKind
+	def  string // textual default
+}
+
+var sharedDefaults = map[sharedKind][]string{
+	shBool:     {"false", "true"},
+	shInt:      {"0", "1", "-7", "1099511627776"},
+	shInt64:    {"0", "-1", "9223372036854775807"},
+	shUint:     {"0", "3"},
+	shUint64:   {"0", "18446744073709551615"},
+	shFloat:    {"0", "1.5", "-2.25"},
+	shString:   {"", "x", "hello world"},
+	shDuration: {"0s", "1.5s", "2h0m0s"},
+}
+
+// bound holds the variables a flag set was bound to; read() renders the one
+// in use.
+type bound struct {
+	kind sharedKind
+	b    *bool
+	i    *int
+	i64  *int64
+	u    *uint
+	u64  *uint64
+	f    *float64
+	s    *string
+	d    *time.Duration
+}
+
+func (b bound) read() string {
+	switch b.kind {
+	case shBool:
+		return strconv.FormatBool(*b.b)
+	case shInt:
+		return strconv.Itoa(*b.i)
+	case shInt64:
+		return strconv.FormatInt(*b.i64, 10)
+	case shUint:
+		return strconv.FormatUint(uint64(*b.u), 10)
+	case shUint64:
+		return strconv.FormatUint(*b.u64, 10)
+	case shFloat:
+		return strconv.FormatFloat(*b.f, 'g', -1, 64)
+	case shString:
+		return *b.s
+	default:
+		return b.d.String()
+	}
+}
+
+func mustInt(s string) int64 {
+	v, err := strconv.ParseInt(s, 10, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustUint(s string) uint64 {
+	v, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustFloat(s string) float64 {
+	v, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustDur(s string) time.Duration {
+	v, err := time.ParseDuration(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func defineGo(fs *goflag.FlagSet, f sharedFlag) bound {
+	b := bound{kind: f.kind}
+	switch f.kind {
+	case shBool:
+		b.b = fs.Bool(f.name, f.def == "true", "u")
+	case shInt:
+		b.i = fs.Int(f.name, int(mustInt(f.def)), "u")
+	case shInt64:
+		b.i64 = fs.Int64(f.name, mustInt(f.def), "u")
+	case shUint:
+		b.u = fs.Uint(f.name, uint(mustUint(f.def)), "u")
+	case shUint64:
+		b.u64 = fs.Uint64(f.name, mustUint(f.def), "u")
+	case shFloat:
+		b.f = fs.Float64(f.name, mustFloat(f.def), "u")
+	case shString:
+		b.s = fs.String(f.name, f.def, "u")
+	default:
+		b.d = fs.Duration(f.name, mustDur(f.def), "u")
+	}
+	return b
+}
+
+func definePflag(fs *pflag.FlagSet, f sharedFlag) bound {
+	b := bound{kind: f.kind}
+	switch f.kind {
+	case shBool:
+		b.b = fs.Bool(f.name, f.def == "true", "u")
+	case shInt:
+		b.i = fs.Int(f.name, int(mustInt(f.def)), "u")
+	case shInt64:
+		b.i64 = fs.Int64(f.name, mustInt(f.def), "u")
+	case shUint:
+		b.u = fs.Uint(f.name, uint(mustUint(f.def)), "u")
+	case shUint64:
+		b.u64 = fs.Uint64(f.name, mustUint(f.def), "u")
+	case shFloat:
+		b.f = fs.Float64(f.name, mustFloat(f.def), "u")
+	case shString:
+		b.s = fs.String(f.name, f.def, "u")
+	default:
+		b.d = fs.Duration(f.name, mustDur(f.def), "u")
+	}
+	return b
+}
+
+var sharedValues = []string{
+	"1", "0", "-1", "0x1F", "0b101", "0o17", "017", "1_000", "3.5", "1e3", "-0", "inf", "NaN",
+	"true", "false", "t", "F", "TRUE", "yes",
+	"1h", "1.5s", "-3m", "1s500ms", "1h-2m",
+	"abc", "", "x y", `"q"`, "a,b", "-",
+	"9223372036854775807", "9223372036854775808", "18446744073709551615", "18446744073709551616",
+}
+
+var positionalPool = []string{"file", "", "-", "a b", "x=y", "1", "-", "./p"}
+
+// tailPool: what may follow the "--" terminator.
+var tailPool = []string{"--x", "-y", "z", "", "--"}
+
+// sharedSpec is a flag as drawn: a name slot (a name from flagNames, assigned
+// modulo the ones still unused), a kind and one of the kind's defaults.
+type sharedSpec struct {
+	slot int
+	kind sharedKind
+	def  string
+}
+
+// sharedSpecs: a flag spec; the default depends on the kind.
+var sharedSpecs = hegel.FlatMap(hegel.SampledFrom(sharedKinds), func(k sharedKind) hegel.Generator[sharedSpec] {
+	return hegel.Map(pairs(positions, hegel.SampledFrom(sharedDefaults[k])), func(p pair[int, string]) sharedSpec {
+		return sharedSpec{slot: p.a, kind: k, def: p.b}
+	})
+})
+
+// sharedFlagsOf names the specs: distinct names by construction.
+func sharedFlagsOf(specs []sharedSpec) []sharedFlag {
+	slots := make([]int, len(specs))
+	for i, s := range specs {
+		slots[i] = s.slot
+	}
+	names := assign(flagNames, slots)
+	out := make([]sharedFlag, len(specs))
+	for i, s := range specs {
+		out[i] = sharedFlag{name: names[i], kind: s.kind, def: s.def}
+	}
+	return out
+}
+
+// sharedTok is one token of the flags part of a command line: a known flag
+// (the flag-th, modulo their number) as --name, --name=value or --name value,
+// or an unknown --nope, --nope=1 or --help.
+type sharedTok struct {
+	form  int // 0 --name, 1 --name=value, 2 --name value, 3 --nope, 4 --nope=1, 5 --help
+	flag  int
+	value string
+}
+
+var (
+	knownToks = hegel.Composite(func(tc hegel.TestCase) sharedTok {
+		return sharedTok{form: hegel.Draw(tc, hegel.Integers(0, 2)), flag: hegel.Draw(tc, positions), value: hegel.Draw(tc, hegel.SampledFrom(sharedValues))}
+	})
+	unknownToks = hegel.Map(hegel.SampledFrom([]int{3, 4, 5}), func(form int) sharedTok { return sharedTok{form: form} })
+	// sharedToks: a known flag 96 times in 100, else an unknown one or --help.
+	sharedToks = weighted(choice[sharedTok]{96, knownToks}, choice[sharedTok]{4, unknownToks})
+)
+
+// render appends the token's arguments.
+func (t sharedTok) render(argv []string, flags []sharedFlag) []string {
+	switch t.form {
+	case 3:
+		return append(argv, "--nope")
+	case 4:
+		return append(argv, "--nope=1")
+	case 5:
+		return append(argv, "--help")
+	}
+	f := flags[t.flag%len(flags)]
+	switch t.form {
+	case 0:
+		return append(argv, "--"+f.name)
+	case 1:
+		return append(argv, "--"+f.name+"="+t.value)
+	default:
+		return append(argv, "--"+f.name, t.value)
+	}
+}
+
+// sharedCase: one to five flags, up to five flag tokens, up to two
+// positionals and, three times in ten, a "--" terminator with up to two
+// arguments after it.
+type sharedCase struct {
+	specs       []sharedSpec
+	toks        []sharedTok
+	positionals []string
+	tail        *[]string
+}
+
+var sharedCases = hegel.Composite(func(tc hegel.TestCase) sharedCase {
+	return sharedCase{
+		specs:       hegel.Draw(tc, many(sharedSpecs, 1, 5)),
+		toks:        hegel.Draw(tc, many(sharedToks, 0, 5)),
+		positionals: hegel.Draw(tc, many(hegel.SampledFrom(positionalPool), 0, 2)),
+		tail:        hegel.Draw(tc, optional(30, many(hegel.SampledFrom(tailPool), 0, 2))),
+	}
+})
+
+func (c sharedCase) flags() []sharedFlag { return sharedFlagsOf(c.specs) }
+
+func (c sharedCase) argv() []string {
+	flags := c.flags()
+	var argv []string
+	for _, t := range c.toks {
+		argv = t.render(argv, flags)
+	}
+	argv = append(argv, c.positionals...)
+	if c.tail != nil {
+		argv = append(argv, "--")
+		argv = append(argv, *c.tail...)
+	}
+	return argv
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c sharedCase) GoString() string {
+	return fmt.Sprintf("flags %+v\nargv %q", c.flags(), c.argv())
+}
+
+type parseOutcome struct {
+	err     error
+	help    bool
+	values  []string
+	args    []string
+	nflag   int
+	visited []string
+}
+
+func (o parseOutcome) String() string {
+	if o.err != nil {
+		return fmt.Sprintf("error %q (help=%v)", o.err.Error(), o.help)
+	}
+	return fmt.Sprintf("values=%q args=%q nflag=%d visited=%q", o.values, o.args, o.nflag, o.visited)
+}
+
+func sameOutcome(a, b parseOutcome) bool {
+	if (a.err == nil) != (b.err == nil) {
+		return false
+	}
+	if a.err != nil {
+		return a.help == b.help
+	}
+	return reflect.DeepEqual(a.values, b.values) && reflect.DeepEqual(argsOf(a.args), argsOf(b.args)) &&
+		a.nflag == b.nflag && reflect.DeepEqual(a.visited, b.visited)
+}
+
+func readAll(bs []bound) []string {
+	out := make([]string, len(bs))
+	for i, b := range bs {
+		out[i] = b.read()
+	}
+	return out
+}
+
+func TestHegelSharedSyntaxAgreesWithStdlibFlag(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sharedCases)
+		flags, argv := c.flags(), c.argv()
+
+		// the reference: the standard library
+		gs := newGoSet()
+		gb := make([]bound, len(flags))
+		for i, f := range flags {
+			gb[i] = defineGo(gs, f)
+		}
+		gerr := gs.Parse(argv)
+		want := parseOutcome{err: gerr, help: errors.Is(gerr, goflag.ErrHelp), values: readAll(gb), args: gs.Args(), nflag: gs.NFlag(),
+			visited: visited(func(f func(string)) { gs.Visit(func(fl *goflag.Flag) { f(fl.Name) }) })}
+		note(ht, "flag: %s", want)
+
+		// pflag with the same definitions, interspersed off (flag stops at the first non-flag)
+		ps := newSet(false)
+		pb := make([]bound, len(flags))
+		for i, f := range flags {
+			pb[i] = definePflag(ps, f)
+		}
+		perr := ps.Parse(argv)
+		got := parseOutcome{err: perr, help: errors.Is(perr, pflag.ErrHelp), values: readAll(pb), args: ps.Args(), nflag: ps.NFlag(),
+			visited: visited(func(f func(string)) { ps.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag vs flag on %q\n flag:  %s\n pflag: %s", argv, want, got)
+		}
+
+		// pflag wrapping a flag.FlagSet (AddGoFlagSet)
+		gs2 := newGoSet()
+		gb2 := make([]bound, len(flags))
+		for i, f := range flags {
+			gb2[i] = defineGo(gs2, f)
+		}
+		ws := newSet(false)
+		ws.AddGoFlagSet(gs2)
+		werr := ws.Parse(argv)
+		got = parseOutcome{err: werr, help: errors.Is(werr, pflag.ErrHelp), values: readAll(gb2), args: ws.Args(), nflag: ws.NFlag(),
+			visited: visited(func(f func(string)) { ws.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag.AddGoFlagSet vs flag on %q\n flag:  %s\n pflag: %s", argv, want, got)
+		}
+
+		// a flag.FlagSet filled from pflag (CopyToGoFlagSet)
+		ps3 := newSet(false)
+		pb3 := make([]bound, len(flags))
+		for i, f := range flags {
+			pb3[i] = definePflag(ps3, f)
+		}
+		gs3 := newGoSet()
+		ps3.CopyToGoFlagSet(gs3)
+		cerr := gs3.Parse(argv)
+		got = parseOutcome{err: cerr, help: errors.Is(cerr, goflag.ErrHelp), values: readAll(pb3), args: gs3.Args(), nflag: gs3.NFlag(),
+			visited: visited(func(f func(string)) { gs3.Visit(func(fl *goflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag.CopyToGoFlagSet vs flag on %q\n flag:  %s\n copy:  %s", argv, want, got)
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..d957c9c
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,380 @@
+package pflag_test
+
+// Property-based tests for spf13/pflag. The oracles: the standard library's
+// flag package on the syntax the two share (pflag is documented as a drop-in
+// replacement), a model of the README's "Command line flag syntax" section
+// (long options, shorthand bundles, no-option defaults, "--", interspersed
+// arguments and the unknown-flag handling modes), the strconv/net/time/csv
+// parsers behind each typed Value together with the FlagSet.GetX accessors,
+// the documented usage layout (wrapped to N columns, "(default X)" only for
+// non-zero defaults), and flag-name normalisation.
+//
+// Every property draws one case record built from generator values and
+// rendered by pure functions. The shapes of the recorded bugs (bugs.toml)
+// are drawn at their natural rate, so the wide properties that meet them
+// fail, and hegel_shapes_test.go has one property per bug over its shape
+// region alone; the pins at the end of this file are the regression
+// examples. HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below)
+// for a run that looks past the bugs. Collect mode (PFLAG_COLLECT=1) prints
+// every disagreement instead of failing.
+
+import (
+	goflag "flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("PFLAG_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail; under HEGEL_NO_KNOWN=1 the shapes are left out of the
+// generators (shaped) and the one check only a recorded bug can fail
+// (GetIPv4Mask/GetIPNet on the nil default, pflag/3) is skipped by name.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+func newSet(interspersed bool) *pflag.FlagSet {
+	fs := pflag.NewFlagSet("zoo", pflag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	fs.SetInterspersed(interspersed)
+	return fs
+}
+
+func newGoSet() *goflag.FlagSet {
+	fs := goflag.NewFlagSet("zoo", goflag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	return fs
+}
+
+var flagNames = []string{"alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"}
+
+func visited(fn func(func(name string))) []string {
+	var names []string
+	fn(func(name string) { names = append(names, name) })
+	sort.Strings(names)
+	return names
+}
+
+func argsOf(a []string) []string {
+	if a == nil {
+		return []string{}
+	}
+	return a
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// assign gives each slot a distinct entry of the pool: the slot-th of the
+// entries still unused, modulo their number (the pool must be at least as
+// long as the slots).
+func assign(pool []string, slots []int) []string {
+	unused := append([]string(nil), pool...)
+	out := make([]string, len(slots))
+	for i, s := range slots {
+		j := s % len(unused)
+		out[i] = unused[j]
+		unused = append(unused[:j], unused[j+1:]...)
+	}
+	return out
+}
+
+// text is a string of lo to hi characters of the alphabet.
+func text(alphabet string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(alphabet).MinSize(lo).MaxSize(hi)
+}
+
+// ------------------------------------------------------------------ pins
+
+// pflag/1
+func TestHegelPinGetStringArrayKeepsEveryElement(t *testing.T) {
+	defer guard(t)
+	for _, in := range []string{"", "a\r\nb"} {
+		fs := newSet(true)
+		p := fs.StringArray("s", nil, "u")
+		if err := fs.Set("s", in); err != nil {
+			t.Fatal(err)
+		}
+		got, err := fs.GetStringArray("s")
+		if err != nil {
+			t.Fatalf("GetStringArray after Set(%q): %v", in, err)
+		}
+		if !reflect.DeepEqual(got, *p) {
+			t.Errorf("after Set(%q) the variable holds %q but GetStringArray returns %q (Value.String()=%q)", in, *p, got, fs.Lookup("s").Value.String())
+		}
+	}
+}
+
+// pflag/2
+func TestHegelPinGetFloat64SliceKeepsPrecision(t *testing.T) {
+	defer guard(t)
+	fs := newSet(true)
+	p := fs.Float64Slice("f", nil, "u")
+	if err := fs.Set("f", "1e-7,0.1,123456789.123456789,5e-324"); err != nil {
+		t.Fatal(err)
+	}
+	got, err := fs.GetFloat64Slice("f")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, *p) {
+		t.Errorf("the variable holds %v but GetFloat64Slice returns %v (Value.String()=%q)", *p, got, fs.Lookup("f").Value.String())
+	}
+}
+
+// pflag/3
+func TestHegelPinGetIPNetAndMaskAcceptTheNilDefault(t *testing.T) {
+	defer guard(t)
+	fs := newSet(true)
+	fs.IP("ip", nil, "u")
+	fs.IPMask("mask", nil, "u")
+	fs.IPNet("net", net.IPNet{}, "u")
+	if _, err := fs.GetIP("ip"); err != nil {
+		t.Errorf("GetIP on the nil default: %v", err)
+	}
+	if _, err := fs.GetIPv4Mask("mask"); err != nil {
+		t.Errorf("GetIPv4Mask on the nil default: %v (Value.String()=%q)", err, fs.Lookup("mask").Value.String())
+	}
+	if _, err := fs.GetIPNet("net"); err != nil {
+		t.Errorf("GetIPNet on the zero default: %v (Value.String()=%q)", err, fs.Lookup("net").Value.String())
+	}
+}
+
+// pflag/4
+func TestHegelPinEmptySliceDefaultsAreNotShown(t *testing.T) {
+	defer guard(t)
+	fs := newSet(true)
+	fs.BoolSlice("bools", nil, "u")
+	fs.DurationSlice("durations", nil, "u")
+	fs.Float64Slice("floats", nil, "u")
+	fs.IPSlice("ips", nil, "u")
+	fs.StringToString("pairs", nil, "u")
+	fs.StringToInt("counts", nil, "u")
+	// the kinds defaultIsZeroValue knows about, for comparison
+	fs.StringSlice("strings", nil, "u")
+	fs.IntSlice("ints", nil, "u")
+	if out := fs.FlagUsages(); strings.Contains(out, "(default") {
+		t.Errorf("empty defaults are shown:\n%s", out)
+	}
+}
+
+// pflag/5
+func TestHegelPinUsageWrapsByColumns(t *testing.T) {
+	defer guard(t)
+	ascii := newSet(true)
+	ascii.String("s", "", strings.TrimSpace(strings.Repeat("ee ", 20)))
+	utf := newSet(true)
+	utf.String("s", "", strings.TrimSpace(strings.Repeat("éé ", 20)))
+	want := ascii.FlagUsagesWrapped(60)
+	got := strings.ReplaceAll(utf.FlagUsagesWrapped(60), "é", "e")
+	if got != want {
+		t.Errorf("twenty two-column words wrap differently when the letters are non-ASCII:\n%s\nvs\n%s", utf.FlagUsagesWrapped(60), want)
+	}
+}
+
+// pflag/6
+func TestHegelPinStringToStringQuotedSinglePair(t *testing.T) {
+	defer guard(t)
+	whole := newSet(true)
+	pw := whole.StringToString("m", nil, "u")
+	if err := whole.Set("m", `"k=v"`); err != nil {
+		t.Fatal(err)
+	}
+	if (*pw)["k"] != "v" {
+		t.Fatalf(`"k=v" gives k=%q`, (*pw)["k"])
+	}
+	value := newSet(true)
+	pv := value.StringToString("m", nil, "u")
+	if err := value.Set("m", `k="v"`); err != nil {
+		t.Fatal(err)
+	}
+	if got := (*pv)["k"]; got != "v" && got != `"v"` {
+		t.Errorf(`k="v" gives k=%q: neither the quotes stripped (as for "k=v") nor kept`, got)
+	}
+}
+
+// pflag/7
+func TestHegelPinStringToIntDefaultTextIsStable(t *testing.T) {
+	defer guard(t)
+	def := map[string]int{"a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6}
+	fs := newSet(true)
+	fs.StringToInt("m", def, "u")
+	v := fs.Lookup("m").Value
+	first := v.String()
+	for i := 0; i < 50; i++ {
+		if s := v.String(); s != first {
+			t.Fatalf("Value.String() changes between calls: %q then %q (DefValue %q)", first, s, fs.Lookup("m").DefValue)
+		}
+	}
+}
