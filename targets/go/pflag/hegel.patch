+// ---------------------------------------------------- 4. the usage text
+
+type uKind int
+
+const (
+	uBool uKind = iota
+	uString
+	uInt
+	uDuration
+	uStringSlice
+	uCount
+	uFloat
+	uIP
+	uBoolSlice
+	uStringToString
+	uIPMask
+	uBytesHex
+	uDurationSlice
+	uIntSlice
+	uNumKinds
+)
+
+var uKindNames = []string{"bool", "string", "int", "duration", "stringSlice", "count", "float64", "ip", "boolSlice", "stringToString", "ipMask", "bytesHex", "durationSlice", "intSlice"}
+
+type uFlag struct {
+	name    string
+	short   string
+	kind    uKind
+	nonZero bool // a non-zero default
+	usage   string
+}
+
+// defineU defines the flag; the default is zero or a fixed non-zero one.
+func defineU(fs *pflag.FlagSet, f uFlag) {
+	nz := f.nonZero
+	switch f.kind {
+	case uBool:
+		fs.BoolP(f.name, f.short, nz, f.usage)
+	case uString:
+		def := ""
+		if nz {
+			def = "dflt"
+		}
+		fs.StringP(f.name, f.short, def, f.usage)
+	case uInt:
+		def := 0
+		if nz {
+			def = 7
+		}
+		fs.IntP(f.name, f.short, def, f.usage)
+	case uDuration:
+		var def time.Duration
+		if nz {
+			def = 1500 * time.Millisecond
+		}
+		fs.DurationP(f.name, f.short, def, f.usage)
+	case uStringSlice:
+		var def []string
+		if nz {
+			def = []string{"a", "b"}
+		} else if fs.Name() == "empty" {
+			def = []string{}
+		}
+		fs.StringSliceP(f.name, f.short, def, f.usage)
+	case uCount:
+		fs.CountP(f.name, f.short, f.usage) // no non-zero default
+	case uFloat:
+		def := 0.0
+		if nz {
+			def = 2.5
+		}
+		fs.Float64P(f.name, f.short, def, f.usage)
+	case uIP:
+		var def net.IP
+		if nz {
+			def = net.IPv4(10, 0, 0, 1)
+		}
+		fs.IPP(f.name, f.short, def, f.usage)
+	case uBoolSlice:
+		var def []bool
+		if nz {
+			def = []bool{true}
+		} else if fs.Name() == "empty" {
+			def = []bool{}
+		}
+		fs.BoolSliceP(f.name, f.short, def, f.usage)
+	case uStringToString:
+		var def map[string]string
+		if nz {
+			def = map[string]string{"k": "v"}
+		} else if fs.Name() == "empty" {
+			def = map[string]string{}
+		}
+		fs.StringToStringP(f.name, f.short, def, f.usage)
+	case uIPMask:
+		var def net.IPMask
+		if nz {
+			def = net.IPv4Mask(255, 255, 0, 0)
+		}
+		fs.IPMaskP(f.name, f.short, def, f.usage)
+	case uBytesHex:
+		var def []byte
+		if nz {
+			def = []byte{0x0a, 0xff}
+		} else if fs.Name() == "empty" {
+			def = []byte{}
+		}
+		fs.BytesHexP(f.name, f.short, def, f.usage)
+	case uDurationSlice:
+		var def []time.Duration
+		if nz {
+			def = []time.Duration{time.Second}
+		} else if fs.Name() == "empty" {
+			def = []time.Duration{}
+		}
+		fs.DurationSliceP(f.name, f.short, def, f.usage)
+	default:
+		var def []int
+		if nz {
+			def = []int{1, 2}
+		} else if fs.Name() == "empty" {
+			def = []int{}
+		}
+		fs.IntSliceP(f.name, f.short, def, f.usage)
+	}
+}
+
+var wordChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,;:!?'()"
+
+func genWord(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	var b strings.Builder
+	for k := n(tc, lo, hi); k > 0; k-- {
+		i := n(tc, 0, utf8.RuneCountInString(alphabet)-1)
+		for j, r := range alphabet {
+			_ = j
+			if i == 0 {
+				b.WriteRune(r)
+				break
+			}
+			i--
+		}
+	}
+	return b.String()
+}
+
+func genUsage(tc hegel.TestCase, alphabet string) string {
+	words := make([]string, n(tc, 0, 12))
+	for i := range words {
+		w := genWord(tc, alphabet, 1, 30)
+		if chance(tc, 10) {
+			w = "`" + w + "`"
+		}
+		words[i] = w
+	}
+	return strings.Join(words, " ")
+}
+
+func genUFlags(tc hegel.TestCase, alphabet string) []uFlag {
+	names := distinct(tc, n(tc, 1, 4))
+	shorts := []byte("abcdefg")
+	out := make([]uFlag, len(names))
+	for i, name := range names {
+		f := uFlag{name: name, kind: uKind(n(tc, 0, int(uNumKinds)-1)), nonZero: chance(tc, 40), usage: genUsage(tc, alphabet)}
+		switch f.kind {
+		case uCount:
+			f.nonZero = false // a count flag has no default of its own
+		case uBoolSlice, uStringToString, uDurationSlice:
+			f.nonZero = true // pflag/4: their empty default is shown as "(default [])"
+		}
+		if chance(tc, 60) {
+			j := n(tc, 0, len(shorts)-1)
+			f.short = string(shorts[j])
+			shorts = append(shorts[:j], shorts[j+1:]...)
+		}
+		out[i] = f
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].name < out[j].name })
+	return out
+}
