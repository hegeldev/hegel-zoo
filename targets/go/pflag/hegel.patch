+// pflag/5
+func TestHegelPinUsageWrapsByColumns(t *testing.T) {
+	defer guard(t)
+	ascii := newSet(true)
+	ascii.String("s", "", strings.TrimSpace(strings.Repeat("ee ", 20)))
+	utf := newSet(true)
+	utf.String("s", "", strings.TrimSpace(strings.Repeat("éé ", 20)))
+	want := ascii.FlagUsagesWrapped(60)
+	got := strings.ReplaceAll(utf.FlagUsagesWrapped(60), "é", "e")
+	if got != want {
+		t.Errorf("twenty two-column words wrap differently when the letters are non-ASCII:\n%s\nvs\n%s", utf.FlagUsagesWrapped(60), want)
+	}
+}
