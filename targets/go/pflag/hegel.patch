+// ------------------------------------------------- 5. name normalisation
+
+func normalize(_ *pflag.FlagSet, name string) pflag.NormalizedName {
+	return pflag.NormalizedName(strings.ToLower(strings.NewReplacer("_", "-", ".", "-").Replace(name)))
+}
+
+var normNames = []string{"my-flag", "other-flag", "third-one", "camel-case", "x-y-z"}
+
+func respell(tc hegel.TestCase, name string) string {
+	var b strings.Builder
+	for _, r := range name {
+		if r == '-' {
+			b.WriteString(pick(tc, []string{"-", "_", "."}))
+			continue
+		}
+		if chance(tc, 30) {
+			b.WriteString(strings.ToUpper(string(r)))
+		} else {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func TestHegelNormalizedNamesAreInterchangeable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		names := append([]string(nil), normNames[:k]...)
+		late := chance(ht, 40) // install the normaliser after the flags are defined
+		build := func(spell func(string) string) (*pflag.FlagSet, []*string) {
+			fs := newSet(true)
+			if !late {
+				fs.SetNormalizeFunc(normalize)
+			}
+			ptrs := make([]*string, len(names))
+			for i, name := range names {
+				ptrs[i] = fs.String(spell(name), "", "u")
+			}
+			if late {
+				fs.SetNormalizeFunc(normalize)
+			}
+			return fs, ptrs
+		}
+		spellings := map[string]string{}
+		for _, name := range names {
+			spellings[name] = respell(ht, name)
+		}
+		ref, refPtrs := build(func(s string) string { return s })
+		fs, ptrs := build(func(s string) string { return spellings[s] })
+
+		var canon, argv []string
+		for m := n(ht, 0, 5); m > 0; m-- {
+			name := pick(ht, names)
+			val := pick(ht, []string{"1", "x", "", "a b"})
+			if chance(ht, 50) {
+				canon = append(canon, "--"+name+"="+val)
+				argv = append(argv, "--"+respell(ht, name)+"="+val)
+			} else {
+				canon = append(canon, "--"+name, val)
+				argv = append(argv, "--"+respell(ht, name), val)
+			}
+		}
+		if chance(ht, 20) {
+			canon = append(canon, "--"+pick(ht, []string{"nope", "my_flag_x"}))
+			argv = append(argv, canon[len(canon)-1])
+		}
+		note(ht, "defined as %q late=%v argv=%q", spellings, late, argv)
+		refErr := ref.Parse(canon)
+		err := fs.Parse(argv)
+		if (refErr == nil) != (err == nil) {
+			fail(ht, "Parse(%q) with flags defined as %q: %v; the canonical Parse(%q): %v", argv, spellings, err, canon, refErr)
+		}
+		if err != nil {
+			return
+		}
+		for i, name := range names {
+			if *ptrs[i] != *refPtrs[i] {
+				fail(ht, "Parse(%q): %s = %q, the canonical Parse(%q) gives %q", argv, name, *ptrs[i], canon, *refPtrs[i])
+			}
+			sp := respell(ht, name)
+			fl := fs.Lookup(sp)
+			if fl == nil || fl.Name != name {
+				fail(ht, "Lookup(%q) after defining %q: %+v, the normalised flag is %q", sp, spellings[name], fl, name)
+			}
+			if fs.Changed(sp) != ref.Changed(name) {
+				fail(ht, "Changed(%q)=%v, canonical Changed(%q)=%v", sp, fs.Changed(sp), name, ref.Changed(name))
+			}
+		}
+		if !reflect.DeepEqual(argsOf(fs.Args()), argsOf(ref.Args())) {
+			fail(ht, "Parse(%q): Args()=%q, canonical %q", argv, fs.Args(), ref.Args())
+		}
+		if fs.FlagUsages() != ref.FlagUsages() {
+			fail(ht, "FlagUsages differ:\n%s\nvs canonical\n%s", fs.FlagUsages(), ref.FlagUsages())
+		}
+	})
+}
