+package pflag_test
+
+// 3. Typed values and their accessors: one flag of one of 23 kinds, up to
+// three occurrences with valid text drawn from the kind's generator (an
+// occurrence is the text and the value the parsers behind the kind read from
+// it); the bound variable equals the parsers' value, the GetX accessor
+// equals the bound variable, and for a scalar Set(Value.String()) on a fresh
+// flag reproduces the value. The shapes of pflag/1 (a lone empty or a
+// CR-holding stringArray element), pflag/2 (a float64Slice element %f does
+// not render exactly) and pflag/3 (GetIPv4Mask/GetIPNet on the nil default)
+// are drawn by default; under HEGEL_NO_KNOWN=1 the pools leave them out and
+// the nil-default accessor check is skipped.
+
+import (
+	"encoding/base64"
+	"encoding/csv"
+	"fmt"
+	"math"
+	"net"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+// occurrence is one use of a flag: its text and the value the parsers read.
+type occurrence struct {
+	text string
+	val  any
+}
+
+type vkind struct {
+	name    string
+	define  func(fs *pflag.FlagSet, name string) func() any
+	occ     hegel.Generator[occurrence]
+	get     func(fs *pflag.FlagSet, name string) (any, error)
+	combine func(prev any, first bool, v any) any // nil: the last Set wins
+	eq      func(a, b any) bool                   // nil: reflect.DeepEqual
+	noOpt   bool                                  // takes no separate argument (bool, count)
+	nilGet  bool                                  // Get on the nil default is the shape of pflag/3
+}
+
+func appendSlice(prev any, first bool, v any) any {
+	if first {
+		return v
+	}
+	return reflect.AppendSlice(reflect.ValueOf(prev), reflect.ValueOf(v)).Interface()
+}
+
+func mergeMap(prev any, first bool, v any) any {
+	if first {
+		return v
+	}
+	out := reflect.MakeMap(reflect.TypeOf(v))
+	for _, m := range []any{prev, v} {
+		it := reflect.ValueOf(m).MapRange()
+		for it.Next() {
+			out.SetMapIndex(it.Key(), it.Value())
+		}
+	}
+	return out.Interface()
+}
+
+// norm makes nil and empty slices/maps compare equal.
+func norm(v any) any {
+	rv := reflect.ValueOf(v)
+	if !rv.IsValid() {
+		return v
+	}
+	switch rv.Kind() {
+	case reflect.Slice:
+		if rv.IsNil() || rv.Len() == 0 {
+			return reflect.MakeSlice(rv.Type(), 0, 0).Interface()
+		}
+	case reflect.Map:
+		if rv.IsNil() || rv.Len() == 0 {
+			return reflect.MakeMap(rv.Type()).Interface()
+		}
+	}
+	return v
+}
+
+func ipEq(a, b any) bool {
+	x, _ := a.(net.IP)
+	y, _ := b.(net.IP)
+	return x.Equal(y)
+}
+
+func ipSliceEq(a, b any) bool {
+	x, _ := norm(a).([]net.IP)
+	y, _ := norm(b).([]net.IP)
+	if len(x) != len(y) {
+		return false
+	}
+	for i := range x {
+		if !x[i].Equal(y[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Pools ---------------------------------------------------------------------
+
+var (
+	textPool = []string{"", "a", "hello world", "a,b", `"q"`, `a"b`, "x=y", "[", "]", "[a]", " lead", "trail ", "tab\tin", "new\nline", "cr\rin", "crlf\r\nin", "é", "日本", "-x", "--", "\\", "`t`", "+1", "0x10", "1e3"}
+	// csvPool: the elements whose CSV spelling reads back unchanged (no lone
+	// empty element, no CR: the shape of pflag/1).
+	csvPool = []string{"a", "hello world", "a,b", `"q"`, `a"b`, "x=y", "[", "]", "[a]", " lead", "trail ", "tab\tin", "new\nline", "é", "日本", "-x", "--", "\\", "`t`"}
+	keyPool = []string{"a", "b", "key", "k2", "long-key"}
+	kvPool  = []string{"1", "v", "", "x y", "x,y", "a=b", "é"}
+	// quotedKVPool: kvPool and a quoted value (the shape of pflag/6 in a
+	// single pair).
+	quotedKVPool = []string{"1", `"q"`, "v", "", "x y", "x,y", "a=b", "é"}
+
+	float32Pool = []string{"0", "1.5", "-2.25", "3.4028235e38", "1e-45", "0.1", "1e-40", "16777217", "-0", "1e10", "3.14159274"}
+	float64Pool = []string{"0", "1.5", "-2.25", "1e308", "5e-324", "0.1", "1e-7", "123456789.123456789", "-0", "1e21"}
+	// exactFloatPool: the values %f renders exactly (pflag/2 is the rest).
+	exactFloatPool = []string{"0", "1.5", "-2.25", "3", "0.125", "1e21", "-7", "2.5e-3"}
+	boolPool       = []string{"true", "false", "t", "f", "1", "0", "TRUE", "False", "T"}
+	boolSlicePool  = []string{"true", "false", "t", "F", "1", "0", " true", "false "}
+	durationPool   = []string{"1h30m", "-1.5s", "0", "1us", "1h2m", "1.000000001s", "300ms"}
+)
+
+func parse64(s string) any { v, _ := strconv.ParseFloat(s, 64); return v }
+
+func parse32(s string) any { v, _ := strconv.ParseFloat(s, 32); return float32(v) }
+
+func parseDur(s string) any { d, _ := time.ParseDuration(s); return d }
+
+func parseBool(s string) any { v, _ := strconv.ParseBool(strings.TrimSpace(s)); return v }
+
+// fromPool: an occurrence whose text is one of the pool and whose value is
+// what parse reads from it.
+func fromPool(pool []string, parse func(string) any) hegel.Generator[occurrence] {
+	return hegel.Map(hegel.SampledFrom(pool), func(s string) occurrence { return occurrence{s, parse(s)} })
+}
+
+// joined: one to three occurrences of elems as one comma-separated text,
+// the values collected by collect.
+func joined[T any](elems hegel.Generator[occurrence], collect func([]any) T) hegel.Generator[occurrence] {
+	return hegel.Map(many(elems, 1, 3), func(os []occurrence) occurrence {
+		texts := make([]string, len(os))
+		vals := make([]any, len(os))
+		for i, o := range os {
+			texts[i], vals[i] = o.text, o.val
+		}
+		return occurrence{strings.Join(texts, ","), collect(vals)}
+	})
+}
+
+func collectAs[T any](vals []any) []T {
+	out := make([]T, len(vals))
+	for i, v := range vals {
+		out[i] = v.(T)
+	}
+	return out
+}
+
+func csvText(elems []string) string {
+	var b strings.Builder
+	w := csv.NewWriter(&b)
+	_ = w.Write(elems)
+	w.Flush()
+	return strings.TrimSuffix(b.String(), "\n")
+}
+
+// Generators per kind ---------------------------------------------------------
+
+var (
+	int8Occs = hegel.Map(pairs(hegel.Integers(-128, 127), chance(30)), func(p pair[int, bool]) occurrence {
+		if p.b && p.a >= 0 {
+			return occurrence{fmt.Sprintf("0x%x", p.a), int8(p.a)}
+		}
+		return occurrence{strconv.Itoa(p.a), int8(p.a)}
+	})
+	uint16Occs = hegel.Map(hegel.Integers(0, 65535), func(v int) occurrence { return occurrence{strconv.Itoa(v), uint16(v)} })
+	int64Occs  = hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), func(v int64) occurrence { return occurrence{strconv.FormatInt(v, 10), v} })
+	// durationOccs: a duration within 2^40 nanoseconds in its own spelling,
+	// or one of a pool of spellings three times in ten.
+	durationOccs = weighted(
+		choice[occurrence]{70, hegel.Map(hegel.Integers[int64](-1<<40, 1<<40), func(n int64) occurrence { d := time.Duration(n); return occurrence{d.String(), d} })},
+		choice[occurrence]{30, fromPool(durationPool, parseDur)},
+	)
+	// countOccs: "+1" (one more) three times in five, else a count set outright.
+	countOccs = weighted(
+		choice[occurrence]{60, hegel.Just(occurrence{"+1", 1})},
+		choice[occurrence]{40, hegel.Map(hegel.Integers(-5, 100), func(v int) occurrence { return occurrence{strconv.Itoa(v), v} })},
+	)
+
+	ipv4s = hegel.Map(fixed(hegel.Integers(0, 255), 4), func(b []int) net.IP { return net.IPv4(byte(b[0]), byte(b[1]), byte(b[2]), byte(b[3])) })
+	// ipTexts: an IP and a spelling: dotted IPv4, ::1, a 2001:db8:: address,
+	// or an IPv4 in its mapped form.
+	ipTexts = hegel.OneOf(
+		hegel.Map(ipv4s, func(ip net.IP) occurrence { return occurrence{ip.String(), ip} }),
+		hegel.Just(occurrence{"::1", net.ParseIP("::1")}),
+		hegel.Map(hegel.Integers(0, 65535), func(n int) occurrence { s := fmt.Sprintf("2001:db8::%x", n); return occurrence{s, net.ParseIP(s)} }),
+		hegel.Map(ipv4s, func(ip net.IP) occurrence { return occurrence{"::ffff:" + ip.String(), ip} }),
+	)
+	// ipOccs: an IP text, padded with spaces once in five.
+	ipOccs = hegel.Map(pairs(ipTexts, chance(20)), func(p pair[occurrence, bool]) occurrence {
+		if p.b {
+			return occurrence{" " + p.a.text + " ", p.a.val}
+		}
+		return p.a
+	})
+	// maskBytes: a CIDR mask of 0 to 32 bits three times in five, else four random bytes.
+	maskBytes = weighted(
+		choice[[]byte]{60, hegel.Map(hegel.Integers(0, 32), func(bits int) []byte { return []byte(net.CIDRMask(bits, 32)) })},
+		choice[[]byte]{40, hegel.Map(fixed(hegel.Integers(0, 255), 4), func(b []int) []byte { return []byte{byte(b[0]), byte(b[1]), byte(b[2]), byte(b[3])} })},
+	)
+	// ipMaskOccs: a mask written dotted, or in hex half of the time.
+	ipMaskOccs = hegel.Map(pairs(maskBytes, chance(50)), func(p pair[[]byte, bool]) occurrence {
+		b := p.a
+		m := net.IPv4Mask(b[0], b[1], b[2], b[3])
+		if p.b {
+			return occurrence{m.String(), m}
+		}
+		return occurrence{fmt.Sprintf("%d.%d.%d.%d", b[0], b[1], b[2], b[3]), m}
+	})
+	// ipNetOccs: an IPv4 network seven times in ten, else an IPv6 one.
+	ipNetOccs = weighted(
+		choice[occurrence]{70, hegel.Map(pairs(ipv4s, hegel.Integers(0, 32)), func(p pair[net.IP, int]) occurrence { return cidrOcc(fmt.Sprintf("%s/%d", p.a, p.b)) })},
+		choice[occurrence]{30, hegel.Map(pairs(hegel.Integers(0, 65535), hegel.Integers(0, 128)), func(p pair[int, int]) occurrence { return cidrOcc(fmt.Sprintf("2001:db8:%x::/%d", p.a, p.b)) })},
+	)
+	byteStrings = hegel.Binary(0, 8)
+	// hexOccs: the hex of up to eight bytes, upper-cased half of the time,
+	// padded with blanks once in five.
+	hexOccs = hegel.Composite(func(tc hegel.TestCase) occurrence {
+		b := hegel.Draw(tc, byteStrings)
+		s := fmt.Sprintf("%x", b)
+		if hegel.Draw(tc, chance(50)) {
+			s = strings.ToUpper(s)
+		}
+		if hegel.Draw(tc, chance(20)) {
+			s = " " + s + "\t"
+		}
+		return occurrence{s, b}
+	})
+	base64Occs = hegel.Map(byteStrings, func(b []byte) occurrence { return occurrence{base64.StdEncoding.EncodeToString(b), b} })
+	// stringSliceOccs: up to three elements written as CSV; the value is
+	// what encoding/csv reads back (a lone empty element is no element, a
+	// quoted CRLF a LF: the argument itself is CSV).
+	stringSliceOccs = hegel.Map(many(hegel.SampledFrom(textPool), 0, 3), func(elems []string) occurrence {
+		text := csvText(elems)
+		v, err := readAsCSV(text)
+		if err != nil {
+			panic(err)
+		}
+		return occurrence{text, v}
+	})
+	// stringArrayOccs: one element, not CSV; under HEGEL_NO_KNOWN=1 none that
+	// is empty or holds a CR (pflag/1).
+	stringArrayOccs = hegel.Map(hegel.SampledFrom(shaped(textPool, csvPool)), func(s string) occurrence { return occurrence{s, []string{s}} })
+	intSliceOccs    = joined(hegel.Map(hegel.Integers(-1000, 1000), func(v int) occurrence { return occurrence{strconv.Itoa(v), v} }), collectAs[int])
+	// float64SliceOccs: elements of the float64 pool; under HEGEL_NO_KNOWN=1
+	// only values %f renders exactly (pflag/2).
+	float64SliceOccs  = joined(fromPool(shaped(float64Pool, exactFloatPool), parse64), collectAs[float64])
+	boolSliceOccs     = joined(fromPool(boolSlicePool, parseBool), collectAs[bool])
+	durationSliceOccs = joined(durationOccs, collectAs[time.Duration])
+	ipSliceOccs       = joined(ipTexts, collectAs[net.IP])
+	// stringToStringOccs: one to three key=value pairs (a later one wins), a
+	// single pair as it is (commas are part of the value), several as CSV.
+	// The value pool holds a quoted value (pflag/6) except under HEGEL_NO_KNOWN=1.
+	stringToStringOccs = hegel.Map(many(pairs(hegel.SampledFrom(keyPool), hegel.SampledFrom(shaped(quotedKVPool, kvPool))), 1, 3), func(kvs []pair[string, string]) occurrence {
+		m := map[string]string{}
+		recs := make([]string, len(kvs))
+		for i, kv := range kvs {
+			m[kv.a] = kv.b
+			recs[i] = kv.a + "=" + kv.b
+		}
+		if len(recs) == 1 {
+			return occurrence{recs[0], m}
+		}
+		return occurrence{csvText(recs), m}
+	})
+	stringToIntOccs = hegel.Map(many(pairs(hegel.SampledFrom(keyPool), hegel.Integers(-100, 100)), 1, 3), func(kvs []pair[string, int]) occurrence {
+		m := map[string]int{}
+		recs := make([]string, len(kvs))
+		for i, kv := range kvs {
+			m[kv.a] = kv.b
+			recs[i] = kv.a + "=" + strconv.Itoa(kv.b)
+		}
+		return occurrence{strings.Join(recs, ","), m}
+	})
+	// timeOccs: an instant within 2^35 seconds of the epoch, in a fixed
+	// zone three times in ten, written in one of the flag's layouts
+	// (RFC3339Nano, RFC3339 to the second, or the date alone at UTC).
+	timeOccs = hegel.Composite(func(tc hegel.TestCase) occurrence {
+		tm := time.Unix(int64(hegel.Draw(tc, hegel.Integers(-1<<35, 1<<35))), int64(hegel.Draw(tc, hegel.Integers(0, 999999999)))).UTC()
+		if zone := hegel.Draw(tc, optional(30, hegel.Integers(-14, 14))); zone != nil {
+			tm = tm.In(time.FixedZone("", *zone*3600))
+		}
+		switch hegel.Draw(tc, hegel.Integers(0, 2)) {
+		case 0:
+			return occurrence{tm.Format(time.RFC3339Nano), tm}
+		case 1:
+			tm = tm.Truncate(time.Second)
+			return occurrence{tm.Format(time.RFC3339), tm}
+		default:
+			tm = time.Date(tm.Year(), tm.Month(), tm.Day(), 0, 0, 0, 0, time.UTC)
+			return occurrence{tm.Format(time.DateOnly), tm}
+		}
+	})
+)
+
+func cidrOcc(s string) occurrence {
+	_, nw, err := net.ParseCIDR(s)
+	if err != nil {
+		panic(err)
+	}
+	return occurrence{s, *nw}
+}
+
+var vkinds = []vkind{
+	{
+		name: "int8",
+		define: func(fs *pflag.FlagSet, name string) func() any {
