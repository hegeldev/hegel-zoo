+// pflag/6
+func TestHegelPinStringToStringQuotedSinglePair(t *testing.T) {
+	defer guard(t)
+	whole := newSet(true)
+	pw := whole.StringToString("m", nil, "u")
+	if err := whole.Set("m", `"k=v"`); err != nil {
+		t.Fatal(err)
+	}
+	if (*pw)["k"] != "v" {
+		t.Fatalf(`"k=v" gives k=%q`, (*pw)["k"])
+	}
+	value := newSet(true)
+	pv := value.StringToString("m", nil, "u")
+	if err := value.Set("m", `k="v"`); err != nil {
+		t.Fatal(err)
+	}
+	if got := (*pv)["k"]; got != "v" && got != `"v"` {
+		t.Errorf(`k="v" gives k=%q: neither the quotes stripped (as for "k=v") nor kept`, got)
+	}
+}
