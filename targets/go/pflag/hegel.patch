+func genIPv4(tc hegel.TestCase) net.IP {
+	return net.IPv4(byte(n(tc, 0, 255)), byte(n(tc, 0, 255)), byte(n(tc, 0, 255)), byte(n(tc, 0, 255)))
+}
+
+func genIP(tc hegel.TestCase) (string, net.IP) {
+	switch n(tc, 0, 4) {
+	case 0:
+		return "::1", net.ParseIP("::1")
+	case 1:
+		s := fmt.Sprintf("2001:db8::%x", n(tc, 0, 65535))
+		return s, net.ParseIP(s)
+	case 2:
+		ip := genIPv4(tc)
+		return "::ffff:" + ip.String(), ip
+	default:
+		ip := genIPv4(tc)
+		return ip.String(), ip
+	}
+}
+
+func genBytes(tc hegel.TestCase) []byte {
+	b := make([]byte, n(tc, 0, 8))
+	for i := range b {
+		b[i] = byte(n(tc, 0, 255))
+	}
+	return b
+}
+
+func hexText(tc hegel.TestCase, b []byte) string {
+	s := fmt.Sprintf("%x", b)
+	if chance(tc, 50) {
+		s = strings.ToUpper(s)
+	}
+	if chance(tc, 20) {
+		s = " " + s + "\t"
+	}
+	return s
+}
+
+func genDuration(tc hegel.TestCase) (string, time.Duration) {
+	if chance(tc, 30) {
+		s := pick(tc, []string{"1h30m", "-1.5s", "0", "1us", "1h2m", "1.000000001s", "300ms"})
+		d, _ := time.ParseDuration(s)
+		return s, d
+	}
+	d := time.Duration(n(tc, -1<<40, 1<<40))
+	return d.String(), d
+}
+
+func csvText(elems []string) string {
+	var b strings.Builder
+	w := csv.NewWriter(&b)
+	_ = w.Write(elems)
+	w.Flush()
+	return strings.TrimSuffix(b.String(), "\n")
+}
