+func TestHegelPinGetStringArrayKeepsEveryElement(t *testing.T) {
+	defer guard(t)
+	for _, in := range []string{"", "a\r\nb"} {
+		fs := newSet(true)
+		p := fs.StringArray("s", nil, "u")
+		if err := fs.Set("s", in); err != nil {
+			t.Fatal(err)
+		}
+		got, err := fs.GetStringArray("s")
+		if err != nil {
+			t.Fatalf("GetStringArray after Set(%q): %v", in, err)
+		}
+		if !reflect.DeepEqual(got, *p) {
+			t.Errorf("after Set(%q) the variable holds %q but GetStringArray returns %q (Value.String()=%q)", in, *p, got, fs.Lookup("s").Value.String())
+		}
+	}
+}
