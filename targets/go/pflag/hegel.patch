+
+// use is an occurrence and how it is written: --flag=text when glued (and
+// always for a kind that takes no separate argument), else --flag text.
+type use struct {
+	occurrence
+	glued bool
+}
+
+// typedCase: a kind and up to three uses of its flag.
+type typedCase struct {
+	kind int
+	uses []use
+}
+
+var typedCases = hegel.FlatMap(hegel.Integers(0, len(vkinds)-1), func(k int) hegel.Generator[typedCase] {
+	uses := hegel.Map(pairs(vkinds[k].occ, chance(50)), func(p pair[occurrence, bool]) use { return use{p.a, p.b} })
+	return hegel.Map(many(uses, 0, 3), func(us []use) typedCase { return typedCase{kind: k, uses: us} })
+})
+
+func (c typedCase) vk() vkind { return vkinds[c.kind] }
+
+func (c typedCase) argv() []string {
+	vk := c.vk()
+	var argv []string
+	for _, u := range c.uses {
+		if vk.noOpt || u.glued {
+			argv = append(argv, "--flag="+u.text)
+		} else {
+			argv = append(argv, "--flag", u.text)
+		}
+	}
+	return argv
+}
+
+// model is the value the parsers give the flag after all its uses: the last
+// wins for a scalar, a count adds up, a slice appends, a map merges.
+func (c typedCase) model() any {
+	vk := c.vk()
+	var model any
+	for i, u := range c.uses {
+		switch {
+		case vk.name == "count":
+			if u.text == "+1" {
+				if i == 0 {
+					model = 1
+				} else {
+					model = model.(int) + 1
+				}
+			} else {
+				model = u.val
+			}
+		case vk.combine != nil:
+			model = vk.combine(model, i == 0, u.val)
+		default:
+			model = u.val
+		}
+	}
+	return model
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c typedCase) GoString() string { return fmt.Sprintf("kind=%s argv=%q", c.vk().name, c.argv()) }
+
+func TestHegelTypedValuesRoundTripThroughGet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, typedCases)
+		vk, argv := c.vk(), c.argv()
+		fs := newSet(true)
+		read := vk.define(fs, "flag")
+		if err := fs.Parse(argv); err != nil {
+			fail(ht, "%s: Parse(%q) failed: %v", vk.name, argv, err)
+		}
+		eq := vk.eq
+		if eq == nil {
+			eq = func(a, b any) bool { return reflect.DeepEqual(norm(a), norm(b)) }
+		}
+		if len(c.uses) > 0 {
+			got, model := read(), c.model()
+			if !eq(got, model) {
+				fail(ht, "%s: after Parse(%q) the bound variable is %#v, the parsers say %#v", vk.name, argv, got, model)
+			}
+		}
+		// the accessor re-reads the flag through Value.String(); on the nil
+		// default of ipMask/ipNet that is the shape of pflag/3, checked by
+		// default and skipped under HEGEL_NO_KNOWN=1
+		want := read()
+		if !(len(c.uses) == 0 && vk.nilGet && noKnown) {
+			got, err := vk.get(fs, "flag")
+			if err != nil {
+				fail(ht, "%s: after Parse(%q) Get failed: %v (Value.String()=%q)", vk.name, argv, err, fs.Lookup("flag").Value.String())
+			}
+			if !eq(got, want) {
+				fail(ht, "%s: after Parse(%q) Get returns %#v but the bound variable is %#v (Value.String()=%q)", vk.name, argv, got, want, fs.Lookup("flag").Value.String())
+			}
+		}
+		// and for a scalar, Set(String()) on a fresh flag reproduces the value
+		if vk.combine == nil && !vk.noOpt && len(c.uses) > 0 {
+			fs2 := newSet(true)
+			read2 := vk.define(fs2, "flag")
+			str := fs.Lookup("flag").Value.String()
+			if err := fs2.Set("flag", str); err != nil {
+				fail(ht, "%s: Set(String()=%q) failed: %v (value %#v)", vk.name, str, err, want)
+			} else if got2 := read2(); !eq(got2, want) {
+				fail(ht, "%s: Set(String()=%q) gives %#v, the flag holds %#v", vk.name, str, got2, want)
+			}
+		}
+	})
+}
