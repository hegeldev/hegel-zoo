+func TestHegelTypedValuesRoundTripThroughGet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		vk := pick(ht, vkinds)
+		fs := newSet(true)
+		read := vk.define(fs, "flag")
+		k := n(ht, 0, 3)
+		var (
+			argv  []string
+			texts []string
+			model any
+		)
+		for i := 0; i < k; i++ {
+			text, val := vk.gen(ht)
+			texts = append(texts, text)
+			if vk.noOpt || chance(ht, 50) {
+				argv = append(argv, "--flag="+text)
+			} else {
+				argv = append(argv, "--flag", text)
+			}
+			switch {
+			case vk.name == "count":
+				if text == "+1" {
+					if i == 0 {
+						model = 1
+					} else {
+						model = model.(int) + 1
+					}
+				} else {
+					model = val
+				}
+			case vk.combine != nil:
+				model = vk.combine(model, i == 0, val)
+			default:
+				model = val
+			}
+		}
+		note(ht, "kind=%s texts=%q", vk.name, texts)
+		if err := fs.Parse(argv); err != nil {
+			fail(ht, "%s: Parse(%q) failed: %v", vk.name, argv, err)
+		}
+		eq := vk.eq
+		if eq == nil {
+			eq = func(a, b any) bool { return reflect.DeepEqual(norm(a), norm(b)) }
+		}
+		if k > 0 {
+			got := read()
+			if !eq(got, model) {
+				fail(ht, "%s: after Parse(%q) the bound variable is %#v, the parsers say %#v", vk.name, argv, got, model)
+			}
+		}
+		if k == 0 && vk.nilGet {
+			return
+		}
+		// the accessor re-reads the flag through Value.String()
+		got, err := vk.get(fs, "flag")
+		if err != nil {
+			fail(ht, "%s: after Parse(%q) Get failed: %v (Value.String()=%q)", vk.name, argv, err, fs.Lookup("flag").Value.String())
+		}
+		want := read()
+		if !eq(got, want) {
+			fail(ht, "%s: after Parse(%q) Get returns %#v but the bound variable is %#v (Value.String()=%q)", vk.name, argv, got, want, fs.Lookup("flag").Value.String())
+		}
+		// and for a scalar, Set(String()) on a fresh flag reproduces the value
+		if vk.combine == nil && !vk.noOpt && k > 0 {
+			fs2 := newSet(true)
+			read2 := vk.define(fs2, "flag")
+			str := fs.Lookup("flag").Value.String()
+			if err := fs2.Set("flag", str); err != nil {
+				fail(ht, "%s: Set(String()=%q) failed: %v (value %#v)", vk.name, str, err, want)
+			} else if got2 := read2(); !eq(got2, want) {
+				fail(ht, "%s: Set(String()=%q) gives %#v, the flag holds %#v", vk.name, str, got2, want)
+			}
+		}
+	})
+}
