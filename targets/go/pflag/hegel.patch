+package pflag_test
+
+import (
+	"encoding/base64"
+	"encoding/csv"
+	"errors"
+	goflag "flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+// Property-based tests for spf13/pflag. The oracles: the standard library's
+// flag package on the syntax the two share (pflag is documented as a drop-in
+// replacement), a model of the README's "Command line flag syntax" section
+// (long options, shorthand bundles, no-option defaults, "--", interspersed
+// arguments and the unknown-flag handling modes), the strconv/net/time/csv
+// parsers behind each typed Value together with the FlagSet.GetX accessors,
+// the documented usage layout (wrapped to N columns, "(default X)" only for
+// non-zero defaults), and flag-name normalisation. Collect mode
+// (PFLAG_COLLECT=1) prints every disagreement instead of failing.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("PFLAG_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func newSet(interspersed bool) *pflag.FlagSet {
+	fs := pflag.NewFlagSet("zoo", pflag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	fs.SetInterspersed(interspersed)
+	return fs
+}
+
+func newGoSet() *goflag.FlagSet {
+	fs := goflag.NewFlagSet("zoo", goflag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	return fs
+}
+
+var flagNames = []string{"alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"}
+
+// distinct draws k distinct names from the pool.
+func distinct(tc hegel.TestCase, k int) []string {
+	pool := append([]string(nil), flagNames...)
+	out := make([]string, 0, k)
+	for i := 0; i < k && len(pool) > 0; i++ {
+		j := n(tc, 0, len(pool)-1)
+		out = append(out, pool[j])
+		pool = append(pool[:j], pool[j+1:]...)
+	}
+	return out
+}
+
+func visited(fn func(func(name string))) []string {
+	var names []string
+	fn(func(name string) { names = append(names, name) })
+	sort.Strings(names)
+	return names
+}
+
+func argsOf(a []string) []string {
+	if a == nil {
+		return []string{}
+	}
+	return a
+}
+
+// --------------------------------------------- 1. the syntax shared with flag
+
+type sharedKind int
+
+const (
+	shBool sharedKind = iota
+	shInt
+	shInt64
+	shUint
+	shUint64
+	shFloat
+	shString
+	shDuration
+	shNumKinds
+)
+
+type sharedFlag struct {
+	name string
+	kind sharedKind
+	def  string // textual default
+}
+
+var sharedDefaults = map[sharedKind][]string{
+	shBool:     {"false", "true"},
+	shInt:      {"0", "1", "-7", "1099511627776"},
+	shInt64:    {"0", "-1", "9223372036854775807"},
+	shUint:     {"0", "3"},
+	shUint64:   {"0", "18446744073709551615"},
+	shFloat:    {"0", "1.5", "-2.25"},
+	shString:   {"", "x", "hello world"},
+	shDuration: {"0s", "1.5s", "2h0m0s"},
+}
+
+// bound holds the variables a flag set was bound to; read() renders the one
+// in use.
+type bound struct {
+	kind sharedKind
+	b    *bool
+	i    *int
+	i64  *int64
+	u    *uint
+	u64  *uint64
+	f    *float64
+	s    *string
+	d    *time.Duration
+}
+
+func (b bound) read() string {
+	switch b.kind {
+	case shBool:
+		return strconv.FormatBool(*b.b)
+	case shInt:
+		return strconv.Itoa(*b.i)
+	case shInt64:
+		return strconv.FormatInt(*b.i64, 10)
+	case shUint:
+		return strconv.FormatUint(uint64(*b.u), 10)
+	case shUint64:
+		return strconv.FormatUint(*b.u64, 10)
+	case shFloat:
+		return strconv.FormatFloat(*b.f, 'g', -1, 64)
+	case shString:
+		return *b.s
+	default:
+		return b.d.String()
+	}
+}
+
+func mustInt(s string) int64 {
+	v, err := strconv.ParseInt(s, 10, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustUint(s string) uint64 {
+	v, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustFloat(s string) float64 {
+	v, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func mustDur(s string) time.Duration {
+	v, err := time.ParseDuration(s)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+func defineGo(fs *goflag.FlagSet, f sharedFlag) bound {
+	b := bound{kind: f.kind}
+	switch f.kind {
+	case shBool:
+		b.b = fs.Bool(f.name, f.def == "true", "u")
+	case shInt:
+		b.i = fs.Int(f.name, int(mustInt(f.def)), "u")
+	case shInt64:
+		b.i64 = fs.Int64(f.name, mustInt(f.def), "u")
+	case shUint:
+		b.u = fs.Uint(f.name, uint(mustUint(f.def)), "u")
+	case shUint64:
+		b.u64 = fs.Uint64(f.name, mustUint(f.def), "u")
+	case shFloat:
+		b.f = fs.Float64(f.name, mustFloat(f.def), "u")
+	case shString:
+		b.s = fs.String(f.name, f.def, "u")
+	default:
+		b.d = fs.Duration(f.name, mustDur(f.def), "u")
+	}
+	return b
+}
+
+func definePflag(fs *pflag.FlagSet, f sharedFlag) bound {
+	b := bound{kind: f.kind}
+	switch f.kind {
+	case shBool:
+		b.b = fs.Bool(f.name, f.def == "true", "u")
+	case shInt:
+		b.i = fs.Int(f.name, int(mustInt(f.def)), "u")
+	case shInt64:
+		b.i64 = fs.Int64(f.name, mustInt(f.def), "u")
+	case shUint:
+		b.u = fs.Uint(f.name, uint(mustUint(f.def)), "u")
+	case shUint64:
+		b.u64 = fs.Uint64(f.name, mustUint(f.def), "u")
+	case shFloat:
+		b.f = fs.Float64(f.name, mustFloat(f.def), "u")
+	case shString:
+		b.s = fs.String(f.name, f.def, "u")
+	default:
+		b.d = fs.Duration(f.name, mustDur(f.def), "u")
+	}
+	return b
+}
+
+var sharedValues = []string{
+	"1", "0", "-1", "0x1F", "0b101", "0o17", "017", "1_000", "3.5", "1e3", "-0", "inf", "NaN",
+	"true", "false", "t", "F", "TRUE", "yes",
+	"1h", "1.5s", "-3m", "1s500ms", "1h-2m",
+	"abc", "", "x y", `"q"`, "a,b", "-",
+	"9223372036854775807", "9223372036854775808", "18446744073709551615", "18446744073709551616",
+}
+
+var positionals = []string{"file", "", "-", "a b", "x=y", "1", "-", "./p"}
+
+func genSharedArgv(tc hegel.TestCase, flags []sharedFlag) []string {
+	var argv []string
+	for k := n(tc, 0, 5); k > 0; k-- {
+		if chance(tc, 4) {
+			switch n(tc, 0, 2) {
+			case 0:
+				argv = append(argv, "--nope")
+			case 1:
+				argv = append(argv, "--nope=1")
+			default:
+				argv = append(argv, "--help")
+			}
+			continue
+		}
+		f := pick(tc, flags)
+		switch n(tc, 0, 2) {
+		case 0:
+			argv = append(argv, "--"+f.name)
+		case 1:
+			argv = append(argv, "--"+f.name+"="+pick(tc, sharedValues))
+		default:
+			argv = append(argv, "--"+f.name, pick(tc, sharedValues))
+		}
+	}
+	for k := n(tc, 0, 2); k > 0; k-- {
+		argv = append(argv, pick(tc, positionals))
+	}
+	if chance(tc, 30) {
+		argv = append(argv, "--")
+		for k := n(tc, 0, 2); k > 0; k-- {
+			argv = append(argv, pick(tc, []string{"--x", "-y", "z", "", "--"}))
+		}
+	}
+	return argv
+}
+
+type parseOutcome struct {
+	err     error
+	help    bool
+	values  []string
+	args    []string
+	nflag   int
+	visited []string
+}
+
+func (o parseOutcome) String() string {
+	if o.err != nil {
+		return fmt.Sprintf("error %q (help=%v)", o.err.Error(), o.help)
+	}
+	return fmt.Sprintf("values=%q args=%q nflag=%d visited=%q", o.values, o.args, o.nflag, o.visited)
+}
+
+func sameOutcome(a, b parseOutcome) bool {
+	if (a.err == nil) != (b.err == nil) {
+		return false
+	}
+	if a.err != nil {
+		return a.help == b.help
+	}
+	return reflect.DeepEqual(a.values, b.values) && reflect.DeepEqual(argsOf(a.args), argsOf(b.args)) &&
+		a.nflag == b.nflag && reflect.DeepEqual(a.visited, b.visited)
+}
+
+func readAll(bs []bound) []string {
+	out := make([]string, len(bs))
+	for i, b := range bs {
+		out[i] = b.read()
+	}
+	return out
+}
+
+func TestHegelSharedSyntaxAgreesWithStdlibFlag(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		names := distinct(ht, n(ht, 1, 5))
+		flags := make([]sharedFlag, len(names))
+		for i, name := range names {
+			k := sharedKind(n(ht, 0, int(shNumKinds)-1))
+			flags[i] = sharedFlag{name: name, kind: k, def: pick(ht, sharedDefaults[k])}
+		}
+		argv := genSharedArgv(ht, flags)
+		note(ht, "flags=%+v argv=%q", flags, argv)
+
+		// the reference: the standard library
+		gs := newGoSet()
+		gb := make([]bound, len(flags))
+		for i, f := range flags {
+			gb[i] = defineGo(gs, f)
+		}
+		gerr := gs.Parse(argv)
+		want := parseOutcome{err: gerr, help: errors.Is(gerr, goflag.ErrHelp), values: readAll(gb), args: gs.Args(), nflag: gs.NFlag(),
+			visited: visited(func(f func(string)) { gs.Visit(func(fl *goflag.Flag) { f(fl.Name) }) })}
+
+		// pflag with the same definitions, interspersed off (flag stops at the first non-flag)
+		ps := newSet(false)
+		pb := make([]bound, len(flags))
+		for i, f := range flags {
+			pb[i] = definePflag(ps, f)
+		}
+		perr := ps.Parse(argv)
+		got := parseOutcome{err: perr, help: errors.Is(perr, pflag.ErrHelp), values: readAll(pb), args: ps.Args(), nflag: ps.NFlag(),
+			visited: visited(func(f func(string)) { ps.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag vs flag on %q\n flag:  %s\n pflag: %s", argv, want, got)
+		}
+
+		// pflag wrapping a flag.FlagSet (AddGoFlagSet)
+		gs2 := newGoSet()
+		gb2 := make([]bound, len(flags))
+		for i, f := range flags {
+			gb2[i] = defineGo(gs2, f)
+		}
+		ws := newSet(false)
+		ws.AddGoFlagSet(gs2)
+		werr := ws.Parse(argv)
+		got = parseOutcome{err: werr, help: errors.Is(werr, pflag.ErrHelp), values: readAll(gb2), args: ws.Args(), nflag: ws.NFlag(),
+			visited: visited(func(f func(string)) { ws.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag.AddGoFlagSet vs flag on %q\n flag:  %s\n pflag: %s", argv, want, got)
+		}
+
+		// a flag.FlagSet filled from pflag (CopyToGoFlagSet)
+		ps3 := newSet(false)
+		pb3 := make([]bound, len(flags))
+		for i, f := range flags {
+			pb3[i] = definePflag(ps3, f)
+		}
+		gs3 := newGoSet()
+		ps3.CopyToGoFlagSet(gs3)
+		cerr := gs3.Parse(argv)
+		got = parseOutcome{err: cerr, help: errors.Is(cerr, goflag.ErrHelp), values: readAll(pb3), args: gs3.Args(), nflag: gs3.NFlag(),
+			visited: visited(func(f func(string)) { gs3.Visit(func(fl *goflag.Flag) { f(fl.Name) }) })}
+		if !sameOutcome(want, got) {
+			fail(ht, "pflag.CopyToGoFlagSet vs flag on %q\n flag:  %s\n copy:  %s", argv, want, got)
+		}
+	})
+}
+
+// ------------------------------------------------ 2. the documented grammar
+
+type gKind int
+
+const (
+	gBool gKind = iota
+	gCount
+	gString
+	gInt
+	gSlice
+	gArray
+	gOptString
+	gOptInt
+	gNumKinds
+)
+
+var gKindNames = []string{"bool", "count", "string", "int", "stringSlice", "stringArray", "string[=opt]", "int[=42]"}
+
+type gFlag struct {
+	name  string
+	short byte // 0 for none
+	kind  gKind
+	noOpt string // "" for value-taking flags
+}
+
+func (f gFlag) String() string {
+	s := "--" + f.name
+	if f.short != 0 {
+		s += "/-" + string(f.short)
+	}
+	return s + ":" + gKindNames[f.kind]
+}
+
+type gBound struct {
+	b  *bool
+	i  *int
+	s  *string
+	ss *[]string
+}
+
+type gState struct {
+	changed bool
+	b       bool
+	i       int
+	s       string
+	ss      []string
+}
+
+func (st gState) value(k gKind) any {
+	switch k {
+	case gBool:
+		return st.b
+	case gCount, gInt, gOptInt:
+		return st.i
+	case gString, gOptString:
+		return st.s
+	default:
+		return argsOf(st.ss)
+	}
+}
+
+func (b gBound) value(k gKind) any {
+	switch k {
+	case gBool:
+		return *b.b
+	case gCount, gInt, gOptInt:
+		return *b.i
+	case gString, gOptString:
+		return *b.s
+	default:
+		return argsOf(*b.ss)
+	}
+}
+
+func defineG(fs *pflag.FlagSet, f gFlag) gBound {
+	short := ""
+	if f.short != 0 {
+		short = string(f.short)
+	}
+	var b gBound
+	switch f.kind {
+	case gBool:
+		b.b = fs.BoolP(f.name, short, false, "u")
+	case gCount:
+		b.i = fs.CountP(f.name, short, "u")
+	case gString:
+		b.s = fs.StringP(f.name, short, "", "u")
+	case gInt:
+		b.i = fs.IntP(f.name, short, 0, "u")
+	case gSlice:
+		b.ss = fs.StringSliceP(f.name, short, nil, "u")
+	case gArray:
+		b.ss = fs.StringArrayP(f.name, short, nil, "u")
+	case gOptString:
+		b.s = fs.StringP(f.name, short, "", "u")
+		fs.Lookup(f.name).NoOptDefVal = f.noOpt
+	default:
+		b.i = fs.IntP(f.name, short, 0, "u")
+		fs.Lookup(f.name).NoOptDefVal = f.noOpt
+	}
+	return b
+}
+
+func genGFlags(tc hegel.TestCase) []gFlag {
+	names := distinct(tc, n(tc, 1, 5))
+	shorts := []byte("abcdefgh")
+	out := make([]gFlag, len(names))
+	for i, name := range names {
+		f := gFlag{name: name, kind: gKind(n(tc, 0, int(gNumKinds)-1))}
+		if chance(tc, 75) && len(shorts) > 0 {
+			j := n(tc, 0, len(shorts)-1)
+			f.short = shorts[j]
+			shorts = append(shorts[:j], shorts[j+1:]...)
+		}
+		switch f.kind {
+		case gBool:
+			f.noOpt = "true"
+		case gCount:
+			f.noOpt = "+1"
+		case gOptString:
+			f.noOpt = "opt"
+		case gOptInt:
+			f.noOpt = "42"
+		}
+		out[i] = f
+	}
+	return out
+}
+
+var gValues = []string{"1", "0", "-2", "0x10", "true", "false", "t", "yes", "", "a,b", `"a,b",c`, `a"b`, "+1", "3x", "1_0", "-", "x=y", "é"}
+
+type modelErr int
+
+const (
+	errNone modelErr = iota
+	errHelp
+	errUnknown
+	errValueRequired
+	errInvalidValue
+	errSyntax
+)
+
+var modelErrNames = []string{"ok", "help", "unknown flag", "value required", "invalid value", "invalid syntax"}
+
+func classify(err error) modelErr {
+	var (
+		ne *pflag.NotExistError
+		vr *pflag.ValueRequiredError
+		iv *pflag.InvalidValueError
+		is *pflag.InvalidSyntaxError
+	)
+	switch {
+	case err == nil:
+		return errNone
+	case errors.Is(err, pflag.ErrHelp):
+		return errHelp
+	case errors.As(err, &ne):
+		return errUnknown
+	case errors.As(err, &vr):
+		return errValueRequired
+	case errors.As(err, &iv):
+		return errInvalidValue
+	case errors.As(err, &is):
+		return errSyntax
+	}
+	return -1
+}
+
+type gMode int
+
+const (
+	modeError gMode = iota
+	modeIgnore
+	modePass
+)
+
+var gModeNames = []string{"error", "ignore", "pass"}
+
+// genGArgv builds a command line from the grammar's tokens. In ignore mode an
+// unknown shorthand is only ever the last letter of a bundle (a letter after
+// it would take its value from the original argument list, which the README
+// does not describe).
+func genGArgv(tc hegel.TestCase, flags []gFlag, mode gMode) []string {
+	var shorts []byte
+	takesValue := map[byte]bool{}
+	for _, f := range flags {
+		if f.short != 0 {
+			shorts = append(shorts, f.short)
+			takesValue[f.short] = f.noOpt == ""
+		}
+	}
+	unknownShorts := []byte("xyh")
+	var argv []string
+	for k := n(tc, 0, 6); k > 0; k-- {
+		switch w := n(tc, 1, 100); {
+		case w <= 30: // long known
+			f := pick(tc, flags)
+			switch n(tc, 0, 2) {
+			case 0:
+				argv = append(argv, "--"+f.name)
+			case 1:
+				argv = append(argv, "--"+f.name+"="+pick(tc, gValues))
+			default:
+				argv = append(argv, "--"+f.name, pick(tc, gValues))
+			}
+		case w <= 65 && len(shorts) > 0: // shorthand bundle
+			var b strings.Builder
+			b.WriteByte('-')
+			unknownLast := false
+			for m := n(tc, 1, 3); m > 0; m-- {
+				if chance(tc, 8) {
+					b.WriteByte(pick(tc, unknownShorts))
+					if mode == modeIgnore {
+						unknownLast = true
+						break
+					}
+					continue
+				}
+				b.WriteByte(pick(tc, shorts))
+			}
+			form := n(tc, 0, 3)
+			if mode == modeIgnore && form == 2 {
+				// glued text after a letter that does not consume it would be
+				// read as more shorthands, and an unknown one there strips an
+				// argument the README says nothing about
+				last := b.String()[b.Len()-1]
+				if unknownLast || !takesValue[last] {
+					form = 0
+				}
+			}
+			switch form {
+			case 0:
+				argv = append(argv, b.String())
+			case 1:
+				argv = append(argv, b.String()+"="+pick(tc, gValues))
+			case 2:
+				argv = append(argv, b.String()+pick(tc, gValues))
+			default:
+				argv = append(argv, b.String(), pick(tc, gValues))
+			}
+		case w <= 82: // positional
+			argv = append(argv, pick(tc, positionals))
+		case w <= 90: // unknown long
+			switch n(tc, 0, 2) {
+			case 0:
+				argv = append(argv, "--nope")
+			case 1:
+				argv = append(argv, "--nope="+pick(tc, gValues))
+			default:
+				argv = append(argv, "--nope", pick(tc, gValues))
+			}
+		case w <= 93:
+			argv = append(argv, pick(tc, []string{"--help", "---x", "--=v", "--" + pick(tc, flagNames) + "-"}))
+		default: // terminator
+			argv = append(argv, "--")
+			for m := n(tc, 0, 2); m > 0; m-- {
+				argv = append(argv, pick(tc, []string{"--x", "-y", "z", "", "--"}))
+			}
+		}
+	}
+	return argv
+}
+
+type gResult struct {
+	err    modelErr
+	args   []string
+	atDash int
+	states []gState
+}
+
+func (r gResult) String() string {
+	if r.err != errNone {
+		return modelErrNames[r.err]
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "args=%q atDash=%d", r.args, r.atDash)
+	for _, st := range r.states {
+		fmt.Fprintf(&b, " {changed=%v b=%v i=%d s=%q ss=%q}", st.changed, st.b, st.i, st.s, st.ss)
+	}
+	return b.String()
+}
+
+func readAsCSV(val string) ([]string, error) {
+	if val == "" {
+		return []string{}, nil
+	}
+	return csv.NewReader(strings.NewReader(val)).Read()
+}
+
+// modelParse is the README's grammar (plus the unknown-flag handling modes as
+// their doc comments describe them).
+func modelParse(flags []gFlag, argv []string, interspersed bool, mode gMode) gResult {
+	states := make([]gState, len(flags))
+	res := gResult{args: []string{}, atDash: -1}
+	byName := map[string]int{}
+	byShort := map[byte]int{}
+	for i, f := range flags {
+		byName[f.name] = i
+		if f.short != 0 {
+			byShort[f.short] = i
+		}
+	}
+	apply := func(i int, value string) modelErr {
+		f := flags[i]
+		st := &states[i]
+		switch f.kind {
+		case gBool:
+			v, err := strconv.ParseBool(value)
+			if err != nil {
+				return errInvalidValue
+			}
+			st.b = v
+		case gCount:
+			if value == "+1" {
+				st.i++
+			} else {
+				v, err := strconv.ParseInt(value, 0, 0)
+				if err != nil {
+					return errInvalidValue
+				}
+				st.i = int(v)
+			}
+		case gInt, gOptInt:
+			v, err := strconv.ParseInt(value, 0, 64)
+			if err != nil {
+				return errInvalidValue
+			}
+			st.i = int(v)
+		case gString, gOptString:
+			st.s = value
+		case gSlice:
+			v, err := readAsCSV(value)
+			if err != nil {
+				return errInvalidValue
+			}
+			if !st.changed {
+				st.ss = v
+			} else {
+				st.ss = append(st.ss, v...)
+			}
+		default:
+			if !st.changed {
+				st.ss = []string{value}
+			} else {
+				st.ss = append(st.ss, value)
+			}
+		}
+		st.changed = true
+		return errNone
+	}
+	// stripValue drops the argument an unknown flag would have taken.
+	stripValue := func(i int) int {
+		if i < len(argv) && !strings.HasPrefix(argv[i], "-") {
+			return i + 1
+		}
+		return i
+	}
+	fin := func(e modelErr) gResult {
+		res.err = e
+		res.states = states
+		return res
+	}
+	for i := 0; i < len(argv); {
+		s := argv[i]
+		i++
+		if s == "" || s[0] != '-' || s == "-" {
+			res.args = append(res.args, s)
+			if !interspersed {
+				res.args = append(res.args, argv[i:]...)
+				return fin(errNone)
+			}
+			continue
+		}
+		if s == "--" {
+			res.atDash = len(res.args)
+			res.args = append(res.args, argv[i:]...)
+			return fin(errNone)
+		}
+		if strings.HasPrefix(s, "--") {
+			name := s[2:]
+			if name[0] == '-' || name[0] == '=' {
+				return fin(errSyntax)
+			}
+			name, val, hasVal := strings.Cut(name, "=")
+			fi, ok := byName[name]
+			if !ok {
+				if name == "help" {
+					return fin(errHelp)
+				}
+				switch mode {
+				case modeIgnore:
+					if !hasVal {
+						i = stripValue(i)
+					}
+					continue
+				case modePass:
+					res.args = append(res.args, s)
+					continue
+				default:
+					return fin(errUnknown)
+				}
+			}
+			var value string
+			switch {
+			case hasVal:
+				value = val
+			case flags[fi].noOpt != "":
+				value = flags[fi].noOpt
+			case i < len(argv):
+				value = argv[i]
+				i++
+			default:
+				return fin(errValueRequired)
+			}
+			if e := apply(fi, value); e != errNone {
+				return fin(e)
+			}
+			continue
+		}
+		// a shorthand bundle
+		sh := s[1:]
+		passed := ""
+		for sh != "" {
+			c := sh[0]
+			fi, ok := byShort[c]
+			if !ok {
+				if c == 'h' {
+					return fin(errHelp)
+				}
+				switch mode {
+				case modeIgnore:
+					if len(sh) > 2 && sh[1] == '=' {
+						sh = ""
+					} else {
+						i = stripValue(i)
+						sh = sh[1:]
+					}
+					continue
+				case modePass:
+					if len(sh) > 2 && sh[1] == '=' {
+						passed += sh
+						sh = ""
+					} else {
+						passed += sh[:1]
+						sh = sh[1:]
+					}
+					continue
+				default:
+					return fin(errUnknown)
+				}
+			}
+			var value string
+			switch {
+			case len(sh) > 2 && sh[1] == '=':
+				value = sh[2:]
+				sh = ""
+			case flags[fi].noOpt != "":
+				value = flags[fi].noOpt
+				sh = sh[1:]
+			case len(sh) > 1:
+				value = sh[1:]
+				sh = ""
+			case i < len(argv):
+				value = argv[i]
+				i++
+				sh = ""
+			default:
+				return fin(errValueRequired)
+			}
+			if e := apply(fi, value); e != errNone {
+				return fin(e)
+			}
+		}
+		if passed != "" {
+			res.args = append(res.args, "-"+passed)
+		}
+	}
+	return fin(errNone)
+}
+
+func TestHegelParseFollowsTheDocumentedGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		flags := genGFlags(ht)
+		mode := gMode(n(ht, 0, 2))
+		interspersed := chance(ht, 70)
+		argv := genGArgv(ht, flags, mode)
+		note(ht, "flags=%v mode=%s interspersed=%v argv=%q", flags, gModeNames[mode], interspersed, argv)
+		want := modelParse(flags, argv, interspersed, mode)
+
+		fs := newSet(interspersed)
+		switch mode {
+		case modeIgnore:
+			if chance(ht, 50) {
+				fs.ParseErrorsAllowlist.UnknownFlagsHandling = pflag.IgnoreUnknownFlag
+			} else {
+				fs.ParseErrorsAllowlist.UnknownFlags = true
+			}
+		case modePass:
+			fs.ParseErrorsAllowlist.UnknownFlagsHandling = pflag.PassUnknownFlagToArgs
+		}
+		bounds := make([]gBound, len(flags))
+		for i, f := range flags {
+			bounds[i] = defineG(fs, f)
+		}
+		err := fs.Parse(argv)
+		got := gResult{err: classify(err), args: argsOf(fs.Args()), atDash: fs.ArgsLenAtDash(), states: make([]gState, len(flags))}
+		if got.err != want.err {
+			fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: %s (%v), the grammar says %s", argv, gModeNames[mode], interspersed, flags, modelErrNames[got.err], err, modelErrNames[want.err])
+		}
+		if err != nil {
+			return
+		}
+		if !reflect.DeepEqual(got.args, want.args) || got.atDash != want.atDash {
+			fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: Args()=%q ArgsLenAtDash()=%d, the grammar says %q / %d", argv, gModeNames[mode], interspersed, flags, got.args, got.atDash, want.args, want.atDash)
+		}
+		for i, f := range flags {
+			gv, wv := bounds[i].value(f.kind), want.states[i].value(f.kind)
+			if !reflect.DeepEqual(gv, wv) {
+				fail(ht, "Parse(%q) [%s, interspersed=%v, flags %v]: %v = %#v, the grammar says %#v", argv, gModeNames[mode], interspersed, flags, f, gv, wv)
+			}
+			if fs.Changed(f.name) != want.states[i].changed {
+				fail(ht, "Parse(%q) [%s, flags %v]: Changed(%s)=%v, the grammar says %v", argv, gModeNames[mode], flags, f.name, fs.Changed(f.name), want.states[i].changed)
+			}
+			if fl := fs.Lookup(f.name); fl.Changed != want.states[i].changed {
+				fail(ht, "Parse(%q): Lookup(%s).Changed=%v, Changed()=%v", argv, f.name, fl.Changed, fs.Changed(f.name))
+			}
+		}
+		if fs.NFlag() != len(visited(func(f func(string)) { fs.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })) {
+			fail(ht, "Parse(%q): NFlag()=%d but Visit sees %d flags", argv, fs.NFlag(), len(visited(func(f func(string)) { fs.Visit(func(fl *pflag.Flag) { f(fl.Name) }) })))
+		}
+	})
+}
