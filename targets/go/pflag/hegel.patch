new file mode 100644
index 0000000..5702d8a
--- /dev/null
+++ b/hegel_usage_test.go
@@ -0,0 +1,452 @@
+package pflag_test
+
+// 4. The usage text: one entry per flag with the README's column, the words
+// of UnquoteUsage plus "(default X)" iff the default is non-zero, no line
+// wider than cols (counted in columns, as documented) unless it is a single
+// word, and greedy filling (wrap's five-column slop and its 16-column
+// fallback modelled). A flag is a spec record (name slot, shorthand, kind,
+// whether its default is the kind's fixed non-zero one, its usage words)
+// rendered by defineU. The shapes of pflag/4 (an empty boolSlice,
+// durationSlice or map default), pflag/5 (non-ASCII letters in the usage
+// text) and pflag/7 (a multi-key stringToInt default) are drawn by default
+// and left out under HEGEL_NO_KNOWN=1.
+
+import (
+	"fmt"
+	"net"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/spf13/pflag"
+	"hegel.dev/go/hegel"
+)
+
+type uKind int
+
+const (
+	uBool uKind = iota
+	uString
+	uInt
+	uDuration
+	uStringSlice
+	uCount
+	uFloat
+	uIP
+	uBoolSlice
+	uStringToString
+	uIPMask
+	uBytesHex
+	uDurationSlice
+	uIntSlice
+	uStringToInt
+)
+
+var uKinds = []uKind{uBool, uString, uInt, uDuration, uStringSlice, uCount, uFloat, uIP, uBoolSlice, uStringToString, uIPMask, uBytesHex, uDurationSlice, uIntSlice, uStringToInt}
+
+var uKindNames = []string{"bool", "string", "int", "duration", "stringSlice", "count", "float64", "ip", "boolSlice", "stringToString", "ipMask", "bytesHex", "durationSlice", "intSlice", "stringToInt"}
+
+// emptyShownKinds: the kinds whose empty default the usage shows as
+// "(default [])" (pflag/4); under HEGEL_NO_KNOWN=1 they get the non-zero
+// default.
+var emptyShownKinds = map[uKind]bool{uBoolSlice: true, uStringToString: true, uDurationSlice: true, uStringToInt: true}
+
+var (
+	stsDefault = map[string]string{"k": "v"}
+	// stiDefault: three keys, whose rendering follows map order (pflag/7);
+	// one key under HEGEL_NO_KNOWN=1.
+	stiDefault = shaped(map[string]int{"a": 1, "b": 2, "c": 3}, map[string]int{"k": 1})
+)
+
+type uFlag struct {
+	name    string
+	short   string
+	kind    uKind
+	nonZero bool // the kind's fixed non-zero default
+	usage   string
+}
+
+// defineU defines the flag; the default is zero or a fixed non-zero one.
+func defineU(fs *pflag.FlagSet, f uFlag) {
+	nz := f.nonZero
+	switch f.kind {
+	case uBool:
+		fs.BoolP(f.name, f.short, nz, f.usage)
+	case uString:
+		def := ""
+		if nz {
+			def = "dflt"
+		}
+		fs.StringP(f.name, f.short, def, f.usage)
+	case uInt:
+		def := 0
+		if nz {
+			def = 7
+		}
+		fs.IntP(f.name, f.short, def, f.usage)
+	case uDuration:
+		var def time.Duration
+		if nz {
+			def = 1500 * time.Millisecond
+		}
+		fs.DurationP(f.name, f.short, def, f.usage)
+	case uStringSlice:
+		var def []string
+		if nz {
+			def = []string{"a", "b"}
+		}
+		fs.StringSliceP(f.name, f.short, def, f.usage)
+	case uCount:
+		fs.CountP(f.name, f.short, f.usage) // no non-zero default
+	case uFloat:
+		def := 0.0
+		if nz {
+			def = 2.5
+		}
+		fs.Float64P(f.name, f.short, def, f.usage)
+	case uIP:
+		var def net.IP
+		if nz {
+			def = net.IPv4(10, 0, 0, 1)
+		}
+		fs.IPP(f.name, f.short, def, f.usage)
+	case uBoolSlice:
+		var def []bool
+		if nz {
+			def = []bool{true}
+		}
+		fs.BoolSliceP(f.name, f.short, def, f.usage)
+	case uStringToString:
+		var def map[string]string
+		if nz {
+			def = stsDefault
+		}
+		fs.StringToStringP(f.name, f.short, def, f.usage)
+	case uIPMask:
+		var def net.IPMask
+		if nz {
+			def = net.IPv4Mask(255, 255, 0, 0)
+		}
+		fs.IPMaskP(f.name, f.short, def, f.usage)
+	case uBytesHex:
+		var def []byte
+		if nz {
+			def = []byte{0x0a, 0xff}
+		}
+		fs.BytesHexP(f.name, f.short, def, f.usage)
+	case uDurationSlice:
+		var def []time.Duration
+		if nz {
+			def = []time.Duration{time.Second}
+		}
+		fs.DurationSliceP(f.name, f.short, def, f.usage)
+	case uIntSlice:
+		var def []int
+		if nz {
+			def = []int{1, 2}
+		}
+		fs.IntSliceP(f.name, f.short, def, f.usage)
+	default:
+		var def map[string]int
+		if nz {
+			def = stiDefault
+		}
+		fs.StringToIntP(f.name, f.short, def, f.usage)
+	}
+}
+
+// mapText renders a map default as pflag documents it: [k=v,...] with the
+// keys sorted (as stringToString writes it).
+func mapText[V any](m map[string]V) string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	recs := make([]string, len(keys))
+	for i, k := range keys {
+		recs[i] = fmt.Sprintf("%s=%v", k, m[k])
+	}
+	return "[" + strings.Join(recs, ",") + "]"
+}
+
+// defaultText is the "(default X)" text the layout says: the string quoted,
+// a map sorted, the rest as the flag records it.
+func defaultText(fl *pflag.Flag, f uFlag) string {
+	switch f.kind {
+	case uString:
+		return strconv.Quote(fl.DefValue)
+	case uStringToString:
+		return mapText(stsDefault)
+	case uStringToInt:
+		return mapText(stiDefault)
+	}
+	return fl.DefValue
+}
+
+const wordChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,;:!?'()"
+
+// wideChars: letters of two and three bytes.
+const wideChars = "\u00e9\u00fc\u00f1\u65e5\u672c"
+
+// usageAlphabet: ASCII and non-ASCII letters (pflag/5); ASCII only under
+// HEGEL_NO_KNOWN=1.
+var usageAlphabet = shaped(wordChars+wideChars, wordChars)
+
+// uWord is a word of a usage text, back-quoted (the flag's variable name)
+// once in ten.
+type uWord struct {
+	text   string
+	quoted bool
+}
+
+func (w uWord) String() string {
+	if w.quoted {
+		return "`" + w.text + "`"
+	}
+	return w.text
+}
+
+// usageWords: words of one to thirty letters of the alphabet.
+func usageWords(alphabet string) hegel.Generator[[]uWord] {
+	words := hegel.Map(pairs(text(alphabet, 1, 30), chance(10)), func(p pair[string, bool]) uWord { return uWord{p.a, p.b} })
+	return many(words, 0, 12)
+}
+
+func joinWords(words []uWord) string {
+	texts := make([]string, len(words))
+	for i, w := range words {
+		texts[i] = w.String()
+	}
+	return strings.Join(texts, " ")
+}
+
+// usageTexts: up to twelve words of the usage alphabet.
+var usageTexts = hegel.Map(usageWords(usageAlphabet), joinWords)
+
+// uSpec is a flag as drawn: a name slot, a shorthand slot three times in
+// five, a kind, a non-zero default two times in five, and its usage words.
+type uSpec struct {
+	slot    int
+	short   *int
+	kind    uKind
+	nonZero bool
+	usage   string
+}
+
+var uSpecs = hegel.Composite(func(tc hegel.TestCase) uSpec {
+	return uSpec{
+		slot:    hegel.Draw(tc, positions),
+		short:   hegel.Draw(tc, optional(60, positions)),
+		kind:    hegel.Draw(tc, hegel.SampledFrom(uKinds)),
+		nonZero: hegel.Draw(tc, chance(40)),
+		usage:   hegel.Draw(tc, usageTexts),
+	}
+})
+
+var uShortPool = strings.Split("abcdefg", "")
+
+// uFlagsOf names the specs and assigns their shorthands (distinct by
+// construction), fixes the defaults a kind cannot have (a count has none;
+// under HEGEL_NO_KNOWN=1 the kinds of pflag/4 get the non-zero one) and
+// sorts them by name, the order of the usage text.
+func uFlagsOf(specs []uSpec) []uFlag {
+	slots := make([]int, len(specs))
+	var shortSlots []int
+	for i, s := range specs {
+		slots[i] = s.slot
+		if s.short != nil {
+			shortSlots = append(shortSlots, *s.short)
+		}
+	}
+	names, shorts := assign(flagNames, slots), assign(uShortPool, shortSlots)
+	out := make([]uFlag, len(specs))
+	k := 0
+	for i, s := range specs {
+		f := uFlag{name: names[i], kind: s.kind, nonZero: s.nonZero, usage: s.usage}
+		if s.short != nil {
+			f.short = shorts[k]
+			k++
+		}
+		switch {
+		case s.kind == uCount:
+			f.nonZero = false
+		case noKnown && emptyShownKinds[s.kind]:
+			f.nonZero = true
+		}
+		out[i] = f
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].name < out[j].name })
+	return out
+}
+
+// uCase: one to four flags and a column count: 0 (no wrapping) once in
+// five, else 10 to 120.
+type uCase struct {
+	specs []uSpec
+	cols  int
+}
+
+var uCases = hegel.Composite(func(tc hegel.TestCase) uCase {
+	return uCase{specs: hegel.Draw(tc, many(uSpecs, 1, 4)), cols: hegel.Draw(tc, maybe(80, hegel.Integers(10, 120)))}
+})
+
+func (c uCase) flags() []uFlag { return uFlagsOf(c.specs) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c uCase) GoString() string { return fmt.Sprintf("flags=%+v cols=%d", c.flags(), c.cols) }
+
+// column is the flag column as the README shows it: "  -s, --name" or
+// "      --name", then "[=true|false]" for a bool or " <varname>".
+func column(fs *pflag.FlagSet, f uFlag) (string, int) {
+	fl := fs.Lookup(f.name)
+	col := "      --" + f.name
+	if f.short != "" {
+		col = "  -" + f.short + ", --" + f.name
+	}
+	varname, _ := pflag.UnquoteUsage(fl)
+	tokens := 1
+	if f.short != "" {
+		tokens++
+	}
+	if f.kind == uBool {
+		col += "[=true|false]"
+	} else if varname != "" {
+		col += " " + varname
+		tokens++
+	}
+	return col, tokens
+}
+
+// usageEntries splits the usage text into one entry per flag: header line
+// plus its continuation lines (indented, not starting with a dash).
+func usageEntries(text string) [][]string {
+	var entries [][]string
+	for _, line := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+		trimmed := strings.TrimLeft(line, " ")
+		if strings.HasPrefix(trimmed, "-") && (strings.HasPrefix(line, "  -") || strings.HasPrefix(line, "      --")) {
+			entries = append(entries, []string{line})
+			continue
+		}
+		if len(entries) == 0 {
+			entries = append(entries, nil)
+		}
+		entries[len(entries)-1] = append(entries[len(entries)-1], line)
+	}
+	return entries
+}
+
+// width is the width of a line in columns (code points: the alphabets hold
+// no combining or wide characters).
+func width(s string) int { return utf8.RuneCountInString(s) }
+
+// checkUsage judges FlagUsagesWrapped(cols) against the documented layout.
+// The column indent is counted in bytes, which is how the library pads it
+// (the text after the column is what the width checks look at).
+func checkUsage(ht *hegel.T, fs *pflag.FlagSet, flags []uFlag, cols int) {
+	text := fs.FlagUsagesWrapped(cols)
+	entries := usageEntries(text)
+	if len(entries) != len(flags) {
+		fail(ht, "FlagUsagesWrapped(%d) has %d entries for %d flags:\n%s", cols, len(entries), len(flags), text)
+	}
+	maxcol := 0
+	for _, f := range flags {
+		col, _ := column(fs, f)
+		if len(col) > maxcol {
+			maxcol = len(col)
+		}
+	}
+	indent := maxcol + 3
+	wrapping := cols > 0
+	fallback := false // the text starts on the line after the column
+	if wrapping && cols-indent < 24 {
+		indent = 16
+		fallback = true
+		if cols-indent < 24 {
+			wrapping = false
+		}
+	}
+	avail := cols - indent - 5 // wrapN's width before the slop
+	for i, f := range flags {
+		fl := fs.Lookup(f.name)
+		col, tokens := column(fs, f)
+		entry := entries[i]
+		header := entry[0]
+		if !strings.HasPrefix(header, col) {
+			fail(ht, "FlagUsagesWrapped(%d): entry for %v starts %q, the README's layout says %q", cols, f, header, col)
+		}
+		// the words: the unquoted usage, then "(default X)" iff the default is non-zero
+		_, usage := pflag.UnquoteUsage(fl)
+		want := strings.Fields(usage)
+		if f.nonZero {
+			want = append(want, "(default", defaultText(fl, f)+")")
+		}
+		var got []string
+		got = append(got, strings.Fields(header)[tokens:]...)
+		for _, line := range entry[1:] {
+			got = append(got, strings.Fields(line)...)
+		}
+		if !reflect.DeepEqual(argsOf(got), argsOf(want)) {
+			fail(ht, "FlagUsagesWrapped(%d): entry for %v (default %q, kind %s) reads %q, the layout says %q\n%s", cols, f, fl.DefValue, uKindNames[f.kind], got, want, text)
+		}
+		// the default shown is the flag's DefValue, which its Value renders
+		// the same on every call (a map default rendered in map order is the
+		// shape of pflag/7, and would make this case's verdict random)
+		for k := 0; k < 5; k++ {
+			if s := fl.Value.String(); s != fl.DefValue {
+				fail(ht, "FlagUsagesWrapped(%d): entry for %v has DefValue %q but Value.String() renders %q", cols, f, fl.DefValue, s)
+			}
+		}
+		if !wrapping {
+			continue
+		}
+		// no line wider than cols, unless it is a single over-wide word (or the column alone)
+		for j, line := range entry {
+			if width(line) <= cols {
+				continue
+			}
+			words := len(strings.Fields(line))
+			if j == 0 {
+				words -= tokens
+			}
+			if words > 1 {
+				fail(ht, "FlagUsagesWrapped(%d): line %q is %d wide\n%s", cols, line, width(line), text)
+			}
+		}
+		// greedy: the first word of a continuation line did not fit on the line before
+		for j := 1; j < len(entry); j++ {
+			prev := strings.TrimRight(entry[j-1], " ")
+			if j == 1 {
+				if fallback {
+					continue // nothing but the column on the header line
+				}
+				prev = prev[indent:]
+			} else {
+				prev = strings.TrimLeft(prev, " ")
+			}
+			first := strings.Fields(entry[j])
+			if len(first) == 0 {
+				continue
+			}
+			if width(prev)+1+width(first[0]) < avail {
+				fail(ht, "FlagUsagesWrapped(%d): %q could have taken %q (width %d+1+%d < %d)\n%s", cols, prev, first[0], width(prev), width(first[0]), avail, text)
+			}
+		}
+	}
+}
+
+func TestHegelUsageFollowsTheDocumentedLayout(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, uCases)
+		flags := c.flags()
+		fs := newSet(true)
+		for _, f := range flags {
+			defineU(fs, f)
+		}
+		checkUsage(ht, fs, flags, c.cols)
+	})
+}
