diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..d5b4d46
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,587 @@
+package hegel
+
+// The generators: a terminfo entry and a parameterized string as data, built from the
+// binding's combinators and rendered into terminfo source by pure functions. The spellings
+// terminfo(5) leaves free are read from a drawn tape (tiQuote).
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- string values
+
+func toByte(n int) byte { return byte(n) }
+
+var (
+	// printables: a printable ASCII byte.
+	printables = hegel.Map(hegel.Integers(33, 126), toByte)
+	// capBytes: a byte of a string capability: printable eleven times in twenty, one of the
+	// characters terminfo source must escape or the parameter language reads (a space, a
+	// comma, a caret, a backslash, a colon, a percent sign, ...) a fifth of the time, else any
+	// non-NUL byte (a compiled string cannot hold a NUL).
+	capBytes = weighted(
+		choice[byte]{55, printables},
+		choice[byte]{22, hegel.SampledFrom([]byte(" ,^\\:%$<>'\"#=@|"))},
+		choice[byte]{23, hegel.Map(hegel.Integers(1, 255), toByte)},
+	)
+	// capStrings: a string capability's value: up to twelve bytes, or one time in twenty
+	// forty to three hundred, made unambiguous for the oracle.
+	capStrings = hegel.Map(weighted(
+		choice[[]byte]{95, many(capBytes, 0, 12)},
+		choice[[]byte]{5, many(capBytes, 40, 300)},
+	), unambiguous)
+)
+
+// unambiguous rewrites the byte pairs on which tic, infocmp and the parameter language read a
+// source differently from its bytes, so that the oracle is unambiguous: a backslash or a
+// control character after a percent sign (tic keeps %^X literal, infocmp prints %\ raw and a
+// control character after % as ^X, which its own %^ convention makes ambiguous), the %^
+// operator (printed raw by infocmp) before anything but a plain printable byte, a backslash
+// after a caret (infocmp prints it raw), the byte 0200 before an octal digit (infocmp prints
+// it as \0), and a space after a percent sign at the very end of the string (infocmp prints
+// the space raw and trims raw trailing blanks from the last capability of the entry, so a
+// string ending in "% " comes back without the space when it is the entry's last capability;
+// ncurses 6.4). Under HEGEL_NO_KNOWN=1 every %^ is rewritten: it is the shape of tcell/4.
+func unambiguous(b []byte) []byte {
+	b = append([]byte(nil), b...)
+	if n := len(b); n >= 2 && b[n-2] == '%' && b[n-1] == ' ' {
+		b[n-1] = 'x'
+	}
+	for i := 0; i+1 < len(b); i++ {
+		if b[i] == '%' && (b[i+1] == '\\' || b[i+1] < 32 || b[i+1] == 127) {
+			b[i+1] = 'x'
+		}
+		if b[i] == '%' && b[i+1] == '^' && (Known.caretAfterPercent || i+2 >= len(b) || b[i+2] <= 32 || b[i+2] >= 127 || b[i+2] == '\\' || b[i+2] == '^') {
+			b[i+1] = 'x'
+		}
+		if (b[i] == '^' && b[i+1] == '\\') || (b[i] == 0x80 && b[i+1] >= '0' && b[i+1] <= '7') {
+			b[i+1] = 'x'
+		}
+	}
+	return b
+}
+
+var (
+	acscKeys = hegel.SampledFrom([]byte("jklmnopqrstuvwxyz`afgh~{}|+,-.0"))
+	lowers   = hegel.Map(hegel.Integers(int('a'), int('z')), toByte)
+	// acscMappings: up to six key/value pairs (a key may repeat, so infocmp's repair applies).
+	acscMappings = hegel.Map(many(pairs(acscKeys, printables), 0, 6), func(ps []pair[byte, byte]) []byte {
+		var b []byte
+		for _, p := range ps {
+			b = append(b, p.a, p.b)
+		}
+		return b
+	})
+	// acscOdd: an odd number of lower-case letters, one to seven (an unpaired trailing byte).
+	acscOdd = hegel.Map(pairs(many(pairs(lowers, lowers), 0, 3), lowers), func(p pair[[]pair[byte, byte], byte]) []byte {
+		var b []byte
+		for _, q := range p.a {
+			b = append(b, q.a, q.b)
+		}
+		return append(b, p.b)
+	})
+	// acscValues: the mappings seventeen times in twenty, else the odd form.
+	acscValues = weighted(choice[[]byte]{85, acscMappings}, choice[[]byte]{15, acscOdd})
+)
+
+// --------------------------------------------------------------------------- numbers and names
+
+var (
+	// capNums: a numeric capability's value: below 256 eleven times in twenty, within the
+	// 16-bit format six times, else up to 2^31-1 (which forces the 32-bit format).
+	capNums = weighted(
+		choice[int]{55, hegel.Integers(0, 255)},
+		choice[int]{31, hegel.Integers(256, 32767)},
+		choice[int]{14, hegel.Integers(32768, 2147483647)},
+	)
+	// extNums: an extended number stays within the 16-bit format (tic stores a larger one as
+	// cancelled unless a standard number forces the 32-bit format).
+	extNums = weighted(choice[int]{55, hegel.Integers(0, 255)}, choice[int]{45, hegel.Integers(0, 32767)})
+
+	// aliases: up to two aliases, each a letter or digit tic files an alias under and up to
+	// five more characters.
+	aliases = many(cat(hegel.SampledFrom([]string{"a", "z", "0", "9", "t"}), hegel.Text().Alphabet("abz09+-xtm").MaxSize(5)), 0, 2)
+	// descChars: the characters of a description, the blank twice as often.
+	descChars = []string{"a", "Z", "0", " ", " ", "-", "/", "(", ")", "\"", ";", "#", "=", "@", ":", "'", "!", "&", "~", "."}
+	// descriptions: a description of one to sixteen characters (blanks trimmed when rendered)
+	// seventeen times in twenty, else none.
+	descriptions = maybe(85, hegel.Map(many(hegel.SampledFrom(descChars), 1, 16), joined))
+	// extNames: an extended capability name: a letter tic accepts first (not an underscore)
+	// and two to five more characters (a two-letter name is a termcap code to tic), and not
+	// a standard name.
+	extNames = hegel.Filter(cat(hegel.SampledFrom([]string{"A", "Z", "a", "z", "X", "k"}), hegel.Text().Alphabet("AZaz09_by").MinSize(2).MaxSize(5)),
+		func(s string) bool { return !allShort[s] })
+)
+
+// --------------------------------------------------------------------------- capabilities
+
+// boolSpec, numSpec, strSpec, extNumSpec: one capability of an entry as drawn: its name, whether
+// it is cancelled (name@) and its value.
+type boolSpec struct {
+	name   string
+	cancel bool
+}
+
+type numSpec struct {
+	name   string
+	cancel bool
+	value  int
+}
+
+type strSpec struct {
+	name   string
+	cancel bool
+	value  []byte
+}
+
+type extNumSpec struct {
+	name  string
+	value int
+}
+
+var (
+	// stringCapNames: the standard string capabilities but box1 (tic derives acsc from it).
+	stringCapNames = without(stringCaps, "box1")
+	// boolSpecs: a standard boolean, cancelled one time in ten.
+	boolSpecs = hegel.Composite(func(tc hegel.TestCase) boolSpec {
+		return boolSpec{name: hegel.Draw(tc, hegel.SampledFrom(boolCaps)), cancel: hegel.Draw(tc, chance(10))}
+	})
+	// numSpecs: a standard number, cancelled one time in ten.
+	numSpecs = hegel.Composite(func(tc hegel.TestCase) numSpec {
+		return numSpec{name: hegel.Draw(tc, hegel.SampledFrom(numCaps)), cancel: hegel.Draw(tc, chance(10)), value: hegel.Draw(tc, capNums)}
+	})
+	// strSpecs: a standard string, cancelled one time in ten; acsc draws its own values.
+	strSpecs = hegel.FlatMap(hegel.SampledFrom(stringCapNames), func(name string) hegel.Generator[strSpec] {
+		values := capStrings
+		if name == "acsc" {
+			values = acscValues
+		}
+		return hegel.Composite(func(tc hegel.TestCase) strSpec {
+			return strSpec{name: name, cancel: hegel.Draw(tc, chance(10)), value: hegel.Draw(tc, values)}
+		})
+	})
+	// extNumSpecs: an extended number.
+	extNumSpecs = hegel.Composite(func(tc hegel.TestCase) extNumSpec {
+		return extNumSpec{name: hegel.Draw(tc, extNames), value: hegel.Draw(tc, extNums)}
+	})
+	// extStrSpecs: an extended string, cancelled three times in twenty.
+	extStrSpecs = hegel.Composite(func(tc hegel.TestCase) strSpec {
+		return strSpec{name: hegel.Draw(tc, extNames), cancel: hegel.Draw(tc, chance(15)), value: hegel.Draw(tc, capStrings)}
+	})
+)
+
+// --------------------------------------------------------------------------- entries
+
+// entrySpec is a terminfo entry as drawn: the names, the capabilities by group in source order
+// (a later capability of a name already used is dropped when rendered, so the names are
+// distinct and the shrinker can delete any of them), the Tc and RGB flags LoadTerminfo tests
+// for, and the tape of the source spellings.
+type entrySpec struct {
+	aliases  []string
+	desc     string
+	bools    []boolSpec
+	nums     []numSpec
+	cup      *[]byte
+	strs     []strSpec
+	tc, rgb  bool
+	extBools []string
+	extNums  []extNumSpec
+	extStrs  []strSpec
+	tape     []int
+}
+
+// entriesOf: an entry with the true-colour flags and the cup of the generators: up to two
+// aliases, a description, up to eight standard booleans and six numbers, the cup, up to eight
+// standard strings, the flags, up to three extended booleans and numbers and four extended
+// strings.
+func entriesOf(tcFlags, rgbFlags hegel.Generator[bool], cups hegel.Generator[*[]byte]) hegel.Generator[entrySpec] {
+	return hegel.Composite(func(tc hegel.TestCase) entrySpec {
+		return entrySpec{
+			aliases:  hegel.Draw(tc, aliases),
+			desc:     hegel.Draw(tc, descriptions),
+			bools:    hegel.Draw(tc, many(boolSpecs, 0, 8)),
+			nums:     hegel.Draw(tc, many(numSpecs, 0, 6)),
+			cup:      hegel.Draw(tc, cups),
+			strs:     hegel.Draw(tc, many(strSpecs, 0, 8)),
+			tc:       hegel.Draw(tc, tcFlags),
+			rgb:      hegel.Draw(tc, rgbFlags),
+			extBools: hegel.Draw(tc, many(extNames, 0, 3)),
+			extNums:  hegel.Draw(tc, many(extNumSpecs, 0, 3)),
+			extStrs:  hegel.Draw(tc, many(extStrSpecs, 0, 4)),
+			tape:     hegel.Draw(tc, tapes),
+		}
+	})
+}
+
+// entrySpecs: the wide Load property's entries: each true-colour flag one time in five, a cup
+// three times in four (LoadTerminfo refuses an entry without one).
+var entrySpecs = entriesOf(chance(20), chance(20), optional(75, capStrings))
+
+// build renders the entry under the name: the expected values and the terminfo source.
+func (s entrySpec) build(name string) (*entry, string) {
+	e := newEntry(name)
+	e.names = append(e.names, s.aliases...)
+	if d := strings.TrimSpace(s.desc); d != "" {
+		e.names = append(e.names, d)
+	}
+	t := &tape{vals: s.tape}
+	used := map[string]bool{}
+	var caps []string
+	add := func(k, src string) bool {
+		if used[k] {
+			return false
+		}
+		used[k] = true
+		caps = append(caps, src)
+		e.order = append(e.order, k)
+		return true
+	}
+	for _, b := range s.bools {
+		switch {
+		case used[b.name]:
+		case b.cancel:
+			e.bcancel = append(e.bcancel, b.name)
+			add(b.name, b.name+"@")
+		default:
+			e.bools[b.name] = true
+			add(b.name, b.name)
+		}
+	}
+	for _, n := range s.nums {
+		switch {
+		case used[n.name]:
+		case n.cancel:
+			e.cancelled[n.name] = true
+			add(n.name, n.name+"@")
+		default:
+			e.nums[n.name] = n.value
+			add(n.name, fmt.Sprintf("%s#%d", n.name, n.value))
+		}
+	}
+	if s.cup != nil {
+		e.strs["cup"] = *s.cup
+		add("cup", "cup="+tiQuote(*s.cup, t))
+	}
+	for _, st := range s.strs {
+		switch {
+		case used[st.name]:
+		case st.cancel:
+			e.cancelled[st.name] = true
+			add(st.name, st.name+"@")
+		default:
+			e.strs[st.name] = st.value
+			add(st.name, st.name+"="+tiQuote(st.value, t))
+		}
+	}
+	for _, f := range []struct {
+		name string
+		on   bool
+	}{{"Tc", s.tc}, {"RGB", s.rgb}} {
+		if f.on {
+			e.bools[f.name] = true
+			add(f.name, f.name)
+		}
+	}
+	for _, k := range s.extBools {
+		if !used[k] {
+			e.bools[k] = true
+			add(k, k)
+		}
+	}
+	for _, n := range s.extNums {
+		if !used[n.name] {
+			e.nums[n.name] = n.value
+			add(n.name, fmt.Sprintf("%s#%d", n.name, n.value))
+		}
+	}
+	for _, st := range s.extStrs {
+		switch {
+		case used[st.name]:
+		case st.cancel:
+			e.cancelled[st.name] = true
+			add(st.name, st.name+"@")
+		default:
+			e.strs[st.name] = st.value
+			add(st.name, st.name+"="+tiQuote(st.value, t))
+		}
+	}
+	var src strings.Builder
+	src.WriteString(strings.Join(e.names, "|"))
+	src.WriteString(",\n")
+	for _, c := range caps {
+		src.WriteString("\t" + c + ",\n")
+	}
+	return e, src.String()
+}
+
+// GoString is what the draw report prints (it uses %#v): the source.
+func (s entrySpec) GoString() string {
+	_, src := s.build("z")
+	return src
+}
+
+// --------------------------------------------------------------------------- programs
+
+// program is a parameterized string as drawn: a list of items, each a piece of the parameter
+// language already rendered as text (a literal, a push, an operator, a print) or a conditional
+// whose branches are programs again.
+type program []any
+
+// conditional is %? c1 %t t1 [%e c2 %t t2]... [%e else] %;.
+type conditional struct {
+	arms []arm
+	els  *program
+}
+
+type arm struct {
+	cond, then program
+}
+
+// render is the program as text. Only the first %i is kept, wherever it is: ncurses
+// increments the first two parameters once per evaluation and the package every time, a
+// difference the property leaves out (README), so a second %i would only be skipped.
+func (p program) render() string {
+	var r renderer
+	r.program(p)
+	return r.b.String()
+}
+
+type renderer struct {
+	b           strings.Builder
+	incremented bool
+}
+
+func (r *renderer) program(p program) {
+	for _, it := range p {
+		switch x := it.(type) {
+		case string:
+			if x == "%i" {
+				if r.incremented {
+					continue
+				}
+				r.incremented = true
+			}
+			r.b.WriteString(x)
+		case conditional:
+			r.conditional(x)
+		default:
+			panic(fmt.Sprintf("program item %T", it))
+		}
+	}
+}
+
+func (r *renderer) conditional(c conditional) {
+	r.b.WriteString("%?")
+	for i, a := range c.arms {
+		if i > 0 {
+			r.b.WriteString("%e")
+		}
+		r.program(a.cond)
+		r.b.WriteString("%t")
+		r.program(a.then)
+	}
+	if c.els != nil {
+		r.b.WriteString("%e")
+		r.program(*c.els)
+	}
+	r.b.WriteString("%;")
+}
+
+// formatSpec is a printf-style conversion %[:][flags][width][.precision]conv as drawn; its
+// String applies the rules of the common subset of C and Go printf: the - flag needs the colon
+// (it is the operator otherwise), # is left out for d and with a precision (C prints a lone 0
+// for %#.0o of zero, Go does not), the space flag for the unsigned conversions and with a
+// precision (C ignores it for unsigned conversions and prints a space for % .0d of zero, Go
+// does not), and 0 and # do not meet (C counts the 0x prefix in a zero-padded width, Go does
+// not). The + flag is never drawn (ncurses 6.4 does not implement it after the colon).
+type formatSpec struct {
+	colon bool
+	flags []string
+	width int // 0: none
+	prec  int // -1: none
+	conv  string
+}
+
+func (f formatSpec) String() string {
+	s := "%"
+	if f.colon {
+		s += ":"
+	}
+	var flags string
+	for _, fl := range f.flags {
+		switch {
+		case fl == "-" && !f.colon:
+			continue
+		case fl == "#" && (f.conv == "d" || f.prec >= 0):
+			continue
+		case fl == " " && (f.conv != "d" || f.prec >= 0):
+			continue
+		case fl == "0" && strings.Contains(flags, "#"), fl == "#" && strings.Contains(flags, "0"):
+			continue
+		}
+		flags += fl
+	}
+	s += flags
+	if f.width > 0 {
+		s += strconv.Itoa(f.width)
+	}
+	if f.prec >= 0 {
+		s += "." + strconv.Itoa(f.prec)
+	}
+	return s + f.conv
+}
+
+// precOf is the precision of an optional draw: -1 for none.
+func precOf(p *int) int {
+	if p == nil {
+		return -1
+	}
+	return *p
+}
+
+var (
+	litChars  = "aZ09 ;[]().-#!~x:{}'?+,^\t" // no backslash: infocmp prints one after a caret raw
+	binOps    = []string{"+", "-", "*", "/", "m", "&", "|", "^", "=", "<", ">", "A", "O"}
+	unOps     = []string{"!", "~"}
+	varNames  = []string{"a", "b", "z"} // dynamic only: static variables persist across Printf calls but not across tput processes
+	convChars = []string{"d", "o", "x", "X"}
+	flagChars = []string{"#", " ", "0", "-"}
+	tputCaps  = []string{"cup", "hpa", "vpa", "csr", "u6", "u7", "sgr", "setaf"}
+)
+
+func percent(s string) string { return "%" + s }
+
+var (
+	// literals: one to three literal characters.
+	literals = hegel.Text().Alphabet(litChars).MinSize(1).MaxSize(3)
+	// paramPushes: %p1 to %p9.
+	paramPushes = hegel.Map(hegel.Integers(1, 9), func(n int) string { return "%p" + strconv.Itoa(n) })
+	// pushes: a parameter two times in three, else a constant %{n} (1 to 255 four times in
+	// five, else 0 to 999; tic rewrites a printable n as %'c', so that form is never written).
+	pushes = weighted(
+		choice[string]{2, paramPushes},
+		choice[string]{1, hegel.Map(weighted(choice[int]{80, hegel.Integers(1, 255)}, choice[int]{20, hegel.Integers(0, 999)}),
+			func(n int) string { return "%{" + strconv.Itoa(n) + "}" })},
+	)
+	// prints: %d, %o, %x or %X.
+	prints = hegel.Map(hegel.SampledFrom(convChars), percent)
+	// pushChars: a push printed as a character.
+	pushChars = cat(pushes, lit("%c"))
+	// operators: a binary operator four times in five (the logical %A and %O among them, the
+	// shape of tcell/5), else a unary one.
+	operators = weighted(
+		choice[string]{80, hegel.Map(hegel.SampledFrom(binOps), percent)},
+		choice[string]{20, hegel.Map(hegel.SampledFrom(unOps), percent)},
+	)
+	setVars = cat(lit("%P"), hegel.SampledFrom(varNames))
+	getVars = cat(lit("%g"), hegel.SampledFrom(varNames))
+	// formatSpecs: the colon two times in five, up to two flags, a width three times in five,
+	// a precision three times in ten. Without the colon a format starting with #, the space
+	// or a precision is the shape of tcell/2; the 0 flag before another one that of tcell/6.
+	formatSpecs = hegel.Composite(func(tc hegel.TestCase) formatSpec {
+		return formatSpec{
+			colon: hegel.Draw(tc, chance(40)),
+			flags: hegel.Draw(tc, many(hegel.SampledFrom(flagChars), 0, 2)),
+			width: hegel.Draw(tc, maybe(60, hegel.Integers(1, 9))),
+			prec:  precOf(hegel.Draw(tc, optional(30, hegel.Integers(0, 5)))),
+			conv:  hegel.Draw(tc, hegel.SampledFrom(convChars)),
+		}
+	})
+	formats = hegel.Map(formatSpecs, formatSpec.String)
+)
+
+// conditionalsOf: a conditional whose branches are the programs of sub: one to three arms
+// (each a condition and a then-part) and an else-part three times in five.
+func conditionalsOf(sub hegel.Generator[program]) hegel.Generator[conditional] {
+	arms := hegel.Composite(func(tc hegel.TestCase) arm {
+		return arm{cond: hegel.Draw(tc, sub), then: hegel.Draw(tc, sub)}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) conditional {
+		return conditional{arms: hegel.Draw(tc, many(arms, 1, 3)), els: hegel.Draw(tc, optional(60, sub))}
+	})
+}
+
+// itemsOf: an item of a program whose conditionals draw their branches from sub (nil at the
+// nesting bound, where %p1%d stands in a conditional's place): a literal, %%, a push, a print,
+// a push printed as a character, an operator, %i (rendered once), a variable set and get, a
+// printf-style format, a conditional, weighted with the plainest first.
+func itemsOf(sub hegel.Generator[program]) hegel.Generator[any] {
+	conds := hegel.Just[any]("%p1%d")
+	if sub != nil {
+		conds = asAny(conditionalsOf(sub))
+	}
+	return weighted(
+		choice[any]{18, asAny(literals)},
+		choice[any]{4, hegel.Just[any]("%%")},
+		choice[any]{18, asAny(pushes)},
+		choice[any]{7, asAny(prints)},
+		choice[any]{7, asAny(pushChars)},
+		choice[any]{15, asAny(operators)},
+		choice[any]{4, hegel.Just[any]("%i")},
+		choice[any]{6, asAny(setVars)},
+		choice[any]{4, asAny(getVars)},
+		choice[any]{5, asAny(formats)},
+		choice[any]{12, conds},
+	)
+}
+
+// programsOf: a program of lo to hi items.
+func programsOf(items hegel.Generator[any], lo, hi int) hegel.Generator[program] {
+	return hegel.Map(many(items, lo, hi), func(xs []any) program { return program(xs) })
+}
+
+// programs: a parameterized string of one to eight items whose conditionals nest two deep,
+// each branch up to six items (a nested conditional in a skipped branch is the shape of
+// tcell/1).
+var programs = programsOf(itemsOf(programsOf(itemsOf(programsOf(itemsOf(nil), 0, 6)), 0, 6)), 1, 8)
+
+// params: nine parameters in 1..255 (so that %c right after a push is a printable or high
+// byte, never NUL), within 20 seven times in ten.
+var params = hegel.Map(fixed(weighted(choice[int]{70, hegel.Integers(1, 20)}, choice[int]{30, hegel.Integers(1, 255)}), 9),
+	func(xs []int) (p [9]int) {
+		copy(p[:], xs)
+		return p
+	})
+
+// parmCase: a parameterized string, its parameters, the capability it is compiled as and the
+// tape of its source spellings.
+type parmCase struct {
+	prog   program
+	params [9]int
+	cap    string
+	tape   []int
+}
+
+// text is the string as compiled: tput evaluates a string only when it refers to a
+// parameter, so one that does not gets %p1%Pa appended.
+func (c parmCase) text() string {
+	s := c.prog.render()
+	if !strings.Contains(s, "%p") {
+		s += "%p1%Pa"
+	}
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c parmCase) GoString() string {
+	return fmt.Sprintf("%s=%q with parameters %v", c.cap, c.text(), c.params)
+}
+
+// parmCasesOf: a case over the programs of progs.
+func parmCasesOf(progs hegel.Generator[program]) hegel.Generator[parmCase] {
+	return hegel.Composite(func(tc hegel.TestCase) parmCase {
+		return parmCase{
+			prog:   hegel.Draw(tc, progs),
+			params: hegel.Draw(tc, params),
+			cap:    hegel.Draw(tc, hegel.SampledFrom(tputCaps)),
+			tape:   hegel.Draw(tc, tapes),
+		}
+	})
+}
+
+// parmCases: the wide TParm property's cases.
+var parmCases = parmCasesOf(programs)
