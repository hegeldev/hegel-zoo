+package reference_test
+
+// Hegel property tests for distribution/reference, written for the Hegel zoo.
+// See targets/go/distribution-reference/README.md.
+//
+// Oracles: the package's own documented grammar (the "Grammar" section of the package
+// comment in reference.go) and the normalization rules its comments state (splitDockerDomain,
+// familiarizeName, ParseNormalizedNamed, ParseDockerRef, ParseAnyReference), restated as a
+// hand-written scanner in hegel_model_test.go; the RFC 3986 reading of "IPv6address" through
+// net/netip; and the laws the API implies: Parse and String are inverse, a normalized name is
+// a fixed point of ParseNormalizedNamed and is accepted by ParseNamed, WithTag/WithDigest/
+// TrimNamed compose, Field marshals and unmarshals to the same reference, Sort orders by rank
+// then string, FamiliarMatch is path.Match on the familiar forms.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	// register the digest algorithms go-digest knows, as the package documents callers must
+	_ "crypto/sha256"
+	_ "crypto/sha512"
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// Field.UnmarshalText parses with Parse, which has no digest-only form, so a digest-only
+	// reference (from ParseAnyReference) marshals and unmarshals to a tagged repository named
+	// after the algorithm
+	fieldDigestOnly bool
+	// FamiliarString of a docker.io reference whose first path component contains a '.' or is
+	// "localhost", or whose official name is 64 hex digits, parses back to another reference
+	// or not at all
+	familiarNotInvertible bool
+	// a bracketed host is any run of hex digits and colons, not an IPv6 address
+	looseIPv6 bool
+	// ParseNormalizedNamed reports an empty name as ErrReferenceInvalidFormat and an uppercase
+	// name with an error that is not ErrNameContainsUppercase
+	normalizedErrors bool
+}{
+	fieldDigestOnly:       true,
+	familiarNotInvertible: true,
+	looseIPv6:             true,
+	normalizedErrors:      true,
+}
