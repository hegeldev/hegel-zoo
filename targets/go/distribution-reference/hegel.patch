+// TestHegelReferenceAlgebra: TrimNamed, WithTag, WithDigest, TagNameOnly, IsNameOnly, Domain,
+// Path, FamiliarName and Field compose as their documentation says on a normalized name.
+func TestHegelReferenceAlgebra(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := genRef(tc)
+		named, err := reference.ParseNormalizedNamed(s)
+		if err != nil {
+			c.count("not a name")
+			return
+		}
+		m := comps(named)
+		base := modelRef{domain: m.domain, path: m.path}
+		trimmed := reference.TrimNamed(named)
+		if !reference.IsNameOnly(trimmed) || comps(trimmed) != base || trimmed.String() != named.Name() {
+			c.failClass(ht, "TrimNamed", "TrimNamed(%q) = %q (%+v), nameOnly=%v", named.String(), trimmed.String(), comps(trimmed), reference.IsNameOnly(trimmed))
+			return
+		}
+		if reference.IsNameOnly(named) != (m.tag == "" && m.digest == "") {
+			c.failClass(ht, "IsNameOnly", "IsNameOnly(%q) = %v", named.String(), reference.IsNameOnly(named))
+			return
+		}
+		tn := reference.TagNameOnly(named)
+		wantTN := m
+		if m.tag == "" && m.digest == "" {
+			wantTN.tag = defaultTag
+		}
+		if comps(tn) != wantTN {
+			c.failClass(ht, "TagNameOnly", "TagNameOnly(%q) = %q, want %q", named.String(), tn.String(), wantTN.String())
+			return
+		}
+		if m.domain != "" && reference.Domain(named)+"/"+reference.Path(named) != named.Name() {
+			c.failClass(ht, "Domain/Path", "Domain %q + Path %q != Name %q", reference.Domain(named), reference.Path(named), named.Name())
+			return
+		}
+		if reference.FamiliarName(named) != reference.FamiliarString(trimmed) {
+			c.failClass(ht, "FamiliarName", "FamiliarName(%q) = %q, FamiliarString(TrimNamed) = %q", named.String(), reference.FamiliarName(named), reference.FamiliarString(trimmed))
+			return
+		}
+		tag := pick(tc, tags)
+		tagged, err := reference.WithTag(trimmed, tag)
+		if (err == nil) != tagOK(tag) || (err != nil && !errors.Is(err, reference.ErrTagInvalidFormat)) {
+			c.failClass(ht, "WithTag acceptance", "WithTag(%q, %q): %v; the grammar says valid=%v", trimmed.String(), tag, err, tagOK(tag))
+			return
+		}
+		if err == nil {
+			wt := base
+			wt.tag = tag
+			if comps(tagged) != wt || tagged.String() != trimmed.String()+":"+tag {
+				c.failClass(ht, "WithTag", "WithTag(%q, %q) = %q (%+v)", trimmed.String(), tag, tagged.String(), comps(tagged))
+				return
+			}
+			back, err := reference.Parse(tagged.String())
+			if err != nil || comps(back) != wt {
+				c.failClass(ht, "WithTag parse", "Parse(WithTag(%q, %q).String() = %q) = %+v, %v", trimmed.String(), tag, tagged.String(), comps(back), err)
+				return
+			}
+		}
+		dg := genDigest(tc)
+		canon, err := reference.WithDigest(trimmed, digest.Digest(dg))
+		if (err == nil) != digestGrammarOK(dg) || (err != nil && !errors.Is(err, reference.ErrDigestInvalidFormat)) {
+			c.failClass(ht, "WithDigest acceptance", "WithDigest(%q, %q): %v; the grammar says valid=%v", trimmed.String(), dg, err, digestGrammarOK(dg))
+			return
+		}
+		if err == nil {
+			wd := base
+			wd.digest = dg
+			if comps(canon) != wd || canon.String() != trimmed.String()+"@"+dg {
+				c.failClass(ht, "WithDigest", "WithDigest(%q, %q) = %q (%+v)", trimmed.String(), dg, canon.String(), comps(canon))
+				return
+			}
+			if digestValid(dg) {
+				back, err := reference.Parse(canon.String())
+				if err != nil || comps(back) != wd {
+					c.failClass(ht, "WithDigest parse", "Parse(%q) = %+v, %v", canon.String(), comps(back), err)
+					return
+				}
+			}
+			if tagOK(tag) {
+				both := base
+				both.tag, both.digest = tag, dg
+				a, err1 := reference.WithDigest(tagged, digest.Digest(dg))
+				b, err2 := reference.WithTag(canon, tag)
+				if err1 != nil || err2 != nil || comps(a) != both || comps(b) != both || a.String() != b.String() || a.String() != trimmed.String()+":"+tag+"@"+dg {
+					c.failClass(ht, "tag and digest", "WithDigest(WithTag) = %q %v, WithTag(WithDigest) = %q %v, want %q", a, err1, b, err2, both.String())
+					return
+				}
+				if comps(reference.TrimNamed(a)) != base {
+					c.failClass(ht, "TrimNamed both", "TrimNamed(%q) = %+v", a.String(), comps(reference.TrimNamed(a)))
+					return
+				}
+			}
+		}
+		for _, r := range []reference.Reference{named, trimmed} {
+			text, err := reference.AsField(r).MarshalText()
+			if err != nil || string(text) != r.String() {
+				c.failClass(ht, "MarshalText", "AsField(%q).MarshalText() = %q, %v", r.String(), text, err)
+				return
+			}
+			var f reference.Field
+			if err := f.UnmarshalText(text); err != nil || comps(f.Reference()) != comps(r) || f.Reference().String() != r.String() {
+				c.failClass(ht, "Field round trip", "Field of %q unmarshals to %v, %v", r.String(), f.Reference(), err)
+				return
+			}
+		}
+		c.count("agreed")
+	})
+}
