+// TestHegelSort: Sort returns the normalized strings ordered by the documented precedence, then
+// by string, with the unparsable strings sorted at the end; the order of the input is irrelevant
+// and the result is a fixed point.
+func TestHegelSort(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		in := make([]string, n(tc, 0, 6))
+		for i := range in {
+			in[i] = genRef(tc)
+			if Known.looseIPv6 && looseBracketHost(in[i]) {
+				c.count("skipped: bracketed host that is not an IPv6 address")
+				return
+			}
+		}
+		type ranked struct {
+			rank int
+			s    string
+		}
+		var good []ranked
+		var bad []string
+		for _, s := range in {
+			m, kind := modelAny(s)
+			if kind != errNone {
+				bad = append(bad, s)
+			} else {
+				good = append(good, ranked{rank(m), m.String()})
+			}
+		}
+		sort.Slice(good, func(i, j int) bool {
+			if good[i].rank != good[j].rank {
+				return good[i].rank < good[j].rank
+			}
+			return good[i].s < good[j].s
+		})
+		sort.Strings(bad)
+		var want []string
+		for _, g := range good {
+			want = append(want, g.s)
+		}
+		want = append(want, bad...)
+		got := reference.Sort(in)
+		if !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+			c.failClass(ht, "order", "Sort(%q) = %q, want %q", in, got, want)
+			return
+		}
+		rev := make([]string, len(in))
+		for i, s := range in {
+			rev[len(in)-1-i] = s
+		}
+		if again := reference.Sort(rev); !reflect.DeepEqual(again, got) && len(got) > 0 {
+			c.failClass(ht, "permutation", "Sort(%q) = %q, but Sort of the reverse = %q", in, got, again)
+			return
+		}
+		if fixed := reference.Sort(got); !reflect.DeepEqual(fixed, got) && len(got) > 0 {
+			c.failClass(ht, "fixed point", "Sort(Sort(%q) = %q) = %q", in, got, fixed)
+			return
+		}
+		c.count("agreed")
+	})
+}
+
+// TestHegelFamiliarMatch: FamiliarMatch is path.Match on the familiar string, then on the
+// familiar name.
+func TestHegelFamiliarMatch(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		r, err := reference.ParseAnyReference(genRef(tc))
+		if err != nil {
+			c.count("not a reference")
+			return
+		}
+		pattern := genPattern(tc)
+		got, err := reference.FamiliarMatch(pattern, r)
+		want, werr := path.Match(pattern, reference.FamiliarString(r))
+		if named, ok := r.(reference.Named); ok && !want {
+			want, _ = path.Match(pattern, reference.FamiliarName(named))
+		}
+		if got != want || !errors.Is(err, werr) {
+			c.failClass(ht, "match", "FamiliarMatch(%q, %q) = %v, %v; path.Match says %v, %v", pattern, r.String(), got, err, want, werr)
+			return
+		}
+		c.count("agreed")
+	})
+}
