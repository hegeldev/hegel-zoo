+// comps reads the components of a reference through the public interfaces.
+func comps(r reference.Reference) modelRef {
+	var m modelRef
+	if named, ok := r.(reference.Named); ok {
+		m.domain, m.path = reference.Domain(named), reference.Path(named)
+	}
+	if t, ok := r.(reference.Tagged); ok {
+		m.tag = t.Tag()
+	}
+	if d, ok := r.(reference.Digested); ok {
+		m.digest = d.Digest().String()
+	}
+	return m
+}
+
+// errKind classifies an error by the package's sentinels; anything else is go-digest's.
+func errKind(err error) string {
+	switch {
+	case err == nil:
+		return errNone
+	case errors.Is(err, reference.ErrNameEmpty):
+		return errEmpty
+	case errors.Is(err, reference.ErrNameContainsUppercase):
+		return errUppercase
+	case errors.Is(err, reference.ErrReferenceInvalidFormat):
+		return errFormat
+	case errors.Is(err, reference.ErrNameTooLong):
+		return errTooLong
+	}
+	return errDigest
+}
+
+// looseBracketHost: the string's first component is a bracketed run of hex digits and colons
+// that is not an IPv6 address (regexp.go accepts it as a domain; the grammar does not).
+func looseBracketHost(s string) bool {
+	first, _, _ := strings.Cut(s, "/")
+	return bracketAccepted(first)
+}
+
+// familiarAmbiguous: the familiar form of m reads as another reference (first path component
+// with a '.' or "localhost" is taken for a domain; a 64-hex official name is an identifier).
+func familiarAmbiguous(m modelRef) bool {
+	if m.domain != defaultDomain {
+		return false
+	}
+	first, _, _ := strings.Cut(m.path, "/")
+	if strings.Contains(first, ".") || first == "localhost" {
+		return true
+	}
+	rest, ok := strings.CutPrefix(m.path, officialPrefix)
+	return ok && isIdentifier(rest)
+}
+
+// TestHegelParseFollowsTheGrammar: Parse accepts exactly the strings of the documented grammar,
+// with the documented error for the rest, and yields the grammar's components; String gives the
+// input back.
+func TestHegelParseFollowsTheGrammar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := genRef(tc)
+		want, kind := modelParse(s)
+		got, err := reference.Parse(s)
+		if Known.looseIPv6 && looseBracketHost(s) {
+			c.count("skipped: bracketed host that is not an IPv6 address")
+			return
+		}
+		if gk := errKind(err); gk != kind {
+			c.failClass(ht, "error "+kind, "Parse(%q): err=%v (%s); the grammar says %s", s, err, gk, kind)
+			return
+		}
+		if kind != errNone {
+			c.count("rejected by both")
+			return
+		}
+		if g := comps(got); g != want {
+			c.failClass(ht, "components", "Parse(%q) = %+v, the grammar says %+v", s, g, want)
+			return
+		}
+		if got.String() != s {
+			c.failClass(ht, "string", "Parse(%q).String() = %q", s, got.String())
+			return
+		}
+		c.count("agreed")
+	})
+}
+
+// TestHegelNormalizeFollowsTheRules: ParseNormalizedNamed applies the documented normalization,
+// its result is canonical (a fixed point of itself, accepted by ParseNamed and read the same by
+// Parse), and its familiar form is what familiarizeName documents and parses back to the same
+// reference.
+func TestHegelNormalizeFollowsTheRules(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		s := genRef(tc)
+		want, kind := modelNormalize(s)
+		got, err := reference.ParseNormalizedNamed(s)
+		if Known.looseIPv6 && looseBracketHost(s) {
+			c.count("skipped: bracketed host that is not an IPv6 address")
+			return
+		}
+		switch {
+		case s == "":
+			if err == nil {
+				c.failClass(ht, "empty accepted", "ParseNormalizedNamed(%q) accepted", s)
+				return
+			}
+			if Known.normalizedErrors {
+				c.count("skipped: error identity of the empty name")
+				return
+			}
+			if !errors.Is(err, reference.ErrNameEmpty) {
+				c.failClass(ht, "empty error", "ParseNormalizedNamed(%q): %v, want ErrNameEmpty", s, err)
+			}
+			return
+		case kind == errIdent:
+			if err == nil {
+				c.failClass(ht, "identifier accepted", "ParseNormalizedNamed(%q) accepted a 64-hex identifier", s)
+				return
+			}
+			c.count("identifier rejected")
+			return
+		case kind == errUppercase:
+			if err == nil {
+				c.failClass(ht, "uppercase accepted", "ParseNormalizedNamed(%q) accepted", s)
+				return
+			}
+			if Known.normalizedErrors {
+				c.count("skipped: error identity of an uppercase name")
+				return
+			}
+			if !errors.Is(err, reference.ErrNameContainsUppercase) {
+				c.failClass(ht, "uppercase error", "ParseNormalizedNamed(%q): %v, want ErrNameContainsUppercase", s, err)
+			}
+			return
+		}
+		if gk := errKind(err); gk != kind {
+			c.failClass(ht, "error "+kind, "ParseNormalizedNamed(%q): err=%v (%s); the rules say %s", s, err, gk, kind)
+			return
+		}
+		if kind != errNone {
+			c.count("rejected by both")
+			return
+		}
+		if g := comps(got); g != want {
+			c.failClass(ht, "components", "ParseNormalizedNamed(%q) = %+v, the rules say %+v", s, g, want)
+			return
+		}
+		canon := got.String()
+		if canon != want.String() {
+			c.failClass(ht, "string", "ParseNormalizedNamed(%q).String() = %q, want %q", s, canon, want.String())
+			return
+		}
+		again, err := reference.ParseNormalizedNamed(canon)
+		if err != nil || comps(again) != want {
+			c.failClass(ht, "fixed point", "ParseNormalizedNamed(%q) = %+v, %v; not the fixed point %+v", canon, comps(again), err, want)
+			return
+		}
+		named, err := reference.ParseNamed(canon)
+		if err != nil || comps(named) != want {
+			c.failClass(ht, "ParseNamed", "ParseNamed(%q) = %+v, %v; want %+v", canon, comps(named), err, want)
+			return
+		}
+		plain, err := reference.Parse(canon)
+		if err != nil || comps(plain) != want {
+			c.failClass(ht, "Parse of canonical", "Parse(%q) = %+v, %v; want %+v", canon, comps(plain), err, want)
+			return
+		}
+		fam := reference.FamiliarString(got)
+		if wf := familiar(want); fam != wf.String() || reference.FamiliarName(got) != wf.name() {
+			c.failClass(ht, "familiar", "FamiliarString(%q) = %q, FamiliarName = %q; the rules say %q and %q", canon, fam, reference.FamiliarName(got), wf.String(), wf.name())
+			return
+		}
+		if Known.familiarNotInvertible && familiarAmbiguous(want) {
+			c.count("skipped: familiar form reads as another reference")
+			return
+		}
+		back, err := reference.ParseNormalizedNamed(fam)
+		if err != nil || comps(back) != want {
+			c.failClass(ht, "familiar round trip", "ParseNormalizedNamed(FamiliarString(%q) = %q) = %+v, %v; want %+v", canon, fam, comps(back), err, want)
+			return
+		}
+		c.count("agreed")
+	})
+}
