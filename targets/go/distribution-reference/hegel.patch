diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..fc331cc
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,153 @@
+package reference_test
+
+// Generators: reference strings, valid and not, in the shapes the grammar and the
+// normalization rules care about.
+
+import (
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	alnumPieces  = []string{"a", "b", "z", "0", "9", "foo", "ubuntu", "lib", "x1", "sha256", "library", "localhost", "docker"}
+	separators   = []string{".", "_", "__", "-", "--", "---"}
+	badSepPieces = []string{"___", "..", "._", "-.", "A", "Foo", " ", "é", "~", "+", ",", "%2F"}
+	domains      = []string{
+		"docker.io", "index.docker.io", "registry-1.docker.io", "localhost", "localhost:5000", "example.com",
+		"Example.COM", "EXAMPLE", "127.0.0.1", "127.0.0.1:5000", "[::1]", "[::1]:5000", "[fd00:1:2::3]",
+		"[2001:0db8:85a3:0000:0000:8a2e:0370:7334]:443", "[abc]", "[1::2::3]", "[:::::]", "[12345::1]",
+		"[::ffff:1.2.3.4]", "[fe80::1%eth0]", "[]", "a", "Foo", "a-b.c", "a_b", "-a.b", "a..b", "a.", "x:",
+		"x:99999", "x:0x", "docker.io:443", "DOCKER.IO", "Docker.io", "a.b.c.d.e", "a-", "a--b",
+	}
+	tags = []string{
+		"latest", "1.0", "v1.2.3-rc.1", "_x", "a", "LATEST", "Foo.Bar-baz_qux", ".hidden", "-x", "", "a b", "é",
+		"a:b", "a/b", "a@b", strings.Repeat("t", 128), strings.Repeat("t", 129), "5000",
+	}
+)
+
+var (
+	hex64  = strings.Repeat("0123456789abcdef", 4)
+	hex96  = strings.Repeat("0123456789abcdef", 6)
+	hex128 = strings.Repeat("0123456789abcdef", 8)
+	hex32  = strings.Repeat("0123456789abcdef", 2)
+)
+
+func genDigest(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4:
+		return "sha256:" + hex64
+	case 5:
+		return pick(tc, []string{"sha512:" + hex128, "sha384:" + hex96})
+	case 6:
+		return "sha256:" + strings.ToUpper(hex64)
+	case 7:
+		return pick(tc, []string{"sha256:" + hex32, "sha256:" + hex64 + "ab", "sha256:" + hex64[:63], "sha256:"})
+	case 8:
+		return pick(tc, []string{"foo:" + hex32, "sha256+b64u:" + hex64, "sha256.x:" + hex64, "sha256_2:" + hex64, "sha256-x:" + hex64, "SHA256:" + hex64, "Sha256:" + hex64})
+	default:
+		return pick(tc, []string{"sha256++x:" + hex64, "+sha256:" + hex64, "sha256+:" + hex64, "sha 256:" + hex64, "1sha:" + hex64, "sha256:" + hex64 + "g", "sha256", ":" + hex64, "sha256:" + hex64 + ":" + hex64})
+	}
+}
+
+func genComponent(tc hegel.TestCase) string {
+	var b strings.Builder
+	b.WriteString(pick(tc, alnumPieces))
+	for i := n(tc, 0, 2); i > 0; i-- {
+		if chance(tc, 15) {
+			b.WriteString(pick(tc, badSepPieces))
+		} else {
+			b.WriteString(pick(tc, separators))
+		}
+		b.WriteString(pick(tc, alnumPieces))
+	}
+	switch n(tc, 1, 20) {
+	case 1:
+		return b.String() + pick(tc, separators)
+	case 2:
+		return pick(tc, separators) + b.String()
+	case 3:
+		return strings.ToUpper(b.String()[:1]) + b.String()[1:]
+	}
+	return b.String()
+}
+
+func genRemoteName(tc hegel.TestCase) string {
+	switch n(tc, 1, 12) {
+	case 1:
+		return "library/" + genComponent(tc)
+	case 2:
+		return pick(tc, []string{hex64, "library/" + hex64, strings.ToUpper(hex64), hex64[:63], "library/a/b", "sha256", ""})
+	case 3:
+		return pick(tc, []string{strings.Repeat("a", 255), strings.Repeat("a", 256), strings.Repeat("a", 247), strings.Repeat("a", 248), strings.Repeat("a/", 127) + "a"})
+	}
+	parts := make([]string, n(tc, 1, 3))
+	for i := range parts {
+		parts[i] = genComponent(tc)
+	}
+	return strings.Join(parts, "/")
+}
+
+// genName: [domain '/'] remote-name.
+func genName(tc hegel.TestCase) string {
+	name := genRemoteName(tc)
+	if chance(tc, 55) {
+		name = pick(tc, domains) + "/" + name
+	}
+	return name
+}
+
+// genRef: a reference string; a fifth are mutated.
+func genRef(tc hegel.TestCase) string {
+	var b strings.Builder
+	b.WriteString(genName(tc))
+	if chance(tc, 40) {
+		b.WriteByte(':')
+		b.WriteString(pick(tc, tags))
+	}
+	if chance(tc, 35) {
+		b.WriteByte('@')
+		b.WriteString(genDigest(tc))
+	}
+	s := b.String()
+	if chance(tc, 8) {
+		s = pick(tc, []string{hex64, "sha256:" + hex64, strings.ToUpper(hex64), hex64 + ":tag", "sha256:" + hex64 + ":tag", "@sha256:" + hex64, ":latest", "", "/", "a/", "/a", "a//b", "a:/b"})
+	}
+	if chance(tc, 20) {
+		s = mutate(tc, s)
+	}
+	return s
+}
+
+func mutate(tc hegel.TestCase, s string) string {
+	if s == "" {
+		return pick(tc, []string{":", "@", "/", " "})
+	}
+	i := n(tc, 0, len(s))
+	switch n(tc, 1, 4) {
+	case 1:
+		return s[:i] + pick(tc, []string{"/", ":", "@", ".", "-", "_", "__", "[", "]", " ", "A", "é", "%"}) + s[i:]
+	case 2:
+		if i < len(s) {
+			return s[:i] + s[i+1:]
+		}
+		return s
+	case 3:
+		return s[:i] + strings.ToUpper(s[i:])
+	default:
+		if i < len(s) {
+			return s[:i] + s[i:i+1] + s[i:]
+		}
+		return s + s[len(s)-1:]
+	}
+}
+
+// genPattern: a path.Match pattern.
+func genPattern(tc hegel.TestCase) string {
+	pieces := []string{"*", "*", "?", "[a-z]", "[!a]", "[a-", "\\", "docker.io/", "library/", "ubuntu", "foo", "/", ":", "@", "a", "*/*", "sha256:*", "*:latest"}
+	var b strings.Builder
+	for i := n(tc, 1, 4); i > 0; i-- {
+		b.WriteString(pick(tc, pieces))
+	}
+	return b.String()
+}
diff --git a/hegel_model_test.go b/hegel_model_test.go
new file mode 100644
index 0000000..a86a474
--- /dev/null
+++ b/hegel_model_test.go
@@ -0,0 +1,423 @@
+package reference_test
+
+// The model: the package's documented grammar (package comment of reference.go) as a
+// hand-written scanner, and the normalization rules the comments of normalize.go state.
+//
+//	reference        := name [ ":" tag ] [ "@" digest ]
+//	name             := [domain '/'] remote-name
+//	domain           := host [':' port-number]
+//	host             := domain-name | IPv4address | \[ IPv6address \]   ; rfc3986 appendix-A
+//	domain-name      := domain-component ['.' domain-component]*
+//	domain-component := /([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9])/
+//	port-number      := /[0-9]+/
+//	path-component   := alpha-numeric [separator alpha-numeric]*
+//	remote-name      := path-component ['/' path-component]*
+//	alpha-numeric    := /[a-z0-9]+/
+//	separator        := one of '.', '_', '__' or one or more '-' (regexp.go: `(?:[._]|__|[-]+)`)
+//	tag              := /[\w][\w.-]{0,127}/
+//	digest           := digest-algorithm ":" digest-hex
+//	digest-algorithm := component [ separator component ]*, separator one of '+', '.', '-', '_'
+//	component        := /[A-Za-z][A-Za-z0-9]*/
+//	digest-hex       := /[0-9a-fA-F]{32,}/
+//	identifier       := /[a-f0-9]{64}/
+
+import (
+	"net/netip"
+	"strings"
+)
+
+const (
+	repositoryNameMax = 255
+	defaultDomain     = "docker.io"
+	legacyDomain      = "index.docker.io"
+	officialPrefix    = "library/"
+	defaultTag        = "latest"
+)
+
+// registered digest algorithms (go-digest v1.0.0 registers sha256, sha384 and sha512 itself)
+// and the hex length each requires.
+var registeredAlgorithms = map[string]int{"sha256": 64, "sha384": 96, "sha512": 128}
+
+func isLowerAlnum(c byte) bool { return c >= 'a' && c <= 'z' || c >= '0' && c <= '9' }
+func isAlnum(c byte) bool      { return isLowerAlnum(c) || c >= 'A' && c <= 'Z' }
+func isDigit(c byte) bool      { return c >= '0' && c <= '9' }
+func isHex(c byte) bool {
+	return isDigit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
+}
+func isWord(c byte) bool { return isAlnum(c) || c == '_' }
+
+// pathComponentOK: alpha-numeric [separator alpha-numeric]*.
+func pathComponentOK(s string) bool {
+	i := 0
+	for {
+		j := i
+		for j < len(s) && isLowerAlnum(s[j]) {
+			j++
+		}
+		if j == i {
+			return false
+		}
+		if j == len(s) {
+			return true
+		}
+		switch s[j] {
+		case '.':
+			j++
+		case '_':
+			j++
+			if j < len(s) && s[j] == '_' {
+				j++
+			}
+		case '-':
+			for j < len(s) && s[j] == '-' {
+				j++
+			}
+		default:
+			return false
+		}
+		i = j
+	}
+}
+
+func remoteNameOK(s string) bool {
+	for _, c := range strings.Split(s, "/") {
+		if !pathComponentOK(c) {
+			return false
+		}
+	}
+	return true
+}
+
+func domainComponentOK(s string) bool {
+	if s == "" || !isAlnum(s[0]) || !isAlnum(s[len(s)-1]) {
+		return false
+	}
+	for i := 1; i < len(s)-1; i++ {
+		if !isAlnum(s[i]) && s[i] != '-' {
+			return false
+		}
+	}
+	return true
+}
+
+func domainNameOK(s string) bool {
+	for _, c := range strings.Split(s, ".") {
+		if !domainComponentOK(c) {
+			return false
+		}
+	}
+	return true
+}
+
+// bracketedHexColons: what regexp.go accepts as an IPv6 address, `\[[a-fA-F0-9:]+\]`.
+func bracketedHexColons(s string) bool {
+	if len(s) < 3 || s[0] != '[' || s[len(s)-1] != ']' {
+		return false
+	}
+	for i := 1; i < len(s)-1; i++ {
+		if !isHex(s[i]) && s[i] != ':' {
+			return false
+		}
+	}
+	return true
+}
+
+// ipv6OK: "\[ IPv6address \]" per RFC 3986 appendix A, without a zone (RFC 6874) and without the
+// forms that embed a dotted IPv4 address ("special addresses such as IPv4-Mapped"), both
+// excluded by regexp.go's comments; net/netip decides the address.
+func ipv6OK(s string) bool {
+	if len(s) < 3 || s[0] != '[' || s[len(s)-1] != ']' || strings.Contains(s, ".") {
+		return false
+	}
+	a, err := netip.ParseAddr(s[1 : len(s)-1])
+	return err == nil && a.Is6() && a.Zone() == ""
+}
+
+// hostOK follows the grammar strictly (a bracketed host must be an IPv6 address).
+func hostOK(s string) bool {
+	if strings.HasPrefix(s, "[") {
+		return ipv6OK(s)
+	}
+	return domainNameOK(s)
+}
+
+func domainOK(s string) bool {
+	host, port := s, ""
+	if i := strings.LastIndexByte(s, ':'); i >= 0 && !strings.Contains(s[i:], "]") {
+		host, port = s[:i], s[i+1:]
+		if port == "" {
+			return false
+		}
+		for i := 0; i < len(port); i++ {
+			if !isDigit(port[i]) {
+				return false
+			}
+		}
+	}
+	return hostOK(host)
+}
+
+// bracketAccepted: the domain would be accepted with regexp.go's loose IPv6 form.
+func bracketAccepted(s string) bool {
+	host := s
+	if i := strings.LastIndexByte(s, ':'); i >= 0 && !strings.Contains(s[i:], "]") {
+		host = s[:i]
+	}
+	return bracketedHexColons(host) && !ipv6OK(host)
+}
+
+func tagOK(s string) bool {
+	if s == "" || len(s) > 128 || !isWord(s[0]) {
+		return false
+	}
+	for i := 1; i < len(s); i++ {
+		if !isWord(s[i]) && s[i] != '.' && s[i] != '-' {
+			return false
+		}
+	}
+	return true
+}
+
+// digestGrammarOK: digest-algorithm ":" digest-hex.
+func digestGrammarOK(s string) bool {
+	alg, hex, ok := strings.Cut(s, ":")
+	if !ok || len(hex) < 32 {
+		return false
+	}
+	for i := 0; i < len(hex); i++ {
+		if !isHex(hex[i]) {
+			return false
+		}
+	}
+	for _, comp := range strings.FieldsFunc(alg, func(r rune) bool { return r == '+' || r == '.' || r == '-' || r == '_' }) {
+		if comp == "" || !(comp[0] >= 'a' && comp[0] <= 'z' || comp[0] >= 'A' && comp[0] <= 'Z') {
+			return false
+		}
+		for i := 1; i < len(comp); i++ {
+			if !isAlnum(comp[i]) {
+				return false
+			}
+		}
+	}
+	// FieldsFunc drops empty fields: reject doubled or edge separators explicitly
+	if alg == "" || strings.ContainsAny(alg[:1]+alg[len(alg)-1:], "+.-_") {
+		return false
+	}
+	for i := 1; i < len(alg); i++ {
+		if strings.IndexByte("+.-_", alg[i]) >= 0 && strings.IndexByte("+.-_", alg[i-1]) >= 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// digestValid: go-digest's Parse accepts it (registered algorithm, lowercase hex of its size).
+func digestValid(s string) bool {
+	alg, hex, _ := strings.Cut(s, ":")
+	size, ok := registeredAlgorithms[alg]
+	if !ok || len(hex) != size {
+		return false
+	}
+	for i := 0; i < len(hex); i++ {
+		if !(isDigit(hex[i]) || hex[i] >= 'a' && hex[i] <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func isIdentifier(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !(isDigit(s[i]) || s[i] >= 'a' && s[i] <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// modelRef: the components of a reference.
+type modelRef struct {
+	domain, path, tag, digest string
+}
+
+func (m modelRef) name() string {
+	if m.domain == "" {
+		return m.path
+	}
+	return m.domain + "/" + m.path
+}
+
+func (m modelRef) String() string {
+	if m.path == "" {
+		return m.digest // digest-only
+	}
+	s := m.name()
+	if m.tag != "" {
+		s += ":" + m.tag
+	}
+	if m.digest != "" {
+		s += "@" + m.digest
+	}
+	return s
+}
+
+// error kinds of the model
+const (
+	errNone      = ""
+	errEmpty     = "empty"      // ErrNameEmpty
+	errUppercase = "uppercase"  // ErrNameContainsUppercase
+	errFormat    = "format"     // ErrReferenceInvalidFormat
+	errTooLong   = "toolong"    // ErrNameTooLong
+	errDigest    = "digest"     // go-digest's error (algorithm not registered, wrong hex)
+	errIdent     = "identifier" // ParseNormalizedNamed: a bare 64-hex identifier
+)
+
+// splitGrammar splits s per the grammar, strictly; ok is false when s is not a reference.
+// The domain is the first component when it is a domain and the rest is a remote-name
+// (regexp.go's `(?:(domain)/)?(remote-name)` prefers the domain when both readings fit).
+func splitGrammar(s string) (m modelRef, ok bool) {
+	rest := s
+	if i := strings.IndexByte(rest, '@'); i >= 0 {
+		m.digest = rest[i+1:]
+		rest = rest[:i]
+		if !digestGrammarOK(m.digest) {
+			return m, false
+		}
+	}
+	if i := strings.LastIndexByte(rest, ':'); i >= 0 && !strings.Contains(rest[i:], "/") {
+		m.tag = rest[i+1:]
+		rest = rest[:i]
+		if !tagOK(m.tag) {
+			return m, false
+		}
+	}
+	if rest == "" {
+		return m, false
+	}
+	if first, remainder, has := strings.Cut(rest, "/"); has && domainOK(first) && remoteNameOK(remainder) {
+		m.domain, m.path = first, remainder
+		return m, true
+	}
+	if remoteNameOK(rest) {
+		m.path = rest
+		return m, true
+	}
+	return m, false
+}
+
+// modelParse: reference.Parse per the grammar and the documented errors.
+func modelParse(s string) (modelRef, string) {
+	if s == "" {
+		return modelRef{}, errEmpty
+	}
+	m, ok := splitGrammar(s)
+	if !ok {
+		if sl := strings.ToLower(s); sl != s {
+			if _, ok := splitGrammar(sl); ok {
+				return modelRef{}, errUppercase
+			}
+		}
+		return modelRef{}, errFormat
+	}
+	if len(m.path) > repositoryNameMax {
+		return modelRef{}, errTooLong
+	}
+	if m.digest != "" && !digestValid(m.digest) {
+		return modelRef{}, errDigest
+	}
+	return m, errNone
+}
+
+// splitDockerDomain: the rules stated in normalize.go's comments.
+func splitDockerDomain(name string) (domain, remote string) {
+	maybeDomain, maybeRemote, ok := strings.Cut(name, "/")
+	if !ok {
+		return defaultDomain, officialPrefix + name
+	}
+	switch {
+	case maybeDomain == "localhost":
+		domain, remote = maybeDomain, maybeRemote
+	case maybeDomain == legacyDomain:
+		domain, remote = defaultDomain, maybeRemote
+	case strings.ContainsAny(maybeDomain, ".:"):
+		domain, remote = maybeDomain, maybeRemote
+	case strings.ToLower(maybeDomain) != maybeDomain:
+		domain, remote = maybeDomain, maybeRemote
+	default:
+		domain, remote = defaultDomain, name
+	}
+	if domain == defaultDomain && !strings.Contains(remote, "/") {
+		remote = officialPrefix + remote
+	}
+	return domain, remote
+}
+
+// modelNormalize: ParseNormalizedNamed.
+func modelNormalize(s string) (modelRef, string) {
+	if isIdentifier(s) {
+		return modelRef{}, errIdent
+	}
+	domain, remainder := splitDockerDomain(s)
+	remote := remainder
+	if i := strings.IndexByte(remainder, ':'); i >= 0 {
+		remote = remainder[:i]
+	}
+	if strings.ToLower(remote) != remote {
+		return modelRef{}, errUppercase
+	}
+	return modelParse(domain + "/" + remainder)
+}
+
+// familiar: familiarizeName.
+func familiar(m modelRef) modelRef {
+	if m.domain == defaultDomain {
+		m.domain = ""
+		if rest, ok := strings.CutPrefix(m.path, officialPrefix); ok && !strings.Contains(rest, "/") {
+			m.path = rest
+		}
+	}
+	return m
+}
+
+// modelDockerRef: ParseDockerRef.
+func modelDockerRef(s string) (modelRef, string) {
+	m, kind := modelNormalize(s)
+	if kind != errNone {
+		return m, kind
+	}
+	if m.digest != "" {
+		m.tag = ""
+	} else if m.tag == "" {
+		m.tag = defaultTag
+	}
+	return m, errNone
+}
+
+// modelAny: ParseAnyReference.
+func modelAny(s string) (modelRef, string) {
+	if isIdentifier(s) {
+		return modelRef{digest: "sha256:" + s}, errNone
+	}
+	if alg, _, ok := strings.Cut(s, ":"); ok && alg != "" && digestValid(s) {
+		return modelRef{digest: s}, errNone
+	}
+	return modelNormalize(s)
+}
+
+// rank: sort.go's precedence.
+func rank(m modelRef) int {
+	switch {
+	case m.path == "":
+		return 5
+	case m.tag != "" && m.digest != "":
+		return 1
+	case m.tag != "":
+		return 2
+	case m.digest != "":
+		return 3
+	}
+	return 4
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..7d57de8
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,102 @@
+package reference_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/distribution/reference"
+)
+
+// distribution-reference/1: a digest-only reference does not survive Field's text round trip:
+// UnmarshalText uses Parse, which reads "sha256:<hex>" as the repository "sha256" tagged <hex>.
+func TestHegelPinFieldKeepsDigestOnlyReferences(t *testing.T) {
+	s := "sha256:" + hex64
+	r, err := reference.ParseAnyReference(s)
+	if err != nil {
+		t.Fatalf("ParseAnyReference(%q): %v", s, err)
+	}
+	text, err := reference.AsField(r).MarshalText()
+	if err != nil || string(text) != s {
+		t.Fatalf("MarshalText = %q, %v", text, err)
+	}
+	var f reference.Field
+	if err := f.UnmarshalText(text); err != nil {
+		t.Fatalf("UnmarshalText(%q): %v", text, err)
+	}
+	back := f.Reference()
+	if _, named := back.(reference.Named); named {
+		t.Errorf("Field of the digest-only reference %q unmarshals to %T %q, a named reference", s, back, back.String())
+	}
+	if d, ok := back.(reference.Digested); !ok || d.Digest().String() != s {
+		t.Errorf("Field of %q unmarshals to %T, not a Digested reference with that digest", s, back)
+	}
+}
+
+// distribution-reference/2: the familiar string of a docker.io reference whose first path
+// component contains a '.' or is "localhost", or whose official name is 64 hex digits, is read
+// back as another reference or rejected.
+func TestHegelPinFamiliarStringParsesBack(t *testing.T) {
+	for _, s := range []string{"docker.io/foo.bar/baz", "docker.io/localhost/baz", "docker.io/index.docker.io/baz", "docker.io/library/" + hex64} {
+		named, err := reference.ParseNormalizedNamed(s)
+		if err != nil {
+			t.Errorf("ParseNormalizedNamed(%q): %v", s, err)
+			continue
+		}
+		fam := reference.FamiliarString(named)
+		back, err := reference.ParseNormalizedNamed(fam)
+		if err != nil {
+			t.Errorf("ParseNormalizedNamed(FamiliarString(%q) = %q): %v", s, fam, err)
+			continue
+		}
+		if back.String() != named.String() {
+			t.Errorf("FamiliarString(%q) = %q, which normalizes to %q", s, fam, back.String())
+		}
+	}
+}
+
+// distribution-reference/3: a bracketed host is accepted when it is any run of hex digits and
+// colons; the grammar says "\[ IPv6address \]" (RFC 3986 appendix A).
+func TestHegelPinBracketedHostIsAnIPv6Address(t *testing.T) {
+	for _, s := range []string{"[abc]/foo", "[:::::]/foo", "[1::2::3]/foo", "[12345::1]/foo", "[1:2:3:4:5:6:7:8:9]/foo"} {
+		if r, err := reference.Parse(s); err == nil {
+			t.Errorf("Parse(%q) accepted with domain %q; the host is not an IPv6 address", s, reference.Domain(r.(reference.Named)))
+		}
+	}
+}
+
+// distribution-reference/4: ParseNormalizedNamed reports the errors Parse reports with the
+// package's sentinels as other errors: an empty name is "invalid reference format" rather than
+// ErrNameEmpty, an uppercase name is an error that is not ErrNameContainsUppercase.
+func TestHegelPinNormalizedErrorsAreTheSentinels(t *testing.T) {
+	if _, err := reference.ParseNormalizedNamed(""); !errors.Is(err, reference.ErrNameEmpty) {
+		t.Errorf("ParseNormalizedNamed(\"\"): %v; Parse(\"\") returns ErrNameEmpty", err)
+	}
+	for _, s := range []string{"Ubuntu", "foo/Bar", "docker.io/Foo"} {
+		if _, err := reference.ParseNormalizedNamed(s); !errors.Is(err, reference.ErrNameContainsUppercase) {
+			t.Errorf("ParseNormalizedNamed(%q): %v; not ErrNameContainsUppercase, which Parse(%q) returns", s, err, s)
+		}
+	}
+}
+
+// distribution-reference/5: the grammar in the package comment writes the name separator as
+// /[_.]|__|[-]*/ (an empty separator) and the digest-algorithm separator as /[+.-_]/ (a range
+// from '.' to '_', taking in digits, ':', '@' and the uppercase letters); regexp.go uses
+// `[-]+` and `[-_+.]`.
+func TestHegelPinGrammarMatchesTheCode(t *testing.T) {
+	src, err := os.ReadFile("reference.go")
+	if err != nil {
+		t.Skipf("reference.go not readable: %v", err)
+	}
+	doc := string(src)
+	if strings.Contains(doc, "separator                       := /[_.]|__|[-]*/") {
+		t.Errorf("the grammar's separator is /[_.]|__|[-]*/; the code requires one or more dashes ([-]+)")
+	}
+	if strings.Contains(doc, "digest-algorithm-separator      := /[+.-_]/") {
+		t.Errorf("the grammar's digest-algorithm-separator is /[+.-_]/, a range from '.' to '_'; the code uses [-_+.]")
+	}
+}
