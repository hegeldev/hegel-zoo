+// ---------------------------------------------------------------------------
+// Property 9: copy-on-write isolation.
+
+func TestHegelCopyOnWriteIsolatesBitmaps(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		a, sa, opsA := genBitmap(ht, keys)
+		a.SetCopyOnWrite(true)
+		if !a.GetCopyOnWrite() {
+			fail(ht, "GetCopyOnWrite false after SetCopyOnWrite(true)")
+		}
+		b, sb, opsB := genBitmap(ht, keys)
+		b.SetCopyOnWrite(chance(ht, 50))
+		note(ht, "a: %v\nb: %v", opsA, opsB)
+		// Derived bitmaps share containers; mutating any one must not show
+		// in the others.
+		derived := []struct {
+			name string
+			rb   *roaring.Bitmap
+			want set
+		}{
+			{"Clone", a.Clone(), sa},
+			{"Or", roaring.Or(a, b), sa.union(sb)},
+			{"And", roaring.And(a, b), sa.inter(sb)},
+			{"AndNot", roaring.AndNot(a, b), sa.minus(sb, universe32)},
+			{"Xor", roaring.Xor(a, b), sa.xor(sb, universe32)},
+			{"FastOr", roaring.FastOr(a, b), sa.union(sb)},
+			{"Flip", roaring.Flip(a, 0, 0), sa},
+		}
+		for _, d := range derived {
+			check(ht, d.name, d.rb, d.want)
+		}
+		for round := 0; round < 3; round++ {
+			i := n(ht, 0, len(derived)-1)
+			d := &derived[i]
+			o := genOp(ht, keys, d.want)
+			if o.kind == "clone" {
+				continue
+			}
+			d.rb, d.want = apply(ht, d.rb, d.want, o)
+			check(ht, fmt.Sprintf("%s after %v", d.name, o), d.rb, d.want)
+			check(ht, "a after mutating "+d.name, a, sa)
+			check(ht, "b after mutating "+d.name, b, sb)
+			for j, e := range derived {
+				if j != i {
+					check(ht, fmt.Sprintf("%s after mutating %s", e.name, d.name), e.rb, e.want)
+				}
+			}
+		}
+		// The in-place ops on a copy-on-write receiver.
+		o := genOp(ht, keys, sa)
+		a2, sa2 := apply(ht, a, sa, o)
+		check(ht, fmt.Sprintf("copy-on-write receiver after %v", o), a2, sa2)
+		for _, d := range derived {
+			check(ht, d.name+" after mutating a", d.rb, d.want)
+		}
+		c := a2.Clone()
+		c.CloneCopyOnWriteContainers()
+		check(ht, "CloneCopyOnWriteContainers", c, sa2)
+	})
+}
