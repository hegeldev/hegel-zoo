+// ---------------------------------------------------------------------------
+// Property 10: the 64-bit bitmap mirrors the 32-bit one over a wider universe.
+
+const universe64 = uint64(1) << 63
+
+func genKeys64(tc hegel.TestCase) []uint64 {
+	k := n(tc, 1, 3)
+	var keys []uint64
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 4) {
+		case 0:
+			keys = append(keys, 0)
+		case 1:
+			keys = append(keys, uint64(n(tc, 1, 3)))
+		case 2:
+			keys = append(keys, uint64(1)<<31-1-uint64(n(tc, 0, 2)))
+		case 3:
+			keys = append(keys, uint64(n(tc, 0, 1<<30)))
+		default:
+			if len(keys) > 0 && keys[len(keys)-1] < 1<<31-1 {
+				keys = append(keys, keys[len(keys)-1]+1)
+			} else {
+				keys = append(keys, 1)
+			}
+		}
+	}
+	return keys
+}
+
+func genPoint64(tc hegel.TestCase, keys []uint64) uint64 {
+	k := pick(tc, keys...)
+	var low uint64
+	switch n(tc, 0, 3) {
+	case 0:
+		low = uint64(pick(tc, 0, 1, 65535, 65536, 1<<32-1, 1<<32-2))
+	case 1:
+		low = uint64(n(tc, 0, 100))
+	default:
+		low = uint64(n(tc, 0, 1<<32-1))
+	}
+	return k<<32 | low
+}
+
+func genRange64(tc hegel.TestCase, keys []uint64) (uint64, uint64) {
+	lo := genPoint64(tc, keys)
+	var length uint64
+	switch n(tc, 0, 5) {
+	case 0:
+		length = uint64(n(tc, 0, 3))
+	case 1:
+		length = uint64(pick(tc, 4096, 4097, 65536, 65537, 131072))
+	case 2:
+		length = uint64(n(tc, 60000, 200000))
+	default:
+		length = uint64(n(tc, 1, 5000))
+	}
+	hi := lo + length
+	if hi > universe64 || hi < lo {
+		hi = universe64
+	}
+	if chance(tc, 10) {
+		lo, hi = hi, lo
+	}
+	return lo, hi
+}
+
+func setOf64(rb *roaring64.Bitmap) (set, error) {
+	card := rb.GetCardinality()
+	if card > 2000000 {
+		return nil, fmt.Errorf("64-bit bitmap too large to read back (%d)", card)
+	}
+	var out []iv
+	var prev uint64
+	it := rb.Iterator()
+	for i := uint64(0); it.HasNext(); i++ {
+		v := it.Next()
+		if i > 0 && v <= prev {
+			return nil, fmt.Errorf("Iterator not increasing: %d after %d", v, prev)
+		}
+		prev = v
+		out = append(out, iv{v, v + 1})
+		if i > card {
+			return nil, fmt.Errorf("Iterator yields more than the cardinality %d", card)
+		}
+	}
+	s := norm(out)
+	if s.card() != card {
+		return nil, fmt.Errorf("Iterator yields %d values, GetCardinality %d", s.card(), card)
+	}
+	arr := rb.ToArray()
+	if !reflect.DeepEqual(arr, s.values64()) && !(len(arr) == 0 && card == 0) {
+		return nil, fmt.Errorf("ToArray %s differs from the iterator %s", short64(arr), short64(s.values64()))
+	}
+	return s, nil
+}
+
+func check64(ht *hegel.T, what string, rb *roaring64.Bitmap, want set) {
+	if err := rb.Validate(); !tolerated(err) {
+		fail(ht, "%s: Validate: %v", what, err)
+	}
+	got, err := setOf64(rb)
+	if err != nil {
+		fail(ht, "%s: %v", what, err)
+	}
+	if !got.equal(want) {
+		fail(ht, "%s: bitmap is %s, want %s", what, got, want)
+	}
+	if rb.IsEmpty() != (want.card() == 0) {
+		fail(ht, "%s: IsEmpty %v", what, rb.IsEmpty())
+	}
+	if want.card() > 0 {
+		if mn, mx := rb.Minimum(), rb.Maximum(); mn != want.min() || mx != want.max() {
+			fail(ht, "%s: Minimum/Maximum %d/%d, want %d/%d", what, mn, mx, want.min(), want.max())
+		}
+	}
+}
+
+func genBitmap64(ht *hegel.T, keys []uint64) (*roaring64.Bitmap, set, []string) {
+	rb := roaring64.New()
+	if chance(ht, 30) {
+		rb.SetCopyOnWrite(true)
+	}
+	var cur set
+	var ops []string
+	k := n(ht, 0, 8)
+	for i := 0; i < k; i++ {
+		switch n(ht, 0, 7) {
+		case 0, 1:
+			x := genPoint64(ht, keys)
+			rb.Add(x)
+			cur = cur.add(x)
+			ops = append(ops, fmt.Sprintf("add(%d)", x))
+		case 2:
+			x := genPoint64(ht, keys)
+			if cur.card() > 0 && cur.card() < 100000 && chance(ht, 50) {
+				v := cur.values64()
+				x = v[n(ht, 0, len(v)-1)]
+			}
+			if got := rb.CheckedRemove(x); got != cur.contains(x) {
+				fail(ht, "CheckedRemove(%d) = %v on %s", x, got, cur)
+			}
+			cur = cur.remove(x, universe64)
+			ops = append(ops, fmt.Sprintf("remove(%d)", x))
+		case 3, 4:
+			lo, hi := genRange64(ht, keys)
+			if lo < hi && hi-lo > 300000 {
+				hi = lo + 300000
+			}
+			rb.AddRange(lo, hi)
+			if lo < hi {
+				cur = cur.addRange(lo, hi)
+			}
+			ops = append(ops, fmt.Sprintf("addrange(%d,%d)", lo, hi))
+		case 5:
+			lo, hi := genRange64(ht, keys)
+			rb.RemoveRange(lo, hi)
+			if lo < hi {
+				cur = cur.removeRange(lo, hi, universe64)
+			}
+			ops = append(ops, fmt.Sprintf("removerange(%d,%d)", lo, hi))
+		case 6:
+			lo, hi := genRange64(ht, keys)
+			if lo < hi && hi-lo > 300000 {
+				hi = lo + 300000
+			}
+			rb.Flip(lo, hi)
+			if lo < hi {
+				cur = cur.flip(lo, hi, universe64)
+			}
+			ops = append(ops, fmt.Sprintf("flip(%d,%d)", lo, hi))
+		default:
+			rb.RunOptimize()
+			ops = append(ops, "runoptimize")
+		}
+	}
+	return rb, cur, ops
+}
+
+// parsePortable64 decodes the 64-bit portable format with the 32-bit spec
+// parser for each bucket.
+func parsePortable64(b []byte) (set, error) {
+	if len(b) < 8 {
+		return nil, fmt.Errorf("portable64: no bucket count")
+	}
+	count := binary.LittleEndian.Uint64(b)
+	pos := 8
+	var out []iv
+	var prevKey uint64
+	for i := uint64(0); i < count; i++ {
+		if len(b) < pos+4 {
+			return nil, fmt.Errorf("portable64: truncated key of bucket %d", i)
+		}
+		key := uint64(binary.LittleEndian.Uint32(b[pos:]))
+		pos += 4
+		if i > 0 && key <= prevKey {
+			return nil, fmt.Errorf("portable64: bucket keys not increasing")
+		}
+		prevKey = key
+		s, _, used, err := parseSpec(b[pos:])
+		if err != nil {
+			return nil, fmt.Errorf("portable64: bucket %d: %v", i, err)
+		}
+		if s.card() == 0 {
+			return nil, fmt.Errorf("portable64: empty bucket %d", i)
+		}
+		pos += used
+		for _, v := range s {
+			out = append(out, iv{key<<32 + v.lo, key<<32 + v.hi})
+		}
+	}
+	if pos != len(b) {
+		return nil, fmt.Errorf("portable64: %d trailing bytes", len(b)-pos)
+	}
+	return norm(out), nil
+}
+
+func TestHegelRoaring64MirrorsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys64(ht)
+		a, sa, opsA := genBitmap64(ht, keys)
+		b, sb, opsB := genBitmap64(ht, keys)
+		note(ht, "a: %v -> %s\nb: %v -> %s", opsA, sa, opsB, sb)
+		check64(ht, "a", a, sa)
+		check64(ht, "b", b, sb)
+		check64(ht, "Or", roaring64.Or(a, b), sa.union(sb))
+		check64(ht, "And", roaring64.And(a, b), sa.inter(sb))
+		check64(ht, "Xor", roaring64.Xor(a, b), sa.xor(sb, universe64))
+		check64(ht, "AndNot", roaring64.AndNot(a, b), sa.minus(sb, universe64))
+		check64(ht, "a after functional ops", a, sa)
+		check64(ht, "b after functional ops", b, sb)
+		for _, o := range []struct {
+			name string
+			fn   func(x, y *roaring64.Bitmap)
+			want set
+		}{
+			{"Or", (*roaring64.Bitmap).Or, sa.union(sb)},
+			{"And", (*roaring64.Bitmap).And, sa.inter(sb)},
+			{"Xor", (*roaring64.Bitmap).Xor, sa.xor(sb, universe64)},
+			{"AndNot", (*roaring64.Bitmap).AndNot, sa.minus(sb, universe64)},
+		} {
+			x := a.Clone()
+			o.fn(x, b)
+			check64(ht, "in-place "+o.name, x, o.want)
+			check64(ht, "a after in-place "+o.name+" on a clone", a, sa)
+		}
+		if got := a.OrCardinality(b); got != sa.union(sb).card() {
+			fail(ht, "OrCardinality %d, want %d", got, sa.union(sb).card())
+		}
+		if got := a.AndCardinality(b); got != sa.inter(sb).card() {
+			fail(ht, "AndCardinality %d, want %d", got, sa.inter(sb).card())
+		}
+		if a.Intersects(b) != (sa.inter(sb).card() > 0) || a.Equals(b) != sa.equal(sb) {
+			fail(ht, "Intersects %v / Equals %v on %s, %s", a.Intersects(b), a.Equals(b), sa, sb)
+		}
+		// Rank, Select, Contains.
+		for i := 0; i < 6; i++ {
+			x := genPoint64(ht, keys)
+			if sa.card() > 0 && chance(ht, 30) {
+				v, _ := sa.selectAt(uint64(n(ht, 0, int(min(sa.card()-1, 1<<30)))))
+				x = v
+			}
+			if a.Contains(x) != sa.contains(x) {
+				fail(ht, "Contains(%d) = %v on %s", x, a.Contains(x), sa)
+			}
+			if got := a.Rank(x); got != sa.rank(x) {
+				fail(ht, "Rank(%d) = %d, want %d on %s", x, got, sa.rank(x), sa)
+			}
+			k := uint64(n(ht, 0, int(sa.card())+1))
+			got, err := a.Select(k)
+			wantV, ok := sa.selectAt(k)
+			if ok != (err == nil) || (ok && got != wantV) {
+				fail(ht, "Select(%d) = %d, %v; want %d ok=%v on %s", k, got, err, wantV, ok, sa)
+			}
+		}
+		// Iterators.
+		{
+			var got []uint64
+			it := a.ReverseIterator()
+			for it.HasNext() {
+				got = append(got, it.Next())
+			}
+			if want := sa.lastN(int(sa.card())); !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+				fail(ht, "ReverseIterator gives %s, want %s", short64(got), short64(want))
+			}
+			mi := a.ManyIterator()
+			got = nil
+			for {
+				buf := make([]uint64, pick(ht, 1, 3, 64, 1000))
+				m := mi.NextMany(buf)
+				if m == 0 {
+					break
+				}
+				got = append(got, buf[:m]...)
+			}
+			if want := sa.values64(); !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+				fail(ht, "ManyIterator gives %s, want %s", short64(got), short64(want))
+			}
+			pit := a.Iterator()
+			m := genPoint64(ht, keys)
+			pit.AdvanceIfNeeded(m)
+			if next := sa.nextValue(m); pit.HasNext() != (next >= 0) || (next >= 0 && pit.PeekNext() != uint64(next)) {
+				fail(ht, "AdvanceIfNeeded(%d): HasNext %v, want next %d on %s", m, pit.HasNext(), next, sa)
+			}
+		}
+		// Serialization: portable format, spec-parsed per bucket, round trips.
+		data, err := a.ToBytes()
+		if err != nil {
+			fail(ht, "ToBytes: %v", err)
+		}
+		pdata, err := a.ToPortableBytes()
+		if err != nil || !bytes.Equal(pdata, data) {
+			fail(ht, "ToPortableBytes differs from ToBytes (err %v)", err)
+		}
+		if got := a.GetSerializedSizeInBytes(); got != uint64(len(data)) || a.GetPortableSerializedSizeInBytes() != got {
+			fail(ht, "GetSerializedSizeInBytes %d, ToBytes %d bytes", got, len(data))
+		}
+		parsed, perr := parsePortable64(data)
+		if perr != nil || !parsed.equal(sa) {
+			fail(ht, "64-bit bytes: %v, encode %s, want %s", perr, parsed, sa)
+		}
+		for _, r := range []struct {
+			name string
+			read func(*roaring64.Bitmap) error
+		}{
+			{"ReadFrom", func(x *roaring64.Bitmap) error { _, err := x.ReadFrom(bytes.NewReader(data)); return err }},
+			{"ReadFrom(OneByteReader)", func(x *roaring64.Bitmap) error {
+				_, err := x.ReadFrom(iotest.OneByteReader(bytes.NewReader(data)))
+				return err
+			}},
+			{"ReadPortableFrom", func(x *roaring64.Bitmap) error { _, err := x.ReadPortableFrom(bytes.NewReader(data)); return err }},
+			{"FromUnsafeBytes", func(x *roaring64.Bitmap) error { _, err := x.FromUnsafeBytes(append([]byte{}, data...)); return err }},
+			{"UnmarshalBinary", func(x *roaring64.Bitmap) error { return x.UnmarshalBinary(data) }},
+			{"FromBase64", func(x *roaring64.Bitmap) error {
+				s, err := a.ToBase64()
+				if err != nil {
+					return err
+				}
+				_, err = x.FromBase64(s)
+				return err
+			}},
+		} {
+			x := roaring64.New()
+			if chance(ht, 30) {
+				x.Add(genPoint64(ht, keys))
+			}
+			if err := r.read(x); err != nil {
+				fail(ht, "%s: %v on %s", r.name, err, sa)
+			}
+			check64(ht, r.name+" result", x, sa)
+			if !x.Equals(a) {
+				fail(ht, "%s result not Equals to the source", r.name)
+			}
+		}
+		// Roaring32AsRoaring64 embeds a 32-bit bitmap as bucket 0.
+		r32 := roaring.New()
+		for _, v := range sa.inter(set{{0, universe32}}) {
+			r32.AddRange(v.lo, v.hi)
+		}
+		if !(Known.emptyAs64Invalid && r32.IsEmpty()) {
+			check64(ht, "Roaring32AsRoaring64", roaring64.Roaring32AsRoaring64(r32), sa.inter(set{{0, universe32}}))
+		}
+		// A hand-written portable stream with our own container kinds.
+		if sa.card() > 0 {
+			var pb []byte
+			var buckets []uint64
+			for _, v := range sa {
+				for k := v.lo >> 32; k <= (v.hi-1)>>32; k++ {
+					if len(buckets) == 0 || buckets[len(buckets)-1] != k {
+						buckets = append(buckets, k)
+					}
+				}
+			}
+			pb = binary.LittleEndian.AppendUint64(pb, uint64(len(buckets)))
+			for _, k := range buckets {
+				part := sa.inter(set{{k << 32, (k + 1) << 32}})
+				var low []iv
+				for _, v := range part {
+					low = append(low, iv{v.lo - k<<32, v.hi - k<<32})
+				}
+				ls := norm(low)
+				kinds := genKinds(ht, ls)
+				pb = binary.LittleEndian.AppendUint32(pb, uint32(k))
+				pb = append(pb, writeSpec(ls, kinds)...)
+			}
+			for _, r := range []struct {
+				name string
+				read func(*roaring64.Bitmap) error
+			}{
+				{"ReadFrom", func(x *roaring64.Bitmap) error { _, err := x.ReadFrom(bytes.NewReader(pb)); return err }},
+				{"ReadPortableFrom", func(x *roaring64.Bitmap) error { _, err := x.ReadPortableFrom(bytes.NewReader(pb)); return err }},
+				{"UnmarshalBinary", func(x *roaring64.Bitmap) error { return x.UnmarshalBinary(pb) }},
+			} {
+				x := roaring64.New()
+				if err := r.read(x); err != nil {
+					fail(ht, "%s rejects spec-conformant 64-bit bytes: %v on %s", r.name, err, sa)
+				}
+				check64(ht, r.name+" of spec 64-bit bytes", x, sa)
+			}
+		}
+	})
+}
