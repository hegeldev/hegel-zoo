+// ---------------------------------------------------------------------------
+// Property 6: spec-conformant bytes are accepted whatever the container kinds.
+
+func TestHegelSpecConformantBytesAreAccepted(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		_, want, ops := genBitmap(ht, keys)
+		if want.card() == 0 {
+			k := uint64(pick(ht, keys...)) << 16
+			want = set{{k, k + 1}}
+		}
+		kinds := genKinds(ht, want)
+		data := writeSpec(want, kinds)
+		note(ht, "ops %v -> %s; kinds %v; %d bytes", ops, want, kinds, len(data))
+		parsed, _, used, err := parseSpec(data)
+		if err != nil || used != len(data) || !parsed.equal(want) {
+			fail(ht, "writer/parser disagree: %v, used %d of %d, %s", err, used, len(data), parsed)
+		}
+		for _, r := range []struct {
+			name string
+			read func(*roaring.Bitmap) (int64, error)
+		}{
+			{"ReadFrom", func(x *roaring.Bitmap) (int64, error) { return x.ReadFrom(bytes.NewReader(data)) }},
+			{"FromBuffer", func(x *roaring.Bitmap) (int64, error) { return x.FromBuffer(append([]byte{}, data...)) }},
+			{"FromUnsafeBytes", func(x *roaring.Bitmap) (int64, error) { return x.FromUnsafeBytes(append([]byte{}, data...)) }},
+			{"UnmarshalBinary", func(x *roaring.Bitmap) (int64, error) { return int64(len(data)), x.UnmarshalBinary(data) }},
+		} {
+			x := roaring.New()
+			p, err := r.read(x)
+			if err != nil {
+				fail(ht, "%s rejects spec-conformant bytes: %v (kinds %v) for %s", r.name, err, kinds, want)
+			}
+			if p != int64(len(data)) {
+				fail(ht, "%s consumed %d of %d bytes", r.name, p, len(data))
+			}
+			check(ht, r.name+" of spec bytes", x, want)
+			st := x.Stats()
+			var runs uint64
+			for _, k := range kinds {
+				if k == 'r' {
+					runs++
+				}
+			}
+			if st.RunContainers != runs {
+				fail(ht, "%s of spec bytes has %d run containers, written %d", r.name, st.RunContainers, runs)
+			}
+			// The set re-serializes to bytes that follow the spec and
+			// preserve the container kinds.
+			out, err := x.ToBytes()
+			if err != nil {
+				fail(ht, "ToBytes after %s: %v", r.name, err)
+			}
+			again, conts, _, perr := parseSpec(out)
+			if perr != nil || !again.equal(want) {
+				fail(ht, "re-serialization after %s: %v, %s", r.name, perr, again)
+			}
+			for _, c := range conts {
+				if (c.kind == 'r') != (kinds[c.key] == 'r') {
+					fail(ht, "re-serialization after %s changed the kind of container %d to %c", r.name, c.key, c.kind)
+				}
+			}
+			if len(kinds) == 0 || len(want.keysOf()) >= 4 || !anyRun(kinds) {
+				if !bytes.Equal(out, data) {
+					fail(ht, "re-serialization after %s differs from the spec bytes (%d vs %d bytes)", r.name, len(out), len(data))
+				}
+			}
+		}
+	})
+}
+
+// runAcceptedByValidate is the library's rule for a run container to pass
+// Validate: its serialized size must be below both alternatives.
+func runAcceptedByValidate(p set) bool {
+	sizeRun := 2 + 4*len(p)
+	sizeArray := 2 * int(p.card())
+	return sizeRun < min(8192, sizeArray)
+}
+
+// genKinds chooses run containers for a random subset of keys (only where
+// Validate accepts them while roaring/6 is open).
+func genKinds(tc hegel.TestCase, s set) map[uint16]byte {
+	kinds := map[uint16]byte{}
+	for _, k := range s.keysOf() {
+		if chance(tc, 50) && (!Known.validateRejectsRuns || runAcceptedByValidate(s.inKey(k))) {
+			kinds[k] = 'r'
+		}
+	}
+	return kinds
+}
+
+// hasLooseRun reports whether a spec stream holds a run container Validate
+// would reject (roaring/6).
+func hasLooseRun(data []byte) bool {
+	_, conts, _, err := parseSpec(data)
+	if err != nil {
+		return false
+	}
+	for _, c := range conts {
+		if c.kind == 'r' && !runAcceptedByValidate(c.vals) {
+			return true
+		}
+	}
+	return false
+}
+
+func anyRun(kinds map[uint16]byte) bool {
+	for _, k := range kinds {
+		if k == 'r' {
+			return true
+		}
+	}
+	return false
+}
