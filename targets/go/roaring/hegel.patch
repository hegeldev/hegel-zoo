+// ---------------------------------------------------------------------------
+// Property 5: serialization follows the format specification and round-trips.
+
+func TestHegelSerializationFollowsTheFormatSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		rb, want, ops := genBitmap(ht, keys)
+		note(ht, "ops %v -> %s", ops, want)
+		data, err := rb.ToBytes()
+		if err != nil {
+			fail(ht, "ToBytes: %v", err)
+		}
+		var buf bytes.Buffer
+		nw, err := rb.WriteTo(&buf)
+		if err != nil || nw != int64(len(data)) || !bytes.Equal(buf.Bytes(), data) {
+			fail(ht, "WriteTo wrote %d bytes (err %v), ToBytes %d; equal %v", nw, err, len(data), bytes.Equal(buf.Bytes(), data))
+		}
+		mb, err := rb.MarshalBinary()
+		if err != nil || !bytes.Equal(mb, data) {
+			fail(ht, "MarshalBinary differs from ToBytes (err %v)", err)
+		}
+		if got := rb.GetSerializedSizeInBytes(); got != uint64(len(data)) {
+			fail(ht, "GetSerializedSizeInBytes %d, ToBytes has %d bytes on %s", got, len(data), want)
+		}
+		if want.card() > 0 {
+			if bound := roaring.BoundSerializedSizeInBytes(want.card(), want.max()+1); bound < uint64(len(data)) {
+				fail(ht, "BoundSerializedSizeInBytes(%d,%d) = %d < actual %d on %s", want.card(), want.max()+1, bound, len(data), want)
+			}
+		}
+		// The bytes follow the spec and encode the set.
+		parsed, conts, used, perr := parseSpec(data)
+		if perr != nil {
+			fail(ht, "library bytes do not follow the spec: %v (%d bytes) on %s", perr, len(data), want)
+		}
+		if used != len(data) {
+			fail(ht, "spec parse used %d of %d bytes", used, len(data))
+		}
+		if !parsed.equal(want) {
+			fail(ht, "library bytes encode %s, want %s", parsed, want)
+		}
+		st := rb.Stats()
+		var na, nb, nr uint64
+		for _, c := range conts {
+			switch c.kind {
+			case 'a':
+				na++
+			case 'b':
+				nb++
+			case 'r':
+				nr++
+			}
+		}
+		if na != st.ArrayContainers || nb != st.BitmapContainers || nr != st.RunContainers {
+			fail(ht, "serialized container kinds a=%d b=%d r=%d, Stats %+v", na, nb, nr, st)
+		}
+		// Every reader gives the set back, validated.
+		readers := []struct {
+			name string
+			read func(*roaring.Bitmap) error
+		}{
+			{"ReadFrom", func(x *roaring.Bitmap) error {
+				p, err := x.ReadFrom(bytes.NewReader(data))
+				if err == nil && p != int64(len(data)) {
+					return fmt.Errorf("read %d of %d bytes", p, len(data))
+				}
+				return err
+			}},
+			{"ReadFrom(OneByteReader)", func(x *roaring.Bitmap) error {
+				_, err := x.ReadFrom(iotest.OneByteReader(bytes.NewReader(data)))
+				return err
+			}},
+			{"ReadFrom(HalfReader)", func(x *roaring.Bitmap) error {
+				_, err := x.ReadFrom(iotest.HalfReader(bytes.NewReader(data)))
+				return err
+			}},
+			{"ReadFrom(cookieHeader)", func(x *roaring.Bitmap) error {
+				_, err := x.ReadFrom(bytes.NewReader(data[4:]), data[:4]...)
+				return err
+			}},
+			{"MustReadFrom", func(x *roaring.Bitmap) error {
+				_, err := x.MustReadFrom(bytes.NewReader(data))
+				return err
+			}},
+			{"FromBuffer", func(x *roaring.Bitmap) error {
+				p, err := x.FromBuffer(append([]byte{}, data...))
+				if err == nil && p != int64(len(data)) {
+					return fmt.Errorf("consumed %d of %d bytes", p, len(data))
+				}
+				return err
+			}},
+			{"FromUnsafeBytes", func(x *roaring.Bitmap) error {
+				p, err := x.FromUnsafeBytes(append([]byte{}, data...))
+				if err == nil && p != int64(len(data)) {
+					return fmt.Errorf("consumed %d of %d bytes", p, len(data))
+				}
+				return err
+			}},
+			{"UnmarshalBinary", func(x *roaring.Bitmap) error { return x.UnmarshalBinary(data) }},
+			{"FromBase64", func(x *roaring.Bitmap) error {
+				s, err := rb.ToBase64()
+				if err != nil {
+					return err
+				}
+				if s != base64.StdEncoding.EncodeToString(data) {
+					return fmt.Errorf("ToBase64 is not the base64 of ToBytes")
+				}
+				_, err = x.FromBase64(s)
+				return err
+			}},
+		}
+		for _, r := range readers {
+			x := roaring.New()
+			if chance(ht, 30) {
+				x.Add(uint32(genPoint(ht, keys))) // a reader must replace, not merge
+			}
+			if err := r.read(x); err != nil {
+				fail(ht, "%s: %v on %s", r.name, err, want)
+			}
+			check(ht, r.name+" result", x, want)
+			if !x.Equals(rb) {
+				fail(ht, "%s result not Equals to the source", r.name)
+			}
+			if x.Checksum() != rb.Checksum() {
+				fail(ht, "%s result has checksum %d, source %d", r.name, x.Checksum(), rb.Checksum())
+			}
+			// Mutating a deserialized bitmap (copy-on-write for the buffer
+			// readers) gives the model's result.
+			p := genPoint(ht, keys)
+			x.Flip(p, p+1)
+			check(ht, r.name+" result after Flip", x, want.flip(p, p+1, universe32))
+			if r.name == "FromBuffer" || r.name == "FromUnsafeBytes" {
+				x.CloneCopyOnWriteContainers()
+				check(ht, r.name+" result after CloneCopyOnWriteContainers", x, want.flip(p, p+1, universe32))
+			}
+		}
+		// Trailing data is left alone by the stream readers.
+		{
+			extra := []byte("tail")
+			x := roaring.New()
+			rd := bytes.NewReader(append(append([]byte{}, data...), extra...))
+			p, err := x.ReadFrom(rd)
+			if err != nil || p != int64(len(data)) || rd.Len() != len(extra) {
+				fail(ht, "ReadFrom with trailing data: p=%d err=%v remaining=%d", p, err, rd.Len())
+			}
+			check(ht, "ReadFrom with trailing data", x, want)
+			y := roaring.New()
+			p, err = y.FromBuffer(append(append([]byte{}, data...), extra...))
+			if err != nil || p != int64(len(data)) {
+				fail(ht, "FromBuffer with trailing data: p=%d err=%v", p, err)
+			}
+			check(ht, "FromBuffer with trailing data", y, want)
+		}
+		// Every prefix fails to read (or fails validation) and never panics.
+		if len(data) > 0 {
+			cut := n(ht, 0, len(data)-1)
+			x := roaring.New()
+			_, err := x.ReadFrom(bytes.NewReader(data[:cut]))
+			if err == nil && x.Validate() == nil && !chance(ht, 0) {
+				got, gerr := setOf(x)
+				if gerr == nil && got.equal(want) && want.card() > 0 {
+					fail(ht, "ReadFrom of a %d-byte prefix of %d bytes gave the whole set back", cut, len(data))
+				}
+			}
+			y := roaring.New()
+			_, yerr := y.FromBuffer(append([]byte{}, data[:cut]...))
+			if yerr == nil || !Known.validateAfterBadRead { // roaring/7
+				_ = y.Validate()
+			}
+		}
+		// Checksum is a function of the set, not of the representation.
+		alt := roaring.New()
+		for _, v := range want {
+			alt.AddRange(v.lo, v.hi)
+		}
+		if chance(ht, 50) {
+			alt.RunOptimize()
+		}
+		if !alt.Equals(rb) {
+			fail(ht, "same set built differently is not Equals on %s", want)
+		}
+		if !Known.checksumRepresentation && alt.Checksum() != rb.Checksum() {
+			fail(ht, "same set built differently: checksums %d vs %d on %s", alt.Checksum(), rb.Checksum(), want)
+		}
+	})
+}
