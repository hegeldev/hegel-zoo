--- /dev/null
+++ b/hegel_zoo_algebra_test.go
@@ -0,0 +1,496 @@
+package roaring_test
+
+// Property 2: the set algebra matches the model. Two bitmaps a and b of one record each on
+// the same keys (both set to copy on write 30 percent of the time): the eleven binary
+// operations (Or, And, Xor, AndNot, FastOr, FastAnd, HeapOr, HeapXor, ParOr, ParAnd,
+// ParHeapOr) give the model's set and leave the operands alone, and the result is
+// independent of the operands (flipping a value in it leaves them, flipping a value in a
+// leaves it); the seven single-input aggregates (FastOr, FastAnd, ParHeapOr, ParOr, ParAnd,
+// HeapOr, HeapXor) are copies of a; OrCardinality, AndCardinality, Intersects and Equals; the
+// three-way aggregates with a third bitmap c, FastOr of nothing, FastAnd of one, AndAny; and
+// the in-place Or, And, AndNot and Xor on a clone of a (the argument and the clone's source
+// left alone) and on itself. The operands are rebuilt from their records before each
+// operation, so that every operation sees the record's state (container kinds and
+// copy-on-write flags included) and a mutation one leaks is seen by that operation's checks
+// alone. The shapes reached: roaring/4 (ParHeapOr's result shares the containers of the
+// keys one input holds: flipping the result changes that input, flipping the input changes
+// the result unless the input's container is flagged for copy on write; the replica
+// parHeapOrReplica), roaring/5 (HeapOr and HeapXor of a alone return a), roaring/12 (the
+// in-place Xor writes the argument's bitmap container in place when the receiver's
+// container at that key is an array or run and the symmetric difference exceeds 4096
+// values; xorMutation) and roaring/6 on Validate of the records' loose runs and their
+// copies; under HEGEL_NO_KNOWN=1 those checks are dropped.
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	binopNames   = []string{"Or", "And", "Xor", "AndNot", "FastOr", "FastAnd", "HeapOr", "HeapXor", "ParOr", "ParAnd", "ParHeapOr"}
+	singleNames  = []string{"FastOr", "FastAnd", "ParHeapOr", "ParOr", "ParAnd", "HeapOr", "HeapXor"}
+	inplaceNames = []string{"Or", "And", "AndNot", "Xor"}
+)
+
+func binopWant(name string, sa, sb set) set {
+	switch name {
+	case "And", "FastAnd", "ParAnd":
+		return sa.inter(sb)
+	case "Xor", "HeapXor":
+		return sa.xor(sb, universe32)
+	case "AndNot":
+		return sa.minus(sb, universe32)
+	}
+	return sa.union(sb)
+}
+
+type algebraCase struct {
+	a, b, c bitmapRec // on the same keys
+	cow     bool
+	pars    []int      // parallelism of ParOr, ParAnd, ParHeapOr, then ParHeapOr3, ParAnd3, ParOr3
+	xs, ys  []pointRec // per binary operation: flipped in the result, then in a
+	sx      []pointRec // per single-input aggregate: flipped in the result
+
+	pa, pb, pc plan
+
+	// only restricts the case to some sections (the narrow properties: a binary operation by
+	// name, "singles", "misc" (the cardinalities, the three-way aggregates, AndAny) or
+	// "in-place"); empty for all of them (the wide property).
+	only []string
+
+	// Read from the built bitmaps by the property: the container kinds of a, b and of every
+	// result (by check prefix), the copy-on-write flags of a (dry, from its record), and what
+	// Validate can say on a, b and every result.
+	kindsA, kindsB, kindsC map[uint16]byte
+	flagsA                 map[uint16]bool
+	kinds                  map[string]map[uint16]byte
+	va, vb                 validity
+	v                      map[string]validity
+}
+
+func (c algebraCase) GoString() string {
+	keys := c.pa.keys
+	s := fmt.Sprintf("a: %s\nb: %s\nc: %s\ncow %v; parallelism %v; result flips %v; a flips %v; single flips %v", c.pa, c.pb, c.pc, c.cow, c.pars, pointValues(c.xs, keys), pointValues(c.ys, keys), pointValues(c.sx, keys))
+	if len(c.only) > 0 {
+		s += fmt.Sprintf("; only %v", c.only)
+	}
+	return s
+}
+
+// does reports whether the case computes a section.
+func (c algebraCase) does(section string) bool {
+	if len(c.only) == 0 {
+		return true
+	}
+	for _, s := range c.only {
+		if s == section {
+			return true
+		}
+	}
+	return false
+}
+
+// cow 30 nominal: dieCoin(30) realises 30; the parallelism 0 to 3 evenly (hzDie(4)).
+var algebraCases = hegel.FlatMap(keyCounts, func(n int) hegel.Generator[algebraCase] {
+	points := pointRecs(n)
+	bodies := bitmapBodyRecs(n)
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) algebraCase {
+		keys := hegel.Draw(tc, hzCounted(keyRecs, n, n))
+		with := func(b bitmapRec) bitmapRec { b.keys = keys; return b }
+		return algebraCase{
+			a:    with(hegel.Draw(tc, bodies)),
+			b:    with(hegel.Draw(tc, bodies)),
+			c:    with(hegel.Draw(tc, bodies)),
+			cow:  hegel.Draw(tc, dieCoin(30)),
+			pars: hegel.Draw(tc, hzCounted(hzDie(4), 6, 6)),
+			xs:   hegel.Draw(tc, hzCounted(points, len(binopNames), len(binopNames))),
+			ys:   hegel.Draw(tc, hzCounted(points, len(binopNames), len(binopNames))),
+			sx:   hegel.Draw(tc, hzCounted(points, len(singleNames), len(singleNames))),
+		}
+	}), func(c algebraCase) algebraCase {
+		c.pa, c.pb, c.pc = c.a.plan(), c.b.plan(), c.c.plan()
+		return c
+	})
+})
+
+// bitmapState is a bitmap the replicas describe: its set, container kinds, the errors of
+// containers the replicas know (extra), and the key of a container emptied but kept (-1 for
+// none: IsEmpty is then false, Stats counts it, Minimum or Maximum panic when it is first or
+// last).
+type bitmapState struct {
+	s       set
+	kinds   map[uint16]byte
+	extra   map[uint16]string
+	emptied int
+}
+
+func stateOf(s set, kinds map[uint16]byte) bitmapState {
+	return bitmapState{s: s, kinds: kinds, emptied: -1}
+}
+
+func (st bitmapState) checks(k known) checks {
+	c := bitmapChecks(st.s, validityOf(st.kinds, st.s, st.extra).text(k))
+	if st.emptied >= 0 {
+		n := st.s.keyCount()
+		c.set("stats", statsText(st.s.card(), n+1, n+1, st.s.card()))
+		c.set("empty", false)
+		if first, ok := st.s.firstKeyFrom(0); !ok || uint16(st.emptied) < first || uint16(st.emptied) > uint16(st.s.max()>>16) {
+			c.set("minmax", "panic")
+		}
+	}
+	return c
+}
+
+// flipped is the state after an in-place flip of x.
+func (st bitmapState) flipped(x uint64) bitmapState {
+	key := uint16(x >> 16)
+	after := st.s.flip(x, x+1, universe32)
+	kinds := st.kinds
+	if kind := kindAfterFlip(st.kinds[key], after.inKey(key)); kind != st.kinds[key] {
+		kinds = withKind(st.kinds, key, kind)
+	}
+	return bitmapState{s: after, kinds: kinds, extra: st.extra, emptied: st.emptied}
+}
+
+// parHeapOrReplica is roaring/4 (parallel.go: the appender stores the one input's container
+// of a key the other input lacks, unflagged): r = ParHeapOr(a, b), then r.Flip(x), then
+// a.Flip(y). Flipping x in r at a key one input holds alone writes that input's container:
+// an array or bitmap container is changed in place (the input's set flips too), and when
+// the kind converts (an array past 4096 values: the input keeps an overfull array and r a
+// new bitmap; a bitmap down to 4096 or fewer: the input keeps the shrunk bitmap and r a new
+// array; an array emptied: the input keeps an empty array, r drops the key) the two part
+// company; a run container is not written (runContainer16.inot returns a new one), only r
+// changes. Flipping y in a at a key still shared changes r the same way, unless a's
+// container is flagged for copy on write (a clones first). Returns r after x, a and b after
+// x, and r after y.
+func parHeapOrReplica(sa, sb set, ka, kb, kr map[uint16]byte, fa map[uint16]bool, x, y uint64) (r, a, b, r2 bitmapState) {
+	a, b = stateOf(sa, ka), stateOf(sb, kb)
+	r = stateOf(sa.union(sb), kr).flipped(x)
+	shared := map[uint16]bool{}
+	for _, key := range sa.keysOf() {
+		if !sb.hasKey(key) {
+			shared[key] = true
+		}
+	}
+	key := uint16(x >> 16)
+	var owner *bitmapState
+	switch {
+	case sa.hasKey(key) && !sb.hasKey(key):
+		owner = &a
+	case sb.hasKey(key) && !sa.hasKey(key):
+		owner = &b
+	}
+	if owner != nil {
+		kind := owner.kinds[key]
+		if kind != 'a' && kind != 'b' {
+			delete(shared, key)
+		} else {
+			owner.s = owner.s.flip(x, x+1, universe32)
+			part := owner.s.inKey(key)
+			switch {
+			case kind == 'a' && part.card() > 4096:
+				delete(shared, key)
+			case kind == 'a' && part.card() == 0:
+				owner.extra = map[uint16]string{key: "empty array"}
+				owner.emptied = int(key)
+				delete(shared, key)
+			case kind == 'b' && part.card() < 4096:
+				owner.extra = map[uint16]string{key: "bitmap container size was less than: 4096"}
+				delete(shared, key)
+			case kind == 'b' && part.card() == 4096:
+				delete(shared, key)
+			}
+		}
+	}
+	r2 = r
+	key = uint16(y >> 16)
+	if kind := a.kinds[key]; shared[key] && !fa[key] && (kind == 'a' || kind == 'b') {
+		after := a.s.flip(y, y+1, universe32)
+		part := after.inKey(key)
+		r2 = bitmapState{s: r.s.flip(y, y+1, universe32), kinds: r.kinds, extra: r.extra, emptied: r.emptied}
+		switch {
+		case kind == 'a' && part.card() == 0:
+			r2.extra = map[uint16]string{key: "empty array"}
+			r2.emptied = int(key)
+		case kind == 'b' && part.card() < 4096:
+			r2.extra = map[uint16]string{key: "bitmap container size was less than: 4096"}
+		}
+	}
+	return r, a, b, r2
+}
+
+// xorMutation is roaring/12 (roaring.go Xor in place with bitmapContainer.ixorBitmap): at a
+// key both hold where the argument's container is a bitmap and the receiver's an array or
+// run, the symmetric difference of more than 4096 values is written into the argument's
+// bitmap; the argument after the receiver x = a.Clone() did x.Xor(b).
+func xorMutation(sa, sb set, ka, kb map[uint16]byte) bitmapState {
+	out := sb
+	for _, key := range sb.keysOf() {
+		if kb[key] != 'b' || ka[key] == 'b' || !sa.hasKey(key) {
+			continue
+		}
+		base := uint64(key) << 16
+		part := sa.inKey(key).xor(sb.inKey(key), 65536)
+		if part.card() <= 4096 {
+			continue
+		}
+		var shifted []iv
+		for _, v := range part {
+			shifted = append(shifted, iv{v.lo + base, v.hi + base})
+		}
+		out = out.removeRange(base, base+65536, universe32).union(norm(shifted))
+	}
+	return stateOf(out, kb)
+}
+
+func algebraExpected(c algebraCase, k known) checks {
+	sa, sb, sc := setOfOps(c.pa.ops), setOfOps(c.pb.ops), setOfOps(c.pc.ops)
+	keys := c.pa.keys
+	out := checks{}
+	out.add("a", planChecks(c.pa))
+	out.add("b", planChecks(c.pb))
+	out.add("c", planChecks(c.pc))
+	aChecks, bChecks := bitmapChecks(sa, c.va.text(k)), bitmapChecks(sb, c.vb.text(k))
+	for i, name := range binopNames {
+		if !c.does(name) {
+			continue
+		}
+		want := binopWant(name, sa, sb)
+		out.add(name, bitmapChecks(want, c.v[name].text(k)))
+		out.add("a after "+name, aChecks)
+		out.add("b after "+name, bChecks)
+		x, y := c.xs[i].value(keys), c.ys[i].value(keys)
+		var r, a, b, r2 bitmapState
+		if name == "ParHeapOr" && k[kParHeapOrShares] {
+			r, a, b, r2 = parHeapOrReplica(sa, sb, c.kindsA, c.kindsB, c.kinds[name], c.flagsA, x, y)
+		} else {
+			r = stateOf(want, c.kinds[name]).flipped(x)
+			a, b, r2 = stateOf(sa, c.kindsA), stateOf(sb, c.kindsB), r
+		}
+		out.add(name+" after flip", r.checks(k))
+		out.add("a after flipping "+name, a.checks(k))
+		out.add("b after flipping "+name, b.checks(k))
+		out.add(name+" after flipping a", r2.checks(k))
+	}
+	for i, name := range singleNames {
+		if !c.does("singles") {
+			break
+		}
+		out.add(name+"(a)", aChecks)
+		isA := k[kHeapOneReturnsInput] && (name == "HeapOr" || name == "HeapXor")
+		out.set(name+"(a) is a", isA)
+		a := stateOf(sa, c.kindsA)
+		if isA {
+			a = a.flipped(c.sx[i].value(keys))
+		}
+		out.add("a after flipping "+name+"(a)", a.checks(k))
+	}
+	if c.does("misc") {
+		out.set("OrCardinality", sa.union(sb).card())
+		out.set("AndCardinality", sa.inter(sb).card())
+		out.set("Intersects", sa.inter(sb).card() > 0)
+		out.set("Equals", sa.equal(sb))
+		three := func(name string, want set) { out.add(name, bitmapChecks(want, c.v[name].text(k))) }
+		three("FastOr3", sa.union(sb).union(sc))
+		three("FastAnd3", sa.inter(sb).inter(sc))
+		three("HeapOr3", sa.union(sb).union(sc))
+		three("HeapXor3", sa.xor(sb, universe32).xor(sc, universe32))
+		three("ParHeapOr3", sa.union(sb).union(sc))
+		three("ParAnd3", sa.inter(sb).inter(sc))
+		three("ParOr3", sa.union(sb).union(sc))
+		out.add("FastOr0", bitmapChecks(nil, "ok"))
+		out.add("FastAnd1", aChecks)
+		three("AndAny", sa.inter(sb.union(sc)))
+		out.add("b after AndAny", bChecks)
+	}
+	for _, name := range inplaceNames {
+		if !c.does("in-place") {
+			break
+		}
+		want := binopWant(name, sa, sb)
+		out.add("in-place "+name, bitmapChecks(want, c.v["in-place "+name].text(k)))
+		arg := stateOf(sb, c.kindsB)
+		if name == "Xor" && k[kInPlaceXorMutatesArg] {
+			arg = xorMutation(sa, sb, c.kindsA, c.kindsB)
+		}
+		out.add("b after in-place "+name, arg.checks(k))
+		out.add("a after in-place "+name, aChecks)
+		var self set
+		if name == "Or" || name == "And" {
+			self = sa
+		}
+		out.add("in-place "+name+" with itself", bitmapChecks(self, c.v["self "+name].text(k)))
+	}
+	return out
+}
+
+func algebraActual(c *algebraCase) checks {
+	sa, sb, sc := setOfOps(c.pa.ops), setOfOps(c.pb.ops), setOfOps(c.pc.ops)
+	keys := c.pa.keys
+	fresh := func(p plan) *roaring.Bitmap {
+		rb, _ := build(p)
+		if c.cow {
+			rb.SetCopyOnWrite(true)
+		}
+		return rb
+	}
+	got := checks{}
+	_, ca := build(c.pa)
+	_, cb := build(c.pb)
+	_, cc := build(c.pc)
+	got.add("a", ca)
+	got.add("b", cb)
+	got.add("c", cc)
+	a, b, cbm := fresh(c.pa), fresh(c.pb), fresh(c.pc)
+	c.kindsA, c.kindsB, c.kindsC = kindsOf(a), kindsOf(b), kindsOf(cbm)
+	_, c.flagsA = dryReplay(c.pa)
+	c.va, c.vb = validityOf(c.kindsA, sa, nil), validityOf(c.kindsB, sb, nil)
+	c.kinds = map[string]map[uint16]byte{}
+	c.v = map[string]validity{}
+	read := func(name string, r *roaring.Bitmap, want set) {
+		c.kinds[name] = kindsOf(r)
+		c.v[name] = validityOf(c.kinds[name], want, nil)
+		got.add(name, readBitmap(r))
+	}
+	par := 0
+	for i, name := range binopNames {
+		if !c.does(name) {
+			continue
+		}
+		if i > 0 {
+			a, b = fresh(c.pa), fresh(c.pb)
+		}
+		var r *roaring.Bitmap
+		switch name {
+		case "Or":
+			r = roaring.Or(a, b)
+		case "And":
+			r = roaring.And(a, b)
+		case "Xor":
+			r = roaring.Xor(a, b)
+		case "AndNot":
+			r = roaring.AndNot(a, b)
+		case "FastOr":
+			r = roaring.FastOr(a, b)
+		case "FastAnd":
+			r = roaring.FastAnd(a, b)
+		case "HeapOr":
+			r = roaring.HeapOr(a, b)
+		case "HeapXor":
+			r = roaring.HeapXor(a, b)
+		case "ParOr":
+			r = roaring.ParOr(c.pars[par], a, b)
+			par++
+		case "ParAnd":
+			r = roaring.ParAnd(c.pars[par], a, b)
+			par++
+		case "ParHeapOr":
+			r = roaring.ParHeapOr(c.pars[par], a, b)
+			par++
+		}
+		read(name, r, binopWant(name, sa, sb))
+		got.add("a after "+name, readBitmap(a))
+		got.add("b after "+name, readBitmap(b))
+		x, y := c.xs[i].value(keys), c.ys[i].value(keys)
+		r.Flip(x, x+1)
+		got.add(name+" after flip", readBitmap(r))
+		got.add("a after flipping "+name, readBitmap(a))
+		got.add("b after flipping "+name, readBitmap(b))
+		a.Flip(y, y+1)
+		got.add(name+" after flipping a", readBitmap(r))
+	}
+	for i, name := range singleNames {
+		if !c.does("singles") {
+			break
+		}
+		a = fresh(c.pa)
+		var r *roaring.Bitmap
+		switch name {
+		case "FastOr":
+			r = roaring.FastOr(a)
+		case "FastAnd":
+			r = roaring.FastAnd(a)
+		case "ParHeapOr":
+			r = roaring.ParHeapOr(1, a)
+		case "ParOr":
+			r = roaring.ParOr(1, a)
+		case "ParAnd":
+			r = roaring.ParAnd(1, a)
+		case "HeapOr":
+			r = roaring.HeapOr(a)
+		case "HeapXor":
+			r = roaring.HeapXor(a)
+		}
+		got.add(name+"(a)", readBitmap(r))
+		got.set(name+"(a) is a", r == a)
+		x := c.sx[i].value(keys)
+		r.Flip(x, x+1)
+		got.add("a after flipping "+name+"(a)", readBitmap(a))
+	}
+	if c.does("misc") {
+		a, b = fresh(c.pa), fresh(c.pb)
+		got.set("OrCardinality", a.OrCardinality(b))
+		got.set("AndCardinality", a.AndCardinality(b))
+		got.set("Intersects", a.Intersects(b))
+		got.set("Equals", a.Equals(b))
+		read("FastOr3", roaring.FastOr(a, b, cbm), sa.union(sb).union(sc))
+		read("FastAnd3", roaring.FastAnd(a, b, cbm), sa.inter(sb).inter(sc))
+		read("HeapOr3", roaring.HeapOr(a, b, cbm), sa.union(sb).union(sc))
+		read("HeapXor3", roaring.HeapXor(a, b, cbm), sa.xor(sb, universe32).xor(sc, universe32))
+		read("ParHeapOr3", roaring.ParHeapOr(c.pars[3], a, b, cbm), sa.union(sb).union(sc))
+		read("ParAnd3", roaring.ParAnd(c.pars[4], a, b, cbm), sa.inter(sb).inter(sc))
+		read("ParOr3", roaring.ParOr(c.pars[5], a, b, cbm), sa.union(sb).union(sc))
+		got.add("FastOr0", readBitmap(roaring.FastOr()))
+		got.add("FastAnd1", readBitmap(roaring.FastAnd(a)))
+		aa := a.Clone()
+		aa.AndAny(b, cbm)
+		read("AndAny", aa, sa.inter(sb.union(sc)))
+		got.add("b after AndAny", readBitmap(b))
+	}
+	a, b = fresh(c.pa), fresh(c.pb)
+	for _, name := range inplaceNames {
+		if !c.does("in-place") {
+			break
+		}
+		x := a.Clone()
+		y := a.Clone()
+		switch name {
+		case "Or":
+			x.Or(b)
+			y.Or(y)
+		case "And":
+			x.And(b)
+			y.And(y)
+		case "AndNot":
+			x.AndNot(b)
+			y.AndNot(y)
+		case "Xor":
+			x.Xor(b)
+			y.Xor(y)
+		}
+		read("in-place "+name, x, binopWant(name, sa, sb))
+		got.add("b after in-place "+name, readBitmap(b))
+		got.add("a after in-place "+name, readBitmap(a))
+		var self set
+		if name == "Or" || name == "And" {
+			self = sa
+		}
+		read("in-place "+name+" with itself", y, self)
+		c.v["self "+name] = c.v["in-place "+name+" with itself"]
+	}
+	return got
+}
+
+func TestHegelSetAlgebraMatchesTheModel(t *testing.T) {
+	judged(t, algebraCases, func(j *hzCaseJudge, c algebraCase) {
+		got := algebraActual(&c)
+		dryA, _ := dryReplay(c.pa)
+		kindsAgree(j.col, "a", dryA, c.kindsA, c.pa)
+		dryB, _ := dryReplay(c.pb)
+		kindsAgree(j.col, "b", dryB, c.kindsB, c.pb)
+		judgeByDropping(j, c, algebraExpected, func(algebraCase) checks { return got })
+	})
+}
diff --git a/hegel_zoo_bitmaps_test.go b/hegel_zoo_bitmaps_test.go
new file mode 100644
index 0000000..9b04e47
--- /dev/null
+++ b/hegel_zoo_bitmaps_test.go
@@ -0,0 +1,748 @@
+package roaring_test
+
+// The records the four wide properties (and the narrow ones) draw as raw material, with the
+// population of the older gen* functions of hegel_test.go: a case's container keys (one to
+// four, clustered so that adjacent containers, key 0 and the last key occur), points in them
+// (the ends and the array limit, the first hundred values, or anywhere), ranges (the whole
+// universe, a container-aligned start, the lengths at the container-size thresholds, to the
+// container end, or short; a tenth exchanged into an empty or inverted range), construction
+// steps (the thirteen faces of the older genOp at their shares), and a bitmap record (copy on
+// write, up to ten steps, a final RunOptimize). A record resolves to a plan (concrete ops) by
+// the model alone, the library builds the plan (build), and the model reads it (setOfOps); the
+// library is never called while drawing. The dry container-kind replica (dryReplay) predicts
+// the kind of every container and the copy-on-write flags a plan leaves, for the narrow
+// properties' classifier (which runs before the library is called) and as a check of the
+// kinds the wide properties read from the built bitmap (kindsOf).
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"hegel.dev/go/hegel"
+)
+
+// op is one construction step applied to both the bitmap and the model.
+type op struct {
+	kind   string
+	x      uint64
+	lo, hi uint64
+	many   []uint32
+}
+
+func (o op) String() string {
+	switch o.kind {
+	case "add", "remove", "checkedadd", "checkedremove", "addint":
+		return fmt.Sprintf("%s(%d)", o.kind, o.x)
+	case "addrange", "removerange", "flip", "flipint":
+		return fmt.Sprintf("%s(%d,%d)", o.kind, o.lo, o.hi)
+	case "addmany":
+		return fmt.Sprintf("addmany(%s)", short32(o.many))
+	}
+	return o.kind
+}
+
+// ---------------------------------------------------------------------------
+// Keys.
+
+// keyRec is one of the five alternatives of the older genKeys: key 0; 1 to 3; 65535; 4 to
+// 65534; the previous key plus one (0 to 3 when first), at 1:1:1:1:2.
+type keyRec struct {
+	alt int
+	v   int
+}
+
+// 16 nominal for the first four alternatives and 33 for the last: dieInts(0, 1, 1, 1, 1, 2)
+// realises 17/16/17/17/33.
+var keyRecs = hegel.FlatMap(dieInts(0, 1, 1, 1, 1, 2), func(alt int) hegel.Generator[keyRec] {
+	var v hegel.Generator[int]
+	switch alt {
+	case 1:
+		v = rangeHalves(1, 3)
+	case 3:
+		v = hegel.Integers(4, 65534)
+	case 4:
+		v = rangeHalves(0, 3)
+	default:
+		v = hegel.Just(0)
+	}
+	return hegel.Map(v, func(v int) keyRec { return keyRec{alt, v} })
+})
+
+// resolveKeys is the case's container keys, in record order.
+func resolveKeys(recs []keyRec) []uint16 {
+	var keys []uint16
+	for _, r := range recs {
+		switch r.alt {
+		case 0:
+			keys = append(keys, 0)
+		case 1, 3:
+			keys = append(keys, uint16(r.v))
+		case 2:
+			keys = append(keys, 65535)
+		default:
+			if len(keys) > 0 {
+				keys = append(keys, keys[len(keys)-1]+1)
+			} else {
+				keys = append(keys, uint16(r.v))
+			}
+		}
+	}
+	return keys
+}
+
+// keyCounts is the number of keys of a case, 1 to 4 evenly (rangeHalves(1, 4) realises
+// 25/25/25/25); every case generator is a FlatMap over it, so that the point records can
+// index the keys evenly.
+var keyCounts = rangeHalves(1, 4)
+
+// ---------------------------------------------------------------------------
+// Points.
+
+// pointRec is a value in one of the case's containers: the key by index, the low 16 bits by
+// alternative (the ends and the array limit: 0, 1, 65535, 65534, 4096, 4095; 0 to 100;
+// anywhere), at 1:1:3 as the older genPoint.
+type pointRec struct {
+	ki  int
+	alt int
+	v   int
+}
+
+var pointSpecials = []int{0, 1, 65535, 65534, 4096, 4095}
+
+// 20/20/60 nominal: dieInts(0, 1, 1, 3) realises 20/20/60; the key index evenly by
+// hzDie(nkeys) (a die of at most four faces, even enough: one engine draw and a half
+// against the eight of a halving, and a case draws dozens of points).
+func pointRecs(nkeys int) hegel.Generator[pointRec] {
+	ki := hzDie(nkeys)
+	return hegel.FlatMap(dieInts(0, 1, 1, 3), func(alt int) hegel.Generator[pointRec] {
+		var v hegel.Generator[int]
+		switch alt {
+		case 0:
+			v = evenHalves(0, 1, 2, 3, 4, 5)
+		case 1:
+			v = hegel.Integers(0, 100)
+		default:
+			v = hegel.Integers(0, 65535)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) pointRec {
+			return pointRec{ki: hegel.Draw(tc, ki), alt: alt, v: hegel.Draw(tc, v)}
+		})
+	})
+}
+
+func (p pointRec) value(keys []uint16) uint64 {
+	low := p.v
+	if p.alt == 0 {
+		low = pointSpecials[p.v%len(pointSpecials)]
+	}
+	return uint64(keys[p.ki%len(keys)])<<16 | uint64(low)
+}
+
+// pointValues resolves a list of point records.
+func pointValues(recs []pointRec, keys []uint16) []uint64 {
+	out := make([]uint64, len(recs))
+	for i, p := range recs {
+		out[i] = p.value(keys)
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Ranges.
+
+// rangeRec is a range [lo, hi) as the older genRange drew it: the whole universe (3
+// percent), else a start point (container-aligned 15 percent of the time) and a length by
+// alternative (0 to 3; a container-size threshold; 60000 to 200000; to the container end; 1
+// to 5000, at 1:1:1:1:4), the end capped at the universe; a tenth of them exchanged (an
+// empty or inverted range, half of those made empty), which every operation must treat as a
+// no-op.
+type rangeRec struct {
+	full    bool
+	lo      pointRec
+	aligned bool
+	lenAlt  int
+	lenV    int
+	swap    bool
+	empty   bool
+}
+
+var rangeLengths = []int{4096, 4097, 4095, 65536, 65535, 65537, 131072}
+
+// full 3 nominal: dieCoin(3) realises 3; aligned 15: dieCoin(15) realises 15; the length
+// alternatives 12/12/12/12/50: dieInts(0, 1, 1, 1, 1, 4) realises 13/12/13/12/50; swap 10:
+// dieCoin(10) realises 10; empty 50 of those: dieCoin(50) realises 50.
+func rangeRecs(nkeys int) hegel.Generator[rangeRec] {
+	points := pointRecs(nkeys)
+	return hegel.FlatMap(dieInts(0, 1, 1, 1, 1, 4), func(lenAlt int) hegel.Generator[rangeRec] {
+		var lenV hegel.Generator[int]
+		switch lenAlt {
+		case 0:
+			lenV = rangeHalves(0, 3)
+		case 1:
+			lenV = evenHalves(0, 1, 2, 3, 4, 5, 6)
+		case 2:
+			lenV = hegel.Integers(60000, 200000)
+		case 3:
+			lenV = hegel.Just(0)
+		default:
+			lenV = hegel.Integers(1, 5000)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) rangeRec {
+			return rangeRec{
+				full:    hegel.Draw(tc, dieCoin(3)),
+				lo:      hegel.Draw(tc, points),
+				aligned: hegel.Draw(tc, dieCoin(15)),
+				lenAlt:  lenAlt,
+				lenV:    hegel.Draw(tc, lenV),
+				swap:    hegel.Draw(tc, dieCoin(10)),
+				empty:   hegel.Draw(tc, dieCoin(50)),
+			}
+		})
+	})
+}
+
+func (r rangeRec) bounds(keys []uint16) (uint64, uint64) {
+	if r.full {
+		return 0, universe32
+	}
+	lo := r.lo.value(keys)
+	if r.aligned {
+		lo &^= 0xffff
+	}
+	var length uint64
+	switch r.lenAlt {
+	case 1:
+		length = uint64(rangeLengths[r.lenV%len(rangeLengths)])
+	case 3:
+		length = 65536 - lo&0xffff
+	default:
+		length = uint64(r.lenV)
+	}
+	hi := min(lo+length, universe32)
+	if r.swap {
+		lo, hi = hi, lo
+		if lo > hi && r.empty {
+			lo = hi
+		}
+	}
+	return lo, hi
+}
+
+// ---------------------------------------------------------------------------
+// Construction steps.
+
+// opRec is one step as the older genOp drew it, by kind: add (2 of 13); remove or
+// checkedremove (1), of a value of the set 60 percent of the time; checkedadd or addint (1);
+// addrange (2); removerange (1); flip (2), flipint 30 percent of the time; addmany of up to
+// 40 points (1); runoptimize (1); clear 30 percent of the time else add (1); clone (1).
+type opRec struct {
+	kind    int
+	p       pointRec
+	alt     bool
+	present bool
+	idx     int
+	r       rangeRec
+	many    []pointRec
+}
+
+const (
+	opAdd = iota
+	opRemove
+	opAddVariant
+	opAddRange
+	opRemoveRange
+	opFlip
+	opAddMany
+	opRunOptimize
+	opClearOrAdd
+	opClone
+)
+
+var opNames = []string{"add", "remove", "add variant", "addrange", "removerange", "flip", "addmany", "runoptimize", "clear or add", "clone"}
+
+// 15/8/8/15/8/15/8/8/8/8 nominal (the thirteen faces): dieInts(0, 2, 1, 1, 2, 1, 2, 1, 1, 1, 1)
+// realises 15/8/8/15/8/15/8/8/8/8; the remove's present value 60: dieCoin(60) realises 60;
+// flipint 30 of the flips: dieCoin(30) realises 30; clear 30 of its face: dieCoin(30)
+// realises 30; the checked and int variants and remove's two kinds evenly (hzDie(2)).
+func opRecs(nkeys int) hegel.Generator[opRec] {
+	points := pointRecs(nkeys)
+	ranges := rangeRecs(nkeys)
+	coin := hegel.Map(hzDie(2), func(i int) bool { return i == 1 })
+	return hegel.FlatMap(dieInts(0, 2, 1, 1, 2, 1, 2, 1, 1, 1, 1), func(kind int) hegel.Generator[opRec] {
+		return hegel.Composite(func(tc hegel.TestCase) opRec {
+			o := opRec{kind: kind}
+			switch kind {
+			case opAdd:
+				o.p = hegel.Draw(tc, points)
+			case opRemove:
+				o.p = hegel.Draw(tc, points)
+				o.alt = hegel.Draw(tc, coin)
+				o.present = hegel.Draw(tc, dieCoin(60))
+				o.idx = hegel.Draw(tc, hegel.Integers(0, 1<<30-1))
+			case opAddVariant:
+				o.p = hegel.Draw(tc, points)
+				o.alt = hegel.Draw(tc, coin)
+			case opAddRange, opRemoveRange:
+				o.r = hegel.Draw(tc, ranges)
+			case opFlip:
+				o.r = hegel.Draw(tc, ranges)
+				o.alt = hegel.Draw(tc, dieCoin(30))
+			case opAddMany:
+				o.many = hegel.Draw(tc, countedHalves(points, 0, 40))
+			case opClearOrAdd:
+				o.alt = hegel.Draw(tc, dieCoin(30))
+				o.p = hegel.Draw(tc, points)
+			}
+			return o
+		})
+	})
+}
+
+// resolve is the concrete step of a record on the model's current set (a remove of a present
+// value picks it by index).
+func (o opRec) resolve(keys []uint16, cur set) op {
+	switch o.kind {
+	case opAdd:
+		return op{kind: "add", x: o.p.value(keys)}
+	case opRemove:
+		x := o.p.value(keys)
+		if o.present && cur.card() > 0 && cur.card() <= 100000 {
+			x, _ = cur.selectAt(uint64(o.idx) % cur.card())
+		}
+		kind := "remove"
+		if o.alt {
+			kind = "checkedremove"
+		}
+		return op{kind: kind, x: x}
+	case opAddVariant:
+		kind := "checkedadd"
+		if o.alt {
+			kind = "addint"
+		}
+		return op{kind: kind, x: o.p.value(keys)}
+	case opAddRange:
+		lo, hi := o.r.bounds(keys)
+		return op{kind: "addrange", lo: lo, hi: hi}
+	case opRemoveRange:
+		lo, hi := o.r.bounds(keys)
+		return op{kind: "removerange", lo: lo, hi: hi}
+	case opFlip:
+		lo, hi := o.r.bounds(keys)
+		if lo <= hi && o.alt {
+			return op{kind: "flipint", lo: lo, hi: hi}
+		}
+		return op{kind: "flip", lo: lo, hi: hi}
+	case opAddMany:
+		many := make([]uint32, len(o.many))
+		for i, p := range o.many {
+			many[i] = uint32(p.value(keys))
+		}
+		return op{kind: "addmany", many: many}
+	case opRunOptimize:
+		return op{kind: "runoptimize"}
+	case opClearOrAdd:
+		if o.alt {
+			return op{kind: "clear"}
+		}
+		return op{kind: "add", x: o.p.value(keys)}
+	}
+	return op{kind: "clone"}
+}
+
+// ---------------------------------------------------------------------------
+// Bitmap records and plans.
+
+// bitmapRec is a bitmap as the older genBitmap built it: copy on write 30 percent of the
+// time, 0 to 10 steps, RunOptimize at the end 25 percent of the time.
+type bitmapRec struct {
+	keys   []keyRec
+	cow    bool
+	ops    []opRec
+	runOpt bool
+}
+
+// cow 30 nominal: dieCoin(30) realises 30; the step count 0 to 10 evenly: countedHalves
+// realises 9 each; runOpt 25: dieCoin(25) realises 25.
+func bitmapRecs(nkeys int) hegel.Generator[bitmapRec] {
+	bodies := bitmapBodyRecs(nkeys)
+	return hegel.Composite(func(tc hegel.TestCase) bitmapRec {
+		keys := hegel.Draw(tc, hzCounted(keyRecs, nkeys, nkeys))
+		b := hegel.Draw(tc, bodies)
+		b.keys = keys
+		return b
+	})
+}
+
+// bitmapBodyRecs is a bitmap record without its keys (the algebra property's three bitmaps
+// share one key list).
+func bitmapBodyRecs(nkeys int) hegel.Generator[bitmapRec] {
+	ops := opRecs(nkeys)
+	return hegel.Composite(func(tc hegel.TestCase) bitmapRec {
+		return bitmapRec{
+			cow:    hegel.Draw(tc, dieCoin(30)),
+			ops:    hegel.Draw(tc, countedHalves(ops, 0, 10)),
+			runOpt: hegel.Draw(tc, dieCoin(25)),
+		}
+	})
+}
+
+// plan is a bitmap record resolved: the keys, copy on write, and the concrete steps (the
+// final RunOptimize as a step, as the older notes printed it).
+type plan struct {
+	keys []uint16
+	cow  bool
+	ops  []op
+}
+
+func (r bitmapRec) plan() plan {
+	keys := resolveKeys(r.keys)
+	var cur set
+	ops := make([]op, 0, len(r.ops)+1)
+	for _, o := range r.ops {
+		c := o.resolve(keys, cur)
+		ops = append(ops, c)
+		cur = applyModel(cur, c)
+	}
+	if r.runOpt {
+		ops = append(ops, op{kind: "runoptimize"})
+	}
+	return plan{keys: keys, cow: r.cow, ops: ops}
+}
+
+// String prints a plan as the older notes did: "ops [...] -> set", with copy on write.
+func (p plan) String() string {
+	cow := ""
+	if p.cow {
+		cow = " (copy on write)"
+	}
+	return fmt.Sprintf("ops %v -> %s%s", p.ops, setOfOps(p.ops), cow)
+}
+
+// applyModel is the model's half of a step.
+func applyModel(cur set, o op) set {
+	switch o.kind {
+	case "add", "addint", "checkedadd":
+		return cur.add(o.x)
+	case "remove", "checkedremove":
+		return cur.remove(o.x, universe32)
+	case "addrange":
+		if o.lo >= o.hi {
+			return cur
+		}
+		return cur.addRange(o.lo, o.hi)
+	case "removerange":
+		if o.lo >= o.hi {
+			return cur
+		}
+		return cur.removeRange(o.lo, o.hi, universe32)
+	case "flip", "flipint":
+		if o.lo >= o.hi {
+			return cur
+		}
+		return cur.flip(o.lo, o.hi, universe32)
+	case "addmany":
+		ivs := make([]iv, 0, len(cur)+len(o.many))
+		ivs = append(ivs, cur...)
+		for _, x := range o.many {
+			ivs = append(ivs, iv{uint64(x), uint64(x) + 1})
+		}
+		return norm(ivs)
+	case "clear":
+		return nil
+	}
+	return cur
+}
+
+// setOfOps is the set a plan's steps build.
+func setOfOps(ops []op) set {
+	var cur set
+	for _, o := range ops {
+		cur = applyModel(cur, o)
+	}
+	return cur
+}
+
+// opCheck is the name of the check of a Checked step's boolean.
+func opCheck(i int, o op) string { return fmt.Sprintf("op%d %v", i, o) }
+
+// build is the library's half: the bitmap the plan builds, and the booleans of its Checked
+// steps as checks.
+func build(p plan) (*roaring.Bitmap, checks) {
+	rb := roaring.New()
+	if p.cow {
+		rb.SetCopyOnWrite(true)
+	}
+	c := checks{}
+	for i, o := range p.ops {
+		switch o.kind {
+		case "add":
+			rb.Add(uint32(o.x))
+		case "addint":
+			rb.AddInt(int(o.x))
+		case "checkedadd":
+			c.set(opCheck(i, o), rb.CheckedAdd(uint32(o.x)))
+		case "remove":
+			rb.Remove(uint32(o.x))
+		case "checkedremove":
+			c.set(opCheck(i, o), rb.CheckedRemove(uint32(o.x)))
+		case "addrange":
+			rb.AddRange(o.lo, o.hi)
+		case "removerange":
+			rb.RemoveRange(o.lo, o.hi)
+		case "flip":
+			rb.Flip(o.lo, o.hi)
+		case "flipint":
+			rb.FlipInt(int(o.lo), int(o.hi))
+		case "addmany":
+			rb.AddMany(o.many)
+		case "runoptimize":
+			rb.RunOptimize()
+		case "clear":
+			rb.Clear()
+		case "clone":
+			rb = rb.Clone()
+		}
+	}
+	return rb, c
+}
+
+// planChecks is the model's statement of the Checked steps' booleans.
+func planChecks(p plan) checks {
+	c := checks{}
+	var cur set
+	for i, o := range p.ops {
+		switch o.kind {
+		case "checkedadd":
+			c.set(opCheck(i, o), !cur.contains(o.x))
+		case "checkedremove":
+			c.set(opCheck(i, o), cur.contains(o.x))
+		}
+		cur = applyModel(cur, o)
+	}
+	return c
+}
+
+// ---------------------------------------------------------------------------
+// The dry container-kind replica: the kind of every container a plan leaves and the keys
+// whose container is flagged for copy on write, by the rules of the library's in-place
+// operations (roaring.go Add/Remove/AddRange/RemoveRange/Flip/RunOptimize/Clear/Clone and
+// the containers' iaddReturnMinimized, iremoveReturnMinimized, iaddRange, iremoveRange,
+// inot and toEfficientContainer). A write at a key clears its flag
+// (getWritableContainerAtIndex); Clone under copy on write flags every key
+// (roaringArray.clone).
+
+// kindAfterAdd is a single value added: a new key gets an array; an array of 4096 values
+// becomes a bitmap when the value is new (arrayContainer.iaddReturnMinimized); a bitmap
+// filled becomes a full run (bitmapContainer.iaddReturnMinimized); a run its efficient kind.
+func kindAfterAdd(kind byte, before, after set) byte {
+	switch kind {
+	case 0:
+		return 'a'
+	case 'a':
+		if after.card() > before.card() && before.card() >= 4096 {
+			return 'b'
+		}
+		return 'a'
+	case 'b':
+		if after.card() == 65536 {
+			return 'r'
+		}
+		return 'b'
+	}
+	return efficientKind(after)
+}
+
+// kindAfterRemove is a single value removed: an array stays one (removed when emptied); a
+// bitmap becomes an array at 4096 values (bitmapContainer.iremoveReturnMinimized); a run its
+// efficient kind.
+func kindAfterRemove(kind byte, before, after set) byte {
+	if after.card() == 0 {
+		return 0
+	}
+	switch kind {
+	case 'a':
+		return 'a'
+	case 'b':
+		if after.card() < before.card() && after.card() == 4096 {
+			return 'a'
+		}
+		return 'b'
+	}
+	return efficientKind(after)
+}
+
+// dryReplay runs a plan through the rules; the flags are those of the keys still present.
+func dryReplay(p plan) (map[uint16]byte, map[uint16]bool) {
+	kinds := map[uint16]byte{}
+	flags := map[uint16]bool{}
+	cow := p.cow
+	setKind := func(key uint16, kind byte) {
+		if kind == 0 {
+			delete(kinds, key)
+			delete(flags, key)
+			return
+		}
+		kinds[key] = kind
+	}
+	var cur set
+	for _, o := range p.ops {
+		next := applyModel(cur, o)
+		switch o.kind {
+		case "add", "addint", "checkedadd":
+			key := uint16(o.x >> 16)
+			delete(flags, key)
+			setKind(key, kindAfterAdd(kinds[key], cur.inKey(key), next.inKey(key)))
+		case "remove", "checkedremove":
+			key := uint16(o.x >> 16)
+			if kinds[key] != 0 {
+				delete(flags, key)
+				setKind(key, kindAfterRemove(kinds[key], cur.inKey(key), next.inKey(key)))
+			}
+		case "addmany":
+			// Value by value, as AddMany adds them: the kind rule needs each key's
+			// cardinality before and after every value (an array container of 4096 values
+			// becomes a bitmap on the next new one), tracked by count for the array and
+			// bitmap containers (and new keys), and the part itself for a run container,
+			// whose efficient kind depends on its intervals (a run key turning array or
+			// bitmap goes on by count; a bitmap filled to a full run within one AddMany, a
+			// list of 65536 values, is beyond the records).
+			cards := map[uint16]uint64{}
+			parts := map[uint16]set{}
+			seen := map[uint32]bool{}
+			for _, x := range o.many {
+				key := uint16(x >> 16)
+				delete(flags, key)
+				isNew := !seen[x] && !cur.contains(uint64(x))
+				seen[x] = true
+				if kinds[key] == 'r' {
+					part, ok := parts[key]
+					if !ok {
+						part = cur.inKey(key)
+					}
+					after := part.add(uint64(x & 0xffff))
+					parts[key] = after
+					cards[key] = after.card()
+					setKind(key, kindAfterAdd('r', part, after))
+					continue
+				}
+				before, ok := cards[key]
+				if !ok {
+					before = cur.inKey(key).card()
+				}
+				after := before
+				if isNew {
+					after++
+				}
+				cards[key] = after
+				setKind(key, kindAfterAdd(kinds[key], set{{0, before}}, set{{0, after}}))
+			}
+		case "addrange":
+			if o.lo < o.hi {
+				for key := o.lo >> 16; key <= (o.hi-1)>>16; key++ {
+					k16 := uint16(key)
+					after := next.inKey(k16)
+					switch kinds[k16] {
+					case 0:
+						setKind(k16, efficientKind(after))
+					case 'a':
+						delete(flags, k16)
+						if after.card() > 4096 {
+							setKind(k16, 'b')
+						}
+					default:
+						delete(flags, k16)
+					}
+				}
+			}
+		case "removerange":
+			if o.lo < o.hi {
+				hi := min(o.hi, universe32)
+				for key := o.lo >> 16; key <= (hi-1)>>16; key++ {
+					k16 := uint16(key)
+					if kinds[k16] == 0 {
+						continue
+					}
+					after := next.inKey(k16)
+					if after.card() == 0 {
+						setKind(k16, 0)
+						continue
+					}
+					delete(flags, k16)
+					if kinds[k16] == 'b' && after.card() <= 4096 {
+						setKind(k16, 'a')
+					}
+				}
+			}
+		case "flip", "flipint":
+			if o.lo < o.hi {
+				for key := o.lo >> 16; key <= (o.hi-1)>>16; key++ {
+					k16 := uint16(key)
+					delete(flags, k16)
+					setKind(k16, kindAfterFlip(kinds[k16], next.inKey(k16)))
+				}
+			}
+		case "runoptimize":
+			for key := range kinds {
+				kinds[key] = efficientKind(next.inKey(key))
+			}
+		case "clear":
+			// Clear turns copy on write off as well (roaringArray.clear sets copyOnWrite
+			// false): a later Clone copies the containers and flags nothing.
+			kinds = map[uint16]byte{}
+			flags = map[uint16]bool{}
+			cow = false
+		case "clone":
+			if cow {
+				for key := range kinds {
+					flags[key] = true
+				}
+			} else {
+				flags = map[uint16]bool{}
+			}
+		}
+		cur = next
+	}
+	return kinds, flags
+}
+
+// kindsAgree counts the dry replica's agreement with the kinds read from the library, and
+// notes the first disagreements for the collector.
+func kindsAgree(col *hzCollector, what string, dry, live map[uint16]byte, p plan) {
+	if len(dry) == len(live) {
+		same := true
+		for key, kind := range dry {
+			if live[key] != kind {
+				same = false
+				break
+			}
+		}
+		if same {
+			hzTally("kinds agreement")
+			return
+		}
+	}
+	hzTally("kinds disagreement")
+	col.note("kinds disagreement", "%s: dry %s, live %s for %s", what, kindsText(dry), kindsText(live), p)
+}
+
+func kindsText(kinds map[uint16]byte) string {
+	var parts []string
+	for _, key := range sortedKinds(kinds) {
+		parts = append(parts, fmt.Sprintf("%d:%c", key, kinds[key]))
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+func sortedKinds(kinds map[uint16]byte) []uint16 {
+	keys := make([]uint16, 0, len(kinds))
+	for key := range kinds {
+		keys = append(keys, key)
+	}
+	for i := 1; i < len(keys); i++ {
+		for j := i; j > 0 && keys[j] < keys[j-1]; j-- {
+			keys[j], keys[j-1] = keys[j-1], keys[j]
+		}
+	}
+	return keys
+}
