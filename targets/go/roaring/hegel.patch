+// ---------------------------------------------------------------------------
+// Property 4: iterators.
+
+func TestHegelIteratorsWalkTheSet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		rb, want, ops := genBitmap(ht, keys)
+		note(ht, "ops %v -> %s", ops, want)
+		const limit = 150000
+		card := want.card()
+		// Forward iterator with random peeks and advances.
+		{
+			it := rb.Iterator()
+			pos := int64(0) // model: the next value is want.nextValue(pos)
+			steps := int(min(card, 300)) + n(ht, 0, 3)
+			for i := 0; i < steps; i++ {
+				next := want.nextValue(uint64(pos))
+				if it.HasNext() != (next >= 0) {
+					fail(ht, "Iterator.HasNext = %v at position %d on %s", it.HasNext(), pos, want)
+				}
+				if next < 0 {
+					break
+				}
+				switch n(ht, 0, 4) {
+				case 0:
+					if got := it.PeekNext(); int64(got) != next {
+						fail(ht, "PeekNext = %d, want %d on %s", got, next, want)
+					}
+				case 1:
+					m := genPoint(ht, keys)
+					it.AdvanceIfNeeded(uint32(m))
+					if int64(m) > next {
+						pos = int64(m)
+					}
+					continue
+				default:
+					if got := it.Next(); int64(got) != next {
+						fail(ht, "Next = %d, want %d on %s", got, next, want)
+					}
+					pos = next + 1
+				}
+			}
+		}
+		// Full walks when the set is small; prefixes otherwise.
+		k := int(min(card, limit))
+		fw := want.firstN(k)
+		{
+			var got []uint64
+			for x := range roaring.Values(rb) {
+				got = append(got, uint64(x))
+				if len(got) == k {
+					break
+				}
+			}
+			if !reflect.DeepEqual(got, fw) && !(len(got) == 0 && len(fw) == 0) {
+				fail(ht, "Values gives %s, want %s", short64(got), short64(fw))
+			}
+		}
+		{
+			bw := want.lastN(k)
+			var got []uint64
+			it := rb.ReverseIterator()
+			for it.HasNext() && len(got) < k {
+				got = append(got, uint64(it.Next()))
+			}
+			if !reflect.DeepEqual(got, bw) && !(len(got) == 0 && len(bw) == 0) {
+				fail(ht, "ReverseIterator gives %s, want %s", short64(got), short64(bw))
+			}
+			got = nil
+			for x := range roaring.Backward(rb) {
+				got = append(got, uint64(x))
+				if len(got) == k {
+					break
+				}
+			}
+			if !reflect.DeepEqual(got, bw) && !(len(got) == 0 && len(bw) == 0) {
+				fail(ht, "Backward gives %s, want %s", short64(got), short64(bw))
+			}
+		}
+		{
+			it := rb.ManyIterator()
+			var got []uint64
+			hs := uint64(n(ht, 0, 1000)) << 32
+			use64 := chance(ht, 50)
+			for len(got) < k {
+				sz := pick(ht, 1, 2, 3, 7, 64, 1000, 4096, 5000)
+				var m int
+				if use64 {
+					buf := make([]uint64, sz)
+					m = it.NextMany64(hs, buf)
+					for _, v := range buf[:m] {
+						if v&hs != hs {
+							fail(ht, "NextMany64 value %x lacks the mask %x", v, hs)
+						}
+						got = append(got, v&^hs)
+					}
+				} else {
+					buf := make([]uint32, sz)
+					m = it.NextMany(buf)
+					for _, v := range buf[:m] {
+						got = append(got, uint64(v))
+					}
+				}
+				if m == 0 {
+					break
+				}
+				if m > sz {
+					fail(ht, "NextMany returned %d for a buffer of %d", m, sz)
+				}
+			}
+			if len(got) > k {
+				got = got[:k]
+			}
+			if !reflect.DeepEqual(got, fw) && !(len(got) == 0 && len(fw) == 0) {
+				fail(ht, "ManyIterator gives %s, want %s", short64(got), short64(fw))
+			}
+			if k == int(card) {
+				buf := make([]uint32, 4)
+				if m := it.NextMany(buf); m != 0 {
+					fail(ht, "NextMany after the end returned %d", m)
+				}
+			}
+		}
+		// Iterate visits each value once (in any order) and stops on false.
+		if card <= limit {
+			seen := make(map[uint32]int)
+			rb.Iterate(func(x uint32) bool { seen[x]++; return true })
+			if uint64(len(seen)) != card {
+				fail(ht, "Iterate visited %d distinct values, want %d", len(seen), card)
+			}
+			for x, c := range seen {
+				if c != 1 || !want.contains(uint64(x)) {
+					fail(ht, "Iterate visited %d %d times (in set: %v)", x, c, want.contains(uint64(x)))
+				}
+			}
+			stop := n(ht, 0, int(card))
+			cnt := 0
+			rb.Iterate(func(x uint32) bool { cnt++; return cnt < stop })
+			if wantCnt := min(stop, int(card)); (stop == 0 && card > 0 && cnt != 1) || (stop > 0 && cnt != wantCnt) {
+				fail(ht, "Iterate stopping at %d made %d calls (card %d)", stop, cnt, card)
+			}
+		}
+		// Unset iterators over a bounded window.
+		lo, hi := genRange(ht, keys)
+		if lo < hi && hi-lo > limit {
+			hi = lo + limit
+		}
+		if chance(ht, 10) {
+			lo, hi = hi, lo
+		}
+		absent := want.complement(universe32)
+		var wantU []uint64
+		if lo < hi {
+			wantU = absent.inter(set{{lo, hi}}).values64()
+		}
+		bigInWindow := false
+		if lo < hi {
+			for _, k := range want.inter(set{{lo, hi}}).keysOf() {
+				if want.inKey(k).card() > 4096 {
+					bigInWindow = true
+				}
+			}
+		}
+		if !(Known.absentValueBitmap && bigInWindow) {
+			it := rb.UnsetIterator(lo, hi)
+			var got []uint64
+			for it.HasNext() {
+				if chance(ht, 10) {
+					if p := it.PeekNext(); uint64(p) != wantU[len(got)] {
+						fail(ht, "UnsetIterator(%d,%d).PeekNext = %d, want %d", lo, hi, p, wantU[len(got)])
+					}
+				}
+				got = append(got, uint64(it.Next()))
+				if len(got) > len(wantU) {
+					break
+				}
+			}
+			if !reflect.DeepEqual(got, wantU) && !(len(got) == 0 && len(wantU) == 0) {
+				fail(ht, "UnsetIterator(%d,%d) gives %s, want %s on %s", lo, hi, short64(got), short64(wantU), want)
+			}
+		}
+		if lo < hi && hi <= universe32 && !(Known.absentValueBitmap && bigInWindow) {
+			var got []uint64
+			for x := range roaring.Unset(rb, uint32(lo), uint32(hi-1)) {
+				got = append(got, uint64(x))
+				if len(got) > len(wantU) {
+					break
+				}
+			}
+			if !reflect.DeepEqual(got, wantU) && !(len(got) == 0 && len(wantU) == 0) {
+				fail(ht, "Unset(%d,%d) gives %s, want %s on %s", lo, hi-1, short64(got), short64(wantU), want)
+			}
+		}
+		// Ranges is the model's interval list (setOf checks it against ToArray).
+		got, err := setOf(rb)
+		if err != nil {
+			fail(ht, "%v", err)
+		}
+		if !got.equal(want) {
+			fail(ht, "Ranges give %s, want %s", got, want)
+		}
+	})
+}
