+// ---------------------------------------------------------------------------
+// Property 3: rank, select, cardinality in range and the neighbour queries.
+
+func TestHegelRankSelectAndNeighboursFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		rb, want, ops := genBitmap(ht, keys)
+		note(ht, "ops %v -> %s", ops, want)
+		for i := 0; i < 10; i++ {
+			x := genPoint(ht, keys)
+			if chance(ht, 20) && want.card() > 0 {
+				// A value of the set, or one just beside it.
+				v, _ := want.selectAt(uint64(n(ht, 0, int(min(want.card()-1, 1<<30)))))
+				x = uint64(int64(v) + int64(n(ht, -1, 1)))
+				if x >= universe32 {
+					x = universe32 - 1
+				}
+			}
+			if got := rb.Rank(uint32(x)); got != want.rank(x) {
+				fail(ht, "Rank(%d) = %d, want %d on %s", x, got, want.rank(x), want)
+			}
+			if got, wantN := rb.NextValue(uint32(x)), want.nextValue(x); got != wantN {
+				fail(ht, "NextValue(%d) = %d, want %d on %s", x, got, wantN, want)
+			}
+			if got, wantP := rb.PreviousValue(uint32(x)), want.prevValue(x); got != wantP {
+				fail(ht, "PreviousValue(%d) = %d, want %d on %s", x, got, wantP, want)
+			}
+			absent := want.complement(universe32)
+			wantNA := absent.nextValue(x)
+			wantPA := absent.prevValue(x)
+			bigContainer := want.inKey(uint16(x>>16)).card() > 4096
+			gateNA := (Known.absentValueHighBits && (x >= 65536 || wantNA >= 65536)) ||
+				(Known.absentValueNeighbours && (wantNA < 0 || wantNA>>16 != int64(x>>16))) ||
+				(Known.absentValueBitmap && bigContainer)
+			if !gateNA {
+				if got := rb.NextAbsentValue(uint32(x)); got != wantNA {
+					fail(ht, "NextAbsentValue(%d) = %d, want %d on %s", x, got, wantNA, want)
+				}
+			}
+			gatePA := (Known.absentValueHighBits && (x >= 65536 || wantPA >= 65536)) ||
+				(Known.absentValueNeighbours && (wantPA < 0 || wantPA>>16 != int64(x>>16))) ||
+				(Known.absentValueBitmap && bigContainer)
+			if !gatePA {
+				if got := rb.PreviousAbsentValue(uint32(x)); got != wantPA {
+					fail(ht, "PreviousAbsentValue(%d) = %d, want %d on %s", x, got, wantPA, want)
+				}
+			}
+		}
+		// Select walks the set in order; past the end it errors.
+		card := want.card()
+		for i := 0; i < 6; i++ {
+			var k uint64
+			switch n(ht, 0, 3) {
+			case 0:
+				k = card + uint64(n(ht, 0, 2))
+			default:
+				if card == 0 {
+					k = uint64(n(ht, 0, 3))
+				} else {
+					k = uint64(n(ht, 0, int(min(card-1, 1<<31-1))))
+				}
+			}
+			if k >= 1<<32 {
+				continue
+			}
+			got, err := rb.Select(uint32(k))
+			wantV, ok := want.selectAt(k)
+			if ok != (err == nil) || (ok && uint64(got) != wantV) {
+				fail(ht, "Select(%d) = %d, %v; want %d, ok=%v on %s", k, got, err, wantV, ok, want)
+			}
+			if ok && want.rank(wantV) != k+1 {
+				fail(ht, "model inconsistency: rank(select(%d)) = %d", k, want.rank(wantV))
+			}
+		}
+		// CardinalityInRange and IntersectsWithInterval, half-open.
+		for i := 0; i < 6; i++ {
+			lo, hi := genRange(ht, keys)
+			if got := rb.CardinalityInRange(lo, hi); got != want.cardInRange(lo, hi) {
+				fail(ht, "CardinalityInRange(%d,%d) = %d, want %d on %s", lo, hi, got, want.cardInRange(lo, hi), want)
+			}
+			if lo <= hi {
+				if got := rb.IntersectsWithInterval(lo, hi); got != (want.cardInRange(lo, hi) > 0) {
+					fail(ht, "IntersectsWithInterval(%d,%d) = %v, want %v on %s", lo, hi, got, want.cardInRange(lo, hi) > 0, want)
+				}
+			}
+		}
+		// Rank of the maximum is the cardinality; of anything below the minimum, 0.
+		if card > 0 {
+			if got := rb.Rank(uint32(want.max())); got != card {
+				fail(ht, "Rank(max) = %d, want %d", got, card)
+			}
+			if want.min() > 0 {
+				if got := rb.Rank(uint32(want.min() - 1)); got != 0 {
+					fail(ht, "Rank(min-1) = %d, want 0", got)
+				}
+			}
+		}
+		// AddOffset and AddOffset64.
+		off := int64(n(ht, -70000, 70000))
+		if chance(ht, 20) {
+			off = pick(ht, int64(1)<<32-1, -(int64(1) << 32), int64(1)<<31, -1, 1, 65536, -65536, int64(1)<<32)
+		}
+		if want.card() > 1<<26 {
+			// AddOffset64 shifts run containers value by value (runContainer16.inplaceUnion
+			// adds each value of the shifted run), about 5 ns a value: a non-aligned shift of
+			// the full universe takes 20 s. Keep large sets on container-aligned offsets.
+			off -= off % 65536
+		}
+		r64 := roaring.AddOffset64(rb, off)
+		check(ht, fmt.Sprintf("AddOffset64(%d)", off), r64, want.shift(off, universe32))
+		check(ht, "receiver after AddOffset64", rb, want)
+		if off >= 0 && off < 1<<32 {
+			r32 := roaring.AddOffset(rb, uint32(off))
+			check(ht, fmt.Sprintf("AddOffset(%d)", off), r32, want.shift(off, universe32))
+		}
+	})
+}
