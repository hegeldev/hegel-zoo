+// ---------------------------------------------------------------------------
+// Property 7: corrupt bytes never panic, and Validate guards use.
+
+func TestHegelCorruptBytesNeverPanicAndValidateGuards(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		rb, want, ops := genBitmap(ht, keys)
+		var data []byte
+		if chance(ht, 30) {
+			data = writeSpec(want, genKinds(ht, want))
+		} else {
+			data, _ = rb.ToBytes()
+		}
+		orig := append([]byte{}, data...)
+		edits := n(ht, 1, 3)
+		for i := 0; i < edits && len(data) > 0; i++ {
+			pos := n(ht, 0, len(data)-1)
+			if chance(ht, 30) {
+				pos = n(ht, 0, min(len(data)-1, 40)) // the headers
+			}
+			switch n(ht, 0, 5) {
+			case 0:
+				data[pos] ^= byte(1 << uint(n(ht, 0, 7)))
+			case 1:
+				data[pos] = byte(pick(ht, 0, 0xff, 0x7f, 0x80, 1))
+			case 2:
+				data = data[:pos]
+			case 3:
+				data = append(data[:pos:pos], data[min(pos+n(ht, 1, 8), len(data)):]...)
+			case 4:
+				data = append(append(append([]byte{}, data[:pos]...), byte(n(ht, 0, 255))), data[pos:]...)
+			default:
+				data = append(data, byte(n(ht, 0, 255)))
+			}
+		}
+		note(ht, "ops %v; %d bytes mutated to %d", ops, len(orig), len(data))
+		specSet, _, used, specErr := parseSpec(data)
+		for _, r := range []struct {
+			name string
+			read func(*roaring.Bitmap) (int64, error)
+		}{
+			{"ReadFrom", func(x *roaring.Bitmap) (int64, error) { return x.ReadFrom(bytes.NewReader(data)) }},
+			{"FromBuffer", func(x *roaring.Bitmap) (int64, error) { return x.FromBuffer(append([]byte{}, data...)) }},
+			{"FromUnsafeBytes", func(x *roaring.Bitmap) (int64, error) { return x.FromUnsafeBytes(append([]byte{}, data...)) }},
+			{"UnmarshalBinary", func(x *roaring.Bitmap) (int64, error) { return 0, x.UnmarshalBinary(data) }},
+		} {
+			x := roaring.New()
+			var err, verr error
+			func() {
+				defer func() {
+					if rec := recover(); rec != nil {
+						fail(ht, "%s panicked on corrupt bytes %x (from %x): %v", r.name, data, orig, rec)
+					}
+				}()
+				_, err = r.read(x)
+			}()
+			if err != nil && Known.validateAfterBadRead {
+				continue
+			}
+			func() {
+				defer func() {
+					if rec := recover(); rec != nil {
+						fail(ht, "Validate panicked after %s (err %v) on corrupt bytes %x (from %x): %v", r.name, err, data, orig, rec)
+					}
+				}()
+				verr = x.Validate()
+			}()
+			if specErr == nil && used == len(data) && !(Known.validateRejectsRuns && hasLooseRun(data)) {
+				// Well-formed by the spec: must be accepted and valid.
+				if err != nil || verr != nil {
+					fail(ht, "%s rejects spec-conformant bytes %x: read %v, Validate %v", r.name, data, err, verr)
+				}
+				check(ht, r.name+" of spec-conformant mutated bytes", x, specSet)
+				continue
+			}
+			if err != nil || verr != nil {
+				continue // rejected, as documented
+			}
+			if Known.validateAcceptsOverflow && specErr != nil && strings.Contains(specErr.Error(), "run past the container") {
+				continue // roaring/11: Validate lets these through and the bitmap then misbehaves
+			}
+			// Accepted and validated: the bitmap must behave.
+			func() {
+				defer func() {
+					if rec := recover(); rec != nil {
+						fail(ht, "validated bitmap from %s panicked in use: %v (bytes %x)", r.name, rec, data)
+					}
+				}()
+				got, gerr := setOf(x)
+				if gerr != nil {
+					fail(ht, "validated bitmap from %s is inconsistent: %v (bytes %x)", r.name, gerr, data)
+				}
+				for _, v := range got.firstN(50) {
+					if !x.Contains(uint32(v)) {
+						fail(ht, "validated bitmap from %s: Contains(%d) false for an iterated value", r.name, v)
+					}
+				}
+				out, err := x.ToBytes()
+				if err != nil {
+					fail(ht, "validated bitmap from %s: ToBytes %v", r.name, err)
+				}
+				again, _, _, perr := parseSpec(out)
+				if perr != nil || !again.equal(got) {
+					fail(ht, "validated bitmap from %s re-serializes to %v / %s, want %s", r.name, perr, again, got)
+				}
+			}()
+		}
+	})
+}
