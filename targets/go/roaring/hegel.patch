+++ b/hegel_pins_test.go
@@ -0,0 +1,250 @@
+package roaring_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"github.com/RoaringBitmap/roaring/v2/roaring64"
+)
+
+// roaring/1
+func TestHegelPinAbsentValuesKeepTheHighBits(t *testing.T) {
+	b := roaring.BitmapOf(100000)
+	if got := b.NextAbsentValue(100000); got != 100001 {
+		t.Errorf("BitmapOf(100000).NextAbsentValue(100000) = %d, want 100001", got)
+	}
+	if got := b.PreviousAbsentValue(100000); got != 99999 {
+		t.Errorf("BitmapOf(100000).PreviousAbsentValue(100000) = %d, want 99999", got)
+	}
+}
+
+// roaring/2
+func TestHegelPinAbsentValuesCrossContainers(t *testing.T) {
+	b := roaring.New()
+	b.AddRange(0, 65537)
+	if got := b.NextAbsentValue(0); got != 65537 {
+		t.Errorf("[0,65537).NextAbsentValue(0) = %d, want 65537", got)
+	}
+	b = roaring.New()
+	b.AddRange(0, 65536)
+	if got := b.NextAbsentValue(0); got != 65536 {
+		t.Errorf("[0,65536).NextAbsentValue(0) = %d, want 65536", got)
+	}
+	b = roaring.New()
+	b.AddRange(65536, 131072)
+	if got := b.PreviousAbsentValue(70000); got != 65535 {
+		t.Errorf("[65536,131072).PreviousAbsentValue(70000) = %d, want 65535", got)
+	}
+	if got := b.NextAbsentValue(70000); got != 131072 {
+		t.Errorf("[65536,131072).NextAbsentValue(70000) = %d, want 131072", got)
+	}
+	full := roaring.New()
+	full.AddRange(0, 1<<32)
+	if got := full.NextAbsentValue(0); got != -1 {
+		t.Errorf("full bitmap NextAbsentValue(0) = %d, want -1", got)
+	}
+}
+
+// roaring/3
+func TestHegelPinAbsentValuesInBitmapContainers(t *testing.T) {
+	vals := make([]uint32, 0, 65534)
+	for v := uint32(100); v < 65534; v++ {
+		if v != 6011 && v != 23000 {
+			vals = append(vals, v)
+		}
+	}
+	b := roaring.New()
+	b.AddMany(vals) // a bitmap container, not a run container
+	if b.Stats().BitmapContainers != 1 {
+		t.Fatalf("expected a bitmap container, got %+v", b.Stats())
+	}
+	if got := b.NextAbsentValue(23814); got != 65534 {
+		t.Errorf("NextAbsentValue(23814) = %d, want 65534 (present: %v)", got, b.Contains(uint32(got)))
+	}
+	if got := b.PreviousAbsentValue(23814); got != 23000 {
+		t.Errorf("PreviousAbsentValue(23814) = %d, want 23000 (present: %v)", got, b.Contains(uint32(got)))
+	}
+	vals = vals[:0]
+	vals = append(vals, 0)
+	for v := uint32(2); v < 4098; v++ {
+		vals = append(vals, v)
+	}
+	c := roaring.New()
+	c.AddMany(vals)
+	var unset []uint32
+	it := c.UnsetIterator(2, 4099)
+	for it.HasNext() {
+		unset = append(unset, it.Next())
+	}
+	if len(unset) != 1 || unset[0] != 4098 {
+		t.Errorf("UnsetIterator(2, 4099) over {0} + [2,4098) yields %v, want [4098]", unset)
+	}
+}
+
+// roaring/4
+func TestHegelPinParHeapOrResultIsIndependent(t *testing.T) {
+	a := roaring.BitmapOf(65539, 73894, 5)
+	b := roaring.BitmapOf(1, 2, 5)
+	r := roaring.ParHeapOr(0, a, b)
+	if !r.Equals(roaring.BitmapOf(1, 2, 5, 65539, 73894)) {
+		t.Fatalf("ParHeapOr = %s", r)
+	}
+	r.Add(65536)
+	if !a.Equals(roaring.BitmapOf(65539, 73894, 5)) {
+		t.Errorf("adding to the ParHeapOr result changed an input: a = %s", a)
+	}
+	a.Add(65540)
+	if !r.Equals(roaring.BitmapOf(1, 2, 5, 65536, 65539, 73894)) {
+		t.Errorf("adding to an input changed the ParHeapOr result: r = %s", r)
+	}
+}
+
+// roaring/5
+func TestHegelPinHeapAggregatesOfOneBitmapAreCopies(t *testing.T) {
+	a := roaring.BitmapOf(1, 2, 3)
+	if r := roaring.HeapOr(a); r == a {
+		t.Errorf("HeapOr(a) returned a itself")
+	}
+	if r := roaring.HeapXor(a); r == a {
+		t.Errorf("HeapXor(a) returned a itself")
+	}
+	r := roaring.HeapOr(a)
+	r.Add(4)
+	if !a.Equals(roaring.BitmapOf(1, 2, 3)) {
+		t.Errorf("mutating HeapOr(a) changed a: %s", a)
+	}
+}
+
+// roaring/6
+func TestHegelPinValidateAcceptsLibraryBuiltBitmaps(t *testing.T) {
+	a := roaring.New()
+	a.AddRange(196608, 327680)
+	r := roaring.AddOffset64(a, -1)
+	if err := r.Validate(); err != nil {
+		t.Errorf("AddOffset64([196608,327680), -1).Validate() = %v, want nil", err)
+	}
+	// A spec-conformant stream: one run container holding the single value 5.
+	data := []byte{0x3b, 0x30, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x05, 0x00, 0x00, 0x00}
+	x := roaring.New()
+	if _, err := x.ReadFrom(bytes.NewReader(data)); err != nil {
+		t.Fatalf("ReadFrom of a spec-conformant stream: %v", err)
+	}
+	if err := x.Validate(); err != nil {
+		t.Errorf("Validate rejects a spec-conformant run container of one value: %v", err)
+	}
+	if !x.Equals(roaring.BitmapOf(5)) {
+		t.Errorf("read %s, want {5}", x)
+	}
+}
+
+// roaring/7
+func TestHegelPinTruncatedStreamsAreErrorsNotCrashes(t *testing.T) {
+	data := []byte{0x3b, 0x30, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00}
+	func() {
+		defer func() {
+			if rec := recover(); rec != nil {
+				t.Errorf("MustReadFrom panicked on a truncated stream: %v", rec)
+			}
+		}()
+		x := roaring.New()
+		if _, err := x.MustReadFrom(bytes.NewReader(data)); err == nil {
+			t.Errorf("MustReadFrom accepted a truncated stream")
+		}
+	}()
+	func() {
+		defer func() {
+			if rec := recover(); rec != nil {
+				t.Errorf("Validate panicked after a failed ReadFrom: %v", rec)
+			}
+		}()
+		x := roaring.New()
+		if _, err := x.ReadFrom(bytes.NewReader(data)); err == nil {
+			t.Fatalf("ReadFrom accepted a truncated stream")
+		}
+		_ = x.Validate()
+	}()
+}
+
+// roaring/8
+func TestHegelPinEmptyRoaring32AsRoaring64IsEmpty(t *testing.T) {
+	e := roaring64.Roaring32AsRoaring64(roaring.New())
+	if err := e.Validate(); err != nil {
+		t.Errorf("Roaring32AsRoaring64(empty).Validate() = %v, want nil", err)
+	}
+	if !e.Equals(roaring64.New()) {
+		t.Errorf("Roaring32AsRoaring64(empty) is not equal to an empty 64-bit bitmap")
+	}
+}
+
+// roaring/9
+func TestHegelPinAddOffsetResultsSerialize(t *testing.T) {
+	a := roaring.New()
+	a.AddRange(196608, 196611)
+	a.RunOptimize()
+	a.AddRange(212083, 212696)
+	a.AddRange(196608, 327680)
+	r := roaring.AddOffset64(a, -1)
+	if got := r.GetCardinality(); got != a.GetCardinality() {
+		t.Fatalf("AddOffset64 lost values: %d, want %d", got, a.GetCardinality())
+	}
+	if err := r.Validate(); err != nil {
+		t.Errorf("AddOffset64 result does not validate: %v", err)
+	}
+	if _, err := r.ToBytes(); err != nil {
+		t.Errorf("AddOffset64 result cannot be serialized: %v", err)
+	}
+}
+
+// roaring/10
+func TestHegelPinChecksumIsAFunctionOfTheSet(t *testing.T) {
+	x := roaring.New()
+	x.AddRange(0, 5)
+	y := roaring.BitmapOf(0, 1, 2, 3, 4)
+	if !x.Equals(y) {
+		t.Fatalf("%s != %s", x, y)
+	}
+	if x.Checksum() != y.Checksum() {
+		t.Errorf("equal bitmaps have checksums %d (run container) and %d (array container)", x.Checksum(), y.Checksum())
+	}
+}
+
+// roaring/11
+func TestHegelPinValidateRejectsOverflowingRuns(t *testing.T) {
+	// One run container, key 2048, header cardinality 511, one run [21714, 21714+65025) past 65535.
+	data := []byte{0x3b, 0x30, 0x00, 0x00, 0x01, 0x00, 0x08, 0xfe, 0x01, 0x01, 0x00, 0xd2, 0x54, 0x00, 0xfe}
+	x := roaring.New()
+	if _, err := x.ReadFrom(bytes.NewReader(data)); err != nil {
+		return // rejected at read time is fine too
+	}
+	if err := x.Validate(); err == nil {
+		t.Errorf("Validate accepts a run container whose run extends past the container (card %d, min %d, max %d)", x.GetCardinality(), x.Minimum(), x.Maximum())
+	}
+}
+
+// roaring/12
+func TestHegelPinInPlaceXorLeavesTheArgumentAlone(t *testing.T) {
+	a := roaring.New()
+	a.AddRange(196608, 196991) // a run container
+	vals := make([]uint32, 0, 6000)
+	for i := uint32(0); i < 6000; i++ {
+		vals = append(vals, 196608+2*i)
+	}
+	b := roaring.New()
+	b.AddMany(vals) // a bitmap container
+	before := b.Clone()
+	a.Xor(b)
+	if !b.Equals(before) {
+		t.Errorf("a.Xor(b) changed b: %d values, was %d; Contains(196610) %v", b.GetCardinality(), before.GetCardinality(), b.Contains(196610))
+	}
+	b2 := before.Clone()
+	c := roaring.BitmapOf(196610, 196700, 196750) // an array container
+	c.Xor(b2)
+	if !b2.Equals(before) {
+		t.Errorf("c.Xor(b) changed b: %d values, was %d", b2.GetCardinality(), before.GetCardinality())
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..aa9359d
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2450 @@
+package roaring_test
+
+// Hegel property tests for github.com/RoaringBitmap/roaring/v2.
+//
+// Oracles: an interval-set model of a set of 32-bit (or 64-bit) integers
+// written here, against which every construction, set operation, query and
+// iterator is checked; the RoaringFormatSpec
+// (https://github.com/RoaringBitmap/RoaringFormatSpec), written here as an
+// independent parser and writer (the library's bytes must parse to the model,
+// and spec-conformant bytes of the model, with any legal choice of container
+// types, must be accepted); the documented contracts of the deserializers
+// (memory safety, Validate as the gate before use); and the bits-and-blooms
+// bitset for the dense conversions.
+//
+// The AGENTS.md of the repository is respected: a bitmap deserialized from
+// untrusted bytes is only used after Validate() returned nil.
+//
+// Set ROARING_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math/bits"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"testing/iotest"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"github.com/RoaringBitmap/roaring/v2/roaring64"
+	"github.com/bits-and-blooms/bitset"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// Some cases build bitmaps spanning all 65536 containers; on a loaded
+	// machine that trips Hegel's too-slow health check, which hegel-go reports
+	// without a message.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("ROARING_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...)+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+var lastNote string // the notes of the running case, for collect mode
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) {
+	m := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + m
+	ht.Note(m)
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	absentValueHighBits     bool // roaring/1: NextAbsentValue/PreviousAbsentValue return only the low 16 bits when the target's container key is not 0
+	absentValueNeighbours   bool // roaring/2: NextAbsentValue/PreviousAbsentValue answer wrongly when the answer lies outside the target's container
+	absentValueBitmap       bool // roaring/3: NextAbsentValue/PreviousAbsentValue and UnsetIterator return present values inside a bitmap container
+	parHeapOrShares         bool // roaring/4: ParHeapOr's result shares containers with its inputs without copy-on-write
+	heapOrOneReturnsInput   bool // roaring/5: HeapOr and HeapXor of a single bitmap return that bitmap itself
+	validateRejectsRuns     bool // roaring/6: Validate rejects spec-conformant run containers that are not the smallest representation
+	validateAfterBadRead    bool // roaring/7: Validate panics on the bitmap a failed ReadFrom/FromBuffer leaves behind
+	emptyAs64Invalid        bool // roaring/8: Roaring32AsRoaring64 of an empty bitmap is an invalid bitmap
+	offsetSmallBitmaps      bool // roaring/9: AddOffset/AddOffset64 build bitmap containers of 4096 values or fewer, which Validate rejects
+	checksumRepresentation  bool // roaring/10: Checksum depends on the container types, not only on the set
+	validateAcceptsOverflow bool // roaring/11: Validate accepts a run container whose run extends past the container
+	inPlaceXorMutatesArg    bool // roaring/12: in-place Xor mutates its argument when the argument holds a bitmap container and the receiver does not
+}{absentValueHighBits: true, absentValueNeighbours: true, absentValueBitmap: true, parHeapOrShares: true, heapOrOneReturnsInput: true, validateRejectsRuns: true, validateAfterBadRead: true, emptyAs64Invalid: true, offsetSmallBitmaps: true, checksumRepresentation: true, validateAcceptsOverflow: true, inPlaceXorMutatesArg: true}
+
+// tolerated reports whether a Validate error is one a recorded bug explains.
+func tolerated(err error) bool {
+	if err == nil {
+		return true
+	}
+	if Known.validateRejectsRuns && errors.Is(err, roaring.ErrRunIntervalSize) {
+		return true
+	}
+	if Known.offsetSmallBitmaps && strings.Contains(err.Error(), "bitmap container size was less than") {
+		return true
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// The model: a set of integers as sorted, disjoint, non-adjacent half-open
+// intervals [lo, hi) of uint64.
+
+type iv struct{ lo, hi uint64 }
+
+type set []iv
+
+const universe32 = uint64(1) << 32
+
+func norm(ivs []iv) set {
+	var out set
+	for _, x := range ivs {
+		if x.lo < x.hi {
+			out = append(out, x)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].lo < out[j].lo })
+	w := 0
+	for i := 0; i < len(out); i++ {
+		if w > 0 && out[i].lo <= out[w-1].hi {
+			if out[i].hi > out[w-1].hi {
+				out[w-1].hi = out[i].hi
+			}
+			continue
+		}
+		out[w] = out[i]
+		w++
+	}
+	return out[:w]
+}
+
+func (s set) union(t set) set { return norm(append(append([]iv{}, s...), t...)) }
+
+func (s set) inter(t set) set {
+	var out []iv
+	i, j := 0, 0
+	for i < len(s) && j < len(t) {
+		lo := max(s[i].lo, t[j].lo)
+		hi := min(s[i].hi, t[j].hi)
+		if lo < hi {
+			out = append(out, iv{lo, hi})
+		}
+		if s[i].hi < t[j].hi {
+			i++
+		} else {
+			j++
+		}
+	}
+	return norm(out)
+}
+
+func (s set) complement(uni uint64) set {
+	var out []iv
+	prev := uint64(0)
+	for _, x := range s {
+		if x.lo > prev {
+			out = append(out, iv{prev, x.lo})
+		}
+		prev = x.hi
+	}
+	if prev < uni {
+		out = append(out, iv{prev, uni})
+	}
+	return norm(out)
+}
+
+func (s set) minus(t set, uni uint64) set { return s.inter(t.complement(uni)) }
+
+func (s set) xor(t set, uni uint64) set { return s.minus(t, uni).union(t.minus(s, uni)) }
+
+func (s set) addRange(lo, hi uint64) set { return s.union(set{{lo, hi}}) }
+
+func (s set) removeRange(lo, hi uint64, uni uint64) set { return s.minus(set{{lo, hi}}, uni) }
+
+func (s set) flip(lo, hi uint64, uni uint64) set { return s.xor(set{{lo, hi}}, uni) }
+
+func (s set) add(x uint64) set { return s.addRange(x, x+1) }
+
+func (s set) remove(x uint64, uni uint64) set { return s.removeRange(x, x+1, uni) }
+
+func (s set) card() uint64 {
+	var c uint64
+	for _, x := range s {
+		c += x.hi - x.lo
+	}
+	return c
+}
+
+func (s set) contains(x uint64) bool {
+	i := sort.Search(len(s), func(i int) bool { return s[i].hi > x })
+	return i < len(s) && s[i].lo <= x
+}
+
+func (s set) min() uint64 { return s[0].lo }
+
+func (s set) max() uint64 { return s[len(s)-1].hi - 1 }
+
+// rank counts the values <= x.
+func (s set) rank(x uint64) uint64 {
+	var c uint64
+	for _, v := range s {
+		if v.lo > x {
+			break
+		}
+		c += min(v.hi, x+1) - v.lo
+	}
+	return c
+}
+
+// selectAt returns the k-th value (0-based); ok is false past the end.
+func (s set) selectAt(k uint64) (uint64, bool) {
+	for _, v := range s {
+		if k < v.hi-v.lo {
+			return v.lo + k, true
+		}
+		k -= v.hi - v.lo
+	}
+	return 0, false
+}
+
+// nextValue is the smallest value >= t, or -1.
+func (s set) nextValue(t uint64) int64 {
+	for _, v := range s {
+		if v.hi > t {
+			return int64(max(v.lo, t))
+		}
+	}
+	return -1
+}
+
+// prevValue is the largest value <= t, or -1.
+func (s set) prevValue(t uint64) int64 {
+	r := int64(-1)
+	for _, v := range s {
+		if v.lo > t {
+			break
+		}
+		r = int64(min(v.hi-1, t))
+	}
+	return r
+}
+
+func (s set) cardInRange(lo, hi uint64) uint64 {
+	if lo >= hi {
+		return 0
+	}
+	return s.inter(set{{lo, hi}}).card()
+}
+
+// values materializes the set (the caller keeps the cardinality small).
+func (s set) values() []uint32 {
+	out := make([]uint32, 0, s.card())
+	for _, v := range s {
+		for x := v.lo; x < v.hi; x++ {
+			out = append(out, uint32(x))
+		}
+	}
+	return out
+}
+
+func (s set) values64() []uint64 {
+	out := make([]uint64, 0, s.card())
+	for _, v := range s {
+		for x := v.lo; x < v.hi; x++ {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// firstN lists the smallest k values.
+func (s set) firstN(k int) []uint64 {
+	var out []uint64
+	for _, v := range s {
+		for x := v.lo; x < v.hi && len(out) < k; x++ {
+			out = append(out, x)
+		}
+		if len(out) == k {
+			break
+		}
+	}
+	return out
+}
+
+// lastN lists the largest k values, descending.
+func (s set) lastN(k int) []uint64 {
+	var out []uint64
+	for i := len(s) - 1; i >= 0; i-- {
+		v := s[i]
+		for x := v.hi; x > v.lo && len(out) < k; x-- {
+			out = append(out, x-1)
+		}
+		if len(out) == k {
+			break
+		}
+	}
+	return out
+}
+
+// shift adds off to every value and drops what leaves [0, uni).
+func (s set) shift(off int64, uni uint64) set {
+	var out []iv
+	for _, v := range s {
+		lo := int64(v.lo) + off
+		hi := int64(v.hi) + off
+		if hi <= 0 || lo >= int64(uni) {
+			continue
+		}
+		out = append(out, iv{uint64(max(lo, 0)), uint64(min(hi, int64(uni)))})
+	}
+	return norm(out)
+}
+
+func (s set) equal(t set) bool {
+	if len(s) != len(t) {
+		return false
+	}
+	for i := range s {
+		if s[i] != t[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func (s set) String() string {
+	if len(s) > 12 {
+		return fmt.Sprintf("%d intervals, card %d, %v ... %v", len(s), s.card(), s[:6], s[len(s)-3:])
+	}
+	return fmt.Sprintf("%v (card %d)", []iv(s), s.card())
+}
+
+// keysOf lists the 16-bit container keys the set touches (32-bit sets).
+func (s set) keysOf() []uint16 {
+	var keys []uint16
+	for _, v := range s {
+		for k := v.lo >> 16; k <= (v.hi-1)>>16; k++ {
+			if len(keys) == 0 || keys[len(keys)-1] != uint16(k) {
+				keys = append(keys, uint16(k))
+			}
+		}
+	}
+	return keys
+}
+
+// inKey is the part of the set within container key k, as low 16-bit values.
+func (s set) inKey(k uint16) set {
+	base := uint64(k) << 16
+	part := s.inter(set{{base, base + 65536}})
+	var out []iv
+	for _, v := range part {
+		out = append(out, iv{v.lo - base, v.hi - base})
+	}
+	return norm(out)
+}
+
+// ---------------------------------------------------------------------------
+// Comparing a bitmap with the model.
+
+// setOf reads the bitmap through Ranges, cross-checked by the cardinality and,
+// when small, ToArray.
+func setOf(rb *roaring.Bitmap) (set, error) {
+	var out []iv
+	var last uint64
+	first := true
+	for lo, hi := range rb.Ranges() {
+		if uint64(lo) >= hi || hi > universe32 {
+			return nil, fmt.Errorf("Ranges yielded [%d, %d)", lo, hi)
+		}
+		if !first && uint64(lo) <= last {
+			return nil, fmt.Errorf("Ranges yielded [%d, %d) after an end of %d (not sorted or not merged)", lo, hi, last)
+		}
+		first = false
+		last = hi
+		out = append(out, iv{uint64(lo), hi})
+	}
+	s := norm(out)
+	if c := rb.GetCardinality(); c != s.card() {
+		return nil, fmt.Errorf("GetCardinality %d but Ranges cover %d values", c, s.card())
+	}
+	if s.card() <= 200000 {
+		got := rb.ToArray()
+		want := s.values()
+		if !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+			return nil, fmt.Errorf("ToArray %s but Ranges give %s", short32(got), short32(want))
+		}
+	}
+	return s, nil
+}
+
+func short32(xs []uint32) string {
+	if len(xs) > 20 {
+		return fmt.Sprintf("%v...%v (%d values)", xs[:10], xs[len(xs)-5:], len(xs))
+	}
+	return fmt.Sprint(xs)
+}
+
+func short64(xs []uint64) string {
+	if len(xs) > 20 {
+		return fmt.Sprintf("%v...%v (%d values)", xs[:10], xs[len(xs)-5:], len(xs))
+	}
+	return fmt.Sprint(xs)
+}
+
+func check(ht *hegel.T, what string, rb *roaring.Bitmap, want set) {
+	if err := rb.Validate(); !tolerated(err) {
+		fail(ht, "%s: Validate: %v", what, err)
+	}
+	got, err := setOf(rb)
+	if err != nil {
+		fail(ht, "%s: %v", what, err)
+	}
+	if !got.equal(want) {
+		fail(ht, "%s: bitmap is %s, want %s", what, got, want)
+	}
+	if rb.IsEmpty() != (want.card() == 0) {
+		fail(ht, "%s: IsEmpty %v for %s", what, rb.IsEmpty(), want)
+	}
+	if want.card() > 0 {
+		if mn, mx := rb.Minimum(), rb.Maximum(); uint64(mn) != want.min() || uint64(mx) != want.max() {
+			fail(ht, "%s: Minimum/Maximum %d/%d, want %d/%d", what, mn, mx, want.min(), want.max())
+		}
+	}
+	st := rb.Stats()
+	if st.Cardinality != want.card() || st.ArrayContainerValues+st.BitmapContainerValues+st.RunContainerValues != want.card() ||
+		st.Containers != st.ArrayContainers+st.BitmapContainers+st.RunContainers || st.Containers != uint64(len(want.keysOf())) {
+		fail(ht, "%s: Stats %+v inconsistent with %s (%d keys)", what, st, want, len(want.keysOf()))
+	}
+	if rb.HasRunCompression() != (st.RunContainers > 0) {
+		fail(ht, "%s: HasRunCompression %v but Stats %+v", what, rb.HasRunCompression(), st)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// genKeys picks the container keys a case works in: clustered so that
+// adjacent containers, key 0 and the last key all occur.
+func genKeys(tc hegel.TestCase) []uint16 {
+	k := n(tc, 1, 4)
+	var keys []uint16
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 5) {
+		case 0:
+			keys = append(keys, 0)
+		case 1:
+			keys = append(keys, uint16(n(tc, 1, 3)))
+		case 2:
+			keys = append(keys, 65535)
+		case 3:
+			keys = append(keys, uint16(n(tc, 4, 65534)))
+		default:
+			if len(keys) > 0 {
+				keys = append(keys, keys[len(keys)-1]+1)
+			} else {
+				keys = append(keys, uint16(n(tc, 0, 3)))
+			}
+		}
+	}
+	return keys
+}
+
+func genPoint(tc hegel.TestCase, keys []uint16) uint64 {
+	k := pick(tc, keys...)
+	var low int
+	switch n(tc, 0, 4) {
+	case 0:
+		low = pick(tc, 0, 1, 65535, 65534, 4096, 4095)
+	case 1:
+		low = n(tc, 0, 100)
+	default:
+		low = n(tc, 0, 65535)
+	}
+	return uint64(k)<<16 | uint64(low)
+}
+
+// genRange draws [lo, hi) with lo <= hi within the 32-bit universe, mostly
+// near the case's keys, with the container-size thresholds represented.
+func genRange(tc hegel.TestCase, keys []uint16) (uint64, uint64) {
+	if chance(tc, 3) {
+		return 0, 4 << 16 // broad cross-container range; the full universe has a pin
+	}
+	lo := genPoint(tc, keys)
+	if chance(tc, 15) {
+		lo &^= 0xffff
+	}
+	var length uint64
+	switch n(tc, 0, 7) {
+	case 0:
+		length = uint64(n(tc, 0, 3))
+	case 1:
+		length = uint64(pick(tc, 4096, 4097, 4095, 65536, 65535, 65537, 131072))
+	case 2:
+		length = uint64(n(tc, 60000, 200000))
+	case 3:
+		length = 65536 - lo&0xffff // to the container end
+	default:
+		length = uint64(n(tc, 1, 5000))
+	}
+	hi := min(lo+length, universe32)
+	if chance(tc, 10) {
+		lo, hi = hi, lo // empty or inverted range: must be a no-op
+		if lo > hi && chance(tc, 50) {
+			lo = hi
+		}
+	}
+	return lo, hi
+}
+
+// op is one construction step applied to both the bitmap and the model.
+type op struct {
+	kind   string
+	x      uint64
+	lo, hi uint64
+	many   []uint32
+}
+
+func (o op) String() string {
+	switch o.kind {
+	case "add", "remove", "checkedadd", "checkedremove", "addint":
+		return fmt.Sprintf("%s(%d)", o.kind, o.x)
+	case "addrange", "removerange", "flip", "flipint":
+		return fmt.Sprintf("%s(%d,%d)", o.kind, o.lo, o.hi)
+	case "addmany":
+		return fmt.Sprintf("addmany(%s)", short32(o.many))
+	}
+	return o.kind
+}
+
+func genOp(tc hegel.TestCase, keys []uint16, cur set) op {
+	switch n(tc, 0, 12) {
+	case 0, 1:
+		return op{kind: "add", x: genPoint(tc, keys)}
+	case 2:
+		x := genPoint(tc, keys)
+		if cur.card() > 0 && cur.card() <= 100000 && chance(tc, 60) {
+			v := cur.values()
+			x = uint64(v[n(tc, 0, len(v)-1)])
+		}
+		return op{kind: pick(tc, "remove", "checkedremove"), x: x}
+	case 3:
+		return op{kind: pick(tc, "checkedadd", "addint"), x: genPoint(tc, keys)}
+	case 4, 5:
+		lo, hi := genRange(tc, keys)
+		return op{kind: "addrange", lo: lo, hi: hi}
+	case 6:
+		lo, hi := genRange(tc, keys)
+		return op{kind: "removerange", lo: lo, hi: hi}
+	case 7, 8:
+		lo, hi := genRange(tc, keys)
+		if lo <= hi && hi <= universe32 && chance(tc, 30) && hi < (1<<62) {
+			return op{kind: "flipint", lo: lo, hi: hi}
+		}
+		return op{kind: "flip", lo: lo, hi: hi}
+	case 9:
+		k := n(tc, 0, 40)
+		many := make([]uint32, k)
+		for i := range many {
+			many[i] = uint32(genPoint(tc, keys))
+		}
+		return op{kind: "addmany", many: many}
+	case 10:
+		return op{kind: "runoptimize"}
+	case 11:
+		if chance(tc, 30) {
+			return op{kind: "clear"}
+		}
+		return op{kind: "add", x: genPoint(tc, keys)}
+	default:
+		return op{kind: "clone"}
+	}
+}
+
+// apply performs the op on the bitmap and returns the new model; it also
+// checks the boolean results of the Checked variants.
+func apply(ht *hegel.T, rb *roaring.Bitmap, cur set, o op) (*roaring.Bitmap, set) {
+	switch o.kind {
+	case "add":
+		rb.Add(uint32(o.x))
+		return rb, cur.add(o.x)
+	case "addint":
+		rb.AddInt(int(o.x))
+		return rb, cur.add(o.x)
+	case "checkedadd":
+		if got := rb.CheckedAdd(uint32(o.x)); got != !cur.contains(o.x) {
+			fail(ht, "CheckedAdd(%d) = %v on %s", o.x, got, cur)
+		}
+		return rb, cur.add(o.x)
+	case "remove":
+		rb.Remove(uint32(o.x))
+		return rb, cur.remove(o.x, universe32)
+	case "checkedremove":
+		if got := rb.CheckedRemove(uint32(o.x)); got != cur.contains(o.x) {
+			fail(ht, "CheckedRemove(%d) = %v on %s", o.x, got, cur)
+		}
+		return rb, cur.remove(o.x, universe32)
+	case "addrange":
+		rb.AddRange(o.lo, o.hi)
+		if o.lo >= o.hi {
+			return rb, cur
+		}
+		return rb, cur.addRange(o.lo, o.hi)
+	case "removerange":
+		rb.RemoveRange(o.lo, o.hi)
+		if o.lo >= o.hi {
+			return rb, cur
+		}
+		return rb, cur.removeRange(o.lo, o.hi, universe32)
+	case "flip":
+		rb.Flip(o.lo, o.hi)
+		if o.lo >= o.hi {
+			return rb, cur
+		}
+		return rb, cur.flip(o.lo, o.hi, universe32)
+	case "flipint":
+		rb.FlipInt(int(o.lo), int(o.hi))
+		if o.lo >= o.hi {
+			return rb, cur
+		}
+		return rb, cur.flip(o.lo, o.hi, universe32)
+	case "addmany":
+		rb.AddMany(o.many)
+		for _, x := range o.many {
+			cur = cur.add(uint64(x))
+		}
+		return rb, cur
+	case "runoptimize":
+		rb.RunOptimize()
+		return rb, cur
+	case "clear":
+		rb.Clear()
+		return rb, nil
+	case "clone":
+		return rb.Clone(), cur
+	}
+	panic("unknown op " + o.kind)
+}
+
+// genBitmap builds a bitmap and its model by a random sequence of ops.
+func genBitmap(ht *hegel.T, keys []uint16) (*roaring.Bitmap, set, []op) {
+	rb := roaring.New()
+	if chance(ht, 30) {
+		rb.SetCopyOnWrite(true)
+	}
+	var cur set
+	k := n(ht, 0, 10)
+	var ops []op
+	for i := 0; i < k; i++ {
+		o := genOp(ht, keys, cur)
+		ops = append(ops, o)
+		rb, cur = apply(ht, rb, cur, o)
+	}
+	if chance(ht, 25) {
+		rb.RunOptimize()
+		ops = append(ops, op{kind: "runoptimize"})
+	}
+	return rb, cur, ops
+}
+
+// ---------------------------------------------------------------------------
+// The RoaringFormatSpec, read and written independently.
+
+const (
+	cookieNoRuns = 12346
+	cookieRuns   = 12347
+)
+
+// specContainer is one container as the format describes it.
+type specContainer struct {
+	key  uint16
+	kind byte // 'a' array, 'b' bitmap, 'r' run
+	vals set  // low 16-bit values
+}
+
+// parseSpec decodes a 32-bit roaring stream, checking every structural rule of
+// the format, and returns the set and the container kinds. It consumes exactly
+// the bytes of the bitmap and reports how many.
+func parseSpec(b []byte) (set, []specContainer, int, error) {
+	if len(b) < 4 {
+		return nil, nil, 0, fmt.Errorf("spec: %d bytes, no cookie", len(b))
+	}
+	cookie := binary.LittleEndian.Uint32(b)
+	pos := 4
+	var size int
+	var runBitmap []byte
+	hasRuns := false
+	switch {
+	case cookie&0xffff == cookieRuns:
+		hasRuns = true
+		size = int(cookie>>16) + 1
+		nb := (size + 7) / 8
+		if len(b) < pos+nb {
+			return nil, nil, 0, fmt.Errorf("spec: truncated run bitmap")
+		}
+		runBitmap = b[pos : pos+nb]
+		pos += nb
+	case cookie == cookieNoRuns:
+		if len(b) < 8 {
+			return nil, nil, 0, fmt.Errorf("spec: truncated size")
+		}
+		size = int(binary.LittleEndian.Uint32(b[4:]))
+		pos = 8
+	default:
+		return nil, nil, 0, fmt.Errorf("spec: bad cookie %d", cookie)
+	}
+	if size > 65536 {
+		return nil, nil, 0, fmt.Errorf("spec: %d containers", size)
+	}
+	if len(b) < pos+4*size {
+		return nil, nil, 0, fmt.Errorf("spec: truncated descriptive header")
+	}
+	keys := make([]uint16, size)
+	cards := make([]int, size)
+	for i := 0; i < size; i++ {
+		keys[i] = binary.LittleEndian.Uint16(b[pos:])
+		cards[i] = int(binary.LittleEndian.Uint16(b[pos+2:])) + 1
+		pos += 4
+		if i > 0 && keys[i] <= keys[i-1] {
+			return nil, nil, 0, fmt.Errorf("spec: keys not strictly increasing (%d after %d)", keys[i], keys[i-1])
+		}
+	}
+	var offsets []uint32
+	if !hasRuns || size >= 4 {
+		if len(b) < pos+4*size {
+			return nil, nil, 0, fmt.Errorf("spec: truncated offset header")
+		}
+		offsets = make([]uint32, size)
+		for i := 0; i < size; i++ {
+			offsets[i] = binary.LittleEndian.Uint32(b[pos:])
+			pos += 4
+		}
+	}
+	var out []iv
+	var conts []specContainer
+	for i := 0; i < size; i++ {
+		if offsets != nil && int(offsets[i]) != pos {
+			return nil, nil, 0, fmt.Errorf("spec: container %d at offset %d, header says %d", i, pos, offsets[i])
+		}
+		base := uint64(keys[i]) << 16
+		c := specContainer{key: keys[i]}
+		isRun := hasRuns && runBitmap[i/8]&(1<<(uint(i)%8)) != 0
+		switch {
+		case isRun:
+			c.kind = 'r'
+			if len(b) < pos+2 {
+				return nil, nil, 0, fmt.Errorf("spec: truncated run count")
+			}
+			nr := int(binary.LittleEndian.Uint16(b[pos:]))
+			pos += 2
+			if len(b) < pos+4*nr {
+				return nil, nil, 0, fmt.Errorf("spec: truncated runs")
+			}
+			var ivs []iv
+			var total int
+			var prevEnd int64 = -1
+			for j := 0; j < nr; j++ {
+				start := int64(binary.LittleEndian.Uint16(b[pos:]))
+				length := int64(binary.LittleEndian.Uint16(b[pos+2:])) + 1
+				pos += 4
+				if start <= prevEnd {
+					return nil, nil, 0, fmt.Errorf("spec: runs overlap or are not sorted in container %d", i)
+				}
+				if start+length > 65536 {
+					return nil, nil, 0, fmt.Errorf("spec: run past the container in container %d", i)
+				}
+				prevEnd = start + length - 1
+				total += int(length)
+				ivs = append(ivs, iv{uint64(start), uint64(start + length)})
+			}
+			if total != cards[i] {
+				return nil, nil, 0, fmt.Errorf("spec: run container %d holds %d values, header says %d", i, total, cards[i])
+			}
+			c.vals = norm(ivs)
+		case cards[i] <= 4096:
+			c.kind = 'a'
+			if len(b) < pos+2*cards[i] {
+				return nil, nil, 0, fmt.Errorf("spec: truncated array container")
+			}
+			var ivs []iv
+			var prev int64 = -1
+			for j := 0; j < cards[i]; j++ {
+				v := int64(binary.LittleEndian.Uint16(b[pos:]))
+				pos += 2
+				if v <= prev {
+					return nil, nil, 0, fmt.Errorf("spec: array container %d not strictly increasing", i)
+				}
+				prev = v
+				ivs = append(ivs, iv{uint64(v), uint64(v) + 1})
+			}
+			c.vals = norm(ivs)
+		default:
+			c.kind = 'b'
+			if len(b) < pos+8192 {
+				return nil, nil, 0, fmt.Errorf("spec: truncated bitmap container")
+			}
+			var ivs []iv
+			var total int
+			for w := 0; w < 1024; w++ {
+				word := binary.LittleEndian.Uint64(b[pos+8*w:])
+				total += bits.OnesCount64(word)
+				for word != 0 {
+					t := bits.TrailingZeros64(word)
+					v := uint64(w*64 + t)
+					ivs = append(ivs, iv{v, v + 1})
+					word &= word - 1
+				}
+			}
+			pos += 8192
+			if total != cards[i] {
+				return nil, nil, 0, fmt.Errorf("spec: bitmap container %d holds %d values, header says %d", i, total, cards[i])
+			}
+			c.vals = norm(ivs)
+		}
+		for _, v := range c.vals {
+			out = append(out, iv{base + v.lo, base + v.hi})
+		}
+		conts = append(conts, c)
+	}
+	return norm(out), conts, pos, nil
+}
+
+// writeSpec encodes the set following the format, choosing for each container
+// between a run container (always allowed) and the array/bitmap dictated by the
+// cardinality, as kinds says ('r' or 'x' per key; missing entries mean 'x').
+func writeSpec(s set, kinds map[uint16]byte) []byte {
+	keys := s.keysOf()
+	parts := make([]set, len(keys))
+	isRun := make([]bool, len(keys))
+	anyRun := false
+	for i, k := range keys {
+		parts[i] = s.inKey(k)
+		isRun[i] = kinds[k] == 'r'
+		anyRun = anyRun || isRun[i]
+	}
+	var buf []byte
+	put16 := func(v uint16) { buf = binary.LittleEndian.AppendUint16(buf, v) }
+	put32 := func(v uint32) { buf = binary.LittleEndian.AppendUint32(buf, v) }
+	size := len(keys)
+	if anyRun {
+		put16(cookieRuns)
+		put16(uint16(size - 1))
+		rb := make([]byte, (size+7)/8)
+		for i := range keys {
+			if isRun[i] {
+				rb[i/8] |= 1 << (uint(i) % 8)
+			}
+		}
+		buf = append(buf, rb...)
+	} else {
+		put32(cookieNoRuns)
+		put32(uint32(size))
+	}
+	for i, k := range keys {
+		put16(k)
+		put16(uint16(parts[i].card() - 1))
+	}
+	if !anyRun || size >= 4 {
+		off := len(buf) + 4*size
+		for i := range keys {
+			put32(uint32(off))
+			switch {
+			case isRun[i]:
+				off += 2 + 4*len(parts[i])
+			case parts[i].card() <= 4096:
+				off += 2 * int(parts[i].card())
+			default:
+				off += 8192
+			}
+		}
+	}
+	for i := range keys {
+		p := parts[i]
+		switch {
+		case isRun[i]:
+			put16(uint16(len(p)))
+			for _, v := range p {
+				put16(uint16(v.lo))
+				put16(uint16(v.hi - v.lo - 1))
+			}
+		case p.card() <= 4096:
+			for _, v := range p {
+				for x := v.lo; x < v.hi; x++ {
+					put16(uint16(x))
+				}
+			}
+		default:
+			words := make([]uint64, 1024)
+			for _, v := range p {
+				for x := v.lo; x < v.hi; x++ {
+					words[x/64] |= 1 << (x % 64)
+				}
+			}
+			for _, w := range words {
+				buf = binary.LittleEndian.AppendUint64(buf, w)
+			}
+		}
+	}
+	return buf
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: construction ops match the model.
+
+func TestHegelConstructionMatchesTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		rb, want, ops := genBitmap(ht, keys)
+		note(ht, "ops %v", ops)
+		check(ht, fmt.Sprintf("after %v", ops), rb, want)
+		// Contains and the integer conveniences.
+		for i := 0; i < 8; i++ {
+			x := genPoint(ht, keys)
+			if rb.Contains(uint32(x)) != want.contains(x) || rb.ContainsInt(int(x)) != want.contains(x) {
+				fail(ht, "Contains(%d) = %v on %s", x, rb.Contains(uint32(x)), want)
+			}
+		}
+		// Clone is equal and independent.
+		c := rb.Clone()
+		if !c.Equals(rb) || !rb.Equals(c) {
+			fail(ht, "Clone not Equals: %s", want)
+		}
+		x := genPoint(ht, keys)
+		c.Flip(x, x+1)
+		if rb.Equals(c) {
+			fail(ht, "flipping %d in a clone did not change equality on %s", x, want)
+		}
+		check(ht, "original after clone mutation", rb, want)
+		check(ht, "clone after flip", c, want.flip(x, x+1, universe32))
+		// String lists the values.
+		if want.card() <= 3000 {
+			var sb strings.Builder
+			sb.WriteByte('{')
+			for i, v := range want.values() {
+				if i > 0 {
+					sb.WriteByte(',')
+				}
+				sb.WriteString(strconv.FormatUint(uint64(v), 10))
+			}
+			sb.WriteByte('}')
+			if got := rb.String(); got != sb.String() {
+				fail(ht, "String() = %q, want %q", got, sb.String())
+			}
+		}
+		// RunOptimize keeps the set and never grows the serialized size.
+		before := rb.GetSerializedSizeInBytes()
+		rb.RunOptimize()
+		check(ht, "after RunOptimize", rb, want)
+		if after := rb.GetSerializedSizeInBytes(); after > before {
+			fail(ht, "RunOptimize grew the serialized size %d -> %d on %s", before, after, want)
+		}
+		// Functional Flip leaves the receiver alone.
+		lo, hi := genRange(ht, keys)
+		f := roaring.Flip(rb, lo, hi)
+		check(ht, "receiver after roaring.Flip", rb, want)
+		if lo < hi {
+			check(ht, fmt.Sprintf("roaring.Flip(%d,%d)", lo, hi), f, want.flip(lo, hi, universe32))
+		} else {
+			check(ht, fmt.Sprintf("roaring.Flip(%d,%d) (empty range)", lo, hi), f, want)
+		}
+		// Equals with other things.
+		if rb.Equals(nil) || rb.Equals(3) {
+			fail(ht, "Equals(nil) or Equals(3) is true")
+		}
+	})
+}
