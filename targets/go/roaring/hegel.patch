+// ---------------------------------------------------------------------------
+// Property 2: the set algebra.
+
+func TestHegelSetAlgebraMatchesTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		keys := genKeys(ht)
+		a, sa, opsA := genBitmap(ht, keys)
+		b, sb, opsB := genBitmap(ht, keys)
+		note(ht, "a: %v\nb: %v", opsA, opsB)
+		if chance(ht, 30) {
+			a.SetCopyOnWrite(true)
+			b.SetCopyOnWrite(true)
+		}
+		type binop struct {
+			name string
+			fn   func(x, y *roaring.Bitmap) *roaring.Bitmap
+			want set
+		}
+		ops := []binop{
+			{"Or", roaring.Or, sa.union(sb)},
+			{"And", roaring.And, sa.inter(sb)},
+			{"Xor", roaring.Xor, sa.xor(sb, universe32)},
+			{"AndNot", roaring.AndNot, sa.minus(sb, universe32)},
+			{"FastOr", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.FastOr(x, y) }, sa.union(sb)},
+			{"FastAnd", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.FastAnd(x, y) }, sa.inter(sb)},
+			{"HeapOr", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.HeapOr(x, y) }, sa.union(sb)},
+			{"HeapXor", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.HeapXor(x, y) }, sa.xor(sb, universe32)},
+			{"ParOr", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.ParOr(n(ht, 0, 3), x, y) }, sa.union(sb)},
+			{"ParAnd", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.ParAnd(n(ht, 0, 3), x, y) }, sa.inter(sb)},
+			{"ParHeapOr", func(x, y *roaring.Bitmap) *roaring.Bitmap { return roaring.ParHeapOr(n(ht, 0, 3), x, y) }, sa.union(sb)},
+		}
+		for _, o := range ops {
+			r := o.fn(a, b)
+			check(ht, o.name, r, o.want)
+			check(ht, "left operand after "+o.name, a, sa)
+			check(ht, "right operand after "+o.name, b, sb)
+			if Known.parHeapOrShares && o.name == "ParHeapOr" {
+				continue
+			}
+			// The result is independent of the operands.
+			x := genPoint(ht, keys)
+			r.Flip(x, x+1)
+			check(ht, "left operand after mutating the result of "+o.name, a, sa)
+			check(ht, "right operand after mutating the result of "+o.name, b, sb)
+			check(ht, "result of "+o.name+" after mutating it", r, o.want.flip(x, x+1, universe32))
+			y := genPoint(ht, keys)
+			a.Flip(y, y+1)
+			check(ht, "result of "+o.name+" after mutating the left operand", r, o.want.flip(x, x+1, universe32))
+			a.Flip(y, y+1)
+		}
+		// Single-input aggregates are copies.
+		for _, o := range []struct {
+			name string
+			fn   func(x *roaring.Bitmap) *roaring.Bitmap
+		}{
+			{"FastOr", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.FastOr(x) }},
+			{"FastAnd", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.FastAnd(x) }},
+			{"HeapOr", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.HeapOr(x) }},
+			{"HeapXor", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.HeapXor(x) }},
+			{"ParHeapOr", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.ParHeapOr(1, x) }},
+			{"ParOr", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.ParOr(1, x) }},
+			{"ParAnd", func(x *roaring.Bitmap) *roaring.Bitmap { return roaring.ParAnd(1, x) }},
+		} {
+			if Known.heapOrOneReturnsInput && (o.name == "HeapOr" || o.name == "HeapXor") {
+				continue
+			}
+			r := o.fn(a)
+			check(ht, o.name+"(a)", r, sa)
+			if r == a {
+				fail(ht, "%s(a) returned a itself", o.name)
+			}
+			x := genPoint(ht, keys)
+			r.Flip(x, x+1)
+			check(ht, "a after mutating "+o.name+"(a)", a, sa)
+		}
+		// Cardinalities and intersection tests.
+		if got := a.OrCardinality(b); got != sa.union(sb).card() {
+			fail(ht, "OrCardinality %d, want %d", got, sa.union(sb).card())
+		}
+		if got := a.AndCardinality(b); got != sa.inter(sb).card() {
+			fail(ht, "AndCardinality %d, want %d", got, sa.inter(sb).card())
+		}
+		if got := a.Intersects(b); got != (sa.inter(sb).card() > 0) {
+			fail(ht, "Intersects %v, want %v", got, sa.inter(sb).card() > 0)
+		}
+		if a.Equals(b) != sa.equal(sb) {
+			fail(ht, "Equals %v, want %v: %s vs %s", a.Equals(b), sa.equal(sb), sa, sb)
+		}
+		// Three-way aggregates and AndAny.
+		c, sc, opsC := genBitmap(ht, keys)
+		note(ht, "c: %v", opsC)
+		check(ht, "FastOr3", roaring.FastOr(a, b, c), sa.union(sb).union(sc))
+		check(ht, "FastAnd3", roaring.FastAnd(a, b, c), sa.inter(sb).inter(sc))
+		check(ht, "HeapOr3", roaring.HeapOr(a, b, c), sa.union(sb).union(sc))
+		check(ht, "HeapXor3", roaring.HeapXor(a, b, c), sa.xor(sb, universe32).xor(sc, universe32))
+		check(ht, "ParHeapOr3", roaring.ParHeapOr(n(ht, 0, 3), a, b, c), sa.union(sb).union(sc))
+		check(ht, "ParAnd3", roaring.ParAnd(n(ht, 0, 3), a, b, c), sa.inter(sb).inter(sc))
+		check(ht, "ParOr3", roaring.ParOr(n(ht, 0, 3), a, b, c), sa.union(sb).union(sc))
+		check(ht, "FastOr0", roaring.FastOr(), nil)
+		check(ht, "FastAnd1", roaring.FastAnd(a), sa)
+		aa := a.Clone()
+		aa.AndAny(b, c)
+		check(ht, "AndAny", aa, sa.inter(sb.union(sc)))
+		check(ht, "operands after AndAny", b, sb)
+		// In-place operations, on clones (with the receiver's copy-on-write).
+		for _, o := range []struct {
+			name string
+			fn   func(x, y *roaring.Bitmap)
+			want set
+		}{
+			{"Or", (*roaring.Bitmap).Or, sa.union(sb)},
+			{"And", (*roaring.Bitmap).And, sa.inter(sb)},
+			{"Xor", (*roaring.Bitmap).Xor, sa.xor(sb, universe32)},
+			{"AndNot", (*roaring.Bitmap).AndNot, sa.minus(sb, universe32)},
+		} {
+			x := a.Clone()
+			arg := b
+			if Known.inPlaceXorMutatesArg && o.name == "Xor" {
+				// roaring/12: the argument would be changed; hand Xor a deep copy so that b
+				// stays usable, and do not check the copy afterwards.
+				arg = b.Clone()
+				arg.CloneCopyOnWriteContainers()
+			}
+			o.fn(x, arg)
+			check(ht, "in-place "+o.name, x, o.want)
+			if arg == b {
+				check(ht, "argument after in-place "+o.name, b, sb)
+			}
+			check(ht, "clone source after in-place "+o.name, a, sa)
+			// Self-application.
+			y := a.Clone()
+			o.fn(y, y)
+			var self set
+			switch o.name {
+			case "Or", "And":
+				self = sa
+			}
+			check(ht, "in-place "+o.name+" with itself", y, self)
+		}
+	})
+}
