+// ---------------------------------------------------------------------------
+// Property 8: dense and bitset conversions.
+
+func TestHegelDenseConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Dense representations are bounded: keep the values under a few hundred thousand.
+		keys := []uint16{0, 1, uint16(n(ht, 2, 4))}
+		rb, want, ops := genBitmap(ht, keys)
+		if want.card() > 0 && want.max() >= 1<<19 {
+			rb.RemoveRange(1<<19, universe32)
+			want = want.removeRange(1<<19, universe32, universe32)
+		}
+		note(ht, "ops %v -> %s", ops, want)
+		dense := rb.ToDense()
+		if uint64(len(dense)) != rb.DenseSize() {
+			fail(ht, "ToDense has %d words, DenseSize %d", len(dense), rb.DenseSize())
+		}
+		var got []iv
+		for w, word := range dense {
+			for word != 0 {
+				t := bits.TrailingZeros64(word)
+				v := uint64(w*64 + t)
+				got = append(got, iv{v, v + 1})
+				word &= word - 1
+			}
+		}
+		if !norm(got).equal(want) {
+			fail(ht, "ToDense encodes %s, want %s", norm(got), want)
+		}
+		if want.card() > 0 && uint64(len(dense))*64 <= want.max() {
+			fail(ht, "ToDense too short: %d words for max %d", len(dense), want.max())
+		}
+		buf := make([]uint64, rb.DenseSize())
+		rb.WriteDenseTo(buf)
+		if !reflect.DeepEqual(buf, dense) && !(len(buf) == 0 && len(dense) == 0) {
+			fail(ht, "WriteDenseTo differs from ToDense")
+		}
+		// Back again, with and without copying, with a random tail of zero words.
+		padded := append(append([]uint64{}, dense...), make([]uint64, n(ht, 0, 1030))...)
+		for _, doCopy := range []bool{false, true} {
+			back := roaring.FromDense(append([]uint64{}, padded...), doCopy)
+			check(ht, fmt.Sprintf("FromDense(copy=%v)", doCopy), back, want)
+			st := back.Stats()
+			if st.RunContainers != 0 {
+				fail(ht, "FromDense produced run containers: %+v", st)
+			}
+			m := roaring.New()
+			src := append([]uint64{}, padded...)
+			m.FromDense(src, doCopy)
+			check(ht, fmt.Sprintf("Bitmap.FromDense(copy=%v)", doCopy), m, want)
+			if doCopy {
+				for i := range src {
+					src[i] = ^uint64(0)
+				}
+				check(ht, "FromDense(copy=true) after scribbling on the source", m, want)
+			}
+		}
+		// bitset.
+		bs := rb.ToBitSet()
+		var got2 []iv
+		for i, ok := bs.NextSet(0); ok; i, ok = bs.NextSet(i + 1) {
+			got2 = append(got2, iv{uint64(i), uint64(i) + 1})
+		}
+		if !norm(got2).equal(want) {
+			fail(ht, "ToBitSet encodes %s, want %s", norm(got2), want)
+		}
+		if bs.Count() != uint(want.card()) {
+			fail(ht, "ToBitSet Count %d, want %d", bs.Count(), want.card())
+		}
+		back := roaring.FromBitSet(bs)
+		check(ht, "FromBitSet", back, want)
+		var b2 bitset.BitSet
+		for _, v := range want.values() {
+			b2.Set(uint(v))
+		}
+		check(ht, "FromBitSet of a hand-built bitset", roaring.FromBitSet(&b2), want)
+	})
+}
