+package roaring_test
+
+// Property 1: construction ops match the model. A bitmap built by a record is read back
+// (Validate, Ranges with ToArray and GetCardinality, IsEmpty, Minimum/Maximum, Stats,
+// HasRunCompression) against the model, Contains and ContainsInt at eight points, a clone is
+// equal and independent (flipping a value in it changes equality and leaves the original),
+// String lists the values, RunOptimize keeps the set and the serialized size before and
+// after it is the portable format's (writeSpec) for the container kinds held and the
+// efficient kinds, the functional Flip leaves the receiver alone and gives the flipped set,
+// and Equals with other things is false. The booleans of the Checked steps of the record
+// are checks too. The shape reached: roaring/6 (a run container the record's AddRange or
+// RemoveRange left loose, or the functional Flip of a run container, fails Validate); under
+// HEGEL_NO_KNOWN=1 that Validate check is dropped.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"hegel.dev/go/hegel"
+)
+
+type constructionCase struct {
+	bm     bitmapRec
+	probes []pointRec
+	cx     pointRec
+	fr     rangeRec
+
+	p plan // the record resolved
+
+	// Read from the built bitmaps by the property before the judge runs: the container kinds
+	// of the built bitmap, and what Validate can say on it, on its clone after the flip and
+	// on the functional Flip's result; the serialized sizes before and after RunOptimize.
+	kinds                 map[uint16]byte
+	v, vClone, vFlip      validity
+	sizeBefore, sizeAfter int
+}
+
+func (c constructionCase) GoString() string {
+	lo, hi := c.fr.bounds(c.p.keys)
+	return fmt.Sprintf("%s; contains %v; clone flip %d; Flip(%d,%d)", c.p, pointValues(c.probes, c.p.keys), c.cx.value(c.p.keys), lo, hi)
+}
+
+var constructionCases = hegel.FlatMap(keyCounts, func(n int) hegel.Generator[constructionCase] {
+	points := pointRecs(n)
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) constructionCase {
+		return constructionCase{
+			bm:     hegel.Draw(tc, bitmapRecs(n)),
+			probes: hegel.Draw(tc, hzCounted(points, 8, 8)),
+			cx:     hegel.Draw(tc, points),
+			fr:     hegel.Draw(tc, rangeRecs(n)),
+		}
+	}), func(c constructionCase) constructionCase {
+		c.p = c.bm.plan()
+		return c
+	})
+})
+
+// stringKey is the text of a String() of the set, shortened when long.
+func stringKey(s string) string {
+	if len(s) <= 300 {
+		return s
+	}
+	return fmt.Sprintf("%d bytes: %s ... %s", len(s), s[:40], s[len(s)-20:])
+}
+
+// stringOf is the model's String(): the values in braces.
+func stringOf(want set) string {
+	var sb strings.Builder
+	sb.WriteByte('{')
+	for i, v := range want.values() {
+		if i > 0 {
+			sb.WriteByte(',')
+		}
+		fmt.Fprint(&sb, v)
+	}
+	sb.WriteByte('}')
+	return sb.String()
+}
+
+// efficientKinds marks the keys of s whose efficient container is a run (what RunOptimize
+// leaves), for writeSpec.
+func efficientKinds(s set) map[uint16]byte {
+	kinds := map[uint16]byte{}
+	for _, key := range s.keysOf() {
+		if efficientKind(s.inKey(key)) == 'r' {
+			kinds[key] = 'r'
+		}
+	}
+	return kinds
+}
+
+func constructionExpected(c constructionCase, k known) checks {
+	want := setOfOps(c.p.ops)
+	keys := c.p.keys
+	out := planChecks(c.p)
+	out.add("built", bitmapChecks(want, c.v.text(k)))
+	for _, x := range pointValues(c.probes, keys) {
+		out.set(fmt.Sprintf("contains(%d)", x), want.contains(x))
+	}
+	out.set("clone equals", true)
+	x := c.cx.value(keys)
+	flipped := want.flip(x, x+1, universe32)
+	out.set("clone flipped differs", true)
+	out.add("original after clone flip", bitmapChecks(want, c.v.text(k)))
+	out.add("clone after flip", bitmapChecks(flipped, c.vClone.text(k)))
+	if want.card() <= 3000 {
+		out.set("string", stringKey(stringOf(want)))
+	}
+	out.set("size before RunOptimize", c.sizeBefore)
+	// RunOptimize makes every container its efficient kind: nothing left for Validate.
+	out.add("after RunOptimize", bitmapChecks(want, "ok"))
+	out.set("size after RunOptimize", c.sizeAfter)
+	lo, hi := c.fr.bounds(keys)
+	out.add("receiver after Flip", bitmapChecks(want, "ok"))
+	f := want
+	if lo < hi {
+		f = want.flip(lo, hi, universe32)
+	}
+	out.add(fmt.Sprintf("Flip(%d,%d)", lo, hi), bitmapChecks(f, c.vFlip.text(k)))
+	out.set("equals other", false)
+	return out
+}
+
+// constructionActual asks the library, reading the container kinds (and what Validate can
+// say on them, and the sizes the format gives) into the case as it goes.
+func constructionActual(c *constructionCase) checks {
+	keys := c.p.keys
+	want := setOfOps(c.p.ops)
+	rb, got := build(c.p)
+	c.kinds = kindsOf(rb)
+	c.v = validityOf(c.kinds, want, nil)
+	got.add("built", readBitmap(rb))
+	for _, x := range pointValues(c.probes, keys) {
+		a, b := rb.Contains(uint32(x)), rb.ContainsInt(int(x))
+		if a != b {
+			got.set(fmt.Sprintf("contains(%d)", x), fmt.Sprintf("Contains %v, ContainsInt %v", a, b))
+		} else {
+			got.set(fmt.Sprintf("contains(%d)", x), a)
+		}
+	}
+	cl := rb.Clone()
+	got.set("clone equals", cl.Equals(rb) && rb.Equals(cl))
+	x := c.cx.value(keys)
+	cl.Flip(x, x+1)
+	got.set("clone flipped differs", !rb.Equals(cl))
+	c.vClone = validityOf(kindsOf(cl), want.flip(x, x+1, universe32), nil)
+	got.add("original after clone flip", readBitmap(rb))
+	got.add("clone after flip", readBitmap(cl))
+	if rb.GetCardinality() <= 3000 {
+		got.set("string", stringKey(rb.String()))
+	}
+	got.set("size before RunOptimize", rb.GetSerializedSizeInBytes())
+	c.sizeBefore = len(writeSpec(want, c.kinds))
+	rb.RunOptimize()
+	got.add("after RunOptimize", readBitmap(rb))
+	got.set("size after RunOptimize", rb.GetSerializedSizeInBytes())
+	c.sizeAfter = len(writeSpec(want, efficientKinds(want)))
+	lo, hi := c.fr.bounds(keys)
+	f := roaring.Flip(rb, lo, hi)
+	fs := want
+	if lo < hi {
+		fs = want.flip(lo, hi, universe32)
+	}
+	c.vFlip = validityOf(kindsOf(f), fs, nil)
+	got.add("receiver after Flip", readBitmap(rb))
+	got.add(fmt.Sprintf("Flip(%d,%d)", lo, hi), readBitmap(f))
+	got.set("equals other", rb.Equals(nil) || rb.Equals(3))
+	return got
+}
+
+func TestHegelConstructionMatchesTheModel(t *testing.T) {
+	judged(t, constructionCases, func(j *hzCaseJudge, c constructionCase) {
+		got := constructionActual(&c)
+		dry, _ := dryReplay(c.p)
+		kindsAgree(j.col, "built", dry, c.kinds, c.p)
+		judgeByDropping(j, c, constructionExpected, func(constructionCase) checks { return got })
+	})
+}
diff --git a/hegel_zoo_idioms_test.go b/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..aa94141
--- /dev/null
+++ b/hegel_zoo_idioms_test.go
@@ -0,0 +1,552 @@
+package roaring_test
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf and
+// go/kong harness (hegel_idioms_test.go / hegel_zoo_idioms_test.go there; go/bubbles'
+// internal/zootest/gen.go before them) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (ROARING_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin, where hzDie(3) realised its last
+// face at 12 to 27 percent instead of 33) halve a range by fair bits, and the figure beside
+// every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].gen
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].gen
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var gens []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			gens = append(gens, hegel.Just(vs[i]))
+		} else {
+			gens = append(gens, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(gens)), func(i int) hegel.Generator[T] { return gens[i] })
+	}
+	choices := make([]hzChoice[T], len(gens))
+	for i, g := range gens {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
diff --git a/hegel_zoo_iterators_test.go b/hegel_zoo_iterators_test.go
new file mode 100644
index 0000000..893f76c
--- /dev/null
+++ b/hegel_zoo_iterators_test.go
@@ -0,0 +1,459 @@
+package roaring_test
+
+// Property 4: the iterators walk the set. The forward iterator with peeks and advances
+// (every step's HasNext, PeekNext, AdvanceIfNeeded or Next against the model's next value),
+// Values, ReverseIterator and Backward (full walks when the set is small, prefixes of 150000
+// values otherwise), ManyIterator with NextMany/NextMany64 in buffers of varying sizes (and
+// nothing after the end), Iterate visiting each value once and stopping on false, the unset
+// iterator over a bounded window (PeekNext checked at every step; a tenth of the windows
+// inverted, which yield nothing) and Unset over the same window, and Ranges. The shape
+// reached: roaring/3 (the unset iterator over a bitmap container yields present values) and
+// roaring/6 on the record's own loose runs; under HEGEL_NO_KNOWN=1 those checks are dropped.
+// readBitmap and bitmapChecks, the reading of a bitmap the four wide properties share, are
+// here too.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"hegel.dev/go/hegel"
+)
+
+// readBitmap reads a bitmap back as checks: Validate's text ("ok" for nil), the set through
+// Ranges (cross-checked by GetCardinality and, when small, ToArray: setOf), IsEmpty,
+// Minimum/Maximum (which panic on an empty bitmap by contract, so they are read only when
+// IsEmpty is false, and a panic is the value "panic"), the consistency of Stats (its
+// cardinality, container count, count by kind and values by kind) and HasRunCompression
+// against the run-container count.
+func readBitmap(rb *roaring.Bitmap) checks {
+	c := checks{}
+	c.set("validate", errText(rb.Validate()))
+	if s, err := readSet(rb); err != nil {
+		c.set("set", "error: "+err.Error())
+	} else {
+		c.set("set", setKey(s))
+	}
+	empty := rb.IsEmpty()
+	c.set("empty", empty)
+	minmax := "-"
+	if !empty {
+		if r := hzCatch(func() { minmax = fmt.Sprintf("%d/%d", rb.Minimum(), rb.Maximum()) }); r != nil {
+			minmax = "panic"
+		}
+	}
+	c.set("minmax", minmax)
+	st := rb.Stats()
+	c.set("stats", statsText(st.Cardinality, st.Containers, st.ArrayContainers+st.BitmapContainers+st.RunContainers, st.ArrayContainerValues+st.BitmapContainerValues+st.RunContainerValues))
+	c.set("runs", rb.HasRunCompression() == (st.RunContainers > 0))
+	return c
+}
+
+// readSet is the set a bitmap holds, read through Ranges (sorted, merged, within the
+// universe) and checked against GetCardinality and, for sets of at most 200000 values,
+// ToArray, as the older setOf did; the ToArray comparison walks the intervals without
+// building the value list (the algebra property reads some seventy bitmaps a case).
+func readSet(rb *roaring.Bitmap) (set, error) {
+	var out []iv
+	var last uint64
+	first := true
+	for lo, hi := range rb.Ranges() {
+		if uint64(lo) >= hi || hi > universe32 {
+			return nil, fmt.Errorf("Ranges yielded [%d, %d)", lo, hi)
+		}
+		if !first && uint64(lo) <= last {
+			return nil, fmt.Errorf("Ranges yielded [%d, %d) after an end of %d (not sorted or not merged)", lo, hi, last)
+		}
+		first = false
+		last = hi
+		out = append(out, iv{uint64(lo), hi})
+	}
+	s := norm(out)
+	if c := rb.GetCardinality(); c != s.card() {
+		return nil, fmt.Errorf("GetCardinality %d but Ranges cover %d values", c, s.card())
+	}
+	if s.card() <= 200000 {
+		got := rb.ToArray()
+		ok := uint64(len(got)) == s.card()
+		i := 0
+		for _, v := range s {
+			for x := v.lo; ok && x < v.hi; x++ {
+				if got[i] != uint32(x) {
+					ok = false
+				}
+				i++
+			}
+		}
+		if !ok {
+			return nil, fmt.Errorf("ToArray %s but Ranges give %s", short32(got), s)
+		}
+	}
+	return s, nil
+}
+
+func statsText(card, containers, byKind, values uint64) string {
+	return fmt.Sprintf("card %d, %d containers, %d by kind, %d values", card, containers, byKind, values)
+}
+
+// bitmapChecks is the model's statement of readBitmap on a bitmap holding s whose Validate
+// says validate: one container per key the set touches.
+func bitmapChecks(s set, validate string) checks {
+	c := checks{}
+	c.set("validate", validate)
+	c.set("set", setKey(s))
+	c.set("empty", s.card() == 0)
+	if s.card() > 0 {
+		c.set("minmax", fmt.Sprintf("%d/%d", s.min(), s.max()))
+	} else {
+		c.set("minmax", "-")
+	}
+	n := s.keyCount()
+	c.set("stats", statsText(s.card(), n, n, s.card()))
+	c.set("runs", true)
+	return c
+}
+
+// ---------------------------------------------------------------------------
+
+const iterLimit = 150000
+
+// stepRec is one step of the forward walk: PeekNext (a fifth), AdvanceIfNeeded to a point
+// (a fifth), or Next.
+type stepRec struct {
+	kind int
+	p    pointRec
+}
+
+// walkRec is the forward walk: count steps (min(card, 300) plus 0 to 3) whose kinds and
+// advance points are expanded from one seed by a splitmix64 stream, peek/advance/next at
+// 20/20/60 and the advance point as pointRecs draws it (the key index evenly, the
+// alternative 20/20/60, the low bits by alternative): one engine draw for the whole walk. A
+// list of up to 303 dice was some 2000 choices a case, and the shrinker of a failure replayed
+// them some 17000 times (168 s to reach a two-value example, 300 s and its cap for a bitmap
+// container); no recorded bug depends on which step is which, and the walk's own failures
+// would be read off the transcript.
+type walkRec struct {
+	seed  int
+	count int
+}
+
+func (w walkRec) steps(nkeys int) []stepRec {
+	x := uint64(w.seed)
+	next := func() uint64 {
+		x += 0x9e3779b97f4a7c15
+		z := x
+		z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
+		z = (z ^ (z >> 27)) * 0x94d049bb133111eb
+		return z ^ (z >> 31)
+	}
+	out := make([]stepRec, w.count)
+	for i := range out {
+		kind := min(int(next()%5), 2)
+		st := stepRec{kind: kind}
+		if kind == 1 {
+			r := next()
+			st.p = pointRec{ki: int(r % uint64(max(nkeys, 1)))}
+			switch (r >> 8) % 5 {
+			case 0:
+				st.p.alt, st.p.v = 0, int((r>>16)%6)
+			case 1:
+				st.p.alt, st.p.v = 1, int((r>>16)%101)
+			default:
+				st.p.alt, st.p.v = 2, int((r>>16)%65536)
+			}
+		}
+		out[i] = st
+	}
+	return out
+}
+
+var manySizes = []int{1, 2, 3, 7, 64, 1000, 4096, 5000}
+
+type iteratorsCase struct {
+	bm     bitmapRec
+	walk   walkRec
+	sizes  []int // NextMany buffer sizes, cycled
+	hs     int
+	use64  bool
+	window rangeRec
+	swap   bool
+	stop   int
+
+	p plan
+
+	kinds map[uint16]byte
+	v     validity
+}
+
+func (c iteratorsCase) GoString() string {
+	want := setOfOps(c.p.ops)
+	lo, hi := c.windowBounds()
+	return fmt.Sprintf("%s; %d steps (seed %d); buffers %v; mask %d<<32 (%v); unset window [%d,%d); stop %d", c.p, c.walk.count, c.walk.seed, c.sizes, c.hs, c.use64, lo, hi, c.stopAt(want.card()))
+}
+
+// The steps as the older property drew them: min(card, 300) plus 0 to 3 of them, each
+// peek/advance/next at 20/20/60 (walkRec: the expansion realises 20/20/60); use64 50:
+// dieCoin(50) realises 50; swap 10: dieCoin(10) realises 10.
+var iteratorsCases = hegel.FlatMap(keyCounts, func(n int) hegel.Generator[iteratorsCase] {
+	return hegel.FlatMap(bitmapRecs(n), func(bm bitmapRec) hegel.Generator[iteratorsCase] {
+		p := bm.plan()
+		card := int(min(setOfOps(p.ops).card(), 300))
+		return hegel.Composite(func(tc hegel.TestCase) iteratorsCase {
+			return iteratorsCase{
+				bm:     bm,
+				p:      p,
+				walk:   walkRec{seed: hegel.Draw(tc, hegel.Integers(0, 1<<31-1)), count: card + hegel.Draw(tc, hegel.Integers(0, 3))},
+				sizes:  hegel.Draw(tc, countedHalves(evenHalves(manySizes...), 1, 6)),
+				hs:     hegel.Draw(tc, hegel.Integers(0, 1000)),
+				use64:  hegel.Draw(tc, dieCoin(50)),
+				window: hegel.Draw(tc, rangeRecs(n)),
+				swap:   hegel.Draw(tc, dieCoin(10)),
+				stop:   hegel.Draw(tc, hegel.Integers(0, 1<<30-1)),
+			}
+		})
+	})
+})
+
+// windowBounds is the unset window: the range capped at iterLimit values, a tenth inverted.
+func (c iteratorsCase) windowBounds() (uint64, uint64) {
+	lo, hi := c.window.bounds(c.p.keys)
+	if lo < hi && hi-lo > iterLimit {
+		hi = lo + iterLimit
+	}
+	if c.swap {
+		lo, hi = hi, lo
+	}
+	return lo, hi
+}
+
+func (c iteratorsCase) stopAt(card uint64) int {
+	return int(uint64(c.stop) % (min(card, 1<<30) + 1))
+}
+
+func iteratorsExpected(c iteratorsCase, k known) checks {
+	want := setOfOps(c.p.ops)
+	card := want.card()
+	keys := c.p.keys
+	out := planChecks(c.p)
+	out.add("built", bitmapChecks(want, c.v.text(k)))
+	var sb strings.Builder
+	pos := int64(0)
+	for _, st := range c.walk.steps(len(keys)) {
+		next := want.nextValue(uint64(pos))
+		fmt.Fprintf(&sb, "H%v ", next >= 0)
+		if next < 0 {
+			break
+		}
+		switch st.kind {
+		case 0:
+			fmt.Fprintf(&sb, "P%d ", next)
+		case 1:
+			m := st.p.value(keys)
+			fmt.Fprintf(&sb, "A%d ", m)
+			if int64(m) > next {
+				pos = int64(m)
+			}
+		default:
+			fmt.Fprintf(&sb, "N%d ", next)
+			pos = next + 1
+		}
+	}
+	out.set("forward", sb.String())
+	n := int(min(card, iterLimit))
+	fwKey := listKey(want.firstN(n))
+	bwKey := listKey(want.lastN(n))
+	out.set("values", fwKey)
+	out.set("reverse", bwKey)
+	out.set("backward", bwKey)
+	out.set("many", fwKey)
+	out.set("many counts", "ok")
+	if n == int(card) {
+		out.set("many after end", 0)
+	}
+	if card <= iterLimit {
+		out.set("iterate", "ok")
+		stop := c.stopAt(card)
+		cnt := min(stop, int(card))
+		if stop == 0 && card > 0 {
+			cnt = 1
+		}
+		out.set(fmt.Sprintf("iterate stop %d", stop), cnt)
+	}
+	lo, hi := c.windowBounds()
+	u := unsetValues(want, c.kinds, lo, hi, k)
+	out.set(fmt.Sprintf("unset(%d,%d)", lo, hi), listKey(u))
+	out.set("unset peeks", "ok")
+	if lo < hi && hi <= universe32 {
+		out.set(fmt.Sprintf("Unset(%d,%d)", lo, hi-1), listKey(u))
+	}
+	out.set("ranges", setKey(want))
+	return out
+}
+
+func iteratorsActual(c *iteratorsCase) checks {
+	want := setOfOps(c.p.ops)
+	card := want.card()
+	keys := c.p.keys
+	rb, got := build(c.p)
+	c.kinds = kindsOf(rb)
+	c.v = validityOf(c.kinds, want, nil)
+	got.add("built", readBitmap(rb))
+	{
+		it := rb.Iterator()
+		var sb strings.Builder
+		for _, st := range c.walk.steps(len(keys)) {
+			has := it.HasNext()
+			fmt.Fprintf(&sb, "H%v ", has)
+			if !has {
+				break
+			}
+			switch st.kind {
+			case 0:
+				fmt.Fprintf(&sb, "P%d ", it.PeekNext())
+			case 1:
+				m := st.p.value(keys)
+				it.AdvanceIfNeeded(uint32(m))
+				fmt.Fprintf(&sb, "A%d ", m)
+			default:
+				fmt.Fprintf(&sb, "N%d ", it.Next())
+			}
+		}
+		got.set("forward", sb.String())
+	}
+	n := int(min(card, iterLimit))
+	{
+		var vals []uint64
+		for x := range roaring.Values(rb) {
+			vals = append(vals, uint64(x))
+			if len(vals) == n {
+				break
+			}
+		}
+		got.set("values", listKey(vals))
+	}
+	{
+		var vals []uint64
+		it := rb.ReverseIterator()
+		for it.HasNext() && len(vals) < n {
+			vals = append(vals, uint64(it.Next()))
+		}
+		got.set("reverse", listKey(vals))
+		vals = nil
+		for x := range roaring.Backward(rb) {
+			vals = append(vals, uint64(x))
+			if len(vals) == n {
+				break
+			}
+		}
+		got.set("backward", listKey(vals))
+	}
+	{
+		it := rb.ManyIterator()
+		var vals []uint64
+		hs := uint64(c.hs) << 32
+		counts := "ok"
+		for i := 0; len(vals) < n; i++ {
+			sz := c.sizes[i%len(c.sizes)]
+			var m int
+			if c.use64 {
+				buf := make([]uint64, sz)
+				m = it.NextMany64(hs, buf)
+				for _, v := range buf[:max(min(m, sz), 0)] {
+					if v&hs != hs {
+						counts = fmt.Sprintf("NextMany64 value %x lacks the mask %x", v, hs)
+					}
+					vals = append(vals, v&^hs)
+				}
+			} else {
+				buf := make([]uint32, sz)
+				m = it.NextMany(buf)
+				for _, v := range buf[:max(min(m, sz), 0)] {
+					vals = append(vals, uint64(v))
+				}
+			}
+			if m == 0 {
+				break
+			}
+			if m > sz || m < 0 {
+				counts = fmt.Sprintf("NextMany returned %d for a buffer of %d", m, sz)
+				break
+			}
+		}
+		if len(vals) > n {
+			vals = vals[:n]
+		}
+		got.set("many", listKey(vals))
+		got.set("many counts", counts)
+		if n == int(card) {
+			buf := make([]uint32, 4)
+			got.set("many after end", it.NextMany(buf))
+		}
+	}
+	if card <= iterLimit {
+		seen := make(map[uint32]int)
+		rb.Iterate(func(x uint32) bool { seen[x]++; return true })
+		iterate := "ok"
+		if uint64(len(seen)) != card {
+			iterate = fmt.Sprintf("%d distinct values visited", len(seen))
+		} else {
+			for x, cnt := range seen {
+				if cnt != 1 || !want.contains(uint64(x)) {
+					iterate = fmt.Sprintf("%d visited %d times (in set: %v)", x, cnt, want.contains(uint64(x)))
+					break
+				}
+			}
+		}
+		got.set("iterate", iterate)
+		stop := c.stopAt(card)
+		cnt := 0
+		rb.Iterate(func(x uint32) bool { cnt++; return cnt < stop })
+		got.set(fmt.Sprintf("iterate stop %d", stop), cnt)
+	}
+	lo, hi := c.windowBounds()
+	{
+		it := rb.UnsetIterator(lo, hi)
+		var vals []uint64
+		peeks := "ok"
+		for it.HasNext() {
+			p := it.PeekNext()
+			x := it.Next()
+			if p != x && peeks == "ok" {
+				peeks = fmt.Sprintf("PeekNext %d before Next %d", p, x)
+			}
+			vals = append(vals, uint64(x))
+			if len(vals) > iterLimit {
+				vals = append(vals, 0)
+				break
+			}
+		}
+		got.set(fmt.Sprintf("unset(%d,%d)", lo, hi), listKey(vals))
+		got.set("unset peeks", peeks)
+	}
+	if lo < hi && hi <= universe32 {
+		var vals []uint64
+		for x := range roaring.Unset(rb, uint32(lo), uint32(hi-1)) {
+			vals = append(vals, uint64(x))
+			if len(vals) > iterLimit {
+				vals = append(vals, 0)
+				break
+			}
+		}
+		got.set(fmt.Sprintf("Unset(%d,%d)", lo, hi-1), listKey(vals))
+	}
+	if s, err := setOf(rb); err != nil {
+		got.set("ranges", "error: "+err.Error())
+	} else {
+		got.set("ranges", setKey(s))
+	}
+	return got
+}
+
+func TestHegelIteratorsWalkTheSet(t *testing.T) {
+	judged(t, iteratorsCases, func(j *hzCaseJudge, c iteratorsCase) {
+		got := iteratorsActual(&c)
+		dry, _ := dryReplay(c.p)
+		kindsAgree(j.col, "built", dry, c.kinds, c.p)
+		judgeByDropping(j, c, iteratorsExpected, func(iteratorsCase) checks { return got })
+	})
+}
diff --git a/hegel_zoo_model_test.go b/hegel_zoo_model_test.go
new file mode 100644
index 0000000..5e4fd13
--- /dev/null
+++ b/hegel_zoo_model_test.go
@@ -0,0 +1,833 @@
+package roaring_test
+
+// The model: a set of integers as sorted, disjoint, non-adjacent half-open intervals [lo, hi)
+// of uint64 (moved here from hegel_test.go, which keeps using it), the text keys of sets and
+// value lists the checks compare, the container kinds read from the library's bytes and the
+// rules of the kinds the library chooses, and the replicas of the recorded bugs the four wide
+// properties reach: Validate's verdict on the containers a bitmap holds (roaring/6, 9), and
+// the absent-value queries and the unset iterator (roaring/1, 2, 3), each a pure function of
+// the model, the kinds and the switch set.
+
+import (
+	"encoding/binary"
+	"fmt"
+	"hash/fnv"
+	"math/bits"
+	"sort"
+
+	"github.com/RoaringBitmap/roaring/v2"
+)
+
+type iv struct{ lo, hi uint64 }
+
+type set []iv
+
+const universe32 = uint64(1) << 32
+
+func norm(ivs []iv) set {
+	var out set
+	for _, x := range ivs {
+		if x.lo < x.hi {
+			out = append(out, x)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].lo < out[j].lo })
+	w := 0
+	for i := 0; i < len(out); i++ {
+		if w > 0 && out[i].lo <= out[w-1].hi {
+			if out[i].hi > out[w-1].hi {
+				out[w-1].hi = out[i].hi
+			}
+			continue
+		}
+		out[w] = out[i]
+		w++
+	}
+	return out[:w]
+}
+
+func (s set) union(t set) set { return norm(append(append([]iv{}, s...), t...)) }
+
+func (s set) inter(t set) set {
+	var out []iv
+	i, j := 0, 0
+	for i < len(s) && j < len(t) {
+		lo := max(s[i].lo, t[j].lo)
+		hi := min(s[i].hi, t[j].hi)
+		if lo < hi {
+			out = append(out, iv{lo, hi})
+		}
+		if s[i].hi < t[j].hi {
+			i++
+		} else {
+			j++
+		}
+	}
+	return norm(out)
+}
+
+func (s set) complement(uni uint64) set {
+	var out []iv
+	prev := uint64(0)
+	for _, x := range s {
+		if x.lo > prev {
+			out = append(out, iv{prev, x.lo})
+		}
+		prev = x.hi
+	}
+	if prev < uni {
+		out = append(out, iv{prev, uni})
+	}
+	return norm(out)
+}
+
+func (s set) minus(t set, uni uint64) set { return s.inter(t.complement(uni)) }
+
+func (s set) xor(t set, uni uint64) set { return s.minus(t, uni).union(t.minus(s, uni)) }
+
+func (s set) addRange(lo, hi uint64) set { return s.union(set{{lo, hi}}) }
+
+func (s set) removeRange(lo, hi uint64, uni uint64) set { return s.minus(set{{lo, hi}}, uni) }
+
+func (s set) flip(lo, hi uint64, uni uint64) set { return s.xor(set{{lo, hi}}, uni) }
+
+func (s set) add(x uint64) set { return s.addRange(x, x+1) }
+
+func (s set) remove(x uint64, uni uint64) set { return s.removeRange(x, x+1, uni) }
+
+func (s set) card() uint64 {
+	var c uint64
+	for _, x := range s {
+		c += x.hi - x.lo
+	}
+	return c
+}
+
+func (s set) contains(x uint64) bool {
+	i := sort.Search(len(s), func(i int) bool { return s[i].hi > x })
+	return i < len(s) && s[i].lo <= x
+}
+
+func (s set) min() uint64 { return s[0].lo }
+
+func (s set) max() uint64 { return s[len(s)-1].hi - 1 }
+
+// rank counts the values <= x.
+func (s set) rank(x uint64) uint64 {
+	var c uint64
+	for _, v := range s {
+		if v.lo > x {
+			break
+		}
+		c += min(v.hi, x+1) - v.lo
+	}
+	return c
+}
+
+// selectAt returns the k-th value (0-based); ok is false past the end.
+func (s set) selectAt(k uint64) (uint64, bool) {
+	for _, v := range s {
+		if k < v.hi-v.lo {
+			return v.lo + k, true
+		}
+		k -= v.hi - v.lo
+	}
+	return 0, false
+}
+
+// nextValue is the smallest value >= t, or -1.
+func (s set) nextValue(t uint64) int64 {
+	for _, v := range s {
+		if v.hi > t {
+			return int64(max(v.lo, t))
+		}
+	}
+	return -1
+}
+
+// prevValue is the largest value <= t, or -1.
+func (s set) prevValue(t uint64) int64 {
+	r := int64(-1)
+	for _, v := range s {
+		if v.lo > t {
+			break
+		}
+		r = int64(min(v.hi-1, t))
+	}
+	return r
+}
+
+func (s set) cardInRange(lo, hi uint64) uint64 {
+	if lo >= hi {
+		return 0
+	}
+	return s.inter(set{{lo, hi}}).card()
+}
+
+// values materializes the set (the caller keeps the cardinality small).
+func (s set) values() []uint32 {
+	out := make([]uint32, 0, s.card())
+	for _, v := range s {
+		for x := v.lo; x < v.hi; x++ {
+			out = append(out, uint32(x))
+		}
+	}
+	return out
+}
+
+func (s set) values64() []uint64 {
+	out := make([]uint64, 0, s.card())
+	for _, v := range s {
+		for x := v.lo; x < v.hi; x++ {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// firstN lists the smallest k values.
+func (s set) firstN(k int) []uint64 {
+	var out []uint64
+	for _, v := range s {
+		for x := v.lo; x < v.hi && len(out) < k; x++ {
+			out = append(out, x)
+		}
+		if len(out) == k {
+			break
+		}
+	}
+	return out
+}
+
+// lastN lists the largest k values, descending.
+func (s set) lastN(k int) []uint64 {
+	var out []uint64
+	for i := len(s) - 1; i >= 0; i-- {
+		v := s[i]
+		for x := v.hi; x > v.lo && len(out) < k; x-- {
+			out = append(out, x-1)
+		}
+		if len(out) == k {
+			break
+		}
+	}
+	return out
+}
+
+// shift adds off to every value and drops what leaves [0, uni).
+func (s set) shift(off int64, uni uint64) set {
+	var out []iv
+	for _, v := range s {
+		lo := int64(v.lo) + off
+		hi := int64(v.hi) + off
+		if hi <= 0 || lo >= int64(uni) {
+			continue
+		}
+		out = append(out, iv{uint64(max(lo, 0)), uint64(min(hi, int64(uni)))})
+	}
+	return norm(out)
+}
+
+func (s set) equal(t set) bool {
+	if len(s) != len(t) {
+		return false
+	}
+	for i := range s {
+		if s[i] != t[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func (s set) String() string {
+	if len(s) > 12 {
+		return fmt.Sprintf("%d intervals, card %d, %v ... %v", len(s), s.card(), s[:6], s[len(s)-3:])
+	}
+	return fmt.Sprintf("%v (card %d)", []iv(s), s.card())
+}
+
+// keysOf lists the 16-bit container keys the set touches (32-bit sets).
+func (s set) keysOf() []uint16 {
+	var keys []uint16
+	for _, v := range s {
+		for k := v.lo >> 16; k <= (v.hi-1)>>16; k++ {
+			if len(keys) == 0 || keys[len(keys)-1] != uint16(k) {
+				keys = append(keys, uint16(k))
+			}
+		}
+	}
+	return keys
+}
+
+// inKey is the part of the set within container key k, as low 16-bit values.
+func (s set) inKey(k uint16) set {
+	base := uint64(k) << 16
+	end := base + 65536
+	i := sort.Search(len(s), func(i int) bool { return s[i].hi > base })
+	var out set
+	for ; i < len(s) && s[i].lo < end; i++ {
+		out = append(out, iv{max(s[i].lo, base) - base, min(s[i].hi, end) - base})
+	}
+	return out
+}
+
+// keyCount is the number of container keys the set touches (keysOf's length, without the
+// list: a set of one interval can touch all 65536 keys).
+func (s set) keyCount() uint64 {
+	var n uint64
+	last := int64(-1)
+	for _, v := range s {
+		lo, hi := int64(v.lo>>16), int64((v.hi-1)>>16)
+		if lo <= last {
+			lo = last + 1
+		}
+		if hi >= lo {
+			n += uint64(hi - lo + 1)
+			last = hi
+		}
+	}
+	return n
+}
+
+// firstKeyFrom is the smallest container key at or above k the set touches.
+func (s set) firstKeyFrom(k uint16) (uint16, bool) {
+	base := uint64(k) << 16
+	i := sort.Search(len(s), func(i int) bool { return s[i].hi > base })
+	if i == len(s) {
+		return 0, false
+	}
+	if s[i].lo >= base {
+		return uint16(s[i].lo >> 16), true
+	}
+	return k, true
+}
+
+// lastKeyTo is the largest container key at or below k the set touches.
+func (s set) lastKeyTo(k uint16) (uint16, bool) {
+	end := (uint64(k) + 1) << 16
+	j := sort.Search(len(s), func(i int) bool { return s[i].lo >= end }) - 1
+	if j < 0 {
+		return 0, false
+	}
+	if s[j].hi > uint64(k)<<16 {
+		return k, true
+	}
+	return uint16((s[j].hi - 1) >> 16), true
+}
+
+// hasKey reports whether the set touches the container key.
+func (s set) hasKey(k uint16) bool {
+	key, ok := s.firstKeyFrom(k)
+	return ok && key == k
+}
+
+// ---------------------------------------------------------------------------
+// Text keys of sets and value lists (the checks are text compared exactly; a long list is
+// its length, ends and FNV hash).
+
+func setKey(s set) string {
+	if len(s) <= 40 {
+		return fmt.Sprintf("%v (card %d)", []iv(s), s.card())
+	}
+	h := fnv.New64a()
+	var buf [16]byte
+	for _, v := range s {
+		binary.LittleEndian.PutUint64(buf[:8], v.lo)
+		binary.LittleEndian.PutUint64(buf[8:], v.hi)
+		h.Write(buf[:])
+	}
+	return fmt.Sprintf("%d intervals, card %d, %v ... %v, fnv %x", len(s), s.card(), s[:4], s[len(s)-2:], h.Sum64())
+}
+
+func listKey(xs []uint64) string {
+	if len(xs) <= 40 {
+		return fmt.Sprint(xs)
+	}
+	h := fnv.New64a()
+	var buf [8]byte
+	for _, x := range xs {
+		binary.LittleEndian.PutUint64(buf[:], x)
+		h.Write(buf[:])
+	}
+	return fmt.Sprintf("%v ... %v (%d values, fnv %x)", xs[:8], xs[len(xs)-4:], len(xs), h.Sum64())
+}
+
+// errText is the text of a Validate error, "ok" for nil.
+func errText(err error) string {
+	if err == nil {
+		return "ok"
+	}
+	return err.Error()
+}
+
+// ---------------------------------------------------------------------------
+// Container kinds: read from the library's portable bytes (the live kinds the wide
+// properties judge with) and predicted dryly from a record (dryReplay in
+// hegel_zoo_bitmaps_test.go: the narrow properties' classifier runs before the library is
+// called; the wide ones count the agreement of the two).
+
+// kindsOf reads the kind of every container of rb from its portable serialization ('a'
+// array, 'b' bitmap, 'r' run, by key), through the spec parser of hegel_test.go; nil (and a
+// "kinds unreadable" count) when the bytes do not parse.
+func kindsOf(rb *roaring.Bitmap) map[uint16]byte {
+	// The frozen format (serialization_littleendian.go, FreezeTo) writes every container
+	// as it is, bitmap containers of 4096 values or fewer included (ToBytes refuses those:
+	// "refusing to write bitmap container with cardinality of array container", a
+	// consequence of roaring/9), and ends with the keys, the cardinalities less one, the
+	// types (1 bitmap, 2 array, 3 run) and a 4-byte header of the cookie and the container
+	// count shifted by 15.
+	data, err := rb.Freeze()
+	if err != nil || len(data) < 4 {
+		hzTally("kinds unreadable")
+		return nil
+	}
+	n := int(binary.LittleEndian.Uint32(data[len(data)-4:]) >> 15)
+	if len(data) < 4+5*n {
+		hzTally("kinds unreadable")
+		return nil
+	}
+	types := data[len(data)-4-n : len(data)-4]
+	keys := data[len(data)-4-5*n : len(data)-4-3*n]
+	kinds := make(map[uint16]byte, n)
+	for i := 0; i < n; i++ {
+		kind := byte(0)
+		switch types[i] {
+		case 1:
+			kind = 'b'
+		case 2:
+			kind = 'a'
+		case 3:
+			kind = 'r'
+		}
+		kinds[binary.LittleEndian.Uint16(keys[2*i:])] = kind
+	}
+	return kinds
+}
+
+// withKind is the kinds with one key's kind replaced (0 removes it), the map copied.
+func withKind(kinds map[uint16]byte, key uint16, kind byte) map[uint16]byte {
+	out := make(map[uint16]byte, len(kinds)+1)
+	for k, v := range kinds {
+		out[k] = v
+	}
+	if kind == 0 {
+		delete(out, key)
+	} else {
+		out[key] = kind
+	}
+	return out
+}
+
+// looseRun is runContainer16.validate's size rule (runcontainer.go validate, the same
+// figures as toEfficientContainer): a run container of n intervals and card values is
+// accepted only when 2+4n bytes is below both the bitmap container (8224 bytes:
+// bitmapContainerSizeInBytes) and the array container (2*card bytes).
+func looseRun(part set) bool {
+	return 2+4*len(part) >= min(8224, 2*int(part.card()))
+}
+
+// efficientKind is toEfficientContainer: a run when its size rule holds, else an array of at
+// most 4096 values, else a bitmap; 0 for an empty part (the container is removed).
+func efficientKind(part set) byte {
+	switch {
+	case part.card() == 0:
+		return 0
+	case !looseRun(part):
+		return 'r'
+	case part.card() <= 4096:
+		return 'a'
+	}
+	return 'b'
+}
+
+// kindAfterFlip is the kind of a container after an in-place Flip of some of its values left
+// it holding after (roaring.go Flip: an absent key gets rangeOfOnes, an array converts to a
+// bitmap above 4096 values (arrayContainer.inot), a bitmap to an array at 4096 or fewer
+// (bitmapContainer.inot), a run to its efficient kind (runContainer16.inot)); 0 when the
+// container is emptied and removed.
+func kindAfterFlip(kind byte, after set) byte {
+	if after.card() == 0 {
+		return 0
+	}
+	switch kind {
+	case 0:
+		return efficientKind(after)
+	case 'a':
+		if after.card() > 4096 {
+			return 'b'
+		}
+		return 'a'
+	case 'b':
+		if after.card() <= 4096 {
+			return 'a'
+		}
+		return 'b'
+	}
+	return efficientKind(after)
+}
+
+// validity is what Validate can say on a bitmap holding a set with given container kinds
+// (roaringArray.validate: the first failing container in key order): the containers that
+// fail, in key order, each with the switch that explains it: a run container the size rule
+// rejects (roaring/6), a bitmap container of fewer than 4096 values (roaring/9), an array
+// container of more than 4096 values or an emptied one left by a flip of a container
+// ParHeapOr shared (roaring/4, given in extra; no switch of their own, the state is the
+// replica's). Only the keys at the ends of the set's intervals can fail (a key inside an
+// interval holds a full container). It is computed once per bitmap state (validityOf) and
+// read per switch set (text): with the switch of a bug off its error is not predicted, and
+// the documented answer is "ok".
+type validity []vitem
+
+type vitem struct {
+	key uint16
+	sw  int
+	err string
+}
+
+func validityOf(kinds map[uint16]byte, s set, extra map[uint16]string) validity {
+	var items validity
+	seen := map[uint16]bool{}
+	consider := func(key uint16) {
+		if seen[key] {
+			return
+		}
+		seen[key] = true
+		if e := extra[key]; e != "" {
+			items = append(items, vitem{key, -1, e})
+			return
+		}
+		part := s.inKey(key)
+		switch kinds[key] {
+		case 'r':
+			if looseRun(part) {
+				items = append(items, vitem{key, kValidateRejectsRuns, "too many intervals relative to data"})
+			}
+		case 'b':
+			if part.card() < 4096 {
+				items = append(items, vitem{key, kOffsetSmallBitmaps, "bitmap container size was less than: 4096"})
+			}
+		case 'a':
+			if part.card() > 4096 {
+				items = append(items, vitem{key, -1, "invalid array size"})
+			}
+		}
+	}
+	for _, v := range s {
+		consider(uint16(v.lo >> 16))
+		consider(uint16((v.hi - 1) >> 16))
+	}
+	for key := range extra {
+		consider(key)
+	}
+	sort.Slice(items, func(i, j int) bool { return items[i].key < items[j].key })
+	return items
+}
+
+func (v validity) text(k known) string {
+	for _, it := range v {
+		if it.sw < 0 || k[it.sw] {
+			return it.err
+		}
+	}
+	return "ok"
+}
+
+// ---------------------------------------------------------------------------
+// The absent-value queries and the unset iterator, with the replicas of roaring/1, 2 and 3.
+
+// wordsOf is the 1024-word bitmap of a container's part.
+func wordsOf(part set) []uint64 {
+	words := make([]uint64, 1024)
+	for _, v := range part {
+		for x := v.lo; x < v.hi; x++ {
+			words[x/64] |= 1 << (x % 64)
+		}
+	}
+	return words
+}
+
+// nextClear is the first clear bit at or after i in words, 65536 when none.
+func nextClear(words []uint64, i uint) int {
+	x := i / 64
+	if x >= 1024 {
+		return 65536
+	}
+	if w := ^words[x] >> (i % 64); w != 0 {
+		return int(i) + bits.TrailingZeros64(w)
+	}
+	for x++; x < 1024; x++ {
+		if ^words[x] != 0 {
+			return int(x*64) + bits.TrailingZeros64(^words[x])
+		}
+	}
+	return 65536
+}
+
+// prevClear is the last clear bit at or before target in words, -1 when none.
+func prevClear(words []uint64, target uint16) int {
+	x := uint(target) / 64
+	if m := ^words[x] & (^uint64(0) >> (63 - uint(target)%64)); m != 0 {
+		return int(x*64) + 63 - bits.LeadingZeros64(m)
+	}
+	for x > 0 {
+		x--
+		if ^words[x] != 0 {
+			return int(x*64) + 63 - bits.LeadingZeros64(^words[x])
+		}
+	}
+	return -1
+}
+
+// bitmapNextAbsent is bitmapContainer.nextAbsentValue (bitmapcontainer.go) transcribed: when
+// the word holding the target is set from the target to its top, the zero bits shifted in
+// above it count as absent and the start of the next word is returned (roaring/3); -1 when
+// no absent value follows (the walk of NextAbsentValue then returns 4294967295). With replica
+// off, the documented answer: the first absent value at or after target, 65536 when none.
+func bitmapNextAbsent(words []uint64, card int, target uint16, replica bool) int {
+	if !replica {
+		return nextClear(words, uint(target))
+	}
+	if card == 0 {
+		return -1
+	}
+	x := uint(target >> 6)
+	w := words[x] >> (target % 64)
+	if w == 0 {
+		return int(target)
+	}
+	if ^w != 0 {
+		if bits.TrailingZeros64(w) > 0 {
+			return int(target)
+		}
+		return int(target) + bits.TrailingZeros64(^w)
+	}
+	for x++; x < 1024; x++ {
+		if words[x] == 0 {
+			return int(x * 64)
+		}
+		if ^words[x] != 0 {
+			return int(x*64) + bits.TrailingZeros64(^words[x])
+		}
+	}
+	return -1
+}
+
+// bitmapPrevAbsent is bitmapContainer.previousAbsentValue transcribed: within the target's
+// word it counts the ones below the target in the rotated word, bounded by the word, and
+// past it scans the words above the target (roaring/3). With replica off, the documented
+// answer: the last absent value at or before target, -1 when none.
+func bitmapPrevAbsent(words []uint64, card int, target uint16, replica bool) int {
+	if !replica {
+		return prevClear(words, target)
+	}
+	if card == 0 {
+		return -1
+	}
+	x := uint(target >> 6)
+	w := words[x]
+	shifted := w >> (target % 64)
+	if shifted == 0 {
+		return int(target)
+	}
+	if ^shifted != 0 {
+		if bits.TrailingZeros64(shifted) > 0 {
+			return int(target)
+		}
+		shiftedRotated := bits.RotateLeft64(w, int(64-uint(target%64))-1) << 1
+		if bits.LeadingZeros64(shiftedRotated) > 0 {
+			return int(target) - 1
+		}
+		if leadingOnes := bits.LeadingZeros64(^shiftedRotated); leadingOnes > 0 {
+			return int(target) - leadingOnes - 1
+		}
+	}
+	for x++; x < 1024; x++ {
+		if words[x] == 0 {
+			return int(x * 64)
+		}
+		if ^words[x] != 0 {
+			return int(x*64) + bits.TrailingZeros64(^words[x])
+		}
+	}
+	return -1
+}
+
+// nextUnsetBit is bitmapContainer.NextUnsetBit transcribed (the bitmap container's unset
+// iterator steps by it; a different function from nextAbsentValue with the same defect: the
+// zero bits shifted in at the top of the word count as unset, roaring/3), 65536 when none.
+func nextUnsetBit(words []uint64, i uint, replica bool) int {
+	x := i / 64
+	if x >= 1024 {
+		return int(i)
+	}
+	if !replica {
+		return nextClear(words, i)
+	}
+	if w := ^(words[x] >> (i % 64)); w != 0 {
+		return int(i) + bits.TrailingZeros64(w)
+	}
+	for x++; x < 1024; x++ {
+		if words[x] != ^uint64(0) {
+			return int(x*64) + bits.TrailingZeros64(^words[x])
+		}
+	}
+	return 65536
+}
+
+// containerNextAbsent is a container's nextAbsentValue on its part: the first absent value at
+// or after target, 65536 past the end (the run and array containers; the array container
+// adds one in uint16 and wraps to 0 when its last value is 65535, roaring/2), the bitmap
+// container's transcription under roaring/3.
+func containerNextAbsent(part set, kind byte, target uint16, k known) int {
+	if kind == 'b' && k[kAbsentBitmap] {
+		return bitmapNextAbsent(wordsOf(part), int(part.card()), target, true)
+	}
+	v := int(target)
+	i := sort.Search(len(part), func(i int) bool { return part[i].hi > uint64(target) })
+	if i < len(part) && part[i].lo <= uint64(target) {
+		v = int(part[i].hi)
+	}
+	if v == 65536 && kind == 'a' && k[kAbsentNeighbours] {
+		return 0
+	}
+	return v
+}
+
+// containerPrevAbsent is a container's previousAbsentValue on its part: the last absent value
+// at or before target, -1 before the start; the bitmap container's transcription under
+// roaring/3.
+func containerPrevAbsent(part set, kind byte, target uint16, k known) int {
+	if kind == 'b' && k[kAbsentBitmap] {
+		return bitmapPrevAbsent(wordsOf(part), int(part.card()), target, true)
+	}
+	i := sort.Search(len(part), func(i int) bool { return part[i].hi > uint64(target) })
+	if i < len(part) && part[i].lo <= uint64(target) {
+		return int(part[i].lo) - 1
+	}
+	return int(target)
+}
+
+// combineLoHi is combineLoHi32(uint32(v), keyspace) of roaring.go: under roaring/1 the
+// keyspace (key<<16) shifted by 16 again overflows uint32 to zero and only the low bits
+// survive; else the low 16 bits of v under the key (a -1 from a bitmap container becomes
+// 4294967295 either way).
+func combineLoHi(v int, key uint16, k known) int64 {
+	if k[kAbsentHighBits] {
+		return int64(uint32(v))
+	}
+	return int64(uint32(v) | uint32(key)<<16)
+}
+
+// nextAbsentValue is Bitmap.NextAbsentValue on the model (roaring.go NextAbsentValue): the
+// target's container answers, and past its end the walk goes on. The library's walk
+// (roaring/2) compares the container key with the next key, which is always greater, and so
+// returns the start of the next key without consulting it, and returns -1 after the last
+// container whatever its key; the documented walk consults an adjacent next container and
+// returns -1 only past key 65535.
+func nextAbsentValue(s set, kinds map[uint16]byte, target uint32, k known) int64 {
+	ck, ok := s.firstKeyFrom(uint16(target >> 16))
+	if !ok || target < uint32(ck)<<16 {
+		return int64(target)
+	}
+	v := containerNextAbsent(s.inKey(ck), kinds[ck], uint16(target), k)
+	for {
+		if v != 65536 {
+			return combineLoHi(v, ck, k)
+		}
+		nk, more := uint16(0), false
+		if ck < 65535 {
+			nk, more = s.firstKeyFrom(ck + 1)
+		}
+		if !more {
+			if k[kAbsentNeighbours] || ck == 65535 {
+				return -1
+			}
+			return (int64(ck) + 1) << 16
+		}
+		if k[kAbsentNeighbours] || nk > ck+1 {
+			return (int64(ck) + 1) << 16
+		}
+		ck = nk
+		v = containerNextAbsent(s.inKey(ck), kinds[ck], 0, k)
+	}
+}
+
+// previousAbsentValue is Bitmap.PreviousAbsentValue on the model (roaring.go
+// PreviousAbsentValue): the walk into an adjacent previous container is right, but the
+// value found there is combined with the keyspace of the first container (roaring/2), and
+// before the first container -1 is returned whatever its key; the documented walk combines
+// with the key of the container that answered and returns -1 only before key 0.
+func previousAbsentValue(s set, kinds map[uint16]byte, target uint32, k known) int64 {
+	ck, ok := s.firstKeyFrom(uint16(target >> 16))
+	if !ok || target < uint32(ck)<<16 {
+		return int64(target)
+	}
+	first := ck
+	v := containerPrevAbsent(s.inKey(ck), kinds[ck], uint16(target), k)
+	for {
+		if v != -1 {
+			key := ck
+			if k[kAbsentNeighbours] {
+				key = first
+			}
+			return combineLoHi(v, key, k)
+		}
+		pk, more := uint16(0), false
+		if ck > 0 {
+			pk, more = s.lastKeyTo(ck - 1)
+		}
+		if !more {
+			if k[kAbsentNeighbours] || ck == 0 {
+				return -1
+			}
+			return int64(ck)<<16 - 1
+		}
+		if pk < ck-1 {
+			return int64(ck)<<16 - 1
+		}
+		ck = pk
+		v = containerPrevAbsent(s.inKey(ck), kinds[ck], 65535, k)
+	}
+}
+
+// unsetValues is what UnsetIterator(start, end) (and Unset, which is that iterator) yields
+// on the model: for every key from start's up to end's, the values of the window a missing
+// container covers, or the container's unset iterator (roaring.go unsetIterator: the array
+// and run iterators are right; the bitmap container's steps by NextUnsetBit from its first
+// unset bit, advanced to the window's start, roaring/3).
+func unsetValues(s set, kinds map[uint16]byte, start, end uint64, k known) []uint64 {
+	var out []uint64
+	if start >= end {
+		return nil
+	}
+	for key := start >> 16; key < 65536 && key<<16 < end; key++ {
+		base := key << 16
+		lo, hi := max(start, base), min(end, base+65536)
+		if !s.hasKey(uint16(key)) {
+			for x := lo; x < hi; x++ {
+				out = append(out, x)
+			}
+			continue
+		}
+		part := s.inKey(uint16(key))
+		if kinds[uint16(key)] == 'b' && k[kAbsentBitmap] {
+			words := wordsOf(part)
+			i := nextUnsetBit(words, 0, true)
+			if base < start && start < base+65536 && i >= 0 && i < 65536 && i < int(start-base) {
+				i = nextUnsetBit(words, uint(start-base), true)
+			}
+			for i >= 0 && i < 65536 && base+uint64(i) < end {
+				out = append(out, base+uint64(i))
+				i = nextUnsetBit(words, uint(i)+1, true)
+			}
+			continue
+		}
+		for _, v := range part.complement(65536) {
+			for x := max(v.lo+base, lo); x < min(v.hi+base, hi); x++ {
+				out = append(out, x)
+			}
+		}
+	}
+	return out
+}
diff --git a/hegel_zoo_queries_test.go b/hegel_zoo_queries_test.go
new file mode 100644
index 0000000..9f1f58f
--- /dev/null
+++ b/hegel_zoo_queries_test.go
@@ -0,0 +1,266 @@
+package roaring_test
+
+// Property 3: rank, select, cardinality in range and the neighbour queries follow the model.
+// Ten points (a fifth of them a value of the set or one beside it) are asked Rank, NextValue,
+// PreviousValue, NextAbsentValue and PreviousAbsentValue; six indexes Select (a quarter past
+// the end, an error); six ranges CardinalityInRange and IntersectsWithInterval; Rank of the
+// maximum is the cardinality and below the minimum zero; AddOffset64 (and AddOffset for a
+// non-negative offset) shifts the set and leaves the receiver alone, the offset
+// container-aligned when the set is larger than 2^26 values (an accepted difference: a
+// non-aligned shift of the full universe takes seconds). The shapes reached: roaring/1, 2
+// and 3 on the absent-value queries (the replicas of hegel_zoo_model_test.go), roaring/6
+// and 9 on Validate of the AddOffset results (a run piece left loose, a bitmap piece of
+// fewer than 4096 values) and roaring/6 on the record's own loose runs; under
+// HEGEL_NO_KNOWN=1 those checks are dropped.
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/RoaringBitmap/roaring/v2"
+	"hegel.dev/go/hegel"
+)
+
+// queryRec is one query point: a point of the case, or (fromSet, a fifth) the idx-th value
+// of the set plus delta (-1, 0 or 1), capped at the universe.
+type queryRec struct {
+	p       pointRec
+	fromSet bool
+	idx     int
+	delta   int
+}
+
+// selectRec is one Select index: past the end by v (a quarter) or the v-th value.
+type selectRec struct {
+	past bool
+	v    int
+}
+
+// offsetRec is the offset of AddOffset64: one of eight extremes (a fifth) or -70000 to 70000.
+type offsetRec struct {
+	special bool
+	si      int
+	v       int
+}
+
+var offsetSpecials = []int64{int64(1)<<32 - 1, -(int64(1) << 32), int64(1) << 31, -1, 1, 65536, -65536, int64(1) << 32}
+
+type queriesCase struct {
+	bm      bitmapRec
+	queries []queryRec
+	selects []selectRec
+	ranges  []rangeRec
+	off     offsetRec
+
+	p plan
+
+	// Read from the built bitmaps by the property: the container kinds of the built bitmap
+	// (the absent-value replicas need them), what Validate can say on it and on the
+	// AddOffset64 and AddOffset results.
+	kinds       map[uint16]byte
+	v, v64, v32 validity
+}
+
+func (c queriesCase) GoString() string {
+	want := setOfOps(c.p.ops)
+	var ranges []string
+	for _, r := range c.ranges {
+		lo, hi := r.bounds(c.p.keys)
+		ranges = append(ranges, fmt.Sprintf("[%d,%d)", lo, hi))
+	}
+	return fmt.Sprintf("%s; queries %v; selects %v; ranges %v; offset %d", c.p, c.queryValues(want), c.selectKeys(want), ranges, c.offset(want))
+}
+
+// fromSet 20 nominal: dieCoin(20) realises 20; past 25: dieCoin(25) realises 25; special
+// 20: dieCoin(20) realises 20.
+var queriesCases = hegel.FlatMap(keyCounts, func(n int) hegel.Generator[queriesCase] {
+	points := pointRecs(n)
+	queries := hegel.Composite(func(tc hegel.TestCase) queryRec {
+		return queryRec{
+			p:       hegel.Draw(tc, points),
+			fromSet: hegel.Draw(tc, dieCoin(20)),
+			idx:     hegel.Draw(tc, hegel.Integers(0, 1<<30-1)),
+			delta:   hegel.Draw(tc, rangeHalves(-1, 1)),
+		}
+	})
+	selects := hegel.Composite(func(tc hegel.TestCase) selectRec {
+		return selectRec{past: hegel.Draw(tc, dieCoin(25)), v: hegel.Draw(tc, hegel.Integers(0, 1<<30-1))}
+	})
+	offsets := hegel.Composite(func(tc hegel.TestCase) offsetRec {
+		return offsetRec{
+			special: hegel.Draw(tc, dieCoin(20)),
+			si:      hegel.Draw(tc, evenHalves(0, 1, 2, 3, 4, 5, 6, 7)),
+			v:       hegel.Draw(tc, hegel.Integers(-70000, 70000)),
+		}
+	})
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) queriesCase {
+		return queriesCase{
+			bm:      hegel.Draw(tc, bitmapRecs(n)),
+			queries: hegel.Draw(tc, hzCounted(queries, 10, 10)),
+			selects: hegel.Draw(tc, hzCounted(selects, 6, 6)),
+			ranges:  hegel.Draw(tc, hzCounted(rangeRecs(n), 6, 6)),
+			off:     hegel.Draw(tc, offsets),
+		}
+	}), func(c queriesCase) queriesCase {
+		c.p = c.bm.plan()
+		return c
+	})
+})
+
+// queryValues resolves the query points against the set.
+func (c queriesCase) queryValues(want set) []uint64 {
+	out := make([]uint64, len(c.queries))
+	for i, q := range c.queries {
+		x := q.p.value(c.p.keys)
+		if q.fromSet && want.card() > 0 {
+			v, _ := want.selectAt(uint64(q.idx) % min(want.card(), 1<<30))
+			x = uint64(int64(v) + int64(q.delta))
+			if x >= universe32 {
+				x = universe32 - 1
+			}
+		}
+		out[i] = x
+	}
+	return out
+}
+
+// selectKeys resolves the Select indexes against the set.
+func (c queriesCase) selectKeys(want set) []uint64 {
+	card := want.card()
+	out := make([]uint64, len(c.selects))
+	for i, s := range c.selects {
+		switch {
+		case s.past:
+			// Of the full universe no index is past the end: Select takes a uint32.
+			out[i] = min(card+uint64(s.v%3), 1<<32-1)
+		case card == 0:
+			out[i] = uint64(s.v % 4)
+		default:
+			out[i] = uint64(s.v) % min(card, 1<<31)
+		}
+	}
+	return out
+}
+
+// offset resolves the offset, container-aligned for sets above 2^26 values (AddOffset64
+// shifts run containers value by value, runContainer16.inplaceUnion adds each value of the
+// shifted run, about 5 ns a value: a non-aligned shift of the full universe takes 20 s).
+func (c queriesCase) offset(want set) int64 {
+	off := int64(c.off.v)
+	if c.off.special {
+		off = offsetSpecials[c.off.si%len(offsetSpecials)]
+	}
+	if want.card() > 1<<26 {
+		off -= off % 65536
+	}
+	return off
+}
+
+func queriesExpected(c queriesCase, k known) checks {
+	want := setOfOps(c.p.ops)
+	keys := c.p.keys
+	out := planChecks(c.p)
+	out.add("built", bitmapChecks(want, c.v.text(k)))
+	for _, x := range c.queryValues(want) {
+		out.set(fmt.Sprintf("rank(%d)", x), want.rank(x))
+		out.set(fmt.Sprintf("nextValue(%d)", x), want.nextValue(x))
+		out.set(fmt.Sprintf("previousValue(%d)", x), want.prevValue(x))
+		out.set(fmt.Sprintf("nextAbsent(%d)", x), nextAbsentValue(want, c.kinds, uint32(x), k))
+		out.set(fmt.Sprintf("previousAbsent(%d)", x), previousAbsentValue(want, c.kinds, uint32(x), k))
+	}
+	for _, i := range c.selectKeys(want) {
+		if v, ok := want.selectAt(i); ok {
+			out.set(fmt.Sprintf("select(%d)", i), v)
+		} else {
+			out.set(fmt.Sprintf("select(%d)", i), "error")
+		}
+	}
+	for _, r := range c.ranges {
+		lo, hi := r.bounds(keys)
+		n := want.cardInRange(lo, hi)
+		out.set(fmt.Sprintf("cardinalityInRange(%d,%d)", lo, hi), n)
+		if lo <= hi {
+			out.set(fmt.Sprintf("intersectsWithInterval(%d,%d)", lo, hi), n > 0)
+		}
+	}
+	if card := want.card(); card > 0 {
+		out.set("rank(max)", card)
+		if want.min() > 0 {
+			out.set("rank(min-1)", 0)
+		}
+	}
+	off := c.offset(want)
+	shifted := want.shift(off, universe32)
+	out.add(fmt.Sprintf("AddOffset64(%d)", off), bitmapChecks(shifted, c.v64.text(k)))
+	out.add("receiver after AddOffset64", bitmapChecks(want, c.v.text(k)))
+	if off >= 0 && off < 1<<32 {
+		out.add(fmt.Sprintf("AddOffset(%d)", off), bitmapChecks(shifted, c.v32.text(k)))
+	}
+	return out
+}
+
+func queriesActual(c *queriesCase) checks {
+	want := setOfOps(c.p.ops)
+	keys := c.p.keys
+	rb, got := build(c.p)
+	c.kinds = kindsOf(rb)
+	c.v = validityOf(c.kinds, want, nil)
+	got.add("built", readBitmap(rb))
+	for _, x := range c.queryValues(want) {
+		got.set(fmt.Sprintf("rank(%d)", x), rb.Rank(uint32(x)))
+		got.set(fmt.Sprintf("nextValue(%d)", x), rb.NextValue(uint32(x)))
+		got.set(fmt.Sprintf("previousValue(%d)", x), rb.PreviousValue(uint32(x)))
+		got.set(fmt.Sprintf("nextAbsent(%d)", x), rb.NextAbsentValue(uint32(x)))
+		got.set(fmt.Sprintf("previousAbsent(%d)", x), rb.PreviousAbsentValue(uint32(x)))
+	}
+	for _, i := range c.selectKeys(want) {
+		if i >= 1<<32 {
+			continue
+		}
+		if v, err := rb.Select(uint32(i)); err == nil {
+			got.set(fmt.Sprintf("select(%d)", i), v)
+		} else {
+			got.set(fmt.Sprintf("select(%d)", i), "error")
+		}
+	}
+	for _, r := range c.ranges {
+		lo, hi := r.bounds(keys)
+		got.set(fmt.Sprintf("cardinalityInRange(%d,%d)", lo, hi), rb.CardinalityInRange(lo, hi))
+		if lo <= hi {
+			got.set(fmt.Sprintf("intersectsWithInterval(%d,%d)", lo, hi), rb.IntersectsWithInterval(lo, hi))
+		}
+	}
+	if card := want.card(); card > 0 {
+		got.set("rank(max)", rb.Rank(uint32(want.max())))
+		if want.min() > 0 {
+			got.set("rank(min-1)", rb.Rank(uint32(want.min()-1)))
+		}
+	}
+	off := c.offset(want)
+	shifted := want.shift(off, universe32)
+	r64 := roaring.AddOffset64(rb, off)
+	c.v64 = validityOf(kindsOf(r64), shifted, nil)
+	got.add(fmt.Sprintf("AddOffset64(%d)", off), readBitmap(r64))
+	got.add("receiver after AddOffset64", readBitmap(rb))
+	if off >= 0 && off < 1<<32 {
+		r32 := roaring.AddOffset(rb, uint32(off))
+		c.v32 = validityOf(kindsOf(r32), shifted, nil)
+		got.add(fmt.Sprintf("AddOffset(%d)", off), readBitmap(r32))
+	}
+	return got
+}
+
+func TestHegelRankSelectAndNeighboursFollowTheModel(t *testing.T) {
+	judged(t, queriesCases, func(j *hzCaseJudge, c queriesCase) {
+		want := setOfOps(c.p.ops)
+		for _, i := range c.selectKeys(want) {
+			if v, ok := want.selectAt(i); ok && want.rank(v) != i+1 {
+				j.Fail("model", "model inconsistency: rank(select(%d)) = %d for\n%#v", i, want.rank(v), c)
+			}
+		}
+		got := queriesActual(&c)
+		dry, _ := dryReplay(c.p)
+		kindsAgree(j.col, "built", dry, c.kinds, c.p)
+		judgeByDropping(j, c, queriesExpected, func(queriesCase) checks { return got })
+	})
+}
diff --git a/hegel_zoo_shapes_test.go b/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..2f7646d
--- /dev/null
+++ b/hegel_zoo_shapes_test.go
@@ -0,0 +1,552 @@
+package roaring_test
+
+// The eight narrow properties, one per recorded bug the four wide properties reach: each
+// draws the bug's shape region with random surroundings (not the pin's fixed example), is
+// judged by the wide property's expected function and judge (judgeBy: the case is one shape),
+// fails every run by default naming the shape, and under HEGEL_NO_KNOWN=1 draws the
+// neighbouring region past the shape (hzShaped) and passes. The container kinds the
+// classifier needs at draw time come from the dry replica (dryReplay, dryOffsetKinds,
+// dryFlipKinds); the library is never called inside a generator; the judge classifies again
+// with the kinds read from the built bitmaps. The region filters (regionOf) are a safety net
+// for the constructions, their rejections counted "filtered roaring/N" for the collector.
+
+import (
+	"fmt"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Shared pieces: points, ranges and steps by key index and low bits, and the dry kinds.
+
+func pointAt(ki, low int) pointRec { return pointRec{ki: ki, alt: 2, v: low} }
+
+func queryAt(ki, low int) queryRec { return queryRec{p: pointAt(ki, low)} }
+
+// rangeAt is the range [key:lo, key:lo+n) of the ki-th key (length alternative 4: the length
+// as given).
+func rangeAt(ki, lo, n int) rangeRec { return rangeRec{lo: pointAt(ki, lo), lenAlt: 4, lenV: n} }
+
+func addRangeOp(key uint16, lo, n int) op {
+	base := uint64(key) << 16
+	return op{kind: "addrange", lo: base + uint64(lo), hi: base + uint64(lo+n)}
+}
+
+func removeRangeOp(key uint16, lo, n int) op {
+	base := uint64(key) << 16
+	return op{kind: "removerange", lo: base + uint64(lo), hi: base + uint64(lo+n)}
+}
+
+func addManyOp(key uint16, lows []int) op {
+	many := make([]uint32, len(lows))
+	for i, v := range lows {
+		many[i] = uint32(key)<<16 | uint32(v)
+	}
+	return op{kind: "addmany", many: many}
+}
+
+// denseLows is the low bits lo to lo+n-1 (an AddMany of a dense list: an array container
+// becoming a bitmap container past 4096 values).
+func denseLows(lo, n int) []int {
+	out := make([]int, n)
+	for i := range out {
+		out[i] = lo + i
+	}
+	return out
+}
+
+// otherKey is a key other than k (k2 drawn from 0 to 65534, moved past k).
+func otherKey(k, k2 int) uint16 {
+	if k2 >= k {
+		k2++
+	}
+	return uint16(k2)
+}
+
+// farKey is a key at least two away from k (k2 drawn from 0 to 65532, moved past k and its
+// neighbours): the pieces of AddOffset64 then never merge with another container's.
+func farKey(k, k2 int) uint16 {
+	if k2 >= k-1 {
+		k2 += 3
+	}
+	return uint16(k2)
+}
+
+// lows is up to n random low bits.
+func lows(n int) hegel.Generator[[]int] { return countedHalves(hegel.Integers(0, 65535), 0, n) }
+
+// dryOffsetKinds predicts the container kinds of AddOffset64 (roaring.go AddOffset64): an
+// offset that is a multiple of 65536 clones the containers under shifted keys; else every
+// container's two pieces keep its kind (bitmapContainer, arrayContainer and runContainer16
+// addOffset; an empty piece is nil and dropped), and a low piece landing on the key the
+// previous container's high piece took is or-ed into it (prev.ior: taken here as a bitmap
+// when either is one, else a run when either is one, else an array unless above 4096 values;
+// the narrow properties shift one container, so no piece is merged, and the wide property
+// reads the kinds from the result). Pieces past the universe are dropped.
+func dryOffsetKinds(kinds map[uint16]byte, s set, off int64) map[uint16]byte {
+	out := map[uint16]byte{}
+	cards := map[uint16]uint64{}
+	for _, key := range s.keysOf() {
+		kind := kinds[key]
+		for _, v := range s.inKey(key) {
+			lo, hi := int64(v.lo)+int64(key)<<16+off, int64(v.hi)+int64(key)<<16+off
+			lo, hi = max(lo, 0), min(hi, int64(universe32))
+			for x := lo; x < hi; {
+				rk := uint16(x >> 16)
+				end := min(hi, (x>>16+1)<<16)
+				cards[rk] += uint64(end - x)
+				prev, merged := out[rk]
+				switch {
+				case !merged || prev == kind:
+					out[rk] = kind
+				case prev == 'b' || kind == 'b':
+					out[rk] = 'b'
+				case prev == 'r' || kind == 'r':
+					out[rk] = 'r'
+				}
+				x = end
+			}
+		}
+	}
+	for rk, kind := range out {
+		if kind == 'a' && cards[rk] > 4096 {
+			out[rk] = 'b'
+		}
+	}
+	return out
+}
+
+// dryFlipKinds predicts the kinds of the functional Flip (roaring.go Flip: a run container's
+// not is a run container, kept as it is, roaring/6; the others as the in-place flip).
+func dryFlipKinds(kinds map[uint16]byte, after set, lo, hi uint64) map[uint16]byte {
+	out := map[uint16]byte{}
+	for k, v := range kinds {
+		out[k] = v
+	}
+	if lo >= hi {
+		return out
+	}
+	for key := lo >> 16; key <= (hi-1)>>16; key++ {
+		k16 := uint16(key)
+		part := after.inKey(k16)
+		switch {
+		case part.card() == 0:
+			delete(out, k16)
+		case kinds[k16] == 'r':
+			out[k16] = 'r'
+		default:
+			out[k16] = kindAfterFlip(kinds[k16], part)
+		}
+	}
+	return out
+}
+
+// narrowQueries is a queries case over a plan with the given queries and offset, the kinds
+// and validities predicted dry.
+func narrowQueries(p plan, queries []queryRec, off int) queriesCase {
+	c := queriesCase{p: p, queries: queries, off: offsetRec{v: off}}
+	want := setOfOps(p.ops)
+	c.kinds, _ = dryReplay(p)
+	c.v = validityOf(c.kinds, want, nil)
+	c.v64 = validityOf(dryOffsetKinds(c.kinds, want, int64(off)), want.shift(int64(off), universe32), nil)
+	c.v32 = c.v64
+	return c
+}
+
+// narrowConstruction is a construction case over a plan with the clone flip point and the
+// functional Flip range, the kinds and validities predicted dry.
+func narrowConstruction(p plan, cx pointRec, fr rangeRec) constructionCase {
+	c := constructionCase{p: p, cx: cx, fr: fr}
+	want := setOfOps(p.ops)
+	c.kinds, _ = dryReplay(p)
+	c.v = validityOf(c.kinds, want, nil)
+	x := cx.value(p.keys)
+	flipped := want.flip(x, x+1, universe32)
+	key := uint16(x >> 16)
+	c.vClone = validityOf(withKind(c.kinds, key, kindAfterFlip(c.kinds[key], flipped.inKey(key))), flipped, nil)
+	lo, hi := fr.bounds(p.keys)
+	f := want
+	if lo < hi {
+		f = want.flip(lo, hi, universe32)
+	}
+	c.vFlip = validityOf(dryFlipKinds(c.kinds, f, lo, hi), f, nil)
+	return c
+}
+
+// narrowAlgebra is an algebra case over the plans of a and b (c empty) restricted to the
+// given sections, the kinds, flags and validities of a and b predicted dry.
+func narrowAlgebra(pa, pb plan, cow bool, pars []int, xs, ys, sx []pointRec, only []string) algebraCase {
+	c := algebraCase{pa: pa, pb: pb, pc: plan{keys: pa.keys}, cow: cow, pars: pars, xs: xs, ys: ys, sx: sx, only: only}
+	sa, sb := setOfOps(pa.ops), setOfOps(pb.ops)
+	c.kindsA, c.flagsA = dryReplay(pa)
+	c.kindsB, _ = dryReplay(pb)
+	c.va, c.vb = validityOf(c.kindsA, sa, nil), validityOf(c.kindsB, sb, nil)
+	return c
+}
+
+func repeat[T any](v T, n int) []T {
+	out := make([]T, n)
+	for i := range out {
+		out[i] = v
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// roaring/1: an array container at a key above 0 (1 to 200 values), ten absent-value
+// queries whose answers lie inside it (the low bits 256 to 65279: at most 200 values cannot
+// fill the way to either end), so that roaring/2 (an answer past the container) and
+// roaring/3 (a bitmap container) do not apply. Past the shape: the same at key 0, where the
+// dropped high bits are zero.
+
+var highBitsCases = regionOf("roaring/1", queriesExpected, hegel.Composite(func(tc hegel.TestCase) queriesCase {
+	key := uint16(hegel.Draw(tc, hzShaped(hegel.Integers(1, 65535), hegel.Just(0))))
+	values := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 200))
+	targets := hegel.Draw(tc, hzCounted(hegel.Integers(256, 65279), 10, 10))
+	queries := make([]queryRec, len(targets))
+	for i, t := range targets {
+		queries[i] = queryAt(0, t)
+	}
+	return narrowQueries(plan{keys: []uint16{key}, ops: []op{addManyOp(key, values)}}, queries, 0)
+}))
+
+func TestHegelAbsentValuesKeepTheHighBits(t *testing.T) {
+	judged(t, highBitsCases, func(j *hzCaseJudge, c queriesCase) {
+		got := queriesActual(&c)
+		judgeBy(j, c, queriesExpected, func(queriesCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/2: an absent-value query whose answer lies past its container, in the region where
+// the replica of roaring/1 gives the documented answer (the answer carries no high bits of a
+// container above key 0: the start of the next key, or -1): a run container of 4 to 4000
+// values reaching 65535 at key 0 and NextAbsentValue inside it, key 0 the last container
+// (the library says -1, documented 65536) or key 1 full and key 2 absent (the library says
+// 65536 without consulting key 1, documented 131072; random values at key 3); or the first
+// container at a key above 0 full (every query asks both neighbours: a container reaching
+// its end keeps NextAbsentValue's answer free of high bits too) and PreviousAbsentValue
+// inside it (the library says -1, documented the value below the key; random values two
+// keys up). A query whose answer lies in a neighbouring container holding it meets
+// roaring/1 first (sufficiency in bug order) and is left to the wide property. Past the
+// shape: the run stops short of the end it reached (a gap of 1 to 100 values), the answer
+// inside the container; the full container at key 0, where -1 is the documented answer.
+
+var crossCases = regionOf("roaring/2", queriesExpected, hegel.Composite(func(tc hegel.TestCase) queriesCase {
+	variant := hegel.Draw(tc, dieInts(0, 1, 1, 1))
+	m := hegel.Draw(tc, hegel.Integers(4, 4000))
+	gap := hegel.Draw(tc, hzShaped(hegel.Just(0), hegel.Integers(1, 100)))
+	targets := hegel.Draw(tc, hzCounted(hegel.Integers(0, m-1), 10, 10))
+	extras := hegel.Draw(tc, lows(20))
+	key := uint16(hegel.Draw(tc, hzShaped(hegel.Integers(1, 65533), hegel.Just(0))))
+	var p plan
+	start := 0
+	switch variant {
+	case 0:
+		start = 65536 - m - gap
+		p = plan{keys: []uint16{0}, ops: []op{addRangeOp(0, start, m)}}
+	case 1:
+		start = 65536 - m - gap
+		p = plan{keys: []uint16{0, 1, 3}, ops: []op{addRangeOp(0, start, m), addRangeOp(1, 0, 65536), addManyOp(3, extras)}}
+	default:
+		m = 65536
+		p = plan{keys: []uint16{key, key + 2}, ops: []op{addRangeOp(key, 0, m), addManyOp(key+2, extras)}}
+	}
+	queries := make([]queryRec, len(targets))
+	for i, t := range targets {
+		queries[i] = queryAt(0, start+t)
+	}
+	return narrowQueries(p, queries, 0)
+}))
+
+func TestHegelAbsentValuesCrossContainers(t *testing.T) {
+	judged(t, crossCases, func(j *hzCaseJudge, c queriesCase) {
+		got := queriesActual(&c)
+		judgeBy(j, c, queriesExpected, func(queriesCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/3: a bitmap container at key 0 (so that roaring/1 does not apply) built from an
+// array container (1 to 40 random values) by an AddMany of a dense list or an AddRange of
+// 4097 to 8000 values, ten absent-value queries inside the dense run (a target in a word
+// set to its top with the next word's first bit set: all but the targets at a word's start
+// in a full word and those in the last word) and an UnsetIterator window of 1 to 5000 values
+// starting up to 100 values before the run. Judged by the queries and the iterators
+// properties' expected functions together. Past the shape: the dense run of 1 to 4056
+// values, the container an array.
+
+type bitmapAbsentCase struct {
+	q  queriesCase
+	it iteratorsCase
+}
+
+func (c bitmapAbsentCase) GoString() string {
+	lo, hi := c.it.windowBounds()
+	return fmt.Sprintf("%#v; unset window [%d,%d)", c.q, lo, hi)
+}
+
+func bitmapAbsentExpected(c bitmapAbsentCase, k known) checks {
+	out := checks{}
+	out.add("queries", queriesExpected(c.q, k))
+	out.add("iterators", iteratorsExpected(c.it, k))
+	return out
+}
+
+var bitmapAbsentCases = regionOf("roaring/3", bitmapAbsentExpected, hegel.FlatMap(hzShaped(hegel.Integers(4097, 8000), hegel.Integers(1, 4056)), func(n int) hegel.Generator[bitmapAbsentCase] {
+	return hegel.Composite(func(tc hegel.TestCase) bitmapAbsentCase {
+		byList := hegel.Draw(tc, dieCoin(50))
+		lo := hegel.Draw(tc, hegel.Integers(0, 65536-n))
+		first := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 40))
+		targets := hegel.Draw(tc, hzCounted(hegel.Integers(0, n-1), 10, 10))
+		wlo := max(lo+hegel.Draw(tc, hegel.Integers(-100, n-1)), 0)
+		wlen := hegel.Draw(tc, hegel.Integers(1, 5000))
+		ops := []op{addManyOp(0, first)}
+		if byList {
+			ops = append(ops, addManyOp(0, denseLows(lo, n)))
+		} else {
+			ops = append(ops, addRangeOp(0, lo, n))
+		}
+		p := plan{keys: []uint16{0}, ops: ops}
+		queries := make([]queryRec, len(targets))
+		for i, t := range targets {
+			queries[i] = queryAt(0, lo+t)
+		}
+		c := bitmapAbsentCase{q: narrowQueries(p, queries, 0)}
+		c.it = iteratorsCase{
+			p:      p,
+			sizes:  hegel.Draw(tc, countedHalves(evenHalves(manySizes...), 1, 6)),
+			use64:  hegel.Draw(tc, dieCoin(50)),
+			window: rangeAt(0, wlo, wlen),
+			kinds:  c.q.kinds,
+			v:      c.q.v,
+		}
+		return c
+	})
+}))
+
+func TestHegelAbsentValuesInBitmapContainers(t *testing.T) {
+	judged(t, bitmapAbsentCases, func(j *hzCaseJudge, c bitmapAbsentCase) {
+		got := checks{}
+		got.add("queries", queriesActual(&c.q))
+		got.add("iterators", iteratorsActual(&c.it))
+		judgeBy(j, c, bitmapAbsentExpected, func(bitmapAbsentCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/4: ParHeapOr of a holding one key alone (an array container of 1 to 40 values or
+// a bitmap container, evenly) and b holding another key (0 to 40 values), copy on write 30
+// percent of the time and a cloned (its containers flagged under copy on write) a fifth of
+// the time, parallelism 0 to 3; the result flipped at a value of a's key, then a flipped
+// there (the algebra property's ParHeapOr section). Past the shape: a's container a run
+// container of 4 to 3000 values, which the flip does not write.
+
+var parHeapOrCases = regionOf("roaring/4", algebraExpected, hegel.Composite(func(tc hegel.TestCase) algebraCase {
+	k1 := hegel.Draw(tc, hegel.Integers(0, 65535))
+	k2 := otherKey(k1, hegel.Draw(tc, hegel.Integers(0, 65534)))
+	kind := hegel.Draw(tc, hzShaped(dieInts(0, 1, 1), hegel.Just(2)))
+	values := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 40))
+	n := hegel.Draw(tc, hegel.Integers(4, 3000))
+	big := hegel.Draw(tc, hegel.Integers(4097, 20000))
+	start := hegel.Draw(tc, hegel.Integers(0, 65536-big))
+	cow := hegel.Draw(tc, dieCoin(30))
+	cloned := hegel.Draw(tc, dieCoin(20))
+	keys := []uint16{uint16(k1), k2}
+	var ops []op
+	switch kind {
+	case 0:
+		ops = []op{addManyOp(keys[0], values)}
+	case 1:
+		ops = []op{addManyOp(keys[0], values), addRangeOp(keys[0], start, big)}
+	default:
+		ops = []op{addRangeOp(keys[0], start, n)}
+	}
+	if cloned {
+		ops = append(ops, op{kind: "clone"})
+	}
+	pa := plan{keys: keys, cow: cow, ops: ops}
+	pb := plan{keys: keys, cow: cow, ops: []op{addManyOp(k2, hegel.Draw(tc, lows(40)))}}
+	x := pointAt(0, hegel.Draw(tc, hegel.Integers(0, 65535)))
+	y := pointAt(0, hegel.Draw(tc, hegel.Integers(0, 65535)))
+	pars := hegel.Draw(tc, hzCounted(hzDie(4), 6, 6))
+	return narrowAlgebra(pa, pb, cow, pars, repeat(x, len(binopNames)), repeat(y, len(binopNames)), nil, []string{"ParHeapOr"})
+}))
+
+func TestHegelParHeapOrResultsAreIndependent(t *testing.T) {
+	judged(t, parHeapOrCases, func(j *hzCaseJudge, c algebraCase) {
+		got := algebraActual(&c)
+		judgeBy(j, c, algebraExpected, func(algebraCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/5: the single-input aggregates of a bitmap of the wide record (the algebra
+// property's singles section: HeapOr and HeapXor of a alone are a). Past the shape: HeapOr
+// and HeapXor of two bitmaps of the record, copies.
+
+var heapOneCases = regionOf("roaring/5", algebraExpected, hegel.FlatMap(keyCounts, func(n int) hegel.Generator[algebraCase] {
+	points := pointRecs(n)
+	bodies := bitmapBodyRecs(n)
+	return hegel.Composite(func(tc hegel.TestCase) algebraCase {
+		keys := hegel.Draw(tc, hzCounted(keyRecs, n, n))
+		a, b := hegel.Draw(tc, bodies), hegel.Draw(tc, bodies)
+		a.keys, b.keys = keys, keys
+		return narrowAlgebra(a.plan(), b.plan(), hegel.Draw(tc, dieCoin(30)), hegel.Draw(tc, hzCounted(hzDie(4), 6, 6)),
+			hegel.Draw(tc, hzCounted(points, len(binopNames), len(binopNames))),
+			hegel.Draw(tc, hzCounted(points, len(binopNames), len(binopNames))),
+			hegel.Draw(tc, hzCounted(points, len(singleNames), len(singleNames))),
+			hzShaped([]string{"singles"}, []string{"HeapOr", "HeapXor"}))
+	})
+}))
+
+func TestHegelHeapAggregatesOfOneBitmapAreCopies(t *testing.T) {
+	judged(t, heapOneCases, func(j *hzCaseJudge, c algebraCase) {
+		got := algebraActual(&c)
+		judgeBy(j, c, algebraExpected, func(algebraCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/6: a run container of 8 to 3000 values the library leaves loose: RemoveRange of
+// its middle leaving 2 to 5 values in two runs (the construction property's record), the
+// functional Flip of its middle leaving the same (the construction property's Flip), or
+// AddOffset64 by an offset splitting 1 to 3 values into the next or the previous key (the
+// queries property's AddOffset64), evenly; random values at a key two or more away (a piece
+// of the shift merged into a neighbour's container is or-ed into it, and the library's
+// array-with-run union is not a loose run: the pieces of AddOffset64 into a neighbouring
+// container are left to the wide property, which reads the result's kinds). The in-place
+// Flip, And, AndNot, Remove and RunOptimize leave efficient runs (checked standalone) and are
+// not shapes. Past the shape: the two runs keep 6 to 40 values, the split piece 4 or more.
+
+type runsCase struct {
+	variant int
+	con     constructionCase
+	q       queriesCase
+}
+
+var runsVariants = []string{"RemoveRange", "Flip", "AddOffset64"}
+
+func (c runsCase) GoString() string {
+	if c.variant == 2 {
+		return fmt.Sprintf("%s: %#v", runsVariants[c.variant], c.q)
+	}
+	return fmt.Sprintf("%s: %#v", runsVariants[c.variant], c.con)
+}
+
+func runsExpected(c runsCase, k known) checks {
+	if c.variant == 2 {
+		return queriesExpected(c.q, k)
+	}
+	return constructionExpected(c.con, k)
+}
+
+var looseRunCases = regionOf("roaring/6", runsExpected, hegel.FlatMap(hegel.Integers(8, 3000), func(n int) hegel.Generator[runsCase] {
+	return hegel.Composite(func(tc hegel.TestCase) runsCase {
+		variant := hegel.Draw(tc, dieInts(0, 1, 1, 1))
+		key := uint16(hegel.Draw(tc, hegel.Integers(1, 65534)))
+		other := farKey(int(key), hegel.Draw(tc, hegel.Integers(0, 65532)))
+		start := hegel.Draw(tc, hegel.Integers(0, 65536-n))
+		kept := hegel.Draw(tc, hzShaped(hegel.Integers(2, 5), hegel.Integers(6, min(n-1, 40))))
+		left := hegel.Draw(tc, hegel.Integers(1, kept-1))
+		piece := hegel.Draw(tc, hzShaped(hegel.Integers(1, 3), hegel.Integers(4, n-4)))
+		negative := hegel.Draw(tc, dieCoin(50))
+		extras := hegel.Draw(tc, lows(20))
+		keys := []uint16{key, other}
+		ops := []op{addRangeOp(key, start, n), addManyOp(other, extras)}
+		c := runsCase{variant: variant}
+		switch variant {
+		case 0:
+			ops = append(ops, removeRangeOp(key, start+left, n-kept))
+			c.con = narrowConstruction(plan{keys: keys, ops: ops}, pointAt(1, hegel.Draw(tc, hegel.Integers(0, 65535))), rangeRec{})
+		case 1:
+			c.con = narrowConstruction(plan{keys: keys, ops: ops}, pointAt(1, hegel.Draw(tc, hegel.Integers(0, 65535))), rangeAt(0, start+left, n-kept))
+		default:
+			off := 65536 - start - n + piece
+			if negative {
+				off = -(start + piece)
+			}
+			c.q = narrowQueries(plan{keys: keys, ops: ops}, nil, off)
+		}
+		return c
+	})
+}))
+
+func TestHegelLibraryBuiltRunContainersValidate(t *testing.T) {
+	judged(t, looseRunCases, func(j *hzCaseJudge, c runsCase) {
+		var got checks
+		if c.variant == 2 {
+			got = queriesActual(&c.q)
+		} else {
+			got = constructionActual(&c.con)
+		}
+		judgeBy(j, c, runsExpected, func(runsCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/9: a bitmap container (1 to 40 random values and an AddRange of 4097 to 20000)
+// shifted by AddOffset64 by an offset that is not a multiple of 65536, splitting 1 to 4055
+// of the dense values (with the random ones that follow them, at most 40) into the next or
+// the previous key: a bitmap container of fewer than 4096 values. Past the shape: the dense
+// run 8300 to 20000 values, both pieces of 4096 values or more.
+
+var offsetCases = regionOf("roaring/9", queriesExpected, hegel.FlatMap(hzShaped(hegel.Integers(4097, 20000), hegel.Integers(8300, 20000)), func(n int) hegel.Generator[queriesCase] {
+	return hegel.Composite(func(tc hegel.TestCase) queriesCase {
+		key := uint16(hegel.Draw(tc, hegel.Integers(1, 65534)))
+		start := hegel.Draw(tc, hegel.Integers(0, 65536-n))
+		first := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 40))
+		// The bounds chosen before the generator is made: Integers rejects an empty range.
+		piece := hegel.Draw(tc, hegel.Integers(hzShaped(1, 4136), hzShaped(4055, n-4136)))
+		negative := hegel.Draw(tc, dieCoin(50))
+		off := 65536 - start - n + piece
+		if negative {
+			off = -(start + piece)
+		}
+		p := plan{keys: []uint16{key}, ops: []op{addManyOp(key, first), addRangeOp(key, start, n)}}
+		return narrowQueries(p, nil, off)
+	})
+}))
+
+func TestHegelAddOffsetResultsAreValid(t *testing.T) {
+	judged(t, offsetCases, func(j *hzCaseJudge, c queriesCase) {
+		got := queriesActual(&c)
+		judgeBy(j, c, queriesExpected, func(queriesCase) checks { return got })
+	})
+}
+
+// ---------------------------------------------------------------------------
+// roaring/12: the in-place Xor of a clone of a with b at a key where a holds an array
+// container (1 to 40 values) or a run container (4 to 3000 values), evenly, and b a bitmap
+// container (1 to 40 random values and an AddRange of 7200 to 20000: the symmetric
+// difference is then above 4096 values whatever a holds), copy on write 30 percent of the
+// time (the algebra property's in-place section). Past the shape: b's AddRange of 100 to
+// 4000 values, its container an array.
+
+var inPlaceXorCases = regionOf("roaring/12", algebraExpected, hegel.Composite(func(tc hegel.TestCase) algebraCase {
+	key := uint16(hegel.Draw(tc, hegel.Integers(0, 65535)))
+	isRun := hegel.Draw(tc, dieCoin(50))
+	values := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 40))
+	n := hegel.Draw(tc, hegel.Integers(4, 3000))
+	start := hegel.Draw(tc, hegel.Integers(0, 65536-n))
+	big := hegel.Draw(tc, hzShaped(hegel.Integers(7200, 20000), hegel.Integers(100, 4000)))
+	bstart := hegel.Draw(tc, hegel.Integers(0, 65536-big))
+	first := hegel.Draw(tc, countedHalves(hegel.Integers(0, 65535), 1, 40))
+	cow := hegel.Draw(tc, dieCoin(30))
+	keys := []uint16{key}
+	ops := []op{addManyOp(key, values)}
+	if isRun {
+		ops = []op{addRangeOp(key, start, n)}
+	}
+	pa := plan{keys: keys, cow: cow, ops: ops}
+	pb := plan{keys: keys, cow: cow, ops: []op{addManyOp(key, first), addRangeOp(key, bstart, big)}}
+	return narrowAlgebra(pa, pb, cow, nil, nil, nil, nil, []string{"in-place"})
+}))
+
+func TestHegelInPlaceXorLeavesTheArgumentAlone(t *testing.T) {
+	judged(t, inPlaceXorCases, func(j *hzCaseJudge, c algebraCase) {
+		got := algebraActual(&c)
+		judgeBy(j, c, algebraExpected, func(algebraCase) checks { return got })
+	})
+}
diff --git a/hegel_zoo_test.go b/hegel_zoo_test.go
new file mode 100644
index 0000000..70f95fe
--- /dev/null
+++ b/hegel_zoo_test.go
@@ -0,0 +1,696 @@
+package roaring_test
+
+// Hegel property tests for github.com/RoaringBitmap/roaring/v2, written for the Hegel zoo.
+//
+// Oracles: an interval-set model of a set of 32-bit (or 64-bit) integers written here,
+// against which every construction, set operation, query and iterator is checked; the
+// RoaringFormatSpec (https://github.com/RoaringBitmap/RoaringFormatSpec), written here as an
+// independent parser and writer (the library's bytes must parse to the model, and
+// spec-conformant bytes of the model, with any legal choice of container types, must be
+// accepted); the documented contracts of the deserializers (memory safety, Validate as the
+// gate before use); and the bits-and-blooms bitset for the dense conversions.
+//
+// The AGENTS.md of the repository is respected: a bitmap deserialized from untrusted bytes is
+// only used after Validate() returned nil.
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier); hegel_zoo_model_test.go the set
+// model, the container-kind reader and the replicas of the recorded bugs with the switch set
+// threaded; hegel_zoo_bitmaps_test.go the records (keys, points, ranges, ops, bitmaps) drawn
+// as raw material, the pure build of a bitmap from a record and the model's reading of it;
+// hegel_zoo_construction_test.go, hegel_zoo_algebra_test.go, hegel_zoo_queries_test.go and
+// hegel_zoo_iterators_test.go the four wide properties; hegel_zoo_shapes_test.go one narrow
+// property per recorded bug those four reach; hegel_test.go the six remaining properties on
+// the older harness; hegel_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES, HEGEL_SEED
+// and HEGEL_VERBOSE are passed through hzOpts; a panic in the code under test is turned into
+// a failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has. ROARING_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record
+// their mismatches instead of failing and print the counts. The model states the documented
+// behaviour (every switch of the known value below off) and the properties judge the library
+// against it; the shape of a recorded bug is named by the classifier shapeBy, which runs the
+// model per switch on the case record and the container kinds read from the built bitmap,
+// fails by default "(the shape of roaring/N)", and under HEGEL_NO_KNOWN=1 the checks the
+// shape covers are dropped from the case (judgeByDropping) or, in the narrow properties, the
+// region past the shape is drawn (hzShaped, regionOf), so that a run looks past the known
+// bugs.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector). Some cases build bitmaps spanning all 65536 containers; on a loaded
+// machine that trips Hegel's too-slow health check, which hegel-go reports without a message,
+// so it is suppressed.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf and go/kong judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ROARING_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below in
+// bug order (the id of a switch is "roaring/<index+1>"). The replicas (hegel_zoo_model_test.go)
+// are pure functions of (case, known): with every switch off (hzKnownNone) they state the
+// documented behaviour (the model, the README's accepted differences) and are what the
+// properties judge the library against; with a switch on they reproduce that bug as a replica
+// of the library's rule, transcribed from the source at the point named beside the switch.
+// The classifier runs the model with several sets to name the shape of a case before the
+// library's answers are judged; the pins assert the documented behaviour and fail while the
+// bug exists. Four switches (7, 8, 10, 11) belong to the six properties still on the older
+// harness in hegel_test.go and are declared here unused, for the numbering.
+type known [12]bool
+
+const (
+	// roaring/1: NextAbsentValue/PreviousAbsentValue return only the low 16 bits when the target's container key is not 0 (combineLoHi32's hob<<16 overflows uint32, roaring.go NextAbsentValue/PreviousAbsentValue)
+	kAbsentHighBits = iota
+	// roaring/2: NextAbsentValue/PreviousAbsentValue answer wrongly when the answer lies outside the target's container (the walk: next never consults the neighbour, previous keeps the first keyspace, a full array container wraps to 0)
+	kAbsentNeighbours
+	// roaring/3: NextAbsentValue/PreviousAbsentValue and UnsetIterator return present values inside a bitmap container (bitmapContainer.nextAbsentValue, previousAbsentValue and NextUnsetBit count the zero bits shifted in at the top of a word)
+	kAbsentBitmap
+	// roaring/4: ParHeapOr's result shares containers with its inputs without copy-on-write (parallel.go appenderRoutine appends the input's container of a key one input holds, unflagged)
+	kParHeapOrShares
+	// roaring/5: HeapOr and HeapXor of a single bitmap return that bitmap itself (fastaggregation.go HeapOr/HeapXor pop the one input and return it)
+	kHeapOneReturnsInput
+	// roaring/6: Validate rejects spec-conformant run containers that are not the smallest representation (runContainer16.validate's size rule; AddRange, RemoveRange, the functional Flip and AddOffset64 leave such runs)
+	kValidateRejectsRuns
+	// roaring/7: Validate panics on the bitmap a failed ReadFrom/FromBuffer leaves behind (hegel_test.go)
+	kValidateAfterBadRead
+	// roaring/8: Roaring32AsRoaring64 of an empty bitmap is an invalid bitmap (hegel_test.go)
+	kEmptyAs64Invalid
+	// roaring/9: AddOffset/AddOffset64 build bitmap containers of 4096 values or fewer, which Validate rejects (bitmapContainer.addOffset splits into bitmap pieces whatever their size)
+	kOffsetSmallBitmaps
+	// roaring/10: Checksum depends on the container types, not only on the set (hegel_test.go)
+	kChecksumRepresentation
+	// roaring/11: Validate accepts a run container whose run extends past the container (hegel_test.go)
+	kValidateAcceptsOverflow
+	// roaring/12: in-place Xor mutates its argument when the argument holds a bitmap container and the receiver does not (bitmapContainer.ixorBitmap writes the argument's bitmap in place when the result exceeds 4096 values)
+	kInPlaceXorMutatesArg
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("roaring/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "roaring/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "roaring/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape roaring/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// roaring/N"), the checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped roaring/N"), the
+// draws the filters rejected ("filtered <name>"), the replica's agreement with the library on
+// the shaped cases ("replica agreement", "replica disagreement"), the dry container-kind
+// replica's agreement with the kinds read from the library ("kinds agreement", "kinds
+// disagreement"), and the cases assumed away for an unrecorded candidate bug
+// ("candidate/go/roaring-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf and go/kong judge,
+// with the collector's mismatch classes): it names the recorded bug whose shape the case has,
+// so that a mismatch or a library panic fails "(the shape of roaring/N)", and under
+// HEGEL_NO_KNOWN=1 skips the case instead (counted as known) or drops the checks the shape
+// covers (Dropped). The wide and the narrow properties share their judge functions and so
+// this. The classifier that names the shape is computed from the case record and the
+// container kinds read from the built bitmap (the model run with several sets of switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the checks dropped instead), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped roaring/N") and the case goes on
+// (judgeByDropping: the four wide properties).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The properties catch the panics of the calls whose
+// documented behaviour is to panic (Minimum and Maximum of an empty bitmap) themselves
+// (hzCatch) into the check value "panic" so that they are judged like any other value; this
+// is the net under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	if !hzCollecting {
+		// The twelve properties on this runner fail by design and each shrinks its failure
+		// (40 to 120 s of replays); run two at a time (go test's -parallel, the CPU count)
+		// after the serial tests, which keeps a whole run within go test's deadline. In
+		// collect mode they run one after the other, the judge's counters being global.
+		t.Parallel()
+	}
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf and go/kong
+// form: every value here is text compared exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// add merges the checks of a part of a case under a prefix ("<prefix> <name>").
+func (c checks) add(prefix string, part checks) {
+	for k, v := range part {
+		c[prefix+" "+k] = v
+	}
+}
+
+// checkOrder is the order the checks of a case are reported in when it fails: the checks of
+// a bitmap read (readBitmap) in the order they are made, the rest by text.
+var checkOrder = map[string]int{
+	"validate": 0, "set": 1, "empty": 2, "minmax": 3, "stats": 4, "runs": 5,
+}
+
+func checkLess(a, b string) bool {
+	ap, an := splitCheck(a)
+	bp, bn := splitCheck(b)
+	if ap != bp {
+		return ap < bp
+	}
+	ar, aok := checkOrder[an]
+	br, bok := checkOrder[bn]
+	if aok && bok && ar != br {
+		return ar < br
+	}
+	if aok != bok {
+		return aok
+	}
+	return an < bn
+}
+
+// splitCheck is the prefix and the last word of a check name.
+func splitCheck(name string) (string, string) {
+	if i := strings.LastIndexByte(name, ' '); i > 0 {
+		return name[:i], name[i+1:]
+	}
+	return "", name
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two statements agree: the same checks, each value equal.
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || a[k] != w {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, a[k]))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, a[k], w))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("roaring/?", a defect of the model). The
+// order matters where two shapes meet (an absent-value query whose answer lies in another
+// container above key 0 meets roaring/1 and roaring/2; one into a bitmap container above key
+// 0 roaring/1 and roaring/3; a loose run beside a small bitmap piece of AddOffset64
+// roaring/6 and roaring/9): sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "roaring/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the name's first word.
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	verdictBy(j, c, got, want, shape, expected, sameChecks)
+}
+
+// verdictBy is verdict with the family's own notion of replica agreement (this target needs
+// none; the form is kept from go/chi, whose RouteHeaders replica is a set and agreement is
+// membership).
+func verdictBy[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks, agrees func(got, replica checks) bool) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agrees(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if sameChecks(got, want) {
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || g != want[k] {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	j.Fail(classOf(class), "%s for\n%#v", diffChecks(got, want), c)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library (the narrow
+// properties: the case is one shape, skipped whole under HEGEL_NO_KNOWN=1).
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(c, expected)
+	j.Shape(shape)
+	verdict(j, c, got, want, shape, expected)
+}
+
+// documented reports, by default and outside collect mode, that the library's values are
+// the documented ones: the case passes and there is no shape to name, so the classifier
+// (several model runs) is not run; under HEGEL_NO_KNOWN=1 the shape is needed first (a case
+// is skipped or its checks dropped before the comparison), and in collect mode the counts
+// are. The shrinking of a failure replays mostly passing cases, which this keeps cheap.
+func documented(got, want checks) bool {
+	return !hzNoKnown && !hzCollecting && sameChecks(restrict(got, want), want)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi and go/go-debian form; the four wide properties here):
+// by default the shape is named and every check judged; under HEGEL_NO_KNOWN=1 the checks the
+// shapes cover (those on which the replica with every switch on differs from the documented
+// model, or which it does not state) are dropped from the case (hzCaseJudge.Dropped, counted
+// "dropped roaring/N") and the rest judged, the case not skipped.
+func judgeByDropping[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(c, expected)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(c, hzKnownAll)
+		kept := checks{}
+		for name, v := range want {
+			if w, ok := all[name]; ok && w == v {
+				kept[name] = v
+			}
+		}
+		want = kept
+		verdict(j, c, got, want, "", expected)
+		return
+	}
+	verdict(j, c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered roaring/N" by the shape it had), g itself otherwise: for
+// a property whose shapes are a property of the record alone, so that a case with a known
+// shape is drawn again rather than skipped (no wide property of this target needs it, their
+// shapes depend on the container kinds read from the built bitmap; kept with the harness).
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
