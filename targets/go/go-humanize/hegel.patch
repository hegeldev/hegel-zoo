+			got := humanize.CommafWithDigits(f, d)
+			// since 40736da3 (Fix #105) the result is padded to exactly d decimals
+			want := padDecimals(truncateDecimals(commaModel(strconv.FormatFloat(f, 'f', -1, 64)), d), d)
+			note(ht, "CommafWithDigits(%v, %d) = %q", f, d, got)
+			if got != want {
+				ht.Fatalf("CommafWithDigits(%v, %d) = %q, want %q", f, d, got, want)
