+// ---- Ftoa, SI, Ordinal ---------------------------------------------------------------------
+
+var siPrefixes = map[int]string{
+	-30: "q", -27: "r", -24: "y", -21: "z", -18: "a", -15: "f", -12: "p", -9: "n", -6: "µ", -3: "m",
+	0: "", 3: "k", 6: "M", 9: "G", 12: "T", 15: "P", 18: "E", 21: "Z", 24: "Y", 27: "R", 30: "Q",
+}
+
+// siUnitNames are units that do not start with a prefix letter (ParseSI cannot tell "m" the
+// unit from "m" the prefix; see the README).
+var siUnitNames = []string{"", "B", "F", "V", "Hz", "W", "s", "Ω", "bit/s", "h", "cd"}
+
+func TestHegelFtoaSIAndOrdinalFollowTheirModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 1, 5) {
+		case 1:
+			f := genFloat(ht)
+			got, want := humanize.Ftoa(f), stripZeros(strconv.FormatFloat(f, 'f', 6, 64))
+			note(ht, "Ftoa(%v) = %q", f, got)
+			if got != want {
+				ht.Fatalf("Ftoa(%v) = %q, want %q", f, got, want)
+			}
+		case 2:
+			f, d := genFloat(ht), n(ht, -1, 8)
+			got := humanize.FtoaWithDigits(f, d)
+			want := stripZeros(truncateDecimals(strconv.FormatFloat(f, 'f', 6, 64), d))
+			note(ht, "FtoaWithDigits(%v, %d) = %q", f, d, got)
+			if got != want {
+				ht.Fatalf("FtoaWithDigits(%v, %d) = %q, want %q", f, d, got, want)
+			}
+		case 3:
+			// a mantissa clear of the decade boundaries times a tabled power of ten
+			m := float64(n(ht, 1001, 998999)) / 1000
+			k := 3 * n(ht, -10, 10)
+			x := m * math.Pow10(k)
+			if chance(ht, 30) {
+				x = -x
+			}
+			v, p := humanize.ComputeSI(x)
+			note(ht, "ComputeSI(%v) = %v, %q", x, v, p)
+			if p != siPrefixes[k] {
+				ht.Fatalf("ComputeSI(%v) = %v, %q; want prefix %q", x, v, p, siPrefixes[k])
+			}
+			if math.Abs(math.Abs(v)-m) > m*1e-9 || (v < 0) != (x < 0) {
+				ht.Fatalf("ComputeSI(%v) = %v, %q; want mantissa %v", x, v, p, math.Copysign(m, x))
+			}
+			unit := pick(ht, siUnitNames)
+			s := humanize.SI(x, unit)
+			back, u, err := humanize.ParseSI(s)
+			note(ht, "SI(%v, %q) = %q; ParseSI -> %v, %q, %v", x, unit, s, back, u, err)
+			if err != nil || u != unit || math.Abs(back-x) > math.Abs(x)*1e-6 {
+				ht.Fatalf("SI(%v, %q) = %q does not round-trip: %v, %q, %v", x, unit, s, back, u, err)
+			}
+			if !strings.HasSuffix(s, " "+p+unit) || !strings.HasPrefix(s, humanize.Ftoa(v)) {
+				ht.Fatalf("SI(%v, %q) = %q; want %q", x, unit, s, humanize.Ftoa(v)+" "+p+unit)
+			}
+		case 4:
+			// ParseSI on hand-built text: number, optional blank, prefix, unit
+			m := float64(wide(ht, -999999, 999999)) / math.Pow10(n(ht, 0, 4))
+			k := 3 * n(ht, -10, 10)
+			unit := pick(ht, siUnitNames)
+			text := strconv.FormatFloat(m, 'f', -1, 64) + pick(ht, []string{"", " "}) + siPrefixes[k] + unit
+			back, u, err := humanize.ParseSI(text)
+			want := m * math.Pow10(k)
+			note(ht, "ParseSI(%q) = %v, %q, %v", text, back, u, err)
+			if err != nil || u != unit || math.Abs(back-want) > math.Abs(want)*1e-12 {
+				ht.Fatalf("ParseSI(%q) = %v, %q, %v; want %v, %q", text, back, u, err, want, unit)
+			}
+		default:
+			x := n(ht, 0, 100)
+			if chance(ht, 50) {
+				x = n(ht, 0, 1e9)
+			}
+			got := humanize.Ordinal(x)
+			suffix := "th"
+			switch {
+			case x%100 >= 11 && x%100 <= 13:
+			case x%10 == 1:
+				suffix = "st"
+			case x%10 == 2:
+				suffix = "nd"
+			case x%10 == 3:
+				suffix = "rd"
+			}
+			note(ht, "Ordinal(%d) = %q", x, got)
+			if want := strconv.Itoa(x) + suffix; got != want {
+				ht.Fatalf("Ordinal(%d) = %q, want %q", x, got, want)
+			}
+		}
+	})
+}
