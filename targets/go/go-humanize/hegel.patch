+			got, want := humanize.BigComma(new(big.Int).Set(v)), commaModel(v.String())
+			note(ht, "BigComma(%s) = %q", v, got)
+			if got != want {
+				ht.Fatalf("BigComma(%s) = %q, want %q", v, got, want)
+			}
+		case 5:
