+func TestHegelByteParsersAgreeWithExactArithmetic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text, value, suffix := genSizeText(ht)
+		want := floorRat(value)
+		note(ht, "text %q = %s bytes", text, want)
+		bigGot, err := humanize.ParseBigBytes(text)
+		if err != nil || bigGot.Cmp(want) != 0 {
+			ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", text, bigGot, err, want)
+		}
+		got, err := humanize.ParseBytes(text)
+		switch {
+		case !sizeSuffixes[suffix].small:
+			if err == nil {
+				ht.Fatalf("ParseBytes(%q) = %d; bytes.go does not know %q", text, got, suffix)
+			}
+		case want.Cmp(two64) >= 0:
+			if err == nil {
+				ht.Fatalf("ParseBytes(%q) = %d; %s does not fit a uint64", text, got, want)
+			}
+		case new(big.Rat).Mul(value, big.NewRat(1<<50+1, 1<<50)).Cmp(ratInt(two64)) >= 0:
+			// within float rounding of 2^64: either answer is acceptable (go-humanize/3)
+		default:
+			if err != nil {
+				ht.Fatalf("ParseBytes(%q): %v; want %s", text, err, want)
+			}
+			// go-humanize/3: ParseBytes goes through float64; allow its rounding here
+			tol := new(big.Rat).Mul(value, big.NewRat(1, 1<<50))
+			tol.Add(tol, big.NewRat(1, 1))
+			if !diffWithin(new(big.Rat).SetUint64(got), value, tol) {
+				ht.Fatalf("ParseBytes(%q) = %d, want %s", text, got, want)
+			}
+		}
+	})
+}
