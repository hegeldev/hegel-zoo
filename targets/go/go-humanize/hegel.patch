+// ---- RelTime -------------------------------------------------------------------------------
+
+// relModel says how RelTime describes a non-negative difference d with label lbl: seconds,
+// minutes, hours, days, weeks, 30-day months and 360-day years, singular below twice the
+// unit, "now" under a second, "a long while" from 37 years.
+func relModel(d time.Duration, lbl string) string {
+	const day = 24 * time.Hour
+	const week, month, year = 7 * day, 30 * day, 360 * day
+	plural := func(k time.Duration, unit string) string { return fmt.Sprintf("%d %ss %s", int64(k), unit, lbl) }
+	switch {
+	case d < time.Second:
+		return "now"
+	case d < 2*time.Second:
+		return "1 second " + lbl
+	case d < time.Minute:
+		return plural(d/time.Second, "second")
+	case d < 2*time.Minute:
+		return "1 minute " + lbl
+	case d < time.Hour:
+		return plural(d/time.Minute, "minute")
+	case d < 2*time.Hour:
+		return "1 hour " + lbl
+	case d < day:
+		return plural(d/time.Hour, "hour")
+	case d < 2*day:
+		return "1 day " + lbl
+	case d < week:
+		return plural(d/day, "day")
+	case d < 2*week:
+		return "1 week " + lbl
+	case d < month:
+		return plural(d/week, "week")
+	case d < 2*month:
+		return "1 month " + lbl
+	case d < year:
+		return plural(d/month, "month")
+	case d < 18*month:
+		return "1 year " + lbl
+	case d < 2*year:
+		return "2 years " + lbl
+	case d < 37*year:
+		return plural(d/year, "year")
+	default:
+		return "a long while " + lbl
+	}
+}
+
+// genDuration draws a duration log-uniformly from nanoseconds to about 40 years, biased to
+// the table's boundaries.
+func genDuration(tc hegel.TestCase) time.Duration {
+	if chance(tc, 30) {
+		bounds := []time.Duration{time.Second, 2 * time.Second, time.Minute, 2 * time.Minute, time.Hour, 2 * time.Hour,
+			24 * time.Hour, 48 * time.Hour, 7 * 24 * time.Hour, 14 * 24 * time.Hour, 30 * 24 * time.Hour,
+			60 * 24 * time.Hour, 360 * 24 * time.Hour, 540 * 24 * time.Hour, 720 * 24 * time.Hour, 37 * 360 * 24 * time.Hour}
+		return pick(tc, bounds) + time.Duration(wide(tc, -2e9, 2e9))
+	}
+	e := n(tc, 0, 18)
+	lo := int64(1)
+	for i := 0; i < e; i++ {
+		lo *= 10
+	}
+	hi := lo*10 - 1
+	if e == 18 {
+		hi = 1300000000 * int64(time.Second)
+	}
+	return time.Duration(wide(tc, lo-1, hi))
+}
+
+func TestHegelRelTimeFollowsTheTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := time.Unix(wide(ht, -1e10, 1e10), int64(n(ht, 0, 999999999))).UTC()
+		d := genDuration(ht)
+		if chance(ht, 50) {
+			d = -d
+		}
+		b := a.Add(d)
+		got := humanize.RelTime(a, b, "ago", "from now")
+		swapped := humanize.RelTime(b, a, "ago", "from now")
+		note(ht, "a %v, b = a %+v: %q / %q", a, d, got, swapped)
+		want, wantSwapped := relModel(d, "ago"), relModel(d, "from now")
+		if d < 0 {
+			want, wantSwapped = relModel(-d, "from now"), relModel(-d, "ago")
+		}
+		if got != want {
+			ht.Fatalf("RelTime(a, a%+v) = %q, want %q", d, got, want)
+		}
+		if swapped != wantSwapped {
+			ht.Fatalf("RelTime(a%+v, a) = %q, want %q", d, swapped, wantSwapped)
+		}
+	})
+}
