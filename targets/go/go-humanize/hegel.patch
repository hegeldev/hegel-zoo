+func TestHegelCommaFormattersFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 1, 6) {
+		case 1:
+			var v int64
+			switch n(ht, 1, 3) {
+			case 1:
+				v = wide(ht, math.MinInt64, math.MaxInt64)
+			case 2:
+				v = wide(ht, -1e6, 1e6)
+			default:
+				v = pick(ht, []int64{0, 7, 8, -1, -8, 999, 1000, -1000, math.MaxInt64, math.MinInt64, math.MinInt64 + 1})
+			}
+			got, want := humanize.Comma(v), commaModel(strconv.FormatInt(v, 10))
+			note(ht, "Comma(%d) = %q", v, got)
