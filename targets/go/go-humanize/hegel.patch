+// Hegel property tests for github.com/dustin/go-humanize: the byte printers and parsers against
+// exact (math/big) arithmetic, the comma and FormatFloat formatters against string-insertion
+// models, SI prefixes and ordinals against their tables, and RelTime against an independent
+// calendar model.
+//
+// Every property draws one case record from generators that are package-level values and
+// renders it with pure functions; the records carry a GoString for the draw report. The shapes
+// of the recorded bugs are drawn by default, so the properties that find them are the expected
+// failures (the pins beside them are the regression examples); HEGEL_NO_KNOWN=1 leaves those
+// shapes out of the cases and allows for the recorded roundings, for a run that looks past them.
+package humanize_test
+
+import (
+	"fmt"
+	"maps"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs. Read once; the generators and checks
+// below consult it (the generators when they are built).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// chars is a string of lo to hi characters of the pool.
+func chars(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// pastKnown is g, or under HEGEL_NO_KNOWN=1 only the cases of g that clear the recorded bugs.
+func pastKnown[T any](g hegel.Generator[T], clear func(T) bool) hegel.Generator[T] {
+	if !noKnown {
+		return g
+	}
+	return hegel.Filter(g, clear)
+}
+
+// scaled is a drawn integer scaled by a drawn power of ten: divided for a negative exponent, so
+// that a decimal with that many places comes out as strconv reads it.
+func scaled(ints hegel.Generator[int64], exps hegel.Generator[int]) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		n, e := hegel.Draw(tc, ints), hegel.Draw(tc, exps)
+		if e < 0 {
+			return float64(n) / math.Pow10(-e)
+		}
+		return float64(n) * math.Pow10(e)
+	})
+}
+
+const digitChars = "0123456789"
+
+// ---- exact arithmetic helpers --------------------------------------------------------------
+
+var two64 = new(big.Int).Lsh(big.NewInt(1), 64)
+
+func ratInt(x *big.Int) *big.Rat { return new(big.Rat).SetInt(x) }
+
+// tenPow is 10^k as an exact rational, for any sign of k.
+func tenPow(k int) *big.Rat {
+	p := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(abs(k))), nil)
+	if k < 0 {
+		return new(big.Rat).SetFrac(big.NewInt(1), p)
+	}
+	return ratInt(p)
+}
+
+func abs(k int) int {
+	if k < 0 {
+		return -k
+	}
+	return k
+}
+
+func absRat(r *big.Rat) *big.Rat { return new(big.Rat).Abs(r) }
+
+func ratFloat(f float64) *big.Rat { return new(big.Rat).SetFloat64(f) }
+
+func ratString(r *big.Rat) string { return r.FloatString(12) }
+
+// floorRat is the integer part of a non-negative rational.
+func floorRat(r *big.Rat) *big.Int { return new(big.Int).Quo(r.Num(), r.Denom()) }
+
+// diffWithin reports |a-b| <= tol.
+func diffWithin(a, b, tol *big.Rat) bool {
+	return absRat(new(big.Rat).Sub(a, b)).Cmp(tol) <= 0
+}
+
+// plainDecimal parses an unsigned "digits[.digits]" string exactly, rejecting anything else.
+func plainDecimal(s string) (*big.Rat, bool) {
+	if s == "" || strings.ContainsAny(s, "eE+-") || s[0] < '0' || s[0] > '9' {
+		return nil, false
+	}
+	r, ok := new(big.Rat).SetString(s)
+	return r, ok
+}
+
+// decimalsOf counts the digits after the point of a plain decimal string.
+func decimalsOf(s string) int {
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		return len(s) - i - 1
+	}
+	return 0
+}
+
+func intPartOf(s string) string {
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// ---- the byte size tables ------------------------------------------------------------------
+
+var (
+	siUnits  = []string{"B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB", "RB", "QB"}
+	iecUnits = []string{"B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB", "RiB", "QiB"}
+	// prefixLetters index the tables above: letter i is base^i.
+	prefixLetters = "kmgtpezyrq"
+)
+
+// suffixInfo is one accepted (lower-case) size suffix: its multiplier and whether the uint64
+// parser knows it (bytes.go stops at exa; bigbytes.go goes on to quetta).
+type suffixInfo struct {
+	mult  *big.Int
+	small bool
+}
+
+// sizeSuffixes mirrors bytesSizeTable / bigBytesSizeTable: "", "b", and for each prefix letter
+// the SI forms "k"/"kb" and the IEC forms "ki"/"kib".
+var sizeSuffixes = func() map[string]suffixInfo {
+	m := map[string]suffixInfo{"": {big.NewInt(1), true}, "b": {big.NewInt(1), true}}
+	si, iec := big.NewInt(1), big.NewInt(1)
+	for i := 0; i < len(prefixLetters); i++ {
+		si = new(big.Int).Mul(si, big.NewInt(1000))
+		iec = new(big.Int).Mul(iec, big.NewInt(1024))
+		l := prefixLetters[i : i+1]
+		small := i < 6 // up to exa
+		m[l], m[l+"b"] = suffixInfo{si, small}, suffixInfo{si, small}
+		m[l+"i"], m[l+"ib"] = suffixInfo{iec, small}, suffixInfo{iec, small}
+	}
+	return m
+}()
+
+// sizeSuffixList is every suffix in order, the empty one first.
+var sizeSuffixList = slices.Sorted(maps.Keys(sizeSuffixes))
+
+// magnitude finds the unit index e (capped at maxE) with base^e <= s and the exact mantissa
+// s / base^e.
+func magnitude(s *big.Int, base int64, maxE int) (int, *big.Rat) {
+	e := 0
+	p := big.NewInt(1)
+	for e < maxE {
+		next := new(big.Int).Mul(p, big.NewInt(base))
+		if next.Cmp(s) > 0 {
+			break
+		}
+		p, e = next, e+1
+	}
+	return e, new(big.Rat).SetFrac(s, p)
+}
+
+// carries reports the shape of go-humanize/1: a size of at least a unit whose mantissa is
+// within one of the base, which the printers may round up to the base and print with the unit
+// below (below the first unit the mantissa is a whole number and prints as it is; beyond the
+// last unit it is allowed to grow).
+func carries(s *big.Int, base int64, maxE int) bool {
+	e, mant := magnitude(s, base, maxE)
+	return e >= 1 && e < maxE && mant.Cmp(new(big.Rat).SetInt64(base-1)) >= 0
+}
+
+// splitPrinted splits "NUMBER UNIT".
+func splitPrinted(ht *hegel.T, out string) (string, string) {
+	parts := strings.Split(out, " ")
+	if len(parts) != 2 {
+		ht.Fatalf("%q is not NUMBER UNIT", out)
+	}
+	return parts[0], parts[1]
+}
+
+// upperMask upper-cases the letters of s whose bit is set in mask.
+func upperMask(s string, mask int) string {
+	b := []byte(s)
+	for i := range b {
+		if mask&(1<<i) != 0 && 'a' <= b[i] && b[i] <= 'z' {
+			b[i] -= 'a' - 'A'
+		}
+	}
+	return string(b)
+}
+
+// ---- sizes ---------------------------------------------------------------------------------
+
+// nudge moves a power v of the base to a shape near it: down by k (one to three, so the
+// mantissa is just under the base), up by k (up to a thousand), times k (below the base), or
+// to a midpoint of the printers' rounding plus j: k and a half units (mantissa k.5) or k and a
+// half tenths (mantissa k/10 + 0.05).
+type nudge struct {
+	kind nudgeKind
+	k, j int
+}
+
+type nudgeKind int
+
+const (
+	nudgeDown nudgeKind = iota
+	nudgeUp
+	nudgeTimes
+	nudgeHalf
+	nudgeTenth
+)
+
+func (n nudge) apply(v *big.Int) *big.Int {
+	k, j := big.NewInt(int64(n.k)), big.NewInt(int64(n.j))
+	r := new(big.Int)
+	switch n.kind {
+	case nudgeDown:
+		r.Sub(v, k)
+	case nudgeUp:
+		r.Add(v, k)
+	case nudgeTimes:
+		r.Mul(v, k)
+	case nudgeHalf:
+		r.Mul(v, big.NewInt(int64(2*n.k+1))).Quo(r, big.NewInt(2)).Add(r, j)
+	default:
+		r.Mul(v, big.NewInt(int64(2*n.k+1))).Quo(r, big.NewInt(20)).Add(r, j)
+	}
+	if r.Sign() < 0 {
+		r.SetInt64(0)
+	}
+	return r
+}
+
+// boundary is a power of 1000 or 1024, nudged.
+type boundary struct {
+	base, exp int64
+	n         nudge
+}
+
+func (b boundary) size() *big.Int {
+	return b.n.apply(new(big.Int).Exp(big.NewInt(b.base), big.NewInt(b.exp), nil))
+}
+
+// boundariesUpTo is a boundary with a power from the first up to maxExp.
+func boundariesUpTo(maxExp int64) hegel.Generator[boundary] {
+	return hegel.Composite(func(tc hegel.TestCase) boundary {
+		return boundary{base: hegel.Draw(tc, bases), exp: hegel.Draw(tc, hegel.Integers[int64](1, maxExp)), n: hegel.Draw(tc, nudges)}
+	})
+}
+
+var (
+	// widthSizes: a size of a drawn bit width, so that the whole range is covered
+	// log-uniformly (zero is a boundary nudged down).
+	widthSizes = hegel.FlatMap(hegel.Integers(1, 64), func(bits int) hegel.Generator[uint64] {
+		lo := uint64(1) << (bits - 1)
+		return hegel.Integers(lo, lo|(lo-1))
+	})
+	bases     = hegel.SampledFrom([]int64{1000, 1024})
+	positions = hegel.Integers(0, 1000)
+	nudges    = hegel.OneOf(
+		hegel.Map(hegel.Integers(1, 3), func(k int) nudge { return nudge{kind: nudgeDown, k: k} }),
+		hegel.Map(positions, func(k int) nudge { return nudge{kind: nudgeUp, k: k} }),
+		hegel.Map(hegel.Integers(1, 999), func(k int) nudge { return nudge{kind: nudgeTimes, k: k} }),
+		hegel.Composite(func(tc hegel.TestCase) nudge {
+			return nudge{kind: nudgeHalf, k: hegel.Draw(tc, hegel.Integers(10, 999)), j: hegel.Draw(tc, positions)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) nudge {
+			return nudge{kind: nudgeTenth, k: hegel.Draw(tc, hegel.Integers(10, 99)), j: hegel.Draw(tc, positions)}
+		}),
+	)
+	mask64 = new(big.Int).Sub(two64, big.NewInt(1))
+	// boundarySizes: a boundary of a power up to the sixth, in uint64 (the largest products
+	// wrap, and are sizes still).
+	boundarySizes = hegel.Map(boundariesUpTo(6), func(b boundary) uint64 { return new(big.Int).And(b.size(), mask64).Uint64() })
+	// byteSizes: a uint64 size, near a unit boundary three times in twenty.
+	byteSizes = weighted(choice[uint64]{85, widthSizes}, choice[uint64]{15, boundarySizes})
+
+	// bigSizes: a boundary of a power up to the twelfth (past quetta) twice in five, a uint64
+	// size three times in ten, else a number of one to 36 digits. The boundaries come first:
+	// the printers' decisions happen there, and the first alternative is where the binding's
+	// bias lands (a probe put a 40% second alternative at 15%).
+	bigSizes = weighted(
+		choice[*big.Int]{40, hegel.Map(boundariesUpTo(12), boundary.size)},
+		choice[*big.Int]{30, hegel.Map(byteSizes, func(s uint64) *big.Int { return new(big.Int).SetUint64(s) })},
+		choice[*big.Int]{30, hegel.FlatMap(hegel.Integers(0, 35), func(n int) hegel.Generator[*big.Int] {
+			return hegel.Composite(func(tc hegel.TestCase) *big.Int {
+				v, _ := new(big.Int).SetString(hegel.Draw(tc, chars("123456789", 1, 1))+hegel.Draw(tc, chars(digitChars, n, n)), 10)
+				return v
+			})
+		})},
+	)
+)
+
+// ---- comma models --------------------------------------------------------------------------
+
+// groupThousands inserts commas into a string of digits every three from the right.
+func groupThousands(digits, sep string) string {
+	var sb strings.Builder
+	for i, c := range digits {
+		if i > 0 && (len(digits)-i)%3 == 0 {
+			sb.WriteString(sep)
+		}
+		sb.WriteRune(c)
+	}
+	return sb.String()
+}
+
+// commaModel groups the integer part of a plain signed decimal string.
+func commaModel(s string) string {
+	sign := ""
+	if strings.HasPrefix(s, "-") {
+		sign, s = "-", s[1:]
+	}
+	intPart, frac, hasFrac := strings.Cut(s, ".")
+	out := sign + groupThousands(intPart, ",")
+	if hasFrac {
+		out += "." + frac
+	}
+	return out
+}
+
+// truncateDecimals cuts a decimal string after d digits of fraction (d <= 0 drops the point).
+func truncateDecimals(s string, d int) string {
+	i := strings.IndexByte(s, '.')
+	if i < 0 {
+		return s
+	}
+	if d <= 0 {
+		return s[:i]
+	}
+	if i+1+d >= len(s) {
+		return s
+	}
+	return s[:i+1+d]
+}
+
+// padDecimals appends fraction zeros until s has exactly d of them (d > 0).
+func padDecimals(s string, d int) string {
+	if d <= 0 {
+		return s
+	}
+	i := strings.IndexByte(s, '.')
+	if i < 0 {
+		return s + "." + strings.Repeat("0", d)
+	}
+	if have := len(s) - i - 1; have < d {
+		return s + strings.Repeat("0", d-have)
+	}
+	return s
+}
+
+// stripZeros removes trailing fraction zeros and a bare trailing point.
+func stripZeros(s string) string {
+	if !strings.Contains(s, ".") {
+		return s
+	}
+	s = strings.TrimRight(s, "0")
+	return strings.TrimSuffix(s, ".")
+}
+
+// ---- byte printers -------------------------------------------------------------------------
+
+// printerFn is one of the uint64 printers: Bytes and IBytes print two significant digits,
+// BytesN and IBytesN as many as asked.
+type printerFn int
+
+const (
+	bytesFn printerFn = iota
+	iBytesFn
+	bytesNFn
+	iBytesNFn
+)
+
+func (fn printerFn) iec() bool { return fn == iBytesFn || fn == iBytesNFn }
+
+func (fn printerFn) sized() bool { return fn == bytesNFn || fn == iBytesNFn }
+
+func (fn printerFn) base() (int64, []string) {
+	if fn.iec() {
+		return 1024, iecUnits
+	}
+	return 1000, siUnits
+}
+
+// printerCase: the printer, the size and (BytesN, IBytesN) the significant digits.
+type printerCase struct {
+	fn     printerFn
+	size   uint64
+	digits int
+}
+
+func (c printerCase) what() string {
+	switch c.fn {
+	case bytesFn:
+		return fmt.Sprintf("Bytes(%d)", c.size)
+	case iBytesFn:
+		return fmt.Sprintf("IBytes(%d)", c.size)
+	case bytesNFn:
+		return fmt.Sprintf("BytesN(%d, %d)", c.size, c.digits)
+	}
+	return fmt.Sprintf("IBytesN(%d, %d)", c.size, c.digits)
+}
+
+func (c printerCase) GoString() string { return c.what() }
+
+func (c printerCase) call() string {
+	switch c.fn {
+	case bytesFn:
+		return humanize.Bytes(c.size)
+	case iBytesFn:
+		return humanize.IBytes(c.size)
+	case bytesNFn:
+		return humanize.BytesN(c.size, c.digits)
+	}
+	return humanize.IBytesN(c.size, c.digits)
+}
+
+func (c printerCase) carries() bool {
+	base, _ := c.fn.base()
+	return carries(new(big.Int).SetUint64(c.size), base, 6)
+}
+
+var (
+	printerFns = hegel.SampledFrom([]printerFn{bytesFn, iBytesFn, bytesNFn, iBytesNFn})
+	// printerCases: the sized printers draw one to six digits, the plain ones print two.
+	printerCases = pastKnown(hegel.FlatMap(printerFns, func(fn printerFn) hegel.Generator[printerCase] {
+		digits := hegel.Just(2)
+		if fn.sized() {
+			digits = hegel.Integers(1, 6)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) printerCase {
+			return printerCase{fn: fn, size: hegel.Draw(tc, byteSizes), digits: hegel.Draw(tc, digits)}
+		})
+	}), func(c printerCase) bool { return !c.carries() })
+)
+
+// unitOf finds the printed unit in the table: the largest not exceeding s (index e), or, when
+// the mantissa is within one of the base and rounds up to it, the next one, in which case the
+// mantissa to compare with is divided by the base. A printed number that reaches the base
+// with the unit below is go-humanize/1.
+func unitOf(ht *hegel.T, what, out, unit string, units []string, e int, mant *big.Rat, base int64) (int, *big.Rat) {
+	switch u := slices.Index(units, unit); {
+	case u == e:
+		return e, mant
+	case u == e+1 && u < len(units) && mant.Cmp(big.NewRat(base-1, 1)) >= 0:
+		return u, new(big.Rat).Quo(mant, big.NewRat(base, 1))
+	}
+	ht.Fatalf("%s = %q: unit should be %s (mantissa %s)", what, out, units[e], ratString(mant))
+	panic("unreachable")
+}
+
+// checkSmallPrinted checks the output of Bytes/IBytes/BytesN/IBytesN for s with `digits`
+// significant digits: the unit is the largest not exceeding s (or the next one when the
+// mantissa rounds up to the base), the number has the right shape and stays below the base,
+// it is within the rounding of the exact mantissa (the double rounding of go-humanize/2 is
+// allowed for), and both parsers read the printed value back. A mantissa within one unit of
+// the base is printed with the unit below (go-humanize/1) and ParseBytes multiplies in
+// float64 (go-humanize/3): the first shape is left out of the cases and the second's rounding
+// allowed for only under HEGEL_NO_KNOWN=1.
+func checkSmallPrinted(ht *hegel.T, what, out string, s uint64, base int64, units []string, digits int) {
+	if s < 10 {
+		if want := fmt.Sprintf("%d B", s); out != want {
+			ht.Fatalf("%s = %q, want %q", what, out, want)
+		}
+		return
+	}
+	big_ := new(big.Int).SetUint64(s)
+	e, mant := magnitude(big_, base, 6)
+	num, unit := splitPrinted(ht, out)
+	e, mant = unitOf(ht, what, out, unit, units, e, mant, base)
+	printed, ok := plainDecimal(num)
+	if !ok {
+		ht.Fatalf("%s = %q: not a plain decimal", what, out)
+	}
+	if printed.Cmp(big.NewRat(base, 1)) >= 0 {
+		ht.Fatalf("%s = %q: the number reached the base, want %s with the next unit", what, out, units[e+1])
+	}
+	d := decimalsOf(num)
+	if want := digits - len(intPartOf(num)); (want < 0 && d != 0) || (want >= 0 && d != want) {
+		ht.Fatalf("%s = %q: %d decimals for %d significant digits", what, out, d, digits)
+	}
+	tol := new(big.Rat).Add(tenPow(1-digits), tenPow(-d))
+	tol.Quo(tol, big.NewRat(2, 1))
+	tol.Add(tol, new(big.Rat).Mul(mant, big.NewRat(1, 1e12)))
+	if !diffWithin(printed, mant, tol) {
+		ht.Fatalf("%s = %q but the exact mantissa is %s (tolerance %s)", what, out, ratString(mant), ratString(tol))
+	}
+	// the printed value parses back to s
+	exact := new(big.Rat).Mul(printed, ratInt(new(big.Int).Exp(big.NewInt(base), big.NewInt(int64(e)), nil)))
+	bigBack, err := humanize.ParseBigBytes(out)
+	if err != nil || bigBack.Cmp(floorRat(exact)) != 0 {
+		ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", out, bigBack, err, floorRat(exact))
+	}
+	back, err := humanize.ParseBytes(out)
+	if exact.Cmp(ratInt(two64)) >= 0 {
+		if err == nil {
+			ht.Fatalf("ParseBytes(%q) = %d, but %s bytes do not fit a uint64", out, back, ratString(exact))
+		}
+		return
+	}
+	if err != nil {
+		ht.Fatalf("ParseBytes(%q): %v", out, err)
+	}
+	if !noKnown {
+		if new(big.Int).SetUint64(back).Cmp(floorRat(exact)) != 0 {
+			ht.Fatalf("ParseBytes(%q) = %d, want %s", out, back, floorRat(exact))
+		}
+		return
+	}
+	// go-humanize/3: ParseBytes goes through float64; allow its rounding
+	ptol := new(big.Rat).Mul(exact, big.NewRat(1, 1<<50))
+	ptol.Add(ptol, big.NewRat(1, 1))
+	if !diffWithin(new(big.Rat).SetUint64(back), exact, ptol) {
+		ht.Fatalf("ParseBytes(%q) = %d, want about %s", out, back, ratString(exact))
+	}
+}
+
+func TestHegelBytePrintersFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, printerCases)
+		out := c.call()
+		note(ht, "%s = %q", c.what(), out)
+		base, units := c.fn.base()
+		checkSmallPrinted(ht, c.what(), out, c.size, base, units, c.digits)
+	})
+}
+
+// bigPrinterCase: BigBytes or BigIBytes of a size.
+type bigPrinterCase struct {
+	iec  bool
+	size *big.Int
+}
+
+func (c bigPrinterCase) what() string {
+	if c.iec {
+		return fmt.Sprintf("BigIBytes(%s)", c.size)
+	}
+	return fmt.Sprintf("BigBytes(%s)", c.size)
+}
+
+func (c bigPrinterCase) GoString() string { return c.what() }
+
+func (c bigPrinterCase) call() string {
+	if c.iec {
+		return humanize.BigIBytes(new(big.Int).Set(c.size))
+	}
+	return humanize.BigBytes(new(big.Int).Set(c.size))
+}
+
+func (c bigPrinterCase) base() (int64, []string) {
+	if c.iec {
+		return 1024, iecUnits
+	}
+	return 1000, siUnits
+}
+
+func (c bigPrinterCase) carries() bool {
+	base, units := c.base()
+	return carries(c.size, base, len(units)-1)
+}
+
+var bigPrinterCases = pastKnown(hegel.Composite(func(tc hegel.TestCase) bigPrinterCase {
+	return bigPrinterCase{iec: hegel.Draw(tc, hegel.Booleans()), size: hegel.Draw(tc, bigSizes)}
+}), func(c bigPrinterCase) bool { return !c.carries() })
+
+// checkBigPrinted checks BigBytes/BigIBytes: one decimal below 10, none above, the unit is
+// the largest not exceeding s (or the next one when the mantissa rounds up to the base; the
+// table ends at quetta, beyond which the number grows), the number stays below the base, the
+// value is within the rounding of the exact mantissa, and ParseBigBytes reads it back. The
+// carry zone (go-humanize/1) is left out of the cases and the mantissa truncation of oomm
+// (go-humanize/9) allowed for only under HEGEL_NO_KNOWN=1.
+func checkBigPrinted(ht *hegel.T, what, out string, s *big.Int, base int64, units []string) {
+	if s.Cmp(big.NewInt(10)) < 0 {
+		if want := fmt.Sprintf("%d B", s); out != want {
+			ht.Fatalf("%s = %q, want %q", what, out, want)
+		}
+		return
+	}
+	maxE := len(units) - 1
+	e, mant := magnitude(s, base, maxE)
+	num, unit := splitPrinted(ht, out)
+	e, mant = unitOf(ht, what, out, unit, units, e, mant, base)
+	printed, ok := plainDecimal(num)
+	if !ok {
+		ht.Fatalf("%s = %q: not a plain decimal", what, out)
+	}
+	if e < maxE && printed.Cmp(big.NewRat(base, 1)) >= 0 {
+		ht.Fatalf("%s = %q: the number reached the base, want %s with the next unit", what, out, units[e+1])
+	}
+	d := decimalsOf(num)
+	ten := big.NewRat(10, 1)
+	// go-humanize/9: oomm keeps only the last remainder, so the mantissa it rounds is the
+	// exact one truncated to 1/base; under HEGEL_NO_KNOWN=1 allow that much
+	trunc := new(big.Rat)
+	if noKnown {
+		trunc = big.NewRat(1, base)
+	}
+	if diff := new(big.Rat).Sub(mant, ten); absRat(diff).Cmp(trunc) > 0 {
+		want := 0
+		if mant.Cmp(ten) < 0 {
+			want = 1
+		}
+		if d != want {
+			ht.Fatalf("%s = %q: %d decimals for mantissa %s", what, out, d, ratString(mant))
+		}
+	}
+	tol := new(big.Rat).Quo(tenPow(-d), big.NewRat(2, 1))
+	tol.Add(tol, trunc)
+	tol.Add(tol, new(big.Rat).Mul(mant, big.NewRat(1, 1e9)))
+	if !diffWithin(printed, mant, tol) {
+		ht.Fatalf("%s = %q but the exact mantissa is %s", what, out, ratString(mant))
+	}
+	exact := new(big.Rat).Mul(printed, ratInt(new(big.Int).Exp(big.NewInt(base), big.NewInt(int64(e)), nil)))
+	back, err := humanize.ParseBigBytes(out)
+	if err != nil || back.Cmp(floorRat(exact)) != 0 {
+		ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", out, back, err, floorRat(exact))
+	}
+}
+
+func TestHegelBigBytePrintersFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bigPrinterCases)
+		out := c.call()
+		note(ht, "%s = %q", c.what(), out)
+		base, units := c.base()
+		checkBigPrinted(ht, c.what(), out, c.size, base, units)
+	})
+}
+
+// ---- byte parsers --------------------------------------------------------------------------
+
+// sizeText is a well-formed size string: digit groups joined by commas (the parsers drop
+// commas wherever they stand), a point and fraction digits, a blank, a suffix with some of
+// its letters in upper case, and a trailing blank.
+type sizeText struct {
+	groups   []string
+	point    bool
+	frac     string
+	gap      string
+	suffix   string // lower case, a key of sizeSuffixes
+	caseMask int
+	trail    string
+}
+
+// number is the numeric text: the groups with their commas, then the point and fraction. A
+// number without integer digits always has its point, and a bare point reads "0.".
+func (t sizeText) number() string {
+	s := strings.Join(t.groups, ",")
+	if t.point || s == "" {
+		s += "." + t.frac
+	}
+	if s == "." {
+		s = "0."
+	}
+	return s
+}
+
+func (t sizeText) text() string {
+	return t.number() + t.gap + upperMask(t.suffix, t.caseMask) + t.trail
+}
+
+// value is the exact number of bytes the text denotes (before flooring).
+func (t sizeText) value() *big.Rat {
+	plain := strings.ReplaceAll(t.number(), ",", "")
+	if strings.HasPrefix(plain, ".") {
+		plain = "0" + plain
+	}
+	if strings.HasSuffix(plain, ".") {
+		plain += "0"
+	}
+	v, ok := plainDecimal(plain)
+	if !ok {
+		panic("generator produced " + plain)
+	}
+	return v.Mul(v, ratInt(sizeSuffixes[t.suffix].mult))
+}
+
+func (t sizeText) GoString() string {
+	return fmt.Sprintf("%q = %s bytes", t.text(), floorRat(t.value()))
+}
+
+var (
+	digitGroups = many(chars(digitChars, 1, 8), 0, 3)
+	fracDigits  = chars(digitChars, 0, 9)
+	gaps        = hegel.SampledFrom([]string{"", "", " ", "  ", "\t"})
+	suffixes    = hegel.SampledFrom(sizeSuffixList)
+	caseMasks   = hegel.Integers(0, 7)
+	trails      = maybe(20, hegel.SampledFrom([]string{" ", "\t", "\n"}))
+	sizeTexts   = hegel.Composite(func(tc hegel.TestCase) sizeText {
+		return sizeText{
+			groups:   hegel.Draw(tc, digitGroups),
+			point:    hegel.Draw(tc, chance(60)),
+			frac:     hegel.Draw(tc, fracDigits),
+			gap:      hegel.Draw(tc, gaps),
+			suffix:   hegel.Draw(tc, suffixes),
+			caseMask: hegel.Draw(tc, caseMasks),
+			trail:    hegel.Draw(tc, trails),
+		}
+	})
+)
+
+// TestHegelByteParsersAgreeWithExactArithmetic: ParseBigBytes is exact; ParseBytes rejects the
+// suffixes above exa it does not know and values that do not fit a uint64, and is otherwise
+// exact too - it multiplies in float64 and truncates (go-humanize/3), which is allowed for
+// only under HEGEL_NO_KNOWN=1.
+func TestHegelByteParsersAgreeWithExactArithmetic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sizeTexts)
+		text, value := c.text(), c.value()
+		want := floorRat(value)
+		bigGot, err := humanize.ParseBigBytes(text)
+		if err != nil || bigGot.Cmp(want) != 0 {
+			ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", text, bigGot, err, want)
+		}
+		got, err := humanize.ParseBytes(text)
+		switch {
+		case !sizeSuffixes[c.suffix].small:
+			if err == nil {
+				ht.Fatalf("ParseBytes(%q) = %d; bytes.go does not know %q", text, got, c.suffix)
+			}
+		case want.Cmp(two64) >= 0:
+			if err == nil {
+				ht.Fatalf("ParseBytes(%q) = %d; %s does not fit a uint64", text, got, want)
+			}
+		case noKnown && new(big.Rat).Mul(value, big.NewRat(1<<50+1, 1<<50)).Cmp(ratInt(two64)) >= 0:
+			// within float rounding of 2^64: either answer is acceptable (go-humanize/3)
+		default:
+			if err != nil {
+				ht.Fatalf("ParseBytes(%q): %v; want %s", text, err, want)
+			}
+			if !noKnown {
+				if new(big.Int).SetUint64(got).Cmp(want) != 0 {
+					ht.Fatalf("ParseBytes(%q) = %d, want %s", text, got, want)
+				}
+				return
+			}
+			// go-humanize/3: ParseBytes goes through float64; allow its rounding
+			tol := new(big.Rat).Mul(value, big.NewRat(1, 1<<50))
+			tol.Add(tol, big.NewRat(1, 1))
+			if !diffWithin(new(big.Rat).SetUint64(got), value, tol) {
+				ht.Fatalf("ParseBytes(%q) = %d, want %s", text, got, want)
+			}
+		}
+	})
+}
+
+// junk is a size string both parsers must reject, and why.
+type junk struct{ text, why string }
+
+func (j junk) GoString() string { return fmt.Sprintf("%q (%s)", j.text, j.why) }
+
+// junkOf is a junk of the reason from a text generator.
+func junkOf(why string, texts hegel.Generator[string]) hegel.Generator[junk] {
+	return hegel.Map(texts, func(t string) junk { return junk{t, why} })
+}
+
+// cat concatenates the strings of the parts.
+func cat(parts ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, p := range parts {
+			sb.WriteString(hegel.Draw(tc, p))
+		}
+		return sb.String()
+	})
+}
+
+// decimal is the decimal text of an integer in [lo, hi].
+func decimal(lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Integers(lo, hi), strconv.Itoa)
+}
+
+var (
+	letters      = "abcdefghijklmnopqrstuvwxyz"
+	suffixStarts = chars("b"+prefixLetters, 1, 1)
+	// unknownSuffixes: a letter no suffix starts with and then any letters; or a suffix's first
+	// letter and a continuation that completes none (only "", "b", "i" and "ib" do): another
+	// letter, "b" and more, "i" and a letter other than b, or "ib" and more.
+	unknownSuffixes = hegel.OneOf(
+		cat(chars("acdfhijlnosuvwx", 1, 1), chars(letters, 0, 3)),
+		cat(suffixStarts, chars("acdefghjklmnopqrstuvwxyz", 1, 1), chars(letters, 0, 2)),
+		cat(suffixStarts, hegel.Just("b"), chars(letters, 1, 2)),
+		cat(suffixStarts, hegel.Just("i"), chars("acdefghijklmnopqrstuvwxyz", 1, 1), chars(letters, 0, 1)),
+		cat(suffixStarts, hegel.Just("ib"), chars(letters, 1, 1)),
+	)
+	junkTexts = hegel.OneOf(
+		junkOf("no digits", hegel.SampledFrom([]string{"", ".", ",", " ", "kB", "B"})),
+		junkOf("leading sign", cat(hegel.SampledFrom([]string{"+", "-"}), hegel.Map(sizeTexts, sizeText.text))),
+		junkOf("leading blank", cat(hegel.SampledFrom([]string{" ", "\t"}), hegel.Map(sizeTexts, sizeText.text))),
+		junkOf("exponent", cat(decimal(1, 99), hegel.Just("e"), decimal(0, 9), hegel.SampledFrom([]string{"", " kB"}))),
+		junkOf("two points", cat(decimal(0, 99), hegel.Just("."), chars(digitChars, 0, 3), hegel.Just("."), chars(digitChars, 0, 3))),
+		junkOf("unknown suffix", cat(decimal(0, 999), hegel.SampledFrom([]string{"", " "}), hegel.Composite(func(tc hegel.TestCase) string {
+			return upperMask(hegel.Draw(tc, unknownSuffixes), hegel.Draw(tc, hegel.Integers(0, 15)))
+		}))),
+		junkOf("blank inside the suffix", cat(decimal(0, 999), hegel.Just(" "), hegel.SampledFrom([]string{"k B", "Mi B", "G iB", "k  b"}))),
+		junkOf("trailing junk", cat(decimal(0, 999), hegel.SampledFrom([]string{"_000", "0x10", "kBs", "bytes", "kbps"}))),
+	)
+)
+
+// decimalSizeTexts is the region of sizeText where ParseBytes goes wrong (go-humanize/3): a
+// short decimal with a fraction and a multiplier the float64 product can miss by one, small
+// enough to fit a uint64 (up to peta). The wide generator reaches it in a few percent of cases.
+var decimalSizeTexts = hegel.Composite(func(tc hegel.TestCase) sizeText {
+	places := hegel.Draw(tc, hegel.Integers(1, 3))
+	return sizeText{
+		groups:   []string{strconv.Itoa(hegel.Draw(tc, hegel.Integers(0, 999)))},
+		point:    true,
+		frac:     fmt.Sprintf("%0*d", places, hegel.Draw(tc, hegel.Integers(0, int(math.Pow10(places))-1))),
+		gap:      hegel.Draw(tc, gaps),
+		suffix:   hegel.Draw(tc, hegel.SampledFrom([]string{"k", "kb", "ki", "kib", "m", "mb", "mi", "mib", "g", "gb", "gi", "gib", "t", "tb", "ti", "tib", "p", "pb", "pi", "pib"})),
+		caseMask: hegel.Draw(tc, caseMasks),
+		trail:    hegel.Draw(tc, trails),
+	}
+})
+
+// TestHegelDecimalSizesParseExactly: a decimal size with a multiplier denotes an exact number
+// of bytes, and both parsers give it back. ParseBytes multiplies in float64 and truncates
+// (go-humanize/3), so it is one short for "1.007 kB" and the like; the wide property above
+// reaches that shape only in a few percent of its cases, this one draws nothing else. Under
+// HEGEL_NO_KNOWN=1 ParseBytes is allowed its float64 rounding.
+func TestHegelDecimalSizesParseExactly(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, decimalSizeTexts)
+		text, value := c.text(), c.value()
+		want := floorRat(value)
+		bigGot, err := humanize.ParseBigBytes(text)
+		if err != nil || bigGot.Cmp(want) != 0 {
+			ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", text, bigGot, err, want)
+		}
+		got, err := humanize.ParseBytes(text)
+		if err != nil {
+			ht.Fatalf("ParseBytes(%q): %v", text, err)
+		}
+		if noKnown {
+			tol := new(big.Rat).Mul(value, big.NewRat(1, 1<<50))
+			tol.Add(tol, big.NewRat(1, 1))
+			if !diffWithin(new(big.Rat).SetUint64(got), value, tol) {
+				ht.Fatalf("ParseBytes(%q) = %d, want about %s", text, got, ratString(value))
+			}
+			return
+		}
+		if new(big.Int).SetUint64(got).Cmp(want) != 0 {
+			ht.Fatalf("ParseBytes(%q) = %d, want %s", text, got, want)
+		}
+	})
+}
+
+func TestHegelByteParsersRejectJunk(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, junkTexts)
+		if got, err := humanize.ParseBytes(c.text); err == nil {
+			ht.Fatalf("ParseBytes(%q) = %d, but the text has a %s", c.text, got, c.why)
+		}
+		if got, err := humanize.ParseBigBytes(c.text); err == nil || got != nil {
+			ht.Fatalf("ParseBigBytes(%q) = %v, %v, but the text has a %s", c.text, got, err, c.why)
+		}
+	})
+}
+
+// ---- floats --------------------------------------------------------------------------------
+
+// floats: a small integer, an eighth, a decimal of up to eight places, an integer times a power
+// of ten up to 10^12, or any finite float64.
+var floats = hegel.OneOf(
+	hegel.Map(hegel.Integers(-2000, 2000), func(k int) float64 { return float64(k) }),
+	hegel.Map(hegel.Integers(-2000, 2000), func(k int) float64 { return float64(k) / 8 }),
+	scaled(hegel.Integers[int64](-1e15, 1e15), hegel.Integers(-8, 0)),
+	scaled(hegel.Integers[int64](-1e9, 1e9), hegel.Integers(0, 12)),
+	hegel.Floats[float64]().AllowNaN(false).AllowInfinity(false),
+)
+
+// ---- comma formatters ----------------------------------------------------------------------
+
+// commaCase is one call of the comma family: which function and its arguments.
+type commaCase struct {
+	kind commaKind
+	i    int64    // commaInt
+	f    float64  // commaFloat, commaFloatDigits
+	d    int      // commaFloatDigits
+	n    *big.Int // commaBig; the integer digits of commaBigFloat
+	neg  bool     // commaBig, commaBigFloat
+	frac string   // commaBigFloat: ".digits" or ""
+	k    int      // commaFormatInteger
+}
+
+type commaKind int
+
+const (
+	commaInt commaKind = iota
+	commaFloat
+	commaFloatDigits
+	commaBig
+	commaBigFloat
+	commaFormatInteger
+)
+
+// signed is the big integer with its sign.
+func (c commaCase) signed() *big.Int {
+	v := new(big.Int).Set(c.n)
+	if c.neg {
+		v.Neg(v)
+	}
+	return v
+}
+
+// bigFloatText is the decimal text of the BigCommaf argument.
+func (c commaCase) bigFloatText() string { return c.signed().String() + c.frac }
+
+func (c commaCase) GoString() string {
+	switch c.kind {
+	case commaInt:
+		return fmt.Sprintf("Comma(%d)", c.i)
+	case commaFloat:
+		return fmt.Sprintf("Commaf(%v)", c.f)
+	case commaFloatDigits:
+		return fmt.Sprintf("CommafWithDigits(%v, %d)", c.f, c.d)
+	case commaBig:
+		return fmt.Sprintf("BigComma(%s)", c.signed())
+	case commaBigFloat:
+		return fmt.Sprintf("BigCommaf(%s)", c.bigFloatText())
+	}
+	return fmt.Sprintf("FormatInteger(\"#,###.\", %d)", c.k)
+}
+
+var (
+	int64s = hegel.OneOf(
+		hegel.SampledFrom([]int64{0, 7, 8, -1, -8, 999, 1000, -1000, math.MaxInt64, math.MinInt64, math.MinInt64 + 1}),
+		hegel.Integers[int64](-1e6, 1e6),
+		hegel.Integers[int64](math.MinInt64, math.MaxInt64),
+	)
+	commaDigits = hegel.Integers(-1, 10)
+	// bigFractions: none twice in five, else a point and one to twelve digits.
+	bigFractions = maybe(60, hegel.Map(chars(digitChars, 1, 12), func(f string) string { return "." + f }))
+	// formatIntegers: FormatInteger agrees with Comma below 2^52; from there its float64
+	// rounder is off by one (go-humanize/8), so under HEGEL_NO_KNOWN=1 only the range below.
+	formatIntegers = func() hegel.Generator[int] {
+		below := hegel.Integers(-(1<<52 - 1), 1<<52-1)
+		if noKnown {
+			return below
+		}
+		return hegel.OneOf(below, hegel.Integers(math.MinInt, math.MaxInt))
+	}()
+	commaCases = hegel.OneOf(
+		hegel.Map(int64s, func(i int64) commaCase { return commaCase{kind: commaInt, i: i} }),
+		hegel.Map(floats, func(f float64) commaCase { return commaCase{kind: commaFloat, f: f} }),
+		hegel.Composite(func(tc hegel.TestCase) commaCase {
+			return commaCase{kind: commaFloatDigits, f: hegel.Draw(tc, floats), d: hegel.Draw(tc, commaDigits)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) commaCase {
+			return commaCase{kind: commaBig, n: hegel.Draw(tc, bigSizes), neg: hegel.Draw(tc, hegel.Booleans())}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) commaCase {
+			return commaCase{kind: commaBigFloat, n: hegel.Draw(tc, bigSizes), neg: hegel.Draw(tc, hegel.Booleans()), frac: hegel.Draw(tc, bigFractions)}
+		}),
+		hegel.Map(formatIntegers, func(k int) commaCase { return commaCase{kind: commaFormatInteger, k: k} }),
+	)
+)
+
+func TestHegelCommaFormattersFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, commaCases)
+		switch c.kind {
+		case commaInt:
+			got, want := humanize.Comma(c.i), commaModel(strconv.FormatInt(c.i, 10))
+			note(ht, "Comma = %q", got)
+			if got != want {
+				ht.Fatalf("Comma(%d) = %q, want %q", c.i, got, want)
+			}
+		case commaFloat:
+			got, want := humanize.Commaf(c.f), commaModel(strconv.FormatFloat(c.f, 'f', -1, 64))
+			note(ht, "Commaf = %q", got)
+			if got != want {
+				ht.Fatalf("Commaf(%v) = %q, want %q", c.f, got, want)
+			}
+		case commaFloatDigits:
+			got := humanize.CommafWithDigits(c.f, c.d)
+			// since 40736da3 (Fix #105) the result is padded to exactly d decimals
+			want := padDecimals(truncateDecimals(commaModel(strconv.FormatFloat(c.f, 'f', -1, 64)), c.d), c.d)
+			note(ht, "CommafWithDigits = %q", got)
+			if got != want {
+				ht.Fatalf("CommafWithDigits(%v, %d) = %q, want %q", c.f, c.d, got, want)
+			}
+		case commaBig:
+			v := c.signed()
+			got, want := humanize.BigComma(new(big.Int).Set(v)), commaModel(v.String())
+			note(ht, "BigComma = %q", got)
+			if got != want {
+				ht.Fatalf("BigComma(%s) = %q, want %q", v, got, want)
+			}
+		case commaBigFloat:
+			text := c.bigFloatText()
+			v, _, err := big.ParseFloat(text, 10, 256, big.ToNearestEven)
+			if err != nil {
+				ht.Fatalf("generator: %v", err)
+			}
+			want := commaModel(v.Text('f', -1))
+			before := new(big.Float).Copy(v)
+			// go-humanize/5: BigCommaf calls v.Abs(v) on its argument; under HEGEL_NO_KNOWN=1
+			// it is handed a copy
+			arg := v
+			if noKnown {
+				arg = new(big.Float).Copy(v)
+			}
+			got := humanize.BigCommaf(arg)
+			note(ht, "BigCommaf = %q", got)
+			if got != want {
+				ht.Fatalf("BigCommaf(%s) = %q, want %q", text, got, want)
+			}
+			if v.Cmp(before) != 0 {
+				ht.Fatalf("BigCommaf(%s) changed its argument to %s", text, v.Text('f', -1))
+			}
+		default:
+			// FormatInteger with a plain grouping format agrees with Comma on integers
+			got, want := humanize.FormatInteger("#,###.", c.k), humanize.Comma(int64(c.k))
+			note(ht, "FormatInteger = %q", got)
+			if got != want {
+				ht.Fatalf("FormatInteger(\"#,###.\", %d) = %q, but Comma gives %q", c.k, got, want)
+			}
+		}
+	})
+}
+
+// ---- FormatFloat ---------------------------------------------------------------------------
+
+// ffFormat is a FormatFloat format string and how the documentation reads it.
+type ffFormat struct {
+	format, thousand, decimal string
+	precision                 int
+	plus                      bool
+}
+
+var ffFormats = []ffFormat{
+	{"", ",", ".", 2, false},
+	{"#,###.##", ",", ".", 2, false},
+	{"#,###.", ",", ".", 0, false},
+	{"#,###", "", ",", 3, false},
+	{"# ###,##", " ", ",", 2, false},
+	{"#.###,######", ".", ",", 6, false},
+	{"#.##", "", ".", 2, false},
+	{"#.#########", "", ".", 9, false},
+	{"###", "", ".", 9, false},
+	{"0000", "", ".", 9, false},
+	{"+#,###.##", ",", ".", 2, true},
+	{"+#.###", "", ".", 3, true},
+	{"+#", "", ".", 9, true},
+}
+
+// ffCase: a format (an index into ffFormats, or one of the documented-invalid formats as
+// bad) and the value.
+type ffCase struct {
+	bad    string
+	format int
+	f      float64
+}
+
+func (c ffCase) GoString() string {
+	if c.bad != "" {
+		return fmt.Sprintf("FormatFloat(%q, %v), an invalid format", c.bad, c.f)
+	}
+	return fmt.Sprintf("FormatFloat(%q, %v)", ffFormats[c.format].format, c.f)
+}
+
+var (
+	// ffValues: thousandths, up to a million with three places, up to 10^12 with nine, and
+	// integers times a power of ten up to 10^19 (past int64: go-humanize/7, fixed upstream).
+	ffValues = hegel.OneOf(
+		hegel.Map(hegel.Integers(-2000, 2000), func(k int) float64 { return float64(k) / 1000 }),
+		scaled(hegel.Integers[int64](-1e6, 1e6), hegel.Integers(-3, 0)),
+		scaled(hegel.Integers[int64](-1e12, 1e12), hegel.Integers(-9, 0)),
+		scaled(hegel.Integers[int64](-1e6, 1e6), hegel.Integers(0, 13)),
+	)
+	formatIndex = hegel.Integers(0, len(ffFormats)-1)
+	badFormats  = hegel.SampledFrom([]string{"#,##.##", "#,####.##", "x###", "-#.##", "#,#.#"})
+	// ffCases: an invalid format once in ten.
+	ffCases = weighted(
+		choice[ffCase]{90, hegel.Composite(func(tc hegel.TestCase) ffCase {
+			return ffCase{format: hegel.Draw(tc, formatIndex), f: hegel.Draw(tc, ffValues)}
+		})},
+		choice[ffCase]{10, hegel.Composite(func(tc hegel.TestCase) ffCase {
+			return ffCase{bad: hegel.Draw(tc, badFormats), f: hegel.Draw(tc, ffValues)}
+		})},
+	)
+)
+
+func TestHegelFormatFloatFollowsItsFormat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, ffCases)
+		f := c.f
+		if bad := c.bad; bad != "" {
+			// documented-invalid formats panic with a FormatFloat() message
+			func() {
+				defer func() {
+					r := recover()
+					if s, ok := r.(string); !ok || !strings.Contains(s, "FormatFloat()") {
+						ht.Fatalf("FormatFloat(%q, %v) did not panic with a FormatFloat() message: %v", bad, f, r)
+					}
+				}()
+				humanize.FormatFloat(bad, f)
+			}()
+			return
+		}
+		ff := ffFormats[c.format]
+		got := humanize.FormatFloat(ff.format, f)
+		note(ht, "FormatFloat = %q", got)
+		rest := got
+		wantSign := ""
+		if f <= -1e-9 {
+			wantSign = "-"
+		} else if f >= 1e-9 && ff.plus {
+			wantSign = "+"
+		}
+		if !strings.HasPrefix(rest, wantSign) {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: sign should be %q", ff.format, f, got, wantSign)
+		}
+		rest = rest[len(wantSign):]
+		intPart, frac := rest, ""
+		if ff.precision > 0 {
+			var found bool
+			intPart, frac, found = strings.Cut(rest, ff.decimal)
+			if !found || len(frac) != ff.precision {
+				ht.Fatalf("FormatFloat(%q, %v) = %q: want %d digits after %q", ff.format, f, got, ff.precision, ff.decimal)
+			}
+		}
+		digits := intPart
+		if ff.thousand != "" {
+			digits = strings.ReplaceAll(intPart, ff.thousand, "")
+			if groupThousands(digits, ff.thousand) != intPart {
+				ht.Fatalf("FormatFloat(%q, %v) = %q: integer part is not grouped by %q", ff.format, f, got, ff.thousand)
+			}
+		}
+		plain := digits
+		if frac != "" {
+			plain += "." + frac
+		}
+		value, ok := plainDecimal(plain)
+		if !ok {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: %q is not a number", ff.format, f, got, plain)
+		}
+		// the value is |f| rounded half up at the precision; the float rounder may lose one
+		// unit in the last place
+		tol := new(big.Rat).Mul(tenPow(-ff.precision), big.NewRat(3, 2))
+		tol.Add(tol, new(big.Rat).Mul(absRat(ratFloat(f)), big.NewRat(1, 1e14)))
+		want := absRat(ratFloat(f))
+		if math.Abs(f) < 1e-9 {
+			want = new(big.Rat)
+		}
+		if !diffWithin(value, want, tol) {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: value %s is not %s to %d places", ff.format, f, got, plain, ratString(want), ff.precision)
+		}
+	})
+}
+
+// ---- Ftoa, SI, Ordinal ---------------------------------------------------------------------
+
+var siPrefixes = map[int]string{
+	-30: "q", -27: "r", -24: "y", -21: "z", -18: "a", -15: "f", -12: "p", -9: "n", -6: "\u00b5", -3: "m",
+	0: "", 3: "k", 6: "M", 9: "G", 12: "T", 15: "P", 18: "E", 21: "Z", 24: "Y", 27: "R", 30: "Q",
+}
+
+// siUnitNames are units that do not start with a prefix letter (ParseSI cannot tell "m" the
+// unit from "m" the prefix; see the README).
+var siUnitNames = []string{"", "B", "F", "V", "Hz", "W", "s", "\u03a9", "bit/s", "h", "cd"}
+
+// siCase is one call of Ftoa, FtoaWithDigits, ComputeSI/SI/ParseSI, ParseSI on hand-built
+// text, or Ordinal.
+type siCase struct {
+	kind siKind
+	f    float64 // siFtoa, siFtoaDigits
+	d    int     // siFtoaDigits
+	m    float64 // siCompute, siParse: the mantissa
+	k    int     // siCompute, siParse: the exponent, a multiple of three
+	neg  bool    // siCompute
+	unit string  // siCompute, siParse
+	gap  string  // siParse
+	x    int     // siOrdinal
+}
+
+type siKind int
+
+const (
+	siFtoa siKind = iota
+	siFtoaDigits
+	siCompute
+	siParse
+	siOrdinal
+)
+
+// value is the ComputeSI argument: the signed mantissa times ten to the exponent.
+func (c siCase) value() float64 {
+	x := c.m * math.Pow10(c.k)
+	if c.neg {
+		return -x
+	}
+	return x
+}
+
+// parseText is the hand-built ParseSI text: number, blank, prefix, unit.
+func (c siCase) parseText() string {
+	return strconv.FormatFloat(c.m, 'f', -1, 64) + c.gap + siPrefixes[c.k] + c.unit
+}
+
+func (c siCase) GoString() string {
+	switch c.kind {
+	case siFtoa:
+		return fmt.Sprintf("Ftoa(%v)", c.f)
+	case siFtoaDigits:
+		return fmt.Sprintf("FtoaWithDigits(%v, %d)", c.f, c.d)
+	case siCompute:
+		return fmt.Sprintf("ComputeSI(%v), SI(%v, %q)", c.value(), c.value(), c.unit)
+	case siParse:
+		return fmt.Sprintf("ParseSI(%q)", c.parseText())
+	}
+	return fmt.Sprintf("Ordinal(%d)", c.x)
+}
+
+var (
+	ftoaDigits = hegel.Integers(-1, 8)
+	// siMantissas: clear of the decade boundaries, with three decimals.
+	siMantissas    = hegel.Map(hegel.Integers(1001, 998999), func(m int) float64 { return float64(m) / 1000 })
+	siExponents    = hegel.Map(hegel.Integers(-10, 10), func(k int) int { return 3 * k })
+	unitNames      = hegel.SampledFrom(siUnitNames)
+	parseMantissas = scaled(hegel.Integers[int64](-999999, 999999), hegel.Integers(-4, 0))
+	ordinals       = hegel.OneOf(hegel.Integers(0, 100), hegel.Integers(0, 1000000000))
+	siCases        = hegel.OneOf(
+		hegel.Map(floats, func(f float64) siCase { return siCase{kind: siFtoa, f: f} }),
+		hegel.Composite(func(tc hegel.TestCase) siCase {
+			return siCase{kind: siFtoaDigits, f: hegel.Draw(tc, floats), d: hegel.Draw(tc, ftoaDigits)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) siCase {
+			return siCase{kind: siCompute, m: hegel.Draw(tc, siMantissas), k: hegel.Draw(tc, siExponents), neg: hegel.Draw(tc, chance(30)), unit: hegel.Draw(tc, unitNames)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) siCase {
+			return siCase{kind: siParse, m: hegel.Draw(tc, parseMantissas), k: hegel.Draw(tc, siExponents), unit: hegel.Draw(tc, unitNames), gap: hegel.Draw(tc, hegel.SampledFrom([]string{"", " "}))}
+		}),
+		hegel.Map(ordinals, func(x int) siCase { return siCase{kind: siOrdinal, x: x} }),
+	)
+)
+
+func TestHegelFtoaSIAndOrdinalFollowTheirModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, siCases)
+		switch c.kind {
+		case siFtoa:
+			got, want := humanize.Ftoa(c.f), stripZeros(strconv.FormatFloat(c.f, 'f', 6, 64))
+			note(ht, "Ftoa = %q", got)
+			if got != want {
+				ht.Fatalf("Ftoa(%v) = %q, want %q", c.f, got, want)
+			}
+		case siFtoaDigits:
+			got := humanize.FtoaWithDigits(c.f, c.d)
+			want := stripZeros(truncateDecimals(strconv.FormatFloat(c.f, 'f', 6, 64), c.d))
+			note(ht, "FtoaWithDigits = %q", got)
+			if got != want {
+				ht.Fatalf("FtoaWithDigits(%v, %d) = %q, want %q", c.f, c.d, got, want)
+			}
+		case siCompute:
+			// a mantissa clear of the decade boundaries times a tabled power of ten
+			m, k, x, unit := c.m, c.k, c.value(), c.unit
+			v, p := humanize.ComputeSI(x)
+			note(ht, "ComputeSI = %v, %q", v, p)
+			if p != siPrefixes[k] {
+				ht.Fatalf("ComputeSI(%v) = %v, %q; want prefix %q", x, v, p, siPrefixes[k])
+			}
+			if math.Abs(math.Abs(v)-m) > m*1e-9 || (v < 0) != (x < 0) {
+				ht.Fatalf("ComputeSI(%v) = %v, %q; want mantissa %v", x, v, p, math.Copysign(m, x))
+			}
+			s := humanize.SI(x, unit)
+			back, u, err := humanize.ParseSI(s)
+			note(ht, "SI = %q; ParseSI -> %v, %q, %v", s, back, u, err)
+			if err != nil || u != unit || math.Abs(back-x) > math.Abs(x)*1e-6 {
+				ht.Fatalf("SI(%v, %q) = %q does not round-trip: %v, %q, %v", x, unit, s, back, u, err)
+			}
+			if !strings.HasSuffix(s, " "+p+unit) || !strings.HasPrefix(s, humanize.Ftoa(v)) {
+				ht.Fatalf("SI(%v, %q) = %q; want %q", x, unit, s, humanize.Ftoa(v)+" "+p+unit)
+			}
+		case siParse:
+			// ParseSI on hand-built text: number, optional blank, prefix, unit
+			text, unit := c.parseText(), c.unit
+			back, u, err := humanize.ParseSI(text)
+			want := c.m * math.Pow10(c.k)
+			note(ht, "ParseSI = %v, %q, %v", back, u, err)
+			if err != nil || u != unit || math.Abs(back-want) > math.Abs(want)*1e-12 {
+				ht.Fatalf("ParseSI(%q) = %v, %q, %v; want %v, %q", text, back, u, err, want, unit)
+			}
+		default:
+			x := c.x
+			got := humanize.Ordinal(x)
+			suffix := "th"
+			switch {
+			case x%100 >= 11 && x%100 <= 13:
+			case x%10 == 1:
+				suffix = "st"
+			case x%10 == 2:
+				suffix = "nd"
+			case x%10 == 3:
+				suffix = "rd"
+			}
+			note(ht, "Ordinal = %q", got)
+			if want := strconv.Itoa(x) + suffix; got != want {
+				ht.Fatalf("Ordinal(%d) = %q, want %q", x, got, want)
+			}
+		}
+	})
+}
+
+// ---- RelTime -------------------------------------------------------------------------------
+
+// relModel says how RelTime describes a non-negative difference d with label lbl: seconds,
+// minutes, hours, days, weeks, 30-day months and 360-day years, singular below twice the
+// unit, "now" under a second, "a long while" from 37 years.
+func relModel(d time.Duration, lbl string) string {
+	const day = 24 * time.Hour
+	const week, month, year = 7 * day, 30 * day, 360 * day
+	plural := func(k time.Duration, unit string) string { return fmt.Sprintf("%d %ss %s", int64(k), unit, lbl) }
+	switch {
+	case d < time.Second:
+		return "now"
+	case d < 2*time.Second:
+		return "1 second " + lbl
+	case d < time.Minute:
+		return plural(d/time.Second, "second")
+	case d < 2*time.Minute:
+		return "1 minute " + lbl
+	case d < time.Hour:
+		return plural(d/time.Minute, "minute")
+	case d < 2*time.Hour:
+		return "1 hour " + lbl
+	case d < day:
+		return plural(d/time.Hour, "hour")
+	case d < 2*day:
+		return "1 day " + lbl
+	case d < week:
+		return plural(d/day, "day")
+	case d < 2*week:
+		return "1 week " + lbl
+	case d < month:
+		return plural(d/week, "week")
+	case d < 2*month:
+		return "1 month " + lbl
+	case d < year:
+		return plural(d/month, "month")
+	case d < 18*month:
+		return "1 year " + lbl
+	case d < 2*year:
+		return "2 years " + lbl
+	case d < 37*year:
+		return plural(d/year, "year")
+	default:
+		return "a long while " + lbl
+	}
+}
+
+// relBounds are the boundaries of RelTime's table.
+var relBounds = []time.Duration{time.Second, 2 * time.Second, time.Minute, 2 * time.Minute, time.Hour, 2 * time.Hour,
+	24 * time.Hour, 48 * time.Hour, 7 * 24 * time.Hour, 14 * 24 * time.Hour, 30 * 24 * time.Hour,
+	60 * 24 * time.Hour, 360 * 24 * time.Hour, 540 * 24 * time.Hour, 720 * 24 * time.Hour, 37 * 360 * 24 * time.Hour}
+
+// pow10 is 10^e as an int64.
+func pow10(e int) int64 {
+	v := int64(1)
+	for i := 0; i < e; i++ {
+		v *= 10
+	}
+	return v
+}
+
+var (
+	// decadeDurations: a decade of nanoseconds, the top one cut at about 41 years.
+	decadeDurations = hegel.FlatMap(hegel.Integers(0, 18), func(e int) hegel.Generator[time.Duration] {
+		lo := pow10(e)
+		hi := lo*10 - 1
+		if e == 18 {
+			hi = 1300000000 * int64(time.Second)
+		}
+		return hegel.Map(hegel.Integers(lo-1, hi), func(n int64) time.Duration { return time.Duration(n) })
+	})
+	// nearBounds: within two seconds of one of the table's boundaries.
+	nearBounds = hegel.Composite(func(tc hegel.TestCase) time.Duration {
+		return hegel.Draw(tc, hegel.SampledFrom(relBounds)) + time.Duration(hegel.Draw(tc, hegel.Integers[int64](-2e9, 2e9)))
+	})
+	// durations: log-uniform from a nanosecond to about 41 years, near a boundary three
+	// times in ten.
+	durations = weighted(choice[time.Duration]{70, decadeDurations}, choice[time.Duration]{30, nearBounds})
+)
+
+// relCase: the instant a, and the difference of b from it (negated when neg is set).
+type relCase struct {
+	unix, nanos int64
+	d           time.Duration
+	neg         bool
+}
+
+func (c relCase) a() time.Time { return time.Unix(c.unix, c.nanos).UTC() }
+
+func (c relCase) diff() time.Duration {
+	if c.neg {
+		return -c.d
+	}
+	return c.d
+}
+
+func (c relCase) GoString() string { return fmt.Sprintf("RelTime(%v, %+v later)", c.a(), c.diff()) }
+
+var relCases = hegel.Composite(func(tc hegel.TestCase) relCase {
+	return relCase{
+		unix:  hegel.Draw(tc, hegel.Integers[int64](-1e10, 1e10)),
+		nanos: hegel.Draw(tc, hegel.Integers[int64](0, 999999999)),
+		d:     hegel.Draw(tc, durations),
+		neg:   hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+func TestHegelRelTimeFollowsTheTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, relCases)
+		a, d := c.a(), c.diff()
+		b := a.Add(d)
+		got := humanize.RelTime(a, b, "ago", "from now")
+		swapped := humanize.RelTime(b, a, "ago", "from now")
+		note(ht, "%q / %q", got, swapped)
+		want, wantSwapped := relModel(d, "ago"), relModel(d, "from now")
+		if d < 0 {
+			want, wantSwapped = relModel(-d, "from now"), relModel(-d, "ago")
+		}
+		if got != want {
+			ht.Fatalf("RelTime(a, a%+v) = %q, want %q", d, got, want)
+		}
+		if swapped != wantSwapped {
+			ht.Fatalf("RelTime(a%+v, a) = %q, want %q", d, swapped, wantSwapped)
+		}
+	})
+}
+
+// ---- pins ----------------------------------------------------------------------------------
+
+// go-humanize/1: a mantissa that rounds to the base is printed as "1000 kB" / "1024 KiB" /
+// "1000 kF" instead of moving to the next unit.
+func TestHegelPinPrintersCarryIntoTheNextUnit(t *testing.T) {
+	cases := []struct{ what, got, want string }{
+		{"Bytes(999999)", humanize.Bytes(999999), "1.0 MB"},
+		{"BytesN(999500, 3)", humanize.BytesN(999500, 3), "1.00 MB"},
+		{"IBytes(1048575)", humanize.IBytes(1048575), "1.0 MiB"},
+		{"BigBytes(999999)", humanize.BigBytes(big.NewInt(999999)), "1.0 MB"},
+		{"BigIBytes(1048575)", humanize.BigIBytes(big.NewInt(1048575)), "1.0 MiB"},
+		{"SI(999999.9999995, \"F\")", humanize.SI(999999.9999995, "F"), "1 MF"},
+	}
+	for _, c := range cases {
+		if c.got != c.want {
+			t.Errorf("%s = %q, want %q", c.what, c.got, c.want)
+		}
+	}
+}
+
+// go-humanize/2: Bytes rounds twice (to two significant digits, then to an integer with %.0f),
+// so 82.549 MB prints as "82 MB" while BytesN(..., 1) and BigBytes print "83 MB".
+func TestHegelPinBytesRoundsTwice(t *testing.T) {
+	if got := humanize.Bytes(82549000); got != "83 MB" {
+		t.Errorf("Bytes(82549000) = %q, want \"83 MB\" (BytesN(82549000, 1) = %q, BigBytes = %q)",
+			got, humanize.BytesN(82549000, 1), humanize.BigBytes(big.NewInt(82549000)))
+	}
+	if got := humanize.IBytes(1048576*82 + 1048576*549/1000); got != "83 MiB" {
+		t.Errorf("IBytes(82.549 MiB) = %q, want \"83 MiB\"", got)
+	}
+}
+
+// go-humanize/3: ParseBytes multiplies in float64 and truncates, so "1.007 kB" is 1006 bytes
+// (ParseBigBytes says 1007) and sizes just under 2^64 are rejected as too large.
+func TestHegelPinParseBytesIsExact(t *testing.T) {
+	for _, c := range []struct {
+		text string
+		want uint64
+	}{
+		{"1.007 kB", 1007},
+		{"16.1 PB", 16100000000000000},
+		{"18446744073709551615", math.MaxUint64},
+		{"18446744073709551000 B", 18446744073709551000},
+	} {
+		got, err := humanize.ParseBytes(c.text)
+		if err != nil || got != c.want {
+			big_, _ := humanize.ParseBigBytes(c.text)
+			t.Errorf("ParseBytes(%q) = %d, %v; want %d (ParseBigBytes says %v)", c.text, got, err, c.want, big_)
+		}
+	}
+}
+
+// go-humanize/4: Commaf puts a thousands separator into "Inf".
+func TestHegelPinCommafOfInfinity(t *testing.T) {
+	for _, f := range []float64{math.Inf(1), math.Inf(-1)} {
+		got, want := humanize.Commaf(f), strconv.FormatFloat(f, 'f', -1, 64)
+		if got != want {
+			t.Errorf("Commaf(%v) = %q, want %q", f, got, want)
+		}
+	}
+}
+
+// go-humanize/5: BigCommaf calls v.Abs(v) and so flips the sign of a negative argument.
+func TestHegelPinBigCommafLeavesItsArgumentAlone(t *testing.T) {
+	v := big.NewFloat(-1234567.5)
+	got := humanize.BigCommaf(v)
+	if v.Sign() >= 0 {
+		t.Errorf("BigCommaf(-1234567.5) = %q and the argument is now %v", got, v)
+	}
+}
+
+// go-humanize/6: outside the quecto..quetta table ComputeSI finds no prefix and returns the
+// bare mantissa, so SI(1e-31, "F") is "100 F" and SI(1e-33, "F") is "1 F".
+func TestHegelPinSIBeyondThePrefixTable(t *testing.T) {
+	for _, x := range []float64{1e-31, 1e-33, 1e34, 1e40} {
+		s := humanize.SI(x, "F")
+		back, unit, err := humanize.ParseSI(s)
+		if err != nil || unit != "F" || math.Abs(back-x) > x*1e-6 {
+			t.Errorf("SI(%g, \"F\") = %q, which reads back as %v %q, %v", x, s, back, unit, err)
+		}
+	}
+}
+
+// go-humanize/7: FormatFloat converts the integer part with int64(), so from 2^63 the digits
+// are those of math.MinInt64 (and a negative number gets two minus signs).
+func TestHegelPinFormatFloatBeyondInt64(t *testing.T) {
+	for _, c := range []struct {
+		n    float64
+		want string
+	}{
+		{1e19, "10,000,000,000,000,000,000"},
+		{-1e19, "-10,000,000,000,000,000,000"},
+		{math.MaxUint64, "18,446,744,073,709,551,616"},
+	} {
+		if got := humanize.FormatFloat("#,###.", c.n); got != c.want {
+			t.Errorf("FormatFloat(\"#,###.\", %g) = %q, want %q", c.n, got, c.want)
+		}
+	}
+}
+
+// go-humanize/8: FormatInteger adds a float64 rounder of 0.5 before truncating, so from 2^52
+// odd integers print as the next even one.
+func TestHegelPinFormatIntegerNearTwoToTheFiftyTwo(t *testing.T) {
+	for _, k := range []int{1<<52 + 1, 1<<52 + 3, -(1<<52 + 1), 1<<53 - 1} {
+		if got, want := humanize.FormatInteger("#,###.", k), humanize.Comma(int64(k)); got != want {
+			t.Errorf("FormatInteger(\"#,###.\", %d) = %q, want %q", k, got, want)
+		}
+	}
+}
+
+// go-humanize/9: BigBytes and BigIBytes round a mantissa that keeps only the last division
+// remainder (oomm), i.e. the exact one truncated to 1/1000 or 1/1024, so values just above a
+// rounding boundary round down.
+func TestHegelPinBigBytesKeepOnlyTheLastRemainder(t *testing.T) {
+	cases := []struct {
+		s, want string
+		iec     bool
+	}{
+		{"1950000001", "2.0 GB", false},
+		{"82500001", "83 MB", false},
+		{"6080047000000000000000", "5.2 ZiB", true},
+	}
+	for _, c := range cases {
+		v, _ := new(big.Int).SetString(c.s, 10)
+		got, what := humanize.BigBytes(new(big.Int).Set(v)), "BigBytes"
+		if c.iec {
+			got, what = humanize.BigIBytes(new(big.Int).Set(v)), "BigIBytes"
+		}
+		if got != c.want {
+			t.Errorf("%s(%s) = %q, want %q", what, c.s, got, c.want)
+		}
+	}
+}
