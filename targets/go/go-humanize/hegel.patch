+// Hegel property tests for github.com/dustin/go-humanize: the byte printers and parsers against
+// exact (math/big) arithmetic, the comma and FormatFloat formatters against string-insertion
+// models, SI prefixes and ordinals against their tables, and RelTime against an independent
+// calendar model.
+package humanize_test
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---- exact arithmetic helpers --------------------------------------------------------------
+
+var two64 = new(big.Int).Lsh(big.NewInt(1), 64)
+
+func ratInt(x *big.Int) *big.Rat { return new(big.Rat).SetInt(x) }
+
+// tenPow is 10^k as an exact rational, for any sign of k.
+func tenPow(k int) *big.Rat {
+	p := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(abs(k))), nil)
+	if k < 0 {
+		return new(big.Rat).SetFrac(big.NewInt(1), p)
+	}
+	return ratInt(p)
+}
+
+func abs(k int) int {
+	if k < 0 {
+		return -k
+	}
+	return k
+}
+
+func absRat(r *big.Rat) *big.Rat { return new(big.Rat).Abs(r) }
+
+func ratFloat(f float64) *big.Rat { return new(big.Rat).SetFloat64(f) }
+
+func ratString(r *big.Rat) string { return r.FloatString(12) }
+
+// floorRat is the integer part of a non-negative rational.
+func floorRat(r *big.Rat) *big.Int { return new(big.Int).Quo(r.Num(), r.Denom()) }
+
+// diffWithin reports |a-b| <= tol.
+func diffWithin(a, b, tol *big.Rat) bool {
+	return absRat(new(big.Rat).Sub(a, b)).Cmp(tol) <= 0
+}
+
+// plainDecimal parses an unsigned "digits[.digits]" string exactly, rejecting anything else.
+func plainDecimal(s string) (*big.Rat, bool) {
+	if s == "" || strings.ContainsAny(s, "eE+-") || s[0] < '0' || s[0] > '9' {
+		return nil, false
+	}
+	r, ok := new(big.Rat).SetString(s)
+	return r, ok
+}
+
+// decimalsOf counts the digits after the point of a plain decimal string.
+func decimalsOf(s string) int {
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		return len(s) - i - 1
+	}
+	return 0
+}
+
+func intPartOf(s string) string {
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// ---- the byte size tables ------------------------------------------------------------------
+
+var (
+	siUnits  = []string{"B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB", "RB", "QB"}
+	iecUnits = []string{"B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB", "RiB", "QiB"}
+	// prefixLetters index the tables above: letter i is base^i.
+	prefixLetters = "kmgtpezyrq"
+)
+
+// suffixInfo is one accepted (lower-case) size suffix: its multiplier and whether the uint64
+// parser knows it (bytes.go stops at exa; bigbytes.go goes on to quetta).
+type suffixInfo struct {
+	mult  *big.Int
+	small bool
+}
+
+// sizeSuffixes mirrors bytesSizeTable / bigBytesSizeTable: "", "b", and for each prefix letter
+// the SI forms "k"/"kb" and the IEC forms "ki"/"kib".
+var sizeSuffixes = func() map[string]suffixInfo {
+	m := map[string]suffixInfo{"": {big.NewInt(1), true}, "b": {big.NewInt(1), true}}
+	si, iec := big.NewInt(1), big.NewInt(1)
+	for i := 0; i < len(prefixLetters); i++ {
+		si = new(big.Int).Mul(si, big.NewInt(1000))
+		iec = new(big.Int).Mul(iec, big.NewInt(1024))
+		l := prefixLetters[i : i+1]
+		small := i < 6 // up to exa
+		m[l], m[l+"b"] = suffixInfo{si, small}, suffixInfo{si, small}
+		m[l+"i"], m[l+"ib"] = suffixInfo{iec, small}, suffixInfo{iec, small}
+	}
+	return m
+}()
+
+var sizeSuffixList = func() []string {
+	var xs []string
+	for k := range sizeSuffixes {
+		xs = append(xs, k)
+	}
+	sortStrings(xs)
+	return xs
+}()
+
+func sortStrings(xs []string) {
+	for i := 1; i < len(xs); i++ {
+		for j := i; j > 0 && xs[j] < xs[j-1]; j-- {
+			xs[j], xs[j-1] = xs[j-1], xs[j]
+		}
+	}
+}
+
+// magnitude finds the unit index e (capped at maxE) with base^e <= s and the exact mantissa
+// s / base^e.
+func magnitude(s *big.Int, base int64, maxE int) (int, *big.Rat) {
+	e := 0
+	p := big.NewInt(1)
+	for e < maxE {
+		next := new(big.Int).Mul(p, big.NewInt(base))
+		if next.Cmp(s) > 0 {
+			break
+		}
+		p, e = next, e+1
+	}
+	return e, new(big.Rat).SetFrac(s, p)
+}
+
+// splitPrinted splits "NUMBER UNIT".
+func splitPrinted(ht *hegel.T, out string) (string, string) {
+	parts := strings.Split(out, " ")
+	if len(parts) != 2 {
+		ht.Fatalf("%q is not NUMBER UNIT", out)
+	}
+	return parts[0], parts[1]
+}
+
+// randomCase flips the case of each letter at random.
+func randomCase(tc hegel.TestCase, s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if chance(tc, 50) {
+			if 'a' <= c && c <= 'z' {
+				b[i] = c - 32
+			} else if 'A' <= c && c <= 'Z' {
+				b[i] = c + 32
+			}
+		}
+	}
+	return string(b)
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+// genSize draws a uint64 spread log-uniformly over the whole range, with a bias towards the
+// unit boundaries.
+func genSize(tc hegel.TestCase) uint64 {
+	if chance(tc, 15) {
+		base := uint64(1000)
+		if chance(tc, 50) {
+			base = 1024
+		}
+		v := uint64(1)
+		for i, k := 0, n(tc, 0, 6); i < k; i++ {
+			v *= base
+		}
+		switch n(tc, 0, 3) {
+		case 0:
+			return v
+		case 1:
+			return v - 1
+		case 2:
+			return v + uint64(n(tc, 0, 1000))
+		default:
+			return v * uint64(n(tc, 1, 999))
+		}
+	}
+	bits := n(tc, 0, 64)
+	switch {
+	case bits == 0:
+		return uint64(n(tc, 0, 9))
+	case bits == 64:
+		return 1<<63 | uint64(wide(tc, 0, math.MaxInt64))
+	default:
+		return uint64(1)<<(bits-1) | uint64(wide(tc, 0, int64(1)<<(bits-1)-1))
+	}
+}
+
+// genBigSize draws a non-negative big.Int with up to 36 digits.
+func genBigSize(tc hegel.TestCase) *big.Int {
+	if chance(tc, 40) {
+		return new(big.Int).SetUint64(genSize(tc))
+	}
+	digits := n(tc, 1, 36)
+	var sb strings.Builder
+	sb.WriteByte(byte('1' + n(tc, 0, 8)))
+	for i := 1; i < digits; i++ {
+		sb.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	v, _ := new(big.Int).SetString(sb.String(), 10)
+	return v
+}
+
+// genDigits draws k decimal digits.
+func genDigits(tc hegel.TestCase, k int) string {
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		sb.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	return sb.String()
+}
+
+// genSizeText draws a well-formed size string and its exact value: digits with optional commas,
+// an optional fraction, optional whitespace, a suffix in any case, optional trailing blanks.
+// It returns the text, the value and the (lower-case) suffix used.
+func genSizeText(tc hegel.TestCase) (string, *big.Rat, string) {
+	intDigits := genDigits(tc, n(tc, 0, 22))
+	if intDigits != "" && chance(tc, 30) {
+		// commas anywhere between digits; the parsers just drop them
+		var sb strings.Builder
+		for i := 0; i < len(intDigits); i++ {
+			if i > 0 && chance(tc, 30) {
+				sb.WriteByte(',')
+			}
+			sb.WriteByte(intDigits[i])
+		}
+		intDigits = sb.String()
+	}
+	frac := ""
+	if chance(tc, 60) || intDigits == "" {
+		frac = "." + genDigits(tc, n(tc, 0, 9))
+	}
+	if strings.Trim(intDigits+frac, ".") == "" {
+		intDigits = "0"
+	}
+	number := intDigits + frac
+	plain := strings.ReplaceAll(number, ",", "")
+	if plain == "." {
+		plain = "0"
+	}
+	if strings.HasPrefix(plain, ".") {
+		plain = "0" + plain
+	}
+	if strings.HasSuffix(plain, ".") {
+		plain += "0"
+	}
+	value, ok := plainDecimal(plain)
+	if !ok {
+		panic("generator produced " + plain)
+	}
+	suffix := pick(tc, sizeSuffixList)
+	value.Mul(value, ratInt(sizeSuffixes[suffix].mult))
+	text := number + pick(tc, []string{"", "", " ", "  ", "\t"}) + randomCase(tc, suffix)
+	if chance(tc, 20) {
+		text += pick(tc, []string{" ", "\t", "\n"})
+	}
+	return text, value, suffix
+}
+
+// genJunkSize draws a size string both parsers must reject, and says why.
+func genJunkSize(tc hegel.TestCase) (string, string) {
+	good, _, _ := genSizeText(tc)
+	switch n(tc, 0, 7) {
+	case 0:
+		return pick(tc, []string{"+", "-"}) + good, "leading sign"
+	case 1:
+		return pick(tc, []string{" ", "\t"}) + good, "leading blank"
+	case 2:
+		return strconv.Itoa(n(tc, 1, 99)) + "e" + strconv.Itoa(n(tc, 0, 9)) + pick(tc, []string{"", " kB"}), "exponent"
+	case 3:
+		return strconv.Itoa(n(tc, 0, 99)) + "." + genDigits(tc, n(tc, 0, 3)) + "." + genDigits(tc, n(tc, 0, 3)), "two points"
+	case 4:
+		return pick(tc, []string{"", ".", ",", " ", "kB", "B"}), "no digits"
+	case 5:
+		for {
+			letters := "abcdefghijklmnopqrstuvwxyz"
+			var sb strings.Builder
+			for i, k := 0, n(tc, 1, 4); i < k; i++ {
+				sb.WriteByte(letters[n(tc, 0, 25)])
+			}
+			if _, known := sizeSuffixes[sb.String()]; !known {
+				return strconv.Itoa(n(tc, 0, 999)) + pick(tc, []string{"", " "}) + randomCase(tc, sb.String()), "unknown suffix"
+			}
+		}
+	case 6:
+		return strconv.Itoa(n(tc, 0, 999)) + " " + pick(tc, []string{"k B", "Mi B", "G iB", "k  b"}), "blank inside the suffix"
+	default:
+		return strconv.Itoa(n(tc, 0, 999)) + pick(tc, []string{"_000", "0x10", "kBs", "bytes", "kbps"}), "trailing junk"
+	}
+}
+
+// genFloat draws a finite float64 with a mix of shapes.
+func genFloat(tc hegel.TestCase) float64 {
+	switch n(tc, 1, 5) {
+	case 1:
+		return float64(wide(tc, -1e15, 1e15)) / math.Pow10(n(tc, 0, 8))
+	case 2:
+		f := math.Float64frombits(uint64(wide(tc, math.MinInt64, math.MaxInt64)))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			return 0
+		}
+		return f
+	case 3:
+		return float64(wide(tc, -1e9, 1e9)) * math.Pow10(n(tc, 0, 12))
+	case 4:
+		return float64(n(tc, -2000, 2000)) / 8
+	default:
+		return float64(n(tc, -2000, 2000))
+	}
+}
+
+// ---- comma models --------------------------------------------------------------------------
+
+// groupThousands inserts commas into a string of digits every three from the right.
+func groupThousands(digits, sep string) string {
+	var sb strings.Builder
+	for i, c := range digits {
+		if i > 0 && (len(digits)-i)%3 == 0 {
+			sb.WriteString(sep)
+		}
+		sb.WriteRune(c)
+	}
+	return sb.String()
+}
+
+// commaModel groups the integer part of a plain signed decimal string.
+func commaModel(s string) string {
+	sign := ""
+	if strings.HasPrefix(s, "-") {
+		sign, s = "-", s[1:]
+	}
+	intPart, frac, hasFrac := strings.Cut(s, ".")
+	out := sign + groupThousands(intPart, ",")
+	if hasFrac {
+		out += "." + frac
+	}
+	return out
+}
+
+// truncateDecimals cuts a decimal string after d digits of fraction (d <= 0 drops the point).
+func truncateDecimals(s string, d int) string {
+	i := strings.IndexByte(s, '.')
+	if i < 0 {
+		return s
+	}
+	if d <= 0 {
+		return s[:i]
+	}
+	if i+1+d >= len(s) {
+		return s
+	}
+	return s[:i+1+d]
+}
+
+// padDecimals appends fraction zeros until s has exactly d of them (d > 0).
+func padDecimals(s string, d int) string {
+	if d <= 0 {
+		return s
+	}
+	i := strings.IndexByte(s, '.')
+	if i < 0 {
+		return s + "." + strings.Repeat("0", d)
+	}
+	if have := len(s) - i - 1; have < d {
+		return s + strings.Repeat("0", d-have)
+	}
+	return s
+}
+
+// stripZeros removes trailing fraction zeros and a bare trailing point.
+func stripZeros(s string) string {
+	if !strings.Contains(s, ".") {
+		return s
+	}
+	s = strings.TrimRight(s, "0")
+	return strings.TrimSuffix(s, ".")
+}
+
+// ---- byte printers -------------------------------------------------------------------------
+
+// checkSmallPrinted checks the output of Bytes/IBytes/BytesN/IBytesN for s with `digits`
+// significant digits: the unit is the largest not exceeding s, the number has the right
+// shape, and it is within the rounding of the exact mantissa (the double rounding of
+// humanateBytes is allowed for: a first rounding to `digits` significant digits, then %.Nf).
+// Sizes whose mantissa is within one unit of the base are skipped (go-humanize/1).
+func checkSmallPrinted(ht *hegel.T, what, out string, s uint64, base int64, units []string, digits int) {
+	if s < 10 {
+		if want := fmt.Sprintf("%d B", s); out != want {
+			ht.Fatalf("%s = %q, want %q", what, out, want)
+		}
+		return
+	}
+	big_ := new(big.Int).SetUint64(s)
+	e, mant := magnitude(big_, base, 6)
+	if mant.Cmp(new(big.Rat).SetInt64(base-1)) >= 0 {
+		return // carry zone, pinned as go-humanize/1
+	}
+	num, unit := splitPrinted(ht, out)
+	if unit != units[e] {
+		ht.Fatalf("%s = %q: unit should be %s (mantissa %s)", what, out, units[e], ratString(mant))
+	}
+	printed, ok := plainDecimal(num)
+	if !ok {
+		ht.Fatalf("%s = %q: not a plain decimal", what, out)
+	}
+	d := decimalsOf(num)
+	if want := digits - len(intPartOf(num)); (want < 0 && d != 0) || (want >= 0 && d != want) {
+		ht.Fatalf("%s = %q: %d decimals for %d significant digits", what, out, d, digits)
+	}
+	tol := new(big.Rat).Add(tenPow(1-digits), tenPow(-d))
+	tol.Quo(tol, big.NewRat(2, 1))
+	tol.Add(tol, new(big.Rat).Mul(mant, big.NewRat(1, 1e12)))
+	if !diffWithin(printed, mant, tol) {
+		ht.Fatalf("%s = %q but the exact mantissa is %s (tolerance %s)", what, out, ratString(mant), ratString(tol))
+	}
+	// the printed value parses back to about s
+	exact := new(big.Rat).Mul(printed, ratInt(new(big.Int).Exp(big.NewInt(base), big.NewInt(int64(e)), nil)))
+	bigBack, err := humanize.ParseBigBytes(out)
+	if err != nil || bigBack.Cmp(floorRat(exact)) != 0 {
+		ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", out, bigBack, err, floorRat(exact))
+	}
+	back, err := humanize.ParseBytes(out)
+	if exact.Cmp(ratInt(two64)) >= 0 {
+		if err == nil {
+			ht.Fatalf("ParseBytes(%q) = %d, but %s bytes do not fit a uint64", out, back, ratString(exact))
+		}
+		return
+	}
+	if err != nil {
+		ht.Fatalf("ParseBytes(%q): %v", out, err)
+	}
+	// go-humanize/3: ParseBytes goes through float64; allow its rounding here
+	ptol := new(big.Rat).Mul(exact, big.NewRat(1, 1<<50))
+	ptol.Add(ptol, big.NewRat(1, 1))
+	if !diffWithin(new(big.Rat).SetUint64(back), exact, ptol) {
+		ht.Fatalf("ParseBytes(%q) = %d, want about %s", out, back, ratString(exact))
+	}
+}
+
+func TestHegelBytePrintersFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genSize(ht)
+		digits := n(ht, 1, 6)
+		iec := chance(ht, 50)
+		base, units := int64(1000), siUnits
+		if iec {
+			base, units = 1024, iecUnits
+		}
+		var what, out string
+		switch {
+		case digits == 2 && chance(ht, 60) && !iec:
+			what, out = fmt.Sprintf("Bytes(%d)", s), humanize.Bytes(s)
+		case digits == 2 && chance(ht, 60) && iec:
+			what, out = fmt.Sprintf("IBytes(%d)", s), humanize.IBytes(s)
+		case !iec:
+			what, out = fmt.Sprintf("BytesN(%d, %d)", s, digits), humanize.BytesN(s, digits)
+		default:
+			what, out = fmt.Sprintf("IBytesN(%d, %d)", s, digits), humanize.IBytesN(s, digits)
+		}
+		note(ht, "%s = %q", what, out)
+		checkSmallPrinted(ht, what, out, s, base, units, digits)
+	})
+}
+
+// checkBigPrinted checks BigBytes/BigIBytes: one decimal below 10, none above, the unit is
+// the largest not exceeding s (the table ends at quetta), and the value is within the rounding
+// of the exact mantissa.  The carry zone is skipped (go-humanize/1).
+func checkBigPrinted(ht *hegel.T, what, out string, s *big.Int, base int64, units []string) {
+	if s.Cmp(big.NewInt(10)) < 0 {
+		if want := fmt.Sprintf("%d B", s); out != want {
+			ht.Fatalf("%s = %q, want %q", what, out, want)
+		}
+		return
+	}
+	e, mant := magnitude(s, base, len(units)-1)
+	if e < len(units)-1 && mant.Cmp(new(big.Rat).SetInt64(base-1)) >= 0 {
+		return // carry zone, pinned as go-humanize/1
+	}
+	num, unit := splitPrinted(ht, out)
+	if unit != units[e] {
+		ht.Fatalf("%s = %q: unit should be %s (mantissa %s)", what, out, units[e], ratString(mant))
+	}
+	printed, ok := plainDecimal(num)
+	if !ok {
+		ht.Fatalf("%s = %q: not a plain decimal", what, out)
+	}
+	d := decimalsOf(num)
+	ten := big.NewRat(10, 1)
+	// go-humanize/9: oomm keeps only the last remainder, so the mantissa it rounds is the
+	// exact one truncated to 1/base; allow that much here
+	trunc := big.NewRat(1, base)
+	if diff := new(big.Rat).Sub(mant, ten); absRat(diff).Cmp(trunc) > 0 {
+		want := 0
+		if mant.Cmp(ten) < 0 {
+			want = 1
+		}
+		if d != want {
+			ht.Fatalf("%s = %q: %d decimals for mantissa %s", what, out, d, ratString(mant))
+		}
+	}
+	tol := new(big.Rat).Quo(tenPow(-d), big.NewRat(2, 1))
+	tol.Add(tol, trunc)
+	tol.Add(tol, new(big.Rat).Mul(mant, big.NewRat(1, 1e9)))
+	if !diffWithin(printed, mant, tol) {
+		ht.Fatalf("%s = %q but the exact mantissa is %s", what, out, ratString(mant))
+	}
+	exact := new(big.Rat).Mul(printed, ratInt(new(big.Int).Exp(big.NewInt(base), big.NewInt(int64(e)), nil)))
+	back, err := humanize.ParseBigBytes(out)
+	if err != nil || back.Cmp(floorRat(exact)) != 0 {
+		ht.Fatalf("ParseBigBytes(%q) = %v, %v; want %s", out, back, err, floorRat(exact))
+	}
+}
