+// go-humanize/1: a mantissa that rounds to the base is printed as "1000 kB" / "1024 KiB" /
+// "1000 kF" instead of moving to the next unit.
+func TestHegelPinPrintersCarryIntoTheNextUnit(t *testing.T) {
+	cases := []struct{ what, got, want string }{
+		{"Bytes(999999)", humanize.Bytes(999999), "1.0 MB"},
+		{"BytesN(999500, 3)", humanize.BytesN(999500, 3), "1.00 MB"},
+		{"IBytes(1048575)", humanize.IBytes(1048575), "1.0 MiB"},
+		{"BigBytes(999999)", humanize.BigBytes(big.NewInt(999999)), "1.0 MB"},
+		{"BigIBytes(1048575)", humanize.BigIBytes(big.NewInt(1048575)), "1.0 MiB"},
+		{"SI(999999.9999995, \"F\")", humanize.SI(999999.9999995, "F"), "1 MF"},
+	}
+	for _, c := range cases {
+		if c.got != c.want {
+			t.Errorf("%s = %q, want %q", c.what, c.got, c.want)
+		}
+	}
+}
+
+// go-humanize/2: Bytes rounds twice (to two significant digits, then to an integer with %.0f),
+// so 82.549 MB prints as "82 MB" while BytesN(..., 1) and BigBytes print "83 MB".
+func TestHegelPinBytesRoundsTwice(t *testing.T) {
+	if got := humanize.Bytes(82549000); got != "83 MB" {
+		t.Errorf("Bytes(82549000) = %q, want \"83 MB\" (BytesN(82549000, 1) = %q, BigBytes = %q)",
+			got, humanize.BytesN(82549000, 1), humanize.BigBytes(big.NewInt(82549000)))
+	}
+	if got := humanize.IBytes(1048576*82 + 1048576*549/1000); got != "83 MiB" {
+		t.Errorf("IBytes(82.549 MiB) = %q, want \"83 MiB\"", got)
+	}
+}
+
+// go-humanize/3: ParseBytes multiplies in float64 and truncates, so "1.007 kB" is 1006 bytes
+// (ParseBigBytes says 1007) and sizes just under 2^64 are rejected as too large.
+func TestHegelPinParseBytesIsExact(t *testing.T) {
+	for _, c := range []struct {
+		text string
+		want uint64
+	}{
+		{"1.007 kB", 1007},
+		{"16.1 PB", 16100000000000000},
+		{"18446744073709551615", math.MaxUint64},
+		{"18446744073709551000 B", 18446744073709551000},
+	} {
+		got, err := humanize.ParseBytes(c.text)
+		if err != nil || got != c.want {
+			big_, _ := humanize.ParseBigBytes(c.text)
+			t.Errorf("ParseBytes(%q) = %d, %v; want %d (ParseBigBytes says %v)", c.text, got, err, c.want, big_)
+		}
+	}
+}
+
+// go-humanize/4: Commaf puts a thousands separator into "Inf".
+func TestHegelPinCommafOfInfinity(t *testing.T) {
+	for _, f := range []float64{math.Inf(1), math.Inf(-1)} {
+		got, want := humanize.Commaf(f), strconv.FormatFloat(f, 'f', -1, 64)
+		if got != want {
+			t.Errorf("Commaf(%v) = %q, want %q", f, got, want)
+		}
+	}
+}
+
+// go-humanize/5: BigCommaf calls v.Abs(v) and so flips the sign of a negative argument.
+func TestHegelPinBigCommafLeavesItsArgumentAlone(t *testing.T) {
+	v := big.NewFloat(-1234567.5)
+	got := humanize.BigCommaf(v)
+	if v.Sign() >= 0 {
+		t.Errorf("BigCommaf(-1234567.5) = %q and the argument is now %v", got, v)
+	}
+}
+
+// go-humanize/6: outside the quecto..quetta table ComputeSI finds no prefix and returns the
+// bare mantissa, so SI(1e-31, "F") is "100 F" and SI(1e-33, "F") is "1 F".
+func TestHegelPinSIBeyondThePrefixTable(t *testing.T) {
+	for _, x := range []float64{1e-31, 1e-33, 1e34, 1e40} {
+		s := humanize.SI(x, "F")
+		back, unit, err := humanize.ParseSI(s)
+		if err != nil || unit != "F" || math.Abs(back-x) > x*1e-6 {
+			t.Errorf("SI(%g, \"F\") = %q, which reads back as %v %q, %v", x, s, back, unit, err)
+		}
+	}
+}
+
+// go-humanize/7: FormatFloat converts the integer part with int64(), so from 2^63 the digits
+// are those of math.MinInt64 (and a negative number gets two minus signs).
+func TestHegelPinFormatFloatBeyondInt64(t *testing.T) {
+	for _, c := range []struct {
+		n    float64
+		want string
+	}{
+		{1e19, "10,000,000,000,000,000,000"},
+		{-1e19, "-10,000,000,000,000,000,000"},
+		{math.MaxUint64, "18,446,744,073,709,551,616"},
+	} {
+		if got := humanize.FormatFloat("#,###.", c.n); got != c.want {
+			t.Errorf("FormatFloat(\"#,###.\", %g) = %q, want %q", c.n, got, c.want)
+		}
+	}
+}
+
+// go-humanize/8: FormatInteger adds a float64 rounder of 0.5 before truncating, so from 2^52
+// odd integers print as the next even one.
+func TestHegelPinFormatIntegerNearTwoToTheFiftyTwo(t *testing.T) {
+	for _, k := range []int{1<<52 + 1, 1<<52 + 3, -(1<<52 + 1), 1<<53 - 1} {
+		if got, want := humanize.FormatInteger("#,###.", k), humanize.Comma(int64(k)); got != want {
+			t.Errorf("FormatInteger(\"#,###.\", %d) = %q, want %q", k, got, want)
+		}
+	}
+}
+
+// go-humanize/9: BigBytes and BigIBytes round a mantissa that keeps only the last division
+// remainder (oomm), i.e. the exact one truncated to 1/1000 or 1/1024, so values just above a
+// rounding boundary round down.
+func TestHegelPinBigBytesKeepOnlyTheLastRemainder(t *testing.T) {
+	cases := []struct {
+		s, want string
+		iec     bool
+	}{
+		{"1950000001", "2.0 GB", false},
+		{"82500001", "83 MB", false},
+		{"6080047000000000000000", "5.2 ZiB", true},
+	}
+	for _, c := range cases {
+		v, _ := new(big.Int).SetString(c.s, 10)
+		got, what := humanize.BigBytes(new(big.Int).Set(v)), "BigBytes"
+		if c.iec {
+			got, what = humanize.BigIBytes(new(big.Int).Set(v)), "BigIBytes"
+		}
+		if got != c.want {
+			t.Errorf("%s(%s) = %q, want %q", what, c.s, got, c.want)
+		}
+	}
+}
