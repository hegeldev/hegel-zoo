+// ---- FormatFloat ---------------------------------------------------------------------------
+
+// ffFormat is a FormatFloat format string and how the documentation reads it.
+type ffFormat struct {
+	format, thousand, decimal string
+	precision                 int
+	plus                      bool
+}
+
+var ffFormats = []ffFormat{
+	{"", ",", ".", 2, false},
+	{"#,###.##", ",", ".", 2, false},
+	{"#,###.", ",", ".", 0, false},
+	{"#,###", "", ",", 3, false},
+	{"# ###,##", " ", ",", 2, false},
+	{"#.###,######", ".", ",", 6, false},
+	{"#.##", "", ".", 2, false},
+	{"#.#########", "", ".", 9, false},
+	{"###", "", ".", 9, false},
+	{"0000", "", ".", 9, false},
+	{"+#,###.##", ",", ".", 2, true},
+	{"+#.###", "", ".", 3, true},
+	{"+#", "", ".", 9, true},
+}
+
+func TestHegelFormatFloatFollowsItsFormat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		if chance(ht, 10) {
+			// documented-invalid formats panic with a FormatFloat() message
+			bad := pick(ht, []string{"#,##.##", "#,####.##", "x###", "-#.##", "#,#.#"})
+			f := genFloat(ht)
+			func() {
+				defer func() {
+					r := recover()
+					if s, ok := r.(string); !ok || !strings.Contains(s, "FormatFloat()") {
+						ht.Fatalf("FormatFloat(%q, %v) did not panic with a FormatFloat() message: %v", bad, f, r)
+					}
+				}()
+				humanize.FormatFloat(bad, f)
+			}()
+			return
+		}
+		ff := pick(ht, ffFormats)
+		var f float64
+		switch n(ht, 1, 3) {
+		case 1:
+			f = float64(wide(ht, -1e12, 1e12)) / math.Pow10(n(ht, 0, 9))
+		case 2:
+			f = float64(wide(ht, -1e6, 1e6)) / math.Pow10(n(ht, 0, 3))
+		default:
+			f = float64(n(ht, -2000, 2000)) / 1000
+		}
+		got := humanize.FormatFloat(ff.format, f)
+		note(ht, "FormatFloat(%q, %v) = %q", ff.format, f, got)
+		rest := got
+		wantSign := ""
+		if f <= -1e-9 {
+			wantSign = "-"
+		} else if f >= 1e-9 && ff.plus {
+			wantSign = "+"
+		}
+		if !strings.HasPrefix(rest, wantSign) {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: sign should be %q", ff.format, f, got, wantSign)
+		}
+		rest = rest[len(wantSign):]
+		intPart, frac := rest, ""
+		if ff.precision > 0 {
+			var found bool
+			intPart, frac, found = strings.Cut(rest, ff.decimal)
+			if !found || len(frac) != ff.precision {
+				ht.Fatalf("FormatFloat(%q, %v) = %q: want %d digits after %q", ff.format, f, got, ff.precision, ff.decimal)
+			}
+		}
+		digits := intPart
+		if ff.thousand != "" {
+			digits = strings.ReplaceAll(intPart, ff.thousand, "")
+			if groupThousands(digits, ff.thousand) != intPart {
+				ht.Fatalf("FormatFloat(%q, %v) = %q: integer part is not grouped by %q", ff.format, f, got, ff.thousand)
+			}
+		}
+		plain := digits
+		if frac != "" {
+			plain += "." + frac
+		}
+		value, ok := plainDecimal(plain)
+		if !ok {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: %q is not a number", ff.format, f, got, plain)
+		}
+		// the value is |f| rounded half up at the precision; the float rounder may lose one
+		// unit in the last place
+		tol := new(big.Rat).Mul(tenPow(-ff.precision), big.NewRat(3, 2))
+		tol.Add(tol, new(big.Rat).Mul(absRat(ratFloat(f)), big.NewRat(1, 1e14)))
+		want := absRat(ratFloat(f))
+		if math.Abs(f) < 1e-9 {
+			want = new(big.Rat)
+		}
+		if !diffWithin(value, want, tol) {
+			ht.Fatalf("FormatFloat(%q, %v) = %q: value %s is not %s to %d places", ff.format, f, got, plain, ratString(want), ff.precision)
+		}
+	})
+}
