+package hegel
+
+// One narrow property per recorded bug (bugs.toml): a generator over the bug's shape region
+// with random contents, judged as the wide property that found the bug judges (the model of
+// RFC 4566 for the parser, the description itself for the round trip, the documented
+// attribute for the builder), so that each bug has a property that finds it every run; the
+// wide properties reach the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws
+// the neighbouring region the bug does not touch instead (numbers within uint64, complete
+// lines, a final 1 or a line break, documents through t=, a final line with '=', texts
+// without a carriage return, lines with the right field count, paired z= times, addresses
+// without TTL or range, ports p or p/a, known protocols, media with formats, property texts
+// whose key the builder keeps right) and passes.
+
+import (
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/pion/sdp/v3"
+	"hegel.dev/go/hegel"
+)
+
+// digitRun is a run of n decimal digits.
+func digitRun(n int) hegel.Generator[string] {
+	return hegel.Text().Alphabet("0123456789").MinSize(n).MaxSize(n)
+}
+
+var (
+	// beyondUint64: a decimal above 18446744073709551615: 20 digits starting with 2-9, or 21.
+	beyondUint64 = hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, hegel.SampledFrom(strings.Split("23456789", ""))) + hegel.Draw(tc, digitRun(19))
+		}),
+		hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, hegel.SampledFrom(strings.Split("123456789", ""))) + hegel.Draw(tc, digitRun(20))
+		}),
+	)
+	withinUint64 = hegel.Map(hegel.Integers[uint64](0, math.MaxUint64), func(n uint64) string { return strconv.FormatUint(n, 10) })
+	// shapeNumbers: beyond uint64 (the shape of sdp/1), or within it under HEGEL_NO_KNOWN=1.
+	shapeNumbers = shaped(beyondUint64, withinUint64)
+	// plainTexts: texts without a carriage return.
+	plainTexts = hegel.SampledFrom(hzRTTexts)
+)
+
+// --------------------------------------------------------------------------- sdp/1
+
+// numberCase: a numeric field of a description and the number in it.
+type numberCase struct {
+	at     string // t-start, t-stop, o-id, o-version, z, b
+	number string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c numberCase) GoString() string { return c.at + " <- " + c.number }
+
+func (c numberCase) text() string {
+	switch c.at {
+	case "t-start":
+		return hzPinHead + "t=" + c.number + " 0\r\n"
+	case "t-stop":
+		return hzPinHead + "t=0 " + c.number + "\r\n"
+	case "o-id":
+		return "v=0\r\no=- " + c.number + " 2 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
+	case "o-version":
+		return "v=0\r\no=- 1 " + c.number + " IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
+	case "z":
+		return hzPinHead + "t=0 0\r\nz=" + c.number + " 0\r\n"
+	case "b":
+		return hzPinHead + "b=AS:" + c.number + "\r\nt=0 0\r\n"
+	}
+	panic(c.at)
+}
+
+var numberCases = hegel.Composite(func(tc hegel.TestCase) numberCase {
+	return numberCase{
+		at:     hegel.Draw(tc, hegel.SampledFrom([]string{"t-start", "t-stop", "o-id", "o-version", "z", "b"})),
+		number: hegel.Draw(tc, shapeNumbers),
+	}
+})
+
+// TestHegelNumbersBeyondUint64AreRejected: a numeric field of o=, t=, z= or b= holding a
+// 20-21 digit number above uint64 is malformed (RFC 4566: decimal NTP timestamps that do not
+// fit are not a different time); the lexer's readUint64Field wraps it around silently
+// (sdp/1), while b= goes through strconv and refuses it. HEGEL_NO_KNOWN=1 draws numbers within
+// uint64.
+func TestHegelNumbersBeyondUint64AreRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, numberCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/2
+
+// missingCase: a t= or v= line and its fields.
+type missingCase struct {
+	key    byte
+	fields []string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c missingCase) GoString() string {
+	return strconv.Quote(string(c.key) + "=" + strings.Join(c.fields, " "))
+}
+
+func (c missingCase) text() string {
+	v := strings.Join(c.fields, " ")
+	if c.key == 'v' {
+		return "v=" + v + "\r\no=- 1 2 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
+	}
+	return hzPinHead + "t=" + v + "\r\n"
+}
+
+var (
+	// missingNumeric: t= with no field or one, v= with none.
+	missingNumeric = hegel.OneOf(
+		hegel.Just(missingCase{key: 't'}),
+		hegel.Map(withinUint64, func(n string) missingCase { return missingCase{'t', []string{n}} }),
+		hegel.Just(missingCase{key: 'v'}),
+	)
+	// completeNumeric: t= with its two fields, v=0.
+	completeNumeric = hegel.OneOf(
+		hegel.Map(fields(withinUint64, withinUint64), func(fs []string) missingCase { return missingCase{'t', fs} }),
+		hegel.Just(missingCase{'v', []string{"0"}}),
+	)
+	missingCases = shaped(missingNumeric, completeNumeric)
+)
+
+// TestHegelMissingNumericFieldIsRejected: a t= line with fewer than its two numbers, or a v=
+// line without its value, is malformed (the package's own state table makes the lines
+// required); readUint64Field reads the missing number as 0 (sdp/2). HEGEL_NO_KNOWN=1 draws
+// complete lines.
+func TestHegelMissingNumericFieldIsRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, missingCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/3
+
+// finalCase: time lines before the last one, the last t= line's two numbers, and whether it
+// goes without its line break.
+type finalCase struct {
+	more        []string
+	start, stop string
+	open        bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c finalCase) GoString() string { return strconv.Quote(c.text()) }
+
+func (c finalCase) text() string {
+	var b strings.Builder
+	b.WriteString(hzPinHead)
+	for _, l := range c.more {
+		b.WriteString(l + "\r\n")
+	}
+	b.WriteString("t=" + c.start + " " + c.stop)
+	if !c.open {
+		b.WriteString("\r\n")
+	}
+	return b.String()
+}
+
+var (
+	moreTimes = hegel.Lists(hegel.Map(fields(withinUint64, withinUint64), func(fs []string) string { return "t=" + fs[0] + " " + fs[1] })).MaxSize(2)
+	// finalZero: the input ends in "t=<n> 0" without a line break.
+	finalZero = hegel.Composite(func(tc hegel.TestCase) finalCase {
+		return finalCase{more: hegel.Draw(tc, moreTimes), start: hegel.Draw(tc, withinUint64), stop: "0", open: true}
+	})
+	// finalOther: the input ends in "t=<n> <m>" with m at least 1, or in "t=<n> 0" with its
+	// line break.
+	finalOther = hegel.Composite(func(tc hegel.TestCase) finalCase {
+		return finalCase{
+			more:  hegel.Draw(tc, moreTimes),
+			start: hegel.Draw(tc, withinUint64),
+			stop:  hegel.Draw(tc, hegel.Map(hegel.Integers[uint64](1, math.MaxUint64), func(n uint64) string { return strconv.FormatUint(n, 10) })),
+			open:  true,
+		}
+	})
+	finalCases = shaped(finalZero, hegel.OneOf(finalOther, hegel.Map(finalZero, func(c finalCase) finalCase { c.open = false; return c })))
+)
+
+// TestHegelFinalZeroWithoutLineBreakIsAccepted: a description whose last line is a t= line
+// ending in 0 without a line break parses as the same description ending in 1 does (the
+// value of the number must not decide whether a missing final line break is tolerated);
+// readUint64Field takes io.EOF as the end of the field only for a positive value (sdp/3).
+// HEGEL_NO_KNOWN=1 draws a final number of 1 or more, or the line break.
+func TestHegelFinalZeroWithoutLineBreakIsAccepted(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, finalCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/4
+
+// truncatedCase: the well-formed session lines before t=, and where the input is cut (a
+// position modulo the length plus one; -1 for a complete description).
+type truncatedCase struct {
+	prefix []line
+	cut    int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c truncatedCase) GoString() string { return strconv.Quote(c.text()) }
+
+func (c truncatedCase) text() string {
+	var b strings.Builder
+	for _, l := range c.prefix {
+		b.WriteString(l.text() + "\r\n")
+	}
+	if c.cut < 0 {
+		return b.String() + "t=0 0\r\n"
+	}
+	s := b.String()
+	return s[:c.cut%(len(s)+1)]
+}
+
+var (
+	plainC          = fieldLine('c', "", fields(hegel.Just("IN"), addrTypes, oAddr))
+	truncatedPrefix = cat(one(vOK), one(oOK), one(textLine('s', "", plainTexts)),
+		optLine(40, textLine('i', "", plainTexts)), optLine(40, uOK), optLine(40, textLine('e', "", plainTexts)),
+		optLine(40, textLine('p', "", plainTexts)), optLine(40, plainC), optLine(40, bOK))
+	truncatedCases = hegel.Composite(func(tc hegel.TestCase) truncatedCase {
+		return truncatedCase{prefix: hegel.Draw(tc, truncatedPrefix), cut: hegel.Draw(tc, shaped(hegel.Integers(0, 300), hegel.Just(-1)))}
+	})
+)
+
+// TestHegelDocumentCutOffBeforeTimingIsRejected: a description cut off at a random point
+// before its t= line, the empty string included, is malformed (RFC 4566 requires v=, o=, s=
+// and a time description; the package's table lets the input end only after the first t=);
+// the lexer takes io.EOF for a clean end in every state (sdp/4). A cut inside a line is an
+// error for both. HEGEL_NO_KNOWN=1 draws the complete description through t=.
+func TestHegelDocumentCutOffBeforeTimingIsRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, truncatedCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/5
+
+// danglingCase: attribute lines after the timing, the line end used, and the final line.
+type danglingCase struct {
+	attrs []string
+	end   string
+	tail  string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c danglingCase) GoString() string { return strconv.Quote(c.text()) }
+
+func (c danglingCase) text() string {
+	var b strings.Builder
+	b.WriteString(hzPinHead + "t=0 0" + c.end)
+	for _, a := range c.attrs {
+		b.WriteString("a=" + a + c.end)
+	}
+	b.WriteString(c.tail)
+	return b.String()
+}
+
+var (
+	// danglingBytes: one byte without '=' (a type letter, a digit, '=' itself, a space).
+	danglingBytes = hegel.SampledFrom(strings.Split("mavxz0=- ", ""))
+	// finalLines: a final line with its '=', with or without a value and a line break.
+	finalLines = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, hegel.SampledFrom(strings.Split("atkmxz", ""))) + "=" +
+			hegel.Draw(tc, hegel.SampledFrom([]string{"", "x", "0 0", "AS:5", "b"})) + hegel.Draw(tc, hegel.SampledFrom([]string{"", "\r\n"}))
+	})
+	danglingCases = hegel.Composite(func(tc hegel.TestCase) danglingCase {
+		return danglingCase{
+			attrs: hegel.Draw(tc, hegel.Lists(hegel.SampledFrom(hzAttrs)).MaxSize(2)),
+			end:   hegel.Draw(tc, hegel.SampledFrom([]string{"\r\n", "\n"})),
+			tail:  hegel.Draw(tc, shaped(danglingBytes, finalLines)),
+		}
+	})
+)
+
+// TestHegelDanglingFinalByteIsRejected: a lone final byte without '=' after a complete
+// description is an unfinished line (an error, as "mx" and "m=" are); readType returns
+// (0, io.EOF) when the second byte is missing and the lexer takes that for a clean end
+// (sdp/5). HEGEL_NO_KNOWN=1 draws a final line with its '='.
+func TestHegelDanglingFinalByteIsRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, danglingCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/6
+
+// crCase: a text line's type and its text.
+type crCase struct {
+	key  byte
+	text string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c crCase) GoString() string { return strconv.Quote(string(c.key) + "=" + c.text) }
+
+func (c crCase) doc() string {
+	l := string(c.key) + "=" + c.text + "\r\n"
+	switch c.key {
+	case 's':
+		return "v=0\r\no=- 1 2 IN IP4 127.0.0.1\r\n" + l + "t=0 0\r\n"
+	case 'i', 'e', 'p':
+		return hzPinHead + l + "t=0 0\r\n"
+	}
+	return hzPinHead + "t=0 0\r\n" + l
+}
+
+var (
+	crPieces = hegel.SampledFrom([]string{"", "a", "b", "x y", "caf\xc3\xa9", "-", "0"})
+	crLast   = hegel.SampledFrom([]string{"a", "b", "x y", "-", "0"})
+	// crInside: pieces joined by carriage returns, the last one non-empty so that a CR sits
+	// inside the line (a trailing CR is the line end's).
+	crInside = hegel.Composite(func(tc hegel.TestCase) string {
+		return strings.Join(hegel.Draw(tc, many(crPieces, 1, 3)), "\r") + "\r" + hegel.Draw(tc, crLast)
+	})
+	crCases = hegel.Composite(func(tc hegel.TestCase) crCase {
+		return crCase{key: hegel.Draw(tc, hegel.SampledFrom([]byte("siepka"))), text: hegel.Draw(tc, shaped(crInside, plainTexts))}
+	})
+)
+
+// TestHegelCarriageReturnInsideTextLineKeepsTheLine: a text line (s i e p k a) with a
+// carriage return inside it is read whole up to its line end, or rejected (RFC 4566 section 9
+// excludes CR from byte-string), never cut; readLine removes as many bytes before the LF as
+// there are CRs on the line (sdp/6). HEGEL_NO_KNOWN=1 draws texts without a carriage return.
+func TestHegelCarriageReturnInsideTextLineKeepsTheLine(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, crCases)
+		judgeUnmarshal(ht, col, c.doc())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/7
+
+// extraCase: a field line (v o c t) with its own fields, the extra fields after them (none
+// for the right field count), whether the extra is the line the grammar expects next, and
+// the separator before it.
+type extraCase struct {
+	key    byte
+	own    []string
+	extra  []string
+	asLine bool
+	sep    string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c extraCase) GoString() string { return strconv.Quote(c.text()) }
+
+// extraSpec is the template of one field line: what comes before it, the rest of the
+// description when the extra is the next line (which the line then carries), and when it is
+// not.
+type extraSpec struct {
+	prefix, afterLine, afterPlain string
+	own, next                     hegel.Generator[[]string]
+}
+
+var extraSpecs = map[byte]extraSpec{
+	'v': {
+		prefix:     "",
+		own:        fields(hegel.Just("0")),
+		next:       fields(hegel.Just("o=-"), withinUint64, withinUint64, hegel.Just("IN"), hegel.Just("IP4"), oAddr),
+		afterLine:  "s=-\r\nt=0 0\r\n",
+		afterPlain: "o=- 1 2 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n",
+	},
+	'o': {
+		prefix:     "v=0\r\n",
+		own:        fields(oUser, withinUint64, withinUint64, hegel.Just("IN"), addrTypes, oAddr),
+		next:       hegel.Map(plainTexts, func(s string) []string { return []string{"s=" + s} }),
+		afterLine:  "t=0 0\r\n",
+		afterPlain: "s=-\r\nt=0 0\r\n",
+	},
+	'c': {
+		prefix: hzPinHead,
+		own:    fields(hegel.Just("IN"), addrTypes, oAddr),
+		next: hegel.OneOf(
+			hegel.Map(fields(withinUint64, withinUint64), func(fs []string) []string { return []string{"t=" + fs[0], fs[1]} }),
+			hegel.Map(withinUint64, func(n string) []string { return []string{"b=AS:" + n} }),
+		),
+		afterLine:  "t=0 0\r\n",
+		afterPlain: "t=0 0\r\n",
+	},
+	't': {
+		prefix: hzPinHead,
+		own:    fields(withinUint64, withinUint64),
+		next: hegel.OneOf(
+			hegel.Map(plainTexts, func(s string) []string { return []string{"a=" + s} }),
+			hegel.Map(plainTexts, func(s string) []string { return []string{"k=" + s} }),
+			hegel.Map(fields(withinUint64, withinUint64), func(fs []string) []string { return []string{"t=" + fs[0], fs[1]} }),
+			hegel.Map(withinUint64, func(n string) []string { return []string{"z=" + n, "0"} }),
+		),
+		afterLine:  "",
+		afterPlain: "",
+	},
+}
+
+func (c extraCase) text() string {
+	spec := extraSpecs[c.key]
+	l := line{key: c.key, fields: append(append([]string{}, c.own...), c.extra...), seps: []string{c.sep}}
+	rest := spec.afterPlain
+	if c.asLine {
+		rest = spec.afterLine
+	}
+	return spec.prefix + l.text() + "\r\n" + rest
+}
+
+// extraCasesOf is the case of one field line: by default with the next line as its extra
+// fields (80%) or a bare token (20%, a syntax error for both); under HEGEL_NO_KNOWN=1 with
+// the right field count.
+func extraCasesOf(key byte) hegel.Generator[extraCase] {
+	spec := extraSpecs[key]
+	asNext := hegel.Map(spec.next, func(fs []string) extraCase { return extraCase{extra: fs, asLine: true} })
+	asToken := hegel.Map(hegel.SampledFrom([]string{"x", "3", "a", "extra"}), func(s string) extraCase { return extraCase{extra: []string{s}} })
+	extras := shaped(
+		weighted(choice[extraCase]{80, asNext}, choice[extraCase]{20, asToken}),
+		hegel.Just(extraCase{}),
+	)
+	return hegel.Composite(func(tc hegel.TestCase) extraCase {
+		c := hegel.Draw(tc, extras)
+		c.key, c.own, c.sep = key, hegel.Draw(tc, spec.own), hegel.Draw(tc, hegel.SampledFrom(hzSeps))
+		return c
+	})
+}
+
+var extraCases = hegel.FlatMap(hegel.SampledFrom([]byte("tvoc")), extraCasesOf)
+
+// TestHegelExtraFieldsOnFieldLineAreRejected: a v=, o=, c= or t= line with fields beyond
+// its fixed count is a syntax error (RFC 4566 fixes the count; "t=0 0 x" is one); when the
+// surplus looks like the next line ("t=0 0 a=b"), nextLine leaves it in place and it is
+// parsed as that line (sdp/7). HEGEL_NO_KNOWN=1 draws lines with the right field count.
+func TestHegelExtraFieldsOnFieldLineAreRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, extraCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/8
+
+// zoneCase: the fields of a z= line.
+type zoneCase struct{ fields []string }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c zoneCase) GoString() string { return strconv.Quote("z=" + strings.Join(c.fields, " ")) }
+
+func (c zoneCase) text() string {
+	return hzPinHead + "t=0 0\r\nz=" + strings.Join(c.fields, " ") + "\r\n"
+}
+
+// zonePairs is lo to hi pairs of <adjustment time> <offset>.
+func zonePairs(lo, hi int) hegel.Generator[[]string] {
+	return hegel.Map(many(fields(withinUint64, goodUnit), lo, hi), flatten[string])
+}
+
+var (
+	// unpairedZones: nothing at all, or pairs and one adjustment time without its offset.
+	unpairedZones = hegel.OneOf(noFields, cat(zonePairs(0, 2), one(withinUint64)))
+	pairedZones   = zonePairs(1, 2)
+	zoneCases     = hegel.Map(shaped[hegel.Generator[[]string]](unpairedZones, pairedZones), func(fs []string) zoneCase { return zoneCase{fs} })
+)
+
+// TestHegelUnpairedTimeZoneAdjustmentIsRejected: a z= line with an odd number of fields (a
+// trailing adjustment time without its offset) or none at all is malformed (RFC 4566 5.11:
+// pairs of <adjustment time> <offset>); unmarshalTimeZones stops at the empty offset and
+// accepts the line (sdp/8). HEGEL_NO_KNOWN=1 draws paired times.
+func TestHegelUnpairedTimeZoneAdjustmentIsRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zoneCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/9
+
+// ttlCase: connection information at the session or the media level.
+type ttlCase struct {
+	where string
+	conn  *sdp.ConnectionInformation
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c ttlCase) GoString() string { return c.where + " c=" + hzFmtConn(c.conn) }
+
+// desc is a minimal description carrying the connection information.
+func (c ttlCase) desc() *sdp.SessionDescription {
+	s := &sdp.SessionDescription{
+		Origin:           sdp.Origin{Username: "-", SessionID: 1, SessionVersion: 2, NetworkType: "IN", AddressType: "IP4", UnicastAddress: "127.0.0.1"},
+		SessionName:      "-",
+		TimeDescriptions: []sdp.TimeDescription{{}},
+	}
+	if c.where == "session" {
+		s.ConnectionInformation = c.conn
+	} else {
+		s.MediaDescriptions = []*sdp.MediaDescription{{
+			MediaName:             sdp.MediaName{Media: "audio", Port: sdp.RangedPort{Value: 9}, Protos: []string{"RTP", "AVP"}, Formats: []string{"0"}},
+			ConnectionInformation: c.conn,
+		}}
+	}
+	return s
+}
+
+var (
+	ttls   = hegel.Map(hegel.Integers(0, 255), ptrTo[int])
+	ranges = hegel.Map(hegel.Integers(0, 10), ptrTo[int])
+	noInt  = hegel.Just[*int](nil)
+	// ttlAddresses: an address with a TTL, a range, or both; plainAddresses: with neither.
+	ttlAddresses   = hegel.OneOf(rtAddressWith(ttls, noInt), rtAddressWith(noInt, ranges), rtAddressWith(ttls, ranges))
+	plainAddresses = rtAddressWith(noInt, noInt)
+	ttlConns       = hegel.Composite(func(tc hegel.TestCase) *sdp.ConnectionInformation {
+		return &sdp.ConnectionInformation{NetworkType: "IN", AddressType: hegel.Draw(tc, rtAddrTypes), Address: hegel.Draw(tc, shaped(ttlAddresses, plainAddresses))}
+	})
+	ttlCases = hegel.Composite(func(tc hegel.TestCase) ttlCase {
+		return ttlCase{where: hegel.Draw(tc, hegel.SampledFrom([]string{"session", "media"})), conn: hegel.Draw(tc, ttlConns)}
+	})
+)
+
+// TestHegelConnectionAddressTTLAndRangeSurviveTheRoundTrip: a connection address with a TTL
+// or a range, at either level, comes back from Marshal and UnmarshalString as it was (RFC
+// 4566 5.7: <base multicast address>[/<ttl>]/<number of addresses>, and the Address struct
+// has the fields); the parser keeps the whole "/ttl/range" text in the address string
+// (sdp/9). HEGEL_NO_KNOWN=1 draws addresses without TTL or range.
+func TestHegelConnectionAddressTTLAndRangeSurviveTheRoundTrip(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, ttlCases)
+		judgeRoundTrip(ht, col, c.desc())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/10
+
+// portCase: a media line's port and the parts after it.
+type portCase struct {
+	media string
+	port  int
+	parts []int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c portCase) GoString() string { return strconv.Quote(c.line()) }
+
+func (c portCase) line() string {
+	p := strconv.Itoa(c.port)
+	for _, x := range c.parts {
+		p += "/" + strconv.Itoa(x)
+	}
+	return "m=" + c.media + " " + p + " RTP/AVP 0"
+}
+
+func (c portCase) text() string { return hzPinHead + "t=0 0\r\n" + c.line() + "\r\n" }
+
+var portCases = hegel.Composite(func(tc hegel.TestCase) portCase {
+	return portCase{
+		media: hegel.Draw(tc, rtMediaTypes),
+		port:  hegel.Draw(tc, hegel.Integers(0, 65535)),
+		parts: hegel.Draw(tc, shaped[hegel.Generator[[]int]](many(hegel.Integers(0, 99), 2, 2), many(hegel.Integers(0, 99), 0, 1))),
+	}
+})
+
+// TestHegelMediaPortWithTwoSlashesIsRejected: an m= port of the form p/a/b is malformed (RFC
+// 4566 5.14: <port>/<number of ports>, and "9/x" and "9/" are refused); the parser reads the
+// first two parts and ignores the third (sdp/10). HEGEL_NO_KNOWN=1 draws p or p/a.
+func TestHegelMediaPortWithTwoSlashesIsRejected(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, portCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/11
+
+// protoCase: the protocol tokens of a media line.
+type protoCase struct{ protos []string }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c protoCase) GoString() string { return strconv.Quote(c.line()) }
+
+func (c protoCase) line() string { return "m=audio 9 " + strings.Join(c.protos, "/") + " 0" }
+
+func (c protoCase) text() string { return hzPinHead + "t=0 0\r\n" + c.line() + "\r\n" }
+
+var (
+	knownProtos = hegel.SampledFrom([]string{"UDP", "RTP", "AVP", "SAVP", "SAVPF", "TLS", "DTLS", "SCTP", "AVPF", "TCP", "MSRP", "BFCP", "UDT", "IX", "MRCPv2", "FEC"})
+	// unknownProto: empty, or lower-case letters and digits (no registered protocol is).
+	unknownProto = hegel.OneOf(hegel.Just(""), hegel.Text().Alphabet("abcdxyz0123").MinSize(1).MaxSize(4))
+	// unknownProtos: known tokens around one unknown; knownProtoLists: known tokens only.
+	unknownProtos   = cat(many(knownProtos, 0, 2), one(unknownProto), many(knownProtos, 0, 1))
+	knownProtoLists = many(knownProtos, 1, 3)
+	protoCases      = hegel.Map(shaped[hegel.Generator[[]string]](unknownProtos, knownProtoLists), func(ps []string) protoCase { return protoCase{ps} })
+)
+
+// TestHegelUnknownTransportProtocolIsAnInvalidValue: an m= line with a transport protocol
+// token that is not registered fails as an invalid value, the sentinel every other unknown
+// token (media type, network type, address type, bandwidth type) reports; the proto loop
+// wraps errSDPInvalidNumericValue (sdp/11). HEGEL_NO_KNOWN=1 draws known protocols.
+func TestHegelUnknownTransportProtocolIsAnInvalidValue(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, protoCases)
+		judgeUnmarshal(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/12
+
+var (
+	// shapeFormats: no formats (the shape of sdp/12), or one to three under HEGEL_NO_KNOWN=1.
+	shapeFormats = shaped[hegel.Generator[[]string]](noFields, many(hegel.SampledFrom(hzRTFmts), 1, 3))
+	sizeDescs    = rtDescWith(rtConn, many(rtMediaWith(shapeFormats, rtConn), 1, 2))
+)
+
+// TestHegelMarshalSizeCountsAMediaLineWithoutFormats: MarshalSize of a description with a
+// media description without formats is the length of Marshal's output, as documented
+// ("the size of the SessionDescription once marshaled"); MediaName.marshalInto writes the
+// space before the empty format list and marshalSize does not count it (sdp/12).
+// HEGEL_NO_KNOWN=1 draws media with formats.
+func TestHegelMarshalSizeCountsAMediaLineWithoutFormats(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, sizeDescs)
+		judgeRoundTrip(ht, col, d.s)
+	})
+}
+
+// --------------------------------------------------------------------------- sdp/13
+
+// attrCase: an extmap added with WithExtMap, or (under HEGEL_NO_KNOWN=1) a property text
+// without ':' added with WithPropertyAttribute, the builder WithExtMap uses.
+type attrCase struct {
+	ext  *sdp.ExtMap
+	text string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c attrCase) GoString() string {
+	if c.ext != nil {
+		return "WithExtMap(" + c.ext.Marshal() + ")"
+	}
+	return "WithPropertyAttribute(" + strconv.Quote(c.text) + ")"
+}
+
+// add applies the builder to md and returns the attribute it documents: for an extmap, what
+// ExtMap.Clone gives and the parser reads back (Key "extmap", Value the rest).
+func (c attrCase) add(md *sdp.MediaDescription) sdp.Attribute {
+	if c.ext != nil {
+		md.WithExtMap(*c.ext)
+		return c.ext.Clone()
+	}
+	md.WithPropertyAttribute(c.text)
+	return sdp.Attribute{Key: c.text}
+}
+
+var (
+	directions = hegel.SampledFrom([]sdp.Direction{0, sdp.DirectionSendRecv, sdp.DirectionSendOnly, sdp.DirectionRecvOnly, sdp.DirectionInactive})
+	// extAttrs: texts with and without ':'.
+	extAttrs = hegel.Text().Alphabet("abx1:-").MinSize(1).MaxSize(5)
+	extMaps  = hegel.Composite(func(tc hegel.TestCase) *sdp.ExtMap {
+		return &sdp.ExtMap{
+			Value:     hegel.Draw(tc, hegel.Integers(1, 246)),
+			Direction: hegel.Draw(tc, directions),
+			URI:       hegel.Draw(tc, maybe(70, hegel.Map(hegel.SampledFrom(hzRTURLs), mustParseURL))),
+			ExtAttr:   hegel.Draw(tc, optional(50, extAttrs)),
+		}
+	})
+	propertyTexts = hegel.Text().Alphabet("abx1-").MinSize(1).MaxSize(8)
+	attrCases     = shaped(
+		hegel.Map(extMaps, func(e *sdp.ExtMap) attrCase { return attrCase{ext: e} }),
+		hegel.Map(propertyTexts, func(s string) attrCase { return attrCase{text: s} }),
+	)
+)
+
+// TestHegelWithExtMapAddsAnExtmapAttribute: WithExtMap adds the attribute ExtMap.Clone
+// describes and the parser reads back from the marshalled line (Key "extmap", Value the
+// rest), so that Attribute("extmap") finds it; it adds the whole text as the key (sdp/13).
+// HEGEL_NO_KNOWN=1 draws property texts without ':' through WithPropertyAttribute, whose key
+// the builder keeps right.
+func TestHegelWithExtMapAddsAnExtmapAttribute(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, attrCases)
+		md := &sdp.MediaDescription{}
+		want := c.add(md)
+		got := md.Attributes[len(md.Attributes)-1]
+		if got != want {
+			col.mismatch(ht, "attribute", known("sdp/13"), "%s added Key %q Value %q; want Key %q Value %q", c.GoString(), got.Key, got.Value, want.Key, want.Value)
+			return
+		}
+		if v, ok := md.Attribute(want.Key); !ok || v != want.Value {
+			col.mismatch(ht, "lookup", known("sdp/13"), "%s: Attribute(%q) = %q, %v; want %q, true", c.GoString(), want.Key, v, ok, want.Value)
+			return
+		}
+		col.count("ok")
+	})
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..aa779c1
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,139 @@
+package hegel
+
+// One pin per recorded bug (bugs.toml), asserting the documented behaviour; expected failures
+// in target.toml while the bug exists.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/pion/sdp/v3"
+)
+
+const hzPinHead = "v=0\r\no=- 1 2 IN IP4 127.0.0.1\r\ns=-\r\n"
+
+func hzPinParse(text string) (*sdp.SessionDescription, error) {
+	var sd sdp.SessionDescription
+	err := sd.UnmarshalString(text)
+	return &sd, err
+}
+
+// sdp/1: a numeric field beyond uint64 wraps around instead of failing.
+func TestHegelPinNumericOverflow(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "t=99999999999999999999 0\r\n")
+	if err == nil {
+		t.Fatalf("t=99999999999999999999 0 accepted: StartTime = %d; want an error", sd.TimeDescriptions[0].Timing.StartTime)
+	}
+}
+
+// sdp/2: a missing numeric field reads as zero.
+func TestHegelPinMissingTimingFields(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "t=\r\n")
+	if err == nil {
+		t.Fatalf("t= (no fields) accepted as t=%d %d; want an error", sd.TimeDescriptions[0].Timing.StartTime, sd.TimeDescriptions[0].Timing.StopTime)
+	}
+}
+
+// sdp/3: a final numeric field "0" without a line break is an EOF error, "1" is accepted.
+func TestHegelPinZeroAtEndOfInput(t *testing.T) {
+	_, err1 := hzPinParse(hzPinHead + "t=1 1")
+	_, err0 := hzPinParse(hzPinHead + "t=1 0")
+	if (err1 == nil) != (err0 == nil) {
+		t.Fatalf("t=1 1 at the end of the input: %v; t=1 0: %v; want the same outcome", err1, err0)
+	}
+}
+
+// sdp/4: a document ending before its mandatory lines (even an empty one) is accepted.
+func TestHegelPinEmptyDocumentRejected(t *testing.T) {
+	sd, err := hzPinParse("")
+	if err == nil {
+		out, _ := sd.Marshal()
+		t.Fatalf("UnmarshalString(\"\") accepted, marshals as %q; want an error", out)
+	}
+}
+
+// sdp/5: a lone final byte without '=' is ignored.
+func TestHegelPinDanglingByte(t *testing.T) {
+	if _, err := hzPinParse(hzPinHead + "t=0 0\r\nm"); err == nil {
+		t.Fatalf("a trailing line \"m\" (no '=') accepted; want an error")
+	}
+}
+
+// sdp/6: a CR inside a text line cuts the same number of bytes from its end.
+func TestHegelPinCRInsideLine(t *testing.T) {
+	sd, err := hzPinParse("v=0\r\no=- 1 2 IN IP4 127.0.0.1\r\ns=a\rb\r\nt=0 0\r\n")
+	if err == nil && string(sd.SessionName) != "a\rb" {
+		t.Fatalf("s=a<CR>b: SessionName = %q; want \"a\\rb\" or an error", sd.SessionName)
+	}
+}
+
+// sdp/7: extra fields on a field-based line are read as the next line.
+func TestHegelPinExtraFieldOnTiming(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "t=0 0 a=b\r\n")
+	if err == nil {
+		t.Fatalf("t=0 0 a=b accepted with attributes %v; want an error", sd.Attributes)
+	}
+}
+
+// sdp/8: an unpaired trailing z= adjustment time is dropped.
+func TestHegelPinUnpairedTimeZone(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "t=0 0\r\nz=1 -1h 2\r\n")
+	if err == nil {
+		t.Fatalf("z=1 -1h 2 accepted as %v; want an error", sd.TimeZones)
+	}
+}
+
+// sdp/9: a connection address's TTL and range stay inside the Address string.
+func TestHegelPinConnectionTTL(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "c=IN IP4 224.2.1.1/127/3\r\nt=0 0\r\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := sd.ConnectionInformation.Address
+	if a.Address != "224.2.1.1" || a.TTL == nil || *a.TTL != 127 || a.Range == nil || *a.Range != 3 {
+		t.Fatalf("c=IN IP4 224.2.1.1/127/3: Address = %s; want \"224.2.1.1\" ttl 127 range 3", hzFmtAddress(a))
+	}
+}
+
+// sdp/10: "m=audio 9/2/3 ..." drops "/3".
+func TestHegelPinPortRangeTail(t *testing.T) {
+	sd, err := hzPinParse(hzPinHead + "t=0 0\r\nm=audio 9/2/3 RTP/AVP 0\r\n")
+	if err == nil {
+		t.Fatalf("m=audio 9/2/3 accepted as port %s; want an error", sd.MediaDescriptions[0].MediaName.Port.String())
+	}
+}
+
+// sdp/11: an unknown transport protocol is reported as an invalid numeric value.
+func TestHegelPinProtoErrorKind(t *testing.T) {
+	_, err := hzPinParse(hzPinHead + "t=0 0\r\nm=audio 9 RTP/XX 0\r\n")
+	if err == nil || strings.Contains(err.Error(), "numeric") {
+		t.Fatalf("m=audio 9 RTP/XX 0: %v; want an invalid value error", err)
+	}
+}
+
+// sdp/12: MarshalSize is one short for a media line without formats.
+func TestHegelPinMarshalSizeNoFormats(t *testing.T) {
+	sd := sdp.SessionDescription{
+		Origin:           sdp.Origin{Username: "-", NetworkType: "IN", AddressType: "IP4", UnicastAddress: "127.0.0.1"},
+		SessionName:      "-",
+		TimeDescriptions: []sdp.TimeDescription{{}},
+		MediaDescriptions: []*sdp.MediaDescription{{MediaName: sdp.MediaName{
+			Media: "audio", Port: sdp.RangedPort{Value: 9}, Protos: []string{"RTP", "AVP"}}}},
+	}
+	out, err := sd.Marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sd.MarshalSize() != len(out) {
+		t.Fatalf("MarshalSize %d, Marshal wrote %d bytes (%q)", sd.MarshalSize(), len(out), out)
+	}
+}
+
+// sdp/13: WithExtMap adds an attribute whose Key is the whole "extmap:..." text.
+func TestHegelPinWithExtMapAttribute(t *testing.T) {
+	md := &sdp.MediaDescription{}
+	md.WithExtMap(sdp.ExtMap{Value: 1})
+	if _, ok := md.Attribute("extmap"); !ok {
+		t.Fatalf("after WithExtMap the attributes are %+v; want Attribute(\"extmap\") to find it", md.Attributes)
+	}
+}
diff --git a/hegel/hegel_zoo_roundtrip_test.go b/hegel/hegel_zoo_roundtrip_test.go
new file mode 100644
index 0000000..0df28f8
--- /dev/null
+++ b/hegel/hegel_zoo_roundtrip_test.go
@@ -0,0 +1,277 @@
+package hegel
+
+// TestHegelRoundTrip: a generated SessionDescription (every field of the struct within what
+// the grammar can carry: no line breaks in text, attribute keys without ':', tokens without
+// whitespace, one or more time descriptions) marshalled and parsed back: the description is
+// unchanged, and MarshalSize is the length of Marshal's output.
+
+import (
+	"math"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/pion/sdp/v3"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	hzRTTexts  = []string{"-", "Session", "a b", "a:b", "k:", "a=b", "x  y", "caf\xc3\xa9", " lead", "trail ", "\t", "0"}
+	hzRTTokens = []string{"-", "jdoe", "1.2.3.4", "::1", "host.example", "x"}
+	hzRTKeys   = []string{"recvonly", "rtpmap", "fmtp", "mid", "x", "extmap", "a=b", "k"}
+	hzRTValues = []string{"", "0", "96 H264/90000", "a=1;b=2", "x:y", " v", "v "}
+	hzRTFmts   = []string{"0", "8", "96", "97", "webrtc-datachannel", "*"}
+	hzRTURLs   = []string{"http://example.com/x", "http://Example.com/a%20b", "urn:x", "a:b", "http://x/?q=1#f"}
+)
+
+// The description's values: numbers as weighted alternatives with zero first, optional texts
+// as maybe fields, the structs as Composites, the repeated ones as Lists.
+var (
+	rtUints = weighted(
+		choice[uint64]{20, hegel.Just(uint64(0))},
+		choice[uint64]{20, hegel.Integers[uint64](1, 1000)},
+		choice[uint64]{40, hegel.Integers[uint64](0, 1<<31)},
+		choice[uint64]{20, hegel.Just[uint64](math.MaxUint64)},
+	)
+	rtInts = weighted(
+		choice[int64]{25, hegel.Just(int64(0))},
+		choice[int64]{25, hegel.Integers[int64](-100000, -1)},
+		choice[int64]{50, hegel.Integers[int64](1, 100000)},
+	)
+	rtTexts     = hegel.SampledFrom(hzRTTexts)
+	rtTokens    = hegel.SampledFrom(hzRTTokens)
+	rtAddrTypes = hegel.SampledFrom([]string{"IP4", "IP6"})
+	rtAddrs     = hegel.SampledFrom([]string{"1.2.3.4", "224.2.1.1", "::1", "host.example"})
+	// rtAddress: a connection address, with a TTL (25%) and a range (20%), the shape of sdp/9.
+	rtAddress = rtAddressWith(optional(25, hegel.Integers(0, 255)), optional(20, hegel.Integers(0, 10)))
+	rtConn    = rtConnWith(rtAddress)
+	rtURIs    = maybe(25, hegel.Map(hegel.SampledFrom(hzRTURLs), mustParseURL))
+
+	rtStdBandwidth = hegel.Composite(func(tc hegel.TestCase) sdp.Bandwidth {
+		return sdp.Bandwidth{Type: hegel.Draw(tc, hegel.SampledFrom([]string{"AS", "CT", "TIAS", "RS", "RR"})), Bandwidth: hegel.Draw(tc, rtUints)}
+	})
+	rtExpBandwidth = hegel.Composite(func(tc hegel.TestCase) sdp.Bandwidth {
+		return sdp.Bandwidth{Experimental: true, Type: hegel.Draw(tc, hegel.SampledFrom([]string{"foo", "", "AS", "x-y"})), Bandwidth: hegel.Draw(tc, rtUints)}
+	})
+	rtBandwidths = hegel.Lists(weighted(choice[sdp.Bandwidth]{75, rtStdBandwidth}, choice[sdp.Bandwidth]{25, rtExpBandwidth})).MaxSize(2)
+
+	rtAttr = hegel.Composite(func(tc hegel.TestCase) sdp.Attribute {
+		return sdp.Attribute{Key: hegel.Draw(tc, hegel.SampledFrom(hzRTKeys)), Value: hegel.Draw(tc, maybe(60, hegel.SampledFrom(hzRTValues)))}
+	})
+	rtAttrs = hegel.Lists(rtAttr).MaxSize(3)
+
+	rtRepeat = hegel.Composite(func(tc hegel.TestCase) sdp.RepeatTime {
+		return sdp.RepeatTime{Interval: hegel.Draw(tc, rtInts), Duration: hegel.Draw(tc, rtInts), Offsets: hegel.Draw(tc, hegel.Lists(rtInts).MaxSize(3))}
+	})
+	rtTimeDesc = hegel.Composite(func(tc hegel.TestCase) sdp.TimeDescription {
+		return sdp.TimeDescription{
+			Timing:      sdp.Timing{StartTime: hegel.Draw(tc, rtUints), StopTime: hegel.Draw(tc, rtUints)},
+			RepeatTimes: hegel.Draw(tc, hegel.Lists(rtRepeat).MaxSize(2)),
+		}
+	})
+	rtTimeDescs = many(rtTimeDesc, 1, 2)
+	rtZone      = hegel.Composite(func(tc hegel.TestCase) sdp.TimeZone {
+		return sdp.TimeZone{AdjustmentTime: hegel.Draw(tc, rtUints), Offset: hegel.Draw(tc, rtInts)}
+	})
+	rtZones = hegel.Lists(rtZone).MaxSize(3)
+
+	rtMediaTypes = hegel.SampledFrom([]string{"audio", "video", "text", "application", "message"})
+	rtProtos     = hegel.SampledFrom([][]string{{"RTP", "AVP"}, {"UDP", "TLS", "RTP", "SAVPF"}, {"UDP", "DTLS", "SCTP"}, {"TCP", "MSRP"}})
+	// rtFormats: 0-3 formats; none is the shape of sdp/12.
+	rtFormats = hegel.Lists(hegel.SampledFrom(hzRTFmts)).MaxSize(3)
+	rtMedia   = rtMediaWith(rtFormats, rtConn)
+	rtMedias  = hegel.Lists(rtMedia).MaxSize(2)
+	rtDescs   = rtDescWith(rtConn, rtMedias)
+)
+
+func mustParseURL(s string) *url.URL {
+	u, err := url.Parse(s)
+	if err != nil {
+		panic(err)
+	}
+	return u
+}
+
+// rtOpt is an optional text field of a string type, present pct percent of the time.
+func rtOpt[T ~string](pct int) hegel.Generator[*T] {
+	return optional(pct, hegel.Map(rtTexts, func(s string) T { return T(s) }))
+}
+
+// rtAddressWith is a connection address with the given TTL and range fields.
+func rtAddressWith(ttl, rng hegel.Generator[*int]) hegel.Generator[*sdp.Address] {
+	return hegel.Composite(func(tc hegel.TestCase) *sdp.Address {
+		return &sdp.Address{Address: hegel.Draw(tc, rtAddrs), TTL: hegel.Draw(tc, ttl), Range: hegel.Draw(tc, rng)}
+	})
+}
+
+// rtConnWith is connection information whose address (85% of the time) comes from addrs.
+func rtConnWith(addrs hegel.Generator[*sdp.Address]) hegel.Generator[*sdp.ConnectionInformation] {
+	return hegel.Composite(func(tc hegel.TestCase) *sdp.ConnectionInformation {
+		return &sdp.ConnectionInformation{NetworkType: "IN", AddressType: hegel.Draw(tc, rtAddrTypes), Address: hegel.Draw(tc, maybe(85, addrs))}
+	})
+}
+
+// rtMediaWith is a media description whose formats come from formats and whose connection
+// information (40% of the time) from conns.
+func rtMediaWith(formats hegel.Generator[[]string], conns hegel.Generator[*sdp.ConnectionInformation]) hegel.Generator[*sdp.MediaDescription] {
+	return hegel.Composite(func(tc hegel.TestCase) *sdp.MediaDescription {
+		return &sdp.MediaDescription{
+			MediaName: sdp.MediaName{
+				Media:   hegel.Draw(tc, rtMediaTypes),
+				Port:    sdp.RangedPort{Value: hegel.Draw(tc, hegel.Integers(0, 65535)), Range: hegel.Draw(tc, optional(20, hegel.Integers(0, 10)))},
+				Protos:  hegel.Draw(tc, rtProtos),
+				Formats: hegel.Draw(tc, formats),
+			},
+			MediaTitle:            hegel.Draw(tc, rtOpt[sdp.Information](20)),
+			ConnectionInformation: hegel.Draw(tc, maybe(40, conns)),
+			Bandwidth:             hegel.Draw(tc, rtBandwidths),
+			EncryptionKey:         hegel.Draw(tc, rtOpt[sdp.EncryptionKey](15)),
+			Attributes:            hegel.Draw(tc, rtAttrs),
+		}
+	})
+}
+
+// rtDesc wraps the description for the draw report.
+type rtDesc struct{ s *sdp.SessionDescription }
+
+// GoString is what the draw report prints (it uses %#v).
+func (d rtDesc) GoString() string { return "\n" + hzFmtDesc(d.s) }
+
+// rtDescWith is a session description whose connection information (30% of the time) comes
+// from conns and whose media from medias.
+func rtDescWith(conns hegel.Generator[*sdp.ConnectionInformation], medias hegel.Generator[[]*sdp.MediaDescription]) hegel.Generator[rtDesc] {
+	return hegel.Composite(func(tc hegel.TestCase) rtDesc {
+		return rtDesc{&sdp.SessionDescription{
+			Origin: sdp.Origin{
+				Username: hegel.Draw(tc, rtTokens), SessionID: hegel.Draw(tc, rtUints), SessionVersion: hegel.Draw(tc, rtUints),
+				NetworkType: "IN", AddressType: hegel.Draw(tc, rtAddrTypes), UnicastAddress: hegel.Draw(tc, rtTokens),
+			},
+			SessionName:           sdp.SessionName(hegel.Draw(tc, hegel.SampledFrom(append([]string{""}, hzRTTexts...)))),
+			SessionInformation:    hegel.Draw(tc, rtOpt[sdp.Information](25)),
+			URI:                   hegel.Draw(tc, rtURIs),
+			EmailAddress:          hegel.Draw(tc, rtOpt[sdp.EmailAddress](20)),
+			PhoneNumber:           hegel.Draw(tc, rtOpt[sdp.PhoneNumber](20)),
+			ConnectionInformation: hegel.Draw(tc, maybe(30, conns)),
+			Bandwidth:             hegel.Draw(tc, rtBandwidths),
+			TimeDescriptions:      hegel.Draw(tc, rtTimeDescs),
+			TimeZones:             hegel.Draw(tc, rtZones),
+			EncryptionKey:         hegel.Draw(tc, rtOpt[sdp.EncryptionKey](20)),
+			Attributes:            hegel.Draw(tc, rtAttrs),
+			MediaDescriptions:     hegel.Draw(tc, medias),
+		}}
+	})
+}
+
+// hasTTLOrRange reports whether a connection address carries a TTL or a range.
+func hasTTLOrRange(c *sdp.ConnectionInformation) bool {
+	return c != nil && c.Address != nil && (c.Address.TTL != nil || c.Address.Range != nil)
+}
+
+// hzExpectedAfterRoundTrip is what the documented grammar carries: the description itself.
+// A connection address with a TTL or a range is the shape of sdp/9 (named); as recorded, the
+// TTL and range come back inside the address string, which the switch folds in.
+func hzExpectedAfterRoundTrip(s *sdp.SessionDescription) (string, []string) {
+	shaped := hasTTLOrRange(s.ConnectionInformation)
+	for _, m := range s.MediaDescriptions {
+		shaped = shaped || hasTTLOrRange(m.ConnectionInformation)
+	}
+	if !shaped {
+		return hzFmtDesc(s), nil
+	}
+	if !HZKnown.connectionTTLNotParsed {
+		return hzFmtDesc(s), []string{"sdp/9"}
+	}
+	fix := func(c *sdp.ConnectionInformation) {
+		if c == nil || c.Address == nil {
+			return
+		}
+		a := *c.Address
+		if a.TTL != nil {
+			a.Address += "/" + strconv.Itoa(*a.TTL)
+		}
+		if a.Range != nil {
+			a.Address += "/" + strconv.Itoa(*a.Range)
+		}
+		a.TTL, a.Range = nil, nil
+		c.Address = &a
+	}
+	copyDesc := *s
+	if s.ConnectionInformation != nil {
+		c := *s.ConnectionInformation
+		fix(&c)
+		copyDesc.ConnectionInformation = &c
+	}
+	var media []*sdp.MediaDescription
+	for _, m := range s.MediaDescriptions {
+		mm := *m
+		if m.ConnectionInformation != nil {
+			c := *m.ConnectionInformation
+			fix(&c)
+			mm.ConnectionInformation = &c
+		}
+		media = append(media, &mm)
+	}
+	copyDesc.MediaDescriptions = media
+	return hzFmtDesc(&copyDesc), nil
+}
+
+// judgeRoundTrip marshals s, checks MarshalSize against the output, parses the output back
+// and compares every field with the description; the output has CRLF line ends only. A media
+// description without formats is the shape of sdp/12 at the size check (named; as recorded
+// the switch allows one byte less per such media).
+func judgeRoundTrip(ht *hegel.T, col *hzCollector, s *sdp.SessionDescription) {
+	before := hzFmtDesc(s)
+	var out []byte
+	var err error
+	if r := hzCatch(func() { out, err = s.Marshal() }); r != nil {
+		col.failClass(ht, "marshal-panic", "Marshal panicked: %v\n%s", r, before)
+		return
+	}
+	if err != nil {
+		col.failClass(ht, "marshal-error", "Marshal: %v\n%s", err, before)
+		return
+	}
+	size := s.MarshalSize()
+	wantSize := len(out)
+	var sizeShape []string
+	for _, m := range s.MediaDescriptions {
+		if len(m.MediaName.Formats) == 0 {
+			if HZKnown.emptyFormatsSizeOffByOne {
+				wantSize--
+			} else {
+				sizeShape = []string{"sdp/12"}
+			}
+		}
+	}
+	if size != wantSize {
+		col.mismatch(ht, "size", sizeShape, "MarshalSize %d, Marshal wrote %d bytes: %q", size, len(out), out)
+		return
+	}
+	var back sdp.SessionDescription
+	if r := hzCatch(func() { err = back.UnmarshalString(string(out)) }); r != nil {
+		col.failClass(ht, "unmarshal-panic", "UnmarshalString(%q) panicked: %v", out, r)
+		return
+	}
+	if err != nil {
+		col.failClass(ht, "unmarshal-error", "UnmarshalString(%q): %v\n%s", out, err, before)
+		return
+	}
+	want, shape := hzExpectedAfterRoundTrip(s)
+	if got := hzFmtDesc(&back); got != want {
+		col.mismatch(ht, "fields", shape, "round trip of %q:\n  got:\n%s\n  want:\n%s", out, got, want)
+		return
+	}
+	col.count("ok")
+	if strings.Count(string(out), "\r\n") != strings.Count(string(out), "\n") {
+		col.failClass(ht, "crlf", "Marshal wrote a bare LF: %q", out)
+	}
+}
+
+func TestHegelRoundTrip(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, rtDescs)
+		judgeRoundTrip(ht, col, d.s)
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..cc50a4e
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,305 @@
+package hegel
+
+// Hegel property tests for pion/sdp v3, written for the Hegel zoo. See targets/go/sdp/README.md.
+// They live in a package of their own (hegel/) and drive the public API: UnmarshalString on
+// generated text, Marshal/MarshalSize/UnmarshalString round trips of generated descriptions.
+//
+// Oracle: a model of RFC 4566 section 5 as the package documents it (the state table in
+// unmarshal.go), and the description itself for round trips.
+//
+// Generators are package-level values built from the binding's combinators: a line is a record
+// of its type, fields and separator tape with the malformed variant it carries named; a
+// document is the grammar-ordered line records, a list of mutation records applied modulo the
+// live number of lines, a line-end tape and the final-line options; a description for the
+// round trip is a Composite over Composites of the structs. Pure functions render them.
+//
+// Known bugs (bugs.toml): the generators draw the shapes of the recorded bugs at their natural
+// rate and the model says what the documentation says, so the two wide properties fail on them
+// and name the shape ("the shape of sdp/N"); hegel_shapes_test.go has one narrow property per
+// bug over its shape region alone, and the pins are the regression examples. HEGEL_NO_KNOWN=1
+// (noKnown, read once) turns every switch of HZKnown on: the model then reproduces the recorded
+// behaviour and the properties look past the known bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing and print the counts of every class and shape.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is a disagreement with the oracle on a case that has the shape of the recorded
+// bugs named (none for a plain failure): the failure names the shape. Under HEGEL_NO_KNOWN=1
+// the model reproduces the recorded behaviour, so a disagreement cannot carry a shape; one
+// that still does is skipped rather than reported (never seen; the collect counts would show
+// it as "shape sdp/N" without a mismatch).
+func (c *hzCollector) mismatch(ht *hegel.T, class string, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		ht.Assume(!noKnown)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch of HZKnown is off: the model says what the documentation says, the generators
+// draw the bugs' shapes and the properties that meet them fail, naming the shape. Under
+// HEGEL_NO_KNOWN=1 every switch is on and the model reproduces the recorded behaviour.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on, which is so only under HEGEL_NO_KNOWN=1; the pins assert
+// the documented behaviour and fail while the bug exists, and hegel_shapes_test.go has a
+// property per bug.
+var HZKnown = struct {
+	uintWraps                 bool // sdp/1: a numeric field beyond uint64 wraps around instead of failing
+	missingNumericIsZero      bool // sdp/2: a missing numeric field (t=, t=5, v=) reads as zero
+	zeroAtEOFFails            bool // sdp/3: a numeric field "0" that ends the input is an EOF error (t=1 0 without a line break)
+	truncatedDocumentAccepted bool // sdp/4: input ending before t= (even empty) is accepted
+	danglingByteIgnored       bool // sdp/5: a single trailing byte without '=' is ignored
+	crCountTrimsLine          bool // sdp/6: every CR in a text line cuts a byte from its end
+	extraFieldStartsLine      bool // sdp/7: extra fields on a field line are read as the next line
+	timeZoneOddDropped        bool // sdp/8: an unpaired trailing z= adjustment time is dropped, z= alone accepted
+	connectionTTLNotParsed    bool // sdp/9: c= address keeps "/ttl/range" in the Address string
+	portRangeTailIgnored      bool // sdp/10: m= port "9/2/3" drops "/3"
+	protoErrorIsNumeric       bool // sdp/11: an unknown m= proto reports "invalid numeric value"
+	emptyFormatsSizeOffByOne  bool // sdp/12: MarshalSize is one short for a media line without formats (Marshal writes a trailing space)
+}{
+	uintWraps:                 noKnown,
+	missingNumericIsZero:      noKnown,
+	zeroAtEOFFails:            noKnown,
+	truncatedDocumentAccepted: noKnown,
+	danglingByteIgnored:       noKnown,
+	crCountTrimsLine:          noKnown,
+	extraFieldStartsLine:      noKnown,
+	timeZoneOddDropped:        noKnown,
+	connectionTTLNotParsed:    noKnown,
+	portRangeTailIgnored:      noKnown,
+	protoErrorIsNumeric:       noKnown,
+	emptyFormatsSizeOffByOne:  noKnown,
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string {
+	if noKnown {
+		return nil
+	}
+	return []string{id}
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// one is a list of exactly one element of g.
+func one[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(x T) []T { return []T{x} })
+}
+
+// fields draws one value from each generator, in order.
+func fields(gens ...hegel.Generator[string]) hegel.Generator[[]string] {
+	return hegel.Composite(func(tc hegel.TestCase) []string {
+		out := make([]string, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// cat is the concatenation of the lists of its generators, drawn in order.
+func cat[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// flatten joins the lists of a list.
+func flatten[T any](xss [][]T) []T {
+	var out []T
+	for _, xs := range xss {
+		out = append(out, xs...)
+	}
+	return out
+}
+
+// tapeAt reads a tape modulo its length; an empty tape reads as plain.
+func tapeAt(tape []string, i int, plain string) string {
+	if len(tape) == 0 {
+		return plain
+	}
+	return tape[i%len(tape)]
+}
diff --git a/hegel/hegel_zoo_unmarshal_test.go b/hegel/hegel_zoo_unmarshal_test.go
new file mode 100644
index 0000000..62a5c5c
--- /dev/null
+++ b/hegel/hegel_zoo_unmarshal_test.go
@@ -0,0 +1,1387 @@
+package hegel
+
+// TestHegelUnmarshal: generated SDP text (a mostly well-formed session description with
+// mutations: missing or reordered lines, unknown types, blank lines, LF endings, tabs and
+// runs of spaces, extra or missing fields, out-of-range and malformed numbers, stray CRs, a
+// missing final line break) parsed by SessionDescription.UnmarshalString, against a model of
+// RFC 4566 section 5 as the package documents it (the state table in unmarshal.go). Compared:
+// the error class, or every field of the description.
+
+import (
+	"fmt"
+	"math"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/pion/sdp/v3"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- model values
+
+type mAddress struct {
+	addr string
+	ttl  *int
+	rng  *int
+}
+
+type mConn struct {
+	net, addrType string
+	address       *mAddress
+}
+
+type mBandwidth struct {
+	experimental bool
+	typ          string
+	bw           uint64
+}
+
+type mRepeat struct {
+	interval, duration int64
+	offsets            []int64
+}
+
+type mTimeDesc struct {
+	start, stop uint64
+	repeats     []mRepeat
+}
+
+type mZone struct {
+	adj    uint64
+	offset int64
+}
+
+type mAttr struct{ key, value string }
+
+type mMedia struct {
+	media   string
+	port    int
+	rng     *int
+	protos  []string
+	formats []string
+	title   *string
+	conn    *mConn
+	bw      []mBandwidth
+	key     *string
+	attrs   []mAttr
+}
+
+type mDesc struct {
+	version  uint64
+	username string
+	sessID   uint64
+	sessVer  uint64
+	net      string
+	addrType string
+	unicast  string
+	name     string
+	info     *string
+	uri      *string
+	email    *string
+	phone    *string
+	conn     *mConn
+	bw       []mBandwidth
+	times    []mTimeDesc
+	zones    []mZone
+	key      *string
+	attrs    []mAttr
+	media    []*mMedia
+}
+
+// --------------------------------------------------------------------------- formatting
+
+func hzFmtAddress(a *sdp.Address) string {
+	if a == nil {
+		return "-"
+	}
+	s := strconv.Quote(a.Address)
+	if a.TTL != nil {
+		s += "/ttl=" + strconv.Itoa(*a.TTL)
+	}
+	if a.Range != nil {
+		s += "/range=" + strconv.Itoa(*a.Range)
+	}
+	return s
+}
+
+func hzFmtConn(c *sdp.ConnectionInformation) string {
+	if c == nil {
+		return "-"
+	}
+	return fmt.Sprintf("%q %q %s", c.NetworkType, c.AddressType, hzFmtAddress(c.Address))
+}
+
+func hzFmtOptString[T ~string](p *T) string {
+	if p == nil {
+		return "-"
+	}
+	return strconv.Quote(string(*p))
+}
+
+func hzFmtBandwidth(bs []sdp.Bandwidth) string {
+	var parts []string
+	for _, b := range bs {
+		parts = append(parts, fmt.Sprintf("%v/%q/%d", b.Experimental, b.Type, b.Bandwidth))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func hzFmtAttrs(as []sdp.Attribute) string {
+	var parts []string
+	for _, a := range as {
+		parts = append(parts, fmt.Sprintf("%q=%q", a.Key, a.Value))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// hzFmtDesc prints every field of a parsed description.
+func hzFmtDesc(s *sdp.SessionDescription) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "v=%d\n", s.Version)
+	o := s.Origin
+	fmt.Fprintf(&b, "o=%q %d %d %q %q %q\n", o.Username, o.SessionID, o.SessionVersion, o.NetworkType, o.AddressType, o.UnicastAddress)
+	fmt.Fprintf(&b, "s=%q\n", string(s.SessionName))
+	fmt.Fprintf(&b, "i=%s\n", hzFmtOptString(s.SessionInformation))
+	if s.URI == nil {
+		b.WriteString("u=-\n")
+	} else {
+		fmt.Fprintf(&b, "u=%q\n", s.URI.String())
+	}
+	fmt.Fprintf(&b, "e=%s\n", hzFmtOptString(s.EmailAddress))
+	fmt.Fprintf(&b, "p=%s\n", hzFmtOptString(s.PhoneNumber))
+	fmt.Fprintf(&b, "c=%s\n", hzFmtConn(s.ConnectionInformation))
+	fmt.Fprintf(&b, "b=%s\n", hzFmtBandwidth(s.Bandwidth))
+	for _, td := range s.TimeDescriptions {
+		fmt.Fprintf(&b, "t=%d %d\n", td.Timing.StartTime, td.Timing.StopTime)
+		for _, r := range td.RepeatTimes {
+			fmt.Fprintf(&b, "r=%d %d %v\n", r.Interval, r.Duration, r.Offsets)
+		}
+	}
+	for _, z := range s.TimeZones {
+		fmt.Fprintf(&b, "z=%d %d\n", z.AdjustmentTime, z.Offset)
+	}
+	fmt.Fprintf(&b, "k=%s\n", hzFmtOptString(s.EncryptionKey))
+	fmt.Fprintf(&b, "a=%s\n", hzFmtAttrs(s.Attributes))
+	for _, m := range s.MediaDescriptions {
+		rng := "-"
+		if m.MediaName.Port.Range != nil {
+			rng = strconv.Itoa(*m.MediaName.Port.Range)
+		}
+		fmt.Fprintf(&b, "m=%q %d/%s %q %q\n", m.MediaName.Media, m.MediaName.Port.Value, rng, m.MediaName.Protos, m.MediaName.Formats)
+		fmt.Fprintf(&b, " i=%s\n", hzFmtOptString(m.MediaTitle))
+		fmt.Fprintf(&b, " c=%s\n", hzFmtConn(m.ConnectionInformation))
+		fmt.Fprintf(&b, " b=%s\n", hzFmtBandwidth(m.Bandwidth))
+		fmt.Fprintf(&b, " k=%s\n", hzFmtOptString(m.EncryptionKey))
+		fmt.Fprintf(&b, " a=%s\n", hzFmtAttrs(m.Attributes))
+	}
+	return b.String()
+}
+
+func mFmtOpt(p *string) string {
+	if p == nil {
+		return "-"
+	}
+	return strconv.Quote(*p)
+}
+
+func mFmtConn(c *mConn) string {
+	if c == nil {
+		return "-"
+	}
+	a := "-"
+	if c.address != nil {
+		a = strconv.Quote(c.address.addr)
+		if c.address.ttl != nil {
+			a += "/ttl=" + strconv.Itoa(*c.address.ttl)
+		}
+		if c.address.rng != nil {
+			a += "/range=" + strconv.Itoa(*c.address.rng)
+		}
+	}
+	return fmt.Sprintf("%q %q %s", c.net, c.addrType, a)
+}
+
+func mFmtBandwidth(bs []mBandwidth) string {
+	var parts []string
+	for _, b := range bs {
+		parts = append(parts, fmt.Sprintf("%v/%q/%d", b.experimental, b.typ, b.bw))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func mFmtAttrs(as []mAttr) string {
+	var parts []string
+	for _, a := range as {
+		parts = append(parts, fmt.Sprintf("%q=%q", a.key, a.value))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func (d *mDesc) format() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "v=%d\n", d.version)
+	fmt.Fprintf(&b, "o=%q %d %d %q %q %q\n", d.username, d.sessID, d.sessVer, d.net, d.addrType, d.unicast)
+	fmt.Fprintf(&b, "s=%q\n", d.name)
+	fmt.Fprintf(&b, "i=%s\n", mFmtOpt(d.info))
+	fmt.Fprintf(&b, "u=%s\n", mFmtOpt(d.uri))
+	fmt.Fprintf(&b, "e=%s\n", mFmtOpt(d.email))
+	fmt.Fprintf(&b, "p=%s\n", mFmtOpt(d.phone))
+	fmt.Fprintf(&b, "c=%s\n", mFmtConn(d.conn))
+	fmt.Fprintf(&b, "b=%s\n", mFmtBandwidth(d.bw))
+	for _, td := range d.times {
+		fmt.Fprintf(&b, "t=%d %d\n", td.start, td.stop)
+		for _, r := range td.repeats {
+			fmt.Fprintf(&b, "r=%d %d %v\n", r.interval, r.duration, r.offsets)
+		}
+	}
+	for _, z := range d.zones {
+		fmt.Fprintf(&b, "z=%d %d\n", z.adj, z.offset)
+	}
+	fmt.Fprintf(&b, "k=%s\n", mFmtOpt(d.key))
+	fmt.Fprintf(&b, "a=%s\n", mFmtAttrs(d.attrs))
+	for _, m := range d.media {
+		rng := "-"
+		if m.rng != nil {
+			rng = strconv.Itoa(*m.rng)
+		}
+		fmt.Fprintf(&b, "m=%q %d/%s %q %q\n", m.media, m.port, rng, m.protos, m.formats)
+		fmt.Fprintf(&b, " i=%s\n", mFmtOpt(m.title))
+		fmt.Fprintf(&b, " c=%s\n", mFmtConn(m.conn))
+		fmt.Fprintf(&b, " b=%s\n", mFmtBandwidth(m.bw))
+		fmt.Fprintf(&b, " k=%s\n", mFmtOpt(m.key))
+		fmt.Fprintf(&b, " a=%s\n", mFmtAttrs(m.attrs))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- model lexer
+
+// The error classes compared: the package's sentinel errors and the two others it returns.
+const (
+	eSyntax  = "syntax error"
+	eEOF     = "EOF"
+	eValue   = "invalid value"
+	eNumeric = "invalid numeric value"
+	ePort    = "invalid port value"
+	eURL     = "url"
+	eInvalid = "invalid syntax"
+)
+
+type mErr struct{ class string }
+
+func (e *mErr) Error() string { return e.class }
+
+func hzErrClass(err error) string {
+	s := err.Error()
+	switch {
+	case strings.HasPrefix(s, "sdp: syntax error"):
+		return eSyntax
+	case s == "EOF":
+		return eEOF
+	case strings.HasPrefix(s, "sdp: invalid numeric value"):
+		return eNumeric
+	case strings.HasPrefix(s, "sdp: invalid port value"):
+		return ePort
+	case strings.HasPrefix(s, "sdp: invalid value"):
+		return eValue
+	case strings.HasPrefix(s, "sdp: invalid syntax"):
+		return eInvalid
+	case strings.HasPrefix(s, "parse "):
+		return eURL
+	}
+	return "other: " + s
+}
+
+// mLexer scans the input for the model. Wherever a switch of HZKnown is consulted and the
+// documented reading (the switch off) parts from the recorded behaviour, the lexer records the
+// bug's id in shapes: a disagreement with the package on the case then names it.
+type mLexer struct {
+	in     string
+	pos    int
+	d      *mDesc
+	shapes []string
+}
+
+// shape records that the case has the shape of a recorded bug, once per id.
+func (l *mLexer) shape(id string) {
+	for _, s := range l.shapes {
+		if s == id {
+			return
+		}
+	}
+	l.shapes = append(l.shapes, id)
+}
+
+func isNL(c byte) bool    { return c == '\n' || c == '\r' }
+func isWS(c byte) bool    { return c == ' ' || c == '\t' }
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+// readType: skips line breaks, reads "<type>=". At the end of the input: (0, eof). Documented,
+// a lone final byte is an unfinished line (an EOF error); as recorded (sdp/5) it is also the
+// end.
+func (l *mLexer) readType() (byte, bool, error) {
+	for l.pos < len(l.in) && isNL(l.in[l.pos]) {
+		l.pos++
+	}
+	if l.pos >= len(l.in) {
+		return 0, true, nil
+	}
+	if l.pos+1 >= len(l.in) {
+		if HZKnown.danglingByteIgnored {
+			return 0, true, nil
+		}
+		l.shape("sdp/5")
+		return 0, false, &mErr{eEOF}
+	}
+	key := l.in[l.pos]
+	if l.in[l.pos+1] != '=' {
+		l.pos += 2
+		return key, false, &mErr{eSyntax}
+	}
+	l.pos += 2
+	return key, false, nil
+}
+
+// readField: a run of bytes up to whitespace, a line break or the end; consumes the
+// whitespace after it. Empty at a line break; at the end of the input an empty field is an
+// EOF error.
+func (l *mLexer) readField() (string, error) {
+	start := l.pos
+	for l.pos < len(l.in) && !isNL(l.in[l.pos]) && !isWS(l.in[l.pos]) {
+		l.pos++
+	}
+	stop := l.pos
+	if l.pos >= len(l.in) && stop == start {
+		return "", &mErr{eEOF}
+	}
+	for l.pos < len(l.in) && isWS(l.in[l.pos]) {
+		l.pos++
+	}
+	return l.in[start:stop], nil
+}
+
+// readUint: a decimal field. Documented: the digits of a uint64 (RFC 4566: numeric fields are
+// decimal), a missing field is malformed, and the end of the input may follow any final
+// number; as recorded (sdp/1) an overflow wraps, (sdp/2) an empty field is zero, (sdp/3) a
+// zero as the last token of the input is an EOF error.
+func (l *mLexer) readUint() (uint64, error) {
+	start := l.pos
+	var v uint64
+	digits := 0
+	for l.pos < len(l.in) {
+		c := l.in[l.pos]
+		if isNL(c) {
+			break
+		}
+		if isWS(c) {
+			for l.pos < len(l.in) && isWS(l.in[l.pos]) {
+				l.pos++
+			}
+			break
+		}
+		if !isDigit(c) {
+			l.pos++
+			return 0, &mErr{eSyntax}
+		}
+		l.pos++
+		digits++
+		if v > (math.MaxUint64-uint64(c-'0'))/10 && !HZKnown.uintWraps {
+			l.shape("sdp/1")
+			return 0, &mErr{eNumeric}
+		}
+		v = v*10 + uint64(c-'0')
+	}
+	if l.pos >= len(l.in) && start < len(l.in) && isDigit(l.in[len(l.in)-1]) {
+		// The field ran into the end of the input.
+		if v == 0 {
+			if HZKnown.zeroAtEOFFails {
+				return 0, &mErr{eEOF}
+			}
+			l.shape("sdp/3")
+		}
+	} else if l.pos >= len(l.in) && digits == 0 {
+		return 0, &mErr{eEOF}
+	}
+	if digits == 0 && !HZKnown.missingNumericIsZero {
+		l.shape("sdp/2")
+		return 0, &mErr{eSyntax}
+	}
+	return v, nil
+}
+
+// readLine: the rest of the line up to LF, without the CRs before the LF. Documented: lines
+// end in CRLF (or LF) and a CR inside the line is part of it; as recorded (sdp/6) every CR in
+// the line counts as trailing and cuts the same number of bytes from the end.
+func (l *mLexer) readLine() (string, error) {
+	start := l.pos
+	crs := 0
+	for l.pos < len(l.in) {
+		c := l.in[l.pos]
+		l.pos++
+		if c == '\r' {
+			crs++
+		}
+		if c == '\n' {
+			line := strings.TrimRight(l.in[start:l.pos-1], "\r")
+			if cut := l.in[start : l.pos-1-crs]; cut != line {
+				if HZKnown.crCountTrimsLine {
+					return cut, nil
+				}
+				l.shape("sdp/6")
+			}
+			return line, nil
+		}
+	}
+	return "", &mErr{eEOF}
+}
+
+// nextLine: skips line breaks. Documented, anything else after the last field of a field line
+// is a syntax error; as recorded (sdp/7) it stays for the next line, so extra fields on a
+// field-based line are read as a line of their own.
+func (l *mLexer) nextLine() error {
+	if l.pos < len(l.in) && !isNL(l.in[l.pos]) && !HZKnown.extraFieldStartsLine {
+		l.shape("sdp/7")
+		return &mErr{eSyntax}
+	}
+	for l.pos < len(l.in) && isNL(l.in[l.pos]) {
+		l.pos++
+	}
+	return nil
+}
+
+// atLineBreak reports whether only whitespace is left before a line break.
+func (l *mLexer) atLineBreak() bool {
+	i := l.pos
+	for i < len(l.in) && isWS(l.in[i]) {
+		i++
+	}
+	return i < len(l.in) && isNL(l.in[i])
+}
+
+func mParseTimeUnits(s string) (int64, error) {
+	if s == "" {
+		return 0, &mErr{eValue}
+	}
+	k := int64(1)
+	switch s[len(s)-1] {
+	case 'd':
+		k = 86400
+	case 'h':
+		k = 3600
+	case 'm':
+		k = 60
+	case 's':
+		k = 1
+	default:
+		k = 0
+	}
+	num := s
+	if k > 0 {
+		num = s[:len(s)-1]
+	} else {
+		k = 1
+	}
+	n, err := strconv.ParseInt(num, 10, 64)
+	if err != nil {
+		return 0, &mErr{eValue}
+	}
+	return n * k, nil
+}
+
+func mParseBandwidth(s string) (*mBandwidth, bool) {
+	parts := strings.Split(s, ":")
+	if len(parts) != 2 {
+		return nil, false
+	}
+	b := &mBandwidth{}
+	if strings.HasPrefix(parts[0], "X-") {
+		b.experimental = true
+		b.typ = parts[0][2:]
+	} else if !anyOf(parts[0], "CT", "AS", "TIAS", "RS", "RR") {
+		return nil, false
+	} else {
+		b.typ = parts[0]
+	}
+	n, err := strconv.ParseUint(parts[1], 10, 64)
+	if err != nil {
+		return nil, false
+	}
+	b.bw = n
+	return b, true
+}
+
+func anyOf(s string, xs ...string) bool {
+	for _, x := range xs {
+		if s == x {
+			return true
+		}
+	}
+	return false
+}
+
+// readConn: "<nettype> <addrtype> [<address>]". Documented (RFC 4566 5.7) the address is
+// <base multicast address>[/<ttl>]/<number of addresses>; as recorded (sdp/9) the whole field
+// is the address.
+func (l *mLexer) readConn() (*mConn, error) {
+	c := &mConn{}
+	var err error
+	if c.net, err = l.readField(); err != nil {
+		return nil, err
+	}
+	if c.net != "IN" {
+		return nil, &mErr{eValue}
+	}
+	if c.addrType, err = l.readField(); err != nil {
+		return nil, err
+	}
+	if !anyOf(c.addrType, "IP4", "IP6") {
+		return nil, &mErr{eValue}
+	}
+	addr, err := l.readField()
+	if err != nil {
+		return nil, err
+	}
+	if addr != "" {
+		c.address = &mAddress{addr: addr}
+		if parts := strings.Split(addr, "/"); len(parts) > 1 && !HZKnown.connectionTTLNotParsed {
+			l.shape("sdp/9")
+			c.address.addr = parts[0]
+			ttl, err := strconv.Atoi(parts[1])
+			if err != nil {
+				return nil, &mErr{eValue}
+			}
+			c.address.ttl = &ttl
+			if len(parts) > 2 {
+				rng, err := strconv.Atoi(parts[2])
+				if err != nil {
+					return nil, &mErr{eValue}
+				}
+				c.address.rng = &rng
+			}
+		}
+	}
+	if err := l.nextLine(); err != nil {
+		return nil, err
+	}
+	return c, nil
+}
+
+func (l *mLexer) readAttr() (mAttr, error) {
+	v, err := l.readLine()
+	if err != nil {
+		return mAttr{}, err
+	}
+	if i := strings.IndexByte(v, ':'); i > 0 {
+		return mAttr{v[:i], v[i+1:]}, nil
+	}
+	return mAttr{key: v}, nil
+}
+
+func (l *mLexer) readOptLine(dst **string) error {
+	v, err := l.readLine()
+	if err != nil {
+		return err
+	}
+	*dst = &v
+	return nil
+}
+
+// --------------------------------------------------------------------------- model parse
+
+// mParse is the documented state machine: the states are those of unmarshal.go's table, with
+// the ends of input allowed only in states 9 and 11-16 (the table's exits); as recorded
+// (sdp/4) any state accepts the end of the input. It returns the description or the error
+// class, and the shapes of the recorded bugs the case has (see mLexer).
+func mParse(in string) (*mDesc, []string, error) { //nolint:gocyclo
+	l := &mLexer{in: in, d: &mDesc{}}
+	d := l.d
+	state := 1
+	var media *mMedia
+	for {
+		key, eof, err := l.readType()
+		if err != nil {
+			return nil, l.shapes, err
+		}
+		if eof {
+			if state <= 8 && !HZKnown.truncatedDocumentAccepted {
+				l.shape("sdp/4")
+				return nil, l.shapes, &mErr{eSyntax}
+			}
+			return d, l.shapes, nil
+		}
+		next := 0
+		allowed := func(keys string, nexts ...int) bool {
+			i := strings.IndexByte(keys, key)
+			if i < 0 {
+				return false
+			}
+			next = nexts[i]
+			return true
+		}
+		ok := false
+		switch state {
+		case 1:
+			ok = allowed("v", 2)
+		case 2:
+			ok = allowed("o", 3)
+		case 3:
+			ok = allowed("s", 4)
+		case 4:
+			ok = allowed("iuepcbt", 7, 10, 6, 8, 5, 5, 9)
+		case 5:
+			ok = allowed("bt", 5, 9)
+		case 6:
+			ok = allowed("pcbt", 8, 5, 5, 9)
+		case 7:
+			ok = allowed("uepcbt", 10, 6, 8, 5, 5, 9)
+		case 8:
+			ok = allowed("cbt", 5, 5, 9)
+		case 9:
+			ok = allowed("zkartm", 13, 11, 11, 9, 9, 12)
+		case 10:
+			ok = allowed("epcbt", 6, 8, 5, 5, 9)
+		case 11:
+			ok = allowed("am", 11, 12)
+		case 12:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 13:
+			ok = allowed("akm", 11, 11, 12)
+		case 14:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 15:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 16:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		}
+		if !ok {
+			return nil, l.shapes, &mErr{eSyntax}
+		}
+		inMedia := state >= 12 && state != 13
+		switch key {
+		case 'v':
+			if d.version, err = l.readUint(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.version != 0 {
+				return nil, l.shapes, &mErr{eValue}
+			}
+			err = l.nextLine()
+		case 'o':
+			if d.username, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.sessID, err = l.readUint(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.sessVer, err = l.readUint(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.net, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.net != "IN" {
+				return nil, l.shapes, &mErr{eValue}
+			}
+			if d.addrType, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if d.addrType == "" {
+				// The package's documented leniency: a missing address type and address
+				// default to IP4 0.0.0.0.
+				d.addrType, d.unicast = "IP4", "0.0.0.0"
+			} else {
+				if !anyOf(d.addrType, "IP4", "IP6") {
+					return nil, l.shapes, &mErr{eValue}
+				}
+				if d.unicast, err = l.readField(); err != nil {
+					return nil, l.shapes, err
+				}
+				if d.unicast == "" {
+					d.unicast = "0.0.0.0"
+					if d.addrType == "IP6" {
+						d.unicast = "::"
+					}
+				}
+			}
+			err = l.nextLine()
+		case 's':
+			d.name, err = l.readLine()
+		case 'i':
+			if inMedia {
+				err = l.readOptLine(&media.title)
+			} else {
+				err = l.readOptLine(&d.info)
+			}
+		case 'u':
+			var v string
+			if v, err = l.readLine(); err == nil {
+				u, uerr := url.Parse(v)
+				if uerr != nil {
+					return nil, l.shapes, &mErr{eURL}
+				}
+				s := u.String()
+				d.uri = &s
+			}
+		case 'e':
+			err = l.readOptLine(&d.email)
+		case 'p':
+			err = l.readOptLine(&d.phone)
+		case 'c':
+			var c *mConn
+			if c, err = l.readConn(); err == nil {
+				if inMedia {
+					media.conn = c
+				} else {
+					d.conn = c
+				}
+			}
+		case 'b':
+			var v string
+			if v, err = l.readLine(); err == nil {
+				b, ok := mParseBandwidth(v)
+				if !ok {
+					// The package reports a bad media bandwidth as "invalid syntax" and a bad
+					// session one as "invalid value".
+					if inMedia {
+						return nil, l.shapes, &mErr{eInvalid}
+					}
+					return nil, l.shapes, &mErr{eValue}
+				}
+				if inMedia {
+					media.bw = append(media.bw, *b)
+				} else {
+					d.bw = append(d.bw, *b)
+				}
+			}
+		case 't':
+			var td mTimeDesc
+			if td.start, err = l.readUint(); err != nil {
+				return nil, l.shapes, err
+			}
+			if td.stop, err = l.readUint(); err != nil {
+				return nil, l.shapes, err
+			}
+			if err = l.nextLine(); err == nil {
+				d.times = append(d.times, td)
+			}
+		case 'r':
+			var r mRepeat
+			var f string
+			if f, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if r.interval, err = mParseTimeUnits(f); err != nil {
+				return nil, l.shapes, err
+			}
+			if f, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if r.duration, err = mParseTimeUnits(f); err != nil {
+				return nil, l.shapes, err
+			}
+			for {
+				if f, err = l.readField(); err != nil {
+					return nil, l.shapes, err
+				}
+				if f == "" {
+					break
+				}
+				var off int64
+				if off, err = mParseTimeUnits(f); err != nil {
+					return nil, l.shapes, err
+				}
+				r.offsets = append(r.offsets, off)
+			}
+			if err = l.nextLine(); err == nil {
+				td := &d.times[len(d.times)-1]
+				td.repeats = append(td.repeats, r)
+			}
+		case 'z':
+			// Documented: pairs of <adjustment time> <offset>, at least one; as recorded (sdp/8)
+			// z= with nothing after it passes as no zones, and a trailing unpaired time is
+			// dropped.
+			if l.atLineBreak() && !HZKnown.timeZoneOddDropped {
+				l.shape("sdp/8")
+				return nil, l.shapes, &mErr{eSyntax}
+			}
+			for {
+				var z mZone
+				if z.adj, err = l.readUint(); err != nil {
+					return nil, l.shapes, err
+				}
+				var f string
+				if f, err = l.readField(); err != nil {
+					return nil, l.shapes, err
+				}
+				if f == "" {
+					if !HZKnown.timeZoneOddDropped && (l.lastFieldEmpty() || len(d.zones) == 0) {
+						l.shape("sdp/8")
+						return nil, l.shapes, &mErr{eSyntax}
+					}
+					break
+				}
+				if z.offset, err = mParseTimeUnits(f); err != nil {
+					return nil, l.shapes, err
+				}
+				d.zones = append(d.zones, z)
+			}
+			err = l.nextLine()
+		case 'k':
+			if inMedia {
+				err = l.readOptLine(&media.key)
+			} else {
+				err = l.readOptLine(&d.key)
+			}
+		case 'a':
+			var a mAttr
+			if a, err = l.readAttr(); err == nil {
+				if inMedia {
+					media.attrs = append(media.attrs, a)
+				} else {
+					d.attrs = append(d.attrs, a)
+				}
+			}
+		case 'm':
+			m := &mMedia{}
+			var f string
+			if f, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			if !anyOf(f, "audio", "video", "text", "application", "message") {
+				return nil, l.shapes, &mErr{eValue}
+			}
+			m.media = f
+			if f, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			// Documented (RFC 4566 5.14): <port>/<number of ports>; as recorded (sdp/10) a
+			// third part is ignored.
+			parts := strings.Split(f, "/")
+			port, perr := strconv.Atoi(parts[0])
+			if perr != nil || port < 0 || port > 65535 {
+				return nil, l.shapes, &mErr{ePort}
+			}
+			m.port = port
+			if len(parts) > 1 {
+				rng, rerr := strconv.Atoi(parts[1])
+				if rerr != nil {
+					return nil, l.shapes, &mErr{eValue}
+				}
+				m.rng = &rng
+			}
+			if len(parts) > 2 && !HZKnown.portRangeTailIgnored {
+				l.shape("sdp/10")
+				return nil, l.shapes, &mErr{eValue}
+			}
+			if f, err = l.readField(); err != nil {
+				return nil, l.shapes, err
+			}
+			// Documented: an unknown token is an invalid value, as for every other token; as
+			// recorded (sdp/11) an unknown protocol is an invalid numeric value.
+			for _, p := range strings.Split(f, "/") {
+				if !anyOf(p, "UDP", "RTP", "AVP", "SAVP", "SAVPF", "TLS", "DTLS", "SCTP", "AVPF", "TCP", "MSRP", "BFCP", "UDT", "IX", "MRCPv2", "FEC") {
+					if HZKnown.protoErrorIsNumeric {
+						return nil, l.shapes, &mErr{eNumeric}
+					}
+					l.shape("sdp/11")
+					return nil, l.shapes, &mErr{eValue}
+				}
+				m.protos = append(m.protos, p)
+			}
+			for {
+				if f, err = l.readField(); err != nil {
+					return nil, l.shapes, err
+				}
+				if f == "" {
+					break
+				}
+				m.formats = append(m.formats, f)
+			}
+			if err = l.nextLine(); err == nil {
+				d.media = append(d.media, m)
+				media = m
+			}
+		}
+		if err != nil {
+			return nil, l.shapes, err
+		}
+		state = next
+	}
+}
+
+// lastFieldEmpty reports whether the z= line ended right after an adjustment time (an unpaired
+// value) rather than being empty: the model checks it through the scanned text.
+func (l *mLexer) lastFieldEmpty() bool {
+	// Walk back over line breaks and whitespace to the previous byte: a digit means an
+	// adjustment time was read without an offset.
+	i := l.pos - 1
+	for i >= 0 && (isWS(l.in[i]) || isNL(l.in[i])) {
+		i--
+	}
+	return i >= 0 && isDigit(l.in[i]) && !(i >= 1 && l.in[i-1] == '=')
+}
+
+// --------------------------------------------------------------------------- generation
+
+// A line is drawn as a record: its type, its fields, the separator tape its fields are joined
+// with (read modulo its length, a space when it is empty) and the name of the malformed
+// variant it carries ("" for a well-formed line). text renders it. In every choice the
+// well-formed line comes first and each malformed variant is a named alternative, so a shrunk
+// failure reads as a line and its defect.
+type line struct {
+	key    byte
+	fields []string
+	seps   []string
+	bad    string
+}
+
+func (l line) text() string {
+	var b strings.Builder
+	b.WriteByte(l.key)
+	b.WriteByte('=')
+	for i, f := range l.fields {
+		if i > 0 {
+			b.WriteString(tapeAt(l.seps, i-1, " "))
+		}
+		b.WriteString(f)
+	}
+	return b.String()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (l line) GoString() string {
+	if l.bad == "" {
+		return strconv.Quote(l.text())
+	}
+	return fmt.Sprintf("%s (%s)", strconv.Quote(l.text()), l.bad)
+}
+
+var (
+	hzSeps     = []string{" ", " ", " ", " ", "  ", "\t", " \t"}
+	hzText     = []string{"", "-", "Session", "a b", "a:b", ":b", "k:", "a=b", "x  y", "caf\xc3\xa9", "a\rb", " lead", "trail ", "\t"}
+	hzCRText   = []string{"a\rb", "x\r", "\r"}
+	hzBWTypes  = []string{"AS", "CT", "TIAS", "RS", "RR", "X-foo", "X-", "ZZ", "as", ""}
+	hzBWNums   = []string{"5", "0", "128000", "-5", "+5", "x", "", "5:6"}
+	hzAttrs    = []string{"recvonly", "rtpmap:96 H264/90000", "fmtp:96 a=1;b=2", "mid:0", "k:", ":x", "", "a:b:c", "x y", "extmap:1 urn:x"}
+	hzGoodNums = []string{"0", "0", "1", "2", "42", "3600", "18446744073709551615", "01"}
+	hzBadNums  = []string{"18446744073709551615", "99999999999999999999", "-1", "+1", "1x", "", "1.5"}
+	hzGoodUnit = []string{"1d", "-1h", "25h", "0", "5", "1m", "7s", "+3m", "-5"}
+	hzBadUnit  = []string{"2D", "x", "1dd", "-", "d", ""}
+	hzGoodURLs = []string{"http://example.com/x", "HTTP://Example.com/a b", "urn:x", "a:b", "http://x/?q=1#f"}
+	hzBadURLs  = []string{"http://[::1", "", "http://x/%zz", ":x"}
+)
+
+var (
+	sepTape  = hegel.Lists(hegel.SampledFrom(hzSeps)).MaxSize(3)
+	goodNum  = hegel.SampledFrom(hzGoodNums)
+	badNum   = hegel.SampledFrom(hzBadNums)
+	goodUnit = hegel.SampledFrom(hzGoodUnit)
+	badUnit  = hegel.SampledFrom(hzBadUnit)
+	texts    = hegel.SampledFrom(hzText)
+	crTexts  = hegel.SampledFrom(hzCRText)
+	noFields = hegel.Just[[]string](nil)
+)
+
+// fieldLine is a line of key whose fields are drawn by fs, with a separator tape; bad names
+// the malformed variant it is.
+func fieldLine(key byte, bad string, fs hegel.Generator[[]string]) hegel.Generator[line] {
+	return hegel.Composite(func(tc hegel.TestCase) line {
+		return line{key: key, fields: hegel.Draw(tc, fs), seps: hegel.Draw(tc, sepTape), bad: bad}
+	})
+}
+
+// textLine is a line of key whose value is one text (the types read up to the line end).
+func textLine(key byte, bad string, text hegel.Generator[string]) hegel.Generator[line] {
+	return hegel.Map(text, func(s string) line { return line{key: key, fields: []string{s}, bad: bad} })
+}
+
+// at draws fs and puts a value of g at index i, taken modulo the length.
+func at(fs hegel.Generator[[]string], i int, g hegel.Generator[string]) hegel.Generator[[]string] {
+	return hegel.Composite(func(tc hegel.TestCase) []string {
+		out := hegel.Draw(tc, fs)
+		out[i%len(out)] = hegel.Draw(tc, g)
+		return out
+	})
+}
+
+// atOneOf draws fs and puts a value of g at one of the indices.
+func atOneOf(fs hegel.Generator[[]string], idxs []int, g hegel.Generator[string]) hegel.Generator[[]string] {
+	return hegel.FlatMap(hegel.SampledFrom(idxs), func(i int) hegel.Generator[[]string] { return at(fs, i, g) })
+}
+
+// plus draws fs and appends a value of g.
+func plus(fs hegel.Generator[[]string], g hegel.Generator[string]) hegel.Generator[[]string] {
+	return cat(fs, one(g))
+}
+
+// cut draws fs and keeps the first n fields, n taken modulo the length plus one.
+func cut(fs hegel.Generator[[]string], n hegel.Generator[int]) hegel.Generator[[]string] {
+	return hegel.Composite(func(tc hegel.TestCase) []string {
+		out := hegel.Draw(tc, fs)
+		return out[:hegel.Draw(tc, n)%(len(out)+1)]
+	})
+}
+
+// dropLast draws fs without its last field.
+func dropLast(fs hegel.Generator[[]string]) hegel.Generator[[]string] {
+	return hegel.Map(fs, func(out []string) []string { return out[:len(out)-1] })
+}
+
+// mostly is the well-formed line 92% of the time and one of the malformed variants
+// otherwise (the rate of the old generator's bad coin).
+func mostly(ok hegel.Generator[line], bad ...hegel.Generator[line]) hegel.Generator[line] {
+	return weighted(choice[line]{92, ok}, choice[line]{8, hegel.OneOf(bad...)})
+}
+
+// textLines is a text line of key: a text of the pool, or (3%, the old coin's 8% times 40%)
+// one with a carriage return inside, the shape of sdp/6.
+func textLines(key byte) hegel.Generator[line] {
+	return weighted(choice[line]{97, textLine(key, "", texts)}, choice[line]{3, textLine(key, "cr", crTexts)})
+}
+
+// The lines, one generator per type; the well-formed line first, then the malformed variants
+// at the old generator's rates (8% malformed, split evenly).
+var (
+	vOK   = fieldLine('v', "", fields(hegel.Just("0")))
+	vLine = mostly(vOK,
+		fieldLine('v', "version", fields(hegel.Just("1"))),
+		fieldLine('v', "empty", noFields),
+		fieldLine('v', "zeros", fields(hegel.Just("00"))),
+		fieldLine('v', "extra", fields(hegel.Just("0"), hegel.Just("x"))),
+		fieldLine('v', "extra-line", fields(hegel.Just("0"), hegel.Just("o=-"), hegel.Just("1"), hegel.Just("2"), hegel.Just("IN"), hegel.Just("IP4"), hegel.Just("1.2.3.4"))),
+	)
+
+	oUser     = hegel.SampledFrom([]string{"-", "jdoe", "a"})
+	addrTypes = hegel.SampledFrom([]string{"IP4", "IP6"})
+	oAddr     = hegel.SampledFrom([]string{"1.2.3.4", "::1", "host.example"})
+	oFields   = fields(oUser, goodNum, goodNum, hegel.Just("IN"), addrTypes, oAddr)
+	oOK       = fieldLine('o', "", oFields)
+	oLine     = mostly(oOK,
+		fieldLine('o', "number", atOneOf(oFields, []int{1, 2}, badNum)),
+		fieldLine('o', "short", cut(oFields, hegel.Integers(0, 5))),
+		fieldLine('o', "net", at(oFields, 3, hegel.SampledFrom([]string{"in", "X", ""}))),
+		fieldLine('o', "addr-type", at(oFields, 4, hegel.SampledFrom([]string{"IPX", "ip4", ""}))),
+		fieldLine('o', "no-user", at(oFields, 0, hegel.Just(""))),
+		fieldLine('o', "extra", plus(oFields, hegel.SampledFrom([]string{"extra", "s=x", "a=b"}))),
+		fieldLine('o', "no-addr", at(oFields, 5, hegel.Just(""))),
+	)
+
+	sLine = textLines('s')
+	iLine = textLines('i')
+	eLine = textLines('e')
+	pLine = textLines('p')
+	kLine = textLines('k')
+
+	uOK   = textLine('u', "", hegel.SampledFrom(hzGoodURLs))
+	uLine = weighted(choice[line]{92, uOK}, choice[line]{8, textLine('u', "malformed", hegel.SampledFrom(hzBadURLs))})
+
+	// cAddr includes the addresses with a TTL and a range (the shape of sdp/9).
+	cAddr   = hegel.SampledFrom([]string{"1.2.3.4", "224.2.1.1/127", "224.2.1.1/127/3", "::1", "host.example"})
+	cFields = weighted(
+		choice[[]string]{15, fields(hegel.Just("IN"), addrTypes)},
+		choice[[]string]{85, fields(hegel.Just("IN"), addrTypes, cAddr)},
+	)
+	cBad  = hegel.Map(hegel.SampledFrom([]string{"X IP4 1.2.3.4", "IN IPX 1.2.3.4", "IN", "", "IN IP4 1.2.3.4 x", "IN IP4 a/b", "in IP4 1.2.3.4"}), strings.Fields)
+	cOK   = fieldLine('c', "", cFields)
+	cLine = weighted(choice[line]{92, cOK}, choice[line]{8, fieldLine('c', "malformed", cBad)})
+
+	bType = hegel.SampledFrom([]string{"AS", "CT", "TIAS", "RS", "RR", "X-foo", "X-"})
+	bOK   = textLine('b', "", hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, bType) + ":" + hegel.Draw(tc, goodNum)
+	}))
+	bBad = textLine('b', "malformed", hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, hegel.SampledFrom(hzBWTypes)) + hegel.Draw(tc, hegel.SampledFrom([]string{":", ":", "", " "})) + hegel.Draw(tc, hegel.SampledFrom(hzBWNums))
+	}))
+	bLine = weighted(choice[line]{92, bOK}, choice[line]{8, bBad})
+
+	tFields = fields(goodNum, goodNum)
+	tOK     = fieldLine('t', "", tFields)
+	tLine   = mostly(tOK,
+		fieldLine('t', "number", atOneOf(tFields, []int{0, 1}, badNum)),
+		fieldLine('t', "empty", noFields),
+		fieldLine('t', "one", fields(goodNum)),
+		fieldLine('t', "extra", plus(tFields, hegel.SampledFrom([]string{"x", "a=b", "3", "r=1 2", "s=x"}))),
+		fieldLine('t', "trailing-space", plus(tFields, hegel.Just(""))),
+	)
+
+	rFields = cat(fields(goodUnit, goodUnit), hegel.Lists(goodUnit).MaxSize(2))
+	rOK     = fieldLine('r', "", rFields)
+	rLine   = weighted(
+		choice[line]{92, rOK},
+		choice[line]{5, fieldLine('r', "unit", atOneOf(rFields, []int{0, 1}, badUnit))},
+		choice[line]{3, fieldLine('r', "short", cut(rFields, hegel.Integers(0, 1)))},
+	)
+
+	zPair   = fields(goodNum, goodUnit)
+	zFields = hegel.Map(many(zPair, 1, 2), flatten[string])
+	zOK     = fieldLine('z', "", zFields)
+	zLine   = mostly(zOK,
+		fieldLine('z', "number", atOneOf(zFields, []int{0, 2}, badNum)),
+		fieldLine('z', "unit", atOneOf(zFields, []int{1, 3}, badUnit)),
+		fieldLine('z', "unpaired", dropLast(zFields)),
+		fieldLine('z', "empty", noFields),
+		fieldLine('z', "extra", plus(zFields, goodNum)),
+	)
+
+	aOK   = textLine('a', "", hegel.SampledFrom(hzAttrs))
+	aLine = weighted(
+		choice[line]{92, aOK},
+		choice[line]{5, textLine('a', "text", texts)},
+		choice[line]{3, textLine('a', "cr", crTexts)},
+	)
+
+	mMediaTypes = hegel.SampledFrom([]string{"audio", "video", "text", "application", "message"})
+	// mPort includes a port with a range and a third part (the shape of sdp/10).
+	mPort   = hegel.SampledFrom([]string{"9", "0", "65535", "9/2", "1234", "9/2/3"})
+	mProto  = hegel.SampledFrom([]string{"RTP/AVP", "UDP/TLS/RTP/SAVPF", "RTP/SAVPF", "TCP/DTLS/SCTP", "UDP"})
+	mFmt    = hegel.SampledFrom([]string{"0", "96", "97", "8", "webrtc-datachannel", "*"})
+	mHead   = fields(mMediaTypes, mPort, mProto)
+	mFields = cat(mHead, many(mFmt, 1, 3))
+	mOK     = fieldLine('m', "", mFields)
+	mLine   = mostly(mOK,
+		fieldLine('m', "media", at(mFields, 0, hegel.SampledFrom([]string{"data", "Audio", ""}))),
+		fieldLine('m', "port", at(mFields, 1, hegel.SampledFrom([]string{"70000", "-1", "+9", "9/2/3", "9/-2", "9/x", "9/", "x", ""}))),
+		fieldLine('m', "proto", at(mFields, 2, hegel.SampledFrom([]string{"RTP/XX", "RTP//AVP", "udp", "RTP/AVP/", ""}))),
+		fieldLine('m', "no-formats", mHead),
+		fieldLine('m', "empty-format", plus(mFields, hegel.Just(""))),
+	)
+
+	// lineGens: the line of each type; the types the grammar does not know are text lines.
+	lineGens = func() map[byte]hegel.Generator[line] {
+		m := map[byte]hegel.Generator[line]{
+			'v': vLine, 'o': oLine, 's': sLine, 'i': iLine, 'u': uLine, 'e': eLine, 'p': pLine, 'c': cLine,
+			'b': bLine, 't': tLine, 'r': rLine, 'z': zLine, 'k': kLine, 'a': aLine, 'm': mLine,
+		}
+		for _, k := range []byte("xyz0=") {
+			if _, ok := m[k]; !ok {
+				m[k] = textLines(k)
+			}
+		}
+		return m
+	}()
+)
+
+// lineOf is the line generator of a type.
+func lineOf(key byte) hegel.Generator[line] { return lineGens[key] }
+
+// optLine is a line of g pct percent of the time, as a list of zero or one lines.
+func optLine(pct int, g hegel.Generator[line]) hegel.Generator[[]line] {
+	return maybe(pct, one(g))
+}
+
+// The document's lines in grammar order: the mandatory v o s, the optional session lines,
+// one time description (or 0-2 of them, 15%: none is the shape of sdp/4), and 88% of the time
+// a tail of z, k, attributes and media sections. A media section is m with optional i c b k
+// and attributes.
+var (
+	sessionHead = cat(one(vLine), one(oLine), one(sLine),
+		optLine(25, iLine), optLine(25, uLine), optLine(25, eLine), optLine(25, pLine), optLine(25, cLine),
+		maybe(25, many(bLine, 1, 2)))
+	timeDesc = cat(one(tLine), hegel.Lists(rLine).MaxSize(2))
+	// timeDescs: one time description, or (15%) none to two (Lists alone draws zero elements
+	// too rarely for the shape of sdp/4 to keep its old rate, so the count is drawn).
+	timeDescs = weighted(
+		choice[[]line]{85, timeDesc},
+		choice[[]line]{15, hegel.FlatMap(hegel.Integers(0, 2), func(n int) hegel.Generator[[]line] {
+			return hegel.Map(many(timeDesc, n, n), flatten[line])
+		})},
+	)
+	mediaSection = cat(one(mLine), optLine(25, iLine), optLine(25, cLine), optLine(25, bLine), optLine(25, kLine), hegel.Lists(aLine).MaxSize(3))
+	sessionTail  = cat(optLine(25, zLine), optLine(20, kLine), hegel.Lists(aLine).MaxSize(3),
+		hegel.Map(hegel.Lists(mediaSection).MaxSize(2), flatten[line]))
+	bodyLines = cat(sessionHead, timeDescs, weighted(choice[[]line]{12, hegel.Just[[]line](nil)}, choice[[]line]{88, sessionTail}))
+)
+
+// edit is one mutation of the rendered lines; at is taken modulo the live number of lines.
+type edit struct {
+	kind string // drop, repeat, swap, unknown, blank, no-equals, space, misplaced
+	at   int
+	line line // the line inserted by unknown and misplaced
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (e edit) GoString() string {
+	switch e.kind {
+	case "unknown", "misplaced":
+		return fmt.Sprintf("%s@%d %#v", e.kind, e.at, e.line)
+	}
+	return fmt.Sprintf("%s@%d", e.kind, e.at)
+}
+
+var position = hegel.Integers(0, 23)
+
+// plainEdit is an edit of kind at a position.
+func plainEdit(kind string) hegel.Generator[edit] {
+	return hegel.Map(position, func(i int) edit { return edit{kind: kind, at: i} })
+}
+
+// insertEdit inserts a line of one of the types after a position.
+func insertEdit(kind string, keys string) hegel.Generator[edit] {
+	return hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{kind: kind, at: hegel.Draw(tc, position), line: hegel.Draw(tc, hegel.FlatMap(hegel.SampledFrom([]byte(keys)), lineOf))}
+	})
+}
+
+var (
+	edits = hegel.OneOf(
+		plainEdit("drop"), plainEdit("repeat"), plainEdit("swap"), insertEdit("unknown", "xyz0=vostmarb"),
+		plainEdit("blank"), plainEdit("no-equals"), plainEdit("space"), insertEdit("misplaced", "icbkatzr"),
+	)
+	// editLists: no mutation 75% of the time, else one or two.
+	editLists = weighted(choice[[]edit]{75, hegel.Just[[]edit](nil)}, choice[[]edit]{25, many(edits, 1, 2)})
+)
+
+// mutate applies the edits to the rendered lines.
+func mutate(lines []string, edits []edit) []string {
+	out := append([]string(nil), lines...)
+	for _, e := range edits {
+		if len(out) == 0 {
+			break
+		}
+		i := e.at % len(out)
+		switch e.kind {
+		case "drop":
+			out = append(out[:i], out[i+1:]...)
+		case "repeat":
+			out = append(out[:i+1], out[i:]...)
+		case "swap":
+			if i+1 < len(out) {
+				out[i], out[i+1] = out[i+1], out[i]
+			}
+		case "unknown", "misplaced":
+			out = append(out[:i+1], append([]string{e.line.text()}, out[i+1:]...)...)
+		case "blank":
+			out = append(out[:i+1], append([]string{""}, out[i+1:]...)...)
+		case "no-equals":
+			out[i] = strings.Replace(out[i], "=", "", 1)
+		case "space":
+			out[i] = " " + out[i]
+		}
+	}
+	return out
+}
+
+// doc is a session description text: its lines in grammar order, the mutations applied to
+// them, a short final line ("" for none), the line-end tape (read modulo its length, CRLF
+// when it is empty) and whether the last line goes without its line break.
+type doc struct {
+	body  []line
+	edits []edit
+	last  string
+	ends  []string
+	open  bool
+}
+
+// lines renders and mutates the body and appends the final line.
+func (d doc) lines() []string {
+	rendered := make([]string, len(d.body))
+	for i, l := range d.body {
+		rendered[i] = l.text()
+	}
+	out := mutate(rendered, d.edits)
+	if d.last != "" {
+		out = append(out, d.last)
+	}
+	return out
+}
+
+func (d doc) text() string {
+	ls := d.lines()
+	var b strings.Builder
+	for i, l := range ls {
+		b.WriteString(l)
+		if i == len(ls)-1 && d.open {
+			break
+		}
+		b.WriteString(tapeAt(d.ends, i, "\r\n"))
+	}
+	return b.String()
+}
+
+// GoString is what the draw report prints (it uses %#v): the text, and the defects it was
+// given.
+func (d doc) GoString() string {
+	s := strconv.Quote(d.text())
+	var notes []string
+	for _, l := range d.body {
+		if l.bad != "" {
+			notes = append(notes, fmt.Sprintf("%c=%s", l.key, l.bad))
+		}
+	}
+	for _, e := range d.edits {
+		notes = append(notes, e.GoString())
+	}
+	if len(notes) > 0 {
+		s += " [" + strings.Join(notes, " ") + "]"
+	}
+	return s
+}
+
+var (
+	lineEnds = weighted(choice[string]{85, hegel.Just("\r\n")}, choice[string]{10, hegel.Just("\n")}, choice[string]{5, hegel.Just("\r\r\n")})
+	// lastLines: a short final line 6% of the time: a lone byte (the shape of sdp/5), a line
+	// without a value, a numeric line ending in 0 (sdp/3 when the break is missing).
+	lastLines = maybe(6, hegel.SampledFrom([]string{"m", "a", "x", "=", "a=", "t=1 0", "t=0 0", "z=1 0", "v=0"}))
+	docs      = hegel.Composite(func(tc hegel.TestCase) doc {
+		return doc{
+			body:  hegel.Draw(tc, bodyLines),
+			edits: hegel.Draw(tc, editLists),
+			last:  hegel.Draw(tc, lastLines),
+			ends:  hegel.Draw(tc, hegel.Lists(lineEnds).MaxSize(4)),
+			open:  hegel.Draw(tc, chance(30)),
+		}
+	})
+)
+
+// --------------------------------------------------------------------------- the property
+
+// judgeUnmarshal parses text with UnmarshalString and with the model and compares the error
+// class, or every field of the description; a disagreement names the shapes of the recorded
+// bugs the model met in the case. Unmarshal must agree with UnmarshalString.
+func judgeUnmarshal(ht *hegel.T, col *hzCollector, text string) {
+	var sd sdp.SessionDescription
+	var err error
+	if r := hzCatch(func() { err = sd.UnmarshalString(text) }); r != nil {
+		col.failClass(ht, "panic", "UnmarshalString(%q) panicked: %v", text, r)
+		return
+	}
+	want, shapes, werr := mParse(text)
+	for _, id := range shapes {
+		col.count("shape " + id)
+	}
+	if err != nil || werr != nil {
+		got, wantClass := "", ""
+		if err != nil {
+			got = hzErrClass(err)
+		}
+		if werr != nil {
+			wantClass = werr.Error()
+		}
+		if got != wantClass {
+			col.mismatch(ht, "error", shapes, "UnmarshalString(%q):\n  got:  %q (%v)\n  want: %q", text, got, err, wantClass)
+			return
+		}
+		col.count("err " + got)
+		return
+	}
+	col.count("ok")
+	if g, w := hzFmtDesc(&sd), want.format(); g != w {
+		col.mismatch(ht, "fields", shapes, "UnmarshalString(%q):\n  got:\n%s\n  want:\n%s", text, g, w)
+		return
+	}
+	// Unmarshal is documented as UnmarshalString over the bytes.
+	var sd2 sdp.SessionDescription
+	if err := sd2.Unmarshal([]byte(text)); err != nil || hzFmtDesc(&sd2) != hzFmtDesc(&sd) {
+		col.failClass(ht, "bytes", "Unmarshal(%q) differs from UnmarshalString: %v", text, err)
+	}
+}
+
+func TestHegelUnmarshal(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, docs)
+		judgeUnmarshal(ht, col, d.text())
+	})
+}
