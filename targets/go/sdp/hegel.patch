+}
+
+// --------------------------------------------------------------------------- model lexer
+
+// The error classes compared: the package's sentinel errors and the two others it returns.
+const (
+	eSyntax  = "syntax error"
+	eEOF     = "EOF"
+	eValue   = "invalid value"
+	eNumeric = "invalid numeric value"
+	ePort    = "invalid port value"
+	eURL     = "url"
+	eInvalid = "invalid syntax"
+)
+
+type mErr struct{ class string }
+
+func (e *mErr) Error() string { return e.class }
+
+func hzErrClass(err error) string {
+	s := err.Error()
+	switch {
+	case strings.HasPrefix(s, "sdp: syntax error"):
+		return eSyntax
+	case s == "EOF":
+		return eEOF
+	case strings.HasPrefix(s, "sdp: invalid numeric value"):
+		return eNumeric
+	case strings.HasPrefix(s, "sdp: invalid port value"):
+		return ePort
+	case strings.HasPrefix(s, "sdp: invalid value"):
+		return eValue
+	case strings.HasPrefix(s, "sdp: invalid syntax"):
+		return eInvalid
+	case strings.HasPrefix(s, "parse "):
+		return eURL
+	}
+	return "other: " + s
+}
+
+type mLexer struct {
+	in  string
+	pos int
+	d   *mDesc
+}
+
+func isNL(c byte) bool { return c == '\n' || c == '\r' }
+func isWS(c byte) bool { return c == ' ' || c == '\t' }
+
+// readType: skips line breaks, reads "<type>=". At the end of the input: (0, eof). As recorded
+// (sdp/5) a lone final byte is also the end.
+func (l *mLexer) readType() (byte, bool, error) {
+	for l.pos < len(l.in) && isNL(l.in[l.pos]) {
+		l.pos++
+	}
+	if l.pos >= len(l.in) {
+		return 0, true, nil
+	}
+	if l.pos+1 >= len(l.in) {
+		if HZKnown.danglingByteIgnored {
+			return 0, true, nil
+		}
+		return 0, false, &mErr{eEOF}
+	}
+	key := l.in[l.pos]
+	if l.in[l.pos+1] != '=' {
+		l.pos += 2
+		return key, false, &mErr{eSyntax}
+	}
+	l.pos += 2
+	return key, false, nil
+}
+
+// readField: a run of bytes up to whitespace, a line break or the end; consumes the
+// whitespace after it. Empty at a line break; at the end of the input an empty field is an
+// EOF error.
+func (l *mLexer) readField() (string, error) {
+	start := l.pos
+	for l.pos < len(l.in) && !isNL(l.in[l.pos]) && !isWS(l.in[l.pos]) {
+		l.pos++
+	}
+	stop := l.pos
+	if l.pos >= len(l.in) && stop == start {
+		return "", &mErr{eEOF}
+	}
+	for l.pos < len(l.in) && isWS(l.in[l.pos]) {
+		l.pos++
+	}
+	return l.in[start:stop], nil
+}
+
+// readUint: a decimal field. Documented: the digits of a uint64 (RFC 4566: numeric fields are
+// decimal); as recorded (sdp/1) an overflow wraps, (sdp/2) an empty field is zero, (sdp/3) a
+// zero as the last token of the input is an EOF error.
+func (l *mLexer) readUint() (uint64, error) {
+	start := l.pos
+	var v uint64
+	digits := 0
+	for l.pos < len(l.in) {
+		c := l.in[l.pos]
+		if isNL(c) {
+			break
+		}
+		if isWS(c) {
+			for l.pos < len(l.in) && isWS(l.in[l.pos]) {
+				l.pos++
+			}
+			break
+		}
+		if c < '0' || c > '9' {
+			l.pos++
+			return 0, &mErr{eSyntax}
+		}
+		l.pos++
+		digits++
+		if v > (math.MaxUint64-uint64(c-'0'))/10 && !HZKnown.uintWraps {
+			return 0, &mErr{eNumeric}
+		}
+		v = v*10 + uint64(c-'0')
+	}
+	if l.pos >= len(l.in) && start < len(l.in) && l.in[len(l.in)-1] >= '0' && l.in[len(l.in)-1] <= '9' {
+		// The field ran into the end of the input.
+		if v == 0 && HZKnown.zeroAtEOFFails {
+			return 0, &mErr{eEOF}
+		}
+	} else if l.pos >= len(l.in) && digits == 0 {
+		return 0, &mErr{eEOF}
+	}
+	if digits == 0 && !HZKnown.missingNumericIsZero {
+		return 0, &mErr{eSyntax}
+	}
+	return v, nil
+}
+
+// readLine: the rest of the line up to LF, without a CR before the LF. Documented: lines end
+// in CRLF (or LF); as recorded (sdp/6) every CR in the line counts as trailing and cuts the
+// same number of bytes from the end.
+func (l *mLexer) readLine() (string, error) {
+	start := l.pos
+	crs := 0
+	for l.pos < len(l.in) {
+		c := l.in[l.pos]
+		l.pos++
+		if c == '\r' {
+			crs++
+		}
+		if c == '\n' {
+			line := l.in[start : l.pos-1]
+			if HZKnown.crCountTrimsLine {
+				return l.in[start : l.pos-1-crs], nil
+			}
+			return strings.TrimRight(line, "\r"), nil
+		}
+	}
+	return "", &mErr{eEOF}
+}
+
+// nextLine: skips line breaks; anything else stays for the next line (so extra fields on a
+// field-based line are read as a line of their own, sdp/7 as recorded; documented, they are an
+// error).
+func (l *mLexer) nextLine() error {
+	if l.pos < len(l.in) && !isNL(l.in[l.pos]) && !HZKnown.extraFieldStartsLine {
+		return &mErr{eSyntax}
+	}
+	for l.pos < len(l.in) && isNL(l.in[l.pos]) {
+		l.pos++
+	}
+	return nil
+}
+
+func mParseTimeUnits(s string) (int64, error) {
+	if s == "" {
+		return 0, &mErr{eValue}
+	}
+	k := int64(1)
+	switch s[len(s)-1] {
+	case 'd':
+		k = 86400
+	case 'h':
+		k = 3600
+	case 'm':
+		k = 60
+	case 's':
+		k = 1
+	default:
+		k = 0
+	}
+	num := s
+	if k > 0 {
+		num = s[:len(s)-1]
+	} else {
+		k = 1
+	}
+	n, err := strconv.ParseInt(num, 10, 64)
+	if err != nil {
+		return 0, &mErr{eValue}
+	}
+	return n * k, nil
+}
+
+func mParseBandwidth(s string) (*mBandwidth, bool) {
+	parts := strings.Split(s, ":")
+	if len(parts) != 2 {
+		return nil, false
+	}
+	b := &mBandwidth{}
+	if strings.HasPrefix(parts[0], "X-") {
+		b.experimental = true
+		b.typ = parts[0][2:]
+	} else if !anyOf(parts[0], "CT", "AS", "TIAS", "RS", "RR") {
+		return nil, false
+	} else {
+		b.typ = parts[0]
+	}
+	n, err := strconv.ParseUint(parts[1], 10, 64)
+	if err != nil {
+		return nil, false
+	}
+	b.bw = n
+	return b, true
+}
+
+func anyOf(s string, xs ...string) bool {
+	for _, x := range xs {
+		if s == x {
+			return true
+		}
+	}
+	return false
+}
+
+func (l *mLexer) readConn() (*mConn, error) {
+	c := &mConn{}
+	var err error
+	if c.net, err = l.readField(); err != nil {
+		return nil, err
+	}
+	if c.net != "IN" {
+		return nil, &mErr{eValue}
+	}
+	if c.addrType, err = l.readField(); err != nil {
+		return nil, err
+	}
+	if !anyOf(c.addrType, "IP4", "IP6") {
+		return nil, &mErr{eValue}
+	}
+	addr, err := l.readField()
+	if err != nil {
+		return nil, err
+	}
+	if addr != "" {
+		c.address = &mAddress{addr: addr}
+		if !HZKnown.connectionTTLNotParsed {
+			// Documented: <base multicast address>[/<ttl>]/<number of addresses>.
+			parts := strings.Split(addr, "/")
+			if len(parts) > 1 {
+				c.address.addr = parts[0]
+				ttl, err := strconv.Atoi(parts[1])
+				if err != nil {
+					return nil, &mErr{eValue}
+				}
+				c.address.ttl = &ttl
+				if len(parts) > 2 {
+					rng, err := strconv.Atoi(parts[2])
+					if err != nil {
+						return nil, &mErr{eValue}
+					}
+					c.address.rng = &rng
+				}
+			}
+		}
+	}
+	if err := l.nextLine(); err != nil {
+		return nil, err
+	}
+	return c, nil
+}
+
+func (l *mLexer) readAttr() (mAttr, error) {
+	v, err := l.readLine()
+	if err != nil {
+		return mAttr{}, err
+	}
+	if i := strings.IndexByte(v, ':'); i > 0 {
+		return mAttr{v[:i], v[i+1:]}, nil
+	}
+	return mAttr{key: v}, nil
+}
+
+func (l *mLexer) readOptLine(dst **string) error {
+	v, err := l.readLine()
+	if err != nil {
+		return err
+	}
+	*dst = &v
+	return nil
+}
+
+// --------------------------------------------------------------------------- model parse
+
+// mParse is the documented state machine: the states are those of unmarshal.go's table, with
+// the ends of input allowed only in states 9 and 11-16 (the table's exits); as recorded
+// (sdp/4) any state accepts the end of the input.
+func mParse(in string) (*mDesc, error) {
+	l := &mLexer{in: in, d: &mDesc{}}
+	d := l.d
+	state := 1
+	var media *mMedia
+	for {
+		key, eof, err := l.readType()
+		if err != nil {
+			return nil, err
+		}
+		if eof {
+			if state <= 8 && !HZKnown.truncatedDocumentAccepted {
+				return nil, &mErr{eSyntax}
+			}
+			return d, nil
+		}
+		next := 0
+		allowed := func(keys string, nexts ...int) bool {
+			i := strings.IndexByte(keys, key)
+			if i < 0 {
+				return false
+			}
+			next = nexts[i]
+			return true
+		}
+		ok := false
+		switch state {
+		case 1:
+			ok = allowed("v", 2)
+		case 2:
+			ok = allowed("o", 3)
+		case 3:
+			ok = allowed("s", 4)
+		case 4:
+			ok = allowed("iuepcbt", 7, 10, 6, 8, 5, 5, 9)
+		case 5:
+			ok = allowed("bt", 5, 9)
+		case 6:
+			ok = allowed("pcbt", 8, 5, 5, 9)
+		case 7:
+			ok = allowed("uepcbt", 10, 6, 8, 5, 5, 9)
+		case 8:
+			ok = allowed("cbt", 5, 5, 9)
+		case 9:
+			ok = allowed("zkartm", 13, 11, 11, 9, 9, 12)
+		case 10:
+			ok = allowed("epcbt", 6, 8, 5, 5, 9)
+		case 11:
+			ok = allowed("am", 11, 12)
+		case 12:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 13:
+			ok = allowed("akm", 11, 11, 12)
+		case 14:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 15:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		case 16:
+			ok = allowed("akbcim", 14, 14, 15, 15, 16, 12)
+		}
+		if !ok {
+			return nil, &mErr{eSyntax}
+		}
+		inMedia := state >= 12 && state != 13
+		switch key {
+		case 'v':
+			if d.version, err = l.readUint(); err != nil {
+				return nil, err
+			}
+			if d.version != 0 {
+				return nil, &mErr{eValue}
+			}
+			err = l.nextLine()
+		case 'o':
+			if d.username, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if d.sessID, err = l.readUint(); err != nil {
+				return nil, err
+			}
+			if d.sessVer, err = l.readUint(); err != nil {
+				return nil, err
+			}
+			if d.net, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if d.net != "IN" {
+				return nil, &mErr{eValue}
+			}
+			if d.addrType, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if d.addrType == "" {
+				// The package's documented leniency: a missing address type and address
+				// default to IP4 0.0.0.0.
+				d.addrType, d.unicast = "IP4", "0.0.0.0"
+			} else {
+				if !anyOf(d.addrType, "IP4", "IP6") {
+					return nil, &mErr{eValue}
+				}
+				if d.unicast, err = l.readField(); err != nil {
+					return nil, err
+				}
+				if d.unicast == "" {
+					d.unicast = "0.0.0.0"
+					if d.addrType == "IP6" {
+						d.unicast = "::"
+					}
+				}
+			}
+			err = l.nextLine()
+		case 's':
+			d.name, err = l.readLine()
+		case 'i':
+			if inMedia {
+				err = l.readOptLine(&media.title)
+			} else {
+				err = l.readOptLine(&d.info)
+			}
+		case 'u':
+			var v string
+			if v, err = l.readLine(); err == nil {
+				u, uerr := url.Parse(v)
+				if uerr != nil {
+					return nil, &mErr{eURL}
+				}
+				s := u.String()
+				d.uri = &s
+			}
+		case 'e':
+			err = l.readOptLine(&d.email)
+		case 'p':
+			err = l.readOptLine(&d.phone)
+		case 'c':
+			var c *mConn
+			if c, err = l.readConn(); err == nil {
+				if inMedia {
+					media.conn = c
+				} else {
+					d.conn = c
+				}
+			}
+		case 'b':
+			var v string
+			if v, err = l.readLine(); err == nil {
+				b, ok := mParseBandwidth(v)
+				if !ok {
+					// The package reports a bad media bandwidth as "invalid syntax" and a bad
+					// session one as "invalid value".
+					if inMedia {
+						return nil, &mErr{eInvalid}
+					}
+					return nil, &mErr{eValue}
+				}
+				if inMedia {
+					media.bw = append(media.bw, *b)
+				} else {
+					d.bw = append(d.bw, *b)
+				}
+			}
+		case 't':
+			var td mTimeDesc
+			if td.start, err = l.readUint(); err != nil {
+				return nil, err
+			}
+			if td.stop, err = l.readUint(); err != nil {
+				return nil, err
+			}
+			if err = l.nextLine(); err == nil {
+				d.times = append(d.times, td)
+			}
+		case 'r':
+			var r mRepeat
+			var f string
+			if f, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if r.interval, err = mParseTimeUnits(f); err != nil {
+				return nil, err
+			}
+			if f, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if r.duration, err = mParseTimeUnits(f); err != nil {
+				return nil, err
+			}
+			for {
+				if f, err = l.readField(); err != nil {
+					return nil, err
+				}
+				if f == "" {
+					break
+				}
+				var off int64
+				if off, err = mParseTimeUnits(f); err != nil {
+					return nil, err
+				}
+				r.offsets = append(r.offsets, off)
+			}
+			if err = l.nextLine(); err == nil {
+				td := &d.times[len(d.times)-1]
+				td.repeats = append(td.repeats, r)
+			}
+		case 'z':
+			for {
+				var z mZone
+				if z.adj, err = l.readUint(); err != nil {
+					return nil, err
+				}
+				var f string
+				if f, err = l.readField(); err != nil {
+					return nil, err
+				}
+				if f == "" {
+					// Documented: pairs of <adjustment time> <offset>; as recorded (sdp/8) a
+					// trailing unpaired time, or none at all, passes.
+					if !HZKnown.timeZoneOddDropped && (l.lastFieldEmpty() || len(d.zones) == 0) {
+						return nil, &mErr{eSyntax}
+					}
+					break
+				}
+				if z.offset, err = mParseTimeUnits(f); err != nil {
+					return nil, err
+				}
+				d.zones = append(d.zones, z)
+			}
+			err = l.nextLine()
+		case 'k':
+			if inMedia {
+				err = l.readOptLine(&media.key)
+			} else {
+				err = l.readOptLine(&d.key)
+			}
+		case 'a':
+			var a mAttr
+			if a, err = l.readAttr(); err == nil {
+				if inMedia {
+					media.attrs = append(media.attrs, a)
+				} else {
+					d.attrs = append(d.attrs, a)
+				}
+			}
+		case 'm':
+			m := &mMedia{}
+			var f string
+			if f, err = l.readField(); err != nil {
+				return nil, err
+			}
+			if !anyOf(f, "audio", "video", "text", "application", "message") {
+				return nil, &mErr{eValue}
+			}
+			m.media = f
+			if f, err = l.readField(); err != nil {
+				return nil, err
+			}
+			parts := strings.Split(f, "/")
+			port, perr := strconv.Atoi(parts[0])
+			if perr != nil || port < 0 || port > 65535 {
+				return nil, &mErr{ePort}
+			}
+			m.port = port
+			if len(parts) > 1 {
+				rng, rerr := strconv.Atoi(parts[1])
+				if rerr != nil {
+					return nil, &mErr{eValue}
+				}
+				m.rng = &rng
+			}
+			if len(parts) > 2 && !HZKnown.portRangeTailIgnored {
+				return nil, &mErr{eValue}
+			}
+			if f, err = l.readField(); err != nil {
+				return nil, err
+			}
+			for _, p := range strings.Split(f, "/") {
+				if !anyOf(p, "UDP", "RTP", "AVP", "SAVP", "SAVPF", "TLS", "DTLS", "SCTP", "AVPF", "TCP", "MSRP", "BFCP", "UDT", "IX", "MRCPv2", "FEC") {
+					if HZKnown.protoErrorIsNumeric {
+						return nil, &mErr{eNumeric}
+					}
+					return nil, &mErr{eValue}
+				}
+				m.protos = append(m.protos, p)
+			}
+			for {
+				if f, err = l.readField(); err != nil {
+					return nil, err
+				}
+				if f == "" {
+					break
+				}
+				m.formats = append(m.formats, f)
+			}
+			if err = l.nextLine(); err == nil {
+				d.media = append(d.media, m)
+				media = m
+			}
+		}
+		if err != nil {
+			return nil, err
+		}
+		state = next
+	}
+}
+
+// lastFieldEmpty reports whether the z= line ended right after an adjustment time (an unpaired
+// value) rather than being empty: the model checks it through the scanned text.
+func (l *mLexer) lastFieldEmpty() bool {
+	// Walk back over line breaks and whitespace to the previous byte: a digit means an
+	// adjustment time was read without an offset.
+	i := l.pos - 1
+	for i >= 0 && (isWS(l.in[i]) || isNL(l.in[i])) {
+		i--
+	}
+	return i >= 0 && l.in[i] >= '0' && l.in[i] <= '9' && !(i >= 1 && l.in[i-1] == '=')
+}
+
+// --------------------------------------------------------------------------- generation
+
+var (
+	hzSeps    = []string{" ", " ", " ", " ", "  ", "\t", " \t"}
+	hzText    = []string{"", "-", "Session", "a b", "a:b", ":b", "k:", "a=b", "x  y", "caf\xc3\xa9", "a\rb", " lead", "trail ", "\t"}
+	hzBWTypes = []string{"AS", "CT", "TIAS", "RS", "RR", "X-foo", "X-", "ZZ", "as", ""}
+	hzBWNums  = []string{"5", "0", "128000", "-5", "+5", "x", "", "5:6"}
+	hzAttrs   = []string{"recvonly", "rtpmap:96 H264/90000", "fmtp:96 a=1;b=2", "mid:0", "k:", ":x", "", "a:b:c", "x y", "extmap:1 urn:x"}
+)
+
+// hzGenLine emits one line of the given type: valid content most of the time, otherwise one
+// field replaced by a malformed or out-of-range one.
+func hzGenLine(tc hegel.TestCase, key byte) string {
+	sep := func() string { return hzPick(tc, hzSeps) }
+	bad := hzChance(tc, 8)
+	num := func() string {
+		if bad && hzChance(tc, 50) {
+			return hzPick(tc, []string{"18446744073709551615", "99999999999999999999", "-1", "+1", "1x", "", "1.5"})
+		}
+		return hzPick(tc, []string{"0", "0", "1", "2", "42", "3600", "18446744073709551615", "01"})
+	}
+	unit := func() string {
+		if bad && hzChance(tc, 50) {
+			return hzPick(tc, []string{"2D", "x", "1dd", "-", "d", ""})
+		}
+		return hzPick(tc, []string{"1d", "-1h", "25h", "0", "5", "1m", "7s", "+3m", "-5"})
+	}
+	text := func() string {
+		if bad && hzChance(tc, 40) {
+			return hzPick(tc, []string{"a\rb", "x\r", "\r"})
+		}
+		return hzPick(tc, hzText)
+	}
+	var v string
+	switch key {
+	case 'v':
+		v = "0"
+		if bad {
+			v = hzPick(tc, []string{"1", "", "00", "0 x", "0 o=- 1 2 IN IP4 1.2.3.4"})
+		}
+	case 'o':
+		fields := []string{hzPick(tc, []string{"-", "jdoe", "a"}), num(), num(), "IN", hzPick(tc, []string{"IP4", "IP6"}),
+			hzPick(tc, []string{"1.2.3.4", "::1", "host.example"})}
+		if bad {
+			switch hzDrawInt(tc, 1, 6) {
+			case 1:
+				fields = fields[:hzDrawInt(tc, 0, 5)]
+			case 2:
+				fields[3] = hzPick(tc, []string{"in", "X", ""})
+			case 3:
+				fields[4] = hzPick(tc, []string{"IPX", "ip4", ""})
+			case 4:
+				fields[0] = ""
+			case 5:
+				fields = append(fields, hzPick(tc, []string{"extra", "s=x", "a=b"}))
+			case 6:
+				fields[5] = ""
+			}
+		}
+		v = strings.Join(fields, sep())
+	case 's', 'i', 'e', 'p', 'k':
+		v = text()
+	case 'u':
+		v = hzPick(tc, []string{"http://example.com/x", "HTTP://Example.com/a b", "urn:x", "a:b", "http://x/?q=1#f"})
+		if bad {
+			v = hzPick(tc, []string{"http://[::1", "", "http://x/%zz", ":x"})
+		}
+	case 'c':
+		v = "IN" + sep() + hzPick(tc, []string{"IP4", "IP6"})
+		if hzChance(tc, 85) {
+			v += sep() + hzPick(tc, []string{"1.2.3.4", "224.2.1.1/127", "224.2.1.1/127/3", "::1", "host.example"})
+		}
+		if bad {
+			v = hzPick(tc, []string{"X IP4 1.2.3.4", "IN IPX 1.2.3.4", "IN", "", "IN IP4 1.2.3.4 x", "IN IP4 a/b", "in IP4 1.2.3.4"})
+		}
+	case 'b':
+		v = hzPick(tc, []string{"AS", "CT", "TIAS", "RS", "RR", "X-foo", "X-"}) + ":" + num()
+		if bad {
+			v = hzPick(tc, hzBWTypes) + hzPick(tc, []string{":", ":", "", " "}) + hzPick(tc, hzBWNums)
+		}
+	case 't':
+		v = num() + sep() + num()
+		if bad {
+			switch hzDrawInt(tc, 1, 4) {
+			case 1:
+				v = ""
+			case 2:
+				v = num()
+			case 3:
+				v += sep() + hzPick(tc, []string{"x", "a=b", "3", "r=1 2", "s=x"})
+			case 4:
+				v += sep()
+			}
+		}
+	case 'r':
+		parts := []string{unit(), unit()}
+		for k := hzDrawInt(tc, 0, 2); k > 0; k-- {
+			parts = append(parts, unit())
+		}
+		if bad && hzChance(tc, 40) {
+			parts = parts[:hzDrawInt(tc, 0, 1)]
+		}
+		v = strings.Join(parts, sep())
+	case 'z':
+		var parts []string
+		for k := hzDrawInt(tc, 1, 2); k > 0; k-- {
+			parts = append(parts, num(), unit())
+		}
+		if bad {
+			switch hzDrawInt(tc, 1, 3) {
+			case 1:
+				parts = parts[:len(parts)-1]
+			case 2:
+				parts = nil
+			case 3:
+				parts = append(parts, num())
+			}
+		}
+		v = strings.Join(parts, sep())
+	case 'a':
+		v = hzPick(tc, hzAttrs)
+		if bad {
+			v = text()
+		}
+	case 'm':
+		media := hzPick(tc, []string{"audio", "video", "text", "application", "message"})
+		port := hzPick(tc, []string{"9", "0", "65535", "9/2", "1234", "9/2/3"})
+		proto := hzPick(tc, []string{"RTP/AVP", "UDP/TLS/RTP/SAVPF", "RTP/SAVPF", "TCP/DTLS/SCTP", "UDP"})
+		var fmts []string
+		for k := hzDrawInt(tc, 1, 3); k > 0; k-- {
+			fmts = append(fmts, hzPick(tc, []string{"0", "96", "97", "8", "webrtc-datachannel", "*"}))
+		}
+		if bad {
+			switch hzDrawInt(tc, 1, 5) {
+			case 1:
+				media = hzPick(tc, []string{"data", "Audio", ""})
+			case 2:
+				port = hzPick(tc, []string{"70000", "-1", "+9", "9/2/3", "9/-2", "9/x", "9/", "x", ""})
+			case 3:
+				proto = hzPick(tc, []string{"RTP/XX", "RTP//AVP", "udp", "RTP/AVP/", ""})
+			case 4:
+				fmts = nil
+			case 5:
+				fmts = append(fmts, "")
+			}
+		}
+		v = media + sep() + port + sep() + proto
+		for _, f := range fmts {
+			v += sep() + f
+		}
+	default:
+		v = text()
+	}
+	return string(key) + "=" + v
+}
+
+// hzGenDoc builds a session description: the mandatory lines in order with optional ones
+// sprinkled in, media sections, and mutations (a dropped or repeated line, a swapped pair, an
+// unknown type, a blank line, a line without '=', a leading space).
+func hzGenDoc(tc hegel.TestCase) string {
+	var lines []string
+	add := func(k byte) { lines = append(lines, hzGenLine(tc, k)) }
+	add('v')
+	add('o')
+	add('s')
+	for _, k := range []byte("iuepcb") {
+		if hzChance(tc, 25) {
+			add(k)
+			if k == 'b' && hzChance(tc, 30) {
+				add('b')
+			}
+		}
+	}
+	nt := 1
+	if hzChance(tc, 15) {
+		nt = hzDrawInt(tc, 0, 2)
+	}
+	for i := 0; i < nt; i++ {
+		add('t')
+		for k := hzDrawInt(tc, 0, 2); k > 0; k-- {
+			add('r')
+		}
+	}
+	tail := !hzChance(tc, 12) // some documents end with their time descriptions
+	if tail && hzChance(tc, 25) {
+		add('z')
+	}
+	if tail && hzChance(tc, 20) {
+		add('k')
+	}
+	for n := hzDrawInt(tc, 0, 3); tail && n > 0; n-- {
+		add('a')
+	}
+	for n := hzDrawInt(tc, 0, 2); tail && n > 0; n-- {
+		add('m')
+		for _, k := range []byte("icbk") {
+			if hzChance(tc, 25) {
+				add(k)
+			}
+		}
+		for j := hzDrawInt(tc, 0, 3); j > 0; j-- {
+			add('a')
+		}
+	}
+	// Mutations.
+	nmut := 0
+	if hzChance(tc, 25) {
+		nmut = hzDrawInt(tc, 1, 2)
+	}
+	for n := nmut; n > 0 && len(lines) > 0; n-- {
+		i := hzDrawInt(tc, 0, len(lines)-1)
+		switch hzDrawInt(tc, 1, 8) {
+		case 1:
+			lines = append(lines[:i], lines[i+1:]...)
+		case 2:
+			lines = append(lines[:i+1], lines[i:]...)
+		case 3:
+			if i+1 < len(lines) {
+				lines[i], lines[i+1] = lines[i+1], lines[i]
+			}
+		case 4:
+			lines = append(lines[:i+1], append([]string{hzGenLine(tc, hzPick(tc, []byte("xyz0=vostmarb")))}, lines[i+1:]...)...)
+		case 5:
+			lines = append(lines[:i+1], append([]string{""}, lines[i+1:]...)...)
+		case 6:
+			lines[i] = strings.Replace(lines[i], "=", "", 1)
+		case 7:
+			lines[i] = " " + lines[i]
+		case 8:
+			lines = append(lines[:i+1], append([]string{hzGenLine(tc, hzPick(tc, []byte("icbkatzr")))}, lines[i+1:]...)...)
+		}
+	}
+	// A short final line, with or without a break.
+	if hzChance(tc, 6) {
+		lines = append(lines, hzPick(tc, []string{"m", "a", "x", "=", "a=", "t=1 0", "t=0 0", "z=1 0", "v=0"}))
+	}
+	var b strings.Builder
+	for i, ln := range lines {
+		b.WriteString(ln)
+		last := i == len(lines)-1
+		switch {
+		case last && hzChance(tc, 30):
+			// No final line break.
+		case hzChance(tc, 85):
+			b.WriteString("\r\n")
+		case hzChance(tc, 70):
+			b.WriteString("\n")
+		default:
+			b.WriteString("\r\r\n")
+		}
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the property
+
+func TestHegelUnmarshal(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		text := hzGenDoc(tc)
+		var sd sdp.SessionDescription
+		var err error
+		if r := hzCatch(func() { err = sd.UnmarshalString(text) }); r != nil {
+			col.failClass(ht, "panic", "UnmarshalString(%q) panicked: %v", text, r)
+			return
+		}
+		want, werr := mParse(text)
+		if err != nil || werr != nil {
+			got, wantClass := "", ""
+			if err != nil {
+				got = hzErrClass(err)
+			}
+			if werr != nil {
+				wantClass = werr.Error()
+			}
+			if got != wantClass {
+				col.failClass(ht, "error", "UnmarshalString(%q):\n  got:  %q (%v)\n  want: %q", text, got, err, wantClass)
+				return
+			}
+			col.count("err " + got)
+			return
+		}
+		col.count("ok")
+		if g, w := hzFmtDesc(&sd), want.format(); g != w {
+			col.failClass(ht, "fields", "UnmarshalString(%q):\n  got:\n%s\n  want:\n%s", text, g, w)
+			return
+		}
+		// Unmarshal is documented as UnmarshalString over the bytes.
+		var sd2 sdp.SessionDescription
+		if err := sd2.Unmarshal([]byte(text)); err != nil || hzFmtDesc(&sd2) != hzFmtDesc(&sd) {
+			col.failClass(ht, "bytes", "Unmarshal(%q) differs from UnmarshalString: %v", text, err)
+		}
+	})
+}
