+		header := hegel.Draw(tc, many(mergeFillers, 0, 1))
+		header = append(header, repeat(run, hegel.Draw(tc, spans))...)
+		header = append(header, after)
+		header = append(header, hegel.Draw(tc, many(mergeFillers, 0, 1))...)
+		s.header, s.hideHeader = header, false
+		s.merging = merging{merge: [3]int{hegel.Draw(tc, hMerges), hegel.Draw(tc, noHMerges), 0}}
+		r := hegel.Draw(tc, junctionRends)
