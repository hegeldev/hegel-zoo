+// cleanMergeTables: small boxed tables from mergeFillers under cleanup, AutoHide off.
+var cleanMergeTables = hegel.Map(tables(tableShape{cells: mergeFillers, minCells: 1, minRows: 1, maxRows: 3, boxed: true}), func(s tableSpec) tableSpec {
+	s.autoHide = false
+	return cleanup(s)
+})
