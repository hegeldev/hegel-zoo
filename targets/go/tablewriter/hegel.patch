+// --------------------------------------------------------------------------- widths
+
+type tabinalCase struct {
+	w, asks, w2 int
+}
+
+// tablewriter/1: a Tabinal's SetWidth before its first Size() is kept: Size() returns the set
+// width however often it is asked, and a later SetWidth is kept too. Drawn: a width other than
+// the detected one (1 to 32), how often Size() is asked (1 to 3), a second width.
+func TestHegelTabWidthSetBeforeFirstUseIsKept(t *testing.T) {
+	c := newCollector(t)
+	var probe twwidth.Tabinal
+	detected := probe.Size()
+	widths := hegel.Map(hegel.Integers(1, 31), func(w int) int {
+		if w >= detected {
+			w++
+		}
+		return w
+	})
+	cases := hegel.Composite(func(tc hegel.TestCase) tabinalCase {
+		return tabinalCase{w: hegel.Draw(tc, widths), asks: hegel.Draw(tc, hegel.Integers(1, 3)), w2: hegel.Draw(tc, hegel.Integers(1, 32))}
+	})
+	shapeProperty(t, "tablewriter/1", func(ht *hegel.T) {
+		k := hegel.Draw(ht, cases)
+		var tb twwidth.Tabinal
+		tb.SetWidth(k.w)
+		for i := 0; i < k.asks; i++ {
+			if got := tb.Size(); got != k.w {
+				c.failClass(ht, "Size", "Tabinal.SetWidth(%d) then Size() (call %d) = %d, want %d (the detection ran over the set width; %d is detected)", k.w, i+1, got, k.w, detected)
+				return
+			}
+		}
+		tb.SetWidth(k.w2)
+		if got := tb.Size(); got != k.w2 {
+			c.failClass(ht, "Size again", "Tabinal.SetWidth(%d), Size(), SetWidth(%d) then Size() = %d, want %d", k.w, k.w2, got, k.w2)
+		}
+	})
+}
+
+type tabCacheCase struct {
+	k      widthCase
+	w1, w2 int
+}
+
+// tablewriter/2: a width measured under one tab width is measured again under another: the
+// wide checks of TestHegelWidth on the same tabbed string under tab width w1 then w2 (1 to 8,
+// different, and giving the string different widths). Drawn: visible pieces around a tab, the
+// options, the two tab widths.
+func TestHegelTabWidthChangeReachesCachedWidths(t *testing.T) {
+	c := newCollector(t)
+	defer func() { twwidth.SetTabWidth(tabW); setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	tabbed := hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, visibleStrs(0, 2)) + "\t" + hegel.Draw(tc, visibleStrs(0, 2))
+	})
+	cases := hegel.Filter(hegel.Composite(func(tc hegel.TestCase) tabCacheCase {
+		w1 := hegel.Draw(tc, hegel.Integers(1, 8))
+		w2 := hegel.Draw(tc, hegel.Integers(1, 7))
+		if w2 >= w1 {
+			w2++
+		}
+		return tabCacheCase{
+			k:  widthCase{o: hegel.Draw(tc, widthOptions), s: hegel.Draw(tc, tabbed), other: hegel.Draw(tc, widthOptions)},
+			w1: w1, w2: w2,
+		}
+	}), func(k tabCacheCase) bool {
+		o1, o2 := k.k.o, k.k.o
+		o1.tab, o2.tab = k.w1, k.w2
+		return width(k.k.s, o1) != width(k.k.s, o2)
+	})
+	shapeProperty(t, "tablewriter/2", func(ht *hegel.T) {
+		k := hegel.Draw(ht, cases)
+		// a change of options purges the cache: the first measurement starts from an empty one
+		flipped := k.k.o
+		flipped.ea = !flipped.ea
+		setOpts(flipped)
+		first, second := k.k, k.k
+		first.tab, second.tab = k.w1, k.w2
+		checkWidth(c, ht, first)
+		checkWidth(c, ht, second)
+	})
+}
