+// --------------------------------------------------------------------------- clean tables
+
+// cleanCells: tableCells without the blank cells (AutoHide, bugs 11, 15, 16, 34), the pipe
+// (9), the newlines (10, 35) and the escape sequence (19, 20).
+var cleanCells = without(tableCells, "", "  ", "a|b", "x\ny", "x\n\ny", esc+"[31mred"+esc+"[0m")
+
+var cleanCellTexts = hegel.SampledFrom(cleanCells)
+
+// cleanTables: tables of 1 to 3 records of at least one cell from cleanCells, AutoHide off.
+func cleanTables(boxed bool) hegel.Generator[tableSpec] {
+	return hegel.Map(tables(tableShape{cells: cleanCellTexts, minCells: 1, minRows: 1, maxRows: 3, boxed: boxed}), func(s tableSpec) tableSpec {
+		s.autoHide = false
+		return s
+	})
+}
+
+// explicitAlign replaces AlignNone and the empty alignment by the section's default, in the
+// global alignment and per column (bug 13).
+func explicitAlign(a tw.CellAlignment, def tw.Align) tw.CellAlignment {
+	if !explicit(a.Global) {
+		a.Global = def
+	}
+	per := append([]tw.Align(nil), a.PerColumn...)
+	for i, p := range per {
+		if p == tw.AlignNone {
+			per[i] = def
+		}
+	}
+	a.PerColumn = per
+	return a
+}
+
+// cleanup takes a boxed table out of the other recorded boxed shapes: the header's and the
+// footer's AlignNone replaced by the section default (13), no footer without a rendered header
+// (14); the tables it is applied to have records with cells (17, 18), no blank cells (15, 16,
+// 34) and no escape sequences (19, 20).
+func cleanup(s tableSpec) tableSpec {
+	s.align[secHeader] = explicitAlign(s.align[secHeader], tw.AlignCenter)
+	s.align[secFooter] = explicitAlign(s.align[secFooter], tw.AlignRight)
+	if s.header == nil || s.hideHeader {
+		s.footer = nil
+	}
+	return s
+}
+
+// cleanBoxed: boxed cleanTables under cleanup.
+var cleanBoxed = hegel.Map(cleanTables(true), cleanup)
+
+// cleanRends: rendSpecs without StyleGraphical (bug 21).
+var cleanRends = hegel.Filter(rendSpecs, func(r rendSpec) bool { return r.style != tw.StyleGraphical })
+
+// glyphRends: cleanRends without StyleNone, whose empty glyphs make a missing separator or a
+// merge invisible.
+var glyphRends = hegel.Filter(cleanRends, func(r rendSpec) bool { return r.style != tw.StyleNone })
+
+// padsOf is the width of a table's left and right padding.
+func padsOf(s tableSpec) int {
+	return w0(s.pad().Left) + w0(s.pad().Right)
+}
+
+// numColsOf is the number of columns of the records of s.
+func numColsOf(s tableSpec) int {
+	n := max(len(s.header), len(s.footer))
+	for _, r := range s.rows {
+		n = max(n, len(r))
+	}
+	return n
+}
+
+// placed is a copy of the record with the cell at index at (modulo the cells; a record
+// without cells becomes the cell alone).
+func placed(cells []string, at int, cell string) []string {
+	if len(cells) == 0 {
+		return []string{cell}
+	}
+	out := append([]string(nil), cells...)
+	out[at%len(out)] = cell
+	return out
+}
+
+// padded is the record extended to n cells with cells drawn from pool.
+func padded(tc hegel.TestCase, cells []string, n int, pool hegel.Generator[string]) []string {
+	out := append([]string(nil), cells...)
+	for len(out) < n {
+		out = append(out, hegel.Draw(tc, pool))
+	}
+	return out
+}
+
+// withCell puts the cell into section sec of s (at index at modulo the record, in record row
+// modulo the rows), creating the record when the section has none, and un-hides the section.
+func withCell(s tableSpec, sec, row, at int, cell string) tableSpec {
+	switch sec {
+	case secHeader:
+		s.header = placed(s.header, at, cell)
+		s.hideHeader = false
+	case secFooter:
+		s.footer = placed(s.footer, at, cell)
+		s.hideFooter = false
+	default:
+		if len(s.rows) == 0 {
+			s.rows = [][]string{{cell}}
+		} else {
+			rows := append([][]string(nil), s.rows...)
+			i := row % len(rows)
+			rows[i] = placed(rows[i], at, cell)
+			s.rows = rows
+		}
+	}
+	return s
+}
+
+// withHeader gives s the header when it has none rendered.
+func withHeader(s tableSpec, header []string) tableSpec {
+	if s.header == nil || s.hideHeader {
+		s.header = header
+		s.hideHeader = false
+	}
+	return s
+}
+
+// blankColumn blanks the column col (modulo the columns) in every record that has it, after
+// extending the first record to at least two columns and to the column (so that another
+// column keeps content and the blanked one exists).
+func blankColumn(tc hegel.TestCase, s tableSpec, col int) (tableSpec, int) {
+	rows := append([][]string(nil), s.rows...)
+	rows[0] = padded(tc, rows[0], 2, cleanCellTexts)
+	s.rows = rows
+	col %= numColsOf(s)
+	rows[0] = padded(tc, rows[0], col+1, cleanCellTexts)
+	for i, r := range rows {
+		if col < len(r) {
+			rows[i] = placed(r, col, "")
+		}
+	}
+	return s, col
+}
+
+var sections = hegel.Integers(secHeader, secFooter)
