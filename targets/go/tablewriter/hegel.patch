+package hegel
+
+// The narrow properties: one per recorded bug (bugs.toml, tablewriter/1 to 40). Each draws a
+// small record over the bug's shape region with random surroundings, reusing the generators of
+// the wide test files (cells, tables, renditions, width and string pools), and checks it with
+// the same helper as the wide property that meets the bug (checkWidth, checkTruncate, checkWrap,
+// checkFn, checkMarkdown, checkHTML, checkBlueprint, checkConstraints, checkMerge, checkStream,
+// checkInput). Three bugs no wide property meets are checked against the documented behaviour
+// spelled here: 1 (a Tabinal's SetWidth is kept), 19 (escape sequences of an auto-formatted
+// header are kept intact and take no width) and 24 (WithMaxWidth bounds every line). The
+// properties fail while the bugs exist and are the expected failures mapped to them; under
+// HEGEL_NO_KNOWN=1 they are skipped (the region is the bug, there is nothing left to test).
+//
+// The surroundings are drawn outside every other recorded shape (cleanBoxed, cleanRends, the
+// clean input rows), so that a failure is the mapped bug's and the shrunk case its minimal
+// shape.
+
+import (
+	"database/sql"
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+// shapeProperty runs a narrow property, skipped under HEGEL_NO_KNOWN=1. The region is one
+// bug's, so the engine stops at the first failure and shrinks it, instead of spending its
+// budget looking for distinct failures.
+func shapeProperty(t *testing.T, bug string, fn func(ht *hegel.T)) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("%s: the shape region is the recorded bug, left out under HEGEL_NO_KNOWN=1", bug)
+	}
+	property(t, fn, hegel.WithReportMultipleFailures(false))
+}
+
+// --------------------------------------------------------------------------- pools
+
+// without is the pool less the given strings.
+func without(pool []string, xs ...string) []string {
+	var out []string
+	for _, p := range pool {
+		drop := false
+		for _, x := range xs {
+			if p == x {
+				drop = true
+			}
+		}
+		if !drop {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// repeat is n copies of the cell.
+func repeat(cell string, n int) []string {
+	out := make([]string, n)
+	for i := range out {
+		out[i] = cell
+	}
+	return out
+}
+
+// positions: an index into a record or a pool, taken modulo its length.
+var positions = hegel.Integers(0, 7)
+
+// visiblePieces: plainPieces without the controls, every piece at least one column wide.
+var visiblePieces = without(plainPieces, "\t", "\n", "\r", "\x00", "\x7f")
+
+var visibleText = hegel.SampledFrom(visiblePieces)
+
+// visibleStrs: lo to hi visible pieces concatenated.
+func visibleStrs(lo, hi int) hegel.Generator[string] {
+	return joined(many(visibleText, lo, hi))
+}
+
+// onOrDefault: a renderer setting left to its default or switched on.
+var onOrDefault = hegel.SampledFrom([]tw.State{tw.Unknown, tw.On})
