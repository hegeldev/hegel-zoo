+// junctionRends: cleanRends whose top junction glyph differs from the row glyph (StyleDotted's
+// and StyleNone's do not, so a missing junction is invisible there).
+var junctionRends = hegel.Filter(cleanRends, func(r rendSpec) bool {
+	sym := tw.NewSymbols(r.style)
+	return sym.TopMid() != sym.Row()
+})
