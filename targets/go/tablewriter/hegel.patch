new file mode 100644
index 0000000..dbbab46
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,188 @@
+package hegel
+
+// Hegel property tests for olekukonko/tablewriter, written for the Hegel zoo. See
+// targets/go/tablewriter/README.md.
+//
+// Oracle: models of the documented behaviour of the helper packages (pkg/twwidth: display
+// widths over strings holding ANSI escape sequences, truncation; pkg/twwarp: word splitting
+// and minimum-raggedness wrapping; tw: padding, title formatting, camel-case splitting,
+// break points) and of the table's Markdown, HTML and boxed (Blueprint) renderings over
+// generated cells, with width constraints, wrap modes, captions and cell merging, in batch
+// and in streaming mode; and of the input conversion of Append/Bulk (slices, single values,
+// structs, AutoHeader).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	tabWidthCache         bool // 2: Width's cache is not purged by SetTabWidth
+	widthPerRune          bool // 3: Width sums rune widths, so emoji sequences differ from displaywidth's string width
+	truncateEscRestart    bool // 4: Truncate restarts its scan at every ESC, so an ST-terminated OSC swallows the rest
+	truncateZeroSuffix    bool // 5: Truncate at maxWidth 0 returns "" although the suffix is documented
+	wrapSpacesByteSlice   bool // 6: WrapStringWithSpaces splits a multi-byte last rune between core and trailing spaces
+	breakPointEscapes     bool // 7: BreakPoint counts the characters of escape sequences
+	camelUnderscoreGroups bool // 8: SplitCamelCase keeps groups of two or more underscores
+	// table
+	markdownPipes   bool // 9: the Markdown renderer does not escape | in cells
+	multilineRows   bool // 10: a cell with newlines becomes extra Markdown/HTML rows (the <br> paths are dead)
+	autoHideIgnored bool // 11: the Markdown and HTML renderers render the columns AutoHide hides
+	// blueprint
+	alignNoneLeft            bool // 13: Blueprint renders AlignNone cells left-aligned in every section, discarding the position default it computes
+	noTopBorderWithoutHeader bool // 14: no top border when the table has a footer but no header
+	autoHideSeparator        bool // 15: the separator before a visible column is dropped when the column before it is hidden by AutoHide
+	doubleSeparator          bool // 17: a header-and-footer table without rows renders the header and the footer separator, two identical lines
+	// caption
+	captionAlignLeft bool // 22: an explicit AlignLeft caption takes the spot's default alignment, AlignDefault being AlignLeft
+	// input conversion
+	pointerAddress            bool // 25: a pointer to a basic type (a cell or a struct field) is rendered as its address
+	nilStringerPanic          bool // 26: a nil pointer whose String()/Error() dereferences panics in convertToString (values generated only when off)
+	nullTypesUnhandled        bool // 27: sql.NullInt32 (NullInt16, NullByte) render as {5 true}
+	byteSliceRowNumbers       bool // 28: a []byte row is one numeric cell per byte, though the code says it is a string
+	readerEllipsisAt512       bool // 29: an io.Reader of exactly 512 bytes gets the ellipsis
+	embeddedNilDrops          bool // 30: a nil embedded struct pointer drops its columns, misaligning AutoHeader
+	singleStructEmptyRow      bool // 31: a value without exported fields appended alone (an error, a reader) is an empty row
+	autoHeaderConsumesReaders bool // 32: AutoHeader's extraction converts the first row's values too, reading its io.Reader fields
+	// part 6: cell merging
+	topJunctionAfterMerge   bool // 33: the top border has no junction after a horizontally merged header cell (the row glyph instead)
+	mergedHeaderHiddenWidth bool // 34: a merged header cell keeps the widths of the columns AutoHide hides, so the header is wider than the rows
+	footerLeadDropsLines    bool // 35: the footer's lead merge blanks the later lines of a multi-line cell it moves
+	// part 7: streaming
+	streamHeaderMergeWidth       bool // 36: a merged header cell is rendered at its own column's width in streaming, so the header line is narrower than the borders
+	streamFooterMergesIgnored    bool // 37: the footer's horizontal merges are not applied in streaming
+	emptyRowSuppressesHeaderLine bool // 38: an empty row appended first counts as the first row, so the header separator is never drawn
+	scaleRemainderRandom         bool // 39: the rounding remainder of the Widths.Global shrink is spread in map order, so the layout is random
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
diff --git a/hegel/hegel_width_test.go b/hegel/hegel_width_test.go
new file mode 100644
index 0000000..3ca85f4
--- /dev/null
+++ b/hegel/hegel_width_test.go
@@ -0,0 +1,181 @@
+package hegel
+
+// Properties of pkg/twwidth: Width, WidthNoCache, WidthWithOptions, Filter and Truncate
+// against the models of hegel_model_test.go.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+var plainPieces = []string{
+	"a", "b", "hello", "World", "x1", "-", ".", " ", "  ", "\t", "\n", "\r", "\x00", "\x7f",
+	"é", "é", "あ", "漢字", "─", "┼", "═",
+	"\U0001F600", "ß", "Ǳ", "…", "↩", "　",
+}
+
+// emojiPieces are sequences whose grapheme width differs from the sum of their runes.
+var emojiPieces = []string{
+	"❤️", "\U0001F468‍\U0001F469‍\U0001F467", "\U0001F1EB\U0001F1F7",
+	"1️⃣", "\U0001F44B\U0001F3FB", "☀️",
+}
+
+var csiPieces = []string{
+	esc + "[31m", esc + "[0m", esc + "[1;32m", esc + "[m", esc + "[K", esc + "[2J", esc + "[?25h",
+	esc + "[1;2 q", esc + "[38;5;31m", esc + "[10;20H",
+}
+
+var oscBelPieces = []string{esc + "]0;title" + bel, esc + "]8;;http://x" + bel, esc + "]8;;" + bel}
+var oscSTPieces = []string{esc + "]8;;http://x" + esc + "\\", esc + "]8;;" + esc + "\\", esc + "]0;t" + esc + "\\"}
+
+type strOpts struct {
+	noSeq, noEmoji, noST bool
+	maxPieces            int
+}
+
+func genStr(tc hegel.TestCase, o strOpts) string {
+	n := o.maxPieces
+	if n == 0 {
+		n = 8
+	}
+	k := drawInt(tc, 0, n)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		switch r := drawInt(tc, 1, 100); {
+		case r <= 55:
+			b.WriteString(pick(tc, plainPieces))
+		case r <= 65 && !o.noEmoji:
+			b.WriteString(pick(tc, emojiPieces))
+		case r <= 85 && !o.noSeq:
+			b.WriteString(pick(tc, csiPieces))
+		case r <= 93 && !o.noSeq:
+			b.WriteString(pick(tc, oscBelPieces))
+		case !o.noSeq && !o.noST:
+			b.WriteString(pick(tc, oscSTPieces))
+		default:
+			b.WriteString(pick(tc, plainPieces))
+		}
+	}
+	return b.String()
+}
+
+func hasEmojiSeq(s string) bool {
+	for _, p := range emojiPieces {
+		if strings.Contains(s, p) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasBox(s string) bool {
+	for _, r := range s {
+		if isBox(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func drawOpts(tc hegel.TestCase) widthOpts {
+	return widthOpts{ea: chance(tc, 30), narrow: chance(tc, 30)}
+}
+
+func TestHegelWidth(t *testing.T) {
+	c := newCollector(t)
+	defer func() { twwidth.SetTabWidth(tabW); setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		o := drawOpts(ht)
+		if !Known.tabWidthCache && chance(ht, 50) {
+			o.tab = drawInt(ht, 1, 8)
+			twwidth.SetTabWidth(o.tab)
+		} else {
+			twwidth.SetTabWidth(tabW)
+		}
+		setOpts(o)
+		s := genStr(ht, strOpts{})
+		want := width(s, o)
+		c.count("ea=" + boolStr(o.ea))
+		if strings.Contains(s, esc) {
+			c.count("with sequences")
+		}
+		if got := twwidth.Width(s); got != want {
+			c.failClass(ht, "Width", "Width(%q) %+v = %d, want %d", s, o, got, want)
+		}
+		if got := twwidth.Width(s); got != want {
+			c.failClass(ht, "Width cached", "Width(%q) %+v = %d on the second call, want %d", s, o, got, want)
+		}
+		if got := twwidth.WidthNoCache(s); got != want {
+			c.failClass(ht, "WidthNoCache", "WidthNoCache(%q) %+v = %d, want %d", s, o, got, want)
+		}
+		other := drawOpts(ht)
+		other.tab = o.tab
+		otherOpts := twwidth.Options{EastAsianWidth: other.ea, ForceNarrowBorders: other.narrow}
+		if got, w := twwidth.WidthWithOptions(s, otherOpts), width(s, other); got != w {
+			c.failClass(ht, "WidthWithOptions", "WidthWithOptions(%q, %+v) = %d, want %d", s, other, got, w)
+		}
+		if got, w := twwidth.Filter().ReplaceAllLiteralString(s, ""), stripSeq(s); got != w {
+			c.failClass(ht, "Filter", "Filter stripped %q to %q, want %q", s, got, w)
+		}
+		if !Known.widthPerRune && !strings.Contains(s, "\t") && !hasBox(s) {
+			dw := displaywidth.Options{EastAsianWidth: o.ea}
+			if got, w := twwidth.Width(s), dw.String(stripSeq(s)); got != w {
+				c.failClass(ht, "grapheme width", "Width(%q) %+v = %d, displaywidth.String gives %d", s, o, got, w)
+			}
+		}
+		if hasEmojiSeq(s) {
+			c.count("emoji sequence")
+		}
+	})
+}
+
+func boolStr(b bool) string {
+	if b {
+		return "true"
+	}
+	return "false"
+}
+
+var suffixes = []string{"", "", ".", "..", "...", "…", "あ"}
+
+func TestHegelTruncate(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		o := drawOpts(ht)
+		setOpts(o)
+		s := genStr(ht, strOpts{maxPieces: 6})
+		maxWidth := drawInt(ht, -1, 12)
+		suffix := pick(ht, suffixes)
+		want := truncate(s, maxWidth, suffix, o)
+		var got string
+		if suffix == "" && chance(ht, 50) {
+			got = twwidth.Truncate(s, maxWidth)
+		} else {
+			got = twwidth.Truncate(s, maxWidth, suffix)
+		}
+		sw := width(s, o)
+		switch {
+		case maxWidth < 0:
+			c.count("negative")
+		case sw <= maxWidth:
+			c.count("fits")
+		default:
+			c.count("truncated")
+		}
+		if got != want {
+			c.failClass(ht, "Truncate", "Truncate(%q, %d, %q) %+v = %q, want %q", s, maxWidth, suffix, o, got, want)
+			return
+		}
+		if maxWidth >= 0 && width(got, o) > maxWidth {
+			c.failClass(ht, "too wide", "Truncate(%q, %d, %q) %+v = %q, width %d", s, maxWidth, suffix, o, got, width(got, o))
+		}
+		if strings.Contains(s, esc) && maxWidth > 0 && sw > maxWidth && got != "" && strings.Contains(got, esc) && !strings.Contains(got, reset) {
+			c.failClass(ht, "no reset", "Truncate(%q, %d, %q) = %q leaves a sequence open", s, maxWidth, suffix, got)
+		}
+	})
+}
diff --git a/hegel/hegel_wrap_test.go b/hegel/hegel_wrap_test.go
new file mode 100644
index 0000000..c9b721f
--- /dev/null
+++ b/hegel/hegel_wrap_test.go
@@ -0,0 +1,341 @@
+package hegel
+
+// Properties of pkg/twwarp: SplitWords, WrapWords (the minimum-raggedness partition, checked
+// against a brute-force optimum and an independent dynamic programme), WrapString and
+// WrapStringWithSpaces.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+const penalty = 100000 // twwarp's defaultPenalty
+
+var wordPool = []string{
+	"a", "bb", "ccc", "dddd", "eeeeee", "あ", "ああ", "é", "xý", "1.5",
+	esc + "[31mred" + esc + "[0m", "ab" + esc + "[1m", "──", "\U0001F600",
+}
+
+var spaceRuns = []string{" ", " ", "  ", "\t", "\n", "\r\n", " \t ", "　", " "}
+
+// lineCost is the raggedness the package minimises: for every line but the last, the square
+// of the slack (plus the penalty when the line overflows); the last line is free.
+func lineWidth(words []string, spc int) int {
+	w := 0
+	for i, x := range words {
+		if i > 0 {
+			w += spc
+		}
+		w += twwidth.Width(x)
+	}
+	return w
+}
+
+func partitionCost(lines [][]string, spc, lim int) int {
+	cost := 0
+	for i, l := range lines {
+		if i == len(lines)-1 {
+			break
+		}
+		d := lim - lineWidth(l, spc)
+		cost += d * d
+		if lineWidth(l, spc) > lim {
+			cost += penalty
+		}
+	}
+	return cost
+}
+
+// bestCost is the optimum by brute force over every partition whose last line fits (or is a
+// single word).
+func bestCost(words []string, spc, lim int) int {
+	n := len(words)
+	best := math.MaxInt
+	for mask := 0; mask < 1<<(n-1); mask++ {
+		var lines [][]string
+		start := 0
+		for i := 0; i < n-1; i++ {
+			if mask&(1<<i) != 0 {
+				lines = append(lines, words[start:i+1])
+				start = i + 1
+			}
+		}
+		lines = append(lines, words[start:])
+		last := lines[len(lines)-1]
+		if len(last) > 1 && lineWidth(last, spc) > lim {
+			continue
+		}
+		if c := partitionCost(lines, spc, lim); c < best {
+			best = c
+		}
+	}
+	return best
+}
+
+// wrapWords is an independent statement of the package's dynamic programme: the break after
+// word i is the first j minimising slack^2 (+ penalty) plus the cost from j; a tail that fits
+// costs nothing, and the last word ends the chain.
+func wrapWords(words []string, spc, lim int) [][]string {
+	n := len(words)
+	if n == 0 {
+		return nil
+	}
+	lengths := make([]int, n)
+	for i, w := range words {
+		lengths[i] = twwidth.Width(w)
+	}
+	cost := make([]int, n)
+	next := make([]int, n)
+	for i := n - 1; i >= 0; i-- {
+		if i == n-1 || lineWidth(words[i:], spc) <= lim {
+			cost[i] = 0
+			next[i] = n
+			continue
+		}
+		cost[i] = math.MaxInt32
+		for j := i + 1; j < n; j++ {
+			l := lineWidth(words[i:j], spc)
+			d := lim - l
+			c := d*d + cost[j]
+			if l > lim {
+				c += penalty
+			}
+			if c < cost[i] {
+				cost[i] = c
+				next[i] = j
+			}
+		}
+	}
+	var lines [][]string
+	for i := 0; i < n; i = next[i] {
+		lines = append(lines, words[i:next[i]])
+	}
+	return lines
+}
+
+func splitWords(s string) []string { return strings.FieldsFunc(s, unicode.IsSpace) }
+
+func maxWordWidth(words []string) int {
+	m := 0
+	for _, w := range words {
+		if x := twwidth.Width(w); x > m {
+			m = x
+		}
+	}
+	return m
+}
+
+func joinLines(lines [][]string) []string {
+	out := make([]string, 0, len(lines))
+	for _, l := range lines {
+		out = append(out, strings.Join(l, " "))
+	}
+	return out
+}
+
+// wrapString is the model of twwarp.WrapString.
+func wrapString(s string, lim int) ([]string, int) {
+	if s == " " {
+		return []string{" "}, lim
+	}
+	words := splitWords(s)
+	if len(words) == 0 {
+		return []string{""}, lim
+	}
+	if m := maxWordWidth(words); m > lim {
+		lim = m
+	}
+	return joinLines(wrapWords(words, 1, lim)), lim
+}
+
+// wrapStringWithSpaces is the model of twwarp.WrapStringWithSpaces. Under
+// Known.wrapSpacesByteSlice the core content ends one byte after the start of the last
+// non-space rune, as the package slices it, so a multi-byte last rune is split between the
+// core and the "trailing spaces".
+func wrapStringWithSpaces(s string, lim int) ([]string, int) {
+	if s == "" {
+		return []string{""}, lim
+	}
+	if strings.TrimSpace(s) == "" {
+		if w := twwidth.Width(s); w <= lim {
+			return []string{s}, w
+		}
+		if lim > 0 {
+			cw := 0
+			end := 0
+			for i, r := range s {
+				w := twwidth.Width(string(r))
+				if cw+w > lim {
+					break
+				}
+				cw += w
+				end = i + utf8.RuneLen(r)
+			}
+			return []string{s[:end]}, lim
+		}
+		return []string{""}, lim
+	}
+	first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	end := last + 1
+	if !Known.wrapSpacesByteSlice {
+		_, size := utf8.DecodeRuneInString(s[last:])
+		end = last + size
+	}
+	leading, trailing, core := s[:first], s[end:], s[first:end]
+	words := splitWords(core)
+	if len(words) == 0 {
+		return []string{leading + trailing}, lim
+	}
+	cur := lim
+	if m := maxWordWidth(words); m > cur {
+		cur = m
+	}
+	lines := joinLines(wrapWords(words, 1, cur))
+	for i := range lines {
+		lines[i] = leading + lines[i]
+		if i == len(lines)-1 {
+			lines[i] += trailing
+		}
+	}
+	return lines, cur
+}
+
+func genWords(tc hegel.TestCase, max int) []string {
+	n := drawInt(tc, 0, max)
+	words := make([]string, n)
+	for i := range words {
+		words[i] = pick(tc, wordPool)
+	}
+	return words
+}
+
+func genSpaced(tc hegel.TestCase, words []string) string {
+	var b strings.Builder
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, spaceRuns))
+	}
+	for i, w := range words {
+		if i > 0 {
+			b.WriteString(pick(tc, spaceRuns))
+		}
+		b.WriteString(w)
+	}
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, spaceRuns))
+	}
+	return b.String()
+}
+
+func flatten(lines [][]string) []string {
+	var out []string
+	for _, l := range lines {
+		out = append(out, l...)
+	}
+	return out
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestHegelWrap(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		words := genWords(ht, 8)
+		lim := drawInt(ht, -2, 14)
+		spc := drawInt(ht, 0, 2)
+		got := twwarp.WrapWords(words, spc, lim, penalty)
+		if len(words) == 0 {
+			if got != nil {
+				c.failClass(ht, "WrapWords empty", "WrapWords(nil) = %q", got)
+			}
+		} else {
+			if !sameStrings(flatten(got), words) {
+				c.failClass(ht, "WrapWords words", "WrapWords(%q, %d, %d) = %q loses or reorders words", words, spc, lim, got)
+				return
+			}
+			if last := got[len(got)-1]; len(last) > 1 && lineWidth(last, spc) > lim {
+				c.failClass(ht, "WrapWords last", "WrapWords(%q, %d, %d) = %q: the last line overflows", words, spc, lim, got)
+			}
+			if pc, bc := partitionCost(got, spc, lim), bestCost(words, spc, lim); pc != bc {
+				c.failClass(ht, "WrapWords optimum", "WrapWords(%q, %d, %d) = %q costs %d, the optimum is %d", words, spc, lim, got, pc, bc)
+			}
+			if want := wrapWords(words, spc, lim); !sameStrings(joinLines(got), joinLines(want)) {
+				c.failClass(ht, "WrapWords exact", "WrapWords(%q, %d, %d) = %q, want %q", words, spc, lim, got, want)
+			}
+			c.count("lines=" + itoa(len(got)))
+		}
+
+		s := genSpaced(ht, words)
+		if chance(ht, 10) {
+			s = pick(ht, []string{"", " ", "  ", "\t", " \n ", "　", "　　　", "     "})
+		}
+		if sw := twwarp.SplitWords(s); !sameStrings(sw, splitWords(s)) {
+			c.failClass(ht, "SplitWords", "SplitWords(%q) = %q, want %q", s, sw, splitWords(s))
+		}
+		lines, gotLim := twwarp.WrapString(s, lim)
+		wantLines, wantLim := wrapString(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapString", "WrapString(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		for _, l := range lines {
+			if twwidth.Width(l) > gotLim && gotLim >= 0 && s != " " {
+				c.failClass(ht, "WrapString width", "WrapString(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+			}
+		}
+		lines, gotLim = twwarp.WrapStringWithSpaces(s, lim)
+		wantLines, wantLim = wrapStringWithSpaces(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapStringWithSpaces", "WrapStringWithSpaces(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		if strings.TrimSpace(s) != "" {
+			first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			_, size := utf8.DecodeRuneInString(s[last:])
+			lead, trail := s[:first], s[last+size:]
+			for i, l := range lines {
+				if !strings.HasPrefix(l, lead) || (i == len(lines)-1 && !strings.HasSuffix(l, trail)) {
+					c.failClass(ht, "WithSpaces preserved", "WrapStringWithSpaces(%q, %d) = %q: leading %q / trailing %q not preserved", s, lim, lines, lead, trail)
+					break
+				}
+				core := strings.TrimPrefix(l, lead)
+				if i == len(lines)-1 {
+					core = strings.TrimSuffix(core, trail)
+				}
+				if !Known.wrapSpacesByteSlice && twwidth.Width(core) > gotLim {
+					c.failClass(ht, "WithSpaces width", "WrapStringWithSpaces(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+				}
+			}
+			if strings.Join(splitWords(strings.Join(lines, " ")), " ") != strings.Join(splitWords(s), " ") {
+				c.failClass(ht, "WithSpaces words", "WrapStringWithSpaces(%q, %d) = %q changes the words", s, lim, lines)
+			}
+		}
+	})
+}
+
+func itoa(n int) string {
+	if n < 0 {
+		return "-" + itoa(-n)
+	}
+	if n < 10 {
+		return string(rune('0' + n))
+	}
+	return itoa(n/10) + string(rune('0'+n%10))
+}
