+// --------------------------------------------------------------------------- merging
+
+var (
+	// runCells: cells a horizontal merge joins (non-empty, not "-"), distinct after AutoFormat
+	runCells = hegel.SampledFrom([]string{"a", "b", "Total", "x", "long cell", "c"})
+	// mergeFillers: mergeCells without the multi-line cell (35) and the blank one (16, 34)
+	mergeFillers = hegel.SampledFrom(without(mergeCells, "x\ny", ""))
+	hMerges      = hegel.SampledFrom([]int{tw.MergeHorizontal, tw.MergeBoth})
+	// noHMerges: row merge modes without the horizontal bit (40: a streamed row merge writes
+	// into the caller's slice)
