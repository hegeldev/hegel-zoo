+// --------------------------------------------------------------------------- input conversion
+
+// cleanLeafTypes: the leaf types outside the recorded input shapes: no pointers to basic types
+// (25), no nil Stringer/error pointers (26, and the interface types that may hold them), no
+// sql.NullInt32 (27), no io.Reader (29, 32).
+var cleanLeafTypes = []reflect.Type{tString, tInt, tInt64, tFloat64, tBool, tTime, tNullStr, tNullI64, tBytes, tFmtVal, tStrVal, tInner1}
+
+// cleanLeafMap: the leaves of cleanLeafTypes whose cell has no pipe (9) and no newline (10).
+var cleanLeafMap = func() map[reflect.Type]hegel.Generator[leaf] {
+	m := map[reflect.Type]hegel.Generator[leaf]{}
+	for _, typ := range cleanLeafTypes {
+		m[typ] = hegel.Filter(leaves[typ], func(l leaf) bool { return !strings.ContainsAny(l.s, "|\n") })
+	}
+	return m
+}()
+
+var (
+	cleanLeafTypeChoice = hegel.SampledFrom(cleanLeafTypes)
+	cleanLeaves         = hegel.FlatMap(cleanLeafTypeChoice, func(typ reflect.Type) hegel.Generator[leaf] { return cleanLeafMap[typ] })
+	cleanTexts          = hegel.SampledFrom(without(leafStrings, "x|y", "multi\nline"))
+	cleanFields         = fieldSpecsOf(cleanLeafTypeChoice, cleanLeafMap)
+	cleanStructs        = structsOf(cleanFields)
+	cleanTypedRows      = hegel.OneOf(intRows, int64Rows, float64Rows, boolRows, int32Rows, uint16Rows)
+	// cleanBulkRows, cleanAppendRows: bulkRows and appendRows over the clean leaves, without
+	// the []byte row (28) and the single values (31)
+	cleanBulkRows = hegel.OneOf(
+		hegel.Map(many(cleanTexts, 0, 4), stringRow),
+		hegel.Map(many(cleanLeaves, 0, 4), anyRow(rowAnys)),
+		cleanTypedRows,
+		hegel.Map(cleanStructs, structRow),
+	)
+	cleanAppendRows = hegel.OneOf(cleanBulkRows, hegel.Map(many(cleanLeaves, 2, 4), anyRow(rowVariadic)))
+	cleanOps        = weighted(
+		choice[inputOp]{70, hegel.Map(cleanAppendRows, func(r rowInput) inputOp { return inputOp{rows: []rowInput{r}} })},
+		choice[inputOp]{30, hegel.Map(many(cleanBulkRows, 0, 2), func(rs []rowInput) inputOp { return inputOp{bulk: true, rows: rs} })},
+	)
+	// shapedNames, shapedTags: the name (not one of fieldNames, so the struct stays valid) and
+	// the tag (never skipping or omitting the field) of a field that holds a bug's value
+	shapedNames = hegel.SampledFrom([]string{"Value", "Item", "Extra"})
+	shapedTags  = hegel.SampledFrom([]string{``, ``, `json:"jname"`, `db:"dname"`})
+)
+
+// insertAt is the leaves with l inserted at position at (modulo the length plus one).
+func insertAt(ls []leaf, at int, l leaf) []leaf {
+	i := at % (len(ls) + 1)
+	return append(ls[:i], append([]leaf{l}, ls[i:]...)...)
+}
+
+// leafRow puts the leaf into a row: among 0 to 3 clean leaves of a []any, among 1 to 3 as the
+// arguments of a variadic Append or, when single is allowed, alone.
+func leafRow(tc hegel.TestCase, l leaf, single bool) rowInput {
+	kinds := 1
+	if single {
+		kinds = 2
+	}
+	switch hegel.Draw(tc, hegel.Integers(0, kinds)) {
+	case 0:
+		return anyRow(rowAnys)(insertAt(hegel.Draw(tc, many(cleanLeaves, 0, 3)), hegel.Draw(tc, positions), l))
+	case 1:
+		return anyRow(rowVariadic)(insertAt(hegel.Draw(tc, many(cleanLeaves, 1, 3)), hegel.Draw(tc, positions), l))
+	}
+	return singleRow(l)
+}
+
+// structWith is a struct of 0 to 3 clean fields with f inserted at a drawn position, appended
+// as a pointer 40% of the time (never nil).
+func structWith(tc hegel.TestCase, f fieldSpec) structSpec {
+	fields := uniqueNames(hegel.Draw(tc, many(cleanFields, 0, 3)))
+	fields = embedding{field: &f, at: hegel.Draw(tc, hegel.Integers(0, 5))}.insert(fields)
+	return newStructSpec(fields, hegel.Draw(tc, chance(40)), false)
+}
