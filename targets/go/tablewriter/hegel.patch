+func TestHegelStreamedGlobalWidthLaysOutTheSameWay(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	cases := hegel.Filter(hegel.Composite(func(tc hegel.TestCase) streamCase {
+		s := hegel.Draw(tc, cleanStreams)
+		s.merging = merging{}
+		r := hegel.Draw(tc, cleanRends)
+		l := r.layout()
+		widths, n, _ := s.scaledWidths(l)
+		if n < 2 {
+			return streamCase{s: s, r: r}
+		}
+		sum := 0
+		for _, w := range widths {
+			sum += w
+		}
+		sepW := 0
+		if l.betweenCols {
+			sepW = w0(l.sym.Column())
+		}
+		total := sum + (n-1)*sepW
+		lo := n*(padsOf(s.tableSpec)+3) + (n-1)*sepW
+		if lo <= total-1 {
+			s.global = hegel.Draw(tc, hegel.Integers(lo, total-1))
+		}
+		return streamCase{s: s, r: r}
+	}), func(k streamCase) bool {
+		if k.s.global == 0 {
+			return false
+		}
+		widths, n, spread := k.s.scaledWidths(k.r.layout())
+		if n < 2 || !spread {
+			return false
+		}
+		for _, w := range widths {
+			if w < padsOf(k.s.tableSpec)+3 {
+				return false
+			}
+		}
+		return true
+	})
+	shapeProperty(t, "tablewriter/39", func(ht *hegel.T) {
+		k := hegel.Draw(ht, cases)
+		for i := 0; i < globalReps; i++ {
+			checkStream(c, ht, k)
+		}
+	})
+}
+
+// tablewriter/40: a streamed row of 0 to 1 lead cells, a run of 2 to 3 equal cells and 0 to 1
+// more, under MergeHorizontal on the rows (MergeBoth takes another path that copies the row),
+// the header and the other rows exactly as wide (a row the stream pads to the column count is
+// a copy too), StrictColumns off: the wide checks of TestHegelStream (the caller's cells
+// first).
+func TestHegelStreamedRowMergesLeaveTheCallersRowAlone(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	cases := hegel.Composite(func(tc hegel.TestCase) streamCase {
+		s := hegel.Draw(tc, cleanStreams)
+		row := hegel.Draw(tc, many(cleanCellTexts, 0, 1))
+		row = append(row, repeat(hegel.Draw(tc, streamRunCells), hegel.Draw(tc, spans))...)
+		row = append(row, hegel.Draw(tc, many(cleanCellTexts, 0, 1))...)
+		rows := append([][]string(nil), s.rows...)
+		rows[hegel.Draw(tc, positions)%len(rows)] = row
+		s.rows = rows
+		s = widenTo(tc, s, len(row), true)
+		s.order = hegel.Draw(tc, headerFirstOrders)
+		s.strict = false
+		s.merging = merging{merge: [3]int{0, tw.MergeHorizontal, 0}}
+		return streamCase{s: s, r: hegel.Draw(tc, cleanRends)}
+	})
+	shapeProperty(t, "tablewriter/40", func(ht *hegel.T) {
+		checkStream(c, ht, hegel.Draw(ht, cases))
+	})
+}
