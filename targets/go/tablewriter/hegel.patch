+package hegel
+
+// Pins: one test per recorded bug, asserting the documented behaviour. They fail while the bug
+// exists (listed in target.toml [expected_failures]) and pass once it is fixed.
+
+import (
+	"bytes"
+	"database/sql"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+)
+
+// 1: SetWidth on a Tabinal (SetTabWidth on the global one) before its first Size() is
+// overwritten by the detection Size() runs once.
+func TestHegelPinTabWidthSetBeforeUse(t *testing.T) {
+	var tb twwidth.Tabinal
+	tb.SetWidth(3)
+	if got := tb.Size(); got != 3 {
+		t.Fatalf("Tabinal.SetWidth(3) then Size() = %d, want 3 (the detection ran over the set width)", got)
+	}
+}
+
+// 2: the width cache is not purged by SetTabWidth, so a cached width of a string holding a tab
+// is stale after the tab width changes.
+func TestHegelPinTabWidthCache(t *testing.T) {
+	defer func() {
+		twwidth.SetTabWidth(tabW)
+		setOpts(widthOpts{ea: true})
+		setOpts(widthOpts{})
+	}()
+	setOpts(widthOpts{ea: true})
+	setOpts(widthOpts{})
+	twwidth.SetTabWidth(4)
+	if got := twwidth.Width("a\tb"); got != 6 {
+		t.Fatalf("Width(a<tab>b) with tab width 4 = %d, want 6", got)
+	}
+	twwidth.SetTabWidth(8)
+	got, want := twwidth.Width("a\tb"), twwidth.WidthNoCache("a\tb")
+	if got != want {
+		t.Fatalf("after SetTabWidth(8): Width(a<tab>b) = %d, WidthNoCache = %d", got, want)
+	}
+}
+
+// 3: Width sums rune widths, so an emoji sequence (VS16, ZWJ, flags, modifiers) differs from
+// displaywidth's width of the string.
+func TestHegelPinWidthEmojiSequence(t *testing.T) {
+	setOpts(widthOpts{})
+	for _, s := range emojiPieces {
+		if got, want := twwidth.Width(s), displaywidth.String(s); got != want {
+			t.Fatalf("Width(%q) = %d, displaywidth.String = %d", s, got, want)
+		}
+	}
+}
+
+// 4: Truncate restarts its scan at every ESC, so the ST terminator of an OSC sequence (a
+// hyperlink) opens a sequence that never ends and swallows the rest of the string.
+func TestHegelPinTruncateHyperlink(t *testing.T) {
+	setOpts(widthOpts{})
+	link := esc + "]8;;http://x" + esc + "\\" + "link" + esc + "]8;;" + esc + "\\" + " more text"
+	got := twwidth.Truncate(link, 6)
+	if vis := stripSeq(got); vis != "link m" {
+		t.Fatalf("Truncate(hyperlink + text, 6) = %q, visible %q, want visible %q", got, vis, "link m")
+	}
+}
+
+// 5: documented "If maxWidth is zero and a suffix is provided, the suffix is returned".
+func TestHegelPinTruncateZeroSuffix(t *testing.T) {
+	setOpts(widthOpts{})
+	if got := twwidth.Truncate("hello", 0, "..."); got != "..." {
+		t.Fatalf("Truncate(hello, 0, ...) = %q, want the suffix", got)
+	}
+}
+
+// 6: WrapStringWithSpaces slices the core content one byte after the start of the last
+// non-space rune, so a multi-byte last rune is measured as one column and the limit returned
+// is too small for the lines.
+func TestHegelPinWrapSpacesTrailingRune(t *testing.T) {
+	setOpts(widthOpts{})
+	lines, lim := twwarp.WrapStringWithSpaces("a あ", 1)
+	for _, l := range lines {
+		if twwidth.Width(l) > lim {
+			t.Fatalf("WrapStringWithSpaces(%q, 1) = %q, limit %d: line %q is wider", "a あ", lines, lim, l)
+		}
+	}
+}
+
+// 7: BreakPoint measures every rune alone, so the characters of an escape sequence count as
+// visible and a coloured line is broken inside its sequence.
+func TestHegelPinBreakPointEscapes(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[31mabc"
+	if got := tw.BreakPoint(s, 2); got != 7 {
+		t.Fatalf("BreakPoint(%q, 2) = %d, want 7 (ESC[31m takes no width; ab fit)", s, got)
+	}
+}
+
+// 8: SplitCamelCase drops a lone underscore group but keeps groups of several underscores.
+func TestHegelPinCamelUnderscoreGroups(t *testing.T) {
+	got := tw.SplitCamelCase("a__b")
+	if strings.Join(got, "|") != "a|b" {
+		t.Fatalf("SplitCamelCase(a__b) = %q, want [a b]", got)
+	}
+}
+
+// --------------------------------------------------------------------------- table
+
+func renderWith(r tw.Renderer, header []string, rows [][]string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	t.Render()
+	return buf.String()
+}
+
+// 9: the Markdown renderer writes a | inside a cell unescaped, splitting the cell for every
+// Markdown parser.
+func TestHegelPinMarkdownPipe(t *testing.T) {
+	out := renderWith(renderer.NewMarkdown(), []string{"a"}, [][]string{{"x|y"}})
+	if !strings.Contains(out, "x\\|y") {
+		t.Fatalf("Markdown of a cell x|y:\n%s\nwant the pipe escaped as \\|", out)
+	}
+}
+
+// 10: a cell holding a newline is split into visual lines before the renderers see it, so
+// Markdown gets an extra table row and HTML an extra <tr> (and one <thead> per header line);
+// the renderers' <br> handling is never reached.
+func TestHegelPinMultilineRows(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if n := strings.Count(md, "\n"); n != 3 {
+		t.Fatalf("Markdown of one record with a two-line cell has %d lines, want 3 (header, separator, one row):\n%s", n, md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if strings.Count(h, "<tr") != 2 || !strings.Contains(h, "<br>") {
+		t.Fatalf("HTML of one record with a two-line cell:\n%s\nwant one body <tr> with a <br>", h)
+	}
+}
+
+// 11: AutoHide zeroes the widths of columns that are empty in every row; the Blueprint
+// renderer drops them, the Markdown and HTML renderers render them.
+func TestHegelPinAutoHideRenderers(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(md, "A") {
+		t.Fatalf("Markdown with AutoHide still shows the empty column A:\n%s", md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(h, ">A<") {
+		t.Fatalf("HTML with AutoHide still shows the empty column A:\n%s", h)
+	}
+}
+
+// 12: WithColumnMax is documented as a maximum column width but is shared by the columns
+// (minus the separators); with two columns and 8, each gets 3, its content 1, and WrapTruncate
+// (Truncate at width 0 with the ellipsis) empties the cell.
+func TestHegelPinColumnMaxTruncate(t *testing.T) {
+	out := renderWith(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)}), []string{"a", "b"},
+		[][]string{{"hello world foo bar", "y"}}, tablewriter.WithColumnMax(8), tablewriter.WithRowAutoWrap(tw.WrapTruncate))
+	if !strings.Contains(out, "hello") {
+		t.Fatalf("WithColumnMax(8) with WrapTruncate on a two-column table:\n%s\nwant the first cell truncated to 8 columns, not emptied", out)
+	}
+}
+
+// --------------------------------------------------------------------------- blueprint
+
+func asciiBlueprint() tw.Renderer {
+	return renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)})
+}
+
+func renderFull(r tw.Renderer, header []string, rows [][]string, footer []string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	if footer != nil {
+		t.Footer(footer)
+	}
+	t.Render()
+	return buf.String()
+}
+
+func sameLineWidths(out string) bool {
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	for _, l := range lines {
+		if twwidth.Width(l) != twwidth.Width(lines[0]) {
+			return false
+		}
+	}
+	return true
+}
+
+// 13: with AlignNone (or the empty alignment) the Blueprint renderer computes the section's
+// default position (header centre, footer right) and then overwrites it with the cell's
+// AlignNone, so formatCell falls to left alignment in every section.
+func TestHegelPinAlignNoneDefaults(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "bbbbb"}, [][]string{{"1", "2"}}, []string{"f", "ggggg"},
+		tablewriter.WithHeaderAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}),
+		tablewriter.WithFooterAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}))
+	if !strings.Contains(out, "|  A  |") {
+		t.Fatalf("Blueprint with the header alignment AlignNone:\n%s\nwant the header cell A centred (the section's default)", out)
+	}
+}
+
+// 14: the rows' top border is drawn only when the table has neither header nor footer, and
+// the footer's only when there is nothing above it, so a table with rows and a footer but no
+// header starts with a row line, without a top border.
+func TestHegelPinTopBorderFooterOnly(t *testing.T) {
+	out := renderFull(asciiBlueprint(), nil, [][]string{{"1", "2"}}, []string{"f", "g"})
+	if !strings.HasPrefix(out, "+") {
+		t.Fatalf("Blueprint of rows and a footer without a header:\n%s\nwant a top border as the first line", out)
+	}
+}
+
+// 15: renderLine draws the separator before a column only when the previous column's width
+// is positive, so a column hidden by AutoHide (width 0) takes the separator of the column
+// after it with it.
+func TestHegelPinAutoHideSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b", "c"}, [][]string{{"1", "", "3"}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !strings.Contains(out, "| 1 | 3 |") {
+		t.Fatalf("Blueprint with the middle column hidden by AutoHide:\n%s\nwant the row line | 1 | 3 |", out)
+	}
+}
+
+// 16: when AutoHide hides every column the border lines are drawn without their right glyph
+// (no visible column) but the cell lines keep both column glyphs.
+func TestHegelPinAutoHideAllColumns(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, [][]string{{"", ""}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !sameLineWidths(out) {
+		t.Fatalf("Blueprint with every column hidden by AutoHide renders lines of different widths:\n%q", out)
+	}
+}
+
+// 17: with a header and a footer but no rows the header separator and the footer separator
+// are both drawn, two identical lines.
+func TestHegelPinHeaderFooterSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, nil, []string{"f", "g"})
+	if n := strings.Count(out, "+---+---+\n"); n != 3 {
+		t.Fatalf("Blueprint of a header and a footer without rows has %d border lines, want 3 (top, one separator, bottom):\n%s", n, out)
+	}
+}
+
+// 18: a record without cells still counts as a row line, so a table holding only such a
+// record renders two ++ lines where a table without records renders nothing.
+func TestHegelPinEmptyRecord(t *testing.T) {
+	got := renderFull(asciiBlueprint(), nil, [][]string{{}}, nil)
+	if want := renderFull(asciiBlueprint(), nil, nil, nil); got != want {
+		t.Fatalf("Blueprint of a single empty record = %q, want %q (as with no record)", got, want)
+	}
+}
+
+// 19: header AutoFormat (on by default) passes the cell through SplitCamelCase and Title,
+// which split and upper-case the escape sequences of a coloured header, so the terminal
+// prints them as text.
+func TestHegelPinAutoFormatEscapes(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{esc + "[31mred" + esc + "[0m"}, [][]string{{"1"}}, nil)
+	if !strings.Contains(out, esc+"[31m") {
+		t.Fatalf("Blueprint of a coloured header:\n%q\nwant the escape sequence ESC[31m intact", out)
+	}
+}
+
+// 20: Truncate's scan ends a CSI sequence at any final byte, Width's Filter requires the
+// parameters before the intermediates, so on a sequence such as ESC[ 31 m (an intermediate
+// first) Truncate keeps text that Width counts, and the result is wider than the limit.
+func TestHegelPinTruncateIntermediate(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[ 31 mRED"
+	got := twwidth.Truncate(s, 2)
+	if w := twwidth.Width(got); w > 2 {
+		t.Fatalf("Truncate(%q, 2) = %q, whose Width is %d, want at most 2", s, got, w)
+	}
+}
+
+// 21: Line takes the excess width of both corner glyphs over the column glyph off the first and
+// last column, so with StyleGraphical (two-cell corners) a lone one-cell column gives border
+// lines one cell wider than the cell lines.
+func TestHegelPinGraphicalNarrowColumn(t *testing.T) {
+	out := renderFull(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleGraphical)}), []string{"a"}, [][]string{{"x"}}, nil, tablewriter.WithPadding(tw.PaddingNone))
+	if !sameLineWidths(out) {
+		t.Fatalf("StyleGraphical with a one-cell column renders lines of different widths:\n%s", out)
+	}
+}
+
+// --------------------------------------------------------------------------- widths, caption
+
+// 22: Caption() and printTopBottomCaption treat AlignLeft as "unset" (tw.AlignDefault is
+// AlignLeft) and replace it by the spot's default, so a left-aligned caption cannot be asked
+// for on a centre or right spot.
+func TestHegelPinCaptionAlignLeft(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(asciiBlueprint()))
+	tb.Caption(tw.Caption{Text: "Table 1", Spot: tw.SpotBottomCenter, Align: tw.AlignLeft})
+	tb.Header([]string{"aaaaaaaaaa", "bbbbbbbbbb"})
+	tb.Append([]string{"1", "2"})
+	tb.Render()
+	if !strings.Contains(buf.String(), "\nTable 1") {
+		t.Fatalf("caption with Align left on a bottom-centre spot:\n%s\nwant the caption at the left edge", buf.String())
+	}
+}
+
+// 23: with a caption, an empty table whose renderer has a top or bottom border is replaced by
+// hard-coded +--+ lines whatever the border style.
+func TestHegelPinCaptionEmptyTable(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleLight)})))
+	tb.Caption(tw.Caption{Text: "Table 1", Spot: tw.SpotTopCenter})
+	tb.Render()
+	if strings.Contains(buf.String(), "+--+") {
+		t.Fatalf("caption on an empty table in the Light style:\n%s\nwant no ASCII +--+ placeholder", buf.String())
+	}
+}
+
+// 24: WithMaxWidth ("a global maximum table width") only derives a per-column wrapping width
+// of MaxWidth/columns, which the word wrapper raises to the longest word and which leaves the
+// padding, separators and borders uncounted, so the table is wider than the maximum.
+func TestHegelPinMaxWidthTable(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, [][]string{{"abcdefgh ijklmnop", "abcdefgh ijklmnop"}}, nil, tablewriter.WithMaxWidth(20))
+	for _, l := range strings.Split(strings.TrimSuffix(out, "\n"), "\n") {
+		if w := twwidth.Width(l); w > 20 {
+			t.Fatalf("WithMaxWidth(20):\n%s\nline %q is %d wide", out, l, w)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- input conversion
+
+func autoHeaderTable(buf *bytes.Buffer) *tablewriter.Table {
+	tb := tablewriter.NewTable(buf, tablewriter.WithRenderer(renderer.NewMarkdown()), tablewriter.WithHeaderAutoFormat(tw.Off))
+	tb.Configure(func(cfg *tablewriter.Config) { cfg.Behavior.Structs.AutoHeader = tw.On })
+	return tb
+}
+
+// 25: convertToString has no case for pointers, so a *int or *string (a nullable column in a
+// struct) falls to fmt.Sprintf("%v") and renders as an address.
+func TestHegelPinPointerCells(t *testing.T) {
+	n := 42
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{&n})
+	tb.Render()
+	if !strings.Contains(buf.String(), "| 42 |") {
+		t.Fatalf("Append of a *int cell:\n%s\nwant the pointed-to value 42", buf.String())
+	}
+}
+
+// 26: a typed nil pointer whose String() or Error() dereferences (a nil *time.Time field) is
+// called through the fmt.Stringer/error cases and panics.
+func TestHegelPinNilStringerPanics(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Append of a struct with a nil *time.Time field panicked: %v", r)
+		}
+	}()
+	type row struct {
+		Name string
+		At   *time.Time
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Append(row{Name: "a"})
+	tb.Render()
+}
+
+// 27: convertToString handles sql.NullString/NullInt64/NullFloat64/NullBool/NullTime but not
+// sql.NullInt32, NullInt16 and NullByte, which print as {5 true}.
+func TestHegelPinNullInt32(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{sql.NullInt32{Int32: 5, Valid: true}, sql.NullInt32{}})
+	tb.Render()
+	if got := buf.String(); !strings.Contains(got, "| 5 |") || strings.Contains(got, "true") {
+		t.Fatalf("Append of sql.NullInt32 cells:\n%s\nwant 5 and an empty cell", got)
+	}
+}
+
+// 28: a []byte appended as the row is the []uint8 case, one numeric cell per byte, though
+// the code says a []byte is handled as a string (as it is inside a []any).
+func TestHegelPinByteSliceRow(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]byte("ab"))
+	tb.Render()
+	if !strings.Contains(buf.String(), "| ab |") {
+		t.Fatalf("Append of a []byte row:\n%s\nwant the cell ab", buf.String())
+	}
+}
+
+// 29: an io.Reader cell reads up to 512 bytes and appends the ellipsis when 512 were read,
+// so a reader of exactly 512 bytes is marked truncated.
+func TestHegelPinReaderEllipsis(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{strings.NewReader(strings.Repeat("x", 512))})
+	tb.Render()
+	if strings.Contains(buf.String(), tw.CharEllipsis) {
+		t.Fatalf("Append of a 512-byte reader:\n%s\nwant no ellipsis, nothing was cut", buf.String())
+	}
+}
+
+// 30: a nil embedded struct pointer contributes no columns, so AutoHeader taken from such a
+// row lacks the embedded fields and later rows with the pointer set are misaligned.
+func TestHegelPinEmbeddedNilPointer(t *testing.T) {
+	type outer struct {
+		*Inner1
+		C string
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Bulk([]outer{{C: "c1"}, {Inner1: &Inner1{X: "x", Y: 1}, C: "c2"}})
+	tb.Render()
+	lines := strings.Split(strings.TrimSuffix(buf.String(), "\n"), "\n")
+	if len(lines) != 4 || !strings.Contains(lines[0], "X") || !strings.Contains(lines[3], "| x") {
+		t.Fatalf("Bulk with a nil embedded pointer in the first row:\n%s\nwant three columns X, Y, C with the second row x, 1, c2 under them", buf.String())
+	}
+}
+
+// 31: a value without exported fields appended alone (an error, a *strings.Reader) is
+// reflected as a struct of zero fields and becomes an empty row, where the same value inside a
+// []any is its text.
+func TestHegelPinSingleErrorRow(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append(errors.New("boom"))
+	tb.Render()
+	if !strings.Contains(buf.String(), "boom") {
+		t.Fatalf("Append of an error alone:\n%q\nwant the row boom", buf.String())
+	}
+}
+
+// 32: extractHeadersFromStruct converts the values too, so AutoHeader reads the first row's
+// io.Reader fields before Append reads them again, and the cell holds only what was left.
+func TestHegelPinAutoHeaderReader(t *testing.T) {
+	type row struct {
+		Data io.Reader
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Append(row{Data: strings.NewReader("hello")})
+	tb.Render()
+	if !strings.Contains(buf.String(), "hello") {
+		t.Fatalf("AutoHeader over a struct with an io.Reader field:\n%s\nwant the cell hello", buf.String())
+	}
+}
+
+// 33: above a horizontally merged header cell the top border's junction with the next column
+// is the row glyph, since the junction rule asks whether the merge's first column ends the
+// merge rather than whether the next column continues it; the header line has its separator
+// there.
+func TestHegelPinTopBorderAfterMergedHeader(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "A", "B"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal))
+	lines := strings.Split(out, "\n")
+	if len(lines) < 2 {
+		t.Fatalf("merged header table:\n%s", out)
+	}
+	sep := strings.LastIndex(lines[1], "|")
+	sep = strings.LastIndex(lines[1][:sep], "|") // the separator between the merged cell and B
+	if sep < 0 || sep >= len(lines[0]) || lines[0][sep] != '+' {
+		t.Fatalf("merged header table:\n%s\nwant a + in the top border above the separator at column %d", out, sep)
+	}
+}
+
+// 34: applyHorizontalMerges sizes a merged header cell by the natural widths of its columns
+// before AutoHide zeroes the hidden ones, so the header line is wider than the rows.
+func TestHegelPinMergedHeaderHiddenColumn(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "A", "B"}, [][]string{{"1", "", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal), tablewriter.WithAutoHide(tw.On))
+	if !sameLineWidths(out) {
+		t.Fatalf("merged header over a hidden column:\n%s\nwant every line as wide as the others", out)
+	}
+}
+
+// 35: the footer's lead merge moves the first content cell to the first column on the first
+// visual line only and blanks the merged columns on the others, dropping the later lines of a
+// multi-line cell.
+func TestHegelPinFooterLeadMergeLines(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, []string{"", "Total\nSum", "5"}, tablewriter.WithFooterMergeMode(tw.MergeHorizontal))
+	if !strings.Contains(out, "Sum") {
+		t.Fatalf("footer lead merge of a two-line cell:\n%s\nwant its second line Sum rendered", out)
+	}
+}
+
+// streamTable renders through Start/Header/Append/Footer/Close with the ASCII Blueprint.
+func streamTable(header []string, rows [][]string, footer []string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	all := append([]tablewriter.Option{tablewriter.WithRenderer(asciiBlueprint()), tablewriter.WithStreaming(tw.StreamConfig{Enable: true})}, opts...)
+	t := tablewriter.NewTable(&buf, all...)
+	if err := t.Start(); err != nil {
+		return "start: " + err.Error()
+	}
+	if header != nil {
+		t.Header(header)
+	}
+	for _, r := range rows {
+		t.Append(r)
+	}
+	if footer != nil {
+		t.Footer(footer)
+	}
+	t.Close()
+	return buf.String()
+}
+
+// 36: in streaming the header's horizontal merges are detected (the top border spans them)
+// but renderLine sizes a header merge by its first column's width alone (the merged widths
+// applyHorizontalMerges computes in batch mode are never set), so the header line is narrower
+// than the borders.
+func TestHegelPinStreamHeaderMerge(t *testing.T) {
+	out := streamTable([]string{"A", "A", "B"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal))
+	if !sameLineWidths(out) {
+		t.Fatalf("streamed table with a merged header:\n%s\nwant every line as wide as the others", out)
+	}
+}
+
+// 37: Start() says only horizontal merges are considered in streaming, but the footer's are
+// not: streamStoreFooter never calls prepareWithMerges and streamRenderFooter passes nil
+// merge states, so a footer "", "Total", "5" under MergeHorizontal keeps three cells.
+func TestHegelPinStreamFooterMerge(t *testing.T) {
+	out := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, []string{"x", "x", "5"}, tablewriter.WithFooterMergeMode(tw.MergeHorizontal))
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	footer := lines[len(lines)-2]
+	if strings.Count(footer, "x") != 1 {
+		t.Fatalf("streamed table with a merged footer:\n%s\nwant the footer's two x cells merged into one", out)
+	}
+}
+
+// 38: an empty row appended first is skipped but marks the first row as rendered, so the
+// header separator is never drawn.
+func TestHegelPinStreamEmptyFirstRow(t *testing.T) {
+	out := streamTable([]string{"A", "B"}, [][]string{{}, {"1", "2"}}, nil)
+	want := streamTable([]string{"A", "B"}, [][]string{{"1", "2"}}, nil)
+	if out != want {
+		t.Fatalf("streamed table with an empty first row:\n%s\nwant the same as without it:\n%s", out, want)
+	}
+}
+
+// 39: the Widths.Global shrink rounds every column and spreads the remainder one by one over
+// the columns in the order Mapper.Each iterates the map, so the same table lays out
+// differently from run to run.
+func TestHegelPinStreamGlobalWidthRandom(t *testing.T) {
+	first := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithColumnMax(16))
+	for i := 0; i < 40; i++ {
+		out := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithColumnMax(16))
+		if out != first {
+			t.Fatalf("streamed table under WithColumnMax(16) rendered two ways:\n%s\n%s", first, out)
+		}
+	}
+}
diff --git a/hegel/hegel_stream_test.go b/hegel/hegel_stream_test.go
new file mode 100644
index 0000000..0337884
--- /dev/null
+++ b/hegel/hegel_stream_test.go
@@ -0,0 +1,495 @@
+package hegel
+
+// Streaming (Start/Header/Append/Footer/Close) against an exact model: the column count and
+// the fixed widths come from Widths.PerColumn, else from the first section seen (its trimmed
+// cells' widths plus two plus the padding, at least eight), shrunk to Widths.Global; every later
+// row is padded or cut to the column count (or refused under StrictColumns); the cells wrap to
+// the fixed width; the borders and separators are drawn as the sections arrive, the footer at
+// Close.
+
+import (
+	"bytes"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	orderHRF = iota // Header, rows, Footer
+	orderHFR        // Header, Footer, rows
+	orderFHR        // Footer, Header, rows
+)
+
+type streamSpec struct {
+	tableSpec
+	global int  // WithColumnMax (Widths.Global); 0: none
+	strict bool // StreamConfig.StrictColumns
+	order  int
+}
+
+func genStreamSpec(tc hegel.TestCase) streamSpec {
+	s := streamSpec{tableSpec: genTableSpec(tc)}
+	s.htmlCfg = nil
+	s.autoHide = false // ignored in streaming (Start warns)
+	s.padding = pick(tc, paddingChoices)
+	if chance(tc, 30) {
+		for sec := range s.wrap {
+			if chance(tc, 50) {
+				s.wrap[sec] = pick(tc, wrapChoices)
+			}
+		}
+	}
+	if chance(tc, 30) {
+		s.colWidths = map[int]int{}
+		n := drawInt(tc, 1, 3)
+		for i := 0; i < n; i++ {
+			s.colWidths[drawInt(tc, 0, 3)] = pick(tc, []int{0, 1, 2, 3, 5, 8, 12, -1})
+		}
+	}
+	if chance(tc, 30) {
+		s.global = drawInt(tc, 1, 40)
+	}
+	if chance(tc, 20) {
+		s.secMax[secRow] = drawInt(tc, 1, 12) // ignored in streaming
+	}
+	if chance(tc, 20) {
+		s.maxWidth = drawInt(tc, 1, 30) // ignored in streaming
+	}
+	if chance(tc, 30) {
+		s.merge[secHeader] = pick(tc, []int{tw.MergeHorizontal, tw.MergeBoth})
+	}
+	if chance(tc, 40) {
+		s.merge[secRow] = pick(tc, []int{tw.MergeHorizontal, tw.MergeBoth, tw.MergeVertical, tw.MergeHierarchical})
+	}
+	if chance(tc, 30) {
+		s.merge[secFooter] = pick(tc, []int{tw.MergeHorizontal, tw.MergeBoth})
+	}
+	if chance(tc, 30) {
+		s.header = []string{"a", "a", pick(tc, tableCells)} // equal neighbours for the merges
+	}
+	if chance(tc, 30) && len(s.rows) > 0 {
+		s.rows[0] = []string{pick(tc, tableCells), "b", "b"}
+	}
+	if chance(tc, 30) && s.footer != nil {
+		s.footer = []string{"", "Total", pick(tc, tableCells)}
+	}
+	// Header()/Footer() return at once when hidden by the Control, as if never called
+	if s.hideHeader {
+		s.header = nil
+	}
+	if s.hideFooter {
+		s.footer = nil
+	}
+	s.strict = chance(tc, 20)
+	s.order = pick(tc, []int{orderHRF, orderHRF, orderHFR, orderFHR})
+	return s
+}
+
+func (s streamSpec) String() string {
+	return s.tableSpec.String() + " global=" + itoa(s.global) + " strict=" + boolStr(s.strict) + " order=" + itoa(s.order)
+}
+
+// streamOut renders the spec through the streaming API; the errors Append returns are noted.
+func (s streamSpec) streamOut(r tw.Renderer) (string, int, error) {
+	var buf bytes.Buffer
+	opts := s.options(r)
+	opts = append(opts, tablewriter.WithStreaming(tw.StreamConfig{Enable: true, StrictColumns: s.strict}))
+	if s.global > 0 {
+		opts = append(opts, tablewriter.WithColumnMax(s.global))
+	}
+	t := tablewriter.NewTable(&buf, opts...)
+	if err := t.Start(); err != nil {
+		return "", 0, err
+	}
+	refused := 0
+	rows := func() {
+		for _, row := range s.rows {
+			if err := t.Append(row); err != nil {
+				refused++
+			}
+		}
+	}
+	switch s.order {
+	case orderHRF:
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		rows()
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+	case orderHFR:
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+		rows()
+	default:
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		rows()
+	}
+	err := t.Close()
+	return buf.String(), refused, err
+}
+
+// streamWidths is the model of Start and streamCalculateWidths: Widths.PerColumn (negatives
+// dropped by the option) fixes the count and the widths, missing columns 0; else the first
+// section with cells (in call order) is the sample: each trimmed cell's width (at least the
+// ellipsis's under WrapTruncate) plus two plus the padding, at least MinimumColumnWidth; then
+// Widths.Global shrinks the widths in proportion when the table (separators included) is
+// wider, the rounding remainder spread one by one over the columns, in map order (bug 39: when
+// Known.scaleRemainderRandom, the model gives up on a remainder).
+// It returns the widths, the count and whether the remainder was random.
+func (s streamSpec) streamWidths(l layout) ([]int, int, bool) {
+	if s.constrained() {
+		n := 0
+		for k, w := range s.colWidths {
+			if w >= 0 && k+1 > n {
+				n = k + 1
+			}
+		}
+		widths := make([]int, n)
+		for k, w := range s.colWidths {
+			if w >= 0 {
+				widths[k] = w
+			}
+		}
+		return widths, n, false
+	}
+	var sample []string
+	sec := -1
+	sections := [][2]int{}
+	switch s.order {
+	case orderHRF:
+		sections = append(sections, [2]int{secHeader, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+		sections = append(sections, [2]int{secFooter, 0})
+	case orderHFR:
+		sections = append(sections, [2]int{secHeader, 0}, [2]int{secFooter, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+	default:
+		sections = append(sections, [2]int{secFooter, 0}, [2]int{secHeader, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+	}
+	for _, sc := range sections {
+		var cells []string
+		switch sc[0] {
+		case secHeader:
+			cells = s.header
+		case secRow:
+			cells = s.rows[sc[1]]
+		default:
+			cells = s.footer
+		}
+		if len(cells) > 0 {
+			sample, sec = cells, sc[0]
+			break
+		}
+	}
+	if sample == nil {
+		return nil, 0, false
+	}
+	n := len(sample)
+	pads := w0(s.pad().Left) + w0(s.pad().Right)
+	widths := make([]int, n)
+	for i, c := range sample {
+		cw := w0(s.trim(c))
+		if s.wrapMode(sec) == tw.WrapTruncate && cw < w0(tw.CharEllipsis) {
+			cw = w0(tw.CharEllipsis)
+		}
+		w := cw + 2 + pads
+		if w > 0 && w < tw.MinimumColumnWidth {
+			w = tw.MinimumColumnWidth
+		}
+		widths[i] = w
+	}
+	random := false
+	if s.global > 0 {
+		sum := 0
+		for _, w := range widths {
+			sum += w
+		}
+		sepW := 0
+		if l.betweenCols {
+			sepW = w0(l.sym.Column())
+		}
+		total := sum
+		if n > 1 {
+			total += (n - 1) * sepW
+		}
+		if s.global < total && total > 0 {
+			target := s.global
+			if n > 1 {
+				target -= (n - 1) * sepW
+			}
+			if target < n {
+				target = n
+			}
+			scale := float64(target) / float64(sum)
+			adjusted := 0
+			var nonzero []int
+			for i, w := range widths {
+				if w == 0 {
+					continue
+				}
+				sw := int(math.Round(float64(w) * scale))
+				if sw < 1 {
+					sw = 1
+				}
+				widths[i] = sw
+				adjusted += sw
+				nonzero = append(nonzero, i)
+			}
+			remaining := target - adjusted
+			if remaining != 0 && len(nonzero) > 0 {
+				if len(nonzero) > 1 && Known.scaleRemainderRandom {
+					random = true
+				}
+				// in ascending column order (the map order is random, bug 39)
+				for i := 0; i < int(math.Abs(float64(remaining))); i++ {
+					if remaining > 0 {
+						widths[nonzero[i%len(nonzero)]]++
+					} else {
+						reduced := false
+						for j := 0; j < len(nonzero); j++ {
+							c := nonzero[(i+j)%len(nonzero)]
+							if widths[c] > 1 {
+								widths[c]--
+								reduced = true
+								break
+							}
+						}
+						if !reduced {
+							break
+						}
+					}
+				}
+			}
+		}
+	}
+	return widths, n, random
+}
+
+// fit pads or cuts a section's cells to the stream's column count.
+func fit(cells []string, n int) []string {
+	if len(cells) >= n {
+		return cells[:n]
+	}
+	return padLine(cells, n)
+}
+
+// streamModel is the model of the whole streamed rendering. It returns the output, the count
+// of rows Append refuses under StrictColumns, and whether the case is beyond the model.
+func (s streamSpec) streamModel(r rendSpec) (string, int, bool) {
+	l := r.layout()
+	widths, n, random := s.streamWidths(l)
+	if random {
+		return "", 0, false
+	}
+	if n == 0 {
+		return "", 0, true // nothing established: Close draws nothing
+	}
+	pads := w0(s.pad().Left) + w0(s.pad().Right)
+	contentMax := func(i int) int {
+		w := max(widths[i], 0)
+		eff := w - pads
+		if eff < 1 && w > pads {
+			eff = 1
+		} else if eff < 0 {
+			eff = 0
+		}
+		if w == 0 {
+			eff = 0
+		}
+		return eff
+	}
+	m := tableModel{numCols: n, widths: widths, natural: widths, hidden: make([]bool, n)}
+	for i, w := range widths {
+		m.hidden[i] = w == 0
+	}
+	zero := make([]cellMerge, n)
+	var b strings.Builder
+	lastPos := -1 // -1 nothing, secHeader/secRow/secFooter, 3 a separator
+	const sepPos = 3
+	var lastM []cellMerge
+	headerRendered, firstRowRendered, footerStored := false, false, false
+	var footerLines [][]string
+	var ftrM []cellMerge
+
+	// the prepared sections
+	var hdrLines [][]string
+	var hdrM []cellMerge
+	if len(s.header) > 0 {
+		cells := fit(s.header, n)
+		hdrLines = s.prepareWith(cells, secHeader, contentMax)
+		_, hdrM = s.hmerge([][]string{cells}, n, s.merge[secHeader], false)
+	}
+	storeFooter := func() {
+		if len(s.footer) == 0 {
+			return
+		}
+		cells := fit(s.footer, n)
+		footerLines = s.prepareWith(cells, secFooter, contentMax)
+		ftrM = zero
+		if !Known.streamFooterMergesIgnored {
+			footerLines, ftrM = s.hmerge(footerLines, n, s.merge[secFooter], true)
+		}
+		footerStored = len(footerLines) > 0
+	}
+	renderHeader := func() {
+		if len(s.header) == 0 {
+			return
+		}
+		if lastPos == -1 && l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secHeader, next: hdrM, widths: widths}))
+		}
+		hW := widths
+		if !Known.streamHeaderMergeWidth {
+			hW = m.mergedWidths(hdrM, l)
+		}
+		for _, line := range hdrLines {
+			b.WriteString(l.cellLine(m, s.tableSpec, line, secHeader, hdrM, hW))
+		}
+		lastPos, lastM = secHeader, hdrM
+		headerRendered = true
+		if l.showHeaderLine && (firstRowRendered || footerStored) {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secHeader, cur: hdrM, next: nil, widths: widths}))
+			lastPos, lastM = sepPos, nil
+		}
+	}
+	refused := 0
+	renderRows := func() {
+		for _, row := range s.rows {
+			if len(row) == 0 {
+				if Known.emptyRowSuppressesHeaderLine {
+					firstRowRendered = true
+				}
+				continue
+			}
+			if s.strict && len(row) != n {
+				refused++
+				continue
+			}
+			cells := fit(row, n)
+			lines := s.prepareWith(cells, secRow, contentMax)
+			// the merges are detected on the raw trimmed cells (before formatting and wrapping,
+			// unlike batch mode, which compares the prepared visual lines); the continuing
+			// cells keep their content, which the renderer never prints
+			_, recM := s.hmerge([][]string{cells}, n, s.merge[secRow], false)
+			if !headerRendered && !firstRowRendered && lastPos == -1 && l.top && l.showTop {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secRow, next: recM, widths: widths}))
+			}
+			headerSep := headerRendered && !firstRowRendered && l.showHeaderLine
+			rowSep := firstRowRendered && l.betweenRows
+			if (headerSep || rowSep) && lastPos != sepPos {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secRow, cur: lastM, next: recM, widths: widths}))
+				lastPos, lastM = sepPos, nil
+			}
+			for _, line := range lines {
+				b.WriteString(l.cellLine(m, s.tableSpec, line, secRow, recM, widths))
+			}
+			lastPos, lastM = secRow, recM
+			firstRowRendered = true
+		}
+	}
+	switch s.order {
+	case orderHRF:
+		renderHeader()
+		renderRows()
+		storeFooter()
+	case orderHFR:
+		renderHeader()
+		storeFooter()
+		renderRows()
+	default:
+		storeFooter()
+		renderHeader()
+		renderRows()
+	}
+	// Close: the footer, then the bottom border
+	if footerStored {
+		if lastPos != -1 && lastPos != secFooter && l.showFooterLine {
+			next := zero
+			if !Known.streamFooterMergesIgnored {
+				next = ftrM
+			}
+			b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locMiddle, pos: secFooter, cur: lastM, next: next, widths: widths}))
+			lastPos, lastM = sepPos, nil
+		}
+		fW := widths
+		if !Known.streamFooterMergesIgnored {
+			fW = m.mergedWidths(ftrM, l)
+		}
+		for _, line := range footerLines {
+			b.WriteString(l.cellLine(m, s.tableSpec, line, secFooter, ftrM, fW))
+		}
+		lastPos, lastM = secFooter, ftrM
+	}
+	if l.bottom && l.showBottom {
+		pos := lastPos
+		if pos == sepPos || pos == -1 {
+			pos = secRow // "separator" or "" is neither Row nor Header: no pre-footer rule applies
+		}
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: pos, cur: lastM, widths: widths}))
+	}
+	return b.String(), refused, true
+}
+
+// TestHegelStream: the streamed boxed rendering equals the model's.
+func TestHegelStream(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genStreamSpec(ht)
+		r := genRendSpec(ht)
+		want, wantRefused, ok := s.streamModel(r)
+		if !ok {
+			c.count("random remainder")
+			return
+		}
+		got, refused, err := s.streamOut(renderer.NewBlueprint(r.rendition()))
+		if err != nil {
+			c.failClass(ht, "error", "stream: %v for %s %s", err, s, r)
+			return
+		}
+		if want == "" {
+			c.count("nothing established")
+		}
+		s.classify(c)
+		c.count("order " + itoa(s.order))
+		if s.global > 0 {
+			c.count("global")
+		}
+		if s.colWidths != nil {
+			c.count("colWidths")
+		}
+		if refused > 0 {
+			c.count("refused rows")
+		}
+		if refused != wantRefused {
+			c.failClass(ht, "refused", "stream of %s %s: %d rows refused, want %d", s, r, refused, wantRefused)
+			return
+		}
+		if got != want {
+			c.failClass(ht, "stream", "stream of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+		}
+	})
+}
diff --git a/hegel/hegel_table_test.go b/hegel/hegel_table_test.go
new file mode 100644
index 0000000..c477da1
--- /dev/null
+++ b/hegel/hegel_table_test.go
@@ -0,0 +1,957 @@
+package hegel
+
+// The table's Markdown and HTML renderings against models of the documented pipeline: cells
+// trimmed (TrimSpace/TrimTab), tabs expanded, header/footer auto-formatted, split into visual
+// lines, column widths from the widest cell plus padding; Markdown cells padded to the column
+// width by the alignment rules (body explicit, else header, else centre) with a separator row
+// of at least three dashes; HTML sections with escaped cells and text-align styles.
+
+import (
+	"bytes"
+	"html"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var tableCells = []string{
+	"", "", "a", "Name", "userName", "first_name", "city.name", "v1.5", "25", "-3.5", "ID",
+	" x ", "\tt\t", "  ", "a|b", "x\ny", "x\n\ny", "<b>&\"q\"", "あい", "é", "long cell text",
+	esc + "[31mred" + esc + "[0m", "A__B", "1.5", ".", "_", "a  b",
+	"the quick brown fox jumps over", "supercalifragilistic", "ab cd  ef", "あいうえお かきくけこ",
+}
+
+var alignChoices = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+type tableSpec struct {
+	header     []string // nil: no header
+	rows       [][]string
+	footer     []string // nil: no footer
+	trimSpace  bool
+	trimTab    bool
+	autoFormat [3]bool // header, row, footer
+	align      [3]tw.CellAlignment
+	autoHide   bool
+	hideHeader bool
+	hideFooter bool
+	htmlCfg    *renderer.HTMLConfig
+	padding    *tw.Padding // WithPadding for every section; nil: the default one space each side
+	// width constraints and wrapping (part 4)
+	wrap      [3]int      // With{Header,Row,Footer}AutoWrap; 0 keeps the default (header truncate, else normal)
+	secMax    [3]int      // With{Header,Row,Footer}MaxWidth (ColMaxWidths.Global); 0: none
+	colWidths map[int]int // WithColumnWidths (Widths.PerColumn); nil: none
+	maxWidth  int         // WithMaxWidth; 0: none
+	caption   *tw.Caption // Caption(); nil: none
+	// cell merging (part 6)
+	merge     [3]int // With{Header,Row,Footer}MergeMode (rows above MergeHierarchical through Configure); 0: none
+	mergeCols []int  // Row.Merging.ByColumnIndex; nil: every column
+}
+
+func (s tableSpec) pad() tw.Padding {
+	if s.padding != nil {
+		return *s.padding
+	}
+	return tw.PaddingDefault
+}
+
+const (
+	secHeader = 0
+	secRow    = 1
+	secFooter = 2
+)
+
+func genCells(tc hegel.TestCase, n int) []string {
+	out := make([]string, n)
+	for i := range out {
+		out[i] = pick(tc, tableCells)
+	}
+	return out
+}
+
+func genAlignment(tc hegel.TestCase, def tw.Align) tw.CellAlignment {
+	if chance(tc, 50) {
+		return tw.CellAlignment{Global: def}
+	}
+	a := tw.CellAlignment{Global: pick(tc, alignChoices)}
+	if chance(tc, 40) {
+		n := drawInt(tc, 0, 4)
+		for i := 0; i < n; i++ {
+			a.PerColumn = append(a.PerColumn, pick(tc, alignChoices))
+		}
+	}
+	return a
+}
+
+func genTableSpec(tc hegel.TestCase) tableSpec {
+	s := tableSpec{trimSpace: true, trimTab: true, autoFormat: [3]bool{true, false, false}}
+	cols := drawInt(tc, 1, 4)
+	if chance(tc, 80) {
+		s.header = genCells(tc, drawInt(tc, 1, cols+1))
+	}
+	nrows := drawInt(tc, 0, 4)
+	for i := 0; i < nrows; i++ {
+		s.rows = append(s.rows, genCells(tc, drawInt(tc, 0, cols+1)))
+	}
+	if chance(tc, 40) {
+		s.footer = genCells(tc, drawInt(tc, 1, cols+1))
+	}
+	if chance(tc, 20) {
+		s.trimSpace = false
+	}
+	if chance(tc, 20) {
+		s.trimTab = false
+	}
+	for i := range s.autoFormat {
+		if chance(tc, 20) {
+			s.autoFormat[i] = !s.autoFormat[i]
+		}
+	}
+	s.align[secHeader] = genAlignment(tc, tw.AlignCenter)
+	s.align[secRow] = genAlignment(tc, tw.AlignLeft)
+	s.align[secFooter] = genAlignment(tc, tw.AlignRight)
+	s.autoHide = chance(tc, 20)
+	s.hideHeader = chance(tc, 10)
+	s.hideFooter = chance(tc, 10)
+	if chance(tc, 40) {
+		s.htmlCfg = &renderer.HTMLConfig{EscapeContent: chance(tc, 70), AddLinesTag: chance(tc, 30)}
+		if chance(tc, 50) {
+			s.htmlCfg.TableClass, s.htmlCfg.HeaderClass, s.htmlCfg.BodyClass = "t", "h", "b"
+			s.htmlCfg.FooterClass, s.htmlCfg.RowClass, s.htmlCfg.HeaderRowClass, s.htmlCfg.FooterRowClass = "f", "r", "hr", "fr"
+		}
+	}
+	return s
+}
+
+func state(b bool) tw.State {
+	if b {
+		return tw.On
+	}
+	return tw.Off
+}
+
+func (s tableSpec) options(r tw.Renderer) []tablewriter.Option {
+	var extra []tablewriter.Option
+	if s.padding != nil {
+		extra = append(extra, tablewriter.WithPadding(*s.padding))
+	}
+	if s.wrap[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderAutoWrap(s.wrap[secHeader]))
+	}
+	if s.wrap[secRow] != 0 {
+		extra = append(extra, tablewriter.WithRowAutoWrap(s.wrap[secRow]))
+	}
+	if s.wrap[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterAutoWrap(s.wrap[secFooter]))
+	}
+	if s.secMax[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderMaxWidth(s.secMax[secHeader]))
+	}
+	if s.secMax[secRow] != 0 {
+		extra = append(extra, tablewriter.WithRowMaxWidth(s.secMax[secRow]))
+	}
+	if s.secMax[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterMaxWidth(s.secMax[secFooter]))
+	}
+	if s.colWidths != nil {
+		m := tw.NewMapper[int, int]()
+		for k, v := range s.colWidths {
+			m.Set(k, v)
+		}
+		extra = append(extra, tablewriter.WithColumnWidths(m))
+	}
+	if s.maxWidth != 0 {
+		extra = append(extra, tablewriter.WithMaxWidth(s.maxWidth))
+	}
+	if s.merge[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderMergeMode(s.merge[secHeader]))
+	}
+	if s.merge[secRow] != 0 && s.merge[secRow] <= tw.MergeHierarchical {
+		extra = append(extra, tablewriter.WithRowMergeMode(s.merge[secRow]))
+	}
+	if s.merge[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterMergeMode(s.merge[secFooter]))
+	}
+	return append(extra,
+		tablewriter.WithRenderer(r),
+		tablewriter.WithTrimSpace(state(s.trimSpace)),
+		tablewriter.WithTrimTab(state(s.trimTab)),
+		tablewriter.WithHeaderAutoFormat(state(s.autoFormat[secHeader])),
+		tablewriter.WithRowAutoFormat(state(s.autoFormat[secRow])),
+		tablewriter.WithFooterAutoFormat(state(s.autoFormat[secFooter])),
+		tablewriter.WithHeaderAlignmentConfig(s.align[secHeader]),
+		tablewriter.WithRowAlignmentConfig(s.align[secRow]),
+		tablewriter.WithFooterAlignmentConfig(s.align[secFooter]),
+		tablewriter.WithAutoHide(state(s.autoHide)),
+		tablewriter.WithHeaderControl(tw.Control{Hide: state(s.hideHeader)}),
+		tablewriter.WithFooterControl(tw.Control{Hide: state(s.hideFooter)}),
+	)
+}
+
+func (s tableSpec) render(r tw.Renderer) (string, error) {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, s.options(r)...)
+	if s.caption != nil {
+		t.Caption(*s.caption)
+	}
+	if s.merge[secRow] > tw.MergeHierarchical || s.mergeCols != nil {
+		t.Configure(func(c *tablewriter.Config) {
+			if s.merge[secRow] > tw.MergeHierarchical {
+				// a combined mode (Vertical|Hierarchical, Horizontal|Hierarchical, all three)
+				// is beyond With*MergeMode's range: set both the new and the deprecated field
+				c.Row.Merging.Mode = s.merge[secRow]
+				c.Row.Formatting.MergeMode = s.merge[secRow]
+			}
+			if s.mergeCols != nil {
+				m := tw.NewMapper[int, bool]()
+				for _, col := range s.mergeCols {
+					m.Set(col, true)
+				}
+				c.Row.Merging.ByColumnIndex = m
+			}
+		})
+	}
+	if s.header != nil {
+		t.Header(s.header)
+	}
+	for _, row := range s.rows {
+		if err := t.Append(row); err != nil {
+			return "", err
+		}
+	}
+	if s.footer != nil {
+		t.Footer(s.footer)
+	}
+	err := t.Render()
+	return buf.String(), err
+}
+
+func (s tableSpec) String() string {
+	var b strings.Builder
+	b.WriteString("header=")
+	b.WriteString(quoteCells(s.header))
+	b.WriteString(" rows=[")
+	for i, r := range s.rows {
+		if i > 0 {
+			b.WriteString(" ")
+		}
+		b.WriteString(quoteCells(r))
+	}
+	b.WriteString("] footer=")
+	b.WriteString(quoteCells(s.footer))
+	b.WriteString(" trimSpace=" + boolStr(s.trimSpace) + " trimTab=" + boolStr(s.trimTab))
+	b.WriteString(" autoFormat=" + boolStr(s.autoFormat[0]) + "," + boolStr(s.autoFormat[1]) + "," + boolStr(s.autoFormat[2]))
+	for i, a := range s.align {
+		b.WriteString(" align" + itoa(i) + "=" + string(a.Global) + "/" + strings.Join(alignStrs(a.PerColumn), ","))
+	}
+	b.WriteString(" autoHide=" + boolStr(s.autoHide) + " hide=" + boolStr(s.hideHeader) + "," + boolStr(s.hideFooter))
+	if s.htmlCfg != nil {
+		b.WriteString(" html=escape:" + boolStr(s.htmlCfg.EscapeContent) + ",lines:" + boolStr(s.htmlCfg.AddLinesTag) + ",class:" + boolStr(s.htmlCfg.TableClass != ""))
+	}
+	if s.padding != nil {
+		b.WriteString(" padding=" + strQuote(s.padding.Left) + "," + strQuote(s.padding.Right))
+	}
+	if s.wrap != [3]int{} || s.secMax != [3]int{} || s.colWidths != nil || s.maxWidth != 0 {
+		b.WriteString(" wrap=" + itoa(s.wrap[0]) + "," + itoa(s.wrap[1]) + "," + itoa(s.wrap[2]))
+		b.WriteString(" secMax=" + itoa(s.secMax[0]) + "," + itoa(s.secMax[1]) + "," + itoa(s.secMax[2]))
+		b.WriteString(" maxWidth=" + itoa(s.maxWidth) + " colWidths=")
+		if s.colWidths == nil {
+			b.WriteString("nil")
+		} else {
+			keys := make([]int, 0, len(s.colWidths))
+			for k := range s.colWidths {
+				keys = append(keys, k)
+			}
+			sort.Ints(keys)
+			for i, k := range keys {
+				if i > 0 {
+					b.WriteString(",")
+				}
+				b.WriteString(itoa(k) + ":" + itoa(s.colWidths[k]))
+			}
+		}
+	}
+	if s.caption != nil {
+		b.WriteString(" caption=" + strQuote(s.caption.Text) + " spot=" + itoa(int(s.caption.Spot)) + " calign=" + string(s.caption.Align) + " cwidth=" + itoa(s.caption.Width))
+	}
+	if s.merge != [3]int{} || s.mergeCols != nil {
+		b.WriteString(" merge=" + itoa(s.merge[0]) + "," + itoa(s.merge[1]) + "," + itoa(s.merge[2]) + " mergeCols=")
+		if s.mergeCols == nil {
+			b.WriteString("all")
+		} else {
+			for i, c := range s.mergeCols {
+				if i > 0 {
+					b.WriteString(",")
+				}
+				b.WriteString(itoa(c))
+			}
+		}
+	}
+	return b.String()
+}
+
+func alignStrs(as []tw.Align) []string {
+	out := make([]string, len(as))
+	for i, a := range as {
+		out[i] = string(a)
+	}
+	return out
+}
+
+func quoteCells(cells []string) string {
+	if cells == nil {
+		return "nil"
+	}
+	parts := make([]string, len(cells))
+	for i, c := range cells {
+		parts[i] = strQuote(c)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func strQuote(s string) string {
+	return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"", "\n", "\\n", "\t", "\\t", esc, "\\e").Replace(s) + "\""
+}
+
+// --------------------------------------------------------------------------- the pipeline
+
+func (s tableSpec) trim(str string) string {
+	if s.trimSpace && s.trimTab {
+		return strings.TrimSpace(str)
+	}
+	if !s.trimSpace && !s.trimTab {
+		return str
+	}
+	return strings.TrimFunc(str, func(r rune) bool {
+		if r == '\t' {
+			return s.trimTab
+		}
+		if s.trimSpace {
+			return unicode.IsSpace(r)
+		}
+		return false
+	})
+}
+
+// constrained is Widths.Constrained(): a per-column width is set (WithColumnWidths drops the
+// negative ones).
+func (s tableSpec) constrained() bool {
+	for _, w := range s.colWidths {
+		if w >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// wrapMode is the section's effective AutoWrap: the option given, else the default (the
+// header truncates, rows and footer wrap).
+func (s tableSpec) wrapMode(sec int) int {
+	if s.wrap[sec] != 0 {
+		return s.wrap[sec]
+	}
+	if sec == secHeader {
+		return tw.WrapTruncate
+	}
+	return tw.WrapNormal
+}
+
+// contentMax is the model of calculateContentMaxWidth for a record of n cells: the cell
+// width constraint in priority order (Widths.PerColumn, else the section's ColMaxWidths.Global
+// - which a table MaxWidth replaces by MaxWidth/n when no per-column width is set -, else
+// MaxWidth itself when the section wraps), less the padding, at least 1 when the constraint
+// exceeds the padding; 0 means unconstrained.
+func (s tableSpec) contentMax(i, n, sec int) int {
+	constraint := 0
+	if w, ok := s.colWidths[i]; ok && w > 0 {
+		constraint = w
+	} else {
+		secMax := s.secMax[sec]
+		if s.maxWidth > 0 && !s.constrained() && n > 0 {
+			secMax = s.maxWidth / n
+		}
+		switch {
+		case secMax > 0:
+			constraint = secMax
+		case s.maxWidth > 0 && s.wrapMode(sec) != tw.WrapNone:
+			constraint = s.maxWidth
+		}
+	}
+	if constraint == 0 {
+		return 0
+	}
+	pads := width(s.pad().Left, widthOpts{}) + width(s.pad().Right, widthOpts{})
+	eff := constraint - pads
+	if eff < 1 && constraint > pads {
+		return 1
+	}
+	if eff < 0 {
+		return 0
+	}
+	return eff
+}
+
+// wrapLine is the model of prepareContent's wrapping of one visual line to the content width.
+func (s tableSpec) wrapLine(line string, eff, mode int) []string {
+	o := widthOpts{}
+	switch mode {
+	case tw.WrapNormal:
+		if s.trimSpace && s.trimTab {
+			out, _ := wrapString(line, eff)
+			return out
+		}
+		out, _ := wrapStringWithSpaces(line, eff)
+		return out
+	case tw.WrapTruncate:
+		if width(line, o) > eff {
+			return []string{truncate(line, eff-1, tw.CharEllipsis, o)}
+		}
+		return []string{line}
+	case tw.WrapBreak:
+		var wrapped []string
+		cur := line
+		for width(cur, o) > eff {
+			target := max(eff-1, 0)
+			bp := breakPoint(cur, target, o)
+			runes := []rune(cur)
+			if bp <= 0 || bp > len(runes) {
+				// the package's manual break: runes while they fit the target, at least one
+				count, tempW := 0, 0
+				for idx, r := range runes {
+					rw := width(string(r), o)
+					if tempW+rw > target && idx > 0 {
+						break
+					}
+					tempW += rw
+					count = idx + 1
+					if tempW >= target && idx == 0 {
+						break
+					}
+				}
+				if count == 0 && len(runes) > 0 {
+					count = 1
+				}
+				if count > 0 && count <= len(runes) {
+					wrapped = append(wrapped, string(runes[:count])+tw.CharBreak)
+					cur = string(runes[count:])
+				} else {
+					wrapped = append(wrapped, cur)
+					cur = ""
+					break
+				}
+			} else {
+				wrapped = append(wrapped, string(runes[:bp])+tw.CharBreak)
+				cur = string(runes[bp:])
+			}
+		}
+		if width(cur, o) > 0 {
+			wrapped = append(wrapped, cur)
+		}
+		return wrapped // a blank line yields no line
+	}
+	return []string{line}
+}
+
+// prepare turns a record into its visual lines: every cell trimmed, tabs expanded,
+// auto-formatted, split at newlines, each line wrapped to the column's content width when one
+// is constrained; the record has as many lines as its tallest cell.
+func (s tableSpec) prepare(cells []string, sec int) [][]string {
+	return s.prepareWith(cells, sec, func(i int) int { return s.contentMax(i, len(cells), sec) })
+}
+
+// prepareWith is prepare with the content width of every column given (streaming: the fixed
+// stream width less the padding).
+func (s tableSpec) prepareWith(cells []string, sec int, contentMax func(i int) int) [][]string {
+	var lines [][]string
+	for i, c := range cells {
+		c = s.trim(c)
+		c = strings.ReplaceAll(c, "\t", strings.Repeat(" ", tabW))
+		eff := contentMax(i)
+		if s.autoFormat[sec] {
+			c = tw.Title(strings.Join(tw.SplitCamelCase(c), " "))
+		}
+		var parts []string
+		for _, p := range strings.Split(c, "\n") {
+			if eff > 0 {
+				w := s.wrapLine(p, eff, s.wrapMode(sec))
+				if len(w) == 0 && s.wrapMode(sec) == tw.WrapBreak && width(p, widthOpts{}) > 0 && len(parts) == 0 {
+					w = []string{p}
+				}
+				parts = append(parts, w...)
+			} else {
+				parts = append(parts, p)
+			}
+		}
+		for len(lines) < len(parts) {
+			lines = append(lines, make([]string, len(cells)))
+		}
+		for j, p := range parts {
+			lines[j][i] = p
+		}
+	}
+	return lines
+}
+
+// aligns resolves a section's alignment per column as buildAligns does.
+func (s tableSpec) aligns(sec int, numCols int) []tw.Align {
+	a := s.align[sec]
+	out := make([]tw.Align, numCols)
+	for i := range out {
+		out[i] = a.Global
+		if i < len(a.PerColumn) && a.PerColumn[i] != "" {
+			out[i] = a.PerColumn[i]
+		}
+	}
+	return out
+}
+
+// tableModel is the prepared table: visual lines per section and the column widths.
+type tableModel struct {
+	header  [][]string   // nil when no header is rendered
+	rows    [][][]string // the records with cells, as visual lines
+	records [][][]string // every record, a record without cells having no line
+	footer  [][]string
+	numCols int
+	widths  []int  // widest content plus the padding widths, at least 1
+	hidden  []bool // hidden by AutoHide (width 0)
+	visible []bool // rendered by the Markdown and HTML renderers (bug 11: the hidden ones too)
+	// merge states per column (part 6): of the header, of every record, of the footer
+	hdrM    []cellMerge
+	recM    [][]cellMerge
+	ftrM    []cellMerge
+	natural []int // the widths before AutoHide
+}
+
+func padLine(line []string, n int) []string {
+	out := make([]string, n)
+	copy(out, line)
+	return out
+}
+
+func (s tableSpec) model() tableModel {
+	var m tableModel
+	if s.header != nil && len(s.header) > 0 && !s.hideHeader {
+		m.header = s.prepare(s.header, secHeader)
+	}
+	for _, r := range s.rows {
+		lines := s.prepare(r, secRow)
+		m.records = append(m.records, lines)
+		if len(lines) == 0 {
+			continue // a record without cells has no visual line and is dropped
+		}
+		m.rows = append(m.rows, lines)
+	}
+	if s.footer != nil && len(s.footer) > 0 && !s.hideFooter {
+		m.footer = s.prepare(s.footer, secFooter)
+	}
+	for _, l := range m.header {
+		m.numCols = max(m.numCols, len(l))
+	}
+	for _, r := range m.rows {
+		for _, l := range r {
+			m.numCols = max(m.numCols, len(l))
+		}
+	}
+	for _, l := range m.footer {
+		m.numCols = max(m.numCols, len(l))
+	}
+	padW := width(s.pad().Left, widthOpts{}) + width(s.pad().Right, widthOpts{})
+	m.widths = make([]int, m.numCols)
+	for i := range m.widths {
+		m.widths[i] = max(1, padW) // an empty column is as wide as its padding, at least 1
+	}
+	upd := func(lines [][]string) {
+		for _, l := range lines {
+			for i, c := range l {
+				m.widths[i] = max(m.widths[i], width(c, widthOpts{})+padW)
+			}
+		}
+	}
+	upd(m.header)
+	for _, r := range m.rows {
+		upd(r)
+	}
+	upd(m.footer)
+	// Widths.PerColumn replaces the natural width outright (0 included)
+	for i := range m.widths {
+		if w, ok := s.colWidths[i]; ok && w >= 0 {
+			m.widths[i] = w
+		}
+	}
+	// AutoHide judges a column empty on the body cells before any merge blanks them
+	empty := make([]bool, m.numCols)
+	if s.autoHide {
+		for i := 0; i < m.numCols; i++ {
+			empty[i] = true
+			for _, r := range m.rows {
+				for _, l := range r {
+					if i < len(l) && s.trim(l[i]) != "" {
+						empty[i] = false
+					}
+				}
+			}
+		}
+	}
+	// the natural widths, before AutoHide hides columns (bug 34 sizes merged headers by them)
+	m.natural = append([]int(nil), m.widths...)
+	// the merges come before TrimLine, which the renderer applies to the merged content
+	s.applyMerges(&m)
+	// TrimLine (on by default): a blank visual line after the first of a record is skipped
+	trimLine := func(r [][]string) [][]string {
+		if len(r) == 0 {
+			return r
+		}
+		kept := [][]string{r[0]}
+		for _, l := range r[1:] {
+			blank := true
+			for _, c := range padLine(l, m.numCols) {
+				if s.trim(c) != "" {
+					blank = false
+					break
+				}
+			}
+			if !blank {
+				kept = append(kept, l)
+			}
+		}
+		return kept
+	}
+	for ri, r := range m.rows {
+		m.rows[ri] = trimLine(r)
+	}
+	for ri, r := range m.records {
+		m.records[ri] = trimLine(r)
+	}
+	m.visible = make([]bool, m.numCols)
+	m.hidden = make([]bool, m.numCols)
+	for i := range m.visible {
+		m.visible[i] = true
+	}
+	if s.autoHide {
+		// AutoHide: a column whose body cells are all blank gets width 0 and is hidden; the
+		// Markdown and HTML renderers still render it while the switch is on (Markdown then
+		// sizes its cells by their content and its separator at the minimum three dashes)
+		for i := 0; i < m.numCols; i++ {
+			if empty[i] {
+				m.widths[i] = 0
+				m.visible[i] = Known.autoHideIgnored
+			}
+		}
+	}
+	// the boxed renderer skips every column of width 0, hidden by AutoHide or set so by
+	// Widths.PerColumn
+	for i := range m.widths {
+		m.hidden[i] = m.widths[i] == 0
+	}
+	return m
+}
+
+// joinLines folds a record's visual lines into one when Known.multilineRows is off: the
+// renderers then would emit one row per record with <br> between the lines.
+func (m tableModel) recordLines(lines [][]string) [][]string {
+	if Known.multilineRows || len(lines) <= 1 {
+		return lines
+	}
+	joined := make([]string, m.numCols)
+	for i := range joined {
+		var parts []string
+		for _, l := range lines {
+			if i < len(l) {
+				parts = append(parts, l[i])
+			} else {
+				parts = append(parts, "")
+			}
+		}
+		joined[i] = strings.Join(parts, "<br>")
+	}
+	return [][]string{joined}
+}
+
+// --------------------------------------------------------------------------- Markdown
+
+func explicit(a tw.Align) bool { return a != tw.AlignNone && a != "" }
+
+func alignRule(header, body tw.Align) tw.Align {
+	if explicit(body) {
+		return body
+	}
+	if explicit(header) {
+		return header
+	}
+	return tw.AlignCenter
+}
+
+func mdCell(content string, w int, a tw.Align) string {
+	cw := width(content, widthOpts{})
+	target := max(w, max(3, cw+2))
+	total := target - cw
+	var left, right int
+	switch a {
+	case tw.AlignRight:
+		left = max(0, total-1)
+		right = total - left
+	case tw.AlignCenter:
+		left = total / 2
+		right = total - left
+		if left < 1 && total >= 2 {
+			left = 1
+			right = total - 1
+		}
+		if right < 1 && total >= 2 {
+			right = 1
+			left = total - 1
+		}
+	default:
+		right = max(0, total-1)
+		left = total - right
+	}
+	return strings.Repeat(" ", left) + content + strings.Repeat(" ", right)
+}
+
+func mdSeparator(w int, a tw.Align) string {
+	t := max(3, w)
+	switch a {
+	case tw.AlignLeft:
+		return ":" + strings.Repeat("-", t-1)
+	case tw.AlignRight:
+		return strings.Repeat("-", t-1) + ":"
+	}
+	return ":" + strings.Repeat("-", t-2) + ":"
+}
+
+func mdEscape(c string) string {
+	if Known.markdownPipes {
+		return c
+	}
+	return strings.ReplaceAll(c, "|", "\\|")
+}
+
+// markdown is the model of the Markdown renderer's output for the spec.
+func (s tableSpec) markdown() string {
+	m := s.model()
+	var b strings.Builder
+	line := func(cells []string) {
+		b.WriteString("|")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString(cells[i])
+			b.WriteString("|")
+		}
+		b.WriteString("\n")
+	}
+	headerAlign := make([]tw.Align, m.numCols) // AlignNone when no header is rendered
+	for i := range headerAlign {
+		headerAlign[i] = tw.AlignNone
+	}
+	if m.header != nil {
+		headerAlign = s.aligns(secHeader, m.numCols)
+	}
+	var bodyAlign []tw.Align
+	switch {
+	case len(m.rows) > 0:
+		bodyAlign = s.aligns(secRow, m.numCols)
+	case m.footer != nil:
+		bodyAlign = s.aligns(secFooter, m.numCols)
+	default:
+		bodyAlign = headerAlign
+	}
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				a := headerAlign[i]
+				if !explicit(a) {
+					a = tw.AlignCenter
+				}
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], a)
+			}
+			line(cells)
+		}
+		cells := make([]string, m.numCols)
+		for i := range cells {
+			cells[i] = mdSeparator(m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+		}
+		line(cells)
+	}
+	body := func(lines [][]string) {
+		for _, l := range lines {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+			}
+			line(cells)
+		}
+	}
+	for _, r := range m.rows {
+		body(m.recordLines(r))
+	}
+	if m.footer != nil {
+		body(m.recordLines(m.footer))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- HTML
+
+func htmlStyle(a tw.Align) string {
+	switch a {
+	case tw.AlignLeft, tw.AlignRight, tw.AlignCenter:
+		return ` style="text-align: ` + string(a) + `;"`
+	}
+	return ""
+}
+
+func classAttr(c string) string {
+	if c == "" {
+		return ""
+	}
+	return ` class="` + c + `"`
+}
+
+func (s tableSpec) htmlConfig() renderer.HTMLConfig {
+	if s.htmlCfg != nil {
+		return *s.htmlCfg
+	}
+	return renderer.HTMLConfig{EscapeContent: true}
+}
+
+func (s tableSpec) htmlCell(content string, cfg renderer.HTMLConfig) string {
+	multi := strings.Contains(content, "<br>") && !Known.multilineRows
+	if cfg.EscapeContent {
+		if multi {
+			parts := strings.Split(content, "<br>")
+			for i := range parts {
+				parts[i] = html.EscapeString(parts[i])
+			}
+			content = strings.Join(parts, "<br>")
+		} else {
+			content = html.EscapeString(content)
+		}
+	}
+	if multi && cfg.AddLinesTag {
+		content = "<lines>" + content + "</lines>"
+	}
+	return content
+}
+
+// htmlOut is the model of the HTML renderer's output for the spec.
+func (s tableSpec) htmlOut() string {
+	m := s.model()
+	cfg := s.htmlConfig()
+	var b strings.Builder
+	b.WriteString("<table" + classAttr(cfg.TableClass) + ">\n")
+	row := func(l []string, tag string, aligns []tw.Align, rowClass string) {
+		l = padLine(l, m.numCols)
+		b.WriteString("  <tr" + classAttr(rowClass) + ">")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString("<" + tag + htmlStyle(aligns[i]) + ">" + s.htmlCell(l[i], cfg) + "</" + tag + ">")
+		}
+		b.WriteString("</tr>\n")
+	}
+	// a header or footer of several visual lines is handed to the renderer line by line, so
+	// each line opens its own <thead>/<tfoot> (part of bug 10)
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			b.WriteString("<thead" + classAttr(cfg.HeaderClass) + ">\n")
+			row(l, "th", s.aligns(secHeader, m.numCols), cfg.HeaderRowClass)
+			b.WriteString("</thead>\n")
+		}
+	}
+	if len(m.rows) > 0 {
+		b.WriteString("<tbody" + classAttr(cfg.BodyClass) + ">\n")
+		for _, r := range m.rows {
+			for _, l := range m.recordLines(r) {
+				row(l, "td", s.aligns(secRow, m.numCols), cfg.RowClass)
+			}
+		}
+		b.WriteString("</tbody>\n")
+	}
+	if m.footer != nil {
+		for _, l := range m.recordLines(m.footer) {
+			b.WriteString("<tfoot" + classAttr(cfg.FooterClass) + ">\n")
+			row(l, "td", s.aligns(secFooter, m.numCols), cfg.FooterRowClass)
+			b.WriteString("</tfoot>\n")
+		}
+	}
+	b.WriteString("</table>\n")
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- properties
+
+func (s tableSpec) classify(c *collector) {
+	if s.header == nil {
+		c.count("no header")
+	}
+	if len(s.rows) == 0 {
+		c.count("no rows")
+	}
+	if s.footer != nil {
+		c.count("footer")
+	}
+	if s.autoHide {
+		c.count("autoHide")
+	}
+	for _, r := range s.rows {
+		for _, cell := range r {
+			if strings.Contains(cell, "\n") {
+				c.count("multi-line cell")
+			}
+			if strings.Contains(cell, "|") {
+				c.count("pipe cell")
+			}
+		}
+	}
+}
+
+func TestHegelMarkdown(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.classify(c)
+		got, err := s.render(renderer.NewMarkdown())
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, s)
+			return
+		}
+		if want := s.markdown(); got != want {
+			c.failClass(ht, "markdown", "Markdown of %s:\n got:\n%s want:\n%s", s, got, want)
+		}
+	})
+}
+
+func TestHegelHTML(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.classify(c)
+		var r tw.Renderer
+		if s.htmlCfg != nil {
+			r = renderer.NewHTML(*s.htmlCfg)
+		} else {
+			r = renderer.NewHTML()
+		}
+		got, err := s.render(r)
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, s)
+			return
+		}
+		if want := s.htmlOut(); got != want {
+			c.failClass(ht, "html", "HTML of %s:\n got:\n%s want:\n%s", s, got, want)
+		}
+	})
+}
