+// cleanStreams: cleanBoxed tables streamed without width constraints or merges, in the section
+// order drawn, StrictColumns 20% of the time, the sections hidden by their Control left out
+// (Header() and Footer() return at once).
+var cleanStreams = hegel.Composite(func(tc hegel.TestCase) streamSpec {
+	s := streamSpec{tableSpec: hegel.Draw(tc, cleanBoxed), order: hegel.Draw(tc, streamOrders), strict: hegel.Draw(tc, chance(20))}
+	if s.hideHeader {
+		s.header = nil
+	}
+	if s.hideFooter {
+		s.footer = nil
+	}
+	return s
+})
+
+var headerFirstOrders = hegel.SampledFrom([]int{orderHRF, orderHFR})
+
+// streamRunCells: runCells without a space, so that no stream column narrower than the cell
+// wraps it (a wrapped cell no longer equals its neighbour).
+var streamRunCells = hegel.SampledFrom([]string{"a", "b", "Total", "x", "c"})
+
+// widenTo pads the header (if any) and every row of s to at least n cells with clean cells, so
+// that the streamed column count (set by the first section) is at least n; exact cuts them to
+// n too, so that the count is n and no row is padded by the stream.
+func widenTo(tc hegel.TestCase, s streamSpec, n int, exact bool) streamSpec {
+	fit := func(cells []string) []string {
+		out := padded(tc, cells, n, cleanCellTexts)
+		if exact {
+			out = out[:n]
+		}
+		return out
+	}
+	if s.header != nil {
+		s.header = fit(s.header)
+	}
+	rows := make([][]string, len(s.rows))
+	for i, r := range s.rows {
+		rows[i] = fit(r)
+	}
+	s.rows = rows
+	return s
+}
