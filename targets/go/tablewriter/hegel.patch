+// truncAfter: a truncation case whose string is prefix, the sequence, then a visible tail at
+// least two columns wider than the suffix, cut so that some of the tail must stay: the width
+// lies between the prefix plus the suffix plus one and the visible width less one.
+func truncAfter(tc hegel.TestCase, prefix, seq string) truncCase {
+	o := hegel.Draw(tc, widthOptions)
+	suffix := hegel.Draw(tc, hegel.SampledFrom(suffixes))
+	ws := width(suffix, o)
+	tail := hegel.Draw(tc, visibleStrs(ws+2, ws+5))
+	wp, wt := width(prefix, o), width(tail, o)
+	return truncCase{
+		o:        o,
+		s:        prefix + seq + tail,
+		maxWidth: hegel.Draw(tc, hegel.Integers(wp+ws+1, wp+wt-1)),
+		suffix:   suffix,
+		twoArg:   hegel.Draw(tc, chance(50)),
+	}
+}
