+// shapedField is a field of the leaf's type holding it, named and tagged so that it is rendered.
+func shapedField(tc hegel.TestCase, typ reflect.Type, l leaf) fieldSpec {
+	return fieldSpec{name: hegel.Draw(tc, shapedNames), typ: typ, tag: hegel.Draw(tc, shapedTags), leaf: l}
+}
+
+// opWith is an Append of the row or, 30% of the time when the row can be a Bulk element (not
+// the variadic call), a Bulk of it among 0 to 2 clean rows (first among them when first).
+func opWith(tc hegel.TestCase, r rowInput, first bool) inputOp {
+	if !r.bulkOK || !hegel.Draw(tc, chance(30)) {
+		return inputOp{rows: []rowInput{r}}
+	}
+	rs := hegel.Draw(tc, many(cleanBulkRows, 0, 2))
+	i := 0
+	if !first {
+		i = hegel.Draw(tc, positions) % (len(rs) + 1)
+	}
+	return inputOp{bulk: true, rows: append(rs[:i], append([]rowInput{r}, rs[i:]...)...)}
+}
+
+// around is the op among clean ops: 40% of the time one before (unless it must come first)
+// and 40% one after.
+func around(tc hegel.TestCase, op inputOp, first bool) []inputOp {
+	var ops []inputOp
+	if !first && hegel.Draw(tc, chance(40)) {
+		ops = append(ops, hegel.Draw(tc, cleanOps))
+	}
+	ops = append(ops, op)
+	if hegel.Draw(tc, chance(40)) {
+		ops = append(ops, hegel.Draw(tc, cleanOps))
+	}
+	return ops
+}
