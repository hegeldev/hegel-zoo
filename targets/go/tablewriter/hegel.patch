+// inputCaseWith: the op among clean ops, AutoHeader as given, a header of 1 to 3 clean texts
+// 30% of the time (none under AutoHeader, which the op's first row then feeds).
+func inputCaseWith(tc hegel.TestCase, op inputOp, autoHeader bool) inputCase {
+	k := inputCase{autoHeader: autoHeader, ops: around(tc, op, autoHeader)}
+	if !autoHeader {
+		k.header = hegel.Draw(tc, maybe(30, many(cleanTexts, 1, 3)))
+	}
+	return k
+}
