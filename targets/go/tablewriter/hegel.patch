new file mode 100644
index 0000000..bf6ecd5
--- /dev/null
+++ b/hegel/hegel_fn_test.go
@@ -0,0 +1,246 @@
+package hegel
+
+// Properties of the tw helpers: Title, SplitCamelCase, IsNumeric, BreakPoint and the Pad
+// family against models of their documentation.
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var titlePieces = []string{"a", "b", "name", "Name", "ID", "1", "25", "_", ".", " ", "  ", "x", "ß", "あ", "é", "-", "é.5", "1.5", "_.", "._"}
+
+func numOrSpace(r rune) bool { return ('0' <= r && r <= '9') || r == ' ' }
+
+// title is the model of tw.Title: underscores become spaces, dots too unless between digits or
+// spaces; the result is trimmed, a non-empty input trimmed to nothing is one space, and the
+// whole is upper-cased.
+func title(name string) string {
+	rs := []rune(name)
+	for i, r := range rs {
+		switch r {
+		case '_':
+			rs[i] = ' '
+		case '.':
+			if (i > 0 && !numOrSpace(rs[i-1])) || (i < len(rs)-1 && !numOrSpace(rs[i+1])) {
+				rs[i] = ' '
+			}
+		}
+	}
+	out := strings.TrimSpace(string(rs))
+	if out == "" && name != "" {
+		out = " "
+	}
+	return strings.ToUpper(out)
+}
+
+var camelPieces = []string{"a", "bc", "Def", "GHI", "j", "1", "23", "_", "__", " ", "\t", "-", "é", "É", "あ", "ǅ", "X"}
+
+func runeClass(r rune) int {
+	switch {
+	case unicode.IsLower(r):
+		return 1
+	case unicode.IsUpper(r):
+		return 2
+	case unicode.IsDigit(r):
+		return 3
+	}
+	return 4
+}
+
+// splitCamelCase is the model of tw.SplitCamelCase: runs of one class (lower, upper, digit,
+// other); an upper run followed by a lower run lends it its last rune; empty, blank and
+// underscore groups are dropped (only a lone underscore under Known.camelUnderscoreGroups).
+func splitCamelCase(src string) []string {
+	var groups [][]rune
+	last := 0
+	for _, r := range src {
+		c := runeClass(r)
+		if c == last && len(groups) > 0 {
+			groups[len(groups)-1] = append(groups[len(groups)-1], r)
+		} else {
+			groups = append(groups, []rune{r})
+		}
+		last = c
+	}
+	for i := 0; i < len(groups)-1; i++ {
+		if len(groups[i]) > 0 && unicode.IsUpper(groups[i][0]) && len(groups[i+1]) > 0 && unicode.IsLower(groups[i+1][0]) {
+			groups[i+1] = append([]rune{groups[i][len(groups[i])-1]}, groups[i+1]...)
+			groups[i] = groups[i][:len(groups[i])-1]
+		}
+	}
+	out := []string{}
+	for _, g := range groups {
+		s := string(g)
+		if len(g) == 0 || strings.TrimSpace(s) == "" {
+			continue
+		}
+		if Known.camelUnderscoreGroups {
+			if s == "_" {
+				continue
+			}
+		} else if strings.Trim(s, "_") == "" {
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+var numericPieces = []string{"0", "1", "25", "-", "+", ".", "e", "E", " ", "x", "inf", "NaN", "_", ",", "1_0", "0x1p-2", "Infinity"}
+
+func isNumeric(s string) bool {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return false
+	}
+	if _, err := strconv.Atoi(s); err == nil {
+		return true
+	}
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// breakPoint is the model of tw.BreakPoint: the number of leading runes whose display width
+// fits the limit, escape sequences taking no width (under Known.breakPointEscapes their runes
+// count as visible characters, as the package measures each rune alone).
+func breakPoint(s string, limit int, o widthOpts) int {
+	if limit <= 0 || s == "" {
+		return 0
+	}
+	cw, n := 0, 0
+	for _, t := range scan(s) {
+		if t.seq && !Known.breakPointEscapes {
+			n += len([]rune(t.s))
+			continue
+		}
+		for _, r := range t.s {
+			w := runeWidth(r, o)
+			if t.seq {
+				w = width(string(r), o)
+			}
+			if cw+w > limit {
+				if cw == 0 {
+					if w > limit {
+						return 1
+					}
+					return 0
+				}
+				return n
+			}
+			cw += w
+			n++
+		}
+	}
+	return n
+}
+
+func padCenter(s, pad string, w int, o widthOpts) string {
+	gap := w - width(s, o)
+	if gap <= 0 {
+		return s
+	}
+	left := (gap + 1) / 2
+	return strings.Repeat(pad, left) + s + strings.Repeat(pad, gap-left)
+}
+
+func padRight(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return s + strings.Repeat(pad, gap)
+	}
+	return s
+}
+
+func padLeft(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return strings.Repeat(pad, gap) + s
+	}
+	return s
+}
+
+func padAlign(s, pad string, w int, a tw.Align, o widthOpts) string {
+	if width(s, o) > w {
+		return truncate(s, w, "", o)
+	}
+	switch a {
+	case tw.AlignRight:
+		return padLeft(s, pad, w, o)
+	case tw.AlignCenter:
+		return padCenter(s, pad, w, o)
+	}
+	return padRight(s, pad, w, o)
+}
+
+func genPieces(tc hegel.TestCase, pool []string, max int) string {
+	n := drawInt(tc, 0, max)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteString(pick(tc, pool))
+	}
+	return b.String()
+}
+
+var aligns = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+func TestHegelFn(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		name := genPieces(ht, titlePieces, 6)
+		if got, want := tw.Title(name), title(name); got != want {
+			c.failClass(ht, "Title", "Title(%q) = %q, want %q", name, got, want)
+		}
+		src := genPieces(ht, camelPieces, 6)
+		if got, want := tw.SplitCamelCase(src), splitCamelCase(src); !sameStrings(got, want) {
+			c.failClass(ht, "SplitCamelCase", "SplitCamelCase(%q) = %q, want %q", src, got, want)
+		}
+		if strings.Contains(src, "__") {
+			c.count("double underscore")
+		}
+		num := genPieces(ht, numericPieces, 4)
+		if got, want := tw.IsNumeric(num), isNumeric(num); got != want {
+			c.failClass(ht, "IsNumeric", "IsNumeric(%q) = %v, want %v", num, got, want)
+		}
+		if isNumeric(num) {
+			c.count("numeric")
+		}
+
+		o := drawOpts(ht)
+		setOpts(o)
+		s := genStr(ht, strOpts{maxPieces: 5, noST: true})
+		limit := drawInt(ht, -1, 10)
+		if got, want := tw.BreakPoint(s, limit), breakPoint(s, limit, o); got != want {
+			c.failClass(ht, "BreakPoint", "BreakPoint(%q, %d) %+v = %d, want %d", s, limit, o, got, want)
+		}
+		if strings.Contains(s, esc) {
+			c.count("BreakPoint with sequences")
+		}
+		w := drawInt(ht, -1, 12)
+		pad := pick(ht, []string{" ", "*", "-", "あ", ""})
+		if got, want := tw.PadCenter(s, pad, w), padCenter(s, pad, w, o); got != want {
+			c.failClass(ht, "PadCenter", "PadCenter(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadRight(s, pad, w), padRight(s, pad, w, o); got != want {
+			c.failClass(ht, "PadRight", "PadRight(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadLeft(s, pad, w), padLeft(s, pad, w, o); got != want {
+			c.failClass(ht, "PadLeft", "PadLeft(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		a := pick(ht, aligns)
+		if got, want := tw.Pad(s, pad, w, a), padAlign(s, pad, w, a, o); got != want {
+			c.failClass(ht, "Pad", "Pad(%q, %q, %d, %q) %+v = %q, want %q", s, pad, w, a, o, got, want)
+		}
+		if pad == " " && width(s, o) <= w {
+			if got := tw.Pad(s, pad, w, a); width(got, o) != w {
+				c.failClass(ht, "Pad width", "Pad(%q, %q, %d, %q) %+v = %q has width %d", s, pad, w, a, o, got, width(got, o))
+			}
+		}
+		_ = twwidth.Width
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..11171ac
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,251 @@
+package hegel
+
+// Models of pkg/twwidth: the escape-sequence scanner (ECMA-48: a CSI sequence is ESC [
+// parameters intermediates final; an OSC sequence is ESC ] ... BEL or ESC \), display widths
+// and Truncate.
+
+import (
+	"strings"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+)
+
+const (
+	esc   = "\x1b"
+	bel   = "\x07"
+	reset = "\x1b[0m"
+	tabW  = 4 // the tab width the tests fix (SetTabWidth after the first TabWidth, bug 1)
+)
+
+func init() {
+	twwidth.TabWidth()
+	twwidth.SetTabWidth(tabW)
+}
+
+type widthOpts struct {
+	ea     bool
+	narrow bool
+	tab    int // the tab width in force, tabW when 0
+}
+
+func setOpts(o widthOpts) {
+	twwidth.SetOptions(twwidth.Options{EastAsianWidth: o.ea, ForceNarrowBorders: o.narrow})
+}
+
+// tok is a piece of a string: an escape sequence or a run of visible text.
+type tok struct {
+	seq bool
+	s   string
+}
+
+// csiEnd returns the index after the CSI sequence starting at i (s[i:i+2] == ESC [), or -1.
+func csiEnd(s string, i int) int {
+	j := i + 2
+	for j < len(s) && s[j] >= 0x30 && s[j] <= 0x3f {
+		j++
+	}
+	for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+		j++
+	}
+	if j < len(s) && s[j] >= 0x40 && s[j] <= 0x7e {
+		return j + 1
+	}
+	return -1
+}
+
+// oscEnd returns the index after the OSC sequence starting at i (s[i:i+2] == ESC ]), or -1.
+func oscEnd(s string, i int) int {
+	for j := i + 2; j < len(s); j++ {
+		if s[j] == 0x07 {
+			return j + 1
+		}
+		if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+			return j + 2
+		}
+		if s[j] == '\n' { // the package's regexp does not cross a newline
+			return -1
+		}
+	}
+	return -1
+}
+
+// scan splits s into escape sequences and visible text by ECMA-48.
+func scan(s string) []tok {
+	var out []tok
+	var text strings.Builder
+	flush := func() {
+		if text.Len() > 0 {
+			out = append(out, tok{false, text.String()})
+			text.Reset()
+		}
+	}
+	for i := 0; i < len(s); {
+		if s[i] == 0x1b && i+1 < len(s) {
+			end := -1
+			switch s[i+1] {
+			case '[':
+				end = csiEnd(s, i)
+			case ']':
+				end = oscEnd(s, i)
+			}
+			if end > 0 {
+				flush()
+				out = append(out, tok{true, s[i:end]})
+				i = end
+				continue
+			}
+		}
+		text.WriteByte(s[i])
+		i++
+	}
+	flush()
+	return out
+}
+
+func stripSeq(s string) string {
+	var b strings.Builder
+	for _, t := range scan(s) {
+		if !t.seq {
+			b.WriteString(t.s)
+		}
+	}
+	return b.String()
+}
+
+func isBox(r rune) bool { return r >= 0x2500 && r <= 0x257f }
+
+func runeWidth(r rune, o widthOpts) int {
+	if o.narrow && isBox(r) {
+		return 1
+	}
+	if r == '\t' {
+		if o.tab > 0 {
+			return o.tab
+		}
+		return tabW
+	}
+	return displaywidth.Options{EastAsianWidth: o.ea}.Rune(r)
+}
+
+// width is the model of twwidth.Width: the sum of the rune widths of the visible text.
+func width(s string, o widthOpts) int {
+	w := 0
+	for _, r := range stripSeq(s) {
+		w += runeWidth(r, o)
+	}
+	return w
+}
+
+// truncTokens scans s as Truncate's loop does when Known.truncateEscRestart is on: an ESC
+// always starts a new sequence (so the ESC of an ST terminator restarts the scan and the rest
+// of the string is swallowed by a sequence that never terminates), a CSI ends at a final byte,
+// an OSC at BEL. Otherwise the ECMA-48 scan, with visible text split into runes. The last
+// element reports whether the scan ended inside a sequence (open).
+func truncTokens(s string, faithful bool) (toks []tok, open bool) {
+	if !faithful {
+		for _, t := range scan(s) {
+			if t.seq {
+				toks = append(toks, t)
+				continue
+			}
+			for _, r := range t.s {
+				toks = append(toks, tok{false, string(r)})
+			}
+		}
+		return toks, false
+	}
+	var buf []byte
+	in := false
+	for _, r := range s {
+		if r == 0x1b {
+			in = true
+			buf = append(buf[:0], 0x1b)
+			continue
+		}
+		if in {
+			buf = append(buf, []byte(string(r))...)
+			term := false
+			if len(buf) >= 2 {
+				switch buf[1] {
+				case '[':
+					term = len(buf) >= 3 && r >= 0x40 && r <= 0x7e
+				case ']':
+					term = r == 0x07
+				}
+			}
+			if term {
+				in = false
+				toks = append(toks, tok{true, string(buf)})
+			}
+			continue
+		}
+		toks = append(toks, tok{false, string(r)})
+	}
+	return toks, in
+}
+
+// truncate is the model of twwidth.Truncate.
+func truncate(s string, maxWidth int, suffix string, o widthOpts) string {
+	if maxWidth < 0 {
+		return ""
+	}
+	sw := width(s, o)
+	suffixW := width(suffix, o)
+	if sw == 0 {
+		if suffix != "" && (suffixW <= maxWidth || (maxWidth == 0 && !Known.truncateZeroSuffix)) {
+			return suffix
+		}
+		if maxWidth == 0 && len(s) > 0 {
+			return ""
+		}
+		return s
+	}
+	if maxWidth == 0 {
+		if suffix != "" && !Known.truncateZeroSuffix {
+			return suffix // documented: "If maxWidth is zero and a suffix is provided, the suffix is returned"
+		}
+		return ""
+	}
+	if sw <= maxWidth {
+		safe := s
+		if strings.Contains(s, esc) && !strings.HasSuffix(s, reset) {
+			safe += reset
+		}
+		if suffix == "" || sw+suffixW > maxWidth {
+			return safe
+		}
+		return safe + suffix
+	}
+	if suffix != "" && o.ea && maxWidth-suffixW == 0 {
+		return suffix
+	}
+	budget := maxWidth - suffixW
+	if budget < 0 {
+		return ""
+	}
+	toks, open := truncTokens(s, Known.truncateEscRestart)
+	var out strings.Builder
+	cw := 0
+	wrote := false
+	for _, t := range toks {
+		if t.seq {
+			out.WriteString(t.s)
+			wrote = true
+			continue
+		}
+		r := []rune(t.s)[0]
+		w := runeWidth(r, o)
+		if budget == 0 || cw+w > budget {
+			open = false
+			break
+		}
+		out.WriteString(t.s)
+		cw += w
+	}
+	res := out.String()
+	if (wrote || (open && strings.Contains(s, esc+"["))) && (cw > 0 || wrote) && !strings.HasSuffix(res, reset) {
+		res += reset
+	}
+	return res + suffix
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..94f4238
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,294 @@
+package hegel
+
+// Pins: one test per recorded bug, asserting the documented behaviour. They fail while the bug
+// exists (listed in target.toml [expected_failures]) and pass once it is fixed.
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+)
+
+// 1: SetWidth on a Tabinal (SetTabWidth on the global one) before its first Size() is
+// overwritten by the detection Size() runs once.
+func TestHegelPinTabWidthSetBeforeUse(t *testing.T) {
+	var tb twwidth.Tabinal
+	tb.SetWidth(3)
+	if got := tb.Size(); got != 3 {
+		t.Fatalf("Tabinal.SetWidth(3) then Size() = %d, want 3 (the detection ran over the set width)", got)
+	}
+}
+
+// 2: the width cache is not purged by SetTabWidth, so a cached width of a string holding a tab
+// is stale after the tab width changes.
+func TestHegelPinTabWidthCache(t *testing.T) {
+	defer func() {
+		twwidth.SetTabWidth(tabW)
+		setOpts(widthOpts{ea: true})
+		setOpts(widthOpts{})
+	}()
+	setOpts(widthOpts{ea: true})
+	setOpts(widthOpts{})
+	twwidth.SetTabWidth(4)
+	if got := twwidth.Width("a\tb"); got != 6 {
+		t.Fatalf("Width(a<tab>b) with tab width 4 = %d, want 6", got)
+	}
+	twwidth.SetTabWidth(8)
+	got, want := twwidth.Width("a\tb"), twwidth.WidthNoCache("a\tb")
+	if got != want {
+		t.Fatalf("after SetTabWidth(8): Width(a<tab>b) = %d, WidthNoCache = %d", got, want)
+	}
+}
+
+// 3: Width sums rune widths, so an emoji sequence (VS16, ZWJ, flags, modifiers) differs from
+// displaywidth's width of the string.
+func TestHegelPinWidthEmojiSequence(t *testing.T) {
+	setOpts(widthOpts{})
+	for _, s := range emojiPieces {
+		if got, want := twwidth.Width(s), displaywidth.String(s); got != want {
+			t.Fatalf("Width(%q) = %d, displaywidth.String = %d", s, got, want)
+		}
+	}
+}
+
+// 4: Truncate restarts its scan at every ESC, so the ST terminator of an OSC sequence (a
+// hyperlink) opens a sequence that never ends and swallows the rest of the string.
+func TestHegelPinTruncateHyperlink(t *testing.T) {
+	setOpts(widthOpts{})
+	link := esc + "]8;;http://x" + esc + "\\" + "link" + esc + "]8;;" + esc + "\\" + " more text"
+	got := twwidth.Truncate(link, 6)
+	if vis := stripSeq(got); vis != "link m" {
+		t.Fatalf("Truncate(hyperlink + text, 6) = %q, visible %q, want visible %q", got, vis, "link m")
+	}
+}
+
+// 5: documented "If maxWidth is zero and a suffix is provided, the suffix is returned".
+func TestHegelPinTruncateZeroSuffix(t *testing.T) {
+	setOpts(widthOpts{})
+	if got := twwidth.Truncate("hello", 0, "..."); got != "..." {
+		t.Fatalf("Truncate(hello, 0, ...) = %q, want the suffix", got)
+	}
+}
+
+// 6: WrapStringWithSpaces slices the core content one byte after the start of the last
+// non-space rune, so a multi-byte last rune is measured as one column and the limit returned
+// is too small for the lines.
+func TestHegelPinWrapSpacesTrailingRune(t *testing.T) {
+	setOpts(widthOpts{})
+	lines, lim := twwarp.WrapStringWithSpaces("a あ", 1)
+	for _, l := range lines {
+		if twwidth.Width(l) > lim {
+			t.Fatalf("WrapStringWithSpaces(%q, 1) = %q, limit %d: line %q is wider", "a あ", lines, lim, l)
+		}
+	}
+}
+
+// 7: BreakPoint measures every rune alone, so the characters of an escape sequence count as
+// visible and a coloured line is broken inside its sequence.
+func TestHegelPinBreakPointEscapes(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[31mabc"
+	if got := tw.BreakPoint(s, 2); got != 7 {
+		t.Fatalf("BreakPoint(%q, 2) = %d, want 7 (ESC[31m takes no width; ab fit)", s, got)
+	}
+}
+
+// 8: SplitCamelCase drops a lone underscore group but keeps groups of several underscores.
+func TestHegelPinCamelUnderscoreGroups(t *testing.T) {
+	got := tw.SplitCamelCase("a__b")
+	if strings.Join(got, "|") != "a|b" {
+		t.Fatalf("SplitCamelCase(a__b) = %q, want [a b]", got)
+	}
+}
+
+// --------------------------------------------------------------------------- table
+
+func renderWith(r tw.Renderer, header []string, rows [][]string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	t.Render()
+	return buf.String()
+}
+
+// 9: the Markdown renderer writes a | inside a cell unescaped, splitting the cell for every
+// Markdown parser.
+func TestHegelPinMarkdownPipe(t *testing.T) {
+	out := renderWith(renderer.NewMarkdown(), []string{"a"}, [][]string{{"x|y"}})
+	if !strings.Contains(out, "x\\|y") {
+		t.Fatalf("Markdown of a cell x|y:\n%s\nwant the pipe escaped as \\|", out)
+	}
+}
+
+// 10: a cell holding a newline is split into visual lines before the renderers see it, so
+// Markdown gets an extra table row and HTML an extra <tr> (and one <thead> per header line);
+// the renderers' <br> handling is never reached.
+func TestHegelPinMultilineRows(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if n := strings.Count(md, "\n"); n != 3 {
+		t.Fatalf("Markdown of one record with a two-line cell has %d lines, want 3 (header, separator, one row):\n%s", n, md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if strings.Count(h, "<tr") != 2 || !strings.Contains(h, "<br>") {
+		t.Fatalf("HTML of one record with a two-line cell:\n%s\nwant one body <tr> with a <br>", h)
+	}
+}
+
+// 11: AutoHide zeroes the widths of columns that are empty in every row; the Blueprint
+// renderer drops them, the Markdown and HTML renderers render them.
+func TestHegelPinAutoHideRenderers(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(md, "A") {
+		t.Fatalf("Markdown with AutoHide still shows the empty column A:\n%s", md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(h, ">A<") {
+		t.Fatalf("HTML with AutoHide still shows the empty column A:\n%s", h)
+	}
+}
+
+// 12: WithColumnMax is documented as a maximum column width but is shared by the columns
+// (minus the separators); with two columns and 8, each gets 3, its content 1, and WrapTruncate
+// (Truncate at width 0 with the ellipsis) empties the cell.
+func TestHegelPinColumnMaxTruncate(t *testing.T) {
+	out := renderWith(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)}), []string{"a", "b"},
+		[][]string{{"hello world foo bar", "y"}}, tablewriter.WithColumnMax(8), tablewriter.WithRowAutoWrap(tw.WrapTruncate))
+	if !strings.Contains(out, "hello") {
+		t.Fatalf("WithColumnMax(8) with WrapTruncate on a two-column table:\n%s\nwant the first cell truncated to 8 columns, not emptied", out)
+	}
+}
+
+// --------------------------------------------------------------------------- blueprint
+
+func asciiBlueprint() tw.Renderer {
+	return renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)})
+}
+
+func renderFull(r tw.Renderer, header []string, rows [][]string, footer []string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	if footer != nil {
+		t.Footer(footer)
+	}
+	t.Render()
+	return buf.String()
+}
+
+func sameLineWidths(out string) bool {
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	for _, l := range lines {
+		if twwidth.Width(l) != twwidth.Width(lines[0]) {
+			return false
+		}
+	}
+	return true
+}
+
+// 13: with AlignNone (or the empty alignment) the Blueprint renderer computes the section's
+// default position (header centre, footer right) and then overwrites it with the cell's
+// AlignNone, so formatCell falls to left alignment in every section.
+func TestHegelPinAlignNoneDefaults(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "bbbbb"}, [][]string{{"1", "2"}}, []string{"f", "ggggg"},
+		tablewriter.WithHeaderAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}),
+		tablewriter.WithFooterAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}))
+	if !strings.Contains(out, "|  A  |") {
+		t.Fatalf("Blueprint with the header alignment AlignNone:\n%s\nwant the header cell A centred (the section's default)", out)
+	}
+}
+
+// 14: the rows' top border is drawn only when the table has neither header nor footer, and
+// the footer's only when there is nothing above it, so a table with rows and a footer but no
+// header starts with a row line, without a top border.
+func TestHegelPinTopBorderFooterOnly(t *testing.T) {
+	out := renderFull(asciiBlueprint(), nil, [][]string{{"1", "2"}}, []string{"f", "g"})
+	if !strings.HasPrefix(out, "+") {
+		t.Fatalf("Blueprint of rows and a footer without a header:\n%s\nwant a top border as the first line", out)
+	}
+}
+
+// 15: renderLine draws the separator before a column only when the previous column's width
+// is positive, so a column hidden by AutoHide (width 0) takes the separator of the column
+// after it with it.
+func TestHegelPinAutoHideSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b", "c"}, [][]string{{"1", "", "3"}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !strings.Contains(out, "| 1 | 3 |") {
+		t.Fatalf("Blueprint with the middle column hidden by AutoHide:\n%s\nwant the row line | 1 | 3 |", out)
+	}
+}
+
+// 16: when AutoHide hides every column the border lines are drawn without their right glyph
+// (no visible column) but the cell lines keep both column glyphs.
+func TestHegelPinAutoHideAllColumns(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, [][]string{{"", ""}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !sameLineWidths(out) {
+		t.Fatalf("Blueprint with every column hidden by AutoHide renders lines of different widths:\n%q", out)
+	}
+}
+
+// 17: with a header and a footer but no rows the header separator and the footer separator
+// are both drawn, two identical lines.
+func TestHegelPinHeaderFooterSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, nil, []string{"f", "g"})
+	if n := strings.Count(out, "+---+---+\n"); n != 3 {
+		t.Fatalf("Blueprint of a header and a footer without rows has %d border lines, want 3 (top, one separator, bottom):\n%s", n, out)
+	}
+}
+
+// 18: a record without cells still counts as a row line, so a table holding only such a
+// record renders two ++ lines where a table without records renders nothing.
+func TestHegelPinEmptyRecord(t *testing.T) {
+	got := renderFull(asciiBlueprint(), nil, [][]string{{}}, nil)
+	if want := renderFull(asciiBlueprint(), nil, nil, nil); got != want {
+		t.Fatalf("Blueprint of a single empty record = %q, want %q (as with no record)", got, want)
+	}
+}
+
+// 19: header AutoFormat (on by default) passes the cell through SplitCamelCase and Title,
+// which split and upper-case the escape sequences of a coloured header, so the terminal
+// prints them as text.
+func TestHegelPinAutoFormatEscapes(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{esc + "[31mred" + esc + "[0m"}, [][]string{{"1"}}, nil)
+	if !strings.Contains(out, esc+"[31m") {
+		t.Fatalf("Blueprint of a coloured header:\n%q\nwant the escape sequence ESC[31m intact", out)
+	}
+}
+
+// 20: Truncate's scan ends a CSI sequence at any final byte, Width's Filter requires the
+// parameters before the intermediates, so on a sequence such as ESC[ 31 m (an intermediate
+// first) Truncate keeps text that Width counts, and the result is wider than the limit.
+func TestHegelPinTruncateIntermediate(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[ 31 mRED"
+	got := twwidth.Truncate(s, 2)
+	if w := twwidth.Width(got); w > 2 {
+		t.Fatalf("Truncate(%q, 2) = %q, whose Width is %d, want at most 2", s, got, w)
+	}
+}
+
+// 21: Line takes the excess width of both corner glyphs over the column glyph off the first and
+// last column, so with StyleGraphical (two-cell corners) a lone one-cell column gives border
+// lines one cell wider than the cell lines.
+func TestHegelPinGraphicalNarrowColumn(t *testing.T) {
+	out := renderFull(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleGraphical)}), []string{"a"}, [][]string{{"x"}}, nil, tablewriter.WithPadding(tw.PaddingNone))
+	if !sameLineWidths(out) {
+		t.Fatalf("StyleGraphical with a one-cell column renders lines of different widths:\n%s", out)
+	}
+}
diff --git a/hegel/hegel_table_test.go b/hegel/hegel_table_test.go
new file mode 100644
index 0000000..4e2a328
--- /dev/null
+++ b/hegel/hegel_table_test.go
@@ -0,0 +1,690 @@
+package hegel
+
+// The table's Markdown and HTML renderings against models of the documented pipeline: cells
+// trimmed (TrimSpace/TrimTab), tabs expanded, header/footer auto-formatted, split into visual
+// lines, column widths from the widest cell plus padding; Markdown cells padded to the column
+// width by the alignment rules (body explicit, else header, else centre) with a separator row
+// of at least three dashes; HTML sections with escaped cells and text-align styles.
+
+import (
+	"bytes"
+	"html"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var tableCells = []string{
+	"", "", "a", "Name", "userName", "first_name", "city.name", "v1.5", "25", "-3.5", "ID",
+	" x ", "\tt\t", "  ", "a|b", "x\ny", "x\n\ny", "<b>&\"q\"", "あい", "é", "long cell text",
+	esc + "[31mred" + esc + "[0m", "A__B", "1.5", ".", "_", "a  b",
+}
+
+var alignChoices = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+type tableSpec struct {
+	header     []string // nil: no header
+	rows       [][]string
+	footer     []string // nil: no footer
+	trimSpace  bool
+	trimTab    bool
+	autoFormat [3]bool // header, row, footer
+	align      [3]tw.CellAlignment
+	autoHide   bool
+	hideHeader bool
+	hideFooter bool
+	htmlCfg    *renderer.HTMLConfig
+	padding    *tw.Padding // WithPadding for every section; nil: the default one space each side
+}
+
+func (s tableSpec) pad() tw.Padding {
+	if s.padding != nil {
+		return *s.padding
+	}
+	return tw.PaddingDefault
+}
+
+const (
+	secHeader = 0
+	secRow    = 1
+	secFooter = 2
+)
+
+func genCells(tc hegel.TestCase, n int) []string {
+	out := make([]string, n)
+	for i := range out {
+		out[i] = pick(tc, tableCells)
+	}
+	return out
+}
+
+func genAlignment(tc hegel.TestCase, def tw.Align) tw.CellAlignment {
+	if chance(tc, 50) {
+		return tw.CellAlignment{Global: def}
+	}
+	a := tw.CellAlignment{Global: pick(tc, alignChoices)}
+	if chance(tc, 40) {
+		n := drawInt(tc, 0, 4)
+		for i := 0; i < n; i++ {
+			a.PerColumn = append(a.PerColumn, pick(tc, alignChoices))
+		}
+	}
+	return a
+}
+
+func genTableSpec(tc hegel.TestCase) tableSpec {
+	s := tableSpec{trimSpace: true, trimTab: true, autoFormat: [3]bool{true, false, false}}
+	cols := drawInt(tc, 1, 4)
+	if chance(tc, 80) {
+		s.header = genCells(tc, drawInt(tc, 1, cols+1))
+	}
+	nrows := drawInt(tc, 0, 4)
+	for i := 0; i < nrows; i++ {
+		s.rows = append(s.rows, genCells(tc, drawInt(tc, 0, cols+1)))
+	}
+	if chance(tc, 40) {
+		s.footer = genCells(tc, drawInt(tc, 1, cols+1))
+	}
+	if chance(tc, 20) {
+		s.trimSpace = false
+	}
+	if chance(tc, 20) {
+		s.trimTab = false
+	}
+	for i := range s.autoFormat {
+		if chance(tc, 20) {
+			s.autoFormat[i] = !s.autoFormat[i]
+		}
+	}
+	s.align[secHeader] = genAlignment(tc, tw.AlignCenter)
+	s.align[secRow] = genAlignment(tc, tw.AlignLeft)
+	s.align[secFooter] = genAlignment(tc, tw.AlignRight)
+	s.autoHide = chance(tc, 20)
+	s.hideHeader = chance(tc, 10)
+	s.hideFooter = chance(tc, 10)
+	if chance(tc, 40) {
+		s.htmlCfg = &renderer.HTMLConfig{EscapeContent: chance(tc, 70), AddLinesTag: chance(tc, 30)}
+		if chance(tc, 50) {
+			s.htmlCfg.TableClass, s.htmlCfg.HeaderClass, s.htmlCfg.BodyClass = "t", "h", "b"
+			s.htmlCfg.FooterClass, s.htmlCfg.RowClass, s.htmlCfg.HeaderRowClass, s.htmlCfg.FooterRowClass = "f", "r", "hr", "fr"
+		}
+	}
+	return s
+}
+
+func state(b bool) tw.State {
+	if b {
+		return tw.On
+	}
+	return tw.Off
+}
+
+func (s tableSpec) options(r tw.Renderer) []tablewriter.Option {
+	var extra []tablewriter.Option
+	if s.padding != nil {
+		extra = append(extra, tablewriter.WithPadding(*s.padding))
+	}
+	return append(extra,
+		tablewriter.WithRenderer(r),
+		tablewriter.WithTrimSpace(state(s.trimSpace)),
+		tablewriter.WithTrimTab(state(s.trimTab)),
+		tablewriter.WithHeaderAutoFormat(state(s.autoFormat[secHeader])),
+		tablewriter.WithRowAutoFormat(state(s.autoFormat[secRow])),
+		tablewriter.WithFooterAutoFormat(state(s.autoFormat[secFooter])),
+		tablewriter.WithHeaderAlignmentConfig(s.align[secHeader]),
+		tablewriter.WithRowAlignmentConfig(s.align[secRow]),
+		tablewriter.WithFooterAlignmentConfig(s.align[secFooter]),
+		tablewriter.WithAutoHide(state(s.autoHide)),
+		tablewriter.WithHeaderControl(tw.Control{Hide: state(s.hideHeader)}),
+		tablewriter.WithFooterControl(tw.Control{Hide: state(s.hideFooter)}),
+	)
+}
+
+func (s tableSpec) render(r tw.Renderer) (string, error) {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, s.options(r)...)
+	if s.header != nil {
+		t.Header(s.header)
+	}
+	for _, row := range s.rows {
+		if err := t.Append(row); err != nil {
+			return "", err
+		}
+	}
+	if s.footer != nil {
+		t.Footer(s.footer)
+	}
+	err := t.Render()
+	return buf.String(), err
+}
+
+func (s tableSpec) String() string {
+	var b strings.Builder
+	b.WriteString("header=")
+	b.WriteString(quoteCells(s.header))
+	b.WriteString(" rows=[")
+	for i, r := range s.rows {
+		if i > 0 {
+			b.WriteString(" ")
+		}
+		b.WriteString(quoteCells(r))
+	}
+	b.WriteString("] footer=")
+	b.WriteString(quoteCells(s.footer))
+	b.WriteString(" trimSpace=" + boolStr(s.trimSpace) + " trimTab=" + boolStr(s.trimTab))
+	b.WriteString(" autoFormat=" + boolStr(s.autoFormat[0]) + "," + boolStr(s.autoFormat[1]) + "," + boolStr(s.autoFormat[2]))
+	for i, a := range s.align {
+		b.WriteString(" align" + itoa(i) + "=" + string(a.Global) + "/" + strings.Join(alignStrs(a.PerColumn), ","))
+	}
+	b.WriteString(" autoHide=" + boolStr(s.autoHide) + " hide=" + boolStr(s.hideHeader) + "," + boolStr(s.hideFooter))
+	if s.htmlCfg != nil {
+		b.WriteString(" html=escape:" + boolStr(s.htmlCfg.EscapeContent) + ",lines:" + boolStr(s.htmlCfg.AddLinesTag) + ",class:" + boolStr(s.htmlCfg.TableClass != ""))
+	}
+	if s.padding != nil {
+		b.WriteString(" padding=" + strQuote(s.padding.Left) + "," + strQuote(s.padding.Right))
+	}
+	return b.String()
+}
+
+func alignStrs(as []tw.Align) []string {
+	out := make([]string, len(as))
+	for i, a := range as {
+		out[i] = string(a)
+	}
+	return out
+}
+
+func quoteCells(cells []string) string {
+	if cells == nil {
+		return "nil"
+	}
+	parts := make([]string, len(cells))
+	for i, c := range cells {
+		parts[i] = strQuote(c)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func strQuote(s string) string {
+	return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"", "\n", "\\n", "\t", "\\t", esc, "\\e").Replace(s) + "\""
+}
+
+// --------------------------------------------------------------------------- the pipeline
+
+func (s tableSpec) trim(str string) string {
+	if s.trimSpace && s.trimTab {
+		return strings.TrimSpace(str)
+	}
+	if !s.trimSpace && !s.trimTab {
+		return str
+	}
+	return strings.TrimFunc(str, func(r rune) bool {
+		if r == '\t' {
+			return s.trimTab
+		}
+		if s.trimSpace {
+			return unicode.IsSpace(r)
+		}
+		return false
+	})
+}
+
+// prepare turns a record into its visual lines: every cell trimmed, tabs expanded,
+// auto-formatted, split at newlines; the record has as many lines as its tallest cell.
+func (s tableSpec) prepare(cells []string, sec int) [][]string {
+	var lines [][]string
+	for i, c := range cells {
+		c = s.trim(c)
+		c = strings.ReplaceAll(c, "\t", strings.Repeat(" ", tabW))
+		if s.autoFormat[sec] {
+			c = tw.Title(strings.Join(tw.SplitCamelCase(c), " "))
+		}
+		parts := strings.Split(c, "\n")
+		for len(lines) < len(parts) {
+			lines = append(lines, make([]string, len(cells)))
+		}
+		for j, p := range parts {
+			lines[j][i] = p
+		}
+	}
+	return lines
+}
+
+// aligns resolves a section's alignment per column as buildAligns does.
+func (s tableSpec) aligns(sec int, numCols int) []tw.Align {
+	a := s.align[sec]
+	out := make([]tw.Align, numCols)
+	for i := range out {
+		out[i] = a.Global
+		if i < len(a.PerColumn) && a.PerColumn[i] != "" {
+			out[i] = a.PerColumn[i]
+		}
+	}
+	return out
+}
+
+// tableModel is the prepared table: visual lines per section and the column widths.
+type tableModel struct {
+	header  [][]string   // nil when no header is rendered
+	rows    [][][]string // the records with cells, as visual lines
+	records [][][]string // every record, a record without cells having no line
+	footer  [][]string
+	numCols int
+	widths  []int  // widest content plus the padding widths, at least 1
+	hidden  []bool // hidden by AutoHide (width 0)
+	visible []bool // rendered by the Markdown and HTML renderers (bug 11: the hidden ones too)
+}
+
+func padLine(line []string, n int) []string {
+	out := make([]string, n)
+	copy(out, line)
+	return out
+}
+
+func (s tableSpec) model() tableModel {
+	var m tableModel
+	if s.header != nil && len(s.header) > 0 && !s.hideHeader {
+		m.header = s.prepare(s.header, secHeader)
+	}
+	for _, r := range s.rows {
+		lines := s.prepare(r, secRow)
+		m.records = append(m.records, lines)
+		if len(lines) == 0 {
+			continue // a record without cells has no visual line and is dropped
+		}
+		m.rows = append(m.rows, lines)
+	}
+	if s.footer != nil && len(s.footer) > 0 && !s.hideFooter {
+		m.footer = s.prepare(s.footer, secFooter)
+	}
+	for _, l := range m.header {
+		m.numCols = max(m.numCols, len(l))
+	}
+	for _, r := range m.rows {
+		for _, l := range r {
+			m.numCols = max(m.numCols, len(l))
+		}
+	}
+	for _, l := range m.footer {
+		m.numCols = max(m.numCols, len(l))
+	}
+	padW := width(s.pad().Left, widthOpts{}) + width(s.pad().Right, widthOpts{})
+	m.widths = make([]int, m.numCols)
+	for i := range m.widths {
+		m.widths[i] = max(1, padW) // an empty column is as wide as its padding, at least 1
+	}
+	upd := func(lines [][]string) {
+		for _, l := range lines {
+			for i, c := range l {
+				m.widths[i] = max(m.widths[i], width(c, widthOpts{})+padW)
+			}
+		}
+	}
+	upd(m.header)
+	for _, r := range m.rows {
+		upd(r)
+	}
+	upd(m.footer)
+	// TrimLine (on by default): a blank visual line after the first of a record is skipped
+	trimLine := func(r [][]string) [][]string {
+		if len(r) == 0 {
+			return r
+		}
+		kept := [][]string{r[0]}
+		for _, l := range r[1:] {
+			blank := true
+			for _, c := range padLine(l, m.numCols) {
+				if s.trim(c) != "" {
+					blank = false
+					break
+				}
+			}
+			if !blank {
+				kept = append(kept, l)
+			}
+		}
+		return kept
+	}
+	for ri, r := range m.rows {
+		m.rows[ri] = trimLine(r)
+	}
+	for ri, r := range m.records {
+		m.records[ri] = trimLine(r)
+	}
+	m.visible = make([]bool, m.numCols)
+	m.hidden = make([]bool, m.numCols)
+	for i := range m.visible {
+		m.visible[i] = true
+	}
+	if s.autoHide {
+		// AutoHide: a column whose body cells are all blank gets width 0 and is hidden; the
+		// Markdown and HTML renderers still render it while the switch is on (Markdown then
+		// sizes its cells by their content and its separator at the minimum three dashes)
+		for i := 0; i < m.numCols; i++ {
+			empty := true
+			for _, r := range m.rows {
+				for _, l := range r {
+					if i < len(l) && s.trim(l[i]) != "" {
+						empty = false
+					}
+				}
+			}
+			if empty {
+				m.widths[i] = 0
+				m.hidden[i] = true
+				m.visible[i] = Known.autoHideIgnored
+			}
+		}
+	}
+	return m
+}
+
+// joinLines folds a record's visual lines into one when Known.multilineRows is off: the
+// renderers then would emit one row per record with <br> between the lines.
+func (m tableModel) recordLines(lines [][]string) [][]string {
+	if Known.multilineRows || len(lines) <= 1 {
+		return lines
+	}
+	joined := make([]string, m.numCols)
+	for i := range joined {
+		var parts []string
+		for _, l := range lines {
+			if i < len(l) {
+				parts = append(parts, l[i])
+			} else {
+				parts = append(parts, "")
+			}
+		}
+		joined[i] = strings.Join(parts, "<br>")
+	}
+	return [][]string{joined}
+}
+
+// --------------------------------------------------------------------------- Markdown
+
+func explicit(a tw.Align) bool { return a != tw.AlignNone && a != "" }
+
+func alignRule(header, body tw.Align) tw.Align {
+	if explicit(body) {
+		return body
+	}
+	if explicit(header) {
+		return header
+	}
+	return tw.AlignCenter
+}
+
+func mdCell(content string, w int, a tw.Align) string {
+	cw := width(content, widthOpts{})
+	target := max(w, max(3, cw+2))
+	total := target - cw
+	var left, right int
+	switch a {
+	case tw.AlignRight:
+		left = max(0, total-1)
+		right = total - left
+	case tw.AlignCenter:
+		left = total / 2
+		right = total - left
+		if left < 1 && total >= 2 {
+			left = 1
+			right = total - 1
+		}
+		if right < 1 && total >= 2 {
+			right = 1
+			left = total - 1
+		}
+	default:
+		right = max(0, total-1)
+		left = total - right
+	}
+	return strings.Repeat(" ", left) + content + strings.Repeat(" ", right)
+}
+
+func mdSeparator(w int, a tw.Align) string {
+	t := max(3, w)
+	switch a {
+	case tw.AlignLeft:
+		return ":" + strings.Repeat("-", t-1)
+	case tw.AlignRight:
+		return strings.Repeat("-", t-1) + ":"
+	}
+	return ":" + strings.Repeat("-", t-2) + ":"
+}
+
+func mdEscape(c string) string {
+	if Known.markdownPipes {
+		return c
+	}
+	return strings.ReplaceAll(c, "|", "\\|")
+}
+
+// markdown is the model of the Markdown renderer's output for the spec.
+func (s tableSpec) markdown() string {
+	m := s.model()
+	var b strings.Builder
+	line := func(cells []string) {
+		b.WriteString("|")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString(cells[i])
+			b.WriteString("|")
+		}
+		b.WriteString("\n")
+	}
+	headerAlign := make([]tw.Align, m.numCols) // AlignNone when no header is rendered
+	for i := range headerAlign {
+		headerAlign[i] = tw.AlignNone
+	}
+	if m.header != nil {
+		headerAlign = s.aligns(secHeader, m.numCols)
+	}
+	var bodyAlign []tw.Align
+	switch {
+	case len(m.rows) > 0:
+		bodyAlign = s.aligns(secRow, m.numCols)
+	case m.footer != nil:
+		bodyAlign = s.aligns(secFooter, m.numCols)
+	default:
+		bodyAlign = headerAlign
+	}
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				a := headerAlign[i]
+				if !explicit(a) {
+					a = tw.AlignCenter
+				}
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], a)
+			}
+			line(cells)
+		}
+		cells := make([]string, m.numCols)
+		for i := range cells {
+			cells[i] = mdSeparator(m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+		}
+		line(cells)
+	}
+	body := func(lines [][]string) {
+		for _, l := range lines {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+			}
+			line(cells)
+		}
+	}
+	for _, r := range m.rows {
+		body(m.recordLines(r))
+	}
+	if m.footer != nil {
+		body(m.recordLines(m.footer))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- HTML
+
+func htmlStyle(a tw.Align) string {
+	switch a {
+	case tw.AlignLeft, tw.AlignRight, tw.AlignCenter:
+		return ` style="text-align: ` + string(a) + `;"`
+	}
+	return ""
+}
+
+func classAttr(c string) string {
+	if c == "" {
+		return ""
+	}
+	return ` class="` + c + `"`
+}
+
+func (s tableSpec) htmlConfig() renderer.HTMLConfig {
+	if s.htmlCfg != nil {
+		return *s.htmlCfg
+	}
+	return renderer.HTMLConfig{EscapeContent: true}
+}
+
+func (s tableSpec) htmlCell(content string, cfg renderer.HTMLConfig) string {
+	multi := strings.Contains(content, "<br>") && !Known.multilineRows
+	if cfg.EscapeContent {
+		if multi {
+			parts := strings.Split(content, "<br>")
+			for i := range parts {
+				parts[i] = html.EscapeString(parts[i])
+			}
+			content = strings.Join(parts, "<br>")
+		} else {
+			content = html.EscapeString(content)
+		}
+	}
+	if multi && cfg.AddLinesTag {
+		content = "<lines>" + content + "</lines>"
+	}
+	return content
+}
+
+// htmlOut is the model of the HTML renderer's output for the spec.
+func (s tableSpec) htmlOut() string {
+	m := s.model()
+	cfg := s.htmlConfig()
+	var b strings.Builder
+	b.WriteString("<table" + classAttr(cfg.TableClass) + ">\n")
+	row := func(l []string, tag string, aligns []tw.Align, rowClass string) {
+		l = padLine(l, m.numCols)
+		b.WriteString("  <tr" + classAttr(rowClass) + ">")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString("<" + tag + htmlStyle(aligns[i]) + ">" + s.htmlCell(l[i], cfg) + "</" + tag + ">")
+		}
+		b.WriteString("</tr>\n")
+	}
+	// a header or footer of several visual lines is handed to the renderer line by line, so
+	// each line opens its own <thead>/<tfoot> (part of bug 10)
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			b.WriteString("<thead" + classAttr(cfg.HeaderClass) + ">\n")
+			row(l, "th", s.aligns(secHeader, m.numCols), cfg.HeaderRowClass)
+			b.WriteString("</thead>\n")
+		}
+	}
+	if len(m.rows) > 0 {
+		b.WriteString("<tbody" + classAttr(cfg.BodyClass) + ">\n")
+		for _, r := range m.rows {
+			for _, l := range m.recordLines(r) {
+				row(l, "td", s.aligns(secRow, m.numCols), cfg.RowClass)
+			}
+		}
+		b.WriteString("</tbody>\n")
+	}
+	if m.footer != nil {
+		for _, l := range m.recordLines(m.footer) {
+			b.WriteString("<tfoot" + classAttr(cfg.FooterClass) + ">\n")
+			row(l, "td", s.aligns(secFooter, m.numCols), cfg.FooterRowClass)
+			b.WriteString("</tfoot>\n")
+		}
+	}
+	b.WriteString("</table>\n")
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- properties
+
+func (s tableSpec) classify(c *collector) {
+	if s.header == nil {
+		c.count("no header")
+	}
+	if len(s.rows) == 0 {
+		c.count("no rows")
+	}
+	if s.footer != nil {
+		c.count("footer")
+	}
+	if s.autoHide {
+		c.count("autoHide")
+	}
+	for _, r := range s.rows {
+		for _, cell := range r {
+			if strings.Contains(cell, "\n") {
+				c.count("multi-line cell")
+			}
+			if strings.Contains(cell, "|") {
+				c.count("pipe cell")
+			}
+		}
+	}
+}
+
+func TestHegelMarkdown(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.classify(c)
+		got, err := s.render(renderer.NewMarkdown())
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, s)
+			return
+		}
+		if want := s.markdown(); got != want {
+			c.failClass(ht, "markdown", "Markdown of %s:\n got:\n%s want:\n%s", s, got, want)
+		}
+	})
+}
+
+func TestHegelHTML(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.classify(c)
+		var r tw.Renderer
+		if s.htmlCfg != nil {
+			r = renderer.NewHTML(*s.htmlCfg)
+		} else {
+			r = renderer.NewHTML()
+		}
+		got, err := s.render(r)
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, s)
+			return
+		}
+		if want := s.htmlOut(); got != want {
+			c.failClass(ht, "html", "HTML of %s:\n got:\n%s want:\n%s", s, got, want)
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..05e9983
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,166 @@
+package hegel
+
+// Hegel property tests for olekukonko/tablewriter, written for the Hegel zoo. See
+// targets/go/tablewriter/README.md.
+//
+// Oracle: models of the documented behaviour of the helper packages (pkg/twwidth: display
+// widths over strings holding ANSI escape sequences, truncation; pkg/twwarp: word splitting
+// and minimum-raggedness wrapping; tw: padding, title formatting, camel-case splitting,
+// break points) and of the table's Markdown, HTML and boxed (Blueprint) renderings over
+// generated cells.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	tabWidthCache         bool // 2: Width's cache is not purged by SetTabWidth
+	widthPerRune          bool // 3: Width sums rune widths, so emoji sequences differ from displaywidth's string width
+	truncateEscRestart    bool // 4: Truncate restarts its scan at every ESC, so an ST-terminated OSC swallows the rest
+	truncateZeroSuffix    bool // 5: Truncate at maxWidth 0 returns "" although the suffix is documented
+	wrapSpacesByteSlice   bool // 6: WrapStringWithSpaces splits a multi-byte last rune between core and trailing spaces
+	breakPointEscapes     bool // 7: BreakPoint counts the characters of escape sequences
+	camelUnderscoreGroups bool // 8: SplitCamelCase keeps groups of two or more underscores
+	// table
+	markdownPipes   bool // 9: the Markdown renderer does not escape | in cells
+	multilineRows   bool // 10: a cell with newlines becomes extra Markdown/HTML rows (the <br> paths are dead)
+	autoHideIgnored bool // 11: the Markdown and HTML renderers render the columns AutoHide hides
+	// blueprint
+	alignNoneLeft            bool // 13: Blueprint renders AlignNone cells left-aligned in every section, discarding the position default it computes
+	noTopBorderWithoutHeader bool // 14: no top border when the table has a footer but no header
+	autoHideSeparator        bool // 15: the separator before a visible column is dropped when the column before it is hidden by AutoHide
+	doubleSeparator          bool // 17: a header-and-footer table without rows renders the header and the footer separator, two identical lines
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
diff --git a/hegel/hegel_width_test.go b/hegel/hegel_width_test.go
new file mode 100644
index 0000000..3ca85f4
--- /dev/null
+++ b/hegel/hegel_width_test.go
@@ -0,0 +1,181 @@
+package hegel
+
+// Properties of pkg/twwidth: Width, WidthNoCache, WidthWithOptions, Filter and Truncate
+// against the models of hegel_model_test.go.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+var plainPieces = []string{
+	"a", "b", "hello", "World", "x1", "-", ".", " ", "  ", "\t", "\n", "\r", "\x00", "\x7f",
+	"é", "é", "あ", "漢字", "─", "┼", "═",
+	"\U0001F600", "ß", "Ǳ", "…", "↩", "　",
+}
+
+// emojiPieces are sequences whose grapheme width differs from the sum of their runes.
+var emojiPieces = []string{
+	"❤️", "\U0001F468‍\U0001F469‍\U0001F467", "\U0001F1EB\U0001F1F7",
+	"1️⃣", "\U0001F44B\U0001F3FB", "☀️",
+}
+
+var csiPieces = []string{
+	esc + "[31m", esc + "[0m", esc + "[1;32m", esc + "[m", esc + "[K", esc + "[2J", esc + "[?25h",
+	esc + "[1;2 q", esc + "[38;5;31m", esc + "[10;20H",
+}
+
+var oscBelPieces = []string{esc + "]0;title" + bel, esc + "]8;;http://x" + bel, esc + "]8;;" + bel}
+var oscSTPieces = []string{esc + "]8;;http://x" + esc + "\\", esc + "]8;;" + esc + "\\", esc + "]0;t" + esc + "\\"}
+
+type strOpts struct {
+	noSeq, noEmoji, noST bool
+	maxPieces            int
+}
+
+func genStr(tc hegel.TestCase, o strOpts) string {
+	n := o.maxPieces
+	if n == 0 {
+		n = 8
+	}
+	k := drawInt(tc, 0, n)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		switch r := drawInt(tc, 1, 100); {
+		case r <= 55:
+			b.WriteString(pick(tc, plainPieces))
+		case r <= 65 && !o.noEmoji:
+			b.WriteString(pick(tc, emojiPieces))
+		case r <= 85 && !o.noSeq:
+			b.WriteString(pick(tc, csiPieces))
+		case r <= 93 && !o.noSeq:
+			b.WriteString(pick(tc, oscBelPieces))
+		case !o.noSeq && !o.noST:
+			b.WriteString(pick(tc, oscSTPieces))
+		default:
+			b.WriteString(pick(tc, plainPieces))
+		}
+	}
+	return b.String()
+}
+
+func hasEmojiSeq(s string) bool {
+	for _, p := range emojiPieces {
+		if strings.Contains(s, p) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasBox(s string) bool {
+	for _, r := range s {
+		if isBox(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func drawOpts(tc hegel.TestCase) widthOpts {
+	return widthOpts{ea: chance(tc, 30), narrow: chance(tc, 30)}
+}
+
+func TestHegelWidth(t *testing.T) {
+	c := newCollector(t)
+	defer func() { twwidth.SetTabWidth(tabW); setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		o := drawOpts(ht)
+		if !Known.tabWidthCache && chance(ht, 50) {
+			o.tab = drawInt(ht, 1, 8)
+			twwidth.SetTabWidth(o.tab)
+		} else {
+			twwidth.SetTabWidth(tabW)
+		}
+		setOpts(o)
+		s := genStr(ht, strOpts{})
+		want := width(s, o)
+		c.count("ea=" + boolStr(o.ea))
+		if strings.Contains(s, esc) {
+			c.count("with sequences")
+		}
+		if got := twwidth.Width(s); got != want {
+			c.failClass(ht, "Width", "Width(%q) %+v = %d, want %d", s, o, got, want)
+		}
+		if got := twwidth.Width(s); got != want {
+			c.failClass(ht, "Width cached", "Width(%q) %+v = %d on the second call, want %d", s, o, got, want)
+		}
+		if got := twwidth.WidthNoCache(s); got != want {
+			c.failClass(ht, "WidthNoCache", "WidthNoCache(%q) %+v = %d, want %d", s, o, got, want)
+		}
+		other := drawOpts(ht)
+		other.tab = o.tab
+		otherOpts := twwidth.Options{EastAsianWidth: other.ea, ForceNarrowBorders: other.narrow}
+		if got, w := twwidth.WidthWithOptions(s, otherOpts), width(s, other); got != w {
+			c.failClass(ht, "WidthWithOptions", "WidthWithOptions(%q, %+v) = %d, want %d", s, other, got, w)
+		}
+		if got, w := twwidth.Filter().ReplaceAllLiteralString(s, ""), stripSeq(s); got != w {
+			c.failClass(ht, "Filter", "Filter stripped %q to %q, want %q", s, got, w)
+		}
+		if !Known.widthPerRune && !strings.Contains(s, "\t") && !hasBox(s) {
+			dw := displaywidth.Options{EastAsianWidth: o.ea}
+			if got, w := twwidth.Width(s), dw.String(stripSeq(s)); got != w {
+				c.failClass(ht, "grapheme width", "Width(%q) %+v = %d, displaywidth.String gives %d", s, o, got, w)
+			}
+		}
+		if hasEmojiSeq(s) {
+			c.count("emoji sequence")
+		}
+	})
+}
+
+func boolStr(b bool) string {
+	if b {
+		return "true"
+	}
+	return "false"
+}
+
+var suffixes = []string{"", "", ".", "..", "...", "…", "あ"}
+
+func TestHegelTruncate(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		o := drawOpts(ht)
+		setOpts(o)
+		s := genStr(ht, strOpts{maxPieces: 6})
+		maxWidth := drawInt(ht, -1, 12)
+		suffix := pick(ht, suffixes)
+		want := truncate(s, maxWidth, suffix, o)
+		var got string
+		if suffix == "" && chance(ht, 50) {
+			got = twwidth.Truncate(s, maxWidth)
+		} else {
+			got = twwidth.Truncate(s, maxWidth, suffix)
+		}
+		sw := width(s, o)
+		switch {
+		case maxWidth < 0:
+			c.count("negative")
+		case sw <= maxWidth:
+			c.count("fits")
+		default:
+			c.count("truncated")
+		}
+		if got != want {
+			c.failClass(ht, "Truncate", "Truncate(%q, %d, %q) %+v = %q, want %q", s, maxWidth, suffix, o, got, want)
+			return
+		}
+		if maxWidth >= 0 && width(got, o) > maxWidth {
+			c.failClass(ht, "too wide", "Truncate(%q, %d, %q) %+v = %q, width %d", s, maxWidth, suffix, o, got, width(got, o))
+		}
+		if strings.Contains(s, esc) && maxWidth > 0 && sw > maxWidth && got != "" && strings.Contains(got, esc) && !strings.Contains(got, reset) {
+			c.failClass(ht, "no reset", "Truncate(%q, %d, %q) = %q leaves a sequence open", s, maxWidth, suffix, got)
+		}
+	})
+}
diff --git a/hegel/hegel_wrap_test.go b/hegel/hegel_wrap_test.go
new file mode 100644
index 0000000..da44a54
--- /dev/null
+++ b/hegel/hegel_wrap_test.go
@@ -0,0 +1,338 @@
+package hegel
+
+// Properties of pkg/twwarp: SplitWords, WrapWords (the minimum-raggedness partition, checked
+// against a brute-force optimum and an independent dynamic programme), WrapString and
+// WrapStringWithSpaces.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+const penalty = 100000 // twwarp's defaultPenalty
+
+var wordPool = []string{
+	"a", "bb", "ccc", "dddd", "eeeeee", "あ", "ああ", "é", "xý", "1.5",
+	esc + "[31mred" + esc + "[0m", "ab" + esc + "[1m", "──", "\U0001F600",
+}
+
+var spaceRuns = []string{" ", " ", "  ", "\t", "\n", "\r\n", " \t ", "　", " "}
+
+// lineCost is the raggedness the package minimises: for every line but the last, the square
+// of the slack (plus the penalty when the line overflows); the last line is free.
+func lineWidth(words []string, spc int) int {
+	w := 0
+	for i, x := range words {
+		if i > 0 {
+			w += spc
+		}
+		w += twwidth.Width(x)
+	}
+	return w
+}
+
+func partitionCost(lines [][]string, spc, lim int) int {
+	cost := 0
+	for i, l := range lines {
+		if i == len(lines)-1 {
+			break
+		}
+		d := lim - lineWidth(l, spc)
+		cost += d * d
+		if lineWidth(l, spc) > lim {
+			cost += penalty
+		}
+	}
+	return cost
+}
+
+// bestCost is the optimum by brute force over every partition whose last line fits (or is a
+// single word).
+func bestCost(words []string, spc, lim int) int {
+	n := len(words)
+	best := math.MaxInt
+	for mask := 0; mask < 1<<(n-1); mask++ {
+		var lines [][]string
+		start := 0
+		for i := 0; i < n-1; i++ {
+			if mask&(1<<i) != 0 {
+				lines = append(lines, words[start:i+1])
+				start = i + 1
+			}
+		}
+		lines = append(lines, words[start:])
+		last := lines[len(lines)-1]
+		if len(last) > 1 && lineWidth(last, spc) > lim {
+			continue
+		}
+		if c := partitionCost(lines, spc, lim); c < best {
+			best = c
+		}
+	}
+	return best
+}
+
+// wrapWords is an independent statement of the package's dynamic programme: the break after
+// word i is the first j minimising slack^2 (+ penalty) plus the cost from j; a tail that fits
+// costs nothing, and the last word ends the chain.
+func wrapWords(words []string, spc, lim int) [][]string {
+	n := len(words)
+	if n == 0 {
+		return nil
+	}
+	lengths := make([]int, n)
+	for i, w := range words {
+		lengths[i] = twwidth.Width(w)
+	}
+	cost := make([]int, n)
+	next := make([]int, n)
+	for i := n - 1; i >= 0; i-- {
+		if i == n-1 || lineWidth(words[i:], spc) <= lim {
+			cost[i] = 0
+			next[i] = n
+			continue
+		}
+		cost[i] = math.MaxInt32
+		for j := i + 1; j < n; j++ {
+			l := lineWidth(words[i:j], spc)
+			d := lim - l
+			c := d*d + cost[j]
+			if l > lim {
+				c += penalty
+			}
+			if c < cost[i] {
+				cost[i] = c
+				next[i] = j
+			}
+		}
+	}
+	var lines [][]string
+	for i := 0; i < n; i = next[i] {
+		lines = append(lines, words[i:next[i]])
+	}
+	return lines
+}
+
+func splitWords(s string) []string { return strings.FieldsFunc(s, unicode.IsSpace) }
+
+func maxWordWidth(words []string) int {
+	m := 0
+	for _, w := range words {
+		if x := twwidth.Width(w); x > m {
+			m = x
+		}
+	}
+	return m
+}
+
+func joinLines(lines [][]string) []string {
+	out := make([]string, 0, len(lines))
+	for _, l := range lines {
+		out = append(out, strings.Join(l, " "))
+	}
+	return out
+}
+
+// wrapString is the model of twwarp.WrapString.
+func wrapString(s string, lim int) ([]string, int) {
+	if s == " " {
+		return []string{" "}, lim
+	}
+	words := splitWords(s)
+	if len(words) == 0 {
+		return []string{""}, lim
+	}
+	if m := maxWordWidth(words); m > lim {
+		lim = m
+	}
+	return joinLines(wrapWords(words, 1, lim)), lim
+}
+
+// wrapStringWithSpaces is the model of twwarp.WrapStringWithSpaces. Under
+// Known.wrapSpacesByteSlice the core content ends one byte after the start of the last
+// non-space rune, as the package slices it, so a multi-byte last rune is split between the
+// core and the "trailing spaces".
+func wrapStringWithSpaces(s string, lim int) ([]string, int) {
+	if s == "" {
+		return []string{""}, lim
+	}
+	if strings.TrimSpace(s) == "" {
+		if w := twwidth.Width(s); w <= lim {
+			return []string{s}, w
+		}
+		if lim > 0 {
+			cw := 0
+			end := 0
+			for i, r := range s {
+				w := twwidth.Width(string(r))
+				if cw+w > lim {
+					break
+				}
+				cw += w
+				end = i + utf8.RuneLen(r)
+			}
+			return []string{s[:end]}, lim
+		}
+		return []string{""}, lim
+	}
+	first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	end := last + 1
+	if !Known.wrapSpacesByteSlice {
+		_, size := utf8.DecodeRuneInString(s[last:])
+		end = last + size
+	}
+	leading, trailing, core := s[:first], s[end:], s[first:end]
+	words := splitWords(core)
+	if len(words) == 0 {
+		return []string{leading + trailing}, lim
+	}
+	cur := lim
+	if m := maxWordWidth(words); m > cur {
+		cur = m
+	}
+	lines := joinLines(wrapWords(words, 1, cur))
+	for i := range lines {
+		lines[i] = leading + lines[i]
+		if i == len(lines)-1 {
+			lines[i] += trailing
+		}
+	}
+	return lines, cur
+}
+
+func genWords(tc hegel.TestCase, max int) []string {
+	n := drawInt(tc, 0, max)
+	words := make([]string, n)
+	for i := range words {
+		words[i] = pick(tc, wordPool)
+	}
+	return words
+}
+
+func genSpaced(tc hegel.TestCase, words []string) string {
+	var b strings.Builder
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, spaceRuns))
+	}
+	for i, w := range words {
+		if i > 0 {
+			b.WriteString(pick(tc, spaceRuns))
+		}
+		b.WriteString(w)
+	}
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, spaceRuns))
+	}
+	return b.String()
+}
+
+func flatten(lines [][]string) []string {
+	var out []string
+	for _, l := range lines {
+		out = append(out, l...)
+	}
+	return out
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestHegelWrap(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		words := genWords(ht, 8)
+		lim := drawInt(ht, -2, 14)
+		spc := drawInt(ht, 0, 2)
+		got := twwarp.WrapWords(words, spc, lim, penalty)
+		if len(words) == 0 {
+			if got != nil {
+				c.failClass(ht, "WrapWords empty", "WrapWords(nil) = %q", got)
+			}
+		} else {
+			if !sameStrings(flatten(got), words) {
+				c.failClass(ht, "WrapWords words", "WrapWords(%q, %d, %d) = %q loses or reorders words", words, spc, lim, got)
+				return
+			}
+			if last := got[len(got)-1]; len(last) > 1 && lineWidth(last, spc) > lim {
+				c.failClass(ht, "WrapWords last", "WrapWords(%q, %d, %d) = %q: the last line overflows", words, spc, lim, got)
+			}
+			if pc, bc := partitionCost(got, spc, lim), bestCost(words, spc, lim); pc != bc {
+				c.failClass(ht, "WrapWords optimum", "WrapWords(%q, %d, %d) = %q costs %d, the optimum is %d", words, spc, lim, got, pc, bc)
+			}
+			if want := wrapWords(words, spc, lim); !sameStrings(joinLines(got), joinLines(want)) {
+				c.failClass(ht, "WrapWords exact", "WrapWords(%q, %d, %d) = %q, want %q", words, spc, lim, got, want)
+			}
+			c.count("lines=" + itoa(len(got)))
+		}
+
+		s := genSpaced(ht, words)
+		if chance(ht, 10) {
+			s = pick(ht, []string{"", " ", "  ", "\t", " \n ", "　", "　　　", "     "})
+		}
+		if sw := twwarp.SplitWords(s); !sameStrings(sw, splitWords(s)) {
+			c.failClass(ht, "SplitWords", "SplitWords(%q) = %q, want %q", s, sw, splitWords(s))
+		}
+		lines, gotLim := twwarp.WrapString(s, lim)
+		wantLines, wantLim := wrapString(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapString", "WrapString(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		for _, l := range lines {
+			if twwidth.Width(l) > gotLim && gotLim >= 0 && s != " " {
+				c.failClass(ht, "WrapString width", "WrapString(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+			}
+		}
+		lines, gotLim = twwarp.WrapStringWithSpaces(s, lim)
+		wantLines, wantLim = wrapStringWithSpaces(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapStringWithSpaces", "WrapStringWithSpaces(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		if strings.TrimSpace(s) != "" {
+			first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			_, size := utf8.DecodeRuneInString(s[last:])
+			lead, trail := s[:first], s[last+size:]
+			for i, l := range lines {
+				if !strings.HasPrefix(l, lead) || (i == len(lines)-1 && !strings.HasSuffix(l, trail)) {
+					c.failClass(ht, "WithSpaces preserved", "WrapStringWithSpaces(%q, %d) = %q: leading %q / trailing %q not preserved", s, lim, lines, lead, trail)
+					break
+				}
+				core := strings.TrimPrefix(l, lead)
+				if i == len(lines)-1 {
+					core = strings.TrimSuffix(core, trail)
+				}
+				if !Known.wrapSpacesByteSlice && twwidth.Width(core) > gotLim {
+					c.failClass(ht, "WithSpaces width", "WrapStringWithSpaces(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+				}
+			}
+			if strings.Join(splitWords(strings.Join(lines, " ")), " ") != strings.Join(splitWords(s), " ") {
+				c.failClass(ht, "WithSpaces words", "WrapStringWithSpaces(%q, %d) = %q changes the words", s, lim, lines)
+			}
+		}
+	})
+}
+
+func itoa(n int) string {
+	if n < 10 {
+		return string(rune('0' + n))
+	}
+	return itoa(n/10) + string(rune('0'+n%10))
+}
