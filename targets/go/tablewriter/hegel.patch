+package hegel
+
+// The boxed rendering (renderer.Blueprint) against an exact model: the same prepared table as
+// the Markdown/HTML properties, laid out as border lines (corner, junction and edge glyphs of
+// the style, a horizontal segment per visible column) and cell lines (the column glyph as
+// left/right border and separator, every cell padded to its column width by the alignment),
+// under every combination of the rendition's borders, separators and lines.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var borderStyles = []tw.BorderStyle{
+	tw.StyleASCII, tw.StyleLight, tw.StyleHeavy, tw.StyleDouble, tw.StyleRounded, tw.StyleDotted,
+	tw.StyleLightHeavy, tw.StyleLightDouble, tw.StyleMarkdown, tw.StyleNone, tw.StyleGraphical,
+}
+
+var stateChoices = []tw.State{tw.Unknown, tw.On, tw.Off}
+
+type rendSpec struct {
+	style   tw.BorderStyle
+	borders tw.Border
+	seps    tw.Separators
+	lines   tw.Lines
+}
+
+var (
+	styleChoice = hegel.SampledFrom(borderStyles)
+	stateChoice = hegel.SampledFrom(stateChoices)
+)
+
+// rendBorders, rendSeps, rendLines: every state from stateChoices (Unknown keeps the default).
+var rendBorders = hegel.Composite(func(tc hegel.TestCase) tw.Border {
+	return tw.Border{Left: hegel.Draw(tc, stateChoice), Right: hegel.Draw(tc, stateChoice), Top: hegel.Draw(tc, stateChoice), Bottom: hegel.Draw(tc, stateChoice)}
+})
+
+var rendSeps = hegel.Composite(func(tc hegel.TestCase) tw.Separators {
+	return tw.Separators{BetweenRows: hegel.Draw(tc, stateChoice), BetweenColumns: hegel.Draw(tc, stateChoice)}
+})
+
+var rendLines = hegel.Composite(func(tc hegel.TestCase) tw.Lines {
+	return tw.Lines{ShowTop: hegel.Draw(tc, stateChoice), ShowBottom: hegel.Draw(tc, stateChoice), ShowHeaderLine: hegel.Draw(tc, stateChoice), ShowFooterLine: hegel.Draw(tc, stateChoice)}
+})
+
+// rendSpecs: a border style and, 70% of the time each, the borders, the separators and the
+// lines set.
+var rendSpecs = hegel.Composite(func(tc hegel.TestCase) rendSpec {
+	return rendSpec{
+		style:   hegel.Draw(tc, styleChoice),
+		borders: hegel.Draw(tc, maybe(70, rendBorders)),
+		seps:    hegel.Draw(tc, maybe(70, rendSeps)),
+		lines:   hegel.Draw(tc, maybe(70, rendLines)),
+	}
+})
+
+func (r rendSpec) GoString() string { return r.String() }
+
+func (r rendSpec) rendition() tw.Rendition {
+	return tw.Rendition{Symbols: tw.NewSymbols(r.style), Borders: r.borders, Settings: tw.Settings{Separators: r.seps, Lines: r.lines}}
+}
+
+func (r rendSpec) String() string {
+	return "style=" + tw.NewSymbols(r.style).Name() + " borders=" + states(r.borders.Left, r.borders.Right, r.borders.Top, r.borders.Bottom) +
+		" seps=" + states(r.seps.BetweenRows, r.seps.BetweenColumns) + " lines=" + states(r.lines.ShowTop, r.lines.ShowBottom, r.lines.ShowHeaderLine, r.lines.ShowFooterLine)
+}
+
+func states(ss ...tw.State) string {
+	parts := make([]string, len(ss))
+	for i, s := range ss {
+		switch s {
+		case tw.On:
+			parts[i] = "on"
+		case tw.Off:
+			parts[i] = "off"
+		default:
+			parts[i] = "-"
+		}
+	}
+	return strings.Join(parts, ",")
+}
+
+// effective settings: an unset state keeps the renderer's default (everything on but the
+// separators between rows)
+func eff(s tw.State, def bool) bool {
+	switch s {
+	case tw.On:
+		return true
+	case tw.Off:
+		return false
+	}
+	return def
+}
+
+type layout struct {
+	left, right, top, bottom       bool
+	betweenRows, betweenCols       bool
+	showTop, showBottom            bool
+	showHeaderLine, showFooterLine bool
+	sym                            tw.Symbols
+}
+
+func (r rendSpec) layout() layout {
+	return layout{
+		left: eff(r.borders.Left, true), right: eff(r.borders.Right, true), top: eff(r.borders.Top, true), bottom: eff(r.borders.Bottom, true),
+		betweenRows: eff(r.seps.BetweenRows, false), betweenCols: eff(r.seps.BetweenColumns, true),
+		showTop: eff(r.lines.ShowTop, true), showBottom: eff(r.lines.ShowBottom, true),
+		showHeaderLine: eff(r.lines.ShowHeaderLine, true), showFooterLine: eff(r.lines.ShowFooterLine, true),
+		sym: tw.NewSymbols(r.style),
+	}
+}
+
+const (
+	lvHeader = iota
+	lvBody
+	lvFooter
+)
+
+const (
+	locFirst = iota
+	locMiddle
+	locEnd
+)
+
+// lineCtx is the tw.Formatting a separator line is rendered with: its level and location, the
+// section of the line above (Position), the merge states of the cells above and below, whether
+// a footer follows, and the widths its segments follow (a header's own widths for the top
+// border, the rows' otherwise).
+type lineCtx struct {
+	level, loc, pos int
+	cur, next       []cellMerge
+	hasFooter       bool
+	widths          []int
+}
+
+func w0(s string) int { return width(s, widthOpts{}) }
+
+// leftGlyph is the model of Junction.RenderLeft.
+func (l layout) leftGlyph(lc lineCtx) string {
+	if (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst {
+		return l.sym.TopLeft()
+	}
+	if (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter) || (lc.level == lvFooter && lc.loc == locEnd) {
+		return l.sym.BottomLeft()
+	}
+	if vpass(getMerge(lc.cur, 0), getMerge(lc.next, 0)) {
+		return l.sym.Column()
+	}
+	return l.sym.MidLeft()
+}
+
+// rightGlyph is the model of Junction.RenderRight.
+func (l layout) rightGlyph(lc lineCtx, last int) string {
+	if last < 0 {
+		switch lc.level {
+		case lvHeader:
+			return l.sym.TopRight()
+		case lvFooter:
+			return l.sym.BottomRight()
+		}
+		switch lc.loc {
+		case locFirst:
+			return l.sym.TopRight()
+		case locEnd:
+			return l.sym.BottomRight()
+		}
+		return l.sym.MidRight()
+	}
+	if (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst {
+		return l.sym.TopRight()
+	}
+	if (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter) || (lc.level == lvFooter && lc.loc == locEnd) {
+		return l.sym.BottomRight()
+	}
+	if vpass(getMerge(lc.cur, last), getMerge(lc.next, last)) {
+		return l.sym.Column()
+	}
+	return l.sym.MidRight()
+}
+
+// junctionGlyph is the model of Junction.RenderJunction between two visible columns.
+func (l layout) junctionGlyph(lc lineCtx, left, right int) string {
+	curL, curR := getMerge(lc.cur, left), getMerge(lc.cur, right)
+	nextL, nextR := getMerge(lc.next, left), getMerge(lc.next, right)
+	spannedCur := curL.h.present && !curL.h.end
+	spannedNext := nextL.h.present && !nextL.h.end
+	// the junction lies inside a merge below when the right column continues it; the renderer
+	// asks whether the left column ends one, which differs above a merged header, whose
+	// continuing columns have no width (bug 33)
+	if !Known.topJunctionAfterMerge {
+		spannedNext = nextR.h.present && !nextR.h.start
+	}
+	passL := vpass(curL, nextL)
+	passR := vpass(curR, nextR)
+	isTop := (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst
+	isBottom := (lc.level == lvFooter && lc.loc == locEnd) || (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter)
+	isPreFooter := lc.level == lvFooter && (lc.pos == secRow || lc.pos == secHeader)
+	sym := l.sym
+	if isTop {
+		if spannedNext {
+			return sym.Row()
+		}
+		return sym.TopMid()
+	}
+	if isBottom {
+		switch {
+		case passL && passR:
+			return sym.Column()
+		case passL:
+			return sym.MidLeft()
+		case passR:
+			return sym.MidRight()
+		case spannedCur:
+			return sym.Row()
+		}
+		return sym.BottomMid()
+	}
+	if isPreFooter {
+		switch {
+		case passL && passR:
+			return sym.Column()
+		case passL:
+			return sym.MidLeft()
+		case passR:
+			return sym.MidRight()
+		}
+		if curL.h.present {
+			if !curL.h.end && curR.h.present && !curR.h.end {
+				return sym.BottomMid()
+			}
+			if !curL.h.end && curR.h.present && curR.h.end {
+				return sym.BottomMid()
+			}
+			if curL.h.end && !curR.h.present {
+				return sym.Center()
+			}
+		}
+		if spannedNext {
+			return sym.BottomMid()
+		}
+		if spannedCur {
+			return sym.TopMid()
+		}
+		return sym.Center()
+	}
+	switch {
+	case passL && passR:
+		return sym.Column()
+	case passL:
+		return sym.MidLeft()
+	case passR:
+		return sym.MidRight()
+	case spannedCur && spannedNext:
+		return sym.Row()
+	case spannedCur:
+		return sym.TopMid()
+	case spannedNext:
+		return sym.BottomMid()
+	}
+	return sym.Center()
+}
+
+// borderLine is the model of Blueprint.Line: a horizontal segment per visible column (spaces
+// where a vertical merge passes through), the widths of the first and last adjusted by how
+// much the corner glyphs are wider than the column glyph, junctions of the column glyph's
+// width (else the centre glyph, else the column glyph), the whole between the left and right
+// glyphs the junction rules pick.
+func (l layout) borderLine(m tableModel, lc lineCtx) string {
+	if m.numCols == 0 {
+		var pre, suf string
+		if l.left {
+			pre = l.leftGlyph(lc)
+		}
+		if l.right {
+			suf = l.rightGlyph(lc, -1)
+		}
+		if pre == "" && suf == "" {
+			return ""
+		}
+		return pre + suf + "\n"
+	}
+	var visible []int
+	for i := 0; i < m.numCols; i++ {
+		if lc.widths[i] > 0 {
+			visible = append(visible, i)
+		}
+	}
+	var b strings.Builder
+	colW := w0(l.sym.Column())
+	leftG := ""
+	if l.left {
+		leftG = l.leftGlyph(lc)
+		b.WriteString(leftG)
+	}
+	for k, i := range visible {
+		adj := lc.widths[i]
+		if l.left && k == 0 {
+			adj -= w0(leftG) - colW
+		}
+		if l.right && k == len(visible)-1 {
+			adj -= w0(l.rightGlyph(lc, i)) - colW
+		}
+		adj = max(adj, 0)
+		seg := l.sym.Row()
+		if vpass(getMerge(lc.cur, i), getMerge(lc.next, i)) {
+			seg = ""
+		}
+		if seg == "" {
+			b.WriteString(strings.Repeat(" ", adj))
+		} else {
+			segW := max(w0(seg), 1)
+			rep := adj / segW
+			if rep < 1 && adj > 0 {
+				rep = 1
+			}
+			out := strings.Repeat(seg, rep)
+			if w0(out) > adj {
+				out = truncate(out, adj, "", widthOpts{})
+			} else if w0(out) < adj {
+				for j := 0; j < (adj-w0(out))/segW; j++ {
+					out += seg
+				}
+				if w0(out) < adj {
+					out += strings.Repeat(" ", adj-w0(out))
+				}
+			}
+			b.WriteString(out)
+		}
+		if k < len(visible)-1 && l.betweenCols {
+			junction := l.junctionGlyph(lc, i, visible[k+1])
+			if w0(junction) != colW {
+				junction = l.sym.Center()
+				if w0(junction) != colW {
+					junction = l.sym.Column()
+				}
+			}
+			b.WriteString(junction)
+		}
+	}
+	if l.right && len(visible) > 0 {
+		b.WriteString(l.rightGlyph(lc, visible[len(visible)-1]))
+	}
+	b.WriteString("\n")
+	return b.String()
+}
+
+func (m tableModel) visibleCols() []int {
+	var visible []int
+	for i := 0; i < m.numCols; i++ {
+		if !m.hidden[i] {
+			visible = append(visible, i)
+		}
+	}
+	return visible
+}
+
+func padOr(p string) string {
+	if p == "" {
+		return " "
+	}
+	return p
+}
+
+// bpCell is the model of Blueprint.formatCell.
+func bpCell(content string, w int, pad tw.Padding, align tw.Align) string {
+	if w <= 0 {
+		return ""
+	}
+	o := widthOpts{}
+	cw := width(content, o)
+	pl, pr := w0(pad.Left), w0(pad.Right)
+	avail := max(w-pl-pr, 0)
+	if cw > avail {
+		content = truncate(content, avail, "", o)
+		cw = width(content, o)
+	}
+	total := max(w-cw, 0)
+	var out string
+	switch align {
+	case tw.AlignRight:
+		if n := total - pr; n > 0 {
+			out = strings.Repeat(padOr(pad.Left), n)
+		}
+		out += content + pad.Right
+	case tw.AlignCenter:
+		left := (total-pl-pr)/2 + pl
+		right := total - left
+		if left > pl {
+			out = strings.Repeat(padOr(pad.Left), left-pl)
+		}
+		out += pad.Left + content + pad.Right
+		if right > pr {
+			out += strings.Repeat(padOr(pad.Right), right-pr)
+		}
+	default:
+		out = pad.Left + content
+		if n := total - pl; n > 0 {
+			out += strings.Repeat(padOr(pad.Right), n)
+		}
+	}
+	if fw := width(out, o); fw > w {
+		out = truncate(out, w, "", o)
+	} else if fw < w {
+		out += strings.Repeat(" ", w-fw)
+	}
+	return out
+}
+
+// bpAlign resolves a cell's alignment as the renderer does: an explicit one is kept; AlignNone
+// or the empty alignment falls to the left (Known.alignNoneLeft) or to the section's default.
+func bpAlign(a tw.Align, sec int) tw.Align {
+	if explicit(a) {
+		return a
+	}
+	if Known.alignNoneLeft {
+		return tw.AlignLeft
+	}
+	switch sec {
+	case secHeader:
+		return tw.AlignCenter
+	case secFooter:
+		return tw.AlignRight
+	}
+	return tw.AlignLeft
+}
+
+// cellLine is the model of Blueprint.renderLine for a visual line of a section: every column
+// of width 0 is skipped unless it starts a horizontal merge; a separator precedes a column
+// when the previous one has a width or ends a merge, and the column does not continue one; a
+// merge's first cell takes the span's width (a row's from the normalized widths, a header's or
+// footer's as pre-computed) and the continuing cells print nothing; an AlignNone cell that
+// starts a footer merge or follows a "total" cell is right-aligned; a cell continuing a
+// vertical or hierarchical merge is blank.
+func (l layout) cellLine(m tableModel, s tableSpec, line []string, sec int, merges []cellMerge, widths []int) string {
+	line = padLine(line, m.numCols)
+	aligns := s.aligns(sec, m.numCols)
+	colW := w0(l.sym.Column())
+	sepW := 0
+	if l.betweenCols {
+		sepW = colW
+	}
+	var b strings.Builder
+	if l.left {
+		b.WriteString(l.sym.Column())
+	}
+	seen := false
+	for i := 0; i < m.numCols; {
+		st := getMerge(merges, i)
+		vw := widths[i]
+		hStart := st.h.present && st.h.start
+		if vw == 0 && !hStart {
+			i++
+			continue
+		}
+		if i > 0 && l.betweenCols {
+			prev := getMerge(merges, i-1)
+			prevEnd := prev.h.present && prev.h.end
+			before := widths[i-1] > 0 || prevEnd
+			if !Known.autoHideSeparator && seen {
+				before = true // the renderer looks at the previous column's width, hidden or not
+			}
+			if before && (!st.h.present || st.h.start) {
+				b.WriteString(l.sym.Column())
+			}
+		}
+		span := 1
+		if hStart {
+			span = st.h.span
+			if sec == secRow {
+				vw = 0
+				for k := 0; k < span && i+k < m.numCols; k++ {
+					vw += max(m.widths[i+k], 0)
+					if k > 0 && sepW > 0 && m.widths[i+k] > 0 {
+						vw += sepW
+					}
+				}
+			}
+		}
+		vw = max(vw, 0)
+		if st.h.present && !st.h.start {
+			i++
+			continue
+		}
+		a := aligns[i]
+		isTotal := hStart && i > 0 && strings.Contains(strings.ToLower(line[i-1]), "total")
+		if ((sec == secFooter && hStart) || isTotal) && a == tw.AlignNone {
+			a = tw.AlignRight
+		}
+		data := line[i]
+		if (st.v.present && !st.v.start) || (st.hier.present && !st.hier.start) {
+			data = ""
+		}
+		b.WriteString(bpCell(data, vw, s.pad(), bpAlign(a, sec)))
+		seen = true
+		i += span
+	}
+	if l.right {
+		b.WriteString(l.sym.Column())
+	}
+	b.WriteString("\n")
+	return b.String()
+}
+
+// blueprint is the model of the whole boxed rendering. A table without columns renders
+// nothing (under Known.emptyRecordFrame its empty records are framed, bug 18), and so does one
+// whose every column AutoHide hides (bug 16: lines of different widths instead; such tables are
+// left out under the switch).
+func (s tableSpec) blueprint(r rendSpec) string {
+	m := s.model()
+	if m.numCols == 0 && !(Known.emptyRecordFrame && len(m.records) > 0) {
+		return ""
+	}
+	if s.autoHide && len(m.visibleCols()) == 0 && !Known.autoHideAllColumns {
+		return ""
+	}
+	l := r.layout()
+	hW := m.mergedWidths(m.hdrM, l)
+	fW := m.mergedWidths(m.ftrM, l)
+	rW := m.widths
+	var b strings.Builder
+	hasRecords := len(m.records) > 0 // the table counts records, with or without cells
+	hasFooter := m.footer != nil
+	hasHeader := m.header != nil
+	// the states of the last line above the footer (or the bottom border), and its section
+	abovePos, aboveM := secHeader, m.hdrM
+	if hasRecords {
+		abovePos, aboveM = secRow, m.recM[len(m.recM)-1]
+	}
+	if hasHeader {
+		if l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secHeader, next: m.hdrM, widths: hW}))
+		}
+		for _, line := range m.header {
+			b.WriteString(l.cellLine(m, s, line, secHeader, m.hdrM, hW))
+		}
+		// the header separator; between a header and a footer with no rows the footer
+		// separator follows at once (bug 17), so only one line is due there
+		if l.showHeaderLine && (hasRecords || hasFooter) && !(hasFooter && !hasRecords && l.showFooterLine && !Known.doubleSeparator) {
+			next := m.ftrM
+			if hasRecords {
+				next = m.recM[0]
+			}
+			b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secHeader, cur: m.hdrM, next: next, widths: rW}))
+		}
+	}
+	if hasRecords {
+		if !hasHeader && (!hasFooter || !Known.noTopBorderWithoutHeader) && l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secRow, next: m.recM[0], widths: rW}))
+		}
+		for i, rec := range m.records {
+			for _, line := range rec {
+				b.WriteString(l.cellLine(m, s, line, secRow, m.recM[i], rW))
+			}
+			if l.betweenRows && i < len(m.records)-1 {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secRow, cur: m.recM[i], next: m.recM[i+1], hasFooter: hasFooter, widths: rW}))
+			}
+		}
+	}
+	above := hasHeader || hasRecords
+	if !hasFooter {
+		if above && l.bottom && l.showBottom {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: abovePos, cur: aboveM, widths: rW}))
+		}
+		return b.String()
+	}
+	if !above && !Known.noTopBorderWithoutHeader && l.top && l.showTop {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secFooter, next: m.ftrM, widths: rW}))
+	}
+	if above && l.showFooterLine {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locMiddle, pos: abovePos, cur: aboveM, next: m.ftrM, hasFooter: true, widths: rW}))
+	}
+	for _, line := range m.footer {
+		b.WriteString(l.cellLine(m, s, line, secFooter, m.ftrM, fW))
+	}
+	if l.bottom && l.showBottom {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: secFooter, cur: m.ftrM, widths: rW}))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- caption
+
+var captionTexts = []string{
+	"Table 1", "A caption that is rather longer than the table below it, to be wrapped",
+	"x", "two\nlines", "  spaced  ", "あいう えお", "word " + esc + "[1mbold" + esc + "[0m end",
+}
+
+var captionSpots = []tw.Spot{
+	tw.SpotNone, tw.SpotTopLeft, tw.SpotTopCenter, tw.SpotTopRight,
+	tw.SpotBottomLeft, tw.SpotBottomCenter, tw.SpotBottomRight, tw.SpotLeftTop,
+}
+
+// withCaption is the model of Render's caption handling around the rendered table: a side
+// spot prints nothing; an empty table with a border is replaced by +--+ lines under
+// Known.captionPlaceholder (bug 23), else the caption stands alone; the caption is
+// wrapped (WrapString) to its Width, else to the table's width, else (a table narrower than
+// five cells) to its own width, and every line padded (tw.Pad) to the same target with the
+// caption's alignment, the spot's default standing in for an unset one.
+func (s tableSpec) withCaption(table string, r rendSpec) string {
+	c := s.caption
+	if c == nil || c.Text == "" {
+		return table
+	}
+	spot := c.Spot
+	if spot == tw.SpotNone {
+		spot = tw.SpotBottomCenter
+	}
+	if spot < tw.SpotTopLeft || spot > tw.SpotBottomRight {
+		return table
+	}
+	l := r.layout()
+	content := table
+	if content == "" && (l.top || l.bottom) && Known.captionPlaceholder {
+		var sb strings.Builder
+		if l.top {
+			sb.WriteString("+--+\n")
+		}
+		if l.bottom {
+			sb.WriteString("+--+")
+		}
+		content = sb.String()
+	}
+	tableW := 0
+	for _, ln := range strings.Split(strings.TrimRight(content, "\r\n \t"), "\n") {
+		tableW = max(tableW, w0(ln))
+	}
+	wrapW := tableW
+	if c.Width > 0 {
+		wrapW = c.Width
+	} else if tableW <= 4 {
+		wrapW = w0(c.Text)
+	}
+	if wrapW <= 0 {
+		wrapW = 10
+	}
+	target := tableW
+	if c.Width > 0 {
+		target = c.Width
+	} else if tableW <= 4 {
+		target = wrapW
+	}
+	align := c.Align
+	if align == "" || align == tw.AlignNone || (align == tw.AlignLeft && Known.captionAlignLeft) {
+		switch spot {
+		case tw.SpotTopLeft, tw.SpotBottomLeft:
+			align = tw.AlignLeft
+		case tw.SpotTopRight, tw.SpotBottomRight:
+			align = tw.AlignRight
+		default:
+			align = tw.AlignCenter
+		}
+	}
+	lines, _ := wrapString(c.Text, wrapW)
+	var cap strings.Builder
+	for _, ln := range lines {
+		cap.WriteString(padAlign(ln, " ", target, align, widthOpts{}))
+		cap.WriteString("\n")
+	}
+	if spot <= tw.SpotTopRight {
+		return cap.String() + content
+	}
+	out := content
+	if content != "" && !strings.HasSuffix(content, "\n") {
+		out += "\n"
+	}
+	return out + cap.String()
+}
+
+var wrapChoices = []int{tw.WrapNone, tw.WrapNormal, tw.WrapTruncate, tw.WrapBreak}
+
+var (
+	wrapModes       = hegel.SampledFrom(wrapChoices)
+	colWidthChoices = hegel.SampledFrom([]int{0, 1, 2, 3, 5, 8, 12, -1})
+	captionWidths   = hegel.SampledFrom([]int{0, 0, 0, 4, 8, 20})
+)
+
+// perSection: for each of the three sections, a value of g pct percent of the time, else 0
+// (the option not given).
+func perSection(pct int, g hegel.Generator[int]) hegel.Generator[[3]int] {
+	each := maybe(pct, g)
+	return hegel.Composite(func(tc hegel.TestCase) [3]int {
+		return [3]int{hegel.Draw(tc, each), hegel.Draw(tc, each), hegel.Draw(tc, each)}
+	})
+}
+
+// colWidthMaps: one to three per-column widths from colWidthChoices for columns 0 to maxCol.
+func colWidthMaps(maxCol int) hegel.Generator[map[int]int] {
+	return hegel.Maps(hegel.Integers(0, maxCol), colWidthChoices).MinSize(1).MaxSize(3)
+}
+
+// captions: one of captionTexts on one of captionSpots, aligned by alignChoices, of a width
+// from captionWidths.
+var captions = hegel.Composite(func(tc hegel.TestCase) tw.Caption {
+	return tw.Caption{
+		Text:  hegel.Draw(tc, hegel.SampledFrom(captionTexts)),
+		Spot:  hegel.Draw(tc, hegel.SampledFrom(captionSpots)),
+		Align: hegel.Draw(tc, alignChoice),
+		Width: hegel.Draw(tc, captionWidths),
+	}
+})
+
+// constraintSpecs: each section's wrap mode set half of the time and its maximum width (1 to
+// 12) 40% of the time; 40% of the time each: per-column widths (columns 0 to 4), a table
+// maximum width of 1 to 30, a caption.
+var constraintSpecs = hegel.Composite(func(tc hegel.TestCase) constraints {
+	return constraints{
+		wrap:      hegel.Draw(tc, perSection(50, wrapModes)),
+		secMax:    hegel.Draw(tc, perSection(40, hegel.Integers(1, 12))),
+		colWidths: hegel.Draw(tc, maybe(40, colWidthMaps(4))),
+		maxWidth:  hegel.Draw(tc, maybe(40, hegel.Integers(1, 30))),
+		caption:   hegel.Draw(tc, optional(40, captions)),
+	}
+})
+
+// boxedTables: the tables of the boxed properties (tableSpecs with a padding from
+// paddingChoices and no HTML configuration).
+var boxedTables = tables(tableShape{cells: cellTexts, minCells: 0, minRows: 0, maxRows: 4, boxed: true})
+
+// constrainedTables: boxedTables under constraintSpecs.
+var constrainedTables = hegel.Composite(func(tc hegel.TestCase) tableSpec {
+	s := hegel.Draw(tc, boxedTables)
+	s.constraints = hegel.Draw(tc, constraintSpecs)
+	return s
+})
+
+// allHidden: AutoHide hides every column of a table that has some (bug 16).
+func (s tableSpec) allHidden() bool {
+	m := s.model()
+	return s.autoHide && m.numCols > 0 && len(m.visibleCols()) == 0
+}
+
+// visibleTables: under Known.autoHideAllColumns, the tables of g that AutoHide leaves a column
+// of; else g itself.
+func visibleTables(g hegel.Generator[tableSpec]) hegel.Generator[tableSpec] {
+	if !Known.autoHideAllColumns {
+		return g
+	}
+	return hegel.Filter(g, func(s tableSpec) bool { return !s.allHidden() })
+}
+
+// boxedCase: a boxed table and the rendition it is rendered with.
+type boxedCase struct {
+	s tableSpec
+	r rendSpec
+}
+
+func (k boxedCase) GoString() string { return k.s.String() + " " + k.r.String() }
+
+func boxedCases(specs hegel.Generator[tableSpec]) hegel.Generator[boxedCase] {
+	return hegel.Composite(func(tc hegel.TestCase) boxedCase {
+		return boxedCase{s: hegel.Draw(tc, visibleTables(specs)), r: hegel.Draw(tc, rendSpecs)}
+	})
+}
+
+var (
+	blueprintCases  = boxedCases(boxedTables)
+	constraintCases = boxedCases(constrainedTables)
+)
+
+// TestHegelConstraints: the boxed rendering under width constraints (per-column widths, the
+// sections' maximum widths, the table's maximum width), the wrap modes and a caption.
+func TestHegelConstraints(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkConstraints(c, ht, hegel.Draw(ht, constraintCases))
+	})
+}
+
+// checkConstraints is the body of TestHegelConstraints for one case: the boxed rendering under
+// the case's width constraints, wrap modes and caption equals the model's.
+func checkConstraints(c *collector, ht *hegel.T, k boxedCase) {
+	s, r := k.s, k.r
+	m := s.model()
+	if m.numCols == 0 {
+		c.count("no columns")
+	}
+	if s.allHidden() {
+		c.count("all hidden")
+	}
+	s.classify(c)
+	for sec, name := range []string{"header", "row", "footer"} {
+		c.count(name + " wrap " + itoa(s.wrapMode(sec)))
+	}
+	if s.colWidths != nil {
+		c.count("colWidths")
+	}
+	if s.maxWidth > 0 {
+		c.count("maxWidth")
+	}
+	if s.caption != nil {
+		c.count("caption")
+	}
+	got, err := s.render(renderer.NewBlueprint(r.rendition()))
+	if err != nil {
+		c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+		return
+	}
+	want := s.withCaption(s.blueprint(r), r)
+	if got != want {
+		c.failClass(ht, "constraints", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+	}
+}
+
+var paddingChoices = []*tw.Padding{nil, nil, nil, {Left: "", Right: "", Overwrite: true}, {Left: "*", Right: "**"}, {Left: "", Right: ">"}}
+
+func TestHegelBlueprint(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkBlueprint(c, ht, hegel.Draw(ht, blueprintCases))
+	})
+}
+
+// checkBlueprint is the body of TestHegelBlueprint for one case: the boxed rendering equals the
+// model's, and every line of a bordered table is as wide as the others.
+func checkBlueprint(c *collector, ht *hegel.T, k boxedCase) {
+	s, r := k.s, k.r
+	m := s.model()
+	if m.numCols == 0 {
+		c.count("no columns") // an empty table, or empty records alone (bug 18)
+	}
+	if s.allHidden() {
+		c.count("all hidden") // bug 16
+	}
+	s.classify(c)
+	c.count("style " + m0(tw.NewSymbols(r.style).Name()))
+	got, err := s.render(renderer.NewBlueprint(r.rendition()))
+	if err != nil {
+		c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+		return
+	}
+	want := s.blueprint(r)
+	if got != want {
+		c.failClass(ht, "blueprint", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+		return
+	}
+	// every line of a bordered table is as wide as the others; under the switches the
+	// check is skipped where a separator was dropped after a hidden column (bug 15), where
+	// AutoFormat mangled an escape sequence (bug 19), which Truncate and Width then measure
+	// differently (bug 20), and on a lone column narrower than the two corner glyphs'
+	// excess over the column glyph (StyleGraphical, bug 21)
+	l := r.layout()
+	skip := false
+	for i := 1; i < m.numCols; i++ {
+		if Known.autoHideSeparator && l.betweenCols && m.hidden[i-1] && !m.hidden[i] {
+			skip = true
+		}
+	}
+	if s.mangledEscape() {
+		c.count("mangled escape")
+		skip = skip || Known.autoFormatEscapes
+	}
+	if vis := m.visibleCols(); len(vis) == 1 && l.left && l.right {
+		colW := w0(l.sym.Column())
+		if m.widths[vis[0]] < w0(l.sym.TopLeft())-colW+w0(l.sym.TopRight())-colW {
+			c.count("narrow corners")
+			skip = skip || Known.graphicalNarrowCorners
+		}
+	}
+	if l.left && l.right && r.style != tw.StyleNone && !skip {
+		lines := strings.Split(strings.TrimSuffix(got, "\n"), "\n")
+		for _, ln := range lines {
+			if w0(ln) != w0(lines[0]) {
+				c.failClass(ht, "ragged", "Blueprint of %s %s has lines of different widths:\n%s", s, r, got)
+				break
+			}
+		}
+	}
+}
+
+func m0(s string) string { return strings.ToLower(s) }
+
+// mangledEscape reports whether an auto-formatted section holds a cell with an escape
+// sequence (bug 19: SplitCamelCase and Title rewrite it).
+func (s tableSpec) mangledEscape() bool {
+	has := func(cells []string) bool {
+		for _, c := range cells {
+			if strings.Contains(c, esc) {
+				return true
+			}
+		}
+		return false
+	}
+	if s.autoFormat[secHeader] && has(s.header) || s.autoFormat[secFooter] && has(s.footer) {
+		return true
+	}
+	if s.autoFormat[secRow] {
+		for _, r := range s.rows {
+			if has(r) {
+				return true
+			}
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_fn_test.go b/hegel/hegel_fn_test.go
new file mode 100644
index 0000000..9fb1f1a
--- /dev/null
+++ b/hegel/hegel_fn_test.go
@@ -0,0 +1,276 @@
+package hegel
+
+// Properties of the tw helpers: Title, SplitCamelCase, IsNumeric, BreakPoint and the Pad
+// family against models of their documentation.
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var titlePieces = []string{"a", "b", "name", "Name", "ID", "1", "25", "_", ".", " ", "  ", "x", "\u00DF", "\u3042", "\u00E9", "-", "\u00E9.5", "1.5", "_.", "._"}
+
+func numOrSpace(r rune) bool { return ('0' <= r && r <= '9') || r == ' ' }
+
+// title is the model of tw.Title: underscores become spaces, dots too unless between digits or
+// spaces; the result is trimmed, a non-empty input trimmed to nothing is one space, and the
+// whole is upper-cased.
+func title(name string) string {
+	rs := []rune(name)
+	for i, r := range rs {
+		switch r {
+		case '_':
+			rs[i] = ' '
+		case '.':
+			if (i > 0 && !numOrSpace(rs[i-1])) || (i < len(rs)-1 && !numOrSpace(rs[i+1])) {
+				rs[i] = ' '
+			}
+		}
+	}
+	out := strings.TrimSpace(string(rs))
+	if out == "" && name != "" {
+		out = " "
+	}
+	return strings.ToUpper(out)
+}
+
+var camelPieces = []string{"a", "bc", "Def", "GHI", "j", "1", "23", "_", "__", " ", "\t", "-", "\u00E9", "\u00C9", "\u3042", "\u01C5", "X"}
+
+func runeClass(r rune) int {
+	switch {
+	case unicode.IsLower(r):
+		return 1
+	case unicode.IsUpper(r):
+		return 2
+	case unicode.IsDigit(r):
+		return 3
+	}
+	return 4
+}
+
+// splitCamelCase is the model of tw.SplitCamelCase: runs of one class (lower, upper, digit,
+// other); an upper run followed by a lower run lends it its last rune; empty, blank and
+// underscore groups are dropped (only a lone underscore under Known.camelUnderscoreGroups).
+func splitCamelCase(src string) []string {
+	var groups [][]rune
+	last := 0
+	for _, r := range src {
+		c := runeClass(r)
+		if c == last && len(groups) > 0 {
+			groups[len(groups)-1] = append(groups[len(groups)-1], r)
+		} else {
+			groups = append(groups, []rune{r})
+		}
+		last = c
+	}
+	for i := 0; i < len(groups)-1; i++ {
+		if len(groups[i]) > 0 && unicode.IsUpper(groups[i][0]) && len(groups[i+1]) > 0 && unicode.IsLower(groups[i+1][0]) {
+			groups[i+1] = append([]rune{groups[i][len(groups[i])-1]}, groups[i+1]...)
+			groups[i] = groups[i][:len(groups[i])-1]
+		}
+	}
+	out := []string{}
+	for _, g := range groups {
+		s := string(g)
+		if len(g) == 0 || strings.TrimSpace(s) == "" {
+			continue
+		}
+		if Known.camelUnderscoreGroups {
+			if s == "_" {
+				continue
+			}
+		} else if strings.Trim(s, "_") == "" {
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+var numericPieces = []string{"0", "1", "25", "-", "+", ".", "e", "E", " ", "x", "inf", "NaN", "_", ",", "1_0", "0x1p-2", "Infinity"}
+
+func isNumeric(s string) bool {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return false
+	}
+	if _, err := strconv.Atoi(s); err == nil {
+		return true
+	}
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// breakPoint is the model of tw.BreakPoint: the number of leading runes whose display width
+// fits the limit, escape sequences taking no width (under Known.breakPointEscapes their runes
+// count as visible characters, as the package measures each rune alone).
+func breakPoint(s string, limit int, o widthOpts) int {
+	if limit <= 0 || s == "" {
+		return 0
+	}
+	cw, n := 0, 0
+	for _, t := range scan(s) {
+		if t.seq && !Known.breakPointEscapes {
+			n += len([]rune(t.s))
+			continue
+		}
+		for _, r := range t.s {
+			w := runeWidth(r, o)
+			if t.seq {
+				w = width(string(r), o)
+			}
+			if cw+w > limit {
+				if cw == 0 {
+					if w > limit {
+						return 1
+					}
+					return 0
+				}
+				return n
+			}
+			cw += w
+			n++
+		}
+	}
+	return n
+}
+
+func padCenter(s, pad string, w int, o widthOpts) string {
+	gap := w - width(s, o)
+	if gap <= 0 {
+		return s
+	}
+	left := (gap + 1) / 2
+	return strings.Repeat(pad, left) + s + strings.Repeat(pad, gap-left)
+}
+
+func padRight(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return s + strings.Repeat(pad, gap)
+	}
+	return s
+}
+
+func padLeft(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return strings.Repeat(pad, gap) + s
+	}
+	return s
+}
+
+func padAlign(s, pad string, w int, a tw.Align, o widthOpts) string {
+	if width(s, o) > w {
+		return truncate(s, w, "", o)
+	}
+	switch a {
+	case tw.AlignRight:
+		return padLeft(s, pad, w, o)
+	case tw.AlignCenter:
+		return padCenter(s, pad, w, o)
+	}
+	return padRight(s, pad, w, o)
+}
+
+var aligns = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+// fnCase: a name for Title, a source for SplitCamelCase, a text for IsNumeric, and for
+// BreakPoint and the Pad family the options, a string without ST-terminated sequences, a
+// limit, a width, a padding string and an alignment.
+type fnCase struct {
+	name, src, num string
+	o              widthOpts
+	s              string
+	limit, w       int
+	pad            string
+	a              tw.Align
+}
+
+var (
+	titleTexts   = pieces(titlePieces, 6)
+	camelTexts   = pieces(camelPieces, 6)
+	numericTexts = pieces(numericPieces, 4)
+	fnStrs       = strs(strOpts{maxPieces: 5, noST: true})
+	padStrings   = hegel.SampledFrom([]string{" ", "*", "-", "\u3042", ""})
+	alignments   = hegel.SampledFrom(aligns)
+)
+
+var fnCases = hegel.Composite(func(tc hegel.TestCase) fnCase {
+	return fnCase{
+		name:  hegel.Draw(tc, titleTexts),
+		src:   hegel.Draw(tc, camelTexts),
+		num:   hegel.Draw(tc, numericTexts),
+		o:     hegel.Draw(tc, widthOptions),
+		s:     hegel.Draw(tc, fnStrs),
+		limit: hegel.Draw(tc, hegel.Integers(-1, 10)),
+		w:     hegel.Draw(tc, hegel.Integers(-1, 12)),
+		pad:   hegel.Draw(tc, padStrings),
+		a:     hegel.Draw(tc, alignments),
+	}
+})
+
+func TestHegelFn(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		checkFn(c, ht, hegel.Draw(ht, fnCases))
+	})
+}
+
+// checkFn is the body of TestHegelFn for one case: Title, SplitCamelCase, IsNumeric, BreakPoint
+// and the Pad family against their models.
+func checkFn(c *collector, ht *hegel.T, k fnCase) {
+	{
+		name := k.name
+		if got, want := tw.Title(name), title(name); got != want {
+			c.failClass(ht, "Title", "Title(%q) = %q, want %q", name, got, want)
+		}
+		src := k.src
+		if got, want := tw.SplitCamelCase(src), splitCamelCase(src); !sameStrings(got, want) {
+			c.failClass(ht, "SplitCamelCase", "SplitCamelCase(%q) = %q, want %q", src, got, want)
+		}
+		if strings.Contains(src, "__") {
+			c.count("double underscore")
+		}
+		num := k.num
+		if got, want := tw.IsNumeric(num), isNumeric(num); got != want {
+			c.failClass(ht, "IsNumeric", "IsNumeric(%q) = %v, want %v", num, got, want)
+		}
+		if isNumeric(num) {
+			c.count("numeric")
+		}
+
+		o := k.o
+		setOpts(o)
+		s, limit := k.s, k.limit
+		if got, want := tw.BreakPoint(s, limit), breakPoint(s, limit, o); got != want {
+			c.failClass(ht, "BreakPoint", "BreakPoint(%q, %d) %+v = %d, want %d", s, limit, o, got, want)
+		}
+		if strings.Contains(s, esc) {
+			c.count("BreakPoint with sequences")
+		}
+		w, pad := k.w, k.pad
+		if got, want := tw.PadCenter(s, pad, w), padCenter(s, pad, w, o); got != want {
+			c.failClass(ht, "PadCenter", "PadCenter(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadRight(s, pad, w), padRight(s, pad, w, o); got != want {
+			c.failClass(ht, "PadRight", "PadRight(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadLeft(s, pad, w), padLeft(s, pad, w, o); got != want {
+			c.failClass(ht, "PadLeft", "PadLeft(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		a := k.a
+		if got, want := tw.Pad(s, pad, w, a), padAlign(s, pad, w, a, o); got != want {
+			c.failClass(ht, "Pad", "Pad(%q, %q, %d, %q) %+v = %q, want %q", s, pad, w, a, o, got, want)
+		}
+		if pad == " " && width(s, o) <= w {
+			if got := tw.Pad(s, pad, w, a); width(got, o) != w {
+				c.failClass(ht, "Pad width", "Pad(%q, %q, %d, %q) %+v = %q has width %d", s, pad, w, a, o, got, width(got, o))
+			}
+		}
+	}
+}
diff --git a/hegel/hegel_input_test.go b/hegel/hegel_input_test.go
new file mode 100644
index 0000000..eb76b98
--- /dev/null
+++ b/hegel/hegel_input_test.go
@@ -0,0 +1,853 @@
+package hegel
+
+// Input conversion: Append and Bulk take []string, []any, typed slices, single values and
+// structs (with AutoHeader from the fields and their tags). Model of convertToString,
+// convertCellsToStrings and extractFieldsAndValuesFromStruct, checked through the Markdown
+// rendering of the resulting header and rows (the Markdown model of hegel_table_test.go).
+
+import (
+	"bytes"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- value types
+
+type fmtVal struct{ s string }
+
+func (f fmtVal) Format() string { return f.s }
+
+type strVal struct{ s string }
+
+func (v strVal) String() string { return v.s }
+
+// ptrStr is a Stringer on the pointer receiver: String() dereferences, so a nil *ptrStr panics.
+type ptrStr struct{ s string }
+
+func (v *ptrStr) String() string { return v.s }
+
+type errVal struct{ s string }
+
+func (e *errVal) Error() string { return e.s }
+
+// Inner1 and Inner2: named struct types to embed.
+type Inner1 struct {
+	X string
+	Y int
+}
+
+type Inner2 struct {
+	Z *string `json:"zed"`
+	W bool    `tw:"-"`
+}
+
+var (
+	tString   = reflect.TypeOf("")
+	tInt      = reflect.TypeOf(0)
+	tInt64    = reflect.TypeOf(int64(0))
+	tFloat64  = reflect.TypeOf(float64(0))
+	tBool     = reflect.TypeOf(false)
+	tPInt     = reflect.TypeOf((*int)(nil))
+	tPString  = reflect.TypeOf((*string)(nil))
+	tTime     = reflect.TypeOf(time.Time{})
+	tPTime    = reflect.TypeOf((*time.Time)(nil))
+	tNullStr  = reflect.TypeOf(sql.NullString{})
+	tNullI32  = reflect.TypeOf(sql.NullInt32{})
+	tNullI64  = reflect.TypeOf(sql.NullInt64{})
+	tBytes    = reflect.TypeOf([]byte(nil))
+	tError    = reflect.TypeOf((*error)(nil)).Elem()
+	tAny      = reflect.TypeOf((*any)(nil)).Elem()
+	tFmtVal   = reflect.TypeOf(fmtVal{})
+	tStrVal   = reflect.TypeOf(strVal{})
+	tPPtrStr  = reflect.TypeOf((*ptrStr)(nil))
+	tPErrVal  = reflect.TypeOf((*errVal)(nil))
+	tReader   = reflect.TypeOf((*io.Reader)(nil)).Elem()
+	tInner1   = reflect.TypeOf(Inner1{})
+	tPInner1  = reflect.TypeOf((*Inner1)(nil))
+	tPInner2  = reflect.TypeOf((*Inner2)(nil))
+	leafTypes = []reflect.Type{tString, tInt, tInt64, tFloat64, tBool, tPInt, tPString, tTime, tPTime, tNullStr, tNullI32, tNullI64, tBytes, tError, tAny, tFmtVal, tStrVal, tPPtrStr, tPErrVal, tReader, tInner1}
+)
+
+var leafStrings = []string{"", "a", "x|y", " sp ", "Tab\tT", "multi\nline", "あい", "ünï", "userName", "-3.5"}
+
+// leaf is a generated value with its expected cell text; bad marks a value on which the
+// package panics (a nil pointer whose String()/Error() dereferences), generated only when the
+// switch is off.
+type leaf struct {
+	v   any
+	s   string
+	bad bool
+}
+
+func ptrCell(p any, deref string) string {
+	if Known.pointerAddress {
+		return fmt.Sprintf("%v", p)
+	}
+	return deref
+}
+
+func timeAt(n int) time.Time {
+	return time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC).Add(time.Duration(n) * time.Hour)
+}
+
+func nullInt32Leaf(n int, valid bool) leaf {
+	v := sql.NullInt32{Int32: int32(n), Valid: valid}
+	want := ""
+	if v.Valid {
+		want = strconv.Itoa(n)
+	}
+	if Known.nullTypesUnhandled {
+		want = fmt.Sprintf("%v", v)
+	}
+	return leaf{v: v, s: want}
+}
+
+func nullInt64Leaf(n int, valid bool) leaf {
+	v := sql.NullInt64{Int64: int64(n), Valid: valid}
+	want := ""
+	if v.Valid {
+		want = strconv.Itoa(n)
+	}
+	return leaf{v: v, s: want}
+}
+
+// readerLeaf: an io.Reader of size bytes; the cell holds the first 512 and the ellipsis when
+// more were cut (at exactly 512 too under Known.readerEllipsisAt512).
+func readerLeaf(size int) leaf {
+	content := strings.Repeat("r", size)
+	want := content
+	if size > 512 || (Known.readerEllipsisAt512 && size == 512) {
+		want = content[:512] + tw.CharEllipsis
+	}
+	return leaf{v: strings.NewReader(content), s: want}
+}
+
+var (
+	leafTexts      = hegel.SampledFrom(leafStrings)
+	leafInts       = hegel.Integers(-3, 1000)
+	readerSizes    = hegel.SampledFrom([]int{0, 5, 511, 512, 513, 600})
+	leafTypeChoice = hegel.SampledFrom(leafTypes)
+)
+
+// leafGens: a generator of leaves per type: a value built of one of leafStrings or an integer
+// of -3 to 1000; the pointers and the nullable types nil (invalid) 30% of the time ([]byte
+// 20%); the values the package panics on (a nil pointer whose String()/Error() dereferences,
+// bug 26) at the same rate, unless Known.nilStringerPanic leaves them out; an interface value
+// nil 20% of the time, else a leaf of any type of inner (nil when inner is nil: one level of
+// nesting).
+func leafGens(inner map[reflect.Type]hegel.Generator[leaf]) map[reflect.Type]hegel.Generator[leaf] {
+	ofText := func(f func(s string) leaf) hegel.Generator[leaf] { return hegel.Map(leafTexts, f) }
+	ofInt := func(f func(n int) leaf) hegel.Generator[leaf] { return hegel.Map(leafInts, f) }
+	// nilOr: the nil value pct percent of the time, else g
+	nilOr := func(pct int, nilLeaf leaf, g hegel.Generator[leaf]) hegel.Generator[leaf] {
+		return weighted(choice[leaf]{pct, hegel.Just(nilLeaf)}, choice[leaf]{100 - pct, g})
+	}
+	// crashing: nilOr with a nil the package panics on, g alone under the switch
+	crashing := func(pct int, nilLeaf leaf, g hegel.Generator[leaf]) hegel.Generator[leaf] {
+		return shaped(nilOr(pct, nilLeaf, g), g)
+	}
+	nilLeaf := leaf{v: nil, s: ""}
+	anyLeaf := hegel.Just(nilLeaf)
+	if inner != nil {
+		anyLeaf = nilOr(20, nilLeaf, hegel.FlatMap(leafTypeChoice, func(typ reflect.Type) hegel.Generator[leaf] { return inner[typ] }))
+	}
+	return map[reflect.Type]hegel.Generator[leaf]{
+		tString:  ofText(func(s string) leaf { return leaf{v: s, s: s} }),
+		tInt:     ofInt(func(n int) leaf { return leaf{v: n, s: strconv.Itoa(n)} }),
+		tInt64:   ofInt(func(n int) leaf { return leaf{v: int64(n), s: strconv.Itoa(n)} }),
+		tFloat64: ofInt(func(n int) leaf { f := float64(n) / 4; return leaf{v: f, s: strconv.FormatFloat(f, 'f', -1, 64)} }),
+		tBool:    hegel.Map(hegel.Booleans(), func(b bool) leaf { return leaf{v: b, s: strconv.FormatBool(b)} }),
+		tPInt: nilOr(30, leaf{v: (*int)(nil), s: ptrCell((*int)(nil), "")},
+			ofInt(func(n int) leaf { p := &n; return leaf{v: p, s: ptrCell(p, strconv.Itoa(n))} })),
+		tPString: nilOr(30, leaf{v: (*string)(nil), s: ptrCell((*string)(nil), "")},
+			ofText(func(s string) leaf { p := &s; return leaf{v: p, s: ptrCell(p, s)} })),
+		tTime: ofInt(func(n int) leaf { t := timeAt(n); return leaf{v: t, s: t.String()} }),
+		tPTime: crashing(30, leaf{v: (*time.Time)(nil), s: "", bad: true},
+			ofInt(func(n int) leaf { t := timeAt(n); return leaf{v: &t, s: t.String()} })),
+		tNullStr: nilOr(30, leaf{v: sql.NullString{}, s: ""},
+			ofText(func(s string) leaf { return leaf{v: sql.NullString{String: s, Valid: true}, s: s} })),
+		tNullI32: hegel.Composite(func(tc hegel.TestCase) leaf {
+			return nullInt32Leaf(hegel.Draw(tc, leafInts), hegel.Draw(tc, mostly(70)))
+		}),
+		tNullI64: hegel.Composite(func(tc hegel.TestCase) leaf {
+			return nullInt64Leaf(hegel.Draw(tc, leafInts), hegel.Draw(tc, mostly(70)))
+		}),
+		tBytes: nilOr(20, leaf{v: []byte(nil), s: ""}, ofText(func(s string) leaf { return leaf{v: []byte(s), s: s} })),
+		tError: hegel.OneOf(hegel.Just(nilLeaf),
+			shaped(hegel.Just(leaf{v: (*errVal)(nil), s: "", bad: true}), hegel.Just(nilLeaf)),
+			ofText(func(s string) leaf { return leaf{v: errors.New(s), s: s} })),
+		tAny:    anyLeaf,
+		tFmtVal: ofText(func(s string) leaf { return leaf{v: fmtVal{s}, s: s} }),
+		tStrVal: ofText(func(s string) leaf { return leaf{v: strVal{s}, s: s} }),
+		tPPtrStr: crashing(30, leaf{v: (*ptrStr)(nil), s: "", bad: true},
+			ofText(func(s string) leaf { return leaf{v: &ptrStr{s}, s: s} })),
+		tPErrVal: crashing(30, leaf{v: (*errVal)(nil), s: "", bad: true},
+			ofText(func(s string) leaf { return leaf{v: &errVal{s}, s: s} })),
+		tReader: hegel.Map(readerSizes, readerLeaf),
+		tInner1: hegel.Composite(func(tc hegel.TestCase) leaf {
+			v := Inner1{X: hegel.Draw(tc, leafTexts), Y: hegel.Draw(tc, leafInts)}
+			return leaf{v: v, s: fmt.Sprintf("%v", v)}
+		}),
+	}
+}
+
+var (
+	innerLeaves = leafGens(nil)
+	leaves      = leafGens(innerLeaves)
+	// typedLeaves: a leaf of any of leafTypes
+	typedLeaves = hegel.FlatMap(leafTypeChoice, func(typ reflect.Type) hegel.Generator[leaf] { return leaves[typ] })
+)
+
+// --------------------------------------------------------------------------- structs
+
+var fieldNames = []string{"Name", "ID", "UserName", "Created", "Total", "Ok", "Data", "Note", "A_B"}
+
+var fieldTags = []string{
+	``, ``, ``, `tw:"-"`, `tw:"name=Pretty Name"`, `tw:"name= spaced ,align=left"`, `tw:" - "`,
+	`json:"jname"`, `json:"jname,omitempty"`, `json:"-"`, `db:"dname"`, `json:"j" db:"d"`, `db:"dname,omitempty"`,
+}
+
+const (
+	embedNone = iota
+	embedInner1
+	embedPInner1
+	embedPInner2
+)
+
+type fieldSpec struct {
+	name  string
+	typ   reflect.Type
+	tag   string
+	embed int
+	leaf  leaf   // the value (embedNone)
+	inner []leaf // the embedded struct's field values (X, Y) or (Z); nil: a nil pointer
+}
+
+type structSpec struct {
+	fields []fieldSpec
+	typ    reflect.Type
+	ptr    bool // appended as a pointer
+	nilPtr bool // a nil pointer
+}
+
+var (
+	fieldNameChoice = hegel.SampledFrom(fieldNames)
+	fieldTagChoice  = hegel.SampledFrom(fieldTags)
+)
+
+// fieldSpecsOf: a field of one of fieldNames and fieldTags, of a type from types, with a leaf
+// of that type from leafOf.
+func fieldSpecsOf(types hegel.Generator[reflect.Type], leafOf map[reflect.Type]hegel.Generator[leaf]) hegel.Generator[fieldSpec] {
+	return hegel.FlatMap(types, func(typ reflect.Type) hegel.Generator[fieldSpec] {
+		return hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+			return fieldSpec{name: hegel.Draw(tc, fieldNameChoice), typ: typ, tag: hegel.Draw(tc, fieldTagChoice), leaf: hegel.Draw(tc, leafOf[typ])}
+		})
+	})
+}
+
+// plainFieldSpecs: a field of any leaf type.
+var plainFieldSpecs = fieldSpecsOf(leafTypeChoice, leaves)
+
+// uniqueNames keeps the first field of every name.
+func uniqueNames(fields []fieldSpec) []fieldSpec {
+	used := map[string]bool{}
+	var out []fieldSpec
+	for _, f := range fields {
+		if !used[f.name] {
+			used[f.name] = true
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// inner1Values: the values of an embedded Inner1 (X, Y).
+var inner1Values = hegel.Composite(func(tc hegel.TestCase) []leaf {
+	return []leaf{hegel.Draw(tc, leaves[tString]), hegel.Draw(tc, leaves[tInt])}
+})
+
+// inner1Fields: Inner1 embedded by value, or by pointer half of the time, then nil 40% of the
+// time.
+var inner1Fields = hegel.OneOf(
+	hegel.Map(inner1Values, func(in []leaf) fieldSpec {
+		return fieldSpec{name: "Inner1", embed: embedInner1, typ: tInner1, inner: in}
+	}),
+	hegel.Map(maybe(60, inner1Values), func(in []leaf) fieldSpec {
+		return fieldSpec{name: "Inner1", embed: embedPInner1, typ: tPInner1, inner: in}
+	}),
+)
+
+// inner2Fields: *Inner2 embedded, nil 40% of the time, else with its Z (a *string).
+var inner2Fields = hegel.Map(maybe(60, hegel.Map(leaves[tPString], func(l leaf) []leaf { return []leaf{l} })),
+	func(in []leaf) fieldSpec {
+		return fieldSpec{name: "Inner2", embed: embedPInner2, typ: tPInner2, inner: in}
+	})
+
+// embedding: an embedded field, 30% of the time, and the position it is inserted at (modulo
+// the fields present).
+type embedding struct {
+	field *fieldSpec
+	at    int
+}
+
+func embeddings(g hegel.Generator[fieldSpec]) hegel.Generator[embedding] {
+	return hegel.Composite(func(tc hegel.TestCase) embedding {
+		return embedding{field: hegel.Draw(tc, optional(30, g)), at: hegel.Draw(tc, hegel.Integers(0, 5))}
+	})
+}
+
+func (e embedding) insert(fields []fieldSpec) []fieldSpec {
+	if e.field == nil {
+		return fields
+	}
+	i := e.at % (len(fields) + 1)
+	return append(fields[:i], append([]fieldSpec{*e.field}, fields[i:]...)...)
+}
+
+// structsOf: a struct of 1 to 4 fields from fields, of distinct names, with each of the embeds
+// inserted 30% of the time at a drawn position; appended as a pointer 40% of the time, which
+// is nil 15% of the time.
+func structsOf(fields hegel.Generator[fieldSpec], embeds ...hegel.Generator[fieldSpec]) hegel.Generator[structSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) structSpec {
+		fs := uniqueNames(hegel.Draw(tc, many(fields, 1, 4)))
+		for _, e := range embeds {
+			fs = hegel.Draw(tc, embeddings(e)).insert(fs)
+		}
+		ptr := hegel.Draw(tc, chance(40))
+		return newStructSpec(fs, ptr, ptr && hegel.Draw(tc, chance(15)))
+	})
+}
+
+// newStructSpec builds the struct type of the fields.
+func newStructSpec(fields []fieldSpec, ptr, nilPtr bool) structSpec {
+	rf := make([]reflect.StructField, len(fields))
+	for i, f := range fields {
+		rf[i] = reflect.StructField{Name: f.name, Type: f.typ, Tag: reflect.StructTag(f.tag), Anonymous: f.embed != embedNone}
+	}
+	return structSpec{fields: fields, typ: reflect.StructOf(rf), ptr: ptr, nilPtr: nilPtr}
+}
+
+// structSpecs: a struct of 1 to 4 fields of any leaf type, an Inner1 and an Inner2 embedded 30%
+// of the time each.
+var structSpecs = structsOf(plainFieldSpecs, inner1Fields, inner2Fields)
+
+func setLeaf(fv reflect.Value, l leaf) {
+	if l.v == nil {
+		fv.Set(reflect.Zero(fv.Type()))
+		return
+	}
+	fv.Set(reflect.ValueOf(l.v))
+}
+
+// value builds the struct (or pointer) to append.
+func (sp structSpec) value() any {
+	if sp.nilPtr {
+		return reflect.Zero(reflect.PointerTo(sp.typ)).Interface()
+	}
+	v := reflect.New(sp.typ).Elem()
+	for i, f := range sp.fields {
+		fv := v.Field(i)
+		switch f.embed {
+		case embedNone:
+			setLeaf(fv, f.leaf)
+		case embedInner1:
+			fv.Set(reflect.ValueOf(Inner1{X: f.inner[0].v.(string), Y: f.inner[1].v.(int)}))
+		case embedPInner1:
+			if f.inner != nil {
+				fv.Set(reflect.ValueOf(&Inner1{X: f.inner[0].v.(string), Y: f.inner[1].v.(int)}))
+			}
+		case embedPInner2:
+			if f.inner != nil {
+				in := &Inner2{}
+				if f.inner[0].v != nil {
+					in.Z = f.inner[0].v.(*string)
+				}
+				fv.Set(reflect.ValueOf(in))
+			}
+		}
+	}
+	if sp.ptr {
+		return v.Addr().Interface()
+	}
+	return v.Interface()
+}
+
+// legacyName is the first non-empty json/db tag (the configured Tags): "-" skips the field.
+func legacyName(tag reflect.StructTag) (name string, skip bool) {
+	for _, key := range []string{"json", "db"} {
+		if v := tag.Get(key); v != "" {
+			return v, v == "-"
+		}
+	}
+	return "", false
+}
+
+// cells is the model of extractFieldsAndValuesFromStruct: headers, values, whether the
+// package panics on a value, and whether the struct yields anything (a nil pointer does not).
+// consumed: the values were already extracted once for AutoHeader, which read the io.Reader
+// fields (bug 32), so those cells hold what was left after the first 512 bytes.
+func (sp structSpec) cells(consumed bool) (headers, values []string, bad bool, ok bool) {
+	if sp.nilPtr {
+		return nil, nil, false, false
+	}
+	for _, f := range sp.fields {
+		switch f.embed {
+		case embedInner1:
+			headers = append(headers, "X", "Y")
+			values = append(values, f.inner[0].s, f.inner[1].s)
+			continue
+		case embedPInner1:
+			if f.inner == nil {
+				if !Known.embeddedNilDrops {
+					headers = append(headers, "X", "Y")
+					values = append(values, "", "")
+				}
+				continue
+			}
+			headers = append(headers, "X", "Y")
+			values = append(values, f.inner[0].s, f.inner[1].s)
+			continue
+		case embedPInner2:
+			if f.inner == nil {
+				if !Known.embeddedNilDrops {
+					headers = append(headers, "ZED")
+					values = append(values, "")
+				}
+				continue
+			}
+			headers = append(headers, "ZED") // json:"zed", titled; W is skipped by its tw tag
+			values = append(values, f.inner[0].s)
+			continue
+		}
+		tag := reflect.StructTag(f.tag)
+		legacy, skip := legacyName(tag)
+		if skip {
+			continue
+		}
+		name := f.name
+		if legacy != "" {
+			name = strings.Split(legacy, ",")[0]
+		}
+		name = title(name)
+		if twTag := tag.Get("tw"); twTag != "" {
+			if strings.TrimSpace(twTag) == "-" {
+				continue
+			}
+			parts := strings.Split(twTag, ",")
+			skipped := false
+			for _, p := range parts {
+				if strings.TrimSpace(strings.SplitN(p, "=", 2)[0]) == "-" {
+					skipped = true
+				}
+			}
+			if skipped {
+				continue
+			}
+			for _, p := range parts {
+				kv := strings.SplitN(p, "=", 2)
+				if len(kv) == 2 && strings.TrimSpace(kv[0]) == "name" {
+					name = kv[1]
+				}
+			}
+		}
+		headers = append(headers, name)
+		// IsZero of an interface field looks at the interface, so a typed nil inside it is not zero
+		zero := f.leaf.v == nil
+		if !zero && f.typ.Kind() != reflect.Interface {
+			zero = reflect.ValueOf(f.leaf.v).IsZero()
+		}
+		if strings.Contains(legacy, ",omitempty") && zero {
+			values = append(values, "")
+			continue
+		}
+		cell := f.leaf.s
+		if r, isReader := f.leaf.v.(*strings.Reader); isReader && consumed && Known.autoHeaderConsumesReaders {
+			cell = ""
+			if n := int(r.Size()); n > 512 {
+				cell = strings.Repeat("r", n-512)
+			}
+		}
+		values = append(values, cell)
+		bad = bad || f.leaf.bad
+	}
+	return headers, values, bad, true
+}
+
+// --------------------------------------------------------------------------- rows
+
+const (
+	rowStrings  = iota // []string
+	rowAnys            // []any of leaves
+	rowVariadic        // Append(a, b, ...) of leaves
+	rowTyped           // a typed slice
+	rowSingle          // a single leaf
+	rowStruct          // a struct or pointer
+)
+
+var typedKinds = []string{"int", "int64", "float64", "bool", "int32", "bytes", "uint16"}
+
+type rowInput struct {
+	kind   int
+	args   []any // the Append arguments
+	cells  []string
+	bad    bool
+	sp     structSpec
+	desc   string
+	bulkOK bool // usable as a Bulk element
+}
+
+func stringRow(cells []string) rowInput {
+	return rowInput{kind: rowStrings, args: []any{cells}, cells: cells, desc: fmt.Sprintf("[]string%q", cells), bulkOK: true}
+}
+
+// anyRow: the leaves as one []any (rowAnys) or as the arguments of Append (rowVariadic).
+func anyRow(kind int) func(ls []leaf) rowInput {
+	return func(ls []leaf) rowInput {
+		r := rowInput{kind: kind}
+		vals := make([]any, len(ls))
+		cells := make([]string, len(ls))
+		for i, l := range ls {
+			vals[i], cells[i] = l.v, l.s
+			r.bad = r.bad || l.bad
+		}
+		r.cells = cells
+		if kind == rowAnys {
+			r.args = []any{vals}
+			r.bulkOK = true
+		} else {
+			r.args = vals
+		}
+		r.desc = fmt.Sprintf("[]any(%d)%q", len(ls), cells)
+		return r
+	}
+}
+
+// typedRow: a typed slice as the row, one cell per element.
+func typedRow[T any](kind string, xs []T, cell func(T) string) rowInput {
+	cells := make([]string, len(xs))
+	for i, x := range xs {
+		cells[i] = cell(x)
+	}
+	return rowInput{kind: rowTyped, args: []any{xs}, cells: cells, desc: fmt.Sprintf("[]%s%q", kind, cells), bulkOK: true}
+}
+
+// bytesRow: a []byte as the row: one cell of the string (one numeric cell per byte under
+// Known.byteSliceRowNumbers, bug 28).
+func bytesRow(s string) rowInput {
+	b := []byte(s)
+	cells := []string{s}
+	if Known.byteSliceRowNumbers {
+		cells = make([]string, len(b))
+		for i, x := range b {
+			cells[i] = strconv.Itoa(int(x))
+		}
+	}
+	return rowInput{kind: rowTyped, args: []any{b}, cells: cells, desc: fmt.Sprintf("[]bytes%q", cells), bulkOK: true}
+}
+
+func singleRow(l leaf) rowInput {
+	cells := singleCells(l)
+	return rowInput{kind: rowSingle, args: []any{l.v}, bad: l.bad, cells: cells, desc: fmt.Sprintf("single %T %q", l.v, cells), bulkOK: true}
+}
+
+func structRow(sp structSpec) rowInput {
+	r := rowInput{kind: rowStruct, sp: sp, args: []any{sp.value()}, bulkOK: true}
+	_, values, bad, ok := sp.cells(false)
+	if !ok {
+		r.cells = []string{"<nil>"}
+	} else {
+		r.cells = values
+	}
+	r.bad = bad
+	r.desc = fmt.Sprintf("struct %v ptr=%v nil=%v %q", sp.typ, sp.ptr, sp.nilPtr, r.cells)
+	return r
+}
+
+var (
+	int64Cell   = func(x int64) string { return strconv.FormatInt(x, 10) }
+	float64Cell = func(x float64) string { return strconv.FormatFloat(x, 'f', -1, 64) }
+	int32Cell   = func(x int32) string { return strconv.Itoa(int(x)) }
+	uint16Cell  = func(x uint16) string { return strconv.Itoa(int(x)) }
+)
+
+// the typed slices of 0 to 4 elements, one per kind of typedKinds
+var (
+	intRows     = hegel.Map(many(hegel.Integers(-5, 999), 0, 4), func(xs []int) rowInput { return typedRow("int", xs, strconv.Itoa) })
+	int64Rows   = hegel.Map(many(hegel.Integers[int64](-5, 999), 0, 4), func(xs []int64) rowInput { return typedRow("int64", xs, int64Cell) })
+	float64Rows = hegel.Map(many(hegel.Map(hegel.Integers(-5, 999), func(n int) float64 { return float64(n) / 8 }), 0, 4),
+		func(xs []float64) rowInput { return typedRow("float64", xs, float64Cell) })
+	boolRows   = hegel.Map(many(hegel.Booleans(), 0, 4), func(xs []bool) rowInput { return typedRow("bool", xs, strconv.FormatBool) })
+	int32Rows  = hegel.Map(many(hegel.Integers[int32](65, 122), 0, 4), func(xs []int32) rowInput { return typedRow("int32", xs, int32Cell) })
+	byteRows   = hegel.Map(leafTexts, bytesRow)
+	uint16Rows = hegel.Map(many(hegel.Integers[uint16](0, 999), 0, 4), func(xs []uint16) rowInput { return typedRow("uint16", xs, uint16Cell) })
+)
+
+// typedRows: a typed slice of 0 to 4 elements of one of typedKinds.
+var typedRows = hegel.OneOf(intRows, int64Rows, float64Rows, boolRows, int32Rows, byteRows, uint16Rows)
+
+// bulkRows: the rows usable as Bulk elements: a []string of 0 to 4 of leafStrings, a []any of
+// 0 to 4 leaves, a typed slice, a single leaf, a struct.
+var bulkRows = hegel.OneOf(
+	hegel.Map(many(leafTexts, 0, 4), stringRow),
+	hegel.Map(many(typedLeaves, 0, 4), anyRow(rowAnys)),
+	typedRows,
+	hegel.Map(typedLeaves, singleRow),
+	hegel.Map(structSpecs, structRow),
+)
+
+// appendRows: the rows of Append: bulkRows and the variadic call with 2 to 4 leaves.
+var appendRows = hegel.OneOf(bulkRows, hegel.Map(many(typedLeaves, 2, 4), anyRow(rowVariadic)))
+
+// singleCells is the model of Append(v) for one value: a []byte is the []uint8 row; a
+// Formatter or Stringer is one cell; a struct, or a pointer to one, is the row of its exported
+// fields (so sql.NullString alone is two cells, and a value without exported fields - an error,
+// a reader - an empty row, bug 31); anything else is one cell of convertToString.
+func singleCells(l leaf) []string {
+	if b, ok := l.v.([]byte); ok {
+		if Known.byteSliceRowNumbers {
+			cells := make([]string, len(b))
+			for i, x := range b {
+				cells[i] = strconv.Itoa(int(x))
+			}
+			return cells
+		}
+		return []string{string(b)}
+	}
+	if l.v == nil {
+		return []string{""}
+	}
+	if _, ok := l.v.(tw.Formatter); ok {
+		return []string{l.s}
+	}
+	if _, ok := l.v.(fmt.Stringer); ok {
+		return []string{l.s}
+	}
+	rv := reflect.ValueOf(l.v)
+	if rv.Kind() == reflect.Pointer && !rv.IsNil() {
+		rv = rv.Elem()
+	}
+	if rv.Kind() == reflect.Struct {
+		var cells []string
+		for i := 0; i < rv.NumField(); i++ {
+			f := rv.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			cells = append(cells, cellOfBasic(rv.Field(i).Interface()))
+		}
+		if len(cells) == 0 && !Known.singleStructEmptyRow {
+			return []string{l.s}
+		}
+		if cells == nil {
+			return []string{}
+		}
+		return cells
+	}
+	return []string{l.s}
+}
+
+// cellOfBasic is convertToString on the exported field values met here (strings, ints, bools,
+// times).
+func cellOfBasic(v any) string {
+	switch x := v.(type) {
+	case string:
+		return x
+	case int:
+		return strconv.Itoa(x)
+	case int32:
+		return strconv.Itoa(int(x))
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case bool:
+		return strconv.FormatBool(x)
+	case fmt.Stringer:
+		return x.String()
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// autoHeader is the header AutoHeader would extract from this row, nil if none: the titled
+// exported field names of a struct (a single value that is a struct too, whatever
+// convertCellsToStrings makes of its cells).
+func (r rowInput) autoHeader() []string {
+	switch r.kind {
+	case rowStruct:
+		headers, _, _, ok := r.sp.cells(false)
+		if !ok || len(headers) == 0 {
+			return nil
+		}
+		return headers
+	case rowSingle:
+		rv := reflect.ValueOf(r.args[0])
+		if rv.Kind() == reflect.Pointer && !rv.IsNil() {
+			rv = rv.Elem()
+		}
+		if rv.Kind() != reflect.Struct {
+			return nil
+		}
+		var headers []string
+		for i := 0; i < rv.NumField(); i++ {
+			if f := rv.Type().Field(i); f.PkgPath == "" {
+				headers = append(headers, title(f.Name))
+			}
+		}
+		return headers
+	}
+	return nil
+}
+
+// consumedCells are the row's cells after AutoHeader extracted the header from it.
+func (r rowInput) consumedCells() []string {
+	if r.kind != rowStruct {
+		return r.cells
+	}
+	_, values, _, ok := r.sp.cells(true)
+	if !ok {
+		return r.cells
+	}
+	return values
+}
+
+type inputOp struct {
+	bulk bool
+	rows []rowInput // one for Append, the elements for Bulk
+}
+
+// inputOps: an Append of one of appendRows 70% of the time, else a Bulk of 0 to 3 of bulkRows.
+var inputOps = weighted(
+	choice[inputOp]{70, hegel.Map(appendRows, func(r rowInput) inputOp { return inputOp{rows: []rowInput{r}} })},
+	choice[inputOp]{30, hegel.Map(many(bulkRows, 0, 3), func(rs []rowInput) inputOp { return inputOp{bulk: true, rows: rs} })},
+)
+
+// inputCase: AutoHeader on half of the time, a header of 1 to 3 of leafStrings 30% of the
+// time, 0 to 3 Append/Bulk calls.
+type inputCase struct {
+	autoHeader bool
+	header     []string
+	ops        []inputOp
+}
+
+var inputCases = hegel.Composite(func(tc hegel.TestCase) inputCase {
+	return inputCase{
+		autoHeader: hegel.Draw(tc, chance(50)),
+		header:     hegel.Draw(tc, maybe(30, many(leafTexts, 1, 3))),
+		ops:        hegel.Draw(tc, many(inputOps, 0, 3)),
+	}
+})
+
+func (k inputCase) GoString() string {
+	var desc []string
+	for _, op := range k.ops {
+		if op.bulk {
+			desc = append(desc, "Bulk[")
+		}
+		for _, r := range op.rows {
+			desc = append(desc, r.desc)
+		}
+		if op.bulk {
+			desc = append(desc, "]")
+		}
+	}
+	return fmt.Sprintf("autoHeader=%v header=%q %s", k.autoHeader, k.header, strings.Join(desc, " "))
+}
+
+func TestHegelInput(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkInput(c, ht, hegel.Draw(ht, inputCases))
+	})
+}
+
+// checkInput is the body of TestHegelInput for one case: the Markdown rendering of the table
+// the Append and Bulk calls build (with AutoHeader and the header, if any) equals the model's.
+func checkInput(c *collector, ht *hegel.T, k inputCase) {
+	{
+		autoHeader, header, ops := k.autoHeader, k.header, k.ops
+		// the model: header and rows
+		spec := tableSpec{trimSpace: true, trimTab: true, autoFormat: [3]bool{true, false, false}}
+		spec.align[secHeader] = tw.CellAlignment{Global: tw.AlignCenter}
+		spec.align[secRow] = tw.CellAlignment{Global: tw.AlignLeft}
+		spec.align[secFooter] = tw.CellAlignment{Global: tw.AlignRight}
+		spec.header = header
+		bad := false
+		var desc []string
+		for _, op := range ops {
+			if op.bulk {
+				if autoHeader && spec.header == nil && len(op.rows) > 0 {
+					spec.header = op.rows[0].autoHeader()
+					op.rows[0].cells = op.rows[0].consumedCells()
+				}
+				desc = append(desc, "Bulk[")
+			}
+			for _, r := range op.rows {
+				if !op.bulk && autoHeader && spec.header == nil && len(spec.rows) == 0 {
+					spec.header = r.autoHeader()
+					r.cells = r.consumedCells()
+				}
+				spec.rows = append(spec.rows, r.cells)
+				bad = bad || r.bad
+				desc = append(desc, r.desc)
+			}
+			if op.bulk {
+				desc = append(desc, "]")
+			}
+		}
+		if bad {
+			c.count("nil stringer") // bug 26: values the package panics on (left out under the switch)
+		}
+		if autoHeader {
+			c.count("autoHeader")
+		}
+		if spec.header != nil {
+			c.count("header")
+		}
+		c.count("ops " + itoa(len(ops)))
+
+		var buf bytes.Buffer
+		tb := tablewriter.NewTable(&buf, spec.options(renderer.NewMarkdown())...)
+		if autoHeader {
+			tb.Configure(func(cfg *tablewriter.Config) { cfg.Behavior.Structs.AutoHeader = tw.On })
+		}
+		if header != nil {
+			tb.Header(header)
+		}
+		for _, op := range ops {
+			if op.bulk {
+				elems := make([]any, len(op.rows))
+				for i, r := range op.rows {
+					elems[i] = r.args[0]
+				}
+				if err := tb.Bulk(elems); err != nil {
+					c.failClass(ht, "error", "Bulk: %v for %s", err, strings.Join(desc, " "))
+					return
+				}
+				continue
+			}
+			if err := tb.Append(op.rows[0].args...); err != nil {
+				c.failClass(ht, "error", "Append: %v for %s", err, strings.Join(desc, " "))
+				return
+			}
+		}
+		if err := tb.Render(); err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, strings.Join(desc, " "))
+			return
+		}
+		want := spec.markdown()
+		if got := buf.String(); got != want {
+			c.failClass(ht, "input", "Markdown of autoHeader=%v header=%q %s:\n got:\n%s want:\n%s", autoHeader, header, strings.Join(desc, " "), got, want)
+		}
+	}
+}
diff --git a/hegel/hegel_merge_test.go b/hegel/hegel_merge_test.go
new file mode 100644
index 0000000..a8c47d5
--- /dev/null
+++ b/hegel/hegel_merge_test.go
@@ -0,0 +1,488 @@
+package hegel
+
+// Cell merging against an exact model: horizontal merges of equal neighbouring cells in a
+// header, a row or a footer (and the footer's lead merge of leading empty cells up to the first
+// content), vertical merges of equal cells down a column, and hierarchical merges (a cell merges
+// down only while the cell to its left did), then the boxed rendering with the merged cells
+// spanning their columns and the separator lines passing through vertical merges.
+
+import (
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+// mstate is tw.MergeStateOption.
+type mstate struct {
+	present, start, end bool
+	span                int
+}
+
+// cellMerge is tw.MergeState: the horizontal, vertical and hierarchical state of a cell.
+type cellMerge struct{ h, v, hier mstate }
+
+func getMerge(states []cellMerge, i int) cellMerge {
+	if i < 0 || i >= len(states) {
+		return cellMerge{}
+	}
+	return states[i]
+}
+
+// vpass reports whether a separator line passes through the cell (a vertical or hierarchical
+// merge continues from the cell above to the cell below).
+func vpass(above, below cellMerge) bool {
+	return (above.v.present && below.v.present && !above.v.end && !below.v.start) ||
+		(above.hier.present && below.hier.present && !above.hier.end && !below.hier.start)
+}
+
+// joinedCell is a logical cell's content over its visual lines, trimmed as the table trims.
+func (s tableSpec) joinedCell(lines [][]string, col int) string {
+	var b strings.Builder
+	for _, l := range lines {
+		if col < len(l) {
+			b.WriteString(l[col])
+		}
+	}
+	return s.trim(b.String())
+}
+
+// hmerge is the model of prepareWithMerges for a section's prepared lines: the lines padded to
+// the section's own column count, and with the horizontal bit set, a footer's leading empty
+// cells merged up to its first content (which moves to the first column), then runs of equal
+// non-empty logical cells (not "-") merged into their first column, the others blanked.
+func (s tableSpec) hmerge(lines [][]string, numCols, mode int, footer bool) ([][]string, []cellMerge) {
+	states := make([]cellMerge, numCols)
+	if len(lines) == 0 || mode&tw.MergeHorizontal == 0 {
+		return lines, states
+	}
+	n := len(lines[0])
+	if n == 0 {
+		for _, l := range lines {
+			n = max(n, len(l))
+		}
+		if n == 0 {
+			n = numCols
+		}
+	}
+	if n == 0 {
+		return lines, states
+	}
+	result := make([][]string, len(lines))
+	for i := range lines {
+		result[i] = padLine(lines[i], n)
+	}
+	inMerge := make([]bool, n)
+	if footer {
+		orig := padLine(lines[0], n)
+		first := -1
+		var firstContent string
+		for c := 0; c < n; c++ {
+			tv := s.trim(orig[c])
+			if tv != "" && tv != "-" {
+				first = c
+				firstContent = orig[c]
+				break
+			} else if tv == "-" {
+				break
+			}
+		}
+		if first > 0 {
+			span := first + 1
+			result[0][0] = firstContent
+			for k := 1; k < span; k++ {
+				result[0][k] = ""
+			}
+			for vl := 1; vl < len(result); vl++ {
+				for k := 0; k < span; k++ {
+					result[vl][k] = ""
+				}
+				if !Known.footerLeadDropsLines {
+					result[vl][0] = padLine(lines[vl], n)[first] // the whole logical cell moves
+				}
+			}
+			states[0].h = mstate{true, true, span == 1, span}
+			inMerge[0] = true
+			for k := 1; k < span; k++ {
+				states[k].h = mstate{true, false, k == span-1, span}
+				inMerge[k] = true
+			}
+		}
+	}
+	for col := 0; col < n; {
+		if inMerge[col] {
+			col++
+			continue
+		}
+		cur := s.joinedCell(lines, col)
+		if cur == "" || cur == "-" {
+			col++
+			continue
+		}
+		span := 1
+		for next := col + 1; next < n; next++ {
+			if inMerge[next] || s.joinedCell(lines, next) != cur {
+				break
+			}
+			span++
+		}
+		if span == 1 {
+			col++
+			continue
+		}
+		states[col].h = mstate{true, true, false, span}
+		inMerge[col] = true
+		for li := range result {
+			for k := col + 1; k < col+span; k++ {
+				result[li][k] = ""
+			}
+		}
+		for k := col + 1; k < col+span; k++ {
+			states[k].h = mstate{true, false, k == col+span-1, span}
+			inMerge[k] = true
+		}
+		col += span
+	}
+	return result, states
+}
+
+// vmerge is the model of applyVerticalMerges over the records (after the horizontal pass): a
+// run of equal non-empty logical cells down a column becomes one merge, the continuing cells
+// blanked; a record without lines is skipped but does not end a run.
+func (s tableSpec) vmerge(recs [][][]string, recM [][]cellMerge, numCols int, cols map[int]bool) {
+	startRow := map[int]int{}
+	startContent := map[int]string{}
+	for i := range recs {
+		if len(recs[i]) == 0 {
+			continue
+		}
+		for col := 0; col < numCols; col++ {
+			if cols != nil && !cols[col] {
+				continue
+			}
+			cur := s.joinedCell(recs[i], col)
+			sr, ongoing := startRow[col]
+			st := recM[i][col]
+			if ongoing && cur == startContent[col] && cur != "" {
+				st.v = mstate{true, false, false, 0}
+				recM[i][col] = st
+				for li := range recs[i] {
+					if col < len(recs[i][li]) {
+						recs[i][li][col] = ""
+					}
+				}
+				continue
+			}
+			if ongoing {
+				ended := i - 1
+				if ended >= 0 && ended >= sr {
+					ss := recM[sr][col]
+					ss.v.span = ended - sr + 1
+					ss.v.end = ss.v.span == 1
+					recM[sr][col] = ss
+					es := recM[ended][col]
+					es.v.end = true
+					es.v.span = ss.v.span
+					recM[ended][col] = es
+				}
+				delete(startRow, col)
+				delete(startContent, col)
+			}
+			if cur != "" {
+				st.v = mstate{true, true, false, 1}
+				recM[i][col] = st
+				startRow[col] = i
+				startContent[col] = cur
+			} else if !st.h.present {
+				st.v = mstate{}
+				recM[i][col] = st
+			}
+		}
+	}
+	last := len(recs) - 1
+	if last < 0 {
+		return
+	}
+	for col, sr := range startRow {
+		ss := recM[sr][col]
+		span := last - sr + 1
+		ss.v.span = span
+		ss.v.end = span == 1
+		recM[sr][col] = ss
+		es := recM[last][col]
+		es.v.present = true
+		es.v.end = true
+		es.v.span = span
+		if sr != last {
+			es.v.start = false
+		}
+		recM[last][col] = es
+	}
+}
+
+// hiermerge is the model of applyHierarchicalMerges: from the second record on, a cell equal
+// to the one above (non-empty, not "-") continues a merge when it is the first column or the
+// cell to its left continued one; compared on a snapshot taken before the pass.
+func (s tableSpec) hiermerge(recs [][][]string, recM [][]cellMerge, numCols int, cols map[int]bool) {
+	if len(recs) <= 1 {
+		return
+	}
+	orig := make([][][]string, len(recs))
+	for i, rec := range recs {
+		orig[i] = make([][]string, len(rec))
+		for j, l := range rec {
+			orig[i][j] = append([]string(nil), l...)
+		}
+	}
+	hStart := map[int]int{}
+	finalize := func(c, sr, er int) {
+		if er < sr || sr < 0 || er < 0 || er >= len(recM) {
+			return
+		}
+		span := er - sr + 1
+		ss := recM[sr][c]
+		ss.hier.present, ss.hier.start, ss.hier.span, ss.hier.end = true, true, span, span == 1
+		recM[sr][c] = ss
+		if er > sr {
+			es := recM[er][c]
+			es.hier.present, es.hier.start, es.hier.end, es.hier.span = true, false, true, span
+			recM[er][c] = es
+		}
+	}
+	for r := 1; r < len(recs); r++ {
+		leftCont := false
+		for c := 0; c < numCols; c++ {
+			if cols != nil && !cols[c] {
+				leftCont = false
+				continue
+			}
+			if len(orig[r]) == 0 || len(orig[r-1]) == 0 {
+				st := recM[r][c]
+				st.hier = mstate{}
+				recM[r][c] = st
+				leftCont = false
+				continue
+			}
+			cur := s.joinedCell(orig[r], c)
+			above := s.joinedCell(orig[r-1], c)
+			st := recM[r][c]
+			prevAbove := recM[r-1][c]
+			match := cur == above && cur != "" && cur != "-"
+			if match && (c == 0 || leftCont) {
+				st.hier.present = true
+				st.hier.start = false
+				if prevAbove.hier.present && !prevAbove.hier.end {
+					if _, ok := hStart[c]; !ok {
+						hStart[c] = r - 1
+						ss := recM[r-1][c]
+						ss.hier.present, ss.hier.start, ss.hier.end = true, true, false
+						recM[r-1][c] = ss
+					}
+				} else {
+					hStart[c] = r - 1
+					ss := recM[r-1][c]
+					ss.hier.present, ss.hier.start, ss.hier.end = true, true, false
+					recM[r-1][c] = ss
+				}
+				for li := range recs[r] {
+					if c < len(recs[r][li]) {
+						recs[r][li][c] = ""
+					}
+				}
+				leftCont = true
+			} else {
+				st.hier = mstate{}
+				if sr, ok := hStart[c]; ok {
+					finalize(c, sr, r-1)
+					delete(hStart, c)
+				}
+				leftCont = false
+			}
+			recM[r][c] = st
+		}
+	}
+	for c, sr := range hStart {
+		finalize(c, sr, len(recs)-1)
+	}
+}
+
+// applyMerges runs the merge passes over the prepared model in the table's order: horizontal
+// merges of the header and of every record, the rows' vertical then hierarchical merges, the
+// footer's horizontal merges.
+func (s tableSpec) applyMerges(m *tableModel) {
+	m.hdrM = make([]cellMerge, m.numCols)
+	if m.header != nil {
+		m.header, m.hdrM = s.hmerge(m.header, m.numCols, s.merge[secHeader], false)
+	}
+	m.recM = make([][]cellMerge, len(m.records))
+	for i, rec := range m.records {
+		m.records[i], m.recM[i] = s.hmerge(rec, m.numCols, s.merge[secRow], false)
+	}
+	var cols map[int]bool
+	if s.mergeCols != nil {
+		cols = map[int]bool{}
+		for _, c := range s.mergeCols {
+			cols[c] = true
+		}
+	}
+	if s.merge[secRow]&tw.MergeVertical != 0 {
+		s.vmerge(m.records, m.recM, m.numCols, cols)
+	}
+	if s.merge[secRow]&tw.MergeHierarchical != 0 {
+		s.hiermerge(m.records, m.recM, m.numCols, cols)
+	}
+	m.rows = nil
+	for _, rec := range m.records {
+		if len(rec) > 0 {
+			m.rows = append(m.rows, rec)
+		}
+	}
+	m.ftrM = make([]cellMerge, m.numCols)
+	if m.footer != nil {
+		m.footer, m.ftrM = s.hmerge(m.footer, m.numCols, s.merge[secFooter], true)
+	}
+}
+
+// mergedWidths is the model of applyHorizontalMerges for a header or footer: a merge's first
+// column takes the width of the whole span (separators included), the others 0.
+func (m tableModel) mergedWidths(states []cellMerge, l layout) []int {
+	out := append([]int(nil), m.widths...)
+	sepW := 0
+	if l.betweenCols {
+		sepW = w0(l.sym.Column())
+	}
+	for c := 0; c < m.numCols; c++ {
+		st := getMerge(states, c)
+		if !st.h.present || !st.h.start {
+			continue
+		}
+		total := 0
+		for i := 0; i < st.h.span && c+i < m.numCols; i++ {
+			if Known.mergedHeaderHiddenWidth {
+				// the natural widths, hidden columns and their separators included (bug 34)
+				total += m.natural[c+i]
+				if i > 0 {
+					total += sepW
+				}
+				continue
+			}
+			total += m.widths[c+i]
+			if i > 0 && m.widths[c+i] > 0 {
+				total += sepW
+			}
+		}
+		out[c] = total
+		for i := 1; i < st.h.span && c+i < m.numCols; i++ {
+			out[c+i] = 0
+		}
+		if m.hidden[c] {
+			out[c] = 0 // AutoHide zeroes the widths after the merge widths are set
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- property
+
+var mergeCells = []string{"a", "a", "a", "b", "b", "Total", "", "-", "x\ny", " a ", "A", "long cell", "c", "Total"}
+
+var headerMergeModes = []int{0, 0, tw.MergeHorizontal, tw.MergeBoth, tw.MergeHierarchical, tw.MergeVertical}
+var rowMergeModes = []int{0, tw.MergeVertical, tw.MergeHorizontal, tw.MergeBoth, tw.MergeHierarchical, 5, 6, 7}
+
+var (
+	mergeCellTexts = hegel.SampledFrom(mergeCells)
+	headerMerges   = hegel.SampledFrom(headerMergeModes)
+	rowMerges      = hegel.SampledFrom(rowMergeModes)
+)
+
+// mergeTables: small boxed tables from mergeCells, a pool of few distinct cells so that equal
+// neighbours are common, of 1 to 5 records of at least one cell.
+var mergeTables = tables(tableShape{cells: mergeCellTexts, minCells: 1, minRows: 1, maxRows: 5, boxed: true})
+
+// mergeColumns: one to three merge columns among the first four (Row.Merging.ByColumnIndex).
+var mergeColumns = hegel.Map(hegel.Maps(hegel.Integers(0, 3), hegel.Just(true)).MinSize(1).MaxSize(3), sortedKeys)
+
+func sortedKeys(m map[int]bool) []int {
+	keys := make([]int, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Ints(keys)
+	return keys
+}
+
+// mergeSpecs: mergeTables, the footer starting with an empty cell 40% of the time (the shape of
+// a lead merge: empty cells before the first content), under every merge mode of every section
+// and, 30% of the time, merge columns.
+var mergeSpecs = hegel.Composite(func(tc hegel.TestCase) tableSpec {
+	s := hegel.Draw(tc, mergeTables)
+	if hegel.Draw(tc, chance(40)) && s.footer != nil {
+		s.footer[0] = ""
+	}
+	s.merging = merging{
+		merge:     [3]int{hegel.Draw(tc, headerMerges), hegel.Draw(tc, rowMerges), hegel.Draw(tc, headerMerges)},
+		mergeCols: hegel.Draw(tc, maybe(30, mergeColumns)),
+	}
+	return s
+})
+
+var mergeCases = boxedCases(mergeSpecs)
+
+// classifyMerges counts the merges the model found.
+func (m tableModel) classifyMerges(c *collector) {
+	count := func(states []cellMerge, what string) {
+		for _, st := range states {
+			if st.h.start {
+				c.count(what + " horizontal")
+			}
+			if st.v.start && st.v.span > 1 {
+				c.count(what + " vertical")
+			}
+			if st.hier.start && st.hier.span > 1 {
+				c.count(what + " hierarchical")
+			}
+		}
+	}
+	count(m.hdrM, "header")
+	for _, st := range m.recM {
+		count(st, "row")
+	}
+	count(m.ftrM, "footer")
+	if len(m.ftrM) > 0 && m.ftrM[0].h.start && len(m.footer) > 0 && m.footer[0][0] != "" {
+		c.count("footer lead merge")
+	}
+}
+
+// TestHegelMerge: the boxed rendering of tables with merged cells equals the model's.
+func TestHegelMerge(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkMerge(c, ht, hegel.Draw(ht, mergeCases))
+	})
+}
+
+// checkMerge is the body of TestHegelMerge for one case: the boxed rendering of the table with
+// its merge modes equals the model's.
+func checkMerge(c *collector, ht *hegel.T, k boxedCase) {
+	s, r := k.s, k.r
+	m := s.model()
+	if s.allHidden() {
+		c.count("all hidden") // bug 16
+	}
+	s.classify(c)
+	m.classifyMerges(c)
+	c.count("row mode " + itoa(s.merge[secRow]))
+	got, err := s.render(renderer.NewBlueprint(r.rendition()))
+	if err != nil {
+		c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+		return
+	}
+	want := s.blueprint(r)
+	if got != want {
+		c.failClass(ht, "merge", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+	}
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..11171ac
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,251 @@
+package hegel
+
+// Models of pkg/twwidth: the escape-sequence scanner (ECMA-48: a CSI sequence is ESC [
+// parameters intermediates final; an OSC sequence is ESC ] ... BEL or ESC \), display widths
+// and Truncate.
+
+import (
+	"strings"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+)
+
+const (
+	esc   = "\x1b"
+	bel   = "\x07"
+	reset = "\x1b[0m"
+	tabW  = 4 // the tab width the tests fix (SetTabWidth after the first TabWidth, bug 1)
+)
+
+func init() {
+	twwidth.TabWidth()
+	twwidth.SetTabWidth(tabW)
+}
+
+type widthOpts struct {
+	ea     bool
+	narrow bool
+	tab    int // the tab width in force, tabW when 0
+}
+
+func setOpts(o widthOpts) {
+	twwidth.SetOptions(twwidth.Options{EastAsianWidth: o.ea, ForceNarrowBorders: o.narrow})
+}
+
+// tok is a piece of a string: an escape sequence or a run of visible text.
+type tok struct {
+	seq bool
+	s   string
+}
+
+// csiEnd returns the index after the CSI sequence starting at i (s[i:i+2] == ESC [), or -1.
+func csiEnd(s string, i int) int {
+	j := i + 2
+	for j < len(s) && s[j] >= 0x30 && s[j] <= 0x3f {
+		j++
+	}
+	for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+		j++
+	}
+	if j < len(s) && s[j] >= 0x40 && s[j] <= 0x7e {
+		return j + 1
+	}
+	return -1
+}
+
+// oscEnd returns the index after the OSC sequence starting at i (s[i:i+2] == ESC ]), or -1.
+func oscEnd(s string, i int) int {
+	for j := i + 2; j < len(s); j++ {
+		if s[j] == 0x07 {
+			return j + 1
+		}
+		if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+			return j + 2
+		}
+		if s[j] == '\n' { // the package's regexp does not cross a newline
+			return -1
+		}
+	}
+	return -1
+}
+
+// scan splits s into escape sequences and visible text by ECMA-48.
+func scan(s string) []tok {
+	var out []tok
+	var text strings.Builder
+	flush := func() {
+		if text.Len() > 0 {
+			out = append(out, tok{false, text.String()})
+			text.Reset()
+		}
+	}
+	for i := 0; i < len(s); {
+		if s[i] == 0x1b && i+1 < len(s) {
+			end := -1
+			switch s[i+1] {
+			case '[':
+				end = csiEnd(s, i)
+			case ']':
+				end = oscEnd(s, i)
+			}
+			if end > 0 {
+				flush()
+				out = append(out, tok{true, s[i:end]})
+				i = end
+				continue
+			}
+		}
+		text.WriteByte(s[i])
+		i++
+	}
+	flush()
+	return out
+}
+
+func stripSeq(s string) string {
+	var b strings.Builder
+	for _, t := range scan(s) {
+		if !t.seq {
+			b.WriteString(t.s)
+		}
+	}
+	return b.String()
+}
+
+func isBox(r rune) bool { return r >= 0x2500 && r <= 0x257f }
+
+func runeWidth(r rune, o widthOpts) int {
+	if o.narrow && isBox(r) {
+		return 1
+	}
+	if r == '\t' {
+		if o.tab > 0 {
+			return o.tab
+		}
+		return tabW
+	}
+	return displaywidth.Options{EastAsianWidth: o.ea}.Rune(r)
+}
+
+// width is the model of twwidth.Width: the sum of the rune widths of the visible text.
+func width(s string, o widthOpts) int {
+	w := 0
+	for _, r := range stripSeq(s) {
+		w += runeWidth(r, o)
+	}
+	return w
+}
+
+// truncTokens scans s as Truncate's loop does when Known.truncateEscRestart is on: an ESC
+// always starts a new sequence (so the ESC of an ST terminator restarts the scan and the rest
+// of the string is swallowed by a sequence that never terminates), a CSI ends at a final byte,
+// an OSC at BEL. Otherwise the ECMA-48 scan, with visible text split into runes. The last
+// element reports whether the scan ended inside a sequence (open).
+func truncTokens(s string, faithful bool) (toks []tok, open bool) {
+	if !faithful {
+		for _, t := range scan(s) {
+			if t.seq {
+				toks = append(toks, t)
+				continue
+			}
+			for _, r := range t.s {
+				toks = append(toks, tok{false, string(r)})
+			}
+		}
+		return toks, false
+	}
+	var buf []byte
+	in := false
+	for _, r := range s {
+		if r == 0x1b {
+			in = true
+			buf = append(buf[:0], 0x1b)
+			continue
+		}
+		if in {
+			buf = append(buf, []byte(string(r))...)
+			term := false
+			if len(buf) >= 2 {
+				switch buf[1] {
+				case '[':
+					term = len(buf) >= 3 && r >= 0x40 && r <= 0x7e
+				case ']':
+					term = r == 0x07
+				}
+			}
+			if term {
+				in = false
+				toks = append(toks, tok{true, string(buf)})
+			}
+			continue
+		}
+		toks = append(toks, tok{false, string(r)})
+	}
+	return toks, in
+}
+
+// truncate is the model of twwidth.Truncate.
+func truncate(s string, maxWidth int, suffix string, o widthOpts) string {
+	if maxWidth < 0 {
+		return ""
+	}
+	sw := width(s, o)
+	suffixW := width(suffix, o)
+	if sw == 0 {
+		if suffix != "" && (suffixW <= maxWidth || (maxWidth == 0 && !Known.truncateZeroSuffix)) {
+			return suffix
+		}
+		if maxWidth == 0 && len(s) > 0 {
+			return ""
+		}
+		return s
+	}
+	if maxWidth == 0 {
+		if suffix != "" && !Known.truncateZeroSuffix {
+			return suffix // documented: "If maxWidth is zero and a suffix is provided, the suffix is returned"
+		}
+		return ""
+	}
+	if sw <= maxWidth {
+		safe := s
+		if strings.Contains(s, esc) && !strings.HasSuffix(s, reset) {
+			safe += reset
+		}
+		if suffix == "" || sw+suffixW > maxWidth {
+			return safe
+		}
+		return safe + suffix
+	}
+	if suffix != "" && o.ea && maxWidth-suffixW == 0 {
+		return suffix
+	}
+	budget := maxWidth - suffixW
+	if budget < 0 {
+		return ""
+	}
+	toks, open := truncTokens(s, Known.truncateEscRestart)
+	var out strings.Builder
+	cw := 0
+	wrote := false
+	for _, t := range toks {
+		if t.seq {
+			out.WriteString(t.s)
+			wrote = true
+			continue
+		}
+		r := []rune(t.s)[0]
+		w := runeWidth(r, o)
+		if budget == 0 || cw+w > budget {
+			open = false
+			break
+		}
+		out.WriteString(t.s)
+		cw += w
+	}
+	res := out.String()
+	if (wrote || (open && strings.Contains(s, esc+"["))) && (cw > 0 || wrote) && !strings.HasSuffix(res, reset) {
+		res += reset
+	}
+	return res + suffix
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..af6ff70
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,579 @@
+package hegel
+
+// Pins: one test per recorded bug, asserting the documented behaviour. They fail while the bug
+// exists (listed in target.toml [expected_failures]) and pass once it is fixed.
+
+import (
+	"bytes"
+	"database/sql"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+)
+
+// 1: SetWidth on a Tabinal (SetTabWidth on the global one) before its first Size() is
+// overwritten by the detection Size() runs once.
+func TestHegelPinTabWidthSetBeforeUse(t *testing.T) {
+	var tb twwidth.Tabinal
+	tb.SetWidth(3)
+	if got := tb.Size(); got != 3 {
+		t.Fatalf("Tabinal.SetWidth(3) then Size() = %d, want 3 (the detection ran over the set width)", got)
+	}
+}
+
+// 2: the width cache is not purged by SetTabWidth, so a cached width of a string holding a tab
+// is stale after the tab width changes.
+func TestHegelPinTabWidthCache(t *testing.T) {
+	defer func() {
+		twwidth.SetTabWidth(tabW)
+		setOpts(widthOpts{ea: true})
+		setOpts(widthOpts{})
+	}()
+	setOpts(widthOpts{ea: true})
+	setOpts(widthOpts{})
+	twwidth.SetTabWidth(4)
+	if got := twwidth.Width("a\tb"); got != 6 {
+		t.Fatalf("Width(a<tab>b) with tab width 4 = %d, want 6", got)
+	}
+	twwidth.SetTabWidth(8)
+	got, want := twwidth.Width("a\tb"), twwidth.WidthNoCache("a\tb")
+	if got != want {
+		t.Fatalf("after SetTabWidth(8): Width(a<tab>b) = %d, WidthNoCache = %d", got, want)
+	}
+}
+
+// 3: Width sums rune widths, so an emoji sequence (VS16, ZWJ, flags, modifiers) differs from
+// displaywidth's width of the string.
+func TestHegelPinWidthEmojiSequence(t *testing.T) {
+	setOpts(widthOpts{})
+	for _, s := range emojiPieces {
+		if got, want := twwidth.Width(s), displaywidth.String(s); got != want {
+			t.Fatalf("Width(%q) = %d, displaywidth.String = %d", s, got, want)
+		}
+	}
+}
+
+// 4: Truncate restarts its scan at every ESC, so the ST terminator of an OSC sequence (a
+// hyperlink) opens a sequence that never ends and swallows the rest of the string.
+func TestHegelPinTruncateHyperlink(t *testing.T) {
+	setOpts(widthOpts{})
+	link := esc + "]8;;http://x" + esc + "\\" + "link" + esc + "]8;;" + esc + "\\" + " more text"
+	got := twwidth.Truncate(link, 6)
+	if vis := stripSeq(got); vis != "link m" {
+		t.Fatalf("Truncate(hyperlink + text, 6) = %q, visible %q, want visible %q", got, vis, "link m")
+	}
+}
+
+// 5: documented "If maxWidth is zero and a suffix is provided, the suffix is returned".
+func TestHegelPinTruncateZeroSuffix(t *testing.T) {
+	setOpts(widthOpts{})
+	if got := twwidth.Truncate("hello", 0, "..."); got != "..." {
+		t.Fatalf("Truncate(hello, 0, ...) = %q, want the suffix", got)
+	}
+}
+
+// 6: WrapStringWithSpaces slices the core content one byte after the start of the last
+// non-space rune, so a multi-byte last rune is measured as one column and the limit returned
+// is too small for the lines.
+func TestHegelPinWrapSpacesTrailingRune(t *testing.T) {
+	setOpts(widthOpts{})
+	lines, lim := twwarp.WrapStringWithSpaces("a あ", 1)
+	for _, l := range lines {
+		if twwidth.Width(l) > lim {
+			t.Fatalf("WrapStringWithSpaces(%q, 1) = %q, limit %d: line %q is wider", "a あ", lines, lim, l)
+		}
+	}
+}
+
+// 7: BreakPoint measures every rune alone, so the characters of an escape sequence count as
+// visible and a coloured line is broken inside its sequence.
+func TestHegelPinBreakPointEscapes(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[31mabc"
+	if got := tw.BreakPoint(s, 2); got != 7 {
+		t.Fatalf("BreakPoint(%q, 2) = %d, want 7 (ESC[31m takes no width; ab fit)", s, got)
+	}
+}
+
+// 8: SplitCamelCase drops a lone underscore group but keeps groups of several underscores.
+func TestHegelPinCamelUnderscoreGroups(t *testing.T) {
+	got := tw.SplitCamelCase("a__b")
+	if strings.Join(got, "|") != "a|b" {
+		t.Fatalf("SplitCamelCase(a__b) = %q, want [a b]", got)
+	}
+}
+
+// --------------------------------------------------------------------------- table
+
+func renderWith(r tw.Renderer, header []string, rows [][]string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	t.Render()
+	return buf.String()
+}
+
+// 9: the Markdown renderer writes a | inside a cell unescaped, splitting the cell for every
+// Markdown parser.
+func TestHegelPinMarkdownPipe(t *testing.T) {
+	out := renderWith(renderer.NewMarkdown(), []string{"a"}, [][]string{{"x|y"}})
+	if !strings.Contains(out, "x\\|y") {
+		t.Fatalf("Markdown of a cell x|y:\n%s\nwant the pipe escaped as \\|", out)
+	}
+}
+
+// 10: a cell holding a newline is split into visual lines before the renderers see it, so
+// Markdown gets an extra table row and HTML an extra <tr> (and one <thead> per header line);
+// the renderers' <br> handling is never reached.
+func TestHegelPinMultilineRows(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if n := strings.Count(md, "\n"); n != 3 {
+		t.Fatalf("Markdown of one record with a two-line cell has %d lines, want 3 (header, separator, one row):\n%s", n, md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"x\ny", "z"}})
+	if strings.Count(h, "<tr") != 2 || !strings.Contains(h, "<br>") {
+		t.Fatalf("HTML of one record with a two-line cell:\n%s\nwant one body <tr> with a <br>", h)
+	}
+}
+
+// 11: AutoHide zeroes the widths of columns that are empty in every row; the Blueprint
+// renderer drops them, the Markdown and HTML renderers render them.
+func TestHegelPinAutoHideRenderers(t *testing.T) {
+	md := renderWith(renderer.NewMarkdown(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(md, "A") {
+		t.Fatalf("Markdown with AutoHide still shows the empty column A:\n%s", md)
+	}
+	h := renderWith(renderer.NewHTML(), []string{"a", "b"}, [][]string{{"", "1"}}, tablewriter.WithAutoHide(tw.On))
+	if strings.Contains(h, ">A<") {
+		t.Fatalf("HTML with AutoHide still shows the empty column A:\n%s", h)
+	}
+}
+
+// 12: WithColumnMax is documented as a maximum column width but is shared by the columns
+// (minus the separators); with two columns and 8, each gets 3, its content 1, and WrapTruncate
+// (Truncate at width 0 with the ellipsis) empties the cell.
+func TestHegelPinColumnMaxTruncate(t *testing.T) {
+	out := renderWith(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)}), []string{"a", "b"},
+		[][]string{{"hello world foo bar", "y"}}, tablewriter.WithColumnMax(8), tablewriter.WithRowAutoWrap(tw.WrapTruncate))
+	if !strings.Contains(out, "hello") {
+		t.Fatalf("WithColumnMax(8) with WrapTruncate on a two-column table:\n%s\nwant the first cell truncated to 8 columns, not emptied", out)
+	}
+}
+
+// --------------------------------------------------------------------------- blueprint
+
+func asciiBlueprint() tw.Renderer {
+	return renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleASCII)})
+}
+
+func renderFull(r tw.Renderer, header []string, rows [][]string, footer []string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, append([]tablewriter.Option{tablewriter.WithRenderer(r)}, opts...)...)
+	if header != nil {
+		t.Header(header)
+	}
+	for _, row := range rows {
+		t.Append(row)
+	}
+	if footer != nil {
+		t.Footer(footer)
+	}
+	t.Render()
+	return buf.String()
+}
+
+func sameLineWidths(out string) bool {
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	for _, l := range lines {
+		if twwidth.Width(l) != twwidth.Width(lines[0]) {
+			return false
+		}
+	}
+	return true
+}
+
+// 13: with AlignNone (or the empty alignment) the Blueprint renderer computes the section's
+// default position (header centre, footer right) and then overwrites it with the cell's
+// AlignNone, so formatCell falls to left alignment in every section.
+func TestHegelPinAlignNoneDefaults(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "bbbbb"}, [][]string{{"1", "2"}}, []string{"f", "ggggg"},
+		tablewriter.WithHeaderAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}),
+		tablewriter.WithFooterAlignmentConfig(tw.CellAlignment{Global: tw.AlignNone}))
+	if !strings.Contains(out, "|  A  |") {
+		t.Fatalf("Blueprint with the header alignment AlignNone:\n%s\nwant the header cell A centred (the section's default)", out)
+	}
+}
+
+// 14: the rows' top border is drawn only when the table has neither header nor footer, and
+// the footer's only when there is nothing above it, so a table with rows and a footer but no
+// header starts with a row line, without a top border.
+func TestHegelPinTopBorderFooterOnly(t *testing.T) {
+	out := renderFull(asciiBlueprint(), nil, [][]string{{"1", "2"}}, []string{"f", "g"})
+	if !strings.HasPrefix(out, "+") {
+		t.Fatalf("Blueprint of rows and a footer without a header:\n%s\nwant a top border as the first line", out)
+	}
+}
+
+// 15: renderLine draws the separator before a column only when the previous column's width
+// is positive, so a column hidden by AutoHide (width 0) takes the separator of the column
+// after it with it.
+func TestHegelPinAutoHideSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b", "c"}, [][]string{{"1", "", "3"}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !strings.Contains(out, "| 1 | 3 |") {
+		t.Fatalf("Blueprint with the middle column hidden by AutoHide:\n%s\nwant the row line | 1 | 3 |", out)
+	}
+}
+
+// 16: when AutoHide hides every column the border lines are drawn without their right glyph
+// (no visible column) but the cell lines keep both column glyphs.
+func TestHegelPinAutoHideAllColumns(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, [][]string{{"", ""}}, nil, tablewriter.WithAutoHide(tw.On))
+	if !sameLineWidths(out) {
+		t.Fatalf("Blueprint with every column hidden by AutoHide renders lines of different widths:\n%q", out)
+	}
+}
+
+// 17: with a header and a footer but no rows the header separator and the footer separator
+// are both drawn, two identical lines.
+func TestHegelPinHeaderFooterSeparator(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, nil, []string{"f", "g"})
+	if n := strings.Count(out, "+---+---+\n"); n != 3 {
+		t.Fatalf("Blueprint of a header and a footer without rows has %d border lines, want 3 (top, one separator, bottom):\n%s", n, out)
+	}
+}
+
+// 18: a record without cells still counts as a row line, so a table holding only such a
+// record renders two ++ lines where a table without records renders nothing.
+func TestHegelPinEmptyRecord(t *testing.T) {
+	got := renderFull(asciiBlueprint(), nil, [][]string{{}}, nil)
+	if want := renderFull(asciiBlueprint(), nil, nil, nil); got != want {
+		t.Fatalf("Blueprint of a single empty record = %q, want %q (as with no record)", got, want)
+	}
+}
+
+// 19: header AutoFormat (on by default) passes the cell through SplitCamelCase and Title,
+// which split and upper-case the escape sequences of a coloured header, so the terminal
+// prints them as text.
+func TestHegelPinAutoFormatEscapes(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{esc + "[31mred" + esc + "[0m"}, [][]string{{"1"}}, nil)
+	if !strings.Contains(out, esc+"[31m") {
+		t.Fatalf("Blueprint of a coloured header:\n%q\nwant the escape sequence ESC[31m intact", out)
+	}
+}
+
+// 20: Truncate's scan ends a CSI sequence at any final byte, Width's Filter requires the
+// parameters before the intermediates, so on a sequence such as ESC[ 31 m (an intermediate
+// first) Truncate keeps text that Width counts, and the result is wider than the limit.
+func TestHegelPinTruncateIntermediate(t *testing.T) {
+	setOpts(widthOpts{})
+	s := esc + "[ 31 mRED"
+	got := twwidth.Truncate(s, 2)
+	if w := twwidth.Width(got); w > 2 {
+		t.Fatalf("Truncate(%q, 2) = %q, whose Width is %d, want at most 2", s, got, w)
+	}
+}
+
+// 21: Line takes the excess width of both corner glyphs over the column glyph off the first and
+// last column, so with StyleGraphical (two-cell corners) a lone one-cell column gives border
+// lines one cell wider than the cell lines.
+func TestHegelPinGraphicalNarrowColumn(t *testing.T) {
+	out := renderFull(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleGraphical)}), []string{"a"}, [][]string{{"x"}}, nil, tablewriter.WithPadding(tw.PaddingNone))
+	if !sameLineWidths(out) {
+		t.Fatalf("StyleGraphical with a one-cell column renders lines of different widths:\n%s", out)
+	}
+}
+
+// --------------------------------------------------------------------------- widths, caption
+
+// 22: Caption() and printTopBottomCaption treat AlignLeft as "unset" (tw.AlignDefault is
+// AlignLeft) and replace it by the spot's default, so a left-aligned caption cannot be asked
+// for on a centre or right spot.
+func TestHegelPinCaptionAlignLeft(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(asciiBlueprint()))
+	tb.Caption(tw.Caption{Text: "Table 1", Spot: tw.SpotBottomCenter, Align: tw.AlignLeft})
+	tb.Header([]string{"aaaaaaaaaa", "bbbbbbbbbb"})
+	tb.Append([]string{"1", "2"})
+	tb.Render()
+	if !strings.Contains(buf.String(), "\nTable 1") {
+		t.Fatalf("caption with Align left on a bottom-centre spot:\n%s\nwant the caption at the left edge", buf.String())
+	}
+}
+
+// 23: with a caption, an empty table whose renderer has a top or bottom border is replaced by
+// hard-coded +--+ lines whatever the border style.
+func TestHegelPinCaptionEmptyTable(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewBlueprint(tw.Rendition{Symbols: tw.NewSymbols(tw.StyleLight)})))
+	tb.Caption(tw.Caption{Text: "Table 1", Spot: tw.SpotTopCenter})
+	tb.Render()
+	if strings.Contains(buf.String(), "+--+") {
+		t.Fatalf("caption on an empty table in the Light style:\n%s\nwant no ASCII +--+ placeholder", buf.String())
+	}
+}
+
+// 24: WithMaxWidth ("a global maximum table width") only derives a per-column wrapping width
+// of MaxWidth/columns, which the word wrapper raises to the longest word and which leaves the
+// padding, separators and borders uncounted, so the table is wider than the maximum.
+func TestHegelPinMaxWidthTable(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"a", "b"}, [][]string{{"abcdefgh ijklmnop", "abcdefgh ijklmnop"}}, nil, tablewriter.WithMaxWidth(20))
+	for _, l := range strings.Split(strings.TrimSuffix(out, "\n"), "\n") {
+		if w := twwidth.Width(l); w > 20 {
+			t.Fatalf("WithMaxWidth(20):\n%s\nline %q is %d wide", out, l, w)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- input conversion
+
+func autoHeaderTable(buf *bytes.Buffer) *tablewriter.Table {
+	tb := tablewriter.NewTable(buf, tablewriter.WithRenderer(renderer.NewMarkdown()), tablewriter.WithHeaderAutoFormat(tw.Off))
+	tb.Configure(func(cfg *tablewriter.Config) { cfg.Behavior.Structs.AutoHeader = tw.On })
+	return tb
+}
+
+// 25: convertToString has no case for pointers, so a *int or *string (a nullable column in a
+// struct) falls to fmt.Sprintf("%v") and renders as an address.
+func TestHegelPinPointerCells(t *testing.T) {
+	n := 42
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{&n})
+	tb.Render()
+	if !strings.Contains(buf.String(), "| 42 |") {
+		t.Fatalf("Append of a *int cell:\n%s\nwant the pointed-to value 42", buf.String())
+	}
+}
+
+// 26: a typed nil pointer whose String() or Error() dereferences (a nil *time.Time field) is
+// called through the fmt.Stringer/error cases and panics.
+func TestHegelPinNilStringerPanics(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Append of a struct with a nil *time.Time field panicked: %v", r)
+		}
+	}()
+	type row struct {
+		Name string
+		At   *time.Time
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Append(row{Name: "a"})
+	tb.Render()
+}
+
+// 27: convertToString handles sql.NullString/NullInt64/NullFloat64/NullBool/NullTime but not
+// sql.NullInt32, NullInt16 and NullByte, which print as {5 true}.
+func TestHegelPinNullInt32(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{sql.NullInt32{Int32: 5, Valid: true}, sql.NullInt32{}})
+	tb.Render()
+	if got := buf.String(); !strings.Contains(got, "| 5 |") || strings.Contains(got, "true") {
+		t.Fatalf("Append of sql.NullInt32 cells:\n%s\nwant 5 and an empty cell", got)
+	}
+}
+
+// 28: a []byte appended as the row is the []uint8 case, one numeric cell per byte, though
+// the code says a []byte is handled as a string (as it is inside a []any).
+func TestHegelPinByteSliceRow(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]byte("ab"))
+	tb.Render()
+	if !strings.Contains(buf.String(), "| ab |") {
+		t.Fatalf("Append of a []byte row:\n%s\nwant the cell ab", buf.String())
+	}
+}
+
+// 29: an io.Reader cell reads up to 512 bytes and appends the ellipsis when 512 were read,
+// so a reader of exactly 512 bytes is marked truncated.
+func TestHegelPinReaderEllipsis(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append([]any{strings.NewReader(strings.Repeat("x", 512))})
+	tb.Render()
+	if strings.Contains(buf.String(), tw.CharEllipsis) {
+		t.Fatalf("Append of a 512-byte reader:\n%s\nwant no ellipsis, nothing was cut", buf.String())
+	}
+}
+
+// 30: a nil embedded struct pointer contributes no columns, so AutoHeader taken from such a
+// row lacks the embedded fields and later rows with the pointer set are misaligned.
+func TestHegelPinEmbeddedNilPointer(t *testing.T) {
+	type outer struct {
+		*Inner1
+		C string
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Bulk([]outer{{C: "c1"}, {Inner1: &Inner1{X: "x", Y: 1}, C: "c2"}})
+	tb.Render()
+	lines := strings.Split(strings.TrimSuffix(buf.String(), "\n"), "\n")
+	if len(lines) != 4 || !strings.Contains(lines[0], "X") || !strings.Contains(lines[3], "| x") {
+		t.Fatalf("Bulk with a nil embedded pointer in the first row:\n%s\nwant three columns X, Y, C with the second row x, 1, c2 under them", buf.String())
+	}
+}
+
+// 31: a value without exported fields appended alone (an error, a *strings.Reader) is
+// reflected as a struct of zero fields and becomes an empty row, where the same value inside a
+// []any is its text.
+func TestHegelPinSingleErrorRow(t *testing.T) {
+	var buf bytes.Buffer
+	tb := tablewriter.NewTable(&buf, tablewriter.WithRenderer(renderer.NewMarkdown()))
+	tb.Append(errors.New("boom"))
+	tb.Render()
+	if !strings.Contains(buf.String(), "boom") {
+		t.Fatalf("Append of an error alone:\n%q\nwant the row boom", buf.String())
+	}
+}
+
+// 32: extractHeadersFromStruct converts the values too, so AutoHeader reads the first row's
+// io.Reader fields before Append reads them again, and the cell holds only what was left.
+func TestHegelPinAutoHeaderReader(t *testing.T) {
+	type row struct {
+		Data io.Reader
+	}
+	var buf bytes.Buffer
+	tb := autoHeaderTable(&buf)
+	tb.Append(row{Data: strings.NewReader("hello")})
+	tb.Render()
+	if !strings.Contains(buf.String(), "hello") {
+		t.Fatalf("AutoHeader over a struct with an io.Reader field:\n%s\nwant the cell hello", buf.String())
+	}
+}
+
+// 33: above a horizontally merged header cell the top border's junction with the next column
+// is the row glyph, since the junction rule asks whether the merge's first column ends the
+// merge rather than whether the next column continues it; the header line has its separator
+// there.
+func TestHegelPinTopBorderAfterMergedHeader(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "A", "B"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal))
+	lines := strings.Split(out, "\n")
+	if len(lines) < 2 {
+		t.Fatalf("merged header table:\n%s", out)
+	}
+	sep := strings.LastIndex(lines[1], "|")
+	sep = strings.LastIndex(lines[1][:sep], "|") // the separator between the merged cell and B
+	if sep < 0 || sep >= len(lines[0]) || lines[0][sep] != '+' {
+		t.Fatalf("merged header table:\n%s\nwant a + in the top border above the separator at column %d", out, sep)
+	}
+}
+
+// 34: applyHorizontalMerges sizes a merged header cell by the natural widths of its columns
+// before AutoHide zeroes the hidden ones, so the header line is wider than the rows.
+func TestHegelPinMergedHeaderHiddenColumn(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "A", "B"}, [][]string{{"1", "", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal), tablewriter.WithAutoHide(tw.On))
+	if !sameLineWidths(out) {
+		t.Fatalf("merged header over a hidden column:\n%s\nwant every line as wide as the others", out)
+	}
+}
+
+// 35: the footer's lead merge moves the first content cell to the first column on the first
+// visual line only and blanks the merged columns on the others, dropping the later lines of a
+// multi-line cell.
+func TestHegelPinFooterLeadMergeLines(t *testing.T) {
+	out := renderFull(asciiBlueprint(), []string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, []string{"", "Total\nSum", "5"}, tablewriter.WithFooterMergeMode(tw.MergeHorizontal))
+	if !strings.Contains(out, "Sum") {
+		t.Fatalf("footer lead merge of a two-line cell:\n%s\nwant its second line Sum rendered", out)
+	}
+}
+
+// streamTable renders through Start/Header/Append/Footer/Close with the ASCII Blueprint.
+func streamTable(header []string, rows [][]string, footer []string, opts ...tablewriter.Option) string {
+	var buf bytes.Buffer
+	all := append([]tablewriter.Option{tablewriter.WithRenderer(asciiBlueprint()), tablewriter.WithStreaming(tw.StreamConfig{Enable: true})}, opts...)
+	t := tablewriter.NewTable(&buf, all...)
+	if err := t.Start(); err != nil {
+		return "start: " + err.Error()
+	}
+	if header != nil {
+		t.Header(header)
+	}
+	for _, r := range rows {
+		t.Append(r)
+	}
+	if footer != nil {
+		t.Footer(footer)
+	}
+	t.Close()
+	return buf.String()
+}
+
+// 36: in streaming the header's horizontal merges are detected (the top border spans them)
+// but renderLine sizes a header merge by its first column's width alone (the merged widths
+// applyHorizontalMerges computes in batch mode are never set), so the header line is narrower
+// than the borders.
+func TestHegelPinStreamHeaderMerge(t *testing.T) {
+	out := streamTable([]string{"A", "A", "B"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithHeaderMergeMode(tw.MergeHorizontal))
+	if !sameLineWidths(out) {
+		t.Fatalf("streamed table with a merged header:\n%s\nwant every line as wide as the others", out)
+	}
+}
+
+// 37: Start() says only horizontal merges are considered in streaming, but the footer's are
+// not: streamStoreFooter never calls prepareWithMerges and streamRenderFooter passes nil
+// merge states, so a footer "", "Total", "5" under MergeHorizontal keeps three cells.
+func TestHegelPinStreamFooterMerge(t *testing.T) {
+	out := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, []string{"x", "x", "5"}, tablewriter.WithFooterMergeMode(tw.MergeHorizontal))
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	footer := lines[len(lines)-2]
+	if strings.Count(footer, "x") != 1 {
+		t.Fatalf("streamed table with a merged footer:\n%s\nwant the footer's two x cells merged into one", out)
+	}
+}
+
+// 38: an empty row appended first is skipped but marks the first row as rendered, so the
+// header separator is never drawn.
+func TestHegelPinStreamEmptyFirstRow(t *testing.T) {
+	out := streamTable([]string{"A", "B"}, [][]string{{}, {"1", "2"}}, nil)
+	want := streamTable([]string{"A", "B"}, [][]string{{"1", "2"}}, nil)
+	if out != want {
+		t.Fatalf("streamed table with an empty first row:\n%s\nwant the same as without it:\n%s", out, want)
+	}
+}
+
+// 39: the Widths.Global shrink rounds every column and spreads the remainder one by one over
+// the columns in the order Mapper.Each iterates the map, so the same table lays out
+// differently from run to run.
+func TestHegelPinStreamGlobalWidthRandom(t *testing.T) {
+	first := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithColumnMax(16))
+	for i := 0; i < 40; i++ {
+		out := streamTable([]string{"A", "B", "C"}, [][]string{{"1", "2", "3"}}, nil, tablewriter.WithColumnMax(16))
+		if out != first {
+			t.Fatalf("streamed table under WithColumnMax(16) rendered two ways:\n%s\n%s", first, out)
+		}
+	}
+}
+
+// 40: a streamed Append with a horizontal row merge blanks the merged cells in the caller's
+// slice; batch mode leaves the input alone.
+func TestHegelPinStreamAppendLeavesTheRowAlone(t *testing.T) {
+	row := []string{"a", "a", "b"}
+	tbl := tablewriter.NewTable(io.Discard, tablewriter.WithStreaming(tw.StreamConfig{Enable: true}), tablewriter.WithRowMergeMode(tw.MergeHorizontal))
+	if err := tbl.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	if err := tbl.Append(row); err != nil {
+		t.Fatalf("Append: %v", err)
+	}
+	tbl.Close()
+	if got := strings.Join(row, ","); got != "a,a,b" {
+		t.Errorf("streamed Append with a horizontal merge changed the caller's row to [%s]; batch mode leaves it as [a,a,b]", got)
+	}
+}
