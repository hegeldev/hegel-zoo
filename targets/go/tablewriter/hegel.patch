+package hegel
+
+// The boxed rendering (renderer.Blueprint) against an exact model: the same prepared table as
+// the Markdown/HTML properties, laid out as border lines (corner, junction and edge glyphs of
+// the style, a horizontal segment per visible column) and cell lines (the column glyph as
+// left/right border and separator, every cell padded to its column width by the alignment),
+// under every combination of the rendition's borders, separators and lines.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var borderStyles = []tw.BorderStyle{
+	tw.StyleASCII, tw.StyleLight, tw.StyleHeavy, tw.StyleDouble, tw.StyleRounded, tw.StyleDotted,
+	tw.StyleLightHeavy, tw.StyleLightDouble, tw.StyleMarkdown, tw.StyleNone, tw.StyleGraphical,
+}
+
+var stateChoices = []tw.State{tw.Unknown, tw.On, tw.Off}
+
+type rendSpec struct {
+	style   tw.BorderStyle
+	borders tw.Border
+	seps    tw.Separators
+	lines   tw.Lines
+}
+
+func genRendSpec(tc hegel.TestCase) rendSpec {
+	r := rendSpec{style: pick(tc, borderStyles)}
+	if chance(tc, 70) {
+		r.borders = tw.Border{Left: pick(tc, stateChoices), Right: pick(tc, stateChoices), Top: pick(tc, stateChoices), Bottom: pick(tc, stateChoices)}
+	}
+	if chance(tc, 70) {
+		r.seps = tw.Separators{BetweenRows: pick(tc, stateChoices), BetweenColumns: pick(tc, stateChoices)}
+	}
+	if chance(tc, 70) {
+		r.lines = tw.Lines{ShowTop: pick(tc, stateChoices), ShowBottom: pick(tc, stateChoices), ShowHeaderLine: pick(tc, stateChoices), ShowFooterLine: pick(tc, stateChoices)}
+	}
+	return r
+}
+
+func (r rendSpec) rendition() tw.Rendition {
+	return tw.Rendition{Symbols: tw.NewSymbols(r.style), Borders: r.borders, Settings: tw.Settings{Separators: r.seps, Lines: r.lines}}
+}
+
+func (r rendSpec) String() string {
+	return "style=" + tw.NewSymbols(r.style).Name() + " borders=" + states(r.borders.Left, r.borders.Right, r.borders.Top, r.borders.Bottom) +
+		" seps=" + states(r.seps.BetweenRows, r.seps.BetweenColumns) + " lines=" + states(r.lines.ShowTop, r.lines.ShowBottom, r.lines.ShowHeaderLine, r.lines.ShowFooterLine)
+}
+
+func states(ss ...tw.State) string {
+	parts := make([]string, len(ss))
+	for i, s := range ss {
+		switch s {
+		case tw.On:
+			parts[i] = "on"
+		case tw.Off:
+			parts[i] = "off"
+		default:
+			parts[i] = "-"
+		}
+	}
+	return strings.Join(parts, ",")
+}
+
+// effective settings: an unset state keeps the renderer's default (everything on but the
+// separators between rows)
+func eff(s tw.State, def bool) bool {
+	switch s {
+	case tw.On:
+		return true
+	case tw.Off:
+		return false
+	}
+	return def
+}
+
+type layout struct {
+	left, right, top, bottom       bool
+	betweenRows, betweenCols       bool
+	showTop, showBottom            bool
+	showHeaderLine, showFooterLine bool
+	sym                            tw.Symbols
+}
+
+func (r rendSpec) layout() layout {
+	return layout{
+		left: eff(r.borders.Left, true), right: eff(r.borders.Right, true), top: eff(r.borders.Top, true), bottom: eff(r.borders.Bottom, true),
+		betweenRows: eff(r.seps.BetweenRows, false), betweenCols: eff(r.seps.BetweenColumns, true),
+		showTop: eff(r.lines.ShowTop, true), showBottom: eff(r.lines.ShowBottom, true),
+		showHeaderLine: eff(r.lines.ShowHeaderLine, true), showFooterLine: eff(r.lines.ShowFooterLine, true),
+		sym: tw.NewSymbols(r.style),
+	}
+}
+
+const (
+	lvHeader = iota
+	lvBody
+	lvFooter
+)
+
+const (
+	locFirst = iota
+	locMiddle
+	locEnd
+)
+
+// lineCtx is the tw.Formatting a separator line is rendered with: its level and location, the
+// section of the line above (Position), the merge states of the cells above and below, whether
+// a footer follows, and the widths its segments follow (a header's own widths for the top
+// border, the rows' otherwise).
+type lineCtx struct {
+	level, loc, pos int
+	cur, next       []cellMerge
+	hasFooter       bool
+	widths          []int
+}
+
+func w0(s string) int { return width(s, widthOpts{}) }
+
+// leftGlyph is the model of Junction.RenderLeft.
+func (l layout) leftGlyph(lc lineCtx) string {
+	if (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst {
+		return l.sym.TopLeft()
+	}
+	if (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter) || (lc.level == lvFooter && lc.loc == locEnd) {
+		return l.sym.BottomLeft()
+	}
+	if vpass(getMerge(lc.cur, 0), getMerge(lc.next, 0)) {
+		return l.sym.Column()
+	}
+	return l.sym.MidLeft()
+}
+
+// rightGlyph is the model of Junction.RenderRight.
+func (l layout) rightGlyph(lc lineCtx, last int) string {
+	if last < 0 {
+		switch lc.level {
+		case lvHeader:
+			return l.sym.TopRight()
+		case lvFooter:
+			return l.sym.BottomRight()
+		}
+		switch lc.loc {
+		case locFirst:
+			return l.sym.TopRight()
+		case locEnd:
+			return l.sym.BottomRight()
+		}
+		return l.sym.MidRight()
+	}
+	if (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst {
+		return l.sym.TopRight()
+	}
+	if (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter) || (lc.level == lvFooter && lc.loc == locEnd) {
+		return l.sym.BottomRight()
+	}
+	if vpass(getMerge(lc.cur, last), getMerge(lc.next, last)) {
+		return l.sym.Column()
+	}
+	return l.sym.MidRight()
+}
+
+// junctionGlyph is the model of Junction.RenderJunction between two visible columns.
+func (l layout) junctionGlyph(lc lineCtx, left, right int) string {
+	curL, curR := getMerge(lc.cur, left), getMerge(lc.cur, right)
+	nextL, nextR := getMerge(lc.next, left), getMerge(lc.next, right)
+	spannedCur := curL.h.present && !curL.h.end
+	spannedNext := nextL.h.present && !nextL.h.end
+	// the junction lies inside a merge below when the right column continues it; the renderer
+	// asks whether the left column ends one, which differs above a merged header, whose
+	// continuing columns have no width (bug 33)
+	if !Known.topJunctionAfterMerge {
+		spannedNext = nextR.h.present && !nextR.h.start
+	}
+	passL := vpass(curL, nextL)
+	passR := vpass(curR, nextR)
+	isTop := (lc.level == lvHeader || lc.level == lvBody) && lc.loc == locFirst
+	isBottom := (lc.level == lvFooter && lc.loc == locEnd) || (lc.level == lvBody && lc.loc == locEnd && !lc.hasFooter)
+	isPreFooter := lc.level == lvFooter && (lc.pos == secRow || lc.pos == secHeader)
+	sym := l.sym
+	if isTop {
+		if spannedNext {
+			return sym.Row()
+		}
+		return sym.TopMid()
+	}
+	if isBottom {
+		switch {
+		case passL && passR:
+			return sym.Column()
+		case passL:
+			return sym.MidLeft()
+		case passR:
+			return sym.MidRight()
+		case spannedCur:
+			return sym.Row()
+		}
+		return sym.BottomMid()
+	}
+	if isPreFooter {
+		switch {
+		case passL && passR:
+			return sym.Column()
+		case passL:
+			return sym.MidLeft()
+		case passR:
+			return sym.MidRight()
+		}
+		if curL.h.present {
+			if !curL.h.end && curR.h.present && !curR.h.end {
+				return sym.BottomMid()
+			}
+			if !curL.h.end && curR.h.present && curR.h.end {
+				return sym.BottomMid()
+			}
+			if curL.h.end && !curR.h.present {
+				return sym.Center()
+			}
+		}
+		if spannedNext {
+			return sym.BottomMid()
+		}
+		if spannedCur {
+			return sym.TopMid()
+		}
+		return sym.Center()
+	}
+	switch {
+	case passL && passR:
+		return sym.Column()
+	case passL:
+		return sym.MidLeft()
+	case passR:
+		return sym.MidRight()
+	case spannedCur && spannedNext:
+		return sym.Row()
+	case spannedCur:
+		return sym.TopMid()
+	case spannedNext:
+		return sym.BottomMid()
+	}
+	return sym.Center()
+}
+
+// borderLine is the model of Blueprint.Line: a horizontal segment per visible column (spaces
+// where a vertical merge passes through), the widths of the first and last adjusted by how
+// much the corner glyphs are wider than the column glyph, junctions of the column glyph's
+// width (else the centre glyph, else the column glyph), the whole between the left and right
+// glyphs the junction rules pick.
+func (l layout) borderLine(m tableModel, lc lineCtx) string {
+	if m.numCols == 0 {
+		var pre, suf string
+		if l.left {
+			pre = l.leftGlyph(lc)
+		}
+		if l.right {
+			suf = l.rightGlyph(lc, -1)
+		}
+		if pre == "" && suf == "" {
+			return ""
+		}
+		return pre + suf + "\n"
+	}
+	var visible []int
+	for i := 0; i < m.numCols; i++ {
+		if lc.widths[i] > 0 {
+			visible = append(visible, i)
+		}
+	}
+	var b strings.Builder
+	colW := w0(l.sym.Column())
+	leftG := ""
+	if l.left {
+		leftG = l.leftGlyph(lc)
+		b.WriteString(leftG)
+	}
+	for k, i := range visible {
+		adj := lc.widths[i]
+		if l.left && k == 0 {
+			adj -= w0(leftG) - colW
+		}
+		if l.right && k == len(visible)-1 {
+			adj -= w0(l.rightGlyph(lc, i)) - colW
+		}
+		adj = max(adj, 0)
+		seg := l.sym.Row()
+		if vpass(getMerge(lc.cur, i), getMerge(lc.next, i)) {
+			seg = ""
+		}
+		if seg == "" {
+			b.WriteString(strings.Repeat(" ", adj))
+		} else {
+			segW := max(w0(seg), 1)
+			rep := adj / segW
+			if rep < 1 && adj > 0 {
+				rep = 1
+			}
+			out := strings.Repeat(seg, rep)
+			if w0(out) > adj {
+				out = truncate(out, adj, "", widthOpts{})
+			} else if w0(out) < adj {
+				for j := 0; j < (adj-w0(out))/segW; j++ {
+					out += seg
+				}
+				if w0(out) < adj {
+					out += strings.Repeat(" ", adj-w0(out))
+				}
+			}
+			b.WriteString(out)
+		}
+		if k < len(visible)-1 && l.betweenCols {
+			junction := l.junctionGlyph(lc, i, visible[k+1])
+			if w0(junction) != colW {
+				junction = l.sym.Center()
+				if w0(junction) != colW {
+					junction = l.sym.Column()
+				}
+			}
+			b.WriteString(junction)
+		}
+	}
+	if l.right && len(visible) > 0 {
+		b.WriteString(l.rightGlyph(lc, visible[len(visible)-1]))
+	}
+	b.WriteString("\n")
+	return b.String()
+}
+
+func (m tableModel) visibleCols() []int {
+	var visible []int
+	for i := 0; i < m.numCols; i++ {
+		if !m.hidden[i] {
+			visible = append(visible, i)
+		}
+	}
+	return visible
+}
+
+func padOr(p string) string {
+	if p == "" {
+		return " "
+	}
+	return p
+}
+
+// bpCell is the model of Blueprint.formatCell.
+func bpCell(content string, w int, pad tw.Padding, align tw.Align) string {
+	if w <= 0 {
+		return ""
+	}
+	o := widthOpts{}
+	cw := width(content, o)
+	pl, pr := w0(pad.Left), w0(pad.Right)
+	avail := max(w-pl-pr, 0)
+	if cw > avail {
+		content = truncate(content, avail, "", o)
+		cw = width(content, o)
+	}
+	total := max(w-cw, 0)
+	var out string
+	switch align {
+	case tw.AlignRight:
+		if n := total - pr; n > 0 {
+			out = strings.Repeat(padOr(pad.Left), n)
+		}
+		out += content + pad.Right
+	case tw.AlignCenter:
+		left := (total-pl-pr)/2 + pl
+		right := total - left
+		if left > pl {
+			out = strings.Repeat(padOr(pad.Left), left-pl)
+		}
+		out += pad.Left + content + pad.Right
+		if right > pr {
+			out += strings.Repeat(padOr(pad.Right), right-pr)
+		}
+	default:
+		out = pad.Left + content
+		if n := total - pl; n > 0 {
+			out += strings.Repeat(padOr(pad.Right), n)
+		}
+	}
+	if fw := width(out, o); fw > w {
+		out = truncate(out, w, "", o)
+	} else if fw < w {
+		out += strings.Repeat(" ", w-fw)
+	}
+	return out
+}
+
+// bpAlign resolves a cell's alignment as the renderer does: an explicit one is kept; AlignNone
+// or the empty alignment falls to the left (Known.alignNoneLeft) or to the section's default.
+func bpAlign(a tw.Align, sec int) tw.Align {
+	if explicit(a) {
+		return a
+	}
+	if Known.alignNoneLeft {
+		return tw.AlignLeft
+	}
+	switch sec {
+	case secHeader:
+		return tw.AlignCenter
+	case secFooter:
+		return tw.AlignRight
+	}
+	return tw.AlignLeft
+}
+
+// cellLine is the model of Blueprint.renderLine for a visual line of a section: every column
+// of width 0 is skipped unless it starts a horizontal merge; a separator precedes a column
+// when the previous one has a width or ends a merge, and the column does not continue one; a
+// merge's first cell takes the span's width (a row's from the normalized widths, a header's or
+// footer's as pre-computed) and the continuing cells print nothing; an AlignNone cell that
+// starts a footer merge or follows a "total" cell is right-aligned; a cell continuing a
+// vertical or hierarchical merge is blank.
+func (l layout) cellLine(m tableModel, s tableSpec, line []string, sec int, merges []cellMerge, widths []int) string {
+	line = padLine(line, m.numCols)
+	aligns := s.aligns(sec, m.numCols)
+	colW := w0(l.sym.Column())
+	sepW := 0
+	if l.betweenCols {
+		sepW = colW
+	}
+	var b strings.Builder
+	if l.left {
+		b.WriteString(l.sym.Column())
+	}
+	seen := false
+	for i := 0; i < m.numCols; {
+		st := getMerge(merges, i)
+		vw := widths[i]
+		hStart := st.h.present && st.h.start
+		if vw == 0 && !hStart {
+			i++
+			continue
+		}
+		if i > 0 && l.betweenCols {
+			prev := getMerge(merges, i-1)
+			prevEnd := prev.h.present && prev.h.end
+			before := widths[i-1] > 0 || prevEnd
+			if !Known.autoHideSeparator && seen {
+				before = true // the renderer looks at the previous column's width, hidden or not
+			}
+			if before && (!st.h.present || st.h.start) {
+				b.WriteString(l.sym.Column())
+			}
+		}
+		span := 1
+		if hStart {
+			span = st.h.span
+			if sec == secRow {
+				vw = 0
+				for k := 0; k < span && i+k < m.numCols; k++ {
+					vw += max(m.widths[i+k], 0)
+					if k > 0 && sepW > 0 && m.widths[i+k] > 0 {
+						vw += sepW
+					}
+				}
+			}
+		}
+		vw = max(vw, 0)
+		if st.h.present && !st.h.start {
+			i++
+			continue
+		}
+		a := aligns[i]
+		isTotal := hStart && i > 0 && strings.Contains(strings.ToLower(line[i-1]), "total")
+		if ((sec == secFooter && hStart) || isTotal) && a == tw.AlignNone {
+			a = tw.AlignRight
+		}
+		data := line[i]
+		if (st.v.present && !st.v.start) || (st.hier.present && !st.hier.start) {
+			data = ""
+		}
+		b.WriteString(bpCell(data, vw, s.pad(), bpAlign(a, sec)))
+		seen = true
+		i += span
+	}
+	if l.right {
+		b.WriteString(l.sym.Column())
+	}
+	b.WriteString("\n")
+	return b.String()
+}
+
+// blueprint is the model of the whole boxed rendering.
+func (s tableSpec) blueprint(r rendSpec) string {
+	m := s.model()
+	l := r.layout()
+	hW := m.mergedWidths(m.hdrM, l)
+	fW := m.mergedWidths(m.ftrM, l)
+	rW := m.widths
+	var b strings.Builder
+	hasRecords := len(m.records) > 0 // the table counts records, with or without cells
+	hasFooter := m.footer != nil
+	hasHeader := m.header != nil
+	// the states of the last line above the footer (or the bottom border), and its section
+	abovePos, aboveM := secHeader, m.hdrM
+	if hasRecords {
+		abovePos, aboveM = secRow, m.recM[len(m.recM)-1]
+	}
+	if hasHeader {
+		if l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secHeader, next: m.hdrM, widths: hW}))
+		}
+		for _, line := range m.header {
+			b.WriteString(l.cellLine(m, s, line, secHeader, m.hdrM, hW))
+		}
+		// the header separator; between a header and a footer with no rows the footer
+		// separator follows at once (bug 17), so only one line is due there
+		if l.showHeaderLine && (hasRecords || hasFooter) && !(hasFooter && !hasRecords && l.showFooterLine && !Known.doubleSeparator) {
+			next := m.ftrM
+			if hasRecords {
+				next = m.recM[0]
+			}
+			b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secHeader, cur: m.hdrM, next: next, widths: rW}))
+		}
+	}
+	if hasRecords {
+		if !hasHeader && (!hasFooter || !Known.noTopBorderWithoutHeader) && l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secRow, next: m.recM[0], widths: rW}))
+		}
+		for i, rec := range m.records {
+			for _, line := range rec {
+				b.WriteString(l.cellLine(m, s, line, secRow, m.recM[i], rW))
+			}
+			if l.betweenRows && i < len(m.records)-1 {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secRow, cur: m.recM[i], next: m.recM[i+1], hasFooter: hasFooter, widths: rW}))
+			}
+		}
+	}
+	above := hasHeader || hasRecords
+	if !hasFooter {
+		if above && l.bottom && l.showBottom {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: abovePos, cur: aboveM, widths: rW}))
+		}
+		return b.String()
+	}
+	if !above && !Known.noTopBorderWithoutHeader && l.top && l.showTop {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secFooter, next: m.ftrM, widths: rW}))
+	}
+	if above && l.showFooterLine {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locMiddle, pos: abovePos, cur: aboveM, next: m.ftrM, hasFooter: true, widths: rW}))
+	}
+	for _, line := range m.footer {
+		b.WriteString(l.cellLine(m, s, line, secFooter, m.ftrM, fW))
+	}
+	if l.bottom && l.showBottom {
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: secFooter, cur: m.ftrM, widths: rW}))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- caption
+
+var captionTexts = []string{
+	"Table 1", "A caption that is rather longer than the table below it, to be wrapped",
+	"x", "two\nlines", "  spaced  ", "あいう えお", "word " + esc + "[1mbold" + esc + "[0m end",
+}
+
+var captionSpots = []tw.Spot{
+	tw.SpotNone, tw.SpotTopLeft, tw.SpotTopCenter, tw.SpotTopRight,
+	tw.SpotBottomLeft, tw.SpotBottomCenter, tw.SpotBottomRight, tw.SpotLeftTop,
+}
+
+// withCaption is the model of Render's caption handling around the rendered table: a side
+// spot prints nothing; an empty table with a border is replaced by +--+ lines; the caption is
+// wrapped (WrapString) to its Width, else to the table's width, else (a table narrower than
+// five cells) to its own width, and every line padded (tw.Pad) to the same target with the
+// caption's alignment, the spot's default standing in for an unset one.
+func (s tableSpec) withCaption(table string, r rendSpec) string {
+	c := s.caption
+	if c == nil || c.Text == "" {
+		return table
+	}
+	spot := c.Spot
+	if spot == tw.SpotNone {
+		spot = tw.SpotBottomCenter
+	}
+	if spot < tw.SpotTopLeft || spot > tw.SpotBottomRight {
+		return table
+	}
+	l := r.layout()
+	content := table
+	if content == "" && (l.top || l.bottom) {
+		var sb strings.Builder
+		if l.top {
+			sb.WriteString("+--+\n")
+		}
+		if l.bottom {
+			sb.WriteString("+--+")
+		}
+		content = sb.String()
+	}
+	tableW := 0
+	for _, ln := range strings.Split(strings.TrimRight(content, "\r\n \t"), "\n") {
+		tableW = max(tableW, w0(ln))
+	}
+	wrapW := tableW
+	if c.Width > 0 {
+		wrapW = c.Width
+	} else if tableW <= 4 {
+		wrapW = w0(c.Text)
+	}
+	if wrapW <= 0 {
+		wrapW = 10
+	}
+	target := tableW
+	if c.Width > 0 {
+		target = c.Width
+	} else if tableW <= 4 {
+		target = wrapW
+	}
+	align := c.Align
+	if align == "" || align == tw.AlignNone || (align == tw.AlignLeft && Known.captionAlignLeft) {
+		switch spot {
+		case tw.SpotTopLeft, tw.SpotBottomLeft:
+			align = tw.AlignLeft
+		case tw.SpotTopRight, tw.SpotBottomRight:
+			align = tw.AlignRight
+		default:
+			align = tw.AlignCenter
+		}
+	}
+	lines, _ := wrapString(c.Text, wrapW)
+	var cap strings.Builder
+	for _, ln := range lines {
+		cap.WriteString(padAlign(ln, " ", target, align, widthOpts{}))
+		cap.WriteString("\n")
+	}
+	if spot <= tw.SpotTopRight {
+		return cap.String() + content
+	}
+	out := content
+	if content != "" && !strings.HasSuffix(content, "\n") {
+		out += "\n"
+	}
+	return out + cap.String()
+}
+
+var wrapChoices = []int{tw.WrapNone, tw.WrapNormal, tw.WrapTruncate, tw.WrapBreak}
+
+func genConstraints(tc hegel.TestCase, s *tableSpec) {
+	for sec := range s.wrap {
+		if chance(tc, 50) {
+			s.wrap[sec] = pick(tc, wrapChoices)
+		}
+		if chance(tc, 40) {
+			s.secMax[sec] = drawInt(tc, 1, 12)
+		}
+	}
+	if chance(tc, 40) {
+		s.colWidths = map[int]int{}
+		n := drawInt(tc, 1, 3)
+		for i := 0; i < n; i++ {
+			s.colWidths[drawInt(tc, 0, 4)] = pick(tc, []int{0, 1, 2, 3, 5, 8, 12, -1})
+		}
+	}
+	if chance(tc, 40) {
+		s.maxWidth = drawInt(tc, 1, 30)
+	}
+	if chance(tc, 40) {
+		s.caption = &tw.Caption{Text: pick(tc, captionTexts), Spot: pick(tc, captionSpots), Align: pick(tc, alignChoices), Width: pick(tc, []int{0, 0, 0, 4, 8, 20})}
+	}
+}
+
+// TestHegelConstraints: the boxed rendering under width constraints (per-column widths, the
+// sections' maximum widths, the table's maximum width), the wrap modes and a caption.
+func TestHegelConstraints(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.htmlCfg = nil
+		s.padding = pick(ht, paddingChoices)
+		genConstraints(ht, &s)
+		r := genRendSpec(ht)
+		m := s.model()
+		if m.numCols == 0 && (s.caption == nil || len(m.records) > 0) {
+			c.count("degenerate")
+			return
+		}
+		if s.autoHide && len(m.visibleCols()) == 0 {
+			c.count("all hidden")
+			return
+		}
+		s.classify(c)
+		for sec, name := range []string{"header", "row", "footer"} {
+			c.count(name + " wrap " + itoa(s.wrapMode(sec)))
+		}
+		if s.colWidths != nil {
+			c.count("colWidths")
+		}
+		if s.maxWidth > 0 {
+			c.count("maxWidth")
+		}
+		if s.caption != nil {
+			c.count("caption")
+		}
+		got, err := s.render(renderer.NewBlueprint(r.rendition()))
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+			return
+		}
+		want := s.withCaption(s.blueprint(r), r)
+		if got != want {
+			c.failClass(ht, "constraints", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+		}
+	})
+}
+
+var paddingChoices = []*tw.Padding{nil, nil, nil, {Left: "", Right: "", Overwrite: true}, {Left: "*", Right: "**"}, {Left: "", Right: ">"}}
+
+func TestHegelBlueprint(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genTableSpec(ht)
+		s.htmlCfg = nil
+		s.padding = pick(ht, paddingChoices)
+		r := genRendSpec(ht)
+		m := s.model()
+		if m.numCols == 0 {
+			c.count("degenerate") // an empty table, or empty records alone (bug 18)
+			return
+		}
+		if s.autoHide {
+			if len(m.visibleCols()) == 0 {
+				c.count("all hidden") // bug 16
+				return
+			}
+		}
+		s.classify(c)
+		c.count("style " + m0(tw.NewSymbols(r.style).Name()))
+		got, err := s.render(renderer.NewBlueprint(r.rendition()))
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+			return
+		}
+		want := s.blueprint(r)
+		if got != want {
+			c.failClass(ht, "blueprint", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+			return
+		}
+		// every line of a bordered table is as wide as the others, unless a separator was
+		// dropped after a hidden column (bug 15) or AutoFormat mangled an escape sequence
+		// (bug 19), which Truncate and Width then measure differently (bug 20)
+		l := r.layout()
+		skip := false
+		for i := 1; i < m.numCols; i++ {
+			if Known.autoHideSeparator && l.betweenCols && m.hidden[i-1] && !m.hidden[i] {
+				skip = true
+			}
+		}
+		if s.mangledEscape() {
+			c.count("mangled escape")
+			skip = true
+		}
+		// a lone column narrower than the two corner glyphs' excess over the column glyph
+		// (StyleGraphical, bug 21)
+		if vis := m.visibleCols(); len(vis) == 1 && l.left && l.right {
+			colW := w0(l.sym.Column())
+			if m.widths[vis[0]] < w0(l.sym.TopLeft())-colW+w0(l.sym.TopRight())-colW {
+				c.count("narrow corners")
+				skip = true
+			}
+		}
+		if l.left && l.right && r.style != tw.StyleNone && !skip {
+			lines := strings.Split(strings.TrimSuffix(got, "\n"), "\n")
+			for _, ln := range lines {
+				if w0(ln) != w0(lines[0]) {
+					c.failClass(ht, "ragged", "Blueprint of %s %s has lines of different widths:\n%s", s, r, got)
+					break
+				}
+			}
+		}
+	})
+}
+
+func m0(s string) string { return strings.ToLower(s) }
+
+// mangledEscape reports whether an auto-formatted section holds a cell with an escape
+// sequence (bug 19: SplitCamelCase and Title rewrite it).
+func (s tableSpec) mangledEscape() bool {
+	has := func(cells []string) bool {
+		for _, c := range cells {
+			if strings.Contains(c, esc) {
+				return true
+			}
+		}
+		return false
+	}
+	if s.autoFormat[secHeader] && has(s.header) || s.autoFormat[secFooter] && has(s.footer) {
+		return true
+	}
+	if s.autoFormat[secRow] {
+		for _, r := range s.rows {
+			if has(r) {
+				return true
+			}
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_fn_test.go b/hegel/hegel_fn_test.go
new file mode 100644
index 0000000..bf6ecd5
--- /dev/null
+++ b/hegel/hegel_fn_test.go
@@ -0,0 +1,246 @@
+package hegel
+
+// Properties of the tw helpers: Title, SplitCamelCase, IsNumeric, BreakPoint and the Pad
+// family against models of their documentation.
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var titlePieces = []string{"a", "b", "name", "Name", "ID", "1", "25", "_", ".", " ", "  ", "x", "ß", "あ", "é", "-", "é.5", "1.5", "_.", "._"}
+
+func numOrSpace(r rune) bool { return ('0' <= r && r <= '9') || r == ' ' }
+
+// title is the model of tw.Title: underscores become spaces, dots too unless between digits or
+// spaces; the result is trimmed, a non-empty input trimmed to nothing is one space, and the
+// whole is upper-cased.
+func title(name string) string {
+	rs := []rune(name)
+	for i, r := range rs {
+		switch r {
+		case '_':
+			rs[i] = ' '
+		case '.':
+			if (i > 0 && !numOrSpace(rs[i-1])) || (i < len(rs)-1 && !numOrSpace(rs[i+1])) {
+				rs[i] = ' '
+			}
+		}
+	}
+	out := strings.TrimSpace(string(rs))
+	if out == "" && name != "" {
+		out = " "
+	}
+	return strings.ToUpper(out)
+}
+
+var camelPieces = []string{"a", "bc", "Def", "GHI", "j", "1", "23", "_", "__", " ", "\t", "-", "é", "É", "あ", "ǅ", "X"}
+
+func runeClass(r rune) int {
+	switch {
+	case unicode.IsLower(r):
+		return 1
+	case unicode.IsUpper(r):
+		return 2
+	case unicode.IsDigit(r):
+		return 3
+	}
+	return 4
+}
+
+// splitCamelCase is the model of tw.SplitCamelCase: runs of one class (lower, upper, digit,
+// other); an upper run followed by a lower run lends it its last rune; empty, blank and
+// underscore groups are dropped (only a lone underscore under Known.camelUnderscoreGroups).
+func splitCamelCase(src string) []string {
+	var groups [][]rune
+	last := 0
+	for _, r := range src {
+		c := runeClass(r)
+		if c == last && len(groups) > 0 {
+			groups[len(groups)-1] = append(groups[len(groups)-1], r)
+		} else {
+			groups = append(groups, []rune{r})
+		}
+		last = c
+	}
+	for i := 0; i < len(groups)-1; i++ {
+		if len(groups[i]) > 0 && unicode.IsUpper(groups[i][0]) && len(groups[i+1]) > 0 && unicode.IsLower(groups[i+1][0]) {
+			groups[i+1] = append([]rune{groups[i][len(groups[i])-1]}, groups[i+1]...)
+			groups[i] = groups[i][:len(groups[i])-1]
+		}
+	}
+	out := []string{}
+	for _, g := range groups {
+		s := string(g)
+		if len(g) == 0 || strings.TrimSpace(s) == "" {
+			continue
+		}
+		if Known.camelUnderscoreGroups {
+			if s == "_" {
+				continue
+			}
+		} else if strings.Trim(s, "_") == "" {
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+var numericPieces = []string{"0", "1", "25", "-", "+", ".", "e", "E", " ", "x", "inf", "NaN", "_", ",", "1_0", "0x1p-2", "Infinity"}
+
+func isNumeric(s string) bool {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return false
+	}
+	if _, err := strconv.Atoi(s); err == nil {
+		return true
+	}
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// breakPoint is the model of tw.BreakPoint: the number of leading runes whose display width
+// fits the limit, escape sequences taking no width (under Known.breakPointEscapes their runes
+// count as visible characters, as the package measures each rune alone).
+func breakPoint(s string, limit int, o widthOpts) int {
+	if limit <= 0 || s == "" {
+		return 0
+	}
+	cw, n := 0, 0
+	for _, t := range scan(s) {
+		if t.seq && !Known.breakPointEscapes {
+			n += len([]rune(t.s))
+			continue
+		}
+		for _, r := range t.s {
+			w := runeWidth(r, o)
+			if t.seq {
+				w = width(string(r), o)
+			}
+			if cw+w > limit {
+				if cw == 0 {
+					if w > limit {
+						return 1
+					}
+					return 0
+				}
+				return n
+			}
+			cw += w
+			n++
+		}
+	}
+	return n
+}
+
+func padCenter(s, pad string, w int, o widthOpts) string {
+	gap := w - width(s, o)
+	if gap <= 0 {
+		return s
+	}
+	left := (gap + 1) / 2
+	return strings.Repeat(pad, left) + s + strings.Repeat(pad, gap-left)
+}
+
+func padRight(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return s + strings.Repeat(pad, gap)
+	}
+	return s
+}
+
+func padLeft(s, pad string, w int, o widthOpts) string {
+	if gap := w - width(s, o); gap > 0 {
+		return strings.Repeat(pad, gap) + s
+	}
+	return s
+}
+
+func padAlign(s, pad string, w int, a tw.Align, o widthOpts) string {
+	if width(s, o) > w {
+		return truncate(s, w, "", o)
+	}
+	switch a {
+	case tw.AlignRight:
+		return padLeft(s, pad, w, o)
+	case tw.AlignCenter:
+		return padCenter(s, pad, w, o)
+	}
+	return padRight(s, pad, w, o)
+}
+
+func genPieces(tc hegel.TestCase, pool []string, max int) string {
+	n := drawInt(tc, 0, max)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteString(pick(tc, pool))
+	}
+	return b.String()
+}
+
+var aligns = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+func TestHegelFn(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		name := genPieces(ht, titlePieces, 6)
+		if got, want := tw.Title(name), title(name); got != want {
+			c.failClass(ht, "Title", "Title(%q) = %q, want %q", name, got, want)
+		}
+		src := genPieces(ht, camelPieces, 6)
+		if got, want := tw.SplitCamelCase(src), splitCamelCase(src); !sameStrings(got, want) {
+			c.failClass(ht, "SplitCamelCase", "SplitCamelCase(%q) = %q, want %q", src, got, want)
+		}
+		if strings.Contains(src, "__") {
+			c.count("double underscore")
+		}
+		num := genPieces(ht, numericPieces, 4)
+		if got, want := tw.IsNumeric(num), isNumeric(num); got != want {
+			c.failClass(ht, "IsNumeric", "IsNumeric(%q) = %v, want %v", num, got, want)
+		}
+		if isNumeric(num) {
+			c.count("numeric")
+		}
+
+		o := drawOpts(ht)
+		setOpts(o)
+		s := genStr(ht, strOpts{maxPieces: 5, noST: true})
+		limit := drawInt(ht, -1, 10)
+		if got, want := tw.BreakPoint(s, limit), breakPoint(s, limit, o); got != want {
+			c.failClass(ht, "BreakPoint", "BreakPoint(%q, %d) %+v = %d, want %d", s, limit, o, got, want)
+		}
+		if strings.Contains(s, esc) {
+			c.count("BreakPoint with sequences")
+		}
+		w := drawInt(ht, -1, 12)
+		pad := pick(ht, []string{" ", "*", "-", "あ", ""})
+		if got, want := tw.PadCenter(s, pad, w), padCenter(s, pad, w, o); got != want {
+			c.failClass(ht, "PadCenter", "PadCenter(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadRight(s, pad, w), padRight(s, pad, w, o); got != want {
+			c.failClass(ht, "PadRight", "PadRight(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		if got, want := tw.PadLeft(s, pad, w), padLeft(s, pad, w, o); got != want {
+			c.failClass(ht, "PadLeft", "PadLeft(%q, %q, %d) %+v = %q, want %q", s, pad, w, o, got, want)
+		}
+		a := pick(ht, aligns)
+		if got, want := tw.Pad(s, pad, w, a), padAlign(s, pad, w, a, o); got != want {
+			c.failClass(ht, "Pad", "Pad(%q, %q, %d, %q) %+v = %q, want %q", s, pad, w, a, o, got, want)
+		}
+		if pad == " " && width(s, o) <= w {
+			if got := tw.Pad(s, pad, w, a); width(got, o) != w {
+				c.failClass(ht, "Pad width", "Pad(%q, %q, %d, %q) %+v = %q has width %d", s, pad, w, a, o, got, width(got, o))
+			}
+		}
+		_ = twwidth.Width
+	})
+}
diff --git a/hegel/hegel_input_test.go b/hegel/hegel_input_test.go
new file mode 100644
index 0000000..f084b06
--- /dev/null
+++ b/hegel/hegel_input_test.go
@@ -0,0 +1,796 @@
+package hegel
+
+// Input conversion: Append and Bulk take []string, []any, typed slices, single values and
+// structs (with AutoHeader from the fields and their tags). Model of convertToString,
+// convertCellsToStrings and extractFieldsAndValuesFromStruct, checked through the Markdown
+// rendering of the resulting header and rows (the Markdown model of hegel_table_test.go).
+
+import (
+	"bytes"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- value types
+
+type fmtVal struct{ s string }
+
+func (f fmtVal) Format() string { return f.s }
+
+type strVal struct{ s string }
+
+func (v strVal) String() string { return v.s }
+
+// ptrStr is a Stringer on the pointer receiver: String() dereferences, so a nil *ptrStr panics.
+type ptrStr struct{ s string }
+
+func (v *ptrStr) String() string { return v.s }
+
+type errVal struct{ s string }
+
+func (e *errVal) Error() string { return e.s }
+
+// Inner1 and Inner2: named struct types to embed.
+type Inner1 struct {
+	X string
+	Y int
+}
+
+type Inner2 struct {
+	Z *string `json:"zed"`
+	W bool    `tw:"-"`
+}
+
+var (
+	tString   = reflect.TypeOf("")
+	tInt      = reflect.TypeOf(0)
+	tInt64    = reflect.TypeOf(int64(0))
+	tFloat64  = reflect.TypeOf(float64(0))
+	tBool     = reflect.TypeOf(false)
+	tPInt     = reflect.TypeOf((*int)(nil))
+	tPString  = reflect.TypeOf((*string)(nil))
+	tTime     = reflect.TypeOf(time.Time{})
+	tPTime    = reflect.TypeOf((*time.Time)(nil))
+	tNullStr  = reflect.TypeOf(sql.NullString{})
+	tNullI32  = reflect.TypeOf(sql.NullInt32{})
+	tNullI64  = reflect.TypeOf(sql.NullInt64{})
+	tBytes    = reflect.TypeOf([]byte(nil))
+	tError    = reflect.TypeOf((*error)(nil)).Elem()
+	tAny      = reflect.TypeOf((*any)(nil)).Elem()
+	tFmtVal   = reflect.TypeOf(fmtVal{})
+	tStrVal   = reflect.TypeOf(strVal{})
+	tPPtrStr  = reflect.TypeOf((*ptrStr)(nil))
+	tPErrVal  = reflect.TypeOf((*errVal)(nil))
+	tReader   = reflect.TypeOf((*io.Reader)(nil)).Elem()
+	tInner1   = reflect.TypeOf(Inner1{})
+	tPInner1  = reflect.TypeOf((*Inner1)(nil))
+	tPInner2  = reflect.TypeOf((*Inner2)(nil))
+	leafTypes = []reflect.Type{tString, tInt, tInt64, tFloat64, tBool, tPInt, tPString, tTime, tPTime, tNullStr, tNullI32, tNullI64, tBytes, tError, tAny, tFmtVal, tStrVal, tPPtrStr, tPErrVal, tReader, tInner1}
+)
+
+var leafStrings = []string{"", "a", "x|y", " sp ", "Tab\tT", "multi\nline", "あい", "ünï", "userName", "-3.5"}
+
+// leaf is a generated value with its expected cell text; bad marks a value on which the
+// package panics (a nil pointer whose String()/Error() dereferences), generated only when the
+// switch is off.
+type leaf struct {
+	v   any
+	s   string
+	bad bool
+}
+
+func ptrCell(p any, deref string) string {
+	if Known.pointerAddress {
+		return fmt.Sprintf("%v", p)
+	}
+	return deref
+}
+
+func genLeaf(tc hegel.TestCase, typ reflect.Type, depth int) leaf {
+	s := pick(tc, leafStrings)
+	n := drawInt(tc, -3, 1000)
+	switch typ {
+	case tString:
+		return leaf{v: s, s: s}
+	case tInt:
+		return leaf{v: n, s: strconv.Itoa(n)}
+	case tInt64:
+		return leaf{v: int64(n), s: strconv.Itoa(n)}
+	case tFloat64:
+		f := float64(n) / 4
+		return leaf{v: f, s: strconv.FormatFloat(f, 'f', -1, 64)}
+	case tBool:
+		b := n%2 == 0
+		return leaf{v: b, s: strconv.FormatBool(b)}
+	case tPInt:
+		if chance(tc, 30) {
+			return leaf{v: (*int)(nil), s: ptrCell((*int)(nil), "")}
+		}
+		p := &n
+		return leaf{v: p, s: ptrCell(p, strconv.Itoa(n))}
+	case tPString:
+		if chance(tc, 30) {
+			return leaf{v: (*string)(nil), s: ptrCell((*string)(nil), "")}
+		}
+		p := &s
+		return leaf{v: p, s: ptrCell(p, s)}
+	case tTime:
+		t := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC).Add(time.Duration(n) * time.Hour)
+		return leaf{v: t, s: t.String()}
+	case tPTime:
+		if chance(tc, 30) {
+			return leaf{v: (*time.Time)(nil), s: "", bad: true}
+		}
+		t := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC).Add(time.Duration(n) * time.Hour)
+		return leaf{v: &t, s: t.String()}
+	case tNullStr:
+		if chance(tc, 30) {
+			return leaf{v: sql.NullString{}, s: ""}
+		}
+		return leaf{v: sql.NullString{String: s, Valid: true}, s: s}
+	case tNullI32:
+		v := sql.NullInt32{Int32: int32(n), Valid: !chance(tc, 30)}
+		want := ""
+		if v.Valid {
+			want = strconv.Itoa(n)
+		}
+		if Known.nullTypesUnhandled {
+			want = fmt.Sprintf("%v", v)
+		}
+		return leaf{v: v, s: want}
+	case tNullI64:
+		v := sql.NullInt64{Int64: int64(n), Valid: !chance(tc, 30)}
+		want := ""
+		if v.Valid {
+			want = strconv.Itoa(n)
+		}
+		return leaf{v: v, s: want}
+	case tBytes:
+		if chance(tc, 20) {
+			return leaf{v: []byte(nil), s: ""}
+		}
+		return leaf{v: []byte(s), s: s}
+	case tError:
+		switch drawInt(tc, 0, 2) {
+		case 0:
+			return leaf{v: nil, s: ""}
+		case 1:
+			return leaf{v: (*errVal)(nil), s: "", bad: true}
+		}
+		return leaf{v: errors.New(s), s: s}
+	case tAny:
+		if depth > 0 || chance(tc, 20) {
+			return leaf{v: nil, s: ""}
+		}
+		return genLeaf(tc, pick(tc, leafTypes), depth+1)
+	case tFmtVal:
+		return leaf{v: fmtVal{s}, s: s}
+	case tStrVal:
+		return leaf{v: strVal{s}, s: s}
+	case tPPtrStr:
+		if chance(tc, 30) {
+			return leaf{v: (*ptrStr)(nil), s: "", bad: true}
+		}
+		return leaf{v: &ptrStr{s}, s: s}
+	case tPErrVal:
+		if chance(tc, 30) {
+			return leaf{v: (*errVal)(nil), s: "", bad: true}
+		}
+		return leaf{v: &errVal{s}, s: s}
+	case tReader:
+		size := pick(tc, []int{0, 5, 511, 512, 513, 600})
+		content := strings.Repeat("r", size)
+		want := content
+		if size > 512 || (Known.readerEllipsisAt512 && size == 512) {
+			want = content[:512] + tw.CharEllipsis
+		}
+		return leaf{v: strings.NewReader(content), s: want}
+	case tInner1:
+		v := Inner1{X: s, Y: n}
+		return leaf{v: v, s: fmt.Sprintf("%v", v)}
+	}
+	panic("genLeaf: type " + typ.String())
+}
+
+// --------------------------------------------------------------------------- structs
+
+var fieldNames = []string{"Name", "ID", "UserName", "Created", "Total", "Ok", "Data", "Note", "A_B"}
+
+var fieldTags = []string{
+	``, ``, ``, `tw:"-"`, `tw:"name=Pretty Name"`, `tw:"name= spaced ,align=left"`, `tw:" - "`,
+	`json:"jname"`, `json:"jname,omitempty"`, `json:"-"`, `db:"dname"`, `json:"j" db:"d"`, `db:"dname,omitempty"`,
+}
+
+const (
+	embedNone = iota
+	embedInner1
+	embedPInner1
+	embedPInner2
+)
+
+type fieldSpec struct {
+	name  string
+	typ   reflect.Type
+	tag   string
+	embed int
+	leaf  leaf   // the value (embedNone)
+	inner []leaf // the embedded struct's field values (X, Y) or (Z); nil: a nil pointer
+}
+
+type structSpec struct {
+	fields []fieldSpec
+	typ    reflect.Type
+	ptr    bool // appended as a pointer
+	nilPtr bool // a nil pointer
+}
+
+func genStructSpec(tc hegel.TestCase) structSpec {
+	var sp structSpec
+	used := map[string]bool{}
+	nf := drawInt(tc, 1, 4)
+	for i := 0; i < nf; i++ {
+		name := pick(tc, fieldNames)
+		if used[name] {
+			continue
+		}
+		used[name] = true
+		typ := pick(tc, leafTypes)
+		sp.fields = append(sp.fields, fieldSpec{name: name, typ: typ, tag: pick(tc, fieldTags), leaf: genLeaf(tc, typ, 0)})
+	}
+	if chance(tc, 30) {
+		f := fieldSpec{name: "Inner1", embed: embedInner1, typ: tInner1}
+		if chance(tc, 50) {
+			f.embed = embedPInner1
+			f.typ = tPInner1
+		}
+		if f.embed == embedInner1 || chance(tc, 60) {
+			f.inner = []leaf{genLeaf(tc, tString, 0), genLeaf(tc, tInt, 0)}
+		}
+		sp.fields = append(sp.fields, f)
+	}
+	if chance(tc, 30) {
+		f := fieldSpec{name: "Inner2", embed: embedPInner2, typ: tPInner2}
+		if chance(tc, 60) {
+			f.inner = []leaf{genLeaf(tc, tPString, 0)}
+		}
+		sp.fields = append(sp.fields, f)
+	}
+	// shuffle the embedded fields in: move each to a drawn position
+	for i := range sp.fields {
+		j := drawInt(tc, 0, i)
+		sp.fields[i], sp.fields[j] = sp.fields[j], sp.fields[i]
+	}
+	rf := make([]reflect.StructField, len(sp.fields))
+	for i, f := range sp.fields {
+		rf[i] = reflect.StructField{Name: f.name, Type: f.typ, Tag: reflect.StructTag(f.tag), Anonymous: f.embed != embedNone}
+	}
+	sp.typ = reflect.StructOf(rf)
+	sp.ptr = chance(tc, 40)
+	sp.nilPtr = sp.ptr && chance(tc, 15)
+	return sp
+}
+
+func setLeaf(fv reflect.Value, l leaf) {
+	if l.v == nil {
+		fv.Set(reflect.Zero(fv.Type()))
+		return
+	}
+	fv.Set(reflect.ValueOf(l.v))
+}
+
+// value builds the struct (or pointer) to append.
+func (sp structSpec) value() any {
+	if sp.nilPtr {
+		return reflect.Zero(reflect.PointerTo(sp.typ)).Interface()
+	}
+	v := reflect.New(sp.typ).Elem()
+	for i, f := range sp.fields {
+		fv := v.Field(i)
+		switch f.embed {
+		case embedNone:
+			setLeaf(fv, f.leaf)
+		case embedInner1:
+			fv.Set(reflect.ValueOf(Inner1{X: f.inner[0].v.(string), Y: f.inner[1].v.(int)}))
+		case embedPInner1:
+			if f.inner != nil {
+				fv.Set(reflect.ValueOf(&Inner1{X: f.inner[0].v.(string), Y: f.inner[1].v.(int)}))
+			}
+		case embedPInner2:
+			if f.inner != nil {
+				in := &Inner2{}
+				if f.inner[0].v != nil {
+					in.Z = f.inner[0].v.(*string)
+				}
+				fv.Set(reflect.ValueOf(in))
+			}
+		}
+	}
+	if sp.ptr {
+		return v.Addr().Interface()
+	}
+	return v.Interface()
+}
+
+// legacyName is the first non-empty json/db tag (the configured Tags): "-" skips the field.
+func legacyName(tag reflect.StructTag) (name string, skip bool) {
+	for _, key := range []string{"json", "db"} {
+		if v := tag.Get(key); v != "" {
+			return v, v == "-"
+		}
+	}
+	return "", false
+}
+
+// cells is the model of extractFieldsAndValuesFromStruct: headers, values, whether the
+// package panics on a value, and whether the struct yields anything (a nil pointer does not).
+// consumed: the values were already extracted once for AutoHeader, which read the io.Reader
+// fields (bug 32), so those cells hold what was left after the first 512 bytes.
+func (sp structSpec) cells(consumed bool) (headers, values []string, bad bool, ok bool) {
+	if sp.nilPtr {
+		return nil, nil, false, false
+	}
+	for _, f := range sp.fields {
+		switch f.embed {
+		case embedInner1:
+			headers = append(headers, "X", "Y")
+			values = append(values, f.inner[0].s, f.inner[1].s)
+			continue
+		case embedPInner1:
+			if f.inner == nil {
+				if !Known.embeddedNilDrops {
+					headers = append(headers, "X", "Y")
+					values = append(values, "", "")
+				}
+				continue
+			}
+			headers = append(headers, "X", "Y")
+			values = append(values, f.inner[0].s, f.inner[1].s)
+			continue
+		case embedPInner2:
+			if f.inner == nil {
+				if !Known.embeddedNilDrops {
+					headers = append(headers, "ZED")
+					values = append(values, "")
+				}
+				continue
+			}
+			headers = append(headers, "ZED") // json:"zed", titled; W is skipped by its tw tag
+			values = append(values, f.inner[0].s)
+			continue
+		}
+		tag := reflect.StructTag(f.tag)
+		legacy, skip := legacyName(tag)
+		if skip {
+			continue
+		}
+		name := f.name
+		if legacy != "" {
+			name = strings.Split(legacy, ",")[0]
+		}
+		name = title(name)
+		if twTag := tag.Get("tw"); twTag != "" {
+			if strings.TrimSpace(twTag) == "-" {
+				continue
+			}
+			parts := strings.Split(twTag, ",")
+			skipped := false
+			for _, p := range parts {
+				if strings.TrimSpace(strings.SplitN(p, "=", 2)[0]) == "-" {
+					skipped = true
+				}
+			}
+			if skipped {
+				continue
+			}
+			for _, p := range parts {
+				kv := strings.SplitN(p, "=", 2)
+				if len(kv) == 2 && strings.TrimSpace(kv[0]) == "name" {
+					name = kv[1]
+				}
+			}
+		}
+		headers = append(headers, name)
+		// IsZero of an interface field looks at the interface, so a typed nil inside it is not zero
+		zero := f.leaf.v == nil
+		if !zero && f.typ.Kind() != reflect.Interface {
+			zero = reflect.ValueOf(f.leaf.v).IsZero()
+		}
+		if strings.Contains(legacy, ",omitempty") && zero {
+			values = append(values, "")
+			continue
+		}
+		cell := f.leaf.s
+		if r, isReader := f.leaf.v.(*strings.Reader); isReader && consumed && Known.autoHeaderConsumesReaders {
+			cell = ""
+			if n := int(r.Size()); n > 512 {
+				cell = strings.Repeat("r", n-512)
+			}
+		}
+		values = append(values, cell)
+		bad = bad || f.leaf.bad
+	}
+	return headers, values, bad, true
+}
+
+// --------------------------------------------------------------------------- rows
+
+const (
+	rowStrings  = iota // []string
+	rowAnys            // []any of leaves
+	rowVariadic        // Append(a, b, ...) of leaves
+	rowTyped           // a typed slice
+	rowSingle          // a single leaf
+	rowStruct          // a struct or pointer
+)
+
+var typedKinds = []string{"int", "int64", "float64", "bool", "int32", "bytes", "uint16"}
+
+type rowInput struct {
+	kind   int
+	args   []any // the Append arguments
+	cells  []string
+	bad    bool
+	sp     structSpec
+	desc   string
+	bulkOK bool // usable as a Bulk element
+}
+
+func genRow(tc hegel.TestCase) rowInput {
+	var r rowInput
+	r.kind = drawInt(tc, rowStrings, rowStruct)
+	n := drawInt(tc, 0, 4)
+	switch r.kind {
+	case rowStrings:
+		cells := make([]string, n)
+		for i := range cells {
+			cells[i] = pick(tc, leafStrings)
+		}
+		r.args = []any{cells}
+		r.cells = cells
+		r.desc = fmt.Sprintf("[]string%q", cells)
+		r.bulkOK = true
+	case rowAnys, rowVariadic:
+		if r.kind == rowVariadic && n < 2 {
+			n = 2
+		}
+		vals := make([]any, n)
+		cells := make([]string, n)
+		for i := range vals {
+			l := genLeaf(tc, pick(tc, leafTypes), 0)
+			vals[i], cells[i] = l.v, l.s
+			r.bad = r.bad || l.bad
+		}
+		r.cells = cells
+		if r.kind == rowAnys {
+			r.args = []any{vals}
+			r.bulkOK = true
+		} else {
+			r.args = vals
+		}
+		r.desc = fmt.Sprintf("[]any(%d)%q", n, cells)
+	case rowTyped:
+		kind := pick(tc, typedKinds)
+		cells := make([]string, n)
+		var v any
+		switch kind {
+		case "int":
+			xs := make([]int, n)
+			for i := range xs {
+				xs[i] = drawInt(tc, -5, 999)
+				cells[i] = strconv.Itoa(xs[i])
+			}
+			v = xs
+		case "int64":
+			xs := make([]int64, n)
+			for i := range xs {
+				xs[i] = int64(drawInt(tc, -5, 999))
+				cells[i] = strconv.FormatInt(xs[i], 10)
+			}
+			v = xs
+		case "float64":
+			xs := make([]float64, n)
+			for i := range xs {
+				xs[i] = float64(drawInt(tc, -5, 999)) / 8
+				cells[i] = strconv.FormatFloat(xs[i], 'f', -1, 64)
+			}
+			v = xs
+		case "bool":
+			xs := make([]bool, n)
+			for i := range xs {
+				xs[i] = chance(tc, 50)
+				cells[i] = strconv.FormatBool(xs[i])
+			}
+			v = xs
+		case "int32":
+			xs := make([]int32, n)
+			for i := range xs {
+				xs[i] = int32(drawInt(tc, 65, 122))
+				cells[i] = strconv.Itoa(int(xs[i]))
+			}
+			v = xs
+		case "uint16":
+			xs := make([]uint16, n)
+			for i := range xs {
+				xs[i] = uint16(drawInt(tc, 0, 999))
+				cells[i] = strconv.Itoa(int(xs[i]))
+			}
+			v = xs
+		case "bytes":
+			s := pick(tc, leafStrings)
+			b := []byte(s)
+			v = b
+			if Known.byteSliceRowNumbers {
+				cells = make([]string, len(b))
+				for i, x := range b {
+					cells[i] = strconv.Itoa(int(x))
+				}
+			} else {
+				cells = []string{s}
+			}
+		}
+		r.args = []any{v}
+		r.cells = cells
+		r.desc = fmt.Sprintf("[]%s%q", kind, cells)
+		r.bulkOK = true
+	case rowSingle:
+		typ := pick(tc, leafTypes)
+		l := genLeaf(tc, typ, 0)
+		r.args = []any{l.v}
+		r.bad = l.bad
+		r.cells = singleCells(l)
+		r.desc = fmt.Sprintf("single %T %q", l.v, r.cells)
+		r.bulkOK = true
+	case rowStruct:
+		r.sp = genStructSpec(tc)
+		v := r.sp.value()
+		r.args = []any{v}
+		_, values, bad, ok := r.sp.cells(false)
+		if !ok {
+			r.cells = []string{"<nil>"}
+		} else {
+			r.cells = values
+		}
+		r.bad = bad
+		r.desc = fmt.Sprintf("struct %v ptr=%v nil=%v %q", r.sp.typ, r.sp.ptr, r.sp.nilPtr, r.cells)
+		r.bulkOK = true
+	}
+	return r
+}
+
+// singleCells is the model of Append(v) for one value: a []byte is the []uint8 row; a
+// Formatter or Stringer is one cell; a struct, or a pointer to one, is the row of its exported
+// fields (so sql.NullString alone is two cells, and a value without exported fields - an error,
+// a reader - an empty row, bug 31); anything else is one cell of convertToString.
+func singleCells(l leaf) []string {
+	if b, ok := l.v.([]byte); ok {
+		if Known.byteSliceRowNumbers {
+			cells := make([]string, len(b))
+			for i, x := range b {
+				cells[i] = strconv.Itoa(int(x))
+			}
+			return cells
+		}
+		return []string{string(b)}
+	}
+	if l.v == nil {
+		return []string{""}
+	}
+	if _, ok := l.v.(tw.Formatter); ok {
+		return []string{l.s}
+	}
+	if _, ok := l.v.(fmt.Stringer); ok {
+		return []string{l.s}
+	}
+	rv := reflect.ValueOf(l.v)
+	if rv.Kind() == reflect.Pointer && !rv.IsNil() {
+		rv = rv.Elem()
+	}
+	if rv.Kind() == reflect.Struct {
+		var cells []string
+		for i := 0; i < rv.NumField(); i++ {
+			f := rv.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			cells = append(cells, cellOfBasic(rv.Field(i).Interface()))
+		}
+		if len(cells) == 0 && !Known.singleStructEmptyRow {
+			return []string{l.s}
+		}
+		if cells == nil {
+			return []string{}
+		}
+		return cells
+	}
+	return []string{l.s}
+}
+
+// cellOfBasic is convertToString on the exported field values met here (strings, ints, bools,
+// times).
+func cellOfBasic(v any) string {
+	switch x := v.(type) {
+	case string:
+		return x
+	case int:
+		return strconv.Itoa(x)
+	case int32:
+		return strconv.Itoa(int(x))
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case bool:
+		return strconv.FormatBool(x)
+	case fmt.Stringer:
+		return x.String()
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// autoHeader is the header AutoHeader would extract from this row, nil if none: the titled
+// exported field names of a struct (a single value that is a struct too, whatever
+// convertCellsToStrings makes of its cells).
+func (r rowInput) autoHeader() []string {
+	switch r.kind {
+	case rowStruct:
+		headers, _, _, ok := r.sp.cells(false)
+		if !ok || len(headers) == 0 {
+			return nil
+		}
+		return headers
+	case rowSingle:
+		rv := reflect.ValueOf(r.args[0])
+		if rv.Kind() == reflect.Pointer && !rv.IsNil() {
+			rv = rv.Elem()
+		}
+		if rv.Kind() != reflect.Struct {
+			return nil
+		}
+		var headers []string
+		for i := 0; i < rv.NumField(); i++ {
+			if f := rv.Type().Field(i); f.PkgPath == "" {
+				headers = append(headers, title(f.Name))
+			}
+		}
+		return headers
+	}
+	return nil
+}
+
+// consumedCells are the row's cells after AutoHeader extracted the header from it.
+func (r rowInput) consumedCells() []string {
+	if r.kind != rowStruct {
+		return r.cells
+	}
+	_, values, _, ok := r.sp.cells(true)
+	if !ok {
+		return r.cells
+	}
+	return values
+}
+
+type inputOp struct {
+	bulk bool
+	rows []rowInput // one for Append, the elements for Bulk
+}
+
+func TestHegelInput(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		autoHeader := chance(ht, 50)
+		var header []string
+		if chance(ht, 30) {
+			header = make([]string, drawInt(ht, 1, 3))
+			for i := range header {
+				header[i] = pick(ht, leafStrings)
+			}
+		}
+		var ops []inputOp
+		nops := drawInt(ht, 0, 3)
+		for i := 0; i < nops; i++ {
+			op := inputOp{bulk: chance(ht, 30)}
+			if op.bulk {
+				n := drawInt(ht, 0, 3)
+				for j := 0; j < n; j++ {
+					r := genRow(ht)
+					if !r.bulkOK {
+						r = genRow(ht)
+					}
+					if r.bulkOK {
+						op.rows = append(op.rows, r)
+					}
+				}
+			} else {
+				op.rows = []rowInput{genRow(ht)}
+			}
+			ops = append(ops, op)
+		}
+		// the model: header and rows
+		spec := tableSpec{trimSpace: true, trimTab: true, autoFormat: [3]bool{true, false, false}}
+		spec.align[secHeader] = tw.CellAlignment{Global: tw.AlignCenter}
+		spec.align[secRow] = tw.CellAlignment{Global: tw.AlignLeft}
+		spec.align[secFooter] = tw.CellAlignment{Global: tw.AlignRight}
+		spec.header = header
+		bad := false
+		var desc []string
+		for _, op := range ops {
+			if op.bulk {
+				if autoHeader && spec.header == nil && len(op.rows) > 0 {
+					spec.header = op.rows[0].autoHeader()
+					op.rows[0].cells = op.rows[0].consumedCells()
+				}
+				desc = append(desc, "Bulk[")
+			}
+			for _, r := range op.rows {
+				if !op.bulk && autoHeader && spec.header == nil && len(spec.rows) == 0 {
+					spec.header = r.autoHeader()
+					r.cells = r.consumedCells()
+				}
+				spec.rows = append(spec.rows, r.cells)
+				bad = bad || r.bad
+				desc = append(desc, r.desc)
+			}
+			if op.bulk {
+				desc = append(desc, "]")
+			}
+		}
+		if bad {
+			c.count("nil stringer") // bug 26: generated values the package panics on, when the switch is on
+			if Known.nilStringerPanic {
+				return
+			}
+		}
+		if autoHeader {
+			c.count("autoHeader")
+		}
+		if spec.header != nil {
+			c.count("header")
+		}
+		c.count("ops " + itoa(len(ops)))
+
+		var buf bytes.Buffer
+		tb := tablewriter.NewTable(&buf, spec.options(renderer.NewMarkdown())...)
+		if autoHeader {
+			tb.Configure(func(cfg *tablewriter.Config) { cfg.Behavior.Structs.AutoHeader = tw.On })
+		}
+		if header != nil {
+			tb.Header(header)
+		}
+		for _, op := range ops {
+			if op.bulk {
+				elems := make([]any, len(op.rows))
+				for i, r := range op.rows {
+					elems[i] = r.args[0]
+				}
+				if err := tb.Bulk(elems); err != nil {
+					c.failClass(ht, "error", "Bulk: %v for %s", err, strings.Join(desc, " "))
+					return
+				}
+				continue
+			}
+			if err := tb.Append(op.rows[0].args...); err != nil {
+				c.failClass(ht, "error", "Append: %v for %s", err, strings.Join(desc, " "))
+				return
+			}
+		}
+		if err := tb.Render(); err != nil {
+			c.failClass(ht, "error", "Render: %v for %s", err, strings.Join(desc, " "))
+			return
+		}
+		want := spec.markdown()
+		if got := buf.String(); got != want {
+			c.failClass(ht, "input", "Markdown of autoHeader=%v header=%q %s:\n got:\n%s want:\n%s", autoHeader, header, strings.Join(desc, " "), got, want)
+		}
+	})
+}
diff --git a/hegel/hegel_merge_test.go b/hegel/hegel_merge_test.go
new file mode 100644
index 0000000..9fc8d18
--- /dev/null
+++ b/hegel/hegel_merge_test.go
@@ -0,0 +1,506 @@
+package hegel
+
+// Cell merging against an exact model: horizontal merges of equal neighbouring cells in a
+// header, a row or a footer (and the footer's lead merge of leading empty cells up to the first
+// content), vertical merges of equal cells down a column, and hierarchical merges (a cell merges
+// down only while the cell to its left did), then the boxed rendering with the merged cells
+// spanning their columns and the separator lines passing through vertical merges.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+// mstate is tw.MergeStateOption.
+type mstate struct {
+	present, start, end bool
+	span                int
+}
+
+// cellMerge is tw.MergeState: the horizontal, vertical and hierarchical state of a cell.
+type cellMerge struct{ h, v, hier mstate }
+
+func getMerge(states []cellMerge, i int) cellMerge {
+	if i < 0 || i >= len(states) {
+		return cellMerge{}
+	}
+	return states[i]
+}
+
+// vpass reports whether a separator line passes through the cell (a vertical or hierarchical
+// merge continues from the cell above to the cell below).
+func vpass(above, below cellMerge) bool {
+	return (above.v.present && below.v.present && !above.v.end && !below.v.start) ||
+		(above.hier.present && below.hier.present && !above.hier.end && !below.hier.start)
+}
+
+// joinedCell is a logical cell's content over its visual lines, trimmed as the table trims.
+func (s tableSpec) joinedCell(lines [][]string, col int) string {
+	var b strings.Builder
+	for _, l := range lines {
+		if col < len(l) {
+			b.WriteString(l[col])
+		}
+	}
+	return s.trim(b.String())
+}
+
+// hmerge is the model of prepareWithMerges for a section's prepared lines: the lines padded to
+// the section's own column count, and with the horizontal bit set, a footer's leading empty
+// cells merged up to its first content (which moves to the first column), then runs of equal
+// non-empty logical cells (not "-") merged into their first column, the others blanked.
+func (s tableSpec) hmerge(lines [][]string, numCols, mode int, footer bool) ([][]string, []cellMerge) {
+	states := make([]cellMerge, numCols)
+	if len(lines) == 0 || mode&tw.MergeHorizontal == 0 {
+		return lines, states
+	}
+	n := len(lines[0])
+	if n == 0 {
+		for _, l := range lines {
+			n = max(n, len(l))
+		}
+		if n == 0 {
+			n = numCols
+		}
+	}
+	if n == 0 {
+		return lines, states
+	}
+	result := make([][]string, len(lines))
+	for i := range lines {
+		result[i] = padLine(lines[i], n)
+	}
+	inMerge := make([]bool, n)
+	if footer {
+		orig := padLine(lines[0], n)
+		first := -1
+		var firstContent string
+		for c := 0; c < n; c++ {
+			tv := s.trim(orig[c])
+			if tv != "" && tv != "-" {
+				first = c
+				firstContent = orig[c]
+				break
+			} else if tv == "-" {
+				break
+			}
+		}
+		if first > 0 {
+			span := first + 1
+			result[0][0] = firstContent
+			for k := 1; k < span; k++ {
+				result[0][k] = ""
+			}
+			for vl := 1; vl < len(result); vl++ {
+				for k := 0; k < span; k++ {
+					result[vl][k] = ""
+				}
+				if !Known.footerLeadDropsLines {
+					result[vl][0] = padLine(lines[vl], n)[first] // the whole logical cell moves
+				}
+			}
+			states[0].h = mstate{true, true, span == 1, span}
+			inMerge[0] = true
+			for k := 1; k < span; k++ {
+				states[k].h = mstate{true, false, k == span-1, span}
+				inMerge[k] = true
+			}
+		}
+	}
+	for col := 0; col < n; {
+		if inMerge[col] {
+			col++
+			continue
+		}
+		cur := s.joinedCell(lines, col)
+		if cur == "" || cur == "-" {
+			col++
+			continue
+		}
+		span := 1
+		for next := col + 1; next < n; next++ {
+			if inMerge[next] || s.joinedCell(lines, next) != cur {
+				break
+			}
+			span++
+		}
+		if span == 1 {
+			col++
+			continue
+		}
+		states[col].h = mstate{true, true, false, span}
+		inMerge[col] = true
+		for li := range result {
+			for k := col + 1; k < col+span; k++ {
+				result[li][k] = ""
+			}
+		}
+		for k := col + 1; k < col+span; k++ {
+			states[k].h = mstate{true, false, k == col+span-1, span}
+			inMerge[k] = true
+		}
+		col += span
+	}
+	return result, states
+}
+
+// vmerge is the model of applyVerticalMerges over the records (after the horizontal pass): a
+// run of equal non-empty logical cells down a column becomes one merge, the continuing cells
+// blanked; a record without lines is skipped but does not end a run.
+func (s tableSpec) vmerge(recs [][][]string, recM [][]cellMerge, numCols int, cols map[int]bool) {
+	startRow := map[int]int{}
+	startContent := map[int]string{}
+	for i := range recs {
+		if len(recs[i]) == 0 {
+			continue
+		}
+		for col := 0; col < numCols; col++ {
+			if cols != nil && !cols[col] {
+				continue
+			}
+			cur := s.joinedCell(recs[i], col)
+			sr, ongoing := startRow[col]
+			st := recM[i][col]
+			if ongoing && cur == startContent[col] && cur != "" {
+				st.v = mstate{true, false, false, 0}
+				recM[i][col] = st
+				for li := range recs[i] {
+					if col < len(recs[i][li]) {
+						recs[i][li][col] = ""
+					}
+				}
+				continue
+			}
+			if ongoing {
+				ended := i - 1
+				if ended >= 0 && ended >= sr {
+					ss := recM[sr][col]
+					ss.v.span = ended - sr + 1
+					ss.v.end = ss.v.span == 1
+					recM[sr][col] = ss
+					es := recM[ended][col]
+					es.v.end = true
+					es.v.span = ss.v.span
+					recM[ended][col] = es
+				}
+				delete(startRow, col)
+				delete(startContent, col)
+			}
+			if cur != "" {
+				st.v = mstate{true, true, false, 1}
+				recM[i][col] = st
+				startRow[col] = i
+				startContent[col] = cur
+			} else if !st.h.present {
+				st.v = mstate{}
+				recM[i][col] = st
+			}
+		}
+	}
+	last := len(recs) - 1
+	if last < 0 {
+		return
+	}
+	for col, sr := range startRow {
+		ss := recM[sr][col]
+		span := last - sr + 1
+		ss.v.span = span
+		ss.v.end = span == 1
+		recM[sr][col] = ss
+		es := recM[last][col]
+		es.v.present = true
+		es.v.end = true
+		es.v.span = span
+		if sr != last {
+			es.v.start = false
+		}
+		recM[last][col] = es
+	}
+}
+
+// hiermerge is the model of applyHierarchicalMerges: from the second record on, a cell equal
+// to the one above (non-empty, not "-") continues a merge when it is the first column or the
+// cell to its left continued one; compared on a snapshot taken before the pass.
+func (s tableSpec) hiermerge(recs [][][]string, recM [][]cellMerge, numCols int, cols map[int]bool) {
+	if len(recs) <= 1 {
+		return
+	}
+	orig := make([][][]string, len(recs))
+	for i, rec := range recs {
+		orig[i] = make([][]string, len(rec))
+		for j, l := range rec {
+			orig[i][j] = append([]string(nil), l...)
+		}
+	}
+	hStart := map[int]int{}
+	finalize := func(c, sr, er int) {
+		if er < sr || sr < 0 || er < 0 || er >= len(recM) {
+			return
+		}
+		span := er - sr + 1
+		ss := recM[sr][c]
+		ss.hier.present, ss.hier.start, ss.hier.span, ss.hier.end = true, true, span, span == 1
+		recM[sr][c] = ss
+		if er > sr {
+			es := recM[er][c]
+			es.hier.present, es.hier.start, es.hier.end, es.hier.span = true, false, true, span
+			recM[er][c] = es
+		}
+	}
+	for r := 1; r < len(recs); r++ {
+		leftCont := false
+		for c := 0; c < numCols; c++ {
+			if cols != nil && !cols[c] {
+				leftCont = false
+				continue
+			}
+			if len(orig[r]) == 0 || len(orig[r-1]) == 0 {
+				st := recM[r][c]
+				st.hier = mstate{}
+				recM[r][c] = st
+				leftCont = false
+				continue
+			}
+			cur := s.joinedCell(orig[r], c)
+			above := s.joinedCell(orig[r-1], c)
+			st := recM[r][c]
+			prevAbove := recM[r-1][c]
+			match := cur == above && cur != "" && cur != "-"
+			if match && (c == 0 || leftCont) {
+				st.hier.present = true
+				st.hier.start = false
+				if prevAbove.hier.present && !prevAbove.hier.end {
+					if _, ok := hStart[c]; !ok {
+						hStart[c] = r - 1
+						ss := recM[r-1][c]
+						ss.hier.present, ss.hier.start, ss.hier.end = true, true, false
+						recM[r-1][c] = ss
+					}
+				} else {
+					hStart[c] = r - 1
+					ss := recM[r-1][c]
+					ss.hier.present, ss.hier.start, ss.hier.end = true, true, false
+					recM[r-1][c] = ss
+				}
+				for li := range recs[r] {
+					if c < len(recs[r][li]) {
+						recs[r][li][c] = ""
+					}
+				}
+				leftCont = true
+			} else {
+				st.hier = mstate{}
+				if sr, ok := hStart[c]; ok {
+					finalize(c, sr, r-1)
+					delete(hStart, c)
+				}
+				leftCont = false
+			}
+			recM[r][c] = st
+		}
+	}
+	for c, sr := range hStart {
+		finalize(c, sr, len(recs)-1)
+	}
+}
+
+// applyMerges runs the merge passes over the prepared model in the table's order: horizontal
+// merges of the header and of every record, the rows' vertical then hierarchical merges, the
+// footer's horizontal merges.
+func (s tableSpec) applyMerges(m *tableModel) {
+	m.hdrM = make([]cellMerge, m.numCols)
+	if m.header != nil {
+		m.header, m.hdrM = s.hmerge(m.header, m.numCols, s.merge[secHeader], false)
+	}
+	m.recM = make([][]cellMerge, len(m.records))
+	for i, rec := range m.records {
+		m.records[i], m.recM[i] = s.hmerge(rec, m.numCols, s.merge[secRow], false)
+	}
+	var cols map[int]bool
+	if s.mergeCols != nil {
+		cols = map[int]bool{}
+		for _, c := range s.mergeCols {
+			cols[c] = true
+		}
+	}
+	if s.merge[secRow]&tw.MergeVertical != 0 {
+		s.vmerge(m.records, m.recM, m.numCols, cols)
+	}
+	if s.merge[secRow]&tw.MergeHierarchical != 0 {
+		s.hiermerge(m.records, m.recM, m.numCols, cols)
+	}
+	m.rows = nil
+	for _, rec := range m.records {
+		if len(rec) > 0 {
+			m.rows = append(m.rows, rec)
+		}
+	}
+	m.ftrM = make([]cellMerge, m.numCols)
+	if m.footer != nil {
+		m.footer, m.ftrM = s.hmerge(m.footer, m.numCols, s.merge[secFooter], true)
+	}
+}
+
+// mergedWidths is the model of applyHorizontalMerges for a header or footer: a merge's first
+// column takes the width of the whole span (separators included), the others 0.
+func (m tableModel) mergedWidths(states []cellMerge, l layout) []int {
+	out := append([]int(nil), m.widths...)
+	sepW := 0
+	if l.betweenCols {
+		sepW = w0(l.sym.Column())
+	}
+	for c := 0; c < m.numCols; c++ {
+		st := getMerge(states, c)
+		if !st.h.present || !st.h.start {
+			continue
+		}
+		total := 0
+		for i := 0; i < st.h.span && c+i < m.numCols; i++ {
+			if Known.mergedHeaderHiddenWidth {
+				// the natural widths, hidden columns and their separators included (bug 34)
+				total += m.natural[c+i]
+				if i > 0 {
+					total += sepW
+				}
+				continue
+			}
+			total += m.widths[c+i]
+			if i > 0 && m.widths[c+i] > 0 {
+				total += sepW
+			}
+		}
+		out[c] = total
+		for i := 1; i < st.h.span && c+i < m.numCols; i++ {
+			out[c+i] = 0
+		}
+		if m.hidden[c] {
+			out[c] = 0 // AutoHide zeroes the widths after the merge widths are set
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- property
+
+var mergeCells = []string{"a", "a", "a", "b", "b", "Total", "", "-", "x\ny", " a ", "A", "long cell", "c", "Total"}
+
+var headerMergeModes = []int{0, 0, tw.MergeHorizontal, tw.MergeBoth, tw.MergeHierarchical, tw.MergeVertical}
+var rowMergeModes = []int{0, tw.MergeVertical, tw.MergeHorizontal, tw.MergeBoth, tw.MergeHierarchical, 5, 6, 7}
+
+// genMergeSpec: small tables from a pool of few distinct cells, so that equal neighbours are
+// common, under every merge mode of every section.
+func genMergeSpec(tc hegel.TestCase) tableSpec {
+	s := tableSpec{trimSpace: true, trimTab: true, autoFormat: [3]bool{true, false, false}}
+	cols := drawInt(tc, 1, 4)
+	cells := func(n int) []string {
+		out := make([]string, n)
+		for i := range out {
+			out[i] = pick(tc, mergeCells)
+		}
+		return out
+	}
+	if chance(tc, 80) {
+		s.header = cells(drawInt(tc, 1, cols+1))
+	}
+	nrows := drawInt(tc, 1, 5)
+	for i := 0; i < nrows; i++ {
+		s.rows = append(s.rows, cells(drawInt(tc, 1, cols+1)))
+	}
+	if chance(tc, 50) {
+		s.footer = cells(drawInt(tc, 1, cols+1))
+		if chance(tc, 40) {
+			s.footer[0] = "" // the shape of a lead merge: empty cells before the first content
+		}
+	}
+	if chance(tc, 20) {
+		s.trimSpace = false
+	}
+	if chance(tc, 20) {
+		s.trimTab = false
+	}
+	for i := range s.autoFormat {
+		if chance(tc, 20) {
+			s.autoFormat[i] = !s.autoFormat[i]
+		}
+	}
+	s.align[secHeader] = genAlignment(tc, tw.AlignCenter)
+	s.align[secRow] = genAlignment(tc, tw.AlignLeft)
+	s.align[secFooter] = genAlignment(tc, tw.AlignRight)
+	s.padding = pick(tc, paddingChoices)
+	s.autoHide = chance(tc, 20)
+	s.merge[secHeader] = pick(tc, headerMergeModes)
+	s.merge[secRow] = pick(tc, rowMergeModes)
+	s.merge[secFooter] = pick(tc, headerMergeModes)
+	if chance(tc, 30) {
+		n := drawInt(tc, 1, 3)
+		seen := map[int]bool{}
+		for i := 0; i < n; i++ {
+			c := drawInt(tc, 0, cols)
+			if !seen[c] {
+				seen[c] = true
+				s.mergeCols = append(s.mergeCols, c)
+			}
+		}
+	}
+	return s
+}
+
+// classifyMerges counts the merges the model found.
+func (m tableModel) classifyMerges(c *collector) {
+	count := func(states []cellMerge, what string) {
+		for _, st := range states {
+			if st.h.start {
+				c.count(what + " horizontal")
+			}
+			if st.v.start && st.v.span > 1 {
+				c.count(what + " vertical")
+			}
+			if st.hier.start && st.hier.span > 1 {
+				c.count(what + " hierarchical")
+			}
+		}
+	}
+	count(m.hdrM, "header")
+	for _, st := range m.recM {
+		count(st, "row")
+	}
+	count(m.ftrM, "footer")
+	if len(m.ftrM) > 0 && m.ftrM[0].h.start && len(m.footer) > 0 && m.footer[0][0] != "" {
+		c.count("footer lead merge")
+	}
+}
+
+// TestHegelMerge: the boxed rendering of tables with merged cells equals the model's.
+func TestHegelMerge(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		s := genMergeSpec(ht)
+		r := genRendSpec(ht)
+		m := s.model()
+		if m.numCols == 0 {
+			c.count("degenerate")
+			return
+		}
+		if s.autoHide && len(m.visibleCols()) == 0 {
+			c.count("all hidden") // bug 16
+			return
+		}
+		s.classify(c)
+		m.classifyMerges(c)
+		c.count("row mode " + itoa(s.merge[secRow]))
+		got, err := s.render(renderer.NewBlueprint(r.rendition()))
+		if err != nil {
+			c.failClass(ht, "error", "Render: %v for %s %s", err, s, r)
+			return
+		}
+		want := s.blueprint(r)
+		if got != want {
+			c.failClass(ht, "merge", "Blueprint of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+		}
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..11171ac
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,251 @@
+package hegel
+
+// Models of pkg/twwidth: the escape-sequence scanner (ECMA-48: a CSI sequence is ESC [
+// parameters intermediates final; an OSC sequence is ESC ] ... BEL or ESC \), display widths
+// and Truncate.
+
+import (
+	"strings"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+)
+
+const (
+	esc   = "\x1b"
+	bel   = "\x07"
+	reset = "\x1b[0m"
+	tabW  = 4 // the tab width the tests fix (SetTabWidth after the first TabWidth, bug 1)
+)
+
+func init() {
+	twwidth.TabWidth()
+	twwidth.SetTabWidth(tabW)
+}
+
+type widthOpts struct {
+	ea     bool
+	narrow bool
+	tab    int // the tab width in force, tabW when 0
+}
+
+func setOpts(o widthOpts) {
+	twwidth.SetOptions(twwidth.Options{EastAsianWidth: o.ea, ForceNarrowBorders: o.narrow})
+}
+
+// tok is a piece of a string: an escape sequence or a run of visible text.
+type tok struct {
+	seq bool
+	s   string
+}
+
+// csiEnd returns the index after the CSI sequence starting at i (s[i:i+2] == ESC [), or -1.
+func csiEnd(s string, i int) int {
+	j := i + 2
+	for j < len(s) && s[j] >= 0x30 && s[j] <= 0x3f {
+		j++
+	}
+	for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+		j++
+	}
+	if j < len(s) && s[j] >= 0x40 && s[j] <= 0x7e {
+		return j + 1
+	}
+	return -1
+}
+
+// oscEnd returns the index after the OSC sequence starting at i (s[i:i+2] == ESC ]), or -1.
+func oscEnd(s string, i int) int {
+	for j := i + 2; j < len(s); j++ {
+		if s[j] == 0x07 {
+			return j + 1
+		}
+		if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+			return j + 2
+		}
+		if s[j] == '\n' { // the package's regexp does not cross a newline
+			return -1
+		}
+	}
+	return -1
+}
+
+// scan splits s into escape sequences and visible text by ECMA-48.
+func scan(s string) []tok {
+	var out []tok
+	var text strings.Builder
+	flush := func() {
+		if text.Len() > 0 {
+			out = append(out, tok{false, text.String()})
+			text.Reset()
+		}
+	}
+	for i := 0; i < len(s); {
+		if s[i] == 0x1b && i+1 < len(s) {
+			end := -1
+			switch s[i+1] {
+			case '[':
+				end = csiEnd(s, i)
+			case ']':
+				end = oscEnd(s, i)
+			}
+			if end > 0 {
+				flush()
+				out = append(out, tok{true, s[i:end]})
+				i = end
+				continue
+			}
+		}
+		text.WriteByte(s[i])
+		i++
+	}
+	flush()
+	return out
+}
+
+func stripSeq(s string) string {
+	var b strings.Builder
+	for _, t := range scan(s) {
+		if !t.seq {
+			b.WriteString(t.s)
+		}
+	}
+	return b.String()
+}
+
+func isBox(r rune) bool { return r >= 0x2500 && r <= 0x257f }
+
+func runeWidth(r rune, o widthOpts) int {
+	if o.narrow && isBox(r) {
+		return 1
+	}
+	if r == '\t' {
+		if o.tab > 0 {
+			return o.tab
+		}
+		return tabW
+	}
+	return displaywidth.Options{EastAsianWidth: o.ea}.Rune(r)
+}
+
+// width is the model of twwidth.Width: the sum of the rune widths of the visible text.
+func width(s string, o widthOpts) int {
+	w := 0
+	for _, r := range stripSeq(s) {
+		w += runeWidth(r, o)
+	}
+	return w
+}
+
+// truncTokens scans s as Truncate's loop does when Known.truncateEscRestart is on: an ESC
+// always starts a new sequence (so the ESC of an ST terminator restarts the scan and the rest
+// of the string is swallowed by a sequence that never terminates), a CSI ends at a final byte,
+// an OSC at BEL. Otherwise the ECMA-48 scan, with visible text split into runes. The last
+// element reports whether the scan ended inside a sequence (open).
+func truncTokens(s string, faithful bool) (toks []tok, open bool) {
+	if !faithful {
+		for _, t := range scan(s) {
+			if t.seq {
+				toks = append(toks, t)
+				continue
+			}
+			for _, r := range t.s {
+				toks = append(toks, tok{false, string(r)})
+			}
+		}
+		return toks, false
+	}
+	var buf []byte
+	in := false
+	for _, r := range s {
+		if r == 0x1b {
+			in = true
+			buf = append(buf[:0], 0x1b)
+			continue
+		}
+		if in {
+			buf = append(buf, []byte(string(r))...)
+			term := false
+			if len(buf) >= 2 {
+				switch buf[1] {
+				case '[':
+					term = len(buf) >= 3 && r >= 0x40 && r <= 0x7e
+				case ']':
+					term = r == 0x07
+				}
+			}
+			if term {
+				in = false
+				toks = append(toks, tok{true, string(buf)})
+			}
+			continue
+		}
+		toks = append(toks, tok{false, string(r)})
+	}
+	return toks, in
+}
+
+// truncate is the model of twwidth.Truncate.
+func truncate(s string, maxWidth int, suffix string, o widthOpts) string {
+	if maxWidth < 0 {
+		return ""
+	}
+	sw := width(s, o)
+	suffixW := width(suffix, o)
+	if sw == 0 {
+		if suffix != "" && (suffixW <= maxWidth || (maxWidth == 0 && !Known.truncateZeroSuffix)) {
+			return suffix
+		}
+		if maxWidth == 0 && len(s) > 0 {
+			return ""
+		}
+		return s
+	}
+	if maxWidth == 0 {
+		if suffix != "" && !Known.truncateZeroSuffix {
+			return suffix // documented: "If maxWidth is zero and a suffix is provided, the suffix is returned"
+		}
+		return ""
+	}
+	if sw <= maxWidth {
+		safe := s
+		if strings.Contains(s, esc) && !strings.HasSuffix(s, reset) {
+			safe += reset
+		}
+		if suffix == "" || sw+suffixW > maxWidth {
+			return safe
+		}
+		return safe + suffix
+	}
+	if suffix != "" && o.ea && maxWidth-suffixW == 0 {
+		return suffix
+	}
+	budget := maxWidth - suffixW
+	if budget < 0 {
+		return ""
+	}
+	toks, open := truncTokens(s, Known.truncateEscRestart)
+	var out strings.Builder
+	cw := 0
+	wrote := false
+	for _, t := range toks {
+		if t.seq {
+			out.WriteString(t.s)
+			wrote = true
+			continue
+		}
+		r := []rune(t.s)[0]
+		w := runeWidth(r, o)
+		if budget == 0 || cw+w > budget {
+			open = false
+			break
+		}
+		out.WriteString(t.s)
+		cw += w
+	}
+	res := out.String()
+	if (wrote || (open && strings.Contains(s, esc+"["))) && (cw > 0 || wrote) && !strings.HasSuffix(res, reset) {
+		res += reset
+	}
+	return res + suffix
+}
