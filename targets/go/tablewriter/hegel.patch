new file mode 100644
index 0000000..5b7bbf9
--- /dev/null
+++ b/hegel/hegel_stream_test.go
@@ -0,0 +1,537 @@
+package hegel
+
+// Streaming (Start/Header/Append/Footer/Close) against an exact model: the column count and
+// the fixed widths come from Widths.PerColumn, else from the first section seen (its trimmed
+// cells' widths plus two plus the padding, at least eight), shrunk to Widths.Global; every later
+// row is padded or cut to the column count (or refused under StrictColumns); the cells wrap to
+// the fixed width; the borders and separators are drawn as the sections arrive, the footer at
+// Close.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	orderHRF = iota // Header, rows, Footer
+	orderHFR        // Header, Footer, rows
+	orderFHR        // Footer, Header, rows
+)
+
+type streamSpec struct {
+	tableSpec
+	global int  // WithColumnMax (Widths.Global); 0: none
+	strict bool // StreamConfig.StrictColumns
+	order  int
+}
+
+var (
+	streamHeaderMerges = hegel.SampledFrom([]int{tw.MergeHorizontal, tw.MergeBoth})
+	streamRowMerges    = hegel.SampledFrom([]int{tw.MergeHorizontal, tw.MergeBoth, tw.MergeVertical, tw.MergeHierarchical})
+	streamOrders       = hegel.SampledFrom([]int{orderHRF, orderHRF, orderHFR, orderFHR})
+	// records with equal neighbours for the merges
+	mergedHeaders = hegel.Map(cellTexts, func(x string) []string { return []string{"a", "a", x} })
+	mergedRows    = hegel.Map(cellTexts, func(x string) []string { return []string{x, "b", "b"} })
+	mergedFooters = hegel.Map(cellTexts, func(x string) []string { return []string{"", "Total", x} })
+)
+
+// streamSpecs: boxedTables streamed: 30% of the time each section's wrap mode set half of the
+// time; 30% of the time each: per-column widths (columns 0 to 3), a Widths.Global of 1 to 40,
+// the header's and the footer's merge mode, a header, a first row and a footer of equal
+// neighbours; 40% the rows' merge mode; 20% each a row maximum width and a table maximum width
+// (both ignored in streaming) and StrictColumns; the order the sections are sent in. AutoHide is
+// off (ignored in streaming, Start warns); Header() and Footer() return at once when hidden by
+// the Control, as if never called.
+var streamSpecs = hegel.Composite(func(tc hegel.TestCase) streamSpec {
+	s := streamSpec{tableSpec: hegel.Draw(tc, boxedTables)}
+	s.autoHide = false
+	s.wrap = hegel.Draw(tc, maybe(30, perSection(50, wrapModes)))
+	s.colWidths = hegel.Draw(tc, maybe(30, colWidthMaps(3)))
+	s.global = hegel.Draw(tc, maybe(30, hegel.Integers(1, 40)))
+	s.secMax[secRow] = hegel.Draw(tc, maybe(20, hegel.Integers(1, 12)))
+	s.maxWidth = hegel.Draw(tc, maybe(20, hegel.Integers(1, 30)))
+	s.merge = [3]int{hegel.Draw(tc, maybe(30, streamHeaderMerges)), hegel.Draw(tc, maybe(40, streamRowMerges)), hegel.Draw(tc, maybe(30, streamHeaderMerges))}
+	if h := hegel.Draw(tc, maybe(30, mergedHeaders)); h != nil {
+		s.header = h
+	}
+	if r := hegel.Draw(tc, maybe(30, mergedRows)); r != nil && len(s.rows) > 0 {
+		s.rows[0] = r
+	}
+	if f := hegel.Draw(tc, maybe(30, mergedFooters)); f != nil && s.footer != nil {
+		s.footer = f
+	}
+	if s.hideHeader {
+		s.header = nil
+	}
+	if s.hideFooter {
+		s.footer = nil
+	}
+	s.strict = hegel.Draw(tc, chance(20))
+	s.order = hegel.Draw(tc, streamOrders)
+	return s
+})
+
+// streamCase: a streamed table and its rendition; under Known.scaleRemainderRandom the cases
+// whose Widths.Global shrink leaves a rounding remainder over several columns are left out
+// (bug 39: the package spreads it in map order).
+type streamCase struct {
+	s streamSpec
+	r rendSpec
+}
+
+func (k streamCase) GoString() string { return k.s.String() + " " + k.r.String() }
+
+// randomRemainder: the case's Widths.Global shrink leaves a remainder the package spreads in
+// map order (only under Known.scaleRemainderRandom).
+func (k streamCase) randomRemainder() bool {
+	_, _, random := k.s.streamWidths(k.r.layout())
+	return random
+}
+
+var streamCases = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) streamCase {
+	return streamCase{s: hegel.Draw(tc, streamSpecs), r: hegel.Draw(tc, rendSpecs)}
+}), func(k streamCase) bool { return !k.randomRemainder() })
+
+func (s streamSpec) String() string {
+	return s.tableSpec.String() + " global=" + itoa(s.global) + " strict=" + boolStr(s.strict) + " order=" + itoa(s.order)
+}
+
+func (s streamSpec) GoString() string { return s.String() }
+
+// streamOut renders the spec through the streaming API; the errors Append returns are noted.
+func (s streamSpec) streamOut(r tw.Renderer) (string, int, error) {
+	var buf bytes.Buffer
+	opts := s.options(r)
+	opts = append(opts, tablewriter.WithStreaming(tw.StreamConfig{Enable: true, StrictColumns: s.strict}))
+	if s.global > 0 {
+		opts = append(opts, tablewriter.WithColumnMax(s.global))
+	}
+	t := tablewriter.NewTable(&buf, opts...)
+	if err := t.Start(); err != nil {
+		return "", 0, err
+	}
+	refused := 0
+	rows := func() {
+		for _, row := range s.rows {
+			if err := t.Append(row); err != nil {
+				refused++
+			}
+		}
+	}
+	switch s.order {
+	case orderHRF:
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		rows()
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+	case orderHFR:
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+		rows()
+	default:
+		if s.footer != nil {
+			t.Footer(s.footer)
+		}
+		if s.header != nil {
+			t.Header(s.header)
+		}
+		rows()
+	}
+	err := t.Close()
+	return buf.String(), refused, err
+}
+
+// streamWidths is the model of Start and streamCalculateWidths: Widths.PerColumn (negatives
+// dropped by the option) fixes the count and the widths, missing columns 0; else the first
+// section with cells (in call order) is the sample: each trimmed cell's width (at least the
+// ellipsis's under WrapTruncate) plus two plus the padding, at least MinimumColumnWidth; then
+// Widths.Global shrinks the widths in proportion when the table (separators included) is
+// wider, the rounding remainder spread one by one over the columns, in map order (bug 39: when
+// Known.scaleRemainderRandom, the model gives up on a remainder).
+// It returns the widths, the count and whether the remainder was random.
+func (s streamSpec) streamWidths(l layout) ([]int, int, bool) {
+	widths, n, spread := s.scaledWidths(l)
+	return widths, n, spread && Known.scaleRemainderRandom
+}
+
+// scaledWidths is streamWidths' computation, reporting whether the Widths.Global shrink spread
+// a rounding remainder over several columns (which the package does in map order, bug 39)
+// whatever the switch says.
+func (s streamSpec) scaledWidths(l layout) ([]int, int, bool) {
+	if s.constrained() {
+		n := 0
+		for k, w := range s.colWidths {
+			if w >= 0 && k+1 > n {
+				n = k + 1
+			}
+		}
+		widths := make([]int, n)
+		for k, w := range s.colWidths {
+			if w >= 0 {
+				widths[k] = w
+			}
+		}
+		return widths, n, false
+	}
+	var sample []string
+	sec := -1
+	sections := [][2]int{}
+	switch s.order {
+	case orderHRF:
+		sections = append(sections, [2]int{secHeader, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+		sections = append(sections, [2]int{secFooter, 0})
+	case orderHFR:
+		sections = append(sections, [2]int{secHeader, 0}, [2]int{secFooter, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+	default:
+		sections = append(sections, [2]int{secFooter, 0}, [2]int{secHeader, 0})
+		for i := range s.rows {
+			sections = append(sections, [2]int{secRow, i})
+		}
+	}
+	for _, sc := range sections {
+		var cells []string
+		switch sc[0] {
+		case secHeader:
+			cells = s.header
+		case secRow:
+			cells = s.rows[sc[1]]
+		default:
+			cells = s.footer
+		}
+		if len(cells) > 0 {
+			sample, sec = cells, sc[0]
+			break
+		}
+	}
+	if sample == nil {
+		return nil, 0, false
+	}
+	n := len(sample)
+	pads := w0(s.pad().Left) + w0(s.pad().Right)
+	widths := make([]int, n)
+	for i, c := range sample {
+		cw := w0(s.trim(c))
+		if s.wrapMode(sec) == tw.WrapTruncate && cw < w0(tw.CharEllipsis) {
+			cw = w0(tw.CharEllipsis)
+		}
+		w := cw + 2 + pads
+		if w > 0 && w < tw.MinimumColumnWidth {
+			w = tw.MinimumColumnWidth
+		}
+		widths[i] = w
+	}
+	spread := false
+	if s.global > 0 {
+		sum := 0
+		for _, w := range widths {
+			sum += w
+		}
+		sepW := 0
+		if l.betweenCols {
+			sepW = w0(l.sym.Column())
+		}
+		total := sum
+		if n > 1 {
+			total += (n - 1) * sepW
+		}
+		if s.global < total && total > 0 {
+			target := s.global
+			if n > 1 {
+				target -= (n - 1) * sepW
+			}
+			if target < n {
+				target = n
+			}
+			scale := float64(target) / float64(sum)
+			adjusted := 0
+			var nonzero []int
+			for i, w := range widths {
+				if w == 0 {
+					continue
+				}
+				sw := int(math.Round(float64(w) * scale))
+				if sw < 1 {
+					sw = 1
+				}
+				widths[i] = sw
+				adjusted += sw
+				nonzero = append(nonzero, i)
+			}
+			remaining := target - adjusted
+			if remaining != 0 && len(nonzero) > 0 {
+				if len(nonzero) > 1 {
+					spread = true
+				}
+				// in ascending column order (the map order is random, bug 39)
+				for i := 0; i < int(math.Abs(float64(remaining))); i++ {
+					if remaining > 0 {
+						widths[nonzero[i%len(nonzero)]]++
+					} else {
+						reduced := false
+						for j := 0; j < len(nonzero); j++ {
+							c := nonzero[(i+j)%len(nonzero)]
+							if widths[c] > 1 {
+								widths[c]--
+								reduced = true
+								break
+							}
+						}
+						if !reduced {
+							break
+						}
+					}
+				}
+			}
+		}
+	}
+	return widths, n, spread
+}
+
+// fit pads or cuts a section's cells to the stream's column count.
+func fit(cells []string, n int) []string {
+	if len(cells) >= n {
+		return cells[:n]
+	}
+	return padLine(cells, n)
+}
+
+// streamModel is the model of the whole streamed rendering. It returns the output, the count
+// of rows Append refuses under StrictColumns, and whether the case is beyond the model.
+func (s streamSpec) streamModel(r rendSpec) (string, int, bool) {
+	l := r.layout()
+	widths, n, random := s.streamWidths(l)
+	if random {
+		return "", 0, false
+	}
+	if n == 0 {
+		return "", 0, true // nothing established: Close draws nothing
+	}
+	pads := w0(s.pad().Left) + w0(s.pad().Right)
+	contentMax := func(i int) int {
+		w := max(widths[i], 0)
+		eff := w - pads
+		if eff < 1 && w > pads {
+			eff = 1
+		} else if eff < 0 {
+			eff = 0
+		}
+		if w == 0 {
+			eff = 0
+		}
+		return eff
+	}
+	m := tableModel{numCols: n, widths: widths, natural: widths, hidden: make([]bool, n)}
+	for i, w := range widths {
+		m.hidden[i] = w == 0
+	}
+	zero := make([]cellMerge, n)
+	var b strings.Builder
+	lastPos := -1 // -1 nothing, secHeader/secRow/secFooter, 3 a separator
+	const sepPos = 3
+	var lastM []cellMerge
+	headerRendered, firstRowRendered, footerStored := false, false, false
+	var footerLines [][]string
+	var ftrM []cellMerge
+
+	// the prepared sections
+	var hdrLines [][]string
+	var hdrM []cellMerge
+	if len(s.header) > 0 {
+		cells := fit(s.header, n)
+		var merged [][]string
+		merged, hdrM = s.hmerge([][]string{cells}, n, s.merge[secHeader], false)
+		hdrLines = s.prepareWith(merged[0], secHeader, contentMax)
+	}
+	storeFooter := func() {
+		if len(s.footer) == 0 {
+			return
+		}
+		cells := fit(s.footer, n)
+		footerLines = s.prepareWith(cells, secFooter, contentMax)
+		ftrM = zero
+		if !Known.streamFooterMergesIgnored {
+			footerLines, ftrM = s.hmerge(footerLines, n, s.merge[secFooter], true)
+		}
+		footerStored = len(footerLines) > 0
+	}
+	renderHeader := func() {
+		if len(s.header) == 0 {
+			return
+		}
+		if lastPos == -1 && l.top && l.showTop {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secHeader, next: hdrM, widths: widths}))
+		}
+		hW := widths
+		if !Known.streamHeaderMergeWidth {
+			hW = m.mergedWidths(hdrM, l)
+		}
+		for _, line := range hdrLines {
+			b.WriteString(l.cellLine(m, s.tableSpec, line, secHeader, hdrM, hW))
+		}
+		if len(hdrLines) > 0 { // a header whose cells wrap to no line leaves the last position as it was
+			lastPos, lastM = secHeader, hdrM
+		}
+		headerRendered = true
+		if l.showHeaderLine && (firstRowRendered || footerStored) {
+			b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secHeader, cur: hdrM, next: nil, widths: widths}))
+			lastPos, lastM = sepPos, nil
+		}
+	}
+	refused := 0
+	renderRows := func() {
+		for _, row := range s.rows {
+			if len(row) == 0 {
+				if Known.emptyRowSuppressesHeaderLine {
+					firstRowRendered = true
+				}
+				continue
+			}
+			if s.strict && len(row) != n {
+				refused++
+				continue
+			}
+			cells := fit(row, n)
+			// the merges are detected on the raw trimmed cells (before formatting and wrapping,
+			// unlike batch mode, which compares the prepared visual lines), and the cells are
+			// then prepared with the continuing ones blanked, so a merged cell has the lines of
+			// its first cell alone
+			merged, recM := s.hmerge([][]string{cells}, n, s.merge[secRow], false)
+			lines := s.prepareWith(merged[0], secRow, contentMax)
+			if !headerRendered && !firstRowRendered && lastPos == -1 && l.top && l.showTop {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvHeader, loc: locFirst, pos: secRow, next: recM, widths: widths}))
+			}
+			headerSep := headerRendered && !firstRowRendered && l.showHeaderLine
+			rowSep := firstRowRendered && l.betweenRows
+			if (headerSep || rowSep) && lastPos != sepPos {
+				b.WriteString(l.borderLine(m, lineCtx{level: lvBody, loc: locMiddle, pos: secRow, cur: lastM, next: recM, widths: widths}))
+				lastPos, lastM = sepPos, nil
+			}
+			if len(lines) == 0 {
+				// a row whose cells wrap to no line (WrapBreak of blank cells) renders nothing
+				// more: the separator drawn for it stays the last line rendered
+				firstRowRendered = true
+				continue
+			}
+			for _, line := range lines {
+				b.WriteString(l.cellLine(m, s.tableSpec, line, secRow, recM, widths))
+			}
+			lastPos, lastM = secRow, recM
+			firstRowRendered = true
+		}
+	}
+	switch s.order {
+	case orderHRF:
+		renderHeader()
+		renderRows()
+		storeFooter()
+	case orderHFR:
+		renderHeader()
+		storeFooter()
+		renderRows()
+	default:
+		storeFooter()
+		renderHeader()
+		renderRows()
+	}
+	// Close: the footer, then the bottom border
+	if footerStored {
+		if lastPos != -1 && lastPos != secFooter && l.showFooterLine {
+			next := zero
+			if !Known.streamFooterMergesIgnored {
+				next = ftrM
+			}
+			b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locMiddle, pos: secFooter, cur: lastM, next: next, widths: widths}))
+			lastPos, lastM = sepPos, nil
+		}
+		fW := widths
+		if !Known.streamFooterMergesIgnored {
+			fW = m.mergedWidths(ftrM, l)
+		}
+		for _, line := range footerLines {
+			b.WriteString(l.cellLine(m, s.tableSpec, line, secFooter, ftrM, fW))
+		}
+		lastPos, lastM = secFooter, ftrM
+	}
+	if l.bottom && l.showBottom {
+		pos := lastPos
+		if pos == sepPos || pos == -1 {
+			pos = secRow // "separator" or "" is neither Row nor Header: no pre-footer rule applies
+		}
+		b.WriteString(l.borderLine(m, lineCtx{level: lvFooter, loc: locEnd, pos: pos, cur: lastM, widths: widths}))
+	}
+	return b.String(), refused, true
+}
+
+// TestHegelStream: the streamed boxed rendering equals the model's.
+func TestHegelStream(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkStream(c, ht, hegel.Draw(ht, streamCases))
+	})
+}
+
+// checkStream is the body of TestHegelStream for one case: the streamed rendering leaves the
+// caller's cells alone, refuses the rows the model refuses and equals the model's output.
+func checkStream(c *collector, ht *hegel.T, k streamCase) {
+	s, r := k.s, k.r
+	want, wantRefused, ok := s.streamModel(r)
+	if !ok {
+		c.count("random remainder")
+		ht.Assume(false) // left out by streamCases; a case Filter gave up on
+	}
+	before := fmt.Sprintf("%q %q %q", s.header, s.rows, s.footer)
+	got, refused, err := s.streamOut(renderer.NewBlueprint(r.rendition()))
+	if err != nil {
+		c.failClass(ht, "error", "stream: %v for %s %s", err, s, r)
+		return
+	}
+	// the streamed cells are the caller's: the horizontal merge blanks the continuing
+	// cells in the caller's slice (tablewriter/40, Known.streamMergeMutatesInput)
+	if after := fmt.Sprintf("%q %q %q", s.header, s.rows, s.footer); after != before && !Known.streamMergeMutatesInput {
+		c.failClass(ht, "mutated input", "stream of %s %s wrote into the caller's cells: header, rows and footer are now %s, were %s (the shape of tablewriter/40)", s, r, after, before)
+		return
+	}
+	if want == "" {
+		c.count("nothing established")
+	}
+	s.classify(c)
+	c.count("order " + itoa(s.order))
+	if s.global > 0 {
+		c.count("global")
+	}
+	if s.colWidths != nil {
+		c.count("colWidths")
+	}
+	if refused > 0 {
+		c.count("refused rows")
+	}
+	if refused != wantRefused {
+		c.failClass(ht, "refused", "stream of %s %s: %d rows refused, want %d", s, r, refused, wantRefused)
+		return
+	}
+	if got != want {
+		c.failClass(ht, "stream", "stream of %s %s:\n got:\n%s want:\n%s", s, r, got, want)
+	}
+}
diff --git a/hegel/hegel_table_test.go b/hegel/hegel_table_test.go
new file mode 100644
index 0000000..2b4e9b5
--- /dev/null
+++ b/hegel/hegel_table_test.go
@@ -0,0 +1,1018 @@
+package hegel
+
+// The table's Markdown and HTML renderings against models of the documented pipeline: cells
+// trimmed (TrimSpace/TrimTab), tabs expanded, header/footer auto-formatted, split into visual
+// lines, column widths from the widest cell plus padding; Markdown cells padded to the column
+// width by the alignment rules (body explicit, else header, else centre) with a separator row
+// of at least three dashes; HTML sections with escaped cells and text-align styles.
+
+import (
+	"bytes"
+	"html"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/olekukonko/tablewriter"
+	"github.com/olekukonko/tablewriter/renderer"
+	"github.com/olekukonko/tablewriter/tw"
+	"hegel.dev/go/hegel"
+)
+
+var tableCells = []string{
+	"", "", "a", "Name", "userName", "first_name", "city.name", "v1.5", "25", "-3.5", "ID",
+	" x ", "\tt\t", "  ", "a|b", "x\ny", "x\n\ny", "<b>&\"q\"", "あい", "é", "long cell text",
+	esc + "[31mred" + esc + "[0m", "A__B", "1.5", ".", "_", "a  b",
+	"the quick brown fox jumps over", "supercalifragilistic", "ab cd  ef", "あいうえお かきくけこ",
+}
+
+var alignChoices = []tw.Align{tw.AlignLeft, tw.AlignRight, tw.AlignCenter, tw.AlignNone, tw.Align("")}
+
+const (
+	secHeader = 0
+	secRow    = 1
+	secFooter = 2
+)
+
+// constraints: the width constraints and the wrapping of a table (part 4).
+type constraints struct {
+	wrap      [3]int      // With{Header,Row,Footer}AutoWrap; 0 keeps the default (header truncate, else normal)
+	secMax    [3]int      // With{Header,Row,Footer}MaxWidth (ColMaxWidths.Global); 0: none
+	colWidths map[int]int // WithColumnWidths (Widths.PerColumn); nil: none
+	maxWidth  int         // WithMaxWidth; 0: none
+	columnMax int         // WithColumnMax (Widths.Global) in batch mode, drawn by the narrow property of bug 12 alone; 0: none
+	caption   *tw.Caption // Caption(); nil: none
+}
+
+// merging: the cell merging of a table (part 6).
+type merging struct {
+	merge     [3]int // With{Header,Row,Footer}MergeMode (rows above MergeHierarchical through Configure); 0: none
+	mergeCols []int  // Row.Merging.ByColumnIndex; nil: every column
+}
+
+type tableSpec struct {
+	header     []string // nil: no header
+	rows       [][]string
+	footer     []string // nil: no footer
+	trimSpace  bool
+	trimTab    bool
+	autoFormat [3]bool // header, row, footer
+	align      [3]tw.CellAlignment
+	autoHide   bool
+	hideHeader bool
+	hideFooter bool
+	htmlCfg    *renderer.HTMLConfig
+	padding    *tw.Padding // WithPadding for every section; nil: the default one space each side
+	constraints
+	merging
+}
+
+func (s tableSpec) pad() tw.Padding {
+	if s.padding != nil {
+		return *s.padding
+	}
+	return tw.PaddingDefault
+}
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	cellTexts   = hegel.SampledFrom(tableCells)
+	alignChoice = hegel.SampledFrom(alignChoices)
+	paddings    = hegel.SampledFrom(paddingChoices)
+)
+
+// alignmentsOf: the section's default alone half of the time, else a global alignment from
+// alignChoices with, 40% of the time, up to four per-column ones.
+func alignmentsOf(def tw.Align) hegel.Generator[tw.CellAlignment] {
+	explicit := hegel.Composite(func(tc hegel.TestCase) tw.CellAlignment {
+		return tw.CellAlignment{Global: hegel.Draw(tc, alignChoice), PerColumn: hegel.Draw(tc, maybe(40, many(alignChoice, 0, 4)))}
+	})
+	return weighted(choice[tw.CellAlignment]{50, hegel.Just(tw.CellAlignment{Global: def})}, choice[tw.CellAlignment]{50, explicit})
+}
+
+var (
+	headerAlignments = alignmentsOf(tw.AlignCenter)
+	rowAlignments    = alignmentsOf(tw.AlignLeft)
+	footerAlignments = alignmentsOf(tw.AlignRight)
+)
+
+// htmlConfigs: an HTML renderer configuration: the class attributes half of the time, escaping
+// 70% of the time, the <lines> tag 30%.
+var htmlClasses = hegel.SampledFrom([]renderer.HTMLConfig{
+	{}, {TableClass: "t", HeaderClass: "h", BodyClass: "b", FooterClass: "f", RowClass: "r", HeaderRowClass: "hr", FooterRowClass: "fr"},
+})
+
+var htmlConfigs = hegel.Composite(func(tc hegel.TestCase) renderer.HTMLConfig {
+	cfg := hegel.Draw(tc, htmlClasses)
+	cfg.EscapeContent = hegel.Draw(tc, chance(70))
+	cfg.AddLinesTag = hegel.Draw(tc, chance(30))
+	return cfg
+})
+
+// tableShape: the pool a table's cells come from, the least cells of a record, the range of
+// the number of records, and whether the table is boxed (a padding is drawn, no HTML
+// configuration).
+type tableShape struct {
+	cells            hegel.Generator[string]
+	minCells         int
+	minRows, maxRows int
+	boxed            bool
+}
+
+// tables: a table of 1 to 4 columns: a header 80% of the time and a footer 40%, both of 1 to
+// columns+1 cells, records of up to columns+1 cells; TrimSpace, TrimTab and the header's
+// AutoFormat on 80% of the time (the defaults), the rows' and the footer's AutoFormat on 20%;
+// every section's alignment from alignmentsOf; AutoHide 20%, the header and the footer hidden
+// by their Control 10% each.
+func tables(sh tableShape) hegel.Generator[tableSpec] {
+	return hegel.FlatMap(hegel.Integers(1, 4), func(cols int) hegel.Generator[tableSpec] {
+		record := many(sh.cells, 1, cols+1)
+		records := many(many(sh.cells, sh.minCells, cols+1), sh.minRows, sh.maxRows)
+		return hegel.Composite(func(tc hegel.TestCase) tableSpec {
+			s := tableSpec{
+				header:     hegel.Draw(tc, maybe(80, record)),
+				rows:       hegel.Draw(tc, records),
+				footer:     hegel.Draw(tc, maybe(40, record)),
+				trimSpace:  hegel.Draw(tc, mostly(80)),
+				trimTab:    hegel.Draw(tc, mostly(80)),
+				autoFormat: [3]bool{hegel.Draw(tc, mostly(80)), hegel.Draw(tc, chance(20)), hegel.Draw(tc, chance(20))},
+				align:      [3]tw.CellAlignment{hegel.Draw(tc, headerAlignments), hegel.Draw(tc, rowAlignments), hegel.Draw(tc, footerAlignments)},
+				autoHide:   hegel.Draw(tc, chance(20)),
+				hideHeader: hegel.Draw(tc, chance(10)),
+				hideFooter: hegel.Draw(tc, chance(10)),
+			}
+			if sh.boxed {
+				s.padding = hegel.Draw(tc, paddings)
+			} else {
+				s.htmlCfg = hegel.Draw(tc, optional(40, htmlConfigs))
+			}
+			return s
+		})
+	})
+}
+
+// tableSpecs: the tables of the Markdown and HTML properties: cells from tableCells, records
+// of 0 to columns+1 cells, 0 to 4 of them.
+var tableSpecs = tables(tableShape{cells: cellTexts, minCells: 0, minRows: 0, maxRows: 4})
+
+func state(b bool) tw.State {
+	if b {
+		return tw.On
+	}
+	return tw.Off
+}
+
+func (s tableSpec) options(r tw.Renderer) []tablewriter.Option {
+	var extra []tablewriter.Option
+	if s.padding != nil {
+		extra = append(extra, tablewriter.WithPadding(*s.padding))
+	}
+	if s.wrap[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderAutoWrap(s.wrap[secHeader]))
+	}
+	if s.wrap[secRow] != 0 {
+		extra = append(extra, tablewriter.WithRowAutoWrap(s.wrap[secRow]))
+	}
+	if s.wrap[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterAutoWrap(s.wrap[secFooter]))
+	}
+	if s.secMax[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderMaxWidth(s.secMax[secHeader]))
+	}
+	if s.secMax[secRow] != 0 {
+		extra = append(extra, tablewriter.WithRowMaxWidth(s.secMax[secRow]))
+	}
+	if s.secMax[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterMaxWidth(s.secMax[secFooter]))
+	}
+	if s.colWidths != nil {
+		m := tw.NewMapper[int, int]()
+		for k, v := range s.colWidths {
+			m.Set(k, v)
+		}
+		extra = append(extra, tablewriter.WithColumnWidths(m))
+	}
+	if s.maxWidth != 0 {
+		extra = append(extra, tablewriter.WithMaxWidth(s.maxWidth))
+	}
+	if s.columnMax != 0 {
+		extra = append(extra, tablewriter.WithColumnMax(s.columnMax))
+	}
+	if s.merge[secHeader] != 0 {
+		extra = append(extra, tablewriter.WithHeaderMergeMode(s.merge[secHeader]))
+	}
+	if s.merge[secRow] != 0 && s.merge[secRow] <= tw.MergeHierarchical {
+		extra = append(extra, tablewriter.WithRowMergeMode(s.merge[secRow]))
+	}
+	if s.merge[secFooter] != 0 {
+		extra = append(extra, tablewriter.WithFooterMergeMode(s.merge[secFooter]))
+	}
+	return append(extra,
+		tablewriter.WithRenderer(r),
+		tablewriter.WithTrimSpace(state(s.trimSpace)),
+		tablewriter.WithTrimTab(state(s.trimTab)),
+		tablewriter.WithHeaderAutoFormat(state(s.autoFormat[secHeader])),
+		tablewriter.WithRowAutoFormat(state(s.autoFormat[secRow])),
+		tablewriter.WithFooterAutoFormat(state(s.autoFormat[secFooter])),
+		tablewriter.WithHeaderAlignmentConfig(s.align[secHeader]),
+		tablewriter.WithRowAlignmentConfig(s.align[secRow]),
+		tablewriter.WithFooterAlignmentConfig(s.align[secFooter]),
+		tablewriter.WithAutoHide(state(s.autoHide)),
+		tablewriter.WithHeaderControl(tw.Control{Hide: state(s.hideHeader)}),
+		tablewriter.WithFooterControl(tw.Control{Hide: state(s.hideFooter)}),
+	)
+}
+
+func (s tableSpec) render(r tw.Renderer) (string, error) {
+	var buf bytes.Buffer
+	t := tablewriter.NewTable(&buf, s.options(r)...)
+	if s.caption != nil {
+		t.Caption(*s.caption)
+	}
+	if s.merge[secRow] > tw.MergeHierarchical || s.mergeCols != nil {
+		t.Configure(func(c *tablewriter.Config) {
+			if s.merge[secRow] > tw.MergeHierarchical {
+				// a combined mode (Vertical|Hierarchical, Horizontal|Hierarchical, all three)
+				// is beyond With*MergeMode's range: set both the new and the deprecated field
+				c.Row.Merging.Mode = s.merge[secRow]
+				c.Row.Formatting.MergeMode = s.merge[secRow]
+			}
+			if s.mergeCols != nil {
+				m := tw.NewMapper[int, bool]()
+				for _, col := range s.mergeCols {
+					m.Set(col, true)
+				}
+				c.Row.Merging.ByColumnIndex = m
+			}
+		})
+	}
+	if s.header != nil {
+		t.Header(s.header)
+	}
+	for _, row := range s.rows {
+		if err := t.Append(row); err != nil {
+			return "", err
+		}
+	}
+	if s.footer != nil {
+		t.Footer(s.footer)
+	}
+	err := t.Render()
+	return buf.String(), err
+}
+
+// GoString is the draw report's rendering of the spec.
+func (s tableSpec) GoString() string { return s.String() }
+
+func (s tableSpec) String() string {
+	var b strings.Builder
+	b.WriteString("header=")
+	b.WriteString(quoteCells(s.header))
+	b.WriteString(" rows=[")
+	for i, r := range s.rows {
+		if i > 0 {
+			b.WriteString(" ")
+		}
+		b.WriteString(quoteCells(r))
+	}
+	b.WriteString("] footer=")
+	b.WriteString(quoteCells(s.footer))
+	b.WriteString(" trimSpace=" + boolStr(s.trimSpace) + " trimTab=" + boolStr(s.trimTab))
+	b.WriteString(" autoFormat=" + boolStr(s.autoFormat[0]) + "," + boolStr(s.autoFormat[1]) + "," + boolStr(s.autoFormat[2]))
+	for i, a := range s.align {
+		b.WriteString(" align" + itoa(i) + "=" + string(a.Global) + "/" + strings.Join(alignStrs(a.PerColumn), ","))
+	}
+	b.WriteString(" autoHide=" + boolStr(s.autoHide) + " hide=" + boolStr(s.hideHeader) + "," + boolStr(s.hideFooter))
+	if s.htmlCfg != nil {
+		b.WriteString(" html=escape:" + boolStr(s.htmlCfg.EscapeContent) + ",lines:" + boolStr(s.htmlCfg.AddLinesTag) + ",class:" + boolStr(s.htmlCfg.TableClass != ""))
+	}
+	if s.padding != nil {
+		b.WriteString(" padding=" + strQuote(s.padding.Left) + "," + strQuote(s.padding.Right))
+	}
+	if s.wrap != [3]int{} || s.secMax != [3]int{} || s.colWidths != nil || s.maxWidth != 0 || s.columnMax != 0 {
+		b.WriteString(" wrap=" + itoa(s.wrap[0]) + "," + itoa(s.wrap[1]) + "," + itoa(s.wrap[2]))
+		b.WriteString(" secMax=" + itoa(s.secMax[0]) + "," + itoa(s.secMax[1]) + "," + itoa(s.secMax[2]))
+		if s.columnMax != 0 {
+			b.WriteString(" columnMax=" + itoa(s.columnMax))
+		}
+		b.WriteString(" maxWidth=" + itoa(s.maxWidth) + " colWidths=")
+		if s.colWidths == nil {
+			b.WriteString("nil")
+		} else {
+			keys := make([]int, 0, len(s.colWidths))
+			for k := range s.colWidths {
+				keys = append(keys, k)
+			}
+			sort.Ints(keys)
+			for i, k := range keys {
+				if i > 0 {
+					b.WriteString(",")
+				}
+				b.WriteString(itoa(k) + ":" + itoa(s.colWidths[k]))
+			}
+		}
+	}
+	if s.caption != nil {
+		b.WriteString(" caption=" + strQuote(s.caption.Text) + " spot=" + itoa(int(s.caption.Spot)) + " calign=" + string(s.caption.Align) + " cwidth=" + itoa(s.caption.Width))
+	}
+	if s.merge != [3]int{} || s.mergeCols != nil {
+		b.WriteString(" merge=" + itoa(s.merge[0]) + "," + itoa(s.merge[1]) + "," + itoa(s.merge[2]) + " mergeCols=")
+		if s.mergeCols == nil {
+			b.WriteString("all")
+		} else {
+			for i, c := range s.mergeCols {
+				if i > 0 {
+					b.WriteString(",")
+				}
+				b.WriteString(itoa(c))
+			}
+		}
+	}
+	return b.String()
+}
+
+func alignStrs(as []tw.Align) []string {
+	out := make([]string, len(as))
+	for i, a := range as {
+		out[i] = string(a)
+	}
+	return out
+}
+
+func quoteCells(cells []string) string {
+	if cells == nil {
+		return "nil"
+	}
+	parts := make([]string, len(cells))
+	for i, c := range cells {
+		parts[i] = strQuote(c)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func strQuote(s string) string {
+	return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"", "\n", "\\n", "\t", "\\t", esc, "\\e").Replace(s) + "\""
+}
+
+// --------------------------------------------------------------------------- the pipeline
+
+func (s tableSpec) trim(str string) string {
+	if s.trimSpace && s.trimTab {
+		return strings.TrimSpace(str)
+	}
+	if !s.trimSpace && !s.trimTab {
+		return str
+	}
+	return strings.TrimFunc(str, func(r rune) bool {
+		if r == '\t' {
+			return s.trimTab
+		}
+		if s.trimSpace {
+			return unicode.IsSpace(r)
+		}
+		return false
+	})
+}
+
+// constrained is Widths.Constrained(): a per-column width is set (WithColumnWidths drops the
+// negative ones), or the column maximum.
+func (s tableSpec) constrained() bool {
+	if s.columnMax > 0 {
+		return true
+	}
+	for _, w := range s.colWidths {
+		if w >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// wrapMode is the section's effective AutoWrap: the option given, else the default (the
+// header truncates, rows and footer wrap).
+func (s tableSpec) wrapMode(sec int) int {
+	if s.wrap[sec] != 0 {
+		return s.wrap[sec]
+	}
+	if sec == secHeader {
+		return tw.WrapTruncate
+	}
+	return tw.WrapNormal
+}
+
+// contentMax is the model of calculateContentMaxWidth for a record of n cells: the cell
+// width constraint in priority order (Widths.PerColumn, else the section's ColMaxWidths.Global
+// - which a table MaxWidth replaces by MaxWidth/n when no per-column width is set -, else the
+// column maximum WithColumnMax documents ("a global maximum column width": bug 12 shares it
+// among the columns instead), else MaxWidth itself when the section wraps), less the padding,
+// at least 1 when the constraint exceeds the padding; 0 means unconstrained.
+func (s tableSpec) contentMax(i, n, sec int) int {
+	constraint := 0
+	if w, ok := s.colWidths[i]; ok && w > 0 {
+		constraint = w
+	} else {
+		secMax := s.secMax[sec]
+		if s.maxWidth > 0 && !s.constrained() && n > 0 {
+			secMax = s.maxWidth / n
+		}
+		switch {
+		case secMax > 0:
+			constraint = secMax
+		case s.columnMax > 0:
+			constraint = s.columnMax
+		case s.maxWidth > 0 && s.wrapMode(sec) != tw.WrapNone:
+			constraint = s.maxWidth
+		}
+	}
+	if constraint == 0 {
+		return 0
+	}
+	pads := width(s.pad().Left, widthOpts{}) + width(s.pad().Right, widthOpts{})
+	eff := constraint - pads
+	if eff < 1 && constraint > pads {
+		return 1
+	}
+	if eff < 0 {
+		return 0
+	}
+	return eff
+}
+
+// wrapLine is the model of prepareContent's wrapping of one visual line to the content width.
+func (s tableSpec) wrapLine(line string, eff, mode int) []string {
+	o := widthOpts{}
+	switch mode {
+	case tw.WrapNormal:
+		if s.trimSpace && s.trimTab {
+			out, _ := wrapString(line, eff)
+			return out
+		}
+		out, _ := wrapStringWithSpaces(line, eff)
+		return out
+	case tw.WrapTruncate:
+		if width(line, o) > eff {
+			return []string{truncate(line, eff-1, tw.CharEllipsis, o)}
+		}
+		return []string{line}
+	case tw.WrapBreak:
+		var wrapped []string
+		cur := line
+		for width(cur, o) > eff {
+			target := max(eff-1, 0)
+			bp := breakPoint(cur, target, o)
+			runes := []rune(cur)
+			if bp <= 0 || bp > len(runes) {
+				// the package's manual break: runes while they fit the target, at least one
+				count, tempW := 0, 0
+				for idx, r := range runes {
+					rw := width(string(r), o)
+					if tempW+rw > target && idx > 0 {
+						break
+					}
+					tempW += rw
+					count = idx + 1
+					if tempW >= target && idx == 0 {
+						break
+					}
+				}
+				if count == 0 && len(runes) > 0 {
+					count = 1
+				}
+				if count > 0 && count <= len(runes) {
+					wrapped = append(wrapped, string(runes[:count])+tw.CharBreak)
+					cur = string(runes[count:])
+				} else {
+					wrapped = append(wrapped, cur)
+					cur = ""
+					break
+				}
+			} else {
+				wrapped = append(wrapped, string(runes[:bp])+tw.CharBreak)
+				cur = string(runes[bp:])
+			}
+		}
+		if width(cur, o) > 0 {
+			wrapped = append(wrapped, cur)
+		}
+		return wrapped // a blank line yields no line
+	}
+	return []string{line}
+}
+
+// prepare turns a record into its visual lines: every cell trimmed, tabs expanded,
+// auto-formatted, split at newlines, each line wrapped to the column's content width when one
+// is constrained; the record has as many lines as its tallest cell.
+func (s tableSpec) prepare(cells []string, sec int) [][]string {
+	return s.prepareWith(cells, sec, func(i int) int { return s.contentMax(i, len(cells), sec) })
+}
+
+// prepareWith is prepare with the content width of every column given (streaming: the fixed
+// stream width less the padding).
+func (s tableSpec) prepareWith(cells []string, sec int, contentMax func(i int) int) [][]string {
+	var lines [][]string
+	for i, c := range cells {
+		c = s.trim(c)
+		c = strings.ReplaceAll(c, "\t", strings.Repeat(" ", tabW))
+		eff := contentMax(i)
+		if s.autoFormat[sec] {
+			c = tw.Title(strings.Join(tw.SplitCamelCase(c), " "))
+		}
+		var parts []string
+		for _, p := range strings.Split(c, "\n") {
+			if eff > 0 {
+				w := s.wrapLine(p, eff, s.wrapMode(sec))
+				if len(w) == 0 && s.wrapMode(sec) == tw.WrapBreak && width(p, widthOpts{}) > 0 && len(parts) == 0 {
+					w = []string{p}
+				}
+				parts = append(parts, w...)
+			} else {
+				parts = append(parts, p)
+			}
+		}
+		for len(lines) < len(parts) {
+			lines = append(lines, make([]string, len(cells)))
+		}
+		for j, p := range parts {
+			lines[j][i] = p
+		}
+	}
+	return lines
+}
+
+// aligns resolves a section's alignment per column as buildAligns does.
+func (s tableSpec) aligns(sec int, numCols int) []tw.Align {
+	a := s.align[sec]
+	out := make([]tw.Align, numCols)
+	for i := range out {
+		out[i] = a.Global
+		if i < len(a.PerColumn) && a.PerColumn[i] != "" {
+			out[i] = a.PerColumn[i]
+		}
+	}
+	return out
+}
+
+// tableModel is the prepared table: visual lines per section and the column widths.
+type tableModel struct {
+	header  [][]string   // nil when no header is rendered
+	rows    [][][]string // the records with cells, as visual lines
+	records [][][]string // every record, a record without cells having no line
+	footer  [][]string
+	numCols int
+	widths  []int  // widest content plus the padding widths, at least 1
+	hidden  []bool // hidden by AutoHide (width 0)
+	visible []bool // rendered by the Markdown and HTML renderers (bug 11: the hidden ones too)
+	// merge states per column (part 6): of the header, of every record, of the footer
+	hdrM    []cellMerge
+	recM    [][]cellMerge
+	ftrM    []cellMerge
+	natural []int // the widths before AutoHide
+}
+
+func padLine(line []string, n int) []string {
+	out := make([]string, n)
+	copy(out, line)
+	return out
+}
+
+func (s tableSpec) model() tableModel {
+	var m tableModel
+	if s.header != nil && len(s.header) > 0 && !s.hideHeader {
+		m.header = s.prepare(s.header, secHeader)
+	}
+	for _, r := range s.rows {
+		lines := s.prepare(r, secRow)
+		m.records = append(m.records, lines)
+		if len(lines) == 0 {
+			continue // a record without cells has no visual line and is dropped
+		}
+		m.rows = append(m.rows, lines)
+	}
+	if s.footer != nil && len(s.footer) > 0 && !s.hideFooter {
+		m.footer = s.prepare(s.footer, secFooter)
+	}
+	for _, l := range m.header {
+		m.numCols = max(m.numCols, len(l))
+	}
+	for _, r := range m.rows {
+		for _, l := range r {
+			m.numCols = max(m.numCols, len(l))
+		}
+	}
+	for _, l := range m.footer {
+		m.numCols = max(m.numCols, len(l))
+	}
+	// a record whose cells all wrap to no line (WrapBreak of blank cells under a width
+	// constraint) still counts its cells as columns
+	for _, r := range s.rows {
+		m.numCols = max(m.numCols, len(r))
+	}
+	padW := width(s.pad().Left, widthOpts{}) + width(s.pad().Right, widthOpts{})
+	// a column is as wide as its widest cell plus the padding, at least 1 (so a column no
+	// visual line has a cell of, only such records do, is 1 wide)
+	m.widths = make([]int, m.numCols)
+	upd := func(lines [][]string) {
+		for _, l := range lines {
+			for i, c := range l {
+				m.widths[i] = max(m.widths[i], width(c, widthOpts{})+padW)
+			}
+		}
+	}
+	upd(m.header)
+	for _, r := range m.rows {
+		upd(r)
+	}
+	upd(m.footer)
+	for i := range m.widths {
+		m.widths[i] = max(1, m.widths[i])
+	}
+	// Widths.PerColumn replaces the natural width outright (0 included)
+	for i := range m.widths {
+		if w, ok := s.colWidths[i]; ok && w >= 0 {
+			m.widths[i] = w
+		}
+	}
+	// AutoHide judges a column empty on the body cells before any merge blanks them
+	empty := make([]bool, m.numCols)
+	if s.autoHide {
+		for i := 0; i < m.numCols; i++ {
+			empty[i] = true
+			for _, r := range m.rows {
+				for _, l := range r {
+					if i < len(l) && s.trim(l[i]) != "" {
+						empty[i] = false
+					}
+				}
+			}
+		}
+	}
+	// the natural widths, before AutoHide hides columns (bug 34 sizes merged headers by them)
+	m.natural = append([]int(nil), m.widths...)
+	// the merges come before TrimLine, which the renderer applies to the merged content
+	s.applyMerges(&m)
+	// TrimLine (on by default): a blank visual line after the first of a record is skipped
+	trimLine := func(r [][]string) [][]string {
+		if len(r) == 0 {
+			return r
+		}
+		kept := [][]string{r[0]}
+		for _, l := range r[1:] {
+			blank := true
+			for _, c := range padLine(l, m.numCols) {
+				if s.trim(c) != "" {
+					blank = false
+					break
+				}
+			}
+			if !blank {
+				kept = append(kept, l)
+			}
+		}
+		return kept
+	}
+	for ri, r := range m.rows {
+		m.rows[ri] = trimLine(r)
+	}
+	for ri, r := range m.records {
+		m.records[ri] = trimLine(r)
+	}
+	m.visible = make([]bool, m.numCols)
+	m.hidden = make([]bool, m.numCols)
+	for i := range m.visible {
+		m.visible[i] = true
+	}
+	if s.autoHide {
+		// AutoHide: a column whose body cells are all blank gets width 0 and is hidden; the
+		// Markdown and HTML renderers still render it while the switch is on (Markdown then
+		// sizes its cells by their content and its separator at the minimum three dashes)
+		for i := 0; i < m.numCols; i++ {
+			if empty[i] {
+				m.widths[i] = 0
+				m.visible[i] = Known.autoHideIgnored
+			}
+		}
+	}
+	// the boxed renderer skips every column of width 0, hidden by AutoHide or set so by
+	// Widths.PerColumn
+	for i := range m.widths {
+		m.hidden[i] = m.widths[i] == 0
+	}
+	return m
+}
+
+// joinLines folds a record's visual lines into one when Known.multilineRows is off: the
+// renderers then would emit one row per record with <br> between the lines.
+func (m tableModel) recordLines(lines [][]string) [][]string {
+	if Known.multilineRows || len(lines) <= 1 {
+		return lines
+	}
+	joined := make([]string, m.numCols)
+	for i := range joined {
+		var parts []string
+		for _, l := range lines {
+			if i < len(l) {
+				parts = append(parts, l[i])
+			} else {
+				parts = append(parts, "")
+			}
+		}
+		joined[i] = strings.Join(parts, "<br>")
+	}
+	return [][]string{joined}
+}
+
+// --------------------------------------------------------------------------- Markdown
+
+func explicit(a tw.Align) bool { return a != tw.AlignNone && a != "" }
+
+func alignRule(header, body tw.Align) tw.Align {
+	if explicit(body) {
+		return body
+	}
+	if explicit(header) {
+		return header
+	}
+	return tw.AlignCenter
+}
+
+func mdCell(content string, w int, a tw.Align) string {
+	cw := width(content, widthOpts{})
+	target := max(w, max(3, cw+2))
+	total := target - cw
+	var left, right int
+	switch a {
+	case tw.AlignRight:
+		left = max(0, total-1)
+		right = total - left
+	case tw.AlignCenter:
+		left = total / 2
+		right = total - left
+		if left < 1 && total >= 2 {
+			left = 1
+			right = total - 1
+		}
+		if right < 1 && total >= 2 {
+			right = 1
+			left = total - 1
+		}
+	default:
+		right = max(0, total-1)
+		left = total - right
+	}
+	return strings.Repeat(" ", left) + content + strings.Repeat(" ", right)
+}
+
+func mdSeparator(w int, a tw.Align) string {
+	t := max(3, w)
+	switch a {
+	case tw.AlignLeft:
+		return ":" + strings.Repeat("-", t-1)
+	case tw.AlignRight:
+		return strings.Repeat("-", t-1) + ":"
+	}
+	return ":" + strings.Repeat("-", t-2) + ":"
+}
+
+func mdEscape(c string) string {
+	if Known.markdownPipes {
+		return c
+	}
+	return strings.ReplaceAll(c, "|", "\\|")
+}
+
+// markdown is the model of the Markdown renderer's output for the spec.
+func (s tableSpec) markdown() string {
+	m := s.model()
+	var b strings.Builder
+	line := func(cells []string) {
+		b.WriteString("|")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString(cells[i])
+			b.WriteString("|")
+		}
+		b.WriteString("\n")
+	}
+	headerAlign := make([]tw.Align, m.numCols) // AlignNone when no header is rendered
+	for i := range headerAlign {
+		headerAlign[i] = tw.AlignNone
+	}
+	if m.header != nil {
+		headerAlign = s.aligns(secHeader, m.numCols)
+	}
+	var bodyAlign []tw.Align
+	switch {
+	case len(m.rows) > 0:
+		bodyAlign = s.aligns(secRow, m.numCols)
+	case m.footer != nil:
+		bodyAlign = s.aligns(secFooter, m.numCols)
+	default:
+		bodyAlign = headerAlign
+	}
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				a := headerAlign[i]
+				if !explicit(a) {
+					a = tw.AlignCenter
+				}
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], a)
+			}
+			line(cells)
+		}
+		cells := make([]string, m.numCols)
+		for i := range cells {
+			cells[i] = mdSeparator(m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+		}
+		line(cells)
+	}
+	body := func(lines [][]string) {
+		for _, l := range lines {
+			l = padLine(l, m.numCols)
+			cells := make([]string, m.numCols)
+			for i := range cells {
+				cells[i] = mdCell(mdEscape(l[i]), m.widths[i], alignRule(headerAlign[i], bodyAlign[i]))
+			}
+			line(cells)
+		}
+	}
+	for _, r := range m.rows {
+		body(m.recordLines(r))
+	}
+	if m.footer != nil {
+		body(m.recordLines(m.footer))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- HTML
+
+func htmlStyle(a tw.Align) string {
+	switch a {
+	case tw.AlignLeft, tw.AlignRight, tw.AlignCenter:
+		return ` style="text-align: ` + string(a) + `;"`
+	}
+	return ""
+}
+
+func classAttr(c string) string {
+	if c == "" {
+		return ""
+	}
+	return ` class="` + c + `"`
+}
+
+func (s tableSpec) htmlConfig() renderer.HTMLConfig {
+	if s.htmlCfg != nil {
+		return *s.htmlCfg
+	}
+	return renderer.HTMLConfig{EscapeContent: true}
+}
+
+func (s tableSpec) htmlCell(content string, cfg renderer.HTMLConfig) string {
+	multi := strings.Contains(content, "<br>") && !Known.multilineRows
+	if cfg.EscapeContent {
+		if multi {
+			parts := strings.Split(content, "<br>")
+			for i := range parts {
+				parts[i] = html.EscapeString(parts[i])
+			}
+			content = strings.Join(parts, "<br>")
+		} else {
+			content = html.EscapeString(content)
+		}
+	}
+	if multi && cfg.AddLinesTag {
+		content = "<lines>" + content + "</lines>"
+	}
+	return content
+}
+
+// htmlOut is the model of the HTML renderer's output for the spec.
+func (s tableSpec) htmlOut() string {
+	m := s.model()
+	cfg := s.htmlConfig()
+	var b strings.Builder
+	b.WriteString("<table" + classAttr(cfg.TableClass) + ">\n")
+	row := func(l []string, tag string, aligns []tw.Align, rowClass string) {
+		l = padLine(l, m.numCols)
+		b.WriteString("  <tr" + classAttr(rowClass) + ">")
+		for i := 0; i < m.numCols; i++ {
+			if !m.visible[i] {
+				continue
+			}
+			b.WriteString("<" + tag + htmlStyle(aligns[i]) + ">" + s.htmlCell(l[i], cfg) + "</" + tag + ">")
+		}
+		b.WriteString("</tr>\n")
+	}
+	// a header or footer of several visual lines is handed to the renderer line by line, so
+	// each line opens its own <thead>/<tfoot> (part of bug 10)
+	if m.header != nil {
+		for _, l := range m.recordLines(m.header) {
+			b.WriteString("<thead" + classAttr(cfg.HeaderClass) + ">\n")
+			row(l, "th", s.aligns(secHeader, m.numCols), cfg.HeaderRowClass)
+			b.WriteString("</thead>\n")
+		}
+	}
+	if len(m.rows) > 0 {
+		b.WriteString("<tbody" + classAttr(cfg.BodyClass) + ">\n")
+		for _, r := range m.rows {
+			for _, l := range m.recordLines(r) {
+				row(l, "td", s.aligns(secRow, m.numCols), cfg.RowClass)
+			}
+		}
+		b.WriteString("</tbody>\n")
+	}
+	if m.footer != nil {
+		for _, l := range m.recordLines(m.footer) {
+			b.WriteString("<tfoot" + classAttr(cfg.FooterClass) + ">\n")
+			row(l, "td", s.aligns(secFooter, m.numCols), cfg.FooterRowClass)
+			b.WriteString("</tfoot>\n")
+		}
+	}
+	b.WriteString("</table>\n")
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- properties
+
+func (s tableSpec) classify(c *collector) {
+	if s.header == nil {
+		c.count("no header")
+	}
+	if len(s.rows) == 0 {
+		c.count("no rows")
+	}
+	if s.footer != nil {
+		c.count("footer")
+	}
+	if s.autoHide {
+		c.count("autoHide")
+	}
+	for _, r := range s.rows {
+		for _, cell := range r {
+			if strings.Contains(cell, "\n") {
+				c.count("multi-line cell")
+			}
+			if strings.Contains(cell, "|") {
+				c.count("pipe cell")
+			}
+		}
+	}
+}
+
+func TestHegelMarkdown(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkMarkdown(c, ht, hegel.Draw(ht, tableSpecs))
+	})
+}
+
+// checkMarkdown is the body of TestHegelMarkdown for one table: its Markdown rendering equals
+// the model's.
+func checkMarkdown(c *collector, ht *hegel.T, s tableSpec) {
+	s.classify(c)
+	got, err := s.render(renderer.NewMarkdown())
+	if err != nil {
+		c.failClass(ht, "error", "Render: %v for %s", err, s)
+		return
+	}
+	if want := s.markdown(); got != want {
+		c.failClass(ht, "markdown", "Markdown of %s:\n got:\n%s want:\n%s", s, got, want)
+	}
+}
+
+func TestHegelHTML(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkHTML(c, ht, hegel.Draw(ht, tableSpecs))
+	})
+}
+
+// checkHTML is the body of TestHegelHTML for one table: its HTML rendering (under its HTML
+// configuration, if any) equals the model's.
+func checkHTML(c *collector, ht *hegel.T, s tableSpec) {
+	s.classify(c)
+	var r tw.Renderer
+	if s.htmlCfg != nil {
+		r = renderer.NewHTML(*s.htmlCfg)
+	} else {
+		r = renderer.NewHTML()
+	}
+	got, err := s.render(r)
+	if err != nil {
+		c.failClass(ht, "error", "Render: %v for %s", err, s)
+		return
+	}
+	if want := s.htmlOut(); got != want {
+		c.failClass(ht, "html", "HTML of %s:\n got:\n%s want:\n%s", s, got, want)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..7cd7097
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,288 @@
+package hegel
+
+// Hegel property tests for olekukonko/tablewriter, written for the Hegel zoo. See
+// targets/go/tablewriter/README.md.
+//
+// Oracle: models of the documented behaviour of the helper packages (pkg/twwidth: display
+// widths over strings holding ANSI escape sequences, truncation; pkg/twwarp: word splitting
+// and minimum-raggedness wrapping; tw: padding, title formatting, camel-case splitting,
+// break points) and of the table's Markdown, HTML and boxed (Blueprint) renderings over
+// generated cells, with width constraints, wrap modes, captions and cell merging, in batch
+// and in streaming mode; and of the input conversion of Append/Bulk (slices, single values,
+// structs, AutoHeader).
+//
+// Every property draws one case record from generator values built of the binding's
+// combinators (the shapes are in the *_test.go file of each property); the models are pure
+// functions of the record. The shapes of the recorded bugs (bugs.toml) are drawn at their
+// natural rate and the models assert the documented behaviour, so the properties that meet
+// a bug fail and are the expected failures mapped to it (STYLE.md rule 11); the pins in
+// hegel_pins_test.go are the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes
+// off (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass. Extra options
+// follow the case count (the narrow properties stop at their first failure).
+func property(t *testing.T, fn func(ht *hegel.T), opts ...hegel.Option) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hegelOpts(), opts...)...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the models assert the documented behaviour, so the
+// properties that meet a bug fail, and are the expected failures mapped to it; under
+// HEGEL_NO_KNOWN=1 every switch of Known is on: the models reproduce the recorded behaviour,
+// the checks a bug falsifies are skipped (counted), and the values the package crashes on are
+// left out of the generators (shaped).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). A switch is on only under HEGEL_NO_KNOWN=1; the model
+// then reproduces the behaviour it names, and the pins keep asserting the documented one.
+var Known = struct {
+	tabWidthCache         bool // 2: Width's cache is not purged by SetTabWidth (the tab width is then fixed)
+	widthPerRune          bool // 3: Width sums rune widths, so emoji sequences differ from displaywidth's string width
+	truncateEscRestart    bool // 4: Truncate restarts its scan at every ESC, so an ST-terminated OSC swallows the rest
+	truncateZeroSuffix    bool // 5: Truncate at maxWidth 0 returns "" although the suffix is documented
+	wrapSpacesByteSlice   bool // 6: WrapStringWithSpaces splits a multi-byte last rune between core and trailing spaces
+	breakPointEscapes     bool // 7: BreakPoint counts the characters of escape sequences
+	camelUnderscoreGroups bool // 8: SplitCamelCase keeps groups of two or more underscores
+	// table
+	markdownPipes   bool // 9: the Markdown renderer does not escape | in cells
+	multilineRows   bool // 10: a cell with newlines becomes extra Markdown/HTML rows (the <br> paths are dead)
+	autoHideIgnored bool // 11: the Markdown and HTML renderers render the columns AutoHide hides
+	// blueprint
+	alignNoneLeft            bool // 13: Blueprint renders AlignNone cells left-aligned in every section, discarding the position default it computes
+	noTopBorderWithoutHeader bool // 14: no top border when the table has a footer but no header
+	autoHideSeparator        bool // 15: the separator before a visible column is dropped when the column before it is hidden by AutoHide
+	autoHideAllColumns       bool // 16: lines of different widths when AutoHide hides every column
+	doubleSeparator          bool // 17: a header-and-footer table without rows renders the header and the footer separator, two identical lines
+	emptyRecordFrame         bool // 18: a table whose only records are empty renders as ++ lines
+	autoFormatEscapes        bool // 19, 20: AutoFormat rewrites the escape sequences of a cell, which Truncate and Width then measure differently
+	graphicalNarrowCorners   bool // 21: StyleGraphical's border lines overshoot a lone column narrower than its two corners' excess
+	// caption
+	captionAlignLeft   bool // 22: an explicit AlignLeft caption takes the spot's default alignment, AlignDefault being AlignLeft
+	captionPlaceholder bool // 23: with a caption an empty table becomes hard-coded +--+ lines
+	// input conversion
+	pointerAddress            bool // 25: a pointer to a basic type (a cell or a struct field) is rendered as its address
+	nilStringerPanic          bool // 26: a nil pointer whose String()/Error() dereferences panics in convertToString (left out of the generators when on)
+	nullTypesUnhandled        bool // 27: sql.NullInt32 (NullInt16, NullByte) render as {5 true}
+	byteSliceRowNumbers       bool // 28: a []byte row is one numeric cell per byte, though the code says it is a string
+	readerEllipsisAt512       bool // 29: an io.Reader of exactly 512 bytes gets the ellipsis
+	embeddedNilDrops          bool // 30: a nil embedded struct pointer drops its columns, misaligning AutoHeader
+	singleStructEmptyRow      bool // 31: a value without exported fields appended alone (an error, a reader) is an empty row
+	autoHeaderConsumesReaders bool // 32: AutoHeader's extraction converts the first row's values too, reading its io.Reader fields
+	// cell merging
+	topJunctionAfterMerge   bool // 33: the top border has no junction after a horizontally merged header cell (the row glyph instead)
+	mergedHeaderHiddenWidth bool // 34: a merged header cell keeps the widths of the columns AutoHide hides, so the header is wider than the rows
+	footerLeadDropsLines    bool // 35: the footer's lead merge blanks the later lines of a multi-line cell it moves
+	// streaming
+	streamHeaderMergeWidth       bool // 36: a merged header cell is rendered at its own column's width in streaming, so the header line is narrower than the borders
+	streamFooterMergesIgnored    bool // 37: the footer's horizontal merges are not applied in streaming
+	emptyRowSuppressesHeaderLine bool // 38: an empty row appended first counts as the first row, so the header separator is never drawn
+	scaleRemainderRandom         bool // 39: the rounding remainder of the Widths.Global shrink is spread in map order, so the layout is random (such cases are then skipped)
+	streamMergeMutatesInput      bool // 40: the horizontal merge of a streamed row blanks the continuing cells in the caller's slice
+}{
+	tabWidthCache: noKnown, widthPerRune: noKnown, truncateEscRestart: noKnown, truncateZeroSuffix: noKnown,
+	wrapSpacesByteSlice: noKnown, breakPointEscapes: noKnown, camelUnderscoreGroups: noKnown,
+	markdownPipes: noKnown, multilineRows: noKnown, autoHideIgnored: noKnown,
+	alignNoneLeft: noKnown, noTopBorderWithoutHeader: noKnown, autoHideSeparator: noKnown, autoHideAllColumns: noKnown,
+	doubleSeparator: noKnown, emptyRecordFrame: noKnown, autoFormatEscapes: noKnown, graphicalNarrowCorners: noKnown,
+	captionAlignLeft: noKnown, captionPlaceholder: noKnown,
+	pointerAddress: noKnown, nilStringerPanic: noKnown, nullTypesUnhandled: noKnown, byteSliceRowNumbers: noKnown,
+	readerEllipsisAt512: noKnown, embeddedNilDrops: noKnown, singleStructEmptyRow: noKnown, autoHeaderConsumesReaders: noKnown,
+	topJunctionAfterMerge: noKnown, mergedHeaderHiddenWidth: noKnown, footerLeadDropsLines: noKnown,
+	streamHeaderMergeWidth: noKnown, streamFooterMergesIgnored: noKnown, emptyRowSuppressesHeaderLine: noKnown, scaleRemainderRandom: noKnown,
+	streamMergeMutatesInput: noKnown,
+}
+
+// shaped is the value (or generator) for a recorded bug's shape or, under HEGEL_NO_KNOWN=1,
+// for the neighbouring one past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// mostly is true pct percent of the time and shrinks to true: the coin of a setting that is
+// on by default, so that the shrunk case keeps the default.
+func mostly(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x < pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the pieces of a list generator concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// pieces is up to max pieces of the pool, concatenated.
+func pieces(pool []string, max int) hegel.Generator[string] {
+	return joined(many(hegel.SampledFrom(pool), 0, max))
+}
+
+// at is the element of a drawn tape at position i, recycled modulo its length, or the
+// fallback when the tape is empty (an empty tape shrinks every choice to the fallback).
+func at[T any](tape []T, i int, fallback T) T {
+	if len(tape) == 0 {
+		return fallback
+	}
+	return tape[i%len(tape)]
+}
diff --git a/hegel/hegel_width_test.go b/hegel/hegel_width_test.go
new file mode 100644
index 0000000..e253113
--- /dev/null
+++ b/hegel/hegel_width_test.go
@@ -0,0 +1,249 @@
+package hegel
+
+// Properties of pkg/twwidth: Width, WidthNoCache, WidthWithOptions, Filter and Truncate
+// against the models of hegel_model_test.go.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/clipperhouse/displaywidth"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+var plainPieces = []string{
+	"a", "b", "hello", "World", "x1", "-", ".", " ", "  ", "\t", "\n", "\r", "\x00", "\x7f",
+	"\u00E9", "e\u0301", "\u3042", "\u6F22\u5B57", "\u2500", "\u253C", "\u2550",
+	"\U0001F600", "\u00DF", "\u01F1", "\u2026", "\u21A9", "\u3000",
+}
+
+// emojiPieces are sequences whose grapheme width differs from the sum of their runes.
+var emojiPieces = []string{
+	"\u2764\uFE0F", "\U0001F468\u200D\U0001F469\u200D\U0001F467", "\U0001F1EB\U0001F1F7",
+	"1\uFE0F\u20E3", "\U0001F44B\U0001F3FB", "\u2600\uFE0F",
+}
+
+var csiPieces = []string{
+	esc + "[31m", esc + "[0m", esc + "[1;32m", esc + "[m", esc + "[K", esc + "[2J", esc + "[?25h",
+	esc + "[1;2 q", esc + "[38;5;31m", esc + "[10;20H",
+}
+
+var oscBelPieces = []string{esc + "]0;title" + bel, esc + "]8;;http://x" + bel, esc + "]8;;" + bel}
+var oscSTPieces = []string{esc + "]8;;http://x" + esc + "\\", esc + "]8;;" + esc + "\\", esc + "]0;t" + esc + "\\"}
+
+var (
+	plainText = hegel.SampledFrom(plainPieces)
+	emojiText = hegel.SampledFrom(emojiPieces)
+	csiSeqs   = hegel.SampledFrom(csiPieces)
+	oscBels   = hegel.SampledFrom(oscBelPieces)
+	oscSTs    = hegel.SampledFrom(oscSTPieces)
+)
+
+type strOpts struct {
+	noSeq, noEmoji, noST bool
+	maxPieces            int
+}
+
+// strs: up to maxPieces (8) pieces: plain text 55% of the time, an emoji sequence 10%, a
+// CSI sequence 20%, an OSC sequence ended by BEL 8% and by ST 7%; the share of a pool the
+// options leave out goes to plain text.
+func strs(o strOpts) hegel.Generator[string] {
+	pools := []choice[string]{{55, plainText}}
+	add := func(weight int, pool hegel.Generator[string], wanted bool) {
+		if wanted {
+			pools = append(pools, choice[string]{weight, pool})
+		} else {
+			pools[0].weight += weight
+		}
+	}
+	add(10, emojiText, !o.noEmoji)
+	add(20, csiSeqs, !o.noSeq)
+	add(8, oscBels, !o.noSeq)
+	add(7, oscSTs, !o.noSeq && !o.noST)
+	n := o.maxPieces
+	if n == 0 {
+		n = 8
+	}
+	return joined(many(weighted(pools...), 0, n))
+}
+
+var (
+	fullStrs  = strs(strOpts{})
+	truncStrs = strs(strOpts{maxPieces: 6})
+)
+
+func hasEmojiSeq(s string) bool {
+	for _, p := range emojiPieces {
+		if strings.Contains(s, p) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasBox(s string) bool {
+	for _, r := range s {
+		if isBox(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// widthOptions: the East Asian and narrow-border settings, each on 30% of the time.
+var widthOptions = hegel.Composite(func(tc hegel.TestCase) widthOpts {
+	return widthOpts{ea: hegel.Draw(tc, chance(30)), narrow: hegel.Draw(tc, chance(30))}
+})
+
+// tabWidths: the tab width set for a case: the fixed tabW (0) half of the time, else 1 to 8,
+// so that Width's cache holds widths computed under another tab width (tablewriter/2); under
+// HEGEL_NO_KNOWN=1 always tabW.
+var tabWidths = shaped(maybe(50, hegel.Integers(1, 8)), hegel.Just(0))
+
+// widthCase: the options in force, the tab width, the string measured and the options
+// WidthWithOptions is asked for.
+type widthCase struct {
+	o     widthOpts
+	tab   int
+	s     string
+	other widthOpts
+}
+
+var widthCases = hegel.Composite(func(tc hegel.TestCase) widthCase {
+	return widthCase{
+		o:     hegel.Draw(tc, widthOptions),
+		tab:   hegel.Draw(tc, tabWidths),
+		s:     hegel.Draw(tc, fullStrs),
+		other: hegel.Draw(tc, widthOptions),
+	}
+})
+
+func TestHegelWidth(t *testing.T) {
+	c := newCollector(t)
+	defer func() { twwidth.SetTabWidth(tabW); setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		checkWidth(c, ht, hegel.Draw(ht, widthCases))
+	})
+}
+
+// checkWidth is the body of TestHegelWidth for one case: the tab width and the options set,
+// Width (twice, for the cache), WidthNoCache, WidthWithOptions and Filter against the model,
+// and the grapheme-aware string width where the switch is off.
+func checkWidth(c *collector, ht *hegel.T, k widthCase) {
+	o := k.o
+	o.tab = k.tab
+	if o.tab > 0 {
+		twwidth.SetTabWidth(o.tab)
+	} else {
+		twwidth.SetTabWidth(tabW)
+	}
+	setOpts(o)
+	s := k.s
+	want := width(s, o)
+	c.count("ea=" + boolStr(o.ea))
+	if strings.Contains(s, esc) {
+		c.count("with sequences")
+	}
+	if got := twwidth.Width(s); got != want {
+		c.failClass(ht, "Width", "Width(%q) %+v = %d, want %d", s, o, got, want)
+	}
+	if got := twwidth.Width(s); got != want {
+		c.failClass(ht, "Width cached", "Width(%q) %+v = %d on the second call, want %d", s, o, got, want)
+	}
+	if got := twwidth.WidthNoCache(s); got != want {
+		c.failClass(ht, "WidthNoCache", "WidthNoCache(%q) %+v = %d, want %d", s, o, got, want)
+	}
+	other := k.other
+	other.tab = o.tab
+	otherOpts := twwidth.Options{EastAsianWidth: other.ea, ForceNarrowBorders: other.narrow}
+	if got, w := twwidth.WidthWithOptions(s, otherOpts), width(s, other); got != w {
+		c.failClass(ht, "WidthWithOptions", "WidthWithOptions(%q, %+v) = %d, want %d", s, other, got, w)
+	}
+	if got, w := twwidth.Filter().ReplaceAllLiteralString(s, ""), stripSeq(s); got != w {
+		c.failClass(ht, "Filter", "Filter stripped %q to %q, want %q", s, got, w)
+	}
+	if !Known.widthPerRune && !strings.Contains(s, "\t") && !hasBox(s) {
+		dw := displaywidth.Options{EastAsianWidth: o.ea}
+		if got, w := twwidth.Width(s), dw.String(stripSeq(s)); got != w {
+			c.failClass(ht, "grapheme width", "Width(%q) %+v = %d, displaywidth.String gives %d", s, o, got, w)
+		}
+	}
+	if hasEmojiSeq(s) {
+		c.count("emoji sequence")
+	}
+}
+
+func boolStr(b bool) string {
+	if b {
+		return "true"
+	}
+	return "false"
+}
+
+var suffixes = []string{"", "", ".", "..", "...", "\u2026", "\u3042"}
+
+// truncWidths: the width Truncate is called with: 0 (the documented "suffix alone" case) a
+// fifth of the time, else -1 to 12.
+var truncWidths = weighted(choice[int]{20, hegel.Just(0)}, choice[int]{80, hegel.Integers(-1, 12)})
+
+// truncCase: the options, the string, the width and the suffix Truncate is called with;
+// twoArg calls the two-argument form when the suffix is empty.
+type truncCase struct {
+	o        widthOpts
+	s        string
+	maxWidth int
+	suffix   string
+	twoArg   bool
+}
+
+var truncCases = hegel.Composite(func(tc hegel.TestCase) truncCase {
+	return truncCase{
+		o:        hegel.Draw(tc, widthOptions),
+		s:        hegel.Draw(tc, truncStrs),
+		maxWidth: hegel.Draw(tc, truncWidths),
+		suffix:   hegel.Draw(tc, hegel.SampledFrom(suffixes)),
+		twoArg:   hegel.Draw(tc, chance(50)),
+	}
+})
+
+func TestHegelTruncate(t *testing.T) {
+	c := newCollector(t)
+	defer func() { setOpts(widthOpts{ea: true}); setOpts(widthOpts{}) }()
+	property(t, func(ht *hegel.T) {
+		checkTruncate(c, ht, hegel.Draw(ht, truncCases))
+	})
+}
+
+// checkTruncate is the body of TestHegelTruncate for one case: Truncate against the model, the
+// result no wider than the limit and no sequence left open.
+func checkTruncate(c *collector, ht *hegel.T, k truncCase) {
+	o, s, maxWidth, suffix := k.o, k.s, k.maxWidth, k.suffix
+	setOpts(o)
+	want := truncate(s, maxWidth, suffix, o)
+	var got string
+	if suffix == "" && k.twoArg {
+		got = twwidth.Truncate(s, maxWidth)
+	} else {
+		got = twwidth.Truncate(s, maxWidth, suffix)
+	}
+	sw := width(s, o)
+	switch {
+	case maxWidth < 0:
+		c.count("negative")
+	case sw <= maxWidth:
+		c.count("fits")
+	default:
+		c.count("truncated")
+	}
+	if got != want {
+		c.failClass(ht, "Truncate", "Truncate(%q, %d, %q) %+v = %q, want %q", s, maxWidth, suffix, o, got, want)
+		return
+	}
+	if maxWidth >= 0 && width(got, o) > maxWidth {
+		c.failClass(ht, "too wide", "Truncate(%q, %d, %q) %+v = %q, width %d", s, maxWidth, suffix, o, got, width(got, o))
+	}
+	if strings.Contains(s, esc) && maxWidth > 0 && sw > maxWidth && got != "" && strings.Contains(got, esc) && !strings.Contains(got, reset) {
+		c.failClass(ht, "no reset", "Truncate(%q, %d, %q) = %q leaves a sequence open", s, maxWidth, suffix, got)
+	}
+}
diff --git a/hegel/hegel_wrap_test.go b/hegel/hegel_wrap_test.go
new file mode 100644
index 0000000..9f25138
--- /dev/null
+++ b/hegel/hegel_wrap_test.go
@@ -0,0 +1,371 @@
+package hegel
+
+// Properties of pkg/twwarp: SplitWords, WrapWords (the minimum-raggedness partition, checked
+// against a brute-force optimum and an independent dynamic programme), WrapString and
+// WrapStringWithSpaces.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/olekukonko/tablewriter/pkg/twwarp"
+	"github.com/olekukonko/tablewriter/pkg/twwidth"
+	"hegel.dev/go/hegel"
+)
+
+const penalty = 100000 // twwarp's defaultPenalty
+
+var wordPool = []string{
+	"a", "bb", "ccc", "dddd", "eeeeee", "\u3042", "\u3042\u3042", "\u00E9", "xy\u0301", "1.5",
+	esc + "[31mred" + esc + "[0m", "ab" + esc + "[1m", "\u2500\u2500", "\U0001F600",
+}
+
+var spaceRuns = []string{" ", " ", "  ", "\t", "\n", "\r\n", " \t ", "\u3000", "\u00A0"}
+
+var blankTexts = []string{"", " ", "  ", "\t", " \n ", "\u3000", "\u3000\u3000\u3000", "     "}
+
+// lineCost is the raggedness the package minimises: for every line but the last, the square
+// of the slack (plus the penalty when the line overflows); the last line is free.
+func lineWidth(words []string, spc int) int {
+	w := 0
+	for i, x := range words {
+		if i > 0 {
+			w += spc
+		}
+		w += twwidth.Width(x)
+	}
+	return w
+}
+
+func partitionCost(lines [][]string, spc, lim int) int {
+	cost := 0
+	for i, l := range lines {
+		if i == len(lines)-1 {
+			break
+		}
+		d := lim - lineWidth(l, spc)
+		cost += d * d
+		if lineWidth(l, spc) > lim {
+			cost += penalty
+		}
+	}
+	return cost
+}
+
+// bestCost is the optimum by brute force over every partition whose last line fits (or is a
+// single word).
+func bestCost(words []string, spc, lim int) int {
+	n := len(words)
+	best := math.MaxInt
+	for mask := 0; mask < 1<<(n-1); mask++ {
+		var lines [][]string
+		start := 0
+		for i := 0; i < n-1; i++ {
+			if mask&(1<<i) != 0 {
+				lines = append(lines, words[start:i+1])
+				start = i + 1
+			}
+		}
+		lines = append(lines, words[start:])
+		last := lines[len(lines)-1]
+		if len(last) > 1 && lineWidth(last, spc) > lim {
+			continue
+		}
+		if c := partitionCost(lines, spc, lim); c < best {
+			best = c
+		}
+	}
+	return best
+}
+
+// wrapWords is an independent statement of the package's dynamic programme: the break after
+// word i is the first j minimising slack^2 (+ penalty) plus the cost from j; a tail that fits
+// costs nothing, and the last word ends the chain.
+func wrapWords(words []string, spc, lim int) [][]string {
+	n := len(words)
+	if n == 0 {
+		return nil
+	}
+	lengths := make([]int, n)
+	for i, w := range words {
+		lengths[i] = twwidth.Width(w)
+	}
+	cost := make([]int, n)
+	next := make([]int, n)
+	for i := n - 1; i >= 0; i-- {
+		if i == n-1 || lineWidth(words[i:], spc) <= lim {
+			cost[i] = 0
+			next[i] = n
+			continue
+		}
+		cost[i] = math.MaxInt32
+		for j := i + 1; j < n; j++ {
+			l := lineWidth(words[i:j], spc)
+			d := lim - l
+			c := d*d + cost[j]
+			if l > lim {
+				c += penalty
+			}
+			if c < cost[i] {
+				cost[i] = c
+				next[i] = j
+			}
+		}
+	}
+	var lines [][]string
+	for i := 0; i < n; i = next[i] {
+		lines = append(lines, words[i:next[i]])
+	}
+	return lines
+}
+
+func splitWords(s string) []string { return strings.FieldsFunc(s, unicode.IsSpace) }
+
+func maxWordWidth(words []string) int {
+	m := 0
+	for _, w := range words {
+		if x := twwidth.Width(w); x > m {
+			m = x
+		}
+	}
+	return m
+}
+
+func joinLines(lines [][]string) []string {
+	out := make([]string, 0, len(lines))
+	for _, l := range lines {
+		out = append(out, strings.Join(l, " "))
+	}
+	return out
+}
+
+// wrapString is the model of twwarp.WrapString.
+func wrapString(s string, lim int) ([]string, int) {
+	if s == " " {
+		return []string{" "}, lim
+	}
+	words := splitWords(s)
+	if len(words) == 0 {
+		return []string{""}, lim
+	}
+	if m := maxWordWidth(words); m > lim {
+		lim = m
+	}
+	return joinLines(wrapWords(words, 1, lim)), lim
+}
+
+// wrapStringWithSpaces is the model of twwarp.WrapStringWithSpaces. Under
+// Known.wrapSpacesByteSlice the core content ends one byte after the start of the last
+// non-space rune, as the package slices it, so a multi-byte last rune is split between the
+// core and the "trailing spaces".
+func wrapStringWithSpaces(s string, lim int) ([]string, int) {
+	if s == "" {
+		return []string{""}, lim
+	}
+	if strings.TrimSpace(s) == "" {
+		if w := twwidth.Width(s); w <= lim {
+			return []string{s}, w
+		}
+		if lim > 0 {
+			cw := 0
+			end := 0
+			for i, r := range s {
+				w := twwidth.Width(string(r))
+				if cw+w > lim {
+					break
+				}
+				cw += w
+				end = i + utf8.RuneLen(r)
+			}
+			return []string{s[:end]}, lim
+		}
+		return []string{""}, lim
+	}
+	first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+	end := last + 1
+	if !Known.wrapSpacesByteSlice {
+		_, size := utf8.DecodeRuneInString(s[last:])
+		end = last + size
+	}
+	leading, trailing, core := s[:first], s[end:], s[first:end]
+	words := splitWords(core)
+	if len(words) == 0 {
+		return []string{leading + trailing}, lim
+	}
+	cur := lim
+	if m := maxWordWidth(words); m > cur {
+		cur = m
+	}
+	lines := joinLines(wrapWords(words, 1, cur))
+	for i := range lines {
+		lines[i] = leading + lines[i]
+		if i == len(lines)-1 {
+			lines[i] += trailing
+		}
+	}
+	return lines, cur
+}
+
+func flatten(lines [][]string) []string {
+	var out []string
+	for _, l := range lines {
+		out = append(out, l...)
+	}
+	return out
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+var (
+	words     = hegel.SampledFrom(wordPool)
+	spaceRun  = hegel.SampledFrom(spaceRuns)
+	blankText = hegel.SampledFrom(blankTexts)
+	// limits: the wrapping decisions cluster at the small limits: -2 to 4 half of the time,
+	// else -2 to 14
+	limits = weighted(choice[int]{50, hegel.Integers(-2, 4)}, choice[int]{50, hegel.Integers(-2, 14)})
+)
+
+// wrapCase: up to eight words, the limit and the space count WrapWords is called with, and
+// the text the string functions see: the words between the gaps of a drawn tape of space
+// runs (recycled; none: single spaces), with a leading and a trailing run 30% of the time
+// each; 10% of the time a blank text instead.
+type wrapCase struct {
+	words       []string
+	lim, spc    int
+	lead, trail string
+	gaps        []string
+	blank       *string
+}
+
+// text renders the string the case wraps.
+func (k wrapCase) text() string {
+	if k.blank != nil {
+		return *k.blank
+	}
+	var b strings.Builder
+	b.WriteString(k.lead)
+	for i, w := range k.words {
+		if i > 0 {
+			b.WriteString(at(k.gaps, i-1, " "))
+		}
+		b.WriteString(w)
+	}
+	b.WriteString(k.trail)
+	return b.String()
+}
+
+var wrapCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	return wrapCase{
+		words: hegel.Draw(tc, many(words, 0, 8)),
+		lim:   hegel.Draw(tc, limits),
+		spc:   hegel.Draw(tc, hegel.Integers(0, 2)),
+		lead:  hegel.Draw(tc, maybe(30, spaceRun)),
+		gaps:  hegel.Draw(tc, many(spaceRun, 0, 7)),
+		trail: hegel.Draw(tc, maybe(30, spaceRun)),
+		blank: hegel.Draw(tc, optional(10, blankText)),
+	}
+})
+
+func TestHegelWrap(t *testing.T) {
+	c := newCollector(t)
+	setOpts(widthOpts{})
+	property(t, func(ht *hegel.T) {
+		checkWrap(c, ht, hegel.Draw(ht, wrapCases))
+	})
+}
+
+// checkWrap is the body of TestHegelWrap for one case: WrapWords (the words kept, the last line
+// fitting, the optimum cost, the exact partition), SplitWords, WrapString and
+// WrapStringWithSpaces against the models, and the lines within the returned limit.
+func checkWrap(c *collector, ht *hegel.T, k wrapCase) {
+	{
+		words, lim, spc := k.words, k.lim, k.spc
+		got := twwarp.WrapWords(words, spc, lim, penalty)
+		if len(words) == 0 {
+			if got != nil {
+				c.failClass(ht, "WrapWords empty", "WrapWords(nil) = %q", got)
+			}
+		} else {
+			if !sameStrings(flatten(got), words) {
+				c.failClass(ht, "WrapWords words", "WrapWords(%q, %d, %d) = %q loses or reorders words", words, spc, lim, got)
+				return
+			}
+			if last := got[len(got)-1]; len(last) > 1 && lineWidth(last, spc) > lim {
+				c.failClass(ht, "WrapWords last", "WrapWords(%q, %d, %d) = %q: the last line overflows", words, spc, lim, got)
+			}
+			if pc, bc := partitionCost(got, spc, lim), bestCost(words, spc, lim); pc != bc {
+				c.failClass(ht, "WrapWords optimum", "WrapWords(%q, %d, %d) = %q costs %d, the optimum is %d", words, spc, lim, got, pc, bc)
+			}
+			if want := wrapWords(words, spc, lim); !sameStrings(joinLines(got), joinLines(want)) {
+				c.failClass(ht, "WrapWords exact", "WrapWords(%q, %d, %d) = %q, want %q", words, spc, lim, got, want)
+			}
+			c.count("lines=" + itoa(len(got)))
+		}
+
+		s := k.text()
+		if sw := twwarp.SplitWords(s); !sameStrings(sw, splitWords(s)) {
+			c.failClass(ht, "SplitWords", "SplitWords(%q) = %q, want %q", s, sw, splitWords(s))
+		}
+		lines, gotLim := twwarp.WrapString(s, lim)
+		wantLines, wantLim := wrapString(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapString", "WrapString(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		for _, l := range lines {
+			if twwidth.Width(l) > gotLim && gotLim >= 0 && s != " " {
+				c.failClass(ht, "WrapString width", "WrapString(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+			}
+		}
+		lines, gotLim = twwarp.WrapStringWithSpaces(s, lim)
+		wantLines, wantLim = wrapStringWithSpaces(s, lim)
+		if !sameStrings(lines, wantLines) || gotLim != wantLim {
+			c.failClass(ht, "WrapStringWithSpaces", "WrapStringWithSpaces(%q, %d) = %q, %d; want %q, %d", s, lim, lines, gotLim, wantLines, wantLim)
+		}
+		if strings.TrimSpace(s) != "" {
+			first := strings.IndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			last := strings.LastIndexFunc(s, func(r rune) bool { return !unicode.IsSpace(r) })
+			_, size := utf8.DecodeRuneInString(s[last:])
+			lead, trail := s[:first], s[last+size:]
+			for i, l := range lines {
+				if !strings.HasPrefix(l, lead) || (i == len(lines)-1 && !strings.HasSuffix(l, trail)) {
+					c.failClass(ht, "WithSpaces preserved", "WrapStringWithSpaces(%q, %d) = %q: leading %q / trailing %q not preserved", s, lim, lines, lead, trail)
+					break
+				}
+				core := strings.TrimPrefix(l, lead)
+				if i == len(lines)-1 {
+					core = strings.TrimSuffix(core, trail)
+				}
+				if !Known.wrapSpacesByteSlice && twwidth.Width(core) > gotLim {
+					c.failClass(ht, "WithSpaces width", "WrapStringWithSpaces(%q, %d) line %q is wider than the returned limit %d", s, lim, l, gotLim)
+				}
+			}
+			if strings.Join(splitWords(strings.Join(lines, " ")), " ") != strings.Join(splitWords(s), " ") {
+				c.failClass(ht, "WithSpaces words", "WrapStringWithSpaces(%q, %d) = %q changes the words", s, lim, lines)
+			}
+		}
+	}
+}
+
+func itoa(n int) string {
+	if n < 0 {
+		return "-" + itoa(-n)
+	}
+	if n < 10 {
+		return string(rune('0' + n))
+	}
+	return itoa(n/10) + string(rune('0'+n%10))
+}
