+package version_test
+
+// Hegel property tests for github.com/hashicorp/go-version.
+//
+// The README says "Versions used with go-version must follow SemVer", so
+// the oracle for parsing and precedence is Semantic Versioning 2.0.0 — the
+// identifier-by-identifier precedence rules of item 11, implemented here as
+// a small model — extended the way the code documents for what the spec
+// does not have: any number of numeric segments compared left to right with
+// the shorter list extended by zeros, leading zeros and a `v` prefix
+// canonicalised away (String's doc comment), a pre-release without its
+// hyphen accepted by NewVersion but not by NewSemver. Constraints follow the
+// package's own rules (the README example plus the comments in
+// constraint.go): a comma-separated AND of `op version`, `=`/`!=` by
+// equality, the relational operators with the pre-release rule (a
+// constraint without a pre-release never matches a pre-release version; one
+// with a pre-release matches only pre-releases of the same core), and the
+// pessimistic `~>` in its RubyGems meaning (`~> 1.2.3` is `>= 1.2.3, < 1.3`,
+// `~> 1.2` is `>= 1.2, < 2`, the upstream tests' own table).
+//
+// Set GO_VERSION_COLLECT=1 to make the properties record mismatches instead
+// of failing and print them (shortest first) at the end of each test.
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/hashicorp/go-version"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("GO_VERSION_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The model.
+
+// hv is a version as go-version sees it: the numeric segments as written
+// (one or more), the pre-release identifiers and the build identifiers.
+type hv struct {
+	segs      []int64
+	pre, meta []string
+}
+
+// padded is the segment list with at least three entries.
+func (a hv) padded() []int64 {
+	out := append([]int64(nil), a.segs...)
+	for len(out) < 3 {
+		out = append(out, 0)
+	}
+	return out
+}
+
+func (a hv) canon() string {
+	parts := make([]string, 0, 3)
+	for _, s := range a.padded() {
+		parts = append(parts, strconv.FormatInt(s, 10))
+	}
+	s := strings.Join(parts, ".")
+	if len(a.pre) > 0 {
+		s += "-" + strings.Join(a.pre, ".")
+	}
+	if len(a.meta) > 0 {
+		s += "+" + strings.Join(a.meta, ".")
+	}
+	return s
+}
+
+func (a hv) core() hv {
+	return hv{segs: a.padded()[:3]}
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func cmpInt[T int64 | int](a, b T) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+// cmpIdent orders two pre-release identifiers per spec item 11.
+func cmpIdent(a, b string) int {
+	an, bn := isNumeric(a), isNumeric(b)
+	switch {
+	case an && bn:
+		if d := cmpInt(len(a), len(b)); d != 0 {
+			return d
+		}
+		return strings.Compare(a, b)
+	case an:
+		return -1
+	case bn:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+// cmpSegs compares two segment lists left to right, the shorter extended
+// with zeros (the documented behaviour for versions of differing length).
+func cmpSegs(a, b []int64) int {
+	for i := 0; i < len(a) || i < len(b); i++ {
+		var x, y int64
+		if i < len(a) {
+			x = a[i]
+		}
+		if i < len(b) {
+			y = b[i]
+		}
+		if d := cmpInt(x, y); d != 0 {
+			return d
+		}
+	}
+	return 0
+}
+
+func (a hv) cmp(b hv) int {
+	if d := cmpSegs(a.segs, b.segs); d != 0 {
+		return d
+	}
+	switch {
+	case len(a.pre) == 0 && len(b.pre) == 0:
+		return 0
+	case len(a.pre) == 0:
+		return 1
+	case len(b.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(a.pre) && i < len(b.pre); i++ {
+		if d := cmpIdent(a.pre[i], b.pre[i]); d != 0 {
+			return d
+		}
+	}
+	return cmpInt(len(a.pre), len(b.pre))
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+const (
+	alnumChars    = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	nonDigitChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+)
+
+// genSegment draws a numeric segment: mostly tiny (so versions collide),
+// sometimes up to a thousand, sometimes anywhere in int64 including the top.
+func genSegment(tc hegel.TestCase) int64 {
+	switch n(tc, 0, 9) {
+	case 0:
+		return math.MaxInt64
+	case 1:
+		return wide(tc, 0, math.MaxInt64)
+	case 2, 3:
+		return int64(n(tc, 0, 1000))
+	}
+	return int64(n(tc, 0, 3))
+}
+
+// genNumericIdent draws a numeric pre-release identifier without leading
+// zeros (the spec's rule; leading zeros are pinned, go-version/3), of any
+// size including beyond int64.
+func genNumericIdent(tc hegel.TestCase) string {
+	switch n(tc, 0, 5) {
+	case 0:
+		return "1" + strings.Repeat("0", n(tc, 19, 22))
+	case 1:
+		return strconv.FormatInt(wide(tc, 0, math.MaxInt64), 10)
+	}
+	return strconv.Itoa(n(tc, 0, 12))
+}
+
+// genAlnumIdent draws an alphanumeric identifier: 1–5 characters from
+// [0-9A-Za-z-] with at least one non-digit.
+func genAlnumIdent(tc hegel.TestCase) string {
+	k := n(tc, 1, 5)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = alnumChars[n(tc, 0, len(alnumChars)-1)]
+	}
+	if isNumeric(string(b)) {
+		b[n(tc, 0, k-1)] = nonDigitChars[n(tc, 0, len(nonDigitChars)-1)]
+	}
+	return string(b)
+}
+
+func genPreIdent(tc hegel.TestCase) string {
+	if chance(tc, 50) {
+		return genNumericIdent(tc)
+	}
+	return genAlnumIdent(tc)
+}
+
+// genMetaIdent draws a build identifier: any non-empty run of [0-9A-Za-z-].
+func genMetaIdent(tc hegel.TestCase) string {
+	k := n(tc, 1, 5)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = alnumChars[n(tc, 0, len(alnumChars)-1)]
+	}
+	return string(b)
+}
+
+func genIdents(tc hegel.TestCase, lo, hi int, gen func(hegel.TestCase) string) []string {
+	k := n(tc, lo, hi)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = gen(tc)
+	}
+	return out
+}
+
+// genVersion draws a version with one to five segments (three most of the
+// time). Pre-releases are drawn only for versions of at most three
+// segments: with four or more, go-version ignores the pre-release when the
+// other version has a different number of segments (go-version/2).
+func genVersion(tc hegel.TestCase) hv {
+	k := 3
+	switch n(tc, 0, 9) {
+	case 0:
+		k = n(tc, 1, 2)
+	case 1:
+		k = n(tc, 4, 5)
+	}
+	v := hv{segs: make([]int64, k)}
+	for i := range v.segs {
+		v.segs[i] = genSegment(tc)
+	}
+	if k <= 3 && chance(tc, 40) {
+		v.pre = genIdents(tc, 1, 3, genPreIdent)
+	}
+	if chance(tc, 25) {
+		v.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return v
+}
+
+// genRelated draws a version close to a: usually the same segments, a
+// pre-release derived from a's, independent metadata.
+func genRelated(tc hegel.TestCase, a hv) hv {
+	b := hv{segs: append([]int64(nil), a.segs...)}
+	switch n(tc, 0, 5) {
+	case 0:
+		b = genVersion(tc)
+		b.pre = nil
+	case 1:
+		i := n(tc, 0, len(b.segs)-1)
+		if chance(tc, 50) && b.segs[i] > 0 {
+			b.segs[i]--
+		} else if b.segs[i] < math.MaxInt64 {
+			b.segs[i]++
+		}
+	case 2:
+		// Same value, different number of segments (trailing zeros).
+		if chance(tc, 50) && len(b.segs) > 1 && b.segs[len(b.segs)-1] == 0 {
+			b.segs = b.segs[:len(b.segs)-1]
+		} else if len(b.segs) < 5 {
+			b.segs = append(b.segs, 0)
+		}
+	}
+	if len(b.segs) <= 3 {
+		switch n(tc, 0, 5) {
+		case 0:
+			// no pre-release
+		case 1:
+			b.pre = genIdents(tc, 1, 3, genPreIdent)
+		case 2:
+			if len(a.pre) > 0 {
+				b.pre = append([]string(nil), a.pre[:len(a.pre)-1]...)
+			}
+		case 3:
+			b.pre = append(append([]string(nil), a.pre...), genPreIdent(tc))
+		case 4:
+			b.pre = append([]string(nil), a.pre...)
+			if len(b.pre) > 0 {
+				b.pre[n(tc, 0, len(b.pre)-1)] = genPreIdent(tc)
+			}
+		default:
+			b.pre = append([]string(nil), a.pre...)
+			if len(b.pre) > 0 {
+				i := n(tc, 0, len(b.pre)-1)
+				if chance(tc, 50) {
+					b.pre[i] = strings.ToUpper(b.pre[i])
+				} else {
+					b.pre[i] = strings.ToLower(b.pre[i])
+				}
+			}
+		}
+	}
+	if chance(tc, 30) {
+		b.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return b
+}
+
+// pinnedPair reports whether comparing a and b hits a pinned shape:
+// go-version/1 (one pre-release a proper prefix of the other with an
+// alphanumeric identifier next: `alpha` vs `alpha.beta`) or go-version/2 (a
+// pre-release on either side with a different number of segments).
+func pinnedPair(a, b hv) bool {
+	if (len(a.pre) > 0 || len(b.pre) > 0) && len(a.padded()) != len(b.padded()) {
+		return true
+	}
+	short, long := a.pre, b.pre
+	if len(short) > len(long) {
+		short, long = long, short
+	}
+	if len(short) == 0 || len(short) == len(long) {
+		return false
+	}
+	for i := range short {
+		if short[i] != long[i] {
+			return false
+		}
+	}
+	return !isNumeric(long[len(short)])
+}
+
+// ---------------------------------------------------------------------------
+// Checks shared by the version properties.
+
+func checkParts(ht *hegel.T, what, text string, v *version.Version, m hv) {
+	pre := strings.Join(m.pre, ".")
+	meta := strings.Join(m.meta, ".")
+	if fmt.Sprint(v.Segments64()) != fmt.Sprint(m.padded()) || v.Prerelease() != pre || v.Metadata() != meta {
+		fail(ht, "%s(%q): segments %v pre %q meta %q, want %v pre %q meta %q",
+			what, text, v.Segments64(), v.Prerelease(), v.Metadata(), m.padded(), pre, meta)
+	}
+	if v.Original() != text {
+		fail(ht, "%s(%q).Original() = %q", what, text, v.Original())
+	}
+	if v.String() != m.canon() {
+		fail(ht, "%s(%q).String() = %q, want %q", what, text, v.String(), m.canon())
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property: versions parse, print canonically and survive every round trip.
+
+func TestHegelVersionsParseAndPrint(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		canon := m.canon()
+
+		// A loose spelling of the same version: the segments as written
+		// (not padded), sometimes zero-padded, a `v` prefix, the hyphen
+		// before an alphabetic pre-release dropped.
+		parts := make([]string, len(m.segs))
+		zeros := false
+		for i, s := range m.segs {
+			parts[i] = strconv.FormatInt(s, 10)
+			if chance(ht, 20) {
+				parts[i] = strings.Repeat("0", n(ht, 1, 2)) + parts[i]
+				zeros = true
+			}
+		}
+		loose := strings.Join(parts, ".")
+		hyphenless := false
+		if len(m.pre) > 0 {
+			// Only a letter-first pre-release can drop the hyphen: a
+			// hyphen-first identifier would be read as the separator.
+			first := m.pre[0][0]
+			letter := first >= 'A' && first <= 'Z' || first >= 'a' && first <= 'z'
+			if chance(ht, 30) && letter {
+				hyphenless = true
+				loose += strings.Join(m.pre, ".")
+			} else {
+				loose += "-" + strings.Join(m.pre, ".")
+			}
+		}
+		if len(m.meta) > 0 {
+			loose += "+" + strings.Join(m.meta, ".")
+		}
+		vPrefixed := chance(ht, 30)
+		if vPrefixed {
+			loose = "v" + loose
+		}
+		note(ht, "canonical %q loose %q", canon, loose)
+
+		v, err := version.NewVersion(canon)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", canon, err)
+			return
+		}
+		checkParts(ht, "NewVersion", canon, v, m)
+
+		lv, err := version.NewVersion(loose)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", loose, err)
+			return
+		}
+		checkParts(ht, "NewVersion", loose, lv, m)
+		if !v.Equal(lv) || v.Compare(lv) != 0 || lv.Compare(v) != 0 {
+			fail(ht, "%q and %q parse unequal", canon, loose)
+		}
+
+		// NewSemver: the canonical text of a three-segment version is a
+		// semver; a pre-release without its hyphen is not. (Leading zeros,
+		// the v prefix and other segment counts are pinned, go-version/4.)
+		if len(m.segs) == 3 {
+			sv, err := version.NewSemver(canon)
+			if err != nil {
+				fail(ht, "NewSemver(%q): %v", canon, err)
+			} else {
+				checkParts(ht, "NewSemver", canon, sv, m)
+			}
+		}
+		if hyphenless && !zeros && !vPrefixed && len(m.segs) == 3 {
+			if sv, err := version.NewSemver(loose); err == nil {
+				fail(ht, "NewSemver(%q) accepted a pre-release without its hyphen: %v", loose, sv)
+			}
+		}
+
+		// Must, Core, the text and SQL round trips.
+		if mp := version.Must(version.NewVersion(loose)); mp.String() != canon {
+			fail(ht, "Must(NewVersion(%q)).String() = %q", loose, mp.String())
+		}
+		if c := v.Core(); c.String() != m.core().canon() || c.Prerelease() != "" || c.Metadata() != "" {
+			fail(ht, "Core(%q) = %q, want %q", canon, c.String(), m.core().canon())
+		}
+		tb, err := v.MarshalText()
+		if err != nil || string(tb) != canon {
+			fail(ht, "MarshalText(%q) = %q, %v", canon, tb, err)
+		}
+		var tback version.Version
+		if err := tback.UnmarshalText([]byte(loose)); err != nil || tback.String() != canon || tback.Original() != loose {
+			fail(ht, "UnmarshalText(%q) = %q (%q), %v", loose, tback.String(), tback.Original(), err)
+		}
+		val, err := v.Value()
+		if err != nil || val != canon {
+			fail(ht, "Value(%q) = %v, %v", canon, val, err)
+		}
+		var sc version.Version
+		if err := sc.Scan(loose); err != nil || sc.String() != canon {
+			fail(ht, "Scan(%q) = %q, %v", loose, sc.String(), err)
+		}
+		if rv, err := version.NewVersion(v.String()); err != nil || !rv.Equal(v) || rv.String() != canon {
+			fail(ht, "NewVersion(String(%q)) = %v, %v", canon, rv, err)
+		}
+
+		// WithPrefix: a custom prefix is validated, stripped and reported.
+		prefix := pick(ht, []string{"deployment-", "controller-", "x-", "release/", "azure-cli-v", "V"})
+		pv, err := version.NewVersion(prefix+loose, version.WithPrefix(prefix))
+		if err != nil {
+			fail(ht, "NewVersion(%q, WithPrefix(%q)): %v", prefix+loose, prefix, err)
+		} else {
+			checkParts(ht, "NewVersion[prefix]", prefix+loose, pv, m)
+			if pv.Prefix() != prefix {
+				fail(ht, "Prefix() = %q, want %q", pv.Prefix(), prefix)
+			}
+			if !pv.Equal(v) {
+				fail(ht, "%q with prefix %q is not Equal to %q", prefix+loose, prefix, canon)
+			}
+		}
+		if _, err := version.NewVersion(loose, version.WithPrefix(prefix)); err == nil && !strings.HasPrefix(loose, prefix) {
+			fail(ht, "NewVersion(%q, WithPrefix(%q)) accepted a text without the prefix", loose, prefix)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed versions are refused by both parsers, with a nil
+// result.
+
+func TestHegelMalformedVersionsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		s := m.canon()
+		segs := make([]string, 0, 5)
+		for _, x := range m.padded() {
+			segs = append(segs, strconv.FormatInt(x, 10))
+		}
+		tail := ""
+		if len(m.pre) > 0 {
+			tail += "-" + strings.Join(m.pre, ".")
+		}
+		if len(m.meta) > 0 {
+			tail += "+" + strings.Join(m.meta, ".")
+		}
+		var text, what string
+		switch n(ht, 0, 11) {
+		case 0:
+			what, text = "empty", ""
+		case 1:
+			what, text = "surrounding blank", pick(ht, []string{" " + s, s + " ", " " + s + " ", "\t" + s})
+		case 2:
+			what, text = "V prefix", "V"+s
+		case 3:
+			what, text = "empty segment", pick(ht, []string{"." + s, strings.Join(segs, "..") + tail, segs[0] + ".." + strings.Join(segs[1:], ".") + tail})
+		case 4:
+			// An empty pre-release identifier in the middle or at the end
+			// (a leading one is pinned, go-version/6).
+			pre := append([]string(nil), m.pre...)
+			if len(pre) == 0 {
+				pre = []string{genPreIdent(ht)}
+			}
+			i := n(ht, 1, len(pre))
+			pre = append(pre[:i], append([]string{""}, pre[i:]...)...)
+			what = "empty pre-release identifier"
+			text = strings.Join(segs, ".") + "-" + strings.Join(pre, ".")
+			if len(m.meta) > 0 {
+				text += "+" + strings.Join(m.meta, ".")
+			}
+		case 5:
+			meta := append([]string(nil), m.meta...)
+			if len(meta) == 0 {
+				meta = []string{genMetaIdent(ht)}
+			}
+			i := n(ht, 0, len(meta))
+			meta = append(meta[:i], append([]string{""}, meta[i:]...)...)
+			what = "empty build identifier"
+			text = strings.Join(segs, ".")
+			if len(m.pre) > 0 {
+				text += "-" + strings.Join(m.pre, ".")
+			}
+			text += "+" + strings.Join(meta, ".")
+		case 6:
+			ch := pick(ht, []string{" ", "_", "!", "/", ":", "\n", "α", "١", "。", "\x00", "*", "?"})
+			i := n(ht, 0, len(s))
+			what, text = fmt.Sprintf("character %q inserted", ch), s[:i]+ch+s[i:]
+		case 7:
+			what, text = "sign prefix", pick(ht, []string{"-", "+"})+s
+		case 8:
+			i := n(ht, 0, len(segs)-1)
+			segs[i] = "9223372036854775808"
+			what, text = "segment beyond int64", strings.Join(segs, ".")+tail
+		case 9:
+			what = "second plus"
+			text = strings.Join(segs, ".")
+			if len(m.pre) > 0 {
+				text += "-" + strings.Join(m.pre, ".")
+			}
+			text += "+" + genMetaIdent(ht) + "+" + genMetaIdent(ht)
+		case 10:
+			what, text = "trailing plus", s+"+"
+		default:
+			what, text = "trailing dot", s+"."
+		}
+		note(ht, "%s: %q", what, text)
+
+		if v, err := version.NewVersion(text); err == nil || v != nil {
+			fail(ht, "NewVersion(%q) [%s] accepted as %v (err %v)", text, what, v, err)
+		}
+		if v, err := version.NewSemver(text); err == nil || v != nil {
+			fail(ht, "NewSemver(%q) [%s] accepted as %v (err %v)", text, what, v, err)
+		}
+		var tv version.Version
+		if err := tv.UnmarshalText([]byte(text)); err == nil {
+			fail(ht, "UnmarshalText(%q) [%s] accepted as %q", text, what, tv.String())
+		}
+		var sv version.Version
+		if err := sv.Scan(text); err == nil {
+			fail(ht, "Scan(%q) [%s] accepted as %q", text, what, sv.String())
+		}
+		func() {
+			defer func() {
+				if recover() == nil {
+					fail(ht, "Must(NewVersion(%q)) [%s] did not panic", text, what)
+				}
+			}()
+			version.Must(version.NewVersion(text))
+		}()
+	})
+}
