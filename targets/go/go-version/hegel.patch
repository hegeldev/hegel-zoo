+// ---------------------------------------------------------------------------
+// Property: precedence follows the spec (segments zero-extended); Collection
+// sorts by it.
+
+func TestHegelPrecedenceFollowsSemver(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := genVersion(ht)
+		b := genRelated(ht, a)
+		for pinnedPair(a, b) {
+			b = genRelated(ht, a)
+		}
+		note(ht, "a %q  b %q", a.canon(), b.canon())
+		va := version.Must(version.NewVersion(a.canon()))
+		vb := version.Must(version.NewVersion(b.canon()))
+		want := a.cmp(b)
+		if got := va.Compare(vb); got != want {
+			fail(ht, "Compare(%q, %q) = %d, want %d", a.canon(), b.canon(), got, want)
+		}
+		if got := vb.Compare(va); got != -want {
+			fail(ht, "Compare(%q, %q) = %d, want %d", b.canon(), a.canon(), got, -want)
+		}
+		if va.LessThan(vb) != (want < 0) || va.LessThanOrEqual(vb) != (want <= 0) ||
+			va.GreaterThan(vb) != (want > 0) || va.GreaterThanOrEqual(vb) != (want >= 0) ||
+			va.Equal(vb) != (want == 0) {
+			fail(ht, "%q vs %q: LessThan %v LessThanOrEqual %v GreaterThan %v GreaterThanOrEqual %v Equal %v, Compare %d",
+				a.canon(), b.canon(), va.LessThan(vb), va.LessThanOrEqual(vb), va.GreaterThan(vb), va.GreaterThanOrEqual(vb), va.Equal(vb), want)
+		}
+
+		// A handful of related versions sort into model order.
+		k := n(ht, 2, 6)
+		models := []hv{a, b}
+		for len(models) < k {
+			c := genRelated(ht, pick(ht, models))
+			ok := true
+			for _, m := range models {
+				ok = ok && !pinnedPair(m, c)
+			}
+			if !ok {
+				break
+			}
+			models = append(models, c)
+		}
+		coll := make(version.Collection, len(models))
+		for i, m := range models {
+			coll[i] = version.Must(version.NewVersion(m.canon()))
+		}
+		sort.Sort(coll)
+		got := make([]string, len(coll))
+		for i, v := range coll {
+			got[i] = v.Original()
+		}
+		byText := map[string]hv{}
+		for _, m := range models {
+			byText[m.canon()] = m
+		}
+		for i := 1; i < len(got); i++ {
+			if byText[got[i-1]].cmp(byText[got[i]]) > 0 {
+				fail(ht, "Collection sorted %q before %q (of %v)", got[i-1], got[i], got)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: model and generators.
+
+type comparator struct {
+	op   string
+	ver  hv
+	text string
+}
+
+// preCheck is constraint.go's pre-release rule: a constraint without a
+// pre-release never matches a pre-release version; one with a pre-release
+// matches only pre-release versions of the same segments.
+func preCheck(v, c hv) bool {
+	vPre, cPre := len(v.pre) > 0, len(c.pre) > 0
+	switch {
+	case cPre && vPre:
+		return fmt.Sprint(v.padded()) == fmt.Sprint(c.padded())
+	case !cPre && vPre:
+		return false
+	}
+	return true
+}
+
+func (c comparator) holds(v hv) bool {
+	d := v.cmp(c.ver)
+	switch c.op {
+	case "", "=":
+		return d == 0
+	case "!=":
+		return d != 0
+	case ">":
+		return preCheck(v, c.ver) && d > 0
+	case ">=":
+		return preCheck(v, c.ver) && d >= 0
+	case "<":
+		return preCheck(v, c.ver) && d < 0
+	case "<=":
+		return preCheck(v, c.ver) && d <= 0
+	case "~>":
+		// RubyGems: `~> a.b.c` is `>= a.b.c` with the segments before the
+		// last one written fixed; with a pre-release only pre-releases.
+		if !preCheck(v, c.ver) || len(c.ver.pre) > 0 && len(v.pre) == 0 {
+			return false
+		}
+		if d < 0 {
+			return false
+		}
+		vp := v.padded()
+		k := len(c.ver.segs)
+		for i := 0; i < k-1; i++ {
+			var x int64
+			if i < len(vp) {
+				x = vp[i]
+			}
+			if x != c.ver.segs[i] {
+				return false
+			}
+		}
+		return true
+	}
+	panic("operator " + c.op)
+}
+
+type constraintModel struct {
+	comps []comparator
+	text  string
+}
+
+func (c constraintModel) satisfied(v hv) bool {
+	for _, cc := range c.comps {
+		if !cc.holds(v) {
+			return false
+		}
+	}
+	return true
+}
+
+var ops = []string{"", "=", "!=", ">", ">=", "<", "<=", "~>"}
+
+// genConstraintVersion draws a comparator version: one to four segments
+// (pre-release only with three or fewer), small numbers so that the checked
+// versions land on the boundaries.
+func genConstraintVersion(tc hegel.TestCase, op string) hv {
+	k := 3
+	switch n(tc, 0, 9) {
+	case 0, 1:
+		k = n(tc, 1, 2)
+	case 2:
+		k = 4
+	}
+	if op == "~>" && k == 1 {
+		// `~> 1` is pinned (go-version/5).
+		k = 2
+	}
+	v := hv{segs: make([]int64, k)}
+	for i := range v.segs {
+		v.segs[i] = int64(n(tc, 0, 3))
+	}
+	if k <= 3 && chance(tc, 25) {
+		v.pre = pick(tc, [][]string{{"0"}, {"alpha"}, {"beta", "2"}, {"rc", "1"}, {"-"}, {"a-b"}, {"RC"}})
+	}
+	if chance(tc, 10) {
+		v.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return v
+}
+
+// written is the version as written in the constraint: segments as given
+// (not padded), an optional v prefix and zero-padding.
+func written(tc hegel.TestCase, v hv) string {
+	parts := make([]string, len(v.segs))
+	for i, s := range v.segs {
+		parts[i] = strconv.FormatInt(s, 10)
+		if chance(tc, 10) {
+			parts[i] = "0" + parts[i]
+		}
+	}
+	s := strings.Join(parts, ".")
+	if len(v.pre) > 0 {
+		s += "-" + strings.Join(v.pre, ".")
+	}
+	if len(v.meta) > 0 {
+		s += "+" + strings.Join(v.meta, ".")
+	}
+	if chance(tc, 15) {
+		s = "v" + s
+	}
+	return s
+}
+
+func blanks(tc hegel.TestCase) string { return pick(tc, []string{"", " ", "  ", "\t"}) }
+
+func genConstraint(tc hegel.TestCase) constraintModel {
+	var c constraintModel
+	k := n(tc, 1, 3)
+	if chance(tc, 50) {
+		k = 1
+	}
+	for i := 0; i < k; i++ {
+		op := pick(tc, ops)
+		v := genConstraintVersion(tc, op)
+		cc := comparator{op: op, ver: v, text: blanks(tc) + op + blanks(tc) + written(tc, v) + blanks(tc)}
+		c.comps = append(c.comps, cc)
+		if i > 0 {
+			c.text += ","
+		}
+		c.text += cc.text
+	}
+	return c
+}
+
+// pinnedCheck reports whether checking v against the comparator hits a
+// pinned shape: equal segments (by zero extension) written with a different
+// number of segments, with a pre-release on either side (go-version/2) or
+// under `~>` with the longer spelling in the constraint (go-version/8).
+func pinnedCheck(v hv, cc comparator) bool {
+	if len(v.padded()) == len(cc.ver.padded()) || cmpSegs(v.segs, cc.ver.segs) != 0 {
+		return false
+	}
+	if len(v.pre) > 0 || len(cc.ver.pre) > 0 {
+		return true
+	}
+	return cc.op == "~>" && len(cc.ver.padded()) > len(v.padded())
+}
+
+// genCheckVersion draws a version near the constraint's own, avoiding the
+// pinned shapes (a far-away version if twenty draws could not).
+func genCheckVersion(tc hegel.TestCase, c constraintModel) hv {
+	for tries := 0; tries < 20; tries++ {
+		v := drawCheckVersion(tc, c)
+		pinned := false
+		for _, cc := range c.comps {
+			pinned = pinned || pinnedCheck(v, cc)
+		}
+		if !pinned {
+			return v
+		}
+	}
+	return hv{segs: []int64{9, 9, 9}}
+}
+
+func drawCheckVersion(tc hegel.TestCase, c constraintModel) hv {
+	base := pick(tc, c.comps).ver
+	v := hv{segs: append([]int64(nil), base.segs...)}
+	if chance(tc, 30) {
+		k := n(tc, 1, 4)
+		v.segs = make([]int64, k)
+		for i := range v.segs {
+			v.segs[i] = int64(n(tc, 0, 4))
+		}
+	} else {
+		for i := range v.segs {
+			switch n(tc, 0, 4) {
+			case 0:
+				if v.segs[i] > 0 {
+					v.segs[i]--
+				}
+			case 1:
+				v.segs[i]++
+			}
+		}
+		switch n(tc, 0, 5) {
+		case 0:
+			if len(v.segs) < 5 {
+				v.segs = append(v.segs, int64(n(tc, 0, 2)))
+			}
+		case 1:
+			if len(v.segs) > 1 {
+				v.segs = v.segs[:len(v.segs)-1]
+			}
+		}
+	}
+	if len(v.segs) <= 3 && chance(tc, 35) {
+		v.pre = pick(tc, [][]string{{"0"}, {"alpha"}, {"beta", "2"}, {"rc", "1"}, {"-"}, {"a-b"}, {"RC"}})
+	}
+	if chance(tc, 15) {
+		v.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Property: constraints follow the package's rules.
+
+func TestHegelConstraintsFollowTheirRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := genConstraint(ht)
+		v := genCheckVersion(ht, c)
+		note(ht, "constraint %q version %q", c.text, v.canon())
+
+		cs, err := version.NewConstraint(c.text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", c.text, err)
+			return
+		}
+		if len(cs) != len(c.comps) {
+			fail(ht, "NewConstraint(%q) has %d constraints, want %d", c.text, len(cs), len(c.comps))
+			return
+		}
+		sv := version.Must(version.NewVersion(v.canon()))
+		want := c.satisfied(v)
+		got := cs.Check(sv)
+		if got != want {
+			fail(ht, "%q.Check(%q) = %v, want %v", c.text, v.canon(), got, want)
+		}
+		for i, cc := range c.comps {
+			if g, w := cs[i].Check(sv), cc.holds(v); g != w {
+				fail(ht, "constraint %q (of %q).Check(%q) = %v, want %v", cc.text, c.text, v.canon(), g, w)
+			}
+			if cs[i].Prerelease() != (len(cc.ver.pre) > 0) {
+				fail(ht, "constraint %q.Prerelease() = %v", cc.text, cs[i].Prerelease())
+			}
+			if cs[i].String() != cc.text {
+				fail(ht, "constraint %q.String() = %q", cc.text, cs[i].String())
+			}
+		}
+
+		// The printed constraints read back the same.
+		text := cs.String()
+		cs2, err := version.NewConstraint(text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q) (String of %q): %v", text, c.text, err)
+			return
+		}
+		if g2 := cs2.Check(sv); g2 != got {
+			fail(ht, "%q reprinted as %q: Check(%q) %v vs %v", c.text, text, v.canon(), g2, got)
+		}
+		if !cs.Equals(cs2) || !cs2.Equals(cs) {
+			fail(ht, "%q is not Equals to its own String %q", c.text, text)
+		}
+
+		// Equals ignores whitespace, the `v` prefix and zero padding, and
+		// the order of the constraints.
+		perm := make([]comparator, len(c.comps))
+		copy(perm, c.comps)
+		for i := len(perm) - 1; i > 0; i-- {
+			j := n(ht, 0, i)
+			perm[i], perm[j] = perm[j], perm[i]
+		}
+		var alt []string
+		for _, cc := range perm {
+			op := cc.op
+			if op == "" && chance(ht, 50) {
+				op = "="
+			}
+			alt = append(alt, blanks(ht)+op+blanks(ht)+written(ht, cc.ver)+blanks(ht))
+		}
+		altText := strings.Join(alt, ",")
+		cs3, err := version.NewConstraint(altText)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", altText, err)
+			return
+		}
+		if !cs.Equals(cs3) {
+			fail(ht, "%q is not Equals to %q", c.text, altText)
+		}
+		if g3 := cs3.Check(sv); g3 != got {
+			fail(ht, "%q rewritten as %q: Check(%q) %v vs %v", c.text, altText, v.canon(), g3, got)
+		}
+		if mc := version.MustConstraints(version.NewConstraint(c.text)); mc.String() != text {
+			fail(ht, "MustConstraints(%q).String() = %q", c.text, mc.String())
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins for the known bugs. Each is expected to fail at the pinned commit.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func mustV(s string) *version.Version { return version.Must(version.NewVersion(s)) }
+
+func checkConstraint(t *testing.T, c, v string, want bool) {
+	t.Helper()
+	cs, err := version.NewConstraint(c)
+	if err != nil {
+		t.Errorf("NewConstraint(%q): %v", c, err)
+		return
+	}
+	if got := cs.Check(mustV(v)); got != want {
+		t.Errorf("%q.Check(%s) = %v, want %v", c, v, got, want)
+	}
+}
+
+// go-version/1: comparePart treats a missing identifier as greater than an
+// alphanumeric one, so 1.0.0-alpha > 1.0.0-alpha.beta, where the spec's own
+// example (item 11) has 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta:
+// "a larger set of pre-release fields has a higher precedence than a
+// smaller set, if all of the preceding identifiers are equal". The upstream
+// table asserts the inverted order for "5.4-alpha" vs "5.4-alpha.beta".
+func TestHegelPinShorterPrereleaseIsLower(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-alpha", "1.0.0-alpha.beta", -1},
+		{"1.0.0-alpha", "1.0.0-alpha.1", -1},
+		{"1.0.0-rc.1", "1.0.0-rc.1.x", -1},
+	}
+	for _, c := range cases {
+		if got := mustV(c.a).Compare(mustV(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+}
+
+// go-version/2: Compare only looks at the pre-release when both versions
+// have the same number of segments, so 1.0.0-alpha equals 1.0.0.0 (and
+// 1.0.0.0-rc equals 1.0.0) while 1.0.0-alpha < 1.0.0 = 1.0.0.0 — the order
+// is not transitive, `= 1.0.0.0` matches 1.0.0-alpha, and a Collection with
+// both spellings sorts the pre-releases anywhere.
+func TestHegelPinPrereleaseCountsWhateverTheSegmentCount(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-alpha", "1.0.0.0", -1},
+		{"1.0.0.0-rc", "1.0.0", -1},
+		{"1.0-beta", "1.0.0.0", -1},
+	}
+	for _, c := range cases {
+		if got := mustV(c.a).Compare(mustV(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+	checkConstraint(t, "= 1.0.0.0", "1.0.0-alpha", false)
+	checkConstraint(t, "!= 1.0.0.0", "1.0.0-alpha", true)
+}
+
+// go-version/3: numeric pre-release identifiers may carry leading zeros
+// (the spec forbids them; both parsers accept them) and are then compared
+// by length: 1.0.0-01 > 1.0.0-2 and 1.0.0-01 > 1.0.0-1.
+func TestHegelPinLeadingZeroIdentifiersCompareByValue(t *testing.T) {
+	defer guard(t)
+	if got := mustV("1.0.0-01").Compare(mustV("1.0.0-2")); got != -1 {
+		t.Errorf("Compare(1.0.0-01, 1.0.0-2) = %d, want -1 (or a parse error)", got)
+	}
+	if got := mustV("1.0.0-01").Compare(mustV("1.0.0-1")); got != 0 {
+		t.Errorf("Compare(1.0.0-01, 1.0.0-1) = %d, want 0 (or a parse error)", got)
+	}
+}
+
+// go-version/4: NewSemver "adheres strictly to SemVer specs" but accepts a
+// `v` prefix, one, two or four segments, leading zeros in segments and in
+// numeric pre-release identifiers, and `~` in identifiers; the only thing
+// it rejects beyond NewVersion is a pre-release without its hyphen.
+func TestHegelPinNewSemverIsStrict(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"v1.2.3", "1.2", "1", "1.2.3.4", "01.2.3", "1.02.3", "1.2.3-01", "1.2.3-a~b", "1.2.3+~"} {
+		if v, err := version.NewSemver(s); err == nil {
+			t.Errorf("NewSemver(%q) = %v, want an error", s, v)
+		}
+	}
+}
+
+// go-version/5: the pessimistic operator with a single segment is
+// unbounded: `~> 1` matches 2.0.0 and 5.3.1 (RubyGems: `~> 1` is
+// `>= 1, < 2`, as `~> 1.0` is `>= 1.0, < 2.0` here too). The last-segment
+// check runs on the zero-padded patch instead of the written segment.
+func TestHegelPinPessimisticSingleSegmentIsBounded(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~> 1", "1.5.2", true)
+	checkConstraint(t, "~> 1", "2.0.0", false)
+	checkConstraint(t, "~> 1", "5.3.1", false)
+	checkConstraint(t, "~> 0", "1.0.0", false)
+}
+
+// go-version/6: a trailing hyphen is accepted by NewVersion and becomes a
+// pre-release identifier "-" (the optional separator of the alphabetic
+// alternative is left out and the hyphen is taken as the identifier):
+// NewVersion("1.2.3-") prints "1.2.3--", NewVersion("1.2.3-.a") has the
+// pre-release "-.a". NewSemver rejects both.
+func TestHegelPinTrailingHyphenIsMalformed(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"1.2.3-", "1.2.3-.a", "1.2-"} {
+		if v, err := version.NewVersion(s); err == nil {
+			t.Errorf("NewVersion(%q) = %q (pre-release %q), want an error", s, v.String(), v.Prerelease())
+		}
+	}
+}
+
+// go-version/7: Scan accepts a string and nil only; the []byte that
+// database/sql drivers commonly deliver for text columns (MySQL, SQLite) is
+// "cannot scan []uint8 as Version".
+func TestHegelPinScanAcceptsBytes(t *testing.T) {
+	defer guard(t)
+	var v version.Version
+	if err := v.Scan([]byte("1.2.3")); err != nil {
+		t.Errorf("Scan([]byte(\"1.2.3\")): %v", err)
+	} else if v.String() != "1.2.3" {
+		t.Errorf("Scan([]byte(\"1.2.3\")) = %q", v.String())
+	}
+}
+
+// go-version/8: a pessimistic constraint with more segments than the
+// version never matches, even when the version equals the constraint:
+// `~> 0.3.0.0` rejects 0.3.0 (= 0.3.0.0), although `~> 0.3.0` accepts
+// 0.3.0.0 and `= 0.3.0.0` accepts 0.3.0.
+func TestHegelPinPessimisticAcceptsShorterEqualVersion(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~> 0.3.0.0", "0.3.0", true)
+	checkConstraint(t, "~> 1.2.3.0", "1.2.3", true)
+	checkConstraint(t, "~> 1.2.3.0", "1.2.3.1", true)
+}
