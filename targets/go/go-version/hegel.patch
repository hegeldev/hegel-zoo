+package version_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged by the oracle of the wide
+// property that found it (hegel_test.go), so that each bug has a property
+// that finds it every run (the wide properties reach the shapes at their
+// natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region
+// the bug does not touch instead (a numeric identifier appended, the same
+// segment count, plain identifiers, the hyphen-less spelling, `~> N.M`, an
+// empty identifier after the first, a string for Scan) and passes.
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"testing"
+
+	"github.com/hashicorp/go-version"
+	"hegel.dev/go/hegel"
+)
+
+// verPair: two versions to order.
+type verPair struct{ a, b hv }
+
+func (p verPair) GoString() string { return fmt.Sprintf("a %q b %q", p.a.canon(), p.b.canon()) }
+
+// --------------------------------------------------------------------------- go-version/1
+
+// prefixPairs: a version with a pre-release beside the same version with
+// one identifier more, alphanumeric (go-version/1) or under HEGEL_NO_KNOWN=1
+// numeric; the shorter sorts lower either way.
+var prefixPairs = hegel.Composite(func(tc hegel.TestCase) verPair {
+	a := hv{segs: hegel.Draw(tc, segmentLists), pre: hegel.Draw(tc, specPreLists), meta: hegel.Draw(tc, maybe(25, metaLists))}
+	b := hv{segs: a.segs, pre: append(slices.Clone(a.pre), hegel.Draw(tc, shaped(alnumIdents, specNumerics))), meta: hegel.Draw(tc, maybe(25, metaLists))}
+	return verPair{a, b}
+})
+
+// TestHegelPrereleasePrefixSortsLower: a pre-release sorts below the one
+// that extends it with any identifier (spec item 11); go-version puts it
+// above when the added identifier is alphanumeric (go-version/1).
+func TestHegelPrereleasePrefixSortsLower(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, prefixPairs)
+		checkOrder(ht, p.a, p.b, known("go-version/1"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/2
+
+var (
+	shortSegmentLists = hegel.FlatMap(hegel.SampledFrom([]int{3, 3, 3, 1, 2, 4}), func(k int) hegel.Generator[[]int64] { return fixed(segmentValues, k) })
+	// countPairs: a version of one to four segments with a pre-release
+	// beside the same value written with a zero after its padded segments
+	// (another padded count: go-version/2) - under HEGEL_NO_KNOWN=1 written
+	// with the same segments, and moved off the other known shapes (a fresh
+	// pre-release can extend a's by chance, go-version/1) - without a
+	// pre-release half of the time, else with a fresh one.
+	countPairs = hegel.Composite(func(tc hegel.TestCase) verPair {
+		a := hv{segs: hegel.Draw(tc, shortSegmentLists), pre: hegel.Draw(tc, specPreLists), meta: hegel.Draw(tc, maybe(25, metaLists))}
+		b := hv{segs: shaped(append(a.padded(), 0), slices.Clone(a.segs)), pre: hegel.Draw(tc, maybe(50, specPreLists)), meta: hegel.Draw(tc, maybe(25, metaLists))}
+		return verPair{a, shaped(b, unpinned(a, b))}
+	})
+)
+
+// TestHegelPrereleaseCountsAcrossSegmentCounts: a pre-release version is
+// below the same value without one (and pre-releases order by their
+// identifiers) whatever the number of segments each is written with;
+// go-version consults the pre-release only when the counts agree
+// (go-version/2).
+func TestHegelPrereleaseCountsAcrossSegmentCounts(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, countPairs)
+		checkOrder(ht, p.a, p.b, known("go-version/2"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/3
+
+// leadingZeroPairs: a version whose pre-release has a small numeric
+// identifier written with one or two leading zeros ("01") beside the same
+// version with that identifier written plainly or as another small number;
+// under HEGEL_NO_KNOWN=1 both written plainly.
+var leadingZeroPairs = hegel.Composite(func(tc hegel.TestCase) verPair {
+	segs, pre, meta := hegel.Draw(tc, segmentLists), hegel.Draw(tc, specPreLists), hegel.Draw(tc, maybe(25, metaLists))
+	at := hegel.Draw(tc, positions) % len(pre)
+	n := hegel.Draw(tc, hegel.Integers(0, 12))
+	padded, other := hegel.Draw(tc, hegel.Integers(1, 2)), hegel.Draw(tc, maybe(50, hegel.Integers(1, 12)))
+	a := hv{segs: segs, pre: slices.Clone(pre), meta: meta}
+	a.pre[at] = shaped(zeros(padded), "") + strconv.Itoa(n)
+	b := hv{segs: segs, pre: slices.Clone(pre), meta: meta}
+	b.pre[at] = strconv.Itoa(n + other)
+	return verPair{a, b}
+})
+
+// TestHegelLeadingZeroIdentifiersCompareNumerically: numeric identifiers
+// compare by value, so 01 equals 1 and is below 2; go-version accepts the
+// leading zero and compares by length (go-version/3).
+func TestHegelLeadingZeroIdentifiersCompareNumerically(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, leadingZeroPairs)
+		checkOrder(ht, p.a, p.b, known("go-version/3"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/4
+
+// looseCase: a three-segment version and the way its text is loosened.
+type looseCase struct {
+	ver         hv
+	kind        string
+	at, pad     int
+	count       int
+	ident       string // a leading-zero identifier
+	letterIdent string // a letter-first identifier, for the hyphen-less spelling
+}
+
+var (
+	// looseKinds: a v prefix, a zero-padded segment, another segment count
+	// or a leading zero in a numeric identifier (go-version/4: NewSemver
+	// accepts them all); under HEGEL_NO_KNOWN=1 the hyphen left out before
+	// a letter-first pre-release, which it refuses.
+	looseKinds = shaped([]string{"v prefix", "zero padding", "segment count", "leading zero"}, []string{"hyphen left out"})
+	looseCases = hegel.Composite(func(tc hegel.TestCase) looseCase {
+		return looseCase{
+			ver:         hv{segs: hegel.Draw(tc, fixed(segmentValues, 3)), pre: hegel.Draw(tc, maybe(50, specPreLists)), meta: hegel.Draw(tc, maybe(25, metaLists))},
+			kind:        hegel.Draw(tc, hegel.SampledFrom(looseKinds)),
+			at:          hegel.Draw(tc, positions),
+			pad:         hegel.Draw(tc, hegel.Integers(1, 2)),
+			count:       hegel.Draw(tc, hegel.SampledFrom([]int{1, 2, 4, 5})),
+			ident:       hegel.Draw(tc, leadingZeroIdents),
+			letterIdent: hegel.Draw(tc, cat(text(letterChars, 1, 1), text(alnumChars, 0, 4))),
+		}
+	})
+)
+
+// text is the loosened version text, which is not a strict semver.
+func (c looseCase) text() string {
+	m := c.ver
+	switch c.kind {
+	case "v prefix":
+		return "v" + m.canon()
+	case "zero padding":
+		sp := spelling{pads: make([]int, 5)}
+		sp.pads[c.at%3] = c.pad
+		return m.written(sp)
+	case "segment count":
+		m.segs = slices.Clone(m.segs)
+		for len(m.segs) > c.count {
+			m.segs = m.segs[:len(m.segs)-1]
+		}
+		for len(m.segs) < c.count {
+			m.segs = append(m.segs, 0)
+		}
+		return m.written(plainSpelling)
+	case "leading zero":
+		m.pre = slices.Clone(m.pre)
+		if len(m.pre) == 0 {
+			m.pre = []string{c.ident}
+		} else {
+			m.pre[c.at%len(m.pre)] = c.ident
+		}
+		return m.canon()
+	}
+	m.pre = append([]string{c.letterIdent}, m.pre...)
+	return m.written(spelling{pads: make([]int, 5), hyphenless: true})
+}
+
+func (c looseCase) GoString() string { return fmt.Sprintf("%s: %q", c.kind, c.text()) }
+
+// TestHegelNewSemverRefusesLooseSpellings: NewSemver, documented to adhere
+// strictly to the spec, refuses a text that is not a semver 2.0.0 version;
+// it accepts everything NewVersion does but a missing hyphen (go-version/4).
+func TestHegelNewSemverRefusesLooseSpellings(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, looseCases)
+		if sv, err := version.NewSemver(c.text()); err == nil {
+			mismatch(ht, known("go-version/4"), "NewSemver(%q) [%s] = %v, want an error", c.text(), c.kind, sv)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/5
+
+// singlePessimistic: `~> N` (go-version/5) - under HEGEL_NO_KNOWN=1 `~> N.M`
+// - checked against a version whose major is N, or N plus one to three.
+type singlePessimistic struct {
+	n, m, bump int64
+	rest       []int64
+}
+
+var singlePessimistics = hegel.Composite(func(tc hegel.TestCase) singlePessimistic {
+	return singlePessimistic{
+		n:    hegel.Draw(tc, smallSegments),
+		m:    hegel.Draw(tc, smallSegments),
+		bump: hegel.Draw(tc, smallSegments),
+		rest: hegel.Draw(tc, fixed(smallSegments, 2)),
+	}
+})
+
+func (c singlePessimistic) constraint() comparator {
+	return comparator{op: "~>", ver: hv{segs: shaped([]int64{c.n}, []int64{c.n, c.m})}}
+}
+
+func (c singlePessimistic) text() string { return "~> " + c.constraint().ver.written(plainSpelling) }
+
+func (c singlePessimistic) version() hv { return hv{segs: []int64{c.n + c.bump, c.rest[0], c.rest[1]}} }
+
+func (c singlePessimistic) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", c.text(), c.version().canon())
+}
+
+// TestHegelPessimisticSingleSegmentStaysInMajor: `~> N` is `>= N, < N+1`
+// (RubyGems, the operator's origin, and the way `~> N.M` is bounded here);
+// go-version's `~> N` matches every version from N up (go-version/5).
+func TestHegelPessimisticSingleSegmentStaysInMajor(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, singlePessimistics)
+		text := c.text()
+		cs, err := version.NewConstraint(text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", text, err)
+			return
+		}
+		v := c.version()
+		if got, want := cs.Check(mustV(v.canon())), c.constraint().holds(v); got != want {
+			mismatch(ht, known("go-version/5"), "%q.Check(%q) = %v, want %v", text, v.canon(), got, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/6
+
+// emptyIdentCase: a version text whose pre-release has an empty identifier:
+// first - "1.2.3-", "1.2.3-.a", "1.2-+m" (go-version/6: NewVersion reads the
+// hyphen as the identifier) - or under HEGEL_NO_KNOWN=1 after the first
+// ("1.2.3-a.", "1.2.3-a..b"), which both parsers refuse.
+type emptyIdentCase struct {
+	ver   hv // segments and metadata
+	rest  []string
+	alone bool // the empty identifier is the whole pre-release
+	at    int
+}
+
+var emptyIdentCases = hegel.Composite(func(tc hegel.TestCase) emptyIdentCase {
+	return emptyIdentCase{
+		ver:   hv{segs: hegel.Draw(tc, segmentLists), meta: hegel.Draw(tc, maybe(25, metaLists))},
+		rest:  hegel.Draw(tc, specPreLists),
+		alone: hegel.Draw(tc, chance(50)),
+		at:    hegel.Draw(tc, positions),
+	}
+})
+
+func (c emptyIdentCase) text() string {
+	var pre []string
+	switch {
+	case noKnown:
+		pre = slices.Insert(slices.Clone(c.rest), 1+c.at%len(c.rest), "")
+	case c.alone:
+		pre = []string{""}
+	default:
+		pre = append([]string{""}, c.rest...)
+	}
+	m := c.ver
+	m.pre = pre
+	return m.written(plainSpelling)
+}
+
+func (c emptyIdentCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+// TestHegelEmptyLeadingIdentifierIsRefused: a pre-release with an empty
+// identifier is malformed wherever the identifier is; NewVersion accepts an
+// empty first one as the identifier "-" (go-version/6).
+func TestHegelEmptyLeadingIdentifierIsRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyIdentCases)
+		checkRefused(ht, c.text(), "empty identifier", known("go-version/6"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/7
+
+// scanCase: a version in a loose spelling, given to Scan as []byte
+// (go-version/7) or under HEGEL_NO_KNOWN=1 as a string.
+type scanCase struct {
+	ver hv
+	sp  spelling
+}
+
+var scanCases = hegel.Composite(func(tc hegel.TestCase) scanCase {
+	return scanCase{ver: hegel.Draw(tc, versions), sp: hegel.Draw(tc, spellings)}
+})
+
+func (c scanCase) source() any {
+	text := c.ver.written(c.sp)
+	return shaped[any]([]byte(text), text)
+}
+
+func (c scanCase) GoString() string {
+	return fmt.Sprintf("Scan(%T %q)", c.source(), c.ver.written(c.sp))
+}
+
+// TestHegelScanReadsBytes: Scan reads the []byte that database/sql drivers
+// deliver for text columns as it reads a string; go-version refuses it
+// (go-version/7).
+func TestHegelScanReadsBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, scanCases)
+		var v version.Version
+		if err := v.Scan(c.source()); err != nil || v.String() != c.ver.canon() {
+			mismatch(ht, known("go-version/7"), "Scan(%T %q) = %q, %v; want %q", c.source(), c.ver.written(c.sp), v.String(), err, c.ver.canon())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-version/8
+
+// longerPessimistic: `~> c` where c is a version of one to three segments
+// padded to three plus one or two trailing zeros, checked against the same
+// value written short (go-version/8) or, under HEGEL_NO_KNOWN=1, written
+// with the zeros too.
+type longerPessimistic struct {
+	base  []int64
+	zeros int
+	meta  []string
+}
+
+var longerPessimistics = hegel.Composite(func(tc hegel.TestCase) longerPessimistic {
+	return longerPessimistic{
+		base:  hegel.Draw(tc, hegel.FlatMap(hegel.Integers(1, 3), func(k int) hegel.Generator[[]int64] { return fixed(smallSegments, k) })),
+		zeros: hegel.Draw(tc, hegel.Integers(1, 2)),
+		meta:  hegel.Draw(tc, maybe(25, metaLists)),
+	}
+})
+
+func (c longerPessimistic) constraint() comparator {
+	segs := hv{segs: c.base}.padded()
+	for i := 0; i < c.zeros; i++ {
+		segs = append(segs, 0)
+	}
+	return comparator{op: "~>", ver: hv{segs: segs, meta: c.meta}}
+}
+
+func (c longerPessimistic) version() hv {
+	return hv{segs: shaped(slices.Clone(c.base), c.constraint().ver.segs)}
+}
+
+func (c longerPessimistic) text() string { return "~> " + c.constraint().ver.canon() }
+
+func (c longerPessimistic) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", c.text(), c.version().canon())
+}
+
+// TestHegelPessimisticMatchesShorterEqualVersion: a version equal to the
+// pessimistic constraint's own matches it however many segments each is
+// written with (versions are zero-extended everywhere else); go-version
+// rejects a version written with fewer segments than the constraint
+// (go-version/8).
+func TestHegelPessimisticMatchesShorterEqualVersion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, longerPessimistics)
+		cs, err := version.NewConstraint(c.text())
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", c.text(), err)
+			return
+		}
+		v := c.version()
+		if got, want := cs.Check(mustV(v.canon())), c.constraint().holds(v); got != want {
+			mismatch(ht, known("go-version/8"), "%q.Check(%q) = %v, want %v", c.text(), v.canon(), got, want)
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..7b9e4e1
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1642 @@
+package version_test
+
+// Hegel property tests for github.com/hashicorp/go-version.
+//
+// The README says "Versions used with go-version must follow SemVer", so
+// the oracle for parsing and precedence is Semantic Versioning 2.0.0 - the
+// identifier-by-identifier precedence rules of item 11, implemented here as
+// a small model - extended the way the code documents for what the spec
+// does not have: any number of numeric segments compared left to right with
+// the shorter list extended by zeros, leading zeros and a `v` prefix
+// canonicalised away (String's doc comment), a pre-release without its
+// hyphen accepted by NewVersion but not by NewSemver. Constraints follow the
+// package's own rules (the README example plus the comments in
+// constraint.go): a comma-separated AND of `op version`, `=`/`!=` by
+// equality, the relational operators with the pre-release rule (a
+// constraint without a pre-release never matches a pre-release version; one
+// with a pre-release matches only pre-releases of the same core), and the
+// pessimistic `~>` in its RubyGems meaning (`~> 1.2.3` is `>= 1.2.3, < 1.3`,
+// `~> 1.2` is `>= 1.2, < 2`, the upstream tests' own table, and `~> 1` is
+// `>= 1, < 2`, the case the table leaves out).
+//
+// Every property draws one case record built from generator values and
+// rendered by pure functions. The shapes of the recorded bugs (bugs.toml)
+// are drawn at their natural rate, so the properties that meet them fail,
+// naming the shape, and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over
+// its shape region alone, and the pins at the end of this file are the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Set GO_VERSION_COLLECT=1 to make the properties record mismatches instead
+// of failing and print them (shortest first) at the end of each test.
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/hashicorp/go-version"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("GO_VERSION_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape; under HEGEL_NO_KNOWN=1 the shapes
+// are left out of the generators (shaped, unpinned) and a mismatch that
+// still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known
+// shape is skipped instead (rare then, since the generators leave the
+// shapes out).
+func mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements; fixed a list of exactly k.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] { return many(g, k, k) }
+
+// text is a string of lo to hi characters of the pool.
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// dec is the decimal text of an integer generator.
+func dec[T ~int | ~int64](g hegel.Generator[T]) hegel.Generator[string] {
+	return hegel.Map(g, func(x T) string { return strconv.FormatInt(int64(x), 10) })
+}
+
+// cat draws one string from each generator and joins them.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+func zeros(n int) string { return strings.Repeat("0", n) }
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// distinct drops the repeats of a list, keeping the first occurrences.
+func distinct(xs []string) []string {
+	var out []string
+	for _, x := range xs {
+		if !slices.Contains(out, x) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// The model.
+
+// hv is a version as go-version sees it: the numeric segments as written
+// (one or more), the pre-release identifiers and the build identifiers.
+type hv struct {
+	segs      []int64
+	pre, meta []string
+}
+
+// padded is the segment list with at least three entries.
+func (a hv) padded() []int64 {
+	out := slices.Clone(a.segs)
+	for len(out) < 3 {
+		out = append(out, 0)
+	}
+	return out
+}
+
+func (a hv) canon() string {
+	parts := make([]string, 0, 3)
+	for _, s := range a.padded() {
+		parts = append(parts, strconv.FormatInt(s, 10))
+	}
+	s := strings.Join(parts, ".")
+	if len(a.pre) > 0 {
+		s += "-" + strings.Join(a.pre, ".")
+	}
+	if len(a.meta) > 0 {
+		s += "+" + strings.Join(a.meta, ".")
+	}
+	return s
+}
+
+func (a hv) core() hv {
+	return hv{segs: a.padded()[:3]}
+}
+
+// specIdents reports whether every numeric pre-release identifier is
+// written without leading zeros, as the spec's grammar demands.
+func (a hv) specIdents() bool { return !hasLeadingZero(a.pre) }
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func isLetter(c byte) bool { return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' }
+
+// hasLeadingZero reports whether an identifier is numeric with a leading
+// zero ("01", "00").
+func hasLeadingZero(idents []string) bool {
+	for _, id := range idents {
+		if isNumeric(id) && len(id) > 1 && id[0] == '0' {
+			return true
+		}
+	}
+	return false
+}
+
+func cmpInt[T int64 | int](a, b T) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+// cmpIdent orders two pre-release identifiers per spec item 11: numeric
+// ones by value (leading zeros do not count), numeric before alphanumeric,
+// alphanumeric ones by ASCII order.
+func cmpIdent(a, b string) int {
+	an, bn := isNumeric(a), isNumeric(b)
+	switch {
+	case an && bn:
+		a, b = strings.TrimLeft(a, "0"), strings.TrimLeft(b, "0")
+		if d := cmpInt(len(a), len(b)); d != 0 {
+			return d
+		}
+		return strings.Compare(a, b)
+	case an:
+		return -1
+	case bn:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+// cmpSegs compares two segment lists left to right, the shorter extended
+// with zeros (the documented behaviour for versions of differing length).
+func cmpSegs(a, b []int64) int {
+	for i := 0; i < len(a) || i < len(b); i++ {
+		var x, y int64
+		if i < len(a) {
+			x = a[i]
+		}
+		if i < len(b) {
+			y = b[i]
+		}
+		if d := cmpInt(x, y); d != 0 {
+			return d
+		}
+	}
+	return 0
+}
+
+func (a hv) cmp(b hv) int {
+	if d := cmpSegs(a.segs, b.segs); d != 0 {
+		return d
+	}
+	switch {
+	case len(a.pre) == 0 && len(b.pre) == 0:
+		return 0
+	case len(a.pre) == 0:
+		return 1
+	case len(b.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(a.pre) && i < len(b.pre); i++ {
+		if d := cmpIdent(a.pre[i], b.pre[i]); d != 0 {
+			return d
+		}
+	}
+	return cmpInt(len(a.pre), len(b.pre))
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs, named on a mismatch.
+
+// prefixThenAlnum reports whether short is a proper prefix of long and the
+// identifier of long after it is alphanumeric (`alpha` against
+// `alpha.beta`).
+func prefixThenAlnum(short, long []string) bool {
+	if len(short) == 0 || len(short) >= len(long) {
+		return false
+	}
+	for i := range short {
+		if short[i] != long[i] {
+			return false
+		}
+	}
+	return !isNumeric(long[len(short)])
+}
+
+// sameValueOtherCount reports whether a and b are the same value written
+// with a different number of padded segments (`1.0.0` against `1.0.0.0`).
+func sameValueOtherCount(a, b hv) bool {
+	return cmpSegs(a.segs, b.segs) == 0 && len(a.padded()) != len(b.padded())
+}
+
+// pairShapes names the recorded bugs whose shape comparing a and b has:
+// go-version/1 (one pre-release a proper prefix of the other with an
+// alphanumeric identifier next), go-version/2 (the same value written with
+// a different number of segments, with a pre-release on either side) and
+// go-version/3 (a numeric identifier with a leading zero on either side).
+func pairShapes(a, b hv) []string {
+	var s []string
+	if prefixThenAlnum(a.pre, b.pre) || prefixThenAlnum(b.pre, a.pre) {
+		s = append(s, "go-version/1")
+	}
+	if (len(a.pre) > 0 || len(b.pre) > 0) && sameValueOtherCount(a, b) {
+		s = append(s, "go-version/2")
+	}
+	if hasLeadingZero(a.pre) || hasLeadingZero(b.pre) {
+		s = append(s, "go-version/3")
+	}
+	return s
+}
+
+// unpinned is b moved off the shapes of go-version/1 and /2 against a (for
+// HEGEL_NO_KNOWN=1, after a relation has been applied): a pre-release that
+// extends a's with an alphanumeric identifier (or that a's extends) becomes
+// a's own, and the same value written with another number of segments is
+// written with a's.
+func unpinned(a, b hv) hv {
+	if prefixThenAlnum(a.pre, b.pre) || prefixThenAlnum(b.pre, a.pre) {
+		b.pre = slices.Clone(a.pre)
+	}
+	if (len(a.pre) > 0 || len(b.pre) > 0) && sameValueOtherCount(a, b) {
+		b.segs = slices.Clone(a.segs)
+	}
+	return b
+}
+
+// ---------------------------------------------------------------------------
+// Generators: versions.
+
+const (
+	alnumChars    = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	nonDigitChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	letterChars   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+)
+
+var (
+	// segmentValues: a numeric segment, mostly tiny (so that versions
+	// collide), sometimes up to a thousand, sometimes anywhere in int64,
+	// sometimes at its top (a two-value draw rather than a Just: a draw-free
+	// alternative wins shrinking, and a minimal case should read 0.0.0).
+	segmentValues = weighted(
+		choice[int64]{6, hegel.Integers[int64](0, 3)},
+		choice[int64]{2, hegel.Integers[int64](0, 1000)},
+		choice[int64]{1, hegel.Integers[int64](0, math.MaxInt64)},
+		choice[int64]{1, hegel.Integers[int64](math.MaxInt64-1, math.MaxInt64)},
+	)
+	// segmentCounts: three segments most of the time, else one, two, four
+	// or five (a flat table with repetition, so that it shrinks to three).
+	segmentCounts = hegel.SampledFrom([]int{3, 3, 3, 3, 3, 3, 3, 3, 1, 2, 4, 5})
+	segmentLists  = hegel.FlatMap(segmentCounts, func(k int) hegel.Generator[[]int64] { return fixed(segmentValues, k) })
+
+	// plainNumerics: a numeric pre-release identifier without a leading
+	// zero (the spec's grammar): small, anywhere in int64, or beyond it (a
+	// 1 and 19 to 22 zeros).
+	plainNumerics = []choice[string]{
+		{4, dec(hegel.Integers(0, 12))},
+		{1, dec(hegel.Integers[int64](0, math.MaxInt64))},
+		{1, cat(lit("1"), hegel.Map(hegel.Integers(19, 22), zeros))},
+	}
+	// leadingZeroIdents: a small numeric identifier with one or two
+	// leading zeros ("01", "003"): the shape of go-version/3 (the spec
+	// forbids them, both parsers accept them, Compare orders them by length).
+	leadingZeroIdents = cat(hegel.Map(hegel.Integers(1, 2), zeros), dec(hegel.Integers(0, 12)))
+	specNumerics      = weighted(plainNumerics...)
+	// numericIdents: a numeric identifier, one in seven with a leading zero
+	// while the shapes of the recorded bugs are drawn.
+	numericIdents = shaped(weighted(append(slices.Clone(plainNumerics), choice[string]{1, leadingZeroIdents})...), specNumerics)
+
+	// alnumIdents: an alphanumeric identifier of one to five characters of
+	// [0-9A-Za-z-]: up to four drawn characters with a non-digit put in at
+	// a drawn position (modulo), so that it is never numeric.
+	alnumIdents = hegel.Composite(func(tc hegel.TestCase) string {
+		body := hegel.Draw(tc, text(alnumChars, 0, 4))
+		at := hegel.Draw(tc, positions) % (len(body) + 1)
+		return body[:at] + hegel.Draw(tc, text(nonDigitChars, 1, 1)) + body[at:]
+	})
+	specPreIdents = hegel.OneOf(specNumerics, alnumIdents)
+	preIdents     = hegel.OneOf(numericIdents, alnumIdents)
+	// metaIdents: a build identifier, any non-empty run of [0-9A-Za-z-].
+	metaIdents   = text(alnumChars, 1, 5)
+	specPreLists = many(specPreIdents, 1, 3)
+	preLists     = many(preIdents, 1, 3)
+	metaLists    = many(metaIdents, 1, 2)
+
+	// versions: one to five segments, a pre-release of one to three
+	// identifiers 40% of the time, build metadata of one or two 25%.
+	versions = hegel.Composite(func(tc hegel.TestCase) hv {
+		return hv{segs: hegel.Draw(tc, segmentLists), pre: hegel.Draw(tc, maybe(40, preLists)), meta: hegel.Draw(tc, maybe(25, metaLists))}
+	})
+)
+
+// spelling is a loose spelling of a version: zeros written before the
+// segments (by index; 0 for none), the hyphen before a letter-first
+// pre-release left out, a v prefix. The zero spelling is the canonical text.
+type spelling struct {
+	pads       []int
+	hyphenless bool
+	vPrefix    bool
+}
+
+var (
+	plainSpelling = spelling{pads: make([]int, 5)}
+	// spellings: one or two zeros before a segment 20% of the time each,
+	// the hyphen left out 30%, a v prefix 30%.
+	spellings = hegel.Composite(func(tc hegel.TestCase) spelling {
+		return spelling{pads: hegel.Draw(tc, padLists), hyphenless: hegel.Draw(tc, chance(30)), vPrefix: hegel.Draw(tc, chance(30))}
+	})
+	padLists = fixed(maybe(20, hegel.Integers(1, 2)), 5)
+)
+
+// written is the version spelled as sp says: the segments as written (not
+// padded) with sp's zeros before them, the hyphen before a letter-first
+// pre-release left out when sp says so, a v prefix.
+func (a hv) written(sp spelling) string {
+	parts := make([]string, len(a.segs))
+	for i, s := range a.segs {
+		parts[i] = zeros(sp.pads[i]) + strconv.FormatInt(s, 10)
+	}
+	s := strings.Join(parts, ".")
+	if len(a.pre) > 0 {
+		if !a.hyphenless(sp) {
+			s += "-"
+		}
+		s += strings.Join(a.pre, ".")
+	}
+	if len(a.meta) > 0 {
+		s += "+" + strings.Join(a.meta, ".")
+	}
+	if sp.vPrefix {
+		s = "v" + s
+	}
+	return s
+}
+
+// hyphenless reports whether the spelling leaves the hyphen out: only a
+// letter-first pre-release can (a hyphen-first identifier would be read as
+// the separator).
+func (a hv) hyphenless(sp spelling) bool {
+	return sp.hyphenless && len(a.pre) > 0 && isLetter(a.pre[0][0])
+}
+
+// ---------------------------------------------------------------------------
+// Checks shared by the version properties.
+
+func checkParts(ht *hegel.T, what, text string, v *version.Version, m hv) {
+	pre := strings.Join(m.pre, ".")
+	meta := strings.Join(m.meta, ".")
+	if fmt.Sprint(v.Segments64()) != fmt.Sprint(m.padded()) || v.Prerelease() != pre || v.Metadata() != meta {
+		fail(ht, "%s(%q): segments %v pre %q meta %q, want %v pre %q meta %q",
+			what, text, v.Segments64(), v.Prerelease(), v.Metadata(), m.padded(), pre, meta)
+	}
+	if v.Original() != text {
+		fail(ht, "%s(%q).Original() = %q", what, text, v.Original())
+	}
+	if v.String() != m.canon() {
+		fail(ht, "%s(%q).String() = %q, want %q", what, text, v.String(), m.canon())
+	}
+}
+
+// checkSemver checks that NewSemver accepts the text (and reads it as m) or
+// refuses it, as want says. Under HEGEL_NO_KNOWN=1 the check is left out
+// when the refusal it expects is a go-version/4 shape (a v prefix, zero
+// padding, another segment count, a leading zero in an identifier, all of
+// which NewSemver accepts): those are half of the cases, too many to assume
+// away, and the rest of the case still runs.
+func checkSemver(ht *hegel.T, text string, m hv, want bool, shape []string) {
+	if noKnown && len(shape) > 0 {
+		return
+	}
+	sv, err := version.NewSemver(text)
+	if (err == nil) != want {
+		verdict := "a refusal"
+		if want {
+			verdict = "acceptance"
+		}
+		mismatch(ht, shape, "NewSemver(%q) = %v, %v; want %s", text, sv, err, verdict)
+	}
+	if want && err == nil {
+		checkParts(ht, "NewSemver", text, sv, m)
+	}
+}
+
+// checkRefused checks that both parsers, UnmarshalText and Scan refuse the
+// text with a nil result, and that Must panics on it.
+func checkRefused(ht *hegel.T, text, what string, shape []string) {
+	if v, err := version.NewVersion(text); err == nil || v != nil {
+		mismatch(ht, shape, "NewVersion(%q) [%s] accepted as %v (err %v)", text, what, v, err)
+	}
+	if v, err := version.NewSemver(text); err == nil || v != nil {
+		mismatch(ht, shape, "NewSemver(%q) [%s] accepted as %v (err %v)", text, what, v, err)
+	}
+	var tv version.Version
+	if err := tv.UnmarshalText([]byte(text)); err == nil {
+		mismatch(ht, shape, "UnmarshalText(%q) [%s] accepted as %q", text, what, tv.String())
+	}
+	var sv version.Version
+	if err := sv.Scan(text); err == nil {
+		mismatch(ht, shape, "Scan(%q) [%s] accepted as %q", text, what, sv.String())
+	}
+	func() {
+		defer func() {
+			if recover() == nil {
+				mismatch(ht, shape, "Must(NewVersion(%q)) [%s] did not panic", text, what)
+			}
+		}()
+		version.Must(version.NewVersion(text))
+	}()
+}
+
+// checkOrder checks Compare both ways and the five comparison methods
+// against the model.
+func checkOrder(ht *hegel.T, a, b hv, shape []string) {
+	va, vb := mustV(a.canon()), mustV(b.canon())
+	want := a.cmp(b)
+	if got := va.Compare(vb); got != want {
+		mismatch(ht, shape, "Compare(%q, %q) = %d, want %d", a.canon(), b.canon(), got, want)
+	}
+	if got := vb.Compare(va); got != -want {
+		mismatch(ht, shape, "Compare(%q, %q) = %d, want %d", b.canon(), a.canon(), got, -want)
+	}
+	if va.LessThan(vb) != (want < 0) || va.LessThanOrEqual(vb) != (want <= 0) ||
+		va.GreaterThan(vb) != (want > 0) || va.GreaterThanOrEqual(vb) != (want >= 0) ||
+		va.Equal(vb) != (want == 0) {
+		mismatch(ht, shape, "%q vs %q: LessThan %v LessThanOrEqual %v GreaterThan %v GreaterThanOrEqual %v Equal %v, Compare %d",
+			a.canon(), b.canon(), va.LessThan(vb), va.LessThanOrEqual(vb), va.GreaterThan(vb), va.GreaterThanOrEqual(vb), va.Equal(vb), want)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property: versions parse, print canonically and survive every round trip.
+
+// parseCase: a version, a loose spelling of it, the custom prefix of the
+// WithPrefix check, and whether Scan is given the text as []byte (the shape
+// of go-version/7; a string under HEGEL_NO_KNOWN=1).
+type parseCase struct {
+	ver       hv
+	sp        spelling
+	prefix    string
+	scanBytes bool
+}
+
+var (
+	prefixes   = hegel.SampledFrom([]string{"deployment-", "controller-", "x-", "release/", "azure-cli-v", "V"})
+	scanBytes  = shaped(chance(30), hegel.Just(false))
+	parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{ver: hegel.Draw(tc, versions), sp: hegel.Draw(tc, spellings), prefix: hegel.Draw(tc, prefixes), scanBytes: hegel.Draw(tc, scanBytes)}
+	})
+)
+
+// scanSource is the text as Scan is given it.
+func (c parseCase) scanSource(text string) any {
+	if c.scanBytes {
+		return []byte(text)
+	}
+	return text
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c parseCase) GoString() string {
+	return fmt.Sprintf("canonical %q loose %q prefix %q Scan(%T)", c.ver.canon(), c.ver.written(c.sp), c.prefix, c.scanSource(""))
+}
+
+func TestHegelVersionsParseAndPrint(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		m := c.ver
+		canon, loose := m.canon(), m.written(c.sp)
+
+		v, err := version.NewVersion(canon)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", canon, err)
+			return
+		}
+		checkParts(ht, "NewVersion", canon, v, m)
+
+		lv, err := version.NewVersion(loose)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", loose, err)
+			return
+		}
+		checkParts(ht, "NewVersion", loose, lv, m)
+		if !v.Equal(lv) || v.Compare(lv) != 0 || lv.Compare(v) != 0 {
+			fail(ht, "%q and %q parse unequal", canon, loose)
+		}
+
+		// NewSemver accepts a text iff it is a strict semver: exactly three
+		// segments, no v prefix or zero padding, the hyphen present, no
+		// leading zero in a numeric identifier. The canonical text is one
+		// unless an identifier has a leading zero; the loose spelling when
+		// it is the canonical text. (go-version/4: NewSemver accepts every
+		// loose spelling but the one without the hyphen.)
+		checkSemver(ht, canon, m, m.specIdents(), shapeIf(!m.specIdents(), "go-version/4"))
+		wantLoose := m.specIdents() && loose == canon
+		checkSemver(ht, loose, m, wantLoose, shapeIf(!wantLoose && !m.hyphenless(c.sp), "go-version/4"))
+
+		// Must, Core, the text and SQL round trips.
+		if mp := version.Must(version.NewVersion(loose)); mp.String() != canon {
+			fail(ht, "Must(NewVersion(%q)).String() = %q", loose, mp.String())
+		}
+		if core := v.Core(); core.String() != m.core().canon() || core.Prerelease() != "" || core.Metadata() != "" {
+			fail(ht, "Core(%q) = %q, want %q", canon, core.String(), m.core().canon())
+		}
+		tb, err := v.MarshalText()
+		if err != nil || string(tb) != canon {
+			fail(ht, "MarshalText(%q) = %q, %v", canon, tb, err)
+		}
+		var tback version.Version
+		if err := tback.UnmarshalText([]byte(loose)); err != nil || tback.String() != canon || tback.Original() != loose {
+			fail(ht, "UnmarshalText(%q) = %q (%q), %v", loose, tback.String(), tback.Original(), err)
+		}
+		val, err := v.Value()
+		if err != nil || val != canon {
+			fail(ht, "Value(%q) = %v, %v", canon, val, err)
+		}
+		var sc version.Version
+		src := c.scanSource(loose)
+		if err := sc.Scan(src); err != nil || sc.String() != canon {
+			mismatch(ht, shapeIf(c.scanBytes, "go-version/7"), "Scan(%T %q) = %q, %v", src, loose, sc.String(), err)
+		}
+		if rv, err := version.NewVersion(v.String()); err != nil || !rv.Equal(v) || rv.String() != canon {
+			fail(ht, "NewVersion(String(%q)) = %v, %v", canon, rv, err)
+		}
+
+		// WithPrefix: a custom prefix is validated, stripped and reported.
+		prefix := c.prefix
+		pv, err := version.NewVersion(prefix+loose, version.WithPrefix(prefix))
+		if err != nil {
+			fail(ht, "NewVersion(%q, WithPrefix(%q)): %v", prefix+loose, prefix, err)
+		} else {
+			checkParts(ht, "NewVersion[prefix]", prefix+loose, pv, m)
+			if pv.Prefix() != prefix {
+				fail(ht, "Prefix() = %q, want %q", pv.Prefix(), prefix)
+			}
+			if !pv.Equal(v) {
+				fail(ht, "%q with prefix %q is not Equal to %q", prefix+loose, prefix, canon)
+			}
+		}
+		if _, err := version.NewVersion(loose, version.WithPrefix(prefix)); err == nil && !strings.HasPrefix(loose, prefix) {
+			fail(ht, "NewVersion(%q, WithPrefix(%q)) accepted a text without the prefix", loose, prefix)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed versions are refused by both parsers, with a nil
+// result.
+
+// damage is one way of breaking a version text: the kind, and the draws the
+// kinds use (which of the kind's spellings, a position, both taken modulo
+// their live range; identifiers for a version that has none).
+type damage struct {
+	kind        string
+	form, at    int
+	ident       string
+	meta, meta2 string
+}
+
+var (
+	// damageKinds, plainest first (the shrink target is the empty text).
+	damageKinds = []string{"empty", "trailing dot", "trailing plus", "sign prefix", "V prefix", "surrounding blank",
+		"empty segment", "empty pre-release identifier", "empty build identifier", "character inserted",
+		"segment beyond int64", "second plus"}
+	// badChars: characters no version may contain: blanks and punctuation,
+	// a Greek letter, an Arabic-Indic digit, an ideographic full stop, NUL.
+	badChars = []string{" ", "_", "!", "/", ":", "\n", "\u03b1", "\u0661", "\u3002", "\x00", "*", "?"}
+	damages  = hegel.Composite(func(tc hegel.TestCase) damage {
+		return damage{
+			kind:  hegel.Draw(tc, hegel.SampledFrom(damageKinds)),
+			form:  hegel.Draw(tc, positions),
+			at:    hegel.Draw(tc, positions),
+			ident: hegel.Draw(tc, specPreIdents),
+			meta:  hegel.Draw(tc, metaIdents),
+			meta2: hegel.Draw(tc, metaIdents),
+		}
+	})
+)
+
+// malformedCase: a well-formed version and the damage done to its text.
+type malformedCase struct {
+	ver hv
+	dmg damage
+}
+
+var malformedCases = hegel.Composite(func(tc hegel.TestCase) malformedCase {
+	return malformedCase{ver: hegel.Draw(tc, versions), dmg: hegel.Draw(tc, damages)}
+})
+
+// preIdents is the version's pre-release, or the damage's identifier when
+// it has none; metaIdents likewise for the build identifiers.
+func (c malformedCase) preIdents() []string {
+	if len(c.ver.pre) == 0 {
+		return []string{c.dmg.ident}
+	}
+	return c.ver.pre
+}
+
+func (c malformedCase) metaIdents() []string {
+	if len(c.ver.meta) == 0 {
+		return []string{c.dmg.meta}
+	}
+	return c.ver.meta
+}
+
+// emptyAt is where the empty pre-release identifier goes among n: anywhere
+// (first is the shape of go-version/6: "1.2.3-" and "1.2.3-.a" are read as
+// the pre-release "-" and "-.a"), or under HEGEL_NO_KNOWN=1 after the first.
+func (c malformedCase) emptyAt(n int) int {
+	if noKnown {
+		return 1 + c.dmg.at%n
+	}
+	return c.dmg.at % (n + 1)
+}
+
+// text renders the damaged version text.
+func (c malformedCase) text() string {
+	m, d := c.ver, c.dmg
+	s := m.canon()
+	segs := make([]string, 0, 5)
+	for _, x := range m.padded() {
+		segs = append(segs, strconv.FormatInt(x, 10))
+	}
+	preText, metaText := "", ""
+	if len(m.pre) > 0 {
+		preText = "-" + strings.Join(m.pre, ".")
+	}
+	if len(m.meta) > 0 {
+		metaText = "+" + strings.Join(m.meta, ".")
+	}
+	switch d.kind {
+	case "empty":
+		return ""
+	case "trailing dot":
+		return s + "."
+	case "trailing plus":
+		return s + "+"
+	case "sign prefix":
+		return []string{"-", "+"}[d.form%2] + s
+	case "V prefix":
+		return "V" + s
+	case "surrounding blank":
+		return []string{" " + s, s + " ", " " + s + " ", "\t" + s}[d.form%4]
+	case "empty segment":
+		return []string{"." + s, strings.Join(segs, "..") + preText + metaText, segs[0] + ".." + strings.Join(segs[1:], ".") + preText + metaText}[d.form%3]
+	case "empty pre-release identifier":
+		pre := c.preIdents()
+		pre = slices.Insert(slices.Clone(pre), c.emptyAt(len(pre)), "")
+		return strings.Join(segs, ".") + "-" + strings.Join(pre, ".") + metaText
+	case "empty build identifier":
+		meta := c.metaIdents()
+		meta = slices.Insert(slices.Clone(meta), d.at%(len(meta)+1), "")
+		return strings.Join(segs, ".") + preText + "+" + strings.Join(meta, ".")
+	case "character inserted":
+		i := d.at % (len(s) + 1)
+		return s[:i] + badChars[d.form%len(badChars)] + s[i:]
+	case "segment beyond int64":
+		segs[d.at%len(segs)] = "9223372036854775808"
+		return strings.Join(segs, ".") + preText + metaText
+	case "second plus":
+		return strings.Join(segs, ".") + preText + "+" + d.meta + "+" + d.meta2
+	}
+	panic("damage " + d.kind)
+}
+
+// shapes names go-version/6 when the empty identifier is the first.
+func (c malformedCase) shapes() []string {
+	return shapeIf(c.dmg.kind == "empty pre-release identifier" && c.emptyAt(len(c.preIdents())) == 0, "go-version/6")
+}
+
+func (c malformedCase) GoString() string { return fmt.Sprintf("%s: %q", c.dmg.kind, c.text()) }
+
+func TestHegelMalformedVersionsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, malformedCases)
+		checkRefused(ht, c.text(), c.dmg.kind, c.shapes())
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: precedence follows the spec (segments zero-extended); Collection
+// sorts by it.
+
+// segEdit: how a related version's segments derive from its base's: the
+// same (keep), one of them one up or down (nudge, at modulo the count), the
+// same value with one more trailing zero or one fewer (count), or a fresh
+// list (fresh).
+type segEdit struct {
+	kind  string
+	at    int
+	down  bool
+	grow  bool
+	fresh []int64
+}
+
+// preEdit: how the pre-release derives: none, the base's (keep), a fresh
+// one, the base's without its last identifier (dropLast), with one more
+// (append), with one replaced (replace) or one recased (recase).
+type preEdit struct {
+	kind   string
+	at     int
+	upper  bool
+	idents []string
+	ident  string
+}
+
+// relation: the edits that make a version related to a base, and the
+// related version's own metadata.
+type relation struct {
+	seg  segEdit
+	pre  preEdit
+	meta []string
+}
+
+var (
+	segEdits = weighted(
+		choice[segEdit]{3, hegel.Just(segEdit{kind: "keep"})},
+		choice[segEdit]{1, hegel.Map(pairs(positions, chance(50)), func(p pair[int, bool]) segEdit { return segEdit{kind: "nudge", at: p.a, down: p.b} })},
+		choice[segEdit]{1, hegel.Map(chance(50), func(grow bool) segEdit { return segEdit{kind: "count", grow: grow} })},
+		choice[segEdit]{1, hegel.Map(segmentLists, func(segs []int64) segEdit { return segEdit{kind: "fresh", fresh: segs} })},
+	)
+	// appendIdents: the identifier appended to the base's pre-release; an
+	// alphanumeric one is the shape of go-version/1, so under
+	// HEGEL_NO_KNOWN=1 numeric ones only.
+	appendIdents = shaped(preIdents, specNumerics)
+	preEdits     = weighted(
+		choice[preEdit]{1, hegel.Just(preEdit{kind: "none"})},
+		choice[preEdit]{1, hegel.Just(preEdit{kind: "keep"})},
+		choice[preEdit]{1, hegel.Map(preLists, func(ids []string) preEdit { return preEdit{kind: "fresh", idents: ids} })},
+		choice[preEdit]{1, hegel.Just(preEdit{kind: "dropLast"})},
+		choice[preEdit]{1, hegel.Map(appendIdents, func(id string) preEdit { return preEdit{kind: "append", ident: id} })},
+		choice[preEdit]{1, hegel.Map(pairs(positions, preIdents), func(p pair[int, string]) preEdit { return preEdit{kind: "replace", at: p.a, ident: p.b} })},
+		choice[preEdit]{1, hegel.Map(pairs(positions, chance(50)), func(p pair[int, bool]) preEdit { return preEdit{kind: "recase", at: p.a, upper: p.b} })},
+	)
+	relations = hegel.Composite(func(tc hegel.TestCase) relation {
+		return relation{seg: hegel.Draw(tc, segEdits), pre: hegel.Draw(tc, preEdits), meta: hegel.Draw(tc, maybe(30, metaLists))}
+	})
+)
+
+// apply is the version related to a by r: an edit that does not fit a (a
+// segment to drop that is not a trailing zero, a sixth segment, an
+// identifier of a pre-release a has not) leaves that part as it is. Under
+// HEGEL_NO_KNOWN=1 the result is moved off the known shapes (unpinned).
+func (r relation) apply(a hv) hv {
+	b := hv{segs: slices.Clone(a.segs), meta: r.meta}
+	switch r.seg.kind {
+	case "nudge":
+		i := r.seg.at % len(b.segs)
+		if r.seg.down && b.segs[i] > 0 {
+			b.segs[i]--
+		} else if b.segs[i] < math.MaxInt64 {
+			b.segs[i]++
+		}
+	case "count":
+		if r.seg.grow {
+			if len(b.segs) < 5 {
+				b.segs = append(b.segs, 0)
+			}
+		} else if len(b.segs) > 1 && b.segs[len(b.segs)-1] == 0 {
+			b.segs = b.segs[:len(b.segs)-1]
+		}
+	case "fresh":
+		b.segs = slices.Clone(r.seg.fresh)
+	}
+	switch r.pre.kind {
+	case "keep":
+		b.pre = slices.Clone(a.pre)
+	case "fresh":
+		b.pre = r.pre.idents
+	case "dropLast":
+		if len(a.pre) > 0 {
+			b.pre = slices.Clone(a.pre[:len(a.pre)-1])
+		}
+	case "append":
+		b.pre = append(slices.Clone(a.pre), r.pre.ident)
+	case "replace":
+		if len(a.pre) > 0 {
+			b.pre = slices.Clone(a.pre)
+			b.pre[r.pre.at%len(b.pre)] = r.pre.ident
+		}
+	case "recase":
+		if len(a.pre) > 0 {
+			b.pre = slices.Clone(a.pre)
+			i := r.pre.at % len(b.pre)
+			if r.pre.upper {
+				b.pre[i] = strings.ToUpper(b.pre[i])
+			} else {
+				b.pre[i] = strings.ToLower(b.pre[i])
+			}
+		}
+	}
+	if noKnown {
+		b = unpinned(a, b)
+	}
+	return b
+}
+
+// step: one more version for the collection, related to the model at base
+// (modulo the live count).
+type step struct {
+	base int
+	rel  relation
+}
+
+// precedenceCase: a version, the relation that makes its partner, and the
+// steps that grow the pair into a collection.
+type precedenceCase struct {
+	a     hv
+	rel   relation
+	steps []step
+}
+
+var (
+	steps = hegel.Map(pairs(positions, relations), func(p pair[int, relation]) step { return step{base: p.a, rel: p.b} })
+
+	precedenceCases = hegel.Composite(func(tc hegel.TestCase) precedenceCase {
+		return precedenceCase{a: hegel.Draw(tc, versions), rel: hegel.Draw(tc, relations), steps: hegel.Draw(tc, many(steps, 0, 4))}
+	})
+)
+
+func (c precedenceCase) b() hv { return c.rel.apply(c.a) }
+
+// collection: the pair and the steps applied in turn. Under HEGEL_NO_KNOWN=1
+// a step whose version has a known shape against one of the models is a
+// no-op.
+func (c precedenceCase) collection() []hv {
+	models := []hv{c.a, c.b()}
+	for _, s := range c.steps {
+		v := s.rel.apply(models[s.base%len(models)])
+		if noKnown && len(collectionShapes(append(slices.Clone(models), v))) > 0 {
+			continue
+		}
+		models = append(models, v)
+	}
+	return models
+}
+
+// collectionShapes names the shapes of every pair of the models (a wrong
+// order can come from any pair, the order not being transitive under
+// go-version/2).
+func collectionShapes(models []hv) []string {
+	var s []string
+	for i := range models {
+		for j := i + 1; j < len(models); j++ {
+			s = append(s, pairShapes(models[i], models[j])...)
+		}
+	}
+	return distinct(s)
+}
+
+func canons(vs []hv) []string {
+	out := make([]string, len(vs))
+	for i, v := range vs {
+		out[i] = v.canon()
+	}
+	return out
+}
+
+func (c precedenceCase) GoString() string {
+	return fmt.Sprintf("a %q b %q collection %q", c.a.canon(), c.b().canon(), canons(c.collection()))
+}
+
+func TestHegelPrecedenceFollowsSemver(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, precedenceCases)
+		a, b := c.a, c.b()
+		checkOrder(ht, a, b, pairShapes(a, b))
+
+		// A handful of related versions sort into model order.
+		models := c.collection()
+		coll := make(version.Collection, len(models))
+		for i, m := range models {
+			coll[i] = mustV(m.canon())
+		}
+		sort.Sort(coll)
+		got := make([]string, len(coll))
+		for i, v := range coll {
+			got[i] = v.Original()
+		}
+		byText := map[string]hv{}
+		for _, m := range models {
+			byText[m.canon()] = m
+		}
+		for i := 1; i < len(got); i++ {
+			if byText[got[i-1]].cmp(byText[got[i]]) > 0 {
+				mismatch(ht, collectionShapes(models), "Collection sorted %q before %q (of %v)", got[i-1], got[i], got)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: model and generators.
+
+// respell is the second spelling of a comparator, for the Equals check: a
+// sort key for the order of the comparators (a stable sort by it, so equal
+// keys keep the drawn order), `=` for the bare operator or not, another
+// spelling of the version and other blanks.
+type respell struct {
+	key  int
+	eq   bool
+	sp   spelling
+	gaps []string
+}
+
+// comparator: a constraint's `op version` as drawn: the operator, the
+// version, its spelling, the blanks before the operator, between and after,
+// and the respelling.
+type comparator struct {
+	op   string
+	ver  hv
+	sp   spelling
+	gaps []string
+	alt  respell
+}
+
+func (c comparator) text() string {
+	return c.gaps[0] + c.op + c.gaps[1] + c.ver.written(c.sp) + c.gaps[2]
+}
+
+func (c comparator) altText() string {
+	op := c.op
+	if op == "" && c.alt.eq {
+		op = "="
+	}
+	return c.alt.gaps[0] + op + c.alt.gaps[1] + c.ver.written(c.alt.sp) + c.alt.gaps[2]
+}
+
+// preCheck is constraint.go's pre-release rule: a constraint without a
+// pre-release never matches a pre-release version; one with a pre-release
+// matches only pre-release versions of the same segments.
+func preCheck(v, c hv) bool {
+	vPre, cPre := len(v.pre) > 0, len(c.pre) > 0
+	switch {
+	case cPre && vPre:
+		return fmt.Sprint(v.padded()) == fmt.Sprint(c.padded())
+	case !cPre && vPre:
+		return false
+	}
+	return true
+}
+
+func (c comparator) holds(v hv) bool {
+	d := v.cmp(c.ver)
+	switch c.op {
+	case "", "=":
+		return d == 0
+	case "!=":
+		return d != 0
+	case ">":
+		return preCheck(v, c.ver) && d > 0
+	case ">=":
+		return preCheck(v, c.ver) && d >= 0
+	case "<":
+		return preCheck(v, c.ver) && d < 0
+	case "<=":
+		return preCheck(v, c.ver) && d <= 0
+	case "~>":
+		// RubyGems: `~> a.b.c` is `>= a.b.c` with the segments before the
+		// last one written fixed, and `~> a` is `>= a, < a+1`, so with one
+		// segment written that one is fixed; with a pre-release only
+		// pre-releases.
+		if !preCheck(v, c.ver) || len(c.ver.pre) > 0 && len(v.pre) == 0 {
+			return false
+		}
+		if d < 0 {
+			return false
+		}
+		vp := v.padded()
+		for i := 0; i < max(len(c.ver.segs)-1, 1); i++ {
+			var x int64
+			if i < len(vp) {
+				x = vp[i]
+			}
+			if x != c.ver.segs[i] {
+				return false
+			}
+		}
+		return true
+	}
+	panic("operator " + c.op)
+}
+
+type constraintModel struct {
+	comps []comparator
+}
+
+func (c constraintModel) satisfied(v hv) bool {
+	for _, cc := range c.comps {
+		if !cc.holds(v) {
+			return false
+		}
+	}
+	return true
+}
+
+func (c constraintModel) text() string {
+	parts := make([]string, len(c.comps))
+	for i, cc := range c.comps {
+		parts[i] = cc.text()
+	}
+	return strings.Join(parts, ",")
+}
+
+// altText is the constraint respelled: the comparators in the order of
+// their keys, each in its second spelling.
+func (c constraintModel) altText() string {
+	perm := slices.Clone(c.comps)
+	sort.SliceStable(perm, func(i, j int) bool { return perm[i].alt.key < perm[j].alt.key })
+	parts := make([]string, len(perm))
+	for i, cc := range perm {
+		parts[i] = cc.altText()
+	}
+	return strings.Join(parts, ",")
+}
+
+// comparatorShapes names the recorded bugs whose shape checking v against
+// the comparator has: those of the pair (go-version/1, /2), `~>` with a
+// single segment (go-version/5) and `~>` with more segments than the
+// version's for the same value (go-version/8).
+func comparatorShapes(v hv, cc comparator) []string {
+	s := pairShapes(v, cc.ver)
+	if cc.op == "~>" {
+		if len(cc.ver.segs) == 1 {
+			s = append(s, "go-version/5")
+		}
+		if cmpSegs(v.segs, cc.ver.segs) == 0 && len(cc.ver.padded()) > len(v.padded()) {
+			s = append(s, "go-version/8")
+		}
+	}
+	return s
+}
+
+// shapes names the shapes of the check version against every comparator
+// and of every pair of comparators (Equals sorts them by Compare).
+func (c constraintModel) shapes(v hv) []string {
+	var s []string
+	for _, cc := range c.comps {
+		s = append(s, comparatorShapes(v, cc)...)
+	}
+	return distinct(append(s, c.pairShapes()...))
+}
+
+func (c constraintModel) pairShapes() []string {
+	var s []string
+	for i := range c.comps {
+		for j := i + 1; j < len(c.comps); j++ {
+			s = append(s, pairShapes(c.comps[i].ver, c.comps[j].ver)...)
+		}
+	}
+	return distinct(s)
+}
+
+var (
+	operators = hegel.SampledFrom([]string{"", "=", "!=", ">", ">=", "<", "<=", "~>"})
+	// prePool: the pre-releases of constraints and the versions checked
+	// against them (`alpha` beside `alpha.beta` is the shape of go-version/1).
+	prePool       = hegel.SampledFrom([][]string{{"0"}, {"alpha"}, {"beta", "2"}, {"rc", "1"}, {"-"}, {"a-b"}, {"RC"}, {"alpha", "beta"}})
+	smallSegments = hegel.Integers[int64](0, 3)
+	// comparatorCounts: the segment counts of a comparator's version: three
+	// most of the time, one or two a fifth of the time, four a tenth; for
+	// `~>` under HEGEL_NO_KNOWN=1 two instead of one (`~> 1` is the shape
+	// of go-version/5).
+	comparatorCounts  = hegel.SampledFrom([]int{3, 3, 3, 3, 3, 3, 3, 1, 2, 4})
+	pessimisticCounts = shaped(comparatorCounts, hegel.SampledFrom([]int{3, 3, 3, 3, 3, 3, 3, 2, 2, 4}))
+	// comparatorVersions: small segments (so that the checked versions land
+	// on the boundaries), a pre-release from the pool 25% of the time,
+	// metadata 10%.
+	comparatorVersions  = versionsOf(comparatorCounts)
+	pessimisticVersions = versionsOf(pessimisticCounts)
+
+	blanks   = hegel.SampledFrom([]string{"", " ", "  ", "\t"})
+	gapLists = fixed(blanks, 3)
+	// comparatorSpellings: a zero before a segment 10% of the time each, a
+	// v prefix 15%.
+	comparatorSpellings = hegel.Composite(func(tc hegel.TestCase) spelling {
+		return spelling{pads: hegel.Draw(tc, fixed(maybe(10, hegel.Just(1)), 5)), vPrefix: hegel.Draw(tc, chance(15))}
+	})
+	respells = hegel.Composite(func(tc hegel.TestCase) respell {
+		return respell{key: hegel.Draw(tc, positions), eq: hegel.Draw(tc, chance(50)), sp: hegel.Draw(tc, comparatorSpellings), gaps: hegel.Draw(tc, gapLists)}
+	})
+	// comparators: the version depends on the operator (its segment counts
+	// under HEGEL_NO_KNOWN=1), hence the dependent draw.
+	comparators = hegel.Composite(func(tc hegel.TestCase) comparator {
+		op := hegel.Draw(tc, operators)
+		vers := comparatorVersions
+		if op == "~>" {
+			vers = pessimisticVersions
+		}
+		return comparator{op: op, ver: hegel.Draw(tc, vers), sp: hegel.Draw(tc, comparatorSpellings), gaps: hegel.Draw(tc, gapLists), alt: hegel.Draw(tc, respells)}
+	})
+	// constraints: one to three comparators.
+	constraints = hegel.Map(many(comparators, 1, 3), func(cs []comparator) constraintModel { return constraintModel{comps: cs} })
+)
+
+func versionsOf(counts hegel.Generator[int]) hegel.Generator[hv] {
+	segs := hegel.FlatMap(counts, func(k int) hegel.Generator[[]int64] { return fixed(smallSegments, k) })
+	return hegel.Composite(func(tc hegel.TestCase) hv {
+		return hv{segs: hegel.Draw(tc, segs), pre: hegel.Draw(tc, maybe(25, prePool)), meta: hegel.Draw(tc, maybe(10, metaLists))}
+	})
+}
+
+// checkSpec: how the checked version derives from the constraint: from the
+// version of the comparator at base (modulo their number), with fresh
+// segments instead 30% of the time, else each segment one down (0), one up
+// (1) or as it is, and one more segment (count 0, the tail) or one fewer
+// (1) or as many; its own pre-release from the pool 35% of the time and
+// metadata 15%.
+type checkSpec struct {
+	base   int
+	fresh  []int64
+	nudges []int
+	count  int
+	tail   int64
+	pre    []string
+	meta   []string
+}
+
+var (
+	freshSegments = hegel.FlatMap(hegel.Integers(1, 4), func(k int) hegel.Generator[[]int64] { return fixed(hegel.Integers[int64](0, 4), k) })
+	checkSpecs    = hegel.Composite(func(tc hegel.TestCase) checkSpec {
+		return checkSpec{
+			base:   hegel.Draw(tc, positions),
+			fresh:  hegel.Draw(tc, maybe(30, freshSegments)),
+			nudges: hegel.Draw(tc, fixed(hegel.Integers(0, 4), 5)),
+			count:  hegel.Draw(tc, hegel.Integers(0, 5)),
+			tail:   hegel.Draw(tc, hegel.Integers[int64](0, 2)),
+			pre:    hegel.Draw(tc, maybe(35, prePool)),
+			meta:   hegel.Draw(tc, maybe(15, metaLists)),
+		}
+	})
+)
+
+// derive is the checked version of the spec against the constraint.
+func (s checkSpec) derive(c constraintModel) hv {
+	v := hv{segs: slices.Clone(c.comps[s.base%len(c.comps)].ver.segs), pre: s.pre, meta: s.meta}
+	if s.fresh != nil {
+		v.segs = slices.Clone(s.fresh)
+		return v
+	}
+	for i := range v.segs {
+		switch s.nudges[i] {
+		case 0:
+			if v.segs[i] > 0 {
+				v.segs[i]--
+			}
+		case 1:
+			v.segs[i]++
+		}
+	}
+	switch s.count {
+	case 0:
+		if len(v.segs) < 5 {
+			v.segs = append(v.segs, s.tail)
+		}
+	case 1:
+		if len(v.segs) > 1 {
+			v.segs = v.segs[:len(v.segs)-1]
+		}
+	}
+	return v
+}
+
+// unpinCheck is v moved off the shapes of go-version/1, /2 and /8 against
+// the constraint's comparators (HEGEL_NO_KNOWN=1): the same value written
+// with another number of segments is written with the comparator's, and a
+// pre-release extending a comparator's with an alphanumeric identifier (or
+// extended by it) becomes the comparator's.
+func unpinCheck(v hv, c constraintModel) hv {
+	for _, cc := range c.comps {
+		v = unpinned(cc.ver, v)
+		if cc.op == "~>" && cmpSegs(v.segs, cc.ver.segs) == 0 && len(cc.ver.padded()) > len(v.padded()) {
+			v.segs = slices.Clone(cc.ver.segs)
+		}
+	}
+	return v
+}
+
+// constraintCase: a constraint and the spec of the version checked against it.
+type constraintCase struct {
+	model constraintModel
+	spec  checkSpec
+}
+
+var constraintCases = hegel.Composite(func(tc hegel.TestCase) constraintCase {
+	return constraintCase{model: hegel.Draw(tc, constraints), spec: hegel.Draw(tc, checkSpecs)}
+})
+
+// ver is the checked version, under HEGEL_NO_KNOWN=1 moved off the known shapes.
+func (c constraintCase) ver() hv {
+	v := c.spec.derive(c.model)
+	if noKnown {
+		v = unpinCheck(v, c.model)
+	}
+	return v
+}
+
+func (c constraintCase) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", c.model.text(), c.ver().canon())
+}
+
+// ---------------------------------------------------------------------------
+// Property: constraints follow the package's rules.
+
+func TestHegelConstraintsFollowTheirRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, constraintCases)
+		model, v := c.model, c.ver()
+		text := model.text()
+
+		cs, err := version.NewConstraint(text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", text, err)
+			return
+		}
+		if len(cs) != len(model.comps) {
+			fail(ht, "NewConstraint(%q) has %d constraints, want %d", text, len(cs), len(model.comps))
+			return
+		}
+		sv := mustV(v.canon())
+		want := model.satisfied(v)
+		got := cs.Check(sv)
+		if got != want {
+			mismatch(ht, model.shapes(v), "%q.Check(%q) = %v, want %v", text, v.canon(), got, want)
+		}
+		for i, cc := range model.comps {
+			if g, w := cs[i].Check(sv), cc.holds(v); g != w {
+				mismatch(ht, comparatorShapes(v, cc), "constraint %q (of %q).Check(%q) = %v, want %v", cc.text(), text, v.canon(), g, w)
+			}
+			if cs[i].Prerelease() != (len(cc.ver.pre) > 0) {
+				fail(ht, "constraint %q.Prerelease() = %v", cc.text(), cs[i].Prerelease())
+			}
+			if cs[i].String() != cc.text() {
+				fail(ht, "constraint %q.String() = %q", cc.text(), cs[i].String())
+			}
+		}
+
+		// The printed constraints read back the same.
+		printed := cs.String()
+		cs2, err := version.NewConstraint(printed)
+		if err != nil {
+			fail(ht, "NewConstraint(%q) (String of %q): %v", printed, text, err)
+			return
+		}
+		if g2 := cs2.Check(sv); g2 != got {
+			fail(ht, "%q reprinted as %q: Check(%q) %v vs %v", text, printed, v.canon(), g2, got)
+		}
+		if !cs.Equals(cs2) || !cs2.Equals(cs) {
+			fail(ht, "%q is not Equals to its own String %q", text, printed)
+		}
+
+		// Equals ignores whitespace, the `v` prefix and zero padding, and
+		// the order of the constraints.
+		altText := model.altText()
+		cs3, err := version.NewConstraint(altText)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", altText, err)
+			return
+		}
+		if !cs.Equals(cs3) {
+			mismatch(ht, model.pairShapes(), "%q is not Equals to %q", text, altText)
+		}
+		if g3 := cs3.Check(sv); g3 != got {
+			fail(ht, "%q rewritten as %q: Check(%q) %v vs %v", text, altText, v.canon(), g3, got)
+		}
+		if mc := version.MustConstraints(version.NewConstraint(text)); mc.String() != printed {
+			fail(ht, "MustConstraints(%q).String() = %q", text, mc.String())
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins for the known bugs. Each is expected to fail at the pinned commit.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func mustV(s string) *version.Version { return version.Must(version.NewVersion(s)) }
+
+func checkConstraint(t *testing.T, c, v string, want bool) {
+	t.Helper()
+	cs, err := version.NewConstraint(c)
+	if err != nil {
+		t.Errorf("NewConstraint(%q): %v", c, err)
+		return
+	}
+	if got := cs.Check(mustV(v)); got != want {
+		t.Errorf("%q.Check(%s) = %v, want %v", c, v, got, want)
+	}
+}
+
+// go-version/1: comparePart treats a missing identifier as greater than an
+// alphanumeric one, so 1.0.0-alpha > 1.0.0-alpha.beta, where the spec's own
+// example (item 11) has 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta:
+// "a larger set of pre-release fields has a higher precedence than a
+// smaller set, if all of the preceding identifiers are equal". The upstream
+// table asserts the inverted order for "5.4-alpha" vs "5.4-alpha.beta".
+func TestHegelPinShorterPrereleaseIsLower(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-alpha", "1.0.0-alpha.beta", -1},
+		{"1.0.0-alpha", "1.0.0-alpha.1", -1},
+		{"1.0.0-rc.1", "1.0.0-rc.1.x", -1},
+	}
+	for _, c := range cases {
+		if got := mustV(c.a).Compare(mustV(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+}
+
+// go-version/2: Compare only looks at the pre-release when both versions
+// have the same number of segments, so 1.0.0-alpha equals 1.0.0.0 (and
+// 1.0.0.0-rc equals 1.0.0) while 1.0.0-alpha < 1.0.0 = 1.0.0.0 - the order
+// is not transitive, `= 1.0.0.0` matches 1.0.0-alpha, and a Collection with
+// both spellings sorts the pre-releases anywhere.
+func TestHegelPinPrereleaseCountsWhateverTheSegmentCount(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-alpha", "1.0.0.0", -1},
+		{"1.0.0.0-rc", "1.0.0", -1},
+		{"1.0-beta", "1.0.0.0", -1},
+	}
+	for _, c := range cases {
+		if got := mustV(c.a).Compare(mustV(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+	checkConstraint(t, "= 1.0.0.0", "1.0.0-alpha", false)
+	checkConstraint(t, "!= 1.0.0.0", "1.0.0-alpha", true)
+}
+
+// go-version/3: numeric pre-release identifiers may carry leading zeros
+// (the spec forbids them; both parsers accept them) and are then compared
+// by length: 1.0.0-01 > 1.0.0-2 and 1.0.0-01 > 1.0.0-1.
+func TestHegelPinLeadingZeroIdentifiersCompareByValue(t *testing.T) {
+	defer guard(t)
+	if got := mustV("1.0.0-01").Compare(mustV("1.0.0-2")); got != -1 {
+		t.Errorf("Compare(1.0.0-01, 1.0.0-2) = %d, want -1 (or a parse error)", got)
+	}
+	if got := mustV("1.0.0-01").Compare(mustV("1.0.0-1")); got != 0 {
+		t.Errorf("Compare(1.0.0-01, 1.0.0-1) = %d, want 0 (or a parse error)", got)
+	}
+}
+
+// go-version/4: NewSemver "adheres strictly to SemVer specs" but accepts a
+// `v` prefix, one, two or four segments, leading zeros in segments and in
+// numeric pre-release identifiers, and `~` in identifiers; the only thing
+// it rejects beyond NewVersion is a pre-release without its hyphen.
+func TestHegelPinNewSemverIsStrict(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"v1.2.3", "1.2", "1", "1.2.3.4", "01.2.3", "1.02.3", "1.2.3-01", "1.2.3-a~b", "1.2.3+~"} {
+		if v, err := version.NewSemver(s); err == nil {
+			t.Errorf("NewSemver(%q) = %v, want an error", s, v)
+		}
+	}
+}
+
+// go-version/5: the pessimistic operator with a single segment is
+// unbounded: `~> 1` matches 2.0.0 and 5.3.1 (RubyGems: `~> 1` is
+// `>= 1, < 2`, as `~> 1.0` is `>= 1.0, < 2.0` here too). The last-segment
+// check runs on the zero-padded patch instead of the written segment.
+func TestHegelPinPessimisticSingleSegmentIsBounded(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~> 1", "1.5.2", true)
+	checkConstraint(t, "~> 1", "2.0.0", false)
+	checkConstraint(t, "~> 1", "5.3.1", false)
+	checkConstraint(t, "~> 0", "1.0.0", false)
+}
+
+// go-version/6: a trailing hyphen is accepted by NewVersion and becomes a
+// pre-release identifier "-" (the optional separator of the alphabetic
+// alternative is left out and the hyphen is taken as the identifier):
+// NewVersion("1.2.3-") prints "1.2.3--", NewVersion("1.2.3-.a") has the
+// pre-release "-.a". NewSemver rejects both.
+func TestHegelPinTrailingHyphenIsMalformed(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"1.2.3-", "1.2.3-.a", "1.2-"} {
+		if v, err := version.NewVersion(s); err == nil {
+			t.Errorf("NewVersion(%q) = %q (pre-release %q), want an error", s, v.String(), v.Prerelease())
+		}
+	}
+}
+
+// go-version/7: Scan accepts a string and nil only; the []byte that
+// database/sql drivers commonly deliver for text columns (MySQL, SQLite) is
+// "cannot scan []uint8 as Version".
+func TestHegelPinScanAcceptsBytes(t *testing.T) {
+	defer guard(t)
+	var v version.Version
+	if err := v.Scan([]byte("1.2.3")); err != nil {
+		t.Errorf("Scan([]byte(\"1.2.3\")): %v", err)
+	} else if v.String() != "1.2.3" {
+		t.Errorf("Scan([]byte(\"1.2.3\")) = %q", v.String())
+	}
+}
+
+// go-version/8: a pessimistic constraint with more segments than the
+// version never matches, even when the version equals the constraint:
+// `~> 0.3.0.0` rejects 0.3.0 (= 0.3.0.0), although `~> 0.3.0` accepts
+// 0.3.0.0 and `= 0.3.0.0` accepts 0.3.0.
+func TestHegelPinPessimisticAcceptsShorterEqualVersion(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~> 0.3.0.0", "0.3.0", true)
+	checkConstraint(t, "~> 1.2.3.0", "1.2.3", true)
+	checkConstraint(t, "~> 1.2.3.0", "1.2.3.1", true)
+}
