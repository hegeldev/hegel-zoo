+// ---------------------------------------------------------------------------
+// Property: precedence follows spec item 11; Collection sorts by it.
+
+func TestHegelPrecedenceFollowsTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := genVersion(ht)
+		b := genRelated(ht, a)
+		note(ht, "a %q  b %q", a.canon(), b.canon())
+		va := semver.MustParse(a.canon())
+		vb := semver.MustParse(b.canon())
+		want := a.cmp(b)
+		if got := va.Compare(vb); got != want {
+			fail(ht, "Compare(%q, %q) = %d, want %d", a.canon(), b.canon(), got, want)
+		}
+		if got := vb.Compare(va); got != -want {
+			fail(ht, "Compare(%q, %q) = %d, want %d", b.canon(), a.canon(), got, -want)
+		}
+		if va.LessThan(vb) != (want < 0) || va.LessThanEqual(vb) != (want <= 0) ||
+			va.GreaterThan(vb) != (want > 0) || va.GreaterThanEqual(vb) != (want >= 0) ||
+			va.Equal(vb) != (want == 0) {
+			fail(ht, "%q vs %q: LessThan %v LessThanEqual %v GreaterThan %v GreaterThanEqual %v Equal %v, Compare %d",
+				a.canon(), b.canon(), va.LessThan(vb), va.LessThanEqual(vb), va.GreaterThan(vb), va.GreaterThanEqual(vb), va.Equal(vb), want)
+		}
+
+		// A handful of related versions sort into model order.
+		k := n(ht, 2, 6)
+		models := []mv{a, b}
+		for len(models) < k {
+			models = append(models, genRelated(ht, pick(ht, models)))
+		}
+		coll := make(semver.Collection, len(models))
+		for i, m := range models {
+			coll[i] = semver.MustParse(m.canon())
+		}
+		sort.Sort(coll)
+		got := make([]string, len(coll))
+		for i, v := range coll {
+			got[i] = v.Original()
+		}
+		sort.SliceStable(models, func(i, j int) bool { return models[i].cmp(models[j]) < 0 })
+		for i := 1; i < len(coll); i++ {
+			pm := parseModel(ht, got[i-1])
+			cm := parseModel(ht, got[i])
+			if pm.cmp(cm) > 0 {
+				fail(ht, "Collection sorted %q before %q", got[i-1], got[i])
+			}
+		}
+		wantSet := make([]string, len(models))
+		for i, m := range models {
+			wantSet[i] = m.canon()
+		}
+		sortedGot := append([]string(nil), got...)
+		sort.Strings(sortedGot)
+		sort.Strings(wantSet)
+		if strings.Join(sortedGot, " ") != strings.Join(wantSet, " ") {
+			fail(ht, "Collection lost elements: %v vs %v", got, wantSet)
+		}
+	})
+}
+
+// parseModel reads a canonical version text back into the model.
+func parseModel(ht *hegel.T, s string) mv {
+	var m mv
+	if i := strings.IndexByte(s, '+'); i >= 0 {
+		m.meta = strings.Split(s[i+1:], ".")
+		s = s[:i]
+	}
+	if i := strings.IndexByte(s, '-'); i >= 0 {
+		m.pre = strings.Split(s[i+1:], ".")
+		s = s[:i]
+	}
+	parts := strings.Split(s, ".")
+	if len(parts) != 3 {
+		fail(ht, "parseModel(%q): not three segments", s)
+		return m
+	}
+	m.major, _ = strconv.ParseUint(parts[0], 10, 64)
+	m.minor, _ = strconv.ParseUint(parts[1], 10, 64)
+	m.patch, _ = strconv.ParseUint(parts[2], 10, 64)
+	return m
+}
+
+// ---------------------------------------------------------------------------
+// Property: the increment and set functions follow their doc comments.
+
+func TestHegelIncrementsFollowTheDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		text := m.canon()
+		prefix := ""
+		if chance(ht, 30) {
+			prefix = "v"
+			text = "v" + text
+		}
+		v := semver.MustParse(text)
+		note(ht, "version %q", text)
+
+		type inc struct {
+			name string
+			e    func() (semver.Version, error)
+			p    func() semver.Version
+			want mv
+			over bool
+		}
+		patch := mv{major: m.major, minor: m.minor, patch: m.patch}
+		if len(m.pre) == 0 {
+			patch.patch++
+		}
+		incs := []inc{
+			{"IncPatch", v.IncPatchE, v.IncPatch, patch, len(m.pre) == 0 && m.patch == math.MaxUint64},
+			{"IncMinor", v.IncMinorE, v.IncMinor, mv{major: m.major, minor: m.minor + 1}, m.minor == math.MaxUint64},
+			{"IncMajor", v.IncMajorE, v.IncMajor, mv{major: m.major + 1}, m.major == math.MaxUint64},
+		}
+		for _, in := range incs {
+			got, err := in.e()
+			if in.over {
+				if err == nil || !errors.Is(err, semver.ErrIncrementOverflow) {
+					fail(ht, "%sE(%q) on the maximum: %q, %v; want ErrIncrementOverflow", in.name, text, got.String(), err)
+				} else if got.String() != v.String() {
+					fail(ht, "%sE(%q) overflow returned %q, not the input", in.name, text, got.String())
+				}
+				panicked := false
+				func() {
+					defer func() { panicked = recover() != nil }()
+					in.p()
+				}()
+				if !panicked {
+					fail(ht, "%s(%q) on the maximum did not panic", in.name, text)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "%sE(%q): %v", in.name, text, err)
+				continue
+			}
+			if got.String() != in.want.canon() {
+				fail(ht, "%sE(%q) = %q, want %q", in.name, text, got.String(), in.want.canon())
+			}
+			if got.Original() != prefix+in.want.canon() {
+				fail(ht, "%sE(%q).Original() = %q, want %q", in.name, text, got.Original(), prefix+in.want.canon())
+			}
+			if p := in.p(); p.String() != got.String() || p.Original() != got.Original() {
+				fail(ht, "%s(%q) = %q (%q), differs from the E variant %q (%q)", in.name, text, p.String(), p.Original(), got.String(), got.Original())
+			}
+			if v.String() != m.canon() || v.Original() != text {
+				fail(ht, "%s mutated its receiver: %q (%q)", in.name, v.String(), v.Original())
+			}
+		}
+
+		// SetPrerelease / SetMetadata: valid values replace, invalid ones
+		// are refused and leave the version alone.
+		var pre []string
+		if chance(ht, 70) {
+			pre = genIdents(ht, 1, 3, genPreIdent)
+		}
+		badPre := chance(ht, 25)
+		preText := strings.Join(pre, ".")
+		if badPre {
+			preText = pick(ht, []string{"01", "a..b", "a.", ".a", "a b", "x+y", "0" + genNumericIdent(ht) + "1"})
+		}
+		sp, err := v.SetPrerelease(preText)
+		if badPre {
+			if err == nil {
+				fail(ht, "SetPrerelease(%q) accepted", preText)
+			}
+		} else if err != nil {
+			fail(ht, "SetPrerelease(%q): %v", preText, err)
+		} else {
+			want := mv{major: m.major, minor: m.minor, patch: m.patch, pre: pre, meta: m.meta}
+			if sp.String() != want.canon() || sp.Prerelease() != preText || sp.Original() != prefix+want.canon() {
+				fail(ht, "SetPrerelease(%q) on %q = %q (%q), want %q", preText, text, sp.String(), sp.Original(), want.canon())
+			}
+		}
+		var meta []string
+		if chance(ht, 70) {
+			meta = genIdents(ht, 1, 2, genMetaIdent)
+		}
+		badMeta := chance(ht, 25)
+		metaText := strings.Join(meta, ".")
+		if badMeta {
+			metaText = pick(ht, []string{"a..b", "a.", ".a", "a b", "x+y", "é"})
+		}
+		sm, err := v.SetMetadata(metaText)
+		if badMeta {
+			if err == nil {
+				fail(ht, "SetMetadata(%q) accepted", metaText)
+			}
+		} else if err != nil {
+			fail(ht, "SetMetadata(%q): %v", metaText, err)
+		} else {
+			want := mv{major: m.major, minor: m.minor, patch: m.patch, pre: m.pre, meta: meta}
+			if sm.String() != want.canon() || sm.Metadata() != metaText || sm.Original() != prefix+want.canon() {
+				fail(ht, "SetMetadata(%q) on %q = %q (%q), want %q", metaText, text, sm.String(), sm.Original(), want.canon())
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: the model.
+
+// cver is the version part of a comparator: a major, an optional minor
+// (absent or a wildcard), an optional patch, an optional pre-release (only
+// with all three segments) and an optional v prefix.
+type cver struct {
+	allWild                bool
+	major, minor, patch    uint64
+	minorAbsent, minorWild bool
+	patchAbsent, patchWild bool
+	pre                    []string
+	text                   string
+}
+
+// level is how much of the version is left open: 0 exact, 1 patch, 2 minor
+// and patch, 3 everything.
+func (c cver) level() int {
+	switch {
+	case c.allWild:
+		return 3
+	case c.minorAbsent || c.minorWild:
+		return 2
+	case c.patchAbsent || c.patchWild:
+		return 1
+	}
+	return 0
+}
+
+// lo is the lowest version the open segments filled with zeros.
+func (c cver) lo() mv {
+	m := mv{pre: c.pre}
+	if c.allWild {
+		return m
+	}
+	m.major = c.major
+	if c.minorAbsent || c.minorWild {
+		return m
+	}
+	m.minor = c.minor
+	if c.patchAbsent || c.patchWild {
+		return m
+	}
+	m.patch = c.patch
+	return m
+}
+
+var (
+	exactOps = []string{"", "=", "!=", ">", "<", ">=", "=>", "<=", "=<", "~", "~>", "^"}
+	// bareWildOps are the operators a bare wildcard is generated with; the
+	// others treat `*` as the version 0.0.0 (masterminds-semver/2, /3).
+	bareWildOps = []string{"", "=", ">=", "<", "~", "~>"}
+	prereleases = [][]string{{"0"}, {"alpha"}, {"beta", "2"}, {"rc", "1"}, {"-"}, {"a-b"}, {"RC"}}
+)
+
+// holds is the README's meaning of `op ver` for a version v.
+func holds(op string, c cver, v mv) bool {
+	lo := c.lo()
+	l := c.level()
+	sameMajor := v.major == lo.major
+	sameMinor := sameMajor && v.minor == lo.minor
+	switch op {
+	case "", "=":
+		switch l {
+		case 0:
+			return v.cmp(lo) == 0
+		case 1:
+			return sameMinor
+		case 2:
+			return sameMajor
+		}
+		return true
+	case "!=":
+		return !holds("=", c, v)
+	case ">":
+		switch l {
+		case 0:
+			return v.cmp(lo) > 0
+		case 1:
+			return v.major > lo.major || sameMajor && v.minor > lo.minor
+		case 2:
+			return v.major > lo.major
+		}
+		return false
+	case ">=", "=>":
+		return v.cmp(lo) >= 0
+	case "<":
+		return v.cmp(lo) < 0
+	case "<=", "=<":
+		switch l {
+		case 0:
+			return v.cmp(lo) <= 0
+		case 1:
+			return v.major < lo.major || sameMajor && v.minor <= lo.minor
+		case 2:
+			return v.major <= lo.major
+		}
+		return true
+	case "~", "~>":
+		if v.cmp(lo) < 0 {
+			return false
+		}
+		switch l {
+		case 0, 1:
+			return sameMinor
+		case 2:
+			return sameMajor
+		}
+		return true
+	case "^":
+		if v.cmp(lo) < 0 {
+			return false
+		}
+		switch l {
+		case 3:
+			return true
+		case 2:
+			return sameMajor
+		case 1:
+			if lo.major > 0 {
+				return sameMajor
+			}
+			return sameMinor
+		}
+		if lo.major > 0 {
+			return sameMajor
+		}
+		if lo.minor > 0 {
+			return sameMinor
+		}
+		return sameMinor && v.patch == lo.patch
+	}
+	panic("unknown operator " + op)
+}
+
+type item struct {
+	hyphen bool
+	op     string
+	a, b   cver
+	text   string
+}
+
+func (it item) holds(v mv) bool {
+	if it.hyphen {
+		return v.cmp(it.a.lo()) >= 0 && holds("<=", it.b, v)
+	}
+	return holds(it.op, it.a, v)
+}
+
+func (it item) hasPre() bool {
+	return len(it.a.pre) > 0 || it.hyphen && len(it.b.pre) > 0
+}
+
+type group struct {
+	items []item
+	text  string
+}
+
+type constraintModel struct {
+	groups     []group
+	text       string
+	includePre bool
+}
+
+func (c constraintModel) cvers() []cver {
+	var out []cver
+	for _, g := range c.groups {
+		for _, it := range g.items {
+			out = append(out, it.a)
+			if it.hyphen {
+				out = append(out, it.b)
+			}
+		}
+	}
+	return out
+}
+
+// satisfied is the README's rule: an OR of AND groups, and a pre-release
+// version is only considered by a group that mentions a pre-release itself
+// (or when IncludePrerelease is set).
+func (c constraintModel) satisfied(v mv) bool {
+	for _, g := range c.groups {
+		if len(v.pre) > 0 && !c.includePre {
+			hasPre := false
+			for _, it := range g.items {
+				hasPre = hasPre || it.hasPre()
+			}
+			if !hasPre {
+				continue
+			}
+		}
+		ok := true
+		for _, it := range g.items {
+			ok = ok && it.holds(v)
+		}
+		if ok {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: generators.
+
+func wildcard(tc hegel.TestCase) string { return pick(tc, []string{"x", "X", "*"}) }
+
+// genCVer draws a comparator version. With exact set, all three segments
+// are present and a pre-release may follow; otherwise segments may be
+// missing or wildcards.
+func genCVer(tc hegel.TestCase, exact bool) cver {
+	var c cver
+	if !exact && chance(tc, 8) {
+		c.allWild = true
+		c.text = wildcard(tc)
+		return c
+	}
+	c.major = uint64(n(tc, 0, 3))
+	s := strconv.FormatUint(c.major, 10)
+	k := 9
+	if !exact {
+		k = n(tc, 0, 9)
+	}
+	switch k {
+	case 0:
+		c.minorAbsent = true
+	case 1:
+		c.minorWild = true
+		s += "." + wildcard(tc)
+		if chance(tc, 30) {
+			s += "." + wildcard(tc)
+		}
+	default:
+		c.minor = uint64(n(tc, 0, 3))
+		s += "." + strconv.FormatUint(c.minor, 10)
+		k = 9
+		if !exact {
+			k = n(tc, 0, 9)
+		}
+		switch k {
+		case 0:
+			c.patchAbsent = true
+		case 1:
+			c.patchWild = true
+			s += "." + wildcard(tc)
+		default:
+			c.patch = uint64(n(tc, 0, 3))
+			s += "." + strconv.FormatUint(c.patch, 10)
+			if chance(tc, 30) {
+				c.pre = pick(tc, prereleases)
+				s += "-" + strings.Join(c.pre, ".")
+			}
+		}
+	}
+	if chance(tc, 15) {
+		s = "v" + s
+	}
+	c.text = s
+	return c
+}
+
+// genItem draws one comparator or, when ranges are allowed, a hyphen range.
+func genItem(tc hegel.TestCase, exact bool) item {
+	if !exact && chance(tc, 15) {
+		a, b := genCVer(tc, false), genCVer(tc, false)
+		for a.allWild {
+			a = genCVer(tc, false)
+		}
+		for b.allWild {
+			b = genCVer(tc, false)
+		}
+		return item{hyphen: true, a: a, b: b, text: a.text + " - " + b.text}
+	}
+	c := genCVer(tc, exact)
+	op := pick(tc, exactOps)
+	if c.allWild {
+		op = pick(tc, bareWildOps)
+	}
+	if (op == "~" || op == "~>") && c.level() == 0 && c.major == 0 && c.minor == 0 && c.patch == 0 {
+		// ~0.0.0 (with or without a pre-release) is pinned (masterminds-semver/4).
+		op = "="
+	}
+	sp := ""
+	if chance(tc, 30) {
+		sp = " "
+	}
+	return item{op: op, a: c, text: op + sp + c.text}
+}
+
+// genConstraint draws an OR of AND groups. With exact set every comparator
+// names a full version, the form whose meaning for pre-release versions is
+// unambiguous.
+func genConstraint(tc hegel.TestCase, exact bool) constraintModel {
+	var c constraintModel
+	ng := n(tc, 1, 3)
+	if chance(tc, 60) {
+		ng = 1
+	}
+	hasHyphen := false
+	for gi := 0; gi < ng; gi++ {
+		var g group
+		ni := n(tc, 1, 3)
+		if chance(tc, 50) {
+			ni = 1
+		}
+		for ii := 0; ii < ni; ii++ {
+			it := genItem(tc, exact)
+			if ii > 0 {
+				sep := pick(tc, []string{" ", ", ", ",", "  "})
+				if it.hyphen {
+					// A hyphen range after a blank-separated comparator is
+					// pinned (masterminds-semver/5).
+					sep = pick(tc, []string{", ", ","})
+				}
+				g.text += sep
+			}
+			g.text += it.text
+			g.items = append(g.items, it)
+			hasHyphen = hasHyphen || it.hyphen
+		}
+		c.groups = append(c.groups, g)
+	}
+	for gi, g := range c.groups {
+		if gi > 0 {
+			// `||` glued to a hyphen range is mis-tokenised (the version
+			// character class admits `|`; masterminds-semver/6), so with a
+			// range anywhere the OR is always blank-separated.
+			if hasHyphen {
+				c.text += " || "
+			} else {
+				c.text += pick(tc, []string{" || ", "||", " ||", "|| "})
+			}
+		}
+		c.text += g.text
+	}
+	if chance(tc, 20) {
+		c.text = " " + c.text
+	}
+	if chance(tc, 20) {
+		c.text += " "
+	}
+	c.includePre = chance(tc, 30)
+	return c
+}
+
+// genCheckVersion draws a version near the constraint's own versions.
+func genCheckVersion(tc hegel.TestCase, c constraintModel, withPre bool) mv {
+	var v mv
+	cvs := c.cvers()
+	if len(cvs) > 0 && chance(tc, 75) {
+		v = pick(tc, cvs).lo()
+		v.pre = nil
+		adjust := func(x uint64) uint64 {
+			switch n(tc, 0, 4) {
+			case 0:
+				if x > 0 {
+					return x - 1
+				}
+			case 1:
+				return x + 1
+			}
+			return x
+		}
+		v.major, v.minor, v.patch = adjust(v.major), adjust(v.minor), adjust(v.patch)
+	} else {
+		v = mv{major: uint64(n(tc, 0, 4)), minor: uint64(n(tc, 0, 4)), patch: uint64(n(tc, 0, 4))}
+	}
+	if withPre {
+		v.pre = pick(tc, prereleases)
+	}
+	if chance(tc, 15) {
+		v.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Property: constraints mean what the README says they mean.
+
+func TestHegelConstraintsMatchTheReadmeRanges(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		withPre := chance(ht, 35)
+		c := genConstraint(ht, withPre)
+		v := genCheckVersion(ht, c, withPre)
+		note(ht, "constraint %q (IncludePrerelease %v) version %q", c.text, c.includePre, v.canon())
+
+		cs, err := semver.NewConstraint(c.text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q): %v", c.text, err)
+			return
+		}
+		cs.IncludePrerelease = c.includePre
+		sv := semver.MustParse(v.canon())
+
+		want := c.satisfied(v)
+		got := cs.Check(sv)
+		if got != want {
+			fail(ht, "%q (IncludePrerelease %v).Check(%q) = %v, want %v", c.text, c.includePre, v.canon(), got, want)
+		}
+
+		ok, msgs := cs.Validate(sv)
+		if ok != got {
+			fail(ht, "%q.Validate(%q) = %v but Check = %v", c.text, v.canon(), ok, got)
+		}
+		if ok && len(msgs) != 0 || !ok && len(msgs) == 0 {
+			fail(ht, "%q.Validate(%q) = %v with %d messages %v", c.text, v.canon(), ok, len(msgs), msgs)
+		}
+
+		// The printed constraint reads back with the same meaning.
+		text := cs.String()
+		cs2, err := semver.NewConstraint(text)
+		if err != nil {
+			fail(ht, "NewConstraint(%q) (String of %q): %v", text, c.text, err)
+			return
+		}
+		cs2.IncludePrerelease = c.includePre
+		if g2 := cs2.Check(sv); g2 != got {
+			fail(ht, "%q reprinted as %q: Check(%q) %v vs %v", c.text, text, v.canon(), g2, got)
+		}
+		if cs2.String() != text {
+			fail(ht, "String is not stable: %q -> %q", text, cs2.String())
+		}
+		tb, err := cs.MarshalText()
+		if err != nil || string(tb) != text {
+			fail(ht, "MarshalText(%q) = %q, %v", c.text, tb, err)
+		}
+		var cs3 semver.Constraints
+		if err := cs3.UnmarshalText(tb); err != nil {
+			fail(ht, "UnmarshalText(%q): %v", tb, err)
+		} else {
+			cs3.IncludePrerelease = c.includePre
+			if g3 := cs3.Check(sv); g3 != got {
+				fail(ht, "UnmarshalText(%q).Check(%q) = %v, want %v", tb, v.canon(), g3, got)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins for the known bugs. Each is expected to fail at the pinned commit.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func checkConstraint(t *testing.T, c, v string, includePre, want bool) {
+	t.Helper()
+	cs, err := semver.NewConstraint(c)
+	if err != nil {
+		t.Errorf("NewConstraint(%q): %v", c, err)
+		return
+	}
+	cs.IncludePrerelease = includePre
+	if got := cs.Check(semver.MustParse(v)); got != want {
+		t.Errorf("%q.Check(%s) = %v, want %v", c, v, got, want)
+	}
+}
+
+// masterminds-semver/1: comparePrePart parses numeric identifiers with
+// strconv.ParseUint and treats any that overflow uint64 as alphanumeric, so
+// they compare as text: 100000000000000000000 sorts before
+// 99999999999999999999, and after the alphanumeric identifiers "-" and "0a"
+// although every numeric identifier precedes every alphanumeric one.
+func TestHegelPinHugeNumericIdentifiersCompareNumerically(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-100000000000000000000", "1.0.0-99999999999999999999", 1},
+		{"1.0.0-18446744073709551616", "1.0.0--", -1},
+		{"1.0.0-18446744073709551616", "1.0.0-0a", -1},
+	}
+	for _, c := range cases {
+		if got := semver.MustParse(c.a).Compare(semver.MustParse(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+}
+
+// masterminds-semver/2: `^*` (and `^x`, `^X`) is documented in the code as
+// "(any)" but the caret check falls through to the 0.0.z case and accepts
+// 0.0.0 only.
+func TestHegelPinCaretWildcardIsAnyVersion(t *testing.T) {
+	defer guard(t)
+	for _, c := range []string{"^*", "^x", "^X"} {
+		for _, v := range []string{"0.0.1", "0.1.0", "1.0.0", "2.3.4"} {
+			checkConstraint(t, c, v, false, true)
+		}
+	}
+}
+
+// masterminds-semver/3: a bare wildcard is the version 0.0.0 for `<=`, `>`
+// and `!=`: `<= *` accepts 0.0.z only, `> *` and `!= *` accept everything
+// but 0.0.0, where the wildcard matches every version (`*` is `>= 0.0.0`
+// and "works for all comparison operators").
+func TestHegelPinBareWildcardIsNotZero(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "<= *", "0.1.0", false, true)
+	checkConstraint(t, "<= *", "1.0.0", false, true)
+	checkConstraint(t, "<=x", "1.0.0", false, true)
+	checkConstraint(t, "> *", "0.0.1", false, false)
+	checkConstraint(t, "> *", "1.0.0", false, false)
+	checkConstraint(t, "!= *", "0.0.1", false, false)
+	checkConstraint(t, "!= *", "1.0.0", false, false)
+}
+
+// masterminds-semver/4: the special case meant for `~*` fires on any
+// constraint whose version is 0.0.0 with no wildcard, so `~0.0.0` and
+// `~0.0.0-alpha` accept every version instead of `>= 0.0.0, < 0.1.0`
+// (`~0.0.1` is `>= 0.0.1, < 0.1.0` as documented).
+func TestHegelPinTildeZeroIsAPatchRange(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~0.0.0", "0.0.5", false, true)
+	checkConstraint(t, "~0.0.0", "0.1.0", false, false)
+	checkConstraint(t, "~0.0.0", "5.0.0", false, false)
+	checkConstraint(t, "~0.0.0-alpha", "0.1.0", true, false)
+}
+
+// masterminds-semver/5: rewriteRange replaces `A - B` by `>= A, <= B ` but
+// swallows the blank before A, so a hyphen range that follows a
+// blank-separated comparator in the same AND group yields "1.2.3>= 1.2, <=
+// 1.4 " and an "improper constraint" error; a comma before the range works.
+func TestHegelPinHyphenRangeAfterBlankSeparatedComparator(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "1.2.3 1.2 - 1.4", "1.2.3", false, true)
+	checkConstraint(t, ">=1.0 1.2 - 1.4", "1.3.0", false, true)
+	checkConstraint(t, "<2 1.2 - 1.4", "1.3.0", false, true)
+}
+
+// masterminds-semver/6: the version character class of the constraint
+// regexes is `[0-9|x|X|\*]` — the `|` meant as alternation is a member —
+// so a `||` glued to a hyphen range is read as part of a version and the
+// constraint is "improper" ("1.2 - 1.4||2.0.1", "<2.3||0.1.2 - 3.1.1"),
+// while the same text with blanks around `||` parses.
+func TestHegelPinOrGluedToHyphenRange(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "1.2 - 1.4||2.0.1", "2.0.1", false, true)
+	checkConstraint(t, "1.2 - 1.4||2.0.1", "1.3.0", false, true)
+	checkConstraint(t, "<2.3||0.1.2 - 3.1.1", "2.5.0", false, true)
+	checkConstraint(t, "<2.3 || 0.1.2 - 3.1.1", "2.5.0", false, true)
+}
+
+// masterminds-semver/7: with IncludePrerelease, `!= 1.2.x` accepts
+// 1.2.3-alpha (the patch-wildcard branch calls two versions unequal when
+// their pre-releases differ) while `!= 1.x` rejects it; 1.2.3-alpha lies in
+// both ranges and should be rejected by both.
+func TestHegelPinNotEqualWildcardsAgreeOnPrereleases(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "!= 1.2.x", "1.2.3-alpha", true, false)
+	checkConstraint(t, "!= 1.x", "1.2.3-alpha", true, false)
+}
