+package semver_test
+
+// Hegel property tests for github.com/Masterminds/semver/v3.
+//
+// The oracle is Semantic Versioning 2.0.0 (semver.org) for parsing and
+// precedence — the grammar of a version and the identifier-by-identifier
+// precedence rules of item 11, implemented here as a small model — and the
+// package's own README for everything the spec leaves out: the coercions
+// NewVersion performs, the constraint syntax and the ranges each constraint
+// form is documented to stand for (`1.2.x` is `>= 1.2.0, < 1.3.0`, `~1.2.3`
+// is `>= 1.2.3, < 1.3.0`, `^0.2.3` is `>= 0.2.3, < 0.3.0`, `>= 1.2.x` is
+// `>= 1.2.0`, `<= 2.x` is `< 3`, and so on), the increment functions and the
+// prerelease rule of constraint checking.
+//
+// Set MASTERMINDS_SEMVER_COLLECT=1 to make the properties record mismatches
+// instead of failing and print them (shortest first) at the end of each test.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Masterminds/semver/v3"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("MASTERMINDS_SEMVER_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The model: a semantic version and spec precedence.
+
+// mv is a version as the spec sees it: three numeric segments, the dot
+// separated pre-release identifiers and the build identifiers.
+type mv struct {
+	major, minor, patch uint64
+	pre, meta           []string
+}
+
+func (a mv) canon() string {
+	s := fmt.Sprintf("%d.%d.%d", a.major, a.minor, a.patch)
+	if len(a.pre) > 0 {
+		s += "-" + strings.Join(a.pre, ".")
+	}
+	if len(a.meta) > 0 {
+		s += "+" + strings.Join(a.meta, ".")
+	}
+	return s
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func cmpInt[T uint64 | int](a, b T) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+// cmpIdent orders two pre-release identifiers per spec item 11: numeric
+// identifiers numerically (no leading zeros, so length then digits, whatever
+// the size), numeric before alphanumeric, alphanumeric in ASCII order.
+func cmpIdent(a, b string) int {
+	an, bn := isNumeric(a), isNumeric(b)
+	switch {
+	case an && bn:
+		if d := cmpInt(len(a), len(b)); d != 0 {
+			return d
+		}
+		return strings.Compare(a, b)
+	case an:
+		return -1
+	case bn:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+func (a mv) cmp(b mv) int {
+	if d := cmpInt(a.major, b.major); d != 0 {
+		return d
+	}
+	if d := cmpInt(a.minor, b.minor); d != 0 {
+		return d
+	}
+	if d := cmpInt(a.patch, b.patch); d != 0 {
+		return d
+	}
+	switch {
+	case len(a.pre) == 0 && len(b.pre) == 0:
+		return 0
+	case len(a.pre) == 0:
+		return 1
+	case len(b.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(a.pre) && i < len(b.pre); i++ {
+		if d := cmpIdent(a.pre[i], b.pre[i]); d != 0 {
+			return d
+		}
+	}
+	return cmpInt(len(a.pre), len(b.pre))
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+const (
+	alnumChars    = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	nonDigitChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	hugeSegment   = "18446744073709551616" // MaxUint64 + 1
+)
+
+// genSegment draws a numeric segment: mostly tiny (so that versions collide),
+// sometimes up to a thousand, sometimes anywhere in uint64 including the top.
+func genSegment(tc hegel.TestCase) uint64 {
+	switch n(tc, 0, 9) {
+	case 0:
+		return math.MaxUint64
+	case 1:
+		return uint64(wide(tc, 0, math.MaxInt64))*2 + uint64(n(tc, 0, 1))
+	case 2, 3:
+		return uint64(n(tc, 0, 1000))
+	}
+	return uint64(n(tc, 0, 3))
+}
+
+// genNumericIdent draws a numeric pre-release identifier. Values beyond
+// uint64 are valid identifiers but pinned separately (masterminds-semver/1),
+// so the general generator stays within uint64.
+func genNumericIdent(tc hegel.TestCase) string { return strconv.FormatUint(genSegment(tc), 10) }
+
+// genAlnumIdent draws an alphanumeric identifier: 1–5 characters from
+// [0-9A-Za-z-] with at least one non-digit. Leading zeros are fine here.
+func genAlnumIdent(tc hegel.TestCase) string {
+	k := n(tc, 1, 5)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = alnumChars[n(tc, 0, len(alnumChars)-1)]
+	}
+	if isNumeric(string(b)) {
+		b[n(tc, 0, k-1)] = nonDigitChars[n(tc, 0, len(nonDigitChars)-1)]
+	}
+	return string(b)
+}
+
+func genPreIdent(tc hegel.TestCase) string {
+	if chance(tc, 50) {
+		return genNumericIdent(tc)
+	}
+	return genAlnumIdent(tc)
+}
+
+// genMetaIdent draws a build identifier: any non-empty run of [0-9A-Za-z-],
+// leading zeros included.
+func genMetaIdent(tc hegel.TestCase) string {
+	k := n(tc, 1, 5)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = alnumChars[n(tc, 0, len(alnumChars)-1)]
+	}
+	return string(b)
+}
+
+func genIdents(tc hegel.TestCase, lo, hi int, gen func(hegel.TestCase) string) []string {
+	k := n(tc, lo, hi)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = gen(tc)
+	}
+	return out
+}
+
+func genVersion(tc hegel.TestCase) mv {
+	v := mv{major: genSegment(tc), minor: genSegment(tc), patch: genSegment(tc)}
+	if chance(tc, 40) {
+		v.pre = genIdents(tc, 1, 3, genPreIdent)
+	}
+	if chance(tc, 25) {
+		v.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return v
+}
+
+// genRelated draws a version close to a: usually the same core, a
+// pre-release derived from a's (dropped, extended, replaced or re-cased
+// identifiers) and independent metadata, so that every branch of the
+// precedence rules is exercised.
+func genRelated(tc hegel.TestCase, a mv) mv {
+	b := mv{major: a.major, minor: a.minor, patch: a.patch}
+	if chance(tc, 20) {
+		b = mv{major: genSegment(tc), minor: genSegment(tc), patch: genSegment(tc)}
+	}
+	switch n(tc, 0, 5) {
+	case 0:
+		// no pre-release
+	case 1:
+		b.pre = genIdents(tc, 1, 3, genPreIdent)
+	case 2:
+		if len(a.pre) > 0 {
+			b.pre = append([]string(nil), a.pre[:len(a.pre)-1]...)
+		}
+	case 3:
+		b.pre = append(append([]string(nil), a.pre...), genPreIdent(tc))
+	case 4:
+		b.pre = append([]string(nil), a.pre...)
+		if len(b.pre) > 0 {
+			b.pre[n(tc, 0, len(b.pre)-1)] = genPreIdent(tc)
+		}
+	default:
+		b.pre = append([]string(nil), a.pre...)
+		if len(b.pre) > 0 {
+			i := n(tc, 0, len(b.pre)-1)
+			if chance(tc, 50) {
+				b.pre[i] = strings.ToUpper(b.pre[i])
+			} else {
+				b.pre[i] = strings.ToLower(b.pre[i])
+			}
+		}
+	}
+	if chance(tc, 30) {
+		b.meta = genIdents(tc, 1, 2, genMetaIdent)
+	}
+	return b
+}
+
+// ---------------------------------------------------------------------------
+// Checks shared by the version properties.
+
+func checkParts(ht *hegel.T, what, text string, v *semver.Version, m mv) {
+	pre := strings.Join(m.pre, ".")
+	meta := strings.Join(m.meta, ".")
+	if v.Major() != m.major || v.Minor() != m.minor || v.Patch() != m.patch || v.Prerelease() != pre || v.Metadata() != meta {
+		fail(ht, "%s(%q): parts %d.%d.%d pre %q meta %q, want %d.%d.%d pre %q meta %q",
+			what, text, v.Major(), v.Minor(), v.Patch(), v.Prerelease(), v.Metadata(),
+			m.major, m.minor, m.patch, pre, meta)
+	}
+	if v.Original() != text {
+		fail(ht, "%s(%q).Original() = %q", what, text, v.Original())
+	}
+	if v.String() != m.canon() {
+		fail(ht, "%s(%q).String() = %q, want %q", what, text, v.String(), m.canon())
+	}
+}
+
+// withCoerce runs fn with the package-level CoerceNewVersion flag set to c.
+func withCoerce(c bool, fn func()) {
+	old := semver.CoerceNewVersion
+	semver.CoerceNewVersion = c
+	defer func() { semver.CoerceNewVersion = old }()
+	fn()
+}
+
+// ---------------------------------------------------------------------------
+// Property: strict versions parse by the spec, and survive every round trip.
+
+func TestHegelStrictVersionsParseByTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		s := m.canon()
+		note(ht, "version %q", s)
+
+		v, err := semver.StrictNewVersion(s)
+		if err != nil {
+			fail(ht, "StrictNewVersion(%q): %v", s, err)
+			return
+		}
+		checkParts(ht, "StrictNewVersion", s, v, m)
+
+		lv, err := semver.NewVersion(s)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", s, err)
+			return
+		}
+		checkParts(ht, "NewVersion", s, lv, m)
+
+		withCoerce(false, func() {
+			nv, err := semver.NewVersion(s)
+			if err != nil {
+				fail(ht, "NewVersion(%q) without coercion: %v", s, err)
+				return
+			}
+			checkParts(ht, "NewVersion[no coerce]", s, nv, m)
+		})
+
+		if !v.Equal(lv) || v.Compare(lv) != 0 {
+			fail(ht, "StrictNewVersion and NewVersion of %q are not Equal", s)
+		}
+		if v.Compare(v) != 0 || !v.Equal(v) || v.LessThan(v) || v.GreaterThan(v) || !v.LessThanEqual(v) || !v.GreaterThanEqual(v) {
+			fail(ht, "%q is not equal to itself", s)
+		}
+
+		// JSON: the canonical text as a JSON string, and back.
+		b, err := json.Marshal(v)
+		if err != nil || string(b) != strconv.Quote(s) {
+			fail(ht, "json.Marshal(%q) = %s, %v", s, b, err)
+		}
+		var back semver.Version
+		if err := json.Unmarshal(b, &back); err != nil || back.String() != s || back.Original() != s {
+			fail(ht, "json.Unmarshal(%s) = %q (%q), %v", b, back.String(), back.Original(), err)
+		}
+
+		// Text.
+		tb, err := v.MarshalText()
+		if err != nil || string(tb) != s {
+			fail(ht, "MarshalText(%q) = %q, %v", s, tb, err)
+		}
+		var tback semver.Version
+		if err := tback.UnmarshalText(tb); err != nil || tback.String() != s {
+			fail(ht, "UnmarshalText(%q) = %q, %v", tb, tback.String(), err)
+		}
+
+		// SQL.
+		val, err := v.Value()
+		if err != nil || val != s {
+			fail(ht, "Value(%q) = %v, %v", s, val, err)
+		}
+		var sc semver.Version
+		var src any = s
+		if chance(ht, 50) {
+			src = []byte(s)
+		}
+		if err := sc.Scan(src); err != nil || sc.String() != s || sc.Original() != s {
+			fail(ht, "Scan(%v) = %q (%q), %v", src, sc.String(), sc.Original(), err)
+		}
+
+		// MustParse agrees.
+		if mp := semver.MustParse(s); mp.String() != s {
+			fail(ht, "MustParse(%q).String() = %q", s, mp.String())
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: loose versions are coerced as the README says.
+
+func TestHegelLooseVersionsAreCoerced(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		seg := func(x uint64) string {
+			s := strconv.FormatUint(x, 10)
+			if chance(ht, 25) {
+				s = strings.Repeat("0", n(ht, 1, 2)) + s
+			}
+			return s
+		}
+		maj, min, pat := seg(m.major), seg(m.minor), seg(m.patch)
+		zeros := strings.HasPrefix(maj, "0") && maj != "0" ||
+			strings.HasPrefix(min, "0") && min != "0" ||
+			strings.HasPrefix(pat, "0") && pat != "0"
+		text := maj
+		switch n(ht, 0, 4) {
+		case 0:
+			m.minor, m.patch = 0, 0
+			zeros = strings.HasPrefix(maj, "0") && maj != "0"
+		case 1:
+			m.patch = 0
+			text += "." + min
+			zeros = strings.HasPrefix(maj, "0") && maj != "0" || strings.HasPrefix(min, "0") && min != "0"
+		default:
+			text += "." + min + "." + pat
+		}
+		if len(m.pre) > 0 {
+			text += "-" + strings.Join(m.pre, ".")
+		}
+		if len(m.meta) > 0 {
+			text += "+" + strings.Join(m.meta, ".")
+		}
+		if chance(ht, 40) {
+			text = "v" + text
+		}
+		note(ht, "text %q -> %q (leading zeros %v)", text, m.canon(), zeros)
+
+		v, err := semver.NewVersion(text)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", text, err)
+			return
+		}
+		checkParts(ht, "NewVersion", text, v, m)
+		if mp := semver.MustParse(text); mp.String() != m.canon() || mp.Original() != text {
+			fail(ht, "MustParse(%q) = %q (%q)", text, mp.String(), mp.Original())
+		}
+
+		// Without coercion a leading zero is the one thing that is refused;
+		// the v prefix and the missing segments are still accepted.
+		withCoerce(false, func() {
+			nv, err := semver.NewVersion(text)
+			if zeros {
+				if err == nil || nv != nil {
+					fail(ht, "NewVersion(%q) without coercion accepted a leading zero: %v", text, nv)
+				} else if !errors.Is(err, semver.ErrSegmentStartsZero) {
+					fail(ht, "NewVersion(%q) without coercion: %v, want ErrSegmentStartsZero", text, err)
+				}
+				return
+			}
+			if err != nil {
+				fail(ht, "NewVersion(%q) without coercion: %v", text, err)
+				return
+			}
+			checkParts(ht, "NewVersion[no coerce]", text, nv, m)
+		})
+
+		// The coerced form is a strict version and reads back equal.
+		sv, err := semver.StrictNewVersion(v.String())
+		if err != nil || !sv.Equal(v) || sv.String() != v.String() {
+			fail(ht, "StrictNewVersion(%q) = %v, %v", v.String(), sv, err)
+		}
+
+		// JSON and text unmarshal go through the same coercion.
+		var jv semver.Version
+		if err := json.Unmarshal([]byte(strconv.Quote(text)), &jv); err != nil || jv.String() != m.canon() || jv.Original() != text {
+			fail(ht, "json.Unmarshal(%q) = %q (%q), %v", text, jv.String(), jv.Original(), err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed versions are refused by every parser that should
+// refuse them, with a nil result.
+
+func TestHegelInvalidVersionsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := genVersion(ht)
+		s := m.canon()
+		segs := []string{strconv.FormatUint(m.major, 10), strconv.FormatUint(m.minor, 10), strconv.FormatUint(m.patch, 10)}
+		tail := ""
+		if len(m.pre) > 0 {
+			tail += "-" + strings.Join(m.pre, ".")
+		}
+		if len(m.meta) > 0 {
+			tail += "+" + strings.Join(m.meta, ".")
+		}
+		join := func(segs []string) string { return strings.Join(segs, ".") + tail }
+
+		var text, what string
+		strictOK, coerceOK, noCoerceOK := false, false, false
+		switch n(ht, 0, 15) {
+		case 0:
+			what, text = "v prefix", "v"+s
+			coerceOK, noCoerceOK = true, true
+		case 1:
+			what, text = "V prefix", "V"+s
+		case 2:
+			i := n(ht, 0, 2)
+			segs[i] = "0" + segs[i]
+			what, text = "leading zero in segment", join(segs)
+			coerceOK = true
+		case 3:
+			what, text = "missing patch", segs[0]+"."+segs[1]+tail
+			coerceOK, noCoerceOK = true, true
+		case 4:
+			what, text = "missing minor and patch", segs[0]+tail
+			coerceOK, noCoerceOK = true, true
+		case 5:
+			what, text = "four segments", join(append(segs, strconv.Itoa(n(ht, 0, 9))))
+		case 6:
+			// An empty pre-release identifier somewhere.
+			pre := append([]string(nil), m.pre...)
+			if len(pre) == 0 {
+				pre = []string{genPreIdent(ht)}
+			}
+			i := n(ht, 0, len(pre))
+			pre = append(pre[:i], append([]string{""}, pre[i:]...)...)
+			what = "empty pre-release identifier"
+			text = strings.Join(segs, ".") + "-" + strings.Join(pre, ".")
+			if len(m.meta) > 0 {
+				text += "+" + strings.Join(m.meta, ".")
+			}
+		case 7:
+			// An empty build identifier somewhere.
+			meta := append([]string(nil), m.meta...)
+			if len(meta) == 0 {
+				meta = []string{genMetaIdent(ht)}
+			}
+			i := n(ht, 0, len(meta))
+			meta = append(meta[:i], append([]string{""}, meta[i:]...)...)
+			what = "empty build identifier"
+			text = strings.Join(segs, ".")
+			if len(m.pre) > 0 {
+				text += "-" + strings.Join(m.pre, ".")
+			}
+			text += "+" + strings.Join(meta, ".")
+		case 8:
+			pre := append([]string(nil), m.pre...)
+			if len(pre) == 0 {
+				pre = []string{genNumericIdent(ht)}
+			}
+			i := n(ht, 0, len(pre)-1)
+			pre[i] = "0" + strconv.FormatUint(genSegment(ht), 10)
+			what = "numeric pre-release identifier with a leading zero"
+			text = strings.Join(segs, ".") + "-" + strings.Join(pre, ".")
+			if len(m.meta) > 0 {
+				text += "+" + strings.Join(m.meta, ".")
+			}
+		case 9:
+			ch := pick(ht, []string{" ", "_", "!", "/", ":", "\t", "\n", "é", "١", "٣", "。", "\x00"})
+			i := n(ht, 0, len(s))
+			what, text = fmt.Sprintf("character %q inserted", ch), s[:i]+ch+s[i:]
+		case 10:
+			what, text = "sign prefix", pick(ht, []string{"-", "+"})+s
+		case 11:
+			what, text = "empty", ""
+		case 12:
+			i := n(ht, 0, 2)
+			segs[i] = hugeSegment
+			what, text = "segment beyond uint64", join(segs)
+		case 13:
+			what = "second plus"
+			text = strings.Join(segs, ".")
+			if len(m.pre) > 0 {
+				text += "-" + strings.Join(m.pre, ".")
+			}
+			text += "+" + genMetaIdent(ht) + "+" + genMetaIdent(ht)
+		case 14:
+			what, text = "surrounding blank", pick(ht, []string{" " + s, s + " ", " " + s + " "})
+		default:
+			// A trailing hyphen after a pre-release or build identifier
+			// merely extends that identifier (hyphens are allowed), so it is
+			// only malformed after the numeric segments.
+			seps := []string{"+", "."}
+			if len(m.pre) == 0 && len(m.meta) == 0 {
+				seps = append(seps, "-")
+			}
+			what, text = "trailing separator", s+pick(ht, seps)
+		}
+		note(ht, "%s: %q (strict %v, coerce %v, no-coerce %v)", what, text, strictOK, coerceOK, noCoerceOK)
+
+		check := func(mode string, v *semver.Version, err error, ok bool) {
+			if ok {
+				if err != nil || v == nil {
+					fail(ht, "%s(%q) [%s]: refused: %v", mode, text, what, err)
+				}
+				return
+			}
+			if err == nil || v != nil {
+				fail(ht, "%s(%q) [%s]: accepted as %v (err %v)", mode, text, what, v, err)
+			}
+		}
+		v, err := semver.StrictNewVersion(text)
+		check("StrictNewVersion", v, err, strictOK)
+		v, err = semver.NewVersion(text)
+		check("NewVersion", v, err, coerceOK)
+		withCoerce(false, func() {
+			v, err := semver.NewVersion(text)
+			check("NewVersion[no coerce]", v, err, noCoerceOK)
+		})
+		if !coerceOK {
+			var jv semver.Version
+			if err := json.Unmarshal([]byte(strconv.Quote(text)), &jv); err == nil {
+				fail(ht, "json.Unmarshal(%q) [%s] accepted as %q", text, what, jv.String())
+			}
+			var tv semver.Version
+			if err := tv.UnmarshalText([]byte(text)); err == nil {
+				fail(ht, "UnmarshalText(%q) [%s] accepted as %q", text, what, tv.String())
+			}
+			func() {
+				defer func() {
+					if recover() == nil {
+						fail(ht, "MustParse(%q) [%s] did not panic", text, what)
+					}
+				}()
+				semver.MustParse(text)
+			}()
+		}
+	})
+}
