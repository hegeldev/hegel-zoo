diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..db864ad
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,272 @@
+package semver_test
+
+// One property per recorded bug (bugs.toml), each over the bug's shape
+// region alone, so that a run shows which bugs are open: by default it
+// fails on the recorded bug; under HEGEL_NO_KNOWN=1 it draws the
+// neighbouring region past the shape and passes. The wide properties in
+// hegel_test.go draw the same shapes at their natural rate, and the pins
+// there are the regression examples.
+
+import (
+	"fmt"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// single is a constraint of one comparator.
+func single(it item, includePre bool) constraintModel {
+	return constraintModel{groups: []group{{items: []item{it}}}, includePre: includePre}
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/1: numeric identifiers beyond uint64 compare as text.
+
+// hugeCase: two versions with the same core and the same identifiers around
+// one position, where one holds a numeric identifier beyond uint64 (within
+// uint64 under HEGEL_NO_KNOWN=1) and the other an identifier that sorts
+// differently as a number than as text: an alphanumeric one, a shorter
+// number, a longer one.
+type hugeCase struct {
+	core         mv
+	prefix, rest []string
+	huge, other  string
+}
+
+func (c hugeCase) pair() (mv, mv) {
+	a, b := c.core, c.core
+	a.pre = append(append(clonePre(c.prefix), c.huge), c.rest...)
+	b.pre = append(append(clonePre(c.prefix), c.other), c.rest...)
+	return a, b
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hugeCase) GoString() string {
+	a, b := c.pair()
+	return fmt.Sprintf("versions %q and %q", a.canon(), b.canon())
+}
+
+var (
+	otherIdents = hegel.SampledFrom([]string{"-", "0a", "-a", "0-0", "9", "99999999999999999999"})
+	hugeCases   = hegel.Composite(func(tc hegel.TestCase) hugeCase {
+		return hugeCase{
+			core:   hegel.Draw(tc, cores),
+			prefix: hegel.Draw(tc, many(preIdents, 0, 1)),
+			rest:   hegel.Draw(tc, many(preIdents, 0, 1)),
+			huge:   hegel.Draw(tc, shaped(hugeNumerics, segmentTexts)),
+			other:  hegel.Draw(tc, otherIdents),
+		}
+	})
+)
+
+func TestHegelHugeNumericIdentifiersCompareNumerically(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a, b := hegel.Draw(ht, hugeCases).pair()
+		comparesLike(ht, a, b, known("masterminds-semver/1"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/2: `^*` accepts 0.0.0 only.
+
+// wildCase: a comparator over a bare wildcard (a minor or patch wildcard
+// under HEGEL_NO_KNOWN=1) under an operator of ops, and a small release
+// version to check.
+type wildCase struct {
+	it item
+	v  mv
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c wildCase) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", single(c.it, false).text(), c.v.canon())
+}
+
+func wildCasesOf(ops hegel.Generator[int], vers hegel.Generator[cver]) hegel.Generator[wildCase] {
+	return hegel.Composite(func(tc hegel.TestCase) wildCase {
+		return wildCase{it: hegel.Draw(tc, comparatorsOf(vers, ops)), v: hegel.Draw(tc, smallCores)}
+	})
+}
+
+var caretWildCases = wildCasesOf(hegel.Just(opIndex("^")), cversOf(hegel.Just(shaped(allWild, minorWild))))
+
+func TestHegelCaretWildcardIsAnyVersion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, caretWildCases)
+		constraintAgrees(ht, single(c.it, false), c.v, nil, known("masterminds-semver/2"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/3: `<= *`, `> *` and `!= *` treat `*` as 0.0.0.
+
+var (
+	zeroWildOps   = hegel.SampledFrom([]int{opIndex("<="), opIndex("=<"), opIndex(">"), opIndex("!=")})
+	zeroWildCases = wildCasesOf(zeroWildOps, cversOf(hegel.Just(shaped(allWild, patchWild))))
+)
+
+func TestHegelBareWildcardIsNotZero(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroWildCases)
+		constraintAgrees(ht, single(c.it, false), c.v, nil, known("masterminds-semver/3"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/4: `~0.0.0` accepts everything.
+
+// tildeCase: `~` or `~>` over 0.0.0 (0.0.1 to 0.0.3 under HEGEL_NO_KNOWN=1),
+// with a pre-release 30% of the time, and a small release version.
+var (
+	tildeOps  = hegel.SampledFrom([]int{opIndex("~"), opIndex("~>")})
+	tildeVers = hegel.Composite(func(tc hegel.TestCase) cver {
+		return cver{
+			open:  full,
+			patch: hegel.Draw(tc, shaped(hegel.Just[uint64](0), hegel.Integers[uint64](1, 3))),
+			pre:   hegel.Draw(tc, maybe(30, hegel.SampledFrom(prereleases))),
+			v:     hegel.Draw(tc, chance(15)),
+		}
+	})
+	tildeCases = wildCasesOf(tildeOps, tildeVers)
+)
+
+func TestHegelTildeZeroIsAPatchRange(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tildeCases)
+		constraintAgrees(ht, single(c.it, false), c.v, nil, known("masterminds-semver/4"))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/5: a hyphen range after a blank-separated comparator.
+
+// blankRangeCase: an AND group of a comparator and a hyphen range, the two
+// separated by blanks (a comma under HEGEL_NO_KNOWN=1), and a small release
+// version.
+type blankRangeCase struct {
+	first, rng item
+	v          mv
+}
+
+func (c blankRangeCase) model() constraintModel {
+	return constraintModel{groups: []group{{items: []item{c.first, c.rng}}}}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c blankRangeCase) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", c.model().text(), c.v.canon())
+}
+
+var (
+	// blankSeps: the indices of the blank separators in itemSeps.
+	blankSeps       = hegel.SampledFrom([]int{0, 3})
+	blankRangeCases = hegel.Composite(func(tc hegel.TestCase) blankRangeCase {
+		rng := hegel.Draw(tc, hyphenRanges)
+		rng.sep = hegel.Draw(tc, blankSeps)
+		return blankRangeCase{first: hegel.Draw(tc, comparatorsOf(exactVers, opIndices)), rng: rng, v: hegel.Draw(tc, smallCores)}
+	})
+)
+
+func TestHegelHyphenRangeAfterBlankSeparatedComparator(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, blankRangeCases)
+		m := c.model()
+		constraintAgrees(ht, m, c.v, known("masterminds-semver/5"), m.checkShapes(c.v))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/6: a `||` glued to a hyphen range.
+
+// glue is how the `||` touches the range: written `||` with the range on
+// its left or right, or ` ||` with the range on its right (`|| ` never
+// fails, nor ` ||` after a range).
+type glue struct {
+	or         int
+	rangeRight bool
+}
+
+// gluedCase: two OR groups, a comparator and a hyphen range, joined by a
+// `||` glued to the range (blank-separated under HEGEL_NO_KNOWN=1), and a
+// small release version.
+type gluedCase struct {
+	cmp, rng item
+	g        glue
+	v        mv
+}
+
+func (c gluedCase) model() constraintModel {
+	left, right := c.rng, c.cmp
+	if c.g.rangeRight {
+		left, right = c.cmp, c.rng
+	}
+	return constraintModel{groups: []group{{items: []item{left}}, {items: []item{right}, or: c.g.or}}}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c gluedCase) GoString() string {
+	return fmt.Sprintf("constraint %q version %q", c.model().text(), c.v.canon())
+}
+
+var (
+	glues      = hegel.SampledFrom([]glue{{1, false}, {1, true}, {2, true}})
+	gluedCases = hegel.Composite(func(tc hegel.TestCase) gluedCase {
+		return gluedCase{
+			cmp: hegel.Draw(tc, comparatorsOf(exactVers, opIndices)),
+			rng: hegel.Draw(tc, hyphenRanges),
+			g:   hegel.Draw(tc, glues),
+			v:   hegel.Draw(tc, smallCores),
+		}
+	})
+)
+
+func TestHegelOrGluedToHyphenRange(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, gluedCases)
+		m := c.model()
+		constraintAgrees(ht, m, c.v, known("masterminds-semver/6"), m.checkShapes(c.v))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// masterminds-semver/7: `!= 1.2.x` with IncludePrerelease accepts
+// 1.2.3-alpha.
+
+// notEqualPreCase: `!=` over a patch wildcard or an absent patch (a minor
+// one under HEGEL_NO_KNOWN=1), checked with IncludePrerelease against a
+// pre-release version of the same major and minor and a small patch.
+type notEqualPreCase struct {
+	it    item
+	patch uint64
+	pre   []string
+}
+
+func (c notEqualPreCase) version() mv {
+	v := c.it.a.lo()
+	v.patch = c.patch
+	v.pre = c.pre
+	return v
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c notEqualPreCase) GoString() string {
+	return fmt.Sprintf("constraint %q (IncludePrerelease true) version %q", single(c.it, true).text(), c.version().canon())
+}
+
+var (
+	notEqualShapes   = shaped(hegel.SampledFrom([]openness{patchWild, patchAbsent}), hegel.SampledFrom([]openness{minorWild, minorAbsent}))
+	notEqualPreCases = hegel.Composite(func(tc hegel.TestCase) notEqualPreCase {
+		return notEqualPreCase{
+			it:    hegel.Draw(tc, comparatorsOf(cversOf(notEqualShapes), hegel.Just(opIndex("!=")))),
+			patch: hegel.Draw(tc, smallSegments),
+			pre:   hegel.Draw(tc, hegel.SampledFrom(prereleases)),
+		}
+	})
+)
+
+func TestHegelNotEqualWildcardsAgreeOnPrereleases(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, notEqualPreCases)
+		constraintAgrees(ht, single(c.it, true), c.version(), nil, known("masterminds-semver/7"))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..e0256ea
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2028 @@
+package semver_test
+
+// Hegel property tests for github.com/Masterminds/semver/v3.
+//
+// The oracle is Semantic Versioning 2.0.0 (semver.org) for parsing and
+// precedence - the grammar of a version and the identifier-by-identifier
+// precedence rules of item 11, implemented here as a small model - and the
+// package's own README for everything the spec leaves out: the coercions
+// NewVersion performs, the constraint syntax and the ranges each constraint
+// form is documented to stand for (`1.2.x` is `>= 1.2.0, < 1.3.0`, `~1.2.3`
+// is `>= 1.2.3, < 1.3.0`, `^0.2.3` is `>= 0.2.3, < 0.3.0`, `>= 1.2.x` is
+// `>= 1.2.0`, `<= 2.x` is `< 3`, and so on), the increment functions and the
+// prerelease rule of constraint checking.
+//
+// Every property draws one case record built from the binding's combinators
+// (a version; a version with its relatives; a loosely written version; a
+// version and the damage done to it; a constraint tree and the version to
+// check against it) and renders it with pure functions, so a failing case is
+// a small record, not a transcript of draws. The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the properties that meet
+// them fail, naming the shape, and are the expected failures mapped to the
+// bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug
+// over its shape region alone, and the pins at the end of this file are the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Set MASTERMINDS_SEMVER_COLLECT=1 to make the properties record mismatches
+// instead of failing and print them (shortest first) at the end of each test.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Masterminds/semver/v3"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// collected is the panic value fail() raises in collect mode; property()
+// swallows it so that the case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("MASTERMINDS_SEMVER_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the shapes are left out of the generators (shaped, and the rendering rules
+// that consult noKnown) and a mismatch that still has a known shape is
+// skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known
+// shape is skipped instead (rare then, since the generators leave the shapes
+// out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// cat draws one string from each generator and joins them: the pieces of a
+// token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// dec is the decimal text of a segment generator.
+func dec(g hegel.Generator[uint64]) hegel.Generator[string] {
+	return hegel.Map(g, func(x uint64) string { return strconv.FormatUint(x, 10) })
+}
+
+// as widens a generator's values to the interface I (for the alternatives of
+// a sum type chosen by OneOf).
+func as[I any, T any](g hegel.Generator[T]) hegel.Generator[I] {
+	return hegel.Map(g, func(x T) I { return any(x).(I) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// ---------------------------------------------------------------------------
+// The model: a semantic version and spec precedence.
+
+// mv is a version as the spec sees it: three numeric segments, the dot
+// separated pre-release identifiers and the build identifiers.
+type mv struct {
+	major, minor, patch uint64
+	pre, meta           []string
+}
+
+// tail is the pre-release and build part of the version's text.
+func (a mv) tail() string {
+	s := ""
+	if len(a.pre) > 0 {
+		s += "-" + strings.Join(a.pre, ".")
+	}
+	if len(a.meta) > 0 {
+		s += "+" + strings.Join(a.meta, ".")
+	}
+	return s
+}
+
+func (a mv) canon() string {
+	return fmt.Sprintf("%d.%d.%d", a.major, a.minor, a.patch) + a.tail()
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// beyondUint64 reports a numeric identifier the library cannot parse as a
+// uint64 (the shape of masterminds-semver/1: it compares as text then).
+func beyondUint64(s string) bool {
+	return isNumeric(s) && (len(s) > 20 || len(s) == 20 && s > "18446744073709551615")
+}
+
+func cmpInt[T uint64 | int](a, b T) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+// cmpIdent orders two pre-release identifiers per spec item 11: numeric
+// identifiers numerically (no leading zeros, so length then digits, whatever
+// the size), numeric before alphanumeric, alphanumeric in ASCII order.
+func cmpIdent(a, b string) int {
+	an, bn := isNumeric(a), isNumeric(b)
+	switch {
+	case an && bn:
+		if d := cmpInt(len(a), len(b)); d != 0 {
+			return d
+		}
+		return strings.Compare(a, b)
+	case an:
+		return -1
+	case bn:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+func (a mv) cmp(b mv) int {
+	if d := cmpInt(a.major, b.major); d != 0 {
+		return d
+	}
+	if d := cmpInt(a.minor, b.minor); d != 0 {
+		return d
+	}
+	if d := cmpInt(a.patch, b.patch); d != 0 {
+		return d
+	}
+	switch {
+	case len(a.pre) == 0 && len(b.pre) == 0:
+		return 0
+	case len(a.pre) == 0:
+		return 1
+	case len(b.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(a.pre) && i < len(b.pre); i++ {
+		if d := cmpIdent(a.pre[i], b.pre[i]); d != 0 {
+			return d
+		}
+	}
+	return cmpInt(len(a.pre), len(b.pre))
+}
+
+// ---------------------------------------------------------------------------
+// Generators: versions.
+
+const (
+	alnumChars  = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
+	digitChars  = "0123456789"
+	hugeSegment = "18446744073709551616" // MaxUint64 + 1
+)
+
+var (
+	// segments: a numeric segment: 0 to 3 six times in ten (so that versions
+	// collide), up to a thousand twice, anywhere in uint64 once, and at the
+	// top once (the overflow shape of the increments).
+	segments = weighted(
+		choice[uint64]{6, hegel.Integers[uint64](0, 3)},
+		choice[uint64]{2, hegel.Integers[uint64](0, 1000)},
+		choice[uint64]{1, hegel.Integers[uint64](0, math.MaxUint64)},
+		choice[uint64]{1, hegel.Integers[uint64](math.MaxUint64-1, math.MaxUint64)},
+	)
+	segmentTexts = dec(segments)
+	// hugeNumerics: a numeric identifier beyond uint64 (the shape of
+	// masterminds-semver/1): the numbers around the boundary, or 21 to 25
+	// digits without a leading zero.
+	hugeNumerics = hegel.OneOf(
+		hegel.SampledFrom([]string{hugeSegment, "99999999999999999999", "100000000000000000000"}),
+		cat(hegel.Text().Alphabet("123456789").MinSize(1).MaxSize(1), hegel.Text().Alphabet(digitChars).MinSize(20).MaxSize(24)),
+	)
+	// numericIdents: a numeric pre-release identifier: a segment's text, one
+	// time in four beyond uint64; under HEGEL_NO_KNOWN=1 within uint64 only.
+	numericIdents = shaped(weighted(choice[string]{3, segmentTexts}, choice[string]{1, hugeNumerics}), segmentTexts)
+	// alnumIdents: an alphanumeric identifier: 1 to 5 characters of
+	// [0-9A-Za-z-] with at least one non-digit (leading zeros are fine here).
+	alnumIdents = hegel.Filter(hegel.Text().Alphabet(alnumChars).MinSize(1).MaxSize(5), func(s string) bool { return !isNumeric(s) })
+	preIdents   = hegel.OneOf(numericIdents, alnumIdents)
+	// metaIdents: a build identifier: any non-empty run of [0-9A-Za-z-],
+	// leading zeros included.
+	metaIdents = hegel.Text().Alphabet(alnumChars).MinSize(1).MaxSize(5)
+	preLists   = many(preIdents, 1, 3)
+	metaLists  = many(metaIdents, 1, 2)
+	// cores: the three numeric segments of a version.
+	cores = hegel.Composite(func(tc hegel.TestCase) mv {
+		return mv{major: hegel.Draw(tc, segments), minor: hegel.Draw(tc, segments), patch: hegel.Draw(tc, segments)}
+	})
+	// versions: a spec version: a core, a pre-release 40% of the time and
+	// build metadata 25%.
+	versions = hegel.Composite(func(tc hegel.TestCase) mv {
+		v := hegel.Draw(tc, cores)
+		v.pre = hegel.Draw(tc, maybe(40, preLists))
+		v.meta = hegel.Draw(tc, maybe(25, metaLists))
+		return v
+	})
+)
+
+// ---------------------------------------------------------------------------
+// Generators: versions near a version.
+
+// preEdit derives the pre-release identifiers of a version near a from
+// a's, so that every branch of the precedence rules is exercised.
+type preEdit interface{ apply(pre []string) []string }
+
+type (
+	dropPre     struct{} // no pre-release
+	dropLast    struct{} // a's without its last identifier
+	recaseIdent struct {
+		at    int
+		upper bool
+	} // a's with the at-th (modulo their count) upper- or lower-cased
+	appendIdent  struct{ ident string } // a's and one more
+	replaceIdent struct {
+		at    int
+		ident string
+	} // a's with the at-th (modulo their count) replaced
+	freshPre struct{ idents []string } // fresh identifiers
+)
+
+func clonePre(pre []string) []string { return append([]string(nil), pre...) }
+
+func (dropPre) apply([]string) []string { return nil }
+
+func (dropLast) apply(pre []string) []string {
+	if len(pre) == 0 {
+		return nil
+	}
+	return clonePre(pre[:len(pre)-1])
+}
+
+func (e recaseIdent) apply(pre []string) []string {
+	out := clonePre(pre)
+	if len(out) > 0 {
+		i := e.at % len(out)
+		if e.upper {
+			out[i] = strings.ToUpper(out[i])
+		} else {
+			out[i] = strings.ToLower(out[i])
+		}
+	}
+	return out
+}
+
+func (e appendIdent) apply(pre []string) []string { return append(clonePre(pre), e.ident) }
+
+func (e replaceIdent) apply(pre []string) []string {
+	out := clonePre(pre)
+	if len(out) > 0 {
+		out[e.at%len(out)] = e.ident
+	}
+	return out
+}
+
+func (e freshPre) apply([]string) []string { return e.idents }
+
+// preEdits: the edits, plainest first.
+var preEdits = hegel.OneOf(
+	as[preEdit](hegel.Just(dropPre{})),
+	as[preEdit](hegel.Just(dropLast{})),
+	as[preEdit](hegel.Composite(func(tc hegel.TestCase) recaseIdent {
+		return recaseIdent{at: hegel.Draw(tc, positions), upper: hegel.Draw(tc, hegel.Booleans())}
+	})),
+	as[preEdit](hegel.Map(preIdents, func(s string) appendIdent { return appendIdent{s} })),
+	as[preEdit](hegel.Composite(func(tc hegel.TestCase) replaceIdent {
+		return replaceIdent{at: hegel.Draw(tc, positions), ident: hegel.Draw(tc, preIdents)}
+	})),
+	as[preEdit](hegel.Map(preLists, func(xs []string) freshPre { return freshPre{xs} })),
+)
+
+// relation: a version near a: a's core (or a fresh one 20% of the time),
+// a's pre-release edited, and its own metadata 30% of the time.
+type relation struct {
+	core *mv
+	edit preEdit
+	meta []string
+}
+
+func (r relation) apply(a mv) mv {
+	b := mv{major: a.major, minor: a.minor, patch: a.patch}
+	if r.core != nil {
+		b.major, b.minor, b.patch = r.core.major, r.core.minor, r.core.patch
+	}
+	b.pre = r.edit.apply(a.pre)
+	b.meta = r.meta
+	return b
+}
+
+var relations = hegel.Composite(func(tc hegel.TestCase) relation {
+	return relation{core: hegel.Draw(tc, optional(20, cores)), edit: hegel.Draw(tc, preEdits), meta: hegel.Draw(tc, maybe(30, metaLists))}
+})
+
+// hugeShape names masterminds-semver/1 when one of the versions holds a
+// numeric pre-release identifier beyond uint64.
+func hugeShape(ms ...mv) []string {
+	for _, m := range ms {
+		for _, id := range m.pre {
+			if beyondUint64(id) {
+				return []string{"masterminds-semver/1"}
+			}
+		}
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Checks shared by the version properties.
+
+func checkParts(ht *hegel.T, what, text string, v *semver.Version, m mv) {
+	pre := strings.Join(m.pre, ".")
+	meta := strings.Join(m.meta, ".")
+	if v.Major() != m.major || v.Minor() != m.minor || v.Patch() != m.patch || v.Prerelease() != pre || v.Metadata() != meta {
+		fail(ht, "%s(%q): parts %d.%d.%d pre %q meta %q, want %d.%d.%d pre %q meta %q",
+			what, text, v.Major(), v.Minor(), v.Patch(), v.Prerelease(), v.Metadata(),
+			m.major, m.minor, m.patch, pre, meta)
+	}
+	if v.Original() != text {
+		fail(ht, "%s(%q).Original() = %q", what, text, v.Original())
+	}
+	if v.String() != m.canon() {
+		fail(ht, "%s(%q).String() = %q, want %q", what, text, v.String(), m.canon())
+	}
+}
+
+// withCoerce runs fn with the package-level CoerceNewVersion flag set to c.
+func withCoerce(c bool, fn func()) {
+	old := semver.CoerceNewVersion
+	semver.CoerceNewVersion = c
+	defer func() { semver.CoerceNewVersion = old }()
+	fn()
+}
+
+// comparesLike checks Compare in both directions and the six comparison
+// methods against the model's precedence; shapes names the recorded bug the
+// pair has the shape of (none for a plain pair).
+func comparesLike(ht *hegel.T, a, b mv, shapes []string) {
+	va, vb := semver.MustParse(a.canon()), semver.MustParse(b.canon())
+	want := a.cmp(b)
+	if got := va.Compare(vb); got != want {
+		mismatch(ht, shapes, "Compare(%q, %q) = %d, want %d", a.canon(), b.canon(), got, want)
+	}
+	if got := vb.Compare(va); got != -want {
+		mismatch(ht, shapes, "Compare(%q, %q) = %d, want %d", b.canon(), a.canon(), got, -want)
+	}
+	if va.LessThan(vb) != (want < 0) || va.LessThanEqual(vb) != (want <= 0) ||
+		va.GreaterThan(vb) != (want > 0) || va.GreaterThanEqual(vb) != (want >= 0) ||
+		va.Equal(vb) != (want == 0) {
+		mismatch(ht, shapes, "%q vs %q: LessThan %v LessThanEqual %v GreaterThan %v GreaterThanEqual %v Equal %v, Compare %d",
+			a.canon(), b.canon(), va.LessThan(vb), va.LessThanEqual(vb), va.GreaterThan(vb), va.GreaterThanEqual(vb), va.Equal(vb), want)
+	}
+}
+
+// sortsLike checks that sort.Sort(Collection) orders the versions as the
+// model does and loses nothing.
+func sortsLike(ht *hegel.T, models []mv, shapes []string) {
+	coll := make(semver.Collection, len(models))
+	for i, m := range models {
+		coll[i] = semver.MustParse(m.canon())
+	}
+	sort.Sort(coll)
+	got := make([]string, len(coll))
+	for i, v := range coll {
+		got[i] = v.Original()
+	}
+	for i := 1; i < len(got); i++ {
+		if parseModel(ht, got[i-1]).cmp(parseModel(ht, got[i])) > 0 {
+			mismatch(ht, shapes, "Collection sorted %q before %q", got[i-1], got[i])
+		}
+	}
+	wantSet := make([]string, len(models))
+	for i, m := range models {
+		wantSet[i] = m.canon()
+	}
+	sortedGot := append([]string(nil), got...)
+	sort.Strings(sortedGot)
+	sort.Strings(wantSet)
+	if strings.Join(sortedGot, " ") != strings.Join(wantSet, " ") {
+		fail(ht, "Collection lost elements: %v vs %v", got, wantSet)
+	}
+}
+
+// parseModel reads a canonical version text back into the model.
+func parseModel(ht *hegel.T, s string) mv {
+	var m mv
+	if i := strings.IndexByte(s, '+'); i >= 0 {
+		m.meta = strings.Split(s[i+1:], ".")
+		s = s[:i]
+	}
+	if i := strings.IndexByte(s, '-'); i >= 0 {
+		m.pre = strings.Split(s[i+1:], ".")
+		s = s[:i]
+	}
+	parts := strings.Split(s, ".")
+	if len(parts) != 3 {
+		fail(ht, "parseModel(%q): not three segments", s)
+		return m
+	}
+	m.major, _ = strconv.ParseUint(parts[0], 10, 64)
+	m.minor, _ = strconv.ParseUint(parts[1], 10, 64)
+	m.patch, _ = strconv.ParseUint(parts[2], 10, 64)
+	return m
+}
+
+// ---------------------------------------------------------------------------
+// Property: strict versions parse by the spec, and survive every round trip.
+
+// strictCase: a spec version, and whether Scan reads it from a []byte
+// rather than a string.
+type strictCase struct {
+	m         mv
+	scanBytes bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c strictCase) GoString() string {
+	return fmt.Sprintf("version %q (Scan from bytes %v)", c.m.canon(), c.scanBytes)
+}
+
+var strictCases = hegel.Composite(func(tc hegel.TestCase) strictCase {
+	return strictCase{m: hegel.Draw(tc, versions), scanBytes: hegel.Draw(tc, hegel.Booleans())}
+})
+
+func TestHegelStrictVersionsParseByTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, strictCases)
+		m := tcase.m
+		s := m.canon()
+
+		v, err := semver.StrictNewVersion(s)
+		if err != nil {
+			fail(ht, "StrictNewVersion(%q): %v", s, err)
+		}
+		checkParts(ht, "StrictNewVersion", s, v, m)
+
+		lv, err := semver.NewVersion(s)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", s, err)
+		}
+		checkParts(ht, "NewVersion", s, lv, m)
+
+		withCoerce(false, func() {
+			nv, err := semver.NewVersion(s)
+			if err != nil {
+				fail(ht, "NewVersion(%q) without coercion: %v", s, err)
+			}
+			checkParts(ht, "NewVersion[no coerce]", s, nv, m)
+		})
+
+		if !v.Equal(lv) || v.Compare(lv) != 0 {
+			fail(ht, "StrictNewVersion and NewVersion of %q are not Equal", s)
+		}
+		if v.Compare(v) != 0 || !v.Equal(v) || v.LessThan(v) || v.GreaterThan(v) || !v.LessThanEqual(v) || !v.GreaterThanEqual(v) {
+			fail(ht, "%q is not equal to itself", s)
+		}
+
+		// JSON: the canonical text as a JSON string, and back.
+		b, err := json.Marshal(v)
+		if err != nil || string(b) != strconv.Quote(s) {
+			fail(ht, "json.Marshal(%q) = %s, %v", s, b, err)
+		}
+		var back semver.Version
+		if err := json.Unmarshal(b, &back); err != nil || back.String() != s || back.Original() != s {
+			fail(ht, "json.Unmarshal(%s) = %q (%q), %v", b, back.String(), back.Original(), err)
+		}
+
+		// Text.
+		tb, err := v.MarshalText()
+		if err != nil || string(tb) != s {
+			fail(ht, "MarshalText(%q) = %q, %v", s, tb, err)
+		}
+		var tback semver.Version
+		if err := tback.UnmarshalText(tb); err != nil || tback.String() != s {
+			fail(ht, "UnmarshalText(%q) = %q, %v", tb, tback.String(), err)
+		}
+
+		// SQL.
+		val, err := v.Value()
+		if err != nil || val != s {
+			fail(ht, "Value(%q) = %v, %v", s, val, err)
+		}
+		var sc semver.Version
+		var src any = s
+		if tcase.scanBytes {
+			src = []byte(s)
+		}
+		if err := sc.Scan(src); err != nil || sc.String() != s || sc.Original() != s {
+			fail(ht, "Scan(%v) = %q (%q), %v", src, sc.String(), sc.Original(), err)
+		}
+
+		// MustParse agrees.
+		if mp := semver.MustParse(s); mp.String() != s {
+			fail(ht, "MustParse(%q).String() = %q", s, mp.String())
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: loose versions are coerced as the README says.
+
+// looseForm is how much of the core a loose text writes.
+type looseForm int
+
+const (
+	fullForm looseForm = iota // 1.2.3
+	noPatch                   // 1.2
+	noMinor                   // 1
+)
+
+// looseCase: a version written loosely: each segment zero-padded by pads
+// (0 to 2 zeros), the patch or the minor and patch left out, a v prefix.
+type looseCase struct {
+	m    mv
+	pads []int
+	form looseForm
+	v    bool
+}
+
+// model is the version the text stands for: the segments left out are zero.
+func (c looseCase) model() mv {
+	m := c.m
+	switch c.form {
+	case noPatch:
+		m.patch = 0
+	case noMinor:
+		m.minor, m.patch = 0, 0
+	}
+	return m
+}
+
+// written is the number of segments the text has.
+func (c looseCase) written() int {
+	switch c.form {
+	case noPatch:
+		return 2
+	case noMinor:
+		return 1
+	}
+	return 3
+}
+
+func (c looseCase) text() string {
+	segs := []uint64{c.m.major, c.m.minor, c.m.patch}
+	texts := make([]string, c.written())
+	for i := range texts {
+		texts[i] = strings.Repeat("0", c.pads[i]) + strconv.FormatUint(segs[i], 10)
+	}
+	s := strings.Join(texts, ".") + c.m.tail()
+	if c.v {
+		s = "v" + s
+	}
+	return s
+}
+
+// zeros reports a zero-padded segment among those written (the one thing
+// NewVersion refuses without CoerceNewVersion).
+func (c looseCase) zeros() bool {
+	for i := 0; i < c.written(); i++ {
+		if c.pads[i] > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c looseCase) GoString() string {
+	return fmt.Sprintf("text %q -> %q (leading zeros %v)", c.text(), c.model().canon(), c.zeros())
+}
+
+var (
+	// paddings: no zeros three times in four, else one or two.
+	paddings = maybe(25, hegel.Integers(1, 2))
+	// looseForms: all three segments three times in five, the patch or the
+	// minor and patch left out once each.
+	looseForms = hegel.SampledFrom([]looseForm{fullForm, fullForm, fullForm, noPatch, noMinor})
+	looseCases = hegel.Composite(func(tc hegel.TestCase) looseCase {
+		return looseCase{m: hegel.Draw(tc, versions), pads: hegel.Draw(tc, many(paddings, 3, 3)), form: hegel.Draw(tc, looseForms), v: hegel.Draw(tc, chance(40))}
+	})
+)
+
+func TestHegelLooseVersionsAreCoerced(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, looseCases)
+		text, m, zeros := tcase.text(), tcase.model(), tcase.zeros()
+
+		v, err := semver.NewVersion(text)
+		if err != nil {
+			fail(ht, "NewVersion(%q): %v", text, err)
+		}
+		checkParts(ht, "NewVersion", text, v, m)
+		if mp := semver.MustParse(text); mp.String() != m.canon() || mp.Original() != text {
+			fail(ht, "MustParse(%q) = %q (%q)", text, mp.String(), mp.Original())
+		}
+
+		// Without coercion a leading zero is the one thing that is refused;
+		// the v prefix and the missing segments are still accepted.
+		withCoerce(false, func() {
+			nv, err := semver.NewVersion(text)
+			if zeros {
+				if err == nil || nv != nil {
+					fail(ht, "NewVersion(%q) without coercion accepted a leading zero: %v", text, nv)
+				} else if !errors.Is(err, semver.ErrSegmentStartsZero) {
+					fail(ht, "NewVersion(%q) without coercion: %v, want ErrSegmentStartsZero", text, err)
+				}
+				return
+			}
+			if err != nil {
+				fail(ht, "NewVersion(%q) without coercion: %v", text, err)
+			}
+			checkParts(ht, "NewVersion[no coerce]", text, nv, m)
+		})
+
+		// The coerced form is a strict version and reads back equal.
+		sv, err := semver.StrictNewVersion(v.String())
+		if err != nil || !sv.Equal(v) || sv.String() != v.String() {
+			fail(ht, "StrictNewVersion(%q) = %v, %v", v.String(), sv, err)
+		}
+
+		// JSON and text unmarshal go through the same coercion.
+		var jv semver.Version
+		if err := json.Unmarshal([]byte(strconv.Quote(text)), &jv); err != nil || jv.String() != m.canon() || jv.Original() != text {
+			fail(ht, "json.Unmarshal(%q) = %q (%q), %v", text, jv.String(), jv.Original(), err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed versions are refused by every parser that should
+// refuse them, with a nil result.
+
+// damage is one way of writing a version wrongly (what), with the
+// parameters a damage may use: a segment index (modulo three), a position
+// (modulo the live size) and a text it inserts.
+type damage struct {
+	what    string
+	seg, at int
+	text    string
+}
+
+// verdict: which parsers accept the damaged text.
+type verdict struct{ strict, coerce, noCoerce bool }
+
+const (
+	dmgPrefix      = "letter prefix" // "v" (coerced) or "V" (refused)
+	dmgNoPatch     = "missing patch"
+	dmgNoMinor     = "missing minor and patch"
+	dmgLeadingZero = "leading zero in segment"
+	dmgFourSegs    = "four segments"
+	dmgEmptyPre    = "empty pre-release identifier"
+	dmgEmptyMeta   = "empty build identifier"
+	dmgZeroNumeric = "numeric pre-release identifier with a leading zero"
+	dmgChar        = "character inserted"
+	dmgSign        = "sign prefix"
+	dmgHuge        = "segment beyond uint64"
+	dmgSecondPlus  = "second plus"
+	dmgBlanks      = "surrounding blank or empty"
+	dmgTrailingSep = "trailing separator"
+)
+
+// insertAt puts s into xs at i.
+func insertAt(xs []string, i int, s string) []string {
+	out := append([]string(nil), xs[:i]...)
+	out = append(out, s)
+	return append(out, xs[i:]...)
+}
+
+// withParts writes a version from its segments, pre-release and build
+// identifiers.
+func withParts(segs []string, pre, meta []string) string {
+	return strings.Join(segs, ".") + mv{pre: pre, meta: meta}.tail()
+}
+
+// apply writes the damaged text of m and says which parsers accept it.
+func (d damage) apply(m mv) (string, verdict) {
+	segs := []string{strconv.FormatUint(m.major, 10), strconv.FormatUint(m.minor, 10), strconv.FormatUint(m.patch, 10)}
+	s := m.canon()
+	switch d.what {
+	case dmgPrefix:
+		coerced := d.text == "v"
+		return d.text + s, verdict{coerce: coerced, noCoerce: coerced}
+	case dmgNoPatch:
+		return segs[0] + "." + segs[1] + m.tail(), verdict{coerce: true, noCoerce: true}
+	case dmgNoMinor:
+		return segs[0] + m.tail(), verdict{coerce: true, noCoerce: true}
+	case dmgLeadingZero:
+		segs[d.seg%3] = "0" + segs[d.seg%3]
+		return withParts(segs, m.pre, m.meta), verdict{coerce: true}
+	case dmgFourSegs:
+		return withParts(append(segs, d.text), m.pre, m.meta), verdict{}
+	case dmgEmptyPre:
+		pre := m.pre
+		if len(pre) == 0 {
+			pre = []string{d.text}
+		}
+		return withParts(segs, insertAt(pre, d.at%(len(pre)+1), ""), m.meta), verdict{}
+	case dmgEmptyMeta:
+		meta := m.meta
+		if len(meta) == 0 {
+			meta = []string{d.text}
+		}
+		return withParts(segs, m.pre, insertAt(meta, d.at%(len(meta)+1), "")), verdict{}
+	case dmgZeroNumeric:
+		pre := clonePre(m.pre)
+		if len(pre) == 0 {
+			pre = []string{d.text}
+		}
+		pre[d.at%len(pre)] = "0" + d.text
+		return withParts(segs, pre, m.meta), verdict{}
+	case dmgChar:
+		i := d.at % (len(s) + 1)
+		return s[:i] + d.text + s[i:], verdict{}
+	case dmgSign:
+		return d.text + s, verdict{}
+	case dmgHuge:
+		segs[d.seg%3] = hugeSegment
+		return withParts(segs, m.pre, m.meta), verdict{}
+	case dmgSecondPlus:
+		return withParts(segs, m.pre, nil) + "+" + d.text, verdict{}
+	case dmgBlanks:
+		if d.text == "" {
+			return "", verdict{}
+		}
+		return fmt.Sprintf(d.text, s), verdict{}
+	case dmgTrailingSep:
+		// A trailing hyphen after a pre-release or build identifier merely
+		// extends that identifier (hyphens are allowed), so it is only
+		// malformed after the numeric segments.
+		seps := []string{"+", "."}
+		if len(m.pre) == 0 && len(m.meta) == 0 {
+			seps = append(seps, "-")
+		}
+		return s + seps[d.at%len(seps)], verdict{}
+	}
+	panic("unknown damage " + d.what)
+}
+
+// dmg is a damage of one kind with its text drawn from texts.
+func dmg(what string, texts hegel.Generator[string]) hegel.Generator[damage] {
+	return hegel.Composite(func(tc hegel.TestCase) damage {
+		return damage{what: what, seg: hegel.Draw(tc, hegel.Integers(0, 2)), at: hegel.Draw(tc, positions), text: hegel.Draw(tc, texts)}
+	})
+}
+
+var (
+	// badChars: characters no version holds, ASCII and not, blanks and a NUL.
+	badChars = hegel.SampledFrom([]string{" ", "_", "!", "/", ":", "\t", "\n", "\u00e9", "\u0661", "\u0663", "\u3002", "\x00"})
+	// damages: the sixteen ways of the README's grammar being broken, the
+	// mildest first.
+	damages = hegel.OneOf(
+		dmg(dmgPrefix, hegel.SampledFrom([]string{"v", "V"})),
+		dmg(dmgNoPatch, lit("")),
+		dmg(dmgNoMinor, lit("")),
+		dmg(dmgLeadingZero, lit("")),
+		dmg(dmgFourSegs, hegel.Text().Alphabet(digitChars).MinSize(1).MaxSize(1)),
+		dmg(dmgEmptyPre, preIdents),
+		dmg(dmgEmptyMeta, metaIdents),
+		dmg(dmgZeroNumeric, segmentTexts),
+		dmg(dmgChar, badChars),
+		dmg(dmgSign, hegel.SampledFrom([]string{"-", "+"})),
+		dmg(dmgHuge, lit("")),
+		dmg(dmgSecondPlus, cat(metaIdents, lit("+"), metaIdents)),
+		dmg(dmgBlanks, hegel.SampledFrom([]string{"", " %s", "%s ", " %s "})),
+		dmg(dmgTrailingSep, lit("")),
+	)
+)
+
+// invalidCase: a version and the damage done to it.
+type invalidCase struct {
+	m mv
+	d damage
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c invalidCase) GoString() string {
+	text, ok := c.d.apply(c.m)
+	return fmt.Sprintf("%s: %q (strict %v, coerce %v, no-coerce %v)", c.d.what, text, ok.strict, ok.coerce, ok.noCoerce)
+}
+
+var invalidCases = hegel.Composite(func(tc hegel.TestCase) invalidCase {
+	return invalidCase{m: hegel.Draw(tc, versions), d: hegel.Draw(tc, damages)}
+})
+
+func TestHegelInvalidVersionsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, invalidCases)
+		text, ok := tcase.d.apply(tcase.m)
+		what := tcase.d.what
+
+		check := func(mode string, v *semver.Version, err error, accepted bool) {
+			if accepted {
+				if err != nil || v == nil {
+					fail(ht, "%s(%q) [%s]: refused: %v", mode, text, what, err)
+				}
+				return
+			}
+			if err == nil || v != nil {
+				fail(ht, "%s(%q) [%s]: accepted as %v (err %v)", mode, text, what, v, err)
+			}
+		}
+		v, err := semver.StrictNewVersion(text)
+		check("StrictNewVersion", v, err, ok.strict)
+		v, err = semver.NewVersion(text)
+		check("NewVersion", v, err, ok.coerce)
+		withCoerce(false, func() {
+			v, err := semver.NewVersion(text)
+			check("NewVersion[no coerce]", v, err, ok.noCoerce)
+		})
+		if !ok.coerce {
+			var jv semver.Version
+			if err := json.Unmarshal([]byte(strconv.Quote(text)), &jv); err == nil {
+				fail(ht, "json.Unmarshal(%q) [%s] accepted as %q", text, what, jv.String())
+			}
+			var tv semver.Version
+			if err := tv.UnmarshalText([]byte(text)); err == nil {
+				fail(ht, "UnmarshalText(%q) [%s] accepted as %q", text, what, tv.String())
+			}
+			func() {
+				defer func() {
+					if recover() == nil {
+						fail(ht, "MustParse(%q) [%s] did not panic", text, what)
+					}
+				}()
+				semver.MustParse(text)
+			}()
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: precedence follows spec item 11; Collection sorts by it.
+
+// step: one more version of a collection, near the at-th version drawn so
+// far (modulo their count).
+type step struct {
+	at  int
+	rel relation
+}
+
+// precedenceCase: a version, a version near it, and up to four more, each
+// near one of those before it.
+type precedenceCase struct {
+	a    mv
+	rel  relation
+	more []step
+}
+
+// models are the versions of the case, the first two being the pair.
+func (c precedenceCase) models() []mv {
+	models := []mv{c.a, c.rel.apply(c.a)}
+	for _, s := range c.more {
+		models = append(models, s.rel.apply(models[s.at%len(models)]))
+	}
+	return models
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c precedenceCase) GoString() string {
+	texts := []string{}
+	for _, m := range c.models() {
+		texts = append(texts, strconv.Quote(m.canon()))
+	}
+	return "versions " + strings.Join(texts, " ")
+}
+
+var (
+	steps = hegel.Composite(func(tc hegel.TestCase) step {
+		return step{at: hegel.Draw(tc, positions), rel: hegel.Draw(tc, relations)}
+	})
+	precedenceCases = hegel.Composite(func(tc hegel.TestCase) precedenceCase {
+		return precedenceCase{a: hegel.Draw(tc, versions), rel: hegel.Draw(tc, relations), more: hegel.Draw(tc, many(steps, 0, 4))}
+	})
+)
+
+// TestHegelPrecedenceFollowsTheSpec: Compare and the six comparison methods
+// agree with the model in both directions, and sort.Sort(Collection) orders
+// related versions as the model does. The pre-release identifiers draw
+// numbers beyond uint64 at their natural rate (masterminds-semver/1), so
+// this property fails while that is open.
+func TestHegelPrecedenceFollowsTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		models := hegel.Draw(ht, precedenceCases).models()
+		a, b := models[0], models[1]
+		comparesLike(ht, a, b, hugeShape(a, b))
+		sortsLike(ht, models, hugeShape(models...))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: the increment and set functions follow their doc comments.
+
+// incCase: a version (with a v prefix 30% of the time), the identifiers
+// SetPrerelease and SetMetadata are given (none: the empty text), or a
+// malformed text instead a quarter of the time.
+type incCase struct {
+	m       mv
+	v       bool
+	pre     []string
+	badPre  *string
+	meta    []string
+	badMeta *string
+}
+
+func (c incCase) text() string {
+	if c.v {
+		return "v" + c.m.canon()
+	}
+	return c.m.canon()
+}
+
+func (c incCase) preText() string {
+	if c.badPre != nil {
+		return *c.badPre
+	}
+	return strings.Join(c.pre, ".")
+}
+
+func (c incCase) metaText() string {
+	if c.badMeta != nil {
+		return *c.badMeta
+	}
+	return strings.Join(c.meta, ".")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c incCase) GoString() string {
+	return fmt.Sprintf("version %q, SetPrerelease(%q) (malformed %v), SetMetadata(%q) (malformed %v)", c.text(), c.preText(), c.badPre != nil, c.metaText(), c.badMeta != nil)
+}
+
+var (
+	// badPres: pre-release texts SetPrerelease must refuse: a leading zero
+	// on a numeric identifier (also around a number), an empty identifier,
+	// a blank, a plus.
+	badPres = hegel.OneOf(
+		hegel.SampledFrom([]string{"01", "a..b", "a.", ".a", "a b", "x+y"}),
+		cat(lit("0"), segmentTexts, lit("1")),
+	)
+	badMetas = hegel.SampledFrom([]string{"a..b", "a.", ".a", "a b", "x+y", "\u00e9"})
+	incCases = hegel.Composite(func(tc hegel.TestCase) incCase {
+		return incCase{
+			m:       hegel.Draw(tc, versions),
+			v:       hegel.Draw(tc, chance(30)),
+			pre:     hegel.Draw(tc, maybe(70, preLists)),
+			badPre:  hegel.Draw(tc, optional(25, badPres)),
+			meta:    hegel.Draw(tc, maybe(70, metaLists)),
+			badMeta: hegel.Draw(tc, optional(25, badMetas)),
+		}
+	})
+)
+
+func TestHegelIncrementsFollowTheDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, incCases)
+		m, text := tcase.m, tcase.text()
+		prefix := ""
+		if tcase.v {
+			prefix = "v"
+		}
+		v := semver.MustParse(text)
+
+		type inc struct {
+			name string
+			e    func() (semver.Version, error)
+			p    func() semver.Version
+			want mv
+			over bool
+		}
+		patch := mv{major: m.major, minor: m.minor, patch: m.patch}
+		if len(m.pre) == 0 {
+			patch.patch++
+		}
+		incs := []inc{
+			{"IncPatch", v.IncPatchE, v.IncPatch, patch, len(m.pre) == 0 && m.patch == math.MaxUint64},
+			{"IncMinor", v.IncMinorE, v.IncMinor, mv{major: m.major, minor: m.minor + 1}, m.minor == math.MaxUint64},
+			{"IncMajor", v.IncMajorE, v.IncMajor, mv{major: m.major + 1}, m.major == math.MaxUint64},
+		}
+		for _, in := range incs {
+			got, err := in.e()
+			if in.over {
+				if err == nil || !errors.Is(err, semver.ErrIncrementOverflow) {
+					fail(ht, "%sE(%q) on the maximum: %q, %v; want ErrIncrementOverflow", in.name, text, got.String(), err)
+				} else if got.String() != v.String() {
+					fail(ht, "%sE(%q) overflow returned %q, not the input", in.name, text, got.String())
+				}
+				panicked := false
+				func() {
+					defer func() { panicked = recover() != nil }()
+					in.p()
+				}()
+				if !panicked {
+					fail(ht, "%s(%q) on the maximum did not panic", in.name, text)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "%sE(%q): %v", in.name, text, err)
+			}
+			if got.String() != in.want.canon() {
+				fail(ht, "%sE(%q) = %q, want %q", in.name, text, got.String(), in.want.canon())
+			}
+			if got.Original() != prefix+in.want.canon() {
+				fail(ht, "%sE(%q).Original() = %q, want %q", in.name, text, got.Original(), prefix+in.want.canon())
+			}
+			if p := in.p(); p.String() != got.String() || p.Original() != got.Original() {
+				fail(ht, "%s(%q) = %q (%q), differs from the E variant %q (%q)", in.name, text, p.String(), p.Original(), got.String(), got.Original())
+			}
+			if v.String() != m.canon() || v.Original() != text {
+				fail(ht, "%s mutated its receiver: %q (%q)", in.name, v.String(), v.Original())
+			}
+		}
+
+		// SetPrerelease / SetMetadata: valid values replace, invalid ones
+		// are refused and leave the version alone.
+		preText := tcase.preText()
+		sp, err := v.SetPrerelease(preText)
+		if tcase.badPre != nil {
+			if err == nil {
+				fail(ht, "SetPrerelease(%q) accepted", preText)
+			}
+		} else if err != nil {
+			fail(ht, "SetPrerelease(%q): %v", preText, err)
+		} else {
+			want := mv{major: m.major, minor: m.minor, patch: m.patch, pre: tcase.pre, meta: m.meta}
+			if sp.String() != want.canon() || sp.Prerelease() != preText || sp.Original() != prefix+want.canon() {
+				fail(ht, "SetPrerelease(%q) on %q = %q (%q), want %q", preText, text, sp.String(), sp.Original(), want.canon())
+			}
+		}
+		metaText := tcase.metaText()
+		sm, err := v.SetMetadata(metaText)
+		if tcase.badMeta != nil {
+			if err == nil {
+				fail(ht, "SetMetadata(%q) accepted", metaText)
+			}
+		} else if err != nil {
+			fail(ht, "SetMetadata(%q): %v", metaText, err)
+		} else {
+			want := mv{major: m.major, minor: m.minor, patch: m.patch, pre: m.pre, meta: tcase.meta}
+			if sm.String() != want.canon() || sm.Metadata() != metaText || sm.Original() != prefix+want.canon() {
+				fail(ht, "SetMetadata(%q) on %q = %q (%q), want %q", metaText, text, sm.String(), sm.Original(), want.canon())
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: the model.
+
+// openness is how much of a comparator's version is left open.
+type openness int
+
+const (
+	full        openness = iota // 1.2.3
+	patchAbsent                 // 1.2
+	patchWild                   // 1.2.x
+	minorAbsent                 // 1
+	minorWild                   // 1.x (or 1.x.x)
+	allWild                     // *
+)
+
+// cver is the version part of a comparator: its shape, a major, minor and
+// patch (those the shape leaves open are not written), a pre-release (only
+// with all three segments), and its spelling: the wildcard character, a
+// second wildcard after a minor one (1.x.x), a v prefix.
+type cver struct {
+	open                openness
+	major, minor, patch uint64
+	pre                 []string
+	wild                string
+	wild2               bool
+	v                   bool
+}
+
+// level is how much of the version is left open: 0 exact, 1 patch, 2 minor
+// and patch, 3 everything.
+func (c cver) level() int {
+	switch c.open {
+	case allWild:
+		return 3
+	case minorAbsent, minorWild:
+		return 2
+	case patchAbsent, patchWild:
+		return 1
+	}
+	return 0
+}
+
+// lo is the lowest version, the open segments filled with zeros.
+func (c cver) lo() mv {
+	m := mv{}
+	switch c.level() {
+	case 0:
+		m.pre = c.pre
+		m.patch = c.patch
+		fallthrough
+	case 1:
+		m.minor = c.minor
+		fallthrough
+	case 2:
+		m.major = c.major
+	}
+	return m
+}
+
+func (c cver) text() string {
+	if c.open == allWild {
+		return c.wild
+	}
+	s := strconv.FormatUint(c.major, 10)
+	switch c.open {
+	case minorAbsent:
+	case minorWild:
+		s += "." + c.wild
+		if c.wild2 {
+			s += "." + c.wild
+		}
+	default:
+		s += "." + strconv.FormatUint(c.minor, 10)
+		switch c.open {
+		case patchAbsent:
+		case patchWild:
+			s += "." + c.wild
+		default:
+			s += "." + strconv.FormatUint(c.patch, 10)
+			if len(c.pre) > 0 {
+				s += "-" + strings.Join(c.pre, ".")
+			}
+		}
+	}
+	if c.v {
+		s = "v" + s
+	}
+	return s
+}
+
+var (
+	operators = []string{"", "=", "!=", ">", "<", ">=", "=>", "<=", "=<", "~", "~>", "^"}
+	// bareWildOps are the operators that read a bare wildcard right; the
+	// others treat `*` as the version 0.0.0 (masterminds-semver/2, /3), so
+	// under HEGEL_NO_KNOWN=1 a bare wildcard is written with these only.
+	bareWildOps = []string{"", "=", ">=", "<", "~", "~>"}
+	itemSeps    = []string{" ", ", ", ",", "  "}
+	commaSeps   = []string{", ", ","}
+	orSeps      = []string{" || ", "||", " ||", "|| "}
+	prereleases = [][]string{{"0"}, {"alpha"}, {"beta", "2"}, {"rc", "1"}, {"-"}, {"a-b"}, {"RC"}}
+)
+
+// opIndex is the index of an operator in the table.
+func opIndex(op string) int {
+	for i, o := range operators {
+		if o == op {
+			return i
+		}
+	}
+	panic("unknown operator " + op)
+}
+
+// holds is the README's meaning of `op ver` for a version v.
+func holds(op string, c cver, v mv) bool {
+	lo := c.lo()
+	l := c.level()
+	sameMajor := v.major == lo.major
+	sameMinor := sameMajor && v.minor == lo.minor
+	switch op {
+	case "", "=":
+		switch l {
+		case 0:
+			return v.cmp(lo) == 0
+		case 1:
+			return sameMinor
+		case 2:
+			return sameMajor
+		}
+		return true
+	case "!=":
+		return !holds("=", c, v)
+	case ">":
+		switch l {
+		case 0:
+			return v.cmp(lo) > 0
+		case 1:
+			return v.major > lo.major || sameMajor && v.minor > lo.minor
+		case 2:
+			return v.major > lo.major
+		}
+		return false
+	case ">=", "=>":
+		return v.cmp(lo) >= 0
+	case "<":
+		return v.cmp(lo) < 0
+	case "<=", "=<":
+		switch l {
+		case 0:
+			return v.cmp(lo) <= 0
+		case 1:
+			return v.major < lo.major || sameMajor && v.minor <= lo.minor
+		case 2:
+			return v.major <= lo.major
+		}
+		return true
+	case "~", "~>":
+		if v.cmp(lo) < 0 {
+			return false
+		}
+		switch l {
+		case 0, 1:
+			return sameMinor
+		case 2:
+			return sameMajor
+		}
+		return true
+	case "^":
+		if v.cmp(lo) < 0 {
+			return false
+		}
+		switch l {
+		case 3:
+			return true
+		case 2:
+			return sameMajor
+		case 1:
+			if lo.major > 0 {
+				return sameMajor
+			}
+			return sameMinor
+		}
+		if lo.major > 0 {
+			return sameMajor
+		}
+		if lo.minor > 0 {
+			return sameMinor
+		}
+		return sameMinor && v.patch == lo.patch
+	}
+	panic("unknown operator " + op)
+}
+
+// item is one comparator of an AND group (`op a`, with a blank between the
+// two 30% of the time) or a hyphen range `a - b`; op indexes the operator
+// table and sep the separator table (both modulo their size), the separator
+// being the one written before the item when it is not the first of its
+// group.
+type item struct {
+	hyphen bool
+	op     int
+	a, b   cver
+	blank  bool
+	sep    int
+}
+
+// operator is the item's operator. Under HEGEL_NO_KNOWN=1 a bare wildcard
+// takes one of the operators that read it right (the others meet
+// masterminds-semver/2 and /3), and `~` over a 0.0.0 core (with or without a
+// pre-release, masterminds-semver/4) becomes `=`.
+func (it item) operator() string {
+	ops := operators
+	if noKnown && it.a.open == allWild {
+		ops = bareWildOps
+	}
+	op := ops[it.op%len(ops)]
+	if noKnown && (op == "~" || op == "~>") && it.a.open == full && it.a.major == 0 && it.a.minor == 0 && it.a.patch == 0 {
+		op = "="
+	}
+	return op
+}
+
+// separator is the text before the item in its group. Under HEGEL_NO_KNOWN=1
+// a hyphen range follows a comma (a blank meets masterminds-semver/5).
+func (it item) separator() string {
+	seps := itemSeps
+	if noKnown && it.hyphen {
+		seps = commaSeps
+	}
+	return seps[it.sep%len(seps)]
+}
+
+func (it item) text() string {
+	if it.hyphen {
+		return it.a.text() + " - " + it.b.text()
+	}
+	s := it.operator()
+	if it.blank {
+		s += " "
+	}
+	return s + it.a.text()
+}
+
+func (it item) holds(v mv) bool {
+	if it.hyphen {
+		return v.cmp(it.a.lo()) >= 0 && holds("<=", it.b, v)
+	}
+	return holds(it.operator(), it.a, v)
+}
+
+func (it item) hasPre() bool {
+	return len(it.a.pre) > 0 || it.hyphen && len(it.b.pre) > 0
+}
+
+// group is an AND group; or indexes the OR separator table (modulo its
+// size) for the separator written before the group when it is not the
+// first.
+type group struct {
+	items []item
+	or    int
+}
+
+func (g group) hasPre() bool {
+	for _, it := range g.items {
+		if it.hasPre() {
+			return true
+		}
+	}
+	return false
+}
+
+func (g group) text() string {
+	var sb strings.Builder
+	for i, it := range g.items {
+		if i > 0 {
+			sb.WriteString(it.separator())
+		}
+		sb.WriteString(it.text())
+	}
+	return sb.String()
+}
+
+// constraintModel is an OR of AND groups, with a blank before or after the
+// whole text 20% of the time each, and the IncludePrerelease setting.
+type constraintModel struct {
+	groups      []group
+	lead, trail bool
+	includePre  bool
+}
+
+func (c constraintModel) hasHyphen() bool {
+	for _, g := range c.groups {
+		for _, it := range g.items {
+			if it.hyphen {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// orSeparator is the `||` written before the group. Under HEGEL_NO_KNOWN=1
+// it is blank-separated whenever the constraint has a hyphen range (a `||`
+// glued to one meets masterminds-semver/6).
+func (c constraintModel) orSeparator(g group) string {
+	if noKnown && c.hasHyphen() {
+		return " || "
+	}
+	return orSeps[g.or%len(orSeps)]
+}
+
+func (c constraintModel) text() string {
+	var sb strings.Builder
+	if c.lead {
+		sb.WriteString(" ")
+	}
+	for gi, g := range c.groups {
+		if gi > 0 {
+			sb.WriteString(c.orSeparator(g))
+		}
+		sb.WriteString(g.text())
+	}
+	if c.trail {
+		sb.WriteString(" ")
+	}
+	return sb.String()
+}
+
+// cvers are the comparator versions of the constraint, in text order.
+func (c constraintModel) cvers() []cver {
+	var out []cver
+	for _, g := range c.groups {
+		for _, it := range g.items {
+			out = append(out, it.a)
+			if it.hyphen {
+				out = append(out, it.b)
+			}
+		}
+	}
+	return out
+}
+
+// satisfied is the README's rule: an OR of AND groups, and a pre-release
+// version is only considered by a group that mentions a pre-release itself
+// (or when IncludePrerelease is set).
+func (c constraintModel) satisfied(v mv) bool {
+	for _, g := range c.groups {
+		if len(v.pre) > 0 && !c.includePre && !g.hasPre() {
+			continue
+		}
+		ok := true
+		for _, it := range g.items {
+			ok = ok && it.holds(v)
+		}
+		if ok {
+			return true
+		}
+	}
+	return false
+}
+
+// parseShapes names the recorded bugs of the constraint's text that make
+// NewConstraint refuse it: a hyphen range after a blank-separated comparator
+// in its group (masterminds-semver/5), and a `||` glued to a hyphen range -
+// written `||` beside one, or ` ||` before one (masterminds-semver/6).
+func (c constraintModel) parseShapes() []string {
+	blankRange, glued := false, false
+	for gi, g := range c.groups {
+		for i := 1; i < len(g.items); i++ {
+			if g.items[i].hyphen && !g.items[i-1].hyphen && strings.TrimSpace(g.items[i].separator()) == "" {
+				blankRange = true
+			}
+		}
+		if gi > 0 {
+			sep := c.orSeparator(g)
+			left, right := c.groups[gi-1].items, g.items
+			if sep == "||" && (left[len(left)-1].hyphen || right[0].hyphen) || sep == " ||" && right[0].hyphen {
+				glued = true
+			}
+		}
+	}
+	return append(shapeIf(blankRange, "masterminds-semver/5"), shapeIf(glued, "masterminds-semver/6")...)
+}
+
+// checkShapes names the recorded bugs of checking v against the constraint:
+// `^` over a bare wildcard (masterminds-semver/2), `<=`, `>` or `!=` over one
+// (masterminds-semver/3), `~` over a 0.0.0 core (masterminds-semver/4), and
+// `!=` over a patch wildcard against a pre-release version the group
+// considers (masterminds-semver/7).
+func (c constraintModel) checkShapes(v mv) []string {
+	var caret, bare, tildeZero, notEqualPre bool
+	for _, g := range c.groups {
+		considered := c.includePre || g.hasPre()
+		for _, it := range g.items {
+			if it.hyphen {
+				continue
+			}
+			op := it.operator()
+			switch {
+			case it.a.open == allWild && op == "^":
+				caret = true
+			case it.a.open == allWild && (op == "<=" || op == "=<" || op == ">" || op == "!="):
+				bare = true
+			case (op == "~" || op == "~>") && it.a.open == full && it.a.major == 0 && it.a.minor == 0 && it.a.patch == 0:
+				tildeZero = true
+			case op == "!=" && it.a.level() == 1 && len(v.pre) > 0 && considered:
+				notEqualPre = true
+			}
+		}
+	}
+	shapes := shapeIf(caret, "masterminds-semver/2")
+	shapes = append(shapes, shapeIf(bare, "masterminds-semver/3")...)
+	shapes = append(shapes, shapeIf(tildeZero, "masterminds-semver/4")...)
+	return append(shapes, shapeIf(notEqualPre, "masterminds-semver/7")...)
+}
+
+// ---------------------------------------------------------------------------
+// Constraints: generators.
+
+var (
+	wildcards     = hegel.SampledFrom([]string{"x", "X", "*"})
+	smallSegments = hegel.Integers[uint64](0, 3)
+	// openShapes: how much of a comparator's version is left open: all three
+	// segments six times in eleven, each of the partial shapes once.
+	openShapes = hegel.SampledFrom([]openness{full, full, full, full, full, full, patchAbsent, patchWild, minorAbsent, minorWild, allWild})
+	// boundShapes: the shapes of a hyphen range's ends: every one but the
+	// bare wildcard.
+	boundShapes = hegel.SampledFrom([]openness{full, full, full, full, full, full, patchAbsent, patchWild, minorAbsent, minorWild})
+)
+
+// cversOf: a comparator version of one of the shapes: segments of 0 to 3, a
+// pre-release from the table 30% of the time (written with all three
+// segments only), the wildcard's spelling, a second wildcard 30% of the
+// time, a v prefix 15%.
+func cversOf(shapes hegel.Generator[openness]) hegel.Generator[cver] {
+	return hegel.Composite(func(tc hegel.TestCase) cver {
+		return cver{
+			open:  hegel.Draw(tc, shapes),
+			major: hegel.Draw(tc, smallSegments),
+			minor: hegel.Draw(tc, smallSegments),
+			patch: hegel.Draw(tc, smallSegments),
+			pre:   hegel.Draw(tc, maybe(30, hegel.SampledFrom(prereleases))),
+			wild:  hegel.Draw(tc, wildcards),
+			wild2: hegel.Draw(tc, chance(30)),
+			v:     hegel.Draw(tc, chance(15)),
+		}
+	})
+}
+
+var (
+	exactVers = cversOf(hegel.Just(full))
+	openVers  = cversOf(openShapes)
+	boundVers = cversOf(boundShapes)
+	opIndices = hegel.Integers(0, len(operators)-1)
+)
+
+// comparatorsOf: a comparator over a version of vers under an operator of
+// ops, with a blank after the operator 30% of the time, and its separator.
+func comparatorsOf(vers hegel.Generator[cver], ops hegel.Generator[int]) hegel.Generator[item] {
+	return hegel.Composite(func(tc hegel.TestCase) item {
+		return item{op: hegel.Draw(tc, ops), a: hegel.Draw(tc, vers), blank: hegel.Draw(tc, chance(30)), sep: hegel.Draw(tc, positions)}
+	})
+}
+
+var (
+	// hyphenRanges: a hyphen range `a - b` over bounded versions.
+	hyphenRanges = hegel.Composite(func(tc hegel.TestCase) item {
+		return item{hyphen: true, a: hegel.Draw(tc, boundVers), b: hegel.Draw(tc, boundVers), sep: hegel.Draw(tc, positions)}
+	})
+	// releaseItems: the items of a constraint checked against release
+	// versions: a comparator over a version of any shape, or a hyphen range
+	// 15% of the time.
+	releaseItems = weighted(choice[item]{85, comparatorsOf(openVers, opIndices)}, choice[item]{15, hyphenRanges})
+	// preItems: the comparators a pre-release version is checked against:
+	// full versions (the README defines no other meaning for a pre-release
+	// version), except that `!=` takes a version of any shape (the shape of
+	// masterminds-semver/7); under HEGEL_NO_KNOWN=1 full versions only.
+	preItems = hegel.FlatMap(opIndices, func(op int) hegel.Generator[item] {
+		vers := exactVers
+		if operators[op] == "!=" && !noKnown {
+			vers = openVers
+		}
+		return comparatorsOf(vers, hegel.Just(op))
+	})
+)
+
+// constraintsOf: one to three OR groups of one to three items each, with a
+// blank before or after the text 20% of the time and IncludePrerelease 30%.
+func constraintsOf(items hegel.Generator[item]) hegel.Generator[constraintModel] {
+	groups := hegel.Composite(func(tc hegel.TestCase) group {
+		return group{items: hegel.Draw(tc, many(items, 1, 3)), or: hegel.Draw(tc, positions)}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) constraintModel {
+		return constraintModel{
+			groups:     hegel.Draw(tc, many(groups, 1, 3)),
+			lead:       hegel.Draw(tc, chance(20)),
+			trail:      hegel.Draw(tc, chance(20)),
+			includePre: hegel.Draw(tc, chance(30)),
+		}
+	})
+}
+
+var (
+	releaseConstraints = constraintsOf(releaseItems)
+	preConstraints     = constraintsOf(preItems)
+)
+
+// probe is the version a constraint is checked against: near one of the
+// constraint's own versions three times in four (the at-th, modulo their
+// count, its open segments filled with zeros and every segment nudged by
+// -1, 0 or +1), else a small random core; the pre-release identifiers of a
+// pre-release version; metadata 15% of the time.
+type probe struct {
+	near   bool
+	at     int
+	nudges []int
+	core   mv
+	pre    []string
+	meta   []string
+}
+
+func nudged(x uint64, d int) uint64 {
+	switch {
+	case d < 0 && x > 0:
+		return x - 1
+	case d > 0:
+		return x + 1
+	}
+	return x
+}
+
+func (p probe) version(c constraintModel) mv {
+	v := p.core
+	if cvs := c.cvers(); p.near && len(cvs) > 0 {
+		lo := cvs[p.at%len(cvs)].lo()
+		v = mv{major: nudged(lo.major, p.nudges[0]), minor: nudged(lo.minor, p.nudges[1]), patch: nudged(lo.patch, p.nudges[2])}
+	}
+	v.pre = p.pre
+	v.meta = p.meta
+	return v
+}
+
+var (
+	// nudges: no change three times in five, one up or one down once each.
+	nudges     = hegel.SampledFrom([]int{0, 0, 0, 1, -1})
+	smallCores = hegel.Composite(func(tc hegel.TestCase) mv {
+		return mv{major: hegel.Draw(tc, smallSegments), minor: hegel.Draw(tc, smallSegments), patch: hegel.Draw(tc, smallSegments)}
+	})
+)
+
+// probesOf: a probe whose pre-release identifiers come from pre.
+func probesOf(pre hegel.Generator[[]string]) hegel.Generator[probe] {
+	return hegel.Composite(func(tc hegel.TestCase) probe {
+		return probe{
+			near:   hegel.Draw(tc, chance(75)),
+			at:     hegel.Draw(tc, positions),
+			nudges: hegel.Draw(tc, many(nudges, 3, 3)),
+			core:   hegel.Draw(tc, smallCores),
+			pre:    hegel.Draw(tc, pre),
+			meta:   hegel.Draw(tc, maybe(15, metaLists)),
+		}
+	})
+}
+
+var (
+	releaseProbes = probesOf(hegel.Just[[]string](nil))
+	preProbes     = probesOf(hegel.SampledFrom(prereleases))
+)
+
+// constraintCase: a constraint and the probe of the version to check.
+type constraintCase struct {
+	c constraintModel
+	p probe
+}
+
+func (c constraintCase) version() mv { return c.p.version(c.c) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c constraintCase) GoString() string {
+	return fmt.Sprintf("constraint %q (IncludePrerelease %v) version %q", c.c.text(), c.c.includePre, c.version().canon())
+}
+
+// constraintCases: a constraint of every form against a release version
+// two times in three, else full-version comparators against a pre-release
+// version.
+var constraintCases = weighted(
+	choice[constraintCase]{65, hegel.Composite(func(tc hegel.TestCase) constraintCase {
+		return constraintCase{c: hegel.Draw(tc, releaseConstraints), p: hegel.Draw(tc, releaseProbes)}
+	})},
+	choice[constraintCase]{35, hegel.Composite(func(tc hegel.TestCase) constraintCase {
+		return constraintCase{c: hegel.Draw(tc, preConstraints), p: hegel.Draw(tc, preProbes)}
+	})},
+)
+
+// constraintAgrees checks a constraint against a version: NewConstraint
+// accepts the text, Check agrees with the README model, Validate agrees with
+// Check and returns messages exactly when it fails, and the constraint
+// survives String -> NewConstraint and MarshalText -> UnmarshalText with the
+// same verdict. parseShapes names the recorded bugs the text has the shape
+// of (they make NewConstraint fail), checkShapes those the check has.
+func constraintAgrees(ht *hegel.T, c constraintModel, v mv, parseShapes, checkShapes []string) {
+	text := c.text()
+	cs, err := semver.NewConstraint(text)
+	if err != nil {
+		mismatch(ht, parseShapes, "NewConstraint(%q): %v", text, err)
+	}
+	cs.IncludePrerelease = c.includePre
+	sv := semver.MustParse(v.canon())
+
+	want := c.satisfied(v)
+	got := cs.Check(sv)
+	if got != want {
+		mismatch(ht, checkShapes, "%q (IncludePrerelease %v).Check(%q) = %v, want %v", text, c.includePre, v.canon(), got, want)
+	}
+
+	ok, msgs := cs.Validate(sv)
+	if ok != got {
+		fail(ht, "%q.Validate(%q) = %v but Check = %v", text, v.canon(), ok, got)
+	}
+	if ok && len(msgs) != 0 || !ok && len(msgs) == 0 {
+		fail(ht, "%q.Validate(%q) = %v with %d messages %v", text, v.canon(), ok, len(msgs), msgs)
+	}
+
+	// The printed constraint reads back with the same meaning.
+	printed := cs.String()
+	cs2, err := semver.NewConstraint(printed)
+	if err != nil {
+		fail(ht, "NewConstraint(%q) (String of %q): %v", printed, text, err)
+	}
+	cs2.IncludePrerelease = c.includePre
+	if g2 := cs2.Check(sv); g2 != got {
+		fail(ht, "%q reprinted as %q: Check(%q) %v vs %v", text, printed, v.canon(), g2, got)
+	}
+	if cs2.String() != printed {
+		fail(ht, "String is not stable: %q -> %q", printed, cs2.String())
+	}
+	tb, err := cs.MarshalText()
+	if err != nil || string(tb) != printed {
+		fail(ht, "MarshalText(%q) = %q, %v", text, tb, err)
+	}
+	var cs3 semver.Constraints
+	if err := cs3.UnmarshalText(tb); err != nil {
+		fail(ht, "UnmarshalText(%q): %v", tb, err)
+	}
+	cs3.IncludePrerelease = c.includePre
+	if g3 := cs3.Check(sv); g3 != got {
+		fail(ht, "UnmarshalText(%q).Check(%q) = %v, want %v", tb, v.canon(), g3, got)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property: constraints mean what the README says they mean.
+
+// TestHegelConstraintsMatchTheReadmeRanges: random constraints against
+// versions near their own. The grammar draws every recorded shape at its
+// natural rate (a bare wildcard under every operator, `~0.0.0`, a hyphen
+// range after a blank, a `||` glued to a range, `!=` over a wildcard against
+// a pre-release version), so this property fails while any of
+// masterminds-semver/2 to /7 is open.
+func TestHegelConstraintsMatchTheReadmeRanges(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, constraintCases)
+		v := tcase.version()
+		constraintAgrees(ht, tcase.c, v, tcase.c.parseShapes(), tcase.c.checkShapes(v))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins for the known bugs. Each is expected to fail at the pinned commit.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func checkConstraint(t *testing.T, c, v string, includePre, want bool) {
+	t.Helper()
+	cs, err := semver.NewConstraint(c)
+	if err != nil {
+		t.Errorf("NewConstraint(%q): %v", c, err)
+		return
+	}
+	cs.IncludePrerelease = includePre
+	if got := cs.Check(semver.MustParse(v)); got != want {
+		t.Errorf("%q.Check(%s) = %v, want %v", c, v, got, want)
+	}
+}
+
+// masterminds-semver/1: comparePrePart parses numeric identifiers with
+// strconv.ParseUint and treats any that overflow uint64 as alphanumeric, so
+// they compare as text: 100000000000000000000 sorts before
+// 99999999999999999999, and after the alphanumeric identifiers "-" and "0a"
+// although every numeric identifier precedes every alphanumeric one.
+func TestHegelPinHugeNumericIdentifiersCompareNumerically(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		a, b string
+		want int
+	}{
+		{"1.0.0-100000000000000000000", "1.0.0-99999999999999999999", 1},
+		{"1.0.0-18446744073709551616", "1.0.0--", -1},
+		{"1.0.0-18446744073709551616", "1.0.0-0a", -1},
+	}
+	for _, c := range cases {
+		if got := semver.MustParse(c.a).Compare(semver.MustParse(c.b)); got != c.want {
+			t.Errorf("Compare(%q, %q) = %d, want %d", c.a, c.b, got, c.want)
+		}
+	}
+}
+
+// masterminds-semver/2: `^*` (and `^x`, `^X`) is documented in the code as
+// "(any)" but the caret check falls through to the 0.0.z case and accepts
+// 0.0.0 only.
+func TestHegelPinCaretWildcardIsAnyVersion(t *testing.T) {
+	defer guard(t)
+	for _, c := range []string{"^*", "^x", "^X"} {
+		for _, v := range []string{"0.0.1", "0.1.0", "1.0.0", "2.3.4"} {
+			checkConstraint(t, c, v, false, true)
+		}
+	}
+}
+
+// masterminds-semver/3: a bare wildcard is the version 0.0.0 for `<=`, `>`
+// and `!=`: `<= *` accepts 0.0.z only, `> *` and `!= *` accept everything
+// but 0.0.0, where the wildcard matches every version (`*` is `>= 0.0.0`
+// and "works for all comparison operators").
+func TestHegelPinBareWildcardIsNotZero(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "<= *", "0.1.0", false, true)
+	checkConstraint(t, "<= *", "1.0.0", false, true)
+	checkConstraint(t, "<=x", "1.0.0", false, true)
+	checkConstraint(t, "> *", "0.0.1", false, false)
+	checkConstraint(t, "> *", "1.0.0", false, false)
+	checkConstraint(t, "!= *", "0.0.1", false, false)
+	checkConstraint(t, "!= *", "1.0.0", false, false)
+}
+
+// masterminds-semver/4: the special case meant for `~*` fires on any
+// constraint whose version is 0.0.0 with no wildcard, so `~0.0.0` and
+// `~0.0.0-alpha` accept every version instead of `>= 0.0.0, < 0.1.0`
+// (`~0.0.1` is `>= 0.0.1, < 0.1.0` as documented).
+func TestHegelPinTildeZeroIsAPatchRange(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "~0.0.0", "0.0.5", false, true)
+	checkConstraint(t, "~0.0.0", "0.1.0", false, false)
+	checkConstraint(t, "~0.0.0", "5.0.0", false, false)
+	checkConstraint(t, "~0.0.0-alpha", "0.1.0", true, false)
+}
+
+// masterminds-semver/5: rewriteRange replaces `A - B` by `>= A, <= B ` but
+// swallows the blank before A, so a hyphen range that follows a
+// blank-separated comparator in the same AND group yields "1.2.3>= 1.2, <=
+// 1.4 " and an "improper constraint" error; a comma before the range works.
+func TestHegelPinHyphenRangeAfterBlankSeparatedComparator(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "1.2.3 1.2 - 1.4", "1.2.3", false, true)
+	checkConstraint(t, ">=1.0 1.2 - 1.4", "1.3.0", false, true)
+	checkConstraint(t, "<2 1.2 - 1.4", "1.3.0", false, true)
+}
+
+// masterminds-semver/6: the version character class of the constraint
+// regexes is `[0-9|x|X|\*]` - the `|` meant as alternation is a member -
+// so a `||` glued to a hyphen range is read as part of a version and the
+// constraint is "improper" ("1.2 - 1.4||2.0.1", "<2.3||0.1.2 - 3.1.1"),
+// while the same text with blanks around `||` parses.
+func TestHegelPinOrGluedToHyphenRange(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "1.2 - 1.4||2.0.1", "2.0.1", false, true)
+	checkConstraint(t, "1.2 - 1.4||2.0.1", "1.3.0", false, true)
+	checkConstraint(t, "<2.3||0.1.2 - 3.1.1", "2.5.0", false, true)
+	checkConstraint(t, "<2.3 || 0.1.2 - 3.1.1", "2.5.0", false, true)
+}
+
+// masterminds-semver/7: with IncludePrerelease, `!= 1.2.x` accepts
+// 1.2.3-alpha (the patch-wildcard branch calls two versions unequal when
+// their pre-releases differ) while `!= 1.x` rejects it; 1.2.3-alpha lies in
+// both ranges and should be rejected by both.
+func TestHegelPinNotEqualWildcardsAgreeOnPrereleases(t *testing.T) {
+	defer guard(t)
+	checkConstraint(t, "!= 1.2.x", "1.2.3-alpha", true, false)
+	checkConstraint(t, "!= 1.x", "1.2.3-alpha", true, false)
+}
