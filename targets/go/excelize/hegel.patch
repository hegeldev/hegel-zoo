+package hegel
+
+// The shape regions of the recorded Math bugs (bugs.toml excelize/2, 6, 7, 8, 9, 10, 15, 17,
+// 18, 19, 21, 23, 29, 31, 33, 34, and 79 to 82) and the narrow properties over them: each region is a
+// generator over the bug's shape with random contents, judged exactly like the wide property
+// (judgeMath, with the classifier mathShape naming the bug). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next to the
+// shape instead (hzShaped) and the property passes. The hit rates quoted at each region are
+// the collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"math"
+	"math/big"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowMath runs a narrow property: every drawn case through the wide property's judge.
+func narrowMath(t *testing.T, cases hegel.Generator[mathCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMath(j, o, c)
+		col.count("cases")
+	})
+}
+
+// fn: the cases NAME(args) over one generator per argument.
+func fn(name string, gens ...hegel.Generator[float64]) hegel.Generator[mathCase] {
+	args := make([]hegel.Generator[hzArg], len(gens))
+	for i, g := range gens {
+		args[i] = num(g)
+	}
+	return casesOf(name, hzTuple(args...))
+}
+
+func neg(g hegel.Generator[float64]) hegel.Generator[float64] {
+	return hegel.Map(g, func(v float64) float64 { return -v })
+}
+
+// decimalOf: the float nearest to the decimal k / 10^p (its literal is that decimal).
+func decimalOf(k int, p int) float64 {
+	v, _ := new(big.Rat).Mul(big.NewRat(int64(k), 1), pow10Rat(-p)).Float64()
+	return v
+}
+
+var (
+	zero      = hegel.Just(0.0)
+	nonzero   = signed(positives, 50)
+	ints1to30 = floats(hzInts(0, 30))
+	// unitFractions: (1..999) / 10^(3..9), in (0, 1)
+	unitFractions = overTens(hzInts(1, 999), 3, 9)
+	// halves: j + 0.5
+	halves = hegel.Map(hzInts(0, 9), func(j int) float64 { return float64(j) + 0.5 })
+	// tenths: j + r/10, r in 1..9 (never an integer)
+	tenths = hegel.Composite(func(tc hegel.TestCase) float64 {
+		return decimalOf(10*hegel.Draw(tc, hzInts(1, 30))+hegel.Draw(tc, hzInts(1, 9)), 1)
+	})
+	// inexactSigs: the significances that are not binary fractions
+	inexactSigs = hzSampled(0.1, 0.01, 0.001, 0.2, 0.3, 0.7, 0.05, 0.6, 0.9, 1.1, 0.15, 0.025)
+	// integerSigs: significances whose quotients are exact
+	integerSigs = hzSampled(1.0, 2, 3, 5, 7, 10, 100)
+	// positiveSigs and negativeSigs: the significance table by sign (0 apart)
+	positiveSigs = hzSampled(1.0, 2, 5, 10, 100, 0.5, 0.25, 0.1, 0.01, 0.2, 3, 7)
+	negativeSigs = neg(positiveSigs)
+)
+
+// --------------------------------------------------------------------------- excelize/2
+
+// secIsTheCosine: SEC of any nonzero angle (the library returns the cosine, which agrees
+// with the secant only at 0). Past the shape, SEC(0). Hit rate 1000 of 1000.
+var secIsTheCosine = hzShaped(
+	fn("SEC", signed(overTens(hzInts(1, 20000), 3, 3), 50)),
+	fn("SEC", zero),
+)
+
+func TestHegelMathSecIsTheReciprocal(t *testing.T) { narrowMath(t, secIsTheCosine) }
+
+// --------------------------------------------------------------------------- excelize/6
+
+// combinPairs: the pairs (n, k), 0 < k < n <= 50, split by whether the library's product
+// rounds up with Ceil to the exact binomial (hits) or one above it (misses: 230 of 1225 by
+// the float, 194 outside the judge's 1e-12, which hides the misses above 1e12);
+// COMBINA(k+1, n-k) is COMBIN(n, k) in the library and takes the pairs with 2k+1 >= n.
+type combinPair struct{ n, k float64 }
+
+var combinPairsOnce = sync.OnceValues(func() (misses, hits []combinPair) {
+	for n := 2; n <= 50; n++ {
+		for k := 1; k < n; k++ {
+			p := combinPair{float64(n), float64(k)}
+			c := mathCase{name: "COMBIN", args: []hzArg{hzN(p.n), hzN(p.k)}}
+			if mathShape(c, goVerdict(c)) == "excelize/6" { // a miss within the judge's 1e-12 is none
+				misses = append(misses, p)
+			} else {
+				hits = append(hits, p)
+			}
+		}
+	}
+	return misses, hits
+})
+
+func combinCases(miss bool) hegel.Generator[mathCase] {
+	table := func() []combinPair {
+		misses, hits := combinPairsOnce()
+		if miss {
+			return misses
+		}
+		return hits
+	}
+	combin := hegel.Composite(func(tc hegel.TestCase) mathCase {
+		p := hegel.Draw(tc, hegel.SampledFrom(table()))
+		return mathCase{name: "COMBIN", args: []hzArg{hzN(p.n), hzN(p.k)}}
+	})
+	combina := hegel.Composite(func(tc hegel.TestCase) mathCase {
+		var pairs []combinPair
+		for _, p := range table() {
+			if 2*p.k+1 >= p.n {
+				pairs = append(pairs, p)
+			}
+		}
+		p := hegel.Draw(tc, hegel.SampledFrom(pairs))
+		return mathCase{name: "COMBINA", args: []hzArg{hzN(p.k + 1), hzN(p.n - p.k)}}
+	})
+	return hzWeighted(hzW(3, combin), hzW(1, combina))
+}
+
+// combinRoundsUp: COMBIN and COMBINA over the pairs the product misses. Past the shape, the
+// pairs it hits. Hit rate 728 of 728 (the engine deduplicates the table's draws).
+var combinRoundsUp = hzShaped(combinCases(true), combinCases(false))
+
+func TestHegelMathCombinIsExact(t *testing.T) { narrowMath(t, combinRoundsUp) }
+
+// --------------------------------------------------------------------------- excelize/7
+
+// oddOfAUnitFraction: ODD of a number in (0, 1). Past the shape, its negative, one above it,
+// and integers. Hit rate 1000 of 1000.
+var oddOfAUnitFraction = hzShaped(
+	fn("ODD", unitFractions),
+	fn("ODD", hzWeighted(
+		hzW(1, neg(unitFractions)),
+		hzW(1, hegel.Map(unitFractions, func(v float64) float64 { return 1 + v })),
+		hzW(1, floats(hzInts(1, 1000))),
+	)),
+)
+
+func TestHegelMathOddOfAUnitFraction(t *testing.T) { narrowMath(t, oddOfAUnitFraction) }
+
+// --------------------------------------------------------------------------- excelize/8
+
+// roundingCases: ROUND, ROUNDUP and ROUNDDOWN of a number of magnitude 100 or more (below
+// 10^digits / 2 both sides round to 0) with the digits.
+func roundingCases(d hegel.Generator[float64]) hegel.Generator[mathCase] {
+	x := signed(hzWeighted(
+		hzW(1, floats(hzInts(100, 100000))),
+		hzW(1, overTens(hzInts(100000, 9999999), 1, 3)),
+	), 40)
+	return hzWeighted(
+		hzW(1, fn("ROUND", x, d)),
+		hzW(1, fn("ROUNDUP", x, d)),
+		hzW(1, fn("ROUNDDOWN", x, d)),
+	)
+}
+
+// fractionalDigits: a fractional num_digits (the power of ten is then irrational). Past the
+// shape, num_digits -3..0 (exact powers of ten, no binary miss either). Hit rate 1000 of 1000.
+var fractionalDigits = hzShaped(
+	roundingCases(hzSampled(1.5, -1.5, 2.9, 0.5, -0.5, 2.5, 1.1)),
+	roundingCases(floats(hzInts(-3, 0))),
+)
+
+func TestHegelMathFractionalDigitsAreTruncated(t *testing.T) { narrowMath(t, fractionalDigits) }
+
+// --------------------------------------------------------------------------- excelize/9
+
+// multipleCase: NAME(x, s[, mode]) with x = +-(k + r/10) |s| as a decimal, so that x / s is
+// never an integer (the direction of the rounding matters and the binary quotient cannot
+// miss); the sign of x as given, the mode from modes (none for two arguments).
+func multipleCase(name string, xSign float64, sigs, modes hegel.Generator[float64]) hegel.Generator[mathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		s := hegel.Draw(tc, sigs)
+		q := big.NewRat(int64(10*hegel.Draw(tc, hzInts(0, 999))+hegel.Draw(tc, hzInts(1, 9))), 10)
+		x, _ := new(big.Rat).Mul(q, ratOf(xSign*math.Abs(s))).Float64()
+		args := []hzArg{hzN(x), hzN(s)}
+		if modes != nil {
+			args = append(args, hzN(hegel.Draw(tc, modes)))
+		}
+		return mathCase{name: name, args: args}
+	})
+}
+
+// zeroSignificance: CEILING, CEILING.MATH and FLOOR.MATH with significance 0 (#NUM!, want 0).
+var zeroSignificance = hzWeighted(
+	hzW(1, fn("CEILING", numbers, zero)),
+	hzW(1, fn("CEILING.MATH", numbers, zero)),
+	hzW(1, fn("CEILING.MATH", numbers, zero, modes)),
+	hzW(1, fn("FLOOR.MATH", numbers, zero)),
+	hzW(1, fn("FLOOR.MATH", numbers, zero, modes)),
+)
+
+// ceilingMathMisreads: the conditions of excelize/9 (the quotient by the signed significance
+// adjusted by `number > 0` / `mode < 0` in CEILING.MATH and `number < 0 && mode > 0` in
+// FLOOR.MATH): CEILING.MATH of a positive number with a negative significance, of a negative
+// number with a positive significance and a positive mode, or with a negative significance
+// and a nonzero mode; FLOOR.MATH of a negative number with a positive significance and a
+// mode of 0 or more, or with a negative significance and no mode or a mode of 0 or more;
+// a significance of 0; FLOOR(0, negative). Past the shape, the sign and mode combinations
+// the library gets right. Hit rate 1000 of 1000.
+var ceilingMathMisreads = hzShaped(
+	hzWeighted(
+		hzW(1, multipleCase("CEILING.MATH", 1, negativeSigs, nil)),
+		hzW(1, multipleCase("CEILING.MATH", 1, negativeSigs, modes)),
+		hzW(1, multipleCase("CEILING.MATH", -1, positiveSigs, hzSampled(1.0, 2, 0.5))),
+		hzW(1, multipleCase("CEILING.MATH", -1, negativeSigs, hzSampled(1.0, -1, 2, 0.5, -3))),
+		hzW(1, multipleCase("FLOOR.MATH", -1, positiveSigs, hzSampled(0.0, 1, 2, 0.5))),
+		hzW(1, multipleCase("FLOOR.MATH", -1, negativeSigs, nil)),
+		hzW(1, multipleCase("FLOOR.MATH", -1, negativeSigs, hzSampled(0.0, 1, 2, 0.5))),
+		hzW(1, zeroSignificance),
