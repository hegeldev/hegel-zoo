+DATEFMTS = ("yyyy-mm-dd", "dd/mm/yyyy", "mm/dd/yyyy", "d-mmm-yyyy", "mmmm d, yyyy", "dddd", "ddd", "yyyy", "mmm", "yy-m-d", "d-mmm-yyyy h:mm")
