+def T(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    return v if isinstance(v, str) else ""
+
+def N(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return 1.0 if v else 0.0
+    if isinstance(v, str):
+        return 0.0
+    if isinstance(v, list):
+        raise Skip()
+    return float(v)
