+// --------------------------------------------------------------------------- excelize/21
+
+var (
+	negatives = neg(floats(hzInts(1, 10)))
+	// chosenAbove: (n, k) with k above n
+	chosenAbove = hegel.FlatMap(hzInts(0, 30), func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzN(float64(n))), num(floats(hzInts(n+1, 40))))
+	})
+	// chosenWithin: (n, k) with k at most n (n at most 11: COMBIN's product is exact there)
+	chosenWithin = hegel.FlatMap(hzInts(0, 11), func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzN(float64(n))), num(floats(hzInts(0, n))))
+	})
+	// combinaWithin: COMBINA(n, k) with 1 <= k <= n <= 6 (judged, and COMBIN(n+k-1, n-1) exact)
+	combinaWithin = casesOf("COMBINA", hegel.FlatMap(hzInts(1, 6), func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzN(float64(n))), num(floats(hzInts(1, n))))
+	}))
+	// withANegative: one to six counts with one negative among them
+	withANegative = hzSeq(hzCounted(num(ints1to30), 0, 3), hzOne(num(negatives)), hzCounted(num(ints1to30), 0, 2))
+	// digitsAbove: a text with a digit at or above the radix, for DECIMAL
+	decimalAbove = hegel.FlatMap(hzInts(2, 35), func(r int) hegel.Generator[[]hzArg] {
+		return hzTuple(text(hzSeq(hzCounted(digitChars(0, r-1), 0, 3), hzOne(digitChars(r, 35)), hzCounted(digitChars(0, 35), 0, 4))), hegel.Just(hzN(float64(r))))
+	})
+	decimalWithin = hegel.FlatMap(hzInts(2, 36), func(r int) hegel.Generator[[]hzArg] {
+		return hzTuple(text(hzCounted(digitChars(0, r-1), 1, 8)), hegel.Just(hzN(float64(r))))
+	})
+)
