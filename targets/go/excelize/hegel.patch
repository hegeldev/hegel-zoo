+
+def ISEVEN(v):
+    return xparity(v) % 2 == 0
+
+def ISODD(v):
+    return xparity(v) % 2 != 0
+
+def TYPE(v):
+    if isinstance(v, XE):
+        return 16.0
+    if isinstance(v, bool):
+        return 4.0
+    if isinstance(v, str):
+        return 2.0
+    if isinstance(v, list):
+        return 64.0
+    return 1.0
+
+ERRCODES = {"#NULL!": 1, "#DIV/0!": 2, "#VALUE!": 3, "#REF!": 4, "#NAME?": 5, "#NUM!": 6, "#N/A": 7}
+
+def ERROR_TYPE(v):
+    if isinstance(v, XE):
+        return float(ERRCODES[v.code])
+    raise XErr(NA)
+
+def X_NA():
+    raise XErr(NA)
+
+XFUNCS = {"VALUE": X_VALUE, "NA": X_NA}
+
+def TRUE():
+    return True
+
+def FALSE():
+    return False
