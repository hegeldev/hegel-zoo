+++ b/hegel/hegel_zoo_stat_test.go
@@ -0,0 +1,1549 @@
+package hegel
+
+// TestHegelStat: the statistical functions over ranges agree with NumPy and SciPy (Excel's
+// definitions: sample and population moments, PERCENTILE.INC/EXC as NumPy's linear and weibull
+// methods, PERCENTRANK truncated to its significance, TRIMMEAN's even trimming, the t-, z-, F-
+// and chi-squared tests); SUBTOTAL and AGGREGATE agree with the functions they number.
+//
+// A case is one of the 76 functions with its arguments (statCase), drawn from statCases: the
+// function is sampled from the table statSpecs and its arguments from the kind generators
+// (ranges, pairs, pointIn, ranks, percentiles, quartiles, ... as the old kinds, now weighted
+// alternatives, simplest first), and, where the first argument is a range, a SUBTOTAL and an
+// AGGREGATE check of the same range (numbered) three times in ten. The shapes of the recorded
+// bugs are drawn like any other case: as alternatives of weight zero under HEGEL_NO_KNOWN=1
+// (hzUnless), as the literal form of a function whose range form is the shape (hzShaped), or
+// as relations between the arguments that are then filtered out (statOnly, with the Go models
+// of statVerdict standing in for the oracle). The classifier statShape names the bug a case
+// has the shape of, from the case and the oracle's verdict, before the library is called, for
+// the shapes that depend on the library's arithmetic from a replica of it (lib*); a mismatch
+// then fails "(the shape of excelize/N)". The same judge (judgeStat) serves the narrow
+// properties of hegel_zoo_stat_shapes_test.go.
+//
+// The shapes drawn here: excelize/1 (PERCENTILE.EXC and QUARTILE.EXC out of bounds, a panic),
+// 3 (HARMEAN of a range), 4 (AVEDEV of a range), 5 (pairs with a zero), 10 (infinite results:
+// SKEW.P of an inexact constant range whose one-pass variance is exactly 0, PRODUCT
+// overflowing), 12 (CONFIDENCE and CONFIDENCE.NORM accurate to 1e-9: a check of the judge),
+// 15 (a fractional quart, significance or size), 17 (FISHERINV from 354.8), 20 (PERCENTRANK's
+// decimal places), 21 (error codes), 22 (the one-pass variance), 24 (the zero-variance
+// checks), 26 (CONFIDENCE.T from alpha 0.99), 29 (PERCENTRANK's binary floor of an exact
+// decimal rank, one case in a few thousand), 83 (GEOMEAN's product over- or underflowing).
+//
+// Model facts that are not gates: the tolerances of hzStatTol (the moments relative to the
+// range's scale); CONFIDENCE.T is judged at the default 1e-10 (the old 1e-7 was a gate); the
+// oracle does not judge LARGE and SMALL with a fractional k, MODE with a tie, PERCENTRANK of
+// one value, T.TEST with a fractional tails or type.
+
+import (
+	"math"
+	"math/big"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- kinds
+
+// lengths: the length of a range: 1..12, 13..60 one time in ten.
+var lengths = hzWeighted(hzW(9, hzInts(1, 12)), hzW(1, hzInts(13, 60)))
+
+// pooledOf: n values from a pool of one to three values of g (ties and constant ranges).
+func pooledOf(g hegel.Generator[float64], n int) hegel.Generator[[]float64] {
+	return hegel.FlatMap(hzCounted(g, 1, 3), func(pool []float64) hegel.Generator[[]float64] {
+		return hzCounted(hegel.SampledFrom(pool), n, n)
+	})
+}
+
+// seriesOf: n values of one profile (seriesProfiles, the plain ones first), from a pool of
+// one to three values a third of the time so that ties and constant ranges are common (the
+// old hzGenSeries, as one weighted choice: the math file's series, over 1..6, draws the
+// profile first; parts 2b, 3 and 4 may reuse this one).
+func seriesOf(n int) hegel.Generator[[]float64] {
+	var choices []hzChoice[[]float64]
+	for _, p := range seriesProfiles {
+		choices = append(choices, hzW(2, hzCounted(p, n, n)))
+	}
+	for _, p := range seriesProfiles {
+		choices = append(choices, hzW(1, pooledOf(p, n)))
+	}
+	return hzWeighted(choices...)
+}
+
+// rangesOf: a range of a drawn length.
+func rangesOf(ns hegel.Generator[int]) hegel.Generator[[]float64] { return hegel.FlatMap(ns, seriesOf) }
+
+// ranges: a range of 1..60 values (lengths).
+var ranges = rangesOf(lengths)
+
+// constantOf: a range of n copies of one value of g (the constant-range generator; parts 2b,
+// 3 and 4 may reuse it).
+func constantOf(g hegel.Generator[float64], ns hegel.Generator[int]) hegel.Generator[[]float64] {
+	return hegel.Composite(func(tc hegel.TestCase) []float64 {
+		n := hegel.Draw(tc, ns)
+		v := hegel.Draw(tc, g)
+		xs := make([]float64, n)
+		for i := range xs {
+			xs[i] = v
+		}
+		return xs
+	})
+}
+
+// withAZero: the range with one of its values (drawn) set to 0 (the range-with-a-zero shaper;
+// parts 2b, 3 and 4 may reuse it).
+func withAZero(g hegel.Generator[[]float64]) hegel.Generator[[]float64] {
+	return hegel.FlatMap(g, func(xs []float64) hegel.Generator[[]float64] {
+		return hegel.Map(hzInts(0, len(xs)-1), func(i int) []float64 {
+			out := append([]float64(nil), xs...)
+			out[i] = 0
+			return out
+		})
+	})
+}
+
+// imageOf: a noisy linear image of a: slope a + offset + r/4 with the slope in -5..5, the
+// offset in -10..10 and r in -3..3 per value.
+func imageOf(a []float64) hegel.Generator[[]float64] {
+	return hegel.Composite(func(tc hegel.TestCase) []float64 {
+		slope := float64(hegel.Draw(tc, hzInts(-5, 5)))
+		off := float64(hegel.Draw(tc, hzInts(-10, 10)))
+		noise := hegel.Draw(tc, hzCounted(hzInts(-3, 3), len(a), len(a)))
+		b := make([]float64, len(a))
+		for i := range a {
+			b[i] = slope*a[i] + off + float64(noise[i])/4
+		}
+		return b
+	})
+}
+
+// secondOf: the second range of a two-range function: one of a's length (the simplest), a
+// noisy linear image of a, or one of any length (#N/A when it differs).
+func secondOf(a []float64) hegel.Generator[[]float64] {
+	return hzWeighted(
+		hzW(6, seriesOf(len(a))),
+		hzW(4, imageOf(a)),
+		hzW(1, ranges),
+	)
+}
+
+func arr(g hegel.Generator[[]float64]) hegel.Generator[hzArg] { return hegel.Map(g, hzA) }
+
+// pairs: two ranges, the arguments of the two-range functions.
+var pairs = hegel.FlatMap(ranges, func(a []float64) hegel.Generator[[]hzArg] {
+	return hzTuple(hegel.Just(hzA(a)), arr(secondOf(a)))
+})
+
+// pointIn: a value of the range (the simplest), a point between two of its values, or any
+// number (outside it, mostly).
+func pointIn(a []float64) hegel.Generator[float64] {
+	return hzWeighted(
+		hzW(3, hegel.SampledFrom(a)),
+		hzW(1, hegel.Composite(func(tc hegel.TestCase) float64 {
+			lo := hegel.Draw(tc, hegel.SampledFrom(a))
+			hi := hegel.Draw(tc, hegel.SampledFrom(a))
+			return lo + (hi-lo)*float64(hegel.Draw(tc, hzInts(0, 8)))/8
+		})),
+		hzW(1, numbers),
+	)
+}
+
+// ranksOf: LARGE and SMALL's k: 1..n, or 0, -1, n+1 (#NUM!) and 1.5 (truncated by the
+// library, not judged by the oracle) one time in ten.
+func ranksOf(n int) hegel.Generator[float64] {
+	return hzWeighted(
+		hzW(9, floats(hzInts(1, n))),
+		hzW(1, hzSampled(0.0, -1, float64(n+1), 1.5)),
+	)
+}
+
+// percentilesOf: PERCENTILE's k: thousandths, the ends, the median, the EXC bounds 1/(n+1)
+// and n/(n+1) (the shape of excelize/1 in PERCENTILE.EXC at the upper one: the index k(n+1)
+// is n) and, never under HEGEL_NO_KNOWN=1, just outside [0, 1] (excelize/21 in PERCENTILE and
+// PERCENTILE.INC: #N/A, want #NUM!).
+func percentilesOf(n int) hegel.Generator[float64] {
+	return hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.01, -0.01)),
+		hzW(6, overTens(hzInts(0, 1000), 3, 3)),
+		hzW(3, hzSampled(0.0, 1, 0.5, 1/float64(n+1), float64(n)/float64(n+1))),
+	)
+}
+
+// insideExcOf: PERCENTILE.EXC's k with the index k(n+1) in [1, n): the region past the shape
+// of excelize/1 (the bounds themselves are left to the rounding of k(n+1), which the statOnly
+// filter of PERCENTILE.EXC settles with the replica).
+func insideExcOf(n int) hegel.Generator[float64] {
+	return hegel.Map(hzInts(0, 999), func(j int) float64 {
+		return (1 + float64(j)/1000*float64(n-1)) / float64(n+1)
+	})
+}
+
+var (
+	// quartiles: QUARTILE's quart: 0..4, 5 and -1 (#NUM!) and, never under HEGEL_NO_KNOWN=1,
+	// a fraction (the shape of excelize/15: used as it is, in quarters).
+	quartiles = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.5, 2.9, 0.5, 4.5, -0.5)),
+		hzW(18, floats(hzInts(0, 4))),
+		hzW(1, hzSampled(5.0, -1)),
+	)
+
+	// sigDigits: PERCENTRANK's significance: 1..6, 0 and -1 (#NUM!), 15 (within the
+	// tolerance) and, never under HEGEL_NO_KNOWN=1, a fraction (excelize/15: 10^1.5).
+	sigDigits = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.5, 2.5)),
+		hzW(18, floats(hzInts(1, 6))),
+		hzW(1, hzSampled(0.0, -1, 15)),
+	)
+
+	// orders: RANK's order (any nonzero order is ascending).
+	orders = hzSampled(0.0, 1, 2, -1)
+
+	// tails and types: T.TEST's; 0, 3 and 4 are #NUM!, a fraction is not judged.
+	tails = hzWeighted(hzW(19, floats(hzInts(1, 2))), hzW(1, hzSampled(0.0, 3, 1.5)))
+	types = hzWeighted(hzW(19, floats(hzInts(1, 3))), hzW(1, hzSampled(0.0, 4, 2.5)))
+
+	// percents: TRIMMEAN's percent: tenths of [0, 0.9], 0.99, and 1, -0.1 and 1.5 (#NUM!).
+	percents = hzWeighted(hzW(9, overTens(hzInts(0, 9), 1, 1)), hzW(1, hzSampled(1.0, -0.1, 1.5, 0.99)))
+
+	// nearOne: 1 - (1..100) / 10^(4..6), in [0.99, 0.999999]: the shape of excelize/26 in
+	// CONFIDENCE.T (the inverse t loses digits for a quantile near 0; measured at the default
+	// 1e-10 over 3000 cases: every case in [0.98, 0.99) passes, 2e-11 at worst; in [0.99,
+	// 0.999) 1 case in 12 fails, 1 in 5 from a size of 30; in [0.999, 0.9999) 7 in 10; from
+	// 0.9999 every case but a few with a size below 10).
+	nearOne = hegel.Map(overTens(hzInts(1, 100), 4, 6), func(d float64) float64 { return 1 - d })
+
+	// alphas: CONFIDENCE's alpha: thousandths of (0, 0.99), the ends and outside (#NUM!), tiny
+	// values (hzGenProb's), and, never under HEGEL_NO_KNOWN=1, nearOne.
+	alphas = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), nearOne),
+		hzW(8, overTens(hzInts(1, 989), 3, 3)),
+		hzW(1, hzSampled(0.0, 1, -0.1, 1.1, 1e-10, 1e-6, 1e-4, 0.001)),
+	)
+
+	// sizes: CONFIDENCE's size: 1..100, 0, 0.5 and -3 (#NUM!) and, never under
+	// HEGEL_NO_KNOWN=1, a fraction of 1 or more (excelize/15: used as it is).
+	sizes = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.9, 2.5, 10.5)),
+		hzW(18, floats(hzInts(1, 100))),
+		hzW(1, hzSampled(0.0, 0.5, -3)),
+	)
+
+	// sdevs: a standard deviation: positive, or, never under HEGEL_NO_KNOWN=1, 0 (the shape
+	// of excelize/21 in STANDARDIZE, #N/A, and Z.TEST, #DIV/0!, where #NUM! is due).
+	sdevs = hzWeighted(hzW(hzUnless(hzNoKnown, 1), hegel.Just(0.0)), hzW(9, positives))
+
+	// openUnits: thousandths of (-1, 1).
+	openUnits = overTens(hzInts(-999, 999), 3, 3)
+
+	// fisherArgs: FISHER's x: openUnits, or, never under HEGEL_NO_KNOWN=1, at or beyond the
+	// ends (excelize/21: #N/A, want #NUM!).
+	fisherArgs = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.0, -1, 1.5, -2, 1.0000001)),
+		hzW(9, openUnits),
+	)
+
+	// quarters: quarters of 1..200, CHISQ.TEST's expected counts.
+	quarters = hegel.Map(hzInts(1, 200), func(i int) float64 { return float64(i) / 4 })
+
+	// extremes: two to six values of (1..999) 10^(100..300) or (1..999) 10^-(100..300): the
+	// shape of excelize/83 where GEOMEAN's product overflows or underflows (not where it stays
+	// in range: 10^100 times 10^-100 is 1).
+	extremes = hzCounted(hzWeighted(
+		hzW(1, timesTens(hzInts(1, 999), 100, 300)),
+		hzW(1, overTens(hzInts(1, 999), 100, 300)),
+	), 2, 6)
+
+	// geomeanRanges: a range, or, never under HEGEL_NO_KNOWN=1, one of extremes one time in
+	// ten (a range of sixty values in the thousands overflows too, one case in a thousand, the
+	// natural rate the old property reached excelize/83 at; the statOnly filter of GEOMEAN
+	// takes those out under HEGEL_NO_KNOWN=1).
+	geomeanRanges = hzWeighted(hzW(hzUnless(hzNoKnown, 1), extremes), hzW(9, ranges))
+
+	// excRanges: PERCENTILE.EXC's range: by default any, under HEGEL_NO_KNOWN=1 two values or
+	// more (one value has no k inside the bounds).
+	excRanges = hzShaped(ranges, rangesOf(hzWeighted(hzW(9, hzInts(2, 12)), hzW(1, hzInts(13, 60)))))
+
+	// quartileExcRanges: QUARTILE.EXC's range: under HEGEL_NO_KNOWN=1 four values or more (the
+	// quart 1 of three values or fewer and the quart 3 of three index outside the range).
+	quartileExcRanges = hzShaped(ranges, rangesOf(hzWeighted(hzW(9, hzInts(4, 12)), hzW(1, hzInts(13, 60)))))
+)
+
+// expectedOf: CHISQ.TEST's expected range: quarters, of the observed range's length (or of
+// another one time in twelve: #N/A), with a 0 among them one time in twenty (#DIV/0!).
+func expectedOf(n int) hegel.Generator[[]float64] {
+	plain := hegel.FlatMap(hzWeighted(hzW(11, hegel.Just(n)), hzW(1, hzInts(1, 12))), func(m int) hegel.Generator[[]float64] {
+		return hzCounted(quarters, m, m)
+	})
+	return hzWeighted(hzW(19, plain), hzW(1, withAZero(plain)))
+}
+
+// --------------------------------------------------------------------------- argument lists
+
+// statOnly is hzOnly over the arguments of name under HEGEL_NO_KNOWN=1 (named after the
+// function): the case has no recorded bug's shape, judged with the Go models' verdict
+// (statVerdict) where the shape is a relation of the result. Measured rejection rates:
+// see the collector's "filtered <name>" counts quoted at TestHegelStat.
+func statOnly(name string, g hegel.Generator[[]hzArg]) hegel.Generator[[]hzArg] {
+	return hzOnly(hzNoKnown, name, g, func(args []hzArg) bool {
+		c := statCase{name: name, args: args}
+		return statShape(c, statVerdict(c)) == ""
+	})
+}
+
+// rangeAnd: a range, then the given arguments.
+func rangeAnd(gens ...hegel.Generator[hzArg]) hegel.Generator[[]hzArg] {
+	return hzTuple(append([]hegel.Generator[hzArg]{arr(ranges)}, gens...)...)
+}
+
+// rangeThen: a range of rs, then one argument drawn from it (PERCENTRANK's point).
+func rangeThen(rs hegel.Generator[[]float64], of func(a []float64) hegel.Generator[float64]) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(rs, func(a []float64) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzA(a)), num(of(a)))
+	})
+}
+
+// byLength: the argument drawn from the range's length (LARGE's k, PERCENTILE's k).
+func byLength(of func(n int) hegel.Generator[float64]) func(a []float64) hegel.Generator[float64] {
+	return func(a []float64) hegel.Generator[float64] { return of(len(a)) }
+}
+
+var (
+	oneRange = hzTuple(arr(ranges))
+
+	// harmeanArgs: HARMEAN of a range of positive values (the shape of excelize/3: the range is
+	// never read, so the values are kept positive for the plainest witness, #N/A where a value
+	// is due) or of literals: with any values (excelize/21 where one is not positive) or
+	// positive ones (the oracle flattens either form); the two shapes never under
+	// HEGEL_NO_KNOWN=1. The range form comes first and the literals are nested so that the
+	// shrinker lands on HARMEAN(A1:A1), the shape of excelize/3, rather than on HARMEAN(0).
+	harmeanArgs = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 3), hzTuple(arr(hegel.FlatMap(lengths, countedOf(positives))))),
+		hzW(2, hzWeighted(
+			hzW(hzUnless(hzNoKnown, 1), some(num(numbers))),
+			hzW(1, some(num(positives))),
+		)),
+	)
+
+	// avedevArgs: AVEDEV of a range, with a literal after it one time in three (the shape of
+	// excelize/4 where the range's first value is not its mean absolute deviation; never under
+	// HEGEL_NO_KNOWN=1), or of literals.
+	avedevArgs = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 2), oneRange),
+		hzW(hzUnless(hzNoKnown, 1), rangeAnd(num(numbers))),
+		hzW(1, some(num(numbers))),
+	)
+
+	// percentileExcArgs: PERCENTILE.EXC's range and k; under HEGEL_NO_KNOWN=1 the k inside the
+	// bounds (excRanges, insideExcOf), the rounding at the bounds filtered by the replica.
+	percentileExcArgs = statOnly("PERCENTILE.EXC", hegel.FlatMap(excRanges, func(a []float64) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzA(a)), num(hzShaped(percentilesOf(len(a)), insideExcOf(len(a)))))
+	}))
+
+	quartileExcArgs = statOnly("QUARTILE.EXC", hzTuple(arr(quartileExcRanges), num(quartiles)))
+
+	// percentrankArgs: a range, a point in it and, half the time, the significance.
+	percentrankArgs = optional(rangeThen(ranges, pointIn), num(sigDigits))
+
+	// rankArgs: a point in a range, the range and, half the time, the order.
+	rankArgs = hegel.FlatMap(ranges, func(a []float64) hegel.Generator[[]hzArg] {
+		return optional(hzTuple(num(pointIn(a)), hegel.Just(hzA(a))), num(orders))
+	})
+
+	confidenceArgs = hzTuple(num(alphas), num(positives), num(sizes))
+
+	chisqArgs = hegel.FlatMap(ranges, func(a []float64) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzA(a)), arr(expectedOf(len(a))))
+	})
+)
+
+// --------------------------------------------------------------------------- the cases
+
+// statSpec: a function and the generator of its argument lists.
+type statSpec struct {
+	name string
+	args hegel.Generator[[]hzArg]
+}
+
+// numbered: a SUBTOTAL or AGGREGATE check of a case's range: the function number (SUBTOTAL's
+// plus 100 to ignore hidden rows), AGGREGATE's options, and the arguments after them (the
+// range and the extra argument of AGGREGATE 14 to 19).
+type numbered struct {
+	fn   string
+	num  int
+	opts int
+	args []hzArg
+}
+
+// target is the function the number stands for.
+func (k numbered) target() string {
+	if k.fn == "AGGREGATE" && k.num >= 12 {
+		return hzAggregate[k.num]
+	}
+	return hzSubtotal[k.num%100]
+}
+
+func (k numbered) formula() (string, map[string][]float64) {
+	lead := []hzArg{hzN(float64(k.num))}
+	if k.fn == "AGGREGATE" {
+		lead = append(lead, hzN(float64(k.opts)))
+	}
+	return hzFormula(k.fn, append(lead, k.args...))
+}
+
+// statCase: one formula, NAME(args), with its SUBTOTAL and AGGREGATE checks (none mostly).
+type statCase struct {
+	name   string
+	args   []hzArg
+	checks []numbered
+}
+
+func (c statCase) GoString() string {
+	formula, cells := hzFormula(c.name, c.args)
+	s := hzDesc(formula, cells)
+	for _, k := range c.checks {
+		formula, _ := k.formula()
+		s += "; " + formula
+	}
+	return s
+}
+
+// subtotalOf: SUBTOTAL of the range by a function number 1..11, plus 100 three times in ten.
+func subtotalOf(a []float64) hegel.Generator[numbered] {
+	return hegel.Composite(func(tc hegel.TestCase) numbered {
+		n := hegel.Draw(tc, hzInts(1, 11))
+		if hegel.Draw(tc, hzCoin(30)) {
+			n += 100
+		}
+		return numbered{fn: "SUBTOTAL", num: n, args: []hzArg{hzA(a)}}
+	})
+}
+
+// aggregateOf: AGGREGATE of the range by a function number 1..19 with options 0..7 and the
+// extra argument of 14 to 19 (a k of 1..n, a tenth, a quart of 1..3); 18 and 19
+// (PERCENTILE.EXC and QUARTILE.EXC, the shape of excelize/1 for most lengths) never under
+// HEGEL_NO_KNOWN=1.
+func aggregateOf(a []float64) hegel.Generator[numbered] {
+	n := len(a)
+	with := func(w, num int, extra hegel.Generator[float64]) hzChoice[numbered] {
+		return hzW(w, hegel.Composite(func(tc hegel.TestCase) numbered {
+			k := numbered{fn: "AGGREGATE", num: num, opts: hegel.Draw(tc, hzInts(0, 7)), args: []hzArg{hzA(a)}}
+			if extra != nil {
+				k.args = append(k.args, hzN(hegel.Draw(tc, extra)))
+			}
+			return k
+		}))
+	}
+	var choices []hzChoice[numbered]
+	for num := 1; num <= 13; num++ {
+		choices = append(choices, with(1, num, nil))
+	}
+	tenths := overTens(hzInts(1, 9), 1, 1)
+	quarts := floats(hzInts(1, 3))
+	return hzWeighted(append(choices,
+		with(1, 14, floats(hzInts(1, n))),
+		with(1, 15, floats(hzInts(1, n))),
+		with(1, 16, tenths),
+		with(1, 17, quarts),
+		with(hzUnless(hzNoKnown, 1), 18, tenths),
+		with(hzUnless(hzNoKnown, 1), 19, quarts),
+	)...)
+}
+
+// checksOf: the SUBTOTAL and AGGREGATE checks of a case whose first argument is a range,
+// three times in ten; none otherwise.
+func checksOf(args []hzArg) hegel.Generator[[]numbered] {
+	if len(args) == 0 || args[0].kind != 'a' {
+		return hegel.Just([]numbered(nil))
+	}
+	return hzMaybe(30, hzTuple(subtotalOf(args[0].arr), aggregateOf(args[0].arr)))
+}
+
+func statCasesOf(name string, args hegel.Generator[[]hzArg]) hegel.Generator[statCase] {
+	return hegel.FlatMap(args, func(a []hzArg) hegel.Generator[statCase] {
+		return hegel.Map(checksOf(a), func(ks []numbered) statCase { return statCase{name: name, args: a, checks: ks} })
+	})
+}
+
+// statSpecs: the 76 functions. HARMEAN is first: the library reads no range, so HARMEAN of
+// any range is #N/A and is where the shrinker lands (the first table entry, one value); the
+// rest follow the old spec's order.
+var statSpecs = []statSpec{
+	{name: "HARMEAN", args: harmeanArgs},
+	{name: "AVERAGE", args: oneRange},
+	{name: "MEDIAN", args: oneRange},
+	{name: "MODE.SNGL", args: oneRange},
+	{name: "MODE", args: oneRange},
+	{name: "STDEV", args: oneRange},
+	{name: "STDEV.S", args: oneRange},
+	{name: "STDEV.P", args: statOnly("STDEV.P", oneRange)},
+	{name: "STDEVP", args: statOnly("STDEVP", oneRange)},
+	{name: "VAR", args: statOnly("VAR", oneRange)},
+	{name: "VAR.S", args: statOnly("VAR.S", oneRange)},
+	{name: "VAR.P", args: statOnly("VAR.P", oneRange)},
+	{name: "VARP", args: statOnly("VARP", oneRange)},
+	{name: "DEVSQ", args: oneRange},
+	{name: "AVEDEV", args: avedevArgs},
+	{name: "GEOMEAN", args: statOnly("GEOMEAN", hzTuple(arr(geomeanRanges)))},
+	{name: "SKEW", args: statOnly("SKEW", oneRange)},
+	{name: "SKEW.P", args: statOnly("SKEW.P", oneRange)},
+	{name: "KURT", args: statOnly("KURT", oneRange)},
+	{name: "LARGE", args: rangeThen(ranges, byLength(ranksOf))},
+	{name: "SMALL", args: rangeThen(ranges, byLength(ranksOf))},
+	{name: "MAX", args: oneRange},
+	{name: "MIN", args: oneRange},
+	{name: "COUNT", args: oneRange},
+	{name: "PERCENTILE.INC", args: rangeThen(ranges, byLength(percentilesOf))},
+	{name: "PERCENTILE.EXC", args: percentileExcArgs},
+	{name: "PERCENTILE", args: rangeThen(ranges, byLength(percentilesOf))},
+	{name: "QUARTILE.INC", args: rangeAnd(num(quartiles))},
+	{name: "QUARTILE.EXC", args: quartileExcArgs},
+	{name: "QUARTILE", args: rangeAnd(num(quartiles))},
+	{name: "PERCENTRANK.INC", args: statOnly("PERCENTRANK.INC", percentrankArgs)},
+	{name: "PERCENTRANK.EXC", args: statOnly("PERCENTRANK.EXC", percentrankArgs)},
+	{name: "PERCENTRANK", args: statOnly("PERCENTRANK", percentrankArgs)},
+	{name: "RANK.EQ", args: rankArgs},
+	{name: "RANK", args: rankArgs},
+	{name: "TRIMMEAN", args: rangeAnd(num(percents))},
+	{name: "STANDARDIZE", args: hzTuple(num(numbers), num(numbers), num(sdevs))},
+	{name: "FISHER", args: hzTuple(num(fisherArgs))},
+	{name: "FISHERINV", args: statOnly("FISHERINV", hzTuple(num(numbers)))},
+	{name: "SUMPRODUCT", args: pairs},
+	{name: "SUMX2MY2", args: statOnly("SUMX2MY2", pairs)},
+	{name: "SUMX2PY2", args: statOnly("SUMX2PY2", pairs)},
+	{name: "SUMXMY2", args: statOnly("SUMXMY2", pairs)},
+	{name: "CORREL", args: statOnly("CORREL", pairs)},
+	{name: "PEARSON", args: statOnly("PEARSON", pairs)},
+	{name: "RSQ", args: statOnly("RSQ", pairs)},
+	{name: "SLOPE", args: statOnly("SLOPE", pairs)},
+	{name: "INTERCEPT", args: statOnly("INTERCEPT", pairs)},
+	{name: "STEYX", args: statOnly("STEYX", pairs)},
