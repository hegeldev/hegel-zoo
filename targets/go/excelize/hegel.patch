+// hzGenDateArgs draws the arguments of a date function.
+func hzGenDateArgs(tc hegel.TestCase, name string) []hzArg {
+	small := func(lo, hi int) hzArg {
+		v := float64(hzDrawInt(tc, lo, hi))
+		if hzChance(tc, 10) {
+			v += 0.5
+		}
+		return hzN(v)
+	}
+	switch name {
+	case "DATE":
+		var y hzArg
+		switch hzDrawInt(tc, 0, 9) {
+		case 0:
+			y = small(-5, 1899)
+		case 1:
+			y = small(9990, 10010)
+		case 2:
+			y = small(1900, 1901)
+		default:
+			y = small(1900, 9999)
+		}
+		return []hzArg{y, small(-14, 26), small(-40, 70)}
+	case "DAY", "MONTH", "YEAR", "ISOWEEKNUM", "HOUR", "MINUTE", "SECOND":
+		return []hzArg{hzN(hzGenSerial(tc))}
+	case "WEEKDAY", "WEEKNUM":
+		args := []hzArg{hzN(hzGenSerial(tc))}
+		if name == "WEEKNUM" && hzChance(tc, 20) {
+			// the first days of a year, where the ISO week belongs to the year before
+			if hzChance(tc, 50) {
+				return []hzArg{hzN(hzSerial(hzDrawInt(tc, 1901, 2400), 12, hzDrawInt(tc, 29, 31))), hzN(21)}
+			}
+			return []hzArg{hzN(hzSerial(hzDrawInt(tc, 1901, 2400), 1, hzDrawInt(tc, 1, 3))), hzN(21)}
+		}
+		if hzChance(tc, 70) {
+			args = append(args, hzN(float64(hzPick(tc, []int{1, 2, 3, 11, 12, 13, 14, 15, 16, 17, 21, 0, 4, 18, 22}))))
+		}
+		return args
+	case "EDATE", "EOMONTH":
+		s := hzGenSerial(tc)
+		if hzChance(tc, 15) {
+			// a month end, moved to a December
+			y, m := hzDrawInt(tc, 1901, 2400), hzDrawInt(tc, 1, 12)
+			s = hzSerial(y, m, hzDaysIn(y, m))
+			return []hzArg{hzN(s), hzN(float64(12*hzDrawInt(tc, -2, 2) - m))}
+		}
+		return []hzArg{hzN(s), small(-30, 30)}
+	case "DAYS":
+		return []hzArg{hzN(hzGenDay(tc)), hzN(hzGenDay(tc))}
+	case "DAYS360":
+		args := []hzArg{hzN(hzGenDay(tc)), hzN(hzGenDay(tc))}
+		if hzChance(tc, 50) {
+			args = append(args, hzB(hzGenBool(tc)))
+		}
+		return args
+	case "DATEDIF":
+		a, b := hzGenDay(tc), hzGenDay(tc)
+		if hzChance(tc, 90) && a > b {
+			a, b = b, a
+		}
+		return []hzArg{hzN(a), hzN(b), hzS(hzPick(tc, []string{"Y", "M", "D", "MD", "YM", "YD", "y", "m", "x"}))}
+	case "NETWORKDAYS", "NETWORKDAYS.INTL":
+		a := hzGenDay(tc)
+		b := a + float64(hzDrawInt(tc, -60, 60))
+		args := []hzArg{hzN(a), hzN(b)}
+		if name == "NETWORKDAYS.INTL" {
+			args = append(args, hzGenWeekend(tc))
+		}
+		if hzChance(tc, 50) {
+			args = append(args, hzGenHolidays(tc, a))
+		}
+		return args
+	case "WORKDAY", "WORKDAY.INTL":
+		a := hzGenDay(tc)
+		days := small(-40, 40)
+		args := []hzArg{hzN(a), days}
+		if name == "WORKDAY.INTL" {
+			args = append(args, hzGenWeekend(tc))
+		}
+		if hzChance(tc, 50) {
+			if days.num < 0 {
+				args = append(args, hzGenHolidays(tc, a-50))
+			} else {
+				args = append(args, hzGenHolidays(tc, a))
+			}
+		}
+		return args
+	case "YEARFRAC":
+		a := hzGenDay(tc)
+		b := a + float64(hzDrawInt(tc, -800, 800))
+		switch hzDrawInt(tc, 0, 9) {
+		case 0, 1, 2:
+			b = hzGenDay(tc)
+		case 3: // equal dates
+			b = a
+		case 4, 5: // the end of February to a 31st
+			y := hzDrawInt(tc, 1901, 2400)
+			a = hzSerial(y, 2, hzDaysIn(y, 2))
+			m := hzPick(tc, []int{1, 3, 5, 7, 8, 10, 12})
+			b = hzSerial(y+hzDrawInt(tc, 0, 3), m, 31)
+		}
+		args := []hzArg{hzN(a), hzN(b)}
+		if hzChance(tc, 80) {
+			args = append(args, small(-1, 5))
+		}
+		return args
+	case "TIME":
+		return []hzArg{small(0, 30), small(0, 90), small(0, 5000)}
+	case "DATEVALUE":
+		return []hzArg{hzS(hzGenDateText(tc))}
+	case "TIMEVALUE":
+		return []hzArg{hzS(hzGenTimeText(tc))}
+	}
+	return nil
+}
