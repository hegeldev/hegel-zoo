+package hegel
+
+// TestHegelMath: the mathematical and trigonometric functions on literal arguments agree with
+// their definitions (Python math, with Excel's decimal rounding rules for the rounding family),
+// and ARABIC(ROMAN(n, form)) and DECIMAL(BASE(n, radix), radix) round-trip.
+//
+// A case is one of the 70 functions with its arguments (mathCase), drawn from mathCases: the
+// function is sampled from the table mathSpecs and its arguments from the kind generators
+// (numbers, positives, units, ... as the old profiles, now weighted alternatives, simplest
+// first). The shapes of the recorded bugs are drawn like any other case: as alternatives of
+// weight zero under HEGEL_NO_KNOWN=1 (hzUnless), or as relations between the arguments that
+// are then filtered out (hzOnly) or built past (ROUNDDOWN's digits). The classifier mathShape
+// names the bug a case has the shape of, from the case and the oracle's verdict, before the
+// library is called; a mismatch then fails "(the shape of excelize/N)". The same judge
+// (judgeMath) serves the narrow properties of hegel_zoo_math_shapes_test.go.
+//
+// The shapes drawn here: excelize/2 (SEC), 6 (COMBIN's rounding), 7 (ODD), 8 (a fractional
+// num_digits), 9 (CEILING.MATH and FLOOR.MATH), 10 (infinite results), 15 (no truncation),
+// 17 (COTH), 18 (ROMAN), 19 (BASE and DECIMAL's checks), 21 (error codes), 23 (negative
+// counts), 29 (binary rounding), 31 (zero arguments), 33 (TRUNC's shortcut), 34 (a negative
+// zero), and the four the rewrite found, recorded as excelize/79 (COMBINA(0,0)), 80 (TRUNC
+// floors a negative fractional num_digits), 81 (TRUNC overflows int64) and 82 (DECIMAL strips
+// a 0x prefix).
+//
+// Model facts that are not gates: ACOT is judged to 1e-9 (pi/2 - atan(x) cancels for large x,
+// and the oracle skips |x| > 1e5); SUM, AVERAGE and SUMSQ to an absolute 1e-12 of the largest
+// term (binary sums cancel); the oracle does not judge COMBINA with number < number_chosen,
+// MROUND with multiple 0, SECH and CSCH beyond 700, ROMAN with a non-classic form.
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- kinds
+
+func floats(g hegel.Generator[int]) hegel.Generator[float64] {
+	return hegel.Map(g, func(i int) float64 { return float64(i) })
+}
+
+// overTens: a value of g divided by 10^e, e in [lo, hi].
+func overTens(g hegel.Generator[int], lo, hi int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		e := hegel.Draw(tc, hzInts(lo, hi))
+		return float64(v) / math.Pow(10, float64(e))
+	})
+}
+
+// timesTens: a value of g times 10^e, e in [lo, hi].
+func timesTens(g hegel.Generator[int], lo, hi int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		e := hegel.Draw(tc, hzInts(lo, hi))
+		return float64(v) * math.Pow(10, float64(e))
+	})
+}
+
+// signed: negative pct percent of the time (never a negative zero: the oracle has none).
+func signed(g hegel.Generator[float64], pct int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		if hegel.Draw(tc, hzCoin(pct)) {
+			v = -v
+		}
+		if v == 0 {
+			v = 0
+		}
+		return v
+	})
+}
+
+func num(g hegel.Generator[float64]) hegel.Generator[hzArg] { return hegel.Map(g, hzN) }
+
+var (
+	// magnitudes: the profiles of a number (hzGenNum), simplest first: small integers,
+	// integers to 1000, decimals of one to three places, quarters, decimals starting with
+	// zeros, large and small magnitudes.
+	magnitudes = hzWeighted(
+		hzW(1, floats(hzInts(0, 10))),
+		hzW(3, floats(hzInts(0, 1000))),
+		hzW(3, overTens(hzInts(0, 100000), 1, 3)),
+		hzW(1, hegel.Map(hzInts(0, 20), func(i int) float64 { return float64(i) / 4 })),
+		hzW(1, hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hzInts(0, 100))) + hegel.Draw(tc, overTens(hzInts(1, 99), 2, 6))
+		})),
+		hzW(1, timesTens(hzInts(1, 999), 3, 12)),
+		hzW(1, overTens(hzInts(1, 999), 3, 9)),
+	)
+
+	// numbers: a magnitude, negative 40% of the time.
+	numbers = signed(magnitudes, 40)
+
+	// positives: a nonzero magnitude (a zero becomes 1..9).
+	positives = hegel.FlatMap(magnitudes, func(v float64) hegel.Generator[float64] {
+		if v == 0 {
+			return floats(hzInts(1, 9))
+		}
+		return hegel.Just(v)
+	})
+
+	// units: thousandths of [-1, 1], the ends and just outside one time in ten.
+	units = hzWeighted(
+		hzW(9, overTens(hzInts(-1000, 1000), 3, 3)),
+		hzW(1, hzSampled(1.0, -1, 1.5, -2, 1.0000001)),
+	)
+
+	// angles: thousandths of [-20, 20].
+	angles = overTens(hzInts(-20000, 20000), 3, 3)
+
+	// secAngles: SEC's angle; the library returns the cosine, so every angle but 0 is the shape
+	// of excelize/2 (hzShaped: only 0 under HEGEL_NO_KNOWN=1).
+	secAngles = hzShaped(angles, hegel.Just(0.0))
+
+	smallInts = floats(hzInts(-50, 50))
+
+	// counts: 0..30, a negative (the shape of excelize/21 or excelize/23 in the counting
+	// functions, never under HEGEL_NO_KNOWN=1) or a fraction (truncated by COMBIN, COMBINA and
+	// PERMUTATIONA; a relation of excelize/15 in PERMUT, MULTINOMIAL, GCD and LCM, filtered
+	// there) one time in ten each.
+	counts = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(-1.0, -2)),
+		hzW(1, hzSampled(2.5, 0.5)),
+		hzW(18, floats(hzInts(0, 30))),
+	)
+
+	// nats200: 0..40, 160..200 (FACTDOUBLE; FACT's factCounts keeps the overflow apart), a
+	// negative or a fraction.
+	nats200 = hzWeighted(
+		hzW(76, floats(hzInts(0, 40))),
+		hzW(15, floats(hzInts(160, 200))),
+		hzW(9, hzSampled(-1.0, -2, 2.5, 170.9, 0.5)),
+	)
+
+	// factCounts: FACT's number; 171 and above overflow to +INF, the shape of excelize/10
+	// (never under HEGEL_NO_KNOWN=1).
+	factCounts = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 8), floats(hzInts(171, 200))),
+		hzW(76, floats(hzInts(0, 40))),
+		hzW(7, floats(hzInts(160, 170))),
+		hzW(9, hzSampled(-1.0, -2, 2.5, 170.9, 0.5)),
+	)
+
+	// bigProducts: (1..2^30) times (1..2^22), below 2^53.
+	bigProducts = hegel.Composite(func(tc hegel.TestCase) float64 {
+		return float64(hegel.Draw(tc, hzInts(1, 1<<30))) * float64(hegel.Draw(tc, hzInts(1, 1<<22)))
+	})
+
+	// nats53: BASE's number: to 100000, a big product, the powers of two around 2^32 and
+	// 2^53 and a fraction; -1 and 2^53 are the shape of excelize/19 (never under
+	// HEGEL_NO_KNOWN=1).
+	nats53 = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(-1.0, 9007199254740992)),
+		hzW(4, floats(hzInts(0, 100000))),
+		hzW(1, bigProducts),
+		hzW(1, hzSampled(0.0, 1, 4294967295, 4294967296, 9007199254740991, 2.5)),
+	)
+
+	// validNats53: the round trip's number (every value BASE documents).
+	validNats53 = hzWeighted(
+		hzW(4, floats(hzInts(0, 100000))),
+		hzW(1, bigProducts),
+		hzW(1, hzSampled(0.0, 1, 4294967295, 4294967296, 9007199254740991)),
+	)
+
+	// digits: ROUND, ROUNDUP and ROUNDDOWN's num_digits: 0..8, negative one time in four,
+	// 15 rarely, and a fraction (the shape of excelize/8, never under HEGEL_NO_KNOWN=1).
+	digits = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 6), hzSampled(1.5, -1.5, 2.9)),
+		hzW(73, floats(hzInts(0, 8))),
+		hzW(27, floats(hzInts(-6, -1))),
+		hzW(2, hegel.Just(15.0)),
+	)
+
+	// truncDigits: TRUNC's num_digits: TRUNC truncates a positive fraction (no shape) and
+	// floors a negative one (the shape of excelize/80 where the digit that makes the
+	// difference is not 0; never under HEGEL_NO_KNOWN=1); 15 reaches the int64 overflow of
+	// excelize/81 for |x| of 9223.4 or more with a nonzero fraction, a relation the hzOnly
+	// filter of TRUNC excludes under HEGEL_NO_KNOWN=1.
+	truncDigits = hzWeighted(
+		hzW(73, floats(hzInts(0, 8))),
+		hzW(27, floats(hzInts(-6, -1))),
+		hzW(4, hzSampled(1.5, 2.9)),
+		hzW(hzUnless(hzNoKnown, 2), hzSampled(-1.5, -0.5, -2.5)),
+		hzW(2, hegel.Just(15.0)),
+	)
+
+	// significances: the multiples of the FLOOR family and MROUND (0 is not judged for MROUND
+	// and is 0 for the PRECISE functions).
+	significances = hzSampled(1.0, 2, 5, 10, 100, 1000, 0.5, 0.25, 0.1, 0.01, 0.001, 0.2, 3, 7, -1, -2, -0.5, -0.1, 0)
+
+	// sigsOrZero: CEILING, CEILING.MATH, FLOOR.MATH and FLOOR's significance: 0 (the shape of
+	// excelize/9, or excelize/21 for FLOOR; never under HEGEL_NO_KNOWN=1) first, then the
+	// nonzero table.
+	sigsOrZero = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hegel.Just(0.0)),
+		hzW(18, hzSampled(1.0, 2, 5, 10, 100, 1000, 0.5, 0.25, 0.1, 0.01, 0.001, 0.2, 3, 7, -1, -2, -0.5, -0.1)),
+	)
+
+	modes = hzSampled(0.0, 1, -1, 2, 0.5, -3)
+
+	// radixes: 2..36, a fraction (truncated: no shape) and, never under HEGEL_NO_KNOWN=1, a
+	// radix out of range (the shape of excelize/21; 0 is excelize/19 in DECIMAL).
+	radixes = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 2), hzSampled(1.0, 37, 0, -2)),
+		hzW(27, floats(hzInts(2, 36))),
+		hzW(1, hzSampled(2.5, 16.9)),
+	)
+
+	// minLengths: BASE's min_length: 0..20 and, never under HEGEL_NO_KNOWN=1, out of range
+	// (excelize/19) or a fraction (excelize/15).
+	minLengths = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(-1.0, 256, 2.7)),
+		hzW(9, floats(hzInts(0, 20))),
+	)
+
+	// romans: ROMAN's number: 0..3999, 3999.9 (truncated) and, never under HEGEL_NO_KNOWN=1,
+	// out of range (excelize/18).
+	romans = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(4000.0, -1)),
+		hzW(38, floats(hzInts(0, 3999))),
+		hzW(1, hegel.Just(3999.9)),
+	)
+
+	// forms: ROMAN's form: 0..4, a boolean (TRUE is the shape of excelize/18 when the concise
+	// numeral differs from the classic one, a relation romanArgs filters; FALSE is not
+	// judged), 2.5 (not judged) and, never under HEGEL_NO_KNOWN=1, out of range (excelize/18).
+	forms = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 2), num(hzSampled(5.0, -1))),
+		hzW(48, num(floats(hzInts(0, 4)))),
+		hzW(9, hegel.Map(hzCoin(50), hzB)),
+		hzW(1, hegel.Just(hzN(2.5))),
+	)
+
+	exponents = hzSampled(0.0, 1, 2, 3, -1, -2, 0.5, -0.5, 2.5, 1.0/3, 10, 0.25, -3, 4)
+
+	// seriesProfiles: the value profiles of a series (hzGenSeries).
+	seriesProfiles = []hegel.Generator[float64]{
+		floats(hzInts(-20, 20)),
+		overTens(hzInts(-1000, 1000), 1, 1),
+		floats(hzInts(0, 100)),
+		overTens(hzInts(-100000, 100000), 3, 3),
+		timesTens(hzInts(1, 999), 3, 3),
+	}
+
+	// series: one to six values of one profile, a third of the time from a pool of one to
+	// three values so that ties and constant ranges are common.
+	series = hegel.FlatMap(hzInts(1, 6), func(n int) hegel.Generator[[]float64] {
+		return hegel.FlatMap(hzInts(0, len(seriesProfiles)-1), func(p int) hegel.Generator[[]float64] {
+			return hzWeighted(
+				hzW(2, hzCounted(seriesProfiles[p], n, n)),
+				hzW(1, hegel.FlatMap(hzCounted(seriesProfiles[p], 1, 3), func(pool []float64) hegel.Generator[[]float64] {
+					return hzCounted(hegel.SampledFrom(pool), n, n)
+				})),
+			)
+		})
+	})
+)
+
+// --------------------------------------------------------------------------- argument lists
+
+// noShape is the predicate of the hzOnly filters: the case has no recorded bug's shape, judged
+// with the Go model's verdict (goVerdict) where the shape is a relation of the result.
+func noShape(name string) func([]hzArg) bool {
+	return func(args []hzArg) bool {
+		c := mathCase{name: name, args: args}
+		return mathShape(c, goVerdict(c)) == ""
+	}
+}
+
+// only is hzOnly over the arguments of name under HEGEL_NO_KNOWN=1, named after the function.
+func only(name string, g hegel.Generator[[]hzArg]) hegel.Generator[[]hzArg] {
+	return hzOnly(hzNoKnown, name, g, noShape(name))
+}
+
+// orderedCountsFrom: (n, k) with n in lo..30 and k at most n, for COMBIN, COMBINA and PERMUT
+// under HEGEL_NO_KNOWN=1 (number_chosen above number is the shape of excelize/21 in half of
+// the unordered pairs, too many to filter); by default the unordered pairs are drawn too.
+func orderedCountsFrom(lo int) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(floats(hzInts(lo, 30)), func(n float64) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzN(n)), num(hzWeighted(
+			hzW(18, floats(hzInts(0, int(n)))),
+			hzW(1, hzSampled(0.5, math.Max(n-0.5, 0.5))),
+		)))
+	})
+}
+
+var countPairs = hzWeighted(
+	hzW(hzUnless(hzNoKnown, 3), hzTuple(num(counts), num(counts))),
+	hzW(4, orderedCountsFrom(0)),
+)
+
+// combinaPairs: COMBINA's pairs, countPairs, whose (0,0) (two counts of 0 or two fractions
+// below 1, and the ordered pairs' n = 0) is the shape of excelize/79; under HEGEL_NO_KNOWN=1
+// the ordered pairs from n = 1 (hzShaped: the filter is then excelize/6's relation alone).
+var combinaPairs = hzShaped(countPairs, orderedCountsFrom(1))
+
+// digitChars: one of the digits lo..hi of base 36, lowercase 20% of the time.
+func digitChars(lo, hi int) hegel.Generator[byte] {
+	return hegel.Composite(func(tc hegel.TestCase) byte {
+		c := hzDigits36[hegel.Draw(tc, hzInts(lo, hi))]
+		if hegel.Draw(tc, hzCoin(20)) {
+			c = strings.ToLower(string(c))[0]
+		}
+		return c
+	})
+}
+
+func text(g hegel.Generator[[]byte]) hegel.Generator[hzArg] {
+	return hegel.Map(g, func(b []byte) hzArg { return hzS(string(b)) })
+}
+
+// hexPrefix: the prefix 0x, or 0X one time in five.
+var hexPrefix = hegel.Map(hzCoin(20), func(upper bool) []byte {
+	if upper {
+		return []byte("0X")
+	}
+	return []byte("0x")
+})
+
+// decimalArgs: DECIMAL's text and radix, the text of one to eight digits of the radix (a
+// radix out of range takes any digit) or, never under HEGEL_NO_KNOWN=1, with a digit at or
+// above the radix (the shape of excelize/21) or, for a radix in range, 0x or 0X before one to
+// six digits of the radix (the shape of excelize/82: the library strips the prefix in every
+// radix), one draw in eleven.
+var decimalArgs = hegel.FlatMap(radixes, func(r float64) hegel.Generator[[]hzArg] {
+	base := int(r)
+	inRange := base >= 2 && base <= 36
+	if !inRange {
+		base = 36
+	}
+	var choices []hzChoice[[]byte]
+	if base < 36 {
+		above := hzSeq(hzCounted(digitChars(0, base-1), 0, 3), hzOne(digitChars(base, 35)), hzCounted(digitChars(0, 35), 0, 4))
+		choices = append(choices, hzW(hzUnless(hzNoKnown, 2), above))
+	}
+	if inRange {
+		prefixed := hzSeq(hexPrefix, hzCounted(digitChars(0, base-1), 1, 6))
+		choices = append(choices, hzW(hzUnless(hzNoKnown, 1), prefixed))
+	}
+	choices = append(choices, hzW(8, hzCounted(digitChars(0, base-1), 1, 8)))
+	return hzTuple(text(hzWeighted(choices...)), hegel.Just(hzN(r)))
+})
+
+// romanForm1Differs: the concise form 1 numeral of n differs from the classic one (the
+// library's form 1 table adds LM 950, LD 450, VC 95 and VL 45; checked against the library
+// for every n in 0..3999).
+func romanForm1Differs(n float64) bool {
+	r1000 := math.Mod(n, 1000)
+	r100 := math.Mod(n, 100)
+	return r1000 >= 950 || (450 <= r1000 && r1000 < 500) || r100 >= 95 || (45 <= r100 && r100 < 50)
+}
+
+// romanArgs: ROMAN's number and form; the form TRUE is read as form 1 (excelize/18) where
+// that differs, a relation filtered out under HEGEL_NO_KNOWN=1 (measured: 1.2% of ROMAN's
+// draws rejected; the other hzOnly filters reject 0.3% (LOG) to 26% (ATANH, the engine
+// favouring the ends of the unit range) of their function's draws, so a give-up after three
+// rejections is below 2% of any function's cases).
+var romanArgs = hzOnly(hzNoKnown, "ROMAN", hzWeighted(
+	hzW(1, hzTuple(num(romans))),
+	hzW(1, hzTuple(num(romans), forms)),
+), func(a []hzArg) bool {
+	return !(len(a) == 2 && a[1].kind == 'b' && a[1].b && romanForm1Differs(math.Trunc(a[0].num)))
+})
+
+// roundDownArgs: ROUNDDOWN's number and digits. The binary quotient misses an exact decimal
+// (excelize/29) in half of the plain draws with positive digits, too many to filter, so under
+// HEGEL_NO_KNOWN=1 the digits are not positive, or the number has more decimals than the
+// digits keep (a quotient that is not an integer is never missed).
+var roundDownArgs = hzWeighted(
+	hzW(hzUnless(hzNoKnown, 2), hzTuple(num(numbers), num(digits))),
+	hzW(1, hzTuple(num(numbers), num(floats(hzInts(-6, 0))))),
+	hzW(1, hegel.FlatMap(hzInts(1, 6), func(d int) hegel.Generator[[]hzArg] {
+		return hzTuple(num(signed(overTens(hzInts(1, 99999), d+1, d+3), 40)), hegel.Just(hzN(float64(d))))
+	})),
+)
+
+// one to six arguments of g
+func some(g hegel.Generator[hzArg]) hegel.Generator[[]hzArg] { return hzCounted(g, 1, 6) }
+
+// optional: the required arguments, then one or two optional ones, the shorter lists first
+// (50% stop at each optional, as the old spec's "?").
+func optional(required hegel.Generator[[]hzArg], optionals ...hegel.Generator[hzArg]) hegel.Generator[[]hzArg] {
+	choices := []hzChoice[[]hzArg]{hzW(len(optionals), required)}
+	for i := range optionals {
+		choices = append(choices, hzW(1, hzSeq(required, hzTuple(optionals[:i+1]...))))
+	}
+	return hzWeighted(choices...)
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// mathSpec: a function and the generator of its argument lists (and of its round trip's
+// arguments, if it has one).
+type mathSpec struct {
+	name string
+	args hegel.Generator[[]hzArg]
+	trip hegel.Generator[[]float64]
+}
+
+// mathCase: one formula, NAME(args), with the round trip's arguments (n and form for ROMAN,
+// n and radix for BASE).
+type mathCase struct {
+	name string
+	args []hzArg
+	trip []float64
+}
+
+func (c mathCase) GoString() string {
+	formula, cells := hzFormula(c.name, c.args)
+	s := hzDesc(formula, cells)
+	if t := c.tripFormula(); t != "" {
+		s += "; " + t
+	}
+	return s
+}
+
+// tripFormula is the round trip's formula, "" for none.
+func (c mathCase) tripFormula() string {
+	switch {
+	case c.name == "ROMAN" && len(c.trip) == 2:
+		return fmt.Sprintf("ARABIC(ROMAN(%s,%s))", hzNumLit(c.trip[0]), hzNumLit(c.trip[1]))
+	case c.name == "BASE" && len(c.trip) == 2:
+		return fmt.Sprintf("DECIMAL(BASE(%s,%s),%s)", hzNumLit(c.trip[0]), hzNumLit(c.trip[1]), hzNumLit(c.trip[1]))
+	}
+	return ""
+}
+
+func casesOf(name string, args hegel.Generator[[]hzArg]) hegel.Generator[mathCase] {
+	return hegel.Map(args, func(a []hzArg) mathCase { return mathCase{name: name, args: a} })
+}
+
+// mathSpecs: the 70 functions. SEC is first: the library returns the cosine, so SEC fails on
+// every angle but 0 and is where the shrinker lands (the first table entry, the smallest
+// nonzero angle); the rest follow the old spec's order.
+var mathSpecs = []mathSpec{
+	{name: "SEC", args: hzTuple(num(secAngles))},
+	{name: "ABS", args: hzTuple(num(numbers))},
+	{name: "ACOS", args: hzTuple(num(units))},
+	{name: "ACOSH", args: hzTuple(num(numbers))},
+	{name: "ACOT", args: hzTuple(num(numbers))},
+	{name: "ACOTH", args: only("ACOTH", hzTuple(num(numbers)))},
+	{name: "ASIN", args: hzTuple(num(units))},
+	{name: "ASINH", args: hzTuple(num(numbers))},
+	{name: "ATAN", args: hzTuple(num(numbers))},
+	{name: "ATANH", args: only("ATANH", hzTuple(num(units)))},
+	{name: "ATAN2", args: only("ATAN2", hzTuple(num(numbers), num(numbers)))},
+	{name: "BASE", args: optional(hzTuple(num(nats53), num(radixes)), num(minLengths)), trip: hzTuple(validNats53, floats(hzInts(2, 36)))},
+	{name: "CEILING", args: only("CEILING", hzTuple(num(numbers), num(sigsOrZero)))},
+	{name: "CEILING.MATH", args: only("CEILING.MATH", optional(hzTuple(num(numbers)), num(sigsOrZero), num(modes)))},
+	{name: "CEILING.PRECISE", args: only("CEILING.PRECISE", optional(hzTuple(num(numbers)), num(significances)))},
+	{name: "ISO.CEILING", args: only("ISO.CEILING", optional(hzTuple(num(numbers)), num(significances)))},
+	{name: "COMBIN", args: only("COMBIN", countPairs)},
+	{name: "COMBINA", args: only("COMBINA", combinaPairs)},
+	{name: "PERMUT", args: only("PERMUT", countPairs)},
+	{name: "PERMUTATIONA", args: hzTuple(num(counts), num(counts))},
+	{name: "MULTINOMIAL", args: only("MULTINOMIAL", some(num(counts)))},
+	{name: "COS", args: hzTuple(num(angles))},
+	{name: "COSH", args: only("COSH", hzTuple(num(numbers)))},
+	{name: "COT", args: hzTuple(num(angles))},
+	{name: "COTH", args: only("COTH", hzTuple(num(numbers)))},
+	{name: "CSC", args: hzTuple(num(angles))},
+	{name: "CSCH", args: hzTuple(num(numbers))},
+	{name: "SECH", args: hzTuple(num(numbers))},
+	{name: "SIN", args: hzTuple(num(angles))},
+	{name: "SINH", args: only("SINH", hzTuple(num(numbers)))},
+	{name: "TAN", args: hzTuple(num(angles))},
+	{name: "TANH", args: hzTuple(num(numbers))},
+	{name: "DECIMAL", args: decimalArgs},
+	{name: "DEGREES", args: only("DEGREES", hzTuple(num(numbers)))},
+	{name: "RADIANS", args: hzTuple(num(numbers))},
+	{name: "EVEN", args: hzTuple(num(numbers))},
+	{name: "ODD", args: only("ODD", hzTuple(num(numbers)))},
+	{name: "EXP", args: only("EXP", hzTuple(num(numbers)))},
