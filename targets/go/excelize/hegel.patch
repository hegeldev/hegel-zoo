+// truncNegativeDigitsCase: TRUNC(x, d) with d = t - f for t in -4..0 and a fraction f (so
+// floor(d) is -5..-1, where 10^floor(d) is above its decimal in binary and the product never
+// falls a unit short) and |x| = (10 a + r) 10^|t| + lower with lower below 10^|t|, plus one
+// to three decimals half the time; negative 30%. The digit r at 10^|t| is kept by a
+// truncation to trunc(d) and dropped by one to floor(d), so the result differs exactly when
+// r is not 0.
+func truncNegativeDigitsCase(r hegel.Generator[int]) hegel.Generator[mathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		t := hegel.Draw(tc, hzInts(-4, 0))
+		d := float64(t) - hegel.Draw(tc, hzSampled(0.5, 0.1, 0.9, 0.25, 0.75))
+		unit := int(math.Pow(10, float64(-t)))
+		whole := (10*hegel.Draw(tc, hzInts(0, 999))+hegel.Draw(tc, r))*unit + hegel.Draw(tc, hzInts(0, unit-1))
+		x := float64(whole)
+		if hegel.Draw(tc, hzCoin(50)) {
+			p := hegel.Draw(tc, hzInts(1, 3))
+			x = decimalOf(whole*int(math.Pow(10, float64(p)))+hegel.Draw(tc, hzInts(1, int(math.Pow(10, float64(p)))-1)), p)
+		}
+		if hegel.Draw(tc, hzCoin(30)) {
+			x = -x
+		}
+		return mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(d)}}
+	})
+}
+
+// truncNegativeDigits: the digit r in 1..9 (TRUNC(685,-1.5) = 600, want 680). Past the shape,
+// r = 0 (both truncations agree) and a negative integer num_digits with x a multiple of
+// 10^|d|. Hit rate 1000 of 1000.
+var truncNegativeDigits = hzShaped(
+	truncNegativeDigitsCase(hzInts(1, 9)),
+	hzWeighted(
+		hzW(2, truncNegativeDigitsCase(hzInts(0, 0))),
+		hzW(1, hegel.Composite(func(tc hegel.TestCase) mathCase {
+			d := hegel.Draw(tc, hzInts(-5, -1))
+			x := hegel.Draw(tc, signed(floats(hzInts(0, 999)), 30)) * math.Pow(10, float64(-d))
+			return mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(float64(d))}}
+		})),
+	),
+)
+
+func TestHegelMathTruncNegativeDigitsAreTruncated(t *testing.T) { narrowMath(t, truncNegativeDigits) }
+
+// --------------------------------------------------------------------------- excelize/81
+
+// overflowDigits: the smallest f with |x| 10^f at or above 2^63 (the float64 product, as the
+// library forms it).
+func overflowDigits(x float64) int {
+	f := 1
+	for !overflowsInt64(math.Abs(x) * math.Pow(10, float64(f))) {
+		f++
+	}
+	return f
+}
+
+// truncOverflowCase: TRUNC(x, d) for |x| = a + k / 10^p of five to twelve digits before the
+// point and one to three after it, k coprime to 10 and 3 or more at one place (a dyadic
+// fraction's digits end in zeros, and 0.1 may come out 0.0999... in binary: either fires the
+// shortcut), negative 30%, with floor(d) = clamp(overflowDigits(x) + off) (off from offsets;
+// d a half more one time in four).
+func truncOverflowCase(offsets hegel.Generator[int], clamp func(int) int) hegel.Generator[mathCase] {
+	magnitudes := hzWeighted(
+		hzW(1, hzInts(10000, 99999)),
+		hzW(1, hzInts(100000, 9999999)),
+		hzW(1, hzInts(100000000, 9999999999)),
+		hzW(1, hzInts(100000000000, 999999999999)),
+	)
+	fractions := hegel.FlatMap(hzInts(1, 3), func(p int) hegel.Generator[[]int] {
+		if p == 1 {
+			return hzTuple(hegel.Just(p), hzSampled(3, 7, 9))
+		}
+		scale := int(math.Pow(10, float64(p)))
+		return hzTuple(hegel.Just(p), hegel.Map(hzTuple(hzInts(scale/100, scale/10-1), hzSampled(1, 3, 7, 9)), func(v []int) int { return 10*v[0] + v[1] }))
+	})
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		pk := hegel.Draw(tc, fractions)
+		p, k := pk[0], pk[1]
+		x := decimalOf(hegel.Draw(tc, magnitudes)*int(math.Pow(10, float64(p)))+k, p)
+		if hegel.Draw(tc, hzCoin(30)) {
+			x = -x
+		}
+		d := float64(clamp(overflowDigits(x) + hegel.Draw(tc, offsets)))
+		if hegel.Draw(tc, hzCoin(25)) {
+			d += 0.5
+		}
+		return mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(d)}}
+	})
+}
+
+// truncOverflows: TRUNC(x, d) with floor(d) from the overflow bound of x (9 to 15 at these
+// magnitudes) to three above it, at most 15, filtered to the cases the shortcut of
+// excelize/33 does not rescue: where int(frac(|x|) 10^floor(d)) ends in a 0 the library
+// returns x, which is right here, and that digit is a binary residue of the fraction, 0
+// about one time in ten (from 16 digits on the product's ulp is 16 or more and one in five
+// ends in 0; from 19 the fractional digits overflow too): 88 draws in 100 pass, measured
+// over 2000 draws. Past the shape, floor(d) one to three below the bound (3 at least: x has
+// at most three decimals, so the truncation and the shortcut both give x). Hit rate 1000 of
+// 1000.
+var truncOverflows = hzShaped(
+	hegel.Filter(truncOverflowCase(hzInts(0, 3), func(f int) int { return min(f, 15) }), func(c mathCase) bool {
+		return mathShape(c, goVerdict(c)) == "excelize/81"
+	}),
+	truncOverflowCase(hzInts(-3, -1), func(f int) int { return max(f, 3) }),
+)
+
+func TestHegelMathTruncOverflowsTheDigits(t *testing.T) { narrowMath(t, truncOverflows) }
+
+// --------------------------------------------------------------------------- excelize/82
+
+// decimalTextsOf: DECIMAL's text and radix, the text by the radix.
+func decimalTextsOf(texts func(r int) hegel.Generator[[]byte]) hegel.Generator[mathCase] {
+	return casesOf("DECIMAL", hegel.FlatMap(hzInts(2, 36), func(r int) hegel.Generator[[]hzArg] {
+		return hzTuple(text(texts(r)), hegel.Just(hzN(float64(r))))
+	}))
+}
+
+// decimalRejectsAPrefix: DECIMAL of 0x or 0X before one to eight digits of the radix (the
+// prefix is stripped in every radix: below radix 34 the X is no digit and #NUM! is due, from
+// 34 on it is the digit 33 and the value has 0 and X as its leading digits). Past the shape,
+// the digits alone, a leading 0 before digits other than X, "0x" alone from radix 34 (two
+// characters are not stripped: 33), and an X after the first two characters from 34 on. Hit
+// rate 1000 of 1000.
+var decimalRejectsAPrefix = hzShaped(
+	decimalTextsOf(func(r int) hegel.Generator[[]byte] {
+		return hzSeq(hexPrefix, hzCounted(digitChars(0, r-1), 1, 8))
+	}),
+	hzWeighted(
+		hzW(2, decimalTextsOf(func(r int) hegel.Generator[[]byte] { return hzCounted(digitChars(0, r-1), 1, 8) })),
+		hzW(1, decimalTextsOf(func(r int) hegel.Generator[[]byte] {
+			return hzSeq(hzOne(hegel.Just(byte('0'))), hzCounted(digitChars(0, min(r, 33)-1), 1, 7))
+		})),
+		hzW(1, casesOf("DECIMAL", hzTuple(text(hexPrefix), num(floats(hzInts(34, 36)))))),
+		hzW(1, casesOf("DECIMAL", hegel.FlatMap(hzInts(34, 36), func(r int) hegel.Generator[[]hzArg] {
+			return hzTuple(text(hzSeq(hzCounted(digitChars(0, 32), 2, 3), hzOne(digitChars(33, 33)), hzCounted(digitChars(0, r-1), 0, 4))), hegel.Just(hzN(float64(r))))
+		}))),
+	),
+)
+
+func TestHegelMathDecimalRejectsAPrefix(t *testing.T) { narrowMath(t, decimalRejectsAPrefix) }
diff --git a/hegel/hegel_zoo_math_test.go b/hegel/hegel_zoo_math_test.go
