+func hzGenDateText(tc hegel.TestCase) string {
+	y, m, d := hzDrawInt(tc, 1900, 9999), hzDrawInt(tc, 1, 12), hzDrawInt(tc, 1, 31)
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		m = hzDrawInt(tc, 0, 14)
+	case 1:
+		d = hzDrawInt(tc, 0, 33)
+	case 2:
+		y = hzDrawInt(tc, 1890, 1910)
+	}
+	if hzChance(tc, 50) {
+		return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
+	}
+	return fmt.Sprintf("%d/%d/%04d", m, d, y)
+}
+
+func hzGenTimeText(tc hegel.TestCase) string {
+	h, m, s := hzDrawInt(tc, 0, 23), hzDrawInt(tc, 0, 59), hzDrawInt(tc, 0, 59)
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		h = hzDrawInt(tc, 24, 30)
+	case 1:
+		m = hzDrawInt(tc, 60, 70)
+	case 2:
+		s = hzDrawInt(tc, 60, 70)
+	}
+	switch hzDrawInt(tc, 0, 3) {
+	case 0:
+		return fmt.Sprintf("%d:%02d", h, m)
+	case 1:
+		h12 := hzDrawInt(tc, 0, 13)
+		return fmt.Sprintf("%d:%02d %s", h12, m, hzPick(tc, []string{"AM", "PM", "am", "pm"}))
+	}
+	return fmt.Sprintf("%d:%02d:%02d", h, m, s)
+}
