+var hzDateFuncs = []string{"DATE", "DAY", "MONTH", "YEAR", "WEEKDAY", "WEEKNUM", "ISOWEEKNUM", "EDATE", "EOMONTH",
+	"DAYS", "DAYS360", "DATEDIF", "NETWORKDAYS", "NETWORKDAYS.INTL", "WORKDAY", "WORKDAY.INTL", "YEARFRAC",
+	"TIME", "HOUR", "MINUTE", "SECOND", "DATEVALUE", "TIMEVALUE"}
