+    return xresult(v)
+
+def ISBLANK(v):
+    return False
+
+def ISERR(v):
+    return isinstance(v, XE) and v.code != NA
+
+def ISERROR(v):
+    return isinstance(v, XE)
+
+def ISNA(v):
+    return isinstance(v, XE) and v.code == NA
+
+def ISLOGICAL(v):
+    return isinstance(v, bool)
+
+def ISNUMBER(v):
+    return not isinstance(v, (bool, str, list, XE))
+
+def ISTEXT(v):
+    return isinstance(v, str)
+
+def ISNONTEXT(v):
+    return not isinstance(v, str)
+
+def xparity(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        raise XErr(VALUE)
+    if isinstance(v, str):
+        try:
+            v = float(v)
+        except ValueError:
