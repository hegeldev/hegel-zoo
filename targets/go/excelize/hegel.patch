+	{name: "SUM", args: some(num(numbers))},
+	{name: "SUMSQ", args: some(num(numbers))},
+	{name: "AVERAGE", args: some(num(numbers))},
+	{name: "HARMEAN", args: some(num(positives))},
+	{name: "AVEDEV", args: some(num(numbers))},
+}
+
+// mathCases: a function of the table with its arguments and, for ROMAN and BASE, the round
+// trip's arguments.
+var mathCases = hegel.FlatMap(hegel.SampledFrom(mathSpecs), func(s mathSpec) hegel.Generator[mathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		c := mathCase{name: s.name, args: hegel.Draw(tc, s.args)}
+		if s.trip != nil {
+			c.trip = hegel.Draw(tc, s.trip)
+		}
+		return c
+	})
+})
+
+// --------------------------------------------------------------------------- the library's arithmetic
+
+// The arithmetic of the library's rounding functions, replicated so that the classifier can
+// tell before the call whether the binary quotient misses the exact decimal result
+// (excelize/29), whether TRUNC's shortcut fires (excelize/33) and whether COMBIN's product
+// rounds up (excelize/6).
+
+// libRound is calc.go's round(): the significance 10^-digits, the quotient split by Modf.
+func libRound(name string, x, d float64) float64 {
+	var sig float64
+	if d > 0 {
+		sig = math.Pow(1/10.0, d)
+	} else {
+		sig = math.Pow(10.0, -d)
+	}
+	val, res := math.Modf(x / sig)
+	switch name {
+	case "ROUND":
+		const eps = 0.499999999
+		if res >= eps {
+			val++
+		} else if res <= -eps {
+			val--
+		}
+	case "ROUNDUP":
+		if res > 0 {
+			val++
+		} else if res < 0 {
+			val--
+		}
+	}
+	return val * sig
+}
+
+// libTrunc is calc.go's TRUNC: the shortcut (the fractional digits, trailing zeros stripped,
+// below 10^(digits-1)) returns the number itself; otherwise int(number 10^digits) / 10^digits.
+func libTrunc(x, d float64) (v float64, shortcut bool) {
+	d = math.Floor(d)
+	adjust := math.Pow(10, d)
+	r := int((math.Abs(x) - math.Abs(float64(int(x)))) * adjust)
+	rtrim := 0.0
+	if r != 0 {
+		rtrim, _ = strconv.ParseFloat(strings.TrimRight(strconv.Itoa(r), "0"), 64)
+	}
+	if d > 0 && rtrim < adjust/10 {
+		return x, true
+	}
+	return float64(int(x*adjust)) / adjust, false
+}
+
+// libMultiple is calc.go's FLOOR family and MROUND (two or three arguments): Modf of the
+// quotient, the adjustment the function makes; ok is false for an error.
+func libMultiple(name string, x, s, mode float64) (v float64, ok bool) {
+	switch name {
+	case "CEILING":
+		if s < 0 && x > 0 {
+			return 0, false
+		}
+		val, res := math.Modf(x / s)
+		if res > 0 {
+			val++
+		}
+		return val * s, true
+	case "FLOOR":
+		if s < 0 && x >= 0 {
+			return 0, false
+		}
+		val, res := math.Modf(x / s)
+		if res != 0 && x < 0 && res < 0 {
+			val--
+		}
+		return val * s, true
+	case "CEILING.MATH":
+		val, res := math.Modf(x / s)
+		if res != 0 {
+			if x > 0 {
+				val++
+			} else if mode < 0 {
+				val--
+			}
+		}
+		return val * s, true
+	case "FLOOR.MATH":
+		val, res := math.Modf(x / s)
+		if res != 0 && x < 0 && mode > 0 {
+			val--
+		}
+		return val * s, true
+	case "CEILING.PRECISE", "ISO.CEILING":
+		s = math.Abs(s)
+		if s == 0 {
+			return 0, true
+		}
+		val, res := math.Modf(x / s)
+		if res != 0 && x > 0 {
+			val++
+		}
+		return val * s, true
+	case "FLOOR.PRECISE":
+		s = math.Abs(s)
+		if s == 0 {
+			return 0, true
+		}
+		val, res := math.Modf(x / s)
+		if res != 0 && x < 0 {
+			val--
+		}
+		return val * s, true
+	case "MROUND":
+		if s == 0 || s < 0 && x > 0 || s > 0 && x < 0 {
+			return 0, false
+		}
+		val, res := math.Modf(x / s)
+		if math.Trunc(res+0.5) > 0 {
+			val++
+		}
+		return val * s, true
+	}
+	panic("libMultiple: " + name)
+}
+
+// libCombin is calc.go's COMBIN product of (n + 1 - c) / c for c = 1..k, rounded up with
+// Ceil (the arguments truncated, k at most n, 0 < k < n).
+func libCombin(n, k float64) float64 {
+	val := 1.0
+	for c := 1.0; c <= k; c++ {
+		val *= (n + 1 - c) / c
+	}
+	return math.Ceil(val)
+}
+
+// libFact is calc.go's fact: the product of 2..number.
+func libFact(n float64) float64 {
+	val := 1.0
+	for i := 2.0; i <= n; i++ {
+		val *= i
+	}
+	return val
+}
+
+// --------------------------------------------------------------------------- the exact model in Go
+
+// The decimal rounding rules in Go (big.Rat over the literals), for the hzOnly predicates
+// of the generators, which cannot ask the oracle: the verdict the oracle would give for the
+// rounding family and the exact binomials, "" (no verdict) for the other functions.
+
+func ratOf(v float64) *big.Rat {
+	r, ok := new(big.Rat).SetString(hzNumLit(v))
+	if !ok {
+		panic("ratOf: " + hzNumLit(v))
+	}
+	return r
+}
+
+func pow10Rat(e int) *big.Rat {
+	p := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(abs(e))), nil)
+	if e < 0 {
+		return new(big.Rat).SetFrac(big.NewInt(1), p)
+	}
+	return new(big.Rat).SetInt(p)
+}
+
+func abs(i int) int {
+	if i < 0 {
+		return -i
+	}
+	return i
+}
+
+// ratIntegral rounds q to an integer: towards zero, -inf, +inf, away from zero, or to the
+// nearest with halves away from zero (decimal's ROUND_DOWN, ROUND_FLOOR, ROUND_CEILING,
+// ROUND_UP, ROUND_HALF_UP).
+func ratIntegral(q *big.Rat, mode string) *big.Int {
+	num, den := q.Num(), q.Denom()
+	switch mode {
+	case "trunc":
+		return new(big.Int).Quo(num, den)
+	case "floor":
+		return new(big.Int).Div(num, den) // Euclidean: the denominator is positive
+	case "ceil":
+		return new(big.Int).Neg(ratIntegral(new(big.Rat).Neg(q), "floor"))
+	case "away":
+		if q.Sign() < 0 {
+			return ratIntegral(q, "floor")
+		}
+		return ratIntegral(q, "ceil")
+	case "half":
+		half := new(big.Rat).Add(new(big.Rat).Abs(q), big.NewRat(1, 2))
+		k := ratIntegral(half, "floor")
+		if q.Sign() < 0 {
+			k.Neg(k)
+		}
+		return k
+	}
+	panic("ratIntegral: " + mode)
+}
+
+// exactMultiple: x rounded to a multiple of s with the mode, in decimal (dmul).
+func exactMultiple(x float64, s *big.Rat, mode string) float64 {
+	if s.Sign() == 0 {
+		return 0
+	}
+	k := ratIntegral(new(big.Rat).Quo(ratOf(x), s), mode)
+	v, _ := new(big.Rat).Mul(new(big.Rat).SetInt(k), s).Float64()
+	return v
+}
+
+func exactNum(v float64) hzExpect   { return hzExpect{t: "n", num: v} }
+func exactErr(code string) hzExpect { return hzExpect{t: "e", code: code} }
+
+// goVerdict is the oracle's verdict for the rounding family and the binomials, computed in
+// Go; an empty verdict for the other functions (no shape of theirs needs it).
+func goVerdict(c mathCase) hzExpect {
+	a := c.args
+	x := a[0].num
+	switch c.name {
+	case "COTH":
+		if x == 0 {
+			return exactErr("#DIV/0!")
+		}
+		return exactNum(1 / math.Tanh(x))
+	case "ROUND", "ROUNDUP", "ROUNDDOWN", "TRUNC":
+		d := 0.0
+		if len(a) > 1 {
+			d = math.Trunc(a[1].num)
+		}
+		mode := map[string]string{"ROUND": "half", "ROUNDUP": "away", "ROUNDDOWN": "trunc", "TRUNC": "trunc"}[c.name]
+		return exactNum(exactMultiple(x, pow10Rat(-int(d)), mode))
+	case "CEILING", "FLOOR", "CEILING.MATH", "FLOOR.MATH", "CEILING.PRECISE", "FLOOR.PRECISE", "ISO.CEILING", "MROUND":
+		if len(a) == 1 {
+			if strings.HasPrefix(c.name, "FLOOR") {
+				return exactNum(math.Floor(x))
+			}
+			return exactNum(math.Ceil(x))
+		}
+		s, mode := a[1].num, 0.0
+		if len(a) > 2 {
+			mode = a[2].num
+		}
+		switch c.name {
+		case "MROUND":
+			if s == 0 {
+				return hzExpect{t: "skip"}
+			}
+			if x*s < 0 {
+				return exactErr("#NUM!")
+			}
+			return exactNum(exactMultiple(x, ratOf(s), "half"))
+		case "CEILING":
+			if x > 0 && s < 0 {
+				return exactErr("#NUM!")
+			}
+			return exactNum(exactMultiple(x, ratOf(s), "ceil"))
+		case "FLOOR":
+			if s == 0 {
+				return exactErr("#DIV/0!")
+			}
+			if x > 0 && s < 0 {
+				return exactErr("#NUM!")
+			}
+			return exactNum(exactMultiple(x, ratOf(s), "floor"))
+		case "CEILING.MATH":
+			if mode != 0 && x < 0 {
+				return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "floor"))
+			}
+			return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "ceil"))
+		case "FLOOR.MATH":
+			if mode != 0 && x < 0 {
+				return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "ceil"))
+			}
+			return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "floor"))
+		case "FLOOR.PRECISE":
+			return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "floor"))
+		}
+		return exactNum(exactMultiple(x, ratOf(math.Abs(s)), "ceil"))
+	case "COMBIN", "COMBINA":
+		n, k := math.Trunc(x), math.Trunc(a[1].num)
+		if n < 0 || k < 0 {
+			return exactErr("#NUM!")
+		}
+		if c.name == "COMBINA" {
+			if n == 0 && k == 0 {
+				return exactNum(1)
+			}
+			if n < 1 {
+				return exactErr("#NUM!")
+			}
+			if n < k {
+				return hzExpect{t: "skip"}
+			}
+			n = n + k - 1
+		} else if n < k {
+			return exactErr("#NUM!")
+		}
+		v, _ := new(big.Float).SetInt(new(big.Int).Binomial(int64(n), int64(k))).Float64()
+		return exactNum(v)
+	}
+	return hzExpect{}
+}
+
+// --------------------------------------------------------------------------- the classifier
+
+// mathShape names the recorded bug the case has the shape of ("" for none; the first name
+// wins, so the most specific condition comes first in each function), from the case and the
+// oracle's verdict, before the library is called. A shape is a condition on the arguments,
+// or, for the binary rounding (excelize/29), TRUNC's shortcut (excelize/33) and COMBIN's
+// rounding (excelize/6), the replicated arithmetic of the library disagreeing with the
+// verdict. The negative zero (excelize/34) is a check of the judge, not a shape here.
+func mathShape(c mathCase, want hzExpect) string {
+	a := c.args
+	n := len(a)
+	x := 0.0
+	if n > 0 {
+		x = a[0].num
+	}
+	off := func(v float64) bool { return want.t == "n" && !hzClose(v, want.num, 1e-12, 0) }
+	switch c.name {
+	case "SEC":
+		if x != 0 {
+			return "excelize/2" // SEC is the cosine
+		}
+	case "ODD":
+		if x > 0 && x < 1 {
+			return "excelize/7" // ODD of a unit fraction is 3
+		}
+	case "DEGREES":
+		if x == 0 {
+			return "excelize/31" // DEGREES(0) is #DIV/0!
+		}
+	case "ATAN2":
+		if x == 0 && a[1].num == 0 {
+			return "excelize/31" // ATAN2(0,0) is 0
+		}
+	case "COTH":
+		if math.Abs(x) >= 710 {
+			return "excelize/17" // the exponentials overflow to #NUM!
+		}
+		if x != 0 && off((math.Exp(x)+math.Exp(-x))/(math.Exp(x)-math.Exp(-x))) {
+			return "excelize/17" // the quotient of exponentials cancels for small x
+		}
+	case "LN", "LOG10":
+		if x == 0 {
+			return "excelize/10" // -INF
+		}
+	case "ATANH", "ACOTH":
+		if math.Abs(x) == 1 {
+			return "excelize/10" // +-INF
+		}
+	case "EXP":
+		if math.IsInf(math.Exp(x), 0) {
+			return "excelize/10"
+		}
+	case "SINH":
+		if math.IsInf(math.Sinh(x), 0) {
+			return "excelize/10"
+		}
+	case "COSH":
+		if math.IsInf(math.Cosh(x), 0) {
+			return "excelize/10"
+		}
+	case "FACT":
+		if math.Trunc(x) >= 171 {
+			return "excelize/10" // the factorial overflows to +INF
+		}
+	case "SERIESSUM":
+		sum := 0.0
+		for i, coef := range a[3].arr {
+			sum += coef * math.Pow(x, a[1].num+a[2].num*float64(i))
+		}
+		if math.IsInf(sum, 0) {
+			return "excelize/10"
+		}
+	case "MULTINOMIAL":
+		total, truncated, denominator := 0.0, 0.0, 1.0
+		for _, v := range a {
+			if v.num < 0 {
+				return "excelize/23" // a negative count is taken as it is
+			}
+			total += v.num
+			truncated += math.Trunc(v.num)
+			denominator *= libFact(v.num)
+		}
+		if math.Trunc(total) != truncated && math.Trunc(total) >= 2 {
+			return "excelize/15" // the sum is truncated after adding the fractions (0! = 1!)
+		}
+		if math.IsInf(libFact(total), 0) && !math.IsInf(denominator, 0) {
+			return "excelize/10" // the factorial of the sum overflows (both overflowing is #NUM!)
+		}
+	case "LOG":
+		if n == 2 && x <= 0 && a[1].num == 1 {
+			return "excelize/21" // the base is checked before the number: #DIV/0!, want #NUM!
+		}
+	case "GCD", "LCM":
+		for _, v := range a {
+			if v.num < 0 {
+				return "excelize/21" // #VALUE! for a negative, want #NUM!
+			}
+		}
+		if n == 1 && x != math.Trunc(x) {
+			return "excelize/15" // a single argument is returned as it is
+		}
+	case "COMBIN":
+		tn, tk := math.Trunc(x), math.Trunc(a[1].num)
+		switch {
+		case tk > tn:
+			return "excelize/21" // #VALUE! for number_chosen above number, want #NUM!
+		case tn < 0 || tk < 0:
+			return "excelize/23" // a value for a negative count
+		case tk == tn || tk == 0:
+			return ""
+		case off(libCombin(tn, tk)):
+			return "excelize/6" // the product rounds up
+		}
+	case "COMBINA":
+		tn, tk := math.Trunc(x), math.Trunc(a[1].num)
+		switch {
+		case tn < tk:
+			if want.t == "e" {
+				return "excelize/21" // #VALUE! for a negative or a number of 0, want #NUM!
+			}
+			return "" // number below number_chosen is not judged
+		case tn == 0:
+			if tk < 0 {
+				return "excelize/23" // 0 for a negative number_chosen
+			}
+			return "excelize/79" // both arguments truncate to 0: the number itself (0) comes back, want 1
+		case tk < 0:
+			return "excelize/21" // COMBIN(n+k-1, n-1) rejects n-1 > n+k-1 with #VALUE!
+		case tk == 0:
+			return ""
+		case off(libCombin(tn+tk-1, tn-1)):
+			return "excelize/6"
+		}
+	case "PERMUT":
+		k := a[1].num
+		tn, tk := math.Trunc(x), math.Trunc(k)
+		switch {
+		case x < k && (tn < 0 || tk < 0 || tn < tk):
+			return "excelize/21" // #N/A, want #NUM!
+		case x < k:
+			return "excelize/15" // number below number_chosen only before truncation
+		case tn < 0 || tk < 0:
+			return "excelize/23" // a value for a negative count
+		case math.Trunc(x-k) != tn-tk && tn-tk >= 2:
+			return "excelize/15" // the factorial of number - number_chosen is taken untruncated (0! = 1!)
+		}
+	case "PERMUTATIONA":
+		if math.Floor(x) < 0 || math.Floor(a[1].num) < 0 {
+			return "excelize/21" // #N/A for a negative, want #NUM!
+		}
+	case "BASE":
+		r := int(a[1].num)
+		switch {
+		case r < 2 || r > 36:
+			return "excelize/21" // #VALUE! for a radix out of range, want #NUM!
+		case n == 3 && a[2].num != math.Trunc(a[2].num):
+			return "excelize/15" // min_length is parsed with Atoi: a fraction is #VALUE!
+		case x < 0 || x >= 1<<53 || n == 3 && (a[2].num < 0 || a[2].num > 255):
+			return "excelize/19" // number and min_length are not checked
+		}
+	case "DECIMAL":
+		r := int(a[1].num)
+		switch {
+		case r == 0:
+			return "excelize/19" // radix 0 is accepted (ParseInt's prefix detection)
+		case r < 2 || r > 36:
+			return "excelize/21" // #VALUE! for a radix out of range, want #NUM!
+		}
+		// excelize/82 before excelize/21: a text of three or more characters beginning with 0x
+		// or 0X loses the prefix before parsing, so where the rest is all digits of the radix
+		// the library returns the rest's value: below radix 34 the X is no digit and #NUM! is
+		// due (the X would make it excelize/21's #VALUE! only if the rest had a digit at or
+		// above the radix too, which is then the shape named); from radix 34 on the text is a
+		// number with 0 and X as its two leading digits. "0x" alone is not stripped: #VALUE!
+		// (excelize/21) below 34, the digit X from 34 on.
+		t := strings.ToUpper(a[0].s)
+		if len(t) > 2 && strings.HasPrefix(t, "0X") && !digitsAtOrAbove(t[2:], r) {
+			return "excelize/82"
+		}
+		if digitsAtOrAbove(t, r) {
+			return "excelize/21" // #VALUE! for a digit at or above the radix, want #NUM!
+		}
+	case "ROMAN":
+		tn := math.Trunc(x)
+		if tn < 0 || tn > 3999 {
+			return "excelize/18" // numbers out of range are accepted
+		}
+		if n == 2 {
+			f := a[1]
+			switch {
+			case f.kind == 'b' && f.b && romanForm1Differs(tn):
+				return "excelize/18" // TRUE is read as the concise form 1
+			case f.kind == 'n' && (f.num < 0 || f.num > 4):
+				return "excelize/18" // forms out of range are clamped
+			}
+		}
+	case "CEILING":
+		s := a[1].num
+		switch {
+		case s < 0 && x > 0:
+			return "excelize/21" // #VALUE!, want #NUM!
+		case s == 0:
+			return "excelize/9" // #NUM! for significance 0, want 0
+		}
+		if v, ok := libMultiple(c.name, x, s, 0); ok && off(v) {
+			return "excelize/29" // the binary quotient misses the exact multiple
+		}
+	case "FLOOR":
+		s := a[1].num
+		switch {
+		case s == 0:
+			return "excelize/21" // #NUM! for significance 0, want #DIV/0!
+		case s < 0 && x == 0:
+			return "excelize/9" // #NUM! for a number of 0 with a negative significance, want 0
+		}
+		if v, ok := libMultiple(c.name, x, s, 0); ok && off(v) {
+			return "excelize/29"
+		}
+	case "CEILING.MATH", "FLOOR.MATH":
+		if n == 1 {
+			return ""
+		}
+		s, mode := a[1].num, 1.0
+		if n == 3 {
+			mode = a[2].num
+		}
+		if s == 0 {
+			return "excelize/9" // #NUM! for significance 0, want 0
+		}
+		// The direction is wrong where the quotient is not an integer: CEILING.MATH reads
+		// `number > 0 → up, else mode < 0 → down` and FLOOR.MATH `number < 0 && mode > 0 →
+		// down` on the quotient by the signed significance, where Excel takes any nonzero
+		// mode as "towards zero" for a negative number and ignores the sign of significance.
+		fractional := !new(big.Rat).Quo(ratOf(x), ratOf(s)).IsInt()
+		if c.name == "CEILING.MATH" && fractional && (x > 0 && s < 0 || x < 0 && n == 3 && (s > 0 && mode > 0 || s < 0 && mode != 0)) {
+			return "excelize/9"
+		}
+		if c.name == "FLOOR.MATH" && fractional && x < 0 && (s > 0 && n == 3 && mode >= 0 || s < 0 && (n == 2 || mode >= 0)) {
+			return "excelize/9"
+		}
+		if v, ok := libMultiple(c.name, x, s, mode); ok && off(v) {
+			return "excelize/29"
+		}
+	case "CEILING.PRECISE", "FLOOR.PRECISE", "ISO.CEILING":
+		if n == 1 {
+			return ""
+		}
+		if v, ok := libMultiple(c.name, x, a[1].num, 0); ok && off(v) {
+			return "excelize/29"
+		}
+	case "MROUND":
+		if v, ok := libMultiple(c.name, x, a[1].num, 0); ok && off(v) {
+			return "excelize/29" // a decimal half rounds the wrong way
+		}
+	case "ROUND", "ROUNDUP", "ROUNDDOWN":
+		d := a[1].num
+		if d != math.Trunc(d) {
+			return "excelize/8" // a fractional num_digits is used as the power of ten
+		}
+		if off(libRound(c.name, x, d)) {
+			return "excelize/29" // the binary quotient by 10^-digits is truncated one unit low
+		}
+	case "TRUNC":
+		d := 0.0
+		if n > 1 {
+			d = a[1].num
+		}
+		// excelize/80 before excelize/29 (libTrunc floors the digits as the library does, so
+		// its result is off the verdict here too): a negative fractional num_digits is floored
+		// to one place further left instead of truncated, which changes the result exactly
+		// when the decimal digit of |x| at 10^-trunc(d) is not 0 (TRUNC(685,-1.5) = 600, want
+		// 680; TRUNC(605,-1.5) and TRUNC(5,-1.5) are right either way).
+		if d < 0 && d != math.Trunc(d) && truncTo(x, math.Floor(d)) != truncTo(x, math.Trunc(d)) {
+			return "excelize/80"
+		}
+		v, shortcut := libTrunc(x, d)
+		// excelize/81 before excelize/29 (the overflow leaves libTrunc's result off too) and
+		// apart from excelize/33 (where the shortcut fires the library returns x, which is right
+		// at these magnitudes: x has fewer decimals than digits): with floor(d) >= 1 and the
+		// float64 product x 10^floor(d) at or above 2^63 or below -2^63, int() yields the
+		// integer indefinite -2^63 on amd64 (exactly -2^63 converts exactly and the result is
+		// x), so the result is -2^63 / 10^floor(d): TRUNC(123456.789,15) = -9223.37203685478.
+		if !shortcut && overflowsInt64(x*math.Pow(10, math.Floor(d))) {
+			return "excelize/81"
+		}
+		if shortcut && off(x) {
+			return "excelize/33" // the shortcut returns the number itself
+		}
+		if off(v) {
+			return "excelize/29"
+		}
+	}
+	return ""
+}
+
+// digitsAtOrAbove: the (upper-case) text has a digit of base 36 at or above the radix.
+func digitsAtOrAbove(t string, radix int) bool {
+	for _, ch := range t {
+		if strings.IndexRune(hzDigits36, ch) >= radix {
+			return true
+		}
+	}
+	return false
+}
+
+// truncTo: x truncated to d decimal places (d negative for places left of the point), in
+// decimal (the oracle's TRUNC for an integral d).
+func truncTo(x, d float64) float64 { return exactMultiple(x, pow10Rat(-int(d)), "trunc") }
+
+// overflowsInt64: int(v) is not representable (2^63 itself is not; -2^63 is).
+func overflowsInt64(v float64) bool { return v >= 1<<63 || v < -(1<<63) }
+
+// --------------------------------------------------------------------------- the judge
+
+// mathTolerance: the tolerances of the comparison (model facts, see the file comment).
+func mathTolerance(c mathCase) (rtol, atol float64) {
+	switch c.name {
+	case "ACOT":
+		return 1e-9, 0
+	case "SUM", "AVERAGE":
+		return 1e-12, 1e-12 * hzScale(c.args)
+	case "SUMSQ":
+		return 1e-12, 1e-12 * hzScale(c.args) * hzScale(c.args)
+	}
+	return 1e-12, 0
+}
+
+// hzScale: the largest magnitude among the arguments.
+func hzScale(args []hzArg) float64 {
+	s := 0.0
+	for _, a := range args {
+		s = math.Max(s, math.Abs(a.num))
+		for _, v := range a.arr {
+			s = math.Max(s, math.Abs(v))
+		}
+	}
+	return s
+}
+
+// judgeMath judges one case: the formula against the oracle's verdict (the shape named first),
+// the sign of a zero result (a "-0" is excelize/34: Excel has no negative zero; under
+// HEGEL_NO_KNOWN=1 that check is dropped and counted), and the round trip of ROMAN and BASE.
+func judgeMath(j *hzCaseJudge, o *hzOracle, c mathCase) {
+	formula, cells := hzFormula(c.name, c.args)
+	want, err := o.eval(c.name, c.args)
+	if err != nil {
+		j.ht.Fatalf("%s: oracle: %v", formula, err)
+	}
+	j.Shape(mathShape(c, want))
+	rtol, atol := mathTolerance(c)
+	desc := hzDesc(formula, cells)
+	got := hzCalc(formula, cells)
+	if hzJudgeCase(j, c.name, desc, got, want, rtol, atol) && want.t == "n" && want.num == 0 && got.raw == "-0" {
+		if hzNoKnown {
+			hzCount("known excelize/34")
+		} else {
+			hzCount("shape excelize/34")
+			j.shape = "excelize/34" // the mismatch is the sign, whatever shape the arguments had
+			j.Fail(c.name+" sign", "%s = %v, want 0", desc, got)
+		}
+	}
+	if t := c.tripFormula(); t != "" {
+		got := hzCalc(t, nil)
+		if c.name == "ROMAN" {
+			// ARABIC(ROMAN(n, form)) = n for every form
+			hzJudgeCase(j, "ARABIC", t, got, hzExpect{t: "n", num: c.trip[0]}, 0, 0)
+		} else {
+			// DECIMAL(BASE(n, radix), radix) = n, to 15 significant digits
+			hzJudgeCase(j, "DECIMAL", t, got, hzExpect{t: "n", num: c.trip[0]}, 1e-14, 0)
+		}
+	}
+}
+
+func TestHegelMath(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mathCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMath(j, o, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- kept for Stat and Dist
+
+// The old argument kinds, used by TestHegelStat and TestHegelDist until their rewrite
+// (parts 2 to 4 of the batch); the Math property draws from the generators above.
+
+var hzDigits36 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+// hzGenArg draws an argument of the given kind.
+func hzGenArg(tc hegel.TestCase, kind string) hzArg {
+	switch kind {
+	case "x":
+		return hzN(hzGenNum(tc))
+	case "pos":
+		return hzN(hzGenPos(tc))
+	case "unit":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1, -1, 1.5, -2, 1.0000001}))
+		}
+		return hzN(float64(hzDrawInt(tc, -1000, 1000)) / 1000)
+	case "angle":
+		return hzN(float64(hzDrawInt(tc, -20000, 20000)) / 1000)
+	case "int":
+		return hzN(float64(hzDrawInt(tc, -50, 50)))
+	case "nat":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, 2.5, 0.5, -2}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 30)))
+	case "nat200":
+		if hzChance(tc, 15) {
+			return hzN(float64(hzDrawInt(tc, 160, 200)))
+		}
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, -2, 2.5, 170.9, 0.5}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 40)))
+	case "nat53":
+		switch hzDrawInt(tc, 0, 5) {
+		case 0:
+			return hzN(hzPick(tc, []float64{0, 1, 4294967295, 4294967296, 9007199254740991, 9007199254740992, -1, 2.5}))
+		case 1:
+			return hzN(float64(hzDrawInt(tc, 1, 1<<30)) * float64(hzDrawInt(tc, 1, 1<<22)))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 100000)))
+	case "digits":
+		if hzChance(tc, 25) {
+			return hzN(float64(hzDrawInt(tc, -6, -1)))
+		}
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1.5, -1.5, 2.9, 15}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 8)))
+	case "sig":
+		return hzN(hzPick(tc, []float64{1, 2, 5, 10, 100, 1000, 0.5, 0.25, 0.1, 0.01, 0.001, 0.2, 3, 7, -1, -2, -0.5, -0.1, 0}))
+	case "mode":
+		return hzN(hzPick(tc, []float64{0, 1, -1, 2, 0.5, -3}))
+	case "radix":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1, 37, 0, -2, 2.5, 16.9}))
+		}
+		return hzN(float64(hzDrawInt(tc, 2, 36)))
+	case "minlen":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, 256, 2.7}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 20)))
+	case "roman":
+		if hzChance(tc, 5) {
+			return hzN(hzPick(tc, []float64{4000, -1, 3999.9, 0}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 3999)))
+	case "form":
+		if hzChance(tc, 15) {
+			return hzB(hzGenBool(tc))
+		}
+		if hzChance(tc, 5) {
+			return hzN(hzPick(tc, []float64{5, -1, 2.5}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 4)))
+	case "text36":
