+package hegel
+
+// TestHegelMath: the mathematical and trigonometric functions on literal arguments agree with
+// their definitions (Python math, with Excel's decimal rounding rules for the rounding family),
+// and ARABIC(ROMAN(n, form)) and DECIMAL(BASE(n, radix), radix) round-trip.
+//
+// A case is one of the 70 functions with its arguments (mathCase), drawn from mathCases: the
+// function is sampled from the table mathSpecs and its arguments from the kind generators
+// (numbers, positives, units, ... as the old profiles, now weighted alternatives, simplest
+// first). The shapes of the recorded bugs are drawn like any other case: as alternatives of
+// weight zero under HEGEL_NO_KNOWN=1 (hzUnless), or as relations between the arguments that
+// are then filtered out (hzOnly) or built past (ROUNDDOWN's digits). The classifier mathShape
+// names the bug a case has the shape of, from the case and the oracle's verdict, before the
+// library is called; a mismatch then fails "(the shape of excelize/N)". The same judge
+// (judgeMath) serves the narrow properties of hegel_zoo_math_shapes_test.go.
+//
+// The shapes drawn here: excelize/2 (SEC), 6 (COMBIN's rounding), 7 (ODD), 8 (a fractional
+// num_digits), 9 (CEILING.MATH and FLOOR.MATH), 10 (infinite results), 15 (no truncation),
+// 17 (COTH), 18 (ROMAN), 19 (BASE and DECIMAL's checks), 21 (error codes), 23 (negative
+// counts), 29 (binary rounding), 31 (zero arguments), 33 (TRUNC's shortcut), 34 (a negative
+// zero), and the four the rewrite found, recorded as excelize/79 (COMBINA(0,0)), 80 (TRUNC
+// floors a negative fractional num_digits), 81 (TRUNC overflows int64) and 82 (DECIMAL strips
+// a 0x prefix).
+//
+// Model facts that are not gates: ACOT is judged to 1e-9 (pi/2 - atan(x) cancels for large x,
+// and the oracle skips |x| > 1e5); SUM, AVERAGE and SUMSQ to an absolute 1e-12 of the largest
+// term (binary sums cancel); the oracle does not judge COMBINA with number < number_chosen,
+// MROUND with multiple 0, SECH and CSCH beyond 700, ROMAN with a non-classic form.
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- kinds
+
+func floats(g hegel.Generator[int]) hegel.Generator[float64] {
+	return hegel.Map(g, func(i int) float64 { return float64(i) })
+}
+
+// overTens: a value of g divided by 10^e, e in [lo, hi].
+func overTens(g hegel.Generator[int], lo, hi int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		e := hegel.Draw(tc, hzInts(lo, hi))
+		return float64(v) / math.Pow(10, float64(e))
+	})
+}
+
+// timesTens: a value of g times 10^e, e in [lo, hi].
+func timesTens(g hegel.Generator[int], lo, hi int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		e := hegel.Draw(tc, hzInts(lo, hi))
+		return float64(v) * math.Pow(10, float64(e))
+	})
+}
+
+// signed: negative pct percent of the time (never a negative zero: the oracle has none).
+func signed(g hegel.Generator[float64], pct int) hegel.Generator[float64] {
+	return hegel.Composite(func(tc hegel.TestCase) float64 {
+		v := hegel.Draw(tc, g)
+		if hegel.Draw(tc, hzCoin(pct)) {
+			v = -v
+		}
+		if v == 0 {
+			v = 0
+		}
+		return v
+	})
+}
+
+func num(g hegel.Generator[float64]) hegel.Generator[hzArg] { return hegel.Map(g, hzN) }
+
+var (
+	// magnitudes: the profiles of a number (hzGenNum), simplest first: small integers,
+	// integers to 1000, decimals of one to three places, quarters, decimals starting with
+	// zeros, large and small magnitudes.
+	magnitudes = hzWeighted(
+		hzW(1, floats(hzInts(0, 10))),
+		hzW(3, floats(hzInts(0, 1000))),
+		hzW(3, overTens(hzInts(0, 100000), 1, 3)),
+		hzW(1, hegel.Map(hzInts(0, 20), func(i int) float64 { return float64(i) / 4 })),
+		hzW(1, hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hzInts(0, 100))) + hegel.Draw(tc, overTens(hzInts(1, 99), 2, 6))
+		})),
+		hzW(1, timesTens(hzInts(1, 999), 3, 12)),
+		hzW(1, overTens(hzInts(1, 999), 3, 9)),
