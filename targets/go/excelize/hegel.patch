+
+// statCases: a function of the table with its arguments and checks.
+var statCases = hegel.FlatMap(hegel.SampledFrom(statSpecs), func(s statSpec) hegel.Generator[statCase] {
+	return statCasesOf(s.name, s.args)
+})
+
+// --------------------------------------------------------------------------- the library's arithmetic
+
+// The arithmetic of the library's statistics, replicated so that the classifier can tell
+// before the call whether the one-pass variance loses digits (excelize/22), whether a
+// zero-variance check compares rounding noise with 0 (excelize/24), what SKEW.P's 0/0 becomes
+// (excelize/10, 21), which index PERCENTILE.EXC reaches (excelize/1), what AVEDEV and
+// PERCENTRANK compute (excelize/4, 20), and whether a product overflows (excelize/10, 83).
+// Each replica returns the value and the error code it would produce ("" for a value; "+INF"
+// and "-INF" for an infinity, the text the library shows). Validated against the library on
+// 1500 random ranges each (every outcome equal, values to 1e-13).
+
+func libMean(xs []float64) float64 {
+	s := 0.0
+	for _, v := range xs {
+		s += v
+	}
+	return s / float64(len(xs))
+}
+
+// libCode: the library's outcome for a float64: #NUM! for NaN, the text for an infinity.
+func libCode(r float64) (float64, string) {
+	switch {
+	case math.IsNaN(r):
+		return 0, "#NUM!"
+	case math.IsInf(r, 1):
+		return r, "+INF"
+	case math.IsInf(r, -1):
+		return r, "-INF"
+	}
+	return r, ""
+}
+
+// libVars is calc.go's vars(): the one-pass (n sum x^2 - (sum x)^2) / (n (n - d)); #DIV/0!
+// below d + 1 values.
+func libVars(name string, xs []float64) (float64, string) {
+	var sumA, sumB float64
+	for _, v := range xs {
+		sumA += v * v
+		sumB += v
+	}
+	count, minimum := float64(len(xs)), 0.0
+	if name == "VAR" || name == "VAR.S" || name == "VARA" {
+		minimum = 1
+	}
+	if count > minimum {
+		return (sumA*count - sumB*sumB) / (count * (count - minimum)), ""
+	}
+	return 0, "#DIV/0!"
+}
+
+// libStdev is calc.go's stdev() (STDEV, STDEV.S, STDEVA and the sd of SKEW, KURT and
+// CORREL): the two-pass sample standard deviation, #DIV/0! for one value.
+func libStdev(xs []float64) (float64, string) {
+	if len(xs) < 2 {
+		return 0, "#DIV/0!"
+	}
+	mean, ss := libMean(xs), 0.0
+	for _, v := range xs {
+		ss += math.Pow(v-mean, 2)
+	}
+	return math.Sqrt(ss / float64(len(xs)-1)), ""
+}
+
+// libStdevp is calc.go's stdevp() (STDEVP, STDEV.P, STDEVPA): the square root of the one-pass
+// population variance, #NUM! where that is negative.
+func libStdevp(xs []float64) (float64, string) {
+	v, code := libVars("VARP", xs)
+	if code != "" {
+		return 0, code
+	}
+	return libCode(math.Sqrt(v))
+}
+
+// libSkew is calc.go's skew(): the third moment over the standard deviation (the two-pass
+// one for SKEW, the one-pass population one for SKEW.P, taken as 0 where it is #NUM!), so a
+// constant range is 0/0: NaN (#NUM!) where the deviations are exactly 0, an infinity where
+// the variance is exactly 0 but the mean inexact, and rounding noise otherwise.
+func libSkew(name string, xs []float64) (float64, string) {
+	if len(xs) < 3 {
+		return 0, "#DIV/0!"
+	}
+	mean := libMean(xs)
+	var sd float64
+	if name == "SKEW" {
+		sd, _ = libStdev(xs)
+	} else {
+		sd, _ = libStdevp(xs)
+	}
+	summer, count := 0.0, float64(len(xs))
+	for _, v := range xs {
+		summer += math.Pow((v-mean)/sd, 3)
+	}
+	if name == "SKEW" {
+		return libCode(summer * (count / ((count - 1) * (count - 2))))
+	}
+	return libCode(summer / count)
+}
+
+// libKurt is calc.go's KURT: #DIV/0! where the two-pass sd is not positive or below four
+// values, the sample excess kurtosis otherwise.
+func libKurt(xs []float64) (float64, string) {
+	sd, _ := libStdev(xs)
+	count := float64(len(xs))
+	if sd <= 0 || count <= 3 {
+		return 0, "#DIV/0!"
+	}
+	mean, summer := libMean(xs), 0.0
+	for _, v := range xs {
+		summer += math.Pow((v-mean)/sd, 4)
+	}
+	return libCode(summer*(count*(count+1)/((count-1)*(count-2)*(count-3))) - (3 * math.Pow(count-1, 2) / ((count - 2) * (count - 3))))
+}
+
+// libCov is calc.go's pearsonProduct's covariance sum (the two-pass sum of the products of
+// the deviations), with the sums of squared deviations.
+func libCov(a1, a2 []float64) (sum, deltaX, deltaY float64) {
+	x, y := libMean(a1), libMean(a2)
+	for i := range a1 {
+		sum += (a1[i] - x) * (a2[i] - y)
+		deltaX += (a1[i] - x) * (a1[i] - x)
+		deltaY += (a2[i] - y) * (a2[i] - y)
+	}
+	return sum, deltaX, deltaY
+}
+
+// libPearson is calc.go's pearsonProduct (SLOPE, INTERCEPT, FORECAST, FORECAST.LINEAR,
+// PEARSON, RSQ): ys and xs are known_y's and known_x's (PEARSON and RSQ take their first range
+// as the x); #DIV/0! where the product of the covariance and the two sums of squares is 0.
+func libPearson(name string, ys, xs []float64, fx float64) (float64, string) {
+	a1, a2 := xs, ys
+	if name == "PEARSON" || name == "RSQ" {
+		a1, a2 = ys, xs
+	}
+	if len(a1) != len(a2) {
+		return 0, "#N/A"
+	}
+	sum, deltaX, deltaY := libCov(a1, a2)
+	if sum*deltaX*deltaY == 0 {
+		return 0, "#DIV/0!"
+	}
+	x, y := libMean(a1), libMean(a2)
+	switch name {
+	case "FORECAST", "FORECAST.LINEAR":
+		return libCode(y + sum/deltaX*(fx-x))
+	case "INTERCEPT":
+		return libCode(y - sum/deltaX*x)
+	case "PEARSON":
+		return libCode(sum / math.Sqrt(deltaX*deltaY))
+	case "RSQ":
+		return libCode(math.Pow(sum/math.Sqrt(deltaX*deltaY), 2))
+	}
+	return libCode(sum / deltaX)
+}
+
+// libSteyx is calc.go's STEYX: the one-pass sums of squares and products.
+func libSteyx(ys, xs []float64) (float64, string) {
+	if len(xs) != len(ys) {
+		return 0, "#N/A"
+	}
+	var count, sumX, sumY, squareX, squareY, sigmaXY float64
+	for i := range xs {
+		sumX += xs[i]
+		sumY += ys[i]
+		squareX += xs[i] * xs[i]
+		squareY += ys[i] * ys[i]
+		sigmaXY += xs[i] * ys[i]
+		count++
+	}
+	if count < 3 {
+		return 0, "#DIV/0!"
+	}
+	dx, dy := sumX/count, sumY/count
+	sigma1 := squareY - 2*dy*sumY + count*dy*dy
+	sigma2 := sigmaXY - dy*sumX - sumY*dx + count*dy*dx
+	sigma3 := squareX - 2*dx*sumX + count*dx*dx
+	return libCode(math.Sqrt((sigma1 - (sigma2*sigma2)/sigma3) / (count - 2)))
+}
+
+// libTTest is the outcome of calc.go's tTest before the t distribution: the statistic with
+// "", or "#N/A", "#NUM!", "#DIV/0!", "inf" (an infinite statistic: the probability 0) or
+// "nan" (#NUM!).
+func libTTest(xs, ys []float64, typ float64) (float64, string) {
+	stat := func(t float64) (float64, string) {
+		switch {
+		case math.IsNaN(t):
+			return 0, "nan"
+		case math.IsInf(t, 0):
+			return t, "inf"
+		}
+		return t, ""
+	}
+	if typ == 1 {
+		if len(xs) != len(ys) {
+			return 0, "#N/A"
+		}
+		var cnt, sum1, sum2, sumSqrD float64
+		for i := range xs {
+			sum1 += xs[i]
+			sum2 += ys[i]
+			sumSqrD += (xs[i] - ys[i]) * (xs[i] - ys[i])
+			cnt++
+		}
+		sumD := sum1 - sum2
+		divider := cnt*sumSqrD - sumD*sumD
+		if divider == 0 {
+			return 0, "#DIV/0!"
+		}
+		return stat(math.Abs(sumD) * math.Sqrt((cnt-1)/divider))
+	}
+	var cnt1, cnt2, sum1, sumSqr1, sum2, sumSqr2 float64
+	for _, v := range xs {
+		sum1 += v
+		sumSqr1 += v * v
+		cnt1++
+	}
+	for _, v := range ys {
+		sum2 += v
+		sumSqr2 += v * v
+		cnt2++
+	}
+	if cnt1 < 2 || cnt2 < 2 {
+		return 0, "#NUM!"
+	}
+	if typ == 3 {
+		fS1 := (sumSqr1 - sum1*sum1/cnt1) / (cnt1 - 1) / cnt1
+		fS2 := (sumSqr2 - sum2*sum2/cnt2) / (cnt2 - 1) / cnt2
+		if fS1+fS2 == 0 {
+			return 0, "#NUM!"
+		}
+		return stat(math.Abs(sum1/cnt1-sum2/cnt2) / math.Sqrt(fS1+fS2))
+	}
+	fS1 := (sumSqr1 - sum1*sum1/cnt1) / (cnt1 - 1)
+	fS2 := (sumSqr2 - sum2*sum2/cnt2) / (cnt2 - 1)
+	return stat(math.Abs(sum1/cnt1-sum2/cnt2) / math.Sqrt((cnt1-1)*fS1+(cnt2-1)*fS2) * math.Sqrt(cnt1*cnt2*(cnt1+cnt2-2)/(cnt1+cnt2)))
+}
+
+// libCorrel is calc.go's CORREL: the pairs with a 0 dropped, the two-pass sd of the kept
+// values, the sum of the products of the deviations over (n - dropped - 1).
+func libCorrel(xs, ys []float64) (float64, string) {
+	if len(xs) != len(ys) {
+		return 0, "#N/A"
+	}
+	var l1, l2 []float64
+	for i := range xs {
+		if xs[i] != 0 && ys[i] != 0 {
+			l1 = append(l1, xs[i])
+			l2 = append(l2, ys[i])
+		}
+	}
+	sd1, _ := libStdev(l1)
+	sd2, _ := libStdev(l2)
+	if sd1 == 0 || sd2 == 0 {
+		return 0, "#DIV/0!"
+	}
+	m1, m2 := libMean(l1), libMean(l2)
+	sum := 0.0
+	for i := range l1 {
+		sum += (l1[i] - m1) * (l2[i] - m2)
+	}
+	return libCode(sum / float64(len(l1)-1) / sd1 / sd2)
+}
+
+// libAvedev is calc.go's AVEDEV: the mean over every value, then one term per argument (a
+// range counts as its first value).
+func libAvedev(args []hzArg) float64 {
+	mean, result := libMean(valuesOf(args)), 0.0
+	for _, a := range args {
+		v := a.num
+		if a.kind == 'a' {
+			v = a.arr[0]
+		}
+		result += math.Abs(v - mean)
+	}
+	return result / float64(len(args))
+}
+
+// libProduct is calc.go's PRODUCT: the plain product, in order.
+func libProduct(xs []float64) float64 {
+	product := 1.0
+	for _, v := range xs {
+		product *= v
+	}
+	return product
+}
+
+// libFisherInv is calc.go's FISHERINV: (e^2y - 1) / (e^2y + 1), NaN once the exponential
+// overflows.
+func libFisherInv(y float64) float64 { return (math.Exp(2*y) - 1) / (math.Exp(2*y) + 1) }
+
+// libPercentrank is calc.go's percentrank: the rank floored to significance decimal places.
+func libPercentrank(name string, xs []float64, x, sig float64) (float64, string) {
+	numbers := append([]float64(nil), xs...)
+	sort.Float64s(numbers)
+	cnt := len(numbers)
+	if x < numbers[0] || x > numbers[cnt-1] {
+		return 0, "#N/A"
+	}
+	pos := -1.0
+	for i, v := range numbers {
+		if v == x {
+			pos = float64(i)
+			break
+		}
+	}
+	if sig < 1 {
+		return 0, "#NUM!"
+	}
+	if pos == -1 {
+		pos = 0
+		cmp := numbers[0]
+		for cmp < x {
+			pos++
+			cmp = numbers[int(pos)]
+		}
+		pos--
+		pos += (x - numbers[int(pos)]) / (cmp - numbers[int(pos)])
+	}
+	pow := math.Pow(10, sig)
+	digit := pow * pos / (float64(cnt) - 1)
+	if name == "PERCENTRANK.EXC" {
+		digit = pow * (pos + 1) / (float64(cnt) + 1)
+	}
+	return libCode(math.Floor(digit) / pow)
+}
+
+// libPercentileExc is calc.go's PERCENTILE.EXC: the sorted range at floor(k(n+1)) - 1 and
+// floor(k(n+1)); panics where either index leaves the range.
+func libPercentileExc(xs []float64, k float64) (v float64, code string, panics bool) {
+	if k <= 0 || k >= 1 {
+		return 0, "#NUM!", false
+	}
+	numbers := append([]float64(nil), xs...)
+	sort.Float64s(numbers)
+	cnt := len(numbers)
+	idx := k * (float64(cnt) + 1)
+	base := math.Floor(idx)
+	next := base - 1
+	if next < 0 || int(base) >= cnt {
+		return 0, "", true
+	}
+	return numbers[int(next)] + (numbers[int(base)]-numbers[int(next)])*(idx-base), "", false
+}
+
+// libPercentile is calc.go's PERCENTILE and PERCENTILE.INC (and QUARTILE's quart / 4 as it
+// is): #N/A outside [0, 1], the linear interpolation at k(n - 1).
+func libPercentile(xs []float64, k float64) (float64, string) {
+	if k < 0 || k > 1 {
+		return 0, "#N/A"
+	}
+	numbers := append([]float64(nil), xs...)
+	sort.Float64s(numbers)
+	idx := k * float64(len(numbers)-1)
+	base := math.Floor(idx)
+	if idx == base {
+		return numbers[int(idx)], ""
+	}
+	return numbers[int(base)] + (numbers[int(base)+1]-numbers[int(base)])*(idx-base), ""
+}
+
+// --------------------------------------------------------------------------- the models in Go
+
+// The verdicts the oracle would give, in Go, for the statOnly predicates of the generators,
+// which cannot ask the oracle: the two-pass moments, the centred regression, the oracle's
+// PERCENTRANK (significant digits, decimal, truncated) and percentiles; for the tests whose
+// probability needs SciPy only the kind of the verdict (an error, or some number: NaN, which
+// no replica agrees with and no classifier compares), and "" (no verdict) for the rest.
+
+func valuesOf(args []hzArg) []float64 {
+	var all []float64
+	for _, a := range args {
+		if a.kind == 'a' {
+			all = append(all, a.arr...)
+		} else {
+			all = append(all, a.num)
+		}
+	}
+	return all
+}
+
+// constant: every value equal (the oracle's const; one value is constant).
+func constant(xs []float64) bool {
+	for _, v := range xs {
+		if v != xs[0] {
+			return false
+		}
+	}
+	return len(xs) > 0
+}
+
+func hasZero(xs []float64) bool {
+	for _, v := range xs {
+		if v == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// moments: the central moments 2..4 of xs, over n.
+func moments(xs []float64) (m2, m3, m4 float64) {
+	mean := libMean(xs)
+	for _, v := range xs {
+		d := v - mean
+		m2 += d * d
+		m3 += d * d * d
+		m4 += d * d * d * d
+	}
+	n := float64(len(xs))
+	return m2 / n, m3 / n, m4 / n
+}
+
+func goVariance(xs []float64, ddof int) float64 {
+	m2, _, _ := moments(xs)
+	n := float64(len(xs))
+	return m2 * n / (n - float64(ddof))
+}
+
+// goSkew: SciPy's skew with bias False (SKEW) or True (SKEW.P).
+func goSkew(name string, xs []float64) float64 {
+	m2, m3, _ := moments(xs)
+	g1 := m3 / math.Pow(m2, 1.5)
+	if name == "SKEW.P" {
+		return g1
+	}
+	n := float64(len(xs))
+	return g1 * math.Sqrt(n*(n-1)) / (n - 2)
+}
+
+// goKurt: SciPy's kurtosis with bias False (the sample excess kurtosis).
+func goKurt(xs []float64) float64 {
+	m2, _, m4 := moments(xs)
+	n := float64(len(xs))
+	g2 := m4/(m2*m2) - 3
+	return (n - 1) / ((n - 2) * (n - 3)) * ((n+1)*g2 + 6)
+}
+
+// goPercentile: NumPy's linear (INC) and weibull (EXC) percentile at k, the sorted range
+// interpolated at k(n - 1) or k(n + 1) - 1.
+func goPercentile(xs []float64, k float64, exc bool) float64 {
+	s := append([]float64(nil), xs...)
+	sort.Float64s(s)
+	n := len(s)
+	idx := k * float64(n-1)
+	if exc {
+		idx = k*float64(n+1) - 1
+	}
+	lo := int(math.Floor(idx))
+	if lo < 0 {
+		return s[0]
+	}
+	if lo >= n-1 {
+		return s[n-1]
+	}
+	return s[lo] + (s[lo+1]-s[lo])*(idx-float64(lo))
+}
+
+// exactRank: the oracle's prank: the rank of x in xs, exact over the literals (big.Rat, as
+// the oracle's Fraction: a float rank a hair below a decimal boundary would truncate one
+// digit low); the verdict instead of a rank for one value (skip) or x outside (#N/A).
+func exactRank(name string, xs []float64, x float64) (*big.Rat, hzExpect) {
+	s := make([]*big.Rat, len(xs))
+	for i, v := range xs {
+		s[i] = ratOf(v)
+	}
+	sort.Slice(s, func(i, j int) bool { return s[i].Cmp(s[j]) < 0 })
+	n := len(s)
+	if n == 1 {
+		return nil, hzExpect{t: "skip"}
+	}
+	xr := ratOf(x)
+	if xr.Cmp(s[0]) < 0 || xr.Cmp(s[n-1]) > 0 {
+		return nil, exactErr("#N/A")
+	}
+	var r *big.Rat
+	for i, v := range s {
+		if v.Cmp(xr) == 0 {
+			r = big.NewRat(int64(i), 1)
+			break
+		}
+	}
+	if r == nil {
+		j := 0
+		for i := 0; i < n; i++ {
+			if s[i].Cmp(xr) < 0 {
+				j = i
+			}
+		}
+		r = new(big.Rat).Add(big.NewRat(int64(j), 1), new(big.Rat).Quo(new(big.Rat).Sub(xr, s[j]), new(big.Rat).Sub(s[j+1], s[j])))
+	}
+	if name == "PERCENTRANK.EXC" {
+		return new(big.Rat).Quo(new(big.Rat).Add(r, big.NewRat(1, 1)), big.NewRat(int64(n+1), 1)), hzExpect{}
+	}
+	return new(big.Rat).Quo(r, big.NewRat(int64(n-1), 1)), hzExpect{}
+}
+
+// rankUnits: the exact rank in units of its sig-th significant digit (0 for a rank of 0).
+func rankUnits(r *big.Rat, sig float64) *big.Rat {
+	if r.Sign() == 0 {
+		return r
+	}
+	return new(big.Rat).Quo(r, pow10Rat(decimalExponent(r)-int(sig)+1))
+}
+
+// goPercentrank: the oracle's sigtrunc over exactRank: the rank truncated to sig
+// significant digits in decimal; a rank within 1e-9 of a digit boundary is a knife-edge no
+// float computation settles and is not judged (skip).
+func goPercentrank(name string, xs []float64, x, sig float64) hzExpect {
+	r, verdict := exactRank(name, xs, x)
+	if r == nil {
+		return verdict
+	}
+	sig = math.Trunc(sig)
+	if sig < 1 {
+		return exactErr("#NUM!")
+	}
+	if r.Sign() == 0 {
+		return exactNum(0)
+	}
+	q := decimalExponent(r) - int(sig) + 1
+	units := rankUnits(r, sig)
+	k := ratIntegral(units, "trunc")
+	frac, _ := new(big.Rat).Sub(units, new(big.Rat).SetInt(k)).Float64()
+	if frac != 0 && (frac < 1e-9 || frac > 1-1e-9) {
+		return hzExpect{t: "skip"}
+	}
+	v, _ := new(big.Rat).Mul(new(big.Rat).SetInt(k), pow10Rat(q)).Float64()
+	return exactNum(v)
+}
+
+// onDigitBoundary: the exact rank is a decimal of sig significant digits (the library's
+// binary floor of 10^sig rank can then land one unit low).
+func onDigitBoundary(name string, xs []float64, x, sig float64) bool {
+	r, _ := exactRank(name, xs, x)
+	return r != nil && r.Sign() != 0 && rankUnits(r, math.Trunc(sig)).IsInt()
+}
+
+// decimalExponent: the e with 10^e <= r < 10^(e+1), for a positive r.
+func decimalExponent(r *big.Rat) int {
+	f, _ := r.Float64()
+	e := int(math.Floor(math.Log10(f)))
+	for r.Cmp(pow10Rat(e)) < 0 {
+		e--
+	}
+	for r.Cmp(pow10Rat(e+1)) >= 0 {
+		e++
+	}
+	return e
+}
+
+// statVerdict is the oracle's verdict in Go where a shape needs it (see above); an empty
+// verdict for the other functions.
+func statVerdict(c statCase) hzExpect {
+	a := c.args
+	n := len(a)
+	xs := a[0].arr
+	someNumber := exactNum(math.NaN())
+	switch c.name {
+	case "VAR", "VAR.S", "VARA", "STDEV.P", "STDEVP", "STDEVPA", "VAR.P", "VARP", "VARPA":
+		ddof := 0
+		if c.name == "VAR" || c.name == "VAR.S" || c.name == "VARA" {
+			ddof = 1
+		}
+		if len(xs) <= ddof {
+			return exactErr("#DIV/0!")
+		}
+		v := goVariance(xs, ddof)
+		if strings.HasPrefix(c.name, "STDEV") {
+			v = math.Sqrt(v)
+		}
+		return exactNum(v)
+	case "SKEW", "SKEW.P", "KURT":
+		least := 3
+		if c.name == "KURT" {
+			least = 4
+		}
+		if len(xs) < least || constant(xs) {
+			return exactErr("#DIV/0!")
+		}
+		if c.name == "KURT" {
+			return exactNum(goKurt(xs))
+		}
+		return exactNum(goSkew(c.name, xs))
+	case "CORREL", "PEARSON", "RSQ":
+		ys := a[1].arr
+		if len(xs) != len(ys) {
+			return exactErr("#N/A")
+		}
+		if len(xs) < 2 || constant(xs) || constant(ys) {
+			return exactErr("#DIV/0!")
+		}
+		sum, dx, dy := libCov(xs, ys)
+		r := sum / math.Sqrt(dx*dy)
+		if c.name == "RSQ" {
+			r *= r
+		}
+		return exactNum(r)
+	case "SLOPE", "INTERCEPT", "FORECAST", "FORECAST.LINEAR", "STEYX":
+		ys, xs := a[n-2].arr, a[n-1].arr
+		if len(xs) != len(ys) {
+			return exactErr("#N/A")
+		}
+		least := 2
+		if c.name == "STEYX" {
+			least = 3
+		}
+		if len(xs) < least || constant(xs) {
+			return exactErr("#DIV/0!")
+		}
+		sum, dx, _ := libCov(xs, ys)
+		slope := sum / dx
+		intercept := libMean(ys) - slope*libMean(xs)
+		switch c.name {
+		case "SLOPE":
+			return exactNum(slope)
+		case "INTERCEPT":
+			return exactNum(intercept)
+		case "STEYX":
+			ss := 0.0
+			for i := range xs {
+				d := ys[i] - (intercept + slope*xs[i])
+				ss += d * d
+			}
+			return exactNum(math.Sqrt(ss / float64(len(xs)-2)))
+		}
+		return exactNum(intercept + slope*a[0].num)
+	case "T.TEST", "TTEST":
+		ys, typ := a[1].arr, a[3].num
+		if a[2].num != math.Trunc(a[2].num) || typ != math.Trunc(typ) {
+			return hzExpect{t: "skip"}
+		}
+		if typ == 1 {
+			if len(xs) != len(ys) {
+				return exactErr("#N/A")
+			}
+			if len(xs) < 2 {
+				return exactErr("#DIV/0!")
+			}
+			d := make([]float64, len(xs))
+			scale := 0.0
+			for i := range xs {
+				d[i] = xs[i] - ys[i]
+				scale = math.Max(scale, math.Abs(d[i]))
+			}
+			sort.Float64s(d)
+			if d[len(d)-1]-d[0] <= 1e-12*scale {
+				return exactErr("#DIV/0!")
+			}
+			return someNumber
+		}
+		if len(xs) < 2 || len(ys) < 2 || constant(xs) && constant(ys) {
+			return exactErr("#DIV/0!")
+		}
+		return someNumber
+	case "Z.TEST", "ZTEST":
+		if n == 2 && (len(xs) < 2 || constant(xs)) {
+			return exactErr("#DIV/0!")
+		}
+		return someNumber
+	case "AVEDEV":
+		all := valuesOf(a)
+		mean, sum := libMean(all), 0.0
+		for _, v := range all {
+			sum += math.Abs(v - mean)
+		}
+		return exactNum(sum / float64(len(all)))
+	case "PERCENTRANK", "PERCENTRANK.INC", "PERCENTRANK.EXC":
+		sig := 3.0
+		if n == 3 {
+			sig = a[2].num
+		}
+		return goPercentrank(c.name, xs, a[1].num, sig)
+	case "PERCENTILE", "PERCENTILE.INC", "QUARTILE", "QUARTILE.INC":
+		k := a[1].num
+		if strings.HasPrefix(c.name, "QUARTILE") {
+			k = math.Trunc(k) / 4
+		}
+		if k < 0 || k > 1 {
+			return exactErr("#NUM!")
+		}
+		return exactNum(goPercentile(xs, k, false))
+	case "PERCENTILE.EXC", "QUARTILE.EXC":
+		k := a[1].num
+		if c.name == "QUARTILE.EXC" {
+			k = math.Trunc(k) / 4
+		}
+		m := float64(len(xs))
+		if k <= 0 || k >= 1 || k < 1/(m+1) || k > m/(m+1) {
+			return exactErr("#NUM!")
+		}
+		return exactNum(goPercentile(xs, k, true))
+	}
+	return hzExpect{}
+}
+
+// --------------------------------------------------------------------------- the classifier
+
+// statShape names the recorded bug the case has the shape of ("" for none; the first name
+// wins, so the most specific condition comes first in each function), from the case and the
+// oracle's verdict, before the library is called. A shape is a condition on the arguments
+// or the replicated arithmetic of the library disagreeing with the verdict (off, within the
+// judge's own tolerance). The order within a function, where it matters: the panic
+// (excelize/1) before the fractional quart (excelize/15) in QUARTILE.EXC; the range
+// (excelize/3, never read) before the literal that is not positive (excelize/21) in HARMEAN;
+// the dropped pairs
+// (excelize/5) before the constant range (excelize/24) in CORREL; the fractional significance
+// (excelize/15), then the binary floor of an exact decimal rank (excelize/29, the mechanism
+// of the rounding family: PERCENTRANK.INC(A1:A5,0.2815,5) over 0.306, 0.306, 0.208, 0.306,
+// 0.06 is 0.43749 for the rank 1.75/4), before the decimal places (excelize/20) in
+// PERCENTRANK; the fractional size
+// (excelize/15) before alpha near 1 (excelize/26) in CONFIDENCE.T; the error code
+// (excelize/21) and the infinity (excelize/10) before the noise value (excelize/24) in SKEW
+// and T.TEST. The precision of CONFIDENCE and CONFIDENCE.NORM (excelize/12) is a check of the
+// judge, not a shape here.
+func statShape(c statCase, want hzExpect) string {
+	a := c.args
+	n := len(a)
+	xs := a[0].arr
+	rtol, atol := hzStatTol(c.name, a)
+	// off: the replica's outcome (a value with code "", or an error code) disagrees with the
+	// verdict; a verdict of any error agrees with any code.
+	off := func(v float64, code string) bool {
+		switch want.t {
+		case "n":
+			return code != "" || !hzClose(v, want.num, rtol, atol)
+		case "e":
+			return code == "" || want.code != "" && code != want.code
+		}
+		return false
+	}
+	switch c.name {
+	case "HARMEAN":
+		for _, arg := range a {
+			if arg.kind == 'a' {
+				return "excelize/3" // a range is not read: #N/A, whatever its values hold
+			}
+		}
+		for _, v := range valuesOf(a) {
+			if v <= 0 {
+				return "excelize/21" // #N/A for a literal that is not positive, want #NUM!
+			}
+		}
+	case "AVEDEV":
+		for _, arg := range a {
+			if arg.kind == 'a' && off(libAvedev(a), "") {
+				return "excelize/4" // a range is one term, its first value
+			}
+		}
+	case "GEOMEAN":
+		p := libProduct(xs)
+		positive := true
+		for _, v := range xs {
+			positive = positive && v > 0
+		}
+		if positive && (math.IsInf(p, 0) || p < 0x1p-1022) {
+			return "excelize/83" // the product overflows to +INF or underflows to #NUM! or a subnormal's digits
+		}
+	case "PRODUCT":
+		if math.IsInf(libProduct(xs), 0) {
+			return "excelize/10" // +INF
+		}
+	case "VAR", "VAR.S", "VAR.P", "VARP", "VARA", "VARPA":
+		if v, code := libVars(c.name, xs); off(v, code) {
+			return "excelize/22" // the one-pass formula loses the digits
+		}
+	case "STDEV.P", "STDEVP", "STDEVPA":
+		if v, code := libStdevp(xs); off(v, code) {
+			return "excelize/22" // the one-pass formula loses the digits (#NUM! for a negative variance)
+		}
+	case "SKEW", "SKEW.P":
+		v, code := libSkew(c.name, xs)
+		if want.t == "e" {
+			switch code {
+			case "#NUM!":
+				return "excelize/21" // 0/0 is NaN: #NUM!, want #DIV/0!
+			case "+INF", "-INF":
+				return "excelize/10" // the one-pass variance is exactly 0, the deviations are not
+			case "":
+				return "excelize/24" // the deviations of an inexact mean are rounding noise
+			}
+		} else if c.name == "SKEW.P" && off(v, code) {
+			return "excelize/22" // the one-pass population variance loses the digits
+		}
+	case "KURT":
+		if _, code := libKurt(xs); want.t == "e" && code == "" {
+			return "excelize/24" // the two-pass sd of an inexact constant range is noise, not 0
+		}
+	case "CORREL":
+		ys := a[1].arr
+		v, code := libCorrel(xs, ys)
+		switch {
+		case !off(v, code):
+		case hasZero(xs) || hasZero(ys):
+			return "excelize/5" // the pairs with a 0 are dropped
+		case constant(xs) || constant(ys):
+			return "excelize/24" // the sd of an inexact constant range is noise, not 0
+		}
+	case "SUMX2MY2", "SUMX2PY2", "SUMXMY2":
+		ys := a[1].arr
+		if len(xs) == len(ys) {
+			for i := range xs {
+				if (xs[i] == 0) != (ys[i] == 0) {
+					return "excelize/5" // the pair is dropped (a pair of two zeros contributes 0 anyway)
+				}
+			}
+		}
+	case "SLOPE", "INTERCEPT", "FORECAST", "FORECAST.LINEAR", "PEARSON", "RSQ":
+		ys, xs := a[n-2].arr, a[n-1].arr
+		v, code := libPearson(c.name, ys, xs, a[0].num)
+		if off(v, code) && len(xs) == len(ys) {
+			sum, _, _ := libCov(xs, ys)
+			if constant(xs) || constant(ys) || sum == 0 {
+				return "excelize/24" // the product of the covariance and the variances is tested against 0
+			}
+		}
+	case "STEYX":
+		ys, xs := a[0].arr, a[1].arr
+		v, code := libSteyx(ys, xs)
+		switch {
+		case !off(v, code):
+		case want.t == "e" && code == "#NUM!":
+			return "excelize/21" // constant known_x's: 0/0, #NUM!, want #DIV/0!
+		case want.t == "e":
+			return "excelize/24" // constant known_x's with an inexact mean: a value from noise
+		default:
+			return "excelize/22" // the one-pass sums cancel
+		}
+	case "T.TEST", "TTEST":
+		ys := a[1].arr
+		if want.t == "e" && want.code == "#DIV/0!" && a[3].num >= 1 && a[3].num <= 3 {
+			switch _, code := libTTest(xs, ys, a[3].num); code {
+			case "#NUM!", "nan":
+				return "excelize/21" // constant ranges: #NUM!, want #DIV/0!
+			case "", "inf":
+				return "excelize/24" // constant ranges checked by nothing (type 2) or by noise: a probability
+			}
+		}
+	case "Z.TEST", "ZTEST":
+		if n == 3 && a[2].num == 0 {
+			return "excelize/21" // sigma 0 is #DIV/0!, want #NUM!
+		}
+		if n == 2 && want.t == "e" && len(xs) > 1 {
+			if sd, _ := libStdev(xs); sd != 0 {
+				return "excelize/24" // the sd of an inexact constant range is noise, not 0
+			}
+		}
+	case "COVARIANCE.S":
+		if len(xs) == 1 && len(a[1].arr) == 1 {
+			return "excelize/21" // one pair: 0/0, #NUM!, want #DIV/0!
+		}
+	case "STANDARDIZE":
+		if a[2].num <= 0 {
+			return "excelize/21" // #N/A, want #NUM!
+		}
+	case "FISHER":
+		if math.Abs(a[0].num) >= 1 {
+			return "excelize/21" // #N/A, want #NUM!
+		}
+	case "FISHERINV":
+		if math.IsNaN(libFisherInv(a[0].num)) {
+			return "excelize/17" // the exponential overflows: #NUM!, want 1
+		}
+	case "PERCENTILE", "PERCENTILE.INC":
+		if k := a[1].num; k < 0 || k > 1 {
+			return "excelize/21" // #N/A, want #NUM!
+		}
+	case "PERCENTILE.EXC":
+		if _, _, panics := libPercentileExc(xs, a[1].num); panics {
+			return "excelize/1" // the index k(n+1) leaves the range
+		}
+	case "QUARTILE.EXC":
+		q := a[1].num
+		v, code, panics := libPercentileExc(xs, q/4)
+		switch {
+		case panics:
+			return "excelize/1" // the index (quart/4)(n+1) leaves the range
+		case q != math.Trunc(q) && off(v, code):
+			return "excelize/15" // the quart is used as it is
+		}
+	case "QUARTILE", "QUARTILE.INC":
+		q := a[1].num
+		if v, code := libPercentile(xs, q/4); q != math.Trunc(q) && off(v, code) {
+			return "excelize/15" // the quart is used as it is
+		}
+	case "PERCENTRANK", "PERCENTRANK.INC", "PERCENTRANK.EXC":
+		sig := 3.0
+		if n == 3 {
+			sig = a[2].num
+		}
+		v, code := libPercentrank(c.name, xs, a[1].num, sig)
+		switch {
+		case !off(v, code):
+		case sig != math.Trunc(sig):
+			return "excelize/15" // 10^significance is taken as it is
+		case want.t == "n" && onDigitBoundary(c.name, xs, a[1].num, sig):
+			return "excelize/29" // the rank is an exact decimal of the digits kept and the binary floor of 10^sig rank lands one unit low
+		case want.t == "n" && want.num > 0 && want.num < 0.1:
+			return "excelize/20" // decimal places, want significant digits
+		}
+	case "CONFIDENCE", "CONFIDENCE.NORM", "CONFIDENCE.T":
+		size := a[2].num
+		if size != math.Trunc(size) && size >= 1 {
+			return "excelize/15" // the size is used as it is
+		}
+		if alpha := a[0].num; c.name == "CONFIDENCE.T" && alpha >= 0.99 && want.t == "n" {
+			return "excelize/26" // the inverse t loses digits for a quantile near 0
+		}
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- the judge
+
+// hzStatTol: the tolerance of a stat function's result, relative to the range's scale for the
+// functions that subtract a mean (differences of a constant-ish range are rounding noise).
+func hzStatTol(name string, args []hzArg) (rtol, atol float64) {
+	scale := 1.0
+	for _, a := range args {
+		if a.kind == 'a' {
+			for _, v := range a.arr {
+				scale = math.Max(scale, math.Abs(v))
+			}
+		}
+	}
+	switch name {
+	case "SKEW", "SKEW.P", "KURT", "CORREL", "PEARSON", "RSQ", "SLOPE", "STEYX",
+		"T.TEST", "TTEST", "Z.TEST", "ZTEST", "CHISQ.TEST", "CHITEST":
+		return 1e-8, 1e-12
+	case "INTERCEPT", "FORECAST", "FORECAST.LINEAR":
+		return 1e-8, scale * 1e-12 // an intercept of exactly 0 comes out as polyfit rounding
+	case "F.TEST", "FTEST":
+		return 1e-6, 1e-12 // the F cumulative at a huge variance ratio
+	case "DEVSQ", "VAR", "VAR.S", "VAR.P", "VARP", "VARA", "VARPA", "COVAR", "COVARIANCE.P", "COVARIANCE.S", "SUMXMY2", "SUMX2MY2":
+		return 1e-9, scale * scale * 1e-12
+	case "STDEV", "STDEV.S", "STDEV.P", "STDEVP", "STDEVA", "STDEVPA", "AVEDEV":
+		return 1e-9, scale * 1e-12
+	}
+	return 1e-10, scale * 1e-13
+}
+
+var hzSubtotal = map[int]string{1: "AVERAGE", 2: "COUNT", 3: "COUNTA", 4: "MAX", 5: "MIN", 6: "PRODUCT", 7: "STDEV", 8: "STDEVP", 9: "SUM", 10: "VAR", 11: "VARP"}
+
+var hzAggregate = map[int]string{12: "MEDIAN", 13: "MODE.SNGL", 14: "LARGE", 15: "SMALL", 16: "PERCENTILE.INC", 17: "QUARTILE.INC", 18: "PERCENTILE.EXC", 19: "QUARTILE.EXC"}
+
+// judgeAs judges the formula as the function name over args (label names it in a failure):
+// the shape named first, then the library against the oracle's verdict within hzStatTol.
+// CONFIDENCE and CONFIDENCE.NORM carry the check-level shape of excelize/12: the normal
+// quantile is accurate to about 1e-9, so a result outside the tolerance but within 1e-8
+// fails naming it; under HEGEL_NO_KNOWN=1 the check is at 1e-8 and every such case is
+// counted as known (not skipped: the 1e-8 check stands).
+func judgeAs(j *hzCaseJudge, o *hzOracle, label, name string, args []hzArg, formula string, cells map[string][]float64) {
+	want, err := o.eval(name, args)
+	if err != nil {
+		j.ht.Fatalf("%s: oracle: %v", formula, err)
+	}
+	j.Shape(statShape(statCase{name: name, args: args}, want))
+	rtol, atol := hzStatTol(name, args)
+	desc := hzDesc(formula, cells)
+	got := hzCalc(formula, cells)
+	if (name == "CONFIDENCE" || name == "CONFIDENCE.NORM") && want.t == "n" {
+		if hzNoKnown {
+			hzCount("known excelize/12")
+			rtol = 1e-8
+		} else if got.isNum && !hzClose(got.num, want.num, rtol, atol) && hzClose(got.num, want.num, 1e-8, atol) {
+			hzCount("shape excelize/12")
+			if j.shape == "" {
+				j.shape = "excelize/12"
+			}
+			j.Fail(label+" value", "%s = %v, want %v", desc, got, want)
+			return
+		}
+	}
+	hzJudgeCase(j, label, desc, got, want, rtol, atol)
+}
+
+// judgeStat judges one case: the formula against the oracle, then each SUBTOTAL and
+// AGGREGATE check against the function it numbers (the same judge, shapes and all).
+func judgeStat(j *hzCaseJudge, o *hzOracle, c statCase) {
+	formula, cells := hzFormula(c.name, c.args)
+	judgeAs(j, o, c.name, c.name, c.args, formula, cells)
+	for _, k := range c.checks {
+		formula, cells := k.formula()
+		judgeAs(j, o, k.fn+" "+k.target(), k.target(), k.args, formula, cells)
+	}
+}
+
+func TestHegelStat(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, statCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeStat(j, o, c)
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..199b327
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,358 @@
+package hegel
+
+// Hegel property tests for xuri/excelize, written for the Hegel zoo. See
+// targets/go/excelize/README.md. They live in a package of their own (hegel/) and drive the
+// public API: the formula calculator (CalcCellValue) on the mathematical, statistical and
+// probability functions, and the cell-name helpers.
+//
+// Oracles: Python (math and decimal for Excel's rounding rules), NumPy and SciPy over a
+// JSON-lines subprocess (python3 with numpy and scipy on PATH), Excel's documented definitions
+// of the functions, and the library against itself (SUBTOTAL and AGGREGATE against the
+// functions they number, ARABIC/ROMAN and DECIMAL/BASE round trips).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// hzStats counts the shapes of the recorded bugs the cases have ("shape excelize/N"), the
+// cases skipped for them under HEGEL_NO_KNOWN=1 ("known excelize/N"), the draws hzOnly
+// rejected ("filtered <name>") and the cases skipped for an unrecorded candidate bug
+// ("candidate/go/excelize-N"); printed and reset by the collector, under hzAvoidedMu.
+var hzStats = map[string]int{}
+
+func hzCount(key string) {
+	hzAvoidedMu.Lock()
+	hzStats[key]++
+	hzAvoidedMu.Unlock()
+}
+
+// hzSkipCandidate skips the case (assume, counted) because it reaches a library bug that is
+// not recorded yet: the candidates are listed where the property draws them.
+func hzSkipCandidate(ht *hegel.T, id string) {
+	hzCount(id)
+	ht.Assume(false)
+}
+
+// hzCaseJudge judges one drawn case (the go/bubbles zootest.Judge, with the collector's
+// mismatch classes): it names the recorded bug whose shape the case has, so that a mismatch
+// or a library panic fails "(the shape of excelize/N)", and under HEGEL_NO_KNOWN=1 skips the
+// case instead (counted as known). The wide and the narrow properties of a function family
+// share their judge function and so this. The classifier that names the shape is computed
+// from the case and the oracle's verdict, before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzCount("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzCount("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzCount("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
