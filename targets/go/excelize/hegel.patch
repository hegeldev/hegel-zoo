+// --------------------------------------------------------------------------- excelize/33
+
+// truncShortcut: TRUNC(a + e / 10^(d+j), d): the first d decimals are zeros and a later one
+// is not, so the shortcut (the fractional digits int(frac 10^d) = 0, below 10^(d-1)) returns
+// the number itself where a is due. The other half of the shape, a block of kept decimals
+// ending in 0 (TRUNC(1.05,1)), fires only when frac 10^d does not fall below the block in
+// binary and is left to the wide property. Past the shape, truncExact. Hit rate 1000 of 1000.
+var truncShortcut = hzShaped(
+	hegel.Composite(func(tc hegel.TestCase) mathCase {
+		d := hegel.Draw(tc, hzInts(1, 6))
+		j := hegel.Draw(tc, hzInts(1, 3))
+		x := decimalOf(hegel.Draw(tc, hzInts(0, 999))*int(math.Pow(10, float64(d+j)))+hegel.Draw(tc, hzInts(1, 9)), d+j)
+		if hegel.Draw(tc, hzCoin(30)) {
+			x = -x
+		}
+		return mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(float64(d))}}
+	}),
+	truncExact,
+)
+
+func TestHegelMathTruncKeepsTheDigits(t *testing.T) { narrowMath(t, truncShortcut) }
+
+// --------------------------------------------------------------------------- excelize/34
+
+// negativeZeros: the Math functions whose result is a negative zero: the rounding family of
+// a negative number that rounds to 0 (ROUND and ROUNDDOWN to 0 or to -3 digits, CEILING,
+// CEILING.MATH, CEILING.PRECISE, ISO.CEILING to a positive multiple, FLOOR and MROUND to a
+// negative one, FLOOR.MATH with a negative mode), QUOTIENT of a smaller numerator with the
+// other sign, PRODUCT with an odd number of negatives and a 0. Past the shape, the same with
+// a positive number (a plain 0). Hit rate 1000 of 1000.
+func negativeZeros(sign float64) hegel.Generator[mathCase] {
+	small := hegel.Map(overTens(hzInts(1, 499), 3, 3), func(v float64) float64 { return sign * v })
+	units := hegel.Map(floats(hzInts(1, 499)), func(v float64) float64 { return sign * v })
+	one := hegel.Just(sign) // FLOOR and MROUND take a multiple of the number's sign
+	return hzWeighted(
+		hzW(1, fn("ROUND", small, zero)),
+		hzW(1, fn("ROUND", units, hegel.Just(-3.0))),
+		hzW(1, fn("ROUNDDOWN", small, zero)),
+		hzW(1, fn("ROUNDDOWN", units, hegel.Just(-3.0))),
+		hzW(1, fn("CEILING", small, hegel.Just(1.0))),
+		hzW(1, fn("CEILING", units, hegel.Just(1000.0))),
+		hzW(1, fn("FLOOR", small, one)),
+		hzW(1, fn("MROUND", small, one)),
+		hzW(1, fn("QUOTIENT", units, floats(hzInts(500, 1000)))),
+		hzW(1, fn("QUOTIENT", neg(units), neg(floats(hzInts(500, 1000))))),
+		hzW(1, fn("PRODUCT", units, zero)),
+		hzW(1, fn("PRODUCT", zero, units, floats(hzInts(1, 9)))),
+		hzW(1, fn("CEILING.MATH", small)),
+		hzW(1, fn("CEILING.MATH", small, hegel.Just(1.0))),
+		hzW(1, fn("CEILING.MATH", small, hegel.Just(1.0), zero)),
+		hzW(1, fn("CEILING.PRECISE", small)),
+		hzW(1, fn("CEILING.PRECISE", small, hegel.Just(2.0))),
+		hzW(1, fn("ISO.CEILING", small)),
+		hzW(1, fn("FLOOR.MATH", small, hegel.Just(1.0), hegel.Just(-1.0))),
+		hzW(1, fn("FLOOR.MATH", small, hegel.Just(-1.0), hegel.Just(-1.0))),
+	)
+}
+
+var negativeZeroIsZero = hzShaped(negativeZeros(-1), negativeZeros(1))
