+	)
+
+	// validNats53: the round trip's number (every value BASE documents).
+	validNats53 = hzWeighted(
+		hzW(4, floats(hzInts(0, 100000))),
+		hzW(1, bigProducts),
+		hzW(1, hzSampled(0.0, 1, 4294967295, 4294967296, 9007199254740991)),
+	)
