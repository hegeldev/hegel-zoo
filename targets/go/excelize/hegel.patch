+// hzWeekendValid: a weekend code 1..7 or 11..17, or a seven-character mask that is not all 1.
+func hzWeekendValid(a hzArg) bool {
+	if a.kind == 's' {
+		return len(a.s) == 7 && strings.Trim(a.s, "01") == "" && a.s != "1111111"
+	}
+	w := math.Trunc(a.num)
+	return (w >= 1 && w <= 7) || (w >= 11 && w <= 17)
+}
+
+// hzNormMonth normalises a month outside 1..12 into the year.
+func hzNormMonth(y, m int) (int, int) {
+	total := y*12 + m - 1
+	yy := total / 12
+	mm := total % 12
+	if mm < 0 {
+		mm += 12
+		yy--
+	}
+	return yy, mm + 1
+}
+
+// hzSerialAny: the Excel serial a date would have, any year (negative before 1900).
+func hzSerialAny(y, m, d int) float64 {
+	t := time.Date(y, time.Month(m), d, 0, 0, 0, 0, time.UTC)
+	// in Unix days: a time.Duration overflows beyond about 292 years
+	s := float64((t.Unix() - hzExcelEpoch.Unix()) / 86400)
+	if t.Before(time.Date(1900, 3, 1, 0, 0, 0, 0, time.UTC)) {
+		s--
+	}
+	return s
+}
+
+func hzDaysIn(y, m int) int {
+	if y == 1900 && m == 2 {
+		return 29
+	}
+	return time.Date(y, time.Month(m)+1, 0, 0, 0, 0, 0, time.UTC).Day()
+}
+
+func TestHegelDate(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		name := hzPick(ht, hzDateFuncs)
+		args := hzGenDateArgs(ht, name)
+		if hzDateAvoid(name, args) {
+			return
+		}
+		formula, cells := hzFormula(name, args)
+		want, err := o.eval(name, args)
+		if err != nil {
+			t.Fatalf("%s: %v", formula, err)
+		}
+		hzJudge(col, ht, name, hzDesc(formula, cells), hzCalc(formula, cells), want, 1e-12, 1e-12)
+	})
+}
diff --git a/hegel/hegel_zoo_dist_test.go b/hegel/hegel_zoo_dist_test.go
new file mode 100644
index 0000000..4bab336
--- /dev/null
+++ b/hegel/hegel_zoo_dist_test.go
@@ -0,0 +1,316 @@
+package hegel
+
+// TestHegelDist: the probability distribution functions (normal, lognormal, Student's t,
+// chi-squared, F, beta, gamma, exponential, Poisson, binomial, negative binomial,
+// hypergeometric, Weibull), their inverses, the gamma function, the error functions and the
+// Bessel functions agree with SciPy, with Excel's argument rules (degrees of freedom and
+// counts truncated, the errors of the documented domains).
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// Kinds: z (a standard score), prob, df (degrees of freedom), shape, pos, cum (TRUE/FALSE),
+// cnt, m (a location), x.
+var hzDistSpecs = strings.Fields(`
+NORM.DIST:z,m,pos,cum NORM.S.DIST:z,cum NORM.INV:prob,m,pos NORM.S.INV:prob NORMDIST:z,m,pos,cum NORMINV:prob,m,pos NORMSDIST:z NORMSINV:prob
+LOGNORM.DIST:pos,m,pos,cum LOGNORM.INV:prob,m,pos LOGNORMDIST:pos,m,pos LOGINV:prob,m,pos
+T.DIST:z,df,cum T.DIST.2T:z,df T.DIST.RT:z,df T.INV:prob,df T.INV.2T:prob,df TDIST:z,df,tails TINV:prob,df
+CHISQ.DIST:pos,df,cum CHISQ.DIST.RT:pos,df CHISQ.INV:prob,df CHISQ.INV.RT:prob,df CHIDIST:pos,df CHIINV:prob,df
+F.DIST:pos,df,df,cum F.DIST.RT:pos,df,df F.INV:prob,df,df F.INV.RT:prob,df,df FDIST:pos,df,df FINV:prob,df,df
+BETA.DIST:beta BETA.INV:prob,shape,shape,bounds? BETADIST:betaold BETAINV:prob,shape,shape,bounds?
+GAMMA.DIST:pos,shape,shape,cum GAMMA.INV:prob,shape,shape GAMMADIST:pos,shape,shape,cum GAMMAINV:prob,shape,shape
+GAMMA:x GAMMALN:pos GAMMALN.PRECISE:pos EXPON.DIST:pos,pos,cum EXPONDIST:pos,pos,cum
+POISSON.DIST:cnt,pos,cum POISSON:cnt,pos,cum BINOM.DIST:cnt,cnt,prob,cum BINOMDIST:cnt,cnt,prob,cum
+BINOM.DIST.RANGE:cnt,prob,cnt,cnt? BINOM.INV:cnt,prob,prob CRITBINOM:cnt,prob,prob
+NEGBINOM.DIST:cnt,cnt,prob,cum NEGBINOMDIST:cnt,cnt,prob HYPGEOM.DIST:hyper,cum HYPGEOMDIST:hyper
+WEIBULL.DIST:pos,shape,shape,cum WEIBULL:pos,shape,shape,cum PHI:z GAUSS:z
+ERF:z,z? ERF.PRECISE:z ERFC:z ERFC.PRECISE:z BESSELJ:z,cnt BESSELY:pos,cnt BESSELI:z,cnt BESSELK:pos,cnt
+`)
+
+func hzGenDistArgs(tc hegel.TestCase, kinds string) []hzArg {
+	var args []hzArg
+	for _, kind := range strings.Split(kinds, ",") {
+		if strings.HasSuffix(kind, "?") {
+			if hzChance(tc, 50) {
+				return args
+			}
+			kind = strings.TrimSuffix(kind, "?")
+		}
+		switch kind {
+		case "z":
+			switch hzDrawInt(tc, 0, 9) {
+			case 0:
+				args = append(args, hzN(hzPick(tc, []float64{0, 1, -1, 8, -8, 40, -40, 1e-9})))
+			case 1:
+				args = append(args, hzN(float64(hzDrawInt(tc, -300, 300))/10))
+			default:
+				args = append(args, hzN(float64(hzDrawInt(tc, -6000, 6000))/1000))
+			}
+		case "m":
+			args = append(args, hzN(hzPick(tc, []float64{0, 0, 1, -2.5, 10, 100, 0.001})))
+		case "pos":
+			switch hzDrawInt(tc, 0, 9) {
+			case 0:
+				args = append(args, hzN(hzPick(tc, []float64{0, -1, 1e-6, 1000, 0.5})))
+			case 1:
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 100))))
+			default:
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 20000))/1000))
+			}
+		case "prob":
+			args = append(args, hzN(hzGenProb(tc)))
+		case "df":
+			switch hzDrawInt(tc, 0, 9) {
+			case 0:
+				v := hzPick(tc, []float64{0, 0.5, 1.9, 200, 1000, -1})
+				if HZKnown.noTruncation && v != math.Trunc(v) || v < 1 {
+					hzAvoid("noTruncation")
+					v = 200
+				}
+				args = append(args, hzN(v))
+			case 1:
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 3))))
+			default:
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 40))))
+			}
+		case "shape":
+			args = append(args, hzGenShape(tc))
+		case "cum":
+			args = append(args, hzB(hzGenBool(tc)))
+		case "tails":
+			args = append(args, hzN(hzPick(tc, []float64{1, 2, 2, 1, 3, 0})))
+		case "cnt":
+			if hzChance(tc, 10) {
+				v := hzPick(tc, []float64{-1, 2.5, 0.9, 100, 0, 200})
+				if HZKnown.noTruncation && v != math.Trunc(v) {
+					hzAvoid("noTruncation")
+					v = 100
+				}
+				args = append(args, hzN(v))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 0, 30))))
+			}
+		case "x":
+			args = append(args, hzN(hzGenNum(tc)))
+		case "beta", "betaold":
+			// x, alpha, beta, cumulative[, A, B] with x mostly inside [A, B]
+			lo, hi := 0.0, 1.0
+			withBounds := hzChance(tc, 40)
+			if withBounds {
+				lo = float64(hzDrawInt(tc, -10, 10))
+				hi = lo + float64(hzDrawInt(tc, 0, 20))/2
+			}
+			x := lo + (hi-lo)*float64(hzDrawInt(tc, 0, 100))/100
+			if hzChance(tc, 8) {
+				x = hzPick(tc, []float64{lo - 0.5, hi + 0.5})
+			}
+			args = append(args, hzN(x), hzGenShape(tc), hzGenShape(tc))
+			if kind == "beta" {
+				args = append(args, hzB(hzGenBool(tc)))
+			}
+			if withBounds {
+				args = append(args, hzN(lo), hzN(hi))
+			}
+		case "bounds":
+			lo := float64(hzDrawInt(tc, -10, 10))
+			args = append(args, hzN(lo), hzN(lo+float64(hzDrawInt(tc, 0, 20))/2))
+		case "hyper":
+			// sample successes, sample size, population successes, population size
+			N := hzDrawInt(tc, 1, 40)
+			n := hzDrawInt(tc, 1, N)
+			M := hzDrawInt(tc, 1, N)
+			x := hzDrawInt(tc, max(0, n-N+M), min(n, M))
+			if hzChance(tc, 10) {
+				x = hzDrawInt(tc, -1, N+1)
+			}
+			if hzChance(tc, 5) {
+				n = N + 1
+			}
+			args = append(args, hzN(float64(x)), hzN(float64(n)), hzN(float64(M)), hzN(float64(N)))
+		default:
+			args = append(args, hzGenArg(tc, kind))
+		}
+	}
+	return args
+}
+
+// hzCountOf: the count whose factorial the combinatorial distributions compute (0 for the
+// others).
+func hzCountOf(name string, args []hzArg) float64 {
+	switch name {
+	case "BINOM.DIST", "BINOMDIST":
+		return args[1].num
+	case "BINOM.DIST.RANGE":
+		return args[0].num
+	case "HYPGEOM.DIST", "HYPGEOMDIST":
+		return args[3].num
+	}
+	return 0
+}
+
+// hzFDensityOverflows: the F density's factors Gamma((d1+d2)/2), (d1/d2)^(d1/2) x^((d1-2)/2) or
+// (1 + d1 x/d2)^((d1+d2)/2) overflow float64 (gammaOverflow).
+func hzFDensityOverflows(x, d1, d2 float64) bool {
+	if x <= 0 || d1 < 1 || d2 < 1 {
+		return false
+	}
+	num := d1/2*math.Log(d1/d2) + (d1-2)/2*math.Log(x)
+	den := (d1 + d2) / 2 * math.Log(1+d1*x/d2)
+	return d1+d2 > 340 || num > 700 || den > 700
+}
+
+// hzDistAvoid: the case reaches a recorded bug whose switch is on.
+func hzDistAvoid(name string, args []hzArg) bool {
+	avoid := func(sw string) bool { hzAvoid(sw); return true }
+	if HZKnown.gammaOverflow && hzCountOf(name, args) > 170 {
+		return avoid("gammaOverflow")
+	}
+	switch name {
+	case "CHIINV", "CHISQ.INV.RT", "GAMMA.INV", "GAMMAINV":
+		if HZKnown.chisqInvRight {
+			return avoid("chisqInvRight")
+		}
+	case "GAMMA":
+		if HZKnown.gammaNegative && args[0].num < 0 {
+			return avoid("gammaNegative")
+		}
+	case "CHISQ.DIST":
+		if HZKnown.domainEdges && !args[2].b && args[0].num == 0 && args[1].num > 2 {
+			return avoid("domainEdges")
+		}
+	case "F.DIST":
+		if HZKnown.gammaOverflow && !args[3].b && hzFDensityOverflows(args[0].num, args[1].num, args[2].num) {
+			return avoid("gammaOverflow")
+		}
+	case "GAMMA.DIST", "GAMMADIST":
+		if HZKnown.gammaOverflow && !args[3].b && args[1].num > 170 {
+			return avoid("gammaOverflow")
+		}
+		if HZKnown.gammaDistSeries && args[3].b && args[1].num > 0 && args[2].num > 0 && (args[0].num/args[2].num > 1.2*args[1].num || args[1].num >= 20) {
+			return avoid("gammaDistSeries")
+		}
+	case "GAMMALN", "GAMMALN.PRECISE":
+		if HZKnown.gammaLnOverflow && args[0].num > 170 {
+			return avoid("gammaLnOverflow")
+		}
+	case "BESSELJ":
+		if HZKnown.besselLarge && math.Abs(args[0].num) > 20 {
+			return avoid("besselLarge")
+		}
+	case "BESSELY":
+		if HZKnown.besselLarge && args[0].num > 5 {
+			return avoid("besselLarge")
+		}
+	case "BETA.INV", "BETAINV":
+		if HZKnown.domainEdges && args[0].num == 1 {
+			return avoid("domainEdges")
+		}
+		if HZKnown.chisqInvRight && args[1].num < 0.5 && args[2].num < 0.5 {
+			return avoid("chisqInvRight")
+		}
+	case "F.INV", "FINV":
+		if HZKnown.domainEdges && args[0].num == 0 {
+			return avoid("domainEdges")
+		}
+	case "CHIDIST", "CHISQ.DIST.RT":
+		if HZKnown.domainEdges && args[0].num <= 0 {
+			return avoid("domainEdges")
+		}
+	case "NORM.INV", "NORMINV", "NORM.DIST", "NORMDIST":
+		if HZKnown.domainEdges && args[2].num == 0 {
+			return avoid("domainEdges")
+		}
+	case "NEGBINOM.DIST", "NEGBINOMDIST":
+		if HZKnown.gammaOverflow && args[0].num+args[1].num > 170 {
+			return avoid("gammaOverflow")
+		}
+	case "POISSON.DIST", "POISSON":
+		if HZKnown.domainEdges && args[1].num == 0 {
+			return avoid("domainEdges")
+		}
+		if HZKnown.gammaOverflow && args[0].num > 170 {
+			return avoid("gammaOverflow")
+		}
+	case "WEIBULL", "WEIBULL.DIST":
+		if HZKnown.domainEdges && args[0].num < 0 {
+			return avoid("domainEdges")
+		}
+	case "BINOM.INV", "CRITBINOM":
+		if HZKnown.domainEdges && (args[1].num == 0 || args[1].num == 1) {
+			return avoid("domainEdges")
+		}
+	case "BINOM.DIST.RANGE":
+		if HZKnown.domainEdges && len(args) == 4 && args[3].num < args[2].num {
+			return avoid("domainEdges")
+		}
+	case "HYPGEOM.DIST":
+		if HZKnown.hypgeomCumulative && args[4].b && args[1].num-args[3].num+args[2].num > 0 {
+			return avoid("hypgeomCumulative")
+		}
+	}
+	return false
+}
+
+func hzGenShape(tc hegel.TestCase) hzArg {
+	if hzChance(tc, 10) {
+		return hzN(hzPick(tc, []float64{0, -1, 0.1, 50, 1}))
+	}
+	return hzN(float64(hzDrawInt(tc, 5, 150)) / 10)
+}
+
+func TestHegelDist(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		spec := hzPick(ht, hzDistSpecs)
+		name, kinds := hzSplitSpec(spec)
+		args := hzGenDistArgs(ht, kinds)
+		if hzDistAvoid(name, args) {
+			return
+		}
+		formula, cells := hzFormula(name, args)
+		want, err := o.eval(name, args)
+		if err != nil {
+			t.Fatalf("%s: %v", formula, err)
+		}
+		rtol, atol := 1e-8, 1e-300
+		switch {
+		case strings.HasPrefix(name, "BESSEL"):
+			rtol, atol = 1e-6, 1e-7 // the recurrences of high orders; the zeros of Y
+		case strings.HasPrefix(name, "WEIBULL"), strings.HasPrefix(name, "EXPON"), strings.HasPrefix(name, "GAMMA.DIST"), strings.HasPrefix(name, "GAMMADIST"):
+			atol = 1e-15 // 1 - exp(-t) for a tiny t
+		}
+		switch name {
+		case "NORM.INV", "NORM.S.INV", "NORMINV", "NORMSINV", "LOGNORM.INV", "LOGINV":
+			rtol = 1e-12
+			if HZKnown.normSInvPrecision {
+				hzAvoid("normSInvPrecision")
+				rtol = 1e-8
+				if name != "NORM.S.INV" && name != "NORMSINV" {
+					rtol = 1e-6 // mean + sd z and exp(mean + sd z) magnify the error of z
+				}
+			}
+		case "T.INV", "T.INV.2T", "TINV":
+			if HZKnown.tInvSmall {
+				if want.t == "n" && (math.Abs(want.num) < 1e-3 || math.Abs(want.num) > 100) {
+					hzAvoid("tInvSmall")
+					return
+				}
+				rtol = 1e-7
+			}
+		case "F.INV", "F.INV.RT", "FINV":
+			rtol = 1e-7
+		}
+		if HZKnown.farTails && want.t == "n" && want.num != 0 && math.Abs(want.num) < 1e-8 {
+			hzAvoid("farTails")
+			return
+		}
+		hzJudge(col, ht, name, hzDesc(formula, cells), hzCalc(formula, cells), want, rtol, atol)
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..6f4151f
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,158 @@
+package hegel
+
+// The generator idioms the properties share, as go/bubbles' internal/zootest/gen.go (and
+// go/gonum's hegel_zoo_gen_test.go) spell them, with the hz prefix of this package: hegel-go
+// has no weighted choice, biased coin, tuple or counted-list combinator. Every generator built
+// from them is a package-level value; the simplest alternative comes first so that shrinking
+// lands on it, except the shape of a recorded bug a wide property must reach every run, which
+// goes first at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are
+// nominal: a weighted choice drawn alone comes out exact (the engine enumerates a small die),
+// but inside a case with other draws the engine favours the first alternative (measured here:
+// the first of a 2:18:10 choice is drawn 40% of the time when another draw precedes or
+// follows it, 7% alone), so the rates are what the collector (ZOO_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzCount("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
