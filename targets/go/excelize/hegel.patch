+// hzPinErr: the formula gives an error (of the given code when code is not empty).
+func hzPinErr(t *testing.T, formula string, cells map[string][]float64, code string) {
+	t.Helper()
+	got := hzCalc(formula, cells)
+	if got.panicked != nil || got.err == nil || (code != "" && got.raw != code) {
+		want := "an error"
+		if code != "" {
+			want = code
+		}
+		t.Errorf("%s = %v, want %s", hzDesc(formula, cells), got, want)
+	}
+}
+
+// hzPinRaw: the formula gives exactly the text want.
+func hzPinRaw(t *testing.T, formula string, cells map[string][]float64, want string) {
+	t.Helper()
+	got := hzCalc(formula, cells)
+	if got.panicked != nil || got.err != nil || got.raw != want {
+		t.Errorf("%s = %v, want %q", hzDesc(formula, cells), got, want)
+	}
+}
