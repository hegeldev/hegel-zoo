+	isoWeekYear             bool // WEEKNUM with return type 21 counts the weeks of the calendar year where the ISO year differs (ISOWEEKNUM is right): WEEKNUM(DATE(2016,1,1),21) = 52 (want 53), WEEKNUM(DATE(2019,12,30),21) = 53 (want 1)
+	serialQuirk1900         bool // serials 0 to 60 are converted to the real day before the Excel date (serial 1 is 31 December 1899 instead of 1 January 1900): MONTH(1) = 12 and YEAR(0) = 1899 (want 1 and 1900), EDATE(9,1) = 39 (want 40), WEEKNUM(1) = 53 (want 1); DATE lands a day late in January and February 1900 unless the year is literally 1900: DATE(1901,-10,23) = 55 (want 54); WEEKNUM of the rest of 1900 counts from a Monday 1 January where Excel has a Sunday: WEEKNUM(111,2) = 16 (want 17)
+	holidayDuplicates       bool // WORKDAY, WORKDAY.INTL, NETWORKDAYS and NETWORKDAYS.INTL count a holiday listed twice twice: NETWORKDAYS(DATE(2020,1,1),DATE(2020,1,31),{DATE(2020,1,6),DATE(2020,1,6)}) = 21 (want 22), WORKDAY(DATE(2020,1,1),5,{DATE(2020,1,6),DATE(2020,1,6)}) = 43840 (want 43839)
+	edateDecemberPanic      bool // EDATE panics with an index out of range when the target month is a December reached through a month sum that is a multiple of 12 and the day is above 28: EDATE(DATE(2020,12,31),-12) and EDATE(DATE(2020,4,30),8) panic (want 31 December 2019 and 30 December 2020)
+	workdayNegativeHolidays bool // WORKDAY and WORKDAY.INTL with a negative number of days walk the sorted holidays from the earliest and stop at the first one before the end date, so holidays are skipped or double-counted: WORKDAY(DATE(2020,1,10),-3,{DATE(2020,1,8)}) = 43837 (7 January 2020; want 43836, 6 January 2020)
+	trivialCaseUnchecked    bool // a trivial case returns before the argument check: YEARFRAC(43840,43840,-1) = 0 and YEARFRAC(43840,43840,7) = 0 (want #NUM!), WORKDAY.INTL(43840,0,10) = 43840 (want #NUM!, weekend 10 is not a code)
