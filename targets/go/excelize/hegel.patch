diff --git a/hegel/hegel_zoo_stat_test.go b/hegel/hegel_zoo_stat_test.go
new file mode 100644
index 0000000..a929a99
--- /dev/null
+++ b/hegel/hegel_zoo_stat_test.go
@@ -0,0 +1,422 @@
+package hegel
+
+// TestHegelStat: the statistical functions over ranges agree with NumPy and SciPy (Excel's
+// definitions: sample and population moments, PERCENTILE.INC/EXC as NumPy's linear and weibull
+// methods, PERCENTRANK truncated to its significance, TRIMMEAN's even trimming, the t-, z-, F-
+// and chi-squared tests); SUBTOTAL and AGGREGATE agree with the functions they number.
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// Kinds of the stat specs: a (a range), a2 (a second range, of the same length mostly), apos
+// (a positive range), xin (a value of the range or near it), k (1..n+1), p (a percentile),
+// q (a quartile number), sig (significance digits), order, tails, type, pct, alpha, cnt.
+var hzStatSpecs = strings.Fields(`
+AVERAGE:a MEDIAN:a MODE.SNGL:a MODE:a STDEV:a STDEV.S:a STDEV.P:a STDEVP:a VAR:a VAR.S:a VAR.P:a VARP:a
+DEVSQ:a AVEDEV:a GEOMEAN:a HARMEAN:a SKEW:a SKEW.P:a KURT:a LARGE:a,k SMALL:a,k MAX:a MIN:a COUNT:a
+PERCENTILE.INC:a,p PERCENTILE.EXC:a,p PERCENTILE:a,p QUARTILE.INC:a,q QUARTILE.EXC:a,q QUARTILE:a,q
+PERCENTRANK.INC:a,xin,sig? PERCENTRANK.EXC:a,xin,sig? PERCENTRANK:a,xin,sig? RANK.EQ:xin,a,order? RANK:xin,a,order?
+TRIMMEAN:a,pct STANDARDIZE:x,x,pos FISHER:unit FISHERINV:x SUMPRODUCT:a,a2 SUMX2MY2:a,a2 SUMX2PY2:a,a2 SUMXMY2:a,a2
+CORREL:a,a2 PEARSON:a,a2 RSQ:a,a2 SLOPE:a,a2 INTERCEPT:a,a2 STEYX:a,a2 FORECAST:x,a,a2 FORECAST.LINEAR:x,a,a2
+COVAR:a,a2 COVARIANCE.P:a,a2 COVARIANCE.S:a,a2 T.TEST:a,a2,tails,type TTEST:a,a2,tails,type
+Z.TEST:a,x,pos? ZTEST:a,x,pos? CONFIDENCE.NORM:alpha,pos,cnt CONFIDENCE:alpha,pos,cnt CONFIDENCE.T:alpha,pos,cnt
+F.TEST:a,a2 FTEST:a,a2 CHISQ.TEST:a,apos CHITEST:a,apos
+AVERAGEA:a MAXA:a MINA:a COUNTA:a STDEVA:a STDEVPA:a VARA:a VARPA:a SUM:a SUMSQ:a PRODUCT:a
+`)
+
+// hzGenStatArgs draws the arguments of a stat spec; the range kinds depend on each other, so
+// the first range is drawn first.
+func hzGenStatArgs(tc hegel.TestCase, kinds string) []hzArg {
+	var args []hzArg
+	var a []float64
+	n := hzDrawInt(tc, 1, 12)
+	if hzChance(tc, 10) {
+		n = hzDrawInt(tc, 13, 60)
+	}
+	for _, kind := range strings.Split(kinds, ",") {
+		if strings.HasSuffix(kind, "?") {
+			if hzChance(tc, 50) {
+				return args
+			}
+			kind = strings.TrimSuffix(kind, "?")
+		}
+		switch kind {
+		case "a":
+			a = hzGenSeries(tc, n)
+			args = append(args, hzA(a))
+		case "a2":
+			m := n
+			if hzChance(tc, 8) {
+				m = hzDrawInt(tc, 1, 12)
+			}
+			b := hzGenSeries(tc, m)
+			if hzChance(tc, 40) && m == n && a != nil {
+				// a noisy linear image of a
+				slope, off := float64(hzDrawInt(tc, -5, 5)), float64(hzDrawInt(tc, -10, 10))
+				for i := range b {
+					b[i] = slope*a[i] + off + float64(hzDrawInt(tc, -3, 3))/4
+				}
+			}
+			args = append(args, hzA(b))
+		case "apos":
+			b := make([]float64, n)
+			if hzChance(tc, 8) {
+				b = make([]float64, hzDrawInt(tc, 1, 12))
+			}
+			for i := range b {
+				b[i] = float64(hzDrawInt(tc, 1, 200)) / 4
+			}
+			if hzChance(tc, 5) {
+				b[hzDrawInt(tc, 0, len(b)-1)] = 0
+			}
+			args = append(args, hzA(b))
+		case "xin":
+			var x float64
+			switch {
+			case a == nil:
+				x = hzGenNum(tc)
+			case hzChance(tc, 60):
+				x = hzPick(tc, a)
+			case hzChance(tc, 50):
+				// between two values
+				lo, hi := a[hzDrawInt(tc, 0, len(a)-1)], a[hzDrawInt(tc, 0, len(a)-1)]
+				x = lo + (hi-lo)*float64(hzDrawInt(tc, 0, 8))/8
+			default:
+				x = hzGenNum(tc)
+			}
+			args = append(args, hzN(x))
+		case "k":
+			if hzChance(tc, 10) {
+				args = append(args, hzN(hzPick(tc, []float64{0, -1, float64(n + 1), 1.5})))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, n))))
+			}
+		case "p":
+			if hzChance(tc, 40) {
+				// the ends and the EXC bounds
+				args = append(args, hzN(hzPick(tc, []float64{0, 1, 0.5, 1 / float64(n+1), float64(n) / float64(n+1), 1.01, -0.01})))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 0, 1000))/1000))
+			}
+		case "q":
+			if hzChance(tc, 10) {
+				args = append(args, hzN(hzIntArg(tc, hzPick(tc, []float64{5, -1, 1.5, 2.9}), 5)))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 0, 4))))
+			}
+		case "sig":
+			if hzChance(tc, 10) {
+				args = append(args, hzN(hzIntArg(tc, hzPick(tc, []float64{0, -1, 1.5, 15}), 15)))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 6))))
+			}
+		case "order":
+			args = append(args, hzN(hzPick(tc, []float64{0, 1, 2, -1})))
+		case "tails":
+			if hzChance(tc, 5) {
+				args = append(args, hzN(hzPick(tc, []float64{0, 3, 1.5})))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 2))))
+			}
+		case "type":
+			if hzChance(tc, 5) {
+				args = append(args, hzN(hzPick(tc, []float64{0, 4, 2.5})))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 3))))
+			}
+		case "pct":
+			if hzChance(tc, 10) {
+				args = append(args, hzN(hzPick(tc, []float64{1, -0.1, 1.5, 0.99})))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 0, 9))/10))
+			}
+		case "alpha":
+			args = append(args, hzN(hzGenProb(tc)))
+		case "cnt":
+			if hzChance(tc, 10) {
+				args = append(args, hzN(hzIntArg(tc, hzPick(tc, []float64{0, 1, 0.5, 1.9, -3}), 1)))
+			} else {
+				args = append(args, hzN(float64(hzDrawInt(tc, 1, 100))))
+			}
+		default:
+			args = append(args, hzGenArg(tc, kind))
+		}
+	}
+	return args
+}
+
+// hzIntArg: an argument Excel truncates to an integer; while noTruncation is on, a fractional
+// draw is replaced by alt.
+func hzIntArg(tc hegel.TestCase, v, alt float64) float64 {
+	if HZKnown.noTruncation && v != math.Trunc(v) {
+		hzAvoid("noTruncation")
+		return alt
+	}
+	return v
+}
+
+// hzStatTol: the tolerance of a stat function's result, relative to the range's scale for the
+// functions that subtract a mean (differences of a constant-ish range are rounding noise).
+func hzStatTol(name string, args []hzArg) (rtol, atol float64) {
+	scale := 1.0
+	for _, a := range args {
+		if a.kind == 'a' {
+			for _, v := range a.arr {
+				scale = math.Max(scale, math.Abs(v))
+			}
+		}
+	}
+	switch name {
+	case "SKEW", "SKEW.P", "KURT", "CORREL", "PEARSON", "RSQ", "SLOPE", "STEYX",
+		"T.TEST", "TTEST", "Z.TEST", "ZTEST", "CHISQ.TEST", "CHITEST":
+		return 1e-8, 1e-12
+	case "INTERCEPT", "FORECAST", "FORECAST.LINEAR":
+		return 1e-8, scale * 1e-12 // an intercept of exactly 0 comes out as polyfit rounding
+	case "F.TEST", "FTEST":
+		return 1e-6, 1e-12 // the F cumulative at a huge variance ratio
+	case "DEVSQ", "VAR", "VAR.S", "VAR.P", "VARP", "VARA", "VARPA", "COVAR", "COVARIANCE.P", "COVARIANCE.S", "SUMXMY2", "SUMX2MY2":
+		return 1e-9, scale * scale * 1e-12
+	case "STDEV", "STDEV.S", "STDEV.P", "STDEVP", "STDEVA", "STDEVPA", "AVEDEV":
+		return 1e-9, scale * 1e-12
+	}
+	return 1e-10, scale * 1e-13
+}
+
+var hzSubtotal = map[int]string{1: "AVERAGE", 2: "COUNT", 3: "COUNTA", 4: "MAX", 5: "MIN", 6: "PRODUCT", 7: "STDEV", 8: "STDEVP", 9: "SUM", 10: "VAR", 11: "VARP"}
+
+var hzAggregate = map[int]string{12: "MEDIAN", 13: "MODE.SNGL", 14: "LARGE", 15: "SMALL", 16: "PERCENTILE.INC", 17: "QUARTILE.INC", 18: "PERCENTILE.EXC", 19: "QUARTILE.EXC"}
+
+func TestHegelStat(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		spec := hzPick(ht, hzStatSpecs)
+		name, kinds := hzSplitSpec(spec)
+		args := hzGenStatArgs(ht, kinds)
+		if HZKnown.percentileExcPanics && (name == "PERCENTILE.EXC" || name == "QUARTILE.EXC") && hzExcOutside(name, args) {
+			hzAvoid("percentileExcPanics")
+			return
+		}
+		if hzStatAvoid(name, args) {
+			return
+		}
+		formula, cells := hzFormula(name, args)
+		want, err := o.eval(name, args)
+		if err != nil {
+			t.Fatalf("%s: %v", formula, err)
+		}
+		rtol, atol := hzStatTol(name, args)
+		if strings.HasPrefix(name, "PERCENTRANK") && HZKnown.percentrankDigits && want.t == "n" && want.num != 0 && want.num < 0.1 {
+			hzAvoid("percentrankDigits")
+			return
+		}
+		if name == "STEYX" && HZKnown.naiveVariance && want.t == "n" && hzResidualTiny(want.num, args[0].arr) {
+			hzAvoid("naiveVariance")
+			return
+		}
+		if (name == "CONFIDENCE" || name == "CONFIDENCE.NORM") && HZKnown.normSInvPrecision {
+			hzAvoid("normSInvPrecision")
+			rtol = 1e-8
+		}
+		if name == "CONFIDENCE.T" {
+			rtol = 1e-8 // the t quantile of a tiny alpha
+			if HZKnown.tInvSmall {
+				if args[0].num > 0.99 {
+					hzAvoid("tInvSmall")
+					return
+				}
+				rtol = 1e-7
+			}
+		}
+		hzJudge(col, ht, name, hzDesc(formula, cells), hzCalc(formula, cells), want, rtol, atol)
+
+		// SUBTOTAL and AGGREGATE against the functions they number
+		if args[0].kind == 'a' && hzChance(ht, 30) {
+			a := args[0]
+			fnum := hzDrawInt(ht, 1, 11)
+			fname := hzSubtotal[fnum]
+			if hzChance(ht, 30) {
+				fnum += 100
+			}
+			if hzStatAvoid(fname, []hzArg{a}) {
+				return
+			}
+			formula, cells := hzFormula("SUBTOTAL", []hzArg{hzN(float64(fnum)), a})
+			want, err := o.eval(fname, []hzArg{a})
+			if err != nil {
+				t.Fatalf("%s: %v", formula, err)
+			}
+			rtol, atol := hzStatTol(fname, []hzArg{a})
+			hzJudge(col, ht, "SUBTOTAL "+fname, hzDesc(formula, cells), hzCalc(formula, cells), want, rtol, atol)
+
+			fnum = hzDrawInt(ht, 1, 19)
+			opts := hzDrawInt(ht, 0, 7)
+			fargs := []hzArg{a}
+			fname = hzSubtotal[fnum]
+			if fnum >= 12 {
+				fname = hzAggregate[fnum]
+			}
+			switch fnum {
+			case 14, 15:
+				fargs = append(fargs, hzN(float64(hzDrawInt(ht, 1, len(a.arr)))))
+			case 16, 18:
+				fargs = append(fargs, hzN(float64(hzDrawInt(ht, 1, 9))/10))
+			case 17, 19:
+				fargs = append(fargs, hzN(float64(hzDrawInt(ht, 1, 3))))
+			}
+			if HZKnown.percentileExcPanics && (fnum == 18 || fnum == 19) && hzExcOutside(fname, fargs) {
+				hzAvoid("percentileExcPanics")
+			} else if !hzStatAvoid(fname, fargs) {
+				formula, cells = hzFormula("AGGREGATE", append([]hzArg{hzN(float64(fnum)), hzN(float64(opts))}, fargs...))
+				want, err = o.eval(fname, fargs)
+				if err != nil {
+					t.Fatalf("%s: %v", formula, err)
+				}
+				rtol, atol = hzStatTol(fname, fargs)
+				hzJudge(col, ht, "AGGREGATE "+fname, hzDesc(formula, cells), hzCalc(formula, cells), want, rtol, atol)
+			}
+		}
+		col.count("cases")
+	})
+}
+
+// hzStatAvoid: the case reaches a recorded bug whose switch is on.
+func hzStatAvoid(name string, args []hzArg) bool {
+	avoid := func(sw string) bool { hzAvoid(sw); return true }
+	switch name {
+	case "HARMEAN":
+		if HZKnown.harmeanRange {
+			return avoid("harmeanRange")
+		}
+	case "AVEDEV":
+		if HZKnown.avedevRange {
+			return avoid("avedevRange")
+		}
+	case "CORREL", "SUMX2MY2", "SUMX2PY2", "SUMXMY2":
+		if HZKnown.zeroPairsDropped && len(args) == 2 && args[1].kind == 'a' && hzHasZeroPair(args[0].arr, args[1].arr) {
+			return avoid("zeroPairsDropped")
+		}
+		if name == "CORREL" && HZKnown.zeroVarianceChecks && (hzSpread(args[0].arr) == 0 || hzSpread(args[1].arr) == 0) {
+			return avoid("zeroVarianceChecks")
+		}
+	case "FISHERINV":
+		if HZKnown.hyperbolicOverflow && math.Abs(args[0].num) >= 355 {
+			return avoid("hyperbolicOverflow")
+		}
+	case "VAR", "VAR.S", "VAR.P", "VARP", "VARA", "VARPA", "STDEV.P", "STDEVP", "STDEVPA", "SKEW.P":
+		if HZKnown.naiveVariance && hzIllConditioned(args[0].arr) {
+			return avoid("naiveVariance")
+		}
+	case "SLOPE", "INTERCEPT", "FORECAST", "FORECAST.LINEAR", "RSQ", "PEARSON", "STEYX":
+		ys, xs := args[len(args)-2].arr, args[len(args)-1].arr
+		if HZKnown.zeroVarianceChecks && (hzSpread(ys) == 0 || hzSpread(xs) == 0 || (name != "STEYX" && hzZeroCov(xs, ys))) {
+			return avoid("zeroVarianceChecks")
+		}
+	case "T.TEST", "TTEST":
+		if HZKnown.zeroVarianceChecks && hzSpread(args[0].arr) == 0 && hzSpread(args[1].arr) == 0 {
+			return avoid("zeroVarianceChecks")
+		}
+	case "SKEW", "KURT", "Z.TEST", "ZTEST":
+		if HZKnown.zeroVarianceChecks && len(args) < 3 && hzSpread(args[0].arr) == 0 {
+			return avoid("zeroVarianceChecks")
+		}
+	}
+	return false
+}
+
+// hzSpread: max - min of a range.
+func hzSpread(xs []float64) float64 {
+	if len(xs) == 0 {
+		return 0
+	}
+	lo, hi := xs[0], xs[0]
+	for _, v := range xs {
+		lo, hi = math.Min(lo, v), math.Max(hi, v)
+	}
+	return hi - lo
+}
+
+// hzZeroCov: the covariance of two ranges is 0 within rounding (pearsonProduct divides by it).
+func hzZeroCov(xs, ys []float64) bool {
+	n := len(xs)
+	if n == 0 || len(ys) != n {
+		return false
+	}
+	var mx, my float64
+	for i := range xs {
+		mx += xs[i]
+		my += ys[i]
+	}
+	mx, my = mx/float64(n), my/float64(n)
+	var sxy, sxx, syy float64
+	for i := range xs {
+		dx, dy := xs[i]-mx, ys[i]-my
+		sxy += dx * dy
+		sxx += dx * dx
+		syy += dy * dy
+	}
+	return math.Abs(sxy) <= 1e-9*math.Sqrt(sxx*syy)
+}
+
+// hzResidualTiny: the residual variance of a regression is under 1e-6 of the y variance, so
+// the one-pass formula of STEYX cancels its digits.
+func hzResidualTiny(steyx float64, ys []float64) bool {
+	mean := 0.0
+	for _, v := range ys {
+		mean += v
+	}
+	mean /= float64(len(ys))
+	ss := 0.0
+	for _, v := range ys {
+		ss += (v - mean) * (v - mean)
+	}
+	return steyx*steyx*float64(len(ys)) <= 1e-6*ss
+}
+
+func hzHasZeroPair(a, b []float64) bool {
+	for i := range a {
+		if a[i] == 0 || (i < len(b) && b[i] == 0) {
+			return true
+		}
+	}
+	return false
+}
+
+// hzIllConditioned: the one-pass variance formula loses more than 1e-10 of the value (the
+// mean is over a thousand times the standard deviation, or the range is constant).
+func hzIllConditioned(xs []float64) bool {
+	if len(xs) == 0 {
+		return false
+	}
+	mean := 0.0
+	for _, v := range xs {
+		mean += v
+	}
+	mean /= float64(len(xs))
+	ss := 0.0
+	for _, v := range xs {
+		ss += (v - mean) * (v - mean)
+	}
+	sd := math.Sqrt(ss / float64(len(xs)))
+	return sd == 0 || math.Abs(mean) > 1000*sd
+}
+
+// hzExcOutside: a PERCENTILE.EXC/QUARTILE.EXC call whose k lies outside [1/(n+1), n/(n+1)],
+// where Excel gives #NUM!, or at the upper bound n/(n+1), where the index k(n+1) is n.
+func hzExcOutside(name string, args []hzArg) bool {
+	if len(args) < 2 || args[0].kind != 'a' {
+		return false
+	}
+	n := float64(len(args[0].arr))
+	k := args[1].num
+	if strings.HasPrefix(name, "QUARTILE") {
+		k = math.Trunc(k) / 4
+	}
+	idx := k * (n + 1)
+	return k > 0 && k < 1 && (idx < 1 || idx >= n)
+}
