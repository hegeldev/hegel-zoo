+
+	// secAngles: SEC's angle; the library returns the cosine, so every angle but 0 is the shape
+	// of excelize/2 (hzShaped: only 0 under HEGEL_NO_KNOWN=1).
+	secAngles = hzShaped(angles, hegel.Just(0.0))
