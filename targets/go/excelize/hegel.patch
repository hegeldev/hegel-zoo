+// combinaOfNothing: COMBINA of two arguments that truncate to 0 (the library and the oracle
+// both truncate first; the number itself, 0, comes back where 1 is due). Past the shape,
+// COMBINA(n, 0) and COMBINA(n + f, g) with n in 1..30 and f, g in [0, 1) (1: n items, none
+// chosen), and 1 <= k <= n <= 6. COMBINA(0, k) with k > 0 is the shape of excelize/21 (#VALUE!,
+// want #NUM!) and lives in errorCodesAsDocumented. Hit rate 1000 of 1000.
+var combinaOfNothing = hzShaped(
+	fn("COMBINA", zeroish, zeroish),
+	hzWeighted(
+		hzW(1, fn("COMBINA", floats(hzInts(1, 30)), zero)),
+		hzW(1, fn("COMBINA", hegel.Map(hzTuple(floats(hzInts(1, 30)), zeroish), func(v []float64) float64 { return v[0] + v[1] }), zeroish)),
+		hzW(1, combinaWithin),
+	),
+)
