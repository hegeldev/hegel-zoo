+package hegel
+
+// The Python oracle: a python3 subprocess speaking JSON lines, evaluating Excel functions by
+// their documented definitions with math, decimal (Excel's decimal rounding rules), NumPy and
+// SciPy. Floats travel as strings (Go's shortest round-trip formatting, Python's repr) so that
+// every double survives the trip exactly.
+//
+// A request is {"name": FUNCTION, "args": [ARG...]} with ARG one of {"n": "1.5"}, {"b": true},
+// {"s": "text"}, {"a": ["1", "2"]} (a range). The reply is {"ok": {"t": "n", "v": "1.5"}},
+// {"t": "b", "v": true}, {"t": "s", "v": "abc"}, {"t": "e", "v": "#NUM!"} (Excel error; "" when
+// the code is not modelled) or {"t": "skip"} (not judged); {"error": ...} is a fault of the
+// oracle itself.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json, math, warnings
+from decimal import Decimal, ROUND_HALF_UP, ROUND_UP, ROUND_DOWN, ROUND_FLOOR, ROUND_CEILING, getcontext
+import numpy as np
+from scipy import stats as st
+from scipy import special as sp
+warnings.simplefilter("ignore")
+getcontext().prec = 60
+
+NUM, DIV0, VALUE, NA, ANY = "#NUM!", "#DIV/0!", "#VALUE!", "#N/A", ""
+
+class XErr(Exception):
+    def __init__(self, code):
+        self.code = code
+
+class Skip(Exception):
+    pass
+
+def num(code=NUM):
+    raise XErr(code)
+
+def D(x):
+    return Decimal(repr(float(x)))
+
+def trunc(x):
+    return float(math.trunc(x))
+
+def fin(v):
+    v = float(v)
+    if math.isnan(v) or math.isinf(v):
+        raise XErr(NUM)
+    return v
+
+def chk(cond, code=NUM):
+    if not cond:
+        raise XErr(code)
+
+# ------------------------------------------------------------------ rounding (decimal, as Excel)
+
+def dround(x, d, mode):
+    d = int(math.trunc(d))
+    q = Decimal(1).scaleb(-d)
+    return float(D(x).quantize(q, rounding=mode))
+
+def dmul(x, s, mode):
+    # x rounded to a multiple of s with the given integral rounding mode, in decimal
+    if s == 0:
+        return 0.0
+    k = (D(x) / D(s)).to_integral_value(rounding=mode)
+    return float(k * D(s))
+
+def ROUND(x, d=0): return dround(x, d, ROUND_HALF_UP)
+def ROUNDUP(x, d=0): return dround(x, d, ROUND_UP)
+def ROUNDDOWN(x, d=0): return dround(x, d, ROUND_DOWN)
+def TRUNC(x, d=0): return dround(x, d, ROUND_DOWN)
+def INT(x): return float(math.floor(x))
+
+def MROUND(x, m):
+    if m == 0:
+        raise Skip()
+    chk(x * m >= 0)
+    return dmul(x, m, ROUND_HALF_UP)
+
+def CEILING(x, s):
+    chk(not (x > 0 and s < 0))
+    return dmul(x, s, ROUND_CEILING)
+
+def FLOOR(x, s):
+    chk(s != 0, DIV0)
+    chk(not (x > 0 and s < 0))
+    return dmul(x, s, ROUND_FLOOR)
+
+def CEILING_MATH(x, s=1.0, mode=0.0):
+    s = abs(s)
+    if mode != 0 and x < 0:
+        return dmul(x, s, ROUND_FLOOR)
+    return dmul(x, s, ROUND_CEILING)
+
+def FLOOR_MATH(x, s=1.0, mode=0.0):
+    s = abs(s)
+    if mode != 0 and x < 0:
+        return dmul(x, s, ROUND_CEILING)
+    return dmul(x, s, ROUND_FLOOR)
+
+def CEILING_PRECISE(x, s=1.0): return dmul(x, abs(s), ROUND_CEILING)
+def FLOOR_PRECISE(x, s=1.0): return dmul(x, abs(s), ROUND_FLOOR)
+
+def EVEN(x):
+    a = math.ceil(abs(x))
+    if a % 2:
+        a += 1
+    return float(-a if x < 0 else a)
+
+def ODD(x):
+    a = math.ceil(abs(x))
+    if a % 2 == 0:
+        a += 1
+    return float(-a if x < 0 else a)
+
+# ------------------------------------------------------------------ arithmetic
+
+def MOD(n, d):
+    chk(d != 0, DIV0)
+    return n - d * math.floor(n / d)
+
+def QUOTIENT(n, d):
+    chk(d != 0, DIV0)
+    return trunc(n / d)
+
+def POWER(x, y):
+    if x == 0:
+        chk(y != 0)
+        chk(y > 0, DIV0)
+        return 0.0
+    if x < 0 and y != math.floor(y):
+        num()
+    return fin(x ** y)
+
+def SIGN(x): return float((x > 0) - (x < 0))
+def ABS(x): return abs(x)
+def EXP(x): return fin(math.exp(x))
+def LN(x): chk(x > 0); return math.log(x)
+def LOG10(x): chk(x > 0); return math.log10(x)
+def LOG(x, b=10.0):
+    chk(x > 0 and b > 0)
+    chk(b != 1, DIV0)
+    return math.log(x) / math.log(b) if b != 10 else math.log10(x)
+def SQRT(x): chk(x >= 0); return math.sqrt(x)
+def SQRTPI(x): chk(x >= 0); return math.sqrt(x * math.pi)
+def PI(): return math.pi
+def DEGREES(x): return math.degrees(x)
+def RADIANS(x): return math.radians(x)
+
+def SIN(x): return math.sin(x)
+def COS(x): return math.cos(x)
+def TAN(x): return math.tan(x)
+def ASIN(x): chk(-1 <= x <= 1); return math.asin(x)
+def ACOS(x): chk(-1 <= x <= 1); return math.acos(x)
+def ATAN(x): return math.atan(x)
+def ATAN2(x, y):
+    chk(x != 0 or y != 0, DIV0)
+    return math.atan2(y, x)
+def SINH(x): return fin(math.sinh(x))
+def COSH(x): return fin(math.cosh(x))
+def TANH(x): return math.tanh(x)
+def ASINH(x): return math.asinh(x)
+def ACOSH(x): chk(x >= 1); return math.acosh(x)
+def ATANH(x): chk(-1 < x < 1); return math.atanh(x)
+def COT(x): chk(x != 0, DIV0); return 1 / math.tan(x)
+def ACOT(x):
+    if abs(x) > 1e5:
+        raise Skip()  # the target's pi/2 - atan(x) has lost more than 1e-9
+    if x == 0:
+        return math.pi / 2
+    return math.atan(1 / x) + (math.pi if x < 0 else 0)
+def COTH(x): chk(x != 0, DIV0); return 1 / math.tanh(x)
+def ACOTH(x): chk(abs(x) > 1); return math.atanh(1 / x)
+def CSC(x): chk(x != 0, DIV0); return 1 / math.sin(x)
+def CSCH(x):
+    chk(x != 0, DIV0)
+    if abs(x) > 700:
+        raise Skip()
+    return 1 / math.sinh(x)
+def SEC(x): return 1 / math.cos(x)
+def SECH(x):
+    if abs(x) > 700:
+        raise Skip()
+    return 1 / math.cosh(x)
+
+def ipos(x, code=NUM):
+    x = math.trunc(x)
+    chk(x >= 0, code)
+    return x
+
+def FACT(n):
+    n = ipos(n)
+    chk(n <= 170)
+    return float(math.factorial(n))
+
+def FACTDOUBLE(n):
+    n = math.trunc(n)
+    chk(n >= 0)
+    chk(n <= 300)
+    r = 1
+    while n > 1:
+        r *= n
+        n -= 2
+    return float(r)
+
+def COMBIN(n, k):
+    n, k = ipos(n), ipos(k)
+    chk(n >= k)
+    return float(math.comb(n, k))
+
+def COMBINA(n, k):
+    n, k = ipos(n), ipos(k)
+    if n == 0 and k == 0:
+        return 1.0
+    chk(n >= 1)
+    if n < k:
+        raise Skip()
+    return float(math.comb(n + k - 1, k))
+
+def PERMUT(n, k):
+    n, k = ipos(n), ipos(k)
+    chk(n >= k)
+    return float(math.perm(n, k))
+
+def PERMUTATIONA(n, k):
+    n, k = ipos(n), ipos(k)
+    return float(n ** k)
+
+def MULTINOMIAL(*xs):
+    ks = [ipos(x) for x in xs]
+    r = math.factorial(sum(ks))
+    for k in ks:
+        r //= math.factorial(k)
+    return float(r)
+
+def GCD(*xs):
+    ks = [ipos(x) for x in xs]
+    return float(math.gcd(*ks))
+
+def LCM(*xs):
+    ks = [ipos(x) for x in xs]
+    if 0 in ks:
+        return 0.0
+    return float(math.lcm(*ks))
+
+DIGITS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+def BASE(n, radix, minlen=0.0):
+    n, radix, minlen = math.trunc(n), math.trunc(radix), math.trunc(minlen)
+    chk(0 <= n < 2 ** 53 and 2 <= radix <= 36 and 0 <= minlen <= 255)
+    s = ""
+    while n:
+        s = DIGITS[n % radix] + s
+        n //= radix
+    if not s:
+        s = "0"
+    return s.rjust(minlen, "0")
+
+def DECIMAL(text, radix):
+    radix = math.trunc(radix)
+    chk(2 <= radix <= 36)
+    chk(len(text) <= 255)
+    v = 0
+    for ch in text.upper():
+        d = DIGITS.find(ch)
+        chk(0 <= d < radix)
+        v = v * radix + d
+    chk(v < 2 ** 53)
+    return float(v)
+
+ROMAN_TABLE = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"),
+               (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]
+
+def ROMAN(n, form=0.0):
+    n = math.trunc(n)
+    chk(0 <= n <= 3999, VALUE)
+    if isinstance(form, bool):
+        classic = form
+    else:
+        chk(0 <= form <= 4, VALUE)
+        classic = math.trunc(form) == 0
+    if not classic:
+        raise Skip()
+    s = ""
+    for v, r in ROMAN_TABLE:
+        while n >= v:
+            s += r
+            n -= v
+    return s
+
+def ARABIC(text):
+    vals = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
+    t = text.strip().upper()
+    neg = t.startswith("-")
+    if neg:
+        t = t[1:]
+    if t == "":
+        return 0.0
+    chk(len(t) <= 255, VALUE)
+    total = 0
+    for i, ch in enumerate(t):
+        chk(ch in vals, VALUE)
+        v = vals[ch]
+        if i + 1 < len(t) and vals[t[i + 1]] > v:
+            total -= v
+        else:
+            total += v
+    return float(-total if neg else total)
+
+def SUM(*xs): return float(sum(flat(xs)))
+def SUMSQ(*xs): return float(sum(v * v for v in flat(xs)))
+def PRODUCT(*xs):
+    r = 1.0
+    for v in flat(xs):
+        r *= v
+    return fin(r)
+def AVERAGE(*xs):
+    v = flat(xs)
+    chk(len(v) > 0, DIV0)
+    return float(np.mean(v))
+def SERIESSUM(x, n, m, coeffs):
+    r = 0.0
+    for i, a in enumerate(coeffs):
+        r += a * x ** (n + i * m)
+    return fin(r)
+
+def flat(xs):
+    out = []
+    for x in xs:
+        if isinstance(x, list):
+            out.extend(x)
+        elif isinstance(x, bool):
+            pass
+        else:
+            out.append(x)
+    return out
+
+# ------------------------------------------------------------------ statistics
+
+def A(xs):
+    return np.array(xs, dtype=float)
+
+def const(xs):
+    return len(xs) > 0 and min(xs) == max(xs)
+
+def need(xs, n, code=DIV0):
+    chk(len(xs) >= n, code)
+
+def MEDIAN(xs): need(xs, 1, NUM); return float(np.median(xs))
+def MAX(xs): return float(max(xs)) if xs else 0.0
+def MIN(xs): return float(min(xs)) if xs else 0.0
+def COUNT(xs): return float(len(xs))
+def VAR_S(xs): need(xs, 2); return float(np.var(xs, ddof=1))
+def VAR_P(xs): need(xs, 1); return float(np.var(xs))
+def STDEV_S(xs): need(xs, 2); return float(np.std(xs, ddof=1))
+def STDEV_P(xs): need(xs, 1); return float(np.std(xs))
+def DEVSQ(xs): need(xs, 1, NUM); a = A(xs); return float(np.sum((a - a.mean()) ** 2))
+def AVEDEV(*xs):
+    xs = flat(xs)
+    need(xs, 1, NUM)
+    a = A(xs)
+    return float(np.mean(np.abs(a - a.mean())))
+def GEOMEAN(*xs):
+    xs = flat(xs)
+    need(xs, 1, NUM)
+    chk(all(v > 0 for v in xs))
+    return float(st.gmean(xs))
+def HARMEAN(*xs):
+    xs = flat(xs)
+    need(xs, 1, NUM)
+    chk(all(v > 0 for v in xs))
+    return float(st.hmean(xs))
+def SKEW(xs):
+    need(xs, 3)
+    chk(not const(xs), DIV0)
+    return float(st.skew(xs, bias=False))
+def SKEW_P(xs):
+    need(xs, 3)
+    chk(not const(xs), DIV0)
+    return float(st.skew(xs, bias=True))
+def KURT(xs):
+    need(xs, 4)
