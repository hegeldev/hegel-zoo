+	replaceBytes            bool // REPLACE indexes bytes and accepts a negative num_chars: REPLACE("héllo",2,1,"E") = "hE\xa9llo" (want "hEllo"), REPLACE("abcdef",3,-1,"X") = "abXbcdef" (want #VALUE!)
+	codeFirstByte           bool // CODE and UNICODE return the first UTF-8 byte and CODE of an empty text is 0: UNICODE("€") = 226 (want 8364), CODE("é") = 195 (want 233), UNICODE("😀") = 240 (want 128512), CODE("") = 0 (want #VALUE!)
+	charZero                bool // CHAR(0) and CHAR(0.5) return a NUL character (want #VALUE!)
+	unicharRange            bool // UNICHAR rejects every code point above 55295 and returns NUL below 1: UNICHAR(8364) = "€" but UNICHAR(57344), UNICHAR(65533), UNICHAR(128512) and UNICHAR(1114111) = #VALUE!, UNICHAR(0.5) = "\x00" (want #VALUE!)
+	findWildcards           bool // FIND treats ? and * as wildcards like SEARCH: FIND("?","abc") = 1 (want #VALUE!), FIND("a*","xabc") = 2 (want #VALUE!)
+	searchEscapes           bool // SEARCH has no tilde escape and lets regular-expression syntax through when a wildcard is present: SEARCH("~?","a?c") = #VALUE! (want 2), SEARCH("~~","a~c") = #VALUE! (want 2), SEARCH("a{2}*","aa") = #VALUE! (want 1), SEARCH("\d*","a1b") = 1 (want #VALUE!)
+	findStartNum            bool // FIND and SEARCH accept start_num 0 and a start beyond the text with an empty find_text: FIND("a","abc",0) = 1 (want #VALUE!), FIND("","abc",5) = 5 (want #VALUE!)
+	textjoinLogical         bool // TEXTJOIN takes only a literal TRUE/FALSE as ignore_empty: TEXTJOIN(",",1,"a","b") = #VALUE! (want "a,b"), TEXTJOIN(",","TRUE","a","b") = #VALUE!
+	textAfterBytes          bool // TEXTAFTER and TEXTBEFORE find the delimiter by byte offset and cut by character: TEXTAFTER("héllo","é") = "lo" (want "llo"), TEXTBEFORE("héllo","l") = "hél" (want "hé")
+	textAfterNotFound       bool // TEXTAFTER and TEXTBEFORE return an empty text where the delimiter or its instance does not exist: TEXTAFTER("a-b-c","x") = "" (want #N/A), TEXTAFTER("a-b-c","-",3) = "" (want #N/A), TEXTBEFORE("abc","B") = "" (want #N/A)
+	valueParsing            bool // VALUE parses with big.Float and strips every comma: VALUE("12,34") = 1234 and VALUE(",1") = 1 (want #VALUE!), VALUE("0x10") = 16, VALUE("0b101") = 5, VALUE("1_000") = 1000, VALUE("inf") = +INF, VALUE("1e400") = +INF (want #VALUE!); VALUE(" 12 ") = #VALUE! (want 12)
+	textRounding            bool // TEXT rounds the binary value where Excel rounds the 15-digit decimal: TEXT(1.005,"0.00") = "1.00" (want "1.01"), TEXT(2.345,"0.00") = "2.35" is right by luck
+	ifTruthiness            bool // IF and IFS treat only the number 1 as TRUE: IF(2,1,0) = 0 (want 1), IFS(0.5,2) = #N/A (want 2), IF(-1,"y","n") = "n" (want "y")
+	logicalText             bool // text logical values are coerced inconsistently: XOR("TRUE") = #VALUE! (want TRUE), IF("1",1,0) = 1 and FIXED(1,0,"0") = "1" (want #VALUE!: only TRUE and FALSE texts are logical), AND("true") = #VALUE! where NOT("true") = FALSE
+	ifOmittedFalse          bool // IF without value_if_false returns an empty text where Excel returns FALSE: IF(0,"y") = "" (want FALSE)
+	isEvenOdd               bool // ISEVEN is TRUE for every odd number except 1, and ISEVEN/ISODD accept a boolean: ISEVEN(3) = TRUE (want FALSE), ISEVEN(-1) = TRUE (want FALSE), ISEVEN(1.8) = TRUE (want FALSE), ISEVEN(TRUE) = FALSE (want #VALUE!), ISODD(NA()) = FALSE (want #N/A)
+	textNumbersAsValues     bool // ISTEXT, N, ISLOGICAL and ISNUMBER go by a value's content, not its type: ISTEXT("1") = FALSE (want TRUE), N("1") = 1 (want 0), ISLOGICAL("TRUE") = TRUE (want FALSE), ISNUMBER(TRUE) = TRUE (want FALSE)
+	switchComparison        bool // SWITCH compares the texts of its values, so a number matches its text and letter case matters: SWITCH(1,"1","a","d") = "a" (want "d"), SWITCH("A","a",1,"d") = "d" (want 1)
+	ifResultTypes           bool // IF returns a boolean result as 1 or 0 and an error result as its text without the error: IF(FALSE,"x",TRUE) = 1 (want TRUE), IF(TRUE,NA(),1) = the text #N/A with no error (want the #N/A error)
+	orArgsSkipped           bool // OR returns at its first non-zero number or its first range argument without reading the rest: OR(1,"x") = TRUE (want #VALUE!), OR(FALSE,A1:A1,TRUE) with A1 = 0 is FALSE (want TRUE); a zero after a TRUE text resets the result: OR("TRUE",FALSE) = FALSE (want TRUE); AND returns at a FALSE text or a range holding a zero: AND("FALSE","x") = FALSE and AND(A1:A2,"x") with a 0 in A = FALSE (want #VALUE!)
+	fixedNoCommas           bool // FIXED reads the type flag of its no_commas argument instead of its value, so any third argument drops the thousands separators: FIXED(1234.5,1,FALSE) = "1234.5" and FIXED(1234.5,1,0) = "1234.5" (want "1,234.5")
+	textAfterReverse        bool // TEXTAFTER and TEXTBEFORE searching backwards skip a delimiter that directly precedes the one just found: TEXTAFTER("a--b","-",-2) = "" (want "-b"), TEXTBEFORE("Ypp","p",-2) = "" (want "Y")
+	textAfterPanic          bool // TEXTAFTER and TEXTBEFORE panic with a slice bound below zero when a backward search finds the delimiter at the start of the text and looks for another: TEXTAFTER("abc","a",-2,0,TRUE) and TEXTBEFORE("bcb,","bc",-3) panic (want "abc" and #N/A)
+	yearfracFebEnd          bool // YEARFRAC basis 0 does not shorten an end day of 31 after the start day at the end of February was moved to 30: YEARFRAC(DATE(2019,2,28),DATE(2020,1,31),0) = 0.919444444444444 (want 0.916666666666667)
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
