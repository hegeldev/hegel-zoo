+	oracle := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		name := hzPick(ht, hzLogicFuncs)
+		args := hzGenLogicArgs(ht, name)
+		if hzTextAvoid(name, args) {
+			return
+		}
