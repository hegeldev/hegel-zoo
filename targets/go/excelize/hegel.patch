+package hegel
+
+// TestHegelMath: the mathematical and trigonometric functions on literal arguments agree with
+// their definitions (Python math, with Excel's decimal rounding rules for the rounding family),
+// and ARABIC(ROMAN(n, form)) and DECIMAL(BASE(n, radix), radix) round-trip.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// A spec is "NAME kind kind? kind*": one kind per argument, ? optional, * one to six of them.
+var hzMathSpecs = strings.Fields(`
+ABS:x ACOS:unit ACOSH:x ACOT:x ACOTH:x ASIN:unit ASINH:x ATAN:x ATANH:unit ATAN2:x,x
+BASE:nat53,radix,minlen? CEILING:x,sig CEILING.MATH:x,sig?,mode? CEILING.PRECISE:x,sig? ISO.CEILING:x,sig?
+COMBIN:nat,nat COMBINA:nat,nat PERMUT:nat,nat PERMUTATIONA:nat,nat MULTINOMIAL:nat*
+COS:angle COSH:x COT:angle COTH:x CSC:angle CSCH:x SEC:angle SECH:x SIN:angle SINH:x TAN:angle TANH:x
+DECIMAL:text36,radix DEGREES:x RADIANS:x EVEN:x ODD:x EXP:x FACT:nat200 FACTDOUBLE:nat200
+FLOOR:x,sig FLOOR.MATH:x,sig?,mode? FLOOR.PRECISE:x,sig? GCD:nat* LCM:nat* INT:x
+LN:x LOG:x,x? LOG10:x MOD:x,x MROUND:x,sig PI: POWER:x,expo PRODUCT:x* QUOTIENT:x,x
+ROMAN:roman,form? ROUND:x,digits ROUNDDOWN:x,digits ROUNDUP:x,digits TRUNC:x,digits?
+SERIESSUM:x,int,int,arr SIGN:x SQRT:x SQRTPI:x SUM:x* SUMSQ:x* AVERAGE:x* HARMEAN:pos* AVEDEV:x*
+`)
+
+var hzDigits36 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+// hzGenArg draws an argument of the given kind.
+func hzGenArg(tc hegel.TestCase, kind string) hzArg {
+	switch kind {
+	case "x":
+		return hzN(hzGenNum(tc))
+	case "pos":
+		return hzN(hzGenPos(tc))
+	case "unit":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1, -1, 1.5, -2, 1.0000001}))
+		}
+		return hzN(float64(hzDrawInt(tc, -1000, 1000)) / 1000)
+	case "angle":
+		return hzN(float64(hzDrawInt(tc, -20000, 20000)) / 1000)
+	case "int":
+		return hzN(float64(hzDrawInt(tc, -50, 50)))
+	case "nat":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, 2.5, 0.5, -2}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 30)))
+	case "nat200":
+		if hzChance(tc, 15) {
+			return hzN(float64(hzDrawInt(tc, 160, 200)))
+		}
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, -2, 2.5, 170.9, 0.5}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 40)))
+	case "nat53":
+		switch hzDrawInt(tc, 0, 5) {
+		case 0:
+			return hzN(hzPick(tc, []float64{0, 1, 4294967295, 4294967296, 9007199254740991, 9007199254740992, -1, 2.5}))
+		case 1:
+			return hzN(float64(hzDrawInt(tc, 1, 1<<30)) * float64(hzDrawInt(tc, 1, 1<<22)))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 100000)))
+	case "digits":
+		if hzChance(tc, 25) {
+			return hzN(float64(hzDrawInt(tc, -6, -1)))
+		}
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1.5, -1.5, 2.9, 15}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 8)))
+	case "sig":
+		return hzN(hzPick(tc, []float64{1, 2, 5, 10, 100, 1000, 0.5, 0.25, 0.1, 0.01, 0.001, 0.2, 3, 7, -1, -2, -0.5, -0.1, 0}))
+	case "mode":
+		return hzN(hzPick(tc, []float64{0, 1, -1, 2, 0.5, -3}))
+	case "radix":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{1, 37, 0, -2, 2.5, 16.9}))
+		}
+		return hzN(float64(hzDrawInt(tc, 2, 36)))
+	case "minlen":
+		if hzChance(tc, 10) {
+			return hzN(hzPick(tc, []float64{-1, 256, 2.7}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 20)))
+	case "roman":
+		if hzChance(tc, 5) {
+			return hzN(hzPick(tc, []float64{4000, -1, 3999.9, 0}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 3999)))
+	case "form":
+		if hzChance(tc, 15) {
+			return hzB(hzGenBool(tc))
+		}
+		if hzChance(tc, 5) {
+			return hzN(hzPick(tc, []float64{5, -1, 2.5}))
+		}
+		return hzN(float64(hzDrawInt(tc, 0, 4)))
+	case "text36":
+		n := hzDrawInt(tc, 1, 8)
+		var sb strings.Builder
+		for i := 0; i < n; i++ {
+			c := hzDigits36[hzDrawInt(tc, 0, len(hzDigits36)-1)]
+			if hzChance(tc, 20) {
+				c = strings.ToLower(string(c))[0]
+			}
+			sb.WriteByte(c)
+		}
+		return hzS(sb.String())
+	case "expo":
+		return hzN(hzPick(tc, []float64{0, 1, 2, 3, -1, -2, 0.5, -0.5, 2.5, 1.0 / 3, 10, 0.25, -3, 4}))
+	case "arr":
+		return hzA(hzGenSeries(tc, hzDrawInt(tc, 1, 6)))
+	}
+	panic("unknown kind " + kind)
+}
+
+// hzGenArgs draws the arguments of a spec.
+func hzGenArgs(tc hegel.TestCase, spec string) []hzArg {
+	var args []hzArg
+	if spec == "" {
+		return args
+	}
+	for _, kind := range strings.Split(spec, ",") {
+		switch {
+		case strings.HasSuffix(kind, "?"):
+			if hzChance(tc, 50) {
+				return args
+			}
+			args = append(args, hzGenArg(tc, strings.TrimSuffix(kind, "?")))
+		case strings.HasSuffix(kind, "*"):
+			n := hzDrawInt(tc, 1, 6)
+			for i := 0; i < n; i++ {
+				args = append(args, hzGenArg(tc, strings.TrimSuffix(kind, "*")))
+			}
+		default:
+			args = append(args, hzGenArg(tc, kind))
+		}
+	}
+	return args
+}
+
+func hzSplitSpec(spec string) (string, string) {
+	i := strings.Index(spec, ":")
+	return spec[:i], spec[i+1:]
+}
+
+// hzCheckSpec draws a spec's arguments, evaluates the formula and judges it against the
+// oracle.
+func hzCheckSpec(t *testing.T, o *hzOracle, col *hzCollector, ht *hegel.T, spec string, rtol, atol float64) {
+	name, kinds := hzSplitSpec(spec)
+	args := hzGenArgs(ht, kinds)
+	if hzMathAvoid(name, args) {
+		return
+	}
+	if (name == "COMBIN" || name == "COMBINA") && HZKnown.combinRounding {
+		hzAvoid("combinRounding")
+		atol = 1
+	}
+	if name == "ACOT" {
+		rtol = 1e-9 // pi/2 - atan(x) in the target cancels for large x
+	}
+	switch name { // binary sums cancel against the largest term
+	case "SUM", "AVERAGE":
+		atol = 1e-12 * hzScale(args)
+	case "SUMSQ":
+		atol = 1e-12 * hzScale(args) * hzScale(args)
+	}
+	formula, cells := hzFormula(name, args)
+	want, err := o.eval(name, args)
+	if err != nil {
+		t.Fatalf("%s: %v", formula, err)
+	}
+	hzJudge(col, ht, name, hzDesc(formula, cells), hzCalc(formula, cells), want, rtol, atol)
+}
+
+// hzNearInteger: y is within rounding of an integer (the binary truncation of an exact decimal
+// goes one unit low).
+func hzNearInteger(y float64) bool {
+	r := math.Round(y)
+	return math.Abs(y-r) < 1e-9*math.Max(math.Abs(y), 1)
+}
+
+// hzBinaryQuotient: number / significance (times unit: 2 for MROUND's halves) is within
+// rounding of an integer without being one, so the target's binary floor, ceiling or rounding
+// of it is off by one unit (truncBinary).
+func hzBinaryQuotient(args []hzArg, unit float64) bool {
+	if !HZKnown.truncBinary || len(args) < 2 || args[1].num == 0 {
+		return false
+	}
+	q := unit * args[0].num / args[1].num
+	return q != math.Round(q) && hzNearInteger(q)
+}
+
+// hzScale: the largest magnitude among the arguments.
+func hzScale(args []hzArg) float64 {
+	s := 0.0
+	for _, a := range args {
+		s = math.Max(s, math.Abs(a.num))
+		for _, v := range a.arr {
+			s = math.Max(s, math.Abs(v))
+		}
+	}
+	return s
+}
+
+// hzTruncShortcut: TRUNC's shortcut fires (the fractional digits, trailing zeros stripped, are
+// below 10^(digits-1)) and the truncation would have changed the number.
+func hzTruncShortcut(x, digits float64) bool {
+	adjust := math.Pow(10, math.Floor(digits))
+	if x*adjust == math.Trunc(x*adjust) {
+		return false
+	}
+	d := int((math.Abs(x) - math.Trunc(math.Abs(x))) * adjust)
+	rtrim := 0.0
+	if d != 0 {
+		rtrim, _ = strconv.ParseFloat(strings.TrimRight(strconv.Itoa(d), "0"), 64)
+	}
+	return rtrim < adjust/10
+}
+
+// hzMathAvoid: the case reaches a recorded bug whose switch is on.
+func hzMathAvoid(name string, args []hzArg) bool {
+	avoid := func(sw string) bool { hzAvoid(sw); return true }
+	num := func(i int) float64 { return args[i].num }
+	switch name {
+	case "SEC":
+		if HZKnown.secIsCos {
+			return avoid("secIsCos")
+		}
+	case "ODD":
+		if HZKnown.oddUnit && num(0) > 0 && num(0) < 1 {
+			return avoid("oddUnit")
+		}
+	case "ROUND", "ROUNDUP", "ROUNDDOWN", "TRUNC":
+		if HZKnown.roundFractionalDigits && len(args) > 1 && num(1) != math.Trunc(num(1)) {
+			return avoid("roundFractionalDigits")
+		}
+		if HZKnown.truncBinary && (name == "ROUNDDOWN" || name == "TRUNC") && len(args) > 1 && num(1) > 0 && hzNearInteger(num(0)*math.Pow(10, num(1))) {
+			return avoid("truncBinary")
+		}
+		if HZKnown.truncLeadingZeros && name == "TRUNC" && len(args) > 1 && num(1) > 0 && hzTruncShortcut(num(0), num(1)) {
+			return avoid("truncLeadingZeros")
+		}
+	case "CEILING":
+		if HZKnown.ceilingFloorMath && num(1) == 0 {
+			return avoid("ceilingFloorMath")
+		}
+		if hzBinaryQuotient(args, 1) {
+			return avoid("truncBinary")
+		}
+	case "MULTINOMIAL", "GCD", "LCM", "PERMUT", "PERMUTATIONA":
+		for i, a := range args {
+			if HZKnown.negativeCounts && (name == "MULTINOMIAL" || i == 1) && a.num < 0 {
+				return avoid("negativeCounts")
+			}
+			if HZKnown.noTruncation && a.num != math.Trunc(a.num) {
+				return avoid("noTruncation")
+			}
+		}
+	case "DECIMAL":
+		if HZKnown.noTruncation && num(1) != math.Trunc(num(1)) {
+			return avoid("noTruncation")
+		}
+		if HZKnown.baseChecks && num(1) == 0 {
+			return avoid("baseChecks")
+		}
+	case "FLOOR":
+		if HZKnown.ceilingFloorMath && num(0) == 0 && num(1) < 0 {
+			return avoid("ceilingFloorMath")
+		}
+		if hzBinaryQuotient(args, 1) {
+			return avoid("truncBinary")
+		}
+	case "CEILING.PRECISE", "FLOOR.PRECISE", "ISO.CEILING":
+		if hzBinaryQuotient(args, 1) {
+			return avoid("truncBinary")
+		}
+	case "MROUND":
+		if hzBinaryQuotient(args, 2) {
+			return avoid("truncBinary")
+		}
+	case "ATAN2":
+		if HZKnown.zeroArguments && num(0) == 0 && num(1) == 0 {
+			return avoid("zeroArguments")
+		}
+	case "CEILING.MATH", "FLOOR.MATH":
+		if HZKnown.ceilingFloorMath && (len(args) == 3 || (len(args) == 2 && num(1) <= 0)) {
+			return avoid("ceilingFloorMath")
+		}
+		if hzBinaryQuotient(args, 1) {
+			return avoid("truncBinary")
+		}
+	case "DEGREES":
+		if HZKnown.zeroArguments && num(0) == 0 {
+			return avoid("zeroArguments")
+		}
+	case "COTH":
+		if HZKnown.hyperbolicOverflow && (math.Abs(num(0)) >= 710 || math.Abs(num(0)) < 0.01) {
+			return avoid("hyperbolicOverflow")
+		}
+	case "ROMAN":
+		if HZKnown.romanArgs && (num(0) < 0 || num(0) >= 4000 || len(args) == 2 && (args[1].kind == 'b' && args[1].b || args[1].kind == 'n' && (num(1) < 0 || num(1) >= 5))) {
+			return avoid("romanArgs")
+		}
+	case "BASE":
+		if HZKnown.baseChecks && (len(args) == 3 && (num(2) < 0 || num(2) > 255) || num(0) >= 1<<53 || num(0) < 0) {
+			return avoid("baseChecks")
+		}
+		for _, a := range args[1:] {
+			if HZKnown.noTruncation && a.num != math.Trunc(a.num) {
+				return avoid("noTruncation")
+			}
+		}
+	case "COMBIN", "COMBINA":
+		if HZKnown.negativeCounts && num(1) < 0 {
+			return avoid("negativeCounts")
+		}
+	}
+	return false
+}
+
+func TestHegelMath(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		spec := hzPick(ht, hzMathSpecs)
+		name, _ := hzSplitSpec(spec)
+		hzCheckSpec(t, o, col, ht, spec, 1e-12, 0)
+
+		switch name {
+		case "ROMAN":
+			// ARABIC(ROMAN(n, form)) = n for every form
+			n := hzDrawInt(ht, 1, 3999)
+			form := hzDrawInt(ht, 0, 4)
+			formula := fmt.Sprintf("ARABIC(ROMAN(%d,%d))", n, form)
+			got := hzCalc(formula, nil)
+			hzJudge(col, ht, "ARABIC", formula, got, hzExpect{t: "n", num: float64(n)}, 0, 0)
+		case "BASE":
+			// DECIMAL(BASE(n, radix), radix) = n
+			n := hzGenArg(ht, "nat53").num
+			if n < 0 || n != math.Trunc(n) || n >= 1<<53 {
+				n = float64(hzDrawInt(ht, 0, 1<<30))
+			}
+			radix := hzDrawInt(ht, 2, 36)
+			formula := fmt.Sprintf("DECIMAL(BASE(%s,%d),%d)", hzNumLit(n), radix, radix)
+			got := hzCalc(formula, nil)
+			hzJudge(col, ht, "DECIMAL", formula, got, hzExpect{t: "n", num: n}, 1e-14, 0) // 15 significant digits
+		}
+		col.count("cases")
+	})
+}
