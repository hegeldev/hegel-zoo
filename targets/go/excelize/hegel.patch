+// --------------------------------------------------------------------------- the library's arithmetic
+
+// The pieces of calc.go whose failure decides a shape, replicated so that the classifier can
+// tell from the arguments alone: the 33-term incomplete gamma series (excelize/27 and the
+// searches of excelize/13 over it), the factor arithmetic of the densities and the discrete
+// distributions (excelize/32, and the underflowing powers of excelize/85), the normal tail
+// (excelize/11) and the cancellation of the inverse F (excelize/84); with the true functions
+// they are compared with (the regularised incomplete gamma and beta, verified against the
+// oracle to 3e-13 on 2000 points).
+
+// libIncompleteGamma is calc.go's incompleteGamma(a, x) over Gamma(a): the regularised lower
+// incomplete gamma as the series sum_{n=0}^{32} x^n / (a (a+1) ... (a+n)) times x^a e^-x.
+func libIncompleteGamma(a, x float64) float64 {
+	summer := 0.0
+	for n := 0; n <= 32; n++ {
+		divisor := a
+		for i := 1; i <= n; i++ {
+			divisor *= a + float64(i)
+		}
+		summer += math.Pow(x, float64(n)) / divisor
+	}
+	return math.Exp(math.FMA(a, math.Log(x), -x)) * summer / math.Gamma(a)
+}
+
+// regLowerGamma is P(a, x), the regularised lower incomplete gamma: the series to
+// convergence below a + 1, the continued fraction above (Numerical Recipes' gammp).
+func regLowerGamma(a, x float64) float64 {
+	if x <= 0 {
+		return 0
+	}
+	if x < a+1 {
+		lg, _ := math.Lgamma(a)
+		ap, sum := a, 1/a
+		del := sum
+		for n := 0; n < 100000; n++ {
+			ap++
+			del *= x / ap
+			sum += del
+			if math.Abs(del) < math.Abs(sum)*1e-17 {
+				break
+			}
+		}
+		return sum * math.Exp(-x+a*math.Log(x)-lg)
+	}
+	return 1 - regUpperGamma(a, x)
+}
+
+// regUpperGamma is Q(a, x) = 1 - P(a, x), the continued fraction from a + 1 up.
+func regUpperGamma(a, x float64) float64 {
+	if x < a+1 {
+		return 1 - regLowerGamma(a, x)
+	}
+	lg, _ := math.Lgamma(a)
+	const fpmin = 1e-300
+	b := x + 1 - a
+	c := 1 / fpmin
+	d := 1 / b
+	h := d
+	for i := 1; i < 100000; i++ {
+		an := -float64(i) * (float64(i) - a)
+		b += 2
+		d = an*d + b
+		if math.Abs(d) < fpmin {
+			d = fpmin
+		}
+		c = b + an/c
+		if math.Abs(c) < fpmin {
+			c = fpmin
+		}
+		d = 1 / d
+		del := d * c
+		h *= del
+		if math.Abs(del-1) < 1e-17 {
+			break
+		}
+	}
+	return math.Exp(-x+a*math.Log(x)-lg) * h
+}
+
+// regIncBeta is I_x(a, b), the regularised incomplete beta (Numerical Recipes' betai).
+func regIncBeta(x, a, b float64) float64 {
+	if x <= 0 {
+		return 0
+	}
+	if x >= 1 {
+		return 1
+	}
+	la, _ := math.Lgamma(a)
+	lb, _ := math.Lgamma(b)
+	lab, _ := math.Lgamma(a + b)
+	bt := math.Exp(lab - la - lb + a*math.Log(x) + b*math.Log(1-x))
+	if x < (a+1)/(a+b+2) {
+		return bt * betacf(x, a, b) / a
+	}
+	return 1 - bt*betacf(1-x, b, a)/b
+}
+
+// betacf is the continued fraction of regIncBeta.
+func betacf(x, a, b float64) float64 {
+	const fpmin = 1e-300
+	qab, qap, qam := a+b, a+1, a-1
+	c, d := 1.0, 1-qab*x/qap
+	if math.Abs(d) < fpmin {
+		d = fpmin
+	}
+	d = 1 / d
+	h := d
+	for m := 1; m <= 100000; m++ {
+		fm := float64(m)
+		m2 := 2 * fm
+		aa := fm * (b - fm) * x / ((qam + m2) * (a + m2))
+		d = 1 + aa*d
+		if math.Abs(d) < fpmin {
+			d = fpmin
+		}
+		c = 1 + aa/c
+		if math.Abs(c) < fpmin {
+			c = fpmin
+		}
+		d = 1 / d
+		h *= d * c
+		aa = -(a + fm) * (qab + fm) * x / ((a + m2) * (qap + m2))
+		d = 1 + aa*d
+		if math.Abs(d) < fpmin {
+			d = fpmin
+		}
+		c = 1 + aa/c
+		if math.Abs(c) < fpmin {
+			c = fpmin
+		}
+		d = 1 / d
+		del := d * c
+		h *= del
+		if math.Abs(del-1) < 1e-16 {
+			break
+		}
+	}
+	return h
+}
+
+// gammaSeriesTruncated: the 33-term series misses the regularised lower incomplete gamma at
+// (a, x) by more than the model's tolerance (excelize/27; the exact shape: on a grid of 867
+// points the predicate and the verdict agree on every one).
+func gammaSeriesTruncated(a, x float64) bool {
+	return !hzClose(libIncompleteGamma(a, x), regLowerGamma(a, x), 1e-8, 1e-15)
+}
+
+// normInv is the standard normal quantile, by bisection on the upper tail (for the overflow
+// rule of LOGNORM.INV only).
+func normInv(p float64) float64 {
+	lo, hi := -40.0, 40.0
+	for i := 0; i < 200; i++ {
+		mid := (lo + hi) / 2
+		if 0.5*math.Erfc(-mid/math.Sqrt2) < p {
+			lo = mid
+		} else {
+			hi = mid
+		}
+	}
+	return (lo + hi) / 2
+}
+
+// normalTailLost: the cumulative normal at z, as 0.5 (1 + erf(z / sqrt 2)), is off by its
+// cancellation (about 1e-16 absolute, the whole value once the sum reaches 0 from z = -8.3)
+// relative to the true value tail by more than the given share.
+func normalTailLost(z, tail, share float64) bool {
+	err := 1.1e-16
+	if z < -8.3 {
+		err = 0.5 * math.Erfc(-z/math.Sqrt2)
+	}
+	return tail > 0 && err/tail > share
+}
+
+// betaTailOf: the true value of a cumulative the library builds as 1 - getBetaDist(...)
+// with the incomplete beta reflected (1 - (1 - r): the rounding is uniform in [0, 1.1e-16],
+// so a value w misses rtol 1e-8 with probability 1 - w / 1.1e-8, always below 1e-10 and
+// half the time at 5e-9; excelize/11): cumulative F.DIST, F.DIST.RT and FDIST, and
+// cumulative NEGBINOM.DIST; -1 for any other case or an invalid one.
+func betaTailOf(c distCase) float64 {
+	a := c.args
+	n := len(a)
+	arg := func(i int) float64 {
+		if i < n {
+			return a[i].num
+		}
+		return 0
+	}
+	cum := n > 0 && a[n-1].kind == 'b' && a[n-1].b
+	switch c.name {
+	case "F.DIST":
+		if cum && arg(0) > 0 && arg(1) >= 1 && arg(2) >= 1 {
+			return regIncBeta(arg(1)*arg(0)/(arg(1)*arg(0)+arg(2)), arg(1)/2, arg(2)/2)
+		}
+	case "F.DIST.RT", "FDIST":
+		if arg(0) > 0 && arg(1) >= 1 && arg(2) >= 1 {
+			return regIncBeta(arg(2)/(arg(2)+arg(1)*arg(0)), arg(2)/2, arg(1)/2)
+		}
+	case "NEGBINOM.DIST":
+		if cum && arg(0) >= 0 && arg(1) >= 1 && arg(2) > 0 && arg(2) < 1 {
+			return regIncBeta(arg(2), arg(1), arg(0)+1)
+		}
+	}
+	return -1
+}
+
+// farTailShown: the cumulative normal at z can miss the tolerance (excelize/11: the rounding
+// of 0.5 (1 + erf) is uniform in [0, 1.1e-16], more than 1e-8 of Phi(z) only below z = -5.6,
+// 9 times in 10 at -6, always from -6.3 down), and the true value is above the judge's
+// absolute tolerance of 1e-300 (Phi(-37.1) is 1.5e-300: below that a 0 is within it).
+func farTailShown(z float64) bool { return z < -5.6 && z >= -37.1 }
+
+// chiRightTailLost: CHISQ.DIST.RT and CHIDIST at an odd df build the upper tail on
+// NORMSDIST(-sqrt x) (excelize/11 again; even df is exp(-x/2) times a polynomial, exact).
+func chiRightTailLost(x, df float64) bool {
+	return x > 0 && df >= 1 && math.Mod(df, 2) == 1 && normalTailLost(-math.Sqrt(x), regUpperGamma(df/2, x/2), 3e-9)
+}
+
+// unreal: an infinite or NaN intermediate.
+func unreal(v float64) bool { return math.IsInf(v, 0) || math.IsNaN(v) }
+
+// fDensityOverflows: calc.go's F density, Gamma((d1+d2)/2) / (Gamma(d1/2) Gamma(d2/2)) times
+// (d1/d2)^(d1/2) times x^((d1-2)/2) / (1 + d1 x / d2)^((d1+d2)/2), has an infinite or NaN
+// factor, or underflows to 0 (excelize/32; verified on a grid of 3969 points: every
+// mismatch is flagged, two of 1174 passes are, both a 0 the oracle gives 0 for too).
+func fDensityOverflows(x, d1, d2 float64) bool {
+	g := math.Gamma((d1+d2)/2) / (math.Gamma(d1/2) * math.Gamma(d2/2))
+	r := math.Pow(d1/d2, d1/2)
+	n := math.Pow(x, (d1-2)/2)
+	d := math.Pow(1+(d1/d2)*x, (d1+d2)/2)
+	v := g * r * (n / d)
+	l1, _ := math.Lgamma((d1 + d2) / 2)
+	l2, _ := math.Lgamma(d1 / 2)
+	l3, _ := math.Lgamma(d2 / 2)
+	logV := l1 - l2 - l3 + d1/2*math.Log(d1/d2) + (d1-2)/2*math.Log(x) - (d1+d2)/2*math.Log1p(d1/d2*x)
+	broken := unreal(math.Gamma((d1+d2)/2)) || unreal(g) || unreal(r) || unreal(n) || unreal(d) || v == 0
+	return unreal(v) || broken && representable(logV)
+}
+
+// gammaDensityOverflows: calc.go's gamma density, 1 / (beta^alpha Gamma(alpha)) times
+// x^(alpha-1) e^(-x/beta), has an infinite or NaN factor or underflows to 0 while the true
+// density is representable (a 0 for a density below 1e-300 is within the tolerance).
+func gammaDensityOverflows(x, a, b float64) bool {
+	g := math.Gamma(a)
+	pb := math.Pow(b, a)
+	px := math.Pow(x, a-1)
+	v := (1 / (pb * g)) * px * math.Exp(-x/b)
+	lg, _ := math.Lgamma(a)
+	logV := (a-1)*math.Log(x) - x/b - a*math.Log(b) - lg
+	broken := unreal(g) || unreal(pb) || unreal(pb*g) || unreal(px) || v == 0
+	return unreal(v) || broken && representable(logV)
+}
+
+// poissonOverflows: calc.go's POISSON, e^-mean mean^x / x! (the sum of the terms to x when
+// cumulative), has an infinite power (x ln mean above 709.78), a subnormal e^-mean with too
+// few bits (below 1e-315: measured, the result is 2e-7 off at a mean of 730 and 0.4% at
+// 740), or an infinite factorial (171! is +Inf: the term is 0) where the term is
+// representable, or where the terms from 171 lost from the sum are more than the tolerance.
+func poissonOverflows(x, mean float64, cum bool) bool {
+	if x*math.Log(mean) > 709.78 || math.Exp(-mean) < 1e-315 {
+		return true
+	}
+	logTerm := func(i float64) float64 {
+		lg, _ := math.Lgamma(i + 1)
+		return i*math.Log(mean) - mean - lg
+	}
+	if !cum {
+		return x >= 171 && representable(logTerm(x))
+	}
+	kept, lost := 0.0, 0.0
+	for i := 0.0; i <= math.Min(math.Floor(x), 2000); i++ {
+		if i < 171 {
+			kept += math.Exp(logTerm(i))
+		} else {
+			lost += math.Exp(logTerm(i))
+		}
+	}
+	return lost > 0 && !hzClose(kept, kept+lost, 1e-8, 1e-300)
+}
+
+// isInt: an integral value.
+func isInt(v float64) bool { return v == math.Trunc(v) }
+
+// representable: a log value above the judge's absolute tolerance (ln 1e-300 is -690.8): a
+// 0 for a true value below it is within the tolerance.
+func representable(logV float64) bool { return logV > -690 }
+
+// libBinom: calc.go's binomCoeff, fact(n) / (fact(k) fact(n - k)), with the factorial of a
+// negative or a fraction below 2 equal to 1 (libFact).
+func libBinom(n, k float64) float64 { return libFact(n) / (libFact(k) * libFact(n-k)) }
+
+// logBinom: ln C(n, k) for 0 <= k <= n, through log-gamma.
+func logBinom(n, k float64) float64 {
+	a, _ := math.Lgamma(n + 1)
+	b, _ := math.Lgamma(k + 1)
+	c, _ := math.Lgamma(n - k + 1)
+	return a - b - c
+}
+
+// hyperSumSpoiled: calc.go's cumulative HYPGEOM.DIST, the sum from i = 0 to x of
+// C(M, i) C(N - M, n - i) / C(N, n), misses the sum over the support (from n - N + M when
+// that is above 0) by more than the tolerance (excelize/14; the extra terms are of the order
+// of 1 / C(N, n): HYPGEOM.DIST(1,1,2,2,TRUE) is 1.5, HYPGEOM.DIST(17,21,17,37,TRUE) is
+// 1 + 3.7e-12 and passes; measured over the shifted supports with N to 40, 98 draws in 100
+// are spoiled).
+func hyperSumSpoiled(x, n, M, N float64) bool {
+	lib, want := 0.0, 0.0
+	for i := 0.0; i <= x; i++ {
+		lib += libBinom(M, i) * libBinom(N-M, n-i) / libBinom(N, n)
+		if i >= n-N+M && i <= n && i <= M {
+			want += math.Exp(logBinom(M, i) + logBinom(N-M, n-i) - logBinom(N, n))
+		}
+	}
+	return !hzClose(lib, want, 1e-8, 1e-300)
+}
+
+// binomialSpoiled: calc.go's binomial terms C(n, k) p^k (1 - p)^(n - k) for k from lo to hi,
+// summed, miss the sum of the true terms (through logarithms) by more than the tolerance: a
+// power underflows in math.Pow to 0 or to a subnormal with too few bits while the term is
+// representable (excelize/85; n below 171, where the factorial is finite). The replica is
+// the exact shape: on a grid of 7250 points over the subnormal range (q^m from 1e-306 to
+// 1e-326 at five q and three n, every form of BINOM.DIST, BINOMDIST and BINOM.DIST.RANGE) it
+// agrees with the oracle's verdict on every one but BINOM.DIST(38,120,0.9999,TRUE), where
+// SciPy's own cumulative underflows (the classifier excludes an oracle answer of 0).
+func binomialSpoiled(lo, hi, n, p float64) bool {
+	lib, want := 0.0, 0.0
+	for k := lo; k <= hi; k++ {
+		lib += libBinom(n, k) * math.Pow(p, k) * math.Pow(1-p, n-k)
+		want += math.Exp(logBinom(n, k) + k*math.Log(p) + (n-k)*math.Log1p(-p))
+	}
+	return !hzClose(lib, want, 1e-8, 1e-300)
+}
+
+// negbinomSpoiled: calc.go's negative binomial density C(f + s - 1, s - 1) p^s (1 - p)^f
+// misses the term through logarithms by more than the tolerance (excelize/85; verified
+// against the oracle on 2742 points of the subnormal range of either power: every one
+// agrees). The cumulative goes through the incomplete beta and is right.
+func negbinomSpoiled(f, s, p float64) bool {
+	lib := libBinom(f+s-1, s-1) * math.Pow(p, s) * math.Pow(1-p, f)
+	term := math.Exp(logBinom(f+s-1, s-1) + s*math.Log(p) + f*math.Log1p(-p))
+	return !hzClose(lib, term, 1e-8, 1e-300)
+}
+
+// betaQuantile: x with I_x(a, b) = q, by bisection in log x (the quantile the inverse F is
+// built on; 120 steps over [e^-720, 1]).
+func betaQuantile(q, a, b float64) float64 {
+	lo, hi := -720.0, 0.0
+	for i := 0; i < 120; i++ {
+		mid := (lo + hi) / 2
+		if regIncBeta(math.Exp(mid), a, b) < q {
+			lo = mid
+		} else {
+			hi = mid
+		}
+	}
+	return math.Exp((lo + hi) / 2)
+}
+
+// fInvCancels: calc.go's inverse F, (1 / calcBetainv(1 - q, d2/2, d1/2) - 1) d2 / d1 with q
+// the lower-tail probability (p for F.INV, 1 - p for F.INV.RT and FINV), can lose the
+// quantile to rounding (excelize/84). The beta quantile B' = I^-1_q(d1/2, d2/2) comes back
+// as 1 - B' on the grid of 1.1e-16 below 1 and is inverted on the grid of 2.2e-16 above it:
+// an absolute error of up to 1.67e-16 in B', uniform, so the result B' d2 / d1 misses 1e-7
+// relative with probability 1 - 6e-10 / B' (never above B' = 1.67e-9; measured on a grid of
+// 9750 points at rtol 1e-7, the largest failing B' is 2.3e-9 with the second term below).
+// F.INV alone also rounds q itself, in 1 - (1 - p) with p small (exact for the right-tailed
+// forms, where p is above 0.5): a deterministic error |1 - (1 - q) - q| / q, magnified by
+// 2 / d1 (B' goes as q^(2/d1)). The rule names the case when the two bounds together exceed
+// 1e-7: every failure of the grid is named, and of the cases named 21% pass (the grid's
+// decimal q at d1 = 2 round luckily); the drawn region keeps B' below 2e-11, where a pass
+// needs the roundings to align: measured over the region, none of 1026 cases at d1 = 1 and
+// 93 of 974 at d1 = 2 pass (there B' is 2q/d2 with q = 1 - p on the binary grid for the
+// right-tailed forms, and 1 - B' and its inverse are then often exact). A result below the
+// absolute tolerance is within it.
+func fInvCancels(name string, p, d1, d2 float64) bool {
+	q := p
+	if name != "F.INV" {
+		q = 1 - p
+	}
+	if !(q > 0 && q < 0.5 && d1 >= 1 && d2 >= 1) {
+		return false
+	}
+	b := betaQuantile(q, d1/2, d2/2)
+	if b*d2/d1 <= 1e-300 {
+		return false
+	}
+	rounding := 0.0
+	if name == "F.INV" {
+		rounded := 1 - (1 - q)
+		rounding = math.Abs(rounded-q) / q * 2 / d1
+	}
+	return rounding+1.67e-16/b > 1e-7
+}
+
+// --------------------------------------------------------------------------- the shapes of excelize/84 and 85
+
+// tinyFInv: p, d1, d2 for F.INV (lowerTail) or F.INV.RT and FINV (p = 1 - q) at a quantile
+// the cancellation loses (excelize/84): d1 = 1 with q in (1..100)/10^(8..10), where B' is
+// (q sqrt(pi) Gamma(d2/2) / (2 Gamma((d2+1)/2)))^2, at most 2.5e-12 (q = 1e-6, d2 = 1), or
+// d1 = 2 with q in (1..100)/10^13, where B' is 1 - (1 - q)^(2/d2), at most 2e-11; d2 in
+// 1..40. (A d1 of 3 or more reaches B' = 1.7e-9 only below q = 1e-13 at d2 = 40; with q to
+// 1e-5 and 1e-11 the region passed 7 times in 100, the lucky roundings at B' near 2e-10.)
+func tinyFInv(lowerTail bool) hegel.Generator[[]hzArg] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzArg {
+		d1 := hegel.Draw(tc, hzSampled(1.0, 2))
+		var q float64
+		if d1 == 1 {
+			q = hegel.Draw(tc, overTens(hzInts(1, 100), 8, 10))
+		} else {
+			q = hegel.Draw(tc, overTens(hzInts(1, 100), 13, 13))
+		}
+		d2 := float64(hegel.Draw(tc, hzInts(1, 40)))
+		p := q
+		if !lowerTail {
+			p = 1 - q
+		}
+		return []hzArg{hzN(p), hzN(d1), hzN(d2)}
+	})
+}
+
+var (
+	fInvArgs   = withShape(hzTuple(num(probabilities), num(degrees), num(degrees)), tinyFInv(true))
+	fInvRTArgs = withShape(hzTuple(num(probabilities), num(degrees), num(degrees)), tinyFInv(false))
+)
+
+// roundSig: v to three significant digits.
+func roundSig(v float64) float64 {
+	e := math.Pow(10, math.Floor(math.Log10(v))-2)
+	return math.Round(v/e) * e
+}
+
+// binomTerm: a binomial term C(n, x) p^x q^(n - x) whose power q^(n - x) underflows while
+// the term is representable (the shape of excelize/85): n in 100..170, x in 32..n/2 (so that
+// C(n, x) is at least 1e26) and q = 10^(-t/(n-x)) to three significant digits with t in
+// [320, 300 + log10 C(n, x) - 6]: q^(n-x) is below 1e-320 (math.Pow gives 0, or a subnormal
+// of 12 bits or fewer, 5e-4 of it) and C(n, x) q^(n-x) above 1e-294 (a term nearer 1e-300
+// is within the absolute tolerance even with a few bits lost: the window measured, 12 draws
+// in 100 at terms from 1e-298). The forms: p = 1 - q with x successes (the small count, p
+// near 1), or p = q with n - x successes (the mirror).
+type binomTerm struct{ n, x, q float64 }
+
+var underflowingTerm = hegel.Composite(func(tc hegel.TestCase) binomTerm {
+	n := hegel.Draw(tc, hzInts(100, 170))
+	x := hegel.Draw(tc, hzInts(32, n/2))
+	lc := logBinom(float64(n), float64(x)) / math.Ln10
+	t := 320 + float64(hegel.Draw(tc, hzInts(0, int(lc)-26)))
+	return binomTerm{float64(n), float64(x), roundSig(math.Pow(10, -t/float64(n-x)))}
+})
+
+// binomUnderflow: the arguments of BINOM.DIST and BINOMDIST over underflowingTerm: the
+// density in both forms and the cumulative in the p-near-1 form (its terms 0..x all underflow;
+// in the mirror the sum is dominated by the terms that do not), filtered on the replica (the
+// share kept quoted at the narrow property).
+var binomUnderflow = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	b := hegel.Draw(tc, underflowingTerm)
+	switch hegel.Draw(tc, hzInts(0, 2)) {
+	case 1:
+		return []hzArg{hzN(b.n - b.x), hzN(b.n), hzN(b.q), hzB(false)}
+	case 2:
+		return []hzArg{hzN(b.x), hzN(b.n), hzN(1 - b.q), hzB(true)}
+	}
+	return []hzArg{hzN(b.x), hzN(b.n), hzN(1 - b.q), hzB(false)}
+}), func(a []hzArg) bool {
+	lo := a[0].num
+	if a[3].b {
+		lo = 0
+	}
+	return binomialSpoiled(lo, a[0].num, a[1].num, a[2].num)
+})
+
+// binomRangeUnderflow: BINOM.DIST.RANGE over underflowingTerm in both forms, with number_s2
+// absent or number_s + 0..2 (the terms above number_s are larger by 1/q each: with number_s2
+// above number_s the sum is spoiled only where they underflow too), filtered on the replica.
+var binomRangeUnderflow = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	b := hegel.Draw(tc, underflowingTerm)
+	p, s := 1-b.q, b.x
+	if hegel.Draw(tc, hzCoin(50)) {
+		p, s = b.q, b.n-b.x
+	}
+	args := []hzArg{hzN(b.n), hzN(p), hzN(s)}
+	if extra := hegel.Draw(tc, hzInts(0, 3)); extra > 0 {
+		args = append(args, hzN(s+float64(extra)-1))
+	}
+	return args
+}), func(a []hzArg) bool {
+	s2 := a[2].num
+	if len(a) == 4 {
+		s2 = a[3].num
+	}
+	return binomialSpoiled(a[2].num, s2, a[0].num, a[1].num)
+})
+
+// negbinomTerm: f, s, p for the negative binomial density C(f + s - 1, s - 1) p^s (1 - p)^f
+// with one power underflowing while the term is representable: the many in 50..126 (the
+// failures at p = 1 - q, or the successes at p = q, the mirror), the few in 45..(171 - many)
+// (C(many + few - 1, few) at least 1e26), q = 10^(-t/many) to three significant digits with
+// t in [320, 300 + log10 C - 6] as for the binomial term.
+var negbinomTerm = hegel.Composite(func(tc hegel.TestCase) []float64 {
+	many := hegel.Draw(tc, hzInts(50, 126))
+	few := hegel.Draw(tc, hzInts(45, 171-many))
+	lc := logBinom(float64(many+few-1), float64(few)) / math.Ln10
+	t := 320 + float64(hegel.Draw(tc, hzInts(0, int(lc)-26)))
+	q := roundSig(math.Pow(10, -t/float64(many)))
+	if hegel.Draw(tc, hzCoin(50)) {
+		return []float64{float64(few), float64(many), q}
+	}
+	return []float64{float64(many), float64(few), 1 - q}
+})
+
+// negbinomUnderflow: f, s, p[, FALSE] over negbinomTerm, filtered on the replica.
+func negbinomUnderflow(withCum bool) hegel.Generator[[]hzArg] {
+	return hegel.Filter(hegel.Map(negbinomTerm, func(v []float64) []hzArg {
+		args := []hzArg{hzN(v[0]), hzN(v[1]), hzN(v[2])}
+		if withCum {
+			args = append(args, hzB(false))
+		}
+		return args
+	}), func(a []hzArg) bool { return negbinomSpoiled(a[0].num, a[1].num, a[2].num) })
+}
+
+var (
+	binomDistArgs   = withShape(hzTuple(num(smallCounts), num(smallCounts), num(probabilities), cumulatives), binomUnderflow)
+	binomRangeArgs  = withShape(hzSeq(hzTuple(num(smallCounts), num(probabilities), num(smallCounts)), hzMaybe(50, hzOne(num(smallCounts)))), binomRangeUnderflow)
+	negbinomNewArgs = withShape(hzTuple(num(smallCounts), num(smallCounts), num(probabilities), cumulatives), negbinomUnderflow(true))
+	negbinomOldArgs = withShape(hzTuple(num(smallCounts), num(smallCounts), num(probabilities)), negbinomUnderflow(false))
+)
+
+// --------------------------------------------------------------------------- the classifier
+
+// distShape: the recorded bug whose shape the case has, "" for none; the first name wins,
+// the most specific first. The fraction in a df, a count, a tails or an order (excelize/15)
+// comes first, everywhere the library uses it as it is; then the error codes (excelize/21),
+// for the cases whose true result is an error either way; then the overflows (excelize/30
+// in GAMMALN, excelize/32 in the discrete distributions and the densities) before the
+// infinities (excelize/10), which they produce; then the cancellations and underflows of the
+// inverse F (excelize/84) and the binomial powers (excelize/85, after the factorial overflow
+// of excelize/32 in the same functions, before the domain ends of excelize/25 in F.INV and
+// BINOM.DIST.RANGE and the far tail of excelize/11 in NEGBINOM.DIST, which they do not
+// overlap); the function-wide searches (excelize/13) before the series they search over
+// (excelize/27) and the domain ends they also miss (excelize/25); the hypergeometric sum
+// (excelize/14) after its factorial overflow; the domain ends (excelize/25) before the far
+// tails (excelize/11) and the inverse t's regions (excelize/26); the Bessel divergence
+// (excelize/28) last. The oracle's verdict want is unknown at draw time (the generators
+// filter on the classifier with an empty one) and is used in two rules only: for a region
+// never drawn then (the fractional Bessel orders), and to exclude an oracle answer of 0 from
+// excelize/85 (an empty verdict is not excluded, so the filter errs towards filtering).
+func distShape(c distCase, want hzExpect) string {
+	a := c.args
+	n := len(a)
+	arg := func(i int) float64 {
+		if i < n {
+			return a[i].num
+		}
+		return 0
+	}
+	cum := n > 0 && a[n-1].kind == 'b' && a[n-1].b
+	density := n > 0 && a[n-1].kind == 'b' && !a[n-1].b
+	fractional := func(i int) bool { return i < n && !isInt(a[i].num) }
+	switch c.name {
+	// excelize/15: a fractional df, count, tails or order used as it is; a df below 1 accepted
+	case "T.DIST":
+		if fractional(1) && (arg(1) >= 1 || density && arg(1) > 0) {
+			return "excelize/15" // the density accepts a df in (0, 1) too (want #NUM!)
+		}
+	case "T.DIST.2T", "T.DIST.RT", "T.INV", "T.INV.2T", "TINV", "CHISQ.DIST", "CHISQ.INV", "CHISQ.INV.RT", "CHIINV":
+		if fractional(1) && arg(1) >= 1 {
+			return "excelize/15" // (a df below 1 is #NUM! either way)
+		}
+	case "TDIST":
+		if (fractional(1) || fractional(2)) && arg(0) >= 0 && arg(1) >= 1 && arg(2) >= 1 && arg(2) < 3 {
+			return "excelize/15" // (a negative x or tails outside [1, 3) are #NUM! either way)
+		}
+	case "CHISQ.DIST.RT", "CHIDIST":
+		if arg(1) < 1 {
+			return "excelize/15" // CHIDIST(1.094,0.5) = 0 and CHIDIST(5,0) = 0, want #NUM! (a fractional df from 1 is truncated, right)
+		}
+	case "F.DIST", "F.DIST.RT", "F.INV", "F.INV.RT", "FDIST", "FINV":
+		if (fractional(1) || fractional(2)) && arg(1) >= 1 && arg(2) >= 1 {
+			return "excelize/15" // (a df below 1 is #NUM! either way)
+		}
+	case "POISSON", "POISSON.DIST":
+		if density && fractional(0) {
+			return "excelize/15" // the cumulative sums to floor(x) and is right
+		}
+	case "BINOM.DIST", "BINOMDIST":
+		if fractional(1) || fractional(0) && !cum {
+			return "excelize/15" // the cumulative sums to int(s) and is right
+		}
+	case "NEGBINOM.DIST", "NEGBINOMDIST":
+		if arg(1) >= 1 && (fractional(0) || fractional(1)) {
+			return "excelize/15" // (s below 1 is #NUM! either way)
+		}
+	case "BINOM.DIST.RANGE":
+		if fractional(0) || fractional(2) || fractional(3) {
+			return "excelize/15"
+		}
+	case "HYPGEOM.DIST", "HYPGEOMDIST":
+		if fractional(0) || fractional(1) || fractional(2) || fractional(3) {
+			return "excelize/15"
+		}
+	case "BESSELJ", "BESSELI":
+		if fractional(1) && !(want.t == "n" && math.Abs(want.num) < 1e-7) {
+			return "excelize/15" // BESSELJ(1,2.5) is neither order 2 nor 3 (a result below the absolute tolerance passes)
+		}
+	case "BESSELY", "BESSELK":
+		if fractional(1) && arg(1) >= 2 {
+			return "excelize/15" // the recurrence from the orders 0 and 1 runs to the order above (orders below 2 are those)
+		}
+	}
+	switch c.name {
+	// excelize/21: the error is right, the code is not the documented #NUM!
+	case "NORM.DIST", "NORMDIST":
+		if arg(2) < 0 {
+			return "excelize/21" // #N/A
+		}
+	case "NORM.INV", "NORMINV":
+		if arg(2) < 0 || arg(0) < 0 || arg(0) > 1 {
+			return "excelize/21" // #N/A
+		}
+	case "NORM.S.INV", "NORMSINV":
+		if arg(0) < 0 || arg(0) > 1 {
+			return "excelize/21" // #N/A (0 and 1 are #NUM!, as documented)
+		}
+	case "POISSON", "POISSON.DIST":
+		if arg(0) < 0 || arg(1) < 0 {
+			return "excelize/21" // #N/A
+		}
+	case "GAMMA":
+		if arg(0) <= 0 && isInt(arg(0)) {
+			return "excelize/21" // #N/A
+		}
+	case "GAMMALN":
+		if arg(0) <= 0 {
+			return "excelize/21" // #N/A
+		}
+	case "WEIBULL", "WEIBULL.DIST":
+		if arg(1) <= 0 || arg(2) <= 0 {
+			return "excelize/21" // #N/A
+		}
+	case "T.DIST":
+		if density && arg(1) == 0 {
+			return "excelize/21" // #DIV/0!
+		}
+	}
+	switch c.name {
+	// excelize/30: GAMMALN as log(math.Gamma(x)), +INF from 171.625
+	case "GAMMALN":
+		if math.IsInf(math.Gamma(arg(0)), 0) {
+			return "excelize/30"
+		}
+	// excelize/32: the factorials of counts above 170 and the gamma factors of the densities
+	case "BINOM.DIST", "BINOMDIST":
+		if arg(1) >= 171 {
+			return "excelize/32"
+		}
+	case "BINOM.DIST.RANGE":
+		if arg(0) >= 171 {
+			return "excelize/32"
+		}
+	case "HYPGEOM.DIST", "HYPGEOMDIST":
+		if arg(3) >= 171 {
+			return "excelize/32"
+		}
+	case "NEGBINOM.DIST", "NEGBINOMDIST":
+		if !cum && arg(0) >= 0 && arg(1) >= 1 && arg(0)+arg(1)-1 >= 171 {
+			return "excelize/32"
+		}
+	case "POISSON", "POISSON.DIST":
+		if arg(0) >= 0 && arg(1) > 0 && poissonOverflows(arg(0), arg(1), cum) {
+			return "excelize/32"
+		}
+	case "F.DIST":
+		if density && arg(0) > 0 && arg(1) >= 1 && arg(2) >= 1 && fDensityOverflows(arg(0), arg(1), arg(2)) {
+			return "excelize/32"
+		}
+	case "GAMMA.DIST", "GAMMADIST":
+		if density && arg(0) > 0 && arg(1) > 0 && arg(2) > 0 && gammaDensityOverflows(arg(0), arg(1), arg(2)) {
+			return "excelize/32"
+		}
+	}
+	switch c.name {
+	// excelize/10: an infinite result where the oracle has #NUM!
+	case "GAMMA":
+		if math.IsInf(math.Gamma(arg(0)), 0) {
+			return "excelize/10"
+		}
+	case "CHISQ.DIST":
+		if density && arg(0) == 0 && arg(1) == 1 {
+			return "excelize/10" // 1 / sqrt(2 pi x)
+		}
+	case "F.DIST":
+		if density && arg(0) == 0 && arg(1) == 1 && arg(2) >= 1 {
+			return "excelize/10" // x^((d1-2)/2)
+		}
+	case "GAMMA.DIST", "GAMMADIST", "WEIBULL", "WEIBULL.DIST":
+		if density && arg(0) == 0 && arg(1) > 0 && arg(1) < 1 && arg(2) > 0 {
+			return "excelize/10" // x^(alpha-1)
+		}
+	case "F.INV":
+		if arg(0) == 1 && arg(1) >= 1 && arg(2) >= 1 {
+			return "excelize/10" // 1 / betainv(0) - 1 (FINV at 1 is the lower end, 0, right)
+		}
+	case "BESSELI":
+		if arg(1) < 0 {
+			return "excelize/10" // the series over a negative order
+		}
+	case "BESSELJ":
+		if arg(0) == 0 && arg(1) < 0 {
+			return "excelize/10"
+		}
+	case "LOGNORM.INV", "LOGINV":
+		if arg(0) > 0 && arg(0) < 1 && arg(2) > 0 && arg(1)+arg(2)*normInv(arg(0)) > 709.78 {
+			return "excelize/10" // exp(mean + sd z)
+		}
+	}
+	switch c.name {
+	// excelize/84: the inverse F at a quantile the cancellation of 1 / betainv - 1 (and of
+	// F.INV's 1 - (1 - p)) loses (after the ends of its domain: p = 1 is excelize/10, p = 0
+	// excelize/25, both outside the rule)
+	case "F.INV", "F.INV.RT", "FINV":
+		if fInvCancels(c.name, arg(0), arg(1), arg(2)) {
+			return "excelize/84"
+		}
+	// excelize/85: a binomial power underflows in math.Pow while the term is representable
+	// (after the factorial overflow of excelize/32 at 171 trials; an oracle answer of 0 is
+	// SciPy's own cumulative underflow, within the tolerance, so not the shape)
+	case "BINOM.DIST", "BINOMDIST":
+		s, trials, p := arg(0), arg(1), arg(2)
+		lo := s
+		if cum {
+			lo, s = 0, math.Trunc(s)
+		}
+		if isInt(trials) && isInt(s) && s >= 0 && s <= trials && p > 0 && p < 1 && !(want.t == "n" && want.num == 0) && binomialSpoiled(lo, s, trials, p) {
+			return "excelize/85"
+		}
+	case "BINOM.DIST.RANGE":
+		trials, p, s, s2 := arg(0), arg(1), arg(2), arg(2)
+		if n == 4 {
+			s2 = arg(3)
+		}
+		if isInt(trials) && isInt(s) && isInt(s2) && s >= 0 && s <= s2 && s2 <= trials && p > 0 && p < 1 && !(want.t == "n" && want.num == 0) && binomialSpoiled(s, s2, trials, p) {
+			return "excelize/85"
+		}
+	case "NEGBINOM.DIST", "NEGBINOMDIST":
+		f, s, p := arg(0), arg(1), arg(2)
+		if !cum && isInt(f) && isInt(s) && f >= 0 && s >= 1 && p > 0 && p < 1 && !(want.t == "n" && want.num == 0) && negbinomSpoiled(f, s, p) {
+			return "excelize/85"
+		}
+	}
+	switch c.name {
+	// excelize/13: the searches over the truncated series return their bounds or converge
+	// poorly (function-wide: measured at rtol 1e-8, 38% of a grid over p and df fails for
+	// CHISQ.INV.RT, every p at or below 1e-4 for df 1..200, every df from 100; GAMMA.INV every
+	// p from 0.999 for alpha 3..100); BETA.INV's flat U-shaped region
+	case "CHISQ.INV.RT", "CHIINV", "GAMMA.INV", "GAMMAINV":
+		return "excelize/13"
+	case "BETA.INV", "BETAINV":
+		if arg(1) > 0 && arg(1) <= 0.1 && arg(2) > 0 && arg(2) <= 0.1 && arg(0) >= 0.2 && arg(0) <= 0.8 {
+			return "excelize/13"
+		}
+	// excelize/27: the cumulative gamma's 33-term series, truncated
+	case "GAMMA.DIST", "GAMMADIST":
+		if cum && arg(0) > 0 && arg(1) > 0 && arg(2) > 0 && gammaSeriesTruncated(arg(1), arg(0)/arg(2)) {
+			return "excelize/27"
+		}
+	// excelize/14: the cumulative hypergeometric sums from 0 below a support starting above it
+	case "HYPGEOM.DIST":
+		x, k, m, N := arg(0), arg(1), arg(2), arg(3)
+		if cum && N > 0 && k > 0 && k <= N && m > 0 && m <= N && k-N+m > 0 && x >= k-N+m && x <= math.Min(k, m) && hyperSumSpoiled(x, k, m, N) {
+			return "excelize/14"
+		}
+	// excelize/16: GAMMA of a negative non-integer is #N/A
+	case "GAMMA":
+		if arg(0) < 0 {
+			return "excelize/16"
+		}
+	}
+	switch c.name {
+	// excelize/25: the ends of the documented domains
+	case "NORM.DIST", "NORMDIST":
+		if cum && arg(2) == 0 && arg(0) != arg(1) {
+			return "excelize/25" // a value for sd 0 (want #NUM!; the density is #NUM!, and x = mean is NaN)
+		}
+	case "NORM.INV", "NORMINV":
+		if arg(2) == 0 && arg(0) > 0 && arg(0) < 1 {
+			return "excelize/25" // the mean for sd 0
+		}
+	case "CHISQ.DIST.RT", "CHIDIST":
+		if arg(0) < 0 && (math.Mod(arg(1), 2) == 0 || arg(1) == 1) {
+			return "excelize/25" // a value for a negative x at an even df or df 1 (an odd df from 3 is #NUM!)
+		}
+		if arg(0) == 0 && math.Mod(arg(1), 2) == 1 {
+			return "excelize/25" // #NUM! at 0 for an odd df (want 1)
+		}
+	case "CHISQ.DIST":
+		if density && arg(0) == 0 && arg(1) >= 3 && math.Mod(arg(1), 2) == 1 {
+			return "excelize/25" // #NUM! at 0 for an odd df above 1 (want 0)
+		}
+	case "POISSON", "POISSON.DIST":
+		if arg(1) == 0 && arg(0) >= 0 {
+			return "excelize/25" // #N/A for a mean of 0
+		}
+	case "WEIBULL", "WEIBULL.DIST":
+		if arg(0) < 0 && isInt(arg(1)) {
+			return "excelize/25" // a value for a negative x (a fractional alpha makes it NaN, #NUM!)
+		}
+	case "BINOM.INV", "CRITBINOM":
+		if arg(0) >= 0 && (arg(1) == 0 || arg(1) == 1) && arg(2) > 0 && arg(2) < 1 {
+			return "excelize/25" // #NUM! for p of 0 or 1
+		}
+	case "BINOM.DIST.RANGE":
+		if n == 4 && arg(0) >= 0 && arg(1) >= 0 && arg(1) <= 1 && arg(2) >= 0 && arg(2) <= arg(0) && arg(3) >= 0 && arg(3) < arg(2) {
+			return "excelize/25" // 0 for number_s2 below number_s
+		}
+	case "BETA.INV", "BETAINV":
+		if arg(0) == 1 && arg(1) > 0 && arg(2) > 0 && (n < 5 || arg(3) != arg(4)) {
+			return "excelize/25" // #NUM! at p = 1 (want the upper bound)
+		}
+	case "F.INV":
+		if arg(0) == 0 && arg(1) >= 1 && arg(2) >= 1 {
+			return "excelize/25" // #NUM! at p = 0 (want 0; FINV at 0 is the upper end, #NUM! as documented)
+		}
+	}
+	switch c.name {
+	// excelize/11: the far lower tail of the cumulative normal, and of the cumulatives built
+	// on it or on a 1 - I_x(a, b) that cancels
+	case "NORM.DIST", "NORMDIST":
+		if cum && arg(2) > 0 && farTailShown((arg(0)-arg(1))/arg(2)) {
+			return "excelize/11"
+		}
+	case "NORM.S.DIST":
+		if cum && farTailShown(arg(0)) {
+			return "excelize/11"
+		}
+	case "NORMSDIST":
+		if farTailShown(arg(0)) {
+			return "excelize/11"
+		}
+	case "LOGNORM.DIST", "LOGNORMDIST":
+		if (cum || c.name == "LOGNORMDIST") && arg(0) > 0 && arg(2) > 0 && farTailShown((math.Log(arg(0))-arg(1))/arg(2)) {
+			return "excelize/11"
+		}
+	case "F.DIST", "F.DIST.RT", "FDIST", "NEGBINOM.DIST":
+		if v := betaTailOf(c); v >= 0 && v < 1e-8 {
+			return "excelize/11"
+		}
+	case "CHISQ.DIST.RT", "CHIDIST":
+		if chiRightTailLost(arg(0), arg(1)) {
+			return "excelize/11"
+		}
+	// excelize/26: the inverse t's quantile near 0 (an absolute tolerance) and its far tail
+	case "T.INV":
+		if arg(1) >= 1 && arg(0) > 0 && arg(0) < 1 && (arg(0) != 0.5 && math.Abs(arg(0)-0.5) <= 1e-4 || arg(0) <= 1e-9 || arg(0) >= 1-1e-9) {
+			return "excelize/26"
+		}
+	case "T.INV.2T", "TINV":
+		if arg(1) >= 1 && arg(0) > 0 && arg(0) < 1 && 1-arg(0) <= 1e-4 {
+			return "excelize/26"
+		}
+	// excelize/28: BESSELJ's series beyond |x| = 25, BESSELY's asymptotic branch from x = 8
+	case "BESSELJ":
+		if arg(1) >= 0 && math.Abs(arg(0)) > 25.25+0.4*math.Max(0, arg(1)-5) {
+			return "excelize/28" // the first failure measured by halves: 25.5..26 at orders 0..4, 27.5 at 10, 29.5 at 15, 32.5 at 20, 38 at 30
+		}
+	case "BESSELY":
+		if arg(1) >= 1 && arg(0) >= 8 {
+			return "excelize/28"
+		}
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- the judge
+
+// distTolerance: the tolerances of the comparison (model facts, see the file comment).
+func distTolerance(c distCase) (rtol, atol float64) {
+	switch {
+	case strings.HasPrefix(c.name, "BESSEL"):
+		return 1e-6, 1e-7 // the recurrences of high orders; the zeros of Y
+	case strings.HasPrefix(c.name, "WEIBULL"), strings.HasPrefix(c.name, "EXPON"), c.name == "GAMMA.DIST", c.name == "GAMMADIST":
+		return 1e-8, 1e-15 // 1 - exp(-t) for a tiny t
+	}
+	switch c.name {
+	case "NORM.INV", "NORM.S.INV", "NORMINV", "NORMSINV", "LOGNORM.INV", "LOGINV", "T.INV", "T.INV.2T", "TINV":
+		return 1e-12, 1e-300
+	case "F.INV", "F.INV.RT", "FINV":
+		return 1e-7, 1e-300
+	}
+	return 1e-8, 1e-300
+}
+
+// distRelaxed: the check-level shapes: the tolerance a result of the function reaches when
+// the recorded bug is tolerated, and the bug. The inverse normals are Acklam's approximation
+// without its refinement, accurate to 1.15e-9 (excelize/12; NORM.INV, NORMINV, LOGNORM.INV
+// and LOGINV magnify the error of z by the mean and the scale, 1e-6 for them); the inverse
+// t converges to an absolute tolerance (excelize/26; measured over 1845 points, 7.4e-11 at
+// worst outside the regions the classifier names).
+func distRelaxed(c distCase) (rtol float64, id string) {
+	switch c.name {
+	case "NORM.S.INV", "NORMSINV":
+		return 1e-8, "excelize/12"
+	case "NORM.INV", "NORMINV", "LOGNORM.INV", "LOGINV":
+		return 1e-6, "excelize/12"
+	case "T.INV", "T.INV.2T", "TINV":
+		return 1e-7, "excelize/26"
+	}
+	return 0, ""
+}
+
+// judgeDist judges one case: the shape named first, then the formula against the oracle's
+// verdict within distTolerance. A result of an inverse normal or an inverse t outside its
+// tolerance but within the relaxed one fails naming the check-level shape (excelize/12,
+// excelize/26); under HEGEL_NO_KNOWN=1 the relaxed check stands and the case is counted as
+// known (not skipped).
+func judgeDist(j *hzCaseJudge, o *hzOracle, c distCase) {
+	formula, cells := hzFormula(c.name, c.args)
+	want, err := o.eval(c.name, c.args)
+	if err != nil {
+		j.ht.Fatalf("%s: oracle: %v", formula, err)
+	}
+	j.Shape(distShape(c, want))
+	rtol, atol := distTolerance(c)
+	desc := hzDesc(formula, cells)
+	got := hzCalc(formula, cells)
+	if relaxed, id := distRelaxed(c); id != "" && want.t == "n" && got.isNum && !hzClose(got.num, want.num, rtol, atol) && hzClose(got.num, want.num, relaxed, atol) {
+		if hzNoKnown {
+			hzCount("known " + id)
+			rtol = relaxed
+		} else {
+			if j.shape == "" {
+				hzCount("shape " + id)
+				j.shape = id
+			}
+			j.Fail(c.name+" value", "%s = %v, want %v", desc, got, want)
+			return
+		}
+	}
+	hzJudgeCase(j, c.name, desc, got, want, rtol, atol)
+}
+
+func TestHegelDist(t *testing.T) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, distCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeDist(j, o, c)
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..6f4151f
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,158 @@
+package hegel
+
+// The generator idioms the properties share, as go/bubbles' internal/zootest/gen.go (and
+// go/gonum's hegel_zoo_gen_test.go) spell them, with the hz prefix of this package: hegel-go
+// has no weighted choice, biased coin, tuple or counted-list combinator. Every generator built
+// from them is a package-level value; the simplest alternative comes first so that shrinking
+// lands on it, except the shape of a recorded bug a wide property must reach every run, which
+// goes first at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are
+// nominal: a weighted choice drawn alone comes out exact (the engine enumerates a small die),
+// but inside a case with other draws the engine favours the first alternative (measured here:
+// the first of a 2:18:10 choice is drawn 40% of the time when another draw precedes or
+// follows it, 7% alone), so the rates are what the collector (ZOO_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzCount("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/hegel/hegel_zoo_math_shapes_test.go b/hegel/hegel_zoo_math_shapes_test.go
new file mode 100644
index 0000000..ba03fa5
--- /dev/null
+++ b/hegel/hegel_zoo_math_shapes_test.go
@@ -0,0 +1,883 @@
+package hegel
+
+// The shape regions of the recorded Math bugs (bugs.toml excelize/2, 6, 7, 8, 9, 10, 15, 17,
+// 18, 19, 21, 23, 29, 31, 33, 34, and 79 to 82) and the narrow properties over them: each region is a
+// generator over the bug's shape with random contents, judged exactly like the wide property
+// (judgeMath, with the classifier mathShape naming the bug). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next to the
+// shape instead (hzShaped) and the property passes. The hit rates quoted at each region are
+// the collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000).
+
+import (
+	"math"
+	"math/big"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowMath runs a narrow property: every drawn case through the wide property's judge.
+func narrowMath(t *testing.T, cases hegel.Generator[mathCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMath(j, o, c)
+		col.count("cases")
+	})
+}
+
+// fn: the cases NAME(args) over one generator per argument.
+func fn(name string, gens ...hegel.Generator[float64]) hegel.Generator[mathCase] {
+	args := make([]hegel.Generator[hzArg], len(gens))
+	for i, g := range gens {
+		args[i] = num(g)
+	}
+	return casesOf(name, hzTuple(args...))
+}
+
+func neg(g hegel.Generator[float64]) hegel.Generator[float64] {
+	return hegel.Map(g, func(v float64) float64 { return -v })
+}
+
+// decimalOf: the float nearest to the decimal k / 10^p (its literal is that decimal).
+func decimalOf(k int, p int) float64 {
+	v, _ := new(big.Rat).Mul(big.NewRat(int64(k), 1), pow10Rat(-p)).Float64()
+	return v
+}
+
+var (
+	zero      = hegel.Just(0.0)
+	nonzero   = signed(positives, 50)
+	ints1to30 = floats(hzInts(0, 30))
+	// unitFractions: (1..999) / 10^(3..9), in (0, 1)
+	unitFractions = overTens(hzInts(1, 999), 3, 9)
+	// halves: j + 0.5
+	halves = hegel.Map(hzInts(0, 9), func(j int) float64 { return float64(j) + 0.5 })
+	// tenths: j + r/10, r in 1..9 (never an integer)
+	tenths = hegel.Composite(func(tc hegel.TestCase) float64 {
+		return decimalOf(10*hegel.Draw(tc, hzInts(1, 30))+hegel.Draw(tc, hzInts(1, 9)), 1)
+	})
+	// inexactSigs: the significances that are not binary fractions
+	inexactSigs = hzSampled(0.1, 0.01, 0.001, 0.2, 0.3, 0.7, 0.05, 0.6, 0.9, 1.1, 0.15, 0.025)
+	// integerSigs: significances whose quotients are exact
+	integerSigs = hzSampled(1.0, 2, 3, 5, 7, 10, 100)
+	// positiveSigs and negativeSigs: the significance table by sign (0 apart)
+	positiveSigs = hzSampled(1.0, 2, 5, 10, 100, 0.5, 0.25, 0.1, 0.01, 0.2, 3, 7)
+	negativeSigs = neg(positiveSigs)
+)
+
+// --------------------------------------------------------------------------- excelize/2
+
+// secIsTheCosine: SEC of any nonzero angle (the library returns the cosine, which agrees
+// with the secant only at 0). Past the shape, SEC(0). Hit rate 1000 of 1000.
+var secIsTheCosine = hzShaped(
+	fn("SEC", signed(overTens(hzInts(1, 20000), 3, 3), 50)),
+	fn("SEC", zero),
+)
+
+func TestHegelMathSecIsTheReciprocal(t *testing.T) { narrowMath(t, secIsTheCosine) }
+
+// --------------------------------------------------------------------------- excelize/6
+
+// combinPairs: the pairs (n, k), 0 < k < n <= 50, split by whether the library's product
+// rounds up with Ceil to the exact binomial (hits) or one above it (misses: 230 of 1225 by
+// the float, 194 outside the judge's 1e-12, which hides the misses above 1e12);
+// COMBINA(k+1, n-k) is COMBIN(n, k) in the library and takes the pairs with 2k+1 >= n.
+type combinPair struct{ n, k float64 }
+
+var combinPairsOnce = sync.OnceValues(func() (misses, hits []combinPair) {
+	for n := 2; n <= 50; n++ {
+		for k := 1; k < n; k++ {
+			p := combinPair{float64(n), float64(k)}
+			c := mathCase{name: "COMBIN", args: []hzArg{hzN(p.n), hzN(p.k)}}
+			if mathShape(c, goVerdict(c)) == "excelize/6" { // a miss within the judge's 1e-12 is none
+				misses = append(misses, p)
+			} else {
+				hits = append(hits, p)
+			}
+		}
+	}
+	return misses, hits
+})
+
+func combinCases(miss bool) hegel.Generator[mathCase] {
+	table := func() []combinPair {
+		misses, hits := combinPairsOnce()
+		if miss {
+			return misses
+		}
+		return hits
+	}
+	combin := hegel.Composite(func(tc hegel.TestCase) mathCase {
+		p := hegel.Draw(tc, hegel.SampledFrom(table()))
+		return mathCase{name: "COMBIN", args: []hzArg{hzN(p.n), hzN(p.k)}}
+	})
+	combina := hegel.Composite(func(tc hegel.TestCase) mathCase {
+		var pairs []combinPair
+		for _, p := range table() {
+			if 2*p.k+1 >= p.n {
+				pairs = append(pairs, p)
+			}
+		}
+		p := hegel.Draw(tc, hegel.SampledFrom(pairs))
+		return mathCase{name: "COMBINA", args: []hzArg{hzN(p.k + 1), hzN(p.n - p.k)}}
+	})
+	return hzWeighted(hzW(3, combin), hzW(1, combina))
+}
+
+// combinRoundsUp: COMBIN and COMBINA over the pairs the product misses. Past the shape, the
+// pairs it hits. Hit rate 728 of 728 (the engine deduplicates the table's draws).
+var combinRoundsUp = hzShaped(combinCases(true), combinCases(false))
+
+func TestHegelMathCombinIsExact(t *testing.T) { narrowMath(t, combinRoundsUp) }
+
+// --------------------------------------------------------------------------- excelize/7
+
+// oddOfAUnitFraction: ODD of a number in (0, 1). Past the shape, its negative, one above it,
+// and integers. Hit rate 1000 of 1000.
+var oddOfAUnitFraction = hzShaped(
+	fn("ODD", unitFractions),
+	fn("ODD", hzWeighted(
+		hzW(1, neg(unitFractions)),
+		hzW(1, hegel.Map(unitFractions, func(v float64) float64 { return 1 + v })),
+		hzW(1, floats(hzInts(1, 1000))),
+	)),
+)
+
+func TestHegelMathOddOfAUnitFraction(t *testing.T) { narrowMath(t, oddOfAUnitFraction) }
+
+// --------------------------------------------------------------------------- excelize/8
+
+// roundingCases: ROUND, ROUNDUP and ROUNDDOWN of a number of magnitude 100 or more (below
+// 10^digits / 2 both sides round to 0) with the digits.
+func roundingCases(d hegel.Generator[float64]) hegel.Generator[mathCase] {
+	x := signed(hzWeighted(
+		hzW(1, floats(hzInts(100, 100000))),
+		hzW(1, overTens(hzInts(100000, 9999999), 1, 3)),
+	), 40)
+	return hzWeighted(
+		hzW(1, fn("ROUND", x, d)),
+		hzW(1, fn("ROUNDUP", x, d)),
+		hzW(1, fn("ROUNDDOWN", x, d)),
+	)
+}
+
+// fractionalDigits: a fractional num_digits (the power of ten is then irrational). Past the
+// shape, num_digits -3..0 (exact powers of ten, no binary miss either). Hit rate 1000 of 1000.
+var fractionalDigits = hzShaped(
+	roundingCases(hzSampled(1.5, -1.5, 2.9, 0.5, -0.5, 2.5, 1.1)),
+	roundingCases(floats(hzInts(-3, 0))),
+)
+
+func TestHegelMathFractionalDigitsAreTruncated(t *testing.T) { narrowMath(t, fractionalDigits) }
+
+// --------------------------------------------------------------------------- excelize/9
+
+// multipleCase: NAME(x, s[, mode]) with x = +-(k + r/10) |s| as a decimal, so that x / s is
+// never an integer (the direction of the rounding matters and the binary quotient cannot
+// miss); the sign of x as given, the mode from modes (none for two arguments).
+func multipleCase(name string, xSign float64, sigs, modes hegel.Generator[float64]) hegel.Generator[mathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		s := hegel.Draw(tc, sigs)
+		q := big.NewRat(int64(10*hegel.Draw(tc, hzInts(0, 999))+hegel.Draw(tc, hzInts(1, 9))), 10)
+		x, _ := new(big.Rat).Mul(q, ratOf(xSign*math.Abs(s))).Float64()
+		args := []hzArg{hzN(x), hzN(s)}
+		if modes != nil {
+			args = append(args, hzN(hegel.Draw(tc, modes)))
+		}
+		return mathCase{name: name, args: args}
+	})
+}
+
+// zeroSignificance: CEILING, CEILING.MATH and FLOOR.MATH with significance 0 (#NUM!, want 0).
+var zeroSignificance = hzWeighted(
+	hzW(1, fn("CEILING", numbers, zero)),
+	hzW(1, fn("CEILING.MATH", numbers, zero)),
+	hzW(1, fn("CEILING.MATH", numbers, zero, modes)),
+	hzW(1, fn("FLOOR.MATH", numbers, zero)),
+	hzW(1, fn("FLOOR.MATH", numbers, zero, modes)),
+)
+
+// ceilingMathMisreads: the conditions of excelize/9 (the quotient by the signed significance
+// adjusted by `number > 0` / `mode < 0` in CEILING.MATH and `number < 0 && mode > 0` in
+// FLOOR.MATH): CEILING.MATH of a positive number with a negative significance, of a negative
+// number with a positive significance and a positive mode, or with a negative significance
+// and a nonzero mode; FLOOR.MATH of a negative number with a positive significance and a
+// mode of 0 or more, or with a negative significance and no mode or a mode of 0 or more;
+// a significance of 0; FLOOR(0, negative). Past the shape, the sign and mode combinations
+// the library gets right. Hit rate 1000 of 1000.
+var ceilingMathMisreads = hzShaped(
+	hzWeighted(
+		hzW(1, multipleCase("CEILING.MATH", 1, negativeSigs, nil)),
+		hzW(1, multipleCase("CEILING.MATH", 1, negativeSigs, modes)),
+		hzW(1, multipleCase("CEILING.MATH", -1, positiveSigs, hzSampled(1.0, 2, 0.5))),
+		hzW(1, multipleCase("CEILING.MATH", -1, negativeSigs, hzSampled(1.0, -1, 2, 0.5, -3))),
+		hzW(1, multipleCase("FLOOR.MATH", -1, positiveSigs, hzSampled(0.0, 1, 2, 0.5))),
+		hzW(1, multipleCase("FLOOR.MATH", -1, negativeSigs, nil)),
+		hzW(1, multipleCase("FLOOR.MATH", -1, negativeSigs, hzSampled(0.0, 1, 2, 0.5))),
+		hzW(1, zeroSignificance),
+		hzW(1, fn("FLOOR", zero, negativeSigs)),
+	),
+	hzWeighted(
+		hzW(1, multipleCase("CEILING.MATH", 1, positiveSigs, nil)),
+		hzW(1, multipleCase("CEILING.MATH", 1, positiveSigs, modes)),
+		hzW(1, multipleCase("CEILING.MATH", -1, positiveSigs, nil)),
+		hzW(1, multipleCase("CEILING.MATH", -1, positiveSigs, hzSampled(0.0, -1, -3))),
+		hzW(1, multipleCase("CEILING.MATH", -1, negativeSigs, zero)),
+		hzW(1, multipleCase("FLOOR.MATH", 1, positiveSigs, nil)),
+		hzW(1, multipleCase("FLOOR.MATH", 1, negativeSigs, modes)),
+		hzW(1, multipleCase("FLOOR.MATH", -1, positiveSigs, nil)),
+		hzW(1, multipleCase("FLOOR.MATH", -1, positiveSigs, hzSampled(-1.0, -3))),
+		hzW(1, multipleCase("FLOOR.MATH", -1, negativeSigs, hzSampled(-1.0, -3))),
+		hzW(1, multipleCase("CEILING", 1, positiveSigs, nil)),
+		hzW(1, fn("FLOOR", zero, positiveSigs)),
+	),
+)
+
+func TestHegelMathCeilingMathReadsTheMode(t *testing.T) { narrowMath(t, ceilingMathMisreads) }
+
+// --------------------------------------------------------------------------- excelize/10
+
+// infiniteResults: the Math functions whose float64 result is infinite: LN and LOG10 of 0,
+// ATANH and ACOTH of +-1, FACT from 171, EXP from 710, SINH and COSH from 711, SERIESSUM
+// with a power of 2 or more to 1024 or more, MULTINOMIAL with a sum above 170. Past the
+// shape, the arguments just inside. Hit rate 1000 of 1000.
+var infiniteResults = hzShaped(
+	hzWeighted(
+		hzW(1, fn("LN", zero)),
+		hzW(1, fn("LOG10", zero)),
+		hzW(1, fn("ATANH", hzSampled(1.0, -1))),
+		hzW(1, fn("ACOTH", hzSampled(1.0, -1))),
+		hzW(1, fn("FACT", hzWeighted(hzW(3, floats(hzInts(171, 200))), hzW(1, overTens(hzInts(1711, 2009), 1, 1))))),
+		hzW(1, fn("EXP", hzWeighted(hzW(1, floats(hzInts(710, 1000))), hzW(1, timesTens(hzInts(1, 999), 3, 12))))),
+		hzW(1, fn("SINH", signed(floats(hzInts(711, 1000)), 50))),
+		hzW(1, fn("COSH", signed(floats(hzInts(711, 1000)), 50))),
+		hzW(1, casesOf("SERIESSUM", hzTuple(num(floats(hzInts(2, 100))), num(floats(hzInts(1024, 2000))), num(floats(hzInts(0, 5))), hegel.Map(hzCounted(floats(hzInts(1, 99)), 1, 6), hzA)))),
+		hzW(1, casesOf("MULTINOMIAL", hzCounted(num(floats(hzInts(86, 98))), 2, 2))), // two: three factorials of 86 overflow the denominator too, to #NUM!
+	),
+	hzWeighted(
+		hzW(1, fn("LN", positives)),
+		hzW(1, fn("LOG10", positives)),
+		hzW(1, fn("ATANH", overTens(hzInts(-999, 999), 3, 3))),
+		hzW(1, fn("ACOTH", signed(hegel.Map(positives, func(v float64) float64 { return 1 + v }), 50))),
+		hzW(1, fn("FACT", floats(hzInts(0, 170)))),
+		hzW(1, fn("EXP", floats(hzInts(-700, 709)))),
+		hzW(1, fn("SINH", signed(floats(hzInts(0, 709)), 50))),
+		hzW(1, fn("COSH", signed(floats(hzInts(0, 709)), 50))),
+		hzW(1, casesOf("SERIESSUM", hzTuple(num(floats(hzInts(2, 100))), num(floats(hzInts(0, 5))), num(floats(hzInts(0, 2))), hegel.Map(hzCounted(floats(hzInts(1, 99)), 1, 6), hzA)))),
+		hzW(1, casesOf("MULTINOMIAL", hzCounted(num(floats(hzInts(0, 28))), 2, 6))),
+	),
+)
+
+func TestHegelMathInfiniteResultsAreErrors(t *testing.T) { narrowMath(t, infiniteResults) }
+
+// --------------------------------------------------------------------------- excelize/15
+
+// countsAreTruncated: PERMUT with a number_chosen of j + 0.5 at least 1.5 below an integer
+// number (the factorial of number - number_chosen is then one short; 0! = 1! hides the
+// half just below 1) or just above it (number below number_chosen only before truncation);
+// MULTINOMIAL with two halves of 1.5 or more (the sum is truncated after adding them); GCD
+// and LCM of one fraction (returned as it is); BASE with a fractional min_length (#VALUE!
+// from Atoi). Past the shape, a fractional number with an integer number_chosen, one half,
+// two arguments, an integer min_length. Hit rate 1000 of 1000.
+var countsAreTruncated = hzShaped(
+	hzWeighted(
+		hzW(2, casesOf("PERMUT", hegel.FlatMap(hzInts(2, 30), func(n int) hegel.Generator[[]hzArg] {
+			return hzTuple(hegel.Just(hzN(float64(n))), num(hegel.Map(hzInts(0, n-2), func(j int) float64 { return float64(j) + 0.5 })))
+		}))),
+		hzW(1, casesOf("PERMUT", hegel.FlatMap(hzInts(0, 30), func(n int) hegel.Generator[[]hzArg] {
+			return hzTuple(hegel.Just(hzN(float64(n))), hegel.Just(hzN(float64(n)+0.5)))
+		}))),
+		hzW(2, casesOf("MULTINOMIAL", hzSeq(hzCounted(num(floats(hzInts(0, 20))), 0, 4), hzCounted(num(hegel.Map(hzInts(1, 9), func(j int) float64 { return float64(j) + 0.5 })), 2, 2)))),
+		hzW(1, fn("GCD", tenths)),
+		hzW(1, fn("LCM", tenths)),
+		hzW(1, fn("BASE", floats(hzInts(0, 100000)), floats(hzInts(2, 36)), tenths)),
+	),
+	hzWeighted(
+		hzW(2, casesOf("PERMUT", hegel.FlatMap(hzInts(0, 30), func(j int) hegel.Generator[[]hzArg] {
+			return hzTuple(hegel.Just(hzN(float64(j)+0.5)), num(floats(hzInts(0, j))))
+		}))),
+		hzW(1, casesOf("PERMUT", hegel.FlatMap(hzInts(0, 30), func(n int) hegel.Generator[[]hzArg] {
+			return hzTuple(hegel.Just(hzN(float64(n))), num(floats(hzInts(0, n))))
+		}))),
+		hzW(2, casesOf("MULTINOMIAL", hzSeq(hzCounted(num(floats(hzInts(0, 20))), 1, 4), hzCounted(num(halves), 0, 1)))),
+		hzW(1, fn("GCD", tenths, floats(hzInts(1, 30)))),
+		hzW(1, fn("LCM", tenths, floats(hzInts(1, 30)))),
+		hzW(1, fn("BASE", floats(hzInts(0, 100000)), floats(hzInts(2, 36)), floats(hzInts(0, 20)))),
+	),
+)
+
+func TestHegelMathCountsAreTruncated(t *testing.T) { narrowMath(t, countsAreTruncated) }
+
+// --------------------------------------------------------------------------- excelize/17
+
+// cothCancels: the library's quotient of exponentials is 1e-12 off the cotangent.
+func cothCancels(x float64) bool {
+	c := mathCase{name: "COTH", args: []hzArg{hzN(x)}}
+	return mathShape(c, goVerdict(c)) == "excelize/17"
+}
+
+// cothAtTheEnds: COTH beyond +-710 (the exponentials overflow to #NUM!) and of (1..999) /
+// 10^(8..9) where the quotient of exponentials cancels (hegel.Filter on the replicated
+// arithmetic: 49 draws in 50 pass, measured over 2000 draws). Past the shape, |x| in
+// [0.01, 700]. Hit rate 1000 of 1000.
+var cothAtTheEnds = hzShaped(
+	hzWeighted(
+		hzW(1, fn("COTH", signed(floats(hzInts(710, 100000)), 50))),
+		hzW(3, fn("COTH", hegel.Filter(signed(overTens(hzInts(1, 999), 8, 9), 50), cothCancels))),
+	),
+	fn("COTH", signed(hzWeighted(hzW(1, overTens(hzInts(1, 999), 2, 2)), hzW(1, floats(hzInts(1, 700)))), 50)),
+)
+
+func TestHegelMathCothAtTheEnds(t *testing.T) { narrowMath(t, cothAtTheEnds) }
+
+// --------------------------------------------------------------------------- excelize/18
+
+// romanNumbers: 0..3999; outOfRange: below 0 or above 3999; differingNumbers: numbers whose
+// concise form 1 numeral differs from the classic (a 950, 450, 95 or 45 part).
+var (
+	romanNumbers   = floats(hzInts(0, 3999))
+	outOfRange     = hzWeighted(hzW(1, floats(hzInts(-100, -1))), hzW(1, floats(hzInts(4000, 5000))))
+	differingParts = hzWeighted(
+		hzW(1, floats(hzInts(950, 999))),
+		hzW(1, floats(hzInts(450, 499))),
+		hzW(1, hegel.Map(hzTuple(floats(hzInts(0, 9)), floats(hzInts(95, 99))), func(v []float64) float64 { return v[0]*100 + v[1] })),
+		hzW(1, hegel.Map(hzTuple(floats(hzInts(0, 9)), floats(hzInts(45, 49))), func(v []float64) float64 { return v[0]*100 + v[1] })),
+	)
+	differingNumbers = hegel.Map(hzTuple(floats(hzInts(0, 3)), differingParts), func(v []float64) float64 { return v[0]*1000 + v[1] })
+	formsOutOfRange  = hzWeighted(hzW(1, floats(hzInts(5, 9))), hzW(1, floats(hzInts(-5, -1))))
+	trueForm         = hegel.Just(hzB(true))
+)
+
+// romanRejectsTheRange: ROMAN of a number out of 0..3999 (with or without a form), with a
+// form out of 0..4, or with the form TRUE where the concise numeral differs. Past the shape,
+// numbers in range with no form or the classic one, and TRUE where the numerals agree
+// (hegel.Filter: 4 draws in 5 pass). Hit rate 1000 of 1000.
