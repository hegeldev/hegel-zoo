+package hegel
+
+// The text, logical and information functions of the calculator against a Python model of
+// Excel's documented behaviour (TestHegelText, TestHegelLogic). Numbers reaching a text
+// function are converted the way Excel converts them (15 significant digits, no exponent in
+// the safe range); strings are BMP text (Excel counts UTF-16 units, which equal characters
+// there).
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzOracleText is inserted into the oracle script before its dispatch loop.
+const hzOracleText = `
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+class XE:
+    def __init__(self, code):
+        self.code = code
+
+def xerr(*args):
+    for a in args:
+        if isinstance(a, XE):
+            raise XErr(a.code)
+
+def xtext(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return "TRUE" if v else "FALSE"
+    if isinstance(v, str):
+        return v
+    if isinstance(v, list):
+        raise Skip()
+    return xnumtext(v)
+
+def xnumtext(v):
+    # Excel's conversion of a number to text: up to 15 significant digits, plain notation
+    # within the range modelled here; other magnitudes are not judged.
+    if v == 0:
+        return "0"
+    a = abs(v)
+    if a >= 1e15 or a < 1e-4:
+        raise Skip()
+    d = Decimal(repr(float(v)))
+    s = format(d, "f")
+    digits = s.replace("-", "").replace(".", "").lstrip("0")
+    if len(digits) > 15:
+        q = Decimal(1).scaleb(d.adjusted() - 14)
+        d = d.quantize(q, rounding=ROUND_HALF_UP)
+        s = format(d, "f")
+    if "." in s:
+        s = s.rstrip("0").rstrip(".")
+    if s in ("-0", ""):
+        s = "0"
+    return s
+
+def xnum(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return 1.0 if v else 0.0
+    if isinstance(v, str):
+        try:
+            return float(v)
+        except ValueError:
+            raise XErr(VALUE)
+    if isinstance(v, list):
+        raise Skip()
+    return float(v)
+
+def xlogic(v):
+    # Excel's coercion of a direct argument to a logical value.
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return v
+    if isinstance(v, str):
+        if v == "TRUE":
+            return True
+        if v == "FALSE":
+            return False
+        if v.upper() in ("TRUE", "FALSE"):
+            raise Skip()
+        raise XErr(VALUE)
+    if isinstance(v, list):
+        raise Skip()
+    return v != 0
+
+def xcount(v):
+    v = xnum(v)
+    if -1 < v < 0:
+        raise Skip()  # whether Excel rejects a count in (-1, 0) is not modelled
+    return v
+
+def xdec(x):
+    return Decimal(repr(float(x)))
+
+def xround_dec(x, places):
+    d = xdec(x)
+    q = Decimal(1).scaleb(-places)
+    return d.quantize(q, rounding=ROUND_HALF_UP)
+
+def xgroup(intpart):
+    out = []
+    while len(intpart) > 3:
+        out.insert(0, intpart[-3:])
+        intpart = intpart[:-3]
+    out.insert(0, intpart)
+    return ",".join(out)
+
+def CHAR(n):
+    n = int(trunc(xnum(n)))
+    if n < 1 or n > 255:
+        raise XErr(VALUE)
+    if 128 <= n <= 159:
+        raise Skip()  # code-page dependent in Excel (Windows-1252 has the euro sign at 128)
+    return chr(n)
+
+def CODE(s):
+    s = xtext(s)
+    if s == "":
+        raise XErr(VALUE)
+    c = ord(s[0])
+    if c > 255:
+        raise Skip()  # the code page's byte or a question mark in Excel
+    return float(c)
+
+def UNICODE(s):
+    s = xtext(s)
+    if s == "":
+        raise XErr(VALUE)
+    return float(ord(s[0]))
+
+def UNICHAR(n):
+    n = int(trunc(xnum(n)))
+    if n < 1 or n > 1114111 or 55296 <= n <= 57343:
+        raise XErr(VALUE)
+    if n in (65534, 65535):
+        raise Skip()
+    return chr(n)
+
+def CLEAN(s):
+    return "".join(c for c in xtext(s) if ord(c) > 31)
+
+def TRIM(s):
+    return " ".join(p for p in xtext(s).split(" ") if p != "")
+
+def UPPER(s):
+    return xtext(s).upper()
+
+def LOWER(s):
+    return xtext(s).lower()
+
+def PROPER(s):
+    out, prev = [], False
+    for c in xtext(s):
+        letter = c.isalpha()
+        if letter and not prev:
+            out.append(c.upper())
+        else:
+            out.append(c.lower())
+        prev = letter
+    return "".join(out)
+
+def LEN(s):
+    return float(len(xtext(s)))
+
+def LEFT(s, n=1.0):
+    s, n = xtext(s), xcount(n)
+    if n < 0:
+        raise XErr(VALUE)
+    return s[:int(trunc(n))]
+
+def RIGHT(s, n=1.0):
+    s, n = xtext(s), xcount(n)
+    if n < 0:
+        raise XErr(VALUE)
+    n = int(trunc(n))
+    return s[max(0, len(s) - n):] if n > 0 else ""
+
+def MID(s, start, n):
+    s, start, n = xtext(s), xcount(start), xcount(n)
+    start, n = int(trunc(start)), int(trunc(n))
+    if start < 1 or n < 0:
+        raise XErr(VALUE)
+    return s[start - 1:start - 1 + n]
+
+def REPT(s, n):
+    s, n = xtext(s), xcount(n)
+    if n < 0:
+        raise XErr(VALUE)
+    n = int(trunc(n))
+    if len(s) * n > 32767:
+        raise XErr(VALUE)
+    return s * n
+
+def CONCAT(*args):
+    return "".join(xtext(a) for a in args)
+
+def CONCATENATE(*args):
+    return CONCAT(*args)
+
+def TEXTJOIN(delim, ignore_empty, *args):
+    delim = xtext(delim)
+    ignore = xlogic(ignore_empty)
+    parts = []
+    for a in args:
+        if isinstance(a, list):
+            parts.extend(xnumtext(v) for v in a)
+            continue
+        t = xtext(a)
+        if t == "" and ignore:
+            continue
+        parts.append(t)
+    out = delim.join(parts)
+    if len(out) > 32767:
+        raise XErr(VALUE)
+    return out
+
+def EXACT(a, b):
+    return xtext(a) == xtext(b)
+
+def FIND(f, w, start=1.0):
+    f, w, start = xtext(f), xtext(w), int(trunc(xcount(start)))
+    if start < 1 or start > len(w):
+        if f == "" and start == 1 and w == "":
+            return 1.0
+        raise XErr(VALUE)
+    i = w.find(f, start - 1)
+    if i < 0:
+        raise XErr(VALUE)
+    return float(i + 1)
+
+def xwild(p):
+    # Excel's wildcard pattern as a regular expression: ? one character, * any run, ~ escapes.
+    out, i = [], 0
+    while i < len(p):
+        c = p[i]
+        if c == "~":
+            if i + 1 >= len(p):
+                raise Skip()  # a trailing tilde: behaviour not modelled
+            out.append(re.escape(p[i + 1]))
+            i += 2
+            continue
+        if c == "?":
+            out.append(".")
+        elif c == "*":
+            out.append(".*?")
+        else:
+            out.append(re.escape(c))
+        i += 1
+    return re.compile("".join(out), re.DOTALL)
+
+def SEARCH(f, w, start=1.0):
+    f, w, start = xtext(f).upper(), xtext(w).upper(), int(trunc(xcount(start)))
+    if start < 1 or start > len(w):
+        if f == "" and start == 1 and w == "":
+            return 1.0
+        raise XErr(VALUE)
+    pat = xwild(f)
+    for pos in range(start - 1, len(w) + 1):
+        if pat.match(w, pos):
+            return float(pos + 1)
+    raise XErr(VALUE)
+
+def REPLACE(old, start, n, new):
+    old, new = xtext(old), xtext(new)
+    start, n = int(trunc(xcount(start))), int(trunc(xcount(n)))
+    if start < 1 or n < 0:
+        raise XErr(VALUE)
+    return old[:start - 1] + new + old[start - 1 + n:]
+
+def SUBSTITUTE(text, old, new, k=None):
+    text, old, new = xtext(text), xtext(old), xtext(new)
+    if k is None:
+        if old == "":
+            return text
+        return text.replace(old, new)
+    k = int(trunc(xcount(k)))
+    if k < 1:
+        raise XErr(VALUE)
+    if old == "":
+        return text
+    pos, count = 0, 0
+    while True:
+        i = text.find(old, pos)
+        if i < 0:
+            return text
+        count += 1
+        if count == k:
+            return text[:i] + new + text[i + len(old):]
+        pos = i + len(old)
+
+def FIXED(x, decimals=2.0, no_commas=False):
+    x = xnum(x)
+    decimals = int(trunc(xnum(decimals)))
+    no_commas = xlogic(no_commas)
+    if decimals > 127:
+        raise XErr(VALUE)
+    d = xround_dec(x, decimals)
+    if d == 0 and x < 0:
+        raise Skip()  # the sign of a negative rounded to zero
+    s = format(d, "f") if decimals > 0 else format(d.quantize(Decimal(1)), "f")
+    neg = s.startswith("-")
+    s = s.lstrip("-")
+    if "." in s:
+        ip, fp = s.split(".")
+        fp = "." + fp
+    else:
+        ip, fp = s, ""
+    if not no_commas:
+        ip = xgroup(ip)
+    return ("-" if neg else "") + ip + fp
+
+XMONTHNAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
+XDAYNAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
+
+def xtext_number(x, fmt):
+    if fmt in ("General", "@"):
+        return xnumtext(x)
+    if fmt == "0.00E+00" or fmt == "0.0E+00":
+        places = 2 if fmt == "0.00E+00" else 1
+        if x == 0:
+            return "0." + "0" * places + "E+00"
+        d = xdec(x)
+        e = d.adjusted()
+        m = (d.scaleb(-e)).quantize(Decimal(1).scaleb(-places), rounding=ROUND_HALF_UP)
+        if abs(m) >= 10:
+            m = (m / 10).quantize(Decimal(1).scaleb(-places), rounding=ROUND_HALF_UP)
+            e += 1
+        return format(m, "f") + "E" + ("+" if e >= 0 else "-") + ("%02d" % abs(e))
+    pct = fmt.endswith("%")
+    core = fmt[:-1] if pct else fmt
+    if pct:
+        x = x * 100
+    commas = core.startswith("#,##")
+    core = core.replace("#,##", "")
+    places = len(core.split(".")[1]) if "." in core else 0
+    intdigits = len(core.split(".")[0])
+    d = xround_dec(x, places)
+    if d == 0 and x < 0:
+        raise Skip()
+    s = format(d, "f") if places > 0 else format(d.quantize(Decimal(1)), "f")
+    neg = s.startswith("-")
+    s = s.lstrip("-")
+    if "." in s:
+        ip, fp = s.split(".")
+        fp = "." + fp
+    else:
+        ip, fp = s, ""
+    if core.startswith("#"):
+        ip = ip.lstrip("0")
+    else:
+        ip = ip.rjust(intdigits, "0")
+    if commas:
+        ip = xgroup(ip)
+    return ("-" if neg else "") + ip + fp + ("%" if pct else "")
+
+def xtext_date(s, fmt):
+    if s < 61 or s > XMAX + 1:
+        raise Skip()
+    day = int(s)
+    secs = int(round((s - day) * 86400))
+    if secs >= 86400:
+        day, secs = day + 1, secs - 86400
+    if day > XMAX:
+        raise Skip()
+    y, m, d = xserial_ymd(day)
+    wd = xwd(day)
+    h, rem = divmod(secs, 3600)
+    mi, se = divmod(rem, 60)
+    ampm = "AM/PM" in fmt
+    hh = h
+    if ampm:
+        hh = h % 12
+        if hh == 0:
+            hh = 12
+    out, i, prev = [], 0, ""
+    while i < len(fmt):
+        for tok in ("AM/PM", "yyyy", "mmmm", "dddd", "mmm", "ddd", "yy", "mm", "dd", "hh", "ss", "d", "m", "h", "s"):
+            if fmt.startswith(tok, i):
+                break
+        else:
+            out.append(fmt[i])
+            i += 1
+            continue
+        i += len(tok)
+        if tok in ("m", "mm"):
+            rest = fmt[i:].lstrip(":")
+            if prev in ("h", "hh") or rest.startswith("s"):
+                out.append(("%02d" % mi) if tok == "mm" else str(mi))
+                prev = tok
+                continue
+        prev = tok
+        if tok == "AM/PM":
+            out.append("AM" if h < 12 else "PM")
+        elif tok == "yyyy":
+            out.append("%04d" % y)
+        elif tok == "yy":
+            out.append("%02d" % (y % 100))
+        elif tok == "mmmm":
+            out.append(XMONTHNAMES[m - 1])
+        elif tok == "mmm":
+            out.append(XMONTHNAMES[m - 1][:3])
+        elif tok == "mm":
+            out.append("%02d" % m)
+        elif tok == "m":
+            out.append(str(m))
+        elif tok == "dddd":
+            out.append(XDAYNAMES[wd])
+        elif tok == "ddd":
+            out.append(XDAYNAMES[wd][:3])
+        elif tok == "dd":
+            out.append("%02d" % d)
+        elif tok == "d":
+            out.append(str(d))
+        elif tok == "hh":
+            out.append("%02d" % hh)
+        elif tok == "h":
+            out.append(str(hh))
+        elif tok == "ss":
+            out.append("%02d" % se)
+        elif tok == "s":
+            out.append(str(se))
+    return "".join(out)
+
+TIMEFMTS = ("hh:mm:ss", "h:mm AM/PM", "hh:mm", "h:mm:ss AM/PM")
+
+def TEXT(v, fmt):
+    fmt = xtext(fmt)
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return "TRUE" if v else "FALSE"
+    if isinstance(v, str):
+        try:
+            v = float(v)
+        except ValueError:
+            return v
+    if isinstance(v, list):
+        raise Skip()
+    if fmt in DATEFMTS or fmt in TIMEFMTS:
+        if fmt in TIMEFMTS and v < 61:
+            v = v + 61  # a bare time: the date part does not show
+        return xtext_date(v, fmt)
+    return xtext_number(v, fmt)
+
+DATEFMTS = ("yyyy-mm-dd", "dd/mm/yyyy", "mm/dd/yyyy", "d-mmm-yyyy", "mmmm d, yyyy", "dddd", "ddd", "yyyy", "mmm", "yy-m-d", "d-mmm-yyyy h:mm")
+
+def xafterbefore(after, text, delim, k, mode, match_end, if_not_found):
+    text, delim = xtext(text), xtext(delim)
+    k = xnum(k)
+    if k != trunc(k) and -1 < k < 1:
+        raise Skip()
+    k = int(trunc(k))
+    mode = xlogic(mode)
+    match_end = xlogic(match_end)
+    if k == 0:
+        raise XErr(VALUE)
+    if delim == "":
+        raise Skip()
+    t, dl = (text.lower(), delim.lower()) if mode else (text, delim)
+    hits = []
+    pos = 0
+    while True:
+        i = t.find(dl, pos)
+        if i < 0:
+            break
+        hits.append(i)
+        pos = i + len(dl)
+    if k < 0 and len(dl) > 1 and t.count(dl) != len(re.findall("(?=" + re.escape(dl) + ")", t)):
