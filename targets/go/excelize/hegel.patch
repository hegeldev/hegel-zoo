+		want, err := oracle.eval(name, args)
+		if err != nil {
+			ht.Fatalf("%s: %v", formula, err)
+		}
+		got := hzCalc(formula, cells)
+		hzJudge(col, ht, name, hzDesc(formula, cells), got, want, 1e-12, 0)
+	})
+}
