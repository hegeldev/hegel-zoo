+def X_VALUE(text):
+    if isinstance(text, XE):
+        raise XErr(text.code)
+    if isinstance(text, bool):
+        raise XErr(VALUE)
+    if not isinstance(text, str):
+        return float(text)
+    t = text.strip(" ")
+    pct = 1.0
+    if t.endswith("%"):
+        t, pct = t[:-1], 0.01
+        if t != t.rstrip(" "):
+            raise Skip()  # a space before the percent sign: not modelled
+    if t and NUMRE.match(t) and re.search(r"\d", t):
+        v = float(t.replace(",", "")) * pct
+        if v == 0:
+            return 0.0
+        return v
+    if pct != 1.0:
+        raise XErr(VALUE)
+    if re.match(r"^\d{4}-\d{1,2}-\d{1,2}( \d{1,2}:\d{2}(:\d{2})?)?$", t) or re.match(r"^\d{1,2}/\d{1,2}/\d{4}( \d{1,2}:\d{2}(:\d{2})?)?$", t):
