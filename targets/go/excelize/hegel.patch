+	{name: "FLOOR.MATH", args: only("FLOOR.MATH", optional(hzTuple(num(numbers)), num(sigsOrZero), num(modes)))},
+	{name: "FLOOR.PRECISE", args: only("FLOOR.PRECISE", optional(hzTuple(num(numbers)), num(significances)))},
