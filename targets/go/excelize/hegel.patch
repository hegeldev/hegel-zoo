+
+def ISERROR(v):
+    return isinstance(v, XE)
+
+def ISNA(v):
+    return isinstance(v, XE) and v.code == NA
+
+def ISLOGICAL(v):
+    return isinstance(v, bool)
+
+def ISNUMBER(v):
+    return not isinstance(v, (bool, str, list, XE))
+
+def ISTEXT(v):
+    return isinstance(v, str)
+
+def ISNONTEXT(v):
+    return not isinstance(v, str)
+
+def xparity(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        raise XErr(VALUE)
+    if isinstance(v, str):
+        try:
+            v = float(v)
+        except ValueError:
+            raise XErr(VALUE)
+    return int(trunc(v))
+
+def ISEVEN(v):
+    return xparity(v) % 2 == 0
+
+def ISODD(v):
+    return xparity(v) % 2 != 0
+
+def TYPE(v):
+    if isinstance(v, XE):
+        return 16.0
+    if isinstance(v, bool):
+        return 4.0
+    if isinstance(v, str):
+        return 2.0
+    if isinstance(v, list):
+        return 64.0
+    return 1.0
+
+ERRCODES = {"#NULL!": 1, "#DIV/0!": 2, "#VALUE!": 3, "#REF!": 4, "#NAME?": 5, "#NUM!": 6, "#N/A": 7}
+
+def ERROR_TYPE(v):
+    if isinstance(v, XE):
+        return float(ERRCODES[v.code])
+    raise XErr(NA)
+
+def X_NA():
+    raise XErr(NA)
+
+XFUNCS = {"VALUE": X_VALUE, "NA": X_NA}
+
+def TRUE():
+    return True
+
+def FALSE():
+    return False
+`
+
+// hzErrLit renders an error code as an expression that evaluates to it.
+var hzErrLit = map[string]string{
+	"#N/A":    "NA()",
+	"#DIV/0!": "1/0",
+	"#NUM!":   "SQRT(-1)",
+	"#VALUE!": `VALUE("a")`,
+}
+
+func hzE(code string) hzArg { return hzArg{kind: 'e', s: code} }
+
+// hzGenChar draws one character of the text alphabet: ASCII letters and digits mostly,
+// punctuation and the wildcard/regex characters, spaces, a few Latin-1 letters and the euro
+// sign; control characters only when asked.
+func hzGenChar(tc hegel.TestCase, controls bool) rune {
+	switch hzDrawInt(tc, 0, 19) {
+	case 0, 1, 2, 3, 4, 5, 6:
+		return rune(hzPick(tc, []rune("abcdefghijklmnopqrstuvwxyz")))
+	case 7, 8, 9:
+		return rune(hzPick(tc, []rune("ABCDEFGHIJKLMNOPQRSTUVWXYZ")))
+	case 10, 11:
+		return rune(hzPick(tc, []rune("0123456789")))
+	case 12, 13, 14:
+		return ' '
+	case 15:
+		return rune(hzPick(tc, []rune("?*~")))
+	case 16:
+		return rune(hzPick(tc, []rune(`.()[]{}|\^$+-,;:!#%&=<>/@_'"`)))
+	case 17:
+		return rune(hzPick(tc, []rune("éèüñàçöÄÉÑ")))
+	case 18:
+		if controls {
+			return rune(hzPick(tc, []rune{7, 9, 10, 13, 31}))
+		}
+		return 'x'
+	default:
+		if hzChance(tc, 30) {
+			return '€'
+		}
+		return 'a'
+	}
+}
+
+// hzGenText draws a string of 0 to 12 characters (0 to 40 a tenth of the time).
+func hzGenText(tc hegel.TestCase, controls bool) string {
+	n := hzDrawInt(tc, 0, 12)
+	if hzChance(tc, 10) {
+		n = hzDrawInt(tc, 0, 40)
+	}
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		sb.WriteRune(hzGenChar(tc, controls))
+	}
+	return sb.String()
+}
+
+// hzGenSub draws a substring of s (often) or a fresh short text.
+func hzGenSub(tc hegel.TestCase, s string) string {
+	r := []rune(s)
+	if len(r) > 0 && hzChance(tc, 60) {
+		i := hzDrawInt(tc, 0, len(r)-1)
+		j := hzDrawInt(tc, i, min(len(r), i+4))
+		return string(r[i:j])
+	}
+	n := hzDrawInt(tc, 0, 3)
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		sb.WriteRune(hzGenChar(tc, false))
+	}
+	return sb.String()
+}
+
+// hzGenTextNum draws a number for a text context: integers, decimals, large and tiny ones.
+func hzGenTextNum(tc hegel.TestCase) float64 {
+	var v float64
+	switch hzDrawInt(tc, 0, 7) {
+	case 0:
+		v = float64(hzDrawInt(tc, 0, 1000))
+	case 1:
+		v = float64(hzDrawInt(tc, 0, 100000)) / 100
+	case 2:
+		v = float64(hzDrawInt(tc, 0, 1000000)) * float64(hzPick(tc, []int{1, 1000, 1000000, 1000000000}))
+	case 3:
+		v = float64(hzDrawInt(tc, 1, 999)) / float64(hzPick(tc, []float64{1e3, 1e4, 1e5, 1e6, 1e7}))
+	case 4:
+		v = float64(hzDrawInt(tc, 1, 999999)) / 1000
+	case 5:
+		v = 1 / float64(hzDrawInt(tc, 1, 99))
+	case 6:
+		v = float64(hzDrawInt(tc, 1, 99))/10 + float64(hzDrawInt(tc, 1, 99))/10
+	default:
+		v = hzGenNum(tc)
+	}
+	if hzChance(tc, 30) {
+		v = -v
+	}
+	return v
+}
+
+// hzGenAny draws a value of any scalar kind for the text functions.
+func hzGenAny(tc hegel.TestCase) hzArg {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0, 1:
+		return hzN(hzGenTextNum(tc))
+	case 2:
+		return hzB(hzGenBool(tc))
+	default:
+		return hzS(hzGenText(tc, false))
+	}
+}
+
+var hzTextFormats = []string{"0", "0.0", "0.00", "0.000", "#,##0", "#,##0.00", "0%", "0.00%", "0.00E+00", "0.0E+00", "000.00", "0000000", "@", "General",
+	"yyyy-mm-dd", "dd/mm/yyyy", "mm/dd/yyyy", "d-mmm-yyyy", "mmmm d, yyyy", "dddd", "ddd", "yyyy", "mmm", "yy-m-d", "d-mmm-yyyy h:mm", "hh:mm:ss", "h:mm AM/PM", "hh:mm", "h:mm:ss AM/PM"}
+
+var hzTextFuncs = []string{"CHAR", "CODE", "UNICODE", "UNICHAR", "CLEAN", "TRIM", "UPPER", "LOWER", "PROPER", "LEN", "LEFT", "RIGHT", "MID", "REPT", "CONCAT", "CONCATENATE", "TEXTJOIN", "EXACT",
+	"FIND", "SEARCH", "REPLACE", "SUBSTITUTE", "FIXED", "TEXT", "TEXTAFTER", "TEXTBEFORE", "VALUE", "T", "N", "VALUETOTEXT"}
+
+// hzGenTextArgs draws the arguments of a text function.
+func hzGenTextArgs(tc hegel.TestCase, name string) []hzArg {
+	text := func() hzArg {
+		if hzChance(tc, 15) {
+			return hzGenAny(tc)
+		}
+		return hzS(hzGenText(tc, false))
+	}
+	count := func(lo, hi int) hzArg {
+		if hzChance(tc, 15) {
+			return hzN(float64(hzDrawInt(tc, lo, hi)) + float64(hzDrawInt(tc, 1, 9))/10)
+		}
+		return hzN(float64(hzDrawInt(tc, lo, hi)))
+	}
+	switch name {
+	case "CHAR":
+		return []hzArg{count(-2, 260)}
+	case "UNICHAR":
+		switch hzDrawInt(tc, 0, 3) {
+		case 0:
+			return []hzArg{count(-1, 300)}
+		case 1:
+			return []hzArg{hzN(float64(hzDrawInt(tc, 55000, 66000)))}
+		default:
+			return []hzArg{hzN(float64(hzDrawInt(tc, 0, 1200000)))}
+		}
+	case "CODE", "UNICODE", "CLEAN", "UPPER", "LOWER", "PROPER", "LEN", "T", "N":
+		if hzChance(tc, 20) {
+			return []hzArg{hzS(hzGenText(tc, true))}
+		}
+		return []hzArg{text()}
+	case "TRIM":
+		var sb strings.Builder
+		for i := hzDrawInt(tc, 0, 8); i > 0; i-- {
+			sb.WriteString(hzPick(tc, []string{" ", "  ", "   ", "a", "b", "xy", "\t", "\n"}))
+		}
+		return []hzArg{hzS(sb.String())}
+	case "LEFT", "RIGHT":
+		if hzChance(tc, 30) {
+			return []hzArg{text()}
+		}
+		return []hzArg{text(), count(-1, 14)}
+	case "MID":
+		return []hzArg{text(), count(-1, 14), count(-1, 14)}
+	case "REPT":
+		if hzChance(tc, 5) {
+			return []hzArg{text(), hzN(float64(hzDrawInt(tc, 1000, 40000)))}
+		}
+		return []hzArg{text(), count(-1, 5)}
+	case "CONCAT", "CONCATENATE":
+		n := hzDrawInt(tc, 0, 4)
+		args := make([]hzArg, n)
+		for i := range args {
+			args[i] = hzGenAny(tc)
+		}
+		return args
+	case "TEXTJOIN":
+		n := hzDrawInt(tc, 1, 4)
+		args := []hzArg{hzS(hzPick(tc, []string{"", ",", "-", ", ", "|"})), hzGenLogical(tc)}
+		for i := 0; i < n; i++ {
+			if hzChance(tc, 20) {
+				args = append(args, hzA(hzGenSeries(tc, hzDrawInt(tc, 1, 4))))
+			} else {
+				args = append(args, hzGenAny(tc))
+			}
+		}
+		return args
+	case "EXACT":
+		a := text()
+		if hzChance(tc, 40) {
+			return []hzArg{a, a}
+		}
+		if a.kind == 's' && hzChance(tc, 40) {
+			return []hzArg{a, hzS(strings.ToUpper(a.s))}
+		}
+		return []hzArg{a, text()}
+	case "FIND", "SEARCH":
+		w := text()
+		var f hzArg
+		if w.kind == 's' {
+			f = hzS(hzGenSub(tc, w.s))
+		} else {
+			f = text()
+		}
+		if hzChance(tc, 50) {
+			return []hzArg{f, w}
+		}
+		return []hzArg{f, w, count(-1, 14)}
+	case "REPLACE":
+		return []hzArg{text(), count(-1, 14), count(-1, 14), text()}
+	case "SUBSTITUTE":
+		w := text()
+		var old hzArg
+		if w.kind == 's' {
+			old = hzS(hzGenSub(tc, w.s))
+		} else {
+			old = text()
+		}
+		if hzChance(tc, 50) {
+			return []hzArg{w, old, text()}
+		}
+		return []hzArg{w, old, text(), count(-1, 4)}
+	case "FIXED":
+		x := hzN(hzGenTextNum(tc))
+		if hzChance(tc, 25) {
+			// a decimal half case: d+1 decimals ending in 5
+			d := hzDrawInt(tc, 0, 4)
+			x = hzN(hzHalfNumber(tc, d))
+			if hzChance(tc, 30) {
+				return []hzArg{x, hzN(float64(d)), hzGenLogical(tc)}
+			}
+			return []hzArg{x, hzN(float64(d))}
+		}
+		switch hzDrawInt(tc, 0, 3) {
+		case 0:
+			return []hzArg{x}
+		case 1:
+			return []hzArg{x, count(-3, 6)}
+		default:
+			return []hzArg{x, count(-3, 6), hzGenLogical(tc)}
+		}
+	case "TEXT":
+		f := hzPick(tc, hzTextFormats)
+		var v hzArg
+		switch {
+		case strings.Contains(f, "y") || strings.Contains(f, "mmm") || strings.Contains(f, "ddd"):
+			v = hzN(hzGenDay(tc) + float64(hzDrawInt(tc, 0, 86399))/86400)
+		case strings.Contains(f, "h") || strings.Contains(f, "ss"):
+			v = hzN(float64(hzDrawInt(tc, 0, 86399)) / 86400)
+			if hzChance(tc, 30) {
+				v = hzN(hzGenDay(tc) + v.num)
+			}
+		default:
+			v = hzGenAny(tc)
+			if hzChance(tc, 60) {
+				v = hzN(hzGenTextNum(tc))
+			}
+			if places := strings.Count(strings.Split(strings.TrimSuffix(f, "%"), "E")[0], "0") - 1; hzChance(tc, 25) && strings.Contains(f, ".") && !strings.Contains(f, "E") {
+				v = hzN(hzHalfNumber(tc, places))
+				if strings.HasSuffix(f, "%") {
+					v = hzN(v.num / 100)
+				}
+			}
+		}
+		return []hzArg{v, hzS(f)}
+	case "TEXTAFTER", "TEXTBEFORE":
+		w := hzGenText(tc, false)
+		if hzChance(tc, 50) {
+			d := hzPick(tc, []string{"-", ",", " ", "a", "ab", "é"})
+			var sb strings.Builder
+			for i := hzDrawInt(tc, 0, 4); i > 0; i-- {
+				piece := []rune(hzGenText(tc, false))
+				sb.WriteString(string(piece[:min(3, len(piece))]))
+				sb.WriteString(d)
+			}
+			w = sb.String() + hzGenSub(tc, "xyz")
+		}
+		if hzChance(tc, 20) {
+			// adjacent delimiters, a delimiter at the start, a case-insensitive match
+			d := hzPick(tc, []string{"-", "ab", "p"})
+			if hzChance(tc, 30) {
+				d = hzPick(tc, []string{"ab", "p"})
+				return []hzArg{hzS("x" + strings.ToUpper(d) + "y" + d + "z"), hzS(d), hzN(1), hzN(float64(hzDrawInt(tc, 2, 3)))}
+			}
+			if hzChance(tc, 30) {
+				// a delimiter at the start, reached backwards with the start as match_end
+				return []hzArg{hzS(d + "abc"), hzS(d), hzN(-2), hzB(false), hzB(true)}
+			}
+			w = hzPick(tc, []string{d + "x" + d + d + "y", d + d + "x", "x" + d + d, d + "abc"})
+			args := []hzArg{hzS(w), hzS(d), count(-4, 4)}
+			if hzChance(tc, 50) {
+				args = append(args, hzB(false), hzB(true))
+			}
+			return args
+		}
+		args := []hzArg{hzS(w), hzS(hzGenSub(tc, w))}
+		if hzChance(tc, 60) {
+			args = append(args, count(-4, 4))
+		}
+		if len(args) == 3 && hzChance(tc, 50) {
+			args = append(args, hzGenLogical(tc))
+		}
+		if len(args) == 4 && hzChance(tc, 50) {
+			args = append(args, hzGenLogical(tc))
+		}
+		if len(args) == 5 && hzChance(tc, 50) {
+			args = append(args, hzS("nf"))
+		}
+		return args
+	case "VALUE":
+		return []hzArg{hzS(hzGenValueText(tc))}
+	case "VALUETOTEXT":
+		if hzChance(tc, 20) {
+			return []hzArg{hzS(hzPick(tc, []string{"2", "1.5", "TRUE", "-3", "1e3"})), hzN(1)}
+		}
+		if hzChance(tc, 50) {
+			return []hzArg{hzGenAny(tc)}
+		}
+		return []hzArg{hzGenAny(tc), count(0, 2)}
+	}
+	return []hzArg{text()}
+}
