+def CONFIDENCE_NORM(alpha, sd, n):
+    n = math.trunc(n)
+    chk(0 < alpha < 1 and sd > 0 and n >= 1)
+    return float(st.norm.isf(alpha / 2) * sd / math.sqrt(n))  # isf: 1 - alpha/2 loses alpha's digits
+def CONFIDENCE_T(alpha, sd, n):
+    n = math.trunc(n)
+    chk(0 < alpha < 1 and sd > 0 and n >= 1)
+    chk(n > 1, DIV0)
+    return float(st.t.isf(alpha / 2, n - 1) * sd / math.sqrt(n))  # isf: 1 - alpha/2 loses alpha's digits
+def F_TEST(xs, ys):
+    need(xs, 2)
+    need(ys, 2)
+    chk(not const(xs) and not const(ys), DIV0)
+    vx, vy = np.var(xs, ddof=1), np.var(ys, ddof=1)
+    d = st.f(len(xs) - 1, len(ys) - 1)
+    c = d.cdf(vx / vy)
+    return float(2 * min(c, 1 - c))
+def CHISQ_TEST(xs, ys):
+    chk(len(xs) == len(ys), NA)
+    need(xs, 2, NA)
+    chk(all(e != 0 for e in ys), DIV0)
+    s = sum((a - e) ** 2 / e for a, e in zip(xs, ys))
+    return float(st.chi2.sf(s, len(xs) - 1))
+
+# ------------------------------------------------------------------ distributions
+
+def cum(c):
+    return bool(c)
+
+def NORM_DIST(x, m, s, c):
+    chk(s > 0)
+    d = st.norm(m, s)
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def NORM_S_DIST(z, c):
+    return float(st.norm.cdf(z) if cum(c) else st.norm.pdf(z))
+def NORM_INV(p, m, s):
+    chk(0 < p < 1 and s > 0)
+    return float(st.norm.ppf(p, m, s))
+def NORM_S_INV(p):
+    chk(0 < p < 1)
+    return float(st.norm.ppf(p))
+def LOGNORM_DIST(x, m, s, c):
+    chk(x > 0 and s > 0)
+    d = st.lognorm(s, scale=math.exp(m))
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def LOGNORM_INV(p, m, s):
+    chk(0 < p < 1 and s > 0)
+    return float(st.lognorm(s, scale=math.exp(m)).ppf(p))
+def dfi(df):
+    df = math.trunc(df)
+    chk(df >= 1)
+    return df
+def T_DIST(x, df, c):
+    df = dfi(df)
+    return float(st.t.cdf(x, df) if cum(c) else st.t.pdf(x, df))
+def T_DIST_2T(x, df):
+    df = dfi(df)
+    chk(x >= 0)
+    return float(2 * st.t.sf(x, df))
+def T_DIST_RT(x, df):
+    df = dfi(df)
+    return float(st.t.sf(x, df))
+def T_INV(p, df):
+    df = dfi(df)
+    chk(0 < p < 1)
+    return float(st.t.ppf(p, df))
+def T_INV_2T(p, df):
+    df = dfi(df)
+    chk(0 < p <= 1)
+    return float(st.t.isf(p / 2, df))
+def CHISQ_DIST(x, df, c):
+    df = dfi(df)
+    chk(x >= 0)
+    return float(st.chi2.cdf(x, df) if cum(c) else st.chi2.pdf(x, df))
+def CHISQ_DIST_RT(x, df):
+    df = dfi(df)
+    chk(x >= 0)
+    return float(st.chi2.sf(x, df))
+def CHISQ_INV(p, df):
+    df = dfi(df)
+    chk(0 <= p < 1)
+    return float(st.chi2.ppf(p, df))
+def CHISQ_INV_RT(p, df):
+    df = dfi(df)
+    chk(0 < p <= 1)
+    return float(st.chi2.isf(p, df))
+def F_DIST(x, d1, d2, c):
+    d1, d2 = dfi(d1), dfi(d2)
+    chk(x >= 0)
+    return float(st.f.cdf(x, d1, d2) if cum(c) else st.f.pdf(x, d1, d2))
+def F_DIST_RT(x, d1, d2):
+    d1, d2 = dfi(d1), dfi(d2)
+    chk(x >= 0)
+    return float(st.f.sf(x, d1, d2))
+def F_INV(p, d1, d2):
+    d1, d2 = dfi(d1), dfi(d2)
+    chk(0 <= p < 1)
+    return float(st.f.ppf(p, d1, d2))
+def F_INV_RT(p, d1, d2):
+    d1, d2 = dfi(d1), dfi(d2)
+    chk(0 < p <= 1)
+    return float(st.f.isf(p, d1, d2))
+def BETA_DIST(x, a, b, c, lo=0.0, hi=1.0):
+    chk(a > 0 and b > 0 and lo <= x <= hi and lo != hi)
+    d = st.beta(a, b, loc=lo, scale=hi - lo)
+    if not cum(c) and x in (lo, hi):
+        raise Skip()  # the density at a bound: 0 in the target, SciPy's limit (Excel's answer unknown)
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def BETA_INV(p, a, b, lo=0.0, hi=1.0):
+    chk(a > 0 and b > 0 and 0 < p <= 1 and lo != hi)
+    return float(st.beta(a, b, loc=lo, scale=hi - lo).ppf(p))
+def GAMMA_DIST(x, a, b, c):
+    chk(x >= 0 and a > 0 and b > 0)
+    d = st.gamma(a, scale=b)
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def GAMMA_INV(p, a, b):
+    chk(0 <= p < 1 and a > 0 and b > 0)
+    return float(st.gamma(a, scale=b).ppf(p))
+def GAMMA(x):
+    chk(not (x <= 0 and x == math.floor(x)))
+    return fin(math.gamma(x))
+def GAMMALN(x):
+    chk(x > 0)
+    return math.lgamma(x)
+def EXPON_DIST(x, lam, c):
+    chk(x >= 0 and lam > 0)
+    d = st.expon(scale=1 / lam)
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def POISSON_DIST(x, m, c):
+    x = math.trunc(x)
+    chk(x >= 0 and m >= 0)
+    return float(st.poisson.cdf(x, m) if cum(c) else st.poisson.pmf(x, m))
+def BINOM_DIST(k, n, p, c):
+    k, n = math.trunc(k), math.trunc(n)
+    chk(0 <= k <= n and 0 <= p <= 1)
+    return float(st.binom.cdf(k, n, p) if cum(c) else st.binom.pmf(k, n, p))
+def BINOM_DIST_RANGE(n, p, s, s2=None):
+    n, s = math.trunc(n), math.trunc(s)
+    s2 = s if s2 is None else math.trunc(s2)
+    chk(n >= 0 and 0 <= p <= 1 and 0 <= s <= s2 <= n)
+    return float(sum(st.binom.pmf(k, n, p) for k in range(s, s2 + 1)))
+def BINOM_INV(n, p, alpha):
+    n = math.trunc(n)
+    chk(n >= 0 and 0 <= p <= 1 and 0 < alpha < 1)
+    for k in range(n + 1):
+        c = st.binom.cdf(k, n, p)
+        if abs(c - alpha) <= 1e-9 * alpha:
+            raise Skip()  # a tie within rounding (BINOM.INV(2,0.999,0.000001))
+        if c >= alpha:
+            return float(k)
+    return float(n)
+def NEGBINOM_DIST(f, s, p, c):
+    f, s = math.trunc(f), math.trunc(s)
+    chk(f >= 0 and s >= 1 and 0 <= p <= 1)
+    if p == 0:
+        raise Skip()
+    d = st.nbinom(s, p)
+    return float(d.cdf(f) if cum(c) else d.pmf(f))
+def HYPGEOM_DIST(x, n, M, N, c):
+    x, n, M, N = math.trunc(x), math.trunc(n), math.trunc(M), math.trunc(N)
+    chk(x >= 0 and x <= min(n, M) and x >= max(0, n - N + M) and 0 < n <= N and 0 < M <= N)
+    d = st.hypergeom(N, M, n)
+    return float(d.cdf(x) if cum(c) else d.pmf(x))
+def WEIBULL_DIST(x, a, b, c):
+    chk(x >= 0 and a > 0 and b > 0)
+    d = st.weibull_min(a, scale=b)
+    return float(d.cdf(x) if cum(c) else d.pdf(x))
+def PHI(z): return float(st.norm.pdf(z))
+def GAUSS(z): return float(st.norm.cdf(z) - 0.5)
+def ERF(lo, hi=None):
+    if hi is None:
+        return math.erf(lo)
+    return math.erf(hi) - math.erf(lo)
+def ERF_PRECISE(x): return math.erf(x)
+def ERFC(x): return math.erfc(x)
+def bessel(v):
+    v = float(v)
+    if math.isinf(v) or v == 0:
+        raise Skip()  # SciPy overflows or underflows where the value may still be representable
+    return fin(v)
+
+def BESSELJ(x, n):
+    n = math.trunc(n)
+    chk(n >= 0)
+    return bessel(sp.jv(n, x))
+def BESSELY(x, n):
+    n = math.trunc(n)
+    chk(n >= 0 and x > 0)
+    return bessel(sp.yv(n, x))
+def BESSELI(x, n):
+    n = math.trunc(n)
+    chk(n >= 0)
+    return bessel(sp.iv(n, x))
+def BESSELK(x, n):
+    n = math.trunc(n)
+    chk(n >= 0 and x > 0)
+    return bessel(sp.kv(n, x))
+
+# legacy names
+def NORMDIST(x, m, s, c): return NORM_DIST(x, m, s, c)
+def NORMINV(p, m, s): return NORM_INV(p, m, s)
+def NORMSDIST(z): return NORM_S_DIST(z, True)
+def NORMSINV(p): return NORM_S_INV(p)
+def LOGNORMDIST(x, m, s): return LOGNORM_DIST(x, m, s, True)
+def LOGINV(p, m, s): return LOGNORM_INV(p, m, s)
+def TDIST(x, df, tails):
+    tails = math.trunc(tails)
+    chk(x >= 0 and tails in (1, 2))
+    return T_DIST_RT(x, df) * tails
+def TINV(p, df): return T_INV_2T(p, df)
+def CHIDIST(x, df): return CHISQ_DIST_RT(x, df)
+def CHIINV(p, df): return CHISQ_INV_RT(p, df)
+def FDIST(x, d1, d2): return F_DIST_RT(x, d1, d2)
+def FINV(p, d1, d2): return F_INV_RT(p, d1, d2)
+def BETADIST(x, a, b, lo=0.0, hi=1.0): return BETA_DIST(x, a, b, True, lo, hi)
+def BETAINV(p, a, b, lo=0.0, hi=1.0): return BETA_INV(p, a, b, lo, hi)
+def GAMMADIST(x, a, b, c): return GAMMA_DIST(x, a, b, c)
+def GAMMAINV(p, a, b): return GAMMA_INV(p, a, b)
+def GAMMALN_PRECISE(x): return GAMMALN(x)
+def EXPONDIST(x, lam, c): return EXPON_DIST(x, lam, c)
+def POISSON(x, m, c): return POISSON_DIST(x, m, c)
+def BINOMDIST(k, n, p, c): return BINOM_DIST(k, n, p, c)
+def CRITBINOM(n, p, a): return BINOM_INV(n, p, a)
+def NEGBINOMDIST(f, s, p): return NEGBINOM_DIST(f, s, p, False)
+def HYPGEOMDIST(x, n, M, N): return HYPGEOM_DIST(x, n, M, N, False)
+def WEIBULL(x, a, b, c): return WEIBULL_DIST(x, a, b, c)
+def CONFIDENCE(a, sd, n): return CONFIDENCE_NORM(a, sd, n)
+def ERFC_PRECISE(x): return ERFC(x)
+def COVAR(xs, ys): return COVARIANCE_P(xs, ys)
+def VAR(xs): return VAR_S(xs)
+def VARP(xs): return VAR_P(xs)
+def STDEV(xs): return STDEV_S(xs)
+def STDEVP(xs): return STDEV_P(xs)
+def PERCENTILE(xs, k): return PERCENTILE_INC(xs, k)
+def QUARTILE(xs, q): return QUARTILE_INC(xs, q)
+def PERCENTRANK(xs, x, sig=3.0): return PERCENTRANK_INC(xs, x, sig)
+def RANK(x, xs, order=0.0): return RANK_EQ(x, xs, order)
+def MODE(xs): return MODE_SNGL(xs)
+def ZTEST(xs, x, sigma=None): return Z_TEST(xs, x, sigma)
+def TTEST(xs, ys, tails, typ): return T_TEST(xs, ys, tails, typ)
+def FTEST(xs, ys): return F_TEST(xs, ys)
+def CHITEST(xs, ys): return CHISQ_TEST(xs, ys)
+def PEARSON(xs, ys): return CORREL(xs, ys)
+def FORECAST_LINEAR(x0, xs, ys): return FORECAST(x0, xs, ys)
