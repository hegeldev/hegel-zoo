+def AND(*args):
+    xerr(*args)
+    vals = [xlogic(a) for a in args if not isinstance(a, list)]
+    for a in args:
+        if isinstance(a, list):
+            vals.extend(v != 0 for v in a)
+    if not vals:
+        raise XErr(VALUE)
+    return all(vals)
+
+def OR(*args):
+    xerr(*args)
+    vals = [xlogic(a) for a in args if not isinstance(a, list)]
+    for a in args:
+        if isinstance(a, list):
+            vals.extend(v != 0 for v in a)
+    if not vals:
+        raise XErr(VALUE)
+    return any(vals)
+
+def XOR(*args):
+    xerr(*args)
+    vals = [xlogic(a) for a in args if not isinstance(a, list)]
+    for a in args:
+        if isinstance(a, list):
+            vals.extend(v != 0 for v in a)
+    if not vals:
+        raise XErr(VALUE)
+    return sum(1 for v in vals if v) % 2 == 1
+
+def NOT(v):
+    return not xlogic(v)
+
+def xresult(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, list):
+        raise Skip()
+    return v
+
+def IF(test, a, b=False):
+    t = xlogic(test)
+    return xresult(a if t else b)
+
+def IFS(*args):
