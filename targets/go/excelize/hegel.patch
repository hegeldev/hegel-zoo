+	// (never under HEGEL_NO_KNOWN=1).
+	factCounts = hzWeighted(
+		hzW(hzUnless(hzNoKnown, 8), floats(hzInts(171, 200))),
+		hzW(76, floats(hzInts(0, 40))),
