diff --git a/hegel/hegel_zoo_calc_test.go b/hegel/hegel_zoo_calc_test.go
new file mode 100644
index 0000000..170cc98
--- /dev/null
+++ b/hegel/hegel_zoo_calc_test.go
@@ -0,0 +1,333 @@
+package hegel
+
+// Evaluating a formula: a fresh workbook, the range arguments written as columns A, B, C, ...
+// of Sheet1, the formula in ZZ1, CalcCellValue read back. The judge compares the result with
+// the oracle's verdict.
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/xuri/excelize/v2"
+	"hegel.dev/go/hegel"
+)
+
+// hzLit renders an argument as formula text; range arguments are named after their column.
+func hzLit(a hzArg, col string) string {
+	switch a.kind {
+	case 'n':
+		return hzNumLit(a.num)
+	case 'b':
+		if a.b {
+			return "TRUE"
+		}
+		return "FALSE"
+	case 's':
+		return hzStrLit(a.s)
+	case 'e':
+		return hzErrLit[a.s]
+	}
+	return fmt.Sprintf("%s1:%s%d", col, col, max(len(a.arr), 1))
+}
+
+// hzStrLit quotes a string; control characters are spliced in as CHAR(n).
+func hzStrLit(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			sb.WriteString(`""`)
+		case r < 32:
+			fmt.Fprintf(&sb, `"&CHAR(%d)&"`, r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+func hzNumLit(v float64) string {
+	return strconv.FormatFloat(v, 'f', -1, 64)
+}
+
+// hzFormula builds NAME(args) and the cells the ranges need.
+func hzFormula(name string, args []hzArg) (string, map[string][]float64) {
+	cells := map[string][]float64{}
+	parts := make([]string, len(args))
+	col := 'A'
+	for i, a := range args {
+		c := string(col)
+		if a.kind == 'a' {
+			cells[c] = a.arr
+			col++
+		}
+		parts[i] = hzLit(a, c)
+	}
+	return name + "(" + strings.Join(parts, ",") + ")", cells
+}
+
+// hzDesc describes a formula with the ranges it reads.
+func hzDesc(formula string, cells map[string][]float64) string {
+	if len(cells) == 0 {
+		return formula
+	}
+	cols := make([]string, 0, len(cells))
+	for c := range cells {
+		cols = append(cols, c)
+	}
+	sort.Strings(cols)
+	var sb strings.Builder
+	sb.WriteString(formula)
+	sb.WriteString(" with")
+	for _, c := range cols {
+		fmt.Fprintf(&sb, " %s=%s", c, hzShow(cells[c]))
+	}
+	return sb.String()
+}
+
+// hzGot is a formula's result: the text CalcCellValue returned, its error, the panic if any,
+// and the number the text parses to (Excel's 15 significant digits).
+type hzGot struct {
+	raw      string
+	err      error
+	panicked any
+	num      float64
+	isNum    bool
+}
+
+func (g hzGot) String() string {
+	if g.panicked != nil {
+		return fmt.Sprintf("panic: %v", g.panicked)
+	}
+	if g.err != nil {
+		return fmt.Sprintf("%q (error %v)", g.raw, g.err)
+	}
+	return fmt.Sprintf("%q", g.raw)
+}
+
+// hzCalc evaluates the formula (without the leading =) over the given columns of numbers.
+func hzCalc(formula string, cells map[string][]float64) (g hzGot) {
+	defer func() {
+		if r := recover(); r != nil {
+			g.panicked = r
+		}
+	}()
+	f := excelize.NewFile()
+	for col, vals := range cells {
+		for i, v := range vals {
+			if err := f.SetCellValue("Sheet1", fmt.Sprintf("%s%d", col, i+1), v); err != nil {
+				g.err = fmt.Errorf("SetCellValue: %w", err)
+				return
+			}
+		}
+	}
+	if err := f.SetCellFormula("Sheet1", "ZZ1", formula); err != nil {
+		g.err = fmt.Errorf("SetCellFormula: %w", err)
+		return
+	}
+	g.raw, g.err = f.CalcCellValue("Sheet1", "ZZ1")
+	if g.err == nil && g.raw != "TRUE" && g.raw != "FALSE" {
+		if v, err := strconv.ParseFloat(g.raw, 64); err == nil {
+			g.num, g.isNum = v, true
+		}
+	}
+	return
+}
+
+// hzJudge compares a result with the oracle's verdict, classifying a mismatch under the
+// function's name. A mismatch is reported by the collector; the return value says whether the
+// case agreed (a skip counts as agreed).
+func hzJudge(col *hzCollector, ht *hegel.T, name, formula string, got hzGot, want hzExpect, rtol, atol float64) bool {
+	if got.panicked != nil {
+		col.failClass(ht, name+" panic", "%s: %v", formula, got)
+		return false
+	}
+	switch want.t {
+	case "skip":
+		col.count("skipped")
+		return true
+	case "e":
+		if got.err == nil {
+			if HZKnown.infinityResults && got.isNum && math.IsInf(got.num, 0) {
+				hzAvoid("infinityResults")
+				return true
+			}
+			col.failClass(ht, name+" no error", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if want.code != "" && got.raw != want.code {
+			if HZKnown.errorCodes {
+				hzAvoid("errorCodes")
+				return true
+			}
+			col.failClass(ht, name+" error code", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		col.count("errors")
+		return true
+	case "n":
+		if got.err != nil {
+			col.failClass(ht, name+" error", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if !got.isNum {
+			col.failClass(ht, name+" not a number", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if !hzClose(got.num, want.num, rtol, atol) {
+			col.failClass(ht, name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	case "b":
+		if got.err != nil || got.raw != strings.ToUpper(fmt.Sprint(want.b)) {
+			col.failClass(ht, name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	case "s":
+		if got.err != nil || got.raw != want.s {
+			col.failClass(ht, name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	}
+	col.count("values")
+	return true
+}
+
+// hzJudgeCase is hzJudge's judge path: the same comparison, with no known-bug gate (the
+// judge names the shape the classifier found), reported through the judge. The return value
+// says whether the case agreed (a skip counts as agreed).
+func hzJudgeCase(j *hzCaseJudge, name, formula string, got hzGot, want hzExpect, rtol, atol float64) bool {
+	if got.panicked != nil {
+		j.Fail(name+" panic", "%s: %v", formula, got)
+		return false
+	}
+	switch want.t {
+	case "skip":
+		j.col.count("skipped")
+		return true
+	case "e":
+		if got.err == nil {
+			j.Fail(name+" no error", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if want.code != "" && got.raw != want.code {
+			j.Fail(name+" error code", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		j.col.count("errors")
+		return true
+	case "n":
+		if got.err != nil {
+			j.Fail(name+" error", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if !got.isNum {
+			j.Fail(name+" not a number", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+		if !hzClose(got.num, want.num, rtol, atol) {
+			j.Fail(name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	case "b":
+		if got.err != nil || got.raw != strings.ToUpper(fmt.Sprint(want.b)) {
+			j.Fail(name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	case "s":
+		if got.err != nil || got.raw != want.s {
+			j.Fail(name+" value", "%s = %v, want %v", formula, got, want)
+			return false
+		}
+	}
+	j.col.count("values")
+	return true
+}
+
+// --------------------------------------------------------------------------- generators
+
+// hzGenNum draws a number of one profile: small integers, decimals of one to three places,
+// large magnitudes, small magnitudes, decimals starting with zeros; negative 40% of the time.
+func hzGenNum(tc hegel.TestCase) float64 {
+	var v float64
+	switch hzDrawInt(tc, 0, 10) {
+	case 0, 1, 2:
+		v = float64(hzDrawInt(tc, 0, 1000))
+	case 3, 4, 5:
+		v = float64(hzDrawInt(tc, 0, 100000)) / math.Pow(10, float64(hzDrawInt(tc, 1, 3)))
+	case 6:
+		v = float64(hzDrawInt(tc, 1, 999)) * math.Pow(10, float64(hzDrawInt(tc, 3, 12)))
+	case 7:
+		v = float64(hzDrawInt(tc, 1, 999)) / math.Pow(10, float64(hzDrawInt(tc, 3, 9)))
+	case 8:
+		v = float64(hzDrawInt(tc, 0, 20)) / 4
+	case 9:
+		v = float64(hzDrawInt(tc, 0, 100)) + float64(hzDrawInt(tc, 1, 99))/math.Pow(10, float64(hzDrawInt(tc, 2, 6)))
+	default:
+		v = float64(hzDrawInt(tc, 0, 10))
+	}
+	if hzChance(tc, 40) {
+		v = -v
+	}
+	return v
+}
+
+func hzGenPos(tc hegel.TestCase) float64 {
+	v := math.Abs(hzGenNum(tc))
+	if v == 0 {
+		v = float64(hzDrawInt(tc, 1, 9))
+	}
+	return v
+}
+
+// hzGenSeries draws n values of one profile, a third of the time from a pool of one to three
+// values so that ties and constant ranges are common.
+func hzGenSeries(tc hegel.TestCase, n int) []float64 {
+	xs := make([]float64, n)
+	profile := hzDrawInt(tc, 0, 4)
+	one := func() float64 {
+		switch profile {
+		case 0:
+			return float64(hzDrawInt(tc, -20, 20))
+		case 1:
+			return float64(hzDrawInt(tc, -1000, 1000)) / 10
+		case 2:
+			return float64(hzDrawInt(tc, 0, 100))
+		case 3:
+			return float64(hzDrawInt(tc, -100000, 100000)) / 1000
+		}
+		return float64(hzDrawInt(tc, 1, 999)) * 1000
+	}
+	if hzChance(tc, 33) {
+		pool := make([]float64, hzDrawInt(tc, 1, 3))
+		for i := range pool {
+			pool[i] = one()
+		}
+		for i := range xs {
+			xs[i] = hzPick(tc, pool)
+		}
+		return xs
+	}
+	for i := range xs {
+		xs[i] = one()
+	}
+	return xs
+}
+
+func hzGenBool(tc hegel.TestCase) bool { return hzChance(tc, 50) }
+
+// hzGenProb draws a probability: inside (0, 1) mostly, the ends and tiny values sometimes.
+func hzGenProb(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		return hzPick(tc, []float64{0, 1, -0.1, 1.1})
+	case 1:
+		return hzPick(tc, []float64{1e-10, 1e-6, 1 - 1e-6, 0.999, 0.001})
+	}
+	return float64(hzDrawInt(tc, 1, 999)) / 1000
+}
diff --git a/hegel/hegel_zoo_date_test.go b/hegel/hegel_zoo_date_test.go
new file mode 100644
index 0000000..8e98fdc
--- /dev/null
+++ b/hegel/hegel_zoo_date_test.go
@@ -0,0 +1,815 @@
+package hegel
+
+// The date and time functions: DATE, DAY, MONTH, YEAR, WEEKDAY, WEEKNUM, ISOWEEKNUM, EDATE,
+// EOMONTH, DAYS, DAYS360, DATEDIF, NETWORKDAYS(.INTL), WORKDAY(.INTL), YEARFRAC, TIME, HOUR,
+// MINUTE, SECOND, DATEVALUE and TIMEVALUE, against a Python model of Excel's serial-date
+// calendar (the 1900 leap-year quirk included: serial 60 is 29 February 1900 and the weekday
+// of serial s is (s - 1) mod 7 counted from Sunday).
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+const hzOracleDate = `
+# ------------------------------------------------------------------ dates (Excel's 1900 calendar)
+
+from datetime import date, timedelta
+
+XEPOCH = date(1899, 12, 30)   # serial 61 = 1900-03-01 and every later date is real
+XMAX = 2958465                # 9999-12-31
+
+def xint(s):
+    s = float(s)
+    if s < 0 or s >= XMAX + 1:
+        raise XErr(NUM)
+    return int(math.floor(s))
+
+def xserial_ymd(s):
+    s = xint(s)
+    if s > 60:
+        d = XEPOCH + timedelta(days=s)
+        return d.year, d.month, d.day
+    if s == 60:
+        return 1900, 2, 29
+    if s == 0:
+        return 1900, 1, 0
+    d = date(1899, 12, 31) + timedelta(days=s)
+    return d.year, d.month, d.day
+
+def xdays_in_month(y, m):
+    if y == 1900 and m == 2:
+        return 29
+    if m == 12:
+        return 31
+    return (date(y, m + 1, 1) - date(y, m, 1)).days
+
+def xymd_serial(y, m, d):
+    # y and m normalised (1 <= m <= 12), d any integer; the serial, or #NUM! outside 0..XMAX
+    # (years outside 1..9999 go through the 400-year cycle: the day offset may bring them back)
+    k = 0
+    while y > 9999:
+        y -= 400
+        k += 1
+    while y < 1:
+        y += 400
+        k -= 1
+    first = date(y, m, 1)
+    s = (first - XEPOCH).days + k * 146097
+    if k == 0 and first < date(1900, 3, 1):
+        s -= 1
+    s += d - 1
+    if s < 0 or s > XMAX:
+        raise XErr(NUM)
+    return s
+
+def xnorm(y, m):
+    yy, mm = divmod(y * 12 + m - 1, 12)
+    return yy, mm + 1
+
+def xwd(s):
+    # Excel's weekday of a serial, 0 = Sunday ... 6 = Saturday
+    return (int(s) - 1) % 7
+
+def DATE(y, m, d):
+    y, m, d = int(trunc(y)), int(trunc(m)), int(trunc(d))
+    if 0 <= y <= 1899:
+        y += 1900
+    if y < 0 or y > 9999:
+        raise XErr(NUM)
+    y, m = xnorm(y, m)
+    if y > 10400 or y < -400:
+        raise XErr(NUM)
+    return float(xymd_serial(y, m, d))
+
+def DAY(s): return float(xserial_ymd(s)[2])
+def MONTH(s): return float(xserial_ymd(s)[1])
+def YEAR(s): return float(xserial_ymd(s)[0])
+
+def WEEKDAY(s, t=1.0):
+    wd = xwd(xint(s))
+    t = int(trunc(t))
+    if t == 1:
+        return float(wd + 1)
+    if t == 2:
+        return float((wd - 1) % 7 + 1)
+    if t == 3:
+        return float((wd - 1) % 7)
+    if 11 <= t <= 17:
+        return float((wd - (t - 10)) % 7 + 1)
+    raise XErr(NUM)
+
+WEEKSTART = {1: 0, 2: 1, 11: 1, 12: 2, 13: 3, 14: 4, 15: 5, 16: 6, 17: 0}
+
+def xiso(s):
+    return (XEPOCH + timedelta(days=s)).isocalendar()[1]
+
+def WEEKNUM(s, t=1.0):
+    s = xint(s)
+    if s < 1:
+        raise Skip()
+    t = int(trunc(t))
+    if t == 21:
+        return float(xiso(s))
+    if t not in WEEKSTART:
+        raise XErr(NUM)
+    y = xserial_ymd(s)[0]
+    jan1 = xymd_serial(y, 1, 1)
+    offset = (xwd(jan1) - WEEKSTART[t]) % 7
+    return float((s - jan1 + offset) // 7 + 1)
+
+def ISOWEEKNUM(s):
+    s = xint(s)
+    if s < 1:
+        raise Skip()
+    return float(xiso(s))
+
+def EDATE(s, months):
+    y, m, d = xserial_ymd(s)
+    if d == 0:
+        raise Skip()
+    y, m = xnorm(y, m + int(trunc(months)))
+    if y < 1 or y > 9999:
+        raise XErr(NUM)
+    return float(xymd_serial(y, m, min(d, xdays_in_month(y, m))))
+
+def EOMONTH(s, months):
+    y, m, d = xserial_ymd(s)
+    y, m = xnorm(y, m + int(trunc(months)))
+    if y < 1 or y > 9999:
+        raise XErr(NUM)
+    return float(xymd_serial(y, m, xdays_in_month(y, m)))
+
+def xdate_arg(a):
+    if isinstance(a, str):
+        return float(DATEVALUE(a))
+    return float(a)
+
+def DAYS(end, start):
+    return float(int(xdate_arg(end)) - int(xdate_arg(start)))
+
+def xlast(y, m, d):
+    return d == xdays_in_month(y, m)
+
+def DAYS360(start, end, method=False):
+    sy, sm, sd = xserial_ymd(xdate_arg(start))
+    ey, em, ed = xserial_ymd(xdate_arg(end))
+    if method:
+        sd = min(sd, 30)
+        ed = min(ed, 30)
+    else:
+        if em == 2 and xlast(ey, em, ed):
+            raise Skip()  # Excel's treatment of an end date at the end of February is disputed
+        if xlast(sy, sm, sd):
+            sd = 30
+        if ed == 31:
+            if sd < 30:
+                em += 1
+                ed = 1
+            else:
+                ed = 30
+    return float(360 * (ey - sy) + 30 * (em - sm) + (ed - sd))
+
+def DATEDIF(start, end, unit):
+    start, end = xdate_arg(start), xdate_arg(end)
+    if start > end:
+        raise XErr(NUM)
+    sy, sm, sd = xserial_ymd(start)
+    ey, em, ed = xserial_ymd(end)
+    unit = unit.lower()
+    years = ey - sy - (1 if (em, ed) < (sm, sd) else 0)
+    months = (ey - sy) * 12 + em - sm - (1 if ed < sd else 0)
+    if unit == "y":
+        return float(years)
+    if unit == "m":
+        return float(months)
+    if unit == "d":
+        return float(int(end) - int(start))
+    if unit == "ym":
+        return float(months % 12)
+    if unit == "md":
+        if ed < sd:
+            raise Skip()  # Excel documents MD as unreliable here
+        return float(ed - sd)
+    if unit == "yd":
+        yy = sy if (em, ed) >= (sm, sd) else sy + 1
+        if ed > xdays_in_month(yy, em):
+            raise Skip()  # 29 February against a common year: Excel's answer is not documented
+        return float(xymd_serial(yy, em, ed) - xymd_serial(sy, sm, sd))
+    raise XErr(NUM)
+
+def xmask(weekend):
+    # the weekend as seven flags, Monday first
+    if isinstance(weekend, str):
+        if len(weekend) != 7 or any(c not in "01" for c in weekend):
+            raise XErr(VALUE)
+        mask = [c == "1" for c in weekend]
+        if all(mask):
+            raise XErr(VALUE)
+        return mask
+    w = int(trunc(weekend))
+    table = {1: (5, 6), 2: (6, 0), 3: (0, 1), 4: (1, 2), 5: (2, 3), 6: (3, 4), 7: (4, 5),
+             11: (6,), 12: (0,), 13: (1,), 14: (2,), 15: (3,), 16: (4,), 17: (5,)}
+    if w not in table:
+        raise XErr(NUM)
+    mask = [False] * 7
+    for i in table[w]:
+        mask[i] = True
+    return mask
+
+def xworkday(mask, s):
+    return not mask[(xwd(s) - 1) % 7]
+
+def xholidays(h):
+    if h is None:
+        return set()
+    if not isinstance(h, list):
+        h = [h]
+    return set(int(xdate_arg(v)) for v in h)
+
+def NETWORKDAYS_INTL(start, end, weekend=1.0, holidays=None):
+    start, end = int(xdate_arg(start)), int(xdate_arg(end))
+    mask = xmask(weekend)
+    hol = xholidays(holidays)
+    lo, hi = min(start, end), max(start, end)
+    n = sum(1 for s in range(lo, hi + 1) if xworkday(mask, s) and s not in hol)
+    return float(n if start <= end else -n)
+
+def NETWORKDAYS(start, end, holidays=None):
+    return NETWORKDAYS_INTL(start, end, 1.0, holidays)
+
+def WORKDAY_INTL(start, days, weekend=1.0, holidays=None):
+    s = int(xdate_arg(start))
+    days = int(trunc(days))
+    mask = xmask(weekend)
+    hol = xholidays(holidays)
+    step = 1 if days > 0 else -1
+    n = abs(days)
+    while n > 0:
+        s += step
+        if s < 0:
+            raise XErr(NUM)
+        if xworkday(mask, s) and s not in hol:
+            n -= 1
+    if s > XMAX:
+        raise XErr(NUM)
+    return float(s)
+
+def WORKDAY(start, days, holidays=None):
+    return WORKDAY_INTL(start, days, 1.0, holidays)
+
+def xleap(y):
+    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
+
+def YEARFRAC(start, end, basis=0.0):
+    start, end = int(xdate_arg(start)), int(xdate_arg(end))
+    if start > end:
+        start, end = end, start
+    if start <= 60:
+        raise Skip()
+    basis = int(trunc(basis))
+    if basis < 0 or basis > 4:
+        raise XErr(NUM)
+    if start == end:
+        return 0.0
+    if basis == 1 and start <= 366:
+        raise Skip()  # whether Excel counts 1900 as 366 days here is not modelled
+    sy, sm, sd = xserial_ymd(start)
+    ey, em, ed = xserial_ymd(end)
+    if basis == 0:
+        # US (NASD) 30/360, the OpenFormula/Excel order of the adjustments
+        sfeb, efeb = sm == 2 and xlast(sy, sm, sd), em == 2 and xlast(ey, em, ed)
+        if sfeb and efeb:
+            ed = 30
+        if sfeb:
+            sd = 30
+        if ed == 31 and sd >= 30:
+            ed = 30
+        if sd == 31:
+            sd = 30
+        return (360 * (ey - sy) + 30 * (em - sm) + (ed - sd)) / 360.0
+    if basis == 1:
+        days = end - start
+        if sy == ey:
+            return days / (366.0 if xleap(sy) else 365.0)
+        more_than_a_year = ey != sy + 1 or (sm, sd) < (em, ed)
+        if more_than_a_year:
+            total = sum(366 if xleap(y) else 365 for y in range(sy, ey + 1))
+            return days / (total / (ey - sy + 1))
+        if (xleap(sy) and (sm, sd) <= (2, 29)) or (xleap(ey) and (em, ed) >= (2, 29)):
+            return days / 366.0
+        return days / 365.0
+    if basis == 2:
+        return (end - start) / 360.0
+    if basis == 3:
+        return (end - start) / 365.0
+    if sd == 31:
+        sd = 30
+    if ed == 31:
+        ed = 30
+    return (360 * (ey - sy) + 30 * (em - sm) + (ed - sd)) / 360.0
+
+def TIME(h, m, s):
+    total = int(trunc(h)) * 3600 + int(trunc(m)) * 60 + int(trunc(s))
+    if total < 0:
+        raise XErr(NUM)
+    return (total % 86400) / 86400.0
+
+def xsecs(s):
+    s = float(s)
+    if s < 0:
+        raise XErr(NUM)
+    return int(round((s - math.floor(s)) * 86400)) % 86400
+
+def HOUR(s): return float(xsecs(s) // 3600)
+def MINUTE(s): return float(xsecs(s) // 60 % 60)
+def SECOND(s): return float(xsecs(s) % 60)
+
+def DATEVALUE(text):
+    t = text.strip()
+    if " " in t:
+        t = t.split(" ", 1)[0]
+    try:
+        if "-" in t:
+            y, m, d = (int(p) for p in t.split("-"))
+        else:
+            m, d, y = (int(p) for p in t.split("/"))
+        if y < 1900 or y > 9999:
+            raise XErr(VALUE)
+        if m < 1 or m > 12 or d < 1 or d > xdays_in_month(y, m):
+            raise XErr(VALUE)
+        return float(xymd_serial(y, m, d))
+    except ValueError:
+        raise XErr(VALUE)
+
+def TIMEVALUE(text):
+    t = text.strip().lower()
+    ampm = ""
+    for suffix in (" am", " pm"):
+        if t.endswith(suffix):
+            ampm, t = suffix.strip(), t[:-3]
+    parts = t.split(":")
+    try:
+        nums = [int(p) for p in parts]
+    except ValueError:
+        raise XErr(VALUE)
+    if len(nums) == 2:
+        h, m, s = nums[0], nums[1], 0
+    elif len(nums) == 3:
+        h, m, s = nums
+    else:
+        raise XErr(VALUE)
+    if m > 59 or s > 59:
+        raise Skip()  # Excel carries an overflowing minute or second when typing; TIMEVALUE's answer is not documented
+    if ampm:
+        if h == 0:
+            raise Skip()  # "0:12 pm": Excel's reading is not documented
+        if h > 12:
+            raise XErr(VALUE)
+        h = h % 12 + (12 if ampm == "pm" else 0)
+    elif h > 23:
+        raise Skip()  # "25:00" is a duration in Excel
+    return (h * 3600 + m * 60 + s) / 86400.0
+`
+
+// hzExcelEpoch: serial 61 is 1 March 1900; earlier real dates are one serial lower.
+var hzExcelEpoch = time.Date(1899, 12, 30, 0, 0, 0, 0, time.UTC)
+
+// hzSerial: Excel's serial of a real calendar date (y >= 1900).
+func hzSerial(y, m, d int) float64 {
+	t := time.Date(y, time.Month(m), d, 0, 0, 0, 0, time.UTC)
+	// in Unix days: a time.Duration overflows beyond about 292 years
+	s := float64((t.Unix() - hzExcelEpoch.Unix()) / 86400)
+	if t.Before(time.Date(1900, 3, 1, 0, 0, 0, 0, time.UTC)) {
+		s--
+	}
+	return s
+}
+
+// hzYMD: the Excel calendar date of a serial (serial 60 is 29 February 1900).
+func hzYMD(s float64) (int, int, int) {
+	n := int(math.Floor(s))
+	switch {
+	case n > 60:
+		t := hzExcelEpoch.AddDate(0, 0, n)
+		return t.Year(), int(t.Month()), t.Day()
+	case n == 60:
+		return 1900, 2, 29
+	case n == 0:
+		return 1900, 1, 0
+	}
+	t := time.Date(1899, 12, 31, 0, 0, 0, 0, time.UTC).AddDate(0, 0, n)
+	return t.Year(), int(t.Month()), t.Day()
+}
+
+const hzMaxSerial = 2958465
+
+// hzGenSerial draws a date serial: mostly real dates of 1900-9999, with the 1900 quirk region,
+// the ends of the range, negatives and times of day mixed in.
+func hzGenSerial(tc hegel.TestCase) float64 {
+	var s float64
+	switch hzDrawInt(tc, 0, 10) {
+	case 0: // the 1900 quirk region
+		s = float64(hzDrawInt(tc, 0, 62))
+	case 10: // the rest of Excel's first year
+		s = float64(hzDrawInt(tc, 61, 366))
+	case 1: // the far end
+		s = float64(hzMaxSerial + hzDrawInt(tc, -3, 3))
+	case 2: // negative
+		s = -float64(hzDrawInt(tc, 1, 1000))
+	case 3, 4, 5: // common years
+		s = hzSerial(hzDrawInt(tc, 1950, 2100), hzDrawInt(tc, 1, 12), hzDrawInt(tc, 1, 31))
+	default: // any year
+		s = hzSerial(hzDrawInt(tc, 1900, 9999), hzDrawInt(tc, 1, 12), hzDrawInt(tc, 1, 31))
+	}
+	if hzChance(tc, 25) {
+		s += float64(hzDrawInt(tc, 0, 86399)) / 86400
+	}
+	return s
+}
+
+// hzGenDay draws a whole-day serial of a real date (61 and up, within the range).
+func hzGenDay(tc hegel.TestCase) float64 {
+	if hzChance(tc, 60) {
+		return hzSerial(hzDrawInt(tc, 1950, 2100), hzDrawInt(tc, 1, 12), hzDrawInt(tc, 1, 31))
+	}
+	return hzSerial(hzDrawInt(tc, 1900, 9999), hzDrawInt(tc, 1, 12), hzDrawInt(tc, 1, 31))
+}
+
+// hzGenWeekend draws a weekend argument: a code, a seven-character mask or an invalid one.
+func hzGenWeekend(tc hegel.TestCase) hzArg {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		return hzN(float64(hzPick(tc, []int{0, 8, 10, 18, -1})))
+	case 1, 2:
+		var sb strings.Builder
+		for i := 0; i < 7; i++ {
+			if hzChance(tc, 35) {
+				sb.WriteByte('1')
+			} else {
+				sb.WriteByte('0')
+			}
+		}
+		return hzS(sb.String())
+	case 3:
+		return hzS(hzPick(tc, []string{"1111111", "000000", "00000000", "0000012", ""}))
+	case 4, 5, 6:
+		return hzN(float64(hzDrawInt(tc, 11, 17)))
+	}
+	return hzN(float64(hzDrawInt(tc, 1, 7)))
+}
+
+// hzGenHolidays draws a holiday range near a date (distinct dates while the recorded bug
+// holidayDuplicates is on).
+func hzGenHolidays(tc hegel.TestCase, near float64) hzArg {
+	n := hzDrawInt(tc, 1, 6)
+	h := make([]float64, 0, n)
+	seen := map[float64]bool{}
+	for i := 0; i < n; i++ {
+		v := math.Floor(near) + float64(hzDrawInt(tc, -10, 40))
+		if seen[v] && HZKnown.holidayDuplicates {
+			hzAvoid("holidayDuplicates")
+			continue
+		}
+		seen[v] = true
+		h = append(h, v)
+	}
+	return hzA(h)
+}
