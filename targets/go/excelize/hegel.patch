+def decode(a):
+    if "n" in a:
+        return float(a["n"]) + 0.0  # Excel has no negative zero
+    if "b" in a:
+        return bool(a["b"])
+    if "s" in a:
+        return a["s"]
+    return [float(v) for v in a["a"]]
