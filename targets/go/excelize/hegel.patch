+// hzTextAvoid says whether the case belongs to a recorded bug class, counting the avoidance.
+func hzTextAvoid(name string, args []hzArg) bool {
+	avoid := func(sw *bool, label string) bool {
+		if *sw {
+			hzAvoid(label)
+			return true
+		}
+		return false
+	}
+	// numbers converted to text
+	numberText := func(a hzArg) bool {
+		if a.kind != 'n' {
+			return false
+		}
+		v := math.Abs(a.num)
+		return v == 0 || v >= 1e6 || v < 1e-4 || hzNumLit(a.num) != hzFmt(a.num) || len(strings.Trim(hzNumLit(a.num), "-0.")) > 15
+	}
+	textArgs := map[string][]int{"CODE": {0}, "UNICODE": {0}, "CLEAN": {0}, "TRIM": {0}, "UPPER": {0}, "LOWER": {0}, "PROPER": {0}, "LEN": {0}, "LEFT": {0}, "RIGHT": {0}, "MID": {0}, "REPT": {0},
+		"EXACT": {0, 1}, "FIND": {0, 1}, "SEARCH": {0, 1}, "REPLACE": {0, 3}, "SUBSTITUTE": {0, 1, 2}, "TEXTAFTER": {0, 1}, "TEXTBEFORE": {0, 1}, "VALUETOTEXT": {0}}
+	if idx, ok := textArgs[name]; ok {
+		for _, i := range idx {
+			if i < len(args) && numberText(args[i]) && avoid(&HZKnown.numberText, "numberText") {
+				return true
+			}
+		}
+	}
+	if name == "CONCAT" || name == "CONCATENATE" || name == "TEXTJOIN" {
+		for i, a := range args {
+			if (name != "TEXTJOIN" || i >= 2) && numberText(a) && avoid(&HZKnown.numberText, "numberText") {
+				return true
+			}
+			if a.kind == 'a' {
+				for _, v := range a.arr {
+					if numberText(hzN(v)) && avoid(&HZKnown.numberText, "numberText") {
+						return true
+					}
+				}
+			}
+		}
+	}
+	if name == "TEXT" && len(args) == 2 && (args[1].s == "@" || args[1].s == "General") && numberText(args[0]) && avoid(&HZKnown.numberText, "numberText") {
+		return true
+	}
+	strArg := func(i int) (string, bool) {
+		if i < len(args) && args[i].kind == 's' {
+			return args[i].s, true
+		}
+		return "", false
+	}
+	textOf := func(i int) string {
+		if i >= len(args) {
+			return ""
+		}
+		switch args[i].kind {
+		case 's':
+			return args[i].s
+		case 'n':
+			return hzNumLit(args[i].num)
+		case 'b':
+			return strings.ToUpper(fmt.Sprint(args[i].b))
+		}
+		return ""
+	}
+	numArg := func(i int) (float64, bool) {
+		if i < len(args) && args[i].kind == 'n' {
+			return args[i].num, true
+		}
+		if i < len(args) && args[i].kind == 'b' {
+			if args[i].b {
+				return 1, true
+			}
+			return 0, true
+		}
+		return 0, false
+	}
+	nonASCII := func(s string) bool {
+		for _, r := range s {
+			if r > 127 {
+				return true
+			}
+		}
+		return false
+	}
+	switch name {
+	case "MID":
+		s := textOf(0)
+		st, ok1 := numArg(1)
+		n, ok2 := numArg(2)
+		if ok1 && ok2 && math.Trunc(st) >= 1 && n >= 0 && math.Trunc(st)+math.Trunc(n) == float64(len([]rune(s)))+2 && avoid(&HZKnown.midOverrun, "midOverrun") {
+			return true
+		}
+	case "TRIM":
+		s, _ := strArg(0)
+		if (strings.Contains(s, "  ") || strings.ContainsAny(s, "\t\n\r")) && avoid(&HZKnown.trimInterior, "trimInterior") {
+			return true
+		}
+	case "REPT":
+		if args[0].kind != 's' && avoid(&HZKnown.reptNumber, "reptNumber") {
+			return true
+		}
+		if n, ok := numArg(1); ok && n >= 1000 && avoid(&HZKnown.reptUnbounded, "reptUnbounded") {
+			return true
+		}
+	case "SUBSTITUTE":
+		if old, ok := strArg(1); ok && old == "" && avoid(&HZKnown.substituteEmpty, "substituteEmpty") {
+			return true
+		}
+	case "FIXED":
+		if len(args) == 1 && avoid(&HZKnown.fixedDefault, "fixedDefault") {
+			return true
+		}
+		if s, ok := strArg(2); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+			return true
+		}
+		if len(args) == 3 && (args[2].kind == 'b' && !args[2].b || args[2].kind == 'n' && args[2].num == 0 || args[2].kind == 's' && args[2].s == "FALSE") && avoid(&HZKnown.fixedNoCommas, "fixedNoCommas") {
+			return true
+		}
+		if d, ok := numArg(1); ok && (d > 15 || math.Abs(args[0].num)*math.Pow(10, math.Trunc(d)) >= 9e18 || hzHalfCase(args[0].num, int(math.Trunc(d)), false)) && avoid(&HZKnown.fixedRounding, "fixedRounding") {
+			return true
+		}
+	case "REPLACE":
+		s, _ := strArg(0)
+		if n, ok := numArg(2); (ok && n < 0 || nonASCII(s)) && avoid(&HZKnown.replaceBytes, "replaceBytes") {
+			return true
+		}
+	case "CODE", "UNICODE":
+		s, ok := strArg(0)
+		if ok && (s == "" || nonASCII(s[:min(len(s), 4)])) && avoid(&HZKnown.codeFirstByte, "codeFirstByte") {
+			return true
+		}
+	case "CHAR":
+		if n, ok := numArg(0); ok && n > -1 && n < 1 && avoid(&HZKnown.charZero, "charZero") {
+			return true
+		}
+	case "UNICHAR":
+		if n, ok := numArg(0); ok && (n >= 55295 || (n >= 0 && n < 1)) && avoid(&HZKnown.unicharRange, "unicharRange") {
+			return true
+		}
+	case "FIND", "SEARCH":
+		f, _ := strArg(0)
+		w, _ := strArg(1)
+		if name == "FIND" && strings.ContainsAny(f, "?*") && avoid(&HZKnown.findWildcards, "findWildcards") {
+			return true
+		}
+		if name == "SEARCH" && (strings.Contains(f, "~") || (strings.ContainsAny(f, "?*") && strings.ContainsAny(f, `\{}`))) && avoid(&HZKnown.searchEscapes, "searchEscapes") {
+			return true
+		}
+		if st, ok := numArg(2); ok && (math.Trunc(st) < 1 || math.Trunc(st) > float64(len([]rune(w)))) && avoid(&HZKnown.findStartNum, "findStartNum") {
+			return true
+		}
+	case "TEXTJOIN":
+		if args[1].kind != 'b' && avoid(&HZKnown.textjoinLogical, "textjoinLogical") {
+			return true
+		}
+	case "TEXTAFTER", "TEXTBEFORE":
+		w, _ := strArg(0)
+		d, _ := strArg(1)
+		for _, i := range []int{3, 4} {
+			if s, ok := strArg(i); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+			if v, ok := numArg(i); ok && args[i].kind == 'n' && v != 0 && v != 1 && avoid(&HZKnown.ifTruthiness, "ifTruthiness") {
+				return true
+			}
+		}
+		if (nonASCII(w) || nonASCII(d)) && avoid(&HZKnown.textAfterBytes, "textAfterBytes") {
+			return true
+		}
+		k := 1.0
+		if v, ok := numArg(2); ok {
+			k = math.Trunc(v)
+			if v != k && v > float64(len([]rune(w))) && avoid(&HZKnown.noTruncation, "noTruncation") {
+				return true
+			}
+		}
+		if d != "" && k != 0 {
+			t, dl := w, d
+			if m, ok := numArg(3); ok && m != 0 {
+				t, dl = strings.ToLower(w), strings.ToLower(d)
+			}
+			hits := strings.Count(t, dl)
+			matchEnd := 0.0
+			if len(args) > 4 && (args[4].kind == 'b' && args[4].b || args[4].kind == 'n' && args[4].num != 0 || args[4].kind == 's' && args[4].s == "TRUE") {
+				matchEnd = 1
+			}
+			if k < 0 && strings.HasPrefix(t, dl) && -k >= float64(hits) && avoid(&HZKnown.textAfterPanic, "textAfterPanic") {
+				return true
+			}
+			if k < 0 && strings.Contains(t, dl+dl) && avoid(&HZKnown.textAfterReverse, "textAfterReverse") {
+				return true
+			}
+			if math.Abs(k) > float64(hits)+matchEnd && avoid(&HZKnown.textAfterNotFound, "textAfterNotFound") {
+				return true
+			}
+		}
+	case "VALUE":
+		s, _ := strArg(0)
+		t := strings.TrimSpace(s)
+		low := strings.ToLower(t)
+		if t != s || (strings.Contains(t, ",") && !hzGroupedRe.MatchString(strings.TrimSuffix(t, "%"))) || strings.Contains(t, "_") ||
+			strings.HasPrefix(strings.TrimLeft(low, "+-"), "0x") || strings.HasPrefix(strings.TrimLeft(low, "+-"), "0b") || strings.HasPrefix(strings.TrimLeft(low, "+-"), "0o") ||
+			strings.Contains(low, "inf") || strings.Contains(low, "e400") {
+			if avoid(&HZKnown.valueParsing, "valueParsing") {
+				return true
+			}
+		}
+	case "VALUETOTEXT":
+		if s, ok := strArg(0); ok && len(args) == 2 && args[1].num == 1 {
+			if _, err := strconv.ParseFloat(s, 64); err == nil && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+				return true
+			}
+		}
+	case "TEXT":
+		if len(args) == 2 && args[0].kind == 'n' && !strings.ContainsAny(args[1].s, "ymdhs@G") {
+			f := args[1].s
+			pct := strings.HasSuffix(f, "%")
+			core := strings.TrimSuffix(f, "%")
+			places := 0
+			if i := strings.Index(core, "."); i >= 0 {
+				places = len(strings.TrimRight(core[i+1:], "E+0")) + strings.Count(core[i+1:], "0") - strings.Count(strings.TrimRight(core[i+1:], "E+0"), "0")
+				if strings.Contains(core, "E") {
+					places = len(strings.Split(strings.Split(core, ".")[1], "E")[0])
+				}
+			}
+			if hzHalfCase(args[0].num, places, strings.Contains(core, "E")) || pct && hzHalfCase(args[0].num*100, places, false) {
+				if avoid(&HZKnown.textRounding, "textRounding") {
+					return true
+				}
+			}
+		}
+	}
+	// the logical functions
+	switch name {
+	case "IF", "IFS":
+		for i := 0; i < len(args); i++ {
+			if name == "IF" && i > 0 || name == "IFS" && i%2 == 1 {
+				continue
+			}
+			if v, ok := numArg(i); ok && args[i].kind == 'n' && v != 0 && v != 1 && avoid(&HZKnown.ifTruthiness, "ifTruthiness") {
+				return true
+			}
+			if s, ok := strArg(i); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+		}
+		if name == "IF" && len(args) == 2 && avoid(&HZKnown.ifOmittedFalse, "ifOmittedFalse") {
+			return true
+		}
+		if name == "IF" {
+			for _, a := range args[1:] {
+				if (a.kind == 'b' || a.kind == 'e') && avoid(&HZKnown.ifResultTypes, "ifResultTypes") {
+					return true
+				}
+			}
+		}
+	case "XOR":
+		for _, a := range args {
+			if a.kind == 's' && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+		}
+	case "ISEVEN", "ISODD":
+		if s, isStr := strArg(0); isStr && strings.TrimSpace(s) != s {
+			if _, err := strconv.ParseFloat(strings.TrimSpace(s), 64); err == nil && avoid(&HZKnown.valueParsing, "valueParsing") {
+				return true
+			}
+		}
+		if name == "ISODD" {
+			if (args[0].kind == 'b' || args[0].kind == 'e') && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+				return true
+			}
+			break
+		}
+		v, ok := numArg(0)
+		if s, isStr := strArg(0); isStr {
+			if f, err := strconv.ParseFloat(s, 64); err == nil {
+				v, ok = f, true
+			}
+		}
+		if ok && args[0].kind != 'b' && v != 1 && int64(math.Trunc(v))%2 != 0 && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+			return true
+		}
+		if args[0].kind == 'b' && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+			return true
+		}
+	case "ISNUMBER":
+		if args[0].kind == 'b' && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+			return true
+		}
+	case "AND":
+		for i, a := range args {
+			zero := a.kind == 's' && a.s == "FALSE"
+			for _, v := range a.arr {
+				zero = zero || v == 0
+			}
+			if zero && i+1 < len(args) && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+		}
+	case "OR":
+		seenText := false
+		for i, a := range args {
+			if (a.kind == 'a' || a.kind == 'n' && a.num != 0 || a.kind == 'b' && a.b) && i+1 < len(args) && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+			if seenText && (a.kind == 'n' || a.kind == 'b') && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+			if a.kind == 's' && a.s == "TRUE" {
+				seenText = true
+			}
+		}
+	case "ISTEXT", "N", "ISLOGICAL":
+		if s, ok := strArg(0); ok {
+			if _, err := strconv.ParseFloat(s, 64); (err == nil || strings.EqualFold(s, "TRUE") || strings.EqualFold(s, "FALSE")) && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+				return true
+			}
+		}
+	case "SWITCH":
+		for i := 1; i+1 < len(args); i += 2 {
+			if (args[0].kind != args[i].kind || args[i].kind == 's') && avoid(&HZKnown.switchComparison, "switchComparison") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+var hzGroupedRe = regexp.MustCompile(`^[+-]?\d{1,3}(,\d{3})+(\.\d*)?$`)
+
+// hzHalfCase says whether rounding x to places decimals (or to places+1 significant digits
+// when sig) is a decimal half case, where binary rounding may differ from Excel's.
+func hzHalfCase(x float64, places int, sig bool) bool {
+	s := strings.TrimPrefix(hzNumLit(math.Abs(x)), "-")
+	if sig {
+		digits := strings.TrimLeft(strings.ReplaceAll(s, ".", ""), "0")
+		return len(digits) == places+2 && strings.HasSuffix(digits, "5")
+	}
+	_, frac, ok := strings.Cut(s, ".")
+	return ok && len(frac) == places+1 && strings.HasSuffix(frac, "5")
+}
+
+var hzLogicFuncs = []string{"AND", "OR", "XOR", "NOT", "IF", "IFS", "SWITCH", "IFERROR", "IFNA", "ISBLANK", "ISERR", "ISERROR", "ISNA", "ISLOGICAL", "ISNUMBER", "ISTEXT", "ISNONTEXT", "ISEVEN", "ISODD", "TYPE", "ERROR.TYPE", "N", "T", "NA", "TRUE", "FALSE"}
+
+// hzGenValue draws a value of any kind, errors included.
+func hzGenValue(tc hegel.TestCase, errors bool) hzArg {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0, 1, 2:
+		return hzN(hzGenTextNum(tc))
+	case 3, 4:
+		return hzB(hzGenBool(tc))
+	case 5, 6:
+		return hzS(hzGenText(tc, false))
+	case 7:
+		return hzS(hzPick(tc, []string{"TRUE", "FALSE", "1", "0", "", "1.5", "true"}))
+	default:
+		if errors {
+			return hzE(hzPick(tc, []string{"#N/A", "#DIV/0!", "#NUM!", "#VALUE!"}))
+		}
+		return hzN(float64(hzDrawInt(tc, -3, 3)))
+	}
+}
+
+// hzGenLogicArgs draws the arguments of a logical or information function.
+func hzGenLogicArgs(tc hegel.TestCase, name string) []hzArg {
+	switch name {
+	case "AND", "OR", "XOR":
+		n := hzDrawInt(tc, 1, 4)
+		args := make([]hzArg, n)
+		for i := range args {
+			if hzChance(tc, 15) {
+				args[i] = hzA(hzGenSeries(tc, hzDrawInt(tc, 1, 4)))
+			} else {
+				args[i] = hzGenLogical(tc)
+			}
+		}
+		return args
+	case "NOT":
+		return []hzArg{hzGenLogical(tc)}
+	case "IF":
+		args := []hzArg{hzGenLogical(tc), hzGenValue(tc, true)}
+		if hzChance(tc, 80) {
+			args = append(args, hzGenValue(tc, true))
+		}
+		return args
+	case "IFS":
+		n := hzDrawInt(tc, 1, 3)
+		var args []hzArg
+		for i := 0; i < n; i++ {
+			args = append(args, hzGenLogical(tc), hzGenValue(tc, false))
+		}
+		return args
+	case "SWITCH":
+		expr := hzGenValue(tc, false)
+		args := []hzArg{expr}
+		n := hzDrawInt(tc, 1, 3)
+		for i := 0; i < n; i++ {
+			v := hzGenValue(tc, false)
+			if hzChance(tc, 40) {
+				v = expr
+				if v.kind == 's' && hzChance(tc, 50) {
+					v = hzS(strings.ToUpper(v.s))
+				}
+			}
+			args = append(args, v, hzGenValue(tc, false))
+		}
+		if hzChance(tc, 50) {
+			args = append(args, hzGenValue(tc, false))
+		}
+		return args
+	case "IFERROR", "IFNA":
+		return []hzArg{hzGenValue(tc, true), hzGenValue(tc, false)}
+	case "NA", "TRUE", "FALSE":
+		return nil
+	default:
+		return []hzArg{hzGenValue(tc, true)}
+	}
+}
+
+func TestHegelText(t *testing.T) {
+	oracle := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		name := hzPick(ht, hzTextFuncs)
+		args := hzGenTextArgs(ht, name)
+		if hzTextAvoid(name, args) {
+			return
+		}
+		formula, cells := hzFormula(name, args)
+		want, err := oracle.eval(name, args)
+		if err != nil {
+			ht.Fatalf("%s: %v", formula, err)
+		}
+		got := hzCalc(formula, cells)
+		hzJudge(col, ht, name, hzDesc(formula, cells), got, want, 1e-12, 0)
+	})
+}
+
