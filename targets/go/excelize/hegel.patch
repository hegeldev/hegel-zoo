+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return "TRUE" if v else "FALSE"
+    if isinstance(v, str):
+        try:
+            v = float(v)
+        except ValueError:
+            return v
+    if isinstance(v, list):
+        raise Skip()
+    if fmt in DATEFMTS or fmt in TIMEFMTS:
