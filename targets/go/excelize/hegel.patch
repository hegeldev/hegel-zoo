+				v = hzN(hzGenTextNum(tc))
+			}
+			if places := strings.Count(strings.Split(strings.TrimSuffix(f, "%"), "E")[0], "0") - 1; hzChance(tc, 25) && strings.Contains(f, ".") && !strings.Contains(f, "E") {
+				v = hzN(hzHalfNumber(tc, places))
+				if strings.HasSuffix(f, "%") {
+					v = hzN(v.num / 100)
+				}
+			}
+		}
+		return []hzArg{v, hzS(f)}
+	case "TEXTAFTER", "TEXTBEFORE":
+		w := hzGenText(tc, false)
+		if hzChance(tc, 50) {
+			d := hzPick(tc, []string{"-", ",", " ", "a", "ab", "é"})
+			var sb strings.Builder
+			for i := hzDrawInt(tc, 0, 4); i > 0; i-- {
+				piece := []rune(hzGenText(tc, false))
+				sb.WriteString(string(piece[:min(3, len(piece))]))
+				sb.WriteString(d)
+			}
+			w = sb.String() + hzGenSub(tc, "xyz")
+		}
+		if hzChance(tc, 20) {
+			// adjacent delimiters, a delimiter at the start, a case-insensitive match
+			d := hzPick(tc, []string{"-", "ab", "p"})
+			if hzChance(tc, 30) {
+				d = hzPick(tc, []string{"ab", "p"})
+				return []hzArg{hzS("x" + strings.ToUpper(d) + "y" + d + "z"), hzS(d), hzN(1), hzN(float64(hzDrawInt(tc, 2, 3)))}
+			}
+			if hzChance(tc, 30) {
+				// a delimiter at the start, reached backwards with the start as match_end
+				return []hzArg{hzS(d + "abc"), hzS(d), hzN(-2), hzB(false), hzB(true)}
+			}
+			w = hzPick(tc, []string{d + "x" + d + d + "y", d + d + "x", "x" + d + d, d + "abc"})
+			args := []hzArg{hzS(w), hzS(d), count(-4, 4)}
+			if hzChance(tc, 50) {
+				args = append(args, hzB(false), hzB(true))
+			}
+			return args
+		}
+		args := []hzArg{hzS(w), hzS(hzGenSub(tc, w))}
+		if hzChance(tc, 60) {
+			args = append(args, count(-4, 4))
+		}
+		if len(args) == 3 && hzChance(tc, 50) {
+			args = append(args, hzGenLogical(tc))
+		}
+		if len(args) == 4 && hzChance(tc, 50) {
+			args = append(args, hzGenLogical(tc))
+		}
+		if len(args) == 5 && hzChance(tc, 50) {
+			args = append(args, hzS("nf"))
+		}
+		return args
+	case "VALUE":
+		return []hzArg{hzS(hzGenValueText(tc))}
+	case "VALUETOTEXT":
+		if hzChance(tc, 20) {
+			return []hzArg{hzS(hzPick(tc, []string{"2", "1.5", "TRUE", "-3", "1e3"})), hzN(1)}
+		}
+		if hzChance(tc, 50) {
+			return []hzArg{hzGenAny(tc)}
+		}
+		return []hzArg{hzGenAny(tc), count(0, 2)}
+	}
+	return []hzArg{text()}
+}
