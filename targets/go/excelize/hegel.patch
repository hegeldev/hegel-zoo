+		hzW(1, fn("PERMUTATIONA", negatives, floats(hzInts(0, 10)))),
+		hzW(1, fn("PERMUTATIONA", floats(hzInts(0, 10)), negatives)),
+		hzW(1, casesOf("GCD", withANegative)),
+		hzW(1, casesOf("LCM", withANegative)),
+		hzW(1, fn("BASE", smallNats, hzSampled(1.0, 37, 0, -2, 100, -36, 1.9, 37.5))),
+		hzW(1, casesOf("DECIMAL", hzTuple(decimalTexts, num(hzSampled(1.0, 37, -2, 100, 1.9, 37.5))))),
+		hzW(1, casesOf("DECIMAL", decimalAbove)),
+		hzW(1, fn("CEILING", positives, negativeSigs)),
+		hzW(1, fn("FLOOR", numbers, zero)),
+	),
+	hzWeighted(
+		hzW(1, casesOf("COMBIN", chosenWithin)),
+		hzW(1, combinaWithin),
+		hzW(1, casesOf("PERMUT", chosenWithin)),
+		hzW(1, fn("PERMUTATIONA", floats(hzInts(0, 10)), floats(hzInts(0, 10)))),
+		hzW(1, casesOf("GCD", hzCounted(num(ints1to30), 1, 5))),
+		hzW(1, casesOf("LCM", hzCounted(num(ints1to30), 1, 5))),
+		hzW(1, fn("BASE", smallNats, validRadixes)),
+		hzW(1, casesOf("DECIMAL", decimalWithin)),
+		hzW(1, fn("CEILING", floats(hzInts(1, 1000)), integerSigs)),
+		hzW(1, fn("FLOOR", floats(hzInts(1, 1000)), integerSigs)),
