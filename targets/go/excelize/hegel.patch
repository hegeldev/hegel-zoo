+type hzOracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	src := strings.Replace(hzOracleScript, "\ndef decode(a):", hzOracleDate+hzOracleText+"\ndef decode(a):", 1)
+	src = strings.Replace(src, "    if \"s\" in a:\n", "    if \"e\" in a:\n        return XE(a[\"e\"])\n    if \"s\" in a:\n", 1)
+	src = strings.Replace(src, `fn = globals()[req["name"].replace(".", "_")]`, `fn = XFUNCS.get(req["name"]) or globals()[req["name"].replace(".", "_")]`, 1)
+	if strings.Count(src, "XE(a[") != 1 || strings.Count(src, "XFUNCS.get") != 1 {
+		t.Fatal("oracle script: the decode hook was not inserted")
+	}
+	if err := os.WriteFile(script, []byte(src), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<22)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+// hzArg is one argument of a formula: a number, a boolean, a string or a range (a column of
+// numbers written to the sheet).
+type hzArg struct {
+	kind byte // 'n', 'b', 's', 'a'
+	num  float64
+	b    bool
+	s    string
+	arr  []float64
+}
+
+func hzN(v float64) hzArg   { return hzArg{kind: 'n', num: v} }
+func hzB(v bool) hzArg      { return hzArg{kind: 'b', b: v} }
+func hzS(v string) hzArg    { return hzArg{kind: 's', s: v} }
+func hzA(v []float64) hzArg { return hzArg{kind: 'a', arr: v} }
+
+func (a hzArg) json() map[string]any {
+	switch a.kind {
+	case 'n':
+		return map[string]any{"n": hzFmt(a.num)}
+	case 'b':
+		return map[string]any{"b": a.b}
+	case 's':
+		return map[string]any{"s": a.s}
+	case 'e':
+		return map[string]any{"e": a.s}
+	}
+	return map[string]any{"a": hzFmts(a.arr)}
+}
+
+// hzExpect is the oracle's verdict: a number, a boolean, a string, an Excel error (code "" when
+// any error is right) or skip.
+type hzExpect struct {
+	t    string // "n", "b", "s", "e", "skip"
+	num  float64
+	b    bool
+	s    string
+	code string
+}
+
+func (e hzExpect) String() string {
+	switch e.t {
+	case "n":
+		return hzFmt(e.num)
+	case "b":
+		return fmt.Sprint(e.b)
+	case "s":
+		return fmt.Sprintf("%q", e.s)
+	case "e":
+		if e.code == "" {
+			return "an error"
+		}
+		return e.code
+	}
+	return "skip"
+}
+
+func (o *hzOracle) eval(name string, args []hzArg) (hzExpect, error) {
+	js := make([]map[string]any, len(args))
+	for i, a := range args {
+		js[i] = a.json()
+	}
+	b, err := json.Marshal(map[string]any{"name": name, "args": js})
+	if err != nil {
+		return hzExpect{}, err
+	}
+	o.in.Write(b)
+	o.in.WriteByte('\n')
+	if err := o.in.Flush(); err != nil {
+		return hzExpect{}, err
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		return hzExpect{}, fmt.Errorf("oracle: %v", err)
+	}
+	var r struct {
+		OK *struct {
+			T string          `json:"t"`
+			V json.RawMessage `json:"v"`
+		} `json:"ok"`
+		Error string `json:"error"`
+	}
+	if err := json.Unmarshal(line, &r); err != nil {
+		return hzExpect{}, fmt.Errorf("oracle reply %q: %v", line, err)
+	}
+	if r.Error != "" || r.OK == nil {
+		return hzExpect{}, fmt.Errorf("oracle: %s", r.Error)
+	}
+	e := hzExpect{t: r.OK.T}
+	switch e.t {
+	case "n":
+		var s string
+		if err := json.Unmarshal(r.OK.V, &s); err != nil {
+			return e, err
+		}
+		e.num = hzParse(s)
+	case "b":
+		if err := json.Unmarshal(r.OK.V, &e.b); err != nil {
+			return e, err
+		}
+	case "s":
+		if err := json.Unmarshal(r.OK.V, &e.s); err != nil {
+			return e, err
+		}
+	case "e":
+		if err := json.Unmarshal(r.OK.V, &e.code); err != nil {
+			return e, err
+		}
+	}
+	return e, nil
+}
+
+// hzParse reads Python's repr of a float (and Go's own formatting).
+func hzParse(s string) float64 {
+	switch s {
+	case "nan", "NaN":
+		return math.NaN()
+	case "inf", "+Inf":
+		return math.Inf(1)
+	case "-inf", "-Inf":
+		return math.Inf(-1)
+	}
+	v, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		panic(fmt.Sprintf("oracle float %q: %v", s, err))
+	}
+	return v
+}
+
+func hzFmt(v float64) string { return strconv.FormatFloat(v, 'g', -1, 64) }
+
+func hzFmts(xs []float64) []string {
+	out := make([]string, len(xs))
+	for i, v := range xs {
+		out[i] = hzFmt(v)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// hzClose: a and b agree within rtol of the larger magnitude plus atol; NaN agrees with NaN,
+// infinities with the same infinity.
+func hzClose(a, b, rtol, atol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if math.IsInf(a, 0) || math.IsInf(b, 0) {
+		return a == b
+	}
+	d := math.Abs(a - b)
+	return d <= atol+rtol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+func hzShow(xs []float64) string {
+	if len(xs) > 12 {
+		return fmt.Sprintf("%v ... (%d values)", xs[:12], len(xs))
+	}
+	return fmt.Sprintf("%v", xs)
+}
