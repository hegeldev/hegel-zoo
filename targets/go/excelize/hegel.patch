+    if len(rest) % 2 == 1:
+        return xresult(rest[-1])
+    raise XErr(NA)
+
+def IFERROR(v, alt):
+    if isinstance(v, XE):
+        return xresult(alt)
+    return xresult(v)
+
+def IFNA(v, alt):
+    if isinstance(v, XE) and v.code == NA:
