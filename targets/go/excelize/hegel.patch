+// errorCodesAsDocumented: the Math functions that return an error with a code other than
+// the documented one: COMBIN and PERMUT with number_chosen above number, COMBINA and PERMUT
+// with a negative, PERMUTATIONA, GCD and LCM with a negative, BASE and DECIMAL with a radix
+// out of 2..36 (not 0: excelize/19), DECIMAL with a digit at or above the radix, CEILING of
+// a positive number with a negative significance, FLOOR with significance 0. Past the
+// shape, the documented domains. Hit rate 1000 of 1000.
+var errorCodesAsDocumented = hzShaped(
+	hzWeighted(
+		hzW(1, casesOf("COMBIN", chosenAbove)),
+		hzW(1, fn("COMBINA", negatives, floats(hzInts(0, 10)))),
+		hzW(1, fn("COMBINA", floats(hzInts(1, 10)), negatives)),
+		hzW(1, fn("COMBINA", zero, floats(hzInts(1, 10)))),
