+    return xresult(v)
+
+def ISBLANK(v):
+    return False
+
+def ISERR(v):
+    return isinstance(v, XE) and v.code != NA
+
+def ISERROR(v):
+    return isinstance(v, XE)
+
+def ISNA(v):
+    return isinstance(v, XE) and v.code == NA
+
+def ISLOGICAL(v):
+    return isinstance(v, bool)
+
+def ISNUMBER(v):
