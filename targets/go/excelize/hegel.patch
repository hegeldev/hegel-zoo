+// zeroish: a value that truncates to 0: 0 itself, a tenth, or a unit fraction.
+var zeroish = hzWeighted(
+	hzW(1, zero),
+	hzW(1, overTens(hzInts(1, 9), 1, 1)),
+	hzW(1, unitFractions),
+)
