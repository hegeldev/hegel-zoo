+package hegel
+
+// The shape regions of the recorded Dist bugs (bugs.toml excelize/10, 11, 12, 13, 14, 15,
+// 16, 21, 25, 26, 27, 28, 30, 32, 84 and 85) and the narrow properties over them: each region is a
+// generator over the bug's shape with random contents, judged exactly like the wide property
+// (judgeDist, with the classifier distShape naming the bug). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next to the shape
+// instead (hzShaped) and the property passes (the check-level shapes of excelize/12 and 26
+// are judged at the relaxed tolerance instead, every case counted as known). The hit rates
+// quoted at each region are the collector's mismatches over its cases (ZOO_COLLECT=1
+// HEGEL_TEST_CASES=1000); the regions whose shape is a relation of the arguments are
+// hegel.Filter over the classifier (distShaped), with the share of draws kept quoted.
+
+import (
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowDist runs a narrow property: every drawn case through the wide property's judge.
+func narrowDist(t *testing.T, cases hegel.Generator[distCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeDist(j, o, c)
+		col.count("cases")
+	})
+}
+
+// distOf: the cases NAME(args).
+func distOf(name string, args hegel.Generator[[]hzArg]) hegel.Generator[distCase] {
+	return hegel.Map(args, func(a []hzArg) distCase { return distCase{name: name, args: a} })
+}
+
+// distShaped: the cases of g that have the shape of the bug id by the classifier ("" for the
+// cases with no shape).
+func distShaped(id string, g hegel.Generator[distCase]) hegel.Generator[distCase] {
+	return hegel.Filter(g, func(c distCase) bool { return distShape(c, hzExpect{}) == id })
+}
+
+// just: the one argument, draw-free.
+func just(v float64) hegel.Generator[hzArg] { return hegel.Just(hzN(v)) }
+
+var (
+	isCum  = hegel.Just(hzB(true))
+	isDens = hegel.Just(hzB(false))
+	// plainDegrees: 1..40.
+	plainDegrees = floats(hzInts(1, 40))
+	// plainCounts: 0..30.
+	plainCounts = floats(hzInts(0, 30))
+	// plainProbs: thousandths of (0, 1).
+	plainProbs = overTens(hzInts(1, 999), 3, 3)
+	// plainShapes: tenths of [0.5, 15].
+	plainShapes = overTens(hzInts(5, 150), 1, 1)
+	// smallShapes: hundredths of [0.05, 0.95].
+	smallShapes = overTens(hzInts(5, 95), 2, 2)
+	// nonzeroScores: thousandths of [-6, 6] without 0.
+	nonzeroScores = signed(overTens(hzInts(1, 6000), 3, 3), 50)
+	// positiveScales: thousandths of (0, 20].
+	positiveScales = overTens(hzInts(1, 20000), 3, 3)
+)
+
+// --------------------------------------------------------------------------- excelize/10
+
+// infiniteDist: the results that are +INF or -INF where Excel has #NUM!: GAMMA from 171.625,
+// the densities at x = 0 with a singular factor (CHISQ.DIST at df 1, F.DIST at d1 = 1, the
+// gamma and Weibull densities at a shape below 1), F.INV at p = 1 (FINV's 1 is its lower
+// end, 0, right), BESSELI of a negative order and BESSELJ(0) of one, LOGNORM.INV and LOGINV
+// with exp(mean + sd z) overflowing (sd 1000, p from 0.8). Past the shape, the same
+// functions inside their domains (GAMMA below 171, x above 0, p below 1, orders from 0, sd
+// 100). Hit rate 1000 of 1000.
+var infiniteDist = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("GAMMA", hzTuple(num(overflowX)))),
+		hzW(1, distOf("CHISQ.DIST", hzTuple(just(0), just(1), isDens))),
+		hzW(1, distOf("F.DIST", hzTuple(just(0), just(1), num(plainDegrees), isDens))),
+		hzW(1, distOf("GAMMA.DIST", hzTuple(just(0), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("GAMMADIST", hzTuple(just(0), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("WEIBULL", hzTuple(just(0), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("WEIBULL.DIST", hzTuple(just(0), num(smallShapes), num(positiveScales), isDens))),
+		hzW(2, distOf("F.INV", hzTuple(just(1), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("BESSELI", hzTuple(num(nonzeroScores), num(floats(hzInts(-5, -1)))))),
+		hzW(1, distOf("BESSELJ", hzTuple(just(0), num(floats(hzInts(-5, -1)))))),
+		hzW(1, distOf("LOGNORM.INV", hzTuple(num(overTens(hzInts(800, 990), 3, 3)), num(locations), just(1000)))),
+		hzW(1, distOf("LOGINV", hzTuple(num(overTens(hzInts(800, 990), 3, 3)), num(locations), just(1000)))),
+	),
+	hzWeighted(
+		hzW(2, distOf("GAMMA", hzTuple(num(overTens(hzInts(1, 1700), 1, 1))))),
+		hzW(1, distOf("CHISQ.DIST", hzTuple(num(positiveScales), just(1), isDens))),
+		hzW(1, distOf("F.DIST", hzTuple(num(positiveScales), just(1), num(plainDegrees), isDens))),
+		hzW(1, distOf("GAMMA.DIST", hzTuple(num(positiveScales), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("GAMMADIST", hzTuple(num(positiveScales), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("WEIBULL", hzTuple(num(positiveScales), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("WEIBULL.DIST", hzTuple(num(positiveScales), num(smallShapes), num(positiveScales), isDens))),
+		hzW(1, distOf("F.INV", hzTuple(num(plainProbs), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("FINV", hzTuple(num(plainProbs), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("BESSELI", hzTuple(num(nonzeroScores), num(floats(hzInts(0, 5)))))),
+		hzW(1, distOf("BESSELJ", hzTuple(num(nonzeroScores), num(floats(hzInts(0, 5)))))),
+		hzW(1, distOf("LOGNORM.INV", hzTuple(num(plainProbs), num(locations), just(100)))),
+		hzW(1, distOf("LOGINV", hzTuple(num(plainProbs), num(locations), just(100)))),
+	),
+)
+
+func TestHegelDistInfiniteResultsAreErrors(t *testing.T) { narrowDist(t, infiniteDist) }
+
+// --------------------------------------------------------------------------- excelize/11
+
+// farBetaTail: the cases of g whose cumulative, built on a reflected incomplete beta, is
+// below 1e-10 (the classifier names excelize/11 from 1e-8, where the rounding of 1 - (1 - r)
+// is more than the tolerance with probability 1 - value / 1.1e-8: the region draws where it
+// is nearly always).
+func farBetaTail(g hegel.Generator[distCase]) hegel.Generator[distCase] {
+	return hegel.Filter(g, func(c distCase) bool {
+		v := betaTailOf(c)
+		return v >= 0 && v < 1e-10
+	})
+}
+
+// farTails: the cumulatives that flush or cancel their far lower tail: the normal family at
+// z in [-36.5, -6.5] (NORM.DIST and NORMDIST through mean + sd z, LOGNORM.DIST and
+// LOGNORMDIST through exp(mean + sd z)), F.DIST at a small x (farBetaTail: 4 draws in 5
+// kept) and F.DIST.RT and FDIST at a large one (97 in 100 kept) where the true value is
+// below 1e-10, NEGBINOM.DIST cumulative at a small p and 10 or more successes (7 in 8 kept),
+// CHISQ.DIST.RT and CHIDIST at an odd df of 1, 3 or 5 and x in [60, 300]. Past the shape, z
+// in [-5, 5], x and p in the middle of the distributions. Hit rate 999 of 1000.
+var farTails = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("NORM.S.DIST", hzTuple(num(farScores), isCum))),
+		hzW(1, distOf("NORMSDIST", hzTuple(num(farScores)))),
+		hzW(1, distOf("NORM.DIST", farNormal)),
+		hzW(1, distOf("NORMDIST", farNormal)),
+		hzW(1, distOf("LOGNORM.DIST", farLognormal(true))),
+		hzW(1, distOf("LOGNORMDIST", farLognormal(false))),
+		hzW(1, farBetaTail(distOf("F.DIST", hzTuple(num(overTens(hzInts(1, 50), 4, 4)), num(floats(hzInts(5, 40))), num(plainDegrees), isCum)))),
+		hzW(1, farBetaTail(distOf("F.DIST.RT", hzTuple(num(floats(hzInts(50, 1000))), num(floats(hzInts(2, 40))), num(floats(hzInts(15, 40))))))),
+		hzW(1, farBetaTail(distOf("FDIST", hzTuple(num(floats(hzInts(50, 1000))), num(floats(hzInts(2, 40))), num(floats(hzInts(15, 40))))))),
+		hzW(1, farBetaTail(distOf("NEGBINOM.DIST", hzTuple(num(plainCounts), num(floats(hzInts(10, 30))), num(overTens(hzInts(1, 100), 3, 3)), isCum)))),
+		hzW(1, distOf("CHISQ.DIST.RT", hzTuple(num(floats(hzInts(60, 300))), num(hzSampled(1.0, 3, 5))))),
+		hzW(1, distOf("CHIDIST", hzTuple(num(floats(hzInts(60, 300))), num(hzSampled(1.0, 3, 5))))),
+	),
+	hzWeighted(
+		hzW(2, distOf("NORM.S.DIST", hzTuple(num(overTens(hzInts(-5000, 5000), 3, 3)), isCum))),
+		hzW(1, distOf("NORMSDIST", hzTuple(num(overTens(hzInts(-5000, 5000), 3, 3))))),
+		hzW(1, distOf("NORM.DIST", hzTuple(num(overTens(hzInts(-5000, 5000), 3, 3)), just(0), just(1), isCum))),
+		hzW(1, distOf("NORMDIST", hzTuple(num(overTens(hzInts(-5000, 5000), 3, 3)), just(0), just(1), isCum))),
+		hzW(1, distOf("LOGNORM.DIST", hzTuple(num(overTens(hzInts(3, 20000), 3, 3)), just(0), just(1), isCum))),
+		hzW(1, distOf("LOGNORMDIST", hzTuple(num(overTens(hzInts(3, 20000), 3, 3)), just(0), just(1)))),
+		hzW(1, distOf("F.DIST", hzTuple(num(overTens(hzInts(5, 50), 1, 1)), num(plainDegrees), num(plainDegrees), isCum))),
+		hzW(1, distOf("F.DIST.RT", hzTuple(num(overTens(hzInts(5, 50), 1, 1)), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("FDIST", hzTuple(num(overTens(hzInts(5, 50), 1, 1)), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("NEGBINOM.DIST", hzTuple(num(plainCounts), num(floats(hzInts(1, 5))), num(overTens(hzInts(3, 9), 1, 1)), isCum))),
+		hzW(1, distOf("CHISQ.DIST.RT", hzTuple(num(floats(hzInts(1, 20))), num(hzSampled(1.0, 3, 5))))),
+		hzW(1, distOf("CHIDIST", hzTuple(num(floats(hzInts(1, 20))), num(hzSampled(1.0, 3, 5))))),
+	),
+)
+
+func TestHegelDistKeepsTheFarTails(t *testing.T) { narrowDist(t, farTails) }
+
+// --------------------------------------------------------------------------- excelize/12
+
+// normInvInexact: the inverse normals over thousandths of (0, 1) but 0.5 (the one exact
+// quantile): NORM.S.INV and NORMSINV, NORM.INV and NORMINV with a mean of 0 (a large mean
+// would hide the error of a small scale), LOGNORM.INV and LOGINV with a scale of 1..100.
+// The quantile is accurate to 1.15e-9, so the result misses the tolerance of 1e-12 (a check
+// of the judge, not a drawn shape; under HEGEL_NO_KNOWN=1 the same cases are judged at the
+// relaxed tolerance and each counted as known). Hit rate 1000 of 1000.
+var normInvInexact = hegel.Filter(hzWeighted(
+	hzW(2, distOf("NORM.S.INV", hzTuple(num(plainProbs)))),
+	hzW(1, distOf("NORMSINV", hzTuple(num(plainProbs)))),
+	hzW(1, distOf("NORM.INV", hzTuple(num(plainProbs), just(0), num(positiveScales)))),
+	hzW(1, distOf("NORMINV", hzTuple(num(plainProbs), just(0), num(positiveScales)))),
+	hzW(1, distOf("LOGNORM.INV", hzTuple(num(plainProbs), num(locations), num(floats(hzInts(1, 100)))))),
+	hzW(1, distOf("LOGINV", hzTuple(num(plainProbs), num(locations), num(floats(hzInts(1, 100)))))),
+), func(c distCase) bool { return c.args[0].num != 0.5 })
+
+func TestHegelDistNormInvIsExact(t *testing.T) { narrowDist(t, normInvInexact) }
+
+// --------------------------------------------------------------------------- excelize/13
+
+// inverseSearches: CHISQ.INV.RT and CHIINV at p in [1e-7, 1e-4] (the quantile above the
+// bound 5 df or beyond the series, df 1..200: measured, every one of 276 grid points fails),
+// GAMMA.INV and GAMMAINV at p in [0.999, 0.999999] with alpha 3..100 (every one of 150),
+// BETA.INV and BETAINV over the flat U-shaped region (every one of 170 grid points at the
+// three shapes). Past the shape, CHISQ.INV (the left tail, a different path) and BETA.INV at
+// shapes from 0.2 (the function-wide shape has no region past it: those four functions are
+// off the table under HEGEL_NO_KNOWN=1). Hit rate 1000 of 1000.
+var inverseSearches = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("CHISQ.INV.RT", hzTuple(num(overTens(hzInts(1, 1000), 7, 10)), num(floats(hzInts(1, 200)))))),
+		hzW(1, distOf("CHIINV", hzTuple(num(overTens(hzInts(1, 1000), 7, 10)), num(floats(hzInts(1, 200)))))),
+		hzW(1, distOf("GAMMA.INV", hzTuple(num(hegel.Map(overTens(hzInts(1, 1000), 6, 6), func(d float64) float64 { return 1 - d })), num(floats(hzInts(3, 100))), num(hzSampled(1.0, 0.5, 2, 10))))),
+		hzW(1, distOf("GAMMAINV", hzTuple(num(hegel.Map(overTens(hzInts(1, 1000), 6, 6), func(d float64) float64 { return 1 - d })), num(floats(hzInts(3, 100))), num(hzSampled(1.0, 0.5, 2, 10))))),
+		hzW(1, distOf("BETA.INV", flatBetaInv)),
+		hzW(1, distOf("BETAINV", flatBetaInv)),
+	),
+	hzWeighted(
+		hzW(2, distOf("CHISQ.INV", hzTuple(num(plainProbs), num(plainDegrees)))),
+		hzW(1, distOf("BETA.INV", hzTuple(num(overTens(hzInts(200, 800), 3, 3)), num(overTens(hzInts(2, 20), 1, 1)), num(overTens(hzInts(2, 20), 1, 1))))),
+		hzW(1, distOf("BETAINV", hzTuple(num(overTens(hzInts(200, 800), 3, 3)), num(overTens(hzInts(2, 20), 1, 1)), num(overTens(hzInts(2, 20), 1, 1))))),
+	),
+)
+
+func TestHegelDistInverseSearchesConverge(t *testing.T) { narrowDist(t, inverseSearches) }
+
+// --------------------------------------------------------------------------- excelize/14
+
+// hypgeomShifted: cumulative HYPGEOM.DIST over a support starting above 0 (shiftedHyper,
+// filtered on the classifier: 98 draws in 100 kept, the rest sum garbage below the
+// tolerance). Past the shape, a support starting at 0. Hit rate 1000 of 1000.
+var hypgeomShifted = hzShaped(
+	distShaped("excelize/14", distOf("HYPGEOM.DIST", shiftedHyper)),
+	distOf("HYPGEOM.DIST", hzSeq(zeroStartHyper, hegel.Just([]hzArg{hzB(true)}))),
+)
+
+func TestHegelDistHypgeomSumsTheSupport(t *testing.T) { narrowDist(t, hypgeomShifted) }
+
+// --------------------------------------------------------------------------- excelize/15
+
+// halfDegrees: 1.5..40.5, a df and a half.
+var halfDegrees = hegel.Map(hzInts(1, 40), func(i int) float64 { return float64(i) + 0.5 })
+
+// halfCounts: 0.5..30.5, a count and a half; lowHalfOrders and highHalfOrders: the Bessel
+// orders 0.5..5.5 (J and I: a higher order makes the result smaller than the absolute
+// tolerance at a small x) and 2.5..30.5 (Y and K: below 2 the integer part is taken, right).
+var (
+	halfCounts     = hegel.Map(hzInts(0, 30), func(i int) float64 { return float64(i) + 0.5 })
+	lowHalfOrders  = hegel.Map(hzInts(0, 5), func(i int) float64 { return float64(i) + 0.5 })
+	highHalfOrders = hegel.Map(hzInts(2, 30), func(i int) float64 { return float64(i) + 0.5 })
+)
+
+// chiBelowOneDf: x, df with df in (0, 1) by hundredths and x in [df/2, 2 df] (CHIDIST and
+// CHISQ.DIST.RT accept the df, want #NUM!; a fractional df from 1 they take as it is, as the
+// oracle does).
+var chiBelowOneDf = hegel.Map(hzTuple(overTens(hzInts(1, 99), 2, 2), overTens(hzInts(50, 200), 2, 2)), func(v []float64) []hzArg {
+	return []hzArg{hzN(v[0] * v[1]), hzN(v[0])}
+})
+
+// fractionalArgs: the functions that use a fractional df, count, tails or order as it is: the
+// t, chi-squared and F families at a df and a half (x nonzero: at 0 the t cumulative is 0.5
+// whatever the df; x in the body of the F: a tail of 1 within 1e-8 hides the df), CHIDIST
+// and CHISQ.DIST.RT at a df below 1 (a fractional df from 1 they take as it is, as the
+// oracle does: not a shape), TDIST with 1.5 or 2.5 tails, the
+// Poisson and the binomial densities at a count and a half (the cumulatives sum to the
+// integer below and are right), the binomial at trials and a half, the negative binomial at
+// a count and a half, HYPGEOM.DIST and HYPGEOMDIST with a half added to x, n or M (14 draws
+// in 100 agree: #NUM! on both sides, or a coincidence of the truncated factorials), BESSELJ
+// and BESSELI at an order and a half to 5.5 (x from 0.5: a result below the absolute
+// tolerance 1e-7 passes), BESSELY and BESSELK at an order and a half from 2.5 (below 2 the
+// library takes the integer part, right). Past the shape, the integers. Hit rate 980 of
+// 1000 (the hypergeometric coincidences).
+var fractionalArgs = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("T.DIST", hzTuple(num(nonzeroScores), num(halfDegrees), cumulatives))),
+		hzW(1, distOf("T.DIST.2T", hzTuple(num(overTens(hzInts(1, 6000), 3, 3)), num(halfDegrees)))),
+		hzW(1, distOf("T.DIST.RT", hzTuple(num(nonzeroScores), num(halfDegrees)))),
+		hzW(1, distOf("T.INV", hzTuple(num(overTens(hzInts(1, 400), 3, 3)), num(halfDegrees)))),
+		hzW(1, distOf("T.INV.2T", hzTuple(num(overTens(hzInts(1, 900), 3, 3)), num(halfDegrees)))),
+		hzW(1, distOf("TINV", hzTuple(num(overTens(hzInts(1, 900), 3, 3)), num(halfDegrees)))),
+		hzW(1, distOf("TDIST", hzTuple(num(overTens(hzInts(1, 6000), 3, 3)), num(plainDegrees), num(hzSampled(1.5, 2.5))))),
+		hzW(1, distOf("CHISQ.DIST", hzTuple(num(positiveScales), num(halfDegrees), cumulatives))),
+		hzW(1, distOf("CHISQ.DIST.RT", chiBelowOneDf)),
+		hzW(1, distOf("CHIDIST", chiBelowOneDf)),
+		hzW(1, distOf("CHISQ.INV", hzTuple(num(plainProbs), num(halfDegrees)))),
+		hzW(1, distOf("F.DIST", hzTuple(num(overTens(hzInts(5, 30), 1, 1)), num(halfDegrees), num(plainDegrees), cumulatives))),
+		hzW(1, distOf("F.DIST.RT", hzTuple(num(overTens(hzInts(5, 30), 1, 1)), num(plainDegrees), num(halfDegrees)))),
+		hzW(1, distOf("FDIST", hzTuple(num(overTens(hzInts(5, 30), 1, 1)), num(halfDegrees), num(halfDegrees)))),
+		hzW(1, distOf("F.INV", hzTuple(num(plainProbs), num(halfDegrees), num(plainDegrees)))),
+		hzW(1, distOf("F.INV.RT", hzTuple(num(plainProbs), num(plainDegrees), num(halfDegrees)))),
+		hzW(1, distOf("FINV", hzTuple(num(plainProbs), num(halfDegrees), num(halfDegrees)))),
+		hzW(1, distOf("POISSON", hzTuple(num(halfCounts), num(positiveScales), isDens))),
