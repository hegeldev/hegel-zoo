+// hzGenChar draws one character of the text alphabet: ASCII letters and digits mostly,
+// punctuation and the wildcard/regex characters, spaces, a few Latin-1 letters and the euro
+// sign; control characters only when asked.
+func hzGenChar(tc hegel.TestCase, controls bool) rune {
+	switch hzDrawInt(tc, 0, 19) {
+	case 0, 1, 2, 3, 4, 5, 6:
+		return rune(hzPick(tc, []rune("abcdefghijklmnopqrstuvwxyz")))
+	case 7, 8, 9:
+		return rune(hzPick(tc, []rune("ABCDEFGHIJKLMNOPQRSTUVWXYZ")))
+	case 10, 11:
+		return rune(hzPick(tc, []rune("0123456789")))
+	case 12, 13, 14:
+		return ' '
+	case 15:
+		return rune(hzPick(tc, []rune("?*~")))
+	case 16:
+		return rune(hzPick(tc, []rune(`.()[]{}|\^$+-,;:!#%&=<>/@_'"`)))
+	case 17:
+		return rune(hzPick(tc, []rune("éèüñàçöÄÉÑ")))
+	case 18:
+		if controls {
+			return rune(hzPick(tc, []rune{7, 9, 10, 13, 31}))
+		}
+		return 'x'
+	default:
+		if hzChance(tc, 30) {
+			return '€'
+		}
+		return 'a'
+	}
+}
