+// zeroArguments: DEGREES(0) and ATAN2(0,0). Past the shape, a nonzero angle and a nonzero
+// coordinate. Hit rate 2 of 2 (the engine deduplicates the two cases).
+var zeroArguments = hzShaped(
+	hzWeighted(
+		hzW(1, fn("DEGREES", zero)),
+		hzW(1, fn("ATAN2", zero, zero)),
+	),
