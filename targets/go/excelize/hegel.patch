+		if controls {
+			return rune(hzPick(tc, []rune{7, 9, 10, 13, 31}))
+		}
+		return 'x'
+	default:
+		if hzChance(tc, 30) {
+			return '€'
+		}
+		return 'a'
+	}
+}
