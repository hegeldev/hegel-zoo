+// hzTextAvoid says whether the case belongs to a recorded bug class, counting the avoidance.
+func hzTextAvoid(name string, args []hzArg) bool {
+	avoid := func(sw *bool, label string) bool {
+		if *sw {
+			hzAvoid(label)
+			return true
+		}
+		return false
+	}
+	// numbers converted to text
+	numberText := func(a hzArg) bool {
+		if a.kind != 'n' {
+			return false
+		}
+		v := math.Abs(a.num)
+		return v == 0 || v >= 1e6 || v < 1e-4 || hzNumLit(a.num) != hzFmt(a.num) || len(strings.Trim(hzNumLit(a.num), "-0.")) > 15
+	}
+	textArgs := map[string][]int{"CODE": {0}, "UNICODE": {0}, "CLEAN": {0}, "TRIM": {0}, "UPPER": {0}, "LOWER": {0}, "PROPER": {0}, "LEN": {0}, "LEFT": {0}, "RIGHT": {0}, "MID": {0}, "REPT": {0},
+		"EXACT": {0, 1}, "FIND": {0, 1}, "SEARCH": {0, 1}, "REPLACE": {0, 3}, "SUBSTITUTE": {0, 1, 2}, "TEXTAFTER": {0, 1}, "TEXTBEFORE": {0, 1}, "VALUETOTEXT": {0}}
+	if idx, ok := textArgs[name]; ok {
+		for _, i := range idx {
+			if i < len(args) && numberText(args[i]) && avoid(&HZKnown.numberText, "numberText") {
+				return true
+			}
+		}
+	}
+	if name == "CONCAT" || name == "CONCATENATE" || name == "TEXTJOIN" {
+		for i, a := range args {
+			if (name != "TEXTJOIN" || i >= 2) && numberText(a) && avoid(&HZKnown.numberText, "numberText") {
+				return true
+			}
+			if a.kind == 'a' {
+				for _, v := range a.arr {
+					if numberText(hzN(v)) && avoid(&HZKnown.numberText, "numberText") {
+						return true
+					}
+				}
+			}
+		}
+	}
+	if name == "TEXT" && len(args) == 2 && (args[1].s == "@" || args[1].s == "General") && numberText(args[0]) && avoid(&HZKnown.numberText, "numberText") {
+		return true
+	}
+	strArg := func(i int) (string, bool) {
+		if i < len(args) && args[i].kind == 's' {
+			return args[i].s, true
+		}
+		return "", false
+	}
+	textOf := func(i int) string {
+		if i >= len(args) {
+			return ""
+		}
+		switch args[i].kind {
+		case 's':
+			return args[i].s
+		case 'n':
+			return hzNumLit(args[i].num)
+		case 'b':
+			return strings.ToUpper(fmt.Sprint(args[i].b))
+		}
+		return ""
+	}
+	numArg := func(i int) (float64, bool) {
+		if i < len(args) && args[i].kind == 'n' {
+			return args[i].num, true
+		}
+		if i < len(args) && args[i].kind == 'b' {
+			if args[i].b {
+				return 1, true
+			}
+			return 0, true
+		}
+		return 0, false
+	}
+	nonASCII := func(s string) bool {
+		for _, r := range s {
+			if r > 127 {
+				return true
+			}
+		}
+		return false
+	}
+	switch name {
+	case "MID":
+		s := textOf(0)
+		st, ok1 := numArg(1)
+		n, ok2 := numArg(2)
+		if ok1 && ok2 && math.Trunc(st) >= 1 && n >= 0 && math.Trunc(st)+math.Trunc(n) == float64(len([]rune(s)))+2 && avoid(&HZKnown.midOverrun, "midOverrun") {
+			return true
+		}
+	case "TRIM":
+		s, _ := strArg(0)
+		if (strings.Contains(s, "  ") || strings.ContainsAny(s, "\t\n\r")) && avoid(&HZKnown.trimInterior, "trimInterior") {
+			return true
+		}
+	case "REPT":
+		if args[0].kind != 's' && avoid(&HZKnown.reptNumber, "reptNumber") {
+			return true
+		}
+		if n, ok := numArg(1); ok && n >= 1000 && avoid(&HZKnown.reptUnbounded, "reptUnbounded") {
+			return true
+		}
+	case "SUBSTITUTE":
+		if old, ok := strArg(1); ok && old == "" && avoid(&HZKnown.substituteEmpty, "substituteEmpty") {
+			return true
+		}
+	case "FIXED":
+		if len(args) == 1 && avoid(&HZKnown.fixedDefault, "fixedDefault") {
+			return true
+		}
+		if s, ok := strArg(2); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+			return true
+		}
+		if len(args) == 3 && (args[2].kind == 'b' && !args[2].b || args[2].kind == 'n' && args[2].num == 0 || args[2].kind == 's' && args[2].s == "FALSE") && avoid(&HZKnown.fixedNoCommas, "fixedNoCommas") {
+			return true
+		}
+		if d, ok := numArg(1); ok && (d > 15 || math.Abs(args[0].num)*math.Pow(10, math.Trunc(d)) >= 9e18 || hzHalfCase(args[0].num, int(math.Trunc(d)), false)) && avoid(&HZKnown.fixedRounding, "fixedRounding") {
+			return true
+		}
+	case "REPLACE":
+		s, _ := strArg(0)
+		if n, ok := numArg(2); (ok && n < 0 || nonASCII(s)) && avoid(&HZKnown.replaceBytes, "replaceBytes") {
+			return true
+		}
+	case "CODE", "UNICODE":
+		s, ok := strArg(0)
+		if ok && (s == "" || nonASCII(s[:min(len(s), 4)])) && avoid(&HZKnown.codeFirstByte, "codeFirstByte") {
+			return true
+		}
+	case "CHAR":
+		if n, ok := numArg(0); ok && n > -1 && n < 1 && avoid(&HZKnown.charZero, "charZero") {
+			return true
+		}
+	case "UNICHAR":
+		if n, ok := numArg(0); ok && (n >= 55295 || (n >= 0 && n < 1)) && avoid(&HZKnown.unicharRange, "unicharRange") {
+			return true
+		}
+	case "FIND", "SEARCH":
+		f, _ := strArg(0)
+		w, _ := strArg(1)
+		if name == "FIND" && strings.ContainsAny(f, "?*") && avoid(&HZKnown.findWildcards, "findWildcards") {
+			return true
+		}
+		if name == "SEARCH" && (strings.Contains(f, "~") || (strings.ContainsAny(f, "?*") && strings.ContainsAny(f, `\{}`))) && avoid(&HZKnown.searchEscapes, "searchEscapes") {
+			return true
+		}
+		if st, ok := numArg(2); ok && (math.Trunc(st) < 1 || math.Trunc(st) > float64(len([]rune(w)))) && avoid(&HZKnown.findStartNum, "findStartNum") {
+			return true
+		}
+	case "TEXTJOIN":
+		if args[1].kind != 'b' && avoid(&HZKnown.textjoinLogical, "textjoinLogical") {
+			return true
+		}
+	case "TEXTAFTER", "TEXTBEFORE":
+		w, _ := strArg(0)
+		d, _ := strArg(1)
+		for _, i := range []int{3, 4} {
+			if s, ok := strArg(i); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+			if v, ok := numArg(i); ok && args[i].kind == 'n' && v != 0 && v != 1 && avoid(&HZKnown.ifTruthiness, "ifTruthiness") {
+				return true
+			}
+		}
+		if (nonASCII(w) || nonASCII(d)) && avoid(&HZKnown.textAfterBytes, "textAfterBytes") {
+			return true
+		}
+		k := 1.0
+		if v, ok := numArg(2); ok {
+			k = math.Trunc(v)
+			if v != k && v > float64(len([]rune(w))) && avoid(&HZKnown.noTruncation, "noTruncation") {
+				return true
+			}
+		}
+		if d != "" && k != 0 {
+			t, dl := w, d
+			if m, ok := numArg(3); ok && m != 0 {
+				t, dl = strings.ToLower(w), strings.ToLower(d)
+			}
+			hits := strings.Count(t, dl)
+			matchEnd := 0.0
+			if len(args) > 4 && (args[4].kind == 'b' && args[4].b || args[4].kind == 'n' && args[4].num != 0 || args[4].kind == 's' && args[4].s == "TRUE") {
+				matchEnd = 1
+			}
+			if k < 0 && strings.HasPrefix(t, dl) && -k >= float64(hits) && avoid(&HZKnown.textAfterPanic, "textAfterPanic") {
+				return true
+			}
+			if k < 0 && strings.Contains(t, dl+dl) && avoid(&HZKnown.textAfterReverse, "textAfterReverse") {
+				return true
+			}
+			if math.Abs(k) > float64(hits)+matchEnd && avoid(&HZKnown.textAfterNotFound, "textAfterNotFound") {
+				return true
+			}
+		}
+	case "VALUE":
+		s, _ := strArg(0)
+		t := strings.TrimSpace(s)
+		low := strings.ToLower(t)
+		if t != s || (strings.Contains(t, ",") && !hzGroupedRe.MatchString(strings.TrimSuffix(t, "%"))) || strings.Contains(t, "_") ||
+			strings.HasPrefix(strings.TrimLeft(low, "+-"), "0x") || strings.HasPrefix(strings.TrimLeft(low, "+-"), "0b") || strings.HasPrefix(strings.TrimLeft(low, "+-"), "0o") ||
+			strings.Contains(low, "inf") || strings.Contains(low, "e400") {
+			if avoid(&HZKnown.valueParsing, "valueParsing") {
+				return true
+			}
+		}
+	case "VALUETOTEXT":
+		if s, ok := strArg(0); ok && len(args) == 2 && args[1].num == 1 {
+			if _, err := strconv.ParseFloat(s, 64); err == nil && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+				return true
+			}
+		}
+	case "TEXT":
+		if len(args) == 2 && args[0].kind == 'n' && !strings.ContainsAny(args[1].s, "ymdhs@G") {
+			f := args[1].s
+			pct := strings.HasSuffix(f, "%")
+			core := strings.TrimSuffix(f, "%")
+			places := 0
+			if i := strings.Index(core, "."); i >= 0 {
+				places = len(strings.TrimRight(core[i+1:], "E+0")) + strings.Count(core[i+1:], "0") - strings.Count(strings.TrimRight(core[i+1:], "E+0"), "0")
+				if strings.Contains(core, "E") {
+					places = len(strings.Split(strings.Split(core, ".")[1], "E")[0])
+				}
+			}
+			if hzHalfCase(args[0].num, places, strings.Contains(core, "E")) || pct && hzHalfCase(args[0].num*100, places, false) {
