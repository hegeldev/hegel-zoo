+// --------------------------------------------------------------------------- excelize/29
+
+// binaryMiss: the case has the shape of excelize/29 by the replicated arithmetic.
+func binaryMiss(c mathCase) bool { return mathShape(c, goVerdict(c)) == "excelize/29" }
+
+// roundingMissesOnce: the cases the binary quotient misses, by function, scanned once:
+// TRUNC(k / 10^p, d) for p in 1..3, d in p..8 (the shortcut aside), and the FLOOR family of
+// k s for the inexact significances (MROUND of (k + 1/2) s), both signs; the misses are 3 to
+// 10 percent of the scan, too few for a filter.
+var roundingMissesOnce = sync.OnceValue(func() map[string][]mathCase {
+	misses := map[string][]mathCase{}
+	add := func(c mathCase) {
+		if binaryMiss(c) {
+			misses[c.name] = append(misses[c.name], c)
+		}
+	}
+	for p := 1; p <= 3; p++ {
+		for k := 1; k <= 999; k++ {
+			for d := p; d <= 8; d++ {
+				x := decimalOf(k, p)
+				add(mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(float64(d))}})
+				add(mathCase{name: "TRUNC", args: []hzArg{hzN(-x), hzN(float64(d))}})
+			}
+		}
+	}
+	sigs := []struct{ k, p int }{{1, 1}, {1, 2}, {1, 3}, {2, 1}, {3, 1}, {7, 1}, {5, 2}, {6, 1}, {9, 1}, {11, 1}, {15, 2}, {25, 3}}
+	for _, name := range []string{"FLOOR", "CEILING", "CEILING.PRECISE", "FLOOR.PRECISE", "ISO.CEILING", "MROUND"} {
+		for _, s := range sigs {
+			sig := decimalOf(s.k, s.p)
+			for k := 1; k <= 400; k++ {
+				x := decimalOf(k*s.k, s.p)
+				if name == "MROUND" {
+					x = decimalOf((2*k+1)*s.k, s.p) / 2
+					x = decimalOf(2*k+1, 0) * sig / 2
+					v, _ := new(big.Rat).Mul(big.NewRat(int64(2*k+1), 2), ratOf(sig)).Float64()
+					x = v
+				}
+				add(mathCase{name: name, args: []hzArg{hzN(x), hzN(sig)}})
+				if name == "MROUND" {
+					add(mathCase{name: name, args: []hzArg{hzN(-x), hzN(-sig)}})
+				} else if name != "CEILING" {
+					add(mathCase{name: name, args: []hzArg{hzN(-x), hzN(sig)}})
+				}
+			}
+		}
+	}
+	return misses
+})
+
+func roundingMissesOf(name string) hegel.Generator[mathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mathCase {
+		return hegel.Draw(tc, hegel.SampledFrom(roundingMissesOnce()[name]))
+	})
+}
+
+var (
+	// roundDownMisses: ROUNDDOWN(k / 10^p, d) with d above p, where the quotient by the
+	// inexact 10^-d is truncated one unit low in 98 draws of 100 (hegel.Filter keeps those;
+	// measured over 2000 draws).
+	roundDownMisses = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) mathCase {
+		p := hegel.Draw(tc, hzInts(0, 3))
+		d := hegel.Draw(tc, hzInts(p+1, 8))
+		x := hegel.Draw(tc, signed(hegel.Map(hzInts(1, 9999), func(k int) float64 { return decimalOf(k, p) }), 50))
+		return mathCase{name: "ROUNDDOWN", args: []hzArg{hzN(x), hzN(float64(d))}}
+	}), binaryMiss)
+
+	// truncExact: TRUNC(a + block / 10^d + e / 10^(d+1), d) with a block of d digits that
+	// neither starts nor ends with 0 (no shortcut) and one more digit (a quotient that is not
+	// an integer, no miss); and TRUNC(x, 0).
+	truncExact = hzWeighted(
+		hzW(3, hegel.Composite(func(tc hegel.TestCase) mathCase {
+			d := hegel.Draw(tc, hzInts(1, 6))
+			block := hegel.Draw(tc, hzInts(1, 9))
+			if d > 1 {
+				block = 10*hegel.Draw(tc, hzInts(int(math.Pow(10, float64(d-2))), int(math.Pow(10, float64(d-1)))-1)) + block
+			}
+			a := hegel.Draw(tc, hzInts(0, 999))
+			x := decimalOf(a*int(math.Pow(10, float64(d+1)))+block*10+hegel.Draw(tc, hzInts(1, 9)), d+1)
+			if hegel.Draw(tc, hzCoin(30)) {
+				x = -x
+			}
+			return mathCase{name: "TRUNC", args: []hzArg{hzN(x), hzN(float64(d))}}
+		})),
+		hzW(1, fn("TRUNC", numbers, zero)),
+	)
+
+	// roundDownExact: ROUNDDOWN(k / 10^p, d) with d below p and a last digit of k that is
+	// not 0 (a quotient that is not an integer), positive (a negative one rounding to 0 is a
+	// negative zero, excelize/34).
+	roundDownExact = hegel.Composite(func(tc hegel.TestCase) mathCase {
+		p := hegel.Draw(tc, hzInts(1, 4))
+		d := hegel.Draw(tc, hzInts(-6, p-1))
+		k := 10*hegel.Draw(tc, hzInts(0, 999)) + hegel.Draw(tc, hzInts(1, 9))
+		return mathCase{name: "ROUNDDOWN", args: []hzArg{hzN(decimalOf(k, p)), hzN(float64(d))}}
+	})
+
+	// multiplesExact: the FLOOR family of (k + 1/2) s and MROUND of (k + 3/10) s, positive
+	// (no direction bug, no miss).
+	multiplesExact = hzWeighted(
+		hzW(2, hegel.FlatMap(hzSampled("FLOOR", "CEILING", "CEILING.PRECISE", "FLOOR.PRECISE", "ISO.CEILING"), func(name string) hegel.Generator[mathCase] {
+			return hegel.Composite(func(tc hegel.TestCase) mathCase {
+				s := hegel.Draw(tc, inexactSigs)
+				v, _ := new(big.Rat).Mul(big.NewRat(int64(2*hegel.Draw(tc, hzInts(0, 999))+1), 2), ratOf(s)).Float64()
+				return mathCase{name: name, args: []hzArg{hzN(v), hzN(s)}}
+			})
+		})),
+		hzW(1, hegel.Composite(func(tc hegel.TestCase) mathCase {
+			s := hegel.Draw(tc, inexactSigs)
+			v, _ := new(big.Rat).Mul(big.NewRat(int64(10*hegel.Draw(tc, hzInts(0, 999))+3), 10), ratOf(s)).Float64()
+			return mathCase{name: "MROUND", args: []hzArg{hzN(v), hzN(s)}}
+		})),
+	)
+)
+
+// decimalRounding: the binary quotient missing an exact decimal: ROUNDDOWN (filtered),
+// TRUNC and the FLOOR family and MROUND (from the scan). Past the shape, quotients that are
+// not integers (or halves, for MROUND). Hit rate 1000 of 1000.
+var decimalRounding = hzShaped(
+	hzWeighted(
+		hzW(2, roundDownMisses),
+		hzW(2, roundingMissesOf("TRUNC")),
+		hzW(1, roundingMissesOf("FLOOR")),
+		hzW(1, roundingMissesOf("CEILING")),
+		hzW(1, roundingMissesOf("CEILING.PRECISE")),
+		hzW(1, roundingMissesOf("FLOOR.PRECISE")),
+		hzW(1, roundingMissesOf("ISO.CEILING")),
+		hzW(1, roundingMissesOf("MROUND")),
+	),
+	hzWeighted(
+		hzW(2, roundDownExact),
+		hzW(2, truncExact),
+		hzW(3, multiplesExact),
+	),
+)
+
+func TestHegelMathDecimalRounding(t *testing.T) { narrowMath(t, decimalRounding) }
+
+// --------------------------------------------------------------------------- excelize/31
+
+// zeroArguments: DEGREES(0) and ATAN2(0,0). Past the shape, a nonzero angle and a nonzero
+// coordinate. Hit rate 2 of 2 (the engine deduplicates the two cases).
+var zeroArguments = hzShaped(
+	hzWeighted(
+		hzW(1, fn("DEGREES", zero)),
+		hzW(1, fn("ATAN2", zero, zero)),
+	),
+	hzWeighted(
+		hzW(1, fn("DEGREES", nonzero)),
+		hzW(1, fn("ATAN2", nonzero, numbers)),
+		hzW(1, fn("ATAN2", numbers, nonzero)),
+	),
+)
