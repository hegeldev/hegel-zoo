+
+# ---- logical and information functions
+
+def AND(*args):
+    xerr(*args)
+    vals = [xlogic(a) for a in args if not isinstance(a, list)]
+    for a in args:
+        if isinstance(a, list):
+            vals.extend(v != 0 for v in a)
+    if not vals:
+        raise XErr(VALUE)
+    return all(vals)
+
+def OR(*args):
+    xerr(*args)
+    vals = [xlogic(a) for a in args if not isinstance(a, list)]
+    for a in args:
+        if isinstance(a, list):
+            vals.extend(v != 0 for v in a)
+    if not vals:
+        raise XErr(VALUE)
+    return any(vals)
