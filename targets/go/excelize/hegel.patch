+
+def T(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    return v if isinstance(v, str) else ""
+
+def N(v):
+    if isinstance(v, XE):
+        raise XErr(v.code)
+    if isinstance(v, bool):
+        return 1.0 if v else 0.0
+    if isinstance(v, str):
+        return 0.0
+    if isinstance(v, list):
+        raise Skip()
+    return float(v)
+
+def VALUETOTEXT(v, fmt=0.0):
+    fmt = xnum(fmt)
+    if fmt != 0 and fmt != 1:
+        raise XErr(VALUE)
+    if isinstance(v, XE):
+        raise Skip()
+    if isinstance(v, str) and fmt == 1:
+        return '"' + v + '"'
+    return xtext(v)
+
+# ---- logical and information functions
