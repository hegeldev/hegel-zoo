+// hzHalfNumber draws a number with d+1 decimals whose last decimal is 5.
+func hzHalfNumber(tc hegel.TestCase, d int) float64 {
+	scale := math.Pow(10, float64(d+1))
+	k := float64(hzDrawInt(tc, 0, 99999))*10 + 5
+	v, _ := strconv.ParseFloat(hzNumLit(k/scale), 64)
+	if hzChance(tc, 30) {
+		v = -v
+	}
+	return v
+}
+
+// hzGenLogical draws a logical argument: a boolean, a number, or a text of TRUE/FALSE.
+func hzGenLogical(tc hegel.TestCase) hzArg {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0, 1, 2, 3, 4:
+		return hzB(hzGenBool(tc))
+	case 5, 6:
+		return hzN(float64(hzDrawInt(tc, -2, 3)))
+	case 7:
+		return hzN(float64(hzDrawInt(tc, -20, 20)) / 10)
+	case 8:
+		return hzS(hzPick(tc, []string{"TRUE", "FALSE", "true", "False"}))
+	default:
+		return hzS(hzPick(tc, []string{"1", "0", "x", "", "yes"}))
+	}
+}
+
+// hzGenValueText draws a text for VALUE: numbers in the accepted and rejected spellings,
+// dates and times.
+func hzGenValueText(tc hegel.TestCase) string {
+	n := hzGenTextNum(tc)
+	s := hzNumLit(n)
+	switch hzDrawInt(tc, 0, 15) {
+	case 0:
+		return s
+	case 1:
+		return " " + s + "  "
+	case 2:
+		return s + "%"
+	case 3:
+		// grouped thousands
+		neg := strings.HasPrefix(s, "-")
+		s = strings.TrimPrefix(s, "-")
+		ip, fp, _ := strings.Cut(s, ".")
+		var parts []string
+		for len(ip) > 3 {
+			parts = append([]string{ip[len(ip)-3:]}, parts...)
+			ip = ip[:len(ip)-3]
+		}
+		parts = append([]string{ip}, parts...)
+		out := strings.Join(parts, ",")
+		if fp != "" {
+			out += "." + fp
+		}
+		if neg {
+			out = "-" + out
+		}
+		return out
+	case 4:
+		return hzPick(tc, []string{"1,2,3", "12,34", "1,", ",1", "1,2345", "1 000"})
+	case 5:
+		return hzPick(tc, []string{"0x10", "0b101", "0o17", "1_000", "inf", "-inf", "Inf", "1e400", "NaN", "Infinity", "1d5", "0x1p3"})
+	case 6:
+		return hzPick(tc, []string{"", " ", "abc", "TRUE", "1..2", "--1", "+-1", "1e", "e1", "(1)", "1%%", "%50", "50 %", "$12", "1/2", "1.2.3", "-", "+", ".", "-0", "-0.0", "-0%", " -0 "})
+	case 7:
+		return hzPick(tc, []string{"1E5", "1e5", "2.5E-3", "-1e2", "1e+2", "+5", ".5", "5.", "-.5", "0.1e-2"})
+	case 8:
+		y, m, d := hzYMD(hzGenDay(tc))
+		return hzPick(tc, []string{
+			fmt.Sprintf("%04d-%02d-%02d", y, m, d),
+			fmt.Sprintf("%d/%d/%04d", m, d, y),
+			fmt.Sprintf("%04d-%02d-%02d %02d:%02d", y, m, d, hzDrawInt(tc, 0, 23), hzDrawInt(tc, 0, 59)),
+		})
+	case 9:
+		return fmt.Sprintf("%d:%02d", hzDrawInt(tc, 0, 23), hzDrawInt(tc, 0, 59))
+	case 10:
+		return fmt.Sprintf("%d:%02d:%02d", hzDrawInt(tc, 0, 23), hzDrawInt(tc, 0, 59), hzDrawInt(tc, 0, 59))
+	case 11:
+		return s + " %"
+	default:
+		return s
+	}
+}
