+// betaInvArgs: p, alpha, beta[, A, B], and flatBetaInv one time in ten.
+var betaInvArgs = withShape(hzSeq(hzTuple(num(probabilities), num(shapes), num(shapes)), hzMaybe(50, bounds)), flatBetaInv)
+
+// hyperOf: x, n, M, N for N in Ns, n and M in 1..N (M from the given lower bound), x in the
+// support; x anywhere in -1..N+1 one time in ten, n = N+1 one time in twenty.
+func hyperOf(Ns hegel.Generator[int], mLo func(N, n int) int) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(Ns, func(N int) hegel.Generator[[]hzArg] {
+		return hegel.FlatMap(hzInts(1, N), func(n int) hegel.Generator[[]hzArg] {
+			return hegel.FlatMap(hzInts(mLo(N, n), N), func(M int) hegel.Generator[[]hzArg] {
+				lo, hi := max(0, n-N+M), min(n, M)
+				xs := hzWeighted(hzW(9, hzInts(lo, hi)), hzW(1, hzInts(-1, N+1)))
+				ns := hzWeighted(hzW(19, hegel.Just(n)), hzW(1, hegel.Just(N+1)))
+				return hegel.Map(hzTuple(xs, ns), func(v []int) []hzArg {
+					return []hzArg{hzN(float64(v[0])), hzN(float64(v[1])), hzN(float64(M)), hzN(float64(N))}
+				})
+			})
+		})
+	})
+}
