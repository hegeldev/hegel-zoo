+	replaceBytes            bool // REPLACE indexes bytes and accepts a negative num_chars: REPLACE("héllo",2,1,"E") = "hE\xa9llo" (want "hEllo"), REPLACE("abcdef",3,-1,"X") = "abXbcdef" (want #VALUE!)
