+for line in sys.stdin:
+    try:
+        req = json.loads(line)
+        fn = globals()[req["name"].replace(".", "_")]
+        args = [decode(a) for a in req["args"]]
+        try:
+            res = encode(fn(*args))
+        except XErr as e:
+            res = {"t": "e", "v": e.code}
+        except Skip:
+            res = {"t": "skip"}
+        except (ValueError, ZeroDivisionError, OverflowError):
