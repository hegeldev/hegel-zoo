+// flatBetaInv: BETA.INV with equal shapes of 0.05, 0.06 or 0.07 and p in [0.32, 0.49] or
+// [0.51, 0.68]: the U-shaped beta whose flat CDF defeats the Newton search (excelize/13;
+// measured on a grid at rtol 1e-8: both shapes at most 0.1 fail between p = 0.21 (0.46 at
+// shape 0.1) and 0.79 (0.54 at 0.1), at 0.5 only when the shapes differ; 0.12 and 0.15 fail
+// in a sliver, 0.2 never).
+var flatBetaInv = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	a := hegel.Draw(tc, hzSampled(0.05, 0.06, 0.07))
+	p := hegel.Draw(tc, hzWeighted(hzW(1, overTens(hzInts(320, 490), 3, 3)), hzW(1, overTens(hzInts(510, 680), 3, 3))))
+	return []hzArg{hzN(p), hzN(a), hzN(a)}
