+	hzPinErr(t, "IF(TRUE,NA(),1)", nil, "#N/A")
+}
+
+func TestHegelPinOrArgsSkipped(t *testing.T) {
+	hzPinErr(t, `OR(1,"x")`, nil, "#VALUE!")
+	hzPinRaw(t, "OR(FALSE,A1:A1,TRUE)", map[string][]float64{"A": {0}}, "TRUE")
+	hzPinRaw(t, `OR("TRUE",FALSE)`, nil, "TRUE")
+	hzPinErr(t, `AND("FALSE","x")`, nil, "#VALUE!")
+}
+
+func TestHegelPinLogicalText(t *testing.T) {
+	hzPinRaw(t, `XOR("TRUE")`, nil, "TRUE")
+	hzPinErr(t, `IF("1",1,0)`, nil, "#VALUE!")
+}
+
+func TestHegelPinIsEvenOdd(t *testing.T) {
+	hzPinRaw(t, "ISEVEN(3)", nil, "FALSE")
+	hzPinRaw(t, "ISEVEN(-1)", nil, "FALSE")
+	hzPinRaw(t, "ISEVEN(1.8)", nil, "FALSE")
+	hzPinErr(t, "ISEVEN(TRUE)", nil, "#VALUE!")
+	hzPinErr(t, "ISODD(NA())", nil, "#N/A")
+}
+
+func TestHegelPinTextNumbersAsValues(t *testing.T) {
+	hzPinRaw(t, `ISTEXT("1")`, nil, "TRUE")
+	hzPinNum(t, `N("1")`, nil, 0, 0, 0)
+	hzPinRaw(t, `ISLOGICAL("TRUE")`, nil, "FALSE")
+	hzPinRaw(t, "ISNUMBER(TRUE)", nil, "FALSE")
+}
+
+func TestHegelPinSwitchComparison(t *testing.T) {
+	hzPinRaw(t, `SWITCH(1,"1","a","d")`, nil, "d")
+	hzPinNum(t, `SWITCH("A","a",1,"d")`, nil, 1, 0, 0)
+}
+
+func TestHegelPinTextAfterPanic(t *testing.T) {
+	hzPinRaw(t, `TEXTAFTER("abc","a",-2,0,TRUE)`, nil, "abc")
+	hzPinErr(t, `TEXTBEFORE("bcb,","bc",-3)`, nil, "#N/A")
+}
+
+func TestHegelPinTextAfterReverse(t *testing.T) {
+	hzPinRaw(t, `TEXTAFTER("a--b","-",-2)`, nil, "-b")
+	hzPinRaw(t, `TEXTBEFORE("Ypp","p",-2)`, nil, "Y")
+}
+
+// Part 2 of the rewrite (excelize/84 and 85).
+
+// The inverse F is (1 / betainv(1 - p) - 1) d2 / d1, which cancels at a tiny quantile (excelize/84).
+func TestHegelPinFInvTinyQuantile(t *testing.T) {
+	hzPinNum(t, "F.INV(0.0000000001,1,1)", nil, 2.4674011002723397e-20, 1e-7, 0)
+	hzPinNum(t, "FINV(0.999999,1,38)", nil, 1.5915988589620388e-12, 1e-7, 0)
+	hzPinNum(t, "F.INV.RT(0.9999999999,1,1)", nil, 2.4674011002723397e-20, 1e-7, 0)
+}
+
+// The binomial densities multiply math.Pow factors that underflow while the value is representable (excelize/85).
+func TestHegelPinBinomialUnderflow(t *testing.T) {
+	hzPinNum(t, "BINOM.DIST(41,163,0.998,FALSE)", nil, 2.9718605458861346e-291, 1e-7, 0)
+	hzPinNum(t, "BINOM.DIST(52,163,0.999,TRUE)", nil, 1.3387608093455233e-290, 1e-7, 0)
+	hzPinNum(t, "NEGBINOMDIST(120,50,0.998)", nil, 1.2617139422314298e-281, 1e-7, 0)
+}
diff --git a/hegel/hegel_zoo_stat_shapes_test.go b/hegel/hegel_zoo_stat_shapes_test.go
new file mode 100644
index 0000000..97d4a35
--- /dev/null
+++ b/hegel/hegel_zoo_stat_shapes_test.go
@@ -0,0 +1,507 @@
+package hegel
+
+// The shape regions of the recorded Stat bugs (bugs.toml excelize/1, 3, 4, 5, 10, 12, 15, 17,
+// 20, 21, 22, 24, 26 and 83) and the narrow properties over them: each region is a generator
+// over the bug's shape with random contents, judged exactly like the wide property
+// (judgeStat, with the classifier statShape naming the bug). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next to the shape
+// instead (hzShaped) and the property passes. The hit rates quoted at each region are the
+// collector's mismatches over its cases (ZOO_COLLECT=1 HEGEL_TEST_CASES=1000); the regions
+// whose shape is a relation of the library's arithmetic are hegel.Filter over the classifier
+// with the Go models' verdict (shaped), with the share of draws kept quoted.
+
+import (
+	"math"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowStat runs a narrow property: every drawn case through the wide property's judge.
+func narrowStat(t *testing.T, cases hegel.Generator[statCase]) {
+	o := hzStartOracle(t)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeStat(j, o, c)
+		col.count("cases")
+	})
+}
+
+// statOf: the cases NAME(args), with no SUBTOTAL or AGGREGATE check.
+func statOf(name string, args hegel.Generator[[]hzArg]) hegel.Generator[statCase] {
+	return hegel.Map(args, func(a []hzArg) statCase { return statCase{name: name, args: a} })
+}
+
+// shaped: the cases of g that have the shape of the bug id by the classifier with the Go
+// models' verdict ("" for the cases with no shape).
+func shaped(id string, g hegel.Generator[statCase]) hegel.Generator[statCase] {
+	return hegel.Filter(g, func(c statCase) bool { return statShape(c, statVerdict(c)) == id })
+}
+
+// onePair: a range of a and a range of b, the same length n.
+func onePair(a, b func(n int) hegel.Generator[[]float64], ns hegel.Generator[int]) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(ns, func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(arr(a(n)), arr(b(n)))
+	})
+}
+
+// countedOf: n values of g (a profile), as a function of n.
+func countedOf(g hegel.Generator[float64]) func(n int) hegel.Generator[[]float64] {
+	return func(n int) hegel.Generator[[]float64] { return hzCounted(g, n, n) }
+}
+
+var (
+	zeroSd = hegel.Just(0.0)
+	// smallInts and nonzeroInts: -20..20, and 1..100 negative 40%.
+	smallIntsOf   = countedOf(floats(hzInts(-20, 20)))
+	nonzeroInts   = signed(floats(hzInts(1, 100)), 40)
+	nonzeroIntsOf = countedOf(nonzeroInts)
+	// decimals: (1..9999) / 10^(1..3), inexact in binary mostly.
+	decimals = overTens(hzInts(1, 9999), 1, 3)
+	// plainRanges: 2..12 small integers, the region past most shapes.
+	plainRanges = rangesOf(hzInts(2, 12))
+	plainPairs  = onePair(smallIntsOf, smallIntsOf, hzInts(2, 12))
+	// inexactConstants: 3..12 copies of a decimal (a mean inexact in binary, mostly).
+	inexactConstants = constantOf(decimals, hzInts(3, 12))
+	// exactConstants: 2..12 copies of a small integer.
+	exactConstants = constantOf(floats(hzInts(-20, 20)), hzInts(2, 12))
+)
+
+// --------------------------------------------------------------------------- excelize/1
+
+// outsideExcOf: PERCENTILE.EXC's k with the index k(n+1) below 1 or at least n: u/(n+1) and
+// (n+u)/(n+1) for u in [0, 1) (0 itself is #NUM!, filtered).
+func outsideExcOf(n int) hegel.Generator[float64] {
+	u := overTens(hzInts(0, 999), 3, 3)
+	return hzWeighted(
+		hzW(1, hegel.Map(u, func(u float64) float64 { return u / float64(n+1) })),
+		hzW(1, hegel.Map(u, func(u float64) float64 { return (float64(n) + u) / float64(n+1) })),
+	)
+}
+
+// percentileExcOutside: PERCENTILE.EXC with k outside [1/(n+1), n/(n+1)) and QUARTILE.EXC
+// of one to three values with the quart whose index leaves the range (7 of 9: hegel.Filter
+// on the replica). Past the shape, k inside (insideExcOf, two values or more) and QUARTILE.EXC
+// of four values or more. Hit rate 1000 of 1000.
+var percentileExcOutside = hzShaped(
+	hzWeighted(
+		hzW(2, shaped("excelize/1", statOf("PERCENTILE.EXC", rangeThen(rangesOf(hzInts(1, 12)), byLength(outsideExcOf))))),
+		hzW(1, shaped("excelize/1", statOf("QUARTILE.EXC", hzTuple(arr(rangesOf(hzInts(1, 3))), num(floats(hzInts(1, 3))))))),
+	),
+	hzWeighted(
+		hzW(2, shaped("", statOf("PERCENTILE.EXC", rangeThen(rangesOf(hzInts(2, 12)), byLength(insideExcOf))))),
+		hzW(1, statOf("QUARTILE.EXC", hzTuple(arr(rangesOf(hzInts(4, 12))), num(floats(hzInts(1, 3)))))),
+	),
+)
+
+func TestHegelStatPercentileExcChecksItsBounds(t *testing.T) { narrowStat(t, percentileExcOutside) }
+
+// --------------------------------------------------------------------------- excelize/3
+
+// harmeanOfARange: HARMEAN of a range of 1..12 positive values (the range is not read).
+// Past the shape, the literal form of the same values. Hit rate 1000 of 1000.
+var harmeanOfARange = hzShaped(
+	statOf("HARMEAN", hzTuple(arr(hzCounted(positives, 1, 12)))),
+	statOf("HARMEAN", some(num(positives))),
+)
+
+func TestHegelStatHarmeanOfARange(t *testing.T) { narrowStat(t, harmeanOfARange) }
+
+// --------------------------------------------------------------------------- excelize/4
+
+// avedevOfARange: AVEDEV of a range of 2..12 values, alone or with a literal after it, where
+// the range's first value's deviation is not the mean absolute deviation (hegel.Filter on
+// the replica: 97 draws in 100 pass). Past the shape, the literal form and a range of one
+// value (0 either way). Hit rate 1000 of 1000.
+var avedevOfARange = hzShaped(
+	shaped("excelize/4", statOf("AVEDEV", hzWeighted(
+		hzW(2, hzTuple(arr(plainRanges))),
+		hzW(1, hzTuple(arr(plainRanges), num(numbers))),
+	))),
+	hzWeighted(
+		hzW(2, statOf("AVEDEV", some(num(numbers)))),
+		hzW(1, statOf("AVEDEV", hzTuple(arr(hzCounted(numbers, 1, 1))))),
+	),
+)
+
+func TestHegelStatAvedevOfARange(t *testing.T) { narrowStat(t, avedevOfARange) }
+
+// --------------------------------------------------------------------------- excelize/5
+
+// zeroPairs: two ranges of nonzero values with one value of one of them set to 0 (a pair
+// with exactly one zero, dropped).
+var zeroPairs = hzWeighted(
+	hzW(1, onePair(func(n int) hegel.Generator[[]float64] { return withAZero(nonzeroIntsOf(n)) }, nonzeroIntsOf, hzInts(2, 12))),
+	hzW(1, onePair(nonzeroIntsOf, func(n int) hegel.Generator[[]float64] { return withAZero(nonzeroIntsOf(n)) }, hzInts(2, 12))),
+)
+
+// zeroPairsDropped: SUMX2MY2, SUMX2PY2 and SUMXMY2 over zeroPairs, and CORREL over them with
+// three values or more where dropping the pair changes the coefficient (hegel.Filter on the
+// replica: 99 draws in 100 pass). Past the shape, pairs of nonzero values (CORREL's not
+// constant). Hit rate 1000 of 1000.
+var zeroPairsDropped = hzShaped(
+	hzWeighted(
+		hzW(1, statOf("SUMX2MY2", zeroPairs)),
+		hzW(1, statOf("SUMX2PY2", zeroPairs)),
+		hzW(1, statOf("SUMXMY2", zeroPairs)),
+		hzW(2, shaped("excelize/5", statOf("CORREL", hegel.Filter(zeroPairs, func(a []hzArg) bool { return len(a[0].arr) >= 3 })))),
+	),
+	hzWeighted(
+		hzW(1, statOf("SUMX2MY2", onePair(nonzeroIntsOf, nonzeroIntsOf, hzInts(1, 12)))),
+		hzW(1, statOf("SUMX2PY2", onePair(nonzeroIntsOf, nonzeroIntsOf, hzInts(1, 12)))),
+		hzW(1, statOf("SUMXMY2", onePair(nonzeroIntsOf, nonzeroIntsOf, hzInts(1, 12)))),
+		hzW(2, shaped("", statOf("CORREL", onePair(nonzeroIntsOf, nonzeroIntsOf, hzInts(3, 12))))),
+	),
+)
+
+func TestHegelStatZeroPairsCount(t *testing.T) { narrowStat(t, zeroPairsDropped) }
+
+// --------------------------------------------------------------------------- excelize/10
+
+// hugeRanges: the ranges whose product overflows float64: 2..6 values of (1..999)
+// 10^(160..300), or 40..60 values of (1..999) 10^(8..12).
+var hugeRanges = hzWeighted(
+	hzW(1, hzCounted(timesTens(hzInts(1, 999), 160, 300), 2, 6)),
+	hzW(1, hzCounted(timesTens(hzInts(1, 999), 8, 12), 40, 60)),
+)
+
+// infiniteStats: SKEW.P of an inexact constant range whose one-pass variance is exactly 0
+// (0/0 through the intermediate steps is an infinity: hegel.Filter on the replica, 1 draw
+// in 3 passes) and PRODUCT of hugeRanges. Past the shape, SKEW.P of ranges that are not
+// constant and PRODUCT of small values. Hit rate 1000 of 1000.
+var infiniteStats = hzShaped(
+	hzWeighted(
+		hzW(1, shaped("excelize/10", statOf("SKEW.P", hzTuple(arr(inexactConstants))))),
+		hzW(1, statOf("PRODUCT", hzTuple(arr(hugeRanges)))),
+	),
+	hzWeighted(
+		hzW(1, shaped("", statOf("SKEW.P", hzTuple(arr(rangesOf(hzInts(3, 12))))))),
+		hzW(1, statOf("PRODUCT", hzTuple(arr(hzCounted(floats(hzInts(-20, 20)), 1, 12))))),
+	),
+)
+
+func TestHegelStatInfiniteResultsAreErrors(t *testing.T) { narrowStat(t, infiniteStats) }
+
+// --------------------------------------------------------------------------- excelize/12
+
+// confidenceNorm: CONFIDENCE and CONFIDENCE.NORM over thousandths of (0, 1), a positive sd
+// and a size of 1..100: the normal quantile is accurate to 1e-9, so the result misses the
+// tolerance of 1e-10 (a check of the judge, not a drawn shape; under HEGEL_NO_KNOWN=1 the
+// same cases are judged at 1e-8 and each counted as known). Hit rate 936 of 1000 (the rest
+// land within 1e-10 by chance).
+var confidenceNorm = hzWeighted(
+	hzW(1, statOf("CONFIDENCE", hzTuple(num(overTens(hzInts(1, 999), 3, 3)), num(positives), num(floats(hzInts(1, 100)))))),
+	hzW(1, statOf("CONFIDENCE.NORM", hzTuple(num(overTens(hzInts(1, 999), 3, 3)), num(positives), num(floats(hzInts(1, 100)))))),
+)
+
+func TestHegelStatConfidenceNormIsExact(t *testing.T) { narrowStat(t, confidenceNorm) }
+
+// --------------------------------------------------------------------------- excelize/15
+
+var (
+	fractionalQuarts    = hzSampled(0.5, 1.5, 2.5, 3.5, 2.9, 1.1, 4.5, -0.5)
+	fractionalExcQuarts = hzSampled(1.5, 2.5, 1.1, 2.9)
+	fractionalSigs      = hzSampled(1.5, 2.5, 3.5, 1.1)
+	fractionalSizes     = hegel.Map(hzInts(1, 20), func(j int) float64 { return float64(j) + 0.5 })
+	confidenceNames     = hzSampled("CONFIDENCE", "CONFIDENCE.NORM", "CONFIDENCE.T")
+	percentrankNames    = hzSampled("PERCENTRANK", "PERCENTRANK.INC", "PERCENTRANK.EXC")
+	quartileNames       = hzSampled("QUARTILE", "QUARTILE.INC")
+	// confidenceOf: the CONFIDENCE functions named over alphas of (0, 0.5], a positive sd
+	// and the size.
+	confidenceOf = func(names hegel.Generator[string], sizes hegel.Generator[float64]) hegel.Generator[statCase] {
+		return hegel.FlatMap(names, func(name string) hegel.Generator[statCase] {
+			return statOf(name, hzTuple(num(overTens(hzInts(1, 500), 3, 3)), num(positives), num(sizes)))
+		})
+	}
+	// percentrankOf: the three PERCENTRANK functions over a range of 2..12 values, a point in
+	// it and the significance.
+	percentrankOf = func(sigs hegel.Generator[float64]) hegel.Generator[statCase] {
+		return hegel.FlatMap(percentrankNames, func(name string) hegel.Generator[statCase] {
+			return statOf(name, hegel.FlatMap(rangesOf(hzInts(2, 12)), func(a []float64) hegel.Generator[[]hzArg] {
+				return hzTuple(hegel.Just(hzA(a)), num(pointIn(a)), num(sigs))
+			}))
+		})
+	}
+	quartileOf = func(quarts hegel.Generator[float64]) hegel.Generator[statCase] {
+		return hegel.FlatMap(quartileNames, func(name string) hegel.Generator[statCase] {
+			return statOf(name, hzTuple(arr(plainRanges), num(quarts)))
+		})
+	}
+)
+
+// countsAreTruncated: QUARTILE and QUARTILE.INC with a fractional quart, QUARTILE.EXC of four
+// values or more with one, PERCENTRANK with a fractional significance (each where the
+// untruncated argument changes the result: hegel.Filter on the replica, 9 draws in 10
+// pass), and the three CONFIDENCE functions with a fractional size of 1.5 or more. Past the
+// shape, the integral arguments (CONFIDENCE.T alone: CONFIDENCE and CONFIDENCE.NORM are
+// excelize/12 at any size). Hit rate 1000 of 1000.
+var countsAreTruncatedStat = hzShaped(
+	hzWeighted(
+		hzW(2, shaped("excelize/15", quartileOf(fractionalQuarts))),
+		hzW(1, shaped("excelize/15", statOf("QUARTILE.EXC", hzTuple(arr(rangesOf(hzInts(4, 12))), num(fractionalExcQuarts))))),
+		hzW(2, shaped("excelize/15", percentrankOf(fractionalSigs))),
+		hzW(2, confidenceOf(confidenceNames, fractionalSizes)),
+	),
+	hzWeighted(
+		hzW(2, quartileOf(floats(hzInts(0, 4)))),
+		hzW(1, statOf("QUARTILE.EXC", hzTuple(arr(rangesOf(hzInts(4, 12))), num(floats(hzInts(1, 3)))))),
+		hzW(2, shaped("", percentrankOf(floats(hzInts(1, 6))))),
+		hzW(2, confidenceOf(hegel.Just("CONFIDENCE.T"), floats(hzInts(2, 100)))),
+	),
+)
+
+func TestHegelStatCountsAreTruncated(t *testing.T) { narrowStat(t, countsAreTruncatedStat) }
+
+// --------------------------------------------------------------------------- excelize/17
+
+// fisherInvOverflows: FISHERINV from 355 to 10^15 (e^2y overflows: #NUM!, want 1). Past the
+// shape, y in [-1000, 354] and the unit decimals. Hit rate 1000 of 1000.
+var fisherInvOverflows = hzShaped(
+	statOf("FISHERINV", hzTuple(num(hzWeighted(
+		hzW(1, floats(hzInts(355, 100000))),
+		hzW(1, timesTens(hzInts(1, 999), 3, 12)),
+	)))),
+	statOf("FISHERINV", hzTuple(num(hzWeighted(
+		hzW(1, floats(hzInts(-1000, 354))),
+		hzW(1, openUnits),
+	)))),
+)
+
+func TestHegelStatFisherInvAtTheEnds(t *testing.T) { narrowStat(t, fisherInvOverflows) }
+
+// --------------------------------------------------------------------------- excelize/20
+
+// percentrankCase: NAME(range, x[, sig]) over 11..40 values of 1..1000 with x one of the
+// lowest tenth (a rank below 0.1, where decimal places and significant digits differ) or of
+// the rest.
+func percentrankCase(low bool) hegel.Generator[statCase] {
+	return hegel.FlatMap(percentrankNames, func(name string) hegel.Generator[statCase] {
+		return statOf(name, hegel.FlatMap(hzCounted(floats(hzInts(1, 1000)), 11, 40), func(a []float64) hegel.Generator[[]hzArg] {
+			s := append([]float64(nil), a...)
+			sort.Float64s(s)
+			tenth := len(s) / 10
+			x := hegel.SampledFrom(s[tenth:])
+			if low {
+				x = hegel.SampledFrom(s[:tenth])
+			}
+			return optional(hzTuple(hegel.Just(hzA(a)), num(x)), num(floats(hzInts(1, 3))))
+		}))
+	})
+}
+
+// percentrankPlaces: PERCENTRANK of a low rank where the places and the digits differ
+// (hegel.Filter on the replica and the model: 9 draws in 10 pass; the smallest value, rank
+// 0, is the same either way). Past the shape, a rank of 0.1 or more. Hit rate 1000 of 1000.
+var percentrankPlaces = hzShaped(
+	shaped("excelize/20", percentrankCase(true)),
+	shaped("", percentrankCase(false)),
+)
+
+func TestHegelStatPercentrankSignificantDigits(t *testing.T) { narrowStat(t, percentrankPlaces) }
+
+// --------------------------------------------------------------------------- excelize/21
+
+var (
+	nonPositives = hzWeighted(hzW(1, zeroSd), hzW(2, neg(positives)))
+	// harmeanWithANonPositive: one to six literals with one that is not positive
+	harmeanWithANonPositive = hzSeq(hzCounted(num(positives), 0, 3), hzOne(num(nonPositives)), hzCounted(num(positives), 0, 2))
+	outsideUnit             = hzWeighted(hzW(1, hzSampled(1.01, -0.01, 2, -1, 1.5)), hzW(1, signed(floats(hzInts(2, 100)), 50)))
+	atOrBeyondOne           = hzWeighted(hzW(1, hzSampled(1.0, -1, 1.5, -2, 1.0000001)), hzW(1, signed(floats(hzInts(1, 100)), 50)))
+	// constantPairs: two exact constant ranges of the same length, 1..12
+	constantPairs = hegel.FlatMap(hzInts(1, 12), func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(arr(constantOf(floats(hzInts(-20, 20)), hegel.Just(n))), arr(constantOf(floats(hzInts(-20, 20)), hegel.Just(n))))
+	})
+	// constantXPairs: known_y's of 3..12 small integers, known_x's an exact constant
+	constantXPairs = onePair(smallIntsOf, func(n int) hegel.Generator[[]float64] { return constantOf(floats(hzInts(-20, 20)), hegel.Just(n)) }, hzInts(3, 12))
+	onePairs       = onePair(smallIntsOf, smallIntsOf, hegel.Just(1))
+)
+
+// errorCodesAsDocumented: HARMEAN of a literal that is not positive, PERCENTILE and
+// PERCENTILE.INC with k outside [0, 1], FISHER at or beyond +-1 (#N/A, want #NUM!); SKEW and
+// SKEW.P of an exact constant range of three or more, T.TEST of two exact constant ranges
+// (type 3, type 2 with equal means, or one value each: hegel.Filter on the replica, 1 draw
+// in 2 passes), STEYX with exact constant known_x's, COVARIANCE.S of one pair (#NUM!, want
+// #DIV/0!); STANDARDIZE with a standard deviation of 0 or less (#N/A) and Z.TEST with sigma
+// 0 (#DIV/0!), want #NUM!. Past the shape, the documented domains. Hit rate 1000 of 1000.
+var errorCodesAsDocumentedStat = hzShaped(
+	hzWeighted(
+		hzW(1, statOf("HARMEAN", harmeanWithANonPositive)),
+		hzW(1, statOf("PERCENTILE", hzTuple(arr(plainRanges), num(outsideUnit)))),
+		hzW(1, statOf("PERCENTILE.INC", hzTuple(arr(plainRanges), num(outsideUnit)))),
+		hzW(1, statOf("FISHER", hzTuple(num(atOrBeyondOne)))),
+		hzW(1, statOf("SKEW", hzTuple(arr(constantOf(floats(hzInts(-20, 20)), hzInts(3, 12)))))),
+		hzW(1, statOf("SKEW.P", hzTuple(arr(constantOf(floats(hzInts(-20, 20)), hzInts(3, 12)))))),
+		hzW(1, shaped("excelize/21", statOf("T.TEST", hzSeq(constantPairs, hzTuple(num(floats(hzInts(1, 2))), num(floats(hzInts(2, 3)))))))),
+		hzW(1, statOf("STEYX", constantXPairs)),
+		hzW(1, statOf("COVARIANCE.S", onePairs)),
+		hzW(1, statOf("STANDARDIZE", hzTuple(num(numbers), num(numbers), num(nonPositives)))),
+		hzW(1, statOf("Z.TEST", hzTuple(arr(plainRanges), num(numbers), num(zeroSd)))),
+	),
+	hzWeighted(
+		hzW(1, statOf("HARMEAN", some(num(positives)))),
+		hzW(1, statOf("PERCENTILE", hzTuple(arr(plainRanges), num(overTens(hzInts(0, 1000), 3, 3))))),
+		hzW(1, statOf("PERCENTILE.INC", hzTuple(arr(plainRanges), num(overTens(hzInts(0, 1000), 3, 3))))),
+		hzW(1, statOf("FISHER", hzTuple(num(openUnits)))),
+		hzW(1, shaped("", statOf("SKEW", hzTuple(arr(rangesOf(hzInts(3, 12))))))),
+		hzW(1, shaped("", statOf("SKEW.P", hzTuple(arr(rangesOf(hzInts(3, 12))))))),
+		hzW(1, shaped("", statOf("T.TEST", hzSeq(plainPairs, hzTuple(num(floats(hzInts(1, 2))), num(floats(hzInts(1, 3)))))))),
+		hzW(1, shaped("", statOf("STEYX", onePair(smallIntsOf, smallIntsOf, hzInts(3, 12))))),
+		hzW(1, statOf("COVARIANCE.S", plainPairs)),
+		hzW(1, statOf("STANDARDIZE", hzTuple(num(numbers), num(numbers), num(positives)))),
+		hzW(1, statOf("Z.TEST", hzTuple(arr(plainRanges), num(numbers), num(positives)))),
+	),
+)
+
+func TestHegelStatErrorCodesAsDocumented(t *testing.T) { narrowStat(t, errorCodesAsDocumentedStat) }
+
+// --------------------------------------------------------------------------- excelize/22
+
+var (
+	varianceNames = hzSampled("VAR", "VAR.S", "VAR.P", "VARP", "VARA", "VARPA", "STDEV.P", "STDEVP", "STDEVPA")
+	// narrowRanges: 2..12 values of c + j c 10^-(3..6), j in -10..10, for c = (1..9) 10^(3..6):
+	// a mean a thousand to a million times the spread, where the one-pass formula loses
+	// 1e-10 to 1e-4 of the variance.
+	narrowRanges = hegel.Composite(func(tc hegel.TestCase) []float64 {
+		c := float64(hegel.Draw(tc, hzInts(1, 9))) * math.Pow(10, float64(hegel.Draw(tc, hzInts(3, 6))))
+		step := c * math.Pow(10, -float64(hegel.Draw(tc, hzInts(3, 6))))
+		js := hegel.Draw(tc, hzCounted(hzInts(-10, 10), 2, 12))
+		xs := make([]float64, len(js))
+		for i, j := range js {
+			xs[i] = c + float64(j)*step
+		}
+		return xs
+	})
+	varianceOf = func(rs hegel.Generator[[]float64]) hegel.Generator[statCase] {
+		return hegel.FlatMap(varianceNames, func(name string) hegel.Generator[statCase] {
+			return statOf(name, hzTuple(arr(rs)))
+		})
+	}
+)
+
+// onePassVariance: the variance functions over narrowRanges and the population standard
+// deviations over inexact constant ranges (the square root of the noise), and SKEW.P over
+// narrowRanges, where the one-pass formula misses the tolerance (hegel.Filter on the
+// replica: 3 draws in 5 pass). Past the shape, small integers. Hit rate 1000 of 1000.
+var onePassVariance = hzShaped(
+	hzWeighted(
+		hzW(3, shaped("excelize/22", varianceOf(narrowRanges))),
+		hzW(1, shaped("excelize/22", varianceOf(inexactConstants))),
+		hzW(1, shaped("excelize/22", statOf("SKEW.P", hzTuple(arr(hegel.Filter(narrowRanges, func(xs []float64) bool { return len(xs) >= 3 && !constant(xs) })))))),
+	),
+	hzWeighted(
+		hzW(3, shaped("", varianceOf(plainRanges))),
+		hzW(1, shaped("", statOf("SKEW.P", hzTuple(arr(rangesOf(hzInts(3, 12))))))),
+	),
+)
+
+func TestHegelStatVarianceIsTwoPass(t *testing.T) { narrowStat(t, onePassVariance) }
+
+// --------------------------------------------------------------------------- excelize/24
+
+var (
+	regressionNames = hzSampled("SLOPE", "INTERCEPT", "FORECAST", "FORECAST.LINEAR")
+	pearsonNames    = hzSampled("SLOPE", "INTERCEPT", "FORECAST", "FORECAST.LINEAR", "PEARSON", "RSQ")
+	// regressionOf: the regression functions over the pairs (FORECAST with an x first).
+	regressionOf = func(names hegel.Generator[string], ps hegel.Generator[[]hzArg]) hegel.Generator[statCase] {
+		return hegel.FlatMap(names, func(name string) hegel.Generator[statCase] {
+			if name == "FORECAST" || name == "FORECAST.LINEAR" {
+				return statOf(name, hzSeq(hzTuple(num(numbers)), ps))
+			}
+			return statOf(name, ps)
+		})
+	}
+	// constantYPairs: known_y's an exact constant, known_x's 2..12 small integers
+	constantYPairs = onePair(func(n int) hegel.Generator[[]float64] { return constantOf(floats(hzInts(-20, 20)), hegel.Just(n)) }, smallIntsOf, hzInts(2, 12))
+	// inexactXPairs: known_y's small integers, known_x's an inexact constant of 2..12
+	inexactXPairs = onePair(smallIntsOf, func(n int) hegel.Generator[[]float64] { return constantOf(decimals, hegel.Just(n)) }, hzInts(2, 12))
+	// zeroCovPairs: x = p, p, q, q and y = r, s, r, s (p != q, r != s): a covariance of
+	// exactly 0
+	zeroCovPairs = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+		p := hegel.Draw(tc, floats(hzInts(-20, 20)))
+		q := p + hegel.Draw(tc, signed(floats(hzInts(1, 20)), 50))
+		r := hegel.Draw(tc, floats(hzInts(-20, 20)))
+		s := r + hegel.Draw(tc, signed(floats(hzInts(1, 20)), 50))
+		return []hzArg{hzA([]float64{p, p, q, q}), hzA([]float64{r, s, r, s})}
+	})
+	// inexactPairs: an inexact constant with small integers, 3..12 values
+	inexactPairs = onePair(func(n int) hegel.Generator[[]float64] { return constantOf(decimals, hegel.Just(n)) }, smallIntsOf, hzInts(3, 12))
+	// differentConstantPairs: two exact constant ranges of 2..12 with different values
+	differentConstantPairs = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+		n := hegel.Draw(tc, hzInts(2, 12))
+		a := hegel.Draw(tc, floats(hzInts(-20, 20)))
+		b := a + hegel.Draw(tc, signed(floats(hzInts(1, 20)), 50))
+		xs, ys := make([]float64, n), make([]float64, n)
+		for i := range xs {
+			xs[i], ys[i] = a, b
+		}
+		return []hzArg{hzA(xs), hzA(ys)}
+	})
+)
+
+// zeroVarianceChecks: the regression of exact constant known_y's (#DIV/0!, want 0 or the
+// mean), the six pearsonProduct functions over a covariance of exactly 0 (#DIV/0!, want 0),
+// the regression with inexact constant known_x's, SKEW, KURT, CORREL and Z.TEST of an
+// inexact constant range (the deviations are rounding noise: a value, want #DIV/0!), and
+// T.TEST type 2 of two exact constant ranges with different values (0, want #DIV/0!; the
+// inexact ones in SKEW, KURT, CORREL, Z.TEST and the regression are hegel.Filter on the
+// replica, 4 draws in 5 pass). Past the shape, ranges and pairs with a variance. Hit rate
+// 1000 of 1000.
+var zeroVarianceChecks = hzShaped(
+	hzWeighted(
+		hzW(2, shaped("excelize/24", regressionOf(regressionNames, constantYPairs))), // the filter drops the known_x's that are constant by chance (#DIV/0! either way)
+		hzW(2, regressionOf(pearsonNames, zeroCovPairs)),
+		hzW(1, shaped("excelize/24", regressionOf(regressionNames, inexactXPairs))),
+		hzW(1, shaped("excelize/24", statOf("SKEW", hzTuple(arr(inexactConstants))))),
+		hzW(1, shaped("excelize/24", statOf("KURT", hzTuple(arr(constantOf(decimals, hzInts(4, 12))))))),
+		hzW(1, shaped("excelize/24", statOf("CORREL", inexactPairs))),
+		hzW(1, shaped("excelize/24", statOf("Z.TEST", hzTuple(arr(inexactConstants), num(numbers))))),
+		hzW(1, statOf("T.TEST", hzSeq(differentConstantPairs, hzTuple(num(floats(hzInts(1, 2))), hegel.Just(hzN(2)))))),
+	),
+	hzWeighted(
+		hzW(4, shaped("", regressionOf(pearsonNames, plainPairs))),
+		hzW(1, shaped("", statOf("SKEW", hzTuple(arr(rangesOf(hzInts(3, 12))))))),
+		hzW(1, shaped("", statOf("KURT", hzTuple(arr(rangesOf(hzInts(4, 12))))))),
+		hzW(1, shaped("", statOf("CORREL", plainPairs))),
+		hzW(1, shaped("", statOf("Z.TEST", hzTuple(arr(plainRanges), num(numbers))))),
+		hzW(1, shaped("", statOf("T.TEST", hzSeq(plainPairs, hzTuple(num(floats(hzInts(1, 2))), hegel.Just(hzN(2))))))),
+	),
+)
+
+func TestHegelStatZeroVarianceIsAnError(t *testing.T) { narrowStat(t, zeroVarianceChecks) }
+
+// --------------------------------------------------------------------------- excelize/26
+
+// confidenceTNearOne: CONFIDENCE.T with alpha = 1 - (1..100) / 10^6, in [0.9999, 0.999999],
+// a positive sd and a size of 2..100 (the inverse t loses digits for a quantile near 0; the
+// wide property's shape starts at 0.99, where the misses are partial: measured at 1000 cases,
+// 816 of 1000 from 0.999, 1000 of 1000 from 0.9999). Past the shape, thousandths of (0,
+// 0.98]. Hit rate 1000 of 1000.
+var confidenceTNearOne = hzShaped(
+	statOf("CONFIDENCE.T", hzTuple(num(hegel.Map(overTens(hzInts(1, 10), 6, 6), func(d float64) float64 { return 1 - d })), num(overTens(hzInts(1, 1000), 0, 1)), num(floats(hzInts(2, 100))))),
+	statOf("CONFIDENCE.T", hzTuple(num(overTens(hzInts(1, 980), 3, 3)), num(overTens(hzInts(1, 1000), 0, 1)), num(floats(hzInts(2, 100))))),
+)
+
+func TestHegelStatConfidenceTIsExact(t *testing.T) { narrowStat(t, confidenceTNearOne) }
+
+// --------------------------------------------------------------------------- excelize/83
+
+// geomeanOfLargeValues: GEOMEAN of hugeRanges (the product overflows: +INF) and of 2..6
+// values of (1..999) 10^-(165..300) (it underflows to 0: #NUM!; from 10^-160 the product is
+// a subnormal, whose remaining digits pass the tolerance one time in thirty). Past the
+// shape, 1..12 values of 1..1000 or of the thousands profile. Hit rate 1000 of 1000.
+var geomeanOfLargeValues = hzShaped(
+	statOf("GEOMEAN", hzTuple(arr(hzWeighted(
+		hzW(2, hugeRanges),
+		hzW(1, hzCounted(overTens(hzInts(1, 999), 165, 300), 2, 6)),
+	)))),
+	statOf("GEOMEAN", hzTuple(arr(hzWeighted(
+		hzW(1, hzCounted(floats(hzInts(1, 1000)), 1, 12)),
+		hzW(1, hzCounted(timesTens(hzInts(1, 999), 3, 3), 1, 12)),
+	)))),
+)
+
+func TestHegelStatGeomeanOfLargeValues(t *testing.T) { narrowStat(t, geomeanOfLargeValues) }
