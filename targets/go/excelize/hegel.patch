+		hzW(1, distOf("GAMMALN.PRECISE", hzTuple(num(hzWeighted(hzW(9, overflowX), hzW(1, timesTens(hzInts(1, 9), 3, 6))))))),
+	),
+)
+
+func TestHegelDistGammaLnOfLargeX(t *testing.T) { narrowDist(t, gammalnOverflow) }
+
+// --------------------------------------------------------------------------- excelize/32
+
+// bigCounts: 171..300.
+var bigCounts = floats(hzInts(171, 300))
+
+// hyperAt: a valid x, n, M, N for N in Ns.
+func hyperAt(Ns hegel.Generator[int]) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(Ns, func(N int) hegel.Generator[[]hzArg] {
+		return hegel.FlatMap(hzInts(1, N), func(n int) hegel.Generator[[]hzArg] {
+			return hegel.FlatMap(hzInts(1, N), func(M int) hegel.Generator[[]hzArg] {
+				return hegel.Map(hzInts(max(0, n-N+M), min(n, M)), func(x int) []hzArg {
+					return []hzArg{hzN(float64(x)), hzN(float64(n)), hzN(float64(M)), hzN(float64(N))}
+				})
+			})
+		})
+	})
+}
+
+// binomAt: k in 0..n, n, p, cumulative for n in ns and p in probs.
+func binomAt(ns hegel.Generator[int], probs hegel.Generator[float64]) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(ns, func(n int) hegel.Generator[[]hzArg] {
+		return hzTuple(num(floats(hzInts(0, n))), just(float64(n)), num(probs), cumulatives)
+	})
+}
+
+// midProbs: tenths of [0.1, 0.9] (a p near an end makes a power of 1 - p underflow at a
+// hundred trials: excelize/85).
+var midProbs = overTens(hzInts(1, 9), 1, 1)
+
+// overflowingFactors: the counts whose factorial is +Inf (171 and above): BINOM.DIST,
+// BINOMDIST and BINOM.DIST.RANGE with that many trials, HYPGEOM.DIST and HYPGEOMDIST with
+// that big a population, the negative binomial density with f + s - 1 that big; POISSON and
+// POISSON.DIST at x from 171 with a mean of 50..300 (the true value well above 1e-300) and at
+// x in 150..170 with a mean of 120..300 (mean^x overflows; hegel.Filter on the replica, 94
+// draws in 100 kept); the F density with d2 from 344 (Gamma((d1+d2)/2) overflows; every draw
+// kept) and the gamma density with alpha in 172..300 at x in [alpha/2, 2 alpha] beta. Past
+// the shape, counts to 170 (p in [0.1, 0.9]: see midProbs), d1 + d2 to 340, alpha to 150.
+// Hit rate 1000 of 1000.
+var overflowingFactors = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("BINOM.DIST", binomAt(hzInts(171, 300), plainProbs))),
+		hzW(1, distOf("BINOMDIST", binomAt(hzInts(171, 300), plainProbs))),
+		hzW(1, distOf("BINOM.DIST.RANGE", hzSeq(hzTuple(num(bigCounts), num(plainProbs), num(plainCounts)), hzMaybe(50, hzOne(num(floats(hzInts(31, 170)))))))),
+		hzW(1, distOf("HYPGEOM.DIST", hzSeq(hyperAt(hzInts(171, 300)), hzOne(cumulatives)))),
+		hzW(1, distOf("HYPGEOMDIST", hyperAt(hzInts(171, 300)))),
+		hzW(1, distOf("NEGBINOM.DIST", hzTuple(num(floats(hzInts(100, 200))), num(floats(hzInts(72, 150))), num(plainProbs), isDens))),
+		hzW(1, distOf("NEGBINOMDIST", hzTuple(num(floats(hzInts(100, 200))), num(floats(hzInts(72, 150))), num(plainProbs)))),
+		hzW(1, distShaped("excelize/32", distOf("POISSON", hzTuple(num(floats(hzInts(150, 300))), num(floats(hzInts(50, 300))), cumulatives)))),
+		hzW(1, distShaped("excelize/32", distOf("POISSON.DIST", hzTuple(num(floats(hzInts(150, 300))), num(floats(hzInts(50, 300))), cumulatives)))),
+		hzW(1, distShaped("excelize/32", distOf("F.DIST", hzTuple(num(overTens(hzInts(1, 1000), 2, 2)), num(floats(hzInts(1, 300))), num(floats(hzInts(344, 600))), isDens)))),
+		hzW(1, distOf("GAMMA.DIST", gammaDensAt(floats(hzInts(172, 300))))),
+		hzW(1, distOf("GAMMADIST", gammaDensAt(floats(hzInts(172, 300))))),
+	),
+	hzWeighted(
+		hzW(2, distOf("BINOM.DIST", binomAt(hzInts(100, 170), midProbs))),
+		hzW(1, distOf("BINOMDIST", binomAt(hzInts(100, 170), midProbs))),
+		hzW(1, distOf("BINOM.DIST.RANGE", hzSeq(hzTuple(num(floats(hzInts(100, 170))), num(midProbs), num(plainCounts)), hzMaybe(50, hzOne(num(floats(hzInts(31, 100)))))))),
+		hzW(1, distOf("HYPGEOMDIST", hyperAt(hzInts(100, 170)))),
+		hzW(1, distOf("NEGBINOMDIST", hzTuple(num(floats(hzInts(50, 100))), num(floats(hzInts(1, 70))), num(plainProbs)))),
+		hzW(1, distOf("POISSON", hzTuple(num(floats(hzInts(100, 150))), num(floats(hzInts(50, 100))), cumulatives))),
+		hzW(1, distOf("F.DIST", hzTuple(num(overTens(hzInts(1, 1000), 2, 2)), num(floats(hzInts(1, 170))), num(floats(hzInts(1, 170))), isDens))),
+		hzW(1, distOf("GAMMA.DIST", gammaDensAt(floats(hzInts(50, 150))))),
+	),
+)
+
+// gammaDensAt: x in [alpha/2, 2 alpha] beta, alpha, beta, FALSE.
+func gammaDensAt(alphas hegel.Generator[float64]) hegel.Generator[[]hzArg] {
+	return hegel.Map(hzTuple(alphas, overTens(hzInts(50, 200), 2, 2), hzSampled(1.0, 0.5, 2)), func(v []float64) []hzArg {
+		return []hzArg{hzN(v[1] * v[0] * v[2]), hzN(v[0]), hzN(v[2]), hzB(false)}
+	})
+}
+
+func TestHegelDistGammaFactorsDoNotOverflow(t *testing.T) { narrowDist(t, overflowingFactors) }
+
+// --------------------------------------------------------------------------- excelize/84
+
+// fInvTinyQuantiles: F.INV, F.INV.RT and FINV over tinyFInv (d1 of 1 with q in [1e-10, 1e-6],
+// d1 of 2 with q in [1e-13, 1e-11], d2 in 1..40: the beta quantile below 2e-11, where the
+// rounding of 1 - B' loses more than 1e-7 of it unless the roundings align). Past the shape,
+// the same functions at thousandths of (0, 1) with d1 and d2 in 1..40, where the quantile is
+// above 4e-8. Hit rate 945 of 1000 (every case at d1 = 1 fails; at d1 = 2 one in ten passes,
+// nearly all right-tailed, where q = 1 - p is on the binary grid and 1 - 2q/d2 can be exact).
+var fInvTinyQuantiles = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("F.INV", tinyFInv(true))),
+		hzW(1, distOf("F.INV.RT", tinyFInv(false))),
+		hzW(1, distOf("FINV", tinyFInv(false))),
+	),
+	hzWeighted(
+		hzW(2, distOf("F.INV", hzTuple(num(plainProbs), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("F.INV.RT", hzTuple(num(plainProbs), num(plainDegrees), num(plainDegrees)))),
+		hzW(1, distOf("FINV", hzTuple(num(plainProbs), num(plainDegrees), num(plainDegrees)))),
+	),
+)
+
+func TestHegelDistFInvKeepsTinyQuantiles(t *testing.T) { narrowDist(t, fInvTinyQuantiles) }
+
+// --------------------------------------------------------------------------- excelize/85
+
+// binomMidAt: x in 32..n/2, n in 100..170, p in midProbs, cumulative (no power underflows:
+// 0.1^138 is 1e-138).
+var binomMidAt = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	n := hegel.Draw(tc, hzInts(100, 170))
+	x := hegel.Draw(tc, hzInts(32, n/2))
+	return []hzArg{hzN(float64(x)), hzN(float64(n)), hegel.Draw(tc, num(midProbs)), hegel.Draw(tc, cumulatives)}
+})
+
+// negbinomMidAt: f in 50..126, s in 45..(171 - f) and p in midProbs.
+var negbinomMidAt = hegel.Map(hzTuple(floats(hzInts(50, 126)), floats(hzInts(45, 121)), midProbs), func(v []float64) []hzArg {
+	return []hzArg{hzN(v[0]), hzN(math.Min(v[1], 171-v[0])), hzN(v[2])}
+})
+
+// binomialUnderflows: the binomial terms whose power underflows while the term is
+// representable (underflowingTerm): BINOM.DIST and BINOMDIST (the density in both forms, the
+// cumulative with p near 1; hegel.Filter on the replica: every draw kept), BINOM.DIST.RANGE
+// (both forms, with number_s2 absent or 0..2 above number_s: 90 draws in 100 kept, the
+// three-argument form every one), the NEGBINOM.DIST density and NEGBINOMDIST (negbinomTerm,
+// either power: every draw kept). Past the shape, the same counts at p in [0.1, 0.9]. Hit
+// rate 995 of 1000 (the five are cumulatives near 1e-295 that SciPy's own cdf flushes to 0:
+// the classifier leaves an oracle answer of 0 unnamed and both sides give 0).
+var binomialUnderflows = hzShaped(
+	hzWeighted(
+		hzW(2, distOf("BINOM.DIST", binomUnderflow)),
+		hzW(1, distOf("BINOMDIST", binomUnderflow)),
+		hzW(1, distOf("BINOM.DIST.RANGE", binomRangeUnderflow)),
+		hzW(1, distOf("NEGBINOM.DIST", negbinomUnderflow(true))),
+		hzW(1, distOf("NEGBINOMDIST", negbinomUnderflow(false))),
+	),
+	hzWeighted(
+		hzW(2, distOf("BINOM.DIST", binomMidAt)),
+		hzW(1, distOf("BINOMDIST", binomMidAt)),
+		hzW(1, distOf("BINOM.DIST.RANGE", hegel.Map(binomMidAt, func(a []hzArg) []hzArg { return []hzArg{a[1], a[2], a[0], hzN(a[0].num + 2)} }))),
+		hzW(1, distOf("NEGBINOM.DIST", hzSeq(negbinomMidAt, hegel.Just([]hzArg{hzB(false)})))),
+		hzW(1, distOf("NEGBINOMDIST", negbinomMidAt)),
+	),
+)
+
+func TestHegelDistBinomialTermsDoNotUnderflow(t *testing.T) { narrowDist(t, binomialUnderflows) }
diff --git a/hegel/hegel_zoo_dist_test.go b/hegel/hegel_zoo_dist_test.go
new file mode 100644
index 0000000..b8d3d91
--- /dev/null
+++ b/hegel/hegel_zoo_dist_test.go
@@ -0,0 +1,1407 @@
+package hegel
+
+// TestHegelDist: the probability distribution functions (normal, lognormal, Student's t,
+// chi-squared, F, beta, gamma, exponential, Poisson, binomial, negative binomial,
+// hypergeometric, Weibull), their inverses, the gamma function, the error functions and the
+// Bessel functions agree with SciPy, with Excel's argument rules (degrees of freedom and
+// counts truncated, the errors of the documented domains).
+//
+// The model is the oracle (hzStartOracle: SciPy by Excel's definitions; a value, an error
+// with its code, or a skip). The tolerances are model facts: 1e-8 relative in general, the
+// Bessel functions 1e-6 relative and 1e-7 absolute (the recurrences of high orders; the zeros
+// of Y), the Weibull, exponential and gamma distributions 1e-15 absolute (1 - exp(-t) for a
+// tiny t), the inverse normals and the inverse t 1e-12 relative, the inverse F 1e-7 relative.
+//
+// A case is a function of the distSpecs table with its arguments, drawn from the kinds below
+// (package-level generators: scores, locations, scales, probabilities, degrees, shapes,
+// cumulatives, tailCounts, smallCounts, the beta tuples, the hypergeometric tuple). The shapes
+// of the recorded bugs are drawn deliberately (an alternative of the kind, a region of the
+// function's arguments, never under HEGEL_NO_KNOWN=1), judged like every other case and
+// named by the classifier distShape; under HEGEL_NO_KNOWN=1 the plain draws that land in a
+// shape are filtered out (distOnly, counted "filtered NAME"), the function-wide shape of
+// excelize/13 is off the table, and the precision of the inverse normals (excelize/12) and of
+// the inverse t (excelize/26) is judged at the relaxed tolerance (judgeDist). Every region
+// was measured against the oracle (the boundaries quoted at the generators and the rules).
+// Two bugs were found by this property once the far-tail gate was removed and recorded as
+// excelize/84 (the inverse F at a tiny quantile) and excelize/85 (the binomial powers
+// underflowing); their shapes are drawn like the others.
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- kinds
+
+var (
+	// scores (the z kind): thousandths of [-6, 6], tenths of [-30, 30] one time in ten, the
+	// ends {0, +-1, +-8, +-40, 1e-9} one time in ten.
+	scores = hzWeighted(
+		hzW(8, overTens(hzInts(-6000, 6000), 3, 3)),
+		hzW(1, overTens(hzInts(-300, 300), 1, 1)),
+		hzW(1, hzSampled(0.0, 1, -1, 8, -8, 40, -40, 1e-9)),
+	)
+
+	// farScores: z in [-36.5, -6.5] by hundredths, the lower tail the cumulative normal
+	// flushes (excelize/11; measured at rtol 1e-8 against the oracle: every z from -6.15 down
+	// fails, -5.95 does and -6.05 does not, the result is 0 from -8.3; the oracle keeps the
+	// tail to -37.5).
+	farScores = hegel.Map(hzInts(650, 3650), func(i int) float64 { return -float64(i) / 100 })
+
+	// locations (the m kind): a mean, 0 two times in seven.
+	locations = hzSampled(0.0, 0, 1, -2.5, 10, 100, 0.001)
+
+	// finiteScales: thousandths of (0, 20], and 1..100 one time in nine.
+	finiteScales = hzWeighted(hzW(8, overTens(hzInts(1, 20000), 3, 3)), hzW(1, floats(hzInts(1, 100))))
+
+	// scales (the pos kind): finiteScales, and the ends {0, -1, 1e-6, 1000, 0.5} one time in ten.
+	scales = hzWeighted(hzW(9, finiteScales), hzW(1, hzSampled(0.0, -1, 1e-6, 1000, 0.5)))
+
+	// probabilities (the prob kind, hzGenProb's profile): thousandths of (0, 1), the near
+	// ends {1e-10, 1e-6, 1-1e-6, 0.999, 0.001} one time in ten, the ends and just outside
+	// {0, 1, -0.1, 1.1} one time in ten.
+	probabilities = hzWeighted(
+		hzW(8, overTens(hzInts(1, 999), 3, 3)),
+		hzW(1, hzSampled(1e-10, 1e-6, 1-1e-6, 0.999, 0.001)),
+		hzW(1, hzSampled(0.0, 1, -0.1, 1.1)),
+	)
+
+	// tinyDeltas: (1..100) / 10^(6..9), in [1e-9, 1e-4].
+	tinyDeltas = overTens(hzInts(1, 100), 6, 9)
+
+	// medianProbs: 0.5 +- a tiny delta, the quantile near 0 where T.INV's absolute tolerance
+	// shows (excelize/26; measured at rtol 1e-7: every delta to 2e-6 fails, half at 1e-5, none
+	// from 1e-4).
+	medianProbs = hzWeighted(
+		hzW(1, hegel.Map(tinyDeltas, func(d float64) float64 { return 0.5 - d })),
+		hzW(1, hegel.Map(tinyDeltas, func(d float64) float64 { return 0.5 + d })),
+	)
+
+	// topProbs: 1 - a tiny delta, the same quantile for T.INV.2T and TINV (measured at rtol
+	// 1e-7: every delta to 5.6e-6 fails, 7 in 8 at 1e-5, 1 in 8 at 1e-4, none from 1.8e-4).
+	topProbs = hegel.Map(tinyDeltas, func(d float64) float64 { return 1 - d })
+
+	// tInvProbs, tInv2TProbs: probabilities, and the shape of excelize/26 one time in ten
+	// (never under HEGEL_NO_KNOWN=1).
+	tInvProbs   = hzWeighted(hzW(9, probabilities), hzW(hzUnless(hzNoKnown, 1), medianProbs))
+	tInv2TProbs = hzWeighted(hzW(9, probabilities), hzW(hzUnless(hzNoKnown, 1), topProbs))
+
+	// fractionalDegrees: 0.5 and 1.9, or (1.05..40.85) by tenths and a half: a df the library
+	// does not truncate (excelize/15), or below 1 where CHIDIST accepts it.
+	fractionalDegrees = hzWeighted(
+		hzW(1, hzSampled(0.5, 1.9)),
+		hzW(1, hegel.Map(hzInts(10, 408), func(i int) float64 { return float64(i)/10 + 0.05 })),
+	)
+
+	// degrees (the df kind): 1..40, 1..3 one time in ten, the ends {0, 200, 1000, -1} one time
+	// in ten, and fractionalDegrees one time in ten (never under HEGEL_NO_KNOWN=1).
+	degrees = hzWeighted(
+		hzW(8, floats(hzInts(1, 40))),
+		hzW(1, floats(hzInts(1, 3))),
+		hzW(1, hzSampled(0.0, 200, 1000, -1)),
+		hzW(hzUnless(hzNoKnown, 1), fractionalDegrees),
+	)
+
+	// shapes (the shape kind): tenths of [0.5, 15], the ends {0, -1, 0.1, 50, 1} one time in ten.
+	shapes = hzWeighted(hzW(9, overTens(hzInts(5, 150), 1, 1)), hzW(1, hzSampled(0.0, -1, 0.1, 50, 1)))
+
+	// cumulatives: FALSE or TRUE.
+	cumulatives = hegel.Map(hzCoin(50), hzB)
+
+	// tailCounts: TDIST's tails, 1 and 2 mostly, 3 and 0 (#NUM!), and 1.5 or 2.5 one time in
+	// six (truncated by Excel, rejected here: excelize/15; never under HEGEL_NO_KNOWN=1).
+	tailCounts = hzWeighted(
+		hzW(5, hzSampled(1.0, 2, 2, 1, 3, 0)),
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(1.5, 2.5)),
+	)
+
+	// smallCounts (the cnt kind): 0..30, the ends {-1, 100, 0, 200} one time in ten, a
+	// fraction {2.5, 0.9} (excelize/15) and 171..300 (the factorials overflow, excelize/32)
+	// one time in ten each, never under HEGEL_NO_KNOWN=1.
+	smallCounts = hzWeighted(
+		hzW(9, floats(hzInts(0, 30))),
+		hzW(1, hzSampled(-1.0, 100, 0, 200)),
+		hzW(hzUnless(hzNoKnown, 1), hzSampled(2.5, 0.9)),
+		hzW(hzUnless(hzNoKnown, 1), floats(hzInts(171, 300))),
+	)
+
+	// besselOrders: a Bessel order, smallCounts (the fractions and the big orders included: the
+	// fraction is excelize/15 in every Bessel function; a big order makes the oracle skip).
+	besselOrders = smallCounts
+)
+
+// halved: the integers of g halved.
+func halved(g hegel.Generator[int]) hegel.Generator[float64] {
+	return hegel.Map(g, func(i int) float64 { return float64(i) / 2 })
+}
+
+// --------------------------------------------------------------------------- the normal family
+
+// farNormal: x = mean + sd z with z in farScores, cumulative: the shape of excelize/11 in
+// NORM.DIST and NORMDIST.
+var farNormal = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	m := hegel.Draw(tc, locations)
+	s := hegel.Draw(tc, finiteScales)
+	z := hegel.Draw(tc, farScores)
+	return []hzArg{hzN(m + s*z), hzN(m), hzN(s), hzB(true)}
+})
+
+// farLognormal: x = exp(mean + sd z) with z in farScores (sd at most 20, so that x stays
+// above the subnormal range): the shape of excelize/11 in LOGNORM.DIST (cumulative) and
+// LOGNORMDIST.
+func farLognormal(withCum bool) hegel.Generator[[]hzArg] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzArg {
+		m := hegel.Draw(tc, locations)
+		s := hegel.Draw(tc, overTens(hzInts(1, 20000), 3, 3))
+		z := hegel.Draw(tc, farScores)
+		args := []hzArg{hzN(math.Exp(m + s*z)), hzN(m), hzN(s)}
+		if withCum {
+			args = append(args, hzB(true))
+		}
+		return args
+	})
+}
+
+// withShape: the plain arguments, and the shape one time in ten (never under HEGEL_NO_KNOWN=1).
+func withShape(plain, shape hegel.Generator[[]hzArg]) hegel.Generator[[]hzArg] {
+	return hzWeighted(hzW(9, plain), hzW(hzUnless(hzNoKnown, 1), shape))
+}
+
+var (
+	normDistArgs    = withShape(hzTuple(num(scores), num(locations), num(scales), cumulatives), farNormal)
+	normSDistArgs   = withShape(hzTuple(num(scores), cumulatives), hzTuple(num(farScores), hegel.Just(hzB(true))))
+	normSDistOld    = withShape(hzTuple(num(scores)), hzTuple(num(farScores)))
+	lognormDistArgs = withShape(hzTuple(num(scales), num(locations), num(scales), cumulatives), farLognormal(true))
+	lognormDistOld  = withShape(hzTuple(num(scales), num(locations), num(scales)), farLognormal(false))
+	normInvArgs     = hzTuple(num(probabilities), num(locations), num(scales))
+)
+
+// --------------------------------------------------------------------------- the beta and hypergeometric tuples
+
+// betaArgsOf: x, alpha, beta[, cumulative][, A, B]: the bounds [A, B] two times in five (A
+// in -10..10, B = A + 0..10 by halves), x at hundredths of [A, B], just outside two times in
+// twenty-five.
+func betaArgsOf(withCum bool) hegel.Generator[[]hzArg] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzArg {
+		lo, hi := 0.0, 1.0
+		withBounds := hegel.Draw(tc, hzCoin(40))
+		if withBounds {
+			lo = float64(hegel.Draw(tc, hzInts(-10, 10)))
+			hi = lo + float64(hegel.Draw(tc, hzInts(0, 20)))/2
+		}
+		x := lo + (hi-lo)*float64(hegel.Draw(tc, hzInts(0, 100)))/100
+		if hegel.Draw(tc, hzCoin(8)) {
+			x = hegel.Draw(tc, hzSampled(lo-0.5, hi+0.5))
+		}
+		args := []hzArg{hzN(x), hegel.Draw(tc, num(shapes)), hegel.Draw(tc, num(shapes))}
+		if withCum {
+			args = append(args, hegel.Draw(tc, cumulatives))
+		}
+		if withBounds {
+			args = append(args, hzN(lo), hzN(hi))
+		}
+		return args
+	})
+}
+
+// bounds: A in -10..10 and B = A + 0..10 by halves, as the optional pair of BETA.INV.
+var bounds = hegel.Composite(func(tc hegel.TestCase) []hzArg {
+	lo := float64(hegel.Draw(tc, hzInts(-10, 10)))
