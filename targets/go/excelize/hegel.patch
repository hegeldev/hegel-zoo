+def xafterbefore(after, text, delim, k, mode, match_end, if_not_found):
+    text, delim = xtext(text), xtext(delim)
+    k = xnum(k)
+    if k != trunc(k) and -1 < k < 1:
+        raise Skip()
+    k = int(trunc(k))
+    mode = xlogic(mode)
+    match_end = xlogic(match_end)
+    if k == 0:
+        raise XErr(VALUE)
+    if delim == "":
+        raise Skip()
+    t, dl = (text.lower(), delim.lower()) if mode else (text, delim)
+    hits = []
+    pos = 0
+    while True:
+        i = t.find(dl, pos)
+        if i < 0:
+            break
+        hits.append(i)
+        pos = i + len(dl)
+    if k < 0 and len(dl) > 1 and t.count(dl) != len(re.findall("(?=" + re.escape(dl) + ")", t)):
+        raise Skip()  # overlapping occurrences counted from the end: not modelled
+    if text == "":
+        raise XErr(NA) if not match_end else Skip()
+    n = len(hits)
+    if abs(k) > n:
+        if match_end and abs(k) == n + 1:
+            if k > 0:
+                return "" if after else text
+            return text if after else ""
+        if if_not_found is not None:
+            return xtext(if_not_found)
+        raise XErr(NA)
+    i = hits[k - 1] if k > 0 else hits[n + k]
+    return text[i + len(delim):] if after else text[:i]
