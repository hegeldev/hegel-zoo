+	{name: "ROMAN", args: romanArgs, trip: hzTuple(floats(hzInts(1, 3999)), floats(hzInts(0, 4)))},
+	{name: "ROUND", args: only("ROUND", hzTuple(num(numbers), num(digits)))},
+	{name: "ROUNDDOWN", args: only("ROUNDDOWN", roundDownArgs)},
+	{name: "ROUNDUP", args: only("ROUNDUP", hzTuple(num(numbers), num(digits)))},
