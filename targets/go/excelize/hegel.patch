+				}
+			}
+		}
+	}
+	// the logical functions
+	switch name {
+	case "IF", "IFS":
+		for i := 0; i < len(args); i++ {
+			if name == "IF" && i > 0 || name == "IFS" && i%2 == 1 {
+				continue
+			}
+			if v, ok := numArg(i); ok && args[i].kind == 'n' && v != 0 && v != 1 && avoid(&HZKnown.ifTruthiness, "ifTruthiness") {
+				return true
+			}
+			if s, ok := strArg(i); ok && s != "TRUE" && s != "FALSE" && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+		}
+		if name == "IF" && len(args) == 2 && avoid(&HZKnown.ifOmittedFalse, "ifOmittedFalse") {
+			return true
+		}
+		if name == "IF" {
+			for _, a := range args[1:] {
+				if (a.kind == 'b' || a.kind == 'e') && avoid(&HZKnown.ifResultTypes, "ifResultTypes") {
+					return true
+				}
+			}
+		}
+	case "XOR":
+		for _, a := range args {
+			if a.kind == 's' && avoid(&HZKnown.logicalText, "logicalText") {
+				return true
+			}
+		}
+	case "ISEVEN", "ISODD":
+		if s, isStr := strArg(0); isStr && strings.TrimSpace(s) != s {
+			if _, err := strconv.ParseFloat(strings.TrimSpace(s), 64); err == nil && avoid(&HZKnown.valueParsing, "valueParsing") {
+				return true
+			}
+		}
+		if name == "ISODD" {
+			if (args[0].kind == 'b' || args[0].kind == 'e') && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+				return true
+			}
+			break
+		}
+		v, ok := numArg(0)
+		if s, isStr := strArg(0); isStr {
+			if f, err := strconv.ParseFloat(s, 64); err == nil {
+				v, ok = f, true
+			}
+		}
+		if ok && args[0].kind != 'b' && v != 1 && int64(math.Trunc(v))%2 != 0 && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+			return true
+		}
+		if args[0].kind == 'b' && avoid(&HZKnown.isEvenOdd, "isEvenOdd") {
+			return true
+		}
+	case "ISNUMBER":
+		if args[0].kind == 'b' && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+			return true
+		}
+	case "AND":
+		for i, a := range args {
+			zero := a.kind == 's' && a.s == "FALSE"
+			for _, v := range a.arr {
+				zero = zero || v == 0
+			}
+			if zero && i+1 < len(args) && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+		}
+	case "OR":
+		seenText := false
+		for i, a := range args {
+			if (a.kind == 'a' || a.kind == 'n' && a.num != 0 || a.kind == 'b' && a.b) && i+1 < len(args) && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+			if seenText && (a.kind == 'n' || a.kind == 'b') && avoid(&HZKnown.orArgsSkipped, "orArgsSkipped") {
+				return true
+			}
+			if a.kind == 's' && a.s == "TRUE" {
+				seenText = true
+			}
+		}
+	case "ISTEXT", "N", "ISLOGICAL":
+		if s, ok := strArg(0); ok {
+			if _, err := strconv.ParseFloat(s, 64); (err == nil || strings.EqualFold(s, "TRUE") || strings.EqualFold(s, "FALSE")) && avoid(&HZKnown.textNumbersAsValues, "textNumbersAsValues") {
+				return true
+			}
+		}
+	case "SWITCH":
+		for i := 1; i+1 < len(args); i += 2 {
+			if (args[0].kind != args[i].kind || args[i].kind == 's') && avoid(&HZKnown.switchComparison, "switchComparison") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+var hzGroupedRe = regexp.MustCompile(`^[+-]?\d{1,3}(,\d{3})+(\.\d*)?$`)
+
+// hzHalfCase says whether rounding x to places decimals (or to places+1 significant digits
+// when sig) is a decimal half case, where binary rounding may differ from Excel's.
+func hzHalfCase(x float64, places int, sig bool) bool {
+	s := strings.TrimPrefix(hzNumLit(math.Abs(x)), "-")
+	if sig {
+		digits := strings.TrimLeft(strings.ReplaceAll(s, ".", ""), "0")
+		return len(digits) == places+2 && strings.HasSuffix(digits, "5")
+	}
+	_, frac, ok := strings.Cut(s, ".")
+	return ok && len(frac) == places+1 && strings.HasSuffix(frac, "5")
+}
+
+var hzLogicFuncs = []string{"AND", "OR", "XOR", "NOT", "IF", "IFS", "SWITCH", "IFERROR", "IFNA", "ISBLANK", "ISERR", "ISERROR", "ISNA", "ISLOGICAL", "ISNUMBER", "ISTEXT", "ISNONTEXT", "ISEVEN", "ISODD", "TYPE", "ERROR.TYPE", "N", "T", "NA", "TRUE", "FALSE"}
+
+// hzGenValue draws a value of any kind, errors included.
+func hzGenValue(tc hegel.TestCase, errors bool) hzArg {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0, 1, 2:
+		return hzN(hzGenTextNum(tc))
+	case 3, 4:
+		return hzB(hzGenBool(tc))
+	case 5, 6:
+		return hzS(hzGenText(tc, false))
+	case 7:
+		return hzS(hzPick(tc, []string{"TRUE", "FALSE", "1", "0", "", "1.5", "true"}))
+	default:
+		if errors {
+			return hzE(hzPick(tc, []string{"#N/A", "#DIV/0!", "#NUM!", "#VALUE!"}))
+		}
+		return hzN(float64(hzDrawInt(tc, -3, 3)))
+	}
+}
+
+// hzGenLogicArgs draws the arguments of a logical or information function.
+func hzGenLogicArgs(tc hegel.TestCase, name string) []hzArg {
+	switch name {
+	case "AND", "OR", "XOR":
+		n := hzDrawInt(tc, 1, 4)
+		args := make([]hzArg, n)
+		for i := range args {
+			if hzChance(tc, 15) {
+				args[i] = hzA(hzGenSeries(tc, hzDrawInt(tc, 1, 4)))
+			} else {
+				args[i] = hzGenLogical(tc)
+			}
+		}
+		return args
+	case "NOT":
+		return []hzArg{hzGenLogical(tc)}
+	case "IF":
+		args := []hzArg{hzGenLogical(tc), hzGenValue(tc, true)}
+		if hzChance(tc, 80) {
+			args = append(args, hzGenValue(tc, true))
+		}
+		return args
+	case "IFS":
+		n := hzDrawInt(tc, 1, 3)
+		var args []hzArg
+		for i := 0; i < n; i++ {
+			args = append(args, hzGenLogical(tc), hzGenValue(tc, false))
+		}
+		return args
+	case "SWITCH":
+		expr := hzGenValue(tc, false)
+		args := []hzArg{expr}
+		n := hzDrawInt(tc, 1, 3)
+		for i := 0; i < n; i++ {
+			v := hzGenValue(tc, false)
+			if hzChance(tc, 40) {
+				v = expr
+				if v.kind == 's' && hzChance(tc, 50) {
+					v = hzS(strings.ToUpper(v.s))
+				}
+			}
+			args = append(args, v, hzGenValue(tc, false))
+		}
+		if hzChance(tc, 50) {
+			args = append(args, hzGenValue(tc, false))
+		}
+		return args
+	case "IFERROR", "IFNA":
+		return []hzArg{hzGenValue(tc, true), hzGenValue(tc, false)}
+	case "NA", "TRUE", "FALSE":
+		return nil
+	default:
+		return []hzArg{hzGenValue(tc, true)}
+	}
+}
