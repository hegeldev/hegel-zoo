+)
+
+// --------------------------------------------------------------------------- argument lists
+
+// noShape is the predicate of the hzOnly filters: the case has no recorded bug's shape, judged
+// with the Go model's verdict (goVerdict) where the shape is a relation of the result.
+func noShape(name string) func([]hzArg) bool {
+	return func(args []hzArg) bool {
+		c := mathCase{name: name, args: args}
+		return mathShape(c, goVerdict(c)) == ""
+	}
+}
+
+// only is hzOnly over the arguments of name under HEGEL_NO_KNOWN=1, named after the function.
+func only(name string, g hegel.Generator[[]hzArg]) hegel.Generator[[]hzArg] {
+	return hzOnly(hzNoKnown, name, g, noShape(name))
+}
+
+// orderedCountsFrom: (n, k) with n in lo..30 and k at most n, for COMBIN, COMBINA and PERMUT
+// under HEGEL_NO_KNOWN=1 (number_chosen above number is the shape of excelize/21 in half of
+// the unordered pairs, too many to filter); by default the unordered pairs are drawn too.
+func orderedCountsFrom(lo int) hegel.Generator[[]hzArg] {
+	return hegel.FlatMap(floats(hzInts(lo, 30)), func(n float64) hegel.Generator[[]hzArg] {
+		return hzTuple(hegel.Just(hzN(n)), num(hzWeighted(
+			hzW(18, floats(hzInts(0, int(n)))),
+			hzW(1, hzSampled(0.5, math.Max(n-0.5, 0.5))),
+		)))
+	})
+}
+
+var countPairs = hzWeighted(
+	hzW(hzUnless(hzNoKnown, 3), hzTuple(num(counts), num(counts))),
+	hzW(4, orderedCountsFrom(0)),
+)
+
+// combinaPairs: COMBINA's pairs, countPairs, whose (0,0) (two counts of 0 or two fractions
+// below 1, and the ordered pairs' n = 0) is the shape of excelize/79; under HEGEL_NO_KNOWN=1
+// the ordered pairs from n = 1 (hzShaped: the filter is then excelize/6's relation alone).
+var combinaPairs = hzShaped(countPairs, orderedCountsFrom(1))
+
+// digitChars: one of the digits lo..hi of base 36, lowercase 20% of the time.
+func digitChars(lo, hi int) hegel.Generator[byte] {
+	return hegel.Composite(func(tc hegel.TestCase) byte {
+		c := hzDigits36[hegel.Draw(tc, hzInts(lo, hi))]
+		if hegel.Draw(tc, hzCoin(20)) {
+			c = strings.ToLower(string(c))[0]
+		}
+		return c
+	})
+}
+
+func text(g hegel.Generator[[]byte]) hegel.Generator[hzArg] {
+	return hegel.Map(g, func(b []byte) hzArg { return hzS(string(b)) })
+}
+
+// hexPrefix: the prefix 0x, or 0X one time in five.
+var hexPrefix = hegel.Map(hzCoin(20), func(upper bool) []byte {
+	if upper {
+		return []byte("0X")
+	}
+	return []byte("0x")
+})
+
+// decimalArgs: DECIMAL's text and radix, the text of one to eight digits of the radix (a
+// radix out of range takes any digit) or, never under HEGEL_NO_KNOWN=1, with a digit at or
+// above the radix (the shape of excelize/21) or, for a radix in range, 0x or 0X before one to
+// six digits of the radix (the shape of excelize/82: the library strips the prefix in every
+// radix), one draw in eleven.
+var decimalArgs = hegel.FlatMap(radixes, func(r float64) hegel.Generator[[]hzArg] {
+	base := int(r)
+	inRange := base >= 2 && base <= 36
+	if !inRange {
+		base = 36
+	}
+	var choices []hzChoice[[]byte]
+	if base < 36 {
+		above := hzSeq(hzCounted(digitChars(0, base-1), 0, 3), hzOne(digitChars(base, 35)), hzCounted(digitChars(0, 35), 0, 4))
+		choices = append(choices, hzW(hzUnless(hzNoKnown, 2), above))
+	}
+	if inRange {
+		prefixed := hzSeq(hexPrefix, hzCounted(digitChars(0, base-1), 1, 6))
+		choices = append(choices, hzW(hzUnless(hzNoKnown, 1), prefixed))
+	}
+	choices = append(choices, hzW(8, hzCounted(digitChars(0, base-1), 1, 8)))
+	return hzTuple(text(hzWeighted(choices...)), hegel.Just(hzN(r)))
+})
+
+// romanForm1Differs: the concise form 1 numeral of n differs from the classic one (the
+// library's form 1 table adds LM 950, LD 450, VC 95 and VL 45; checked against the library
+// for every n in 0..3999).
+func romanForm1Differs(n float64) bool {
+	r1000 := math.Mod(n, 1000)
+	r100 := math.Mod(n, 100)
+	return r1000 >= 950 || (450 <= r1000 && r1000 < 500) || r100 >= 95 || (45 <= r100 && r100 < 50)
+}
+
+// romanArgs: ROMAN's number and form; the form TRUE is read as form 1 (excelize/18) where
+// that differs, a relation filtered out under HEGEL_NO_KNOWN=1 (measured: 1.2% of ROMAN's
+// draws rejected; the other hzOnly filters reject 0.3% (LOG) to 26% (ATANH, the engine
+// favouring the ends of the unit range) of their function's draws, so a give-up after three
+// rejections is below 2% of any function's cases).
+var romanArgs = hzOnly(hzNoKnown, "ROMAN", hzWeighted(
+	hzW(1, hzTuple(num(romans))),
+	hzW(1, hzTuple(num(romans), forms)),
+), func(a []hzArg) bool {
+	return !(len(a) == 2 && a[1].kind == 'b' && a[1].b && romanForm1Differs(math.Trunc(a[0].num)))
+})
+
+// roundDownArgs: ROUNDDOWN's number and digits. The binary quotient misses an exact decimal
+// (excelize/29) in half of the plain draws with positive digits, too many to filter, so under
+// HEGEL_NO_KNOWN=1 the digits are not positive, or the number has more decimals than the
+// digits keep (a quotient that is not an integer is never missed).
+var roundDownArgs = hzWeighted(
+	hzW(hzUnless(hzNoKnown, 2), hzTuple(num(numbers), num(digits))),
+	hzW(1, hzTuple(num(numbers), num(floats(hzInts(-6, 0))))),
+	hzW(1, hegel.FlatMap(hzInts(1, 6), func(d int) hegel.Generator[[]hzArg] {
+		return hzTuple(num(signed(overTens(hzInts(1, 99999), d+1, d+3), 40)), hegel.Just(hzN(float64(d))))
+	})),
+)
+
+// one to six arguments of g
+func some(g hegel.Generator[hzArg]) hegel.Generator[[]hzArg] { return hzCounted(g, 1, 6) }
+
+// optional: the required arguments, then one or two optional ones, the shorter lists first
+// (50% stop at each optional, as the old spec's "?").
+func optional(required hegel.Generator[[]hzArg], optionals ...hegel.Generator[hzArg]) hegel.Generator[[]hzArg] {
+	choices := []hzChoice[[]hzArg]{hzW(len(optionals), required)}
+	for i := range optionals {
+		choices = append(choices, hzW(1, hzSeq(required, hzTuple(optionals[:i+1]...))))
+	}
+	return hzWeighted(choices...)
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// mathSpec: a function and the generator of its argument lists (and of its round trip's
+// arguments, if it has one).
+type mathSpec struct {
+	name string
+	args hegel.Generator[[]hzArg]
+	trip hegel.Generator[[]float64]
+}
+
+// mathCase: one formula, NAME(args), with the round trip's arguments (n and form for ROMAN,
+// n and radix for BASE).
+type mathCase struct {
+	name string
+	args []hzArg
+	trip []float64
+}
+
+func (c mathCase) GoString() string {
+	formula, cells := hzFormula(c.name, c.args)
+	s := hzDesc(formula, cells)
+	if t := c.tripFormula(); t != "" {
+		s += "; " + t
+	}
+	return s
+}
+
+// tripFormula is the round trip's formula, "" for none.
+func (c mathCase) tripFormula() string {
+	switch {
+	case c.name == "ROMAN" && len(c.trip) == 2:
+		return fmt.Sprintf("ARABIC(ROMAN(%s,%s))", hzNumLit(c.trip[0]), hzNumLit(c.trip[1]))
+	case c.name == "BASE" && len(c.trip) == 2:
+		return fmt.Sprintf("DECIMAL(BASE(%s,%s),%s)", hzNumLit(c.trip[0]), hzNumLit(c.trip[1]), hzNumLit(c.trip[1]))
+	}
+	return ""
+}
+
+func casesOf(name string, args hegel.Generator[[]hzArg]) hegel.Generator[mathCase] {
+	return hegel.Map(args, func(a []hzArg) mathCase { return mathCase{name: name, args: a} })
+}
+
+// mathSpecs: the 70 functions. SEC is first: the library returns the cosine, so SEC fails on
+// every angle but 0 and is where the shrinker lands (the first table entry, the smallest
+// nonzero angle); the rest follow the old spec's order.
+var mathSpecs = []mathSpec{
+	{name: "SEC", args: hzTuple(num(secAngles))},
+	{name: "ABS", args: hzTuple(num(numbers))},
+	{name: "ACOS", args: hzTuple(num(units))},
+	{name: "ACOSH", args: hzTuple(num(numbers))},
+	{name: "ACOT", args: hzTuple(num(numbers))},
+	{name: "ACOTH", args: only("ACOTH", hzTuple(num(numbers)))},
+	{name: "ASIN", args: hzTuple(num(units))},
+	{name: "ASINH", args: hzTuple(num(numbers))},
+	{name: "ATAN", args: hzTuple(num(numbers))},
+	{name: "ATANH", args: only("ATANH", hzTuple(num(units)))},
+	{name: "ATAN2", args: only("ATAN2", hzTuple(num(numbers), num(numbers)))},
+	{name: "BASE", args: optional(hzTuple(num(nats53), num(radixes)), num(minLengths)), trip: hzTuple(validNats53, floats(hzInts(2, 36)))},
+	{name: "CEILING", args: only("CEILING", hzTuple(num(numbers), num(sigsOrZero)))},
+	{name: "CEILING.MATH", args: only("CEILING.MATH", optional(hzTuple(num(numbers)), num(sigsOrZero), num(modes)))},
+	{name: "CEILING.PRECISE", args: only("CEILING.PRECISE", optional(hzTuple(num(numbers)), num(significances)))},
+	{name: "ISO.CEILING", args: only("ISO.CEILING", optional(hzTuple(num(numbers)), num(significances)))},
+	{name: "COMBIN", args: only("COMBIN", countPairs)},
+	{name: "COMBINA", args: only("COMBINA", combinaPairs)},
+	{name: "PERMUT", args: only("PERMUT", countPairs)},
+	{name: "PERMUTATIONA", args: hzTuple(num(counts), num(counts))},
+	{name: "MULTINOMIAL", args: only("MULTINOMIAL", some(num(counts)))},
+	{name: "COS", args: hzTuple(num(angles))},
+	{name: "COSH", args: only("COSH", hzTuple(num(numbers)))},
+	{name: "COT", args: hzTuple(num(angles))},
+	{name: "COTH", args: only("COTH", hzTuple(num(numbers)))},
+	{name: "CSC", args: hzTuple(num(angles))},
+	{name: "CSCH", args: hzTuple(num(numbers))},
+	{name: "SECH", args: hzTuple(num(numbers))},
+	{name: "SIN", args: hzTuple(num(angles))},
+	{name: "SINH", args: only("SINH", hzTuple(num(numbers)))},
+	{name: "TAN", args: hzTuple(num(angles))},
+	{name: "TANH", args: hzTuple(num(numbers))},
+	{name: "DECIMAL", args: decimalArgs},
+	{name: "DEGREES", args: only("DEGREES", hzTuple(num(numbers)))},
+	{name: "RADIANS", args: hzTuple(num(numbers))},
+	{name: "EVEN", args: hzTuple(num(numbers))},
+	{name: "ODD", args: only("ODD", hzTuple(num(numbers)))},
+	{name: "EXP", args: only("EXP", hzTuple(num(numbers)))},
+	{name: "FACT", args: hzTuple(num(factCounts))},
+	{name: "FACTDOUBLE", args: hzTuple(num(nats200))},
+	{name: "FLOOR", args: only("FLOOR", hzTuple(num(numbers), num(sigsOrZero)))},
+	{name: "FLOOR.MATH", args: only("FLOOR.MATH", optional(hzTuple(num(numbers)), num(sigsOrZero), num(modes)))},
+	{name: "FLOOR.PRECISE", args: only("FLOOR.PRECISE", optional(hzTuple(num(numbers)), num(significances)))},
