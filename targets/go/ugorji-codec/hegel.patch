+package codec_test
+
+// Independent models of the msgpack and CBOR wire formats (encoders that
+// produce the bytes a minimal encoder must produce, "loose" encoders that
+// exercise every header form the specs allow, and decoders), plus the value
+// trees the properties feed to the library and the canonical comparison of
+// decoded trees.
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Trees: nil, bool, int64, uint64, float64, string, []byte, []any,
+// map[string]any (and time.Time where a property asks for it). The
+// generators are values; a tree of a given shape comes from trees(opts).
+
+// scaledInts: a magnitude of up to 30 bits shifted by up to 32 bits plus a
+// small low part, negated half of the time - an integer of any width.
+var scaledInts = hegel.Composite(func(tc hegel.TestCase) int64 {
+	base := hegel.Draw(tc, hegel.Integers(0, 1<<30))
+	shift := hegel.Draw(tc, hegel.Integers(0, 32))
+	low := hegel.Draw(tc, hegel.Integers(0, 1000))
+	v := int64(base)<<uint(shift) | int64(low)
+	if hegel.Draw(tc, chance(50)) {
+		v = -v
+	}
+	return v
+})
+
+// scaledUints: the unsigned counterpart, shifted by up to 34 bits.
+var scaledUints = hegel.Composite(func(tc hegel.TestCase) uint64 {
+	base := hegel.Draw(tc, hegel.Integers(0, 1<<30))
+	shift := hegel.Draw(tc, hegel.Integers(0, 34))
+	low := hegel.Draw(tc, hegel.Integers(0, 1000))
+	return uint64(base)<<uint(shift) | uint64(low)
+})
+
+// ints: an int64 around the fixint edges once in ten, at a width edge of
+// the formats twice, within a million twice, else of any width.
+var ints = weighted(
+	choice[int64]{1, hegel.Integers[int64](-40, 140)},
+	choice[int64]{1, hegel.SampledFrom([]int64{-128, -129, 127, 128, 255, 256, -32768, -32769, 32767, 32768, 65535, 65536, -1, 0, 23, 24, 25})},
+	choice[int64]{1, hegel.SampledFrom([]int64{math.MinInt64, math.MaxInt64, math.MinInt32, math.MaxInt32, 1 << 32, -1 << 32, 1 << 53, 1<<53 + 1, -1 << 53, -1<<53 - 1, math.MaxUint32, math.MaxUint32 + 1})},
+	choice[int64]{2, hegel.Integers[int64](-1000000, 1000000)},
+	choice[int64]{5, scaledInts},
+)
+
+// uints: a uint64 below 300 once in six, at a width edge once, within a
+// million once, else of any width.
+var uints = weighted(
+	choice[uint64]{1, hegel.Integers[uint64](0, 300)},
+	choice[uint64]{1, hegel.SampledFrom([]uint64{0, 23, 24, 127, 128, 255, 256, 65535, 65536, math.MaxUint32, math.MaxUint32 + 1, 1<<63 - 1, 1 << 63, math.MaxUint64, 1 << 53, 1<<53 + 1})},
+	choice[uint64]{1, hegel.Integers[uint64](0, 1000000)},
+	choice[uint64]{3, scaledUints},
+)
+
+var (
+	floatEdges = hegel.SampledFrom([]float64{1.5, 0.1, 65504.0, 65520.0, 5.960464477539063e-08, 6.103515625e-05, 1e21, 1e-7, 123456789.0, math.MaxFloat64, math.SmallestNonzeroFloat64, 1e300, 3.4028234663852886e38, 1.17549435e-38, 2.0, 100.0})
+	// integralFloats; eighths (exact in the float16 range mostly); f32Floats
+	// (float32-exact); scaledFloats (nine digits at any decade).
+	integralFloats = hegel.Map(hegel.Integers(-1000, 1000), func(x int) float64 { return float64(x) })
+	eighths        = hegel.Map(hegel.Integers(-100000, 100000), func(x int) float64 { return float64(x) / 8 })
+	f32Floats      = hegel.Map(hegel.Integers(-1000000, 1000000), func(x int) float64 { return float64(float32(float64(x) * 1e-3)) })
+	scaledFloats   = hegel.Map(pairs(hegel.Integers(-1000000000, 1000000000), hegel.Integers(-30, 30)), func(p pair[int, int]) float64 {
+		return float64(p.a) * 1e-9 * math.Pow(10, float64(p.b))
+	})
+)
+
+// floats: a float64; the first alternative is the zeroes and units, or the
+// specials (-0, NaN, the infinities) when allowed.
+func floats(specials bool) hegel.Generator[float64] {
+	first := hegel.SampledFrom([]float64{0.0, math.Copysign(0, -1), 1.0, -1.0})
+	if specials {
+		first = hegel.SampledFrom([]float64{math.Copysign(0, -1), math.NaN(), math.Inf(1), math.Inf(-1)})
+	}
+	return weighted(
+		choice[float64]{1, first},
+		choice[float64]{1, floatEdges},
+		choice[float64]{1, integralFloats},
+		choice[float64]{1, eighths},
+		choice[float64]{1, f32Floats},
+		choice[float64]{5, scaledFloats},
+	)
+}
+
+var plainFloats, specialFloats = floats(false), floats(true)
+
+var wordRunes = []rune("abcxyzABZ0189 _-.,:;!?/\\\"'<>&\u00e9\u00fc\u00df\u4e2d\u6587\u2028\u2029\U0001F600\U0001F4A9\u00ff\uffff\ufeff\U0010FFFF\x00\x01\x1f\x7f\b\f\n\r\t")
+
+// lengthEdges are the string and byte lengths at the formats' width edges.
+var lengthEdges = hegel.SampledFrom([]int{0, 31, 32, 255, 256, 65535, 65536})
+
+// strs: a string of up to maxLen bytes: up to 24 runes of the word pool
+// nine times in ten, else a string at a length edge (of two-byte runes
+// three times in ten, so the byte length is the edge), capped at maxLen.
+func strs(maxLen int) hegel.Generator[string] {
+	edge := hegel.Map(pairs(lengthEdges, chance(30)), func(p pair[int, bool]) string {
+		l := minInt(p.a, maxLen)
+		if p.b && l%2 == 0 {
+			return strings.Repeat("\u00e9", l/2)
+		}
+		return strings.Repeat("a", l)
+	})
+	return weighted(
+		choice[string]{90, hegel.Text().Alphabet(string(wordRunes)).MaxSize(minInt(maxLen, 24))},
+		choice[string]{10, edge},
+	)
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+// byteStrings: up to 12 bytes nine times in ten, else a length edge filled
+// with a fixed pattern.
+var byteStrings = weighted(
+	choice[[]byte]{90, hegel.Binary(0, 12)},
+	choice[[]byte]{10, hegel.Map(lengthEdges, func(l int) []byte {
+		out := make([]byte, l)
+		for i := range out {
+			out[i] = byte(i * 7)
+		}
+		return out
+	})},
+)
+
+// nonNilSlice and nonNilMap make an empty collection a non-nil one (Lists
+// and Maps yield nil for zero elements; the formats write nil as null).
+func nonNilSlice[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+const zeroTimeSec = -62135596800 // time.Time{}.Unix()
+
+var (
+	secs = weighted(
+		choice[int64]{80, hegel.Integers[int64](-1000000000, 2000000000)},
+		choice[int64]{20, hegel.SampledFrom([]int64{0, -1, 1<<31 - 1, 1 << 31, 1<<32 - 1, 1 << 32, 1<<34 - 1, 1 << 34, -1 << 31, 253402300799, zeroTimeSec})},
+	)
+	nsecs = hegel.Integers[int64](1, 999999999)
+	// times: a second count, with nanoseconds half of the time (always at
+	// the zero time's second: the library writes the zero time.Time as nil).
+	times = hegel.FlatMap(secs, func(sec int64) hegel.Generator[time.Time] {
+		ns := maybe(50, nsecs)
+		if sec == zeroTimeSec {
+			ns = nsecs
+		}
+		return hegel.Map(ns, func(n int64) time.Time { return time.Unix(sec, n).UTC() })
+	})
+)
+
+// treeOpts says which leaves a tree may hold.
+type treeOpts struct {
+	specials bool // NaN/Inf floats
+	times    bool // time.Time leaves
+	bytes    bool // []byte leaves
+	maxDepth int
+}
+
+var (
+	treesMu    sync.Mutex
+	treesCache = map[treeOpts]hegel.Generator[any]{}
+)
+
+// trees: a value tree of at most o.maxDepth levels of containers, one
+// generator per shape. A node is one of eight leaf kinds (nil, bool, int64,
+// uint64, float64, string, []byte or another string, time.Time or another
+// int64) or, above the depth bound and as often as any one leaf kind, a
+// list of up to five nodes or a string-keyed map of up to four (fifteen to
+// seventeen once in twenty, past the fixarray and fixmap widths).
+func trees(o treeOpts) hegel.Generator[any] {
+	treesMu.Lock()
+	defer treesMu.Unlock()
+	if g, ok := treesCache[o]; ok {
+		return g
+	}
+	bytesLeaf, timeLeaf := asAny(strs(300)), asAny(ints)
+	if o.bytes {
+		bytesLeaf = asAny(byteStrings)
+	}
+	if o.times {
+		timeLeaf = asAny(times)
+	}
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{1, asAny(ints)},
+		choice[any]{1, asAny(uints)},
+		choice[any]{1, asAny(floats(o.specials))},
+		choice[any]{1, asAny(strs(300))},
+		choice[any]{1, bytesLeaf},
+		choice[any]{1, timeLeaf},
+	)
+	// node is the recursive knot: the containers draw it through child, and
+	// a depth counter (restored by defer, so an aborted draw cannot leave it
+	// stale) keeps them to o.maxDepth levels.
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	keys := strs(12)
+	lists := hegel.Map(weighted(
+		choice[[]any]{95, many(child, 0, 5)},
+		choice[[]any]{5, many(child, 15, 17)},
+	), nonNilSlice[any])
+	maps := hegel.Map(weighted(
+		choice[map[string]any]{95, hegel.Maps(keys, child).MaxSize(4)},
+		choice[map[string]any]{5, hegel.Maps(keys, child).MinSize(15).MaxSize(17)},
+	), nonNilMap[string, any])
+	branch := weighted(
+		choice[any]{8, leaf},
+		choice[any]{1, asAny(lists)},
+		choice[any]{1, asAny(maps)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= o.maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	treesCache[o] = node
+	return node
+}
+
+// ---------------------------------------------------------------------------
+// Canonical comparison.
+
+// canon normalises a decoded tree: non-negative int64 become uint64, float32
+// become float64, []byte-keyed or interface-keyed maps become string-keyed
+// maps, and when bytesAsString is set []byte become strings (msgpack without
+// WriteExt has one raw type for both).
+func canon(v any, bytesAsString bool) any {
+	switch x := v.(type) {
+	case int64:
+		if x >= 0 {
+			return uint64(x)
+		}
+		return x
+	case int:
+		return canon(int64(x), bytesAsString)
+	case int8:
+		return canon(int64(x), bytesAsString)
+	case int16:
+		return canon(int64(x), bytesAsString)
+	case int32:
+		return canon(int64(x), bytesAsString)
+	case uint:
+		return uint64(x)
+	case uint8:
+		return uint64(x)
+	case uint16:
+		return uint64(x)
+	case uint32:
+		return uint64(x)
+	case float32:
+		return float64(x)
+	case []byte:
+		if bytesAsString {
+			return string(x)
+		}
+		return x
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = canon(x[i], bytesAsString)
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = canon(e, bytesAsString)
+		}
+		return out
+	case map[any]any:
+		out := map[string]any{}
+		for k, e := range x {
+			switch kk := k.(type) {
+			case string:
+				out[kk] = canon(e, bytesAsString)
+			case []byte:
+				out[string(kk)] = canon(e, bytesAsString)
+			default:
+				out[fmt.Sprintf("%v", kk)] = canon(e, bytesAsString)
+			}
+		}
+		return out
+	}
+	return v
+}
+
+// eqNum compares two numbers exactly across int64/uint64/float64 (NaN equals
+// NaN; -0 equals +0 only when both are floats and both zero).
+func eqNum(a, b any) bool {
+	// a float64 against an integer beyond 2^53: the integer text of such a
+	// float ("6400000000000001000") reads back as an integer that is not the
+	// float's exact value but converts to the same float64
+	if f, ok := a.(float64); ok && isBigInt(b) {
+		return f == intToFloat(b)
+	}
+	if f, ok := b.(float64); ok && isBigInt(a) {
+		return f == intToFloat(a)
+	}
+	af, aok := toBig(a)
+	bf, bok := toBig(b)
+	if !aok || !bok {
+		return false
+	}
+	if af == nil || bf == nil { // NaN
+		return af == nil && bf == nil
+	}
+	return af.Cmp(bf) == 0
+}
+
+func isBigInt(v any) bool {
+	switch x := v.(type) {
+	case int64:
+		return x >= 1<<53 || x <= -(1<<53)
+	case uint64:
+		return x >= 1<<53
+	}
+	return false
+}
+
+func intToFloat(v any) float64 {
+	switch x := v.(type) {
+	case int64:
+		return float64(x)
+	case uint64:
+		return float64(x)
+	}
+	return math.NaN()
+}
+
+func toBig(v any) (*big.Float, bool) {
+	switch x := v.(type) {
+	case int64:
+		return new(big.Float).SetInt64(x), true
+	case uint64:
+		return new(big.Float).SetUint64(x), true
+	case float64:
+		if math.IsNaN(x) {
+			return nil, true
+		}
+		if math.IsInf(x, 0) {
+			return new(big.Float).SetInf(x < 0), true
+		}
+		return new(big.Float).SetFloat64(x), true
+	}
+	return nil, false
+}
+
+func isNum(v any) bool {
+	switch v.(type) {
+	case int64, uint64, float64:
+		return true
+	}
+	return false
+}
+
+// eqTree compares two canonical trees; numbers by value, times by Equal.
+func eqTree(a, b any) bool {
+	if isNum(a) && isNum(b) {
+		return eqNum(a, b)
+	}
+	switch x := a.(type) {
+	case nil:
+		return b == nil
+	case bool:
+		y, ok := b.(bool)
+		return ok && x == y
+	case string:
+		y, ok := b.(string)
+		return ok && x == y
+	case []byte:
+		y, ok := b.([]byte)
+		return ok && string(x) == string(y)
+	case time.Time:
+		y, ok := b.(time.Time)
+		return ok && x.Equal(y)
+	case []any:
+		y, ok := b.([]any)
+		if !ok || len(x) != len(y) {
+			return false
+		}
+		for i := range x {
+			if !eqTree(x[i], y[i]) {
+				return false
+			}
+		}
+		return true
+	case map[string]any:
+		y, ok := b.(map[string]any)
+		if !ok || len(x) != len(y) {
+			return false
+		}
+		for k, e := range x {
+			f, ok := y[k]
+			if !ok || !eqTree(e, f) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// firstDiff names the first path at which two canonical trees differ.
+func firstDiff(a, b any, path string) string {
+	if isNum(a) && isNum(b) {
+		if !eqNum(a, b) {
+			return fmt.Sprintf("%s: %T %v vs %T %v", path, a, a, b, b)
+		}
+		return ""
+	}
+	switch x := a.(type) {
+	case []any:
+		y, ok := b.([]any)
+		if !ok || len(x) != len(y) {
+			return fmt.Sprintf("%s: %T len %d vs %T", path, a, len(x), b)
+		}
+		for i := range x {
+			if d := firstDiff(x[i], y[i], fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case map[string]any:
+		y, ok := b.(map[string]any)
+		if !ok || len(x) != len(y) {
+			return fmt.Sprintf("%s: %T len %d vs %T len %d", path, a, len(x), b, len(y))
+		}
+		for k, e := range x {
+			f, ok := y[k]
+			if !ok {
+				return fmt.Sprintf("%s: key %q missing", path, k)
+			}
+			if d := firstDiff(e, f, fmt.Sprintf("%s[%q]", path, k)); d != "" {
+				return d
+			}
+		}
+		return ""
+	}
+	if !eqTree(a, b) {
+		return fmt.Sprintf("%s: %#v vs %#v", path, a, b)
+	}
+	return ""
+}
+
+func treeString(v any) string {
+	s := fmt.Sprintf("%#v", v)
+	if len(s) > 400 {
+		s = s[:400] + "..."
+	}
+	return s
+}
+
+func hx(b []byte) string {
+	s := hex.EncodeToString(b)
+	if len(s) > 4000 {
+		s = s[:4000] + "..."
+	}
+	return s
+}
+
+func sortedKeys(m map[string]any) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// ---------------------------------------------------------------------------
+// Half floats.
+
+// f16bits returns the IEEE half-precision bits of f if f is exactly
+// representable.
+func f16bits(f float64) (uint16, bool) {
+	if math.IsNaN(f) {
+		return 0, false // a NaN payload does not survive; only encode as f64
+	}
+	if math.IsInf(f, 0) {
+		if f > 0 {
+			return 0x7c00, true
+		}
+		return 0xfc00, true
+	}
+	sign := uint16(0)
+	if math.Signbit(f) {
+		sign = 0x8000
+		f = -f
+	}
+	if f == 0 {
+		return sign, true
+	}
+	if f > 65504 {
+		return 0, false
+	}
+	// normal: 2^-14 .. 65504; subnormal below 2^-14 in steps of 2^-24
+	if f >= 0x1p-14 {
+		exp := math.Floor(math.Log2(f))
+		mant := f/math.Pow(2, exp) - 1 // in [0,1)
+		m := mant * 1024
+		if m != math.Floor(m) {
+			return 0, false
+		}
+		e := int(exp) + 15
+		if e < 1 || e > 30 {
+			return 0, false
+		}
+		return sign | uint16(e)<<10 | uint16(m), true
+	}
+	m := f / 0x1p-24
+	if m != math.Floor(m) || m > 1023 {
+		return 0, false
+	}
+	return sign | uint16(m), true
+}
+
+func f16ToF64(b uint16) float64 {
+	sign := 1.0
+	if b&0x8000 != 0 {
+		sign = -1
+	}
+	e := int(b>>10) & 0x1f
+	m := float64(b & 0x3ff)
+	switch e {
+	case 0:
+		return sign * m * 0x1p-24
+	case 31:
+		if m == 0 {
+			return math.Inf(int(sign))
+		}
+		return math.NaN()
+	}
+	return sign * (1 + m/1024) * math.Pow(2, float64(e-15))
+}
+
+func f32exact(f float64) bool {
+	return math.IsNaN(f) || float64(float32(f)) == f
+}
+
+// ---------------------------------------------------------------------------
+// msgpack model.
+
+type mpStyle struct {
+	WriteExt    bool // new spec: str8, bin family, ext (timestamps)
+	PosUnsigned bool // non-negative int64 written in the unsigned family
+	NoFixed     bool // never write a fixint
+}
+
+func be16(v uint16) []byte { b := make([]byte, 2); binary.BigEndian.PutUint16(b, v); return b }
+func be32(v uint32) []byte { b := make([]byte, 4); binary.BigEndian.PutUint32(b, v); return b }
+func be64(v uint64) []byte { b := make([]byte, 8); binary.BigEndian.PutUint64(b, v); return b }
+
+// mpEncode writes v as a minimal msgpack encoder configured like st would:
+// maps in sorted key order (Canonical), float64 as float64.
+func mpEncode(v any, st mpStyle) []byte {
+	var out []byte
+	mpEnc(&out, v, st)
+	return out
+}
+
+func mpUint(out *[]byte, u uint64, noFixed bool) {
+	switch {
+	case u <= 127 && !noFixed:
+		*out = append(*out, byte(u))
+	case u <= 0xff:
+		*out = append(*out, 0xcc, byte(u))
+	case u <= 0xffff:
+		*out = append(*out, 0xcd)
+		*out = append(*out, be16(uint16(u))...)
+	case u <= 0xffffffff:
+		*out = append(*out, 0xce)
+		*out = append(*out, be32(uint32(u))...)
+	default:
+		*out = append(*out, 0xcf)
+		*out = append(*out, be64(u)...)
+	}
+}
+
+func mpInt(out *[]byte, i int64, noFixed bool) {
+	switch {
+	case i >= -32 && i <= 127 && !noFixed:
+		*out = append(*out, byte(int8(i)))
+	case i >= math.MinInt8 && i <= math.MaxInt8:
+		*out = append(*out, 0xd0, byte(int8(i)))
+	case i >= math.MinInt16 && i <= math.MaxInt16:
+		*out = append(*out, 0xd1)
+		*out = append(*out, be16(uint16(int16(i)))...)
+	case i >= math.MinInt32 && i <= math.MaxInt32:
+		*out = append(*out, 0xd2)
+		*out = append(*out, be32(uint32(int32(i)))...)
+	default:
+		*out = append(*out, 0xd3)
+		*out = append(*out, be64(uint64(i))...)
+	}
+}
+
+func mpStrHeader(out *[]byte, l int, writeExt bool) {
+	switch {
+	case l <= 31:
+		*out = append(*out, 0xa0|byte(l))
+	case l <= 0xff && writeExt:
+		*out = append(*out, 0xd9, byte(l))
+	case l <= 0xffff:
+		*out = append(*out, 0xda)
+		*out = append(*out, be16(uint16(l))...)
+	default:
+		*out = append(*out, 0xdb)
+		*out = append(*out, be32(uint32(l))...)
+	}
+}
+
+func mpBinHeader(out *[]byte, l int) {
+	switch {
+	case l <= 0xff:
+		*out = append(*out, 0xc4, byte(l))
+	case l <= 0xffff:
+		*out = append(*out, 0xc5)
+		*out = append(*out, be16(uint16(l))...)
+	default:
+		*out = append(*out, 0xc6)
+		*out = append(*out, be32(uint32(l))...)
+	}
+}
+
+func mpEnc(out *[]byte, v any, st mpStyle) {
+	switch x := v.(type) {
+	case nil:
+		*out = append(*out, 0xc0)
+	case bool:
+		if x {
+			*out = append(*out, 0xc3)
+		} else {
+			*out = append(*out, 0xc2)
+		}
+	case int64:
+		if x >= 0 && st.PosUnsigned {
+			mpUint(out, uint64(x), st.NoFixed)
+		} else {
+			mpInt(out, x, st.NoFixed)
+		}
+	case uint64:
+		mpUint(out, x, st.NoFixed)
+	case float64:
+		*out = append(*out, 0xcb)
+		*out = append(*out, be64(math.Float64bits(x))...)
+	case float32:
+		*out = append(*out, 0xca)
+		*out = append(*out, be32(math.Float32bits(x))...)
+	case string:
+		mpStrHeader(out, len(x), st.WriteExt)
+		*out = append(*out, x...)
+	case []byte:
+		if st.WriteExt {
+			mpBinHeader(out, len(x))
+		} else {
+			mpStrHeader(out, len(x), false)
+		}
+		*out = append(*out, x...)
+	case []any:
+		switch l := len(x); {
+		case l <= 15:
+			*out = append(*out, 0x90|byte(l))
+		case l <= 0xffff:
+			*out = append(*out, 0xdc)
+			*out = append(*out, be16(uint16(l))...)
+		default:
+			*out = append(*out, 0xdd)
+			*out = append(*out, be32(uint32(l))...)
+		}
+		for _, e := range x {
+			mpEnc(out, e, st)
+		}
+	case map[string]any:
+		switch l := len(x); {
+		case l <= 15:
+			*out = append(*out, 0x80|byte(l))
+		case l <= 0xffff:
+			*out = append(*out, 0xde)
+			*out = append(*out, be16(uint16(l))...)
+		default:
+			*out = append(*out, 0xdf)
+			*out = append(*out, be32(uint32(l))...)
+		}
+		for _, k := range sortedKeys(x) {
+			mpEnc(out, k, st)
+			mpEnc(out, x[k], st)
+		}
+	case time.Time:
+		// timestamp extension, spec form (32/64/96 bits by range)
+		sec, nsec := x.Unix(), uint64(x.Nanosecond())
+		switch {
+		case sec >= 0 && sec < 1<<32 && nsec == 0:
+			*out = append(*out, 0xd6, 0xff)
+			*out = append(*out, be32(uint32(sec))...)
+		case sec >= 0 && sec < 1<<34:
+			*out = append(*out, 0xd7, 0xff)
+			*out = append(*out, be64(nsec<<34|uint64(sec))...)
+		default:
+			*out = append(*out, 0xc7, 12, 0xff)
+			*out = append(*out, be32(uint32(nsec))...)
+			*out = append(*out, be64(uint64(sec))...)
+		}
+	default:
+		panic(fmt.Sprintf("mpEnc: unsupported %T", v))
+	}
+}
+
+// mpEncodeLoose writes v with header widths and forms taken from the tape:
+// every form the spec allows for the value (a spec-conforming decoder must
+// read them all). An empty tape gives the minimal forms in sorted key order.
+func mpEncodeLoose(v any, t *tape) []byte {
+	var out []byte
+	mpEncL(t, &out, v)
+	return out
+}
+
+func mpEncL(t *tape, out *[]byte, v any) {
+	switch x := v.(type) {
+	case int64:
+		if x >= 0 {
+			mpUintL(t, out, uint64(x))
+		} else {
+			mpIntL(t, out, x)
+		}
+	case uint64:
+		if x <= math.MaxInt64 && t.coin(30) {
+			mpIntL(t, out, int64(x))
+		} else {
+			mpUintL(t, out, x)
+		}
+	case float64:
+		if f32exact(x) && !math.IsNaN(x) && t.coin(40) {
+			*out = append(*out, 0xca)
+			*out = append(*out, be32(math.Float32bits(float32(x)))...)
+			return
+		}
+		*out = append(*out, 0xcb)
+		*out = append(*out, be64(math.Float64bits(x))...)
+	case string:
+		mpStrHeaderL(t, out, len(x))
+		*out = append(*out, x...)
+	case []byte:
+		l := len(x)
+		switch w := t.next(3); { // bin 8, 16 or 32
+		case w == 0 && l <= 0xff:
+			*out = append(*out, 0xc4, byte(l))
+		case w <= 1 && l <= 0xffff:
+			*out = append(*out, 0xc5)
+			*out = append(*out, be16(uint16(l))...)
+		default:
+			*out = append(*out, 0xc6)
+			*out = append(*out, be32(uint32(l))...)
+		}
+		*out = append(*out, x...)
+	case []any:
+		l := len(x)
+		switch w := t.next(3); { // fixarray, array 16 or 32
+		case w == 0 && l <= 15:
+			*out = append(*out, 0x90|byte(l))
+		case w <= 1 && l <= 0xffff:
+			*out = append(*out, 0xdc)
+			*out = append(*out, be16(uint16(l))...)
+		default:
+			*out = append(*out, 0xdd)
+			*out = append(*out, be32(uint32(l))...)
+		}
+		for _, e := range x {
+			mpEncL(t, out, e)
+		}
+	case map[string]any:
+		l := len(x)
+		switch w := t.next(3); { // fixmap, map 16 or 32
+		case w == 0 && l <= 15:
+			*out = append(*out, 0x80|byte(l))
+		case w <= 1 && l <= 0xffff:
+			*out = append(*out, 0xde)
+			*out = append(*out, be16(uint16(l))...)
+		default:
+			*out = append(*out, 0xdf)
+			*out = append(*out, be32(uint32(l))...)
+		}
+		for _, k := range keyOrder(x, t) {
+			mpEncL(t, out, k)
+			mpEncL(t, out, x[k])
+		}
+	case time.Time:
+		sec, nsec := x.Unix(), uint64(x.Nanosecond())
+		switch form := t.next(3); { // 32, 64 or 96 bits
+		case form == 0 && sec >= 0 && sec < 1<<32 && nsec == 0:
+			*out = append(*out, 0xd6, 0xff)
+			*out = append(*out, be32(uint32(sec))...)
+		case form <= 1 && sec >= 0 && sec < 1<<34:
+			*out = append(*out, 0xd7, 0xff)
+			*out = append(*out, be64(nsec<<34|uint64(sec))...)
+		default:
+			*out = append(*out, 0xc7, 12, 0xff)
+			*out = append(*out, be32(uint32(nsec))...)
+			*out = append(*out, be64(uint64(sec))...)
+		}
+	default:
+		mpEnc(out, v, mpStyle{WriteExt: true})
+	}
+}
+
+// keyOrder is the keys of m sorted, or half of the time in the order of a
+// rank the tape gives each (any order is valid on the wire; equal ranks
+// keep the sorted order, so an empty tape writes the sorted one).
+func keyOrder(m map[string]any, t *tape) []string {
+	keys := sortedKeys(m)
+	if !t.coin(50) {
+		return keys
+	}
+	rank := make(map[string]int, len(keys))
+	for _, k := range keys {
+		rank[k] = t.next(100)
+	}
+	sort.SliceStable(keys, func(i, j int) bool { return rank[keys[i]] < rank[keys[j]] })
+	return keys
+}
+
+func mpUintL(t *tape, out *[]byte, u uint64) {
+	switch w := t.next(5); { // fixint, uint 8, 16, 32 or 64
+	case w == 0 && u <= 127:
+		*out = append(*out, byte(u))
+	case w <= 1 && u <= 0xff:
+		*out = append(*out, 0xcc, byte(u))
+	case w <= 2 && u <= 0xffff:
+		*out = append(*out, 0xcd)
+		*out = append(*out, be16(uint16(u))...)
+	case w <= 3 && u <= 0xffffffff:
+		*out = append(*out, 0xce)
+		*out = append(*out, be32(uint32(u))...)
+	default:
+		*out = append(*out, 0xcf)
+		*out = append(*out, be64(u)...)
+	}
+}
+
+func mpIntL(t *tape, out *[]byte, i int64) {
+	switch w := t.next(5); { // fixint, int 8, 16, 32 or 64
+	case w == 0 && i >= -32 && i <= 127:
+		*out = append(*out, byte(int8(i)))
+	case w <= 1 && i >= math.MinInt8 && i <= math.MaxInt8:
+		*out = append(*out, 0xd0, byte(int8(i)))
+	case w <= 2 && i >= math.MinInt16 && i <= math.MaxInt16:
+		*out = append(*out, 0xd1)
+		*out = append(*out, be16(uint16(int16(i)))...)
+	case w <= 3 && i >= math.MinInt32 && i <= math.MaxInt32:
+		*out = append(*out, 0xd2)
+		*out = append(*out, be32(uint32(int32(i)))...)
+	default:
+		*out = append(*out, 0xd3)
+		*out = append(*out, be64(uint64(i))...)
+	}
+}
+
+func mpStrHeaderL(t *tape, out *[]byte, l int) {
+	switch w := t.next(4); { // fixstr, str 8, 16 or 32
+	case w == 0 && l <= 31:
+		*out = append(*out, 0xa0|byte(l))
+	case w <= 1 && l <= 0xff:
+		*out = append(*out, 0xd9, byte(l))
+	case w <= 2 && l <= 0xffff:
+		*out = append(*out, 0xda)
+		*out = append(*out, be16(uint16(l))...)
+	default:
+		*out = append(*out, 0xdb)
+		*out = append(*out, be32(uint32(l))...)
+	}
+}
+
+var errShort = errors.New("model: input too short")
+
+// mpDecode reads one msgpack value; strings come back as string, bin as
+// []byte, non-negative integers as uint64, negative as int64, timestamps as
+// time.Time, other extensions as mpExt.
+type mpExt struct {
+	Type int8
+	Data []byte
+}
+
+func mpDecode(b []byte) (any, int, error) {
+	if len(b) == 0 {
+		return nil, 0, errShort
+	}
+	c := b[0]
+	need := func(k int) error {
+		if len(b) < 1+k {
+			return errShort
+		}
+		return nil
+	}
+	rd := func(off, l int) ([]byte, error) {
+		if len(b) < off+l {
+			return nil, errShort
+		}
+		return b[off : off+l], nil
+	}
+	switch {
+	case c <= 0x7f:
+		return uint64(c), 1, nil
+	case c >= 0xe0:
+		return int64(int8(c)), 1, nil
+	case c >= 0xa0 && c <= 0xbf:
+		s, err := rd(1, int(c&0x1f))
+		return string(s), 1 + len(s), err
+	case c >= 0x90 && c <= 0x9f:
+		return mpArray(b, 1, int(c&0x0f))
+	case c >= 0x80 && c <= 0x8f:
+		return mpMap(b, 1, int(c&0x0f))
+	}
+	switch c {
+	case 0xc0:
+		return nil, 1, nil
+	case 0xc2:
+		return false, 1, nil
+	case 0xc3:
+		return true, 1, nil
+	case 0xcc:
+		if err := need(1); err != nil {
+			return nil, 0, err
+		}
+		return uint64(b[1]), 2, nil
+	case 0xcd:
+		if err := need(2); err != nil {
+			return nil, 0, err
+		}
+		return uint64(binary.BigEndian.Uint16(b[1:])), 3, nil
+	case 0xce:
+		if err := need(4); err != nil {
+			return nil, 0, err
+		}
+		return uint64(binary.BigEndian.Uint32(b[1:])), 5, nil
+	case 0xcf:
+		if err := need(8); err != nil {
+			return nil, 0, err
+		}
+		return binary.BigEndian.Uint64(b[1:]), 9, nil
+	case 0xd0:
+		if err := need(1); err != nil {
+			return nil, 0, err
+		}
+		return canon(int64(int8(b[1])), false), 2, nil
+	case 0xd1:
+		if err := need(2); err != nil {
+			return nil, 0, err
+		}
+		return canon(int64(int16(binary.BigEndian.Uint16(b[1:]))), false), 3, nil
+	case 0xd2:
+		if err := need(4); err != nil {
+			return nil, 0, err
+		}
+		return canon(int64(int32(binary.BigEndian.Uint32(b[1:]))), false), 5, nil
+	case 0xd3:
+		if err := need(8); err != nil {
+			return nil, 0, err
+		}
+		return canon(int64(binary.BigEndian.Uint64(b[1:])), false), 9, nil
+	case 0xca:
+		if err := need(4); err != nil {
+			return nil, 0, err
+		}
+		return float64(math.Float32frombits(binary.BigEndian.Uint32(b[1:]))), 5, nil
+	case 0xcb:
+		if err := need(8); err != nil {
+			return nil, 0, err
+		}
+		return math.Float64frombits(binary.BigEndian.Uint64(b[1:])), 9, nil
+	case 0xd9, 0xda, 0xdb, 0xc4, 0xc5, 0xc6:
+		var l, hl int
+		switch c {
+		case 0xd9, 0xc4:
+			if err := need(1); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(b[1]), 2
+		case 0xda, 0xc5:
+			if err := need(2); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint16(b[1:])), 3
+		default:
+			if err := need(4); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint32(b[1:])), 5
+		}
+		s, err := rd(hl, l)
+		if err != nil {
+			return nil, 0, err
+		}
+		if c >= 0xd9 {
+			return string(s), hl + l, nil
+		}
+		return append([]byte{}, s...), hl + l, nil
+	case 0xdc, 0xdd, 0xde, 0xdf:
+		var l, hl int
+		if c == 0xdc || c == 0xde {
+			if err := need(2); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint16(b[1:])), 3
+		} else {
+			if err := need(4); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint32(b[1:])), 5
+		}
+		if c <= 0xdd {
+			return mpArray(b, hl, l)
+		}
+		return mpMap(b, hl, l)
+	case 0xd4, 0xd5, 0xd6, 0xd7, 0xd8, 0xc7, 0xc8, 0xc9:
+		var l, hl int
+		switch c {
+		case 0xd4:
+			l, hl = 1, 2
+		case 0xd5:
+			l, hl = 2, 2
+		case 0xd6:
+			l, hl = 4, 2
+		case 0xd7:
+			l, hl = 8, 2
+		case 0xd8:
+			l, hl = 16, 2
+		case 0xc7:
+			if err := need(2); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(b[1]), 3
+		case 0xc8:
+			if err := need(3); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint16(b[1:])), 4
+		default:
+			if err := need(5); err != nil {
+				return nil, 0, err
+			}
+			l, hl = int(binary.BigEndian.Uint32(b[1:])), 6
+		}
+		if len(b) < hl+l {
+			return nil, 0, errShort
+		}
+		typ := int8(b[hl-1])
+		data := b[hl : hl+l]
+		if typ == -1 {
+			switch l {
+			case 4:
+				return time.Unix(int64(binary.BigEndian.Uint32(data)), 0).UTC(), hl + l, nil
+			case 8:
+				u := binary.BigEndian.Uint64(data)
+				return time.Unix(int64(u&(1<<34-1)), int64(u>>34)).UTC(), hl + l, nil
+			case 12:
+				return time.Unix(int64(binary.BigEndian.Uint64(data[4:])), int64(binary.BigEndian.Uint32(data))).UTC(), hl + l, nil
+			}
+		}
+		return mpExt{typ, append([]byte{}, data...)}, hl + l, nil
+	}
+	return nil, 0, fmt.Errorf("model: bad msgpack byte %#x", c)
+}
+
+func mpArray(b []byte, off, l int) (any, int, error) {
+	out := make([]any, 0, minInt(l, 1024))
+	for i := 0; i < l; i++ {
+		e, k, err := mpDecode(b[off:])
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, e)
+		off += k
+	}
+	return out, off, nil
+}
+
+func mpMap(b []byte, off, l int) (any, int, error) {
+	out := map[string]any{}
+	for i := 0; i < l; i++ {
+		k, kl, err := mpDecode(b[off:])
+		if err != nil {
+			return nil, 0, err
+		}
+		off += kl
+		v, vl, err := mpDecode(b[off:])
+		if err != nil {
+			return nil, 0, err
+		}
+		off += vl
+		switch kk := k.(type) {
+		case string:
+			out[kk] = v
+		case []byte:
+			out[string(kk)] = v
+		default:
+			out[fmt.Sprintf("%v", kk)] = v
+		}
+	}
+	return out, off, nil
+}
+
+// ---------------------------------------------------------------------------
+// CBOR model.
+
+type cbStyle struct {
+	Indef   bool // indefinite-length strings, arrays and maps
+	Optimum bool // floats in the shortest exact width
+}
+
+func cbHead(out *[]byte, major byte, n uint64) {
+	switch {
+	case n <= 23:
+		*out = append(*out, major<<5|byte(n))
+	case n <= 0xff:
+		*out = append(*out, major<<5|24, byte(n))
+	case n <= 0xffff:
+		*out = append(*out, major<<5|25)
+		*out = append(*out, be16(uint16(n))...)
+	case n <= 0xffffffff:
+		*out = append(*out, major<<5|26)
+		*out = append(*out, be32(uint32(n))...)
+	default:
+		*out = append(*out, major<<5|27)
+		*out = append(*out, be64(n)...)
+	}
+}
+
+func cbHeadL(t *tape, out *[]byte, major byte, n uint64) {
+	switch w := t.next(5); { // the argument in the head, or in 1, 2, 4 or 8 bytes
+	case w == 0 && n <= 23:
+		*out = append(*out, major<<5|byte(n))
+	case w <= 1 && n <= 0xff:
+		*out = append(*out, major<<5|24, byte(n))
+	case w <= 2 && n <= 0xffff:
+		*out = append(*out, major<<5|25)
+		*out = append(*out, be16(uint16(n))...)
+	case w <= 3 && n <= 0xffffffff:
+		*out = append(*out, major<<5|26)
+		*out = append(*out, be32(uint32(n))...)
+	default:
+		*out = append(*out, major<<5|27)
+		*out = append(*out, be64(n)...)
+	}
+}
+
+func cbFloat(out *[]byte, f float64, optimum bool) {
+	if optimum {
+		if h, ok := f16bits(f); ok {
+			*out = append(*out, 0xf9)
+			*out = append(*out, be16(h)...)
+			return
+		}
+		if f32exact(f) && !math.IsNaN(f) {
+			*out = append(*out, 0xfa)
+			*out = append(*out, be32(math.Float32bits(float32(f)))...)
+			return
+		}
+	}
+	*out = append(*out, 0xfb)
+	*out = append(*out, be64(math.Float64bits(f))...)
+}
+
+// cbEncode writes v as the library's CBOR encoder configured like st is
+// expected to: minimal integer heads, sorted map keys, indefinite-length
+// containers and one-chunk indefinite strings when Indef.
+func cbEncode(v any, st cbStyle) []byte {
+	var out []byte
+	cbEnc(&out, v, st)
+	return out
+}
+
+func cbEnc(out *[]byte, v any, st cbStyle) {
+	switch x := v.(type) {
+	case nil:
+		*out = append(*out, 0xf6)
+	case bool:
+		if x {
+			*out = append(*out, 0xf5)
+		} else {
+			*out = append(*out, 0xf4)
+		}
+	case int64:
+		if x >= 0 {
+			cbHead(out, 0, uint64(x))
+		} else {
+			cbHead(out, 1, uint64(-1-x))
+		}
+	case uint64:
+		cbHead(out, 0, x)
+	case float64:
+		cbFloat(out, x, st.Optimum)
+	case float32:
+		*out = append(*out, 0xfa)
+		*out = append(*out, be32(math.Float32bits(x))...)
+	case string:
+		if st.Indef {
+			*out = append(*out, 0x7f)
+			if len(x) > 0 { // one chunk; an empty string has none
+				cbHead(out, 3, uint64(len(x)))
+				*out = append(*out, x...)
+			}
+			*out = append(*out, 0xff)
+		} else {
+			cbHead(out, 3, uint64(len(x)))
+			*out = append(*out, x...)
+		}
+	case []byte:
+		if st.Indef {
+			*out = append(*out, 0x5f)
+			if len(x) > 0 {
+				cbHead(out, 2, uint64(len(x)))
+				*out = append(*out, x...)
+			}
+			*out = append(*out, 0xff)
+		} else {
+			cbHead(out, 2, uint64(len(x)))
+			*out = append(*out, x...)
+		}
+	case []any:
+		if st.Indef {
+			*out = append(*out, 0x9f)
+		} else {
+			cbHead(out, 4, uint64(len(x)))
+		}
+		for _, e := range x {
+			cbEnc(out, e, st)
+		}
+		if st.Indef {
+			*out = append(*out, 0xff)
+		}
+	case map[string]any:
+		if st.Indef {
+			*out = append(*out, 0xbf)
+		} else {
+			cbHead(out, 5, uint64(len(x)))
+		}
+		for _, k := range sortedKeys(x) {
+			cbEnc(out, k, st)
+			cbEnc(out, x[k], st)
+		}
+		if st.Indef {
+			*out = append(*out, 0xff)
+		}
+	default:
+		panic(fmt.Sprintf("cbEnc: unsupported %T", v))
+	}
+}
+
+// cbEncodeLoose writes v with every head form the spec allows, taken from
+// the tape: widened integer heads, chunked indefinite strings, indefinite
+// containers, floats in any exact width, times as tag 1 with an integer or
+// a float. An empty tape gives the shortest definite forms.
+func cbEncodeLoose(v any, t *tape) []byte {
+	var out []byte
+	cbEncL(t, &out, v)
+	return out
+}
+
+func cbEncL(t *tape, out *[]byte, v any) {
+	switch x := v.(type) {
+	case int64:
+		if x >= 0 {
+			cbHeadL(t, out, 0, uint64(x))
+		} else {
+			cbHeadL(t, out, 1, uint64(-1-x))
+		}
+	case uint64:
+		cbHeadL(t, out, 0, x)
+	case float64:
+		switch t.next(3) { // the narrowest exact width from 16, 32 or 64 bits
+		case 0:
+			if h, ok := f16bits(x); ok {
+				*out = append(*out, 0xf9)
+				*out = append(*out, be16(h)...)
+				return
+			}
+			fallthrough
+		case 1:
+			if f32exact(x) && !math.IsNaN(x) {
+				*out = append(*out, 0xfa)
+				*out = append(*out, be32(math.Float32bits(float32(x)))...)
+				return
+			}
+			fallthrough
+		default:
+			*out = append(*out, 0xfb)
+			*out = append(*out, be64(math.Float64bits(x))...)
+		}
+	case string:
+		cbStringL(t, out, 3, []byte(x))
+	case []byte:
+		cbStringL(t, out, 2, x)
+	case []any:
+		indef := t.coin(30)
+		if indef {
+			*out = append(*out, 0x9f)
+		} else {
+			cbHeadL(t, out, 4, uint64(len(x)))
+		}
+		for _, e := range x {
+			cbEncL(t, out, e)
+		}
+		if indef {
+			*out = append(*out, 0xff)
+		}
+	case map[string]any:
+		indef := t.coin(30)
+		if indef {
+			*out = append(*out, 0xbf)
+		} else {
+			cbHeadL(t, out, 5, uint64(len(x)))
+		}
+		for _, k := range keyOrder(x, t) {
+			cbEncL(t, out, k)
+			cbEncL(t, out, x[k])
+		}
+		if indef {
+			*out = append(*out, 0xff)
+		}
+	case time.Time:
+		*out = append(*out, 0xc1)
+		if x.Nanosecond() == 0 && !t.coin(30) { // an integer epoch, else a float
+			cbEncL(t, out, x.Unix())
+		} else {
+			f := float64(x.Unix()) + float64(x.Nanosecond())/1e9
+			*out = append(*out, 0xfb)
+			*out = append(*out, be64(math.Float64bits(f))...)
+		}
+	default:
+		cbEnc(out, v, cbStyle{})
+	}
+}
+
+func cbStringL(t *tape, out *[]byte, major byte, s []byte) {
+	if t.coin(25) {
+		// indefinite, in chunks cut where the tape says (text chunks must
+		// be valid UTF-8 each)
+		*out = append(*out, major<<5|31)
+		rest := s
+		for len(rest) > 0 {
+			k := 1 + t.next(len(rest))
+			if major == 3 {
+				for k < len(rest) && !utf8.RuneStart(rest[k]) {
+					k++
+				}
+			}
+			cbHeadL(t, out, major, uint64(k))
+			*out = append(*out, rest[:k]...)
+			rest = rest[k:]
+		}
+		*out = append(*out, 0xff)
+		return
+	}
+	cbHeadL(t, out, major, uint64(len(s)))
+	*out = append(*out, s...)
+}
+
+// cbDecode reads one CBOR item: text as string, bytes as []byte, major 0 as
+// uint64, major 1 as int64 (error when below int64), tag 1 as time.Time,
+// other tags as cbTag, simple values as cbSimple.
+type cbTag struct {
+	Tag   uint64
+	Value any
+}
+
+type cbSimple uint8
+
+func cbDecode(b []byte) (any, int, error) {
+	if len(b) == 0 {
+		return nil, 0, errShort
+	}
+	major, ai := b[0]>>5, b[0]&0x1f
+	off := 1
+	var arg uint64
+	switch {
+	case ai <= 23:
+		arg = uint64(ai)
+	case ai == 24:
+		if len(b) < 2 {
+			return nil, 0, errShort
+		}
+		arg, off = uint64(b[1]), 2
+	case ai == 25:
+		if len(b) < 3 {
+			return nil, 0, errShort
+		}
+		arg, off = uint64(binary.BigEndian.Uint16(b[1:])), 3
+	case ai == 26:
+		if len(b) < 5 {
+			return nil, 0, errShort
+		}
+		arg, off = uint64(binary.BigEndian.Uint32(b[1:])), 5
+	case ai == 27:
+		if len(b) < 9 {
+			return nil, 0, errShort
+		}
+		arg, off = binary.BigEndian.Uint64(b[1:]), 9
+	case ai == 31:
+		// indefinite
+	default:
+		return nil, 0, fmt.Errorf("model: reserved additional info %d", ai)
+	}
+	switch major {
+	case 0:
+		return arg, off, nil
+	case 1:
+		if arg > math.MaxInt64 {
+			return nil, 0, fmt.Errorf("model: negative integer below int64: -1-%d", arg)
+		}
+		return int64(-1 - int64(arg)), off, nil
+	case 2, 3:
+		var data []byte
+		if ai == 31 {
+			for {
+				if off >= len(b) {
+					return nil, 0, errShort
+				}
+				if b[off] == 0xff {
+					off++
+					break
+				}
+				if b[off]>>5 != major || b[off]&0x1f == 31 {
+					return nil, 0, errors.New("model: bad chunk in indefinite string")
+				}
+				chunk, k, err := cbDecode(b[off:])
+				if err != nil {
+					return nil, 0, err
+				}
+				off += k
+				switch c := chunk.(type) {
+				case string:
+					data = append(data, c...)
+				case []byte:
+					data = append(data, c...)
+				}
+			}
+		} else {
+			if uint64(len(b)-off) < arg {
+				return nil, 0, errShort
+			}
+			data = append([]byte{}, b[off:off+int(arg)]...)
+			off += int(arg)
+		}
+		if major == 3 {
+			return string(data), off, nil
+		}
+		return data, off, nil
+	case 4:
+		out := []any{}
+		for i := uint64(0); ai == 31 || i < arg; i++ {
+			if ai == 31 {
+				if off >= len(b) {
+					return nil, 0, errShort
+				}
+				if b[off] == 0xff {
+					off++
+					break
+				}
+			}
+			e, k, err := cbDecode(b[off:])
+			if err != nil {
+				return nil, 0, err
+			}
+			out = append(out, e)
+			off += k
+		}
+		return out, off, nil
+	case 5:
+		out := map[string]any{}
+		for i := uint64(0); ai == 31 || i < arg; i++ {
+			if ai == 31 {
+				if off >= len(b) {
+					return nil, 0, errShort
+				}
+				if b[off] == 0xff {
+					off++
+					break
+				}
+			}
+			k, kl, err := cbDecode(b[off:])
+			if err != nil {
+				return nil, 0, err
+			}
+			off += kl
+			v, vl, err := cbDecode(b[off:])
+			if err != nil {
+				return nil, 0, err
+			}
+			off += vl
+			switch kk := k.(type) {
+			case string:
+				out[kk] = v
+			case []byte:
+				out[string(kk)] = v
+			default:
+				out[fmt.Sprintf("%v", kk)] = v
+			}
+		}
+		return out, off, nil
+	case 6:
+		inner, k, err := cbDecode(b[off:])
+		if err != nil {
+			return nil, 0, err
+		}
+		off += k
+		if arg == 1 {
+			switch x := inner.(type) {
+			case uint64:
+				return time.Unix(int64(x), 0).UTC(), off, nil
+			case int64:
+				return time.Unix(x, 0).UTC(), off, nil
+			case float64:
+				sec := math.Floor(x)
+				return time.Unix(int64(sec), int64(math.Round((x-sec)*1e9))).UTC(), off, nil
+			}
+		}
+		return cbTag{arg, inner}, off, nil
+	default: // 7
+		switch {
+		case ai == 20:
+			return false, off, nil
+		case ai == 21:
+			return true, off, nil
+		case ai == 22:
+			return nil, off, nil
+		case ai == 23:
+			return cbSimple(23), off, nil // undefined
+		case ai < 20:
+			return cbSimple(ai), off, nil
+		case ai == 24:
+			return cbSimple(arg), off, nil
+		case ai == 25:
+			return f16ToF64(uint16(arg)), off, nil
+		case ai == 26:
+			return float64(math.Float32frombits(uint32(arg))), off, nil
+		case ai == 27:
+			return math.Float64frombits(arg), off, nil
+		case ai == 31:
+			return nil, 0, errors.New("model: unexpected break")
+		}
+		return nil, 0, fmt.Errorf("model: bad simple %d", ai)
+	}
+}
diff --git a/codec/hegel_pins_test.go b/codec/hegel_pins_test.go
new file mode 100644
index 0000000..49f5cd0
--- /dev/null
+++ b/codec/hegel_pins_test.go
@@ -0,0 +1,229 @@
+package codec_test
+
+// Pins: deterministic tests asserting the correct behaviour for each bug in
+// bugs.toml. They fail while the bug exists (listed under
+// [expected_failures] in target.toml) and pass once it is fixed.
+
+import (
+	"bytes"
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/ugorji/go/codec"
+)
+
+// ugorji-codec/1: omitempty omits a field iff it is the zero value; a
+// zero-length string is the zero value whatever its data pointer.
+func TestHegelPinOmitEmptyStringWithDataPointer(t *testing.T) {
+	type S struct {
+		A string `codec:"a,omitempty"`
+		B int    `codec:"b,omitempty"`
+	}
+	type W struct {
+		In S `codec:"in,omitempty"`
+	}
+	empty := strings.Repeat("x", 3)[:0] // "", with a non-nil data pointer
+	if empty != "" {
+		t.Fatal("internal")
+	}
+	h := &codec.JsonHandle{}
+	var b []byte
+	if err := codec.NewEncoderBytes(&b, h).Encode(S{A: empty}); err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "{}" {
+		t.Errorf("S{A: %q}: got %s, want {}", empty, b)
+	}
+	b = nil
+	if err := codec.NewEncoderBytes(&b, h).Encode(&S{A: empty}); err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "{}" {
+		t.Errorf("&S{A: %q}: got %s, want {}", empty, b)
+	}
+	b = nil
+	h2 := &codec.JsonHandle{}
+	h2.RecursiveEmptyCheck = true
+	if err := codec.NewEncoderBytes(&b, h2).Encode(W{In: S{A: empty}}); err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "{}" {
+		t.Errorf("W{In: S{A: %q}} with RecursiveEmptyCheck: got %s, want {}", empty, b)
+	}
+}
+
+// ugorji-codec/2: a CBOR negative integer below int64 (major type 1 with
+// n >= 2^63) cannot be represented and must be an error, not a wrapped value.
+func TestHegelPinCborNegativeBelowInt64IsAnError(t *testing.T) {
+	for _, in := range [][]byte{
+		{0x3b, 0x80, 0, 0, 0, 0, 0, 0, 0},                      // -1 - 2^63 = -9223372036854775809
+		{0x3b, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff}, // -2^64
+	} {
+		var out any
+		if err := codec.NewDecoderBytes(in, &codec.CborHandle{}).Decode(&out); err == nil {
+			t.Errorf("% x decoded into interface{} as %T %v, want an error", in, out, out)
+		}
+		var i int64
+		if err := codec.NewDecoderBytes(in, &codec.CborHandle{}).Decode(&i); err == nil {
+			t.Errorf("% x decoded into int64 as %d, want an error", in, i)
+		}
+	}
+}
+
+// ugorji-codec/3: a JSON integer outside the int64 range decodes into
+// interface{} the way one outside the uint64 range already does (as a
+// float64), instead of failing.
+func TestHegelPinJsonIntegerBeyondInt64DecodesIntoInterface(t *testing.T) {
+	var out any
+	err := codec.NewDecoderBytes([]byte("-9223372036854775809"), &codec.JsonHandle{}).Decode(&out)
+	if err != nil {
+		t.Errorf("-9223372036854775809: %v", err)
+	} else if f, ok := out.(float64); !ok || f != -9223372036854775809.0 {
+		t.Errorf("-9223372036854775809 decoded as %T %v", out, out)
+	}
+	h := &codec.JsonHandle{}
+	h.SignedInteger = true
+	out = nil
+	err = codec.NewDecoderBytes([]byte("18446744073709551615"), h).Decode(&out)
+	if err != nil {
+		t.Errorf("18446744073709551615 with SignedInteger: %v", err)
+	} else if out == nil {
+		t.Errorf("18446744073709551615 with SignedInteger decoded as nil")
+	}
+}
+
+// ugorji-codec/4: NilCollectionToZeroLength writes a nil []byte in the
+// format's zero-length bytes form, the same as an empty non-nil []byte.
+func TestHegelPinNilBytesAsZeroLengthBytes(t *testing.T) {
+	type C struct {
+		B []byte `codec:"b"`
+	}
+	for _, h := range []codec.Handle{&codec.JsonHandle{}, &codec.MsgpackHandle{WriteExt: true}, &codec.BincHandle{}} {
+		switch x := h.(type) {
+		case *codec.JsonHandle:
+			x.NilCollectionToZeroLength = true
+		case *codec.MsgpackHandle:
+			x.NilCollectionToZeroLength = true
+		case *codec.BincHandle:
+			x.NilCollectionToZeroLength = true
+		}
+		var nilB, emptyB []byte
+		if err := codec.NewEncoderBytes(&nilB, h).Encode(C{}); err != nil {
+			t.Fatal(err)
+		}
+		if err := codec.NewEncoderBytes(&emptyB, h).Encode(C{B: []byte{}}); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(nilB, emptyB) {
+			t.Errorf("%T: nil []byte encodes as % x, empty []byte as % x", h, nilB, emptyB)
+		}
+	}
+}
+
+// ugorji-codec/6: binc keeps the sign of a negative zero, as the other
+// binary formats do.
+func TestHegelPinBincNegativeZeroKeepsItsSign(t *testing.T) {
+	negz := 0.0
+	negz = -negz
+	h := &codec.BincHandle{}
+	var b []byte
+	if err := codec.NewEncoderBytes(&b, h).Encode(negz); err != nil {
+		t.Fatal(err)
+	}
+	var f float64
+	if err := codec.NewDecoderBytes(b, h).Decode(&f); err != nil {
+		t.Fatal(err)
+	}
+	if !math.Signbit(f) {
+		t.Errorf("-0.0 encodes as % x and decodes as %v (sign lost)", b, f)
+	}
+}
+
+// ugorji-codec/7: SignedInteger asks for int64 during schema-less decoding;
+// an unsigned value that does not fit int64 cannot become a negative one.
+func TestHegelPinSignedIntegerDoesNotWrap(t *testing.T) {
+	for _, h := range []codec.Handle{&codec.MsgpackHandle{}, &codec.CborHandle{}, &codec.BincHandle{}, &codec.SimpleHandle{}} {
+		basic(h).SignedInteger = true
+		var b []byte
+		if err := codec.NewEncoderBytes(&b, h).Encode(uint64(1 << 63)); err != nil {
+			t.Fatal(err)
+		}
+		var out any
+		err := codec.NewDecoderBytes(b, h).Decode(&out)
+		if err != nil {
+			continue // rejecting is acceptable
+		}
+		if i, ok := out.(int64); ok && i < 0 {
+			t.Errorf("%T: 2^63 (% x) decoded with SignedInteger as int64 %d", h, b, i)
+		}
+	}
+}
+
+// ugorji-codec/8: a map whose stream keys are not strings, decoded into a
+// string-keyed Go map, is either converted (as the JSON handle does with
+// {1:"x"} -> {"1":"x"}) or rejected; it is never read as a string header.
+func TestHegelPinNonStringMapKeyIntoStringMap(t *testing.T) {
+	for _, c := range []struct {
+		name string
+		h    codec.Handle
+		in   []byte
+	}{
+		{"cbor {-1:\"x\",5:\"y\"}", &codec.CborHandle{}, []byte{0xa2, 0x20, 0x61, 'x', 0x05, 0x61, 'y'}},
+		{"cbor {1:\"x\"}", &codec.CborHandle{}, []byte{0xa1, 0x01, 0x61, 'x'}},
+		{"simple {1:\"x\"}", &codec.SimpleHandle{}, []byte{0xf1, 0x01, 0x08, 0x01, 0xd9, 0x01, 'x'}},
+	} {
+		var m map[string]any
+		err := codec.NewDecoderBytes(c.in, c.h).Decode(&m)
+		if err != nil {
+			continue // rejecting is acceptable
+		}
+		for k, v := range m {
+			if _, err := strconv.ParseInt(k, 10, 64); err != nil || v == nil {
+				t.Errorf("%s into map[string]any: %#v", c.name, m)
+				break
+			}
+		}
+	}
+}
+
+// ugorji-codec/9: every int64 round-trips through binc.
+func TestHegelPinBincNegativeInt32RangeRoundTrips(t *testing.T) {
+	h := &codec.BincHandle{}
+	for _, v := range []int64{-4294967295, -4294837203, -4286578688, -4294967040, -4294901760} {
+		var b []byte
+		if err := codec.NewEncoderBytes(&b, h).Encode(v); err != nil {
+			t.Fatal(err)
+		}
+		var out int64
+		if err := codec.NewDecoderBytes(b, h).Decode(&out); err != nil {
+			t.Fatal(err)
+		}
+		if out != v {
+			t.Errorf("%d encodes as % x and decodes as %d", v, b, out)
+		}
+	}
+}
+
+// ugorji-codec/5: with TimeRFC3339 the CBOR encoder writes RFC 3339 with
+// nanoseconds; decoding must return the same instant.
+func TestHegelPinCborRFC3339TimeKeepsNanoseconds(t *testing.T) {
+	h := &codec.CborHandle{TimeRFC3339: true}
+	in := time.Unix(1700000000, 123456789).UTC()
+	var b []byte
+	if err := codec.NewEncoderBytes(&b, h).Encode(in); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(b, []byte("2023-11-14T22:13:20.123456789Z")) {
+		t.Fatalf("encoding % x does not carry the nanoseconds", b)
+	}
+	var out time.Time
+	if err := codec.NewDecoderBytes(b, h).Decode(&out); err != nil {
+		t.Fatal(err)
+	}
+	if !out.Equal(in) {
+		t.Errorf("round trip of %v gives %v", in, out)
+	}
+}
diff --git a/codec/hegel_props_test.go b/codec/hegel_props_test.go
new file mode 100644
index 0000000..25ee427
--- /dev/null
+++ b/codec/hegel_props_test.go
@@ -0,0 +1,2259 @@
+package codec_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ugorji/go/codec"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Handles.
+
+type handleKind int
+
+const (
+	hMsgpack handleKind = iota
+	hCbor
+	hJson
+	hBinc
+	hSimple
+)
+
+var handleNames = []string{"msgpack", "cbor", "json", "binc", "simple"}
+
+// formatOpts are the options of one format's handle.
+type formatOpts interface{ kind() handleKind }
+
+type (
+	msgpackOpts struct{ writeExt, posUnsigned, noFixed bool }
+	cborOpts    struct{ indef, rfc3339, skipTags bool }
+	jsonOpts    struct {
+		htmlAsIs, termWS, preferFloat bool
+		indent                        int8 // 0: none, -1: tabs
+		intAsString                   byte // 0, 'L' or 'A'
+	}
+	bincOpts   struct{ asSymbols uint8 }
+	simpleOpts struct{ zeroAsNil bool }
+)
+
+func (msgpackOpts) kind() handleKind { return hMsgpack }
+func (cborOpts) kind() handleKind    { return hCbor }
+func (jsonOpts) kind() handleKind    { return hJson }
+func (bincOpts) kind() handleKind    { return hBinc }
+func (simpleOpts) kind() handleKind  { return hSimple }
+
+// basicOpts are the options every handle has.
+type basicOpts struct {
+	canonical, optimum, structToArray, recursiveEmpty, signedInteger bool
+	rbuf, wbuf                                                       int
+}
+
+// handleSpec is a handle as drawn: its format's options and the common
+// ones. build makes the codec.Handle; untyped decoding is set up to produce
+// string-keyed maps and strings for raw bytes so that trees compare
+// canonically.
+type handleSpec struct {
+	format formatOpts
+	basic  basicOpts
+}
+
+func (s handleSpec) kind() handleKind { return s.format.kind() }
+
+func (s handleSpec) GoString() string { return handleString(s.build()) }
+
+func (s handleSpec) build() codec.Handle {
+	var bh *codec.BasicHandle
+	var h codec.Handle
+	switch f := s.format.(type) {
+	case msgpackOpts:
+		x := &codec.MsgpackHandle{WriteExt: f.writeExt, PositiveIntUnsigned: f.posUnsigned, NoFixedNum: f.noFixed}
+		x.RawToString = !f.writeExt // the old spec has one raw type for strings and bytes
+		bh, h = &x.BasicHandle, x
+	case cborOpts:
+		x := &codec.CborHandle{IndefiniteLength: f.indef, TimeRFC3339: f.rfc3339, SkipUnexpectedTags: f.skipTags}
+		bh, h = &x.BasicHandle, x
+	case jsonOpts:
+		x := &codec.JsonHandle{HTMLCharsAsIs: f.htmlAsIs, TermWhitespace: f.termWS, MapKeyAsString: true, Indent: f.indent, IntegerAsString: f.intAsString, PreferFloat: f.preferFloat}
+		bh, h = &x.BasicHandle, x
+	case bincOpts:
+		x := &codec.BincHandle{AsSymbols: f.asSymbols}
+		bh, h = &x.BasicHandle, x
+	case simpleOpts:
+		x := &codec.SimpleHandle{EncZeroValuesAsNil: f.zeroAsNil}
+		bh, h = &x.BasicHandle, x
+	}
+	bh.Canonical = s.basic.canonical
+	bh.OptimumSize = s.basic.optimum
+	bh.StructToArray = s.basic.structToArray
+	bh.RecursiveEmptyCheck = s.basic.recursiveEmpty
+	bh.MapType = reflect.TypeOf(map[string]any(nil))
+	bh.SignedInteger = s.basic.signedInteger
+	bh.ReaderBufferSize = s.basic.rbuf
+	bh.WriterBufferSize = s.basic.wbuf
+	return h
+}
+
+// asFormat is a format's options as formatOpts.
+func asFormat[T formatOpts](g hegel.Generator[T]) hegel.Generator[formatOpts] {
+	return hegel.Map(g, func(x T) formatOpts { return x })
+}
+
+var (
+	// bufferSizes: the default three times in ten, else a small or a large
+	// reader or writer buffer.
+	bufferSizes = maybe(30, hegel.SampledFrom([]int{1, 2, 7, 16, 4096}))
+	// basics: Canonical seven times in ten, the other options two or three.
+	basics = hegel.Composite(func(tc hegel.TestCase) basicOpts {
+		return basicOpts{
+			canonical:      hegel.Draw(tc, chance(70)),
+			optimum:        hegel.Draw(tc, chance(30)),
+			structToArray:  hegel.Draw(tc, chance(20)),
+			recursiveEmpty: hegel.Draw(tc, chance(30)),
+			signedInteger:  hegel.Draw(tc, chance(20)),
+			rbuf:           hegel.Draw(tc, bufferSizes),
+			wbuf:           hegel.Draw(tc, bufferSizes),
+		}
+	})
+	// formatOptions: the per-format options, by kind.
+	formatOptions = [...]hegel.Generator[formatOpts]{
+		hMsgpack: asFormat(hegel.Composite(func(tc hegel.TestCase) msgpackOpts {
+			return msgpackOpts{writeExt: hegel.Draw(tc, chance(60)), posUnsigned: hegel.Draw(tc, chance(30)), noFixed: hegel.Draw(tc, chance(20))}
+		})),
+		hCbor: asFormat(hegel.Composite(func(tc hegel.TestCase) cborOpts {
+			return cborOpts{indef: hegel.Draw(tc, chance(30)), rfc3339: hegel.Draw(tc, chance(30)), skipTags: hegel.Draw(tc, chance(30))}
+		})),
+		hJson: asFormat(hegel.Composite(func(tc hegel.TestCase) jsonOpts {
+			return jsonOpts{
+				htmlAsIs:    hegel.Draw(tc, chance(30)),
+				termWS:      hegel.Draw(tc, chance(20)),
+				indent:      hegel.Draw(tc, maybe(30, hegel.SampledFrom([]int8{1, 2, 4, -1}))),
+				intAsString: hegel.Draw(tc, maybe(30, hegel.SampledFrom([]byte{'L', 'A'}))),
+				preferFloat: hegel.Draw(tc, chance(20)),
+			}
+		})),
+		hBinc:   asFormat(hegel.Map(hegel.Integers[uint8](0, 2), func(n uint8) bincOpts { return bincOpts{n} })),
+		hSimple: asFormat(hegel.Map(chance(30), func(b bool) simpleOpts { return simpleOpts{b} })),
+	}
+	// handleSpecs: a handle of each kind with random options.
+	handleSpecs = func() (gs [hSimple + 1]hegel.Generator[handleSpec]) {
+		for k := range gs {
+			gs[k] = hegel.Map(pairs(formatOptions[k], basics), func(p pair[formatOpts, basicOpts]) handleSpec { return handleSpec{p.a, p.b} })
+		}
+		return gs
+	}()
+	// handles: a handle of any kind (msgpack first, the shrink target).
+	handles = hegel.OneOf(handleSpecs[:]...)
+)
+
+func basic(h codec.Handle) *codec.BasicHandle {
+	switch x := h.(type) {
+	case *codec.MsgpackHandle:
+		return &x.BasicHandle
+	case *codec.CborHandle:
+		return &x.BasicHandle
+	case *codec.JsonHandle:
+		return &x.BasicHandle
+	case *codec.BincHandle:
+		return &x.BasicHandle
+	case *codec.SimpleHandle:
+		return &x.BasicHandle
+	}
+	return nil
+}
+
+func handleString(h codec.Handle) string {
+	bh := basic(h)
+	s := fmt.Sprintf("%T{Canonical:%v OptimumSize:%v StructToArray:%v RecursiveEmptyCheck:%v SignedInteger:%v rbuf:%d wbuf:%d", h, bh.Canonical, bh.OptimumSize, bh.StructToArray, bh.RecursiveEmptyCheck, bh.SignedInteger, bh.ReaderBufferSize, bh.WriterBufferSize)
+	switch x := h.(type) {
+	case *codec.MsgpackHandle:
+		s += fmt.Sprintf(" WriteExt:%v PositiveIntUnsigned:%v NoFixedNum:%v", x.WriteExt, x.PositiveIntUnsigned, x.NoFixedNum)
+	case *codec.CborHandle:
+		s += fmt.Sprintf(" IndefiniteLength:%v TimeRFC3339:%v SkipUnexpectedTags:%v", x.IndefiniteLength, x.TimeRFC3339, x.SkipUnexpectedTags)
+	case *codec.JsonHandle:
+		s += fmt.Sprintf(" Indent:%d IntegerAsString:%q HTMLCharsAsIs:%v TermWhitespace:%v PreferFloat:%v", x.Indent, x.IntegerAsString, x.HTMLCharsAsIs, x.TermWhitespace, x.PreferFloat)
+	case *codec.BincHandle:
+		s += fmt.Sprintf(" AsSymbols:%d", x.AsSymbols)
+	case *codec.SimpleHandle:
+		s += fmt.Sprintf(" EncZeroValuesAsNil:%v", x.EncZeroValuesAsNil)
+	}
+	return s + "}"
+}
+
+// encodeWith encodes v with h, through a []byte or through an io.Writer.
+func encodeWith(h codec.Handle, v any, viaWriter bool) ([]byte, error) {
+	if viaWriter {
+		var buf bytes.Buffer
+		err := codec.NewEncoder(&buf, h).Encode(v)
+		return buf.Bytes(), err
+	}
+	var b []byte
+	err := codec.NewEncoderBytes(&b, h).Encode(v)
+	return b, err
+}
+
+// decodeWith decodes b with h into out, from the []byte or from an io.Reader.
+func decodeWith(h codec.Handle, b []byte, out any, viaReader bool) error {
+	if viaReader {
+		return codec.NewDecoder(bytes.NewReader(b), h).Decode(out)
+	}
+	return codec.NewDecoderBytes(b, h).Decode(out)
+}
+
+// ---------------------------------------------------------------------------
+// The typed value.
+
+type Sub struct {
+	Name  string `codec:"name"`
+	Count int32  `codec:"count,omitempty"`
+	Tags  []string
+	Skip  int `codec:"-"`
+}
+
+type Emb struct {
+	EmbA uint16
+	EmbB string `codec:"emb_b"`
+}
+
+type Big struct {
+	I8  int8
+	I16 int16
+	I32 int32
+	I64 int64
+	U8  uint8
+	U16 uint16
+	U32 uint32
+	U64 uint64
+	F32 float32
+	F64 float64
+	Bo  bool
+	S   string
+	By  []byte
+	Ss  []string
+	Is  []int64
+	Mi  map[string]int64
+	Mk  map[int64]string
+	Ar  [3]uint16
+	P   *int32
+	Ps  *Sub
+	Sub Sub
+	T   time.Time
+	An  any
+	Emb
+	OmI  int     `codec:"om_i,omitempty"`
+	OmS  string  `codec:"om_s,omitempty"`
+	OmL  []int   `codec:"om_l,omitempty"`
+	OmP  *int    `codec:"om_p,omitempty"`
+	OmB  bool    `codec:"om_b,omitempty"`
+	OmF  float64 `codec:"om_f,omitempty"`
+	Skip int     `codec:"-"`
+	priv int
+}
+
+type bigOpts struct {
+	wholeSeconds bool // time.Time without nanoseconds
+	microseconds bool // time.Time rounded to microseconds
+	bytesAsAny   bool // []byte leaves allowed in An
+	specials     bool
+}
+
+// bigOptsFor is what a handle can carry: no NaN/Inf and no []byte leaves in
+// JSON; whole seconds where the format has no nanoseconds (CBOR's tag 1 is
+// a float epoch, msgpack without WriteExt has no timestamp extension);
+// microseconds under the RFC 3339 rounding bug.
+func bigOptsFor(s handleSpec) bigOpts {
+	o := bigOpts{bytesAsAny: s.kind() != hJson, specials: s.kind() != hJson}
+	switch f := s.format.(type) {
+	case cborOpts:
+		if !f.rfc3339 {
+			o.wholeSeconds = true
+		} else if Known.cborTimeRounded {
+			o.microseconds = true
+		}
+	case msgpackOpts:
+		if !f.writeExt {
+			o.wholeSeconds = true
+		}
+	}
+	return o
+}
+
+var (
+	strs300 = strs(300)
+	strs10  = strs(10)
+	u16s    = hegel.Integers[uint16](0, 65535)
+	// subs: a Sub with tags six times in ten (empty but not nil when none).
+	subs = hegel.Composite(func(tc hegel.TestCase) Sub {
+		return Sub{
+			Name:  hegel.Draw(tc, strs10),
+			Count: int32(hegel.Draw(tc, hegel.Integers(-3, 3))),
+			Tags:  hegel.Draw(tc, maybe(60, hegel.Map(many(strs(6), 0, 3), nonNilSlice[string]))),
+			Skip:  hegel.Draw(tc, hegel.Integers(1, 9)),
+		}
+	})
+	// The collections and pointers of a Big: present seven times in ten
+	// (five for the int-keyed map and the pointers), a collection empty but
+	// not nil when present with no element.
+	someBytes   = maybe(70, byteStrings)
+	someStrings = maybe(70, hegel.Map(many(strs(20), 0, 4), nonNilSlice[string]))
+	someInts    = maybe(70, hegel.Map(many(ints, 0, 4), nonNilSlice[int64]))
+	someIntMap  = maybe(70, hegel.Map(hegel.Maps(strs(8), ints).MaxSize(4), nonNilMap[string, int64]))
+	someStrMap  = maybe(50, hegel.Map(hegel.Maps(ints, strs(8)).MaxSize(4), nonNilMap[int64, string]))
+	int32Ptrs   = optional(50, hegel.Map(ints, func(x int64) int32 { return int32(x) }))
+	subPtrs     = optional(50, subs)
+	smallPtrs   = optional(50, hegel.Integers(-5, 5))
+	oneInt      = maybe(50, hegel.Map(hegel.Integers(0, 9), func(x int) []int { return []int{x} }))
+	bigsMu      sync.Mutex
+	bigsCache   = map[bigOpts]hegel.Generator[Big]{}
+)
+
+// bigs: a Big of the shape o, one generator per shape: every scalar field
+// drawn, the collections and pointers present most of the time, an
+// interface tree two levels deep, the omitempty fields set half of the time.
+func bigs(o bigOpts) hegel.Generator[Big] {
+	bigsMu.Lock()
+	defer bigsMu.Unlock()
+	if g, ok := bigsCache[o]; ok {
+		return g
+	}
+	flt := floats(o.specials)
+	someFloat := maybe(50, plainFloats)
+	someInt := maybe(50, ints)
+	someStr := maybe(50, strs10)
+	tree := trees(treeOpts{specials: o.specials, bytes: o.bytesAsAny, maxDepth: 2})
+	g := hegel.Composite(func(tc hegel.TestCase) Big {
+		b := Big{
+			I8:   int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+			I16:  int16(hegel.Draw(tc, hegel.Integers(-32768, 32767))),
+			I32:  int32(hegel.Draw(tc, ints)),
+			I64:  hegel.Draw(tc, ints),
+			U8:   uint8(hegel.Draw(tc, hegel.Integers(0, 255))),
+			U16:  uint16(hegel.Draw(tc, uints)),
+			U32:  uint32(hegel.Draw(tc, uints)),
+			U64:  hegel.Draw(tc, uints),
+			F32:  float32(hegel.Draw(tc, flt)),
+			F64:  hegel.Draw(tc, flt),
+			Bo:   hegel.Draw(tc, hegel.Booleans()),
+			S:    hegel.Draw(tc, strs300),
+			By:   hegel.Draw(tc, someBytes),
+			Ss:   hegel.Draw(tc, someStrings),
+			Is:   hegel.Draw(tc, someInts),
+			Mi:   hegel.Draw(tc, someIntMap),
+			Mk:   hegel.Draw(tc, someStrMap),
+			Ar:   [3]uint16{hegel.Draw(tc, u16s), hegel.Draw(tc, u16s), hegel.Draw(tc, u16s)},
+			P:    hegel.Draw(tc, int32Ptrs),
+			Ps:   hegel.Draw(tc, subPtrs),
+			Sub:  hegel.Draw(tc, subs),
+			T:    hegel.Draw(tc, times),
+			An:   hegel.Draw(tc, tree),
+			Emb:  Emb{EmbA: hegel.Draw(tc, u16s), EmbB: hegel.Draw(tc, strs10)},
+			OmI:  int(hegel.Draw(tc, someInt)),
+			OmS:  hegel.Draw(tc, someStr),
+			OmL:  hegel.Draw(tc, oneInt),
+			OmP:  hegel.Draw(tc, smallPtrs),
+			OmB:  hegel.Draw(tc, hegel.Booleans()),
+			OmF:  hegel.Draw(tc, someFloat),
+			Skip: hegel.Draw(tc, hegel.Integers(1, 9)),
+			priv: hegel.Draw(tc, hegel.Integers(1, 9)),
+		}
+		if !o.specials && math.IsInf(float64(b.F32), 0) {
+			b.F32 = 1 // JSON has no infinities (the library writes null)
+		}
+		if o.wholeSeconds {
+			b.T = time.Unix(b.T.Unix(), 0).UTC()
+		}
+		if o.microseconds {
+			b.T = b.T.Round(time.Microsecond)
+		}
+		return b
+	})
+	bigsCache[o] = g
+	return g
+}
+
+// expectedAfterRoundTrip is the value a decode of an encoding of b into a
+// zero Big must produce: skipped and unexported fields zero, nil and empty
+// collections alike (compared by normalise).
+func expectedAfterRoundTrip(b Big) Big {
+	b.Skip = 0
+	b.priv = 0
+	b.Sub.Skip = 0
+	if b.Ps != nil {
+		c := *b.Ps
+		c.Skip = 0
+		b.Ps = &c
+	}
+	return b
+}
+
+// normalise makes empty collections nil and drops monotonic clocks so two
+// Bigs compare with reflect.DeepEqual; the An tree is compared separately.
+func normalise(b Big) Big {
+	if len(b.By) == 0 {
+		b.By = nil
+	}
+	if len(b.Ss) == 0 {
+		b.Ss = nil
+	}
+	if len(b.Is) == 0 {
+		b.Is = nil
+	}
+	if len(b.Mi) == 0 {
+		b.Mi = nil
+	}
+	if len(b.Mk) == 0 {
+		b.Mk = nil
+	}
+	if len(b.OmL) == 0 {
+		b.OmL = nil
+	}
+	if len(b.Sub.Tags) == 0 {
+		b.Sub.Tags = nil
+	}
+	if b.Ps != nil && len(b.Ps.Tags) == 0 {
+		c := *b.Ps
+		c.Tags = nil
+		b.Ps = &c
+	}
+	b.T = b.T.UTC()
+	b.An = nil
+	if math.IsNaN(float64(b.F32)) {
+		b.F32 = float32(math.NaN())
+	}
+	if math.IsNaN(b.F64) {
+		b.F64 = math.NaN()
+	}
+	return b
+}
+
+func bigEqual(want, got Big, bytesAsString bool) (bool, string) {
+	w, g := normalise(want), normalise(got)
+	// NaN: reflect.DeepEqual says NaN != NaN, compare bits
+	if math.Float64bits(w.F64) != math.Float64bits(g.F64) {
+		return false, fmt.Sprintf("F64 %v (%x) vs %v (%x)", w.F64, math.Float64bits(w.F64), g.F64, math.Float64bits(g.F64))
+	}
+	if math.Float32bits(w.F32) != math.Float32bits(g.F32) {
+		return false, fmt.Sprintf("F32 %v vs %v", w.F32, g.F32)
+	}
+	w.F64, g.F64, w.F32, g.F32 = 0, 0, 0, 0
+	if !w.T.Equal(g.T) {
+		return false, fmt.Sprintf("T %v vs %v", w.T, g.T)
+	}
+	w.T, g.T = time.Time{}, time.Time{}
+	if !reflect.DeepEqual(w, g) {
+		return false, diffBig(w, g)
+	}
+	if !eqTree(canon(want.An, bytesAsString), canon(got.An, bytesAsString)) {
+		return false, fmt.Sprintf("An %s vs %s", treeString(want.An), treeString(got.An))
+	}
+	return true, ""
+}
+
+func diffBig(a, b Big) string {
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	var sb strings.Builder
+	for i := 0; i < va.NumField(); i++ {
+		if !va.Type().Field(i).IsExported() {
+			continue
+		}
+		if !reflect.DeepEqual(va.Field(i).Interface(), vb.Field(i).Interface()) {
+			fmt.Fprintf(&sb, "%s: %#v vs %#v; ", va.Type().Field(i).Name, va.Field(i).Interface(), vb.Field(i).Interface())
+		}
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// 1. Typed round trip through every format under random options.
+
+// typedCase: the handle, the value, a second value the encoding is decoded
+// over, and whether to encode through an io.Writer and decode from an
+// io.Reader.
+type typedCase struct {
+	h            handleSpec
+	v, populated Big
+	viaW, viaR   bool
+}
+
+func (c typedCase) GoString() string {
+	return fmt.Sprintf("%s writer=%v reader=%v\nvalue %+v\npopulated %+v", c.h.GoString(), c.viaW, c.viaR, c.v, c.populated)
+}
+
+var typedCases = hegel.Composite(func(tc hegel.TestCase) typedCase {
+	h := hegel.Draw(tc, handles)
+	big := bigs(bigOptsFor(h)) // the value's shape follows the handle
+	return typedCase{h: h, v: hegel.Draw(tc, big), populated: hegel.Draw(tc, big), viaW: hegel.Draw(tc, chance(30)), viaR: hegel.Draw(tc, chance(30))}
+})
+
+func TestHegelTypedRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, typedCases)
+		h, k := c.h.build(), c.h.kind()
+		v := c.v
+		if k == hBinc && Known.bincNegativePrune {
+			v = bincSafeBig(v)
+		}
+		if basic(h).SignedInteger && Known.signedIntegerWraps {
+			v.An = capInts(canon(v.An, false), true) // unsigned values above int64 wrap
+		}
+		viaW, viaR := c.viaW, c.viaR
+		enc, err := encodeWith(h, v, viaW)
+		if err != nil {
+			fail(ht, "encode %s: %v\nvalue %+v", handleNames[k], err, v)
+		}
+		var got Big
+		if err := decodeWith(h, enc, &got, viaR); err != nil {
+			fail(ht, "decode %s: %v\nvalue %+v\nbytes %s", handleNames[k], err, v, hx(enc))
+		}
+		want := expectedAfterRoundTrip(v)
+		if basic(h).RecursiveEmptyCheck && want.OmP != nil && *want.OmP == 0 {
+			want.OmP = nil // omitempty descends the pointer: a pointer to zero is omitted
+		}
+		if j, ok := h.(*codec.JsonHandle); ok && j.IntegerAsString != 0 {
+			want.An = intsToStrings(want.An, j.IntegerAsString) // integers written as strings read back as strings
+		}
+		if j, ok := h.(*codec.JsonHandle); ok && j.PreferFloat {
+			want.An = intsToFloats(canon(want.An, false)) // every number reads back as a float64
+		}
+		if _, ok := h.(*codec.BincHandle); ok && Known.bincNegativeZero {
+			want.F32, want.F64, want.OmF = want.F32+0, want.F64+0, want.OmF+0 // -0 reads back as +0
+			want.An = negZeroToZero(want.An)
+		}
+		if s, ok := h.(*codec.SimpleHandle); ok && s.EncZeroValuesAsNil {
+			// zero scalars are written as nil: -0 reads back as +0, a pointer
+			// to zero as a nil pointer, zero leaves of a tree as nil
+			if want.F32 == 0 {
+				want.F32 = 0
+			}
+			if want.F64 == 0 {
+				want.F64 = 0
+			}
+			if want.OmF == 0 {
+				want.OmF = 0
+			}
+			if want.P != nil && *want.P == 0 {
+				want.P = nil
+			}
+			if want.OmP != nil && *want.OmP == 0 {
+				want.OmP = nil
+			}
+			want.An = zeroesToNil(canon(want.An, false))
+		}
+		_, mpRaw := h.(*codec.MsgpackHandle)
+		mpRaw = mpRaw && !h.(*codec.MsgpackHandle).WriteExt
+		if ok, why := bigEqual(want, got, mpRaw); !ok {
+			fail(ht, "%s round trip differs: %s\nvalue %+v\nbytes %s", handleNames[k], why, v, hx(enc))
+		}
+		// pointer receiver and repeat encode agree
+		enc2, err := encodeWith(h, &v, viaW)
+		if err != nil {
+			fail(ht, "encode pointer: %v", err)
+		}
+		if basic(h).Canonical && !bytes.Equal(enc, enc2) {
+			fail(ht, "%s canonical encodings of v and &v differ:\n%s\n%s", handleNames[k], hx(enc), hx(enc2))
+		}
+		// decoding into a populated value gives the same result for present fields
+		got2 := c.populated
+		got2.Skip, got2.priv, got2.Sub.Skip = 0, 0, 0
+		got2.Ps = nil
+		got2.Mi, got2.Mk, got2.An = nil, nil, nil // maps merge and interfaces decode into the held value by design
+		if err := decodeWith(h, enc, &got2, viaR); err != nil {
+			fail(ht, "decode into populated: %v", err)
+		}
+		// fields that are always encoded must match; omitempty fields absent
+		// from the stream keep their old values by design, so blank them
+		blankOmitted(&got2, want)
+		if ok, why := bigEqual(want, got2, mpRaw); !ok {
+			fail(ht, "%s decode into a populated value differs: %s\nvalue %+v\nbytes %s", handleNames[k], why, v, hx(enc))
+		}
+	})
+}
+
+// blankOmitted resets, in got, the omitempty fields that want left empty
+// (they are absent from the stream and so untouched by the decode) and the
+// nil-able fields whose stream value is nil (which the decoder may leave).
+func blankOmitted(got *Big, want Big) {
+	if want.OmI == 0 {
+		got.OmI = 0
+	}
+	if want.OmS == "" {
+		got.OmS = ""
+	}
+	if len(want.OmL) == 0 {
+		got.OmL = nil
+	}
+	if want.OmP == nil {
+		got.OmP = nil
+	}
+	if !want.OmB {
+		got.OmB = false
+	}
+	if want.OmF == 0 {
+		got.OmF = 0
+	}
+	if want.Sub.Count == 0 {
+		got.Sub.Count = 0
+	}
+	if want.Ps != nil && want.Ps.Count == 0 && got.Ps != nil {
+		got.Ps.Count = 0
+	}
+	if want.By == nil {
+		got.By = nil
+	}
+	if want.Ss == nil {
+		got.Ss = nil
+	}
+	if want.Is == nil {
+		got.Is = nil
+	}
+	if want.Mi == nil {
+		got.Mi = nil
+	}
+	if want.Mk == nil {
+		got.Mk = nil
+	}
+	if want.P == nil {
+		got.P = nil
+	}
+	if want.Sub.Tags == nil {
+		got.Sub.Tags = nil
+	}
+	if want.Ps != nil && want.Ps.Tags == nil && got.Ps != nil {
+		got.Ps.Tags = nil
+	}
+	if want.An == nil {
+		got.An = nil
+	}
+}
+
+// ---------------------------------------------------------------------------
+// 2. Untyped trees round-trip through every format, in one value and in a
+// stream of values, from bytes and from an io.Reader.
+
+// untypedCase: the handle, one to four trees, and the writer and reader
+// switches.
+type untypedCase struct {
+	h          handleSpec
+	trees      []any
+	viaW, viaR bool
+}
+
+func (c untypedCase) GoString() string {
+	return fmt.Sprintf("%s writer=%v reader=%v\ntrees %s", c.h.GoString(), c.viaW, c.viaR, treeString(c.trees))
+}
+
+var untypedCases = hegel.Composite(func(tc hegel.TestCase) untypedCase {
+	h := hegel.Draw(tc, handles)
+	notJson := h.kind() != hJson // JSON has no NaN/Inf and no bytes
+	return untypedCase{
+		h:     h,
+		trees: hegel.Draw(tc, many(trees(treeOpts{specials: notJson, bytes: notJson, maxDepth: 3}), 1, 4)),
+		viaW:  hegel.Draw(tc, chance(30)),
+		viaR:  hegel.Draw(tc, chance(30)),
+	}
+})
+
+func TestHegelUntypedRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, untypedCases)
+		h, k := c.h.build(), c.h.kind()
+		if j, ok := h.(*codec.JsonHandle); ok {
+			j.TermWhitespace = true // numbers in a stream need a separator
+			j.IntegerAsString = 0
+			j.PreferFloat = false
+		}
+		_, mpRaw := h.(*codec.MsgpackHandle)
+		mpRaw = mpRaw && !h.(*codec.MsgpackHandle).WriteExt
+		vals := make([]any, len(c.trees))
+		for i, tr := range c.trees {
+			if k == hJson && Known.jsonIntOverflow {
+				tr = capInts(tr, basic(h).SignedInteger) // integers written beyond int64 do not read back
+			}
+			if basic(h).SignedInteger && Known.signedIntegerWraps {
+				tr = capInts(tr, true) // unsigned values above int64 wrap to negative int64
+			}
+			if k == hBinc && Known.bincNegativePrune {
+				tr = bincSafeTree(tr)
+			}
+			vals[i] = tr
+		}
+		viaW, viaR := c.viaW, c.viaR
+		// one value at a time
+		var stream []byte
+		for _, tr := range vals {
+			enc, err := encodeWith(h, tr, viaW)
+			if err != nil {
+				fail(ht, "encode %s: %v\ntree %s", handleNames[k], err, treeString(tr))
+			}
+			var got any
+			if err := decodeWith(h, enc, &got, viaR); err != nil {
+				fail(ht, "decode %s: %v\ntree %s\nbytes %s", handleNames[k], err, treeString(tr), hx(enc))
+			}
+			want := canon(tr, mpRaw)
+			if s, ok := h.(*codec.SimpleHandle); ok && s.EncZeroValuesAsNil {
+				want = zeroesToNil(want)
+			}
+			if k == hBinc && Known.bincNegativeZero {
+				want = negZeroToZero(want)
+			}
+			if !eqTree(want, canon(got, mpRaw)) {
+				fail(ht, "%s untyped round trip differs at %s\ntree %s\ngot  %s\nbytes %s", handleNames[k], firstDiff(want, canon(got, mpRaw), "v"), treeString(tr), treeString(got), hx(enc))
+			}
+			if basic(h).SignedInteger && hasUint64(got) {
+				fail(ht, "%s SignedInteger decode produced a uint64\ntree %s\ngot %s", handleNames[k], treeString(tr), treeString(got))
+			}
+			stream = append(stream, enc...)
+		}
+		// the same values in one stream, one decoder
+		var dec *codec.Decoder
+		if viaR {
+			dec = codec.NewDecoder(bytes.NewReader(stream), h)
+		} else {
+			dec = codec.NewDecoderBytes(stream, h)
+		}
+		for i, tr := range vals {
+			var got any
+			if err := dec.Decode(&got); err != nil {
+				fail(ht, "%s stream decode #%d: %v\ntrees %s\nstream %s", handleNames[k], i, err, treeString(vals), hx(stream))
+			}
+			want := canon(tr, mpRaw)
+			if s, ok := h.(*codec.SimpleHandle); ok && s.EncZeroValuesAsNil {
+				want = zeroesToNil(want)
+			}
+			if k == hBinc && Known.bincNegativeZero {
+				want = negZeroToZero(want)
+			}
+			if !eqTree(want, canon(got, mpRaw)) {
+				fail(ht, "%s stream decode #%d differs\ntree %s\ngot  %s\nstream %s", handleNames[k], i, treeString(tr), treeString(got), hx(stream))
+			}
+		}
+		if k != hJson && dec.NumBytesRead() != len(stream) {
+			fail(ht, "%s NumBytesRead %d after the whole stream of %d bytes", handleNames[k], dec.NumBytesRead(), len(stream))
+		}
+		// and into typed containers when the top is a container
+		enc, _ := encodeWith(h, vals[0], false)
+		want0 := canon(vals[0], mpRaw)
+		if s, ok := h.(*codec.SimpleHandle); ok && s.EncZeroValuesAsNil {
+			want0 = zeroesToNil(want0)
+		}
+		if k == hBinc && Known.bincNegativeZero {
+			want0 = negZeroToZero(want0)
+		}
+		switch tr := vals[0].(type) {
+		case []any:
+			var got []any
+			if err := decodeWith(h, enc, &got, viaR); err != nil {
+				fail(ht, "%s decode into []any: %v\ntree %s", handleNames[k], err, treeString(tr))
+			}
+			if !eqTree(want0, canon(got, mpRaw)) {
+				fail(ht, "%s decode into []any differs\ntree %s\ngot  %s", handleNames[k], treeString(tr), treeString(got))
+			}
+		case map[string]any:
+			var got map[string]any
+			if err := decodeWith(h, enc, &got, viaR); err != nil {
+				fail(ht, "%s decode into map[string]any: %v\ntree %s", handleNames[k], err, treeString(tr))
+			}
+			if !eqTree(want0, canon(got, mpRaw)) {
+				fail(ht, "%s decode into map[string]any differs\ntree %s\ngot  %s", handleNames[k], treeString(tr), treeString(got))
+			}
+		}
+	})
+}
+
+// intsToStrings is what JsonHandle.IntegerAsString does to integers in an
+// interface: 'A' writes every integer as a decimal string, 'L' those beyond
+// 2^53 in magnitude; read back into an interface they are strings.
+func intsToStrings(v any, mode byte) any {
+	conv := func(neg bool, mag uint64, s string) any {
+		if mode == 'A' || (mode == 'L' && (mag > 1<<53)) {
+			return s
+		}
+		return v
+	}
+	switch x := v.(type) {
+	case int64:
+		mag := uint64(x)
+		if x < 0 {
+			mag = uint64(-x)
+		}
+		return conv(x < 0, mag, strconv.FormatInt(x, 10))
+	case uint64:
+		return conv(false, x, strconv.FormatUint(x, 10))
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = intsToStrings(x[i], mode)
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = intsToStrings(e, mode)
+		}
+		return out
+	}
+	return v
+}
+
+// zeroesToNil is what SimpleHandle.EncZeroValuesAsNil documents: zero
+// numbers, false and empty strings are written as nil.
+func zeroesToNil(v any) any {
+	switch x := v.(type) {
+	case bool:
+		if !x {
+			return nil
+		}
+	case int64:
+		if x == 0 {
+			return nil
+		}
+	case uint64:
+		if x == 0 {
+			return nil
+		}
+	case float64:
+		if x == 0 {
+			return nil
+		}
+	case string:
+		if x == "" {
+			return nil
+		}
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = zeroesToNil(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = zeroesToNil(e)
+		}
+		return out
+	}
+	return v
+}
+
+// refDecode reads a JSON text with encoding/json and types its numbers by
+// the library's documented rule: an integer literal (no . e E) is an
+// int64/uint64 (a float64 beyond them), anything else a float64; with
+// preferFloat every number is a float64.
+func refDecode(text []byte, preferFloat bool) any {
+	dec := json.NewDecoder(bytes.NewReader(text))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		panic("refDecode: " + err.Error())
+	}
+	var conv func(any) any
+	conv = func(v any) any {
+		switch x := v.(type) {
+		case json.Number:
+			s := string(x)
+			if !preferFloat && !strings.ContainsAny(s, ".eE") {
+				if i, err := strconv.ParseInt(s, 10, 64); err == nil {
+					return canon(i, false)
+				}
+				if u, err := strconv.ParseUint(s, 10, 64); err == nil {
+					return u
+				}
+			}
+			f, _ := strconv.ParseFloat(s, 64)
+			return f
+		case []any:
+			out := make([]any, len(x))
+			for i := range x {
+				out[i] = conv(x[i])
+			}
+			return out
+		case map[string]any:
+			out := map[string]any{}
+			for k, e := range x {
+				out[k] = conv(e)
+			}
+			return out
+		}
+		return v
+	}
+	return conv(v)
+}
+
+// bincSafeInt moves an int64 out of the range binc mis-encodes
+// (ugorji-codec/9): magnitudes 0xFF800000..0xFFFFFFFF.
+func bincSafeInt(v int64) int64 {
+	if Known.bincNegativePrune && v <= -4286578688 && v >= -4294967295 {
+		return -1
+	}
+	return v
+}
+
+func bincSafeTree(v any) any {
+	switch x := v.(type) {
+	case int64:
+		return bincSafeInt(x)
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = bincSafeTree(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = bincSafeTree(e)
+		}
+		return out
+	}
+	return v
+}
+
+func bincSafeBig(b Big) Big {
+	b.I64 = bincSafeInt(b.I64)
+	b.OmI = int(bincSafeInt(int64(b.OmI)))
+	for i := range b.Is {
+		b.Is[i] = bincSafeInt(b.Is[i])
+	}
+	for k, v := range b.Mi {
+		b.Mi[k] = bincSafeInt(v)
+	}
+	if b.Mk != nil {
+		mk := map[int64]string{}
+		for k, v := range b.Mk {
+			mk[bincSafeInt(k)] = v
+		}
+		b.Mk = mk
+	}
+	b.An = bincSafeTree(canon(b.An, false))
+	return b
+}
+
+// negZeroToZero turns -0 leaves into +0.
+func negZeroToZero(v any) any {
+	switch x := v.(type) {
+	case float64:
+		return x + 0
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = negZeroToZero(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = negZeroToZero(e)
+		}
+		return out
+	}
+	return v
+}
+
+// intsToFloats is what PreferFloat does: every number becomes a float64.
+func intsToFloats(v any) any {
+	switch x := v.(type) {
+	case int64:
+		return float64(x)
+	case uint64:
+		return float64(x)
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = intsToFloats(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = intsToFloats(e)
+		}
+		return out
+	}
+	return v
+}
+
+// capInts replaces the numbers whose JSON text is an integer literal outside
+// int64: uint64 above int64 when SignedInteger is set (the library then
+// parses with ParseInt), and integral floats written without an exponent
+// (magnitude below 1e21) at or beyond 2^63 (negative: always; positive: with
+// SignedInteger).
+func capInts(v any, signed bool) any {
+	switch x := v.(type) {
+	case uint64:
+		if signed && x > math.MaxInt64 {
+			return uint64(math.MaxInt64)
+		}
+	case float64:
+		if x == math.Trunc(x) && math.Abs(x) < 1e21 && (x < -9.223372036854775e18 || (signed && x >= 9.223372036854775e18)) {
+			return 1.5
+		}
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = capInts(x[i], signed)
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = capInts(e, signed)
+		}
+		return out
+	}
+	return v
+}
+
+func hasUint64(v any) bool {
+	switch x := v.(type) {
+	case uint64:
+		return x <= math.MaxInt64
+	case []any:
+		for _, e := range x {
+			if hasUint64(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasUint64(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// 3. msgpack bytes match the model; every spec form decodes.
+
+// mpCase: the encoder's style and OptimumSize, a tree whose bytes are
+// compared with the model's, a tree with times written in the spec forms
+// the tape selects, and the reader switch.
+type mpCase struct {
+	st      mpStyle
+	optimum bool
+	tr, tr2 any
+	loose   []int
+	viaR    bool
+}
+
+func (c mpCase) GoString() string {
+	return fmt.Sprintf("style %+v optimum=%v reader=%v\ntree %s\ntree with times %s\ntape %v", c.st, c.optimum, c.viaR, treeString(c.tr), treeString(c.tr2), c.loose)
+}
+
+var (
+	mpStyles = hegel.Composite(func(tc hegel.TestCase) mpStyle {
+		return mpStyle{WriteExt: hegel.Draw(tc, chance(60)), PosUnsigned: hegel.Draw(tc, chance(30)), NoFixed: hegel.Draw(tc, chance(20))}
+	})
+	wireTrees     = trees(treeOpts{specials: true, bytes: true, maxDepth: 3})
+	wireTimeTrees = trees(treeOpts{specials: true, bytes: true, times: true, maxDepth: 3})
+	mpCases       = hegel.Composite(func(tc hegel.TestCase) mpCase {
+		return mpCase{
+			st:      hegel.Draw(tc, mpStyles),
+			optimum: hegel.Draw(tc, chance(30)),
+			tr:      hegel.Draw(tc, wireTrees),
+			tr2:     hegel.Draw(tc, wireTimeTrees),
+			loose:   hegel.Draw(tc, tapes),
+			viaR:    hegel.Draw(tc, chance(30)),
+		}
+	})
+)
+
+func TestHegelMsgpackWireMatchesModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mpCases)
+		st := c.st
+		h := &codec.MsgpackHandle{WriteExt: st.WriteExt, PositiveIntUnsigned: st.PosUnsigned, NoFixedNum: st.NoFixed}
+		h.Canonical = true
+		h.OptimumSize = c.optimum
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		h.RawToString = !st.WriteExt
+		tr := c.tr
+		enc, err := encodeWith(h, tr, false)
+		if err != nil {
+			fail(ht, "encode: %v\ntree %s", err, treeString(tr))
+		}
+		want := mpEncode(tr, st)
+		if !bytes.Equal(enc, want) {
+			fail(ht, "msgpack bytes differ from the model (style %+v)\ntree  %s\ncodec %s\nmodel %s", st, treeString(tr), hx(enc), hx(want))
+		}
+		got, k, err := mpDecode(enc)
+		if err != nil || k != len(enc) {
+			fail(ht, "model cannot decode the library's bytes: %v (%d of %d)\ntree %s\nbytes %s", err, k, len(enc), treeString(tr), hx(enc))
+		}
+		if !eqTree(canon(tr, !st.WriteExt), canon(got, !st.WriteExt)) {
+			fail(ht, "model decode of the library's bytes differs\ntree %s\ngot  %s\nbytes %s", treeString(tr), treeString(got), hx(enc))
+		}
+		// every spec form the model can write must decode (new-spec handle)
+		tr2 := c.tr2
+		loose := mpEncodeLoose(tr2, &tape{vals: c.loose})
+		h2 := &codec.MsgpackHandle{WriteExt: true}
+		h2.MapType = reflect.TypeOf(map[string]any(nil))
+		var got2 any
+		if err := decodeWith(h2, loose, &got2, c.viaR); err != nil {
+			fail(ht, "decode of spec-form bytes: %v\ntree %s\nbytes %s", err, treeString(tr2), hx(loose))
+		}
+		if !eqTree(canon(tr2, false), canon(got2, false)) {
+			fail(ht, "decode of spec-form bytes differs\ntree %s\ngot  %s\nbytes %s", treeString(tr2), treeString(got2), hx(loose))
+		}
+		// and the library's own encoding of a tree with times model-decodes
+		enc3, err := encodeWith(h2, tr2, false)
+		if err != nil {
+			fail(ht, "encode with times: %v", err)
+		}
+		got3, k3, err := mpDecode(enc3)
+		if err != nil || k3 != len(enc3) {
+			fail(ht, "model cannot decode the library's bytes (times): %v (%d of %d)\ntree %s\nbytes %s", err, k3, len(enc3), treeString(tr2), hx(enc3))
+		}
+		if !eqTree(canon(tr2, false), canon(got3, false)) {
+			fail(ht, "model decode (times) differs\ntree %s\ngot  %s\nbytes %s", treeString(tr2), treeString(got3), hx(enc3))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// 4. CBOR bytes match the model; every spec form decodes; integer overflow is
+// an error.
+
+// cbCase: the encoder's style, a tree whose bytes are compared with the
+// model's, a tree with times written in the spec forms the tape selects,
+// the decoder's SkipUnexpectedTags and reader switches, and how far below
+// -1-2^63 the rejected integer lies.
+type cbCase struct {
+	st         cbStyle
+	tr, tr2    any
+	loose      []int
+	skipTags   bool
+	viaR       bool
+	belowInt64 int
+}
+
+func (c cbCase) GoString() string {
+	return fmt.Sprintf("style %+v skipTags=%v reader=%v below=%d\ntree %s\ntree with times %s\ntape %v", c.st, c.skipTags, c.viaR, c.belowInt64, treeString(c.tr), treeString(c.tr2), c.loose)
+}
+
+var (
+	cbStyles = hegel.Composite(func(tc hegel.TestCase) cbStyle {
+		return cbStyle{Indef: hegel.Draw(tc, chance(30)), Optimum: hegel.Draw(tc, chance(40))}
+	})
+	cbCases = hegel.Composite(func(tc hegel.TestCase) cbCase {
+		return cbCase{
+			st:         hegel.Draw(tc, cbStyles),
