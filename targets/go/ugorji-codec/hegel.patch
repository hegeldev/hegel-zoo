+// ---------------------------------------------------------------------------
+// 7. Malformed input: every proper prefix of an encoding is an error, and
+// corrupted bytes never panic.
+
+// cutSpec: a prefix of the encoding (its end an offset taken modulo the
+// length), and whether it is decoded into an interface{} rather than a Big,
+// and from an io.Reader.
+type cutSpec struct {
+	at            int
+	intoAny, viaR bool
+}
+
+// editSpec: one corruption of the encoding at an offset taken modulo the
+// live length: the byte there replaced by b, deleted, or b inserted before
+// it.
+type editSpec struct {
+	at   int
+	kind int // 0 replace, 1 delete, 2 insert
+	b    byte
+}
+
+// malformedCase: the handle, a tree or a Big, three cuts (the second is
+// always the encoding less its last byte), one to three corruptions, and
+// the reader switches of the two decodes of the corrupted bytes.
+type malformedCase struct {
+	h                handleSpec
+	v                any
+	cuts             []cutSpec
+	edits            []editSpec
+	anyViaR, bigViaR bool
+}
+
+func (c malformedCase) GoString() string {
+	return fmt.Sprintf("%s\nvalue %s\ncuts %+v\nedits %+v\nreaders %v %v", c.h.GoString(), treeString(c.v), c.cuts, c.edits, c.anyViaR, c.bigViaR)
+}
+
+var (
+	// offsets: a byte offset into data of unknown length, taken modulo the
+	// length when applied.
+	offsets  = hegel.Integers(0, 1<<20-1)
+	bytesOf  = hegel.Map(hegel.Integers(0, 255), func(b int) byte { return byte(b) })
+	cutSpecs = hegel.Composite(func(tc hegel.TestCase) cutSpec {
+		return cutSpec{at: hegel.Draw(tc, offsets), intoAny: hegel.Draw(tc, chance(50)), viaR: hegel.Draw(tc, chance(30))}
+	})
+	editSpecs = hegel.Composite(func(tc hegel.TestCase) editSpec {
+		return editSpec{at: hegel.Draw(tc, offsets), kind: hegel.Draw(tc, hegel.Integers(0, 2)), b: hegel.Draw(tc, bytesOf)}
+	})
+	malformedCases = hegel.Composite(func(tc hegel.TestCase) malformedCase {
+		h := hegel.Draw(tc, handles)
+		notJson := h.kind() != hJson
+		// a tree two levels deep, or a Big (with whole seconds, as the
+		// formats without nanoseconds need)
+		values := hegel.OneOf(
+			trees(treeOpts{bytes: notJson, maxDepth: 2}),
+			asAny(bigs(bigOpts{wholeSeconds: true, bytesAsAny: notJson})),
+		)
+		return malformedCase{
+			h:       h,
+			v:       hegel.Draw(tc, values),
+			cuts:    hegel.Draw(tc, fixed(cutSpecs, 3)),
+			edits:   hegel.Draw(tc, many(editSpecs, 1, 3)),
+			anyViaR: hegel.Draw(tc, chance(30)),
+			bigViaR: hegel.Draw(tc, chance(30)),
+		}
+	})
+)
+
+func TestHegelMalformedInputIsAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, malformedCases)
+		h, k := c.h.build(), c.h.kind()
+		basic(h).MaxInitLen = 1024
+		if j, ok := h.(*codec.JsonHandle); ok {
+			j.TermWhitespace = false
+		}
+		v := c.v
+		_, isBig := v.(Big)
+		enc, err := encodeWith(h, v, false)
+		if err != nil {
+			fail(ht, "encode: %v", err)
+		}
+		note(ht, "encoding of %d bytes", len(enc))
+		// prefixes (JSON: only self-delimiting tops, a number's prefix is a number)
+		selfDelimiting := k != hJson || (len(enc) > 0 && strings.ContainsRune("{[\"", rune(enc[0])))
+		if selfDelimiting && len(enc) > 1 {
+			for i, cs := range c.cuts {
+				cut := cs.at % len(enc)
+				if i == 1 {
+					cut = len(enc) - 1
+				}
+				var out any
+				var outB Big
+				var err error
+				// a Big holds an int-keyed map, which a string-keyed MapType
+				// mis-reads (ugorji-codec/8): decode it only into a Big
+				if cs.intoAny && !(isBig && Known.mapKeyMisread) {
+					err = decodeWith(h, enc[:cut], &out, cs.viaR)
+				} else {
+					err = decodeWith(h, enc[:cut], &outB, cs.viaR)
+				}
+				if err == nil && !(k == hJson && isJsonWhitespaceOnlyTail(enc, cut)) {
+					var again, fresh any
+					errAgain := decodeWith(h, enc[:cut], &again, false)
+					errFresh := decodeWith(c.h.build(), enc[:cut], &fresh, false)
+					fail(ht, "%s: prefix %d of %d decoded without error (again: %v; fresh handle: %v)\nhandle %s\nvalue %s\nprefix %s", handleNames[k], cut, len(enc), errAgain, errFresh, handleString(h), treeString(v), hx(enc[:cut]))
+				}
+			}
+		}
+		// corruption: never a panic (property() turns one into a failure)
+		mut := append([]byte{}, enc...)
+		for _, e := range c.edits {
+			if len(mut) == 0 {
+				break
+			}
+			p := e.at % len(mut)
+			switch e.kind {
+			case 0:
+				mut[p] = e.b
+			case 1:
+				mut = append(mut[:p], mut[p+1:]...)
+			default:
+				mut = append(mut[:p], append([]byte{e.b}, mut[p:]...)...)
+			}
+		}
+		var out any
+		if isBig && Known.mapKeyMisread {
+			count(ht, "known ugorji-codec/8")
+		} else {
+			_ = decodeWith(h, mut, &out, c.anyViaR)
+		}
+		var outB Big
+		_ = decodeWith(h, mut, &outB, c.bigViaR)
+	})
+}
+
+func isJsonWhitespaceOnlyTail(enc []byte, cut int) bool {
+	return strings.TrimSpace(string(enc[cut:])) == ""
+}
