+// ---------------------------------------------------------------------------
+// 8. Options with a checkable meaning: Canonical determinism, IntegerAsString,
+// NilCollectionToZeroLength, StructToArray, MapKeyAsString.
+
+type Coll struct {
+	S []int          `codec:"s"`
+	M map[string]int `codec:"m"`
+	B []byte         `codec:"b"`
+}
+
+// jsonOptionsCase: the values of the JSON handle's option checks: an int64
+// and a uint64 for IntegerAsString, two int64 to read back, the
+// NilCollectionToZeroLength switch and a Sub for StructToArray.
+type jsonOptionsCase struct {
+	i         int64
+	u         uint64
+	two       []int64
+	nilToZero bool
+	sub       Sub
+}
+
+// optionsCase: the handle (Canonical is forced on), two to twenty keyed
+// trees (their keys made distinct by their index), two to twelve int-keyed
+// entries, and for a JSON handle the values of its option checks.
+type optionsCase struct {
+	h       handleSpec
+	entries []pair[string, any]
+	intKeys []pair[int64, int]
+	json    *jsonOptionsCase
+}
+
+func (c optionsCase) GoString() string {
+	s := fmt.Sprintf("%s\nentries %s\nint keys %v", c.h.GoString(), treeString(c.entries), c.intKeys)
+	if c.json != nil {
+		s += fmt.Sprintf("\njson %+v", *c.json)
+	}
+	return s
+}
+
+var (
+	jsonOptionsCases = hegel.Composite(func(tc hegel.TestCase) jsonOptionsCase {
+		return jsonOptionsCase{
+			i:         hegel.Draw(tc, ints),
+			u:         hegel.Draw(tc, uints),
+			two:       hegel.Draw(tc, fixed(ints, 2)),
+			nilToZero: hegel.Draw(tc, chance(50)),
+			sub:       hegel.Draw(tc, subs),
+		}
+	})
+	// keyedTrees: two to twenty short key suffixes with a shallow tree each,
+	// with or without []byte leaves.
+	keyedTrees = func() (gs [2]hegel.Generator[[]pair[string, any]]) {
+		for i, withBytes := range []bool{false, true} {
+			gs[i] = many(pairs(strs(3), trees(treeOpts{bytes: withBytes, maxDepth: 1})), 2, 20)
+		}
+		return gs
+	}()
+	intKeyed     = many(pairs(ints, hegel.Integers(0, 9)), 2, 12)
+	optionsCases = hegel.Composite(func(tc hegel.TestCase) optionsCase {
+		h := hegel.Draw(tc, handles)
+		keyed := keyedTrees[0]
+		if h.kind() != hJson {
+			keyed = keyedTrees[1]
+		}
+		c := optionsCase{h: h, entries: hegel.Draw(tc, keyed), intKeys: hegel.Draw(tc, intKeyed)}
+		if h.kind() == hJson { // the checks past the canonical ones are the JSON handle's
+			c.json = ptrTo(hegel.Draw(tc, jsonOptionsCases))
+		}
+		return c
+	})
+)
+
+func TestHegelOptionsMeanWhatTheySay(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, optionsCases)
+		h, k := c.h.build(), c.h.kind()
+		basic(h).Canonical = true
+		// Canonical: the same map, built in different insertion orders, encodes identically
+		m := map[string]any{}
+		keys := make([]string, len(c.entries))
+		for i, e := range c.entries {
+			keys[i] = fmt.Sprintf("k%d_%s", i, e.a)
+			m[keys[i]] = e.b
+			if k == hBinc && Known.bincNegativePrune {
+				m[keys[i]] = bincSafeTree(e.b)
+			}
+		}
+		m2 := map[string]any{}
+		for i := len(keys) - 1; i >= 0; i-- {
+			m2[keys[i]] = m[keys[i]]
+		}
+		e1, err1 := encodeWith(h, m, false)
+		e2, err2 := encodeWith(h, m2, false)
+		if err1 != nil || err2 != nil {
+			fail(ht, "encode: %v %v", err1, err2)
+		}
+		if !bytes.Equal(e1, e2) {
+			fail(ht, "%s Canonical encodings differ for the same map\n%s\n%s", handleNames[k], hx(e1), hx(e2))
+		}
+		mk := map[int64]any{}
+		for _, e := range c.intKeys {
+			mk[bincSafeInt(e.a)] = e.b
+		}
+		e1, _ = encodeWith(h, mk, false)
+		e2, _ = encodeWith(h, mk, false)
+		if !bytes.Equal(e1, e2) {
+			fail(ht, "%s Canonical encodings differ for the same int-keyed map\n%s\n%s", handleNames[k], hx(e1), hx(e2))
+		}
+		if k != hJson {
+			return
+		}
+		j := h.(*codec.JsonHandle)
+		j.Indent = 0
+		j.TermWhitespace = false
+		j.StructToArray = false
+		// IntegerAsString
+		nums := []any{c.json.i, c.json.u, int64(1 << 53), int64(1<<53 + 1), -int64(1 << 53), -int64(1<<53) - 1}
+		enc, _ := encodeWith(j, nums, false)
+		toks, err := jsonTokens(enc)
+		if err != nil {
+			fail(ht, "tokenise %q: %v", enc, err)
+		}
+		for i, x := range nums {
+			tk := toks[i+1]
+			bx, _ := toBig(canon(x, false))
+			var asString bool
+			switch j.IntegerAsString {
+			case 'A':
+				asString = true
+			case 'L':
+				lim := new(big.Float).SetInt64(1 << 53)
+				asString = bx.Cmp(lim) > 0 || bx.Cmp(new(big.Float).Neg(lim)) < 0
+			}
+			if asString != (tk.kind == 's') {
+				fail(ht, "IntegerAsString %q: %v encoded as %q\n%s", j.IntegerAsString, x, tk.s, enc)
+			}
+			if tk.kind == 's' {
+				sf, _, _ := big.ParseFloat(tk.s, 10, 200, big.ToNearestEven)
+				if sf == nil || sf.Cmp(bx) != 0 {
+					fail(ht, "IntegerAsString %q: %v encoded as %q", j.IntegerAsString, x, tk.s)
+				}
+			} else if tk.num.Cmp(bx) != 0 {
+				fail(ht, "IntegerAsString %q: %v encoded as %s", j.IntegerAsString, x, tk.s)
+			}
+		}
+		// and the strings decode back into integer fields
+		var back []int64
+		enc, _ = encodeWith(j, c.json.two, false)
+		if err := decodeWith(j, enc, &back, false); err != nil {
+			fail(ht, "IntegerAsString %q: decoding %s into []int64: %v", j.IntegerAsString, enc, err)
+		}
+		// NilCollectionToZeroLength
+		j.NilCollectionToZeroLength = c.json.nilToZero
+		enc, _ = encodeWith(j, Coll{}, false)
+		var cm map[string]json.RawMessage
+		_ = json.Unmarshal(enc, &cm)
+		for key, want := range map[string]string{"s": "[]", "m": "{}", "b": `""`} {
+			if !j.NilCollectionToZeroLength {
+				want = "null"
+			} else if key == "b" && Known.nilBytesAsArray {
+				want = "[]"
+			}
+			if string(cm[key]) != want {
+				fail(ht, "NilCollectionToZeroLength=%v: %q is %s\n%s", j.NilCollectionToZeroLength, key, cm[key], enc)
+			}
+		}
+		// StructToArray: a JSON array with one element per encodable field, in order
+		j.StructToArray = true
+		j.NilCollectionToZeroLength = false
+		sub := c.json.sub
+		enc, _ = encodeWith(j, sub, false)
+		var arr []json.RawMessage
+		if err := json.Unmarshal(enc, &arr); err != nil {
+			fail(ht, "StructToArray: %v\n%s", err, enc)
+		}
+		if len(arr) != 3 {
+			fail(ht, "StructToArray: %d elements for a struct of 3 encodable fields\n%s", len(arr), enc)
+		}
+		var back2 Sub
+		if err := decodeWith(j, enc, &back2, false); err != nil {
+			fail(ht, "StructToArray decode: %v\n%s", err, enc)
+		}
+		sub.Skip = 0
+		if len(sub.Tags) == 0 {
+			sub.Tags = nil
+		}
+		if len(back2.Tags) == 0 {
+			back2.Tags = nil
+		}
+		if !reflect.DeepEqual(sub, back2) {
+			fail(ht, "StructToArray round trip: %+v vs %+v\n%s", sub, back2, enc)
+		}
+		// MapKeyAsString: integer keys become strings
+		j.StructToArray = false
+		enc, _ = encodeWith(j, mk, false)
+		if !json.Valid(enc) {
+			fail(ht, "MapKeyAsString: invalid JSON %s", enc)
+		}
+		var mkBack map[int64]any
+		if err := decodeWith(j, enc, &mkBack, false); err != nil {
+			fail(ht, "MapKeyAsString: decoding %s into map[int64]any: %v", enc, err)
+		}
+		if len(mkBack) != len(mk) {
+			fail(ht, "MapKeyAsString: %d keys back from %d\n%s", len(mkBack), len(mk), enc)
+		}
+	})
+}
diff --git a/codec/hegel_test.go b/codec/hegel_test.go
new file mode 100644
index 0000000..881f9ca
--- /dev/null
+++ b/codec/hegel_test.go
@@ -0,0 +1,210 @@
+package codec_test
+
+// Hegel properties for github.com/ugorji/go/codec: the five formats
+// (msgpack, CBOR, JSON, binc, simple) against independent oracles -
+// encoding/json for JSON, hand-written model encoders for the msgpack and
+// CBOR wire formats - and against the library's own round trips over typed
+// and untyped Go values under randomised handle options.
+//
+// No external tool is needed. Conventions: hegel-go reads no environment
+// variable itself, so HEGEL_TEST_CASES (and HEGEL_VERBOSE) are passed
+// through hegelOpts; a panic in the code under test is turned into a
+// failure of the current test case by property().
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// fail is the properties' spelling of a failed check.
+func fail(ht *hegel.T, format string, args ...any) { ht.Fatalf(format, args...) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] { return many(g, k, k) }
+
+// asAny is g as a generator of any (for the alternatives of a tree).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// tape is a drawn list of small integers that a pure writer consumes in
+// order, recycled modulo its length, for the choices a wire format leaves
+// free (the width of a header, whether a container is indefinite, where a
+// string is chunked, the order of a map's keys, an escape in JSON text).
+// An empty tape answers 0 to every question, so the shrunk form of every
+// choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	omitEmptyByPointer   bool // ugorji-codec/1: omitempty compares memory, so a zero-length string with a non-nil data pointer is emitted
+	cborNegativeOverflow bool // ugorji-codec/2: CBOR negative integers below int64 wrap instead of erroring
+	jsonIntOverflow      bool // ugorji-codec/3: a JSON integer below int64 (or above it with SignedInteger) is an error while one above uint64 becomes a float64
+	nilBytesAsArray      bool // ugorji-codec/4: NilCollectionToZeroLength writes a nil []byte as an empty array, not as empty bytes
+	cborTimeRounded      bool // ugorji-codec/5: the CBOR decoder rounds every time to the microsecond, though TimeRFC3339 writes nanoseconds
+	bincNegativeZero     bool // ugorji-codec/6: binc writes -0.0 as +0.0
+	signedIntegerWraps   bool // ugorji-codec/7: SignedInteger turns unsigned values in [2^63, 2^64) into negative int64
+	mapKeyMisread        bool // ugorji-codec/8: a non-string map key decoded into a string-keyed map is read as a string header (CBOR, simple), misaligning the stream
+	bincNegativePrune    bool // ugorji-codec/9: binc drops the leading 0xFF of a 4-byte negative magnitude as sign extension: -4294967295..-4286578688 change value
+}{omitEmptyByPointer: true, cborNegativeOverflow: true, jsonIntOverflow: true, nilBytesAsArray: true, cborTimeRounded: true, bincNegativeZero: true, signedIntegerWraps: true, mapKeyMisread: true, bincNegativePrune: true}
