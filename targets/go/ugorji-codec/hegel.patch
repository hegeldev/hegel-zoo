+// eqTimeLoose is eqTree with times compared to the microsecond (the library
+// writes CBOR times as float64 seconds).
+func eqTimeLoose(a, b any) bool {
+	switch x := a.(type) {
+	case time.Time:
+		y, ok := b.(time.Time)
+		if !ok {
+			return false
+		}
+		f := math.Abs(float64(x.Unix()))
+		tol := 2*time.Microsecond + time.Duration((math.Nextafter(f, math.Inf(1))-f)*2e9)
+		return x.Sub(y).Abs() < tol
+	case []any:
+		y, ok := b.([]any)
+		if !ok || len(x) != len(y) {
+			return false
+		}
+		for i := range x {
+			if !eqTimeLoose(x[i], y[i]) {
+				return false
+			}
+		}
+		return true
+	case map[string]any:
+		y, ok := b.(map[string]any)
+		if !ok || len(x) != len(y) {
+			return false
+		}
+		for k, e := range x {
+			if f, ok := y[k]; !ok || !eqTimeLoose(e, f) {
+				return false
+			}
+		}
+		return true
+	}
+	return eqTree(a, b)
+}
+
+// ---------------------------------------------------------------------------
+// 5. JSON against encoding/json: output tokens (and bytes, when no float is
+// involved), and decoding of encoding/json's output under re-escaping and
+// whitespace.
+
+type jtok struct {
+	kind byte // '{', '}', '[', ']', 's', 'n', 'b', '0'
+	s    string
+	num  *big.Float
+	b    bool
+}
+
+func jsonTokens(b []byte) ([]jtok, error) {
+	dec := json.NewDecoder(bytes.NewReader(b))
+	dec.UseNumber()
+	var out []jtok
+	for {
+		t, err := dec.Token()
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return nil, err
+		}
+		switch x := t.(type) {
+		case json.Delim:
+			out = append(out, jtok{kind: byte(x)})
+		case string:
+			out = append(out, jtok{kind: 's', s: x})
+		case json.Number:
+			f, _, err := big.ParseFloat(string(x), 10, 200, big.ToNearestEven)
+			if err != nil {
+				return nil, err
+			}
+			out = append(out, jtok{kind: '0', num: f, s: string(x)})
+		case bool:
+			out = append(out, jtok{kind: 'b', b: x})
+		case nil:
+			out = append(out, jtok{kind: 'n'})
+		}
+	}
+}
+
+func sameTokens(a, b []jtok) (bool, string) {
+	if len(a) != len(b) {
+		return false, fmt.Sprintf("%d vs %d tokens", len(a), len(b))
+	}
+	for i := range a {
+		x, y := a[i], b[i]
+		if x.kind != y.kind || x.s != y.s && x.kind == 's' || x.b != y.b {
+			return false, fmt.Sprintf("token %d: %+v vs %+v", i, x, y)
+		}
+		if x.kind == '0' && x.num.Cmp(y.num) != 0 {
+			return false, fmt.Sprintf("token %d: number %s vs %s", i, x.s, y.s)
+		}
+	}
+	return true, ""
+}
+
+func hasFloat(v any) bool {
+	switch x := v.(type) {
+	case float64:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasFloat(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasFloat(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// jsonMutate rewrites a JSON text keeping its value: random whitespace
+// between tokens, \u escapes for random characters (surrogate pairs above
+// the BMP), \/ for slashes.
+func jsonMutate(tc hegel.TestCase, src []byte) []byte {
+	var out []byte
+	ws := func() {
+		if chance(tc, 20) {
+			out = append(out, pick(tc, " ", "\n", "\t", "\r", "  \n")...)
+		}
+	}
+	i := 0
+	for i < len(src) {
+		c := src[i]
+		switch c {
+		case '"':
+			// copy the string, re-escaping
+			out = append(out, '"')
+			i++
+			for i < len(src) {
+				c := src[i]
+				if c == '\\' {
+					out = append(out, src[i], src[i+1])
+					i += 2
+					if src[i-1] == 'u' {
+						out = append(out, src[i:i+4]...)
+						i += 4
+					}
+					continue
+				}
+				if c == '"' {
+					out = append(out, '"')
+					i++
+					break
+				}
+				r, size := rune(c), 1
+				if c >= 0x80 {
+					r, size = decodeRune(src[i:])
+				}
+				switch {
+				case c == '/' && chance(tc, 50):
+					out = append(out, '\\', '/')
+				case chance(tc, 15):
+					if r >= 0x10000 {
+						r -= 0x10000
+						hi, lo := 0xd800+(r>>10), 0xdc00+(r&0x3ff)
+						out = append(out, fmt.Sprintf("\\u%04x\\u%04X", hi, lo)...)
+					} else {
+						out = append(out, fmt.Sprintf("\\u%04X", r)...)
+					}
+				default:
+					out = append(out, src[i:i+size]...)
+				}
+				i += size
+			}
+		case '{', '}', '[', ']', ',', ':':
+			ws()
+			out = append(out, c)
+			ws()
+			i++
+		default:
+			out = append(out, c)
+			i++
+		}
+	}
+	return out
+}
+
+func decodeRune(b []byte) (rune, int) {
+	r, size := rune(b[0]), 1
+	for _, rr := range string(b) {
+		r = rr
+		size = len(string(rr))
+		break
+	}
+	return r, size
+}
+
+func TestHegelJsonMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr := genTree(tc, treeOpts{bytes: chance(tc, 50), maxDepth: 3})
+		if Known.jsonIntOverflow {
+			tr = capInts(tr, false) // an integral float below -2^63 is written as an integer literal the library cannot read back
+		}
+		h := &codec.JsonHandle{HTMLCharsAsIs: chance(tc, 30), TermWhitespace: chance(tc, 20), MapKeyAsString: true}
+		if chance(tc, 30) {
+			h.Indent = int8(pick(tc, 1, 2, 4, -1))
+		}
+		h.Canonical = true
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		note(ht, "handle %s", handleString(h))
+		enc, err := encodeWith(h, tr, chance(tc, 30))
+		if err != nil {
+			fail(ht, "encode: %v\ntree %s", err, treeString(tr))
+		}
+		if !json.Valid(enc) {
+			fail(ht, "codec JSON is invalid\ntree %s\njson %q", treeString(tr), enc)
+		}
+		var ebuf bytes.Buffer
+		e := json.NewEncoder(&ebuf)
+		e.SetEscapeHTML(!h.HTMLCharsAsIs)
+		if err := e.Encode(tr); err != nil {
+			fail(ht, "encoding/json: %v", err)
+		}
+		ref := bytes.TrimSuffix(ebuf.Bytes(), []byte("\n"))
+		at, err := jsonTokens(enc)
+		if err != nil {
+			fail(ht, "tokenise codec output: %v\n%q", err, enc)
+		}
+		bt, _ := jsonTokens(ref)
+		if ok, why := sameTokens(at, bt); !ok {
+			fail(ht, "codec JSON differs from encoding/json: %s\ntree  %s\ncodec %q\nejson %q", why, treeString(tr), enc, ref)
+		}
+		if h.Indent == 0 && !h.TermWhitespace && !hasFloat(tr) && !bytes.Equal(enc, ref) {
+			fail(ht, "codec JSON bytes differ from encoding/json\ntree  %s\ncodec %q\nejson %q", treeString(tr), enc, ref)
+		}
+		// encoding/json reads codec's output back to the tree
+		var back any
+		if err := json.Unmarshal(enc, &back); err != nil {
+			fail(ht, "encoding/json cannot read codec output: %v\n%q", err, enc)
+		}
+		var viaRef any
+		_ = json.Unmarshal(ref, &viaRef)
+		if !eqTree(back, viaRef) {
+			fail(ht, "encoding/json reads codec output differently\ncodec %q\nejson %q", enc, ref)
+		}
+		// codec reads encoding/json's output (mutated) back to the tree
+		mut := jsonMutate(tc, ref)
+		if !json.Valid(mut) {
+			fail(ht, "internal: mutation broke the JSON %q -> %q", ref, mut)
+		}
+		h2 := &codec.JsonHandle{MapKeyAsString: true, PreferFloat: chance(tc, 20)}
+		h2.MapType = reflect.TypeOf(map[string]any(nil))
+		var got any
+		if err := decodeWith(h2, mut, &got, chance(tc, 30)); err != nil {
+			fail(ht, "codec cannot decode encoding/json output: %v\ntree %s\njson %q", err, treeString(tr), mut)
+		}
+		want := refDecode(ref, h2.PreferFloat)
+		if !eqTree(want, canon(got, false)) {
+			fail(ht, "codec decodes encoding/json output differently\ntree %s\ngot  %s\njson %q", treeString(want), treeString(got), mut)
+		}
+		// number texts: any JSON number decodes into interface{} as the
+		// nearest int64/uint64 or a float64, and into float64 exactly like
+		// strconv
+		numText := genNumberText(tc)
+		var gotN any
+		errN := decodeWith(h2, []byte(numText), &gotN, false)
+		f, ferr := strconv.ParseFloat(numText, 64)
+		if ferr != nil {
+			return // out of range for float64: an error is fine either way
+		}
+		bigN, _, _ := big.ParseFloat(numText, 10, 200, big.ToNearestEven)
+		if Known.jsonIntOverflow && bigN.Cmp(new(big.Float).SetInt64(math.MinInt64)) < 0 && !strings.ContainsAny(numText, ".eE") {
+			return
+		}
+		if errN != nil {
+			fail(ht, "number %q: %v", numText, errN)
+		}
+		gotF, _ := toBig(gotN)
+		switch gotN.(type) {
+		case int64, uint64:
+			if gotF.Cmp(bigN) != 0 {
+				fail(ht, "number %q decoded as %T %v", numText, gotN, gotN)
+			}
+		case float64:
+			if gotN.(float64) != f {
+				fail(ht, "number %q decoded as float64 %v, strconv says %v", numText, gotN, f)
+			}
+		default:
+			fail(ht, "number %q decoded as %T %v", numText, gotN, gotN)
+		}
+		var gotFloat float64
+		if err := decodeWith(h2, []byte(numText), &gotFloat, false); err != nil {
+			fail(ht, "number %q into float64: %v", numText, err)
+		}
+		if gotFloat != f {
+			fail(ht, "number %q into float64: %v, strconv says %v", numText, gotFloat, f)
+		}
+	})
+}
+
+func genNumberText(tc hegel.TestCase) string {
+	switch n(tc, 0, 5) {
+	case 0:
+		return strconv.FormatInt(genInt(tc), 10)
+	case 1:
+		return strconv.FormatUint(genUint(tc), 10)
+	case 2:
+		return strconv.FormatFloat(genFloat(tc, false), 'g', -1, 64)
+	case 3:
+		// beyond the 64-bit ranges
+		x := new(big.Int).SetUint64(genUint(tc))
+		x.Add(x, new(big.Int).SetUint64(1<<63))
+		if chance(tc, 50) {
+			x.Neg(x)
+		}
+		return x.String()
+	case 4:
+		return fmt.Sprintf("%d.%d", genInt(tc), n(tc, 0, 999))
+	default:
+		return fmt.Sprintf("%dE%s%d", n(tc, -999, 999), pick(tc, "", "+", "-"), n(tc, 0, 30))
+	}
+}
+
+func hasBytes(v any) bool {
+	switch x := v.(type) {
+	case []byte:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasBytes(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasBytes(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func bytesToBase64(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		b, _ := json.Marshal(x)
+		var s string
+		_ = json.Unmarshal(b, &s)
+		return s
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = bytesToBase64(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = bytesToBase64(e)
+		}
+		return out
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// 6. Struct tags and omitempty against encoding/json (the json: tag is
+// honoured, the README calls the handle a drop-in replacement) and against
+// the library's documented rule (omitted iff the zero value).
+
+type Tagged struct {
+	A  int            `json:"a,omitempty"`
+	B  string         `json:"b,omitempty"`
+	C  []int          `json:"c,omitempty"`
+	D  map[string]int `json:"d,omitempty"`
+	E  *int           `json:"e,omitempty"`
+	F  bool           `json:"f,omitempty"`
+	G  float64        `json:"g,omitempty"`
+	H  any            `json:"h,omitempty"`
+	I  Inner          `json:"i,omitempty"`
+	J  [2]int         `json:"j,omitempty"`
+	K  int            `json:"-"`
+	L  int            `json:"-,"`
+	M  string         `json:"m"`
+	N  []byte         `json:"n,omitempty"`
+	O  uint8          `json:"o,omitempty"`
+	Pp *Inner         `json:"pp,omitempty"`
+	Q  int            `json:",omitempty"`
+	R  string         `json:"renamed_r"`
+	Inner2
+	S int
+	t int
+}
+
+type Inner struct {
+	X int    `json:"x,omitempty"`
+	Y string `json:"y"`
+}
+
+type Inner2 struct {
+	Z1 int
+	Z2 string `json:"z2,omitempty"`
+}
+
+func genTagged(tc hegel.TestCase, gate bool) Tagged {
+	var v Tagged
+	str := func(maxLen int) string {
+		// with the omitempty pointer bug open, never produce an empty string
+		// at run time for an omitempty field (the zero value left untouched
+		// is the only empty string the library omits)
+		s := genString(tc, maxLen)
+		if gate && s == "" {
+			return "x"
+		}
+		return s
+	}
+	if chance(tc, 50) {
+		v.A = int(genInt(tc))
+	}
+	if chance(tc, 50) {
+		v.B = str(6)
+	}
+	if chance(tc, 30) {
+		v.C = []int{}
+	} else if chance(tc, 50) {
+		v.C = []int{n(tc, 0, 9)}
+	}
+	if chance(tc, 30) {
+		v.D = map[string]int{}
+	} else if chance(tc, 50) {
+		v.D = map[string]int{"k": n(tc, 0, 9)}
+	}
+	if chance(tc, 50) {
+		x := n(tc, 0, 3)
+		v.E = &x
+	}
+	v.F = chance(tc, 50)
+	if chance(tc, 50) {
+		v.G = genFloat(tc, false)
+		if v.G == 0 {
+			v.G = 1
+		}
+	}
+	if chance(tc, 50) {
+		v.H = pick[any](tc, 0, "", 1, "s", []any{}, nil, false)
+	}
+	if chance(tc, 50) {
+		v.I.X = n(tc, 0, 3)
+	}
+	if chance(tc, 50) {
+		v.I.Y = str(4)
+	}
+	if chance(tc, 50) {
+		v.J[n(tc, 0, 1)] = n(tc, 1, 3)
+	}
+	v.K = n(tc, 1, 9)
+	if chance(tc, 50) {
+		v.L = n(tc, 1, 9)
+	}
+	v.M = genString(tc, 4)
+	if chance(tc, 30) {
+		v.N = []byte{}
+	} else if chance(tc, 50) {
+		v.N = []byte{1}
+	}
+	v.O = uint8(n(tc, 0, 2))
+	if chance(tc, 50) {
+		v.Pp = &Inner{X: n(tc, 0, 2), Y: str(3)}
+	}
+	if chance(tc, 50) {
+		v.Q = n(tc, 1, 3)
+	}
+	v.R = genString(tc, 4)
+	v.Z1 = n(tc, 0, 2)
+	if chance(tc, 50) {
+		v.Z2 = str(3)
+	}
+	v.S = n(tc, 0, 2)
+	v.t = 1
+	return v
+}
+
+// codecKeys is the set of keys the library's documented omitempty rule
+// keeps: a field is omitted iff it is the zero value of its type (the
+// unsafe implementation compares memory; RecursiveEmptyCheck descends
+// pointers and interfaces).
+func codecKeys(v Tagged, recursive bool) map[string]bool {
+	keys := map[string]bool{"m": true, "renamed_r": true, "Z1": true, "S": true, "-": true}
+	zero := func(x any) bool {
+		if x == nil {
+			return true
+		}
+		rv := reflect.ValueOf(x)
+		if recursive {
+			for rv.Kind() == reflect.Ptr || rv.Kind() == reflect.Interface {
+				if rv.IsNil() {
+					return true
+				}
+				rv = rv.Elem()
+			}
+			if rv.Kind() == reflect.Slice || rv.Kind() == reflect.Map {
+				return rv.Len() == 0
+			}
+		}
+		return rv.IsZero()
+	}
+	if !zero(v.A) {
+		keys["a"] = true
+	}
+	if !zero(v.B) {
+		keys["b"] = true
+	}
+	if !zero(v.C) {
+		keys["c"] = true
+	}
+	if !zero(v.D) {
+		keys["d"] = true
+	}
+	if !zero(v.E) {
+		keys["e"] = true
+	}
+	if !zero(v.F) {
+		keys["f"] = true
+	}
+	if !zero(v.G) {
+		keys["g"] = true
+	}
+	if v.H != nil && (!recursive || !zero(v.H)) { // a non-nil interface is not empty unless the check descends
+		keys["h"] = true
+	}
+	if !zero(v.I) {
+		keys["i"] = true
+	}
+	if !zero(v.J) {
+		keys["j"] = true
+	}
+	if !zero(v.N) {
+		keys["n"] = true
+	}
+	if !zero(v.O) {
+		keys["o"] = true
+	}
+	if !zero(v.Pp) {
+		keys["pp"] = true
+	}
+	if !zero(v.Q) {
+		keys["Q"] = true
+	}
+	if !zero(v.Z2) {
+		keys["z2"] = true
+	}
+	return keys
+}
+
+func TestHegelStructTagsMatchEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		v := genTagged(tc, Known.omitEmptyByPointer)
+		h := &codec.JsonHandle{MapKeyAsString: true}
+		h.Canonical = true
+		h.RecursiveEmptyCheck = chance(tc, 30)
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		enc, err := encodeWith(h, v, false)
+		if err != nil {
+			fail(ht, "encode: %v", err)
+		}
+		ref, _ := json.Marshal(v)
+		var cm, rm map[string]json.RawMessage
+		if err := json.Unmarshal(enc, &cm); err != nil {
+			fail(ht, "codec output is not an object: %v\n%s", err, enc)
+		}
+		_ = json.Unmarshal(ref, &rm)
+		want := codecKeys(v, h.RecursiveEmptyCheck)
+		for k := range cm {
+			if !want[k] {
+				fail(ht, "key %q present but the zero-value rule omits it (recursive=%v)\nvalue %+v\ncodec %s\nejson %s", k, h.RecursiveEmptyCheck, v, enc, ref)
+			}
+		}
+		for k := range want {
+			if _, ok := cm[k]; !ok {
+				fail(ht, "key %q missing (recursive=%v)\nvalue %+v\ncodec %s\nejson %s", k, h.RecursiveEmptyCheck, v, enc, ref)
+			}
+		}
+		// values of the keys both emit agree
+		for k, cv := range cm {
+			rv, ok := rm[k]
+			if !ok {
+				continue
+			}
+			at, _ := jsonTokens(cv)
+			bt, _ := jsonTokens(rv)
+			if ok, why := sameTokens(at, bt); !ok {
+				fail(ht, "key %q: %s\ncodec %s\nejson %s", k, why, cv, rv)
+			}
+		}
+		// encoding/json's text decodes into the same struct (the drop-in claim)
+		var back Tagged
+		if err := decodeWith(h, ref, &back, false); err != nil {
+			fail(ht, "decode encoding/json text: %v\n%s", err, ref)
+		}
+		exp := v
+		exp.K, exp.t = 0, 0
+		if exp.C != nil && len(exp.C) == 0 {
+			exp.C = nil
+		}
+		if exp.D != nil && len(exp.D) == 0 {
+			exp.D = nil
+		}
+		if exp.N != nil && len(exp.N) == 0 {
+			exp.N = nil
+		}
+		if back.C != nil && len(back.C) == 0 {
+			back.C = nil
+		}
+		if back.D != nil && len(back.D) == 0 {
+			back.D = nil
+		}
+		if back.N != nil && len(back.N) == 0 {
+			back.N = nil
+		}
+		// interface values come back as encoding/json would type them
+		if exp.H != nil {
+			exp.H = canon(exp.H, false)
+			back.H = canon(back.H, false)
+			if !eqTree(exp.H, back.H) {
+				fail(ht, "H: %#v vs %#v\n%s", exp.H, back.H, ref)
+			}
+			exp.H, back.H = nil, nil
+		}
+		if !reflect.DeepEqual(exp, back) {
+			fail(ht, "decoding encoding/json's text differs\nwant %+v\ngot  %+v\njson %s", exp, back, ref)
+		}
+	})
+}
