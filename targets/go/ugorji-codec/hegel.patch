+func TestHegelStructTagsMatchEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tagsCases)
+		v := c.v
+		h := &codec.JsonHandle{MapKeyAsString: true}
+		h.Canonical = true
+		h.RecursiveEmptyCheck = c.recursive
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		enc, err := encodeWith(h, v, false)
+		if err != nil {
+			fail(ht, "encode: %v", err)
+		}
+		ref, _ := json.Marshal(v)
+		var cm, rm map[string]json.RawMessage
+		if err := json.Unmarshal(enc, &cm); err != nil {
+			fail(ht, "codec output is not an object: %v\n%s", err, enc)
+		}
+		_ = json.Unmarshal(ref, &rm)
+		want := codecKeys(v, h.RecursiveEmptyCheck)
+		for k := range cm {
+			if !want[k] {
+				fail(ht, "key %q present but the zero-value rule omits it (recursive=%v)\nvalue %+v\ncodec %s\nejson %s", k, h.RecursiveEmptyCheck, v, enc, ref)
+			}
+		}
+		for k := range want {
+			if _, ok := cm[k]; !ok {
+				fail(ht, "key %q missing (recursive=%v)\nvalue %+v\ncodec %s\nejson %s", k, h.RecursiveEmptyCheck, v, enc, ref)
+			}
+		}
+		// values of the keys both emit agree
+		for k, cv := range cm {
+			rv, ok := rm[k]
+			if !ok {
+				continue
+			}
+			at, _ := jsonTokens(cv)
+			bt, _ := jsonTokens(rv)
+			if ok, why := sameTokens(at, bt); !ok {
+				fail(ht, "key %q: %s\ncodec %s\nejson %s", k, why, cv, rv)
+			}
+		}
+		// encoding/json's text decodes into the same struct (the drop-in claim)
+		var back Tagged
+		if err := decodeWith(h, ref, &back, false); err != nil {
+			fail(ht, "decode encoding/json text: %v\n%s", err, ref)
+		}
+		exp := v
+		exp.K, exp.t = 0, 0
+		if exp.C != nil && len(exp.C) == 0 {
+			exp.C = nil
+		}
+		if exp.D != nil && len(exp.D) == 0 {
+			exp.D = nil
+		}
+		if exp.N != nil && len(exp.N) == 0 {
+			exp.N = nil
+		}
+		if back.C != nil && len(back.C) == 0 {
+			back.C = nil
+		}
+		if back.D != nil && len(back.D) == 0 {
+			back.D = nil
+		}
+		if back.N != nil && len(back.N) == 0 {
+			back.N = nil
+		}
+		// interface values come back as encoding/json would type them
+		if exp.H != nil {
+			exp.H = canon(exp.H, false)
+			back.H = canon(back.H, false)
+			if !eqTree(exp.H, back.H) {
+				fail(ht, "H: %#v vs %#v\n%s", exp.H, back.H, ref)
+			}
+			exp.H, back.H = nil, nil
+		}
+		if !reflect.DeepEqual(exp, back) {
+			fail(ht, "decoding encoding/json's text differs\nwant %+v\ngot  %+v\njson %s", exp, back, ref)
+		}
+	})
+}
