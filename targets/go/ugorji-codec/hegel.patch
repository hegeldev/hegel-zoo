+// codecKeys is the set of keys the library's documented omitempty rule
+// keeps: a field is omitted iff it is the zero value of its type (the
+// unsafe implementation compares memory; RecursiveEmptyCheck descends
+// pointers and interfaces).
+func codecKeys(v Tagged, recursive bool) map[string]bool {
+	keys := map[string]bool{"m": true, "renamed_r": true, "Z1": true, "S": true, "-": true}
+	zero := func(x any) bool {
+		if x == nil {
+			return true
+		}
+		rv := reflect.ValueOf(x)
+		if recursive {
+			for rv.Kind() == reflect.Ptr || rv.Kind() == reflect.Interface {
+				if rv.IsNil() {
+					return true
+				}
+				rv = rv.Elem()
+			}
+			if rv.Kind() == reflect.Slice || rv.Kind() == reflect.Map {
+				return rv.Len() == 0
+			}
+		}
+		return rv.IsZero()
+	}
+	if !zero(v.A) {
+		keys["a"] = true
+	}
+	if !zero(v.B) {
+		keys["b"] = true
+	}
+	if !zero(v.C) {
+		keys["c"] = true
+	}
+	if !zero(v.D) {
+		keys["d"] = true
+	}
+	if !zero(v.E) {
+		keys["e"] = true
+	}
+	if !zero(v.F) {
+		keys["f"] = true
+	}
+	if !zero(v.G) {
+		keys["g"] = true
+	}
+	if v.H != nil && (!recursive || !zero(v.H)) { // a non-nil interface is not empty unless the check descends
+		keys["h"] = true
+	}
+	if !zero(v.I) {
+		keys["i"] = true
+	}
+	if !zero(v.J) {
+		keys["j"] = true
+	}
+	if !zero(v.N) {
+		keys["n"] = true
+	}
+	if !zero(v.O) {
+		keys["o"] = true
+	}
+	if !zero(v.Pp) {
+		keys["pp"] = true
+	}
+	if !zero(v.Q) {
+		keys["Q"] = true
+	}
+	if !zero(v.Z2) {
+		keys["z2"] = true
+	}
+	return keys
+}
