new file mode 100644
index 0000000..0f78daf
--- /dev/null
+++ b/codec/hegel_test.go
@@ -0,0 +1,120 @@
+package codec_test
+
+// Hegel properties for github.com/ugorji/go/codec: the five formats
+// (msgpack, CBOR, JSON, binc, simple) against independent oracles —
+// encoding/json for JSON, hand-written model encoders for the msgpack and
+// CBOR wire formats — and against the library's own round trips over typed
+// and untyped Go values under randomised handle options.
+//
+// No external tool is needed.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	omitEmptyByPointer   bool // ugorji-codec/1: omitempty compares memory, so a zero-length string with a non-nil data pointer is emitted
+	cborNegativeOverflow bool // ugorji-codec/2: CBOR negative integers below int64 wrap instead of erroring
+	jsonIntOverflow      bool // ugorji-codec/3: a JSON integer below int64 (or above it with SignedInteger) is an error while one above uint64 becomes a float64
+	nilBytesAsArray      bool // ugorji-codec/4: NilCollectionToZeroLength writes a nil []byte as an empty array, not as empty bytes
+	cborTimeRounded      bool // ugorji-codec/5: the CBOR decoder rounds every time to the microsecond, though TimeRFC3339 writes nanoseconds
+	bincNegativeZero     bool // ugorji-codec/6: binc writes -0.0 as +0.0
+	signedIntegerWraps   bool // ugorji-codec/7: SignedInteger turns unsigned values in [2^63, 2^64) into negative int64
+	mapKeyMisread        bool // ugorji-codec/8: a non-string map key decoded into a string-keyed map is read as a string header (CBOR, simple), misaligning the stream
+	bincNegativePrune    bool // ugorji-codec/9: binc drops the leading 0xFF of a 4-byte negative magnitude as sign extension: -4294967295..-4286578688 change value
+}{omitEmptyByPointer: true, cborNegativeOverflow: true, jsonIntOverflow: true, nilBytesAsArray: true, cborTimeRounded: true, bincNegativeZero: true, signedIntegerWraps: true, mapKeyMisread: true, bincNegativePrune: true}
