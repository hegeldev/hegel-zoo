+func TestHegelMsgpackWireMatchesModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		st := mpStyle{WriteExt: chance(tc, 60), PosUnsigned: chance(tc, 30), NoFixed: chance(tc, 20)}
+		h := &codec.MsgpackHandle{WriteExt: st.WriteExt, PositiveIntUnsigned: st.PosUnsigned, NoFixedNum: st.NoFixed}
+		h.Canonical = true
+		h.OptimumSize = chance(tc, 30)
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		h.RawToString = !st.WriteExt
+		tr := genTree(tc, treeOpts{specials: true, bytes: true, maxDepth: 3})
+		note(ht, "style %+v", st)
+		enc, err := encodeWith(h, tr, false)
+		if err != nil {
+			fail(ht, "encode: %v\ntree %s", err, treeString(tr))
+		}
+		want := mpEncode(tr, st)
+		if !bytes.Equal(enc, want) {
+			fail(ht, "msgpack bytes differ from the model (style %+v)\ntree  %s\ncodec %s\nmodel %s", st, treeString(tr), hx(enc), hx(want))
+		}
+		got, k, err := mpDecode(enc)
+		if err != nil || k != len(enc) {
+			fail(ht, "model cannot decode the library's bytes: %v (%d of %d)\ntree %s\nbytes %s", err, k, len(enc), treeString(tr), hx(enc))
+		}
+		if !eqTree(canon(tr, !st.WriteExt), canon(got, !st.WriteExt)) {
+			fail(ht, "model decode of the library's bytes differs\ntree %s\ngot  %s\nbytes %s", treeString(tr), treeString(got), hx(enc))
+		}
+		// every spec form the model can write must decode (new-spec handle)
+		tr2 := genTree(tc, treeOpts{specials: true, bytes: true, times: true, maxDepth: 3})
+		loose := mpEncodeLoose(tc, tr2)
+		h2 := &codec.MsgpackHandle{WriteExt: true}
+		h2.MapType = reflect.TypeOf(map[string]any(nil))
+		var got2 any
+		if err := decodeWith(h2, loose, &got2, chance(tc, 30)); err != nil {
+			fail(ht, "decode of spec-form bytes: %v\ntree %s\nbytes %s", err, treeString(tr2), hx(loose))
+		}
+		if !eqTree(canon(tr2, false), canon(got2, false)) {
+			fail(ht, "decode of spec-form bytes differs\ntree %s\ngot  %s\nbytes %s", treeString(tr2), treeString(got2), hx(loose))
+		}
+		// and the library's own encoding of a tree with times model-decodes
+		enc3, err := encodeWith(h2, tr2, false)
+		if err != nil {
+			fail(ht, "encode with times: %v", err)
+		}
+		got3, k3, err := mpDecode(enc3)
+		if err != nil || k3 != len(enc3) {
+			fail(ht, "model cannot decode the library's bytes (times): %v (%d of %d)\ntree %s\nbytes %s", err, k3, len(enc3), treeString(tr2), hx(enc3))
+		}
+		if !eqTree(canon(tr2, false), canon(got3, false)) {
+			fail(ht, "model decode (times) differs\ntree %s\ngot  %s\nbytes %s", treeString(tr2), treeString(got3), hx(enc3))
+		}
+	})
+}
