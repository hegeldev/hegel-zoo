+// ---------------------------------------------------------------------------
+// 5. JSON against encoding/json: output tokens (and bytes, when no float is
+// involved), and decoding of encoding/json's output under re-escaping and
+// whitespace.
+
+type jtok struct {
+	kind byte // '{', '}', '[', ']', 's', 'n', 'b', '0'
+	s    string
+	num  *big.Float
+	b    bool
+}
+
+func jsonTokens(b []byte) ([]jtok, error) {
+	dec := json.NewDecoder(bytes.NewReader(b))
+	dec.UseNumber()
+	var out []jtok
+	for {
+		t, err := dec.Token()
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return nil, err
+		}
+		switch x := t.(type) {
+		case json.Delim:
+			out = append(out, jtok{kind: byte(x)})
+		case string:
+			out = append(out, jtok{kind: 's', s: x})
+		case json.Number:
+			f, _, err := big.ParseFloat(string(x), 10, 200, big.ToNearestEven)
+			if err != nil {
+				return nil, err
+			}
+			out = append(out, jtok{kind: '0', num: f, s: string(x)})
+		case bool:
+			out = append(out, jtok{kind: 'b', b: x})
+		case nil:
+			out = append(out, jtok{kind: 'n'})
+		}
+	}
+}
+
+func sameTokens(a, b []jtok) (bool, string) {
+	if len(a) != len(b) {
+		return false, fmt.Sprintf("%d vs %d tokens", len(a), len(b))
+	}
+	for i := range a {
+		x, y := a[i], b[i]
+		if x.kind != y.kind || x.s != y.s && x.kind == 's' || x.b != y.b {
+			return false, fmt.Sprintf("token %d: %+v vs %+v", i, x, y)
+		}
+		if x.kind == '0' && x.num.Cmp(y.num) != 0 {
+			return false, fmt.Sprintf("token %d: number %s vs %s", i, x.s, y.s)
+		}
+	}
+	return true, ""
+}
+
+func hasFloat(v any) bool {
+	switch x := v.(type) {
+	case float64:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasFloat(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasFloat(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+var jsonSpaces = []string{" ", "\n", "\t", "\r", "  \n"}
+
+// jsonMutate rewrites a JSON text keeping its value, as the tape says:
+// whitespace around a delimiter one time in five, a \u escape for a
+// character (a surrogate pair above the BMP) three times in twenty, \/ for
+// a slash half of the time. An empty tape leaves the text as it is.
+func jsonMutate(src []byte, t *tape) []byte {
+	var out []byte
+	ws := func() {
+		if t.coin(20) {
+			out = append(out, jsonSpaces[t.next(len(jsonSpaces))]...)
+		}
+	}
+	i := 0
+	for i < len(src) {
+		c := src[i]
+		switch c {
+		case '"':
+			// copy the string, re-escaping
+			out = append(out, '"')
+			i++
+			for i < len(src) {
+				c := src[i]
+				if c == '\\' {
+					out = append(out, src[i], src[i+1])
+					i += 2
+					if src[i-1] == 'u' {
+						out = append(out, src[i:i+4]...)
+						i += 4
+					}
+					continue
+				}
+				if c == '"' {
+					out = append(out, '"')
+					i++
+					break
+				}
+				r, size := rune(c), 1
+				if c >= 0x80 {
+					r, size = decodeRune(src[i:])
+				}
+				switch {
+				case c == '/' && t.coin(50):
+					out = append(out, '\\', '/')
+				case t.coin(15):
+					if r >= 0x10000 {
+						r -= 0x10000
+						hi, lo := 0xd800+(r>>10), 0xdc00+(r&0x3ff)
+						out = append(out, fmt.Sprintf("\\u%04x\\u%04X", hi, lo)...)
+					} else {
+						out = append(out, fmt.Sprintf("\\u%04X", r)...)
+					}
+				default:
+					out = append(out, src[i:i+size]...)
+				}
+				i += size
+			}
+		case '{', '}', '[', ']', ',', ':':
+			ws()
+			out = append(out, c)
+			ws()
+			i++
+		default:
+			out = append(out, c)
+			i++
+		}
+	}
+	return out
+}
+
+func decodeRune(b []byte) (rune, int) {
+	r, size := rune(b[0]), 1
+	for _, rr := range string(b) {
+		r = rr
+		size = len(string(rr))
+		break
+	}
+	return r, size
+}
+
+// bigSigns: the sign of an integer text beyond the 64-bit ranges. With
+// ugorji-codec/3 open only positive: a negative one below int64 is the bug.
+var bigSigns = func() hegel.Generator[bool] {
+	if Known.jsonIntOverflow {
+		return hegel.Just(false)
+	}
+	return chance(50)
+}()
+
+// numberTexts: the decimal text of an int64, of a uint64, of a float64, of
+// an integer beyond the 64-bit ranges, an integer with a fraction, or a
+// mantissa with an exponent.
+var numberTexts = weighted(
+	choice[string]{1, hegel.Map(ints, func(i int64) string { return strconv.FormatInt(i, 10) })},
+	choice[string]{1, hegel.Map(uints, func(u uint64) string { return strconv.FormatUint(u, 10) })},
+	choice[string]{1, hegel.Map(plainFloats, func(f float64) string { return strconv.FormatFloat(f, 'g', -1, 64) })},
+	choice[string]{1, hegel.Map(pairs(uints, bigSigns), func(p pair[uint64, bool]) string {
+		x := new(big.Int).SetUint64(p.a)
+		x.Add(x, new(big.Int).SetUint64(1<<63))
+		if p.b {
+			x.Neg(x)
+		}
+		return x.String()
+	})},
+	choice[string]{1, hegel.Map(pairs(ints, hegel.Integers(0, 999)), func(p pair[int64, int]) string { return fmt.Sprintf("%d.%d", p.a, p.b) })},
+	choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+		return fmt.Sprintf("%dE%s%d", hegel.Draw(tc, hegel.Integers(-999, 999)), hegel.Draw(tc, hegel.SampledFrom([]string{"", "+", "-"})), hegel.Draw(tc, hegel.Integers(0, 30)))
+	})},
+)
+
+// jsonCase: a tree (with []byte leaves half of the time), the encoder's
+// options and writer switch, the tape of the mutation of encoding/json's
+// text, the decoder's PreferFloat and reader switch, and a number text.
+type jsonCase struct {
+	tr               any
+	htmlAsIs, termWS bool
+	indent           int8
+	viaW             bool
+	mutation         []int
+	preferFloat      bool
+	viaR             bool
+	number           string
+}
+
+func (c jsonCase) GoString() string {
+	return fmt.Sprintf("HTMLCharsAsIs=%v TermWhitespace=%v Indent=%d writer=%v PreferFloat=%v reader=%v number %s\ntree %s\ntape %v", c.htmlAsIs, c.termWS, c.indent, c.viaW, c.preferFloat, c.viaR, c.number, treeString(c.tr), c.mutation)
+}
+
+var (
+	jsonTrees = hegel.OneOf(trees(treeOpts{maxDepth: 3}), trees(treeOpts{bytes: true, maxDepth: 3}))
+	jsonCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+		return jsonCase{
+			tr:          hegel.Draw(tc, jsonTrees),
+			htmlAsIs:    hegel.Draw(tc, chance(30)),
+			termWS:      hegel.Draw(tc, chance(20)),
+			indent:      hegel.Draw(tc, maybe(30, hegel.SampledFrom([]int8{1, 2, 4, -1}))),
+			viaW:        hegel.Draw(tc, chance(30)),
+			mutation:    hegel.Draw(tc, tapes),
+			preferFloat: hegel.Draw(tc, chance(20)),
+			viaR:        hegel.Draw(tc, chance(30)),
+			number:      hegel.Draw(tc, numberTexts),
+		}
+	})
+)
+
+func TestHegelJsonMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, jsonCases)
+		tr := c.tr
+		if Known.jsonIntOverflow {
+			tr = capInts(tr, false) // an integral float below -2^63 is written as an integer literal the library cannot read back
+		}
+		h := &codec.JsonHandle{HTMLCharsAsIs: c.htmlAsIs, TermWhitespace: c.termWS, MapKeyAsString: true, Indent: c.indent}
+		h.Canonical = true
+		h.MapType = reflect.TypeOf(map[string]any(nil))
+		enc, err := encodeWith(h, tr, c.viaW)
+		if err != nil {
+			fail(ht, "encode: %v\ntree %s", err, treeString(tr))
+		}
+		if !json.Valid(enc) {
+			fail(ht, "codec JSON is invalid\ntree %s\njson %q", treeString(tr), enc)
+		}
+		var ebuf bytes.Buffer
+		e := json.NewEncoder(&ebuf)
+		e.SetEscapeHTML(!h.HTMLCharsAsIs)
+		if err := e.Encode(tr); err != nil {
+			fail(ht, "encoding/json: %v", err)
+		}
+		ref := bytes.TrimSuffix(ebuf.Bytes(), []byte("\n"))
+		at, err := jsonTokens(enc)
+		if err != nil {
+			fail(ht, "tokenise codec output: %v\n%q", err, enc)
+		}
+		bt, _ := jsonTokens(ref)
+		if ok, why := sameTokens(at, bt); !ok {
+			fail(ht, "codec JSON differs from encoding/json: %s\ntree  %s\ncodec %q\nejson %q", why, treeString(tr), enc, ref)
+		}
+		if h.Indent == 0 && !h.TermWhitespace && !hasFloat(tr) && !bytes.Equal(enc, ref) {
+			fail(ht, "codec JSON bytes differ from encoding/json\ntree  %s\ncodec %q\nejson %q", treeString(tr), enc, ref)
+		}
+		// encoding/json reads codec's output back to the tree
+		var back any
+		if err := json.Unmarshal(enc, &back); err != nil {
+			fail(ht, "encoding/json cannot read codec output: %v\n%q", err, enc)
+		}
+		var viaRef any
+		_ = json.Unmarshal(ref, &viaRef)
+		if !eqTree(back, viaRef) {
+			fail(ht, "encoding/json reads codec output differently\ncodec %q\nejson %q", enc, ref)
+		}
+		// codec reads encoding/json's output (mutated) back to the tree
+		mut := jsonMutate(ref, &tape{vals: c.mutation})
+		if !json.Valid(mut) {
+			fail(ht, "internal: mutation broke the JSON %q -> %q", ref, mut)
+		}
+		h2 := &codec.JsonHandle{MapKeyAsString: true, PreferFloat: c.preferFloat}
+		h2.MapType = reflect.TypeOf(map[string]any(nil))
+		var got any
+		if err := decodeWith(h2, mut, &got, c.viaR); err != nil {
+			fail(ht, "codec cannot decode encoding/json output: %v\ntree %s\njson %q", err, treeString(tr), mut)
+		}
+		want := refDecode(ref, h2.PreferFloat)
+		if !eqTree(want, canon(got, false)) {
+			fail(ht, "codec decodes encoding/json output differently\ntree %s\ngot  %s\njson %q", treeString(want), treeString(got), mut)
+		}
+		// number texts: any JSON number decodes into interface{} as the
+		// nearest int64/uint64 or a float64, and into float64 exactly like
+		// strconv
+		numText := c.number
+		var gotN any
+		errN := decodeWith(h2, []byte(numText), &gotN, false)
+		f, ferr := strconv.ParseFloat(numText, 64)
+		// out of range for float64: an error is fine either way (no drawn
+		// text is; measured 0 in 3000)
+		ht.Assume(ferr == nil)
+		bigN, _, _ := big.ParseFloat(numText, 10, 200, big.ToNearestEven)
+		if Known.jsonIntOverflow && bigN.Cmp(new(big.Float).SetInt64(math.MinInt64)) < 0 && !strings.ContainsAny(numText, ".eE") {
+			// an integer literal below int64 is the bug's shape; the texts
+			// beyond the 64-bit ranges are drawn positive while it is open
+			count(ht, "known ugorji-codec/3")
+			ht.Assume(false)
+		}
+		if errN != nil {
+			fail(ht, "number %q: %v", numText, errN)
+		}
+		gotF, _ := toBig(gotN)
+		switch gotN.(type) {
+		case int64, uint64:
+			if gotF.Cmp(bigN) != 0 {
+				fail(ht, "number %q decoded as %T %v", numText, gotN, gotN)
+			}
+		case float64:
+			if gotN.(float64) != f {
+				fail(ht, "number %q decoded as float64 %v, strconv says %v", numText, gotN, f)
+			}
+		default:
+			fail(ht, "number %q decoded as %T %v", numText, gotN, gotN)
+		}
+		var gotFloat float64
+		if err := decodeWith(h2, []byte(numText), &gotFloat, false); err != nil {
+			fail(ht, "number %q into float64: %v", numText, err)
+		}
+		if gotFloat != f {
+			fail(ht, "number %q into float64: %v, strconv says %v", numText, gotFloat, f)
+		}
+	})
+}
+
+func hasBytes(v any) bool {
+	switch x := v.(type) {
+	case []byte:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasBytes(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasBytes(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func bytesToBase64(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		b, _ := json.Marshal(x)
+		var s string
+		_ = json.Unmarshal(b, &s)
+		return s
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = bytesToBase64(x[i])
+		}
+		return out
+	case map[string]any:
+		out := map[string]any{}
+		for k, e := range x {
+			out[k] = bytesToBase64(e)
+		}
+		return out
+	}
+	return v
+}
