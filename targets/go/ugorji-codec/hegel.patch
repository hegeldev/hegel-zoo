+// ---------------------------------------------------------------------------
+// 6. Struct tags and omitempty against encoding/json (the json: tag is
+// honoured, the README calls the handle a drop-in replacement) and against
+// the library's documented rule (omitted iff the zero value).
+
+type Tagged struct {
+	A  int            `json:"a,omitempty"`
+	B  string         `json:"b,omitempty"`
+	C  []int          `json:"c,omitempty"`
+	D  map[string]int `json:"d,omitempty"`
+	E  *int           `json:"e,omitempty"`
+	F  bool           `json:"f,omitempty"`
+	G  float64        `json:"g,omitempty"`
+	H  any            `json:"h,omitempty"`
+	I  Inner          `json:"i,omitempty"`
+	J  [2]int         `json:"j,omitempty"`
+	K  int            `json:"-"`
+	L  int            `json:"-,"`
+	M  string         `json:"m"`
+	N  []byte         `json:"n,omitempty"`
+	O  uint8          `json:"o,omitempty"`
+	Pp *Inner         `json:"pp,omitempty"`
+	Q  int            `json:",omitempty"`
+	R  string         `json:"renamed_r"`
+	Inner2
+	S int
+	t int
+}
+
+type Inner struct {
+	X int    `json:"x,omitempty"`
+	Y string `json:"y"`
+}
+
+type Inner2 struct {
+	Z1 int
+	Z2 string `json:"z2,omitempty"`
+}
+
+// omitStrings: the strings of an omitempty field. With ugorji-codec/1 open
+// never an empty string made at run time (the zero value left untouched is
+// the only empty string the library omits): "" becomes "x".
+func omitStrings(maxLen int) hegel.Generator[string] {
+	if !Known.omitEmptyByPointer {
+		return strs(maxLen)
+	}
+	return hegel.Map(strs(maxLen), func(s string) string {
+		if s == "" {
+			return "x"
+		}
+		return s
+	})
+}
+
+var (
+	// The optional collections of a Tagged: nil, empty but not nil, or one
+	// element (35, 30 and 35 in a hundred).
+	intSlices = weighted(
+		choice[[]int]{35, hegel.Just[[]int](nil)},
+		choice[[]int]{30, hegel.Just([]int{})},
+		choice[[]int]{35, hegel.Map(hegel.Integers(0, 9), func(x int) []int { return []int{x} })},
+	)
+	intMaps = weighted(
+		choice[map[string]int]{35, hegel.Just[map[string]int](nil)},
+		choice[map[string]int]{30, hegel.Just(map[string]int{})},
+		choice[map[string]int]{35, hegel.Map(hegel.Integers(0, 9), func(x int) map[string]int { return map[string]int{"k": x} })},
+	)
+	byteSlices = weighted(
+		choice[[]byte]{35, hegel.Just[[]byte](nil)},
+		choice[[]byte]{30, hegel.Just([]byte{})},
+		choice[[]byte]{35, hegel.Just([]byte{1})},
+	)
+	// anyLeaves: the interface field, nil half of the time.
+	anyLeaves = maybe(50, hegel.SampledFrom([]any{0, "", 1, "s", []any{}, nil, false}))
+	// nonZeroFloats: a plain float, never zero (the field is omitempty).
+	nonZeroFloats = hegel.Map(plainFloats, func(f float64) float64 {
+		if f == 0 {
+			return 1
+		}
+		return f
+	})
+	// arrayCells: one cell of the [2]int set half of the time.
