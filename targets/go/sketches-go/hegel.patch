diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..f81aef3
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,418 @@
+package hegel
+
+import (
+	"fmt"
+	"math"
+	"sort"
+
+	"github.com/DataDog/sketches-go/ddsketch"
+	"github.com/DataDog/sketches-go/ddsketch/mapping"
+	"github.com/DataDog/sketches-go/ddsketch/store"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- mappings
+
+var mappingKinds = []string{"log", "linear", "cubic"}
+
+// newMapping builds a mapping of the kind with the relative accuracy (or, when withGamma,
+// from gamma and an index offset).
+func newMapping(kind string, alpha float64) mapping.IndexMapping {
+	var m mapping.IndexMapping
+	var err error
+	switch kind {
+	case "log":
+		m, err = mapping.NewLogarithmicMapping(alpha)
+	case "linear":
+		m, err = mapping.NewLinearlyInterpolatedMapping(alpha)
+	default:
+		m, err = mapping.NewCubicallyInterpolatedMapping(alpha)
+	}
+	if err != nil {
+		panic(fmt.Sprintf("mapping %s %g: %v", kind, alpha, err))
+	}
+	return m
+}
+
+func newMappingWithGamma(kind string, gamma, offset float64) (mapping.IndexMapping, error) {
+	switch kind {
+	case "log":
+		return mapping.NewLogarithmicMappingWithGamma(gamma, offset)
+	case "linear":
+		return mapping.NewLinearlyInterpolatedMappingWithGamma(gamma, offset)
+	default:
+		return mapping.NewCubicallyInterpolatedMappingWithGamma(gamma, offset)
+	}
+}
+
+// genAlpha draws a relative accuracy in (0, 1), favouring the usual small ones.
+func genAlpha(ht *hegel.T) float64 {
+	switch drawInt(ht, 1, 10) {
+	case 1:
+		return pick(ht, []float64{0.001, 0.005, 0.02, 0.5, 0.9, 0.99})
+	case 2:
+		return float64(drawInt(ht, 1, 999)) / 1000
+	default:
+		return float64(drawInt(ht, 1, 200)) / 1000
+	}
+}
+
+// genMappingSpec draws a kind and accuracy; the mapping is built by the caller.
+func genMappingSpec(ht *hegel.T) (string, float64) {
+	return pick(ht, mappingKinds), genAlpha(ht)
+}
+
+// --------------------------------------------------------------------------- stores
+
+// storeSpec names a store type; collapsing ones carry their bin limit.
+type storeSpec struct {
+	kind string
+	m    int
+}
+
+func (s storeSpec) String() string {
+	if s.m > 0 {
+		return fmt.Sprintf("%s(%d)", s.kind, s.m)
+	}
+	return s.kind
+}
+
+func (s storeSpec) collapsing() bool { return s.kind == "lowest" || s.kind == "highest" }
+
+func (s storeSpec) provider() store.Provider {
+	switch s.kind {
+	case "dense":
+		return store.DenseStoreConstructor
+	case "sparse":
+		return store.SparseStoreConstructor
+	case "buffered":
+		return store.BufferedPaginatedStoreConstructor
+	case "lowest":
+		return func() store.Store { return store.NewCollapsingLowestDenseStore(s.m) }
+	default:
+		return func() store.Store { return store.NewCollapsingHighestDenseStore(s.m) }
+	}
+}
+
+func genStoreSpec(ht *hegel.T, allowCollapsing bool) storeSpec {
+	kinds := []string{"dense", "sparse", "buffered"}
+	if allowCollapsing {
+		kinds = append(kinds, "lowest", "highest")
+	}
+	k := pick(ht, kinds)
+	if k == "lowest" || k == "highest" {
+		m := drawInt(ht, 1, 64)
+		if chance(ht, 30) {
+			m = drawInt(ht, 1000, 100000)
+		}
+		return storeSpec{k, m}
+	}
+	return storeSpec{k, 0}
+}
+
+// --------------------------------------------------------------------------- values
+
+// genValue draws a value for a sketch: log-uniform magnitudes over many decades, zeros, values
+// below the indexable range (which land in the zero bucket), and a few enormous ones.
+func genValue(ht *hegel.T) float64 {
+	var v float64
+	switch drawInt(ht, 1, 20) {
+	case 1:
+		return 0
+	case 2:
+		v = pick(ht, []float64{1e-310, 5e-324, 1e-308, 2.2e-308, 3e-308})
+	case 3:
+		v = pick(ht, []float64{1e300, 1e307, 6e307, 1e308, 1.3e308, math.MaxFloat64})
+	case 4, 5, 6:
+		v = float64(drawInt(ht, 1, 1000))
+	default:
+		v = float64(drawInt(ht, 1000, 9999)) / 1000 * math.Pow(10, float64(drawInt(ht, -6, 6)))
+	}
+	if chance(ht, 40) {
+		v = -v
+	}
+	return v
+}
+
+// genCount draws a count: 1 mostly, small integers, or dyadic fractions (so that every sum
+// in the model and in the sketch is exact).
+func genCount(ht *hegel.T) float64 {
+	switch drawInt(ht, 1, 10) {
+	case 1, 2:
+		return float64(drawInt(ht, 2, 5))
+	case 3:
+		return pick(ht, []float64{0.5, 0.25, 1.5, 2.75})
+	default:
+		return 1
+	}
+}
+
+// --------------------------------------------------------------------------- the model
+
+// point is one addition to a sketch.
+type point struct{ v, c float64 }
+
+// sample is the exact content of a sketch: the points added, with the mapping's indexable
+// range (values within it in magnitude count as zero).
+type sample struct {
+	pts    []point
+	minIdx float64 // MinIndexableValue
+}
+
+func (s *sample) add(v, c float64) { s.pts = append(s.pts, point{v, c}) }
+
+// effective returns the value as the sketch stores it: zero when the magnitude is not above
+// the minimum indexable value.
+func (s *sample) effective(v float64) float64 {
+	if math.Abs(v) <= s.minIdx {
+		return 0
+	}
+	return v
+}
+
+func (s *sample) count() float64 {
+	var n float64
+	for _, p := range s.pts {
+		n += p.c
+	}
+	return n
+}
+
+func (s *sample) sum() float64 {
+	var n float64
+	for _, p := range s.pts {
+		n += s.effective(p.v) * p.c
+	}
+	return n
+}
+
+// parts splits the sample as the sketch does: negative magnitudes, zero count, positives.
+func (s *sample) parts() (negs []point, zero float64, poss []point) {
+	for _, p := range s.pts {
+		if p.c == 0 {
+			continue
+		}
+		v := s.effective(p.v)
+		switch {
+		case v < 0:
+			negs = append(negs, point{-v, p.c})
+		case v == 0:
+			zero += p.c
+		default:
+			poss = append(poss, point{v, p.c})
+		}
+	}
+	sort.Slice(negs, func(i, j int) bool { return negs[i].v < negs[j].v })
+	sort.Slice(poss, func(i, j int) bool { return poss[i].v < poss[j].v })
+	return
+}
+
+// atRank is the first value (in the sorted points) whose cumulative count exceeds rank; the
+// last value when none does.
+func atRank(sorted []point, rank float64) float64 {
+	if len(sorted) == 0 {
+		return math.NaN()
+	}
+	var cum float64
+	for _, p := range sorted {
+		cum += p.c
+		if cum > rank {
+			return p.v
+		}
+	}
+	return sorted[len(sorted)-1].v
+}
+
+// quantile is the exact value the sketch approximates for q: the sketch's own rank rule
+// applied to the exact values.
+func (s *sample) quantile(q float64) float64 {
+	return s.atSketchRank(float64(q * (s.count() - 1)))
+}
+
+// atSketchRank is the sketch's rank rule applied to the exact values.
+func (s *sample) atSketchRank(rank float64) float64 {
+	negs, zero, poss := s.parts()
+	var negCount float64
+	for _, p := range negs {
+		negCount += p.c
+	}
+	switch {
+	case rank < negCount:
+		return -atRank(negs, negCount-1-rank)
+	case rank < negCount+zero:
+		return 0
+	default:
+		return atRank(poss, rank-zero-negCount)
+	}
+}
+
+func (s *sample) min() float64 {
+	negs, zero, poss := s.parts()
+	switch {
+	case len(negs) > 0:
+		return -negs[len(negs)-1].v
+	case zero > 0:
+		return 0
+	default:
+		return poss[0].v
+	}
+}
+
+func (s *sample) max() float64 {
+	negs, zero, poss := s.parts()
+	switch {
+	case len(poss) > 0:
+		return poss[len(poss)-1].v
+	case zero > 0:
+		return 0
+	default:
+		return -negs[0].v
+	}
+}
+
+// sameSign reports whether every effective value has the same sign (zeros allowed).
+func (s *sample) sameSign() bool {
+	negs, _, poss := s.parts()
+	return len(negs) == 0 || len(poss) == 0
+}
+
+// kept reports whether the exact quantile value v survives a collapsing store's collapse:
+// its index lies in the bins the store keeps. With the collapsing-lowest store the kept
+// bins of a store are [maxIndex - m + 1, maxIndex] once the index range exceeds m; with the
+// collapsing-highest one [minIndex, minIndex + m - 1].
+func (s *sample) kept(m mapping.IndexMapping, spec storeSpec, v float64) bool {
+	if !spec.collapsing() || v == 0 {
+		return true
+	}
+	negs, _, poss := s.parts()
+	pts := poss
+	if v < 0 {
+		pts = negs
+		v = -v
+	}
+	lo, hi := math.MaxInt32, math.MinInt32
+	for _, p := range pts {
+		i := m.Index(p.v)
+		lo = min(lo, i)
+		hi = max(hi, i)
+	}
+	if hi-lo+1 <= spec.m {
+		return true
+	}
+	i := m.Index(v)
+	if spec.kind == "lowest" {
+		return i >= hi-spec.m+1
+	}
+	return i <= lo+spec.m-1
+}
+
+// within reports |got - want| <= tol*|want| (with a little slop), and got == 0 when want is.
+func within(got, want, tol float64) bool {
+	if got == want {
+		return true // including overflowed sums, +-Inf on both sides
+	}
+	if want == 0 {
+		return false
+	}
+	return math.Abs(got-want) <= (tol+1e-9)*math.Abs(want)
+}
+
+// closeF is a relative float comparison for exact quantities computed in another order.
+func closeF(a, b float64) bool {
+	if a == b {
+		return true
+	}
+	return math.Abs(a-b) <= 1e-9*math.Max(math.Abs(a), math.Abs(b))
+}
+
+// --------------------------------------------------------------------------- building sketches
+
+// built is a sketch with its exact model.
+type built struct {
+	s     *ddsketch.DDSketch
+	m     mapping.IndexMapping
+	kind  string
+	alpha float64
+	spec  storeSpec
+	model *sample
+}
+
+func (b *built) String() string {
+	return fmt.Sprintf("DDSketch(%s alpha %g, %s, %d points)", b.kind, b.alpha, b.spec, len(b.model.pts))
+}
+
+// genSketch builds a sketch over a fresh mapping and store and fills it with n points.
+func genSketch(ht *hegel.T, allowCollapsing bool, n int) *built {
+	kind, alpha := genMappingSpec(ht)
+	spec := genStoreSpec(ht, allowCollapsing)
+	m := newMapping(kind, alpha)
+	b := &built{s: ddsketch.NewDDSketch(m, spec.provider()(), spec.provider()()), m: m, kind: kind, alpha: alpha, spec: spec, model: &sample{minIdx: m.MinIndexableValue()}}
+	fill(ht, b, n)
+	return b
+}
+
+// fill adds n points, recording the accepted ones in the model.
+func fill(ht *hegel.T, b *built, n int) {
+	for i := 0; i < n; i++ {
+		v := genValue(ht)
+		c := genCount(ht)
+		var err error
+		if c == 1 && chance(ht, 70) {
+			err = b.s.Add(v)
+		} else {
+			err = b.s.AddWithCount(v, c)
+		}
+		tooBig := math.Abs(v) > b.m.MaxIndexableValue()
+		if tooBig != (err != nil) {
+			ht.Fatalf("%s: Add(%g, %g): %v (max indexable %g)", b, v, c, err, b.m.MaxIndexableValue())
+		}
+		if err == nil {
+			b.model.add(v, c)
+		}
+	}
+}
+
+// genQuantile draws a quantile in [0, 1] with the ends over-represented.
+func genQuantile(ht *hegel.T) float64 {
+	switch drawInt(ht, 1, 6) {
+	case 1:
+		return pick(ht, []float64{0, 1, 0.5})
+	case 2:
+		return pick(ht, []float64{0.001, 0.999, 0.01, 0.99, 0.25, 0.75})
+	default:
+		return float64(drawInt(ht, 0, 10000)) / 10000
+	}
+}
+
+// topBinOverflows reports whether some value sits in a bin whose upper bound the mapping
+// cannot represent (LowerBound(i+1) infinite, or wrapped below LowerBound(i)).
+func (s *sample) topBinOverflows(m mapping.IndexMapping) bool {
+	for _, p := range s.pts {
+		v := math.Abs(s.effective(p.v))
+		if v == 0 || p.c == 0 {
+			continue
+		}
+		i := m.Index(v)
+		if hi := m.LowerBound(i + 1); math.IsInf(hi, 0) || math.IsNaN(hi) || hi < m.LowerBound(i) {
+			return true
+		}
+	}
+	return false
+}
+
+// leavesRange reports whether some value's old bin, scaled, reaches outside the new
+// mapping's indexable range.
+func (s *sample) leavesRange(old, nm mapping.IndexMapping, scale float64) bool {
+	for _, p := range s.pts {
+		v := math.Abs(s.effective(p.v))
+		if v == 0 || p.c == 0 {
+			continue
+		}
+		i := old.Index(v)
+		lo, hi := old.LowerBound(i)*scale, old.LowerBound(i+1)*scale
+		if lo < nm.MinIndexableValue() || hi > nm.MaxIndexableValue() {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..8a049ad
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,146 @@
+package hegel
+
+// Pins: one plain test per recorded bug (bugs.toml), asserting the documented behaviour.
+// Each fails while the bug exists and is listed in target.toml's [expected_failures].
+
+import (
+	"math"
+	"testing"
+
+	"github.com/DataDog/sketches-go/ddsketch"
+	"github.com/DataDog/sketches-go/ddsketch/mapping"
+	"github.com/DataDog/sketches-go/ddsketch/store"
+)
+
+// sketches-go/1: AddWithCount accepts a NaN count, which poisons the sketch (GetCount is
+// NaN, IsEmpty false, quantiles arbitrary) while ErrNegativeCount guards the other invalid
+// counts and stat.NewSummaryStatisticsFromData rejects a NaN count.
+func TestHegelPinNaNCountRejected(t *testing.T) {
+	s, _ := ddsketch.NewDefaultDDSketch(0.01)
+	s.Add(1)
+	if err := s.AddWithCount(2, math.NaN()); err == nil {
+		t.Fatalf("AddWithCount(2, NaN) accepted; GetCount() is now %g", s.GetCount())
+	}
+}
+
+// sketches-go/2: GetValueAtQuantile documents a non-nil error for an invalid quantile;
+// NaN is accepted and a value returned.
+func TestHegelPinNaNQuantileRejected(t *testing.T) {
+	s, _ := ddsketch.NewDefaultDDSketch(0.01)
+	s.Add(1)
+	s.Add(5)
+	if v, err := s.GetValueAtQuantile(math.NaN()); err == nil {
+		t.Fatalf("GetValueAtQuantile(NaN) = %g with no error", v)
+	}
+}
+
+// sketches-go/3: a sketch whose total count is below 1 (fractional counts) answers every
+// quantile from the empty negative store: -0 with a dense store, -(1 + alpha) with a sparse
+// one, although 5 is the only value it holds.
+func TestHegelPinFractionalCountQuantile(t *testing.T) {
+	m, _ := mapping.NewLogarithmicMapping(0.01)
+	for _, p := range []store.Provider{store.DenseStoreConstructor, store.SparseStoreConstructor, store.BufferedPaginatedStoreConstructor} {
+		s := ddsketch.NewDDSketch(m, p(), p())
+		s.AddWithCount(5, 0.5)
+		got, err := s.GetValueAtQuantile(1)
+		if err != nil || math.Abs(got-5) > 0.01*5 {
+			t.Errorf("%T: GetValueAtQuantile(1) of a sketch holding only 5 (count 0.5) = %g, %v", p(), got, err)
+		}
+	}
+}
+
+// sketches-go/4: ChangeMapping loses the count of a bin whose upper bound overflows the
+// float range (a value within a factor gamma of the maximum indexable value): the sketch
+// holding one value, the maximum indexable one, has count 0 (or NaN) afterwards.
+func TestHegelPinChangeMappingTopBin(t *testing.T) {
+	m, _ := mapping.NewLogarithmicMapping(0.5)
+	s := ddsketch.NewDDSketch(m, store.NewDenseStore(), store.NewDenseStore())
+	v := m.MaxIndexableValue()
+	if err := s.Add(v); err != nil {
+		t.Fatal(err)
+	}
+	m2, _ := mapping.NewLogarithmicMapping(0.3)
+	c := s.ChangeMapping(m2, store.NewDenseStore(), store.NewDenseStore(), 1)
+	if c.GetCount() != 1 {
+		t.Fatalf("ChangeMapping of a sketch holding %g (count 1): count %g", v, c.GetCount())
+	}
+}
+
+// sketches-go/5: the mapping constructors accept a NaN relative accuracy (and gamma), so
+// NewDefaultDDSketch(NaN) returns a sketch instead of an error.
+func TestHegelPinNaNAccuracyRejected(t *testing.T) {
+	if s, err := ddsketch.NewDefaultDDSketch(math.NaN()); err == nil {
+		t.Fatalf("NewDefaultDDSketch(NaN) returned a sketch (Index(1) = %d) and no error", s.Index(1))
+	}
+}
+
+// sketches-go/6: DecodeDDSketch is documented to decode an encoded
+// DDSketchWithExactSummaryStatistics (dropping the statistics); it skips 8 bytes for the
+// count block, which is a varfloat64, and fails on the desynchronised stream.
+func TestHegelPinDecodePlainFromExactSummary(t *testing.T) {
+	e, _ := ddsketch.NewDefaultDDSketchWithExactSummaryStatistics(0.01)
+	e.Add(1)
+	e.Add(2.5)
+	var b []byte
+	e.Encode(&b, false)
+	d, err := ddsketch.DecodeDDSketch(b, store.DefaultProvider, nil)
+	if err != nil || d.GetCount() != 2 {
+		t.Fatalf("DecodeDDSketch of an exact-summary encoding (count 2): %v, count %g", err, d.GetCount())
+	}
+}
+
+// sketches-go/7: store.FromProto, MergeWithProto and ddsketch.FromProto do not apply
+// MaxDecodeIndexRange (the guard against huge dense allocations from crafted payloads,
+// issue #85): with the limit set to 1024, a protobuf store spanning 5000 indexes is still
+// decoded into a dense store.
+func TestHegelPinFromProtoIndexRange(t *testing.T) {
+	saved := store.MaxDecodeIndexRange
+	store.MaxDecodeIndexRange = 1 << 10
+	defer func() { store.MaxDecodeIndexRange = saved }()
+	sp := store.NewSparseStore()
+	sp.Add(0)
+	sp.Add(5000)
+	s, _ := ddsketch.NewDefaultDDSketch(0.01)
+	pb := s.ToProto()
+	pb.PositiveValues = sp.ToProto()
+	if d, err := ddsketch.FromProto(pb); err == nil {
+		t.Fatalf("FromProto of a store spanning 5001 indexes with MaxDecodeIndexRange = 1024: no error (count %g)", d.GetCount())
+	}
+}
+
+// sketches-go/8: ChangeMapping with a scale factor that takes values below the new
+// mapping's indexable range panics with a dense target store (slice bounds out of range:
+// the scaled lower bound underflows to 0 and Index(0) is MinInt64).
+func TestHegelPinChangeMappingBelowRange(t *testing.T) {
+	m, _ := mapping.NewLogarithmicMapping(0.01)
+	s := ddsketch.NewDDSketch(m, store.NewDenseStore(), store.NewDenseStore())
+	s.Add(1e-300)
+	m2, _ := mapping.NewLogarithmicMapping(0.02)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("ChangeMapping(scale 1e-10) of a sketch holding 1e-300 panicked: %v", r)
+		}
+	}()
+	c := s.ChangeMapping(m2, store.NewDenseStore(), store.NewDenseStore(), 1e-10)
+	if c.GetCount() != 1 {
+		t.Fatalf("ChangeMapping(scale 1e-10) of a sketch holding 1e-300: count %g, want 1", c.GetCount())
+	}
+}
+
+// sketches-go/9: merging into an empty collapsing store another collapsing store of the same
+// type whose bins span more than the receiver's bin limit panics in shiftCounts.
+func TestHegelPinCollapsingMergeOfWideStore(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("CollapsingLowestDenseStore(2).MergeWith(a store holding indexes 0 and 2) panicked: %v", r)
+		}
+	}()
+	other := store.NewCollapsingLowestDenseStore(1000)
+	other.Add(0)
+	other.Add(2)
+	s := store.NewCollapsingLowestDenseStore(2)
+	s.MergeWith(other)
+	if s.TotalCount() != 2 {
+		t.Fatalf("total count after the merge %g, want 2", s.TotalCount())
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..9599d0b
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,1178 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/DataDog/sketches-go/ddsketch"
+	enc "github.com/DataDog/sketches-go/ddsketch/encoding"
+	"github.com/DataDog/sketches-go/ddsketch/mapping"
+	"github.com/DataDog/sketches-go/ddsketch/pb/sketchpb"
+	"github.com/DataDog/sketches-go/ddsketch/stat"
+	"github.com/DataDog/sketches-go/ddsketch/store"
+	"google.golang.org/protobuf/proto"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- mappings
+
+// TestHegelMapping: every mapping (logarithmic, linear, cubic; by accuracy or by gamma and
+// offset) maps each indexable value to a bin whose representative is within the relative
+// accuracy of it; Index is monotone; LowerBound brackets the value; the constructors reject
+// bad parameters; Equals, proto and byte encodings round-trip.
+func TestHegelMapping(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind, alpha := genMappingSpec(ht)
+		var m mapping.IndexMapping
+		gamma := (1 + alpha) / (1 - alpha)
+		offset := 0.0
+		byGamma := chance(ht, 30)
+		if byGamma {
+			offset = float64(drawInt(ht, -1000, 1000)) / 4
+			var err error
+			m, err = newMappingWithGamma(kind, gamma, offset)
+			if err != nil {
+				c.failClass(ht, "WithGamma", "%s mapping with gamma %g offset %g: %v", kind, gamma, offset, err)
+				return
+			}
+		} else {
+			m = newMapping(kind, alpha)
+		}
+		ra := m.RelativeAccuracy()
+		if !byGamma && !closeF(ra, alpha) {
+			c.failClass(ht, "RelativeAccuracy", "%s(%g).RelativeAccuracy() = %g", kind, alpha, ra)
+		}
+		if m.MinIndexableValue() <= 0 || m.MaxIndexableValue() <= m.MinIndexableValue() || math.IsInf(m.MaxIndexableValue(), 0) {
+			c.failClass(ht, "Range", "%s(%g): indexable range [%g, %g]", kind, alpha, m.MinIndexableValue(), m.MaxIndexableValue())
+		}
+
+		// Values across the indexable range, the ends included.
+		var vs []float64
+		for i := 0; i < 6; i++ {
+			switch drawInt(ht, 1, 8) {
+			case 1:
+				vs = append(vs, m.MinIndexableValue())
+			case 2:
+				vs = append(vs, m.MaxIndexableValue())
+			case 3:
+				vs = append(vs, math.Abs(genValue(ht)))
+			default:
+				vs = append(vs, math.Pow(10, float64(drawInt(ht, -300, 300))/1)*float64(drawInt(ht, 1000, 9999))/1000)
+			}
+		}
+		sort.Float64s(vs)
+		prev := math.MinInt64
+		for _, v := range vs {
+			if v == 0 || v < m.MinIndexableValue() || v > m.MaxIndexableValue() {
+				continue
+			}
+			i := m.Index(v)
+			if i < prev {
+				c.failClass(ht, "Monotone", "%s(%g): Index(%g) = %d after an index %d for a smaller value", kind, alpha, v, i, prev)
+			}
+			prev = i
+			if i < math.MinInt32 || i > math.MaxInt32 {
+				c.failClass(ht, "Int32", "%s(%g): Index(%g) = %d, outside int32", kind, alpha, v, i)
+			}
+			val := m.Value(i)
+			if !within(val, v, ra) {
+				c.failClass(ht, "Accuracy", "%s(%g, offset %g): Value(Index(%g)) = %g, relative error %g > %g", kind, alpha, offset, v, val, math.Abs(val-v)/v, ra)
+			}
+			lb, ub := m.LowerBound(i), m.LowerBound(i+1)
+			if Known.changeMappingTopBin && i >= m.Index(m.MaxIndexableValue()) {
+				continue // LowerBound(i+1) overflows or wraps in the topmost bin
+			}
+			if !(lb <= v*(1+1e-9) && v <= ub*(1+1e-9)) {
+				c.failClass(ht, "LowerBound", "%s(%g): %g has index %d but LowerBound(%d) = %g, LowerBound(%d) = %g", kind, alpha, v, i, i, lb, i+1, ub)
+			}
+			if !(lb <= val && val <= ub*(1+1e-9)) {
+				c.failClass(ht, "ValueInBin", "%s(%g): Value(%d) = %g outside [%g, %g]", kind, alpha, i, val, lb, ub)
+			}
+		}
+
+		// Equals: itself and a rebuilt copy; not another accuracy or kind.
+		if !m.Equals(m) {
+			c.failClass(ht, "EqualsSelf", "%s(%g) not equal to itself", kind, alpha)
+		}
+		other := newMapping(kind, alpha)
+		if byGamma {
+			other, _ = newMappingWithGamma(kind, gamma, offset)
+		}
+		if !m.Equals(other) || !other.Equals(m) {
+			c.failClass(ht, "EqualsRebuilt", "%s(%g, gamma %g, offset %g) not equal to the same parameters rebuilt", kind, alpha, gamma, offset)
+		}
+		if m.Equals(newMapping(kind, alpha/2)) {
+			c.failClass(ht, "EqualsOther", "%s(%g) equal to %s(%g)", kind, alpha, kind, alpha/2)
+		}
+		for _, k := range mappingKinds {
+			if k != kind && m.Equals(newMapping(k, alpha)) {
+				c.failClass(ht, "EqualsKind", "%s(%g) equal to %s(%g)", kind, alpha, k, alpha)
+			}
+		}
+
+		// Proto and byte round trips.
+		pb := m.ToProto()
+		back, err := mapping.FromProto(pb)
+		if err != nil || !back.Equals(m) {
+			c.failClass(ht, "Proto", "%s(%g) proto round trip: %v, equal %v", kind, alpha, err, err == nil && back.Equals(m))
+		}
+		var b []byte
+		m.Encode(&b)
+		rest := b
+		flag, ferr := enc.DecodeFlag(&rest)
+		if ferr != nil {
+			c.failClass(ht, "EncodeFlag", "%s(%g): %v", kind, alpha, ferr)
+			return
+		}
+		dec, err := mapping.Decode(&rest, flag)
+		if err != nil || !dec.Equals(m) || len(rest) != 0 {
+			c.failClass(ht, "Encode", "%s(%g) byte round trip: %v, %d bytes left", kind, alpha, err, len(rest))
+		}
+		if cut := drawInt(ht, 1, len(b)-1); cut > 1 {
+			rest := b[1:cut]
+			if _, err := mapping.Decode(&rest, flag); err == nil {
+				c.failClass(ht, "EncodePrefix", "%s(%g): a %d-byte prefix of the encoding decodes", kind, alpha, cut)
+			}
+		}
+
+		// Bad parameters.
+		badAlphas := []float64{0, 1, -0.1, 1.5, math.Inf(1)}
+		badGammas := []float64{1, 0.5, 0, -2}
+		if !Known.nanAccuracyAccepted {
+			badAlphas = append(badAlphas, math.NaN())
+			badGammas = append(badGammas, math.NaN())
+		}
+		badAlpha := pick(ht, badAlphas)
+		if _, err := newMappingWithGamma(kind, pick(ht, badGammas), 0); err == nil {
+			c.failClass(ht, "BadGamma", "%s mapping accepted gamma <= 1", kind)
+		}
+		var badErr error
+		switch kind {
+		case "log":
+			_, badErr = mapping.NewLogarithmicMapping(badAlpha)
+		case "linear":
+			_, badErr = mapping.NewLinearlyInterpolatedMapping(badAlpha)
+		default:
+			_, badErr = mapping.NewCubicallyInterpolatedMapping(badAlpha)
+		}
+		if badErr == nil {
+			c.failClass(ht, "BadAlpha", "%s mapping accepted relative accuracy %g", kind, badAlpha)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- accuracy
+
+// TestHegelAccuracy: the DDSketch guarantee. For a sketch over any mapping and store filled
+// with values of both signs, zeros and untrackably small values, every quantile is within
+// the relative accuracy of the exact value at the sketch's own rank; so are the minimum,
+// the maximum and (for same-sign data) the sum; the count is exact; the collapsing stores
+// keep the guarantee for the quantiles whose bins they keep; the exact-summary sketch
+// returns exact statistics and quantiles clamped to them.
+func TestHegelAccuracy(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := genSketch(ht, true, drawInt(ht, 0, 60))
+		s, md := b.s, b.model
+		ra := s.RelativeAccuracy()
+		count := md.count()
+		if !closeF(s.GetCount(), count) {
+			c.failClass(ht, "Count", "%s: GetCount() = %g, want %g", b, s.GetCount(), count)
+		}
+		if s.IsEmpty() != (count == 0) {
+			c.failClass(ht, "IsEmpty", "%s: IsEmpty() = %v with count %g", b, s.IsEmpty(), count)
+		}
+		_, zero, _ := md.parts()
+		if !closeF(s.GetZeroCount(), zero) {
+			c.failClass(ht, "ZeroCount", "%s: GetZeroCount() = %g, want %g", b, s.GetZeroCount(), zero)
+		}
+		if count == 0 {
+			if _, err := s.GetValueAtQuantile(0.5); err == nil {
+				c.failClass(ht, "EmptyQuantile", "%s: GetValueAtQuantile on an empty sketch: no error", b)
+			}
+			if _, err := s.GetMinValue(); err == nil {
+				c.failClass(ht, "EmptyMin", "%s: GetMinValue on an empty sketch: no error", b)
+			}
+			if _, err := s.GetMaxValue(); err == nil {
+				c.failClass(ht, "EmptyMax", "%s: GetMaxValue on an empty sketch: no error", b)
+			}
+			if _, err := s.GetValuesAtQuantiles([]float64{0.1}); err == nil {
+				c.failClass(ht, "EmptyQuantiles", "%s: GetValuesAtQuantiles on an empty sketch: no error", b)
+			}
+			return
+		}
+
+		if Known.fractionalCountQuantile && count < 1 {
+			return // the rank is negative: see Known
+		}
+
+		// Quantiles.
+		var qs []float64
+		for i := 0; i < 5; i++ {
+			qs = append(qs, genQuantile(ht))
+		}
+		got, err := s.GetValuesAtQuantiles(qs)
+		if err != nil || len(got) != len(qs) {
+			c.failClass(ht, "Quantiles", "%s: GetValuesAtQuantiles(%v): %v (%d values)", b, qs, err, len(got))
+			return
+		}
+		mn, errMin := s.GetMinValue()
+		mx, errMax := s.GetMaxValue()
+		if errMin != nil || errMax != nil {
+			c.failClass(ht, "MinMax", "%s: GetMinValue %v, GetMaxValue %v", b, errMin, errMax)
+			return
+		}
+		for i, q := range qs {
+			one, err := s.GetValueAtQuantile(q)
+			if err != nil || one != got[i] {
+				c.failClass(ht, "QuantileSame", "%s: GetValueAtQuantile(%g) = %g, %v; GetValuesAtQuantiles gave %g", b, q, one, err, got[i])
+			}
+			want := md.quantile(q)
+			if !md.kept(b.m, b.spec, want) {
+				continue
+			}
+			if !within(one, want, ra) {
+				c.failClass(ht, "Quantile", "%s: GetValueAtQuantile(%g) = %g, exact %g (relative error %g > %g)", b, q, one, want, math.Abs(one-want)/math.Abs(want), ra)
+			}
+			if !b.spec.collapsing() && (one < mn || one > mx) {
+				c.failClass(ht, "QuantileBounds", "%s: GetValueAtQuantile(%g) = %g outside [min %g, max %g]", b, q, one, mn, mx)
+			}
+		}
+		// Quantiles are monotone in q.
+		sorted := append([]float64(nil), qs...)
+		sort.Float64s(sorted)
+		vals, _ := s.GetValuesAtQuantiles(sorted)
+		for i := 1; i < len(vals); i++ {
+			if vals[i] < vals[i-1] {
+				c.failClass(ht, "QuantileMonotone", "%s: quantiles %v give %v, not monotone", b, sorted, vals)
+			}
+		}
+		// Min, max, sum.
+		if md.kept(b.m, b.spec, md.min()) && !within(mn, md.min(), ra) {
+			c.failClass(ht, "Min", "%s: GetMinValue() = %g, exact %g", b, mn, md.min())
+		}
+		if md.kept(b.m, b.spec, md.max()) && !within(mx, md.max(), ra) {
+			c.failClass(ht, "Max", "%s: GetMaxValue() = %g, exact %g", b, mx, md.max())
+		}
+		if !b.spec.collapsing() && md.sameSign() {
+			if sum := s.GetSum(); !within(sum, md.sum(), ra) && !(md.sum() == 0 && math.Abs(sum) < 1e-300) {
+				c.failClass(ht, "Sum", "%s: GetSum() = %g, exact %g", b, sum, md.sum())
+			}
+		}
+		// ForEach: positive counts summing to the count; values within the range.
+		var total float64
+		s.ForEach(func(v, cnt float64) bool {
+			total += cnt
+			if cnt <= 0 || math.IsNaN(v) {
+				c.failClass(ht, "ForEachBin", "%s: ForEach bin (%g, %g)", b, v, cnt)
+			}
+			return false
+		})
+		if !closeF(total, count) {
+			c.failClass(ht, "ForEachTotal", "%s: ForEach counts sum to %g, count %g", b, total, count)
+		}
+
+		// Bad quantiles.
+		bad := pick(ht, []float64{-0.1, 1.1, -1e-9, 1 + 1e-9, math.Inf(1), math.Inf(-1)})
+		if !Known.nanQuantileAccepted && chance(ht, 30) {
+			bad = math.NaN()
+		}
+		if v, err := s.GetValueAtQuantile(bad); err == nil {
+			c.failClass(ht, "BadQuantile", "%s: GetValueAtQuantile(%g) = %g with no error", b, bad, v)
+		}
+		if _, err := s.GetValuesAtQuantiles([]float64{0.5, bad}); err == nil {
+			c.failClass(ht, "BadQuantiles", "%s: GetValuesAtQuantiles with %g: no error", b, bad)
+		}
+
+		// Bad additions leave the sketch unchanged.
+		before := s.GetCount()
+		if err := s.AddWithCount(1, -1); err != ddsketch.ErrNegativeCount {
+			c.failClass(ht, "NegativeCount", "%s: AddWithCount(1, -1): %v", b, err)
+		}
+		if err := s.Add(math.NaN()); err != ddsketch.ErrUntrackableNaN {
+			c.failClass(ht, "NaNValue", "%s: Add(NaN): %v", b, err)
+		}
+		if err := s.Add(math.Inf(1)); err != ddsketch.ErrUntrackableTooHigh {
+			c.failClass(ht, "InfValue", "%s: Add(+Inf): %v", b, err)
+		}
+		if err := s.Add(math.Inf(-1)); err != ddsketch.ErrUntrackableTooLow {
+			c.failClass(ht, "InfValue", "%s: Add(-Inf): %v", b, err)
+		}
+		if !Known.nanCountAccepted {
+			if err := s.AddWithCount(1, math.NaN()); err == nil {
+				c.failClass(ht, "NaNCount", "%s: AddWithCount(1, NaN) accepted", b)
+			}
+		}
+		if s.GetCount() != before {
+			c.failClass(ht, "BadAddChanged", "%s: rejected additions changed the count from %g to %g", b, before, s.GetCount())
+		}
+
+		// The exact-summary sketch over the same data.
+		e := ddsketch.NewDDSketchWithExactSummaryStatistics(b.m, b.spec.provider())
+		for _, p := range md.pts {
+			if err := e.AddWithCount(p.v, p.c); err != nil {
+				c.failClass(ht, "ExactAdd", "%s: exact sketch AddWithCount(%g, %g): %v", b, p.v, p.c, err)
+			}
+		}
+		if !closeF(e.GetCount(), count) || e.IsEmpty() != (count == 0) || !closeF(e.GetZeroCount(), zero) {
+			c.failClass(ht, "ExactCount", "%s: exact sketch count %g (want %g), zero %g (want %g)", b, e.GetCount(), count, e.GetZeroCount(), zero)
+		}
+		// Exact min and max are of the values as added (not of the effective ones).
+		exMin, exMax := math.Inf(1), math.Inf(-1)
+		var exSum float64
+		for _, p := range md.pts {
+			if p.c == 0 {
+				continue
+			}
+			exMin = math.Min(exMin, p.v)
+			exMax = math.Max(exMax, p.v)
+			exSum += p.v * p.c
+		}
+		if emn, err := e.GetMinValue(); err != nil || emn != exMin {
+			c.failClass(ht, "ExactMin", "%s: exact sketch GetMinValue() = %g, %v; want %g", b, emn, err, exMin)
+		}
+		if emx, err := e.GetMaxValue(); err != nil || emx != exMax {
+			c.failClass(ht, "ExactMax", "%s: exact sketch GetMaxValue() = %g, %v; want %g", b, emx, err, exMax)
+		}
+		if esum := e.GetSum(); !closeF(esum, exSum) && math.Abs(esum-exSum) > 1e-6*sumOfAbs(md) {
+			c.failClass(ht, "ExactSum", "%s: exact sketch GetSum() = %g, want %g", b, esum, exSum)
+		}
+		for _, q := range qs {
+			ev, err := e.GetValueAtQuantile(q)
+			if err != nil {
+				c.failClass(ht, "ExactQuantileErr", "%s: exact sketch GetValueAtQuantile(%g): %v", b, q, err)
+				continue
+			}
+			if ev < exMin || ev > exMax {
+				c.failClass(ht, "ExactClamp", "%s: exact sketch GetValueAtQuantile(%g) = %g outside [%g, %g]", b, q, ev, exMin, exMax)
+			}
+			want := md.quantile(q)
+			if md.kept(b.m, b.spec, want) && !within(ev, want, ra) && !(want == 0 && math.Abs(ev) <= b.m.MinIndexableValue()) {
+				c.failClass(ht, "ExactQuantile", "%s: exact sketch GetValueAtQuantile(%g) = %g, exact %g", b, q, ev, want)
+			}
+		}
+	})
+}
+
+func sumOfAbs(md *sample) float64 {
+	var s float64
+	for _, p := range md.pts {
+		s += math.Abs(p.v) * p.c
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- operations
+
+// TestHegelOperations: MergeWith is the union of the data (across store types; mappings must
+// match); Copy is independent; Clear empties; Reweight scales every count and keeps the
+// quantiles; ChangeMapping keeps the count and the quantiles within the combined accuracy.
+func TestHegelOperations(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genSketch(ht, false, drawInt(ht, 0, 40))
+		// b shares a's mapping, with a store of its own kind.
+		spec := genStoreSpec(ht, false)
+		bs := ddsketch.NewDDSketch(a.m, spec.provider()(), spec.provider()())
+		b := &built{s: bs, m: a.m, kind: a.kind, alpha: a.alpha, spec: spec, model: &sample{minIdx: a.m.MinIndexableValue()}}
+		fill(ht, b, drawInt(ht, 0, 40))
+		ra := a.s.RelativeAccuracy()
+
+		// Copy before merging.
+		cp := a.s.Copy()
+		if err := a.s.MergeWith(b.s); err != nil {
+			c.failClass(ht, "Merge", "%s.MergeWith(%s): %v", a, b, err)
+			return
+		}
+		union := &sample{minIdx: a.model.minIdx, pts: append(append([]point(nil), a.model.pts...), b.model.pts...)}
+		if !closeF(a.s.GetCount(), union.count()) {
+			c.failClass(ht, "MergeCount", "merged count %g, want %g", a.s.GetCount(), union.count())
+		}
+		if !closeF(cp.GetCount(), a.model.count()) {
+			c.failClass(ht, "CopyIndependent", "the copy's count changed to %g after merging into the original (was %g)", cp.GetCount(), a.model.count())
+		}
+		if !closeF(b.s.GetCount(), b.model.count()) {
+			c.failClass(ht, "MergeArg", "the merged-in sketch's count changed to %g (was %g)", b.s.GetCount(), b.model.count())
+		}
+		checkQuantiles := func(what string, s *ddsketch.DDSketch, md *sample, tol float64, scale float64) {
+			if md.count() == 0 {
+				if !s.IsEmpty() {
+					c.failClass(ht, what+"Empty", "%s: not empty with an empty model (count %g)", what, s.GetCount())
+				}
+				return
+			}
+			if Known.fractionalCountQuantile && md.count() < 1 {
+				return
+			}
+			for i := 0; i < 4; i++ {
+				q := genQuantile(ht)
+				got, err := s.GetValueAtQuantile(q)
+				want := md.quantile(q) * scale
+				if err != nil || !within(got, want, tol) {
+					c.failClass(ht, what, "%s: GetValueAtQuantile(%g) = %g, %v; exact %g (tolerance %g)", what, q, got, err, want, tol)
+				}
+			}
+		}
+		checkQuantiles("Merged", a.s, union, ra, 1)
+		checkQuantiles("Copy", cp, a.model, ra, 1)
+
+		// Merging with a different mapping is refused and changes nothing.
+		otherKind := pick(ht, mappingKinds)
+		otherAlpha := a.alpha / 2
+		if otherKind == a.kind && chance(ht, 50) {
+			otherAlpha = a.alpha
+			otherKind = mappingKinds[(indexOf(mappingKinds, a.kind)+1)%3]
+		}
+		other := ddsketch.NewDDSketch(newMapping(otherKind, otherAlpha), store.NewDenseStore(), store.NewDenseStore())
+		other.Add(1)
+		before := a.s.GetCount()
+		if err := a.s.MergeWith(other); err == nil {
+			c.failClass(ht, "MergeMapping", "merging %s(%g) into %s(%g): no error", otherKind, otherAlpha, a.kind, a.alpha)
+		}
+		if a.s.GetCount() != before {
+			c.failClass(ht, "MergeMappingChanged", "a refused merge changed the count from %g to %g", before, a.s.GetCount())
+		}
+		// Merging an empty sketch changes nothing; merging into an empty one copies.
+		empty := ddsketch.NewDDSketch(a.m, spec.provider()(), spec.provider()())
+		if err := a.s.MergeWith(empty); err != nil || a.s.GetCount() != before {
+			c.failClass(ht, "MergeEmpty", "merging an empty sketch: %v, count %g -> %g", err, before, a.s.GetCount())
+		}
+		if err := empty.MergeWith(a.s); err != nil || !closeF(empty.GetCount(), before) {
+			c.failClass(ht, "MergeIntoEmpty", "merging into an empty sketch: %v, count %g (want %g)", err, empty.GetCount(), before)
+		}
+		checkQuantiles("MergedIntoEmpty", empty, union, ra, 1)
+
+		// Reweight.
+		w := pick(ht, []float64{0.5, 2, 3, 0.25, 1, 10})
+		rw := a.s.Copy()
+		if err := rw.Reweight(w); err != nil {
+			c.failClass(ht, "Reweight", "Reweight(%g): %v", w, err)
+		} else {
+			if !closeF(rw.GetCount(), before*w) {
+				c.failClass(ht, "ReweightCount", "Reweight(%g): count %g, want %g", w, rw.GetCount(), before*w)
+			}
+			scaled := &sample{minIdx: union.minIdx}
+			for _, p := range union.pts {
+				scaled.add(p.v, p.c*w)
+			}
+			checkQuantiles("Reweighted", rw, scaled, ra, 1)
+			// Bins are the same, counts scaled.
+			var bins, rbins []point
+			a.s.ForEach(func(v, cnt float64) bool { bins = append(bins, point{v, cnt}); return false })
+			rw.ForEach(func(v, cnt float64) bool { rbins = append(rbins, point{v, cnt}); return false })
+			sortPoints(bins)
+			sortPoints(rbins)
+			if len(bins) != len(rbins) {
+				c.failClass(ht, "ReweightBins", "Reweight(%g): %d bins, was %d", w, len(rbins), len(bins))
+			} else {
+				for i := range bins {
+					if bins[i].v != rbins[i].v || !closeF(bins[i].c*w, rbins[i].c) {
+						c.failClass(ht, "ReweightBins", "Reweight(%g): bin %v became %v", w, bins[i], rbins[i])
+						break
+					}
+				}
+			}
+		}
+		if err := rw.Reweight(pick(ht, []float64{0, -1, -0.5})); err == nil {
+			c.failClass(ht, "ReweightBad", "Reweight of a non-positive factor accepted")
+		}
+
+		// ChangeMapping.
+		nk, na := genMappingSpec(ht)
+		nm := newMapping(nk, na)
+		scale := pick(ht, []float64{1, 2, 0.5, 1000, 0.001, 3.7})
+		ns := genStoreSpec(ht, false)
+		if (Known.changeMappingTopBin && union.topBinOverflows(a.m)) || (Known.changeMappingOutOfRange && union.leavesRange(a.m, nm, scale)) {
+			a.s.Clear()
+			return
+		}
+		changed := a.s.ChangeMapping(nm, ns.provider()(), ns.provider()(), scale)
+		if !closeF(changed.GetCount(), before) {
+			c.failClass(ht, "ChangeMappingCount", "ChangeMapping(%s(%g), scale %g): count %g, want %g", nk, na, scale, changed.GetCount(), before)
+		}
+		if a.s.GetCount() != before {
+			c.failClass(ht, "ChangeMappingOriginal", "ChangeMapping changed the original")
+		}
+		if changed.GetZeroCount() != a.s.GetZeroCount() {
+			c.failClass(ht, "ChangeMappingZero", "ChangeMapping: zero count %g, was %g", changed.GetZeroCount(), a.s.GetZeroCount())
+		}
+		// Every mass stays within the scaled old bin, so within the old bin ratio times the
+		// new accuracy of the exact scaled quantile; values whose scaled magnitude leaves the
+		// new mapping's range are skipped.
+		gammaOld := (1 + ra) / (1 - ra)
+		tol := gammaOld*(1+nm.RelativeAccuracy()) - 1
+		if union.count() > 0 {
+			for i := 0; i < 4; i++ {
+				q := genQuantile(ht)
+				want := union.quantile(q) * scale
+				if want != 0 && (math.Abs(want) < nm.MinIndexableValue()*gammaOld*2 || math.Abs(want) > nm.MaxIndexableValue()/gammaOld/2) {
+					continue
+				}
+				got, err := changed.GetValueAtQuantile(q)
+				// The split proportions of a bin may sum to 1 -+ 1e-16, so the rank can fall
+				// just beside a boundary: the values at the ranks a whisker below and above
+				// are accepted too.
+				rank := float64(q * (union.count() - 1))
+				below := union.atSketchRank(rank-1e-6) * scale
+				above := union.atSketchRank(rank+1e-6) * scale
+				if err != nil || (!within(got, want, tol) && !within(got, below, tol) && !within(got, above, tol)) {
+					c.failClass(ht, "ChangeMappingQuantile", "%s -> %s(%g) scale %g: GetValueAtQuantile(%g) = %g, %v; exact %g (tolerance %g)", a, nk, na, scale, q, got, err, want, tol)
+				}
+			}
+		}
+
+		// Clear.
+		a.s.Clear()
+		if !a.s.IsEmpty() || a.s.GetCount() != 0 || a.s.GetZeroCount() != 0 {
+			c.failClass(ht, "Clear", "after Clear: empty %v, count %g, zero %g", a.s.IsEmpty(), a.s.GetCount(), a.s.GetZeroCount())
+		}
+		if _, err := a.s.GetValueAtQuantile(0.5); err == nil {
+			c.failClass(ht, "ClearQuantile", "GetValueAtQuantile after Clear: no error")
+		}
+		if !closeF(cp.GetCount(), a.model.count()) {
+			c.failClass(ht, "ClearCopy", "Clear emptied the copy too")
+		}
+		// Reusable after Clear.
+		a.s.Add(1)
+		if a.s.GetCount() != 1 {
+			c.failClass(ht, "ClearReuse", "count after Clear and Add(1) = %g", a.s.GetCount())
+		}
+	})
+}
+
+func indexOf(xs []string, x string) int {
+	for i, y := range xs {
+		if y == x {
+			return i
+		}
+	}
+	return -1
+}
+
+func sortPoints(ps []point) {
+	sort.Slice(ps, func(i, j int) bool { return ps[i].v < ps[j].v })
+}
+
+// --------------------------------------------------------------------------- stores
+
+// TestHegelStores: every store type against a map from index to count under Add,
+// AddWithCount, AddBin, MergeWith (any other type), Reweight, Copy and Clear; the
+// collapsing stores fold the bins beyond their limit into the edge bin; KeyAtRank,
+// MinIndex, MaxIndex, TotalCount, ForEach, Bins and the proto round trip.
+func TestHegelStores(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		spec := genStoreSpec(ht, true)
+		if spec.collapsing() && chance(ht, 50) {
+			spec.m = drawInt(ht, 1, 12)
+		}
+		st := spec.provider()()
+		model := map[int]float64{}
+		collapsed := false
+		// The dense store allocates its whole index range ("bound only by the size of the
+		// slice that can be allocated"), so the int32 extremes go only to the sparse and the
+		// collapsing stores.
+		wide := spec.kind == "sparse" || spec.collapsing()
+		genIndex := func() int {
+			switch drawInt(ht, 1, 6) {
+			case 1:
+				return drawInt(ht, -5000, 5000)
+			case 2:
+				if wide {
+					return pick(ht, []int{math.MinInt32, math.MaxInt32, math.MinInt32 + 1, math.MaxInt32 - 1, 0})
+				}
+				return drawInt(ht, -50000, 50000)
+			default:
+				return drawInt(ht, -20, 20)
+			}
+		}
+		// collapse applies the collapsing store's rule to the model.
+		collapse := func() {
+			if !spec.collapsing() || len(model) == 0 {
+				return
+			}
+			lo, hi := math.MaxInt64, math.MinInt64
+			for k := range model {
+				lo = min(lo, k)
+				hi = max(hi, k)
+			}
+			if !collapsed && hi-lo+1 <= spec.m {
+				return
+			}
+			collapsed = true
+			if spec.kind == "lowest" {
+				edge := hi - spec.m + 1
+				for k, v := range model {
+					if k < edge {
+						model[edge] += v
+						delete(model, k)
+					}
+				}
+			} else {
+				edge := lo + spec.m - 1
+				for k, v := range model {
+					if k > edge {
+						model[edge] += v
+						delete(model, k)
+					}
+				}
+			}
+		}
+		addModel := func(i int, cnt float64) {
+			if cnt == 0 {
+				return
+			}
+			model[i] += cnt
+			collapse()
+		}
+		var trace []string // the operations, for the messages
+		steps := drawInt(ht, 0, 30)
+		for step := 0; step < steps; step++ {
+			switch drawInt(ht, 1, 10) {
+			case 1, 2, 3, 4:
+				i := genIndex()
+				st.Add(i)
+				addModel(i, 1)
+				trace = append(trace, fmt.Sprintf("Add(%d)", i))
+			case 5, 6:
+				i := genIndex()
+				cnt := pick(ht, []float64{0, 0.5, 2, 3, 0.25, 1})
+				st.AddWithCount(i, cnt)
+				addModel(i, cnt)
+				trace = append(trace, fmt.Sprintf("AddWithCount(%d, %g)", i, cnt))
+			case 7:
+				i := genIndex()
+				cnt := pick(ht, []float64{0, 1, 2.5})
+				bin, err := store.NewBin(i, cnt)
+				if err != nil {
+					c.failClass(ht, "NewBin", "NewBin(%d, %g): %v", i, cnt, err)
+					continue
+				}
+				st.AddBin(*bin)
+				addModel(i, cnt)
+				trace = append(trace, fmt.Sprintf("AddBin(%d, %g)", i, cnt))
+			case 8:
+				// Merge a store of any kind holding a few indexes.
+				ospec := genStoreSpec(ht, true)
+				if ospec.collapsing() {
+					ospec.m = drawInt(ht, 1000, 5000) // no collapse of its own
+				}
+				if ospec.kind != "sparse" && !ospec.collapsing() {
+					wide = false // the merged-in dense store must stay narrow too
+				}
+				o := ospec.provider()()
+				var added []string
+				for k := 0; k < drawInt(ht, 0, 5); k++ {
+					i := genIndex()
+					cnt := pick(ht, []float64{1, 1, 2, 0.5})
+					o.AddWithCount(i, cnt)
+					added = append(added, fmt.Sprintf("%d:%g", i, cnt))
+				}
+				if Known.collapsingMergePanics && spec.collapsing() && ospec.kind == spec.kind && st.IsEmpty() {
+					oMin, _ := o.MinIndex()
+					oMax, _ := o.MaxIndex()
+					if !o.IsEmpty() && oMax-oMin+1 > spec.m {
+						continue // see Known: the merge panics
+					}
+				}
+				// The other store may have collapsed bins of its own: merge what it holds.
+				o.ForEach(func(i int, cnt float64) bool { addModel(i, cnt); return false })
+				panicked := false
+				func() {
+					defer func() {
+						if r := recover(); r != nil {
+							panicked = true
+							c.failClass(ht, "MergePanic", "%s: MergeWith(%s %v) panicked: %v; after %s", spec, ospec, added, r, strings.Join(trace, "; "))
+						}
+					}()
+					st.MergeWith(o)
+				}()
+				if panicked {
+					return
+				}
+				trace = append(trace, fmt.Sprintf("MergeWith(%s %v)", ospec, added))
+			case 9:
+				w := pick(ht, []float64{2, 0.5, 3})
+				if err := st.Reweight(w); err != nil {
+					c.failClass(ht, "Reweight", "%s: Reweight(%g): %v", spec, w, err)
+				}
+				for k := range model {
+					model[k] *= w
+				}
+				trace = append(trace, fmt.Sprintf("Reweight(%g)", w))
+			default:
+				if chance(ht, 30) {
+					st.Clear()
+					model = map[int]float64{}
+					collapsed = false
+					trace = append(trace, "Clear()")
+				} else {
+					st = st.Copy()
+					trace = append(trace, "Copy()")
+				}
+			}
+		}
+		if _, err := store.NewBin(0, -1); err == nil {
+			c.failClass(ht, "NewBinNegative", "NewBin(0, -1) accepted")
+		}
+		if err := st.Reweight(pick(ht, []float64{0, -1})); err == nil {
+			c.failClass(ht, "ReweightBad", "%s: Reweight of a non-positive factor accepted", spec)
+		}
+
+		// Compare.
+		var total float64
+		keys := make([]int, 0, len(model))
+		for k, v := range model {
+			total += v
+			keys = append(keys, k)
+		}
+		sort.Ints(keys)
+		if !closeF(st.TotalCount(), total) {
+			c.failClass(ht, "TotalCount", "%s: TotalCount() = %g, want %g", spec, st.TotalCount(), total)
+		}
+		if st.IsEmpty() != (len(model) == 0) {
+			c.failClass(ht, "IsEmpty", "%s: IsEmpty() = %v with %d bins", spec, st.IsEmpty(), len(model))
+		}
+		got := map[int]float64{}
+		st.ForEach(func(i int, cnt float64) bool {
+			if _, dup := got[i]; dup {
+				c.failClass(ht, "ForEachDup", "%s: ForEach visits index %d twice", spec, i)
+			}
+			got[i] = cnt
+			return false
+		})
+		if !sameBins(got, model) {
+			c.failClass(ht, "ForEach", "%s: ForEach gives %v, want %v after %s", spec, got, model, strings.Join(trace, "; "))
+		}
+		fromChan := map[int]float64{}
+		for bin := range st.Bins() {
+			fromChan[bin.Index()] += bin.Count()
+		}
+		if !sameBins(fromChan, model) {
+			c.failClass(ht, "Bins", "%s: Bins() gives %v, want %v", spec, fromChan, model)
+		}
+		if len(model) == 0 {
+			if _, err := st.MinIndex(); err == nil {
+				c.failClass(ht, "MinIndexEmpty", "%s: MinIndex of an empty store: no error", spec)
+			}
+			if _, err := st.MaxIndex(); err == nil {
+				c.failClass(ht, "MaxIndexEmpty", "%s: MaxIndex of an empty store: no error", spec)
+			}
+			return
+		}
+		mn, err1 := st.MinIndex()
+		mx, err2 := st.MaxIndex()
+		if err1 != nil || err2 != nil || mn != keys[0] || mx != keys[len(keys)-1] {
+			c.failClass(ht, "MinMaxIndex", "%s: MinIndex %d %v, MaxIndex %d %v; want %d, %d", spec, mn, err1, mx, err2, keys[0], keys[len(keys)-1])
+		}
+		// KeyAtRank: the first index whose cumulative count exceeds the rank; the maximum
+		// index at or beyond the total; negative ranks as zero.
+		rank := pick(ht, []float64{-1, 0, total - 1, total, total + 5, total / 2, float64(drawInt(ht, 0, int(math.Ceil(total))))})
+		if chance(ht, 40) && total > 1 {
+			rank = float64(drawInt(ht, 0, 1000)) / 1000 * (total - 1)
+		}
+		want := keys[len(keys)-1]
+		var cum float64
+		for _, k := range keys {
+			cum += model[k]
+			if cum > math.Max(rank, 0) {
+				want = k
+				break
+			}
+		}
+		if k := st.KeyAtRank(rank); k != want {
+			c.failClass(ht, "KeyAtRank", "%s: KeyAtRank(%g) = %d, want %d (bins %v)", spec, rank, k, want, model)
+		}
+		// Proto round trip into a dense store, and merged into a store of another kind. (With
+		// bins spanning more than MaxDecodeIndexRange the dense store would allocate the whole
+		// range: see Known.)
+		if Known.protoIgnoresMaxDecodeIndexRange && uint64(keys[len(keys)-1]-keys[0]) >= store.MaxDecodeIndexRange {
+			return
+		}
+		pb := st.ToProto()
+		dense := store.FromProto(pb)
+		got = map[int]float64{}
+		dense.ForEach(func(i int, cnt float64) bool { got[i] = cnt; return false })
+		if !sameBins(got, model) {
+			c.failClass(ht, "ProtoRoundTrip", "%s: FromProto(ToProto()) gives %v, want %v", spec, got, model)
+		}
+		target := genStoreSpec(ht, false).provider()()
+		target.Add(keys[0])
+		store.MergeWithProto(target, pb)
+		got = map[int]float64{}
+		target.ForEach(func(i int, cnt float64) bool { got[i] = cnt; return false })
+		expect := map[int]float64{}
+		for k, v := range model {
+			expect[k] = v
+		}
+		expect[keys[0]]++
+		if !sameBins(got, expect) {
+			c.failClass(ht, "MergeWithProto", "%s: MergeWithProto gives %v, want %v", spec, got, expect)
+		}
+		// Copy is independent.
+		cp := st.Copy()
+		cp.Add(keys[0])
+		if !closeF(st.TotalCount(), total) {
+			c.failClass(ht, "CopyIndependent", "%s: adding to the copy changed the original's count to %g", spec, st.TotalCount())
+		}
+		if !closeF(cp.TotalCount(), total+1) {
+			c.failClass(ht, "CopyCount", "%s: the copy's count is %g after one Add, want %g", spec, cp.TotalCount(), total+1)
+		}
+	})
+}
+
+func sameBins(got, want map[int]float64) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, v := range want {
+		if g, ok := got[k]; !ok || !closeF(g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- encoding
+
+// TestHegelEncoding: the byte encoding and the protobuf round-trip every sketch into every
+// store type with the same bins, count and quantiles, with or without the mapping; the
+// exact-summary sketch keeps its statistics; decoding refuses a missing mapping, a
+// mismatched mapping and truncated data, and never panics on corrupt bytes.
+func TestHegelEncoding(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := genSketch(ht, false, drawInt(ht, 0, 40))
+		s := b.s
+		omit := chance(ht, 40)
+		var buf []byte
+		if chance(ht, 30) {
+			buf = []byte{9, 9, 9}
+		}
+		prefix := len(buf)
+		s.Encode(&buf, omit)
+		enc := buf[prefix:]
+		if len(buf) < prefix || !bytes.Equal(buf[:prefix], bytes.Repeat([]byte{9}, prefix)) {
+			c.failClass(ht, "EncodeAppend", "Encode overwrote the buffer's existing content")
+		}
+		var given mapping.IndexMapping
+		if omit || chance(ht, 50) {
+			given = b.m
+		}
+		target := genStoreSpec(ht, false)
+		bins := binsOf(s)
+		qs := []float64{0, 0.25, 0.5, 0.75, 1, genQuantile(ht)}
+
+		same := func(what string, d *ddsketch.DDSketch) {
+			if !closeF(d.GetCount(), s.GetCount()) || !closeF(d.GetZeroCount(), s.GetZeroCount()) || d.IsEmpty() != s.IsEmpty() {
+				c.failClass(ht, what+"Count", "%s: %s gives count %g zero %g, want %g %g", b, what, d.GetCount(), d.GetZeroCount(), s.GetCount(), s.GetZeroCount())
+			}
+			if !d.IndexMapping.Equals(b.m) {
+				c.failClass(ht, what+"Mapping", "%s: %s gives a different mapping", b, what)
+			}
+			if got := binsOf(d); !samePoints(got, bins) {
+				c.failClass(ht, what+"Bins", "%s: %s gives bins %v, want %v", b, what, got, bins)
+			}
+			if !s.IsEmpty() {
+				want, _ := s.GetValuesAtQuantiles(qs)
+				got, err := d.GetValuesAtQuantiles(qs)
+				if err != nil {
+					c.failClass(ht, what+"Quantiles", "%s: %s: %v", b, what, err)
+				} else {
+					for i := range qs {
+						if !closeF(got[i], want[i]) {
+							c.failClass(ht, what+"Quantiles", "%s: %s (into %s): quantile %g is %g, was %g; bins %v, original %v; count %g zero %g", b, what, target, qs[i], got[i], want[i], binsOf(d), bins, d.GetCount(), d.GetZeroCount())
+						}
+					}
+				}
+			}
+		}
+
+		d, err := ddsketch.DecodeDDSketch(enc, target.provider(), given)
+		if err != nil {
+			c.failClass(ht, "Decode", "%s: DecodeDDSketch (omit %v, mapping given %v, into %s): %v", b, omit, given != nil, target, err)
+			return
+		}
+		same("Decode", d)
+		// Decode into an existing sketch with the same mapping: a merge.
+		merged := ddsketch.NewDDSketch(b.m, target.provider()(), target.provider()())
+		merged.Add(1)
+		if err := merged.DecodeAndMergeWith(enc); err != nil {
+			c.failClass(ht, "DecodeMerge", "%s: DecodeAndMergeWith: %v", b, err)
+		} else if !closeF(merged.GetCount(), s.GetCount()+1) {
+			c.failClass(ht, "DecodeMergeCount", "%s: DecodeAndMergeWith gives count %g, want %g", b, merged.GetCount(), s.GetCount()+1)
+		}
+		if omit {
+			if _, err := ddsketch.DecodeDDSketch(enc, target.provider(), nil); err == nil {
+				c.failClass(ht, "DecodeNoMapping", "%s: decoding without a mapping (omitted from the data): no error", b)
+			}
+		} else {
+			// A mismatched mapping in the data is refused by DecodeAndMergeWith.
+			otherM := newMapping(b.kind, b.alpha/2)
+			om := ddsketch.NewDDSketch(otherM, target.provider()(), target.provider()())
+			if err := om.DecodeAndMergeWith(enc); err == nil {
+				c.failClass(ht, "DecodeMismatch", "%s: DecodeAndMergeWith of data with another mapping: no error", b)
+			}
+		}
+		// Encoding the decoded sketch again yields the same bytes when the store kind is
+		// the same? Not required (encodings may differ by store); the decoded sketch must
+		// re-decode to the same content.
+		var again []byte
+		d.Encode(&again, omit)
+		d2, err := ddsketch.DecodeDDSketch(again, b.spec.provider(), given)
+		if err != nil {
+			c.failClass(ht, "Redecode", "%s: decoding the re-encoding: %v", b, err)
+		} else {
+			same("Redecode", d2)
+		}
+
+		// Proto.
+		pbm := s.ToProto()
+		raw, err := proto.Marshal(pbm)
+		if err != nil {
+			c.failClass(ht, "ProtoMarshal", "%s: %v", b, err)
+			return
+		}
+		var back sketchpb.DDSketch
+		if err := proto.Unmarshal(raw, &back); err != nil {
+			c.failClass(ht, "ProtoUnmarshal", "%s: %v", b, err)
+			return
+		}
+		fp, err := ddsketch.FromProtoWithStoreProvider(&back, target.provider())
+		if err != nil {
+			c.failClass(ht, "FromProto", "%s: %v", b, err)
+		} else {
+			same("FromProto", fp)
+		}
+		if fd, err := ddsketch.FromProto(&back); err != nil {
+			c.failClass(ht, "FromProtoDense", "%s: %v", b, err)
+		} else {
+			same("FromProtoDense", fd)
+		}
+		// EncodeProto writes the same bytes as proto.Marshal.
+		var w bytes.Buffer
+		s.EncodeProto(&w)
+		var viaBuilder sketchpb.DDSketch
+		if err := proto.Unmarshal(w.Bytes(), &viaBuilder); err != nil {
+			c.failClass(ht, "EncodeProto", "%s: EncodeProto output does not parse: %v", b, err)
+		} else if fb, err := ddsketch.FromProtoWithStoreProvider(&viaBuilder, target.provider()); err != nil {
+			c.failClass(ht, "EncodeProtoFrom", "%s: %v", b, err)
+		} else {
+			same("EncodeProto", fb)
+		}
+		var cw bytes.Buffer
+		cb := ddsketch.NewDDSketchCollectionBuilder(&cw)
+		cb.AddSketch(s)
+		var viaCollection sketchpb.DDSketch
+		if err := proto.Unmarshal(cw.Bytes(), &viaCollection); err != nil {
+			c.failClass(ht, "CollectionBuilder", "%s: DDSketchCollectionBuilder output does not parse: %v", b, err)
+		} else if fb, err := ddsketch.FromProtoWithStoreProvider(&viaCollection, target.provider()); err != nil {
+			c.failClass(ht, "CollectionBuilderFrom", "%s: %v", b, err)
+		} else {
+			same("CollectionBuilder", fb)
+		}
+
+		// Exact-summary sketch: statistics survive; a plain decode of its bytes works; a
+		// statistics decode of plain bytes is refused unless empty.
+		e := ddsketch.NewDDSketchWithExactSummaryStatistics(b.m, b.spec.provider())
+		for _, p := range b.model.pts {
+			e.AddWithCount(p.v, p.c)
+		}
+		var eb []byte
+		e.Encode(&eb, omit)
+		de, err := ddsketch.DecodeDDSketchWithExactSummaryStatistics(eb, target.provider(), given)
+		if err != nil {
+			c.failClass(ht, "DecodeExact", "%s: DecodeDDSketchWithExactSummaryStatistics: %v", b, err)
+		} else {
+			eMin, _ := e.GetMinValue()
+			eMax, _ := e.GetMaxValue()
+			dMin, _ := de.GetMinValue()
+			dMax, _ := de.GetMaxValue()
+			if !closeF(de.GetCount(), e.GetCount()) || !(closeF(de.GetSum(), e.GetSum()) || sameOrNaN(de.GetSum(), e.GetSum())) || !sameOrNaN(dMin, eMin) || !sameOrNaN(dMax, eMax) {
+				c.failClass(ht, "DecodeExactStats", "%s: exact statistics after decode: count %g sum %g min %g max %g; were %g %g %g %g", b, de.GetCount(), de.GetSum(), dMin, dMax, e.GetCount(), e.GetSum(), eMin, eMax)
+			}
+			if !samePoints(binsOfExact(de), binsOfExact(e)) {
+				c.failClass(ht, "DecodeExactBins", "%s: exact sketch bins differ after decode", b)
+			}
+		}
+		if !Known.plainDecodeOfExactSummary {
+			if plain, err := ddsketch.DecodeDDSketch(eb, target.provider(), given); err != nil {
+				c.failClass(ht, "DecodePlainFromExact", "%s: DecodeDDSketch of an exact-summary encoding: %v", b, err)
+			} else {
+				same("DecodePlainFromExact", plain)
+			}
+		}
+		if _, err := ddsketch.DecodeDDSketchWithExactSummaryStatistics(enc, target.provider(), given); (err == nil) != s.IsEmpty() {
+			c.failClass(ht, "DecodeExactFromPlain", "%s: DecodeDDSketchWithExactSummaryStatistics of a plain encoding: %v (empty %v)", b, err, s.IsEmpty())
+		}
+
+		// Corruption: prefixes error out; random damage never panics.
+		if len(enc) > 0 {
+			cut := drawInt(ht, 0, len(enc)-1)
+			if _, err := ddsketch.DecodeDDSketch(enc[:cut], target.provider(), b.m); err == nil && cut > 0 && !prefixIsComplete(enc[:cut], b.m, s) {
+				c.failClass(ht, "DecodePrefix", "%s: a %d-byte prefix of %d decodes without error", b, cut, len(enc))
+			}
+			damaged := append([]byte(nil), enc...)
+			damaged[drawInt(ht, 0, len(enc)-1)] = byte(drawInt(ht, 0, 255))
+			_, _ = ddsketch.DecodeDDSketch(damaged, target.provider(), b.m)
+			_, _ = ddsketch.DecodeDDSketchWithExactSummaryStatistics(damaged, target.provider(), b.m)
+		}
+	})
+}
+
+// prefixIsComplete reports whether a prefix of an encoding happens to be a whole encoding
+// of a sketch (blocks are self-delimiting, so a cut between blocks decodes to less data).
+func prefixIsComplete(p []byte, m mapping.IndexMapping, s *ddsketch.DDSketch) bool {
+	d, err := ddsketch.DecodeDDSketch(p, store.DenseStoreConstructor, m)
+	if err != nil {
+		return false
+	}
+	// A cut between blocks: the decoded sketch holds a subset of the bins.
+	got := binsOf(d)
+	all := map[float64]float64{}
+	for _, p := range binsOf(s) {
+		all[p.v] = p.c
+	}
+	for _, p := range got {
+		if !closeF(all[p.v], p.c) {
+			return false
+		}
+	}
+	return true
+}
+
+func binsOf(s *ddsketch.DDSketch) []point {
+	var ps []point
+	s.ForEach(func(v, c float64) bool { ps = append(ps, point{v, c}); return false })
+	sortPoints(ps)
+	return ps
+}
+
+func binsOfExact(s *ddsketch.DDSketchWithExactSummaryStatistics) []point {
+	var ps []point
+	s.ForEach(func(v, c float64) bool { ps = append(ps, point{v, c}); return false })
+	sortPoints(ps)
+	return ps
+}
+
+func samePoints(a, b []point) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !closeF(a[i].v, b[i].v) || !closeF(a[i].c, b[i].c) {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- summary statistics
+
+// TestHegelSummaryStatistics: stat.SummaryStatistics against exact count, sum, min and max
+// under Add, MergeWith, Reweight, Rescale, Copy and Clear; FromData validation.
+func TestHegelSummaryStatistics(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		type model struct {
+			count, sum, min, max float64
+		}
+		fresh := model{0, 0, math.Inf(1), math.Inf(-1)}
+		md := fresh
+		s := stat.NewSummaryStatistics()
+		var absSum float64
+		add := func(m *model, v, cnt float64) {
+			m.count += cnt
+			m.sum += v * cnt
+			absSum += math.Abs(v * cnt)
+			if v < m.min {
+				m.min = v
+			}
+			if v > m.max {
+				m.max = v
+			}
+		}
+		for i := 0; i < drawInt(ht, 0, 30); i++ {
+			switch drawInt(ht, 1, 10) {
+			case 1:
+				o := stat.NewSummaryStatistics()
+				om := fresh
+				for k := 0; k < drawInt(ht, 0, 4); k++ {
+					v, cnt := genValue(ht), genCount(ht)
+					o.Add(v, cnt)
+					add(&om, v, cnt)
+				}
+				s.MergeWith(o)
+				md.count += om.count
+				md.sum += om.sum
+				md.min = math.Min(md.min, om.min)
+				md.max = math.Max(md.max, om.max)
+			case 2:
+				f := pick(ht, []float64{2, 0.5, 3, 1})
+				s.Reweight(f)
+				md.count *= f
+				md.sum *= f
+				absSum *= f
+			case 3:
+				f := pick(ht, []float64{2, 0.5, -1, -3, 1})
+				s.Rescale(f)
+				md.sum *= f
+				absSum *= math.Abs(f)
+				if f < 0 {
+					md.min, md.max = md.max*f, md.min*f
+				} else {
+					md.min *= f
+					md.max *= f
+				}
+			case 4:
+				s = s.Copy()
+			case 5:
+				if chance(ht, 30) {
+					s.Clear()
+					md = fresh
+					absSum = 0
+				}
+			default:
+				v, cnt := genValue(ht), genCount(ht)
+				s.Add(v, cnt)
+				add(&md, v, cnt)
+			}
+		}
+		if !closeF(s.Count(), md.count) || s.Min() != md.min || s.Max() != md.max {
+			c.failClass(ht, "Stats", "count %g min %g max %g; want %g %g %g", s.Count(), s.Min(), s.Max(), md.count, md.min, md.max)
+		}
+		if !closeF(s.Sum(), md.sum) && math.Abs(s.Sum()-md.sum) > 1e-9*absSum {
+			c.failClass(ht, "Sum", "sum %g, want %g (sum of magnitudes %g)", s.Sum(), md.sum, absSum)
+		}
+		// Reweight(0) empties the statistics (an overflowed sum is already meaningless).
+		z := s.Copy()
+		z.Reweight(0)
+		if z.Count() != 0 || (z.Sum() != 0 && !math.IsInf(s.Sum(), 0)) || z.Min() != math.Inf(1) || z.Max() != math.Inf(-1) {
+			c.failClass(ht, "ReweightZero", "after Reweight(0): count %g sum %g min %g max %g", z.Count(), z.Sum(), z.Min(), z.Max())
+		}
+		// FromData: rebuilds the same; rejects inconsistent data.
+		fd, err := stat.NewSummaryStatisticsFromData(s.Count(), s.Sum(), s.Min(), s.Max())
+		if err != nil || fd.Count() != s.Count() || fd.Sum() != s.Sum() || fd.Min() != s.Min() || fd.Max() != s.Max() {
+			c.failClass(ht, "FromData", "FromData of (%g, %g, %g, %g): %v", s.Count(), s.Sum(), s.Min(), s.Max(), err)
+		}
+		if _, err := stat.NewSummaryStatisticsFromData(-1, 0, 1, 2); err == nil {
+			c.failClass(ht, "FromDataNegative", "FromData with count -1 accepted")
+		}
+		if _, err := stat.NewSummaryStatisticsFromData(math.NaN(), 0, 1, 2); err == nil {
+			c.failClass(ht, "FromDataNaN", "FromData with count NaN accepted")
+		}
+		if _, err := stat.NewSummaryStatisticsFromData(1, 0, 2, 1); err == nil {
+			c.failClass(ht, "FromDataMinMax", "FromData with min > max accepted")
+		}
+		if _, err := stat.NewSummaryStatisticsFromData(0, 0, 0, 0); err == nil {
+			c.failClass(ht, "FromDataEmpty", "FromData of an empty summary with finite min/max accepted")
+		}
+	})
+}
+
+func sameOrNaN(a, b float64) bool { return a == b || (math.IsNaN(a) && math.IsNaN(b)) }
