+package hegel
+
+// Hegel property tests for DataDog/sketches-go, written for the Hegel zoo. See targets/go/sketches-go/README.md.
+//
+// Oracle: an exact model of each sketch as the multiset of (value, count) pairs added to it,
+// from which the true quantiles, count, sum, min and max are computed; the DDSketch
+// relative-accuracy guarantee is checked against them, and the stores against a sorted map
+// of index -> count.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// DDSketch.AddWithCount accepts a NaN count (the guard is count < 0), so the sketch's
+	// count becomes NaN and every later query is arbitrary.
+	nanCountAccepted bool
+	// GetValueAtQuantile(NaN) returns a value and a nil error, though an invalid quantile
+	// is documented to return a non-nil error.
+	nanQuantileAccepted bool
+	// GetValueAtQuantile computes rank = q * (count - 1); when the total count is below 1
+	// (fractional counts) the rank is negative, the test "rank < negativeValueCount" holds
+	// with an empty negative store, and the answer is -Value(KeyAtRank of an empty store):
+	// -0 with a dense store, -(1 + alpha) with a sparse or buffered-paginated one, for a
+	// sketch holding only the value 5.
+	fractionalCountQuantile bool
+	// ChangeMapping splits each old bin [LowerBound(i), LowerBound(i+1)) over the new bins
+	// in proportion; when the old bin is the topmost one and LowerBound(i+1) overflows to
+	// +Inf (the logarithmic mapping) the proportions are 0 and NaN, so the bin's count is
+	// lost or the new sketch's counts become NaN; the interpolated mappings' LowerBound
+	// wraps to a tiny value there instead (exponent overflow in buildFloat64).
+	changeMappingTopBin bool
+	// The mapping constructors accept a NaN relative accuracy or gamma (the guards are
+	// "<= 0 || >= 1" and "<= 1"), so NewDefaultDDSketch(NaN) returns a sketch that maps
+	// every value to index MaxInt64.
+	nanAccuracyAccepted bool
+	// DecodeDDSketch is documented to read an encoded DDSketchWithExactSummaryStatistics
+	// (losing the statistics); it skips 8 bytes for the count block, which is a varfloat64
+	// of 1 to 9 bytes, so the stream desynchronises and decoding fails ("unknown encoding
+	// flag" or "unknown bin encoding") for every non-empty sketch whose count is not 8 bytes
+	// long.
+	plainDecodeOfExactSummary bool
+	// store.FromProto and MergeWithProto (hence ddsketch.FromProto) do not apply
+	// MaxDecodeIndexRange: a protobuf store with bins at MinInt32 and MaxInt32 makes the
+	// dense store allocate 2^32 float64s (34 GB), the allocation the limit exists to prevent.
+	protoIgnoresMaxDecodeIndexRange bool
+	// ChangeMapping with a scale factor (or a new mapping) that takes a bin's bounds outside
+	// the new mapping's indexable range: the bound underflows to 0, Index(0) is MinInt64, and
+	// a dense target store panics (slice bounds out of range) while a sparse one keeps the
+	// count at index MinInt64.
+	changeMappingOutOfRange bool
+	// CollapsingLowestDenseStore.MergeWith (and the Highest one) of another store of the same
+	// type whose bins span more than maxNumBins panics (slice bounds / index out of range in
+	// shiftCounts) when the receiver is empty: extendRange sets minIndex and maxIndex before
+	// adjust, which then takes the shift path with a shift beyond the array.
+	collapsingMergePanics bool
+}{true, true, true, true, true, true, true, true, true}
