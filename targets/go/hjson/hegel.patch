+		t.Fatalf("interface{} gets %s, Node gets %s", canon(v), canon(&n))
+	}
+}
+
+// hjson/13: a pointer-receiver MarshalJSON is called for a pointer value, as in encoding/json.
+func TestHegelPinPointerMarshaler(t *testing.T) {
+	text, err := hjson.Marshal(&mjPtr{N: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
