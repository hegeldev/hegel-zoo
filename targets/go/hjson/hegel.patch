+// roundTripValue: the model of TestHegelRoundTrip on one value: Marshal then Unmarshal gives
+// the value stringOutcome predicts.
+func roundTripValue(c *collector, ht *hegel.T, v interface{}, opts hjson.EncoderOptions, shape []string) {
+	want, ok, _, _ := expectedDecode(v, opts, true)
+	if !ok {
+		c.skip(ht, "document broken as recorded")
+	}
+	b, err := hjson.MarshalWithOptions(v, opts)
+	if err != nil {
+		c.fail(ht, "Marshal(%s): %v", canon(v), err)
+		return
+	}
+	var back interface{}
+	if err := hjson.Unmarshal(b, &back); err != nil {
+		c.mismatch(ht, "reject", shape, "Unmarshal rejects Marshal's output: %v\nvalue %s\ntext %q", err, show(canon(v)), show(string(b)))
+		return
+	}
+	if got := canon(back); got != canon(want) {
+		c.mismatch(ht, "value", shape, "round trip changes the value\n  value %s\n  want  %s\n  got   %s\n  text %q", show(canon(v)), show(canon(want)), show(got), show(string(b)))
