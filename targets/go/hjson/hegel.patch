+// ---- hjson/11 and hjson/12: number spellings
+
+// numDocCase: a number text as the root, an array element or a member value.
+type numDocCase struct {
+	text  string
+	where int
+}
+
+func (n numDocCase) GoString() string { return fmt.Sprintf("document %q", n.document()) }
+
+func (n numDocCase) document() string {
+	switch n.where {
+	case 1:
+		return "[" + n.text + "]"
+	case 2:
+		return "{a: " + n.text + "}"
+	}
+	return n.text + "\n"
+}
+
+// want wraps the number's value as the document denotes it.
+func (n numDocCase) want() interface{} {
+	v := numRecOf(n.text).value()
+	switch n.where {
+	case 1:
+		return []interface{}{v}
+	case 2:
+		return map[string]interface{}{"a": v}
+	}
+	return v
+}
+
+func numDocsOf(texts hegel.Generator[string]) hegel.Generator[numDocCase] {
+	return hegel.Composite(func(tc hegel.TestCase) numDocCase {
+		return numDocCase{text: hegel.Draw(tc, texts), where: hegel.Draw(tc, hegel.Integers(0, 2))}
+	})
+}
