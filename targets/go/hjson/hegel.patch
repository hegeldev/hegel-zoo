+package hegel
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- OrderedMap
+
+type kv struct {
+	k string
+	v interface{}
+}
+
+type omModel []kv
+
+func (m omModel) find(k string) int {
+	for i, e := range m {
+		if e.k == k {
+			return i
+		}
+	}
+	return -1
+}
+
+func (m omModel) keys() []string {
+	out := []string{}
+	for _, e := range m {
+		out = append(out, e.k)
+	}
+	return out
+}
+
+var apiKeys = []string{"a", "b", "c", "d", "", "k e y", "1"}
+
+var apiValues = asAny(hegel.Integers(0, 99))
+
+// apiOp is one operation on an OrderedMap or a Node: its kind, and a key, value and index
+// (the index is taken modulo the live size when the operation needs one).
+type apiOp struct {
+	kind int
+	key  string
+	val  interface{}
+	idx  int
+}
+
+func apiOpsOf(kinds int) hegel.Generator[apiOp] {
+	return hegel.Composite(func(tc hegel.TestCase) apiOp {
+		return apiOp{
+			kind: hegel.Draw(tc, hegel.Integers(0, kinds-1)),
+			key:  hegel.Draw(tc, hegel.SampledFrom(apiKeys)),
+			val:  hegel.Draw(tc, apiValues),
+			idx:  hegel.Draw(tc, hegel.Integers(0, 12)),
+		}
+	})
+}
+
+// omCase: an OrderedMap made empty or from a slice of pairs, and the operations on it.
+type omCase struct {
+	fromSlice bool
+	init      []kv
+	ops       []apiOp
+}
+
+var omCases = hegel.Composite(func(tc hegel.TestCase) omCase {
+	return omCase{
+		fromSlice: hegel.Draw(tc, chance(50)),
+		init: hegel.Draw(tc, upTo(hegel.Composite(func(tc hegel.TestCase) kv {
+			return kv{k: hegel.Draw(tc, hegel.SampledFrom(apiKeys)), v: hegel.Draw(tc, apiValues)}
+		}), 4)),
+		ops: hegel.Draw(tc, many(apiOpsOf(6), 1, 12)),
+	}
+})
+
+// checkOM compares an OrderedMap with the model after every step.
+func checkOM(c *collector, ht *hegel.T, om *hjson.OrderedMap, m omModel, step string) bool {
+	if !reflect.DeepEqual(om.Keys, m.keys()) && !(len(om.Keys) == 0 && len(m) == 0) {
+		c.failClass(ht, "keys", "%s: Keys %q, model %q", step, om.Keys, m.keys())
+		return false
+	}
+	if len(om.Map) != len(m) {
+		c.failClass(ht, "map", "%s: Map has %d entries, model %d", step, len(om.Map), len(m))
+		return false
+	}
+	for _, e := range m {
+		if got, ok := om.Map[e.k]; !ok || got != e.v {
+			c.failClass(ht, "map", "%s: Map[%q] = %v (%v), model %v", step, e.k, got, ok, e.v)
+			return false
+		}
+	}
+	if om.Len() != len(m) {
+		c.failClass(ht, "len", "%s: Len %d, model %d", step, om.Len(), len(m))
+		return false
+	}
+	return true
+}
+
+// TestHegelOrderedMap: OrderedMap.Insert/Set/DeleteIndex/DeleteKey/AtIndex/AtKey/Len against a
+// sequence model (an ordered list of pairs), with the documented return values.
+func TestHegelOrderedMap(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		oc := hegel.Draw(ht, omCases)
+		var om *hjson.OrderedMap
+		var m omModel
+		if !oc.fromSlice {
+			om = hjson.NewOrderedMap()
+		} else {
+			var init []hjson.KeyValue
+			for _, e := range oc.init {
+				init = append(init, hjson.KeyValue{Key: e.k, Value: e.v})
+				if j := m.find(e.k); j >= 0 {
+					m[j].v = e.v
+				} else {
+					m = append(m, e)
+				}
+			}
+			om = hjson.NewOrderedMapFromSlice(init)
+		}
+		if !checkOM(c, ht, om, m, "init") {
+			return
+		}
+		for _, op := range oc.ops {
+			var step string
+			k, v := op.key, op.val
+			switch op.kind {
+			case 0: // Insert
+				idx := op.idx % (len(m) + 1)
+				step = fmt.Sprintf("Insert(%d, %q, %v)", idx, k, v)
+				old, found := om.Insert(idx, k, v)
+				var wantOld interface{}
+				wantFound := false
+				if j := m.find(k); j >= 0 {
+					wantOld, wantFound = m[j].v, true
+					m[j].v = v
+				} else {
+					m = append(m[:idx], append(omModel{{k, v}}, m[idx:]...)...)
+				}
+				if old != wantOld || found != wantFound {
+					c.failClass(ht, "insert return", "%s returned (%v, %v), want (%v, %v)", step, old, found, wantOld, wantFound)
+					return
+				}
+			case 1: // Set
+				step = fmt.Sprintf("Set(%q, %v)", k, v)
+				old, found := om.Set(k, v)
+				var wantOld interface{}
+				wantFound := false
+				if j := m.find(k); j >= 0 {
+					wantOld, wantFound = m[j].v, true
+					m[j].v = v
+				} else {
+					m = append(m, kv{k, v})
+				}
+				if old != wantOld || found != wantFound {
+					c.failClass(ht, "set return", "%s returned (%v, %v), want (%v, %v)", step, old, found, wantOld, wantFound)
+					return
+				}
+			case 2: // DeleteIndex
+				if len(m) == 0 {
+					continue
+				}
+				idx := op.idx % len(m)
+				step = fmt.Sprintf("DeleteIndex(%d)", idx)
+				k, v := om.DeleteIndex(idx)
+				want := m[idx]
+				m = append(m[:idx], m[idx+1:]...)
+				if k != want.k || v != want.v {
+					c.failClass(ht, "deleteindex return", "%s returned (%q, %v), want (%q, %v)", step, k, v, want.k, want.v)
+					return
+				}
+			case 3: // DeleteKey
+				step = fmt.Sprintf("DeleteKey(%q)", k)
+				v, found := om.DeleteKey(k)
+				var wantV interface{}
+				wantFound := false
+				if j := m.find(k); j >= 0 {
+					wantV, wantFound = m[j].v, true
+					m = append(m[:j], m[j+1:]...)
+				}
+				if v != wantV || found != wantFound {
+					c.failClass(ht, "deletekey return", "%s returned (%v, %v), want (%v, %v)", step, v, found, wantV, wantFound)
+					return
+				}
+			case 4: // AtIndex
+				if len(m) == 0 {
+					continue
+				}
+				idx := op.idx % len(m)
+				step = fmt.Sprintf("AtIndex(%d)", idx)
+				if v := om.AtIndex(idx); v != m[idx].v {
+					c.failClass(ht, "atindex", "%s = %v, want %v", step, v, m[idx].v)
+					return
+				}
+			default: // AtKey
+				step = fmt.Sprintf("AtKey(%q)", k)
+				v, ok := om.AtKey(k)
+				var wantV interface{}
+				wantOK := false
+				if j := m.find(k); j >= 0 {
+					wantV, wantOK = m[j].v, true
+				}
+				if v != wantV || ok != wantOK {
+					c.failClass(ht, "atkey", "%s = (%v, %v), want (%v, %v)", step, v, ok, wantV, wantOK)
+					return
+				}
+			}
+			if !checkOM(c, ht, om, m, step) {
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- Node
+
+// nodeModel: the unwrapped values of a Node holding an OrderedMap (keys set) or a slice
+// (keys empty); nil for a Node holding nil.
+type nodeModel struct {
+	obj   bool
+	items omModel
+	set   bool // the Node holds a container (false: Value is nil)
+}
+
+func (n *nodeModel) len() int { return len(n.items) }
+
+// checkNode compares the container behind a Node with the model.
+func checkNode(c *collector, ht *hegel.T, node *hjson.Node, m *nodeModel, step string) bool {
+	if !m.set {
+		if node.Value != nil {
+			c.failClass(ht, "value", "%s: Node.Value = %v, model nil", step, node.Value)
+			return false
+		}
+		return true
+	}
+	if node.Len() != m.len() {
+		c.failClass(ht, "len", "%s: Len %d, model %d", step, node.Len(), m.len())
+		return false
+	}
+	switch cont := node.Value.(type) {
+	case *hjson.OrderedMap:
+		if !m.obj {
+			c.failClass(ht, "kind", "%s: Node holds an OrderedMap, model a slice", step)
+			return false
+		}
+		if !reflect.DeepEqual(cont.Keys, m.items.keys()) && !(len(cont.Keys) == 0 && m.len() == 0) {
+			c.failClass(ht, "keys", "%s: Keys %q, model %q", step, cont.Keys, m.items.keys())
+			return false
+		}
+		for _, e := range m.items {
+			elem, ok := cont.Map[e.k]
+			n, isNode := elem.(*hjson.Node)
+			if !ok || !isNode || n.Value != e.v {
+				c.failClass(ht, "map", "%s: Map[%q] = %#v, model %v", step, e.k, elem, e.v)
+				return false
+			}
+		}
+	case []interface{}:
+		if m.obj {
+			c.failClass(ht, "kind", "%s: Node holds a slice, model an OrderedMap", step)
+			return false
+		}
+		for i, e := range m.items {
+			n, isNode := cont[i].(*hjson.Node)
+			if !isNode || n.Value != e.v {
+				c.failClass(ht, "slice", "%s: [%d] = %#v, model %v", step, i, cont[i], e.v)
+				return false
+			}
+		}
+	default:
+		c.failClass(ht, "kind", "%s: Node holds %T", step, node.Value)
+		return false
+	}
+	return true
+}
+
+// nodeAPICase: a Node holding an empty object, an empty array or nil, and the operations on it.
+type nodeAPICase struct {
+	obj bool
+	set bool
+	ops []apiOp
+}
+
+var nodeAPICases = hegel.Composite(func(tc hegel.TestCase) nodeAPICase {
+	return nodeAPICase{obj: hegel.Draw(tc, chance(60)), set: hegel.Draw(tc, chance(50)), ops: hegel.Draw(tc, many(apiOpsOf(11), 1, 12))}
+})
+
+// TestHegelNodeAPI: the Node editing and lookup methods (SetKey, Insert, Append, SetIndex,
+// DeleteIndex, DeleteKey, AtIndex, AtKey, NI, NK, NKC, Len) on object and array nodes against
+// the same sequence model, with the documented return values and errors. Insert on an existing
+// key of an object node is the shape of hjson/2.
+func TestHegelNodeAPI(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nc := hegel.Draw(ht, nodeAPICases)
+		node := &hjson.Node{}
+		m := &nodeModel{obj: nc.obj}
+		if nc.set {
+			m.set = true
+			if m.obj {
+				node.Value = hjson.NewOrderedMap()
+			} else {
+				node.Value = []interface{}{}
+			}
+		}
+		if m.obj {
+			c.count("object")
+		} else {
+			c.count("array")
+		}
+		for _, op := range nc.ops {
+			var step string
+			k, v := op.key, op.val
+			switch op.kind {
+			case 0: // SetKey
+				step = fmt.Sprintf("SetKey(%q, %v)", k, v)
+				old, found, err := node.SetKey(k, v)
+				if !m.obj && m.set {
+					if err == nil {
+						c.failClass(ht, "setkey error", "%s on an array node: no error", step)
+						return
+					}
+					continue
+				}
+				m.set, m.obj = true, true
+				var wantOld interface{}
+				wantFound := false
+				if j := m.items.find(k); j >= 0 {
+					wantOld, wantFound = m.items[j].v, true
+					m.items[j].v = v
+				} else {
+					m.items = append(m.items, kv{k, v})
+				}
+				if err != nil || old != wantOld || found != wantFound {
+					c.failClass(ht, "setkey return", "%s returned (%v, %v, %v), want (%v, %v, nil)", step, old, found, err, wantOld, wantFound)
+					return
+				}
+			case 1: // Insert
+				if !m.set {
+					continue
+				}
+				idx := op.idx % (m.len() + 1)
+				step = fmt.Sprintf("Insert(%d, %q, %v)", idx, k, v)
+				old, found, err := node.Insert(idx, k, v)
+				if !m.obj {
+					k = "" // the key is ignored on an array node
+				}
+				var wantOld interface{}
+				wantFound := false
+				existing := false
+				if j := m.items.find(k); m.obj && j >= 0 {
+					existing = true
+					wantOld, wantFound = m.items[j].v, true
+					m.items[j].v = v
+					if Known.nodeInsertReturns {
+						wantOld, wantFound = nil, false
+					}
+				} else {
+					m.items = append(m.items[:idx], append(omModel{{k, v}}, m.items[idx:]...)...)
+				}
+				if err != nil || old != wantOld || found != wantFound {
+					c.mismatch(ht, "insert return", shapeIf(existing, "hjson/2"), "%s returned (%v, %v, %v), want (%v, %v, nil)", step, old, found, err, wantOld, wantFound)
+					return
+				}
+			case 2: // Append
+				step = fmt.Sprintf("Append(%v)", v)
+				err := node.Append(v)
+				if m.set && m.obj {
+					if err == nil {
+						c.failClass(ht, "append error", "%s on an object node: no error", step)
+						return
+					}
+					continue
+				}
+				m.set, m.obj = true, false
+				m.items = append(m.items, kv{"", v})
+				if err != nil {
+					c.failClass(ht, "append", "%s: %v", step, err)
+					return
+				}
+			case 3: // SetIndex
+				if !m.set || m.len() == 0 {
+					continue
+				}
+				idx := op.idx % m.len()
+				step = fmt.Sprintf("SetIndex(%d, %v)", idx, v)
+				k, old, err := node.SetIndex(idx, v)
+				want := m.items[idx]
+				m.items[idx].v = v
+				if err != nil || k != want.k || old != want.v {
+					c.failClass(ht, "setindex return", "%s returned (%q, %v, %v), want (%q, %v, nil)", step, k, old, err, want.k, want.v)
+					return
+				}
+			case 4: // DeleteIndex
+				if !m.set || m.len() == 0 {
+					continue
+				}
+				idx := op.idx % m.len()
+				step = fmt.Sprintf("DeleteIndex(%d)", idx)
+				k, v, err := node.DeleteIndex(idx)
+				want := m.items[idx]
+				m.items = append(m.items[:idx], m.items[idx+1:]...)
+				if err != nil || k != want.k || v != want.v {
+					c.failClass(ht, "deleteindex return", "%s returned (%q, %v, %v), want (%q, %v, nil)", step, k, v, err, want.k, want.v)
+					return
+				}
+			case 5: // DeleteKey
+				step = fmt.Sprintf("DeleteKey(%q)", k)
+				v, found, err := node.DeleteKey(k)
+				if !m.set || !m.obj {
+					if err == nil {
+						c.failClass(ht, "deletekey error", "%s on a non-object node: no error", step)
+						return
+					}
+					continue
+				}
+				var wantV interface{}
+				wantFound := false
+				if j := m.items.find(k); j >= 0 {
+					wantV, wantFound = m.items[j].v, true
+					m.items = append(m.items[:j], m.items[j+1:]...)
+				}
+				if err != nil || v != wantV || found != wantFound {
+					c.failClass(ht, "deletekey return", "%s returned (%v, %v, %v), want (%v, %v, nil)", step, v, found, err, wantV, wantFound)
+					return
+				}
+			case 6: // AtIndex
+				if !m.set || m.len() == 0 {
+					continue
+				}
+				idx := op.idx % m.len()
+				step = fmt.Sprintf("AtIndex(%d)", idx)
+				k, v, err := node.AtIndex(idx)
+				want := m.items[idx]
+				if err != nil || k != want.k || v != want.v {
+					c.failClass(ht, "atindex", "%s = (%q, %v, %v), want (%q, %v, nil)", step, k, v, err, want.k, want.v)
+					return
+				}
+			case 7: // AtKey
+				step = fmt.Sprintf("AtKey(%q)", k)
+				v, found, err := node.AtKey(k)
+				if !m.set || !m.obj {
+					if err == nil {
+						c.failClass(ht, "atkey error", "%s on a non-object node: no error", step)
+						return
+					}
+					continue
+				}
+				var wantV interface{}
+				wantFound := false
+				if j := m.items.find(k); j >= 0 {
+					wantV, wantFound = m.items[j].v, true
+				}
+				if err != nil || v != wantV || found != wantFound {
+					c.failClass(ht, "atkey", "%s = (%v, %v, %v), want (%v, %v, nil)", step, v, found, err, wantV, wantFound)
+					return
+				}
+			case 8: // NI
+				if !m.set || m.len() == 0 {
+					continue
+				}
+				idx := op.idx % m.len()
+				step = fmt.Sprintf("NI(%d)", idx)
+				n := node.NI(idx)
+				if n == nil || n.Value != m.items[idx].v {
+					c.failClass(ht, "ni", "%s = %#v, want a Node holding %v", step, n, m.items[idx].v)
+					return
+				}
+			case 9: // NK
+				step = fmt.Sprintf("NK(%q)", k)
+				n := node.NK(k)
+				var want *hjson.Node
+				if j := m.items.find(k); m.set && m.obj && j >= 0 {
+					if n == nil || n.Value != m.items[j].v {
+						c.failClass(ht, "nk", "%s = %#v, want a Node holding %v", step, n, m.items[j].v)
+						return
+					}
+				} else if n != want {
+					c.failClass(ht, "nk", "%s = %#v, want nil", step, n)
+					return
+				}
+			default: // NKC
+				step = fmt.Sprintf("NKC(%q)", k)
+				n := node.NKC(k)
+				if m.set && !m.obj {
+					if n != nil {
+						c.failClass(ht, "nkc", "%s on an array node = %#v, want nil", step, n)
+						return
+					}
+					continue
+				}
+				m.set, m.obj = true, true
+				j := m.items.find(k)
+				if j < 0 {
+					m.items = append(m.items, kv{k, nil})
+					j = len(m.items) - 1
+				}
+				if n == nil || n.Value != m.items[j].v {
+					c.failClass(ht, "nkc", "%s = %#v, want a Node holding %v", step, n, m.items[j].v)
+					return
+				}
+			}
+			if !checkNode(c, ht, node, m, step) {
+				return
+			}
+		}
+	})
+}
