+package hegel
+
+// One plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+)
+
+func decodeAny(t *testing.T, text string) (interface{}, error) {
+	t.Helper()
+	var v interface{}
+	err := hjson.Unmarshal([]byte(text), &v)
+	return v, err
+}
+
+// hjson/1: a \u surrogate pair decodes to the character it encodes, as in JSON.
+func TestHegelPinSurrogatePair(t *testing.T) {
+	// The JSON text "<backslash>ud83d<backslash>ude00" (built at runtime).
+	text := `"` + string(rune(92)) + "ud83d" + string(rune(92)) + `ude00"`
+	v, err := decodeAny(t, text)
+	if err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	if v != "\U0001F600" {
+		t.Fatalf("%s decodes to %q, want %q", text, v, "\U0001F600")
+	}
+}
+
+// hjson/2: Node.Insert on an existing key returns the old value and true.
+func TestHegelPinNodeInsertExistingKey(t *testing.T) {
+	var n hjson.Node
+	if _, _, err := n.SetKey("a", 1); err != nil {
+		t.Fatal(err)
+	}
+	old, found, err := n.Insert(0, "a", 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if old != 1 || !found {
+		t.Fatalf("Insert on the existing key a returned (%v, %v), want (1, true)", old, found)
+	}
+}
+
+// hjson/3: a document read into a Node is written back with its layout; the base indentation
+// is not doubled.
+func TestHegelPinNodeBaseIndentation(t *testing.T) {
+	o := hjson.DefaultOptions()
+	o.BaseIndentation = "    "
+	text, err := hjson.MarshalWithOptions(map[string]interface{}{"a": 1}, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var n hjson.Node
+	if err := hjson.Unmarshal(text, &n); err != nil {
+		t.Fatal(err)
+	}
+	again, err := hjson.MarshalWithOptions(n, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(again) != string(text) {
+		t.Fatalf("Marshal(node) = %q, want the text it was read from, %q", again, text)
+	}
+}
+
+func roundTrip(t *testing.T, v interface{}) interface{} {
+	t.Helper()
+	b, err := hjson.Marshal(v)
+	if err != nil {
+		t.Fatalf("Marshal: %v", err)
+	}
+	var back interface{}
+	if err := hjson.Unmarshal(b, &back); err != nil {
+		t.Fatalf("Unmarshal(%q): %v", b, err)
+	}
+	return back
+}
+
+// hjson/4: a string with a leading tab and a backslash survives the round trip.
+func TestHegelPinMultilineLeadingWhitespace(t *testing.T) {
+	v := map[string]interface{}{"a": "\tx\\y"}
+	back := roundTrip(t, v)
+	if !reflect.DeepEqual(back, v) {
+		t.Fatalf("round trip of %#v gives %#v", v, back)
+	}
+}
+
+// hjson/5: a string starting with a double quote and ending in a single quote survives the
+// round trip.
+func TestHegelPinMultilineTrailingQuote(t *testing.T) {
+	v := map[string]interface{}{"a": `"hi" she said'`, "b": 1.0}
+	back := roundTrip(t, v)
+	if !reflect.DeepEqual(back, v) {
+		t.Fatalf("round trip of %#v gives %#v", v, back)
+	}
+}
+
+// hjson/6: a string ending in a non-breaking space survives the round trip.
+func TestHegelPinQuotelessUnicodeSpace(t *testing.T) {
+	v := map[string]interface{}{"a": "x\u00a0"}
+	back := roundTrip(t, v)
+	if !reflect.DeepEqual(back, v) {
+		t.Fatalf("round trip of %#v gives %#v", v, back)
+	}
+}
+
+type commented struct {
+	A int `comment:"first line\nsecond line"`
+	B int
+}
+
+// hjson/7: a multi-line comment tag is written as comment lines under every Eol, and the output
+// reads back.
+func TestHegelPinCommentTagCRLF(t *testing.T) {
+	o := hjson.DefaultOptions()
+	o.Eol = "\r\n"
+	b, err := hjson.MarshalWithOptions(commented{A: 1, B: 2}, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var back commented
+	if err := hjson.Unmarshal(b, &back); err != nil {
+		t.Fatalf("Unmarshal(%q): %v", b, err)
+	}
+	if back != (commented{A: 1, B: 2}) {
+		t.Fatalf("round trip gives %+v", back)
+	}
+	if !strings.Contains(string(b), "# second line") {
+		t.Fatalf("the second comment line is not a comment: %q", b)
+	}
+}
+
+// hjson/8: a CRLF document read into a Node is written back with CRLF line ends.
+func TestHegelPinNodeCRLF(t *testing.T) {
+	o := hjson.DefaultOptions()
+	o.Eol = "\r\n"
+	text, err := hjson.MarshalWithOptions(map[string]interface{}{"a": 1, "b": []interface{}{1, 2}}, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var n hjson.Node
+	if err := hjson.Unmarshal(text, &n); err != nil {
+		t.Fatal(err)
+	}
+	again, err := hjson.MarshalWithOptions(n, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(again) != string(text) {
+		t.Fatalf("Marshal(node) = %q, want the text it was read from, %q", again, text)
+	}
+}
+
+// hjson/9: a root string containing a colon survives the round trip.
+func TestHegelPinRootStringColon(t *testing.T) {
+	back := roundTrip(t, "key:value")
+	if back != "key:value" {
+		t.Fatalf("round trip of the string key:value gives %#v", back)
+	}
+}
+
+// hjson/10: a multiline string in an array is written back with the same layout.
+func TestHegelPinNodeMultilineInArray(t *testing.T) {
+	text, err := hjson.Marshal([]interface{}{"a\nb"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var n hjson.Node
+	if err := hjson.Unmarshal(text, &n); err != nil {
+		t.Fatal(err)
+	}
+	again, err := hjson.Marshal(n)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(again) != string(text) {
+		t.Fatalf("Marshal(node) = %q, want the text it was read from, %q", again, text)
+	}
+}
+
+// hjson/11: a number with a trailing decimal point does not make Unmarshal fail with an
+// internal error (it is either the number or the quoteless string, as into a Node).
+func TestHegelPinTrailingDecimalPoint(t *testing.T) {
+	v, err := decodeAny(t, "a: 1.")
+	if err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	var n hjson.Node
+	if err := hjson.Unmarshal([]byte("a: 1."), &n); err != nil {
+		t.Fatalf("into Node: %v", err)
+	}
+	if canon(v) != canon(&n) {
+		t.Fatalf("interface{} gets %s, Node gets %s", canon(v), canon(&n))
+	}
+}
+
+// hjson/12: a number beyond float64 decodes the same way into interface{} and into a Node.
+func TestHegelPinHugeNumber(t *testing.T) {
+	v, err := decodeAny(t, "a: 1e400")
+	var n hjson.Node
+	errN := hjson.Unmarshal([]byte("a: 1e400"), &n)
+	if (err == nil) != (errN == nil) {
+		t.Fatalf("interface{}: %v (%s); Node: %v (%s)", err, canon(v), errN, canon(&n))
+	}
+	if err == nil && canon(v) != canon(&n) {
+		t.Fatalf("interface{} gets %s, Node gets %s", canon(v), canon(&n))
+	}
+}
diff --git a/hegel/hegel_quote_test.go b/hegel/hegel_quote_test.go
new file mode 100644
index 0000000..0e2a4fa
--- /dev/null
+++ b/hegel/hegel_quote_test.go
@@ -0,0 +1,171 @@
+package hegel
+
+import (
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+
+	hjson "github.com/hjson/hjson-go/v4"
+)
+
+// --------------------------------------------------------------------------- string quoting model
+
+// The encoder's tests (encode.go init), copied: which strings can be written quoteless, without
+// escapes, as a multiline string.
+var (
+	commonRange         = `\x7f-\x9f\x{00ad}\x{0600}-\x{0604}\x{070f}\x{17b4}\x{17b5}\x{200c}-\x{200f}\x{2028}-\x{202f}\x{2060}-\x{206f}\x{feff}\x{fff0}-\x{ffff}`
+	reNeedsEscape       = regexp.MustCompile(`[\\\"\x00-\x1f` + commonRange + `]`)
+	reNeedsQuotes       = regexp.MustCompile(`^\s|^"|^'|^#|^/\*|^//|^\{|^\}|^\[|^\]|^:|^,|\s$|[\x00-\x1f\x7f-\x9f\x{00ad}\x{0600}-\x{0604}\x{070f}\x{17b4}\x{17b5}\x{200c}-\x{200f}\x{2028}-\x{202f}\x{2060}-\x{206f}\x{feff}\x{fff0}-\x{ffff}]`)
+	reNeedsEscapeML     = regexp.MustCompile(`'''|^[\s]+$|[\x00-\x08\x0b-\x1f` + commonRange + `]`)
+	reStartsWithKeyword = regexp.MustCompile(`^(true|false|null)\s*((,|\]|\}|#|//|/\*).*)?$`)
+	// A quoteless root string the parser can read as a braceless root object: a key name (no
+	// whitespace, punctuator or quote) followed by a colon.
+	reRootColon = regexp.MustCompile(`^[^\x00-\x20{}\[\],:"']+:`)
+)
+
+// startsWithNumber: the encoder's test (tryParseNumber with stopAtNext), ported: the text is a
+// finite number optionally followed by whitespace and a punctuator or comment start.
+func startsWithNumber(text string) bool {
+	i := 0
+	next := func() byte {
+		if i < len(text) {
+			return text[i]
+		}
+		return 0
+	}
+	leadingZeros := 0
+	testLeading := true
+	if next() == '-' {
+		i++
+	}
+	for c := next(); c >= '0' && c <= '9'; c = next() {
+		if testLeading {
+			if c == '0' {
+				leadingZeros++
+			} else {
+				testLeading = false
+			}
+		}
+		i++
+	}
+	if testLeading {
+		leadingZeros--
+	}
+	if next() == '.' {
+		i++
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	if c := next(); c == 'e' || c == 'E' {
+		i++
+		if c := next(); c == '-' || c == '+' {
+			i++
+		}
+		if c := next(); c < '0' || c > '9' {
+			return false
+		}
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	end := i
+	for c := next(); c > 0 && c <= ' '; c = next() {
+		i++
+	}
+	c := next()
+	if c == ',' || c == '}' || c == ']' || c == '#' || (c == '/' && i+1 < len(text) && (text[i+1] == '/' || text[i+1] == '*')) {
+		c = 0
+	}
+	if c > 0 || leadingZeros != 0 {
+		return false
+	}
+	f, err := strconv.ParseFloat(text[:end], 64)
+	if err != nil || math.IsInf(f, 0) || math.IsNaN(f) {
+		return false
+	}
+	return true
+}
+
+// ambiguous: the string spells a number or a keyword (with a punctuator or comment after it),
+// which the encoder quotes only under QuoteAmbiguousStrings.
+func ambiguous(s string) bool {
+	return startsWithNumber(s) || reStartsWithKeyword.MatchString(s)
+}
+
+// stringOutcome models what a string value comes back as after MarshalWithOptions and
+// Unmarshal: the decoded string, and whether the text cannot be read back at all (an ambiguous
+// string written quoteless breaks the document by design; a single-line multiline string
+// ending in a quote runs into its closing delimiter, Known.mlTrailingQuote).
+func stringOutcome(s string, o hjson.EncoderOptions, root bool) (string, bool) {
+	if s == "" {
+		return s, false
+	}
+	quoted := o.QuoteAlways || reNeedsQuotes.MatchString(s) || (o.QuoteAmbiguousStrings && ambiguous(s))
+	if !quoted {
+		if ambiguous(s) {
+			return "", true
+		}
+		if root && Known.rootColonObject && reRootColon.MatchString(s) {
+			return "", true
+		}
+		if Known.trimUnicodeSpace {
+			return strings.TrimSpace(s), false
+		}
+		return s, false
+	}
+	if !reNeedsEscape.MatchString(s) {
+		return s, false
+	}
+	if !reNeedsEscapeML.MatchString(s) && !root {
+		if strings.Contains(s, "\n") {
+			return s, false
+		}
+		out := s
+		if Known.mlLeadingWhitespace {
+			out = strings.TrimLeft(out, " \t")
+		}
+		if Known.mlTrailingQuote && strings.HasSuffix(s, "'") {
+			return "", true
+		}
+		return out, false
+	}
+	return s, false
+}
+
+// expectedDecode applies stringOutcome to every string value of a tree; ok is false when some
+// string breaks the document. changed reports whether any string differs.
+func expectedDecode(v interface{}, o hjson.EncoderOptions, root bool) (out interface{}, ok, changed bool) {
+	switch x := v.(type) {
+	case string:
+		s, broken := stringOutcome(x, o, root)
+		if broken {
+			return nil, false, true
+		}
+		return s, true, s != x
+	case []interface{}:
+		arr := make([]interface{}, len(x))
+		for i, e := range x {
+			var c bool
+			arr[i], ok, c = expectedDecode(e, o, false)
+			if !ok {
+				return nil, false, true
+			}
+			changed = changed || c
+		}
+		return arr, true, changed
+	case map[string]interface{}:
+		m := make(map[string]interface{}, len(x))
+		for k, e := range x {
+			var c bool
+			m[k], ok, c = expectedDecode(e, o, false)
+			if !ok {
+				return nil, false, true
+			}
+			changed = changed || c
+		}
+		return m, true, changed
+	}
+	return v, true, false
+}
diff --git a/hegel/hegel_roundtrip_test.go b/hegel/hegel_roundtrip_test.go
new file mode 100644
index 0000000..022e039
--- /dev/null
+++ b/hegel/hegel_roundtrip_test.go
@@ -0,0 +1,255 @@
+package hegel
+
+import (
+	"encoding/json"
+	"math"
+	"reflect"
+	"sort"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelRoundTrip: MarshalWithOptions -> Unmarshal is the identity on JSON-shaped values
+// under every encoder option, up to the string outcomes stringOutcome models (with
+// QuoteAmbiguousStrings off, strings that spell a number or a keyword are ambiguous by design:
+// those cases are skipped); the same text read into a Node and into an OrderedMap gives the
+// same value, the OrderedMap's keys sorted as the encoder writes them.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		if chance(ht, 5) {
+			// A root string with a colon: the shape of a braceless root object.
+			v = pick(ht, []string{"key", "a", "x1", "a/b", "a b", "a,b", "1"}) + ":" + genString(ht)
+		}
+		opts := genEncoderOptions(ht)
+		want, ok, changed := expectedDecode(v, opts, true)
+		if !ok {
+			c.count("skipped: document broken by design or a known bug")
+			return
+		}
+		if changed {
+			c.count("string changed by a known bug")
+		}
+		b, err := hjson.MarshalWithOptions(v, opts)
+		if err != nil {
+			c.fail(ht, "Marshal(%s, %+v): %v", canon(v), opts, err)
+			return
+		}
+		text := string(b)
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.failClass(ht, "reject", "Unmarshal rejects Marshal's output: %v\n%+v\nvalue %s\ntext %q", err, opts, show(canon(v)), show(text))
+			return
+		}
+		if got := canon(back); got != canon(want) {
+			c.failClass(ht, "value", "round trip changes the value\n%+v\n  value %s\n  want  %s\n  got   %s\n  text %q", opts, show(canon(v)), show(canon(want)), show(got), show(text))
+			return
+		}
+
+		var node hjson.Node
+		if err := hjson.Unmarshal(b, &node); err != nil {
+			c.failClass(ht, "node reject", "into Node: %v\n%q", err, show(text))
+		} else if got, want := canon(&node), canon(back); got != want {
+			c.failClass(ht, "node value", "Node value differs from the interface{} value\n  node %s\n  want %s\n  text %q", show(got), show(want), show(text))
+		}
+
+		if m, ok := v.(map[string]interface{}); ok {
+			var om hjson.OrderedMap
+			if err := hjson.Unmarshal(b, &om); err != nil {
+				c.failClass(ht, "orderedmap reject", "into OrderedMap: %v\n%q", err, show(text))
+			} else {
+				keys := make([]string, 0, len(m))
+				for k := range m {
+					keys = append(keys, k)
+				}
+				sort.Strings(keys)
+				if !reflect.DeepEqual(om.Keys, keys) && !(len(keys) == 0 && len(om.Keys) == 0) {
+					c.failClass(ht, "key order", "OrderedMap keys %q, encoder order %q\n%q", om.Keys, keys, show(text))
+				} else if got, want := canon(&om), canon(back); got != want {
+					c.failClass(ht, "orderedmap value", "OrderedMap value %s, want %s\n%q", show(got), show(want), show(text))
+				}
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- typed values
+
+type rtInner struct {
+	X string
+	Y []interface{} `json:"y,omitempty"`
+}
+
+type rtEmbedded struct {
+	Emb    string
+	Shared int // hidden by rich.Shared (depth 0 wins)
+}
+
+type rich struct {
+	Str    string
+	Ptr    *string
+	Int    int64
+	Uint   uint64
+	I8     int8
+	F32    float32
+	F64    float64
+	B      bool
+	N      json.Number
+	Strs   []string
+	Ints   []int
+	Any    interface{}
+	Map    map[string]string
+	MapAny map[string]interface{}
+	Nested *rtInner
+	In     rtInner
+	rtEmbedded
+	Renamed string `json:"other name,omitempty" comment:"a comment\nsecond line"`
+	Ignored string `json:"-"`
+	Dash    string `json:"-,"`
+	Shared  string
+}
+
+var numberTexts = []string{"0", "1", "-1", "12345678901234567890", "1e5", "-0.5", "1E-7", "0.1", "-0"}
+
+// safeAny draws an interface{} value; without ambiguous strings when the encoder will not
+// quote them.
+func safeAny(tc hegel.TestCase, quoteAmbiguous bool) interface{} {
+	v := genValue(tc, 1)
+	if quoteAmbiguous {
+		return v
+	}
+	return unstring(v)
+}
+
+func unstring(v interface{}) interface{} {
+	switch x := v.(type) {
+	case string:
+		return float64(len(x))
+	case []interface{}:
+		for i := range x {
+			x[i] = unstring(x[i])
+		}
+	case map[string]interface{}:
+		for k := range x {
+			x[k] = unstring(x[k])
+		}
+	}
+	return v
+}
+
+func genRich(tc hegel.TestCase, quoteAmbiguous bool) rich {
+	r := rich{
+		Str:     genString(tc),
+		Int:     pick(tc, []int64{0, 1, -1, math.MaxInt64, math.MinInt64, 42, -1000}),
+		Uint:    pick(tc, []uint64{0, 1, math.MaxUint64, 1 << 53, 7}),
+		I8:      int8(drawInt(tc, -128, 127)),
+		F32:     pick(tc, []float32{0, 0.1, 1e-3, 3.5, 16777217, math.MaxFloat32, -2.25}),
+		F64:     genNumber(tc),
+		B:       chance(tc, 50),
+		N:       json.Number(pick(tc, numberTexts)),
+		Strs:    []string{},
+		Ints:    []int{},
+		Any:     safeAny(tc, quoteAmbiguous),
+		Map:     map[string]string{},
+		MapAny:  map[string]interface{}{},
+		In:      rtInner{X: genString(tc)},
+		Renamed: pick(tc, []string{"", "r", "1", "x y"}),
+		Ignored: "ignored",
+		Dash:    genString(tc),
+		Shared:  genString(tc),
+	}
+	r.Emb = genString(tc)
+	if chance(tc, 50) {
+		s := genString(tc)
+		r.Ptr = &s
+	}
+	for i := drawInt(tc, 0, 3); i > 0; i-- {
+		r.Strs = append(r.Strs, genString(tc))
+		r.Ints = append(r.Ints, drawInt(tc, -100, 100))
+		r.Map[genKey(tc)] = genString(tc)
+		r.MapAny[genKey(tc)] = safeAny(tc, quoteAmbiguous)
+	}
+	if chance(tc, 50) {
+		r.Nested = &rtInner{X: genString(tc)}
+		if chance(tc, 50) {
+			r.Nested.Y = []interface{}{safeAny(tc, quoteAmbiguous)}
+		}
+	}
+	if chance(tc, 50) {
+		r.In.Y = []interface{}{safeAny(tc, quoteAmbiguous), safeAny(tc, quoteAmbiguous)}
+	}
+	return r
+}
+
+// richPreserved reports whether every string in r comes back unchanged (stringOutcome); the
+// typed round trip skips the others, which TestHegelRoundTrip covers.
+func richPreserved(r rich, o hjson.EncoderOptions) bool {
+	keep := func(s string) bool {
+		out, broken := stringOutcome(s, o, false)
+		return !broken && out == s
+	}
+	strs := []string{r.Str, r.In.X, r.Emb, r.Renamed, r.Dash, r.Shared}
+	if r.Ptr != nil {
+		strs = append(strs, *r.Ptr)
+	}
+	if r.Nested != nil {
+		strs = append(strs, r.Nested.X)
+	}
+	strs = append(strs, r.Strs...)
+	for _, s := range r.Map {
+		strs = append(strs, s)
+	}
+	for _, s := range strs {
+		if !keep(s) {
+			return false
+		}
+	}
+	for _, v := range []interface{}{r.Any, r.MapAny, r.In.Y} {
+		if _, ok, changed := expectedDecode(v, o, false); !ok || changed {
+			return false
+		}
+	}
+	if r.Nested != nil {
+		if _, ok, changed := expectedDecode(r.Nested.Y, o, false); !ok || changed {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelTypedRoundTrip: a struct with fields of every supported kind, tags and an embedded
+// struct marshals and unmarshals back to itself under every encoder option (typed
+// destinations are never ambiguous: a quoteless 1 is the string "1" in a string field).
+func TestHegelTypedRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		opts := genEncoderOptions(ht)
+		r := genRich(ht, opts.QuoteAmbiguousStrings)
+		if Known.commentTagEol && opts.Comments && opts.Eol == "\r\n" && r.Renamed != "" {
+			c.count("skipped: multi-line comment tag with CRLF")
+			return
+		}
+		if !richPreserved(r, opts) {
+			c.count("skipped: string not preserved")
+			return
+		}
+		b, err := hjson.MarshalWithOptions(r, opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		var back rich
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.failClass(ht, "reject", "Unmarshal rejects Marshal's output: %v\n%+v\n%q", err, opts, show(string(b)))
+			return
+		}
+		want := r
+		want.Ignored = ""
+		if !reflect.DeepEqual(back, want) {
+			c.failClass(ht, "value", "typed round trip differs\n%+v\n  want %s\n  got  %s\n  text %q", opts, show(string(mustJSON(want))), show(string(mustJSON(back))), show(string(b)))
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..fcb6350
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,162 @@
+package hegel
+
+// Hegel property tests for hjson/hjson-go, written for the Hegel zoo. See
+// targets/go/hjson/README.md.
+//
+// Oracles: encoding/json on JSON texts (Hjson is a superset of JSON, so every JSON text must
+// decode to the same value); the Marshal -> Unmarshal round trip over generated values and
+// encoder options; the Node fixed point (the encoder's own output, read into a Node with its
+// whitespace and comments, encodes to the same text); a model of the Hjson grammar for
+// generated Hjson documents; a sequence model of the OrderedMap and Node editing methods.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	surrogatePairs      bool // 1: a \u surrogate pair in a quoted string decodes as two U+FFFD instead of the character
+	nodeInsertReturns   bool // 2: Node.Insert on an existing key returns (nil, false) instead of the old value and true
+	baseIndentDoubled   bool // 3: a Node read from the encoder's output is encoded with the BaseIndentation twice on the first line
+	mlLeadingWhitespace bool // 4: a single-line ''' string loses its leading spaces and tabs
+	mlTrailingQuote     bool // 5: a single-line ''' string ending in a quote runs into its closing delimiter
+	trimUnicodeSpace    bool // 6: a quoteless string is trimmed of Unicode spaces (U+00A0, U+3000) the encoder does not quote
+	commentTagEol       bool // 7: a multi-line comment tag is split on Eol, so with Eol CRLF the later lines are not comments
+	crlfDoubled         bool // 8: a CRLF document read into a Node (whitespace kept) is written back with CR CR LF line ends
+	rootColonObject     bool // 9: a root string containing a colon is written quoteless and read back as an object
+	mlArrayBlankLine    bool // 10: a multiline string in an array gains an indented blank line at each Node round trip
+	trailingDotInternal bool // 11: (pin only) Unmarshal fails with Internal error on a number with a trailing decimal point
+	hugeNumberString    bool // 12: (pin only) a number beyond float64 is a string in a Node but an error into interface{}
+}{true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
