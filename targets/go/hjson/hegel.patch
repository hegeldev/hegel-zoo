+// ---- hjson/14 and hjson/16: type hints
+
+// decodeHinted: the oracle of TestHegelTypedHints on one document and its model JSON.
+func decodeHinted(c *collector, ht *hegel.T, w *hintWriter, modelJSON string, want, got *hinted, shape []string) {
+	text := w.hj.sb.String()
+	shape = append(shape, w.shapes()...)
+	wantErr := json.NewDecoder(bytes.NewReader([]byte(modelJSON))).Decode(want)
+	gotErr := hjson.Unmarshal([]byte(text), got)
+	if trailingDotAccepted(c, w, gotErr) {
+		return
+	}
+	if (wantErr == nil) != (gotErr == nil) {
+		c.mismatch(ht, "error", shape, "%q\nmodel %s\n  hjson err %v\n  json err  %v", show(text), modelJSON, gotErr, wantErr)
+		return
+	}
+	if wantErr != nil {
+		c.count("both error")
+		return
+	}
+	if !reflect.DeepEqual(want, got) {
+		c.mismatch(ht, "value", shape, "%q\nmodel %s\n  got  %s\n  want %s", show(text), modelJSON, showHinted(got), showHinted(want))
+	}
+}
+
+// elemHintCase: quoteless tokens for TextUnmarshaler destinations at one of several positions.
+type elemHintCase struct {
+	where int // 0 slice elements, 1 map value, 2 field behind a nil pointer; 3 field, 4 field of an embedded struct value, 5 field behind a non-nil pointer
+	toks  []string
+	key   string
+	pre   prefill
+}
+
+func elemHintCasesAt(wheres []int) hegel.Generator[elemHintCase] {
+	return hegel.Composite(func(tc hegel.TestCase) elemHintCase {
+		return elemHintCase{
+			where: hegel.Draw(tc, hegel.SampledFrom(wheres)),
+			toks:  hegel.Draw(tc, many(hegel.SampledFrom(hintTokens), 1, 3)),
+			key:   hegel.Draw(tc, hegel.SampledFrom(hintKeys)),
+			pre:   hegel.Draw(tc, prefills),
+		}
+	})
+}
+
+// TestHegelTextUnmarshalerElementHints: quoteless values for TextUnmarshaler destinations
+// that are slice elements, map values or fields behind a nil pointer are strings, as for any
+// TextUnmarshaler destination (the model of TestHegelTypedHints). Under HEGEL_NO_KNOWN=1 the
+// destinations are struct fields reached without a nil pointer.
+func TestHegelTextUnmarshalerElementHints(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, shaped[hegel.Generator[elemHintCase]](elemHintCasesAt([]int{0, 1, 2}), elemHintCasesAt([]int{3, 4, 5})))
+		pre := ec.pre
+		pre.sub = ec.where == 5
+		want, got := pre.build(), pre.build()
+		w := &hintWriter{hj: &hjWriter{}, depth: 2}
+		root := hint{dest: reflect.ValueOf(got).Elem(), t: reflect.TypeOf(got)}
+		w.hj.write("{")
+		w.line(2)
+		var model string
+		switch ec.where {
+		case 0:
+			w.hj.write("TS: [")
+			var parts []string
+			for _, tok := range ec.toks {
+				w.line(4)
+				parts = append(parts, w.token(root.child("TS").elem(), tok))
+			}
+			w.line(2)
+			w.hj.write("]")
+			model = `{"TS":[` + strings.Join(parts, ",") + `]}`
+		case 1:
+			w.hj.write("TM: {")
+			w.line(4)
+			w.hj.write(w.writeKeyPlain(ec.key) + ": ")
+			v := w.token(root.child("TM").child(ec.key), ec.toks[0])
+			w.line(2)
+			w.hj.write("}")
+			model = `{"TM":{` + jsonString(ec.key) + ":" + v + `}}`
+		case 2, 5:
+			w.hj.write("Sub: {")
+			w.line(4)
+			w.hj.write("T: ")
+			v := w.token(root.child("Sub").child("T"), ec.toks[0])
+			w.line(2)
+			w.hj.write("}")
+			model = `{"Sub":{"T":` + v + `}}`
+		case 3:
+			w.hj.write("T: ")
+			model = `{"T":` + w.token(root.child("T"), ec.toks[0]) + `}`
+		default:
+			w.hj.write("In: {")
+			w.line(4)
+			w.hj.write("T: ")
+			v := w.token(root.child("In").child("T"), ec.toks[0])
+			w.line(2)
+			w.hj.write("}")
+			model = `{"In":{"T":` + v + `}}`
+		}
+		w.line(0)
+		w.hj.write("}")
+		decodeHinted(c, ht, w, model, want, got, known("hjson/14"))
+	})
+}
+
+// writeKeyPlain is the key quoteless when it can be, else in double quotes.
+func (w *hintWriter) writeKeyPlain(k string) string {
+	if k != "" && !strings.ContainsAny(k, " \t\n\r{}[],:\"'#/") {
+		return k
+	}
+	return jsonString(k)
+}
+
+// foldableFields: the fields of hinted whose names hold an s or S (the long s folds onto it).
+var foldableFields = func() []int {
+	var out []int
+	for i, f := range structFields(reflect.TypeOf(hinted{})) {
+		if strings.ContainsAny(f.name, "sS") {
+			out = append(out, i)
+		}
+	}
+	return out
+}()
+
+// foldedKeyDocs: a document of one member whose key spells a field name with the long s (the
+// shape of hjson/16) or in another case (lower, upper), with a value fitting the field.
+func foldedKeyDocs(spellings []int) hegel.Generator[hintDoc] {
+	return hegel.Composite(func(tc hegel.TestCase) hintDoc {
+		m := hegel.Draw(tc, hintMembersOf(hintLevels[1]))
+		m.useField = true
+		m.fieldIx = foldableFields[hegel.Draw(tc, hegel.Integers(0, len(foldableFields)-1))]
+		m.spelling = hegel.Draw(tc, hegel.SampledFrom(spellings))
+		m.plainKey = true
+		return hintDoc{pre: hegel.Draw(tc, prefills), braces: true, members: []hintMember{m}}
+	})
+}
