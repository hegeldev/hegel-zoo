+// build makes the struct type with the comment tags and a value of it.
+func (tc tagCase) build() (reflect.Type, reflect.Value) {
+	var sfs []reflect.StructField
+	for i, f := range tc.fields {
+		typ := reflect.TypeOf(0)
+		if f.str {
+			typ = reflect.TypeOf("")
+		}
+		sfs = append(sfs, reflect.StructField{
+			Name: fmt.Sprintf("F%d", i),
+			Type: typ,
+			Tag:  reflect.StructTag(fmt.Sprintf("comment:%q", strings.Join(f.lines, "\n"))),
+		})
+	}
+	t := reflect.StructOf(sfs)
+	v := reflect.New(t)
+	for i, f := range tc.fields {
+		if f.str {
+			v.Elem().Field(i).SetString(f.s)
+		} else {
+			v.Elem().Field(i).SetInt(int64(f.n))
+		}
+	}
+	return t, v
+}
