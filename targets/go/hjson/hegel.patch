+// objectDocOf makes a document of an object with the member first and more members after.
+func objectDocOf(tc hegel.TestCase, open gapRec, first memberRec) commentCase {
+	more := hegel.Draw(tc, upTo(hegel.Composite(func(tc hegel.TestCase) memberRec {
+		return memberRec{sep: hegel.Draw(tc, seps), key: keyRec{plain: hegel.Draw(tc, plainKeys)}, postColon: gapRec{items: []gapItem{{kind: 0}}}, val: hegel.Draw(tc, nodeAt(0))}
+	}), 2))
+	obj := hjNode{kind: 6, open: open, members: append([]memberRec{first}, more...), close: hegel.Draw(tc, closings)}
+	return commentCase{doc: hjDoc{root: obj}, whitespace: hegel.Draw(tc, chance(60))}
+}
+
+var (
+	// mlAfterKeyComment: a comment between a key's colon and its multi-line string value (the
+	// shape of hjson/18).
+	mlAfterKeyComment = hegel.Composite(func(tc hegel.TestCase) commentCase {
+		first := memberRec{key: keyRec{plain: hegel.Draw(tc, plainKeys)}, postColon: hegel.Draw(tc, commentGaps), val: hjNode{kind: 4, ml: hegel.Draw(tc, multiLineMLs)}}
+		return objectDocOf(tc, hegel.Draw(tc, gaps), first)
+	})
+	// mlOtherComment: the comment before the key, or a quoted value after the comment.
+	mlOtherComment = hegel.Composite(func(tc hegel.TestCase) commentCase {
+		if hegel.Draw(tc, chance(50)) {
+			first := memberRec{key: keyRec{plain: hegel.Draw(tc, plainKeys)}, postColon: gapRec{items: []gapItem{{kind: 0}}}, val: hjNode{kind: 4, ml: hegel.Draw(tc, multiLineMLs)}}
+			return objectDocOf(tc, hegel.Draw(tc, commentGaps), first)
+		}
+		first := memberRec{key: keyRec{plain: hegel.Draw(tc, plainKeys)}, postColon: hegel.Draw(tc, commentGaps), val: hjNode{kind: 3, qt: hegel.Draw(tc, quotedOf(asciiStrs))}}
+		return objectDocOf(tc, hegel.Draw(tc, gaps), first)
+	})
+)
+
+// TestHegelMultilineAfterKeyComment: an object member whose multi-line string value follows a
+// comment after the key's colon, read into a Node and written again, keeps its value (the
+// model of TestHegelCommentRoundTrip). Under HEGEL_NO_KNOWN=1 the comment precedes the key, or
+// the value is a quoted string.
+func TestHegelMultilineAfterKeyComment(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, shaped[hegel.Generator[commentCase]](mlAfterKeyComment, mlOtherComment))
+		checkCommentRoundTrip(c, ht, cc, known("hjson/18"))
+	})
+}
+
+// ---- hjson/19: strings spelling numbers beyond float64
+
+var (
+	// hugeStrings: a string spelling a number beyond float64, alone or before a terminator
+	// (the shape of hjson/19).
+	hugeStrings = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, hugeTexts) + hegel.Draw(tc, maybe(30, hegel.SampledFrom([]string{",x", " ,", "]", "}", " # c", "//c", "/*c*/"})))
+	})
+	// numberLikeStrings: a number within float64 (quoted as ambiguous), or a huge spelling
+	// followed by a letter (not a number).
+	numberLikeStrings = weighted(
+		choice[string]{1, largeTexts},
+		choice[string]{1, hegel.Map(hugeTexts, func(s string) string { return s + "x" })},
+	)
+)
+
+// TestHegelHugeNumberStrings: a string spelling a number beyond float64 round trips as the
+// string (the model of TestHegelRoundTrip), as the root or a member value. Under
+// HEGEL_NO_KNOWN=1 the string spells a number within float64 or is not a number.
+func TestHegelHugeNumberStrings(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, shaped[hegel.Generator[string]](hugeStrings, numberLikeStrings))
+		var v interface{} = s
+		if hegel.Draw(ht, chance(50)) {
+			v = map[string]interface{}{"a": s}
+		}
+		opts := hjson.DefaultOptions()
+		opts.QuoteAmbiguousStrings = true
+		roundTripValue(c, ht, v, opts, known("hjson/19"))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..cba7bbd
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,345 @@
+package hegel
+
+// Hegel property tests for hjson/hjson-go, written for the Hegel zoo. See
+// targets/go/hjson/README.md.
+//
+// Oracles: encoding/json on JSON texts (Hjson is a superset of JSON, so every JSON text must
+// decode to the same value); the Marshal -> Unmarshal round trip over generated values and
+// encoder options; the Node fixed point (the encoder's own output, read into a Node with its
+// whitespace and comments, encodes to the same text); a model of the Hjson grammar for
+// generated Hjson documents; a sequence model of the OrderedMap and Node editing methods.
+//
+// Every property draws one case from package-level generator values built from the binding's
+// combinators (a value tree, an options record, a document as a tree of syntax records, an
+// operation list) and pure functions render the case into the texts the library and the
+// models see. The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate and
+// the models say what the documentation says, so the properties that meet a shape fail naming
+// it (mismatch) and are the expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_shapes_test.go has one property per bug over its shape region alone, and the pins in
+// hegel_pins_test.go are the regression examples. HEGEL_NO_KNOWN=1 (noKnown, read once)
+// switches the Known switches on: the models then reproduce the recorded behaviour and the
+// skips of the old test apply, for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// skip counts the class and rejects the case (a case the model cannot judge).
+func (c *collector) skip(ht *hegel.T, class string) {
+	c.count("skipped: " + class)
+	ht.Assume(false)
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case that has the shape of the recorded
+// bugs named (none for a plain failure): the failure names the shape, and while every switch
+// of the shape is on (HEGEL_NO_KNOWN=1) a disagreement on it is skipped instead (rare then,
+// since the models reproduce the recorded behaviour).
+func (c *collector) mismatch(ht *hegel.T, class string, shape []string, format string, args ...any) {
+	shape = dedupShapes(shape)
+	if len(shape) > 0 {
+		ht.Assume(!gated(shape))
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 (read once) switches the Known switches on, so that the models
+// reproduce the recorded behaviour and the skips apply, for a run that looks past the recorded
+// bugs. By default (DESIGN.md decision 3) the switches are off: the models say what the
+// documentation says, the generators draw every shape, and the properties fail on them.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). A model reproduces a behaviour while its switch is on
+// (HEGEL_NO_KNOWN=1 only); the pins assert the documented behaviour and fail while the bug
+// exists, and hegel_shapes_test.go has one property per bug.
+var Known = struct {
+	surrogatePairs      bool // 1: a \u surrogate pair in a quoted string decodes as two U+FFFD instead of the character
+	nodeInsertReturns   bool // 2: Node.Insert on an existing key returns (nil, false) instead of the old value and true
+	baseIndentDoubled   bool // 3: a Node read from the encoder's output is encoded with the BaseIndentation twice on the first line
+	mlLeadingWhitespace bool // 4: a single-line ''' string loses its leading spaces and tabs
+	mlTrailingQuote     bool // 5: a single-line ''' string ending in a quote runs into its closing delimiter
+	trimUnicodeSpace    bool // 6: a quoteless string is trimmed of Unicode spaces (U+00A0, U+3000) the encoder does not quote
+	commentTagEol       bool // 7: a multi-line comment tag is split on Eol, so with Eol CRLF the later lines are not comments
+	crlfDoubled         bool // 8: a CRLF document read into a Node (whitespace kept) is written back with CR CR LF line ends
+	rootColonObject     bool // 9: a root string containing a colon is written quoteless and read back as an object
+	mlArrayBlankLine    bool // 10: a multiline string in an array gains an indented blank line at each Node round trip
+	trailingDotInternal bool // 11: Unmarshal into interface{} fails with Internal error on a number with a trailing decimal point
+	hugeNumberString    bool // 12: a number beyond float64 is a string in a Node but an error into interface{}
+	ptrMarshalers       bool // 13: a pointer-receiver MarshalJSON or MarshalText is never called (the encoder dereferences first)
+	textElemHint        bool // 14: pointer-receiver TextUnmarshaler slice elements, map values and fields behind a nil pointer get no string hint
+	mapKeyOrder         bool // 15: TextMarshaler map keys are sorted by their Go value, not by their text
+	foldKeys            bool // 16: the hint lookup lowercases keys, so a key encoding/json folds onto a field (long s) gets no hint
+	rootAfterDoubled    bool // 17: a comment (or kept whitespace) after a root scalar is written twice by a Node round trip
+	mlAfterKeyComment   bool // 18: a multiline string after a key comment ending in a line feed is indented so that it reads back changed
+	hugeNumberQuoteless bool // 19: a string spelling a number beyond float64 is written quoteless and fails to read into interface{}
+}{
+	surrogatePairs:      noKnown,
+	nodeInsertReturns:   noKnown,
+	baseIndentDoubled:   noKnown,
+	mlLeadingWhitespace: noKnown,
+	mlTrailingQuote:     noKnown,
+	trimUnicodeSpace:    noKnown,
+	commentTagEol:       noKnown,
+	crlfDoubled:         noKnown,
+	rootColonObject:     noKnown,
+	mlArrayBlankLine:    noKnown,
+	trailingDotInternal: noKnown,
+	hugeNumberString:    noKnown,
+	ptrMarshalers:       noKnown,
+	textElemHint:        noKnown,
+	mapKeyOrder:         noKnown,
+	foldKeys:            noKnown,
+	rootAfterDoubled:    noKnown,
+	mlAfterKeyComment:   noKnown,
+	hugeNumberQuoteless: noKnown,
+}
+
+// gates are the switches by bug id; hjson/20 (the empty last value of a braceless root object,
+// which the models never reproduce) is gated by noKnown itself.
+var gates = map[string]bool{
+	"hjson/1":  Known.surrogatePairs,
+	"hjson/2":  Known.nodeInsertReturns,
+	"hjson/3":  Known.baseIndentDoubled,
+	"hjson/4":  Known.mlLeadingWhitespace,
+	"hjson/5":  Known.mlTrailingQuote,
+	"hjson/6":  Known.trimUnicodeSpace,
+	"hjson/7":  Known.commentTagEol,
+	"hjson/8":  Known.crlfDoubled,
+	"hjson/9":  Known.rootColonObject,
+	"hjson/10": Known.mlArrayBlankLine,
+	"hjson/11": Known.trailingDotInternal,
+	"hjson/12": Known.hugeNumberString,
+	"hjson/13": Known.ptrMarshalers,
+	"hjson/14": Known.textElemHint,
+	"hjson/15": Known.mapKeyOrder,
+	"hjson/16": Known.foldKeys,
+	"hjson/17": Known.rootAfterDoubled,
+	"hjson/18": Known.mlAfterKeyComment,
+	"hjson/19": Known.hugeNumberQuoteless,
+	"hjson/20": noKnown,
+}
+
+// gated reports whether every switch of the shape is on.
+func gated(shape []string) bool {
+	for _, id := range shape {
+		if !gates[id] {
+			return false
+		}
+	}
+	return true
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a narrow property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// shaped is the generator (or value) for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// upTo is a list of up to n elements whose length is drawn first, so that the empty list is
+// as likely as any other length (Lists().MaxSize(n) almost never draws it) and the shrink
+// target.
+func upTo[T any](g hegel.Generator[T], n int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(0, n), func(k int) hegel.Generator[[]T] { return many(g, k, k) })
+}
+
+// joined is the concatenation of a list of pieces.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// asAny widens a generator's values to interface{} (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[interface{}] {
+	return hegel.Map(g, func(x T) interface{} { return x })
+}
+
+// nonNilSlice and nonNilMap: Lists and Maps yield nil for zero elements; the values here are
+// empty containers.
+func nonNilSlice[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// at is the element of a tape at position i taken modulo its length, or the zero value for an
+// empty tape (the plain spelling).
+func at[T any](tape []T, i int) T {
+	if len(tape) == 0 {
+		var zero T
+		return zero
+	}
+	return tape[i%len(tape)]
+}
