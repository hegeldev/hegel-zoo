+// hjson/16: a key encoding/json matches to a field case-insensitively (the long s folds to S)
+// gets the field's type hint.
+func TestHegelPinFoldedKeyHint(t *testing.T) {
+	var v struct{ Str string }
+	key := string(rune(0x17f)) + "tr" // long s, t, r
+	if err := hjson.Unmarshal([]byte(key+": 123"), &v); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	if v.Str != "123" {
+		t.Fatalf("Str = %q, want 123", v.Str)
+	}
+}
+
+// hjson/17: a comment after a root scalar value is written once by the Node round trip.
+func TestHegelPinRootCommentDoubled(t *testing.T) {
+	var n hjson.Node
+	if err := hjson.Unmarshal([]byte("1 # c"), &n); err != nil {
+		t.Fatal(err)
+	}
+	text, err := hjson.Marshal(n)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Count(string(text), "# c") != 1 {
+		t.Fatalf("1 # c is written back as %q: the comment appears twice", text)
+	}
+}
+
+// hjson/18: a multiline string whose key comment ends with a line feed keeps its value
+// through a Node round trip.
+func TestHegelPinMultilineAfterKeyComment(t *testing.T) {
+	q := "'" + "'" + "'"
+	text := "a: # c\n" + q + "\n  x\n  y\n" + q
+	var want interface{}
+	if err := hjson.Unmarshal([]byte(text), &want); err != nil {
+		t.Fatal(err)
+	}
+	var n hjson.Node
+	if err := hjson.Unmarshal([]byte(text), &n); err != nil {
+		t.Fatal(err)
+	}
+	again, err := hjson.Marshal(n)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got interface{}
+	if err := hjson.Unmarshal(again, &got); err != nil {
+		t.Fatalf("re-encoded text %q: %v", again, err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%q reads as %v; written back as %q it reads as %v", text, want, again, got)
+	}
+}
+
+// hjson/19: a string that spells a number beyond float64 is quoted by the encoder (ambiguous
+// strings are quoted by default), so it reads back as the string.
+func TestHegelPinHugeNumberString(t *testing.T) {
+	text, err := hjson.Marshal("1e400")
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := decodeAny(t, string(text))
+	if err != nil {
+		t.Fatalf("Marshal(\"1e400\") wrote %q, which does not read back: %v", text, err)
+	}
+	if v != "1e400" {
+		t.Fatalf("Marshal(\"1e400\") wrote %q, which reads back as %#v", text, v)
+	}
+}
+
+// hjson/20: a braceless root object whose last member has no value (the input ends after the
+// colon) is not read as an object holding the string NUL.
+func TestHegelPinEmptyLastValue(t *testing.T) {
+	v, err := decodeAny(t, "a:")
+	if err == nil && containsNUL(v) {
+		t.Fatalf("Unmarshal(\"a:\") = %s: a NUL character the document does not contain", canon(v))
+	}
+}
diff --git a/hegel/hegel_quote_test.go b/hegel/hegel_quote_test.go
new file mode 100644
index 0000000..5f5b979
--- /dev/null
+++ b/hegel/hegel_quote_test.go
@@ -0,0 +1,256 @@
+package hegel
+
+import (
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+
+	hjson "github.com/hjson/hjson-go/v4"
+)
+
+// --------------------------------------------------------------------------- string quoting model
+
+// The encoder's tests (encode.go init), copied: which strings can be written quoteless, without
+// escapes, as a multiline string.
+var (
+	commonRange         = `\x7f-\x9f\x{00ad}\x{0600}-\x{0604}\x{070f}\x{17b4}\x{17b5}\x{200c}-\x{200f}\x{2028}-\x{202f}\x{2060}-\x{206f}\x{feff}\x{fff0}-\x{ffff}`
+	reNeedsEscape       = regexp.MustCompile(`[\\\"\x00-\x1f` + commonRange + `]`)
+	reNeedsQuotes       = regexp.MustCompile(`^\s|^"|^'|^#|^/\*|^//|^\{|^\}|^\[|^\]|^:|^,|\s$|[\x00-\x1f\x7f-\x9f\x{00ad}\x{0600}-\x{0604}\x{070f}\x{17b4}\x{17b5}\x{200c}-\x{200f}\x{2028}-\x{202f}\x{2060}-\x{206f}\x{feff}\x{fff0}-\x{ffff}]`)
+	reNeedsEscapeML     = regexp.MustCompile(`'''|^[\s]+$|[\x00-\x08\x0b-\x1f` + commonRange + `]`)
+	reStartsWithKeyword = regexp.MustCompile(`^(true|false|null)\s*((,|\]|\}|#|//|/\*).*)?$`)
+	// A quoteless root string the parser can read as a braceless root object: a key name (not
+	// starting with a quote, which starts a quoted key; no whitespace or punctuator {}[],:
+	// after it, readKeyname) followed by a colon, blanks allowed before the colon (readKeyname
+	// skips them; only spaces occur in a string the encoder writes quoteless).
+	reRootColon = regexp.MustCompile(`^[^\x00-\x20{}\[\],:"'][^\x00-\x20{}\[\],:]* *:`)
+	// Such a string with nothing after the colon but blanks and comments (the member's value
+	// would start at the end of the input): hjson/20.
+	reRootEmptyValue = regexp.MustCompile(`^[^\x00-\x20{}\[\],:"'][^\x00-\x20{}\[\],:]* *:(?: *?/\*.*?\*/)* *(?:#.*|//.*)?$`)
+)
+
+// startsWithNumber: the encoder's test (tryParseNumber with stopAtNext), ported: the text is a
+// finite number optionally followed by whitespace and a punctuator or comment start.
+func startsWithNumber(text string) bool {
+	i := 0
+	next := func() byte {
+		if i < len(text) {
+			return text[i]
+		}
+		return 0
+	}
+	leadingZeros := 0
+	testLeading := true
+	if next() == '-' {
+		i++
+	}
+	for c := next(); c >= '0' && c <= '9'; c = next() {
+		if testLeading {
+			if c == '0' {
+				leadingZeros++
+			} else {
+				testLeading = false
+			}
+		}
+		i++
+	}
+	if testLeading {
+		leadingZeros--
+	}
+	if next() == '.' {
+		i++
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	if c := next(); c == 'e' || c == 'E' {
+		i++
+		if c := next(); c == '-' || c == '+' {
+			i++
+		}
+		if c := next(); c < '0' || c > '9' {
+			return false
+		}
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	end := i
+	for c := next(); c > 0 && c <= ' '; c = next() {
+		i++
+	}
+	c := next()
+	if c == ',' || c == '}' || c == ']' || c == '#' || (c == '/' && i+1 < len(text) && (text[i+1] == '/' || text[i+1] == '*')) {
+		c = 0
+	}
+	if c > 0 || leadingZeros != 0 {
+		return false
+	}
+	f, err := strconv.ParseFloat(text[:end], 64)
+	if err != nil || math.IsInf(f, 0) || math.IsNaN(f) {
+		return false
+	}
+	return true
+}
+
+// ambiguous: the string spells a number or a keyword (with a punctuator or comment after it),
+// which the encoder quotes only under QuoteAmbiguousStrings.
+func ambiguous(s string) bool {
+	return startsWithNumber(s) || reStartsWithKeyword.MatchString(s)
+}
+
+// stringOutcome models what a string value comes back as after MarshalWithOptions and
+// Unmarshal: the decoded string, whether the text cannot be read back at all (an ambiguous
+// string written quoteless breaks the document by design), and the recorded bugs whose shape
+// the string has. By default the outcome is the documented one (the string survives) and the
+// property fails on the shape; under HEGEL_NO_KNOWN=1 the switches make the model reproduce
+// the recorded outcome: a string spelling a number beyond float64 written quoteless breaks the
+// document (hjson/19), a root string that reads as a braceless object breaks it (hjson/9) or,
+// with nothing after the colon, reads as an object holding NUL (hjson/20), a quoteless string
+// is trimmed of its Unicode spaces (hjson/6), the single-line \u201d' form loses the leading
+// whitespace (hjson/4) and runs into its closing delimiter after a quote (hjson/5).
+func stringOutcome(s string, o hjson.EncoderOptions, root bool) (string, bool, []string) {
+	if s == "" {
+		return s, false, nil
+	}
+	quoted := o.QuoteAlways || reNeedsQuotes.MatchString(s) || (o.QuoteAmbiguousStrings && ambiguous(s))
+	if !quoted {
+		if ambiguous(s) {
+			return "", true, nil
+		}
+		var shape []string
+		if hugePrefix(s) {
+			// Beyond float64: not a number to the encoder, so written quoteless, but a number
+			// (json.Number) to the parser, which then fails.
+			shape = append(shape, "hjson/19")
+			if Known.hugeNumberQuoteless {
+				return "", true, shape
+			}
+		}
+		if root && reRootColon.MatchString(s) {
+			if reRootEmptyValue.MatchString(s) {
+				// hjson/20: the parser reads the missing value at the end of the input as the
+				// string NUL and the document as an object. A parser that rejects the missing
+				// value falls back to the single value, the string itself.
+				shape = append(shape, "hjson/20")
+				if noKnown {
+					return "", true, shape
+				}
+			} else {
+				shape = append(shape, "hjson/9")
+				if Known.rootColonObject {
+					return "", true, shape
+				}
+			}
+		}
+		if t := strings.TrimSpace(s); t != s {
+			shape = append(shape, "hjson/6")
+			if Known.trimUnicodeSpace {
+				return t, false, shape
+			}
+		}
+		return s, false, shape
+	}
+	if !reNeedsEscape.MatchString(s) {
+		return s, false, nil
+	}
+	if !reNeedsEscapeML.MatchString(s) && !root {
+		if strings.Contains(s, "\n") {
+			return s, false, nil
+		}
+		// The single-line triple-quote form.
+		var shape []string
+		out := s
+		if t := strings.TrimLeft(s, " \t"); t != s {
+			shape = append(shape, "hjson/4")
+			if Known.mlLeadingWhitespace {
+				out = t
+			}
+		}
+		if strings.HasSuffix(s, "'") {
+			shape = append(shape, "hjson/5")
+			if Known.mlTrailingQuote {
+				return "", true, shape
+			}
+		}
+		return out, false, shape
+	}
+	return s, false, nil
+}
+
+// hugePrefix: s, or its prefix up to some terminator (comma, bracket, comment start), is a
+// number by the grammar of tryParseNumber but beyond float64.
+func hugePrefix(s string) bool {
+	if c := s[0]; c != '-' && (c < '0' || c > '9') {
+		return false
+	}
+	check := func(prefix string) bool {
+		if !numberSyntax(prefix) {
+			return false
+		}
+		f, err := strconv.ParseFloat(strings.TrimSpace(prefix), 64)
+		return err != nil || math.IsInf(f, 0)
+	}
+	for i := 1; i < len(s); i++ {
+		if s[i] == ',' || s[i] == '}' || s[i] == ']' || s[i] == '#' || (s[i] == '/' && i+1 < len(s) && (s[i+1] == '/' || s[i+1] == '*')) {
+			if check(s[:i]) {
+				return true
+			}
+		}
+	}
+	return check(s)
+}
+
+// expectedDecode applies stringOutcome to every string value of a tree; ok is false when some
+// string breaks the document; changed reports whether any string differs; shape names the
+// recorded bugs whose shape some string has.
+func expectedDecode(v interface{}, o hjson.EncoderOptions, root bool) (out interface{}, ok, changed bool, shape []string) {
+	switch x := v.(type) {
+	case string:
+		s, broken, sh := stringOutcome(x, o, root)
+		if broken {
+			return nil, false, true, sh
+		}
+		return s, true, s != x, sh
+	case []interface{}:
+		arr := make([]interface{}, len(x))
+		for i, e := range x {
+			var c bool
+			var sh []string
+			arr[i], ok, c, sh = expectedDecode(e, o, false)
+			shape = append(shape, sh...)
+			if !ok {
+				return nil, false, true, shape
+			}
+			changed = changed || c
+		}
+		return arr, true, changed, shape
+	case map[string]interface{}:
+		m := make(map[string]interface{}, len(x))
+		for k, e := range x {
+			var c bool
+			var sh []string
+			m[k], ok, c, sh = expectedDecode(e, o, false)
+			shape = append(shape, sh...)
+			if !ok {
+				return nil, false, true, shape
+			}
+			changed = changed || c
+		}
+		return m, true, changed, shape
+	}
+	return v, true, false, nil
+}
+
+// dedupShapes removes repeated bug ids, keeping the first occurrence of each.
+func dedupShapes(shape []string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, id := range shape {
+		if !seen[id] {
+			seen[id] = true
+			out = append(out, id)
+		}
+	}
+	return out
+}
diff --git a/hegel/hegel_roundtrip_test.go b/hegel/hegel_roundtrip_test.go
new file mode 100644
index 0000000..08b7520
--- /dev/null
+++ b/hegel/hegel_roundtrip_test.go
@@ -0,0 +1,293 @@
+package hegel
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- JSON-shaped values
+
+// valuesFor: the value tree for an encoder option set: with QuoteAmbiguousStrings off, strings
+// spelling a number or a keyword would be written quoteless and read back as such (ambiguous by
+// design), so the tree holds plain strings only.
+func valuesFor(o hjson.EncoderOptions, depth int) hegel.Generator[interface{}] {
+	if o.QuoteAmbiguousStrings {
+		return valueAt(depth)
+	}
+	return plainValueAt(depth)
+}
+
+// rootColonStrs: a root string with a colon after a key-like prefix: the shape of a braceless
+// root object (hjson/9), with nothing after the colon that of hjson/20.
+var rootColonStrs = hegel.Composite(func(tc hegel.TestCase) string {
+	return hegel.Draw(tc, hegel.SampledFrom([]string{"key", "a", "x1", "a/b", "a b", "a,b", "1"})) + ":" + hegel.Draw(tc, strs)
+})
+
+// rtCase: a value and the options it is encoded with.
+type rtCase struct {
+	value interface{}
+	opts  hjson.EncoderOptions
+}
+
+func (r rtCase) GoString() string { return fmt.Sprintf("%s with %+v", canon(r.value), r.opts) }
+
+var rtCases = hegel.FlatMap(encoderOptions, func(o hjson.EncoderOptions) hegel.Generator[rtCase] {
+	values := weighted(
+		choice[interface{}]{95, valuesFor(o, 3)},
+		choice[interface{}]{5, asAny(rootColonStrs)},
+	)
+	return hegel.Map(values, func(v interface{}) rtCase { return rtCase{value: v, opts: o} })
+})
+
+// TestHegelRoundTrip: MarshalWithOptions -> Unmarshal is the identity on JSON-shaped values
+// under every encoder option, up to the string outcomes stringOutcome models; the same text
+// read into a Node and into an OrderedMap gives the same value, the OrderedMap's keys sorted
+// as the encoder writes them.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, rtCases)
+		v, opts := rc.value, rc.opts
+		want, ok, changed, shape := expectedDecode(v, opts, true)
+		shape = dedupShapes(shape)
+		if !ok {
+			c.skip(ht, "document broken by design or as recorded")
+		}
+		if changed {
+			c.count("string changed as recorded")
+		}
+		b, err := hjson.MarshalWithOptions(v, opts)
+		if err != nil {
+			c.fail(ht, "Marshal(%s, %+v): %v", canon(v), opts, err)
+			return
+		}
+		text := string(b)
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.mismatch(ht, "reject", shape, "Unmarshal rejects Marshal's output: %v\n%+v\nvalue %s\ntext %q", err, opts, show(canon(v)), show(text))
+			return
+		}
+		if got := canon(back); got != canon(want) {
+			c.mismatch(ht, "value", shape, "round trip changes the value\n%+v\n  value %s\n  want  %s\n  got   %s\n  text %q", opts, show(canon(v)), show(canon(want)), show(got), show(text))
+			return
+		}
+
+		var node hjson.Node
+		if err := hjson.Unmarshal(b, &node); err != nil {
+			c.mismatch(ht, "node reject", shape, "into Node: %v\n%q", err, show(text))
+		} else if got, want := canon(&node), canon(back); got != want {
+			c.mismatch(ht, "node value", shape, "Node value differs from the interface{} value\n  node %s\n  want %s\n  text %q", show(got), show(want), show(text))
+		}
+
+		if m, ok := v.(map[string]interface{}); ok {
+			var om hjson.OrderedMap
+			if err := hjson.Unmarshal(b, &om); err != nil {
+				c.mismatch(ht, "orderedmap reject", shape, "into OrderedMap: %v\n%q", err, show(text))
+			} else {
+				keys := make([]string, 0, len(m))
+				for k := range m {
+					keys = append(keys, k)
+				}
+				sort.Strings(keys)
+				if !reflect.DeepEqual(om.Keys, keys) && !(len(keys) == 0 && len(om.Keys) == 0) {
+					c.mismatch(ht, "key order", shape, "OrderedMap keys %q, encoder order %q\n%q", om.Keys, keys, show(text))
+				} else if got, want := canon(&om), canon(back); got != want {
+					c.mismatch(ht, "orderedmap value", shape, "OrderedMap value %s, want %s\n%q", show(got), show(want), show(text))
+				}
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- typed values
+
+type rtInner struct {
+	X string
+	Y []interface{} `json:"y,omitempty"`
+}
+
+type rtEmbedded struct {
+	Emb    string
+	Shared int // hidden by rich.Shared (depth 0 wins)
+}
+
+type rich struct {
+	Str    string
+	Ptr    *string
+	Int    int64
+	Uint   uint64
+	I8     int8
+	F32    float32
+	F64    float64
+	B      bool
+	N      json.Number
+	Strs   []string
+	Ints   []int
+	Any    interface{}
+	Map    map[string]string
+	MapAny map[string]interface{}
+	Nested *rtInner
+	In     rtInner
+	rtEmbedded
+	Renamed string `json:"other name,omitempty" comment:"a comment\nsecond line"`
+	Ignored string `json:"-"`
+	Dash    string `json:"-,"`
+	Shared  string
+}
+
+var numberTexts = []string{"0", "1", "-1", "12345678901234567890", "1e5", "-0.5", "1E-7", "0.1", "-0"}
+
+// richOf draws a rich struct, its strings from strG and its interface{} values from anyG (plain
+// ones when the encoder will not quote ambiguous strings).
+func richOf(strG hegel.Generator[string], anyG hegel.Generator[interface{}]) hegel.Generator[rich] {
+	return hegel.Composite(func(tc hegel.TestCase) rich {
+		r := rich{
+			Str:     hegel.Draw(tc, strG),
+			Int:     hegel.Draw(tc, hegel.SampledFrom([]int64{0, 1, -1, math.MaxInt64, math.MinInt64, 42, -1000})),
+			Uint:    hegel.Draw(tc, hegel.SampledFrom([]uint64{0, 1, math.MaxUint64, 1 << 53, 7})),
+			I8:      int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+			F32:     hegel.Draw(tc, hegel.SampledFrom([]float32{0, 0.1, 1e-3, 3.5, 16777217, math.MaxFloat32, -2.25})),
+			F64:     hegel.Draw(tc, numbers),
+			B:       hegel.Draw(tc, chance(50)),
+			N:       json.Number(hegel.Draw(tc, hegel.SampledFrom(numberTexts))),
+			Strs:    nonNilSlice(hegel.Draw(tc, upTo(strG, 3))),
+			Ints:    nonNilSlice(hegel.Draw(tc, upTo(hegel.Integers(-100, 100), 3))),
+			Any:     hegel.Draw(tc, anyG),
+			Map:     nonNilMap(hegel.Draw(tc, hegel.Maps(keys, strG).MaxSize(3))),
+			MapAny:  nonNilMap(hegel.Draw(tc, hegel.Maps(keys, anyG).MaxSize(3))),
+			In:      rtInner{X: hegel.Draw(tc, strG)},
+			Renamed: hegel.Draw(tc, hegel.SampledFrom([]string{"", "r", "1", "x y"})),
+			Ignored: "ignored",
+			Dash:    hegel.Draw(tc, strG),
+			Shared:  hegel.Draw(tc, strG),
+		}
+		r.Emb = hegel.Draw(tc, strG)
+		if s := hegel.Draw(tc, hegel.Optional(strG)); s != nil {
+			r.Ptr = s
+		}
+		if hegel.Draw(tc, chance(50)) {
+			r.Nested = &rtInner{X: hegel.Draw(tc, strG)}
+			if hegel.Draw(tc, chance(50)) {
+				r.Nested.Y = []interface{}{hegel.Draw(tc, anyG)}
+			}
+		}
+		if hegel.Draw(tc, chance(50)) {
+			r.In.Y = hegel.Draw(tc, many(anyG, 2, 2))
+		}
+		return r
+	})
+}
+
+type richCase struct {
+	r    rich
+	opts hjson.EncoderOptions
+}
+
+func (rc richCase) GoString() string {
+	return fmt.Sprintf("%s with %+v", string(mustJSON(rc.r)), rc.opts)
+}
+
+// richCases: the strings of the struct are the ones the round trip preserves under the
+// options (all of them as documented; under HEGEL_NO_KNOWN=1 stringOutcome excludes the
+// recorded exceptions), and no multi-line comment tag is written under CRLF while hjson/7 is
+// reproduced.
+var richCases = hegel.FlatMap(encoderOptions, func(o hjson.EncoderOptions) hegel.Generator[richCase] {
+	strG := strs
+	if !o.QuoteAmbiguousStrings {
+		strG = plainStrs
+	}
+	strG = hegel.Filter(strG, func(s string) bool {
+		out, broken, _ := stringOutcome(s, o, false)
+		return !broken && out == s
+	})
+	return hegel.Map(richOf(strG, valueTower(strG, keys, 1)[1]), func(r rich) richCase {
+		if Known.commentTagEol && o.Comments && o.Eol == "\r\n" {
+			r.Renamed = ""
+		}
+		return richCase{r: r, opts: o}
+	})
+})
+
+// richPreserved reports whether every string in r comes back unchanged (stringOutcome), and
+// the recorded shapes its strings have; the typed round trip skips the others, which
+// TestHegelRoundTrip covers.
+func richPreserved(r rich, o hjson.EncoderOptions) (bool, []string) {
+	var shape []string
+	ok := true
+	keep := func(s string) {
+		out, broken, sh := stringOutcome(s, o, false)
+		shape = append(shape, sh...)
+		if broken || out != s {
+			ok = false
+		}
+	}
+	strs := []string{r.Str, r.In.X, r.Emb, r.Renamed, r.Dash, r.Shared}
+	if r.Ptr != nil {
+		strs = append(strs, *r.Ptr)
+	}
+	if r.Nested != nil {
+		strs = append(strs, r.Nested.X)
+	}
+	strs = append(strs, r.Strs...)
+	for _, s := range r.Map {
+		strs = append(strs, s)
+	}
+	for _, s := range strs {
+		keep(s)
+	}
+	trees := []interface{}{r.Any, r.MapAny, r.In.Y}
+	if r.Nested != nil {
+		trees = append(trees, r.Nested.Y)
+	}
+	for _, v := range trees {
+		_, vok, changed, sh := expectedDecode(v, o, false)
+		shape = append(shape, sh...)
+		if !vok || changed {
+			ok = false
+		}
+	}
+	return ok, dedupShapes(shape)
+}
+
+// TestHegelTypedRoundTrip: a struct with fields of every supported kind, tags and an embedded
+// struct marshals and unmarshals back to itself under every encoder option (typed
+// destinations are never ambiguous: a quoteless 1 is the string "1" in a string field). A
+// multi-line comment tag written under CRLF is the shape of hjson/7.
+func TestHegelTypedRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, richCases)
+		r, opts := rc.r, rc.opts
+		commentTag := opts.Comments && opts.Eol == "\r\n" && r.Renamed != ""
+		if Known.commentTagEol && commentTag {
+			c.skip(ht, "multi-line comment tag with CRLF")
+		}
+		preserved, shape := richPreserved(r, opts)
+		if !preserved {
+			c.skip(ht, "string not preserved")
+		}
+		shape = append(shape, shapeIf(commentTag, "hjson/7")...)
+		b, err := hjson.MarshalWithOptions(r, opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		var back rich
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.mismatch(ht, "reject", shape, "Unmarshal rejects Marshal's output: %v\n%+v\n%q", err, opts, show(string(b)))
+			return
+		}
+		want := r
+		want.Ignored = ""
+		if !reflect.DeepEqual(back, want) {
+			c.mismatch(ht, "value", shape, "typed round trip differs\n%+v\n  want %s\n  got  %s\n  text %q", opts, show(string(mustJSON(want))), show(string(mustJSON(back))), show(string(b)))
+		}
+	})
+}
