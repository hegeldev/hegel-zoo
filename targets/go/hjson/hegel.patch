+// ---- hjson/17 and hjson/18: comments
+
+// commentGaps: a gap with a comment in it.
+var commentGaps = hegel.Composite(func(tc hegel.TestCase) gapRec {
+	items := hegel.Draw(tc, upTo(gapItems, 1))
+	items = append(items, gapItem{kind: 3, comment: hegel.Draw(tc, comments)})
+	items = append(items, hegel.Draw(tc, upTo(gapItems, 1))...)
+	return gapRec{nl: hegel.Draw(tc, lineEnds), items: items}
+})
+
+// commentFreeStrs: strings without a comment marker (so that a comment's text is counted in
+// comments only) and without characters outside the BMP.
+var commentFreeStrs = joined(upTo(hegel.SampledFrom([]string{"a", "b", "x y", "1", "true", "\\", "\"", "'", "\t", "{", ":", "-", "\u00e9"}), 4))
+
+// rootScalars: a keyword, a number within float64 without a trailing decimal point, or a
+// quoted string without surrogate pairs or comment markers.
+var rootScalars = hegel.OneOf(
+	keywordNodes,
+	hegel.Filter(numberNodes, func(n hjNode) bool { return !n.num.huge && !n.num.trailingDot }),
+	hegel.Map(quotedOf(commentFreeStrs), func(q quotedRec) hjNode { return hjNode{kind: 3, qt: q} }),
+)
+
+var (
+	// scalarTrailingComment: a root scalar followed by a comment (the shape of hjson/17).
+	scalarTrailingComment = hegel.Composite(func(tc hegel.TestCase) commentCase {
+		trail := hegel.Draw(tc, commentGaps)
+		return commentCase{doc: hjDoc{lead: hegel.Draw(tc, gaps), root: hegel.Draw(tc, rootScalars), trail: &trail}, whitespace: hegel.Draw(tc, chance(60))}
+	})
+	// scalarOtherComment: the comment before the root scalar, or after a root array.
+	scalarOtherComment = hegel.Composite(func(tc hegel.TestCase) commentCase {
+		if hegel.Draw(tc, chance(50)) {
+			return commentCase{doc: hjDoc{lead: hegel.Draw(tc, commentGaps), root: hegel.Draw(tc, rootScalars)}, whitespace: hegel.Draw(tc, chance(60))}
+		}
+		trail := hegel.Draw(tc, commentGaps)
+		return commentCase{doc: hjDoc{lead: hegel.Draw(tc, gaps), root: hegel.Draw(tc, arrayNodes(rootScalars)), trail: &trail}, whitespace: hegel.Draw(tc, chance(60))}
+	})
+)
+
+// render is the comment's text as written.
+func (c commentRec) render() string {
+	switch c.kind {
+	case 0:
+		return "#" + c.text
+	case 1:
+		return "//" + c.text
+	}
+	return "/*" + c.text + c.more + "*/"
+}
+
+// commentsOf lists the comments of a gap.
+func commentsOf(g *gapRec) []commentRec {
+	var out []commentRec
+	if g == nil {
+		return nil
+	}
+	for _, it := range g.items {
+		if it.kind == 3 {
+			out = append(out, it.comment)
+		}
+	}
+	return out
+}
+
+// TestHegelRootScalarTrailingComment: a document that is a scalar followed by a comment, read
+// into a Node and written again, holds each comment as many times as the document does (the
+// oracle of the pin of hjson/17; the layout is kept) and the same value (the model of
+// TestHegelCommentRoundTrip). Under HEGEL_NO_KNOWN=1 the comment precedes the scalar or
+// follows an array.
+func TestHegelRootScalarTrailingComment(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, shaped[hegel.Generator[commentCase]](scalarTrailingComment, scalarOtherComment))
+		checkCommentRoundTrip(c, ht, cc, known("hjson/17"))
+		w := &hjWriter{}
+		w.document(cc.doc)
+		text := w.sb.String()
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = cc.whitespace
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions([]byte(text), &node, dopts); err != nil {
+			return // reported above
+		}
+		b, err := hjson.Marshal(node)
+		if err != nil {
+			return
+		}
+		for _, cm := range append(commentsOf(&cc.doc.lead), commentsOf(cc.doc.trail)...) {
+			r := cm.render()
+			if got, want := strings.Count(string(b), r), strings.Count(text, r); got != want {
+				c.mismatch(ht, "comment count", known("hjson/17"), "the comment %q appears %d times in Marshal(node), %d times in the document\n  text %q\n  again %q", r, got, want, show(text), show(string(b)))
+				return
+			}
+		}
+	})
+}
