+	singleLineFields = tagFieldsOf(many(commentLines, 1, 1))
+	anyLineFields    = tagFieldsOf(many(commentLines, 1, 3))
+	// multiLineTagCRLF: CRLF line ends and a field with a multi-line comment tag (the shape of
+	// hjson/7).
+	multiLineTagCRLF = hegel.Composite(func(tc hegel.TestCase) tagCase {
+		fields := hegel.Draw(tc, many(anyLineFields, 1, 3))
+		fields[hegel.Draw(tc, hegel.Integers(0, len(fields)-1))].lines = hegel.Draw(tc, many(commentLines, 2, 3))
+		return tagCase{fields: fields, eol: "\r\n"}
