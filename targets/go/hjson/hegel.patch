+package hegel
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- comment round trips
+//
+// README: "The only way to read comments from Hjson input is to use a destination variable of
+// type hjson.Node ... An Hjson document can be read and written without altering the layout."
+// A hand-written document (the grammar model's, comments of the three kinds in every position
+// the syntax allows, optional commas, braceless root, quoteless keys and strings, multiline
+// strings) read into a Node and written again must keep its value; and the written text, read
+// and written once more, must not change again.
+
+var reTrailingBlanks = regexp.MustCompile(`[ \t]+(\n|$)`)
+
+// plain converts the grammar model's value (OrderedMaps) to JSON-shaped maps; a root member
+// without a value (hjson/20) is the single string the root falls back to.
+func plain(v interface{}) interface{} {
+	switch x := v.(type) {
+	case *hjson.OrderedMap:
+		m := make(map[string]interface{}, len(x.Keys))
+		for _, k := range x.Keys {
+			m[k] = plain(x.Map[k])
+		}
+		return m
+	case []interface{}:
+		out := make([]interface{}, len(x))
+		for i, e := range x {
+			out[i] = plain(e)
+		}
+		return out
+	case rootEmptyValue:
+		return x.s
+	}
+	return v
+}
+
+// commentCase: a document and whether the Node keeps its whitespace as comments too.
+type commentCase struct {
+	doc        hjDoc
+	whitespace bool
+}
+
+func (cc commentCase) GoString() string {
+	return fmt.Sprintf("%#v, whitespace kept: %v", cc.doc, cc.whitespace)
+}
+
+var commentCases = hegel.Composite(func(tc hegel.TestCase) commentCase {
+	return commentCase{doc: hegel.Draw(tc, docs), whitespace: hegel.Draw(tc, chance(60))}
+})
+
+// TestHegelCommentRoundTrip: a generated Hjson document with comments, read into a Node and
+// encoded with its comments, denotes the same value; the encoded text is a fixed point. The
+// recorded shapes it meets: the strings of stringOutcome (4, 5, 6, 9, 19, 20), surrogate pairs
+// (1), numbers beyond float64 (12), a multiline string after a key comment ending in a line
+// feed (18), a comment after a root scalar (17), a multiline string in an array (10).
+func TestHegelCommentRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkCommentRoundTrip(c, ht, hegel.Draw(ht, commentCases), nil)
+	})
+}
+
+// checkCommentRoundTrip is the oracle of TestHegelCommentRoundTrip on one document; extra
+// names the shapes the drawn region has.
+func checkCommentRoundTrip(c *collector, ht *hegel.T, cc commentCase, extra []string) {
+	{
+		w := &hjWriter{}
+		want := plain(w.document(cc.doc))
+		text := w.sb.String()
+		opts := hjson.DefaultOptions()
+		_, isObj := want.(map[string]interface{})
+		_, isArr := want.([]interface{})
+		isScalar := !isObj && !isArr
+		shape := append(w.shapes(), extra...)
+		expected, ok, changed, strShape := expectedDecode(want, opts, isScalar)
+		shape = dedupShapes(append(shape, strShape...))
+		if !ok {
+			c.skip(ht, "string not preserved")
+		}
+		if changed {
+			c.count("string changed as recorded")
+		}
+		wantCanon := canon(expected)
+		// A string followed by a comment on its line is quoted whatever the options
+		// (quoteForComment), so the quoted outcome is acceptable too.
+		optsQ := opts
+		optsQ.QuoteAlways = true
+		expectedQ, okQ, _, _ := expectedDecode(want, optsQ, isScalar)
+		wantCanonQ := ""
+		if okQ {
+			wantCanonQ = canon(expectedQ)
+		}
+
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = cc.whitespace
+		if !dopts.WhitespaceAsComments {
+			c.count("comments only")
+		}
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions([]byte(text), &node, dopts); err != nil {
+			c.mismatch(ht, "reject", shape, "into Node: %v\n%q", err, show(text))
+			return
+		}
+		mlAfterKeyComment := w.mlAfterComment || (w.mlAfterNewline && dopts.WhitespaceAsComments)
+		if Known.mlAfterKeyComment && mlAfterKeyComment {
+			c.skip(ht, "multiline string after a key comment")
+		}
+		shape = append(shape, shapeIf(mlAfterKeyComment, "hjson/18")...)
+		b, err := hjson.MarshalWithOptions(node, opts)
+		if err != nil {
+			c.mismatch(ht, "marshal", shape, "Marshal(node): %v\n%q", err, show(text))
+			return
+		}
+		text2 := string(b)
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			if !okQ {
+				c.skip(ht, "quoted-for-comment string not preserved")
+			}
+			c.mismatch(ht, "reject2", shape, "the re-encoded text does not parse: %v\n%q\n  from %q", err, show(text2), show(text))
+			return
+		}
+		if got := canon(back); got != wantCanon {
+			if !okQ {
+				// A string quoted for a comment after it, in a form that does not read back
+				// as recorded (the ''' form ending in a quote, hjson/5): the value is not the
+				// document's.
+				c.skip(ht, "quoted-for-comment string not preserved")
+			}
+			if okQ && got == wantCanonQ {
+				c.count("string quoted for a comment")
+				changed = changed || wantCanonQ != canon(want)
+			} else {
+				c.mismatch(ht, "value", shape, "value changed by the Node round trip\n  from %q\n  to   %q\n  got  %s\n  want %s", show(text), show(text2), show(got), show(wantCanon))
+				return
+			}
+		}
+		if strings.ContainsAny(text, "\r") || strings.Contains(text, "'''") {
+			c.count("fixed point not checked: CR or multiline string")
+			return
+		}
+		if changed {
+			// A string the encoder writes in a form that reads back differently (bugs 4-6, 9)
+			// changes the text again at the next round.
+			c.count("fixed point not checked: string changed as recorded")
+			return
+		}
+		rootAfter := isScalar && w.rootTrail
+		if Known.rootAfterDoubled && rootAfter {
+			c.count("fixed point not checked: root scalar with a trailing comment")
+			return
+		}
+		shape = append(shape, shapeIf(rootAfter, "hjson/17")...)
+		shape = append(shape, shapeIf(hasMLInArray(want, opts, false), "hjson/10")...)
+		var node2 hjson.Node
+		if err := hjson.UnmarshalWithOptions(b, &node2, dopts); err != nil {
+			c.mismatch(ht, "reject3", shape, "re-encoded text into Node: %v\n%q", err, show(text2))
+			return
+		}
+		b3, err := hjson.MarshalWithOptions(node2, opts)
+		if err != nil {
+			c.mismatch(ht, "marshal3", shape, "Marshal(node2): %v\n%q", err, show(text2))
+			return
+		}
+		// Trailing blanks on a line are kept as a comment once and absorbed by a quoteless
+		// string (and trimmed) the next time; they do not count.
+		if text3 := reTrailingBlanks.ReplaceAllString(string(b3), "$1"); text3 != reTrailingBlanks.ReplaceAllString(text2, "$1") {
+			c.mismatch(ht, "fixed point", shape, "the re-encoded text changes again\n  from %q\n  once %q\n  twice %q", show(text), show(text2), show(text3))
+		}
+	}
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..727fe1d
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,198 @@
+package hegel
+
+import (
+	"encoding/json"
+	"math"
+	"sort"
+	"strings"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+// Building blocks of generated strings: everything the Hjson quoting rules look at (quotes,
+// backslashes, comment starters, punctuators, control and format characters, keyword and
+// number spellings, leading and trailing whitespace). The plain pieces come first, so a
+// shrunk string is made of letters.
+var stringAtoms = []string{
+	"a", "b", "x", "Z", "0", "1", "9", " ", "  ", "-", ".", "e", "E", "+", "_",
+	"'", "''", "'''", "\"", "\\", "#", "/", "//", "/*", "*/", ",", ":", "{", "}", "[", "]",
+	"\n", "\t", "\r", "\x00", "\x1f", "\x7f", "\u00ad", "\u2028", "\ufeff", "\uffff", "\u200c",
+	"\u00e9", "\U0001F600", "\u00a0",
+	"true", "false", "null", "1.", "1e5", "-1e-5", "1e400", "0x10", "01", "1,2", "5 times", "Infinity", "NaN",
+	"true ", "true,", "true # c", "1 # c", "1 // c", "1 /* c */", "a # c", "a // c",
+}
+
+// keyWords: plain object keys.
+var keyWords = []string{"a", "b", "c", "key", "Key", "KEY", "k1", "x-y", "x.y", "_", "-", "1", "true"}
+
+var (
+	// strs: zero to five atoms.
+	strs = joined(upTo(hegel.SampledFrom(stringAtoms), 5))
+	// plainStrs: strings that spell no number or keyword (ambiguous(), hegel_quote_test.go),
+	// for the values the encoder writes with QuoteAmbiguousStrings off.
+	plainStrs = hegel.Filter(strs, func(s string) bool { return !ambiguous(s) })
+	// keys: words, and the same tricky atoms as values.
+	keys = weighted(choice[string]{60, hegel.SampledFrom(keyWords)}, choice[string]{40, strs})
+)
+
+var floatPool = []float64{0, 1, -1, 0.5, 0.1, 1e21, 1e20, 1e-7, 123456789012345678, 5e-324, 1.7976931348623157e308, 100000, 3.25, -2.5e-3, 42}
+
+// numbers: small integers (zero first), the pool, negative zero, thousandths.
+var numbers = hegel.OneOf(
+	hegel.Map(hegel.Integers(-1000, 1000), func(n int) float64 { return float64(n) }),
+	hegel.SampledFrom(floatPool),
+	hegel.Just(math.Copysign(0, -1)),
+	hegel.Map(hegel.Integers(-1000000, 1000000), func(n int) float64 { return float64(n) / 1000 }),
+)
+
+// valueTower builds the JSON-shaped value tree (nil, bool, float64, string, []interface{} and
+// map[string]interface{}; the JSON canonical form of the decoded text) level by level: the
+// containers of level d hold values of level d-1, and level 0 has no containers. Strings
+// come from strG, keys from keyG.
+func valueTower(strG, keyG hegel.Generator[string], depth int) []hegel.Generator[interface{}] {
+	levels := make([]hegel.Generator[interface{}], depth+1)
+	leaves := []hegel.Generator[interface{}]{hegel.Just[interface{}](nil), asAny(hegel.Booleans()), asAny(numbers), asAny(strG)}
+	levels[0] = hegel.OneOf(leaves...)
+	for d := 1; d <= depth; d++ {
+		arrays := asAny(hegel.Map(upTo(levels[d-1], 4), nonNilSlice[interface{}]))
+		objects := asAny(hegel.Map(hegel.Maps(keyG, levels[d-1]).MaxSize(4), nonNilMap[string, interface{}]))
+		levels[d] = hegel.OneOf(append(append([]hegel.Generator[interface{}]{}, leaves...), arrays, arrays, objects)...)
+	}
+	return levels
+}
+
+var (
+	valueLevels      = valueTower(strs, keys, 3)
+	plainValueLevels = valueTower(plainStrs, keys, 3)
+)
+
+// valueAt is a value tree of at most depth container levels (three at most).
+func valueAt(depth int) hegel.Generator[interface{}] { return valueLevels[min(depth, 3)] }
+
+// plainValueAt is valueAt with strings that spell no number or keyword.
+func plainValueAt(depth int) hegel.Generator[interface{}] { return plainValueLevels[min(depth, 3)] }
+
+// encoderOptions: the defaults half of the time, else every option drawn; whitespace-only
+// indentation.
+var encoderOptions = weighted(
+	choice[hjson.EncoderOptions]{50, hegel.Just(hjson.DefaultOptions())},
+	choice[hjson.EncoderOptions]{50, hegel.Composite(func(tc hegel.TestCase) hjson.EncoderOptions {
+		o := hjson.DefaultOptions()
+		o.Eol = hegel.Draw(tc, hegel.SampledFrom([]string{"\n", "\r\n"}))
+		o.BracesSameLine = hegel.Draw(tc, chance(50))
+		o.EmitRootBraces = hegel.Draw(tc, chance(60))
+		o.QuoteAlways = hegel.Draw(tc, chance(25))
+		o.QuoteAmbiguousStrings = hegel.Draw(tc, chance(80))
+		o.IndentBy = hegel.Draw(tc, hegel.SampledFrom([]string{"  ", "\t", "    ", " ", ""}))
+		o.BaseIndentation = hegel.Draw(tc, hegel.SampledFrom([]string{"", "  ", "\t", "    "}))
+		o.Comments = hegel.Draw(tc, chance(80))
+		return o
+	})},
+)
+
+// --------------------------------------------------------------------------- comparison
+
+// canon renders a decoded value tree in a canonical form for comparison: numbers by their
+// shortest float64 spelling (-0 as 0), objects with sorted keys, json.Number by its text as a
+// float64 (so both decoders' number types compare equal).
+func canon(v interface{}) string {
+	var sb strings.Builder
+	canonInto(&sb, v)
+	return sb.String()
+}
+
+func canonInto(sb *strings.Builder, v interface{}) {
+	switch x := v.(type) {
+	case nil:
+		sb.WriteString("null")
+	case bool:
+		if x {
+			sb.WriteString("true")
+		} else {
+			sb.WriteString("false")
+		}
+	case float64:
+		if x == 0 {
+			x = 0
+		}
+		b, _ := json.Marshal(x)
+		sb.Write(b)
+	case json.Number:
+		f, err := x.Float64()
+		if err != nil {
+			sb.WriteString("number(" + string(x) + ")")
+		} else {
+			canonInto(sb, f)
+		}
+	case string:
+		b, _ := json.Marshal(x)
+		sb.Write(b)
+	case []interface{}:
+		sb.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonInto(sb, e)
+		}
+		sb.WriteByte(']')
+	case map[string]interface{}:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		sb.WriteByte('{')
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			b, _ := json.Marshal(k)
+			sb.Write(b)
+			sb.WriteByte(':')
+			canonInto(sb, x[k])
+		}
+		sb.WriteByte('}')
+	case *hjson.OrderedMap:
+		// Compared as an unordered object; the key order is checked separately.
+		m := map[string]interface{}{}
+		for _, k := range x.Keys {
+			m[k] = x.Map[k]
+		}
+		canonInto(sb, m)
+	case *hjson.Node:
+		canonInto(sb, x.Value)
+	case hjson.Node:
+		canonInto(sb, x.Value)
+	default:
+		sb.WriteString("?" + string(mustJSON(v)))
+	}
+}
+
+func mustJSON(v interface{}) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return []byte(err.Error())
+	}
+	return b
+}
+
+func show(s string) string {
+	if len(s) > 400 {
+		s = s[:400] + "..."
+	}
+	return s
+}
+
+// sortedKeys is a map's keys in sorted order (the encoder's order).
+func sortedKeys(m map[string]interface{}) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
diff --git a/hegel/hegel_hints_test.go b/hegel/hegel_hints_test.go
new file mode 100644
index 0000000..2b7fc85
--- /dev/null
+++ b/hegel/hegel_hints_test.go
@@ -0,0 +1,781 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- typed destinations
+//
+// Hjson's quoteless values are typed by their destination: "A string destination will receive
+// a string even if the quoteless string also was a valid number, boolean or null" (README);
+// otherwise a quoteless number, true, false or null is that value. Destinations that implement
+// encoding.TextUnmarshaler count as strings; a type implementing ElemTyper types all of its
+// elements; the rest is encoding/json ("the same rules apply"). The model here reads a
+// generated document into the JSON text encoding/json would need to give the same result: each
+// quoteless token becomes a JSON string when its destination is string-typed, and the raw
+// token otherwise.
+
+// textVal is a TextUnmarshaler with a pointer receiver (like time.Time, net.IP, big.Int).
+type textVal struct{ S string }
+
+func (t *textVal) UnmarshalText(b []byte) error { t.S = "T:" + string(b); return nil }
+
+type hintedInner struct {
+	S   string
+	I   int
+	T   textVal
+	Any interface{}
+}
+
+type hintedEmb struct {
+	Emb  string
+	EmbN float64
+}
+
+// elemStrs types its elements as strings (value receiver).
+type elemStrs []interface{}
+
+func (elemStrs) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+// elemMap types its values as strings (pointer receiver, callable on nil).
+type elemMap map[string]interface{}
+
+func (*elemMap) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+// elemStruct types all of its fields' values as strings.
+type elemStruct struct {
+	A interface{}
+	B interface{}
+}
+
+func (elemStruct) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+type hinted struct {
+	S   string
+	PS  *string
+	I   int
+	F   float64
+	B   bool
+	N   json.Number
+	Any interface{}
+	SS  []string
+	SA  []interface{}
+	AS  [2]string
+	MS  map[string]string
+	MA  map[string]interface{}
+	T   textVal
+	PT  *textVal
+	TS  []textVal
+	TM  map[string]textVal
+	Sub *hintedInner
+	In  hintedInner
+	hintedEmb
+	Rn   string `json:"renamed"`
+	Skip string `json:"-"`
+	ES   elemStrs
+	EM   elemMap
+	EST  elemStruct
+	AB   int
+	Ab   string
+}
+
+// prefill holds the drawn initial state of a destination, so that both decoders start from
+// equal values (json.Decoder merges into pre-filled destinations).
+type prefill struct {
+	s, ps, rn string
+	hasPS     bool
+	i         int
+	any       int // 0 nil, 1 string, 2 number, 3 map, 4 array
+	sub       bool
+	subAny    int
+	ss        bool
+	ms        bool
+	ma        int
+}
+
+var prefills = hegel.Composite(func(tc hegel.TestCase) prefill {
+	p := prefill{
+		s:      hegel.Draw(tc, hegel.SampledFrom([]string{"", "old", "1"})),
+		i:      hegel.Draw(tc, hegel.Integers(-3, 3)),
+		any:    hegel.Draw(tc, hegel.Integers(0, 4)),
+		sub:    hegel.Draw(tc, chance(50)),
+		subAny: hegel.Draw(tc, hegel.Integers(0, 2)),
+		rn:     hegel.Draw(tc, hegel.SampledFrom([]string{"", "r"})),
+		ma:     hegel.Draw(tc, hegel.Integers(0, 2)),
+		hasPS:  hegel.Draw(tc, chance(40)),
+		ps:     hegel.Draw(tc, hegel.SampledFrom([]string{"", "p", "7"})),
+		ss:     hegel.Draw(tc, chance(30)),
+		ms:     hegel.Draw(tc, chance(30)),
+	}
+	return p
+})
+
+func anyValue(kind int) interface{} {
+	switch kind {
+	case 1:
+		return "old"
+	case 2:
+		return 1.5
+	case 3:
+		return map[string]interface{}{"T": "s", "k": 2.0}
+	case 4:
+		return []interface{}{"a", 1.0}
+	}
+	return nil
+}
+
+func (p prefill) build() *hinted {
+	h := &hinted{S: p.s, I: p.i, Any: anyValue(p.any), Rn: p.rn, Skip: "kept"}
+	if p.hasPS {
+		s := p.ps
+		h.PS = &s
+	}
+	if p.sub {
+		h.Sub = &hintedInner{S: "s", Any: anyValue(p.subAny)}
+	}
+	if p.ss {
+		h.SS = []string{"x", "y"}
+	}
+	if p.ms {
+		h.MS = map[string]string{"k": "v"}
+	}
+	switch p.ma {
+	case 1:
+		h.MA = map[string]interface{}{}
+	case 2:
+		h.MA = map[string]interface{}{"a": "b"}
+	}
+	return h
+}
+
+// ---- the model of the destination type at a position
+
+var textUnmarshalerT = reflect.TypeOf((*interface{ UnmarshalText([]byte) error })(nil)).Elem()
+var elemTyperT = reflect.TypeOf((*hjson.ElemTyper)(nil)).Elem()
+
+// hint is a destination: the value being decoded into (invalid when the parser tracks none)
+// and its static type (nil when unknown).
+type hint struct {
+	dest reflect.Value
+	t    reflect.Type
+	fold bool // encoding/json's view of the destination (the shape a value must have)
+}
+
+// unravel follows the destination through non-nil pointers and interfaces, then the type
+// through pointers.
+func (h hint) unravel() (reflect.Value, reflect.Type) {
+	d, t := h.dest, h.t
+	if d.IsValid() {
+		for (d.Kind() == reflect.Ptr || d.Kind() == reflect.Interface) && !d.IsNil() {
+			d = d.Elem()
+		}
+		if d.IsValid() {
+			t = d.Type()
+		}
+	}
+	for t != nil && t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	return d, t
+}
+
+// isStringAs: a quoteless value here is a string whatever it spells. As documented, a
+// TextUnmarshaler destination is a string wherever it sits; as recorded (hjson/14) the parser
+// only asks the destination's address, which exists for struct fields it tracks, not for slice
+// elements, map values or fields behind a nil pointer.
+func (h hint) isStringAs(recorded bool) bool {
+	_, t := h.unravel()
+	if t == nil {
+		return false
+	}
+	if t.Kind() == reflect.String || (h.t != nil && h.t.Implements(textUnmarshalerT)) {
+		return true
+	}
+	if recorded {
+		return h.dest.IsValid() && h.dest.CanAddr() && reflect.PtrTo(h.dest.Type()).Implements(textUnmarshalerT)
+	}
+	return reflect.PtrTo(t).Implements(textUnmarshalerT)
+}
+
+func (h hint) isString() bool { return h.isStringAs(Known.textElemHint) }
+
+// nullIsNil: a quoteless null is nil (not the string "null") for a pointer destination.
+func (h hint) nullIsNil() bool { return h.t != nil && h.t.Kind() == reflect.Ptr }
+
+// elemType is the ElemTyper's element type, if the destination type (or a pointer to it)
+// implements it.
+func (h hint) elemType() reflect.Type {
+	t := h.t
+	if t == nil {
+		return nil
+	}
+	if t.Implements(elemTyperT) {
+		v := reflect.Zero(t)
+		if t.Kind() == reflect.Ptr {
+			v = reflect.New(t.Elem())
+		}
+		return v.Interface().(hjson.ElemTyper).ElemType()
+	}
+	if pt := reflect.PtrTo(t); pt.Implements(elemTyperT) {
+		return reflect.Zero(pt).Interface().(hjson.ElemTyper).ElemType()
+	}
+	return nil
+}
+
+// elem is the destination of an array element.
+func (h hint) elem() hint {
+	if et := h.elemType(); et != nil {
+		return hint{t: et, fold: h.fold}
+	}
+	_, t := h.unravel()
+	if t != nil && (t.Kind() == reflect.Slice || t.Kind() == reflect.Array) {
+		return hint{t: t.Elem(), fold: h.fold}
+	}
+	return hint{fold: h.fold}
+}
+
+type fieldInfo struct {
+	name  string
+	index []int
+	typ   reflect.Type
+}
+
+// structFields lists a struct type's encoded fields as encoding/json sees them (exported,
+// json tag names, "-" skipped, embedded structs flattened; unique names here), sorted by name.
+func structFields(t reflect.Type) []fieldInfo {
+	var out []fieldInfo
+	var walk func(t reflect.Type, prefix []int)
+	walk = func(t reflect.Type, prefix []int) {
+		for i := 0; i < t.NumField(); i++ {
+			sf := t.Field(i)
+			idx := append(append([]int{}, prefix...), i)
+			if sf.Anonymous && sf.Type.Kind() == reflect.Struct && sf.Tag.Get("json") == "" {
+				walk(sf.Type, idx)
+				continue
+			}
+			if sf.PkgPath != "" {
+				continue
+			}
+			tag := sf.Tag.Get("json")
+			if tag == "-" {
+				continue
+			}
+			name := sf.Name
+			if n := strings.Split(tag, ",")[0]; n != "" {
+				name = n
+			}
+			out = append(out, fieldInfo{name: name, index: idx, typ: sf.Type})
+		}
+	}
+	walk(t, nil)
+	sort.SliceStable(out, func(i, j int) bool { return out[i].name < out[j].name })
+	return out
+}
+
+// fieldForAs finds the field a key selects: an exact name, else the first field whose name
+// matches case-insensitively: as encoding/json does (unicode.SimpleFold), or as recorded
+// (hjson/16) with strings.ToLower on both sides, which misses the long s.
+func fieldForAs(t reflect.Type, key string, recorded bool) (fieldInfo, bool) {
+	fields := structFields(t)
+	for _, f := range fields {
+		if f.name == key {
+			return f, true
+		}
+	}
+	for _, f := range fields {
+		if recorded {
+			if strings.ToLower(f.name) == strings.ToLower(key) {
+				return f, true
+			}
+		} else if strings.EqualFold(f.name, key) {
+			return f, true
+		}
+	}
+	return fieldInfo{}, false
+}
+
+// fieldFor is the parser's lookup (fold false) or encoding/json's (fold true).
+func fieldFor(t reflect.Type, key string, fold bool) (fieldInfo, bool) {
+	return fieldForAs(t, key, Known.foldKeys && !fold)
+}
+
+// child is the destination of an object member.
+func (h hint) child(key string) hint {
+	if et := h.elemType(); et != nil {
+		return hint{t: et, fold: h.fold}
+	}
+	d, t := h.unravel()
+	if t == nil {
+		return hint{fold: h.fold}
+	}
+	switch t.Kind() {
+	case reflect.Map:
+		return hint{t: t.Elem(), fold: h.fold}
+	case reflect.Struct:
+		f, ok := fieldFor(t, key, h.fold)
+		if !ok {
+			return hint{fold: h.fold}
+		}
+		var fd reflect.Value
+		if d.IsValid() && d.Kind() == reflect.Struct {
+			fd = d.FieldByIndex(f.index)
+		}
+		return hint{dest: fd, t: f.typ, fold: h.fold}
+	}
+	return hint{fold: h.fold}
+}
+
+// ---- the document records
+
+// hintNode is a value of the document: whether it fits the destination's kind, and the
+// alternatives chosen by kind (indexes taken modulo the options the destination leaves).
+type hintNode struct {
+	fit     bool
+	alt     int // the value kind when not fitting: 0-4 token, 5 quoted, 6 multiline, 7 array, 8-9 object
+	tok     int // which token of the destination's list
+	strAlt  int // for string destinations: 0, 1 quoted, 2 multiline, else a token
+	qt      quotedRec
+	ml      mlRec
+	elems   []hintNode
+	members []hintMember
+}
+
+// hintMember is an object member: its key (a field of the struct destination in one of
+// several spellings, or a plain key), the key's spelling, the colon's blanks, the value.
+type hintMember struct {
+	useField bool
+	fieldIx  int
+	spelling int // 0 lowercase, 1 uppercase, 2 long s for s, else as is
+	keyIx    int
+	plainKey bool
+	keyQ     quotedRec // single and forms; the text is the key
+	colon    int
+	val      hintNode
+}
+
+func hintMembersOf(vals hegel.Generator[hintNode]) hegel.Generator[hintMember] {
+	return hegel.Composite(func(tc hegel.TestCase) hintMember {
+		return hintMember{
+			useField: hegel.Draw(tc, chance(88)),
+			fieldIx:  hegel.Draw(tc, hegel.Integers(0, 31)),
+			spelling: hegel.Draw(tc, hegel.Integers(0, 7)),
+			keyIx:    hegel.Draw(tc, hegel.Integers(0, len(hintKeys)-1)),
+			plainKey: hegel.Draw(tc, chance(80)),
+			keyQ:     quotedRec{single: hegel.Draw(tc, chance(30)), forms: hegel.Draw(tc, escapeForms)},
+			colon:    hegel.Draw(tc, hegel.Integers(0, 2)),
+			val:      hegel.Draw(tc, vals),
+		}
+	})
+}
+
+// hintTower: level 0 holds scalars only (its arrays and objects are empty); level d holds up
+// to three elements or four members of level d-1.
+func hintTower(depth int) []hegel.Generator[hintNode] {
+	levels := make([]hegel.Generator[hintNode], depth+1)
+	for d := 0; d <= depth; d++ {
+		var elems hegel.Generator[[]hintNode]
+		var members hegel.Generator[[]hintMember]
+		if d > 0 {
+			elems = upTo(levels[d-1], 3)
+			members = upTo(hintMembersOf(levels[d-1]), 4)
+		}
+		levels[d] = hegel.Composite(func(tc hegel.TestCase) hintNode {
+			n := hintNode{
+				fit:    hegel.Draw(tc, chance(96)),
+				alt:    hegel.Draw(tc, hegel.Integers(0, 9)),
+				tok:    hegel.Draw(tc, hegel.Integers(0, 63)),
+				strAlt: hegel.Draw(tc, hegel.Integers(0, 9)),
+				qt:     hegel.Draw(tc, quoteds),
+				ml:     hegel.Draw(tc, mlRecs),
+			}
+			if elems != nil {
+				n.elems = hegel.Draw(tc, elems)
+				n.members = hegel.Draw(tc, members)
+			}
+			return n
+		})
+	}
+	return levels
+}
+
+var hintLevels = hintTower(2)
+
+// hintDoc: the pre-filled destination, the decoder options, the root with or without braces
+// and its members (at least one without braces).
+type hintDoc struct {
+	pre             prefill
+	useJSONNumber   bool
+	disallowUnknown bool
+	braces          bool
+	members         []hintMember
+}
+
+func (d hintDoc) GoString() string {
+	got := d.pre.build()
+	w := &hintWriter{hj: &hjWriter{}, depth: 2}
+	model := w.document(d, got)
+	return fmt.Sprintf("document %q, model JSON %s, into %s", w.hj.sb.String(), model, showHinted(d.pre.build()))
+}
+
+var hintDocs = hegel.Composite(func(tc hegel.TestCase) hintDoc {
+	d := hintDoc{
+		pre:             hegel.Draw(tc, prefills),
+		useJSONNumber:   hegel.Draw(tc, chance(30)),
+		disallowUnknown: hegel.Draw(tc, chance(30)),
+		braces:          hegel.Draw(tc, chance(50)),
+	}
+	lo := 1
+	if d.braces {
+		lo = 0
+	}
+	d.members = hegel.Draw(tc, hegel.FlatMap(hegel.Integers(lo, 6), func(n int) hegel.Generator[[]hintMember] {
+		return many(hintMembersOf(hintLevels[2]), n, n)
+	}))
+	return d
+})
+
+// ---- the document writer
+
+// Quoteless tokens: numbers, keywords, near misses and plain words; none contains a
+// terminator (comma, bracket, comment start) so each runs to its line end. 1. is the shape of
+// hjson/11; 1e400 is beyond float64.
+var hintTokens = []string{
+	"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "100000000000000000000",
+	"true", "false", "null", "True", "NULL", "tru", "nul",
+	".5", "01", "+1", "0x10", "1 2", "12abc", "-", "abc", "a b", "x", "e5", "true 1", "null ",
+	"123 ", "\t7", "1.5.2", "1e", "-e3", "1.", "1e400",
+}
+
+var hintKeys = []string{"a", "b", "k", "key", "1", "x-y", "Zed", "unknown", "T", "S", "s", "Any", "ANY"}
+
+// hintWriter renders a hint document from its records and builds the JSON text encoding/json
+// must decode to give the same value; it notes the recorded shapes the document has.
+type hintWriter struct {
+	hj    *hjWriter
+	depth int
+
+	elemHint    bool // a token whose string typing differs between the documented and the recorded hint (hjson/14)
+	foldedKey   bool // a key only unicode folding matches to its field (hjson/16)
+	trailingDot bool // a number with a trailing decimal point for a non-string destination (hjson/11)
+}
+
+func (w *hintWriter) shapes() []string {
+	var s []string
+	s = append(s, shapeIf(w.hj.surrog, "hjson/1")...)
+	s = append(s, shapeIf(w.trailingDot, "hjson/11")...)
+	s = append(s, shapeIf(w.elemHint, "hjson/14")...)
+	s = append(s, shapeIf(w.foldedKey, "hjson/16")...)
+	return s
+}
+
+func (w *hintWriter) line(indent int) {
+	w.hj.write("\n" + strings.Repeat(" ", indent))
+}
+
+// jsonString is the JSON text of s.
+func jsonString(s string) string { return string(mustJSON(s)) }
+
+// pickAt is the i-th option modulo the number of options.
+func pickAt(xs []string, i int) string { return xs[i%len(xs)] }
+
+// token writes the quoteless token tok and returns the JSON text of what the parser makes of
+// it for the destination h (leading whitespace belongs to the separator, trailing whitespace
+// is trimmed).
+func (w *hintWriter) token(h hint, tok string) string {
+	w.hj.write(tok)
+	tok = strings.TrimLeft(tok, " \t")
+	trimmed := strings.TrimSpace(tok)
+	if trimmed == "null" && h.nullIsNil() {
+		return "null"
+	}
+	if h.isStringAs(false) != h.isStringAs(true) {
+		w.elemHint = true
+	}
+	if h.isString() {
+		return jsonString(trimmed)
+	}
+	if trimmed == "true" || trimmed == "false" || trimmed == "null" {
+		return trimmed
+	}
+	if c := tok[0]; (c == '-' || c >= '0' && c <= '9') && numberSyntax(tok) {
+		if n := numRecOf(trimmed); n.trailingDot {
+			// 1. is the number 1 by the grammar the parser applies (tryParseNumber).
+			w.trailingDot = true
+			return strconv.FormatFloat(n.value().(float64), 'g', -1, 64)
+		}
+		return trimmed
+	}
+	return jsonString(trimmed)
+}
+
+var intTokens = []string{"123", "-5", "0", "-0", "7 ", "null"}
+var numTokens = []string{"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "null"}
+var jsonNumberTokens = []string{"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "7 "}
+var boolTokens = []string{"true", "false", "null", "true "}
+var jsonNumberT = reflect.TypeOf(json.Number(""))
+
+// fitting writes a value of the kind the destination shape expects (most of the time), so
+// that most documents decode without error; it reports whether it did. h is the parser's view
+// of the destination (its hint), shape encoding/json's.
+func (w *hintWriter) fitting(h, shape hint, indent int, n hintNode) (string, bool) {
+	if !n.fit {
+		return "", false
+	}
+	_, t := shape.unravel()
+	if t == nil {
+		return "", false
+	}
+	switch t.Kind() {
+	case reflect.String:
+		if t == jsonNumberT {
+			return w.token(h, pickAt(jsonNumberTokens, n.tok)), true
+		}
+		switch n.strAlt {
+		case 0, 1:
+			return jsonString(w.hj.quoted(n.qt)), true
+		case 2:
+			return jsonString(w.hj.multiline(n.ml)), true
+		}
+		return w.token(h, pickAt(hintTokens, n.tok)), true
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return w.token(h, pickAt(intTokens, n.tok)), true
+	case reflect.Float32, reflect.Float64:
+		return w.token(h, pickAt(numTokens, n.tok)), true
+	case reflect.Bool:
+		return w.token(h, pickAt(boolTokens, n.tok)), true
+	case reflect.Slice, reflect.Array:
+		return w.array(h, shape, indent, n), true
+	case reflect.Map, reflect.Struct:
+		if reflect.PtrTo(t).Implements(textUnmarshalerT) {
+			return w.token(h, pickAt(hintTokens, n.tok)), true
+		}
+		return w.object(h, shape, indent, n), true
+	}
+	return "", false
+}
+
+func (w *hintWriter) array(h, shape hint, indent int, n hintNode) string {
+	if w.depth <= 0 || len(n.elems) == 0 {
+		w.hj.write("[]")
+		return "[]"
+	}
+	w.depth--
+	defer func() { w.depth++ }()
+	w.hj.write("[")
+	var parts []string
+	for _, e := range n.elems {
+		w.line(indent + 2)
+		parts = append(parts, w.value(h.elem(), shape.elem(), indent+2, e))
+	}
+	w.line(indent)
+	w.hj.write("]")
+	return "[" + strings.Join(parts, ",") + "]"
+}
+
+func (w *hintWriter) object(h, shape hint, indent int, n hintNode) string {
+	if w.depth <= 0 || len(n.members) == 0 {
+		w.hj.write("{}")
+		return "{}"
+	}
+	w.depth--
+	defer func() { w.depth++ }()
+	w.hj.write("{")
+	s := w.members(h, shape, indent+2, n.members)
+	w.line(indent)
+	w.hj.write("}")
+	return s
+}
+
+// keyFor is the member's key for the destination h: a field name of a struct destination in
+// one of several spellings, or a plain key (known or unknown).
+func (w *hintWriter) keyFor(h hint, m hintMember) string {
+	_, t := w.hintStructType(h)
+	if t != nil && m.useField {
+		fields := structFields(t)
+		f := fields[m.fieldIx%len(fields)]
+		switch m.spelling {
+		case 0:
+			return strings.ToLower(f.name)
+		case 1:
+			return strings.ToUpper(f.name)
+		case 2:
+			// The long s folds to S in encoding/json.
+			return strings.Replace(strings.Replace(f.name, "S", "\u017f", 1), "s", "\u017f", 1)
+		default:
+			return f.name
+		}
+	}
+	return pickAt(hintKeys, m.keyIx)
+}
+
+func (w *hintWriter) hintStructType(h hint) (reflect.Value, reflect.Type) {
+	if h.elemType() != nil {
+		return reflect.Value{}, nil
+	}
+	d, t := h.unravel()
+	if t != nil && t.Kind() == reflect.Struct {
+		return d, t
+	}
+	return reflect.Value{}, nil
+}
+
+// writeKey writes a key, quoteless when it can be, and returns it.
+func (w *hintWriter) writeKey(k string, m hintMember) string {
+	if k != "" && !strings.ContainsAny(k, " \t\n\r{}[],:\"'#/") && m.plainKey {
+		w.hj.write(k)
+		return k
+	}
+	return w.hj.quoted(quotedRec{s: k, single: m.keyQ.single, forms: m.keyQ.forms})
+}
+
+// value writes a value for the destination h and returns the JSON text the parser gives it.
+func (w *hintWriter) value(h, shape hint, indent int, n hintNode) string {
+	if s, ok := w.fitting(h, shape, indent, n); ok {
+		return s
+	}
+	top := 10
+	if w.depth <= 0 {
+		top = 7
+	}
+	switch n.alt % top {
+	case 0, 1, 2, 3, 4:
+		return w.token(h, pickAt(hintTokens, n.tok))
+	case 5:
+		return jsonString(w.hj.quoted(n.qt))
+	case 6:
+		return jsonString(w.hj.multiline(n.ml))
+	case 7:
+		return w.array(h, shape, indent, n)
+	default:
+		return w.object(h, shape, indent, n)
+	}
+}
+
+// members writes object members, one per line, and returns the JSON object: keys in
+// first-occurrence order with the last value of a duplicated key (the parser's OrderedMap).
+func (w *hintWriter) members(h, shape hint, indent int, ms []hintMember) string {
+	var keys []string
+	vals := map[string]string{}
+	for _, m := range ms {
+		w.line(indent)
+		k := w.writeKey(w.keyFor(h, m), m)
+		w.hj.write([]string{":", ": ", " : "}[m.colon])
+		if _, t := w.hintStructType(h); t != nil {
+			fd, dok := fieldForAs(t, k, false)
+			fr, rok := fieldForAs(t, k, true)
+			if dok != rok || fd.name != fr.name {
+				w.foldedKey = true
+			}
+		}
+		v := w.value(h.child(k), shape.child(k), indent, m.val)
+		if _, dup := vals[k]; !dup {
+			keys = append(keys, k)
+		}
+		vals[k] = v
+	}
+	var sb strings.Builder
+	sb.WriteString("{")
+	for i, k := range keys {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString(jsonString(k) + ":" + vals[k])
+	}
+	sb.WriteString("}")
+	return sb.String()
+}
+
+// document writes the whole document into the destination got and returns the model JSON.
+func (w *hintWriter) document(d hintDoc, got *hinted) string {
+	root := hint{dest: reflect.ValueOf(got).Elem(), t: reflect.TypeOf(got)}
+	shape := root
+	shape.fold = true
+	if d.braces {
+		w.hj.write("{")
+		s := w.members(root, shape, 2, d.members)
+		w.line(0)
+		w.hj.write("}")
+		return s
+	}
+	s := w.members(root, shape, 0, d.members)
+	w.hj.write("\n")
+	return s
+}
+
+// TestHegelTypedHints: an Hjson object of quoteless, quoted and multiline values, arrays and
+// objects decodes into a (possibly pre-filled) struct with fields of every kind exactly as
+// encoding/json decodes the JSON text in which each quoteless token is a string when its
+// destination is string-typed and the raw token otherwise; with UseJSONNumber and
+// DisallowUnknownFields too. The recorded shapes: a TextUnmarshaler element, map value or
+// field behind a nil pointer (hjson/14), a key only unicode folding matches (hjson/16), a
+// number with a trailing decimal point (hjson/11), a surrogate pair (hjson/1).
+func TestHegelTypedHints(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, hintDocs)
+		want, got := d.pre.build(), d.pre.build()
+		opts := hjson.DefaultDecoderOptions()
+		opts.UseJSONNumber = d.useJSONNumber
+		opts.DisallowUnknownFields = d.disallowUnknown
+
+		w := &hintWriter{hj: &hjWriter{}, depth: 2}
+		modelJSON := w.document(d, got)
+		text := w.hj.sb.String()
+		if w.hj.surrog {
+			c.count("surrogate pairs")
+		}
+		shape := w.shapes()
+
+		dec := json.NewDecoder(bytes.NewReader([]byte(modelJSON)))
+		if opts.UseJSONNumber {
+			dec.UseNumber()
+		}
+		if opts.DisallowUnknownFields {
+			dec.DisallowUnknownFields()
+		}
+		wantErr := dec.Decode(want)
+		gotErr := hjson.UnmarshalWithOptions([]byte(text), got, opts)
+		if trailingDotAccepted(c, w, gotErr) {
+			return
+		}
+		if (wantErr == nil) != (gotErr == nil) {
+			c.mismatch(ht, "error", shape, "opts %+v\n%q\nmodel %s\n  hjson err %v\n  json err  %v", opts, show(text), modelJSON, gotErr, wantErr)
+			return
+		}
+		if wantErr != nil {
+			c.count("both error")
+			return
+		}
+		if !reflect.DeepEqual(want, got) {
+			c.mismatch(ht, "value", shape, "opts %+v\n%q\nmodel %s\n  got  %s\n  want %s", opts, show(text), modelJSON, showHinted(got), showHinted(want))
+		}
+	})
+}
+
+// trailingDotAccepted: while hjson/11 is reproduced, the parser's failure on a number with a
+// trailing decimal point (which depends on the destination) is accepted.
+func trailingDotAccepted(c *collector, w *hintWriter, gotErr error) bool {
+	if Known.trailingDotInternal && w.trailingDot && gotErr != nil {
+		c.count("trailing decimal point: internal error as recorded")
+		return true
+	}
+	return false
+}
+
+func showHinted(h *hinted) string {
+	b, err := json.Marshal(h)
+	if err != nil {
+		return fmt.Sprintf("%#v", h)
+	}
+	return string(b) + fmt.Sprintf(" (Skip=%q, PS nil=%v, Sub nil=%v)", h.Skip, h.PS == nil, h.Sub == nil)
+}
diff --git a/hegel/hegel_json_test.go b/hegel/hegel_json_test.go
new file mode 100644
index 0000000..5cb3188
--- /dev/null
+++ b/hegel/hegel_json_test.go
@@ -0,0 +1,325 @@
+package hegel
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- JSON texts
+
+// jsonStyle is the spelling of a JSON text: tapes read in order (modulo their length, empty
+// tapes reading as zero) of the whitespace between tokens, the escape form of every rune, the
+// case of \u escapes, the spelling of every number, the key order of every object, which keys
+// are written twice and the first value they get.
+type jsonStyle struct {
+	ws      []int // 0 none, else an index into jsonBlanks
+	forms   []int // 0 plain, 1 \u for BMP runes, 2 \/ for slashes, 3 plain (astral runes as pairs only below 2)
+	upper   []bool
+	nums    []int // 0 'e', 1 'E', 2 "12.0" or 'g', 3 encoding/json's
+	order   []int
+	dups    []bool
+	dupVals []interface{}
+}
+
+var jsonBlanks = []string{"", " ", "\t", "\n", "\r\n", "  ", " \n "}
+
+var jsonStyles = hegel.Composite(func(tc hegel.TestCase) jsonStyle {
+	return jsonStyle{
+		ws:      hegel.Draw(tc, upTo(maybe(30, hegel.Integers(1, len(jsonBlanks)-1)), 16)),
+		forms:   hegel.Draw(tc, upTo(hegel.Integers(0, 3), 12)),
+		upper:   hegel.Draw(tc, upTo(hegel.Booleans(), 6)),
+		nums:    hegel.Draw(tc, upTo(hegel.Integers(0, 3), 8)),
+		order:   hegel.Draw(tc, upTo(hegel.Integers(0, 11), 12)),
+		dups:    hegel.Draw(tc, upTo(chance(15), 8)),
+		dupVals: hegel.Draw(tc, upTo(valueAt(0), 4)),
+	}
+})
+
+// jsonCase: a value and the style it is written in.
+type jsonCase struct {
+	value interface{}
+	style jsonStyle
+}
+
+func (jc jsonCase) GoString() string {
+	w := &jsonWriter{style: jc.style}
+	w.value(jc.value)
+	return fmt.Sprintf("JSON text %q", w.sb.String())
+}
+
+var jsonCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+	return jsonCase{value: hegel.Draw(tc, valueAt(3)), style: hegel.Draw(tc, jsonStyles)}
+})
+
+// jsonWriter writes a value as a JSON text in a style (whitespace, escape spellings, number
+// spellings, key order and duplicate keys), and builds the value the text denotes: an ordered
+// tree (*hjson.OrderedMap for objects, in first-occurrence key order with the last value of a
+// duplicated key), as hjson must read it.
+type jsonWriter struct {
+	style      jsonStyle
+	pos        [7]int // the read position of every tape
+	sb         strings.Builder
+	dupes      bool // a duplicated key was written
+	surrogates bool // a \u surrogate pair was written
+}
+
+func (w *jsonWriter) next(tape int) int {
+	i := w.pos[tape]
+	w.pos[tape]++
+	return i
+}
+
+func (w *jsonWriter) ws() {
+	w.sb.WriteString(jsonBlanks[at(w.style.ws, w.next(0))])
+}
+
+// str writes s as a JSON string and returns the string hjson decodes it to.
+func (w *jsonWriter) str(s string) string {
+	w.sb.WriteByte('"')
+	var got strings.Builder
+	for _, r := range s {
+		form := at(w.style.forms, w.next(1))
+		switch {
+		case r == '"' || r == '\\':
+			w.sb.WriteByte('\\')
+			w.sb.WriteRune(r)
+		case r < 0x20 && form == 0 && strings.ContainsRune("\b\f\n\r\t", r):
+			w.sb.WriteByte('\\')
+			w.sb.WriteByte("btnfr"[strings.IndexRune("\b\t\n\f\r", r)])
+		case r < 0x20 || (form == 1 && r <= 0xffff):
+			if at(w.style.upper, w.next(2)) {
+				fmt.Fprintf(&w.sb, "\\u%04X", r)
+			} else {
+				fmt.Fprintf(&w.sb, "\\u%04x", r)
+			}
+		case r > 0xffff && form <= 1:
+			hi := 0xd800 + ((r - 0x10000) >> 10)
+			lo := 0xdc00 + ((r - 0x10000) & 0x3ff)
+			fmt.Fprintf(&w.sb, "\\u%04x\\u%04x", hi, lo)
+			w.surrogates = true
+			if Known.surrogatePairs {
+				got.WriteString(string([]rune{0xfffd, 0xfffd}))
+				continue
+			}
+		case r == '/' && form == 2:
+			w.sb.WriteString("\\/")
+		default:
+			w.sb.WriteRune(r)
+		}
+		got.WriteRune(r)
+	}
+	w.sb.WriteByte('"')
+	return got.String()
+}
+
+func (w *jsonWriter) num(f float64) {
+	switch at(w.style.nums, w.next(3)) {
+	case 0:
+		w.sb.WriteString(strconv.FormatFloat(f, 'e', -1, 64))
+	case 1:
+		w.sb.WriteString(strings.ToUpper(strconv.FormatFloat(f, 'e', -1, 64)))
+	case 2:
+		if f == float64(int64(f)) && f < 1e15 && f > -1e15 {
+			w.sb.WriteString(strconv.FormatFloat(f, 'f', 1, 64)) // "12.0"
+		} else {
+			w.sb.WriteString(strconv.FormatFloat(f, 'g', -1, 64))
+		}
+	default:
+		b, _ := json.Marshal(f)
+		w.sb.Write(b)
+	}
+}
+
+func (w *jsonWriter) value(v interface{}) interface{} {
+	w.ws()
+	defer w.ws()
+	switch x := v.(type) {
+	case nil:
+		w.sb.WriteString("null")
+		return nil
+	case bool:
+		if x {
+			w.sb.WriteString("true")
+		} else {
+			w.sb.WriteString("false")
+		}
+		return x
+	case float64:
+		w.num(x)
+		return x
+	case string:
+		return w.str(x)
+	case []interface{}:
+		w.sb.WriteByte('[')
+		out := make([]interface{}, 0, len(x))
+		for i, e := range x {
+			if i > 0 {
+				w.sb.WriteByte(',')
+			}
+			out = append(out, w.value(e))
+		}
+		w.ws()
+		w.sb.WriteByte(']')
+		return out
+	case map[string]interface{}:
+		keys := sortedKeys(x)
+		for i := len(keys) - 1; i > 0; i-- {
+			j := at(w.style.order, w.next(4)) % (i + 1)
+			keys[i], keys[j] = keys[j], keys[i]
+		}
+		w.sb.WriteByte('{')
+		om := hjson.NewOrderedMap()
+		first := true
+		write := func(k string, val interface{}) string {
+			if !first {
+				w.sb.WriteByte(',')
+			}
+			first = false
+			w.ws()
+			gotK := w.str(k)
+			w.ws()
+			w.sb.WriteByte(':')
+			om.Set(gotK, w.value(val))
+			return gotK
+		}
+		for _, k := range keys {
+			if at(w.style.dups, w.next(5)) {
+				// Overwritten by the value below (unless the two spellings of the key decode
+				// differently, which only the surrogate behaviour can cause).
+				k1 := write(k, at(w.style.dupVals, w.next(6)))
+				if k1 == write(k, x[k]) {
+					w.dupes = true
+				}
+				continue
+			}
+			write(k, x[k])
+		}
+		w.ws()
+		w.sb.WriteByte('}')
+		return om
+	}
+	panic("jsonWriter: unexpected value")
+}
+
+// ordered renders a decoded tree with object keys in their order (OrderedMap) and Nodes
+// unwrapped; plain maps sorted.
+func ordered(v interface{}) string {
+	var sb strings.Builder
+	orderedInto(&sb, v)
+	return sb.String()
+}
+
+func orderedInto(sb *strings.Builder, v interface{}) {
+	switch x := v.(type) {
+	case *hjson.OrderedMap:
+		sb.WriteByte('{')
+		for i, k := range x.Keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			b, _ := json.Marshal(k)
+			sb.Write(b)
+			sb.WriteByte(':')
+			orderedInto(sb, x.Map[k])
+		}
+		sb.WriteByte('}')
+	case hjson.OrderedMap:
+		orderedInto(sb, &x)
+	case *hjson.Node:
+		orderedInto(sb, x.Value)
+	case hjson.Node:
+		orderedInto(sb, x.Value)
+	case []interface{}:
+		sb.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			orderedInto(sb, e)
+		}
+		sb.WriteByte(']')
+	default:
+		canonInto(sb, v)
+	}
+}
+
+// TestHegelJSON: Hjson is a superset of JSON. A generated JSON text decodes through hjson (into
+// interface{}, with UseJSONNumber, into a Node and into an OrderedMap) to the value
+// encoding/json decodes it to, with object keys in first-occurrence order; DisallowDuplicateKeys
+// rejects exactly the texts with a duplicated key. A character outside the BMP written as a
+// surrogate pair is the shape of hjson/1.
+func TestHegelJSON(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		jc := hegel.Draw(ht, jsonCases)
+		w := &jsonWriter{style: jc.style}
+		want := w.value(jc.value)
+		text := w.sb.String()
+
+		var jv interface{}
+		if err := json.Unmarshal([]byte(text), &jv); err != nil {
+			ht.Fatalf("generated JSON rejected by encoding/json: %v\n%s", err, text)
+		}
+		wantCanon := canon(want)
+		if !(w.surrogates && Known.surrogatePairs) && canon(jv) != wantCanon {
+			ht.Fatalf("writer and encoding/json disagree: %s vs %s\n%s", canon(jv), wantCanon, text)
+		}
+		if w.dupes {
+			c.count("duplicate keys")
+		}
+		if w.surrogates {
+			c.count("surrogate pairs")
+		}
+		shape := shapeIf(w.surrogates, "hjson/1")
+
+		var hv interface{}
+		if err := hjson.Unmarshal([]byte(text), &hv); err != nil {
+			c.mismatch(ht, "interface error", shape, "hjson rejects the JSON text: %v\n%s", err, show(text))
+			return
+		}
+		if got := canon(hv); got != wantCanon {
+			c.mismatch(ht, "interface", shape, "hjson decodes %s\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+			return
+		}
+
+		opts := hjson.DefaultDecoderOptions()
+		opts.UseJSONNumber = true
+		var nv interface{}
+		if err := hjson.UnmarshalWithOptions([]byte(text), &nv, opts); err != nil {
+			c.mismatch(ht, "number error", shape, "UseJSONNumber: %v\n%s", err, show(text))
+		} else if got := canon(nv); got != wantCanon {
+			c.mismatch(ht, "number", shape, "UseJSONNumber decodes %s\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+		}
+
+		wantOrdered := ordered(want)
+		var node hjson.Node
+		if err := hjson.Unmarshal([]byte(text), &node); err != nil {
+			c.mismatch(ht, "node error", shape, "into Node: %v\n%s", err, show(text))
+		} else if got := ordered(&node); got != wantOrdered {
+			c.mismatch(ht, "node", shape, "into Node %s\n  got  %s\n  want %s", show(text), show(got), show(wantOrdered))
+		}
+
+		if om, ok := want.(*hjson.OrderedMap); ok {
+			var got hjson.OrderedMap
+			if err := hjson.Unmarshal([]byte(text), &got); err != nil {
+				c.mismatch(ht, "orderedmap error", shape, "into OrderedMap: %v\n%s", err, show(text))
+			} else if g := ordered(&got); g != ordered(om) {
+				c.mismatch(ht, "orderedmap", shape, "into OrderedMap %s\n  got  %s\n  want %s", show(text), show(g), show(wantOrdered))
+			}
+		}
+
+		opts = hjson.DefaultDecoderOptions()
+		opts.DisallowDuplicateKeys = true
+		var dv interface{}
+		err := hjson.UnmarshalWithOptions([]byte(text), &dv, opts)
+		if (err != nil) != w.dupes {
+			c.mismatch(ht, "duplicates", shape, "DisallowDuplicateKeys: err=%v, duplicated key written=%v\n%s", err, w.dupes, show(text))
+		}
+	})
+}
diff --git a/hegel/hegel_marshalers_test.go b/hegel/hegel_marshalers_test.go
new file mode 100644
index 0000000..f2f06bf
--- /dev/null
+++ b/hegel/hegel_marshalers_test.go
@@ -0,0 +1,402 @@
+package hegel
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- Marshaler values
+//
+// MarshalWithOptions: "If an encountered value implements the json.Marshaler interface then
+// the function MarshalJSON() is called on it. The JSON is then converted to Hjson ... If an
+// encountered value implements the encoding.TextMarshaler interface but not the json.Marshaler
+// interface, then the function MarshalText() is called on it to get a text." Map keys "must be
+// possible to print to a string using fmt.Sprintf("%v", key), or implement
+// encoding.TextMarshaler. The map keys are sorted alphabetically". The oracle is encoding/json:
+// the Hjson text of a value, decoded, is the value encoding/json gives it.
+
+type mjVal struct{ N int }
+
+func (m mjVal) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`{"v":%d}`, m.N)), nil }
+
+type mjPtr struct{ N int }
+
+func (m *mjPtr) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`{"p":%d}`, m.N)), nil }
+
+// The texts carry no colon: a root string with a colon reads back as an object (bug 9).
+type mtVal struct{ S string }
+
+func (m mtVal) MarshalText() ([]byte, error) { return []byte("t_" + m.S), nil }
+
+type mtPtr struct{ S string }
+
+func (m *mtPtr) MarshalText() ([]byte, error) { return []byte("pt_" + m.S), nil }
+
+// mjAny marshals to arbitrary JSON.
+type mjAny struct{ V interface{} }
+
+func (m mjAny) MarshalJSON() ([]byte, error) { return json.Marshal(m.V) }
+
+// mjBoth implements both interfaces; MarshalJSON must win.
+type mjBoth struct{ N int }
+
+func (m mjBoth) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`[%d]`, m.N)), nil }
+func (m mjBoth) MarshalText() ([]byte, error) { return []byte("text"), nil }
+
+type mjErr struct{}
+
+func (mjErr) MarshalJSON() ([]byte, error) { return nil, errors.New("no") }
+
+// plainN and plainS are what the encoder writes for mjPtr and mtPtr (their fields).
+type plainN struct{ N int }
+type plainS struct{ S string }
+
+// intKey is a map key type with a TextMarshaler whose text order differs from its value order.
+type intKey int
+
+var intKeyNames = map[intKey]string{1: "z", 2: "a", 3: "m", 4: "b", 5: "y", 10: "c"}
+
+var intKeys = []intKey{1, 2, 3, 4, 5, 10}
+
+func (k intKey) MarshalText() ([]byte, error) { return []byte(intKeyNames[k]), nil }
+
+// holder has Marshaler fields of every receiver kind; encoding/json calls a pointer-receiver
+// method on an addressable field (when the holder is marshalled through a pointer).
+type holder struct {
+	V  mjVal
+	P  mjPtr
+	PP *mjPtr
+	T  mtVal
+	TP mtPtr
+	B  mjBoth
+	A  mjAny
+}
+
+// oracleHolder is holder as the encoder writes it: pointer-receiver marshalers ignored.
+type oracleHolder struct {
+	V  mjVal
+	P  plainN
+	PP *plainN
+	T  mtVal
+	TP plainS
+	B  mjBoth
+	A  mjAny
+}
+
+// safeWords: plain words for strings and keys (the quoting rules are covered elsewhere).
+var safeWords = []string{"a", "b", "hello", "x y", "1", "true", "", "z"}
+
+var safeValueLevels = valueTower(hegel.SampledFrom(safeWords), hegel.SampledFrom(safeWords), 1)
+
+// mkind is a generated value's shape; build makes the value (real) and its oracle twin.
+type mkind int
+
+const (
+	kPlain mkind = iota
+	kMjVal
+	kMjPtr    // mjPtr by value (not addressable inside an interface: json writes its fields too)
+	kMjPtrPtr // *mjPtr
+	kMtVal
+	kMtPtr
+	kMtPtrPtr // *mtPtr
+	kMjAny
+	kMjBoth
+	kMjErr
+	kHolderPtr
+	kHolderVal
+	kList
+	kIntMap
+	kTextMap
+	kStrMap
+)
+
+type mspec struct {
+	kind  mkind
+	n     int
+	s     string
+	any   interface{}
+	items []mspec
+	keys  []intKey
+	ks    []string
+}
+
+func (sp mspec) GoString() string {
+	return fmt.Sprintf("%T %s", sp.build(false), string(mustJSON(sp.build(false))))
+}
+
+// specTower: level 0 holds scalars and holders; level d adds lists and string maps of level
+// d-1 specs.
+func specTower(depth int) []hegel.Generator[mspec] {
+	levels := make([]hegel.Generator[mspec], depth+1)
+	for d := 0; d <= depth; d++ {
+		top := int(kHolderVal)
+		var items hegel.Generator[[]mspec]
+		var smap hegel.Generator[map[string]mspec]
+		if d > 0 {
+			top = int(kStrMap)
+			items = upTo(levels[d-1], 3)
+			smap = hegel.Maps(hegel.SampledFrom(safeWords), levels[d-1]).MaxSize(3)
+		}
+		levels[d] = hegel.Composite(func(tc hegel.TestCase) mspec {
+			sp := mspec{kind: mkind(hegel.Draw(tc, hegel.Integers(0, top))), n: hegel.Draw(tc, hegel.Integers(-5, 100)), s: hegel.Draw(tc, hegel.SampledFrom(safeWords))}
+			if sp.kind == kMjErr && !hegel.Draw(tc, chance(20)) {
+				sp.kind = kMjAny
+			}
+			switch sp.kind {
+			case kPlain, kMjAny, kHolderPtr, kHolderVal:
+				sp.any = hegel.Draw(tc, safeValueLevels[1])
+			case kList:
+				sp.items = hegel.Draw(tc, items)
+			case kStrMap:
+				m := hegel.Draw(tc, smap)
+				ks := make([]string, 0, len(m))
+				for k := range m {
+					ks = append(ks, k)
+				}
+				sort.Strings(ks)
+				for _, k := range ks {
+					sp.ks = append(sp.ks, k)
+					sp.items = append(sp.items, m[k])
+				}
+			case kIntMap:
+				sp.keys = hegel.Draw(tc, upTo(hegel.SampledFrom(intKeys), 4))
+			case kTextMap:
+				sp.ks = hegel.Draw(tc, upTo(hegel.SampledFrom(safeWords), 3))
+			}
+			return sp
+		})
+	}
+	return levels
+}
+
+var specLevels = specTower(2)
+
+// hasErr reports whether the value's MarshalJSON fails somewhere.
+func (sp mspec) hasErr() bool {
+	if sp.kind == kMjErr {
+		return true
+	}
+	for _, it := range sp.items {
+		if it.hasErr() {
+			return true
+		}
+	}
+	return false
+}
+
+// hasPtrMarshaler reports whether the value holds a pointer-receiver marshaler that
+// encoding/json calls (the shape of hjson/13).
+func (sp mspec) hasPtrMarshaler() bool {
+	switch sp.kind {
+	case kMjPtrPtr, kMtPtrPtr, kHolderPtr, kHolderVal:
+		return true
+	}
+	for _, it := range sp.items {
+		if it.hasPtrMarshaler() {
+			return true
+		}
+	}
+	return false
+}
+
+// build makes the value; oracle asks for the twin encoding/json must see to write what the
+// encoder writes (pointer-receiver marshalers replaced by plain structs when the encoder
+// ignores them, as recorded).
+func (sp mspec) build(oracle bool) interface{} {
+	plain := oracle && Known.ptrMarshalers
+	switch sp.kind {
+	case kPlain:
+		return sp.any
+	case kMjVal:
+		return mjVal{N: sp.n}
+	case kMjPtr:
+		if plain {
+			return plainN{N: sp.n}
+		}
+		return mjPtr{N: sp.n}
+	case kMjPtrPtr:
+		if plain {
+			return &plainN{N: sp.n}
+		}
+		return &mjPtr{N: sp.n}
+	case kMtVal:
+		return mtVal{S: sp.s}
+	case kMtPtr:
+		if plain {
+			return plainS{S: sp.s}
+		}
+		return mtPtr{S: sp.s}
+	case kMtPtrPtr:
+		if plain {
+			return &plainS{S: sp.s}
+		}
+		return &mtPtr{S: sp.s}
+	case kMjAny:
+		return mjAny{V: sp.any}
+	case kMjBoth:
+		return mjBoth{N: sp.n}
+	case kMjErr:
+		return mjErr{}
+	case kHolderPtr, kHolderVal:
+		if plain {
+			h := oracleHolder{V: mjVal{sp.n}, P: plainN{sp.n + 1}, PP: &plainN{sp.n + 2}, T: mtVal{sp.s}, TP: plainS{sp.s + "!"}, B: mjBoth{sp.n}, A: mjAny{sp.any}}
+			if sp.kind == kHolderPtr {
+				return &h
+			}
+			return h
+		}
+		h := holder{V: mjVal{sp.n}, P: mjPtr{sp.n + 1}, PP: &mjPtr{sp.n + 2}, T: mtVal{sp.s}, TP: mtPtr{sp.s + "!"}, B: mjBoth{sp.n}, A: mjAny{sp.any}}
+		if sp.kind == kHolderPtr {
+			return &h
+		}
+		return h
+	case kList:
+		out := make([]interface{}, 0, len(sp.items))
+		for _, it := range sp.items {
+			out = append(out, it.build(oracle))
+		}
+		return out
+	case kStrMap:
+		out := map[string]interface{}{}
+		for i, it := range sp.items {
+			out[sp.ks[i]] = it.build(oracle)
+		}
+		return out
+	case kIntMap:
+		out := map[intKey]int{}
+		for i, k := range sp.keys {
+			out[k] = i
+		}
+		return out
+	default:
+		out := map[mtVal]int{}
+		for i, k := range sp.ks {
+			out[mtVal{S: k}] = i
+		}
+		return out
+	}
+}
+
+// keyOrder is the order of the keys of a map with TextMarshaler keys: alphabetically by text
+// as documented, or (as recorded, hjson/15) by the fmt %v of the key values.
+func (sp mspec) keyOrder(recorded bool) []string {
+	type kv struct{ sortBy, text string }
+	var kvs []kv
+	seen := map[string]bool{}
+	switch sp.kind {
+	case kIntMap:
+		for _, k := range sp.keys {
+			text := intKeyNames[k]
+			if !seen[text] {
+				seen[text] = true
+				kvs = append(kvs, kv{fmt.Sprintf("%v", int(k)), text})
+			}
+		}
+	case kTextMap:
+		for _, k := range sp.ks {
+			text := "t_" + k
+			if !seen[text] {
+				seen[text] = true
+				kvs = append(kvs, kv{fmt.Sprintf("%v", mtVal{S: k}), text})
+			}
+		}
+	}
+	sort.Slice(kvs, func(i, j int) bool {
+		if recorded {
+			return kvs[i].sortBy < kvs[j].sortBy
+		}
+		return kvs[i].text < kvs[j].text
+	})
+	var out []string
+	for _, x := range kvs {
+		out = append(out, x.text)
+	}
+	return out
+}
+
+// wantKeyOrder is the order the encoder writes the keys in.
+func (sp mspec) wantKeyOrder() []string { return sp.keyOrder(Known.mapKeyOrder) }
+
+// mCase: a value and the options it is encoded with.
+type mCase struct {
+	spec mspec
+	opts hjson.EncoderOptions
+}
+
+func (mc mCase) GoString() string { return fmt.Sprintf("%#v with %+v", mc.spec, mc.opts) }
+
+var mCases = hegel.Composite(func(tc hegel.TestCase) mCase {
+	opts := hegel.Draw(tc, encoderOptions)
+	opts.QuoteAmbiguousStrings = true // the words include 1 and true; the quoting rules are covered elsewhere
+	return mCase{spec: hegel.Draw(tc, specLevels[2]), opts: opts}
+})
+
+// TestHegelMarshalers: a value with json.Marshaler and encoding.TextMarshaler parts (value and
+// pointer receivers, direct, behind pointers, in struct fields, lists and maps, as map keys)
+// marshals to Hjson that decodes to what encoding/json writes for it; a failing MarshalJSON
+// fails Marshal; maps with TextMarshaler keys are written in key order. A pointer-receiver
+// marshaler is the shape of hjson/13; keys whose text order differs from their value order
+// that of hjson/15.
+func TestHegelMarshalers(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, mCases)
+		checkMarshalers(c, ht, mc.spec, mc.opts, shapeIf(mc.spec.hasPtrMarshaler(), "hjson/13"))
+	})
+}
+
+// checkMarshalers is the oracle of TestHegelMarshalers on one value; shape names the recorded
+// shapes the value has.
+func checkMarshalers(c *collector, ht *hegel.T, sp mspec, opts hjson.EncoderOptions, shape []string) {
+	{
+		real := sp.build(false)
+		text, err := hjson.MarshalWithOptions(real, opts)
+		if sp.hasErr() {
+			c.count("marshal error")
+			if err == nil {
+				c.failClass(ht, "no error", "Marshal of a failing MarshalJSON succeeded: %q", show(string(text)))
+			}
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, "error", shape, "Marshal %T: %v", real, err)
+			return
+		}
+		var got interface{}
+		if err := hjson.Unmarshal(text, &got); err != nil {
+			c.mismatch(ht, "decode error", shape, "Unmarshal of the encoder's output: %v\n%q", err, show(string(text)))
+			return
+		}
+		var want interface{}
+		if err := json.Unmarshal(mustJSON(sp.build(true)), &want); err != nil {
+			panic(err)
+		}
+		if g, w := canon(got), canon(want); g != w {
+			c.mismatch(ht, "value", shape, "%T under %+v\n%q\n  got  %s\n  want %s", real, opts, show(string(text)), show(g), show(w))
+			return
+		}
+		if sp.kind == kIntMap || sp.kind == kTextMap {
+			shape = append(shape, shapeIf(sp.orderDiffers(), "hjson/15")...)
+			var om hjson.OrderedMap
+			if err := hjson.Unmarshal(text, &om); err != nil {
+				c.mismatch(ht, "om error", shape, "into OrderedMap: %v\n%q", err, show(string(text)))
+				return
+			}
+			if g, w := strings.Join(om.Keys, ","), strings.Join(sp.wantKeyOrder(), ","); g != w {
+				c.mismatch(ht, "key order", shape, "%T\n%q\n  keys %s\n  want %s", real, show(string(text)), g, w)
+			}
+		}
+	}
+}
+
+// orderDiffers: the map's keys sort differently by text and by value (the shape of hjson/15).
+func (sp mspec) orderDiffers() bool {
+	return strings.Join(sp.keyOrder(false), ",") != strings.Join(sp.keyOrder(true), ",")
+}
diff --git a/hegel/hegel_node_test.go b/hegel/hegel_node_test.go
new file mode 100644
index 0000000..39d5f02
--- /dev/null
+++ b/hegel/hegel_node_test.go
@@ -0,0 +1,280 @@
+package hegel
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// reCRLF: a CRLF line end not following a key's colon (BracesSameLine off puts the value's
+// bracket on the next line, and that line end is kept verbatim in the Key comment).
+var reCRLF = regexp.MustCompile(`([^:\r])\r\n`)
+
+// reMLBlank: an array element that is a multiline string: a blank (indented) line, then the
+// line of the opening \u201d'.
+var reMLBlank = regexp.MustCompile(`(\r?\n)([ \t]*)(\r?\n)([ \t]*)'''`)
+
+// hasMLInArray reports whether some array element of v is encoded as a multiline string over
+// several lines.
+func hasMLInArray(v interface{}, o hjson.EncoderOptions, inArray bool) bool {
+	switch x := v.(type) {
+	case string:
+		if !inArray || !strings.Contains(x, "\n") {
+			return false
+		}
+		quoted := o.QuoteAlways || reNeedsQuotes.MatchString(x) || (o.QuoteAmbiguousStrings && ambiguous(x))
+		return quoted && reNeedsEscape.MatchString(x) && !reNeedsEscapeML.MatchString(x)
+	case []interface{}:
+		for _, e := range x {
+			if hasMLInArray(e, o, true) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasMLInArray(e, o, false) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasLineFeedEnd reports whether some string value of v ends in a line feed (followed by
+// blanks at most): its last line is an empty line, which the layout cannot tell from an added
+// blank line.
+func hasLineFeedEnd(v interface{}) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.HasSuffix(strings.TrimRight(x, " \t"), "\n")
+	case []interface{}:
+		for _, e := range x {
+			if hasLineFeedEnd(e) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasLineFeedEnd(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasColonEnd reports whether some string value of v ends in a colon.
+func hasColonEnd(v interface{}) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.HasSuffix(x, ":")
+	case []interface{}:
+		for _, e := range x {
+			if hasColonEnd(e) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasColonEnd(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// nodeCase: a value, its encoder options, and whether the Node keeps whitespace as comments.
+type nodeCase struct {
+	value      interface{}
+	opts       hjson.EncoderOptions
+	whitespace bool
+}
+
+func (n nodeCase) GoString() string {
+	return fmt.Sprintf("%s with %+v, whitespace kept: %v", canon(n.value), n.opts, n.whitespace)
+}
+
+var nodeCases = hegel.FlatMap(encoderOptions, func(o hjson.EncoderOptions) hegel.Generator[nodeCase] {
+	return hegel.Composite(func(tc hegel.TestCase) nodeCase {
+		return nodeCase{value: hegel.Draw(tc, valuesFor(o, 3)), opts: o, whitespace: hegel.Draw(tc, chance(70))}
+	})
+})
+
+// TestHegelNodeFixedPoint: the encoder's own output, read into a Node (whitespace and comments
+// kept, or not) and encoded again with the same options, is the same text; the Node's value is
+// the value the text decodes to. With the whitespace kept, a BaseIndentation (hjson/3), CRLF
+// line ends (hjson/8) and a multiline string in an array (hjson/10) are recorded shapes.
+func TestHegelNodeFixedPoint(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNodeFixedPoint(c, ht, hegel.Draw(ht, nodeCases), nil)
+	})
+}
+
+// checkNodeFixedPoint is the oracle of TestHegelNodeFixedPoint on one case; extra names the
+// shapes the drawn region has.
+func checkNodeFixedPoint(c *collector, ht *hegel.T, nc nodeCase, extra []string) {
+	{
+		v, opts := nc.value, nc.opts
+		_, ok, changed, shape := expectedDecode(v, opts, true)
+		shape = append(shape, extra...)
+		if !ok || changed {
+			// A string the round trip does not preserve (see stringOutcome): the re-encoded
+			// text cannot be the same.
+			c.skip(ht, "string not preserved")
+		}
+		b, err := hjson.MarshalWithOptions(v, opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		text := string(b)
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = nc.whitespace
+		if dopts.WhitespaceAsComments {
+			c.count("whitespace kept")
+		}
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions(b, &node, dopts); err != nil {
+			c.mismatch(ht, "reject", shape, "into Node: %v\n%+v\n%q", err, opts, show(text))
+			return
+		}
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.mismatch(ht, "reject", shape, "into interface{}: %v\n%q", err, show(text))
+			return
+		}
+		if got, want := canon(&node), canon(back); got != want {
+			c.mismatch(ht, "value", shape, "Node value %s, interface{} value %s\n%q", show(got), show(want), show(text))
+			return
+		}
+		again, err := hjson.MarshalWithOptions(node, opts)
+		if err != nil {
+			c.mismatch(ht, "marshal", shape, "Marshal(node): %v\n%q", err, show(text))
+			return
+		}
+		want := text
+		kept := dopts.WhitespaceAsComments && opts.Comments
+		m, isMap := v.(map[string]interface{})
+		bracelessRoot := isMap && !opts.EmitRootBraces && len(m) > 0
+		baseIndent := kept && opts.BaseIndentation != "" && !bracelessRoot
+		crlf := kept && opts.Eol == "\r\n"
+		mlArray := kept && hasMLInArray(v, opts, false)
+		if Known.baseIndentDoubled && baseIndent {
+			want = opts.BaseIndentation + text
+		}
+		if Known.crlfDoubled && crlf {
+			if strings.Contains(text, "'''") || hasColonEnd(v) {
+				// The line ends inside a multiline string, and a key line whose value follows on
+				// the next line, are not doubled; a string ending in a colon looks like the latter.
+				c.skip(ht, "CRLF with a multiline string or a colon-ending string")
+			}
+			want = reCRLF.ReplaceAllString(want, "$1\r\r\n")
+		}
+		if Known.mlArrayBlankLine && mlArray {
+			if opts.IndentBy == "" || hasLineFeedEnd(v) {
+				// The blank line cannot be told from a multiline string's last empty line.
+				c.skip(ht, "multiline string in an array, ambiguous layout")
+			}
+			want = reMLBlank.ReplaceAllString(want, "$1$2$3$4$3$4'''")
+		}
+		shape = append(shape, shapeIf(baseIndent, "hjson/3")...)
+		shape = append(shape, shapeIf(crlf, "hjson/8")...)
+		shape = append(shape, shapeIf(mlArray, "hjson/10")...)
+		if string(again) != want {
+			c.mismatch(ht, "text", shape, "Marshal(node) differs from the text it was read from\n%+v whitespaceAsComments=%v\n  text  %q\n  again %q", opts, dopts.WhitespaceAsComments, show(text), show(string(again)))
+		}
+	}
+}
+
+// Lines of a string the encoder writes in the multi-line form (a line feed, no three quotes,
+// no other control character, not blank).
+var mlWords = []string{"a", "b", "line", "x y", "1", "true", "  in", "\u00e9", "q'", "\"", "\\", "#", "{", ":"}
+
+// mlStrings: a string with a line feed that the encoder writes as a multi-line string: two to
+// four lines of words.
+var mlStrings = hegel.Map(many(hegel.SampledFrom(mlWords), 2, 4), func(lines []string) string {
+	return strings.Join(lines, "\n")
+})
+
+// mlNeighbours: the other elements beside a multi-line string.
+var mlNeighbours = hegel.SampledFrom([]interface{}{1.0, "x", true, nil, []interface{}{}})
+
+// mlArrays: an array with a multi-line string element, as is or as an object's member value
+// (the shape of hjson/10).
+var mlArrays = hegel.Composite(func(tc hegel.TestCase) interface{} {
+	arr := hegel.Draw(tc, many(mlNeighbours, 1, 3))
+	arr[hegel.Draw(tc, hegel.Integers(0, len(arr)-1))] = hegel.Draw(tc, mlStrings)
+	if hegel.Draw(tc, chance(30)) {
+		return map[string]interface{}{"k": arr}
+	}
+	return arr
+})
+
+// mlObjects: an object with a multi-line string member value beside other members, as is or
+// inside an array: the region next to hjson/10, where the layout is kept.
+var mlObjects = hegel.Composite(func(tc hegel.TestCase) interface{} {
+	obj := hegel.Draw(tc, hegel.Maps(hegel.SampledFrom(keyWords), mlNeighbours).MaxSize(3))
+	if obj == nil {
+		obj = map[string]interface{}{}
+	}
+	obj[hegel.Draw(tc, hegel.SampledFrom(keyWords))] = hegel.Draw(tc, mlStrings)
+	if hegel.Draw(tc, chance(30)) {
+		return []interface{}{obj}
+	}
+	return obj
+})
+
+type mlLayoutCase struct {
+	value interface{}
+	opts  hjson.EncoderOptions
+}
+
+func (m mlLayoutCase) GoString() string { return fmt.Sprintf("%s with %+v", canon(m.value), m.opts) }
+
+var mlLayoutCases = hegel.Composite(func(tc hegel.TestCase) mlLayoutCase {
+	opts := hjson.DefaultOptions()
+	opts.IndentBy = hegel.Draw(tc, hegel.SampledFrom([]string{"  ", "\t", "    "}))
+	opts.BracesSameLine = hegel.Draw(tc, chance(50))
+	opts.EmitRootBraces = hegel.Draw(tc, chance(70))
+	return mlLayoutCase{value: hegel.Draw(tc, shaped[hegel.Generator[interface{}]](mlArrays, mlObjects)), opts: opts}
+})
+
+// TestHegelArrayMultilineLayout: a container with a multi-line string, encoded with a
+// non-empty IndentBy, read into a Node with its whitespace and encoded again with the same
+// options, is the same text (the oracle of TestHegelNodeFixedPoint without its model of the
+// recorded layout changes). The string is an array element (the shape of hjson/10); under
+// HEGEL_NO_KNOWN=1 it is an object member's value.
+func TestHegelArrayMultilineLayout(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, mlLayoutCases)
+		v, opts := mc.value, mc.opts
+		shape := known("hjson/10")
+		b, err := hjson.MarshalWithOptions(v, opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = true
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions(b, &node, dopts); err != nil {
+			c.mismatch(ht, "reject", shape, "into Node: %v\n%q", err, show(string(b)))
+			return
+		}
+		again, err := hjson.MarshalWithOptions(node, opts)
+		if err != nil {
+			c.mismatch(ht, "marshal", shape, "Marshal(node): %v\n%q", err, show(string(b)))
+			return
+		}
+		if string(again) != string(b) {
+			c.mismatch(ht, "text", shape, "Marshal(node) differs from the text it was read from\n%+v\n  text  %q\n  again %q", opts, show(string(b)), show(string(again)))
+		}
+	})
+}
diff --git a/hegel/hegel_parse_test.go b/hegel/hegel_parse_test.go
new file mode 100644
index 0000000..dbf279d
--- /dev/null
+++ b/hegel/hegel_parse_test.go
@@ -0,0 +1,1057 @@
+package hegel
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- Hjson documents
+//
+// A document is drawn as a tree of syntax records (per value its spelling - keyword, number,
+// quoteless, single- or double-quoted, multiline, array, object -, per member its key spelling,
+// separator and the whitespace/comment tape of every gap, the line end of every line, a
+// braceless root) and rendered by hjWriter, a pure writer that follows the Hjson syntax
+// (hjson.github.io/syntax.html) and builds the value the document denotes: quoteless strings
+// run to the end of the line and are trimmed; a value is a number or keyword only when its
+// text up to the next punctuator, comment or line end says so; a multiline string's lines lose
+// the indentation of the opening triple-quote and its last line feed; the root may be a braceless
+// object, tried first, with the single value as the fallback.
+
+// ---- records
+
+// commentRec is a comment: '#' or '//' to the line end nl, or a block comment.
+type commentRec struct {
+	kind int    // 0 '#', 1 '//', 2 block
+	text string // from commentTexts
+	more string // the block comment's continuation
+	nl   string // the line end after a line comment
+}
+
+// gapItem is one piece of the whitespace between two tokens.
+type gapItem struct {
+	kind    int // 0 space, 1 tab, 2 line end, 3 comment
+	nl      string
+	comment commentRec
+}
+
+// gapRec is the whitespace and comments between two tokens; nl is the line end written first
+// when a quoteless string precedes (only a line end can follow one).
+type gapRec struct {
+	nl    string
+	items []gapItem
+}
+
+// quotelessRec is a quoteless string: its pieces, and the blanks after it (trimmed by the
+// parser).
+type quotelessRec struct {
+	first string
+	rest  []string
+	trail string
+}
+
+func (q quotelessRec) text() string { return strings.TrimSpace(q.first + strings.Join(q.rest, "")) }
+
+// quotedRec is a string in double or single quotes; forms is the tape of escape spellings, one
+// per rune (0: the plain spelling).
+type quotedRec struct {
+	s      string
+	single bool
+	forms  []int
+}
+
+// indentRec is the indentation of a multiline string's line relative to the opening column:
+// exact, fewer blanks, extra blanks (content), or tabs.
+type indentRec struct {
+	kind  int
+	less  int
+	extra string
+}
+
+func (r indentRec) render(indent int) string {
+	switch r.kind {
+	case 1:
+		return strings.Repeat(" ", max(0, indent-r.less))
+	case 2:
+		return strings.Repeat(" ", indent) + r.extra
+	case 3:
+		return strings.Repeat("\t", indent)
+	}
+	return strings.Repeat(" ", indent)
+}
+
+type mlLineRec struct {
+	indent indentRec
+	text   string
+	nl     string
+}
+
+// mlRec is a \u201d' string: the single-line form, or an opening line (with content, or blanks,
+// or nothing), content lines and a closing line indented by closing blanks (taken modulo the
+// opening column).
+type mlRec struct {
+	single   bool
+	line     string
+	hasFirst bool
+	blank    string
+	nl       string
+	lines    []mlLineRec
+	closing  int
+}
+
+// numRec is a number: its text, the value it denotes, and the shapes of hjson/11 (a trailing
+// decimal point) and hjson/12 (beyond float64).
+type numRec struct {
+	text        string
+	trailingDot bool
+	huge        bool
+}
+
+// keyRec is an object key, quoteless or quoted.
+type keyRec struct {
+	quoted bool
+	q      quotedRec
+	plain  string
+}
+
+// sepRec separates two members: a comma, or a line end with a comma on the next line or none.
+type sepRec struct {
+	comma   bool
+	nlComma bool
+	nl      string
+	gap     gapRec
+}
+
+// closeRec ends a container: a trailing comma after the last member or not, and the gap
+// before the bracket.
+type closeRec struct {
+	nl    string
+	comma bool
+	gap   gapRec
+}
+
+type arrayElem struct {
+	sep sepRec
+	val hjNode
+}
+
+type memberRec struct {
+	sep       sepRec
+	key       keyRec
+	preColon  gapRec
+	postColon gapRec
+	val       hjNode
+}
+
+// hjNode is a value of the document.
+type hjNode struct {
+	kind      int // 0 keyword, 1 number, 2 quoteless, 3 quoted, 4 multiline, 5 array, 6 object, 7 root quoteless
+	kw        int // 0 true, 1 false, 2 null
+	num       numRec
+	ql        quotelessRec
+	qt        quotedRec
+	ml        mlRec
+	open      gapRec
+	elems     []arrayElem
+	members   []memberRec
+	braceless bool
+	close     closeRec
+}
+
+// hjDoc is a document: leading whitespace, the root value, trailing whitespace or not.
+type hjDoc struct {
+	lead  gapRec
+	root  hjNode
+	trail *gapRec
+}
+
+// GoString is what the draw report prints (it uses %#v): the document text and its value.
+func (d hjDoc) GoString() string {
+	w := &hjWriter{}
+	v := w.document(d)
+	return fmt.Sprintf("document %q denoting %s", w.sb.String(), canon(v))
+}
+
+// rootEmptyValue is the value of a braceless root object whose last member has nothing after
+// its colon (the shape of hjson/20): the parser must reject the document or fall back to the
+// single quoteless string s.
+type rootEmptyValue struct{ s string }
+
+// ---- generators
+
+var commentTexts = []string{"", " c", " a comment", " x: 1", " [1, 2]", " '''", " \"q\"", " # nested", " // slashes", " {", "\t", " \u00e9"}
+
+var (
+	lineEnds = hegel.SampledFrom([]string{"\n", "\n", "\r\n"})
+	comments = hegel.Composite(func(tc hegel.TestCase) commentRec {
+		return commentRec{
+			kind: hegel.Draw(tc, hegel.Integers(0, 2)),
+			text: hegel.Draw(tc, hegel.SampledFrom(commentTexts)),
+			more: hegel.Draw(tc, hegel.SampledFrom([]string{"", "\n", "\n  * more\n"})),
+			nl:   hegel.Draw(tc, lineEnds),
+		}
+	})
+	gapItems = weighted(
+		choice[gapItem]{1, hegel.Just(gapItem{kind: 0})},
+		choice[gapItem]{1, hegel.Just(gapItem{kind: 1})},
+		choice[gapItem]{1, hegel.Map(lineEnds, func(nl string) gapItem { return gapItem{kind: 2, nl: nl} })},
+		choice[gapItem]{2, hegel.Map(comments, func(c commentRec) gapItem { return gapItem{kind: 3, comment: c} })},
+	)
+	// gaps: up to two pieces.
+	gaps = hegel.Composite(func(tc hegel.TestCase) gapRec {
+		return gapRec{nl: hegel.Draw(tc, lineEnds), items: hegel.Draw(tc, upTo(gapItems, 2))}
+	})
+)
+
+var (
+	quotelessAtoms = []string{"a", "b", "x", "Z", "0", "1", "9", " ", "-", ".", "/", "#", "*", ":", "{", "}", "[", "]", ",", "'", "\"", "\\", "\u00e9", "\U0001F600", "true", "null", "1", "0x", "e5", "5 times", "//", "/*"}
+	// quotelessStarts: the atoms a quoteless string can start with (no punctuator, quote or
+	// comment start).
+	quotelessStarts = []string{"a", "b", "x", "Z", "0", "1", "9", " ", "-", ".", "/", "*", "\\", "\u00e9", "\U0001F600", "true", "null", "0x", "e5", "5 times"}
+	blanks          = hegel.SampledFrom([]string{" ", "  ", "\t"})
+	// quotelessRecs: a quoteless string that the parser reads as a plain string (quotelessOK).
+	quotelessRecs = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) quotelessRec {
+		return quotelessRec{
+			first: hegel.Draw(tc, hegel.SampledFrom(quotelessStarts)),
+			rest:  hegel.Draw(tc, upTo(hegel.SampledFrom(quotelessAtoms), 3)),
+			trail: hegel.Draw(tc, maybe(30, blanks)),
+		}
+	}), func(q quotelessRec) bool { return quotelessOK(q.text()) })
+	escapeForms = upTo(hegel.Integers(0, 3), 6)
+)
+
+// quotedOf is a quoted string with its text from strG.
+func quotedOf(strG hegel.Generator[string]) hegel.Generator[quotedRec] {
+	return hegel.Composite(func(tc hegel.TestCase) quotedRec {
+		return quotedRec{s: hegel.Draw(tc, strG), single: hegel.Draw(tc, chance(30)), forms: hegel.Draw(tc, escapeForms)}
+	})
+}
+
+var quoteds = quotedOf(strs)
+
+var mlAtoms = []string{"a", "line", " ", "  ", "\t", "'", "''", "\"", "\\", "#", "//", "/*", "{", "}", ":", ",", "\u00e9", "\U0001F600", "1", "true"}
+
+var (
+	// mlLines: a multiline string line without triple-quote and not ending in a quote (which would
+	// merge with the closing delimiter).
+	mlLines = hegel.Filter(joined(upTo(hegel.SampledFrom(mlAtoms), 3)), func(s string) bool {
+		return !strings.Contains(s, "'''") && !strings.HasSuffix(s, "'")
+	})
+	indents = weighted(
+		choice[indentRec]{2, hegel.Just(indentRec{kind: 0})},
+		choice[indentRec]{1, hegel.Map(hegel.Integers(1, 2), func(n int) indentRec { return indentRec{kind: 1, less: n} })},
+		choice[indentRec]{1, hegel.Map(hegel.SampledFrom([]string{" ", "\t", "   "}), func(x string) indentRec { return indentRec{kind: 2, extra: x} })},
+		choice[indentRec]{1, hegel.Just(indentRec{kind: 3})},
+	)
+	mlLineRecs = hegel.Composite(func(tc hegel.TestCase) mlLineRec {
+		return mlLineRec{indent: hegel.Draw(tc, indents), text: hegel.Draw(tc, mlLines), nl: hegel.Draw(tc, lineEnds)}
+	})
+	mlRecs = hegel.Composite(func(tc hegel.TestCase) mlRec {
+		return mlRec{
+			single:   hegel.Draw(tc, chance(30)),
+			line:     hegel.Draw(tc, mlLines),
+			hasFirst: hegel.Draw(tc, chance(20)),
+			blank:    hegel.Draw(tc, maybe(30, hegel.SampledFrom([]string{" ", "\t"}))),
+			nl:       hegel.Draw(tc, lineEnds),
+			lines:    hegel.Draw(tc, upTo(mlLineRecs, 4)),
+			closing:  hegel.Draw(tc, hegel.Integers(0, 8)),
+		}
+	})
+)
+
+var (
+	exponentMarks = hegel.SampledFrom([]string{"e", "E"})
+	// numberSpellings: integers, decimals, exponents (finite), the specials, and at modest rates
+	// the shapes of hjson/11 (a trailing decimal point, 1. and 1.e5) and hjson/12 (beyond
+	// float64, 1e400).
+	numberSpellings = weighted(
+		choice[string]{19, hegel.Map(hegel.Integers(-1000, 1000), strconv.Itoa)},
+		choice[string]{19, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d.%d", hegel.Draw(tc, hegel.Integers(-99, 99)), hegel.Draw(tc, hegel.Integers(0, 999)))
+		})},
+		choice[string]{19, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d%s%s%d", hegel.Draw(tc, hegel.Integers(-9, 9)), hegel.Draw(tc, exponentMarks), hegel.Draw(tc, hegel.SampledFrom([]string{"", "+", "-"})), hegel.Draw(tc, hegel.Integers(0, 300)))
+		})},
+		choice[string]{19, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d.%d%s%d", hegel.Draw(tc, hegel.Integers(0, 9)), hegel.Draw(tc, hegel.Integers(0, 99)), hegel.Draw(tc, exponentMarks), hegel.Draw(tc, hegel.Integers(-300, 300)))
+		})},
+		choice[string]{14, hegel.SampledFrom([]string{"0", "-0", "0.0", "-0.5", "1e0", "123456789012345678901234567890", "0.000001", "9E9"})},
+		choice[string]{5, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d.%s", hegel.Draw(tc, hegel.Integers(0, 99)), hegel.Draw(tc, maybe(25, hegel.Map(hegel.Integers(0, 9), func(e int) string { return "e" + strconv.Itoa(e) }))))
+		})},
+		choice[string]{5, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%s%d%s%d", hegel.Draw(tc, hegel.SampledFrom([]string{"", "-"})), hegel.Draw(tc, hegel.Integers(1, 9)), hegel.Draw(tc, exponentMarks), hegel.Draw(tc, hegel.Integers(309, 999)))
+		})},
+	)
+	numRecs = hegel.Map(numberSpellings, numRecOf)
+)
+
+// numRecOf classifies a number text: beyond float64 (hjson/12) or with a trailing decimal
+// point (hjson/11).
+func numRecOf(text string) numRec {
+	f, err := strconv.ParseFloat(text, 64)
+	if err != nil && !math.IsInf(f, 0) {
+		panic("hjWriter: bad number " + text)
+	}
+	i := strings.IndexByte(text, '.')
+	return numRec{
+		text:        text,
+		trailingDot: i >= 0 && (i == len(text)-1 || text[i+1] < '0' || text[i+1] > '9'),
+		huge:        math.IsInf(f, 0),
+	}
+}
+
+// value is the value the parser gives the number: a float64; beyond float64 a json.Number
+// (the parser's number type when float64 cannot hold it), or the quoteless string as a Node
+// reads it while hjson/12 is reproduced.
+func (n numRec) value() interface{} {
+	if n.huge {
+		if Known.hugeNumberString {
+			return n.text
+		}
+		return json.Number(n.text)
+	}
+	f, _ := strconv.ParseFloat(n.text, 64)
+	return f
+}
+
+var keyAtoms = []string{"a", "b", "key", "Key", "1", "-", "_", ".", "/", "#", "*", "true", "\u00e9", "\U0001F600", "x-y", "$", "@", "!", "%", "=", "?", "~", "|", ";", "<", ">", "(", ")", "+", "\\", "&"}
+
+// quotelessKeyOK: no blank, punctuator or quote; it must not start a comment.
+func quotelessKeyOK(k string) bool {
+	return !strings.ContainsAny(k, " \t\n\r{}[],:\"'") && k[0] != '#' && !strings.HasPrefix(k, "//") && !strings.HasPrefix(k, "/*")
+}
+
+var (
+	plainKeys = hegel.Filter(joined(many(hegel.SampledFrom(keyAtoms), 1, 3)), quotelessKeyOK)
+	keyRecs   = weighted(
+		choice[keyRec]{65, hegel.Map(plainKeys, func(k string) keyRec { return keyRec{plain: k} })},
+		choice[keyRec]{35, hegel.Map(quotedOf(joined(upTo(hegel.SampledFrom(stringAtoms), 3))), func(q quotedRec) keyRec { return keyRec{quoted: true, q: q} })},
+	)
+	seps = hegel.Composite(func(tc hegel.TestCase) sepRec {
+		return sepRec{comma: hegel.Draw(tc, chance(50)), nlComma: hegel.Draw(tc, chance(20)), nl: hegel.Draw(tc, lineEnds), gap: hegel.Draw(tc, gaps)}
+	})
+	closings = hegel.Composite(func(tc hegel.TestCase) closeRec {
+		return closeRec{nl: hegel.Draw(tc, lineEnds), comma: hegel.Draw(tc, chance(25)), gap: hegel.Draw(tc, gaps)}
+	})
+)
+
+// The scalar nodes.
+var (
+	keywordNodes   = hegel.Map(hegel.Integers(0, 2), func(kw int) hjNode { return hjNode{kind: 0, kw: kw} })
+	numberNodes    = hegel.Map(numRecs, func(n numRec) hjNode { return hjNode{kind: 1, num: n} })
+	quotelessNodes = hegel.Map(quotelessRecs, func(q quotelessRec) hjNode { return hjNode{kind: 2, ql: q} })
+	quotedNodes    = hegel.Map(quoteds, func(q quotedRec) hjNode { return hjNode{kind: 3, qt: q} })
+	mlNodes        = hegel.Map(mlRecs, func(m mlRec) hjNode { return hjNode{kind: 4, ml: m} })
+	scalarNodes    = []hegel.Generator[hjNode]{keywordNodes, numberNodes, quotelessNodes, quotedNodes, mlNodes, quotelessNodes}
+)
+
+// arrayNodes is an array of up to four elements from elems.
+func arrayNodes(elems hegel.Generator[hjNode]) hegel.Generator[hjNode] {
+	elem := hegel.Composite(func(tc hegel.TestCase) arrayElem {
+		return arrayElem{sep: hegel.Draw(tc, seps), val: hegel.Draw(tc, elems)}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) hjNode {
+		return hjNode{kind: 5, open: hegel.Draw(tc, gaps), elems: hegel.Draw(tc, upTo(elem, 4)), close: hegel.Draw(tc, closings)}
+	})
+}
+
+// objectNodes is an object of lo to four members whose values come from vals.
+func objectNodes(vals hegel.Generator[hjNode], lo int, braceless bool) hegel.Generator[hjNode] {
+	member := hegel.Composite(func(tc hegel.TestCase) memberRec {
+		return memberRec{
+			sep:       hegel.Draw(tc, seps),
+			key:       hegel.Draw(tc, keyRecs),
+			preColon:  hegel.Draw(tc, gaps),
+			postColon: hegel.Draw(tc, gaps),
+			val:       hegel.Draw(tc, vals),
+		}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) hjNode {
+		return hjNode{kind: 6, open: hegel.Draw(tc, gaps), members: hegel.Draw(tc, many(member, lo, 4)), braceless: braceless, close: hegel.Draw(tc, closings)}
+	})
+}
+
+// nodeLevels: level 0 holds the scalars; the containers of level d hold values of level d-1.
+var nodeLevels = func() []hegel.Generator[hjNode] {
+	levels := make([]hegel.Generator[hjNode], 3)
+	levels[0] = hegel.OneOf(scalarNodes...)
+	for d := 1; d < len(levels); d++ {
+		levels[d] = hegel.OneOf(append(append([]hegel.Generator[hjNode]{}, scalarNodes...), arrayNodes(levels[d-1]), objectNodes(levels[d-1], 0, false))...)
+	}
+	return levels
+}()
+
+// nodeAt is a value of at most depth container levels below it (two at most).
+func nodeAt(depth int) hegel.Generator[hjNode] { return nodeLevels[min(depth, 2)] }
+
+var (
+	// rootQuotelessAtoms: pieces of a quoteless root string, which the parser first tries to
+	// read as a braceless object: no quotes, brackets, commas or comment starts, so that the
+	// text before a colon is a key name or has a blank in it, and the text after it a plain
+	// value (rootDenote).
+	rootQuotelessAtoms  = []string{"a", "b", "x", "Z", "0", "1", "9", " ", "-", ".", ":", "\u00e9", "\U0001F600", "true", "null", "0x", "e5", "5 times"}
+	rootQuotelessStarts = []string{"a", "b", "x", "Z", "0", "1", "9", " ", "-", ".", "\u00e9", "\U0001F600", "true", "null", "0x", "e5", "5 times"}
+	rootQuotelessRecs   = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) quotelessRec {
+		return quotelessRec{
+			first: hegel.Draw(tc, hegel.SampledFrom(rootQuotelessStarts)),
+			rest:  hegel.Draw(tc, upTo(hegel.SampledFrom(rootQuotelessAtoms), 3)),
+			trail: hegel.Draw(tc, maybe(30, blanks)),
+		}
+	}), func(q quotelessRec) bool { return quotelessOK(q.text()) })
+	rootQuotelessNodes = hegel.Map(rootQuotelessRecs, func(q quotelessRec) hjNode { return hjNode{kind: 7, ql: q} })
+)
+
+// rootNodes: a braceless object (one to four members), an object, an array, a number, a quoted
+// string, a keyword, and one time in twenty-five a quoteless string.
+var rootNodes = weighted(
+	choice[hjNode]{16, keywordNodes},
+	choice[hjNode]{16, numberNodes},
+	choice[hjNode]{16, quotedNodes},
+	choice[hjNode]{16, objectNodes(nodeAt(2), 1, true)},
+	choice[hjNode]{16, objectNodes(nodeAt(2), 0, false)},
+	choice[hjNode]{16, arrayNodes(nodeAt(2))},
+	choice[hjNode]{4, rootQuotelessNodes},
+)
+
+// docs: a whole document.
+var docs = hegel.Composite(func(tc hegel.TestCase) hjDoc {
+	return hjDoc{lead: hegel.Draw(tc, gaps), root: hegel.Draw(tc, rootNodes), trail: hegel.Draw(tc, hegel.Optional(gaps))}
+})
+
+// ---- the writer
+
+// hjWriter renders a document from its records and builds the value it denotes.
+type hjWriter struct {
+	sb     strings.Builder
+	col    int  // bytes since the last line feed
+	term   bool // the last token needs a terminator (number, keyword: a comma, bracket, comment or line end)
+	toEOL  bool // the last token was a quoteless string: only a line end can follow
+	dupes  bool
+	surrog bool
+
+	afterComment bool // ws() wrote a comment since it was last entered
+	afterNewline bool // ws() wrote a line end since it was last entered
+	// A string with a line feed (written back as a multiline string) followed a comment, or a
+	// line end, between the key's colon (or the array's bracket) and the value.
+	mlAfterComment bool
+	mlAfterNewline bool
+	rootTrail      bool // whitespace or comments follow the root value
+	trailingDot    bool // a number with a trailing decimal point (hjson/11)
+	huge           bool // a number beyond float64 (hjson/12)
+	rootEmpty      bool // a braceless root object whose last member has no value (hjson/20)
+}
+
+// shapes names the recorded bugs whose shape the document has.
+func (w *hjWriter) shapes() []string {
+	var s []string
+	s = append(s, shapeIf(w.surrog, "hjson/1")...)
+	s = append(s, shapeIf(w.trailingDot, "hjson/11")...)
+	s = append(s, shapeIf(w.huge, "hjson/12")...)
+	s = append(s, shapeIf(w.rootEmpty, "hjson/20")...)
+	return s
+}
+
+func (w *hjWriter) write(s string) {
+	w.sb.WriteString(s)
+	if i := strings.LastIndexByte(s, '\n'); i >= 0 {
+		w.col = len(s) - i - 1
+	} else {
+		w.col += len(s)
+	}
+}
+
+func (w *hjWriter) newline(nl string) {
+	w.write(nl)
+	w.term, w.toEOL = false, false
+}
+
+// comment writes a comment; line comments end the line.
+func (w *hjWriter) comment(c commentRec) {
+	switch c.kind {
+	case 0:
+		w.write("#" + c.text)
+		w.newline(c.nl)
+	case 1:
+		w.write("//" + c.text)
+		w.newline(c.nl)
+	default:
+		w.write("/*" + c.text + c.more + "*/")
+	}
+}
+
+// ws writes whitespace and, when allowed, comments between tokens; after a quoteless string it
+// starts with a line end.
+func (w *hjWriter) ws(g gapRec, comments bool) {
+	if w.toEOL {
+		w.newline(g.nl)
+	}
+	for _, it := range g.items {
+		switch it.kind {
+		case 0:
+			w.write(" ")
+		case 1:
+			w.write("\t")
+		case 2:
+			w.newline(it.nl)
+			w.afterNewline = true
+		default:
+			if comments {
+				w.comment(it.comment)
+				w.afterComment = true
+			} else {
+				w.write("  ")
+			}
+		}
+	}
+}
+
+// noteString records a string value written after a comment or a line end (since the key, the
+// separator or the bracket before it: resetFlags) and resets the flags.
+func (w *hjWriter) noteString(s string) string {
+	if strings.Contains(s, "\n") {
+		w.mlAfterComment = w.mlAfterComment || w.afterComment
+		w.mlAfterNewline = w.mlAfterNewline || w.afterNewline
+	}
+	w.resetFlags()
+	return s
+}
+
+func (w *hjWriter) resetFlags() { w.afterComment, w.afterNewline = false, false }
+
+// sep separates two members: a comma, a line end, or both (a comma may sit on the next line).
+func (w *hjWriter) sep(s sepRec) {
+	w.resetFlags()
+	if w.toEOL || !s.comma {
+		w.newline(s.nl)
+		if s.nlComma {
+			w.write(",")
+		}
+	} else {
+		w.write(",")
+	}
+	w.term, w.toEOL = false, false
+	w.ws(s.gap, true)
+}
+
+// closing ends a container: a quoteless string needs a line end first; a trailing comma is
+// allowed after a member.
+func (w *hjWriter) closing(bracket string, c closeRec, members bool) {
+	if w.toEOL {
+		w.newline(c.nl)
+	}
+	if members && c.comma {
+		w.write(",")
+		w.term, w.toEOL = false, false
+	}
+	w.ws(c.gap, true)
+	w.write(bracket)
+	w.term, w.toEOL = false, false
+}
+
+// ---- strings
+
+// quotelessOK: s (already trimmed) is read as a plain quoteless string by readTfnns: it starts
+// with none of the characters a value cannot start with, contains no line end, and at each
+// terminator (and at the end) its prefix is neither a keyword nor a number.
+func quotelessOK(s string) bool {
+	if s == "" || strings.ContainsAny(s, "\n\r") {
+		return false
+	}
+	c := s[0]
+	if strings.IndexByte("{}[],:\"'#", c) >= 0 || strings.HasPrefix(s, "//") || strings.HasPrefix(s, "/*") {
+		return false
+	}
+	numberish := c == '-' || (c >= '0' && c <= '9')
+	check := func(prefix string) bool {
+		t := strings.TrimSpace(prefix)
+		if t == "true" || t == "false" || t == "null" {
+			return false
+		}
+		if numberish && numberSyntax(prefix) {
+			return false
+		}
+		return true
+	}
+	for i := 1; i < len(s); i++ {
+		if s[i] == ',' || s[i] == '}' || s[i] == ']' || s[i] == '#' || (s[i] == '/' && i+1 < len(s) && (s[i+1] == '/' || s[i+1] == '*')) {
+			if !check(s[:i]) {
+				return false
+			}
+		}
+	}
+	return check(s)
+}
+
+// numberSyntax: text is a number followed by whitespace only, by the grammar of
+// tryParseNumber (no magnitude check).
+func numberSyntax(text string) bool {
+	i := 0
+	next := func() byte {
+		if i < len(text) {
+			return text[i]
+		}
+		return 0
+	}
+	leadingZeros, testLeading := 0, true
+	if next() == '-' {
+		i++
+	}
+	for c := next(); c >= '0' && c <= '9'; c = next() {
+		if testLeading {
+			if c == '0' {
+				leadingZeros++
+			} else {
+				testLeading = false
+			}
+		}
+		i++
+	}
+	if testLeading {
+		leadingZeros--
+	}
+	if next() == '.' {
+		i++
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	if c := next(); c == 'e' || c == 'E' {
+		i++
+		if c := next(); c == '-' || c == '+' {
+			i++
+		}
+		if c := next(); c < '0' || c > '9' {
+			return false
+		}
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	for c := next(); c > 0 && c <= ' '; c = next() {
+		i++
+	}
+	return next() == 0 && leadingZeros == 0
+}
+
+// quoteless writes a quoteless string and returns its value.
+func (w *hjWriter) quoteless(q quotelessRec) string {
+	s := q.text()
+	w.write(s)
+	w.write(q.trail) // trailing whitespace is trimmed
+	w.toEOL = true
+	return s
+}
+
+// quoted writes a JSON-style string in double or single quotes with the escapes its forms
+// tape spells and returns its value.
+func (w *hjWriter) quoted(q quotedRec) string {
+	qc := byte('"')
+	if q.single {
+		qc = '\''
+	}
+	var got strings.Builder
+	w.write(string(qc))
+	for i, r := range []rune(q.s) {
+		form := at(q.forms, i)
+		switch {
+		case r == rune(qc) || r == '\\':
+			w.write("\\" + string(r))
+		case r == '\n' || r == '\r' || r == '\t' || r == '\b' || r == '\f':
+			if form == 3 {
+				w.write(fmt.Sprintf("\\u%04x", r))
+			} else {
+				w.write("\\" + string("nrtbf"[strings.IndexRune("\n\r\t\b\f", r)]))
+			}
+		case r < 0x20 || (form == 3 && r <= 0xffff):
+			w.write(fmt.Sprintf("\\u%04X", r))
+		case r > 0xffff && form >= 2:
+			// A surrogate pair, as every JSON encoder writes a character outside the BMP.
+			hi := 0xd800 + ((r - 0x10000) >> 10)
+			lo := 0xdc00 + ((r - 0x10000) & 0x3ff)
+			w.write(fmt.Sprintf("\\u%04x\\u%04x", hi, lo))
+			w.surrog = true
+			if Known.surrogatePairs {
+				got.WriteString(string([]rune{0xfffd, 0xfffd}))
+				continue
+			}
+		case r == '/' && form == 2:
+			w.write("\\/")
+		case (r == '"' || r == '\'') && form == 2:
+			w.write("\\" + string(r))
+		default:
+			w.write(string(r))
+		}
+		got.WriteRune(r)
+	}
+	w.write(string(qc))
+	w.term, w.toEOL = false, false
+	return got.String()
+}
+
+// skipIndent removes up to n leading blanks (space or tab), as the parser does.
+func skipIndent(line string, n int) string {
+	i := 0
+	for i < len(line) && i < n && (line[i] == ' ' || line[i] == '\t') {
+		i++
+	}
+	return line[i:]
+}
+
+// multiline writes a \u201d' string and returns its value.
+func (w *hjWriter) multiline(m mlRec) string {
+	indent := w.col
+	w.write("'''")
+	if m.single {
+		// A single-line multiline string: the blanks after the opening triple-quote are skipped.
+		w.write(m.line + "'''")
+		w.term, w.toEOL = false, false
+		return strings.TrimLeft(m.line, " \t")
+	}
+	var value strings.Builder
+	first := ""
+	if m.hasFirst {
+		first = strings.TrimLeft(m.line, " \t")
+		w.write(first)
+	} else {
+		w.write(m.blank) // blanks before the line end are skipped
+	}
+	value.WriteString(first)
+	w.newline(m.nl)
+	for i, l := range m.lines {
+		ind := l.indent.render(indent)
+		w.write(ind + l.text)
+		w.newline(l.nl)
+		if first != "" || i > 0 {
+			value.WriteString("\n")
+		}
+		value.WriteString(skipIndent(ind+l.text, indent))
+	}
+	// The line feed before the closing triple-quote is dropped; the closing line's blanks (up to the
+	// opening column) are skipped.
+	w.write(strings.Repeat(" ", m.closing%(indent+1)) + "'''")
+	w.term, w.toEOL = false, false
+	return value.String()
+}
+
+// ---- numbers and keywords
+
+// number writes a number and returns its value.
+func (w *hjWriter) number(n numRec) interface{} {
+	w.write(n.text)
+	w.term, w.toEOL = true, false
+	w.trailingDot = w.trailingDot || n.trailingDot
+	w.huge = w.huge || n.huge
+	return n.value()
+}
+
+func (w *hjWriter) keyword(kw int) interface{} {
+	w.write([]string{"true", "false", "null"}[kw])
+	w.term, w.toEOL = true, false
+	return []interface{}{true, false, nil}[kw]
+}
+
+// ---- keys
+
+// key writes an object key and returns it.
+func (w *hjWriter) key(k keyRec) string {
+	w.resetFlags()
+	if k.quoted {
+		return w.quoted(k.q)
+	}
+	w.write(k.plain)
+	w.term, w.toEOL = false, false
+	return k.plain
+}
+
+// ---- values
+
+func (w *hjWriter) value(n hjNode) interface{} {
+	switch n.kind {
+	case 0:
+		return w.keyword(n.kw)
+	case 1:
+		return w.number(n.num)
+	case 2:
+		return w.quoteless(n.ql)
+	case 3:
+		return w.noteString(w.quoted(n.qt))
+	case 4:
+		return w.noteString(w.multiline(n.ml))
+	case 5:
+		return w.array(n)
+	case 6:
+		return w.object(n)
+	}
+	return w.rootQuoteless(n.ql)
+}
+
+func (w *hjWriter) array(n hjNode) []interface{} {
+	w.write("[")
+	w.term, w.toEOL = false, false
+	w.resetFlags()
+	out := []interface{}{}
+	w.ws(n.open, true)
+	for i, e := range n.elems {
+		if i > 0 {
+			w.sep(e.sep)
+		}
+		out = append(out, w.value(e.val))
+	}
+	w.closing("]", n.close, len(n.elems) > 0)
+	return out
+}
+
+// object writes an object (with braces, or the braceless root) and returns it as an
+// OrderedMap in first-occurrence key order with the last value of a duplicated key.
+func (w *hjWriter) object(n hjNode) *hjson.OrderedMap {
+	om := hjson.NewOrderedMap()
+	if !n.braceless {
+		w.write("{")
+		w.term, w.toEOL = false, false
+		w.ws(n.open, true)
+	}
+	for i, m := range n.members {
+		if i > 0 {
+			w.sep(m.sep)
+		}
+		k := w.key(m.key)
+		if _, exists := om.Map[k]; exists {
+			w.dupes = true
+		}
+		w.ws(m.preColon, m.key.quoted) // comments between a quoteless key and its colon are not allowed
+		w.write(":")
+		w.term, w.toEOL = false, false
+		w.ws(m.postColon, true)
+		om.Set(k, w.value(m.val))
+	}
+	if !n.braceless {
+		w.closing("}", n.close, len(n.members) > 0)
+	}
+	return om
+}
+
+// rootQuoteless writes a quoteless string as the whole root and returns what the document
+// denotes (rootDenote).
+func (w *hjWriter) rootQuoteless(q quotelessRec) interface{} {
+	s := w.quoteless(q)
+	v, n := rootDenote(s)
+	w.trailingDot = w.trailingDot || n.trailingDot
+	w.huge = w.huge || n.huge
+	if _, empty := v.(rootEmptyValue); empty {
+		w.rootEmpty = true
+	}
+	return v
+}
+
+// rootDenote is the value of a document that is the quoteless string s (quotelessOK; no
+// quotes, brackets, commas or comment starts in it): the root is first read as a braceless
+// object, so a key name (no blank or punctuator) followed by a colon makes it the object of
+// that one member, whose value is the rest of the line read as a quoteless value (a number, a
+// keyword or a trimmed string); with nothing after the colon the member has no value
+// (rootEmptyValue, hjson/20). Anything else (no colon, or a blank before it) fails as an
+// object and is the single string.
+func rootDenote(s string) (interface{}, numRec) {
+	m := reRootColon.FindStringIndex(s)
+	if m == nil {
+		return s, numRec{}
+	}
+	key := strings.TrimRight(s[:m[1]-1], " ")
+	rest := strings.TrimLeft(s[m[1]:], " \t")
+	if rest == "" {
+		return rootEmptyValue{s}, numRec{}
+	}
+	om := hjson.NewOrderedMap()
+	t := strings.TrimSpace(rest)
+	switch {
+	case t == "true":
+		om.Set(key, true)
+	case t == "false":
+		om.Set(key, false)
+	case t == "null":
+		om.Set(key, nil)
+	case (rest[0] == '-' || rest[0] >= '0' && rest[0] <= '9') && numberSyntax(rest):
+		n := numRecOf(t)
+		om.Set(key, n.value())
+		return om, n
+	default:
+		om.Set(key, t)
+	}
+	return om, numRec{}
+}
+
+// document writes a whole document and returns its value.
+func (w *hjWriter) document(d hjDoc) interface{} {
+	w.resetFlags()
+	w.ws(d.lead, true)
+	v := w.value(d.root)
+	if d.trail != nil {
+		before := w.sb.Len()
+		w.ws(*d.trail, true)
+		w.rootTrail = w.sb.Len() > before
+	}
+	return v
+}
+
+// checkNoNUL: the document holds no NUL character, so whatever the parser makes of it (an
+// error, or the single quoteless string the root falls back to), no decoded string contains
+// one (hjson/20 reads the missing value as the string NUL).
+func checkNoNUL(c *collector, ht *hegel.T, text string, shape []string) {
+	var v interface{}
+	if err := hjson.Unmarshal([]byte(text), &v); err == nil && containsNUL(v) {
+		c.mismatch(ht, "interface", shape, "Unmarshal(%q) = %s: a NUL character the document does not contain", text, canon(v))
+		return
+	}
+	var node hjson.Node
+	if err := hjson.Unmarshal([]byte(text), &node); err == nil && containsNUL(&node) {
+		c.mismatch(ht, "node", shape, "Unmarshal(%q) into a Node = %s: a NUL character the document does not contain", text, canon(&node))
+	}
+}
+
+// TestHegelParse: a generated Hjson document decodes (into interface{} and into a Node) to the
+// value the Hjson syntax gives it. A number beyond float64 is an error into interface{} (as
+// encoding/json refuses it) and must be the same in a Node (hjson/12); a number with a trailing
+// decimal point is a number or a string in both, never an internal error (hjson/11); a
+// braceless root whose last member has no value is an error or the single string (hjson/20).
+func TestHegelParse(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, docs)
+		w := &hjWriter{}
+		want := w.document(d)
+		text := w.sb.String()
+		shape := w.shapes()
+		if w.dupes {
+			c.count("duplicate keys")
+		}
+		if w.surrog {
+			c.count("surrogate pairs")
+		}
+		if re, ok := want.(rootEmptyValue); ok {
+			c.count("root member without a value")
+			checkNoNUL(c, ht, text, shape)
+			var hv interface{}
+			if err := hjson.Unmarshal([]byte(text), &hv); err == nil && canon(hv) != canon(re.s) {
+				c.mismatch(ht, "empty value", shape, "Unmarshal(%q) = %s; the last member has no value, so the document is an error or the string %q", text, canon(hv), re.s)
+			}
+			return
+		}
+		wantCanon := canon(want)
+
+		var hv interface{}
+		if err := hjson.Unmarshal([]byte(text), &hv); err != nil {
+			switch {
+			case w.huge:
+				c.count("number beyond float64 rejected into interface{}")
+			case w.trailingDot && Known.trailingDotInternal:
+				c.count("trailing decimal point: Internal error as recorded")
+			default:
+				c.mismatch(ht, "error", shape, "Unmarshal: %v\n%q", err, show(text))
+				return
+			}
+		} else if got := canon(hv); got != wantCanon {
+			c.mismatch(ht, "value", shape, "Unmarshal %q\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+			return
+		}
+
+		wantOrdered := ordered(want)
+		var node hjson.Node
+		if err := hjson.Unmarshal([]byte(text), &node); err != nil {
+			if w.huge {
+				c.count("number beyond float64 rejected into Node")
+			} else {
+				c.mismatch(ht, "node error", shape, "into Node: %v\n%q", err, show(text))
+			}
+		} else if got := ordered(&node); got != wantOrdered {
+			c.mismatch(ht, "node", shape, "into Node %q\n  got  %s\n  want %s", show(text), show(got), show(wantOrdered))
+		}
+	})
+}
+
+// emptyLastDoc is a braceless root object whose last member has nothing after its colon but
+// blanks and comments up to the end of the input (the shape of hjson/20): earlier members with
+// values, the last key, blanks, the colon and the tail.
+type emptyLastDoc struct {
+	members []string
+	key     string
+	blank   string
+	tail    string
+}
+
+func (d emptyLastDoc) text() string {
+	return strings.Join(d.members, "") + d.key + d.blank + ":" + d.tail
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (d emptyLastDoc) GoString() string { return fmt.Sprintf("document %q", d.text()) }
+
+var (
+	valuedMembers = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, hegel.SampledFrom([]string{"b", "key", "x-y", "1"})) + hegel.Draw(tc, hegel.SampledFrom([]string{":", ": "})) +
+			hegel.Draw(tc, hegel.SampledFrom([]string{"1", "x", "true", "\"q\"", "[]"})) + hegel.Draw(tc, hegel.SampledFrom([]string{"\n", ",", ",\n", "\n\n"}))
+	})
+	// emptyTails: nothing after the colon but blanks and comments; valuedTails (the
+	// neighbouring region, under HEGEL_NO_KNOWN=1): a value, then the same.
+	emptyTails  = hegel.SampledFrom([]string{"", " ", "\n", "\n\n", "\t", " # c", " // c", " /* c */", "\n# c\n", " /* c */ /* d */"})
+	valuedTails = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, hegel.SampledFrom([]string{" 1", " x", " true", " \"q\"", " []", "\n1", " /* c */ 1"})) + hegel.Draw(tc, emptyTails)
+	})
+	emptyLastDocs = hegel.Composite(func(tc hegel.TestCase) emptyLastDoc {
+		return emptyLastDoc{
+			members: hegel.Draw(tc, upTo(valuedMembers, 2)),
+			key:     hegel.Draw(tc, hegel.SampledFrom([]string{"a", "key", "true", "1", "a/b", "'a'", "\"k e y\""})),
+			blank:   hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", "  "})),
+			tail:    hegel.Draw(tc, shaped[hegel.Generator[string]](emptyTails, valuedTails)),
+		}
+	})
+)
+
+// TestHegelEmptyLastValue: a braceless root object whose last member has nothing after its
+// colon but blanks and comments up to the end of the input (the shape of hjson/20). The
+// document holds no NUL character, so whatever the parser makes of it (an error, or the single
+// quoteless string the root falls back to), no decoded string contains one. Under
+// HEGEL_NO_KNOWN=1 the last member has a value.
+func TestHegelEmptyLastValue(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, emptyLastDocs)
+		checkNoNUL(c, ht, d.text(), known("hjson/20"))
+	})
+}
+
+// containsNUL reports whether a decoded tree holds a string with a NUL character.
+func containsNUL(v interface{}) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.ContainsRune(x, 0)
+	case []interface{}:
+		for _, e := range x {
+			if containsNUL(e) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for k, e := range x {
+			if strings.ContainsRune(k, 0) || containsNUL(e) {
+				return true
+			}
+		}
+	case *hjson.OrderedMap:
+		for _, k := range x.Keys {
+			if strings.ContainsRune(k, 0) || containsNUL(x.Map[k]) {
+				return true
+			}
+		}
+	case *hjson.Node:
+		return containsNUL(x.Value)
+	case hjson.Node:
+		return containsNUL(x.Value)
+	}
+	return false
+}
