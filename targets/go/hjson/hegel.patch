@@ -0,0 +1,141 @@
+package hegel
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- comment round trips
+//
+// README: "The only way to read comments from Hjson input is to use a destination variable of
+// type hjson.Node ... An Hjson document can be read and written without altering the layout."
+// A hand-written document (the grammar model's, comments of the three kinds in every position
+// the syntax allows, optional commas, braceless root, quoteless keys and strings, multiline
+// strings) read into a Node and written again must keep its value; and the written text, read
+// and written once more, must not change again.
+
+var reTrailingBlanks = regexp.MustCompile(`[ \t]+(\n|$)`)
+
+// plain converts the grammar model's value (OrderedMaps) to JSON-shaped maps.
+func plain(v interface{}) interface{} {
+	switch x := v.(type) {
+	case *hjson.OrderedMap:
+		m := make(map[string]interface{}, len(x.Keys))
+		for _, k := range x.Keys {
+			m[k] = plain(x.Map[k])
+		}
+		return m
+	case []interface{}:
+		out := make([]interface{}, len(x))
+		for i, e := range x {
+			out[i] = plain(e)
+		}
+		return out
+	}
+	return v
+}
+
+// TestHegelCommentRoundTrip: a generated Hjson document with comments, read into a Node and
+// encoded with its comments, denotes the same value; the encoded text is a fixed point.
+func TestHegelCommentRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		w := &hjWriter{tc: ht}
+		want := w.document()
+		text := w.sb.String()
+		opts := hjson.DefaultOptions()
+		_, isObj := plain(want).(map[string]interface{})
+		_, isArr := want.([]interface{})
+		isScalar := !isObj && !isArr
+		expected, ok, changed := expectedDecode(plain(want), opts, isScalar)
+		if !ok {
+			c.count("skipped: string not preserved")
+			return
+		}
+		if changed {
+			c.count("string changed as recorded")
+		}
+		wantCanon := canon(expected)
+		// A string followed by a comment on its line is quoted whatever the options
+		// (quoteForComment), so the quoted outcome is acceptable too.
+		optsQ := opts
+		optsQ.QuoteAlways = true
+		expectedQ, okQ, _ := expectedDecode(plain(want), optsQ, isScalar)
+		wantCanonQ := ""
+		if okQ {
+			wantCanonQ = canon(expectedQ)
+		}
+
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = chance(ht, 60)
+		if !dopts.WhitespaceAsComments {
+			c.count("comments only")
+		}
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions([]byte(text), &node, dopts); err != nil {
+			c.failClass(ht, "reject", "into Node: %v\n%q", err, show(text))
+			return
+		}
+		if Known.mlAfterKeyComment && (w.mlAfterComment || (w.mlAfterNewline && dopts.WhitespaceAsComments)) {
+			c.count("skipped: multiline string after a key comment")
+			return
+		}
+		b, err := hjson.MarshalWithOptions(node, opts)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(node): %v\n%q", err, show(text))
+			return
+		}
+		text2 := string(b)
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			if !okQ {
+				c.count("skipped: quoted-for-comment string not preserved")
+				return
+			}
+			c.failClass(ht, "reject2", "the re-encoded text does not parse: %v\n%q\n  from %q", err, show(text2), show(text))
+			return
+		}
+		if got := canon(back); got != wantCanon {
+			if okQ && got == wantCanonQ {
+				c.count("string quoted for a comment")
+				changed = changed || wantCanonQ != canon(plain(want))
+			} else {
+				c.failClass(ht, "value", "value changed by the Node round trip\n  from %q\n  to   %q\n  got  %s\n  want %s", show(text), show(text2), show(got), show(wantCanon))
+				return
+			}
+		}
+		if strings.ContainsAny(text, "\r") || strings.Contains(text, "'''") {
+			c.count("fixed point skipped: CR or multiline string")
+			return
+		}
+		if changed {
+			// A string the encoder writes in a form that reads back differently (bugs 4-6, 9)
+			// changes the text again at the next round.
+			c.count("fixed point skipped: string changed as recorded")
+			return
+		}
+		if Known.rootAfterDoubled && isScalar && w.rootTrail {
+			c.count("fixed point skipped: root scalar with a trailing comment")
+			return
+		}
+		var node2 hjson.Node
+		if err := hjson.UnmarshalWithOptions(b, &node2, dopts); err != nil {
+			c.failClass(ht, "reject3", "re-encoded text into Node: %v\n%q", err, show(text2))
+			return
+		}
+		b3, err := hjson.MarshalWithOptions(node2, opts)
+		if err != nil {
+			c.failClass(ht, "marshal3", "Marshal(node2): %v\n%q", err, show(text2))
+			return
+		}
+		// Trailing blanks on a line are kept as a comment once and absorbed by a quoteless
+		// string (and trimmed) the next time; they do not count.
+		if text3 := reTrailingBlanks.ReplaceAllString(string(b3), "$1"); text3 != reTrailingBlanks.ReplaceAllString(text2, "$1") {
+			c.failClass(ht, "fixed point", "the re-encoded text changes again\n  from %q\n  once %q\n  twice %q", show(text), show(text2), show(text3))
+		}
+	})
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..deda752
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,201 @@
+package hegel
+
+import (
+	"encoding/json"
+	"math"
+	"sort"
+	"strings"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+// Building blocks of generated strings: everything the Hjson quoting rules look at (quotes,
+// backslashes, comment starters, punctuators, control and format characters, keyword and
+// number spellings, leading and trailing whitespace).
+var stringAtoms = []string{
+	"a", "b", "x", "Z", "0", "1", "9", " ", "  ", "-", ".", "e", "E", "+", "_",
+	"'", "''", "'''", "\"", "\\", "#", "/", "//", "/*", "*/", ",", ":", "{", "}", "[", "]",
+	"\n", "\t", "\r", "\x00", "\x1f", "\x7f", "\u00ad", "\u2028", "\ufeff", "\uffff", "\u200c",
+	"\u00e9", "\U0001F600", "\u00a0",
+	"true", "false", "null", "1.", "1e5", "-1e-5", "1e400", "0x10", "01", "1,2", "5 times", "Infinity", "NaN",
+	"true ", "true,", "true # c", "1 # c", "1 // c", "1 /* c */", "a # c", "a // c",
+}
+
+func genString(tc hegel.TestCase) string {
+	n := drawInt(tc, 0, 5)
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		sb.WriteString(pick(tc, stringAtoms))
+	}
+	return sb.String()
+}
+
+// genKey draws an object key: words, and the same tricky atoms as values.
+func genKey(tc hegel.TestCase) string {
+	if chance(tc, 60) {
+		return pick(tc, []string{"a", "b", "c", "key", "Key", "KEY", "k1", "x-y", "x.y", "_", "-", "1", "true"})
+	}
+	return genString(tc)
+}
+
+var floatPool = []float64{0, 1, -1, 0.5, 0.1, 1e21, 1e20, 1e-7, 123456789012345678, 5e-324, 1.7976931348623157e308, 100000, 3.25, -2.5e-3, 42}
+
+func genNumber(tc hegel.TestCase) float64 {
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		return float64(drawInt(tc, -1000, 1000))
+	case 1:
+		return pick(tc, floatPool)
+	case 2:
+		return math.Copysign(0, -1)
+	default:
+		return float64(drawInt(tc, -1000000, 1000000)) / 1000
+	}
+}
+
+// genValue draws a JSON-shaped value tree: nil, bool, float64, string, []interface{} and
+// map[string]interface{}; the JSON canonical form of the decoded text.
+func genValue(tc hegel.TestCase, depth int) interface{} {
+	top := 6
+	if depth <= 0 {
+		top = 3
+	}
+	switch drawInt(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2:
+		return genNumber(tc)
+	case 3:
+		return genString(tc)
+	case 4, 5:
+		n := drawInt(tc, 0, 4)
+		arr := make([]interface{}, 0, n)
+		for i := 0; i < n; i++ {
+			arr = append(arr, genValue(tc, depth-1))
+		}
+		return arr
+	default:
+		n := drawInt(tc, 0, 4)
+		m := map[string]interface{}{}
+		for i := 0; i < n; i++ {
+			m[genKey(tc)] = genValue(tc, depth-1)
+		}
+		return m
+	}
+}
+
+// genEncoderOptions draws hjson.EncoderOptions; whitespace-only indentation.
+func genEncoderOptions(tc hegel.TestCase) hjson.EncoderOptions {
+	o := hjson.DefaultOptions()
+	if chance(tc, 50) {
+		return o
+	}
+	o.Eol = pick(tc, []string{"\n", "\r\n"})
+	o.BracesSameLine = chance(tc, 50)
+	o.EmitRootBraces = chance(tc, 60)
+	o.QuoteAlways = chance(tc, 25)
+	o.QuoteAmbiguousStrings = chance(tc, 80)
+	o.IndentBy = pick(tc, []string{"  ", "\t", "    ", " ", ""})
+	o.BaseIndentation = pick(tc, []string{"", "  ", "\t", "    "})
+	o.Comments = chance(tc, 80)
+	return o
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// canon renders a decoded value tree in a canonical form for comparison: numbers by their
+// shortest float64 spelling (-0 as 0), objects with sorted keys, json.Number by its text as a
+// float64 (so both decoders' number types compare equal).
+func canon(v interface{}) string {
+	var sb strings.Builder
+	canonInto(&sb, v)
+	return sb.String()
+}
+
+func canonInto(sb *strings.Builder, v interface{}) {
+	switch x := v.(type) {
+	case nil:
+		sb.WriteString("null")
+	case bool:
+		if x {
+			sb.WriteString("true")
+		} else {
+			sb.WriteString("false")
+		}
+	case float64:
+		if x == 0 {
+			x = 0
+		}
+		b, _ := json.Marshal(x)
+		sb.Write(b)
+	case json.Number:
+		f, err := x.Float64()
+		if err != nil {
+			sb.WriteString("number(" + string(x) + ")")
+		} else {
+			canonInto(sb, f)
+		}
+	case string:
+		b, _ := json.Marshal(x)
+		sb.Write(b)
+	case []interface{}:
+		sb.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonInto(sb, e)
+		}
+		sb.WriteByte(']')
+	case map[string]interface{}:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		sb.WriteByte('{')
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			b, _ := json.Marshal(k)
+			sb.Write(b)
+			sb.WriteByte(':')
+			canonInto(sb, x[k])
+		}
+		sb.WriteByte('}')
+	case *hjson.OrderedMap:
+		// Compared as an unordered object; the key order is checked separately.
+		m := map[string]interface{}{}
+		for _, k := range x.Keys {
+			m[k] = x.Map[k]
+		}
+		canonInto(sb, m)
+	case *hjson.Node:
+		canonInto(sb, x.Value)
+	case hjson.Node:
+		canonInto(sb, x.Value)
+	default:
+		sb.WriteString("?" + string(mustJSON(v)))
+	}
+}
+
+func mustJSON(v interface{}) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return []byte(err.Error())
+	}
+	return b
+}
+
+func show(s string) string {
+	if len(s) > 400 {
+		s = s[:400] + "..."
+	}
+	return s
+}
diff --git a/hegel/hegel_hints_test.go b/hegel/hegel_hints_test.go
new file mode 100644
index 0000000..625a307
--- /dev/null
+++ b/hegel/hegel_hints_test.go
@@ -0,0 +1,622 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- typed destinations
+//
+// Hjson's quoteless values are typed by their destination: "A string destination will receive
+// a string even if the quoteless string also was a valid number, boolean or null" (README);
+// otherwise a quoteless number, true, false or null is that value. Destinations that implement
+// encoding.TextUnmarshaler count as strings; a type implementing ElemTyper types all of its
+// elements; the rest is encoding/json ("the same rules apply"). The model here reads a
+// generated document into the JSON text encoding/json would need to give the same result: each
+// quoteless token becomes a JSON string when its destination is string-typed, and the raw
+// token otherwise.
+
+// textVal is a TextUnmarshaler with a pointer receiver (like time.Time, net.IP, big.Int).
+type textVal struct{ S string }
+
+func (t *textVal) UnmarshalText(b []byte) error { t.S = "T:" + string(b); return nil }
+
+type hintedInner struct {
+	S   string
+	I   int
+	T   textVal
+	Any interface{}
+}
+
+type hintedEmb struct {
+	Emb  string
+	EmbN float64
+}
+
+// elemStrs types its elements as strings (value receiver).
+type elemStrs []interface{}
+
+func (elemStrs) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+// elemMap types its values as strings (pointer receiver, callable on nil).
+type elemMap map[string]interface{}
+
+func (*elemMap) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+// elemStruct types all of its fields' values as strings.
+type elemStruct struct {
+	A interface{}
+	B interface{}
+}
+
+func (elemStruct) ElemType() reflect.Type { return reflect.TypeOf("") }
+
+type hinted struct {
+	S   string
+	PS  *string
+	I   int
+	F   float64
+	B   bool
+	N   json.Number
+	Any interface{}
+	SS  []string
+	SA  []interface{}
+	AS  [2]string
+	MS  map[string]string
+	MA  map[string]interface{}
+	T   textVal
+	PT  *textVal
+	TS  []textVal
+	TM  map[string]textVal
+	Sub *hintedInner
+	In  hintedInner
+	hintedEmb
+	Rn   string `json:"renamed"`
+	Skip string `json:"-"`
+	ES   elemStrs
+	EM   elemMap
+	EST  elemStruct
+	AB   int
+	Ab   string
+}
+
+// prefill holds the drawn initial state of a destination, so that both decoders start from
+// equal values (json.Decoder merges into pre-filled destinations).
+type prefill struct {
+	s, ps, rn string
+	hasPS     bool
+	i         int
+	any       int // 0 nil, 1 string, 2 number, 3 map, 4 array
+	sub       bool
+	subAny    int
+	ss        []string
+	ms        map[string]string
+	ma        int
+}
+
+func genPrefill(tc hegel.TestCase) prefill {
+	p := prefill{
+		s:      pick(tc, []string{"", "old", "1"}),
+		i:      drawInt(tc, -3, 3),
+		any:    drawInt(tc, 0, 4),
+		sub:    chance(tc, 50),
+		subAny: drawInt(tc, 0, 2),
+		rn:     pick(tc, []string{"", "r"}),
+		ma:     drawInt(tc, 0, 2),
+	}
+	if chance(tc, 40) {
+		p.hasPS, p.ps = true, pick(tc, []string{"", "p", "7"})
+	}
+	if chance(tc, 30) {
+		p.ss = []string{"x", "y"}
+	}
+	if chance(tc, 30) {
+		p.ms = map[string]string{"k": "v"}
+	}
+	return p
+}
+
+func anyValue(kind int) interface{} {
+	switch kind {
+	case 1:
+		return "old"
+	case 2:
+		return 1.5
+	case 3:
+		return map[string]interface{}{"T": "s", "k": 2.0}
+	case 4:
+		return []interface{}{"a", 1.0}
+	}
+	return nil
+}
+
+func (p prefill) build() *hinted {
+	h := &hinted{S: p.s, I: p.i, Any: anyValue(p.any), Rn: p.rn, Skip: "kept"}
+	if p.hasPS {
+		s := p.ps
+		h.PS = &s
+	}
+	if p.sub {
+		h.Sub = &hintedInner{S: "s", Any: anyValue(p.subAny)}
+	}
+	if p.ss != nil {
+		h.SS = append([]string{}, p.ss...)
+	}
+	if p.ms != nil {
+		h.MS = map[string]string{}
+		for k, v := range p.ms {
+			h.MS[k] = v
+		}
+	}
+	switch p.ma {
+	case 1:
+		h.MA = map[string]interface{}{}
+	case 2:
+		h.MA = map[string]interface{}{"a": "b"}
+	}
+	return h
+}
+
+// ---- the model of the destination type at a position
+
+var textUnmarshalerT = reflect.TypeOf((*interface{ UnmarshalText([]byte) error })(nil)).Elem()
+var elemTyperT = reflect.TypeOf((*hjson.ElemTyper)(nil)).Elem()
+
+// hint is a destination: the value being decoded into (invalid when the parser tracks none)
+// and its static type (nil when unknown).
+type hint struct {
+	dest reflect.Value
+	t    reflect.Type
+	fold bool // match keys as encoding/json does whatever Known.foldKeys says (the shape a value must have)
+}
+
+// unravel follows the destination through non-nil pointers and interfaces, then the type
+// through pointers.
+func (h hint) unravel() (reflect.Value, reflect.Type) {
+	d, t := h.dest, h.t
+	if d.IsValid() {
+		for (d.Kind() == reflect.Ptr || d.Kind() == reflect.Interface) && !d.IsNil() {
+			d = d.Elem()
+		}
+		if d.IsValid() {
+			t = d.Type()
+		}
+	}
+	for t != nil && t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	return d, t
+}
+
+// isString: a quoteless value here is a string whatever it spells.
+func (h hint) isString() bool {
+	_, t := h.unravel()
+	if t == nil {
+		return false
+	}
+	if t.Kind() == reflect.String || (h.t != nil && h.t.Implements(textUnmarshalerT)) {
+		return true
+	}
+	if Known.textElemHint {
+		// The parser only asks the destination's address, which exists for struct fields it
+		// tracks, not for slice elements, map values or fields behind a nil pointer.
+		return h.dest.IsValid() && h.dest.CanAddr() && reflect.PtrTo(h.dest.Type()).Implements(textUnmarshalerT)
+	}
+	return reflect.PtrTo(t).Implements(textUnmarshalerT)
+}
+
+// nullIsNil: a quoteless null is nil (not the string "null") for a pointer destination.
+func (h hint) nullIsNil() bool { return h.t != nil && h.t.Kind() == reflect.Ptr }
+
+// elemType is the ElemTyper's element type, if the destination type (or a pointer to it)
+// implements it.
+func (h hint) elemType() reflect.Type {
+	t := h.t
+	if t == nil {
+		return nil
+	}
+	if t.Implements(elemTyperT) {
+		v := reflect.Zero(t)
+		if t.Kind() == reflect.Ptr {
+			v = reflect.New(t.Elem())
+		}
+		return v.Interface().(hjson.ElemTyper).ElemType()
+	}
+	if pt := reflect.PtrTo(t); pt.Implements(elemTyperT) {
+		return reflect.Zero(pt).Interface().(hjson.ElemTyper).ElemType()
+	}
+	return nil
+}
+
+// elem is the destination of an array element.
+func (h hint) elem() hint {
+	if et := h.elemType(); et != nil {
+		return hint{t: et, fold: h.fold}
+	}
+	_, t := h.unravel()
+	if t != nil && (t.Kind() == reflect.Slice || t.Kind() == reflect.Array) {
+		return hint{t: t.Elem(), fold: h.fold}
+	}
+	return hint{fold: h.fold}
+}
+
+type fieldInfo struct {
+	name  string
+	index []int
+	typ   reflect.Type
+}
+
+// structFields lists a struct type's encoded fields as encoding/json sees them (exported,
+// json tag names, "-" skipped, embedded structs flattened; unique names here), sorted by name.
+func structFields(t reflect.Type) []fieldInfo {
+	var out []fieldInfo
+	var walk func(t reflect.Type, prefix []int)
+	walk = func(t reflect.Type, prefix []int) {
+		for i := 0; i < t.NumField(); i++ {
+			sf := t.Field(i)
+			idx := append(append([]int{}, prefix...), i)
+			if sf.Anonymous && sf.Type.Kind() == reflect.Struct && sf.Tag.Get("json") == "" {
+				walk(sf.Type, idx)
+				continue
+			}
+			if sf.PkgPath != "" {
+				continue
+			}
+			tag := sf.Tag.Get("json")
+			if tag == "-" {
+				continue
+			}
+			name := sf.Name
+			if n := strings.Split(tag, ",")[0]; n != "" {
+				name = n
+			}
+			out = append(out, fieldInfo{name: name, index: idx, typ: sf.Type})
+		}
+	}
+	walk(t, nil)
+	sort.SliceStable(out, func(i, j int) bool { return out[i].name < out[j].name })
+	return out
+}
+
+// fieldFor finds the field a key selects: an exact name, else the first field whose name
+// matches case-insensitively (encoding/json folds with unicode.SimpleFold; the parser's hint
+// lookup lowercases with strings.ToLower, which misses the long s).
+func fieldFor(t reflect.Type, key string, fold bool) (fieldInfo, bool) {
+	fields := structFields(t)
+	for _, f := range fields {
+		if f.name == key {
+			return f, true
+		}
+	}
+	for _, f := range fields {
+		if Known.foldKeys && !fold {
+			if strings.ToLower(f.name) == strings.ToLower(key) {
+				return f, true
+			}
+		} else if strings.EqualFold(f.name, key) {
+			return f, true
+		}
+	}
+	return fieldInfo{}, false
+}
+
+// child is the destination of an object member.
+func (h hint) child(key string) hint {
+	if et := h.elemType(); et != nil {
+		return hint{t: et, fold: h.fold}
+	}
+	d, t := h.unravel()
+	if t == nil {
+		return hint{fold: h.fold}
+	}
+	switch t.Kind() {
+	case reflect.Map:
+		return hint{t: t.Elem(), fold: h.fold}
+	case reflect.Struct:
+		f, ok := fieldFor(t, key, h.fold)
+		if !ok {
+			return hint{fold: h.fold}
+		}
+		var fd reflect.Value
+		if d.IsValid() && d.Kind() == reflect.Struct {
+			fd = d.FieldByIndex(f.index)
+		}
+		return hint{dest: fd, t: f.typ, fold: h.fold}
+	}
+	return hint{fold: h.fold}
+}
+
+// ---- the document writer
+
+// Quoteless tokens: numbers, keywords, near misses and plain words; none contains a
+// terminator (comma, bracket, comment start) so each runs to its line end.
+var hintTokens = []string{
+	"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "100000000000000000000",
+	"true", "false", "null", "True", "NULL", "tru", "nul",
+	".5", "01", "+1", "0x10", "1 2", "12abc", "-", "abc", "a b", "x", "e5", "true 1", "null ",
+	"123 ", "\t7", "1.5.2", "1e", "-e3",
+}
+
+var hintKeys = []string{"a", "b", "k", "key", "1", "x-y", "Zed", "unknown", "T", "S", "s", "Any", "ANY"}
+
+type hintWriter struct {
+	hj    *hjWriter
+	tc    hegel.TestCase
+	depth int
+}
+
+func (w *hintWriter) line(indent int) {
+	w.hj.write("\n" + strings.Repeat(" ", indent))
+}
+
+// jsonString is the JSON text of s.
+func jsonString(s string) string { return string(mustJSON(s)) }
+
+// token writes the quoteless token tok and returns the JSON text of what the parser makes of
+// it for the destination h (leading whitespace belongs to the separator, trailing whitespace
+// is trimmed).
+func (w *hintWriter) token(h hint, tok string) string {
+	w.hj.write(tok)
+	tok = strings.TrimLeft(tok, " \t")
+	trimmed := strings.TrimSpace(tok)
+	if trimmed == "null" && h.nullIsNil() {
+		return "null"
+	}
+	if h.isString() {
+		return jsonString(trimmed)
+	}
+	if trimmed == "true" || trimmed == "false" || trimmed == "null" {
+		return trimmed
+	}
+	if c := tok[0]; (c == '-' || c >= '0' && c <= '9') && numberSyntax(tok) {
+		return trimmed
+	}
+	return jsonString(trimmed)
+}
+
+var intTokens = []string{"123", "-5", "0", "-0", "7 ", "null"}
+var numTokens = []string{"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "null"}
+var jsonNumberTokens = []string{"123", "-5", "0", "-0", "1.5", "1e3", "1E+2", "0.25", "7 "}
+var boolTokens = []string{"true", "false", "null", "true "}
+var jsonNumberT = reflect.TypeOf(json.Number(""))
+
+// fitting writes a value of the kind the destination shape expects (most of the time), so
+// that most documents decode without error; it reports whether it did. h is the parser's view
+// of the destination (its hint), shape encoding/json's.
+func (w *hintWriter) fitting(h, shape hint, indent int) (string, bool) {
+	if !chance(w.tc, 96) {
+		return "", false
+	}
+	_, t := shape.unravel()
+	if t == nil {
+		return "", false
+	}
+	switch t.Kind() {
+	case reflect.String:
+		if t == jsonNumberT {
+			return w.token(h, pick(w.tc, jsonNumberTokens)), true
+		}
+		switch drawInt(w.tc, 0, 9) {
+		case 0, 1:
+			return jsonString(w.hj.quoted(genString(w.tc), chance(w.tc, 30))), true
+		case 2:
+			return jsonString(w.hj.multiline()), true
+		}
+		return w.token(h, pick(w.tc, hintTokens)), true
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return w.token(h, pick(w.tc, intTokens)), true
+	case reflect.Float32, reflect.Float64:
+		return w.token(h, pick(w.tc, numTokens)), true
+	case reflect.Bool:
+		return w.token(h, pick(w.tc, boolTokens)), true
+	case reflect.Slice, reflect.Array:
+		return w.array(h, shape, indent), true
+	case reflect.Map, reflect.Struct:
+		if reflect.PtrTo(t).Implements(textUnmarshalerT) {
+			return w.token(h, pick(w.tc, hintTokens)), true
+		}
+		return w.object(h, shape, indent), true
+	}
+	return "", false
+}
+
+func (w *hintWriter) array(h, shape hint, indent int) string {
+	if w.depth <= 0 {
+		w.hj.write("[]")
+		return "[]"
+	}
+	w.depth--
+	defer func() { w.depth++ }()
+	w.hj.write("[")
+	n := drawInt(w.tc, 0, 3)
+	var parts []string
+	for i := 0; i < n; i++ {
+		w.line(indent + 2)
+		parts = append(parts, w.value(h.elem(), shape.elem(), indent+2))
+	}
+	w.line(indent)
+	w.hj.write("]")
+	return "[" + strings.Join(parts, ",") + "]"
+}
+
+func (w *hintWriter) object(h, shape hint, indent int) string {
+	if w.depth <= 0 {
+		w.hj.write("{}")
+		return "{}"
+	}
+	w.depth--
+	defer func() { w.depth++ }()
+	w.hj.write("{")
+	s := w.members(h, shape, indent+2, drawInt(w.tc, 0, 4))
+	w.line(indent)
+	w.hj.write("}")
+	return s
+}
+
+// keyFor draws a member key for the destination h: field names of a struct destination in
+// several spellings, unknown keys, or plain keys.
+func (w *hintWriter) keyFor(h hint) string {
+	_, t := w.hintStructType(h)
+	if t != nil && chance(w.tc, 88) {
+		fields := structFields(t)
+		f := fields[drawInt(w.tc, 0, len(fields)-1)]
+		switch drawInt(w.tc, 0, 7) {
+		case 0:
+			return strings.ToLower(f.name)
+		case 1:
+			return strings.ToUpper(f.name)
+		case 2:
+			// The long s folds to S in encoding/json.
+			return strings.Replace(strings.Replace(f.name, "S", "\u017f", 1), "s", "\u017f", 1)
+		default:
+			return f.name
+		}
+	}
+	return pick(w.tc, hintKeys)
+}
+
+func (w *hintWriter) hintStructType(h hint) (reflect.Value, reflect.Type) {
+	if h.elemType() != nil {
+		return reflect.Value{}, nil
+	}
+	d, t := h.unravel()
+	if t != nil && t.Kind() == reflect.Struct {
+		return d, t
+	}
+	return reflect.Value{}, nil
+}
+
+// writeKey writes a key, quoteless when it can be, and returns it.
+func (w *hintWriter) writeKey(k string) string {
+	if k != "" && !strings.ContainsAny(k, " \t\n\r{}[],:\"'#/") && chance(w.tc, 80) {
+		w.hj.write(k)
+		return k
+	}
+	return w.hj.quoted(k, chance(w.tc, 30))
+}
+
+// value writes a value for the destination h and returns the JSON text the parser gives it.
+func (w *hintWriter) value(h, shape hint, indent int) string {
+	if s, ok := w.fitting(h, shape, indent); ok {
+		return s
+	}
+	top := 9
+	if w.depth <= 0 {
+		top = 6
+	}
+	switch drawInt(w.tc, 0, top) {
+	case 0, 1, 2, 3, 4:
+		return w.token(h, pick(w.tc, hintTokens))
+	case 5:
+		return jsonString(w.hj.quoted(genString(w.tc), chance(w.tc, 30)))
+	case 6:
+		return jsonString(w.hj.multiline())
+	case 7:
+		return w.array(h, shape, indent)
+	default:
+		return w.object(h, shape, indent)
+	}
+}
+
+// members writes n object members, one per line, and returns the JSON object: keys in
+// first-occurrence order with the last value of a duplicated key (the parser's OrderedMap).
+func (w *hintWriter) members(h, shape hint, indent int, n int) string {
+	var keys []string
+	vals := map[string]string{}
+	for i := 0; i < n; i++ {
+		w.line(indent)
+		k := w.writeKey(w.keyFor(h))
+		w.hj.write(pick(w.tc, []string{":", ": ", " : "}))
+		v := w.value(h.child(k), shape.child(k), indent)
+		if _, dup := vals[k]; !dup {
+			keys = append(keys, k)
+		}
+		vals[k] = v
+	}
+	var sb strings.Builder
+	sb.WriteString("{")
+	for i, k := range keys {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString(jsonString(k) + ":" + vals[k])
+	}
+	sb.WriteString("}")
+	return sb.String()
+}
+
+// TestHegelTypedHints: an Hjson object of quoteless, quoted and multiline values, arrays and
+// objects decodes into a (possibly pre-filled) struct with fields of every kind exactly as
+// encoding/json decodes the JSON text in which each quoteless token is a string when its
+// destination is string-typed and the raw token otherwise; with UseJSONNumber and
+// DisallowUnknownFields too.
+func TestHegelTypedHints(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		pre := genPrefill(ht)
+		want, got := pre.build(), pre.build()
+		opts := hjson.DefaultDecoderOptions()
+		opts.UseJSONNumber = chance(ht, 30)
+		opts.DisallowUnknownFields = chance(ht, 30)
+
+		w := &hintWriter{hj: &hjWriter{tc: ht}, tc: ht, depth: 2}
+		root := hint{dest: reflect.ValueOf(got).Elem(), t: reflect.TypeOf(got)}
+		shape := root
+		shape.fold = true
+		n := drawInt(ht, 0, 6)
+		var modelJSON string
+		if chance(ht, 50) {
+			w.hj.write("{")
+			modelJSON = w.members(root, shape, 2, n)
+			w.line(0)
+			w.hj.write("}")
+		} else {
+			if n == 0 {
+				n = 1
+			}
+			modelJSON = w.members(root, shape, 0, n)
+			w.hj.write("\n")
+		}
+		text := w.hj.sb.String()
+		if w.hj.surrog {
+			c.count("surrogate pairs")
+		}
+
+		dec := json.NewDecoder(bytes.NewReader([]byte(modelJSON)))
+		if opts.UseJSONNumber {
+			dec.UseNumber()
+		}
+		if opts.DisallowUnknownFields {
+			dec.DisallowUnknownFields()
+		}
+		wantErr := dec.Decode(want)
+		gotErr := hjson.UnmarshalWithOptions([]byte(text), got, opts)
+		if (wantErr == nil) != (gotErr == nil) {
+			c.failClass(ht, "error", "opts %+v\n%q\nmodel %s\n  hjson err %v\n  json err  %v", opts, show(text), modelJSON, gotErr, wantErr)
+			return
+		}
+		if wantErr != nil {
+			c.count("both error")
+			return
+		}
+		if !reflect.DeepEqual(want, got) {
+			c.failClass(ht, "value", "opts %+v\n%q\nmodel %s\n  got  %s\n  want %s", opts, show(text), modelJSON, showHinted(got), showHinted(want))
+		}
+	})
+}
+
+func showHinted(h *hinted) string {
+	b, err := json.Marshal(h)
+	if err != nil {
+		return fmt.Sprintf("%#v", h)
+	}
+	return string(b) + fmt.Sprintf(" (Skip=%q, PS nil=%v, Sub nil=%v)", h.Skip, h.PS == nil, h.Sub == nil)
+}
diff --git a/hegel/hegel_json_test.go b/hegel/hegel_json_test.go
new file mode 100644
index 0000000..d6e6a7a
--- /dev/null
+++ b/hegel/hegel_json_test.go
@@ -0,0 +1,277 @@
+package hegel
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- JSON texts
+
+// jsonWriter writes a generated value as a JSON text with random whitespace, escape spellings,
+// number spellings, key order and duplicate keys, and builds the value the text denotes: an
+// ordered tree (*hjson.OrderedMap for objects, in first-occurrence key order with the last
+// value of a duplicated key), as hjson must read it.
+type jsonWriter struct {
+	tc         hegel.TestCase
+	sb         strings.Builder
+	dupes      bool // a duplicated key was written
+	surrogates bool // a \u surrogate pair was written
+}
+
+func (w *jsonWriter) ws() {
+	if chance(w.tc, 30) {
+		w.sb.WriteString(pick(w.tc, []string{" ", "\t", "\n", "\r\n", "  ", " \n "}))
+	}
+}
+
+// str writes s as a JSON string and returns the string hjson decodes it to.
+func (w *jsonWriter) str(s string) string {
+	w.sb.WriteByte('"')
+	var got strings.Builder
+	for _, r := range s {
+		form := drawInt(w.tc, 0, 3)
+		switch {
+		case r == '"' || r == '\\':
+			w.sb.WriteByte('\\')
+			w.sb.WriteRune(r)
+		case r < 0x20 && form == 0 && strings.ContainsRune("\b\f\n\r\t", r):
+			w.sb.WriteByte('\\')
+			w.sb.WriteByte("btnfr"[strings.IndexRune("\b\t\n\f\r", r)])
+		case r < 0x20 || (form == 1 && r <= 0xffff):
+			if chance(w.tc, 50) {
+				fmt.Fprintf(&w.sb, "\\u%04x", r)
+			} else {
+				fmt.Fprintf(&w.sb, "\\u%04X", r)
+			}
+		case r > 0xffff && form <= 1:
+			hi := 0xd800 + ((r - 0x10000) >> 10)
+			lo := 0xdc00 + ((r - 0x10000) & 0x3ff)
+			fmt.Fprintf(&w.sb, "\\u%04x\\u%04x", hi, lo)
+			w.surrogates = true
+			if Known.surrogatePairs {
+				got.WriteString(string([]rune{0xfffd, 0xfffd}))
+				continue
+			}
+		case r == '/' && form == 2:
+			w.sb.WriteString("\\/")
+		default:
+			w.sb.WriteRune(r)
+		}
+		got.WriteRune(r)
+	}
+	w.sb.WriteByte('"')
+	return got.String()
+}
+
+func (w *jsonWriter) num(f float64) {
+	switch drawInt(w.tc, 0, 3) {
+	case 0:
+		w.sb.WriteString(strconv.FormatFloat(f, 'e', -1, 64))
+	case 1:
+		w.sb.WriteString(strings.ToUpper(strconv.FormatFloat(f, 'e', -1, 64)))
+	case 2:
+		if f == float64(int64(f)) && f < 1e15 && f > -1e15 {
+			w.sb.WriteString(strconv.FormatFloat(f, 'f', 1, 64)) // "12.0"
+		} else {
+			w.sb.WriteString(strconv.FormatFloat(f, 'g', -1, 64))
+		}
+	default:
+		b, _ := json.Marshal(f)
+		w.sb.Write(b)
+	}
+}
+
+func (w *jsonWriter) value(v interface{}) interface{} {
+	w.ws()
+	defer w.ws()
+	switch x := v.(type) {
+	case nil:
+		w.sb.WriteString("null")
+		return nil
+	case bool:
+		if x {
+			w.sb.WriteString("true")
+		} else {
+			w.sb.WriteString("false")
+		}
+		return x
+	case float64:
+		w.num(x)
+		return x
+	case string:
+		return w.str(x)
+	case []interface{}:
+		w.sb.WriteByte('[')
+		out := make([]interface{}, 0, len(x))
+		for i, e := range x {
+			if i > 0 {
+				w.sb.WriteByte(',')
+			}
+			out = append(out, w.value(e))
+		}
+		w.ws()
+		w.sb.WriteByte(']')
+		return out
+	case map[string]interface{}:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		for i := len(keys) - 1; i > 0; i-- {
+			j := drawInt(w.tc, 0, i)
+			keys[i], keys[j] = keys[j], keys[i]
+		}
+		w.sb.WriteByte('{')
+		om := hjson.NewOrderedMap()
+		first := true
+		write := func(k string, val interface{}) string {
+			if !first {
+				w.sb.WriteByte(',')
+			}
+			first = false
+			w.ws()
+			gotK := w.str(k)
+			w.ws()
+			w.sb.WriteByte(':')
+			om.Set(gotK, w.value(val))
+			return gotK
+		}
+		for _, k := range keys {
+			if chance(w.tc, 15) {
+				// Overwritten by the value below (unless the two spellings of the key decode
+				// differently, which only the surrogate behaviour can cause).
+				k1 := write(k, genValue(w.tc, 0))
+				if k1 == write(k, x[k]) {
+					w.dupes = true
+				}
+				continue
+			}
+			write(k, x[k])
+		}
+		w.ws()
+		w.sb.WriteByte('}')
+		return om
+	}
+	panic("jsonWriter: unexpected value")
+}
+
+// ordered renders a decoded tree with object keys in their order (OrderedMap) and Nodes
+// unwrapped; plain maps sorted.
+func ordered(v interface{}) string {
+	var sb strings.Builder
+	orderedInto(&sb, v)
+	return sb.String()
+}
+
+func orderedInto(sb *strings.Builder, v interface{}) {
+	switch x := v.(type) {
+	case *hjson.OrderedMap:
+		sb.WriteByte('{')
+		for i, k := range x.Keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			b, _ := json.Marshal(k)
+			sb.Write(b)
+			sb.WriteByte(':')
+			orderedInto(sb, x.Map[k])
+		}
+		sb.WriteByte('}')
+	case hjson.OrderedMap:
+		orderedInto(sb, &x)
+	case *hjson.Node:
+		orderedInto(sb, x.Value)
+	case hjson.Node:
+		orderedInto(sb, x.Value)
+	case []interface{}:
+		sb.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			orderedInto(sb, e)
+		}
+		sb.WriteByte(']')
+	default:
+		canonInto(sb, v)
+	}
+}
+
+// TestHegelJSON: Hjson is a superset of JSON. A generated JSON text decodes through hjson (into
+// interface{}, with UseJSONNumber, into a Node and into an OrderedMap) to the value
+// encoding/json decodes it to, with object keys in first-occurrence order; DisallowDuplicateKeys
+// rejects exactly the texts with a duplicated key.
+func TestHegelJSON(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		w := &jsonWriter{tc: ht}
+		want := w.value(v)
+		text := w.sb.String()
+
+		var jv interface{}
+		if err := json.Unmarshal([]byte(text), &jv); err != nil {
+			ht.Fatalf("generated JSON rejected by encoding/json: %v\n%s", err, text)
+		}
+		wantCanon := canon(want)
+		if !w.surrogates && canon(jv) != wantCanon {
+			ht.Fatalf("writer and encoding/json disagree: %s vs %s\n%s", canon(jv), wantCanon, text)
+		}
+		if w.dupes {
+			c.count("duplicate keys")
+		}
+		if w.surrogates {
+			c.count("surrogate pairs")
+		}
+
+		var hv interface{}
+		if err := hjson.Unmarshal([]byte(text), &hv); err != nil {
+			c.failClass(ht, "interface error", "hjson rejects the JSON text: %v\n%s", err, show(text))
+			return
+		}
+		if got := canon(hv); got != wantCanon {
+			c.failClass(ht, "interface", "hjson decodes %s\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+			return
+		}
+
+		opts := hjson.DefaultDecoderOptions()
+		opts.UseJSONNumber = true
+		var nv interface{}
+		if err := hjson.UnmarshalWithOptions([]byte(text), &nv, opts); err != nil {
+			c.failClass(ht, "number error", "UseJSONNumber: %v\n%s", err, show(text))
+		} else if got := canon(nv); got != wantCanon {
+			c.failClass(ht, "number", "UseJSONNumber decodes %s\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+		}
+
+		wantOrdered := ordered(want)
+		var node hjson.Node
+		if err := hjson.Unmarshal([]byte(text), &node); err != nil {
+			c.failClass(ht, "node error", "into Node: %v\n%s", err, show(text))
+		} else if got := ordered(&node); got != wantOrdered {
+			c.failClass(ht, "node", "into Node %s\n  got  %s\n  want %s", show(text), show(got), show(wantOrdered))
+		}
+
+		if om, ok := want.(*hjson.OrderedMap); ok {
+			var got hjson.OrderedMap
+			if err := hjson.Unmarshal([]byte(text), &got); err != nil {
+				c.failClass(ht, "orderedmap error", "into OrderedMap: %v\n%s", err, show(text))
+			} else if g := ordered(&got); g != ordered(om) {
+				c.failClass(ht, "orderedmap", "into OrderedMap %s\n  got  %s\n  want %s", show(text), show(g), show(wantOrdered))
+			}
+		}
+
+		opts = hjson.DefaultDecoderOptions()
+		opts.DisallowDuplicateKeys = true
+		var dv interface{}
+		err := hjson.UnmarshalWithOptions([]byte(text), &dv, opts)
+		if (err != nil) != w.dupes {
+			c.failClass(ht, "duplicates", "DisallowDuplicateKeys: err=%v, duplicated key written=%v\n%s", err, w.dupes, show(text))
+		}
+	})
+}
diff --git a/hegel/hegel_marshalers_test.go b/hegel/hegel_marshalers_test.go
new file mode 100644
index 0000000..27a256b
--- /dev/null
+++ b/hegel/hegel_marshalers_test.go
@@ -0,0 +1,358 @@
+package hegel
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- Marshaler values
+//
+// MarshalWithOptions: "If an encountered value implements the json.Marshaler interface then
+// the function MarshalJSON() is called on it. The JSON is then converted to Hjson ... If an
+// encountered value implements the encoding.TextMarshaler interface but not the json.Marshaler
+// interface, then the function MarshalText() is called on it to get a text." Map keys "must be
+// possible to print to a string using fmt.Sprintf("%v", key), or implement
+// encoding.TextMarshaler. The map keys are sorted alphabetically". The oracle is encoding/json:
+// the Hjson text of a value, decoded, is the value encoding/json gives it.
+
+type mjVal struct{ N int }
+
+func (m mjVal) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`{"v":%d}`, m.N)), nil }
+
+type mjPtr struct{ N int }
+
+func (m *mjPtr) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`{"p":%d}`, m.N)), nil }
+
+// The texts carry no colon: a root string with a colon reads back as an object (bug 9).
+type mtVal struct{ S string }
+
+func (m mtVal) MarshalText() ([]byte, error) { return []byte("t_" + m.S), nil }
+
+type mtPtr struct{ S string }
+
+func (m *mtPtr) MarshalText() ([]byte, error) { return []byte("pt_" + m.S), nil }
+
+// mjAny marshals to arbitrary JSON.
+type mjAny struct{ V interface{} }
+
+func (m mjAny) MarshalJSON() ([]byte, error) { return json.Marshal(m.V) }
+
+// mjBoth implements both interfaces; MarshalJSON must win.
+type mjBoth struct{ N int }
+
+func (m mjBoth) MarshalJSON() ([]byte, error) { return []byte(fmt.Sprintf(`[%d]`, m.N)), nil }
+func (m mjBoth) MarshalText() ([]byte, error) { return []byte("text"), nil }
+
+type mjErr struct{}
+
+func (mjErr) MarshalJSON() ([]byte, error) { return nil, errors.New("no") }
+
+// plainN and plainS are what the encoder writes for mjPtr and mtPtr (their fields).
+type plainN struct{ N int }
+type plainS struct{ S string }
+
+// intKey is a map key type with a TextMarshaler whose text order differs from its value order.
+type intKey int
+
+var intKeyNames = map[intKey]string{1: "z", 2: "a", 3: "m", 4: "b", 5: "y", 10: "c"}
+
+func (k intKey) MarshalText() ([]byte, error) { return []byte(intKeyNames[k]), nil }
+
+// holder has Marshaler fields of every receiver kind; encoding/json calls a pointer-receiver
+// method on an addressable field (when the holder is marshalled through a pointer).
+type holder struct {
+	V  mjVal
+	P  mjPtr
+	PP *mjPtr
+	T  mtVal
+	TP mtPtr
+	B  mjBoth
+	A  mjAny
+}
+
+// oracleHolder is holder as the encoder writes it: pointer-receiver marshalers ignored.
+type oracleHolder struct {
+	V  mjVal
+	P  plainN
+	PP *plainN
+	T  mtVal
+	TP plainS
+	B  mjBoth
+	A  mjAny
+}
+
+var safeWords = []string{"a", "b", "hello", "x y", "1", "true", "", "z"}
+
+// safeValue is genValue with plain words for strings (the quoting rules are covered elsewhere).
+func safeValue(tc hegel.TestCase, depth int) interface{} {
+	return reword(tc, genValue(tc, depth))
+}
+
+func reword(tc hegel.TestCase, v interface{}) interface{} {
+	switch x := v.(type) {
+	case string:
+		return pick(tc, safeWords)
+	case []interface{}:
+		for i := range x {
+			x[i] = reword(tc, x[i])
+		}
+	case map[string]interface{}:
+		m := map[string]interface{}{}
+		for _, val := range x {
+			m[pick(tc, safeWords)] = reword(tc, val)
+		}
+		return m
+	}
+	return v
+}
+
+// mkind is a generated value's shape; build makes the value (real) and its oracle twin.
+type mkind int
+
+const (
+	kPlain mkind = iota
+	kMjVal
+	kMjPtr    // mjPtr by value (not addressable inside an interface: json writes its fields too)
+	kMjPtrPtr // *mjPtr
+	kMtVal
+	kMtPtr
+	kMtPtrPtr // *mtPtr
+	kMjAny
+	kMjBoth
+	kMjErr
+	kHolderPtr
+	kHolderVal
+	kList
+	kIntMap
+	kTextMap
+	kStrMap
+)
+
+type mspec struct {
+	kind  mkind
+	n     int
+	s     string
+	any   interface{}
+	items []mspec
+	keys  []intKey
+	ks    []string
+}
+
+func genSpec(tc hegel.TestCase, depth int) mspec {
+	top := int(kStrMap)
+	if depth <= 0 {
+		top = int(kHolderVal)
+	}
+	sp := mspec{kind: mkind(drawInt(tc, 0, top)), n: drawInt(tc, -5, 100), s: pick(tc, safeWords)}
+	if sp.kind == kMjErr && !chance(tc, 20) {
+		sp.kind = kMjAny
+	}
+	switch sp.kind {
+	case kPlain, kMjAny, kHolderPtr, kHolderVal:
+		sp.any = safeValue(tc, 1)
+	case kList, kStrMap:
+		seen := map[string]bool{}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			k := pick(tc, safeWords)
+			if sp.kind == kStrMap && seen[k] {
+				continue
+			}
+			seen[k] = true
+			sp.items = append(sp.items, genSpec(tc, depth-1))
+			sp.ks = append(sp.ks, k)
+		}
+	case kIntMap:
+		for i := drawInt(tc, 0, 4); i > 0; i-- {
+			sp.keys = append(sp.keys, pick(tc, []intKey{1, 2, 3, 4, 5, 10}))
+		}
+	case kTextMap:
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			sp.ks = append(sp.ks, pick(tc, safeWords))
+		}
+	}
+	return sp
+}
+
+// hasErr reports whether the value's MarshalJSON fails somewhere.
+func (sp mspec) hasErr() bool {
+	if sp.kind == kMjErr {
+		return true
+	}
+	for _, it := range sp.items {
+		if it.hasErr() {
+			return true
+		}
+	}
+	return false
+}
+
+// build makes the value; oracle asks for the twin encoding/json must see to write what the
+// encoder writes (pointer-receiver marshalers replaced by plain structs when the encoder
+// ignores them).
+func (sp mspec) build(oracle bool) interface{} {
+	plain := oracle && Known.ptrMarshalers
+	switch sp.kind {
+	case kPlain:
+		return sp.any
+	case kMjVal:
+		return mjVal{N: sp.n}
+	case kMjPtr:
+		if plain {
+			return plainN{N: sp.n}
+		}
+		return mjPtr{N: sp.n}
+	case kMjPtrPtr:
+		if plain {
+			return &plainN{N: sp.n}
+		}
+		return &mjPtr{N: sp.n}
+	case kMtVal:
+		return mtVal{S: sp.s}
+	case kMtPtr:
+		if plain {
+			return plainS{S: sp.s}
+		}
+		return mtPtr{S: sp.s}
+	case kMtPtrPtr:
+		if plain {
+			return &plainS{S: sp.s}
+		}
+		return &mtPtr{S: sp.s}
+	case kMjAny:
+		return mjAny{V: sp.any}
+	case kMjBoth:
+		return mjBoth{N: sp.n}
+	case kMjErr:
+		return mjErr{}
+	case kHolderPtr, kHolderVal:
+		if plain {
+			h := oracleHolder{V: mjVal{sp.n}, P: plainN{sp.n + 1}, PP: &plainN{sp.n + 2}, T: mtVal{sp.s}, TP: plainS{sp.s + "!"}, B: mjBoth{sp.n}, A: mjAny{sp.any}}
+			if sp.kind == kHolderPtr {
+				return &h
+			}
+			return h
+		}
+		h := holder{V: mjVal{sp.n}, P: mjPtr{sp.n + 1}, PP: &mjPtr{sp.n + 2}, T: mtVal{sp.s}, TP: mtPtr{sp.s + "!"}, B: mjBoth{sp.n}, A: mjAny{sp.any}}
+		if sp.kind == kHolderPtr {
+			return &h
+		}
+		return h
+	case kList:
+		out := make([]interface{}, 0, len(sp.items))
+		for _, it := range sp.items {
+			out = append(out, it.build(oracle))
+		}
+		return out
+	case kStrMap:
+		out := map[string]interface{}{}
+		for i, it := range sp.items {
+			out[sp.ks[i]] = it.build(oracle)
+		}
+		return out
+	case kIntMap:
+		out := map[intKey]int{}
+		for i, k := range sp.keys {
+			out[k] = i
+		}
+		return out
+	default:
+		out := map[mtVal]int{}
+		for i, k := range sp.ks {
+			out[mtVal{S: k}] = i
+		}
+		return out
+	}
+}
+
+// wantKeyOrder is the order the encoder writes the keys of a map with TextMarshaler keys:
+// alphabetically by text, or (as recorded) by the fmt %v of the key values.
+func (sp mspec) wantKeyOrder() []string {
+	type kv struct{ sortBy, text string }
+	var kvs []kv
+	seen := map[string]bool{}
+	switch sp.kind {
+	case kIntMap:
+		for _, k := range sp.keys {
+			text := intKeyNames[k]
+			if !seen[text] {
+				seen[text] = true
+				kvs = append(kvs, kv{fmt.Sprintf("%v", int(k)), text})
+			}
+		}
+	case kTextMap:
+		for _, k := range sp.ks {
+			text := "t_" + k
+			if !seen[text] {
+				seen[text] = true
+				kvs = append(kvs, kv{fmt.Sprintf("%v", mtVal{S: k}), text})
+			}
+		}
+	}
+	sort.Slice(kvs, func(i, j int) bool {
+		if Known.mapKeyOrder {
+			return kvs[i].sortBy < kvs[j].sortBy
+		}
+		return kvs[i].text < kvs[j].text
+	})
+	var out []string
+	for _, x := range kvs {
+		out = append(out, x.text)
+	}
+	return out
+}
+
+// TestHegelMarshalers: a value with json.Marshaler and encoding.TextMarshaler parts (value and
+// pointer receivers, direct, behind pointers, in struct fields, lists and maps, as map keys)
+// marshals to Hjson that decodes to what encoding/json writes for it; a failing MarshalJSON
+// fails Marshal; maps with TextMarshaler keys are written in key order.
+func TestHegelMarshalers(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sp := genSpec(ht, 2)
+		opts := genEncoderOptions(ht)
+		opts.QuoteAmbiguousStrings = true // the words include 1 and true; the quoting rules are covered elsewhere
+		real := sp.build(false)
+		text, err := hjson.MarshalWithOptions(real, opts)
+		if sp.hasErr() {
+			c.count("marshal error")
+			if err == nil {
+				c.failClass(ht, "no error", "Marshal of a failing MarshalJSON succeeded: %q", show(string(text)))
+			}
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "error", "Marshal %T: %v", real, err)
+			return
+		}
+		var got interface{}
+		if err := hjson.Unmarshal(text, &got); err != nil {
+			c.failClass(ht, "decode error", "Unmarshal of the encoder's output: %v\n%q", err, show(string(text)))
+			return
+		}
+		var want interface{}
+		if err := json.Unmarshal(mustJSON(sp.build(true)), &want); err != nil {
+			panic(err)
+		}
+		if g, w := canon(got), canon(want); g != w {
+			c.failClass(ht, "value", "%T under %+v\n%q\n  got  %s\n  want %s", real, opts, show(string(text)), show(g), show(w))
+			return
+		}
+		if sp.kind == kIntMap || sp.kind == kTextMap {
+			var om hjson.OrderedMap
+			if err := hjson.Unmarshal(text, &om); err != nil {
+				c.failClass(ht, "om error", "into OrderedMap: %v\n%q", err, show(string(text)))
+				return
+			}
+			if g, w := strings.Join(om.Keys, ","), strings.Join(sp.wantKeyOrder(), ","); g != w {
+				c.failClass(ht, "key order", "%T\n%q\n  keys %s\n  want %s", real, show(string(text)), g, w)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_node_test.go b/hegel/hegel_node_test.go
new file mode 100644
index 0000000..3e516f3
--- /dev/null
+++ b/hegel/hegel_node_test.go
@@ -0,0 +1,162 @@
+package hegel
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// reCRLF: a CRLF line end not following a key's colon (BracesSameLine off puts the value's
+// bracket on the next line, and that line end is kept verbatim in the Key comment).
+var reCRLF = regexp.MustCompile(`([^:\r])\r\n`)
+
+// reMLBlank: an array element that is a multiline string: a blank (indented) line, then the
+// line of the opening ”'.
+var reMLBlank = regexp.MustCompile(`(\r?\n)([ \t]*)(\r?\n)([ \t]*)'''`)
+
+// hasMLInArray reports whether some array element of v is encoded as a multiline string over
+// several lines.
+func hasMLInArray(v interface{}, o hjson.EncoderOptions, inArray bool) bool {
+	switch x := v.(type) {
+	case string:
+		if !inArray || !strings.Contains(x, "\n") {
+			return false
+		}
+		quoted := o.QuoteAlways || reNeedsQuotes.MatchString(x) || (o.QuoteAmbiguousStrings && ambiguous(x))
+		return quoted && reNeedsEscape.MatchString(x) && !reNeedsEscapeML.MatchString(x)
+	case []interface{}:
+		for _, e := range x {
+			if hasMLInArray(e, o, true) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasMLInArray(e, o, false) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasLineFeedEnd reports whether some string value of v ends in a line feed (followed by
+// blanks at most): its last line is an empty line, which the layout cannot tell from an added
+// blank line.
+func hasLineFeedEnd(v interface{}) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.HasSuffix(strings.TrimRight(x, " \t"), "\n")
+	case []interface{}:
+		for _, e := range x {
+			if hasLineFeedEnd(e) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasLineFeedEnd(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasColonEnd reports whether some string value of v ends in a colon.
+func hasColonEnd(v interface{}) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.HasSuffix(x, ":")
+	case []interface{}:
+		for _, e := range x {
+			if hasColonEnd(e) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, e := range x {
+			if hasColonEnd(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// TestHegelNodeFixedPoint: the encoder's own output, read into a Node (whitespace and comments
+// kept, or not) and encoded again with the same options, is the same text; the Node's value is
+// the value the text decodes to.
+func TestHegelNodeFixedPoint(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		opts := genEncoderOptions(ht)
+		if _, ok, changed := expectedDecode(v, opts, true); !ok || changed {
+			// A string the round trip does not preserve (see stringOutcome): the re-encoded
+			// text cannot be the same.
+			c.count("skipped: string not preserved")
+			return
+		}
+		b, err := hjson.MarshalWithOptions(v, opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		text := string(b)
+		dopts := hjson.DefaultDecoderOptions()
+		dopts.WhitespaceAsComments = chance(ht, 70)
+		if dopts.WhitespaceAsComments {
+			c.count("whitespace kept")
+		}
+		var node hjson.Node
+		if err := hjson.UnmarshalWithOptions(b, &node, dopts); err != nil {
+			c.failClass(ht, "reject", "into Node: %v\n%+v\n%q", err, opts, show(text))
+			return
+		}
+		var back interface{}
+		if err := hjson.Unmarshal(b, &back); err != nil {
+			c.failClass(ht, "reject", "into interface{}: %v\n%q", err, show(text))
+			return
+		}
+		if got, want := canon(&node), canon(back); got != want {
+			c.failClass(ht, "value", "Node value %s, interface{} value %s\n%q", show(got), show(want), show(text))
+			return
+		}
+		again, err := hjson.MarshalWithOptions(node, opts)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(node): %v\n%q", err, show(text))
+			return
+		}
+		want := text
+		kept := dopts.WhitespaceAsComments && opts.Comments
+		m, isMap := v.(map[string]interface{})
+		bracelessRoot := isMap && !opts.EmitRootBraces && len(m) > 0
+		if Known.baseIndentDoubled && kept && opts.BaseIndentation != "" && !bracelessRoot {
+			want = opts.BaseIndentation + text
+		}
+		if Known.crlfDoubled && kept && opts.Eol == "\r\n" {
+			if strings.Contains(text, "'''") || hasColonEnd(v) {
+				// The line ends inside a multiline string, and a key line whose value follows on
+				// the next line, are not doubled; a string ending in a colon looks like the latter.
+				c.count("skipped: CRLF with a multiline string or a colon-ending string")
+				return
+			}
+			want = reCRLF.ReplaceAllString(want, "$1\r\r\n")
+		}
+		if Known.mlArrayBlankLine && kept && hasMLInArray(v, opts, false) {
+			if opts.IndentBy == "" || hasLineFeedEnd(v) {
+				// The blank line cannot be told from a multiline string's last empty line.
+				c.count("skipped: multiline string in an array, ambiguous layout")
+				return
+			}
+			want = reMLBlank.ReplaceAllString(want, "$1$2$3$4$3$4'''")
+		}
+		if string(again) != want {
+			c.failClass(ht, "text", "Marshal(node) differs from the text it was read from\n%+v whitespaceAsComments=%v\n  text  %q\n  again %q", opts, dopts.WhitespaceAsComments, show(text), show(string(again)))
+		}
+	})
+}
diff --git a/hegel/hegel_parse_test.go b/hegel/hegel_parse_test.go
new file mode 100644
index 0000000..e15c940
--- /dev/null
+++ b/hegel/hegel_parse_test.go
@@ -0,0 +1,593 @@
+package hegel
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	hjson "github.com/hjson/hjson-go/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- Hjson documents
+
+// hjWriter writes a random Hjson document (quoteless, quoted and multiline strings, numbers,
+// keywords, objects with quoteless and quoted keys, arrays, optional commas, braceless root,
+// comments of the three kinds) and builds the value the document denotes, following the Hjson
+// syntax (hjson.github.io/syntax.html): quoteless strings run to the end of the line and are
+// trimmed; a value is a number or keyword only when its text up to the next punctuator,
+// comment or line end says so; a multiline string's lines lose the indentation of the opening
+// ”' and its last line feed.
+type hjWriter struct {
+	tc     hegel.TestCase
+	sb     strings.Builder
+	col    int  // bytes since the last line feed
+	term   bool // the last token needs a terminator (number, keyword: a comma, bracket, comment or line end)
+	toEOL  bool // the last token was a quoteless string: only a line end can follow
+	dupes  bool
+	surrog bool
+
+	afterComment bool // ws() wrote a comment since it was last entered
+	afterNewline bool // ws() wrote a line end since it was last entered
+	// A string with a line feed (written back as a multiline string) followed a comment, or a
+	// line end, between the key's colon (or the array's bracket) and the value.
+	mlAfterComment bool
+	mlAfterNewline bool
+	rootTrail      bool // whitespace or comments follow the root value
+}
+
+func (w *hjWriter) write(s string) {
+	w.sb.WriteString(s)
+	if i := strings.LastIndexByte(s, '\n'); i >= 0 {
+		w.col = len(s) - i - 1
+	} else {
+		w.col += len(s)
+	}
+}
+
+func (w *hjWriter) newline() {
+	w.write(pick(w.tc, []string{"\n", "\n", "\r\n"}))
+	w.term, w.toEOL = false, false
+}
+
+var commentTexts = []string{"", " c", " a comment", " x: 1", " [1, 2]", " '''", " \"q\"", " # nested", " // slashes", " {", "\t", " é"}
+
+// comment writes a comment; line comments end the line.
+func (w *hjWriter) comment() {
+	switch drawInt(w.tc, 0, 2) {
+	case 0:
+		w.write("#" + pick(w.tc, commentTexts))
+		w.newline()
+	case 1:
+		w.write("//" + pick(w.tc, commentTexts))
+		w.newline()
+	default:
+		w.write("/*" + pick(w.tc, commentTexts) + pick(w.tc, []string{"", "\n", "\n  * more\n"}) + "*/")
+	}
+}
+
+// ws writes whitespace and, when allowed, comments between tokens; after a quoteless string it
+// starts with a line end.
+func (w *hjWriter) ws(comments bool) {
+	if w.toEOL {
+		w.newline()
+	}
+	for n := drawInt(w.tc, 0, 2); n > 0; n-- {
+		switch drawInt(w.tc, 0, 4) {
+		case 0:
+			w.write(" ")
+		case 1:
+			w.write("\t")
+		case 2:
+			w.newline()
+			w.afterNewline = true
+		default:
+			if comments {
+				w.comment()
+				w.afterComment = true
+			} else {
+				w.write("  ")
+			}
+		}
+	}
+}
+
+// noteString records a string value written after a comment or a line end (since the key, the
+// separator or the bracket before it: resetFlags) and resets the flags.
+func (w *hjWriter) noteString(s string) string {
+	if strings.Contains(s, "\n") {
+		w.mlAfterComment = w.mlAfterComment || w.afterComment
+		w.mlAfterNewline = w.mlAfterNewline || w.afterNewline
+	}
+	w.resetFlags()
+	return s
+}
+
+func (w *hjWriter) resetFlags() { w.afterComment, w.afterNewline = false, false }
+
+// sep separates two members: a comma, a line end, or both (a comma may sit on the next line).
+func (w *hjWriter) sep() {
+	w.resetFlags()
+	if w.toEOL {
+		w.newline()
+		if chance(w.tc, 20) {
+			w.write(",")
+		}
+	} else if chance(w.tc, 50) {
+		w.write(",")
+	} else {
+		w.newline()
+		if chance(w.tc, 20) {
+			w.write(",")
+		}
+	}
+	w.term, w.toEOL = false, false
+	w.ws(true)
+}
+
+// closing ends a container: a quoteless string needs a line end first; a trailing comma is
+// allowed after a member.
+func (w *hjWriter) closing(bracket string, members bool) {
+	if w.toEOL {
+		w.newline()
+	}
+	if members && chance(w.tc, 25) {
+		w.write(",")
+		w.term, w.toEOL = false, false
+	}
+	w.ws(true)
+	w.write(bracket)
+	w.term, w.toEOL = false, false
+}
+
+// ---- strings
+
+var quotelessAtoms = []string{"a", "b", "x", "Z", "0", "1", "9", " ", "-", ".", "/", "#", "*", ":", "{", "}", "[", "]", ",", "'", "\"", "\\", "é", "😀", "true", "null", "1", "0x", "e5", "5 times", "//", "/*"}
+
+// quotelessOK: s (already trimmed) is read as a plain quoteless string by readTfnns: it starts
+// with none of the characters a value cannot start with, contains no line end, and at each
+// terminator (and at the end) its prefix is neither a keyword nor a number.
+func quotelessOK(s string) bool {
+	if s == "" || strings.ContainsAny(s, "\n\r") {
+		return false
+	}
+	c := s[0]
+	if strings.IndexByte("{}[],:\"'#", c) >= 0 || strings.HasPrefix(s, "//") || strings.HasPrefix(s, "/*") {
+		return false
+	}
+	numberish := c == '-' || (c >= '0' && c <= '9')
+	check := func(prefix string) bool {
+		t := strings.TrimSpace(prefix)
+		if t == "true" || t == "false" || t == "null" {
+			return false
+		}
+		if numberish && numberSyntax(prefix) {
+			return false
+		}
+		return true
+	}
+	for i := 1; i < len(s); i++ {
+		if s[i] == ',' || s[i] == '}' || s[i] == ']' || s[i] == '#' || (s[i] == '/' && i+1 < len(s) && (s[i+1] == '/' || s[i+1] == '*')) {
+			if !check(s[:i]) {
+				return false
+			}
+		}
+	}
+	return check(s)
+}
+
+// numberSyntax: text is a number followed by whitespace only, by the grammar of
+// tryParseNumber (no magnitude check).
+func numberSyntax(text string) bool {
+	i := 0
+	next := func() byte {
+		if i < len(text) {
+			return text[i]
+		}
+		return 0
+	}
+	leadingZeros, testLeading := 0, true
+	if next() == '-' {
+		i++
+	}
+	for c := next(); c >= '0' && c <= '9'; c = next() {
+		if testLeading {
+			if c == '0' {
+				leadingZeros++
+			} else {
+				testLeading = false
+			}
+		}
+		i++
+	}
+	if testLeading {
+		leadingZeros--
+	}
+	if next() == '.' {
+		i++
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	if c := next(); c == 'e' || c == 'E' {
+		i++
+		if c := next(); c == '-' || c == '+' {
+			i++
+		}
+		if c := next(); c < '0' || c > '9' {
+			return false
+		}
+		for c := next(); c >= '0' && c <= '9'; c = next() {
+			i++
+		}
+	}
+	for c := next(); c > 0 && c <= ' '; c = next() {
+		i++
+	}
+	return next() == 0 && leadingZeros == 0
+}
+
+// quoteless writes a quoteless string and returns its value.
+func (w *hjWriter) quoteless() string {
+	for {
+		var sb strings.Builder
+		for n := drawInt(w.tc, 1, 4); n > 0; n-- {
+			sb.WriteString(pick(w.tc, quotelessAtoms))
+		}
+		s := strings.TrimSpace(sb.String())
+		if quotelessOK(s) {
+			w.write(s)
+			if chance(w.tc, 30) {
+				w.write(pick(w.tc, []string{" ", "  ", "\t"})) // trailing whitespace is trimmed
+			}
+			w.toEOL = true
+			return s
+		}
+	}
+}
+
+// quoted writes a JSON-style string in double or single quotes with random escapes and
+// returns its value.
+func (w *hjWriter) quoted(s string, single bool) string {
+	q := byte('"')
+	if single {
+		q = '\''
+	}
+	var got strings.Builder
+	w.write(string(q))
+	for _, r := range s {
+		form := drawInt(w.tc, 0, 3)
+		switch {
+		case r == rune(q) || r == '\\':
+			w.write("\\" + string(r))
+		case r == '\n' || r == '\r' || r == '\t' || r == '\b' || r == '\f':
+			if form == 0 && r <= 0xffff {
+				w.write(fmt.Sprintf("\\u%04x", r))
+			} else {
+				w.write("\\" + string("nrtbf"[strings.IndexRune("\n\r\t\b\f", r)]))
+			}
+		case r < 0x20 || (form == 1 && r <= 0xffff):
+			w.write(fmt.Sprintf("\\u%04X", r))
+		case r > 0xffff && form <= 1:
+			hi := 0xd800 + ((r - 0x10000) >> 10)
+			lo := 0xdc00 + ((r - 0x10000) & 0x3ff)
+			w.write(fmt.Sprintf("\\u%04x\\u%04x", hi, lo))
+			w.surrog = true
+			if Known.surrogatePairs {
+				got.WriteString(string([]rune{0xfffd, 0xfffd}))
+				continue
+			}
+		case r == '/' && form == 2:
+			w.write("\\/")
+		case (r == '"' || r == '\'') && form == 2:
+			w.write("\\" + string(r))
+		default:
+			w.write(string(r))
+		}
+		got.WriteRune(r)
+	}
+	w.write(string(q))
+	w.term, w.toEOL = false, false
+	return got.String()
+}
+
+var mlAtoms = []string{"a", "line", " ", "  ", "\t", "'", "''", "\"", "\\", "#", "//", "/*", "{", "}", ":", ",", "é", "😀", "1", "true"}
+
+// mlLine draws a multiline string line without ”' and not ending in a quote.
+func (w *hjWriter) mlLine() string {
+	for {
+		var sb strings.Builder
+		for n := drawInt(w.tc, 0, 3); n > 0; n-- {
+			sb.WriteString(pick(w.tc, mlAtoms))
+		}
+		s := sb.String()
+		if !strings.Contains(s, "'''") && !strings.HasSuffix(s, "'") {
+			return s
+		}
+	}
+}
+
+// skipIndent removes up to n leading blanks (space or tab), as the parser does.
+func skipIndent(line string, n int) string {
+	i := 0
+	for i < len(line) && i < n && (line[i] == ' ' || line[i] == '\t') {
+		i++
+	}
+	return line[i:]
+}
+
+// multiline writes a ”' string and returns its value.
+func (w *hjWriter) multiline() string {
+	indent := w.col
+	w.write("'''")
+	if chance(w.tc, 30) {
+		// A single-line multiline string: the blanks after the opening ''' are skipped.
+		s := w.mlLine()
+		s = strings.ReplaceAll(s, "\n", "")
+		w.write(s + "'''")
+		w.term, w.toEOL = false, false
+		return strings.TrimLeft(s, " \t")
+	}
+	var value strings.Builder
+	first := ""
+	if chance(w.tc, 20) {
+		first = strings.TrimLeft(w.mlLine(), " \t")
+		w.write(first)
+	} else if chance(w.tc, 30) {
+		w.write(pick(w.tc, []string{" ", "\t"})) // blanks before the line end are skipped
+	}
+	value.WriteString(first)
+	w.newline()
+	lines := drawInt(w.tc, 0, 4)
+	for i := 0; i < lines; i++ {
+		ind := w.indentation(indent)
+		line := w.mlLine()
+		w.write(ind + line)
+		w.newline()
+		if first != "" || i > 0 {
+			value.WriteString("\n")
+		}
+		value.WriteString(skipIndent(ind+line, indent))
+	}
+	// The line feed before the closing ''' is dropped; the closing line's blanks (up to the
+	// opening column) are skipped.
+	w.write(strings.Repeat(" ", drawInt(w.tc, 0, indent)) + "'''")
+	w.term, w.toEOL = false, false
+	return value.String()
+}
+
+// indentation draws the blanks before a multiline string line: the opening column, fewer, or
+// more (the extra blanks are content).
+func (w *hjWriter) indentation(indent int) string {
+	switch drawInt(w.tc, 0, 4) {
+	case 0:
+		return strings.Repeat(" ", maxInt(0, indent-drawInt(w.tc, 1, 2)))
+	case 1:
+		return strings.Repeat(" ", indent) + pick(w.tc, []string{" ", "\t", "   "})
+	case 2:
+		return strings.Repeat("\t", indent)
+	default:
+		return strings.Repeat(" ", indent)
+	}
+}
+
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
+
+// ---- numbers and keywords
+
+// number writes a number and returns its value; exponents stay small enough to be finite.
+func (w *hjWriter) number() float64 {
+	var text string
+	switch drawInt(w.tc, 0, 4) {
+	case 0:
+		text = strconv.Itoa(drawInt(w.tc, -1000, 1000))
+	case 1:
+		text = fmt.Sprintf("%d.%d", drawInt(w.tc, -99, 99), drawInt(w.tc, 0, 999))
+	case 2:
+		text = fmt.Sprintf("%d%s%s%d", drawInt(w.tc, -9, 9), pick(w.tc, []string{"e", "E"}), pick(w.tc, []string{"", "+", "-"}), drawInt(w.tc, 0, 300))
+	case 3:
+		text = fmt.Sprintf("%d.%d%s%d", drawInt(w.tc, 0, 9), drawInt(w.tc, 0, 99), pick(w.tc, []string{"e", "E"}), drawInt(w.tc, -300, 300))
+	default:
+		text = pick(w.tc, []string{"0", "-0", "0.0", "-0.5", "1e0", "123456789012345678901234567890", "0.000001", "9E9"})
+	}
+	f, err := strconv.ParseFloat(text, 64)
+	if err != nil {
+		panic("hjWriter: bad number " + text)
+	}
+	w.write(text)
+	w.term, w.toEOL = true, false
+	return f
+}
+
+func (w *hjWriter) keyword() interface{} {
+	switch drawInt(w.tc, 0, 2) {
+	case 0:
+		w.write("true")
+		w.term, w.toEOL = true, false
+		return true
+	case 1:
+		w.write("false")
+		w.term, w.toEOL = true, false
+		return false
+	}
+	w.write("null")
+	w.term, w.toEOL = true, false
+	return nil
+}
+
+// ---- keys
+
+var keyAtoms = []string{"a", "b", "key", "Key", "1", "-", "_", ".", "/", "#", "*", "true", "é", "😀", "x-y", "$", "@", "!", "%", "=", "?", "~", "|", ";", "<", ">", "(", ")", "+", "\\", "&"}
+
+// key writes an object key and returns it.
+func (w *hjWriter) key() string {
+	w.resetFlags()
+	if chance(w.tc, 35) {
+		var sb strings.Builder
+		for n := drawInt(w.tc, 0, 3); n > 0; n-- {
+			sb.WriteString(pick(w.tc, stringAtoms))
+		}
+		return w.quoted(sb.String(), chance(w.tc, 30))
+	}
+	for {
+		var sb strings.Builder
+		for n := drawInt(w.tc, 1, 3); n > 0; n-- {
+			sb.WriteString(pick(w.tc, keyAtoms))
+		}
+		k := sb.String()
+		// A quoteless key: no blank, punctuator or quote; it must not start a comment.
+		if strings.ContainsAny(k, " \t\n\r{}[],:\"'") || k[0] == '#' || strings.HasPrefix(k, "//") || strings.HasPrefix(k, "/*") {
+			continue
+		}
+		w.write(k)
+		w.term, w.toEOL = false, false
+		return k
+	}
+}
+
+// ---- values
+
+func (w *hjWriter) value(depth int) interface{} {
+	top := 7
+	if depth <= 0 {
+		top = 5
+	}
+	switch drawInt(w.tc, 0, top) {
+	case 0:
+		return w.keyword()
+	case 1:
+		return w.number()
+	case 2:
+		return w.quoteless()
+	case 3:
+		return w.noteString(w.quoted(genString(w.tc), chance(w.tc, 30)))
+	case 4:
+		return w.noteString(w.multiline())
+	case 5:
+		return w.quoteless()
+	case 6:
+		return w.array(depth - 1)
+	default:
+		return w.object(depth-1, true)
+	}
+}
+
+func (w *hjWriter) array(depth int) []interface{} {
+	w.write("[")
+	w.term, w.toEOL = false, false
+	w.resetFlags()
+	out := []interface{}{}
+	n := drawInt(w.tc, 0, 4)
+	w.ws(true)
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			w.sep()
+		}
+		out = append(out, w.value(depth))
+	}
+	w.closing("]", n > 0)
+	return out
+}
+
+// object writes an object (with braces, or the braceless root) and returns it as an
+// OrderedMap in first-occurrence key order with the last value of a duplicated key.
+func (w *hjWriter) object(depth int, braces bool) *hjson.OrderedMap {
+	om := hjson.NewOrderedMap()
+	if braces {
+		w.write("{")
+		w.term, w.toEOL = false, false
+		w.ws(true)
+	}
+	n := drawInt(w.tc, 0, 4)
+	if !braces && n == 0 {
+		n = 1
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			w.sep()
+		}
+		k := w.key()
+		if _, exists := om.Map[k]; exists {
+			w.dupes = true
+		}
+		quotedKey := w.sb.String()[w.sb.Len()-1] == '"' || w.sb.String()[w.sb.Len()-1] == '\''
+		w.ws(quotedKey) // comments between a quoteless key and its colon are not allowed
+		w.write(":")
+		w.term, w.toEOL = false, false
+		w.ws(true)
+		om.Set(k, w.value(depth))
+	}
+	if braces {
+		w.closing("}", n > 0)
+	}
+	return om
+}
+
+// document writes a whole document and returns its value.
+func (w *hjWriter) document() interface{} {
+	w.resetFlags()
+	w.ws(true)
+	var v interface{}
+	switch drawInt(w.tc, 0, 5) {
+	case 0:
+		v = w.object(2, false)
+	case 1:
+		v = w.object(2, true)
+	case 2:
+		v = w.array(2)
+	case 3:
+		v = w.number()
+	case 4:
+		v = w.noteString(w.quoted(genString(w.tc), chance(w.tc, 30)))
+	default:
+		v = w.keyword()
+	}
+	if chance(w.tc, 50) {
+		before := w.sb.Len()
+		w.ws(true)
+		w.rootTrail = w.sb.Len() > before
+	}
+	return v
+}
+
+// TestHegelParse: a generated Hjson document decodes (into interface{} and into a Node) to the
+// value the Hjson syntax gives it.
+func TestHegelParse(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		w := &hjWriter{tc: ht}
+		want := w.document()
+		text := w.sb.String()
+		if w.dupes {
+			c.count("duplicate keys")
+		}
+		if w.surrog {
+			c.count("surrogate pairs")
+		}
+		wantCanon := canon(want)
+
+		var hv interface{}
+		if err := hjson.Unmarshal([]byte(text), &hv); err != nil {
+			c.failClass(ht, "error", "Unmarshal: %v\n%q", err, show(text))
+			return
+		}
+		if got := canon(hv); got != wantCanon {
+			c.failClass(ht, "value", "Unmarshal %q\n  got  %s\n  want %s", show(text), show(got), show(wantCanon))
+			return
+		}
+
+		wantOrdered := ordered(want)
+		var node hjson.Node
+		if err := hjson.Unmarshal([]byte(text), &node); err != nil {
+			c.failClass(ht, "node error", "into Node: %v\n%q", err, show(text))
+		} else if got := ordered(&node); got != wantOrdered {
+			c.failClass(ht, "node", "into Node %q\n  got  %s\n  want %s", show(text), show(got), show(wantOrdered))
+		}
+	})
+}
