+// hjson/15: the keys of a map with TextMarshaler keys are written in the order of their texts.
+func TestHegelPinTextMarshalerKeyOrder(t *testing.T) {
+	text, err := hjson.Marshal(map[intKey]int{1: 1, 2: 2}) // 1 marshals to z, 2 to a
+	if err != nil {
+		t.Fatal(err)
