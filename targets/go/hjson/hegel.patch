+	}
+}
+
+// hjson/14: a quoteless number for a TextUnmarshaler slice element is a string, as for a
+// TextUnmarshaler struct field.
+func TestHegelPinTextUnmarshalerElement(t *testing.T) {
+	var field struct{ T textVal }
+	if err := hjson.Unmarshal([]byte("T: 123"), &field); err != nil || field.T.S != "T:123" {
+		t.Fatalf("field: %v %+v", err, field)
