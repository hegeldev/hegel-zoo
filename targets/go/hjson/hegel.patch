+		opts.Comments = true
+		opts.Eol = tcase.eol
+		b, err := hjson.MarshalWithOptions(v.Interface(), opts)
+		if err != nil {
+			c.fail(ht, "Marshal: %v", err)
+			return
+		}
+		back := reflect.New(typ)
+		shape := known("hjson/7")
+		if err := hjson.Unmarshal(b, back.Interface()); err != nil {
+			c.mismatch(ht, "reject", shape, "Unmarshal rejects Marshal's output: %v\n%q", err, show(string(b)))
+			return
+		}
+		if !reflect.DeepEqual(back.Elem().Interface(), v.Elem().Interface()) {
+			c.mismatch(ht, "value", shape, "typed round trip differs\n  want %+v\n  got  %+v\n  text %q", v.Elem().Interface(), back.Elem().Interface(), show(string(b)))
+		}
+	})
+}
