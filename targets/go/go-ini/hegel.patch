+// ---- key helpers ---------------------------------------------------------------------------
+
+// splitModel is Key.Strings as documented by the tests: the delimiter splits, "\<delim>" is a
+// literal delimiter, "\\" a backslash, any other backslash stays, parts are trimmed.
+func splitModel(s, delim string) []string {
+	if s == "" {
+		return []string{}
+	}
+	var parts []string
+	var cur strings.Builder
+	for i := 0; i < len(s); {
+		switch {
+		case s[i] == '\\' && i+1 < len(s) && strings.HasPrefix(s[i+1:], delim):
+			cur.WriteString(delim)
+			i += 1 + len(delim)
+		case s[i] == '\\' && i+1 < len(s) && s[i+1] == '\\':
+			cur.WriteByte('\\')
+			i += 2
+		case strings.HasPrefix(s[i:], delim):
+			parts = append(parts, strings.TrimSpace(cur.String()))
+			cur.Reset()
+			i += len(delim)
+		default:
+			cur.WriteByte(s[i])
+			i++
+		}
+	}
+	parts = append(parts, strings.TrimSpace(cur.String()))
+	return parts
+}
+
+var boolWords = map[string]bool{"1": true, "t": true, "T": true, "true": true, "TRUE": true, "True": true, "YES": true, "yes": true, "Yes": true, "y": true, "ON": true, "on": true, "On": true,
+	"0": false, "f": false, "F": false, "false": false, "FALSE": false, "False": false, "NO": false, "no": false, "No": false, "n": false, "OFF": false, "off": false, "Off": false}
+
+// TestHegelKeyHelpersFollowTheirDocs: Strings(delim) against the split model (values that
+// start or end with the delimiter or end with a backslash are go-ini/6), Bool against the
+// documented word list, Int/Int64/Uint64/Float64 against strconv, Ints/ValidInts/StrictInts
+// against the parts, MustInt/MustString defaults, In and RangeInt.
+func TestHegelKeyHelpersFollowTheirDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := Empty().Section("").Key("k")
+		delim := pick(ht, []string{",", "::", "|"})
+		var v string
+		for {
+			v = text(ht, "ab 1\\,:|日", 0, 8)
+			if strings.HasPrefix(v, delim) || strings.HasSuffix(v, delim) || strings.HasSuffix(v, `\`) || strings.HasPrefix(strings.TrimSpace(v), delim) || strings.HasSuffix(strings.TrimSpace(v), delim) {
+				continue
+			}
+			if v == "" || !strings.Contains(v, "%") {
+				break
+			}
+		}
+		k.SetValue(v)
+		note(ht, "value %q delim %q", v, delim)
+		if got, want := k.Strings(delim), splitModel(v, delim); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Strings(%q) of %q = %q, want %q", delim, v, got, want)
+		}
+
+		word := pick(ht, []string{"1", "t", "yes", "On", "0", "F", "no", "Off", "TRUE", "false", "y", "n", "2", "yeah", "", "True ", "on\n", "nope", "ok"})
+		k.SetValue(word)
+		b, err := k.Bool()
+		want, ok := boolWords[word]
+		if ok != (err == nil) || (ok && b != want) {
+			ht.Fatalf("Bool() of %q = %v, %v; want %v (accepted %v)", word, b, err, want, ok)
+		}
+		if got := k.MustBool(true); got != (ok && want || !ok) {
+			ht.Fatalf("MustBool(true) of %q = %v", word, got)
+		}
+
+		num := pick(ht, []string{"0", "42", "-7", "9223372036854775807", "9223372036854775808", "18446744073709551615", "1e3", "3.5", "0x10", " 5", "5 ", "+5", "1_000", "", "abc", "-1", "٣"})
+		k.SetValue(num)
+		// The integer getters use base 0 (0x, 0o, 0b prefixes and underscores accepted).
+		if got, err := k.Int(); (err == nil) != (strconvErr(strconv.ParseInt(num, 0, 64)) == nil) || err == nil && int64(got) != must(strconv.ParseInt(num, 0, 64)) {
+			ht.Fatalf("Int() of %q = %d, %v", num, got, err)
+		}
+		if got, err := k.Int64(); (err == nil) != (strconvErr(strconv.ParseInt(num, 0, 64)) == nil) || err == nil && got != must(strconv.ParseInt(num, 0, 64)) {
+			ht.Fatalf("Int64() of %q = %d, %v", num, got, err)
+		}
+		if got, err := k.Uint64(); (err == nil) != (strconvErr(strconv.ParseUint(num, 0, 64)) == nil) || err == nil && got != must(strconv.ParseUint(num, 0, 64)) {
+			ht.Fatalf("Uint64() of %q = %d, %v", num, got, err)
+		}
+		if got, err := k.Float64(); (err == nil) != (strconvErr(strconv.ParseFloat(num, 64)) == nil) || err == nil && got != must(strconv.ParseFloat(num, 64)) {
+			ht.Fatalf("Float64() of %q = %v, %v", num, got, err)
+		}
+		if _, err := strconv.ParseInt(num, 0, 64); err != nil {
+			if got := k.MustInt(17); got != 17 {
+				ht.Fatalf("MustInt(17) of %q = %d", num, got)
+			}
+		}
+
+		// Lists of integers.
+		parts := make([]string, n(ht, 1, 4))
+		valid := []int{}
+		allValid := true
+		for i := range parts {
+			parts[i] = pick(ht, []string{"1", "22", "-3", "x", "4.5", "", "007"})
+			if parts[i] == "" && (i == 0 || i == len(parts)-1) {
+				parts[i] = "5" // an empty first/last part is Strings()' go-ini/6 shape
+			}
+			if v, err := strconv.Atoi(parts[i]); err == nil {
+				valid = append(valid, v)
+			} else {
+				allValid = false
+			}
+		}
+		list := strings.Join(parts, ",")
+		k.SetValue(list)
+		if got := k.ValidInts(","); !reflect.DeepEqual(got, valid) {
+			ht.Fatalf("ValidInts of %q = %v, want %v", list, got, valid)
+		}
+		strict, err := k.StrictInts(",")
+		if allValid && (err != nil || !reflect.DeepEqual(strict, valid)) || !allValid && err == nil {
+			ht.Fatalf("StrictInts of %q = %v, %v; want %v (all valid %v)", list, strict, err, valid, allValid)
+		}
+		if got := k.Ints(","); len(got) != len(k.Strings(",")) {
+			ht.Fatalf("Ints of %q = %v: %d entries for %d parts", list, got, len(got), len(k.Strings(",")))
+		}
+
+		// In and RangeInt.
+		x := n(ht, -5, 15)
+		k.SetValue(strconv.Itoa(x))
+		lo, hi := n(ht, -5, 15), n(ht, -5, 15)
+		if lo > hi {
+			lo, hi = hi, lo
+		}
+		wantRange := 99
+		if lo <= x && x <= hi {
+			wantRange = x
+		}
+		if got := k.RangeInt(99, lo, hi); got != wantRange {
+			ht.Fatalf("RangeInt(99, %d, %d) of %d = %d, want %d", lo, hi, x, got, wantRange)
+		}
+		cands := []string{strconv.Itoa(n(ht, -5, 15)), strconv.Itoa(n(ht, -5, 15))}
+		wantIn := "d"
+		for _, c := range cands {
+			if c == strconv.Itoa(x) {
+				wantIn = c
+			}
+		}
+		if got := k.In("d", cands); got != wantIn {
+			ht.Fatalf("In(d, %v) of %d = %q, want %q", cands, x, got, wantIn)
+		}
+	})
+}
+
+func strconvErr[T any](_ T, err error) error { return err }
+
+func must[T any](v T, _ error) T { return v }
+
+// ---- interpolation -------------------------------------------------------------------------
+
+var refPattern = regexp.MustCompile(`%\(([^)]+)\)s`)
+
+// interpolate is Key.String() as documented: the first %(name)s is looked up in the key's
+// section, then the default section; a missing name stops the substitution and the value is
+// returned as it stands; a found name is replaced (every occurrence) by its own String().
+func interpolate(secs map[string]map[string]string, section, val string, depth int) string {
+	for i := 0; i < 99; i++ {
+		m := refPattern.FindStringSubmatch(val)
+		if m == nil {
+			break
+		}
+		refSection := section
+		ref, ok := secs[section][m[1]]
+		if !ok {
+			refSection = DefaultSection
+			ref, ok = secs[DefaultSection][m[1]]
+		}
+		if !ok {
+			break
+		}
+		// The referenced key's own String() resolves in its own section; what it leaves
+		// unresolved is then retried here, in this key's section.
+		val = strings.ReplaceAll(val, m[0], interpolate(secs, refSection, ref, depth+1))
+	}
+	return val
+}
+
+// TestHegelInterpolationFollowsTheModel: acyclic %(name)s references across the default and
+// one named section resolve as the model says (String(), Validate, StringsWithShadows);
+// Value() stays raw.
+func TestHegelInterpolationFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := Empty()
+		secs := map[string]map[string]string{DefaultSection: {}, "s": {}}
+		f.NewSection("s")
+		names := []string{"a", "b", "c", "d", "e"}
+		// Keys are defined in order; a value may only reference names already defined (in either
+		// section), which keeps the graph acyclic.
+		var defined []string
+		for i := 0; i < n(ht, 1, 5); i++ {
+			sec := pick(ht, []string{DefaultSection, "s"})
+			name := names[i] // each name defined once, so the references form a DAG
+			var sb strings.Builder
+			for j, k := 0, n(ht, 0, 3); j < k; j++ {
+				switch {
+				case len(defined) > 0 && chance(ht, 60):
+					sb.WriteString("%(" + pick(ht, defined) + ")s")
+				case chance(ht, 15):
+					sb.WriteString("%(" + pick(ht, []string{"nope", "", "x y"}) + ")s")
+				default:
+					sb.WriteString(text(ht, "xyz%() ", 1, 3))
+				}
+			}
+			val := sb.String()
+			if strings.Contains(val, "%("+name+")s") {
+				val = strings.ReplaceAll(val, "%("+name+")s", "self") // never self-referential
+			}
+			f.Section(sec).Key(name).SetValue(val)
+			secs[sec][name] = val
+			defined = append(defined, name)
+		}
+		note(ht, "sections %v", secs)
+		for sec, kv := range secs {
+			for name, raw := range kv {
+				k := f.Section(sec).Key(name)
+				want := interpolate(secs, sec, raw, 0)
+				if got := k.String(); got != want {
+					ht.Fatalf("[%s] %s = %q: String() = %q, want %q", sec, name, raw, got, want)
+				}
+				if k.Value() != raw {
+					ht.Fatalf("[%s] %s: Value() = %q, want the raw %q", sec, name, k.Value(), raw)
+				}
+				if got := k.Validate(strings.ToUpper); got != strings.ToUpper(want) {
+					ht.Fatalf("[%s] %s: Validate(ToUpper) = %q", sec, name, got)
+				}
+			}
+		}
+	})
+}
