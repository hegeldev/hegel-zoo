+// ---- the writer against the reader ---------------------------------------------------------
+
+const (
+	writerValueChars = "abc xyz019 #;=:%\"'`\\[]()\n\t日é"
+	writerKeyChars   = "abcXYZ019 _.-\"`=:%[]"
+	writerNameChars  = "abcXYZ019 _.-#;=[]`\""
+	// robustChars are the characters the writer quotes robustly (""" for a line feed or a
+	// backtick, backticks for a comment symbol).
+	robustChars = "\n`#;"
+)
+
+// robustValue: a text not starting with a quote with a robust character spliced in at at
+// modulo its length plus one (so it can be first, or last).
+type robustValue struct {
+	base string
+	at   int
+	sym  string
+}
+
+func (v robustValue) String() string {
+	rs := []rune(v.base)
+	i := v.at % (len(rs) + 1)
+	return string(rs[:i]) + v.sym + string(rs[i:])
+}
+
+var (
+	plainWriterChars = without(writerValueChars, robustChars)
+	// robustValues: a robust value; go-ini/2 also covers a value holding `"""` inside the
+	// writer's `"""` quotes (the reader closes the value at the inner one), so those are
+	// filtered out (about one in a thousand).
+	robustValues = hegel.Filter(hegel.Map(hegel.Composite(func(tc hegel.TestCase) robustValue {
+		return robustValue{
+			base: hegel.Draw(tc, cat(text(without(writerValueChars, "'\""), 1, 1), text(writerValueChars, 0, 8))),
+			at:   hegel.Draw(tc, positions),
+			sym:  hegel.Draw(tc, hegel.SampledFrom(strings.Split(robustChars, ""))),
+		}
+	}), robustValue.String), func(v string) bool { return !strings.Contains(v, `"""`) })
+	// writerValues: a value the writer can make readable: empty once in thirteen; a plain
+	// value (written raw or in plain double quotes) without the shapes of go-ini/2 - never
+	// starting with a quote, never ending with a backslash, and quotes only when no blank is
+	// at either end (drawn unpadded with quotes allowed, or from an alphabet without quotes);
+	// else a robust value, which the writer quotes robustly whatever its shape.
+	writerValues = weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{3, word(plainWriterChars, " \t'\"", " \t\\", 8)},
+		choice[string]{3, word(without(plainWriterChars, "'\""), "", "\\", 8)},
+		choice[string]{6, robustValues},
+	)
+	// writerKeys: a key the writer quotes correctly (go-ini/3 kept out): never starting with a
+	// blank or [ (# and ; are not in the alphabet), never ending with a blank, never "-", and
+	// never both a backtick and a quote or delimiter: drawn without backticks, or without
+	// quotes and delimiters.
+	writerKeys = hegel.Filter(hegel.OneOf(
+		word(without(writerKeyChars, "`"), " [", " ", 4),
+		word(without(writerKeyChars, "\"=:"), " [", " ", 4),
+	), func(k string) bool { return k != "-" })
+	// writerNames: a section name from a broad alphabet (which cannot spell DEFAULT).
+	writerNames = text(writerNameChars, 1, 6)
+)
+
+type writerKey struct{ name, value string }
+
+type writerSection struct {
+	name string
+	keys []writerKey
+}
+
+// writerCase: the four writer switches, the keys of the default section, the sections with
+// their keys, and the indent.
+type writerCase struct {
+	prettyFormat, prettyEqual, prettySection, defaultHeader bool
+	defaultKeys                                             []writerKey
+	sections                                                []writerSection
+	indent                                                  string
+}
+
+func keysText(ks []writerKey) string {
+	parts := make([]string, len(ks))
+	for i, k := range ks {
+		parts[i] = fmt.Sprintf("%q=%q", k.name, k.value)
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+func (c writerCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "PrettyFormat %v PrettyEqual %v PrettySection %v DefaultHeader %v indent %q; [] %s",
+		c.prettyFormat, c.prettyEqual, c.prettySection, c.defaultHeader, c.indent, keysText(c.defaultKeys))
+	for _, s := range c.sections {
+		fmt.Fprintf(&b, "; [%q] %s", s.name, keysText(s.keys))
+	}
+	return b.String()
+}
+
+// build is the File of the case: the sections in order, then the keys (a repeated section
+// name is the same section, a repeated key name the same key with the later value).
+func (c writerCase) build() (*File, error) {
+	f := Empty()
+	for _, s := range c.sections {
+		if _, err := f.NewSection(s.name); err != nil {
+			return nil, fmt.Errorf("NewSection(%q): %v", s.name, err)
+		}
+	}
+	for _, k := range c.defaultKeys {
+		if _, err := f.Section("").NewKey(k.name, k.value); err != nil {
+			return nil, fmt.Errorf("NewKey(%q): %v", k.name, err)
+		}
+	}
+	for _, s := range c.sections {
+		for _, k := range s.keys {
+			if _, err := f.Section(s.name).NewKey(k.name, k.value); err != nil {
+				return nil, fmt.Errorf("NewKey(%q): %v", k.name, err)
+			}
+		}
+	}
+	return f, nil
+}
+
+var (
+	writerKeyValues = hegel.Composite(func(tc hegel.TestCase) writerKey {
+		return writerKey{name: hegel.Draw(tc, writerKeys), value: hegel.Draw(tc, writerValues)}
+	})
+	writerSections = hegel.Composite(func(tc hegel.TestCase) writerSection {
+		return writerSection{name: hegel.Draw(tc, writerNames), keys: hegel.Draw(tc, many(writerKeyValues, 0, 4))}
+	})
+	writerCases = hegel.Composite(func(tc hegel.TestCase) writerCase {
+		return writerCase{
+			prettyFormat:  hegel.Draw(tc, hegel.Booleans()),
+			prettyEqual:   hegel.Draw(tc, hegel.Booleans()),
+			prettySection: hegel.Draw(tc, hegel.Booleans()),
+			defaultHeader: hegel.Draw(tc, hegel.Booleans()),
+			defaultKeys:   hegel.Draw(tc, many(writerKeyValues, 0, 4)),
+			sections:      hegel.Draw(tc, many(writerSections, 0, 3)),
+			indent:        hegel.Draw(tc, hegel.SampledFrom([]string{"", "  ", "\t"})),
+		}
+	})
+)
