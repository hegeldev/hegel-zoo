+// go-ini/6: Strings() drops an empty last element ("a," -> [a]) but keeps an empty first one
+// (",a" -> ["", a]), and drops a trailing backslash ("a\" -> [a]); "," alone is [""].
+func TestHegelStringsKeepsEmptyLastElement(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := pick(ht, []struct{ v, delim string }{{"a,", ","}, {",", ","}, {"a,b,", ","}, {"a::", "::"}, {`a\`, ","}})
+		k := Empty().Section("").Key("k")
+		k.SetValue(c.v)
+		got := k.Strings(c.delim)
+		if want := splitModel(c.v, c.delim); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Strings(%q) of %q = %q, want %q", c.delim, c.v, got, want)
+		}
+	})
+}
+
+// go-ini/7: with SpaceBeforeInlineComment, " ;" is only looked for when there is no " #" on
+// the line, so "a ;b #c" is "a ;b" (Python: "a").
+func TestHegelSpaceBeforeInlineCommentTakesTheFirstSymbol(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := pick(ht, []string{"k = a ;b #c\n", "k = a ; b # c\n", "k = x ;y z #\n"})
+		f, err := LoadSources(LoadOptions{SpaceBeforeInlineComment: true}, []byte(src))
+		if err != nil {
+			ht.Fatalf("%q: %v", src, err)
+		}
+		if v := f.Section("").Key("k").Value(); v != strings.TrimSpace(src[4:strings.Index(src, " ;")]) {
+			ht.Fatalf("%q: value %q, want the text before the first comment", src, v)
+		}
+	})
+}
