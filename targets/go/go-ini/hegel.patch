+		k.SetValue(strconv.Itoa(x))
+		wantRange := 99
+		if lo <= x && x <= hi {
+			wantRange = x
+		}
+		if got := k.RangeInt(99, lo, hi); got != wantRange {
+			ht.Fatalf("RangeInt(99, %d, %d) of %d = %d, want %d", lo, hi, x, got, wantRange)
+		}
+		cands := []string{strconv.Itoa(c.cands[0]), strconv.Itoa(c.cands[1])}
+		wantIn := "d"
+		for _, cand := range cands {
+			if cand == strconv.Itoa(x) {
+				wantIn = cand
+			}
+		}
+		if got := k.In("d", cands); got != wantIn {
+			ht.Fatalf("In(d, %v) of %d = %q, want %q", cands, x, got, wantIn)
+		}
+	})
+}
+
+func strconvErr[T any](_ T, err error) error { return err }
+
+func must[T any](v T, _ error) T { return v }
+
+// ---- interpolation -------------------------------------------------------------------------
+
+var refPattern = regexp.MustCompile(`%\(([^)]+)\)s`)
+
+// interpolate is Key.String() as documented: the first %(name)s is looked up in the key's
+// section, then the default section; a missing name stops the substitution and the value is
+// returned as it stands; a found name is replaced (every occurrence) by its own String().
+func interpolate(secs map[string]map[string]string, section, val string, depth int) string {
+	for i := 0; i < 99; i++ {
+		m := refPattern.FindStringSubmatch(val)
+		if m == nil {
+			break
+		}
+		refSection := section
+		ref, ok := secs[section][m[1]]
+		if !ok {
+			refSection = DefaultSection
+			ref, ok = secs[DefaultSection][m[1]]
+		}
+		if !ok {
+			break
+		}
+		// The referenced key's own String() resolves in its own section; what it leaves
+		// unresolved is then retried here, in this key's section.
+		val = strings.ReplaceAll(val, m[0], interpolate(secs, refSection, ref, depth+1))
+	}
+	return val
+}
+
+type pieceKind int
+
+const (
+	pieceText   pieceKind = iota // literal text
+	pieceBadRef                  // a reference to a name no key has
+	pieceRef                     // a reference to the at-th (modulo their number) key defined before this one
+)
+
+// piece is a part of an interpolation value. A reference to an earlier key keeps the
+// references acyclic (each name is defined once, in order, and the first key draws no
+// references).
+type piece struct {
+	kind pieceKind
+	text string
+	at   int
+}
+
+func (p piece) render(defined []string) string {
+	switch p.kind {
+	case pieceBadRef:
+		return "%(" + p.text + ")s"
+	case pieceRef:
+		return "%(" + defined[p.at%len(defined)] + ")s"
+	}
+	return p.text
+}
+
+var (
+	textPieces = hegel.Map(text("xyz%() ", 1, 3), func(s string) piece { return piece{kind: pieceText, text: s} })
+	badPieces  = hegel.Map(hegel.SampledFrom([]string{"nope", "", "x y"}), func(s string) piece { return piece{kind: pieceBadRef, text: s} })
+	// firstPieces: for the first key, literal text or (three times in twenty) a bad reference;
+	// laterPieces: literal text once in three, a bad reference three times in fifty, a
+	// reference to an earlier key three times in five.
+	firstPieces = weighted(choice[piece]{85, textPieces}, choice[piece]{15, badPieces})
+	laterPieces = weighted(
+		choice[piece]{34, textPieces},
+		choice[piece]{6, badPieces},
+		choice[piece]{60, hegel.Map(positions, func(i int) piece { return piece{kind: pieceRef, at: i} })},
+	)
+)
+
+// interpKey: the section of a key and the pieces of its value; the keys are named a, b, c,
+// d, e in order of definition.
+type interpKey struct {
+	section string
+	pieces  []piece
+}
+
+func interpKeys(pieces hegel.Generator[piece]) hegel.Generator[interpKey] {
+	return hegel.Composite(func(tc hegel.TestCase) interpKey {
+		return interpKey{section: hegel.Draw(tc, hegel.SampledFrom([]string{DefaultSection, "s"})), pieces: hegel.Draw(tc, many(pieces, 0, 3))}
+	})
+}
+
+var interpNames = []string{"a", "b", "c", "d", "e"}
+
+// interpCase: the first key and up to four more.
+type interpCase struct {
+	first interpKey
+	rest  []interpKey
+}
+
+// values is the raw value of every key by section.
+func (c interpCase) values() map[string]map[string]string {
+	secs := map[string]map[string]string{DefaultSection: {}, "s": {}}
+	for i, k := range append([]interpKey{c.first}, c.rest...) {
+		var b strings.Builder
+		for _, p := range k.pieces {
+			b.WriteString(p.render(interpNames[:i]))
+		}
+		secs[k.section][interpNames[i]] = b.String()
+	}
+	return secs
+}
+
+func (c interpCase) GoString() string { return fmt.Sprintf("sections %v", c.values()) }
+
+var interpCases = hegel.Composite(func(tc hegel.TestCase) interpCase {
+	return interpCase{first: hegel.Draw(tc, interpKeys(firstPieces)), rest: hegel.Draw(tc, many(interpKeys(laterPieces), 0, 4))}
+})
+
+// TestHegelInterpolationFollowsTheModel: acyclic %(name)s references across the default and
+// one named section resolve as the model says (String(), Validate, StringsWithShadows);
+// Value() stays raw.
+func TestHegelInterpolationFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		secs := hegel.Draw(ht, interpCases).values()
+		f := Empty()
+		f.NewSection("s")
+		for sec, kv := range secs {
+			for name, val := range kv {
+				f.Section(sec).Key(name).SetValue(val)
+			}
+		}
+		for sec, kv := range secs {
+			for name, raw := range kv {
+				k := f.Section(sec).Key(name)
+				want := interpolate(secs, sec, raw, 0)
+				if got := k.String(); got != want {
+					ht.Fatalf("[%s] %s = %q: String() = %q, want %q", sec, name, raw, got, want)
+				}
+				if k.Value() != raw {
+					ht.Fatalf("[%s] %s: Value() = %q, want the raw %q", sec, name, k.Value(), raw)
+				}
+				if got := k.Validate(strings.ToUpper); got != strings.ToUpper(want) {
+					ht.Fatalf("[%s] %s: Validate(ToUpper) = %q", sec, name, got)
+				}
+			}
+		}
+	})
+}
+
+// ---- pinned bugs ---------------------------------------------------------------------------
+
+// go-ini/1: two keys whose values reference each other (%(a)s <-> %(b)s) make String()
+// recurse without bound: a fatal stack overflow, which no recover can catch. The check runs
+// the call in a child process (this same test binary with HEGEL_INI_LOOP=1).
+func TestHegelInterpolationCycleDoesNotCrash(t *testing.T) {
+	if os.Getenv("HEGEL_INI_LOOP") == "1" {
+		debug.SetMaxStack(16 << 20)
+		f := Empty()
+		s := f.Section("s")
+		s.Key("a").SetValue("%(b)s")
+		s.Key("b").SetValue("%(a)s")
+		fmt.Println(s.Key("a").String())
+		return
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestHegelInterpolationCycleDoesNotCrash$", "-test.count=1")
+		cmd.Env = append(os.Environ(), "HEGEL_INI_LOOP=1")
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			var lines []string
+			for _, l := range strings.Split(string(out), "\n") {
+				if strings.Contains(l, "fatal error") || strings.Contains(l, "stack exceeds") {
+					lines = append(lines, l)
+				}
+			}
+			ht.Fatalf("String() on a=%%(b)s, b=%%(a)s killed the process (%v): %s", err, strings.Join(lines, "; "))
+		}
+	}, hegel.WithTestCases(1))
+}
+
+// go-ini/2: values the writer leaves raw or wraps in plain double quotes do not read back: a
+// value that starts (and ends) with a quote loses its quotes, a trailing backslash becomes a
+// continuation, `"""` is an unterminated quote, a padded value containing a quote keeps the
+// added quotes.
+func TestHegelWrittenValuesReadBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		val := hegel.Draw(ht, hegel.SampledFrom([]string{"'abc'", `"abc"`, `abc\`, `\`, `"""`, ` x"`, `"a" "b"`, `''`}))
+		f := Empty()
+		f.Section("s").Key("k").SetValue(val)
+		var buf bytes.Buffer
+		f.WriteTo(&buf)
+		g, err := Load(buf.Bytes())
+		if err != nil {
+			ht.Fatalf("value %q written as %q does not read back: %v", val, buf.String(), err)
+		}
+		if got := g.Section("s").Key("k").Value(); got != val {
+			ht.Fatalf("value %q written as %q reads back as %q", val, buf.String(), got)
+		}
+	})
+}
+
+// nameCase: a section and a key of go-ini/3's shapes, one of them plain.
+type nameCase struct{ sec, key string }
+
+var nameCases = hegel.OneOf(
+	hegel.Map(hegel.SampledFrom([]string{"#k", ";k", "[k", "-", " k ", "k\nx", "a`b\"c", "a`b=c"}), func(k string) nameCase { return nameCase{"s", k} }),
+	hegel.Map(hegel.SampledFrom([]string{"a\nb", "a\rb"}), func(s string) nameCase { return nameCase{s, "k"} }),
+)
+
+// go-ini/3: keys that start with a comment symbol or "[", the key "-", keys with surrounding
+// blanks or a line feed, keys containing both a backtick and a quote or delimiter, and section
+// names containing a line feed are written in a form the reader does not accept.
+func TestHegelWrittenNamesReadBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nameCases)
+		sec, key := c.sec, c.key
+		f := Empty()
+		if _, err := f.NewSection(sec); err != nil {
+			ht.Fatalf("NewSection(%q): %v", sec, err)
+		}
+		if _, err := f.Section(sec).NewKey(key, "v"); err != nil {
+			ht.Fatalf("NewKey(%q): %v", key, err)
+		}
+		var buf bytes.Buffer
+		f.WriteTo(&buf)
+		g, err := Load(buf.Bytes())
+		if err != nil {
+			ht.Fatalf("[%q] %q written as %q does not read back: %v", sec, key, buf.String(), err)
+		}
+		if !g.Section(sec).HasKey(key) || g.Section(sec).Key(key).Value() != "v" {
+			ht.Fatalf("[%q] %q written as %q reads back as sections %v", sec, key, buf.String(), goSections(g))
+		}
+	})
+}
+
+// go-ini/4: with AllowPythonMultilineValues, a first line in quotes ends the value before the
+// Python-style check, so the indented continuation is a "key-value delimiter not found" error
+// (Python: the value continues).
+func TestHegelPythonMultilineAfterQuotedFirstLine(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, hegel.SampledFrom([]string{"k = 'a'\n  b\n", "k = \"a\"\n  b\n", "[s]\nk = 'a b'\n\tc\n\td\n"}))
+		f, err := LoadSources(LoadOptions{AllowPythonMultilineValues: true}, []byte(src))
+		if err != nil {
+			ht.Fatalf("%q: %v", src, err)
+		}
+		if v := f.Section(f.SectionStrings()[len(f.SectionStrings())-1]).Key("k").Value(); !strings.Contains(v, "\n") {
+			ht.Fatalf("%q: value %q has no continuation", src, v)
+		}
+	})
+}
+
+// go-ini/5: SpaceBeforeInlineComment (documented after Python: a comment "preceded by a
+// whitespace character") recognises only a space inside the trimmed value, so "k = a<TAB># c"
+// and "k = # c" (the comment right after the delimiter) keep the comment.
+func TestHegelSpaceBeforeInlineCommentAcceptsTab(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, hegel.SampledFrom([]string{"k = a\t# c\n", "k = a\t; c\n", "k = a b\t\t#c\n", "k = # c\n", "k= ; c\n"}))
+		f, err := LoadSources(LoadOptions{SpaceBeforeInlineComment: true}, []byte(src))
+		if err != nil {
+			ht.Fatalf("%q: %v", src, err)
+		}
+		if v := f.Section("").Key("k").Value(); strings.ContainsAny(v, "#;") {
+			ht.Fatalf("%q: value %q keeps the comment", src, v)
+		}
+	})
+}
+
+// go-ini/6: Strings() drops an empty last element ("a," -> [a]) but keeps an empty first one
+// (",a" -> ["", a]), and drops a trailing backslash ("a\" -> [a]); "," alone is [""].
+func TestHegelStringsKeepsEmptyLastElement(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom([]struct{ v, delim string }{{"a,", ","}, {",", ","}, {"a,b,", ","}, {"a::", "::"}, {`a\`, ","}}))
+		k := Empty().Section("").Key("k")
+		k.SetValue(c.v)
+		got := k.Strings(c.delim)
+		if want := splitModel(c.v, c.delim); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Strings(%q) of %q = %q, want %q", c.delim, c.v, got, want)
+		}
+	})
+}
+
+// go-ini/9: Strings with a multi-character delimiter drops the backslash of an escaped
+// delimiter but consumes only its first character, so `a\:::b` with "::" is [a: b], not [a:::b].
+func TestHegelPinStringsEscapesTheWholeMultiCharDelimiter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom([]struct {
+			v, delim string
+			want     []string
+		}{{`a\:::b`, "::", []string{"a:::b"}}, {`\:::1`, "::", []string{":::1"}}, {`\|||1`, "||", []string{"|||1"}}}))
+		k := Empty().Section("").Key("k")
+		k.SetValue(c.v)
+		if got := k.Strings(c.delim); !reflect.DeepEqual(got, c.want) {
+			ht.Fatalf("Strings(%q) of %q = %q, want %q", c.delim, c.v, got, c.want)
+		}
+	})
+}
+
+// go-ini/7: with SpaceBeforeInlineComment, " ;" is only looked for when there is no " #" on
+// the line, so "a ;b #c" is "a ;b" (Python: "a").
+func TestHegelSpaceBeforeInlineCommentTakesTheFirstSymbol(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, hegel.SampledFrom([]string{"k = a ;b #c\n", "k = a ; b # c\n", "k = x ;y z #\n"}))
+		f, err := LoadSources(LoadOptions{SpaceBeforeInlineComment: true}, []byte(src))
+		if err != nil {
+			ht.Fatalf("%q: %v", src, err)
+		}
+		if v := f.Section("").Key("k").Value(); v != strings.TrimSpace(src[4:strings.Index(src, " ;")]) {
+			ht.Fatalf("%q: value %q, want the text before the first comment", src, v)
+		}
+	})
+}
+
+// go-ini/8: UnescapeValueCommentSymbols ("unescape \# and \; inside value") never sees the
+// escaped symbol: the inline comment is cut first, so "a\;b" is `a\`.
+func TestHegelUnescapeValueCommentSymbols(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.SampledFrom([]struct{ src, want string }{{`k = a\;b`, "a;b"}, {`k = a\#b`, "a#b"}, {`k = \#x \; y`, "#x ; y"}}))
+		f, err := LoadSources(LoadOptions{UnescapeValueCommentSymbols: true}, []byte(c.src+"\n"))
+		if err != nil {
+			ht.Fatalf("%q: %v", c.src, err)
+		}
+		if v := f.Section("").Key("k").Value(); v != c.want {
+			ht.Fatalf("%q: value %q, want %q", c.src, v, c.want)
+		}
+	})
+}
