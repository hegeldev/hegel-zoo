+		parts: hegel.Draw(tc, intLists),
+		x:     hegel.Draw(tc, smallInts),
+		lo:    hegel.Draw(tc, smallInts),
+		hi:    hegel.Draw(tc, smallInts),
+		cands: [2]int{hegel.Draw(tc, smallInts), hegel.Draw(tc, smallInts)},
