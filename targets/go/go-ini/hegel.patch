+// Hegel property tests for gopkg.in/ini.v1 (go-ini/ini): the parser against Python's
+// configparser on the grammar both read the same way, the writer against the reader, the
+// key helpers and %(name)s interpolation against models, and pinned bugs.
+//
+// Every property draws one case record from generators that are package-level values (the
+// parse grammar is built once per option mode, so the mode decides which alternatives exist)
+// and renders it with pure functions; the records carry a GoString for the draw report.
+package ini_test
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	. "gopkg.in/ini.v1"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// text is a string of lo to hi runes of the pool (a set: repetition does not weight).
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// cat is the concatenation of independent string draws.
+func cat(gs ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var b strings.Builder
+		for _, g := range gs {
+			b.WriteString(hegel.Draw(tc, g))
+		}
+		return b.String()
+	})
+}
+
+// without is the pool less the runes of drop.
+func without(pool, drop string) string {
+	return strings.Map(func(r rune) rune {
+		if strings.ContainsRune(drop, r) {
+			return -1
+		}
+		return r
+	}, pool)
+}
+
+// word is a string of the pool of one rune that is in neither dropFirst nor dropLast, or of a
+// rune not in dropFirst, up to n runes of the pool and a rune not in dropLast: how edge shapes
+// (a leading quote, a trailing backslash) are kept out of a string by construction.
+func word(pool, dropFirst, dropLast string, n int) hegel.Generator[string] {
+	return hegel.OneOf(
+		text(without(pool, dropFirst+dropLast), 1, 1),
+		cat(text(without(pool, dropFirst), 1, 1), text(pool, 0, n), text(without(pool, dropLast), 1, 1)),
+	)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied.
+var positions = hegel.Integers(0, 99)
+
+// fileSeq numbers the files the properties write (a nonce, not case data).
+var fileSeq atomic.Int64
+
+// ---- the Python oracle ---------------------------------------------------------------------
+
+const pythonScript = `
+import sys, json, configparser
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        cp = configparser.ConfigParser(
+            interpolation=None, strict=False, allow_no_value=False,
+            delimiters=('=', ':'), comment_prefixes=('#', ';'),
+            inline_comment_prefixes=(('#', ';') if req['inline'] else None),
+            empty_lines_in_values=True)
+        cp.optionxform = str.lower if req['lower'] else str
+        cp.read_string('[DEFAULT]\n' + req['text'])
+        secs = {'DEFAULT': dict(cp.defaults())}
+        for s, kv in cp._sections.items():
+            secs[s] = dict(kv)
+        out = {'ok': True, 'sections': secs}
+    except Exception as e:
+        out = {'ok': False, 'error': repr(e)}
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+`
+
+type pyRequest struct {
+	Text   string `json:"text"`
+	Inline bool   `json:"inline"`
+	Lower  bool   `json:"lower"`
+}
+
+type pyResult struct {
+	OK       bool                         `json:"ok"`
+	Sections map[string]map[string]string `json:"sections"`
+	Error    string                       `json:"error"`
+}
+
+var python struct {
+	once sync.Once
+	mu   sync.Mutex
+	in   io.WriteCloser
+	out  *bufio.Reader
+	err  error
+}
+
+func pythonParse(t testing.TB, req pyRequest) pyResult {
+	python.once.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			python.err = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			python.err = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			python.err = err
+			return
+		}
+		python.in = in
+		python.out = bufio.NewReaderSize(out, 1<<20)
+	})
+	if python.err != nil {
+		t.Fatalf("starting python3: %v", python.err)
+	}
+	python.mu.Lock()
+	defer python.mu.Unlock()
+	b, _ := json.Marshal(req)
+	if _, err := python.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("writing to python3: %v", err)
+	}
+	line, err := python.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python3: %v", err)
+	}
+	var res pyResult
+	if err := json.Unmarshal(line, &res); err != nil {
+		t.Fatalf("python3 said %q: %v", line, err)
+	}
+	return res
+}
+
+// ---- the shared grammar --------------------------------------------------------------------
+
+type parseMode int
+
+const (
+	modeDefault parseMode = iota
+	modeSpaceBeforeComment
+	modeInsensitiveKeys
+	modeIgnoreInlineComment
+	modePythonMultiline
+)
+
+var modeNames = map[parseMode]string{modeDefault: "default", modeSpaceBeforeComment: "SpaceBeforeInlineComment", modeInsensitiveKeys: "InsensitiveKeys", modeIgnoreInlineComment: "IgnoreInlineComment", modePythonMultiline: "AllowPythonMultilineValues"}
+
+func (m parseMode) options() LoadOptions {
+	switch m {
+	case modeSpaceBeforeComment:
+		return LoadOptions{SpaceBeforeInlineComment: true}
+	case modeInsensitiveKeys:
+		return LoadOptions{InsensitiveKeys: true}
+	case modeIgnoreInlineComment:
+		return LoadOptions{IgnoreInlineComment: true}
+	case modePythonMultiline:
+		return LoadOptions{AllowPythonMultilineValues: true}
+	}
+	return LoadOptions{}
+}
+
+var modes = hegel.SampledFrom([]parseMode{modeDefault, modeSpaceBeforeComment, modeInsensitiveKeys, modeIgnoreInlineComment, modePythonMultiline})
+
+const (
+	nameChars  = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
+	keyChars   = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._- \"`]%()"
+	valueChars = "abcdefghijklmnopqrstuvwxyz0123456789 ,.=:%()[]'\"`\\/!éÑ日本-_"
+)
+
+var (
+	// sectionNames: 1-6 name characters, then one inner space and 1-3 more once in five; never
+	// DEFAULT (a header both sides accept, which headerNames draws on its own).
+	sectionNames = hegel.Filter(
+		cat(text(nameChars, 1, 6), maybe(20, cat(hegel.Just(" "), text(nameChars, 1, 3)))),
+		func(s string) bool { return !strings.EqualFold(s, "DEFAULT") })
+	// headerNames: a section name, or DEFAULT once in ten.
+	headerNames = weighted(choice[string]{9, sectionNames}, choice[string]{1, hegel.Just("DEFAULT")})
+	// keyNames: 1-6 key characters, never starting with a blank, a quote or a backtick (the
+	// alphabet has no [ # ; = :), never ending with a blank (both sides trim), never "-"
+	// (the auto-increment key).
+	keyNames = hegel.Filter(word(keyChars, " \"`", " ", 4), func(k string) bool { return k != "-" })
+	// valueBodies: a non-empty value both parsers read alike: 1-12 value characters, never
+	// starting with a blank, a quote, a backtick, # or ; (the alphabet has no comment symbol),
+	// never ending with a blank or a backslash (go-ini's continuation), never holding an
+	// interpolation reference.
+	valueBodies = hegel.Filter(word(valueChars, " '\"`", " \\", 10), func(v string) bool { return !strings.Contains(v, "%(") })
+	pads        = hegel.SampledFrom([]string{"", " ", "  "})
+	delims      = hegel.SampledFrom([]string{"=", ":"})
+	// inlineComments: " #" or " ;" (the space both sides need) and a tail, three times in ten.
+	inlineComments = maybe(30, cat(hegel.Just(" "), hegel.SampledFrom([]string{"#", ";"}), hegel.SampledFrom([]string{"", " c", " x=y", " [z]"})))
+	// headerTrailers: what follows a header's closing bracket once in five (both sides ignore it).
+	headerTrailers = maybe(20, hegel.SampledFrom([]string{" # c", " ; c", " junk", "#c"}))
+	commentTexts   = []string{"# comment", "; comment", "#", ";", "  # indented comment", "# k = v", "; [s]"}
+)
+
+// mark is a comment symbol spliced into a value after 1 + at modulo its length runes (never
+// first: it would start a comment).
+type mark struct {
+	at  int
+	sym string
+}
+
+func marks(syms []string) hegel.Generator[*mark] {
+	return hegel.Composite(func(tc hegel.TestCase) *mark {
+		return &mark{at: hegel.Draw(tc, positions), sym: hegel.Draw(tc, hegel.SampledFrom(syms))}
+	})
+}
+
+// splice puts the mark into v; with unspaced set only where no space touches it (else v as it
+// is: with SpaceBeforeInlineComment a symbol after a space is a comment).
+func (m *mark) splice(v string, unspaced bool) string {
+	if m == nil {
+		return v
+	}
+	rs := []rune(v)
+	i := 1 + m.at%len(rs)
+	if unspaced && (rs[i-1] == ' ' || i < len(rs) && rs[i] == ' ') {
+		return v
+	}
+	return string(rs[:i]) + m.sym + string(rs[i:])
+}
+
+// values is the value of a key line in the mode: empty once in ten, else a body with the
+// mode's mark: with IgnoreInlineComment a comment symbol (with a letter after it half of the
+// time) inside the value three times in ten; with SpaceBeforeInlineComment a symbol touching
+// no space, at most one so that go-ini's "# before ;" preference (go-ini/7) cannot show; none
+// in the other modes.
+func values(mode parseMode) hegel.Generator[string] {
+	ms := hegel.Just[*mark](nil)
+	switch mode {
+	case modeIgnoreInlineComment:
+		ms = maybe(30, marks([]string{"#", ";", "#c", ";c"}))
+	case modeSpaceBeforeComment:
+		ms = maybe(30, marks([]string{"#", ";"}))
+	}
+	unspaced := mode == modeSpaceBeforeComment
+	return weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{9, hegel.Map(pairs(valueBodies, ms), func(p pair[string, *mark]) string { return p.b.splice(p.a, unspaced) })},
+	)
+}
+
+// line is one line of a document: a key line (with its continuation lines) or a text line (a
+// comment or a blank); render gives it with the line ending.
+type line interface{ render(eol string) string }
+
+type textLine string
+
+func (l textLine) render(eol string) string { return string(l) + eol }
+
+// contLine is a Python-style continuation line: its indentation and its text.
+type contLine struct{ indent, text string }
+
+// keyLine: the key, the blanks around the delimiter, the delimiter, the value, an inline
+// comment ("" for none) and the continuation lines (AllowPythonMultilineValues only).
+type keyLine struct {
+	key, padL, delim, padR, value, comment string
+	conts                                  []contLine
+}
+
+func (k keyLine) render(eol string) string {
+	var b strings.Builder
+	b.WriteString(k.key + k.padL + k.delim + k.padR + k.value + k.comment + eol)
+	for _, c := range k.conts {
+		b.WriteString(c.indent + c.text + eol)
+	}
+	return b.String()
+}
+
+var contLines = hegel.Composite(func(tc hegel.TestCase) contLine {
+	return contLine{indent: hegel.Draw(tc, hegel.SampledFrom([]string{" ", "  ", "\t", "    "})), text: hegel.Draw(tc, valueBodies)}
+})
+
+// keyLines is a key line of the mode. The value is drawn first: with SpaceBeforeInlineComment
+// go-ini looks for " #" inside the trimmed value, so a comment right after the delimiter is
+// part of the value (go-ini/5), and a symbol of the value's own would move the cut, so a
+// comment needs a value without one. IgnoreInlineComment and AllowPythonMultilineValues have
+// no inline comments; the latter has 1-3 continuation lines after half of the key lines.
+func keyLines(mode parseMode) hegel.Generator[keyLine] {
+	comments := inlineComments
+	if mode == modeIgnoreInlineComment || mode == modePythonMultiline {
+		comments = hegel.Just("")
+	}
+	conts := hegel.Just[[]contLine](nil)
+	if mode == modePythonMultiline {
+		conts = maybe(50, many(contLines, 1, 3))
+	}
+	return hegel.FlatMap(values(mode), func(v string) hegel.Generator[keyLine] {
+		c := comments
+		if mode == modeSpaceBeforeComment && (v == "" || strings.ContainsAny(v, "#;")) {
+			c = hegel.Just("")
+		}
+		return hegel.Composite(func(tc hegel.TestCase) keyLine {
+			return keyLine{
+				key:     hegel.Draw(tc, keyNames),
+				padL:    hegel.Draw(tc, pads),
+				delim:   hegel.Draw(tc, delims),
+				padR:    hegel.Draw(tc, pads),
+				value:   v,
+				comment: hegel.Draw(tc, c),
+				conts:   hegel.Draw(tc, conts),
+			}
+		})
+	})
+}
+
+func asLine[T line](g hegel.Generator[T]) hegel.Generator[line] {
+	return hegel.Map(g, func(x T) line { return x })
+}
+
+func asTextLines(g hegel.Generator[string]) hegel.Generator[line] {
+	return hegel.Map(g, func(s string) line { return textLine(s) })
+}
+
+// lines is a line of the mode: a blank line once in eight, a comment line once, a key line
+// six times. With AllowPythonMultilineValues a whitespace-only line and an indented comment
+// are continuation text for go-ini (a blank and a comment for Python), so there the blanks are
+// empty and the comments start at the margin.
+func lines(mode parseMode) hegel.Generator[line] {
+	blanks := hegel.SampledFrom([]string{"", " ", "   "})
+	comments := commentTexts
+	if mode == modePythonMultiline {
+		blanks = hegel.Just("")
+		comments = make([]string, len(commentTexts))
+		for i, c := range commentTexts {
+			comments[i] = strings.TrimSpace(c)
+		}
+	}
+	return weighted(
+		choice[line]{1, asTextLines(blanks)},
+		choice[line]{1, asTextLines(hegel.SampledFrom(comments))},
+		choice[line]{6, asLine(keyLines(mode))},
+	)
+}
+
+// section: a header (its name and what follows the closing bracket) and its lines.
+type section struct {
+	name, trailer string
+	lines         []line
+}
+
+func (s section) render(eol string) string {
+	var b strings.Builder
+	b.WriteString("[" + s.name + "]" + s.trailer + eol)
+	for _, l := range s.lines {
+		b.WriteString(l.render(eol))
+	}
+	return b.String()
+}
+
+// iniDoc: the lines before the first header (the default section), the sections, the line
+// ending, and whether the last line ending is cut.
+type iniDoc struct {
+	eol      string
+	lead     []line
+	sections []section
+	cut      bool
+}
+
+func (d iniDoc) render() string {
+	var b strings.Builder
+	for _, l := range d.lead {
+		b.WriteString(l.render(d.eol))
+	}
+	for _, s := range d.sections {
+		b.WriteString(s.render(d.eol))
+	}
+	if d.cut {
+		return strings.TrimSuffix(b.String(), d.eol)
+	}
+	return b.String()
+}
+
+// docs is the grammar of the mode: LF, or CRLF once in five (never with
+// AllowPythonMultilineValues), up to three lines before the first header, up to three
+// sections of up to three lines each, the last line ending cut once in five.
+func docs(mode parseMode) hegel.Generator[iniDoc] {
+	eols := hegel.SampledFrom([]string{"\n", "\n", "\n", "\n", "\r\n"})
+	if mode == modePythonMultiline {
+		eols = hegel.Just("\n")
+	}
+	ls := lines(mode)
+	secs := hegel.Composite(func(tc hegel.TestCase) section {
+		return section{name: hegel.Draw(tc, headerNames), trailer: hegel.Draw(tc, headerTrailers), lines: hegel.Draw(tc, many(ls, 0, 3))}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) iniDoc {
+		return iniDoc{
+			eol:      hegel.Draw(tc, eols),
+			lead:     hegel.Draw(tc, many(ls, 0, 3)),
+			sections: hegel.Draw(tc, many(secs, 0, 3)),
+			cut:      hegel.Draw(tc, chance(20)),
+		}
+	})
+}
+
+// docsOf is the grammar of each mode, built once.
+var docsOf = func() map[parseMode]hegel.Generator[iniDoc] {
+	m := map[parseMode]hegel.Generator[iniDoc]{}
+	for mode := range modeNames {
+		m[mode] = docs(mode)
+	}
+	return m
+}()
+
+// parseCase: the option mode and a document of its grammar.
+type parseCase struct {
+	mode parseMode
+	doc  iniDoc
+}
+
+func (c parseCase) GoString() string {
+	return fmt.Sprintf("mode %s, text %q", modeNames[c.mode], c.doc.render())
+}
+
+var parseCases = hegel.FlatMap(modes, func(mode parseMode) hegel.Generator[parseCase] {
+	return hegel.Map(docsOf[mode], func(d iniDoc) parseCase { return parseCase{mode, d} })
+})
+
+// goSections reads a File back as name -> key -> value, in the shape the Python child returns.
+func goSections(f *File) map[string]map[string]string {
+	out := map[string]map[string]string{}
+	for _, s := range f.Sections() {
+		kv := map[string]string{}
+		for _, k := range s.Keys() {
+			kv[k.Name()] = k.Value()
+		}
+		out[s.Name()] = kv
+	}
+	return out
+}
+
+var continuationIndent = regexp.MustCompile(`\n[\t\f ]+`)
+
+// TestHegelParseAgreesWithPython: on INI text in the grammar both read alike, go-ini (default
+// options, SpaceBeforeInlineComment, InsensitiveKeys, IgnoreInlineComment or
+// AllowPythonMultilineValues) yields the same sections, keys and values as Python's
+// configparser (strict=False, no interpolation, matching inline-comment and option-casing
+// settings; sectionless keys are Python's DEFAULT section). go-ini keeps the indentation of
+// Python-style continuation lines (asserted upstream); it is stripped before comparing.
+func TestHegelParseAgreesWithPython(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		mode, src := c.mode, c.doc.render()
+		want := pythonParse(t, pyRequest{Text: src, Inline: mode != modeIgnoreInlineComment, Lower: mode == modeInsensitiveKeys})
+		if !want.OK {
+			ht.Fatalf("python rejected the generated text: %s", want.Error)
+		}
+		f, err := LoadSources(mode.options(), []byte(src))
+		if err != nil {
+			ht.Fatalf("go-ini: %v; python: %v", err, want.Sections)
+		}
+		got := goSections(f)
+		if mode == modePythonMultiline {
+			for _, kv := range got {
+				for k, v := range kv {
+					kv[k] = continuationIndent.ReplaceAllString(v, "\n")
+				}
+			}
+		}
+		if !reflect.DeepEqual(got, want.Sections) {
+			ht.Fatalf("go-ini %v\npython %v", got, want.Sections)
+		}
+	})
+}
