+// TestHegelEntryPointsAgree: the same text through []byte, a file, an io.Reader and an
+// io.ReadCloser, with or without a UTF-8 BOM, and two sources against their concatenation,
+// give the same sections; Empty() has just the default section.
+func TestHegelEntryPointsAgree(t *testing.T) {
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, entryCases)
+		src := c.src.render()
+		base, err := Load([]byte(src))
+		if err != nil {
+			ht.Fatalf("Load([]byte): %v", err)
+		}
+		want := goSections(base)
+		check := func(what string, f *File, err error) {
+			if err != nil {
+				ht.Fatalf("%s: %v", what, err)
+			}
+			if got := goSections(f); !reflect.DeepEqual(got, want) {
+				ht.Fatalf("%s: %v, want %v", what, got, want)
+			}
+			if !reflect.DeepEqual(f.SectionStrings(), base.SectionStrings()) {
+				ht.Fatalf("%s: section order %v, want %v", what, f.SectionStrings(), base.SectionStrings())
+			}
+		}
+		path := filepath.Join(dir, fmt.Sprintf("f%d.ini", fileSeq.Add(1)))
+		if err := os.WriteFile(path, []byte(src), 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		f, err := Load(path)
+		check("Load(file)", f, err)
+		f, err = Load(strings.NewReader(src))
+		check("Load(io.Reader)", f, err)
+		f, err = Load(io.NopCloser(bytes.NewReader([]byte(src))))
+		check("Load(io.ReadCloser)", f, err)
+		f, err = Load(append([]byte("\xef\xbb\xbf"), src...))
+		check("Load(BOM + text)", f, err)
+		f, err = LooseLoad([]byte(src), filepath.Join(dir, "missing.ini"))
+		check("LooseLoad(text, missing file)", f, err)
+
+		// Two sources are the concatenation (the first ends with a line break; every source
+		// starts in the default section, so the second opens with a header).
+		other := c.otherText()
+		a := src
+		if a != "" && !strings.HasSuffix(a, "\n") {
+			a += "\n"
+		}
+		joined, err := Load([]byte(a + other))
+		if err != nil {
+			ht.Fatalf("Load(a+b): %v", err)
+		}
+		two, err := Load([]byte(a), []byte(other))
+		if err != nil {
+			ht.Fatalf("Load(a, b): %v", err)
+		}
+		if !reflect.DeepEqual(goSections(two), goSections(joined)) {
+			ht.Fatalf("Load(a, b) %v, Load(a+b) %v", goSections(two), goSections(joined))
+		}
+		three := Empty()
+		if err := three.Append([]byte(a)); err != nil {
+			ht.Fatalf("Append: %v", err)
+		}
+		if err := three.Append([]byte(other)); err != nil {
+			ht.Fatalf("Append: %v", err)
+		}
+		if !reflect.DeepEqual(goSections(three), goSections(joined)) {
+			ht.Fatalf("Empty().Append(a).Append(b) %v, Load(a+b) %v", goSections(three), goSections(joined))
+		}
+		if e := Empty(); len(e.Sections()) != 1 || e.Sections()[0].Name() != DefaultSection || len(e.Section("").Keys()) != 0 {
+			ht.Fatalf("Empty() = %v", e.SectionStrings())
+		}
+	})
+}
