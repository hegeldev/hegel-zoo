+// escapedDelimiterRun reports whether v holds a backslash, the delimiter and one more of its
+// last character (`\:::` for `::`): Strings drops the backslash but consumes only the first
+// character of the escaped delimiter (key.go, the `str[i] == '\\'` branch), so the rest of it
+// pairs with the next character into a split - `a\:::b` is [a: b] where the model (and
+// upstream's own `value1\,, value2` test for `,,`) reads the literal `::` and a `:`, [a:::b].
+// go-ini/9 (pinned below); the case is skipped (about one in two hundred).
+func escapedDelimiterRun(v, delim string) bool {
+	return len(delim) > 1 && strings.Contains(v, `\`+delim+delim[len(delim)-1:])
+}
