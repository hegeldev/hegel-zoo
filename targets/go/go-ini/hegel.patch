+// Hegel property tests for gopkg.in/ini.v1 (go-ini/ini): the parser against Python's
+// configparser on the grammar both read the same way, the writer against the reader, the
+// key helpers and %(name)s interpolation against models, and pinned bugs.
+package ini_test
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	. "gopkg.in/ini.v1"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func text(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	rs := []rune(alphabet)
+	var sb strings.Builder
+	for i, k := 0, n(tc, lo, hi); i < k; i++ {
+		sb.WriteRune(rs[n(tc, 0, len(rs)-1)])
+	}
+	return sb.String()
+}
+
+// ---- the Python oracle ---------------------------------------------------------------------
+
+const pythonScript = `
+import sys, json, configparser
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        cp = configparser.ConfigParser(
+            interpolation=None, strict=False, allow_no_value=False,
+            delimiters=('=', ':'), comment_prefixes=('#', ';'),
+            inline_comment_prefixes=(('#', ';') if req['inline'] else None),
+            empty_lines_in_values=True)
+        cp.optionxform = str.lower if req['lower'] else str
+        cp.read_string('[DEFAULT]\n' + req['text'])
+        secs = {'DEFAULT': dict(cp.defaults())}
+        for s, kv in cp._sections.items():
+            secs[s] = dict(kv)
+        out = {'ok': True, 'sections': secs}
+    except Exception as e:
+        out = {'ok': False, 'error': repr(e)}
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+`
+
+type pyRequest struct {
+	Text   string `json:"text"`
+	Inline bool   `json:"inline"`
+	Lower  bool   `json:"lower"`
+}
+
+type pyResult struct {
+	OK       bool                         `json:"ok"`
+	Sections map[string]map[string]string `json:"sections"`
+	Error    string                       `json:"error"`
+}
+
+var python struct {
+	once sync.Once
+	mu   sync.Mutex
+	in   io.WriteCloser
+	out  *bufio.Reader
+	err  error
+}
+
+func pythonParse(t testing.TB, req pyRequest) pyResult {
+	python.once.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			python.err = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			python.err = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			python.err = err
+			return
+		}
+		python.in = in
+		python.out = bufio.NewReaderSize(out, 1<<20)
+	})
+	if python.err != nil {
+		t.Fatalf("starting python3: %v", python.err)
+	}
+	python.mu.Lock()
+	defer python.mu.Unlock()
+	b, _ := json.Marshal(req)
+	if _, err := python.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("writing to python3: %v", err)
+	}
+	line, err := python.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python3: %v", err)
+	}
+	var res pyResult
+	if err := json.Unmarshal(line, &res); err != nil {
+		t.Fatalf("python3 said %q: %v", line, err)
+	}
+	return res
+}
+
+// ---- the shared grammar --------------------------------------------------------------------
+
+type parseMode int
+
+const (
+	modeDefault parseMode = iota
+	modeSpaceBeforeComment
+	modeInsensitiveKeys
+	modeIgnoreInlineComment
+	modePythonMultiline
+)
+
+var modeNames = map[parseMode]string{modeDefault: "default", modeSpaceBeforeComment: "SpaceBeforeInlineComment", modeInsensitiveKeys: "InsensitiveKeys", modeIgnoreInlineComment: "IgnoreInlineComment", modePythonMultiline: "AllowPythonMultilineValues"}
+
+func (m parseMode) options() LoadOptions {
+	switch m {
+	case modeSpaceBeforeComment:
+		return LoadOptions{SpaceBeforeInlineComment: true}
+	case modeInsensitiveKeys:
+		return LoadOptions{InsensitiveKeys: true}
+	case modeIgnoreInlineComment:
+		return LoadOptions{IgnoreInlineComment: true}
+	case modePythonMultiline:
+		return LoadOptions{AllowPythonMultilineValues: true}
+	}
+	return LoadOptions{}
+}
+
+const (
+	nameChars  = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
+	keyChars   = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._- \"`]%()"
+	valueChars = "abcdefghijklmnopqrstuvwxyz0123456789 ,.=:%()[]'\"`\\/!éÑ日本-_"
+)
+
+// genSectionName: letters, digits, . _ -, single inner spaces; never DEFAULT (which is a
+// header both sides accept but which the generator adds separately).
+func genSectionName(tc hegel.TestCase) string {
+	name := text(tc, nameChars, 1, 6)
+	if chance(tc, 20) {
+		name = name + " " + text(tc, nameChars, 1, 3)
+	}
+	if strings.EqualFold(name, "DEFAULT") {
+		name = "x" + name
+	}
+	return name
+}
+
+// genKeyName: never starting with a quote, backtick, [ # ; and never "-" (auto-increment);
+// no leading/trailing blanks (both sides trim).
+func genKeyName(tc hegel.TestCase) string {
+	for {
+		k := strings.TrimSpace(text(tc, keyChars, 1, 6))
+		if k == "" || k == "-" || strings.ContainsAny(k[:1], "\"`[#;") || strings.ContainsAny(k, "=:") {
+			continue
+		}
+		return k
+	}
+}
+
+// genValue draws a value both parsers read alike in the given mode: never starting with a
+// quote, backtick, # or ;, never ending with a backslash (go-ini's continuation), no tabs,
+// comment symbols only where the mode allows them.
+func genValue(tc hegel.TestCase, mode parseMode) string {
+	for {
+		v := strings.TrimSpace(text(tc, valueChars, 0, 12))
+		if v == "" {
+			return v
+		}
+		if strings.ContainsAny(v[:1], "'\"`#;") || strings.HasSuffix(v, `\`) || strings.Contains(v, "%(") {
+			continue
+		}
+		rs := []rune(v)
+		switch mode {
+		case modeIgnoreInlineComment:
+			if chance(tc, 30) {
+				i := n(tc, 1, len(rs))
+				v = string(rs[:i]) + pick(tc, []string{"#", ";", "#c", ";c"}) + string(rs[i:])
+			}
+		case modeSpaceBeforeComment:
+			// A comment symbol not preceded by a space is part of the value; at most one so
+			// that go-ini's "# before ;" preference (go-ini/7) cannot show.
+			if chance(tc, 30) {
+				i := n(tc, 1, len(rs))
+				if rs[i-1] != ' ' && (i == len(rs) || rs[i] != ' ') {
+					v = string(rs[:i]) + pick(tc, []string{"#", ";"}) + string(rs[i:])
+				}
+			}
+		}
+		return v
+	}
+}
+
+// genComment draws an inline comment (with the space both sides need) or nothing.
+func genInlineComment(tc hegel.TestCase, mode parseMode, value string) string {
+	if mode == modeIgnoreInlineComment || mode == modePythonMultiline || !chance(tc, 30) {
+		return ""
+	}
+	// With SpaceBeforeInlineComment go-ini looks for " #" inside the trimmed value, so a
+	// comment right after the delimiter is part of the value (go-ini/5): a value is needed.
+	if mode == modeSpaceBeforeComment && (strings.ContainsAny(value, "#;") || value == "") {
+		return ""
+	}
+	return " " + pick(tc, []string{"#", ";"}) + pick(tc, []string{"", " c", " x=y", " [z]"})
+}
+
+// genIni draws an INI text in the shared grammar for the mode and returns it.
+func genIni(tc hegel.TestCase, mode parseMode) string {
+	var sb strings.Builder
+	eol := "\n"
+	if mode != modePythonMultiline && chance(tc, 20) {
+		eol = "\r\n"
+	}
+	lines := n(tc, 0, 8)
+	for i := 0; i < lines; i++ {
+		switch n(tc, 1, 10) {
+		case 1, 2:
+			name := genSectionName(tc)
+			if chance(tc, 10) {
+				name = "DEFAULT"
+			}
+			sb.WriteString("[" + name + "]")
+			if chance(tc, 20) {
+				sb.WriteString(pick(tc, []string{" # c", " ; c", " junk", "#c"}))
+			}
+			sb.WriteString(eol)
+		case 3:
+			c := pick(tc, []string{"# comment", "; comment", "#", ";", "  # indented comment", "# k = v", "; [s]"})
+			if mode == modePythonMultiline {
+				c = strings.TrimSpace(c) // an indented comment is continuation text for go-ini
+			}
+			sb.WriteString(c + eol)
+		case 4:
+			// A whitespace-only line is blank for Python but a continuation line for go-ini's
+			// Python-style values, so in that mode blank lines are empty.
+			if mode == modePythonMultiline {
+				sb.WriteString(eol)
+			} else {
+				sb.WriteString(pick(tc, []string{"", " ", "   "}) + eol)
+			}
+		default:
+			key := genKeyName(tc)
+			value := genValue(tc, mode)
+			sb.WriteString(key + pick(tc, []string{"", " ", "  "}) + pick(tc, []string{"=", ":"}) + pick(tc, []string{"", " ", "  "}) + value)
+			sb.WriteString(genInlineComment(tc, mode, value))
+			sb.WriteString(eol)
+			if mode == modePythonMultiline && chance(tc, 50) {
+				for j, k := 0, n(tc, 1, 3); j < k; j++ {
+					cont := genValue(tc, modeDefault)
+					if cont == "" || strings.ContainsAny(cont, "#;") {
+						cont = "cont"
+					}
+					sb.WriteString(pick(tc, []string{" ", "  ", "\t", "    "}) + cont + eol)
+				}
+			}
+		}
+	}
+	s := sb.String()
+	if chance(tc, 20) {
+		s = strings.TrimSuffix(s, eol)
+	}
+	return s
+}
+
+// goSections reads a File back as name -> key -> value, in the shape the Python child returns.
+func goSections(f *File) map[string]map[string]string {
+	out := map[string]map[string]string{}
+	for _, s := range f.Sections() {
+		kv := map[string]string{}
+		for _, k := range s.Keys() {
+			kv[k.Name()] = k.Value()
+		}
+		out[s.Name()] = kv
+	}
+	return out
+}
+
+var continuationIndent = regexp.MustCompile(`\n[\t\f ]+`)
+
+// TestHegelParseAgreesWithPython: on INI text in the grammar both read alike, go-ini (default
+// options, SpaceBeforeInlineComment, InsensitiveKeys, IgnoreInlineComment or
+// AllowPythonMultilineValues) yields the same sections, keys and values as Python's
+// configparser (strict=False, no interpolation, matching inline-comment and option-casing
+// settings; sectionless keys are Python's DEFAULT section). go-ini keeps the indentation of
+// Python-style continuation lines (asserted upstream); it is stripped before comparing.
+func TestHegelParseAgreesWithPython(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		mode := parseMode(n(ht, 0, 4))
+		src := genIni(ht, mode)
+		note(ht, "mode %s, text %q", modeNames[mode], src)
+		want := pythonParse(t, pyRequest{Text: src, Inline: mode != modeIgnoreInlineComment, Lower: mode == modeInsensitiveKeys})
+		if !want.OK {
+			ht.Fatalf("python rejected the generated text: %s", want.Error)
+		}
+		f, err := LoadSources(mode.options(), []byte(src))
+		if err != nil {
+			ht.Fatalf("go-ini: %v; python: %v", err, want.Sections)
+		}
+		got := goSections(f)
+		if mode == modePythonMultiline {
+			for _, kv := range got {
+				for k, v := range kv {
+					kv[k] = continuationIndent.ReplaceAllString(v, "\n")
+				}
+			}
+		}
+		if !reflect.DeepEqual(got, want.Sections) {
+			ht.Fatalf("go-ini %v\npython %v", got, want.Sections)
+		}
+	})
+}
+
+// TestHegelEntryPointsAgree: the same text through []byte, a file, an io.Reader and an
+// io.ReadCloser, with or without a UTF-8 BOM, and two sources against their concatenation,
+// give the same sections; Empty() has just the default section.
+func TestHegelEntryPointsAgree(t *testing.T) {
+	dir := t.TempDir()
+	property(t, func(ht *hegel.T) {
+		src := genIni(ht, modeDefault)
+		note(ht, "text %q", src)
+		base, err := Load([]byte(src))
+		if err != nil {
+			ht.Fatalf("Load([]byte): %v", err)
+		}
+		want := goSections(base)
+		check := func(what string, f *File, err error) {
+			if err != nil {
+				ht.Fatalf("%s: %v", what, err)
+			}
+			if got := goSections(f); !reflect.DeepEqual(got, want) {
+				ht.Fatalf("%s: %v, want %v", what, got, want)
+			}
+			if !reflect.DeepEqual(f.SectionStrings(), base.SectionStrings()) {
+				ht.Fatalf("%s: section order %v, want %v", what, f.SectionStrings(), base.SectionStrings())
+			}
+		}
+		path := filepath.Join(dir, fmt.Sprintf("f%d.ini", n(ht, 0, 1<<30)))
+		if err := os.WriteFile(path, []byte(src), 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		f, err := Load(path)
+		check("Load(file)", f, err)
+		f, err = Load(strings.NewReader(src))
+		check("Load(io.Reader)", f, err)
+		f, err = Load(io.NopCloser(bytes.NewReader([]byte(src))))
+		check("Load(io.ReadCloser)", f, err)
+		f, err = Load(append([]byte("\xef\xbb\xbf"), src...))
+		check("Load(BOM + text)", f, err)
+		f, err = LooseLoad([]byte(src), filepath.Join(dir, "missing.ini"))
+		check("LooseLoad(text, missing file)", f, err)
+
+		// Two sources are the concatenation (the first ends with a line break; every source
+		// starts in the default section, so the second opens with a header).
+		other := "[" + genSectionName(ht) + "]\n" + genIni(ht, modeDefault)
+		a := src
+		if a != "" && !strings.HasSuffix(a, "\n") {
+			a += "\n"
+		}
+		joined, err := Load([]byte(a + other))
+		if err != nil {
+			ht.Fatalf("Load(a+b): %v", err)
+		}
+		two, err := Load([]byte(a), []byte(other))
+		if err != nil {
+			ht.Fatalf("Load(a, b): %v", err)
+		}
+		if !reflect.DeepEqual(goSections(two), goSections(joined)) {
+			ht.Fatalf("Load(a, b) %v, Load(a+b) %v", goSections(two), goSections(joined))
+		}
+		three := Empty()
+		if err := three.Append([]byte(a)); err != nil {
+			ht.Fatalf("Append: %v", err)
+		}
+		if err := three.Append([]byte(other)); err != nil {
+			ht.Fatalf("Append: %v", err)
+		}
+		if !reflect.DeepEqual(goSections(three), goSections(joined)) {
+			ht.Fatalf("Empty().Append(a).Append(b) %v, Load(a+b) %v", goSections(three), goSections(joined))
+		}
+		if e := Empty(); len(e.Sections()) != 1 || e.Sections()[0].Name() != DefaultSection || len(e.Section("").Keys()) != 0 {
+			ht.Fatalf("Empty() = %v", e.SectionStrings())
+		}
+	})
+}
+
+// ---- the writer against the reader ---------------------------------------------------------
+
+const writerValueChars = "abc xyz019 #;=:%\"'`\\[]()\n\t日é"
+
+// genWriterValue draws a value the writer should be able to make readable. The shapes it
+// cannot (go-ini/2) are kept out: a leading quote, a trailing backslash or a padded value
+// with an inner quote, unless the value also has a line feed, a backtick or a comment
+// symbol (those forms are quoted robustly).
+func genWriterValue(tc hegel.TestCase) string {
+	for {
+		v := text(tc, writerValueChars, 0, 10)
+		if strings.Contains(v, "\r") {
+			continue
+		}
+		robust := strings.ContainsAny(v, "\n`") || strings.ContainsAny(v, "#;")
+		if v != "" && strings.ContainsAny(v[:1], "'\"") {
+			continue
+		}
+		if !robust && strings.HasSuffix(v, `\`) {
+			continue
+		}
+		if !robust && len(strings.TrimSpace(v)) != len(v) && strings.Contains(v, `"`) {
+			continue
+		}
+		return v
+	}
+}
+
+// genWriterKey draws a key the writer quotes correctly: not starting with # ; [, not "-",
+// no surrounding blanks or line breaks, and not both a backtick and a quote/delimiter
+// (go-ini/3).
+func genWriterKey(tc hegel.TestCase) string {
+	for {
+		k := text(tc, "abcXYZ019 _.-\"`=:%[]", 1, 6)
+		if strings.TrimSpace(k) != k || k == "-" || strings.ContainsAny(k[:1], "#;[") {
+			continue
+		}
+		if strings.Contains(k, "`") && strings.ContainsAny(k, "\"=:") {
+			continue
+		}
+		return k
+	}
+}
+
+// TestHegelWrittenFileReadsBack: a File built through the API (sections, keys, values from a
+// broad alphabet) written with WriteTo/WriteToIndent under every combination of PrettyFormat,
+// PrettyEqual, PrettySection and DefaultHeader reads back with Load to the same sections,
+// keys, values and order; SaveTo + Load(path) agrees.
+func TestHegelWrittenFileReadsBack(t *testing.T) {
+	dir := t.TempDir()
+	defer func(pf, pe, ps, dh bool) { PrettyFormat, PrettyEqual, PrettySection, DefaultHeader = pf, pe, ps, dh }(PrettyFormat, PrettyEqual, PrettySection, DefaultHeader)
+	property(t, func(ht *hegel.T) {
+		PrettyFormat, PrettyEqual, PrettySection, DefaultHeader = chance(ht, 50), chance(ht, 50), chance(ht, 50), chance(ht, 50)
+		f := Empty()
+		nsec := n(ht, 0, 3)
+		for i := 0; i < nsec; i++ {
+			name := text(ht, "abcXYZ019 _.-#;=[]`\"", 1, 6)
+			if strings.EqualFold(name, "DEFAULT") {
+				name = "x"
+			}
+			if _, err := f.NewSection(name); err != nil {
+				ht.Fatalf("NewSection(%q): %v", name, err)
+			}
+		}
+		for _, s := range f.Sections() {
+			for j, k := 0, n(ht, 0, 4); j < k; j++ {
+				if _, err := s.NewKey(genWriterKey(ht), genWriterValue(ht)); err != nil {
+					ht.Fatalf("NewKey: %v", err)
+				}
+			}
+		}
+		want := goSections(f)
+		indent := pick(ht, []string{"", "  ", "\t"})
+		var buf bytes.Buffer
+		if _, err := f.WriteToIndent(&buf, indent); err != nil {
+			ht.Fatalf("WriteToIndent: %v", err)
+		}
+		note(ht, "PrettyFormat %v PrettyEqual %v PrettySection %v DefaultHeader %v indent %q\nwrote %q", PrettyFormat, PrettyEqual, PrettySection, DefaultHeader, indent, buf.String())
+		g, err := Load(buf.Bytes())
+		if err != nil {
+			ht.Fatalf("reading back: %v", err)
+		}
+		if got := goSections(g); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("read back %v, want %v", got, want)
+		}
+		if !reflect.DeepEqual(g.SectionStrings(), f.SectionStrings()) {
+			ht.Fatalf("read back sections %v, want %v", g.SectionStrings(), f.SectionStrings())
+		}
+		for _, s := range f.Sections() {
+			if got := g.Section(s.Name()).KeyStrings(); !reflect.DeepEqual(got, s.KeyStrings()) {
+				ht.Fatalf("read back keys of %q %v, want %v", s.Name(), got, s.KeyStrings())
+			}
+		}
+		path := filepath.Join(dir, fmt.Sprintf("w%d.ini", n(ht, 0, 1<<30)))
+		if err := f.SaveToIndent(path, indent); err != nil {
+			ht.Fatalf("SaveToIndent: %v", err)
+		}
+		saved, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(saved, buf.Bytes()) {
+			ht.Fatalf("SaveToIndent wrote %q, WriteToIndent %q (%v)", saved, buf.Bytes(), err)
+		}
+	})
+}
