+var entryCases = hegel.Composite(func(tc hegel.TestCase) entryCase {
+	return entryCase{src: hegel.Draw(tc, docsOf[modeDefault]), otherName: hegel.Draw(tc, sectionNames), other: hegel.Draw(tc, docsOf[modeDefault])}
