+// TestHegelWrittenFileReadsBack: a File built through the API (sections, keys, values from a
+// broad alphabet) written with WriteTo/WriteToIndent under every combination of PrettyFormat,
+// PrettyEqual, PrettySection and DefaultHeader reads back with Load to the same sections,
+// keys, values and order; SaveTo + Load(path) agrees. The four switches are the library's
+// package-level variables: they are drawn fresh for every case and restored at the end.
+func TestHegelWrittenFileReadsBack(t *testing.T) {
+	dir := t.TempDir()
+	defer func(pf, pe, ps, dh bool) { PrettyFormat, PrettyEqual, PrettySection, DefaultHeader = pf, pe, ps, dh }(PrettyFormat, PrettyEqual, PrettySection, DefaultHeader)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, writerCases)
+		PrettyFormat, PrettyEqual, PrettySection, DefaultHeader = c.prettyFormat, c.prettyEqual, c.prettySection, c.defaultHeader
+		f, err := c.build()
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		want := goSections(f)
+		var buf bytes.Buffer
+		if _, err := f.WriteToIndent(&buf, c.indent); err != nil {
+			ht.Fatalf("WriteToIndent: %v", err)
+		}
+		note(ht, "wrote %q", buf.String())
+		g, err := Load(buf.Bytes())
+		if err != nil {
+			ht.Fatalf("reading back: %v", err)
+		}
+		if got := goSections(g); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("read back %v, want %v", got, want)
+		}
+		if !reflect.DeepEqual(g.SectionStrings(), f.SectionStrings()) {
+			ht.Fatalf("read back sections %v, want %v", g.SectionStrings(), f.SectionStrings())
+		}
+		for _, s := range f.Sections() {
+			if got := g.Section(s.Name()).KeyStrings(); !reflect.DeepEqual(got, s.KeyStrings()) {
+				ht.Fatalf("read back keys of %q %v, want %v", s.Name(), got, s.KeyStrings())
+			}
+		}
+		path := filepath.Join(dir, fmt.Sprintf("w%d.ini", fileSeq.Add(1)))
+		if err := f.SaveToIndent(path, c.indent); err != nil {
+			ht.Fatalf("SaveToIndent: %v", err)
+		}
+		saved, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(saved, buf.Bytes()) {
+			ht.Fatalf("SaveToIndent wrote %q, WriteToIndent %q (%v)", saved, buf.Bytes(), err)
+		}
+	})
+}
+
+// ---- key helpers ---------------------------------------------------------------------------
+
+// splitModel is Key.Strings as documented by the tests: the delimiter splits, "\<delim>" is a
+// literal delimiter, "\\" a backslash, any other backslash stays, parts are trimmed.
+func splitModel(s, delim string) []string {
+	if s == "" {
+		return []string{}
+	}
+	var parts []string
+	var cur strings.Builder
+	for i := 0; i < len(s); {
+		switch {
+		case s[i] == '\\' && i+1 < len(s) && strings.HasPrefix(s[i+1:], delim):
+			cur.WriteString(delim)
+			i += 1 + len(delim)
+		case s[i] == '\\' && i+1 < len(s) && s[i+1] == '\\':
+			cur.WriteByte('\\')
+			i += 2
+		case strings.HasPrefix(s[i:], delim):
+			parts = append(parts, strings.TrimSpace(cur.String()))
+			cur.Reset()
+			i += len(delim)
+		default:
+			cur.WriteByte(s[i])
+			i++
+		}
+	}
+	parts = append(parts, strings.TrimSpace(cur.String()))
+	return parts
+}
+
+var boolWords = map[string]bool{"1": true, "t": true, "T": true, "true": true, "TRUE": true, "True": true, "YES": true, "yes": true, "Yes": true, "y": true, "ON": true, "on": true, "On": true,
+	"0": false, "f": false, "F": false, "false": false, "FALSE": false, "False": false, "NO": false, "no": false, "No": false, "n": false, "OFF": false, "off": false, "Off": false}
+
+const splitChars = "ab 1\\,:|日"
+
+// splitValue: a delimiter and a value for Strings(delim): empty once in ten; else, with a
+// blank at either end once in three, a core that neither starts nor ends with the delimiter's
+// edge character and does not end with a backslash (go-ini/6's shapes), or a head and a tail
+// so shaped around one to three delimiters with text between (the head or the text may hold
+// backslashes and delimiters of their own).
+type splitValue struct{ delim, value string }
+
+var splitValues = hegel.FlatMap(hegel.SampledFrom([]string{",", "::", "|"}), func(d string) hegel.Generator[splitValue] {
+	blank := hegel.SampledFrom([]string{"", "", " "})
+	noStart, noEnd := " "+d[:1], " \\"+d[len(d)-1:]
+	core := word(splitChars, noStart, noEnd, 6)
+	between := hegel.Map(many(cat(hegel.Just(d), text(splitChars, 0, 3)), 0, 2), func(ps []string) string { return strings.Join(ps, "") })
+	joined := cat(word(splitChars, noStart, "", 3), between, hegel.Just(d), word(splitChars, "", noEnd, 3))
+	value := weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{4, cat(blank, core, blank)},
+		choice[string]{5, cat(blank, joined, blank)},
+	)
+	return hegel.Map(value, func(v string) splitValue { return splitValue{d, v} })
+})
+
+var (
+	boolTexts     = hegel.SampledFrom([]string{"1", "t", "yes", "On", "0", "F", "no", "Off", "TRUE", "false", "y", "n", "2", "yeah", "", "True ", "on\n", "nope", "ok"})
+	numTexts      = hegel.SampledFrom([]string{"0", "42", "-7", "9223372036854775807", "9223372036854775808", "18446744073709551615", "1e3", "3.5", "0x10", " 5", "5 ", "+5", "1_000", "", "abc", "-1", "٣"})
+	intParts      = hegel.SampledFrom([]string{"1", "22", "-3", "x", "4.5", "", "007"})
+	nonEmptyParts = hegel.SampledFrom([]string{"1", "22", "-3", "x", "4.5", "007"})
+	// intLists: one to four parts, the first and the last never empty (an empty first or last
+	// part is Strings()' go-ini/6 shape).
+	intLists = hegel.OneOf(
+		many(nonEmptyParts, 1, 1),
+		hegel.Composite(func(tc hegel.TestCase) []string {
+			first := hegel.Draw(tc, nonEmptyParts)
+			mid := hegel.Draw(tc, many(intParts, 0, 2))
+			last := hegel.Draw(tc, nonEmptyParts)
+			return append(append([]string{first}, mid...), last)
+		}),
+	)
+	smallInts = hegel.Integers(-5, 15)
+)
+
+// helpersCase: the Strings value and delimiter, the Bool word, the number text, the integer
+// list, the RangeInt value and bounds (used in order), and the In candidates.
+type helpersCase struct {
+	split  splitValue
+	word   string
+	num    string
+	parts  []string
+	x      int
+	lo, hi int
+	cands  [2]int
+}
+
+func (c helpersCase) GoString() string {
+	return fmt.Sprintf("Strings(%q) of %q; Bool of %q; number %q; ints %q; x=%d in [%d, %d], candidates %v", c.split.delim, c.split.value, c.word, c.num, c.parts, c.x, c.lo, c.hi, c.cands)
+}
+
+var helpersCases = hegel.Composite(func(tc hegel.TestCase) helpersCase {
+	c := helpersCase{
+		split: hegel.Draw(tc, splitValues),
+		word:  hegel.Draw(tc, boolTexts),
