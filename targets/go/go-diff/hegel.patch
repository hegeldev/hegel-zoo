diff --git a/hegel/hegel_git_test.go b/hegel/hegel_git_test.go
new file mode 100644
index 0000000..0019c9d
--- /dev/null
+++ b/hegel/hegel_git_test.go
@@ -0,0 +1,364 @@
+package hegel
+
+// TestHegelMultiFile: git's diff of a random change to a small repository (edits, additions,
+// deletions, renames, mode changes, binary files) parses into one FileDiff per changed path
+// with the right names, prints back to the same diff, and the printed diff and its reverse
+// are accepted by git apply and produce the new and the old tree.
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/sourcegraph/go-diff/diff"
+	"hegel.dev/go/hegel"
+)
+
+var gitEnv = append(os.Environ(),
+	"GIT_AUTHOR_NAME=zoo", "GIT_AUTHOR_EMAIL=zoo@example.com",
+	"GIT_COMMITTER_NAME=zoo", "GIT_COMMITTER_EMAIL=zoo@example.com",
+	"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1")
+
+func gitRun(dir string, stdin []byte, args ...string) ([]byte, error) {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = dir
+	cmd.Env = gitEnv
+	if stdin != nil {
+		cmd.Stdin = bytes.NewReader(stdin)
+	}
+	var out, errb bytes.Buffer
+	cmd.Stdout = &out
+	cmd.Stderr = &errb
+	if err := cmd.Run(); err != nil {
+		return out.Bytes(), fmt.Errorf("git %s: %v: %s", strings.Join(args, " "), err, bytes.TrimSpace(errb.Bytes()))
+	}
+	return out.Bytes(), nil
+}
+
+type repoFile struct {
+	content []byte
+	exec    bool
+}
+
+var fileNames = []string{"a.txt", "b.txt", "dir/c.txt", "f g.txt", "d.go", "dir/sub/e.md", "z"}
+
+func genContent(tc hegel.TestCase) []byte {
+	if chance(tc, 15) {
+		n := drawInt(tc, 0, 6)
+		b := make([]byte, n)
+		for i := range b {
+			b[i] = byte(drawInt(tc, 0, 255))
+		}
+		if n > 0 && chance(tc, 80) {
+			b[0] = 0 // binary
+		}
+		return b
+	}
+	return []byte(joinText(genLines(tc, 8), "\n", chance(tc, 85)))
+}
+
+func isBinary(b []byte) bool { return bytes.IndexByte(b, 0) >= 0 }
+
+func writeTree(dir string, files map[string]repoFile) error {
+	for name, f := range files {
+		p := filepath.Join(dir, name)
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			return err
+		}
+		mode := os.FileMode(0o644)
+		if f.exec {
+			mode = 0o755
+		}
+		if err := os.WriteFile(p, f.content, mode); err != nil {
+			return err
+		}
+		if err := os.Chmod(p, mode); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// treeHash stages everything in dir and returns the tree id.
+func treeHash(dir string) (string, error) {
+	if _, err := gitRun(dir, nil, "add", "-A"); err != nil {
+		return "", err
+	}
+	out, err := gitRun(dir, nil, "write-tree")
+	return strings.TrimSpace(string(out)), err
+}
+
+// swapBinaryLiterals exchanges the two sections (forward and reverse: "literal N" or "delta N",
+// base85 lines, a blank line) that follow a "GIT binary patch" header; ok is false when the
+// headers hold no binary patch.
+func swapBinaryLiterals(ext []string) ([]string, bool) {
+	start := -1
+	for i, l := range ext {
+		if l == "GIT binary patch" {
+			start = i + 1
+			break
+		}
+	}
+	if start < 0 {
+		return ext, false
+	}
+	var sections [][]string
+	for i := start; i < len(ext); {
+		j := i
+		for j < len(ext) && ext[j] != "" {
+			j++
+		}
+		if j < len(ext) {
+			j++ // the blank line
+		}
+		sections = append(sections, ext[i:j])
+		i = j
+	}
+	if len(sections) != 2 {
+		return ext, false
+	}
+	out := append([]string(nil), ext[:start]...)
+	out = append(out, sections[1]...)
+	out = append(out, sections[0]...)
+	return out, true
+}
+
+func TestHegelMultiFile(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		// old tree
+		old := map[string]repoFile{}
+		for i, n := 0, drawInt(ht, 1, 4); i < n; i++ {
+			old[pick(ht, fileNames)] = repoFile{content: genContent(ht), exec: chance(ht, 15)}
+		}
+		// new tree: a mutation of the old
+		new := map[string]repoFile{}
+		for name, f := range old {
+			switch drawInt(ht, 0, 6) {
+			case 0: // keep
+				new[name] = f
+			case 1: // delete
+			case 2, 3: // modify
+				if isBinary(f.content) {
+					new[name] = repoFile{content: genContent(ht), exec: f.exec}
+				} else {
+					new[name] = repoFile{content: []byte(joinText(mutate(ht, strings.Split(strings.TrimSuffix(string(f.content), "\n"), "\n")), "\n", chance(ht, 85))), exec: f.exec}
+				}
+			case 4: // chmod
+				new[name] = repoFile{content: f.content, exec: !f.exec}
+			case 5, 6: // rename, maybe with a small edit
+				to := pick(ht, fileNames)
+				if _, taken := old[to]; taken {
+					to = "renamed/" + to
+				}
+				nf := f
+				if chance(ht, 30) && !isBinary(f.content) {
+					nf.content = []byte(joinText(mutate(ht, strings.Split(strings.TrimSuffix(string(f.content), "\n"), "\n")), "\n", true))
+				}
+				new[to] = nf
+			}
+		}
+		if chance(ht, 40) {
+			name := pick(ht, fileNames)
+			if _, taken := old[name]; taken {
+				name = "added/" + name
+			}
+			if _, taken := new[name]; !taken {
+				new[name] = repoFile{content: genContent(ht), exec: chance(ht, 10)}
+			}
+		}
+		binary := false
+		for name, f := range new {
+			if isBinary(f.content) && !bytes.Equal(f.content, old[name].content) {
+				binary = true
+			}
+		}
+		for name, f := range old {
+			if isBinary(f.content) {
+				if nf, ok := new[name]; !ok || !bytes.Equal(nf.content, f.content) {
+					binary = true
+				}
+			}
+		}
+
+		root, err := os.MkdirTemp("", "godiff-git")
+		if err != nil {
+			ht.Skipf("tempdir: %v", err)
+		}
+		defer os.RemoveAll(root)
+		repo, oldDir, newDir := filepath.Join(root, "repo"), filepath.Join(root, "old"), filepath.Join(root, "new")
+		for _, d := range []string{repo, oldDir, newDir} {
+			if err := os.MkdirAll(d, 0o755); err != nil {
+				ht.Skipf("mkdir: %v", err)
+			}
+			if _, err := gitRun(d, nil, "init", "-q"); err != nil {
+				ht.Skipf("%v", err)
+			}
+		}
+		if err := writeTree(repo, old); err != nil {
+			ht.Skipf("write: %v", err)
+		}
+		oldTree, err := treeHash(repo)
+		if err != nil {
+			ht.Skipf("%v", err)
+		}
+		if _, err := gitRun(repo, nil, "commit", "-q", "-m", "old"); err != nil {
+			ht.Skipf("%v", err)
+		}
+		if err := os.RemoveAll(repo); err != nil {
+			ht.Skipf("%v", err)
+		}
+		// a fresh repo for the new tree keeps the staging simple: commit old, then replace
+		if _, err := gitRun(root, nil, "init", "-q", "repo"); err != nil {
+			ht.Skipf("%v", err)
+		}
+		if err := writeTree(repo, old); err != nil {
+			ht.Skipf("write: %v", err)
+		}
+		if _, err := treeHash(repo); err != nil {
+			ht.Skipf("%v", err)
+		}
+		if _, err := gitRun(repo, nil, "commit", "-q", "-m", "old"); err != nil {
+			ht.Skipf("%v", err)
+		}
+		for name := range old {
+			if _, keep := new[name]; !keep {
+				os.Remove(filepath.Join(repo, name))
+			}
+		}
+		if err := writeTree(repo, new); err != nil {
+			ht.Skipf("write: %v", err)
+		}
+		newTree, err := treeHash(repo)
+		if err != nil {
+			ht.Skipf("%v", err)
+		}
+		if newTree == oldTree {
+			c.count("no change")
+			return
+		}
+		ctx := drawInt(ht, 0, 3)
+		args := []string{"diff", "--cached", fmt.Sprintf("-U%d", ctx)}
+		if chance(ht, 50) {
+			args = append(args, "-M")
+		} else {
+			args = append(args, "--no-renames")
+		}
+		if binary {
+			args = append(args, "--binary")
+		}
+		raw, err := gitRun(repo, nil, args...)
+		if err != nil {
+			ht.Skipf("%v", err)
+		}
+		status, err := gitRun(repo, nil, append([]string{"diff", "--cached", "--name-status", "-z"}, args[3:4]...)...)
+		if err != nil {
+			ht.Skipf("%v", err)
+		}
+		// expected (orig, new) name pairs from --name-status
+		var want []string
+		fields := strings.Split(strings.TrimSuffix(string(status), "\x00"), "\x00")
+		for i := 0; i < len(fields); {
+			st := fields[i]
+			switch st[0] {
+			case 'R', 'C':
+				want = append(want, "a/"+fields[i+1]+" -> b/"+fields[i+2])
+				i += 3
+			case 'A':
+				want = append(want, "/dev/null -> b/"+fields[i+1])
+				i += 2
+			case 'D':
+				want = append(want, "a/"+fields[i+1]+" -> /dev/null")
+				i += 2
+			default:
+				want = append(want, "a/"+fields[i+1]+" -> b/"+fields[i+1])
+				i += 2
+			}
+		}
+		sort.Strings(want)
+
+		fds, err := diff.ParseMultiFileDiff(raw)
+		if Known.dashLinesReadAsFileHeader && headerLookalikeMulti(raw) {
+			c.count("known header lookalike")
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "Parse", "ParseMultiFileDiff(git %v): %v\n%s", args, err, raw)
+			return
+		}
+		var got []string
+		for _, fd := range fds {
+			got = append(got, fd.OrigName+" -> "+fd.NewName)
+		}
+		sort.Strings(got)
+		if strings.Join(got, "\n") != strings.Join(want, "\n") {
+			c.failClass(ht, "Names", "git %v: files parsed as\n  %s\nwant\n  %s\n%s", args, strings.Join(got, "\n  "), strings.Join(want, "\n  "), raw)
+			return
+		}
+		out, err := diff.PrintMultiFileDiff(fds)
+		if err != nil {
+			c.failClass(ht, "Print", "PrintMultiFileDiff: %v\n%s", err, raw)
+			return
+		}
+		if want := canonRaw(raw); !bytes.Equal(out, want) {
+			c.failClass(ht, "Reprint", "PrintMultiFileDiff differs from git %v\nGIT:\n%s\nPRINTED:\n%s", args, want, out)
+			return
+		}
+		// apply the printed diff to the old tree
+		if err := writeTree(oldDir, old); err != nil {
+			ht.Skipf("write: %v", err)
+		}
+		if _, err := treeHash(oldDir); err != nil {
+			ht.Skipf("%v", err)
+		}
+		if _, err := gitRun(oldDir, out, "apply", "--binary", "--whitespace=nowarn", "--unidiff-zero"); err != nil {
+			c.failClass(ht, "Apply", "git apply rejects the printed diff (git %v): %v\nGIT:\n%s\nPRINTED:\n%s", args, err, raw, out)
+			return
+		}
+		if h, err := treeHash(oldDir); err != nil || h != newTree {
+			c.failClass(ht, "ApplyResult", "the printed diff applied to the old tree gives %s, the new tree is %s (%v)\n%s", h, newTree, err, out)
+			return
+		}
+		// apply the reversed diff to the new tree
+		rev, err := diff.ReverseMultiFileDiff(fds)
+		if err != nil {
+			c.failClass(ht, "Reverse", "ReverseMultiFileDiff: %v\n%s", err, raw)
+			return
+		}
+		if Known.reverseBinaryPatchForward {
+			// the library leaves the forward and reverse sections of a binary patch in place;
+			// swap them here so that the rest of the reversed diff is still checked
+			for _, fd := range rev {
+				if fixed, ok := swapBinaryLiterals(fd.Extended); ok {
+					c.count("known binary reverse")
+					fd.Extended = fixed
+				}
+			}
+		}
+		rout, err := diff.PrintMultiFileDiff(rev)
+		if err != nil {
+			c.failClass(ht, "PrintReverse", "PrintMultiFileDiff(reverse): %v", err)
+			return
+		}
+		if err := writeTree(newDir, new); err != nil {
+			ht.Skipf("write: %v", err)
+		}
+		if _, err := treeHash(newDir); err != nil {
+			ht.Skipf("%v", err)
+		}
+		if _, err := gitRun(newDir, rout, "apply", "--binary", "--whitespace=nowarn", "--unidiff-zero"); err != nil {
+			c.failClass(ht, "ReverseApply", "git apply rejects the reversed diff (git %v): %v\nGIT:\n%s\nREVERSED:\n%s", args, err, raw, rout)
+			return
+		}
+		if h, err := treeHash(newDir); err != nil || h != oldTree {
+			c.failClass(ht, "ReverseResult", "the reversed diff applied to the new tree gives %s, the old tree is %s (%v)\nGIT:\n%s\nREVERSED:\n%s", h, oldTree, err, raw, rout)
+			return
+		}
+		c.count(fmt.Sprintf("ok files=%d binary=%v", len(fds), binary))
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..060d6b9
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,325 @@
+package hegel
+
+// Generators for texts and edits, the external tools (GNU diff, patch, git) and a model of
+// what a parsed FileDiff means: hunks applied to the old text must give the new text.
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/sourcegraph/go-diff/diff"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- texts
+
+// lineWords are the contents lines are drawn from: few distinct values so that diffs contain
+// moves and repeated lines, plus lines that look like diff syntax (`--`, `++`, `@@`, `\`).
+var lineWords = []string{"a", "b", "c", "d", "aa", "", " ", "--x", "++y", "-", "+", "@@ -1 +1 @@", "\\ z", "a b\tc"}
+
+// genLines draws 0..n content lines (without newlines).
+func genLines(tc hegel.TestCase, n int) []string {
+	k := drawInt(tc, 0, n)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = pick(tc, lineWords)
+	}
+	return out
+}
+
+// mutate applies 1..4 random line edits (insert, delete, replace, swap) to a copy of lines.
+func mutate(tc hegel.TestCase, lines []string) []string {
+	out := append([]string(nil), lines...)
+	for k := drawInt(tc, 1, 4); k > 0; k-- {
+		switch drawInt(tc, 0, 3) {
+		case 0: // insert
+			i := drawInt(tc, 0, len(out))
+			out = append(out[:i], append([]string{pick(tc, lineWords)}, out[i:]...)...)
+		case 1: // delete
+			if len(out) > 0 {
+				i := drawInt(tc, 0, len(out)-1)
+				out = append(out[:i], out[i+1:]...)
+			}
+		case 2: // replace
+			if len(out) > 0 {
+				out[drawInt(tc, 0, len(out)-1)] = pick(tc, lineWords)
+			}
+		case 3: // swap
+			if len(out) > 1 {
+				i, j := drawInt(tc, 0, len(out)-1), drawInt(tc, 0, len(out)-1)
+				out[i], out[j] = out[j], out[i]
+			}
+		}
+	}
+	return out
+}
+
+// joinText joins lines with eol, the last one with or without it.
+func joinText(lines []string, eol string, finalEOL bool) string {
+	if len(lines) == 0 {
+		return ""
+	}
+	s := strings.Join(lines, eol)
+	if finalEOL {
+		s += eol
+	}
+	return s
+}
+
+// textPair draws an old and a new text: the new one is a mutation of the old, each with or
+// without a final newline; eol is "\n" or "\r\n".
+func textPair(tc hegel.TestCase) (old, new, eol string) {
+	eol = "\n"
+	if chance(tc, 15) {
+		eol = "\r\n"
+	}
+	lines := genLines(tc, 12)
+	var newLines []string
+	if chance(tc, 10) {
+		newLines = genLines(tc, 12) // unrelated texts
+	} else {
+		newLines = mutate(tc, lines)
+	}
+	old = joinText(lines, eol, chance(tc, 85))
+	new = joinText(newLines, eol, chance(tc, 85))
+	return old, new, eol
+}
+
+// --------------------------------------------------------------------------- tools
+
+// diffU runs GNU diff -U<ctx> on two texts and returns the unified diff (empty if equal).
+func diffU(old, new string, ctx int, extra ...string) ([]byte, error) {
+	dir, err := os.MkdirTemp("", "godiff")
+	if err != nil {
+		return nil, err
+	}
+	defer os.RemoveAll(dir)
+	a, b := filepath.Join(dir, "old.txt"), filepath.Join(dir, "new.txt")
+	if err := os.WriteFile(a, []byte(old), 0o644); err != nil {
+		return nil, err
+	}
+	if err := os.WriteFile(b, []byte(new), 0o644); err != nil {
+		return nil, err
+	}
+	args := append([]string{fmt.Sprintf("-U%d", ctx)}, extra...)
+	args = append(args, "old.txt", "new.txt")
+	cmd := exec.Command("diff", args...)
+	cmd.Dir = dir
+	out, err := cmd.Output()
+	if ee, ok := err.(*exec.ExitError); ok && ee.ExitCode() == 1 {
+		err = nil // files differ
+	}
+	return out, err
+}
+
+// patchApply runs GNU patch (strict: no fuzz, binary) with the diff on a file holding text and
+// returns the patched text.
+func patchApply(text string, patch []byte, reverse bool) (string, error) {
+	dir, err := os.MkdirTemp("", "godiff")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(dir)
+	target := filepath.Join(dir, "target.txt")
+	if err := os.WriteFile(target, []byte(text), 0o644); err != nil {
+		return "", err
+	}
+	args := []string{"--binary", "--fuzz=0", "--quiet", "-o", filepath.Join(dir, "out.txt")}
+	if reverse {
+		args = append(args, "-R")
+	}
+	args = append(args, target)
+	cmd := exec.Command("patch", args...)
+	cmd.Stdin = bytes.NewReader(patch)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("patch: %v: %s", err, bytes.TrimSpace(out))
+	}
+	res, err := os.ReadFile(filepath.Join(dir, "out.txt"))
+	return string(res), err
+}
+
+// --------------------------------------------------------------------------- model
+
+// bodyLine is one line of a hunk body: its prefix, content (without newline) and whether it
+// ends with a newline in the file(s) it belongs to.
+type bodyLine struct {
+	prefix  byte
+	content string
+	eol     bool
+}
+
+// splitBody reads a Hunk's Body with go-diff's conventions: every line is newline-terminated
+// in Body; OrigNoNewlineAt marks the offset after which the original had no newline; a Body
+// without a final newline means the new side (or a shared context line) had none.
+func splitBody(h *diff.Hunk) ([]bodyLine, error) {
+	var lines []bodyLine
+	body := h.Body
+	off := 0
+	for len(body) > 0 {
+		i := bytes.IndexByte(body, '\n')
+		var raw []byte
+		eol := true
+		if i < 0 {
+			raw, body, eol = body, nil, false
+			off += len(raw)
+		} else {
+			raw, body = body[:i], body[i+1:]
+			off += i + 1
+			if h.OrigNoNewlineAt > 0 && int(h.OrigNoNewlineAt) == off {
+				eol = false
+			}
+		}
+		if len(raw) == 0 {
+			return nil, fmt.Errorf("empty body line")
+		}
+		switch raw[0] {
+		case ' ', '-', '+':
+		default:
+			return nil, fmt.Errorf("body line with prefix %q", raw[0])
+		}
+		lines = append(lines, bodyLine{prefix: raw[0], content: string(raw[1:]), eol: eol})
+	}
+	return lines, nil
+}
+
+// fileLine is a line of a text: content and whether it ends with a newline.
+type fileLine struct {
+	content string
+	eol     bool
+}
+
+func splitText(s string) []fileLine {
+	var out []fileLine
+	for len(s) > 0 {
+		i := strings.IndexByte(s, '\n')
+		if i < 0 {
+			out = append(out, fileLine{s, false})
+			break
+		}
+		out = append(out, fileLine{s[:i], true})
+		s = s[i+1:]
+	}
+	return out
+}
+
+func joinLines(ls []fileLine) string {
+	var b strings.Builder
+	for _, l := range ls {
+		b.WriteString(l.content)
+		if l.eol {
+			b.WriteByte('\n')
+		}
+	}
+	return b.String()
+}
+
+// applyHunks applies the parsed hunks to the old text as a unified-diff consumer would (strict:
+// positions exact, context must match) and returns the new text.
+func applyHunks(old string, hunks []*diff.Hunk) (string, error) {
+	oldLines := splitText(old)
+	var out []fileLine
+	pos := 0 // old lines consumed
+	for hi, h := range hunks {
+		lines, err := splitBody(h)
+		if err != nil {
+			return "", fmt.Errorf("hunk %d: %v", hi+1, err)
+		}
+		var nOrig, nNew int32
+		for _, l := range lines {
+			if l.prefix != '+' {
+				nOrig++
+			}
+			if l.prefix != '-' {
+				nNew++
+			}
+		}
+		if nOrig != h.OrigLines || nNew != h.NewLines {
+			return "", fmt.Errorf("hunk %d: header -%d,%d +%d,%d but body has %d orig and %d new lines", hi+1, h.OrigStartLine, h.OrigLines, h.NewStartLine, h.NewLines, nOrig, nNew)
+		}
+		start := int(h.OrigStartLine) - 1
+		if h.OrigLines == 0 {
+			start = int(h.OrigStartLine) // an insertion after line N is written -N,0
+		}
+		if start < pos || start > len(oldLines) {
+			return "", fmt.Errorf("hunk %d: original start %d out of order (at %d of %d lines)", hi+1, h.OrigStartLine, pos, len(oldLines))
+		}
+		if int32(len(out))+int32(start-pos) != h.NewStartLine-1 && !(h.NewLines == 0 && int32(len(out))+int32(start-pos) == h.NewStartLine) {
+			return "", fmt.Errorf("hunk %d: new start %d but %d new lines precede it", hi+1, h.NewStartLine, len(out)+start-pos)
+		}
+		out = append(out, oldLines[pos:start]...)
+		pos = start
+		for _, l := range lines {
+			if l.prefix != '+' {
+				if pos >= len(oldLines) {
+					return "", fmt.Errorf("hunk %d: %q beyond the end of the original", hi+1, l.content)
+				}
+				if got := oldLines[pos]; got.content != l.content || got.eol != l.eol {
+					return "", fmt.Errorf("hunk %d: original line %d is %q (eol %v), hunk says %q (eol %v)", hi+1, pos+1, got.content, got.eol, l.content, l.eol)
+				}
+				pos++
+			}
+			if l.prefix != '-' {
+				out = append(out, fileLine{l.content, l.eol})
+			}
+		}
+	}
+	out = append(out, oldLines[pos:]...)
+	return joinLines(out), nil
+}
+
+// countSigns counts the + and - lines of a hunk body.
+func countSigns(h *diff.Hunk) (plus, minus int32) {
+	for _, l := range bytes.Split(h.Body, []byte{'\n'}) {
+		if len(l) == 0 {
+			continue
+		}
+		switch l[0] {
+		case '+':
+			plus++
+		case '-':
+			minus++
+		}
+	}
+	return
+}
+
+// headerLookalike reports whether the hunk bodies of a unified diff contain a line starting
+// with --- followed by one starting with +++ followed by a hunk header: go-diff's parser takes
+// that for the file header of a next file (bug 2). The first two lines are the real header.
+func headerLookalike(raw []byte) bool {
+	lines := bytes.Split(raw, []byte{'\n'})
+	for i := 2; i+2 < len(lines); i++ {
+		if bytes.HasPrefix(lines[i], []byte("---")) && bytes.HasPrefix(lines[i+1], []byte("+++")) && bytes.HasPrefix(lines[i+2], []byte("@@ ")) {
+			return true
+		}
+	}
+	return false
+}
+
+// headerLookalikeMulti is headerLookalike for a multi-file diff: the ---/+++/@@ triple must
+// follow a hunk line (a real file header follows git's extended headers).
+func headerLookalikeMulti(raw []byte) bool {
+	lines := bytes.Split(raw, []byte{'\n'})
+	for i := 1; i+2 < len(lines); i++ {
+		prev := lines[i-1]
+		if len(prev) == 0 || bytes.IndexByte([]byte(" -+\\@"), prev[0]) < 0 {
+			continue
+		}
+		if bytes.HasPrefix(lines[i], []byte("---")) && bytes.HasPrefix(lines[i+1], []byte("+++")) && bytes.HasPrefix(lines[i+2], []byte("@@ ")) {
+			return true
+		}
+	}
+	return false
+}
+
+// stripCR removes a carriage return before every newline and at the end of the text (what
+// go-diff's default ParseOptions do to every line it reads).
+func stripCR(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	return strings.TrimSuffix(s, "\r")
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
