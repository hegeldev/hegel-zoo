+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/sourcegraph/go-diff/diff"
+)
+
+// go-diff/1: the reverse of a git binary patch applies the reverse section first (git writes
+// the forward section, then the reverse one; git apply -R uses the second).
+func TestHegelPinReverseBinaryPatch(t *testing.T) {
+	raw := "diff --git a/bin.dat b/bin.dat\n" +
+		"index eaf36c1daccfdf325514461cd1a2ffbc139b5464..79c2fd402663fb606906e8e3dd5bdc983e8f648a 100644\n" +
+		"GIT binary patch\nliteral 2\nJcmd<&1ONaX022TJ\n\nliteral 4\nLcmZQzWMT#Y01f~L\n\n"
+	fd, err := diff.ParseFileDiff([]byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	rev, err := diff.ReverseFileDiff(fd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "diff --git b/bin.dat a/bin.dat\n" +
+		"index 79c2fd402663fb606906e8e3dd5bdc983e8f648a..eaf36c1daccfdf325514461cd1a2ffbc139b5464 100644\n" +
+		"GIT binary patch\nliteral 4\nLcmZQzWMT#Y01f~L\n\nliteral 2\nJcmd<&1ONaX022TJ\n\n"
+	if got := strings.Join(rev.Extended, "\n") + "\n"; got != want {
+		t.Errorf("reversed binary patch:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+// go-diff/3: a file name ending in a space keeps it; git ends such a name with a tab.
+func TestHegelPinTrailingSpaceName(t *testing.T) {
+	raw := "diff --git a/t  b/t \nindex 7898192..6178079 100644\n--- a/t \t\n+++ b/t \t\n@@ -1 +1 @@\n-a\n+b\n"
+	fd, err := diff.ParseFileDiff([]byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fd.OrigName != "a/t " || fd.NewName != "b/t " {
+		t.Errorf("names parsed as %q and %q, want %q and %q", fd.OrigName, fd.NewName, "a/t ", "b/t ")
+	}
+}
+
+// go-diff/2: a hunk whose removed line starts with -- and whose added line starts with ++ is
+// still a hunk when another hunk follows; the counts in the hunk header say so.
+func TestHegelPinDashLinesInHunk(t *testing.T) {
+	old := "c\n--x\nd\n++y\n"
+	new := "b\n++y\nd\n--x\n"
+	raw := "--- old.txt\n+++ new.txt\n@@ -1 +1 @@\n-c\n+b\n@@ -2 +2 @@\n---x\n+++y\n@@ -4 +4 @@\n-++y\n+--x\n"
+	fd, err := diff.ParseFileDiff([]byte(raw))
+	if err != nil {
+		t.Fatalf("ParseFileDiff: %v", err)
+	}
+	if got, err := applyHunks(old, fd.Hunks); err != nil || got != new {
+		t.Errorf("hunks apply to %q, %v; want %q\n%s", got, err, new, hunksString(fd.Hunks))
+	}
+	// with a space after the dashes the lines look exactly like a file header
+	raw2 := "--- old.txt\n+++ new.txt\n@@ -1 +1 @@\n-c\n+b\n@@ -2 +2 @@\n--- x\n+++ y\n@@ -4 +4 @@\n-+ y\n+- x\n"
+	fds, err := diff.ParseMultiFileDiff([]byte(raw2))
+	if err != nil {
+		t.Fatalf("ParseMultiFileDiff: %v", err)
+	}
+	if len(fds) != 1 || len(fds[0].Hunks) != 3 {
+		t.Errorf("ParseMultiFileDiff read %d files (first with %d hunks), want 1 file with 3 hunks", len(fds), len(fds[0].Hunks))
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..872899d
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,365 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sourcegraph/go-diff/diff"
+	"hegel.dev/go/hegel"
+)
+
+// canonRaw rewrites a unified diff the way go-diff prints it where the format allows several
+// spellings: hunk ranges of one line are written N,1 (diff and git write N), and the tab git
+// appends to a file name containing spaces is dropped.
+var rangeRe = regexp.MustCompile(`^@@ -(\d+)(,\d+)? \+(\d+)(,\d+)? @@`)
+
+func canonRaw(raw []byte) []byte {
+	lines := strings.SplitAfter(string(raw), "\n")
+	for i, l := range lines {
+		if m := rangeRe.FindStringSubmatch(l); m != nil {
+			o, n := m[2], m[4]
+			if o == "" {
+				o = ",1"
+			}
+			if n == "" {
+				n = ",1"
+			}
+			lines[i] = fmt.Sprintf("@@ -%s%s +%s%s @@%s", m[1], o, m[3], n, l[len(m[0]):])
+		} else if strings.HasPrefix(l, "--- ") || strings.HasPrefix(l, "+++ ") {
+			lines[i] = strings.TrimSuffix(strings.TrimSuffix(l, "\n"), "\t") + "\n"
+		}
+	}
+	return []byte(strings.Join(lines, ""))
+}
+
+// ---------------------------------------------------------------------------
+
+// TestHegelParseUnified: GNU diff's unified diff of two texts parses into hunks whose ranges
+// match their bodies and which, applied to the old text, give the new text; the FileDiff
+// prints back to the same diff; Stat is consistent with the body.
+func TestHegelParseUnified(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		old, new, eol := textPair(ht)
+		ctx := drawInt(ht, 0, 3)
+		var extra []string
+		if chance(ht, 20) {
+			extra = append(extra, "-p")
+		}
+		raw, err := diffU(old, new, ctx, extra...)
+		if err != nil {
+			ht.Skipf("diff: %v", err)
+		}
+		if len(raw) == 0 {
+			c.count("equal texts")
+			return
+		}
+		keepCR := eol == "\r\n" && chance(ht, 70)
+		opts := diff.ParseOptions{KeepCR: keepCR}
+		wantOld, wantNew, wantRaw := old, new, canonRaw(raw)
+		if !keepCR {
+			wantOld, wantNew, wantRaw = stripCR(old), stripCR(new), canonRaw([]byte(stripCR(string(raw))))
+		}
+		fd, err := diff.ParseFileDiffOptions(raw, opts)
+		if Known.dashLinesReadAsFileHeader && headerLookalike(raw) {
+			if err == nil {
+				c.failClass(ht, "Lookalike", "a diff with ---/+++/@@ lines in a hunk body parsed without error (bug 2 fixed?)\n%s", raw)
+			}
+			c.count("known header lookalike")
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "Parse", "ParseFileDiff(diff -U%d %v) of %q -> %q: %v\n%s", ctx, extra, old, new, err, raw)
+			return
+		}
+		if !strings.HasSuffix(fd.OrigName, "old.txt") || !strings.HasSuffix(fd.NewName, "new.txt") || fd.OrigTime == nil || fd.NewTime == nil {
+			c.failClass(ht, "Header", "file header parsed as %q %v / %q %v from\n%s", fd.OrigName, fd.OrigTime, fd.NewName, fd.NewTime, raw)
+			return
+		}
+		got, err := applyHunks(wantOld, fd.Hunks)
+		if err != nil {
+			c.failClass(ht, "Apply", "hunks of diff -U%d %v of %q -> %q do not apply: %v\n%s\nhunks: %s", ctx, extra, old, new, err, raw, hunksString(fd.Hunks))
+			return
+		}
+		if got != wantNew {
+			c.failClass(ht, "Result", "hunks of diff -U%d %v of %q -> %q give %q\n%s\nhunks: %s", ctx, extra, old, new, got, raw, hunksString(fd.Hunks))
+			return
+		}
+		pos := int32(1)
+		for i, h := range fd.Hunks {
+			if h.StartPosition != pos {
+				c.failClass(ht, "StartPosition", "hunk %d StartPosition %d, want %d\n%s", i+1, h.StartPosition, pos, raw)
+				return
+			}
+			pos += 1 + int32(bytes.Count(h.Body, []byte{'\n'}))
+			if !bytes.HasSuffix(h.Body, []byte{'\n'}) && len(h.Body) > 0 {
+				pos++
+			}
+			if h.OrigNoNewlineAt > 0 {
+				pos++
+			}
+		}
+		out, err := diff.PrintFileDiff(fd)
+		if err != nil {
+			c.failClass(ht, "Print", "PrintFileDiff: %v\n%s", err, raw)
+			return
+		}
+		if !bytes.Equal(out, wantRaw) {
+			c.failClass(ht, "Reprint", "PrintFileDiff differs from the diff (KeepCR %v)\nRAW:\n%s\nPRINTED:\n%s", keepCR, wantRaw, out)
+			return
+		}
+		// Stat: changed lines are counted once, added and deleted lines once each.
+		var plus, minus int32
+		for _, h := range fd.Hunks {
+			p, m := countSigns(h)
+			plus += p
+			minus += m
+		}
+		st := fd.Stat()
+		if st.Added+st.Changed != plus || st.Deleted+st.Changed != minus || st.Changed < 0 || st.Added < 0 || st.Deleted < 0 {
+			c.failClass(ht, "Stat", "Stat %+v for %d + and %d - lines\n%s", st, plus, minus, raw)
+			return
+		}
+		c.count(fmt.Sprintf("ok ctx=%d", ctx))
+	})
+}
+
+func hunksString(hs []*diff.Hunk) string {
+	var b strings.Builder
+	for _, h := range hs {
+		fmt.Fprintf(&b, "\n  @@ -%d,%d +%d,%d @@ nn=%d sp=%d sec=%q body=%q", h.OrigStartLine, h.OrigLines, h.NewStartLine, h.NewLines, h.OrigNoNewlineAt, h.StartPosition, h.Section, h.Body)
+	}
+	return b.String()
+}
+
+// TestHegelReverse: the reverse of a parsed diff applies to the new text and gives the old one
+// (by the model and by GNU patch), and reversing twice gives the original diff back.
+func TestHegelReverse(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		old, new, _ := textPair(ht)
+		ctx := drawInt(ht, 0, 3)
+		raw, err := diffU(old, new, ctx)
+		if err != nil {
+			ht.Skipf("diff: %v", err)
+		}
+		if len(raw) == 0 {
+			c.count("equal texts")
+			return
+		}
+		wantOld, wantNew := stripCR(old), stripCR(new)
+		fd, err := diff.ParseFileDiff(raw)
+		if err != nil {
+			ht.Skipf("parse: %v", err) // TestHegelParseUnified's business
+		}
+		if got, err := applyHunks(wantOld, fd.Hunks); err != nil || got != wantNew {
+			ht.Skipf("forward hunks do not apply: %v", err)
+		}
+		rev, err := diff.ReverseFileDiff(fd)
+		if err != nil {
+			c.failClass(ht, "Reverse", "ReverseFileDiff: %v\n%s", err, raw)
+			return
+		}
+		if rev.OrigName != fd.NewName || rev.NewName != fd.OrigName || !timeEq(rev.OrigTime, fd.NewTime) || !timeEq(rev.NewTime, fd.OrigTime) {
+			c.failClass(ht, "Names", "reversed header %q %v / %q %v from %q %v / %q %v", rev.OrigName, rev.OrigTime, rev.NewName, rev.NewTime, fd.OrigName, fd.OrigTime, fd.NewName, fd.NewTime)
+			return
+		}
+		got, err := applyHunks(wantNew, rev.Hunks)
+		if err != nil {
+			c.failClass(ht, "Apply", "reversed hunks of %q -> %q do not apply to the new text: %v\n%s\nreversed: %s", old, new, err, raw, hunksString(rev.Hunks))
+			return
+		}
+		if got != wantOld {
+			c.failClass(ht, "Result", "reversed hunks of %q -> %q give %q\n%s\nreversed: %s", old, new, got, raw, hunksString(rev.Hunks))
+			return
+		}
+		out, err := diff.PrintFileDiff(rev)
+		if err != nil {
+			c.failClass(ht, "Print", "PrintFileDiff(reverse): %v", err)
+			return
+		}
+		patched, err := patchApply(wantNew, out, false)
+		if err != nil {
+			c.failClass(ht, "Patch", "patch rejects the reversed diff of %q -> %q: %v\n%s", old, new, err, out)
+			return
+		}
+		if patched != wantOld {
+			c.failClass(ht, "PatchResult", "patch with the reversed diff gives %q, want %q\n%s", patched, wantOld, out)
+			return
+		}
+		back, err := diff.ReverseFileDiff(rev)
+		if err != nil {
+			c.failClass(ht, "Reverse2", "ReverseFileDiff(reverse): %v", err)
+			return
+		}
+		fwd, _ := diff.PrintFileDiff(fd)
+		back2, _ := diff.PrintFileDiff(back)
+		if !bytes.Equal(fwd, back2) {
+			c.failClass(ht, "Involution", "reversing twice changes the diff\nONCE:\n%s\nTWICE:\n%s", fwd, back2)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+func timeEq(a, b *time.Time) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return a.Equal(*b)
+}
+
+// ---------------------------------------------------------------------------
+
+var extendedSets = [][]string{
+	nil,
+	{"diff --git a/f.txt b/f.txt", "index 0123456..789abcd 100644"},
+	{"diff --git a/f.txt b/g.txt", "similarity index 80%", "rename from f.txt", "rename to g.txt", "index 0123456..789abcd 100644"},
+	{"diff --git a/f.txt b/f.txt", "old mode 100644", "new mode 100755", "index 0123456..789abcd"},
+	{"diff -u old/f.txt new/f.txt"},
+	{"random preamble line", "another"},
+}
+
+var nameSet = []string{"f.txt", "a/f.txt", "b/f.txt", "/dev/null", "dir/sub/name-with_chars.go", "x"}
+
+// genHunk draws a hunk whose body agrees with its header and whose no-newline markers are
+// placed where go-diff's parser would place them.
+func genHunk(tc hegel.TestCase, origStart, newStart int32, last bool) *diff.Hunk {
+	h := &diff.Hunk{OrigStartLine: origStart, NewStartLine: newStart}
+	if chance(tc, 30) {
+		h.Section = pick(tc, []string{"func main()", "section", "a b", "@@", "x"})
+	}
+	n := drawInt(tc, 1, 6)
+	var body []byte
+	lastPrefix := byte(0)
+	for i := 0; i < n; i++ {
+		p := pick(tc, []byte{' ', '-', '+'})
+		body = append(body, p)
+		body = append(body, pick(tc, lineWords)...)
+		body = append(body, '\n')
+		if p != '+' {
+			h.OrigLines++
+		}
+		if p != '-' {
+			h.NewLines++
+		}
+		lastPrefix = p
+	}
+	if last && chance(tc, 30) {
+		// the last line of one or both sides has no newline
+		switch {
+		case lastPrefix == '-':
+			h.OrigNoNewlineAt = int32(len(body))
+		case lastPrefix == ' ':
+			body = body[:len(body)-1] // both sides
+		default:
+			body = body[:len(body)-1] // new side
+		}
+	}
+	h.Body = body
+	return h
+}
+
+func genFileDiff(tc hegel.TestCase) *diff.FileDiff {
+	fd := &diff.FileDiff{OrigName: pick(tc, nameSet), NewName: pick(tc, nameSet)}
+	if chance(tc, 40) {
+		ts := time.Date(2009+drawInt(tc, 0, 15), time.Month(drawInt(tc, 1, 12)), drawInt(tc, 1, 28), drawInt(tc, 0, 23), drawInt(tc, 0, 59), drawInt(tc, 0, 59), drawInt(tc, 0, 999999999), time.FixedZone("", drawInt(tc, -12, 12)*3600))
+		fd.OrigTime = &ts
+	}
+	if chance(tc, 40) {
+		ts := time.Date(2009+drawInt(tc, 0, 15), time.Month(drawInt(tc, 1, 12)), drawInt(tc, 1, 28), drawInt(tc, 0, 23), drawInt(tc, 0, 59), drawInt(tc, 0, 59), 0, time.UTC)
+		fd.NewTime = &ts
+	}
+	fd.Extended = pick(tc, extendedSets)
+	n := drawInt(tc, 1, 3)
+	origStart, newStart := int32(1), int32(1)
+	for i := 0; i < n; i++ {
+		h := genHunk(tc, origStart, newStart, i == n-1)
+		fd.Hunks = append(fd.Hunks, h)
+		gap := int32(drawInt(tc, 1, 5))
+		origStart += h.OrigLines + gap
+		newStart += h.NewLines + gap
+	}
+	return fd
+}
+
+// TestHegelStructRoundTrip: a FileDiff printed by PrintFileDiff and parsed by ParseFileDiff is
+// the same FileDiff, and a Hunk list printed by PrintHunks and read by ParseHunks is the same
+// list.
+func TestHegelStructRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		fd := genFileDiff(ht)
+		want := *fd
+		want.Hunks = nil
+		pos := int32(1)
+		for _, h := range fd.Hunks {
+			hc := *h
+			hc.StartPosition = pos
+			pos += 1 + int32(bytes.Count(h.Body, []byte{'\n'}))
+			want.Hunks = append(want.Hunks, &hc)
+		}
+		out, err := diff.PrintFileDiff(fd)
+		if err != nil {
+			c.failClass(ht, "Print", "PrintFileDiff: %v", err)
+			return
+		}
+		got, err := diff.ParseFileDiff(out)
+		if Known.dashLinesReadAsFileHeader && headerLookalike(out[len(out)-len(hunksOnly(out)):]) {
+			c.count("known header lookalike")
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "Parse", "ParseFileDiff of a printed FileDiff: %v\n%s\nwant: %s", err, out, fdDump(&want))
+			return
+		}
+		if !fileDiffEq(got, &want) {
+			c.failClass(ht, "Mismatch", "round trip changes the FileDiff\n%s\nwant: %s\ngot:  %s", out, fdDump(&want), fdDump(got))
+			return
+		}
+		hout, err := diff.PrintHunks(fd.Hunks)
+		if err != nil {
+			c.failClass(ht, "PrintHunks", "PrintHunks: %v", err)
+			return
+		}
+		hs, err := diff.ParseHunks(hout)
+		if err != nil {
+			c.failClass(ht, "ParseHunks", "ParseHunks of printed hunks: %v\n%s", err, hout)
+			return
+		}
+		if !reflect.DeepEqual(hs, want.Hunks) {
+			c.failClass(ht, "HunksMismatch", "hunk round trip differs\n%s\nwant: %s\ngot:  %s", hout, hunksString(want.Hunks), hunksString(hs))
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// hunksOnly returns the part of a printed file diff from its first hunk header on, preceded by
+// two lines so that headerLookalike skips nothing of it.
+func hunksOnly(out []byte) []byte {
+	i := bytes.Index(out, []byte("\n@@ "))
+	if i < 0 {
+		return nil
+	}
+	return append([]byte("--- x\n+++ y"), out[i:]...)
+}
+
+func fileDiffEq(a, b *diff.FileDiff) bool {
+	if a.OrigName != b.OrigName || a.NewName != b.NewName || !timeEq(a.OrigTime, b.OrigTime) || !timeEq(a.NewTime, b.NewTime) {
+		return false
+	}
+	if len(a.Extended) != len(b.Extended) || (len(a.Extended) > 0 && !reflect.DeepEqual(a.Extended, b.Extended)) {
+		return false
+	}
+	return reflect.DeepEqual(a.Hunks, b.Hunks)
+}
+
+func fdDump(fd *diff.FileDiff) string {
+	return fmt.Sprintf("orig=%q %v new=%q %v ext=%q%s", fd.OrigName, fd.OrigTime, fd.NewName, fd.NewTime, fd.Extended, hunksString(fd.Hunks))
+}
