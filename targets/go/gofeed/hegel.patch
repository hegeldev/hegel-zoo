+// --------------------------------------------------------------------------- properties
+
+func parseFeed(ht *hegel.T, c *collector, doc string) (*gofeed.Feed, bool) {
+	f, err := gofeed.NewParser().ParseString(doc)
+	if err != nil {
+		c.fail(ht, "ParseString: %v\n%s", err, doc)
+		return nil, false
+	}
+	return f, true
+}
+
+func runFormat(t *testing.T, kind string) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m := genFeed(ht, kind)
+		doc := writeFeed(ht, m)
+		f, ok := parseFeed(ht, c, doc)
+		if !ok {
+			return
+		}
+		c.count(fmt.Sprintf("items=%d", len(m.items)))
+		if d := diffU(expect(m), uOf(f)); d != "" {
+			c.fail(ht, "%s\n%s", d, doc)
+			return
+		}
+		if kind == "json" {
+			return
+		}
+		// feedparser reads the same document as the model
+		view, perr := fpParse(ht, doc)
+		if perr != "" {
+			c.fail(ht, "feedparser: %s\n%s", perr, doc)
+			return
+		}
+		if view.Bozo {
+			c.fail(ht, "feedparser flags the document (bozo: %s)\n%s", view.BozoException, doc)
+			return
+		}
+		if d := fpDiff(fpExpect(m), view); d != "" {
+			c.fail(ht, "feedparser reads: %s\n%s", d, doc)
+		}
+	})
+}
+
+// TestHegelRSSFollowsTheModel: a model feed written as RSS 2.0 (any child order, any of the
+// equivalent text encodings, optional elements present or absent) parses to the documented
+// universal mapping, and feedparser reads the same values.
+func TestHegelRSSFollowsTheModel(t *testing.T) { runFormat(t, "rss") }
+
+// TestHegelAtomFollowsTheModel: the same for Atom 1.0 (text and html constructs, links with
+// and without rel, enclosure links, several authors, labelled categories).
+func TestHegelAtomFollowsTheModel(t *testing.T) { runFormat(t, "atom") }
+
+// TestHegelJSONFeedFollowsTheModel: the same for JSON Feed 1 and 1.1 (author or authors,
+// numeric ids, content_html or content_text, attachments), with no second reader.
+func TestHegelJSONFeedFollowsTheModel(t *testing.T) { runFormat(t, "json") }
