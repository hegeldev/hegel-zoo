+// TestHegelLowerCaseRFC3339Parses: RFC 3339 allows a lower-case t and z, so an Atom updated or
+// published written so parses to its instant, as feedparser parses it; the library's layouts
+// are upper case only and time.Parse is case-sensitive (gofeed/6).
+func TestHegelLowerCaseRFC3339Parses(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		l := hegel.Draw(ht, lowerCases)
+		f := parseOrFail(ht, l.doc())
+		want := l.spec.date().t
+		for _, got := range []struct {
+			what string
+			t    *time.Time
+		}{{"updated", f.UpdatedParsed}, {"entry published", f.Items[0].PublishedParsed}} {
+			if got.t == nil {
+				c.mismatch(ht, known("gofeed/6"), "%s %q does not parse", got.what, l.text())
+			} else if !got.t.Equal(want) {
+				c.fail(ht, "%s %q = %v, want %v", got.what, l.text(), got.t, want)
+			}
+		}
+	})
+}
