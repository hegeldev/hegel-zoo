+}
+
+// fpMisreads: layouts feedparser itself reads wrongly (year-first with a month name: the day
+// becomes the month; an ISO date followed by a zone name or by "at": the time is dropped;
+// 12-hour clocks: 12:00 AM is read as noon), left out of its comparison. So are offsets with
+// minutes (-0330, +0045): feedparser keeps their hours only.
+var fpMisreads = map[string]bool{"2006 January 02": true, "2006/01/02": true, "2006-01-02 15:04:05 MST": true, "2006-01-02 at 15:04:05": true}
+
+// zoneFix: gofeed's own correction of a parsed named zone.
+func zoneFix(t time.Time) time.Time {
+	if name, off := t.Zone(); name != "" {
+		if want, ok := zoneTable[name]; ok && want != off {
+			return time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.FixedZone(name, want))
+		}
+	}
+	return t
+}
+
+// TestHegelDatesFollowTheirLayout: a date written with any layout of gofeed's list parses (as
+// an RSS pubDate) to the instant time.Parse gives for that layout, with a zone name resolved by
+// the table; feedparser agrees whenever it reads the text at all.
+func TestHegelDatesFollowTheirLayout(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		layout := pick(ht, layouts)
+		named := strings.Contains(layout, "MST")
+		var loc *time.Location
+		switch {
+		case named:
+			name := pick(ht, zoneNames[1:]) // not UT: time.Parse wants three letters or more
+			loc = time.FixedZone(name, zoneTable[name])
+		case strings.Contains(layout, "-07") || strings.Contains(layout, "Z07"):
+			loc = time.FixedZone("", pick(ht, offsets))
+		default:
+			loc = time.UTC
+		}
+		tm := genInstant(ht, loc)
+		twoDigit := strings.Contains(layout, "06") && !strings.Contains(layout, "2006")
+		if twoDigit && Known.twoDigitYears {
+			// two-digit years: inside Go's 1969..2068 window (gofeed/7 for the RFC's rule)
+			tm = time.Date(1969+n(ht, 0, 99), tm.Month(), tm.Day(), tm.Hour(), tm.Minute(), tm.Second(), 0, loc)
+		}
+		text := tm.Format(layout)
+		want, err := time.Parse(layout, text)
+		if err != nil {
+			ht.Fatalf("time.Parse(%q, %q): %v", layout, text, err)
+		}
+		want = zoneFix(want)
+		c.count(fmt.Sprintf("named=%v", named))
+
+		doc := `<rss version="2.0"><channel><title>t</title><item><title>i</title><pubDate>` + text + `</pubDate></item></channel></rss>`
+		f, err := gofeed.NewParser().ParseString(doc)
+		if err != nil {
+			c.fail(ht, "ParseString: %v", err)
+			return
+		}
+		got := f.Items[0].PublishedParsed
+		if got == nil {
+			c.fail(ht, "pubDate %q (layout %q) does not parse", text, layout)
+			return
+		}
+		if !got.Equal(want) {
+			c.fail(ht, "pubDate %q (layout %q) = %v, want %v", text, layout, got.UTC(), want.UTC())
+			return
+		}
+		_, off := tm.Zone()
+		if twoDigit || fpMisreads[layout] || strings.Contains(layout, "PM") || strings.Contains(layout, "pm") || off%3600 != 0 {
+			c.count("feedparser-not-asked")
+			return
+		}
+		if fp := fpDate(ht, text); fp != "" {
+			if fp != want.UTC().Format("2006-01-02T15:04:05Z") {
+				c.fail(ht, "feedparser reads %q as %s, the layout %q gives %v", text, fp, layout, want.UTC())
+			}
+			c.count("feedparser-agrees")
+		} else {
+			c.count("feedparser-skips")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- detection and robustness
+
+// latin1 re-encodes a document whose runes all fit in ISO-8859-1 as such bytes, with an XML
+// declaration saying so; ok is false otherwise.
+func latin1(doc string) (string, bool) {
+	var b strings.Builder
+	for _, r := range doc {
+		if r > 255 {
+			return "", false
+		}
+		b.WriteByte(byte(r))
+	}
+	s := b.String()
+	if i := strings.Index(s, "?>"); strings.HasPrefix(s, "<?xml") && i > 0 {
+		s = s[i+2:]
+	}
+	return `<?xml version="1.0" encoding="ISO-8859-1"?>` + s, true
+}
+
+// caseFold flips the case of RSS element names (RSS is read case-insensitively).
+func caseFold(tc hegel.TestCase, doc string) string {
+	for _, name := range []string{"rss", "channel", "item", "title", "link", "description", "pubDate", "lastBuildDate", "guid", "category", "enclosure", "author", "managingEditor", "language", "copyright", "generator", "image", "url"} {
+		if !chance(tc, 40) {
+			continue
+		}
+		up := strings.ToUpper(name)
+		doc = strings.ReplaceAll(doc, "<"+name+">", "<"+up+">")
+		doc = strings.ReplaceAll(doc, "</"+name+">", "</"+up+">")
+		doc = strings.ReplaceAll(doc, "<"+name+" ", "<"+up+" ")
+	}
+	return doc
+}
+
+// TestHegelDetectionSurvivesTheProlog: a document with a byte order mark, an XML declaration,
+// comments, a DOCTYPE, leading whitespace, RSS element names in another case or an ISO-8859-1
+// encoding is detected as its type and parses to the same universal feed as the plain one;
+// every prefix of the document either parses or fails, without panic.
+func TestHegelDetectionSurvivesTheProlog(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, []string{"rss", "atom", "json"})
+		m := genFeed(ht, kind)
+		doc := writeFeed(ht, m)
+		base, err := gofeed.NewParser().ParseString(doc)
+		if err != nil {
+			c.fail(ht, "ParseString of the plain document: %v\n%s", err, doc)
+			return
+		}
+		want := uOf(base)
+
+		variant := doc
+		classes := []string{}
+		if kind != "json" {
+			if i := strings.Index(variant, "?>"); strings.HasPrefix(variant, "<?xml") && i > 0 {
+				variant = variant[i+2:]
+			}
+			prolog := ""
+			if chance(ht, 50) {
+				prolog += pick(ht, []string{`<?xml version="1.0"?>`, `<?xml version="1.0" encoding="UTF-8"?>`, `<?xml version='1.0' encoding='utf-8' standalone='yes'?>`})
+				classes = append(classes, "decl")
+			}
+			if chance(ht, 40) {
+				prolog += pick(ht, []string{"<!-- generated -->", "<!--\n multi\n line -->", "<!-- <rss> in a comment -->"})
+				classes = append(classes, "comment")
+			}
+			if chance(ht, 20) {
+				prolog += pick(ht, []string{"<!DOCTYPE rss>", "<!DOCTYPE feed>"})
+				classes = append(classes, "doctype")
+			}
+			if chance(ht, 30) {
+				prolog += pick(ht, []string{"<?xml-stylesheet type=\"text/xsl\" href=\"s.xsl\"?>", "<?pi data?>"})
+				classes = append(classes, "pi")
+			}
+			variant = prolog + pick(ht, []string{"", "\n", "\n\n"}) + variant
+			if kind == "rss" && chance(ht, 40) {
+				variant = caseFold(ht, variant)
+				classes = append(classes, "case")
+			}
+			if chance(ht, 25) {
+				if l, ok := latin1(variant); ok {
+					variant = l
+					classes = append(classes, "latin1")
+				}
+			}
+		}
+		if chance(ht, 40) && !(kind == "json" && Known.jsonBOM) {
+			variant = "\uFEFF" + variant
+			classes = append(classes, "bom")
+		}
+		variant = pick(ht, []string{"", " ", "\n", "\r\n\t"}) + variant
+		c.count(strings.Join(classes, "+"))
+
+		wantType := map[string]gofeed.FeedType{"rss": gofeed.FeedTypeRSS, "atom": gofeed.FeedTypeAtom, "json": gofeed.FeedTypeJSON}[kind]
+		if got := gofeed.DetectFeedType(strings.NewReader(variant)); got != wantType {
+			c.fail(ht, "DetectFeedType = %v, want %v (%s)\n%q", got, wantType, strings.Join(classes, "+"), variant)
+			return
+		}
+		f, err := gofeed.NewParser().ParseString(variant)
+		if err != nil {
+			c.fail(ht, "ParseString of the variant (%s): %v\n%q", strings.Join(classes, "+"), err, variant)
+			return
+		}
+		if d := diffU(want, uOf(f)); d != "" {
+			c.fail(ht, "the variant (%s) parses differently: %s\n%q", strings.Join(classes, "+"), d, variant)
+			return
+		}
+
+		// a prefix: no panic, and a bounded time
+		cut := n(ht, 0, len(variant))
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			defer func() {
+				if r := recover(); r != nil {
+					c.fail(ht, "panic on a prefix of %d bytes: %v\n%q", cut, r, variant[:cut])
+				}
+			}()
+			gofeed.NewParser().ParseString(variant[:cut])
+			gofeed.DetectFeedType(strings.NewReader(variant[:cut]))
+		}()
+		select {
+		case <-done:
+		case <-time.After(5 * time.Second):
+			c.fail(ht, "a prefix of %d bytes does not return\n%q", cut, variant[:cut])
+		}
+	})
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..7945f44
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,391 @@
+package gofeed_test
+
+// The feedparser (Python) oracle: one persistent child answering JSON lines with a projection
+// of the parsed feed.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+const pythonScript = `
+import sys, json, time, warnings
+warnings.filterwarnings("ignore")
+import feedparser
+
+def st(v):
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", v) if v else ""
+
+def person(d):
+    if not d:
+        return None
+    return {"name": d.get("name", ""), "email": d.get("email", "")}
+
+def view(d):
+    fd = d.feed
+    out = {"bozo": bool(d.bozo), "bozo_exception": str(getattr(d, "bozo_exception", "")), "version": d.version,
+           "feed": {"title": fd.get("title", ""), "link": fd.get("link", ""), "subtitle": fd.get("subtitle", ""),
+                    "language": fd.get("language") or "", "rights": fd.get("rights", ""), "generator": fd.get("generator", ""),
+                    "author": person(fd.get("author_detail")), "image": (fd.get("image") or {}).get("href", ""),
+                    "tags": [t.get("term", "") for t in fd.get("tags", [])],
+                    "updated": st(fd.get("updated_parsed")), "published": st(fd.get("published_parsed"))},
+           "entries": []}
+    for e in d.entries:
+        contents = e.get("content") or []
+        out["entries"].append({"title": e.get("title", ""), "link": e.get("link", ""), "id": e.get("id", ""),
+                               "summary": e.get("summary", ""), "content": contents[0]["value"] if contents else "",
+                               "published": st(e.get("published_parsed")), "updated": st(e.get("updated_parsed")),
+                               "authors": [person(a) for a in e.get("authors", []) if a],
+                               "tags": [t.get("term", "") for t in e.get("tags", [])],
+                               "enclosures": [{"href": x.get("href", ""), "type": x.get("type", ""), "length": x.get("length", "")} for x in e.get("enclosures", [])]})
+    return out
+
+for raw in sys.stdin:
+    raw = raw.strip()
+    if not raw:
+        continue
+    req = json.loads(raw)
+    try:
+        c = req["c"]
+        if c == "parse":
+            res = view(feedparser.parse(req["doc"].encode("utf-8")))
+        elif c == "date":
+            d = feedparser.parse(("<rss version=\"2.0\"><channel><item><pubDate>" + req["v"] + "</pubDate></item></channel></rss>").encode("utf-8"))
+            res = {"date": st(d.entries[0].get("published_parsed")) if d.entries else ""}
+        else:
+            res = {"error": "unknown command " + c}
+    except Exception as e:
+        res = {"error": type(e).__name__ + ": " + str(e)}
+    sys.stdout.write(json.dumps(res) + "\n")
+    sys.stdout.flush()
+import os
+os._exit(0)
+`
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+var (
+	oracleOnce sync.Once
+	oracleInst *pyChild
+	oracleErr  error
+)
+
+func oracle(t testing.TB) *pyChild {
+	t.Helper()
+	oracleOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			oracleErr = err
+			return
+		}
+		oracleInst = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	})
+	if oracleErr != nil {
+		t.Fatalf("starting the feedparser oracle: %v", oracleErr)
+	}
+	return oracleInst
+}
+
+type fpPerson struct {
+	Name  string `json:"name"`
+	Email string `json:"email"`
+}
+
+type fpEnc struct {
+	Href   string `json:"href"`
+	Type   string `json:"type"`
+	Length string `json:"length"`
+}
+
+type fpEntry struct {
+	Title      string     `json:"title"`
+	Link       string     `json:"link"`
+	ID         string     `json:"id"`
+	Summary    string     `json:"summary"`
+	Content    string     `json:"content"`
+	Published  string     `json:"published"`
+	Updated    string     `json:"updated"`
+	Authors    []fpPerson `json:"authors"`
+	Tags       []string   `json:"tags"`
+	Enclosures []fpEnc    `json:"enclosures"`
+}
+
+type fpFeedPart struct {
+	Title     string    `json:"title"`
+	Link      string    `json:"link"`
+	Subtitle  string    `json:"subtitle"`
+	Language  string    `json:"language"`
+	Rights    string    `json:"rights"`
+	Generator string    `json:"generator"`
+	Author    *fpPerson `json:"author"`
+	Image     string    `json:"image"`
+	Tags      []string  `json:"tags"`
+	Updated   string    `json:"updated"`
+	Published string    `json:"published"`
+}
+
+type fpView struct {
+	Error         string     `json:"error"`
+	Bozo          bool       `json:"bozo"`
+	BozoException string     `json:"bozo_exception"`
+	Version       string     `json:"version"`
+	Feed          fpFeedPart `json:"feed"`
+	Entries       []fpEntry  `json:"entries"`
+	Date          *string    `json:"date"`
+}
+
+func (p *pyChild) ask(t testing.TB, req map[string]any) fpView {
+	t.Helper()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle request: %v", err)
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if err := p.in.Flush(); err != nil {
+		t.Fatalf("oracle flush: %v", err)
+	}
+	line, err := p.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("oracle read: %v", err)
+	}
+	var rep fpView
+	if err := json.Unmarshal(line, &rep); err != nil {
+		t.Fatalf("oracle reply %q: %v", strings.TrimSpace(string(line)), err)
+	}
+	return rep
+}
+
+func fpParse(t testing.TB, doc string) (fpView, string) {
+	rep := oracle(t).ask(t, map[string]any{"c": "parse", "doc": doc})
+	return rep, rep.Error
+}
+
+// fpDate: feedparser's reading of a date string as an RSS pubDate ("" when it does not parse).
+func fpDate(t testing.TB, s string) string {
+	rep := oracle(t).ask(t, map[string]any{"c": "date", "v": s})
+	if rep.Error != "" {
+		t.Fatalf("feedparser date %q: %s", s, rep.Error)
+	}
+	if rep.Date == nil {
+		return ""
+	}
+	return *rep.Date
+}
+
+// skip marks a value the comparison leaves alone (HTML-typed or markup-bearing text, which
+// feedparser sanitizes).
+const skip = "\x00skip"
+
+func fpStamp(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.t.UTC().Format("2006-01-02T15:04:05Z")
+}
+
+// linkOrSkip: feedparser falls back to the id when there is no link.
+func linkOrSkip(s string) string {
+	if s == "" {
+		return skip
+	}
+	return s
+}
+
+func plainOrSkip(s string) string {
+	if isPlain(s) {
+		return s
+	}
+	return skip
+}
+
+// fpExpect: what feedparser reads for the model (its own mapping: RSS categories and Atom
+// terms are tags, the last Atom author is the author, labels are separate).
+func fpExpect(m *mfeed) fpView {
+	v := fpView{}
+	v.Feed = fpFeedPart{Title: plainOrSkip(m.title), Link: linkOrSkip(m.link), Subtitle: m.desc, Language: m.lang, Rights: m.copyright, Generator: m.generator, Tags: m.cats}
+	switch m.kind {
+	case "rss":
+		v.Version = "rss20"
+		v.Feed.Image = m.imageURL
+		v.Feed.Published = fpStamp(m.pub)
+		v.Feed.Updated = fpStamp(m.upd)
+		if m.upd == nil {
+			v.Feed.Updated = v.Feed.Published // feedparser mirrors published into updated
+		}
+		if m.author != nil {
+			v.Feed.Author = &fpPerson{m.author.name, m.author.email}
+		}
+	case "atom":
+		v.Version = "atom10"
+		v.Feed.Image = skip
+		v.Feed.Updated = fpStamp(m.upd)
+		if len(m.authors) > 0 {
+			a := fpMerged(m.authors)
+			v.Feed.Author = &a[len(a)-1]
+		}
+	}
+	for _, it := range m.items {
+		e := fpEntry{Title: plainOrSkip(it.title), Link: linkOrSkip(it.link), ID: it.guid, Summary: it.desc, Content: it.content, Tags: it.cats}
+		if it.titleHTML {
+			e.Title = skip
+		}
+		if it.desc == "" && it.content != "" {
+			e.Summary = skip // feedparser's summary falls back to the content
+		}
+		for _, x := range it.encs {
+			e.Enclosures = append(e.Enclosures, fpEnc{x.url, x.typ, x.length})
+		}
+		switch m.kind {
+		case "rss":
+			e.Published = fpStamp(it.pub)
+			e.Updated = fpStamp(it.upd)
+			if it.pub == nil {
+				e.Published = skip
+			}
+			if it.upd == nil {
+				e.Updated = e.Published
+			}
+			if it.author != nil {
+				e.Authors = []fpPerson{{it.author.name, it.author.email}}
+			}
+		case "atom":
+			e.Published = fpStamp(it.pub)
+			e.Updated = fpStamp(it.upd)
+			if it.upd == nil {
+				e.Updated = e.Published // feedparser mirrors published into updated
+			}
+			e.Authors = fpMerged(it.authors)
+		}
+		v.Entries = append(v.Entries, e)
+	}
+	return v
+}
+
+// fpMerged: feedparser's author_detail accumulates over the Atom authors of one element; a
+// field a later author lacks keeps the value of the author before it.
+func fpMerged(ps []mperson) []fpPerson {
+	var out []fpPerson
+	var cur fpPerson
+	for _, p := range ps {
+		if p.name != "" {
+			cur.Name = p.name
+		}
+		if p.email != "" {
+			cur.Email = p.email
+		}
+		out = append(out, cur)
+	}
+	return out
+}
+
+func fpDiff(want, got fpView) string {
+	cmp := func(field, w, g string) string {
+		if w == skip || w == g {
+			return ""
+		}
+		return fmt.Sprintf("%s = %q, want %q", field, g, w)
+	}
+	checks := []string{
+		cmp("version", want.Version, got.Version),
+		cmp("feed.title", want.Feed.Title, got.Feed.Title),
+		cmp("feed.link", want.Feed.Link, got.Feed.Link),
+		cmp("feed.subtitle", want.Feed.Subtitle, got.Feed.Subtitle),
+		cmp("feed.language", want.Feed.Language, got.Feed.Language),
+		cmp("feed.rights", want.Feed.Rights, got.Feed.Rights),
+		cmp("feed.generator", want.Feed.Generator, got.Feed.Generator),
+		cmp("feed.image", want.Feed.Image, got.Feed.Image),
+		cmp("feed.updated", want.Feed.Updated, got.Feed.Updated),
+		cmp("feed.published", want.Feed.Published, got.Feed.Published),
+	}
+	for _, c := range checks {
+		if c != "" {
+			return c
+		}
+	}
+	if !samePerson(want.Feed.Author, got.Feed.Author) {
+		return fmt.Sprintf("feed.author = %v, want %v", got.Feed.Author, want.Feed.Author)
+	}
+	if !sameStrings(want.Feed.Tags, got.Feed.Tags) {
+		return fmt.Sprintf("feed.tags = %q, want %q", got.Feed.Tags, want.Feed.Tags)
+	}
+	if len(want.Entries) != len(got.Entries) {
+		return fmt.Sprintf("%d entries, want %d", len(got.Entries), len(want.Entries))
+	}
+	for i := range want.Entries {
+		w, g := want.Entries[i], got.Entries[i]
+		p := fmt.Sprintf("entries[%d].", i)
+		for _, c := range []string{cmp(p+"title", w.Title, g.Title), cmp(p+"link", w.Link, g.Link), cmp(p+"id", w.ID, g.ID), cmp(p+"summary", w.Summary, g.Summary), cmp(p+"content", w.Content, g.Content), cmp(p+"published", w.Published, g.Published), cmp(p+"updated", w.Updated, g.Updated)} {
+			if c != "" {
+				return c
+			}
+		}
+		if !reflect.DeepEqual(nilPersons(w.Authors), nilPersons(g.Authors)) {
+			return fmt.Sprintf("%sauthors = %v, want %v", p, g.Authors, w.Authors)
+		}
+		if !sameStrings(w.Tags, g.Tags) {
+			return fmt.Sprintf("%stags = %q, want %q", p, g.Tags, w.Tags)
+		}
+		if !reflect.DeepEqual(nilEncs(w.Enclosures), nilEncs(g.Enclosures)) {
+			return fmt.Sprintf("%senclosures = %v, want %v", p, g.Enclosures, w.Enclosures)
+		}
+	}
+	return ""
+}
+
+func samePerson(a, b *fpPerson) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func nilPersons(ps []fpPerson) []fpPerson {
+	if len(ps) == 0 {
+		return nil
+	}
+	return ps
+}
+
+func nilEncs(es []fpEnc) []fpEnc {
+	if len(es) == 0 {
+		return nil
+	}
+	return es
+}
+
+var _ = time.Now
