+			c.mismatch(ht, known("gofeed/3"), "dc:creator %q read as %+v, want the name %q", refs(e.creator), it.Author, e.creator)
+		}
+		if !reflect.DeepEqual(it.Categories, []string{e.subject}) {
+			c.mismatch(ht, known("gofeed/3"), "dc:subject %q read as %q, want [%q]", refs(e.subject), it.Categories, e.subject)
