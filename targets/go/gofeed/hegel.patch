+
+// fpMisreads: layouts feedparser itself reads wrongly (year-first with a month name: the day
+// becomes the month; an ISO date followed by a zone name or by "at": the time is dropped;
+// 12-hour clocks: 12:00 AM is read as noon), left out of its comparison. So are offsets with
+// minutes (-0330, +0045): feedparser keeps their hours only.
+var fpMisreads = map[string]bool{"2006 January 02": true, "2006/01/02": true, "2006-01-02 15:04:05 MST": true, "2006-01-02 at 15:04:05": true}
+
+// zoneFix: gofeed's own correction of a parsed named zone.
+func zoneFix(t time.Time) time.Time {
+	if name, off := t.Zone(); name != "" {
+		if want, ok := zoneTable[name]; ok && want != off {
+			return time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.FixedZone(name, want))
+		}
+	}
+	return t
+}
+
+// twoDigit reports a layout writing the year with two digits.
+func twoDigit(layout string) bool {
+	return strings.Contains(layout, "06") && !strings.Contains(layout, "2006")
+}
+
+// rfc5322Year is the year RFC 5322 4.3 gives a two-digit year: 00..49 are 20xx, 50..99 19xx
+// (Go's rule, which the library follows, makes 50..68 20xx: gofeed/7).
+func rfc5322Year(t time.Time) time.Time {
+	yy := t.Year() % 100
+	y := 2000 + yy
+	if yy >= 50 {
+		y = 1900 + yy
+	}
+	return time.Date(y, t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), t.Location())
+}
+
+// dateCase: a layout and the instant written in it: a zone name (when the layout has one), an
+// offset (when it has a numeric offset), else UTC.
+type dateCase struct {
+	layout string
+	zone   string
+	off    int
+	c      clock
+}
+
+func (d dateCase) loc() *time.Location {
+	switch {
+	case strings.Contains(d.layout, "MST"):
+		return time.FixedZone(d.zone, zoneTable[d.zone])
+	case strings.Contains(d.layout, "-07") || strings.Contains(d.layout, "Z07"):
+		return time.FixedZone("", d.off)
+	}
+	return time.UTC
+}
+
+func (d dateCase) time() time.Time { return d.c.in(d.loc()) }
+
+func (d dateCase) text() string { return d.time().Format(d.layout) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (d dateCase) GoString() string { return fmt.Sprintf("layout %q: %q", d.layout, d.text()) }
+
+// dateCases: any layout of the list; with a two-digit year the instant's year is 1950 to 2049
+// (RFC 5322 reads every such text back to it; 1950 to 1968 is the shape of gofeed/7), under
+// HEGEL_NO_KNOWN=1 1969 to 2049, where Go's rule agrees.
+var dateCases = hegel.FlatMap(hegel.SampledFrom(layouts), func(layout string) hegel.Generator[dateCase] {
+	ys := years
+	if twoDigit(layout) {
+		ys = shaped(hegel.Integers(1950, 2049), hegel.Integers(1969, 2049))
+	}
+	cs := clocksIn(ys)
+	return hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{
+			layout: layout,
+			zone:   hegel.Draw(tc, hegel.SampledFrom(zoneNames[1:])), // not UT: time.Parse wants three letters or more
+			off:    hegel.Draw(tc, hegel.SampledFrom(offsets)),
+			c:      hegel.Draw(tc, cs),
+		}
+	})
+})
+
+// TestHegelDatesFollowTheirLayout: a date written with any layout of gofeed's list parses (as
+// an RSS pubDate) to the instant time.Parse gives for that layout, with a zone name resolved by
+// the table and a two-digit year read by RFC 5322's rule; feedparser agrees whenever it reads
+// the text at all.
+func TestHegelDatesFollowTheirLayout(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, dateCases)
+		layout, text := d.layout, d.text()
+		named := strings.Contains(layout, "MST")
+		want, err := time.Parse(layout, text)
+		if err != nil {
+			ht.Fatalf("time.Parse(%q, %q): %v", layout, text, err)
+		}
+		want = zoneFix(want)
+		var shapes []string
+		if twoDigit(layout) {
+			want = rfc5322Year(want)
+			if yy := want.Year() % 100; yy >= 50 && yy <= 68 {
+				shapes = known("gofeed/7")
+			}
+		}
+		c.count(fmt.Sprintf("named=%v", named))
+
+		doc := `<rss version="2.0"><channel><title>t</title><item><title>i</title><pubDate>` + text + `</pubDate></item></channel></rss>`
+		f, err := gofeed.NewParser().ParseString(doc)
+		if err != nil {
+			c.fail(ht, "ParseString: %v", err)
+			return
+		}
+		got := f.Items[0].PublishedParsed
+		if got == nil {
+			c.fail(ht, "pubDate %q (layout %q) does not parse", text, layout)
+			return
+		}
+		if !got.Equal(want) {
+			c.mismatch(ht, shapes, "pubDate %q (layout %q) = %v, want %v", text, layout, got.UTC(), want.UTC())
+			return
+		}
+		_, off := d.time().Zone()
+		if twoDigit(layout) || fpMisreads[layout] || strings.Contains(layout, "PM") || strings.Contains(layout, "pm") || off%3600 != 0 {
+			c.count("feedparser-not-asked")
+			return
+		}
+		if fp := fpDate(ht, text); fp != "" {
+			if fp != want.UTC().Format("2006-01-02T15:04:05Z") {
+				c.fail(ht, "feedparser reads %q as %s, the layout %q gives %v", text, fp, layout, want.UTC())
+			}
+			c.count("feedparser-agrees")
+		} else {
+			c.count("feedparser-skips")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- detection and robustness
+
+// latin1 re-encodes a document whose runes all fit in ISO-8859-1 as such bytes, with an XML
+// declaration saying so; ok is false otherwise.
+func latin1(doc string) (string, bool) {
+	var b strings.Builder
+	for _, r := range doc {
+		if r > 255 {
+			return "", false
+		}
+		b.WriteByte(byte(r))
+	}
+	s := b.String()
+	if i := strings.Index(s, "?>"); strings.HasPrefix(s, "<?xml") && i > 0 {
+		s = s[i+2:]
+	}
+	return `<?xml version="1.0" encoding="ISO-8859-1"?>` + s, true
+}
+
+// foldNames: the RSS element names the case fold may upper-case (RSS is read case-insensitively).
+var foldNames = []string{"rss", "channel", "item", "title", "link", "description", "pubDate", "lastBuildDate", "guid", "category", "enclosure", "author", "managingEditor", "language", "copyright", "generator", "image", "url"}
+
+// caseFold upper-cases the RSS element names whose flag is set.
+func caseFold(doc string, flags []bool) string {
+	for i, name := range foldNames {
+		if !flags[i] {
+			continue
+		}
+		up := strings.ToUpper(name)
+		doc = strings.ReplaceAll(doc, "<"+name+">", "<"+up+">")
+		doc = strings.ReplaceAll(doc, "</"+name+">", "</"+up+">")
+		doc = strings.ReplaceAll(doc, "<"+name+" ", "<"+up+" ")
+	}
+	return doc
+}
+
+// prolog: what is put before and around a document: an XML declaration, a comment, a DOCTYPE,
+// a processing instruction (each "" for none), the gap after them, the RSS names to upper-case
+// (nil for none), an ISO-8859-1 re-encoding, a byte order mark, leading whitespace, and the
+// cut of the prefix tried (modulo the length plus one).
+type prolog struct {
+	decl, comment, doctype, pi string
+	gap                        string
+	fold                       []bool
+	latin1, bom                bool
+	lead                       string
+	cut                        int
+}
+
+var prologs = hegel.Composite(func(tc hegel.TestCase) prolog {
+	return prolog{
+		decl:    hegel.Draw(tc, maybe(50, hegel.SampledFrom([]string{`<?xml version="1.0"?>`, `<?xml version="1.0" encoding="UTF-8"?>`, `<?xml version='1.0' encoding='utf-8' standalone='yes'?>`}))),
+		comment: hegel.Draw(tc, maybe(40, hegel.SampledFrom([]string{"<!-- generated -->", "<!--\n multi\n line -->", "<!-- <rss> in a comment -->"}))),
+		doctype: hegel.Draw(tc, maybe(20, hegel.SampledFrom([]string{"<!DOCTYPE rss>", "<!DOCTYPE feed>"}))),
+		pi:      hegel.Draw(tc, maybe(30, hegel.SampledFrom([]string{"<?xml-stylesheet type=\"text/xsl\" href=\"s.xsl\"?>", "<?pi data?>"}))),
+		gap:     hegel.Draw(tc, hegel.SampledFrom([]string{"", "\n", "\n\n"})),
+		fold:    hegel.Draw(tc, maybe(40, many(chance(40), len(foldNames), len(foldNames)))),
+		latin1:  hegel.Draw(tc, chance(25)),
+		bom:     hegel.Draw(tc, chance(40)),
+		lead:    hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", "\n", "\r\n\t"})),
+		cut:     hegel.Draw(tc, hegel.Integers(0, 9999)),
+	}
+})
+
+// detectCase: a feed of a kind and the prolog of its variant.
+type detectCase struct {
+	kind string
+	fc   feedCase
+	p    prolog
+}
+
+// variant is the document dressed with the prolog (a JSON document takes only the mark and the
+// leading whitespace), and the classes of what was applied. A byte order mark before JSON is
+// the shape of gofeed/10, left out under HEGEL_NO_KNOWN=1.
+func (c detectCase) variant(doc string) (string, []string) {
+	variant := doc
+	classes := []string{}
+	if c.kind != "json" {
+		if i := strings.Index(variant, "?>"); strings.HasPrefix(variant, "<?xml") && i > 0 {
+			variant = variant[i+2:]
+		}
+		prolog := ""
+		for _, part := range []struct{ text, class string }{{c.p.decl, "decl"}, {c.p.comment, "comment"}, {c.p.doctype, "doctype"}, {c.p.pi, "pi"}} {
+			if part.text != "" {
+				prolog += part.text
+				classes = append(classes, part.class)
+			}
+		}
+		variant = prolog + c.p.gap + variant
+		if c.kind == "rss" && c.p.fold != nil {
+			variant = caseFold(variant, c.p.fold)
+			classes = append(classes, "case")
+		}
+		if c.p.latin1 {
+			if l, ok := latin1(variant); ok {
+				variant = l
+				classes = append(classes, "latin1")
+			}
+		}
+	}
+	if c.p.bom && !(c.kind == "json" && Known.jsonBOM) {
+		variant = "\ufeff" + variant
+		classes = append(classes, "bom")
+	}
+	return c.p.lead + variant, classes
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c detectCase) GoString() string {
+	v, classes := c.variant(c.fc.doc().text)
+	return fmt.Sprintf("%s (%s): %q", c.kind, strings.Join(classes, "+"), v)
+}
+
+var kindCases = map[string]hegel.Generator[feedCase]{"rss": rssCases, "atom": atomCases, "json": jsonCases}
+
+var detectCases = hegel.FlatMap(hegel.SampledFrom([]string{"rss", "atom", "json"}), func(kind string) hegel.Generator[detectCase] {
+	return hegel.Composite(func(tc hegel.TestCase) detectCase {
+		return detectCase{kind: kind, fc: hegel.Draw(tc, kindCases[kind]), p: hegel.Draw(tc, prologs)}
+	})
+})
+
+// prefixEnv names the environment variable under which the test binary, re-run on itself,
+// parses one prefix instead of running the property.
+const prefixEnv = "GOFEED_PREFIX_DOC"
+
+// prefixVerdicts caches the verdict of every prefix tried (the shrinker revisits the same few
+// cases hundreds of times).
+var prefixVerdicts sync.Map
+
+// prefixVerdict parses a prefix of a document in a child process (the test binary itself,
+// under a capped address space) with a deadline of five seconds; a call that may never return
+// cannot be stopped in a goroutine. It returns "" when the child returns cleanly, else what
+// went wrong.
+func prefixVerdict(prefix string) string {
+	if v, ok := prefixVerdicts.Load(prefix); ok {
+		return v.(string)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/bin/sh", "-c", `ulimit -v 2200000 && exec "$0" "$@"`, os.Args[0], "-test.run", "^TestHegelDetectionSurvivesTheProlog$")
+	cmd.Env = append(os.Environ(), prefixEnv+"="+prefix)
+	cmd.WaitDelay = time.Second
+	out, err := cmd.CombinedOutput()
+	verdict := ""
+	switch {
+	case ctx.Err() != nil:
+		verdict = "does not return within five seconds"
+	case err != nil:
+		verdict = fmt.Sprintf("the child failed: %v\n%s", err, out)
+	}
+	prefixVerdicts.Store(prefix, verdict)
+	return verdict
+}
+
+// TestHegelDetectionSurvivesTheProlog: a document with a byte order mark, an XML declaration,
+// comments, a DOCTYPE, leading whitespace, RSS element names in another case or an ISO-8859-1
+// encoding is detected as its type and parses to the same universal feed as the plain one;
+// every prefix of the document either parses or fails, without panic, within five seconds. A
+// byte order mark before a JSON document is the shape of gofeed/10.
+func TestHegelDetectionSurvivesTheProlog(t *testing.T) {
+	if prefix, ok := os.LookupEnv(prefixEnv); ok {
+		// the child: parse the one prefix and return
+		gofeed.NewParser().ParseString(prefix)
+		gofeed.DetectFeedType(strings.NewReader(prefix))
+		return
+	}
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		dc := hegel.Draw(ht, detectCases)
+		kind, doc := dc.kind, dc.fc.doc().text
+		base, err := gofeed.NewParser().ParseString(doc)
+		if err != nil {
+			c.fail(ht, "ParseString of the plain document: %v\n%s", err, doc)
+			return
+		}
+		want := uOf(base)
+		variant, classes := dc.variant(doc)
+		c.count(strings.Join(classes, "+"))
+		var shapes []string
+		if kind == "json" && dc.p.bom {
+			shapes = known("gofeed/10")
+		}
+
+		wantType := map[string]gofeed.FeedType{"rss": gofeed.FeedTypeRSS, "atom": gofeed.FeedTypeAtom, "json": gofeed.FeedTypeJSON}[kind]
+		if got := gofeed.DetectFeedType(strings.NewReader(variant)); got != wantType {
+			c.mismatch(ht, shapes, "DetectFeedType = %v, want %v (%s)\n%q", got, wantType, strings.Join(classes, "+"), variant)
+			return
+		}
+		f, err := gofeed.NewParser().ParseString(variant)
+		if err != nil {
+			c.mismatch(ht, shapes, "ParseString of the variant (%s): %v\n%q", strings.Join(classes, "+"), err, variant)
+			return
+		}
+		if d := diffU(want, uOf(f)); d != "" {
+			c.mismatch(ht, shapes, "the variant (%s) parses differently: %s\n%q", strings.Join(classes, "+"), d, variant)
+			return
+		}
+
+		// a prefix: no panic, and a bounded time
+		cut := dc.p.cut % (len(variant) + 1)
+		if v := prefixVerdict(variant[:cut]); v != "" {
+			c.fail(ht, "a prefix of %d bytes: %s\n%q", cut, v, variant[:cut])
+		}
+	})
+}
