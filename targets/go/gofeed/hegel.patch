+package gofeed_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"fmt"
+	"html"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/mmcdole/gofeed"
+)
+
+func rssOf(body string) string {
+	return `<?xml version="1.0"?><rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:itunes="http://www.itunes.com/DTDs/PodCast-1.0.dtd" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>T</title><link>http://x/</link>` + body + `</channel></rss>`
+}
+
+func mustParse(t *testing.T, doc string) *gofeed.Feed {
+	t.Helper()
+	f, err := gofeed.NewParser().ParseString(doc)
+	if err != nil {
+		t.Fatalf("ParseString: %v", err)
+	}
+	return f
+}
+
+// gofeed/1: the common author forms all yield a name and an email.
+func TestHegelPinAuthorForms(t *testing.T) {
+	cases := map[string]gofeed.Person{
+		"John Doe <john@example.com>": {Name: "John Doe", Email: "john@example.com"},
+		"@jack":                       {Name: "@jack"},
+		"Smith & Sons (Ltd)":          {Name: "Smith & Sons (Ltd)"},
+	}
+	for text, want := range cases {
+		f := mustParse(t, rssOf("<item><title>i</title><author>"+html.EscapeString(text)+"</author></item>"))
+		got := f.Items[0].Author
+		if got == nil || *got != want {
+			t.Errorf("author %q read as %+v, want %+v", text, got, want)
+		}
+	}
+}
+
+// gofeed/2: itunes:keywords are trimmed and empty ones dropped.
+func TestHegelPinKeywordsAreTrimmed(t *testing.T) {
+	f := mustParse(t, rssOf("<itunes:keywords>a, b,,c </itunes:keywords><item><title>i</title><itunes:keywords>x , y</itunes:keywords></item>"))
+	if want := []string{"a", "b", "c"}; !reflect.DeepEqual(f.Categories, want) {
+		t.Errorf("feed categories from keywords 'a, b,,c ' = %q, want %q", f.Categories, want)
+	}
+	if want := []string{"x", "y"}; !reflect.DeepEqual(f.Items[0].Categories, want) {
+		t.Errorf("item categories from keywords 'x , y' = %q, want %q", f.Items[0].Categories, want)
+	}
+}
+
+// gofeed/3: an HTML named entity is decoded in an extension element as it is in a core one.
+func TestHegelPinEntitiesInExtensions(t *testing.T) {
+	f := mustParse(t, rssOf("<item><title>i</title><description>Caf&eacute;</description><dc:creator>Caf&eacute;</dc:creator><dc:subject>d&eacute;j&agrave;</dc:subject></item>"))
+	it := f.Items[0]
+	if it.Description != "Café" {
+		t.Fatalf("description = %q (the core element does decode)", it.Description)
+	}
+	if it.Author == nil || it.Author.Name != "Café" {
+		t.Errorf("dc:creator Caf&eacute; read as %+v, want the name Café", it.Author)
+	}
+	if got := it.Categories; len(got) != 1 || got[0] != "déjà" {
+		t.Errorf("dc:subject d&eacute;j&agrave; read as %q, want [déjà]", got)
+	}
+}
+
+// gofeed/4: an item's atom:link is promoted to Item.Link and Item.Links as the channel's is.
+func TestHegelPinItemAtomLink(t *testing.T) {
+	f := mustParse(t, rssOf(`<atom:link rel="alternate" href="http://x/home"/><item><title>i</title><atom:link rel="alternate" href="http://x/1"/></item>`))
+	if f.Link != "http://x/" || len(f.Links) != 2 {
+		t.Fatalf("channel: link %q links %q (the channel-level promotion)", f.Link, f.Links)
+	}
+	if f.Items[0].Link != "http://x/1" {
+		t.Errorf("item link = %q, want the atom:link http://x/1", f.Items[0].Link)
+	}
+	if !reflect.DeepEqual(f.Items[0].Links, []string{"http://x/1"}) {
+		t.Errorf("item links = %q, want [http://x/1]", f.Items[0].Links)
+	}
+}
+
+// gofeed/5: a JSON Feed item without authors has the feed's author (JSON Feed 1.1, items).
+func TestHegelPinJSONItemAuthorInherited(t *testing.T) {
+	f := mustParse(t, `{"version":"https://jsonfeed.org/version/1.1","title":"J","authors":[{"name":"Ann","url":"http://ann/"}],"items":[{"id":"1","content_text":"x"}]}`)
+	want := []*gofeed.Person{{Name: "Ann", URL: "http://ann/"}}
+	if !reflect.DeepEqual(f.Items[0].Authors, want) {
+		t.Errorf("item authors = %v, want the feed's %v", f.Items[0].Authors, want)
+	}
+}
+
+// gofeed/6: RFC 3339 allows a lower-case t and z.
+func TestHegelPinLowerCaseRFC3339(t *testing.T) {
+	for _, s := range []string{"2006-01-02t15:04:05z", "2006-01-02T15:04:05z", "2006-01-02t15:04:05Z", "2006-01-02t15:04:05+01:00"} {
+		f := mustParse(t, `<feed xmlns="http://www.w3.org/2005/Atom"><id>f</id><updated>`+s+`</updated></feed>`)
+		if f.UpdatedParsed == nil {
+			t.Errorf("updated %q does not parse", s)
+			continue
+		}
+		want, _ := time.Parse(time.RFC3339, strings.ToUpper(s))
+		if !f.UpdatedParsed.Equal(want) {
+			t.Errorf("updated %q = %v, want %v", s, f.UpdatedParsed, want)
+		}
+	}
+}
+
+// gofeed/7: two-digit years follow RFC 5322 4.3 (00-49 are 20xx, 50-99 are 19xx).
+func TestHegelPinTwoDigitYears(t *testing.T) {
+	for yy, want := range map[string]int{"50": 1950, "60": 1960, "68": 1968, "69": 1969, "99": 1999, "00": 2000, "49": 2049} {
+		f := mustParse(t, rssOf("<item><title>i</title><pubDate>Mon, 02 Jan "+yy+" 15:04:05 GMT</pubDate></item>"))
+		got := f.Items[0].PublishedParsed
+		if got == nil || got.Year() != want {
+			t.Errorf("year %s read as %v, want %d", yy, got, want)
+		}
+	}
+}
+
+// gofeed/8: an enclosure url is resolved against xml:base like the other URLs.
+func TestHegelPinEnclosureURLResolved(t *testing.T) {
+	f := mustParse(t, `<rss version="2.0" xml:base="http://x/a/"><channel><title>T</title><link>b</link><item><title>i</title><link>c</link><enclosure url="e.mp3" type="audio/mpeg" length="1"/></item></channel></rss>`)
+	if f.Link != "http://x/a/b" || f.Items[0].Link != "http://x/a/c" {
+		t.Fatalf("links %q %q are not resolved (the reference behaviour)", f.Link, f.Items[0].Link)
+	}
+	if got := f.Items[0].Enclosures[0].URL; got != "http://x/a/e.mp3" {
+		t.Errorf("enclosure url = %q, want http://x/a/e.mp3", got)
+	}
+}
+
+// gofeed/9: an RSS 1.0 item's rdf:about is its identifier.
+func TestHegelPinRDFAboutIsTheGUID(t *testing.T) {
+	f := mustParse(t, `<?xml version="1.0"?><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns="http://purl.org/rss/1.0/"><channel rdf:about="http://x/"><title>r</title><link>http://x/</link></channel><item rdf:about="http://x/1"><title>i</title><link>http://x/1</link></item></rdf:RDF>`)
+	if f.FeedVersion != "1.0" {
+		t.Fatalf("version %q, want 1.0", f.FeedVersion)
+	}
+	if got := f.Items[0].GUID; got != "http://x/1" {
+		t.Errorf("item GUID = %q, want the rdf:about http://x/1", got)
+	}
+}
+
+// gofeed/10: a JSON Feed with a UTF-8 byte order mark parses like one without.
+func TestHegelPinJSONWithBOM(t *testing.T) {
+	doc := `{"version":"https://jsonfeed.org/version/1.1","title":"J","items":[{"id":"1","content_text":"x"}]}`
+	if got := gofeed.DetectFeedType(strings.NewReader("\uFEFF" + doc)); got != gofeed.FeedTypeJSON {
+		t.Fatalf("DetectFeedType = %v, want JSON", got)
+	}
+	f, err := gofeed.NewParser().ParseString("\uFEFF" + doc)
+	if err != nil {
+		t.Fatalf("ParseString with a BOM: %v", err)
+	}
+	if f.Title != "J" || len(f.Items) != 1 {
+		t.Fatalf("parsed %+v", f)
+	}
+}
+
+var _ = fmt.Sprintf
