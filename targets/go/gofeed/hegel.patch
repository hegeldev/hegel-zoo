+// TestHegelEntitiesDecodeInExtensions: an HTML named entity in an extension element (dc:creator,
+// dc:subject) is decoded as it is in a core element (description), as feedparser decodes both;
+// the library reads extension elements raw (gofeed/3).
+func TestHegelEntitiesDecodeInExtensions(t *testing.T) {
+	c := newCollector(t)
