+}
+
+// feedCase: a model feed and the tape of its writing.
+type feedCase struct {
+	m    *mfeed
+	tape []int
+}
+
+func (c feedCase) doc() doc { return writeFeed(c.m, c.tape) }
+
+// GoString is what the draw report prints (it uses %#v): the document.
+func (c feedCase) GoString() string { return c.doc().text }
+
+// casesOf: a feed of the kind (an RSS feed under an xml:base a quarter of the time, its grammar
+// built once per base) with a tape.
+func casesOf(kind string) hegel.Generator[feedCase] {
+	baseGen := hegel.Just("")
+	if kind == "rss" {
+		baseGen = maybe(25, bases)
+	}
+	grammars := map[string]hegel.Generator[*mfeed]{"": feedsOf(kind, "")}
+	for _, b := range basePool {
+		grammars[b] = feedsOf(kind, b)
+	}
+	feeds := hegel.FlatMap(baseGen, func(b string) hegel.Generator[*mfeed] { return grammars[b] })
+	return hegel.Composite(func(tc hegel.TestCase) feedCase {
+		return feedCase{m: hegel.Draw(tc, feeds), tape: hegel.Draw(tc, tapes)}
+	})
+}
+
+var rssCases, atomCases, jsonCases = casesOf("rss"), casesOf("atom"), casesOf("json")
+
+// --------------------------------------------------------------------------- the writers
+
+// doc is a written document: its text, whether it holds an HTML named entity (an undefined
+// entity to a strict XML parser: feedparser flags the document and reads it with its loose
+// parser), and the shapes of the recorded bugs it carries.
+type doc struct {
+	text   string
+	named  bool
+	shapes []string
+}
+
+func (d *doc) shape(id string) {
+	for _, s := range d.shapes {
+		if s == id {
+			return
+		}
+	}
+	d.shapes = append(d.shapes, id)
+}
+
+// writer writes a model feed with the choices of a tape; it is a pure function of the feed and
+// the tape (and of the Known switches).
+type writer struct {
+	tp   *tape
+	base string
+	d    doc
+}
+
+func writeFeed(m *mfeed, tp []int) doc {
+	w := &writer{tp: &tape{vals: tp}, base: m.base}
+	switch m.kind {
+	case "rss":
+		w.d.text = w.rss(m)
+	case "atom":
+		w.d.text = w.atom(m)
+	default:
+		w.d.text = w.json(m)
+	}
+	return w.d
+}
+
+// namedEntities: the HTML names of the characters of the pools that have one.
+var namedEntities = map[rune]string{
+	'\u00e9': "eacute", '\u00c9': "Eacute", '\u00fc': "uuml", '\u00eb': "euml",
+	'\u00d3': "Oacute", '\u00df': "szlig", '\u00e0': "agrave", '\u00a9': "copy",
+}
+
+// text writes s as XML character data in one of several equivalent encodings: entity escapes,
+// character references, CDATA sections (split at random), or a mixture; ext says the element
+// is an extension element (dc:, itunes:), read raw by the library.
+func (w *writer) text(s string, ext bool) string {
+	if s == "" {
+		return ""
+	}
+	switch w.tp.next(5) {
+	case 0, 1:
+		return w.escape(s, ext)
+	case 2:
+		return w.charRefs(s, ext)
+	case 3:
+		if !strings.Contains(s, "]]>") {
+			return w.cdata(s)
+		}
+		return w.escape(s, ext)
+	default:
+		// a mixture: escaped head, CDATA tail
+		rs := []rune(s)
+		cut := w.tp.next(len(rs) + 1)
+		head, tail := string(rs[:cut]), string(rs[cut:])
+		if strings.Contains(tail, "]]>") {
+			return w.escape(s, ext)
+		}
+		return w.escape(head, ext) + w.cdata(tail)
+	}
+}
+
+// escape writes & < > as entities and a character with an HTML name as that entity 30% of the
+// time (inside an extension element the shape of gofeed/3, left out under HEGEL_NO_KNOWN=1).
+func (w *writer) escape(s string, ext bool) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '&':
+			b.WriteString("&amp;")
+		case r == '<':
+			b.WriteString("&lt;")
+		case r == '>':
+			b.WriteString("&gt;")
+		case namedEntities[r] != "" && !(ext && Known.extensionEntities) && w.tp.coin(30):
+			w.named(r, ext, &b)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func (w *writer) named(r rune, ext bool, b *strings.Builder) {
+	b.WriteString("&" + namedEntities[r] + ";")
+	w.d.named = true
+	if ext {
+		w.d.shape("gofeed/3")
+	}
+}
+
+// charRefs: & < > and some other characters as decimal or hexadecimal references.
+func (w *writer) charRefs(s string, ext bool) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '&' || r == '<' || r == '>' || (r > 127 && w.tp.coin(50)) || w.tp.coin(10):
+			if w.tp.coin(50) {
+				fmt.Fprintf(&b, "&#%d;", r)
+			} else {
+				fmt.Fprintf(&b, "&#x%X;", r)
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func (w *writer) cdata(s string) string {
+	if s == "" {
+		return ""
+	}
+	rs := []rune(s)
+	if len(rs) > 1 && w.tp.coin(30) {
+		cut := 1 + w.tp.next(len(rs)-1)
+		return "<![CDATA[" + string(rs[:cut]) + "]]><![CDATA[" + string(rs[cut:]) + "]]>"
+	}
+	return "<![CDATA[" + s + "]]>"
+}
+
+func xmlEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;").Replace(s)
+}
+
+func attrEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", "\"", "&quot;").Replace(s)
+}
+
+// ws: inter-element whitespace (none on an empty tape).
+func (w *writer) ws() string {
+	return w.tp.pick([]string{"", "\n", "\n  ", "\r\n\t", " "})
+}
+
+// shuffle reorders xs by the tape.
+func (w *writer) shuffle(xs []string) {
+	out := make([]string, len(xs))
+	for i, j := range w.tp.order(len(xs)) {
+		out[i] = xs[j]
+	}
+	copy(xs, out)
+}
+
+// orderedPrefixes: repeatable elements whose document order is part of the result.
+var orderedPrefixes = []string{"<category", "<item>", "<entry>", "<author>", "<enclosure", "<link ", "<itunes:keywords"}
+
+func isOrdered(el string) bool {
+	for _, p := range orderedPrefixes {
+		if strings.HasPrefix(el, p) {
+			return true
+		}
+	}
+	return false
+}
+
+// shuffleKeeping shuffles the elements but keeps the relative order of the repeatable ones.
+func (w *writer) shuffleKeeping(xs []string) {
+	var ordered []string
+	for _, x := range xs {
+		if isOrdered(x) {
+			ordered = append(ordered, x)
+		}
+	}
+	w.shuffle(xs)
+	k := 0
+	for i := range xs {
+		if isOrdered(xs[i]) {
+			xs[i] = ordered[k]
+			k++
+		}
+	}
+}
+
+// url is the written form of a model URL: relative to the xml:base when there is one.
+func (w *writer) url(u string) string {
+	if w.base != "" && strings.HasPrefix(u, w.base) {
+		return strings.TrimPrefix(u, w.base)
+	}
+	return u
+}
+
+// encURL is the written form of an enclosure url: relative under the xml:base (the shape of
+// gofeed/8), or under HEGEL_NO_KNOWN=1 absolute.
+func (w *writer) encURL(u string) string {
+	if Known.enclosureBase {
+		return u
+	}
+	if rel := w.url(u); rel != u {
+		w.d.shape("gofeed/8")
+		return rel
+	}
+	return u
+}
+
+// date is the written text of a date (a lower-case RFC 3339 text is the shape of gofeed/6).
+func (w *writer) date(d *mdate) string {
+	if d.lower {
+		w.d.shape("gofeed/6")
+	}
+	return d.raw
+}
+
+// The four forms the RSS author parser knows (shared.ParseNameAddress), for naming the shape
+// of gofeed/1 on a text it misreads; the expectation is the model's person.
+var (
+	emailNameRgx = regexp.MustCompile(`^([^@]+@[^\s]+)\s+\(([^@]+)\)$`)
+	nameEmailRgx = regexp.MustCompile(`^([^@]+)\s+\(([^@]+@[^)]+)\)$`)
+	nameOnlyRgx  = regexp.MustCompile(`^([^@()]+)$`)
+	emailOnlyRgx = regexp.MustCompile(`^([^@()]+@[^@()]+)$`)
+)
+
+func parseNameAddress(s string) (name, email string) {
+	switch {
+	case emailNameRgx.MatchString(s):
+		m := emailNameRgx.FindStringSubmatch(s)
+		return m[2], m[1]
+	case nameEmailRgx.MatchString(s):
+		m := nameEmailRgx.FindStringSubmatch(s)
+		return m[1], m[2]
+	case nameOnlyRgx.MatchString(s):
+		return s, ""
+	case emailOnlyRgx.MatchString(s):
+		return "", s
+	}
+	return "", ""
+}
+
+// authorText notes the shape of gofeed/1 when the RSS author parser reads the text as another
+// person than the one it denotes.
+func (w *writer) authorText(text string, p mperson) string {
+	if name, email := parseNameAddress(text); name != p.name || email != p.email {
+		w.d.shape("gofeed/1")
+	}
+	return text
+}
+
+// personRSS: the "name (email)" or "email (name)" form of a person with both (or, when angle,
+// "name <email>"), else the one it has.
+func (w *writer) personRSS(p mperson) string {
+	var s string
+	switch {
+	case p.name != "" && p.email != "" && p.angle:
+		s = p.name + " <" + p.email + ">"
+	case p.name != "" && p.email != "":
+		if w.tp.coin(50) {
+			s = p.email + " (" + p.name + ")"
+		} else {
+			s = p.name + " (" + p.email + ")"
+		}
+	case p.name != "":
+		s = p.name
+	default:
+		s = p.email
+	}
+	return w.authorText(s, p)
+}
+
+// keywordsText joins the keywords with the separator (the shape of gofeed/2 when the library's
+// split on "," gives anything but the words).
+func (w *writer) keywordsText(words []string, sep int) string {
+	s := keywordSeps[sep]
+	text := strings.Join(words, s[0]) + s[1]
+	if !reflect.DeepEqual(strings.Split(text, ","), words) {
+		w.d.shape("gofeed/2")
+	}
+	return text
+}
+
+var permaAttrs = []string{"", ` isPermaLink="false"`, ` isPermaLink="true"`}
+
+func (w *writer) rssItem(it mitem) string {
+	var ic []string
+	iel := func(name, text string, ext bool) {
+		ic = append(ic, "<"+name+">"+w.text(text, ext)+"</"+name+">")
+	}
+	if it.title != "" {
+		iel("title", it.title, false)
+	}
+	if it.link != "" {
+		if it.atomLink {
+			rel := w.tp.pick([]string{` rel="alternate"`, ""})
+			ic = append(ic, "<atom:link"+rel+` href="`+attrEscape(w.url(it.link))+`"/>`)
+			w.d.shape("gofeed/4")
+		} else {
+			iel("link", w.url(it.link), false)
+		}
+	}
+	if it.guid != "" {
+		ic = append(ic, "<guid"+permaAttrs[it.perma]+">"+w.text(it.guid, false)+"</guid>")
+	}
+	if it.desc != "" {
+		iel("description", it.desc, false)
+	}
+	if it.content != "" {
+		iel("content:encoded", it.content, false)
+	}
+	if it.pub != nil {
+		iel("pubDate", w.date(it.pub), false)
+	}
+	if it.upd != nil {
+		iel("dc:date", w.date(it.upd), true)
+	}
+	if it.author != nil {
+		if it.dcCreator {
+			iel("dc:creator", w.authorText(it.author.name, *it.author), true)
+		} else {
+			iel("author", w.personRSS(*it.author), false)
+		}
+	}
+	for _, c := range it.cats {
+		dom := ""
+		if c.label != "" {
+			dom = ` domain="` + attrEscape(c.label) + `"`
+		}
+		ic = append(ic, "<category"+dom+">"+w.text(c.name, false)+"</category>")
+	}
+	if len(it.keywords) > 0 {
+		ic = append(ic, "<itunes:keywords>"+w.keywordsText(it.keywords, it.kwSep)+"</itunes:keywords>")
+	}
+	for _, e := range it.encs {
+		attrs := []string{`url="` + attrEscape(w.encURL(e.url)) + `"`, `type="` + e.typ + `"`}
+		if e.length != "" {
+			attrs = append(attrs, `length="`+e.length+`"`)
+		}
+		w.shuffle(attrs)
+		ic = append(ic, "<enclosure "+strings.Join(attrs, " ")+w.tp.pick([]string{"/>", "></enclosure>"}))
+	}
+	names := make([]string, 0, len(it.custom))
+	for k := range it.custom {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	for _, k := range names {
+		iel(k, it.custom[k], false)
+	}
+	w.shuffleKeeping(ic)
+	return "<item>" + w.ws() + strings.Join(ic, w.ws()) + w.ws() + "</item>"
+}
+
+func (w *writer) rss(f *mfeed) string {
+	var ch []string
+	el := func(name, text string) { ch = append(ch, "<"+name+">"+w.text(text, false)+"</"+name+">") }
+	if f.title != "" {
+		el("title", f.title)
+	}
+	if f.link != "" {
+		el("link", w.url(f.link))
+	}
+	if f.desc != "" || w.tp.coin(50) {
+		el("description", f.desc)
+	}
+	if f.lang != "" {
+		el("language", f.lang)
+	}
+	if f.copyright != "" {
+		el("copyright", f.copyright)
+	}
+	if f.generator != "" {
+		el("generator", f.generator)
+	}
+	if f.author != nil {
+		el("managingEditor", w.personRSS(*f.author))
+	}
+	if f.pub != nil {
+		el("pubDate", w.date(f.pub))
+	}
+	if f.upd != nil {
+		el("lastBuildDate", w.date(f.upd))
+	}
+	if f.feedLink != "" {
+		ch = append(ch, `<atom:link rel="self" type="application/rss+xml" href="`+attrEscape(w.url(f.feedLink))+`"/>`)
+	}
+	for _, c := range f.cats {
+		dom := ""
+		if c.label != "" {
+			dom = ` domain="` + attrEscape(c.label) + `"`
+		}
+		ch = append(ch, "<category"+dom+">"+w.text(c.name, false)+"</category>")
+	}
+	if len(f.keywords) > 0 {
+		ch = append(ch, "<itunes:keywords>"+w.keywordsText(f.keywords, f.kwSep)+"</itunes:keywords>")
+	}
+	if f.imageURL != "" {
+		ch = append(ch, "<image>"+w.ws()+"<url>"+w.text(w.url(f.imageURL), false)+"</url><title>"+w.text(f.imageTitle, false)+"</title><link>"+w.text(w.url(f.link), false)+"</link>"+w.ws()+"</image>")
+	}
+	for _, it := range f.items {
+		ch = append(ch, w.rssItem(it))
+	}
+	w.shuffleKeeping(ch)
+	decl := w.tp.pick([]string{"", `<?xml version="1.0"?>`, `<?xml version="1.0" encoding="UTF-8"?>` + "\n"})
+	base := ""
+	if w.base != "" {
+		base = ` xml:base="` + attrEscape(w.base) + `"`
+	}
+	return decl + `<rss version="2.0"` + base + ` xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:itunes="http://www.itunes.com/DTDs/PodCast-1.0.dtd">` +
+		w.ws() + "<channel>" + w.ws() + strings.Join(ch, w.ws()) + w.ws() + "</channel>" + w.ws() + "</rss>" + w.tp.pick([]string{"", "\n"})
+}
+
+func (w *writer) personAtom(tag string, p mperson) string {
+	var parts []string
+	if p.name != "" {
+		parts = append(parts, "<name>"+w.text(p.name, false)+"</name>")
+	}
+	if p.email != "" {
+		parts = append(parts, "<email>"+w.text(p.email, false)+"</email>")
+	}
+	if p.url != "" {
+		parts = append(parts, "<uri>"+w.text(p.url, false)+"</uri>")
+	}
+	w.shuffle(parts)
+	return "<" + tag + ">" + w.ws() + strings.Join(parts, w.ws()) + w.ws() + "</" + tag + ">"
+}
+
+func (w *writer) atomText(name, s string, html bool) string {
+	if html {
+		// the value is HTML: the text HTML-escaped, then the XML layer on top
+		return `<` + name + ` type="html">` + w.text(htmlEscape(s), false) + `</` + name + `>`
+	}
+	typ := w.tp.pick([]string{"", ` type="text"`, ` type="TEXT"`})
+	return "<" + name + typ + ">" + w.text(s, false) + "</" + name + ">"
+}
+
+func htmlEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;").Replace(s)
+}
+
+func (w *writer) atom(f *mfeed) string {
+	var ch []string
+	if f.title != "" {
+		ch = append(ch, w.atomText("title", f.title, false))
+	}
+	ch = append(ch, "<id>"+w.text("urn:feed:"+strconv.Itoa(1+w.tp.next(999)), false)+"</id>")
+	ch = append(ch, "<updated>"+w.date(f.upd)+"</updated>")
+	if f.desc != "" {
+		ch = append(ch, w.atomText("subtitle", f.desc, false))
+	}
+	if f.copyright != "" {
+		ch = append(ch, w.atomText("rights", f.copyright, false))
+	}
+	if f.generator != "" {
+		ch = append(ch, "<generator>"+w.text(f.generator, false)+"</generator>")
+	}
+	if f.imageURL != "" {
+		ch = append(ch, "<logo>"+w.text(f.imageURL, false)+"</logo>")
+	}
+	var links []string
+	if f.link != "" {
+		rel := w.tp.pick([]string{"", ` rel="alternate"`, ` type="text/html"`})
+		links = append(links, "<link"+rel+` href="`+attrEscape(f.link)+`"/>`)
+	}
+	if f.feedLink != "" {
+		links = append(links, `<link rel="self" href="`+attrEscape(f.feedLink)+`"/>`)
+	}
+	if !f.linkFirst && len(links) == 2 {
+		links[0], links[1] = links[1], links[0]
+	}
+	for _, p := range f.authors {
+		ch = append(ch, w.personAtom("author", p))
+	}
+	for _, c := range f.cats {
+		label := ""
+		if c.label != "" {
+			label = ` label="` + attrEscape(c.label) + `"`
+		}
+		ch = append(ch, `<category term="`+attrEscape(c.name)+`"`+label+w.tp.pick([]string{"/>", "></category>"}))
+	}
+	w.shuffleKeeping(ch)
+	ch = append(links, ch...) // links keep their relative order
+	for _, it := range f.items {
+		var ic []string
+		if it.title != "" {
+			ic = append(ic, w.atomText("title", it.title, it.titleHTML))
+		}
+		ic = append(ic, "<id>"+w.text(it.guid, false)+"</id>")
+		if it.upd != nil {
+			ic = append(ic, "<updated>"+w.date(it.upd)+"</updated>")
+		}
+		if it.pub != nil {
+			ic = append(ic, "<published>"+w.date(it.pub)+"</published>")
+		}
+		if it.link != "" {
+			rel := w.tp.pick([]string{"", ` rel="alternate"`})
+			ic = append(ic, "<link"+rel+` href="`+attrEscape(it.link)+`"/>`)
+		}
+		if it.desc != "" {
+			ic = append(ic, w.atomText("summary", it.desc, false))
+		}
+		if it.content != "" {
+			ic = append(ic, w.atomText("content", it.content, false))
+		}
+		for _, p := range it.authors {
+			ic = append(ic, w.personAtom("author", p))
+		}
+		for _, c := range it.cats {
+			label := ""
+			if c.label != "" {
+				label = ` label="` + attrEscape(c.label) + `"`
+			}
+			ic = append(ic, `<category term="`+attrEscape(c.name)+`"`+label+"/>")
+		}
+		for _, e := range it.encs {
+			attrs := []string{`rel="enclosure"`, `href="` + attrEscape(e.url) + `"`, `type="` + e.typ + `"`}
+			if e.length != "" {
+				attrs = append(attrs, `length="`+e.length+`"`)
+			}
+			w.shuffle(attrs)
+			ic = append(ic, "<link "+strings.Join(attrs, " ")+"/>")
+		}
+		w.shuffleKeeping(ic)
+		ch = append(ch, "<entry>"+w.ws()+strings.Join(ic, w.ws())+w.ws()+"</entry>")
+	}
+	lang := ""
+	if f.lang != "" {
+		lang = ` xml:lang="` + f.lang + `"`
+	}
+	decl := w.tp.pick([]string{"", `<?xml version="1.0" encoding="utf-8"?>`})
+	return decl + `<feed xmlns="http://www.w3.org/2005/Atom"` + lang + ">" + w.ws() + strings.Join(ch, w.ws()) + w.ws() + "</feed>"
+}
+
+// jsonPerson: a JSON Feed author; the translator runs the name through the RSS author parser
+// (jsonPerson in translator.go), so a handle or a parenthesised name is the shape of gofeed/1.
+func (w *writer) jsonPerson(p mperson) map[string]any {
+	m := map[string]any{}
+	if p.name != "" {
+		m["name"] = w.authorText(p.name, mperson{name: p.name})
+	}
+	if p.url != "" {
+		m["url"] = p.url
+	}
+	return m
+}
+
+func (w *writer) jsonPersons(ps []mperson) []any {
+	var as []any
+	for _, p := range ps {
+		as = append(as, w.jsonPerson(p))
+	}
+	return as
+}
+
+// isNumeric: a JSON item id written as a number.
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func (w *writer) json(f *mfeed) string {
+	m := map[string]any{"version": f.version}
+	if f.title != "" {
+		m["title"] = f.title
+	}
+	if f.link != "" {
+		m["home_page_url"] = f.link
+	}
+	if f.feedLink != "" {
+		m["feed_url"] = f.feedLink
+	}
+	if f.desc != "" {
+		m["description"] = f.desc
+	}
+	if f.lang != "" {
+		m["language"] = f.lang
+	}
+	if f.imageURL != "" {
+		m["icon"] = f.imageURL
+	}
+	if f.favicon != "" {
+		m["favicon"] = f.favicon
+	}
+	if f.userComment {
+		m["user_comment"] = f.copyright
+	}
+	if f.author != nil {
+		m["author"] = w.jsonPerson(*f.author)
+	}
+	if len(f.authors) > 0 {
+		m["authors"] = w.jsonPersons(f.authors)
+	}
+	feedAuthors := f.author != nil || len(f.authors) > 0
+	items := []any{}
+	for _, it := range f.items {
+		im := map[string]any{}
+		if isNumeric(it.guid) {
+			im["id"], _ = strconv.Atoi(it.guid)
+		} else if it.guid != "" {
+			im["id"] = it.guid
+		}
+		if it.link != "" {
+			im["url"] = it.link
+		}
+		if it.external != "" {
+			im["external_url"] = it.external
+		}
+		if it.title != "" {
+			im["title"] = it.title
+		}
+		if it.hasContentHTML {
+			im["content_html"] = it.content
+			if it.extraText != "" {
+				im["content_text"] = it.extraText
+			}
+		} else {
+			im["content_text"] = it.content
+		}
+		if it.desc != "" {
+			im["summary"] = it.desc
+		}
+		if it.image != "" {
+			im["image"] = it.image
+		}
+		if it.pub != nil {
+			im["date_published"] = w.date(it.pub)
+		}
+		if it.upd != nil {
+			im["date_modified"] = w.date(it.upd)
+		}
+		if it.author != nil {
+			im["author"] = w.jsonPerson(*it.author)
+		}
+		if len(it.authors) > 0 {
+			im["authors"] = w.jsonPersons(it.authors)
+		}
+		if it.author == nil && len(it.authors) == 0 && feedAuthors && !Known.jsonAuthorNotInherited {
+			w.d.shape("gofeed/5")
+		}
+		if len(it.cats) > 0 {
+			im["tags"] = terms(it.cats)
+		}
+		if len(it.encs) > 0 {
+			var as []any
+			for _, e := range it.encs {
+				a := map[string]any{"url": e.url, "mime_type": e.typ}
+				if e.length != "" {
+					a["size_in_bytes"], _ = strconv.Atoi(e.length)
+				}
+				as = append(as, a)
+			}
+			im["attachments"] = as
+		}
+		items = append(items, im)
+	}
+	m["items"] = items
+	var b []byte
+	if w.tp.coin(50) {
+		b, _ = json.MarshalIndent(m, "", "  ")
+	} else {
+		b, _ = json.Marshal(m)
+	}
+	return w.tp.pick([]string{"", "\n", " "}) + string(b) + w.tp.pick([]string{"", "\n"})
+}
+
+// --------------------------------------------------------------------------- the universal view
+
+type uPerson struct{ Name, Email, URL string }
+
+type uEnc struct{ URL, Type, Length string }
+
+type uItem struct {
+	Title, Description, Content, Link string
+	Links                             []string
+	Updated, Published                string
+	UpdatedParsed, PublishedParsed    string
+	Author                            *uPerson
+	Authors                           []uPerson
+	GUID, Image                       string
+	Categories                        []string
+	Enclosures                        []uEnc
+	Custom                            map[string]string
+}
+
+type uFeed struct {
+	Type, Version, Title, Description, Link, FeedLink    string
+	Links                                                []string
+	Updated, Published, UpdatedParsed, PublishedParsed   string
+	Author                                               *uPerson
+	Authors                                              []uPerson
+	Language, ImageURL, ImageTitle, Copyright, Generator string
+	Categories                                           []string
+	Items                                                []uItem
+}
+
+func stamp(t *time.Time) string {
+	if t == nil {
+		return ""
+	}
+	return t.UTC().Format(time.RFC3339Nano)
+}
+
+func stampM(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.t.UTC().Format(time.RFC3339Nano)
+}
+
+func rawM(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.raw
+}
+
+func uPersonOf(p *gofeed.Person) *uPerson {
+	if p == nil {
+		return nil
+	}
+	return &uPerson{p.Name, p.Email, p.URL}
+}
+
+func uPersonsOf(ps []*gofeed.Person) []uPerson {
+	var out []uPerson
+	for _, p := range ps {
+		if p == nil {
+			out = append(out, uPerson{Name: "<nil>"})
+			continue
+		}
+		out = append(out, *uPersonOf(p))
+	}
+	return out
+}
+
+func uOf(f *gofeed.Feed) uFeed {
+	u := uFeed{Type: f.FeedType, Version: f.FeedVersion, Title: f.Title, Description: f.Description, Link: f.Link, FeedLink: f.FeedLink,
+		Links: nilIfEmpty(f.Links), Updated: f.Updated, Published: f.Published, UpdatedParsed: stamp(f.UpdatedParsed), PublishedParsed: stamp(f.PublishedParsed),
+		Author: uPersonOf(f.Author), Authors: uPersonsOf(f.Authors), Language: f.Language, Copyright: f.Copyright, Generator: f.Generator, Categories: nilIfEmpty(f.Categories)}
+	if f.Image != nil {
+		u.ImageURL, u.ImageTitle = f.Image.URL, f.Image.Title
+	}
+	for _, it := range f.Items {
+		ui := uItem{Title: it.Title, Description: it.Description, Content: it.Content, Link: it.Link, Links: nilIfEmpty(it.Links),
+			Updated: it.Updated, Published: it.Published, UpdatedParsed: stamp(it.UpdatedParsed), PublishedParsed: stamp(it.PublishedParsed),
+			Author: uPersonOf(it.Author), Authors: uPersonsOf(it.Authors), GUID: it.GUID, Categories: nilIfEmpty(it.Categories)}
+		if it.Image != nil {
+			ui.Image = it.Image.URL
+		}
+		for _, e := range it.Enclosures {
+			ui.Enclosures = append(ui.Enclosures, uEnc{e.URL, e.Type, e.Length})
+		}
+		if len(it.Custom) > 0 {
+			ui.Custom = it.Custom
+		}
+		u.Items = append(u.Items, ui)
+	}
+	return u
+}
+
+func nilIfEmpty(xs []string) []string {
+	if len(xs) == 0 {
+		return nil
+	}
+	return xs
+}
+
+func uPersonM(p *mperson) *uPerson {
+	if p == nil {
+		return nil
+	}
+	return &uPerson{p.name, p.email, p.url}
+}
+
+func uPersonsM(ps []mperson) []uPerson {
+	var out []uPerson
+	for _, p := range ps {
+		out = append(out, uPerson{p.name, p.email, p.url})
+	}
+	return out
+}
+
+// labelled: the Atom categories, the label standing in for the term when there is one.
+func labelled(cs []mcat) []string {
+	var out []string
+	for _, c := range cs {
+		if c.label != "" {
+			out = append(out, c.label)
+		} else {
+			out = append(out, c.name)
+		}
+	}
+	return out
+}
+
+// expect: the universal feed the documented mapping gives for the model.
+func expect(f *mfeed) uFeed {
+	u := uFeed{Type: f.kind, Title: f.title, Description: f.desc, Link: f.link, FeedLink: f.feedLink, Language: f.lang, Copyright: f.copyright, Generator: f.generator, Categories: nilIfEmpty(terms(f.cats))}
+	switch f.kind {
+	case "rss":
+		u.Version = "2.0"
+		if f.link != "" {
+			u.Links = append(u.Links, f.link)
+		}
+		if f.feedLink != "" {
+			u.Links = append(u.Links, f.feedLink)
+		}
+		u.Published, u.PublishedParsed = rawM(f.pub), stampM(f.pub)
+		u.Updated, u.UpdatedParsed = rawM(f.upd), stampM(f.upd)
+		if f.author != nil {
+			u.Author = uPersonM(f.author)
+			u.Authors = []uPerson{*u.Author}
+		}
+		u.ImageURL, u.ImageTitle = f.imageURL, f.imageTitle
+		u.Categories = nilIfEmpty(append(terms(f.cats), f.keywords...))
+	case "atom":
+		u.Version = "1.0"
+		if f.linkFirst || f.link == "" || f.feedLink == "" {
+			u.Links = nonEmpty(f.link, f.feedLink)
+		} else {
+			u.Links = []string{f.feedLink, f.link}
+		}
+		u.Updated, u.UpdatedParsed = rawM(f.upd), stampM(f.upd)
+		if len(f.authors) > 0 {
+			u.Authors = uPersonsM(f.authors)
+			a := u.Authors[0]
+			u.Author = &a
+		}
+		u.ImageURL = f.imageURL
+		u.Categories = nilIfEmpty(labelled(f.cats))
+	case "json":
+		u.Version = f.version
+		u.Links = nonEmpty(f.link, f.feedLink)
+		u.ImageURL = f.imageURL
+		u.Categories = nil
+		u.Copyright, u.Generator = "", "" // no JSON Feed fields map to them
+		u.Author = uPersonM(f.author)
+		if len(f.authors) > 0 {
+			u.Authors = uPersonsM(f.authors)
+		} else if u.Author != nil {
+			u.Authors = []uPerson{*u.Author}
+		}
+		if len(f.items) > 0 {
+			u.Updated, u.UpdatedParsed = rawM(f.items[0].upd), stampM(f.items[0].upd)
+			u.Published, u.PublishedParsed = rawM(f.items[0].pub), stampM(f.items[0].pub)
+		}
+	}
+	for _, it := range f.items {
+		ui := uItem{Title: it.title, Description: it.desc, Content: it.content, Link: it.link, GUID: it.guid, Categories: nilIfEmpty(terms(it.cats))}
+		if it.link != "" {
+			ui.Links = []string{it.link}
+		}
+		for _, e := range it.encs {
+			ui.Enclosures = append(ui.Enclosures, uEnc{e.url, e.typ, e.length})
+		}
+		switch f.kind {
+		case "rss":
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			if it.pub == nil && it.upd != nil {
+				ui.Published, ui.PublishedParsed = rawM(it.upd), stampM(it.upd)
+			}
+			if it.author != nil {
+				ui.Author = uPersonM(it.author)
+				ui.Authors = []uPerson{*ui.Author}
+			}
+			for _, e := range it.encs {
+				if strings.HasPrefix(e.typ, "image/") {
+					ui.Image = e.url
+					break
+				}
+			}
+			if len(it.custom) > 0 {
+				ui.Custom = it.custom
+			}
+			ui.Categories = nilIfEmpty(append(terms(it.cats), it.keywords...))
+		case "atom":
+			if it.titleHTML {
+				ui.Title = htmlEscape(it.title)
+			}
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			if it.pub == nil {
+				ui.Published, ui.PublishedParsed = ui.Updated, ui.UpdatedParsed
+			}
+			if len(it.authors) > 0 {
+				ui.Authors = uPersonsM(it.authors)
+				a := ui.Authors[0]
+				ui.Author = &a
+			}
+			ui.Categories = nilIfEmpty(labelled(it.cats))
+		case "json":
+			ui.Links = nonEmpty(it.link, it.external)
+			ui.Image = it.image
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			ui.Author = uPersonM(it.author)
+			if len(it.authors) > 0 {
+				ui.Authors = uPersonsM(it.authors)
+			} else if ui.Author != nil {
+				ui.Authors = []uPerson{*ui.Author}
+			} else if !Known.jsonAuthorNotInherited {
+				// JSON Feed 1.1: the top-level authors are the authors of an item without its own
+				ui.Author, ui.Authors = u.Author, u.Authors
+			}
+		}
+		u.Items = append(u.Items, ui)
+	}
+	return u
+}
+
+func nonEmpty(xs ...string) []string {
+	var out []string
+	for _, x := range xs {
+		if x != "" {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// diffU: "" when equal, else a description of the first differing field.
+func diffU(want, got uFeed) string {
+	if reflect.DeepEqual(want, got) {
+		return ""
+	}
+	w, _ := json.MarshalIndent(want, "", " ")
+	g, _ := json.MarshalIndent(got, "", " ")
+	wl, gl := strings.Split(string(w), "\n"), strings.Split(string(g), "\n")
+	for i := 0; i < len(wl) || i < len(gl); i++ {
+		var a, b string
+		if i < len(wl) {
+			a = wl[i]
+		}
+		if i < len(gl) {
+			b = gl[i]
+		}
+		if a != b {
+			return fmt.Sprintf("line %d: got %s, want %s", i+1, strings.TrimSpace(b), strings.TrimSpace(a))
+		}
+	}
+	return "differs (same JSON?)"
+}
+
+// --------------------------------------------------------------------------- feedparser's view of the model
+
+// skip marks a value the comparison leaves alone (HTML-typed or markup-bearing text, which
+// feedparser sanitizes).
+const skip = "\x00skip"
+
+func fpStamp(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.t.UTC().Format("2006-01-02T15:04:05Z")
+}
+
+// linkOrSkip: feedparser falls back to the id when there is no link.
+func linkOrSkip(s string) string {
+	if s == "" {
+		return skip
+	}
+	return s
+}
+
+func plainOrSkip(s string) string {
+	if isPlain(s) {
+		return s
+	}
+	return skip
+}
+
+// fpLoosened: the expectation for a document feedparser reads with its loose (SGML) parser,
+// which it falls back to when the strict one meets an HTML named entity: that parser leaves an
+// "&" in a non-HTML field (an id, a name, a generator, a tag, a link) as "&amp;" or worse, so
+// every value with a markup character is left alone.
+func fpLoosened(v fpView) fpView {
+	strs := func(ss []string) []string {
+		out := make([]string, len(ss))
+		for i, s := range ss {
+			out[i] = plainOrSkip(s)
+		}
+		return out
+	}
+	person := func(p fpPerson) fpPerson { return fpPerson{plainOrSkip(p.Name), plainOrSkip(p.Email)} }
+	f := &v.Feed
+	f.Title, f.Link, f.Subtitle, f.Rights, f.Generator, f.Image = plainOrSkip(f.Title), plainOrSkip(f.Link), plainOrSkip(f.Subtitle), plainOrSkip(f.Rights), plainOrSkip(f.Generator), plainOrSkip(f.Image)
+	f.Tags = strs(f.Tags)
+	if f.Author != nil {
+		a := person(*f.Author)
+		f.Author = &a
+	}
+	entries := make([]fpEntry, len(v.Entries))
+	for i, e := range v.Entries {
+		e.Title, e.Link, e.ID, e.Summary, e.Content = plainOrSkip(e.Title), plainOrSkip(e.Link), plainOrSkip(e.ID), plainOrSkip(e.Summary), plainOrSkip(e.Content)
+		e.Tags = strs(e.Tags)
+		as := make([]fpPerson, len(e.Authors))
+		for j, a := range e.Authors {
+			as[j] = person(a)
+		}
+		e.Authors = as
+		encs := make([]fpEnc, len(e.Enclosures))
+		for j, x := range e.Enclosures {
+			encs[j] = fpEnc{plainOrSkip(x.Href), x.Type, x.Length}
+		}
+		e.Enclosures = encs
+		entries[i] = e
+	}
+	v.Entries = entries
+	return v
+}
+
+// fpGUID: feedparser resolves a permalink guid against the xml:base (a relative one such as
+// "g7" becomes absolute); one with isPermaLink="false" it keeps.
+func fpGUID(f *mfeed, it mitem) string {
+	if f.base == "" || it.perma == 1 || it.guid == "" {
+		return it.guid
+	}
+	base, err := url.Parse(f.base)
+	if err != nil {
+		return it.guid
+	}
+	ref, err := url.Parse(it.guid)
+	if err != nil {
+		return it.guid
+	}
+	return base.ResolveReference(ref).String()
+}
+
+// fpEncURL: feedparser keeps an enclosure href as written, relative under the xml:base too
+// (its own quirk, so the comparison expects the written form).
+func fpEncURL(f *mfeed, u string) string {
+	if f.base != "" && !Known.enclosureBase && strings.HasPrefix(u, f.base) {
+		return strings.TrimPrefix(u, f.base)
+	}
+	return u
+}
+
+// fpExpect: what feedparser reads for the model (its own mapping: RSS categories and itunes
+// keywords and Atom terms are tags, the last Atom author is the author, labels are separate).
+func fpExpect(m *mfeed) fpView {
+	v := fpView{}
+	v.Feed = fpFeedPart{Title: plainOrSkip(m.title), Link: linkOrSkip(m.link), Subtitle: m.desc, Language: m.lang, Rights: m.copyright, Generator: m.generator, Tags: terms(m.cats)}
+	switch m.kind {
+	case "rss":
+		v.Version = "rss20"
+		v.Feed.Image = m.imageURL
+		v.Feed.Tags = append(v.Feed.Tags, m.keywords...)
+		v.Feed.Published = fpStamp(m.pub)
+		v.Feed.Updated = fpStamp(m.upd)
+		if m.upd == nil {
+			v.Feed.Updated = v.Feed.Published // feedparser mirrors published into updated
+		}
+		if m.author != nil {
+			v.Feed.Author = &fpPerson{m.author.name, m.author.email}
+		}
+	case "atom":
+		v.Version = "atom10"
+		v.Feed.Image = skip
+		v.Feed.Updated = fpStamp(m.upd)
+		if len(m.authors) > 0 {
+			a := fpDetail(m.authors)
+			v.Feed.Author = &a
+		}
+	}
+	for _, it := range m.items {
+		e := fpEntry{Title: plainOrSkip(it.title), Link: linkOrSkip(it.link), ID: fpGUID(m, it), Summary: it.desc, Content: it.content, Tags: terms(it.cats)}
+		if it.titleHTML {
+			e.Title = skip
+		}
+		if it.desc == "" && it.content != "" {
+			e.Summary = skip // feedparser's summary falls back to the content
+		}
+		for _, x := range it.encs {
+			e.Enclosures = append(e.Enclosures, fpEnc{fpEncURL(m, x.url), x.typ, x.length})
+		}
+		switch m.kind {
+		case "rss":
+			e.Tags = append(e.Tags, it.keywords...)
+			e.Published = fpStamp(it.pub)
+			e.Updated = fpStamp(it.upd)
+			if it.pub == nil {
+				e.Published = skip
+			}
+			if it.upd == nil {
+				e.Updated = e.Published
+			}
+			if it.author != nil {
+				e.Authors = []fpPerson{{it.author.name, it.author.email}}
+			}
+		case "atom":
+			e.Published = fpStamp(it.pub)
+			e.Updated = fpStamp(it.upd)
+			if it.upd == nil {
+				e.Updated = e.Published // feedparser mirrors published into updated
+			}
+			e.Authors = fpMerged(it.authors)
+		}
+		v.Entries = append(v.Entries, e)
+	}
+	return v
+}
+
+// fpMerged: feedparser's author_detail accumulates over the Atom authors of one element; a
+// field a later author lacks keeps the value of the author before it. An author without a name
+// after one with both a name and an email gets that name as feedparser re-reads it out of its
+// own "name (email)" text (_sync_author_detail): fpReparsed.
+func fpMerged(ps []mperson) []fpPerson {
+	var out []fpPerson
+	var cur fpPerson
+	for i, p := range ps {
+		if p.name != "" {
+			cur.Name = p.name
+		} else if i > 0 && ps[i-1].name != "" && ps[i-1].email != "" {
+			cur.Name = fpReparsed(ps[i-1].name)
+		}
+		if p.email != "" {
+			cur.Email = p.email
+		}
+		out = append(out, cur)
+	}
+	return out
+}
+
+// fpDetail: feedparser's author_detail after the Atom authors of one element: each field the
+// value of the last author that had it (the re-reading of fpMerged touches the authors list
+// only).
+func fpDetail(ps []mperson) fpPerson {
+	var cur fpPerson
+	for _, p := range ps {
+		if p.name != "" {
+			cur.Name = p.name
+		}
+		if p.email != "" {
+			cur.Email = p.email
+		}
+	}
+	return cur
+}
+
+// fpReparsed: the name feedparser reads back out of "name (email)" once the email is taken out:
+// "()" removed, blanks trimmed, then one leading "(" and one trailing ")" dropped (so a name
+// ending in a parenthesis loses it).
+func fpReparsed(name string) string {
+	s := strings.TrimSpace(strings.ReplaceAll(name+" ()", "()", ""))
+	s = strings.TrimPrefix(s, "(")
+	s = strings.TrimSuffix(s, ")")
+	return strings.TrimSpace(s)
+}
+
+// --------------------------------------------------------------------------- properties
+
+func runFormat(t *testing.T, kind string, cases hegel.Generator[feedCase]) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		fc := hegel.Draw(ht, cases)
+		d := fc.doc()
+		f, err := gofeed.NewParser().ParseString(d.text)
+		if err != nil {
+			c.fail(ht, "ParseString: %v\n%s", err, d.text)
+			return
+		}
+		c.count(fmt.Sprintf("items=%d", len(fc.m.items)))
+		for _, s := range d.shapes {
+			c.count("shape " + s)
+		}
+		if diff := diffU(expect(fc.m), uOf(f)); diff != "" {
+			c.mismatch(ht, d.shapes, "%s\n%s", diff, d.text)
+			return
+		}
+		if kind == "json" {
+			return
+		}
+		// feedparser reads the same document as the model
+		view, perr := fpParse(ht, d.text)
+		if perr != "" {
+			c.fail(ht, "feedparser: %s\n%s", perr, d.text)
+			return
+		}
+		// an HTML named entity is undefined to a strict XML parser, so feedparser flags the
+		// document (and reads it with its loose parser, which decodes the entity)
+		if view.Bozo != d.named {
+			c.fail(ht, "feedparser flags the document: %v (bozo: %s), a named entity in it: %v\n%s", view.Bozo, view.BozoException, d.named, d.text)
+			return
+		}
+		want := fpExpect(fc.m)
+		if d.named {
+			want = fpLoosened(want)
+		}
+		if diff := fpDiff(want, view); diff != "" {
+			c.fail(ht, "feedparser reads: %s\n%s", diff, d.text)
+		}
+	})
+}
+
+// TestHegelRSSFollowsTheModel: a model feed written as RSS 2.0 (any child order, any of the
+// equivalent text encodings, optional elements present or absent, under an xml:base a quarter
+// of the time) parses to the documented universal mapping, and feedparser reads the same values.
+// The shapes of gofeed/1, /2, /3, /4, /6 and /8 are drawn at their natural rate.
+func TestHegelRSSFollowsTheModel(t *testing.T) { runFormat(t, "rss", rssCases) }
+
+// TestHegelAtomFollowsTheModel: the same for Atom 1.0 (text and html constructs, links with
+// and without rel, enclosure links, several authors, labelled categories); the shape of
+// gofeed/6 is drawn at its natural rate.
+func TestHegelAtomFollowsTheModel(t *testing.T) { runFormat(t, "atom", atomCases) }
+
+// TestHegelJSONFeedFollowsTheModel: the same for JSON Feed 1 and 1.1 (author or authors,
+// numeric ids, content_html or content_text, attachments), with no second reader; the shapes
+// of gofeed/5 and /6 are drawn at their natural rate.
+func TestHegelJSONFeedFollowsTheModel(t *testing.T) { runFormat(t, "json", jsonCases) }
