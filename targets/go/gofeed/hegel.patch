+// TestHegelRDFAboutIsTheGUID: an RSS 1.0 document parses as version 1.0 with its items in
+// order, each item's rdf:about (the URI of the item, RSS 1.0 5.5) being its GUID, as feedparser
+// reads the entry id; the library ignores rdf:about (gofeed/9).
+func TestHegelRDFAboutIsTheGUID(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		r := hegel.Draw(ht, rdfCases)
+		d := r.doc()
+		doc := d.text
+		f := parseOrFail(ht, doc)
+		if f.FeedVersion != "1.0" || f.Title != r.title || len(f.Items) != len(r.items) {
+			c.fail(ht, "version %q title %q %d items, want 1.0 %q %d\n%s", f.FeedVersion, f.Title, len(f.Items), r.title, len(r.items), doc)
+			return
+		}
+		for i, it := range r.items {
+			if got := f.Items[i]; got.Title != it.title || got.Link != it.link {
+				c.fail(ht, "item %d: title %q link %q, want %q %q\n%s", i, got.Title, got.Link, it.title, it.link, doc)
+			}
+			if got := f.Items[i].GUID; got != it.about {
+				c.mismatch(ht, known("gofeed/9"), "item %d: GUID %q, want the rdf:about %q\n%s", i, got, it.about, doc)
+			}
+		}
+		view, perr := fpParse(ht, doc)
+		if perr != "" || view.Bozo != d.named {
+			c.fail(ht, "feedparser: %s bozo %v (named entity written: %v) %s\n%s", perr, view.Bozo, d.named, view.BozoException, doc)
+			return
+		}
+		for i, it := range r.items {
+			if d.named && !isPlain(it.about) {
+				continue // the loose parser feedparser falls back to leaves an "&" as "&amp;"
+			}
+			if i < len(view.Entries) && view.Entries[i].ID != it.about {
+				c.fail(ht, "feedparser reads entry %d id %q, want %q\n%s", i, view.Entries[i].ID, it.about, doc)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- gofeed/10
+
+// bomCase: a JSON Feed document with a byte order mark before it (the shape of gofeed/10) or,
+// under HEGEL_NO_KNOWN=1, leading whitespace alone.
+type bomCase struct {
+	fc   feedCase
+	lead string
+}
+
+func (b bomCase) prefix() string {
+	return shaped("\ufeff", "") + b.lead
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (b bomCase) GoString() string { return fmt.Sprintf("%q + %s", b.prefix(), b.fc.doc().text) }
+
+var bomCases = hegel.Composite(func(tc hegel.TestCase) bomCase {
+	return bomCase{fc: hegel.Draw(tc, jsonCases), lead: hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", "\n"}))}
+})
+
+// TestHegelJSONWithBOMParses: a JSON Feed with a UTF-8 byte order mark is detected as JSON and
+// parses to the same feed as without the mark (as the XML formats do); the library detects it
+// and then rejects it (gofeed/10).
+func TestHegelJSONWithBOMParses(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := hegel.Draw(ht, bomCases)
+		doc := b.fc.doc().text
+		want := uOf(parseOrFail(ht, doc))
+		marked := b.prefix() + doc
+		if got := gofeed.DetectFeedType(strings.NewReader(marked)); got != gofeed.FeedTypeJSON {
+			c.mismatch(ht, known("gofeed/10"), "DetectFeedType = %v, want JSON\n%q", got, marked)
+			return
+		}
+		f, err := gofeed.NewParser().ParseString(marked)
+		if err != nil {
+			c.mismatch(ht, known("gofeed/10"), "ParseString with the mark: %v\n%q", err, marked)
+			return
+		}
+		if d := diffU(want, uOf(f)); d != "" {
+			c.mismatch(ht, known("gofeed/10"), "with the mark the feed parses differently: %s\n%q", d, marked)
+		}
+	})
+}
