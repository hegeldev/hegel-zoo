+++ b/hegel_test.go
@@ -0,0 +1,2040 @@
+package gofeed_test
+
+// Hegel property tests for mmcdole/gofeed, written for the Hegel zoo.
+// See targets/go/gofeed/README.md.
+//
+// Oracles: a model feed (title, links, dates, people, categories, keywords, enclosures, items)
+// written out as RSS 2.0, Atom 1.0 or JSON Feed by a pure writer, with the documented mapping
+// of each format onto the universal Feed as the expected result; Python feedparser reading the
+// same document; Go's time.Parse on the layout a date was written in.
+//
+// A case is data: a property draws one record (a model feed built from generator values, and
+// the tape of small integers the writer consumes for the choices a document leaves free: child
+// order, the spelling of a character, CDATA against entities, whitespace; an empty tape is the
+// plainest document, so that is what a case shrinks to) and pure functions turn it into the
+// documents the library and the oracle read.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and the properties that meet
+// them fail, naming the shape; hegel_shapes_test.go has one property per bug over its shape
+// region alone, and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the
+// known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing (one long run lists every remaining shape at once).
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/mmcdole/gofeed"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape;
+// under HEGEL_NO_KNOWN=1 the gates of Known are on and the shapes are left out of the
+// generators and the writers (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of the recorded bugs (bugs.toml); on means the shape is left
+// out, which is so only under HEGEL_NO_KNOWN=1. The pins in hegel_pins_test.go assert the
+// correct behaviour and fail while a bug is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	authorShapes           bool // gofeed/1: author texts outside "name (email)", "email (name)", name, email are dropped or misread ("Name <email>" is the email, "@handle" and "Smith & Sons (Ltd)" vanish)
+	keywordsUntrimmed      bool // gofeed/2: itunes:keywords are split on "," without trimming or dropping empties
+	extensionEntities      bool // gofeed/3: an HTML named entity is decoded in a core element but left as written in an extension element (dc:, itunes:)
+	itemAtomLink           bool // gofeed/4: an item's atom:link is not promoted to Item.Link while the channel's is
+	jsonAuthorNotInherited bool // gofeed/5: JSON Feed items without authors do not inherit the feed's (the expectation follows the current behaviour while this is on)
+	lowerCaseRFC3339       bool // gofeed/6: RFC 3339 dates with a lower-case t or z do not parse
+	twoDigitYears          bool // gofeed/7: two-digit years 50..68 are read as 2050..2068 (RFC 5322: 1950..1968)
+	enclosureBase          bool // gofeed/8: an RSS enclosure url is not resolved against xml:base while link, image and atom:link are
+	rdfAbout               bool // gofeed/9: an RSS 1.0 item's rdf:about is not its GUID
+	jsonBOM                bool // gofeed/10: a JSON Feed with a byte order mark is detected as JSON and then rejected
+}{
+	authorShapes:           noKnown,
+	keywordsUntrimmed:      noKnown,
+	extensionEntities:      noKnown,
+	itemAtomLink:           noKnown,
+	jsonAuthorNotInherited: noKnown,
+	lowerCaseRFC3339:       noKnown,
+	twoDigitYears:          noKnown,
+	enclosureBase:          noKnown,
+	rdfAbout:               noKnown,
+	jsonBOM:                noKnown,
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string {
+	if noKnown {
+		return nil
+	}
+	return []string{id}
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// fail reports a failure of the case: normally ht.Fatalf, in collect mode it records the
+// message and lets the case go on.
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case carrying the shapes of the recorded
+// bugs named (none for a plain failure): the failure names the shapes, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (a guard that never
+// fires, since the generators and writers leave the shapes out then).
+func (c *collector) mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// cat draws one string from each generator and joins them: the pieces of a token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// dec is the decimal text of an integer generator.
+func dec(g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, strconv.Itoa)
+}
+
+// distinct drops the repeats of a list, keeping the first occurrences.
+func distinct[T comparable](xs []T) []T {
+	seen := map[T]bool{}
+	var out []T
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// tape is a drawn list of small integers that a pure writer consumes in order, recycled
+// modulo its length, for the choices a document leaves free (the order of children, the
+// spelling of a character, whitespace). An empty tape answers 0 to every question, so the
+// shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 || n <= 1 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// pick is one of the options (the first on an empty tape).
+func (t *tape) pick(opts []string) string { return opts[t.next(len(opts))] }
+
+// order is a permutation of n positions: a stable sort by one rank per position, so equal
+// ranks (and an empty tape) keep the order.
+func (t *tape) order(n int) []int {
+	idx := make([]int, n)
+	ranks := make([]int, n)
+	for i := range idx {
+		idx[i] = i
+		ranks[i] = t.next(100)
+	}
+	sort.SliceStable(idx, func(a, b int) bool { return ranks[idx[a]] < ranks[idx[b]] })
+	return idx
+}
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// --------------------------------------------------------------------------- model
+
+type mperson struct {
+	name, email, url string
+	angle            bool // RSS: a person with both written "name <email>" (gofeed/1)
+}
+
+type menc struct{ url, typ, length string }
+
+type mdate struct {
+	t     time.Time // the instant, in the zone it was written with
+	raw   string    // the text as written
+	lower bool      // RFC 3339 with a lower-case t and z (gofeed/6)
+}
+
+// mcat is a category: its term and, when not empty, its label (Atom) or domain (RSS).
+type mcat struct{ name, label string }
+
+type mitem struct {
+	title, link, guid, desc, content string
+	perma                            int  // RSS: the guid's isPermaLink attribute: 0 absent, 1 false, 2 true
+	titleHTML                        bool // Atom: title written as type="html" (value is the HTML text)
+	pub, upd                         *mdate
+	author                           *mperson // RSS: <author>/<dc:creator>; JSON: author
+	dcCreator                        bool     // RSS: the author goes in dc:creator (name only)
+	authors                          []mperson
+	atomLink                         bool // RSS: the link written as <atom:link> (gofeed/4)
+	cats                             []mcat
+	keywords                         []string // RSS: itunes:keywords
+	kwSep                            int      // RSS: how the keywords are joined (keywordSeps)
+	encs                             []menc
+	custom                           map[string]string // RSS: unknown item children
+	external, image                  string            // JSON
+	hasContentHTML                   bool              // JSON: content_html (else content_text)
+	extraText                        string            // JSON: a content_text beside content_html
+}
+
+type mfeed struct {
+	kind                              string // rss, atom, json
+	version                           string // JSON version URL
+	base                              string // RSS: the xml:base of the document ("" none); the model's URLs are absolute
+	title, desc, link, feedLink, lang string
+	copyright, generator              string
+	pub, upd                          *mdate
+	author                            *mperson
+	authors                           []mperson
+	imageURL, imageTitle              string
+	cats                              []mcat
+	keywords                          []string
+	kwSep                             int
+	items                             []mitem
+	linkFirst                         bool   // Atom: alternate link before the self link
+	favicon                           string // JSON
+	userComment                       bool   // JSON: the copyright written as user_comment
+}
+
+// --------------------------------------------------------------------------- generators
+
+// plainPieces: no & < > and no leading/trailing blanks (the values are trimmed by the parsers
+// and HTML-sanitized by feedparser).
+var plainPieces = []string{"a", "B", "z", "0", "9", " ", "-", ".", ",", "\u00e9", "\u65e5\u672c", "\u00df", "'", "\"", "!", "?", ":", ";", "(", ")", "/", "_", "=", "%", "#", "\U0001F600", "x y"}
+var markupPieces = []string{"&", "<", ">", "&amp;", "&lt;", "<b>", "</b>", "&#65;", "&copy;", "]]", "]]>", "<![CDATA[", "&&", "< ", "a<b"}
+
+var (
+	plainPiece = hegel.SampledFrom(plainPieces)
+	anyPiece   = weighted(choice[string]{70, plainPiece}, choice[string]{30, hegel.SampledFrom(markupPieces)})
+)
+
+// joined: lo to hi pieces joined and trimmed.
+func joined(piece hegel.Generator[string], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(many(piece, lo, hi), func(ps []string) string { return strings.TrimSpace(strings.Join(ps, "")) })
+}
+
+// nonBlank keeps the texts that are not empty after trimming (a piece of blanks alone, rare).
+func nonBlank(g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Filter(g, func(s string) bool { return s != "" })
+}
+
+var (
+	plainText0 = joined(plainPiece, 0, 6)           // possibly empty
+	plainText1 = nonBlank(joined(plainPiece, 1, 6)) // never empty
+	anyText    = nonBlank(joined(anyPiece, 1, 6))   // may contain markup characters, never empty
+)
+
+func isPlain(s string) bool { return !strings.ContainsAny(s, "&<>") }
+
+var (
+	hosts    = hegel.SampledFrom([]string{"example.com", "feeds.example.org", "x.io", "a-b.example.net"})
+	segments = hegel.SampledFrom([]string{"a", "b", "posts", "2024", "x-y", "p_1", "i.html"})
+	suffixes = hegel.SampledFrom([]string{"?id=1", "?a=1&b=2", "#frag", ".mp3", ".png"})
+	basePool = []string{"http://example.com/feeds/", "https://x.io/a/b/", "http://a-b.example.net/"}
+	bases    = hegel.SampledFrom(basePool)
+)
+
+// paths: lo to two segments each followed by a slash, the last slash replaced by a suffix 30%
+// of the time.
+func paths(lo int) hegel.Generator[string] {
+	return hegel.Map(pairs(many(segments, lo, 2), maybe(30, suffixes)), func(p pair[[]string, string]) string {
+		u := ""
+		for _, s := range p.a {
+			u += s + "/"
+		}
+		if p.b != "" {
+			u = strings.TrimSuffix(u, "/") + p.b
+		}
+		return u
+	})
+}
+
+// urlsOf: an absolute URL, or under an xml:base one below it (written relative by the writer).
+func urlsOf(base string) hegel.Generator[string] {
+	if base != "" {
+		return cat(lit(base), paths(1))
+	}
+	return cat(hegel.SampledFrom([]string{"http", "https"}), lit("://"), hosts, lit("/"), paths(0))
+}
+
+var (
+	firstNames = []string{"Ann", "Bob", "\u00c9va", "Li", "Jos\u00e9", "Mary Jane", "O Neil", "Zo\u00eb"}
+	lastNames  = []string{"Lee", "Smith", "M\u00fcller", "van Dyk", "\u00d3 Briain", "Kim"}
+	plainNames = cat(hegel.SampledFrom(firstNames), lit(" "), hegel.SampledFrom(lastNames))
+	// oddNames: names outside the shapes the RSS author parser knows (gofeed/1): a handle, a
+	// name with parentheses.
+	oddNames = hegel.SampledFrom([]string{"@jack", "@ann_lee", "Smith & Sons (Ltd)"})
+	emails   = cat(hegel.SampledFrom([]string{"ann", "bob", "j.doe", "a_b", "x1"}), lit("@"), hosts)
+)
+
+// namesOf: a name; a handle or a parenthesised name one time in five, which Atom holds in a
+// structured field while RSS texts and JSON author names go through the parser that misreads
+// them (gofeed/1): under HEGEL_NO_KNOWN=1 the RSS and JSON names are plain.
+func namesOf(kind string) hegel.Generator[string] {
+	odd := weighted(choice[string]{80, plainNames}, choice[string]{20, oddNames})
+	if kind == "rss" || kind == "json" {
+		return shaped(odd, plainNames)
+	}
+	return odd
+}
+
+// personsOf: a name only, an email only, or both (twice as often); a url half of the time when
+// withURL; an RSS person with both is written "name <email>" 30% of the time (gofeed/1), never
+// under HEGEL_NO_KNOWN=1.
+func personsOf(kind string, withURL bool) hegel.Generator[mperson] {
+	names := namesOf(kind)
+	urls := hegel.Just("")
+	if withURL {
+		urls = maybe(50, urlsOf(""))
+	}
+	angle := hegel.Just(false)
+	if kind == "rss" {
+		angle = shaped(chance(30), hegel.Just(false))
+	}
+	bare := weighted(
+		choice[mperson]{1, hegel.Map(names, func(n string) mperson { return mperson{name: n} })},
+		choice[mperson]{1, hegel.Map(emails, func(e string) mperson { return mperson{email: e} })},
+		choice[mperson]{2, hegel.Map(pairs(names, emails), func(p pair[string, string]) mperson { return mperson{name: p.a, email: p.b} })},
+	)
+	return hegel.Composite(func(tc hegel.TestCase) mperson {
+		p := hegel.Draw(tc, bare)
+		p.url = hegel.Draw(tc, urls)
+		p.angle = hegel.Draw(tc, angle)
+		return p
+	})
+}
+
+// namedPersons: a person with a name and no email (a JSON author, a dc:creator), a url half of
+// the time when withURL.
+func namedPersons(kind string, withURL bool) hegel.Generator[mperson] {
+	urls := hegel.Just("")
+	if withURL {
+		urls = maybe(50, urlsOf(""))
+	}
+	return hegel.Map(pairs(namesOf(kind), urls), func(p pair[string, string]) mperson { return mperson{name: p.a, url: p.b} })
+}
+
+var zoneTable = map[string]int{ // seconds, as gofeed's table
+	"UT": 0, "GMT": 0, "UTC": 0, "EST": -5 * 3600, "EDT": -4 * 3600, "CST": -6 * 3600, "CDT": -5 * 3600,
+	"MST": -7 * 3600, "MDT": -6 * 3600, "PST": -8 * 3600, "PDT": -7 * 3600,
+}
+var zoneNames = []string{"UT", "GMT", "UTC", "EST", "EDT", "CST", "CDT", "MST", "MDT", "PST", "PDT"}
+var offsets = []int{0, 0, 3600, -3600, 7200, -18000, 19800, -12600, 34200, 3600 * 14, -3600 * 12, 60 * 45}
+
+// clock is the fields of an instant.
+type clock struct{ y, mo, d, h, mi, s int }
+
+func (c clock) in(loc *time.Location) time.Time {
+	return time.Date(c.y, time.Month(c.mo), c.d, c.h, c.mi, c.s, 0, loc)
+}
+
+// years: 1971 to 2037 nine times in ten, else a year of note.
+var years = weighted(
+	choice[int]{9, hegel.Integers(1971, 2037)},
+	choice[int]{1, hegel.SampledFrom([]int{1900, 1969, 1970, 2038, 2100, 9999})},
+)
+
+// clocksIn: a clock with a year from ys, a day of 1 to 28.
+func clocksIn(ys hegel.Generator[int]) hegel.Generator[clock] {
+	return hegel.Composite(func(tc hegel.TestCase) clock {
+		return clock{
+			y:  hegel.Draw(tc, ys),
+			mo: hegel.Draw(tc, hegel.Integers(1, 12)),
+			d:  hegel.Draw(tc, hegel.Integers(1, 28)),
+			h:  hegel.Draw(tc, hegel.Integers(0, 23)),
+			mi: hegel.Draw(tc, hegel.Integers(0, 59)),
+			s:  hegel.Draw(tc, hegel.Integers(0, 59)),
+		}
+	})
+}
+
+var clocks = clocksIn(years)
+
+// namedZoneDates: a date in the layout with a zone name from the table.
+func namedZoneDates(layout string) hegel.Generator[*mdate] {
+	return hegel.FlatMap(hegel.SampledFrom(zoneNames), func(name string) hegel.Generator[*mdate] {
+		loc := time.FixedZone(name, zoneTable[name])
+		return hegel.Map(clocks, func(c clock) *mdate {
+			t := c.in(loc)
+			return &mdate{t: t, raw: t.Format(layout)}
+		})
+	})
+}
+
+// offsetDates: a date in the layout with a numeric offset.
+func offsetDates(layout string) hegel.Generator[*mdate] {
+	return hegel.FlatMap(hegel.SampledFrom(offsets), func(off int) hegel.Generator[*mdate] {
+		loc := time.FixedZone("", off)
+		return hegel.Map(clocks, func(c clock) *mdate {
+			t := c.in(loc)
+			return &mdate{t: t, raw: t.Format(layout)}
+		})
+	})
+}
+
+// rfcSpec: an RFC 3339 date: a numeric offset, an instant, fractional seconds when millis is
+// not 0, and lower-case t and z (gofeed/6) when lower.
+type rfcSpec struct {
+	off    int
+	c      clock
+	millis int
+	lower  bool
+}
+
+func (s rfcSpec) date() *mdate {
+	t := s.c.in(time.FixedZone("", s.off))
+	layout := "2006-01-02T15:04:05Z07:00"
+	if s.millis > 0 {
+		t = t.Add(time.Duration(s.millis) * time.Millisecond)
+		layout = "2006-01-02T15:04:05.000Z07:00"
+	}
+	raw := t.Format(layout)
+	if s.lower {
+		raw = strings.NewReplacer("T", "t", "Z", "z").Replace(raw)
+	}
+	return &mdate{t: t, raw: raw, lower: s.lower}
+}
+
+// rfc3339Dates: the Atom and JSON Feed date form, with fractional seconds a quarter of the time
+// and by default a lower-case t and z one time in five (the shape of gofeed/6).
+var rfc3339Dates = hegel.Map(hegel.Composite(func(tc hegel.TestCase) rfcSpec {
+	return rfcSpec{
+		off:    hegel.Draw(tc, hegel.SampledFrom(offsets)),
+		c:      hegel.Draw(tc, clocks),
+		millis: hegel.Draw(tc, maybe(25, hegel.Integers(1, 999))),
+		lower:  hegel.Draw(tc, shaped(chance(20), hegel.Just(false))),
+	}
+}), rfcSpec.date)
+
+// rssDates: an RFC 822 style date (RFC 1123 with an offset twice as often as the others) with
+// a numeric offset or a zone name from the table, or an RFC 3339 date, which feeds use too.
+var rssDates = weighted(
+	choice[*mdate]{2, offsetDates(time.RFC1123Z)},
+	choice[*mdate]{1, namedZoneDates("Mon, 02 Jan 2006 15:04:05 MST")},
+	choice[*mdate]{1, offsetDates("Mon, 2 Jan 2006 15:04:05 -0700")},
+	choice[*mdate]{1, offsetDates("02 Jan 2006 15:04:05 -0700")},
+	choice[*mdate]{1, rfc3339Dates},
+)
+
+var (
+	catNames = hegel.SampledFrom([]string{"news", "Go", "tech & more", "a/b", "\u00e9t\u00e9", "x y", "1"})
+	labels   = hegel.SampledFrom([]string{"News", "Label & co", "L"})
+	catSpecs = hegel.Composite(func(tc hegel.TestCase) mcat {
+		return mcat{name: hegel.Draw(tc, catNames), label: hegel.Draw(tc, maybe(40, labels))}
+	})
+	// cats: up to three categories of distinct terms (feedparser drops duplicate tags), each
+	// with a label 40% of the time.
+	cats = hegel.Map(many(catSpecs, 0, 3), func(cs []mcat) []mcat {
+		seen := map[string]bool{}
+		var out []mcat
+		for _, c := range cs {
+			if !seen[c.name] {
+				seen[c.name] = true
+				out = append(out, c)
+			}
+		}
+		return out
+	})
+)
+
+// terms are the category names.
+func terms(cs []mcat) []string {
+	var out []string
+	for _, c := range cs {
+		out = append(out, c.name)
+	}
+	return out
+}
+
+var (
+	// keywordLists: itunes:keywords 30% of the time: one to three distinct words without commas.
+	keywordLists = maybe(30, hegel.Map(many(hegel.SampledFrom([]string{"news", "go", "tech", "podcast", "a b", "1"}), 1, 3), distinct[string]))
+	// keywordSeps: how the words are joined and ended: a bare comma, or (the shape of gofeed/2,
+	// left out under HEGEL_NO_KNOWN=1) blanks around the comma, a doubled comma (an empty
+	// keyword), a trailing blank.
+	keywordSeps   = [][2]string{{",", ""}, {", ", ""}, {" , ", ""}, {",,", ""}, {",", " "}}
+	keywordSepIdx = shaped(hegel.Integers(0, len(keywordSeps)-1), hegel.Just(0))
+)
+
+var encTypes = hegel.SampledFrom([]string{"audio/mpeg", "image/png", "video/mp4", "application/pdf", "image/jpeg"})
+
+// encsOf: up to two enclosures, with a length 80% of the time.
+func encsOf(urls hegel.Generator[string]) hegel.Generator[[]menc] {
+	return many(hegel.Composite(func(tc hegel.TestCase) menc {
+		return menc{url: hegel.Draw(tc, urls), typ: hegel.Draw(tc, encTypes), length: hegel.Draw(tc, maybe(80, dec(hegel.Integers(1, 99999999))))}
+	}), 0, 2)
+}
+
+// authorSpec: an RSS item's author and whether it goes in dc:creator.
+type authorSpec struct {
+	p  *mperson
+	dc bool
+}
+
+var idPrefixes = hegel.SampledFrom([]string{"tag:x,2024:1", "urn:uuid:1234", "id-", "g"})
+
+// itemsOf: an item of the kind, its URLs from urls.
+func itemsOf(kind string, urls hegel.Generator[string]) hegel.Generator[mitem] {
+	textGUIDs := weighted(choice[string]{1, urls}, choice[string]{1, cat(idPrefixes, dec(hegel.Integers(0, 99)))})
+	guids := maybe(80, textGUIDs)
+	contents := maybe(50, plainText1)
+	pubs := maybe(70, rfc3339Dates)
+	upds := maybe(80, rfc3339Dates)
+	authorSpecs := hegel.Just(authorSpec{})
+	authorLists := hegel.Just([]mperson(nil))
+	permas := hegel.Just(0)
+	atomLinks := hegel.Just(false)
+	customs := hegel.Just(map[string]string(nil))
+	keywords, kwSeps := hegel.Just([]string(nil)), hegel.Just(0)
+	htmls := hegel.Just(false)
+	externals, images, extraTexts := hegel.Just(""), hegel.Just(""), hegel.Just("")
+	contentHTML := hegel.Just(false)
+	switch kind {
+	case "rss":
+		pubs = maybe(70, rssDates)
+		upds = maybe(24, rfc3339Dates)
+		// the author 60% of the time: a person in <author>, or (30% of those) a name in dc:creator
+		authorSpecs = maybe(60, weighted(
+			choice[authorSpec]{7, hegel.Map(personsOf("rss", false), func(p mperson) authorSpec { return authorSpec{p: &p} })},
+			choice[authorSpec]{3, hegel.Map(namedPersons("rss", false), func(p mperson) authorSpec { return authorSpec{p: &p, dc: true} })},
+		))
+		permas = hegel.Integers(0, 2)
+		atomLinks = shaped(chance(20), hegel.Just(false))
+		customs = maybe(30, hegel.Maps(hegel.SampledFrom([]string{"extra", "Rating", "x-note", "sub_title"}), anyText).MinSize(1).MaxSize(2))
+		keywords, kwSeps = keywordLists, keywordSepIdx
+	case "atom":
+		authorLists = many(personsOf("atom", true), 0, 2)
+		htmls = chance(25)
+	case "json":
+		guids = maybe(80, weighted(choice[string]{4, textGUIDs}, choice[string]{1, dec(hegel.Integers(0, 1<<30))}))
+		contents = plainText1
+		authorSpecs = hegel.Map(optional(40, namedPersons("json", true)), func(p *mperson) authorSpec { return authorSpec{p: p} })
+		authorLists = maybe(40, many(namedPersons("json", true), 1, 2))
+		externals, images = maybe(30, urls), maybe(30, urls)
+		contentHTML = chance(50)
+		extraTexts = maybe(30, plainText1)
+	}
+	encs := encsOf(urls)
+	return hegel.Composite(func(tc hegel.TestCase) mitem {
+		it := mitem{
+			title:          hegel.Draw(tc, maybe(90, anyText)),
+			link:           hegel.Draw(tc, maybe(80, urls)),
+			guid:           hegel.Draw(tc, guids),
+			perma:          hegel.Draw(tc, permas),
+			desc:           hegel.Draw(tc, maybe(70, plainText0)),
+			content:        hegel.Draw(tc, contents),
+			pub:            hegel.Draw(tc, pubs),
+			upd:            hegel.Draw(tc, upds),
+			authors:        hegel.Draw(tc, authorLists),
+			atomLink:       hegel.Draw(tc, atomLinks),
+			cats:           hegel.Draw(tc, cats),
+			keywords:       hegel.Draw(tc, keywords),
+			kwSep:          hegel.Draw(tc, kwSeps),
+			encs:           hegel.Draw(tc, encs),
+			custom:         hegel.Draw(tc, customs),
+			external:       hegel.Draw(tc, externals),
+			image:          hegel.Draw(tc, images),
+			hasContentHTML: hegel.Draw(tc, contentHTML),
+			extraText:      hegel.Draw(tc, extraTexts),
+		}
+		a := hegel.Draw(tc, authorSpecs)
+		it.author, it.dcCreator = a.p, a.dc
+		it.titleHTML = it.title != "" && hegel.Draw(tc, htmls)
+		return it
+	})
+}
+
+// feedsOf: a model feed of the kind under the xml:base (RSS; "" for none).
+func feedsOf(kind, base string) hegel.Generator[*mfeed] {
