+// entityCase: a dc:creator and a dc:subject holding characters with HTML names, and the
+// description holding the creator's text too (a core element, the reference behaviour).
+type entityCase struct {
+	creator, subject string
+}
+
+// refs writes every character with an HTML name as that entity (the shape of gofeed/3) or,
+// under HEGEL_NO_KNOWN=1, as a decimal character reference, which the XML layer decodes.
+func refs(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch {
+		case namedEntities[r] == "":
+			b.WriteRune(r)
+		case noKnown:
+			fmt.Fprintf(&b, "&#%d;", r)
+		default:
+			b.WriteString("&" + namedEntities[r] + ";")
+		}
+	}
+	return b.String()
+}
+
+func (e entityCase) doc() string {
+	return rssOf("<item><title>i</title><description>" + refs(e.creator) + "</description><dc:creator>" + refs(e.creator) + "</dc:creator><dc:subject>" + refs(e.subject) + "</dc:subject></item>")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (e entityCase) GoString() string {
+	return fmt.Sprintf("dc:creator %q dc:subject %q", refs(e.creator), refs(e.subject))
+}
+
+var (
+	// entityTexts: texts with at least one character that has an HTML name.
+	entityTexts = cat(
+		hegel.SampledFrom([]string{"", "Caf", "Jos", "d", "Zo"}),
+		hegel.SampledFrom([]string{"\u00e9", "\u00c9", "\u00fc", "\u00eb", "\u00df", "\u00e0", "\u00a9"}),
+		hegel.SampledFrom([]string{"", " M\u00fcller", "j\u00e0 vu", "s", " & co"}),
+	)
+	entityCases = hegel.Composite(func(tc hegel.TestCase) entityCase {
+		return entityCase{creator: hegel.Draw(tc, entityTexts), subject: hegel.Draw(tc, entityTexts)}
+	})
+)
