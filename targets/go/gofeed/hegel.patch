+package gofeed_test
+
+// Hegel property tests for mmcdole/gofeed, written for the Hegel zoo.
+// See targets/go/gofeed/README.md.
+//
+// Oracles: a model feed (title, links, dates, people, categories, enclosures, items) written
+// out as RSS 2.0, Atom 1.0 or JSON Feed by the harness, with the documented mapping of each
+// format onto the universal Feed as the expected result; Python feedparser reading the same
+// document; Go's time.Parse on the layout a date was written in.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/mmcdole/gofeed"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// gofeed/1: author strings outside the four shapes "name (email)", "email (name)", name,
+	// email are dropped or misread ("Name <email>" becomes the email, "@handle" and a name
+	// with parentheses vanish). The generators stay inside the four shapes.
+	authorShapes bool
+	// gofeed/2: itunes:keywords are split on "," without trimming or dropping empties. Pin only.
+	keywordsUntrimmed bool
+	// gofeed/3: HTML named entities are decoded in core elements but left as written in
+	// extension elements (dc:, itunes:, ...). The writers use XML entities and character
+	// references only.
+	extensionEntities bool
+	// gofeed/4: an item's atom:link is not promoted to Item.Link while the channel's is. Pin only.
+	itemAtomLink bool
+	// gofeed/5: JSON Feed items without authors do not inherit the feed's author. The expected
+	// mapping follows the current behaviour while this is on.
+	jsonAuthorNotInherited bool
+	// gofeed/6: RFC 3339 dates with a lower-case t or z are rejected. The date generators write
+	// upper case only.
+	lowerCaseRFC3339 bool
+	// gofeed/7: two-digit years 50..68 are read as 2050..2068 (RFC 5322: 1950..1968). Two-digit
+	// years are generated in 1969..2068 only.
+	twoDigitYears bool
+	// gofeed/8: an RSS enclosure url is not resolved against xml:base while link, comments and
+	// itunes:image are. Pin only.
+	enclosureBase bool
+	// gofeed/9: an RSS 1.0 item's rdf:about is not its GUID. Pin only.
+	rdfAbout bool
+	// gofeed/10: a JSON Feed with a UTF-8 byte order mark is detected as JSON and then rejected
+	// by the JSON decoder. The robustness property adds no BOM to JSON documents.
+	jsonBOM bool
+}{true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- model
+
+type mperson struct{ name, email, url string }
+
+type menc struct{ url, typ, length string }
+
+type mdate struct {
+	t   time.Time // the instant, in the zone it was written with
+	raw string    // the text as written
+}
+
+type mitem struct {
+	title, link, guid, desc, content string
+	titleHTML                        bool // Atom: title written as type="html" (value is the HTML text)
+	pub, upd                         *mdate
+	author                           *mperson // RSS: <author>/<dc:creator>; JSON: author
+	authors                          []mperson
+	authorsListed                    bool // JSON: an "authors" array was written
+	dcCreator                        bool // RSS: the author goes in dc:creator (name only)
+	cats                             []string
+	labels                           []string // Atom: labels per category ("" none)
+	encs                             []menc
+	custom                           map[string]string // RSS: unknown item children
+	external, image                  string            // JSON
+	idNumber                         bool              // JSON: id written as a number
+	hasContentHTML                   bool              // JSON: content_html (else content_text)
+}
+
+type mfeed struct {
+	kind                              string // rss, atom, json
+	version                           string // JSON version URL
+	title, desc, link, feedLink, lang string
+	copyright, generator              string
+	pub, upd                          *mdate
+	author                            *mperson
+	authors                           []mperson
+	authorsListed                     bool
+	imageURL, imageTitle              string
+	cats                              []string
+	labels                            []string
+	items                             []mitem
+	linkFirst                         bool // Atom: alternate link before the self link
+}
+
+// --------------------------------------------------------------------------- generators
+
+// plainPieces: no & < > and no leading/trailing blanks (the values are trimmed by the parsers
+// and HTML-sanitized by feedparser).
+var plainPieces = []string{"a", "B", "z", "0", "9", " ", "-", ".", ",", "é", "日本", "ß", "'", "\"", "!", "?", ":", ";", "(", ")", "/", "_", "=", "%", "#", "😀", "x y"}
+var markupPieces = []string{"&", "<", ">", "&amp;", "&lt;", "<b>", "</b>", "&#65;", "&copy;", "]]", "]]>", "<![CDATA[", "&&", "< ", "a<b"}
+
+func genPlain(tc hegel.TestCase, minLen int) string {
+	for {
+		var b strings.Builder
+		for k := n(tc, minLen, 6); k > 0; k-- {
+			b.WriteString(pick(tc, plainPieces))
+		}
+		s := strings.TrimSpace(b.String())
+		if len(s) >= minLen || minLen == 0 {
+			return s
+		}
+	}
+}
+
+// genAny: text that may contain markup characters, never blank-padded, never empty.
+func genAny(tc hegel.TestCase) string {
+	for {
+		var b strings.Builder
+		for k := n(tc, 1, 6); k > 0; k-- {
+			if chance(tc, 30) {
+				b.WriteString(pick(tc, markupPieces))
+			} else {
+				b.WriteString(pick(tc, plainPieces))
+			}
+		}
+		s := strings.TrimSpace(b.String())
+		if s != "" {
+			return s
+		}
+	}
+}
+
+func isPlain(s string) bool { return !strings.ContainsAny(s, "&<>") }
+
+var hosts = []string{"example.com", "feeds.example.org", "x.io", "a-b.example.net"}
+
+func genURL(tc hegel.TestCase) string {
+	u := pick(tc, []string{"http", "https"}) + "://" + pick(tc, hosts) + "/"
+	for k := n(tc, 0, 2); k > 0; k-- {
+		u += pick(tc, []string{"a", "b", "posts", "2024", "x-y", "p_1", "i.html"}) + "/"
+	}
+	if chance(tc, 30) {
+		u = strings.TrimSuffix(u, "/") + pick(tc, []string{"?id=1", "?a=1&b=2", "#frag", ".mp3", ".png"})
+	}
+	return u
+}
+
+var firstNames = []string{"Ann", "Bob", "Éva", "Li", "José", "Mary Jane", "O Neil", "Zoë"}
+var lastNames = []string{"Lee", "Smith", "Müller", "van Dyk", "Ó Briain", "Kim"}
+
+func genName(tc hegel.TestCase) string {
+	return pick(tc, firstNames) + " " + pick(tc, lastNames)
+}
+
+func genEmail(tc hegel.TestCase) string {
+	return pick(tc, []string{"ann", "bob", "j.doe", "a_b", "x1"}) + "@" + pick(tc, hosts)
+}
+
+// genPerson: one of the four shapes the RSS author parser knows (gofeed/1 for the rest).
+func genPerson(tc hegel.TestCase, withURL bool) mperson {
+	p := mperson{}
+	switch n(tc, 1, 4) {
+	case 1:
+		p.name = genName(tc)
+	case 2:
+		p.email = genEmail(tc)
+	default:
+		p.name, p.email = genName(tc), genEmail(tc)
+	}
+	if withURL && chance(tc, 50) {
+		p.url = genURL(tc)
+	}
+	return p
+}
+
+var zoneTable = map[string]int{ // seconds, as gofeed's table
+	"UT": 0, "GMT": 0, "UTC": 0, "EST": -5 * 3600, "EDT": -4 * 3600, "CST": -6 * 3600, "CDT": -5 * 3600,
+	"MST": -7 * 3600, "MDT": -6 * 3600, "PST": -8 * 3600, "PDT": -7 * 3600,
+}
+var zoneNames = []string{"UT", "GMT", "UTC", "EST", "EDT", "CST", "CDT", "MST", "MDT", "PST", "PDT"}
+var offsets = []int{0, 0, 3600, -3600, 7200, -18000, 19800, -12600, 34200, 3600 * 14, -3600 * 12, 60 * 45}
+
+func genInstant(tc hegel.TestCase, loc *time.Location) time.Time {
+	y := n(tc, 1971, 2037)
+	if chance(tc, 10) {
+		y = pick(tc, []int{1900, 1969, 1970, 2038, 2100, 9999})
+	}
+	return time.Date(y, time.Month(n(tc, 1, 12)), n(tc, 1, 28), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59), 0, loc)
+}
+
+// genRSSDate: an RFC 822 style date (or RFC 3339, which feeds use too) with a numeric offset
+// or a zone name from the table.
+func genRSSDate(tc hegel.TestCase) *mdate {
+	switch n(tc, 1, 6) {
+	case 1:
+		name := pick(tc, zoneNames)
+		t := genInstant(tc, time.FixedZone(name, zoneTable[name]))
+		return &mdate{t, t.Format("Mon, 02 Jan 2006 15:04:05 MST")}
+	case 2:
+		t := genInstant(tc, time.FixedZone("", pick(tc, offsets)))
+		return &mdate{t, t.Format("Mon, 2 Jan 2006 15:04:05 -0700")}
+	case 3:
+		t := genInstant(tc, time.FixedZone("", pick(tc, offsets)))
+		return &mdate{t, t.Format("02 Jan 2006 15:04:05 -0700")}
+	case 4:
+		return genRFC3339(tc)
+	default:
+		t := genInstant(tc, time.FixedZone("", pick(tc, offsets)))
+		return &mdate{t, t.Format(time.RFC1123Z)}
+	}
+}
+
+// genRFC3339: the Atom and JSON Feed date form, sometimes with fractional seconds.
+func genRFC3339(tc hegel.TestCase) *mdate {
+	off := pick(tc, offsets)
+	t := genInstant(tc, time.FixedZone("", off))
+	layout := "2006-01-02T15:04:05Z07:00"
+	if chance(tc, 25) {
+		t = t.Add(time.Duration(n(tc, 1, 999)) * time.Millisecond)
+		layout = "2006-01-02T15:04:05.000Z07:00"
+	}
+	return &mdate{t, t.Format(layout)}
+}
+
+func genCats(tc hegel.TestCase) ([]string, []string) {
+	var cats, labels []string
+	seen := map[string]bool{}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		c := pick(tc, []string{"news", "Go", "tech & more", "a/b", "été", "x y", "1"})
+		if seen[c] {
+			continue // feedparser drops duplicate tags
+		}
+		seen[c] = true
+		cats = append(cats, c)
+		if chance(tc, 40) {
+			labels = append(labels, pick(tc, []string{"News", "Label & co", "L"}))
+		} else {
+			labels = append(labels, "")
+		}
+	}
+	return cats, labels
+}
+
+var encTypes = []string{"audio/mpeg", "image/png", "video/mp4", "application/pdf", "image/jpeg"}
+
+func genEncs(tc hegel.TestCase) []menc {
+	var out []menc
+	for k := n(tc, 0, 2); k > 0; k-- {
+		e := menc{url: genURL(tc), typ: pick(tc, encTypes)}
+		if chance(tc, 80) {
+			e.length = strconv.Itoa(n(tc, 1, 99999999))
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+func genItem(tc hegel.TestCase, kind string) mitem {
+	it := mitem{}
+	if chance(tc, 90) {
+		it.title = genAny(tc)
+	}
+	if chance(tc, 80) {
+		it.link = genURL(tc)
+	}
+	if chance(tc, 80) {
+		if chance(tc, 50) {
+			it.guid = genURL(tc)
+		} else {
+			it.guid = pick(tc, []string{"tag:x,2024:1", "urn:uuid:1234", "id-", "g"}) + strconv.Itoa(n(tc, 0, 99))
+		}
+	}
+	if chance(tc, 70) {
+		it.desc = genPlain(tc, 0)
+	}
+	if chance(tc, 50) {
+		it.content = genPlain(tc, 1)
+	}
+	if chance(tc, 70) {
+		if kind == "rss" {
+			it.pub = genRSSDate(tc)
+		} else {
+			it.pub = genRFC3339(tc)
+		}
+	}
+	if kind != "rss" || chance(tc, 30) {
+		if chance(tc, 80) {
+			it.upd = genRFC3339(tc)
+		}
+	}
+	switch kind {
+	case "rss":
+		if chance(tc, 60) {
+			p := genPerson(tc, false)
+			it.author = &p
+			it.dcCreator = chance(tc, 30)
+			if it.dcCreator {
+				p.email = ""
+				if p.name == "" {
+					p.name = genName(tc)
+				}
+				it.author = &p
+			}
+		}
+		if chance(tc, 30) {
+			it.custom = map[string]string{}
+			for k := n(tc, 1, 2); k > 0; k-- {
+				it.custom[pick(tc, []string{"extra", "Rating", "x-note", "sub_title"})] = genAny(tc)
+			}
+		}
+	case "atom":
+		for k := n(tc, 0, 2); k > 0; k-- {
+			it.authors = append(it.authors, genPerson(tc, true))
+		}
+		it.titleHTML = it.title != "" && chance(tc, 25)
+	case "json":
+		if chance(tc, 40) {
+			p := genPerson(tc, true)
+			if p.name == "" {
+				p.name = genName(tc)
+			}
+			p.email = ""
+			it.author = &p
+		}
+		if chance(tc, 40) {
+			it.authorsListed = true
+			for k := n(tc, 1, 2); k > 0; k-- {
+				p := genPerson(tc, true)
+				if p.name == "" {
+					p.name = genName(tc)
+				}
+				p.email = ""
+				it.authors = append(it.authors, p)
+			}
+		}
+		it.idNumber = it.guid != "" && chance(tc, 20)
+		if it.idNumber {
+			it.guid = strconv.Itoa(n(tc, 0, 1<<30))
+		}
+		it.hasContentHTML = chance(tc, 50)
+		if it.content == "" {
+			it.content = genPlain(tc, 1)
+		}
+		if chance(tc, 30) {
+			it.external = genURL(tc)
+		}
+		if chance(tc, 30) {
+			it.image = genURL(tc)
+		}
+	}
+	it.cats, it.labels = genCats(tc)
+	it.encs = genEncs(tc)
+	return it
+}
+
+func genFeed(tc hegel.TestCase, kind string) *mfeed {
+	f := &mfeed{kind: kind}
+	if chance(tc, 95) {
+		f.title = genAny(tc)
+	}
+	if chance(tc, 80) {
+		f.desc = genPlain(tc, 0)
+	}
+	if chance(tc, 90) {
+		f.link = genURL(tc)
+	}
+	if chance(tc, 50) {
+		f.feedLink = genURL(tc)
+	}
+	if chance(tc, 50) {
+		f.lang = pick(tc, []string{"en", "en-US", "fr", "de-CH"})
+	}
+	if chance(tc, 40) {
+		f.copyright = genPlain(tc, 1)
+	}
+	if chance(tc, 40) {
+		f.generator = genPlain(tc, 1)
+	}
+	if chance(tc, 50) {
+		f.imageURL = genURL(tc)
+		f.imageTitle = genPlain(tc, 1)
+	}
+	f.cats, f.labels = genCats(tc)
+	switch kind {
+	case "rss":
+		if chance(tc, 60) {
+			f.pub = genRSSDate(tc)
+		}
+		if chance(tc, 60) {
+			f.upd = genRSSDate(tc)
+		}
+		if chance(tc, 50) {
+			p := genPerson(tc, false)
+			f.author = &p
+		}
+	case "atom":
+		f.upd = genRFC3339(tc)
+		for k := n(tc, 0, 2); k > 0; k-- {
+			f.authors = append(f.authors, genPerson(tc, true))
+		}
+		f.linkFirst = chance(tc, 50)
+	case "json":
+		f.version = pick(tc, []string{"https://jsonfeed.org/version/1", "https://jsonfeed.org/version/1.1"})
+		if chance(tc, 40) {
+			p := genPerson(tc, true)
+			if p.name == "" {
+				p.name = genName(tc)
+			}
+			p.email = ""
+			f.author = &p
+		}
+		if chance(tc, 40) {
+			f.authorsListed = true
+			for k := n(tc, 1, 2); k > 0; k-- {
+				p := genPerson(tc, true)
+				if p.name == "" {
+					p.name = genName(tc)
+				}
+				p.email = ""
+				f.authors = append(f.authors, p)
+			}
+		}
+	}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		f.items = append(f.items, genItem(tc, kind))
+	}
+	return f
+}
+
+// --------------------------------------------------------------------------- XML writing
+
+// xmlText writes s as XML character data in one of several equivalent encodings: entity
+// escapes, character references, CDATA sections (split at random), or a mixture.
+func xmlText(tc hegel.TestCase, s string) string {
+	if s == "" {
+		return ""
+	}
+	switch n(tc, 1, 5) {
+	case 1, 2:
+		return xmlEscape(s)
+	case 3:
+		return charRefs(tc, s)
+	case 4:
+		if !strings.Contains(s, "]]>") {
+			return cdata(tc, s)
+		}
+		return xmlEscape(s)
+	default:
+		// a mixture: escaped head, CDATA tail
+		rs := []rune(s)
+		cut := n(tc, 0, len(rs))
+		head, tail := string(rs[:cut]), string(rs[cut:])
+		if strings.Contains(tail, "]]>") {
+			return xmlEscape(s)
+		}
+		return xmlEscape(head) + cdata(tc, tail)
+	}
+}
+
+func xmlEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;").Replace(s)
+}
+
+// charRefs: & < > and some other characters as decimal or hexadecimal references.
+func charRefs(tc hegel.TestCase, s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '&' || r == '<' || r == '>' || (r > 127 && chance(tc, 50)) || chance(tc, 10):
+			if chance(tc, 50) {
+				fmt.Fprintf(&b, "&#%d;", r)
+			} else {
+				fmt.Fprintf(&b, "&#x%X;", r)
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func cdata(tc hegel.TestCase, s string) string {
+	if s == "" {
+		return ""
+	}
+	rs := []rune(s)
+	if len(rs) > 1 && chance(tc, 30) {
+		cut := n(tc, 1, len(rs)-1)
+		return "<![CDATA[" + string(rs[:cut]) + "]]><![CDATA[" + string(rs[cut:]) + "]]>"
+	}
+	return "<![CDATA[" + s + "]]>"
+}
+
+func attrEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", "\"", "&quot;").Replace(s)
+}
+
+// ws: random inter-element whitespace.
+func ws(tc hegel.TestCase) string {
+	return pick(tc, []string{"", "\n", "\n  ", "\r\n\t", " "})
+}
+
+func shuffle(tc hegel.TestCase, xs []string) {
+	for i := len(xs) - 1; i > 0; i-- {
+		j := n(tc, 0, i)
+		xs[i], xs[j] = xs[j], xs[i]
+	}
+}
+
+// orderedPrefixes: repeatable elements whose document order is part of the result.
+var orderedPrefixes = []string{"<category", "<item>", "<entry>", "<author>", "<enclosure", "<link "}
+
+func isOrdered(el string) bool {
+	for _, p := range orderedPrefixes {
+		if strings.HasPrefix(el, p) {
+			return true
+		}
+	}
+	return false
+}
+
+// shuffleKeeping shuffles the elements but keeps the relative order of the repeatable ones.
+func shuffleKeeping(tc hegel.TestCase, xs []string) {
+	var ordered []string
+	for _, x := range xs {
+		if isOrdered(x) {
+			ordered = append(ordered, x)
+		}
+	}
+	shuffle(tc, xs)
+	k := 0
+	for i := range xs {
+		if isOrdered(xs[i]) {
+			xs[i] = ordered[k]
+			k++
+		}
+	}
+}
+
+func personRSS(tc hegel.TestCase, p mperson) string {
+	switch {
+	case p.name != "" && p.email != "":
+		if chance(tc, 50) {
+			return p.email + " (" + p.name + ")"
+		}
+		return p.name + " (" + p.email + ")"
+	case p.name != "":
+		return p.name
+	default:
+		return p.email
+	}
+}
+
+func writeRSS(tc hegel.TestCase, f *mfeed) string {
+	var ch []string
+	el := func(name, text string) { ch = append(ch, "<"+name+">"+xmlText(tc, text)+"</"+name+">") }
+	if f.title != "" {
+		el("title", f.title)
+	}
+	if f.link != "" {
+		el("link", f.link)
+	}
+	if f.desc != "" || chance(tc, 50) {
+		el("description", f.desc)
+	}
+	if f.lang != "" {
+		el("language", f.lang)
+	}
+	if f.copyright != "" {
+		el("copyright", f.copyright)
+	}
+	if f.generator != "" {
+		el("generator", f.generator)
+	}
+	if f.author != nil {
+		el("managingEditor", personRSS(tc, *f.author))
+	}
+	if f.pub != nil {
+		el("pubDate", f.pub.raw)
+	}
+	if f.upd != nil {
+		el("lastBuildDate", f.upd.raw)
+	}
+	if f.feedLink != "" {
+		ch = append(ch, `<atom:link rel="self" type="application/rss+xml" href="`+attrEscape(f.feedLink)+`"/>`)
+	}
+	for i, c := range f.cats {
+		dom := ""
+		if f.labels[i] != "" {
+			dom = ` domain="` + attrEscape(f.labels[i]) + `"`
+		}
+		ch = append(ch, "<category"+dom+">"+xmlText(tc, c)+"</category>")
+	}
+	if f.imageURL != "" {
+		ch = append(ch, "<image>"+ws(tc)+"<url>"+xmlText(tc, f.imageURL)+"</url><title>"+xmlText(tc, f.imageTitle)+"</title><link>"+xmlText(tc, f.link)+"</link>"+ws(tc)+"</image>")
+	}
+	for _, it := range f.items {
+		var ic []string
+		iel := func(name, text string) { ic = append(ic, "<"+name+">"+xmlText(tc, text)+"</"+name+">") }
+		if it.title != "" {
+			iel("title", it.title)
+		}
+		if it.link != "" {
+			iel("link", it.link)
+		}
+		if it.guid != "" {
+			perma := pick(tc, []string{"", ` isPermaLink="false"`, ` isPermaLink="true"`})
+			ic = append(ic, "<guid"+perma+">"+xmlText(tc, it.guid)+"</guid>")
+		}
+		if it.desc != "" {
+			iel("description", it.desc)
+		}
+		if it.content != "" {
+			iel("content:encoded", it.content)
+		}
+		if it.pub != nil {
+			iel("pubDate", it.pub.raw)
+		}
+		if it.upd != nil {
+			iel("dc:date", it.upd.raw)
+		}
+		if it.author != nil {
+			if it.dcCreator {
+				iel("dc:creator", it.author.name)
+			} else {
+				iel("author", personRSS(tc, *it.author))
+			}
+		}
+		for i, c := range it.cats {
+			dom := ""
+			if it.labels[i] != "" {
+				dom = ` domain="` + attrEscape(it.labels[i]) + `"`
+			}
+			ic = append(ic, "<category"+dom+">"+xmlText(tc, c)+"</category>")
+		}
+		for _, e := range it.encs {
+			attrs := []string{`url="` + attrEscape(e.url) + `"`, `type="` + e.typ + `"`}
+			if e.length != "" {
+				attrs = append(attrs, `length="`+e.length+`"`)
+			}
+			shuffle(tc, attrs)
+			ic = append(ic, "<enclosure "+strings.Join(attrs, " ")+pick(tc, []string{"/>", "></enclosure>"}))
+		}
+		for k, v := range it.custom {
+			iel(k, v)
+		}
+		shuffleKeeping(tc, ic)
+		ch = append(ch, "<item>"+ws(tc)+strings.Join(ic, ws(tc))+ws(tc)+"</item>")
+	}
+	shuffleKeeping(tc, ch)
+	decl := pick(tc, []string{"", `<?xml version="1.0"?>`, `<?xml version="1.0" encoding="UTF-8"?>` + "\n"})
+	return decl + `<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">` + ws(tc) + "<channel>" + ws(tc) + strings.Join(ch, ws(tc)) + ws(tc) + "</channel>" + ws(tc) + "</rss>" + pick(tc, []string{"", "\n"})
+}
+
+func personAtom(tc hegel.TestCase, tag string, p mperson) string {
+	var parts []string
+	if p.name != "" {
+		parts = append(parts, "<name>"+xmlText(tc, p.name)+"</name>")
+	}
+	if p.email != "" {
+		parts = append(parts, "<email>"+xmlText(tc, p.email)+"</email>")
+	}
+	if p.url != "" {
+		parts = append(parts, "<uri>"+xmlText(tc, p.url)+"</uri>")
+	}
+	shuffle(tc, parts)
+	return "<" + tag + ">" + ws(tc) + strings.Join(parts, ws(tc)) + ws(tc) + "</" + tag + ">"
+}
+
+func atomText(tc hegel.TestCase, name, s string, html bool) string {
+	if html {
+		// the value is HTML: the text HTML-escaped, then the XML layer on top
+		return `<` + name + ` type="html">` + xmlText(tc, htmlEscape(s)) + `</` + name + `>`
+	}
+	typ := pick(tc, []string{"", ` type="text"`, ` type="TEXT"`})
+	return "<" + name + typ + ">" + xmlText(tc, s) + "</" + name + ">"
+}
+
+func htmlEscape(s string) string {
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;").Replace(s)
+}
+
+func writeAtom(tc hegel.TestCase, f *mfeed) string {
+	var ch []string
+	if f.title != "" {
+		ch = append(ch, atomText(tc, "title", f.title, false))
+	}
+	ch = append(ch, "<id>"+xmlText(tc, "urn:feed:"+strconv.Itoa(n(tc, 1, 999)))+"</id>")
+	ch = append(ch, "<updated>"+f.upd.raw+"</updated>")
+	if f.desc != "" {
+		ch = append(ch, atomText(tc, "subtitle", f.desc, false))
+	}
+	if f.copyright != "" {
+		ch = append(ch, atomText(tc, "rights", f.copyright, false))
+	}
+	if f.generator != "" {
+		ch = append(ch, "<generator>"+xmlText(tc, f.generator)+"</generator>")
+	}
+	if f.imageURL != "" {
+		ch = append(ch, "<logo>"+xmlText(tc, f.imageURL)+"</logo>")
+	}
+	var links []string
+	if f.link != "" {
+		rel := pick(tc, []string{"", ` rel="alternate"`, ` type="text/html"`})
+		links = append(links, "<link"+rel+` href="`+attrEscape(f.link)+`"/>`)
+	}
+	if f.feedLink != "" {
+		links = append(links, `<link rel="self" href="`+attrEscape(f.feedLink)+`"/>`)
+	}
+	if !f.linkFirst && len(links) == 2 {
+		links[0], links[1] = links[1], links[0]
+	}
+	for _, p := range f.authors {
+		ch = append(ch, personAtom(tc, "author", p))
+	}
+	for i, c := range f.cats {
+		label := ""
+		if f.labels[i] != "" {
+			label = ` label="` + attrEscape(f.labels[i]) + `"`
+		}
+		ch = append(ch, `<category term="`+attrEscape(c)+`"`+label+pick(tc, []string{"/>", "></category>"}))
+	}
+	shuffleKeeping(tc, ch)
+	ch = append(links, ch...) // links keep their relative order
+	for _, it := range f.items {
+		var ic []string
+		if it.title != "" {
+			ic = append(ic, atomText(tc, "title", it.title, it.titleHTML))
+		}
+		ic = append(ic, "<id>"+xmlText(tc, it.guid)+"</id>")
+		if it.upd != nil {
+			ic = append(ic, "<updated>"+it.upd.raw+"</updated>")
+		}
+		if it.pub != nil {
+			ic = append(ic, "<published>"+it.pub.raw+"</published>")
+		}
+		if it.link != "" {
+			rel := pick(tc, []string{"", ` rel="alternate"`})
+			ic = append(ic, "<link"+rel+` href="`+attrEscape(it.link)+`"/>`)
+		}
+		if it.desc != "" {
+			ic = append(ic, atomText(tc, "summary", it.desc, false))
+		}
+		if it.content != "" {
+			ic = append(ic, atomText(tc, "content", it.content, false))
+		}
+		for _, p := range it.authors {
+			ic = append(ic, personAtom(tc, "author", p))
+		}
+		for i, c := range it.cats {
+			label := ""
+			if it.labels[i] != "" {
+				label = ` label="` + attrEscape(it.labels[i]) + `"`
+			}
+			ic = append(ic, `<category term="`+attrEscape(c)+`"`+label+"/>")
+		}
+		for _, e := range it.encs {
+			attrs := []string{`rel="enclosure"`, `href="` + attrEscape(e.url) + `"`, `type="` + e.typ + `"`}
+			if e.length != "" {
+				attrs = append(attrs, `length="`+e.length+`"`)
+			}
+			shuffle(tc, attrs)
+			ic = append(ic, "<link "+strings.Join(attrs, " ")+"/>")
+		}
+		shuffleKeeping(tc, ic)
+		ch = append(ch, "<entry>"+ws(tc)+strings.Join(ic, ws(tc))+ws(tc)+"</entry>")
+	}
+	lang := ""
+	if f.lang != "" {
+		lang = ` xml:lang="` + f.lang + `"`
+	}
+	decl := pick(tc, []string{"", `<?xml version="1.0" encoding="utf-8"?>`})
+	return decl + `<feed xmlns="http://www.w3.org/2005/Atom"` + lang + ">" + ws(tc) + strings.Join(ch, ws(tc)) + ws(tc) + "</feed>"
+}
+
+func jsonPerson(p mperson) map[string]any {
+	m := map[string]any{}
+	if p.name != "" {
+		m["name"] = p.name
+	}
+	if p.url != "" {
+		m["url"] = p.url
+	}
+	return m
+}
+
+func writeJSON(tc hegel.TestCase, f *mfeed) string {
+	m := map[string]any{"version": f.version}
+	if f.title != "" {
+		m["title"] = f.title
+	}
+	if f.link != "" {
+		m["home_page_url"] = f.link
+	}
+	if f.feedLink != "" {
+		m["feed_url"] = f.feedLink
+	}
+	if f.desc != "" {
+		m["description"] = f.desc
+	}
+	if f.lang != "" {
+		m["language"] = f.lang
+	}
+	if f.imageURL != "" {
+		m["icon"] = f.imageURL
+	}
+	if chance(tc, 30) {
+		m["favicon"] = genURL(tc)
+	}
+	if chance(tc, 30) {
+		m["user_comment"] = f.copyright
+	}
+	if f.author != nil {
+		m["author"] = jsonPerson(*f.author)
+	}
+	if f.authorsListed {
+		var as []any
+		for _, p := range f.authors {
+			as = append(as, jsonPerson(p))
+		}
+		m["authors"] = as
+	}
+	items := []any{}
+	for _, it := range f.items {
+		im := map[string]any{}
+		if it.guid != "" {
+			if it.idNumber {
+				v, _ := strconv.Atoi(it.guid)
+				im["id"] = v
+			} else {
+				im["id"] = it.guid
+			}
+		}
+		if it.link != "" {
+			im["url"] = it.link
+		}
+		if it.external != "" {
+			im["external_url"] = it.external
+		}
+		if it.title != "" {
+			im["title"] = it.title
+		}
+		if it.hasContentHTML {
+			im["content_html"] = it.content
+			if chance(tc, 30) {
+				im["content_text"] = genPlain(tc, 1)
+			}
+		} else {
+			im["content_text"] = it.content
+		}
+		if it.desc != "" {
+			im["summary"] = it.desc
+		}
+		if it.image != "" {
+			im["image"] = it.image
+		}
+		if it.pub != nil {
+			im["date_published"] = it.pub.raw
+		}
+		if it.upd != nil {
+			im["date_modified"] = it.upd.raw
+		}
+		if it.author != nil {
+			im["author"] = jsonPerson(*it.author)
+		}
+		if it.authorsListed {
+			var as []any
+			for _, p := range it.authors {
+				as = append(as, jsonPerson(p))
+			}
+			im["authors"] = as
+		}
+		if len(it.cats) > 0 {
+			im["tags"] = it.cats
+		}
+		if len(it.encs) > 0 {
+			var as []any
+			for _, e := range it.encs {
+				a := map[string]any{"url": e.url, "mime_type": e.typ}
+				if e.length != "" {
+					v, _ := strconv.Atoi(e.length)
+					a["size_in_bytes"] = v
+				}
+				as = append(as, a)
+			}
+			im["attachments"] = as
+		}
+		items = append(items, im)
+	}
+	m["items"] = items
+	var b []byte
+	if chance(tc, 50) {
+		b, _ = json.MarshalIndent(m, "", "  ")
+	} else {
+		b, _ = json.Marshal(m)
+	}
+	return pick(tc, []string{"", "\n", " "}) + string(b) + pick(tc, []string{"", "\n"})
+}
+
+func writeFeed(tc hegel.TestCase, f *mfeed) string {
+	switch f.kind {
+	case "rss":
+		return writeRSS(tc, f)
+	case "atom":
+		return writeAtom(tc, f)
+	}
+	return writeJSON(tc, f)
+}
+
+// --------------------------------------------------------------------------- the universal view
+
+type uPerson struct{ Name, Email, URL string }
+
+type uEnc struct{ URL, Type, Length string }
+
+type uItem struct {
+	Title, Description, Content, Link string
+	Links                             []string
+	Updated, Published                string
+	UpdatedParsed, PublishedParsed    string
+	Author                            *uPerson
+	Authors                           []uPerson
+	GUID, Image                       string
+	Categories                        []string
+	Enclosures                        []uEnc
+	Custom                            map[string]string
+}
+
+type uFeed struct {
+	Type, Version, Title, Description, Link, FeedLink    string
+	Links                                                []string
+	Updated, Published, UpdatedParsed, PublishedParsed   string
+	Author                                               *uPerson
+	Authors                                              []uPerson
+	Language, ImageURL, ImageTitle, Copyright, Generator string
+	Categories                                           []string
+	Items                                                []uItem
+}
+
+func stamp(t *time.Time) string {
+	if t == nil {
+		return ""
+	}
+	return t.UTC().Format(time.RFC3339Nano)
+}
+
+func stampM(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.t.UTC().Format(time.RFC3339Nano)
+}
+
+func rawM(d *mdate) string {
+	if d == nil {
+		return ""
+	}
+	return d.raw
+}
+
+func uPersonOf(p *gofeed.Person) *uPerson {
+	if p == nil {
+		return nil
+	}
+	return &uPerson{p.Name, p.Email, p.URL}
+}
+
+func uPersonsOf(ps []*gofeed.Person) []uPerson {
+	var out []uPerson
+	for _, p := range ps {
+		if p == nil {
+			out = append(out, uPerson{Name: "<nil>"})
+			continue
+		}
+		out = append(out, *uPersonOf(p))
+	}
+	return out
+}
+
+func uOf(f *gofeed.Feed) uFeed {
+	u := uFeed{Type: f.FeedType, Version: f.FeedVersion, Title: f.Title, Description: f.Description, Link: f.Link, FeedLink: f.FeedLink,
+		Links: nilIfEmpty(f.Links), Updated: f.Updated, Published: f.Published, UpdatedParsed: stamp(f.UpdatedParsed), PublishedParsed: stamp(f.PublishedParsed),
+		Author: uPersonOf(f.Author), Authors: uPersonsOf(f.Authors), Language: f.Language, Copyright: f.Copyright, Generator: f.Generator, Categories: nilIfEmpty(f.Categories)}
+	if f.Image != nil {
+		u.ImageURL, u.ImageTitle = f.Image.URL, f.Image.Title
+	}
+	for _, it := range f.Items {
+		ui := uItem{Title: it.Title, Description: it.Description, Content: it.Content, Link: it.Link, Links: nilIfEmpty(it.Links),
+			Updated: it.Updated, Published: it.Published, UpdatedParsed: stamp(it.UpdatedParsed), PublishedParsed: stamp(it.PublishedParsed),
+			Author: uPersonOf(it.Author), Authors: uPersonsOf(it.Authors), GUID: it.GUID, Categories: nilIfEmpty(it.Categories)}
+		if it.Image != nil {
+			ui.Image = it.Image.URL
+		}
+		for _, e := range it.Enclosures {
+			ui.Enclosures = append(ui.Enclosures, uEnc{e.URL, e.Type, e.Length})
+		}
+		if len(it.Custom) > 0 {
+			ui.Custom = it.Custom
+		}
+		u.Items = append(u.Items, ui)
+	}
+	return u
+}
+
+func nilIfEmpty(xs []string) []string {
+	if len(xs) == 0 {
+		return nil
+	}
+	return xs
+}
+
+func uPersonM(p *mperson) *uPerson {
+	if p == nil {
+		return nil
+	}
+	return &uPerson{p.name, p.email, p.url}
+}
+
+func uPersonsM(ps []mperson) []uPerson {
+	var out []uPerson
+	for _, p := range ps {
+		out = append(out, uPerson{p.name, p.email, p.url})
+	}
+	return out
+}
+
+// expect: the universal feed the documented mapping gives for the model.
+func expect(f *mfeed) uFeed {
+	u := uFeed{Type: f.kind, Title: f.title, Description: f.desc, Link: f.link, FeedLink: f.feedLink, Language: f.lang, Copyright: f.copyright, Generator: f.generator, Categories: nilIfEmpty(f.cats)}
+	switch f.kind {
+	case "rss":
+		u.Version = "2.0"
+		if f.link != "" {
+			u.Links = append(u.Links, f.link)
+		}
+		if f.feedLink != "" {
+			u.Links = append(u.Links, f.feedLink)
+		}
+		u.Published, u.PublishedParsed = rawM(f.pub), stampM(f.pub)
+		u.Updated, u.UpdatedParsed = rawM(f.upd), stampM(f.upd)
+		if f.author != nil {
+			u.Author = uPersonM(f.author)
+			u.Authors = []uPerson{*u.Author}
+		}
+		u.ImageURL, u.ImageTitle = f.imageURL, f.imageTitle
+	case "atom":
+		u.Version = "1.0"
+		if f.linkFirst || f.link == "" || f.feedLink == "" {
+			u.Links = append(nilIfEmpty([]string{}), nonEmpty(f.link, f.feedLink)...)
+		} else {
+			u.Links = []string{f.feedLink, f.link}
+		}
+		u.Updated, u.UpdatedParsed = rawM(f.upd), stampM(f.upd)
+		if len(f.authors) > 0 {
+			u.Authors = uPersonsM(f.authors)
+			a := u.Authors[0]
+			u.Author = &a
+		}
+		u.ImageURL = f.imageURL
+		u.Categories = nil
+		for i, c := range f.cats {
+			if f.labels[i] != "" {
+				u.Categories = append(u.Categories, f.labels[i])
+			} else {
+				u.Categories = append(u.Categories, c)
+			}
+		}
+	case "json":
+		u.Version = f.version
+		u.Links = nonEmpty(f.link, f.feedLink)
+		u.ImageURL = f.imageURL
+		u.Categories = nil
+		u.Copyright, u.Generator = "", "" // no JSON Feed fields map to them
+		u.Author = uPersonM(f.author)
+		if f.authorsListed {
+			u.Authors = uPersonsM(f.authors)
+		} else if u.Author != nil {
+			u.Authors = []uPerson{*u.Author}
+		}
+		if len(f.items) > 0 {
+			u.Updated, u.UpdatedParsed = rawM(f.items[0].upd), stampM(f.items[0].upd)
+			u.Published, u.PublishedParsed = rawM(f.items[0].pub), stampM(f.items[0].pub)
+		}
+	}
+	for _, it := range f.items {
+		ui := uItem{Title: it.title, Description: it.desc, Content: it.content, Link: it.link, GUID: it.guid, Categories: nilIfEmpty(it.cats)}
+		if it.link != "" {
+			ui.Links = []string{it.link}
+		}
+		for _, e := range it.encs {
+			ui.Enclosures = append(ui.Enclosures, uEnc{e.url, e.typ, e.length})
+		}
+		switch f.kind {
+		case "rss":
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			if it.pub == nil && it.upd != nil {
+				ui.Published, ui.PublishedParsed = rawM(it.upd), stampM(it.upd)
+			}
+			if it.author != nil {
+				ui.Author = uPersonM(it.author)
+				ui.Authors = []uPerson{*ui.Author}
+			}
+			for _, e := range it.encs {
+				if strings.HasPrefix(e.typ, "image/") {
+					ui.Image = e.url
+					break
+				}
+			}
+			if len(it.custom) > 0 {
+				ui.Custom = it.custom
+			}
+		case "atom":
+			if it.titleHTML {
+				ui.Title = htmlEscape(it.title)
+			}
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			if it.pub == nil {
+				ui.Published, ui.PublishedParsed = ui.Updated, ui.UpdatedParsed
+			}
+			if len(it.authors) > 0 {
+				ui.Authors = uPersonsM(it.authors)
+				a := ui.Authors[0]
+				ui.Author = &a
+			}
+			ui.Categories = nil
+			for i, c := range it.cats {
+				if it.labels[i] != "" {
+					ui.Categories = append(ui.Categories, it.labels[i])
+				} else {
+					ui.Categories = append(ui.Categories, c)
+				}
+			}
+		case "json":
+			ui.Links = nonEmpty(it.link, it.external)
+			ui.Image = it.image
+			ui.Published, ui.PublishedParsed = rawM(it.pub), stampM(it.pub)
+			ui.Updated, ui.UpdatedParsed = rawM(it.upd), stampM(it.upd)
+			ui.Author = uPersonM(it.author)
+			if it.authorsListed {
+				ui.Authors = uPersonsM(it.authors)
+			} else if ui.Author != nil {
+				ui.Authors = []uPerson{*ui.Author}
+			} else if !Known.jsonAuthorNotInherited {
+				ui.Author, ui.Authors = u.Author, u.Authors
+			}
+			for i := range ui.Enclosures {
+				if ui.Enclosures[i].Length == "" {
+					continue
+				}
+			}
+		}
+		u.Items = append(u.Items, ui)
+	}
+	return u
+}
+
+func nonEmpty(xs ...string) []string {
+	var out []string
+	for _, x := range xs {
+		if x != "" {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// diffU: "" when equal, else a description of the first differing field.
+func diffU(want, got uFeed) string {
+	if reflect.DeepEqual(want, got) {
+		return ""
+	}
+	w, _ := json.MarshalIndent(want, "", " ")
+	g, _ := json.MarshalIndent(got, "", " ")
+	wl, gl := strings.Split(string(w), "\n"), strings.Split(string(g), "\n")
+	for i := 0; i < len(wl) || i < len(gl); i++ {
+		var a, b string
+		if i < len(wl) {
+			a = wl[i]
+		}
+		if i < len(gl) {
+			b = gl[i]
+		}
+		if a != b {
+			return fmt.Sprintf("line %d: got %s, want %s", i+1, strings.TrimSpace(b), strings.TrimSpace(a))
+		}
+	}
+	return "differs (same JSON?)"
+}
