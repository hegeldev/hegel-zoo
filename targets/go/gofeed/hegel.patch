+var lowerCases = hegel.Composite(func(tc hegel.TestCase) lowerCase {
+	return lowerCase{
+		spec: rfcSpec{off: hegel.Draw(tc, hegel.SampledFrom(offsets)), c: hegel.Draw(tc, clocks), millis: hegel.Draw(tc, maybe(25, hegel.Integers(1, 999)))},
+		mask: hegel.Draw(tc, shaped(hegel.Integers(1, 3), hegel.Just(0))),
+	}
+})
