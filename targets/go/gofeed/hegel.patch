+// --------------------------------------------------------------------------- gofeed/2
+
+// keywordCase: the itunes:keywords of the channel and of an item: the words, and for each gap
+// between words (recycled modulo the gaps) and the end the separator (keywordSeps).
+type keywordCase struct {
+	feed, item []string
+	gaps       []int
+	trailing   bool
+}
+
+// render joins the words: with a bare comma when the gaps are empty (HEGEL_NO_KNOWN=1), else
+// with the separators of the gaps and a trailing blank when trailing.
+func (k keywordCase) render(words []string) string {
+	var b strings.Builder
+	for i, w := range words {
+		if i > 0 {
+			sep := ","
+			if len(k.gaps) > 0 {
+				sep = keywordSeps[k.gaps[(i-1)%len(k.gaps)]][0]
+			}
+			b.WriteString(sep)
+		}
+		b.WriteString(w)
+	}
+	if k.trailing {
+		b.WriteString(" ")
+	}
+	return b.String()
+}
+
+func (k keywordCase) doc() string {
+	return rssOf("<itunes:keywords>" + k.render(k.feed) + "</itunes:keywords><item><title>i</title><itunes:keywords>" + k.render(k.item) + "</itunes:keywords></item>")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (k keywordCase) GoString() string {
+	return fmt.Sprintf("channel %q item %q", k.render(k.feed), k.render(k.item))
+}
+
+var (
+	keywordWords = hegel.Map(many(hegel.SampledFrom([]string{"news", "go", "tech", "podcast", "a b", "1", "x"}), 1, 4), distinct[string])
+	keywordCases = hegel.Composite(func(tc hegel.TestCase) keywordCase {
+		return keywordCase{
+			feed:     hegel.Draw(tc, keywordWords),
+			item:     hegel.Draw(tc, keywordWords),
+			gaps:     hegel.Draw(tc, shaped(many(hegel.Integers(1, len(keywordSeps)-2), 1, 3), hegel.Just([]int(nil)))),
+			trailing: hegel.Draw(tc, shaped(chance(50), hegel.Just(false))),
+		}
+	})
+)
