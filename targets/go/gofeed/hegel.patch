+// --------------------------------------------------------------------------- gofeed/9
+
+// rdfItem: an RSS 1.0 item: its rdf:about (a URL or a tag URI), title and link.
+type rdfItem struct{ about, title, link string }
+
+// rdfCase: an RSS 1.0 (RDF) document: the channel's title and link, one to three items, and
+// the tape of its writing. Under HEGEL_NO_KNOWN=1 each item also carries a <guid> equal to its
+// rdf:about (the neighbouring region: an identifier the library does read).
+type rdfCase struct {
+	title, link string
+	items       []rdfItem
+	tape        []int
+}
+
+// doc writes the document; named tells whether an HTML named entity was written (feedparser
+// then reports bozo and decodes it all the same).
+func (r rdfCase) doc() doc {
+	w := &writer{tp: &tape{vals: r.tape}}
+	w.d.text = r.write(w)
+	return w.d
+}
+
+func (r rdfCase) write(w *writer) string {
+	var parts []string
+	for _, it := range r.items {
+		var ic []string
+		if it.title != "" {
+			ic = append(ic, "<title>"+w.text(it.title, false)+"</title>")
+		}
+		ic = append(ic, "<link>"+w.text(it.link, false)+"</link>")
+		if Known.rdfAbout {
+			ic = append(ic, "<guid>"+w.text(it.about, false)+"</guid>")
+		}
+		w.shuffle(ic)
+		parts = append(parts, `<item rdf:about="`+attrEscape(it.about)+`">`+w.ws()+strings.Join(ic, w.ws())+w.ws()+"</item>")
+	}
+	channel := `<channel rdf:about="` + attrEscape(r.link) + `"><title>` + w.text(r.title, false) + `</title><link>` + w.text(r.link, false) + `</link><description>d</description></channel>`
+	return w.tp.pick([]string{"", `<?xml version="1.0"?>`}) + `<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns="http://purl.org/rss/1.0/">` + w.ws() + channel + w.ws() + strings.Join(parts, w.ws()) + w.ws() + "</rdf:RDF>"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (r rdfCase) GoString() string { return r.doc().text }
+
+var (
+	abouts   = weighted(choice[string]{3, urlsOf("")}, choice[string]{1, cat(lit("tag:x,2024:"), dec(hegel.Integers(0, 99)))})
+	rdfItems = hegel.Composite(func(tc hegel.TestCase) rdfItem {
+		return rdfItem{about: hegel.Draw(tc, abouts), title: hegel.Draw(tc, maybe(80, plainText1)), link: hegel.Draw(tc, urlsOf(""))}
+	})
+	rdfCases = hegel.Composite(func(tc hegel.TestCase) rdfCase {
+		return rdfCase{title: hegel.Draw(tc, plainText1), link: hegel.Draw(tc, urlsOf("")), items: hegel.Draw(tc, many(rdfItems, 1, 3)), tape: hegel.Draw(tc, tapes)}
+	})
+)
