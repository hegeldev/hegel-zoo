+			desc:        hegel.Draw(tc, maybe(80, plainText0)),
+			link:        hegel.Draw(tc, maybe(90, urls)),
+			feedLink:    hegel.Draw(tc, maybe(50, urls)),
+			lang:        hegel.Draw(tc, maybe(50, hegel.SampledFrom([]string{"en", "en-US", "fr", "de-CH"}))),
+			copyright:   hegel.Draw(tc, maybe(40, plainText1)),
+			generator:   hegel.Draw(tc, maybe(40, plainText1)),
+			imageURL:    image.a,
+			imageTitle:  image.b,
+			cats:        hegel.Draw(tc, cats),
+			keywords:    hegel.Draw(tc, keywords),
+			kwSep:       hegel.Draw(tc, kwSeps),
+			pub:         hegel.Draw(tc, pubs),
+			upd:         hegel.Draw(tc, upds),
+			author:      hegel.Draw(tc, authors),
+			authors:     hegel.Draw(tc, authorLists),
+			linkFirst:   hegel.Draw(tc, linkFirsts),
