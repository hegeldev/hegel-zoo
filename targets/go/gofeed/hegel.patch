+// lowerCase: an Atom feed's updated and an entry's published in RFC 3339 with the T or the Z
+// (or both; mask) in lower case (gofeed/6); under HEGEL_NO_KNOWN=1 upper case (mask 0).
+type lowerCase struct {
+	spec rfcSpec
+	mask int
+}
+
+func (l lowerCase) text() string {
+	raw := l.spec.date().raw
+	if l.mask&1 != 0 {
+		raw = strings.Replace(raw, "T", "t", 1)
+	}
+	if l.mask&2 != 0 {
+		raw = strings.Replace(raw, "Z", "z", 1)
+	}
+	return raw
+}
+
+func (l lowerCase) doc() string {
+	return `<feed xmlns="http://www.w3.org/2005/Atom"><id>f</id><title>t</title><updated>` + l.text() + `</updated><entry><id>e</id><published>` + l.text() + `</published></entry></feed>`
+}
