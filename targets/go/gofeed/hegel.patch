+	items := many(itemsOf(kind, urls), 0, 3)
+	images := maybe(50, pairs(urls, plainText1))
+	pubs, upds := hegel.Just[*mdate](nil), hegel.Just[*mdate](nil)
+	authors := hegel.Just[*mperson](nil)
