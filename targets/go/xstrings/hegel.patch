diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..19bcade
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,88 @@
+package xstrings_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the behaviour
+// the documentation promises and fails while the bug is open; target.toml
+// lists them as expected failures.
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/huandu/xstrings"
+)
+
+// xstrings/1
+func TestHegelPinScrubKeepsTheReplacementCharacter(t *testing.T) {
+	// U+FFFD is a valid rune; Scrub is documented to replace invalid bytes.
+	if got := xstrings.Scrub("a�b", "?"); got != "a�b" {
+		t.Errorf("Scrub(%q, %q) = %q, want the string unchanged", "a�b", "?", got)
+	}
+	once := xstrings.Scrub("a\xffb", "�")
+	if got := xstrings.Scrub(once, ""); got != once {
+		t.Errorf("Scrub(Scrub(%q, U+FFFD), \"\") = %q, want %q (a second pass must not remove the markers)", "a\xffb", got, once)
+	}
+}
+
+// xstrings/2
+func TestHegelPinIdeographsAreNotWordCharacters(t *testing.T) {
+	// The same ideographs the package excludes, in the ranges Unicode has
+	// added since: none of them is alphabetic.
+	for _, s := range []string{"鿿", "䶶", "\U0002b820", "\U00030000", "豈"} {
+		if got := xstrings.WordCount(s); got != 0 {
+			t.Errorf("WordCount(%q) = %d, want 0 as for %q (%d)", s, got, "中", xstrings.WordCount("中"))
+		}
+	}
+	if got := xstrings.WordSplit("hello 鿿 world"); !reflect.DeepEqual(got, []string{"hello", "world"}) {
+		t.Errorf("WordSplit(%q) = %q, want [hello world]", "hello 鿿 world", got)
+	}
+}
+
+// xstrings/3
+func TestHegelPinCamelCaseCapitalisesAOneLetterWord(t *testing.T) {
+	for in, want := range map[string]string{"point_X": "pointX", "some_W": "someW", "hk2_L": "hk2L", "a b C": "aBC"} {
+		if got := xstrings.ToCamelCase(in); got != want {
+			t.Errorf("ToCamelCase(%q) = %q, want %q (ToPascalCase gives %q)", in, got, want, xstrings.ToPascalCase(in))
+		}
+	}
+}
+
+// xstrings/4
+func TestHegelPinConnectorsNextToPunctuationAreConverted(t *testing.T) {
+	for in, want := range map[string]string{"a.-b": "a._b", "x,-y": "x,_y", "a.b-c": "a.b_c"} {
+		if got := xstrings.ToSnakeCase(in); got != want {
+			t.Errorf("ToSnakeCase(%q) = %q, want %q", in, got, want)
+		}
+	}
+	for in, want := range map[string]string{"a._b": "a.-b", "a__b": "a--b", "a.b_c": "a.b-c"} {
+		if got := xstrings.ToKebabCase(in); got != want {
+			t.Errorf("ToKebabCase(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+// xstrings/5
+func TestHegelPinRangeMapsOntoSingleRunes(t *testing.T) {
+	// "Translate will try to find a 1:1 mapping from from to to."
+	for _, c := range [][4]string{{"abc", "a-c", "xyz", "xyz"}, {"FED", "F-D", "123", "123"}, {"CDEF", "C-F", "1234", "1234"}, {"hello", "a-z", "0123456789abcdefghijklmnop", "74bbe"}} {
+		if got := xstrings.Translate(c[0], c[1], c[2]); got != c[3] {
+			t.Errorf("Translate(%q, %q, %q) = %q, want %q", c[0], c[1], c[2], got, c[3])
+		}
+	}
+	if got, ok := xstrings.NewTranslator("a-c", "xyz").TranslateRune('c'); got != 'z' || !ok {
+		t.Errorf("NewTranslator(a-c, xyz).TranslateRune('c') = %q %v, want 'z' true", got, ok)
+	}
+}
+
+// xstrings/6
+func TestHegelPinReplacementCharacterInAPattern(t *testing.T) {
+	// U+FFFD is a rune like any other in a pattern.
+	if got := xstrings.Translate("�1", "�1", "AB"); got != "AB" {
+		t.Errorf("Translate(%q, %q, %q) = %q, want %q", "�1", "�1", "AB", got, "AB")
+	}
+	if got := xstrings.Translate("ab", "ab", "�X"); got != "�X" {
+		t.Errorf("Translate(%q, %q, %q) = %q, want %q", "ab", "ab", "�X", got, "�X")
+	}
+	if got := xstrings.Count("��1", "�1"); got != 3 {
+		t.Errorf("Count(%q, %q) = %d, want 3", "��1", "�1", got)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..f065bd0
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,287 @@
+package xstrings_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged by the oracle of the wide
+// property that found it (hegel_test.go), so that each bug has a property
+// that finds it every run (the wide properties reach the shapes at their
+// natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region
+// the bug does not touch instead (U+FFFC for U+FFFD, an ideograph the
+// package's ranges cover, a two-letter last word, a connector before the
+// punctuation, a to pattern one rune shorter, a pattern of U+FFFD alone)
+// and passes.
+
+import (
+	"fmt"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/huandu/xstrings"
+	"hegel.dev/go/hegel"
+)
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// splice puts piece into s before rune number at (modulo the rune count plus
+// one); an invalid byte counts as a rune and stays the byte it is.
+func splice(s, piece string, at int) string {
+	var bounds []int
+	for i := 0; i < len(s); {
+		bounds = append(bounds, i)
+		_, size := utf8.DecodeRuneInString(s[i:])
+		i += size
+	}
+	bounds = append(bounds, len(s))
+	i := bounds[at%len(bounds)]
+	return s[:i] + piece + s[i:]
+}
+
+// filterRunes keeps the runes of the buckets that pass keep.
+func filterRunes(keep func(rune) bool, buckets ...[]rune) []rune {
+	var out []rune
+	for _, b := range buckets {
+		for _, r := range b {
+			if keep(r) {
+				out = append(out, r)
+			}
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- xstrings/1
+
+// scrubCase: a string of a drawn alphabet (invalid bytes mixed in 30% of the
+// time) with a marker spliced in - U+FFFD, or under HEGEL_NO_KNOWN=1 its
+// neighbour U+FFFC - and the replacement.
+type scrubCase struct {
+	s, repl string
+}
+
+func (c scrubCase) GoString() string { return fmt.Sprintf("s %q scrub with %q", c.s, c.repl) }
+
+var scrubCases = hegel.Composite(func(tc hegel.TestCase) scrubCase {
+	buckets := hegel.Draw(tc, alphabets).buckets(modelRunes)
+	texts := weighted(choice[string]{70, textsOf(buckets, 24)}, choice[string]{30, mixedTextsOf(buckets)})
+	return scrubCase{
+		s:    splice(hegel.Draw(tc, texts), shaped("\ufffd", "\ufffc"), hegel.Draw(tc, positions)),
+		repl: hegel.Draw(tc, repls),
+	}
+})
+
+// TestHegelScrubKeepsTheReplacementCharacter: U+FFFD is a valid rune, so
+// Scrub leaves it in place as the model does; xstrings replaces it as if it
+// were an invalid byte (xstrings/1).
+func TestHegelScrubKeepsTheReplacementCharacter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, scrubCases)
+		checkScrub(ht, c.s, c.repl, known("xstrings/1"))
+	})
+}
+
+// --------------------------------------------------------------------------- xstrings/2
+
+// staleHan: the ideographs of the cjk bucket the package's ranges miss;
+// under HEGEL_NO_KNOWN=1 the ones they cover.
+var staleHan = shaped(
+	filterRunes(misclassifiedHan, cjk),
+	filterRunes(func(r rune) bool { return unicode.Is(unicode.Han, r) && implCJK(r) }, cjk),
+)
+
+// ideographTexts: a string of a drawn alphabet with one of them spliced in.
+var ideographTexts = hegel.Composite(func(tc hegel.TestCase) string {
+	texts := textsOf(hegel.Draw(tc, alphabets).buckets(modelRunes), 24)
+	return splice(hegel.Draw(tc, texts), string(hegel.Draw(tc, hegel.SampledFrom(staleHan))), hegel.Draw(tc, positions))
+})
+
+// TestHegelIdeographsAreNotWordCharacters: a Han ideograph is not
+// alphabetic, so WordSplit does not make a word of it, as the model says;
+// xstrings' exclusion ranges stop at Unicode 6.1 (xstrings/2).
+func TestHegelIdeographsAreNotWordCharacters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkWords(ht, hegel.Draw(ht, ideographTexts), known("xstrings/2"))
+	})
+}
+
+// --------------------------------------------------------------------------- xstrings/3
+
+var (
+	letters    = runesOf([][]rune{lowerASCII, upperASCII})
+	upperRunes = filterRunes(unicode.IsUpper, upperASCII, latin, greekCyr)
+	connectors = hegel.SampledFrom([]rune("-_ "))
+	// wordTexts: a word-like string beginning with a letter.
+	wordTexts = hegel.Map(pairs(letters, textsOf(wordishBuckets(false), 8)), func(p pair[rune, string]) string { return string(p.a) + p.b })
+	// lastCapitalTexts: a word, a connector and one upper-case letter; under
+	// HEGEL_NO_KNOWN=1 a lower-case letter follows it (a two-letter last word).
+	lastCapitalTexts = hegel.Composite(func(tc hegel.TestCase) string {
+		tails := shaped[hegel.Generator[string]](hegel.Just(""), hegel.Map(hegel.SampledFrom(lowerASCII), func(r rune) string { return string(r) }))
+		return hegel.Draw(tc, wordTexts) + string(hegel.Draw(tc, connectors)) + string(hegel.Draw(tc, hegel.SampledFrom(upperRunes))) + hegel.Draw(tc, tails)
+	})
+)
+
+// TestHegelCamelCaseCapitalisesAOneLetterWord: ToCamelCase and ToPascalCase
+// differ only in the case of the first word's first rune, so a one-letter
+// last word keeps its capital in both; ToCamelCase lowers it (xstrings/3).
+func TestHegelCamelCaseCapitalisesAOneLetterWord(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, lastCapitalTexts)
+		camel, pascal := xstrings.ToCamelCase(s), xstrings.ToPascalCase(s)
+		note(ht, "camel = %q pascal = %q", camel, pascal)
+		checkCamelPascal(ht, s, camel, pascal, known("xstrings/3"))
+	})
+}
+
+// --------------------------------------------------------------------------- xstrings/4
+
+var (
+	// punctMarks: the ASCII punctuation the library reads as punctuation
+	// (unicode.IsPunct; the symbols among punctASCII are not).
+	punctMarks = filterRunes(unicode.IsPunct, punctASCII)
+	// punctRuns: a punctuation rune and then a connector, which the library
+	// reads as one punctuation run (xstrings/4); under HEGEL_NO_KNOWN=1 the
+	// connector first, two runs.
+	punctRuns = hegel.Map(pairs(hegel.SampledFrom(punctMarks), hegel.SampledFrom([]rune("-_"))), func(p pair[rune, rune]) string {
+		return shaped(string(p.a)+string(p.b), string(p.b)+string(p.a))
+	})
+	// connectorPunctTexts: a word-like string, the run, and 70% of the time a
+	// word-like tail beginning with a letter.
+	connectorPunctTexts = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, textsOf(wordishBuckets(false), 8)) + hegel.Draw(tc, punctRuns) + hegel.Draw(tc, maybe(70, wordTexts))
+	})
+)
+
+// TestHegelConnectorsNextToPunctuationAreConverted: a hyphen or underscore
+// is converted to the connector wherever it stands, so ToKebabCase is
+// ToSnakeCase with the other connector and the snake form has no hyphen;
+// xstrings copies a connector inside a punctuation run verbatim (xstrings/4).
+func TestHegelConnectorsNextToPunctuationAreConverted(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, connectorPunctTexts)
+		snake, kebab := xstrings.ToSnakeCase(s), xstrings.ToKebabCase(s)
+		note(ht, "snake = %q kebab = %q", snake, kebab)
+		checkSnakeKebab(ht, s, snake, kebab, known("xstrings/4"))
+	})
+}
+
+// --------------------------------------------------------------------------- xstrings/5
+
+// rangeCase: a from pattern of up to two single runes and then an ascending
+// range of two to five lower-case letters; a to pattern of single runes, as
+// many as the from pattern's positions and up to two more, so that the
+// range's penultimate rune meets a single that is not the to pattern's last
+// (xstrings/5) - or under HEGEL_NO_KNOWN=1 one fewer, so that the range's
+// last rune is padded with the to pattern's last; and a string that hits the
+// pattern and holds the range's last rune.
+type rangeCase struct {
+	lead []rune
+	lo   rune
+	size int
+	tos  []rune
+	s    string
+}
+
+func (c rangeCase) hi() rune { return c.lo + rune(c.size) - 1 }
+
+func (c rangeCase) from() string {
+	return patSpec{pieces: append(singlePieces(c.lead), patPiece{lo: c.lo, hi: c.hi(), ranged: true})}.String()
+}
+
+func (c rangeCase) to() string { return patSpec{pieces: singlePieces(c.tos)}.String() }
+
+func (c rangeCase) GoString() string {
+	return fmt.Sprintf("s %q from %q to %q", c.s, c.from(), c.to())
+}
+
+func singlePieces(rs []rune) []patPiece {
+	ps := make([]patPiece, len(rs))
+	for i, r := range rs {
+		ps[i] = patPiece{lo: r, hi: r}
+	}
+	return ps
+}
+
+var (
+	alnums = runesOf([][]rune{lowerASCII, upperASCII, digits})
+	// hittingTextsAround: a string that hits the pattern, with r in it.
+	hittingTextsAround = func(items []patItem, r rune) hegel.Generator[string] {
+		texts := hittingTextsOf(narrowBuckets, items)
+		return hegel.Map(pairs(texts, texts), func(p pair[string, string]) string { return p.a + string(r) + p.b })
+	}
+	rangeCases = hegel.Composite(func(tc hegel.TestCase) rangeCase {
+		c := rangeCase{
+			lead: hegel.Draw(tc, many(alnums, 0, 2)),
+			lo:   hegel.Draw(tc, hegel.SampledFrom(lowerASCII[:22])),
+			size: hegel.Draw(tc, hegel.Integers(2, 5)),
+		}
+		n := len(c.lead) + c.size + shaped(hegel.Draw(tc, hegel.Integers(0, 2)), -1)
+		c.tos = hegel.Draw(tc, many(alnums, n, n))
+		items, _ := parsePattern(c.from(), true)
+		c.s = hegel.Draw(tc, hittingTextsAround(items, c.hi()))
+		return c
+	})
+)
+
+// TestHegelRangeMapsOntoSingleRunes: "Translate will try to find a 1:1
+// mapping from from to to", so every rune of a from range maps to the to
+// rune at its position, as the model and Ruby's tr say; xstrings leaves the
+// range's last rune unmapped when it is stepped onto single runes
+// (xstrings/5).
+func TestHegelRangeMapsOntoSingleRunes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rangeCases)
+		checkTranslation(ht, c.s, c.from(), c.to(), true, known("xstrings/5"))
+	})
+}
+
+// --------------------------------------------------------------------------- xstrings/6
+
+// fffdPatternCase: a from pattern of one to three runes and U+FFFD among
+// them, first, last or between (xstrings/6) - or under HEGEL_NO_KNOWN=1 of
+// U+FFFD alone; a to pattern of as many single runes, or empty a quarter of
+// the time; and a string that hits the pattern and holds U+FFFD.
+type fffdPatternCase struct {
+	others []rune
+	at     int // the position of U+FFFD among the pieces, modulo their count
+	tos    []rune
+	s      string
+}
+
+func (c fffdPatternCase) pieces() []rune {
+	i := c.at % (len(c.others) + 1)
+	return append(append(append([]rune(nil), c.others[:i]...), '\ufffd'), c.others[i:]...)
+}
+
+func (c fffdPatternCase) from() string { return patSpec{pieces: singlePieces(c.pieces())}.String() }
+
+func (c fffdPatternCase) to() string { return patSpec{pieces: singlePieces(c.tos)}.String() }
+
+func (c fffdPatternCase) GoString() string {
+	return fmt.Sprintf("s %q from %q to %q", c.s, c.from(), c.to())
+}
+
+var fffdPatternCases = hegel.Composite(func(tc hegel.TestCase) fffdPatternCase {
+	c := fffdPatternCase{
+		others: hegel.Draw(tc, shaped[hegel.Generator[[]rune]](many(runesOf(narrowBuckets), 1, 3), hegel.Just([]rune(nil)))),
+		at:     hegel.Draw(tc, positions),
+	}
+	n := len(c.others) + 1
+	c.tos = hegel.Draw(tc, maybe(75, many(alnums, n, n)))
+	items, _ := parsePattern(c.from(), true)
+	c.s = hegel.Draw(tc, hittingTextsAround(items, '\ufffd'))
+	return c
+})
+
+// TestHegelReplacementCharacterInAPattern: U+FFFD is a rune like any other
+// in a pattern, so Translate, Delete and Count treat it as the model (and
+// Ruby) do; xstrings drops it from any pattern of two or more runes,
+// shifting the mapping (xstrings/6).
+func TestHegelReplacementCharacterInAPattern(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, fffdPatternCases)
+		from, to := c.from(), c.to()
+		checkTranslation(ht, c.s, from, to, true, known("xstrings/6"))
+		checkDeleteCount(ht, c.s, from, true, known("xstrings/6"))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..849157c
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1821 @@
+package xstrings_test
+
+// Hegel property tests for github.com/huandu/xstrings.
+//
+// Oracles: Ruby's String methods, which the package ports (length, reverse,
+// center/ljust/rjust with cycling pads, count/delete/squeeze/tr patterns,
+// succ, swapcase, partition/rpartition, insert), run in a Ruby process the
+// tests start; an independent model of the documented pattern language
+// (ranges either way, a leading '^', backslash escapes) for the shapes Ruby
+// rejects; models written from the documentation for ExpandTabs, Slice,
+// Insert, Scrub, WordCount/WordSplit and Width; and laws the case conversions
+// and Shuffle are documented to satisfy.
+//
+// Every property draws one case record: an alphabet spec (which rune buckets
+// the case draws from), the strings drawn from it, and the rest of the data
+// the checks need (a separator, positions taken modulo the live length, a
+// pattern as a list of pieces, a tape of doublings) rendered by pure
+// functions. The shapes of the recorded bugs (bugs.toml) are drawn at their
+// natural rate, so the properties that meet them fail, naming the shape, and
+// are the expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_shapes_test.go has one property per bug over its shape region alone,
+// and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches
+// the known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Set XSTRINGS_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math/rand"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/huandu/xstrings"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("XSTRINGS_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// note records a derived value (the draw report prints the drawn case).
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the gates of Known are on: the shapes are left out of the generators
+// (shaped, the filters) and a mismatch that still has a known shape is
+// skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means the
+// shape is left out, which is so only under HEGEL_NO_KNOWN=1. The pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail while a bug is
+// open.
+var Known = struct {
+	scrubReplacesFFFD       bool // xstrings/1: Scrub treats the valid rune U+FFFD as an invalid byte
+	staleCJKRanges          bool // xstrings/2: WordCount/WordSplit count ideographs added since Unicode 6.1 as alphabetic
+	camelLowersLastLetter   bool // xstrings/3: ToCamelCase lower-cases a one-letter last word
+	punctAdjacentConnector  bool // xstrings/4: ToSnakeCase/ToKebabCase leave a connector inside a punctuation run as it is
+	rangeToSinglesDropsLast bool // xstrings/5: a from range stepped onto single runes loses its last rune
+	patternDropsFFFD        bool // xstrings/6: a U+FFFD listed in a pattern of two or more runes is dropped
+}{
+	scrubReplacesFFFD:       noKnown,
+	staleCJKRanges:          noKnown,
+	camelLowersLastLetter:   noKnown,
+	punctAdjacentConnector:  noKnown,
+	rangeToSinglesDropsLast: noKnown,
+	patternDropsFFFD:        noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is
+// that of the recorded bugs named ("" for none): the failure names the shape,
+// and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped
+// instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shape) == 0)
+	}
+	if len(shape) > 0 {
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs.
+
+// hasFFFD reports a literal U+FFFD in s (the shape of xstrings/1 for Scrub;
+// an invalid byte is not one, although it decodes to the same value).
+func hasFFFD(s string) bool { return strings.Contains(s, "\ufffd") }
+
+// fffdInPattern reports the shape of xstrings/6: a U+FFFD among two or more
+// literal runes of a pattern (the negating '^' of a from pattern and the
+// escaping backslashes aside). nextRuneRange uses utf8.RuneError for "no
+// rune pending", so a U+FFFD read as the pending rune, or handed on as the
+// lookahead, is taken for none and dropped; only the pattern of that one rune
+// survives (bugs.toml records the rune-follows form).
+func fffdInPattern(p string, from bool) bool {
+	rs := runes(p)
+	if from && len(rs) > 0 && rs[0] == '^' {
+		rs = rs[1:]
+	}
+	lits, fffd := 0, false
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\\' && i+1 < len(rs) {
+			i++
+		}
+		lits++
+		fffd = fffd || rs[i] == utf8.RuneError
+	}
+	return fffd && lits >= 2
+}
+
+// rangeDropsLast reports the shape of xstrings/5: a range of the from pattern
+// whose penultimate rune is aligned with a single (non-range) rune of the to
+// pattern that is not the to pattern's last rune. NewTranslator then steps
+// the range rune by rune onto the singles and stops one short of its end;
+// with the to pattern's last rune it pads the rest of the range instead,
+// which is right.
+func rangeDropsLast(from, to []patItem) bool {
+	off, total := 0, itemsLen(to)
+	for _, it := range from {
+		if it.size() > 1 {
+			p := off + it.size() - 2
+			if j, ok := itemIndexAt(to, p); ok && to[j].size() == 1 && p+1 < total {
+				return true
+			}
+		}
+		off += it.size()
+	}
+	return false
+}
+
+// itemIndexAt is the index of the item holding position j of the expansion.
+func itemIndexAt(items []patItem, j int) (int, bool) {
+	for i, it := range items {
+		if j < it.size() {
+			return i, true
+		}
+		j -= it.size()
+	}
+	return 0, false
+}
+
+// implCJK is the set of ideographs the package's isAlphabet excludes; Han
+// runes outside it are the shape of xstrings/2.
+func implCJK(r rune) bool {
+	return (r >= 0x4e00 && r <= 0x9fcc) || (r >= 0x3400 && r <= 0x4d85) || (r >= 0x20000 && r <= 0x2b81d)
+}
+
+func misclassifiedHan(r rune) bool { return unicode.Is(unicode.Han, r) && !implCJK(r) }
+
+func hasMisclassifiedHan(s string) bool { return strings.ContainsFunc(s, misclassifiedHan) }
+
+// lastWordIsOneUpperLetter reports the shape of xstrings/3: the string ends
+// on an upper-case rune right after a connector, with a word before the
+// connector (toCamelCase lowers it as if it began the first word).
+func lastWordIsOneUpperLetter(s string) bool {
+	rs := runes(s)
+	n := len(rs)
+	if n < 3 || !unicode.IsUpper(rs[n-1]) || !isConnectorRune(rs[n-2]) {
+		return false
+	}
+	for _, r := range rs[:n-2] {
+		if !isConnectorRune(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func isConnectorRune(r rune) bool { return r == '-' || r == '_' || unicode.IsSpace(r) }
+
+// connectorInPunctRun reports the shape of xstrings/4: a '-' or '_' inside a
+// run of punctuation that starts on another punctuation rune (nextWord reads
+// the run as one punctuation word and copies it verbatim).
+func connectorInPunctRun(s string) bool {
+	rs := runes(s)
+	for i := 0; i < len(rs); {
+		r := rs[i]
+		switch {
+		case r == '-' || r == '_':
+			i++
+		case unicode.IsPunct(r):
+			for i++; i < len(rs) && unicode.IsPunct(rs[i]); i++ {
+				if rs[i] == '-' || rs[i] == '_' {
+					return true
+				}
+			}
+		default:
+			i++
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// The Ruby oracle: one ruby process, JSON lines in and out.
+
+const rubyScript = `require 'json'
+STDOUT.sync = true
+while (line = STDIN.gets)
+  q = JSON.parse(line)
+  a = q["a"]
+  begin
+    r = case q["op"]
+      when "length" then a[0].length
+      when "reverse" then a[0].reverse
+      when "center" then a[0].center(a[1], a[2])
+      when "ljust" then a[0].ljust(a[1], a[2])
+      when "rjust" then a[0].rjust(a[1], a[2])
+      when "count" then a[0].count(a[1])
+      when "delete" then a[0].delete(a[1])
+      when "squeeze" then a[1] == "" ? a[0].squeeze : a[0].squeeze(a[1])
+      when "tr" then a[0].tr(a[1], a[2])
+      when "succ" then a[0].succ
+      when "swapcase" then a[0].swapcase
+      when "partition" then a[0].partition(a[1])
+      when "rpartition" then a[0].rpartition(a[1])
+      when "insert" then a[0].dup.insert(a[1], a[2])
+      when "scrub" then a[0].scrub(a[1])
+      else raise "unknown op " + q["op"].to_s
+      end
+    puts JSON.generate({"r" => r})
+  rescue Exception => e
+    puts JSON.generate({"err" => e.class.to_s + ": " + e.message.encode("UTF-8", invalid: :replace, undef: :replace)})
+  end
+end
+`
+
+type rubyOracle struct {
+	mu  sync.Mutex
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var (
+	rubyOnce sync.Once
+	rubyProc *rubyOracle
+	rubyErr  error
+)
+
+func startRuby() {
+	f, err := os.CreateTemp("", "xstrings-oracle-*.rb")
+	if err != nil {
+		rubyErr = err
+		return
+	}
+	if _, err := f.WriteString(rubyScript); err != nil {
+		rubyErr = err
+		return
+	}
+	f.Close()
+	cmd := exec.Command("ruby", f.Name())
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		rubyErr = err
+		return
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		rubyErr = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		rubyErr = fmt.Errorf("starting ruby (the oracle; install the ruby package): %v", err)
+		return
+	}
+	rubyProc = &rubyOracle{in: in, out: bufio.NewReaderSize(out, 1<<20)}
+}
+
+// ruby runs one String method in the oracle process and returns the decoded
+// result; a Ruby exception is returned as an error.
+func ruby(op string, args ...any) (json.RawMessage, error) {
+	rubyOnce.Do(startRuby)
+	if rubyErr != nil {
+		return nil, rubyErr
+	}
+	req, err := json.Marshal(map[string]any{"op": op, "a": args})
+	if err != nil {
+		return nil, err
+	}
+	rubyProc.mu.Lock()
+	defer rubyProc.mu.Unlock()
+	if _, err := rubyProc.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	line, err := rubyProc.out.ReadBytes('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading from ruby: %v", err)
+	}
+	var resp struct {
+		R   json.RawMessage `json:"r"`
+		Err string          `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		return nil, fmt.Errorf("decoding ruby's answer %q: %v", line, err)
+	}
+	if resp.Err != "" {
+		return nil, fmt.Errorf("ruby: %s", resp.Err)
+	}
+	return resp.R, nil
+}
+
+func rubyString(ht *hegel.T, op string, args ...any) string {
+	raw, err := ruby(op, args...)
+	if err != nil {
+		fail(ht, "oracle %s%v: %v", op, args, err)
+	}
+	var s string
+	if err := json.Unmarshal(raw, &s); err != nil {
+		fail(ht, "oracle %s: %s is not a string", op, raw)
+	}
+	return s
+}
+
+func rubyInt(ht *hegel.T, op string, args ...any) int {
+	raw, err := ruby(op, args...)
+	if err != nil {
+		fail(ht, "oracle %s%v: %v", op, args, err)
+	}
+	var i int
+	if err := json.Unmarshal(raw, &i); err != nil {
+		fail(ht, "oracle %s: %s is not an integer", op, raw)
+	}
+	return i
+}
+
+func rubyStrings(ht *hegel.T, op string, args ...any) []string {
+	raw, err := ruby(op, args...)
+	if err != nil {
+		fail(ht, "oracle %s%v: %v", op, args, err)
+	}
+	var ss []string
+	if err := json.Unmarshal(raw, &ss); err != nil {
+		fail(ht, "oracle %s: %s is not a list of strings", op, raw)
+	}
+	return ss
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// ---------------------------------------------------------------------------
+// Alphabets and strings.
+
+// Buckets of runes; the non-ASCII ones are written as escapes so that this
+// file stays ASCII. No titlecase letters and no letters whose full case
+// mapping changes length (the Ruby oracle uses full mappings, the package
+// simple ones; see the README).
+var (
+	lowerASCII  = []rune("abcdefghijklmnopqrstuvwxyz")
+	upperASCII  = []rune("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
+	digits      = []rune("0123456789")
+	punctASCII  = []rune("!\"#$%&'()*+,./:;<=>?@[]{}|~`")
+	specials    = []rune("-_^\\ ")
+	spaces      = []rune(" \t\n\r\u00a0\u3000")
+	latin       = []rune("\u00e9\u00fc\u00f1\u00d6\u00ff\u00c0\u0131\u017f\u00e6\u00c6\u0153")
+	greekCyr    = []rune("\u03b1\u03a9\u03c2\u03a3\u0434\u0416\u044f\u0401")
+	cjk         = []rune("\u4e2d\u6587\u5b57\u3042\u30ab\u9fff\u4db6\U00020000\U0002b820\uf900\u3005")
+	wide        = []rune("\uff21\uff71\u2028\u2003\u2764\U0001f600\U0001f4a9")
+	marks       = []rune("\u0301\u0308\u200d\ufe0f")
+	replacement = []rune("\ufffd")
+)
+
+// implementedCJK is the cjk bucket without the ideographs the package's
+// stale ranges miss (the shape of xstrings/2).
+var implementedCJK = func() []rune {
+	var out []rune
+	for _, r := range cjk {
+		if !misclassifiedHan(r) {
+			out = append(out, r)
+		}
+	}
+	return out
+}()
+
+// runePools names the runes of the buckets whose runes are the shapes of
+// recorded bugs: the CJK bucket (xstrings/2 for WordSplit) and the
+// replacement character (xstrings/1 for Scrub, xstrings/6 in a pattern).
+type runePools struct {
+	cjk, replacement []rune
+}
+
+var (
+	allRunes = runePools{cjk, replacement}
+	// modelRunes: what the documented-models property draws; under
+	// HEGEL_NO_KNOWN=1 the ideographs the package classifies right and no
+	// U+FFFD.
+	modelRunes = func() runePools {
+		p := allRunes
+		if Known.staleCJKRanges {
+			p.cjk = implementedCJK
+		}
+		if Known.scrubReplacesFFFD {
+			p.replacement = nil
+		}
+		return p
+	}()
+	// patternRunes: what a pattern draws; under HEGEL_NO_KNOWN=1 no U+FFFD.
+	patternRunes = func() runePools {
+		p := allRunes
+		if Known.patternDropsFFFD {
+			p.replacement = nil
+		}
+		return p
+	}()
+)
+
+// alphabetSpec says which optional buckets a case's alphabet has beside the
+// ASCII letters and digits.
+type alphabetSpec struct {
+	punct, spaces, latin, cjk, marks, replacement bool
+}
+
+// alphabets: punctuation 70% of the time, spaces and the Latin/Greek/Cyrillic
+// letters half of the time, CJK and wide runes 40%, combining marks 20%, the
+// replacement character 10%.
+var alphabets = hegel.Composite(func(tc hegel.TestCase) alphabetSpec {
+	return alphabetSpec{
+		punct:       hegel.Draw(tc, chance(70)),
+		spaces:      hegel.Draw(tc, chance(50)),
+		latin:       hegel.Draw(tc, chance(50)),
+		cjk:         hegel.Draw(tc, chance(40)),
+		marks:       hegel.Draw(tc, chance(20)),
+		replacement: hegel.Draw(tc, chance(10)),
+	}
+})
+
+// buckets renders the spec over the pools.
+func (a alphabetSpec) buckets(pools runePools) [][]rune {
+	bs := [][]rune{lowerASCII, upperASCII, digits}
+	add := func(on bool, more ...[]rune) {
+		if !on {
+			return
+		}
+		for _, b := range more {
+			if len(b) > 0 {
+				bs = append(bs, b)
+			}
+		}
+	}
+	add(a.punct, punctASCII, specials)
+	add(a.spaces, spaces)
+	add(a.latin, latin, greekCyr)
+	add(a.cjk, pools.cjk, wide)
+	add(a.marks, marks)
+	add(a.replacement, pools.replacement)
+	return bs
+}
+
+// narrowBuckets: the pattern alphabet 60% of the patterns draw from, small
+// enough that a pattern hits the string.
+var narrowBuckets = [][]rune{lowerASCII[:6], upperASCII[:6], digits[:4], specials, punctASCII[:5]}
+
+// runesOf: a rune of one of the buckets, each bucket as likely as another.
+func runesOf(buckets [][]rune) hegel.Generator[rune] {
+	return hegel.FlatMap(hegel.SampledFrom(buckets), func(b []rune) hegel.Generator[rune] { return hegel.SampledFrom(b) })
+}
+
+func runesToString(rs []rune) string { return string(rs) }
+
+// textsOf: a string of up to hi runes of the buckets.
+func textsOf(buckets [][]rune, hi int) hegel.Generator[string] {
+	return hegel.Map(many(runesOf(buckets), 0, hi), runesToString)
+}
+
+// badBytes: a byte that is not valid UTF-8 where it lands (a continuation
+// byte, a lead byte without its tail, 0xfe, 0xff).
+var badBytes = hegel.Map(hegel.SampledFrom([]byte{0xff, 0xfe, 0x80, 0xc3, 0xe4, 0xf0}), func(b byte) string { return string([]byte{b}) })
+
+// mixedTextsOf: up to 24 pieces, a rune of the buckets 92% of the time and
+// an invalid byte 8%.
+func mixedTextsOf(buckets [][]rune) hegel.Generator[string] {
+	pieces := weighted(
+		choice[string]{92, hegel.Map(runesOf(buckets), func(r rune) string { return string(r) })},
+		choice[string]{8, badBytes},
+	)
+	return hegel.Map(many(pieces, 0, 24), func(ps []string) string { return strings.Join(ps, "") })
+}
+
+func runes(s string) []rune { return []rune(s) }
+
+// ---------------------------------------------------------------------------
+// The pattern language of Translate, Delete, Count and Squeeze, as documented.
+
+type patItem struct{ lo, hi rune } // hi may be below lo: a descending range
+
+// parsePattern reads a pattern into items. A leading '^' negates (when the
+// pattern is a from pattern and something follows it), '\' escapes the next
+// rune, 'a-z' is an inclusive range either way, and a '-' with no rune on one
+// side is itself.
+func parsePattern(p string, from bool) (items []patItem, negated bool) {
+	rs := runes(p)
+	if from && len(rs) > 0 && rs[0] == '^' {
+		negated = true
+		rs = rs[1:]
+	}
+	// First read the literal runes, marking which came from escapes.
+	type lit struct {
+		r       rune
+		escaped bool
+	}
+	var lits []lit
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\\' && i+1 < len(rs) {
+			lits = append(lits, lit{rs[i+1], true})
+			i++
+			continue
+		}
+		lits = append(lits, lit{rs[i], false})
+	}
+	for i := 0; i < len(lits); i++ {
+		if i+2 < len(lits) && lits[i+1].r == '-' && !lits[i+1].escaped {
+			items = append(items, patItem{lits[i].r, lits[i+2].r})
+			i += 2
+			continue
+		}
+		items = append(items, patItem{lits[i].r, lits[i].r})
+	}
+	return items, negated
+}
+
+func (it patItem) size() int {
+	if it.hi >= it.lo {
+		return int(it.hi-it.lo) + 1
+	}
+	return int(it.lo-it.hi) + 1
+}
+
+func (it patItem) contains(r rune) bool {
+	if it.hi >= it.lo {
+		return it.lo <= r && r <= it.hi
+	}
+	return it.hi <= r && r <= it.lo
+}
+
+// offset is the position of r within the item's expansion.
+func (it patItem) offset(r rune) int {
+	if it.hi >= it.lo {
+		return int(r - it.lo)
+	}
+	return int(it.lo - r)
+}
+
+func itemsLen(items []patItem) int {
+	total := 0
+	for _, it := range items {
+		total += it.size()
+	}
+	return total
+}
+
+// itemAt is the j-th rune of the expansion, or the last one for j beyond it.
+func itemAt(items []patItem, j int) rune {
+	total := itemsLen(items)
+	if j >= total {
+		j = total - 1
+	}
+	for _, it := range items {
+		if j < it.size() {
+			if it.hi >= it.lo {
+				return it.lo + rune(j)
+			}
+			return it.lo - rune(j)
+		}
+		j -= it.size()
+	}
+	panic("unreachable")
+}
+
+// position is the index of r in the expansion of items, the last listing
+// winning, or -1.
+func position(items []patItem, r rune) int {
+	pos := -1
+	off := 0
+	for _, it := range items {
+		if it.contains(r) {
+			pos = off + it.offset(r)
+		}
+		off += it.size()
+	}
+	return pos
+}
+
+type patModel struct {
+	from, to []patItem
+	negated  bool
+	empty    bool // an empty from pattern matches nothing
+}
+
+func newPatModel(from, to string) patModel {
+	m := patModel{empty: from == ""}
+	m.from, m.negated = parsePattern(from, true)
+	m.to, _ = parsePattern(to, false)
+	return m
+}
+
+// lookup reports whether r matches and what it maps to (deleted when the to
+// pattern is empty).
+func (m patModel) lookup(r rune) (mapped rune, matched, deleted bool) {
+	if m.empty {
+		return r, false, false
+	}
+	pos := position(m.from, r)
+	if m.negated {
+		matched = pos < 0
+	} else {
+		matched = pos >= 0
+	}
+	if !matched {
+		return r, false, false
+	}
+	if len(m.to) == 0 {
+		return r, true, true
+	}
+	if m.negated {
+		return itemAt(m.to, itemsLen(m.to)-1), true, false
+	}
+	return itemAt(m.to, pos), true, false
+}
+
+func (m patModel) translate(s string) string {
+	var sb strings.Builder
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		if r == utf8.RuneError && size == 1 {
+			sb.WriteString(s[:1])
+			s = s[1:]
+			continue
+		}
+		mapped, matched, deleted := m.lookup(r)
+		switch {
+		case deleted:
+		case matched:
+			sb.WriteRune(mapped)
+		default:
+			sb.WriteString(s[:size])
+		}
+		s = s[size:]
+	}
+	return sb.String()
+}
+
+func (m patModel) count(s string) int {
+	c := 0
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		s = s[size:]
+		if r == utf8.RuneError && size == 1 {
+			continue
+		}
+		if _, matched, _ := m.lookup(r); matched {
+			c++
+		}
+	}
+	return c
+}
+
+// squeeze drops a rune equal to the one before it when it matches (every rune
+// matches when the pattern is empty).
+func squeezeModel(s, pattern string) string {
+	var m patModel
+	all := pattern == ""
+	if !all {
+		m = newPatModel(pattern, "")
+	}
+	var sb strings.Builder
+	var last rune = -1
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		if r == utf8.RuneError && size == 1 {
+			sb.WriteString(s[:1])
+			s = s[1:]
+			last = -1
+			continue
+		}
+		matched := all
+		if !all {
+			_, matched, _ = m.lookup(r)
+		}
+		if !(r == last && matched) {
+			sb.WriteString(s[:size])
+		}
+		last = r
+		s = s[size:]
+	}
+	return sb.String()
+}
+
+// Patterns as drawn ---------------------------------------------------------
+
+// patPiece is one piece of a pattern: a rune, or a range from lo to hi in
+// either direction (lo == hi is a one-rune range, which Ruby mishandles).
+type patPiece struct {
+	lo, hi rune
+	ranged bool
+}
+
+// patSpec is a pattern as drawn: negated (a from pattern's leading '^') and
+// its pieces; String renders it with the special runes escaped.
+type patSpec struct {
+	negated bool
+	pieces  []patPiece
+}
+
+func specialPatRune(r rune) bool { return r == '-' || r == '^' || r == '\\' }
+
+func writePatRune(sb *strings.Builder, r rune) {
+	if specialPatRune(r) {
+		sb.WriteByte('\\')
+	}
+	sb.WriteRune(r)
+}
+
+func (p patSpec) String() string {
+	var sb strings.Builder
+	if p.negated {
+		sb.WriteByte('^')
+	}
+	for _, it := range p.pieces {
+		writePatRune(&sb, it.lo)
+		if it.ranged {
+			sb.WriteByte('-')
+			writePatRune(&sb, it.hi)
+		}
+	}
+	return sb.String()
+}
+
+// rubyOK reports whether Ruby accepts the pattern with the documented
+// meaning: it rejects descending ranges, mishandles a range of one rune and
+// a range with an escaped end, and reads a bare "^" as a literal (README).
+func (p patSpec) rubyOK() bool {
+	for _, it := range p.pieces {
+		if it.ranged && (it.lo >= it.hi || specialPatRune(it.lo) || specialPatRune(it.hi)) {
+			return false
+		}
+	}
+	return p.String() != "^"
+}
+
+// piecesOf: a rune of the buckets 60% of the time, else a range whose ends
+// are two runes of one bucket.
+func piecesOf(buckets [][]rune) hegel.Generator[patPiece] {
+	singles := hegel.Map(runesOf(buckets), func(r rune) patPiece { return patPiece{lo: r, hi: r} })
+	ranges := hegel.FlatMap(hegel.SampledFrom(buckets), func(b []rune) hegel.Generator[patPiece] {
+		ends := hegel.SampledFrom(b)
+		return hegel.Map(pairs(ends, ends), func(p pair[rune, rune]) patPiece { return patPiece{lo: p.a, hi: p.b, ranged: true} })
+	})
+	return weighted(choice[patPiece]{60, singles}, choice[patPiece]{40, ranges})
+}
+
+// patternsOf: no piece one time in ten, else one to four; a from pattern is
+// negated 25% of the time.
+func patternsOf(buckets [][]rune, from bool) hegel.Generator[patSpec] {
+	negated := hegel.Just(false)
+	if from {
+		negated = chance(25)
+	}
+	pieces := weighted(choice[[]patPiece]{10, hegel.Just([]patPiece(nil))}, choice[[]patPiece]{90, many(piecesOf(buckets), 1, 4)})
+	return hegel.Composite(func(tc hegel.TestCase) patSpec {
+		return patSpec{negated: hegel.Draw(tc, negated), pieces: hegel.Draw(tc, pieces)}
+	})
+}
+
+// items are the pattern's items as the model reads it.
+func (p patSpec) items(from bool) []patItem {
+	items, _ := parsePattern(p.String(), from)
+	return items
+}
+
+// hittingTextsOf: a string of up to 24 runes of the buckets, three in ten of
+// them runes the pattern lists (an index into its expansion, modulo its
+// length), so that a pattern hits the string; a pattern listing nothing
+// gives plain texts.
+func hittingTextsOf(buckets [][]rune, items []patItem) hegel.Generator[string] {
+	total := itemsLen(items)
+	if total == 0 {
+		return textsOf(buckets, 24)
+	}
+	listed := hegel.Map(positions, func(i int) rune { return itemAt(items, i%total) })
+	return hegel.Map(many(weighted(choice[rune]{70, runesOf(buckets)}, choice[rune]{30, listed}), 0, 24), runesToString)
+}
+
+// ---------------------------------------------------------------------------
+// Models from the documentation.
+
+func expandTabsModel(s string, tabSize int) string {
+	var sb strings.Builder
+	column := 0
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		switch {
+		case r == '\t':
+			expand := tabSize - column%tabSize
+			sb.WriteString(strings.Repeat(" ", expand))
+			column += expand
+		case r == '\n':
+			column = 0
+			sb.WriteString(s[:size])
+		default:
+			column += xstrings.RuneWidth(r)
+			sb.WriteString(s[:size])
+		}
+		s = s[size:]
+	}
+	return sb.String()
+}
+
+// isWordRune is the documented "alphabetic": a letter that is not a Han
+// ideograph.
+func isWordRune(r rune) bool { return unicode.IsLetter(r) && !unicode.Is(unicode.Han, r) }
+
+func wordSplitModel(s string) []string {
+	var words []string
+	var cur strings.Builder
+	in := false
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		switch {
+		case r != utf8.RuneError && isWordRune(r):
+			in = true
+			cur.WriteString(s[:size])
+		case in && (r == '\'' || r == '-'):
+			cur.WriteString(s[:size])
+		default:
+			if in {
+				words = append(words, cur.String())
+				cur.Reset()
+				in = false
+			}
+		}
+		s = s[size:]
+	}
+	if in {
+		words = append(words, cur.String())
+	}
+	return words
+}
+
+// scrubModel replaces every maximal run of invalid bytes with repl.
+func scrubModel(s, repl string) string {
+	var sb strings.Builder
+	inBad := false
+	for len(s) > 0 {
+		r, size := utf8.DecodeRuneInString(s)
+		if r == utf8.RuneError && size == 1 {
+			inBad = true
+		} else {
+			if inBad {
+				sb.WriteString(repl)
+				inBad = false
+			}
+			sb.WriteString(s[:size])
+		}
+		s = s[size:]
+	}
+	if inBad {
+		sb.WriteString(repl)
+	}
+	return sb.String()
+}
+
+func widthModel(r rune) int {
+	switch {
+	case r == utf8.RuneError || r < 0x20:
+		return 0
+	case r < 0x2000:
+		return 1
+	case r < 0xff61:
+		return 2
+	case r < 0xffa0:
+		return 1
+	}
+	return 2
+}
+
+// foldCase maps every rune through its upper and then lower case, so that
+// strings equal up to the package's simple case mappings compare equal.
+func foldCase(s string) string {
+	return strings.Map(func(r rune) rune { return unicode.ToLower(unicode.ToUpper(r)) }, s)
+}
+
+func stripConnectors(s string) string {
+	return strings.Map(func(r rune) rune {
+		if r == '-' || r == '_' || unicode.IsSpace(r) {
+			return -1
+		}
+		return r
+	}, s)
+}
+
+func catches(f func()) (msg any) {
+	defer func() { msg = recover() }()
+	f()
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: the ported String methods against Ruby.
+
+// separator is the separator of Partition: empty, a string of its own, or a
+// substring of s (from rune at, span runes long, both taken modulo the
+// string's length).
+type separator struct {
+	text     string
+	sub      bool
+	at, span int
+}
+
+func (p separator) of(s string) string {
+	if !p.sub {
+		return p.text
+	}
+	rs := runes(s)
+	if len(rs) == 0 {
+		return ""
+	}
+	a := p.at % len(rs)
+	b := a + p.span%(len(rs)-a+1)
+	return string(rs[a:b])
+}
+
+// separatorsOf: empty a quarter of the time, a string of the buckets a
+// quarter, a substring half.
+func separatorsOf(texts hegel.Generator[string]) hegel.Generator[separator] {
+	return weighted(
+		choice[separator]{25, hegel.Just(separator{})},
+		choice[separator]{25, hegel.Map(texts, func(t string) separator { return separator{text: t} })},
+		choice[separator]{50, hegel.Map(pairs(positions, positions), func(p pair[int, int]) separator { return separator{sub: true, at: p.a, span: p.b} })},
+	)
+}
+
+// rubyCase: a string, the separator, the insertion and the justification of
+// one case.
+type rubyCase struct {
+	alphabet alphabetSpec
+	s        string
+	sep      separator
+	at       int // the Insert index, modulo the rune count plus one
+	src      string
+	length   int
+	pad      string
+}
+
+func (c rubyCase) insertAt() int { return c.at % (utf8.RuneCountInString(c.s) + 1) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c rubyCase) GoString() string {
+	return fmt.Sprintf("s %q sep %q insert %q at %d justify to %d with pad %q", c.s, c.sep.of(c.s), c.src, c.insertAt(), c.length, c.pad)
+}
+
+// rubyCases: the strings of a drawn alphabet; the pad is a space 40% of the
+// time, else up to five runes.
+var rubyCases = hegel.Composite(func(tc hegel.TestCase) rubyCase {
+	a := hegel.Draw(tc, alphabets)
+	buckets := a.buckets(allRunes)
+	texts := textsOf(buckets, 24)
+	pads := weighted(choice[string]{40, hegel.Just(" ")}, choice[string]{60, textsOf(buckets, 5)})
+	return rubyCase{
+		alphabet: a,
+		s:        hegel.Draw(tc, texts),
+		sep:      hegel.Draw(tc, separatorsOf(texts)),
+		at:       hegel.Draw(tc, positions),
+		src:      hegel.Draw(tc, texts),
+		length:   hegel.Draw(tc, hegel.Integers(0, 40)),
+		pad:      hegel.Draw(tc, pads),
+	}
+})
+
+func TestHegelRubyPorts(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rubyCases)
+		s := c.s
+
+		if got, want := xstrings.Len(s), rubyInt(ht, "length", s); got != want {
+			fail(ht, "Len(%q) = %d, ruby length %d", s, got, want)
+		}
+		if got, want := xstrings.Reverse(s), rubyString(ht, "reverse", s); got != want {
+			fail(ht, "Reverse(%q) = %q, ruby %q", s, got, want)
+		}
+		if got := xstrings.Reverse(xstrings.Reverse(s)); got != s {
+			fail(ht, "Reverse twice of %q = %q", s, got)
+		}
+
+		// swapcase: Ruby uses full case mappings, the package simple ones;
+		// compare only when Ruby's answer has the same rune count.
+		sw := rubyString(ht, "swapcase", s)
+		if utf8.RuneCountInString(sw) == utf8.RuneCountInString(s) {
+			if got := xstrings.SwapCase(s); got != sw {
+				fail(ht, "SwapCase(%q) = %q, ruby %q", s, got, sw)
+			}
+		}
+
+		// partition / rpartition with a separator that is often a substring.
+		sep := c.sep.of(s)
+		h, m, tl := xstrings.Partition(s, sep)
+		if want := rubyStrings(ht, "partition", s, sep); h != want[0] || m != want[1] || tl != want[2] {
+			fail(ht, "Partition(%q, %q) = %q %q %q, ruby %q", s, sep, h, m, tl, want)
+		}
+		h, m, tl = xstrings.LastPartition(s, sep)
+		if want := rubyStrings(ht, "rpartition", s, sep); h != want[0] || m != want[1] || tl != want[2] {
+			fail(ht, "LastPartition(%q, %q) = %q %q %q, ruby %q", s, sep, h, m, tl, want)
+		}
+
+		// insert at a rune index.
+		idx := c.insertAt()
+		if got, want := xstrings.Insert(s, c.src, idx), rubyString(ht, "insert", s, idx, c.src); got != want {
+			fail(ht, "Insert(%q, %q, %d) = %q, ruby %q", s, c.src, idx, got, want)
+		}
+
+		// justification with a cycling pad.
+		length, pad := c.length, c.pad
+		if pad == "" {
+			for name, f := range map[string]func(string, int, string) string{"Center": xstrings.Center, "LeftJustify": xstrings.LeftJustify, "RightJustify": xstrings.RightJustify} {
+				if got := f(s, length, pad); got != s {
+					fail(ht, "%s(%q, %d, \"\") = %q, want the string itself", name, s, length, got)
+				}
+			}
+		} else {
+			if got, want := xstrings.Center(s, length, pad), rubyString(ht, "center", s, length, pad); got != want {
+				fail(ht, "Center(%q, %d, %q) = %q, ruby %q", s, length, pad, got, want)
+			}
+			if got, want := xstrings.LeftJustify(s, length, pad), rubyString(ht, "ljust", s, length, pad); got != want {
+				fail(ht, "LeftJustify(%q, %d, %q) = %q, ruby %q", s, length, pad, got, want)
+			}
+			if got, want := xstrings.RightJustify(s, length, pad), rubyString(ht, "rjust", s, length, pad); got != want {
+				fail(ht, "RightJustify(%q, %d, %q) = %q, ruby %q", s, length, pad, got, want)
+			}
+		}
+
+		// succ.
+		// Ruby's succ treats every Unicode letter and digit as alphanumeric,
+		// the package only ASCII ones (documented): compare when they agree.
+		last, _ := utf8.DecodeLastRuneInString(s)
+		asciiAlnumOnly := true
+		for _, r := range s {
+			if r > unicode.MaxASCII && (unicode.IsLetter(r) || unicode.IsNumber(r)) {
+				asciiAlnumOnly = false
+			}
+		}
+		if asciiAlnumOnly && (s == "" || (last < 0xd7ff && last != 0x7f) || (0xe000 <= last && last < 0x10fff0)) {
+			if got, want := xstrings.Successor(s), rubyString(ht, "succ", s); got != want {
+				fail(ht, "Successor(%q) = %q, ruby succ %q", s, got, want)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: the pattern language (Translate, Delete, Count, Squeeze).
+
+// translateCase: a string, a from and a to pattern (the patterns from the
+// narrow alphabet 60% of the time so that they hit the string), and the
+// Squeeze input: the string with its runes doubled where the tape says
+// (recycled modulo its length; an empty tape doubles nothing), squeezed with
+// the from pattern or, when all, with the empty one.
+type translateCase struct {
+	alphabet alphabetSpec
+	narrow   bool
+	s        string
+	from, to patSpec
+	dups     []bool
+	all      bool
+}
+
+// squeezed is s with the runes doubled where the tape says.
+func (c translateCase) squeezed() string {
+	if len(c.dups) == 0 {
+		return c.s
+	}
+	var sb strings.Builder
+	for i, r := range runes(c.s) {
+		sb.WriteRune(r)
+		if c.dups[i%len(c.dups)] {
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+// squeezePattern is the pattern Squeeze gets.
+func (c translateCase) squeezePattern() string {
+	if c.all {
+		return ""
+	}
+	return c.from.String()
+}
+
+func (c translateCase) GoString() string {
+	return fmt.Sprintf("s %q from %q to %q squeeze %q with pattern %q", c.s, c.from.String(), c.to.String(), c.squeezed(), c.squeezePattern())
+}
+
+// translateCases: the to pattern is empty (deletion) by a weight of 15 in
+// 100, a quarter of the cases or so once the binding's bias towards the first
+// alternative is counted; under HEGEL_NO_KNOWN=1 it is filtered so that no
+// from range steps onto single to runes one short of its end (xstrings/5).
+// The string hits the from pattern. The tape of doublings is absent 40% of
+// the time, else up to 24 coins true 40% of the time; the empty Squeeze
+// pattern comes 30% of the time.
+var translateCases = hegel.Composite(func(tc hegel.TestCase) translateCase {
+	a := hegel.Draw(tc, alphabets)
+	narrow := hegel.Draw(tc, chance(60))
+	buckets := a.buckets(allRunes)
+	patBuckets := a.buckets(patternRunes)
+	if narrow {
+		patBuckets = narrowBuckets
+	}
+	from := hegel.Draw(tc, patternsOf(patBuckets, true))
+	toPatterns := weighted(choice[patSpec]{15, hegel.Just(patSpec{})}, choice[patSpec]{85, patternsOf(patBuckets, false)})
+	if Known.rangeToSinglesDropsLast && !from.negated {
+		fromItems := from.items(true)
+		toPatterns = hegel.Filter(toPatterns, func(to patSpec) bool { return !rangeDropsLast(fromItems, to.items(false)) })
+	}
+	return translateCase{
+		alphabet: a,
+		narrow:   narrow,
+		s:        hegel.Draw(tc, hittingTextsOf(buckets, from.items(true))),
+		from:     from,
+		to:       hegel.Draw(tc, toPatterns),
+		dups:     hegel.Draw(tc, maybe(60, many(chance(40), 1, 24))),
+		all:      hegel.Draw(tc, chance(30)),
+	}
+})
+
+// translationShape names the recorded bugs whose shape a translation has:
+// a from range stepped onto single to runes (xstrings/5), a U+FFFD among the
+// runes of either pattern (xstrings/6).
+func translationShape(from, to string) []string {
+	m := newPatModel(from, to)
+	return append(shapeIf(to != "" && !m.negated && rangeDropsLast(m.from, m.to), "xstrings/5"),
+		shapeIf(fffdInPattern(from, true) || fffdInPattern(to, false), "xstrings/6")...)
+}
+
+// checkTranslation compares Translate, a reused Translator and TranslateRune
+// with the model (and Translate with Ruby's tr when rubyOK); a mismatch
+// names the shape.
+func checkTranslation(ht *hegel.T, s, from, to string, rubyOK bool, shape []string) {
+	m := newPatModel(from, to)
+	got := xstrings.Translate(s, from, to)
+	if want := m.translate(s); got != want {
+		mismatch(ht, shape, "Translate(%q, %q, %q) = %q, model %q", s, from, to, got, want)
+	}
+	if rubyOK {
+		if want := rubyString(ht, "tr", s, from, to); got != want {
+			mismatch(ht, shape, "Translate(%q, %q, %q) = %q, ruby tr %q", s, from, to, got, want)
+		}
+	}
+	tr := xstrings.NewTranslator(from, to)
+	if tr.HasPattern() != (from != "") {
+		fail(ht, "NewTranslator(%q, %q).HasPattern() = %v", from, to, tr.HasPattern())
+	}
+	if got2 := tr.Translate(s); got2 != got {
+		fail(ht, "Translator.Translate(%q) = %q, Translate %q", s, got2, got)
+	}
+	// TranslateRune agrees with the model rune by rune.
+	for _, r := range s {
+		if r == utf8.RuneError {
+			continue
+		}
+		res, translated := tr.TranslateRune(r)
+		mapped, matched, deleted := m.lookup(r)
+		if translated != matched {
+			mismatch(ht, shape, "TranslateRune(%q) translated = %v, model %v (from %q to %q)", r, translated, matched, from, to)
+		}
+		if matched && !deleted && res != mapped {
+			mismatch(ht, shape, "TranslateRune(%q) = %q, model %q (from %q to %q)", r, res, mapped, from, to)
+		}
+		if !matched && res != r {
+			mismatch(ht, shape, "TranslateRune(%q) = %q for an unmatched rune", r, res)
+		}
+	}
+}
+
+// checkDeleteCount compares Delete and Count with the model (and with Ruby
+// when rubyFrom and the pattern is not empty).
+func checkDeleteCount(ht *hegel.T, s, from string, rubyFrom bool, shape []string) {
+	got := xstrings.Delete(s, from)
+	if want := newPatModel(from, "").translate(s); got != want {
+		mismatch(ht, shape, "Delete(%q, %q) = %q, model %q", s, from, got, want)
+	}
+	if rubyFrom && from != "" {
+		if want := rubyString(ht, "delete", s, from); got != want {
+			mismatch(ht, shape, "Delete(%q, %q) = %q, ruby delete %q", s, from, got, want)
+		}
+	}
+	cnt := xstrings.Count(s, from)
+	if want := newPatModel(from, "").count(s); cnt != want {
+		mismatch(ht, shape, "Count(%q, %q) = %d, model %d", s, from, cnt, want)
+	}
+	if rubyFrom && from != "" {
+		if want := rubyInt(ht, "count", s, from); cnt != want {
+			mismatch(ht, shape, "Count(%q, %q) = %d, ruby count %d", s, from, cnt, want)
+		}
+	}
+}
