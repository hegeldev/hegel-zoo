+// ---------------------------------------------------------------------------
+// Property 3: the functions with documented models (ExpandTabs, Slice,
+// Insert, Scrub, WordCount/WordSplit, Width, Shuffle).
+
+// sliceSpec: the Slice bounds: start and span taken modulo what fits, the end
+// negative (-negEnd) when negEnd is set, and which of the out-of-range shapes
+// must panic (modulo their number).
+type sliceSpec struct {
+	start, span int
+	negEnd      int
+	bad         int
+}
+
+func (sp sliceSpec) bounds(n int) (start, end int) {
+	start = sp.start % (n + 1)
+	end = start + sp.span%(n-start+1)
+	if sp.negEnd > 0 {
+		end = -sp.negEnd
+	}
+	return start, end
+}
+
+// insertSpec: what Insert inserts, where (modulo the rune count plus one),
+// and which out-of-range index must panic (-1, or one past the end).
+type insertSpec struct {
+	text    string
+	at      int
+	pastEnd bool
+}
+
+func (in insertSpec) index(n int) int { return in.at % (n + 1) }
+
+func (in insertSpec) badIndex(n int) int {
+	if in.pastEnd {
+		return n + 1
+	}
+	return -1
+}
+
+// tabMarks: what the ExpandTabs tape puts before a rune: nothing three times
+// in four, else a tab or a newline.
+var tabMarks = []string{"", "", "", "", "", "", "\t", "\n"}
+
+// repls: what Scrub puts in place of a run of invalid bytes.
+var repls = hegel.SampledFrom([]string{"?", "", "\ufffd", "<>", "\u00bf"})
+
+// modelCase: a string (with invalid bytes mixed in 30% of the time), the
+// ExpandTabs tape (recycled modulo its length; empty inserts nothing) and
+// tab size, the Slice and Insert specs, the Scrub replacement and the
+// Shuffle seed.
+type modelCase struct {
+	alphabet alphabetSpec
+	s        string
+	tabs     []string
+	tabSize  int
+	badTab   int // ExpandTabs panics for -badTab
+	slice    sliceSpec
+	insert   insertSpec
+	repl     string
+	seed     int64
+}
+
+// tabbed is s with the tape's marks before its runes (an invalid byte is a
+// U+FFFD rune here, as in the old test).
+func (c modelCase) tabbed() string {
+	rs := runes(c.s)
+	if len(c.tabs) == 0 {
+		return string(rs)
+	}
+	var sb strings.Builder
+	for i, r := range rs {
+		sb.WriteString(c.tabs[i%len(c.tabs)])
+		sb.WriteRune(r)
+	}
+	return sb.String()
+}
+
+func (c modelCase) GoString() string {
+	n := utf8.RuneCountInString(c.s)
+	start, end := c.slice.bounds(n)
+	return fmt.Sprintf("s %q tabbed %q tab size %d slice [%d:%d] insert %q at %d scrub with %q seed %d", c.s, c.tabbed(), c.tabSize, start, end, c.insert.text, c.insert.index(n), c.repl, c.seed)
+}
+
+var modelCases = hegel.Composite(func(tc hegel.TestCase) modelCase {
+	a := hegel.Draw(tc, alphabets)
+	buckets := a.buckets(modelRunes)
+	texts := textsOf(buckets, 24)
+	return modelCase{
+		alphabet: a,
+		s:        hegel.Draw(tc, weighted(choice[string]{70, texts}, choice[string]{30, mixedTextsOf(buckets)})),
+		tabs:     hegel.Draw(tc, many(hegel.SampledFrom(tabMarks), 0, 24)),
+		tabSize:  hegel.Draw(tc, hegel.Integers(1, 9)),
+		badTab:   hegel.Draw(tc, hegel.Integers(0, 3)),
+		slice: sliceSpec{
+			start:  hegel.Draw(tc, positions),
+			span:   hegel.Draw(tc, positions),
+			negEnd: hegel.Draw(tc, maybe(25, hegel.Integers(1, 3))),
+			bad:    hegel.Draw(tc, positions),
+		},
+		insert: insertSpec{
+			text:    hegel.Draw(tc, texts),
+			at:      hegel.Draw(tc, positions),
+			pastEnd: hegel.Draw(tc, hegel.Booleans()),
+		},
+		repl: hegel.Draw(tc, repls),
+		seed: hegel.Draw(tc, hegel.Integers[int64](0, 1<<30)),
+	}
+})
+
+// checkScrub compares Scrub with the model.
+func checkScrub(ht *hegel.T, s, repl string, shape []string) {
+	if got, want := xstrings.Scrub(s, repl), scrubModel(s, repl); got != want {
+		mismatch(ht, shape, "Scrub(%q, %q) = %q, model %q", s, repl, got, want)
+	}
+}
+
+// checkWords compares WordSplit with the model and WordCount with it.
+func checkWords(ht *hegel.T, s string, shape []string) {
+	words := xstrings.WordSplit(s)
+	if want := wordSplitModel(s); !reflect.DeepEqual(words, want) && !(len(words) == 0 && len(want) == 0) {
+		mismatch(ht, shape, "WordSplit(%q) = %q, model %q", s, words, want)
+	}
+	if got := xstrings.WordCount(s); got != len(words) {
+		fail(ht, "WordCount(%q) = %d, WordSplit gives %d words", s, got, len(words))
+	}
+}
+
+func TestHegelDocumentedModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, modelCases)
+		s := c.s
+		valid := utf8.ValidString(s)
+		rs := runes(s)
+		L := len(rs)
+
+		// ExpandTabs, on a string with tabs and newlines mixed in.
+		ts, tab := c.tabbed(), c.tabSize
+		if got, want := xstrings.ExpandTabs(ts, tab), expandTabsModel(ts, tab); got != want {
+			fail(ht, "ExpandTabs(%q, %d) = %q, model %q", ts, tab, got, want)
+		}
+		if catches(func() { xstrings.ExpandTabs(ts, -c.badTab) }) == nil {
+			fail(ht, "ExpandTabs with a tab size <= 0 did not panic")
+		}
+
+		// Slice and Insert: in range they agree with the rune slice, out of
+		// range they panic.
+		if valid {
+			start, end := c.slice.bounds(L)
+			want := string(rs[start:])
+			if end >= 0 {
+				want = string(rs[start:end])
+			}
+			if got := xstrings.Slice(s, start, end); got != want {
+				fail(ht, "Slice(%q, %d, %d) = %q, want %q", s, start, end, got, want)
+			}
+			bad := [][2]int{{-1, L}, {L + 1, -1}, {0, L + 1}, {L + 1, L + 1}}
+			if L > 0 {
+				bad = append(bad, [2]int{L, L - 1})
+			}
+			b := bad[c.slice.bad%len(bad)]
+			if catches(func() { xstrings.Slice(s, b[0], b[1]) }) == nil {
+				fail(ht, "Slice(%q, %d, %d) did not panic (rune length %d)", s, b[0], b[1], L)
+			}
+			ins, at := c.insert.text, c.insert.index(L)
+			if got, want := xstrings.Insert(s, ins, at), string(rs[:at])+ins+string(rs[at:]); got != want {
+				fail(ht, "Insert(%q, %q, %d) = %q, want %q", s, ins, at, got, want)
+			}
+			if catches(func() { xstrings.Insert(s, ins, c.insert.badIndex(L)) }) == nil {
+				fail(ht, "Insert out of range did not panic")
+			}
+		}
+
+		checkScrub(ht, s, c.repl, shapeIf(hasFFFD(s), "xstrings/1"))
+		checkWords(ht, s, shapeIf(hasMisclassifiedHan(s), "xstrings/2"))
+
+		// Width.
+		total := 0
+		for _, r := range rs {
+			w := xstrings.RuneWidth(r)
+			if want := widthModel(r); w != want {
+				fail(ht, "RuneWidth(%q) = %d, documented table %d", r, w, want)
+			}
+			total += w
+		}
+		if got := xstrings.Width(s); got != total {
+			fail(ht, "Width(%q) = %d, sum of rune widths %d", s, got, total)
+		}
+		if got, want := xstrings.Len(s), L; got != want {
+			fail(ht, "Len(%q) = %d, want %d", s, got, want)
+		}
+
+		// Shuffle: a permutation of the runes; ShuffleSource is deterministic.
+		if valid {
+			sorted := func(x string) string {
+				xr := runes(x)
+				sort.Slice(xr, func(i, j int) bool { return xr[i] < xr[j] })
+				return string(xr)
+			}
+			if got := xstrings.Shuffle(s); sorted(got) != sorted(s) {
+				fail(ht, "Shuffle(%q) = %q is not a permutation", s, got)
+			}
+			a := xstrings.ShuffleSource(s, rand.NewSource(c.seed))
+			b := xstrings.ShuffleSource(s, rand.NewSource(c.seed))
+			if a != b {
+				fail(ht, "ShuffleSource(%q) with the same seed gave %q and %q", s, a, b)
+			}
+			if sorted(a) != sorted(s) {
+				fail(ht, "ShuffleSource(%q) = %q is not a permutation", s, a)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: the case conversions.
+
+// wordishBuckets: letters, digits and connectors, the input the case
+// conversions are for; with extras, Latin and Greek/Cyrillic letters and a
+// little punctuation too.
+func wordishBuckets(extras bool) [][]rune {
+	bs := [][]rune{lowerASCII, upperASCII, digits, []rune("-_ "), []rune("_")}
+	if extras {
+		bs = append(bs, latin, greekCyr, punctASCII[:4])
+	}
+	return bs
+}
+
+// convertTexts: a string of a word-like alphabet 60% of the time (with the
+// extras 30% of that), else of a drawn alphabet; under HEGEL_NO_KNOWN=1
+// filtered so that no last word is a lone capital (xstrings/3) and no
+// connector sits inside a punctuation run (xstrings/4).
+var convertTexts = func() hegel.Generator[string] {
+	buckets := weighted(
+		choice[[][]rune]{60, hegel.Map(chance(30), wordishBuckets)},
+		choice[[][]rune]{40, hegel.Map(alphabets, func(a alphabetSpec) [][]rune { return a.buckets(allRunes) })},
+	)
+	texts := hegel.FlatMap(buckets, func(bs [][]rune) hegel.Generator[string] { return textsOf(bs, 24) })
+	if Known.camelLowersLastLetter || Known.punctAdjacentConnector {
+		texts = hegel.Filter(texts, func(s string) bool {
+			return !(Known.camelLowersLastLetter && lastWordIsOneUpperLetter(s)) && !(Known.punctAdjacentConnector && connectorInPunctRun(s))
+		})
+	}
+	return texts
+}()
+
+// checkSnakeKebab: kebab is snake with the other connector, and neither has
+// upper case letters, spaces or the other connector.
+func checkSnakeKebab(ht *hegel.T, s, snake, kebab string, shape []string) {
+	if strings.ReplaceAll(snake, "_", "-") != kebab {
+		mismatch(ht, shape, "ToKebabCase(%q) = %q, ToSnakeCase gives %q", s, kebab, snake)
+	}
+	for _, r := range snake {
+		if unicode.IsUpper(r) {
+			fail(ht, "ToSnakeCase(%q) = %q keeps the upper case letter %q", s, snake, r)
+		}
+		if r == '-' || unicode.IsSpace(r) {
+			mismatch(ht, shape, "ToSnakeCase(%q) = %q keeps the separator %q", s, snake, r)
+		}
+	}
+}
+
+// checkCamelPascal: camel and pascal differ only in the case of the first
+// non-connector rune, and nothing before it changes.
+func checkCamelPascal(ht *hegel.T, s, camel, pascal string, shape []string) {
+	cr, pr := runes(camel), runes(pascal)
+	first := -1
+	for i, r := range runes(s) {
+		if !(r == '-' || r == '_' || unicode.IsSpace(r)) {
+			first = i
+			break
+		}
+	}
+	if first < 0 {
+		if camel != s || pascal != s {
+			fail(ht, "connector-only %q: ToCamelCase %q ToPascalCase %q", s, camel, pascal)
+		}
+		return
+	}
+	if len(cr) != len(pr) || len(cr) <= first {
+		mismatch(ht, shape, "ToCamelCase(%q) = %q and ToPascalCase %q differ in length", s, camel, pascal)
+	}
+	for i := range cr {
+		if i == first {
+			r := runes(s)[first]
+			if cr[i] != unicode.ToLower(r) || pr[i] != unicode.ToUpper(r) {
+				mismatch(ht, shape, "first word rune %q: ToCamelCase gives %q, ToPascalCase %q", r, cr[i], pr[i])
+			}
+			continue
+		}
+		if cr[i] != pr[i] {
+			mismatch(ht, shape, "ToCamelCase(%q) = %q and ToPascalCase %q differ at rune %d", s, camel, pascal, i)
+		}
+	}
+	// Nothing before the first word changes.
+	if string(cr[:first]) != string(runes(s)[:first]) {
+		mismatch(ht, shape, "ToCamelCase(%q) = %q changed the leading connectors", s, camel)
+	}
+}
+
+func TestHegelCaseConversions(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, convertTexts)
+
+		camel := xstrings.ToCamelCase(s)
+		pascal := xstrings.ToPascalCase(s)
+		snake := xstrings.ToSnakeCase(s)
+		kebab := xstrings.ToKebabCase(s)
+		note(ht, "camel = %q pascal = %q snake = %q kebab = %q", camel, pascal, snake, kebab)
+		punctShape := shapeIf(connectorInPunctRun(s), "xstrings/4")
+		camelShape := shapeIf(lastWordIsOneUpperLetter(s), "xstrings/3")
+
+		for name, out := range map[string]string{"ToCamelCase": camel, "ToPascalCase": pascal, "ToSnakeCase": snake, "ToKebabCase": kebab} {
+			if !utf8.ValidString(out) {
+				fail(ht, "%s(%q) = %q is not valid UTF-8", name, s, out)
+			}
+			// The letters and digits are all still there, in order, up to case.
+			if foldCase(stripConnectors(out)) != foldCase(stripConnectors(s)) {
+				fail(ht, "%s(%q) = %q: the non-connector content changed (%q vs %q)", name, s, out, stripConnectors(out), stripConnectors(s))
+			}
+		}
+		// Idempotence of the lower-case forms (the camel forms are not
+		// idempotent by design: a double connector loses one per pass, and
+		// an all-caps first word is lowered; see the README).
+		if got := xstrings.ToSnakeCase(snake); got != snake {
+			fail(ht, "ToSnakeCase is not idempotent: %q -> %q -> %q", s, snake, got)
+		}
+		if got := xstrings.ToKebabCase(kebab); got != kebab {
+			fail(ht, "ToKebabCase is not idempotent: %q -> %q -> %q", s, kebab, got)
+		}
+		checkSnakeKebab(ht, s, snake, kebab, punctShape)
+		checkCamelPascal(ht, s, camel, pascal, camelShape)
+		// The snake form has no upper case at all, so lowering it is a no-op,
+		// and a snake or kebab input is a fixed point of both.
+		if strings.ToLower(snake) != snake {
+			fail(ht, "ToSnakeCase(%q) = %q is not lower case", s, snake)
+		}
+
+		// FirstRuneToUpper/Lower change only the first rune, as documented.
+		up := xstrings.FirstRuneToUpper(s)
+		lo := xstrings.FirstRuneToLower(s)
+		if s == "" {
+			if up != "" || lo != "" {
+				fail(ht, "FirstRuneTo* of \"\" = %q %q", up, lo)
+			}
+		} else {
+			r, size := utf8.DecodeRuneInString(s)
+			rest := s[size:]
+			wantUp, wantLo := s, s
+			if unicode.IsLower(r) {
+				wantUp = string(unicode.ToUpper(r)) + rest
+			}
+			if unicode.IsUpper(r) {
+				wantLo = string(unicode.ToLower(r)) + rest
+			}
+			if up != wantUp {
+				fail(ht, "FirstRuneToUpper(%q) = %q, want %q", s, up, wantUp)
+			}
+			if lo != wantLo {
+				fail(ht, "FirstRuneToLower(%q) = %q, want %q", s, lo, wantLo)
+			}
+		}
+	})
+}
