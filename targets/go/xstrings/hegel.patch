+// ---------------------------------------------------------------------------
+// The documented samples, verbatim.
+
+func TestHegelDocumentedSamples(t *testing.T) {
+	type sample struct {
+		name string
+		got  string
+		want string
+	}
+	samples := []sample{
+		{"ToCamelCase(some_words)", xstrings.ToCamelCase("some_words"), "someWords"},
+		{"ToCamelCase(http_server)", xstrings.ToCamelCase("http_server"), "httpServer"},
+		{"ToCamelCase(no_https)", xstrings.ToCamelCase("no_https"), "noHttps"},
+		{"ToCamelCase(_complex__case_)", xstrings.ToCamelCase("_complex__case_"), "_complex_Case_"},
+		{"ToCamelCase(some words)", xstrings.ToCamelCase("some words"), "someWords"},
+		{"ToCamelCase(GOLANG_IS_GREAT)", xstrings.ToCamelCase("GOLANG_IS_GREAT"), "golangIsGreat"},
+		{"ToPascalCase(some_words)", xstrings.ToPascalCase("some_words"), "SomeWords"},
+		{"ToPascalCase(_complex__case_)", xstrings.ToPascalCase("_complex__case_"), "_Complex_Case_"},
+		{"ToPascalCase(GOLANG_IS_GREAT)", xstrings.ToPascalCase("GOLANG_IS_GREAT"), "GolangIsGreat"},
+		{"ToSnakeCase(FirstName)", xstrings.ToSnakeCase("FirstName"), "first_name"},
+		{"ToSnakeCase(HTTPServer)", xstrings.ToSnakeCase("HTTPServer"), "http_server"},
+		{"ToSnakeCase(NoHTTPS)", xstrings.ToSnakeCase("NoHTTPS"), "no_https"},
+		{"ToSnakeCase(GO_PATH)", xstrings.ToSnakeCase("GO_PATH"), "go_path"},
+		{"ToSnakeCase(GO PATH)", xstrings.ToSnakeCase("GO PATH"), "go_path"},
+		{"ToSnakeCase(GO-PATH)", xstrings.ToSnakeCase("GO-PATH"), "go_path"},
+		{"ToSnakeCase(http2xx)", xstrings.ToSnakeCase("http2xx"), "http_2xx"},
+		{"ToSnakeCase(HTTP20xOK)", xstrings.ToSnakeCase("HTTP20xOK"), "http_20x_ok"},
+		{"ToSnakeCase(Duration2m3s)", xstrings.ToSnakeCase("Duration2m3s"), "duration_2m3s"},
+		{"ToSnakeCase(Bld4Floor3rd)", xstrings.ToSnakeCase("Bld4Floor3rd"), "bld4_floor_3rd"},
+		{"ToKebabCase(HTTP20xOK)", xstrings.ToKebabCase("HTTP20xOK"), "http-20x-ok"},
+		{"ToKebabCase(Bld4Floor3rd)", xstrings.ToKebabCase("Bld4Floor3rd"), "bld4-floor-3rd"},
+		{"Successor(abcd)", xstrings.Successor("abcd"), "abce"},
+		{"Successor(THX1138)", xstrings.Successor("THX1138"), "THX1139"},
+		{"Successor(<<koala>>)", xstrings.Successor("<<koala>>"), "<<koalb>>"},
+		{"Successor(1999zzz)", xstrings.Successor("1999zzz"), "2000aaa"},
+		{"Successor(ZZZ9999)", xstrings.Successor("ZZZ9999"), "AAAA0000"},
+		{"Successor(***)", xstrings.Successor("***"), "**+"},
+		{"Successor(8a_9)", xstrings.Successor("8a_9"), "8a_10"},
+		{"ExpandTabs 1", xstrings.ExpandTabs("a\tbc\tdef\tghij\tk", 4), "a   bc  def ghij    k"},
+		{"ExpandTabs 2", xstrings.ExpandTabs("abcdefg\thij\nk\tl", 4), "abcdefg hij\nk   l"},
+		{"ExpandTabs 3", xstrings.ExpandTabs("z\u4e2d\t\u6587\tw", 4), "z\u4e2d \u6587  w"},
+		{"LeftJustify(hello, 4)", xstrings.LeftJustify("hello", 4, " "), "hello"},
+		{"LeftJustify(hello, 10)", xstrings.LeftJustify("hello", 10, " "), "hello     "},
+		{"LeftJustify(hello, 10, 123)", xstrings.LeftJustify("hello", 10, "123"), "hello12312"},
+		{"RightJustify(hello, 10, 123)", xstrings.RightJustify("hello", 10, "123"), "12312hello"},
+		{"Center(hello, 10)", xstrings.Center("hello", 10, " "), "  hello   "},
+		{"Center(hello, 10, 123)", xstrings.Center("hello", 10, "123"), "12hello123"},
+		{"Translate(hello, aeiou, 12345)", xstrings.Translate("hello", "aeiou", "12345"), "h2ll4"},
+		{"Translate(hello, a-z, A-Z)", xstrings.Translate("hello", "a-z", "A-Z"), "HELLO"},
+		{"Translate(hello, z-a, a-z)", xstrings.Translate("hello", "z-a", "a-z"), "svool"},
+		{"Translate(hello, aeiou, *)", xstrings.Translate("hello", "aeiou", "*"), "h*ll*"},
+		{"Translate(hello, ^l, *)", xstrings.Translate("hello", "^l", "*"), "**ll*"},
+		{"Translate(hello ^ world, \\^lo, *)", xstrings.Translate("hello ^ world", `\^lo`, "*"), "he*** * w*r*d"},
+		{"Delete(hello, aeiou)", xstrings.Delete("hello", "aeiou"), "hll"},
+		{"Delete(hello, a-k)", xstrings.Delete("hello", "a-k"), "llo"},
+		{"Delete(hello, ^a-k)", xstrings.Delete("hello", "^a-k"), "he"},
+		{"Squeeze(hello)", xstrings.Squeeze("hello", ""), "helo"},
+		{"Squeeze(hello, m-z)", xstrings.Squeeze("hello", "m-z"), "hello"},
+		{"Squeeze(hello   world, space)", xstrings.Squeeze("hello   world", " "), "hello world"},
+	}
+	for _, sm := range samples {
+		if sm.got != sm.want {
+			t.Errorf("%s = %q, documented %q", sm.name, sm.got, sm.want)
+		}
+	}
+}
