+package gonja_test
+
+// Generated contexts, expressions and templates. Every expression carries a
+// kind so that the filters, tests and operators applied to it are ones
+// Jinja2 accepts for that type; the gates in Known keep the generator away
+// from the shapes recorded as bugs.
+//
+// Jinja2 precedence, which the shapes below respect: filters and tests bind
+// to the primary in front of them (1 + 2|abs is 1 + abs(2), and 1 + 2 is odd
+// is 1 + (2 is odd)); ~ binds tighter than + and -; comparisons and in are
+// lower than all arithmetic; a conditional expression is lowest. Operands
+// where the library disagrees are parenthesised (wrap).
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type vk int
+
+const (
+	kInt vk = iota
+	kFloat
+	kStr
+	kBool
+	kListInt
+	kListStr
+	kDict // string keys, int values
+	kNone
+)
+
+func (k vk) String() string {
+	return [...]string{"int", "float", "str", "bool", "list[int]", "list[str]", "dict", "none"}[k]
+}
+
+var (
+	// strings without quotes, backslashes or control characters, so that
+	// Python's repr and the library's print of a list element agree
+	// (Known.listReprEscapes)
+	strPool = []string{"", "a", "b", "abc", "Hello World", "hello world", "x y  z", "  padded  ", "a,b,c", "1", "42", "3.5", "-7", "true", "None", "A-B", "foo_bar", "MiXeD", "aaa", "ab ab", "<b>&amp;</b>", "été", "日本語", "  ", "0", "007", "a b c d e", "CamelCase", "x1y2"}
+	// the ASCII part of strPool, for byte-sensitive operations (Known.byteIndexing)
+	asciiStrPool = []string{"", "a", "b", "abc", "Hello World", "hello world", "x y  z", "  padded  ", "a,b,c", "1", "42", "3.5", "-7", "true", "None", "A-B", "foo_bar", "MiXeD", "aaa", "ab ab", "<b>&amp;</b>", "  ", "0", "007", "a b c d e", "CamelCase", "x1y2"}
+	// non-empty ASCII strings, receivers of find and zfill (Known.findEmpty, zfillEmptyPanics)
+	nonEmptyASCIIPool = []string{"a", "b", "abc", "Hello World", "hello world", "x y  z", "  padded  ", "a,b,c", "1", "42", "-7", "A-B", "foo_bar", "MiXeD", "aaa", "ab ab", "  ", "0", "007", "CamelCase", "x1y2"}
+	// strings with a cased letter, for the upper and lower tests (Known.upperLowerUncased)
+	casedPool = []string{"a", "abc", "Hello World", "hello world", "A-B", "MiXeD", "ABC", "x1y2", "aB", "ab ab"}
+	// strings for str methods' arguments (prefixes, separators, substrings)
+	subPool = []string{"a", "b", "ab", " ", ",", "-", "x", "l", "1", "", "He", "ld", "o W"}
+	// list elements
+	elemPool      = []string{"a", "b", "abc", "Hello", "x y", "", "B", "é", "10", "2"}
+	asciiElemPool = []string{"a", "b", "abc", "Hello", "x y", "", "B", "10", "2"}
+	floatPool     = []string{"0.5", "1.5", "2.25", "-3.75", "10.0", "0.1", "3.14159", "100.125", "-0.5", "2.0", "7.5", "0.0"}
+	keyPool       = []string{"a", "b", "k", "x", "name", "n"}
+	varNames      = []string{"v", "w", "num", "s", "t", "items", "words", "d", "flag", "z", "q"}
+	textPool      = []string{"Hello ", "x", " - ", "\n", "  ", "a.b", "line\n", "tab\t", "(", ")", "100%", "<p>", "&amp;", "é", "日本", ", ", "\n\n", " end", "[", "]", "'", "\"", "#", "{", "}", " { x } "}
+	// printf-style formats for the format filter, which takes Go's Sprintf
+	// syntax by design: only %s of strings and %d of integers are common
+	// ground (Go prints %!s(int=1) for %s of an integer)
+	fmtPool = []string{"%s-%d", "%d", "%s", "[%s]", "%d%%", "%s=%s", "%5d", "%-3s|", "%03d"}
+	// str.format formats (no conversions, grouping or brace escapes while
+	// Known.formatConversions, formatGrouping and formatBraces)
+	pyFmtPool = []string{"{}", "{}-{}", "{0}{1}", "{1}/{0}", "[{}]", "{:>5}", "{:<4}|", "{:^6}", "{:05d}", "{:.2f}", "{:+d}", "{:x}", "{:e}", "{:%}", "{:>{w}}", "{:d}", "{:5}|"}
+)
+
+// ---------------------------------------------------------------------------
+// Context values.
+
+// pyJSON encodes a context value so that Python sees the same types: floats
+// always carry a point or an exponent.
+func pyJSON(v interface{}) string {
+	switch x := v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		if x {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(x)
+	case float64:
+		return floatLit(x)
+	case string:
+		b, _ := jsonString(x)
+		return b
+	case []interface{}:
+		parts := make([]string, len(x))
+		for i, e := range x {
+			parts[i] = pyJSON(e)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case map[string]interface{}:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			ks, _ := jsonString(k)
+			parts[i] = ks + ": " + pyJSON(x[k])
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	panic(fmt.Sprintf("pyJSON: %T", v))
+}
+
+func jsonString(s string) (string, error) {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\t':
+			b.WriteString(`\t`)
+		case '\r':
+			b.WriteString(`\r`)
+		default:
+			if r < 0x20 {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteRune(r)
+			}
+		}
+	}
+	b.WriteByte('"')
+	return b.String(), nil
+}
+
+// floatLit renders a float the way Python's repr does for the values the
+// generator uses (no exponents).
+func floatLit(f float64) string {
+	s := strconv.FormatFloat(f, 'f', -1, 64)
+	if !strings.ContainsAny(s, ".e") {
+		s += ".0"
+	}
+	return s
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// The generator.
+
+type scope struct {
+	vars  map[string]vk
+	lens  map[string]int      // known lengths of list, string and dict values
+	keys  map[string][]string // known keys of dicts
+	ascii map[string]bool     // string and string-list variables known to be ASCII
+}
+
+func newScope() scope {
+	return scope{vars: map[string]vk{}, lens: map[string]int{}, keys: map[string][]string{}, ascii: map[string]bool{}}
+}
+
+func (s scope) clone() scope {
+	c := newScope()
+	for k, v := range s.vars {
+		c.vars[k] = v
+	}
+	for k, v := range s.lens {
+		c.lens[k] = v
+	}
+	for k, v := range s.keys {
+		c.keys[k] = v
+	}
+	for k, v := range s.ascii {
+		c.ascii[k] = v
+	}
+	return c
+}
+
+type tgen struct {
+	tc     hegel.TestCase
+	ctx    map[string]interface{}
+	sc     scope
+	inLoop int
+	macros []macroDef
+	fresh  int
+	undef  string // a name that is never defined
+	ascii  int    // > 0 while strings must be ASCII (Known.byteIndexing)
+	// > 0 while no str method result may flow into the expression
+	// (Known.methodResultEquality): only context variables and literals
+	noMethod    int
+	filterDepth int  // inside {% filter %} blocks, where an escape would be applied twice
+	plain       int  // > 0 while strings must contain no quotes (they will be printed inside a list, Known.listReprEscapes)
+	lstrip      bool // lstrip_blocks is on: text must not end in blanks after other text (Known.lstripAfterTag)
+}
+
+type macroDef struct {
+	name   string
+	caller bool
+}
+
+func newGen(tc hegel.TestCase) *tgen {
+	g := &tgen{tc: tc, ctx: map[string]interface{}{}, sc: newScope(), undef: "missing"}
+	k := n(tc, 0, 5)
+	for i := 0; i < k; i++ {
+		name := pick(tc, varNames...)
+		if _, ok := g.sc.vars[name]; ok {
+			continue
+		}
+		g.addVar(name, g.value(vk(n(tc, 0, 7))))
+	}
+	return g
+}
+
+// addVar puts a value in the context and records its kind.
+func (g *tgen) addVar(name string, v interface{}) {
+	g.ctx[name] = v
+	switch x := v.(type) {
+	case nil:
+		g.sc.vars[name] = kNone
+	case bool:
+		g.sc.vars[name] = kBool
+	case int:
+		g.sc.vars[name] = kInt
+	case float64:
+		g.sc.vars[name] = kFloat
+	case string:
+		g.sc.vars[name] = kStr
+		g.sc.lens[name] = len([]rune(x))
+		g.sc.ascii[name] = isASCII(x)
+	case []interface{}:
+		ascii := true
+		if len(x) > 0 {
+			if _, ok := x[0].(string); ok {
+				g.sc.vars[name] = kListStr
+				for _, e := range x {
+					ascii = ascii && isASCII(e.(string))
+				}
+			} else {
+				g.sc.vars[name] = kListInt
+			}
+		} else {
+			g.sc.vars[name] = kListInt
+		}
+		g.sc.lens[name] = len(x)
+		g.sc.ascii[name] = ascii
+	case map[string]interface{}:
+		g.sc.vars[name] = kDict
+		g.sc.lens[name] = len(x)
+		var keys []string
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		g.sc.keys[name] = keys
+	}
+}
+
+func (g *tgen) newName() string {
+	g.fresh++
+	return fmt.Sprintf("x%d", g.fresh)
+}
+
+// value draws a context value of a kind.
+func (g *tgen) value(k vk) interface{} {
+	switch k {
+	case kInt:
+		return n(g.tc, -50, 50)
+	case kFloat:
+		f, _ := strconv.ParseFloat(pick(g.tc, floatPool...), 64)
+		return f
+	case kStr:
+		return pick(g.tc, strPool...)
+	case kBool:
+		return chance(g.tc, 50)
+	case kListInt:
+		m := n(g.tc, 1, 5)
+		l := make([]interface{}, m)
+		for i := range l {
+			l[i] = n(g.tc, -9, 20)
+		}
+		return l
+	case kListStr:
+		m := n(g.tc, 1, 4)
+		l := make([]interface{}, m)
+		for i := range l {
+			l[i] = pick(g.tc, elemPool...)
+		}
+		return l
+	case kDict:
+		m := n(g.tc, 1, 3)
+		d := map[string]interface{}{}
+		for i := 0; i < m; i++ {
+			d[pick(g.tc, keyPool...)] = n(g.tc, -5, 30)
+		}
+		return d
+	default:
+		return nil
+	}
+}
+
+// varOf picks a variable of the kind in scope, or "" if none. In ASCII mode
+// only string variables known to be ASCII qualify.
+func (g *tgen) varOf(k vk) string {
+	var names []string
+	for name, vk := range g.sc.vars {
+		if vk != k {
+			continue
+		}
+		if g.ascii > 0 && (k == kStr || k == kListStr) && !g.sc.ascii[name] {
+			continue
+		}
+		if (g.noMethod > 0 || g.plain > 0) && (k == kStr || k == kListStr) {
+			if _, ok := g.ctx[name]; !ok {
+				continue // set, with and loop variables may hold anything
+			}
+		}
+		names = append(names, name)
+	}
+	if len(names) == 0 {
+		return ""
+	}
+	sort.Strings(names)
+	return pick(g.tc, names...)
+}
+
+// ---------------------------------------------------------------------------
+// Literals.
+
+func (g *tgen) strLit(s string) string {
+	if strings.Contains(s, "\n") || strings.Contains(s, "\t") {
+		// escapes in string literals are a separate question
+		s = strings.NewReplacer("\n", " ", "\t", " ").Replace(s)
+	}
+	if strings.Contains(s, "'") {
+		return `"` + s + `"`
+	}
+	if chance(g.tc, 30) && !strings.Contains(s, `"`) {
+		return `"` + s + `"`
+	}
+	return "'" + s + "'"
+}
+
+func (g *tgen) strPoolLit() string {
+	if g.ascii > 0 {
+		return g.strLit(pick(g.tc, asciiStrPool...))
+	}
+	return g.strLit(pick(g.tc, strPool...))
+}
+
+func (g *tgen) intLit() string {
+	return strconv.Itoa(n(g.tc, -20, 20))
+}
+
+func (g *tgen) floatLit() string {
+	return pick(g.tc, floatPool...)
+}
+
+func (g *tgen) boolLit() string {
+	return pick(g.tc, "true", "false", "True", "False")
+}
+
+func (g *tgen) listIntLit() string {
+	m := n(g.tc, 1, 4)
+	parts := make([]string, m)
+	for i := range parts {
+		parts[i] = strconv.Itoa(n(g.tc, -9, 20))
+	}
+	return "[" + strings.Join(parts, g.comma()) + "]"
+}
+
+func (g *tgen) listStrLit() string {
+	m := n(g.tc, 1, 4)
+	parts := make([]string, m)
+	for i := range parts {
+		if g.ascii > 0 {
+			parts[i] = g.strLit(pick(g.tc, asciiElemPool...))
+		} else {
+			parts[i] = g.strLit(pick(g.tc, elemPool...))
+		}
+	}
+	return "[" + strings.Join(parts, g.comma()) + "]"
+}
+
+func (g *tgen) dictLit() string {
+	m := n(g.tc, 1, 3)
+	keys := map[string]bool{}
+	for i := 0; i < m; i++ {
+		keys[pick(g.tc, keyPool...)] = true
+	}
+	var ks []string
+	for k := range keys {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks) // Known.dictOrder: the library prints dicts sorted
+	parts := make([]string, len(ks))
+	for i, k := range ks {
+		parts[i] = g.strLit(k) + ":" + g.sp() + strconv.Itoa(n(g.tc, -5, 30))
+	}
+	if chance(g.tc, 20) && (len(ks) == 1 || !Known.dictOrder) {
+		// dict() with keyword arguments
+		for i, k := range ks {
+			parts[i] = k + "=" + strings.TrimSpace(strings.SplitN(parts[i], ":", 2)[1])
+		}
+		return "dict(" + strings.Join(parts, ", ") + ")"
+	}
+	return "{" + strings.Join(parts, g.comma()) + "}"
+}
+
+func (g *tgen) sp() string {
+	if chance(g.tc, 30) {
+		return " "
+	}
+	return ""
+}
+
+func (g *tgen) comma() string {
+	return pick(g.tc, ", ", ",", " , ")
+}
+
+// ---------------------------------------------------------------------------
+// Shapes.
+
+// atomic reports whether s is a primary: a name, a number, a string literal,
+// a bracketed list or dict, a parenthesised expression, or a call or
+// subscript of one of those (e.g. range(3), 'a'.upper(), d['k']).
+func atomic(s string) bool {
+	if s == "" {
+		return false
+	}
+	if isName(s) || isNumber(s) {
+		return true
+	}
+	// scan: a primary is one token or one bracketed/quoted group possibly
+	// followed by .name, (...) or [...] postfixes
+	i := 0
+	if s[0] == '(' || s[0] == '[' || s[0] == '{' || s[0] == '\'' || s[0] == '"' {
+		j := groupEnd(s, 0)
+		if j < 0 {
+			return false
+		}
+		i = j + 1
+	} else if s[0] == '-' {
+		return false
+	} else {
+		for i < len(s) && (isNameByte(s[i]) || s[i] >= 0x80) {
+			i++
+		}
+		if i == 0 {
+			return false
+		}
+	}
+	for i < len(s) {
+		switch s[i] {
+		case '.':
+			i++
+			for i < len(s) && isNameByte(s[i]) {
+				i++
+			}
+		case '(', '[':
+			j := groupEnd(s, i)
+			if j < 0 {
+				return false
+			}
+			i = j + 1
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func isNameByte(c byte) bool {
+	return c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+}
+
+// groupEnd returns the index of the bracket or quote closing the group that
+// opens at i, or -1.
+func groupEnd(s string, i int) int {
+	if s[i] == '\'' || s[i] == '"' {
+		j := strings.IndexByte(s[i+1:], s[i])
+		if j < 0 {
+			return -1
+		}
+		return i + 1 + j
+	}
+	depth := 0
+	for j := i; j < len(s); j++ {
+		switch s[j] {
+		case '\'', '"':
+			k := strings.IndexByte(s[j+1:], s[j])
+			if k < 0 {
+				return -1
+			}
+			j += k + 1
+		case '(', '[', '{':
+			depth++
+		case ')', ']', '}':
+			depth--
+			if depth == 0 {
+				return j
+			}
+		}
+	}
+	return -1
+}
+
+func isName(s string) bool {
+	for i, r := range s {
+		if !(r == '_' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || i > 0 && r >= '0' && r <= '9') {
+			return false
+		}
+	}
+	return s != ""
+}
+
+func isNumber(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if !(r >= '0' && r <= '9' || r == '.') {
+			return false
+		}
+	}
+	return true
+}
+
+// wrap parenthesises anything that is not a primary.
+func wrap(s string) string {
+	if atomic(s) {
+		return s
+	}
+	return "(" + s + ")"
+}
+
+// recv wraps a method receiver: while Known.filterResultMethods the library
+// cannot call methods on any parenthesised expression, so the receiver has
+// to be an unparenthesised primary already; otherwise wrap.
+func (g *tgen) recv(s string) string {
+	if atomic(s) && s[0] != '(' {
+		return s
+	}
+	if Known.filterResultMethods {
+		return g.strPoolLit()
+	}
+	return "(" + s + ")"
+}
+
+// compared draws an expression of the kind for a comparison, in or test
+// operand: while Known.methodResultEquality nothing a str method returned
+// may reach it.
+func (g *tgen) compared(k vk, d int) string {
+	if Known.methodResultEquality {
+		g.noMethod++
+		defer func() { g.noMethod-- }()
+	}
+	return g.expr(k, d)
+}
+
+// ---------------------------------------------------------------------------
+// Typed expressions.
+
+func (g *tgen) expr(k vk, d int) string {
+	switch k {
+	case kInt:
+		return g.intE(d)
+	case kFloat:
+		return g.floatE(d)
+	case kStr:
+		return g.strE(d)
+	case kBool:
+		return g.boolE(d)
+	case kListInt:
+		return g.listIntE(d)
+	case kListStr:
+		return g.listStrE(d)
+	case kDict:
+		return g.dictE(d)
+	default:
+		return pick(g.tc, "none", "None")
+	}
+}
+
+// printable draws an expression whose printed form the library and Jinja2
+// are expected to agree on (no None). At depth 0 it may be a conditional
+// expression, which the library only parses at the top level
+// (Known.condexprNested).
+func (g *tgen) printable(d int) (string, vk) {
+	k := vk(n(g.tc, 0, 6))
+	if d == 0 && k != kBool && k != kDict && chance(g.tc, 12) {
+		return g.expr(k, 1) + " if " + g.boolE(1) + " else " + g.expr(k, 1), k
+	}
+	return g.expr(k, d), k
+}
+
+// mixed draws a printable expression; in plain mode only scalars, whose
+// text has no quotes.
+func (g *tgen) mixed(d int) (string, vk) {
+	if g.plain > 0 {
+		k := vk(n(g.tc, 0, 3))
+		return g.expr(k, d), k
+	}
+	return g.printable(d)
+}
+
+// plainStrE draws a string expression whose value has no quotes.
+func (g *tgen) plainStrE(d int) string {
+	g.plain++
+	defer func() { g.plain-- }()
+	return g.strE(d)
+}
+
+// atom draws a literal or a variable of the kind.
+func (g *tgen) atom(k vk) string {
+	if v := g.varOf(k); v != "" && chance(g.tc, 50) {
+		return v
+	}
+	switch k {
+	case kInt:
+		return g.intLit()
+	case kFloat:
+		return g.floatLit()
+	case kStr:
+		return g.strPoolLit()
+	case kBool:
+		return g.boolLit()
+	case kListInt:
+		return g.listIntLit()
+	case kListStr:
+		return g.listStrLit()
+	case kDict:
+		return g.dictLit()
+	}
+	return "none"
+}
+
+// nonEmptyList draws a list expression known to have at least one element.
+func (g *tgen) nonEmptyList(k vk) string {
+	if v := g.varOf(k); v != "" && g.sc.lens[v] > 0 && chance(g.tc, 50) {
+		return v
+	}
+	if k == kListStr {
+		return g.listStrLit()
+	}
+	return g.listIntLit()
+}
+
+// divisor draws a small non-zero integer literal.
+func (g *tgen) divisor() string {
+	return strconv.Itoa(pick(g.tc, 1, 2, 3, 4, 5, 7, 9, 10))
+}
+
+// nonNeg draws an integer expression that is never negative.
+func (g *tgen) nonNeg(d int) string {
+	switch n(g.tc, 1, 3) {
+	case 1:
+		return strconv.Itoa(n(g.tc, 0, 20))
+	case 2:
+		return wrap(g.intE(d+1)) + "|abs"
+	default:
+		return g.strE(d+1) + "|length"
+	}
+}
+
+func (g *tgen) intE(d int) string {
+	if d > 2 {
+		return g.atom(kInt)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 22:
+		return g.atom(kInt)
+	case r <= 34:
+		return g.intE(d+1) + " " + pick(g.tc, "+", "-", "*") + " " + g.intE(d+1)
+	case r <= 40:
+		op := pick(g.tc, "//", "%")
+		l := g.intE(d + 1)
+		if Known.floorDivModNegative {
+			l = wrap(l) + "|abs"
+		}
+		return "(" + l + " " + op + " " + g.divisor() + ")"
+	case r <= 44:
+		a := g.atom(kInt)
+		if strings.HasPrefix(a, "-") && Known.doubleMinus {
+			return "-(" + a + ")"
+		}
+		return "-" + a
+	case r <= 48:
+		return "(" + g.intE(d+1) + ")"
+	case r <= 56:
+		switch n(g.tc, 1, 4) {
+		case 1:
+			return wrap(g.strE(d+1)) + "|length"
+		case 2:
+			return wrap(g.listE(d+1)) + "|" + pick(g.tc, "length", "count")
+		case 3:
+			return g.dictE(d+1) + "|length"
+		default:
+			if Known.wordcountWords {
+				return g.strLit(pick(g.tc, "a b", "Hello World", "x y  z", "", "aaa")) + "|wordcount"
+			}
+			return g.strE(d+1) + "|wordcount"
+		}
+	case r <= 62:
+		switch n(g.tc, 1, 3) {
+		case 1:
+			return wrap(g.floatE(d+1)) + "|int"
+		case 2:
+			return g.strLit(pick(g.tc, "42", "-7", "0", "1", "abc", "", " 3 ", "+5", "1_0")) + "|int"
+		default:
+			return wrap(g.intE(d+1)) + "|int"
+		}
+	case r <= 70:
+		l := g.nonEmptyList(kListInt)
+		return l + "|" + pick(g.tc, "sum", "min", "max", "first", "last")
+	case r <= 74:
+		return g.listIntE(d+1) + "|sum"
+	case r <= 78:
+		return wrap(g.intE(d+1)) + "|abs"
+	case r <= 84 && g.inLoop > 0:
+		if g.inLoop == 1 || !Known.loopDepth {
+			return "loop." + pick(g.tc, "index", "index0", "revindex", "revindex0", "length", "depth", "depth0")
+		}
+		return "loop." + pick(g.tc, "index", "index0", "revindex", "revindex0", "length")
+	case r <= 88:
+		if g.noMethod > 0 {
+			return g.atom(kInt)
+		}
+		s := g.recv(g.strE(d + 1))
+		if Known.findEmpty || Known.byteIndexing {
+			s = g.strLit(pick(g.tc, nonEmptyASCIIPool...))
+		}
+		if Known.countMethod {
+			return s + "." + pick(g.tc, "find", "rfind") + "(" + g.strLit(pick(g.tc, subPool...)) + ")"
+		}
+		return s + "." + pick(g.tc, "count", "find", "rfind") + "(" + g.strLit(pick(g.tc, subPool...)) + ")"
+	case r <= 92:
+		if v := g.varOf(kDict); v != "" && len(g.sc.keys[v]) > 0 {
+			k := pick(g.tc, g.sc.keys[v]...)
+			if chance(g.tc, 50) {
+				return v + "[" + g.strLit(k) + "]"
+			}
+			return v + "." + k
+		}
+		return g.atom(kInt)
+	case r <= 96:
+		if v := g.varOf(kListInt); v != "" && g.sc.lens[v] > 0 {
+			lo := -g.sc.lens[v]
+			if Known.firstNegativeIndex {
+				lo++
+			}
+			i := n(g.tc, lo, g.sc.lens[v]-1)
+			return v + "[" + strconv.Itoa(i) + "]"
+		}
+		return g.listIntLit() + "[0]"
+	default:
+		if Known.rangeChannel {
+			return "range(" + strconv.Itoa(n(g.tc, 0, 6)) + ")|list|length"
+		}
+		return "range(" + strconv.Itoa(n(g.tc, 0, 6)) + ")|length"
+	}
+}
+
+func (g *tgen) floatE(d int) string {
+	if d > 2 {
+		return g.atom(kFloat)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 25:
+		return g.atom(kFloat)
+	case r <= 40:
+		return g.numE(d+1) + " / " + pick(g.tc, "2", "4", "5", "0.5", "1.5", "8", "3")
+	case r <= 52:
+		return g.numE(d+1) + " " + pick(g.tc, "+", "-", "*") + " " + g.floatE(d+1)
+	case r <= 58:
+		return wrap(g.intE(d+1)) + "|float"
+	case r <= 64:
+		return wrap(g.floatE(d+1)) + "|abs"
+	case r <= 68:
+		a := g.atom(kFloat)
+		if strings.HasPrefix(a, "-") && Known.doubleMinus {
+			return "-(" + a + ")"
+		}
+		return "-" + a
+	case r <= 80:
+		p := n(g.tc, 0, 2)
+		if lit := pick(g.tc, floatPool...); halfSafe(lit, p) || !Known.roundHalfEven {
+			if p == 0 && chance(g.tc, 50) {
+				return lit + "|round"
+			}
+			return lit + "|round(" + strconv.Itoa(p) + ")"
+		}
+		m := pick(g.tc, "floor", "ceil")
+		x := wrap(g.floatE(d + 1))
+		if m == "ceil" && Known.roundNegativeZero {
+			x += "|abs"
+		}
+		return x + "|round(" + strconv.Itoa(p) + ", " + g.strLit(m) + ")"
+	case r <= 86:
+		return g.strLit(pick(g.tc, "3.5", "-7", "42", "0.25", "1e2", "1_0")) + "|float"
+	case r <= 92:
+		// Go's Pow multiplies x*x*x for ** 3 (two roundings), C's pow rounds
+		// once: only exponents both compute with one rounding
+		return wrap(g.floatE(d+1)) + " ** " + pick(g.tc, "2", "0", "1", "-1")
+	default:
+		return "(" + g.floatE(d+1) + ")"
+	}
+}
+
+// halfSafe reports whether rounding lit to p digits meets no exact half.
+func halfSafe(lit string, p int) bool {
+	i := strings.IndexByte(lit, '.')
+	if i < 0 {
+		return true
+	}
+	frac := lit[i+1:]
+	if len(frac) <= p {
+		return true
+	}
+	return frac[p] != '5' || strings.Trim(frac[p+1:], "0") != ""
+}
+
+// numE draws an int or a float.
+func (g *tgen) numE(d int) string {
+	if chance(g.tc, 50) {
+		return g.intE(d)
+	}
+	return g.floatE(d)
+}
+
+// asciiStrE draws a string expression whose value is ASCII.
+func (g *tgen) asciiStrE(d int) string {
+	g.ascii++
+	defer func() { g.ascii-- }()
+	return g.strE(d)
+}
+
+func (g *tgen) strE(d int) string {
+	if d > 2 {
+		return g.atom(kStr)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 18:
+		return g.atom(kStr)
+	case r <= 26:
+		x, _ := g.mixed(d + 1)
+		return g.strE(d+1) + " ~ " + wrap(x)
+	case r <= 30:
+		a, b := g.strE(d+1), g.strE(d+1)
+		if strings.Contains(a, "tojson") || strings.Contains(b, "tojson") {
+			return a + " ~ " + b // Markup: + escapes the other operand in Jinja2
+		}
+		return a + " + " + b
+	case r <= 33:
+		if Known.seqRepeat {
+			return g.strE(d+1) + " + " + g.strE(d+1)
+		}
+		return g.strE(d+1) + " * " + strconv.Itoa(n(g.tc, 0, 3))
+	case r <= 48:
+		// e, escape, forceescape and safe return Markup in Jinja2, which the
+		// library does not model (README: escaping is applied immediately);
+		// they are applied last, in print (escaped)
+		fs := []string{"upper", "lower", "capitalize", "trim", "string"}
+		if !Known.titleWords {
+			fs = append(fs, "title")
+		}
+		if !Known.striptagsEntities {
+			fs = append(fs, "striptags")
+		}
+		if !Known.urlencodeReserved {
+			fs = append(fs, "urlencode")
+		}
+		if !Known.pprintQuotes {
+			fs = append(fs, "pprint")
+		}
+		f := pick(g.tc, fs...)
+		return wrap(g.strE(d+1)) + "|" + f
+	case r <= 51:
+		if Known.byteIndexing {
+			return wrap(g.asciiStrE(d+1)) + "|reverse"
+		}
+		return wrap(g.strE(d+1)) + "|reverse"
+	case r <= 57:
+		s := wrap(g.strE(d + 1))
+		switch n(g.tc, 1, 6) {
+		case 1:
+			return s + "|replace(" + g.strLit(pick(g.tc, subPool...)) + ", " + g.strLit(pick(g.tc, subPool...)) + ")"
+		case 2:
+			if Known.centerBias {
+				return s + "|indent(" + strconv.Itoa(n(g.tc, 0, 4)) + ", true)"
+			}
+			return s + "|center(" + strconv.Itoa(n(g.tc, 0, 12)) + ")"
+		case 3:
+			return s + "|indent(" + strconv.Itoa(n(g.tc, 0, 4)) + ")"
+		case 4:
+			args := pick(g.tc, "", ", true", ", false", ", true, '..'", ", false, '', 0")
+			if Known.truncateWhitespace {
+				args = pick(g.tc, ", true", ", true, '..'", ", true, '', 0")
+			}
+			return s + "|truncate(" + strconv.Itoa(n(g.tc, 3, 12)) + args + ")"
+		case 5:
+			if Known.wordwrapLongWords {
+				return s + "|truncate(" + strconv.Itoa(n(g.tc, 3, 12)) + ", true)"
+			}
+			return s + "|wordwrap(" + strconv.Itoa(n(g.tc, 1, 8)) + ")"
+		default:
+			return s + "|trim(" + g.strLit(pick(g.tc, subPool...)) + ")"
+		}
+	case r <= 62:
+		x, k := g.mixed(d + 1)
+		if (k == kInt || k == kBool || k == kStr || k == kFloat && !Known.tojsonFloat) && g.plain == 0 {
+			if chance(g.tc, 30) {
+				if k == kStr && Known.tojsonNonASCII {
+					return wrap(g.asciiStrE(d+1)) + "|tojson"
+				}
+				return wrap(x) + "|tojson"
+			}
+		}
+		return wrap(x) + "|string"
+	case r <= 67:
+		l := g.listE(d + 1)
+		return l + "|join(" + g.strLit(pick(g.tc, subPool...)) + ")"
+	case r <= 71:
+		s := wrap(g.strE(d + 1))
+		switch n(g.tc, 1, 3) {
+		case 1:
+			// Jinja2's first and last of an empty string are Undefined
+			return g.strLit(pick(g.tc, nonEmptyASCIIPool...)) + "|" + pick(g.tc, "first", "last")
+		case 2:
+			if Known.byteIndexing {
+				s = g.recv(g.asciiStrE(d + 1))
+			}
+			return s + "[" + strconv.Itoa(n(g.tc, -3, 3)) + ":" + strconv.Itoa(n(g.tc, -3, 6)) + "]"
+		default:
+			if Known.byteIndexing {
+				s = g.recv(g.asciiStrE(d + 1))
+			}
+			return s + "[" + pick(g.tc, "1:", ":2", "::2", "::-1", "-2:", ":-1") + "]"
+		}
+	case r <= 75:
+		f := pick(g.tc, fmtPool...)
+		return g.strLit(f) + "|format(" + g.fmtArgs(f) + ")"
+	case r <= 79:
+		return g.pyFormat(d)
+	case r <= 89:
+		return g.strMethod(d)
+	case r <= 92:
+		return g.strLit(pick(g.tc, subPool...)) + ".join(" + g.listStrE(d+1) + ")"
+	case r <= 94 && g.inLoop > 0:
+		return "loop.cycle(" + g.strLit(pick(g.tc, "odd", "a")) + ", " + g.strLit(pick(g.tc, "even", "b")) + ")"
+	case r <= 97:
+		return g.undef + "|default(" + g.strPoolLit() + ")"
+	default:
+		return wrap(g.intE(d+1)) + "|filesizeformat" + pick(g.tc, "", "(true)")
+	}
+}
+
+// fmtArgs draws arguments matching a printf-style format string: %s of a
+// string or an integer, %d of an integer.
+func (g *tgen) fmtArgs(f string) string {
+	var parts []string
+	for i := 0; i < len(f)-1; i++ {
+		if f[i] != '%' {
+			continue
+		}
+		j := i + 1
+		for j < len(f) && strings.ContainsRune("-0123456789", rune(f[j])) {
+			j++
+		}
+		if j >= len(f) {
+			break
+		}
+		switch f[j] {
+		case 's':
+			parts = append(parts, g.strE(2))
+		case 'd':
+			parts = append(parts, g.intE(2))
+		case '%':
+		}
+		i = j
+	}
+	return strings.Join(parts, ", ")
+}
+
+// pyFormat renders a str.format call with arguments matching its fields.
+func (g *tgen) pyFormat(d int) string {
+	if g.noMethod > 0 {
+		return g.atom(kStr)
+	}
+	if Known.methodResultEquality {
+		g.noMethod++
+		defer func() { g.noMethod-- }()
+	}
+	f := pick(g.tc, pyFmtPool...)
+	var args []string
+	switch {
+	case strings.Contains(f, "{:.2f}") || strings.Contains(f, "{:e}") || strings.Contains(f, "{:%}") || strings.Contains(f, "{:.3}"):
+		args = append(args, g.floatE(d+1))
+	case strings.Contains(f, "{:05d}") || strings.Contains(f, "{:+d}") || strings.Contains(f, "{:x}") || strings.Contains(f, "{:d}") || strings.Contains(f, "{:5}"):
+		args = append(args, g.intE(d+1))
+	case strings.Contains(f, "{w}"):
+		args = append(args, g.strE(d+1), "w="+strconv.Itoa(n(g.tc, 0, 8)))
+	case strings.Contains(f, "{:>5}") || strings.Contains(f, "{:<4}") || strings.Contains(f, "{:^6}"):
+		args = append(args, g.strE(d+1))
+	default:
+		for range strings.Split(f, "{")[1:] {
+			// Known.formatFloat, formatNoneList: {} of an int, str or bool only
+			switch n(g.tc, 1, 3) {
+			case 1:
+				args = append(args, g.intE(d+1))
+			case 2:
+				args = append(args, g.strE(d+1))
+			default:
+				args = append(args, wrap(g.boolE(d+1)))
+			}
+		}
+	}
+	return g.strLit(f) + ".format(" + strings.Join(args, ", ") + ")"
+}
+
+// strMethod renders a str method call returning a string.
+func (g *tgen) strMethod(d int) string {
+	if g.noMethod > 0 {
+		return g.atom(kStr)
+	}
+	s := g.recv(g.strE(d + 1))
+	switch n(g.tc, 1, 13) {
+	case 1:
+		ms := []string{"upper", "lower", "strip", "capitalize", "swapcase", "casefold"}
+		if !Known.titleWords {
+			ms = append(ms, "title")
+		}
+		if !Known.methodOptionalArgs {
+			ms = append(ms, "lstrip", "rstrip")
+		}
+		return s + "." + pick(g.tc, ms...) + "()"
+	case 2:
+		if Known.byteIndexing || Known.zfillEmptyPanics {
+			s = g.strLit(pick(g.tc, nonEmptyASCIIPool...))
+		}
+		return s + ".zfill(" + strconv.Itoa(n(g.tc, 0, 8)) + ")"
+	case 3:
+		m := pick(g.tc, "ljust", "rjust")
+		fill := pick(g.tc, "", ", '*'", ", '-'")
+		if !Known.centerBias && chance(g.tc, 30) {
+			m = "center"
+		}
+		if Known.methodOptionalArgs && fill == "" {
+			fill = ", ' '"
+		}
+		return s + "." + m + "(" + strconv.Itoa(n(g.tc, 0, 10)) + fill + ")"
+	case 4:
+		old := pick(g.tc, subPool...)
+		count := pick(g.tc, "", ", 1", ", 2")
+		if Known.methodOptionalArgs {
+			if old == "" {
+				old = "a"
+			}
+			if count == "" {
+				count = ", 3"
+			}
+		}
+		return s + ".replace(" + g.strLit(old) + ", " + g.strLit(pick(g.tc, subPool...)) + count + ")"
+	case 5:
+		return s + "." + pick(g.tc, "removeprefix", "removesuffix") + "(" + g.strLit(pick(g.tc, subPool...)) + ")"
+	case 6:
+		return s + "." + pick(g.tc, "strip", "lstrip", "rstrip") + "(" + g.strLit(pick(g.tc, subPool...)) + ")"
+	case 7:
+		max := pick(g.tc, "", ", 1")
+		if Known.splitMaxsplit {
+			max = ""
+		}
+		return s + ".split(" + g.strLit(pick(g.tc, subPool[:8]...)) + max + ")|join('|')"
+	case 8:
+		if Known.methodOptionalArgs {
+			return s + ".strip()"
+		}
+		return s + ".expandtabs(" + pick(g.tc, "", "4", "2") + ")"
+	case 9:
+		return s + "." + pick(g.tc, "partition", "rpartition") + "(" + g.strLit(pick(g.tc, subPool...)) + ")|join('|')"
+	case 10:
+		return s + ".format()"
+	case 11:
+		return s + ".splitlines()|join('|')"
+	case 12:
+		return s + ".upper().lower()"
+	default:
+		lit := pick(g.tc, nonEmptyASCIIPool...)
+		if Known.byteIndexing || Known.firstNegativeIndex {
+			s = g.strLit(lit)
+		}
+		lo, hi := -len(lit), len(lit)-1
+		if Known.firstNegativeIndex {
+			lo++
+		}
+		if hi > 2 {
+			hi = 2
+		}
+		if lo < -2 {
+			lo = -2
+		}
+		return s + "[" + strconv.Itoa(n(g.tc, lo, hi)) + "]"
+	}
+}
+
+func (g *tgen) boolE(d int) string {
+	if d > 2 {
+		return g.atom(kBool)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 12:
+		return g.atom(kBool)
+	case r <= 20:
+		x := g.boolE(d + 1)
+		if Known.doubleNot && strings.HasPrefix(x, "not ") {
+			x = "(" + x + ")"
+		}
+		return "not " + x
+	case r <= 30:
+		return g.boolE(d+1) + " " + pick(g.tc, "and", "or") + " " + g.boolE(d+1)
+	case r <= 34:
+		return "(" + g.boolE(d+1) + ")"
+	case r <= 50:
+		op := pick(g.tc, "==", "!=", "<", ">", "<=", ">=")
+		switch n(g.tc, 1, 3) {
+		case 1:
+			return g.numE(d+1) + " " + op + " " + g.numE(d+1)
+		case 2:
+			return g.compared(kStr, d+1) + " " + op + " " + g.compared(kStr, d+1)
+		default:
+			return g.compared(kListInt, d+1) + " " + pick(g.tc, "==", "!=") + " " + g.compared(kListInt, d+1)
+		}
+	case r <= 58:
+		in := pick(g.tc, " in ", " not in ")
+		var lhs, rhs string
+		switch n(g.tc, 1, 3) {
+		case 1:
+			lhs, rhs = g.intE(d+1), g.compared(kListInt, d+1)
+		case 2:
+			lhs, rhs = g.compared(kStr, d+1), g.compared(kStr, d+1)
+		default:
+			lhs, rhs = g.strLit(pick(g.tc, keyPool...)), g.dictE(d+1)
+		}
+		if Known.inRightOperand || Known.inFilterPrecedence {
+			rhs = wrap(rhs)
+		}
+		return wrap(lhs) + in + rhs
+	case r <= 78:
+		return g.testE(d)
+	case r <= 86:
+		s := g.recv(g.strE(d + 1))
+		switch n(g.tc, 1, 3) {
+		case 1:
+			m := pick(g.tc, "startswith", "endswith")
+			if m == "endswith" && Known.endswithEmpty {
+				s = g.strLit(pick(g.tc, nonEmptyASCIIPool...))
+			}
+			return s + "." + m + "(" + g.strLit(pick(g.tc, subPool...)) + ")"
+		case 2:
+			ms := []string{"isdigit", "isalpha", "isupper", "islower", "isspace", "isalnum", "isnumeric", "isdecimal", "isascii", "isprintable"}
+			if !Known.istitleUncased {
+				ms = append(ms, "istitle")
+			}
+			return s + "." + pick(g.tc, ms...) + "()"
+		default:
+			m := "startswith"
+			if !Known.methodOptionalArgs {
+				m = pick(g.tc, "startswith", "endswith")
+			}
+			return s + "." + m + "((" + g.strLit(pick(g.tc, subPool...)) + ", " + g.strLit(pick(g.tc, subPool...)) + "))"
+		}
+	case r <= 92 && g.inLoop > 0:
+		return "loop." + pick(g.tc, "first", "last")
+	default:
+		return g.compared(kStr, d+1) + " " + pick(g.tc, "==", "!=") + " " + g.compared(kStr, d+1)
+	}
+}
+
+// testE draws an `is` test. The operand and the argument are primaries
+// (Known.isPrecedence; Jinja2 itself binds the test to the primary).
+func (g *tgen) testE(d int) string {
+	if Known.methodResultEquality {
+		g.noMethod++
+		defer func() { g.noMethod-- }()
+	}
+	not := pick(g.tc, " is ", " is not ")
+	switch n(g.tc, 1, 12) {
+	case 1:
+		k := vk(n(g.tc, 0, 7))
+		if v := g.varOf(k); v != "" {
+			if k == kNone && Known.noneDefined {
+				return v + not + "none"
+			}
+			return v + not + pick(g.tc, "defined", "undefined", "none")
+		}
+		return g.undef + not + pick(g.tc, "defined", "undefined")
+	case 2:
+		if Known.oddEvenNegative {
+			return wrap(g.nonNeg(d)) + not + pick(g.tc, "odd", "even")
+		}
+		return wrap(g.intE(d+1)) + not + pick(g.tc, "odd", "even")
+	case 3:
+		return wrap(g.intE(d+1)) + not + "divisibleby(" + g.divisor() + ")"
+	case 4:
+		x, k := g.printable(d + 1)
+		ts := []string{"string", "integer", "float", "boolean", "mapping", "iterable", "callable"}
+		if k != kBool || !Known.boolIsNumber {
+			ts = append(ts, "number")
+		}
+		if k == kBool || !Known.trueFalseTests {
+			ts = append(ts, "true", "false")
+		}
+		if k == kListInt || k == kListStr || !Known.sequenceTest {
+			ts = append(ts, "sequence")
+		}
+		return wrap(x) + not + pick(g.tc, ts...)
+	case 5:
+		if Known.upperLowerUncased {
+			return g.strLit(pick(g.tc, casedPool...)) + not + pick(g.tc, "lower", "upper")
+		}
+		return wrap(g.strE(d+1)) + not + pick(g.tc, "lower", "upper")
+	case 6:
+		return wrap(g.numE(d+1)) + not + pick(g.tc, "eq", "ne", "lt", "le", "gt", "ge", "equalto", "greaterthan", "lessthan", "==", "!=", "<", ">", "<=", ">=") + " " + wrap(g.numE(d+1))
+	case 7:
+		return wrap(g.intE(d+1)) + not + "in " + wrap(g.listIntE(d+1))
+	case 8:
+		return wrap(g.boolE(d+1)) + not + "sameas " + g.boolLit()
+	case 9:
+		ts := []string{"eq", "ne", "==", "!=", "equalto"}
+		if !Known.gtOnStrings {
+			ts = append(ts, "lt", "gt", "le", "ge")
+		}
+		return wrap(g.strE(d+1)) + not + pick(g.tc, ts...) + " " + wrap(g.strE(d+1))
+	case 10:
+		if Known.escapedFilterTestTests {
+			return wrap(g.strE(d+1)) + not + "string"
+		}
+		x, _ := g.printable(d + 1)
+		return wrap(x) + not + pick(g.tc, "escaped", "filter", "test")
+	case 11:
+		return wrap(g.strE(d+1)) + not + "in " + wrap(g.strE(d+1))
+	default:
+		return g.expr(kNone, d+1) + not + "none"
+	}
+}
+
+// listE draws a list of either kind.
+func (g *tgen) listE(d int) string {
+	if chance(g.tc, 50) {
+		return g.listIntE(d)
+	}
+	return g.listStrE(d)
+}
+
+func (g *tgen) listIntE(d int) string {
+	if d > 2 {
+		return g.atom(kListInt)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 25:
+		return g.atom(kListInt)
+	case r <= 40:
+		switch n(g.tc, 1, 3) {
+		case 1:
+			return "range(" + strconv.Itoa(n(g.tc, 0, 6)) + ")|list"
+		case 2:
+			return "range(" + strconv.Itoa(n(g.tc, -3, 3)) + ", " + strconv.Itoa(n(g.tc, 0, 8)) + ")|list"
+		default:
+			return "range(" + strconv.Itoa(n(g.tc, 0, 3)) + ", " + strconv.Itoa(n(g.tc, 0, 12)) + ", " + pick(g.tc, "2", "3", "-1", "4") + ")|list"
+		}
+	case r <= 56:
+		fs := []string{"sort", "sort(reverse=true)", "unique|list", "list", "sort(reverse=True)"}
+		if !Known.reverseList {
+			fs = append(fs, "reverse|list")
+		}
+		return g.listIntE(d+1) + "|" + pick(g.tc, fs...)
+	case r <= 66:
+		l := g.listIntE(d + 1)
+		f := pick(g.tc, "select('odd')", "reject('even')", "select('gt', "+g.intLit()+")", "reject('lt', "+g.intLit()+")", "select('divisibleby', "+g.divisor()+")", "select", "reject", "select('ne', "+g.intLit()+")")
+		if Known.oddEvenNegative && (f == "select('odd')" || f == "reject('even')") {
+			l += "|map('abs')|list"
+		}
+		return l + "|" + f + "|list"
+	case r <= 72:
+		return g.listIntE(d+1) + "|map('abs')|list"
+	case r <= 78:
+		return g.listIntE(d+1) + " + " + g.listIntE(d+1)
+	case r <= 86:
+		return g.listIntE(d+1) + "[" + pick(g.tc, "1:", ":2", "::2", "::-1", "-2:", ":-1", "1:3", "0:0") + "]"
+	case r <= 92:
+		return g.listStrE(d+1) + "|map('length')|list"
+	default:
+		return "(" + g.listIntE(d+1) + ")"
+	}
+}
+
+func (g *tgen) listStrE(d int) string {
+	if d > 2 {
+		return g.atom(kListStr)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 25:
+		return g.atom(kListStr)
+	case r <= 40:
+		if g.noMethod > 0 {
+			return g.atom(kListStr)
+		}
+		return g.recv(g.plainStrE(d+1)) + ".split(" + g.strLit(pick(g.tc, subPool[:8]...)) + ")"
+	case r <= 56:
+		fs := []string{"sort", "sort(reverse=true)", "sort(case_sensitive=true)", "list"}
+		if !Known.reverseList {
+			fs = append(fs, "reverse|list")
+		}
+		l := g.listStrE(d + 1)
+		if chance(g.tc, 30) {
+			// unique compares elements (Known.methodResultEquality)
+			return g.compared(kListStr, d+1) + "|" + pick(g.tc, "unique|list", "unique(case_sensitive=true)|list")
+		}
+		return l + "|" + pick(g.tc, fs...)
+	case r <= 66:
+		ms := []string{"upper", "lower", "trim", "capitalize", "string"}
+		if !Known.titleWords {
+			ms = append(ms, "title")
+		}
+		return g.listStrE(d+1) + "|map('" + pick(g.tc, ms...) + "')|list"
+	case r <= 72:
+		return g.listStrE(d+1) + " + " + g.listStrE(d+1)
+	case r <= 78:
+		return g.listStrE(d+1) + "[" + pick(g.tc, "1:", ":2", "::-1", "-1:", ":-1") + "]"
+	case r <= 84:
+		return g.dictE(d+1) + "|list"
+	case r <= 90:
+		return g.dictE(d+1) + ".keys()|list"
+	case r <= 95:
+		return g.listIntE(d+1) + "|map('string')|list"
+	default:
+		return wrap(g.plainStrE(d+1)) + "|list"
+	}
+}
+
+func (g *tgen) dictE(d int) string {
+	return g.atom(kDict)
+}
+
+// ---------------------------------------------------------------------------
+// Templates.
+
+// tag renders a block tag with random whitespace control.
+func (g *tgen) tag(body string) string {
+	open, close := "{%", "%}"
+	if chance(g.tc, 25) {
+		open = "{%-"
+	}
+	if chance(g.tc, 25) {
+		close = "-%}"
+	}
+	return open + " " + body + " " + close
+}
+
+func (g *tgen) print(e string) string {
+	open, close := "{{", "}}"
+	if chance(g.tc, 15) {
+		open = "{{-"
+	}
+	tail := pick(g.tc, " ", "", "\n")
+	if chance(g.tc, 15) && !(tail == "\n" && Known.stripAfterNewline) {
+		close = "-}}"
+	}
+	return open + pick(g.tc, " ", "  ", "") + e + tail + close
+}
+
+// escaped applies one of the escape filters last, where Jinja2's Markup
+// result is only printed.
+func (g *tgen) escaped(e string, k vk) string {
+	if Known.condexprNested && strings.Contains(e, " else ") {
+		return e
+	}
+	if strings.Contains(e, "tojson") {
+		return e // Markup in Jinja2, which a later escape leaves alone
+	}
+	if k == kStr && g.filterDepth == 0 && chance(g.tc, 15) {
+		return wrap(e) + "|" + pick(g.tc, "e", "escape", "forceescape", "safe")
+	}
+	return e
+}
+
+func (g *tgen) text() string {
+	k := n(g.tc, 1, 3)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteString(pick(g.tc, textPool...))
+	}
+	t := b.String()
+	if g.lstrip {
+		// Jinja2's lstrip_blocks strips blanks before a block tag only from
+		// the start of a line; the library strips them anywhere
+		u := strings.TrimRight(t, " \t")
+		if u != t && !strings.HasSuffix(u, "\n") && u != "" {
+			t = u
+		}
+		if t == "" || strings.TrimRight(t, " \t") == "" {
+			t = "x"
+		}
+	}
+	// pieces may form a tag start; Jinja2 reads an unterminated {# at the
+	// end as text, the library as an unclosed comment (not judged)
+	for strings.Contains(t, "{#") || strings.Contains(t, "{{") || strings.Contains(t, "{%") {
+		t = strings.NewReplacer("{#", "{ #", "{{", "{ {", "{%", "{ %").Replace(t)
+	}
+	return t
+}
+
+// body draws a sequence of template nodes; budget bounds the whole template.
+func (g *tgen) body(depth int, budget *int) string {
+	var b strings.Builder
+	k := n(g.tc, 1, 4)
+	for i := 0; i < k && *budget > 0; i++ {
+		*budget--
+		b.WriteString(g.node(depth, budget))
+	}
+	return b.String()
+}
+
+func (g *tgen) node(depth int, budget *int) string {
+	r := n(g.tc, 1, 100)
+	switch {
+	case r <= 20:
+		return g.text()
+	case r <= 45:
+		e, k := g.printable(0)
+		return g.print(g.escaped(e, k))
+	case r <= 55 && depth < 3:
+		return g.ifNode(depth, budget)
+	case r <= 68 && depth < 3:
+		return g.forNode(depth, budget)
+	case r <= 78:
+		return g.setNode(depth, budget)
+	case r <= 82 && depth < 3:
+		return g.withNode(depth, budget)
+	case r <= 86 && depth < 3:
+		fs := []string{"upper", "lower", "trim", "capitalize", "indent(2)", "replace('a', 'b')", "e", "length", "escape", "forceescape"}
+		if !Known.truncateWhitespace {
+			fs = append(fs, "truncate(8)")
+		}
+		if !Known.titleWords {
+			fs = append(fs, "title")
+		}
+		if !Known.centerBias {
+			fs = append(fs, "center(20)")
+		}
+		if !Known.wordcountWords {
+			fs = append(fs, "wordcount")
+		}
+		if !Known.byteIndexing {
+			fs = append(fs, "reverse")
+		}
+		g.filterDepth++
+		inner := g.body(depth+1, budget)
+		g.filterDepth--
+		return g.tag("filter "+pick(g.tc, fs...)) + inner + g.tag("endfilter")
+	case r <= 90:
+		return "{% raw %}" + pick(g.tc, "{{ x }}", "{% if %}", "{# c #}", "plain", "{{", "%}") + "{% endraw %}"
+	case r <= 94:
+		return "{#" + pick(g.tc, " comment ", "{{ x }}", "\n multi\n line ", "%}") + "#}"
+	case r <= 97 && len(g.macros) > 0:
+		return g.macroCall(depth)
+	default:
+		e, k := g.printable(0)
+		return g.print(g.escaped(e, k))
+	}
+}
+
+func (g *tgen) ifNode(depth int, budget *int) string {
+	var b strings.Builder
+	b.WriteString(g.tag("if " + g.boolE(1)))
+	saved := g.sc
+	g.sc = saved.clone()
+	b.WriteString(g.body(depth+1, budget))
+	if chance(g.tc, 40) {
+		b.WriteString(g.tag("elif " + g.boolE(1)))
+		g.sc = saved.clone()
+		b.WriteString(g.body(depth+1, budget))
+	}
+	if chance(g.tc, 50) {
+		b.WriteString(g.tag("else"))
+		g.sc = saved.clone()
+		b.WriteString(g.body(depth+1, budget))
+	}
+	b.WriteString(g.tag("endif"))
+	g.sc = saved
+	return b.String()
+}
+
+func (g *tgen) forNode(depth int, budget *int) string {
+	var b strings.Builder
+	saved := g.sc
+	g.sc = saved.clone()
+	v := g.newName()
+	var head string
+	switch n(g.tc, 1, 7) {
+	case 1, 2:
+		head = v + " in " + g.listIntE(1)
+		g.sc.vars[v] = kInt
+	case 3:
+		head = v + " in " + g.listStrE(1)
+		g.sc.vars[v] = kStr
+	case 4:
+		head = v + " in range(" + strconv.Itoa(n(g.tc, 0, 3)) + ", " + strconv.Itoa(n(g.tc, 0, 6)) + ")"
+		g.sc.vars[v] = kInt
+	case 5:
+		w := g.newName()
+		if Known.itemsEmpty {
+			head = v + ", " + w + " in " + g.dictE(1) + ".items()"
+		} else {
+			head = v + ", " + w + " in " + g.dictE(1) + "|items"
+		}
+		g.sc.vars[v] = kStr
+		g.sc.ascii[v] = true
+		g.sc.vars[w] = kInt
+	case 6:
+		head = v + " in " + g.dictE(1)
+		g.sc.vars[v] = kStr
+		g.sc.ascii[v] = true
+	default:
+		// the characters become list elements when printed as a list
+		g.plain++
+		if Known.byteIndexing {
+			head = v + " in " + g.asciiStrE(1)
+			g.sc.ascii[v] = true
+		} else {
+			head = v + " in " + g.strE(1)
+		}
+		g.plain--
+		g.sc.vars[v] = kStr
+	}
+	if chance(g.tc, 25) {
+		head += " if " + g.boolE(2)
+	}
+	b.WriteString(g.tag("for " + head))
+	g.inLoop++
+	body := g.body(depth+1, budget)
+	// Jinja2 runs the else block when the last iteration ended in break or
+	// continue (its iteration indicator is only reset at the end of a body);
+	// the library does not. Not judged: no break or continue beside else.
+	withElse := chance(g.tc, 30)
+	if chance(g.tc, 20) && !withElse {
+		body = g.tag("if "+g.boolE(2)) + g.tag(pick(g.tc, "break", "continue")) + g.tag("endif") + body
+	}
+	b.WriteString(body)
+	g.inLoop--
+	if withElse {
+		b.WriteString(g.tag("else"))
+		g.sc = saved.clone() // the loop variables are undefined in else
+		b.WriteString(g.body(depth+1, budget))
+	}
+	b.WriteString(g.tag("endfor"))
+	g.sc = saved
+	return b.String()
+}
+
+func (g *tgen) setNode(depth int, budget *int) string {
+	name := g.newName()
+	if chance(g.tc, 20) && depth < 3 {
+		// block assignment
+		s := g.tag("set "+name) + g.body(depth+1, budget) + g.tag("endset")
+		g.sc.vars[name] = kStr
+		return s + g.print(name+pick(g.tc, "", "|upper", "|length", "|trim"))
+	}
+	k := vk(n(g.tc, 0, 6))
+	s := g.tag("set " + name + " = " + g.expr(k, 1))
+	g.sc.vars[name] = k
+	switch k {
+	case kListInt, kListStr:
+		delete(g.sc.lens, name)
+	case kDict:
+		delete(g.sc.keys, name)
+	}
+	if chance(g.tc, 50) {
+		return s + g.print(name)
+	}
+	return s
+}
+
+func (g *tgen) withNode(depth int, budget *int) string {
+	saved := g.sc
+	g.sc = saved.clone()
+	name := g.newName()
+	k := vk(n(g.tc, 0, 3))
+	head := "with " + name + " = " + g.expr(k, 1)
+	g.sc.vars[name] = k
+	if chance(g.tc, 30) {
+		m := g.newName()
+		head += ", " + m + " = " + g.intE(1)
+		g.sc.vars[m] = kInt
+	}
+	s := g.tag(head) + g.body(depth+1, budget) + g.tag("endwith")
+	g.sc = saved
+	return s
+}
+
+// macroNode defines a macro at the top of the template.
+func (g *tgen) macroNode(budget *int) string {
+	name := "m" + strconv.Itoa(len(g.macros)+1)
+	saved := g.sc
+	g.sc = saved.clone()
+	g.sc.vars["a"] = kInt
+	g.sc.vars["b"] = kStr
+	m := macroDef{name: name, caller: chance(g.tc, 40)}
+	var b strings.Builder
+	b.WriteString(g.tag("macro " + name + "(a, b=" + g.strLit(pick(g.tc, "dflt", "", "x")) + ")"))
+	b.WriteString(g.print("a") + pick(g.tc, "-", ":", "") + g.print("b"))
+	if chance(g.tc, 40) && !Known.macroVarargs {
+		b.WriteString(g.print("varargs|length") + g.print("kwargs|length"))
+	}
+	if m.caller {
+		b.WriteString("[" + g.print("caller()") + "]")
+	}
+	b.WriteString(g.body(2, budget))
+	b.WriteString(g.tag("endmacro"))
+	g.sc = saved
+	g.macros = append(g.macros, m)
+	return b.String()
+}
+
+func (g *tgen) macroCall(depth int) string {
+	m := pick(g.tc, g.macros...)
+	if m.caller && depth > 0 && Known.callNested {
+		for _, o := range g.macros {
+			if !o.caller {
+				m = o
+			}
+		}
+		if m.caller {
+			return g.text()
+		}
+	}
+	args := g.intE(2)
+	switch n(g.tc, 1, 5) {
+	case 1:
+		args += ", " + g.strE(2)
+	case 2:
+		args += ", b=" + g.strE(2)
+	case 3:
+		if !Known.macroVarargs {
+			args += ", " + g.strE(2) + ", " + g.intE(2)
+		}
+	case 4:
+		if !Known.macroVarargs {
+			args += ", c=" + g.intE(2)
+		}
+	}
+	if m.caller {
+		return g.tag("call "+m.name+"("+args+")") + g.text() + g.tag("endcall")
+	}
+	return g.print(m.name + "(" + args + ")")
+}
+
+// template draws a whole template.
+func (g *tgen) template(withMacros bool) string {
+	var b strings.Builder
+	budget := n(g.tc, 2, 12)
+	if withMacros {
+		k := n(g.tc, 1, 2)
+		for i := 0; i < k; i++ {
+			b.WriteString(g.macroNode(&budget))
+		}
+		budget += 3
+	}
+	b.WriteString(g.body(0, &budget))
+	if chance(g.tc, 30) {
+		b.WriteString("\n")
+	}
+	return b.String()
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..d7b140a
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,155 @@
+package gonja_test
+
+// Jinja2 as a child process: one JSON request per line (environment options
+// and a batch of template + context pairs), one JSON reply per line (the
+// rendered text or the exception class and message, per pair).
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const pyScript = `
+import sys, json
+import jinja2
+sys.stdout.write(json.dumps({'version': jinja2.__version__}) + '\n')
+sys.stdout.flush()
+
+envs = {}
+
+def env_for(opts):
+    key = json.dumps(opts, sort_keys=True)
+    if key not in envs:
+        envs[key] = jinja2.Environment(
+            trim_blocks=opts.get('trim_blocks', False),
+            lstrip_blocks=opts.get('lstrip_blocks', False),
+            keep_trailing_newline=opts.get('keep_trailing_newline', False),
+            extensions=['jinja2.ext.do', 'jinja2.ext.loopcontrols'],
+        )
+    return envs[key]
+
+for line in sys.stdin:
+    req = json.loads(line)
+    env = env_for(req.get('opts') or {})
+    out = []
+    for case in req['cases']:
+        try:
+            tpl = env.from_string(case['tpl'])
+            out.append({'out': tpl.render(case['ctx'])})
+        except Exception as ex:
+            msg = str(ex).splitlines()[0] if str(ex) else ''
+            out.append({'err': type(ex).__name__ + ': ' + msg})
+    sys.stdout.write(json.dumps({'results': out}) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleOpts struct {
+	TrimBlocks          bool `json:"trim_blocks"`
+	LstripBlocks        bool `json:"lstrip_blocks"`
+	KeepTrailingNewline bool `json:"keep_trailing_newline"`
+}
+
+type oracleCase struct {
+	Tpl string          `json:"tpl"`
+	Ctx json.RawMessage `json:"ctx"`
+}
+
+type oracleReq struct {
+	Opts  oracleOpts   `json:"opts"`
+	Cases []oracleCase `json:"cases"`
+}
+
+type oracleResult struct {
+	Out *string `json:"out"`
+	Err string  `json:"err"`
+}
+
+type oracleResp struct {
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("jinja2 oracle did not start (python3 with jinja2 needed): %s", stderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, opts oracleOpts, cases []oracleCase) []oracleResult {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{Opts: opts, Cases: cases})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if !oracleOut.Scan() {
+		t.Fatalf("oracle died: %v", oracleOut.Err())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	if len(resp.Results) != len(cases) {
+		t.Fatalf("oracle returned %d results for %d cases", len(resp.Results), len(cases))
+	}
+	return resp.Results
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	r := oracle(t, oracleOpts{}, []oracleCase{{Tpl: "{{ 1 + 1 }}", Ctx: json.RawMessage(`{}`)}})
+	t.Logf("jinja2 %s", oracleVersion)
+	if !strings.HasPrefix(oracleVersion, "3.") {
+		t.Fatalf("jinja2 3.x expected, got %s", oracleVersion)
+	}
+	if r[0].Out == nil || *r[0].Out != "2" {
+		t.Fatalf("oracle smoke test: %+v", r[0])
+	}
+}
