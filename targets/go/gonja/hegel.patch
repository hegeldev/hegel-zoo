@@ -0,0 +1,604 @@
+package gonja_test
+
+// One pin per recorded bug (bugs.toml): the template and the text Jinja2
+// renders (with the default environment unless stated). The pins fail while
+// the bugs are open.
+
+import "testing"
+
+func pin(t *testing.T, pairs ...string) {
+	t.Helper()
+	pinOpts(t, oracleOpts{}, pairs...)
+}
+
+func pinOpts(t *testing.T, o oracleOpts, pairs ...string) {
+	t.Helper()
+	for i := 0; i+1 < len(pairs); i += 2 {
+		got, err := render(pairs[i], map[string]interface{}{}, o)
+		if err != nil {
+			t.Errorf("%s: error %v (Jinja2 renders %q)", pairs[i], firstLine(err.Error()), pairs[i+1])
+			continue
+		}
+		if got != pairs[i+1] {
+			t.Errorf("%s: %q (Jinja2 renders %q)", pairs[i], got, pairs[i+1])
+		}
+	}
+}
+
+// gonja/1
+func TestHegelPinFloorDivModNegative(t *testing.T) {
+	pin(t,
+		"{{ -7 // 2 }}", "-4",
+		"{{ -7 % 3 }}", "2",
+		"{{ 7 % -3 }}", "-2",
+		"{{ -7.5 % 2 }}", "0.5",
+	)
+}
+
+// gonja/2
+func TestHegelPinFloorDivModFloat(t *testing.T) {
+	pin(t,
+		"{{ 10.0 // 3 }}", "3.0",
+		"{{ 10 // 3.0 }}", "3.0",
+		"{{ 7 % 4.0 }}", "3.0",
+		"{{ 7.5 % 2 }}", "1.5",
+	)
+}
+
+// gonja/3
