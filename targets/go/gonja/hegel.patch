+		"{{ 'a' 'b' }}", "ab",
+	)
+}
+
+// gonja/55
+func TestHegelPinCallNested(t *testing.T) {
+	pin(t,
+		"{% macro m(a) %}[{{ caller() }}]{% endmacro %}{% if true %}{% call m(1) %}x{% endcall %}{% endif %}", "[x]",
+		"{% macro m(a) %}[{{ caller() }}]{% endmacro %}{% for i in [1] %}{% call m(i) %}x{% endcall %}{% endfor %}", "[x]",
+	)
+}
+
+// gonja/56
+func TestHegelPinDoubleNot(t *testing.T) {
+	pin(t,
+		"{{ not not true }}", "True",
+		"{{ not not 0 }}", "False",
+	)
+}
+
+// gonja/57
+func TestHegelPinFindEmpty(t *testing.T) {
+	pin(t,
+		"{{ ''.find('a') }}", "-1",
+	)
+}
+
+// gonja/58
+func TestHegelPinZfillEmptyPanics(t *testing.T) {
+	pin(t,
+		"{{ ''.zfill(2) }}", "00",
+	)
+}
+
+// gonja/59
+func TestHegelPinStripAfterNewline(t *testing.T) {
+	pin(t,
+		"{{ 1\n-}}  x", "1x",
+	)
+}
+
+// gonja/60
+func TestHegelPinFirstNegativeIndex(t *testing.T) {
+	pin(t,
+		"{{ [7][-1] }}", "7",
+		"{{ 'ab'[-2] }}", "a",
+		"{{ [1, 2, 3][-3] }}", "1",
+	)
+}
+
+// gonja/61
+func TestHegelPinIstitleUncased(t *testing.T) {
+	pin(t,
+		"{{ '42'.istitle() }}", "False",
+		"{{ 'A B'.istitle() }}", "True",
+	)
+}
+
+// gonja/62
+func TestHegelPinEndswithEmpty(t *testing.T) {
+	pin(t,
+		"{{ ''.endswith('1') }}", "False",
+	)
+}
+
+// gonja/63
+func TestHegelPinTojsonFloat(t *testing.T) {
+	pin(t,
+		"{{ 10.0|tojson }}", "10.0",
+		"{{ (0 / 8)|tojson }}", "0.0",
+	)
+}
+
+// gonja/64
+func TestHegelPinRoundNegativeZero(t *testing.T) {
+	pin(t,
+		"{{ -0.5|round(0, 'ceil') }}", "0.0",
+		"{{ (-1 / 1.5)|round(0, 'ceil') }}", "0.0",
+	)
+}
+
+// gonja/65
+func TestHegelPinLstripAfterTag(t *testing.T) {
+	// lstrip_blocks on
+	pinOpts(t, oracleOpts{LstripBlocks: true},
+		"{% if true %}  {% endif %}|", "  |",
+		"{{ 1 }}  {% if true %}{% endif %}|", "1  |",
+		"{% for i in [1, 2] %}  {{ i }}  {% endfor %}|", "  1    2  |",
+	)
+}
+
+// gonja/66
+func TestHegelPinTruncateWhitespace(t *testing.T) {
+	pin(t,
+		"{{ 'ab\\ncdefghijkl'|truncate(7, false, '...', 0) }}", "ab\nc...",
+		"{{ '  padded  '|truncate(5, false, '', 0) }}", " ",
+	)
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..01b8e8d
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,121 @@
+package gonja_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/nikolalohinski/gonja/v2"
+	"github.com/nikolalohinski/gonja/v2/config"
+	"github.com/nikolalohinski/gonja/v2/exec"
+	"github.com/nikolalohinski/gonja/v2/loaders"
+	"hegel.dev/go/hegel"
+)
+
+// render runs a template through the library with the given options.
+func render(src string, ctx map[string]interface{}, o oracleOpts) (out string, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	cfg := config.New()
+	cfg.TrimBlocks = o.TrimBlocks
+	cfg.LeftStripBlocks = o.LstripBlocks
+	cfg.KeepTrailingNewline = o.KeepTrailingNewline
+	fs, err := loaders.NewFileSystemLoader("")
+	if err != nil {
+		return "", err
+	}
+	loader, err := loaders.NewShiftedLoader("root", bytes.NewReader([]byte(src)), fs)
+	if err != nil {
+		return "", err
+	}
+	tpl, err := exec.NewTemplate("root", cfg, loader, gonja.DefaultEnvironment)
+	if err != nil {
+		return "", err
+	}
+	return tpl.ExecuteToString(exec.NewContext(ctx))
+}
+
+func ctxJSON(ctx map[string]interface{}) json.RawMessage {
+	return json.RawMessage(pyJSON(ctx))
+}
+
+func describe(src string, ctx map[string]interface{}) string {
+	return fmt.Sprintf("template %q\ncontext  %s", src, pyJSON(ctx))
+}
+
+// compare judges one template: Jinja2's error means the case is skipped (the
+// generator aims at valid templates; the library's leniency is not judged),
+// otherwise the library must render the same text.
+func compare(ht *hegel.T, src string, ctx map[string]interface{}, o oracleOpts, want oracleResult) {
+	got, err := render(src, ctx, o)
+	if want.Out == nil {
+		note(ht, "jinja2 error: %s", want.Err)
+		return
+	}
+	if err != nil {
+		fail(ht, "the library rejects a template Jinja2 renders: %v\njinja2 %q\n%s", firstLine(err.Error()), *want.Out, describe(src, ctx))
+	}
+	if got != *want.Out {
+		fail(ht, "outputs differ\nlibrary %q\njinja2  %q\n%s", got, *want.Out, describe(src, ctx))
+	}
+}
+
+func firstLine(s string) string {
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// TestHegelExpressionsAgreeWithJinja: {{ expression }} of every kind -
+// literals, variables, arithmetic, comparisons, tests, filters, string
+// methods, str.format - renders the same text as Jinja2.
+func TestHegelExpressionsAgreeWithJinja(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := newGen(ht)
+		k := n(ht, 1, 6)
+		var cases []oracleCase
+		var srcs []string
+		for i := 0; i < k; i++ {
+			e, k := g.printable(0)
+			src := "{{ " + g.escaped(e, k) + " }}"
+			srcs = append(srcs, src)
+			cases = append(cases, oracleCase{Tpl: src, Ctx: ctxJSON(g.ctx)})
+		}
+		res := oracle(ht, oracleOpts{}, cases)
+		for i, src := range srcs {
+			compare(ht, src, g.ctx, oracleOpts{}, res[i])
+		}
+	})
+}
+
+// TestHegelTemplatesAgreeWithJinja: templates with text, prints, if/elif/
+// else, for loops (loop variables, filters, else, break/continue), set,
+// with, filter blocks, raw and comments, under random trim_blocks /
+// lstrip_blocks / keep_trailing_newline settings, render the same text.
+func TestHegelTemplatesAgreeWithJinja(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := newGen(ht)
+		o := oracleOpts{TrimBlocks: chance(ht, 30), LstripBlocks: chance(ht, 30), KeepTrailingNewline: chance(ht, 30)}
+		g.lstrip = o.LstripBlocks && Known.lstripAfterTag
+		src := g.template(false)
+		res := oracle(ht, o, []oracleCase{{Tpl: src, Ctx: ctxJSON(g.ctx)}})
+		compare(ht, src, g.ctx, o, res[0])
+	})
+}
+
+// TestHegelMacrosAgreeWithJinja: templates defining macros (defaults,
+// varargs, kwargs, caller) and calling them render the same text.
+func TestHegelMacrosAgreeWithJinja(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := newGen(ht)
+		src := g.template(true)
+		res := oracle(ht, oracleOpts{}, []oracleCase{{Tpl: src, Ctx: ctxJSON(g.ctx)}})
+		compare(ht, src, g.ctx, oracleOpts{}, res[0])
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..8a47a17
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,246 @@
+package gonja_test
+
+// Hegel properties for github.com/nikolalohinski/gonja/v2: generated Jinja
+// templates (expressions, filters, tests, methods, control structures,
+// macros, whitespace control) rendered by gonja and by the Python Jinja2
+// engine (as a child process) over the same context must produce the same
+// text.
+//
+// Needs python3 with the `jinja2` package on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Each gate keeps the generator away from a
+// shape that is known to differ from Jinja2 while the bug is open; the pins
+// in hegel_pins_test.go fail while it is. Gates without a generator shape
+// (pin only) are marked so.
+
+var Known = struct {
+	floorDivModNegative    bool // // and % truncate for negative operands: -7 // 2 is -3, -7 % 3 is -1
+	floorDivModFloat       bool // // and % with a float operand return an int: 10.0 // 3 is 3, 7 % 4.0 is 3
+	powIsFloat             bool // ** of two integers is a float: 2 ** 10 prints 1024.0
+	nonePrintsEmpty        bool // None prints as nothing: {{ none }}, 'a' ~ none, [true, none], none|string
+	notPrintsInt           bool // not of a non-boolean prints an integer: {{ not 0 }} is 1
+	seqRepeat              bool // sequence repetition is 0: [1] * 2 and 2 * 'x'
+	itemsEmpty             bool // items and dictsort return an empty list
+	tojsonSpacing          bool // tojson prints {"a":1} without the spaces after : and ,
+	tojsonNonASCII         bool // tojson does not escape non-ASCII characters
+	dictOrder              bool // keys(), values() and items() of a dict are in sorted order, not insertion order; dict(b=1, a=2) is arbitrary
+	roundHalfEven          bool // round rounds halves away from zero: 2.5|round is 3.0 (Python 2.0)
+	roundIntIsFloat        bool // 5|round is 5.0 instead of 5
+	rangeChannel           bool // range() is a one-shot Go channel: prints as its type, |length is 0, |first is empty, a stored range iterates once
+	splitMaxsplit          bool // split() without a separator is an error and maxsplit is ignored
+	upperSpecialCasing     bool // 'ß'|upper is ß instead of SS (pin only)
+	reverseList            bool // |reverse|list undoes the reverse
+	methodResultEquality   bool // a string or list returned by a str method is wrapped: 'a'.upper() == 'A' is false (also in, is eq, select('eq'), set), str.format rejects it
+	isPrecedence           bool // a test applies to the whole arithmetic expression: 1 + 2 is odd
+	inFilterPrecedence     bool // 'a' in 'ba'|upper applies the filter to the boolean
+	inRightOperand         bool // 'a' in 'b' ~ 'a' and 1 in [1] + [2] fail to parse
+	upperLowerUncased      bool // '0' is upper and '0' is lower are true
+	oddEvenNegative        bool // -1 is odd and 2.0 is even are false
+	condexprNested         bool // a conditional expression in parentheses, brackets or another conditional fails to parse
+	doubleMinus            bool // - -6 fails to parse (pin only)
+	chainedTests           bool // x is divisibleby(3) is sameas true fails to parse (pin only)
+	filterResultMethods    bool // methods and subscripts on a parenthesised filter or concatenation fail
+	escapedFilterTestTests bool // the escaped, filter and test tests are errors
+	sequenceTest           bool // 'a' is sequence and {} is sequence are false
+	boolIsNumber           bool // booleans are not numbers: true + 1 is 1, 1 == true is false, true|int is 0
+	noneDefined            bool // None and undefined are conflated: none is defined is false, missing is none is true, none|default('d') is d
+	trueFalseTests         bool // the true and false tests use truthiness: 0 is false
+	gtOnStrings            bool // 'b' is gt 'a' is an error
+	countMethod            bool // str.count returns at most 1
+	findStart              bool // str.find with a start returns an index relative to the slice
+	methodOptionalArgs     bool // center(w), ljust(w), lstrip(), rstrip(), expandtabs(n), replace(a, b) without a count, join(str), endswith(tuple) are errors
+	centerBias             bool // center puts the odd padding character on the left
+	wordwrapLongWords      bool // wordwrap does not break long words; its second argument is an error
+	wordcountWords         bool // wordcount counts whitespace-separated words, not word-character runs
+	floatWhitespace        bool // ' 3.5 '|float is 0.0 (pin only)
+	byteIndexing           bool // string indexing, reverse, zfill and for loops over a string work on bytes
+	listReprEscapes        bool // a string with a newline or a quote prints unescaped inside a list: ['a\nb'] and ["'"]
+	formatConversions      bool // str.format conversions and field access ({!r}, {0[0]}) fail (pin only)
+	formatGrouping         bool // str.format {:,} and {:_} fail (pin only)
+	formatBraces           bool // str.format does not unescape {{ and }} (pin only)
+	formatFloat            bool // str.format {} of 1.0 is 1, {:.3} of 5.0 is 5, {:.0f} ignores the precision
+	formatNoneList         bool // str.format {} of None or a list is an error
+	titleWords             bool // title upper-cases after any non-letter: "a'b"|title
+	urlencodeReserved      bool // urlencode leaves = and & alone
+	striptagsEntities      bool // striptags does not unescape entities
+	pprintQuotes           bool // 'x'|pprint is "x", lists are Go structs
+	macroVarargs           bool // extra positional or keyword arguments to a macro are errors instead of varargs and kwargs
+	loopDepth              bool // loop.depth counts nesting instead of recursion
+	sumStart               bool // sum(start=[]) is 0 (pin only)
+	implicitConcat         bool // 'a' 'b' fails to parse (pin only)
+	callNested             bool // {% call %} inside any other block: caller is not callable
+	doubleNot              bool // not not x fails to parse
+	findEmpty              bool // ''.find(x) is 0 instead of -1
+	zfillEmptyPanics       bool // ''.zfill(n) panics
+	stripAfterNewline      bool // -}} after a newline inside the print does not strip the following whitespace
+	firstNegativeIndex     bool // index -len (the first element) of a list or string is empty: [7][-1], 'ab'[-2]
+	istitleUncased         bool // '42'.istitle() is true and 'A B'.istitle() is false
+	endswithEmpty          bool // ''.endswith('1') is true
+	tojsonFloat            bool // tojson of an integral float drops the .0: 10.0|tojson is 10
+	roundNegativeZero      bool // round(0, 'ceil') of a small negative is -0.0
+	lstripAfterTag         bool // with lstrip_blocks, whitespace before a block tag is stripped anywhere on the line, not only at the start of a line: {{ 1 }}  {% if true %}
+	truncateWhitespace     bool // truncate cuts at any whitespace and trims; Jinja2 cuts at the last space only
+}{
+	floorDivModNegative:    true,
+	floorDivModFloat:       true,
+	powIsFloat:             true,
+	nonePrintsEmpty:        true,
+	notPrintsInt:           true,
+	seqRepeat:              true,
+	itemsEmpty:             true,
+	tojsonSpacing:          true,
+	tojsonNonASCII:         true,
+	dictOrder:              true,
+	roundHalfEven:          true,
+	roundIntIsFloat:        true,
+	rangeChannel:           true,
+	splitMaxsplit:          true,
+	upperSpecialCasing:     true,
+	reverseList:            true,
+	methodResultEquality:   true,
+	isPrecedence:           true,
+	inFilterPrecedence:     true,
+	inRightOperand:         true,
+	upperLowerUncased:      true,
+	oddEvenNegative:        true,
+	condexprNested:         true,
+	doubleMinus:            true,
+	chainedTests:           true,
+	filterResultMethods:    true,
+	escapedFilterTestTests: true,
+	sequenceTest:           true,
+	boolIsNumber:           true,
+	noneDefined:            true,
+	trueFalseTests:         true,
+	gtOnStrings:            true,
+	countMethod:            true,
+	findStart:              true,
+	methodOptionalArgs:     true,
+	centerBias:             true,
+	wordwrapLongWords:      true,
+	wordcountWords:         true,
+	floatWhitespace:        true,
+	byteIndexing:           true,
+	listReprEscapes:        true,
+	formatConversions:      true,
+	formatGrouping:         true,
+	formatBraces:           true,
+	formatFloat:            true,
+	formatNoneList:         true,
+	titleWords:             true,
+	urlencodeReserved:      true,
+	striptagsEntities:      true,
+	pprintQuotes:           true,
+	macroVarargs:           true,
+	loopDepth:              true,
+	sumStart:               true,
+	implicitConcat:         true,
+	callNested:             true,
+	doubleNot:              true,
+	findEmpty:              true,
+	zfillEmptyPanics:       true,
+	stripAfterNewline:      true,
+	firstNegativeIndex:     true,
+	istitleUncased:         true,
+	endswithEmpty:          true,
+	tojsonFloat:            true,
+	roundNegativeZero:      true,
+	lstripAfterTag:         true,
+	truncateWhitespace:     true,
+}
