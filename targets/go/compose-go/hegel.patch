@@ -0,0 +1,58 @@
+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"testing"
+
+	"github.com/compose-spec/compose-go/v2/template"
+)
+
+// compose-go/1: a default value, alternative or error message may contain a newline, as any
+// other character; the template is not invalid.
+func TestHegelPinNewlineInDefault(t *testing.T) {
+	for tmpl, want := range map[string]string{"${U:-a\nb}": "a\nb", "${E:-\n}": "\n", "${A:+x\ny}": "x\ny", "${U:-${V:-1\n2}}": "1\n2"} {
+		got, err := template.SubstituteWithOptions(tmpl, mapping, template.WithoutLogging)
+		if err != nil || got != want {
+			t.Errorf("Substitute(%q) = %q, %v; want %q", tmpl, got, err, want)
+		}
+	}
+	if _, err := template.SubstituteWithOptions("${U:?line1\nline2}", mapping, template.WithoutLogging); err == nil {
+		t.Errorf("Substitute(%q) succeeded, want the required-variable error", "${U:?line1\nline2}")
+	} else if e, ok := err.(*template.MissingRequiredError); !ok || e.Reason != "line1\nline2" {
+		t.Errorf("Substitute(%q): %v, want a MissingRequiredError with the message", "${U:?line1\nline2}", err)
+	}
+}
+
+// compose-go/2: variables used inside a required-variable message are variables of the file.
+func TestHegelPinExtractMessageVariables(t *testing.T) {
+	for _, tmpl := range []string{"${U:?${B}}", "${U?$B}", "${U:?x ${B:-y} z}"} {
+		got := template.ExtractVariables(map[string]interface{}{"k": tmpl}, nil)
+		if _, ok := got["B"]; !ok {
+			t.Errorf("ExtractVariables(%q) = %v, B missing", tmpl, sortedKeys(got))
+		}
+	}
+}
+
+// compose-go/3: a variable used several times keeps the default and presence value of its
+// first occurrence, in one string as across the configuration.
+func TestHegelPinExtractFirstOccurrence(t *testing.T) {
+	got := template.ExtractVariables(map[string]interface{}{"k": "${A:-x} ${A:-y} ${A:+p} ${A:+q}"}, nil)
+	if got["A"].DefaultValue != "x" || got["A"].PresenceValue != "p" {
+		t.Errorf("one string: DefaultValue %q PresenceValue %q, want %q %q", got["A"].DefaultValue, got["A"].PresenceValue, "x", "p")
+	}
+	got = template.ExtractVariables(map[string]interface{}{"k": "${A:-x}${A:-y}"}, nil)
+	if got["A"].DefaultValue != "x" {
+		t.Errorf("adjacent: DefaultValue %q, want %q", got["A"].DefaultValue, "x")
+	}
+	// across keys the result must at least be the same every time
+	seen := map[string]bool{}
+	for i := 0; i < 50; i++ {
+		got = template.ExtractVariables(map[string]interface{}{"k1": "${A:-x}", "k2": "${A:-y}"}, nil)
+		seen[got["A"].DefaultValue] = true
+	}
+	if len(seen) != 1 {
+		t.Errorf("two keys: DefaultValue varies between runs: %v", sortedKeys(seen))
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..608d3b9
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,302 @@
+package hegel
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/compose-spec/compose-go/v2/template"
+	"github.com/sirupsen/logrus"
+	"hegel.dev/go/hegel"
+)
+
+// Substitute warns through logrus about every unset variable; keep the test output readable.
+func init() { logrus.SetOutput(io.Discard) }
+
+// classify names the outcome of a Substitute call.
+func classify(v string, err error) string {
+	if err == nil {
+		return fmt.Sprintf("value %q", v)
+	}
+	var inv *template.InvalidTemplateError
+	var miss *template.MissingRequiredError
+	switch {
+	case errors.As(err, &inv):
+		return "invalid"
+	case errors.As(err, &miss):
+		return fmt.Sprintf("missing %s: %q", miss.Variable, miss.Reason)
+	}
+	return fmt.Sprintf("other error %T: %v", err, err)
+}
+
+func modelClass(v string, err error) string {
+	if err == nil {
+		return fmt.Sprintf("value %q", v)
+	}
+	var miss *missingErr
+	if errors.As(err, &miss) {
+		return fmt.Sprintf("missing %s: %q", miss.name, miss.reason)
+	}
+	return "invalid"
+}
+
+// mismatch reports a disagreement with the oracle. shape is the recorded bug whose shape the
+// template has (known, knownSubstitute; "" for none): it is named in the failure, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead of reported.
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		shape = " (the shape of " + shape + ")"
+	}
+	ht.Fatalf("%s%s", fmt.Sprintf(format, args...), shape)
+}
+
+// substituteAgreesWithModel judges one template: Substitute and SubstituteWithOptions give
+// the model's value, or the model's error class (invalid template; required variable with the
+// same name and expanded message).
+func substituteAgreesWithModel(ht *hegel.T, text string) {
+	m := &model{s: text}
+	want, werr := m.run()
+	shape := m.knownSubstitute()
+	got, err := template.SubstituteWithOptions(text, mapping, template.WithoutLogging)
+	if classify(got, err) != modelClass(want, werr) {
+		mismatch(ht, shape, "Substitute(%q):\n  got  %s\n  want %s", text, classify(got, err), modelClass(want, werr))
+	}
+	if err != nil && !strings.Contains(err.Error(), "required variable") && !strings.Contains(err.Error(), "Invalid template") {
+		ht.Fatalf("Substitute(%q) error message %q", text, err)
+	}
+	// the logging variant is the same function
+	got2, err2 := template.Substitute(text, mapping)
+	if classify(got2, err2) != classify(got, err) {
+		ht.Fatalf("Substitute(%q) = %s but SubstituteWithOptions = %s", text, classify(got2, err2), classify(got, err))
+	}
+}
+
+// TestHegelSubstitute: Substitute agrees with the model of the specification on the value,
+// or on the error (invalid template; required variable with its name and expanded message).
+// The template draws a newline inside a word at its natural rate, so this property fails
+// while compose-go/1 is open; TestHegelNewlineInWordSubstitutes draws that shape alone.
+func TestHegelSubstitute(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		substituteAgreesWithModel(ht, hegel.Draw(ht, anyTemplate))
+	})
+}
+
+// TestHegelBash: on templates bash accepts (no invalid forms, no backslashes), Substitute gives
+// what bash gives for the same string in double quotes, and fails exactly when bash fails
+// (a required variable). bash substitutes a word containing a newline, so this property too
+// fails while compose-go/1 is open.
+func TestHegelBash(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, bashTemplate)
+		m := &model{s: text}
+		_, _ = m.run()
+		shape := m.knownSubstitute()
+		want, berr := bashExpand(text)
+		got, err := template.SubstituteWithOptions(text, mapping, template.WithoutLogging)
+		if berr != nil {
+			// a required variable with a message makes bash print the message instead; not a
+			// case the oracle covers
+			ht.Assume(strings.Contains(berr.Error(), "parameter null or not set") || strings.Contains(berr.Error(), "parameter not set"))
+			var miss *template.MissingRequiredError
+			if !errors.As(err, &miss) {
+				mismatch(ht, shape, "Substitute(%q) = %s; bash: %v", text, classify(got, err), berr)
+			}
+			return
+		}
+		if err != nil || got != want {
+			mismatch(ht, shape, "Substitute(%q) = %s; bash gives %q", text, classify(got, err), want)
+		}
+	})
+}
+
+// anyString is a string of the characters that matter to the template syntax, 40% dollars.
+var anyString = many(weighted(
+	choice[string]{60, hegel.SampledFrom([]string{"a", "{", "}", ":", "-", "?", "+", " ", "\n", "A", "1", "_"})},
+	choice[string]{40, hegel.Just("$")},
+), 0, 12)
+
+// TestHegelEscape: doubling every dollar sign makes any string a template that substitutes to
+// itself, whatever the string contains.
+func TestHegelEscape(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, anyString)
+		got, err := template.SubstituteWithOptions(strings.ReplaceAll(s, "$", "$$"), mapping, template.WithoutLogging)
+		if err != nil || got != s {
+			ht.Fatalf("Substitute(%q) = %s, want %q", strings.ReplaceAll(s, "$", "$$"), classify(got, err), s)
+		}
+	})
+}
+
+// extractAgreesWithModel judges one string: the variables ExtractVariables reports for a
+// configuration holding it (deep: nested in a list and a map) are those the model parsed,
+// required when any occurrence is, with the default and presence value of the first
+// occurrence defining one.
+func extractAgreesWithModel(ht *hegel.T, text string, deep bool) {
+	m := &model{s: text}
+	_, _ = m.run()
+	// ExtractVariables of an invalid template also reports a variable with an empty name for
+	// the stray "${"; not a case callers reach, since Substitute fails first (and not one the
+	// well-formed generators produce)
+	ht.Assume(!m.invalid)
+	shape := m.known()
+	want := m.extracted()
+	cfg := map[string]interface{}{"k": text}
+	if deep {
+		cfg = map[string]interface{}{"list": []interface{}{"x", map[string]interface{}{"deep": text}}}
+	}
+	got := template.ExtractVariables(cfg, nil)
+	if strings.Join(sortedKeys(got), ",") != strings.Join(sortedKeys(want), ",") {
+		mismatch(ht, shape, "ExtractVariables(%q) names %v, want %v", text, sortedKeys(got), sortedKeys(want))
+	}
+	for _, name := range sortedKeys(want) {
+		w, g := want[name], got[name]
+		if g.Name != name {
+			mismatch(ht, shape, "ExtractVariables(%q)[%s].Name = %q", text, name, g.Name)
+		}
+		if g.Required != w.required {
+			mismatch(ht, shape, "ExtractVariables(%q)[%s].Required = %v, want %v", text, name, g.Required, w.required)
+		}
+		// the value kept among several distinct candidates is compose-go/3's shape, drawn in
+		// about 8% of the wide cases: under HEGEL_NO_KNOWN=1 that one check is not made (an
+		// Assume at that rate would trip the filter-too-much check) and the rest of the case is
+		if g.DefaultValue != w.def && !(noKnown && w.defs > 1) {
+			mismatch(ht, shape, "ExtractVariables(%q)[%s].DefaultValue = %q, want %q", text, name, g.DefaultValue, w.def)
+		}
+		if g.PresenceValue != w.presence && !(noKnown && w.press > 1) {
+			mismatch(ht, shape, "ExtractVariables(%q)[%s].PresenceValue = %q, want %q", text, name, g.PresenceValue, w.presence)
+		}
+	}
+}
+
+// TestHegelExtractVariables: the variables ExtractVariables reports for a configuration holding
+// the template are those the model parsed, required when any occurrence is, with the default
+// and presence value of the first occurrence defining one. The template draws the shapes of
+// all three recorded bugs at their natural rate (a newline inside a word, a variable inside a
+// ?-message, two distinct defaults of one variable), so this property fails while any is open
+// and shrinks to the smallest of them; each bug also has its own property below.
+func TestHegelExtractVariables(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, wellFormed)
+		deep := hegel.Draw(ht, chance(30))
+		extractAgreesWithModel(ht, text, deep)
+	})
+}
+
+// --------------------------------------------------------------------------- one property per recorded bug
+
+// A generator over each bug's shape region with random contents, judged by the same oracle as
+// the wide property above, so that each bug has a property that finds it every run (the wide
+// properties reach the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring shape the bug does not touch instead (a space for the newline, a default for
+// the message, one word twice) and passes.
+
+var (
+	positions = hegel.Integers(0, 5)
+	anyOp     = hegel.SampledFrom(ops)
+)
+
+// spliced is a list of pieces with one more inserted at a drawn position.
+func spliced(around hegel.Generator[[]piece], p hegel.Generator[piece]) hegel.Generator[[]piece] {
+	return hegel.Composite(func(tc hegel.TestCase) []piece {
+		ps, x, at := hegel.Draw(tc, around), hegel.Draw(tc, p), hegel.Draw(tc, positions)
+		return slices.Insert(slices.Clone(ps), at%(len(ps)+1), x)
+	})
+}
+
+// formOf is ${NAME op word} over the given operators and words.
+func formOf(op hegel.Generator[string], word hegel.Generator[[]piece]) hegel.Generator[piece] {
+	return hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: opForm, text: hegel.Draw(tc, varName), op: hegel.Draw(tc, op), word: hegel.Draw(tc, word)}
+	})
+}
+
+var (
+	// newlineRuns: a literal run with a newline inside it (the shape of compose-go/1), or
+	// under HEGEL_NO_KNOWN=1 with a space in its place
+	newlineRuns = hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: literalRun, text: hegel.Draw(tc, text(plainWordChars, 0, 2)) + shaped("\n", " ") + hegel.Draw(tc, text(plainWordChars, 0, 2))}
+	})
+	// newlineWordTemplates: a template with a ${NAME op word} whose word has such a run among
+	// its pieces
+	newlineWordTemplates = hegel.Map(spliced(pieces(0, false, true), formOf(anyOp, spliced(pieces(1, false, true), newlineRuns))), render)
+)
+
+// TestHegelNewlineInWordSubstitutes: a default, alternative or message containing a newline is
+// substituted like any other word (bash does so), so Substitute of a template with one agrees
+// with the model. compose-go's pattern captures the word with `.*`, which stops at the
+// newline, and reports the template as invalid (compose-go/1).
+func TestHegelNewlineInWordSubstitutes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		substituteAgreesWithModel(ht, hegel.Draw(ht, newlineWordTemplates))
+	})
+}
+
+var (
+	// messageNames are used only inside ?-messages (unset, not among names), so that a
+	// variable of a message is reported for the message alone
+	messageNames = hegel.SampledFrom([]string{"Q", "R", "S"})
+	// messageRefs: a reference to one of them, plain, braced or with an operator and a short
+	// word
+	messageRefs = hegel.OneOf(
+		hegel.Map(messageNames, asPiece(dollarName)),
+		hegel.Map(messageNames, func(n string) piece { return piece{kind: verbatim, text: "${" + n + "}"} }),
+		operatorsOf(messageNames, pieces(2, false, true)),
+	)
+	// messageOps: the required-variable operators (the shape of compose-go/2), or under
+	// HEGEL_NO_KNOWN=1 the default and presence ones, whose word ExtractVariables does read
+	messageOps = shaped(hegel.SampledFrom([]string{":?", "?"}), hegel.SampledFrom([]string{":-", "-", ":+", "+"}))
+	// messageVarTemplates: a template with a ${NAME op word} whose word has a reference among
+	// its pieces
+	messageVarTemplates = hegel.Map(spliced(pieces(0, false, true), formOf(messageOps, spliced(pieces(1, false, true), messageRefs))), render)
+)
+
+// TestHegelMessageVariablesExtracted: a variable used inside a required-variable message is a
+// variable of the configuration (Substitute expands the message), so ExtractVariables reports
+// it. extractVariable recurses into default and presence values but not into messages
+// (compose-go/2).
+func TestHegelMessageVariablesExtracted(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		extractAgreesWithModel(ht, hegel.Draw(ht, messageVarTemplates), false)
+	})
+}
+
+var (
+	// the two words of the repeated form come from disjoint alphabets, so they differ
+	firstWords  = text("ab1 ", 1, 3)
+	secondWords = text("xy2-", 1, 3)
+	separators  = hegel.Lists(hegel.Map(text(plainWordChars, 1, 3), asPiece(literalRun))).MaxSize(2)
+	// repeatedDefaultTemplates: two ${NAME op word} of one name and one operator family (the
+	// defaults, or the presence values) with distinct non-empty words (the shape of
+	// compose-go/3), or under HEGEL_NO_KNOWN=1 the same word twice, with literal runs between
+	repeatedDefaultTemplates = hegel.Map(hegel.Composite(func(tc hegel.TestCase) []piece {
+		name, family := hegel.Draw(tc, varName), hegel.Draw(tc, hegel.SampledFrom([]string{"-", "+"}))
+		colons := hegel.SampledFrom([]string{":", ""})
+		first := hegel.Draw(tc, firstWords)
+		second := first
+		if !noKnown {
+			second = hegel.Draw(tc, secondWords)
+		}
+		form := func(op, word string) piece {
+			return piece{kind: opForm, text: name, op: op, word: []piece{{kind: literalRun, text: word}}}
+		}
+		ps := []piece{form(hegel.Draw(tc, colons)+family, first)}
+		ps = append(ps, hegel.Draw(tc, separators)...)
+		return append(ps, form(hegel.Draw(tc, colons)+family, second))
+	}), render)
+)
+
+// TestHegelFirstDefaultOccurrenceKept: a variable used twice in one string with two default
+// (or presence) values keeps the first, as combineVariable documents. extractVariable splits
+// the pattern's greedy match at the first closing brace and appends the remainder's variables
+// before the current one, so the last is kept (compose-go/3).
+func TestHegelFirstDefaultOccurrenceKept(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		extractAgreesWithModel(ht, hegel.Draw(ht, repeatedDefaultTemplates), false)
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..3365907
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,113 @@
+package hegel
+
+// Hegel property tests for compose-spec/compose-go (package template), written for the Hegel
+// zoo. See targets/go/compose-go/README.md.
+//
+// Oracle: a model of the Compose specification's interpolation syntax (and bash, which the
+// syntax follows, as a second oracle on the shared subset) applied to generated templates.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(); HEGEL_NO_KNOWN=1 switches the shapes of the recorded bugs off
+// (noKnown, below).
+
+import (
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance generates true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct)/100)
+}
+
+// text generates strings of lo-hi characters drawn from pool.
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// many generates lo-hi draws from g, concatenated.
+func many(g hegel.Generator[string], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(g).MinSize(lo).MaxSize(hi), func(parts []string) string { return strings.Join(parts, "") })
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml). By default the
+// generators draw their shapes (a newline inside a word, compose-go/1; a variable inside a
+// ?-message, compose-go/2; two distinct defaults of one variable in one string, compose-go/3)
+// and the properties that meet them fail, naming the shape; the pins are the regression
+// examples beside them. Under HEGEL_NO_KNOWN=1 the generators draw the first two shapes no
+// more (shaped), a disagreement the model's known attributes to a recorded bug is skipped
+// (mismatch), and the value kept among several distinct defaults is not judged
+// (extractAgreesWithModel). Read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the known-bug shape (an alphabet, a generator), or under HEGEL_NO_KNOWN=1 the
+// neighbouring one past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
