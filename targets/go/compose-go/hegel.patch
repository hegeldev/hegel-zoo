diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..794f8a2
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,388 @@
+package hegel
+
+// A model of the Compose specification's interpolation syntax (12-interpolation.md, plus the
+// ${VAR:+alt}/${VAR+alt} forms documented by Docker), a generator of templates and the bash
+// oracle.
+
+import (
+	"errors"
+	"fmt"
+	"os/exec"
+	"sort"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- environment
+
+// env is the mapping: set variables with plain, empty and dollar-containing values; U, V and W
+// are unset.
+var env = map[string]string{
+	"A":   "alpha",
+	"B":   "b b",
+	"E":   "",
+	"D":   "$X",
+	"H":   "${A}",
+	"F":   "a}b",
+	"n1":  "1",
+	"MiX": "m",
+	"_u":  "under",
+}
+
+var names = []string{"A", "B", "E", "D", "H", "F", "n1", "MiX", "_u", "U", "V", "W"}
+
+func mapping(k string) (string, bool) { v, ok := env[k]; return v, ok }
+
+// --------------------------------------------------------------------------- model
+
+type missingErr struct{ name, reason string }
+type invalidErr struct{}
+
+func (e *missingErr) Error() string { return "required " + e.name + ": " + e.reason }
+func (e *invalidErr) Error() string { return "invalid template" }
+
+func isNameStart(c byte) bool { return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
+func isNameChar(c byte) bool  { return isNameStart(c) || (c >= '0' && c <= '9') }
+
+// variable is what ExtractVariables reports for one occurrence.
+type variable struct {
+	name, def, presence string
+	required            bool
+	inMessage           bool // occurs only inside a ?-message
+}
+
+// model parses and evaluates a template lazily: words are evaluated only when the operator
+// selects them, and the first error in evaluation order is returned.
+type model struct {
+	s             string
+	newlineInWord bool
+	invalid       bool // an invalid form occurs somewhere, whichever error is reported first
+	vars          []variable
+}
+
+// run evaluates the whole template.
+func (m *model) run() (string, error) { return m.runFrom(false) }
+
+// dollar handles the text at a '$' at position i, returning its value and the next position.
+// Values of substitutions are never re-expanded.
+func (m *model) dollar(i int, inMessage bool) (string, int, error) {
+	if i+1 >= len(m.s) {
+		return "$", i + 1, nil // a lone $ is preserved
+	}
+	c := m.s[i+1]
+	switch {
+	case c == '$':
+		return "$", i + 2, nil
+	case isNameStart(c):
+		j := i + 1
+		for j < len(m.s) && isNameChar(m.s[j]) {
+			j++
+		}
+		name := m.s[i+1 : j]
+		m.vars = append(m.vars, variable{name: name, inMessage: inMessage})
+		v, _ := mapping(name)
+		return v, j, nil
+	case c == '{':
+		return m.braced(i+2, inMessage)
+	}
+	return "$", i + 1, nil // "$ ", "$1": preserved
+}
+
+// braced parses from just after "${".
+func (m *model) braced(i int, inMessage bool) (string, int, error) {
+	j := i
+	for j < len(m.s) && isNameChar(m.s[j]) {
+		j++
+	}
+	name := m.s[i:j]
+	if name == "" || !isNameStart(name[0]) || j >= len(m.s) {
+		return "", 0, &invalidErr{}
+	}
+	if m.s[j] == '}' {
+		m.vars = append(m.vars, variable{name: name, inMessage: inMessage})
+		v, _ := mapping(name)
+		return v, j + 1, nil
+	}
+	op := ""
+	if m.s[j] == ':' {
+		op = ":"
+		j++
+		if j >= len(m.s) {
+			return "", 0, &invalidErr{}
+		}
+	}
+	switch m.s[j] {
+	case '-', '+', '?':
+		op += string(m.s[j])
+		j++
+	default:
+		return "", 0, &invalidErr{}
+	}
+	// the word extends to the matching '}', nested ${...} included
+	start := j
+	depth := 0
+	for j < len(m.s) {
+		if m.s[j] == '$' && j+1 < len(m.s) && m.s[j+1] == '{' {
+			depth++
+			j += 2
+			continue
+		}
+		if m.s[j] == '$' && j+1 < len(m.s) && m.s[j+1] == '$' {
+			j += 2
+			continue
+		}
+		if m.s[j] == '}' {
+			if depth == 0 {
+				break
+			}
+			depth--
+		}
+		if m.s[j] == '\n' {
+			m.newlineInWord = true
+		}
+		j++
+	}
+	if j >= len(m.s) {
+		return "", 0, &invalidErr{}
+	}
+	word := m.s[start:j]
+	end := j + 1
+	value, set := mapping(name)
+	v := variable{name: name, inMessage: inMessage}
+	switch op {
+	case ":-", "-":
+		v.def = word
+	case ":+", "+":
+		v.presence = word
+	default:
+		v.required = true
+	}
+	m.vars = append(m.vars, v)
+	// the word's own variables count for ExtractVariables whether or not it is evaluated
+	sub := &model{s: word}
+	subVal, subErr := sub.runFrom(inMessage || op == "?" || op == ":?")
+	m.newlineInWord = m.newlineInWord || sub.newlineInWord
+	m.invalid = m.invalid || sub.invalid
+	m.vars = append(m.vars, sub.vars...)
+	useWord := false
+	switch op {
+	case ":-":
+		useWord = !set || value == ""
+	case "-":
+		useWord = !set
+	case ":+":
+		useWord = set && value != ""
+		if !useWord {
+			value = ""
+		}
+	case "+":
+		useWord = set
+		if !useWord {
+			value = ""
+		}
+	case ":?":
+		if !set || value == "" {
+			if subErr != nil {
+				return "", end, subErr
+			}
+			return "", end, &missingErr{name, subVal}
+		}
+	case "?":
+		if !set {
+			if subErr != nil {
+				return "", end, subErr
+			}
+			return "", end, &missingErr{name, subVal}
+		}
+	}
+	if useWord {
+		if subErr != nil {
+			return "", end, subErr
+		}
+		return subVal, end, nil
+	}
+	return value, end, nil
+}
+
+// runFrom evaluates the template; the first error is returned, but parsing goes on after a
+// required-variable error (as compose-go's substitution does, and as its extraction, which is
+// purely syntactic, needs), and stops at an invalid template.
+func (m *model) runFrom(inMessage bool) (string, error) {
+	var b strings.Builder
+	var first error
+	i := 0
+	for i < len(m.s) {
+		c := m.s[i]
+		if c != '$' {
+			b.WriteByte(c)
+			i++
+			continue
+		}
+		v, n, err := m.dollar(i, inMessage)
+		if err != nil {
+			if first == nil {
+				first = err
+			}
+			if errors.As(err, new(*invalidErr)) {
+				m.invalid = true
+				return "", first
+			}
+		}
+		b.WriteString(v)
+		i = n
+	}
+	if first != nil {
+		return "", first
+	}
+	return b.String(), nil
+}
+
+// extracted combines the occurrences the way ExtractVariables documents: required as soon as
+// one occurrence is, the default and presence value of the first occurrence defining one.
+type extracted struct {
+	def, presence string
+	required      bool
+	defs, press   int // number of distinct non-empty candidates
+}
+
+func (m *model) extracted(skipMessages bool) map[string]*extracted {
+	out := map[string]*extracted{}
+	for _, v := range m.vars {
+		if skipMessages && v.inMessage {
+			continue
+		}
+		e := out[v.name]
+		if e == nil {
+			e = &extracted{}
+			out[v.name] = e
+		}
+		e.required = e.required || v.required
+		if v.def != "" {
+			if e.def == "" {
+				e.def = v.def
+			}
+			if e.def != v.def || e.defs == 0 {
+				e.defs++
+			}
+		}
+		if v.presence != "" {
+			if e.presence == "" {
+				e.presence = v.presence
+			}
+			if e.presence != v.presence || e.press == 0 {
+				e.press++
+			}
+		}
+	}
+	return out
+}
+
+func sortedKeys[T any](m map[string]T) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// --------------------------------------------------------------------------- generator
+
+// literal alphabets: outside words braces are literal; inside words they are left out (the
+// specification says nothing about bare braces in a default; bash and compose-go differ).
+var outerChars = []string{"a", "b", "x", "1", " ", "-", ":", ".", "/", "}", "{", "?", "+", "=", ",", "\n", "'", "\\", "!", "#", "%", "@", "~", "\t"}
+var wordChars = []string{"a", "b", "x", "1", " ", "-", ":", ".", "/", "?", "+", "=", ",", "!", "#", "%", "@", "~"}
+
+var ops = []string{":-", "-", ":+", "+", ":?", "?"}
+
+var invalidForms = []string{"${", "${}", "${1x}", "${A B}", "${A:x}", "${A!}", "${A:}", "${A::-x}", "${-x}", "${:-x}", "${A.b}", "${ A}"}
+
+// genTemplate draws a template as text; bashSafe reports whether the bash oracle can run it
+// (no invalid forms, no newlines in words, no characters bash treats specially inside double
+// quotes: backslash, backquote, quotes are fine).
+func genTemplate(tc hegel.TestCase, depth int) (text string, bashSafe bool) {
+	var b strings.Builder
+	safe := true
+	afterName := false
+	n := drawInt(tc, 0, 5)
+	if depth == 0 {
+		n = drawInt(tc, 1, 6)
+	}
+	for k := 0; k < n; k++ {
+		r := drawInt(tc, 1, 100)
+		switch {
+		case r <= 30: // literal run
+			var chars []string
+			if depth == 0 {
+				chars = outerChars
+			} else {
+				chars = wordChars
+			}
+			for j := drawInt(tc, 1, 4); j > 0; j-- {
+				c := pick(tc, chars)
+				if afterName && isNameChar(c[0]) {
+					b.WriteString(" ")
+				}
+				if c == "\\" || c == "\n" && depth > 0 {
+					safe = false
+				}
+				b.WriteString(c)
+				afterName = false
+			}
+		case r <= 38: // escaped dollar
+			b.WriteString("$$")
+			if depth > 0 && chance(tc, 30) {
+				b.WriteString("x") // never "$${" inside a word
+			}
+			afterName = false
+		case r <= 55: // $NAME
+			b.WriteString("$" + pick(tc, names))
+			afterName = true
+		case r <= 68: // ${NAME}
+			b.WriteString("${" + pick(tc, names) + "}")
+			afterName = false
+		case r <= 94 || depth >= 2: // ${NAME op word}
+			op := pick(tc, ops)
+			word := ""
+			wsafe := true
+			if depth < 2 {
+				word, wsafe = genTemplate(tc, depth+1)
+			} else if chance(tc, 50) {
+				word = pick(tc, wordChars)
+			}
+			safe = safe && wsafe
+			b.WriteString("${" + pick(tc, names) + op + word + "}")
+			afterName = false
+		default: // an invalid form (only at the top level, at most once)
+			if depth == 0 {
+				b.WriteString(pick(tc, invalidForms))
+				safe = false
+				afterName = false
+			}
+		}
+	}
+	if depth > 0 && strings.HasPrefix(b.String(), "}") {
+		return "x" + b.String(), safe
+	}
+	return b.String(), safe
+}
+
+// --------------------------------------------------------------------------- bash
+
+// bashExpand expands the template as bash does inside double quotes ($$ becomes \$); the
+// environment is env. exit code 1 with "parameter null or not set" is the required-variable
+// error.
+func bashExpand(t string) (string, error) {
+	var e []string
+	for k, v := range env {
+		e = append(e, k+"="+v)
+	}
+	cmd := exec.Command("bash", "-c", `printf '%s' "`+strings.ReplaceAll(t, "$$", `\$`)+`"`)
+	cmd.Env = append([]string{"PATH=/usr/bin:/bin"}, e...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("%v: %s", err, strings.TrimSpace(string(out)))
+	}
+	return string(out), nil
+}
