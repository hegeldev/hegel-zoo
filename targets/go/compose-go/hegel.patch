diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..9783a60
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,472 @@
+package hegel
+
+// A model of the Compose specification's interpolation syntax (12-interpolation.md, plus the
+// ${VAR:+alt}/${VAR+alt} forms documented by Docker), a generator of templates and the bash
+// oracle.
+
+import (
+	"errors"
+	"fmt"
+	"os/exec"
+	"sort"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- environment
+
+// env is the mapping: set variables with plain, empty and dollar-containing values; U, V and W
+// are unset.
+var env = map[string]string{
+	"A":   "alpha",
+	"B":   "b b",
+	"E":   "",
+	"D":   "$X",
+	"H":   "${A}",
+	"F":   "a}b",
+	"n1":  "1",
+	"MiX": "m",
+	"_u":  "under",
+}
+
+var names = []string{"A", "B", "E", "D", "H", "F", "n1", "MiX", "_u", "U", "V", "W"}
+
+func mapping(k string) (string, bool) { v, ok := env[k]; return v, ok }
+
+// --------------------------------------------------------------------------- model
+
+type missingErr struct{ name, reason string }
+type invalidErr struct{}
+
+func (e *missingErr) Error() string { return "required " + e.name + ": " + e.reason }
+func (e *invalidErr) Error() string { return "invalid template" }
+
+func isNameStart(c byte) bool { return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
+func isNameChar(c byte) bool  { return isNameStart(c) || (c >= '0' && c <= '9') }
+
+// variable is what ExtractVariables reports for one occurrence.
+type variable struct {
+	name, def, presence string
+	required            bool
+	inMessage           bool // occurs only inside a ?-message
+}
+
+// model parses and evaluates a template lazily: words are evaluated only when the operator
+// selects them, and the first error in evaluation order is returned.
+type model struct {
+	s             string
+	newlineInWord bool
+	invalid       bool // an invalid form occurs somewhere, whichever error is reported first
+	vars          []variable
+}
+
+// run evaluates the whole template.
+func (m *model) run() (string, error) { return m.runFrom(false) }
+
+// dollar handles the text at a '$' at position i, returning its value and the next position.
+// Values of substitutions are never re-expanded.
+func (m *model) dollar(i int, inMessage bool) (string, int, error) {
+	if i+1 >= len(m.s) {
+		return "$", i + 1, nil // a lone $ is preserved
+	}
+	c := m.s[i+1]
+	switch {
+	case c == '$':
+		return "$", i + 2, nil
+	case isNameStart(c):
+		j := i + 1
+		for j < len(m.s) && isNameChar(m.s[j]) {
+			j++
+		}
+		name := m.s[i+1 : j]
+		m.vars = append(m.vars, variable{name: name, inMessage: inMessage})
+		v, _ := mapping(name)
+		return v, j, nil
+	case c == '{':
+		return m.braced(i+2, inMessage)
+	}
+	return "$", i + 1, nil // "$ ", "$1": preserved
+}
+
+// braced parses from just after "${".
+func (m *model) braced(i int, inMessage bool) (string, int, error) {
+	j := i
+	for j < len(m.s) && isNameChar(m.s[j]) {
+		j++
+	}
+	name := m.s[i:j]
+	if name == "" || !isNameStart(name[0]) || j >= len(m.s) {
+		return "", 0, &invalidErr{}
+	}
+	if m.s[j] == '}' {
+		m.vars = append(m.vars, variable{name: name, inMessage: inMessage})
+		v, _ := mapping(name)
+		return v, j + 1, nil
+	}
+	op := ""
+	if m.s[j] == ':' {
+		op = ":"
+		j++
+		if j >= len(m.s) {
+			return "", 0, &invalidErr{}
+		}
+	}
+	switch m.s[j] {
+	case '-', '+', '?':
+		op += string(m.s[j])
+		j++
+	default:
+		return "", 0, &invalidErr{}
+	}
+	// the word extends to the matching '}', nested ${...} included
+	start := j
+	depth := 0
+	for j < len(m.s) {
+		if m.s[j] == '$' && j+1 < len(m.s) && m.s[j+1] == '{' {
+			depth++
+			j += 2
+			continue
+		}
+		if m.s[j] == '$' && j+1 < len(m.s) && m.s[j+1] == '$' {
+			j += 2
+			continue
+		}
+		if m.s[j] == '}' {
+			if depth == 0 {
+				break
+			}
+			depth--
+		}
+		if m.s[j] == '\n' {
+			m.newlineInWord = true
+		}
+		j++
+	}
+	if j >= len(m.s) {
+		return "", 0, &invalidErr{}
+	}
+	word := m.s[start:j]
+	end := j + 1
+	value, set := mapping(name)
+	v := variable{name: name, inMessage: inMessage}
+	switch op {
+	case ":-", "-":
+		v.def = word
+	case ":+", "+":
+		v.presence = word
+	default:
+		v.required = true
+	}
+	m.vars = append(m.vars, v)
+	// the word's own variables count for ExtractVariables whether or not it is evaluated
+	sub := &model{s: word}
+	subVal, subErr := sub.runFrom(inMessage || op == "?" || op == ":?")
+	m.newlineInWord = m.newlineInWord || sub.newlineInWord
+	m.invalid = m.invalid || sub.invalid
+	m.vars = append(m.vars, sub.vars...)
+	useWord := false
+	switch op {
+	case ":-":
+		useWord = !set || value == ""
+	case "-":
+		useWord = !set
+	case ":+":
+		useWord = set && value != ""
+		if !useWord {
+			value = ""
+		}
+	case "+":
+		useWord = set
+		if !useWord {
+			value = ""
+		}
+	case ":?":
+		if !set || value == "" {
+			if subErr != nil {
+				return "", end, subErr
+			}
+			return "", end, &missingErr{name, subVal}
+		}
+	case "?":
+		if !set {
+			if subErr != nil {
+				return "", end, subErr
+			}
+			return "", end, &missingErr{name, subVal}
+		}
+	}
+	if useWord {
+		if subErr != nil {
+			return "", end, subErr
+		}
+		return subVal, end, nil
+	}
+	return value, end, nil
+}
+
+// runFrom evaluates the template; the first error is returned, but parsing goes on after a
+// required-variable error (as compose-go's substitution does, and as its extraction, which is
+// purely syntactic, needs), and stops at an invalid template.
+func (m *model) runFrom(inMessage bool) (string, error) {
+	var b strings.Builder
+	var first error
+	i := 0
+	for i < len(m.s) {
+		c := m.s[i]
+		if c != '$' {
+			b.WriteByte(c)
+			i++
+			continue
+		}
+		v, n, err := m.dollar(i, inMessage)
+		if err != nil {
+			if first == nil {
+				first = err
+			}
+			if errors.As(err, new(*invalidErr)) {
+				m.invalid = true
+				return "", first
+			}
+		}
+		b.WriteString(v)
+		i = n
+	}
+	if first != nil {
+		return "", first
+	}
+	return b.String(), nil
+}
+
+// extracted combines the occurrences the way ExtractVariables documents: required as soon as
+// one occurrence is, the default and presence value of the first occurrence defining one.
+type extracted struct {
+	def, presence string
+	required      bool
+	defs, press   int // number of distinct non-empty candidates
+}
+
+func (m *model) extracted() map[string]*extracted {
+	out := map[string]*extracted{}
+	for _, v := range m.vars {
+		e := out[v.name]
+		if e == nil {
+			e = &extracted{}
+			out[v.name] = e
+		}
+		e.required = e.required || v.required
+		if v.def != "" {
+			if e.def == "" {
+				e.def = v.def
+			}
+			if e.def != v.def || e.defs == 0 {
+				e.defs++
+			}
+		}
+		if v.presence != "" {
+			if e.presence == "" {
+				e.presence = v.presence
+			}
+			if e.presence != v.presence || e.press == 0 {
+				e.press++
+			}
+		}
+	}
+	return out
+}
+
+// knownSubstitute names the recorded bug whose shape the template has for Substitute, or "":
+// a newline inside a word (compose-go/1). known adds the shapes ExtractVariables meets: the
+// same newline (the library reports a variable with an empty name for what it reads as a
+// stray "${"), a variable inside a ?-message (compose-go/2), a variable with two distinct
+// default or presence values in one string (compose-go/3). By default the properties draw
+// these shapes and name them in the failure; under HEGEL_NO_KNOWN=1 a disagreement on one is
+// skipped (see mismatch).
+func (m *model) knownSubstitute() string {
+	if m.newlineInWord {
+		return "compose-go/1"
+	}
+	return ""
+}
+
+func (m *model) known() string {
+	if shape := m.knownSubstitute(); shape != "" {
+		return shape
+	}
+	for _, v := range m.vars {
+		if v.inMessage {
+			return "compose-go/2"
+		}
+	}
+	for _, e := range m.extracted() {
+		if e.defs > 1 || e.press > 1 {
+			return "compose-go/3"
+		}
+	}
+	return ""
+}
+
+func sortedKeys[T any](m map[string]T) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// --------------------------------------------------------------------------- generator
+
+// A template is generated as data, a list of pieces nesting to depth two, and rendered to text
+// by render; the model then parses the rendered text, so a fragment generated as invalid that
+// happens to be valid in context is judged by the rules the library sees. The shapes of the
+// recorded bugs are drawn at their natural rate, so the properties that meet them fail and are
+// the expected failures; HEGEL_NO_KNOWN=1 (noKnown) leaves the shapes out.
+
+// literal alphabets: outside words braces are literal; inside words they are left out (the
+// specification says nothing about bare braces in a default; bash and compose-go differ). A
+// newline inside a word is the shape of compose-go/1: drawn by default, left out under
+// HEGEL_NO_KNOWN=1.
+const outerChars = "abx1 -:./}{?+=,\n'\\!#%@~\t"
+const plainWordChars = "abx1 -:./?+=,!#%@~"
+
+var wordChars = shaped(plainWordChars+"\n", plainWordChars)
+
+var ops = []string{":-", "-", ":+", "+", ":?", "?"}
+
+var invalidForms = []string{"${", "${}", "${1x}", "${A B}", "${A:x}", "${A!}", "${A:}", "${A::-x}", "${-x}", "${:-x}", "${A.b}", "${ A}"}
+
+type pieceKind int
+
+const (
+	literalRun pieceKind = iota // a run of literal characters
+	verbatim                    // "$$", "$$x", "${NAME}" or an invalid form, written as is
+	dollarName                  // $NAME
+	opForm                      // ${NAME op word}
+)
+
+// piece is one element of a template.
+type piece struct {
+	kind pieceKind
+	text string // the literal run or verbatim text; the variable name of $NAME and ${NAME op word}
+	op   string
+	word []piece
+}
+
+var varName = hegel.SampledFrom(names)
+
+func asPiece(kind pieceKind) func(string) piece {
+	return func(s string) piece { return piece{kind: kind, text: s} }
+}
+
+// plainWords is a word of literal runs only.
+var plainWords hegel.Generator[[]piece] = hegel.Lists(hegel.Map(text(wordChars, 1, 4), asPiece(literalRun))).MaxSize(5)
+
+// operatorsOf is ${NAME op word} over the given names and words; the word of a ?-message is
+// any word, or under HEGEL_NO_KNOWN=1 literal runs only (a variable inside a message is the
+// shape of compose-go/2).
+func operatorsOf(names hegel.Generator[string], word hegel.Generator[[]piece]) hegel.Generator[piece] {
+	message := shaped(word, plainWords)
+	return hegel.Composite(func(tc hegel.TestCase) piece {
+		name, op := hegel.Draw(tc, names), hegel.Draw(tc, hegel.SampledFrom(ops))
+		w := word
+		if strings.HasSuffix(op, "?") {
+			w = message
+		}
+		return piece{kind: opForm, text: name, op: op, word: hegel.Draw(tc, w)}
+	})
+}
+
+// pieces generates the pieces of a template at the given depth (a top-level template has one
+// to six, a word none to five); words nest to depth two, where they are at most one literal
+// character. Invalid forms occur only at the top level and only when invalid is set; backslash
+// selects whether literal runs may contain one (the bash oracle cannot run either).
+func pieces(depth int, invalid, backslash bool) hegel.Generator[[]piece] {
+	chars := wordChars
+	if depth == 0 {
+		chars = outerChars
+	}
+	if !backslash {
+		chars = strings.ReplaceAll(chars, `\`, "")
+	}
+	literal := hegel.Map(text(chars, 1, 4), asPiece(literalRun))
+	escaped := hegel.Just(piece{kind: verbatim, text: "$$"})
+	if depth > 0 {
+		// never "$${" inside a word
+		escaped = weighted(choice[piece]{70, escaped}, choice[piece]{30, hegel.Just(piece{kind: verbatim, text: "$$x"})})
+	}
+	dollar := hegel.Map(varName, asPiece(dollarName))
+	braced := hegel.Map(varName, func(n string) piece { return piece{kind: verbatim, text: "${" + n + "}"} })
+	var word hegel.Generator[[]piece]
+	if depth < 2 {
+		word = pieces(depth+1, invalid, backslash)
+	} else {
+		word = hegel.Lists(hegel.Map(text(wordChars, 1, 1), asPiece(literalRun))).MaxSize(1)
+	}
+	operator := operatorsOf(varName, word)
+	alternatives := []choice[piece]{{30, literal}, {8, escaped}, {17, dollar}, {13, braced}, {26, operator}}
+	switch {
+	case depth == 0 && invalid:
+		alternatives = append(alternatives, choice[piece]{6, hegel.Map(hegel.SampledFrom(invalidForms), asPiece(verbatim))})
+	case depth >= 2:
+		alternatives[4].weight = 32
+	}
+	lo, hi := 0, 5
+	if depth == 0 {
+		lo, hi = 1, 6
+	}
+	return hegel.Lists(weighted(alternatives...)).MinSize(lo).MaxSize(hi)
+}
+
+// render writes the template's text. A literal run starting with a name character directly
+// after $NAME would extend the name: a space keeps them apart.
+func render(ps []piece) string {
+	var b strings.Builder
+	afterName := false
+	for _, p := range ps {
+		switch p.kind {
+		case literalRun:
+			if afterName && isNameChar(p.text[0]) {
+				b.WriteByte(' ')
+			}
+			b.WriteString(p.text)
+		case verbatim:
+			b.WriteString(p.text)
+		case dollarName:
+			b.WriteString("$" + p.text)
+		case opForm:
+			b.WriteString("${" + p.text + p.op + render(p.word) + "}")
+		}
+		afterName = p.kind == dollarName
+	}
+	return b.String()
+}
+
+var (
+	// anyTemplate is the whole language, invalid forms and backslashes included.
+	anyTemplate = hegel.Map(pieces(0, true, true), render)
+	// wellFormed leaves out the invalid forms (ExtractVariables of an invalid template is not
+	// a case callers reach, since Substitute fails first).
+	wellFormed = hegel.Map(pieces(0, false, true), render)
+	// bashTemplate is what the bash oracle can run: no invalid forms, no backslashes.
+	bashTemplate = hegel.Map(pieces(0, false, false), render)
+)
+
+// --------------------------------------------------------------------------- bash
+
+// bashExpand expands the template as bash does inside double quotes ($$ becomes \$); the
+// environment is env. exit code 1 with "parameter null or not set" is the required-variable
+// error.
+func bashExpand(t string) (string, error) {
+	var e []string
+	for k, v := range env {
+		e = append(e, k+"="+v)
+	}
+	cmd := exec.Command("bash", "-c", `printf '%s' "`+strings.ReplaceAll(t, "$$", `\$`)+`"`)
+	cmd.Env = append([]string{"PATH=/usr/bin:/bin"}, e...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("%v: %s", err, strings.TrimSpace(string(out)))
+	}
+	return string(out), nil
+}
