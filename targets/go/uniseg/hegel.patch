+// TestHegelPinEmojiModifierSequencesAreTwoCellsWide pins uniseg/1: a text-presentation
+// Extended Pictographic followed by an emoji modifier or a ZWJ sequence keeps width 1, although
+// the documentation says any additional code point forces a total width of 2.
+func TestHegelPinEmojiModifierSequencesAreTwoCellsWide(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"☝🏻", "✌🏿", "©‍©", "❤‍🔥", "🏳‍🌈"} {
+		if _, _, w, _ := uniseg.FirstGraphemeClusterInString(s, -1); w != 2 {
+			t.Errorf("width of %q (%d code points, one cluster) = %d, want 2", s, utf8.RuneCountInString(s), w)
+		}
+	}
+}
+
+// TestHegelPinHangulSyllableWithTrailingJamoIsTwoCellsWide pins uniseg/2: a precomposed LV or
+// LVT syllable followed by a trailing jamo is one cluster of width 3, although the documentation
+// gives Hangul clusters the width of their first code point.
+func TestHegelPinHangulSyllableWithTrailingJamoIsTwoCellsWide(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"각", "각ᆨ", "힣ᇿ", "각ᆩ"} {
+		if got := uniseg.StringWidth(s); got != 2 {
+			t.Errorf("StringWidth(%q) = %d, want 2 (%d clusters)", s, got, uniseg.GraphemeClusterCount(s))
+		}
+	}
+}
+
+// TestHegelPinStepReportsTheBoundariesInsideClusters pins uniseg/3: UAX #29 and #14 place
+// word, sentence and line boundaries inside some grapheme clusters (after a Prepend character,
+// which is Format for word breaking; before an emoji modifier following a non-emoji base),
+// FirstWord/FirstSentence/FirstLineSegment report them, but Step and Graphemes only flag
+// cluster ends, so they yield different words, sentences and line segments.
+func TestHegelPinStepReportsTheBoundariesInsideClusters(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		s     string
+		words []int
+	}{
+		{"؀낙", []int{2}},          // ARABIC NUMBER SIGN (Prepend/Format) + Hangul syllable: two words, one cluster
+		{"࢐ᄁ", []int{3}},          // ARABIC POUND MARK ABOVE (Prepend) + jamo
+		{"a؀b", []int{}},          // Format between letters attaches (WB4): one word — a cluster end without a word boundary is fine
+		{"\U00011A3Aa", []int{4}}, // Zanabazar Square cluster-initial letter (Prepend)
+	} {
+		want := chain(tt.s, uniseg.FirstWordInString)
+		if !eqInts(want, tt.words) {
+			t.Errorf("FirstWordInString(%q) boundaries = %v, want %v (UAX #29)", tt.s, want, tt.words)
+		}
+		got := ends(stepAll([]byte(tt.s)), func(c segCluster) bool { return c.word })
+		if !eqInts(got, want) {
+			t.Errorf("Step word boundaries of %q = %v, FirstWord says %v", tt.s, got, want)
+		}
+	}
+	s := "a. 🏼B"
+	if got, want := ends(stepAll([]byte(s)), func(c segCluster) bool { return c.sent }), chain(s, uniseg.FirstSentenceInString); !eqInts(got, want) {
+		t.Errorf("Step sentence boundaries of %q = %v, FirstSentence says %v", s, got, want)
+	}
+}
+
+// TestHegelPinNoMandatoryBreakAfterAnEmojiModifierSequence pins uniseg/4: after an emoji
+// modifier sequence (Emoji_Modifier_Base + Emoji_Modifier, LB30b) followed by anything, the
+// break opportunity is reported as mandatory (LineMustBreak) although only BK, CR, LF and NL
+// force a line break (LB4, LB5).
+func TestHegelPinNoMandatoryBreakAfterAnEmojiModifierSequence(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"👧🏼a", "🧑🏽 b", "☝🏿, c", "a👧🏼b"} {
+		state := -1
+		rest := s
+		pos := 0
+		for len(rest) > 0 {
+			var seg string
+			var must bool
+			seg, rest, must, state = uniseg.FirstLineSegmentInString(rest, state)
+			pos += len(seg)
+			if must && len(rest) > 0 {
+				t.Errorf("FirstLineSegmentInString(%q) reports a mandatory break after %q", s, s[:pos])
+			}
+		}
+		for _, c := range stepAll([]byte(s)) {
+			if c.end < len(s) && c.line == uniseg.LineMustBreak {
+				t.Errorf("Step reports LineMustBreak after %q in %q", s[c.start:c.end], s)
+			}
+		}
+	}
+}
+
+// TestHegelPinSentenceLookAheadReadsPastReplacementCharacters pins uniseg/5: the SB8 look-ahead
+// after an ATerm stops at the first U+FFFD (a replacement character in the text or a byte that
+// is not UTF-8) as if the text had ended, so the following lower-case letter is never seen and
+// a sentence boundary is inserted.
+func TestHegelPinSentenceLookAheadReadsPastReplacementCharacters(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"a. �� b", "a. \xff\xff b", "a. (\xc0\x80 b", "a. x� b"} {
+		if got := chain(s, uniseg.FirstSentenceInString); len(got) != 0 {
+			t.Errorf("FirstSentenceInString splits %q at %v, want one sentence (SB8, as for %q which gives %v)", s, got, "a. x b", chain("a. x b", uniseg.FirstSentenceInString))
+		}
+	}
+}
+
+// TestHegelPinSentenceTerminatorBeforeCRLF pins uniseg/6: after a sentence terminator, a CR LF
+// pair is split (SB3) and, with spaces in between, the break lands before the CR instead of
+// after the LF (SB10, SB11).
+func TestHegelPinSentenceTerminatorBeforeCRLF(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		s    string
+		want []int
+	}{
+		{"a!\r\nb", []int{4}},
+		{"a.\r\nb", []int{4}},
+		{"a! \r\nb", []int{5}},
+		{"a!)\r\nb", []int{5}},
+		{"a!  b", []int{6}},
+		{"a\r\nb", []int{3}},
+	} {
+		if got := chain(tt.s, uniseg.FirstSentenceInString); !eqInts(got, tt.want) {
+			t.Errorf("FirstSentenceInString splits %q at %v, want %v", tt.s, got, tt.want)
+		}
+	}
+}
+
+// TestHegelPinMandatoryBreakSurvivesAHyphenAndDigit pins uniseg/7: the mandatory line break
+// after CR, LF or a paragraph separator disappears when the next line starts with a hyphen and
+// a digit (the LB25 look-ahead overrides LB4/LB5).
+func TestHegelPinMandatoryBreakSurvivesAHyphenAndDigit(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		s    string
+		flag int
+	}{
+		{"a\n-0", uniseg.LineMustBreak},
+		{"a\r-1", uniseg.LineMustBreak},
+		{"a\u2028-9", uniseg.LineMustBreak},
+		{"a\r\n-5", uniseg.LineMustBreak},
+		{"a -0", uniseg.LineCanBreak}, // LB18: SP ÷; LB25 does not reach back over the space
+		{"a\n-x", uniseg.LineMustBreak},
+		{"a\n0", uniseg.LineMustBreak},
+	} {
+		s := tt.s
+		steps := stepAllString(s)
+		if len(steps) < 2 {
+			t.Fatalf("Step gives %d clusters for %q", len(steps), s)
+		}
+		wantSeg := []int{steps[1].end}
+		if steps[1].line != tt.flag {
+			t.Errorf("Step line flag after %q in %q is %d, want %d", s[:steps[1].end], s, steps[1].line, tt.flag)
+		}
+		if got := chain(s, func(s string, st int) (string, string, int) {
+			a, b, _, c := uniseg.FirstLineSegmentInString(s, st)
+			return a, b, c
+		}); len(got) == 0 || got[0] != wantSeg[0] {
+			t.Errorf("FirstLineSegmentInString cuts %q at %v, want the first cut at %v", s, got, wantSeg)
+		}
+	}
+}
+
+// TestHegelPinZWJBetweenSpacesDoesNotJoinThem pins uniseg/8: WB3d (WSegSpace × WSegSpace)
+// precedes WB4, so a ZWJ between two spaces leaves a word boundary before the second space, as
+// U+0308 does; the package joins the spaces through the ZWJ only.
+func TestHegelPinZWJBetweenSpacesDoesNotJoinThem(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		s    string
+		want []int
+	}{
+		{" ‍ ", []int{4}},
+		{" ̈ ", []int{3}},
+		{"a ‍ b", []int{1, 5, 6}},
+		{"a ̈ b", []int{1, 4, 5}},
+	} {
+		if got := chain(tt.s, uniseg.FirstWordInString); !eqInts(got, tt.want) {
+			t.Errorf("FirstWordInString splits %q at %v, want %v", tt.s, got, tt.want)
+		}
+		if got := ends(stepAllString(tt.s), func(c segCluster) bool { return c.word }); !eqInts(got, tt.want) {
+			t.Errorf("Step word boundaries of %q at %v, want %v", tt.s, got, tt.want)
+		}
+	}
+}
