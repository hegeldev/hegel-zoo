+// TestHegelReverseStringReversesClusters: ReverseString keeps every cluster intact and reverses
+// their order; it is an involution and preserves the cluster count and width.
+func TestHegelReverseStringReversesClusters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, samples)
+		steps := stepAll([]byte(s.text))
+		var want strings.Builder
+		for i := len(steps) - 1; i >= 0; i-- {
+			want.WriteString(s.text[steps[i].start:steps[i].end])
+		}
+		got := uniseg.ReverseString(s.text)
+		if got != want.String() {
+			fail(ht, "ReverseString(%q) = %q, want the clusters reversed %q", s.text, got, want.String())
+		}
+		// Reversal can join clusters (a leading combining mark lands after a base), so the
+		// reverse is an involution only when the reversed text re-segments into the same clusters.
+		back := stepAll([]byte(got))
+		same := len(back) == len(steps)
+		for i := range back {
+			if !same {
+				break
+			}
+			j := len(steps) - 1 - i
+			same = got[back[i].start:back[i].end] == s.text[steps[j].start:steps[j].end]
+		}
+		if same {
+			if again := uniseg.ReverseString(got); again != s.text {
+				fail(ht, "ReverseString(ReverseString(%q)) = %q", s.text, again)
+			}
+		} else {
+			note(ht, "clusters change on reversal: %d -> %d", len(steps), len(back))
+		}
+	})
+}
