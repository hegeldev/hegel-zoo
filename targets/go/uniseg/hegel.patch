+// ---- fixed examples ------------------------------------------------------------------------
+
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		s     string
+		count int
+		width int
+	}{
+		{"🏳️‍🌈", 1, 2},
+		{"👨‍👩‍👧‍👦", 1, 2},
+		{"🇩🇰🇯🇵", 2, 4},
+		{"각", 1, 2},
+		{"각", 1, 2},
+		{"ä", 1, 1},
+		{"\r\n", 1, 0},
+		{"つのだ☆HIRO", 8, 11},
+		{"⸺⸻", 2, 7},
+		{"☝️", 1, 2},
+		{"☝︎", 1, 1},
+	} {
+		if got := uniseg.GraphemeClusterCount(tt.s); got != tt.count {
+			t.Errorf("GraphemeClusterCount(%q) = %d, want %d", tt.s, got, tt.count)
+		}
+		if got := uniseg.StringWidth(tt.s); got != tt.width {
+			t.Errorf("StringWidth(%q) = %d, want %d", tt.s, got, tt.width)
+		}
+	}
+	if got := uniseg.ReverseString("The 🏳️‍🌈 flag"); got != "galf 🏳️‍🌈 ehT" {
+		t.Errorf("ReverseString = %q", got)
+	}
+	words := chain("Hello, world! Isn't it 3.14?", uniseg.FirstWordInString)
+	if !eqInts(words, []int{5, 6, 7, 12, 13, 14, 19, 20, 22, 23, 27}) {
+		t.Errorf("word boundaries = %v", words)
+	}
+	if !bytes.Equal([]byte(uniseg.ReverseString("ab")), []byte("ba")) {
+		t.Errorf("ReverseString(ab)")
+	}
+}
