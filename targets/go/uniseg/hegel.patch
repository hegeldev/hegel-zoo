+// Hegel properties for github.com/rivo/uniseg (see README.md in the zoo target).
+//
+// Oracle: a Python reference implementation of the Unicode 15.0.0 grapheme cluster, word and
+// sentence boundary rules (UAX #29) written from the annex, plus the package's documented
+// monospace width rules, all reading the UCD 15.0.0 property files (GraphemeBreakProperty,
+// WordBreakProperty, SentenceBreakProperty, EastAsianWidth, emoji-data) from
+// ~/.cache/hegel-zoo/ucd-15.0.0/ (fetched by the target's [run] setup; HEGEL_UCD overrides the
+// directory). The reference passes the three UCD break-test files with zero mismatches; the
+// package embeds those same files as its own tests, so the properties add random text over every
+// property class, invalid UTF-8, the entry points against each other (Step, StepString, the
+// First* functions, the Graphemes iterator, GraphemeClusterCount, StringWidth, ReverseString),
+// and line segments against the Step flags.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate by the wide
+// properties, which fail on them naming the shape and are the expected failures mapped to the
+// bugs (STYLE.md rule 11), and on purpose by one narrow property per bug; the pins hold the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a
+// run that looks past the bugs.
+//
+// UNISEG_COLLECT=1 turns failures into a summary printed at the end (shortest first).
+package uniseg_test
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+var (
+	collectMode = os.Getenv("UNISEG_COLLECT") != ""
+	collectMu   sync.Mutex
+	collectMsgs []string
+)
+
+type collected struct{}
+
+// fail reports a property failure; in collect mode it records the message and ends the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collectMode {
+		collectMu.Lock()
+		collectMsgs = append(collectMsgs, msg)
+		collectMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+	if collectMode {
+		collectMu.Lock()
+		msgs := append([]string(nil), collectMsgs...)
+		collectMsgs = nil
+		collectMu.Unlock()
+		sort.Slice(msgs, func(i, j int) bool { return len(msgs[i]) < len(msgs[j]) })
+		t.Logf("COLLECT %s: %d failures", t.Name(), len(msgs))
+		for i, m := range msgs {
+			if i == 40 {
+				t.Logf("  ... %d more", len(msgs)-40)
+				break
+			}
+			t.Logf("  %s", m)
+		}
+	}
+}
+
+// ---- known shapes --------------------------------------------------------------------------
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// wide properties draw the bugs' shapes at their natural rate and fail on them, naming the
+// shape (mismatch), and the narrow properties draw each bug's shape region on purpose. Under
+// HEGEL_NO_KNOWN=1 the narrow properties draw the neighbouring region past the bug instead
+// (shaped) and a check whose mismatch has a known shape is skipped (mismatch), the rest of the
+// case being judged as usual.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the generator (or value) of a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, of the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// isBug reports whether a shape the oracle names is a recorded bug; the other names are shapes
+// the documentation leaves open (the *_skip functions of the oracle), which are never judged.
+func isBug(shape string) bool { return strings.HasPrefix(shape, "uniseg/") }
+
+// open notes a check left unjudged because the documentation leaves its shape open, and
+// reports whether it was ("" and a recorded bug's shape are judged).
+func open(ht *hegel.T, what, shape string) bool {
+	if shape == "" || isBug(shape) {
+		return false
+	}
+	note(ht, "%s not judged: %s", what, shape)
+	return true
+}
+
+// mismatch reports a disagreement with the oracle, naming the recorded bugs whose shape the
+// case has (shapes may hold "" entries for none). Under HEGEL_NO_KNOWN=1 a disagreement that
+// has a known shape is noted and the check skipped, the rest of the case being judged.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	var named []string
+	for _, s := range shapes {
+		if s != "" && !slices.Contains(named, s) {
+			named = append(named, s)
+		}
+	}
+	if len(named) > 0 {
+		format += " (the shape of " + strings.Join(named, ", ") + ")"
+		if noKnown {
+			note(ht, "not judged: "+format, args...)
+			return
+		}
+	}
+	fail(ht, format, args...)
+}
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// guard turns a panic in a pin into a failure message instead of killing the test binary.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---- the oracle: a Python reference of UAX #29 and the documented widths ------------------
+
+const pyScript = `import sys, json, os, bisect, re
+
+UCD = os.environ.get("HEGEL_UCD") or os.path.join(os.path.expanduser("~"), ".cache", "hegel-zoo", "ucd-15.0.0")
+
+def load_ranges(name, prop_filter=None):
+    """Return sorted (lo, hi, value) triples from a UCD file. prop_filter keeps only lines whose
+    value equals it (emoji-data lists several properties in one file)."""
+    out = []
+    with open(os.path.join(UCD, name), encoding="utf-8") as f:
+        for line in f:
+            line = line.split("#", 1)[0].strip()
+            if not line:
+                continue
+            fields = [x.strip() for x in line.split(";")]
+            cp, val = fields[0], fields[1]
+            if prop_filter is not None and val != prop_filter:
+                continue
+            if ".." in cp:
+                lo, hi = cp.split("..")
+            else:
+                lo = hi = cp
+            out.append((int(lo, 16), int(hi, 16), val))
+    out.sort()
+    return out
+
+class Table:
+    def __init__(self, ranges, default):
+        self.los = [r[0] for r in ranges]
+        self.ranges = ranges
+        self.default = default
+    def __call__(self, cp):
+        i = bisect.bisect_right(self.los, cp) - 1
+        if i >= 0 and self.ranges[i][0] <= cp <= self.ranges[i][1]:
+            return self.ranges[i][2]
+        return self.default
+
+GBP = Table(load_ranges("GraphemeBreakProperty.txt"), "Other")
+WBP = Table(load_ranges("WordBreakProperty.txt"), "Other")
+SBP = Table(load_ranges("SentenceBreakProperty.txt"), "Other")
+EAW = Table(load_ranges("EastAsianWidth.txt"), "N")
+EXTPICT = Table(load_ranges("emoji-data.txt", "Extended_Pictographic"), None)
+EMOJIPRES = Table(load_ranges("emoji-data.txt", "Emoji_Presentation"), None)
+
+def gcls(cp):
+    c = GBP(cp)
+    if c == "Other" and EXTPICT(cp):
+        return "ExtPict"
+    return c
+
+# ---- UAX #29 grapheme cluster boundaries, Unicode 15.0 ----------------------------------
+
+def grapheme_breaks(cps):
+    """Indices i (0 < i < n) before which a grapheme cluster boundary falls."""
+    cls = [gcls(c) for c in cps]
+    breaks = []
+    for i in range(1, len(cps)):
+        l, r = cls[i - 1], cls[i]
+        if l == "CR" and r == "LF":
+            continue  # GB3
+        if l in ("Control", "CR", "LF"):
+            breaks.append(i); continue  # GB4
+        if r in ("Control", "CR", "LF"):
+            breaks.append(i); continue  # GB5
+        if l == "L" and r in ("L", "V", "LV", "LVT"):
+            continue  # GB6
+        if l in ("LV", "V") and r in ("V", "T"):
+            continue  # GB7
+        if l in ("LVT", "T") and r == "T":
+            continue  # GB8
+        if r in ("Extend", "ZWJ"):
+            continue  # GB9
+        if r == "SpacingMark":
+            continue  # GB9a
+        if l == "Prepend":
+            continue  # GB9b
+        if l == "ZWJ" and r == "ExtPict":
+            j = i - 2
+            while j >= 0 and cls[j] == "Extend":
+                j -= 1
+            if j >= 0 and cls[j] == "ExtPict":
+                continue  # GB11
+        if l == "Regional_Indicator" and r == "Regional_Indicator":
+            j = i - 1
+            n = 0
+            while j >= 0 and cls[j] == "Regional_Indicator":
+                n += 1; j -= 1
+            if n % 2 == 1:
+                continue  # GB12/GB13
+        breaks.append(i)  # GB999
+    return breaks
+
+# ---- UAX #29 word boundaries, Unicode 15.0 ----------------------------------------------
+
+WB_IGNORE = ("Extend", "Format", "ZWJ")
+AH = ("ALetter", "Hebrew_Letter")
+MIDNUMLETQ = ("MidNumLet", "Single_Quote")
+
+def word_breaks(cps):
+    cls = [WBP(c) for c in cps]
+    extpict = [bool(EXTPICT(c)) for c in cps]
+    n = len(cps)
+    # skeleton: indices of non-ignorable code points
+    skel = [i for i in range(n) if cls[i] not in WB_IGNORE]
+    def skel_cls(k):  # class of skeleton element k, "sot"/"eot" outside
+        if k < 0:
+            return "sot"
+        if k >= len(skel):
+            return "eot"
+        return cls[skel[k]]
+    breaks = []
+    for i in range(1, n):
+        l, r = cls[i - 1], cls[i]
+        if l == "CR" and r == "LF":
+            continue  # WB3
+        if l in ("Newline", "CR", "LF"):
+            breaks.append(i); continue  # WB3a
+        if r in ("Newline", "CR", "LF"):
+            breaks.append(i); continue  # WB3b
+        if l == "ZWJ" and extpict[i]:
+            continue  # WB3c
+        if l == "WSegSpace" and r == "WSegSpace":
+            continue  # WB3d
+        if r in WB_IGNORE:
+            continue  # WB4
+        # position of r in the skeleton
+        k = bisect.bisect_left(skel, i)
+        L = skel_cls(k - 1) if k - 1 >= 0 else "sot"
+        if L == "sot" and k - 1 < 0:
+            # only ignorables before i: they behave as an Other
+            L = "Other" if i > 0 else "sot"
+        LL = skel_cls(k - 2) if k - 2 >= 0 else "sot"
+        R = r
+        RR = skel_cls(k + 1)
+        if L in AH and R in AH:
+            continue  # WB5
+        if L in AH and R in ("MidLetter",) + MIDNUMLETQ and RR in AH:
+            continue  # WB6
+        if L in ("MidLetter",) + MIDNUMLETQ and LL in AH and R in AH:
+            continue  # WB7
+        if L == "Hebrew_Letter" and R == "Single_Quote":
+            continue  # WB7a
+        if L == "Hebrew_Letter" and R == "Double_Quote" and RR == "Hebrew_Letter":
+            continue  # WB7b
+        if L == "Double_Quote" and LL == "Hebrew_Letter" and R == "Hebrew_Letter":
+            continue  # WB7c
+        if L == "Numeric" and R == "Numeric":
+            continue  # WB8
+        if L in AH and R == "Numeric":
+            continue  # WB9
+        if L == "Numeric" and R in AH:
+            continue  # WB10
+        if L in ("MidNum",) + MIDNUMLETQ and LL == "Numeric" and R == "Numeric":
+            continue  # WB11
+        if L == "Numeric" and R in ("MidNum",) + MIDNUMLETQ and RR == "Numeric":
+            continue  # WB12
+        if L == "Katakana" and R == "Katakana":
+            continue  # WB13
+        if L in AH + ("Numeric", "Katakana", "ExtendNumLet") and R == "ExtendNumLet":
+            continue  # WB13a
+        if L == "ExtendNumLet" and R in AH + ("Numeric", "Katakana"):
+            continue  # WB13b
+        if L == "Regional_Indicator" and R == "Regional_Indicator":
+            j = k - 1
+            cnt = 0
+            while j >= 0 and skel_cls(j) == "Regional_Indicator":
+                cnt += 1; j -= 1
+            if cnt % 2 == 1:
+                continue  # WB15/WB16
+        breaks.append(i)  # WB999
+    return breaks
+
+# ---- UAX #29 sentence boundaries, Unicode 15.0 ------------------------------------------
+
+SB_IGNORE = ("Extend", "Format")
+PARASEP = ("Sep", "CR", "LF")
+SATERM = ("STerm", "ATerm")
+
+def sentence_breaks(cps):
+    cls = [SBP(c) for c in cps]
+    n = len(cps)
+    skel = [i for i in range(n) if cls[i] not in SB_IGNORE]
+    def sc(k):
+        if k < 0:
+            return "sot"
+        if k >= len(skel):
+            return "eot"
+        return cls[skel[k]]
+    breaks = []
+    for i in range(1, n):
+        l, r = cls[i - 1], cls[i]
+        if l == "CR" and r == "LF":
+            continue  # SB3
+        if l in PARASEP:
+            breaks.append(i); continue  # SB4
+        if r in SB_IGNORE:
+            continue  # SB5
+        k = bisect.bisect_left(skel, i)
+        L = sc(k - 1) if k - 1 >= 0 else "Other"
+        LL = sc(k - 2)
+        R = r
+        if L == "ATerm" and R == "Numeric":
+            continue  # SB6
+        if LL in ("Upper", "Lower") and L == "ATerm" and R == "Upper":
+            continue  # SB7
+        # match backwards: Sp* Close* SATerm ending at skeleton k-1
+        j = k - 1
+        while j >= 0 and sc(j) == "Sp":
+            j -= 1
+        after_sp = j
+        while j >= 0 and sc(j) == "Close":
+            j -= 1
+        term = sc(j) if j >= 0 else None
+        if term in SATERM:
+            # SB8: ATerm Close* Sp* × (¬(OLetter|Upper|Lower|ParaSep|SATerm))* Lower
+            if term == "ATerm":
+                m = k
+                while m < len(skel) and sc(m) not in ("OLetter", "Upper", "Lower") + PARASEP + SATERM:
+                    m += 1
+                if m < len(skel) and sc(m) == "Lower":
+                    continue
+            if R in ("SContinue",) + SATERM:
+                continue  # SB8a
+            if after_sp == k - 1 and R in ("Close", "Sp") + PARASEP:
+                continue  # SB9 (no Sp consumed)
+            if R in ("Sp",) + PARASEP:
+                continue  # SB10
+            breaks.append(i); continue  # SB11
+        # SB998
+    return breaks
+
+# ---- monospace width as documented by uniseg -------------------------------------------
+
+def rune_width(cp, ambiguous):
+    c = gcls(cp)
+    if c in ("Control", "CR", "LF", "Extend", "ZWJ"):
+        return 0
+    if c == "Regional_Indicator":
+        return 2
+    if c == "ExtPict":
+        return 2 if EMOJIPRES(cp) else 1
+    if cp == 0x2E3A:
+        return 3
+    if cp == 0x2E3B:
+        return 4
+    e = EAW(cp)
+    if e in ("W", "F"):
+        return 2
+    if e == "A":
+        return ambiguous
+    return 1
+
+def cluster_width(cps, ambiguous):
+    first = gcls(cps[0])
+    if first in ("L", "LV", "LVT"):
+        return rune_width(cps[0], ambiguous)
+    if first == "Regional_Indicator":
+        return 2
+    if first == "ExtPict":
+        if len(cps) == 1:
+            return rune_width(cps[0], ambiguous)
+        if 0xFE0E in cps:
+            return 1
+        return 2
+    if len(cps) > 1 and cps[-1] == 0xFE0F:
+        return 2
+    return sum(rune_width(c, ambiguous) for c in cps)
+
+def width_skip(cps):
+    """Cluster shapes the width property names: the two recorded bugs (judged, the mismatch
+    naming them) and three shapes the documentation leaves open (not judged)."""
+    first = gcls(cps[0])
+    if len(cps) == 1:
+        return ""
+    if first == "ExtPict" and not EMOJIPRES(cps[0]) and 0xFE0E not in cps and 0xFE0F not in cps:
+        return "uniseg/1"
+    if first in ("L", "LV", "LVT") and any(gcls(c) not in ("L", "V", "T", "LV", "LVT") for c in cps[1:]):
+        # doc.go's Hangul rule is for clusters composed of conjoining jamo; with a mark or a ZWJ
+        # after the syllable the documented width is open (the sum, or the first code point's)
+        return "hangul-with-a-mark"
+    if first in ("LV", "LVT"):
+        return "uniseg/2"
+    if first in ("V", "T"):
+        return "jamo-without-lead"
+    if first != "ExtPict" and cps[-1] == 0xFE0F:
+        return "vs16-after-text"
+    return ""
+
+def sentence_skip(cps):
+    """Sentence shapes pinned separately: a terminator followed (through Close, Sp and
+    ignorables) by a paragraph separator (uniseg/6), and U+FFFD in the SB8 look-ahead after an
+    ATerm (uniseg/5)."""
+    cls = [SBP(c) for c in cps]
+    for i, c in enumerate(cls):
+        if c in SATERM:
+            j = i + 1
+            while j < len(cls) and cls[j] in ("Close", "Sp", "Extend", "Format"):
+                j += 1
+            if j < len(cls) and cls[j] in PARASEP:
+                return "uniseg/6"
+        if c == "ATerm" and 0xFFFD in cps[i + 1:]:
+            return "uniseg/5"
+    return ""
+
+def word_skip(cps):
+    """ZWJ, then Extend/Format, then an Extended_Pictographic: whether WB3c still applies across
+    the ignorables is not settled by the test files; not judged."""
+    for i, c in enumerate(cps):
+        if c == 0x200D:
+            j = i + 1
+            while j < len(cps) and WBP(cps[j]) in WB_IGNORE:
+                j += 1
+            if j > i + 1 and j < len(cps) and EXTPICT(cps[j]):
+                return "wb3c-across-ignorables"
+            if i > 0 and WBP(cps[i - 1]) == "WSegSpace" and j < len(cps) and WBP(cps[j]) == "WSegSpace":
+                return "uniseg/8"
+    return ""
+
+def info(cp):
+    return {"g": gcls(cp), "w": WBP(cp), "s": SBP(cp), "eaw": EAW(cp), "ep": bool(EMOJIPRES(cp))}
+
+# ---- self-check against the UCD test files ---------------------------------------------
+
+def selfcheck():
+    for fname, fn in (("GraphemeBreakTest.txt", grapheme_breaks), ("WordBreakTest.txt", word_breaks), ("SentenceBreakTest.txt", sentence_breaks)):
+        total = bad = 0
+        with open(os.path.join(UCD, fname), encoding="utf-8") as f:
+            for line in f:
+                line = line.split("#", 1)[0].strip()
+                if not line:
+                    continue
+                toks = line.split()
+                cps, breaks = [], []
+                for t in toks:
+                    if t == "÷":
+                        if cps:
+                            breaks.append(len(cps))
+                    elif t == "×":
+                        pass
+                    else:
+                        cps.append(int(t, 16))
+                breaks = [b for b in breaks if b < len(cps)]
+                got = fn(cps)
+                total += 1
+                if got != breaks:
+                    bad += 1
+                    if bad <= 5:
+                        print(fname, "MISMATCH", " ".join("%04X" % c for c in cps), "want", breaks, "got", got)
+        print(fname, total, "cases,", bad, "mismatches")
+
+def serve():
+    for line in sys.stdin:
+        req = json.loads(line)
+        cps = req.get("cps", [])
+        amb = req.get("amb", 1)
+        res = {}
+        if "cps" in req:
+            res["g"] = grapheme_breaks(cps)
+            res["w"] = word_breaks(cps)
+            res["s"] = sentence_breaks(cps)
+            widths, skips = [], []
+            prev = 0
+            for b in (res["g"] + [len(cps)] if cps else []):
+                cl = cps[prev:b]
+                widths.append(cluster_width(cl, amb))
+                skips.append(width_skip(cl))
+                prev = b
+            res["widths"] = widths
+            res["skips"] = skips
+            res["sskip"] = sentence_skip(cps)
+            res["wskip"] = word_skip(cps)
+        if "info" in req:
+            res["info"] = info(req["info"])
+        print(json.dumps(res))
+        sys.stdout.flush()
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "check":
+        selfcheck()
+    else:
+        serve()
+`
+
+type pyResult struct {
+	G      []int    `json:"g"`
+	W      []int    `json:"w"`
+	S      []int    `json:"s"`
+	Widths []int    `json:"widths"`
+	Skips  []string `json:"skips"`
+	Sskip  string   `json:"sskip"`
+	Wskip  string   `json:"wskip"`
+	Info   *pyInfo  `json:"info"`
+}
+
+type pyInfo struct {
+	G   string `json:"g"`
+	W   string `json:"w"`
+	S   string `json:"s"`
+	Eaw string `json:"eaw"`
+	EP  bool   `json:"ep"`
+}
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyProc  *pyChild
+	pyError error
+)
+
+func ucdDir() string {
+	if d := os.Getenv("HEGEL_UCD"); d != "" {
+		return d
+	}
+	home, _ := os.UserHomeDir()
+	return filepath.Join(home, ".cache", "hegel-zoo", "ucd-15.0.0")
+}
+
+func oracle(t *testing.T) *pyChild {
+	pyOnce.Do(func() {
+		for _, f := range []string{"GraphemeBreakProperty.txt", "WordBreakProperty.txt", "SentenceBreakProperty.txt", "EastAsianWidth.txt", "emoji-data.txt"} {
+			if _, err := os.Stat(filepath.Join(ucdDir(), f)); err != nil {
+				pyError = fmt.Errorf("UCD 15.0.0 file missing (run the target's setup): %v", err)
+				return
+			}
+		}
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Env = append(os.Environ(), "HEGEL_UCD="+ucdDir())
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyError = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<22)
+		pyProc = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyError != nil {
+		t.Fatalf("cannot start the Python oracle: %v", pyError)
+	}
+	return pyProc
+}
+
+func (p *pyChild) call(req any, res any) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := p.in.Flush(); err != nil {
+		return err
+	}
+	if !p.out.Scan() {
+		return fmt.Errorf("oracle died: %v", p.out.Err())
+	}
+	return json.Unmarshal(p.out.Bytes(), res)
+}
+
+func (p *pyChild) segment(t *testing.T, cps []int, amb int) pyResult {
+	var res pyResult
+	if err := p.call(map[string]any{"cps": cps, "amb": amb}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+// ---- generators ----------------------------------------------------------------------------
+//
+// A text is a list of pieces (a code point, or an invalid byte sequence) rendered by sampleOf,
+// which decodes the bytes as the package does. The wide properties draw texts over every
+// property class (below); the narrow properties spell a recorded bug's shape as a short
+// sequence of pieces from small pools (cat), and under HEGEL_NO_KNOWN=1 its neighbouring shape
+// (shaped).
+
+var classes = [][]rune{
+	{'a', 'b', 'z', 'Z', 'A', 'É', 'é', 'α', 'Α', 0x0905, 0x0915, 0x05D0, 0x05D1, 0x05EA, 0x0627, 0x3042, 0x4E00, 0x1E00}, // letters: ALetter/Hebrew/OLetter, Upper/Lower
+	{0x0D}, {0x0A}, // CR, LF
+	{0x00, 0x09, 0x0B, 0x0C, 0x1B, 0x7F, 0x85, 0x200B, 0x2028, 0x2029, 0x061C, 0xFEFF, 0xE0001, 0xAD, 0x200E, 0x2060},                                // Control / Format / Newline / Sep
+	{0x0300, 0x0301, 0x0308, 0x0483, 0x0591, 0x064B, 0x093C, 0x0941, 0x0E31, 0x0E34, 0x200C, 0x20E3, 0x3099, 0x302A, 0x1AB0, 0xFE00, 0xFE0E, 0xFE0F}, // Extend
+	{0x1F3FB, 0x1F3FC, 0x1F3FD, 0x1F3FE, 0x1F3FF},                    // Extend: emoji modifiers
+	{0xE0020, 0xE0067, 0xE0062, 0xE007F},                             // Extend: tags
+	{0x200D},                                                         // ZWJ
+	{0x1F1E6, 0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1FF},           // Regional_Indicator
+	{0x0903, 0x093E, 0x0949, 0x094F, 0x0BBF, 0x0E33, 0x1B44, 0xAA33}, // SpacingMark
+	{0x0600, 0x0601, 0x0605, 0x06DD, 0x070F, 0x0890, 0x08E2, 0x0D4E, 0x110BD, 0x110CD, 0x111C2, 0x11A3A, 0x11A84, 0x11D46}, // Prepend
+	{0x1100, 0x1101, 0x1112, 0x115F, 0xA960, 0xA97C},                                                                       // L
+	{0x1160, 0x1161, 0x1175, 0x11A7, 0xD7B0, 0xD7C6},                                                                       // V
+	{0x11A8, 0x11A9, 0x11C2, 0x11FF, 0xD7CB, 0xD7FB},                                                                       // T
+	{0xAC00, 0xAC1C, 0xB098, 0xD788, 0xD7A4},                                                                               // LV
+	{0xAC01, 0xAC02, 0xB099, 0xD7A3, 0xAC1B},                                                                               // LVT
+	{0x00A9, 0x00AE, 0x203C, 0x2049, 0x2122, 0x231A, 0x261D, 0x2764, 0x2600, 0x2603, 0x231B, 0x23F0, 0x1F004, 0x1F0CF},     // ExtPict (mixed presentation)
+	{0x1F600, 0x1F44D, 0x1F3F4, 0x1F468, 0x1F469, 0x1F467, 0x1F466, 0x1F525, 0x1F308, 0x1F3F3, 0x1FAF0, 0x1F5E8},           // ExtPict
+	{0x30A2, 0x30FC, 0x31F0, 0xFF66},                                                                                       // Katakana
+	{'\'', '"'},                                                                                                            // Single_Quote, Double_Quote / Close
+	{'.', 0x2024, 0xFE52, 0xFF0E},                                                                                          // MidNumLet / ATerm
+	{':', 0xB7, 0x0387, 0x055F, 0x05F4, 0x2027, 0xFE13, 0xFF1A},                                                            // MidLetter / SContinue
+	{',', ';', 0x037E, 0x0589, 0x060C, 0x066C, 0x2044, 0xFE10, 0xFF0C},                                                     // MidNum
+	{'0', '1', '9', 0x0660, 0x06F0, 0x0966, 0xFF10},                                                                        // Numeric
+	{'_', 0x202F, 0x203F, 0x2040, 0x2054, 0xFE33, 0xFF3F},                                                                  // ExtendNumLet
+	{' ', 0x1680, 0x2000, 0x2006, 0x2008, 0x205F, 0x3000, 0xA0},                                                            // WSegSpace / Sp
+	{'!', '?', 0x0589, 0x061F, 0x06D4, 0x0964, 0x3002, 0xFF01, 0xFF1F},                                                     // STerm
+	{'(', ')', '[', ']', '{', '}', 0xAB, 0xBB, 0x2018, 0x2019, 0x201C, 0x201D, 0x3008, 0x3009, 0xFF08},                     // Close
+	{'-', 0x2013, 0x2014, 0x3001, 0xFE10},                                                                                  // SContinue
+	{0x2E3A, 0x2E3B, 0xFF01, 0xFE6A, 0xFF61, 0x1F100, 0x2985, 0x1B05, 0x4E2D, 0x3000, 0xFFFD, 0x00A1, 0x00A4, 0x2460},      // width classes: em dashes, F, W, H, A, Na, N
+	{'-', '/', '+', '=', '@', '#', '*', '~', '\t'},                                                                         // Other punctuation
+}
+
+var blocks = [][2]rune{
+	{0x20, 0x7E}, {0xA0, 0x24F}, {0x370, 0x3FF}, {0x400, 0x4FF}, {0x590, 0x5FF}, {0x600, 0x6FF},
+	{0x900, 0x97F}, {0xE00, 0xE7F}, {0x1100, 0x11FF}, {0x2000, 0x206F}, {0x2E00, 0x2E7F},
+	{0x3000, 0x30FF}, {0x4E00, 0x4E7F}, {0xAC00, 0xD7A3}, {0xFE00, 0xFE0F}, {0xFF00, 0xFFEF},
+	{0x1F1E6, 0x1F1FF}, {0x1F300, 0x1F64F}, {0x1F900, 0x1F9FF}, {0xE0020, 0xE007F},
+}
+
+var invalidBytes = [][]byte{{0xFF}, {0x80}, {0xC3}, {0xE3, 0x81}, {0xF0, 0x9F}, {0xED, 0xA0, 0x80}, {0xC0, 0x80}}
+
+// encoded is the UTF-8 of the code points of g.
+func encoded(g hegel.Generator[rune]) hegel.Generator[[]byte] {
+	return hegel.Map(g, func(r rune) []byte { return utf8.AppendRune(nil, r) })
+}
+
+// runes is one of the code points, encoded.
+func runes(rs ...rune) hegel.Generator[[]byte] { return encoded(hegel.SampledFrom(rs)) }
+
+// cat is the concatenation of one draw of each part (the binding has no tuple combinator, so
+// independent parts are joined by a Composite).
+func cat(parts ...hegel.Generator[[]byte]) hegel.Generator[[]byte] {
+	return hegel.Composite(func(tc hegel.TestCase) []byte {
+		var out []byte
+		for _, p := range parts {
+			out = append(out, hegel.Draw(tc, p)...)
+		}
+		return out
+	})
+}
+
+// rep is lo to hi draws of g, concatenated.
+func rep(g hegel.Generator[[]byte], lo, hi int) hegel.Generator[[]byte] {
+	return hegel.Map(many(g, lo, hi), func(ps [][]byte) []byte { return bytes.Join(ps, nil) })
+}
+
+var (
+	// classRunes: a code point of one of the property classes, the class drawn first so that
+	// the one-member classes (CR, LF, ZWJ) are met as often as any other.
+	classRunes = hegel.FlatMap(hegel.SampledFrom(classes), func(c []rune) hegel.Generator[rune] { return hegel.SampledFrom(c) })
+	// blockRunes: a code point of one of the blocks.
+	blockRunes = hegel.FlatMap(hegel.SampledFrom(blocks), func(b [2]rune) hegel.Generator[rune] { return hegel.Integers(b[0], b[1]) })
+	// pieces: a class code point fifteen times in twenty, a block code point four times, an
+	// invalid byte sequence once.
+	pieces = weighted(
+		choice[[]byte]{75, encoded(classRunes)},
+		choice[[]byte]{20, encoded(blockRunes)},
+		choice[[]byte]{5, hegel.SampledFrom(invalidBytes)},
+	)
+	// texts: up to ten pieces, or ten to twenty-four once in ten.
+	texts = weighted(
+		choice[[]byte]{90, rep(pieces, 0, 10)},
+		choice[[]byte]{10, rep(pieces, 10, 24)},
+	)
+	// samples: the texts of the wide properties.
+	samples = hegel.Map(texts, sampleOf)
+)
+
+// sample is a text with the code point sequence the oracle sees (an invalid byte counts as one
+// U+FFFD, as utf8.DecodeRune reports it) and the byte offset of every code point.
+type sample struct {
+	text    string
+	cps     []int
+	offsets []int // offsets[k] = byte offset of cps[k]; offsets[len(cps)] = len(text)
+}
+
+// sampleOf decodes the bytes as the package does (invalid pieces can concatenate into a valid
+// sequence, so the bytes are the truth, not the pieces). cps is never nil: the oracle reads
+// a JSON list, and encoding/json writes a nil slice as null.
+func sampleOf(b []byte) sample {
+	s := sample{text: string(b), cps: []int{}}
+	for pos := 0; pos < len(b); {
+		r, size := utf8.DecodeRune(b[pos:])
+		s.offsets = append(s.offsets, pos)
+		s.cps = append(s.cps, int(r))
+		pos += size
+	}
+	s.offsets = append(s.offsets, len(b))
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (s sample) GoString() string { return fmt.Sprintf("%q", s.text) }
+
+func (s sample) toOffsets(idx []int) []int {
+	out := make([]int, 0, len(idx))
+	for _, i := range idx {
+		out = append(out, s.offsets[i])
+	}
+	return out
+}
+
+// widthCase is a text and the EastAsianAmbiguousWidth it is measured under.
+type widthCase struct {
+	s   sample
+	amb int
+}
+
+func (c widthCase) GoString() string { return fmt.Sprintf("%q amb=%d", c.s.text, c.amb) }
+
+var (
+	// ambiguousWidths: EastAsianAmbiguousWidth 1, or 2 once in four.
+	ambiguousWidths = hegel.Map(chance(25), func(wide bool) int {
+		if wide {
+			return 2
+		}
+		return 1
+	})
+	widthCases = hegel.Composite(func(tc hegel.TestCase) widthCase {
+		return widthCase{s: hegel.Draw(tc, samples), amb: hegel.Draw(tc, ambiguousWidths)}
+	})
+)
+
+// The shapes of the recorded bugs (bugs.toml), one generator each, as sequences of pieces
+// among a few plain letters; the pools are code points of the named classes (Unicode 15.0.0,
+// emoji-data.txt for the pictographs' presentation and modifier bases).
+var (
+	letters = runes('a', 'b', 'z', 'A', 'Z')
+	none    = hegel.Just([]byte(nil))
+
+	textPictographs  = runes(0x00A9, 0x00AE, 0x203C, 0x2049, 0x2122, 0x261D, 0x2764, 0x2600, 0x2603, 0x270C, 0x1F3F3, 0x1F5E8) // Emoji_Presentation=No
+	emojiPictographs = runes(0x1F600, 0x1F44D, 0x1F468, 0x1F467, 0x1F525, 0x1F308, 0x231A, 0x1F004, 0x270A, 0x1F9D1)           // Emoji_Presentation=Yes
+	modifierBases    = runes(0x1F467, 0x1F9D1, 0x1F44D, 0x261D, 0x270A, 0x270C, 0x1F590)                                       // Emoji_Modifier_Base (line class EB)
+	modifiers        = runes(0x1F3FB, 0x1F3FC, 0x1F3FD, 0x1F3FE, 0x1F3FF)                                                      // Emoji_Modifier
+	zwj              = runes(0x200D)
+	vs16             = runes(0xFE0F)
+	marks            = runes(0x0301, 0x0308, 0x20E3, 0xFE00) // Extend, none of them VS15 or VS16
+	// pictographTails: what continues a pictograph's cluster: an emoji modifier, a ZWJ and
+	// another pictograph, or a combining mark (never VS15 or VS16, which the package handles).
+	pictographTails = hegel.OneOf(modifiers, cat(zwj, hegel.OneOf(textPictographs, emojiPictographs)), marks)
+	// pictographClusters: a text-presentation pictograph with one or two tails, whose
+	// documented width is 2 (uniseg/1); under HEGEL_NO_KNOWN=1 an emoji-presentation
+	// pictograph, whose width is 2 with or without the tails.
+	pictographClusters = cat(shaped(textPictographs, emojiPictographs), rep(pictographTails, 1, 2))
+
+	syllables    = runes(0xAC00, 0xAC1C, 0xB098, 0xD788, 0xAC01, 0xD7A3) // LV and LVT
+	leadingJamo  = runes(0x1100, 0x1112)                                 // L
+	vowelJamo    = runes(0x1161, 0x1175)                                 // V
+	trailingJamo = runes(0x11A8, 0x11A9, 0x11C2, 0x11FF, 0xD7CB, 0xD7FB) // T
+	// hangulClusters: a precomposed syllable followed by one or two trailing jamo, one cluster
+	// of documented width 2 (uniseg/2); under HEGEL_NO_KNOWN=1 the syllable spelled as a
+	// leading and a vowel jamo, which the package measures by its first code point as
+	// documented.
+	hangulClusters = cat(shaped(syllables, cat(leadingJamo, vowelJamo)), rep(trailingJamo, 1, 2))
+
+	prepends = runes(0x0600, 0x0601, 0x0605, 0x06DD, 0x070F, 0x0890, 0x110BD, 0x11A3A) // Prepend (Format for words)
+	bases    = runes('a', 'b', 0x0915, 0x05D0, 0xAC00, 0x1100)                         // AHLetter bases
+	// wordStarts: the start of the text, or letters and a space, before which a word starts.
+	wordStarts = hegel.OneOf(none, cat(rep(letters, 1, 2), runes(' ')))
+	// prependedWords: a Prepend character starting a word before its base: UAX #29 puts a word
+	// boundary after the Prepend, inside the grapheme cluster GB9b forms (uniseg/3); under
+	// HEGEL_NO_KNOWN=1 the Prepend follows a letter, which WB4 attaches it to, so no boundary
+	// falls inside a cluster.
+	prependedWords = cat(shaped(wordStarts, rep(letters, 1, 2)), prepends, bases, rep(letters, 0, 2))
+
+	followers = hegel.OneOf(letters, runes(' ', ',', '0', 0x3042, 0x1F600))
+	// modifierSequences: an emoji modifier base with its modifier, then more text: LB30b
+	// forbids the break inside the sequence and nothing forces one after it (uniseg/4); under
+	// HEGEL_NO_KNOWN=1 the base bare or with VS16.
+	modifierSequences = cat(rep(letters, 0, 2), modifierBases, shaped(modifiers, hegel.OneOf(none, vs16)), followers, rep(letters, 0, 2))
+
+	aterms       = runes('.', 0x2024, 0xFF0E)     // ATerm
+	lowers       = runes('a', 'b', 'z')           // Lower
+	spaces       = runes(' ', 0x3000, 0xA0)       // Sp
+	fillers      = runes('#', '@', '(', ')', '0') // neither letters nor terminators (Other, Close, Numeric)
+	replacements = hegel.OneOf(runes(0xFFFD), hegel.SampledFrom(invalidBytes))
+	// lookAheads: a lower-case letter, an ATerm, spaces, a non-letter and then a replacement
+	// character (U+FFFD in the text, or a byte that is not UTF-8), before a lower-case letter:
+	// SB8's look-ahead reaches the letter, so no sentence ends at the ATerm (uniseg/5); under
+	// HEGEL_NO_KNOWN=1 the second non-letter is a plain one too.
+	lookAheads = cat(lowers, aterms, rep(spaces, 0, 2), hegel.OneOf(fillers, replacements), shaped(replacements, fillers), rep(spaces, 0, 1), lowers)
+
+	terminators = runes('.', '!', '?', 0x3002, 0xFF01)                                             // ATerm and STerm
+	closers     = runes(')', ']', '"', 0x2019)                                                     // Close
+	separators  = hegel.OneOf(hegel.Just([]byte("\r\n")), runes('\r', '\n', 0x85, 0x2028, 0x2029)) // ParaSep, CR LF first
+	// terminatedLines: a sentence terminator, closers, spaces and a paragraph separator, then
+	// more text: SB3 and SB9-SB10 end the sentence after the separator (uniseg/6); under
+	// HEGEL_NO_KNOWN=1 a letter in place of the terminator, where SB4 alone decides.
+	terminatedLines = cat(letters, shaped(terminators, letters), rep(closers, 0, 2), rep(spaces, 0, 2), separators, letters)
+
+	lineEnds = hegel.OneOf(hegel.Just([]byte("\r\n")), runes('\n', '\r', 0x0B, 0x0C, 0x85, 0x2028, 0x2029)) // BK, CR, LF, NL
+	hyphen   = runes('-')                                                                                   // HY
+	digits   = runes('0', '1', '9', 0x0660, 0x06F0, 0xFF10)                                                 // NU
+	// hyphenatedNumbers: a line end, then a hyphen and a digit: LB4/LB5 keep the mandatory
+	// break whatever follows (uniseg/7); under HEGEL_NO_KNOWN=1 a hyphen and a letter, or a
+	// digit alone, after the line end.
+	hyphenatedNumbers = cat(rep(letters, 0, 2), lineEnds, shaped(cat(hyphen, digits), hegel.OneOf(cat(hyphen, letters), digits)), rep(letters, 0, 2))
+
+	wsegSpaces = runes(' ', 0x1680, 0x2000, 0x2006, 0x205F, 0x3000) // WSegSpace
+	// joinedSpaces: a space, a ZWJ and a space: WB3d does not apply through the ZWJ, so a word
+	// boundary falls before the second space (uniseg/8); under HEGEL_NO_KNOWN=1 a combining
+	// mark in place of the ZWJ, which the package handles.
+	joinedSpaces = cat(rep(letters, 0, 1), wsegSpaces, shaped(zwj, runes(0x0308, 0x0301)), wsegSpaces, rep(letters, 0, 1))
+)
+
+// shapeSamples is the sample of a drawn shape.
+func shapeSamples(g hegel.Generator[[]byte]) hegel.Generator[sample] { return hegel.Map(g, sampleOf) }
+
+var (
+	pictographSamples = shapeSamples(pictographClusters)
+	hangulSamples     = shapeSamples(hangulClusters)
+	prependSamples    = shapeSamples(prependedWords)
+	modifierSamples   = shapeSamples(modifierSequences)
+	lookAheadSamples  = shapeSamples(lookAheads)
+	terminatorSamples = shapeSamples(terminatedLines)
+	hyphenSamples     = shapeSamples(hyphenatedNumbers)
+	joinerSamples     = shapeSamples(joinedSpaces)
+)
+
+// ---- the package's answers -----------------------------------------------------------------
+
+type segCluster struct {
+	start, end int
+	width      int
+	word, sent bool
+	line       int
+}
+
+// stepAll runs Step over b from state -1 and records every cluster with its flags.
+func stepAll(b []byte) []segCluster {
+	var out []segCluster
+	state := -1
+	pos := 0
+	rest := b
+	for len(rest) > 0 {
+		var cluster []byte
+		var boundaries int
+		cluster, rest, boundaries, state = uniseg.Step(rest, state)
+		out = append(out, segCluster{pos, pos + len(cluster), boundaries >> uniseg.ShiftWidth, boundaries&uniseg.MaskWord != 0, boundaries&uniseg.MaskSentence != 0, boundaries & uniseg.MaskLine})
+		pos += len(cluster)
+	}
+	return out
+}
+
+func stepAllString(s string) []segCluster {
+	var out []segCluster
+	state := -1
+	pos := 0
+	rest := s
+	for len(rest) > 0 {
+		var cluster string
+		var boundaries int
+		cluster, rest, boundaries, state = uniseg.StepString(rest, state)
+		out = append(out, segCluster{pos, pos + len(cluster), boundaries >> uniseg.ShiftWidth, boundaries&uniseg.MaskWord != 0, boundaries&uniseg.MaskSentence != 0, boundaries & uniseg.MaskLine})
+		pos += len(cluster)
+	}
+	return out
+}
+
+// ends returns the end offsets of all segments but the last (the boundaries inside the text).
+func ends(cl []segCluster, keep func(segCluster) bool) []int {
+	var out []int
+	for i, c := range cl {
+		if i == len(cl)-1 {
+			break
+		}
+		if keep(c) {
+			out = append(out, c.end)
+		}
+	}
+	if out == nil {
+		out = []int{}
+	}
+	return out
+}
+
+func widths(cl []segCluster) []int {
+	out := make([]int, 0, len(cl))
+	for _, c := range cl {
+		out = append(out, c.width)
+	}
+	return out
+}
+
+// chain runs a First* function to the end and returns the inner boundaries.
+func chain(s string, first func(string, int) (string, string, int)) []int {
+	out := []int{}
+	state := -1
+	pos := 0
+	rest := s
+	for len(rest) > 0 {
+		var seg string
+		seg, rest, state = first(rest, state)
+		if len(seg) == 0 {
+			return append(out, -1) // would loop forever
+		}
+		pos += len(seg)
+		if len(rest) > 0 {
+			out = append(out, pos)
+		}
+	}
+	return out
+}
+
+func chainBytes(b []byte, first func([]byte, int) ([]byte, []byte, int)) []int {
+	out := []int{}
+	state := -1
+	pos := 0
+	rest := b
+	for len(rest) > 0 {
+		var seg []byte
+		seg, rest, state = first(rest, state)
+		if len(seg) == 0 {
+			return append(out, -1)
+		}
+		pos += len(seg)
+		if len(rest) > 0 {
+			out = append(out, pos)
+		}
+	}
+	return out
+}
+
+func eqInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// setDiff returns the elements of a that are not in b, in order.
+func setDiff(a, b []int) []int {
+	set := map[int]bool{}
+	for _, x := range b {
+		set[x] = true
+	}
+	out := []int{}
+	for _, x := range a {
+		if !set[x] {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// ---- checks shared by the properties -------------------------------------------------------
+
+func everyCluster(segCluster) bool { return true }
+
+// insideClusters returns the wanted boundaries that are not cluster ends: UAX #29 places word
+// and sentence boundaries inside some grapheme clusters (after a Prepend character, which is
+// Format for words; before an emoji modifier after a non-emoji base, which is not Extend for
+// sentences), and Step, which reports flags at cluster ends only, cannot show them (uniseg/3).
+func insideClusters(want []int, steps []segCluster) []int {
+	return setDiff(want, ends(steps, everyCluster))
+}
+
+// stepBoundariesAgree checks Step's word or sentence flags at the cluster ends against the
+// reference's boundaries. A boundary inside a cluster is the shape of uniseg/3: by default the
+// mismatch names it, under HEGEL_NO_KNOWN=1 Step is excused those boundaries. skip is the
+// oracle's shape for the whole text (uniseg/5, uniseg/6, uniseg/8, named on a mismatch; or the
+// open WB3c question, which leaves the check unjudged).
+func stepBoundariesAgree(ht *hegel.T, what string, s sample, steps []segCluster, want []int, skip string, flag func(segCluster) bool) {
+	if open(ht, what, skip) {
+		return
+	}
+	shape := ""
+	if inside := insideClusters(want, steps); len(inside) > 0 {
+		shape = "uniseg/3"
+		if noKnown {
+			want, shape = setDiff(want, inside), ""
+		}
+	}
+	if got := ends(steps, flag); !eqInts(got, want) {
+		mismatch(ht, []string{shape, skip}, "Step %s boundaries of %q at %v, UAX #29 says %v", what, s.text, got, want)
+	}
+}
+
+func stepWordsAgree(ht *hegel.T, s sample, steps []segCluster, ref pyResult) {
+	stepBoundariesAgree(ht, "word", s, steps, s.toOffsets(ref.W), ref.Wskip, func(c segCluster) bool { return c.word })
+}
+
+func stepSentencesAgree(ht *hegel.T, s sample, steps []segCluster, ref pyResult) {
+	stepBoundariesAgree(ht, "sentence", s, steps, s.toOffsets(ref.S), ref.Sskip, func(c segCluster) bool { return c.sent })
+}
+
+// firstWordsAgree checks FirstWord and FirstWordInString against the reference's word
+// boundaries (all of them: the First* functions do report the ones inside clusters).
+func firstWordsAgree(ht *hegel.T, s sample, ref pyResult) {
+	if open(ht, "words", ref.Wskip) {
+		return
+	}
+	want := s.toOffsets(ref.W)
+	if got := chainBytes([]byte(s.text), uniseg.FirstWord); !eqInts(got, want) {
+		mismatch(ht, []string{ref.Wskip}, "FirstWord of %q ends at %v, want %v", s.text, got, want)
+	}
+	if got := chain(s.text, uniseg.FirstWordInString); !eqInts(got, want) {
+		mismatch(ht, []string{ref.Wskip}, "FirstWordInString of %q ends at %v, want %v", s.text, got, want)
+	}
+}
+
+// firstSentencesAgree checks FirstSentence and FirstSentenceInString against the reference.
+func firstSentencesAgree(ht *hegel.T, s sample, ref pyResult) {
+	if open(ht, "sentences", ref.Sskip) {
+		return
+	}
+	want := s.toOffsets(ref.S)
+	if got := chainBytes([]byte(s.text), uniseg.FirstSentence); !eqInts(got, want) {
+		mismatch(ht, []string{ref.Sskip}, "FirstSentence of %q ends at %v, want %v", s.text, got, want)
+	}
+	if got := chain(s.text, uniseg.FirstSentenceInString); !eqInts(got, want) {
+		mismatch(ht, []string{ref.Sskip}, "FirstSentenceInString of %q ends at %v, want %v", s.text, got, want)
+	}
+}
+
+// clusterWidthsAgree checks every cluster's Step width against the documented rules, and
+// FirstGraphemeCluster's against Step's. A cluster whose shape the oracle names as a recorded
+// bug (uniseg/1, uniseg/2) is judged, the mismatch naming the shape; the two shapes the
+// documentation leaves open are not. It returns the shapes of the judged clusters and whether
+// any cluster was left unjudged.
+func clusterWidthsAgree(ht *hegel.T, s sample, amb int, steps []segCluster, ref pyResult) (shapes []string, left bool) {
+	for i, c := range steps {
+		cl := s.text[c.start:c.end]
+		if open(ht, fmt.Sprintf("width of cluster %q", cl), ref.Skips[i]) {
+			left = true
+			continue
+		}
+		shapes = append(shapes, ref.Skips[i])
+		if c.width != ref.Widths[i] {
+			mismatch(ht, []string{ref.Skips[i]}, "Step width of cluster %q (in %q, amb=%d) = %d, documented rules give %d", cl, s.text, amb, c.width, ref.Widths[i])
+		}
+		if _, _, w, _ := uniseg.FirstGraphemeCluster([]byte(s.text[c.start:]), -1); w != c.width {
+			fail(ht, "FirstGraphemeCluster width of %q = %d, Step says %d", cl, w, c.width)
+		}
+	}
+	return shapes, left
+}
+
+// isLineEnd reports whether r forces a line break after itself (LB4, LB5): BK (U+000B, U+000C,
+// U+2028, U+2029), CR, LF and NL (U+0085).
+func isLineEnd(r rune) bool {
+	return r == '\n' || r == '\r' || r == 0x0B || r == 0x0C || r == 0x85 || r == 0x2028 || r == 0x2029
+}
+
+// lineShape names the recorded bug whose shape the line flag after cluster c has: a cluster
+// ending with an emoji modifier (uniseg/4), a line end before a hyphen and a digit (uniseg/7).
+func lineShape(text string, c segCluster, last rune) string {
+	if last >= 0x1F3FB && last <= 0x1F3FF {
+		return "uniseg/4"
+	}
+	if next := text[c.end:]; isLineEnd(last) && len(next) > 1 && next[0] == '-' {
+		if r2, _ := utf8.DecodeRuneInString(next[1:]); unicode.IsDigit(r2) || r2 == 0x066B || r2 == 0x066C {
+			return "uniseg/7"
+		}
+	}
+	return ""
+}
+
+// mustBreaksFollowLB45 checks that, in the middle of the text, Step reports LineMustBreak
+// exactly after BK, CR, LF and NL (LB4, LB5).
+func mustBreaksFollowLB45(ht *hegel.T, s sample, steps []segCluster) {
+	for _, c := range steps[:len(steps)-1] {
+		r, _ := utf8.DecodeLastRuneInString(s.text[:c.end])
+		shape := lineShape(s.text, c, r)
+		if (c.line == uniseg.LineMustBreak) != isLineEnd(r) {
+			mismatch(ht, []string{shape}, "Step line flag after %q (ending %U) in %q is %d", s.text[c.start:c.end], r, s.text, c.line)
+		}
+	}
+}
+
+// lineSegmentsFollowStep checks that FirstLineSegment and FirstLineSegmentInString cut exactly
+// where Step reports a break opportunity (LineCanBreak or LineMustBreak), that their mustBreak
+// flag equals Step's LineMustBreak, and that the last segment must break (LB3). UAX #14 places
+// break opportunities where UAX #29 has no cluster boundary (a non-emoji base before an emoji
+// modifier, LB31; a Prepend character before its base): FirstLineSegment cuts there and Step
+// cannot report it (uniseg/3).
+func lineSegmentsFollowStep(ht *hegel.T, s sample, steps []segCluster) {
+	breakAt := map[int]int{} // cluster end -> line flag
+	var want []int
+	for _, c := range steps {
+		breakAt[c.end] = c.line
+		if c.line != uniseg.LineDontBreak && c.line != uniseg.LineCanBreak && c.line != uniseg.LineMustBreak {
+			fail(ht, "Step line flag %d for cluster %q of %q", c.line, s.text[c.start:c.end], s.text)
+		}
+		if c.line != uniseg.LineDontBreak {
+			want = append(want, c.end)
+		}
+	}
+	for _, variant := range []string{"bytes", "string"} {
+		state := -1
+		pos := 0
+		var got []int
+		for pos < len(s.text) {
+			var seg string
+			var must bool
+			if variant == "bytes" {
+				var sb, rb []byte
+				sb, rb, must, state = uniseg.FirstLineSegment([]byte(s.text[pos:]), state)
+				seg = string(sb)
+				if string(sb)+string(rb) != s.text[pos:] {
+					fail(ht, "FirstLineSegment of %q at %d returns %q + %q", s.text, pos, sb, rb)
+				}
+			} else {
+				var rest string
+				seg, rest, must, state = uniseg.FirstLineSegmentInString(s.text[pos:], state)
+				if seg+rest != s.text[pos:] {
+					fail(ht, "FirstLineSegmentInString of %q at %d returns %q + %q", s.text, pos, seg, rest)
+				}
+			}
+			if len(seg) == 0 {
+				fail(ht, "FirstLineSegment(%s) of %q at %d returns an empty segment", variant, s.text, pos)
+			}
+			pos += len(seg)
+			flag, ok := breakAt[pos]
+			if !ok {
+				mismatch(ht, []string{"uniseg/3"}, "FirstLineSegment(%s) of %q cuts at %d, inside a cluster", variant, s.text, pos)
+				continue
+			}
+			if flag == uniseg.LineDontBreak {
+				fail(ht, "FirstLineSegment(%s) of %q cuts at %d where Step says LineDontBreak", variant, s.text, pos)
+			}
+			if must != (flag == uniseg.LineMustBreak) {
+				fail(ht, "FirstLineSegment(%s) of %q at %d: mustBreak %v, Step flag %d", variant, s.text, pos, must, flag)
+			}
+			if pos == len(s.text) && !must {
+				fail(ht, "FirstLineSegment(%s) of %q: the last segment does not report a mandatory break", variant, s.text)
+			}
+			got = append(got, pos)
+		}
+		if !eqInts(got, want) {
+			fail(ht, "FirstLineSegment(%s) of %q cuts at %v, Step's break opportunities are %v", variant, s.text, got, want)
+		}
+	}
+}
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelBoundariesFollowUAX29: grapheme cluster, word and sentence boundaries from Step,
+// StepString, FirstGraphemeCluster[InString], FirstWord[InString] and FirstSentence[InString]
+// all equal the reference implementation of the Unicode 15.0 rules, on text mixing every
+// property class and invalid UTF-8; GraphemeClusterCount agrees; words and sentences end on
+// cluster boundaries. The shapes of uniseg/3, /5, /6 and /8 are drawn at their natural rate
+// and fail, naming the shape.
+func TestHegelBoundariesFollowUAX29(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, samples)
+		if len(s.text) == 0 {
+			if c, r, b, st := uniseg.Step(nil, -1); c != nil || r != nil || b != 0 || st != 0 {
+				fail(ht, "Step(nil) = %v %v %d %d, want zero values", c, r, b, st)
+			}
+			if uniseg.GraphemeClusterCount("") != 0 || uniseg.StringWidth("") != 0 || uniseg.ReverseString("") != "" {
+				fail(ht, "empty string is not empty")
+			}
+			return
+		}
+		ref := py.segment(t, s.cps, 1)
+		wantG := s.toOffsets(ref.G)
+		b := []byte(s.text)
+		steps := stepAll(b)
+		if gotG := ends(steps, everyCluster); !eqInts(gotG, wantG) {
+			fail(ht, "Step clusters of %q end at %v, UAX #29 says %v", s.text, gotG, wantG)
+		}
+		stepWordsAgree(ht, s, steps, ref)
+		stepSentencesAgree(ht, s, steps, ref)
+		last := steps[len(steps)-1]
+		if !last.word || !last.sent || last.line != uniseg.LineMustBreak {
+			fail(ht, "Step's final cluster of %q has flags word=%v sentence=%v line=%d, want all boundaries and LineMustBreak", s.text, last.word, last.sent, last.line)
+		}
+		stepsS := stepAllString(s.text)
+		if !reflect.DeepEqual(steps, stepsS) {
+			fail(ht, "Step and StepString disagree on %q: %+v vs %+v", s.text, steps, stepsS)
+		}
+		if got := chainBytes(b, func(b []byte, st int) ([]byte, []byte, int) {
+			c, r, _, ns := uniseg.FirstGraphemeCluster(b, st)
+			return c, r, ns
+		}); !eqInts(got, wantG) {
+			fail(ht, "FirstGraphemeCluster of %q ends at %v, want %v", s.text, got, wantG)
+		}
+		if got := chain(s.text, func(s string, st int) (string, string, int) {
+			c, r, _, ns := uniseg.FirstGraphemeClusterInString(s, st)
+			return c, r, ns
+		}); !eqInts(got, wantG) {
+			fail(ht, "FirstGraphemeClusterInString of %q ends at %v, want %v", s.text, got, wantG)
+		}
+		firstWordsAgree(ht, s, ref)
+		firstSentencesAgree(ht, s, ref)
+		// Whatever the shape, the byte and string variants agree with each other.
+		if a, b2 := chainBytes(b, uniseg.FirstWord), chain(s.text, uniseg.FirstWordInString); !eqInts(a, b2) {
+			fail(ht, "FirstWord %v and FirstWordInString %v disagree on %q", a, b2, s.text)
+		}
+		if a, b2 := chainBytes(b, uniseg.FirstSentence), chain(s.text, uniseg.FirstSentenceInString); !eqInts(a, b2) {
+			fail(ht, "FirstSentence %v and FirstSentenceInString %v disagree on %q", a, b2, s.text)
+		}
+		if got := uniseg.GraphemeClusterCount(s.text); got != len(wantG)+1 {
+			fail(ht, "GraphemeClusterCount(%q) = %d, want %d", s.text, got, len(wantG)+1)
+		}
+	})
+}
+
+// TestHegelWidthsFollowTheDocumentedRules: the width of every grapheme cluster from Step and
+// FirstGraphemeCluster, and StringWidth as their sum, follow the rules in the package
+// documentation, with EastAsianAmbiguousWidth 1 or 2. The shapes of uniseg/1 and uniseg/2 are
+// drawn at their natural rate and fail, naming the shape; two shapes the documentation leaves
+// open are not judged.
+func TestHegelWidthsFollowTheDocumentedRules(t *testing.T) {
+	py := oracle(t)
+	defer func() { uniseg.EastAsianAmbiguousWidth = 1 }()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, widthCases)
+		uniseg.EastAsianAmbiguousWidth = c.amb
+		ref := py.segment(t, c.s.cps, c.amb)
+		steps := stepAll([]byte(c.s.text))
+		ht.Assume(len(steps) == len(ref.Widths)) // clusters differ: the boundary property's business
+		shapes, left := clusterWidthsAgree(ht, c.s, c.amb, steps, ref)
+		total := 0
+		for _, w := range ref.Widths {
+			total += w
+		}
+		if got := uniseg.StringWidth(c.s.text); !left && got != total {
+			mismatch(ht, shapes, "StringWidth(%q) amb=%d = %d, sum of the documented cluster widths %d", c.s.text, c.amb, got, total)
+		}
+		sum := 0
+		for _, c := range steps {
+			sum += c.width
+		}
+		if got := uniseg.StringWidth(c.s.text); got != sum {
+			fail(ht, "StringWidth(%q) = %d, sum of Step widths %d", c.s.text, got, sum)
+		}
+	})
+}
+
+// TestHegelGraphemesIteratorMatchesStep: the Graphemes class reports the same clusters,
+// positions, runes, bytes, flags and widths as Step, before, during and after iteration, and
+// after Reset.
+func TestHegelGraphemesIteratorMatchesStep(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, samples)
+		steps := stepAll([]byte(s.text))
+		g := uniseg.NewGraphemes(s.text)
+		if from, to := g.Positions(); from != 0 || to != 0 {
+			fail(ht, "Positions() before Next = %d,%d, want 0,0", from, to)
+		}
+		if g.Runes() != nil || g.Bytes() != nil || g.Str() != "" || g.Width() != 0 || !g.IsWordBoundary() || !g.IsSentenceBoundary() || g.LineBreak() != uniseg.LineDontBreak {
+			fail(ht, "fresh iterator on %q reports %v %v %q %d %v %v %d", s.text, g.Runes(), g.Bytes(), g.Str(), g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak())
+		}
+		for round := 0; round < 2; round++ {
+			i := 0
+			for g.Next() {
+				if i >= len(steps) {
+					fail(ht, "Graphemes yields more than the %d clusters of %q", len(steps), s.text)
+				}
+				c := steps[i]
+				cl := s.text[c.start:c.end]
+				from, to := g.Positions()
+				if from != c.start || to != c.end || g.Str() != cl || string(g.Bytes()) != cl || !reflect.DeepEqual(g.Runes(), []rune(cl)) {
+					fail(ht, "Graphemes cluster %d of %q: %d..%d %q %q %v, Step says %d..%d %q", i, s.text, from, to, g.Str(), g.Bytes(), g.Runes(), c.start, c.end, cl)
+				}
+				if g.Width() != c.width || g.IsWordBoundary() != c.word || g.IsSentenceBoundary() != c.sent || g.LineBreak() != c.line {
+					fail(ht, "Graphemes cluster %q of %q: width %d word %v sentence %v line %d, Step says %d %v %v %d", cl, s.text, g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak(), c.width, c.word, c.sent, c.line)
+				}
+				if !strings.Contains(g.String(), "{"+cl+"}") {
+					fail(ht, "Graphemes.String() = %q does not show the cluster %q", g.String(), cl)
+				}
+				i++
+			}
+			if i != len(steps) {
+				fail(ht, "Graphemes yields %d clusters of %q, Step %d", i, s.text, len(steps))
+			}
+			if from, to := g.Positions(); from != 1 || to != 1 {
+				fail(ht, "Positions() past the end = %d,%d, want 1,1", from, to)
+			}
+			if g.Runes() != nil || g.Bytes() != nil || g.Str() != "" || g.Width() != 0 || !g.IsWordBoundary() || !g.IsSentenceBoundary() || g.LineBreak() != uniseg.LineMustBreak {
+				fail(ht, "exhausted iterator on %q reports %v %v %q %d %v %v %d", s.text, g.Runes(), g.Bytes(), g.Str(), g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak())
+			}
+			g.Reset()
+		}
+	})
+}
+
+// TestHegelLineSegmentsMatchStepFlags: FirstLineSegment[InString] cut exactly where Step reports
+// a break opportunity (LineCanBreak or LineMustBreak), never inside a cluster, the mustBreak
+// flag equals Step's LineMustBreak, the last segment must break (LB3), HasTrailingLineBreak
+// [InString] agree with each other and with the final rune, and a mandatory break in the middle
+// follows exactly BK, CR, LF and NL. The shapes of uniseg/3, /4 and /7 are drawn at their
+// natural rate and fail, naming the shape.
+func TestHegelLineSegmentsMatchStepFlags(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, samples)
+		if len(s.text) == 0 {
+			seg, rest, must, _ := uniseg.FirstLineSegmentInString("", -1)
+			if seg != "" || rest != "" || must {
+				fail(ht, "FirstLineSegmentInString(\"\") = %q %q %v", seg, rest, must)
+			}
+			return
+		}
+		steps := stepAll([]byte(s.text))
+		lineSegmentsFollowStep(ht, s, steps)
+		hb, hs := uniseg.HasTrailingLineBreak([]byte(s.text)), uniseg.HasTrailingLineBreakInString(s.text)
+		if hb != hs {
+			fail(ht, "HasTrailingLineBreak(%q) = %v, InString %v", s.text, hb, hs)
+		}
+		r, _ := utf8.DecodeLastRuneInString(s.text)
+		if hs != isLineEnd(r) {
+			fail(ht, "HasTrailingLineBreakInString(%q) = %v, want %v for the final rune %U", s.text, hs, isLineEnd(r), r)
+		}
+		mustBreaksFollowLB45(ht, s, steps)
+	})
+}
