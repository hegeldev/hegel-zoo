+// TestHegelGraphemesIteratorMatchesStep: the Graphemes class reports the same clusters,
+// positions, runes, bytes, flags and widths as Step, before, during and after iteration, and
+// after Reset.
+func TestHegelGraphemesIteratorMatchesStep(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genSample(ht)
+		note(ht, "%q", s.text)
+		steps := stepAll([]byte(s.text))
+		g := uniseg.NewGraphemes(s.text)
+		if from, to := g.Positions(); from != 0 || to != 0 {
+			fail(ht, "Positions() before Next = %d,%d, want 0,0", from, to)
+		}
+		if g.Runes() != nil || g.Bytes() != nil || g.Str() != "" || g.Width() != 0 || !g.IsWordBoundary() || !g.IsSentenceBoundary() || g.LineBreak() != uniseg.LineDontBreak {
+			fail(ht, "fresh iterator on %q reports %v %v %q %d %v %v %d", s.text, g.Runes(), g.Bytes(), g.Str(), g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak())
+		}
+		for round := 0; round < 2; round++ {
+			i := 0
+			for g.Next() {
+				if i >= len(steps) {
+					fail(ht, "Graphemes yields more than the %d clusters of %q", len(steps), s.text)
+				}
+				c := steps[i]
+				cl := s.text[c.start:c.end]
+				from, to := g.Positions()
+				if from != c.start || to != c.end || g.Str() != cl || string(g.Bytes()) != cl || !reflect.DeepEqual(g.Runes(), []rune(cl)) {
+					fail(ht, "Graphemes cluster %d of %q: %d..%d %q %q %v, Step says %d..%d %q", i, s.text, from, to, g.Str(), g.Bytes(), g.Runes(), c.start, c.end, cl)
+				}
+				if g.Width() != c.width || g.IsWordBoundary() != c.word || g.IsSentenceBoundary() != c.sent || g.LineBreak() != c.line {
+					fail(ht, "Graphemes cluster %q of %q: width %d word %v sentence %v line %d, Step says %d %v %v %d", cl, s.text, g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak(), c.width, c.word, c.sent, c.line)
+				}
+				if !strings.Contains(g.String(), "{"+cl+"}") {
+					fail(ht, "Graphemes.String() = %q does not show the cluster %q", g.String(), cl)
+				}
+				i++
+			}
+			if i != len(steps) {
+				fail(ht, "Graphemes yields %d clusters of %q, Step %d", i, s.text, len(steps))
+			}
+			if from, to := g.Positions(); from != 1 || to != 1 {
+				fail(ht, "Positions() past the end = %d,%d, want 1,1", from, to)
+			}
+			if g.Runes() != nil || g.Bytes() != nil || g.Str() != "" || g.Width() != 0 || !g.IsWordBoundary() || !g.IsSentenceBoundary() || g.LineBreak() != uniseg.LineMustBreak {
+				fail(ht, "exhausted iterator on %q reports %v %v %q %d %v %v %d", s.text, g.Runes(), g.Bytes(), g.Str(), g.Width(), g.IsWordBoundary(), g.IsSentenceBoundary(), g.LineBreak())
+			}
+			g.Reset()
+		}
+	})
+}
