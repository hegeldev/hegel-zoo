+// ---- one property per recorded bug ---------------------------------------------------------
+//
+// Each draws the bug's shape region with random contents and judges it by the wide property's
+// oracle, so that every bug has a property that finds it every run (the wide properties reach
+// the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region
+// the bug does not touch and passes.
+
+// TestHegelTextPictographSequencesAreTwoCellsWide: a cluster starting with a text-presentation
+// pictograph and continued by an emoji modifier, a ZWJ sequence or a combining mark has width
+// 2, as doc.go says of any continuation but VS15; the package keeps the base's width 1
+// (uniseg/1).
+func TestHegelTextPictographSequencesAreTwoCellsWide(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, pictographSamples)
+		ref := py.segment(t, s.cps, 1)
+		steps := stepAll([]byte(s.text))
+		ht.Assume(len(steps) == len(ref.Widths))
+		clusterWidthsAgree(ht, s, 1, steps, ref)
+	})
+}
