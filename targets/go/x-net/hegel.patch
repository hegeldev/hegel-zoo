new file mode 100644
index 0000000..174287a
--- /dev/null
+++ b/html/hegel/hegel_test.go
@@ -0,0 +1,652 @@
+package hegel
+
+// Hegel property tests for golang.org/x/net/html: generated HTML is parsed by
+// x/net/html and by two other implementations of the HTML parsing algorithm
+// (parse5 under node, html5lib under python, both child processes speaking
+// JSON lines) and the trees, printed in the html5lib-tests .dat format, must
+// agree; the tokenizer, the renderer and the escaping functions are checked
+// against x/net/html's own promises.
+//
+// Neither oracle is the specification: html5lib 1.1 (2020) predates the
+// current template, search, ruby and adoption-agency rules; parse5 8 does
+// not have the 2025 select parser change. So the parse properties take a
+// vote: x/net/html agreeing with either oracle is accepted, x/net/html alone
+// against two agreeing oracles is a mismatch.
+//
+// The generators (hegel_gen_test.go) are package-level values built from
+// the binding's combinators: a document is a list of token records or a
+// tower of element records, rendered by pure String methods, with edits,
+// chunk cuts and fragment contexts drawn as data beside it. The shapes of
+// the recorded bugs (bugs.toml, matched in known.go) are drawn by default,
+// so the wide properties that meet them fail naming the bug and are the
+// expected failures mapped to it; hegel_shapes_test.go has one narrow
+// property per bug over its shape region, and the pins (hegel_pins_test.go)
+// are the regression examples. HEGEL_NO_KNOWN=1 (noKnown, in known.go)
+// stops drawing the shapes and counts a mismatch the classifier explains.
+//
+// Needs node with parse5 installed under this directory (the target's setup
+// runs `npm install --prefix html/hegel parse5@8.0.1`) and python3 with
+// html5lib 1.1 on PATH.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"golang.org/x/net/html"
+	"golang.org/x/net/html/atom"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 300 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed (an oracle
+// disagreement, a known bug, a shape the property has no opinion on).
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// notJudged ends the case as one the property has no opinion on (an
+// oracle that lags the specification, a shape the specification leaves
+// open, a tree Render does not promise to round-trip): counted, not failed,
+// in both modes.
+func notJudged(reason string) {
+	count("not judged: " + reason)
+	panic(collected{})
+}
+
+// mismatch reports a disagreement with the oracles, or a broken round trip,
+// on a case whose known shapes are named (none for a plain failure): a
+// shape the vote has no opinion on ("!" + reason) is not judged; a recorded
+// bug's shape is counted and fails naming the bug, or under HEGEL_NO_KNOWN=1
+// is counted as the known bug and the case ends.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	var bugs []string
+	for _, s := range shapes {
+		if strings.HasPrefix(s, "!") {
+			notJudged(s[1:])
+		}
+		bugs = append(bugs, s)
+	}
+	if len(bugs) > 0 {
+		for _, b := range bugs {
+			count("shape " + b)
+		}
+		if noKnown {
+			for _, b := range bugs {
+				count("known " + b)
+			}
+			panic(collected{})
+		}
+		format += " (the shape of " + strings.Join(bugs, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shape is the list of shapes a classifier's answer names: none for "".
+func shape(id string) []string {
+	if id == "" {
+		return nil
+	}
+	return []string{id}
+}
+
+// shapesOf names the bug a narrow property is about, followed by what the
+// classifier says of the case (not judged shapes keep their precedence).
+func shapesOf(bug string, classified string) []string {
+	if strings.HasPrefix(classified, "!") {
+		return []string{classified}
+	}
+	if classified == "" || classified == bug {
+		return []string{bug}
+	}
+	return []string{bug, classified}
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms (hegel-go has no weighted choice, biased coin, optional
+// with a probability or tuple combinator; these are the zoo's spellings).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight (a weight of zero is never drawn); it shrinks
+// towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// unless is the weight w, or zero when off: the alternatives that draw a
+// recorded bug's shape have weight unless(noKnown, w), so HEGEL_NO_KNOWN=1
+// stops drawing them without a filter.
+func unless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// shaped is the generator of a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, of the neighbouring region past it.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value (the
+// empty string for text, a nameless tag) otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the texts of a list generator concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// cat draws one text from each generator and concatenates them (a tuple of
+// texts; a Composite only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// positions: an index into text of unknown length, taken modulo the length
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 599)
+
+// ---------------------------------------------------------------------------
+// The oracles: child processes speaking one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+var (
+	parse5Once sync.Once
+	parse5     *oracle
+	libOnce    sync.Once
+	lib        *oracle
+)
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one request and returns the answer object, or an error when
+// the oracle is unusable (which is a harness failure, not a finding).
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %q: %v", o.name, resp, err)
+	}
+	return m, nil
+}
+
+func parse5Oracle() *oracle {
+	parse5Once.Do(func() { parse5 = startOracle("parse5", "node", "parse5-oracle.cjs") })
+	return parse5
+}
+
+func html5libOracle() *oracle {
+	libOnce.Do(func() { lib = startOracle("html5lib", "python3", "-u", "html5lib-oracle.py") })
+	return lib
+}
+
+// treeReq is a parse request: html, an optional fragment context ("div",
+// "svg path") and the scripting flag.
+type treeReq struct {
+	html      string
+	fragment  string
+	scripting bool
+}
+
+func (r treeReq) json() map[string]any {
+	m := map[string]any{"html": r.html, "scripting": r.scripting}
+	if r.fragment != "" {
+		m["fragment"] = r.fragment
+	} else {
+		m["fragment"] = nil
+	}
+	return m
+}
+
+// opinion is an oracle's tree, or "" with ok false when it has none.
+func opinion(t testing.TB, o *oracle, r treeReq) (tree string, ok bool) {
+	m, err := o.call(r.json())
+	if err != nil {
+		t.Fatalf("%s oracle: %v", o.name, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		if o.name == "parse5" {
+			t.Fatalf("parse5 oracle failed on %q: %v", r.html, e)
+		}
+		return "", false
+	}
+	s, _ := m["tree"].(string)
+	return s, true
+}
+
+// ---------------------------------------------------------------------------
+// The .dat format, as x/net/html's own test dump prints it.
+
+func dumpIndent(w *strings.Builder, level int) {
+	w.WriteString("| ")
+	for i := 0; i < level; i++ {
+		w.WriteString("  ")
+	}
+}
+
+func dumpLevel(w *strings.Builder, nd *html.Node, level int) error {
+	dumpIndent(w, level)
+	level++
+	switch nd.Type {
+	case html.ErrorNode:
+		return fmt.Errorf("unexpected ErrorNode")
+	case html.DocumentNode:
+		return fmt.Errorf("unexpected DocumentNode")
+	case html.ElementNode:
+		if nd.Namespace != "" {
+			fmt.Fprintf(w, "<%s %s>", nd.Namespace, nd.Data)
+		} else {
+			fmt.Fprintf(w, "<%s>", nd.Data)
+		}
+		attr := make([]html.Attribute, len(nd.Attr))
+		copy(attr, nd.Attr)
+		// sorted as the .dat suite and the oracles print them: the namespace
+		// prefix (xlink, xml, xmlns) is part of the sorted name
+		full := func(a html.Attribute) string {
+			if a.Namespace != "" {
+				return a.Namespace + " " + a.Key
+			}
+			return a.Key
+		}
+		sort.SliceStable(attr, func(i, j int) bool { return full(attr[i]) < full(attr[j]) })
+		for _, a := range attr {
+			w.WriteString("\n")
+			dumpIndent(w, level)
+			if a.Namespace != "" {
+				fmt.Fprintf(w, `%s %s="%s"`, a.Namespace, a.Key, a.Val)
+			} else {
+				fmt.Fprintf(w, `%s="%s"`, a.Key, a.Val)
+			}
+		}
+		if nd.Namespace == "" && nd.DataAtom == atom.Template {
+			w.WriteString("\n")
+			dumpIndent(w, level)
+			level++
+			w.WriteString("content")
+		}
+	case html.TextNode:
+		fmt.Fprintf(w, `"%s"`, nd.Data)
+	case html.CommentNode:
+		fmt.Fprintf(w, "<!-- %s -->", nd.Data)
+	case html.DoctypeNode:
+		fmt.Fprintf(w, "<!DOCTYPE %s", nd.Data)
+		if nd.Attr != nil {
+			var p, s string
+			for _, a := range nd.Attr {
+				switch a.Key {
+				case "public":
+					p = a.Val
+				case "system":
+					s = a.Val
+				}
+			}
+			if p != "" || s != "" {
+				fmt.Fprintf(w, ` "%s"`, p)
+				fmt.Fprintf(w, ` "%s"`, s)
+			}
+		}
+		w.WriteString(">")
+	default:
+		return fmt.Errorf("unknown node type %v", nd.Type)
+	}
+	w.WriteString("\n")
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := dumpLevel(w, c, level); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// dump prints the children of a document (or a synthetic fragment root).
+func dump(nd *html.Node) (string, error) {
+	if nd == nil || nd.FirstChild == nil {
+		return "", nil
+	}
+	var b strings.Builder
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := dumpLevel(&b, c, 0); err != nil {
+			return "", err
+		}
+	}
+	return b.String(), nil
+}
+
+// ---------------------------------------------------------------------------
+// Tree consistency (x/net/html's own check, from node_test.go).
+
+func checkTree(nd *html.Node) error { return checkTree1(nd, 0) }
+
+func checkTree1(nd *html.Node, depth int) error {
+	if depth == 1e4 {
+		return fmt.Errorf("tree looks like it contains a cycle")
+	}
+	if err := checkNode(nd); err != nil {
+		return err
+	}
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := checkTree1(c, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func checkNode(nd *html.Node) error {
+	if nd == nil {
+		return nil
+	}
+	nParent := 0
+	for p := nd.Parent; p != nil; p = p.Parent {
+		nParent++
+		if nParent == 1e4 {
+			return fmt.Errorf("parent list looks like an infinite loop")
+		}
+	}
+	nForward := 0
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		nForward++
+		if nForward == 1e6 {
+			return fmt.Errorf("forward list of children looks like an infinite loop")
+		}
+		if c.Parent != nd {
+			return fmt.Errorf("inconsistent child/parent relationship")
+		}
+	}
+	nBackward := 0
+	for c := nd.LastChild; c != nil; c = c.PrevSibling {
+		nBackward++
+		if nBackward == 1e6 {
+			return fmt.Errorf("backward list of children looks like an infinite loop")
+		}
+		if c.Parent != nd {
+			return fmt.Errorf("inconsistent child/parent relationship")
+		}
+	}
+	if nd.Parent != nil {
+		if nd.Parent == nd || nd.Parent == nd.FirstChild || nd.Parent == nd.LastChild || nd.Parent == nd.PrevSibling || nd.Parent == nd.NextSibling {
+			return fmt.Errorf("inconsistent parent relationship")
+		}
+		if nd.Parent.FirstChild != nd && nd.PrevSibling == nil {
+			return fmt.Errorf("node without a previous sibling is not its parent's first child")
+		}
+		if nd.Parent.LastChild != nd && nd.NextSibling == nil {
+			return fmt.Errorf("node without a next sibling is not its parent's last child")
+		}
+	}
+	if nd.PrevSibling != nil && nd.PrevSibling.NextSibling != nd {
+		return fmt.Errorf("inconsistent prev/next sibling relationship")
+	}
+	if nd.NextSibling != nil && nd.NextSibling.PrevSibling != nd {
+		return fmt.Errorf("inconsistent next/prev sibling relationship")
+	}
+	if (nd.FirstChild == nil) != (nd.LastChild == nil) {
+		return fmt.Errorf("inconsistent first/last child relationship")
+	}
+	if nd.FirstChild != nil && nd.FirstChild == nd.LastChild && nd.FirstChild.NextSibling != nil {
+		return fmt.Errorf("only child has a sibling")
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Parsing with x/net/html, in the shape the .dat format compares.
+
+func parseTree(r treeReq, src io.Reader) (*html.Node, error) {
+	opts := []html.ParseOption{html.ParseOptionEnableScripting(r.scripting)}
+	if r.fragment == "" {
+		return html.ParseWithOptions(src, opts...)
+	}
+	namespace, context := "", r.fragment
+	if i := strings.IndexByte(context, ' '); i >= 0 {
+		namespace, context = context[:i], context[i+1:]
+	}
+	ctx := &html.Node{Data: context, DataAtom: atom.Lookup([]byte(context)), Namespace: namespace, Type: html.ElementNode}
+	nodes, err := html.ParseFragmentWithOptions(src, ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	doc := &html.Node{Type: html.DocumentNode}
+	for _, nd := range nodes {
+		doc.AppendChild(nd)
+	}
+	return doc, nil
+}
+
+// vote compares x/net/html's tree with the oracles': agreement with parse5
+// or with html5lib passes; x/net/html alone against two agreeing oracles
+// is a mismatch, judged by the classifier (and named after bug when a
+// narrow property is about one); everything else is counted.
+func vote(ht *hegel.T, r treeReq, got string, bug ...string) {
+	p5, _ := opinion(curT, parse5Oracle(), r)
+	if got == p5 {
+		return
+	}
+	lb, hasLib := opinion(curT, html5libOracle(), r)
+	if hasLib && got == lb {
+		count("agrees with html5lib, not parse5")
+		return
+	}
+	if !hasLib {
+		count("differs from parse5, html5lib has no opinion")
+		return
+	}
+	if lb != p5 {
+		count("three different trees")
+		return
+	}
+	shapes := shape(Known.explainsTree(r, got, p5))
+	if len(bug) > 0 {
+		shapes = shapesOf(bug[0], Known.explainsTree(r, got, p5))
+	}
+	mismatch(ht, shapes, "tree mismatch (context %q, scripting %v)\ninput: %q\n--- x/net/html\n%s--- parse5 = html5lib\n%s", r.fragment, r.scripting, r.html, got, p5)
+}
