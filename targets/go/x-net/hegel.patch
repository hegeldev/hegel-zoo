+
+// dropEmptyCommentLines (x-net/3): the empty comment "</>" leaves behind.
+func dropEmptyCommentLines(dat string) string {
+	lines := strings.Split(dat, "\n")
+	out := lines[:0]
+	for _, l := range lines {
+		if strings.TrimLeft(l, "| ") == "<!--  -->" {
+			continue
+		}
+		out = append(out, l)
+	}
+	return strings.Join(out, "\n")
