+// the start of a dump line.
+func decodeNodes(dat, open, close string) string {
+	var b strings.Builder
+	rest := dat
+	for {
+		i := strings.Index(rest, open)
+		if i < 0 {
+			break
+		}
+		if !atLineStart(rest, i) {
+			b.WriteString(rest[:i+len(open)])
+			rest = rest[i+len(open):]
+			continue
+		}
+		j := strings.Index(rest[i+len(open):], close)
+		if j < 0 {
+			break
+		}
+		b.WriteString(rest[:i+len(open)])
+		b.WriteString(html.UnescapeString(rest[i+len(open) : i+len(open)+j]))
+		rest = rest[i+len(open)+j:]
