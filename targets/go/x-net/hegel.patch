+package hegel
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug is open
+// (listed under [expected_failures] in the zoo's target.toml).
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/html"
+)
+
+// pinTree parses input (a document, or a fragment when context is not "")
+// and compares the .dat dump with want.
+func pinTree(t *testing.T, input, context string, scripting bool, want string) {
+	t.Helper()
+	doc, err := parseTree(treeReq{html: input, fragment: context, scripting: scripting}, strings.NewReader(input))
+	if err != nil {
+		t.Fatalf("parse of %q (context %q): %v", input, context, err)
+	}
+	got, err := dump(doc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Errorf("parse of %q (context %q):\n--- got\n%s--- want\n%s", input, context, got, want)
+	}
+}
+
+func render(t *testing.T, input string) string {
+	t.Helper()
+	doc, err := html.Parse(strings.NewReader(input))
+	if err != nil {
+		t.Fatalf("parse of %q: %v", input, err)
+	}
+	var buf bytes.Buffer
+	if err := html.Render(&buf, doc); err != nil {
+		t.Fatalf("Render of the tree of %q: %v", input, err)
+	}
+	return buf.String()
+}
+
+// x-net/1
+func TestHegelPinCommentDataIsNotUnescaped(t *testing.T) {
+	pinTree(t, "<!--&amp;&#13;-->", "", true, "| <!-- &amp;&#13; -->\n| <html>\n|   <head>\n|   <body>\n")
+}
+
+// x-net/2
+func TestHegelPinDoctypeNulBecomesReplacementCharacter(t *testing.T) {
+	pinTree(t, "<!DOCTYPE html\x00 PUBLIC \"a\x00b\">", "", true, "| <!DOCTYPE html� \"a�b\" \"\">\n| <html>\n|   <head>\n|   <body>\n")
+}
+
+// x-net/3
+func TestHegelPinEmptyEndTagIsIgnored(t *testing.T) {
+	pinTree(t, "a</>b", "", true, "| <html>\n|   <head>\n|   <body>\n|     \"ab\"\n")
+}
+
+// x-net/4
+func TestHegelPinForeignFragmentAfterHtmlEndTag(t *testing.T) {
+	pinTree(t, "</html>y", "svg svg", true, "| \"y\"\n")
+}
+
+// x-net/5
+func TestHegelPinIgnoredRawTextTagInFrameset(t *testing.T) {
+	pinTree(t, "<frameset><iframe><!--x-->", "", true, "| <html>\n|   <head>\n|   <frameset>\n|     <!-- x -->\n")
+}
+
+// x-net/6
+func TestHegelPinRenderForeignElementNamedLikeVoid(t *testing.T) {
+	if got := render(t, "<svg><input>x"); got != "<html><head></head><body><svg><input>x</input></svg></body></html>" {
+		t.Errorf("rendered %q", got)
+	}
+}
+
+// x-net/7
+func TestHegelPinCDATAKeepsCharacterReferences(t *testing.T) {
+	pinTree(t, "<math><![CDATA[&amp;&#65;]]></math>", "", true, "| <html>\n|   <head>\n|   <body>\n|     <math math>\n|       \"&amp;&#65;\"\n")
+}
+
+// x-net/8
+func TestHegelPinNoscriptKeepsLeadingWhitespace(t *testing.T) {
+	pinTree(t, "<noscript>\tx</noscript>", "", false, "| <html>\n|   <head>\n|     <noscript>\n|       \"\t\"\n|   <body>\n|     \"x\"\n")
+}
+
+func TestHegelPinColumnGroupContextKeepsWhitespace(t *testing.T) {
+	pinTree(t, "<col>x  ", "colgroup", true, "| <col>\n| \"  \"\n")
+}
+
+// x-net/10
+func TestHegelPinRCDATAContextIgnoresItsOwnEndTag(t *testing.T) {
+	pinTree(t, "a</title>b", "title", true, "| \"a</title>b\"\n")
+}
+
+// x-net/11
+func TestHegelPinCarriageReturnReferenceAfterPre(t *testing.T) {
+	pinTree(t, "<pre>&#xD;x</pre>", "", true, "| <html>\n|   <head>\n|   <body>\n|     <pre>\n|       \"\rx\"\n")
+}
+
+// x-net/12
+func TestHegelPinNulAttributeNameIsDeduplicated(t *testing.T) {
+	pinTree(t, "<a \x00=\"1\" �=\"2\">", "", true, "| <html>\n|   <head>\n|   <body>\n|     <a>\n|       �=\"1\"\n")
+}
+
+// x-net/9
+func TestHegelPinRenderRawTextInMathTextIntegrationPoint(t *testing.T) {
+	if got := render(t, "<math><mtext><style>a>b</style></mtext></math>"); got != "<html><head></head><body><math><mtext><style>a>b</style></mtext></math></body></html>" {
+		t.Errorf("rendered %q", got)
