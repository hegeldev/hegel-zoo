+
+var formattingStart = regexp.MustCompile(`<(a|b|big|code|em|font|i|nobr|s|small|strike|strong|tt|u)[\s/>]`)
+
+// noahsArk: four or more start tags of the same formatting element.
+func noahsArk(low string) bool {
+	counts := map[string]int{}
+	for _, m := range formattingStart.FindAllStringSubmatch(low, -1) {
+		counts[m[1]]++
+		if counts[m[1]] >= 4 {
+			return true
+		}
+	}
+	return false
