+func TestHegelPinColumnGroupContextKeepsWhitespace(t *testing.T) {
+	pinTree(t, "<col>x  ", "colgroup", true, "| <col>\n| \"  \"\n")
+}
+
+// x-net/10
+func TestHegelPinRCDATAContextIgnoresItsOwnEndTag(t *testing.T) {
+	pinTree(t, "a</title>b", "title", true, "| \"a</title>b\"\n")
+}
+
+// x-net/11
+func TestHegelPinCarriageReturnReferenceAfterPre(t *testing.T) {
+	pinTree(t, "<pre>&#xD;x</pre>", "", true, "| <html>\n|   <head>\n|   <body>\n|     <pre>\n|       \"\rx\"\n")
+}
+
+// x-net/12
+func TestHegelPinNulAttributeNameIsDeduplicated(t *testing.T) {
+	pinTree(t, "<a \x00=\"1\" �=\"2\">", "", true, "| <html>\n|   <head>\n|   <body>\n|     <a>\n|       �=\"1\"\n")
+}
+
+// x-net/9
+func TestHegelPinRenderRawTextInMathTextIntegrationPoint(t *testing.T) {
+	if got := render(t, "<math><mtext><style>a>b</style></mtext></math>"); got != "<html><head></head><body><math><mtext><style>a>b</style></mtext></math></body></html>" {
+		t.Errorf("rendered %q", got)
+	}
+}
diff --git a/html/hegel/hegel_props_test.go b/html/hegel/hegel_props_test.go
new file mode 100644
index 0000000..c584d7b
--- /dev/null
+++ b/html/hegel/hegel_props_test.go
@@ -0,0 +1,378 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Case records: a document with its parse options, a fragment context, the
+// cut lengths of a chunked read.
+
+// parseCase is a document and the scripting flag.
+type parseCase struct {
+	doc       document
+	scripting bool
+}
+
+func (c parseCase) req() treeReq { return treeReq{html: c.doc.String(), scripting: c.scripting} }
+
+func (c parseCase) GoString() string { return fmt.Sprintf("%#v, scripting %v", c.doc, c.scripting) }
+
+// fragmentCase is a document parsed in a context (none for a whole
+// document); in a raw text context ownEnd inserts the context element's
+// own end tag into the document (x-net/10's shape), at a position taken
+// modulo the length.
+type fragmentCase struct {
+	doc       document
+	ctx       context
+	scripting bool
+	ownEnd    bool
+	ownEndAt  int
+}
+
+func (c fragmentCase) req() treeReq {
+	s := c.doc.String()
+	if c.ownEnd && c.ctx.name != "" {
+		rs := []rune(s)
+		at := c.ownEndAt % (len(rs) + 1)
+		s = string(rs[:at]) + "</" + c.ctx.name + ">" + string(rs[at:])
+	}
+	return treeReq{html: s, fragment: c.ctx.String(), scripting: c.scripting}
+}
+
+func (c fragmentCase) GoString() string {
+	r := c.req()
+	return fmt.Sprintf("%q in context %q, scripting %v", r.html, r.fragment, r.scripting)
+}
+
+// fragment is a case parsed as a fragment, or as a whole document.
+type fragment interface{ req() treeReq }
+
+// asFragment is a generator of fragment cases as the interface.
+func asFragment[T fragment](g hegel.Generator[T]) hegel.Generator[fragment] {
+	return hegel.Map(g, func(c T) fragment { return c })
+}
+
+// chunkedCase is a fragment case (a whole document seven times in ten, or
+// x-net/4's shape, which crashes chunked reads too) and the cut lengths it
+// is read in.
+type chunkedCase struct {
+	frag fragment
+	cuts []int
+}
+
+func (c chunkedCase) GoString() string { return fmt.Sprintf("%#v, cuts %v", c.frag, c.cuts) }
+
+// tokenizerCase is a document and the cut lengths it is read in.
+type tokenizerCase struct {
+	doc  document
+	cuts []int
+}
+
+func (c tokenizerCase) GoString() string { return fmt.Sprintf("%#v, cuts %v", c.doc, c.cuts) }
+
+// fragmentCasesIn is a fragment case in a context drawn from contexts.
+func fragmentCasesIn(contexts hegel.Generator[context]) hegel.Generator[fragmentCase] {
+	return hegel.Composite(func(tc hegel.TestCase) fragmentCase {
+		c := fragmentCase{
+			doc:       hegel.Draw(tc, documents),
+			ctx:       hegel.Draw(tc, contexts),
+			scripting: hegel.Draw(tc, chance(80)),
+		}
+		if c.ctx.rawText() {
+			// A dependent draw: only a raw text context has an own end
+			// tag the tokenizer should not act on.
+			c.ownEnd = hegel.Draw(tc, chance(unless(noKnown, 70)))
+			c.ownEndAt = hegel.Draw(tc, positions)
+		}
+		return c
+	})
+}
+
+var (
+	parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{doc: hegel.Draw(tc, documents), scripting: hegel.Draw(tc, chance(80))}
+	})
+	fragmentCases    = fragmentCasesIn(fragmentContexts)
+	chunkedFragments = weighted(
+		choice[fragment]{80, asFragment(fragmentCasesIn(maybe(30, fragmentContexts)))},
+		choice[fragment]{unless(noKnown, 20), asFragment(afterHtmlWith(foreignCtxs, htmlEnds))},
+	)
+	chunkedCases = hegel.Composite(func(tc hegel.TestCase) chunkedCase {
+		return chunkedCase{frag: hegel.Draw(tc, chunkedFragments), cuts: hegel.Draw(tc, cuts)}
+	})
+	tokenizerCases = hegel.Composite(func(tc hegel.TestCase) tokenizerCase {
+		return tokenizerCase{doc: hegel.Draw(tc, documents), cuts: hegel.Draw(tc, cuts)}
+	})
+)
+
+// ---------------------------------------------------------------------------
+// The parse tree against the oracles.
+
+// TestHegelParseAgreesWithTheOracles: Parse of a generated document gives a
+// consistent tree, and the same tree as parse5 and html5lib (by vote). A
+// mismatch of a recorded bug's shape fails naming the bug (known.go), or
+// under HEGEL_NO_KNOWN=1 is counted.
+func TestHegelParseAgreesWithTheOracles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := hegel.Draw(ht, parseCases).req()
+		vote(ht, r, parsed(ht, r, strings.NewReader(r.html)))
+	})
+}
+
+// TestHegelFragmentsAgreeWithTheOracles: ParseFragment in a generated
+// context gives the same nodes as the oracles' fragment parsing. Content
+// after </html> in a foreign context is x-net/4's crash, recovered by
+// ParseFragment into its error and failed naming the bug; HEGEL_NO_KNOWN=1
+// assumes the shape away before parsing.
+func TestHegelFragmentsAgreeWithTheOracles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := hegel.Draw(ht, fragmentCases).req()
+		survivable(ht, r)
+		vote(ht, r, parsed(ht, r, strings.NewReader(r.html)))
+	})
+}
+
+// survivable assumes x-net/4's shape away under HEGEL_NO_KNOWN=1 (counted);
+// by default the shape is parsed and its recovered crash fails in parsed.
+func survivable(ht *hegel.T, r treeReq) {
+	if noKnown && Known.crashesFragment(r) {
+		count("known x-net/4")
+		ht.Assume(false)
+	}
+}
+
+// parseRecovering parses with x/net/html, turning a panic that escapes the
+// parser into an error.
+func parseRecovering(r treeReq, src io.Reader) (doc *html.Node, err error) {
+	defer func() {
+		if x := recover(); x != nil {
+			doc, err = nil, fmt.Errorf("panic: %v", x)
+		}
+	}()
+	return parseTree(r, src)
+}
+
+// parsed parses with x/net/html, checks the tree's links and dumps it; an
+// error on x-net/4's shape (the nil dereference ParseFragment recovers) is
+// a mismatch named after the bug.
+func parsed(ht *hegel.T, r treeReq, src io.Reader) string {
+	doc, err := parseRecovering(r, src)
+	if err != nil {
+		if Known.crashesFragment(r) {
+			mismatch(ht, []string{"x-net/4"}, "parse error (context %q): %v\ninput: %q", r.fragment, err, r.html)
+		}
+		fail(ht, "parse error (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	if err := checkTree(doc); err != nil {
+		fail(ht, "inconsistent tree (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	got, err := dump(doc)
+	if err != nil {
+		fail(ht, "dump (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	return got
+}
+
+// ---------------------------------------------------------------------------
+// Chunked reads.
+
+// chunkReader hands out the pieces one Read at a time.
+type chunkReader struct {
+	pieces []string
+}
+
+func (c *chunkReader) Read(p []byte) (int, error) {
+	if len(c.pieces) == 0 {
+		return 0, io.EOF
+	}
+	k := copy(p, c.pieces[0])
+	if k < len(c.pieces[0]) {
+		c.pieces[0] = c.pieces[0][k:]
+	} else {
+		c.pieces = c.pieces[1:]
+	}
+	return k, nil
+}
+
+// TestHegelChunkedReadsParseAlike: a document read in random pieces (UTF-8
+// sequences split at will) parses to the same tree as one read at once.
+func TestHegelChunkedReadsParseAlike(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, chunkedCases)
+		r := c.frag.req()
+		survivable(ht, r)
+		whole := parsed(ht, r, strings.NewReader(r.html))
+		pieces := chunk(r.html, c.cuts)
+		piecewise := parsed(ht, r, &chunkReader{pieces: pieces})
+		if whole != piecewise {
+			fail(ht, "chunked parse differs (context %q)\ninput: %q\nchunks: %q\n--- whole\n%s--- chunked\n%s", r.fragment, r.html, pieces, whole, piecewise)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The tokenizer.
+
+type tok struct {
+	typ  html.TokenType
+	data string
+	attr string
+	self bool
+}
+
+// tokens runs the tokenizer over src, checking that Raw covers the input
+// exactly, and returns the tokens.
+func tokens(ht *hegel.T, input string, src io.Reader, what string) []tok {
+	z := html.NewTokenizer(src)
+	var raw bytes.Buffer
+	var out []tok
+	for {
+		tt := z.Next()
+		if tt == html.ErrorToken {
+			if err := z.Err(); err != io.EOF {
+				fail(ht, "tokenizer error (%s): %v\ninput: %q", what, err, input)
+			}
+			break
+		}
+		raw.Write(z.Raw())
+		tk := z.Token()
+		var attrs strings.Builder
+		for _, a := range tk.Attr {
+			fmt.Fprintf(&attrs, " %s|%s=%q", a.Namespace, a.Key, a.Val)
+		}
+		out = append(out, tok{tt, tk.Data, attrs.String(), tt == html.SelfClosingTagToken})
+		if len(out) > 20000 {
+			fail(ht, "tokenizer does not end (%s)\ninput: %q", what, input)
+		}
+	}
+	if raw.String() != input {
+		// A tag the input ends inside of is dropped by the specification
+		// (EOF in a tag emits nothing): the raw texts then cover the input
+		// up to its "<".
+		rest, ok := strings.CutPrefix(input, raw.String())
+		if !ok || len(rest) < 2 || rest[0] != '<' || !(rest[1] == '/' || rest[1] == '!' || rest[1] == '?' || 'a' <= rest[1]|0x20 && rest[1]|0x20 <= 'z') {
+			fail(ht, "Raw does not cover the input (%s)\ninput: %q\nraw:   %q", what, input, raw.String())
+		}
+		count("unfinished tag at the end dropped")
+	}
+	return out
+}
+
+// TestHegelTokenizerRawCoversTheInput: the raw texts of the tokens
+// partition the input, and the token stream is the same whether the input
+// comes at once or in pieces.
+func TestHegelTokenizerRawCoversTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tokenizerCases)
+		input := c.doc.String()
+		whole := tokens(ht, input, strings.NewReader(input), "whole")
+		pieces := chunk(input, c.cuts)
+		piecewise := tokens(ht, input, &chunkReader{pieces: pieces}, "chunked")
+		if fmt.Sprint(whole) != fmt.Sprint(piecewise) {
+			fail(ht, "chunked tokens differ\ninput: %q\nchunks: %q\n--- whole\n%v\n--- chunked\n%v", input, pieces, whole, piecewise)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Escaping.
+
+// TestHegelUnescapeAgreesWithEntities: UnescapeString decodes character
+// references like the entities package (text mode), python's html.unescape
+// deciding when the two differ; and UnescapeString(EscapeString(s)) == s.
+func TestHegelUnescapeAgreesWithEntities(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, refTexts)
+		if back := html.UnescapeString(html.EscapeString(s)); back != s {
+			fail(ht, "UnescapeString(EscapeString(s)) != s\ns:    %q\nesc:  %q\nback: %q", s, html.EscapeString(s), back)
+		}
+		got := html.UnescapeString(s)
+		m, err := parse5Oracle().call(map[string]any{"unescape": s})
+		if err != nil {
+			curT.Fatalf("parse5 oracle: %v", err)
+		}
+		want, _ := m["text"].(string)
+		if got == want {
+			return
+		}
+		pm, err := html5libOracle().call(map[string]any{"unescape": s})
+		if err != nil {
+			curT.Fatalf("html5lib oracle: %v", err)
+		}
+		py, _ := pm["text"].(string)
+		if py == got {
+			count("agrees with python, not entities")
+			return
+		}
+		if py != want {
+			count("three different unescapes")
+			return
+		}
+		mismatch(ht, shape(Known.explainsUnescape(s, got, want)), "UnescapeString differs from entities and python\ns:    %q\ngot:  %q\nwant: %q", s, got, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Rendering.
+
+// named is the shapes a mismatch is judged by: the classifier's answer,
+// after the bug a narrow property is about when there is one.
+func named(bug []string, classified string) []string {
+	if len(bug) > 0 {
+		return shapesOf(bug[0], classified)
+	}
+	return shape(classified)
+}
+
+// roundTrip checks that Render of the parsed tree, parsed again, gives the
+// same tree, for a tree that is well formed in the sense of Render's
+// documentation (the others are not judged); bug names the narrow
+// property's bug.
+func roundTrip(ht *hegel.T, r treeReq, bug ...string) {
+	doc, err := parseTree(r, strings.NewReader(r.html))
+	if err != nil {
+		fail(ht, "parse error: %v\ninput: %q", err, r.html)
+	}
+	if why := notWellFormed(doc); why != "" {
+		notJudged("not well formed: " + why)
+	}
+	got, err := dump(doc)
+	if err != nil {
+		fail(ht, "dump: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := html.Render(&buf, doc); err != nil {
+		mismatch(ht, named(bug, Known.explainsRenderError(doc, err)), "Render: %v\ninput: %q", err, r.html)
+	}
+	doc1, err := parseTree(r, bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		fail(ht, "parse of the rendering: %v\ninput: %q\nrendered: %q", err, r.html, buf.String())
+	}
+	got1, err := dump(doc1)
+	if err != nil {
+		fail(ht, "dump: %v", err)
+	}
+	if got != got1 {
+		mismatch(ht, named(bug, Known.explainsRoundTrip(r.html, buf.String(), got, got1)), "rendered document parses differently\ninput: %q\nrendered: %q\n--- parsed\n%s--- re-parsed\n%s", r.html, buf.String(), got, got1)
+	}
+}
+
+// TestHegelRenderedTreesReparseAlike: Render of a parsed document, parsed
+// again, gives the same tree, when the tree is well formed in the sense of
+// Render's documentation (notWellFormed names the shapes it excludes). A
+// failure of a recorded bug's shape (a decoded comment, a foreign element
+// named like a void one, raw text under a MathML text integration point,
+// a NUL attribute name) fails naming the bug.
+func TestHegelRenderedTreesReparseAlike(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		roundTrip(ht, hegel.Draw(ht, parseCases).req())
+	})
+}
diff --git a/html/hegel/hegel_shapes_test.go b/html/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..6985a3c
--- /dev/null
+++ b/html/hegel/hegel_shapes_test.go
@@ -0,0 +1,512 @@
+package hegel
+
+// One property per recorded bug of the html package (bugs.toml): a
+// generator over the bug's shape region with random contents, judged by
+// the oracles' vote or by the Render round trip as the wide properties
+// are, so that each bug has a property that finds it every run (the wide
+// properties draw the same regions as explicit alternatives, at their
+// modest weight). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region
+// the bug does not touch instead and passes: a comment without a character
+// reference, another rune in a doctype, a bogus comment, </body> in a
+// foreign context, an ordinary tag ignored in frameset mode, a foreign
+// element not named like a void one, CDATA without references, text of one
+// kind only, raw text under an HTML integration point, another element's
+// end tag, a newline after <pre>, duplicate attributes without a NUL. The
+// shapes the oracles lag on (the select change, Noah's Ark) are out of
+// these regions by construction.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// plainWords is text no rule of the parsing algorithm acts on, around the
+// shapes.
+var plainWords = pick("", "x", "foo", " ", "a b", "1")
+
+// judgeTree parses the request and votes, naming the bug.
+func judgeTree(ht *hegel.T, r treeReq, bug string) {
+	vote(ht, r, parsed(ht, r, strings.NewReader(r.html)), bug)
+}
+
+// --------------------------------------------------------------------------- x-net/1
+
+// commentRef is a comment whose body holds a character reference between
+// two edges.
+type commentRef struct{ before, ref, after string }
+
+func (c commentRef) String() string { return "<!--" + c.before + c.ref + c.after + "-->" }
+
+var (
+	refs         = pick("&amp;", "&#13;", "&lt;", "&gt;", "&#x41;", "&#65;", "&nbsp;", "&notit;", "&not", "&AMP", "&#xD;", "&#0;", "&quot;")
+	commentEdges = pick("", "x", " ", "-")
+	commentRefs  = hegel.Composite(func(tc hegel.TestCase) commentRef {
+		return commentRef{before: hegel.Draw(tc, commentEdges), ref: hegel.Draw(tc, refs), after: hegel.Draw(tc, commentEdges)}
+	})
+	commentRefMarkup = rendered(commentRefs)
+	plainComments    = hegel.Map(hegel.SampledFrom(commentBodies), func(b string) string { return comment{body: b, close: "-->"}.String() })
+	commentDocs      = cat(plainWords, shaped(commentRefMarkup, plainComments), plainWords)
+)
+
+// TestHegelCommentsKeepTheirCharacterReferences: the data of a comment is
+// kept as written; x/net/html decodes character references in it, so
+// <!--&amp;--> and <!--&--> give one tree (x-net/1). HEGEL_NO_KNOWN=1
+// draws comments without a reference.
+func TestHegelCommentsKeepTheirCharacterReferences(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgeTree(ht, treeReq{html: hegel.Draw(ht, commentDocs), scripting: true}, "x-net/1")
+	})
+}
+
+// --------------------------------------------------------------------------- x-net/2
+
+// cleanDoctypes are the doctypes of the table without a NUL.
+var cleanDoctypes = func() []string {
+	var out []string
+	for _, d := range doctypes {
+		if !strings.Contains(d, "\x00") {
+			out = append(out, d)
+		}
+	}
+	return out
+}()
+
+// doctypesWith is a doctype of the table with ins inserted into its name
+// or identifiers.
+func doctypesWith(ins hegel.Generator[string]) hegel.Generator[string] {
+	return rendered(hegel.Composite(func(tc hegel.TestCase) doctype {
+		return doctype{text: hegel.Draw(tc, hegel.SampledFrom(cleanDoctypes)), ins: hegel.Draw(tc, ins), at: hegel.Draw(tc, hegel.Integers(0, 40))}
+	}))
+}
+
+var (
+	doctypeNulMarkup = doctypesWith(hegel.Just("\x00"))
+	doctypeDocs      = cat(shaped(doctypeNulMarkup, doctypesWith(pick("x", " ", "\ufffd"))), plainWords)
+)
+
+// TestHegelDoctypeNulBecomesReplacementCharacter: a NUL in a doctype's
+// name, public or system identifier becomes U+FFFD; x/net/html keeps it
+// (x-net/2). HEGEL_NO_KNOWN=1 inserts another rune instead.
+func TestHegelDoctypeNulBecomesReplacementCharacter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgeTree(ht, treeReq{html: hegel.Draw(ht, doctypeDocs), scripting: true}, "x-net/2")
+	})
+}
+
+// --------------------------------------------------------------------------- x-net/3
+
+// emptyEnd is an end-tag-like piece of markup between two texts.
+type emptyEnd struct{ before, tag, after string }
+
+func (e emptyEnd) String() string { return e.before + e.tag + e.after }
+
+func emptyEndsWith(tags hegel.Generator[string]) hegel.Generator[emptyEnd] {
+	return hegel.Composite(func(tc hegel.TestCase) emptyEnd {
+		return emptyEnd{before: hegel.Draw(tc, plainWords), tag: hegel.Draw(tc, tags), after: hegel.Draw(tc, plainWords)}
+	})
+}
+
+var (
+	emptyEndMarkup = rendered(emptyEndsWith(hegel.Just("</>")))
+	emptyEndDocs   = shaped(emptyEndMarkup, rendered(emptyEndsWith(pick("</3>", "</ x>", "</a>"))))
+)
+
+// TestHegelEmptyEndTagsAreIgnored: the empty end tag </> emits nothing, so
+// the text around it is one node; x/net/html makes an empty comment of it
+// (x-net/3). HEGEL_NO_KNOWN=1 draws the bogus comments and the ignored end
+// tag beside it.
+func TestHegelEmptyEndTagsAreIgnored(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgeTree(ht, treeReq{html: hegel.Draw(ht, emptyEndDocs), scripting: true}, "x-net/3")
+	})
+}
+
+// --------------------------------------------------------------------------- x-net/4
+
+// afterHtml is a fragment holding an end tag followed by content, in a
+// context.
+type afterHtml struct {
+	ctx                context
+	before, end, after string
+}
+
+func (a afterHtml) req() treeReq {
+	return treeReq{html: a.before + a.end + a.after, fragment: a.ctx.String(), scripting: true}
+}
+
+func (a afterHtml) GoString() string {
+	r := a.req()
+	return fmt.Sprintf("%q in context %q", r.html, r.fragment)
+}
+
+func afterHtmlWith(ctxs hegel.Generator[context], ends hegel.Generator[string]) hegel.Generator[afterHtml] {
+	return hegel.Composite(func(tc hegel.TestCase) afterHtml {
+		return afterHtml{
+			ctx:    hegel.Draw(tc, ctxs),
+			before: hegel.Draw(tc, plainWords),
+			end:    hegel.Draw(tc, ends),
