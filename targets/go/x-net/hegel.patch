+package hegel
+
+// Random HTML with the shapes the HTML parsing algorithm has rules for
+// (misnested formatting, tables, selects, templates, foreign content, raw
+// text, comments, doctypes, character references, NULs, line ends),
+// sometimes structured, sometimes mutated, always bounded and always valid
+// UTF-8 (mutations work on runes) so it travels to the oracles as JSON.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	voidTags       = []string{"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"}
+	rawTextTags    = []string{"script", "style", "xmp", "iframe", "noembed", "noframes"}
+	rcdataTags     = []string{"textarea", "title"}
+	formattingTags = []string{"a", "b", "big", "code", "em", "font", "i", "nobr", "s", "small", "strike", "strong", "tt", "u"}
+	blockTags      = []string{
+		"address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl", "fieldset",
+		"figcaption", "figure", "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p", "search", "section",
+		"summary", "ul", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "listing", "form", "li", "dd", "dt", "button",
+		"applet", "marquee", "object", "span", "label",
+	}
+	tableTags  = []string{"table", "caption", "colgroup", "col", "thead", "tbody", "tfoot", "tr", "td", "th"}
+	selectTags = []string{"select", "option", "optgroup", "datalist"}
+	structTags = []string{
+		"html", "head", "body", "frameset", "frame", "noscript", "template", "image", "ruby", "rb", "rt", "rtc", "rp",
+		"keygen", "menuitem", "param", "sarcasm", "foo", "x-bar", "plaintext", "isindex", "command", "base", "basefont",
+		"bgsound", "meta", "link", "title", "style", "script",
+	}
+	foreignTags = []string{
+		"svg", "math", "mi", "mo", "mn", "ms", "mtext", "annotation-xml", "foreignObject", "desc", "g", "path", "title",
+		"malignmark", "mglyph", "altGlyph", "feBlend", "textPath", "clipPath", "linearGradient",
+	}
+	// The HTML-namespace tags a fragment may be parsed in the context of.
+	contexts        = contextTags()
+	foreignContexts = []string{"svg path", "svg svg", "svg desc", "svg foreignObject", "svg title", "math mi", "math math", "math annotation-xml", "math mtext"}
+
+	attrNames = []string{
+		"id", "class", "href", "src", "type", "name", "value", "style", "title", "lang", "dir", "hidden", "data-x", "onclick",
+		"xlink:href", "xlink:title", "xml:lang", "xml:space", "xmlns", "xmlns:xlink", "xmlns:foo", "definitionurl", "definitionURL",
+		"encoding", "viewbox", "viewBox", "attributeName", "ATTRIBUTENAME", "zoomAndPan", "foo", "a", "x:y", "action", "prompt",
+		"FOO", "Data-Y", "id", "class",
+	}
+	attrValues = []string{
+		"", "x", "1", "hidden", "text/html", "application/xhtml+xml", "text/plain", "foo bar", "&amp;", "&lt;x", "&notit;", "&not",
+		"&#65;", "&#x41;", "&AMP", "a&b", "&", "&;", ">", "<", "/", "=", "'", "\"", "é", "\x00", "\n", "\t", "  ", "\U0001F600",
+		"-//W3C//DTD HTML 4.01//EN", "http://www.w3.org/2000/svg", "http://www.w3.org/1998/Math/MathML", "http://www.w3.org/1999/xhtml",
+	}
+	words = []string{
+		"foo", "bar", "x", "Hello", "a b", "text", "1", "\n", "  ", "\t", "\f", "\r\n", "\r", "\x00", "é", "\U0001F600", " ",
+		"&amp;", "&lt;", "&gt;", "&quot;", "&nbsp;", "&notit;", "&not", "&AMP", "&AMP;", "&#65;", "&#x41;", "&#0;", "&#x80;", "&#xD800;",
+		"&#x10FFFF;", "&#x110000;", "&#xD;", "&#13;", "&#x9;", "&foo;", "&", "&#", "&#x", "&#xZ", "<", "</", "</ ", "<3", "< a", ">",
+		"<!", "<!->", "<?x>", "]]>", "--", "-->", "<![CDATA[x]]>", "<![CDATA[", "�", "\v", "​", "\x01", "\x7f", "",
+		"&#x2028;", "&#xfdd0;", "&#xfffe;", "&#x1fffe;", "&CounterClockwiseContourIntegral;", "&ThisIsNotAnEntity;", "&am", "&ampx",
+		"x&ampx", "&#128;", "&#160;", "&#x9F;", "&#x00000041;", "&#0000000000065;", "&lt", "&ltx", "&Aacute", "&Aacutex", "&cent",
+	}
+	commentBodies = []string{"", "x", " x ", "-", "--", "--!", ">", "->", "-->", "<!--", "--x", "x--", "-x-", "<!", "a\nb", "\x00", "--!>", "<!-- --"}
+	doctypes      = []string{
+		"<!DOCTYPE html>", "<!doctype html>", "<!DOCTYPE HTML>", "<!DOCTYPE>", "<!DOCTYPE html SYSTEM \"about:legacy-compat\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Frameset//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\">", "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">",
+		"<!DOCTYPE html SYSTEM 'http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd'>", "<!DOCTYPE html PUBLIC>",
+		"<!DOCTYPE html PUBLIC \"x\">", "<!DOCTYPE html SYSTEM>", "<!DOCTYPE html SYSTEM \"x\" \"y\">", "<!DOCTYPE potato>",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\">", "<!DOCTYPE html PUBLIC \"-/W3C/DTD HTML 4.0 Transitional/EN\">",
+		"<!DOCTYPE html PUBLIC \"HTML\">", "<!DOCTYPE html PUBLIC \"-//WebTechs//DTD Mozilla HTML 2.0//EN\">", "<!DOCTYPE html\x00>",
+		"<!DOCTYPE html \"x\">", "<!DOCTYPE html PUBLIC\"x\"\"y\">", "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 3.2 Final//EN\">",
+	}
+	mutationChars = []string{"<", ">", "/", "&", ";", "\"", "'", "=", " ", "-", "!", "\n", "\r", "\x00", "?", "[", "]", "a", "p", "t"}
+)
+
+func contextTags() []string {
+	seen := map[string]bool{"image": true, "sarcasm": true, "x-bar": true, "foo": true, "isindex": true, "command": true}
+	var out []string
+	for _, group := range [][]string{voidTags, rawTextTags, rcdataTags, formattingTags, blockTags, tableTags, selectTags, structTags} {
+		for _, t := range group {
+			if !seen[t] {
+				seen[t] = true
+				out = append(out, t)
+			}
+		}
+	}
+	return out
+}
+
+func isVoid(name string) bool {
+	for _, v := range voidTags {
+		if v == name {
+			return true
+		}
+	}
+	return false
+}
+
+func isRawOrRCData(name string) bool {
+	for _, v := range rawTextTags {
+		if v == name {
+			return true
+		}
+	}
+	for _, v := range rcdataTags {
+		if v == name {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Names and case. A tag or attribute name is written as given, upper-cased
+// or title-cased one time in twenty each.
+
+type tagCase int
+
+const (
+	plainCase tagCase = iota
+	upperCase
+	titleCase
+)
+
+func (c tagCase) of(name string) string {
+	switch c {
+	case upperCase:
+		return strings.ToUpper(name)
+	case titleCase:
+		if name == "" {
+			return name
+		}
+		return strings.ToUpper(name[:1]) + name[1:]
+	}
+	return name
+}
+
+var (
+	kases = weighted(
+		choice[tagCase]{18, hegel.Just(plainCase)},
+		choice[tagCase]{1, hegel.Just(upperCase)},
+		choice[tagCase]{1, hegel.Just(titleCase)},
+	)
+	// tagNames: the groups the parsing algorithm has rules for, the
+	// formatting elements first.
+	tagNames = weighted(
+		choice[string]{14, hegel.SampledFrom(formattingTags)},
+		choice[string]{26, hegel.SampledFrom(blockTags)},
+		choice[string]{12, hegel.SampledFrom(tableTags)},
+		choice[string]{6, hegel.SampledFrom(selectTags)},
+		choice[string]{7, hegel.SampledFrom(voidTags)},
+		choice[string]{5, hegel.SampledFrom(rawTextTags)},
+		choice[string]{2, hegel.SampledFrom(rcdataTags)},
+		choice[string]{14, hegel.SampledFrom(structTags)},
+		choice[string]{14, hegel.SampledFrom(foreignTags)},
+	)
+	wordOf = hegel.SampledFrom(words)
+)
+
+// rendered is the texts of a generator of records.
+func rendered[T token](g hegel.Generator[T]) hegel.Generator[string] {
+	return hegel.Map(g, func(v T) string { return v.String() })
+}
+
+// ---------------------------------------------------------------------------
+// Tokens: the records a soup is a list of, each rendered by its String.
+
+// token is a piece of markup: a start or end tag, text, a comment, a
+// doctype, bogus markup, a known shape; the children of an element too.
+type token interface{ String() string }
+
+// as is a token generator from a generator of one kind of token.
+func as[T token](g hegel.Generator[T]) hegel.Generator[token] {
+	return hegel.Map(g, func(v T) token { return v })
+}
+
+// attr is one attribute of a start tag: what precedes it, its name and
+// case, and the form of its value (0 none, 1 unquoted, 2 single-quoted,
+// 3 double-quoted with spaces around the equals sign, 4 double-quoted).
+type attr struct {
+	lead  string
+	name  string
+	kase  tagCase
+	form  int
+	value string
+}
+
+func (a attr) String() string {
+	name := a.kase.of(a.name)
+	switch a.form {
+	case 0:
+		return a.lead + name
+	case 1:
+		return a.lead + name + "=" + a.value
+	case 2:
+		return a.lead + name + "='" + strings.ReplaceAll(a.value, "'", "") + "'"
+	case 3:
+		return a.lead + name + ` = "` + strings.ReplaceAll(a.value, `"`, "") + `"`
+	}
+	return a.lead + name + `="` + strings.ReplaceAll(a.value, `"`, "") + `"`
+}
+
+func (a attr) GoString() string { return fmt.Sprintf("%q", a.String()) }
+
+// attrOf is an attribute of the form, its value drawn from values.
+func attrOf(form int, values hegel.Generator[string]) hegel.Generator[attr] {
+	return hegel.Composite(func(tc hegel.TestCase) attr {
+		return attr{
+			lead:  hegel.Draw(tc, leads),
+			name:  hegel.Draw(tc, hegel.SampledFrom(attrNames)),
+			kase:  hegel.Draw(tc, kases),
+			form:  form,
+			value: hegel.Draw(tc, values),
+		}
+	})
+}
+
+var (
+	leads     = pick(" ", " ", " ", "\n", "\t", "/", "  ")
+	attrValue = hegel.SampledFrom(attrValues)
+	attrs     = weighted(
+		choice[attr]{1, attrOf(0, hegel.Just(""))},
+		choice[attr]{1, attrOf(1, pick("x", "1", "a/b", "&amp;", "x>", "&", "foo&bar"))},
+		choice[attr]{1, attrOf(2, attrValue)},
+		choice[attr]{1, attrOf(3, attrValue)},
+		choice[attr]{6, attrOf(4, attrValue)},
+	)
+	// attrLists: none three times in five, one to three otherwise, and by
+	// default the NUL-named attribute beside a U+FFFD-named one (x-net/12's
+	// shape, hegel_shapes_test.go).
+	attrLists = weighted(
+		choice[[]attr]{60, hegel.Just([]attr(nil))},
+		choice[[]attr]{40, many(attrs, 1, 3)},
+		choice[[]attr]{unless(noKnown, 3), nulAttrPairs},
+	)
+)
+
+// startTag is a start tag: name, case, attributes and how it ends (">",
+// self-closing, a trailing space, a stray "<", or unfinished at the end of
+// the input). A nameless one renders as nothing (an absent optional tag).
+type startTag struct {
+	name  string
+	kase  tagCase
+	attrs []attr
+	tail  string
+}
+
+func (s startTag) String() string {
+	if s.name == "" {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString("<" + s.kase.of(s.name))
+	for _, a := range s.attrs {
+		b.WriteString(a.String())
+	}
+	b.WriteString(s.tail)
+	return b.String()
+}
+
+func (s startTag) GoString() string { return fmt.Sprintf("%q", s.String()) }
+
+var tails = weighted(
+	choice[string]{25, hegel.Just(">")},
+	choice[string]{1, hegel.Just("/>")},
+	choice[string]{1, hegel.Just(" />")},
+	choice[string]{1, hegel.Just(" >")},
+	choice[string]{1, hegel.Just("<>")},
+	choice[string]{1, hegel.Just("")},
+)
+
+// startTagOf is a start tag named by names.
+func startTagOf(names hegel.Generator[string]) hegel.Generator[startTag] {
+	return hegel.Composite(func(tc hegel.TestCase) startTag {
+		return startTag{
+			name:  hegel.Draw(tc, names),
+			kase:  hegel.Draw(tc, kases),
+			attrs: hegel.Draw(tc, attrLists),
+			tail:  hegel.Draw(tc, tails),
+		}
+	})
+}
+
+var startTags = startTagOf(tagNames)
+
+// endTag is an end tag: name, case and how it ends. In a soup, closes says
+// what it closes: -1 the name as drawn, else the tag opened closes-th from
+// the top of the soup's open tags (the renderer's stack, taken modulo its
+// depth; the name as drawn when nothing is open).
+type endTag struct {
+	name   string
+	kase   tagCase
+	tail   string
+	closes int
+}
+
+func (e endTag) of(name string) string { return "</" + e.kase.of(name) + e.tail }
+
+func (e endTag) String() string { return e.of(e.name) }
+
+func (e endTag) GoString() string {
+	if e.closes < 0 {
+		return fmt.Sprintf("%q", e.String())
+	}
+	return fmt.Sprintf("%q closing the open tag %d from the top", e.String(), e.closes)
+}
+
+var (
+	endTails = weighted(
+		choice[string]{16, hegel.Just(">")},
+		choice[string]{1, hegel.Just(` x="y">`)},
+		choice[string]{1, hegel.Just("/>")},
+		choice[string]{1, hegel.Just(" ")},
+		choice[string]{1, hegel.Just("")},
+	)
+	closings = weighted(
+		choice[int]{25, hegel.Just(-1)},
+		choice[int]{53, hegel.Just(0)},
+		choice[int]{22, hegel.Integers(1, 7)},
+	)
+	endTags = hegel.Composite(func(tc hegel.TestCase) endTag {
+		return endTag{
+			name:   hegel.Draw(tc, tagNames),
+			kase:   hegel.Draw(tc, kases),
+			tail:   hegel.Draw(tc, endTails),
+			closes: hegel.Draw(tc, closings),
+		}
+	})
+)
+
+// endTagOf is the end tag of an element of the name.
+func endTagOf(name string) hegel.Generator[endTag] {
+	return hegel.Composite(func(tc hegel.TestCase) endTag {
+		return endTag{name: name, kase: hegel.Draw(tc, kases), tail: hegel.Draw(tc, endTails), closes: -1}
+	})
+}
+
+// text is a text token: one to three words.
+type text string
+
+func (t text) String() string { return string(t) }
+
+// comment is a comment: its body and how it ends ("-->", "--!>", or not at
+// all).
+type comment struct{ body, close string }
+
+func (c comment) String() string { return "<!--" + c.body + c.close }
+
+func (c comment) GoString() string { return fmt.Sprintf("%q", c.String()) }
+
+// bogus is markup the tokenizer has a bogus comment, a CDATA section or
+// another odd path for.
+type bogus string
+
+func (b bogus) String() string { return string(b) }
+
+// doctype is a doctype of the table with a text inserted into its name or
+// identifiers ("" none; the NUL of x-net/2's shape by default).
+type doctype struct {
+	text string
+	ins  string
+	at   int
+}
+
+func (d doctype) String() string {
+	if d.ins == "" {
+		return d.text
+	}
+	inner := strings.TrimSuffix(d.text, ">")
+	if len(inner) < 10 {
+		return inner + d.ins + ">"
+	}
+	at := 10 + d.at%(len(inner)-9)
+	return inner[:at] + d.ins + inner[at:] + ">"
+}
+
+func (d doctype) GoString() string { return fmt.Sprintf("%q", d.String()) }
+
+// shape is the markup of a recorded bug's shape region
+// (hegel_shapes_test.go), drawn by the wide generators by default.
+type shapeMarkup string
+
+func (s shapeMarkup) String() string { return string(s) }
+
+var (
+	texts         = hegel.Map(joined(many(wordOf, 1, 3)), func(s string) text { return text(s) })
+	commentCloses = weighted(
+		choice[string]{8, hegel.Just("-->")},
+		choice[string]{1, hegel.Just("")},
+		choice[string]{1, hegel.Just("--!>")},
+	)
+	comments = hegel.Composite(func(tc hegel.TestCase) comment {
+		return comment{body: hegel.Draw(tc, hegel.SampledFrom(commentBodies)), close: hegel.Draw(tc, commentCloses)}
+	})
+	bogusMarkup   = pick("<!-->", "<!--->", "<!x>", "<?x>", "<?", "<!", "</>", "</3>", "<! >", "<!--->x", "<!-", "<!-x", "<!doctyp>", "<![CDATA[x]]>", "<![CDATA[x", "<!DOCTYPE")
+	commentTokens = weighted(
+		choice[token]{9, as(comments)},
+		choice[token]{1, as(hegel.Map(bogusMarkup, func(s string) bogus { return bogus(s) }))},
+	)
+	doctypeTokens = hegel.Composite(func(tc hegel.TestCase) doctype {
+		return doctype{
+			text: hegel.Draw(tc, hegel.SampledFrom(doctypes)),
+			ins:  hegel.Draw(tc, weighted(choice[string]{20, hegel.Just("")}, choice[string]{unless(noKnown, 4), hegel.Just("\x00")})),
+			at:   hegel.Draw(tc, hegel.Integers(0, 40)),
+		}
+	})
+	shapeTokens = as(hegel.Map(knownShapes, func(s string) shapeMarkup { return shapeMarkup(s) }))
+	// soupTokens: text first (the simplest), then the tags, comments and
+	// doctypes, and by default a known shape.
+	soupTokens = weighted(
+		choice[token]{28, as(texts)},
+		choice[token]{38, as(startTags)},
+		choice[token]{22, as(endTags)},
+		choice[token]{8, commentTokens},
+		choice[token]{4, as(doctypeTokens)},
+		choice[token]{unless(noKnown, 10), shapeTokens},
+	)
+	// soups: up to 24 tokens.
+	soups = many(soupTokens, 0, 24)
+)
+
+// renderSoup renders the tokens; an end tag that closes an open tag takes
+// its name from the stack of the start tags not yet closed.
+func renderSoup(toks []token) string {
+	var b strings.Builder
+	var open []string
+	for _, t := range toks {
+		switch t := t.(type) {
+		case startTag:
+			if !isVoid(t.name) {
+				open = append(open, t.name)
+			}
+			b.WriteString(t.String())
+		case endTag:
+			if t.closes >= 0 && len(open) > 0 {
+				i := len(open) - 1 - t.closes%len(open)
+				b.WriteString(t.of(open[i]))
+				open = append(open[:i], open[i+1:]...)
+			} else {
+				b.WriteString(t.String())
+			}
+		default:
+			b.WriteString(t.String())
+		}
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Structured documents: a tower of element records, one generator per
+// depth, memoised.
+
+// element is an element of a structured document: its start tag, raw
+// content when the tag is a raw text or RCDATA one, children otherwise,
+// and whether it is closed, by which end tag. A nameless one renders as
+// nothing.
+type element struct {
+	tag      startTag
+	raw      string
+	children []token
+	closed   bool
+	end      endTag
+}
+
+func (e element) String() string {
+	if e.tag.name == "" {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString(e.tag.String())
+	if isVoid(e.tag.name) {
+		return b.String()
+	}
+	b.WriteString(e.raw)
+	for _, c := range e.children {
+		b.WriteString(c.String())
+	}
+	if e.closed {
+		b.WriteString(e.end.String())
+	}
+	return b.String()
+}
+
+func (e element) GoString() string { return fmt.Sprintf("%q", e.String()) }
+
+var elementCache = map[int]hegel.Generator[element]{}
+
+// elementAt is the element generator of one depth of the tower: a void
+// tag stands alone, a raw text tag holds raw content, any other tag holds
+// up to three children drawn from the depth below (none at the bottom).
+// Memoised per depth: a self-referencing package-level generator would be
+// an init cycle.
+func elementAt(depth int) hegel.Generator[element] {
+	if g, ok := elementCache[depth]; ok {
+		return g
+	}
+	children := hegel.Just([]token(nil))
+	if depth <= 4 {
+		children = many(childAt(depth+1), 0, 3)
+	}
+	g := hegel.FlatMap(tagNames, func(name string) hegel.Generator[element] {
+		tag := startTagOf(hegel.Just(name))
+		switch {
+		case isVoid(name):
+			return hegel.Map(tag, func(t startTag) element { return element{tag: t} })
+		case isRawOrRCData(name):
+			raw := pick("", "x", "a<b", "</", "</"+name, "</"+name+" ", "<!--", "-->", "&amp;", "<script>", "</script>", "]]>", "\x00")
+			return hegel.Composite(func(tc hegel.TestCase) element {
+				return element{tag: hegel.Draw(tc, tag), raw: hegel.Draw(tc, raw), closed: hegel.Draw(tc, chance(85)), end: hegel.Draw(tc, endTagOf(name))}
+			})
+		}
+		return hegel.Composite(func(tc hegel.TestCase) element {
+			return element{tag: hegel.Draw(tc, tag), children: hegel.Draw(tc, children), closed: hegel.Draw(tc, chance(80)), end: hegel.Draw(tc, endTagOf(name))}
+		})
+	})
+	elementCache[depth] = g
+	return g
+}
+
+// childAt is a child of an element at the depth: text, an element of the
+// depth, a comment, and by default a known shape.
+func childAt(depth int) hegel.Generator[token] {
+	return weighted(
+		choice[token]{32, as(texts)},
+		choice[token]{60, as(elementAt(depth))},
+		choice[token]{8, commentTokens},
+		choice[token]{unless(noKnown, 4), shapeTokens},
+	)
+}
+
+// headPart is a head start tag, at most one element (or, by default, a
+// noscript holding mixed text, x-net/8's shape with scripting off) in it,
+// closed or not.
+type headPart struct {
+	tag    startTag
+	item   token
+	closed bool
+}
+
+func (h headPart) String() string {
+	if h.tag.name == "" {
+		return ""
+	}
+	s := h.tag.String() + h.item.String()
+	if h.closed {
+		s += "</head>"
+	}
+	return s
+}
+
+// structured is a document with an optional doctype, html, head and body
+// start tags, a few elements or texts, a little soup, optional body and
+// html end tags and a little soup after them.
+type structured struct {
+	doctype   string
+	html      startTag
+	head      headPart
+	body      startTag
+	items     []token
+	soup      []token
+	closeBody bool
+	closeHtml bool
+	trailing  []token
+}
+
+func (d structured) String() string {
+	var b strings.Builder
+	b.WriteString(d.doctype)
+	b.WriteString(d.html.String())
+	b.WriteString(d.head.String())
+	b.WriteString(d.body.String())
+	for _, it := range d.items {
+		b.WriteString(it.String())
+	}
+	b.WriteString(renderSoup(d.soup))
+	if d.closeBody {
+		b.WriteString("</body>")
+	}
+	if d.closeHtml {
+		b.WriteString("</html>")
+	}
+	b.WriteString(renderSoup(d.trailing))
+	return b.String()
+}
+
+var (
+	headItems = weighted(
+		choice[token]{50, as(hegel.Just(text("")))},
+		choice[token]{50, as(elementAt(3))},
+		choice[token]{unless(noKnown, 25), as(hegel.Map(noscriptMixedMarkup, func(s string) shapeMarkup { return shapeMarkup(s) }))},
+	)
+	headParts = hegel.Composite(func(tc hegel.TestCase) headPart {
+		return headPart{tag: hegel.Draw(tc, startTagOf(hegel.Just("head"))), item: hegel.Draw(tc, headItems), closed: hegel.Draw(tc, chance(70))}
+	})
+	items          = weighted(choice[token]{25, as(texts)}, choice[token]{75, as(elementAt(0))})
+	structuredDocs = hegel.Composite(func(tc hegel.TestCase) structured {
+		return structured{
+			doctype:   hegel.Draw(tc, maybe(60, hegel.SampledFrom(doctypes))),
+			html:      hegel.Draw(tc, maybe(30, startTagOf(hegel.Just("html")))),
+			head:      hegel.Draw(tc, maybe(30, headParts)),
+			body:      hegel.Draw(tc, maybe(30, startTagOf(hegel.Just("body")))),
+			items:     hegel.Draw(tc, many(items, 0, 4)),
+			soup:      hegel.Draw(tc, maybe(30, many(soupTokens, 0, 6))),
+			closeBody: hegel.Draw(tc, chance(20)),
+			closeHtml: hegel.Draw(tc, chance(20)),
+			trailing:  hegel.Draw(tc, maybe(20, many(soupTokens, 0, 4))),
+		}
+	})
+)
+
+// ---------------------------------------------------------------------------
+// Edits: changes to a document's runes (so the result stays valid UTF-8),
+// drawn as data and applied with positions taken modulo the live length.
+
+// edit is one change: a rune deleted, a piece inserted, a span duplicated
+// or cut.
+type edit struct {
+	kind  string
+	at    int
+	span  int
+	piece string
+}
+
+func (e edit) apply(rs []rune) []rune {
+	n := len(rs)
+	at := e.at % (n + 1)
+	switch e.kind {
+	case "delete":
+		if at < n {
+			return append(rs[:at:at], rs[at+1:]...)
+		}
+	case "insert":
+		return append(rs[:at:at], append([]rune(e.piece), rs[at:]...)...)
+	case "duplicate":
+		to := min(at+e.span, n)
+		dup := append([]rune{}, rs[at:to]...)
+		return append(rs[:at:at], append(dup, rs[at:]...)...)
+	case "cut":
+		to := min(at+e.span, n)
+		return append(rs[:at:at], rs[to:]...)
+	}
+	return rs
+}
+
+func (e edit) String() string {
+	switch e.kind {
+	case "insert":
+		return fmt.Sprintf("insert %q at %d", e.piece, e.at)
+	case "duplicate", "cut":
+		return fmt.Sprintf("%s %d at %d", e.kind, e.span, e.at)
+	}
+	return fmt.Sprintf("%s at %d", e.kind, e.at)
+}
+
+var (
+	spans = hegel.Integers(1, 8)
+	edits = weighted(
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "delete", at: at} })},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "insert", at: hegel.Draw(tc, positions), piece: hegel.Draw(tc, hegel.SampledFrom(mutationChars))}
+		})},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "duplicate", at: hegel.Draw(tc, positions), span: hegel.Draw(tc, spans)}
+		})},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "cut", at: hegel.Draw(tc, positions), span: hegel.Draw(tc, spans)}
+		})},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Documents.
+
+// document is a soup or a structured document, with edits applied to its
+// runes, at most 600 runes.
+type document struct {
+	soup   []token
+	tree   structured
+	isTree bool
+	edits  []edit
+}
+
+func (d document) String() string {
+	s := renderSoup(d.soup)
+	if d.isTree {
+		s = d.tree.String()
+	}
+	rs := []rune(s)
+	for _, e := range d.edits {
+		if len(rs) == 0 {
+			break
+		}
+		rs = e.apply(rs)
+	}
+	if len(rs) > 600 {
+		rs = rs[:600]
+	}
+	return string(rs)
+}
+
+func (d document) GoString() string {
+	kind := "soup"
+	if d.isTree {
+		kind = "structured"
+	}
+	if len(d.edits) == 0 {
+		return fmt.Sprintf("%s %q", kind, d.String())
+	}
+	return fmt.Sprintf("%s %q (edits %v)", kind, d.String(), d.edits)
+}
+
+var (
+	soupDocs = hegel.Map(soups, func(s []token) document { return document{soup: s} })
+	treeDocs = hegel.Map(structuredDocs, func(t structured) document { return document{tree: t, isTree: true} })
+	// documents: soup, structure, or a mutation of either.
+	documents = weighted(
+		choice[document]{4, soupDocs},
+		choice[document]{4, treeDocs},
+		choice[document]{1, hegel.Composite(func(tc hegel.TestCase) document {
+			return document{soup: hegel.Draw(tc, soups), edits: hegel.Draw(tc, many(edits, 1, 3))}
+		})},
+		choice[document]{1, hegel.Composite(func(tc hegel.TestCase) document {
+			return document{tree: hegel.Draw(tc, structuredDocs), isTree: true, edits: hegel.Draw(tc, many(edits, 1, 3))}
+		})},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Fragment contexts and chunk cuts.
+
+// context is a fragment context: an element name in the HTML namespace, or
+// an SVG or MathML one. A nameless one is no context (a whole document).
+type context struct{ ns, name string }
+
+func (c context) String() string {
+	if c.ns == "" {
+		return c.name
+	}
+	return c.ns + " " + c.name
+}
+
+// rawText reports whether the context element puts the tokenizer in a raw
+// text, RCDATA or plaintext state (noscript with scripting on).
+func (c context) rawText() bool {
+	return c.ns == "" && (isRawOrRCData(c.name) || c.name == "plaintext" || c.name == "noscript")
+}
+
+func parseContext(s string) context {
+	ns, name, ok := strings.Cut(s, " ")
+	if !ok {
+		return context{name: s}
+	}
+	return context{ns: ns, name: name}
+}
+
+var (
+	rawContextNames = pick("title", "textarea", "script", "style", "xmp", "iframe", "noembed", "noframes", "plaintext", "noscript")
+	// fragmentContexts: an HTML element mostly, a foreign one sometimes,
+	// and by default the raw text contexts of x-net/10 and the colgroup
+	// context of x-net/8 a little more often than the table gives them.
+	fragmentContexts = weighted(
+		choice[context]{82, hegel.Map(hegel.SampledFrom(contexts), parseContext)},
+		choice[context]{unless(noKnown, 5), hegel.Map(rawContextNames, parseContext)},
+		choice[context]{unless(noKnown, 3), hegel.Just(context{name: "colgroup"})},
+		choice[context]{15, hegel.Map(hegel.SampledFrom(foreignContexts), parseContext)},
+	)
+	// cuts: chunk lengths, byte-sized three times in ten.
+	cuts = many(weighted(choice[int]{7, hegel.Integers(1, 40)}, choice[int]{3, hegel.Integers(1, 2)}), 0, 40)
+)
+
+// chunk splits s at the cut lengths (a cut longer than what is left is
+// taken modulo it; UTF-8 sequences may be split: the reader sees bytes);
+// the input past the last cut is one chunk.
+func chunk(s string, cuts []int) []string {
+	var out []string
+	i := 0
+	for _, c := range cuts {
+		if i >= len(s) {
+			break
+		}
+		l := (c-1)%(len(s)-i) + 1
+		out = append(out, s[i:i+l])
+		i += l
+	}
+	if i < len(s) {
+		out = append(out, s[i:])
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Reference text: a list of pieces rich in character references, well and
+// badly formed.
+
+var refNames = []string{"amp", "lt", "gt", "quot", "apos", "nbsp", "not", "notit", "notin", "AMP", "Amp", "copy", "COPY", "cent", "pound", "lang", "rang",
+	"CounterClockwiseContourIntegral", "ThisIsNotAnEntity", "am", "a", "Aacute", "aacute", "x", "frac12", "NewLine", "Tab", "zwj", "bne", "fjlig", "ngE", "nvlt"}
+
+var (
+	semicolon = weighted(choice[string]{7, hegel.Just(";")}, choice[string]{3, hegel.Just("")})
+	refPieces = weighted(
+		choice[string]{1, wordOf},
+		choice[string]{1, cat(hegel.Just("&"), hegel.SampledFrom(refNames), weighted(
+			choice[string]{6, hegel.Just(";")},
+			choice[string]{2, hegel.Just("")},
+			choice[string]{2, pick("=", "x", "1", " ", "&", "-")},
+		))},
+		choice[string]{1, cat(hegel.Just("&#"), pick("0", "9", "10", "13", "38", "60", "65", "128", "129", "150", "159", "160", "173", "8232", "55296", "57343", "65534", "65535", "1114111", "1114112", "99999999999", "0065", "x", ""), semicolon)},
+		choice[string]{1, cat(hegel.Just("&#"), pick("x", "X"), pick("0", "9", "A", "41", "7F", "80", "9F", "D800", "DFFF", "FDD0", "FFFE", "FFFF", "10FFFF", "110000", "FFFFFFFFF", "0041", "g", ""), semicolon)},
+		choice[string]{2, pick("a", " ", "<", ">", "\"", "'", "\r", "\n", "\x00", "\u00e9", "\U0001F600", "&", ";", "#")},
+	)
+	refTexts = joined(many(refPieces, 1, 4))
+)
