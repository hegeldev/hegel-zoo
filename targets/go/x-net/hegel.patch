diff --git a/html/hegel/hegel_props_test.go b/html/hegel/hegel_props_test.go
new file mode 100644
index 0000000..08fd0e4
--- /dev/null
+++ b/html/hegel/hegel_props_test.go
@@ -0,0 +1,284 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// The parse tree against the oracles.
+
+// TestHegelParseAgreesWithTheOracles: Parse of a generated document gives a
+// consistent tree, and the same tree as parse5 and html5lib (by vote).
+func TestHegelParseAgreesWithTheOracles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := treeReq{html: document(ht), scripting: chance(ht, 80)}
+		got := parsed(ht, r, strings.NewReader(r.html))
+		vote(ht, r, got)
+	})
+}
+
+// TestHegelFragmentsAgreeWithTheOracles: ParseFragment in a generated
+// context gives the same nodes as the oracles' fragment parsing.
+func TestHegelFragmentsAgreeWithTheOracles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := treeReq{html: document(ht), fragment: context(ht), scripting: chance(ht, 80)}
+		if Known.crashesFragment(r) {
+			count("known x-net/4")
+			return
+		}
+		got := parsed(ht, r, strings.NewReader(r.html))
+		vote(ht, r, got)
+	})
+}
+
+// parsed parses with x/net/html, checks the tree's links and dumps it.
+func parsed(ht *hegel.T, r treeReq, src io.Reader) string {
+	doc, err := parseTree(r, src)
+	if err != nil {
+		fail(ht, "parse error (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	if err := checkTree(doc); err != nil {
+		fail(ht, "inconsistent tree (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	got, err := dump(doc)
+	if err != nil {
+		fail(ht, "dump (context %q): %v\ninput: %q", r.fragment, err, r.html)
+	}
+	return got
+}
+
+// ---------------------------------------------------------------------------
+// Chunked reads.
+
+// chunkReader hands out the pieces one Read at a time.
+type chunkReader struct {
+	pieces []string
+}
+
+func (c *chunkReader) Read(p []byte) (int, error) {
+	if len(c.pieces) == 0 {
+		return 0, io.EOF
+	}
+	k := copy(p, c.pieces[0])
+	if k < len(c.pieces[0]) {
+		c.pieces[0] = c.pieces[0][k:]
+	} else {
+		c.pieces = c.pieces[1:]
+	}
+	return k, nil
+}
+
+// TestHegelChunkedReadsParseAlike: a document read in random pieces (UTF-8
+// sequences split at will) parses to the same tree as one read at once.
+func TestHegelChunkedReadsParseAlike(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := treeReq{html: document(ht), scripting: chance(ht, 80)}
+		if chance(ht, 30) {
+			r.fragment = context(ht)
+		}
+		if Known.crashesFragment(r) {
+			count("known x-net/4")
+			return
+		}
+		whole := parsed(ht, r, strings.NewReader(r.html))
+		pieces := chunks(ht, r.html)
+		piecewise := parsed(ht, r, &chunkReader{pieces: pieces})
+		if whole != piecewise {
+			fail(ht, "chunked parse differs (context %q)\ninput: %q\nchunks: %q\n--- whole\n%s--- chunked\n%s", r.fragment, r.html, pieces, whole, piecewise)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The tokenizer.
+
+type tok struct {
+	typ  html.TokenType
+	data string
+	attr string
+	self bool
+}
+
+// tokens runs the tokenizer over src, checking that Raw covers the input
+// exactly, and returns the tokens.
+func tokens(ht *hegel.T, input string, src io.Reader, what string) []tok {
+	z := html.NewTokenizer(src)
+	var raw bytes.Buffer
+	var out []tok
+	for {
+		tt := z.Next()
+		if tt == html.ErrorToken {
+			if err := z.Err(); err != io.EOF {
+				fail(ht, "tokenizer error (%s): %v\ninput: %q", what, err, input)
+			}
+			break
+		}
+		raw.Write(z.Raw())
+		tk := z.Token()
+		var attrs strings.Builder
+		for _, a := range tk.Attr {
+			fmt.Fprintf(&attrs, " %s|%s=%q", a.Namespace, a.Key, a.Val)
+		}
+		out = append(out, tok{tt, tk.Data, attrs.String(), tt == html.SelfClosingTagToken})
+		if len(out) > 20000 {
+			fail(ht, "tokenizer does not end (%s)\ninput: %q", what, input)
+		}
+	}
+	if raw.String() != input {
+		// A tag the input ends inside of is dropped by the specification
+		// (EOF in a tag emits nothing): the raw texts then cover the input
+		// up to its "<".
+		rest, ok := strings.CutPrefix(input, raw.String())
+		if !ok || len(rest) < 2 || rest[0] != '<' || !(rest[1] == '/' || rest[1] == '!' || rest[1] == '?' || 'a' <= rest[1]|0x20 && rest[1]|0x20 <= 'z') {
+			fail(ht, "Raw does not cover the input (%s)\ninput: %q\nraw:   %q", what, input, raw.String())
+		}
+		count("unfinished tag at the end dropped")
+	}
+	return out
+}
+
+// TestHegelTokenizerRawCoversTheInput: the raw texts of the tokens
+// partition the input, and the token stream is the same whether the input
+// comes at once or in pieces.
+func TestHegelTokenizerRawCoversTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		input := document(ht)
+		whole := tokens(ht, input, strings.NewReader(input), "whole")
+		pieces := chunks(ht, input)
+		piecewise := tokens(ht, input, &chunkReader{pieces: pieces}, "chunked")
+		if fmt.Sprint(whole) != fmt.Sprint(piecewise) {
+			fail(ht, "chunked tokens differ\ninput: %q\nchunks: %q\n--- whole\n%v\n--- chunked\n%v", input, pieces, whole, piecewise)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Escaping.
+
+var refNames = []string{"amp", "lt", "gt", "quot", "apos", "nbsp", "not", "notit", "notin", "AMP", "Amp", "copy", "COPY", "cent", "pound", "lang", "rang",
+	"CounterClockwiseContourIntegral", "ThisIsNotAnEntity", "am", "a", "Aacute", "aacute", "x", "frac12", "NewLine", "Tab", "zwj", "bne", "fjlig", "ngE", "nvlt"}
+
+// refText is text rich in character references, well and badly formed.
+func refText(tc hegel.TestCase) string {
+	var s string
+	k := n(tc, 1, 4)
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 5) {
+		case 0:
+			s += pickFrom(tc, words)
+		case 1:
+			s += "&" + pickFrom(tc, refNames)
+			if chance(tc, 60) {
+				s += ";"
+			} else if chance(tc, 50) {
+				s += pick(tc, "=", "x", "1", " ", "&", "-")
+			}
+		case 2:
+			s += "&#" + pick(tc, "0", "9", "10", "13", "38", "60", "65", "128", "129", "150", "159", "160", "173", "8232", "55296", "57343", "65534", "65535", "1114111", "1114112", "99999999999", "0065", "x", "")
+			if chance(tc, 70) {
+				s += ";"
+			}
+		case 3:
+			s += "&#" + pick(tc, "x", "X") + pick(tc, "0", "9", "A", "41", "7F", "80", "9F", "D800", "DFFF", "FDD0", "FFFE", "FFFF", "10FFFF", "110000", "FFFFFFFFF", "0041", "g", "")
+			if chance(tc, 70) {
+				s += ";"
+			}
+		default:
+			s += pick(tc, "a", " ", "<", ">", "\"", "'", "\r", "\n", "\x00", "é", "\U0001F600", "&", ";", "#")
+		}
+	}
+	return s
+}
+
+// TestHegelUnescapeAgreesWithEntities: UnescapeString decodes character
+// references like the entities package (text mode), python's html.unescape
+// deciding when the two differ; and UnescapeString(EscapeString(s)) == s.
+func TestHegelUnescapeAgreesWithEntities(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := refText(ht)
+		if back := html.UnescapeString(html.EscapeString(s)); back != s {
+			fail(ht, "UnescapeString(EscapeString(s)) != s\ns:    %q\nesc:  %q\nback: %q", s, html.EscapeString(s), back)
+		}
+		got := html.UnescapeString(s)
+		m, err := parse5Oracle().call(map[string]any{"unescape": s})
+		if err != nil {
+			curT.Fatalf("parse5 oracle: %v", err)
+		}
+		want, _ := m["text"].(string)
+		if got == want {
+			return
+		}
+		pm, err := html5libOracle().call(map[string]any{"unescape": s})
+		if err != nil {
+			curT.Fatalf("html5lib oracle: %v", err)
+		}
+		py, _ := pm["text"].(string)
+		if py == got {
+			count("agrees with python, not entities")
+			return
+		}
+		if py != want {
+			count("three different unescapes")
+			return
+		}
+		if id := Known.explainsUnescape(s, got, want); id != "" {
+			count("known " + id)
+			return
+		}
+		fail(ht, "UnescapeString differs from entities and python\ns:    %q\ngot:  %q\nwant: %q", s, got, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Rendering.
+
+// TestHegelRenderedTreesReparseAlike: Render of a parsed document, parsed
+// again, gives the same tree, when the tree is well formed in the sense of
+// Render's documentation (wellFormed gates the shapes it excludes).
+func TestHegelRenderedTreesReparseAlike(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := treeReq{html: document(ht), scripting: chance(ht, 80)}
+		doc, err := parseTree(r, strings.NewReader(r.html))
+		if err != nil {
+			fail(ht, "parse error: %v\ninput: %q", err, r.html)
+		}
+		if why := notWellFormed(doc); why != "" {
+			count("not well formed: " + why)
+			return
+		}
+		got, err := dump(doc)
+		if err != nil {
+			fail(ht, "dump: %v", err)
+		}
+		var buf bytes.Buffer
+		if err := html.Render(&buf, doc); err != nil {
+			if id := Known.explainsRenderError(doc, err); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "Render: %v\ninput: %q", err, r.html)
+		}
+		doc1, err := parseTree(r, bytes.NewReader(buf.Bytes()))
+		if err != nil {
+			fail(ht, "parse of the rendering: %v\ninput: %q\nrendered: %q", err, r.html, buf.String())
+		}
+		got1, err := dump(doc1)
+		if err != nil {
+			fail(ht, "dump: %v", err)
+		}
+		if got != got1 {
+			if id := Known.explainsRoundTrip(r.html, buf.String(), got, got1); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "rendered document parses differently\ninput: %q\nrendered: %q\n--- parsed\n%s--- re-parsed\n%s", r.html, buf.String(), got, got1)
+		}
+	})
+}
diff --git a/html/hegel/hegel_test.go b/html/hegel/hegel_test.go
new file mode 100644
index 0000000..28cda54
--- /dev/null
+++ b/html/hegel/hegel_test.go
@@ -0,0 +1,504 @@
+package hegel
+
+// Hegel property tests for golang.org/x/net/html: generated HTML is parsed by
+// x/net/html and by two other implementations of the HTML parsing algorithm
+// (parse5 under node, html5lib under python, both child processes speaking
+// JSON lines) and the trees, printed in the html5lib-tests .dat format, must
+// agree; the tokenizer, the renderer and the escaping functions are checked
+// against x/net/html's own promises.
+//
+// Neither oracle is the specification: html5lib 1.1 (2020) predates the
+// current template, search, ruby and adoption-agency rules; parse5 8 does
+// not have the 2025 select parser change. So the parse properties take a
+// vote: x/net/html agreeing with either oracle is accepted, x/net/html alone
+// against two agreeing oracles is a mismatch.
+//
+// Needs node with parse5 installed under this directory (the target's setup
+// runs `npm install --prefix html/hegel parse5@8.0.1`) and python3 with
+// html5lib 1.1 on PATH.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"golang.org/x/net/html"
+	"golang.org/x/net/html/atom"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 300 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed (an oracle
+// disagreement, a known bug, a shape the property has no opinion on).
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func pickFrom[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// The oracles: child processes speaking one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+var (
+	parse5Once sync.Once
+	parse5     *oracle
+	libOnce    sync.Once
+	lib        *oracle
+)
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one request and returns the answer object, or an error when
+// the oracle is unusable (which is a harness failure, not a finding).
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %q: %v", o.name, resp, err)
+	}
+	return m, nil
+}
+
+func parse5Oracle() *oracle {
+	parse5Once.Do(func() { parse5 = startOracle("parse5", "node", "parse5-oracle.cjs") })
+	return parse5
+}
+
+func html5libOracle() *oracle {
+	libOnce.Do(func() { lib = startOracle("html5lib", "python3", "-u", "html5lib-oracle.py") })
+	return lib
+}
+
+// treeReq is a parse request: html, an optional fragment context ("div",
+// "svg path") and the scripting flag.
+type treeReq struct {
+	html      string
+	fragment  string
+	scripting bool
+}
+
+func (r treeReq) json() map[string]any {
+	m := map[string]any{"html": r.html, "scripting": r.scripting}
+	if r.fragment != "" {
+		m["fragment"] = r.fragment
+	} else {
+		m["fragment"] = nil
+	}
+	return m
+}
+
+// opinion is an oracle's tree, or "" with ok false when it has none.
+func opinion(t testing.TB, o *oracle, r treeReq) (tree string, ok bool) {
+	m, err := o.call(r.json())
+	if err != nil {
+		t.Fatalf("%s oracle: %v", o.name, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		if o.name == "parse5" {
+			t.Fatalf("parse5 oracle failed on %q: %v", r.html, e)
+		}
+		return "", false
+	}
+	s, _ := m["tree"].(string)
+	return s, true
+}
+
+// ---------------------------------------------------------------------------
+// The .dat format, as x/net/html's own test dump prints it.
+
+func dumpIndent(w *strings.Builder, level int) {
+	w.WriteString("| ")
+	for i := 0; i < level; i++ {
+		w.WriteString("  ")
+	}
+}
+
+func dumpLevel(w *strings.Builder, nd *html.Node, level int) error {
+	dumpIndent(w, level)
+	level++
+	switch nd.Type {
+	case html.ErrorNode:
+		return fmt.Errorf("unexpected ErrorNode")
+	case html.DocumentNode:
+		return fmt.Errorf("unexpected DocumentNode")
+	case html.ElementNode:
+		if nd.Namespace != "" {
+			fmt.Fprintf(w, "<%s %s>", nd.Namespace, nd.Data)
+		} else {
+			fmt.Fprintf(w, "<%s>", nd.Data)
+		}
+		attr := make([]html.Attribute, len(nd.Attr))
+		copy(attr, nd.Attr)
+		// sorted as the .dat suite and the oracles print them: the namespace
+		// prefix (xlink, xml, xmlns) is part of the sorted name
+		full := func(a html.Attribute) string {
+			if a.Namespace != "" {
+				return a.Namespace + " " + a.Key
+			}
+			return a.Key
+		}
+		sort.SliceStable(attr, func(i, j int) bool { return full(attr[i]) < full(attr[j]) })
+		for _, a := range attr {
+			w.WriteString("\n")
+			dumpIndent(w, level)
+			if a.Namespace != "" {
+				fmt.Fprintf(w, `%s %s="%s"`, a.Namespace, a.Key, a.Val)
+			} else {
+				fmt.Fprintf(w, `%s="%s"`, a.Key, a.Val)
+			}
+		}
+		if nd.Namespace == "" && nd.DataAtom == atom.Template {
+			w.WriteString("\n")
+			dumpIndent(w, level)
+			level++
+			w.WriteString("content")
+		}
+	case html.TextNode:
+		fmt.Fprintf(w, `"%s"`, nd.Data)
+	case html.CommentNode:
+		fmt.Fprintf(w, "<!-- %s -->", nd.Data)
+	case html.DoctypeNode:
+		fmt.Fprintf(w, "<!DOCTYPE %s", nd.Data)
+		if nd.Attr != nil {
+			var p, s string
+			for _, a := range nd.Attr {
+				switch a.Key {
+				case "public":
+					p = a.Val
+				case "system":
+					s = a.Val
+				}
+			}
+			if p != "" || s != "" {
+				fmt.Fprintf(w, ` "%s"`, p)
+				fmt.Fprintf(w, ` "%s"`, s)
+			}
+		}
+		w.WriteString(">")
+	default:
+		return fmt.Errorf("unknown node type %v", nd.Type)
+	}
+	w.WriteString("\n")
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := dumpLevel(w, c, level); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// dump prints the children of a document (or a synthetic fragment root).
+func dump(nd *html.Node) (string, error) {
+	if nd == nil || nd.FirstChild == nil {
+		return "", nil
+	}
+	var b strings.Builder
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := dumpLevel(&b, c, 0); err != nil {
+			return "", err
+		}
+	}
+	return b.String(), nil
+}
+
+// ---------------------------------------------------------------------------
+// Tree consistency (x/net/html's own check, from node_test.go).
+
+func checkTree(nd *html.Node) error { return checkTree1(nd, 0) }
+
+func checkTree1(nd *html.Node, depth int) error {
+	if depth == 1e4 {
+		return fmt.Errorf("tree looks like it contains a cycle")
+	}
+	if err := checkNode(nd); err != nil {
+		return err
+	}
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		if err := checkTree1(c, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func checkNode(nd *html.Node) error {
+	if nd == nil {
+		return nil
+	}
+	nParent := 0
+	for p := nd.Parent; p != nil; p = p.Parent {
+		nParent++
+		if nParent == 1e4 {
+			return fmt.Errorf("parent list looks like an infinite loop")
+		}
+	}
+	nForward := 0
+	for c := nd.FirstChild; c != nil; c = c.NextSibling {
+		nForward++
+		if nForward == 1e6 {
+			return fmt.Errorf("forward list of children looks like an infinite loop")
+		}
+		if c.Parent != nd {
+			return fmt.Errorf("inconsistent child/parent relationship")
+		}
+	}
+	nBackward := 0
+	for c := nd.LastChild; c != nil; c = c.PrevSibling {
+		nBackward++
+		if nBackward == 1e6 {
+			return fmt.Errorf("backward list of children looks like an infinite loop")
+		}
+		if c.Parent != nd {
+			return fmt.Errorf("inconsistent child/parent relationship")
+		}
+	}
+	if nd.Parent != nil {
+		if nd.Parent == nd || nd.Parent == nd.FirstChild || nd.Parent == nd.LastChild || nd.Parent == nd.PrevSibling || nd.Parent == nd.NextSibling {
+			return fmt.Errorf("inconsistent parent relationship")
+		}
+		if nd.Parent.FirstChild != nd && nd.PrevSibling == nil {
+			return fmt.Errorf("node without a previous sibling is not its parent's first child")
+		}
+		if nd.Parent.LastChild != nd && nd.NextSibling == nil {
+			return fmt.Errorf("node without a next sibling is not its parent's last child")
+		}
+	}
+	if nd.PrevSibling != nil && nd.PrevSibling.NextSibling != nd {
+		return fmt.Errorf("inconsistent prev/next sibling relationship")
+	}
+	if nd.NextSibling != nil && nd.NextSibling.PrevSibling != nd {
+		return fmt.Errorf("inconsistent next/prev sibling relationship")
+	}
+	if (nd.FirstChild == nil) != (nd.LastChild == nil) {
+		return fmt.Errorf("inconsistent first/last child relationship")
+	}
+	if nd.FirstChild != nil && nd.FirstChild == nd.LastChild && nd.FirstChild.NextSibling != nil {
+		return fmt.Errorf("only child has a sibling")
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Parsing with x/net/html, in the shape the .dat format compares.
+
+func parseTree(r treeReq, src io.Reader) (*html.Node, error) {
+	opts := []html.ParseOption{html.ParseOptionEnableScripting(r.scripting)}
+	if r.fragment == "" {
+		return html.ParseWithOptions(src, opts...)
+	}
+	namespace, context := "", r.fragment
+	if i := strings.IndexByte(context, ' '); i >= 0 {
+		namespace, context = context[:i], context[i+1:]
+	}
+	ctx := &html.Node{Data: context, DataAtom: atom.Lookup([]byte(context)), Namespace: namespace, Type: html.ElementNode}
+	nodes, err := html.ParseFragmentWithOptions(src, ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	doc := &html.Node{Type: html.DocumentNode}
+	for _, nd := range nodes {
+		doc.AppendChild(nd)
+	}
+	return doc, nil
+}
+
+// vote compares x/net/html's tree with the oracles': agreement with parse5
+// or with html5lib passes; x/net/html alone against two agreeing oracles
+// fails (unless a known bug explains it); everything else is counted.
+func vote(ht *hegel.T, r treeReq, got string) {
+	p5, _ := opinion(curT, parse5Oracle(), r)
+	if got == p5 {
+		return
+	}
+	lb, hasLib := opinion(curT, html5libOracle(), r)
+	if hasLib && got == lb {
+		count("agrees with html5lib, not parse5")
+		return
+	}
+	if !hasLib {
+		count("differs from parse5, html5lib has no opinion")
+		return
+	}
+	if lb != p5 {
+		count("three different trees")
+		return
+	}
+	if id := Known.explainsTree(r, got, p5); id != "" {
+		if strings.HasPrefix(id, "!") {
+			count("not judged: " + id[1:])
+		} else {
+			count("known " + id)
+		}
+		return
+	}
+	fail(ht, "tree mismatch (context %q, scripting %v)\ninput: %q\n--- x/net/html\n%s--- parse5 = html5lib\n%s", r.fragment, r.scripting, r.html, got, p5)
+}
diff --git a/html/hegel/html5lib-oracle.py b/html/hegel/html5lib-oracle.py
new file mode 100644
index 0000000..60021d2
--- /dev/null
+++ b/html/hegel/html5lib-oracle.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""html5lib (Python) as an oracle for golang.org/x/net/html: one JSON request per stdin line, one
+JSON answer per line.
+
+Request: {"html": "...", "fragment": null | "div", "scripting": true}
+Answer:  {"tree": "<html5lib-tests .dat format>"} or {"error": "..."} (foreign fragment contexts and
+anything html5lib cannot parse have no opinion).
+Request: {"unescape": "..."}   Answer: {"text": html.unescape(...)}
+
+html5lib's test serializer prints "#document" first, indents one space more than the .dat files and
+prefixes HTML-namespace elements with "html ": the answer is normalised to the .dat format
+x/net/html's own test dump prints, so the trees compare as plain strings.
+"""
+
+import html
+import json
+import sys
+
+import html5lib
+from html5lib import treebuilders
+
+TREE_BUILDER = treebuilders.getTreeBuilder("dom")
+
+
+def normalise(text):
+    lines = text.split("\n")
+    if lines and lines[0] in ("#document", "#document-fragment"):
+        lines = lines[1:]
+    out = []
+    for line in lines:
+        if line.startswith("| "):
+            line = "|" + line[2:]
+        if line.lstrip("| ").startswith("<html "):
+            line = line.replace("<html ", "<", 1)
+        out.append(line)
+    text = "\n".join(out)
+    return text + "\n" if text else ""
+
+
+def answer(req):
+    if isinstance(req.get("unescape"), str):
+        return {"text": html.unescape(req["unescape"])}
+    parser = html5lib.HTMLParser(tree=TREE_BUILDER)
+    scripting = bool(req.get("scripting", True))
+    fragment = req.get("fragment")
+    if fragment:
+        if " " in fragment:
+            return {"error": "html5lib has no foreign fragment contexts"}
+        node = parser.parseFragment(req["html"], container=fragment, scripting=scripting)
+    else:
+        node = parser.parse(req["html"], scripting=scripting)
+    return {"tree": normalise(parser.tree.testSerializer(node))}
+
+
+def main():
+    for line in sys.stdin:
+        if not line.strip():
+            continue
+        try:
+            reply = answer(json.loads(line))
+        except Exception as exc:  # noqa: BLE001 - any failure is "no opinion"
+            reply = {"error": repr(exc)[:300]}
+        sys.stdout.write(json.dumps(reply) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
