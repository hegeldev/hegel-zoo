+
+// nulBesideReplacement: the input holds both a NUL and a U+FFFD, the shape
+// in which x-net/12 shows (attribute names compared before NUL replacement).
+func nulBesideReplacement(input string) bool {
+	return strings.Contains(input, "\x00") && strings.Contains(input, "�")
+}
+
+// notWellFormed names the reason a parsed tree is one Render does not promise
+// to round-trip (its documentation's own examples and x/net/html's render
+// test exclusions): an element inside an element of its own name where the
+// content model forbids that (a, nobr, form, button, table, select, ...),
+// a plaintext element, raw text that holds its own end tag or a script
+// escape, text or comments directly under html or a table structure.
+func notWellFormed(doc *html.Node) string {
+	var why string
+	var walk func(nd *html.Node, open map[string]int)
+	walk = func(nd *html.Node, open map[string]int) {
+		if why != "" {
+			return
+		}
+		for c := nd.FirstChild; c != nil; c = c.NextSibling {
+			switch c.Type {
+			case html.TextNode:
+				if nd.Type == html.ElementNode && nd.Namespace == "" {
+					switch nd.Data {
+					case "html", "table", "tbody", "thead", "tfoot", "tr", "colgroup", "select", "optgroup", "frameset", "head":
+						if strings.TrimLeft(c.Data, " \t\n\f\r") != "" {
+							why = "text under " + nd.Data
+							return
+						}
+					}
+				}
+			case html.ElementNode:
+				if c.Namespace == "" {
+					switch c.Data {
+					case "plaintext":
+						why = "plaintext"
+						return
+					case "a", "nobr", "form", "button", "table", "select", "option", "label", "li", "dd", "dt", "p", "tr", "td", "th", "caption", "colgroup", "head", "body", "html", "h1", "h2", "h3", "h4", "h5", "h6":
+						if open[c.Data] > 0 {
+							why = c.Data + " in " + c.Data
+							return
+						}
+					case "script", "style", "xmp", "iframe", "noembed", "noframes", "textarea", "title", "noscript":
+						var raw strings.Builder
+						for t := c.FirstChild; t != nil; t = t.NextSibling {
+							if t.Type == html.TextNode {
+								raw.WriteString(t.Data)
+							}
+						}
+						low := strings.ToLower(raw.String())
+						if strings.Contains(low, "</"+c.Data) {
+							why = c.Data + " holds its end tag"
+							return
+						}
+						if c.Data == "script" && strings.Contains(low, "<!--") {
+							why = "script escape"
+							return
+						}
+						if (c.Data == "textarea" || c.Data == "title") && strings.ContainsAny(raw.String(), "&<") {
+							why = c.Data + " holds & or <"
+							return
+						}
+					}
+				}
+				open[c.Data]++
+				walk(c, open)
+				open[c.Data]--
+			}
+		}
+	}
+	walk(doc, map[string]int{})
+	return why
+}
diff --git a/html/hegel/parse5-oracle.cjs b/html/hegel/parse5-oracle.cjs
new file mode 100644
index 0000000..62a8c5c
--- /dev/null
+++ b/html/hegel/parse5-oracle.cjs
@@ -0,0 +1,100 @@
+// parse5 (node) as an oracle for golang.org/x/net/html: one JSON request per stdin line, one JSON
+// answer per line.
+//
+// Request: {"html": "...", "fragment": null | "div" | "svg path", "scripting": true}
+// Answer:  {"tree": "<html5lib-tests .dat format>"} or {"error": "..."}
+// Request: {"unescape": "..."}   Answer: {"text": "..."} (the `entities` package parse5 depends on,
+// in text mode: the specification's character reference algorithm, legacy names included)
+//
+// The tree is printed in the .dat format of html5lib-tests, the format x/net/html's own test
+// dump prints: element namespaces as "svg "/"math ", attributes sorted by name and prefixed with
+// their prefix (xlink, xml, xmlns) after adjustment, template contents under "content".
+
+"use strict";
+
+const parse5 = require("parse5");
+const entities = require("entities");
+const readline = require("node:readline");
+
+const ta = parse5.defaultTreeAdapter;
+const NS_SVG = "http://www.w3.org/2000/svg";
+const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+const NS_HTML = "http://www.w3.org/1999/xhtml";
+
+function indentOf(indent) {
+  return "|".padEnd(indent + 2, " ");
+}
+
+function nsPrefix(element) {
+  const ns = ta.getNamespaceURI(element);
+  return ns === NS_SVG ? "svg " : ns === NS_MATHML ? "math " : "";
+}
+
+function nodeList(nodes, indent) {
+  let out = "";
+  for (let node of nodes) {
+    out += indentOf(indent);
+    if (ta.isCommentNode(node)) {
+      out += `<!-- ${ta.getCommentNodeContent(node)} -->\n`;
+    } else if (ta.isTextNode(node)) {
+      out += `"${ta.getTextNodeContent(node)}"\n`;
+    } else if (ta.isDocumentTypeNode(node)) {
+      const publicId = ta.getDocumentTypeNodePublicId(node);
+      const systemId = ta.getDocumentTypeNodeSystemId(node);
+      out += `<!DOCTYPE ${ta.getDocumentTypeNodeName(node) || ""}`;
+      if (publicId || systemId) out += ` "${publicId}" "${systemId}"`;
+      out += ">\n";
+    } else {
+      const tn = ta.getTagName(node);
+      out += `<${nsPrefix(node) + tn}>\n`;
+      let childIndent = indent + 2;
+      const attrs = ta.getAttrList(node).map((attr) => {
+        let s = indentOf(childIndent);
+        if (attr.prefix) s += `${attr.prefix} `;
+        return s + `${attr.name}="${attr.value}"\n`;
+      });
+      out += attrs.sort().join("");
+      if (tn === "template" && ta.getNamespaceURI(node) === NS_HTML) {
+        out += `${indentOf(childIndent)}content\n`;
+        childIndent += 2;
+        node = ta.getTemplateContent(node);
+      }
+      out += nodeList(ta.getChildNodes(node), childIndent);
+    }
+  }
+  return out;
+}
+
+function answer(req) {
+  if (typeof req.unescape === "string") {
+    return { text: entities.decodeHTML(req.unescape) };
+  }
+  const opts = { scriptingEnabled: req.scripting !== false };
+  if (req.fragment) {
+    let ns = NS_HTML;
+    let name = req.fragment;
+    const sp = name.indexOf(" ");
+    if (sp >= 0) {
+      const p = name.slice(0, sp);
+      name = name.slice(sp + 1);
+      ns = p === "svg" ? NS_SVG : p === "math" ? NS_MATHML : NS_HTML;
+    }
+    const ctx = ta.createElement(name, ns, []);
+    const frag = parse5.parseFragment(ctx, req.html, opts);
+    return { tree: nodeList(ta.getChildNodes(frag), 0) };
+  }
+  const doc = parse5.parse(req.html, opts);
+  return { tree: nodeList(ta.getChildNodes(doc), 0) };
+}
+
+const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on("line", (line) => {
+  if (!line.trim()) return;
+  let reply;
+  try {
+    reply = answer(JSON.parse(line));
+  } catch (e) {
+    reply = { error: String(e && e.stack ? e.stack : e).slice(0, 400) };
+  }
+  process.stdout.write(JSON.stringify(reply) + "\n");
+});
