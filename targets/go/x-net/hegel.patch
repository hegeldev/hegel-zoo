diff --git a/idna/hegel/hegel_gauge_test.go b/idna/hegel/hegel_gauge_test.go
new file mode 100644
index 0000000..0cb9334
--- /dev/null
+++ b/idna/hegel/hegel_gauge_test.go
@@ -0,0 +1,136 @@
+package hegel
+
+// The gauge: the properties' comparisons run over the inputs of Unicode's
+// IdnaTestV2.txt (path in HEGEL_IDNA_TESTS), to see where each oracle and
+// x/net/idna part ways on the conformance suite's cases before trusting
+// the vote on generated ones. Not a property.
+
+import (
+	"bufio"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/idna"
+)
+
+// unescapeIdnaTest decodes the \uXXXX and \x{XXXX} escapes of the file.
+func unescapeIdnaTest(s string) string {
+	if !strings.Contains(s, "\\") {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		if s[i] == '\\' && i+1 < len(s) {
+			switch s[i+1] {
+			case 'u':
+				if i+6 <= len(s) {
+					if v, err := strconv.ParseUint(s[i+2:i+6], 16, 32); err == nil {
+						b.WriteRune(rune(v))
+						i += 6
+						continue
+					}
+				}
+			case 'x':
+				if i+2 < len(s) && s[i+2] == '{' {
+					if j := strings.IndexByte(s[i:], '}'); j > 0 {
+						if v, err := strconv.ParseUint(s[i+3:i+j], 16, 32); err == nil {
+							b.WriteRune(rune(v))
+							i += j + 1
+							continue
+						}
+					}
+				}
+			}
+		}
+		b.WriteByte(s[i])
+		i++
+	}
+	return b.String()
+}
+
+func TestHegelGaugeIdnaTestV2(t *testing.T) {
+	path := os.Getenv("HEGEL_IDNA_TESTS")
+	if path == "" {
+		t.Skip("set HEGEL_IDNA_TESTS to the path of IdnaTestV2.txt to gauge the oracles")
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	var total, whatwgAgree, whatwgKnown, whatwgSkipped, whatwgDiffer, regAgree, regKnown, regSkipped, regDiffer int
+	shown := map[string]int{}
+	show := func(kind, msg string) {
+		if shown[kind] < 100 {
+			t.Logf("%s: %s", kind, msg)
+		}
+		shown[kind]++
+	}
+	tally := map[string]int{}
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		fields := strings.Split(line, ";")
+		if len(fields) < 2 {
+			continue
+		}
+		s := unescapeIdnaTest(strings.TrimSpace(fields[0]))
+		total++
+		// WHATWG.
+		a, err := whatwgProfile.ToASCII(s)
+		got := goVerdict(a, err)
+		switch {
+		case urlSyntax(s), err == nil && endsInANumber(a), err == nil && forbiddenHost(a):
+			// Shapes the property does not judge.
+			whatwgSkipped++
+		default:
+			want := whatwgASCII(t, s)
+			if got.ok == want.ok && (!got.ok || got.out == want.out) {
+				whatwgAgree++
+			} else if e := Known.explainsWHATWG(s, a, err); e == "" {
+				whatwgDiffer++
+				show("WHATWG", "ToASCII of "+strconv.Quote(s)+" ("+runesOf(s)+"): x/net/idna "+got.String()+", node "+want.String())
+			} else {
+				tally["WHATWG "+e]++
+				if strings.HasPrefix(e, "!") {
+					whatwgSkipped++
+				} else {
+					whatwgKnown++
+				}
+			}
+		}
+		// Registration.
+		a, err = idna.Registration.ToASCII(s)
+		got = goVerdict(a, err)
+		want := idna2008Encode(t, s)
+		if got.ok == want.ok && (!got.ok || got.out == want.out) {
+			regAgree++
+		} else if e := Known.explainsRegistration(s, a, err, want); e == "" {
+			regDiffer++
+			show("REGISTRATION", "ToASCII of "+strconv.Quote(s)+" ("+runesOf(s)+"): x/net/idna "+got.String()+", python idna "+want.String())
+		} else {
+			tally["REGISTRATION "+e]++
+			if strings.HasPrefix(e, "!") {
+				regSkipped++
+			} else {
+				regKnown++
+			}
+		}
+	}
+	keys := make([]string, 0, len(tally))
+	for k := range tally {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		t.Logf("TALLY %s: %d", k, tally[k])
+	}
+	t.Logf("GAUGE %d cases: WHATWG agree %d, known bugs %d, not judged %d, differ %d; registration agree %d, known bugs %d, not judged %d, differ %d",
+		total, whatwgAgree, whatwgKnown, whatwgSkipped, whatwgDiffer, regAgree, regKnown, regSkipped, regDiffer)
+}
diff --git a/idna/hegel/hegel_gen_test.go b/idna/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..15cbfa5
--- /dev/null
+++ b/idna/hegel/hegel_gen_test.go
@@ -0,0 +1,195 @@
+package hegel
+
+// Generators: labels made of pieces from pools that touch every part of
+// UTS #46 and IDNA2008 (mapped, ignored, deviation and disallowed runes,
+// joiners and viramas, the contextual-rule runes, right-to-left scripts and
+// digits, combining marks, dot variants, ACE labels, hyphen positions and
+// lengths), joined into domain names.
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+var pools = [][]string{
+	// ASCII letters, digits, hyphens; upper case maps.
+	{"a", "b", "z", "q", "0", "9", "-", "A", "Z", "Q", "2"},
+	// Latin with diacritics, deviations and specials.
+	{"é", "ü", "ö", "ñ", "ß", "ẞ", "ı", "İ", "ﬁ", "Å", "å", "ǅ", "ǆ", "ſ", "ǰ", "ẛ", "ø", "ł", "þ"},
+	// Greek, with the contextual keraia and final sigma.
+	{"α", "σ", "ς", "ό", "Σ", "ΐ", "ͺ", "ϐ", "ϑ", "ό", "͵", "΄", "ᾳ", "ῼ"},
+	// Cyrillic.
+	{"д", "ж", "Ж", "ё", "ѐ", "ӑ", "ꙑ", "і", "ї", "ұ"},
+	// Hebrew, with points, geresh and gershayim.
+	{"א", "ב", "ש", "ׂ", "ּ", "׳", "״", "ﬠ", "ﬡ", "ְ"},
+	// Arabic, with both digit sets, tatweel and presentation forms.
+	{"م", "ث", "ا", "ل", "ة", "ي", "ء", "٠", "١", "٩", "۰", "۹", "ـ", "ﻻ", "ٰ", "ﭐ", "؀"},
+	// Indic scripts with viramas, and the joiners they license.
+	{"क", "ख", "्", "ि", "ं", "ॐ", "ক", "্", "ৰ", "க", "்", "‌", "‍", "ಕ", "್", "ഡ"},
+	// Han, kana, hangul, the katakana middle dot, compatibility forms.
+	{"中", "文", "字", "あ", "い", "ア", "ー", "・", "ゝ", "ヽ", "한", "글", "ᄀ", "ᅡ", "ᆨ", "ﾊ", "ﾞ", "㍿", "㋀", "々", "〆", "ㄱ"},
+	// Thai, Myanmar, Khmer, Tibetan.
+	{"ก", "ข", "ำ", "่", "က", "္", "ក", "្", "ཀ", "ྐ"},
+	// Symbols and emoji, mapped compatibility characters.
+	{"😀", "❤", "♥", "☃", "✈", "🏳", "‼", "⁉", "™", "©", "®", "№", "℃", "Ⅷ", "ⅷ", "⒈", "㎏", "½", "²", "𝔞", "𝐀", "ℌ", "ℕ", "K", "Ω", "µ", "ǰ"},
+	// Ignored and format runes: soft hyphen, variation selectors, zero width
+	// space and word joiner, BOM, combining grapheme joiner, Mongolian free
+	// variation selector and vowel separator, Khmer inherent vowel, NNBSP.
+	{"\u00ad", "\ufe0f", "\ufe00", "\u200b", "\u2060", "\ufeff", "\u034f", "\u180b", "\u17b4", "\u180e", "\u202f"},
+	// Disallowed runes, STD3 ASCII, controls, unassigned, private use.
+	{" ", "_", "~", "!", "$", "&", "'", "(", ")", "*", "+", ",", ";", "=", "@", ":", "/", "?", "#", "[", "]", "\\", "^", "|", "<", ">", "\"", "`", "{", "}",
+		"\u0000", "\u0001", "\u001f", "\u007f", "\u0080", "\u00a0", "\u2028", "\u3000", "\uffff", "\ufffd", "\ue000", "\U000e0001", "\U0010ffff", "\u0378", "\u0341", "\u0640", "\u0085", "\u200e", "\u2029"},
+	// Combining marks (disallowed at the start of a label).
+	{"̀", "́", "̈", "⃝", "༾", "༿", "ः", "ि", "ְ", "ً"},
+	// Full and half width forms, which map to ASCII (some to forbidden host code points).
+	{"Ａ", "ｚ", "１", "９", "－", "＿", "＠", "＃", "％", "／", "：", "？", "［", "］", "～", "｜", "ｘ", "ｎ"},
+}
+
+// contextO holds the runes IDNA2008 allows only in context (RFC 5892
+// appendix A, rules with names ending in O).
+var contextO = []string{"·", "͵", "׳", "״", "・", "٠", "١", "٩", "۰", "۹"}
+
+var separators = []string{".", "。", "．", "｡"}
+
+// youngRune picks a rune assigned in Unicode 16, 17 or 18.
+func youngRune(tc hegel.TestCase) string {
+	r := pickFrom(tc, youngRunes)
+	return string(rune(n(tc, int(r.lo), int(r.hi))))
+}
+
+// anyRune picks a rune from the whole space, surrogates excepted.
+func anyRune(tc hegel.TestCase) string {
+	for {
+		r := rune(n(tc, 0, 0x10FFFF))
+		if utf8.ValidRune(r) {
+			return string(r)
+		}
+	}
+}
+
+func asciiWord(tc hegel.TestCase, lo, hi int) string {
+	const alphabet = "abcdefghijklmnopqrstuvwxyz0123456789-"
+	var b strings.Builder
+	for i, k := 0, n(tc, lo, hi); i < k; i++ {
+		b.WriteByte(alphabet[n(tc, 0, len(alphabet)-1)])
+	}
+	return b.String()
+}
+
+// tame pools: letters that are valid everywhere, so that a good share of
+// the names go through every step of the round trips.
+var tamePools = [][]string{
+	{"a", "b", "z", "q", "0", "9", "-", "x", "n"},
+	{"é", "ü", "ö", "ñ", "ß", "ø", "ł", "þ", "å"},
+	{"α", "σ", "ς", "ό", "ω"},
+	{"д", "ж", "ё", "і", "ї"},
+	{"א", "ב", "ש"},
+	{"م", "ث", "ا", "ل", "ة", "ي"},
+	{"क", "ख", "ि", "ं", "ক"},
+	{"中", "文", "字", "あ", "い", "ア", "ー", "한", "글"},
+	{"ก", "ข", "ำ"},
+	{"😀", "❤", "♥", "☃"},
+}
+
+// piece is one element of a label.
+func piece(tc hegel.TestCase) string {
+	if tame {
+		return pickFrom(tc, tamePool)
+	}
+	switch n(tc, 1, 100) {
+	case 1, 2, 3:
+		return youngRune(tc)
+	case 4, 5, 6:
+		return anyRune(tc)
+	case 7, 8:
+		return pickFrom(tc, contextO)
+	case 9, 10, 11, 12:
+		return asciiWord(tc, 1, 6)
+	}
+	return pickFrom(tc, pickFrom(tc, pools))
+}
+
+// label is one label of a domain name.
+func label(tc hegel.TestCase) string {
+	if tame {
+		// One script per label, so that the Bidi rule holds.
+		tamePool = pickFrom(tc, tamePools)
+		var b strings.Builder
+		for i, k := 0, n(tc, 1, 6); i < k; i++ {
+			b.WriteString(piece(tc))
+		}
+		return b.String()
+	}
+	switch n(tc, 1, 100) {
+	case 1, 2, 3, 4, 5:
+		// A raw ACE label: what a punycode decoder gets fed.
+		return "xn--" + asciiWord(tc, 0, 8)
+	case 6, 7, 8:
+		// An ACE label that decodes to a generated label.
+		inner := label(tc)
+		if a, err := punycodeProfile.ToASCII(inner); err == nil && !strings.Contains(a, ".") {
+			return a
+		}
+		return inner
+	case 9, 10:
+		// Numeric and hexadecimal labels (the URL standard's IPv4 shapes).
+		return pick(tc, "123", "0x1f", "0", "255", "09", "1e3", "0X", "12ab")
+	case 11, 12:
+		// Hyphen positions: the edges, and 3-4 (the ACE prefix's).
+		return pick(tc, "-a", "a-", "ab--cd", "a--b", "--", "-", "xn-a", "XN--a", "Xn--a", "xn--")
+	case 13:
+		// Length limits.
+		k := pick(tc, 62, 63, 64, 70)
+		return strings.Repeat(pick(tc, "a", "é", "中"), k)
+	case 14:
+		return ""
+	case 15:
+		// Upper case ACE.
+		if a, err := punycodeProfile.ToASCII(label(tc)); err == nil && !strings.Contains(a, ".") {
+			return strings.ToUpper(a)
+		}
+	}
+	var b strings.Builder
+	for i, k := 0, n(tc, 1, 6); i < k; i++ {
+		b.WriteString(piece(tc))
+	}
+	return b.String()
+}
+
+// tame is set by domain for the share of names drawn from the tame pools;
+// tamePool is the label's pool then.
+var (
+	tame     bool
+	tamePool []string
+)
+
+// domain is a domain name: labels joined by dots (or the runes that map
+// to dots when unicodeDots is set), sometimes with a leading or trailing dot.
+func domain(tc hegel.TestCase, unicodeDots bool) string {
+	tame = chance(tc, 40)
+	defer func() { tame = false }()
+	var b strings.Builder
+	if chance(tc, 5) {
+		b.WriteString(".")
+	}
+	for i, k := 0, n(tc, 1, 5); i < k; i++ {
+		if i > 0 {
+			if unicodeDots && chance(tc, 15) {
+				b.WriteString(pickFrom(tc, separators))
+			} else {
+				b.WriteString(".")
+			}
+		}
+		b.WriteString(label(tc))
+	}
+	if chance(tc, 10) {
+		b.WriteString(".")
+	}
+	if chance(tc, 2) {
+		// Over the 253-octet name limit.
+		b.WriteString("." + strings.Repeat("a.", 120) + "b")
+	}
+	return b.String()
+}
