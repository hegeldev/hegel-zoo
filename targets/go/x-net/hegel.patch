+
+// crashesFragment (x-net/4): content after </html> in a foreign fragment
+// context dereferences a nil pointer.
+func (known) crashesFragment(r treeReq) bool {
+	return strings.Contains(r.fragment, " ") && strings.Contains(strings.ToLower(r.html), "</html")
+}
+
+// explainsUnescape: UnescapeString(s) = got against the agreed want.
+func (known) explainsUnescape(s, got, want string) string {
+	return ""
+}
+
+// explainsRoundTrip: a rendered document that parsed differently.
+func (known) explainsRoundTrip(input, rendered, got, got1 string) string {
+	// A carriage return can only reach comment data through a decoded
+	// &#13; (x-net/1); rendered raw, it comes back as a newline.
+	if strings.Contains(got, "\r") {
+		return "x-net/1"
+	}
+	// x-net/9: the text of a raw text element under a MathML text
+	// integration point (mi, mo, mn, ms, mtext) is rendered escaped.
+	if strings.Contains(strings.ToLower(input), "<math") && rawTextTag.MatchString(strings.ToLower(input)) {
+		return "x-net/9"
+	}
+	// x-net/12: two attributes named U+FFFD (one from a NUL) survive the
+	// parse; the rendering loses the second.
+	if nulBesideReplacement(input) {
+		return "x-net/12"
+	}
+	return ""
