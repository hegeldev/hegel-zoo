+	htmlEnds       = pick("</html>", "</HTML>", "</html >")
+	afterHtmlCases = shaped(
+		afterHtmlWith(foreignCtxs, htmlEnds),
+		weighted(
+			choice[afterHtml]{1, afterHtmlWith(foreignCtxs, hegel.Just("</body>"))},
+			choice[afterHtml]{1, afterHtmlWith(htmlCtxs, htmlEnds)},
+		),
+	)
+)
