+package hegel
+
+// Random HTML with the shapes the HTML parsing algorithm has rules for
+// (misnested formatting, tables, selects, templates, foreign content, raw
+// text, comments, doctypes, character references, NULs, line ends),
+// sometimes structured, sometimes mutated, always bounded and always valid
+// UTF-8 (mutations work on runes) so it travels to the oracles as JSON.
+
+import (
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	voidTags       = []string{"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"}
+	rawTextTags    = []string{"script", "style", "xmp", "iframe", "noembed", "noframes"}
+	rcdataTags     = []string{"textarea", "title"}
+	formattingTags = []string{"a", "b", "big", "code", "em", "font", "i", "nobr", "s", "small", "strike", "strong", "tt", "u"}
+	blockTags      = []string{
+		"address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl", "fieldset",
+		"figcaption", "figure", "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p", "search", "section",
+		"summary", "ul", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "listing", "form", "li", "dd", "dt", "button",
+		"applet", "marquee", "object", "span", "label",
+	}
+	tableTags  = []string{"table", "caption", "colgroup", "col", "thead", "tbody", "tfoot", "tr", "td", "th"}
+	selectTags = []string{"select", "option", "optgroup", "datalist"}
+	structTags = []string{
+		"html", "head", "body", "frameset", "frame", "noscript", "template", "image", "ruby", "rb", "rt", "rtc", "rp",
+		"keygen", "menuitem", "param", "sarcasm", "foo", "x-bar", "plaintext", "isindex", "command", "base", "basefont",
+		"bgsound", "meta", "link", "title", "style", "script",
+	}
+	foreignTags = []string{
+		"svg", "math", "mi", "mo", "mn", "ms", "mtext", "annotation-xml", "foreignObject", "desc", "g", "path", "title",
+		"malignmark", "mglyph", "altGlyph", "feBlend", "textPath", "clipPath", "linearGradient",
+	}
+	// The HTML-namespace tags a fragment may be parsed in the context of.
+	contexts        = contextTags()
+	foreignContexts = []string{"svg path", "svg svg", "svg desc", "svg foreignObject", "svg title", "math mi", "math math", "math annotation-xml", "math mtext"}
+
+	attrNames = []string{
+		"id", "class", "href", "src", "type", "name", "value", "style", "title", "lang", "dir", "hidden", "data-x", "onclick",
+		"xlink:href", "xlink:title", "xml:lang", "xml:space", "xmlns", "xmlns:xlink", "xmlns:foo", "definitionurl", "definitionURL",
+		"encoding", "viewbox", "viewBox", "attributeName", "ATTRIBUTENAME", "zoomAndPan", "foo", "a", "x:y", "action", "prompt",
+		"FOO", "Data-Y", "id", "class",
+	}
+	attrValues = []string{
+		"", "x", "1", "hidden", "text/html", "application/xhtml+xml", "text/plain", "foo bar", "&amp;", "&lt;x", "&notit;", "&not",
+		"&#65;", "&#x41;", "&AMP", "a&b", "&", "&;", ">", "<", "/", "=", "'", "\"", "é", "\x00", "\n", "\t", "  ", "\U0001F600",
+		"-//W3C//DTD HTML 4.01//EN", "http://www.w3.org/2000/svg", "http://www.w3.org/1998/Math/MathML", "http://www.w3.org/1999/xhtml",
+	}
+	words = []string{
+		"foo", "bar", "x", "Hello", "a b", "text", "1", "\n", "  ", "\t", "\f", "\r\n", "\r", "\x00", "é", "\U0001F600", " ",
+		"&amp;", "&lt;", "&gt;", "&quot;", "&nbsp;", "&notit;", "&not", "&AMP", "&AMP;", "&#65;", "&#x41;", "&#0;", "&#x80;", "&#xD800;",
+		"&#x10FFFF;", "&#x110000;", "&#xD;", "&#13;", "&#x9;", "&foo;", "&", "&#", "&#x", "&#xZ", "<", "</", "</ ", "<3", "< a", ">",
+		"<!", "<!->", "<?x>", "]]>", "--", "-->", "<![CDATA[x]]>", "<![CDATA[", "�", "\v", "​", "\x01", "\x7f", "",
+		"&#x2028;", "&#xfdd0;", "&#xfffe;", "&#x1fffe;", "&CounterClockwiseContourIntegral;", "&ThisIsNotAnEntity;", "&am", "&ampx",
+		"x&ampx", "&#128;", "&#160;", "&#x9F;", "&#x00000041;", "&#0000000000065;", "&lt", "&ltx", "&Aacute", "&Aacutex", "&cent",
+	}
+	commentBodies = []string{"", "x", " x ", "-", "--", "--!", ">", "->", "-->", "<!--", "--x", "x--", "-x-", "<!", "a\nb", "\x00", "--!>", "<!-- --"}
+	doctypes      = []string{
+		"<!DOCTYPE html>", "<!doctype html>", "<!DOCTYPE HTML>", "<!DOCTYPE>", "<!DOCTYPE html SYSTEM \"about:legacy-compat\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Frameset//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd\">",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\">", "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">",
+		"<!DOCTYPE html SYSTEM 'http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd'>", "<!DOCTYPE html PUBLIC>",
+		"<!DOCTYPE html PUBLIC \"x\">", "<!DOCTYPE html SYSTEM>", "<!DOCTYPE html SYSTEM \"x\" \"y\">", "<!DOCTYPE potato>",
+		"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\">", "<!DOCTYPE html PUBLIC \"-/W3C/DTD HTML 4.0 Transitional/EN\">",
+		"<!DOCTYPE html PUBLIC \"HTML\">", "<!DOCTYPE html PUBLIC \"-//WebTechs//DTD Mozilla HTML 2.0//EN\">", "<!DOCTYPE html\x00>",
+		"<!DOCTYPE html \"x\">", "<!DOCTYPE html PUBLIC\"x\"\"y\">", "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 3.2 Final//EN\">",
+	}
+	mutationChars = []string{"<", ">", "/", "&", ";", "\"", "'", "=", " ", "-", "!", "\n", "\r", "\x00", "?", "[", "]", "a", "p", "t"}
+)
+
+func contextTags() []string {
+	seen := map[string]bool{"image": true, "sarcasm": true, "x-bar": true, "foo": true, "isindex": true, "command": true}
+	var out []string
+	for _, group := range [][]string{voidTags, rawTextTags, rcdataTags, formattingTags, blockTags, tableTags, selectTags, structTags} {
+		for _, t := range group {
+			if !seen[t] {
+				seen[t] = true
+				out = append(out, t)
+			}
+		}
+	}
+	return out
+}
+
+func isVoid(name string) bool {
+	for _, v := range voidTags {
+		if v == name {
+			return true
+		}
+	}
+	return false
+}
+
+func isRawOrRCData(name string) bool {
+	for _, v := range rawTextTags {
+		if v == name {
+			return true
+		}
+	}
+	for _, v := range rcdataTags {
+		if v == name {
+			return true
+		}
+	}
+	return false
+}
+
+func tagName(tc hegel.TestCase) string {
+	r := n(tc, 0, 99)
+	switch {
+	case r < 14:
+		return pickFrom(tc, formattingTags)
+	case r < 40:
+		return pickFrom(tc, blockTags)
+	case r < 52:
+		return pickFrom(tc, tableTags)
+	case r < 58:
+		return pickFrom(tc, selectTags)
+	case r < 65:
+		return pickFrom(tc, voidTags)
+	case r < 72:
+		if chance(tc, 70) {
+			return pickFrom(tc, rawTextTags)
+		}
+		return pickFrom(tc, rcdataTags)
+	case r < 86:
+		return pickFrom(tc, structTags)
+	}
+	return pickFrom(tc, foreignTags)
+}
+
+func caseOf(tc hegel.TestCase, name string) string {
+	switch n(tc, 0, 19) {
+	case 0:
+		return strings.ToUpper(name)
+	case 1:
+		return strings.ToUpper(name[:1]) + name[1:]
+	}
+	return name
+}
+
+func attr(tc hegel.TestCase) string {
+	name := caseOf(tc, pickFrom(tc, attrNames))
+	switch n(tc, 0, 9) {
+	case 0:
+		return name
+	case 1:
+		return name + "=" + pick(tc, "x", "1", "a/b", "&amp;", "x>", "&", "foo&bar")
+	case 2:
+		return name + "='" + strings.ReplaceAll(pickFrom(tc, attrValues), "'", "") + "'"
+	case 3:
+		return name + ` = "` + strings.ReplaceAll(pickFrom(tc, attrValues), `"`, "") + `"`
+	}
+	return name + `="` + strings.ReplaceAll(pickFrom(tc, attrValues), `"`, "") + `"`
+}
+
+func startTag(tc hegel.TestCase, name string) string {
+	s := "<" + caseOf(tc, name)
+	k := 0
+	if !chance(tc, 60) {
+		k = n(tc, 1, 3)
+	}
+	for i := 0; i < k; i++ {
+		s += pick(tc, " ", " ", " ", "\n", "\t", "/", "  ") + attr(tc)
+	}
+	r := n(tc, 0, 29)
+	switch r {
+	case 0:
+		s += "/"
+	case 1:
+		s += " /"
+	case 2:
+		s += " "
+	case 3:
+		s += "<"
+	}
+	if r == 4 {
+		return s
+	}
+	return s + ">"
+}
+
+func endTag(tc hegel.TestCase, name string) string {
+	switch n(tc, 0, 19) {
+	case 0:
+		return "</" + caseOf(tc, name) + ` x="y">`
+	case 1:
+		return "</" + caseOf(tc, name) + "/>"
+	case 2:
+		return "</" + caseOf(tc, name) + " "
+	case 3:
+		return "</" + caseOf(tc, name)
+	}
+	return "</" + caseOf(tc, name) + ">"
+}
+
+func text(tc hegel.TestCase) string {
+	var s string
+	k := n(tc, 1, 3)
+	for i := 0; i < k; i++ {
+		s += pickFrom(tc, words)
+	}
+	return s
+}
+
+func comment(tc hegel.TestCase) string {
+	body := pickFrom(tc, commentBodies)
+	switch n(tc, 0, 9) {
+	case 0:
+		return "<!--" + body
+	case 1:
+		return "<!--" + body + "--!>"
+	case 2:
+		return pick(tc, "<!-->", "<!--->", "<!x>", "<?x>", "<?", "<!", "</>", "</3>", "<! >", "<!--->x", "<!-", "<!-x", "<!doctyp>", "<![CDATA[x]]>", "<![CDATA[x", "<!DOCTYPE")
+	}
+	return "<!--" + body + "-->"
+}
+
+func doctype(tc hegel.TestCase) string { return pickFrom(tc, doctypes) }
+
+// soupToken is one token of soup, open being the tags started so far
+// (closed randomly, mostly in order).
+func soupToken(tc hegel.TestCase, open *[]string) string {
+	r := n(tc, 0, 99)
+	switch {
+	case r < 38:
+		name := tagName(tc)
+		if !isVoid(name) {
+			*open = append(*open, name)
+		}
+		return startTag(tc, name)
+	case r < 60:
+		if len(*open) > 0 && chance(tc, 75) {
+			i := len(*open) - 1
+			if !chance(tc, 70) {
+				i = n(tc, 0, len(*open)-1)
+			}
+			name := (*open)[i]
+			*open = append((*open)[:i], (*open)[i+1:]...)
+			return endTag(tc, name)
+		}
+		return endTag(tc, tagName(tc))
+	case r < 88:
+		return text(tc)
+	case r < 96:
+		return comment(tc)
+	}
+	return doctype(tc)
+}
+
+// soup is a soup of up to max tokens.
+func soup(tc hegel.TestCase, max int) string {
+	var open []string
+	var s string
+	k := n(tc, 0, max)
+	for i := 0; i < k; i++ {
+		s += soupToken(tc, &open)
+	}
+	return s
+}
+
+// element is a nested element with children, mostly well formed.
+func element(tc hegel.TestCase, depth int) string {
+	name := tagName(tc)
+	s := startTag(tc, name)
+	if isVoid(name) {
+		return s
+	}
+	if isRawOrRCData(name) {
+		s += pick(tc, "", "x", "a<b", "</", "</"+name, "</"+name+" ", "<!--", "-->", "&amp;", "<script>", "</script>", "]]>", "\x00")
+		if chance(tc, 85) {
+			s += endTag(tc, name)
+		}
+		return s
+	}
+	k := 0
+	if depth <= 4 {
+		k = n(tc, 0, 3)
+	}
+	for i := 0; i < k; i++ {
+		switch {
+		case chance(tc, 60):
+			s += element(tc, depth+1)
+		case chance(tc, 80):
+			s += text(tc)
+		default:
+			s += comment(tc)
+		}
+	}
+	if chance(tc, 80) {
+		s += endTag(tc, name)
+	}
+	return s
+}
+
+// structured is a document with an optional doctype, a few nested elements
+// and a little soup.
+func structured(tc hegel.TestCase) string {
+	var s string
+	if chance(tc, 60) {
+		s = doctype(tc)
+	}
+	if chance(tc, 30) {
+		s += startTag(tc, "html")
+	}
+	if chance(tc, 30) {
+		s += startTag(tc, "head")
+		if chance(tc, 50) {
+			s += element(tc, 3)
+		}
+		if chance(tc, 70) {
+			s += "</head>"
+		}
+	}
+	if chance(tc, 30) {
+		s += startTag(tc, "body")
+	}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		if chance(tc, 75) {
+			s += element(tc, 0)
+		} else {
+			s += text(tc)
+		}
+	}
+	if chance(tc, 30) {
+		s += soup(tc, 6)
+	}
+	if chance(tc, 20) {
+		s += "</body>"
+	}
+	if chance(tc, 20) {
+		s += "</html>"
+	}
+	if chance(tc, 20) {
+		s += soup(tc, 4)
+	}
+	return s
+}
+
+// mutate applies one to three random edits (on runes, so the result stays
+// valid UTF-8).
+func mutate(tc hegel.TestCase, s string) string {
+	rs := []rune(s)
+	k := n(tc, 1, 3)
+	for i := 0; i < k && len(rs) > 0; i++ {
+		at := n(tc, 0, len(rs))
+		switch n(tc, 0, 3) {
+		case 0:
+			if at < len(rs) {
+				rs = append(rs[:at:at], rs[at+1:]...)
+			}
+		case 1:
+			ins := []rune(pickFrom(tc, mutationChars))
+			rs = append(rs[:at:at], append(ins, rs[at:]...)...)
+		case 2:
+			to := at + n(tc, 1, 8)
+			if to > len(rs) {
+				to = len(rs)
+			}
+			dup := append([]rune{}, rs[at:to]...)
+			rs = append(rs[:at:at], append(dup, rs[at:]...)...)
+		default:
+			to := at + n(tc, 1, 8)
+			if to > len(rs) {
+				to = len(rs)
+			}
+			rs = append(rs[:at:at], rs[to:]...)
+		}
+	}
+	return string(rs)
+}
+
+// document is soup, structure or a mutation of either, at most ~600 runes.
+func document(tc hegel.TestCase) string {
+	var s string
+	switch r := n(tc, 0, 9); {
+	case r < 4:
+		s = soup(tc, 24)
+	case r < 8:
+		s = structured(tc)
+	default:
+		if chance(tc, 50) {
+			s = mutate(tc, soup(tc, 24))
+		} else {
+			s = mutate(tc, structured(tc))
+		}
+	}
+	if rs := []rune(s); len(rs) > 600 {
+		s = string(rs[:600])
+	}
+	return s
+}
+
+// context is a fragment context: an HTML tag mostly, a foreign one sometimes.
+func context(tc hegel.TestCase) string {
+	if chance(tc, 85) {
+		return pickFrom(tc, contexts)
+	}
+	return pickFrom(tc, foreignContexts)
+}
+
+// chunks splits s into random byte-level pieces (UTF-8 sequences may be
+// split: the reader sees bytes).
+func chunks(tc hegel.TestCase, s string) []string {
+	var out []string
+	i := 0
+	for i < len(s) {
+		var l int
+		if chance(tc, 30) {
+			l = n(tc, 1, 2)
+		} else {
+			hi := len(s) - i
+			if hi > 40 {
+				hi = 40
+			}
+			l = n(tc, 1, hi)
+		}
+		if l > len(s)-i {
+			l = len(s) - i
+		}
+		out = append(out, s[i:i+l])
+		i += l
+	}
+	return out
+}
