+package hegel
+
+// Code points whose UTS #46 status or mapping differs between the
+// IdnaMappingTable.txt of Unicode 15.1.0 (the version of node's ada) and of
+// Unicode 18.0.0 (disallowed_STD3_valid and disallowed_STD3_mapped counted as
+// valid and mapped, as UTS #46 has since revision 33): Unicode 16's revision
+// of the table, and the runes assigned since. A disagreement with node on a
+// name holding one is version skew, not a bug.
+
+var changedSince151 = []ageRange{
+	{0x04C0, 0x04C0, ""},
+	{0x0558, 0x0558, ""},
+	{0x058B, 0x058C, ""},
+	{0x05C8, 0x05C9, ""},
+	{0x088F, 0x088F, ""},
+	{0x0897, 0x0897, ""},
+	{0x0B53, 0x0B54, ""},
