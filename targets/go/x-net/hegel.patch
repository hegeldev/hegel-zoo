index 0000000..7c79eef
--- /dev/null
+++ b/idna/hegel/known.go
@@ -0,0 +1,318 @@
+package hegel
+
+// Gates: version skew between the three sides, shapes an oracle cannot
+// judge, and known bugs of x/net/idna (ids from the zoo's bugs.toml).
+
+import (
+	"strings"
+
+	"golang.org/x/net/idna"
+	"golang.org/x/text/unicode/bidi"
+)
+
+// age is the Unicode version a rune was assigned in when that is 16.0 or
+// later, "" otherwise.
+func age(r rune) string {
+	for _, a := range youngRunes {
+		if a.lo <= r && r <= a.hi {
+			return a.age
+		}
+	}
+	return ""
+}
+
+// youngest is the highest age of the runes of s among 16.0, 17.0, 18.0,
+// or "".
+func youngest(s string) string {
+	best := ""
+	for _, r := range s {
+		if a := age(r); a > best {
+			best = a
+		}
+	}
+	return best
+}
+
+// hasChangedStatus reports whether a rune of s has a UTS #46 status or
+// mapping in Unicode 18.0 other than in 15.1 (changed.go).
+func hasChangedStatus(s string) bool {
+	for _, r := range s {
+		for _, a := range changedSince151 {
+			if a.lo <= r && r <= a.hi {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// isNV8 reports whether r is valid under UTS #46 but not under IDNA2008.
+func isNV8(r rune) bool {
+	for _, a := range nv8Runes {
+		if a.lo <= r && r <= a.hi {
+			return true
+		}
+	}
+	return false
+}
+
+func hasNV8(s string) bool {
+	for _, r := range s {
+		if isNV8(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasRTL reports whether s holds a right-to-left rune (bidi class R, AL or
+// AN), which makes a name a Bidi domain name under RFC 5893.
+func hasRTL(s string) bool {
+	for _, r := range s {
+		p, _ := bidi.LookupRune(r)
+		switch p.Class() {
+		case bidi.R, bidi.AL, bidi.AN:
+			return true
+		}
+	}
+	return false
+}
+
+// hasUpperASCII reports whether s holds A-Z.
+func hasUpperASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if 'A' <= s[i] && s[i] <= 'Z' {
+			return true
+		}
+	}
+	return false
+}
+
+// forbiddenHost reports whether s holds a forbidden domain code point of
+// the URL standard (checked by node on the ASCII form; x/net/idna without
+// STD3 rules lets them through).
+func forbiddenHost(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c <= 0x20 || c == 0x7f || strings.IndexByte("#/:<>?@[\\]^|%", c) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// endsInANumber is the URL standard's test that sends a host to the IPv4
+// parser: the last label (a trailing empty one dropped) is all ASCII
+// digits, or 0x followed by hex digits.
+func endsInANumber(s string) bool {
+	labels := strings.Split(s, ".")
+	if len(labels) > 1 && labels[len(labels)-1] == "" {
+		labels = labels[:len(labels)-1]
+	}
+	last := labels[len(labels)-1]
+	if last == "" {
+		return false
+	}
+	digits := true
+	for i := 0; i < len(last); i++ {
+		if last[i] < '0' || last[i] > '9' {
+			digits = false
+		}
+	}
+	if digits {
+		return true
+	}
+	if len(last) >= 2 && last[0] == '0' && (last[1] == 'x' || last[1] == 'X') {
+		for i := 2; i < len(last); i++ {
+			if !strings.ContainsRune("0123456789abcdefABCDEF", rune(last[i])) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hasContextO reports whether s holds a rune under an IDNA2008 contextual
+// rule x/net/idna does not implement (CONTEXTO: RFC 5892 appendix A.3-A.9).
+func hasContextO(s string) bool {
+	return strings.ContainsAny(s, "·͵׳״・٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹")
+}
+
+// aceStartsWithDelimiter reports whether a label of s is an ACE label whose
+// Punycode starts with the delimiter ("xn---...").
+func aceStartsWithDelimiter(s string) bool {
+	for _, l := range asciiLabels(s) {
+		if strings.HasPrefix(l, "xn---") {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyACE reports whether a label of s is the bare ACE prefix (after
+// case folding and the dots UTS #46 maps to U+002E).
+func hasEmptyACE(s string) bool {
+	for _, l := range asciiLabels(s) {
+		if l == "xn--" {
+			return true
+		}
+	}
+	return false
+}
+
+// urlSyntax reports whether s holds ASCII the URL parser acts on before
+// the host reaches "domain to ASCII": C0 controls, space and DEL (stripped
+// or removed), the delimiters / ? # \ @ : [ ], and % (percent-decoding).
+func urlSyntax(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c <= 0x20 || c == 0x7f || strings.IndexByte("/?#\\@:[]%", c) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// whatwgProfile is the URL standard's "domain to ASCII" with beStrict
+// false, as x/net/idna options: UTS #46 lookup mapping, CheckBidi and
+// CheckJoiners on, CheckHyphens, UseSTD3ASCIIRules and VerifyDnsLength off,
+// non-transitional.
+var whatwgProfile = idna.New(
+	idna.MapForLookup(),
+	idna.BidiRule(),
+	idna.Transitional(false),
+	idna.StrictDomainName(false),
+	idna.CheckHyphens(false),
+	idna.VerifyDNSLength(false),
+)
+
+// asciiLabels lower-cases s, turns the dots UTS #46 maps to U+002E into
+// dots and splits into labels.
+func asciiLabels(s string) []string {
+	s = strings.ToLower(s)
+	for _, d := range separators[1:] {
+		s = strings.ReplaceAll(s, d, ".")
+	}
+	return strings.Split(s, ".")
+}
+
+// aceDecodesToASCII reports whether a label of s is an ACE label whose
+// Punycode decodes to ASCII only (x/net/idna rejects those on purpose,
+// calling the specification's silence a bug); got is x/net/idna's result,
+// which holds the decoded label when the input was rejected for it.
+func aceDecodesToASCII(s, got string) bool {
+	in, out := asciiLabels(s), strings.Split(got, ".")
+	for i, l := range in {
+		if !strings.HasPrefix(l, "xn--") || len(l) == 4 {
+			continue
+		}
+		if u, err := idna.Punycode.ToUnicode(l); err == nil && isASCII(u) {
+			return true
+		}
+		if len(out) == len(in) && out[i] != l && isASCII(out[i]) {
+			return true
+		}
+	}
+	return false
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// known holds the explanations of disagreements: by known bugs of
+// x/net/idna, or by shapes an oracle cannot judge.
+type known struct{}
+
+// Known is the set of gates.
+var Known known
+
+// explainsWHATWG explains a disagreement between x/net/idna's lookup
+// profile and node on input s (ASCII form got, or "" with an error): a
+// bug id, "!" + reason for a shape not judged, or "".
+func (known) explainsWHATWG(s, got string, goErr error) string {
+	if s == "" {
+		return "!empty name (no host to the URL parser)"
+	}
+	// The Unicode form (ACE labels decoded), as far as x/net/idna gets.
+	u, _ := whatwgProfile.ToUnicode(s)
+	if hasChangedStatus(s) || hasChangedStatus(u) {
+		return "!rune whose UTS #46 status changed since Unicode 15.1 (node's version)"
+	}
+	if strings.ContainsRune(s, 0x1E9E) {
+		// Since Unicode 15.1 the table maps U+1E9E to U+00DF, a deviation
+		// kept by non-transitional processing; ada still maps it to ss.
+		return "!U+1E9E (node maps it to ss, as tables before Unicode 15.1 did)"
+	}
+	if goErr != nil && aceStartsWithDelimiter(s) {
+		// RFC 3492 6.2: with no basic code points before the last delimiter,
+		// the delimiter is not consumed and is not a digit; ada consumes it.
+		return "!ACE label starting with a delimiter (RFC 3492 6.2; node consumes it)"
+	}
+	if goErr == nil && got == "" {
+		return "!empty after mapping (no host to the URL parser)"
+	}
+	if goErr == nil && hasEmptyACE(s) {
+		return "x-net/13"
+	}
+	if goErr != nil && aceDecodesToASCII(s, got) {
+		return "!ACE label decoding to ASCII (x/net/idna rejects it on purpose)"
+	}
+	if goErr != nil && (hasRTL(s) || hasRTL(u)) {
+		// x/net/idna applies the Bidi rule (CheckBidi) to Bidi domain
+		// names; node's ada does not.
+		return "!Bidi domain name rejected (node does not apply the Bidi rule)"
+	}
+	return ""
+}
+
+// explainsRegistration explains a disagreement between idna.Registration
+// and python idna on input s, python's answer being want.
+func (known) explainsRegistration(s, got string, goErr error, want verdict) string {
+	if a := youngest(s); a == "18.0" {
+		return "!rune from Unicode 18.0 (x/net/idna is at 17.0)"
+	}
+	u, _ := idna.Registration.ToUnicode(s)
+	if goErr == nil && (hasNV8(s) || hasNV8(u)) {
+		return "x-net/14"
+	}
+	if goErr == nil && !want.ok && strings.Contains(want.out, "InvalidCodepointContext") && (hasContextO(s) || hasContextO(u)) {
+		return "x-net/15"
+	}
+	if !want.ok && strings.Contains(want.out, "Unknown directionality") {
+		return "!rune unknown to python's unicodedata"
+	}
+	if goErr != nil && hasUpperASCII(s) {
+		// The profile applies no mapping, so A-Z are disallowed runes to
+		// it; python accepts an ASCII label as DNS does.
+		return "!upper case ASCII (the registration profile maps nothing)"
+	}
+	if goErr != nil && strings.HasSuffix(s, ".") {
+		// VerifyDnsLength rejects an empty root label since Unicode 16;
+		// RFC 5891 has no such rule.
+		return "!trailing dot (a VerifyDnsLength error in UTS #46 since Unicode 16)"
+	}
+	if goErr != nil && (hasRTL(s) || hasRTL(u)) {
+		// python idna applies the Bidi rule label by label, so an LTR label
+		// of a Bidi domain name is not checked.
+		return "!Bidi domain name rejected (python idna checks the Bidi rule per label)"
+	}
+	return ""
+}
+
+// explainsPunycode explains a disagreement between idna.Punycode and
+// python's punycode codec on label s.
+func (known) explainsPunycode(s string) string {
+	if strings.ContainsRune(s, 0xFFFD) {
+		// UTS #46 since Unicode 16 has U+FFFD fail the Punycode encoding;
+		// python's codec encodes it like any other rune.
+		return "!U+FFFD (x/net/idna's encoder refuses it since Unicode 16)"
+	}
+	return ""
+}
