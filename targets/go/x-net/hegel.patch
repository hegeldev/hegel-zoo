+++ b/idna/hegel/hegel_gen_test.go
@@ -0,0 +1,367 @@
+package hegel
+
+// Generators: labels made of pieces from pools that touch every part of
+// UTS #46 and IDNA2008 (mapped, ignored, deviation and disallowed runes,
+// joiners and viramas, the contextual-rule runes, right-to-left scripts and
+// digits, combining marks, dot variants, ACE labels, hyphen positions and
+// lengths), joined into domain names.
+
+import (
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+var pools = [][]string{
+	// ASCII letters, digits, hyphens; upper case maps.
+	{"a", "b", "z", "q", "0", "9", "-", "A", "Z", "Q", "2"},
+	// Latin with diacritics, deviations and specials.
+	{"é", "ü", "ö", "ñ", "ß", "ẞ", "ı", "İ", "ﬁ", "Å", "å", "ǅ", "ǆ", "ſ", "ǰ", "ẛ", "ø", "ł", "þ"},
+	// Greek, with the contextual keraia and final sigma.
+	{"α", "σ", "ς", "ό", "Σ", "ΐ", "ͺ", "ϐ", "ϑ", "ό", "͵", "΄", "ᾳ", "ῼ"},
+	// Cyrillic.
+	{"д", "ж", "Ж", "ё", "ѐ", "ӑ", "ꙑ", "і", "ї", "ұ"},
+	// Hebrew, with points, geresh and gershayim.
+	{"א", "ב", "ש", "ׂ", "ּ", "׳", "״", "ﬠ", "ﬡ", "ְ"},
+	// Arabic, with both digit sets, tatweel and presentation forms.
+	{"م", "ث", "ا", "ل", "ة", "ي", "ء", "٠", "١", "٩", "۰", "۹", "ـ", "ﻻ", "ٰ", "ﭐ", "؀"},
+	// Indic scripts with viramas, and the joiners they license.
+	{"क", "ख", "्", "ि", "ं", "ॐ", "ক", "্", "ৰ", "க", "்", "‌", "‍", "ಕ", "್", "ഡ"},
+	// Han, kana, hangul, the katakana middle dot, compatibility forms.
+	{"中", "文", "字", "あ", "い", "ア", "ー", "・", "ゝ", "ヽ", "한", "글", "ᄀ", "ᅡ", "ᆨ", "ﾊ", "ﾞ", "㍿", "㋀", "々", "〆", "ㄱ"},
+	// Thai, Myanmar, Khmer, Tibetan.
+	{"ก", "ข", "ำ", "่", "က", "္", "ក", "្", "ཀ", "ྐ"},
+	// Symbols and emoji, mapped compatibility characters.
+	{"😀", "❤", "♥", "☃", "✈", "🏳", "‼", "⁉", "™", "©", "®", "№", "℃", "Ⅷ", "ⅷ", "⒈", "㎏", "½", "²", "𝔞", "𝐀", "ℌ", "ℕ", "K", "Ω", "µ", "ǰ"},
+	// Ignored and format runes: soft hyphen, variation selectors, zero width
+	// space and word joiner, BOM, combining grapheme joiner, Mongolian free
+	// variation selector and vowel separator, Khmer inherent vowel, NNBSP.
+	{"\u00ad", "\ufe0f", "\ufe00", "\u200b", "\u2060", "\ufeff", "\u034f", "\u180b", "\u17b4", "\u180e", "\u202f"},
+	// Disallowed runes, STD3 ASCII, controls, unassigned, private use.
+	{" ", "_", "~", "!", "$", "&", "'", "(", ")", "*", "+", ",", ";", "=", "@", ":", "/", "?", "#", "[", "]", "\\", "^", "|", "<", ">", "\"", "`", "{", "}",
+		"\u0000", "\u0001", "\u001f", "\u007f", "\u0080", "\u00a0", "\u2028", "\u3000", "\uffff", "\ufffd", "\ue000", "\U000e0001", "\U0010ffff", "\u0378", "\u0341", "\u0640", "\u0085", "\u200e", "\u2029"},
+	// Combining marks (disallowed at the start of a label).
+	{"̀", "́", "̈", "⃝", "༾", "༿", "ः", "ि", "ְ", "ً"},
+	// Full and half width forms, which map to ASCII (some to forbidden host code points).
+	{"Ａ", "ｚ", "１", "９", "－", "＿", "＠", "＃", "％", "／", "：", "？", "［", "］", "～", "｜", "ｘ", "ｎ"},
+}
+
+// contextO holds the runes IDNA2008 allows only in context (RFC 5892
+// appendix A, rules with names ending in O).
+var contextO = []string{"·", "͵", "׳", "״", "・", "٠", "١", "٩", "۰", "۹"}
+
+var separators = []string{".", "。", "．", "｡"}
+
+// tame pools: letters that are valid everywhere, so that a good share of
+// the names go through every step of the round trips.
+var tamePools = [][]string{
+	{"a", "b", "z", "q", "0", "9", "-", "x", "n"},
+	{"é", "ü", "ö", "ñ", "ß", "ø", "ł", "þ", "å"},
+	{"α", "σ", "ς", "ό", "ω"},
+	{"д", "ж", "ё", "і", "ї"},
+	{"א", "ב", "ש"},
+	{"م", "ث", "ا", "ل", "ة", "ي"},
+	{"क", "ख", "ि", "ं", "ক"},
+	{"中", "文", "字", "あ", "い", "ア", "ー", "한", "글"},
+	{"ก", "ข", "ำ"},
+	{"😀", "❤", "♥", "☃"},
+}
+
+// The records: a domain name is a list of label records with the
+// separators between them, a leading or trailing dot and an over-length
+// tail drawn as data beside them, rendered by String; a label is its kind
+// and the pieces or word it is made of. The tame share of the names (one
+// script per label, so that the Bidi rule holds and the names go through
+// every step of the round trips) is a field of the domain. The shapes of
+// the recorded bugs are explicit alternatives with weights that are zero
+// under HEGEL_NO_KNOWN=1: the bare ACE prefix of x-net/13 and a CONTEXTO
+// rune of x-net/15 among plain letters are labels that replace one label
+// of some names, an NV8 rune of x-net/14 is a piece of the wild labels the
+// registration profile sees (as is the symbols pool, whose members are NV8
+// runes).
+
+// runeIn is one rune of a range, as text.
+func runeIn(a ageRange) hegel.Generator[string] {
+	return hegel.Map(hegel.Integers(int(a.lo), int(a.hi)), func(c int) string { return string(rune(c)) })
+}
+
+// youngRuneTexts: a rune assigned in Unicode 16, 17 or 18.
+var youngRuneTexts = hegel.FlatMap(hegel.SampledFrom(youngRunes), runeIn)
+
+// anyRunes: a rune from the whole space, surrogates excepted.
+var anyRunes = hegel.Map(
+	hegel.Filter(hegel.Integers(0, 0x10FFFF), func(c int) bool { return utf8.ValidRune(rune(c)) }),
+	func(c int) string { return string(rune(c)) })
+
+// nv8RuneTexts: a rune UTS #46 calls valid but IDNA2008 disallows or
+// excludes (nv8.go), outside ASCII (where the registration profile's STD3
+// rules reject them anyway).
+var nv8RuneTexts = hegel.FlatMap(hegel.SampledFrom(beyondASCII(nv8Runes)), runeIn)
+
+func beyondASCII(rs []ageRange) []ageRange {
+	var out []ageRange
+	for _, a := range rs {
+		if a.lo >= 0x80 {
+			out = append(out, a)
+		}
+	}
+	return out
+}
+
+// asciiWords: lo to hi letters, digits and hyphens.
+func asciiWords(lo, hi int) hegel.Generator[string] {
+	return joined(many(pick(strings.Split("abcdefghijklmnopqrstuvwxyz0123456789-", "")...), lo, hi))
+}
+
+// symbolsPool is the index of the symbols and emoji pool in pools and in
+// tamePools.
+const symbolsPool = 9
+
+// pooled: a piece of one of the pools, the symbols pool with weight symbols.
+func pooled(pools [][]string, symbols int) hegel.Generator[string] {
+	var cs []choice[string]
+	for i, p := range pools {
+		w := 1
+		if i == symbolsPool {
+			w = symbols
+		}
+		cs = append(cs, choice[string]{w, pick(p...)})
+	}
+	return weighted(cs...)
+}
+
+// piecesIn: one element of a wild label; symbols is the weight of the
+// symbols pool, nv8 that of a lone NV8 rune (x-net/14), first so that the
+// registration profile's mismatches shrink to one, whichever pool they
+// came from.
+func piecesIn(symbols, nv8 int) hegel.Generator[string] {
+	return weighted(
+		choice[string]{nv8, nv8RuneTexts},
+		choice[string]{90, pooled(pools, symbols)},
+		choice[string]{4, asciiWords(1, 6)},
+		choice[string]{3, youngRuneTexts},
+		choice[string]{3, anyRunes},
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Labels.
+
+type labelKind int
+
+const (
+	piecesLabel     labelKind = iota // the pieces concatenated
+	rawACELabel                      // "xn--" and the word: what a punycode decoder gets fed
+	encodedACELabel                  // the ACE form of the pieces
+	wordLabel                        // the word as it is: numeric labels, hyphen positions, licensed contextual runes
+	longLabel                        // the word repeated count times, around the 63-octet limit
+	emptyLabel                       // nothing
+	upperACELabel                    // the ACE form of the pieces in upper case
+	bareACELabel                     // the bare ACE prefix (x-net/13)
+	markedLabel                      // the pieces with the mark among them (the NV8 runes of x-net/14, the CONTEXTO runes of x-net/15)
+)
+
+type label struct {
+	kind   labelKind
+	pieces []string
+	word   string
+	count  int
+	mark   string // a markedLabel's rune
+	at     int    // its place among the pieces (modulo)
+}
+
+func (l label) String() string {
+	switch l.kind {
+	case rawACELabel:
+		return "xn--" + l.word
+	case encodedACELabel:
+		return ace(strings.Join(l.pieces, ""))
+	case wordLabel:
+		return l.word
+	case longLabel:
+		return strings.Repeat(l.word, l.count)
+	case emptyLabel:
+		return ""
+	case upperACELabel:
+		return strings.ToUpper(ace(strings.Join(l.pieces, "")))
+	case bareACELabel:
+		return "xn--"
+	case markedLabel:
+		at := l.at % (len(l.pieces) + 1)
+		return strings.Join(l.pieces[:at], "") + l.mark + strings.Join(l.pieces[at:], "")
+	}
+	return strings.Join(l.pieces, "")
+}
+
+func (l label) GoString() string {
+	s := l.String()
+	return fmt.Sprintf("label %q (%s)", s, runesOf(s))
+}
+
+// ace is the ACE form of a label, or the label itself when the Punycode
+// profile refuses it or its result holds a dot.
+func ace(s string) string {
+	if a, err := punycodeProfile.ToASCII(s); err == nil && !strings.Contains(a, ".") {
+		return a
+	}
+	return s
+}
+
+// labelsOfKind: one to six pieces as a label of the kind.
+func labelsOfKind(kind labelKind, pieces hegel.Generator[string]) hegel.Generator[label] {
+	return hegel.Map(many(pieces, 1, 6), func(ps []string) label { return label{kind: kind, pieces: ps} })
+}
+
+// wordLabelsOf: a label that is one of the words.
+func wordLabelsOf(words ...string) hegel.Generator[label] {
+	return hegel.Map(pick(words...), func(w string) label { return label{kind: wordLabel, word: w} })
+}
+
+// markedLabelsOf: up to four pieces with one rune of marks among them.
+func markedLabelsOf(pieces, marks hegel.Generator[string]) hegel.Generator[label] {
+	return hegel.Composite(func(tc hegel.TestCase) label {
+		return label{kind: markedLabel, pieces: hegel.Draw(tc, many(pieces, 0, 4)), mark: hegel.Draw(tc, marks), at: hegel.Draw(tc, hegel.Integers(0, 4))}
+	})
+}
+
+var (
+	// rawACELabels: the ACE prefix and one to eight LDH characters.
+	rawACELabels = hegel.Map(asciiWords(1, 8), func(w string) label { return label{kind: rawACELabel, word: w} })
+	// numericLabels: numeric and hexadecimal labels (the URL standard's IPv4 shapes).
+	numericLabels = wordLabelsOf("123", "0x1f", "0", "255", "09", "1e3", "0X", "12ab")
+	// hyphenLabels: hyphens at the edges and in positions 3-4 (the ACE prefix's).
+	hyphenLabels = wordLabelsOf("-a", "a-", "ab--cd", "a--b", "--", "-", "xn-a", "XN--a", "Xn--a")
+	// longLabels: one rune repeated around the 63-octet label limit.
+	longLabels = hegel.Composite(func(tc hegel.TestCase) label {
+		return label{kind: longLabel, word: hegel.Draw(tc, pick("a", "\u00e9", "\u4e2d")), count: hegel.Draw(tc, hegel.SampledFrom([]int{62, 63, 64, 70}))}
+	})
+	emptyLabels   = hegel.Just(label{kind: emptyLabel})
+	bareACELabels = hegel.Just(label{kind: bareACELabel})
+	contextOMarks = pick(contextO...)
+)
+
+// labelsWith: a label of the wild pools; symbols and nv8 as in piecesIn.
+func labelsWith(symbols, nv8 int) hegel.Generator[label] {
+	pieces := piecesIn(symbols, nv8)
+	return weighted(
+		choice[label]{85, labelsOfKind(piecesLabel, pieces)},
+		choice[label]{4, rawACELabels},
+		choice[label]{3, labelsOfKind(encodedACELabel, pieces)},
+		choice[label]{2, numericLabels},
+		choice[label]{2, hyphenLabels},
+		choice[label]{1, longLabels},
+		choice[label]{1, emptyLabels},
+		choice[label]{1, labelsOfKind(upperACELabel, pieces)},
+	)
+}
+
+// tamePieces are the letters of the ASCII tame pool: company for a
+// recorded bug's shape, so that the shape is what the profiles judge.
+var tamePieces = pick(tamePools[0]...)
+
+// contextOShapes are the labels the registration profile accepts against
+// IDNA2008's contextual rules: a CONTEXTO rune (x-net/15) among plain
+// letters.
+var contextOShapes = markedLabelsOf(tamePieces, contextOMarks)
+
+// shapeSlots: the place (modulo the number of labels) of the label a
+// recorded bug's shape replaces in known percent of the names, -1 in the
+// others.
+func shapeSlots(known int) hegel.Generator[int] {
+	return weighted(choice[int]{100 - known, hegel.Just(-1)}, choice[int]{known, hegel.Integers(0, 4)})
+}
+
+// tameLabelsWith: a label of one tame pool (one script per label, so that
+// the Bidi rule holds), the symbols pool with weight symbols.
+func tameLabelsWith(symbols int) hegel.Generator[label] {
+	var cs []choice[[]string]
+	for i, p := range tamePools {
+		w := 1
+		if i == symbolsPool {
+			w = symbols
+		}
+		cs = append(cs, choice[[]string]{w, hegel.Just(p)})
+	}
+	return hegel.FlatMap(weighted(cs...), func(pool []string) hegel.Generator[label] {
+		return labelsOfKind(piecesLabel, pick(pool...))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Domain names.
+
+type domain struct {
+	tame        bool // every label of one tame pool
+	leadingDot  bool
+	labels      []label
+	separators  []string // between the labels
+	trailingDot bool
+	overLength  bool // a tail over the 253-octet name limit
+}
+
+func (d domain) String() string {
+	var b strings.Builder
+	if d.leadingDot {
+		b.WriteString(".")
+	}
+	for i, l := range d.labels {
+		if i > 0 {
+			b.WriteString(d.separators[(i-1)%len(d.separators)])
+		}
+		b.WriteString(l.String())
+	}
+	if d.trailingDot {
+		b.WriteString(".")
+	}
+	if d.overLength {
+		b.WriteString("." + strings.Repeat("a.", 120) + "b")
+	}
+	return b.String()
+}
+
+func (d domain) GoString() string {
+	s := d.String()
+	return fmt.Sprintf("domain %q (%s)", s, runesOf(s))
+}
+
+// domainsWith: one to five labels, 40% of the names from the tame pools,
+// joined by dots (or, when unicodeDots, 15% of the time by one of the runes
+// that map to a dot), sometimes with a leading or trailing dot or an
+// over-length tail; symbols and nv8 as in piecesIn, and in known percent
+// of the names one label is one of the shapes.
+func domainsWith(unicodeDots bool, symbols, nv8 int, shapes hegel.Generator[label], known int) hegel.Generator[domain] {
+	dots := hegel.Just(".")
+	if unicodeDots {
+		dots = weighted(choice[string]{85, hegel.Just(".")}, choice[string]{15, pick(separators...)})
+	}
+	wild, tame, slots := labelsWith(symbols, nv8), tameLabelsWith(symbols), shapeSlots(known)
+	return hegel.Composite(func(tc hegel.TestCase) domain {
+		d := domain{tame: hegel.Draw(tc, chance(40)), leadingDot: hegel.Draw(tc, chance(5))}
+		labels := wild
+		if d.tame {
+			labels = tame
+		}
+		d.labels = hegel.Draw(tc, many(labels, 1, 5))
+		if at := hegel.Draw(tc, slots); at >= 0 {
+			d.labels[at%len(d.labels)] = hegel.Draw(tc, shapes)
+		}
+		d.separators = hegel.Draw(tc, many(dots, len(d.labels)-1, len(d.labels)-1))
+		d.trailingDot = hegel.Draw(tc, chance(10))
+		d.overLength = hegel.Draw(tc, chance(2))
+		return d
+	})
+}
+
+var (
+	// lookupNames: the names the lookup profiles see; node's domainToASCII
+	// accepts the bare ACE prefix of x-net/13 no more than a Punycode error.
+	lookupNames = domainsWith(true, 1, 0, bareACELabels, unless(noKnown, 30))
+	// registrationNames: the names the registration profile sees; the NV8
+	// runes of x-net/14 (the symbols pool, the lone NV8 pieces) and the
+	// CONTEXTO runes of x-net/15 (the marked labels) are drawn by default.
+	registrationNames = domainsWith(false, unless(noKnown, 1), unless(noKnown, 10), contextOShapes, unless(noKnown, 15))
+	// labels: a wild label on its own, for the Punycode profile.
+	labels = labelsWith(1, 0)
+)
diff --git a/idna/hegel/hegel_pins_test.go b/idna/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..75a424d
--- /dev/null
+++ b/idna/hegel/hegel_pins_test.go
@@ -0,0 +1,44 @@
+package hegel
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug is open
+// (listed under [expected_failures] in the zoo's target.toml).
+
+import (
+	"testing"
+
+	"golang.org/x/net/idna"
+)
+
+// x-net/13: a label that is the bare ACE prefix decodes to the empty
+// string, which UTS #46 (since revision 31) records as a Punycode error
+// (P4; IdnaTestV2 has the case "xn--" with [P4, X4_2]); x/net/idna accepts
+// it and returns an empty label.
+func TestHegelPinBareACEPrefixIsAnError(t *testing.T) {
+	for _, s := range []string{"xn--", "a.xn--.b"} {
+		if a, err := idna.Lookup.ToASCII(s); err == nil {
+			t.Errorf("Lookup.ToASCII(%q) = %q with no error; want a Punycode error", s, a)
+		}
+	}
+}
+
+// x-net/14: the registration profile accepts code points UTS #46 calls
+// valid but IDNA2008 disallows (NV8) or excludes (XV8), such as U+00A1 and
+// U+2615; RFC 5891 section 4.2.2 requires PVALID or contextual code points.
+func TestHegelPinRegistrationRejectsNV8(t *testing.T) {
+	for _, s := range []string{"¡", "☕", "᧚"} {
+		if a, err := idna.Registration.ToASCII(s); err == nil {
+			t.Errorf("Registration.ToASCII(%q) = %q with no error; want a disallowed rune error", s, a)
+		}
+	}
+}
+
+// x-net/15: the registration profile applies none of IDNA2008's CONTEXTO
+// rules (RFC 5892 appendix A.3-A.9): a katakana middle dot with no
+// Japanese letter in the label and a middle dot not between two l's pass.
+func TestHegelPinRegistrationAppliesContextO(t *testing.T) {
+	for _, s := range []string{"・", "a·b"} {
+		if a, err := idna.Registration.ToASCII(s); err == nil {
+			t.Errorf("Registration.ToASCII(%q) = %q with no error; want a contextual rule error", s, a)
+		}
+	}
+}
diff --git a/idna/hegel/hegel_props_test.go b/idna/hegel/hegel_props_test.go
new file mode 100644
index 0000000..90eb669
--- /dev/null
+++ b/idna/hegel/hegel_props_test.go
@@ -0,0 +1,209 @@
+package hegel
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"golang.org/x/net/idna"
+	"hegel.dev/go/hegel"
+)
+
+var punycodeProfile = idna.Punycode
+
+// judge compares x/net/idna's verdict with an oracle's: agreement passes, a
+// disagreement is a mismatch on the case's known shapes (none for a plain
+// failure).
+func judge(ht *hegel.T, what, input string, got, want verdict, shapes []string) {
+	if got.ok == want.ok && (!got.ok || got.out == want.out) {
+		return
+	}
+	mismatch(ht, shapes, "%s of %q (%s):\n  x/net/idna: %v\n  oracle:     %v", what, input, runesOf(input), got, want)
+}
+
+// runesOf spells the input as code points, for the record.
+func runesOf(s string) string {
+	var b strings.Builder
+	for i, r := range s {
+		if i > 0 {
+			b.WriteByte(' ')
+		}
+		if r < 0x80 && unicode.IsPrint(r) && r != ' ' {
+			b.WriteRune(r)
+		} else {
+			fmt.Fprintf(&b, "U+%04X", r)
+		}
+	}
+	return b.String()
+}
+
+// TestHegelLookupAgreesWithWHATWG: the lookup profile with the URL
+// standard's flags gives what node's url.domainToASCII gives (failure, or
+// the same ASCII form), the ASCII form goes back to the same Unicode form
+// as node's url.domainToUnicode gives, and that Unicode form maps to the
+// same ASCII form again.
+func TestHegelLookupAgreesWithWHATWG(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkLookup(ht, t, hegel.Draw(ht, lookupNames).String())
+	})
+}
+
+// checkLookup is the body of TestHegelLookupAgreesWithWHATWG on the name
+// s; bug names the bug a narrow property is about.
+func checkLookup(ht *hegel.T, t testing.TB, s string, bug ...string) {
+	if urlSyntax(s) {
+		notJudged("URL syntax the host parser acts on first")
+	}
+	a, err := whatwgProfile.ToASCII(s)
+	got := goVerdict(a, err)
+	if err == nil && endsInANumber(a) {
+		notJudged("ends in a number (IPv4 to the URL standard)")
+	}
+	if err == nil && forbiddenHost(a) {
+		// The URL standard rejects the ASCII form after mapping; x/net/idna
+		// without STD3 rules has no such check, by design.
+		if want := whatwgASCII(t, s); want.ok {
+			fail(ht, "domainToASCII of %q (%s) is %q, holding a forbidden host code point x/net/idna's %q also holds; expected node to reject it", s, runesOf(s), want.out, a)
+		}
+		count("forbidden host code point after mapping")
+		return
+	}
+	shapes := named(bug, Known.explainsWHATWG(s, a, err))
+	judge(ht, "ToASCII", s, got, whatwgASCII(t, s), shapes)
+	if !got.ok {
+		return
+	}
+	// Back to Unicode, and to ASCII again.
+	u, uerr := whatwgProfile.ToUnicode(a)
+	judge(ht, "ToUnicode", a, goVerdict(u, uerr), whatwgUnicode(t, s), shapes)
+	if u2, err := whatwgProfile.ToUnicode(s); err != nil || u2 != u {
+		mismatch(ht, named(bug, Known.explainsWHATWG(s, a, err)), "ToUnicode of %q (%s) is %q with error %v, but ToUnicode of its ASCII form %q is %q", s, runesOf(s), u2, err, a, u)
+	}
+	if a2, err := whatwgProfile.ToASCII(u); err != nil || a2 != a {
+		fail(ht, "ToASCII of %q (%s) is %q; of its Unicode form %q it is %q with error %v", s, runesOf(s), a, u, a2, err)
+	}
+	if a3, err := whatwgProfile.ToASCII(a); err != nil || a3 != a {
+		fail(ht, "ToASCII of %q is not a fixed point: %q with error %v", a, a3, err)
+	}
+}
+
+// TestHegelRegistrationAgreesWithIDNA2008: idna.Registration accepts a
+// name, and gives the same A-labels, exactly when python's idna package
+// (RFC 5891 registration rules) does, and both decode it back alike.
+func TestHegelRegistrationAgreesWithIDNA2008(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkRegistration(ht, t, hegel.Draw(ht, registrationNames).String())
+	})
+}
+
+// checkRegistration is the body of TestHegelRegistrationAgreesWithIDNA2008
+// on the name s; bug names the bug a narrow property is about.
+func checkRegistration(ht *hegel.T, t testing.TB, s string, bug ...string) {
+	a, err := idna.Registration.ToASCII(s)
+	got := goVerdict(a, err)
+	want := idna2008Encode(t, s)
+	judge(ht, "Registration.ToASCII", s, got, want, named(bug, Known.explainsRegistration(s, a, err, want)))
+	if !got.ok {
+		return
+	}
+	u, uerr := idna.Registration.ToUnicode(a)
+	wantU := idna2008Decode(t, a)
+	judge(ht, "Registration.ToUnicode", a, goVerdict(u, uerr), wantU, named(bug, Known.explainsRegistration(s, a, err, wantU)))
+}
+
+// TestHegelPunycodeAgreesWithTheCodec: idna.Punycode (no mapping, no
+// validation) encodes a non-ASCII label as xn-- plus python's punycode of
+// it, decodes it back exactly, and decodes a raw ACE label as python's
+// codec does.
+func TestHegelPunycodeAgreesWithTheCodec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, labels).String()
+		if strings.Contains(s, ".") {
+			notJudged("a dot in the label")
+		}
+		lower := strings.ToLower(s)
+		if strings.HasPrefix(lower, "xn--") {
+			if lower != s[:4]+lower[4:] {
+				// The profile matches the prefix case-sensitively, and maps
+				// nothing: "Xn--a" is a plain label to it.
+				notJudged("ACE prefix in upper case")
+			}
+			if s == "xn--" {
+				notJudged("bare ACE prefix")
+			}
+			if s[4] == '-' {
+				// RFC 3492 6.2: with no basic code points before the last
+				// delimiter, the delimiter is not consumed and is not a digit;
+				// python's codec consumes it anyway.
+				notJudged("ACE label starting with a delimiter")
+			}
+			// Decoding.
+			u, err := punycodeProfile.ToUnicode(s)
+			want := pyUnpunycode(t, s[4:])
+			if want.ok && isASCII(want.out) {
+				// A decoder's output that is all ASCII: x/net/idna rejects it
+				// on purpose (a specification bug it does not follow).
+				if err == nil {
+					fail(ht, "Punycode.ToUnicode of %q gave the ASCII %q without error", s, u)
+				}
+				count("ACE label decoding to ASCII")
+				return
+			}
+			judge(ht, "Punycode.ToUnicode", s, goVerdict(u, err), want, shape(Known.explainsPunycode(s)))
+			return
+		}
+		a, err := punycodeProfile.ToASCII(s)
+		if isASCII(s) {
+			if err != nil || a != s {
+				fail(ht, "Punycode.ToASCII of the ASCII label %q: %q, %v", s, a, err)
+			}
+			return
+		}
+		want := pyPunycode(t, s)
+		if want.ok {
+			want.out = "xn--" + want.out
+		}
+		judge(ht, "Punycode.ToASCII", s, goVerdict(a, err), want, shape(Known.explainsPunycode(s)))
+		if err != nil {
+			return
+		}
+		u, err := punycodeProfile.ToUnicode(a)
+		if err != nil || u != s {
+			mismatch(ht, shape(Known.explainsPunycode(s)), "Punycode.ToUnicode(Punycode.ToASCII(%q)) = %q, %v (label %s)", s, u, err, runesOf(s))
+		}
+	})
+}
+
+// TestHegelLookupIsAFixedPoint: for the Lookup and Display profiles, an
+// accepted name's ASCII form is a fixed point of ToASCII, its Unicode form
+// is accepted and maps back to the same ASCII form, and ToUnicode of the
+// name agrees with ToUnicode of its ASCII form.
+func TestHegelLookupIsAFixedPoint(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, lookupNames).String()
+		for _, p := range []struct {
+			name string
+			p    *idna.Profile
+		}{{"Lookup", idna.Lookup}, {"Display", idna.Display}} {
+			a, err := p.p.ToASCII(s)
+			if err != nil {
+				count(p.name + " rejects")
+				continue
+			}
+			if a2, err := p.p.ToASCII(a); err != nil || a2 != a {
+				fail(ht, "%s.ToASCII of %q (%s) is %q, but of that again %q with error %v", p.name, s, runesOf(s), a, a2, err)
+			}
+			u, err := p.p.ToUnicode(a)
+			if err != nil {
+				fail(ht, "%s.ToASCII of %q (%s) is %q, whose ToUnicode fails: %v", p.name, s, runesOf(s), a, err)
+			}
+			if u2, err := p.p.ToUnicode(s); err != nil || u2 != u {
+				fail(ht, "%s.ToUnicode of %q (%s) is %q with error %v, but of its ASCII form %q it is %q", p.name, s, runesOf(s), u2, err, a, u)
+			}
+			if a3, err := p.p.ToASCII(u); err != nil || a3 != a {
+				fail(ht, "%s.ToASCII of %q (%s) is %q; of its Unicode form %q it is %q with error %v", p.name, s, runesOf(s), a, u, a3, err)
+			}
+		}
+	})
+}
diff --git a/idna/hegel/hegel_shapes_test.go b/idna/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..2a23573
--- /dev/null
+++ b/idna/hegel/hegel_shapes_test.go
@@ -0,0 +1,82 @@
+package hegel
+
+// One narrow property per recorded bug (bugs.toml), over the bug's shape
+// region: by default it fails naming the bug and is an expected failure
+// mapped to it; under HEGEL_NO_KNOWN=1 it draws the neighbouring region
+// past the shape and passes.
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// plainPieces are letters and digits valid under every profile.
+var plainPieces = pick("a", "b", "z", "q", "0", "9", "x", "n")
+
+// plainLabels are labels of plain pieces.
+var plainLabels = labelsOfKind(piecesLabel, plainPieces)
+
+// pvalidRunes are non-ASCII runes PVALID under IDNA2008 and valid under
+// UTS #46: e, u with diaeresis, n with tilde, sharp s, alpha, de, zhong.
+var pvalidRunes = pick("\u00e9", "\u00fc", "\u00f1", "\u00df", "\u03b1", "\u0434", "\u4e2d")
+
+// namesAround: one of the special labels among one or two plain labels,
+// joined by dots.
+func namesAround(special hegel.Generator[label]) hegel.Generator[domain] {
+	return hegel.Composite(func(tc hegel.TestCase) domain {
+		d := domain{labels: hegel.Draw(tc, many(plainLabels, 1, 2))}
+		at := hegel.Draw(tc, hegel.Integers(0, 2)) % (len(d.labels) + 1)
+		rest := append([]label{hegel.Draw(tc, special)}, d.labels[at:]...)
+		d.labels = append(d.labels[:at:at], rest...)
+		for i := 1; i < len(d.labels); i++ {
+			d.separators = append(d.separators, ".")
+		}
+		return d
+	})
+}
+
+// TestHegelBareACEPrefixIsAnError (x-net/13): a name with a label that is
+// the bare ACE prefix beside plain labels; the lookup profile with the URL
+// standard's flags must reject it as node does. Past the shape: ACE labels
+// with Punycode after the prefix, raw or of PVALID runes.
+var bareACENames = shaped(
+	namesAround(bareACELabels),
+	namesAround(weighted(choice[label]{1, labelsOfKind(encodedACELabel, pvalidRunes)}, choice[label]{1, rawACELabels})))
+
+func TestHegelBareACEPrefixIsAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkLookup(ht, t, hegel.Draw(ht, bareACENames).String(), "x-net/13")
+	})
+}
+
+// TestHegelRegistrationRejectsNV8 (x-net/14): a name with a label holding a
+// rune UTS #46 calls valid but IDNA2008 disallows or excludes (nv8.go)
+// among plain pieces; the registration profile must reject it as python's
+// idna does. Past the shape: a PVALID rune among the plain pieces.
+var nv8Names = shaped(
+	namesAround(markedLabelsOf(plainPieces, nv8RuneTexts)),
+	namesAround(markedLabelsOf(plainPieces, pvalidRunes)))
+
+func TestHegelRegistrationRejectsNV8(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkRegistration(ht, t, hegel.Draw(ht, nv8Names).String(), "x-net/14")
+	})
+}
+
+// TestHegelRegistrationAppliesContextO (x-net/15): a name with a label
+// holding a CONTEXTO rune (RFC 5892 appendix A.3-A.9) among plain pieces,
+// where its rule does not hold; the registration profile must reject it as
+// python's idna does. Past the shape: the contextual runes in their
+// licensed context (a middle dot between two l's, a keraia before a Greek
+// letter, a geresh and a gershayim after a Hebrew letter, a katakana middle
+// dot beside katakana).
+var contextONames = shaped(
+	namesAround(markedLabelsOf(plainPieces, contextOMarks)),
+	namesAround(wordLabelsOf("l\u00b7l", "\u0375\u03b1", "\u05d0\u05f3", "\u05d0\u05f4", "\u30a2\u30fb")))
+
+func TestHegelRegistrationAppliesContextO(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkRegistration(ht, t, hegel.Draw(ht, contextONames).String(), "x-net/15")
+	})
+}
diff --git a/idna/hegel/hegel_test.go b/idna/hegel/hegel_test.go
new file mode 100644
index 0000000..1012791
--- /dev/null
+++ b/idna/hegel/hegel_test.go
@@ -0,0 +1,439 @@
+package hegel
+
+// Hegel property tests for golang.org/x/net/idna: generated domain names go
+// through x/net/idna's profiles and through two other implementations of
+// the same standards, run as child processes speaking JSON lines:
+//
+//   - node's url.domainToASCII / url.domainToUnicode (ada), the URL
+//     standard's "domain to ASCII" (UTS #46 with CheckHyphens=false,
+//     CheckBidi=true, CheckJoiners=true, UseSTD3ASCIIRules=false,
+//     Transitional_Processing=false, VerifyDnsLength=false), against the
+//     same flags on an x/net/idna lookup profile;
+//   - python's idna package (IDNA2008: RFC 5891 registration rules with no
+//     mapping) against idna.Registration, and python's punycode codec
+//     against idna.Punycode.
+//
+// The three sides are at different Unicode versions (ada 15.1, x/net/idna
+// 17.0.0 with Go 1.27, python idna 3.20 at 18.0.0): a disagreement on an
+// input holding a rune assigned after the older side's version is version
+// skew and is counted, not failed (age.go holds the ranges).
+//
+// The generators (hegel_gen_test.go) are package-level values built from
+// the binding's combinators: a domain name is a record of label records,
+// separators and dots, rendered by pure String methods. The shapes of the
+// recorded bugs (bugs.toml, matched in known.go) are drawn by default, so
+// the wide properties that meet them fail naming the bug and are the
+// expected failures mapped to it; hegel_shapes_test.go has one narrow
+// property per bug over its shape region, and the pins (hegel_pins_test.go)
+// are the regression examples. HEGEL_NO_KNOWN=1 (noKnown, in known.go)
+// stops drawing the shapes and counts a mismatch the classifier explains.
+//
+// Needs node and python3 with idna on PATH.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 300 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed (version skew, a
+// known bug, a shape the property has no opinion on).
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// notJudged ends the case as one the property has no opinion on (version
+// skew, a shape the oracle cannot judge): counted, not failed, in both
+// modes.
+func notJudged(reason string) {
+	count("not judged: " + reason)
+	panic(collected{})
+}
+
+// mismatch reports a disagreement with an oracle, or a broken round trip,
+// on a case whose known shapes are named (none for a plain failure): a
+// shape the oracle has no opinion on ("!" + reason) is not judged; a
+// recorded bug's shape is counted and fails naming the bug, or under
+// HEGEL_NO_KNOWN=1 is counted as the known bug and the case ends.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	var bugs []string
+	for _, s := range shapes {
+		if strings.HasPrefix(s, "!") {
+			notJudged(s[1:])
+		}
+		bugs = append(bugs, s)
+	}
+	if len(bugs) > 0 {
+		for _, b := range bugs {
+			count("shape " + b)
+		}
+		if noKnown {
+			for _, b := range bugs {
+				count("known " + b)
+			}
+			panic(collected{})
+		}
+		format += " (the shape of " + strings.Join(bugs, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shape is the list of shapes a classifier's answer names: none for "".
+func shape(id string) []string {
+	if id == "" {
+		return nil
+	}
+	return []string{id}
+}
+
+// shapesOf names the bug a narrow property is about, followed by what the
+// classifier says of the case (not judged shapes keep their precedence).
+func shapesOf(bug string, classified string) []string {
+	if strings.HasPrefix(classified, "!") {
+		return []string{classified}
+	}
+	if classified == "" || classified == bug {
+		return []string{bug}
+	}
+	return []string{bug, classified}
+}
+
+// named is the shapes of a case: the classifier's answer, after the bug a
+// narrow property is about when there is one.
+func named(bug []string, classified string) []string {
+	if len(bug) == 0 {
+		return shape(classified)
+	}
+	return shapesOf(bug[0], classified)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms (hegel-go has no weighted choice, biased coin or tuple
+// combinator; these are the zoo's spellings).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight (a weight of zero is never drawn); it shrinks
+// towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// unless is the weight w, or zero when off: the alternatives that draw a
+// recorded bug's shape have weight unless(noKnown, w), so HEGEL_NO_KNOWN=1
+// stops drawing them without a filter.
+func unless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// shaped is the generator of a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, of the neighbouring region past it.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the texts of a list generator concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// ---------------------------------------------------------------------------
+// The oracles: child processes speaking one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+var (
+	nodeOnce sync.Once
+	node     *oracle
+	pyOnce   sync.Once
+	py       *oracle
+)
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one request and returns the answer object, or an error when
+// the oracle is unusable (which is a harness failure, not a finding).
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %q: %v", o.name, resp, err)
+	}
+	return m, nil
+}
+
+func nodeOracle() *oracle {
+	nodeOnce.Do(func() { node = startOracle("node", "node", "idna-oracle.cjs") })
+	return node
+}
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("python idna", "python3", "-u", "idna-oracle.py") })
+	return py
+}
+
+// verdict is an oracle's answer: ok and the output, or not ok and the
+// oracle's reason.
+type verdict struct {
+	ok  bool
+	out string
+}
+
+func (v verdict) String() string {
+	if v.ok {
+		return fmt.Sprintf("ok %q", v.out)
+	}
+	return fmt.Sprintf("error (%s)", v.out)
+}
+
+func ask(t testing.TB, o *oracle, req map[string]any) verdict {
+	m, err := o.call(req)
+	if err != nil {
+		t.Fatalf("%s oracle: %v", o.name, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		t.Fatalf("%s oracle failed on %v: %v", o.name, req, e)
+	}
+	ok, _ := m["ok"].(bool)
+	out, _ := m["out"].(string)
+	return verdict{ok, out}
+}
+
+// whatwgASCII and whatwgUnicode are node's url.domainToASCII and
+// url.domainToUnicode.
+func whatwgASCII(t testing.TB, s string) verdict {
+	return ask(t, nodeOracle(), map[string]any{"op": "ascii", "s": s})
+}
+
+func whatwgUnicode(t testing.TB, s string) verdict {
+	return ask(t, nodeOracle(), map[string]any{"op": "unicode", "s": s})
+}
+
+// idna2008Encode and idna2008Decode are python's idna.encode and
+// idna.decode with strict label separators and no UTS #46 mapping.
+func idna2008Encode(t testing.TB, s string) verdict {
+	return ask(t, pyOracle(), map[string]any{"op": "encode", "s": s})
+}
+
+func idna2008Decode(t testing.TB, s string) verdict {
+	return ask(t, pyOracle(), map[string]any{"op": "decode", "s": s})
+}
+
+// pyPunycode and pyUnpunycode are python's punycode codec on one label
+// (without the xn-- prefix).
+func pyPunycode(t testing.TB, s string) verdict {
+	return ask(t, pyOracle(), map[string]any{"op": "punycode", "s": s})
+}
+
+func pyUnpunycode(t testing.TB, s string) verdict {
+	return ask(t, pyOracle(), map[string]any{"op": "unpunycode", "s": s})
+}
+
+// goVerdict turns an x/net/idna result into a verdict.
+func goVerdict(s string, err error) verdict {
+	if err != nil {
+		return verdict{false, err.Error() + " (partial result " + strconv.Quote(s) + ")"}
+	}
+	return verdict{true, s}
+}
diff --git a/idna/hegel/idna-oracle.cjs b/idna/hegel/idna-oracle.cjs
new file mode 100644
index 0000000..31b9171
--- /dev/null
+++ b/idna/hegel/idna-oracle.cjs
@@ -0,0 +1,31 @@
+// The WHATWG oracle for x/net/idna: node's url.domainToASCII and
+// url.domainToUnicode, which are the URL standard's "domain to ASCII" and
+// "domain to Unicode" (UTS #46 with CheckHyphens=false, CheckBidi=true,
+// CheckJoiners=true, UseSTD3ASCIIRules=false, Transitional_Processing=false,
+// VerifyDnsLength=false) as implemented by ada. Both return "" on failure.
+//
+// One JSON object per line on stdin: {"op": "ascii" | "unicode", "s": "..."};
+// one per line on stdout: {"ok": bool, "out": "..."}.
+"use strict";
+const readline = require("readline");
+const url = require("url");
+
+const rl = readline.createInterface({ input: process.stdin, terminal: false });
+rl.on("line", (line) => {
+  let resp;
+  try {
+    const req = JSON.parse(line);
+    let out;
+    if (req.op === "ascii") {
+      out = url.domainToASCII(req.s);
+    } else if (req.op === "unicode") {
+      out = url.domainToUnicode(req.s);
+    } else {
+      throw new Error("unknown op " + req.op);
+    }
+    resp = { ok: out !== "", out };
+  } catch (e) {
+    resp = { error: String(e && e.message ? e.message : e) };
+  }
+  process.stdout.write(JSON.stringify(resp) + "\n");
+});
diff --git a/idna/hegel/idna-oracle.py b/idna/hegel/idna-oracle.py
new file mode 100644
index 0000000..7b8a482
--- /dev/null
+++ b/idna/hegel/idna-oracle.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""The IDNA2008 oracle for x/net/idna: the python idna package (RFC 5891
+registration rules: no mapping, NFC, hyphens, joiners, contextual rules,
+bidi, label and name lengths), and python's punycode codec for single labels.
+
+One JSON object per line on stdin:
+  {"op": "encode", "s": "...", "uts46": bool}  -> idna.encode
+  {"op": "decode", "s": "..."}                 -> idna.decode
+  {"op": "punycode", "s": "..."}               -> s.encode("punycode")
+  {"op": "unpunycode", "s": "..."}             -> s.decode("punycode")
+One per line on stdout: {"ok": bool, "out": "..."}; "out" is the error's
+class and message when ok is false.
+"""
+import json
+import sys
+
+import idna
+
+
+def handle(req):
+    op = req["op"]
+    s = req["s"]
+    try:
+        if op == "encode":
+            out = idna.encode(s, strict=True, uts46=bool(req.get("uts46")), std3_rules=bool(req.get("std3")))
+            return {"ok": True, "out": out.decode("ascii")}
+        if op == "decode":
+            return {"ok": True, "out": idna.decode(s, strict=True, uts46=bool(req.get("uts46")), std3_rules=bool(req.get("std3")))}
+        if op == "punycode":
+            return {"ok": True, "out": s.encode("punycode").decode("ascii")}
+        if op == "unpunycode":
+            return {"ok": True, "out": s.encode("ascii").decode("punycode")}
+        return {"error": "unknown op %r" % op}
+    except Exception as e:  # noqa: BLE001 - every failure is the oracle's opinion
+        return {"ok": False, "out": "%s: %s" % (type(e).__name__, e)}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            resp = handle(json.loads(line))
+        except Exception as e:  # noqa: BLE001
+            resp = {"error": str(e)}
+        sys.stdout.write(json.dumps(resp) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/idna/hegel/known.go b/idna/hegel/known.go
new file mode 100644
index 0000000..40fe73a
--- /dev/null
+++ b/idna/hegel/known.go
@@ -0,0 +1,356 @@
+package hegel
+
+// Gates: version skew between the three sides, shapes an oracle cannot
+// judge, and known bugs of x/net/idna (ids from the zoo's bugs.toml). By
+// default the generators draw the bugs' shapes and a mismatch a classifier
+// names with a bug id fails naming the bug: the property that found a bug
+// is its expected failure, mapped to the bug, and the pin in
+// hegel_pins_test.go is the regression example (STYLE.md rule 11).
+// HEGEL_NO_KNOWN=1 switches the known shapes off, for a run that looks past
+// the known bugs: the generators stop drawing the shapes and a mismatch the
+// classifier still explains is counted as the known bug. An answer starting
+// with "!" is a shape the oracle has no opinion on in either mode.
+
+import (
+	"os"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/net/idna"
+	"golang.org/x/text/unicode/bidi"
+)
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs, read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// age is the Unicode version a rune was assigned in when that is 16.0 or
+// later, "" otherwise.
+func age(r rune) string {
+	for _, a := range youngRunes {
+		if a.lo <= r && r <= a.hi {
+			return a.age
+		}
+	}
+	return ""
+}
+
+// youngest is the highest age of the runes of s among 16.0, 17.0, 18.0,
+// or "".
+func youngest(s string) string {
+	best := ""
+	for _, r := range s {
+		if a := age(r); a > best {
+			best = a
+		}
+	}
+	return best
+}
+
+// hasChangedStatus reports whether a rune of s has a UTS #46 status or
+// mapping in Unicode 18.0 other than in 15.1 (changed.go).
+func hasChangedStatus(s string) bool {
+	for _, r := range s {
+		for _, a := range changedSince151 {
+			if a.lo <= r && r <= a.hi {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// isNV8 reports whether r is valid under UTS #46 but not under IDNA2008.
+func isNV8(r rune) bool {
+	for _, a := range nv8Runes {
+		if a.lo <= r && r <= a.hi {
+			return true
+		}
+	}
+	return false
+}
+
+func hasNV8(s string) bool {
+	for _, r := range s {
+		if isNV8(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasRTL reports whether s holds a right-to-left rune (bidi class R, AL or
+// AN), which makes a name a Bidi domain name under RFC 5893.
+func hasRTL(s string) bool {
+	for _, r := range s {
+		p, _ := bidi.LookupRune(r)
+		switch p.Class() {
+		case bidi.R, bidi.AL, bidi.AN:
+			return true
+		}
+	}
+	return false
+}
+
+// hasUpperASCII reports whether s holds A-Z.
+func hasUpperASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if 'A' <= s[i] && s[i] <= 'Z' {
+			return true
+		}
+	}
+	return false
+}
+
+// forbiddenHost reports whether s holds a forbidden domain code point of
+// the URL standard (checked by node on the ASCII form; x/net/idna without
+// STD3 rules lets them through).
+func forbiddenHost(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c <= 0x20 || c == 0x7f || strings.IndexByte("#/:<>?@[\\]^|%", c) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// endsInANumber is the URL standard's test that sends a host to the IPv4
+// parser: the last label (a trailing empty one dropped) is all ASCII
+// digits, or 0x followed by hex digits.
+func endsInANumber(s string) bool {
+	labels := strings.Split(s, ".")
+	if len(labels) > 1 && labels[len(labels)-1] == "" {
+		labels = labels[:len(labels)-1]
+	}
+	last := labels[len(labels)-1]
+	if last == "" {
+		return false
+	}
+	digits := true
+	for i := 0; i < len(last); i++ {
+		if last[i] < '0' || last[i] > '9' {
+			digits = false
+		}
+	}
+	if digits {
+		return true
+	}
+	if len(last) >= 2 && last[0] == '0' && (last[1] == 'x' || last[1] == 'X') {
+		for i := 2; i < len(last); i++ {
+			if !strings.ContainsRune("0123456789abcdefABCDEF", rune(last[i])) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hasContextO reports whether s holds a rune under an IDNA2008 contextual
+// rule x/net/idna does not implement (CONTEXTO: RFC 5892 appendix A.3-A.9).
+func hasContextO(s string) bool {
+	return strings.ContainsAny(s, "·͵׳״・٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹")
+}
+
+// aceStartsWithDelimiter reports whether a label of s is an ACE label whose
+// Punycode starts with the delimiter ("xn---...").
+func aceStartsWithDelimiter(s string) bool {
+	for _, l := range asciiLabels(s) {
+		if strings.HasPrefix(l, "xn---") {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyACE reports whether a label of s is the bare ACE prefix (after
+// case folding and the dots UTS #46 maps to U+002E).
+func hasEmptyACE(s string) bool {
+	for _, l := range asciiLabels(s) {
+		if l == "xn--" {
+			return true
+		}
+	}
+	return false
+}
+
+// urlSyntax reports whether s holds ASCII the URL parser acts on before
+// the host reaches "domain to ASCII": C0 controls, space and DEL (stripped
+// or removed), the delimiters / ? # \ @ : [ ], and % (percent-decoding).
+func urlSyntax(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c <= 0x20 || c == 0x7f || strings.IndexByte("/?#\\@:[]%", c) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// whatwgProfile is the URL standard's "domain to ASCII" with beStrict
+// false, as x/net/idna options: UTS #46 lookup mapping, CheckBidi and
+// CheckJoiners on, CheckHyphens, UseSTD3ASCIIRules and VerifyDnsLength off,
+// non-transitional.
+var whatwgProfile = idna.New(
+	idna.MapForLookup(),
+	idna.BidiRule(),
+	idna.Transitional(false),
+	idna.StrictDomainName(false),
+	idna.CheckHyphens(false),
+	idna.VerifyDNSLength(false),
+)
+
+// asciiLabels lower-cases s, turns the dots UTS #46 maps to U+002E into
+// dots and splits into labels.
+func asciiLabels(s string) []string {
+	s = strings.ToLower(s)
+	for _, d := range separators[1:] {
+		s = strings.ReplaceAll(s, d, ".")
+	}
+	return strings.Split(s, ".")
+}
+
+// aceDecodesToLeadingMark reports whether a label of s is an ACE label that
+// decodes to a label starting with a combining mark (General_Category M).
+func aceDecodesToLeadingMark(s string) bool {
+	for _, l := range asciiLabels(s) {
+		if !strings.HasPrefix(l, "xn--") || len(l) == 4 {
+			continue
+		}
+		if u, err := idna.Punycode.ToUnicode(l); err == nil && u != "" {
+			if r, _ := utf8.DecodeRuneInString(u); unicode.Is(unicode.M, r) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// aceDecodesToASCII reports whether a label of s is an ACE label whose
+// Punycode decodes to ASCII only (x/net/idna rejects those on purpose,
+// calling the specification's silence a bug); got is x/net/idna's result,
+// which holds the decoded label when the input was rejected for it.
+func aceDecodesToASCII(s, got string) bool {
+	in, out := asciiLabels(s), strings.Split(got, ".")
+	for i, l := range in {
+		if !strings.HasPrefix(l, "xn--") || len(l) == 4 {
+			continue
+		}
+		if u, err := idna.Punycode.ToUnicode(l); err == nil && isASCII(u) {
+			return true
+		}
+		if len(out) == len(in) && out[i] != l && isASCII(out[i]) {
+			return true
+		}
+	}
+	return false
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// known holds the explanations of disagreements: by known bugs of
+// x/net/idna, or by shapes an oracle cannot judge.
+type known struct{}
+
+// Known is the set of gates.
+var Known known
+
+// explainsWHATWG explains a disagreement between x/net/idna's lookup
+// profile and node on input s (ASCII form got, or "" with an error): a
+// bug id, "!" + reason for a shape not judged, or "".
+func (known) explainsWHATWG(s, got string, goErr error) string {
+	if s == "" {
+		return "!empty name (no host to the URL parser)"
+	}
+	// The Unicode form (ACE labels decoded), as far as x/net/idna gets.
+	u, _ := whatwgProfile.ToUnicode(s)
+	if hasChangedStatus(s) || hasChangedStatus(u) {
+		return "!rune whose UTS #46 status changed since Unicode 15.1 (node's version)"
+	}
+	if strings.ContainsRune(s, 0x1E9E) {
+		// Since Unicode 15.1 the table maps U+1E9E to U+00DF, a deviation
+		// kept by non-transitional processing; ada still maps it to ss.
+		return "!U+1E9E (node maps it to ss, as tables before Unicode 15.1 did)"
+	}
+	if goErr != nil && aceStartsWithDelimiter(s) {
+		// RFC 3492 6.2: with no basic code points before the last delimiter,
+		// the delimiter is not consumed and is not a digit; ada consumes it.
+		return "!ACE label starting with a delimiter (RFC 3492 6.2; node consumes it)"
+	}
+	if goErr == nil && hasEmptyACE(s) {
+		// Before the empty result: the bare prefix alone is the bug's shape
+		// (the pin's first case).
+		return "x-net/13"
+	}
+	if goErr == nil && got == "" {
+		return "!empty after mapping (no host to the URL parser)"
+	}
+	if goErr != nil && aceDecodesToASCII(s, got) {
+		return "!ACE label decoding to ASCII (x/net/idna rejects it on purpose)"
+	}
+	if goErr != nil && aceDecodesToLeadingMark(s) {
+		// UTS #46 validity criterion 5 (a label must not begin with a
+		// combining mark) applies to a decoded ACE label too; x/net/idna and
+		// python idna reject "xn--wzb" (U+08CA, Mn), ada accepts it.
+		return "!ACE label decoding to a leading combining mark (UTS #46 rejects it; node does not)"
+	}
+	if goErr != nil && (hasRTL(s) || hasRTL(u)) {
+		// x/net/idna applies the Bidi rule (CheckBidi) to Bidi domain
+		// names; node's ada does not.
+		return "!Bidi domain name rejected (node does not apply the Bidi rule)"
+	}
+	return ""
+}
+
+// explainsRegistration explains a disagreement between idna.Registration
+// and python idna on input s, python's answer being want.
+func (known) explainsRegistration(s, got string, goErr error, want verdict) string {
+	if a := youngest(s); a == "18.0" {
+		return "!rune from Unicode 18.0 (x/net/idna is at 17.0)"
+	}
+	u, _ := idna.Registration.ToUnicode(s)
+	if goErr == nil && (hasNV8(s) || hasNV8(u)) {
+		return "x-net/14"
+	}
+	if goErr == nil && !want.ok && strings.Contains(want.out, "InvalidCodepointContext") && (hasContextO(s) || hasContextO(u)) {
+		return "x-net/15"
+	}
+	if !want.ok && strings.Contains(want.out, "Unknown directionality") {
+		return "!rune unknown to python's unicodedata"
+	}
+	if goErr != nil && hasUpperASCII(s) {
+		// The profile applies no mapping, so A-Z are disallowed runes to
+		// it; python accepts an ASCII label as DNS does.
+		return "!upper case ASCII (the registration profile maps nothing)"
+	}
+	if goErr != nil && strings.HasSuffix(s, ".") {
+		// VerifyDnsLength rejects an empty root label since Unicode 16;
+		// RFC 5891 has no such rule.
+		return "!trailing dot (a VerifyDnsLength error in UTS #46 since Unicode 16)"
+	}
+	if goErr != nil && (hasRTL(s) || hasRTL(u)) {
+		// python idna applies the Bidi rule label by label, so an LTR label
+		// of a Bidi domain name is not checked.
+		return "!Bidi domain name rejected (python idna checks the Bidi rule per label)"
+	}
+	return ""
+}
+
+// explainsPunycode explains a disagreement between idna.Punycode and
+// python's punycode codec on label s.
+func (known) explainsPunycode(s string) string {
+	if strings.ContainsRune(s, 0xFFFD) {
+		// UTS #46 since Unicode 16 has U+FFFD fail the Punycode encoding;
+		// python's codec encodes it like any other rune.
+		return "!U+FFFD (x/net/idna's encoder refuses it since Unicode 16)"
+	}
+	return ""
+}
