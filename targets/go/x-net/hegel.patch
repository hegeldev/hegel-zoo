+// explainsRenderError (x-net/6): Render refuses a foreign element that has
+// the name of an HTML void element and children.
+func (known) explainsRenderError(doc *html.Node, err error) string {
+	if !strings.Contains(err.Error(), "void element") {
+		return ""
+	}
+	found := false
+	var walk func(nd *html.Node)
+	walk = func(nd *html.Node) {
+		for c := nd.FirstChild; c != nil && !found; c = c.NextSibling {
+			if c.Type == html.ElementNode && c.Namespace != "" && c.FirstChild != nil && voidNames[c.Data] {
+				found = true
+				return
+			}
+			walk(c)
+		}
