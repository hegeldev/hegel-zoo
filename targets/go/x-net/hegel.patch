+++ b/idna/hegel/idna-oracle.cjs
@@ -0,0 +1,31 @@
+// The WHATWG oracle for x/net/idna: node's url.domainToASCII and
+// url.domainToUnicode, which are the URL standard's "domain to ASCII" and
+// "domain to Unicode" (UTS #46 with CheckHyphens=false, CheckBidi=true,
+// CheckJoiners=true, UseSTD3ASCIIRules=false, Transitional_Processing=false,
+// VerifyDnsLength=false) as implemented by ada. Both return "" on failure.
+//
+// One JSON object per line on stdin: {"op": "ascii" | "unicode", "s": "..."};
+// one per line on stdout: {"ok": bool, "out": "..."}.
+"use strict";
+const readline = require("readline");
+const url = require("url");
+
+const rl = readline.createInterface({ input: process.stdin, terminal: false });
+rl.on("line", (line) => {
+  let resp;
+  try {
+    const req = JSON.parse(line);
+    let out;
+    if (req.op === "ascii") {
+      out = url.domainToASCII(req.s);
+    } else if (req.op === "unicode") {
+      out = url.domainToUnicode(req.s);
+    } else {
+      throw new Error("unknown op " + req.op);
+    }
+    resp = { ok: out !== "", out };
+  } catch (e) {
+    resp = { error: String(e && e.message ? e.message : e) };
+  }
+  process.stdout.write(JSON.stringify(resp) + "\n");
+});
