diff --git a/idna/hegel/hegel_gauge_test.go b/idna/hegel/hegel_gauge_test.go
new file mode 100644
index 0000000..0cb9334
--- /dev/null
+++ b/idna/hegel/hegel_gauge_test.go
@@ -0,0 +1,136 @@
+package hegel
+
+// The gauge: the properties' comparisons run over the inputs of Unicode's
+// IdnaTestV2.txt (path in HEGEL_IDNA_TESTS), to see where each oracle and
+// x/net/idna part ways on the conformance suite's cases before trusting
+// the vote on generated ones. Not a property.
+
+import (
+	"bufio"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/idna"
+)
+
+// unescapeIdnaTest decodes the \uXXXX and \x{XXXX} escapes of the file.
+func unescapeIdnaTest(s string) string {
+	if !strings.Contains(s, "\\") {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		if s[i] == '\\' && i+1 < len(s) {
+			switch s[i+1] {
+			case 'u':
+				if i+6 <= len(s) {
+					if v, err := strconv.ParseUint(s[i+2:i+6], 16, 32); err == nil {
+						b.WriteRune(rune(v))
+						i += 6
+						continue
+					}
+				}
+			case 'x':
+				if i+2 < len(s) && s[i+2] == '{' {
+					if j := strings.IndexByte(s[i:], '}'); j > 0 {
+						if v, err := strconv.ParseUint(s[i+3:i+j], 16, 32); err == nil {
+							b.WriteRune(rune(v))
+							i += j + 1
+							continue
+						}
+					}
+				}
+			}
+		}
+		b.WriteByte(s[i])
+		i++
+	}
+	return b.String()
+}
+
+func TestHegelGaugeIdnaTestV2(t *testing.T) {
+	path := os.Getenv("HEGEL_IDNA_TESTS")
+	if path == "" {
+		t.Skip("set HEGEL_IDNA_TESTS to the path of IdnaTestV2.txt to gauge the oracles")
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	var total, whatwgAgree, whatwgKnown, whatwgSkipped, whatwgDiffer, regAgree, regKnown, regSkipped, regDiffer int
+	shown := map[string]int{}
+	show := func(kind, msg string) {
+		if shown[kind] < 100 {
+			t.Logf("%s: %s", kind, msg)
+		}
+		shown[kind]++
+	}
+	tally := map[string]int{}
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		fields := strings.Split(line, ";")
+		if len(fields) < 2 {
+			continue
+		}
+		s := unescapeIdnaTest(strings.TrimSpace(fields[0]))
+		total++
+		// WHATWG.
+		a, err := whatwgProfile.ToASCII(s)
+		got := goVerdict(a, err)
+		switch {
+		case urlSyntax(s), err == nil && endsInANumber(a), err == nil && forbiddenHost(a):
+			// Shapes the property does not judge.
+			whatwgSkipped++
+		default:
+			want := whatwgASCII(t, s)
+			if got.ok == want.ok && (!got.ok || got.out == want.out) {
+				whatwgAgree++
+			} else if e := Known.explainsWHATWG(s, a, err); e == "" {
+				whatwgDiffer++
+				show("WHATWG", "ToASCII of "+strconv.Quote(s)+" ("+runesOf(s)+"): x/net/idna "+got.String()+", node "+want.String())
+			} else {
+				tally["WHATWG "+e]++
+				if strings.HasPrefix(e, "!") {
+					whatwgSkipped++
+				} else {
+					whatwgKnown++
+				}
+			}
+		}
+		// Registration.
+		a, err = idna.Registration.ToASCII(s)
+		got = goVerdict(a, err)
+		want := idna2008Encode(t, s)
+		if got.ok == want.ok && (!got.ok || got.out == want.out) {
+			regAgree++
+		} else if e := Known.explainsRegistration(s, a, err, want); e == "" {
+			regDiffer++
+			show("REGISTRATION", "ToASCII of "+strconv.Quote(s)+" ("+runesOf(s)+"): x/net/idna "+got.String()+", python idna "+want.String())
+		} else {
+			tally["REGISTRATION "+e]++
+			if strings.HasPrefix(e, "!") {
+				regSkipped++
+			} else {
+				regKnown++
+			}
+		}
+	}
+	keys := make([]string, 0, len(tally))
+	for k := range tally {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		t.Logf("TALLY %s: %d", k, tally[k])
+	}
+	t.Logf("GAUGE %d cases: WHATWG agree %d, known bugs %d, not judged %d, differ %d; registration agree %d, known bugs %d, not judged %d, differ %d",
+		total, whatwgAgree, whatwgKnown, whatwgSkipped, whatwgDiffer, regAgree, regKnown, regSkipped, regDiffer)
+}
diff --git a/idna/hegel/hegel_gen_test.go b/idna/hegel/hegel_gen_test.go
