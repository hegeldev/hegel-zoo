+	lines := strings.Split(dat, "\n")
+	var out []string
+	lastText := -1 // index in out of the line ending the previous text node
+	lastIndent := ""
+	inText := false
+	for _, l := range lines {
+		if inText {
+			out = append(out, l)
+			if strings.HasSuffix(l, `"`) {
+				inText = false
+				lastText = len(out) - 1
+			}
+			continue
+		}
+		trimmed := strings.TrimLeft(l, "| ")
+		indent := l[:len(l)-len(trimmed)]
+		if strings.HasPrefix(trimmed, `"`) {
+			body := trimmed[1:]
+			if lastText >= 0 && lastText == len(out)-1 && indent == lastIndent {
+				out[lastText] = strings.TrimSuffix(out[lastText], `"`) + body
+			} else {
+				out = append(out, l)
+			}
+			lastIndent = indent
+			if len(body) > 0 && strings.HasSuffix(body, `"`) {
+				lastText = len(out) - 1
+			} else {
+				inText = true
+			}
+			continue
+		}
+		lastText = -1
+		out = append(out, l)
+	}
+	return strings.Join(out, "\n")
