+++ b/idna/hegel/idna-oracle.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""The IDNA2008 oracle for x/net/idna: the python idna package (RFC 5891
+registration rules: no mapping, NFC, hyphens, joiners, contextual rules,
+bidi, label and name lengths), and python's punycode codec for single labels.
+
+One JSON object per line on stdin:
+  {"op": "encode", "s": "...", "uts46": bool}  -> idna.encode
+  {"op": "decode", "s": "..."}                 -> idna.decode
+  {"op": "punycode", "s": "..."}               -> s.encode("punycode")
+  {"op": "unpunycode", "s": "..."}             -> s.decode("punycode")
+One per line on stdout: {"ok": bool, "out": "..."}; "out" is the error's
+class and message when ok is false.
+"""
+import json
+import sys
+
+import idna
+
+
+def handle(req):
+    op = req["op"]
+    s = req["s"]
+    try:
+        if op == "encode":
+            out = idna.encode(s, strict=True, uts46=bool(req.get("uts46")), std3_rules=bool(req.get("std3")))
+            return {"ok": True, "out": out.decode("ascii")}
+        if op == "decode":
+            return {"ok": True, "out": idna.decode(s, strict=True, uts46=bool(req.get("uts46")), std3_rules=bool(req.get("std3")))}
+        if op == "punycode":
+            return {"ok": True, "out": s.encode("punycode").decode("ascii")}
+        if op == "unpunycode":
+            return {"ok": True, "out": s.encode("ascii").decode("punycode")}
+        return {"error": "unknown op %r" % op}
+    except Exception as e:  # noqa: BLE001 - every failure is the oracle's opinion
+        return {"ok": False, "out": "%s: %s" % (type(e).__name__, e)}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            resp = handle(json.loads(line))
+        except Exception as e:  # noqa: BLE001
+            resp = {"error": str(e)}
+        sys.stdout.write(json.dumps(resp) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/idna/hegel/known.go b/idna/hegel/known.go
