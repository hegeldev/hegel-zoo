+++ b/html/hegel/known.go
@@ -0,0 +1,366 @@
+package hegel
+
+// The bugs recorded in the zoo's bugs.toml for x-net, as predicates the
+// properties gate on: a mismatch one of these explains is counted, not
+// failed, so the properties stay green while the pins in hegel_pins_test.go
+// keep failing until the bug is fixed upstream.
+
+import (
+	"regexp"
+	"strings"
+
+	"golang.org/x/net/html"
+)
+
+// voidNames are the names Render treats as void, whatever the namespace.
+var voidNames = map[string]bool{"area": true, "base": true, "br": true, "col": true, "embed": true, "hr": true, "img": true, "input": true,
+	"keygen": true, "link": true, "meta": true, "param": true, "source": true, "track": true, "wbr": true}
+
+type known struct{}
+
+// Known answers with a bug id, or "" when nothing known explains a finding.
+var Known known
+
+// explainsTree: x/net/html's tree got against the oracles' agreed tree want.
+// An answer starting with "!" is a shape the vote has no opinion on (the
+// oracles lag the specification there, or the specification is silent).
+func (known) explainsTree(r treeReq, got, want string) string {
+	low := strings.ToLower(r.html)
+	// The 2025 select parser change (any content inside select, button and
+	// datalist in select): x/net/html and html5lib-tests have it, parse5 8
+	// and html5lib 1.1 have the old rules.
+	if strings.Contains(low, "<select") {
+		return "!select rules (the oracles predate the 2025 change)"
+	}
+	switch r.fragment {
+	case "select", "option", "optgroup", "datalist":
+		return "!select rules (the oracles predate the 2025 change)"
+	case "head":
+		// The head context pops the root element: the specification leaves
+		// the stack empty and the implementations part ways.
+		return "!head fragment context (unspecified)"
+	}
+	// Four or more start tags of one formatting element: the Noah's Ark
+	// clause drops the first from the list of active formatting elements,
+	// and the adoption agency's step 2 (the current node has the tag name
+	// and is not in the list: pop it and stop) then applies to an end tag
+	// closing it. x/net/html follows the current specification there; the
+	// oracles (parse5 8, html5lib 1.1) do not have step 2.
+	if noahsArk(low) {
+		return "!Noah's Ark and the adoption agency's step 2 (the oracles lack it)"
+	}
+	// x-net/8: the "in head noscript" (scripting off) and "in column group"
+	// modes handle a text token as a whole, so one that mixes whitespace and
+	// other characters has its whitespace misplaced or dropped.
+	if (!r.scripting && strings.Contains(low, "<noscript")) || r.fragment == "colgroup" {
+		return "x-net/8"
+	}
+	// x-net/5: a raw text, RCDATA or plaintext start tag the frameset
+	// insertion modes ignore still switches the tokenizer, so what follows
+	// is swallowed as text (which those modes drop) instead of being
+	// tokenized.
+	if (strings.Contains(low, "<frameset") || r.fragment == "frameset") && rawTextTag.MatchString(low) {
+		return "x-net/5"
+	}
+	// x-net/10: in a fragment whose context is a raw text or RCDATA element,
+	// an end tag of the context's name ends the text although no start tag
+	// was emitted (the tokenizer's "appropriate end tag" rule).
+	switch r.fragment {
+	case "title", "textarea", "script", "style", "xmp", "iframe", "noembed", "noframes", "plaintext":
+		if strings.Contains(low, "</"+r.fragment) {
+			return "x-net/10"
+		}
+	case "noscript":
+		if r.scripting && strings.Contains(low, "</noscript") {
+			return "x-net/10"
+		}
+	}
+	// x-net/11: a carriage return from a character reference right after a
+	// pre, listing or textarea start tag is dropped like a newline.
+	if crAfterPre.MatchString(low) {
+		return "x-net/11"
+	}
+	// x-net/12: an attribute name holding a NUL is checked for duplicates
+	// before the NUL becomes U+FFFD.
+	if nulBesideReplacement(r.html) {
+		return "x-net/12"
+	}
+	w := decodeComments(want)
+	if got == w {
+		return "x-net/1"
+	}
+	g := got
+	if strings.Contains(g, "\x00") {
+		g = doctypeNulToReplacement(g)
+		if g == w {
+			return "x-net/2"
+		}
+	}
+	if strings.Contains(r.html, "</>") {
+		g = mergeTextLines(dropEmptyCommentLines(g))
+		if g == mergeTextLines(dropEmptyCommentLines(w)) {
+			return "x-net/3"
+		}
+	}
+	if strings.Contains(r.html, "<![CDATA[") && (strings.Contains(low, "<svg") || strings.Contains(low, "<math") || strings.Contains(r.fragment, " ")) {
+		if g == decodeTexts(w) || mergeTextLines(g) == mergeTextLines(decodeTexts(w)) {
+			return "x-net/7"
+		}
+	}
+	return ""
+}
+
+// decodeComments applies UnescapeString to the comment data of a .dat dump
+// (x-net/1: x/net/html decodes character references inside comments).
+func decodeComments(dat string) string { return decodeNodes(dat, "<!-- ", " -->\n") }
+
+// decodeTexts applies UnescapeString to the text nodes of a .dat dump
+// (x-net/7: character references inside a CDATA section are decoded).
+func decodeTexts(dat string) string { return decodeNodes(dat, `"`, "\"\n") }
+
+// decodeNodes unescapes the data of every node printed as open...close at
+// the start of a dump line.
+func decodeNodes(dat, open, close string) string {
+	var b strings.Builder
+	rest := dat
+	for {
+		i := strings.Index(rest, open)
+		if i < 0 {
+			break
+		}
+		if !atLineStart(rest, i) {
+			b.WriteString(rest[:i+len(open)])
+			rest = rest[i+len(open):]
+			continue
+		}
+		j := strings.Index(rest[i+len(open):], close)
+		if j < 0 {
+			break
+		}
+		b.WriteString(rest[:i+len(open)])
+		b.WriteString(html.UnescapeString(rest[i+len(open) : i+len(open)+j]))
+		rest = rest[i+len(open)+j:]
+	}
+	b.WriteString(rest)
+	return b.String()
+}
+
+// mergeTextLines joins adjacent text nodes at the same depth (x-net/3: the
+// phantom comment splits a text node in two).
+func mergeTextLines(dat string) string {
+	lines := strings.Split(dat, "\n")
+	var out []string
+	lastText := -1 // index in out of the line ending the previous text node
+	lastIndent := ""
+	inText := false
+	for _, l := range lines {
+		if inText {
+			out = append(out, l)
+			if strings.HasSuffix(l, `"`) {
+				inText = false
+				lastText = len(out) - 1
+			}
+			continue
+		}
+		trimmed := strings.TrimLeft(l, "| ")
+		indent := l[:len(l)-len(trimmed)]
+		if strings.HasPrefix(trimmed, `"`) {
+			body := trimmed[1:]
+			if lastText >= 0 && lastText == len(out)-1 && indent == lastIndent {
+				out[lastText] = strings.TrimSuffix(out[lastText], `"`) + body
+			} else {
+				out = append(out, l)
+			}
+			lastIndent = indent
+			if len(body) > 0 && strings.HasSuffix(body, `"`) {
+				lastText = len(out) - 1
+			} else {
+				inText = true
+			}
+			continue
+		}
+		lastText = -1
+		out = append(out, l)
+	}
+	return strings.Join(out, "\n")
+}
+
+// atLineStart: the "<!-- " at i follows the "| " indentation of a dump line.
+func atLineStart(s string, i int) bool {
+	k := i
+	for k > 0 && s[k-1] == ' ' {
+		k--
+	}
+	return k > 0 && s[k-1] == '|' && (k == 1 || s[k-2] == '\n')
+}
+
+// doctypeNulToReplacement (x-net/2): NUL kept in a doctype's name or ids.
+func doctypeNulToReplacement(dat string) string {
+	lines := strings.Split(dat, "\n")
+	for i, l := range lines {
+		if strings.HasPrefix(l, "| <!DOCTYPE") {
+			lines[i] = strings.ReplaceAll(l, "\x00", "�")
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+// dropEmptyCommentLines (x-net/3): the empty comment "</>" leaves behind.
+func dropEmptyCommentLines(dat string) string {
+	lines := strings.Split(dat, "\n")
+	out := lines[:0]
+	for _, l := range lines {
+		if strings.TrimLeft(l, "| ") == "<!--  -->" {
+			continue
+		}
+		out = append(out, l)
+	}
+	return strings.Join(out, "\n")
+}
+
+var formattingStart = regexp.MustCompile(`<(a|b|big|code|em|font|i|nobr|s|small|strike|strong|tt|u)[\s/>]`)
+
+// noahsArk: four or more start tags of the same formatting element.
+func noahsArk(low string) bool {
+	counts := map[string]int{}
+	for _, m := range formattingStart.FindAllStringSubmatch(low, -1) {
+		counts[m[1]]++
+		if counts[m[1]] >= 4 {
+			return true
+		}
+	}
+	return false
+}
+
+var crAfterPre = regexp.MustCompile(`<(pre|listing|textarea)[^>]*>&#(x0*d|0*13);?`)
+
+var rawTextTag = regexp.MustCompile(`<(script|style|xmp|iframe|noembed|noframes|textarea|title|plaintext|noscript)[\s/>]`)
+
+// explainsRenderError (x-net/6): Render refuses a foreign element that has
+// the name of an HTML void element and children.
+func (known) explainsRenderError(doc *html.Node, err error) string {
+	if !strings.Contains(err.Error(), "void element") {
+		return ""
+	}
+	found := false
+	var walk func(nd *html.Node)
+	walk = func(nd *html.Node) {
+		for c := nd.FirstChild; c != nil && !found; c = c.NextSibling {
+			if c.Type == html.ElementNode && c.Namespace != "" && c.FirstChild != nil && voidNames[c.Data] {
+				found = true
+				return
+			}
+			walk(c)
+		}
+	}
+	walk(doc)
+	if found {
+		return "x-net/6"
+	}
+	return ""
+}
+
+// crashesFragment (x-net/4): content after </html> in a foreign fragment
+// context dereferences a nil pointer.
+func (known) crashesFragment(r treeReq) bool {
+	return strings.Contains(r.fragment, " ") && strings.Contains(strings.ToLower(r.html), "</html")
+}
+
+// explainsUnescape: UnescapeString(s) = got against the agreed want.
+func (known) explainsUnescape(s, got, want string) string {
+	return ""
+}
+
+// explainsRoundTrip: a rendered document that parsed differently.
+func (known) explainsRoundTrip(input, rendered, got, got1 string) string {
+	// A carriage return can only reach comment data through a decoded
+	// &#13; (x-net/1); rendered raw, it comes back as a newline.
+	if strings.Contains(got, "\r") {
+		return "x-net/1"
+	}
+	// x-net/9: the text of a raw text element under a MathML text
+	// integration point (mi, mo, mn, ms, mtext) is rendered escaped.
+	if strings.Contains(strings.ToLower(input), "<math") && rawTextTag.MatchString(strings.ToLower(input)) {
+		return "x-net/9"
+	}
+	// x-net/12: two attributes named U+FFFD (one from a NUL) survive the
+	// parse; the rendering loses the second.
+	if nulBesideReplacement(input) {
+		return "x-net/12"
+	}
+	return ""
+}
+
+// nulBesideReplacement: the input holds both a NUL and a U+FFFD, the shape
+// in which x-net/12 shows (attribute names compared before NUL replacement).
+func nulBesideReplacement(input string) bool {
+	return strings.Contains(input, "\x00") && strings.Contains(input, "�")
+}
+
+// notWellFormed names the reason a parsed tree is one Render does not promise
+// to round-trip (its documentation's own examples and x/net/html's render
+// test exclusions): an element inside an element of its own name where the
+// content model forbids that (a, nobr, form, button, table, select, ...),
+// a plaintext element, raw text that holds its own end tag or a script
+// escape, text or comments directly under html or a table structure.
+func notWellFormed(doc *html.Node) string {
+	var why string
+	var walk func(nd *html.Node, open map[string]int)
+	walk = func(nd *html.Node, open map[string]int) {
+		if why != "" {
+			return
+		}
+		for c := nd.FirstChild; c != nil; c = c.NextSibling {
+			switch c.Type {
+			case html.TextNode:
+				if nd.Type == html.ElementNode && nd.Namespace == "" {
+					switch nd.Data {
+					case "html", "table", "tbody", "thead", "tfoot", "tr", "colgroup", "select", "optgroup", "frameset", "head":
+						if strings.TrimLeft(c.Data, " \t\n\f\r") != "" {
+							why = "text under " + nd.Data
+							return
+						}
+					}
+				}
+			case html.ElementNode:
+				if c.Namespace == "" {
+					switch c.Data {
+					case "plaintext":
+						why = "plaintext"
+						return
+					case "a", "nobr", "form", "button", "table", "select", "option", "label", "li", "dd", "dt", "p", "tr", "td", "th", "caption", "colgroup", "head", "body", "html", "h1", "h2", "h3", "h4", "h5", "h6":
+						if open[c.Data] > 0 {
+							why = c.Data + " in " + c.Data
+							return
+						}
+					case "script", "style", "xmp", "iframe", "noembed", "noframes", "textarea", "title", "noscript":
+						var raw strings.Builder
+						for t := c.FirstChild; t != nil; t = t.NextSibling {
+							if t.Type == html.TextNode {
+								raw.WriteString(t.Data)
+							}
+						}
+						low := strings.ToLower(raw.String())
+						if strings.Contains(low, "</"+c.Data) {
+							why = c.Data + " holds its end tag"
+							return
+						}
+						if c.Data == "script" && strings.Contains(low, "<!--") {
+							why = "script escape"
+							return
+						}
+						if (c.Data == "textarea" || c.Data == "title") && strings.ContainsAny(raw.String(), "&<") {
+							why = c.Data + " holds & or <"
+							return
+						}
+					}
+				}
+				open[c.Data]++
+				walk(c, open)
+				open[c.Data]--
+			}
+		}
+	}
+	walk(doc, map[string]int{})
+	return why
+}
diff --git a/html/hegel/parse5-oracle.cjs b/html/hegel/parse5-oracle.cjs
new file mode 100644
index 0000000..62a8c5c
--- /dev/null
+++ b/html/hegel/parse5-oracle.cjs
@@ -0,0 +1,100 @@
+// parse5 (node) as an oracle for golang.org/x/net/html: one JSON request per stdin line, one JSON
+// answer per line.
+//
+// Request: {"html": "...", "fragment": null | "div" | "svg path", "scripting": true}
+// Answer:  {"tree": "<html5lib-tests .dat format>"} or {"error": "..."}
+// Request: {"unescape": "..."}   Answer: {"text": "..."} (the `entities` package parse5 depends on,
+// in text mode: the specification's character reference algorithm, legacy names included)
+//
+// The tree is printed in the .dat format of html5lib-tests, the format x/net/html's own test
+// dump prints: element namespaces as "svg "/"math ", attributes sorted by name and prefixed with
+// their prefix (xlink, xml, xmlns) after adjustment, template contents under "content".
+
+"use strict";
+
+const parse5 = require("parse5");
+const entities = require("entities");
+const readline = require("node:readline");
+
+const ta = parse5.defaultTreeAdapter;
+const NS_SVG = "http://www.w3.org/2000/svg";
+const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+const NS_HTML = "http://www.w3.org/1999/xhtml";
+
+function indentOf(indent) {
+  return "|".padEnd(indent + 2, " ");
+}
+
+function nsPrefix(element) {
+  const ns = ta.getNamespaceURI(element);
+  return ns === NS_SVG ? "svg " : ns === NS_MATHML ? "math " : "";
+}
+
+function nodeList(nodes, indent) {
+  let out = "";
+  for (let node of nodes) {
+    out += indentOf(indent);
+    if (ta.isCommentNode(node)) {
+      out += `<!-- ${ta.getCommentNodeContent(node)} -->\n`;
+    } else if (ta.isTextNode(node)) {
+      out += `"${ta.getTextNodeContent(node)}"\n`;
+    } else if (ta.isDocumentTypeNode(node)) {
+      const publicId = ta.getDocumentTypeNodePublicId(node);
+      const systemId = ta.getDocumentTypeNodeSystemId(node);
+      out += `<!DOCTYPE ${ta.getDocumentTypeNodeName(node) || ""}`;
+      if (publicId || systemId) out += ` "${publicId}" "${systemId}"`;
+      out += ">\n";
+    } else {
+      const tn = ta.getTagName(node);
+      out += `<${nsPrefix(node) + tn}>\n`;
+      let childIndent = indent + 2;
+      const attrs = ta.getAttrList(node).map((attr) => {
+        let s = indentOf(childIndent);
+        if (attr.prefix) s += `${attr.prefix} `;
+        return s + `${attr.name}="${attr.value}"\n`;
+      });
+      out += attrs.sort().join("");
+      if (tn === "template" && ta.getNamespaceURI(node) === NS_HTML) {
+        out += `${indentOf(childIndent)}content\n`;
+        childIndent += 2;
+        node = ta.getTemplateContent(node);
+      }
+      out += nodeList(ta.getChildNodes(node), childIndent);
+    }
+  }
+  return out;
+}
+
+function answer(req) {
+  if (typeof req.unescape === "string") {
+    return { text: entities.decodeHTML(req.unescape) };
+  }
+  const opts = { scriptingEnabled: req.scripting !== false };
+  if (req.fragment) {
+    let ns = NS_HTML;
+    let name = req.fragment;
+    const sp = name.indexOf(" ");
+    if (sp >= 0) {
+      const p = name.slice(0, sp);
+      name = name.slice(sp + 1);
+      ns = p === "svg" ? NS_SVG : p === "math" ? NS_MATHML : NS_HTML;
+    }
+    const ctx = ta.createElement(name, ns, []);
+    const frag = parse5.parseFragment(ctx, req.html, opts);
+    return { tree: nodeList(ta.getChildNodes(frag), 0) };
+  }
+  const doc = parse5.parse(req.html, opts);
+  return { tree: nodeList(ta.getChildNodes(doc), 0) };
+}
+
+const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on("line", (line) => {
+  if (!line.trim()) return;
+  let reply;
+  try {
+    reply = answer(JSON.parse(line));
+  } catch (e) {
+    reply = { error: String(e && e.stack ? e.stack : e).slice(0, 400) };
+  }
+  process.stdout.write(JSON.stringify(reply) + "\n");
+});
