@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""html5lib (Python) as an oracle for golang.org/x/net/html: one JSON request per stdin line, one
+JSON answer per line.
+
+Request: {"html": "...", "fragment": null | "div", "scripting": true}
+Answer:  {"tree": "<html5lib-tests .dat format>"} or {"error": "..."} (foreign fragment contexts and
+anything html5lib cannot parse have no opinion).
+Request: {"unescape": "..."}   Answer: {"text": html.unescape(...)}
+
+html5lib's test serializer prints "#document" first, indents one space more than the .dat files and
+prefixes HTML-namespace elements with "html ": the answer is normalised to the .dat format
+x/net/html's own test dump prints, so the trees compare as plain strings.
+"""
+
+import html
+import json
+import sys
+
+import html5lib
+from html5lib import treebuilders
+
+TREE_BUILDER = treebuilders.getTreeBuilder("dom")
+
+
+def normalise(text):
+    lines = text.split("\n")
+    if lines and lines[0] in ("#document", "#document-fragment"):
+        lines = lines[1:]
+    out = []
+    for line in lines:
+        if line.startswith("| "):
+            line = "|" + line[2:]
+        if line.lstrip("| ").startswith("<html "):
+            line = line.replace("<html ", "<", 1)
+        out.append(line)
+    text = "\n".join(out)
+    return text + "\n" if text else ""
+
+
+def answer(req):
+    if isinstance(req.get("unescape"), str):
+        return {"text": html.unescape(req["unescape"])}
+    parser = html5lib.HTMLParser(tree=TREE_BUILDER)
+    scripting = bool(req.get("scripting", True))
+    fragment = req.get("fragment")
+    if fragment:
+        if " " in fragment:
+            return {"error": "html5lib has no foreign fragment contexts"}
+        node = parser.parseFragment(req["html"], container=fragment, scripting=scripting)
+    else:
+        node = parser.parse(req["html"], scripting=scripting)
+    return {"tree": normalise(parser.tree.testSerializer(node))}
+
+
+def main():
+    for line in sys.stdin:
+        if not line.strip():
+            continue
+        try:
+            reply = answer(json.loads(line))
+        except Exception as exc:  # noqa: BLE001 - any failure is "no opinion"
+            reply = {"error": repr(exc)[:300]}
+        sys.stdout.write(json.dumps(reply) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
