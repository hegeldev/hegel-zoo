+package hegel
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug is open
+// (listed under [expected_failures] in the zoo's target.toml).
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/html"
+)
+
+// pinTree parses input (a document, or a fragment when context is not "")
+// and compares the .dat dump with want.
+func pinTree(t *testing.T, input, context string, scripting bool, want string) {
+	t.Helper()
+	doc, err := parseTree(treeReq{html: input, fragment: context, scripting: scripting}, strings.NewReader(input))
+	if err != nil {
+		t.Fatalf("parse of %q (context %q): %v", input, context, err)
+	}
+	got, err := dump(doc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Errorf("parse of %q (context %q):\n--- got\n%s--- want\n%s", input, context, got, want)
+	}
+}
+
+func render(t *testing.T, input string) string {
+	t.Helper()
+	doc, err := html.Parse(strings.NewReader(input))
+	if err != nil {
+		t.Fatalf("parse of %q: %v", input, err)
+	}
+	var buf bytes.Buffer
+	if err := html.Render(&buf, doc); err != nil {
+		t.Fatalf("Render of the tree of %q: %v", input, err)
+	}
+	return buf.String()
+}
+
