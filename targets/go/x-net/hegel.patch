+package hegel
+
+// The gauge: how the two oracles score on the conformance suite x/net/html
+// pins (testdata/html5lib-tests and testdata/go). Not a property; run with
+// HEGEL_GAUGE=1 to see where the vote will be noisy and whose noise it is.
+// Cases where x/net/html differs from both agreeing oracles are printed:
+// those are what the properties would fail on.
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+type datCase struct {
+	text, want, context string
+	scripting           bool
+}
+
+func readDatCase(r *bufio.Reader) (*datCase, error) {
+	ta := &datCase{scripting: true}
+	line, err := r.ReadSlice('\n')
+	if err != nil {
+		return nil, err
+	}
+	var b []byte
+	if string(line) != "#data\n" {
+		return nil, fmt.Errorf(`got %q want "#data\n"`, line)
+	}
+	for {
+		line, err = r.ReadSlice('\n')
+		if err != nil {
+			return nil, err
+		}
+		if line[0] == '#' {
+			break
+		}
+		b = append(b, line...)
+	}
+	ta.text = strings.TrimSuffix(string(b), "\n")
+	b = b[:0]
+	if string(line) != "#errors\n" {
+		return nil, fmt.Errorf(`got %q want "#errors\n"`, line)
+	}
+	for {
+		line, err = r.ReadSlice('\n')
+		if err != nil {
+			return nil, err
+		}
+		if line[0] == '#' {
+			break
+		}
+	}
+	if string(line) == "#new-errors\n" {
+		for {
+			line, err = r.ReadSlice('\n')
+			if err != nil {
+				return nil, err
+			}
+			if line[0] == '#' {
+				break
+			}
+		}
+	}
+	if ls := string(line); strings.HasPrefix(ls, "#script-") {
+		ta.scripting = strings.HasSuffix(ls, "-on\n")
+		for {
+			line, err = r.ReadSlice('\n')
+			if err != nil {
+				return nil, err
+			}
+			if line[0] == '#' {
+				break
+			}
+		}
+	}
+	if string(line) == "#document-fragment\n" {
+		line, err = r.ReadSlice('\n')
+		if err != nil {
+			return nil, err
+		}
+		ta.context = strings.TrimSpace(string(line))
+		line, err = r.ReadSlice('\n')
+		if err != nil {
+			return nil, err
+		}
+	}
+	if string(line) != "#document\n" {
+		return nil, fmt.Errorf(`got %q want "#document\n"`, line)
+	}
+	inQuote := false
+	for {
+		line, err = r.ReadSlice('\n')
+		if err != nil && err != io.EOF {
+			return nil, err
+		}
+		trimmed := bytes.Trim(line, "| \n")
+		if len(trimmed) > 0 {
+			if line[0] == '|' && trimmed[0] == '"' {
+				inQuote = true
+			}
+			if trimmed[len(trimmed)-1] == '"' && !(line[0] == '|' && len(trimmed) == 1) {
+				inQuote = false
+			}
+		}
+		if len(line) == 0 || len(line) == 1 && line[0] == '\n' && !inQuote {
+			break
+		}
+		b = append(b, line...)
+	}
+	ta.want = string(b)
+	return ta, nil
+}
+
+func TestHegelGaugeOracles(t *testing.T) {
+	if os.Getenv("HEGEL_GAUGE") == "" {
+		t.Skip("set HEGEL_GAUGE=1 to gauge the oracles against the conformance suite")
+	}
+	var total, xnetOK, p5OK, libOK, libNone, wouldFail int
+	for _, dir := range []string{"../testdata/html5lib-tests/tree-construction/", "../testdata/go/"} {
+		files, _ := filepath.Glob(dir + "*.dat")
+		for _, tf := range files {
+			f, err := os.Open(tf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			r := bufio.NewReader(f)
+			var fp5, flib, fx int
+			for i := 0; ; i++ {
+				c, err := readDatCase(r)
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				total++
+				req := treeReq{html: c.text, fragment: c.context, scripting: c.scripting}
+				var got string
+				func() {
+					defer func() {
+						if x := recover(); x != nil {
+							got = fmt.Sprintf("PANIC %v", x)
+						}
+					}()
+					doc, err := parseTree(req, strings.NewReader(c.text))
+					if err != nil {
+						got = "ERR " + err.Error()
+						return
+					}
+					got, _ = dump(doc)
+				}()
+				p5, _ := opinion(t, parse5Oracle(), req)
+				lb, hasLib := opinion(t, html5libOracle(), req)
+				if got == c.want {
+					xnetOK++
+				} else {
+					fx++
+				}
+				if p5 == c.want {
+					p5OK++
+				} else {
+					fp5++
+				}
+				if !hasLib {
+					libNone++
+				} else if lb == c.want {
+					libOK++
+				} else {
+					flib++
+				}
+				if got != p5 && hasLib && lb == p5 {
+					wouldFail++
+					t.Logf("WOULD FAIL %s #%d (context %q, scripting %v)\n%q\n--- x/net/html\n%s--- oracles\n%s--- suite\n%s", tf, i, c.context, c.scripting, c.text, got, p5, c.want)
+				}
+			}
+			f.Close()
+			if fp5+flib+fx > 0 {
+				t.Logf("%s: x/net/html %d off, parse5 %d off, html5lib %d off", filepath.Base(tf), fx, fp5, flib)
+			}
+		}
+	}
+	t.Logf("GAUGE %d cases: x/net/html %d, parse5 %d, html5lib %d (%d no opinion); %d would fail the vote", total, xnetOK, p5OK, libOK, libNone, wouldFail)
+}
