+// hzGValidFor / hzGInvalidFor: the values of the pool that parse for the type (without options)
+// and those that do not; hzGFaultyTypes the types some value fails for.
+var (
+	hzGValidFor    = map[*hzGType][]string{}
+	hzGInvalidFor  = map[*hzGType][]string{}
+	hzGFaultyTypes = func() []*hzGType {
+		var out []*hzGType
+		for _, g := range hzGTypes {
+			for _, v := range hzGValuePool {
+				if v == "" {
+					continue
+				}
+				if _, err := g.parse(v, nil); err != nil {
+					hzGInvalidFor[g] = append(hzGInvalidFor[g], v)
+				} else {
+					hzGValidFor[g] = append(hzGValidFor[g], v)
+				}
+			}
+			if len(hzGInvalidFor[g]) > 0 {
+				out = append(out, g)
+			}
+		}
+		return out
+	}()
+)
+
+// hzOrOnParseErrorCases: echo/12. An Or call of a type over a value that fails to parse (past
+// it: one that parses), from any source.
+var hzOrOnParseErrorCases = hegel.FlatMap(hegel.SampledFrom(hzGFaultyTypes), func(g *hzGType) hegel.Generator[hzGCase] {
+	values := hzShaped(hegel.SampledFrom(hzGInvalidFor[g]), hegel.SampledFrom(hzGValidFor[g]))
+	return hegel.Composite(func(tc hegel.TestCase) hzGCase {
+		return hzGCase{
+			g:      g,
+			key:    hegel.Draw(tc, hzGKeys),
+			values: []string{hegel.Draw(tc, values)},
+			source: hegel.Draw(tc, hzGSources),
+			call:   hzGSingleOr,
+			other:  hegel.Draw(tc, hzCoin(30)),
+		}
+	})
+})
+
+// TestHegelOrOnParseError: echo/12. The Or accessors return the default with the
+// BindingError on a value that fails to parse, as their documentation says.
+func TestHegelOrOnParseError(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckGeneric(col, ht, hegel.Draw(ht, hzOrOnParseErrorCases))
+	})
+}
+
+// hzBindNonPointerCases: echo/13. A Bind case with path values present (so that the binder
+// looks at the destination).
+var hzBindNonPointerCases = hzBindCasesWith(hzDataFor(true, 1))
+
+// hzCheckBindValue binds the case's request into a struct value (not a pointer): a
+// programming error the binder reports, not a panic.
+func hzCheckBindValue(col *hzCollector, ht *hegel.T, cs hzBindCase) {
+	c := hzBindRequest(cs)
+	dst := reflect.New(hzBuildType(cs.specs)).Elem().Interface()
+	var err error
+	if r := hzCatch(func() { err = c.Bind(dst) }); r != nil {
+		col.mismatch(ht, hzKnownShape("echo/13"), "panic", "%s\nBind of a struct value: panic %v", cs.GoString(), r)
+		return
+	}
+	if err == nil {
+		col.mismatch(ht, hzKnownShape("echo/13"), "error", "%s\nBind of a struct value: no error", cs.GoString())
+		return
+	}
+	col.count(fmt.Sprintf("rejected %s", cs.method))
+}
+
+// TestHegelBindNonPointer: echo/13. Bind with a destination that is not a pointer (past
+// it: the pointer, bound against the model) reports an error and does not panic.
+func TestHegelBindNonPointer(t *testing.T) {
+	col := hzNewCollector(t)
+	check := hzShaped(hzCheckBindValue, hzCheckBind)
+	hzProperty(t, func(ht *hegel.T) {
+		check(col, ht, hegel.Draw(ht, hzBindNonPointerCases))
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..b1deb2c
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,316 @@
+package hegel
+
+// Hegel property tests for labstack/echo v5's router, written for the Hegel zoo. See
+// targets/go/echo/README.md. They live in a package of their own (hegel/) and drive the router
+// through the public API: echo.NewWithConfig with a NewRouter(RouterConfig{...}), AddRoute, and
+// ServeHTTP on httptest requests, the handlers echoing the route and its path values.
+//
+// Oracles: a model of route matching (static text first, then a :param, then a *, with
+// backtracking; RouteNotFound routes; 405 with the Allow header; the default OPTIONS answer;
+// AutoHandleHEAD; the escaped-path and unescape-values options) over generated route sets and
+// requests; the law that registration order does not matter; RouteInfo.Reverse round trips;
+// Remove leaving the other routes as they were. Part 2 (hegel_zoo_bind_test.go,
+// hegel_zoo_vbinder_test.go, hegel_zoo_generic_test.go): the struct binder, the ValueBinder
+// chains and the generic accessors against models of their documentation.
+//
+// Every property draws one case record from generator values built with the binding's
+// combinators (hegel.Composite for records, Lists/Maps for collections, SampledFrom/OneOf and
+// the local hzWeighted for choices, hzCoin/hzMaybe/hzOptional for optional parts) and renders it
+// with pure functions; positions into live data are drawn as small integers taken modulo the
+// live size. The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate and
+// the model follows the documentation, so the properties that meet them fail, naming the
+// shape, and are the expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_zoo_shapes_test.go has one narrow property per bug over its shape region alone, and
+// hegel_zoo_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 (hzNoKnown, read once)
+// switches the known shapes off: the model then reproduces the recorded behaviour (HZKnown)
+// and the generators leave the shapes out (hzShaped).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// hzNoKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes, the model follows the documentation and the properties
+// that meet a shape fail, naming it (hzCollector.mismatch); under HEGEL_NO_KNOWN=1 the
+// switches of HZKnown are on (the model reproduces the recorded behaviour), the shapes are left
+// out of the generators (hzShaped) and a mismatch that still has a known shape is skipped.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// hzSwitches: the recorded bugs (bugs.toml) the model can reproduce. A switch that is on means
+// the model follows the package's behaviour instead of the documentation, which is so only
+// under HEGEL_NO_KNOWN=1; the pins assert the documented behaviour and fail while the bug
+// exists.
+type hzSwitches struct {
+	anyStopsBacktrack   bool // echo/2: a wildcard node without the method ends the search: alternatives above it are not tried
+	notFoundRouteStops  bool // echo/3: a RouteNotFound route reached with the path consumed ends the search before lower-priority routes
+	escapedPathInverted bool // echo/4: UseEscapedPathForMatching selects the decoded path, the default the escaped one
+	removeLosesWay      bool // echo/8: Remove does not find routes after a parameter, with an escaped colon, or at a node re-registered under another path
+	removeDropsNotFound bool // echo/9: Remove prunes a RouteNotFound route on its way up the tree
+	caseFoldRandom      bool // echo/10: bindData's case-insensitive fallback picks a random key when several match
+	slicesNeedNoErrors  bool // echo/11: ValueBinder's slice methods bind only while no error at all has been recorded
+	orReturnsZero       bool // echo/12: QueryParamOr & co. return the zero value, not the default, on a parse error
+}
+
+// HZKnown: the switches as the properties run them: all off by default, all on under
+// HEGEL_NO_KNOWN=1. (echo/1, echo/5, echo/6, echo/7 and echo/13 are shapes of the input, not of
+// the model: hzShaped keeps them out of the generators under HEGEL_NO_KNOWN=1.)
+var HZKnown = hzSwitches{
+	anyStopsBacktrack:   hzNoKnown,
+	notFoundRouteStops:  hzNoKnown,
+	escapedPathInverted: hzNoKnown,
+	removeLosesWay:      hzNoKnown,
+	removeDropsNotFound: hzNoKnown,
+	caseFoldRandom:      hzNoKnown,
+	slicesNeedNoErrors:  hzNoKnown,
+	orReturnsZero:       hzNoKnown,
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func hzShaped[T any](known, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return known
+}
+
+// hzShapeIf names the bug when the case has its shape.
+func hzShapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// hzKnownShape names the bug a narrow property draws the shape of (none under
+// HEGEL_NO_KNOWN=1, where it draws the neighbouring region).
+func hzKnownShape(id string) []string { return hzShapeIf(!hzNoKnown, id) }
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
+
+// --------------------------------------------------------------------------- collector
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case whose shape is that of the recorded
+// bugs shape names (none for a shape no bug covers): the failure names them, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out and the model reproduces the rest).
+func (c *hzCollector) mismatch(ht *hegel.T, shape []string, class string, format string, args ...any) {
+	if len(shape) > 0 {
+		if hzNoKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzChoice[T]{100 - pct, hegel.Just(zero)}, hzChoice[T]{pct, g})
+}
+
+func hzPtrTo[T any](x T) *T { return &x }
+
+// hzOptional generates a pointer to a value of g pct percent of the time and nil otherwise
+// (for values whose zero value is a value in its own right).
+func hzOptional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return hzMaybe(pct, hegel.Map(g, hzPtrTo[T]))
+}
+
+// hzMany is a list of lo to hi elements.
+func hzMany[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// hzNonNilMap makes an empty map a non-nil one (Maps yields nil for zero elements).
+func hzNonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// hzPositions: an index into live data of unknown size, taken modulo the size when applied
+// (so every drawn value fits and the shrinker is free).
+var hzPositions = hegel.Integers(0, 99)
+
+// hzAt is the element of xs at a drawn position (modulo the length); the zero value for an
+// empty list.
+func hzAt[T any](xs []T, at int) T {
+	var zero T
+	if len(xs) == 0 {
+		return zero
+	}
+	return xs[at%len(xs)]
+}
+
+// hzSortedKeys is the keys of a map in order.
+func hzSortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// hzShuffled is xs in the order of the keys (a stable sort by key, keys recycled modulo their
+// number; all-equal or no keys keep the order), the shrinkable stand-in for a permutation.
+func hzShuffled[T any](xs []T, keys []int) []T {
+	idx := make([]int, len(xs))
+	for i := range idx {
+		idx[i] = i
+	}
+	if len(keys) > 0 {
+		sort.SliceStable(idx, func(a, b int) bool { return keys[idx[a]%len(keys)] < keys[idx[b]%len(keys)] })
+	}
+	out := make([]T, len(xs))
+	for i, j := range idx {
+		out[i] = xs[j]
+	}
+	return out
+}
diff --git a/hegel/hegel_zoo_vbinder_test.go b/hegel/hegel_zoo_vbinder_test.go
new file mode 100644
index 0000000..674cfce
--- /dev/null
+++ b/hegel/hegel_zoo_vbinder_test.go
@@ -0,0 +1,923 @@
+package hegel
+
+// The ValueBinder (binder.go): chains of typed binding calls over query parameters, path values
+// or form fields, with FailFast on or off, against a model of the documented semantics. A chain
+// is drawn as a list of call specs (the kind of call, Must or not, the parameter) and built
+// into calls with fresh destinations by a pure constructor.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// hzJSONT implements json.Unmarshaler: an integer.
+type hzJSONT struct{ N int }
+
+func (j *hzJSONT) UnmarshalJSON(b []byte) error { return json.Unmarshal(b, &j.N) }
+
+// hzVOp is one call of a chain: run performs it on the binder, dump prints the destination,
+// and model computes the expected outcome from the parameter's values.
+type hzVOp struct {
+	name   string
+	must   bool
+	slice  bool // a slice destination (the *[]string ones are set unconditionally: plain)
+	plain  bool
+	run    func(b *echo.ValueBinder, param string)
+	dump   func() string
+	model  func(first string, values []string) (dump string, errs []string)
+	initst string // the dump before binding
+	pname  string // the parameter the op is called with
+	all    bool   // every error is recorded even with FailFast (CustomFunc)
+}
+
+// hzVErr formats a BindingError as its Error() does.
+func hzVErr(param, message string, err error) string {
+	s := "code=400, message=" + message
+	if err != nil {
+		s += ", err=" + err.Error()
+	}
+	return s + ", field=" + param
+}
+
+const hzRequired = "required field value is empty"
+
+func hzTimeDump(t time.Time) string { return t.UTC().Format(time.RFC3339Nano) }
+
+// The kinds of call: the scalar ones, the slice ones, BindWithDelimiter into five slice types,
+// CustomFunc.
+const (
+	hzVString = iota
+	hzVStrings
+	hzVInt64
+	hzVInt8
+	hzVInt
+	hzVUint64
+	hzVUint8
+	hzVBool
+	hzVFloat64
+	hzVFloat32
+	hzVTime
+	hzVDuration
+	hzVUnixTime
+	hzVUnixTimeMilli
+	hzVBindUnmarshaler
+	hzVTextUnmarshaler
+	hzVJSONUnmarshaler
+	hzVInt64s
+	hzVInt8s
+	hzVBools
+	hzVFloat64s
+	hzVDurations
+	hzVDelimStrings
+	hzVDelimInt64s
+	hzVDelimBools
+	hzVDelimDurations
+	hzVDelimTimes
+	hzVCustomFunc
+	hzVKindCount
+)
+
+// hzNewVOp builds the call of a kind with fresh destinations. The sentinel initial values show
+// what a call left unbound.
+func hzNewVOp(kind int, must bool) *hzVOp {
+	op := &hzVOp{must: must}
+	switch kind {
+	case hzVString:
+		d := "init"
+		op.name, op.run = "String", func(b *echo.ValueBinder, p string) {
+			if must {
+				b.MustString(p, &d)
+			} else {
+				b.String(p, &d)
+			}
+		}
+		op.dump = func() string { return d }
+		op.model = func(first string, values []string) (string, []string) {
+			if first == "" {
+				if must {
+					return "init", []string{hzVErr(op.param(), hzRequired, nil)}
+				}
+				return "init", nil
+			}
+			return first, nil
+		}
+	case hzVStrings:
+		d := []string{"init"}
+		op.slice, op.plain = true, true
+		op.name, op.run = "Strings", func(b *echo.ValueBinder, p string) {
+			if must {
+				b.MustStrings(p, &d)
+			} else {
+				b.Strings(p, &d)
+			}
+		}
+		op.dump = func() string { return fmt.Sprint(d) }
+		op.model = func(first string, values []string) (string, []string) {
+			if values == nil {
+				if must {
+					return "[init]", []string{hzVErr(op.param(), hzRequired, nil)}
+				}
+				return "[init]", nil
+			}
+			return fmt.Sprint(values), nil
+		}
+	case hzVInt64, hzVInt8, hzVInt:
+		bits := []int{64, 8, 0}[kind-hzVInt64]
+		var d64 int64 = 99
+		var d8 int8 = 99
+		var d int = 99
+		tname := "int" + map[int]string{64: "64", 8: "8", 0: ""}[bits]
+		op.name = "Int" + map[int]string{64: "64", 8: "8", 0: ""}[bits]
+		op.run = func(b *echo.ValueBinder, p string) {
+			switch {
+			case bits == 64 && must:
+				b.MustInt64(p, &d64)
+			case bits == 64:
+				b.Int64(p, &d64)
+			case bits == 8 && must:
+				b.MustInt8(p, &d8)
+			case bits == 8:
+				b.Int8(p, &d8)
+			case must:
+				b.MustInt(p, &d)
+			default:
+				b.Int(p, &d)
+			}
+		}
+		op.dump = func() string { return fmt.Sprint(d64, d8, d) }
+		op.model = func(first string, values []string) (string, []string) {
+			init := "99 99 99"
+			if first == "" {
+				if must {
+					return init, []string{hzVErr(op.param(), hzRequired, nil)}
+				}
+				return init, nil
+			}
+			n, err := strconv.ParseInt(first, 10, bits)
+			if err != nil {
+				return init, []string{hzVErr(op.param(), "failed to bind field value to "+tname, err)}
+			}
+			switch bits {
+			case 64:
+				return fmt.Sprint(n, 99, 99), nil
+			case 8:
+				return fmt.Sprint(99, n, 99), nil
+			}
+			return fmt.Sprint(99, 99, n), nil
+		}
+	case hzVUint64, hzVUint8:
+		bits := []int{64, 8}[kind-hzVUint64]
+		var d64 uint64 = 99
+		var d8 uint8 = 99
+		op.name = "Uint" + map[int]string{64: "64", 8: "8"}[bits]
+		op.run = func(b *echo.ValueBinder, p string) {
+			switch {
+			case bits == 64 && must:
+				b.MustUint64(p, &d64)
+			case bits == 64:
+				b.Uint64(p, &d64)
+			case must:
+				b.MustUint8(p, &d8)
+			default:
+				b.Uint8(p, &d8)
+			}
+		}
+		op.dump = func() string { return fmt.Sprint(d64, d8) }
+		op.model = func(first string, values []string) (string, []string) {
+			init := "99 99"
+			if first == "" {
+				if must {
+					return init, []string{hzVErr(op.param(), hzRequired, nil)}
+				}
+				return init, nil
+			}
+			n, err := strconv.ParseUint(first, 10, bits)
