+// hzBindCaseFoldCases: echo/10. A field tagged with a name, the data holding two (past it: one)
+// other spellings of it with distinct values, in a query, path values or a form; random other
+// fields beside.
+var hzBindCaseFoldCases = hegel.FlatMap(hegel.SampledFrom([]string{"query", "param", "form"}), func(source string) hegel.Generator[hzBindDataCase] {
+	extra := hzMany(hzLeafSpecsFor(source), 0, 2)
+	return hegel.Composite(func(tc hegel.TestCase) hzBindDataCase {
+		group := hegel.Draw(tc, hegel.SampledFrom(hzNameGroups))
+		tag := hzAt(group, hegel.Draw(tc, hzPositions))
+		at := hegel.Draw(tc, hzPositions)
+		keys := []string{hzOther(group, tag, at), hzOther(group, tag, at+1)}[:hzShaped(2, 1)]
+		n := len(hzBindValuePool)
+		i, j := hegel.Draw(tc, hegel.Integers(0, n-1)), hegel.Draw(tc, hegel.Integers(1, n-1))
+		values := []string{hzBindValuePool[i], hzBindValuePool[(i+j)%n]}
+		data := url.Values{}
+		for k, key := range keys {
+			data[key] = []string{values[k]}
+		}
+		field := &hzFieldSpec{kind: hzFLeaf, leaf: hegel.Draw(tc, hzLeafKinds), wrap: hegel.Draw(tc, hzWraps), tags: map[string]string{source: tag}}
+		return hzBindDataCase{source: source, specs: append([]*hzFieldSpec{field}, hegel.Draw(tc, extra)...), data: data}
+	})
+})
