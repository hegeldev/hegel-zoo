+// hzSlicesAfterErrorCases: echo/11. FailFast off; a Must call (past it: a plain call) on an
+// absent parameter, then a slice call on a parameter with valid values, random calls on other
+// parameters around them.
+var hzSlicesAfterErrorCases = hegel.FlatMap(hzVSources, func(source string) hegel.Generator[hzVCase] {
+	count := 3
+	if source == "param" {
+		count = 1
+	}
+	around := hzVOpSpecsNamed(hegel.SampledFrom([]string{"c", "d"}))
+	return hegel.Composite(func(tc hegel.TestCase) hzVCase {
+		kind := hegel.Draw(tc, hegel.SampledFrom(hzVSliceKinds))
+		failing := hzVOpSpec{kind: hegel.Draw(tc, hegel.Integers(0, hzVKindCount-1)), must: hzShaped(true, false), pname: "a"}
+		slice := hzVOpSpec{kind: kind, must: hegel.Draw(tc, hzCoin(30)), pname: "b"}
+		chain := append(hegel.Draw(tc, hzMany(around, 0, 2)), failing, slice)
+		chain = append(chain, hegel.Draw(tc, hzMany(around, 0, 1))...)
+		data := url.Values{"b": hegel.Draw(tc, hzMany(hegel.SampledFrom(hzVValidFor[kind]), 1, count))}
+		if c := hegel.Draw(tc, hzMany(hzVValues, 0, count)); len(c) > 0 {
+			data["c"] = c
+		}
+		return hzVCase{source: source, data: data, failFast: false, chain: chain}
+	})
+})
