+
+// param is set per chain step (the parameter name the op is called with).
+func (op *hzVOp) param() string { return op.pname }
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	hzVNamePool      = []string{"a", "b", "c", "d"}
+	hzVNames         = hegel.SampledFrom(hzVNamePool)
+	hzVValuePool     = []string{"", "0", "1", "-1", "42", "300", "1.5", "true", "T", "x", "bad", "2023-01-15", "1s", "1,2", "1,x", "true,false", "1s,2m", "1700000000", "-0", "abc"}
+	hzVSafeValuePool = []string{"1", "0", "42", "true", "1s", "2023-01-15", "1,2", "1700000000", "7"} // parse for most of the ops
+	// hzVValues: a parameter value, one that parses for most of the ops 60% of the time.
+	hzVValues = hzWeighted(
+		hzChoice[string]{60, hegel.SampledFrom(hzVSafeValuePool)},
+		hzChoice[string]{40, hegel.SampledFrom(hzVValuePool)},
+	)
+)
+
+// hzVOpSpec is a call of a chain as drawn: its kind, Must or not, and the parameter.
+type hzVOpSpec struct {
+	kind  int
+	must  bool
+	pname string
+}
+
+// build makes the call with fresh destinations.
+func (s hzVOpSpec) build() *hzVOp {
+	op := hzNewVOp(s.kind, s.must)
+	op.pname = s.pname
+	return op
+}
+
+// hzVOpSpecsNamed: a call of any kind, Must 30% of the time, on a parameter drawn from names.
+func hzVOpSpecsNamed(names hegel.Generator[string]) hegel.Generator[hzVOpSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) hzVOpSpec {
+		return hzVOpSpec{kind: hegel.Draw(tc, hegel.Integers(0, hzVKindCount-1)), must: hegel.Draw(tc, hzCoin(30)), pname: hegel.Draw(tc, names)}
+	})
+}
+
+var (
+	hzVOpSpecs = hzVOpSpecsNamed(hzVNames)
+	// hzVChains: one to six calls.
+	hzVChains = hzMany(hzVOpSpecs, 1, 6)
+)
+
+// hzVDataFor: the parameters a to d, each present or not, with one value (single) or with two
+// or three 30% of the time.
+func hzVDataFor(single bool) hegel.Generator[url.Values] {
+	values := hzMany(hzVValues, 1, 1)
+	if !single {
+		values = hzWeighted(hzChoice[[]string]{70, hzMany(hzVValues, 1, 1)}, hzChoice[[]string]{30, hzMany(hzVValues, 2, 3)})
+	}
+	return hegel.Map(hegel.Maps(hzVNames, values).MaxSize(len(hzVNamePool)), func(m map[string][]string) url.Values {
+		return url.Values(hzNonNilMap(m))
+	})
+}
+
+var (
+	hzVSingleData = hzVDataFor(true)
+	hzVMultiData  = hzVDataFor(false)
+	hzVSources    = hegel.SampledFrom([]string{"query", "param", "form"})
+)
+
+// hzVCase: a source, its parameters, FailFast on or off and the chain.
+type hzVCase struct {
+	source   string
+	data     url.Values
+	failFast bool
+	chain    []hzVOpSpec
+}
+
+// ops builds the chain's calls.
+func (c hzVCase) ops() []*hzVOp {
+	ops := make([]*hzVOp, len(c.chain))
+	for i, s := range c.chain {
+		ops[i] = s.build()
+	}
+	return ops
+}
+
+func (c hzVCase) GoString() string {
+	var names []string
+	for _, op := range c.ops() {
+		names = append(names, op.name+"("+op.pname+")")
+	}
+	return fmt.Sprintf("%s %v failFast=%v\nchain %s", c.source, c.data, c.failFast, strings.Join(names, " "))
+}
+
+// hzVCasesWith draws the cases of the source with the chains.
+func hzVCasesWith(chains hegel.Generator[[]hzVOpSpec]) hegel.Generator[hzVCase] {
+	return hegel.FlatMap(hzVSources, func(source string) hegel.Generator[hzVCase] {
+		data := hzVMultiData
+		if source == "param" {
+			data = hzVSingleData
+		}
+		return hegel.Composite(func(tc hegel.TestCase) hzVCase {
+			return hzVCase{source: source, data: hegel.Draw(tc, data), failFast: hegel.Draw(tc, hzCoin(50)), chain: hegel.Draw(tc, chains)}
+		})
+	})
+}
+
+var hzVCases = hzVCasesWith(hzVChains)
+
+// hzVBinder builds the context and the ValueBinder of a case.
+func hzVBinder(c hzVCase) *echo.ValueBinder {
+	e := echo.New()
+	var req *http.Request
+	switch c.source {
+	case "query":
+		req = httptest.NewRequest(http.MethodGet, "/?"+c.data.Encode(), nil)
+	case "param":
+		req = httptest.NewRequest(http.MethodGet, "/", nil)
+	case "form":
+		req = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(c.data.Encode()))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+	}
+	ctx := e.NewContext(req, httptest.NewRecorder())
+	var b *echo.ValueBinder
+	switch c.source {
+	case "query":
+		b = echo.QueryParamsBinder(ctx)
+	case "param":
+		ctx.SetPathValues(hzPathValuesOf(c.data))
+		b = echo.PathValuesBinder(ctx)
+	case "form":
+		b = echo.FormFieldBinder(ctx)
+	}
+	if !c.failFast {
+		b.FailFast(false)
+	}
+	return b
+}
+
+// hzVModel is the chain's documented outcome: the errors and each destination's dump.
+// ValueFunc gives the first value ("" when absent), ValuesFunc all of them (nil when absent; a
+// path value that is "" counts as absent); FailFast stops at the first error. afterError
+// reports whether a slice call with valid values followed an error with FailFast off, the
+// shape of echo/11 (with sw.slicesNeedNoErrors the slice stays unbound then).
+func hzVModel(c hzVCase, ops []*hzVOp, sw hzSwitches) (wantErrs []string, wantDumps []string, afterError bool) {
+	wantDumps = make([]string, len(ops))
+	for i, op := range ops {
+		wantDumps[i] = op.initst
+		if c.failFast && len(wantErrs) > 0 {
+			continue
+		}
+		values := c.data[op.pname]
+		first := ""
+		if len(values) > 0 {
+			first = values[0]
+		}
+		if c.source == "param" && first == "" {
+			values = nil
+		}
+		dump, errs := op.model(first, values)
+		if c.failFast && !op.all && len(errs) > 1 {
+			errs = errs[:1] // the first failing element ends the call
+		}
+		before := len(wantErrs)
+		wantErrs = append(wantErrs, errs...)
+		if op.slice && !op.plain && len(errs) == 0 && before > 0 {
+			afterError = true
+			if sw.slicesNeedNoErrors {
+				continue // bug: the slice is set only while the binder holds no error at all
+			}
+		}
+		wantDumps[i] = dump
+	}
+	return wantErrs, wantDumps, afterError
+}
+
+// hzCheckChain runs the chain on the binder and compares the errors and the destinations with
+// the model.
+func hzCheckChain(col *hzCollector, ht *hegel.T, c hzVCase) {
+	ops := c.ops()
+	wantErrs, wantDumps, afterError := hzVModel(c, ops, HZKnown)
+	shape := hzShapeIf(afterError, "echo/11")
+	b := hzVBinder(c)
+	var gotErrs []error
+	r := hzCatch(func() {
+		for _, op := range ops {
+			op.run(b, op.pname)
+		}
+		gotErrs = b.BindErrors()
+	})
+	desc := c.GoString()
+	if r != nil {
+		col.mismatch(ht, shape, "panic", "%s\npanic: %v", desc, r)
+		return
+	}
+	var got []string
+	for _, err := range gotErrs {
+		got = append(got, err.Error())
+	}
+	if fmt.Sprint(got) != fmt.Sprint(wantErrs) {
+		col.mismatch(ht, shape, "errors", "%s\n got errors %q\nwant errors %q", desc, got, wantErrs)
+		return
+	}
+	for i, op := range ops {
+		if g := op.dump(); g != wantDumps[i] {
+			col.mismatch(ht, shape, "value", "%s\nop %d %s: got %s want %s (errors %q)", desc, i, op.name, g, wantDumps[i], got)
+			return
+		}
+	}
+	if len(wantErrs) > 0 {
+		col.count("errors")
+	} else {
+		col.count("ok " + c.source)
+	}
+}
+
+// TestHegelValueBinder: a chain of 1-6 calls on a QueryParamsBinder, PathValuesBinder or
+// FormFieldBinder, FailFast on or off, against the model: each destination after the chain
+// and BindErrors().
+func TestHegelValueBinder(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckChain(col, ht, hegel.Draw(ht, hzVCases))
+	})
+}
