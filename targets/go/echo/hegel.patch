+package hegel
+
+// The struct binder (bind.go: BindQueryParams, BindPathValues, BindHeaders, BindBody for form
+// bodies, and DefaultBinder.Bind composing them) against a model of the documented semantics
+// over struct types built with reflect.StructOf.
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- leaf types
+
+// hzParamT implements echo.BindUnmarshaler: values starting with "bad" fail.
+type hzParamT struct{ V string }
+
+func (p *hzParamT) UnmarshalParam(s string) error {
+	if strings.HasPrefix(s, "bad") {
+		return errors.New("hzParam: " + s)
+	}
+	p.V = "P(" + s + ")"
+	return nil
+}
+
+// hzTextT implements encoding.TextUnmarshaler.
+type hzTextT struct{ V string }
+
+func (p *hzTextT) UnmarshalText(b []byte) error {
+	if strings.HasPrefix(string(b), "bad") {
+		return errors.New("hzText: " + string(b))
+	}
+	p.V = "T(" + string(b) + ")"
+	return nil
+}
+
+// hzMultiT implements the binder's UnmarshalParams (all values at once).
+type hzMultiT struct{ V []string }
+
+func (p *hzMultiT) UnmarshalParams(ps []string) error {
+	for _, s := range ps {
+		if strings.HasPrefix(s, "bad") {
+			return errors.New("hzMulti: " + s)
+		}
+	}
+	p.V = append([]string{"M"}, ps...)
+	return nil
+}
+
+type hzMultiUnmarshaler interface{ UnmarshalParams([]string) error }
+
+const hzDateLayout = "2006-01-02"
+
+// --------------------------------------------------------------------------- type specs
+
+const (
+	hzLString = iota
+	hzLInt
+	hzLInt8
+	hzLUint16
+	hzLUint64
+	hzLFloat64
+	hzLBool
+	hzLTime
+	hzLTimeFmt // time.Time with a format tag
+	hzLDuration
+	hzLParam
+	hzLText
+	hzLMulti
+	hzLCount
+)
+
+const (
+	hzWNone = iota
+	hzWSlice
+	hzWPtr
+	hzWPtrSlice
+	hzWSlicePtr
+	hzWCount
+)
+
+const (
+	hzFLeaf       = iota
+	hzFStruct     // a named field of struct type (untagged: flattened; tagged: an error)
+	hzFAnon       // an embedded struct
+	hzFAnonPtr    // an embedded *struct (nil while binding: skipped)
+	hzFTaggedList // a tagged nested struct: "unknown type"
+)
+
+type hzFieldSpec struct {
+	kind   int
+	leaf   int
+	wrap   int
+	tags   map[string]string // tag name -> parameter name
+	sub    []*hzFieldSpec
+	tagged bool // for hzFStruct / hzFAnon: carries a tag
+}
+
+var hzLeafTypes = map[int]reflect.Type{
+	hzLString:   reflect.TypeFor[string](),
+	hzLInt:      reflect.TypeFor[int](),
+	hzLInt8:     reflect.TypeFor[int8](),
+	hzLUint16:   reflect.TypeFor[uint16](),
+	hzLUint64:   reflect.TypeFor[uint64](),
+	hzLFloat64:  reflect.TypeFor[float64](),
+	hzLBool:     reflect.TypeFor[bool](),
+	hzLTime:     reflect.TypeFor[time.Time](),
+	hzLTimeFmt:  reflect.TypeFor[time.Time](),
+	hzLDuration: reflect.TypeFor[time.Duration](),
+	hzLParam:    reflect.TypeFor[hzParamT](),
+	hzLText:     reflect.TypeFor[hzTextT](),
+	hzLMulti:    reflect.TypeFor[hzMultiT](),
+}
+
+func hzWrapType(t reflect.Type, wrap int) reflect.Type {
+	switch wrap {
+	case hzWSlice:
+		return reflect.SliceOf(t)
+	case hzWPtr:
+		return reflect.PointerTo(t)
+	case hzWPtrSlice:
+		return reflect.PointerTo(reflect.SliceOf(t))
+	case hzWSlicePtr:
+		return reflect.SliceOf(reflect.PointerTo(t))
+	}
+	return t
+}
+
+var hzBindSources = []string{"query", "param", "form", "header"}
+
+func hzTagString(tags map[string]string, format string) reflect.StructTag {
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var parts []string
+	for _, k := range keys {
+		parts = append(parts, fmt.Sprintf("%s:%q", k, tags[k]))
+	}
+	if format != "" {
+		parts = append(parts, fmt.Sprintf("format:%q", format))
+	}
+	return reflect.StructTag(strings.Join(parts, " "))
+}
+
+// hzBuildType builds the struct type of a spec list.
+func hzBuildType(specs []*hzFieldSpec) reflect.Type {
+	fields := make([]reflect.StructField, 0, len(specs))
+	for i, s := range specs {
+		f := reflect.StructField{Name: fmt.Sprintf("F%d", i)}
+		switch s.kind {
+		case hzFLeaf:
+			f.Type = hzWrapType(hzLeafTypes[s.leaf], s.wrap)
+			format := ""
+			if s.leaf == hzLTimeFmt {
+				format = hzDateLayout
+			}
+			f.Tag = hzTagString(s.tags, format)
+		case hzFStruct, hzFTaggedList:
+			f.Type = hzBuildType(s.sub)
+			if s.tagged {
+				f.Tag = hzTagString(s.tags, "")
+			}
+		case hzFAnon:
+			f.Type = hzBuildType(s.sub)
+			f.Anonymous = true
+			if s.tagged {
+				f.Tag = hzTagString(s.tags, "")
+			}
+		case hzFAnonPtr:
+			f.Type = reflect.PointerTo(hzBuildType(s.sub))
+			f.Anonymous = true
+		}
+		fields = append(fields, f)
+	}
+	return reflect.StructOf(fields)
+}
+
+// --------------------------------------------------------------------------- the model
+
+// hzErrSkip marks a case the model cannot decide while a switch is on.
+var hzErrSkip = errors.New("skip")
+
+// hzLookup finds name in data: the exact key first, else the keys equal ignoring case.
+func hzLookup(data map[string][]string, name string) (vals []string, found bool, err error) {
+	if v, ok := data[name]; ok {
+		return v, true, nil
+	}
+	var keys []string
+	for k := range data {
+		if strings.EqualFold(k, name) {
+			keys = append(keys, k)
+		}
+	}
+	if len(keys) == 0 {
+		return nil, false, nil
+	}
+	if len(keys) > 1 && HZKnown.caseFoldRandom {
+		return nil, false, hzErrSkip
+	}
+	sort.Strings(keys)
+	return data[keys[0]], true, nil
+}
+
+// hzModelBind binds data into the struct dst points to, per the documented semantics: fields
+// with the source's tag are bound (in declaration order; the first failure stops), untagged
+// struct fields are descended into, embedded pointers that are nil are skipped, a tag on an
+// embedded struct is an error.
+func hzModelBind(dst reflect.Value, data map[string][]string, tag string) error {
+	if len(data) == 0 {
+		return nil // nothing to bind: the shape of the destination is not looked at
+	}
+	typ := dst.Type()
+	for i := 0; i < typ.NumField(); i++ {
+		sf := typ.Field(i)
+		fv := dst.Field(i)
+		if sf.Anonymous && fv.Kind() == reflect.Pointer {
+			if fv.IsNil() {
+				continue
+			}
+			fv = fv.Elem()
+		}
+		name := sf.Tag.Get(tag)
+		if sf.Anonymous && fv.Kind() == reflect.Struct && name != "" {
+			return errors.New("query/param/form tags are not allowed with anonymous struct field")
+		}
+		if name == "" {
+			if fv.Kind() == reflect.Struct {
+				if _, ok := fv.Addr().Interface().(echo.BindUnmarshaler); !ok {
+					if err := hzModelBind(fv, data, tag); err != nil {
+						return err
+					}
+				}
+			}
+			continue
+		}
+		vals, found, err := hzLookup(data, name)
+		if err != nil {
+			return err
+		}
+		if !found {
+			continue
+		}
+		if err := hzModelSet(fv, vals, sf.Tag.Get("format"), true); err != nil {
+			return fmt.Errorf("%s: %w", name, err)
+		}
+	}
+	return nil
+}
+
+// hzModelSet sets one field (top) or one slice element from the values.
+func hzModelSet(fv reflect.Value, vals []string, format string, top bool) error {
+	if fv.Kind() == reflect.Pointer {
+		if fv.IsNil() {
+			fv.Set(reflect.New(fv.Type().Elem()))
+		}
+		return hzModelSet(fv.Elem(), vals, format, top)
+	}
+	addr := fv.Addr().Interface()
+	if top {
+		if m, ok := addr.(hzMultiUnmarshaler); ok {
+			return m.UnmarshalParams(vals)
+		}
+		if t, ok := addr.(*time.Time); ok && format != "" {
+			parsed, err := time.Parse(format, vals[0])
+			if err != nil {
+				return err
+			}
+			*t = parsed
+			return nil
+		}
+	}
+	switch u := addr.(type) {
+	case echo.BindUnmarshaler:
+		return u.UnmarshalParam(vals[0])
+	case interface{ UnmarshalText([]byte) error }:
+		return u.UnmarshalText([]byte(vals[0]))
+	}
+	if top && fv.Kind() == reflect.Slice {
+		s := reflect.MakeSlice(fv.Type(), len(vals), len(vals))
+		for j, v := range vals {
+			if err := hzModelSet(s.Index(j), []string{v}, "", false); err != nil {
+				return err
+			}
+		}
+		fv.Set(s)
+		return nil
+	}
+	v := vals[0]
+	switch fv.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if v == "" {
+			v = "0"
+		}
+		n, err := strconv.ParseInt(v, 10, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetInt(n)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if v == "" {
+			v = "0"
+		}
+		n, err := strconv.ParseUint(v, 10, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetUint(n)
+	case reflect.Bool:
+		if v == "" {
+			v = "false"
+		}
+		b, err := strconv.ParseBool(v)
+		if err != nil {
+			return err
+		}
+		fv.SetBool(b)
+	case reflect.Float32, reflect.Float64:
+		if v == "" {
+			v = "0.0"
+		}
+		f, err := strconv.ParseFloat(v, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetFloat(f)
+	case reflect.String:
+		fv.SetString(v)
+	default:
+		return errors.New("unknown type")
+	}
+	return nil
+}
+
+// hzIntBits: strconv's bitSize for the kind (0 for int/uint means the platform size; the
+// binder passes 0 and reflect reports 64, which parse alike).
+func init() {
+	if reflect.TypeFor[int]().Bits() != 64 {
+		panic("hegel zoo: the model assumes 64-bit ints")
+	}
+}
+
+// hzDump prints a value canonically (pointers as &v or nil, slices in brackets, times in UTC).
+func hzDump(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return "nil"
+		}
+		return "&" + hzDump(v.Elem())
+	case reflect.Slice:
+		if v.IsNil() {
+			return "nil"
+		}
+		parts := make([]string, v.Len())
+		for i := range parts {
+			parts[i] = hzDump(v.Index(i))
+		}
+		return "[" + strings.Join(parts, " ") + "]"
+	case reflect.Struct:
+		if t, ok := v.Interface().(time.Time); ok {
+			return t.UTC().Format(time.RFC3339Nano)
+		}
+		parts := make([]string, v.NumField())
+		for i := range parts {
+			parts[i] = v.Type().Field(i).Name + ":" + hzDump(v.Field(i))
+		}
+		return "{" + strings.Join(parts, " ") + "}"
+	}
+	return fmt.Sprintf("%v", v.Interface())
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzBindNames = []string{"id", "ID", "Id", "name", "Name", "n", "x-id", "X-Id", "a", "b", "c"}
+
+var hzBindValues = []string{"", "0", "1", "-1", "42", "300", "65536", "1.5", "true", "false", "T",
+	"x", "bad", "2023-01-15", "2023-01-15T10:00:00Z", "p1", "1s", "-0", " 1", "9223372036854775808",
+	"1e3", "yes", "0x10"}
+
+// hzBindSafeValues parse for most leaf types.
+var hzBindSafeValues = []string{"", "0", "1", "42", "-1", "7"}
+
+func hzGenTags(tc hegel.TestCase, source string) map[string]string {
+	tags := map[string]string{}
+	if hzChance(tc, 85) {
+		tags[source] = hzPick(tc, hzBindNames)
+	}
+	for _, s := range hzBindSources {
+		if s != source && hzChance(tc, 15) {
+			tags[s] = hzPick(tc, hzBindNames)
+		}
+	}
+	return tags
+}
+
+func hzGenSpecs(tc hegel.TestCase, source string, depth int) []*hzFieldSpec {
+	n := hzDrawInt(tc, 1, 4)
+	specs := make([]*hzFieldSpec, 0, n)
+	for i := 0; i < n; i++ {
+		s := &hzFieldSpec{kind: hzFLeaf}
+		if depth < 2 && hzChance(tc, 20) {
+			s.kind = hzPick(tc, []int{hzFStruct, hzFStruct, hzFAnon, hzFAnon, hzFAnonPtr, hzFTaggedList})
+			s.sub = hzGenSpecs(tc, source, depth+1)
+			s.tags = hzGenTags(tc, source)
+			switch s.kind {
+			case hzFTaggedList:
+				s.tagged = true
+				if len(s.tags) == 0 {
+					s.tags[source] = hzPick(tc, hzBindNames)
+				}
+			case hzFAnon:
+				s.tagged = hzChance(tc, 15)
+			}
+		} else {
+			s.leaf = hzDrawInt(tc, 0, hzLCount-1)
+			s.wrap = hzWNone
+			if hzChance(tc, 40) {
+				s.wrap = hzDrawInt(tc, 1, hzWCount-1)
+			}
+			s.tags = hzGenTags(tc, source)
+		}
+		specs = append(specs, s)
+	}
+	return specs
+}
+
+// hzGenData draws parameters: names from the pool, 1-3 values each.
+func hzGenData(tc hegel.TestCase, single bool) url.Values {
+	data := url.Values{}
+	n := hzDrawInt(tc, 0, 5)
+	for i := 0; i < n; i++ {
+		name := hzPick(tc, hzBindNames)
+		k := 1
+		if !single && hzChance(tc, 30) {
+			k = hzDrawInt(tc, 2, 3)
+		}
+		var vals []string
+		for j := 0; j < k; j++ {
+			if hzChance(tc, 55) {
+				vals = append(vals, hzPick(tc, hzBindSafeValues))
+			} else {
+				vals = append(vals, hzPick(tc, hzBindValues))
+			}
+		}
+		data[name] = vals
+	}
+	return data
+}
+
+func hzPathValuesOf(data url.Values) echo.PathValues {
+	keys := make([]string, 0, len(data))
+	for k := range data {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	pv := echo.PathValues{}
+	for _, k := range keys {
+		pv = append(pv, echo.PathValue{Name: k, Value: data[k][0]})
+	}
+	return pv
+}
+
+func hzHeaderOf(data url.Values) http.Header {
+	h := http.Header{}
+	keys := make([]string, 0, len(data))
+	for k := range data {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		for _, v := range data[k] {
+			h.Add(k, v)
+		}
+	}
+	return h
+}
+
+// hzBadRequest formats the error the binder wraps a binding failure in.
+func hzBadRequest(err error) string {
+	return "code=400, message=Bad Request, err=" + err.Error()
+}
+
+func hzErrString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// --------------------------------------------------------------------------- the property
+
+// TestHegelBindData: one source (query, path values, headers, or a form body) bound into a
+// generated struct type with BindQueryParams / BindPathValues / BindHeaders / BindBody against
+// the model: the bound value (dumped) and the error.
+func TestHegelBindData(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		source := hzPick(tc, hzBindSources)
+		specs := hzGenSpecs(tc, source, 0)
+		typ := hzBuildType(specs)
+		data := hzGenData(tc, source == "param")
+
+		e := echo.New()
+		var req *http.Request
+		var model map[string][]string
+		switch source {
+		case "query":
+			req = httptest.NewRequest(http.MethodGet, "/?"+data.Encode(), nil)
+			model = data
+		case "param":
+			req = httptest.NewRequest(http.MethodGet, "/", nil)
+			model = map[string][]string{}
+			for _, pv := range hzPathValuesOf(data) {
+				model[pv.Name] = []string{pv.Value}
+			}
+		case "header":
+			req = httptest.NewRequest(http.MethodGet, "/", nil)
+			req.Header = hzHeaderOf(data)
+			model = req.Header
+		case "form":
+			body := data.Encode()
+			req = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+			req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+			model = data
+			if body == "" {
+				model = map[string][]string{} // ContentLength 0: no body binding
+			}
+		}
+		c := e.NewContext(req, httptest.NewRecorder())
+		if source == "param" {
+			c.SetPathValues(hzPathValuesOf(data))
+		}
+
+		want := reflect.New(typ)
+		werr := hzModelBind(want.Elem(), model, source)
+		if errors.Is(werr, hzErrSkip) {
+			col.count("skip ambiguous")
+			return
+		}
+		wantErr := "<nil>"
+		if werr != nil {
+			wantErr = hzBadRequest(werr)
+		}
+
+		got := reflect.New(typ)
+		var gerr error
+		r := hzCatch(func() {
+			switch source {
+			case "query":
+				gerr = echo.BindQueryParams(c, got.Interface())
+			case "param":
+				gerr = echo.BindPathValues(c, got.Interface())
+			case "header":
+				gerr = echo.BindHeaders(c, got.Interface())
+			case "form":
+				gerr = echo.BindBody(c, got.Interface())
+			}
+		})
+		desc := func() string {
+			return fmt.Sprintf("source %s\ntype %s\ndata %v", source, typ, data)
+		}
+		if r != nil {
+			col.failClass(ht, "panic", "%s\npanic: %v", desc(), r)
+			return
+		}
+		if hzErrString(gerr) != wantErr {
+			col.failClass(ht, "error", "%s\n got err %s\nwant err %s\n got %s\nwant %s", desc(), hzErrString(gerr), wantErr, hzDump(got.Elem()), hzDump(want.Elem()))
+			return
+		}
+		if g, w := hzDump(got.Elem()), hzDump(want.Elem()); g != w {
+			col.failClass(ht, "value", "%s\n got %s\nwant %s\nerr %s", desc(), g, w, wantErr)
+			return
+		}
+		if werr != nil {
+			col.count("error")
+		} else {
+			col.count("ok " + source)
+		}
+	})
+}
+
+// TestHegelBind: DefaultBinder.Bind composing the sources in the documented order (path
+// values, then the query for GET/DELETE/HEAD, then the body), the body a form or absent.
+func TestHegelBind(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		method := hzPick(tc, []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete})
+		specs := hzGenSpecs(tc, hzPick(tc, []string{"query", "param", "form"}), 0)
+		typ := hzBuildType(specs)
+		query := hzGenData(tc, false)
+		params := hzGenData(tc, true)
+		var body url.Values
+		if hzChance(tc, 60) {
+			body = hzGenData(tc, false)
+		}
+
+		e := echo.New()
+		target := "/"
+		if len(query) > 0 {
+			target += "?" + query.Encode()
+		}
+		var req *http.Request
+		if body != nil {
+			req = httptest.NewRequest(method, target, strings.NewReader(body.Encode()))
+			req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		} else {
+			req = httptest.NewRequest(method, target, nil)
+		}
+		c := e.NewContext(req, httptest.NewRecorder())
+		c.SetPathValues(hzPathValuesOf(params))
+
+		// The model: path values; the query for GET/DELETE; the body when it has content. The
+		// standard library's ParseForm reads the body for POST/PUT/PATCH only and appends the
+		// URL's query values to every form (bind.go's NB).
+		want := reflect.New(typ)
+		steps := []struct {
+			tag  string
+			data map[string][]string
+		}{}
+		pm := map[string][]string{}
+		for _, pv := range hzPathValuesOf(params) {
+			pm[pv.Name] = []string{pv.Value}
+		}
+		steps = append(steps, struct {
+			tag  string
+			data map[string][]string
+		}{"param", pm})
+		if method == http.MethodGet || method == http.MethodDelete {
+			steps = append(steps, struct {
+				tag  string
+				data map[string][]string
+			}{"query", query})
+		}
+		if body != nil && body.Encode() != "" {
+			form := url.Values{}
+			if method == http.MethodPost || method == http.MethodPut {
+				for k, vs := range body {
+					form[k] = append(form[k], vs...)
+				}
+			}
+			for k, vs := range query {
+				form[k] = append(form[k], vs...)
+			}
+			steps = append(steps, struct {
+				tag  string
+				data map[string][]string
+			}{"form", form})
+		}
+		var werr error
+		for _, st := range steps {
+			if werr = hzModelBind(want.Elem(), st.data, st.tag); werr != nil {
+				break
+			}
+		}
+		if errors.Is(werr, hzErrSkip) {
+			col.count("skip ambiguous")
+			return
+		}
+		wantErr := "<nil>"
+		if werr != nil {
+			wantErr = hzBadRequest(werr)
+		}
+
+		got := reflect.New(typ)
+		var gerr error
+		r := hzCatch(func() { gerr = c.Bind(got.Interface()) })
+		desc := func() string {
+			return fmt.Sprintf("%s %s body %v\ntype %s\nparams %v", method, target, body, typ, params)
+		}
+		if r != nil {
+			col.failClass(ht, "panic", "%s\npanic: %v", desc(), r)
+			return
+		}
+		if hzErrString(gerr) != wantErr {
+			col.failClass(ht, "error", "%s\n got err %s\nwant err %s\n got %s\nwant %s", desc(), hzErrString(gerr), wantErr, hzDump(got.Elem()), hzDump(want.Elem()))
+			return
+		}
+		if g, w := hzDump(got.Elem()), hzDump(want.Elem()); g != w {
+			col.failClass(ht, "value", "%s\n got %s\nwant %s\nerr %s", desc(), g, w, wantErr)
+			return
+		}
+		if werr != nil {
+			col.count("error")
+		} else {
+			col.count("ok " + method)
+		}
+	})
+}
