+var hzRemoveAboveNotFoundCases = hegel.Composite(func(tc hegel.TestCase) hzRemoveCase {
+	path := hegel.Draw(tc, hzPrefixes) + "/" + hegel.Draw(tc, hzWords)
+	method := hegel.Draw(tc, hzStandardMethods)
+	branch := hzNewRoute(hegel.Draw(tc, hzStandardMethods), "/"+hzDiverging(strings.SplitN(path[1:], "/", 2)[0], hegel.Draw(tc, hzPositions)))
+	routes := []*hzRoute{branch, hzNewRoute(echo.RouteNotFound, path)}
+	routes = append(routes, hzShaped(nil, []*hzRoute{hzNewRoute(method, path)})...)
+	routes = append(routes, hzNewRoute(method, path+hegel.Draw(tc, hegel.SampledFrom([]string{"", "/"}))+hegel.Draw(tc, hzWords)))
+	reqs := append([]hzRequest{{method: method, target: hzTargetSpec{fixed: &path}}}, hegel.Draw(tc, hzExtraRequests)...)
+	return hzRemoveCase{routes: routes, mask: hzMaskOf(len(routes), nil, len(routes)-1), reqs: reqs}
+})
