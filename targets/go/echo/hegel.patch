+package hegel
+
+// Pins: one test per recorded bug (bugs.toml echo/1 ...), each asserting the documented
+// behaviour; they fail while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+)
+
+func hzHandler(c *echo.Context) error {
+	var names, vals []string
+	for _, pv := range c.PathValues() {
+		names = append(names, pv.Name)
+		vals = append(vals, pv.Value)
+	}
+	return c.String(200, hzEcho("", c.Path(), names, vals))
+}
+
+// hzServeSafe serves a request, returning the answer or the panic as text.
+func hzServeSafe(e *echo.Echo, method, target string) string {
+	var a hzAnswer
+	if r := hzCatch(func() { a = hzServe(e, method, target) }); r != nil {
+		return "panic: " + hzSprint(r)
+	}
+	return a.String()
+}
+
+func hzSprint(v any) string { return hzAnswer{body: hzFmt(v)}.body }
+
+func hzFmt(v any) string {
+	switch x := v.(type) {
+	case error:
+		return x.Error()
+	case string:
+		return x
+	}
+	return "?"
+}
+
+// TestHegelPinEscapedColonBesideParam: echo/1. A route with an escaped colon ("\:", a literal
+// colon per the router's tests) and a route with a parameter at the same position are two
+// ordinary routes; both must be served, in either order of registration, without a panic.
+func TestHegelPinEscapedColonBesideParam(t *testing.T) {
+	for _, order := range [][]string{{"/name\\:verb/x", "/name:id"}, {"/name:id", "/name\\:verb/x"}} {
+		e := echo.New()
+		for _, p := range order {
+			e.GET(p, hzHandler)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name:verb/x"), `200 "/name\\:verb/x" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name:verb/x\n got %s\nwant %s", order, got, want)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name1"), `200 "/name:id|id=1" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name1\n got %s\nwant %s", order, got, want)
+		}
+	}
+}
+
+// TestHegelPinWildcardStopsBacktracking: echo/2. Priority is static > param > wildcard with
+// backtracking: GET /a/b is served by GET /:x/b although a POST /a/* wildcard sits on the
+// static branch (the wildcard has no GET handler; the router must go on to the alternative).
+func TestHegelPinWildcardStopsBacktracking(t *testing.T) {
+	e := echo.New()
+	e.GET("/:x/b", hzHandler)
+	e.POST("/a/*", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:x/b|x=a" allow=[]`; got != want {
+		t.Errorf("GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinNotFoundRouteShadows: echo/3. A RouteNotFound handler is for "404 cases": a
+// request that a registered route matches must be served by that route. A Group with
+// middleware registers RouteNotFound routes for its prefix; a route with a parameter at the
+// group's position must still be reachable.
+func TestHegelPinNotFoundRouteShadows(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/a", hzHandler)
+	e.GET("/:x", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a"), `200 "/:x|x=a" allow=[]`; got != want {
+		t.Errorf("RouteNotFound /a and GET /:x: GET /a\n got %s\nwant %s", got, want)
+	}
+
+	e = echo.New()
+	g := e.Group("/a", func(next echo.HandlerFunc) echo.HandlerFunc { return next })
+	g.GET("/x", hzHandler)
+	e.GET("/:p/b", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:p/b|p=a" allow=[]`; got != want {
+		t.Errorf("group /a with middleware and GET /:p/b: GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinEscapedPathOption: echo/4. RouterConfig.UseEscapedPathForMatching is documented
+// to make the router match req.URL.RawPath instead of req.URL.Path; without it the decoded
+// path is matched.
+func TestHegelPinEscapedPathOption(t *testing.T) {
+	for _, escaped := range []bool{false, true} {
+		e := echo.NewWithConfig(echo.Config{Router: echo.NewRouter(echo.RouterConfig{
+			AllowOverwritingRoute:     true,
+			UseEscapedPathForMatching: escaped,
+		})})
+		e.GET("/a%2Fb", hzHandler)
+		e.GET("/a/b", hzHandler)
+		want := `200 "/a/b" allow=[]`
+		if escaped {
+			want = `200 "/a%2Fb" allow=[]`
+		}
+		if got := hzServeSafe(e, http.MethodGet, "/a%2Fb"); got != want {
+			t.Errorf("UseEscapedPathForMatching=%v: GET /a%%2Fb\n got %s\nwant %s", escaped, got, want)
+		}
+	}
+}
+
+// TestHegelPinTextAfterWildcard: echo/5. A route path with text after the wildcard ("/a/*/f")
+// is either rejected or matched as written; it must not silently become "/a/*".
+func TestHegelPinTextAfterWildcard(t *testing.T) {
+	e := echo.New()
+	if _, err := e.AddRoute(echo.Route{Method: http.MethodGet, Path: "/a/*/f", Handler: hzHandler}); err != nil {
+		t.Skipf("rejected: %v", err) // acceptable: the documented syntax has nothing after "*"
+	}
+	if got := hzServeSafe(e, http.MethodGet, "/a/c/g"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("route /a/*/f: GET /a/c/g\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinRemoveCustomMethod: echo/6. Remove of a route registered with a custom method
+// (one outside the standard set, kept in the router's map) must remove it, not panic.
+func TestHegelPinRemoveCustomMethod(t *testing.T) {
+	e := echo.New()
+	e.Add("COPY", "/c", hzHandler)
+	var err error
+	if r := hzCatch(func() { err = e.Router().Remove("COPY", "/c") }); r != nil {
+		t.Fatalf("Remove(COPY, /c): panic %v", r)
+	}
+	if err != nil {
+		t.Fatalf("Remove(COPY, /c): %v", err)
+	}
+	if got := hzServeSafe(e, "COPY", "/c"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("after Remove: COPY /c\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinSlashlessRoutePath: echo/7. A route registered without a leading slash gets one
+// (normalizePathSlash); the RouteInfo the router lists must name the route as it serves it,
+// so that Routes().FindByMethodPath(method, c.Path()) finds it and Remove removes it and no
+// other.
+func TestHegelPinSlashlessRoutePath(t *testing.T) {
+	e := echo.New()
+	e.GET("/first", hzHandler)
+	e.GET("users", hzHandler)
+	if got := hzServeSafe(e, http.MethodGet, "/users"); got != `200 "/users" allow=[]` {
+		t.Fatalf("GET /users: got %s", got)
+	}
+	if _, err := e.Router().Routes().FindByMethodPath(http.MethodGet, "/users"); err != nil {
+		t.Errorf("FindByMethodPath(GET, /users): %v; routes %s", err, hzShowInfos(e.Router().Routes()))
+	}
+	if err := e.Router().Remove(http.MethodGet, "users"); err != nil {
+		t.Fatalf("Remove(GET, users): %v", err)
+	}
+	if got, want := hzShowInfos(e.Router().Routes()), "GET /first"; got != want {
+		t.Errorf("after Remove(GET, users): Routes() %s, want %s", got, want)
+	}
+}
+
+// TestHegelPinRemoveFindsRoute: echo/8. Remove(method, path) removes a registered route:
+// after a parameter that more than one route continues from, with an escaped colon, when
+// another route shares its node under other parameter names, and after another removal.
+func TestHegelPinRemoveFindsRoute(t *testing.T) {
+	check := func(name string, e *echo.Echo, method, path string) {
+		if err := e.Router().Remove(method, path); err != nil {
+			t.Errorf("%s: Remove(%s, %s): %v", name, method, path, err)
+		}
+	}
+	e := echo.New()
+	e.GET("/a/:id/b", hzHandler)
+	e.GET("/a/:id/c", hzHandler)
+	check("two routes after a parameter", e, http.MethodGet, "/a/:id/b")
+
+	e = echo.New()
+	e.GET("/file\\:x/a", hzHandler)
+	e.GET("/file.txt", hzHandler)
+	check("escaped colon", e, http.MethodGet, "/file\\:x/a")
+
+	e = echo.New()
+	e.Any("/:p", hzHandler)
+	e.OPTIONS("/:name", hzHandler)
+	check("node re-registered under another name", e, echo.RouteAny, "/:p")
+
+	e = echo.New()
+	e.GET("/file.txt/:q", hzHandler)
+	e.GET("/file\\:undelete/new", hzHandler)
+	check("first removal", e, http.MethodGet, "/file.txt/:q")
+	check("after another removal", e, http.MethodGet, "/file\\:undelete/new")
+}
+
+// TestHegelPinRemoveKeepsNotFound: echo/9. Removing a route must leave the other routes,
+// RouteNotFound routes included; and a RouteNotFound route can itself be removed.
+func TestHegelPinRemoveKeepsNotFound(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/ab", hzHandler)
+	e.GET("/abc", hzHandler)
+	if err := e.Router().Remove(http.MethodGet, "/abc"); err != nil {
+		t.Fatalf("Remove(GET, /abc): %v", err)
+	}
+	if got, want := hzServeSafe(e, http.MethodGet, "/ab"), `200 "/ab" allow=[]`; got != want {
+		t.Errorf("after Remove(GET, /abc): GET /ab\n got %s\nwant the RouteNotFound route: %s", got, want)
+	}
+
+	e = echo.New()
+	e.RouteNotFound("/x", hzHandler)
+	if err := e.Router().Remove(echo.RouteNotFound, "/x"); err != nil {
+		t.Errorf("Remove(RouteNotFound, /x): %v", err)
+	}
+}
+
+// TestHegelPinBindCaseFoldDeterministic: echo/10. The binder's case-insensitive fallback
+// (TestBindQueryParamsCaseInsensitive) must choose the same parameter every time: binding
+// ?ID=1&Id=2 into a field tagged `query:"id"` is one value, not a draw on map order.
+func TestHegelPinBindCaseFoldDeterministic(t *testing.T) {
+	seen := map[int]int{}
+	for i := 0; i < 200; i++ {
+		e := echo.New()
+		c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?ID=1&Id=2", nil), httptest.NewRecorder())
+		var u struct {
+			ID int `query:"id"`
+		}
+		if err := echo.BindQueryParams(c, &u); err != nil {
+			t.Fatalf("BindQueryParams: %v", err)
+		}
+		seen[u.ID]++
+	}
+	if len(seen) != 1 {
+		t.Errorf("BindQueryParams of ?ID=1&Id=2 into `query:\"id\"` over 200 runs: values seen %v", seen)
+	}
+}
+
+// TestHegelPinValueBinderSlicesAfterError: echo/11. With FailFast(false) the binder goes on
+// binding after an error: a slice parameter whose values are all valid is bound although an
+// earlier call failed.
+func TestHegelPinValueBinderSlicesAfterError(t *testing.T) {
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?a=x&b=1&b=2&d=3,4", nil), httptest.NewRecorder())
+	var a int64
+	var bs, ds []int64
+	errs := echo.QueryParamsBinder(c).FailFast(false).Int64("a", &a).Int64s("b", &bs).BindWithDelimiter("d", &ds, ",").BindErrors()
+	if len(errs) != 1 {
+		t.Fatalf("errors: %v", errs)
+	}
+	if !reflect.DeepEqual(bs, []int64{1, 2}) {
+		t.Errorf("Int64s(b) after a failed Int64(a) with FailFast(false): bound %v, want [1 2]", bs)
+	}
+	if !reflect.DeepEqual(ds, []int64{3, 4}) {
+		t.Errorf("BindWithDelimiter(d) after a failed Int64(a) with FailFast(false): bound %v, want [3 4]", ds)
+	}
+}
+
+// TestHegelPinOrDefaultOnParseError: echo/12. QueryParamOr and FormValueOr document their
+// result on an invalid value with the default: `page, err := echo.QueryParamOr[int](c, "page",
+// 1)` "If "page" is "abc": returns (1, BindingError)"; FormValueOr likewise "(100,
+// BindingError)".
+func TestHegelPinOrDefaultOnParseError(t *testing.T) {
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?page=abc", nil), httptest.NewRecorder())
+	page, err := echo.QueryParamOr[int](c, "page", 1)
+	if err == nil || page != 1 {
+		t.Errorf("QueryParamOr[int](page=abc, default 1) = (%d, %v), the documentation says (1, BindingError)", page, err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader("limit=abc"))
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+	c = e.NewContext(req, httptest.NewRecorder())
+	limit, err := echo.FormValueOr[int](c, "limit", 100)
+	if err == nil || limit != 100 {
+		t.Errorf("FormValueOr[int](limit=abc, default 100) = (%d, %v), the documentation says (100, BindingError)", limit, err)
+	}
+}
+
+// TestHegelPinBindNonPointer: echo/13. Bind with a destination that is not a pointer is a
+// programming error the binder reports (as it does for a JSON body: "json: Unmarshal(non-pointer
+// ...)"), not a panic in the handler.
+func TestHegelPinBindNonPointer(t *testing.T) {
+	type user struct {
+		ID int `query:"id"`
+	}
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?id=1", nil), httptest.NewRecorder())
+	var err error
+	if r := hzCatch(func() { err = c.Bind(user{}) }); r != nil {
+		t.Fatalf("Bind(user{}) with a query string panics: %v", r)
+	}
+	if err == nil {
+		t.Errorf("Bind(user{}) with a query string: no error")
+	}
+}
diff --git a/hegel/hegel_zoo_router_test.go b/hegel/hegel_zoo_router_test.go
new file mode 100644
index 0000000..a42b2be
--- /dev/null
+++ b/hegel/hegel_zoo_router_test.go
@@ -0,0 +1,1001 @@
+package hegel
+
+// Route matching against a model of the documented semantics (README, the RouterConfig doc
+// comments, the Route/RouteInfo doc comments): priority static > param > any with backtracking,
+// RouteNotFound routes, 405 with Allow, the default OPTIONS answer, AutoHandleHEAD,
+// UnescapePathParamValues, UseEscapedPathForMatching.
+//
+// A route set is drawn as data (a method and a pattern of segments per route) and rendered by
+// pure functions; a request is a position into the routes plus per-token variations and a
+// tail, applied modulo the live sizes, so an empty variation list is the route's own path.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- routes
+
+type hzTokKind int
+
+const (
+	hzStatic hzTokKind = iota
+	hzParam
+	hzAny
+)
+
+type hzTok struct {
+	kind hzTokKind
+	text string // static text, or the param name
+}
+
+// hzRoute is a registered route: its method (echo.RouteAny, echo.RouteNotFound or an HTTP
+// method), the path as written, and its tokens as the router reads them.
+type hzRoute struct {
+	method string
+	path   string // as registered
+	norm   string // with the leading slash the router adds: what Context.Path reports
+	toks   []hzTok
+	names  []string // parameter names in order ("*" for the wildcard)
+}
+
+// hzTokenize reads a pattern as documented: a leading "/" is added when missing; ":" starts a
+// parameter whose name runs to the next "/"; "\:" is a literal colon; "*" is the wildcard.
+// Text after the wildcard is static text the wildcard's value must be followed by (the router
+// drops it silently: echo/5).
+func hzTokenize(path string) []hzTok {
+	if path == "" {
+		path = "/"
+	} else if path[0] != '/' {
+		path = "/" + path
+	}
+	var toks []hzTok
+	var sb strings.Builder
+	flush := func() {
+		if sb.Len() > 0 {
+			toks = append(toks, hzTok{hzStatic, sb.String()})
+			sb.Reset()
+		}
+	}
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		switch {
+		case c == ':' && i > 0 && path[i-1] == '\\':
+			// the backslash is already in sb: replace it by the colon
+			s := sb.String()
+			sb.Reset()
+			sb.WriteString(s[:len(s)-1])
+			sb.WriteByte(':')
+		case c == ':':
+			flush()
+			j := i + 1
+			for j < len(path) && path[j] != '/' {
+				j++
+			}
+			toks = append(toks, hzTok{hzParam, path[i+1 : j]})
+			i = j - 1
+		case c == '*':
+			flush()
+			toks = append(toks, hzTok{hzAny, "*"})
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	flush()
+	return toks
+}
+
+// hzNormalize is normalizePathSlash: "" is "/", a missing leading slash is added.
+func hzNormalize(path string) string {
+	if path == "" {
+		return "/"
+	}
+	if path[0] != '/' {
+		return "/" + path
+	}
+	return path
+}
+
+func hzNewRoute(method, path string) *hzRoute {
+	r := &hzRoute{method: method, path: path, norm: hzNormalize(path), toks: hzTokenize(path)}
+	for _, t := range r.toks {
+		if t.kind != hzStatic {
+			r.names = append(r.names, t.text)
+		}
+	}
+	return r
+}
+
+// shape is the route's path with parameter names erased: routes of one shape share a node.
+func (r *hzRoute) shape() string {
+	var sb strings.Builder
+	for _, t := range r.toks {
+		switch t.kind {
+		case hzStatic:
+			sb.WriteString(strings.ReplaceAll(t.text, ":", "\\:"))
+		case hzParam:
+			sb.WriteString(":")
+		case hzAny:
+			sb.WriteString("*")
+		}
+	}
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- the tree
+
+// hzNode is a node of a byte trie over the routes: the radix tree the router builds matches
+// exactly as this trie does (its node boundaries only group bytes), with a :param child and a
+// * child beside the static children.
+type hzNode struct {
+	static   map[byte]*hzNode
+	param    *hzNode
+	any      *hzNode
+	methods  map[string]*hzRoute // by method, echo.RouteAny included
+	notFound *hzRoute
+	lastPath string // the path of the last route registered at this node (node.originalPath)
+	parent   *hzNode
+	label    byte // the byte this node hangs off its parent by (static children)
+	boundary bool // the last byte of a node of the router's radix tree, as built (Remove never re-merges nodes)
+	inRoot   bool // part of the radix tree's root node, which Remove never prunes
+}
+
+func hzNewNode() *hzNode { return &hzNode{static: map[byte]*hzNode{}} }
+
+func (n *hzNode) isLeaf() bool { return len(n.static) == 0 && n.param == nil && n.any == nil }
+
+func (n *hzNode) isHandler() bool { return len(n.methods) > 0 }
+
+func hzBuildTree(routes []*hzRoute) *hzNode {
+	root := hzNewNode()
+	for _, r := range routes {
+		n := root
+		for _, t := range r.toks {
+			switch t.kind {
+			case hzStatic:
+				for i := 0; i < len(t.text); i++ {
+					c := n.static[t.text[i]]
+					if c == nil {
+						c = hzNewNode()
+						c.parent, c.label = n, t.text[i]
+						n.static[t.text[i]] = c
+					}
+					n = c
+				}
+			case hzParam:
+				if n.param == nil {
+					n.param = hzNewNode()
+					n.param.parent, n.param.label = n, ':'
+				}
+				n = n.param
+			case hzAny:
+				if n.any == nil {
+					n.any = hzNewNode()
+					n.any.parent, n.any.label = n, '*'
+				}
+				n = n.any
+			}
+		}
+		n.lastPath = r.norm
+		if r.method == echo.RouteNotFound {
+			n.notFound = r
+		} else {
+			if n.methods == nil {
+				n.methods = map[string]*hzRoute{}
+			}
+			n.methods[r.method] = r // a later route of the same shape and method replaces
+		}
+	}
+	hzMarkBoundaries(root)
+	for n := root.static['/']; n != nil; {
+		n.inRoot = true
+		if n.boundary {
+			break
+		}
+		for _, n = range n.static {
+		}
+	}
+	return root
+}
+
+// hzMarkBoundaries marks the byte-nodes where a node of the radix tree ends: a branching, a
+// wildcard child, a route's end.
+func hzMarkBoundaries(n *hzNode) {
+	n.boundary = len(n.static) != 1 || n.param != nil || n.any != nil || n.isHandler() || n.notFound != nil
+	for _, c := range n.static {
+		hzMarkBoundaries(c)
+	}
+	if n.param != nil {
+		hzMarkBoundaries(n.param)
+	}
+	if n.any != nil {
+		hzMarkBoundaries(n.any)
+	}
+}
+
+// hzTailAfterWild reports whether a route has text after its wildcard, which the router drops
+// (echo/5).
+func hzTailAfterWild(routes []*hzRoute) bool {
+	for _, r := range routes {
+		for i, t := range r.toks {
+			if t.kind == hzAny && i+1 < len(r.toks) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hzRouteShapes names the recorded bugs whose shape a route set has: echo/1 when the routes
+// collide on an escaped colon, echo/5 when a route has text after its wildcard.
+func hzRouteShapes(routes []*hzRoute) []string {
+	return append(hzShapeIf(hzCollides(hzBuildTree(routes)), "echo/1"), hzShapeIf(hzTailAfterWild(routes), "echo/5")...)
+}
+
+// hzCollides reports whether some node has both a static child labelled ':' (from an escaped
+// colon) and a :param child: the router then puts one route's nodes under the other's (echo/1)
+// and the tree no longer answers for either.
+func hzCollides(n *hzNode) bool {
+	if n.static[':'] != nil && n.param != nil {
+		return true
+	}
+	for _, c := range n.static {
+		if hzCollides(c) {
+			return true
+		}
+	}
+	if n.param != nil && hzCollides(n.param) {
+		return true
+	}
+	return false
+}
+
+// find is routeMethods.find: the method's route, else (fallback) the Any route; a HEAD request
+// falls back to GET first when autoHandleHEAD.
+func (n *hzNode) find(method string, autoHead bool) *hzRoute {
+	if r := n.methods[method]; r != nil {
+		return r
+	}
+	if method == http.MethodHead && autoHead {
+		if r := n.methods[http.MethodGet]; r != nil {
+			return r
+		}
+	}
+	return n.methods[echo.RouteAny]
+}
+
+var hzAllowOrder = []string{
+	http.MethodConnect, http.MethodDelete, http.MethodGet, http.MethodHead, http.MethodPatch,
+	http.MethodPost, "PROPFIND", http.MethodPut, http.MethodTrace, "REPORT", "QUERY",
+}
+
+// allow is the Allow header of the node, as a sorted set of methods (the router lists the
+// custom methods in map order).
+func (n *hzNode) allow() []string {
+	set := map[string]bool{http.MethodOptions: true}
+	hasAny := n.methods[echo.RouteAny] != nil
+	for _, m := range hzAllowOrder {
+		if hasAny || n.methods[m] != nil {
+			set[m] = true
+		}
+	}
+	for m := range n.methods {
+		if m != echo.RouteAny {
+			set[m] = true
+		}
+	}
+	var out []string
+	for m := range set {
+		out = append(out, m)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --------------------------------------------------------------------------- the walk
+
+type hzWalk struct {
+	method   string
+	autoHead bool
+	sw       hzSwitches
+	values   []string
+	slots    [64]string // the router's pathValues: set on the way down, cleared on backtracking
+	best     *hzNode    // the first node with handlers reached with the whole path consumed
+	// results
+	matched  *hzRoute // the route found for the method (or Any)
+	notFound *hzRoute // the RouteNotFound route that took the request (a stop: sw.notFoundRouteStops)
+	values0  []string // the values at the match
+	nfCand   *hzRoute // the first RouteNotFound route reached with the path consumed, for when no route matches
+	nfValues []string // the values there
+	nfFirst  bool     // it was reached before any node with handlers
+}
+
+// candidate records a RouteNotFound route reached with the path consumed; the search goes on
+// (a request a route matches is not a 404 case) and it answers when nothing matches.
+func (w *hzWalk) candidate(r *hzRoute, first bool) {
+	if w.nfCand == nil {
+		w.nfCand, w.nfValues, w.nfFirst = r, append([]string(nil), w.values...), first
+	}
+}
+
+// step walks the trie in the router's order: at a node whose path is consumed, its handlers;
+// then the static child, the :param child, the * child; a failing branch is abandoned for the
+// next kind. A RouteNotFound route reached on the way is a candidate for when no route matches
+// (with sw.notFoundRouteStops it ends the search: echo/3). It reports whether the walk stopped
+// (a match, or a stop the router makes).
+func (w *hzWalk) step(n *hzNode, search string) bool {
+	if search == "" {
+		if n.isHandler() {
+			if w.best == nil {
+				w.best = n
+			}
+			if r := n.find(w.method, w.autoHead); r != nil {
+				w.matched = r
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+		} else if n.notFound != nil {
+			if w.sw.notFoundRouteStops {
+				w.notFound = n.notFound
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+			w.candidate(n.notFound, w.best == nil)
+		}
+	}
+	if search != "" {
+		if c := n.static[search[0]]; c != nil {
+			if w.step(c, search[1:]) {
+				return true
+			}
+		}
+	}
+	if search != "" && n.param != nil {
+		i := 0
+		if n.param.isLeaf() {
+			i = len(search) // a parameter at the end of its route takes the rest of the path
+		} else {
+			for i < len(search) && search[i] != '/' {
+				i++
+			}
+		}
+		w.push(search[:i])
+		if w.step(n.param, search[i:]) {
+			return true
+		}
+		w.pop()
+	}
+	if a := n.any; a != nil {
+		if !a.isLeaf() {
+			// text after the wildcard (as documented; the router drops it: echo/5): the
+			// wildcard takes the longest value that leaves the text to be matched
+			for i := len(search); i >= 0; i-- {
+				w.push(search[:i])
+				if w.step(a, search[i:]) {
+					return true
+				}
+				w.pop()
+			}
+			return false
+		}
+		w.push(search)
+		if r := a.find(w.method, w.autoHead); r != nil {
+			w.matched = r
+			w.values0 = append([]string(nil), w.values...)
+			return true
+		}
+		if w.best == nil {
+			w.best = a
+		}
+		if a.notFound != nil {
+			if w.sw.notFoundRouteStops {
+				w.notFound = a.notFound
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+			w.candidate(a.notFound, w.best == a)
+		}
+		if w.sw.anyStopsBacktrack {
+			return true // the router does not look past a wildcard node (the value stays set)
+		}
+		w.pop()
+	}
+	return false
+}
+
+func (w *hzWalk) push(v string) {
+	w.slots[len(w.values)] = v
+	w.values = append(w.values, v)
+}
+
+func (w *hzWalk) pop() {
+	w.values = w.values[:len(w.values)-1]
+	w.slots[len(w.values)] = ""
+}
+
+// --------------------------------------------------------------------------- the answer
+
+type hzOptions struct {
+	unescapeValues bool
+	escapedPath    bool
+	autoHead       bool
+}
+
+type hzAnswer struct {
+	code  int
+	body  string
+	allow []string // nil when no Allow header
+}
+
+func (a hzAnswer) String() string {
+	return fmt.Sprintf("%d %q allow=%v", a.code, a.body, a.allow)
+}
+
+// hzEcho is what the test handlers write: the route's path and its values.
+func hzEcho(prefix, path string, names, values []string) string {
+	var sb strings.Builder
+	sb.WriteString(prefix)
+	sb.WriteString(path)
+	for i, v := range values {
+		name := "?"
+		if i < len(names) {
+			name = names[i]
+		}
+		sb.WriteString("|" + name + "=" + v)
+	}
+	return sb.String()
+}
+
+// hzModelServe is the router's answer to a request, from the documentation (or, for the
+// switches of sw that are on, as recorded).
+func hzModelServe(routes []*hzRoute, o hzOptions, method string, u *url.URL, sw hzSwitches) hzAnswer {
+	return hzModelServeTree(hzBuildTree(routes), o, method, u, sw)
+}
+
+// hzModelServeTree is hzModelServe over a built tree.
+func hzModelServeTree(root *hzNode, o hzOptions, method string, u *url.URL, sw hzSwitches) hzAnswer {
+	path := u.Path
+	if o.escapedPath && u.RawPath != "" {
+		path = u.RawPath
+	}
+	if sw.escapedPathInverted {
+		// the option is documented the other way round (echo/4)
+		path = u.Path
+		if !o.escapedPath && u.RawPath != "" {
+			path = u.RawPath
+		}
+	}
+	w := &hzWalk{method: method, autoHead: o.autoHead, sw: sw}
+	w.step(root, path)
+
+	values := func(vs []string) []string {
+		if !o.unescapeValues {
+			return vs
+		}
+		out := make([]string, len(vs))
+		for i, v := range vs {
+			if s, err := url.PathUnescape(v); err == nil {
+				out[i] = s
+			} else {
+				out[i] = v
+			}
+		}
+		return out
+	}
+	if w.matched != nil {
+		r := w.matched
+		body := hzEcho("", r.norm, r.names, values(w.values0))
+		if method == http.MethodHead && r.method == http.MethodGet && o.autoHead {
+			body = "" // the GET handler wrapped for HEAD: the body is dropped
+		}
+		return hzAnswer{code: 200, body: body}
+	}
+	if w.notFound != nil {
+		r := w.notFound
+		return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.values0))}
+	}
+	if r := w.nfCand; r != nil && w.nfFirst {
+		return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.nfValues))}
+	}
+	if w.best != nil {
+		if r := w.best.notFound; r != nil {
+			// the RouteNotFound route of the best node answers before a 405, with whatever the
+			// walk left in the value slots
+			return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.slots[:len(r.names)]))}
+		}
+		allow := w.best.allow()
+		if method == http.MethodOptions {
+			return hzAnswer{code: 204, body: "", allow: allow}
+		}
+		body := "{\"message\":\"Method Not Allowed\"}\n"
+		if method == http.MethodHead {
+			body = ""
+		}
+		return hzAnswer{code: 405, body: body, allow: allow}
+	}
+	body := "{\"message\":\"Not Found\"}\n"
+	if method == http.MethodHead {
+		body = ""
+	}
+	return hzAnswer{code: 404, body: body}
+}
+
+// hzServeSwitch is a router switch of the model and the bug it reproduces.
+type hzServeSwitch struct {
+	id     string
+	toggle func(*hzSwitches)
+}
+
+var hzServeSwitches = []hzServeSwitch{
+	{"echo/2", func(s *hzSwitches) { s.anyStopsBacktrack = !s.anyStopsBacktrack }},
+	{"echo/3", func(s *hzSwitches) { s.notFoundRouteStops = !s.notFoundRouteStops }},
+	{"echo/4", func(s *hzSwitches) { s.escapedPathInverted = !s.escapedPathInverted }},
+}
+
+// hzSwitchShapes names the bugs of the smallest sets of switches (toggled from HZKnown) under
+// which the model agrees with the router; none when no set does.
+func hzSwitchShapes(switches []hzServeSwitch, agrees func(sw hzSwitches) bool) []string {
+	var shapes []string
+	seen := map[string]bool{}
+	for size := 1; size <= len(switches) && len(shapes) == 0; size++ {
+		for mask := 1; mask < 1<<len(switches); mask++ {
+			sw, ids := HZKnown, []string(nil)
+			for i, s := range switches {
+				if mask&(1<<i) != 0 {
+					s.toggle(&sw)
+					ids = append(ids, s.id)
+				}
+			}
+			if len(ids) != size || !agrees(sw) {
+				continue
+			}
+			for _, id := range ids {
+				if !seen[id] {
+					seen[id] = true
+					shapes = append(shapes, id)
+				}
+			}
+		}
+	}
+	sort.Strings(shapes)
+	return shapes
+}
+
+// hzServeShapes names the recorded bugs whose shape a served mismatch has: those of the route
+// set (echo/1, echo/5), and the bugs of the router switches under which the model gives the
+// router's answer.
+func hzServeShapes(routes []*hzRoute, o hzOptions, method string, u *url.URL, got hzAnswer) []string {
+	return append(hzRouteShapes(routes), hzSwitchShapes(hzServeSwitches, func(sw hzSwitches) bool {
+		return hzModelServe(routes, o, method, u, sw).String() == got.String()
+	})...)
+}
+
+// --------------------------------------------------------------------------- the engine
+
+// hzNewEcho builds an Echo with the options and registers the routes (the handlers echo the
+// route path and the path values). Registration errors are returned.
+func hzNewEcho(routes []*hzRoute, o hzOptions) (*echo.Echo, error) {
+	r := echo.NewRouter(echo.RouterConfig{
+		AllowOverwritingRoute:     true,
+		UnescapePathParamValues:   o.unescapeValues,
+		UseEscapedPathForMatching: o.escapedPath,
+		AutoHandleHEAD:            o.autoHead,
+	})
+	e := echo.NewWithConfig(echo.Config{Router: r})
+	for _, rt := range routes {
+		rt := rt
+		prefix, code := "", 200
+		if rt.method == echo.RouteNotFound {
+			prefix, code = "nf:", 404
+		}
+		h := func(c *echo.Context) error {
+			var vals []string
+			var names []string
+			for _, pv := range c.PathValues() {
+				names = append(names, pv.Name)
+				vals = append(vals, pv.Value)
+			}
+			return c.String(code, hzEcho(prefix, c.Path(), names, vals))
+		}
+		if _, err := e.AddRoute(echo.Route{Method: rt.method, Path: rt.path, Handler: h}); err != nil {
+			return nil, err
+		}
+	}
+	return e, nil
+}
+
+// hzServe serves one request and returns the answer.
+func hzServe(e *echo.Echo, method, target string) hzAnswer {
+	req := httptest.NewRequest(method, target, nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	a := hzAnswer{code: rec.Code, body: rec.Body.String()}
+	if h := rec.Header().Get("Allow"); h != "" || rec.Header().Values("Allow") != nil {
+		a.allow = strings.Split(h, ", ")
+		sort.Strings(a.allow)
+	}
+	return a
+}
+
+// hzURLOf parses a request target as httptest.NewRequest does, to give the model the URL.
+func hzURLOf(method, target string) *url.URL {
+	return httptest.NewRequest(method, target, nil).URL
+}
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	hzWordPool      = []string{"a", "b", "ab", "abc", "users", "new", "x1", "file.txt", "v1"}
+	hzWords         = hegel.SampledFrom(hzWordPool)
+	hzParamNames    = hegel.SampledFrom([]string{"id", "name", "p", "q", ""})
+	hzTextPrefixes  = hegel.SampledFrom([]string{"a2", "file.", "name", "v"})
+	hzEscapedColons = hegel.SampledFrom([]string{"file\\:undelete", "name\\:verb", "\\:x"})
+	// hzMethodPool: the request methods a route may be registered with, GET three times.
+	hzMethodPool = []string{
+		http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+		http.MethodDelete, http.MethodPatch, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND",
+	}
+	hzMethods = hegel.SampledFrom(hzMethodPool)
+	// hzRouteMethods: a route's method: the pool, echo.RouteAny and echo.RouteNotFound (a
+	// flat table with GET first, so that a case shrinks to a GET route).
+	hzRouteMethods = hegel.SampledFrom(append(append([]string{}, hzMethodPool...), echo.RouteAny, echo.RouteNotFound))
+	// hzStandardMethodPool: the methods the router keeps out of its anyOther map.
+	hzStandardMethodPool = []string{
+		http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodPatch,
+		http.MethodHead, http.MethodOptions,
+	}
+	hzStandardMethods = hegel.SampledFrom(hzStandardMethodPool)
+)
+
+// hzSegKind is the kind of a segment of a route pattern.
+type hzSegKind int
+
+const (
+	hzSegWord      hzSegKind = iota // static text
+	hzSegParam                      // ":name"
+	hzSegTextParam                  // static text and a parameter in one segment
+	hzSegEscaped                    // an escaped colon
+	hzSegWild                       // "*", ending the pattern; text after it is dropped by the router
+)
+
+// hzSeg is a segment of a route pattern.
+type hzSeg struct {
+	kind   hzSegKind
+	text   string // the word, the prefix of a text-and-parameter segment, or the escaped text
+	name   string // the parameter name
+	tail   string // what follows the wildcard ("" or "/word")
+	escape bool
+}
+
+// String renders the segment as written in the pattern.
+func (s hzSeg) String() string {
+	switch s.kind {
+	case hzSegWord, hzSegEscaped:
+		return s.text
+	case hzSegParam:
+		return ":" + s.name
+	case hzSegTextParam:
+		return s.text + ":" + s.name
+	}
+	return "*" + s.tail
+}
+
+var (
+	hzWordSegs      = hegel.Map(hzWords, func(w string) hzSeg { return hzSeg{kind: hzSegWord, text: w} })
+	hzParamSegs     = hegel.Map(hzParamNames, func(n string) hzSeg { return hzSeg{kind: hzSegParam, name: n} })
+	hzTextParamSegs = hegel.Composite(func(tc hegel.TestCase) hzSeg {
+		return hzSeg{kind: hzSegTextParam, text: hegel.Draw(tc, hzTextPrefixes), name: hegel.Draw(tc, hzParamNames)}
+	})
+	hzEscapedSegs = hegel.Map(hzEscapedColons, func(t string) hzSeg { return hzSeg{kind: hzSegEscaped, text: t} })
+	// hzWildTails: what follows the wildcard: nothing, or a segment 20% of the time (the shape
+	// of echo/5; under HEGEL_NO_KNOWN=1 nothing).
+	hzWildTails = hzShaped(hzMaybe(20, hegel.Map(hzWords, func(w string) string { return "/" + w })), hegel.Just(""))
+	hzWildSegs  = hegel.Map(hzWildTails, func(tail string) hzSeg { return hzSeg{kind: hzSegWild, tail: tail} })
+	// hzSegs: a segment: a word half of the time, a parameter a quarter, the rest text with a
+	// parameter, an escaped colon, or the wildcard.
+	hzSegs = hzWeighted(
+		hzChoice[hzSeg]{50, hzWordSegs},
+		hzChoice[hzSeg]{26, hzParamSegs},
+		hzChoice[hzSeg]{8, hzTextParamSegs},
+		hzChoice[hzSeg]{6, hzEscapedSegs},
+		hzChoice[hzSeg]{10, hzWildSegs},
+	)
+)
+
+// hzPattern is a route pattern: one of the fixed ones ("/", "", "/*", "*"), or one to four
+// segments, without the leading slash 6% of the time (the router adds one) and with a
+// trailing slash 15% of the time.
+type hzPattern struct {
+	fixed    *string
+	noSlash  bool
+	segs     []hzSeg
+	trailing bool
+}
+
+// String renders the pattern.
+func (p hzPattern) String() string {
+	if p.fixed != nil {
+		return *p.fixed
+	}
+	var sb strings.Builder
+	if !p.noSlash {
+		sb.WriteString("/")
+	}
+	for i, s := range p.segs {
+		if i > 0 {
+			sb.WriteString("/")
+		}
+		sb.WriteString(s.String())
+		if s.kind == hzSegWild {
+			return sb.String()
+		}
+	}
+	if p.trailing {
+		sb.WriteString("/")
+	}
+	return sb.String()
+}
+
+var (
+	hzPatterns = hegel.Composite(func(tc hegel.TestCase) hzPattern {
+		return hzPattern{
+			fixed:    hegel.Draw(tc, hzOptional(4, hegel.SampledFrom([]string{"/", "", "/*", "*"}))),
+			noSlash:  hegel.Draw(tc, hzCoin(6)),
+			segs:     hegel.Draw(tc, hzMany(hzSegs, 1, 4)),
+			trailing: hegel.Draw(tc, hzCoin(15)),
+		}
+	})
+	hzPatternTexts = hegel.Map(hzPatterns, hzPattern.String)
+	// hzRoutes: a route of a drawn method and pattern.
+	hzRoutes = hegel.Composite(func(tc hegel.TestCase) *hzRoute {
+		return hzNewRoute(hegel.Draw(tc, hzRouteMethods), hegel.Draw(tc, hzPatternTexts))
+	})
+	// hzRouteLists: one to six routes.
+	hzRouteLists = hzMany(hzRoutes, 1, 6)
+	// hzRouteSets: the route sets of the matching property; under HEGEL_NO_KNOWN=1 the sets
+	// that collide on an escaped colon (echo/1) are left out.
+	hzRouteSets = hzWithoutCollisions(hzRouteLists)
+	// hzDistinctRouteSets: route sets in which no route replaces another (distinct method and
+	// shape), for the properties that reorder or remove routes.
+	hzDistinctRouteSets = hzWithoutCollisions(hegel.Map(hzRouteLists, hzDistinctRoutes))
+)
+
+// hzWithoutCollisions is g without the route sets that collide on an escaped colon under
+// HEGEL_NO_KNOWN=1, and g itself otherwise.
+func hzWithoutCollisions(g hegel.Generator[[]*hzRoute]) hegel.Generator[[]*hzRoute] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(routes []*hzRoute) bool { return !hzCollides(hzBuildTree(routes)) })
+}
+
+// hzDistinctRoutes keeps the first route of each method and shape.
+func hzDistinctRoutes(routes []*hzRoute) []*hzRoute {
+	seen := map[string]bool{}
+	var out []*hzRoute
+	for _, r := range routes {
+		k := r.method + " " + r.shape()
+		if !seen[k] {
+			seen[k] = true
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+var (
+	hzValuePool = []string{"a", "b", "abc", "users", "new", "1", "x/y", "", "%2F", "%20", "a%2Fb", "what%27s", "new2", "skills"}
+	hzValues    = hegel.SampledFrom(hzValuePool)
+	// hzRequestMethods: a request's method, GET three times and HEAD twice.
+	hzRequestMethods = hegel.SampledFrom([]string{
+		http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+		http.MethodDelete, http.MethodHead, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND", "LOCK",
+	})
+	hzFixedTargets = hegel.SampledFrom([]string{"/", "/a", "/users/", "//", "/a//b", "/%2F", "/.", "/../a"})
+)
+
+// hzTokVar is how one token of a route is written into a request target: static text in
+// upper case or a byte short, a parameter's value, the wildcard's value with a second segment.
+type hzTokVar struct {
+	upper, short bool
+	value        string
+	extra        string // "" or "/value" after the wildcard's value
+}
+
+// hzTail is what is appended to (or cut from) the target: a slash, a segment, a query.
+type hzTail struct {
+	kind int // 0 none, 1 a slash, 2 the trailing slash trimmed, 3 a segment, 4 a query
+	word string
+}
+
+var (
+	hzTokVars = hegel.Composite(func(tc hegel.TestCase) hzTokVar {
+		return hzTokVar{
+			upper: hegel.Draw(tc, hzCoin(6)),
+			short: hegel.Draw(tc, hzCoin(5)),
+			value: hegel.Draw(tc, hzValues),
+			extra: hegel.Draw(tc, hzMaybe(40, hegel.Map(hzValues, func(v string) string { return "/" + v }))),
+		}
+	})
+	hzTails = hzWeighted(
+		hzChoice[hzTail]{76, hegel.Just(hzTail{})},
+		hzChoice[hzTail]{8, hegel.Just(hzTail{kind: 1})},
+		hzChoice[hzTail]{6, hegel.Just(hzTail{kind: 2})},
+		hzChoice[hzTail]{6, hegel.Map(hzWords, func(w string) hzTail { return hzTail{kind: 3, word: w} })},
+		hzChoice[hzTail]{4, hegel.Just(hzTail{kind: 4})},
+	)
+)
+
+// hzTargetSpec is a request target: one of the fixed ones 8% of the time, else the pattern
+// of the route at a position (modulo the routes) with its tokens written per the variations
+// (recycled modulo their number; none: the plain text and the first value) and a tail.
+type hzTargetSpec struct {
+	fixed *string
+	route int
+	vars  []hzTokVar
+	tail  hzTail
+}
+
+// render writes the target for the routes.
+func (t hzTargetSpec) render(routes []*hzRoute) string {
+	if t.fixed != nil {
+		return *t.fixed
+	}
+	r := hzAt(routes, t.route)
+	var sb strings.Builder
+	for i, tk := range r.toks {
+		v := hzTokVar{value: hzValuePool[0]}
+		if len(t.vars) > 0 {
+			v = t.vars[i%len(t.vars)]
+		}
+		switch tk.kind {
+		case hzStatic:
+			text := tk.text
+			if v.upper {
+				text = strings.ToUpper(text)
+			}
+			if v.short && len(text) > 1 {
+				text = text[:len(text)-1] // one byte short
+			}
+			sb.WriteString(text)
+		case hzParam:
+			sb.WriteString(v.value)
+		case hzAny:
+			sb.WriteString(v.value + v.extra)
+		}
+	}
+	s := sb.String()
+	switch t.tail.kind {
+	case 1:
+		s += "/"
+	case 2:
+		s = strings.TrimSuffix(s, "/")
+	case 3:
+		s += "/" + t.tail.word
+	case 4:
+		s += "?q=1"
+	}
+	if s == "" || s[0] != '/' {
+		s = "/" + s
+	}
+	return s
+}
+
+var hzTargets = hegel.Composite(func(tc hegel.TestCase) hzTargetSpec {
+	return hzTargetSpec{
+		fixed: hegel.Draw(tc, hzOptional(8, hzFixedTargets)),
+		route: hegel.Draw(tc, hzPositions),
+		vars:  hegel.Draw(tc, hzMany(hzTokVars, 0, 5)),
+		tail:  hegel.Draw(tc, hzTails),
+	}
+})
+
+// hzRequest is a request: its method and target.
+type hzRequest struct {
+	method string
+	target hzTargetSpec
+}
+
+var (
+	hzRequests = hegel.Composite(func(tc hegel.TestCase) hzRequest {
+		return hzRequest{method: hegel.Draw(tc, hzRequestMethods), target: hegel.Draw(tc, hzTargets)}
+	})
+	// hzRequestLists: one to three requests per case.
+	hzRequestLists = hzMany(hzRequests, 1, 3)
+	// hzOptionSets: each router option on 30% of the time.
+	hzOptionSets = hegel.Composite(func(tc hegel.TestCase) hzOptions {
+		return hzOptions{
+			unescapeValues: hegel.Draw(tc, hzCoin(30)),
+			escapedPath:    hegel.Draw(tc, hzCoin(30)),
+			autoHead:       hegel.Draw(tc, hzCoin(30)),
+		}
+	})
+)
+
+// hzShowRoutes renders a route set.
+func hzShowRoutes(routes []*hzRoute) string {
+	var parts []string
+	for _, r := range routes {
+		parts = append(parts, r.method+" "+r.path)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzShowRequests renders the requests of a case for the routes.
+func hzShowRequests(reqs []hzRequest, routes []*hzRoute) string {
+	var parts []string
+	for _, q := range reqs {
+		parts = append(parts, q.method+" "+q.target.render(routes))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// --------------------------------------------------------------------------- properties
+
+// hzRouteCase: a route set, the router options and the requests served.
+type hzRouteCase struct {
+	routes []*hzRoute
+	o      hzOptions
+	reqs   []hzRequest
+}
+
+func (c hzRouteCase) GoString() string {
+	return fmt.Sprintf("routes %s\noptions %+v\nrequests %s", hzShowRoutes(c.routes), c.o, hzShowRequests(c.reqs, c.routes))
+}
+
+var hzRouteCases = hegel.Composite(func(tc hegel.TestCase) hzRouteCase {
+	return hzRouteCase{
+		routes: hegel.Draw(tc, hzRouteSets),
+		o:      hegel.Draw(tc, hzOptionSets),
+		reqs:   hegel.Draw(tc, hzRequestLists),
+	}
+})
+
+// hzServeAgainstModel serves the requests of a case and compares each answer with the model
+// (the shapes of the recorded bugs named on a mismatch); it reports whether every answer
+// agreed.
+func hzServeAgainstModel(c *hzCollector, ht *hegel.T, e *echo.Echo, routes []*hzRoute, o hzOptions, reqs []hzRequest, prefix string) bool {
+	for _, q := range reqs {
+		target := q.target.render(routes)
+		var got hzAnswer
+		if r := hzCatch(func() { got = hzServe(e, q.method, target) }); r != nil {
+			c.mismatch(ht, hzRouteShapes(routes), "panic", "%s\n%s %s\npanic: %v", prefix, q.method, target, r)
+			return false
+		}
+		u := hzURLOf(q.method, target)
+		want := hzModelServe(routes, o, q.method, u, HZKnown)
+		c.count(fmt.Sprintf("%d", got.code))
+		if got.String() != want.String() {
+			c.mismatch(ht, hzServeShapes(routes, o, q.method, u, got), "", "%s\n%s %s\n got %s\nwant %s", prefix, q.method, target, got, want)
+			return false
+		}
+	}
+	return true
+}
+
+// hzCheckRoute registers the case's routes and serves its requests against the model.
+func hzCheckRoute(c *hzCollector, ht *hegel.T, cs hzRouteCase) {
+	e, err := hzNewEcho(cs.routes, cs.o)
+	if err != nil {
+		c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(cs.routes), err)
+		return
+	}
+	hzServeAgainstModel(c, ht, e, cs.routes, cs.o, cs.reqs, fmt.Sprintf("routes %s\noptions %+v", hzShowRoutes(cs.routes), cs.o))
+}
+
+// TestHegelRoute: the engine's answer to generated requests against generated routes, under
+// the router options, against the model.
+func TestHegelRoute(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckRoute(c, ht, hegel.Draw(ht, hzRouteCases))
+	})
+}
diff --git a/hegel/hegel_zoo_shapes_test.go b/hegel/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..54dbc63
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_test.go
@@ -0,0 +1,589 @@
+package hegel
+
+// One narrow property per recorded bug (bugs.toml echo/1 ...): its generator draws the bug's
+// shape region with random contents and the case is judged by the same oracle as the wide
+// properties, so each fails on the bug while it exists (and is listed as an expected failure).
+// Under HEGEL_NO_KNOWN=1 the generator draws the neighbouring region instead - the shape with
+// the one feature that makes the bug removed - where the same oracle must hold.
+
+import (
+	"fmt"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- pieces
+
+var (
+	// hzPrefixes: a path prefix of zero to two words ("", "/w", "/w/w").
+	hzPrefixes = hegel.Map(hzMany(hzWords, 0, 2), func(ws []string) string {
+		var sb strings.Builder
+		for _, w := range ws {
+			sb.WriteString("/" + w)
+		}
+		return sb.String()
+	})
+	// hzSlashWords: a segment with its slash.
+	hzSlashWords = hegel.Map(hzWords, func(w string) string { return "/" + w })
+	// hzPlainRequests: requests without escapes in their targets (which are the shape of
+	// echo/4), so that a narrow property's failures are its own bug's.
+	hzPlainValues  = hegel.SampledFrom([]string{"a", "b", "abc", "users", "new", "1", "x/y", "", "new2"})
+	hzPlainTokVars = hegel.Composite(func(tc hegel.TestCase) hzTokVar {
+		return hzTokVar{
+			upper: hegel.Draw(tc, hzCoin(6)),
+			short: hegel.Draw(tc, hzCoin(5)),
+			value: hegel.Draw(tc, hzPlainValues),
+			extra: hegel.Draw(tc, hzMaybe(40, hegel.Map(hzPlainValues, func(v string) string { return "/" + v }))),
+		}
+	})
+	hzPlainRequests = hegel.Composite(func(tc hegel.TestCase) hzRequest {
+		return hzRequest{method: hegel.Draw(tc, hzRequestMethods), target: hzTargetSpec{
+			route: hegel.Draw(tc, hzPositions),
+			vars:  hegel.Draw(tc, hzMany(hzPlainTokVars, 0, 5)),
+			tail:  hegel.Draw(tc, hzTails),
+		}}
+	})
+	// hzExtraRequests: zero to two requests beside the one of the shape; hzPlainRequestLists
+	// one to three.
+	hzExtraRequests     = hzMany(hzPlainRequests, 0, 2)
+	hzPlainRequestLists = hzMany(hzPlainRequests, 1, 3)
+	// hzCustomMethodPool: methods the router keeps in its anyOther map.
+	hzCustomMethodPool = []string{"COPY", "LOCK", "MKCOL", "MOVE", "PURGE"}
+	hzCustomMethods    = hegel.SampledFrom(hzCustomMethodPool)
+)
+
+// hzOther is an element of the pool other than x, chosen by a drawn position.
+func hzOther(pool []string, x string, at int) string {
+	var others []string
+	for _, p := range pool {
+		if p != x {
+			others = append(others, p)
+		}
+	}
+	return hzAt(others, at)
+}
+
+// hzOrdered is the two routes in the drawn order; it reports the index of the first one.
+func hzOrdered(a, b *hzRoute, swap bool) ([]*hzRoute, int) {
+	if swap {
+		return []*hzRoute{b, a}, 1
+	}
+	return []*hzRoute{a, b}, 0
+}
+
+// hzRoutesAround is the base routes (no route replacing another, none of the special route's
+// method and shape) with the special route first or last.
+func hzRoutesAround(special *hzRoute, base []*hzRoute, last bool) []*hzRoute {
+	var out []*hzRoute
+	for _, r := range hzDistinctRoutes(base) {
+		if r.method != special.method || r.shape() != special.shape() {
+			out = append(out, r)
+		}
+	}
+	if last {
+		return append(out, special)
+	}
+	return append([]*hzRoute{special}, out...)
+}
+
+// hzMaskOf is a removal mask over the routes: the drawn bits (recycled; none: false) with the
+// routes at the indices set.
+func hzMaskOf(n int, bits []bool, indices ...int) []bool {
+	mask := make([]bool, n)
+	for i := range mask {
+		mask[i] = hzAt(bits, i)
+	}
+	for _, i := range indices {
+		mask[i] = true
+	}
+	return mask
+}
+
+// --------------------------------------------------------------------------- the router
+
+// hzEscapedColonCases: echo/1. Two routes, one with an escaped colon after some text, one with
+// a parameter at the same position (past it: one segment further), in either order, plus the
+// request for the escaped route.
+var hzEscapedColonCases = hegel.Composite(func(tc hegel.TestCase) hzRouteCase {
+	prefix := hegel.Draw(tc, hzPrefixes)
+	text := hegel.Draw(tc, hzTextPrefixes)
+	verb := hegel.Draw(tc, hzWords)
+	name := hegel.Draw(tc, hzParamNames)
+	suffix := hegel.Draw(tc, hzMaybe(50, hzSlashWords))
+	sep := hzShaped("", "/")
