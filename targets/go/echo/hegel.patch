+// hzDiverging is a word of the pool whose first byte differs from the segment's, chosen by a
+// drawn position: a route of it branches off at the root, so that the tree's root node ends
+// there.
+func hzDiverging(segment string, at int) string {
+	var others []string
+	for _, w := range hzWordPool {
+		if segment == "" || w[0] != segment[0] {
+			others = append(others, w)
+		}
+	}
+	return hzAt(others, at)
+}
