+package hegel
+
+// The generic accessors (binder_generic.go: ParseValue, ParseValueOr, ParseValues, ParseValuesOr,
+// QueryParam[T] and friends, PathParam[T], FormValue[T]) against their documentation, and
+// Context.QueryParam's raw-query fast path against url.ParseQuery.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// hzGType describes one T of the generic API: the calls with T fixed, the default value's dump,
+// the zero value's dump, and the model's parse.
+type hzGType struct {
+	name     string
+	ptrType  string // reflect type name of *T, for the options error
+	zero     string
+	def      string
+	parse    func(v string, opts []any) (dump string, err error)
+	pv       func(v string, opts []any) (string, error)
+	pvOr     func(v string, opts []any) (string, error)
+	pvs      func(vs []string, opts []any) (string, error)
+	pvsOr    func(vs []string, opts []any) (string, error)
+	qp       func(c *echo.Context, key string, opts []any) (string, error)
+	qpOr     func(c *echo.Context, key string, opts []any) (string, error)
+	qps      func(c *echo.Context, key string, opts []any) (string, error)
+	qpsOr    func(c *echo.Context, key string, opts []any) (string, error)
+	pp       func(c *echo.Context, key string, opts []any) (string, error)
+	ppOr     func(c *echo.Context, key string, opts []any) (string, error)
+	fv       func(c *echo.Context, key string, opts []any) (string, error)
+	fvOr     func(c *echo.Context, key string, opts []any) (string, error)
+	fvs      func(c *echo.Context, key string, opts []any) (string, error)
+	fvsOr    func(c *echo.Context, key string, opts []any) (string, error)
+	timeType bool
+}
+
+func hzGDump[T any](v T) string {
+	switch x := any(v).(type) {
+	case time.Time:
+		return hzTimeDump(x)
+	case hzParamT:
+		return x.V
+	}
+	return fmt.Sprint(v)
+}
+
+func hzGDumps[T any](vs []T) string {
+	if vs == nil {
+		return "nil"
+	}
+	parts := make([]string, len(vs))
+	for i, v := range vs {
+		parts[i] = hzGDump(v)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// hzGMake builds the hzGType for T with a default value and the model's scalar parse.
+func hzGMake[T any](name string, def T, parse func(v string, opts []any) (T, error)) *hzGType {
+	var zero T
+	g := &hzGType{
+		name:    name,
+		ptrType: reflect.TypeFor[*T]().String(),
+		zero:    hzGDump(zero),
+		def:     hzGDump(def),
+	}
+	g.parse = func(v string, opts []any) (string, error) {
+		x, err := parse(v, opts)
+		return hzGDump(x), err
+	}
+	g.pv = func(v string, opts []any) (string, error) {
+		x, err := echo.ParseValue[T](v, opts...)
+		return hzGDump(x), err
+	}
+	g.pvOr = func(v string, opts []any) (string, error) {
+		x, err := echo.ParseValueOr[T](v, def, opts...)
+		return hzGDump(x), err
+	}
+	g.pvs = func(vs []string, opts []any) (string, error) {
+		x, err := echo.ParseValues[T](vs, opts...)
+		return hzGDumps(x), err
+	}
+	g.pvsOr = func(vs []string, opts []any) (string, error) {
+		x, err := echo.ParseValuesOr[T](vs, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	g.qp = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParam[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.qpOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParamOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.qps = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParams[T](c, key, opts...)
+		return hzGDumps(x), err
+	}
+	g.qpsOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParamsOr[T](c, key, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	g.pp = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.PathParam[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.ppOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.PathParamOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.fv = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValue[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.fvOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValueOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.fvs = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValues[T](c, key, opts...)
+		return hzGDumps(x), err
+	}
+	g.fvsOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValuesOr[T](c, key, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	return g
+}
+
+func hzGInt[T int | int8 | int16 | int32 | int64](bits int) func(string, []any) (T, error) {
+	return func(v string, _ []any) (T, error) {
+		n, err := strconv.ParseInt(v, 10, bits)
+		return T(n), err
+	}
+}
+
+func hzGUint[T uint | uint8 | uint16 | uint32 | uint64](bits int) func(string, []any) (T, error) {
+	return func(v string, _ []any) (T, error) {
+		n, err := strconv.ParseUint(v, 10, bits)
+		return T(n), err
+	}
+}
+
+var hzZone = time.FixedZone("hz", 3*3600)
+
+// hzGParseTime is the documented time parsing: layout RFC3339Nano unless TimeLayout / TimeOpts
+// say otherwise, ParseInLocation and ToInLocation defaulting to UTC, the Unix layouts integers.
+func hzGParseTime(v string, opts []any) (time.Time, error) {
+	layout := echo.TimeLayout(time.RFC3339Nano)
+	in, to := time.UTC, time.UTC
+	for _, o := range opts {
+		switch x := o.(type) {
+		case echo.TimeOpts:
+			if x.Layout != "" {
+				layout = x.Layout
+			}
+			if x.ParseInLocation != nil {
+				in = x.ParseInLocation
+			}
+			if x.ToInLocation != nil {
+				to = x.ToInLocation
+			}
+		case echo.TimeLayout:
+			layout = x
+		}
+	}
+	var t time.Time
+	switch layout {
+	case echo.TimeLayoutUnixTime, echo.TimeLayoutUnixTimeMilli, echo.TimeLayoutUnixTimeNano:
+		n, err := strconv.ParseInt(v, 10, 64)
+		if err != nil {
+			return time.Time{}, err
+		}
+		switch layout {
+		case echo.TimeLayoutUnixTime:
+			t = time.Unix(n, 0)
+		case echo.TimeLayoutUnixTimeMilli:
+			t = time.UnixMilli(n)
+		default:
+			t = time.Unix(0, n)
+		}
+	default:
+		var err error
+		t, err = time.ParseInLocation(string(layout), v, in)
+		if err != nil {
+			return time.Time{}, err
+		}
+	}
+	return t.In(to), nil
+}
+
+var hzGTypes = []*hzGType{
+	hzGMake[int]("int", 7, hzGInt[int](0)),
+	hzGMake[int8]("int8", 7, hzGInt[int8](8)),
+	hzGMake[uint16]("uint16", 7, hzGUint[uint16](16)),
+	hzGMake[bool]("bool", true, func(v string, _ []any) (bool, error) { return strconv.ParseBool(v) }),
+	hzGMake[float64]("float64", 2.5, func(v string, _ []any) (float64, error) { return strconv.ParseFloat(v, 64) }),
+	hzGMake[string]("string", "dflt", func(v string, _ []any) (string, error) { return v, nil }),
+	hzGMake[time.Duration]("duration", 3*time.Second, func(v string, _ []any) (time.Duration, error) { return time.ParseDuration(v) }),
+	hzGMake[time.Time]("time", time.Date(2001, 2, 3, 4, 5, 6, 0, time.UTC), hzGParseTime),
+	hzGMake[hzParamT]("param", hzParamT{V: "D"}, func(v string, _ []any) (hzParamT, error) {
+		var p hzParamT
+		err := p.UnmarshalParam(v)
+		return p, err
+	}),
+}
+
+func init() {
+	hzGTypes[7].timeType = true
+}
+
+var hzGValues = []string{"", "0", "1", "-1", "42", "300", "1.5", "true", "T", "x", "bad", "2023-01-15",
+	"2023-01-15T10:00:00Z", "2023-01-15T10:00:00.5+02:00", "1s", "1700000000", "1700000000123", "abc", "-0"}
+
+var hzGOptSets = [][]any{
+	nil,
+	{echo.TimeLayout(hzDateLayout)},
+	{echo.TimeLayoutUnixTime},
+	{echo.TimeLayoutUnixTimeMilli},
+	{echo.TimeLayoutUnixTimeNano},
+	{echo.TimeOpts{Layout: echo.TimeLayout(hzDateLayout), ParseInLocation: hzZone}},
+	{echo.TimeOpts{ToInLocation: hzZone}},
+	{echo.TimeOpts{Layout: echo.TimeLayoutUnixTime, ToInLocation: hzZone}},
+	{echo.TimeLayout(hzDateLayout), echo.TimeOpts{ParseInLocation: hzZone}},
+}
+
+// hzGModelParse: ParseValue's contract. An empty value gives the default (the zero value for
+// ParseValue); options are for time.Time only; a parse error gives the zero value.
+func (g *hzGType) modelParse(v string, def string, opts []any) (string, string) {
+	if v == "" {
+		return def, "<nil>"
+	}
+	if len(opts) > 0 && !g.timeType {
+		return g.zero, "failed to parse value, err: " + fmt.Sprintf("options are only supported for time.Time, got %s", g.ptrType)
+	}
+	dump, err := g.parse(v, opts)
+	if err != nil {
+		return g.zero, "failed to parse value, err: " + err.Error()
+	}
+	return dump, "<nil>"
+}
+
+// modelParseOr: ParseValueOr's contract (the default on an empty value; on a parse error the
+// documentation's examples give the default, the code the zero value).
+func (g *hzGType) modelParseOr(v string, opts []any) (string, string) {
+	dump, err := g.modelParse(v, g.def, opts)
+	if err != "<nil>" && !HZKnown.orReturnsZero {
+		return g.def, err
+	}
+	return dump, err
+}
+
+func (g *hzGType) modelParses(vs []string, def string, opts []any) (string, string) {
+	if len(vs) == 0 {
+		return def, "<nil>"
+	}
+	var parts []string
+	for _, v := range vs {
+		d, err := g.modelParse(v, g.zero, opts)
+		if err != "<nil>" {
+			return "nil", err
+		}
+		parts = append(parts, d)
+	}
+	return "[" + strings.Join(parts, " ") + "]", "<nil>"
+}
+
+func hzBindingErr(key string, message, inner string) string {
+	return "code=400, message=" + message + ", err=" + inner + ", field=" + key
+}
+
+// TestHegelParseValue: the generic accessors against their documentation for nine T's: the
+// value and the error of each call over a query, path values and a form body.
+func TestHegelParseValue(t *testing.T) {
+	col := hzNewCollector(t)
+	nonExistent := echo.ErrNonExistentKey.Error()
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		g := hzPick(tc, hzGTypes)
+		opts := hzGOptSets[0]
+		if g.timeType && hzChance(tc, 70) || !g.timeType && hzChance(tc, 8) {
+			opts = hzPick(tc, hzGOptSets)
+		}
+		key := hzPick(tc, []string{"k", "j"})
+		var values []string
+		if hzChance(tc, 80) {
+			n := 1
+			if hzChance(tc, 30) {
+				n = hzDrawInt(tc, 2, 3)
+			}
+			for i := 0; i < n; i++ {
+				if hzChance(tc, 50) {
+					values = append(values, hzPick(tc, []string{"1", "0", "42", "true", "1s", "2023-01-15T10:00:00Z", "7"}))
+				} else {
+					values = append(values, hzPick(tc, hzGValues))
+				}
+			}
+		}
+		source := hzPick(tc, []string{"query", "path", "form", "parse"})
+		call := hzDrawInt(tc, 0, 3) // 0 single, 1 single Or, 2 slice, 3 slice Or
+
+		// The model.
+		first := ""
+		if len(values) > 0 {
+			first = values[0]
+		}
+		var wantDump, wantErr string
+		message := map[string]string{"query": "query param", "path": "path value", "form": "form value"}[source]
+		messages := map[string]string{"query": "query params", "form": "form values"}[source]
+		switch {
+		case source == "parse" && call == 0:
+			wantDump, wantErr = g.modelParse(first, g.zero, opts)
+		case source == "parse" && call == 1:
+			wantDump, wantErr = g.modelParseOr(first, opts)
+		case source == "parse" && call == 2:
+			wantDump, wantErr = g.modelParses(values, "nil", opts)
+		case source == "parse":
+			wantDump, wantErr = g.modelParses(values, "["+g.def+"]", opts)
+		case source == "path" && call >= 2:
+			col.count("skip no call")
+			return
+		case values == nil && (call == 1 || call == 3):
+			wantDump = g.def
+			if call == 3 {
+				wantDump = "[" + g.def + "]"
+			}
+			wantErr = "<nil>"
+		case values == nil:
+			wantDump, wantErr = g.zero, nonExistent
+			if call == 2 {
+				wantDump = "nil"
+			}
+		case call == 0:
+			wantDump, wantErr = g.modelParse(first, g.zero, opts)
+			if wantErr != "<nil>" {
+				wantErr = hzBindingErr(key, message, wantErr)
+			}
+		case call == 1:
+			wantDump, wantErr = g.modelParseOr(first, opts)
+			if wantErr != "<nil>" {
+				wantErr = hzBindingErr(key, message, wantErr)
+			}
+		case call == 2:
+			wantDump, wantErr = g.modelParses(values, "nil", opts)
+			if wantErr != "<nil>" {
+				wantErr = hzBindingErr(key, messages, wantErr)
+			}
+		default:
+			wantDump, wantErr = g.modelParses(values, "["+g.def+"]", opts)
+			if wantErr != "<nil>" {
+				wantErr = hzBindingErr(key, messages, wantErr)
+			}
+		}
+
+		// The call.
+		e := echo.New()
+		data := url.Values{}
+		for _, v := range values {
+			data.Add(key, v)
+		}
+		if hzChance(tc, 30) {
+			data.Add("other", "1")
+		}
+		var c *echo.Context
+		switch source {
+		case "query":
+			c = e.NewContext(httptest.NewRequest(http.MethodGet, "/?"+data.Encode(), nil), httptest.NewRecorder())
+		case "path":
+			c = e.NewContext(httptest.NewRequest(http.MethodGet, "/", nil), httptest.NewRecorder())
+			pv := echo.PathValues{{Name: "other", Value: "1"}}
+			if values != nil {
+				pv = append(pv, echo.PathValue{Name: key, Value: first})
+			}
+			c.SetPathValues(pv)
+		case "form":
+			req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(data.Encode()))
+			req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+			c = e.NewContext(req, httptest.NewRecorder())
+		}
+		var gotDump string
+		var gotErr error
+		r := hzCatch(func() {
+			switch {
+			case source == "parse" && call == 0:
+				gotDump, gotErr = g.pv(first, opts)
+			case source == "parse" && call == 1:
+				gotDump, gotErr = g.pvOr(first, opts)
+			case source == "parse" && call == 2:
+				gotDump, gotErr = g.pvs(values, opts)
+			case source == "parse":
+				gotDump, gotErr = g.pvsOr(values, opts)
+			case source == "query" && call == 0:
+				gotDump, gotErr = g.qp(c, key, opts)
+			case source == "query" && call == 1:
+				gotDump, gotErr = g.qpOr(c, key, opts)
+			case source == "query" && call == 2:
+				gotDump, gotErr = g.qps(c, key, opts)
+			case source == "query":
+				gotDump, gotErr = g.qpsOr(c, key, opts)
+			case source == "path" && call == 0:
+				gotDump, gotErr = g.pp(c, key, opts)
+			case source == "path":
+				gotDump, gotErr = g.ppOr(c, key, opts)
+			case source == "form" && call == 0:
+				gotDump, gotErr = g.fv(c, key, opts)
+			case source == "form" && call == 1:
+				gotDump, gotErr = g.fvOr(c, key, opts)
+			case source == "form" && call == 2:
+				gotDump, gotErr = g.fvs(c, key, opts)
+			default:
+				gotDump, gotErr = g.fvsOr(c, key, opts)
+			}
+		})
+		desc := func() string {
+			return fmt.Sprintf("%s %s call %d values %q opts %v", g.name, source, call, values, opts)
+		}
+		if r != nil {
+			col.failClass(ht, "panic", "%s\npanic: %v", desc(), r)
+			return
+		}
+		if hzErrString(gotErr) != wantErr {
+			col.failClass(ht, "error", "%s\n got %s err %s\nwant %s err %s", desc(), gotDump, hzErrString(gotErr), wantDump, wantErr)
+			return
+		}
+		if gotDump != wantDump {
+			col.failClass(ht, "value", "%s\n got %s\nwant %s (err %s)", desc(), gotDump, wantDump, wantErr)
+			return
+		}
+		if wantErr != "<nil>" {
+			col.count("error")
+		} else {
+			col.count("ok " + source)
+		}
+	})
+}
+
+// TestHegelQueryParamFastPath: Context.QueryParam (a raw-query scan when QueryParams has not
+// built the map) equals url.ParseQuery(RawQuery).Get(name), as its comment promises, and the
+// map path after QueryParams() agrees.
+func TestHegelQueryParamFastPath(t *testing.T) {
+	col := hzNewCollector(t)
+	atoms := []string{"a", "b", "=", "&", ";", "%", "2", "0", "+", "Z", "%20", "%ZZ", "%2", "a=1", "b=2", "&&", "%3D", "%26"}
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		var sb strings.Builder
+		for i, n := 0, hzDrawInt(tc, 0, 10); i < n; i++ {
+			sb.WriteString(hzPick(tc, atoms))
+		}
+		raw := sb.String()
+		name := hzPick(tc, []string{"a", "a", "b", "b", "", "a=1", "%", "Z", "&"})
+		want, _ := url.ParseQuery(raw)
+		wantV := want.Get(name)
+
+		e := echo.New()
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.URL.RawQuery = raw
+		c := e.NewContext(req, httptest.NewRecorder())
+		var fast, slow string
+		r := hzCatch(func() {
+			fast = c.QueryParam(name)
+			c.QueryParams()
+			slow = c.QueryParam(name)
+		})
+		if r != nil {
+			col.failClass(ht, "panic", "raw %q name %q: panic %v", raw, name, r)
+			return
+		}
+		if fast != wantV {
+			col.failClass(ht, "fast", "raw %q name %q: fast path %q, ParseQuery %q", raw, name, fast, wantV)
+			return
+		}
+		if slow != wantV {
+			col.failClass(ht, "map", "raw %q name %q: map path %q, ParseQuery %q", raw, name, slow, wantV)
+			return
+		}
+		if wantV != "" {
+			col.count("found")
+		} else {
+			col.count("empty")
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_more_test.go b/hegel/hegel_zoo_more_test.go
new file mode 100644
index 0000000..1f2688e
--- /dev/null
+++ b/hegel/hegel_zoo_more_test.go
@@ -0,0 +1,415 @@
+package hegel
+
+// Registration order, RouteInfo.Reverse and DefaultRouter.Remove.
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// hzUniqueRoutes draws routes whose shape+method pairs are distinct (so that no route
+// replaces another) and that do not collide on an escaped colon.
+func hzUniqueRoutes(tc hegel.TestCase) []*hzRoute {
+	for tries := 0; tries < 20; tries++ {
+		routes := hzGenRoutes(tc)
+		seen := map[string]bool{}
+		ok := true
+		for _, r := range routes {
+			k := r.method + " " + r.shape()
+			if r.method == echo.RouteNotFound {
+				k = r.method + " " + r.shape()
+			}
+			if seen[k] {
+				ok = false
+				break
+			}
+			seen[k] = true
+		}
+		if ok && !hzCollides(hzBuildTree(routes)) {
+			return routes
+		}
+	}
+	return []*hzRoute{hzNewRoute(http.MethodGet, "/a")}
+}
+
+// TestHegelRouteOrder: the answers do not depend on the order the routes were registered in
+// (for routes that do not replace one another).
+func TestHegelRouteOrder(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzUniqueRoutes(ht)
+		o := hzOptions{autoHead: hzChance(ht, 30)}
+		e1, err := hzNewEcho(routes, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+			return
+		}
+		// a permutation
+		perm := make([]*hzRoute, len(routes))
+		copy(perm, routes)
+		for i := len(perm) - 1; i > 0; i-- {
+			j := hzDrawInt(ht, 0, i)
+			perm[i], perm[j] = perm[j], perm[i]
+		}
+		e2, err := hzNewEcho(perm, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(perm), err)
+			return
+		}
+		for i := 0; i < 3; i++ {
+			method := hzPick(ht, hzRequestMethods)
+			target := hzGenTarget(ht, routes)
+			var a1, a2 hzAnswer
+			if r := hzCatch(func() { a1 = hzServe(e1, method, target); a2 = hzServe(e2, method, target) }); r != nil {
+				c.failClass(ht, "panic", "routes %s\n%s %s\npanic: %v", hzShowRoutes(routes), method, target, r)
+				return
+			}
+			c.count(fmt.Sprintf("%d", a1.code))
+			if a1.String() != a2.String() {
+				c.failClass(ht, "", "routes %s\nreordered %s\n%s %s\n first %s\nsecond %s", hzShowRoutes(routes), hzShowRoutes(perm), method, target, a1, a2)
+				return
+			}
+		}
+	})
+}
+
+// hzModelReverse is RouteInfo.Reverse as documented: each parameter (":name" up to the next
+// "/", or "*" up to the next "/") replaced by the next value; "\:" is a literal colon.
+func hzModelReverse(path string, values []string) string {
+	var sb strings.Builder
+	n := 0
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		if c == '\\' && i+1 < len(path) && path[i+1] == ':' {
+			sb.WriteByte(':')
+			i++
+			continue
+		}
+		if (c == ':' || c == '*') && n < len(values) {
+			sb.WriteString(values[n])
+			n++
+			for i < len(path) && path[i] != '/' {
+				i++
+			}
+			if i < len(path) {
+				sb.WriteByte('/')
+			}
+			continue
+		}
+		sb.WriteByte(c)
+	}
+	return sb.String()
+}
+
+var hzReverseValues = []string{"a", "b", "abc", "1", "new", "x%20y", "what's", "", "x/y", "a:b"}
+
+// TestHegelReverse: RouteInfo.Reverse against its documentation, and the reversed URL served
+// against the model.
+func TestHegelReverse(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzUniqueRoutes(ht)
+		e, err := hzNewEcho(routes, hzOptions{})
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+			return
+		}
+		infos := e.Router().Routes()
+		if len(infos) != len(routes) {
+			c.failClass(ht, "routes", "routes %s\nRoutes() has %d entries", hzShowRoutes(routes), len(infos))
+			return
+		}
+		ri := hzPick(ht, infos)
+		n := hzDrawInt(ht, 0, len(ri.Parameters)+1)
+		values := make([]string, n)
+		args := make([]any, n)
+		for i := range values {
+			values[i] = hzPick(ht, hzReverseValues)
+			args[i] = values[i]
+		}
+		got := ri.Reverse(args...)
+		want := hzModelReverse(ri.Path, values)
+		if got != want {
+			c.failClass(ht, "reverse", "route %s %q\nvalues %q\n got %q\nwant %q", ri.Method, ri.Path, values, got, want)
+			return
+		}
+		// serve it (when it is a request target)
+		if n != len(ri.Parameters) || strings.Contains(got, "?") || strings.Contains(got, "#") || got == "" || got[0] != '/' {
+			return
+		}
+		for _, v := range values {
+			if v == "" || strings.ContainsAny(v, "/% '") {
+				return
+			}
+		}
+		method := ri.Method
+		if method == echo.RouteAny || method == echo.RouteNotFound {
+			method = http.MethodGet
+		}
+		var a hzAnswer
+		if r := hzCatch(func() { a = hzServe(e, method, got) }); r != nil {
+			c.failClass(ht, "panic", "routes %s\n%s %s\npanic: %v", hzShowRoutes(routes), method, got, r)
+			return
+		}
+		w := hzModelServe(routes, hzOptions{}, method, hzTarget(method, got))
+		c.count(fmt.Sprintf("served %d", a.code))
+		if a.String() != w.String() {
+			c.failClass(ht, "serve", "routes %s\n%s %s (reverse of %s %s with %q)\n got %s\nwant %s", hzShowRoutes(routes), method, got, ri.Method, ri.Path, values, a, w)
+		}
+	})
+}
+
+func hzShowInfos(infos echo.Routes) string {
+	var parts []string
+	for _, ri := range infos {
+		parts = append(parts, ri.Method+" "+ri.Path)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzRadix is a node of the router's radix tree, read off the byte trie: the chain of bytes
+// from a first byte-node through nodes with one static child and nothing else.
+type hzRadix struct {
+	end    *hzNode
+	prefix string
+	kind   hzTokKind
+}
+
+func hzRadixFrom(n *hzNode, kind hzTokKind) hzRadix {
+	if kind != hzStatic {
+		return hzRadix{end: n, prefix: string(n.label), kind: kind}
+	}
+	prefix := []byte{n.label}
+	for !n.boundary {
+		var c *hzNode
+		for _, c = range n.static {
+		}
+		n = c
+		prefix = append(prefix, n.label)
+	}
+	return hzRadix{end: n, prefix: string(prefix), kind: hzStatic}
+}
+
+// hzModelRemove is DefaultRouter.Remove on the model tree: the documented outcome (the route
+// is gone) when the route is registered; with HZKnown.removeLosesWay, the router's own walk
+// down the tree (which loses its way after a parameter, at an escaped colon and at a node
+// whose last registration was another route). Returns whether the removal happened.
+func hzModelRemove(root *hzNode, r *hzRoute) bool {
+	var node *hzNode
+	if HZKnown.removeLosesWay {
+		cur := hzRadixFrom(root.static['/'], hzStatic)
+		path := r.norm
+		prefixLen := 0
+		for {
+			if cur.end.lastPath == path && cur.end.isHandler() {
+				node = cur.end
+				break
+			}
+			if cur.kind == hzStatic {
+				prefixLen += len(cur.prefix)
+			} else {
+				prefixLen = len(cur.end.lastPath)
+			}
+			if prefixLen >= len(path) {
+				break
+			}
+			var next *hzNode
+			kind := hzStatic
+			switch b := path[prefixLen]; b {
+			case ':':
+				next, kind = cur.end.param, hzParam
+			case '*':
+				next, kind = cur.end.any, hzAny
+			default:
+				next = cur.end.static[b]
+			}
+			if next == nil {
+				break
+			}
+			cur = hzRadixFrom(next, kind)
+		}
+		if node == nil {
+			return false
+		}
+	} else {
+		node = root
+		for _, tk := range r.toks {
+			switch tk.kind {
+			case hzStatic:
+				for i := 0; i < len(tk.text) && node != nil; i++ {
+					node = node.static[tk.text[i]]
+				}
+			case hzParam:
+				node = node.param
+			case hzAny:
+				node = node.any
+			}
+			if node == nil {
+				return false
+			}
+		}
+	}
+	if r.method == echo.RouteNotFound {
+		if node.notFound == nil {
+			return false
+		}
+		node.notFound = nil
+	} else {
+		if node.methods[r.method] == nil {
+			return false
+		}
+		delete(node.methods, r.method)
+	}
+	// the router prunes the node and its parents while they are leaves without handlers (a
+	// RouteNotFound route is not a handler to it: HZKnown.removeDropsNotFound)
+	for n := node; n != nil && n.parent != nil && !n.inRoot && n.isLeaf() && !n.isHandler(); n = n.parent {
+		if n.notFound != nil && !HZKnown.removeDropsNotFound {
+			break
+		}
+		switch n.label {
+		case ':':
+			if n.parent.param == n {
+				n.parent.param = nil
+			}
+		case '*':
+			if n.parent.any == n {
+				n.parent.any = nil
+			}
+		}
+		if n.parent.static[n.label] == n {
+			delete(n.parent.static, n.label)
+		}
+	}
+	return true
+}
+
+// TestHegelRemove: after removing some routes, Routes() lists the others and requests are
+// answered as if only the others had been registered.
+func TestHegelRemove(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzUniqueRoutes(ht)
+		// exact method+path pairs must be unique for Remove to be well defined
+		seen := map[string]bool{}
+		seenNorm := map[string]bool{}
+		for _, r := range routes {
+			k := r.method + " " + r.path
+			if seen[k] {
+				return
+			}
+			seen[k] = true
+			seenNorm[r.method+" "+r.norm] = true
+		}
+		e, err := hzNewEcho(routes, hzOptions{})
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+			return
+		}
+		root := hzBuildTree(routes)
+		var removed []*hzRoute
+		var wantInfos []string
+		for _, r := range routes {
+			if hzChance(ht, 40) {
+				removed = append(removed, r)
+			} else {
+				wantInfos = append(wantInfos, r.method+" "+r.path)
+			}
+		}
+		for _, r := range removed {
+			if HZKnown.removeCustomMethodPanics && hzIsCustomMethod(r.method) {
+				c.count("skip custom")
+				return
+			}
+			if HZKnown.removeSlashlessPath && r.path != r.norm {
+				c.count("skip slashless")
+				return
+			}
+			var err error
+			if p := hzCatch(func() { err = e.Router().Remove(r.method, r.path) }); p != nil {
+				c.failClass(ht, "panic", "routes %s\nremove %s %s\npanic: %v", hzShowRoutes(routes), r.method, r.path, p)
+				return
+			}
+			ok := hzModelRemove(root, r)
+			if (err == nil) != ok {
+				c.failClass(ht, "error", "routes %s\nremove %s %s\n got error %v\nwant removed %v", hzShowRoutes(routes), r.method, r.path, err, ok)
+				return
+			}
+			if !ok {
+				c.count("remove failed")
+				// the router's list still has it
+				wantInfos = hzInsertInfo(wantInfos, routes, r)
+			}
+		}
+		// a route that is not there
+		if hzChance(ht, 30) {
+			r := hzNewRoute(hzPick(ht, hzMethods), hzGenPattern(ht))
+			if !seenNorm[r.method+" "+r.norm] && r.path == r.norm && !hzIsCustomMethod(r.method) {
+				var err error
+				if p := hzCatch(func() { err = e.Router().Remove(r.method, r.path) }); p != nil {
+					c.failClass(ht, "panic", "routes %s\nremove absent %s %s\npanic: %v", hzShowRoutes(routes), r.method, r.path, p)
+					return
+				}
+				if err == nil {
+					c.failClass(ht, "absent", "routes %s\nremove absent %s %s: no error", hzShowRoutes(routes), r.method, r.path)
+					return
+				}
+			}
+		}
+		gotInfos := hzShowInfos(e.Router().Routes())
+		if gotInfos != strings.Join(wantInfos, "; ") {
+			c.failClass(ht, "routes", "routes %s\nremoved %s\nRoutes() %s\nwant %s", hzShowRoutes(routes), hzShowRoutes(removed), gotInfos, strings.Join(wantInfos, "; "))
+			return
+		}
+		c.count(fmt.Sprintf("removed %d", len(removed)))
+		for i := 0; i < 3; i++ {
+			method := hzPick(ht, hzRequestMethods)
+			target := hzGenTarget(ht, routes)
+			var got hzAnswer
+			if r := hzCatch(func() { got = hzServe(e, method, target) }); r != nil {
+				c.failClass(ht, "panic", "routes %s\nremoved %s\n%s %s\npanic: %v", hzShowRoutes(routes), hzShowRoutes(removed), method, target, r)
+				return
+			}
+			want := hzModelServeTree(root, hzOptions{}, method, hzTarget(method, target))
+			if got.String() != want.String() {
+				c.failClass(ht, "", "routes %s\nremoved %s\n%s %s\n got %s\nwant %s", hzShowRoutes(routes), hzShowRoutes(removed), method, target, got, want)
+				return
+			}
+		}
+	})
+}
+
+// hzIsCustomMethod: a method the router keeps in its anyOther map.
+func hzIsCustomMethod(m string) bool {
+	switch m {
+	case http.MethodConnect, http.MethodDelete, http.MethodGet, http.MethodHead, http.MethodOptions,
+		http.MethodPatch, http.MethodPost, "PROPFIND", http.MethodPut, http.MethodTrace, "REPORT", "QUERY",
+		echo.RouteAny, echo.RouteNotFound:
+		return false
+	}
+	return true
+}
+
+// hzInsertInfo puts a route that stayed back into the expected Routes() list, in registration
+// order.
+func hzInsertInfo(infos []string, routes []*hzRoute, r *hzRoute) []string {
+	var out []string
+	for _, rt := range routes {
+		k := rt.method + " " + rt.path
+		if rt == r {
+			out = append(out, k)
+			continue
+		}
+		for _, s := range infos {
+			if s == k {
+				out = append(out, k)
+				break
+			}
+		}
+	}
+	return out
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..dc708ff
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,297 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml echo/1 ...), each asserting the documented
+// behaviour; they fail while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+)
+
+func hzHandler(c *echo.Context) error {
+	var names, vals []string
+	for _, pv := range c.PathValues() {
+		names = append(names, pv.Name)
+		vals = append(vals, pv.Value)
+	}
+	return c.String(200, hzEcho("", c.Path(), names, vals))
+}
+
+// hzServeSafe serves a request, returning the answer or the panic as text.
+func hzServeSafe(e *echo.Echo, method, target string) string {
+	var a hzAnswer
+	if r := hzCatch(func() { a = hzServe(e, method, target) }); r != nil {
+		return "panic: " + hzSprint(r)
+	}
+	return a.String()
+}
+
+func hzSprint(v any) string { return hzAnswer{body: hzFmt(v)}.body }
+
+func hzFmt(v any) string {
+	switch x := v.(type) {
+	case error:
+		return x.Error()
+	case string:
+		return x
+	}
+	return "?"
+}
+
+// TestHegelPinEscapedColonBesideParam: echo/1. A route with an escaped colon ("\:", a literal
+// colon per the router's tests) and a route with a parameter at the same position are two
+// ordinary routes; both must be served, in either order of registration, without a panic.
+func TestHegelPinEscapedColonBesideParam(t *testing.T) {
+	for _, order := range [][]string{{"/name\\:verb/x", "/name:id"}, {"/name:id", "/name\\:verb/x"}} {
+		e := echo.New()
+		for _, p := range order {
+			e.GET(p, hzHandler)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name:verb/x"), `200 "/name\\:verb/x" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name:verb/x\n got %s\nwant %s", order, got, want)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name1"), `200 "/name:id|id=1" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name1\n got %s\nwant %s", order, got, want)
+		}
+	}
+}
+
+// TestHegelPinWildcardStopsBacktracking: echo/2. Priority is static > param > wildcard with
+// backtracking: GET /a/b is served by GET /:x/b although a POST /a/* wildcard sits on the
+// static branch (the wildcard has no GET handler; the router must go on to the alternative).
+func TestHegelPinWildcardStopsBacktracking(t *testing.T) {
+	e := echo.New()
+	e.GET("/:x/b", hzHandler)
+	e.POST("/a/*", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:x/b|x=a" allow=[]`; got != want {
+		t.Errorf("GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinNotFoundRouteShadows: echo/3. A RouteNotFound handler is for "404 cases": a
+// request that a registered route matches must be served by that route. A Group with
+// middleware registers RouteNotFound routes for its prefix; a route with a parameter at the
+// group's position must still be reachable.
+func TestHegelPinNotFoundRouteShadows(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/a", hzHandler)
+	e.GET("/:x", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a"), `200 "/:x|x=a" allow=[]`; got != want {
+		t.Errorf("RouteNotFound /a and GET /:x: GET /a\n got %s\nwant %s", got, want)
+	}
+
+	e = echo.New()
+	g := e.Group("/a", func(next echo.HandlerFunc) echo.HandlerFunc { return next })
+	g.GET("/x", hzHandler)
+	e.GET("/:p/b", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:p/b|p=a" allow=[]`; got != want {
+		t.Errorf("group /a with middleware and GET /:p/b: GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinEscapedPathOption: echo/4. RouterConfig.UseEscapedPathForMatching is documented
+// to make the router match req.URL.RawPath instead of req.URL.Path; without it the decoded
+// path is matched.
+func TestHegelPinEscapedPathOption(t *testing.T) {
+	for _, escaped := range []bool{false, true} {
+		e := echo.NewWithConfig(echo.Config{Router: echo.NewRouter(echo.RouterConfig{
+			AllowOverwritingRoute:     true,
+			UseEscapedPathForMatching: escaped,
+		})})
+		e.GET("/a%2Fb", hzHandler)
+		e.GET("/a/b", hzHandler)
+		want := `200 "/a/b" allow=[]`
+		if escaped {
+			want = `200 "/a%2Fb" allow=[]`
+		}
+		if got := hzServeSafe(e, http.MethodGet, "/a%2Fb"); got != want {
+			t.Errorf("UseEscapedPathForMatching=%v: GET /a%%2Fb\n got %s\nwant %s", escaped, got, want)
+		}
+	}
+}
+
+// TestHegelPinTextAfterWildcard: echo/5. A route path with text after the wildcard ("/a/*/f")
+// is either rejected or matched as written; it must not silently become "/a/*".
+func TestHegelPinTextAfterWildcard(t *testing.T) {
+	e := echo.New()
+	if _, err := e.AddRoute(echo.Route{Method: http.MethodGet, Path: "/a/*/f", Handler: hzHandler}); err != nil {
+		t.Skipf("rejected: %v", err) // acceptable: the documented syntax has nothing after "*"
+	}
+	if got := hzServeSafe(e, http.MethodGet, "/a/c/g"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("route /a/*/f: GET /a/c/g\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinRemoveCustomMethod: echo/6. Remove of a route registered with a custom method
+// (one outside the standard set, kept in the router's map) must remove it, not panic.
+func TestHegelPinRemoveCustomMethod(t *testing.T) {
+	e := echo.New()
+	e.Add("COPY", "/c", hzHandler)
+	var err error
+	if r := hzCatch(func() { err = e.Router().Remove("COPY", "/c") }); r != nil {
+		t.Fatalf("Remove(COPY, /c): panic %v", r)
+	}
+	if err != nil {
+		t.Fatalf("Remove(COPY, /c): %v", err)
+	}
+	if got := hzServeSafe(e, "COPY", "/c"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("after Remove: COPY /c\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinSlashlessRoutePath: echo/7. A route registered without a leading slash gets one
+// (normalizePathSlash); the RouteInfo the router lists must name the route as it serves it,
+// so that Routes().FindByMethodPath(method, c.Path()) finds it and Remove removes it and no
+// other.
+func TestHegelPinSlashlessRoutePath(t *testing.T) {
+	e := echo.New()
+	e.GET("/first", hzHandler)
+	e.GET("users", hzHandler)
+	if got := hzServeSafe(e, http.MethodGet, "/users"); got != `200 "/users" allow=[]` {
+		t.Fatalf("GET /users: got %s", got)
+	}
+	if _, err := e.Router().Routes().FindByMethodPath(http.MethodGet, "/users"); err != nil {
+		t.Errorf("FindByMethodPath(GET, /users): %v; routes %s", err, hzShowInfos(e.Router().Routes()))
+	}
+	if err := e.Router().Remove(http.MethodGet, "users"); err != nil {
+		t.Fatalf("Remove(GET, users): %v", err)
+	}
+	if got, want := hzShowInfos(e.Router().Routes()), "GET /first"; got != want {
+		t.Errorf("after Remove(GET, users): Routes() %s, want %s", got, want)
+	}
+}
+
+// TestHegelPinRemoveFindsRoute: echo/8. Remove(method, path) removes a registered route:
+// after a parameter that more than one route continues from, with an escaped colon, when
+// another route shares its node under other parameter names, and after another removal.
+func TestHegelPinRemoveFindsRoute(t *testing.T) {
+	check := func(name string, e *echo.Echo, method, path string) {
+		if err := e.Router().Remove(method, path); err != nil {
+			t.Errorf("%s: Remove(%s, %s): %v", name, method, path, err)
+		}
+	}
+	e := echo.New()
+	e.GET("/a/:id/b", hzHandler)
+	e.GET("/a/:id/c", hzHandler)
+	check("two routes after a parameter", e, http.MethodGet, "/a/:id/b")
+
+	e = echo.New()
+	e.GET("/file\\:x/a", hzHandler)
+	e.GET("/file.txt", hzHandler)
+	check("escaped colon", e, http.MethodGet, "/file\\:x/a")
+
+	e = echo.New()
+	e.Any("/:p", hzHandler)
+	e.OPTIONS("/:name", hzHandler)
+	check("node re-registered under another name", e, echo.RouteAny, "/:p")
+
+	e = echo.New()
+	e.GET("/file.txt/:q", hzHandler)
+	e.GET("/file\\:undelete/new", hzHandler)
+	check("first removal", e, http.MethodGet, "/file.txt/:q")
+	check("after another removal", e, http.MethodGet, "/file\\:undelete/new")
+}
+
+// TestHegelPinRemoveKeepsNotFound: echo/9. Removing a route must leave the other routes,
+// RouteNotFound routes included; and a RouteNotFound route can itself be removed.
+func TestHegelPinRemoveKeepsNotFound(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/ab", hzHandler)
+	e.GET("/abc", hzHandler)
+	if err := e.Router().Remove(http.MethodGet, "/abc"); err != nil {
+		t.Fatalf("Remove(GET, /abc): %v", err)
+	}
+	if got, want := hzServeSafe(e, http.MethodGet, "/ab"), `200 "/ab" allow=[]`; got != want {
+		t.Errorf("after Remove(GET, /abc): GET /ab\n got %s\nwant the RouteNotFound route: %s", got, want)
+	}
+
+	e = echo.New()
+	e.RouteNotFound("/x", hzHandler)
+	if err := e.Router().Remove(echo.RouteNotFound, "/x"); err != nil {
+		t.Errorf("Remove(RouteNotFound, /x): %v", err)
+	}
+}
+
+// TestHegelPinBindCaseFoldDeterministic: echo/10. The binder's case-insensitive fallback
+// (TestBindQueryParamsCaseInsensitive) must choose the same parameter every time: binding
+// ?ID=1&Id=2 into a field tagged `query:"id"` is one value, not a draw on map order.
+func TestHegelPinBindCaseFoldDeterministic(t *testing.T) {
+	seen := map[int]int{}
+	for i := 0; i < 200; i++ {
+		e := echo.New()
+		c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?ID=1&Id=2", nil), httptest.NewRecorder())
+		var u struct {
+			ID int `query:"id"`
+		}
+		if err := echo.BindQueryParams(c, &u); err != nil {
+			t.Fatalf("BindQueryParams: %v", err)
+		}
+		seen[u.ID]++
+	}
+	if len(seen) != 1 {
+		t.Errorf("BindQueryParams of ?ID=1&Id=2 into `query:\"id\"` over 200 runs: values seen %v", seen)
+	}
+}
+
+// TestHegelPinValueBinderSlicesAfterError: echo/11. With FailFast(false) the binder goes on
+// binding after an error: a slice parameter whose values are all valid is bound although an
+// earlier call failed.
+func TestHegelPinValueBinderSlicesAfterError(t *testing.T) {
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?a=x&b=1&b=2&d=3,4", nil), httptest.NewRecorder())
+	var a int64
+	var bs, ds []int64
+	errs := echo.QueryParamsBinder(c).FailFast(false).Int64("a", &a).Int64s("b", &bs).BindWithDelimiter("d", &ds, ",").BindErrors()
+	if len(errs) != 1 {
+		t.Fatalf("errors: %v", errs)
+	}
+	if !reflect.DeepEqual(bs, []int64{1, 2}) {
+		t.Errorf("Int64s(b) after a failed Int64(a) with FailFast(false): bound %v, want [1 2]", bs)
+	}
+	if !reflect.DeepEqual(ds, []int64{3, 4}) {
+		t.Errorf("BindWithDelimiter(d) after a failed Int64(a) with FailFast(false): bound %v, want [3 4]", ds)
+	}
+}
+
+// TestHegelPinOrDefaultOnParseError: echo/12. QueryParamOr and FormValueOr document their
+// result on an invalid value with the default: `page, err := echo.QueryParamOr[int](c, "page",
+// 1)` "If "page" is "abc": returns (1, BindingError)"; FormValueOr likewise "(100,
+// BindingError)".
+func TestHegelPinOrDefaultOnParseError(t *testing.T) {
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?page=abc", nil), httptest.NewRecorder())
+	page, err := echo.QueryParamOr[int](c, "page", 1)
+	if err == nil || page != 1 {
+		t.Errorf("QueryParamOr[int](page=abc, default 1) = (%d, %v), the documentation says (1, BindingError)", page, err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader("limit=abc"))
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+	c = e.NewContext(req, httptest.NewRecorder())
+	limit, err := echo.FormValueOr[int](c, "limit", 100)
+	if err == nil || limit != 100 {
+		t.Errorf("FormValueOr[int](limit=abc, default 100) = (%d, %v), the documentation says (100, BindingError)", limit, err)
+	}
+}
+
+// TestHegelPinBindNonPointer: echo/13. Bind with a destination that is not a pointer is a
+// programming error the binder reports (as it does for a JSON body: "json: Unmarshal(non-pointer
+// ...)"), not a panic in the handler.
+func TestHegelPinBindNonPointer(t *testing.T) {
+	type user struct {
+		ID int `query:"id"`
+	}
+	e := echo.New()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/?id=1", nil), httptest.NewRecorder())
+	var err error
+	if r := hzCatch(func() { err = c.Bind(user{}) }); r != nil {
+		t.Fatalf("Bind(user{}) with a query string panics: %v", r)
+	}
+	if err == nil {
+		t.Errorf("Bind(user{}) with a query string: no error")
+	}
+}
diff --git a/hegel/hegel_zoo_router_test.go b/hegel/hegel_zoo_router_test.go
new file mode 100644
index 0000000..33ce400
--- /dev/null
+++ b/hegel/hegel_zoo_router_test.go
@@ -0,0 +1,694 @@
+package hegel
+
+// Route matching against a model of the documented semantics (README, the RouterConfig doc
+// comments, the Route/RouteInfo doc comments): priority static > param > any with backtracking,
+// RouteNotFound routes, 405 with Allow, the default OPTIONS answer, AutoHandleHEAD,
+// UnescapePathParamValues, UseEscapedPathForMatching.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- routes
+
+type hzTokKind int
+
+const (
+	hzStatic hzTokKind = iota
+	hzParam
+	hzAny
+)
+
+type hzTok struct {
+	kind hzTokKind
+	text string // static text, or the param name
+}
+
+// hzRoute is a registered route: its method (echo.RouteAny, echo.RouteNotFound or an HTTP
+// method), the path as written, and its tokens as the router reads them.
+type hzRoute struct {
+	method string
+	path   string // as registered
+	norm   string // with the leading slash the router adds: what Context.Path reports
+	toks   []hzTok
+	names  []string // parameter names in order ("*" for the wildcard)
+}
+
+// hzTokenize reads a pattern the way DefaultRouter.Add does: a leading "/" is added when
+// missing; ":" starts a parameter whose name runs to the next "/"; "\:" is a literal colon;
+// "*" is the wildcard and ends the pattern (what follows is dropped).
+func hzTokenize(path string) []hzTok {
+	if path == "" {
+		path = "/"
+	} else if path[0] != '/' {
+		path = "/" + path
+	}
+	var toks []hzTok
+	var sb strings.Builder
+	flush := func() {
+		if sb.Len() > 0 {
+			toks = append(toks, hzTok{hzStatic, sb.String()})
+			sb.Reset()
+		}
+	}
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		switch {
+		case c == ':' && i > 0 && path[i-1] == '\\':
+			// the backslash is already in sb: replace it by the colon
+			s := sb.String()
+			sb.Reset()
+			sb.WriteString(s[:len(s)-1])
+			sb.WriteByte(':')
+		case c == ':':
+			flush()
+			j := i + 1
+			for j < len(path) && path[j] != '/' {
+				j++
+			}
+			toks = append(toks, hzTok{hzParam, path[i+1 : j]})
+			i = j - 1
+		case c == '*':
+			flush()
+			toks = append(toks, hzTok{hzAny, "*"})
+			return toks
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	flush()
+	return toks
+}
+
+// hzNormalize is normalizePathSlash: "" is "/", a missing leading slash is added.
+func hzNormalize(path string) string {
+	if path == "" {
+		return "/"
+	}
+	if path[0] != '/' {
+		return "/" + path
+	}
+	return path
+}
+
+func hzNewRoute(method, path string) *hzRoute {
+	r := &hzRoute{method: method, path: path, norm: hzNormalize(path), toks: hzTokenize(path)}
+	for _, t := range r.toks {
+		if t.kind != hzStatic {
+			r.names = append(r.names, t.text)
+		}
+	}
+	return r
+}
+
+// shape is the route's path with parameter names erased: routes of one shape share a node.
+func (r *hzRoute) shape() string {
+	var sb strings.Builder
+	for _, t := range r.toks {
+		switch t.kind {
+		case hzStatic:
+			sb.WriteString(strings.ReplaceAll(t.text, ":", "\\:"))
+		case hzParam:
+			sb.WriteString(":")
+		case hzAny:
+			sb.WriteString("*")
+		}
+	}
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- the tree
+
+// hzNode is a node of a byte trie over the routes: the radix tree the router builds matches
+// exactly as this trie does (its node boundaries only group bytes), with a :param child and a
+// * child beside the static children.
+type hzNode struct {
+	static   map[byte]*hzNode
+	param    *hzNode
+	any      *hzNode
+	methods  map[string]*hzRoute // by method, echo.RouteAny included
+	notFound *hzRoute
+	lastPath string // the path of the last route registered at this node (node.originalPath)
+	parent   *hzNode
+	label    byte // the byte this node hangs off its parent by (static children)
+	boundary bool // the last byte of a node of the router's radix tree, as built (Remove never re-merges nodes)
+	inRoot   bool // part of the radix tree's root node, which Remove never prunes
+}
+
+func hzNewNode() *hzNode { return &hzNode{static: map[byte]*hzNode{}} }
+
+func (n *hzNode) isLeaf() bool { return len(n.static) == 0 && n.param == nil && n.any == nil }
+
+func (n *hzNode) isHandler() bool { return len(n.methods) > 0 }
+
+func hzBuildTree(routes []*hzRoute) *hzNode {
+	root := hzNewNode()
+	for _, r := range routes {
+		n := root
+		for _, t := range r.toks {
+			switch t.kind {
+			case hzStatic:
+				for i := 0; i < len(t.text); i++ {
+					c := n.static[t.text[i]]
+					if c == nil {
+						c = hzNewNode()
+						c.parent, c.label = n, t.text[i]
+						n.static[t.text[i]] = c
+					}
+					n = c
+				}
+			case hzParam:
+				if n.param == nil {
+					n.param = hzNewNode()
+					n.param.parent, n.param.label = n, ':'
+				}
+				n = n.param
+			case hzAny:
+				if n.any == nil {
+					n.any = hzNewNode()
+					n.any.parent, n.any.label = n, '*'
+				}
+				n = n.any
+			}
+		}
+		n.lastPath = r.norm
+		if r.method == echo.RouteNotFound {
+			n.notFound = r
+		} else {
+			if n.methods == nil {
+				n.methods = map[string]*hzRoute{}
+			}
+			n.methods[r.method] = r // a later route of the same shape and method replaces
+		}
+	}
+	hzMarkBoundaries(root)
+	for n := root.static['/']; n != nil; {
+		n.inRoot = true
+		if n.boundary {
+			break
+		}
+		for _, n = range n.static {
+		}
+	}
+	return root
+}
+
+// hzMarkBoundaries marks the byte-nodes where a node of the radix tree ends: a branching, a
+// wildcard child, a route's end.
+func hzMarkBoundaries(n *hzNode) {
+	n.boundary = len(n.static) != 1 || n.param != nil || n.any != nil || n.isHandler() || n.notFound != nil
+	for _, c := range n.static {
+		hzMarkBoundaries(c)
+	}
+	if n.param != nil {
+		hzMarkBoundaries(n.param)
+	}
+	if n.any != nil {
+		hzMarkBoundaries(n.any)
+	}
+}
+
+// hzCollides reports whether some node has both a static child labelled ':' (from an escaped
+// colon) and a :param child: the router then puts one route's nodes under the other's
+// (HZKnown.escapedColonCollision) and the tree no longer answers for either.
+func hzCollides(n *hzNode) bool {
+	if n.static[':'] != nil && n.param != nil {
+		return true
+	}
+	for _, c := range n.static {
+		if hzCollides(c) {
+			return true
+		}
+	}
+	if n.param != nil && hzCollides(n.param) {
+		return true
+	}
+	return false
+}
+
+// find is routeMethods.find: the method's route, else (fallback) the Any route; a HEAD request
+// falls back to GET first when autoHandleHEAD.
+func (n *hzNode) find(method string, autoHead bool) *hzRoute {
+	if r := n.methods[method]; r != nil {
+		return r
+	}
+	if method == http.MethodHead && autoHead {
+		if r := n.methods[http.MethodGet]; r != nil {
+			return r
+		}
+	}
+	return n.methods[echo.RouteAny]
+}
+
+var hzAllowOrder = []string{
+	http.MethodConnect, http.MethodDelete, http.MethodGet, http.MethodHead, http.MethodPatch,
+	http.MethodPost, "PROPFIND", http.MethodPut, http.MethodTrace, "REPORT", "QUERY",
+}
+
+// allow is the Allow header of the node, as a sorted set of methods (the router lists the
+// custom methods in map order).
+func (n *hzNode) allow() []string {
+	set := map[string]bool{http.MethodOptions: true}
+	hasAny := n.methods[echo.RouteAny] != nil
+	for _, m := range hzAllowOrder {
+		if hasAny || n.methods[m] != nil {
+			set[m] = true
+		}
+	}
+	for m := range n.methods {
+		if m != echo.RouteAny {
+			set[m] = true
+		}
+	}
+	var out []string
+	for m := range set {
+		out = append(out, m)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --------------------------------------------------------------------------- the walk
+
+type hzWalk struct {
+	method   string
+	autoHead bool
+	values   []string
+	slots    [64]string // the router's pathValues: set on the way down, cleared on backtracking
+	best     *hzNode    // the first node with handlers reached with the whole path consumed
+	// results
+	matched  *hzRoute // the route found for the method (or Any)
+	notFound *hzRoute // the RouteNotFound route that took the request
+	values0  []string // the values at the match
+}
+
+// step walks the trie in the router's order: at a node whose path is consumed, its handlers;
+// then the static child, the :param child, the * child; a failing branch is abandoned for the
+// next kind. It reports whether the walk stopped (a match, or a stop the router makes).
+func (w *hzWalk) step(n *hzNode, search string) bool {
+	if search == "" {
+		if n.isHandler() {
+			if w.best == nil {
+				w.best = n
+			}
+			if r := n.find(w.method, w.autoHead); r != nil {
+				w.matched = r
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+		} else if n.notFound != nil {
+			if HZKnown.notFoundRouteStops || w.best == nil {
+				w.notFound = n.notFound
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+		}
+	}
+	if search != "" {
+		if c := n.static[search[0]]; c != nil {
+			if w.step(c, search[1:]) {
+				return true
+			}
+		}
+	}
+	if search != "" && n.param != nil {
+		i := 0
+		if n.param.isLeaf() {
+			i = len(search) // a parameter at the end of its route takes the rest of the path
+		} else {
+			for i < len(search) && search[i] != '/' {
+				i++
+			}
+		}
+		w.push(search[:i])
+		if w.step(n.param, search[i:]) {
+			return true
+		}
+		w.pop()
+	}
+	if a := n.any; a != nil {
+		w.push(search)
+		if r := a.find(w.method, w.autoHead); r != nil {
+			w.matched = r
+			w.values0 = append([]string(nil), w.values...)
+			return true
+		}
+		if w.best == nil {
+			w.best = a
+		}
+		if a.notFound != nil && (HZKnown.notFoundRouteStops || w.best == a) {
+			w.notFound = a.notFound
+			w.values0 = append([]string(nil), w.values...)
+			return true
+		}
+		if HZKnown.anyStopsBacktrack {
+			return true // the router does not look past a wildcard node (the value stays set)
+		}
+		w.pop()
+	}
+	return false
+}
+
+func (w *hzWalk) push(v string) {
+	w.slots[len(w.values)] = v
+	w.values = append(w.values, v)
+}
+
+func (w *hzWalk) pop() {
+	w.values = w.values[:len(w.values)-1]
+	w.slots[len(w.values)] = ""
+}
+
+// --------------------------------------------------------------------------- the answer
+
+type hzOptions struct {
+	unescapeValues bool
+	escapedPath    bool
+	autoHead       bool
+}
+
+type hzAnswer struct {
+	code  int
+	body  string
+	allow []string // nil when no Allow header
+}
+
+func (a hzAnswer) String() string {
+	return fmt.Sprintf("%d %q allow=%v", a.code, a.body, a.allow)
+}
+
+// hzEcho is what the test handlers write: the route's path and its values.
+func hzEcho(prefix, path string, names, values []string) string {
+	var sb strings.Builder
+	sb.WriteString(prefix)
+	sb.WriteString(path)
+	for i, v := range values {
+		name := "?"
+		if i < len(names) {
+			name = names[i]
+		}
+		sb.WriteString("|" + name + "=" + v)
+	}
+	return sb.String()
+}
+
+// hzModelServe is the router's answer to a request, from the documentation.
+func hzModelServe(routes []*hzRoute, o hzOptions, method string, u *url.URL) hzAnswer {
+	return hzModelServeTree(hzBuildTree(routes), o, method, u)
+}
+
+// hzModelServeTree is hzModelServe over a built tree.
+func hzModelServeTree(root *hzNode, o hzOptions, method string, u *url.URL) hzAnswer {
+	path := u.Path
+	if !o.escapedPath && u.RawPath != "" {
+		// the option is documented the other way round: see HZKnown.escapedPathInverted
+		path = u.RawPath
+	}
+	if !HZKnown.escapedPathInverted {
+		path = u.Path
+		if o.escapedPath && u.RawPath != "" {
+			path = u.RawPath
+		}
+	}
+	w := &hzWalk{method: method, autoHead: o.autoHead}
+	w.step(root, path)
+
+	values := func(vs []string) []string {
+		if !o.unescapeValues {
+			return vs
+		}
+		out := make([]string, len(vs))
+		for i, v := range vs {
+			if s, err := url.PathUnescape(v); err == nil {
+				out[i] = s
+			} else {
+				out[i] = v
+			}
+		}
+		return out
+	}
+	if w.matched != nil {
+		r := w.matched
+		body := hzEcho("", r.norm, r.names, values(w.values0))
+		if method == http.MethodHead && r.method == http.MethodGet && o.autoHead {
+			body = "" // the GET handler wrapped for HEAD: the body is dropped
+		}
+		return hzAnswer{code: 200, body: body}
+	}
+	if w.notFound != nil {
+		r := w.notFound
+		return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.values0))}
+	}
+	if w.best != nil {
+		if r := w.best.notFound; r != nil {
+			// the RouteNotFound route of the best node answers before a 405, with whatever the
+			// walk left in the value slots
+			return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.slots[:len(r.names)]))}
+		}
+		allow := w.best.allow()
+		if method == http.MethodOptions {
+			return hzAnswer{code: 204, body: "", allow: allow}
+		}
+		body := "{\"message\":\"Method Not Allowed\"}\n"
+		if method == http.MethodHead {
+			body = ""
+		}
+		return hzAnswer{code: 405, body: body, allow: allow}
+	}
+	body := "{\"message\":\"Not Found\"}\n"
+	if method == http.MethodHead {
+		body = ""
+	}
+	return hzAnswer{code: 404, body: body}
+}
+
+// --------------------------------------------------------------------------- the engine
+
+// hzNewEcho builds an Echo with the options and registers the routes (the handlers echo the
+// route path and the path values). Registration errors are returned.
+func hzNewEcho(routes []*hzRoute, o hzOptions) (*echo.Echo, error) {
+	r := echo.NewRouter(echo.RouterConfig{
+		AllowOverwritingRoute:     true,
+		UnescapePathParamValues:   o.unescapeValues,
+		UseEscapedPathForMatching: o.escapedPath,
+		AutoHandleHEAD:            o.autoHead,
+	})
+	e := echo.NewWithConfig(echo.Config{Router: r})
+	for _, rt := range routes {
+		rt := rt
+		prefix, code := "", 200
+		if rt.method == echo.RouteNotFound {
+			prefix, code = "nf:", 404
+		}
+		h := func(c *echo.Context) error {
+			var vals []string
+			var names []string
+			for _, pv := range c.PathValues() {
+				names = append(names, pv.Name)
+				vals = append(vals, pv.Value)
+			}
+			return c.String(code, hzEcho(prefix, c.Path(), names, vals))
+		}
+		if _, err := e.AddRoute(echo.Route{Method: rt.method, Path: rt.path, Handler: h}); err != nil {
+			return nil, err
+		}
+	}
+	return e, nil
+}
+
+// hzServe serves one request and returns the answer.
+func hzServe(e *echo.Echo, method, target string) hzAnswer {
+	req := httptest.NewRequest(method, target, nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	a := hzAnswer{code: rec.Code, body: rec.Body.String()}
+	if h := rec.Header().Get("Allow"); h != "" || rec.Header().Values("Allow") != nil {
+		a.allow = strings.Split(h, ", ")
+		sort.Strings(a.allow)
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzWords = []string{"a", "b", "ab", "abc", "users", "new", "x1", "file.txt", "v1"}
+
+var hzParamNames = []string{"id", "name", "p", "q", ""}
+
+var hzMethods = []string{
+	http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+	http.MethodDelete, http.MethodPatch, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND",
+}
+
+// hzGenPattern draws a route pattern.
+func hzGenPattern(tc hegel.TestCase) string {
+	if hzChance(tc, 4) {
+		return hzPick(tc, []string{"/", "", "/*", "*"})
+	}
+	var sb strings.Builder
+	n := hzDrawInt(tc, 1, 4)
+	if hzChance(tc, 6) {
+		// no leading slash: the router adds one
+	} else {
+		sb.WriteString("/")
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			sb.WriteString("/")
+		}
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 50:
+			sb.WriteString(hzPick(tc, hzWords))
+		case r <= 76:
+			sb.WriteString(":" + hzPick(tc, hzParamNames))
+		case r <= 84:
+			// static text and a parameter in one segment
+			sb.WriteString(hzPick(tc, []string{"a2", "file.", "name", "v"}) + ":" + hzPick(tc, hzParamNames))
+		case r <= 90:
+			// an escaped colon
+			sb.WriteString(hzPick(tc, []string{"file\\:undelete", "name\\:verb", "\\:x"}))
+		default:
+			sb.WriteString("*")
+			if hzChance(tc, 20) {
+				sb.WriteString("/" + hzPick(tc, hzWords)) // dropped by the router
+			}
+			return sb.String()
+		}
+	}
+	if hzChance(tc, 15) {
+		sb.WriteString("/")
+	}
+	return sb.String()
+}
+
+// hzGenRoutes draws 1-6 routes.
+func hzGenRoutes(tc hegel.TestCase) []*hzRoute {
+	n := hzDrawInt(tc, 1, 6)
+	routes := make([]*hzRoute, 0, n)
+	for i := 0; i < n; i++ {
+		method := hzPick(tc, hzMethods)
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 10:
+			method = echo.RouteAny
+		case r <= 20:
+			method = echo.RouteNotFound
+		}
+		routes = append(routes, hzNewRoute(method, hzGenPattern(tc)))
+	}
+	return routes
+}
+
+var hzValues = []string{"a", "b", "abc", "users", "new", "1", "x/y", "", "%2F", "%20", "a%2Fb", "what%27s", "new2", "skills"}
+
+// hzGenTarget draws a request target: mostly the routes' own patterns with values filled in,
+// with variations (case, trailing slash, an extra segment, a missing one).
+func hzGenTarget(tc hegel.TestCase, routes []*hzRoute) string {
+	if hzChance(tc, 8) {
+		return hzPick(tc, []string{"/", "/a", "/users/", "//", "/a//b", "/%2F", "/.", "/../a"})
+	}
+	r := hzPick(tc, routes)
+	var sb strings.Builder
+	for _, t := range r.toks {
+		switch t.kind {
+		case hzStatic:
+			text := t.text
+			if hzChance(tc, 6) {
+				text = strings.ToUpper(text)
+			}
+			if hzChance(tc, 5) && len(text) > 1 {
+				text = text[:len(text)-1] // one byte short
+			}
+			sb.WriteString(text)
+		case hzParam:
+			sb.WriteString(hzPick(tc, hzValues))
+		case hzAny:
+			sb.WriteString(hzPick(tc, hzValues))
+			if hzChance(tc, 40) {
+				sb.WriteString("/" + hzPick(tc, hzValues))
+			}
+		}
+	}
+	s := sb.String()
+	switch r := hzDrawInt(tc, 1, 100); {
+	case r <= 8:
+		s += "/"
+	case r <= 14:
+		s = strings.TrimSuffix(s, "/")
+	case r <= 20:
+		s += "/" + hzPick(tc, hzWords)
+	case r <= 24:
+		s += "?q=1"
+	}
+	if s == "" || s[0] != '/' {
+		s = "/" + s
+	}
+	return s
+}
+
+var hzRequestMethods = []string{
+	http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+	http.MethodDelete, http.MethodHead, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND", "LOCK",
+}
+
+// hzShowRoutes renders a route set.
+func hzShowRoutes(routes []*hzRoute) string {
+	var parts []string
+	for _, r := range routes {
+		parts = append(parts, r.method+" "+r.path)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzTarget parses a request target as httptest.NewRequest does, to give the model the URL.
+func hzTarget(method, target string) *url.URL {
+	return httptest.NewRequest(method, target, nil).URL
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelRoute: the engine's answer to generated requests against generated routes, under
+// the router options, against the model.
+func TestHegelRoute(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzGenRoutes(ht)
+		o := hzOptions{
+			unescapeValues: hzChance(ht, 30),
+			escapedPath:    hzChance(ht, 30),
+			autoHead:       hzChance(ht, 30),
+		}
+		if HZKnown.escapedColonCollision && hzCollides(hzBuildTree(routes)) {
+			c.count("collision")
+			return
+		}
+		e, err := hzNewEcho(routes, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+			return
+		}
+		for i := 0; i < 3; i++ {
+			method := hzPick(ht, hzRequestMethods)
+			target := hzGenTarget(ht, routes)
+			var got hzAnswer
+			if r := hzCatch(func() { got = hzServe(e, method, target) }); r != nil {
+				c.failClass(ht, "panic", "routes %s\noptions %+v\n%s %s\npanic: %v", hzShowRoutes(routes), o, method, target, r)
+				return
+			}
+			want := hzModelServe(routes, o, method, hzTarget(method, target))
+			c.count(fmt.Sprintf("%d", got.code))
+			if got.String() != want.String() {
+				c.failClass(ht, "", "routes %s\noptions %+v\n%s %s\n got %s\nwant %s", hzShowRoutes(routes), o, method, target, got, want)
+				return
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..f765350
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,171 @@
+package hegel
+
+// Hegel property tests for labstack/echo v5's router, written for the Hegel zoo. See
+// targets/go/echo/README.md. They live in a package of their own (hegel/) and drive the router
+// through the public API: echo.NewWithConfig with a NewRouter(RouterConfig{...}), AddRoute, and
+// ServeHTTP on httptest requests, the handlers echoing the route and its path values.
+//
+// Oracles: a model of route matching (static text first, then a :param, then a *, with
+// backtracking; RouteNotFound routes; 405 with the Allow header; the default OPTIONS answer;
+// AutoHandleHEAD; the escaped-path and unescape-values options) over generated route sets and
+// requests; the law that registration order does not matter; RouteInfo.Reverse round trips;
+// Remove leaving the other routes as they were. Part 2 (hegel_zoo_bind_test.go,
+// hegel_zoo_vbinder_test.go, hegel_zoo_generic_test.go): the struct binder, the ValueBinder
+// chains and the generic accessors against models of their documentation.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	anyStopsBacktrack        bool // a wildcard node without the method ends the search: alternatives above it are not tried
+	notFoundRouteStops       bool // a RouteNotFound route reached with the path consumed ends the search before lower-priority routes
+	escapedPathInverted      bool // UseEscapedPathForMatching selects the decoded path, the default the escaped one
+	escapedColonCollision    bool // an escaped colon and a :param at one position corrupt the tree (routes lost, a panic)
+	removeCustomMethodPanics bool // Remove of a route with a custom method panics
+	removeSlashlessPath      bool // Remove of a route registered without a leading slash deletes another RouteInfo
+	removeLosesWay           bool // Remove does not find routes after a parameter, with an escaped colon, or at a node re-registered under another path
+	removeDropsNotFound      bool // Remove prunes a RouteNotFound route on its way up the tree
+	caseFoldRandom           bool // bindData's case-insensitive fallback picks a random key when several match
+	slicesNeedNoErrors       bool // ValueBinder's slice methods bind only while no error at all has been recorded
+	orReturnsZero            bool // QueryParamOr & co. return the zero value, not the default, on a parse error
+}{true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
diff --git a/hegel/hegel_zoo_vbinder_test.go b/hegel/hegel_zoo_vbinder_test.go
new file mode 100644
index 0000000..ba48704
--- /dev/null
+++ b/hegel/hegel_zoo_vbinder_test.go
@@ -0,0 +1,809 @@
+package hegel
+
+// The ValueBinder (binder.go): chains of typed binding calls over query parameters, path values
+// or form fields, with FailFast on or off, against a model of the documented semantics.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// hzJSONT implements json.Unmarshaler: an integer.
+type hzJSONT struct{ N int }
+
+func (j *hzJSONT) UnmarshalJSON(b []byte) error { return json.Unmarshal(b, &j.N) }
+
+// hzVOp is one call of a chain: run performs it on the binder, dump prints the destination,
+// and model computes the expected outcome from the parameter's values.
+type hzVOp struct {
+	name   string
+	must   bool
+	slice  bool // a slice destination (the *[]string ones are set unconditionally: plain)
+	plain  bool
+	run    func(b *echo.ValueBinder, param string)
+	dump   func() string
+	model  func(first string, values []string) (dump string, errs []string)
+	initst string // the dump before binding
+	pname  string // the parameter the op is called with
+	all    bool   // every error is recorded even with FailFast (CustomFunc)
+}
+
+// hzVErr formats a BindingError as its Error() does.
+func hzVErr(param, message string, err error) string {
+	s := "code=400, message=" + message
+	if err != nil {
+		s += ", err=" + err.Error()
+	}
+	return s + ", field=" + param
+}
+
+const hzRequired = "required field value is empty"
+
+func hzTimeDump(t time.Time) string { return t.UTC().Format(time.RFC3339Nano) }
+
+// hzVOps builds the ops with fresh destinations for one chain. The sentinel initial values
+// show what a call left unbound.
+func hzVOps(tc hegel.TestCase, n int) []*hzVOp {
+	var ops []*hzVOp
+	for i := 0; i < n; i++ {
+		must := hzChance(tc, 30)
+		kind := hzDrawInt(tc, 0, 23)
+		op := &hzVOp{must: must}
+		switch kind {
+		case 0:
+			d := "init"
+			op.name, op.run = "String", func(b *echo.ValueBinder, p string) {
+				if must {
+					b.MustString(p, &d)
+				} else {
+					b.String(p, &d)
+				}
+			}
+			op.dump = func() string { return d }
+			op.model = func(first string, values []string) (string, []string) {
+				if first == "" {
+					if must {
+						return "init", []string{hzVErr(op.param(), hzRequired, nil)}
+					}
+					return "init", nil
+				}
+				return first, nil
+			}
+		case 1:
+			d := []string{"init"}
+			op.slice, op.plain = true, true
+			op.name, op.run = "Strings", func(b *echo.ValueBinder, p string) {
+				if must {
+					b.MustStrings(p, &d)
+				} else {
+					b.Strings(p, &d)
+				}
+			}
+			op.dump = func() string { return fmt.Sprint(d) }
+			op.model = func(first string, values []string) (string, []string) {
+				if values == nil {
+					if must {
+						return "[init]", []string{hzVErr(op.param(), hzRequired, nil)}
+					}
+					return "[init]", nil
+				}
+				return fmt.Sprint(values), nil
+			}
+		case 2, 3, 4:
+			bits := []int{64, 8, 0}[kind-2]
+			var d64 int64 = 99
+			var d8 int8 = 99
+			var d int = 99
+			tname := "int" + map[int]string{64: "64", 8: "8", 0: ""}[bits]
+			op.name = "Int" + map[int]string{64: "64", 8: "8", 0: ""}[bits]
