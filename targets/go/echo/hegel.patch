+// param is set per chain step (the parameter name the op is called with).
+func (op *hzVOp) param() string { return op.pname }
+
+var hzVValues = []string{"", "0", "1", "-1", "42", "300", "1.5", "true", "T", "x", "bad", "2023-01-15",
+	"1s", "1,2", "1,x", "true,false", "1s,2m", "1700000000", "-0", "abc"}
+
+// hzVSafeValues parse for most of the ops.
+var hzVSafeValues = []string{"1", "0", "42", "true", "1s", "2023-01-15", "1,2", "1700000000", "7"}
+
+// TestHegelValueBinder: a chain of 1-6 calls on a QueryParamsBinder, PathValuesBinder or
+// FormFieldBinder, FailFast on or off, against the model: each destination after the chain
+// and BindErrors().
+func TestHegelValueBinder(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		source := hzPick(tc, []string{"query", "param", "form"})
+		data := url.Values{}
+		names := []string{"a", "b", "c", "d"}
+		for _, name := range names {
+			if hzChance(tc, 60) {
+				k := 1
+				if source != "param" && hzChance(tc, 30) {
+					k = hzDrawInt(tc, 2, 3)
+				}
+				for j := 0; j < k; j++ {
+					if hzChance(tc, 60) {
+						data.Add(name, hzPick(tc, hzVSafeValues))
+					} else {
+						data.Add(name, hzPick(tc, hzVValues))
+					}
+				}
+			}
+		}
+		failFast := hzChance(tc, 50)
+		ops := hzVOps(tc, hzDrawInt(tc, 1, 6))
+		for _, op := range ops {
+			op.pname = hzPick(tc, names)
+		}
+
+		e := echo.New()
+		var req *http.Request
+		switch source {
+		case "query":
+			req = httptest.NewRequest(http.MethodGet, "/?"+data.Encode(), nil)
+		case "param":
+			req = httptest.NewRequest(http.MethodGet, "/", nil)
+		case "form":
+			req = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(data.Encode()))
+			req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		}
+		c := e.NewContext(req, httptest.NewRecorder())
+		var b *echo.ValueBinder
+		switch source {
+		case "query":
+			b = echo.QueryParamsBinder(c)
+		case "param":
+			c.SetPathValues(hzPathValuesOf(data))
+			b = echo.PathValuesBinder(c)
+		case "form":
+			b = echo.FormFieldBinder(c)
+		}
+		if !failFast {
+			b.FailFast(false)
+		}
+
+		// The model. ValueFunc gives the first value ("" when absent), ValuesFunc all of them
+		// (nil when absent; a path value that is "" counts as absent).
+		var wantErrs []string
+		wantDumps := make([]string, len(ops))
+		for i, op := range ops {
+			wantDumps[i] = op.initst
+			if failFast && len(wantErrs) > 0 {
+				continue
+			}
+			values := data[op.pname]
+			first := ""
+			if len(values) > 0 {
+				first = values[0]
+			}
+			if source == "param" && first == "" {
+				values = nil
+			}
+			dump, errs := op.model(first, values)
+			if failFast && !op.all && len(errs) > 1 {
+				errs = errs[:1] // the first failing element ends the call
+			}
+			before := len(wantErrs)
+			wantErrs = append(wantErrs, errs...)
+			if op.slice && !op.plain && len(errs) == 0 && HZKnown.slicesNeedNoErrors && before > 0 {
+				continue // bug: the slice is set only while the binder holds no error at all
+			}
+			wantDumps[i] = dump
+		}
+
+		var gotErrs []error
+		r := hzCatch(func() {
+			for _, op := range ops {
+				op.run(b, op.pname)
+			}
+			gotErrs = b.BindErrors()
+		})
+		desc := func() string {
+			var names []string
+			for _, op := range ops {
+				names = append(names, op.name+"("+op.pname+")")
+			}
+			return fmt.Sprintf("%s %v failFast=%v\nchain %s", source, data, failFast, strings.Join(names, " "))
+		}
+		if r != nil {
+			col.failClass(ht, "panic", "%s\npanic: %v", desc(), r)
+			return
+		}
+		var got []string
+		for _, err := range gotErrs {
+			got = append(got, err.Error())
+		}
+		if fmt.Sprint(got) != fmt.Sprint(wantErrs) {
+			col.failClass(ht, "errors", "%s\n got errors %q\nwant errors %q", desc(), got, wantErrs)
+			return
+		}
+		for i, op := range ops {
+			if g := op.dump(); g != wantDumps[i] {
+				col.failClass(ht, "value", "%s\nop %d %s: got %s want %s (errors %q)", desc(), i, op.name, g, wantDumps[i], got)
+				return
+			}
+		}
+		if len(wantErrs) > 0 {
+			col.count("errors")
+		} else {
+			col.count("ok " + source)
+		}
+	})
+}
