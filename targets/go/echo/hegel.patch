+package hegel
+
+// The struct binder (bind.go: BindQueryParams, BindPathValues, BindHeaders, BindBody for form
+// bodies, and DefaultBinder.Bind composing them) against a model of the documented semantics
+// over struct types built with reflect.StructOf. A struct type is drawn as a tree of field
+// specs (a leaf type and its wrapping, or a nested struct) and the parameters as a map of
+// names to value lists; both are rendered by pure functions.
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- leaf types
+
+// hzParamT implements echo.BindUnmarshaler: values starting with "bad" fail.
+type hzParamT struct{ V string }
+
+func (p *hzParamT) UnmarshalParam(s string) error {
+	if strings.HasPrefix(s, "bad") {
+		return errors.New("hzParam: " + s)
+	}
+	p.V = "P(" + s + ")"
+	return nil
+}
+
+// hzTextT implements encoding.TextUnmarshaler.
+type hzTextT struct{ V string }
+
+func (p *hzTextT) UnmarshalText(b []byte) error {
+	if strings.HasPrefix(string(b), "bad") {
+		return errors.New("hzText: " + string(b))
+	}
+	p.V = "T(" + string(b) + ")"
+	return nil
+}
+
+// hzMultiT implements the binder's UnmarshalParams (all values at once).
+type hzMultiT struct{ V []string }
+
+func (p *hzMultiT) UnmarshalParams(ps []string) error {
+	for _, s := range ps {
+		if strings.HasPrefix(s, "bad") {
+			return errors.New("hzMulti: " + s)
+		}
+	}
+	p.V = append([]string{"M"}, ps...)
+	return nil
+}
+
+type hzMultiUnmarshaler interface{ UnmarshalParams([]string) error }
+
+const hzDateLayout = "2006-01-02"
+
+// --------------------------------------------------------------------------- type specs
+
+const (
+	hzLString = iota
+	hzLInt
+	hzLInt8
+	hzLUint16
+	hzLUint64
+	hzLFloat64
+	hzLBool
+	hzLTime
+	hzLTimeFmt // time.Time with a format tag
+	hzLDuration
+	hzLParam
+	hzLText
+	hzLMulti
+	hzLCount
+)
+
+const (
+	hzWNone = iota
+	hzWSlice
+	hzWPtr
+	hzWPtrSlice
+	hzWSlicePtr
+	hzWCount
+)
+
+const (
+	hzFLeaf       = iota
+	hzFStruct     // a named field of struct type (untagged: flattened; tagged: an error)
+	hzFAnon       // an embedded struct
+	hzFAnonPtr    // an embedded *struct (nil while binding: skipped)
+	hzFTaggedList // a tagged nested struct: "unknown type"
+)
+
+type hzFieldSpec struct {
+	kind   int
+	leaf   int
+	wrap   int
+	tags   map[string]string // tag name -> parameter name
+	sub    []*hzFieldSpec
+	tagged bool // for hzFStruct / hzFAnon: carries a tag
+}
+
+var hzLeafTypes = map[int]reflect.Type{
+	hzLString:   reflect.TypeFor[string](),
+	hzLInt:      reflect.TypeFor[int](),
+	hzLInt8:     reflect.TypeFor[int8](),
+	hzLUint16:   reflect.TypeFor[uint16](),
+	hzLUint64:   reflect.TypeFor[uint64](),
+	hzLFloat64:  reflect.TypeFor[float64](),
+	hzLBool:     reflect.TypeFor[bool](),
+	hzLTime:     reflect.TypeFor[time.Time](),
+	hzLTimeFmt:  reflect.TypeFor[time.Time](),
+	hzLDuration: reflect.TypeFor[time.Duration](),
+	hzLParam:    reflect.TypeFor[hzParamT](),
+	hzLText:     reflect.TypeFor[hzTextT](),
+	hzLMulti:    reflect.TypeFor[hzMultiT](),
+}
+
+func hzWrapType(t reflect.Type, wrap int) reflect.Type {
+	switch wrap {
+	case hzWSlice:
+		return reflect.SliceOf(t)
+	case hzWPtr:
+		return reflect.PointerTo(t)
+	case hzWPtrSlice:
+		return reflect.PointerTo(reflect.SliceOf(t))
+	case hzWSlicePtr:
+		return reflect.SliceOf(reflect.PointerTo(t))
+	}
+	return t
+}
+
+var hzBindSources = []string{"query", "param", "form", "header"}
+
+func hzTagString(tags map[string]string, format string) reflect.StructTag {
+	var parts []string
+	for _, k := range hzSortedKeys(tags) {
+		parts = append(parts, fmt.Sprintf("%s:%q", k, tags[k]))
+	}
+	if format != "" {
+		parts = append(parts, fmt.Sprintf("format:%q", format))
+	}
+	return reflect.StructTag(strings.Join(parts, " "))
+}
+
+// hzBuildType builds the struct type of a spec list.
+func hzBuildType(specs []*hzFieldSpec) reflect.Type {
+	fields := make([]reflect.StructField, 0, len(specs))
+	for i, s := range specs {
+		f := reflect.StructField{Name: fmt.Sprintf("F%d", i)}
+		switch s.kind {
+		case hzFLeaf:
+			f.Type = hzWrapType(hzLeafTypes[s.leaf], s.wrap)
+			format := ""
+			if s.leaf == hzLTimeFmt {
+				format = hzDateLayout
+			}
+			f.Tag = hzTagString(s.tags, format)
+		case hzFStruct, hzFTaggedList:
+			f.Type = hzBuildType(s.sub)
+			if s.tagged {
+				f.Tag = hzTagString(s.tags, "")
+			}
+		case hzFAnon:
+			f.Type = hzBuildType(s.sub)
+			f.Anonymous = true
+			if s.tagged {
+				f.Tag = hzTagString(s.tags, "")
+			}
+		case hzFAnonPtr:
+			f.Type = reflect.PointerTo(hzBuildType(s.sub))
+			f.Anonymous = true
+		}
+		fields = append(fields, f)
+	}
+	return reflect.StructOf(fields)
+}
+
+// --------------------------------------------------------------------------- the model
+
+// hzErrSkip marks a case the model cannot decide while a switch is on.
+var hzErrSkip = errors.New("skip")
+
+// hzBindModel binds as bind.go documents, under the switches; ambiguous records that a lookup
+// had several names equal ignoring case and none exact (the shape of echo/10).
+type hzBindModel struct {
+	sw        hzSwitches
+	ambiguous bool
+}
+
+// lookup finds name in data: the exact key first, else the keys equal ignoring case (the
+// first in order; with sw.caseFoldRandom a case with several is undecidable).
+func (m *hzBindModel) lookup(data map[string][]string, name string) (vals []string, found bool, err error) {
+	if v, ok := data[name]; ok {
+		return v, true, nil
+	}
+	var keys []string
+	for k := range data {
+		if strings.EqualFold(k, name) {
+			keys = append(keys, k)
+		}
+	}
+	if len(keys) == 0 {
+		return nil, false, nil
+	}
+	if len(keys) > 1 {
+		m.ambiguous = true
+		if m.sw.caseFoldRandom {
+			return nil, false, hzErrSkip
+		}
+	}
+	sort.Strings(keys)
+	return data[keys[0]], true, nil
+}
+
+// bind binds data into the struct dst points to, per the documented semantics: fields with
+// the source's tag are bound (in declaration order; the first failure stops), untagged struct
+// fields are descended into, embedded pointers that are nil are skipped, a tag on an embedded
+// struct is an error.
+func (m *hzBindModel) bind(dst reflect.Value, data map[string][]string, tag string) error {
+	if len(data) == 0 {
+		return nil // nothing to bind: the shape of the destination is not looked at
+	}
+	typ := dst.Type()
+	for i := 0; i < typ.NumField(); i++ {
+		sf := typ.Field(i)
+		fv := dst.Field(i)
+		if sf.Anonymous && fv.Kind() == reflect.Pointer {
+			if fv.IsNil() {
+				continue
+			}
+			fv = fv.Elem()
+		}
+		name := sf.Tag.Get(tag)
+		if sf.Anonymous && fv.Kind() == reflect.Struct && name != "" {
+			return errors.New("query/param/form tags are not allowed with anonymous struct field")
+		}
+		if name == "" {
+			if fv.Kind() == reflect.Struct {
+				if _, ok := fv.Addr().Interface().(echo.BindUnmarshaler); !ok {
+					if err := m.bind(fv, data, tag); err != nil {
+						return err
+					}
+				}
+			}
+			continue
+		}
+		vals, found, err := m.lookup(data, name)
+		if err != nil {
+			return err
+		}
+		if !found {
+			continue
+		}
+		if err := hzModelSet(fv, vals, sf.Tag.Get("format"), true); err != nil {
+			return fmt.Errorf("%s: %w", name, err)
+		}
+	}
+	return nil
+}
+
+// hzModelSet sets one field (top) or one slice element from the values.
+func hzModelSet(fv reflect.Value, vals []string, format string, top bool) error {
+	if fv.Kind() == reflect.Pointer {
+		if fv.IsNil() {
+			fv.Set(reflect.New(fv.Type().Elem()))
+		}
+		return hzModelSet(fv.Elem(), vals, format, top)
+	}
+	addr := fv.Addr().Interface()
+	if top {
+		if m, ok := addr.(hzMultiUnmarshaler); ok {
+			return m.UnmarshalParams(vals)
+		}
+		if t, ok := addr.(*time.Time); ok && format != "" {
+			parsed, err := time.Parse(format, vals[0])
+			if err != nil {
+				return err
+			}
+			*t = parsed
+			return nil
+		}
+	}
+	switch u := addr.(type) {
+	case echo.BindUnmarshaler:
+		return u.UnmarshalParam(vals[0])
+	case interface{ UnmarshalText([]byte) error }:
+		return u.UnmarshalText([]byte(vals[0]))
+	}
+	if top && fv.Kind() == reflect.Slice {
+		s := reflect.MakeSlice(fv.Type(), len(vals), len(vals))
+		for j, v := range vals {
+			if err := hzModelSet(s.Index(j), []string{v}, "", false); err != nil {
+				return err
+			}
+		}
+		fv.Set(s)
+		return nil
+	}
+	v := vals[0]
+	switch fv.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if v == "" {
+			v = "0"
+		}
+		n, err := strconv.ParseInt(v, 10, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetInt(n)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if v == "" {
+			v = "0"
+		}
+		n, err := strconv.ParseUint(v, 10, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetUint(n)
+	case reflect.Bool:
+		if v == "" {
+			v = "false"
+		}
+		b, err := strconv.ParseBool(v)
+		if err != nil {
+			return err
+		}
+		fv.SetBool(b)
+	case reflect.Float32, reflect.Float64:
+		if v == "" {
+			v = "0.0"
+		}
+		f, err := strconv.ParseFloat(v, fv.Type().Bits())
+		if err != nil {
+			return err
+		}
+		fv.SetFloat(f)
+	case reflect.String:
+		fv.SetString(v)
+	default:
+		return errors.New("unknown type")
+	}
+	return nil
+}
+
+// hzIntBits: strconv's bitSize for the kind (0 for int/uint means the platform size; the
+// binder passes 0 and reflect reports 64, which parse alike).
+func init() {
+	if reflect.TypeFor[int]().Bits() != 64 {
+		panic("hegel zoo: the model assumes 64-bit ints")
+	}
+}
+
+// hzDump prints a value canonically (pointers as &v or nil, slices in brackets, times in UTC).
+func hzDump(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return "nil"
+		}
+		return "&" + hzDump(v.Elem())
+	case reflect.Slice:
+		if v.IsNil() {
+			return "nil"
+		}
+		parts := make([]string, v.Len())
+		for i := range parts {
+			parts[i] = hzDump(v.Index(i))
+		}
+		return "[" + strings.Join(parts, " ") + "]"
+	case reflect.Struct:
+		if t, ok := v.Interface().(time.Time); ok {
+			return t.UTC().Format(time.RFC3339Nano)
+		}
+		parts := make([]string, v.NumField())
+		for i := range parts {
+			parts[i] = v.Type().Field(i).Name + ":" + hzDump(v.Field(i))
+		}
+		return "{" + strings.Join(parts, " ") + "}"
+	}
+	return fmt.Sprintf("%v", v.Interface())
+}
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	hzBindNamePool = []string{"id", "ID", "Id", "name", "Name", "n", "x-id", "X-Id", "a", "b", "c"}
+	hzBindNames    = hegel.SampledFrom(hzBindNamePool)
+	// hzBindSafeValuePool parse for most leaf types.
+	hzBindSafeValuePool = []string{"", "0", "1", "42", "-1", "7"}
+	hzBindValuePool     = []string{"", "0", "1", "-1", "42", "300", "65536", "1.5", "true", "false", "T",
+		"x", "bad", "2023-01-15", "2023-01-15T10:00:00Z", "p1", "1s", "-0", " 1", "9223372036854775808",
+		"1e3", "yes", "0x10"}
+	// hzBindValues: a parameter value, one that parses for most types 55% of the time.
+	hzBindValues = hzWeighted(
+		hzChoice[string]{55, hegel.SampledFrom(hzBindSafeValuePool)},
+		hzChoice[string]{45, hegel.SampledFrom(hzBindValuePool)},
+	)
+	hzLeafKinds   = hegel.Integers(0, hzLCount-1)
+	hzWraps       = hzWeighted(hzChoice[int]{60, hegel.Just(hzWNone)}, hzChoice[int]{40, hegel.Integers(hzWSlice, hzWCount-1)})
+	hzNestedKinds = hegel.SampledFrom([]int{hzFStruct, hzFStruct, hzFAnon, hzFAnon, hzFAnonPtr, hzFTaggedList})
+)
+
+// hzTagsFor: the tags of a field bound from the source: the source's tag 85% of the time and
+// each other source's 15%, named from the pool.
+func hzTagsFor(source string) hegel.Generator[map[string]string] {
+	own, other := hzMaybe(85, hzBindNames), hzMaybe(15, hzBindNames)
+	return hegel.Composite(func(tc hegel.TestCase) map[string]string {
+		tags := map[string]string{}
+		for _, s := range hzBindSources {
+			g := other
+			if s == source {
+				g = own
+			}
+			if name := hegel.Draw(tc, g); name != "" {
+				tags[s] = name
+			}
+		}
+		return tags
+	})
+}
+
+// hzLeafSpecsFor: a leaf field bound from the source: a type of the thirteen, plain or wrapped
+// 40% of the time, with tags.
+func hzLeafSpecsFor(source string) hegel.Generator[*hzFieldSpec] {
+	tags := hzTagsFor(source)
+	return hegel.Composite(func(tc hegel.TestCase) *hzFieldSpec {
+		return &hzFieldSpec{kind: hzFLeaf, leaf: hegel.Draw(tc, hzLeafKinds), wrap: hegel.Draw(tc, hzWraps), tags: hegel.Draw(tc, tags)}
+	})
+}
+
+// hzSpecsFor: the field specs of a struct type bound from the source: one to four fields per
+// level, each a leaf (a type of the thirteen, plain or wrapped 40% of the time) 80% of the
+// time and a nested struct otherwise (a named struct, an embedded struct tagged 15% of the
+// time, an embedded pointer, or a tagged struct), two levels deep.
+func hzSpecsFor(source string) hegel.Generator[[]*hzFieldSpec] {
+	tags := hzTagsFor(source)
+	leaves := hzLeafSpecsFor(source)
+	nested := func(sub hegel.Generator[[]*hzFieldSpec]) hegel.Generator[*hzFieldSpec] {
+		return hegel.Composite(func(tc hegel.TestCase) *hzFieldSpec {
+			s := &hzFieldSpec{kind: hegel.Draw(tc, hzNestedKinds), sub: hegel.Draw(tc, sub), tags: hegel.Draw(tc, tags)}
+			switch s.kind {
+			case hzFTaggedList:
+				s.tagged = true
+				if len(s.tags) == 0 {
+					s.tags[source] = hegel.Draw(tc, hzBindNames)
+				}
+			case hzFAnon:
+				s.tagged = hegel.Draw(tc, hzCoin(15))
+			}
+			return s
+		})
+	}
+	level := hzMany(leaves, 1, 4) // the deepest level holds leaves only
+	for depth := 1; depth >= 0; depth-- {
+		fields := hzWeighted(hzChoice[*hzFieldSpec]{80, leaves}, hzChoice[*hzFieldSpec]{20, nested(level)})
+		level = hzMany(fields, 1, 4)
+	}
+	return level
+}
+
+// hzSpecGens: the struct specs per source.
+var hzSpecGens = func() map[string]hegel.Generator[[]*hzFieldSpec] {
+	m := map[string]hegel.Generator[[]*hzFieldSpec]{}
+	for _, s := range hzBindSources {
+		m[s] = hzSpecsFor(s)
+	}
+	return m
+}()
+
+// hzFoldDistinct keeps the first parameter (in order) of each set of names equal ignoring
+// case, the shape of echo/10 being several.
+func hzFoldDistinct(data url.Values) url.Values {
+	out := url.Values{}
+	for _, k := range hzSortedKeys(data) {
+		clash := false
+		for seen := range out {
+			if strings.EqualFold(seen, k) {
+				clash = true
+			}
+		}
+		if !clash {
+			out[k] = data[k]
+		}
+	}
+	return out
+}
+
+// hzDataFor: min to five parameters named from the pool, each with one value (single) or with
+// two or three 30% of the time; under HEGEL_NO_KNOWN=1 no two names equal ignoring case
+// (echo/10).
+func hzDataFor(single bool, min int) hegel.Generator[url.Values] {
+	values := hzMany(hzBindValues, 1, 1)
+	if !single {
+		values = hzWeighted(hzChoice[[]string]{70, hzMany(hzBindValues, 1, 1)}, hzChoice[[]string]{30, hzMany(hzBindValues, 2, 3)})
+	}
+	shape := hzShaped(func(v url.Values) url.Values { return v }, hzFoldDistinct)
+	return hegel.Map(hegel.Maps(hzBindNames, values).MinSize(min).MaxSize(5), func(m map[string][]string) url.Values {
+		return shape(url.Values(hzNonNilMap(m)))
+	})
+}
+
+var (
+	hzSingleData = hzDataFor(true, 0)
+	hzMultiData  = hzDataFor(false, 0)
+)
+
+func hzPathValuesOf(data url.Values) echo.PathValues {
+	pv := echo.PathValues{}
+	for _, k := range hzSortedKeys(data) {
+		pv = append(pv, echo.PathValue{Name: k, Value: data[k][0]})
+	}
+	return pv
+}
+
+func hzHeaderOf(data url.Values) http.Header {
+	h := http.Header{}
+	for _, k := range hzSortedKeys(data) {
+		for _, v := range data[k] {
+			h.Add(k, v)
+		}
+	}
+	return h
+}
+
+// hzBadRequest formats the error the binder wraps a binding failure in.
+func hzBadRequest(err error) string {
+	return "code=400, message=Bad Request, err=" + err.Error()
+}
+
+func hzErrString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// --------------------------------------------------------------------------- the properties
+
+// hzBindDataCase: a source, the struct type bound from it and the parameters.
+type hzBindDataCase struct {
+	source string
+	specs  []*hzFieldSpec
+	data   url.Values
+}
+
+func (c hzBindDataCase) GoString() string {
+	return fmt.Sprintf("source %s\ntype %s\ndata %v", c.source, hzBuildType(c.specs), c.data)
+}
+
+var hzBindDataCases = hegel.FlatMap(hegel.SampledFrom(hzBindSources), func(source string) hegel.Generator[hzBindDataCase] {
+	data := hzMultiData
+	if source == "param" {
+		data = hzSingleData
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzBindDataCase {
+		return hzBindDataCase{source: source, specs: hegel.Draw(tc, hzSpecGens[source]), data: hegel.Draw(tc, data)}
+	})
+})
+
+// hzFoldReps is how many times a case whose lookup is ambiguous (echo/10) is bound: the binder
+// picks a parameter at random each time (about 9 to 1 for two names, by the map's iteration
+// order), so a few bindings may all agree with the model by chance; 200 leave no room for it.
+const hzFoldReps = 200
+
+// hzBindReps is the number of bindings of a case: one, or hzFoldReps when the model found a
+// lookup ambiguous.
+func hzBindReps(m *hzBindModel) int {
+	if m.ambiguous {
+		return hzFoldReps
+	}
+	return 1
+}
+
+// hzCompareBound compares the binder's outcome with the model's: the error text and the dump
+// of the bound value; shape names the recorded bugs whose shape the case has. It reports
+// whether they agreed.
+func hzCompareBound(col *hzCollector, ht *hegel.T, desc string, r any, gerr error, wantErr string, got, want reflect.Value, shape []string) bool {
+	if r != nil {
+		col.mismatch(ht, shape, "panic", "%s\npanic: %v", desc, r)
+		return false
+	}
+	if hzErrString(gerr) != wantErr {
+		col.mismatch(ht, shape, "error", "%s\n got err %s\nwant err %s\n got %s\nwant %s", desc, hzErrString(gerr), wantErr, hzDump(got.Elem()), hzDump(want.Elem()))
+		return false
+	}
+	if g, w := hzDump(got.Elem()), hzDump(want.Elem()); g != w {
+		col.mismatch(ht, shape, "value", "%s\n got %s\nwant %s\nerr %s", desc, g, w, wantErr)
+		return false
+	}
+	return true
+}
+
+// hzCountBound counts an agreed case.
+func hzCountBound(col *hzCollector, wantErr string) {
+	if wantErr != "<nil>" {
+		col.count("error")
+	} else {
+		col.count("ok")
+	}
+}
+
+// hzCheckBindData binds the case's data from its source into its struct type with the source's
+// binder and compares with the model.
+func hzCheckBindData(col *hzCollector, ht *hegel.T, cs hzBindDataCase) {
+	source, data := cs.source, cs.data
+	typ := hzBuildType(cs.specs)
+
+	e := echo.New()
+	var req *http.Request
+	var model map[string][]string
+	switch source {
+	case "query":
+		req = httptest.NewRequest(http.MethodGet, "/?"+data.Encode(), nil)
+		model = data
+	case "param":
+		req = httptest.NewRequest(http.MethodGet, "/", nil)
+		model = map[string][]string{}
+		for _, pv := range hzPathValuesOf(data) {
+			model[pv.Name] = []string{pv.Value}
+		}
+	case "header":
+		req = httptest.NewRequest(http.MethodGet, "/", nil)
+		req.Header = hzHeaderOf(data)
+		model = req.Header
+	case "form":
+		body := data.Encode()
+		req = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		model = data
+		if body == "" {
+			model = map[string][]string{} // ContentLength 0: no body binding
+		}
+	}
+	c := e.NewContext(req, httptest.NewRecorder())
+	if source == "param" {
+		c.SetPathValues(hzPathValuesOf(data))
+	}
+
+	want := reflect.New(typ)
+	m := &hzBindModel{sw: HZKnown}
+	werr := m.bind(want.Elem(), model, source)
+	ht.Assume(!errors.Is(werr, hzErrSkip)) // never under HEGEL_NO_KNOWN=1: the data has no such names
+	wantErr := "<nil>"
+	if werr != nil {
+		wantErr = hzBadRequest(werr)
+	}
+
+	for rep := 0; rep < hzBindReps(m); rep++ {
+		got := reflect.New(typ)
+		var gerr error
+		r := hzCatch(func() {
+			switch source {
+			case "query":
+				gerr = echo.BindQueryParams(c, got.Interface())
+			case "param":
+				gerr = echo.BindPathValues(c, got.Interface())
+			case "header":
+				gerr = echo.BindHeaders(c, got.Interface())
+			case "form":
+				gerr = echo.BindBody(c, got.Interface())
+			}
+		})
+		if !hzCompareBound(col, ht, cs.GoString(), r, gerr, wantErr, got, want, hzShapeIf(m.ambiguous, "echo/10")) {
+			return
+		}
+	}
+	hzCountBound(col, wantErr)
+}
+
+// TestHegelBindData: one source (query, path values, headers, or a form body) bound into a
+// generated struct type with BindQueryParams / BindPathValues / BindHeaders / BindBody against
+// the model: the bound value (dumped) and the error. A lookup with several names equal ignoring
+// case is the shape of echo/10 (the binder picks one at random, the model the first; such a
+// case is bound hzFoldReps times so that the failure is not left to chance).
+func TestHegelBindData(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckBindData(col, ht, hegel.Draw(ht, hzBindDataCases))
+	})
+}
+
+// hzBindCase: a request method, the struct type bound (tagged for one of query, param and
+// form), the query, the path values and the form body (absent 40% of the time).
+type hzBindCase struct {
+	method string
+	specs  []*hzFieldSpec
+	query  url.Values
+	params url.Values
+	body   *url.Values
+}
+
+// target is the request target: "/" with the query.
+func (c hzBindCase) target() string {
+	if len(c.query) > 0 {
+		return "/?" + c.query.Encode()
+	}
+	return "/"
+}
+
+func (c hzBindCase) GoString() string {
+	body := "none"
+	if c.body != nil {
+		body = fmt.Sprint(*c.body)
+	}
+	return fmt.Sprintf("%s %s body %s\ntype %s\nparams %v", c.method, c.target(), body, hzBuildType(c.specs), c.params)
+}
+
+var (
+	hzBindMethods = hegel.SampledFrom([]string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete})
+	hzBindSpecs   = hegel.FlatMap(hegel.SampledFrom([]string{"query", "param", "form"}), func(source string) hegel.Generator[[]*hzFieldSpec] {
+		return hzSpecGens[source]
+	})
+	hzBindCases = hzBindCasesWith(hzSingleData)
+)
+
+// hzBindCasesWith: the cases of Bind with the path values drawn from params.
+func hzBindCasesWith(params hegel.Generator[url.Values]) hegel.Generator[hzBindCase] {
+	return hegel.Composite(func(tc hegel.TestCase) hzBindCase {
+		return hzBindCase{
+			method: hegel.Draw(tc, hzBindMethods),
+			specs:  hegel.Draw(tc, hzBindSpecs),
+			query:  hegel.Draw(tc, hzMultiData),
+			params: hegel.Draw(tc, params),
+			body:   hegel.Draw(tc, hzOptional(60, hzMultiData)),
+		}
+	})
+}
+
+// hzBindRequest builds the case's request and context.
+func hzBindRequest(cs hzBindCase) *echo.Context {
+	e := echo.New()
+	var req *http.Request
+	if cs.body != nil {
+		req = httptest.NewRequest(cs.method, cs.target(), strings.NewReader(cs.body.Encode()))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+	} else {
+		req = httptest.NewRequest(cs.method, cs.target(), nil)
+	}
+	c := e.NewContext(req, httptest.NewRecorder())
+	c.SetPathValues(hzPathValuesOf(cs.params))
+	return c
+}
+
+// hzBindSteps: the sources Bind composes, in order: path values; the query for GET/DELETE;
+// the body when it has content. The standard library's ParseForm reads the body for
+// POST/PUT/PATCH only and appends the URL's query values to every form (bind.go's NB).
+func hzBindSteps(c hzBindCase) (tags []string, datas []map[string][]string) {
+	pm := map[string][]string{}
+	for _, pv := range hzPathValuesOf(c.params) {
+		pm[pv.Name] = []string{pv.Value}
+	}
+	tags, datas = append(tags, "param"), append(datas, pm)
+	if c.method == http.MethodGet || c.method == http.MethodDelete {
+		tags, datas = append(tags, "query"), append(datas, c.query)
+	}
+	if c.body != nil && c.body.Encode() != "" {
+		form := url.Values{}
+		if c.method == http.MethodPost || c.method == http.MethodPut {
+			for k, vs := range *c.body {
+				form[k] = append(form[k], vs...)
+			}
+		}
+		for k, vs := range c.query {
+			form[k] = append(form[k], vs...)
+		}
+		tags, datas = append(tags, "form"), append(datas, form)
+	}
+	return tags, datas
+}
+
+// hzCheckBind binds the case's request with Bind and compares with the model.
+func hzCheckBind(col *hzCollector, ht *hegel.T, cs hzBindCase) {
+	typ := hzBuildType(cs.specs)
+	c := hzBindRequest(cs)
+
+	want := reflect.New(typ)
+	m := &hzBindModel{sw: HZKnown}
+	var werr error
+	tags, datas := hzBindSteps(cs)
+	for i := range tags {
+		if werr = m.bind(want.Elem(), datas[i], tags[i]); werr != nil {
+			break
+		}
+	}
+	ht.Assume(!errors.Is(werr, hzErrSkip)) // never under HEGEL_NO_KNOWN=1: the data has no such names
+	wantErr := "<nil>"
+	if werr != nil {
+		wantErr = hzBadRequest(werr)
+	}
+
+	for rep := 0; rep < hzBindReps(m); rep++ {
+		got := reflect.New(typ)
+		var gerr error
+		r := hzCatch(func() { gerr = c.Bind(got.Interface()) })
+		if !hzCompareBound(col, ht, cs.GoString(), r, gerr, wantErr, got, want, hzShapeIf(m.ambiguous, "echo/10")) {
+			return
+		}
+	}
+	hzCountBound(col, wantErr)
+}
+
+// TestHegelBind: DefaultBinder.Bind composing the sources in the documented order (path
+// values, then the query for GET/DELETE/HEAD, then the body), the body a form or absent.
+func TestHegelBind(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckBind(col, ht, hegel.Draw(ht, hzBindCases))
+	})
+}
diff --git a/hegel/hegel_zoo_generic_test.go b/hegel/hegel_zoo_generic_test.go
new file mode 100644
index 0000000..b2b742b
--- /dev/null
+++ b/hegel/hegel_zoo_generic_test.go
@@ -0,0 +1,571 @@
+package hegel
+
+// The generic accessors (binder_generic.go: ParseValue, ParseValueOr, ParseValues, ParseValuesOr,
+// QueryParam[T] and friends, PathParam[T], FormValue[T]) against their documentation, and
+// Context.QueryParam's raw-query fast path against url.ParseQuery.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// hzGType describes one T of the generic API: the calls with T fixed, the default value's dump,
+// the zero value's dump, and the model's parse.
+type hzGType struct {
+	name     string
+	ptrType  string // reflect type name of *T, for the options error
+	zero     string
+	def      string
+	parse    func(v string, opts []any) (dump string, err error)
+	pv       func(v string, opts []any) (string, error)
+	pvOr     func(v string, opts []any) (string, error)
+	pvs      func(vs []string, opts []any) (string, error)
+	pvsOr    func(vs []string, opts []any) (string, error)
+	qp       func(c *echo.Context, key string, opts []any) (string, error)
+	qpOr     func(c *echo.Context, key string, opts []any) (string, error)
+	qps      func(c *echo.Context, key string, opts []any) (string, error)
+	qpsOr    func(c *echo.Context, key string, opts []any) (string, error)
+	pp       func(c *echo.Context, key string, opts []any) (string, error)
+	ppOr     func(c *echo.Context, key string, opts []any) (string, error)
+	fv       func(c *echo.Context, key string, opts []any) (string, error)
+	fvOr     func(c *echo.Context, key string, opts []any) (string, error)
+	fvs      func(c *echo.Context, key string, opts []any) (string, error)
+	fvsOr    func(c *echo.Context, key string, opts []any) (string, error)
+	timeType bool
+}
+
+func hzGDump[T any](v T) string {
+	switch x := any(v).(type) {
+	case time.Time:
+		return hzTimeDump(x)
+	case hzParamT:
+		return x.V
+	}
+	return fmt.Sprint(v)
+}
+
+func hzGDumps[T any](vs []T) string {
+	if vs == nil {
+		return "nil"
+	}
+	parts := make([]string, len(vs))
+	for i, v := range vs {
+		parts[i] = hzGDump(v)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// hzGMake builds the hzGType for T with a default value and the model's scalar parse.
+func hzGMake[T any](name string, def T, parse func(v string, opts []any) (T, error)) *hzGType {
+	var zero T
+	g := &hzGType{
+		name:    name,
+		ptrType: reflect.TypeFor[*T]().String(),
+		zero:    hzGDump(zero),
+		def:     hzGDump(def),
+	}
+	g.parse = func(v string, opts []any) (string, error) {
+		x, err := parse(v, opts)
+		return hzGDump(x), err
+	}
+	g.pv = func(v string, opts []any) (string, error) {
+		x, err := echo.ParseValue[T](v, opts...)
+		return hzGDump(x), err
+	}
+	g.pvOr = func(v string, opts []any) (string, error) {
+		x, err := echo.ParseValueOr[T](v, def, opts...)
+		return hzGDump(x), err
+	}
+	g.pvs = func(vs []string, opts []any) (string, error) {
+		x, err := echo.ParseValues[T](vs, opts...)
+		return hzGDumps(x), err
+	}
+	g.pvsOr = func(vs []string, opts []any) (string, error) {
+		x, err := echo.ParseValuesOr[T](vs, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	g.qp = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParam[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.qpOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParamOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.qps = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParams[T](c, key, opts...)
+		return hzGDumps(x), err
+	}
+	g.qpsOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.QueryParamsOr[T](c, key, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	g.pp = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.PathParam[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.ppOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.PathParamOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.fv = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValue[T](c, key, opts...)
+		return hzGDump(x), err
+	}
+	g.fvOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValueOr[T](c, key, def, opts...)
+		return hzGDump(x), err
+	}
+	g.fvs = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValues[T](c, key, opts...)
+		return hzGDumps(x), err
+	}
+	g.fvsOr = func(c *echo.Context, key string, opts []any) (string, error) {
+		x, err := echo.FormValuesOr[T](c, key, []T{def}, opts...)
+		return hzGDumps(x), err
+	}
+	return g
+}
+
+func hzGInt[T int | int8 | int16 | int32 | int64](bits int) func(string, []any) (T, error) {
+	return func(v string, _ []any) (T, error) {
+		n, err := strconv.ParseInt(v, 10, bits)
+		return T(n), err
+	}
+}
+
+func hzGUint[T uint | uint8 | uint16 | uint32 | uint64](bits int) func(string, []any) (T, error) {
+	return func(v string, _ []any) (T, error) {
+		n, err := strconv.ParseUint(v, 10, bits)
+		return T(n), err
+	}
+}
+
+var hzZone = time.FixedZone("hz", 3*3600)
+
+// hzGParseTime is the documented time parsing: layout RFC3339Nano unless TimeLayout / TimeOpts
+// say otherwise, ParseInLocation and ToInLocation defaulting to UTC, the Unix layouts integers.
+func hzGParseTime(v string, opts []any) (time.Time, error) {
+	layout := echo.TimeLayout(time.RFC3339Nano)
+	in, to := time.UTC, time.UTC
+	for _, o := range opts {
+		switch x := o.(type) {
+		case echo.TimeOpts:
+			if x.Layout != "" {
+				layout = x.Layout
+			}
+			if x.ParseInLocation != nil {
+				in = x.ParseInLocation
+			}
+			if x.ToInLocation != nil {
+				to = x.ToInLocation
+			}
+		case echo.TimeLayout:
+			layout = x
+		}
+	}
+	var t time.Time
+	switch layout {
+	case echo.TimeLayoutUnixTime, echo.TimeLayoutUnixTimeMilli, echo.TimeLayoutUnixTimeNano:
+		n, err := strconv.ParseInt(v, 10, 64)
+		if err != nil {
+			return time.Time{}, err
+		}
+		switch layout {
+		case echo.TimeLayoutUnixTime:
+			t = time.Unix(n, 0)
+		case echo.TimeLayoutUnixTimeMilli:
+			t = time.UnixMilli(n)
+		default:
+			t = time.Unix(0, n)
+		}
+	default:
+		var err error
+		t, err = time.ParseInLocation(string(layout), v, in)
+		if err != nil {
+			return time.Time{}, err
+		}
+	}
+	return t.In(to), nil
+}
+
+var hzGTypes = []*hzGType{
+	hzGMake[int]("int", 7, hzGInt[int](0)),
+	hzGMake[int8]("int8", 7, hzGInt[int8](8)),
+	hzGMake[uint16]("uint16", 7, hzGUint[uint16](16)),
+	hzGMake[bool]("bool", true, func(v string, _ []any) (bool, error) { return strconv.ParseBool(v) }),
+	hzGMake[float64]("float64", 2.5, func(v string, _ []any) (float64, error) { return strconv.ParseFloat(v, 64) }),
+	hzGMake[string]("string", "dflt", func(v string, _ []any) (string, error) { return v, nil }),
+	hzGMake[time.Duration]("duration", 3*time.Second, func(v string, _ []any) (time.Duration, error) { return time.ParseDuration(v) }),
+	hzGMake[time.Time]("time", time.Date(2001, 2, 3, 4, 5, 6, 0, time.UTC), hzGParseTime),
+	hzGMake[hzParamT]("param", hzParamT{V: "D"}, func(v string, _ []any) (hzParamT, error) {
+		var p hzParamT
+		err := p.UnmarshalParam(v)
+		return p, err
+	}),
+}
+
+func init() {
+	hzGTypes[7].timeType = true
+}
+
+var hzGOptSets = [][]any{
+	nil,
+	{echo.TimeLayout(hzDateLayout)},
+	{echo.TimeLayoutUnixTime},
+	{echo.TimeLayoutUnixTimeMilli},
+	{echo.TimeLayoutUnixTimeNano},
+	{echo.TimeOpts{Layout: echo.TimeLayout(hzDateLayout), ParseInLocation: hzZone}},
+	{echo.TimeOpts{ToInLocation: hzZone}},
+	{echo.TimeOpts{Layout: echo.TimeLayoutUnixTime, ToInLocation: hzZone}},
+	{echo.TimeLayout(hzDateLayout), echo.TimeOpts{ParseInLocation: hzZone}},
+}
+
+// modelParse: ParseValue's contract. An empty value gives the default (the zero value for
+// ParseValue); options are for time.Time only; a parse error gives the zero value.
+func (g *hzGType) modelParse(v string, def string, opts []any) (string, string) {
+	if v == "" {
+		return def, "<nil>"
+	}
+	if len(opts) > 0 && !g.timeType {
+		return g.zero, "failed to parse value, err: " + fmt.Sprintf("options are only supported for time.Time, got %s", g.ptrType)
+	}
+	dump, err := g.parse(v, opts)
+	if err != nil {
+		return g.zero, "failed to parse value, err: " + err.Error()
+	}
+	return dump, "<nil>"
+}
+
+// modelParseOr: ParseValueOr's contract (the default on an empty value; on a parse error the
+// documentation's examples give the default, the code the zero value: echo/12, followed with
+// sw.orReturnsZero).
+func (g *hzGType) modelParseOr(v string, opts []any, sw hzSwitches) (string, string) {
+	dump, err := g.modelParse(v, g.def, opts)
+	if err != "<nil>" && !sw.orReturnsZero {
+		return g.def, err
+	}
+	return dump, err
+}
+
+func (g *hzGType) modelParses(vs []string, def string, opts []any) (string, string) {
+	if len(vs) == 0 {
+		return def, "<nil>"
+	}
+	var parts []string
+	for _, v := range vs {
+		d, err := g.modelParse(v, g.zero, opts)
+		if err != "<nil>" {
+			return "nil", err
+		}
+		parts = append(parts, d)
+	}
+	return "[" + strings.Join(parts, " ") + "]", "<nil>"
+}
+
+func hzBindingErr(key string, message, inner string) string {
+	return "code=400, message=" + message + ", err=" + inner + ", field=" + key
+}
+
+// --------------------------------------------------------------------------- generators
+
+// The calls: 0 single, 1 single Or, 2 slice, 3 slice Or (path values have no slice calls).
+const (
+	hzGSingle = iota
+	hzGSingleOr
+	hzGSlice
+	hzGSliceOr
+)
+
+var (
+	hzGValuePool     = []string{"", "0", "1", "-1", "42", "300", "1.5", "true", "T", "x", "bad", "2023-01-15", "2023-01-15T10:00:00Z", "2023-01-15T10:00:00.5+02:00", "1s", "1700000000", "1700000000123", "abc", "-0"}
+	hzGSafeValuePool = []string{"1", "0", "42", "true", "1s", "2023-01-15T10:00:00Z", "7"}
+	// hzGValues: a value, one that parses for most types half of the time.
+	hzGValues = hzWeighted(
+		hzChoice[string]{50, hegel.SampledFrom(hzGSafeValuePool)},
+		hzChoice[string]{50, hegel.SampledFrom(hzGValuePool)},
+	)
+	// hzGValueLists: the values of the key: absent (nil) 20% of the time, else one, or two
+	// or three 30% of the time.
+	hzGValueLists = hzMaybe(80, hzWeighted(
+		hzChoice[[]string]{70, hzMany(hzGValues, 1, 1)},
+		hzChoice[[]string]{30, hzMany(hzGValues, 2, 3)},
+	))
+	hzGKeys     = hegel.SampledFrom([]string{"k", "j"})
+	hzGSources  = hegel.SampledFrom([]string{"query", "path", "form", "parse"})
+	hzGTypeGens = hegel.SampledFrom(hzGTypes)
+	hzGOptGens  = hegel.SampledFrom(hzGOptSets)
+	// hzGCallsFor: the calls a source has: path values only the single ones.
+	hzGCallsFor = map[string]hegel.Generator[int]{
+		"query": hegel.Integers(hzGSingle, hzGSliceOr),
+		"path":  hegel.Integers(hzGSingle, hzGSingleOr),
+		"form":  hegel.Integers(hzGSingle, hzGSliceOr),
+		"parse": hegel.Integers(hzGSingle, hzGSliceOr),
+	}
+)
+
+// hzGCase: a T, the options (a set 70% of the time for time.Time, 8% otherwise), the key and
+// its values, the source, the call and whether another key is present too.
+type hzGCase struct {
+	g      *hzGType
+	opts   []any
+	key    string
+	values []string
+	source string
+	call   int
+	other  bool
+}
+
+func (c hzGCase) GoString() string {
+	return fmt.Sprintf("%s %s call %d values %q opts %v other=%v", c.g.name, c.source, c.call, c.values, c.opts, c.other)
+}
+
+var hzGCases = hegel.FlatMap(hzGTypeGens, func(g *hzGType) hegel.Generator[hzGCase] {
+	opts := hzMaybe(8, hzGOptGens)
+	if g.timeType {
+		opts = hzMaybe(70, hzGOptGens)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzGCase {
+		source := hegel.Draw(tc, hzGSources)
+		return hzGCase{
+			g:      g,
+			opts:   hegel.Draw(tc, opts),
+			key:    hegel.Draw(tc, hzGKeys),
+			values: hegel.Draw(tc, hzGValueLists),
+			source: source,
+			call:   hegel.Draw(tc, hzGCallsFor[source]),
+			other:  hegel.Draw(tc, hzCoin(30)),
+		}
+	})
+})
+
+// hzGModel is the documented outcome of the case: the dump and the error text; parseFailed
+// reports a parse error on an Or call, the shape of echo/12.
+func hzGModel(c hzGCase, sw hzSwitches) (wantDump, wantErr string, orParseError bool) {
+	g, values, opts, call, source, key := c.g, c.values, c.opts, c.call, c.source, c.key
+	nonExistent := echo.ErrNonExistentKey.Error()
+	first := ""
+	if len(values) > 0 {
+		first = values[0]
+	}
+	message := map[string]string{"query": "query param", "path": "path value", "form": "form value"}[source]
+	messages := map[string]string{"query": "query params", "form": "form values"}[source]
+	switch {
+	case source == "parse" && call == hzGSingle:
+		wantDump, wantErr = g.modelParse(first, g.zero, opts)
+	case source == "parse" && call == hzGSingleOr:
+		wantDump, wantErr = g.modelParseOr(first, opts, sw)
+	case source == "parse" && call == hzGSlice:
+		wantDump, wantErr = g.modelParses(values, "nil", opts)
+	case source == "parse":
+		wantDump, wantErr = g.modelParses(values, "["+g.def+"]", opts)
+	case values == nil && (call == hzGSingleOr || call == hzGSliceOr):
+		wantDump = g.def
+		if call == hzGSliceOr {
+			wantDump = "[" + g.def + "]"
+		}
+		wantErr = "<nil>"
+	case values == nil:
+		wantDump, wantErr = g.zero, nonExistent
+		if call == hzGSlice {
+			wantDump = "nil"
+		}
+	case call == hzGSingle:
+		wantDump, wantErr = g.modelParse(first, g.zero, opts)
+		if wantErr != "<nil>" {
+			wantErr = hzBindingErr(key, message, wantErr)
+		}
+	case call == hzGSingleOr:
+		wantDump, wantErr = g.modelParseOr(first, opts, sw)
+		if wantErr != "<nil>" {
+			wantErr = hzBindingErr(key, message, wantErr)
+		}
+	case call == hzGSlice:
+		wantDump, wantErr = g.modelParses(values, "nil", opts)
+		if wantErr != "<nil>" {
+			wantErr = hzBindingErr(key, messages, wantErr)
+		}
+	default:
+		wantDump, wantErr = g.modelParses(values, "["+g.def+"]", opts)
+		if wantErr != "<nil>" {
+			wantErr = hzBindingErr(key, messages, wantErr)
+		}
+	}
+	return wantDump, wantErr, call == hzGSingleOr && wantErr != "<nil>"
+}
+
+// hzGCall performs the case's call and returns the dump and the error.
+func hzGCall(c hzGCase) (string, error) {
+	g, values, opts, call, source, key := c.g, c.values, c.opts, c.call, c.source, c.key
+	first := ""
+	if len(values) > 0 {
+		first = values[0]
+	}
+	e := echo.New()
+	data := url.Values{}
+	for _, v := range values {
+		data.Add(key, v)
+	}
+	if c.other {
+		data.Add("other", "1")
+	}
+	var ctx *echo.Context
+	switch source {
+	case "query":
+		ctx = e.NewContext(httptest.NewRequest(http.MethodGet, "/?"+data.Encode(), nil), httptest.NewRecorder())
+	case "path":
+		ctx = e.NewContext(httptest.NewRequest(http.MethodGet, "/", nil), httptest.NewRecorder())
+		pv := echo.PathValues{{Name: "other", Value: "1"}}
+		if values != nil {
+			pv = append(pv, echo.PathValue{Name: key, Value: first})
+		}
+		ctx.SetPathValues(pv)
+	case "form":
+		req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(data.Encode()))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		ctx = e.NewContext(req, httptest.NewRecorder())
+	}
+	switch {
+	case source == "parse" && call == hzGSingle:
+		return g.pv(first, opts)
+	case source == "parse" && call == hzGSingleOr:
+		return g.pvOr(first, opts)
+	case source == "parse" && call == hzGSlice:
+		return g.pvs(values, opts)
+	case source == "parse":
+		return g.pvsOr(values, opts)
+	case source == "query" && call == hzGSingle:
+		return g.qp(ctx, key, opts)
+	case source == "query" && call == hzGSingleOr:
+		return g.qpOr(ctx, key, opts)
+	case source == "query" && call == hzGSlice:
+		return g.qps(ctx, key, opts)
+	case source == "query":
+		return g.qpsOr(ctx, key, opts)
+	case source == "path" && call == hzGSingle:
+		return g.pp(ctx, key, opts)
+	case source == "path":
+		return g.ppOr(ctx, key, opts)
+	case source == "form" && call == hzGSingle:
+		return g.fv(ctx, key, opts)
+	case source == "form" && call == hzGSingleOr:
+		return g.fvOr(ctx, key, opts)
+	case source == "form" && call == hzGSlice:
+		return g.fvs(ctx, key, opts)
+	}
+	return g.fvsOr(ctx, key, opts)
+}
+
+// hzCheckGeneric compares the call's outcome with the model's.
+func hzCheckGeneric(col *hzCollector, ht *hegel.T, c hzGCase) {
+	wantDump, wantErr, orParseError := hzGModel(c, HZKnown)
+	shape := hzShapeIf(orParseError, "echo/12")
+	var gotDump string
+	var gotErr error
+	r := hzCatch(func() { gotDump, gotErr = hzGCall(c) })
+	desc := c.GoString()
+	if r != nil {
+		col.mismatch(ht, shape, "panic", "%s\npanic: %v", desc, r)
+		return
+	}
+	if hzErrString(gotErr) != wantErr {
+		col.mismatch(ht, shape, "error", "%s\n got %s err %s\nwant %s err %s", desc, gotDump, hzErrString(gotErr), wantDump, wantErr)
+		return
+	}
+	if gotDump != wantDump {
+		col.mismatch(ht, shape, "value", "%s\n got %s\nwant %s (err %s)", desc, gotDump, wantDump, wantErr)
+		return
+	}
+	if wantErr != "<nil>" {
+		col.count("error")
+	} else {
+		col.count("ok " + c.source)
+	}
+}
+
+// TestHegelParseValue: the generic accessors against their documentation for nine T's: the
+// value and the error of each call over a query, path values and a form body. An Or call on a
+// value that fails to parse is the shape of echo/12 (the documentation's examples give the
+// default, the code the zero value).
+func TestHegelParseValue(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckGeneric(col, ht, hegel.Draw(ht, hzGCases))
+	})
+}
+
+// --------------------------------------------------------------------------- the fast path
+
+// hzFastPathCase: a raw query of up to ten atoms and the name looked up.
+type hzFastPathCase struct {
+	atoms []string
+	name  string
+}
+
+func (c hzFastPathCase) raw() string { return strings.Join(c.atoms, "") }
+
+func (c hzFastPathCase) GoString() string { return fmt.Sprintf("raw %q name %q", c.raw(), c.name) }
+
+var (
+	// hzQueryAtoms: a piece of a raw query: a whole pair with its separator 40% of the time,
+	// else a byte or an escape.
+	hzQueryAtoms = hzWeighted(
+		hzChoice[string]{40, hegel.SampledFrom([]string{"a=1&", "b=2&", "a=%20&", "b=x+y&", "a=&", "&a=1", ";a=1", "a=1;"})},
+		hzChoice[string]{60, hegel.SampledFrom([]string{"a", "b", "=", "&", ";", "%", "2", "0", "+", "Z", "%20", "%ZZ", "%2", "&&", "%3D", "%26"})},
+	)
+	hzQueryNames    = hegel.SampledFrom([]string{"a", "a", "b", "b", "", "a=1", "%", "Z", "&"})
+	hzFastPathCases = hegel.Composite(func(tc hegel.TestCase) hzFastPathCase {
+		return hzFastPathCase{atoms: hegel.Draw(tc, hzMany(hzQueryAtoms, 0, 10)), name: hegel.Draw(tc, hzQueryNames)}
+	})
+)
+
+// TestHegelQueryParamFastPath: Context.QueryParam (a raw-query scan when QueryParams has not
+// built the map) equals url.ParseQuery(RawQuery).Get(name), as its comment promises, and the
+// map path after QueryParams() agrees.
+func TestHegelQueryParamFastPath(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzFastPathCases)
+		raw, name := cs.raw(), cs.name
+		want, _ := url.ParseQuery(raw)
+		wantV := want.Get(name)
+
+		e := echo.New()
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.URL.RawQuery = raw
+		c := e.NewContext(req, httptest.NewRecorder())
+		var fast, slow string
+		r := hzCatch(func() {
+			fast = c.QueryParam(name)
+			c.QueryParams()
+			slow = c.QueryParam(name)
+		})
+		if r != nil {
+			col.failClass(ht, "panic", "raw %q name %q: panic %v", raw, name, r)
+			return
+		}
+		if fast != wantV {
+			col.failClass(ht, "fast", "raw %q name %q: fast path %q, ParseQuery %q", raw, name, fast, wantV)
+			return
+		}
+		if slow != wantV {
+			col.failClass(ht, "map", "raw %q name %q: map path %q, ParseQuery %q", raw, name, slow, wantV)
+			return
+		}
+		if wantV != "" {
+			col.count("found")
+		} else {
+			col.count("empty")
+		}
+	})
+}
