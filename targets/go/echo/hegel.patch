@@ -0,0 +1,215 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml echo/1 ...), each asserting the documented
+// behaviour; they fail while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+)
+
+func hzHandler(c *echo.Context) error {
+	var names, vals []string
+	for _, pv := range c.PathValues() {
+		names = append(names, pv.Name)
+		vals = append(vals, pv.Value)
+	}
+	return c.String(200, hzEcho("", c.Path(), names, vals))
+}
+
+// hzServeSafe serves a request, returning the answer or the panic as text.
+func hzServeSafe(e *echo.Echo, method, target string) string {
+	var a hzAnswer
+	if r := hzCatch(func() { a = hzServe(e, method, target) }); r != nil {
+		return "panic: " + hzSprint(r)
+	}
+	return a.String()
+}
+
+func hzSprint(v any) string { return hzAnswer{body: hzFmt(v)}.body }
+
+func hzFmt(v any) string {
+	switch x := v.(type) {
+	case error:
+		return x.Error()
+	case string:
+		return x
+	}
+	return "?"
+}
+
+// TestHegelPinEscapedColonBesideParam: echo/1. A route with an escaped colon ("\:", a literal
+// colon per the router's tests) and a route with a parameter at the same position are two
+// ordinary routes; both must be served, in either order of registration, without a panic.
+func TestHegelPinEscapedColonBesideParam(t *testing.T) {
+	for _, order := range [][]string{{"/name\\:verb/x", "/name:id"}, {"/name:id", "/name\\:verb/x"}} {
+		e := echo.New()
+		for _, p := range order {
+			e.GET(p, hzHandler)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name:verb/x"), `200 "/name\\:verb/x" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name:verb/x\n got %s\nwant %s", order, got, want)
+		}
+		if got, want := hzServeSafe(e, http.MethodGet, "/name1"), `200 "/name:id|id=1" allow=[]`; got != want {
+			t.Errorf("routes %v: GET /name1\n got %s\nwant %s", order, got, want)
+		}
+	}
+}
+
+// TestHegelPinWildcardStopsBacktracking: echo/2. Priority is static > param > wildcard with
+// backtracking: GET /a/b is served by GET /:x/b although a POST /a/* wildcard sits on the
+// static branch (the wildcard has no GET handler; the router must go on to the alternative).
+func TestHegelPinWildcardStopsBacktracking(t *testing.T) {
+	e := echo.New()
+	e.GET("/:x/b", hzHandler)
+	e.POST("/a/*", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:x/b|x=a" allow=[]`; got != want {
+		t.Errorf("GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinNotFoundRouteShadows: echo/3. A RouteNotFound handler is for "404 cases": a
+// request that a registered route matches must be served by that route. A Group with
+// middleware registers RouteNotFound routes for its prefix; a route with a parameter at the
+// group's position must still be reachable.
+func TestHegelPinNotFoundRouteShadows(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/a", hzHandler)
+	e.GET("/:x", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a"), `200 "/:x|x=a" allow=[]`; got != want {
+		t.Errorf("RouteNotFound /a and GET /:x: GET /a\n got %s\nwant %s", got, want)
+	}
+
+	e = echo.New()
+	g := e.Group("/a", func(next echo.HandlerFunc) echo.HandlerFunc { return next })
+	g.GET("/x", hzHandler)
+	e.GET("/:p/b", hzHandler)
+	if got, want := hzServeSafe(e, http.MethodGet, "/a/b"), `200 "/:p/b|p=a" allow=[]`; got != want {
+		t.Errorf("group /a with middleware and GET /:p/b: GET /a/b\n got %s\nwant %s", got, want)
+	}
+}
+
+// TestHegelPinEscapedPathOption: echo/4. RouterConfig.UseEscapedPathForMatching is documented
+// to make the router match req.URL.RawPath instead of req.URL.Path; without it the decoded
+// path is matched.
+func TestHegelPinEscapedPathOption(t *testing.T) {
+	for _, escaped := range []bool{false, true} {
+		e := echo.NewWithConfig(echo.Config{Router: echo.NewRouter(echo.RouterConfig{
+			AllowOverwritingRoute:     true,
+			UseEscapedPathForMatching: escaped,
+		})})
+		e.GET("/a%2Fb", hzHandler)
+		e.GET("/a/b", hzHandler)
+		want := `200 "/a/b" allow=[]`
+		if escaped {
+			want = `200 "/a%2Fb" allow=[]`
+		}
+		if got := hzServeSafe(e, http.MethodGet, "/a%2Fb"); got != want {
+			t.Errorf("UseEscapedPathForMatching=%v: GET /a%%2Fb\n got %s\nwant %s", escaped, got, want)
+		}
+	}
+}
+
+// TestHegelPinTextAfterWildcard: echo/5. A route path with text after the wildcard ("/a/*/f")
+// is either rejected or matched as written; it must not silently become "/a/*".
+func TestHegelPinTextAfterWildcard(t *testing.T) {
+	e := echo.New()
+	if _, err := e.AddRoute(echo.Route{Method: http.MethodGet, Path: "/a/*/f", Handler: hzHandler}); err != nil {
+		t.Skipf("rejected: %v", err) // acceptable: the documented syntax has nothing after "*"
+	}
+	if got := hzServeSafe(e, http.MethodGet, "/a/c/g"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("route /a/*/f: GET /a/c/g\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinRemoveCustomMethod: echo/6. Remove of a route registered with a custom method
+// (one outside the standard set, kept in the router's map) must remove it, not panic.
+func TestHegelPinRemoveCustomMethod(t *testing.T) {
+	e := echo.New()
+	e.Add("COPY", "/c", hzHandler)
+	var err error
+	if r := hzCatch(func() { err = e.Router().Remove("COPY", "/c") }); r != nil {
+		t.Fatalf("Remove(COPY, /c): panic %v", r)
+	}
+	if err != nil {
+		t.Fatalf("Remove(COPY, /c): %v", err)
+	}
+	if got := hzServeSafe(e, "COPY", "/c"); got != `404 "{\"message\":\"Not Found\"}\n" allow=[]` {
+		t.Errorf("after Remove: COPY /c\n got %s\nwant a 404", got)
+	}
+}
+
+// TestHegelPinSlashlessRoutePath: echo/7. A route registered without a leading slash gets one
+// (normalizePathSlash); the RouteInfo the router lists must name the route as it serves it,
+// so that Routes().FindByMethodPath(method, c.Path()) finds it and Remove removes it and no
+// other.
+func TestHegelPinSlashlessRoutePath(t *testing.T) {
+	e := echo.New()
+	e.GET("/first", hzHandler)
+	e.GET("users", hzHandler)
+	if got := hzServeSafe(e, http.MethodGet, "/users"); got != `200 "/users" allow=[]` {
+		t.Fatalf("GET /users: got %s", got)
+	}
+	if _, err := e.Router().Routes().FindByMethodPath(http.MethodGet, "/users"); err != nil {
+		t.Errorf("FindByMethodPath(GET, /users): %v; routes %s", err, hzShowInfos(e.Router().Routes()))
+	}
+	if err := e.Router().Remove(http.MethodGet, "users"); err != nil {
+		t.Fatalf("Remove(GET, users): %v", err)
+	}
+	if got, want := hzShowInfos(e.Router().Routes()), "GET /first"; got != want {
+		t.Errorf("after Remove(GET, users): Routes() %s, want %s", got, want)
+	}
+}
+
+// TestHegelPinRemoveFindsRoute: echo/8. Remove(method, path) removes a registered route:
+// after a parameter that more than one route continues from, with an escaped colon, when
+// another route shares its node under other parameter names, and after another removal.
+func TestHegelPinRemoveFindsRoute(t *testing.T) {
+	check := func(name string, e *echo.Echo, method, path string) {
+		if err := e.Router().Remove(method, path); err != nil {
+			t.Errorf("%s: Remove(%s, %s): %v", name, method, path, err)
+		}
+	}
+	e := echo.New()
+	e.GET("/a/:id/b", hzHandler)
+	e.GET("/a/:id/c", hzHandler)
+	check("two routes after a parameter", e, http.MethodGet, "/a/:id/b")
+
+	e = echo.New()
+	e.GET("/file\\:x/a", hzHandler)
+	e.GET("/file.txt", hzHandler)
+	check("escaped colon", e, http.MethodGet, "/file\\:x/a")
+
+	e = echo.New()
+	e.Any("/:p", hzHandler)
+	e.OPTIONS("/:name", hzHandler)
+	check("node re-registered under another name", e, echo.RouteAny, "/:p")
+
+	e = echo.New()
+	e.GET("/file.txt/:q", hzHandler)
+	e.GET("/file\\:undelete/new", hzHandler)
+	check("first removal", e, http.MethodGet, "/file.txt/:q")
+	check("after another removal", e, http.MethodGet, "/file\\:undelete/new")
+}
+
+// TestHegelPinRemoveKeepsNotFound: echo/9. Removing a route must leave the other routes,
+// RouteNotFound routes included; and a RouteNotFound route can itself be removed.
+func TestHegelPinRemoveKeepsNotFound(t *testing.T) {
+	e := echo.New()
+	e.RouteNotFound("/ab", hzHandler)
+	e.GET("/abc", hzHandler)
+	if err := e.Router().Remove(http.MethodGet, "/abc"); err != nil {
+		t.Fatalf("Remove(GET, /abc): %v", err)
+	}
+	if got, want := hzServeSafe(e, http.MethodGet, "/ab"), `200 "/ab" allow=[]`; got != want {
+		t.Errorf("after Remove(GET, /abc): GET /ab\n got %s\nwant the RouteNotFound route: %s", got, want)
+	}
+
+	e = echo.New()
+	e.RouteNotFound("/x", hzHandler)
+	if err := e.Router().Remove(echo.RouteNotFound, "/x"); err != nil {
+		t.Errorf("Remove(RouteNotFound, /x): %v", err)
+	}
+}
diff --git a/hegel/hegel_zoo_router_test.go b/hegel/hegel_zoo_router_test.go
new file mode 100644
index 0000000..33ce400
--- /dev/null
+++ b/hegel/hegel_zoo_router_test.go
@@ -0,0 +1,694 @@
+package hegel
+
+// Route matching against a model of the documented semantics (README, the RouterConfig doc
+// comments, the Route/RouteInfo doc comments): priority static > param > any with backtracking,
+// RouteNotFound routes, 405 with Allow, the default OPTIONS answer, AutoHandleHEAD,
+// UnescapePathParamValues, UseEscapedPathForMatching.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- routes
+
+type hzTokKind int
+
+const (
+	hzStatic hzTokKind = iota
+	hzParam
+	hzAny
+)
+
+type hzTok struct {
+	kind hzTokKind
+	text string // static text, or the param name
+}
+
+// hzRoute is a registered route: its method (echo.RouteAny, echo.RouteNotFound or an HTTP
+// method), the path as written, and its tokens as the router reads them.
+type hzRoute struct {
+	method string
+	path   string // as registered
+	norm   string // with the leading slash the router adds: what Context.Path reports
+	toks   []hzTok
+	names  []string // parameter names in order ("*" for the wildcard)
+}
+
+// hzTokenize reads a pattern the way DefaultRouter.Add does: a leading "/" is added when
+// missing; ":" starts a parameter whose name runs to the next "/"; "\:" is a literal colon;
+// "*" is the wildcard and ends the pattern (what follows is dropped).
+func hzTokenize(path string) []hzTok {
+	if path == "" {
+		path = "/"
+	} else if path[0] != '/' {
+		path = "/" + path
+	}
+	var toks []hzTok
+	var sb strings.Builder
+	flush := func() {
+		if sb.Len() > 0 {
+			toks = append(toks, hzTok{hzStatic, sb.String()})
+			sb.Reset()
+		}
+	}
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		switch {
+		case c == ':' && i > 0 && path[i-1] == '\\':
+			// the backslash is already in sb: replace it by the colon
+			s := sb.String()
+			sb.Reset()
+			sb.WriteString(s[:len(s)-1])
+			sb.WriteByte(':')
+		case c == ':':
+			flush()
+			j := i + 1
+			for j < len(path) && path[j] != '/' {
+				j++
+			}
+			toks = append(toks, hzTok{hzParam, path[i+1 : j]})
+			i = j - 1
+		case c == '*':
+			flush()
+			toks = append(toks, hzTok{hzAny, "*"})
+			return toks
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	flush()
+	return toks
+}
+
+// hzNormalize is normalizePathSlash: "" is "/", a missing leading slash is added.
+func hzNormalize(path string) string {
+	if path == "" {
+		return "/"
+	}
+	if path[0] != '/' {
+		return "/" + path
+	}
+	return path
+}
+
+func hzNewRoute(method, path string) *hzRoute {
+	r := &hzRoute{method: method, path: path, norm: hzNormalize(path), toks: hzTokenize(path)}
+	for _, t := range r.toks {
+		if t.kind != hzStatic {
+			r.names = append(r.names, t.text)
+		}
+	}
+	return r
+}
+
+// shape is the route's path with parameter names erased: routes of one shape share a node.
+func (r *hzRoute) shape() string {
+	var sb strings.Builder
+	for _, t := range r.toks {
+		switch t.kind {
+		case hzStatic:
+			sb.WriteString(strings.ReplaceAll(t.text, ":", "\\:"))
+		case hzParam:
+			sb.WriteString(":")
+		case hzAny:
+			sb.WriteString("*")
+		}
+	}
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- the tree
+
+// hzNode is a node of a byte trie over the routes: the radix tree the router builds matches
+// exactly as this trie does (its node boundaries only group bytes), with a :param child and a
+// * child beside the static children.
+type hzNode struct {
+	static   map[byte]*hzNode
+	param    *hzNode
+	any      *hzNode
+	methods  map[string]*hzRoute // by method, echo.RouteAny included
+	notFound *hzRoute
+	lastPath string // the path of the last route registered at this node (node.originalPath)
+	parent   *hzNode
+	label    byte // the byte this node hangs off its parent by (static children)
+	boundary bool // the last byte of a node of the router's radix tree, as built (Remove never re-merges nodes)
+	inRoot   bool // part of the radix tree's root node, which Remove never prunes
+}
+
+func hzNewNode() *hzNode { return &hzNode{static: map[byte]*hzNode{}} }
+
+func (n *hzNode) isLeaf() bool { return len(n.static) == 0 && n.param == nil && n.any == nil }
+
+func (n *hzNode) isHandler() bool { return len(n.methods) > 0 }
+
+func hzBuildTree(routes []*hzRoute) *hzNode {
+	root := hzNewNode()
+	for _, r := range routes {
+		n := root
+		for _, t := range r.toks {
+			switch t.kind {
+			case hzStatic:
+				for i := 0; i < len(t.text); i++ {
+					c := n.static[t.text[i]]
+					if c == nil {
+						c = hzNewNode()
+						c.parent, c.label = n, t.text[i]
+						n.static[t.text[i]] = c
+					}
+					n = c
+				}
+			case hzParam:
+				if n.param == nil {
+					n.param = hzNewNode()
+					n.param.parent, n.param.label = n, ':'
+				}
+				n = n.param
+			case hzAny:
+				if n.any == nil {
+					n.any = hzNewNode()
+					n.any.parent, n.any.label = n, '*'
+				}
+				n = n.any
+			}
+		}
+		n.lastPath = r.norm
+		if r.method == echo.RouteNotFound {
+			n.notFound = r
+		} else {
+			if n.methods == nil {
+				n.methods = map[string]*hzRoute{}
+			}
+			n.methods[r.method] = r // a later route of the same shape and method replaces
+		}
+	}
+	hzMarkBoundaries(root)
+	for n := root.static['/']; n != nil; {
+		n.inRoot = true
+		if n.boundary {
+			break
+		}
+		for _, n = range n.static {
+		}
+	}
+	return root
+}
+
+// hzMarkBoundaries marks the byte-nodes where a node of the radix tree ends: a branching, a
+// wildcard child, a route's end.
+func hzMarkBoundaries(n *hzNode) {
+	n.boundary = len(n.static) != 1 || n.param != nil || n.any != nil || n.isHandler() || n.notFound != nil
+	for _, c := range n.static {
+		hzMarkBoundaries(c)
+	}
+	if n.param != nil {
+		hzMarkBoundaries(n.param)
+	}
+	if n.any != nil {
+		hzMarkBoundaries(n.any)
+	}
+}
+
+// hzCollides reports whether some node has both a static child labelled ':' (from an escaped
+// colon) and a :param child: the router then puts one route's nodes under the other's
+// (HZKnown.escapedColonCollision) and the tree no longer answers for either.
+func hzCollides(n *hzNode) bool {
+	if n.static[':'] != nil && n.param != nil {
+		return true
+	}
+	for _, c := range n.static {
+		if hzCollides(c) {
+			return true
+		}
+	}
+	if n.param != nil && hzCollides(n.param) {
+		return true
+	}
+	return false
+}
+
+// find is routeMethods.find: the method's route, else (fallback) the Any route; a HEAD request
+// falls back to GET first when autoHandleHEAD.
+func (n *hzNode) find(method string, autoHead bool) *hzRoute {
+	if r := n.methods[method]; r != nil {
+		return r
+	}
+	if method == http.MethodHead && autoHead {
+		if r := n.methods[http.MethodGet]; r != nil {
+			return r
+		}
+	}
+	return n.methods[echo.RouteAny]
+}
+
+var hzAllowOrder = []string{
+	http.MethodConnect, http.MethodDelete, http.MethodGet, http.MethodHead, http.MethodPatch,
+	http.MethodPost, "PROPFIND", http.MethodPut, http.MethodTrace, "REPORT", "QUERY",
+}
+
+// allow is the Allow header of the node, as a sorted set of methods (the router lists the
+// custom methods in map order).
+func (n *hzNode) allow() []string {
+	set := map[string]bool{http.MethodOptions: true}
+	hasAny := n.methods[echo.RouteAny] != nil
+	for _, m := range hzAllowOrder {
+		if hasAny || n.methods[m] != nil {
+			set[m] = true
+		}
+	}
+	for m := range n.methods {
+		if m != echo.RouteAny {
+			set[m] = true
+		}
+	}
+	var out []string
+	for m := range set {
+		out = append(out, m)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --------------------------------------------------------------------------- the walk
+
+type hzWalk struct {
+	method   string
+	autoHead bool
+	values   []string
+	slots    [64]string // the router's pathValues: set on the way down, cleared on backtracking
+	best     *hzNode    // the first node with handlers reached with the whole path consumed
+	// results
+	matched  *hzRoute // the route found for the method (or Any)
+	notFound *hzRoute // the RouteNotFound route that took the request
+	values0  []string // the values at the match
+}
+
+// step walks the trie in the router's order: at a node whose path is consumed, its handlers;
+// then the static child, the :param child, the * child; a failing branch is abandoned for the
+// next kind. It reports whether the walk stopped (a match, or a stop the router makes).
+func (w *hzWalk) step(n *hzNode, search string) bool {
+	if search == "" {
+		if n.isHandler() {
+			if w.best == nil {
+				w.best = n
+			}
+			if r := n.find(w.method, w.autoHead); r != nil {
+				w.matched = r
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+		} else if n.notFound != nil {
+			if HZKnown.notFoundRouteStops || w.best == nil {
+				w.notFound = n.notFound
+				w.values0 = append([]string(nil), w.values...)
+				return true
+			}
+		}
+	}
+	if search != "" {
+		if c := n.static[search[0]]; c != nil {
+			if w.step(c, search[1:]) {
+				return true
+			}
+		}
+	}
+	if search != "" && n.param != nil {
+		i := 0
+		if n.param.isLeaf() {
+			i = len(search) // a parameter at the end of its route takes the rest of the path
+		} else {
+			for i < len(search) && search[i] != '/' {
+				i++
+			}
+		}
+		w.push(search[:i])
+		if w.step(n.param, search[i:]) {
+			return true
+		}
+		w.pop()
+	}
+	if a := n.any; a != nil {
+		w.push(search)
+		if r := a.find(w.method, w.autoHead); r != nil {
+			w.matched = r
+			w.values0 = append([]string(nil), w.values...)
+			return true
+		}
+		if w.best == nil {
+			w.best = a
+		}
+		if a.notFound != nil && (HZKnown.notFoundRouteStops || w.best == a) {
+			w.notFound = a.notFound
+			w.values0 = append([]string(nil), w.values...)
+			return true
+		}
+		if HZKnown.anyStopsBacktrack {
+			return true // the router does not look past a wildcard node (the value stays set)
+		}
+		w.pop()
+	}
+	return false
+}
+
+func (w *hzWalk) push(v string) {
+	w.slots[len(w.values)] = v
+	w.values = append(w.values, v)
+}
+
+func (w *hzWalk) pop() {
+	w.values = w.values[:len(w.values)-1]
+	w.slots[len(w.values)] = ""
+}
+
+// --------------------------------------------------------------------------- the answer
+
+type hzOptions struct {
+	unescapeValues bool
+	escapedPath    bool
+	autoHead       bool
+}
+
+type hzAnswer struct {
+	code  int
+	body  string
+	allow []string // nil when no Allow header
+}
+
+func (a hzAnswer) String() string {
+	return fmt.Sprintf("%d %q allow=%v", a.code, a.body, a.allow)
+}
+
+// hzEcho is what the test handlers write: the route's path and its values.
+func hzEcho(prefix, path string, names, values []string) string {
+	var sb strings.Builder
+	sb.WriteString(prefix)
+	sb.WriteString(path)
+	for i, v := range values {
+		name := "?"
+		if i < len(names) {
+			name = names[i]
+		}
+		sb.WriteString("|" + name + "=" + v)
+	}
+	return sb.String()
+}
+
+// hzModelServe is the router's answer to a request, from the documentation.
+func hzModelServe(routes []*hzRoute, o hzOptions, method string, u *url.URL) hzAnswer {
+	return hzModelServeTree(hzBuildTree(routes), o, method, u)
+}
+
+// hzModelServeTree is hzModelServe over a built tree.
+func hzModelServeTree(root *hzNode, o hzOptions, method string, u *url.URL) hzAnswer {
+	path := u.Path
+	if !o.escapedPath && u.RawPath != "" {
+		// the option is documented the other way round: see HZKnown.escapedPathInverted
+		path = u.RawPath
+	}
+	if !HZKnown.escapedPathInverted {
+		path = u.Path
+		if o.escapedPath && u.RawPath != "" {
+			path = u.RawPath
+		}
+	}
+	w := &hzWalk{method: method, autoHead: o.autoHead}
+	w.step(root, path)
+
+	values := func(vs []string) []string {
+		if !o.unescapeValues {
+			return vs
+		}
+		out := make([]string, len(vs))
+		for i, v := range vs {
+			if s, err := url.PathUnescape(v); err == nil {
+				out[i] = s
+			} else {
+				out[i] = v
+			}
+		}
+		return out
+	}
+	if w.matched != nil {
+		r := w.matched
+		body := hzEcho("", r.norm, r.names, values(w.values0))
+		if method == http.MethodHead && r.method == http.MethodGet && o.autoHead {
+			body = "" // the GET handler wrapped for HEAD: the body is dropped
+		}
+		return hzAnswer{code: 200, body: body}
+	}
+	if w.notFound != nil {
+		r := w.notFound
+		return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.values0))}
+	}
+	if w.best != nil {
+		if r := w.best.notFound; r != nil {
+			// the RouteNotFound route of the best node answers before a 405, with whatever the
+			// walk left in the value slots
+			return hzAnswer{code: 404, body: hzEcho("nf:", r.norm, r.names, values(w.slots[:len(r.names)]))}
+		}
+		allow := w.best.allow()
+		if method == http.MethodOptions {
+			return hzAnswer{code: 204, body: "", allow: allow}
+		}
+		body := "{\"message\":\"Method Not Allowed\"}\n"
+		if method == http.MethodHead {
+			body = ""
+		}
+		return hzAnswer{code: 405, body: body, allow: allow}
+	}
+	body := "{\"message\":\"Not Found\"}\n"
+	if method == http.MethodHead {
+		body = ""
+	}
+	return hzAnswer{code: 404, body: body}
+}
+
+// --------------------------------------------------------------------------- the engine
+
+// hzNewEcho builds an Echo with the options and registers the routes (the handlers echo the
+// route path and the path values). Registration errors are returned.
+func hzNewEcho(routes []*hzRoute, o hzOptions) (*echo.Echo, error) {
+	r := echo.NewRouter(echo.RouterConfig{
+		AllowOverwritingRoute:     true,
+		UnescapePathParamValues:   o.unescapeValues,
+		UseEscapedPathForMatching: o.escapedPath,
+		AutoHandleHEAD:            o.autoHead,
+	})
+	e := echo.NewWithConfig(echo.Config{Router: r})
+	for _, rt := range routes {
+		rt := rt
+		prefix, code := "", 200
+		if rt.method == echo.RouteNotFound {
+			prefix, code = "nf:", 404
+		}
+		h := func(c *echo.Context) error {
+			var vals []string
+			var names []string
+			for _, pv := range c.PathValues() {
+				names = append(names, pv.Name)
+				vals = append(vals, pv.Value)
+			}
+			return c.String(code, hzEcho(prefix, c.Path(), names, vals))
+		}
+		if _, err := e.AddRoute(echo.Route{Method: rt.method, Path: rt.path, Handler: h}); err != nil {
+			return nil, err
+		}
+	}
+	return e, nil
+}
+
+// hzServe serves one request and returns the answer.
+func hzServe(e *echo.Echo, method, target string) hzAnswer {
+	req := httptest.NewRequest(method, target, nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	a := hzAnswer{code: rec.Code, body: rec.Body.String()}
+	if h := rec.Header().Get("Allow"); h != "" || rec.Header().Values("Allow") != nil {
+		a.allow = strings.Split(h, ", ")
+		sort.Strings(a.allow)
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzWords = []string{"a", "b", "ab", "abc", "users", "new", "x1", "file.txt", "v1"}
+
+var hzParamNames = []string{"id", "name", "p", "q", ""}
+
+var hzMethods = []string{
+	http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+	http.MethodDelete, http.MethodPatch, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND",
+}
+
+// hzGenPattern draws a route pattern.
+func hzGenPattern(tc hegel.TestCase) string {
+	if hzChance(tc, 4) {
+		return hzPick(tc, []string{"/", "", "/*", "*"})
+	}
+	var sb strings.Builder
+	n := hzDrawInt(tc, 1, 4)
+	if hzChance(tc, 6) {
+		// no leading slash: the router adds one
+	} else {
+		sb.WriteString("/")
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			sb.WriteString("/")
+		}
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 50:
+			sb.WriteString(hzPick(tc, hzWords))
+		case r <= 76:
+			sb.WriteString(":" + hzPick(tc, hzParamNames))
+		case r <= 84:
+			// static text and a parameter in one segment
+			sb.WriteString(hzPick(tc, []string{"a2", "file.", "name", "v"}) + ":" + hzPick(tc, hzParamNames))
+		case r <= 90:
+			// an escaped colon
+			sb.WriteString(hzPick(tc, []string{"file\\:undelete", "name\\:verb", "\\:x"}))
+		default:
+			sb.WriteString("*")
+			if hzChance(tc, 20) {
+				sb.WriteString("/" + hzPick(tc, hzWords)) // dropped by the router
+			}
+			return sb.String()
+		}
+	}
+	if hzChance(tc, 15) {
+		sb.WriteString("/")
+	}
+	return sb.String()
+}
+
+// hzGenRoutes draws 1-6 routes.
+func hzGenRoutes(tc hegel.TestCase) []*hzRoute {
+	n := hzDrawInt(tc, 1, 6)
+	routes := make([]*hzRoute, 0, n)
+	for i := 0; i < n; i++ {
+		method := hzPick(tc, hzMethods)
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 10:
+			method = echo.RouteAny
+		case r <= 20:
+			method = echo.RouteNotFound
+		}
+		routes = append(routes, hzNewRoute(method, hzGenPattern(tc)))
+	}
+	return routes
+}
+
+var hzValues = []string{"a", "b", "abc", "users", "new", "1", "x/y", "", "%2F", "%20", "a%2Fb", "what%27s", "new2", "skills"}
+
+// hzGenTarget draws a request target: mostly the routes' own patterns with values filled in,
+// with variations (case, trailing slash, an extra segment, a missing one).
+func hzGenTarget(tc hegel.TestCase, routes []*hzRoute) string {
+	if hzChance(tc, 8) {
+		return hzPick(tc, []string{"/", "/a", "/users/", "//", "/a//b", "/%2F", "/.", "/../a"})
+	}
+	r := hzPick(tc, routes)
+	var sb strings.Builder
+	for _, t := range r.toks {
+		switch t.kind {
+		case hzStatic:
+			text := t.text
+			if hzChance(tc, 6) {
+				text = strings.ToUpper(text)
+			}
+			if hzChance(tc, 5) && len(text) > 1 {
+				text = text[:len(text)-1] // one byte short
+			}
+			sb.WriteString(text)
+		case hzParam:
+			sb.WriteString(hzPick(tc, hzValues))
+		case hzAny:
+			sb.WriteString(hzPick(tc, hzValues))
+			if hzChance(tc, 40) {
+				sb.WriteString("/" + hzPick(tc, hzValues))
+			}
+		}
+	}
+	s := sb.String()
+	switch r := hzDrawInt(tc, 1, 100); {
+	case r <= 8:
+		s += "/"
+	case r <= 14:
+		s = strings.TrimSuffix(s, "/")
+	case r <= 20:
+		s += "/" + hzPick(tc, hzWords)
+	case r <= 24:
+		s += "?q=1"
+	}
+	if s == "" || s[0] != '/' {
+		s = "/" + s
+	}
+	return s
+}
+
+var hzRequestMethods = []string{
+	http.MethodGet, http.MethodGet, http.MethodGet, http.MethodPost, http.MethodPut,
+	http.MethodDelete, http.MethodHead, http.MethodHead, http.MethodOptions, "COPY", "PROPFIND", "LOCK",
+}
+
+// hzShowRoutes renders a route set.
+func hzShowRoutes(routes []*hzRoute) string {
+	var parts []string
+	for _, r := range routes {
+		parts = append(parts, r.method+" "+r.path)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzTarget parses a request target as httptest.NewRequest does, to give the model the URL.
+func hzTarget(method, target string) *url.URL {
+	return httptest.NewRequest(method, target, nil).URL
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelRoute: the engine's answer to generated requests against generated routes, under
+// the router options, against the model.
+func TestHegelRoute(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		routes := hzGenRoutes(ht)
+		o := hzOptions{
+			unescapeValues: hzChance(ht, 30),
+			escapedPath:    hzChance(ht, 30),
+			autoHead:       hzChance(ht, 30),
+		}
+		if HZKnown.escapedColonCollision && hzCollides(hzBuildTree(routes)) {
+			c.count("collision")
+			return
+		}
+		e, err := hzNewEcho(routes, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+			return
+		}
+		for i := 0; i < 3; i++ {
+			method := hzPick(ht, hzRequestMethods)
+			target := hzGenTarget(ht, routes)
+			var got hzAnswer
+			if r := hzCatch(func() { got = hzServe(e, method, target) }); r != nil {
+				c.failClass(ht, "panic", "routes %s\noptions %+v\n%s %s\npanic: %v", hzShowRoutes(routes), o, method, target, r)
+				return
+			}
+			want := hzModelServe(routes, o, method, hzTarget(method, target))
+			c.count(fmt.Sprintf("%d", got.code))
+			if got.String() != want.String() {
+				c.failClass(ht, "", "routes %s\noptions %+v\n%s %s\n got %s\nwant %s", hzShowRoutes(routes), o, method, target, got, want)
+				return
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..d2e80e2
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,166 @@
+package hegel
+
+// Hegel property tests for labstack/echo v5's router, written for the Hegel zoo. See
+// targets/go/echo/README.md. They live in a package of their own (hegel/) and drive the router
+// through the public API: echo.NewWithConfig with a NewRouter(RouterConfig{...}), AddRoute, and
+// ServeHTTP on httptest requests, the handlers echoing the route and its path values.
+//
+// Oracles: a model of route matching (static text first, then a :param, then a *, with
+// backtracking; RouteNotFound routes; 405 with the Allow header; the default OPTIONS answer;
+// AutoHandleHEAD; the escaped-path and unescape-values options) over generated route sets and
+// requests; the law that registration order does not matter; RouteInfo.Reverse round trips;
+// Remove leaving the other routes as they were.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	anyStopsBacktrack        bool // a wildcard node without the method ends the search: alternatives above it are not tried
+	notFoundRouteStops       bool // a RouteNotFound route reached with the path consumed ends the search before lower-priority routes
+	escapedPathInverted      bool // UseEscapedPathForMatching selects the decoded path, the default the escaped one
+	escapedColonCollision    bool // an escaped colon and a :param at one position corrupt the tree (routes lost, a panic)
+	removeCustomMethodPanics bool // Remove of a route with a custom method panics
+	removeSlashlessPath      bool // Remove of a route registered without a leading slash deletes another RouteInfo
+	removeLosesWay           bool // Remove does not find routes after a parameter, with an escaped colon, or at a node re-registered under another path
+	removeDropsNotFound      bool // Remove prunes a RouteNotFound route on its way up the tree
+}{true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
