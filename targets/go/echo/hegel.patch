+package hegel
+
+// Registration order, RouteInfo.Reverse and DefaultRouter.Remove.
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- order
+
+// hzOrderCase: a route set in which no route replaces another, the sort keys of its
+// permutation (recycled modulo the routes; none or all equal: the same order), the
+// AutoHandleHEAD option and the requests served against both registrations.
+type hzOrderCase struct {
+	routes   []*hzRoute
+	keys     []int
+	autoHead bool
+	reqs     []hzRequest
+}
+
+func (c hzOrderCase) perm() []*hzRoute { return hzShuffled(c.routes, c.keys) }
+
+func (c hzOrderCase) GoString() string {
+	return fmt.Sprintf("routes %s\nreordered %s\nautoHead %v\nrequests %s", hzShowRoutes(c.routes), hzShowRoutes(c.perm()), c.autoHead, hzShowRequests(c.reqs, c.routes))
+}
+
+var hzOrderCases = hegel.Composite(func(tc hegel.TestCase) hzOrderCase {
+	return hzOrderCase{
+		routes:   hegel.Draw(tc, hzDistinctRouteSets),
+		keys:     hegel.Draw(tc, hzMany(hzPositions, 0, 6)),
+		autoHead: hegel.Draw(tc, hzCoin(30)),
+		reqs:     hegel.Draw(tc, hzRequestLists),
+	}
+})
+
+// TestHegelRouteOrder: the answers do not depend on the order the routes were registered in
+// (for routes that do not replace one another).
+func TestHegelRouteOrder(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzOrderCases)
+		o := hzOptions{autoHead: cs.autoHead}
+		e1, err := hzNewEcho(cs.routes, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(cs.routes), err)
+			return
+		}
+		perm := cs.perm()
+		e2, err := hzNewEcho(perm, o)
+		if err != nil {
+			c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(perm), err)
+			return
+		}
+		collide := hzRouteShapes(cs.routes)
+		for _, q := range cs.reqs {
+			target := q.target.render(cs.routes)
+			var a1, a2 hzAnswer
+			if r := hzCatch(func() { a1 = hzServe(e1, q.method, target); a2 = hzServe(e2, q.method, target) }); r != nil {
+				c.mismatch(ht, collide, "panic", "routes %s\n%s %s\npanic: %v", hzShowRoutes(cs.routes), q.method, target, r)
+				return
+			}
+			c.count(fmt.Sprintf("%d", a1.code))
+			if a1.String() != a2.String() {
+				c.mismatch(ht, collide, "", "routes %s\nreordered %s\n%s %s\n first %s\nsecond %s", hzShowRoutes(cs.routes), hzShowRoutes(perm), q.method, target, a1, a2)
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- reverse
+
+// hzModelReverse is RouteInfo.Reverse as documented: each parameter (":name" up to the next
+// "/", or "*" up to the next "/") replaced by the next value; "\:" is a literal colon.
+func hzModelReverse(path string, values []string) string {
+	var sb strings.Builder
+	n := 0
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		if c == '\\' && i+1 < len(path) && path[i+1] == ':' {
+			sb.WriteByte(':')
+			i++
+			continue
+		}
+		if (c == ':' || c == '*') && n < len(values) {
+			sb.WriteString(values[n])
+			n++
+			for i < len(path) && path[i] != '/' {
+				i++
+			}
+			if i < len(path) {
+				sb.WriteByte('/')
+			}
+			continue
+		}
+		sb.WriteByte(c)
+	}
+	return sb.String()
+}
+
+// hzReverseValues: a value for Reverse: one that makes a request target 70% of the time, else
+// one with a space, a quote, a slash or nothing.
+var hzReverseValues = hzWeighted(
+	hzChoice[string]{70, hegel.SampledFrom([]string{"a", "b", "abc", "1", "new", "a:b"})},
+	hzChoice[string]{30, hegel.SampledFrom([]string{"x%20y", "what's", "", "x/y"})},
+)
+
+// hzReverseCase: a route set, the position of the route reversed (modulo the routes) and the
+// values passed to Reverse (cut to the route's parameter count, or one more when over).
+type hzReverseCase struct {
+	routes []*hzRoute
+	pick   int
+	values []string
+	over   bool
+}
+
+// valuesFor is the values passed for the route: the drawn ones cut to its parameter count
+// (plus one when over).
+func (c hzReverseCase) valuesFor(params int) []string {
+	n := params
+	if c.over {
+		n++
+	}
+	if len(c.values) > n {
+		return c.values[:n]
+	}
+	return c.values
+}
+
+func (c hzReverseCase) GoString() string {
+	return fmt.Sprintf("routes %s\nreverse route %d with %q over=%v", hzShowRoutes(c.routes), c.pick%len(c.routes), c.values, c.over)
+}
+
+var hzReverseCases = hegel.Composite(func(tc hegel.TestCase) hzReverseCase {
+	return hzReverseCase{
+		routes: hegel.Draw(tc, hzDistinctRouteSets),
+		pick:   hegel.Draw(tc, hzPositions),
+		values: hegel.Draw(tc, hzMany(hzReverseValues, 0, 6)),
+		over:   hegel.Draw(tc, hzCoin(15)),
+	}
+})
+
+// hzIsTarget reports whether a reversed path can be served as a request target as it is:
+// no query or fragment, a leading slash, and values without "/", "%", spaces or quotes.
+func hzIsTarget(path string, values []string) bool {
+	if strings.ContainsAny(path, "?#") || path == "" || path[0] != '/' {
+		return false
+	}
+	for _, v := range values {
+		if v == "" || strings.ContainsAny(v, "/% '") {
+			return false
+		}
+	}
+	return true
+}
+
+// hzCheckReverse reverses the case's route and serves the result against the model.
+func hzCheckReverse(c *hzCollector, ht *hegel.T, cs hzReverseCase) {
+	e, err := hzNewEcho(cs.routes, hzOptions{})
+	if err != nil {
+		c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(cs.routes), err)
+		return
+	}
+	infos := e.Router().Routes()
+	if len(infos) != len(cs.routes) {
+		c.failClass(ht, "routes", "routes %s\nRoutes() has %d entries", hzShowRoutes(cs.routes), len(infos))
+		return
+	}
+	ri := hzAt(infos, cs.pick)
+	values := cs.valuesFor(len(ri.Parameters))
+	args := make([]any, len(values))
+	for i, v := range values {
+		args[i] = v
+	}
+	got := ri.Reverse(args...)
+	want := hzModelReverse(ri.Path, values)
+	if got != want {
+		c.failClass(ht, "reverse", "route %s %q\nvalues %q\n got %q\nwant %q", ri.Method, ri.Path, values, got, want)
+		return
+	}
+	// serve it (when the values fill the route and make a request target): the verdict of
+	// the round trip, after the one of Reverse
+	if len(values) != len(ri.Parameters) || !hzIsTarget(got, values) {
+		c.count("reversed")
+		return
+	}
+	method := ri.Method
+	if method == echo.RouteAny || method == echo.RouteNotFound {
+		method = http.MethodGet
+	}
+	c.count("served")
+	hzServeAgainstModel(c, ht, e, cs.routes, hzOptions{}, []hzRequest{{method: method, target: hzTargetSpec{fixed: &got}}},
+		fmt.Sprintf("routes %s\nreverse of %s %s with %q", hzShowRoutes(cs.routes), ri.Method, ri.Path, values))
+}
+
+// TestHegelReverse: RouteInfo.Reverse against its documentation, and the reversed URL served
+// against the model.
+func TestHegelReverse(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckReverse(c, ht, hegel.Draw(ht, hzReverseCases))
+	})
+}
+
+// --------------------------------------------------------------------------- remove
+
+func hzShowInfos(infos echo.Routes) string {
+	var parts []string
+	for _, ri := range infos {
+		parts = append(parts, ri.Method+" "+ri.Path)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// hzRadix is a node of the router's radix tree, read off the byte trie: the chain of bytes
+// from a first byte-node through nodes with one static child and nothing else.
+type hzRadix struct {
+	end    *hzNode
+	prefix string
+	kind   hzTokKind
+}
+
+func hzRadixFrom(n *hzNode, kind hzTokKind) hzRadix {
+	if kind != hzStatic {
+		return hzRadix{end: n, prefix: string(n.label), kind: kind}
+	}
+	prefix := []byte{n.label}
+	for !n.boundary {
+		var c *hzNode
+		for _, c = range n.static {
+		}
+		n = c
+		prefix = append(prefix, n.label)
+	}
+	return hzRadix{end: n, prefix: string(prefix), kind: hzStatic}
+}
+
+// hzModelRemove is DefaultRouter.Remove on the model tree: the documented outcome (the route
+// is gone) when the route is registered; with sw.removeLosesWay, the router's own walk down
+// the tree (which loses its way after a parameter, at an escaped colon and at a node whose
+// last registration was another route). Returns whether the removal happened.
+func hzModelRemove(root *hzNode, r *hzRoute, sw hzSwitches) bool {
+	var node *hzNode
+	if sw.removeLosesWay {
+		cur := hzRadixFrom(root.static['/'], hzStatic)
+		path := r.norm
+		prefixLen := 0
+		for {
+			if cur.end.lastPath == path && cur.end.isHandler() {
+				node = cur.end
+				break
+			}
+			if cur.kind == hzStatic {
+				prefixLen += len(cur.prefix)
+			} else {
+				prefixLen = len(cur.end.lastPath)
+			}
+			if prefixLen >= len(path) {
+				break
+			}
+			var next *hzNode
+			kind := hzStatic
+			switch b := path[prefixLen]; b {
+			case ':':
+				next, kind = cur.end.param, hzParam
+			case '*':
+				next, kind = cur.end.any, hzAny
+			default:
+				next = cur.end.static[b]
+			}
+			if next == nil {
+				break
+			}
+			cur = hzRadixFrom(next, kind)
+		}
+		if node == nil {
+			return false
+		}
+	} else {
+		node = root
+		for _, tk := range r.toks {
+			switch tk.kind {
+			case hzStatic:
+				for i := 0; i < len(tk.text) && node != nil; i++ {
+					node = node.static[tk.text[i]]
+				}
+			case hzParam:
+				node = node.param
+			case hzAny:
+				node = node.any
+			}
+			if node == nil {
+				return false
+			}
+		}
+	}
+	if r.method == echo.RouteNotFound {
+		if node.notFound == nil {
+			return false
+		}
+		node.notFound = nil
+	} else {
+		if node.methods[r.method] == nil {
+			return false
+		}
+		delete(node.methods, r.method)
+	}
+	// the router prunes the node and its parents while they are leaves without handlers (a
+	// RouteNotFound route is not a handler to it: sw.removeDropsNotFound)
+	for n := node; n != nil && n.parent != nil && !n.inRoot && n.isLeaf() && !n.isHandler(); n = n.parent {
+		if n.notFound != nil && !sw.removeDropsNotFound {
+			break
+		}
+		switch n.label {
+		case ':':
+			if n.parent.param == n {
+				n.parent.param = nil
+			}
+		case '*':
+			if n.parent.any == n {
+				n.parent.any = nil
+			}
+		}
+		if n.parent.static[n.label] == n {
+			delete(n.parent.static, n.label)
+		}
+	}
+	return true
+}
+
+// hzReplayRemovals builds the tree of the routes and removes the removed routes in order under
+// the switches; it returns the tree and whether each removal happened.
+func hzReplayRemovals(routes, removed []*hzRoute, sw hzSwitches) (*hzNode, []bool) {
+	root := hzBuildTree(routes)
+	oks := make([]bool, len(removed))
+	for i, r := range removed {
+		oks[i] = hzModelRemove(root, r, sw)
+	}
+	return root, oks
+}
+
+var hzRemoveSwitches = []hzServeSwitch{
+	{"echo/8", func(s *hzSwitches) { s.removeLosesWay = !s.removeLosesWay }},
+	{"echo/9", func(s *hzSwitches) { s.removeDropsNotFound = !s.removeDropsNotFound }},
+}
+
+// hzIsCustomMethod: a method the router keeps in its anyOther map.
+func hzIsCustomMethod(m string) bool {
+	switch m {
+	case http.MethodConnect, http.MethodDelete, http.MethodGet, http.MethodHead, http.MethodOptions,
+		http.MethodPatch, http.MethodPost, "PROPFIND", http.MethodPut, http.MethodTrace, "REPORT", "QUERY",
+		echo.RouteAny, echo.RouteNotFound:
+		return false
+	}
+	return true
+}
+
+// hzRemovable reports whether the route may be removed by the case: under HEGEL_NO_KNOWN=1
+// routes with a custom method (echo/6) or registered without a leading slash (echo/7) are
+// left in place.
+func hzRemovable(r *hzRoute) bool {
+	return !hzNoKnown || (!hzIsCustomMethod(r.method) && r.path == r.norm)
+}
+
+// hzWantInfos is the Routes() listing expected after the removals: the routes in
+// registration order, without those whose removal happened.
+func hzWantInfos(routes, removed []*hzRoute, oks []bool) string {
+	gone := map[*hzRoute]bool{}
+	for i, r := range removed {
+		if oks[i] {
+			gone[r] = true
+		}
+	}
+	var out []string
+	for _, r := range routes {
+		if !gone[r] {
+			out = append(out, r.method+" "+r.path)
+		}
+	}
+	return strings.Join(out, "; ")
+}
+
+// hzRemoveCase: a route set in which no route replaces another, the mask of the routes removed
+// (recycled modulo the routes; none: no removal), an absent route whose removal must fail, and
+// the requests served afterwards.
+type hzRemoveCase struct {
+	routes []*hzRoute
+	mask   []bool
+	absent *hzRoute
+	reqs   []hzRequest
+}
+
+// removed is the routes the mask selects (and the case may remove).
+func (c hzRemoveCase) removed() []*hzRoute {
+	var out []*hzRoute
+	for i, r := range c.routes {
+		if len(c.mask) > 0 && c.mask[i%len(c.mask)] && hzRemovable(r) {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+func (c hzRemoveCase) GoString() string {
+	absent := "none"
+	if c.absent != nil {
+		absent = c.absent.method + " " + c.absent.path
+	}
+	return fmt.Sprintf("routes %s\nremoved %s\nabsent %s\nrequests %s", hzShowRoutes(c.routes), hzShowRoutes(c.removed()), absent, hzShowRequests(c.reqs, c.routes))
+}
+
+var (
+	// hzAbsentRoutes: a route with a standard method and a leading slash, to be removed
+	// without having been registered.
+	hzAbsentRoutes = hegel.Composite(func(tc hegel.TestCase) *hzRoute {
+		return hzNewRoute(hegel.Draw(tc, hzStandardMethods), hzNormalize(hegel.Draw(tc, hzPatternTexts)))
+	})
+	hzRemoveCases = hegel.Composite(func(tc hegel.TestCase) hzRemoveCase {
+		return hzRemoveCase{
+			routes: hegel.Draw(tc, hzDistinctRouteSets),
+			mask:   hegel.Draw(tc, hzMany(hzCoin(40), 0, 6)),
+			absent: hegel.Draw(tc, hzMaybe(30, hzAbsentRoutes)),
+			reqs:   hegel.Draw(tc, hzRequestLists),
+		}
+	})
+)
+
+// hzCheckRemove registers the case's routes, removes the removed ones (and the absent one),
+// and compares the removals' outcomes, the Routes() listing and the answers to the requests
+// with the model.
+func hzCheckRemove(c *hzCollector, ht *hegel.T, cs hzRemoveCase) {
+	routes := cs.routes
+	e, err := hzNewEcho(routes, hzOptions{})
+	if err != nil {
+		c.failClass(ht, "add", "routes %s\nadd error: %v", hzShowRoutes(routes), err)
+		return
+	}
+	removed := cs.removed()
+	root, oks := hzReplayRemovals(routes, removed, HZKnown)
+	prefix := fmt.Sprintf("routes %s\nremoved %s", hzShowRoutes(routes), hzShowRoutes(removed))
+	for i, r := range removed {
+		var err error
+		if p := hzCatch(func() { err = e.Router().Remove(r.method, r.path) }); p != nil {
+			c.mismatch(ht, hzShapeIf(hzIsCustomMethod(r.method), "echo/6"), "panic", "%s\nremove %s %s\npanic: %v", prefix, r.method, r.path, p)
+			return
+		}
+		if (err == nil) != oks[i] {
+			shapes := hzShapeIf(hzCollides(hzBuildTree(routes)), "echo/1")
+			shapes = append(shapes, hzSwitchShapes(hzRemoveSwitches, func(sw hzSwitches) bool {
+				_, toggled := hzReplayRemovals(routes, removed[:i+1], sw)
+				return toggled[i] == (err == nil)
+			})...)
+			c.mismatch(ht, shapes, "error", "%s\nremove %s %s\n got error %v\nwant removed %v", prefix, r.method, r.path, err, oks[i])
+			return
+		}
+		if !oks[i] {
+			c.count("remove failed")
+		}
+	}
+	// a route that is not there
+	if a := cs.absent; a != nil && !hzRegistered(routes, a) {
+		var err error
+		if p := hzCatch(func() { err = e.Router().Remove(a.method, a.path) }); p != nil {
+			c.failClass(ht, "panic", "%s\nremove absent %s %s\npanic: %v", prefix, a.method, a.path, p)
+			return
+		}
+		if err == nil {
+			c.failClass(ht, "absent", "%s\nremove absent %s %s: no error", prefix, a.method, a.path)
+			return
+		}
+	}
+	gotInfos := hzShowInfos(e.Router().Routes())
+	if want := hzWantInfos(routes, removed, oks); gotInfos != want {
+		shapes := append(hzShapeIf(hzAnySlashless(removed), "echo/7"), hzShapeIf(hzTailAfterWild(routes), "echo/5")...)
+		shapes = append(shapes, hzSwitchShapes(hzRemoveSwitches, func(sw hzSwitches) bool {
+			_, toggled := hzReplayRemovals(routes, removed, sw)
+			return hzWantInfos(routes, removed, toggled) == gotInfos
+		})...)
+		c.mismatch(ht, shapes, "routes", "%s\nRoutes() %s\nwant %s", prefix, gotInfos, want)
+		return
+	}
+	c.count(fmt.Sprintf("removed %d", len(removed)))
+	for _, q := range cs.reqs {
+		target := q.target.render(routes)
+		var got hzAnswer
+		if r := hzCatch(func() { got = hzServe(e, q.method, target) }); r != nil {
+			c.mismatch(ht, hzRouteShapes(routes), "panic", "%s\n%s %s\npanic: %v", prefix, q.method, target, r)
+			return
+		}
+		u := hzURLOf(q.method, target)
+		want := hzModelServeTree(root, hzOptions{}, q.method, u, HZKnown)
+		if got.String() != want.String() {
+			shapes := hzRouteShapes(routes)
+			shapes = append(shapes, hzSwitchShapes(append(append([]hzServeSwitch{}, hzRemoveSwitches...), hzServeSwitches...), func(sw hzSwitches) bool {
+				tree, _ := hzReplayRemovals(routes, removed, sw)
+				return hzModelServeTree(tree, hzOptions{}, q.method, u, sw).String() == got.String()
+			})...)
+			c.mismatch(ht, shapes, "", "%s\n%s %s\n got %s\nwant %s", prefix, q.method, target, got, want)
+			return
+		}
+	}
+}
+
+// TestHegelRemove: after removing some routes, Routes() lists the others and requests are
+// answered as if only the others had been registered; an absent route's removal is an error.
+func TestHegelRemove(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckRemove(c, ht, hegel.Draw(ht, hzRemoveCases))
+	})
+}
+
+// hzRegistered reports whether a route of the method and normalised path is in the set.
+func hzRegistered(routes []*hzRoute, r *hzRoute) bool {
+	for _, x := range routes {
+		if x.method == r.method && x.norm == r.norm {
+			return true
+		}
+	}
+	return false
+}
+
+// hzAnySlashless reports whether a route of the set was registered without a leading slash.
+func hzAnySlashless(routes []*hzRoute) bool {
+	for _, r := range routes {
+		if r.path != r.norm {
+			return true
+		}
+	}
+	return false
+}
