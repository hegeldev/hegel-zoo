+
+func mustMarshal(t *testing.T, v any, opts ...EncodeOption) []byte {
+	t.Helper()
+	b, err := MarshalWithOptions(v, opts...)
+	if err != nil {
+		t.Fatalf("Marshal(%#v): %v", v, err)
+	}
+	return b
+}
+
+func roundTripAny(t *testing.T, v any, opts ...EncodeOption) {
+	t.Helper()
+	doc := mustMarshal(t, v, opts...)
+	var got any
+	err := Unmarshal(doc, &got)
+	if err != nil {
+		t.Errorf("Marshal(%#v) = %q; Unmarshal: %v", v, doc, err)
+		return
+	}
+	if !sameCanon(canon(got), canon(v)) {
+		t.Errorf("Marshal(%#v) = %q; Unmarshal gives %#v", v, doc, got)
+	}
+}
+
+func v3Reads(t *testing.T, v any, doc []byte) {
+	t.Helper()
+	var got any
+	if err := yamlv3.Unmarshal(doc, &got); err != nil {
+		t.Errorf("Marshal(%#v) = %q; yaml.v3 rejects it: %v", v, doc, err)
+		return
+	}
+	if !sameCanon(canon(got), canon(v)) {
+		t.Errorf("Marshal(%#v) = %q; yaml.v3 reads %#v", v, doc, got)
+	}
+}
