+func TestHegelJSONStyleOutputIsJSONWithTheSameValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, 3, strMode{printable: true}, false)
+		in := toGo(ht, v)
+		want := canonVal(v)
+		doc, err := MarshalWithOptions(in, JSON())
+		if err != nil {
+			ht.Fatalf("Marshal with JSON(): %v", err)
+		}
+		note(ht, "value: %s\nJSON():\n%s", render(in), doc)
+		dec := json.NewDecoder(bytes.NewReader(doc))
+		dec.UseNumber()
+		var got any
+		if err := dec.Decode(&got); err != nil {
+			ht.Fatalf("encoding/json rejects the JSON() output: %v", err)
+		}
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("JSON() output decodes differently:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+		var back any
+		if err := Unmarshal(doc, &back); err != nil {
+			ht.Fatalf("goccy cannot read its JSON() output: %v", err)
+		}
+		if !sameCanon(canon(back), want) {
+			ht.Fatalf("goccy reads its JSON() output differently:\n want %s\n got  %s", render(want), render(canon(back)))
+		}
+		// YAMLToJSON and JSONToYAML.
+		plain, err := Marshal(in)
+		if err != nil {
+			ht.Fatalf("Marshal: %v", err)
+		}
+		j, err := YAMLToJSON(plain)
+		if err != nil {
+			ht.Fatalf("YAMLToJSON(%q): %v", plain, err)
+		}
+		dec = json.NewDecoder(bytes.NewReader(j))
+		dec.UseNumber()
+		var got2 any
+		if err := dec.Decode(&got2); err != nil {
+			ht.Fatalf("YAMLToJSON output is not JSON: %v\n%s", err, j)
+		}
+		if !sameCanon(canon(got2), want) {
+			ht.Fatalf("YAMLToJSON changed the value:\n want %s\n got  %s", render(want), render(canon(got2)))
+		}
+		// JSONToYAML: JSON has no integer/float distinction, so the expectation is what
+		// encoding/json itself reads back from json.Marshal(in).
+		jin, _ := json.Marshal(in)
+		dec = json.NewDecoder(bytes.NewReader(jin))
+		dec.UseNumber()
+		var viaJSON any
+		if err := dec.Decode(&viaJSON); err != nil {
+			ht.Fatalf("test-suite defect: %v", err)
+		}
+		wantJ := canon(viaJSON)
+		y, err := JSONToYAML(jin)
+		if err != nil {
+			ht.Fatalf("JSONToYAML(%s): %v", jin, err)
+		}
+		var got3 any
+		if err := Unmarshal(y, &got3); err != nil {
+			ht.Fatalf("JSONToYAML output unreadable: %v\n%s", err, y)
+		}
+		if !sameCanon(canon(got3), wantJ) {
+			ht.Fatalf("JSONToYAML changed the value:\n want %s\n got  %s\n%s", render(wantJ), render(canon(got3)), y)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// A randomised YAML 1.2 writer for the decoder side.
+
+type emitter struct {
+	tc hegel.TestCase
+	// fragileTail is set after writing a literal block that goccy would reject if empty
+	// lines followed it at the end of the stream (go-yaml/27).
+	fragileTail bool
+}
+
+func (e *emitter) sp() string { return strings.Repeat(" ", n(e.tc, 0, 2)) }
+
+var plainBanFirst = "-?:,[]{}#&*!|>'\"%@` \t"
+
+// plainSafe reports whether s may be written as a plain scalar (block context, or flow
+// context when flow is set) and be read back as exactly that string by yaml.v2/1.2 readers.
+func (e *emitter) plainSafe(s string, flow bool) bool {
+	if s == "" || strings.ContainsAny(s, "\n\r\t") {
+		return false
+	}
+	if strings.ContainsRune(plainBanFirst, rune(s[0])) {
+		return false
+	}
+	if strings.Contains(s, ": ") || strings.Contains(s, " #") || strings.HasSuffix(s, ":") || strings.HasSuffix(s, " ") {
+		return false
+	}
+	if strings.HasPrefix(s, "---") || strings.HasPrefix(s, "...") {
+		return false
+	}
+	if flow && strings.ContainsAny(s, ",[]{}:?") { // '?' inside a flow plain scalar trips libyaml and yaml.v3
+		return false
+	}
+	if twoSignsRe.MatchString(s) { // go-yaml/16
+		return false
+	}
+	for _, r := range s {
+		if r < 0x20 || r == 0x7f || r == 0x85 || r == 0x2028 || r == 0x2029 || r == 0xfeff {
+			return false
+		}
+	}
+	if strings.Contains(s, "_") && resolvesToNonString(strings.ReplaceAll(s, "_", "")) {
+		return false // YAML 1.1 underscores: goccy and yaml.v3 draw the line differently (.00_)
+	}
+	return !resolvesToNonString(s)
+}
+
+func (e *emitter) singleOK(s string) bool {
+	if strings.ContainsAny(s, "\n\r\t") {
+		return false
+	}
+	for _, r := range s {
+		if r < 0x20 || r == 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+func (e *emitter) double(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			sb.WriteString(`\"`)
+		case r == '\\':
+			sb.WriteString(`\\`)
+		case r == '\n':
+			sb.WriteString(`\n`)
+		case r == '\r':
+			sb.WriteString(`\r`)
+		case r == '\t':
+			sb.WriteString(`\t`)
+		case r < 0x20 || r == 0x7f:
+			fmt.Fprintf(&sb, `\x%02x`, r)
+		case r == ' ' && chance(e.tc, 10):
+			sb.WriteString(`\ `)
+		case r > 0x7f && chance(e.tc, 30):
+			if r < 0x10000 {
+				fmt.Fprintf(&sb, `\u%04x`, r)
+			} else {
+				fmt.Fprintf(&sb, `\U%08x`, r)
+			}
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+func (e *emitter) single(s string) string {
+	return "'" + strings.ReplaceAll(s, "'", "''") + "'"
+}
+
+// literalOK reports whether s can be written as a literal block scalar the writer knows how
+// to indent: multi-line, no CR or control characters, not whitespace only (go-yaml/11) and
+// with no line of spaces only (go-yaml/26).
+func (e *emitter) literalOK(s string) bool {
+	if !strings.Contains(s, "\n") || strings.ContainsAny(s, "\r\t") || strings.TrimSpace(s) == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < 0x20 && r != '\n' || r == 0x7f {
+			return false
+		}
+	}
+	lines := strings.Split(s, "\n")
+	for _, line := range lines {
+		if line != "" && strings.TrimSpace(line) == "" {
+			return false
+		}
+		if strings.HasSuffix(line, " ") {
+			return false // go-yaml/30
+		}
+	}
+	if strings.HasSuffix(s, "\n\n") {
+		// keep chomping: an explicit indentation indicator at the end of the stream is go-yaml/27
+		for _, line := range lines {
+			if strings.HasPrefix(line, " ") {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// literal writes s as a block literal whose content lines are indented by indent spaces
+// (the parent mapping is at parentIndent); the indentation indicator is explicit whenever
+// a content line starts with a space or is empty of content.
+func (e *emitter) literal(s string, parentIndent, indent int) string {
+	trimmed := strings.TrimRight(s, "\n")
+	trailing := len(s) - len(trimmed)
+	var chomp string
+	switch {
+	case trailing == 0:
+		chomp = "-"
+	case trailing == 1:
+		chomp = pick(e.tc, []string{"", ""})
+	default:
+		chomp = "+"
+	}
+	lines := strings.Split(trimmed, "\n")
+	// An explicit indentation indicator is never needed (literalOK excludes content whose first
+	// line starts with a space); one is written at random, except with keep chomping.
+	ind := ""
+	if chomp != "+" && chance(e.tc, 20) {
+		ind = strconv.Itoa(indent - parentIndent)
+	}
+	// goccy rejects a block with an explicit indicator, or with keep chomping, when empty
+	// lines follow it at the end of the stream (go-yaml/27): no blank lines after this one.
+	e.fragileTail = ind != "" || chomp == "+"
+	if indent-parentIndent > 9 {
+		ind = ""
+	}
+	header := "|"
+	if chance(e.tc, 50) {
+		header += ind + chomp
+	} else {
+		header += chomp + ind
+	}
+	var sb strings.Builder
+	sb.WriteString(header)
+	if chance(e.tc, 20) {
+		sb.WriteString(" # comment")
+	}
+	sb.WriteString("\n")
+	pad := strings.Repeat(" ", indent)
+	for i, l := range lines {
+		if l == "" {
+			if chance(e.tc, 50) {
+				sb.WriteString("\n")
+			} else {
+				sb.WriteString(pad + "\n")
+			}
+			continue
+		}
+		sb.WriteString(pad + l)
+		if i < len(lines)-1 || trailing > 0 {
+			sb.WriteString("\n")
+		}
+	}
+	// keep: trailing empty lines beyond the first newline
+	for i := 1; i < trailing; i++ {
+		sb.WriteString("\n")
+	}
+	if trailing == 0 {
+		sb.WriteString("\n")
+	}
+	return sb.String()
+}
+
+func (e *emitter) integer(v *val) string {
+	if v.kind == "int" && v.i < 0 {
+		s := strconv.FormatInt(v.i, 10)
+		if chance(e.tc, 20) {
+			s = e.underscores(s)
+		}
+		if chance(e.tc, 20) {
+			return "-0x" + strconv.FormatUint(uint64(-v.i), 16)
+		}
+		return s
+	}
+	var u uint64
+	if v.kind == "int" {
+		u = uint64(v.i)
+	} else {
+		u = v.u
+	}
+	switch n(e.tc, 1, 10) {
+	case 1:
+		return "0x" + strconv.FormatUint(u, 16)
+	case 2:
+		return "0x" + strings.ToUpper(strconv.FormatUint(u, 16))
+	case 3:
+		return "0o" + strconv.FormatUint(u, 8)
+	case 4:
+		return "0b" + strconv.FormatUint(u, 2)
+	case 5:
+		if u <= math.MaxInt64 { // yaml.v3 reads a larger "+" integer as a float
+			return "+" + strconv.FormatUint(u, 10)
+		}
+		return strconv.FormatUint(u, 10)
+	case 6:
+		return e.underscores(strconv.FormatUint(u, 10))
+	}
+	return strconv.FormatUint(u, 10)
+}
+
+func (e *emitter) underscores(digits string) string {
+	var sb strings.Builder
+	for i, c := range digits {
+		sb.WriteRune(c)
+		if i > 0 && i < len(digits)-1 && c >= '0' && c <= '9' && chance(e.tc, 30) {
+			sb.WriteByte('_')
+		}
+	}
+	return sb.String()
+}
+
+func (e *emitter) float(f float64) string {
+	switch {
+	case math.IsInf(f, 1):
+		return pick(e.tc, []string{".inf", ".Inf", ".INF"})
+	case math.IsInf(f, -1):
+		return pick(e.tc, []string{"-.inf", "-.Inf", "-.INF"})
+	case math.IsNaN(f):
+		return pick(e.tc, []string{".nan", ".NaN", ".NAN"})
+	}
+	var s string
+	switch n(e.tc, 1, 4) {
+	case 1:
+		s = strconv.FormatFloat(f, 'e', -1, 64)
+	case 2:
+		s = strconv.FormatFloat(f, 'E', -1, 64)
+	case 3:
+		if math.Abs(f) < 1e17 {
+			s = strconv.FormatFloat(f, 'f', -1, 64)
+		} else {
+			s = strconv.FormatFloat(f, 'g', -1, 64)
+		}
+	default:
+		s = strconv.FormatFloat(f, 'g', -1, 64)
+	}
+	// every float literal carries a dot: goccy's decoder needs one (go-yaml/1)
+	if !strings.Contains(s, ".") {
+		if i := strings.IndexAny(s, "eE"); i >= 0 {
+			s = s[:i] + ".0" + s[i:]
+		} else {
+			s += ".0"
+		}
+	}
+	if strings.HasPrefix(s, "0.") && chance(e.tc, 20) {
+		s = s[1:]
+	} else if strings.HasPrefix(s, "-0.") && chance(e.tc, 20) {
+		s = "-" + s[2:]
+	}
+	if !strings.HasPrefix(s, "-") && chance(e.tc, 15) {
+		s = "+" + s
+	}
+	return s
+}
+
+// scalar writes a scalar in a style valid for the context; block literals are only used by
+// the caller (mapping values), so this never returns one.
+func (e *emitter) scalar(v *val, flow bool) string {
+	switch v.kind {
+	case "null":
+		return pick(e.tc, []string{"null", "null", "Null", "NULL", "~"})
+	case "bool":
+		if v.b {
+			return pick(e.tc, []string{"true", "true", "True", "TRUE"})
+		}
+		return pick(e.tc, []string{"false", "false", "False", "FALSE"})
+	case "int", "uint":
+		return e.integer(v)
+	case "float":
+		return e.float(v.f)
+	case "string":
+		s := v.s
+		if e.plainSafe(s, flow) && chance(e.tc, 65) {
+			return s
+		}
+		if e.singleOK(s) && chance(e.tc, 45) {
+			return e.single(s)
+		}
+		return e.double(s)
+	}
+	panic("scalar of a collection")
+}
+
+func (e *emitter) key(k string, flow bool) string {
+	if e.plainSafe(k, flow) && chance(e.tc, 75) {
+		return k
+	}
+	if e.singleOK(k) && chance(e.tc, 40) {
+		return e.single(k)
+	}
+	return e.double(k)
+}
+
+func (e *emitter) flow(v *val) string {
+	switch v.kind {
+	case "seq":
+		if len(v.items) == 0 {
+			return "[" + e.sp() + "]"
+		}
+		parts := make([]string, len(v.items))
+		for i, it := range v.items {
+			parts[i] = e.flow(it)
+		}
+		s := "[" + e.sp() + strings.Join(parts, e.sp()+","+pick(e.tc, []string{" ", " ", "", "  "}))
+		if chance(e.tc, 15) {
+			s += e.sp() + ","
+		}
+		return s + e.sp() + "]"
+	case "map":
+		if len(v.kids) == 0 {
+			return "{" + e.sp() + "}"
+		}
+		parts := make([]string, 0, len(v.kids))
+		for _, k := range v.keys {
+			parts = append(parts, e.key(k, true)+e.sp()+": "+e.sp()+e.flow(v.kids[k]))
+		}
+		s := "{" + e.sp() + strings.Join(parts, e.sp()+","+pick(e.tc, []string{" ", " ", "", "  "}))
+		if chance(e.tc, 15) {
+			s += e.sp() + ","
+		}
+		return s + e.sp() + "}"
+	}
+	return e.scalar(v, true)
+}
+
+func (e *emitter) comment() string {
+	return pick(e.tc, []string{" # c", " #", "  # comment: with [flow] and 'quotes'", " # 日本"})
+}
+
+// blockLines writes a collection in block style, every line indented by indent spaces.
+func (e *emitter) blockLines(v *val, indent int) []string {
+	pad := strings.Repeat(" ", indent)
+	var lines []string
+	switch v.kind {
+	case "map":
+		for _, k := range v.keys {
+			kid := v.kids[k]
+			e.fragileTail = false
+			head := pad + e.key(k, false) + ":"
+			if chance(e.tc, 15) {
+				lines = append(lines, pad+"# before "+k)
+			}
+			switch {
+			case kid.kind == "null" && chance(e.tc, 30):
+				lines = append(lines, head)
+			case kid.kind == "string" && e.literalOK(kid.s) && chance(e.tc, 60):
+				step := n(e.tc, 1, 4)
+				lit := e.literal(kid.s, indent, indent+step)
+				litLines := strings.Split(strings.TrimSuffix(lit, "\n"), "\n")
+				lines = append(lines, head+" "+litLines[0])
+				lines = append(lines, litLines[1:]...)
+			case (kid.kind == "map" || kid.kind == "seq") && len(kidLen(kid)) > 0 && chance(e.tc, 75):
+				step := n(e.tc, 1, 4)
+				if kid.kind == "seq" && chance(e.tc, 35) {
+					step = 0
+				}
+				if chance(e.tc, 20) {
+					head += e.comment()
+				}
+				lines = append(lines, head)
+				lines = append(lines, e.blockLines(kid, indent+step)...)
+			case kid.kind == "map" || kid.kind == "seq":
+				lines = append(lines, head+" "+e.flow(kid)+e.maybeComment())
+			default:
+				lines = append(lines, head+" "+e.sp()+e.scalar(kid, false)+e.maybeComment())
+			}
+			// a blank line after a keep-chomped literal block would become part of its content,
+			// and goccy chokes on one after an explicit indentation indicator (go-yaml/27)
+			if chance(e.tc, 10) && !e.fragileTail {
+				lines = append(lines, "")
+			}
+		}
+	case "seq":
+		for _, it := range v.items {
+			e.fragileTail = false
+			switch {
+			case (it.kind == "map" || it.kind == "seq") && len(kidLen(it)) > 0 && chance(e.tc, 50):
+				// compact: "- k: v" / "- - a" with the rest aligned under the first entry
+				sub := e.blockLines(it, indent+2)
+				sub[0] = pad + "- " + sub[0][indent+2:]
+				lines = append(lines, sub...)
+			case (it.kind == "map" || it.kind == "seq") && len(kidLen(it)) > 0:
+				step := n(e.tc, 1, 4)
+				lines = append(lines, pad+"-")
+				lines = append(lines, e.blockLines(it, indent+step)...)
+			case it.kind == "map" || it.kind == "seq":
+				lines = append(lines, pad+"- "+e.flow(it)+e.maybeComment())
+			default:
+				lines = append(lines, pad+"- "+e.sp()+e.scalar(it, false)+e.maybeComment())
+			}
+		}
+	default:
+		lines = append(lines, pad+e.scalar(v, false))
+	}
+	return lines
+}
+
+func (e *emitter) maybeComment() string {
+	if chance(e.tc, 15) {
+		return e.comment()
+	}
+	return ""
+}
+
+func kidLen(v *val) []int {
+	if v.kind == "map" {
+		return make([]int, len(v.kids))
+	}
+	return make([]int, len(v.items))
+}
+
+func (e *emitter) document(v *val) string {
+	var sb strings.Builder
+	if chance(e.tc, 20) {
+		sb.WriteString("# leading comment\n")
+	}
+	if chance(e.tc, 15) {
+		sb.WriteString("\n")
+	}
+	marker := chance(e.tc, 30)
+	isColl := (v.kind == "map" || v.kind == "seq") && len(kidLen(v)) > 0
+	switch {
+	case isColl && chance(e.tc, 80):
+		if marker {
+			sb.WriteString("---\n")
+		}
+		indent := 0
+		if chance(e.tc, 15) {
+			indent = n(e.tc, 1, 3)
+		}
+		sb.WriteString(strings.Join(e.blockLines(v, indent), "\n"))
+		sb.WriteString("\n")
+	case v.kind == "map" || v.kind == "seq":
+		if marker {
+			sb.WriteString("--- ")
+		}
+		sb.WriteString(e.flow(v))
+		sb.WriteString("\n")
+	default:
+		if marker {
+			sb.WriteString("--- ")
+		}
+		sb.WriteString(e.scalar(v, false))
+		sb.WriteString("\n")
+	}
+	if chance(e.tc, 20) {
+		sb.WriteString("...\n")
+	}
+	if chance(e.tc, 10) {
+		sb.WriteString("# trailing comment\n")
+	}
+	return sb.String()
+}
+
+// keyOrder lists the keys of every mapping in generation order, depth first, for the
+// ordered-map check.
+func keyOrder(v *val) []string {
+	var out []string
+	switch v.kind {
+	case "map":
+		out = append(out, strings.Join(v.keys, "\x00"))
+		for _, k := range v.keys {
+			out = append(out, keyOrder(v.kids[k])...)
+		}
+	case "seq":
+		for _, it := range v.items {
+			out = append(out, keyOrder(it)...)
+		}
+	}
+	return out
+}
+
+func mapSliceOrder(x any) []string {
+	var out []string
+	switch v := x.(type) {
+	case MapSlice:
+		var ks []string
+		for _, item := range v {
+			ks = append(ks, fmt.Sprint(item.Key))
+		}
+		out = append(out, strings.Join(ks, "\x00"))
+		for _, item := range v {
+			out = append(out, mapSliceOrder(item.Value)...)
+		}
+	case []any:
+		for _, it := range v {
+			out = append(out, mapSliceOrder(it)...)
+		}
+	}
+	return out
+}
+
+func TestHegelGeneratedDocumentsDecodeToTheTreeTheyWereWrittenFrom(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, 3, strMode{}, true)
+		e := &emitter{tc: ht}
+		doc := e.document(v)
+		want := canonVal(v)
+		note(ht, "tree: %s\ndocument:\n%s", render(want), doc)
+		var ref any
+		if err := yamlv3.Unmarshal([]byte(doc), &ref); err != nil {
+			ht.Fatalf("test-suite defect: yaml.v3 rejects the generated document: %v", err)
+		}
+		if !sameCanon(canon(ref), want) {
+			ht.Fatalf("test-suite defect: yaml.v3 reads the generated document as %s", render(canon(ref)))
+		}
+		var got any
+		if err := Unmarshal([]byte(doc), &got); err != nil {
+			ht.Fatalf("goccy rejects a document yaml.v3 reads as the tree: %v", err)
+		}
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("goccy decodes differently:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+		var got2 any
+		if err := NewDecoder(strings.NewReader(doc)).Decode(&got2); err != nil {
+			ht.Fatalf("Decoder.Decode: %v", err)
+		}
+		if !sameCanon(canon(got2), want) {
+			ht.Fatalf("Decoder.Decode differs:\n want %s\n got  %s", render(want), render(canon(got2)))
+		}
+		// UseOrderedMap keeps the document's key order at every level.
+		var ordered any
+		if err := UnmarshalWithOptions([]byte(doc), &ordered, UseOrderedMap()); err != nil {
+			ht.Fatalf("Unmarshal with UseOrderedMap: %v", err)
+		}
+		if !sameCanon(canon(ordered), want) {
+			ht.Fatalf("UseOrderedMap changes the value:\n want %s\n got  %s", render(want), render(canon(ordered)))
+		}
+		if wantOrder, gotOrder := keyOrder(v), mapSliceOrder(ordered); !reflect.DeepEqual(wantOrder, gotOrder) {
+			ht.Fatalf("UseOrderedMap key order:\n want %q\n got  %q", wantOrder, gotOrder)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Numeric literals into typed fields.
+
+type numbers struct {
+	I   int     `yaml:"n"`
+	I8  int8    `yaml:"n"`
+	I16 int16   `yaml:"n"`
+	I32 int32   `yaml:"n"`
+	I64 int64   `yaml:"n"`
+	U   uint    `yaml:"n"`
+	U8  uint8   `yaml:"n"`
+	U16 uint16  `yaml:"n"`
+	U32 uint32  `yaml:"n"`
+	U64 uint64  `yaml:"n"`
+	F32 float32 `yaml:"n"`
+	F64 float64 `yaml:"n"`
+	Any any     `yaml:"n"`
+}
+
+func intFits(neg bool, mag uint64, bits int, unsigned bool) bool {
+	if unsigned {
+		return !neg && (bits == 64 || mag < 1<<uint(bits))
+	}
+	if neg {
+		return mag <= 1<<uint(bits-1)
+	}
+	return mag < 1<<uint(bits-1)
+}
+
+func decodeField(doc string, field string) (reflect.Value, error) {
+	var target numbers
+	rv := reflect.ValueOf(&target).Elem()
+	// decode into a one-field struct of the same type to isolate the field
+	f, _ := reflect.TypeOf(target).FieldByName(field)
+	st := reflect.StructOf([]reflect.StructField{{Name: "N", Type: f.Type, Tag: `yaml:"n"`}})
+	ptr := reflect.New(st)
+	err := Unmarshal([]byte(doc), ptr.Interface())
+	_ = rv
+	return ptr.Elem().Field(0), err
+}
+
+func TestHegelIntegerLiteralsDecodeIntoNumericFieldsExactlyWhenTheyFit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// magnitude and sign, spelled in one of YAML 1.2's integer forms
+		var mag uint64
+		switch n(ht, 1, 4) {
+		case 1:
+			mag = uint64(n(ht, 0, 300))
+		case 2:
+			mag = uint64(n(ht, 0, 70000))
+		case 3:
+			mag = uint64(hegel.Draw(ht, hegel.Integers[int64](0, math.MaxInt64)))
+		default:
+			mag = uint64(hegel.Draw(ht, hegel.Integers[int64](0, math.MaxInt64)))
+			if chance(ht, 50) {
+				mag += uint64(math.MaxInt64) + 1
+			}
+		}
+		neg := chance(ht, 35) && mag <= 1<<63 && mag > 0
+		e := &emitter{tc: ht}
+		var lit string
+		if neg {
+			lit = e.integer(&val{kind: "int", i: -int64(mag-1) - 1})
+		} else {
+			lit = e.integer(&val{kind: "uint", u: mag})
+		}
+		doc := "n: " + lit
+		note(ht, "document: %s (neg=%v mag=%d)", doc, neg, mag)
+		type tf struct {
+			name     string
+			bits     int
+			unsigned bool
+		}
+		for _, f := range []tf{{"I", 64, false}, {"I8", 8, false}, {"I16", 16, false}, {"I32", 32, false}, {"I64", 64, false}, {"U", 64, true}, {"U8", 8, true}, {"U16", 16, true}, {"U32", 32, true}, {"U64", 64, true}} {
+			got, err := decodeField(doc, f.name)
+			fits := intFits(neg, mag, f.bits, f.unsigned)
+			if fits && err != nil {
+				ht.Fatalf("%s fits into %s but: %v", lit, f.name, err)
+			}
+			if !fits {
+				if err == nil {
+					ht.Fatalf("%s does not fit into %s but decoded as %v", lit, f.name, got)
+				}
+				continue
+			}
+			var gotText string
+			if f.unsigned {
+				gotText = strconv.FormatUint(got.Uint(), 10)
+			} else {
+				gotText = strconv.FormatInt(got.Int(), 10)
+			}
+			wantText := strconv.FormatUint(mag, 10)
+			if neg && mag != 0 {
+				wantText = "-" + wantText
+			}
+			if gotText != wantText {
+				ht.Fatalf("%s into %s: want %s got %s", lit, f.name, wantText, gotText)
+			}
+		}
+		// float fields take the value exactly as float64(x) would
+		want := float64(mag)
+		if neg {
+			want = -want
+		}
+		got, err := decodeField(doc, "F64")
+		if err != nil || got.Float() != want {
+			ht.Fatalf("%s into float64: want %v got %v (%v)", lit, want, got, err)
+		}
+		got, err = decodeField(doc, "F32")
+		if err != nil || got.Float() != float64(float32(want)) {
+			ht.Fatalf("%s into float32: want %v got %v (%v)", lit, float32(want), got, err)
+		}
+		// interface{} gets an integer of the right value
+		got, err = decodeField(doc, "Any")
+		if err != nil {
+			ht.Fatalf("%s into interface{}: %v", lit, err)
+		}
+		wantText := strconv.FormatUint(mag, 10)
+		if neg && mag != 0 {
+			wantText = "-" + wantText
+		}
+		if c := canon(got.Interface()); c != "i:"+wantText {
+			ht.Fatalf("%s into interface{}: want i:%s got %v", lit, wantText, c)
+		}
+	})
+}
+
+func TestHegelFloatLiteralsDecodeIntoFloatFieldsExactly(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genFloat(ht, true)
+		e := &emitter{tc: ht}
+		lit := e.float(f)
+		doc := "n: " + lit
+		note(ht, "document: %s (float %v)", doc, f)
+		want, err := strconv.ParseFloat(strings.TrimPrefix(strings.ReplaceAll(lit, "_", ""), "+"), 64)
+		if math.IsNaN(f) {
+			want = math.NaN()
+		} else if math.IsInf(f, 0) {
+			want = f
+		} else if err != nil {
+			ht.Fatalf("test-suite defect: %q is not a Go float literal: %v", lit, err)
+		}
+		got, err := decodeField(doc, "F64")
+		if err != nil {
+			ht.Fatalf("%s into float64: %v", lit, err)
+		}
+		if g := got.Float(); g != want && !(math.IsNaN(g) && math.IsNaN(want)) {
+			ht.Fatalf("%s into float64: want %v got %v", lit, want, g)
+		}
+		got, err = decodeField(doc, "F32")
+		if err != nil {
+			ht.Fatalf("%s into float32: %v", lit, err)
+		}
+		if g, w := got.Float(), float64(float32(want)); g != w && !(math.IsNaN(g) && math.IsNaN(w)) {
+			ht.Fatalf("%s into float32: want %v got %v", lit, w, g)
+		}
+		got, err = decodeField(doc, "Any")
+		if err != nil {
+			ht.Fatalf("%s into interface{}: %v", lit, err)
+		}
+		if c := canon(got.Interface()); c != "f:"+canonFloat(want) {
+			ht.Fatalf("%s into interface{}: want f:%s got %v", lit, canonFloat(want), c)
+		}
+	})
+}
