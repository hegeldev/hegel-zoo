+package yaml_test
+
+// Hegel properties for github.com/goccy/go-yaml (the Hegel zoo, targets/go/go-yaml).
+//
+// Oracles: go.yaml.in/yaml/v3 (the maintained yaml.v3, an independent YAML implementation in
+// the same process) and PyYAML with libyaml (a child process) read everything goccy's encoder
+// writes; a value model of our own is written as YAML by a randomised writer of ours so that
+// goccy's decoder can be checked against the tree a document was written from (yaml.v3
+// arbitrates every generated document first); goccy against itself for map, struct and
+// JSON round trips under its encoder options.  Generated text stays inside YAML 1.2 as both
+// yaml.v3 and libyaml read it: no YAML 1.1 line breaks (U+0085, U+2028, U+2029), no tabs
+// (pinned), no control characters (pinned), no byte order marks.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+
+	. "github.com/goccy/go-yaml"
+	yamlv3 "go.yaml.in/yaml/v3"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	return int(hegel.Draw(tc, hegel.Integers[int64](int64(lo), int64(hi))))
+}
+func chance(tc hegel.TestCase, pct int) bool  { return n(tc, 1, 100) <= pct }
+func pick[T any](tc hegel.TestCase, xs []T) T { return xs[n(tc, 0, len(xs)-1)] }
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// ---------------------------------------------------------------------------------------
+// The value model: a YAML document as a tree, independent of every implementation.
+
+type val struct {
+	kind  string // null bool int uint float string seq map
+	b     bool
+	i     int64
+	u     uint64
+	f     float64
+	s     string
+	items []*val
+	kids  map[string]*val
+	keys  []string // generation order of kids
+}
+
+// Generation modes for strings.
+type strMode struct {
+	noNewline bool // single-line strings only (flow style, single quotes, keys)
+	noFlowInd bool // no '[', '{' (goccy leaves them bare in flow style: pinned) or '?' (yaml.v3 quirk)
+	printable bool // printable runes only (single quotes and JSON style escape the rest wrongly: pinned)
+}
+
+var asciiPieces = []string{"a", "b", "z", "A", "Z", "0", "7", "_", "-", ".", " ", "  ", "'", "''", "\"", "\\", "#", "=", "[", "]", "{", "}", ",", "/", ":", ": ", "+", "?", "!", "&", "*", "|", ">", "%", "@", "`", "~", "<<", "- ", "e", "x", "o", "n", "t", "y", "null", "true", "yes", "1e3", "0x", "1_0", ".inf", "---", "..."}
+var unicodePieces = []string{"é", "ß", "日本", "😀", "\U0010ffff", "Ω", "\u00a0", "ø"}
+var newlinePieces = []string{"\n", "\n\n", "\n "}
+
+func genString(tc hegel.TestCase, m strMode) string {
+	k := n(tc, 0, 7)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 10) {
+		case 1, 2:
+			sb.WriteString(pick(tc, unicodePieces))
+		case 3:
+			if !m.noNewline {
+				sb.WriteString(pick(tc, newlinePieces))
+			}
+		default:
+			sb.WriteString(pick(tc, asciiPieces))
+		}
+	}
+	s := sb.String()
+	if m.noFlowInd {
+		// '?' is not a flow indicator, but yaml.v3 rejects it inside flow plain scalars
+		// (libyaml accepts them): an oracle avoidance, see README
+		s = strings.NewReplacer("[", "(", "{", "(", "?", "(").Replace(s)
+	}
+	if m.printable {
+		s = strings.Map(func(r rune) rune {
+			if r == '\n' || r == ' ' || unicode.IsPrint(r) {
+				return r
+			}
+			return 'p'
+		}, s)
+	}
+	if avoidString(s) {
+		// a harmless variant of the same pieces
+		s = "x" + strings.TrimLeft(strings.NewReplacer("\n", " ", "<<", "<").Replace(s), "-.?")
+	}
+	return s
+}
+
+var (
+	infNanRe   = regexp.MustCompile(`^[-+]?\.(inf|Inf|INF|nan|NaN|NAN)$`)
+	twoSignsRe = regexp.MustCompile(`^[-+][-+]`)
+)
+
+// avoidString reports whether s has one of the pinned shapes the general encoder properties
+// must not exercise (each is a bug of its own, see bugs.toml): a string that goccy's encoder
+// leaves bare although a YAML reader resolves it to another type, or that goccy itself
+// cannot write readably.
+func avoidString(s string) bool {
+	if infNanRe.MatchString(s) || twoSignsRe.MatchString(s) {
+		return true // go-yaml/4, go-yaml/16
+	}
+	if strings.HasPrefix(s, "?") || strings.HasPrefix(s, "---") || strings.HasPrefix(s, "...") || strings.HasSuffix(s, "<<") {
+		return true // go-yaml/5, /6, /7, /24
+	}
+	if strings.Contains(s, "\n") {
+		if strings.TrimSpace(s) == "" {
+			return true // go-yaml/11
+		}
+		for i, line := range strings.Split(s, "\n") {
+			if line != "" && strings.TrimSpace(line) == "" {
+				return true // go-yaml/26: a line of spaces only inside a literal block
+			}
+			if strings.HasSuffix(line, " ") {
+				return true // go-yaml/30: trailing spaces on a literal block's lines
+			}
+			if strings.HasPrefix(line, " ") && strings.TrimSpace(strings.Join(strings.Split(s, "\n")[:i], "")) == "" {
+				return true // go-yaml/28: the first content line of a literal block starts with a space
+			}
+		}
+	}
+	if strings.Contains(s, "\n") && strings.Contains(s, "\r") {
+		return true
+	}
+	if s != "" && resolvesToNonString(s) {
+		return true // go-yaml/1 (1e3, 08) and the like: only yaml.v3 reads it as a number
+	}
+	return false
+}
+
+// resolvesToNonString reports whether yaml.v3 reads the bare scalar s as something other
+// than a string (an integer, float, bool, null or timestamp).
+func resolvesToNonString(s string) bool {
+	if strings.ContainsAny(s, "\n#:") {
+		return false
+	}
+	var v any
+	if err := yamlv3.Unmarshal([]byte(s), &v); err != nil {
+		return false
+	}
+	_, isStr := v.(string)
+	return !isStr
+}
+
+// hasYAML11Only reports whether the tree holds a string PyYAML (YAML 1.1) resolves to a
+// non-string or rejects (sexagesimals, timestamps, `=`, `<<`, y/n/yes/no/on/off).
+func hasYAML11Only(v *val) bool {
+	switch v.kind {
+	case "string":
+		return yaml11Only(v.s)
+	case "seq":
+		for _, it := range v.items {
+			if hasYAML11Only(it) {
+				return true
+			}
+		}
+	case "map":
+		for k, kid := range v.kids {
+			if yaml11Only(k) || hasYAML11Only(kid) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// genKey draws a map key; only the noFlowInd part of m matters (keys are single-line and
+// printable regardless).
+func genKey(tc hegel.TestCase, m strMode) string {
+	if chance(tc, 60) {
+		const alphabet = "abcXYZ019_-."
+		k := n(tc, 1, 6)
+		b := make([]byte, k)
+		for i := range b {
+			b[i] = alphabet[n(tc, 0, len(alphabet)-1)]
+		}
+		if avoidString(string(b)) || resolvesToNonString(string(b)) {
+			return "k" + string(b)
+		}
+		return string(b)
+	}
+	return genString(tc, strMode{noNewline: true, printable: true, noFlowInd: m.noFlowInd})
+}
+
+func genInt64(tc hegel.TestCase) int64 {
+	switch n(tc, 1, 6) {
+	case 1:
+		return int64(n(tc, -10, 10))
+	case 2:
+		return int64(n(tc, -300, 300))
+	case 3:
+		return int64(n(tc, -70000, 70000))
+	case 4:
+		return int64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt32-5, math.MaxInt32+5)))
+	default:
+		return int64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64)))
+	}
+}
+
+var floatPool = []float64{0, 0.5, -0.5, 1, -1, 1.5, 100, 1e15, 123456.789, 0.1, 0.2, 0.3, 1e-3, 3.14159, -2.5e10, 1.5e300, 2.5e-300, math.MaxFloat64, math.SmallestNonzeroFloat64, 4.9e-324, 0.000123}
+
+// genFloat returns a finite or non-finite float whose shortest representation is one goccy's
+// decoder reads back as a float (a fraction or exponent with a dot); see go-yaml/1.
+func genFloat(tc hegel.TestCase, allowNonFinite bool) float64 {
+	var f float64
+	switch n(tc, 1, 10) {
+	case 1, 2, 3:
+		f = pick(tc, floatPool)
+	case 4:
+		if allowNonFinite {
+			f = pick(tc, []float64{math.Inf(1), math.Inf(-1), math.NaN()})
+		} else {
+			f = 2.5
+		}
+	case 5:
+		f = float64(n(tc, -1000, 1000)) / 8
+	default:
+		f = math.Float64frombits(uint64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64))))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			f = 0.75
+		}
+	}
+	if avoidFloat(f) {
+		return f/3 + 0.5
+	}
+	return f
+}
+
+// avoidFloat reports whether goccy writes f without a fraction dot (1e+21, 1e-07): its own
+// decoder reads those back as strings (go-yaml/1).
+func avoidFloat(f float64) bool {
+	if math.IsNaN(f) || math.IsInf(f, 0) {
+		return false
+	}
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	return strings.ContainsAny(s, "eE") && !strings.Contains(s, ".")
+}
+
+func genScalar(tc hegel.TestCase, m strMode, allowNonFinite bool) *val {
+	switch n(tc, 1, 10) {
+	case 1:
+		return &val{kind: "null"}
+	case 2:
+		return &val{kind: "bool", b: chance(tc, 50)}
+	case 3, 4:
+		return &val{kind: "int", i: genInt64(tc)}
+	case 5:
+		if chance(tc, 30) {
+			return &val{kind: "uint", u: uint64(hegel.Draw(tc, hegel.Integers[int64](0, math.MaxInt64))) + uint64(math.MaxInt64) + 1}
+		}
+		return &val{kind: "uint", u: uint64(n(tc, 0, 1000))}
+	case 6, 7:
+		return &val{kind: "float", f: genFloat(tc, allowNonFinite)}
+	default:
+		return &val{kind: "string", s: genString(tc, m)}
+	}
+}
+
+func genVal(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	if depth > 0 && chance(tc, 35) {
+		if chance(tc, 50) {
+			return genSeq(tc, depth, m, allowNonFinite)
+		}
+		return genMap(tc, depth, m, allowNonFinite)
+	}
+	return genScalar(tc, m, allowNonFinite)
+}
+
+func genSeq(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	v := &val{kind: "seq", items: []*val{}}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		v.items = append(v.items, genVal(tc, depth-1, m, allowNonFinite))
+	}
+	return v
+}
+
+func genMap(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	v := &val{kind: "map", kids: map[string]*val{}}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		key := genKey(tc, m)
+		if _, dup := v.kids[key]; dup {
+			continue
+		}
+		v.kids[key] = genVal(tc, depth-1, m, allowNonFinite)
+		v.keys = append(v.keys, key)
+	}
+	return v
+}
+
+// toGo converts the model to the Go values handed to goccy's encoder; integers are spread
+// over the sized Go integer types.
+func toGo(tc hegel.TestCase, v *val) any {
+	switch v.kind {
+	case "null":
+		return nil
+	case "bool":
+		return v.b
+	case "int":
+		i := v.i
+		switch {
+		case i >= math.MinInt8 && i <= math.MaxInt8 && chance(tc, 30):
+			return int8(i)
+		case i >= math.MinInt16 && i <= math.MaxInt16 && chance(tc, 30):
+			return int16(i)
+		case i >= math.MinInt32 && i <= math.MaxInt32 && chance(tc, 30):
+			return int32(i)
+		case chance(tc, 50):
+			return int(i)
+		}
+		return i
+	case "uint":
+		u := v.u
+		switch {
+		case u <= math.MaxUint8 && chance(tc, 30):
+			return uint8(u)
+		case u <= math.MaxUint16 && chance(tc, 30):
+			return uint16(u)
+		case u <= math.MaxUint32 && chance(tc, 30):
+			return uint32(u)
+		case chance(tc, 50):
+			return uint(u)
+		}
+		return u
+	case "float":
+		return v.f
+	case "string":
+		return v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, toGo(tc, it))
+		}
+		if chance(tc, 20) && len(out) > 0 {
+			// a typed slice when all items share a kind
+			allStr := true
+			for _, it := range v.items {
+				if it.kind != "string" {
+					allStr = false
+				}
+			}
+			if allStr {
+				ss := make([]string, len(out))
+				for i, x := range out {
+					ss[i] = x.(string)
+				}
+				return ss
+			}
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = toGo(tc, kid)
+		}
+		return out
+	}
+	panic("bad kind " + v.kind)
+}
+
+// ---------------------------------------------------------------------------------------
+// Canonical forms, so that trees from goccy, yaml.v3, encoding/json and the model compare.
+
+func canonFloat(f float64) string {
+	if math.IsNaN(f) {
+		return "NaN"
+	}
+	return strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+func canonVal(v *val) any {
+	switch v.kind {
+	case "null":
+		return "null"
+	case "bool":
+		return "b:" + strconv.FormatBool(v.b)
+	case "int":
+		return "i:" + strconv.FormatInt(v.i, 10)
+	case "uint":
+		return "i:" + strconv.FormatUint(v.u, 10)
+	case "float":
+		return "f:" + canonFloat(v.f)
+	case "string":
+		return "s:" + v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, canonVal(it))
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = canonVal(kid)
+		}
+		return out
+	}
+	panic("bad kind")
+}
+
+// canon canonicalises a decoded Go value (from goccy, yaml.v3 or encoding/json with
+// UseNumber).  Integers of every width compare equal; floats compare by shortest form.
+func canon(x any) any {
+	switch v := x.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "b:" + strconv.FormatBool(v)
+	case string:
+		return "s:" + v
+	case float64:
+		return "f:" + canonFloat(v)
+	case float32:
+		return "f:" + canonFloat(float64(v))
+	case json.Number:
+		if strings.ContainsAny(string(v), ".eE") {
+			f, _ := v.Float64()
+			return "f:" + canonFloat(f)
+		}
+		if v == "-0" {
+			return "i:0"
+		}
+		return "i:" + string(v)
+	case []any:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = canon(it)
+		}
+		return out
+	case []string:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = "s:" + it
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[k] = canon(it)
+		}
+		return out
+	case map[any]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[fmt.Sprint(k)] = canon(it)
+		}
+		return out
+	case MapSlice:
+		out := make(map[string]any, len(v))
+		for _, item := range v {
+			out[fmt.Sprint(item.Key)] = canon(item.Value)
+		}
+		return out
+	}
+	rv := reflect.ValueOf(x)
+	switch rv.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return "i:" + strconv.FormatInt(rv.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return "i:" + strconv.FormatUint(rv.Uint(), 10)
+	}
+	return fmt.Sprintf("?:%T(%v)", x, x)
+}
+
+func render(x any) string {
+	b, _ := json.Marshal(x)
+	return string(b)
+}
+
+func sameCanon(a, b any) bool { return reflect.DeepEqual(a, b) }
+
+// ---------------------------------------------------------------------------------------
+// PyYAML (libyaml) as a child process: tagged trees over JSON lines.
+
+const pyyamlScript = `
+import sys, json, yaml
+def node(v):
+    if isinstance(v, bool):
+        return {"t": "bool", "s": "true" if v else "false"}
+    if v is None:
+        return {"t": "null"}
+    if isinstance(v, str):
+        return {"t": "str", "s": v}
+    if isinstance(v, (int, float)):
+        return {"t": "num", "s": repr(v)}
+    if isinstance(v, dict):
+        return {"t": "map", "kids": {(k if isinstance(k, str) else "<" + type(k).__name__ + ">" + str(k)): node(x) for k, x in v.items()}}
+    if isinstance(v, list):
+        return {"t": "seq", "items": [node(x) for x in v]}
+    return {"t": "other", "s": type(v).__name__ + ":" + str(v)}
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        v = yaml.load(req["doc"], Loader=yaml.CSafeLoader)
+        out = {"ok": True, "tree": node(v)}
+    except Exception as e:
+        out = {"ok": False, "err": type(e).__name__ + ": " + str(e)[:300]}
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+type pyNode struct {
+	T     string             `json:"t"`
+	S     string             `json:"s"`
+	Kids  map[string]*pyNode `json:"kids"`
+	Items []*pyNode          `json:"items"`
+}
+
+var (
+	pyOnce  sync.Once
+	pyMu    sync.Mutex
+	pyIn    *bufio.Writer
+	pyOut   *bufio.Reader
+	pyError error
+)
+
+func startPython() {
+	cmd := exec.Command("python3", "-c", pyyamlScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		pyError = err
+		return
+	}
+	pyIn, pyOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+func pyyaml(t testing.TB, doc string) (*pyNode, string) {
+	pyOnce.Do(startPython)
+	if pyError != nil {
+		t.Fatalf("cannot start python3: %v", pyError)
+	}
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"doc": doc})
+	pyIn.Write(req)
+	pyIn.WriteByte('\n')
+	if err := pyIn.Flush(); err != nil {
+		t.Fatalf("writing to python: %v", err)
+	}
+	line, err := pyOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python: %v", err)
+	}
+	var resp struct {
+		OK   bool    `json:"ok"`
+		Tree *pyNode `json:"tree"`
+		Err  string  `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad python response %q: %v", line, err)
+	}
+	if !resp.OK {
+		return nil, resp.Err
+	}
+	return resp.Tree, ""
+}
+
+var (
+	sexagesimalRe = regexp.MustCompile(`^[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+(\.[0-9_]*)?$`)
+	timestampRe   = regexp.MustCompile(`^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}([Tt ].*)?$`)
+	yaml11BoolRe  = regexp.MustCompile(`^(y|Y|yes|Yes|YES|n|N|no|No|NO|on|On|ON|off|Off|OFF)$`)
+)
+
+// yaml11Only reports whether PyYAML (a YAML 1.1 reader) resolves the bare string s to a
+// non-string where YAML 1.2 (goccy, yaml.v3) has a string: not goccy's concern.
+func yaml11Only(s string) bool {
+	return sexagesimalRe.MatchString(s) || timestampRe.MatchString(s) || yaml11BoolRe.MatchString(s) || s == "=" || s == "<<"
+}
+
+// pyMatch checks PyYAML's tree against the model: strings and structure exactly, numbers by
+// value, booleans and nulls exactly.  Returns "" or a description of the first difference.
+func pyMatch(path string, v *val, p *pyNode) string {
+	if p == nil {
+		return path + ": missing"
+	}
+	switch v.kind {
+	case "null":
+		if p.T != "null" {
+			return fmt.Sprintf("%s: want null, PyYAML has %s %q", path, p.T, p.S)
+		}
+	case "bool":
+		if p.T != "bool" || p.S != strconv.FormatBool(v.b) {
+			return fmt.Sprintf("%s: want bool %v, PyYAML has %s %q", path, v.b, p.T, p.S)
+		}
+	case "int", "uint", "float":
+		if p.T != "num" {
+			return fmt.Sprintf("%s: want a number, PyYAML has %s %q", path, p.T, p.S)
+		}
+		want := v.f
+		if v.kind == "int" {
+			want = float64(v.i)
+		} else if v.kind == "uint" {
+			want = float64(v.u)
+		}
+		got, err := strconv.ParseFloat(p.S, 64)
+		if err != nil || (got != want && !(math.IsNaN(got) && math.IsNaN(want))) {
+			return fmt.Sprintf("%s: want %v, PyYAML has %q", path, want, p.S)
+		}
+	case "string":
+		if yaml11Only(v.s) {
+			return ""
+		}
+		if p.T != "str" || p.S != v.s {
+			return fmt.Sprintf("%s: want string %q, PyYAML has %s %q", path, v.s, p.T, p.S)
+		}
+	case "seq":
+		if p.T != "seq" || len(p.Items) != len(v.items) {
+			return fmt.Sprintf("%s: want a sequence of %d, PyYAML has %s of %d", path, len(v.items), p.T, len(p.Items))
+		}
+		for i, it := range v.items {
+			if d := pyMatch(fmt.Sprintf("%s[%d]", path, i), it, p.Items[i]); d != "" {
+				return d
+			}
+		}
+	case "map":
+		if p.T != "map" || len(p.Kids) != len(v.kids) {
+			return fmt.Sprintf("%s: want a mapping of %d, PyYAML has %s of %d", path, len(v.kids), p.T, len(p.Kids))
+		}
+		for k, kid := range v.kids {
+			if yaml11Only(k) {
+				continue
+			}
+			pk, ok := p.Kids[k]
+			if !ok {
+				return fmt.Sprintf("%s: key %q missing in PyYAML's mapping (keys %v)", path, k, pyKeys(p))
+			}
+			if d := pyMatch(path+"."+k, kid, pk); d != "" {
+				return d
+			}
+		}
+	}
+	return ""
+}
+
+func pyKeys(p *pyNode) []string {
+	var ks []string
+	for k := range p.Kids {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// ---------------------------------------------------------------------------------------
+// Encoder options.
+
+type encOpts struct {
+	flow, indentSeq, singleQuote, literal bool
+	indent                                int
+}
+
+func genEncOpts(tc hegel.TestCase) encOpts {
+	return encOpts{
+		flow:        chance(tc, 25),
+		indentSeq:   chance(tc, 30),
+		singleQuote: chance(tc, 25),
+		literal:     chance(tc, 30),
+		indent:      pick(tc, []int{2, 2, 2, 3, 4, 6}), // Indent(1) is go-yaml/29
+	}
+}
+
+func (o encOpts) list() []EncodeOption {
+	opts := []EncodeOption{Indent(o.indent), IndentSequence(o.indentSeq)}
+	if o.flow {
+		opts = append(opts, Flow(true))
+	}
+	if o.singleQuote {
+		opts = append(opts, UseSingleQuote(true))
+	}
+	if o.literal {
+		opts = append(opts, UseLiteralStyleIfMultiline(true))
+	}
+	return opts
+}
+
+// strModeFor gives the string restrictions the general properties apply under the options:
+// no multi-line strings in flow style (go-yaml/10) or with single quotes (go-yaml/13), no
+// flow indicators inside strings in flow style (go-yaml/23).
+func strModeFor(o encOpts) strMode {
+	return strMode{noNewline: o.flow || o.singleQuote, noFlowInd: o.flow, printable: o.singleQuote}
+}
+
+func (o encOpts) String() string {
+	return fmt.Sprintf("flow=%v indentSeq=%v singleQuote=%v literal=%v indent=%d", o.flow, o.indentSeq, o.singleQuote, o.literal, o.indent)
+}
+
+// ---------------------------------------------------------------------------------------
+// General properties: the encoder.
+
+func TestHegelMarshalThenUnmarshalIntoAnInterfaceIsTheIdentity(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genEncOpts(ht)
+		v := genVal(ht, 3, strModeFor(o), true)
+		in := toGo(ht, v)
+		doc, err := MarshalWithOptions(in, o.list()...)
+		if err != nil {
+			ht.Fatalf("Marshal(%s) with %s: %v", render(in), o, err)
+		}
+		note(ht, "options: %s\nvalue: %s\ndocument:\n%s", o, render(in), doc)
+		var got any
+		if err := Unmarshal(doc, &got); err != nil {
+			ht.Fatalf("Unmarshal of goccy's own output: %v", err)
+		}
+		want := canonVal(v)
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("round trip changed the value:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+		// The streaming decoder and the node API agree with Unmarshal.
+		var got2 any
+		if err := NewDecoder(bytes.NewReader(doc)).Decode(&got2); err != nil {
+			ht.Fatalf("Decoder.Decode: %v", err)
+		}
+		if !sameCanon(canon(got2), want) {
+			ht.Fatalf("Decoder.Decode differs from Unmarshal:\n want %s\n got  %s", render(want), render(canon(got2)))
+		}
+		// UseOrderedMap keeps the order goccy wrote: map keys sorted by their text.
+		if v.kind == "map" {
+			var ms MapSlice
+			if err := UnmarshalWithOptions(doc, &ms, UseOrderedMap()); err != nil {
+				ht.Fatalf("Unmarshal with UseOrderedMap: %v", err)
+			}
+			var order []string
+			for _, item := range ms {
+				order = append(order, fmt.Sprint(item.Key))
+			}
+			want := append([]string(nil), v.keys...)
+			sort.Strings(want)
+			if len(order) == 0 && len(want) == 0 {
+				return
+			}
+			if !reflect.DeepEqual(order, want) {
+				ht.Fatalf("UseOrderedMap order %q, goccy writes keys sorted: %q", order, want)
+			}
+		}
+	})
+}
+
+func TestHegelMarshalOutputIsReadBackByYamlV3AsTheInput(t *testing.T) {
