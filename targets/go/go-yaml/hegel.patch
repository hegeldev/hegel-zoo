+type strictTarget struct {
+	Alpha int            `yaml:"alpha"`
+	Beta  string         `yaml:"beta"`
+	Gamma map[string]int `yaml:"gamma"`
+}
+
+func TestHegelStrictModeFailsExactlyWhenUnknownKeysArePresent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := map[string]any{}
+		if chance(ht, 70) {
+			m["alpha"] = n(ht, -9, 9)
+		}
+		if chance(ht, 70) {
+			m["beta"] = genString(ht, strMode{noNewline: true})
+		}
+		if chance(ht, 50) {
+			m["gamma"] = map[string]int{"x": 1}
+		}
+		unknown := 0
+		for i := n(ht, 0, 2); i > 0; i-- {
+			k := genKey(ht, strMode{})
+			if k == "alpha" || k == "beta" || k == "gamma" {
+				continue
+			}
+			if _, dup := m[k]; dup {
+				continue
+			}
+			m[k] = n(ht, 0, 9)
+			unknown++
+		}
+		doc, err := Marshal(m)
+		if err != nil {
+			ht.Fatalf("Marshal: %v", err)
+		}
+		note(ht, "document:\n%s(unknown keys: %d)", doc, unknown)
+		var lenient strictTarget
+		if err := Unmarshal(doc, &lenient); err != nil {
+			ht.Fatalf("lenient decode failed: %v", err)
+		}
+		var strict strictTarget
+		err = UnmarshalWithOptions(doc, &strict, DisallowUnknownField())
+		if (err != nil) != (unknown > 0) {
+			ht.Fatalf("DisallowUnknownField: %d unknown keys, error %v", unknown, err)
+		}
+		if err == nil && !reflect.DeepEqual(lenient, strict) {
+			ht.Fatalf("strict and lenient decodes differ: %+v vs %+v", strict, lenient)
+		}
+	})
+}
