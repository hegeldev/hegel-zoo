+		}
+		var got map[string]any
+		if err := NodeToValue(node, &got); err != nil {
+			t.Errorf("NodeToValue(ValueToNode(%#v)): %v", in, err)
+			continue
+		}
+		if !reflect.DeepEqual(got, in) {
+			t.Errorf("NodeToValue(ValueToNode(%#v)) = %#v (node text %q)", in, got, node.String())
+		}
+	}
