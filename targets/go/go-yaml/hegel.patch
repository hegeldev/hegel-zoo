+	Nest  map[string][]any  `yaml:"nest"`
+	Deep  map[string]*inner `yaml:"deep"`
+	priv  int
+}
+
+func genTime(tc hegel.TestCase) time.Time {
+	sec := int64(hegel.Draw(tc, hegel.Integers[int64](-62135596800+86400, 253402300799-86400))) // years 1..9999 in every zone
+	nanos := 0
+	if chance(tc, 50) {
+		nanos = n(tc, 0, 999999999)
+	}
+	off := n(tc, -23, 23)*3600 + pick(tc, []int{0, 0, 1800, 2700, 900})*(1-2*n(tc, 0, 1))
+	if chance(tc, 30) {
+		off = 0
+	}
+	loc := time.FixedZone("", off)
+	if off == 0 && chance(tc, 50) {
+		loc = time.UTC
+	}
+	return time.Unix(sec, int64(nanos)).In(loc)
+}
+
+func genFloat32(tc hegel.TestCase) float32 {
+	for i := 0; i < 20; i++ {
+		f := float32(genFloat(tc, false))
+		if math.IsInf(float64(f), 0) {
+			continue
+		}
+		s := strconv.FormatFloat(float64(f), 'g', -1, 32)
+		if strings.ContainsAny(s, "eE") && !strings.Contains(s, ".") {
+			continue // go-yaml/1
+		}
+		return f
+	}
+	return 1.5
+}
+
+func genInner(tc hegel.TestCase) inner {
+	return inner{A: n(tc, -100, 100), B: genString(tc, strMode{noNewline: true})}
+}
+
+func genRich(tc hegel.TestCase) *rich {
+	m := strMode{}
+	r := &rich{
+		I: int(genInt64(tc)), I8: int8(n(tc, -128, 127)), I16: int16(n(tc, -32768, 32767)), I32: int32(genInt64(tc)), I64: genInt64(tc),
+		U: uint(genInt64(tc)), U8: uint8(n(tc, 0, 255)), U16: uint16(n(tc, 0, 65535)), U32: uint32(genInt64(tc)), U64: uint64(genInt64(tc)),
+		F32: genFloat32(tc), F64: genFloat(tc, true), S: genString(tc, m), B: chance(tc, 50),
+		Ren: genString(tc, m), Omit: pick(tc, []int{0, 0, 1, -5}), Skip: n(tc, 1, 9),
+		D: time.Duration(genInt64(tc)), Temp: Celsius(float64(n(tc, -5000, 5000)) / 100), priv: 7,
+	}
+	if chance(tc, 60) {
+		s := genString(tc, m)
+		r.PS = &s
+	}
+	if chance(tc, 60) {
+		i := n(tc, -5, 5)
+		r.PI = &i
+	}
+	if chance(tc, 60) {
+		in := genInner(tc)
+		r.PIn = &in
+	}
+	if chance(tc, 70) {
+		r.Sl = []int{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			r.Sl = append(r.Sl, n(tc, -1000, 1000))
