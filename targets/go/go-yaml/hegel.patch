+func TestHegelMarshalOutputIsReadBackByPyYAMLAsTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genEncOpts(ht)
+		v := genVal(ht, 3, strModeFor(o), true)
+		in := toGo(ht, v)
