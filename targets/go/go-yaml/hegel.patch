+// go-yaml/19
+func TestHegelMergeSequencesGiveEarlierMappingsPrecedence(t *testing.T) {
+	doc := "j:\n  <<: [{x: 1}, {x: 2, z: 3}]\n"
+	var got struct {
+		J map[string]int `yaml:"j"`
+	}
+	if err := Unmarshal([]byte(doc), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.J["x"] != 1 || got.J["z"] != 3 {
+		t.Errorf("%q: got %v, the merge spec says earlier mappings win (x: 1, z: 3)", doc, got.J)
+	}
+	var loose any
+	if err := Unmarshal([]byte(doc), &loose); err != nil {
+		t.Fatal(err)
+	}
+	if j := loose.(map[string]any)["j"].(map[string]any); canon(j["x"]) != "i:1" {
+		t.Errorf("%q into interface{}: got %v, want x: 1", doc, j)
+	}
+	doc = "a: &a\n  x: 1\nb: &b\n  x: 2\n  y: 2\nj:\n  <<: [*a, *b]\n"
+	var got2 struct {
+		J map[string]int `yaml:"j"`
+	}
+	if err := Unmarshal([]byte(doc), &got2); err != nil {
+		t.Fatal(err)
+	}
+	if got2.J["x"] != 1 || got2.J["y"] != 2 {
+		t.Errorf("%q: got %v, want x: 1, y: 2", doc, got2.J)
+	}
+}
