+// ---------------------------------------------------------------------------------------
+// Struct round trips.
+
+type Celsius float64
+
+func (c Celsius) MarshalText() ([]byte, error) {
+	return []byte(strconv.FormatFloat(float64(c), 'f', 2, 64) + "C"), nil
+}
+func (c *Celsius) UnmarshalText(b []byte) error {
+	f, err := strconv.ParseFloat(strings.TrimSuffix(string(b), "C"), 64)
+	if err != nil {
+		return err
+	}
+	*c = Celsius(f)
+	return nil
+}
+
+type inner struct {
+	A int    `yaml:"a"`
+	B string `yaml:"b,omitempty"`
+}
+
+type embedded struct {
+	E1 int      `yaml:"e1"`
+	E2 []string `yaml:"e2"`
+}
+
+type rich struct {
+	I     int
+	I8    int8
+	I16   int16
+	I32   int32
+	I64   int64
+	U     uint
+	U8    uint8
+	U16   uint16
+	U32   uint32
+	U64   uint64
+	F32   float32
+	F64   float64
+	S     string
+	B     bool
+	PS    *string
+	PI    *int
+	PIn   *inner
+	Sl    []int
+	SS    []string
+	Arr   [3]int
+	M     map[string]int
+	MI    map[string]inner
+	Sn    []inner
+	In    inner
+	Emb   embedded          `yaml:",inline"`
+	Flow  inner             `yaml:"flow,flow"`
+	FlowS []string          `yaml:"flows,flow"`
+	Ren   string            `yaml:"renamed"`
+	Omit  int               `yaml:"omit,omitempty"`
+	OmitS *inner            `yaml:"omits,omitempty"`
+	Skip  int               `yaml:"-"`
+	Any   any               `yaml:"any"`
+	Anys  []any             `yaml:"anys"`
+	T     time.Time         `yaml:"t"`
