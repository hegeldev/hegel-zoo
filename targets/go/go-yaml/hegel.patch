+		roundTripAny(t, map[string]any{"f": f})
+	}
+	// the decoder side alone: YAML 1.2 core schema floats without a fraction
+	for _, lit := range []string{"1e3", "1E3", "1e+3", "1e-3", "+1e3", "-1e3", "0e0", "12e-1"} {
+		var got any
+		if err := Unmarshal([]byte("f: "+lit), &got); err != nil {
+			t.Errorf("f: %s: %v", lit, err)
+			continue
+		}
+		want, _ := strconv.ParseFloat(lit, 64)
+		if c := canon(got.(map[string]any)["f"]); c != "f:"+canonFloat(want) {
+			t.Errorf("f: %s decodes as %v, want float %v", lit, c, want)
+		}
+	}
