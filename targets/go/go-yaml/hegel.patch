+func TestHegelStructsRoundTripThroughMarshalAndUnmarshal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genEncOpts(ht)
+		o.flow = false // flow style on a struct with multi-line strings is go-yaml/10
+		if o.singleQuote {
+			o.singleQuote = false // go-yaml/13
+		}
+		in := genRich(ht)
+		doc, err := MarshalWithOptions(in, o.list()...)
+		if err != nil {
+			ht.Fatalf("Marshal(%+v) with %s: %v", in, o, err)
+		}
+		note(ht, "options: %s\ndocument:\n%s", o, doc)
+		var got rich
+		if err := Unmarshal(doc, &got); err != nil {
+			ht.Fatalf("Unmarshal of goccy's own output: %v", err)
+		}
+		want := *in
+		want.Skip = 0
+		if want.OmitS == nil {
+			want.OmitS = nil
+		}
+		if d := same(reflect.ValueOf(want), reflect.ValueOf(got), "rich"); d != "" {
+			ht.Fatalf("round trip changed a field: %s", d)
+		}
+		// strict decoding accepts goccy's own output (no unknown fields)
+		var strict rich
+		if err := UnmarshalWithOptions(doc, &strict, DisallowUnknownField()); err != nil {
+			ht.Fatalf("DisallowUnknownField rejects goccy's own output: %v", err)
+		}
+	})
+}
