diff --git a/hegel_defaults_test.go b/hegel_defaults_test.go
new file mode 100644
index 0000000..b48600c
--- /dev/null
+++ b/hegel_defaults_test.go
@@ -0,0 +1,335 @@
+package jsonschema_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// defaultsModel is what Schema.Unmarshal does with defaults (docs/unmarshal.md,
+// and the behaviour pinned by repro_null_default/main.go): an object is
+// filled first by the schema its $ref points to, then by its own properties;
+// a missing property gets the default of its schema (its own before the
+// first along its $ref chain); a present or freshly defaulted object is
+// filled by the property's schema again, and the object elements of an
+// array by the property's own items schema. Nothing else fills: the
+// generator keeps the other applicators (anyOf, allOf, oneOf, if/then/else,
+// patternProperties, tuples, ...) free of defaults (stripApplicatorDefaults),
+// so the model does not follow them. Only local references are followed.
+type defaultsModel struct {
+	root  map[string]any
+	d     draftInfo
+	depth int
+}
+
+// target is the schema a node's $ref points to, when it is local and resolves.
+func (m *defaultsModel) target(obj map[string]any) map[string]any {
+	ref, ok := obj["$ref"].(string)
+	if !ok {
+		return nil
+	}
+	t, err := resolveRef(m.root, ref, m.d)
+	if err != nil {
+		return nil
+	}
+	tm, _ := t.(map[string]any)
+	return tm
+}
+
+// defaultOf is the default a missing property gets: the schema's own, else
+// the first along its $ref chain.
+func (m *defaultsModel) defaultOf(s any) (any, bool) {
+	obj, ok := s.(map[string]any)
+	for hops := 0; ok && hops < 20; hops++ {
+		if def, has := obj["default"]; has {
+			return def, true
+		}
+		obj = m.target(obj)
+		ok = obj != nil
+	}
+	return nil, false
+}
+
+// fill applies the defaults of schema s to the object, in place.
+func (m *defaultsModel) fill(out map[string]any, s any) {
+	obj, ok := s.(map[string]any)
+	if !ok || m.depth >= 20 {
+		return
+	}
+	m.depth++
+	defer func() { m.depth-- }()
+	if t := m.target(obj); t != nil {
+		m.fill(out, t)
+	}
+	props, _ := obj["properties"].(map[string]any)
+	for _, name := range sortedKeys(props) {
+		ps := props[name]
+		if _, present := out[name]; !present {
+			def, has := m.defaultOf(ps)
+			if !has {
+				continue
+			}
+			out[name] = deepCopy(def)
+		}
+		switch cur := out[name].(type) {
+		case map[string]any:
+			m.fill(cur, ps)
+		case []any:
+			m.fillItems(cur, ps)
+		}
+	}
+}
+
+// fillItems applies the items schema of the property's schema to the
+// object elements of the array. The library reads items from the property's
+// node only (not through its $ref), lets it fill every element (also those
+// prefixItems covers) and does not descend into nested arrays
+// (Known.shallowArrayDefaults); a tuple or boolean items does not fill.
+func (m *defaultsModel) fillItems(arr []any, s any) {
+	obj, ok := s.(map[string]any)
+	if !ok {
+		return
+	}
+	items, isSchema := obj["items"].(map[string]any)
+	if !isSchema && !Known.shallowArrayDefaults {
+		if t := m.target(obj); t != nil {
+			items, isSchema = t["items"].(map[string]any)
+		}
+	}
+	if !isSchema {
+		return
+	}
+	for i, x := range arr {
+		if !Known.shallowArrayDefaults {
+			if prefix, _ := obj["prefixItems"].([]any); i < len(prefix) {
+				continue
+			}
+		}
+		switch el := x.(type) {
+		case map[string]any:
+			m.fill(el, items)
+		case []any:
+			if !Known.shallowArrayDefaults {
+				m.fillItems(el, items)
+			}
+		}
+	}
+}
+
+// hasApplicatorDefaults reports whether the schema reaches a default through
+// anything but properties/items/$ref (allOf, anyOf, oneOf, if/then/else,
+// dependentSchemas, patternProperties, additionalProperties, prefixItems,
+// contains, not): the library's behaviour there is not modelled, so such
+// schemas are not judged.
+func hasApplicatorDefaults(root map[string]any, d draftInfo) bool {
+	found := false
+	eachSchemaNode(root, d, func(node map[string]any, in bool) bool {
+		if _, ok := node["default"]; ok && in {
+			found = true
+		}
+		return !found
+	})
+	return found
+}
+
+// stripApplicatorDefaults removes the defaults hasApplicatorDefaults would
+// report, walking the schema the same way, so that the generated schemas
+// stay within the model.
+func stripApplicatorDefaults(root map[string]any, d draftInfo) {
+	eachSchemaNode(root, d, func(node map[string]any, in bool) bool {
+		if in {
+			delete(node, "default")
+		}
+		return true
+	})
+}
+
+// eachSchemaNode calls visit on every schema object of the document with
+// whether it lies under an applicator the model does not follow (anything
+// but properties, a single items schema and the definitions; a tuple of
+// items counts as one), and follows a $ref met under an applicator to its
+// target, which then counts as under it too (the library follows those
+// references when it looks for a default). A false from visit stops the
+// walk. Only the keywords that hold subschemas are followed: the members of
+// properties and definitions are names, not keywords, whatever they look
+// like.
+func eachSchemaNode(root map[string]any, d draftInfo, visit func(node map[string]any, inApplicator bool) bool) {
+	followed := map[string]bool{}
+	var walk func(v any, in bool) bool
+	each := func(x any, in bool) bool {
+		switch x := x.(type) {
+		case map[string]any:
+			return walk(x, in)
+		case []any:
+			for _, y := range x {
+				if !walk(y, in) {
+					return false
+				}
+			}
+		}
+		return true
+	}
+	eachNamed := func(x any, in bool) bool {
+		m, _ := x.(map[string]any)
+		for _, name := range sortedKeys(m) {
+			if !each(m[name], in) {
+				return false
+			}
+		}
+		return true
+	}
+	walk = func(v any, in bool) bool {
+		node, ok := v.(map[string]any)
+		if !ok {
+			return true
+		}
+		if !visit(node, in) {
+			return false
+		}
+		for _, k := range sortedKeys(node) {
+			x := node[k]
+			more := true
+			switch k {
+			case "$ref":
+				ref, isRef := x.(string)
+				if in && isRef && !followed[ref] {
+					followed[ref] = true
+					if t, err := resolveRef(root, ref, d); err == nil {
+						more = each(t, true)
+					}
+				}
+			case "properties", "$defs", "definitions":
+				more = eachNamed(x, in)
+			case "patternProperties", "dependentSchemas", "dependencies":
+				more = eachNamed(x, true)
+			case "items":
+				_, tuple := x.([]any)
+				more = each(x, in || tuple)
+			case "additionalItems", "prefixItems", "additionalProperties", "propertyNames", "contains", "not", "if", "then", "else",
+				"allOf", "anyOf", "oneOf", "unevaluatedItems", "unevaluatedProperties", "contentSchema":
+				more = each(x, true)
+			}
+			if !more {
+				return false
+			}
+		}
+		return true
+	}
+	walk(root, false)
+}
+
+// defaultsCase: a draft, a schema document with references and the
+// unevaluated keywords (defaults only where Unmarshal's modelled path
+// reaches), and the instance Unmarshal fills.
+type defaultsCase struct {
+	d    draftInfo
+	root map[string]any
+	inst any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c defaultsCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstance %s", c.d.version, jsonText(c.root), jsonText(c.inst))
+}
+
+// defaultsInstances: an object shaped after the schema, or 20% of the time
+// (and whenever the shaped instance is not an object) an object with each
+// of the schema's properties half of the time, shaped after its schema.
+func defaultsInstances(d draftInfo, root map[string]any) hegel.Generator[any] {
+	props, _ := root["properties"].(map[string]any)
+	names := sortedKeys(props)
+	propGens := make([]hegel.Generator[*any], len(names))
+	for i, name := range names {
+		propGens[i] = optional(50, guided(d, props[name], 2))
+	}
+	objects := hegel.Composite(func(tc hegel.TestCase) any {
+		obj := map[string]any{}
+		for i, name := range names {
+			if v := hegel.Draw(tc, propGens[i]); v != nil {
+				obj[name] = *v
+			}
+		}
+		return obj
+	})
+	shaped := hegel.FlatMap(guided(d, root, 3), func(v any) hegel.Generator[any] {
+		if _, isObj := v.(map[string]any); isObj {
+			return hegel.Just(v)
+		}
+		return objects
+	})
+	return weighted(choice[any]{80, shaped}, choice[any]{20, objects})
+}
+
+var defaultsCases = hegel.FlatMap(hegel.SampledFrom(drafts), func(d draftInfo) hegel.Generator[defaultsCase] {
+	return hegel.FlatMap(schemasOf(d, defaultsOpts), func(root map[string]any) hegel.Generator[defaultsCase] {
+		return hegel.Map(defaultsInstances(d, root), func(inst any) defaultsCase { return defaultsCase{d, root, inst} })
+	})
+})
+
+// TestHegelUnmarshalAppliesDefaults: Schema.Unmarshal into a map returns the
+// instance with the schema's property defaults filled in (through
+// properties, items and $ref) and nothing else changed; without defaults it
+// is the identity.
+func TestHegelUnmarshalAppliesDefaults(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, defaultsCases)
+		d, root := tcase.d, tcase.root
+		ht.Assume(!hasApplicatorDefaults(root, d)) // the generator keeps them out; a guard
+		schemaText := jsonText(root)
+		sch, err := compileDoc(root, false)
+		if err != nil {
+			ht.Fatalf("schema does not compile: %v\n%s", err, schemaText)
+		}
+		text := jsonText(tcase.inst)
+		want := decodeJSON(text)
+		if obj, ok := want.(map[string]any); ok {
+			(&defaultsModel{root: root, d: d}).fill(obj, root)
+		}
+
+		var got map[string]any
+		if err := sch.Unmarshal(&got, []byte(text)); err != nil {
+			ht.Fatalf("Unmarshal failed: %v\ninstance %s\nschema %s", err, text, schemaText)
+		}
+		if !reflect.DeepEqual(canonValue(got), canonValue(want)) {
+			ht.Fatalf("draft %d: Unmarshal gave %s\nmodel says   %s\ninstance %s\nschema %s", d.version, jsonText(got), jsonText(want), text, schemaText)
+		}
+		// the map form of the input gives the same result
+		var got2 map[string]any
+		if err := sch.Unmarshal(&got2, decodeJSON(text)); err != nil {
+			ht.Fatalf("Unmarshal from a map failed: %v\ninstance %s\nschema %s", err, text, schemaText)
+		}
+		if !reflect.DeepEqual(canonValue(got2), canonValue(got)) {
+			ht.Fatalf("draft %d: Unmarshal from a map gave %s, from JSON %s\ninstance %s\nschema %s", d.version, jsonText(got2), jsonText(got), text, schemaText)
+		}
+	})
+}
+
+// canonValue normalises a JSON-like value for comparison: numbers by their
+// exact rational text, containers recursively.
+func canonValue(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		out := map[string]any{}
+		for k, x := range v {
+			out[k] = canonValue(x)
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = canonValue(x)
+		}
+		return out
+	case json.Number:
+		return canonKey(v)
+	case float64, int, int64, uint64, float32, int32:
+		b, _ := json.Marshal(v)
+		return canonKey(json.Number(strings.TrimSpace(string(b))))
+	}
+	return v
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..919107b
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,1223 @@
+package jsonschema_test
+
+// Random schemas and instances, as generator values. Values use the same Go
+// shapes as encoding/json with UseNumber produces: nil, bool, json.Number,
+// string, []any, map[string]any.
+//
+// A schema is drawn as a tree (rootSpec: its definitions and its body, each
+// a schemaNode of keyword fragments whose subschemas are nodes again) and
+// rendered into a document by a pure function of the draft and the
+// generator options; a node's reference is an index into the definitions
+// declared before its resource, taken modulo their number when rendered, so
+// the document is valid by construction for its draft (the metaschemas'
+// arity rules are respected) and free of reference cycles, and the shrinker
+// can delete definitions freely. An instance shaped after a schema comes
+// from a generator built from the rendered schema (guided).
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type draftInfo struct {
+	version int
+	url     string
+	idKw    string // "id" in draft 4, "$id" after
+	defsKw  string // "definitions" up to draft 7, "$defs" after
+}
+
+var drafts = []draftInfo{
+	{4, "http://json-schema.org/draft-04/schema#", "id", "definitions"},
+	{6, "http://json-schema.org/draft-06/schema#", "$id", "definitions"},
+	{7, "http://json-schema.org/draft-07/schema#", "$id", "definitions"},
+	{2019, "https://json-schema.org/draft/2019-09/schema", "$id", "$defs"},
+	{2020, "https://json-schema.org/draft/2020-12/schema", "$id", "$defs"},
+}
+
+// jsonText is the canonical text of a value: sorted keys, numbers verbatim.
+func jsonText(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+func num(s string) json.Number { return json.Number(s) }
+
+// Pools ---------------------------------------------------------------------
+
+var numberPool = []string{
+	"0", "1", "-1", "2", "3", "5", "7", "10", "100", "-0", "0.5", "1.5", "-2.5", "0.25", "0.1",
+	"1e2", "1E+2", "2.0", "-0.0", "10.00", "1.0e1", "9007199254740993", "12345678901234567890",
+	"-3", "4", "0.75", "1e-2", "255",
+}
+
+var multiplePool = []string{"1", "2", "3", "0.5", "0.25", "10", "0.125", "100", "5"}
+
+var stringPool = []string{
+	"", "a", "b", "ab", "abc", "\u00e9", "\u65e5\u672c", "a b", "~", "/", "%", "\"", "\\", "\t",
+	" ", "aa", "ba", "12", "x", "AB", "\U0001F600", "aab", "bb", "0", "-1", "true", "null",
+}
+
+var propNamePool = []string{
+	"a", "b", "c", "ab", "~", "/", "%", "\u00e9", " ", "0", "$ref", "", "a/b~c", "\"", "ba", "aa",
+}
+
+var defNamePool = []string{"d0", "d1", "a b", "x/y", "q~", "p%", "\u00fc", "n#", "e?", "s.t", "0", "a~1b", "~0", "-", "$ref"}
+
+var patternPool = []string{
+	"^a", "b$", "^[ab]+$", "\\d", "^.{2}$", "x|y", "^(ab)*$", "[^a]", "^$", "\u00e9", "^\\$", "a.c",
+	"^[a-c]{1,2}$", "\\s", "^\\d+$",
+}
+
+var typeNames = []string{"null", "boolean", "number", "integer", "string", "array", "object"}
+
+var (
+	propNames = hegel.SampledFrom(propNamePool)
+	defNames  = hegel.SampledFrom(defNamePool)
+	patterns  = hegel.SampledFrom(patternPool)
+	typeName  = asAny(hegel.SampledFrom(typeNames))
+	strings_  = asAny(hegel.SampledFrom(stringPool))
+)
+
+// Random instances ----------------------------------------------------------
+
+// draft4NumberPool: draft 4 reads "2.0" as a non-integer (a number with a
+// fraction part), so its pool has no integral numbers written with a
+// fraction or exponent.
+var draft4NumberPool = func() []string {
+	var out []string
+	for _, s := range numberPool {
+		switch s {
+		case "1e2", "1E+2", "2.0", "-0.0", "10.00", "1.0e1":
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}()
+
+// numberGens: the numbers of each draft's pool, as json.Number.
+var numberGens = func() map[int]hegel.Generator[any] {
+	m := map[int]hegel.Generator[any]{}
+	for _, d := range drafts {
+		pool := numberPool
+		if d.version == 4 {
+			pool = draft4NumberPool
+		}
+		m[d.version] = hegel.Map(hegel.SampledFrom(pool), func(s string) any { return num(s) })
+	}
+	return m
+}()
+
+func numbersOf(d draftInfo) hegel.Generator[any] { return numberGens[d.version] }
+
+// nonNil: an empty array is []any{} (hegel-go's Lists yields nil for zero
+// elements, whose JSON text would be null).
+func nonNil(xs []any) []any {
+	if xs == nil {
+		return []any{}
+	}
+	return xs
+}
+
+// valueTrees: a JSON value of the draft: null and a boolean once each,
+// a number twice, a string three times, an array of up to four values
+// twice and an object of up to four distinct names once, by weight;
+// collections nest bound deep, below which every value is a scalar.
+func valueTrees(d draftInfo, bound int) hegel.Generator[any] {
+	scalars := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, numbersOf(d)},
+		choice[any]{3, strings_},
+	)
+	depth := 0
+	var values hegel.Generator[any]
+	items := deferred(&values)
+	arrays := hegel.Composite(func(tc hegel.TestCase) any {
+		depth++
+		defer func() { depth-- }()
+		return nonNil(hegel.Draw(tc, hegel.Lists(items).MaxSize(4)))
+	})
+	objects := hegel.Composite(func(tc hegel.TestCase) any {
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, hegel.Maps(propNames, items).MaxSize(4))
+	})
+	branches := weighted(choice[any]{7, scalars}, choice[any]{2, arrays}, choice[any]{1, objects})
+	values = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= bound {
+			return hegel.Draw(tc, scalars)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return values
+}
+
+// valueGens: the value trees of every draft at depth bounds 0 to 3.
+var valueGens = func() map[[2]int]hegel.Generator[any] {
+	m := map[[2]int]hegel.Generator[any]{}
+	for _, d := range drafts {
+		for bound := 0; bound <= 3; bound++ {
+			m[[2]int{d.version, bound}] = valueTrees(d, bound)
+		}
+	}
+	return m
+}()
+
+// valuesOf: random values of the draft nesting depth deep (scalars only at
+// depth 0 or below).
+func valuesOf(d draftInfo, depth int) hegel.Generator[any] {
+	if depth < 0 {
+		depth = 0
+	}
+	if depth > 3 {
+		depth = 3
+	}
+	return valueGens[[2]int{d.version, depth}]
+}
+
+// Guided instances ----------------------------------------------------------
+
+// guided: an instance shaped after the schema: its const or enum, one of its
+// types (guessed from its applicators when it names none), its properties
+// and required names, its prefix items, its numeric bounds; a random value
+// 15% of the time, half of the time under a $ref, and whenever the schema is
+// not an object or the depth is spent.
+func guided(d draftInfo, sch any, depth int) hegel.Generator[any] {
+	random := valuesOf(d, depth)
+	s, ok := sch.(map[string]any)
+	if !ok || depth < 0 {
+		return random
+	}
+	g := typed(d, s, depth)
+	if _, hasRef := s["$ref"]; hasRef {
+		g = weighted(choice[any]{50, random}, choice[any]{50, g})
+	}
+	if e, ok := s["enum"].([]any); ok && len(e) > 0 {
+		g = weighted(choice[any]{70, hegel.SampledFrom(e)}, choice[any]{30, g})
+	}
+	if c, ok := s["const"]; ok {
+		g = weighted(choice[any]{70, hegel.Just(c)}, choice[any]{30, g})
+	}
+	return weighted(choice[any]{15, random}, choice[any]{85, g})
+}
+
+// typesOf: the type names the schema declares.
+func typesOf(s map[string]any) []string {
+	switch t := s["type"].(type) {
+	case string:
+		return []string{t}
+	case []any:
+		var types []string
+		for _, x := range t {
+			if name, ok := x.(string); ok {
+				types = append(types, name)
+			}
+		}
+		return types
+	}
+	return nil
+}
+
+// typed: an instance of one of the schema's types; a schema naming none is
+// read from its applicators, or its allOf/anyOf/oneOf arms, or its if/then.
+func typed(d draftInfo, s map[string]any, depth int) hegel.Generator[any] {
+	random := valuesOf(d, depth)
+	types := typesOf(s)
+	if len(types) == 0 {
+		switch {
+		case s["properties"] != nil || s["required"] != nil || s["patternProperties"] != nil || s["additionalProperties"] != nil || s["propertyNames"] != nil:
+			types = []string{"object"}
+		case s["items"] != nil || s["prefixItems"] != nil || s["contains"] != nil || s["minItems"] != nil:
+			types = []string{"array"}
+		case s["minimum"] != nil || s["maximum"] != nil || s["multipleOf"] != nil || s["exclusiveMinimum"] != nil || s["exclusiveMaximum"] != nil:
+			types = []string{"number"}
+		case s["minLength"] != nil || s["maxLength"] != nil || s["pattern"] != nil:
+			types = []string{"string"}
+		default:
+			for _, kw := range []string{"allOf", "anyOf", "oneOf"} {
+				if arr, ok := s[kw].([]any); ok && len(arr) > 0 {
+					arms := make([]hegel.Generator[any], len(arr))
+					for i, arm := range arr {
+						arms[i] = guided(d, arm, depth)
+					}
+					return hegel.OneOf(arms...)
+				}
+			}
+			arms := []hegel.Generator[any]{random}
+			if sub, ok := s["if"]; ok {
+				arms[0] = guided(d, sub, depth)
+			}
+			if sub, ok := s["then"]; ok {
+				arms = append(arms, guided(d, sub, depth))
+			}
+			return hegel.OneOf(arms...)
+		}
+	}
+	gens := make([]hegel.Generator[any], len(types))
+	for i, t := range types {
+		gens[i] = ofType(d, s, t, depth)
+	}
+	return hegel.OneOf(gens...)
+}
+
+// ofType: an instance of the named type shaped after the schema.
+func ofType(d draftInfo, s map[string]any, t string, depth int) hegel.Generator[any] {
+	switch t {
+	case "null":
+		return hegel.Just[any](nil)
+	case "boolean":
+		return asAny(hegel.Booleans())
+	case "number", "integer":
+		// the bounds themselves, some of the time
+		var bounds []any
+		for _, kw := range []string{"minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"} {
+			if v, ok := s[kw].(json.Number); ok {
+				bounds = append(bounds, v)
+			}
+		}
+		if len(bounds) == 0 {
+			return numbersOf(d)
+		}
+		return weighted(choice[any]{65, numbersOf(d)}, choice[any]{35, hegel.SampledFrom(bounds)})
+	case "string":
+		return strings_
+	case "array":
+		return shapedArrays(d, s, depth)
+	}
+	return shapedObjects(d, s, depth)
+}
+
+// shapedArrays: up to four items: the prefix items (prefixItems, or an items
+// array) shaped after theirs, the rest after items (or additionalItems) 80%
+// of the time, else after contains half of the time, else random.
+func shapedArrays(d draftInfo, s map[string]any, depth int) hegel.Generator[any] {
+	random := valuesOf(d, depth-1)
+	var prefix []any
+	if p, ok := s["prefixItems"].([]any); ok {
+		prefix = p
+	} else if p, ok := s["items"].([]any); ok {
+		prefix = p
+	}
+	items := s["items"]
+	if _, isArr := items.([]any); isArr {
+		items = s["additionalItems"]
+	}
+	contains := s["contains"]
+	var rest hegel.Generator[any]
+	switch {
+	case items != nil && contains != nil:
+		rest = weighted(choice[any]{10, random}, choice[any]{80, guided(d, items, depth-1)}, choice[any]{10, guided(d, contains, depth-1)})
+	case items != nil:
+		rest = weighted(choice[any]{20, random}, choice[any]{80, guided(d, items, depth-1)})
+	case contains != nil:
+		rest = weighted(choice[any]{50, random}, choice[any]{50, guided(d, contains, depth-1)})
+	default:
+		rest = random
+	}
+	prefixGens := make([]hegel.Generator[any], len(prefix))
+	for i, p := range prefix {
+		prefixGens[i] = guided(d, p, depth-1)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) any {
+		arr := nonNil(hegel.Draw(tc, hegel.Lists(rest).MaxSize(4)))
+		for i := 0; i < len(arr) && i < len(prefixGens); i++ {
+			arr[i] = hegel.Draw(tc, prefixGens[i])
+		}
+		return arr
+	})
+}
+
+// shapedObjects: each property 60% of the time (shaped after its schema),
+// each required name 80% (after its property schema, or random), and up to
+// two more names, shaped after additionalProperties 60% of the time when it
+// is a schema.
+func shapedObjects(d draftInfo, s map[string]any, depth int) hegel.Generator[any] {
+	random := valuesOf(d, depth-1)
+	props, _ := s["properties"].(map[string]any)
+	names := sortedKeys(props)
+	propGens := make([]hegel.Generator[*any], len(names))
+	for i, name := range names {
+		propGens[i] = optional(60, guided(d, props[name], depth-1))
+	}
+	var required []string
+	var reqGens []hegel.Generator[*any]
+	if req, ok := s["required"].([]any); ok {
+		for _, r := range req {
+			if name, isStr := r.(string); isStr {
+				g := random
+				if ps, ok := props[name]; ok {
+					g = guided(d, ps, depth-1)
+				}
+				required = append(required, name)
+				reqGens = append(reqGens, optional(80, g))
+			}
+		}
+	}
+	extra := random
+	if ap, ok := s["additionalProperties"].(map[string]any); ok {
+		extra = weighted(choice[any]{40, random}, choice[any]{60, guided(d, ap, depth-1)})
+	}
+	extras := hegel.Maps(propNames, extra).MaxSize(2)
+	return hegel.Composite(func(tc hegel.TestCase) any {
+		obj := map[string]any{}
+		for i, name := range names {
+			if v := hegel.Draw(tc, propGens[i]); v != nil {
+				obj[name] = *v
+			}
+		}
+		for i, name := range required {
+			if v := hegel.Draw(tc, reqGens[i]); v != nil {
+				if _, done := obj[name]; !done {
+					obj[name] = *v
+				}
+			}
+		}
+		for name, v := range hegel.Draw(tc, extras) {
+			if _, done := obj[name]; !done {
+				obj[name] = v
+			}
+		}
+		return obj
+	})
+}
+
+// instancesOf: two to six instances, shaped after the schema 65% of the
+// time and random otherwise.
+func instancesOf(d draftInfo, root map[string]any) hegel.Generator[[]any] {
+	return hegel.Lists(weighted(choice[any]{35, valuesOf(d, 3)}, choice[any]{65, guided(d, root, 3)})).MinSize(2).MaxSize(6)
+}
+
+func sortedKeys(m map[string]any) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// Random schemas ------------------------------------------------------------
+
+// genOpts tunes the schema generator.
+type genOpts struct {
+	refs        bool // $ref / definitions / anchors / embedded ids
+	ids         bool // embedded $id resources (needs refs)
+	uneval      bool // unevaluatedProperties / unevaluatedItems (2019+)
+	refSiblings bool // in drafts <= 7, other keywords beside $ref (which must be ignored)
+	formats     bool // format keyword (asserted by the Go library in drafts <= 7 by default)
+	// plainDefaults: "default" only where Unmarshal's modelled path reaches
+	// (through properties, items, definitions and $ref), not under the other
+	// applicators
+	plainDefaults bool
+}
+
+var (
+	fullOpts     = genOpts{refs: true, ids: true, uneval: true, refSiblings: true} // the Python differentials and the serialization round trip
+	outputOpts   = genOpts{refs: true, uneval: true, refSiblings: true}            // the output property
+	defaultsOpts = genOpts{refs: true, uneval: true, plainDefaults: true}          // the defaults property
+	plainOpts    = genOpts{uneval: true}                                           // the reference property
+)
+
+// fragment: one keyword, or a keyword with its companions (a bound with its
+// exclusive form, if with then and else, contains with its counts, $comment
+// with description), as the entries it adds to a schema object. A
+// subschema inside is a *schemaNode or a bool, rendered in place.
+type fragment map[string]any
+
+// refSpec: a node's reference: the target-th of the definitions available
+// to its resource (modulo their number), in its form-th reference form
+// (modulo their number), as $dynamicRef when dynamic and the target has a
+// dynamic anchor named by the form; in drafts <= 7 bare (no sibling
+// keywords) when bare.
+type refSpec struct {
+	target, form int
+	dynamic      bool
+	bare         bool
+}
+
+// schemaNode: a subschema as drawn: its reference (when the grammar has
+// references) and one to three keyword fragments.
+type schemaNode struct {
+	ref *refSpec
+	kws []fragment
+}
+
+// defSpec: a definition of the root resource: an embedded resource
+// ("subN.json") when the root uses ids and withID, else anchored or not; in
+// 2020-12 the anchor is a $dynamicAnchor when dynamic; from 2019-09 an
+// embedded resource is also referenced root-relative ("/subN.json") when
+// rootRel.
+type defSpec struct {
+	name     string
+	withID   bool
+	anchored bool
+	dynamic  bool
+	rootRel  bool
+	schema   *schemaNode
+}
+
+// rootSpec: a schema document: whether the root carries an id (always when
+// its definitions use ids), whether the definitions may be embedded
+// resources, the definitions and the body.
+type rootSpec struct {
+	id     bool
+	useIDs bool
+	defs   []defSpec
+	body   *schemaNode
+}
+
+// kw is a fragment of one keyword.
+func kw[T any](key string, g hegel.Generator[T]) hegel.Generator[fragment] {
+	return hegel.Map(g, func(v T) fragment { return fragment{key: v} })
+}
+
+// kwOf is a fragment of one of the keys.
+func kwOf[T any](keys []string, g hegel.Generator[T]) hegel.Generator[fragment] {
+	return hegel.Map(pairs(hegel.SampledFrom(keys), g), func(p pair[string, T]) fragment { return fragment{p.a: p.b} })
+}
+
+// anyList: a non-nil []any of the strings.
+func anyList(ss []string) any {
+	out := make([]any, len(ss))
+	for i, s := range ss {
+		out[i] = s
+	}
+	return out
+}
+
+// namesList: lo to hi distinct property names.
+func namesList(lo, hi int) hegel.Generator[any] {
+	return hegel.Map(hegel.Lists(propNames).MinSize(lo).MaxSize(hi), func(ns []string) any { return anyList(distinct(ns)) })
+}
+
+// countGens: a value for a non-negative-integer keyword, per draft: 0 to 4,
+// and beyond int64 a tenth of the time only when the misreading bug is
+// fixed (draft 4 reads 1e19 as a non-integer, so its big counts have no
+// exponent).
+var countGens = func() map[int]hegel.Generator[any] {
+	small := hegel.Map(hegel.Integers(0, 4), func(n int) any { return num(fmt.Sprint(n)) })
+	m := map[int]hegel.Generator[any]{}
+	for _, d := range drafts {
+		if Known.bigIntegerKeywords {
+			m[d.version] = small
+			continue
+		}
+		pool := []string{"9223372036854775808", "18446744073709551616", "1e19", "1e30", "9223372036854775807"}
+		if d.version == 4 {
+			pool = []string{"9223372036854775808", "18446744073709551616", "9223372036854775807"}
+		}
+		big := hegel.Map(hegel.SampledFrom(pool), func(s string) any { return num(s) })
+		m[d.version] = weighted(choice[any]{90, small}, choice[any]{10, big})
+	}
+	return m
+}()
+
+func countsOf(d draftInfo) hegel.Generator[any] { return countGens[d.version] }
+
+var (
+	smallCounts = hegel.Map(hegel.Integers(0, 3), func(n int) any { return num(fmt.Sprint(n)) })
+	bools       = asAny(hegel.Booleans())
+	exclusiveOf = map[string]string{"minimum": "exclusiveMinimum", "maximum": "exclusiveMaximum"}
+)
+
+// subschemas: a boolean schema 10% of the time (drafts >= 6), else an object.
+func subschemas(d draftInfo, objects hegel.Generator[*schemaNode]) hegel.Generator[any] {
+	nodes := asAny(objects)
+	if d.version < 6 {
+		return nodes
+	}
+	return weighted(choice[any]{10, bools}, choice[any]{90, nodes})
+}
+
+// leafKeywords: the keywords without a subschema of their own (the only
+// ones at the depth bound), weighted as the old generator's die: type three
+// times, a bound and required twice, the rest once. dependencies (drafts
+// <= 7) is a schema 40% of the time, drawn from depSubs (nil: names only);
+// propertyNames (drafts >= 6) is a leaf object from leafObjects (nil:
+// minProperties instead).
+func leafKeywords(d draftInfo, o genOpts, depSubs hegel.Generator[any], leafObjects hegel.Generator[*schemaNode]) []choice[fragment] {
+	numbers := numbersOf(d)
+	counts := countsOf(d)
+	typeValues := weighted(
+		choice[any]{60, typeName},
+		choice[any]{40, hegel.Map(hegel.Lists(hegel.SampledFrom(typeNames)).MinSize(1).MaxSize(3), func(ts []string) any { return anyList(distinct(ts)) })},
+	)
+	enums := hegel.Map(hegel.Lists(valuesOf(d, 1)).MinSize(1).MaxSize(4), func(vals []any) any {
+		seen := map[string]bool{}
+		var arr []any
+		for _, val := range vals {
+			if key := canonKey(val); !seen[key] {
+				seen[key] = true
+				arr = append(arr, val)
+			}
+		}
+		return arr
+	})
+	constOrType := kw("type", typeName)
+	if d.version >= 6 {
+		constOrType = kw("const", valuesOf(d, 1))
+	}
+	exclusives := numbers
+	if d.version == 4 {
+		exclusives = asAny(chance(70))
+	}
+	exclusive := optional(40, exclusives)
+	bounds := hegel.Composite(func(tc hegel.TestCase) fragment {
+		key := hegel.Draw(tc, hegel.SampledFrom([]string{"minimum", "maximum"}))
+		f := fragment{key: hegel.Draw(tc, numbers)}
+		if x := hegel.Draw(tc, exclusive); x != nil {
+			f[exclusiveOf[key]] = *x
+		}
+		return f
+	})
+	var dependencies hegel.Generator[fragment]
+	if d.version >= 2019 {
+		dependencies = kw("dependentRequired", asAny(hegel.Maps(propNames, namesList(0, 2)).MinSize(1).MaxSize(2)))
+	} else {
+		values := namesList(1, 2)
+		if depSubs != nil {
+			values = weighted(choice[any]{60, namesList(1, 2)}, choice[any]{40, depSubs})
+		}
+		dependencies = kw("dependencies", asAny(hegel.Maps(propNames, values).MinSize(1).MaxSize(2)))
+	}
+	annotation := kw("title", strings_)
+	if o.formats {
+		annotation = kw("format", asAny(hegel.SampledFrom([]string{"date", "ipv4", "uuid", "email", "date-time", "unknown-format"})))
+	}
+	propertyNames := hegel.Just(fragment{"minProperties": num("1")})
+	if d.version >= 6 && leafObjects != nil {
+		propertyNames = kw("propertyNames", asAny(leafObjects))
+	}
+	comments := hegel.Just(false)
+	if d.version >= 2019 {
+		comments = chance(50)
+	}
+	described := hegel.Map(comments, func(c bool) fragment {
+		f := fragment{"description": "d"}
+		if c {
+			f["$comment"] = "c"
+		}
+		return f
+	})
+	defaultWeight, defaultValues := 1, valuesOf(d, 1)
+	if o.plainDefaults {
+		defaultWeight = 3 // the defaults property lives on them, and those under other applicators are stripped
+		if Known.nullDefaultIgnored {
+			defaultValues = hegel.Filter(defaultValues, func(v any) bool { return v != nil }) // a null default is not applied
+		}
+	}
+	return []choice[fragment]{
+		{3, kw("type", typeValues)},
+		{1, kw("enum", enums)},
+		{1, constOrType},
+		{1, kw("multipleOf", hegel.Map(hegel.SampledFrom(multiplePool), func(s string) any { return num(s) }))},
+		{2, bounds},
+		{1, kwOf([]string{"minLength", "maxLength"}, counts)},
+		{1, kw("pattern", patterns)},
+		{1, kwOf([]string{"minItems", "maxItems"}, counts)},
+		{1, kw("uniqueItems", chance(80))},
+		{1, kwOf([]string{"minProperties", "maxProperties"}, counts)},
+		{2, kw("required", namesList(1, 3))},
+		{1, dependencies},
+		{1, annotation},
+		{defaultWeight, kw("default", defaultValues)},
+		{1, propertyNames},
+		{1, described},
+	}
+}
+
+// applicatorKeywords: the keywords with subschemas, weighted as the old
+// generator's die: properties three times, items and the allOf family and
+// the unevaluated keywords twice, the rest once; the drafts without a
+// keyword fall back to one they have.
+func applicatorKeywords(d draftInfo, o genOpts, subs hegel.Generator[any]) []choice[fragment] {
+	subsList := func(lo, hi int) hegel.Generator[any] {
+		return hegel.Map(hegel.Lists(subs).MinSize(lo).MaxSize(hi), func(xs []any) any { return nonNil(xs) })
+	}
+	boolOrSub := hegel.OneOf(bools, subs)
+	var items hegel.Generator[fragment]
+	if d.version >= 2020 {
+		prefix, rest := optional(50, subsList(1, 3)), optional(60, subs)
+		items = hegel.Composite(func(tc hegel.TestCase) fragment {
+			f := fragment{}
+			if p := hegel.Draw(tc, prefix); p != nil {
+				f["prefixItems"] = *p
+			}
+			if s := hegel.Draw(tc, rest); s != nil {
+				f["items"] = *s
+			}
+			return f
+		})
+	} else {
+		additional := optional(60, boolOrSub)
+		tuples := hegel.Composite(func(tc hegel.TestCase) fragment {
+			f := fragment{"items": hegel.Draw(tc, subsList(1, 3))}
+			if a := hegel.Draw(tc, additional); a != nil {
+				f["additionalItems"] = *a
+			}
+			return f
+		})
+		items = weighted(choice[fragment]{50, kw("items", subs)}, choice[fragment]{50, tuples})
+	}
+	contains := hegel.Just(fragment{"minItems": num("1")})
+	switch {
+	case d.version >= 2019:
+		minC, maxC := optional(50, smallCounts), optional(40, smallCounts)
+		contains = hegel.Composite(func(tc hegel.TestCase) fragment {
+			f := fragment{"contains": hegel.Draw(tc, subs)}
+			if x := hegel.Draw(tc, minC); x != nil {
+				f["minContains"] = *x
+			}
+			if x := hegel.Draw(tc, maxC); x != nil {
+				f["maxContains"] = *x
+			}
+			return f
+		})
+	case d.version >= 6:
+		contains = kw("contains", subs)
+	}
+	conditionals := kw("not", subs)
+	if d.version >= 7 {
+		thens, elses := optional(70, subs), optional(50, subs)
+		conditionals = hegel.Composite(func(tc hegel.TestCase) fragment {
+			f := fragment{"if": hegel.Draw(tc, subs)}
+			if x := hegel.Draw(tc, thens); x != nil {
+				f["then"] = *x
+			}
+			if x := hegel.Draw(tc, elses); x != nil {
+				f["else"] = *x
+			}
+			return f
+		})
+	}
+	dependentSchemas := kw("anyOf", subsList(1, 2))
+	if d.version >= 2019 {
+		dependentSchemas = kw("dependentSchemas", asAny(hegel.Maps(propNames, subs).MinSize(1).MaxSize(2)))
+	}
+	unevaluated := kw("properties", asAny(hegel.Maps(propNames, subs).MinSize(1).MaxSize(1)))
+	if d.version >= 2019 && o.uneval {
+		unevaluated = weighted(
+			choice[fragment]{50, kw("unevaluatedProperties", boolOrSub)},
+			choice[fragment]{50, kw("unevaluatedItems", boolOrSub)},
+		)
+	}
+	return []choice[fragment]{
+		{3, kw("properties", asAny(hegel.Maps(propNames, subs).MinSize(1).MaxSize(3)))},
+		{1, kw("patternProperties", asAny(hegel.Maps(patterns, subs).MinSize(1).MaxSize(2)))},
+		{1, kw("additionalProperties", boolOrSub)},
+		{2, items},
+		{1, contains},
+		{2, kwOf([]string{"allOf", "anyOf", "oneOf"}, subsList(1, 3))},
+		{1, kw("not", subs)},
+		{1, conditionals},
+		{1, dependentSchemas},
+		{2, unevaluated},
+	}
+}
+
+// objectsOf: a schema object: a reference (when the grammar has them) and
+// one to most keyword fragments.
+func objectsOf(refs hegel.Generator[*refSpec], kws hegel.Generator[fragment], most int) hegel.Generator[*schemaNode] {
+	frags := hegel.Lists(kws).MinSize(1).MaxSize(most)
+	return hegel.Composite(func(tc hegel.TestCase) *schemaNode {
+		return &schemaNode{ref: hegel.Draw(tc, refs), kws: hegel.Draw(tc, frags)}
+	})
+}
+
+// nodesOf: the subschemas of a grammar as a recursive generator: an object
+// of one to three keywords whose subschemas are nodes again, bound levels
+// deep; at the bound a leaf object of one or two keywords without
+// subschemas, except that dependencies and propertyNames may hold a leaf
+// object again, two levels at most (the counters in the closure track the
+// live recursion, hegel-go's ExampleComposite_recursive).
+func nodesOf(d draftInfo, o genOpts, refs hegel.Generator[*refSpec], bound int) hegel.Generator[*schemaNode] {
+	var nodes, leafObjects hegel.Generator[*schemaNode]
+	subs := subschemas(d, deferred(&nodes))
+	leafRef := deferred(&leafObjects)
+	leafSubs := subschemas(d, leafRef)
+	flatKws := weighted(leafKeywords(d, o, nil, nil)...)
+	leafKws := weighted(leafKeywords(d, o, leafSubs, leafRef)...)
+	allKws := weighted(append(leafKeywords(d, o, subs, leafRef), applicatorKeywords(d, o, subs)...)...)
+	flats, leaves, full := objectsOf(refs, flatKws, 2), objectsOf(refs, leafKws, 2), objectsOf(refs, allKws, 3)
+	leafDepth := 0
+	leafObjects = hegel.Composite(func(tc hegel.TestCase) *schemaNode {
+		if leafDepth >= 2 {
+			return hegel.Draw(tc, flats)
+		}
+		leafDepth++
+		defer func() { leafDepth-- }()
+		return hegel.Draw(tc, leaves)
+	})
+	depth := 0
+	nodes = hegel.Composite(func(tc hegel.TestCase) *schemaNode {
+		if depth >= bound {
+			return hegel.Draw(tc, leafObjects)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, full)
+	})
+	return nodes
+}
+
+// schemaGrammar: a schema document of the draft under the options: the root
+// carries an id 30% of the time, up to three definitions (each an embedded
+// resource half of the time when ids are on and the root uses them, else
+// anchored half of the time) two levels deep, and a body three levels deep;
+// a node references a definition 25% of the time.
+func schemaGrammar(d draftInfo, o genOpts) hegel.Generator[rootSpec] {
+	refs := hegel.Just[*refSpec](nil)
+	ids, useIDs, defs := hegel.Just(false), hegel.Just(false), hegel.Just([]defSpec(nil))
+	if o.refs {
+		bare := hegel.Just(false)
+		if d.version < 2019 && o.refSiblings {
+			bare = chance(50)
+		}
+		refs = optional(25, hegel.Composite(func(tc hegel.TestCase) refSpec {
+			return refSpec{
+				target:  hegel.Draw(tc, hegel.Integers(0, 2)),
+				form:    hegel.Draw(tc, hegel.Integers(0, 2)),
+				dynamic: hegel.Draw(tc, chance(60)),
+				bare:    hegel.Draw(tc, bare),
+			}
+		}))
+		ids = chance(30)
+		withID, dynamic, rootRel := hegel.Just(false), hegel.Just(false), hegel.Just(false)
+		if o.ids {
+			useIDs, withID = chance(50), chance(50)
+		}
+		if d.version == 2020 {
+			dynamic = chance(40)
+		}
+		if d.version >= 2019 {
+			rootRel = chance(50)
+		}
+		defNodes := nodesOf(d, o, refs, 2)
+		defs = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) defSpec {
+			return defSpec{
+				name:     hegel.Draw(tc, defNames),
+				withID:   hegel.Draw(tc, withID),
+				anchored: hegel.Draw(tc, chance(50)),
+				dynamic:  hegel.Draw(tc, dynamic),
+				rootRel:  hegel.Draw(tc, rootRel),
+				schema:   hegel.Draw(tc, defNodes),
+			}
+		})).MaxSize(3)
+	}
+	body := nodesOf(d, o, refs, 3)
+	return hegel.Composite(func(tc hegel.TestCase) rootSpec {
+		return rootSpec{
+			id:     hegel.Draw(tc, ids),
+			useIDs: hegel.Draw(tc, useIDs),
+			defs:   hegel.Draw(tc, defs),
+			body:   hegel.Draw(tc, body),
+		}
+	})
+}
+
+// definition: a rendered definition and the ways the root resource may
+// reference it.
+type definition struct {
+	refs []string
+	dyn  bool // a $dynamicAnchor (referenced with $dynamicRef)
+}
+
+// render writes the schema document of the draft: $schema, the id, the
+// definitions (each referencing only those before it, and none from inside
+// an embedded resource) and the body.
+func (r rootSpec) render(d draftInfo, o genOpts) map[string]any {
+	root := map[string]any{"$schema": d.url}
+	if !o.refs {
+		for k, v := range renderNode(r.body, d, o, nil) {
+			root[k] = v
+		}
+		return root
+	}
+	useIDs := o.ids && len(r.defs) > 0 && r.useIDs
+	if useIDs || r.id {
+		root[d.idKw] = "http://example.com/root.json"
+	}
+	defs := map[string]any{}
+	var done []definition
+	for i, e := range r.defs {
+		name := e.name
+		if _, dup := defs[name]; dup {
+			name = fmt.Sprintf("%s%d", name, i)
+		}
+		withID := useIDs && e.withID
+		avail := done
+		if withID {
+			avail = nil // no references from inside an embedded resource
+		}
+		schema := renderNode(e.schema, d, o, avail)
+		ptr := "/" + d.defsKw + "/" + escapeToken(name)
+		def := definition{refs: []string{"#" + fragmentEscape(ptr)}}
+		switch {
+		case withID:
+			schema[d.idKw] = fmt.Sprintf("sub%d.json", i)
+			// Up to draft 7 a root-level $ref silences the root's $id (the library
+			// follows the letter; Python does not), so only the relative form,
+			// which resolves the same way against either base, is used there.
+			def.refs = []string{fmt.Sprintf("sub%d.json", i)}
+			if d.version >= 2019 {
+				def.refs = append(def.refs, fmt.Sprintf("http://example.com/sub%d.json", i))
+				if e.rootRel {
+					def.refs = append(def.refs, fmt.Sprintf("/sub%d.json", i))
+				}
+			}
+		case e.anchored:
+			anchor := fmt.Sprintf("A%d", i)
+			switch {
+			case d.version == 2020 && e.dynamic:
+				schema["$dynamicAnchor"] = anchor
+				def.dyn = true
+			case d.version >= 2019:
+				schema["$anchor"] = anchor
+			default:
+				_, hasRef := schema["$ref"] // an id beside $ref is ignored
+				if !hasRef && Known.plainNameIDScope && containsRef(schema) {
+					hasRef = true // the references inside would not resolve (kaptinlin-jsonschema/1)
+				}
+				if !hasRef {
+					schema[d.idKw] = "#" + anchor
+				} else {
+					anchor = ""
+				}
+			}
+			if anchor != "" {
+				def.refs = append(def.refs, "#"+anchor)
+			}
+		}
+		defs[name] = schema
+		done = append(done, def)
+	}
+	if len(defs) > 0 {
+		root[d.defsKw] = defs
+	}
+	for k, v := range renderNode(r.body, d, o, done) {
+		root[k] = v
+	}
+	return root
+}
+
+// containsRef reports a $ref anywhere inside a schema value.
+func containsRef(v any) bool {
+	switch v := v.(type) {
+	case map[string]any:
+		if _, ok := v["$ref"]; ok {
+			return true
+		}
+		for _, x := range v {
+			if containsRef(x) {
+				return true
+			}
+		}
+	case []any:
+		for _, x := range v {
+			if containsRef(x) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// renderNode writes a schema object: its reference to one of the available
+// definitions first (in drafts <= 7 alone when bare, or always when
+// siblings are off), then its keyword fragments in order (a later one
+// replaces an earlier one of the same keyword); in 2019-09 contains and
+// unevaluatedItems do not meet (accepted difference).
+func renderNode(n *schemaNode, d draftInfo, o genOpts, avail []definition) map[string]any {
+	s := map[string]any{}
+	hasRef := false
+	if n.ref != nil && len(avail) > 0 {
+		e := avail[n.ref.target%len(avail)]
+		ref := e.refs[n.ref.form%len(e.refs)]
+		if e.dyn && strings.HasPrefix(ref, "#A") && n.ref.dynamic {
+			s["$dynamicRef"] = ref
+		} else {
+			s["$ref"] = ref
+			hasRef = true
+		}
+		if d.version < 2019 && (!o.refSiblings || n.ref.bare) {
+			return s
+		}
+	}
+	for _, f := range n.kws {
+		for k, v := range f {
+			if k == "const" && hasRef && d.version < 2019 && Known.refSiblingConst {
+				// a const beside $ref is enforced: a type, which is ignored, stands in
+				s["type"] = jsonType(v)
+				continue
+			}
+			s[k] = renderValue(v, d, o, avail)
+		}
+	}
+	if d.version == 2019 && s["contains"] != nil {
+		delete(s, "unevaluatedItems") // contains and unevaluatedItems do not interact in 2019-09 (accepted difference)
+	}
+	return s
+}
+
+// renderValue renders the subschema nodes inside a fragment's value.
+func renderValue(v any, d draftInfo, o genOpts, avail []definition) any {
+	switch v := v.(type) {
+	case *schemaNode:
+		return renderNode(v, d, o, avail)
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, x := range v {
+			out[k] = renderValue(x, d, o, avail)
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = renderValue(x, d, o, avail)
+		}
+		return out
+	}
+	return v
+}
+
+// jsonType names the JSON type of a value.
+func jsonType(v any) string {
+	switch v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "boolean"
+	case json.Number:
+		return "number"
+	case string:
+		return "string"
+	case []any:
+		return "array"
+	}
+	return "object"
+}
+
+type grammarKey struct {
+	version int
+	o       genOpts
+}
+
+// schemaGens: the rendered schema documents of every draft under the
+// options the properties use.
+var schemaGens = func() map[grammarKey]hegel.Generator[map[string]any] {
+	m := map[grammarKey]hegel.Generator[map[string]any]{}
+	for _, d := range drafts {
+		for _, o := range []genOpts{fullOpts, outputOpts, defaultsOpts, plainOpts} {
+			d, o := d, o
+			m[grammarKey{d.version, o}] = hegel.Map(schemaGrammar(d, o), func(r rootSpec) map[string]any {
+				root := r.render(d, o)
+				if o.plainDefaults {
+					stripApplicatorDefaults(root, d)
+				}
+				return root
+			})
+		}
+	}
+	return m
+}()
+
+// schemasOf: schema documents of the draft under the options.
+func schemasOf(d draftInfo, o genOpts) hegel.Generator[map[string]any] {
+	g, ok := schemaGens[grammarKey{d.version, o}]
+	if !ok {
+		panic(fmt.Sprintf("no schema grammar for draft %d under %+v", d.version, o))
+	}
+	return g
+}
+
+func escapeToken(tok string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(tok, "~", "~0"), "/", "~1")
+}
+
+// fragmentEscape percent-encodes a JSON pointer for use as a URI fragment.
+func fragmentEscape(ptr string) string {
+	u := url.URL{Fragment: ptr}
+	return strings.TrimPrefix(u.String(), "#")
+}
+
+// canonKey is a text of a value under which equal JSON values (0 and -0,
+// 1 and 1.0) coincide, for building enums without duplicates.
+func canonKey(v any) string {
+	switch v := v.(type) {
+	case json.Number:
+		if r, ok := new(big.Rat).SetString(string(v)); ok {
+			return "#" + r.RatString()
+		}
+		return string(v)
+	case map[string]any:
+		var sb strings.Builder
+		sb.WriteString("{")
+		for _, k := range sortedKeys(v) {
+			sb.WriteString(strconv.Quote(k) + ":" + canonKey(v[k]) + ",")
+		}
+		return sb.String() + "}"
+	case []any:
+		var sb strings.Builder
+		sb.WriteString("[")
+		for _, x := range v {
+			sb.WriteString(canonKey(x) + ",")
+		}
+		return sb.String() + "]"
+	default:
+		return jsonText(v)
+	}
+}
+
+// deepCopy copies a JSON value.
+func deepCopy(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		m := make(map[string]any, len(v))
+		for k, x := range v {
+			m[k] = deepCopy(x)
+		}
+		return m
+	case []any:
+		a := make([]any, len(v))
+		for i, x := range v {
+			a[i] = deepCopy(x)
+		}
+		return a
+	default:
+		return v
+	}
+}
+
+// Cases ---------------------------------------------------------------------
+
+// pyCase: a draft, a schema document in it and the instances validated
+// against it.
+type pyCase struct {
+	d     draftInfo
+	root  map[string]any
+	insts []any
+}
+
+func instTexts(insts []any) []string {
+	texts := make([]string, len(insts))
+	for i, in := range insts {
+		texts[i] = jsonText(in)
+	}
+	return texts
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c pyCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstances %s", c.d.version, jsonText(c.root), strings.Join(instTexts(c.insts), " "))
+}
+
+// pyCases: a schema of a draft under the options, with instances shaped
+// after it.
+func pyCases(o genOpts) hegel.Generator[pyCase] {
+	return hegel.FlatMap(hegel.SampledFrom(drafts), func(d draftInfo) hegel.Generator[pyCase] {
+		return hegel.FlatMap(schemasOf(d, o), func(root map[string]any) hegel.Generator[pyCase] {
+			return hegel.Map(instancesOf(d, root), func(insts []any) pyCase { return pyCase{d, root, insts} })
+		})
+	})
+}
+
+// Mutations -------------------------------------------------------------------
+
+// damage: one way of breaking a schema against its metaschema: the keyword
+// set and its value, and whether it goes to the root (a node inside
+// const/enum/default is data, not a schema, and $defs entries are compiled
+// lazily, so an unresolvable $ref is only a compile error at the root); the
+// property judges by what.
+type damage struct {
+	what string
+	key  string
+	val  any
+	root bool
+}
+
+var damages = []damage{
+	{"type foo", "type", "foo", false},
+	{"type duplicate", "type", []any{"string", "string"}, false},
+	{"minLength -1", "minLength", num("-1"), false},
+	{"maxItems 1.5", "maxItems", num("1.5"), false},
+	{"pattern invalid", "pattern", "[", true},
+	{"pattern invalid", "pattern", "(", true},
+	{"pattern invalid", "pattern", "*a", true},
+	{"required non-string", "required", []any{num("1")}, false},
+	{"properties array", "properties", []any{}, false},
+	{"multipleOf non-positive", "multipleOf", num("0"), false},
+	{"multipleOf non-positive", "multipleOf", num("-1"), false},
+	{"enum non-array", "enum", "x", false},
+	{"bound string", "minimum", "5", false},
+	{"bound string", "maximum", "5", false},
+	{"$ref unresolvable", "$ref", nil, true}, // the value names the draft's definitions keyword
+	{"applicator number", "allOf", num("1"), false},
+	{"applicator number", "anyOf", num("1"), false},
+	{"applicator number", "oneOf", num("1"), false},
+	{"applicator number", "not", num("1"), false},
+	{"applicator number", "items", num("1"), false},
+	{"uniqueItems string", "uniqueItems", "yes", false},
+	{"additionalProperties array", "additionalProperties", []any{}, false},
+	{"negative count", "minProperties", num("-2"), false},
+	{"negative count", "maxProperties", num("-2"), false},
+	{"negative count", "minItems", num("-2"), false},
+}
+
+// mutation: a damage and the object node it hits: the node-th object of the
+// document in pointer order, modulo their number.
+type mutation struct {
+	dmg  damage
+	node int
+}
+
+var mutations = hegel.Composite(func(tc hegel.TestCase) mutation {
+	return mutation{dmg: hegel.Draw(tc, hegel.SampledFrom(damages)), node: hegel.Draw(tc, hegel.Integers(0, 99))}
+})
+
+// objectNodes collects the object nodes of a document in pointer order.
+func objectNodes(root map[string]any) []map[string]any {
+	var nodes []map[string]any
+	var walk func(v any)
+	walk = func(v any) {
+		switch v := v.(type) {
+		case map[string]any:
+			nodes = append(nodes, v)
+			for _, k := range sortedKeys(v) {
+				walk(v[k])
+			}
+		case []any:
+			for _, x := range v {
+				walk(x)
+			}
+		}
+	}
+	walk(root)
+	return nodes
+}
+
+// apply damages the schema in one place so that it (usually) no longer
+// conforms to its metaschema; it returns a description of the change.
+func (m mutation) apply(root map[string]any, d draftInfo) string {
+	nodes := objectNodes(root)
+	target := nodes[m.node%len(nodes)]
+	if m.dmg.root {
+		target = root
+	}
+	val := m.dmg.val
+	if m.dmg.key == "$ref" {
+		val = "#/" + d.defsKw + "/nope"
+	}
+	target[m.dmg.key] = val
+	return m.dmg.what
+}
