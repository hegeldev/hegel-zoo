+// ---------------------------------------------------------------------------
+// Exact numbers.
+
+var wideNumberPool = []string{
+	"0", "-0", "1", "-1", "2", "0.5", "0.25", "0.1", "0.30000000000000004", "1e2", "1E2", "100e-2",
+	"1e21", "1e22", "1e400", "-1e400", "1e-400", "123456789012345678901234567890", "9007199254740993",
+	"9007199254740992", "18446744073709551616", "-9223372036854775809", "9223372036854775808",
+	"3.0000000000000000001", "1e-7", "0.000001", "2.5e-1", "-0.0", "10", "1.0", "4294967296", "255",
+	"0.125", "1e-2", "3", "7", "12345678901234567890", "1.5", "-2.5",
+}
+
+var wideNumbers = hegel.SampledFrom(wideNumberPool)
+
+func ratOf(text string) *big.Rat {
+	r, ok := new(big.Rat).SetString(text)
+	if !ok {
+		panic("bad number text " + text)
+	}
+	return r
+}
+
+// altForms returns other Go representations of a decimal text that denote
+// exactly the same number (and hence must validate the same way).
+func altForms(text string) []any {
+	r := ratOf(text)
+	var out []any
+	if r.IsInt() {
+		if r.Num().IsInt64() {
+			i := r.Num().Int64()
+			out = append(out, i, int(i))
+			if i >= 0 {
+				out = append(out, uint64(i))
+			}
+			if i >= -128 && i <= 127 {
+				out = append(out, int8(i))
+			}
+		} else if r.Num().IsUint64() {
+			out = append(out, r.Num().Uint64())
+		}
+	}
+	// A float is read as the JSON number it would be written as (its shortest
+	// round-tripping decimal), so float64(1<<64) means 18446744073709552000, not
+	// 2^64 (accepted difference, see README): only floats whose shortest decimal
+	// denotes the exact value are other forms of the same number.
+	if f, err := strconv.ParseFloat(text, 64); err == nil {
+		if fr := new(big.Rat).SetFloat64(f); fr != nil && fr.Cmp(r) == 0 && ratOf(strconv.FormatFloat(f, 'g', -1, 64)).Cmp(r) == 0 {
+			out = append(out, f)
+			if f32 := float32(f); new(big.Rat).SetFloat64(float64(f32)).Cmp(r) == 0 && ratOf(strconv.FormatFloat(float64(f32), 'g', -1, 32)).Cmp(r) == 0 {
+				out = append(out, f32)
+			}
+		}
+	}
+	return out
+}
+
+// forms: every Go representation of a decimal text: the json.Number and its
+// other forms.
+func forms(text string) []any { return append([]any{num(text)}, altForms(text)...) }
+
+// numKeyword: a numeric keyword and its number text(s): none for
+// type: integer, several for enum, one otherwise.
+type numKeyword struct {
+	kw    string
+	texts []string
+}
+
+// value is the keyword's value in the schema.
+func (k numKeyword) value() any {
+	switch k.kw {
+	case "type":
+		return "integer"
+	case "enum":
+		vals := make([]any, len(k.texts))
+		for i, t := range k.texts {
+			vals[i] = num(t)
+		}
+		return vals
+	}
+	return num(k.texts[0])
+}
+
+// check is the keyword's meaning in exact rational arithmetic.
+func (k numKeyword) check() func(v *big.Rat) bool {
+	var b *big.Rat
+	if k.kw != "type" && k.kw != "enum" {
+		b = ratOf(k.texts[0])
+	}
+	switch k.kw {
+	case "minimum":
+		return func(v *big.Rat) bool { return v.Cmp(b) >= 0 }
+	case "maximum":
+		return func(v *big.Rat) bool { return v.Cmp(b) <= 0 }
+	case "exclusiveMinimum":
+		return func(v *big.Rat) bool { return v.Cmp(b) > 0 }
+	case "exclusiveMaximum":
+		return func(v *big.Rat) bool { return v.Cmp(b) < 0 }
+	case "multipleOf":
+		return func(v *big.Rat) bool { return new(big.Rat).Quo(v, b).IsInt() }
+	case "type":
+		return func(v *big.Rat) bool { return v.IsInt() }
+	case "const":
+		return func(v *big.Rat) bool { return v.Cmp(b) == 0 }
+	}
+	rats := make([]*big.Rat, len(k.texts))
+	for i, t := range k.texts {
+		rats[i] = ratOf(t)
+	}
+	return func(v *big.Rat) bool {
+		for _, r := range rats {
+			if r.Cmp(v) == 0 {
+				return true
+			}
+		}
+		return false
+	}
+}
+
+func oneText(kw string) func(t string) numKeyword {
+	return func(t string) numKeyword { return numKeyword{kw, []string{t}} }
+}
+
+// numKeywords: the bounds, a positive multipleOf, type: integer, const and
+// an enum of one to three numbers.
+var numKeywords = hegel.OneOf(
+	hegel.Map(wideNumbers, oneText("minimum")),
+	hegel.Map(wideNumbers, oneText("maximum")),
+	hegel.Map(wideNumbers, oneText("exclusiveMinimum")),
+	hegel.Map(wideNumbers, oneText("exclusiveMaximum")),
+	hegel.Map(wideNumbers, func(t string) numKeyword {
+		if ratOf(t).Sign() <= 0 {
+			t = "0.5"
+		}
+		return numKeyword{"multipleOf", []string{t}}
+	}),
+	hegel.Just(numKeyword{"type", nil}),
+	hegel.Map(wideNumbers, oneText("const")),
+	hegel.Map(hegel.Lists(wideNumbers).MinSize(1).MaxSize(3), func(ts []string) numKeyword { return numKeyword{"enum", ts} }),
+)
+
+// numItem: a number and which of its Go forms (modulo their number) an
+// array carries it in.
+type numItem struct {
+	text string
+	form int
+}
+
+func (it numItem) value() any {
+	fs := forms(it.text)
+	return fs[it.form%len(fs)]
+}
+
+var numItems = hegel.Composite(func(tc hegel.TestCase) numItem {
+	return numItem{text: hegel.Draw(tc, wideNumbers), form: hegel.Draw(tc, hegel.Integers(0, 6))}
+})
+
+// numCase: one to three numeric keywords (a later one replacing an earlier
+// one of the same name), one to four numbers validated in every Go form,
+// and two to twenty-five array items for uniqueItems (the hashed path above
+// twenty items).
+type numCase struct {
+	kws    []numKeyword
+	probes []string
+	items  []numItem
+}
+
+var numCases = hegel.Composite(func(tc hegel.TestCase) numCase {
+	return numCase{
+		kws:    hegel.Draw(tc, hegel.Lists(numKeywords).MinSize(1).MaxSize(3)),
+		probes: hegel.Draw(tc, hegel.Lists(wideNumbers).MinSize(1).MaxSize(4)),
+		items:  hegel.Draw(tc, hegel.Lists(numItems).MinSize(2).MaxSize(25)),
+	}
+})
+
+// schema is the numeric schema and the exact meaning of each of its keywords.
+func (c numCase) schema() (map[string]any, map[string]func(*big.Rat) bool) {
+	s := map[string]any{}
+	checks := map[string]func(*big.Rat) bool{}
+	for _, k := range c.kws {
+		s[k.kw] = k.value()
+		checks[k.kw] = k.check()
+	}
+	return s, checks
+}
+
+// array is the uniqueItems array and whether its numbers are distinct.
+func (c numCase) array() ([]any, bool) {
+	arr := make([]any, len(c.items))
+	rats := make([]*big.Rat, len(c.items))
+	unique := true
+	for i, it := range c.items {
+		arr[i] = it.value()
+		rats[i] = ratOf(it.text)
+		for j := 0; j < i; j++ {
+			if rats[i].Cmp(rats[j]) == 0 {
+				unique = false
+			}
+		}
+	}
+	return arr, unique
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c numCase) GoString() string {
+	s, _ := c.schema()
+	arr, _ := c.array()
+	return fmt.Sprintf("schema %s probes %v array %v", jsonText(s), c.probes, arr)
+}
+
+// TestHegelNumbersAreExact: numeric keywords and equality follow exact
+// rational arithmetic on the decimal texts, for every Go representation of
+// the same number, including magnitudes beyond float64 and int64.
+func TestHegelNumbersAreExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, numCases)
+		s, checks := tcase.schema()
+		schemaText := jsonText(s)
+		sch, err := compileDoc(s, false)
+		if err != nil {
+			ht.Fatalf("numeric schema does not compile: %v\n%s", err, schemaText)
+		}
+		// the same number in every representation
+		for _, text := range tcase.probes {
+			r := ratOf(text)
+			want := true
+			for _, c := range checks {
+				if !c(r) {
+					want = false
+				}
+			}
+			for _, form := range forms(text) {
+				got := sch.Validate(form).IsValid()
+				if got != want {
+					ht.Fatalf("schema %s: %T %v (text %s) valid=%v, exact arithmetic says %v", schemaText, form, form, text, got, want)
+				}
+			}
+		}
+		// uniqueItems over many numbers (the hashed path above 20 items)
+		arr, wantUnique := tcase.array()
+		usch, err := compileDoc(map[string]any{"uniqueItems": true}, false)
+		if err != nil {
+			ht.Fatalf("uniqueItems schema: %v", err)
+		}
+		if got := usch.Validate(arr).IsValid(); got != wantUnique {
+			ht.Fatalf("uniqueItems on %d numbers: valid=%v, exact arithmetic says %v\n%v", len(arr), got, wantUnique, arr)
+		}
+	})
+}
