+package jsonschema_test
+
+// Hegel properties for github.com/kaptinlin/jsonschema: random schemas in
+// drafts 4, 6, 7, 2019-09 and 2020-12 validated against Python's `jsonschema`
+// package (validation results and meta-schema checking), plus library-internal
+// identities: reference transparency, agreement of the input forms, schema
+// serialization round trips, defaults-aware Unmarshal against a model,
+// well-formed output lists, exact-number semantics and the format validators
+// against models of their RFCs.
+//
+// Needs python3 with the `jsonschema` package (4.x) on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	plainNameIDScope       bool // kaptinlin-jsonschema/1: a subschema whose $id/id is a plain-name fragment ("#A", drafts 4-7) is treated as a new resource, so the references inside it do not resolve
+	normalisedKeywordPaths bool // kaptinlin-jsonschema/2: output paths and error keys name the normalised keywords (prefixItems, items, dependentSchemas, dependentRequired) for legacy tuple items, additionalItems and dependencies
+	doubleHashLocation     bool // kaptinlin-jsonschema/3: schemaLocation of a resource whose $id ends in '#' reads "...schema##/..."
+	signedFormatFields     bool // kaptinlin-jsonschema/4: ipv4, time and date-time accept a signed field ("1.1.1.+1", "+1:00:00Z")
+	durationUnitGaps       bool // kaptinlin-jsonschema/5: duration rejects a date part with years and days but no months ("P1Y1D") and a time part with hours and seconds but no minutes ("PT1H1S")
+	bigIntegerKeywords     bool // kaptinlin-jsonschema/6: maxLength/minLength/maxContains/minContains at or above 2^63-512 are misread (maxLength: 9223372036854775807 rejects every string)
+	pointerEscaping        bool // kaptinlin-jsonschema/7: output locations do not escape "~" and "/" in property names ("//" for the property "/")
+
+	refSiblingConst bool // (generator hook, unused here) a const beside $ref in drafts 6 and 7
+}{plainNameIDScope: true, normalisedKeywordPaths: true, doubleHashLocation: true, signedFormatFields: true, durationUnitGaps: true, bigIntegerKeywords: true, pointerEscaping: true}
