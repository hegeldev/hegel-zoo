diff --git a/hegel_defaults_test.go b/hegel_defaults_test.go
new file mode 100644
index 0000000..8fbca1e
--- /dev/null
+++ b/hegel_defaults_test.go
@@ -0,0 +1,207 @@
+package jsonschema_test
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// modelDefaults is what Schema.Unmarshal is documented to do with defaults:
+// a missing property whose schema (or the schema its $ref points to, or one
+// it reaches through allOf/anyOf/oneOf/if/then/else, since the library's
+// applyDefaults walks those) declares a default gets it; present values are
+// kept, objects are descended into through properties, arrays through items.
+// It returns the instance with the defaults applied. The model is
+// deliberately conservative: only local pointer $refs into the root's
+// definitions are followed.
+type defaultsModel struct {
+	root  map[string]any
+	d     draftInfo
+	depth int
+}
+
+func (m *defaultsModel) resolve(s any) map[string]any {
+	obj, ok := s.(map[string]any)
+	if !ok {
+		return nil
+	}
+	if ref, ok := obj["$ref"].(string); ok && m.depth < 20 {
+		m.depth++
+		defer func() { m.depth-- }()
+		target, err := resolveRef(m.root, ref, m.d)
+		if err != nil {
+			return obj
+		}
+		if t, ok := target.(map[string]any); ok {
+			merged := map[string]any{}
+			if m.d.version >= 2019 {
+				for k, v := range obj {
+					if k != "$ref" {
+						merged[k] = v
+					}
+				}
+			}
+			for k, v := range m.resolve(t) {
+				merged[k] = v
+			}
+			return merged
+		}
+	}
+	return obj
+}
+
+// apply fills defaults into value according to schema s.
+func (m *defaultsModel) apply(value any, s any) any {
+	obj := m.resolve(s)
+	if obj == nil {
+		return value
+	}
+	switch v := value.(type) {
+	case map[string]any:
+		out := map[string]any{}
+		for k, x := range v {
+			out[k] = x
+		}
+		props, _ := obj["properties"].(map[string]any)
+		for _, name := range sortedKeys(props) {
+			ps := m.resolve(props[name])
+			if cur, present := out[name]; present {
+				out[name] = m.apply(cur, props[name])
+				continue
+			}
+			if ps != nil {
+				if def, ok := ps["default"]; ok {
+					out[name] = m.apply(deepCopy(def), props[name])
+				}
+			}
+		}
+		return out
+	case []any:
+		items := obj["items"]
+		if _, tuple := items.([]any); tuple {
+			items = nil
+		}
+		if items == nil {
+			return v
+		}
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = m.apply(x, items)
+		}
+		return out
+	}
+	return value
+}
+
+// hasApplicatorDefaults reports whether the schema reaches a default through
+// anything but properties/items/$ref (allOf, anyOf, oneOf, if/then/else,
+// dependentSchemas, patternProperties, additionalProperties, prefixItems,
+// contains, not): the library's behaviour there is not modelled, so such
+// schemas are not judged.
+func hasApplicatorDefaults(v any, inApplicator bool) bool {
+	switch v := v.(type) {
+	case map[string]any:
+		if _, ok := v["default"]; ok && inApplicator {
+			return true
+		}
+		for k, x := range v {
+			switch k {
+			case "properties", "items", "$defs", "definitions":
+				if hasApplicatorDefaults(x, inApplicator) {
+					return true
+				}
+			case "const", "enum", "default", "examples", "$ref", "type", "required", "$schema", "$id", "id", "title", "description", "$anchor", "$dynamicAnchor", "$comment", "pattern", "format":
+			default:
+				if hasApplicatorDefaults(x, true) {
+					return true
+				}
+			}
+		}
+	case []any:
+		for _, x := range v {
+			if hasApplicatorDefaults(x, inApplicator) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// TestHegelUnmarshalAppliesDefaults: Schema.Unmarshal into a map returns the
+// instance with the schema's property defaults filled in (through
+// properties, items and $ref) and nothing else changed; without defaults it
+// is the identity.
+func TestHegelUnmarshalAppliesDefaults(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		d := pickDraft(tc)
+		root := genSchema(tc, d, genOpts{refs: true, uneval: true})
+		if hasApplicatorDefaults(root, false) {
+			return
+		}
+		schemaText := jsonText(root)
+		sch, err := compileDoc(root, false)
+		if err != nil {
+			fail(ht, "schema does not compile: %v\n%s", err, schemaText)
+		}
+		inst := genGuided(tc, root, 3)
+		if _, isObj := inst.(map[string]any); !isObj || chance(tc, 20) {
+			obj := map[string]any{}
+			props, _ := root["properties"].(map[string]any)
+			for _, name := range sortedKeys(props) {
+				if chance(tc, 50) {
+					obj[name] = genGuided(tc, props[name], 2)
+				}
+			}
+			inst = obj
+		}
+		text := jsonText(inst)
+		note(ht, "draft %d schema %s\ninstance %s", d.version, schemaText, text)
+		want := (&defaultsModel{root: root, d: d}).apply(decodeJSON(text), root)
+
+		var got map[string]any
+		if err := sch.Unmarshal(&got, []byte(text)); err != nil {
+			fail(ht, "Unmarshal failed: %v\ninstance %s\nschema %s", err, text, schemaText)
+		}
+		if !reflect.DeepEqual(canonValue(got), canonValue(want)) {
+			fail(ht, "draft %d: Unmarshal gave %s\nmodel says   %s\ninstance %s\nschema %s", d.version, jsonText(got), jsonText(want), text, schemaText)
+		}
+		// the map form of the input gives the same result
+		var got2 map[string]any
+		if err := sch.Unmarshal(&got2, decodeJSON(text)); err != nil {
+			fail(ht, "Unmarshal from a map failed: %v\ninstance %s\nschema %s", err, text, schemaText)
+		}
+		if !reflect.DeepEqual(canonValue(got2), canonValue(got)) {
+			fail(ht, "draft %d: Unmarshal from a map gave %s, from JSON %s\ninstance %s\nschema %s", d.version, jsonText(got2), jsonText(got), text, schemaText)
+		}
+	})
+}
+
+// canonValue normalises a JSON-like value for comparison: numbers by their
+// exact rational text, containers recursively.
+func canonValue(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		out := map[string]any{}
+		for k, x := range v {
+			out[k] = canonValue(x)
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i, x := range v {
+			out[i] = canonValue(x)
+		}
+		return out
+	case json.Number:
+		return canonKey(v)
+	case float64, int, int64, uint64, float32, int32:
+		b, _ := json.Marshal(v)
+		return canonKey(json.Number(strings.TrimSpace(string(b))))
+	}
+	return v
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..96ac5a0
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,816 @@
+package jsonschema_test
+
+// Random schemas and instances. Values use the same Go shapes as
+// jsonschema.UnmarshalJSON produces: nil, bool, json.Number, string, []any,
+// map[string]any. Schemas are valid by construction for their draft (the
+// metaschemas' arity rules are respected) and free of reference cycles.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type draftInfo struct {
+	version int
+	url     string
+	idKw    string // "id" in draft 4, "$id" after
+	defsKw  string // "definitions" up to draft 7, "$defs" after
+}
+
+var drafts = []draftInfo{
+	{4, "http://json-schema.org/draft-04/schema#", "id", "definitions"},
+	{6, "http://json-schema.org/draft-06/schema#", "$id", "definitions"},
+	{7, "http://json-schema.org/draft-07/schema#", "$id", "definitions"},
+	{2019, "https://json-schema.org/draft/2019-09/schema", "$id", "$defs"},
+	{2020, "https://json-schema.org/draft/2020-12/schema", "$id", "$defs"},
+}
+
+func draftByVersion(v int) draftInfo {
+	for _, d := range drafts {
+		if d.version == v {
+			return d
+		}
+	}
+	panic("no such draft")
+}
+
+// jsonText is the canonical text of a value: sorted keys, numbers verbatim.
+func jsonText(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+func num(s string) json.Number { return json.Number(s) }
+
+// Pools ---------------------------------------------------------------------
+
+var numberPool = []string{
+	"0", "1", "-1", "2", "3", "5", "7", "10", "100", "-0", "0.5", "1.5", "-2.5", "0.25", "0.1",
+	"1e2", "1E+2", "2.0", "-0.0", "10.00", "1.0e1", "9007199254740993", "12345678901234567890",
+	"-3", "4", "0.75", "1e-2", "255",
+}
+
+var multiplePool = []string{"1", "2", "3", "0.5", "0.25", "10", "0.125", "100", "5"}
+
+var stringPool = []string{
+	"", "a", "b", "ab", "abc", "\u00e9", "\u65e5\u672c", "a b", "~", "/", "%", "\"", "\\", "\t",
+	" ", "aa", "ba", "12", "x", "AB", "\U0001F600", "aab", "bb", "0", "-1", "true", "null",
+}
+
+var propNamePool = []string{
+	"a", "b", "c", "ab", "~", "/", "%", "\u00e9", " ", "0", "$ref", "", "a/b~c", "\"", "ba", "aa",
+}
+
+var defNamePool = []string{"d0", "d1", "a b", "x/y", "q~", "p%", "\u00fc", "n#", "e?", "s.t", "0", "a~1b", "~0", "-", "$ref"}
+
+var patternPool = []string{
+	"^a", "b$", "^[ab]+$", "\\d", "^.{2}$", "x|y", "^(ab)*$", "[^a]", "^$", "\u00e9", "^\\$", "a.c",
+	"^[a-c]{1,2}$", "\\s", "^\\d+$",
+}
+
+var typeNames = []string{"null", "boolean", "number", "integer", "string", "array", "object"}
+
+// Random instances ----------------------------------------------------------
+
+// numPoolActive is the number pool in use; draft 4 reads "2.0" as a
+// non-integer (a number with a fraction part), so its pool has no integral
+// numbers written with a fraction or exponent.
+var numPoolActive = numberPool
+
+var draft4NumberPool = func() []string {
+	var out []string
+	for _, s := range numberPool {
+		switch s {
+		case "1e2", "1E+2", "2.0", "-0.0", "10.00", "1.0e1":
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}()
+
+func setNumberPool(d draftInfo) {
+	if d.version == 4 {
+		numPoolActive = draft4NumberPool
+	} else {
+		numPoolActive = numberPool
+	}
+}
+
+func genNumber(tc hegel.TestCase) json.Number { return num(pick(tc, numPoolActive...)) }
+
+func genValue(tc hegel.TestCase, depth int) any {
+	k := n(tc, 0, 9)
+	if depth <= 0 && k >= 7 {
+		k = n(tc, 0, 6)
+	}
+	switch k {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2, 3:
+		return genNumber(tc)
+	case 4, 5, 6:
+		return pick(tc, stringPool...)
+	case 7, 8:
+		arr := []any{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			arr = append(arr, genValue(tc, depth-1))
+		}
+		return arr
+	default:
+		obj := map[string]any{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			obj[pick(tc, propNamePool...)] = genValue(tc, depth-1)
+		}
+		return obj
+	}
+}
+
+// genGuided produces an instance shaped after the schema: its const/enum,
+// one of its types, its properties and required names, its prefix items,
+// its numeric bounds. About half of the time it strays.
+func genGuided(tc hegel.TestCase, sch any, depth int) any {
+	s, ok := sch.(map[string]any)
+	if !ok || depth < 0 || chance(tc, 15) {
+		return genValue(tc, depth)
+	}
+	if c, ok := s["const"]; ok && chance(tc, 70) {
+		return c
+	}
+	if e, ok := s["enum"].([]any); ok && len(e) > 0 && chance(tc, 70) {
+		return e[n(tc, 0, len(e)-1)]
+	}
+	if r, ok := s["$ref"]; ok && chance(tc, 50) {
+		_ = r
+		return genValue(tc, depth)
+	}
+	var types []string
+	switch t := s["type"].(type) {
+	case string:
+		types = []string{t}
+	case []any:
+		for _, x := range t {
+			if name, ok := x.(string); ok {
+				types = append(types, name)
+			}
+		}
+	}
+	if len(types) == 0 {
+		// guess from applicators
+		switch {
+		case s["properties"] != nil || s["required"] != nil || s["patternProperties"] != nil || s["additionalProperties"] != nil || s["propertyNames"] != nil:
+			types = []string{"object"}
+		case s["items"] != nil || s["prefixItems"] != nil || s["contains"] != nil || s["minItems"] != nil:
+			types = []string{"array"}
+		case s["minimum"] != nil || s["maximum"] != nil || s["multipleOf"] != nil || s["exclusiveMinimum"] != nil || s["exclusiveMaximum"] != nil:
+			types = []string{"number"}
+		case s["minLength"] != nil || s["maxLength"] != nil || s["pattern"] != nil:
+			types = []string{"string"}
+		default:
+			for _, kw := range []string{"allOf", "anyOf", "oneOf"} {
+				if arr, ok := s[kw].([]any); ok && len(arr) > 0 {
+					return genGuided(tc, arr[n(tc, 0, len(arr)-1)], depth)
+				}
+			}
+			if sub, ok := s["then"]; ok && chance(tc, 50) {
+				return genGuided(tc, sub, depth)
+			}
+			if sub, ok := s["if"]; ok {
+				return genGuided(tc, sub, depth)
+			}
+			return genValue(tc, depth)
+		}
+	}
+	switch pick(tc, types...) {
+	case "null":
+		return nil
+	case "boolean":
+		return chance(tc, 50)
+	case "number", "integer":
+		for _, kw := range []string{"minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"} {
+			if v, ok := s[kw].(json.Number); ok && chance(tc, 35) {
+				return v
+			}
+		}
+		return genNumber(tc)
+	case "string":
+		return pick(tc, stringPool...)
+	case "array":
+		arr := []any{}
+		var prefix []any
+		if p, ok := s["prefixItems"].([]any); ok {
+			prefix = p
+		} else if p, ok := s["items"].([]any); ok {
+			prefix = p
+		}
+		items := s["items"]
+		if _, isArr := items.([]any); isArr {
+			items = s["additionalItems"]
+		}
+		size := n(tc, 0, 4)
+		for i := 0; i < size; i++ {
+			switch {
+			case i < len(prefix):
+				arr = append(arr, genGuided(tc, prefix[i], depth-1))
+			case items != nil && chance(tc, 80):
+				arr = append(arr, genGuided(tc, items, depth-1))
+			case s["contains"] != nil && chance(tc, 50):
+				arr = append(arr, genGuided(tc, s["contains"], depth-1))
+			default:
+				arr = append(arr, genValue(tc, depth-1))
+			}
+		}
+		return arr
+	default:
+		obj := map[string]any{}
+		props, _ := s["properties"].(map[string]any)
+		names := sortedKeys(props)
+		for _, name := range names {
+			if chance(tc, 60) {
+				obj[name] = genGuided(tc, props[name], depth-1)
+			}
+		}
+		if req, ok := s["required"].([]any); ok {
+			for _, r := range req {
+				name, isStr := r.(string)
+				if isStr && chance(tc, 80) {
+					if _, done := obj[name]; !done {
+						if ps, ok := props[name]; ok {
+							obj[name] = genGuided(tc, ps, depth-1)
+						} else {
+							obj[name] = genValue(tc, depth-1)
+						}
+					}
+				}
+			}
+		}
+		for i := n(tc, 0, 2); i > 0; i-- {
+			name := pick(tc, propNamePool...)
+			if _, done := obj[name]; !done {
+				if ap, ok := s["additionalProperties"].(map[string]any); ok && chance(tc, 60) {
+					obj[name] = genGuided(tc, ap, depth-1)
+				} else {
+					obj[name] = genValue(tc, depth-1)
+				}
+			}
+		}
+		return obj
+	}
+}
+
+func sortedKeys(m map[string]any) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// Random schemas ------------------------------------------------------------
+
+// genOpts tunes the schema generator.
+type genOpts struct {
+	refs        bool // $ref / definitions / anchors / embedded ids
+	ids         bool // embedded $id resources (needs refs)
+	uneval      bool // unevaluatedProperties / unevaluatedItems (2019+)
+	refSiblings bool // in drafts <= 7, other keywords beside $ref (which must be ignored)
+	formats     bool // format keyword (asserted by the Go library in drafts <= 7 by default)
+}
+
+type defEntry struct {
+	name   string
+	schema map[string]any
+	refs   []string // ways to reference it from the root resource
+	dyn    bool     // 2020 $dynamicAnchor (referenced with $dynamicRef)
+}
+
+type genCtx struct {
+	d       draftInfo
+	o       genOpts
+	defs    []defEntry
+	refsOK  int  // defs[:refsOK] may be referenced while generating
+	inIDRes bool // generating inside an embedded resource: no refs
+	rootID  bool
+}
+
+// genSchema returns a complete root schema document for the draft.
+func genSchema(tc hegel.TestCase, d draftInfo, o genOpts) map[string]any {
+	g := &genCtx{d: d, o: o}
+	root := map[string]any{"$schema": d.url}
+	if o.refs {
+		ndefs := n(tc, 0, 3)
+		useIDs := o.ids && ndefs > 0 && chance(tc, 50)
+		if useIDs || chance(tc, 30) {
+			root[d.idKw] = "http://example.com/root.json"
+			g.rootID = true
+		}
+		defs := map[string]any{}
+		for i := 0; i < ndefs; i++ {
+			name := pick(tc, defNamePool...)
+			if _, dup := defs[name]; dup {
+				name = fmt.Sprintf("%s%d", name, i)
+			}
+			e := defEntry{name: name}
+			g.refsOK = i
+			withID := useIDs && chance(tc, 50)
+			g.inIDRes = withID
+			e.schema = g.object(tc, 2)
+			g.inIDRes = false
+			ptr := "/" + d.defsKw + "/" + escapeToken(name)
+			e.refs = append(e.refs, "#"+fragmentEscape(ptr))
+			switch {
+			case withID:
+				e.schema[d.idKw] = fmt.Sprintf("sub%d.json", i)
+				// Up to draft 7 a root-level $ref silences the root's $id (the library
+				// follows the letter; Python does not), so only the relative form,
+				// which resolves the same way against either base, is used there.
+				e.refs = []string{fmt.Sprintf("sub%d.json", i)}
+				if d.version >= 2019 {
+					e.refs = append(e.refs, fmt.Sprintf("http://example.com/sub%d.json", i))
+					if chance(tc, 50) {
+						e.refs = append(e.refs, fmt.Sprintf("/sub%d.json", i))
+					}
+				}
+			case chance(tc, 50):
+				anchor := fmt.Sprintf("A%d", i)
+				switch {
+				case d.version == 2020 && chance(tc, 40):
+					e.schema["$dynamicAnchor"] = anchor
+					e.dyn = true
+				case d.version >= 2019:
+					e.schema["$anchor"] = anchor
+				default:
+					_, hasRef := e.schema["$ref"] // an id beside $ref is ignored
+					if !hasRef && Known.plainNameIDScope && containsRef(e.schema) {
+						hasRef = true // the references inside would not resolve (kaptinlin-jsonschema/1)
+					}
+					if !hasRef {
+						e.schema[d.idKw] = "#" + anchor
+					} else {
+						anchor = ""
+					}
+				}
+				if anchor != "" {
+					e.refs = append(e.refs, "#"+anchor)
+				}
+			}
+			defs[name] = e.schema
+			g.defs = append(g.defs, e)
+		}
+		if ndefs > 0 {
+			root[d.defsKw] = defs
+		}
+		g.refsOK = ndefs
+	}
+	for k, v := range g.object(tc, 3) {
+		root[k] = v
+	}
+	return root
+}
+
+// containsRef reports a $ref anywhere inside a schema value.
+func containsRef(v any) bool {
+	switch v := v.(type) {
+	case map[string]any:
+		if _, ok := v["$ref"]; ok {
+			return true
+		}
+		for _, x := range v {
+			if containsRef(x) {
+				return true
+			}
+		}
+	case []any:
+		for _, x := range v {
+			if containsRef(x) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func escapeToken(tok string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(tok, "~", "~0"), "/", "~1")
+}
+
+// fragmentEscape percent-encodes a JSON pointer for use as a URI fragment.
+func fragmentEscape(ptr string) string {
+	u := url.URL{Fragment: ptr}
+	return strings.TrimPrefix(u.String(), "#")
+}
+
+// sub returns a subschema: boolean (drafts >= 6) or an object.
+func (g *genCtx) sub(tc hegel.TestCase, depth int) any {
+	if g.d.version >= 6 && chance(tc, 10) {
+		return chance(tc, 50)
+	}
+	return g.object(tc, depth)
+}
+
+func (g *genCtx) subs(tc hegel.TestCase, depth int, lo, hi int) []any {
+	arr := []any{}
+	for i := n(tc, lo, hi); i > 0; i-- {
+		arr = append(arr, g.sub(tc, depth))
+	}
+	return arr
+}
+
+func (g *genCtx) object(tc hegel.TestCase, depth int) map[string]any {
+	s := map[string]any{}
+	v := g.d.version
+	// $ref first: in drafts <= 7 it silences its siblings.
+	if g.o.refs && !g.inIDRes && g.refsOK > 0 && chance(tc, 25) {
+		e := g.defs[n(tc, 0, g.refsOK-1)]
+		ref := pick(tc, e.refs...)
+		if e.dyn && strings.HasPrefix(ref, "#A") && chance(tc, 60) {
+			s["$dynamicRef"] = ref
+		} else {
+			s["$ref"] = ref
+		}
+		if v < 2019 && !g.o.refSiblings {
+			return s
+		}
+		if v < 2019 && chance(tc, 50) {
+			return s
+		}
+	}
+	nkw := n(tc, 1, 3)
+	if depth <= 0 {
+		nkw = n(tc, 1, 2)
+	}
+	for i := 0; i < nkw; i++ {
+		g.keyword(tc, s, depth)
+	}
+	return s
+}
+
+func (g *genCtx) keyword(tc hegel.TestCase, s map[string]any, depth int) {
+	v := g.d.version
+	k := n(tc, 0, 34)
+	if depth <= 0 && k >= 20 {
+		k = n(tc, 0, 19)
+	}
+	switch k {
+	case 0, 1, 2:
+		if chance(tc, 60) {
+			s["type"] = pick(tc, typeNames...)
+		} else {
+			set := map[string]bool{}
+			var arr []any
+			for i := n(tc, 1, 3); i > 0; i-- {
+				t := pick(tc, typeNames...)
+				if !set[t] {
+					set[t] = true
+					arr = append(arr, t)
+				}
+			}
+			s["type"] = arr
+		}
+	case 3:
+		var arr []any
+		seen := map[string]bool{}
+		for i := n(tc, 1, 4); i > 0; i-- {
+			val := genValue(tc, 1)
+			key := canonKey(val)
+			if !seen[key] {
+				seen[key] = true
+				arr = append(arr, val)
+			}
+		}
+		s["enum"] = arr
+	case 4:
+		if v >= 6 {
+			if _, ok := s["$ref"]; ok && v < 2019 && Known.refSiblingConst {
+				s["type"] = pick(tc, typeNames...)
+			} else {
+				s["const"] = genValue(tc, 1)
+			}
+		} else {
+			s["type"] = pick(tc, typeNames...)
+		}
+	case 5:
+		s["multipleOf"] = num(pick(tc, multiplePool...))
+	case 6, 7:
+		kw := pick(tc, "minimum", "maximum")
+		s[kw] = genNumber(tc)
+		if chance(tc, 40) {
+			if v == 4 {
+				s["exclusive"+strings.Title(kw)] = chance(tc, 70)
+			} else {
+				s["exclusive"+strings.Title(kw)] = genNumber(tc)
+			}
+		}
+	case 8:
+		s[pick(tc, "minLength", "maxLength")] = num(g.count(tc))
+	case 9:
+		s["pattern"] = pick(tc, patternPool...)
+	case 10:
+		s[pick(tc, "minItems", "maxItems")] = num(g.count(tc))
+	case 11:
+		s["uniqueItems"] = chance(tc, 80)
+	case 12:
+		s[pick(tc, "minProperties", "maxProperties")] = num(g.count(tc))
+	case 13, 14:
+		s["required"] = g.names(tc, 1, 3)
+	case 15:
+		if v >= 2019 {
+			m := map[string]any{}
+			for i := n(tc, 1, 2); i > 0; i-- {
+				m[pick(tc, propNamePool...)] = g.names(tc, 0, 2)
+			}
+			s["dependentRequired"] = m
+		} else {
+			m := map[string]any{}
+			for i := n(tc, 1, 2); i > 0; i-- {
+				if chance(tc, 60) {
+					m[pick(tc, propNamePool...)] = g.names(tc, 1, 2)
+				} else {
+					m[pick(tc, propNamePool...)] = g.sub(tc, depth-1)
+				}
+			}
+			s["dependencies"] = m
+		}
+	case 16:
+		if g.o.formats {
+			s["format"] = pick(tc, "date", "ipv4", "uuid", "email", "date-time", "unknown-format")
+		} else {
+			s["title"] = pick(tc, stringPool...)
+		}
+	case 17:
+		s["default"] = genValue(tc, 1)
+	case 18:
+		if v >= 6 {
+			s["propertyNames"] = g.object(tc, 0)
+		} else {
+			s["minProperties"] = num("1")
+		}
+	case 19:
+		if v >= 2019 && chance(tc, 50) {
+			s["$comment"] = "c"
+		}
+		s["description"] = "d"
+	case 20, 21, 22:
+		props := map[string]any{}
+		for i := n(tc, 1, 3); i > 0; i-- {
+			props[pick(tc, propNamePool...)] = g.sub(tc, depth-1)
+		}
+		s["properties"] = props
+	case 23:
+		pp := map[string]any{}
+		for i := n(tc, 1, 2); i > 0; i-- {
+			pp[pick(tc, patternPool...)] = g.sub(tc, depth-1)
+		}
+		s["patternProperties"] = pp
+	case 24:
+		if chance(tc, 50) {
+			s["additionalProperties"] = chance(tc, 50)
+		} else {
+			s["additionalProperties"] = g.sub(tc, depth-1)
+		}
+	case 25, 26:
+		if v >= 2020 {
+			if chance(tc, 50) {
+				s["prefixItems"] = g.subs(tc, depth-1, 1, 3)
+			}
+			if chance(tc, 60) {
+				s["items"] = g.sub(tc, depth-1)
+			}
+		} else if chance(tc, 50) {
+			s["items"] = g.subs(tc, depth-1, 1, 3)
+			if chance(tc, 60) {
+				if chance(tc, 50) {
+					s["additionalItems"] = chance(tc, 50)
+				} else {
+					s["additionalItems"] = g.sub(tc, depth-1)
+				}
+			}
+		} else {
+			s["items"] = g.sub(tc, depth-1)
+		}
+	case 27:
+		if v >= 6 {
+			s["contains"] = g.sub(tc, depth-1)
+			if v >= 2019 {
+				if chance(tc, 50) {
+					s["minContains"] = num(fmt.Sprint(n(tc, 0, 3)))
+				}
+				if chance(tc, 40) {
+					s["maxContains"] = num(fmt.Sprint(n(tc, 0, 3)))
+				}
+				if v == 2019 {
+					delete(s, "unevaluatedItems") // contains and unevaluatedItems do not interact in 2019-09 (accepted difference)
+				}
+			}
+		} else {
+			s["minItems"] = num("1")
+		}
+	case 28, 29:
+		s[pick(tc, "allOf", "anyOf", "oneOf")] = g.subs(tc, depth-1, 1, 3)
+	case 30:
+		s["not"] = g.sub(tc, depth-1)
+	case 31:
+		if v >= 7 {
+			s["if"] = g.sub(tc, depth-1)
+			if chance(tc, 70) {
+				s["then"] = g.sub(tc, depth-1)
+			}
+			if chance(tc, 50) {
+				s["else"] = g.sub(tc, depth-1)
+			}
+		} else {
+			s["not"] = g.sub(tc, depth-1)
+		}
+	case 32:
+		if v >= 2019 {
+			m := map[string]any{}
+			for i := n(tc, 1, 2); i > 0; i-- {
+				m[pick(tc, propNamePool...)] = g.sub(tc, depth-1)
+			}
+			s["dependentSchemas"] = m
+		} else {
+			s["anyOf"] = g.subs(tc, depth-1, 1, 2)
+		}
+	case 33, 34:
+		if v >= 2019 && g.o.uneval {
+			if chance(tc, 50) {
+				if chance(tc, 50) {
+					s["unevaluatedProperties"] = chance(tc, 50)
+				} else {
+					s["unevaluatedProperties"] = g.sub(tc, depth-1)
+				}
+			} else if !(v == 2019 && s["contains"] != nil) {
+				if chance(tc, 50) {
+					s["unevaluatedItems"] = chance(tc, 50)
+				} else {
+					s["unevaluatedItems"] = g.sub(tc, depth-1)
+				}
+			}
+		} else {
+			s["properties"] = map[string]any{pick(tc, propNamePool...): g.sub(tc, depth-1)}
+		}
+	}
+}
+
+// count is a value for a non-negative-integer keyword; beyond int64 only
+// when the wrap-around bug is fixed.
+func (g *genCtx) count(tc hegel.TestCase) string {
+	if !Known.bigIntegerKeywords && chance(tc, 10) {
+		if g.d.version == 4 { // draft 4 reads 1e19 as a non-integer
+			return pick(tc, "9223372036854775808", "18446744073709551616", "9223372036854775807")
+		}
+		return pick(tc, "9223372036854775808", "18446744073709551616", "1e19", "1e30", "9223372036854775807")
+	}
+	return fmt.Sprint(n(tc, 0, 4))
+}
+
+// names returns lo..hi distinct property names.
+func (g *genCtx) names(tc hegel.TestCase, lo, hi int) []any {
+	set := map[string]bool{}
+	var arr []any
+	for i := n(tc, lo, hi); i > 0; i-- {
+		name := pick(tc, propNamePool...)
+		if !set[name] {
+			set[name] = true
+			arr = append(arr, name)
+		}
+	}
+	if arr == nil {
+		arr = []any{}
+	}
+	return arr
+}
+
+// canonKey is a text of a value under which equal JSON values (0 and -0,
+// 1 and 1.0) coincide, for building enums without duplicates.
+func canonKey(v any) string {
+	switch v := v.(type) {
+	case json.Number:
+		if r, ok := new(big.Rat).SetString(string(v)); ok {
+			return "#" + r.RatString()
+		}
+		return string(v)
+	case map[string]any:
+		var sb strings.Builder
+		sb.WriteString("{")
+		for _, k := range sortedKeys(v) {
+			sb.WriteString(strconv.Quote(k) + ":" + canonKey(v[k]) + ",")
+		}
+		return sb.String() + "}"
+	case []any:
+		var sb strings.Builder
+		sb.WriteString("[")
+		for _, x := range v {
+			sb.WriteString(canonKey(x) + ",")
+		}
+		return sb.String() + "]"
+	default:
+		return jsonText(v)
+	}
+}
+
+// deepCopy copies a JSON value.
+func deepCopy(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		m := make(map[string]any, len(v))
+		for k, x := range v {
+			m[k] = deepCopy(x)
+		}
+		return m
+	case []any:
+		a := make([]any, len(v))
+		for i, x := range v {
+			a[i] = deepCopy(x)
+		}
+		return a
+	default:
+		return v
+	}
+}
+
+// mutateSchema damages a valid schema in one place so that it (usually) no
+// longer conforms to its metaschema; it returns a description of the change.
+func mutateSchema(tc hegel.TestCase, root map[string]any, d draftInfo) string {
+	// collect object nodes
+	var nodes []map[string]any
+	var walk func(v any)
+	walk = func(v any) {
+		switch v := v.(type) {
+		case map[string]any:
+			nodes = append(nodes, v)
+			for _, k := range sortedKeys(v) {
+				walk(v[k])
+			}
+		case []any:
+			for _, x := range v {
+				walk(x)
+			}
+		}
+	}
+	walk(root)
+	target := nodes[n(tc, 0, len(nodes)-1)]
+	switch n(tc, 0, 14) {
+	case 0:
+		target["type"] = "foo"
+		return "type foo"
+	case 1:
+		target["type"] = []any{"string", "string"}
+		return "type duplicate"
+	case 2:
+		target["minLength"] = num("-1")
+		return "minLength -1"
+	case 3:
+		target["maxItems"] = num("1.5")
+		return "maxItems 1.5"
+	case 4:
+		// at the root: a node inside const/enum/default is data, not a schema,
+		// and $defs entries are compiled lazily
+		root["pattern"] = pick(tc, "[", "(", "*a")
+		return "pattern invalid"
+	case 5:
+		target["required"] = []any{num("1")}
+		return "required non-string"
+	case 6:
+		target["properties"] = []any{}
+		return "properties array"
+	case 7:
+		target["multipleOf"] = num(pick(tc, "0", "-1"))
+		return "multipleOf non-positive"
+	case 8:
+		target["enum"] = "x"
+		return "enum non-array"
+	case 9:
+		target[pick(tc, "minimum", "maximum")] = "5"
+		return "bound string"
+	case 10:
+		// at the root, which is always compiled ($defs entries are compiled lazily)
+		root["$ref"] = "#/" + d.defsKw + "/nope"
+		return "$ref unresolvable"
+	case 11:
+		target[pick(tc, "allOf", "anyOf", "oneOf", "not", "items")] = num("1")
+		return "applicator number"
+	case 12:
+		target["uniqueItems"] = "yes"
+		return "uniqueItems string"
+	case 13:
+		target["additionalProperties"] = []any{}
+		return "additionalProperties array"
+	default:
+		target[pick(tc, "minProperties", "maxProperties", "minItems")] = num("-2")
+		return "negative count"
+	}
+}
diff --git a/hegel_more_test.go b/hegel_more_test.go
new file mode 100644
index 0000000..7e087b1
--- /dev/null
+++ b/hegel_more_test.go
@@ -0,0 +1,1078 @@
+package jsonschema_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"testing"
+
+	"github.com/kaptinlin/jsonschema"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Output units.
+
+func unescapeToken(tok string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(tok, "~1", "/"), "~0", "~")
+}
+
+// lookupPointer follows a JSON pointer in a value.
+func lookupPointer(v any, ptr string) (any, bool) {
+	if ptr == "" {
+		return v, true
+	}
+	if !strings.HasPrefix(ptr, "/") {
+		return nil, false
+	}
+	for _, tok := range strings.Split(ptr[1:], "/") {
+		tok = unescapeToken(tok)
+		switch cur := v.(type) {
+		case map[string]any:
+			x, ok := cur[tok]
+			if !ok {
+				return nil, false
+			}
+			v = x
+		case []any:
+			i, err := strconv.Atoi(tok)
+			if err != nil || i < 0 || i >= len(cur) || (len(tok) > 1 && tok[0] == '0') {
+				return nil, false
+			}
+			v = cur[i]
+		default:
+			return nil, false
+		}
+	}
+	return v, true
+}
+
+// findAnchor locates the subschema declaring a plain-name anchor in a
+// single-resource document.
+func findAnchor(doc any, anchor string, d draftInfo) (any, bool) {
+	var found any
+	var walk func(v any) bool
+	walk = func(v any) bool {
+		switch v := v.(type) {
+		case map[string]any:
+			if d.version >= 2019 {
+				if v["$anchor"] == anchor || v["$dynamicAnchor"] == anchor {
+					found = v
+					return true
+				}
+			} else if _, hasRef := v["$ref"]; !hasRef && v[d.idKw] == "#"+anchor {
+				found = v
+				return true
+			}
+			for _, k := range sortedKeys(v) {
+				if walk(v[k]) {
+					return true
+				}
+			}
+		case []any:
+			for _, x := range v {
+				if walk(x) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	if walk(doc) {
+		return found, true
+	}
+	return nil, false
+}
+
+// resolveKeywordLocation follows a keywordLocation (a JSON pointer whose
+// $ref-family tokens jump to the referenced schema) in a single-resource
+// document, returning the value it lands on.
+func resolveKeywordLocation(doc any, loc string, d draftInfo) (any, error) {
+	if loc == "" {
+		return doc, nil
+	}
+	if !strings.HasPrefix(loc, "/") {
+		return nil, fmt.Errorf("not a pointer")
+	}
+	cur := doc
+	nameNext := false // the previous token was a keyword whose members are named/indexed subschemas
+	for _, tok := range strings.Split(loc[1:], "/") {
+		tok = unescapeToken(tok)
+		obj, isObj := cur.(map[string]any)
+		isName := nameNext
+		nameNext = false
+		if !isName {
+			switch tok {
+			case "properties", "patternProperties", "$defs", "definitions", "dependentSchemas", "dependencies":
+				nameNext = true // the next token is a property name, whatever it looks like
+			}
+		}
+		switch {
+		case !isName && (tok == "$ref" || tok == "$dynamicRef" || tok == "$recursiveRef"):
+			if !isObj {
+				return nil, fmt.Errorf("%s on a non-object", tok)
+			}
+			ref, ok := obj[tok].(string)
+			if !ok {
+				return nil, fmt.Errorf("no %s here", tok)
+			}
+			target, err := resolveRef(doc, ref, d)
+			if err != nil {
+				return nil, err
+			}
+			cur = target
+		default:
+			switch c := cur.(type) {
+			case map[string]any:
+				x, ok := c[tok]
+				if !ok {
+					return nil, fmt.Errorf("no member %q", tok)
+				}
+				cur = x
+			case []any:
+				i, err := strconv.Atoi(tok)
+				if err != nil || i < 0 || i >= len(c) {
+					return nil, fmt.Errorf("bad index %q", tok)
+				}
+				cur = c[i]
+			default:
+				return nil, fmt.Errorf("cannot descend %q into a scalar", tok)
+			}
+		}
+	}
+	return cur, nil
+}
+
+func resolveRef(doc any, ref string, d draftInfo) (any, error) {
+	if !strings.HasPrefix(ref, "#") {
+		return nil, fmt.Errorf("non-local reference %q", ref)
+	}
+	frag, err := url.PathUnescape(ref[1:])
+	if err != nil {
+		return nil, err
+	}
+	if frag == "" || strings.HasPrefix(frag, "/") {
+		v, ok := lookupPointer(doc, frag)
+		if !ok {
+			return nil, fmt.Errorf("pointer %q not found", frag)
+		}
+		return v, nil
+	}
+	v, ok := findAnchor(doc, frag, d)
+	if !ok {
+		return nil, fmt.Errorf("anchor %q not found", frag)
+	}
+	return v, nil
+}
+
+// The library's output convention (its own, not the specification's): every
+// unit's evaluationPath, schemaLocation and instanceLocation are relative
+// to the enclosing unit; an applicator unit's path is "/<keyword>/<instance
+// key or index>" for the per-member applicators (properties,
+// patternProperties, additionalProperties, propertyNames, items,
+// prefixItems, dependentSchemas, unevaluatedItems) and "/<keyword>/<index>"
+// for allOf/anyOf/oneOf; the subschema reached through $ref/$dynamicRef or
+// through then/else is an intermediate unit with empty paths, named by the
+// parent's error key. checkList follows that convention through a schema
+// document and an instance and reports the first unit that does not fit.
+
+// unitScope is where a unit stands: the (resolved) schema node it evaluates
+// and the instance value it evaluates.
+type unitScope struct {
+	schema any
+	inst   any
+	base   string // URI of the resource the schema node belongs to
+}
+
+// subschemaFor returns the schema node an evaluation path token pair reaches
+// from node, or an error.
+func subschemaFor(node map[string]any, kw, arg string, hasArg bool, inst any, d draftInfo) (any, error) {
+	get := func(key string) (any, error) {
+		v, ok := node[key]
+		if !ok {
+			return nil, fmt.Errorf("no keyword %q here", key)
+		}
+		return v, nil
+	}
+	index := func(v any) (any, error) {
+		arr, ok := v.([]any)
+		if !ok {
+			return nil, fmt.Errorf("%s is not an array", kw)
+		}
+		i, err := strconv.Atoi(arg)
+		if err != nil || i < 0 || i >= len(arr) {
+			return nil, fmt.Errorf("bad index %q into %s", arg, kw)
+		}
+		return arr[i], nil
+	}
+	switch kw {
+	case "properties", "dependentSchemas":
+		if !hasArg {
+			return nil, fmt.Errorf("%s without a name", kw)
+		}
+		v, err := get(kw)
+		if err != nil && kw == "dependentSchemas" && Known.normalisedKeywordPaths {
+			v, err = get("dependencies")
+		}
+		if err != nil {
+			return nil, err
+		}
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("%s is not an object", kw)
+		}
+		s, ok := m[arg]
+		if !ok {
+			return nil, fmt.Errorf("no %s entry %q", kw, arg)
+		}
+		return s, nil
+	case "patternProperties":
+		if !hasArg {
+			return nil, fmt.Errorf("patternProperties without a name")
+		}
+		v, err := get(kw)
+		if err != nil {
+			return nil, err
+		}
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("patternProperties is not an object")
+		}
+		for _, pat := range sortedKeys(m) {
+			if re, err := regexp.Compile(pat); err == nil && re.MatchString(arg) {
+				return m[pat], nil
+			}
+		}
+		return nil, fmt.Errorf("no pattern matches %q", arg)
+	case "additionalProperties", "propertyNames", "unevaluatedItems", "items":
+		if kw == "items" {
+			v, err := get("items")
+			if err != nil {
+				return nil, err
+			}
+			if arr, isTuple := v.([]any); isTuple {
+				if d.version < 2020 && Known.normalisedKeywordPaths {
+					// legacy tuple: "items/<i>" names additionalItems
+					if ai, ok := node["additionalItems"]; ok {
+						return ai, nil
+					}
+					_ = arr
+					return nil, fmt.Errorf("items/%s beyond the tuple without additionalItems", arg)
+				}
+				return index(v)
+			}
+			return v, nil
+		}
+		if !hasArg && kw != "propertyNames" && kw != "additionalProperties" {
+			return get(kw)
+		}
+		return get(kw)
+	case "prefixItems":
+		v, err := get("prefixItems")
+		if err != nil && d.version < 2020 && Known.normalisedKeywordPaths {
+			v, err = get("items")
+		}
+		if err != nil {
+			return nil, err
+		}
+		return index(v)
+	case "allOf", "anyOf", "oneOf":
+		v, err := get(kw)
+		if err != nil {
+			return nil, err
+		}
+		return index(v)
+	case "not", "contains", "if", "unevaluatedProperties", "contentSchema", "then", "else", "additionalItems":
+		if hasArg {
+			return nil, fmt.Errorf("%s with an argument %q", kw, arg)
+		}
+		return get(kw)
+	}
+	return nil, fmt.Errorf("unknown applicator %q", kw)
+}
+
+// checkList checks one unit and, recursively, its details.
+func checkList(u *jsonschema.List, parent unitScope, doc any, d draftInfo, path string, mustFail bool) error {
+	if mustFail && u.Valid {
+		return fmt.Errorf("%s: valid=true in a failing output", path)
+	}
+	if Known.pointerEscaping {
+		if m, isObj := parent.inst.(map[string]any); isObj {
+			for k := range m {
+				if strings.ContainsAny(k, "/~") {
+					return nil // the locations below are not JSON pointers (kaptinlin-jsonschema/7); nothing to follow
+				}
+			}
+		}
+	}
+	inst, ok := lookupPointer(parent.inst, u.InstanceLocation)
+	if !ok {
+		return fmt.Errorf("%s: instanceLocation %q does not resolve in the enclosing instance %s", path, u.InstanceLocation, jsonText(parent.inst))
+	}
+	node := parent.schema
+	base := parent.base
+	evalPath := u.EvaluationPath
+	if dec, err := url.PathUnescape(evalPath); err == nil {
+		evalPath = dec
+	}
+	if evalPath != "" {
+		if !strings.HasPrefix(evalPath, "/") {
+			return fmt.Errorf("%s: evaluationPath %q is not a pointer", path, u.EvaluationPath)
+		}
+		toks := strings.Split(evalPath[1:], "/")
+		if len(toks) > 2 {
+			return fmt.Errorf("%s: evaluationPath %q has more than two tokens", path, u.EvaluationPath)
+		}
+		obj, isObj := node.(map[string]any)
+		if !isObj {
+			return fmt.Errorf("%s: evaluationPath %q under a non-object schema %s", path, u.EvaluationPath, jsonText(node))
+		}
+		arg, hasArg := "", false
+		if len(toks) == 2 {
+			arg, hasArg = unescapeToken(toks[1]), true
+		}
+		sub, err := subschemaFor(obj, unescapeToken(toks[0]), arg, hasArg, inst, d)
+		if err != nil {
+			return fmt.Errorf("%s: evaluationPath %q does not fit the schema %s: %v", path, u.EvaluationPath, jsonText(obj), err)
+		}
+		node = sub
+		// the schema location: <base>#<fragment>, the fragment ending in the path
+		if u.SchemaLocation == "" {
+			return fmt.Errorf("%s: empty schemaLocation with evaluationPath %q", path, u.EvaluationPath)
+		}
+		i := strings.Index(u.SchemaLocation, "#")
+		if i < 0 {
+			return fmt.Errorf("%s: schemaLocation %q has no fragment", path, u.SchemaLocation)
+		}
+		if strings.Contains(u.SchemaLocation, "##") && !Known.doubleHashLocation {
+			return fmt.Errorf("%s: schemaLocation %q has a double hash", path, u.SchemaLocation)
+		}
+		frag := strings.TrimPrefix(u.SchemaLocation[i:], "#")
+		frag = strings.TrimPrefix(frag, "#")
+		if fd, err := url.PathUnescape(frag); err == nil {
+			frag = fd
+		}
+		if !strings.HasSuffix(frag, evalPath) {
+			return fmt.Errorf("%s: schemaLocation %q does not end in the evaluationPath %q", path, u.SchemaLocation, u.EvaluationPath)
+		}
+		base = u.SchemaLocation[:i]
+	} else if u.SchemaLocation != "" {
+		return fmt.Errorf("%s: schemaLocation %q with an empty evaluationPath", path, u.SchemaLocation)
+	}
+	if !u.Valid && len(u.Errors) == 0 && len(u.Details) == 0 {
+		return fmt.Errorf("%s: invalid unit with neither errors nor details", path)
+	}
+	for k, msg := range u.Errors {
+		if msg == "" {
+			return fmt.Errorf("%s: empty message for %s", path, k)
+		}
+	}
+	// where do the details stand? an intermediate unit (empty path) evaluates
+	// the $ref target or a then/else branch, whether or not it failed
+	for i := range u.Details {
+		child := &u.Details[i]
+		childPath := fmt.Sprintf("%s/details/%d", path, i)
+		if child.EvaluationPath != "" {
+			if err := checkList(child, unitScope{schema: node, inst: inst, base: base}, doc, d, childPath, false); err != nil {
+				return err
+			}
+			continue
+		}
+		var candidates []any
+		if obj, ok := node.(map[string]any); ok {
+			for _, kw := range []string{"$ref", "$dynamicRef", "$recursiveRef"} {
+				if ref, ok := obj[kw].(string); ok {
+					if target, err := resolveRef(doc, ref, d); err == nil {
+						candidates = append(candidates, target)
+					} else if !strings.HasPrefix(ref, "#") {
+						candidates = nil // an embedded resource: not followed
+						break
+					}
+				}
+			}
+			for _, kw := range []string{"then", "else", "if"} {
+				if sub, ok := obj[kw]; ok {
+					candidates = append(candidates, sub)
+				}
+			}
+		}
+		if len(candidates) == 0 {
+			continue // an embedded resource or nothing to compare against
+		}
+		var firstErr error
+		fits := false
+		for _, cand := range candidates {
+			err := checkList(child, unitScope{schema: cand, inst: inst, base: base}, doc, d, childPath, false)
+			if err == nil {
+				fits = true
+				break
+			}
+			if firstErr == nil {
+				firstErr = err
+			}
+		}
+		if !fits {
+			return firstErr
+		}
+	}
+	return nil
+}
+
+// TestHegelOutputsAreWellFormed: for a failing validation the flag and the
+// hierarchical list are consistent under the library's output convention:
+// the root is invalid, every unit's instance location resolves in the
+// enclosing instance, its evaluation path names an applicator of the
+// enclosing schema (with the instance key or index the library appends) and
+// its schema location ends in that path, invalid units carry errors or
+// details, messages are not empty, the flat list marshals and
+// DetailedErrors is not empty.
+func TestHegelOutputsAreWellFormed(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		d := pickDraft(tc)
+		root := genSchema(tc, d, genOpts{refs: true, uneval: true, refSiblings: true})
+		doc := reparse(root)
+		sch, err := compileDoc(root, false)
+		if err != nil {
+			fail(ht, "schema does not compile: %v\n%s", err, jsonText(root))
+		}
+		for _, inst := range genInstances(tc, root) {
+			text := jsonText(inst)
+			inst = decodeJSON(text)
+			res := sch.ValidateJSON([]byte(text))
+			if res.IsValid() {
+				continue
+			}
+			if res.ToFlag().Valid {
+				fail(ht, "ToFlag valid for a failing validation")
+			}
+			list := res.ToList(true)
+			if _, err := json.Marshal(list); err != nil {
+				fail(ht, "hierarchical list does not marshal: %v", err)
+			}
+			if _, err := json.Marshal(res.ToList(false)); err != nil {
+				fail(ht, "flat list does not marshal: %v", err)
+			}
+			if err := checkList(list, unitScope{schema: doc, inst: inst, base: rootURL}, doc, d, "list", true); err != nil {
+				b, _ := json.MarshalIndent(list, "", " ")
+				fail(ht, "draft %d: %v\ninstance %s\nschema %s\noutput %s", d.version, err, text, jsonText(root), b)
+			}
+			if len(res.DetailedErrors()) == 0 {
+				fail(ht, "draft %d: DetailedErrors is empty for a failing validation\ninstance %s\nschema %s\n%s", d.version, text, jsonText(root), describeResult(res))
+			}
+		}
+	})
+}
