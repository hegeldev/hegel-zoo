+		return call(name, ellipticBeyond)
+	}))
+}
+
+// --------------------------------------------------------------------------- gonum/9
+
+// digammaZero: Digamma within 0.3 of its zero at 1.4616..., in thousandths, where relative
+// accuracy is hardest (the value is small, the absolute error of 3e-11 is not; measured: off
+// by 1.2e-10 to 1.4e-8 relative throughout, the strict tolerance being 1e-10); past the
+// shape, x in [3, 20] (within 6e-11 relative, inside the tolerance).
+var digammaZero = tuple(shaped(
+	hegel.Map(ints(-300, 300), func(k int) float64 { return 1.4616 + float64(k)/1000 }),
+	hegel.Map(ints(0, 1700), func(k int) float64 { return 3 + float64(k)/100 }),
+))
