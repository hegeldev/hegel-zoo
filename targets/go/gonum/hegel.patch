+// --------------------------------------------------------------------------- the functions
+
+// mathSpec is one real function of mathext: its argument generator, the call and the
+// relative tolerance it is judged at.
+type mathSpec struct {
+	name string
+	args hegel.Generator[[]float64]
+	call func(a []float64) float64
+	rtol float64
+}
+
+// mathSpecs: the 21 functions, each with its plain arguments and, where it has recorded
+// bugs, their shape regions one time in five (known). Digamma comes first: its precision
+// shape (gonum/9) is the simplest deterministic failure, so the shrinker of TestHegelMathext
+// lands there whatever it met first; NormalQuantile second, the most drawn index of a
+// SampledFrom table, has no recorded bug.
+var mathSpecs = []mathSpec{
+	{"Digamma", known(tuple(specialOrNumber), hegel.OneOf(digammaZero, digammaNextToPole)), func(a []float64) float64 { return mathext.Digamma(a[0]) }, 1e-10},
+	{"NormalQuantile", tuple(probOrBad), func(a []float64) float64 { return mathext.NormalQuantile(a[0]) }, 1e-10},
+	{"Beta", tuple(specialOrNumber, specialOrNumber), func(a []float64) float64 { return mathext.Beta(a[0], a[1]) }, 1e-10},
+	{"Lbeta", known(tuple(specialOrNumber, specialOrNumber), lbetaLarge), func(a []float64) float64 { return mathext.Lbeta(a[0], a[1]) }, 1e-10},
+	{"RegIncBeta", known(tuple(shapeOrBad, shapeOrBad, probOrBad), regBetaTinyB), func(a []float64) float64 { return mathext.RegIncBeta(a[0], a[1], a[2]) }, 1e-10},
+	{"InvRegIncBeta", known(tuple(shapeOrBad, shapeOrBad, invBetaY), hegel.OneOf(invBetaNearOne, invBetaChecks)), func(a []float64) float64 { return mathext.InvRegIncBeta(a[0], a[1], a[2]) }, 1e-8},
+	{"GammaIncReg", known(tuple(shapeOrBad, nonNegOrBad), gammaIncRegChecks), func(a []float64) float64 { return mathext.GammaIncReg(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegComp", tuple(shapeOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.GammaIncRegComp(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegInv", known(tuple(shapeOrBad, probOrBad), gammaIncInvTiny), func(a []float64) float64 { return mathext.GammaIncRegInv(a[0], a[1]) }, 1e-9},
+	{"GammaIncRegCompInv", known(tuple(shapeOrBad, probOrBad), gammaIncCompInvNearOne), func(a []float64) float64 { return mathext.GammaIncRegCompInv(a[0], a[1]) }, 1e-9},
+	{"Zeta", known(tuple(zetaExponents, zetaOffsets), hegel.OneOf(zetaHuge, zetaNegativeQ)), func(a []float64) float64 { return mathext.Zeta(a[0], a[1]) }, 1e-10},
+	{"Hypergeo", known(tuple(hypParameters, hypParameters, hypC, hypZ), hegel.OneOf(hypergeoSpecialPoints, hypergeoNearOne)), func(a []float64) float64 { return mathext.Hypergeo(a[0], a[1], a[2], a[3]) }, 1e-9},
+	{"MvLgamma", tuple(numbers, dimensions), func(a []float64) float64 { return mathext.MvLgamma(a[0], int(a[1])) }, 1e-10},
+	{"CompleteK", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteK(a[0]) }, 1e-10},
+	{"CompleteE", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteE(a[0]) }, 1e-10},
+	{"CompleteB", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteB(a[0]) }, 1e-10},
+	{"CompleteD", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteD(a[0]) }, 1e-10},
+	{"EllipticF", known(tuple(amplitudes, probabilities), ellipticBeyond), func(a []float64) float64 { return mathext.EllipticF(a[0], a[1]) }, 1e-10},
+	{"EllipticE", known(tuple(amplitudes, probabilities), ellipticBeyond), func(a []float64) float64 { return mathext.EllipticE(a[0], a[1]) }, 1e-10},
+	{"EllipticRF", tuple(nonNegOrBad, nonNegOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.EllipticRF(a[0], a[1], a[2]) }, 1e-10},
+	{"EllipticRD", tuple(nonNegOrBad, nonNegOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.EllipticRD(a[0], a[1], a[2]) }, 1e-10},
