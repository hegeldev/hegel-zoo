+		choice[float64]{unless(noKnown, 45), hypTameNonPositive},
+		choice[float64]{unless(noKnown, 10), hypWild},
+	)
+	hypZTame = weighted(
+		choice[float64]{81, scaled(ints(-899, 989), 1e-3)},
+		choice[float64]{19, pick(0.0, math.Copysign(0, -1), 0.5, -0.5)},
+	)
+	hypZWild = weighted(
+		choice[float64]{13, pick(1.0, -1.0)},
+		choice[float64]{40, hegel.Map(nonNegatives, func(v float64) float64 { return -1 - v })},
+		choice[float64]{40, scaled(ints(900, 1000), -1e-3)},
+		choice[float64]{7, hegel.OneOf(scaled(ints(990, 999), 1e-3), scaled(ints(-999, -900), 1e-3))},
+	)
+	hypZ = weighted(choice[float64]{58, hypZTame}, choice[float64]{unless(noKnown, 42), hypZWild})
