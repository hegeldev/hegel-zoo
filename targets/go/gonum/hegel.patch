+var digammaNextToPole = tuple(shaped(
+	hegel.Map(counts(ints(1, 200), ints(7, 11)), func(v []int) float64 { return -float64(v[0]) + pow10(-v[1]) }),
+	hegel.Map(counts(ints(1, 200), ints(1, 9), ints(0, 1)), func(v []int) float64 { return -float64(v[0]) + float64(2*v[2]-1)*float64(v[1])/100 }),
+))
+
+func TestHegelDigammaNextToANegativePole(t *testing.T) { narrow(t, call("Digamma", digammaNextToPole)) }
+
+// --------------------------------------------------------------------------- gonum/11
+
+// nonPositives: 0 or a negative number.
+var nonPositives = hegel.OneOf(hegel.Just(0.0), negatives)
+
+// ends: the end points of the unit interval.
+var ends = pick(0.0, 1.0)
+
+// interior: y in (0, 1) in thousandths.
+var interior = scaled(ints(1, 999), 1e-3)
+
+// invBetaChecks: InvRegIncBeta at y = 0 or 1 with a nonpositive a or b, where the documented
+// panic does not happen; past the shape, the same parameters at a y inside (0, 1), where it
+// does (y = 0 or 1 with valid parameters is hzInvBetaBad's region, so not the neighbour here).
+var invBetaChecks = hegel.OneOf(
+	tuple(nonPositives, shapes, shaped(ends, interior)),
+	tuple(shapes, nonPositives, shaped(ends, interior)),
+)
+
+// gammaIncRegChecks: GammaIncReg at x = 0 with a nonpositive a, where the documented panic
+// does not happen; past the shape, at an x inside (0, 1), where it does.
+var gammaIncRegChecks = tuple(nonPositives, shaped(hegel.Just(0.0), interior))
+
+// argumentChecks: the two, InvRegIncBeta two times in three.
+var argumentChecks = weighted(
+	choice[mathCase]{2, call("InvRegIncBeta", invBetaChecks)},
+	choice[mathCase]{1, call("GammaIncReg", gammaIncRegChecks)},
+)
+
+func TestHegelInverseIncompleteArgumentChecks(t *testing.T) { narrow(t, argumentChecks) }
+
+// --------------------------------------------------------------------------- gonum/12
+
+// zetaArguments: Zeta(m 10^e, q) with m to 999, e in the range and q > 1.
+func zetaArguments(eLo, eHi int) hegel.Generator[[]float64] {
+	return tuple(
+		hegel.Map(counts(ints(1, 999), ints(eLo, eHi)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) }),
+		hegel.Map(shapes, func(s float64) float64 { return 1 + s }),
+	)
+}
+
+// zetaHuge: x of 1e14 and beyond (measured: NaN where the sum is 0; 1e13 is still 0); past
+// the shape, x in [10, 1e12).
+var zetaHuge = shaped(zetaArguments(14, 100), zetaArguments(1, 9))
+
+func TestHegelZetaHugeExponent(t *testing.T) { narrow(t, call("Zeta", zetaHuge)) }
+
+// --------------------------------------------------------------------------- gonum/13
+
+// zetaCancelling: Zeta(x, -n - 1/2) for n to 20 and an odd x with (2n + 1)^x >= 1e9 (the
+// terms at k = n and n + 1 cancel; measured: off by 1e-8 at (2n + 1)^x = 1e9, by everything
+// from 1e13), x to 41.
+var zetaCancelling = hegel.FlatMap(ints(1, 20), func(n int) hegel.Generator[[]float64] {
+	least := int(math.Ceil(9 / math.Log10(float64(2*n+1)))) // the least x with (2n + 1)^x >= 1e9
+	return hegel.Map(ints(least/2, 20), func(j int) []float64 { return []float64{float64(2*j + 1), -float64(n) - 0.5} })
+})
+
+// zetaOverflowing: Zeta(x, -k/4) for an odd x in [2501, 5001] (measured: NaN where the sum is
+// 0 or infinite).
+var zetaOverflowing = hegel.Map(counts(ints(1250, 2500), ints(1, 3)), func(v []int) []float64 {
+	return []float64{float64(2*v[0] + 1), -float64(v[1]) / 4}
+})
+
+// zetaNegativeQ: those two shapes; past them, Zeta(x, n + d/10) for x in 3..22 and a
+// positive q to 12.9 (every negative q is the shape by the classifier's predicate; measured:
+// a negative q off the half, where no two terms cancel, is exact to 1e-12 too).
+var zetaNegativeQ = shaped(
+	weighted(choice[[]float64]{3, zetaCancelling}, choice[[]float64]{1, zetaOverflowing}),
+	hegel.Map(counts(ints(3, 22), ints(0, 12), ints(1, 9)), func(v []int) []float64 {
+		return []float64{float64(v[0]), float64(v[1]) + tenths(v[2])}
+	}),
+)
+
+func TestHegelZetaNegativeQ(t *testing.T) { narrow(t, call("Zeta", zetaNegativeQ)) }
