+	tuple(scaled(ints(6, 60), 0.01), hegel.Map(ints(11, 15), func(e int) float64 { return pow10(-e) })),
+	tuple(scaled(ints(10, 50), 0.1), hegel.Map(ints(2, 6), func(e int) float64 { return pow10(-e) })),
+)
+
+func TestHegelGammaIncRegInvTinyAnswers(t *testing.T) {
+	narrow(t, call("GammaIncRegInv", gammaIncInvTiny))
+}
+
+// --------------------------------------------------------------------------- gonum/5
+
+// gammaIncCompInvNearOne: GammaIncRegCompInv(a, 1 - 10^-e) with e in 8..12 and
+// a (1 - y) = p 10^-11 for p in 50..200 (measured: off by 1e-8 to 2e-7 relative at
