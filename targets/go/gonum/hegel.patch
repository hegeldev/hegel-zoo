+// hzGenX draws the argument of a distribution method: a point of the support, a generated
+// number, or for a discrete distribution an integer.
+func hzGenX(tc hegel.TestCase, d hzDistSpec, p []float64) float64 {
+	switch hzDrawInt(tc, 0, 3) {
+	case 0:
+		return hzPick(tc, d.points(p))
+	case 1:
