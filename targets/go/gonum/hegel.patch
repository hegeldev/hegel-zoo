+def refine(fn, x0, scale):
+    # polish a SciPy inverse of a positive quantity with mpmath's secant solver in log space (so
+    # that its steps scale with x0; the default first step of 0.25 is useless for x0 = 1e-26); the
+    # result must reproduce y to 1e-12 relative, else None
+    try:
+        u = mp.findroot(lambda u: fn(mp.exp(u)), mp.log(mp.mpf(x0)), tol=mp.mpf(10) ** -28, maxsteps=60, verify=False)
+        r = mp.exp(u)
+        if not abs(fn(r)) <= mp.mpf(10) ** -12 * scale:
