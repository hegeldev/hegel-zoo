+++ b/hegel/hegel_zoo_shapes_mathext_test.go
@@ -0,0 +1,303 @@
+package hegel
+
+// The shape regions of the recorded mathext bugs (bugs.toml gonum/1..13) and the narrow
+// properties over them: each region is a generator over the bug's shape with random contents,
+// judged exactly like the wide property (judgeMath: the oracle, the strict tolerance, the
+// classifier naming the shape). Every narrow property fails every run by default; under
+// HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead (shaped(shape,
+// past)) and the property passes. The wide property TestHegelMathext draws the same regions
+// one time in five by default (known) and never under HEGEL_NO_KNOWN=1. The edges of the
+// regions were measured against the oracle at the strict tolerance; the comments quote them.
+
+import (
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// call is the function applied to the drawn arguments: the case the report shows.
+func call(name string, args hegel.Generator[[]float64]) hegel.Generator[mathCase] {
+	s := mathSpecOf(name)
+	return hegel.Map(args, func(a []float64) mathCase { return mathCase{s, a} })
+}
+
+// pow10 is 10^e.
+func pow10(e int) float64 { return math.Pow(10, float64(e)) }
+
+// tenths is k/10.
+func tenths(k int) float64 { return float64(k) / 10 }
+
+// narrow runs a narrow property: every drawn case through the wide property's judge.
+func narrow(t *testing.T, cases hegel.Generator[mathCase]) {
+	o := hzStartOracle(t, hzOracleMathext)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeMath(ht, o, c, hegel.Draw(ht, cases))
+	})
+}
+
+// --------------------------------------------------------------------------- gonum/1
+
+// gaussParameters: a and b in tenths to 5 either side, c = max(a + b, 0) + s with s in
+// (0, 5]: c positive and c - a - b > 0, where 2F1(a, b; c; 1) is Gauss's finite sum.
+var gaussParameters = hegel.Map(counts(ints(-50, 50), ints(-50, 50), ints(1, 50)), func(v []int) []float64 {
+	a, b := tenths(v[0]), tenths(v[1])
+	return []float64{a, b, math.Max(a+b, 0) + tenths(v[2])}
+})
+
+// offTheIntegers is (2k + 1)/20: tenths shifted off every integer (a nonpositive integer a
+// or b terminates the series and sidesteps the pole in c).
+var offTheIntegers = hegel.Map(ints(-50, 49), func(k int) float64 { return float64(2*k+1) / 20 })
+
+// hypergeoSpecialPoints: 2F1 at z = 1 with c - a - b > 0 (finite: gonum is NaN) and at z = 0
+// with a negative integer c (the series is 1 there: gonum is +Inf). Past the shape: the same
+// parameters with a positive c and |z| <= 1/2.
+var hypergeoSpecialPoints = shaped(
+	weighted(
+		choice[[]float64]{1, hegel.Map(gaussParameters, func(p []float64) []float64 { return []float64{p[0], p[1], p[2], 1} })},
+		choice[[]float64]{1, tuple(offTheIntegers, offTheIntegers, scaled(ints(-10, -1), 1), hegel.Just(0.0))},
+	),
+	hegel.FlatMap(gaussParameters, func(p []float64) hegel.Generator[[]float64] {
+		return hegel.Map(ints(-500, 500), func(k int) []float64 { return []float64{p[0], p[1], p[2], float64(k) / 1000} })
+	}),
+)
+
+func TestHegelHypergeoIsDefinedAtItsSpecialPoints(t *testing.T) {
+	narrow(t, call("Hypergeo", hypergeoSpecialPoints))
+}
+
+// --------------------------------------------------------------------------- gonum/2
+
+// divergingParameters: a positive c in tenths and a, b = c + s - a off the tenths (never c,
+// never an integer) with c - a - b = -s an integer in [-4, -1]: 2F1 has a pole of that order
+// at z = 1 and cephes has no transformation for an integer c - a - b (measured: gonum loses
+// from 2e-9 at z = 0.998 to everything at z = 0.99999, and is exact to 1e-14 up to z = 0.989;
+// a fractional c - a - b is exact up to z = 0.99999).
+var divergingParameters = hegel.FlatMap(counts(ints(1, 50), ints(1, 4)), func(v []int) hegel.Generator[[]float64] {
+	k, s := v[0], v[1] // c = k/10, a + b = c + s
+	return hegel.Map(ints(0, k+10*s-1), func(j int) []float64 {
+		a, c := float64(2*j+1)/20, tenths(k)
+		return []float64{a, c + float64(s) - a, c}
+	})
+})
+
+// hypergeoNearOne: those parameters at z = 1 - k/100000 (z in [0.999, 0.99999]); past the
+// shape, at z = k/1000 in [0.9, 0.989].
+var hypergeoNearOne = hegel.FlatMap(divergingParameters, func(p []float64) hegel.Generator[[]float64] {
+	return shaped(
+		hegel.Map(ints(1, 100), func(k int) []float64 { return []float64{p[0], p[1], p[2], 1 - float64(k)*1e-5} }),
+		hegel.Map(ints(900, 989), func(k int) []float64 { return []float64{p[0], p[1], p[2], float64(k) / 1000} }),
+	)
+})
+
+func TestHegelHypergeoNearTheUnitPoint(t *testing.T) { narrow(t, call("Hypergeo", hypergeoNearOne)) }
+
+// --------------------------------------------------------------------------- gonum/3
+
+// betaArguments: a = m 10^e for m to 99 and e in the range; b in thousandths to 1 or tenths
+// to 100.
+func betaArguments(eLo, eHi int) hegel.Generator[[]float64] {
+	return tuple(
+		hegel.Map(counts(ints(1, 99), ints(eLo, eHi)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) }),
+		hegel.OneOf(scaled(ints(1, 999), 1e-3), scaled(ints(1, 1000), 0.1)),
+	)
+}
+
+// lbetaLarge: Lbeta with a in [1e9, 1e14) (measured: off by 2e-10 relative at 1e8 - where
+// one case in 300 still rounds right - by 1e-8 at 1e9, 1e-6 at 1e12, 0 from 1e20); past the
+// shape, a below 1e4 (exact to 1e-11).
+var lbetaLarge = shaped(betaArguments(9, 12), betaArguments(0, 2))
+
+func TestHegelLbetaWithALargeArgument(t *testing.T) { narrow(t, call("Lbeta", lbetaLarge)) }
+
+// --------------------------------------------------------------------------- gonum/4
+
+// gammaIncInvTiny: GammaIncRegInv(a, 10^-e) with a in [0.06, 0.6] and e in 11..15, where
+// the answer is below 1e-18 and representable (gonum returns 0); past the shape, a in [1, 5]
+// with e in 2..6.
+var gammaIncInvTiny = shaped(
+	tuple(scaled(ints(6, 60), 0.01), hegel.Map(ints(11, 15), func(e int) float64 { return pow10(-e) })),
+	tuple(scaled(ints(10, 50), 0.1), hegel.Map(ints(2, 6), func(e int) float64 { return pow10(-e) })),
+)
+
+func TestHegelGammaIncRegInvTinyAnswers(t *testing.T) {
+	narrow(t, call("GammaIncRegInv", gammaIncInvTiny))
+}
+
+// --------------------------------------------------------------------------- gonum/5
+
+// gammaIncCompInvNearOne: GammaIncRegCompInv(a, 1 - 10^-e) with e in 8..12 and
+// a (1 - y) = p 10^-11 for p in 50..200 (measured: off by 1e-8 to 2e-7 relative at
+// a (1 - y) = 1e-9, the strict tolerance being 1e-9; at 1e-8 one case in 30 is still within
+// it); past the shape, e in 2..3 with a = p 10^j in [0.05, 2000].
+var gammaIncCompInvNearOne = shaped(
+	hegel.Map(counts(ints(8, 12), ints(50, 200)), func(v []int) []float64 {
+		return []float64{float64(v[1]) * pow10(v[0]-11), 1 - pow10(-v[0])}
+	}),
+	hegel.Map(counts(ints(2, 3), ints(50, 200), ints(-3, 1)), func(v []int) []float64 {
+		return []float64{float64(v[1]) * pow10(v[2]), 1 - pow10(-v[0])}
+	}),
+)
+
+func TestHegelGammaIncRegCompInvNearOne(t *testing.T) {
+	narrow(t, call("GammaIncRegCompInv", gammaIncCompInvNearOne))
+}
+
+// --------------------------------------------------------------------------- gonum/6
+
+// invBetaArguments: InvRegIncBeta(a, b, 1 - 10^-e) with a in tenths to 1, b an integer in
+// [100, 5000] and e in the range.
+func invBetaArguments(eLo, eHi int) hegel.Generator[[]float64] {
+	return tuple(scaled(ints(1, 10), 0.1), scaled(ints(100, 5000), 1), hegel.Map(ints(eLo, eHi), func(e int) float64 { return 1 - pow10(-e) }))
+}
+
+// invBetaNearOne: y within 10^-9 of 1 (measured: the answer is 1 - 10^-9 or 10 times off,
+// where it should be a tenth); past the shape, y = 1 - 10^-e for e in 2..5 (exact to 1e-12).
+var invBetaNearOne = shaped(invBetaArguments(9, 15), invBetaArguments(2, 5))
+
+func TestHegelInvRegIncBetaNearTheEnds(t *testing.T) {
+	narrow(t, call("InvRegIncBeta", invBetaNearOne))
+}
+
+// --------------------------------------------------------------------------- gonum/7
+
+// regBetaTinyB: RegIncBeta(a, b, x) with a in tenths to 100, b = m 10^-e in [1e-9, 9e-7] and
+// x = 1 - d 10^-5 for d in 5..10 (measured: off by 2e-6 to 1e-4 relative); past the shape,
+// x = 1 - d/100 for d in 1..50 (exact to 1e-13).
+var regBetaTinyB = tuple(
+	scaled(ints(1, 1000), 0.1),
+	hegel.Map(counts(ints(1, 9), ints(7, 9)), func(v []int) float64 { return float64(v[0]) * pow10(-v[1]) }),
+	shaped(
+		hegel.Map(ints(5, 10), func(d int) float64 { return 1 - float64(d)*1e-5 }),
+		hegel.Map(ints(1, 50), func(d int) float64 { return 1 - float64(d)/100 }),
+	),
+)
+
+func TestHegelRegIncBetaSmallSecondParameterNearOne(t *testing.T) {
+	narrow(t, call("RegIncBeta", regBetaTinyB))
+}
+
+// --------------------------------------------------------------------------- gonum/8
+
+// ellipticArguments: an amplitude of k/1000 half-turns beyond a quarter turn (either sign,
+// from the offset range) and a parameter m in thousandths below 1.
+func ellipticArguments(kLo, kHi int) hegel.Generator[[]float64] {
+	return tuple(
+		hegel.Map(counts(ints(kLo, kHi), ints(0, 1)), func(v []int) float64 {
+			return float64(2*v[1]-1) * (math.Pi/2 + float64(v[0])*math.Pi/1000)
+		}),
+		scaled(ints(0, 999), 1e-3),
+	)
+}
+
+// ellipticBeyond: EllipticF and EllipticE at an amplitude beyond pi/2 in magnitude by 1 to
+// 3500 thousandths of a half-turn (measured: wrong at every probed point); past the shape,
+// within [-pi/2, pi/2] (pi/2 less 0 to 1000 thousandths).
+var ellipticBeyond = shaped(ellipticArguments(1, 3500), ellipticArguments(-1000, 0))
+
+func TestHegelEllipticAmplitudeBeyondAQuarterTurn(t *testing.T) {
+	narrow(t, hegel.FlatMap(pick("EllipticF", "EllipticE"), func(name string) hegel.Generator[mathCase] {
+		return call(name, ellipticBeyond)
+	}))
+}
+
+// --------------------------------------------------------------------------- gonum/9
+
+// digammaZero: Digamma within 0.3 of its zero at 1.4616..., in thousandths, where relative
+// accuracy is hardest (the value is small, the absolute error of 3e-11 is not; measured: off
+// by 1.2e-10 to 1.4e-8 relative throughout, the strict tolerance being 1e-10); past the
+// shape, x in [3, 20] (within 6e-11 relative, inside the tolerance).
+var digammaZero = tuple(shaped(
+	hegel.Map(ints(-300, 300), func(k int) float64 { return 1.4616 + float64(k)/1000 }),
+	hegel.Map(ints(0, 1700), func(k int) float64 { return 3 + float64(k)/100 }),
+))
+
+func TestHegelDigammaToFullPrecision(t *testing.T) { narrow(t, call("Digamma", digammaZero)) }
+
+// --------------------------------------------------------------------------- gonum/10
+
+// digammaNextToPole: Digamma(-n + 10^-e) for n to 200 and e in 7..11 (measured: off by 1e-10
+// to 1e-5 relative, growing with e; 10^-6 is still exact); past the shape, -n with d/100
+// either side for d in 1..9.
+var digammaNextToPole = tuple(shaped(
+	hegel.Map(counts(ints(1, 200), ints(7, 11)), func(v []int) float64 { return -float64(v[0]) + pow10(-v[1]) }),
+	hegel.Map(counts(ints(1, 200), ints(1, 9), ints(0, 1)), func(v []int) float64 { return -float64(v[0]) + float64(2*v[2]-1)*float64(v[1])/100 }),
+))
+
+func TestHegelDigammaNextToANegativePole(t *testing.T) { narrow(t, call("Digamma", digammaNextToPole)) }
+
+// --------------------------------------------------------------------------- gonum/11
+
+// nonPositives: 0 or a negative number.
+var nonPositives = hegel.OneOf(hegel.Just(0.0), negatives)
+
+// ends: the end points of the unit interval.
+var ends = pick(0.0, 1.0)
+
+// interior: y in (0, 1) in thousandths.
+var interior = scaled(ints(1, 999), 1e-3)
+
+// invBetaChecks: InvRegIncBeta at y = 0 or 1 with a nonpositive a or b, where the documented
+// panic does not happen; past the shape, the same parameters at a y inside (0, 1), where it
+// does (y = 0 or 1 with valid parameters is hzInvBetaBad's region, so not the neighbour here).
+var invBetaChecks = hegel.OneOf(
+	tuple(nonPositives, shapes, shaped(ends, interior)),
+	tuple(shapes, nonPositives, shaped(ends, interior)),
+)
+
+// gammaIncRegChecks: GammaIncReg at x = 0 with a nonpositive a, where the documented panic
+// does not happen; past the shape, at an x inside (0, 1), where it does.
+var gammaIncRegChecks = tuple(nonPositives, shaped(hegel.Just(0.0), interior))
+
+// argumentChecks: the two, InvRegIncBeta two times in three.
+var argumentChecks = weighted(
+	choice[mathCase]{2, call("InvRegIncBeta", invBetaChecks)},
+	choice[mathCase]{1, call("GammaIncReg", gammaIncRegChecks)},
+)
+
+func TestHegelInverseIncompleteArgumentChecks(t *testing.T) { narrow(t, argumentChecks) }
+
+// --------------------------------------------------------------------------- gonum/12
+
+// zetaArguments: Zeta(m 10^e, q) with m to 999, e in the range and q > 1.
+func zetaArguments(eLo, eHi int) hegel.Generator[[]float64] {
+	return tuple(
+		hegel.Map(counts(ints(1, 999), ints(eLo, eHi)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) }),
+		hegel.Map(shapes, func(s float64) float64 { return 1 + s }),
+	)
+}
+
+// zetaHuge: x of 1e14 and beyond (measured: NaN where the sum is 0; 1e13 is still 0); past
+// the shape, x in [10, 1e12).
+var zetaHuge = shaped(zetaArguments(14, 100), zetaArguments(1, 9))
+
+func TestHegelZetaHugeExponent(t *testing.T) { narrow(t, call("Zeta", zetaHuge)) }
+
+// --------------------------------------------------------------------------- gonum/13
+
+// zetaCancelling: Zeta(x, -n - 1/2) for n to 20 and an odd x with (2n + 1)^x >= 1e9 (the
+// terms at k = n and n + 1 cancel; measured: off by 1e-8 at (2n + 1)^x = 1e9, by everything
+// from 1e13), x to 41.
+var zetaCancelling = hegel.FlatMap(ints(1, 20), func(n int) hegel.Generator[[]float64] {
+	least := int(math.Ceil(9 / math.Log10(float64(2*n+1)))) // the least x with (2n + 1)^x >= 1e9
+	return hegel.Map(ints(least/2, 20), func(j int) []float64 { return []float64{float64(2*j + 1), -float64(n) - 0.5} })
+})
+
+// zetaOverflowing: Zeta(x, -k/4) for an odd x in [2501, 5001] (measured: NaN where the sum is
+// 0 or infinite).
+var zetaOverflowing = hegel.Map(counts(ints(1250, 2500), ints(1, 3)), func(v []int) []float64 {
+	return []float64{float64(2*v[0] + 1), -float64(v[1]) / 4}
+})
+
+// zetaNegativeQ: those two shapes; past them, Zeta(x, n + d/10) for x in 3..22 and a
+// positive q to 12.9 (every negative q is the shape by the classifier's predicate; measured:
+// a negative q off the half, where no two terms cancel, is exact to 1e-12 too).
+var zetaNegativeQ = shaped(
+	weighted(choice[[]float64]{3, zetaCancelling}, choice[[]float64]{1, zetaOverflowing}),
+	hegel.Map(counts(ints(3, 22), ints(0, 12), ints(1, 9)), func(v []int) []float64 {
+		return []float64{float64(v[0]), float64(v[1]) + tenths(v[2])}
+	}),
+)
+
+func TestHegelZetaNegativeQ(t *testing.T) { narrow(t, call("Zeta", zetaNegativeQ)) }
diff --git a/hegel/hegel_zoo_shapes_stat_test.go b/hegel/hegel_zoo_shapes_stat_test.go
new file mode 100644
index 0000000..436f44e
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_stat_test.go
@@ -0,0 +1,148 @@
+package hegel
+
+// The shape regions of the recorded stat bugs (bugs.toml gonum/37..39) and the narrow
+// properties over them: each region is a generator over the bug's shape with random
+// contents, judged exactly like the wide property (judgeStat: the oracle, the strict
+// tolerance, the classifier naming the shape). Every narrow property fails every run by
+// default; under HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (shaped(shape, past)) and the property passes. The wide property TestHegelStat draws the
+// same regions one time in three by default (known) and never under HEGEL_NO_KNOWN=1. The
+// regions' hit rates were measured standalone (math/rand over the library); the comments
+// quote them.
+
+import (
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat"
+)
+
+// narrowStat runs a narrow property: every drawn case through the wide property's judge.
+func narrowStat(t *testing.T, cases hegel.Generator[statCase]) {
+	o := hzStartOracle(t, hzOracleStat)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeStat(ht, o, c, hegel.Draw(ht, cases))
+	})
+}
+
+// repeated is n copies of v.
+func repeated(v float64, n int) []float64 {
+	out := make([]float64, n)
+	for i := range out {
+		out[i] = v
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- gonum/37
+
+// emptyInputs: the empty dataset of any profile, unweighted or with empty weights:
+// HarmonicMean panics on it (the log-sum-exp of nothing; NumPy's 0/0 is NaN like Mean's),
+// every time.
+var emptyInputs = hegel.FlatMap(dataProfiles, func(p seriesProfile) hegel.Generator[statInputs] {
+	return hegel.Map(maybeWeightsOf(0, true), inputsWith(series{profile: p}).withW)
+})
+
+// nonEmptyInputs: one to twelve positive values, weighted or not (the region past the
+// empty dataset).
+var nonEmptyInputs = inputsOf(hegel.Map(hegel.FlatMap(ints(1, 12), datasetsOf), positive), true)
+
+func TestHegelHarmonicMeanOfAnEmptyDataset(t *testing.T) {
+	narrowStat(t, statCasesOf("HarmonicMean", shaped(emptyInputs, nonEmptyInputs)))
+}
+
+// --------------------------------------------------------------------------- gonum/38
+
+// nanWeightLists: lists of tenths whose sum S (22.7 to 28, and 11.4: a mantissa between
+// 1.4 and 1.8) has fl(fl(S^2)/S) > S, so that the corrected two-pass variance of constant
+// data v, v, ... comes out negative whenever the weighted mean is not exactly v, and the
+// standard deviation NaN. Measured over constant data of the profiles (StdDev and
+// PopStdDev agree): [9 2.7 6.1 4.4 1.4 2.7] 95% for tenths, 89% counts, 98% thousandths,
+// 100% thousands, 92% numbers, but 40% for the small integers (1, 2 and 4 are powers of
+// two, whose weighted mean is exact); the table averages 88% over the five other profiles
+// (73 to 95% per list) and the order of a list matters (the sum is sequential).
+var nanWeightLists = [][]float64{
+	{9, 2.7, 6.1, 4.4, 1.4, 2.7}, {9.7, 3.6, 5.5, 2.4, 5.9}, {2.7, 1.9, 7.2, 4.4, 1.6, 9.1}, {4.4, 7.7, 7.9, 7.4, 9.7, 8.3},
+	{3.6, 8, 0.7, 7, 3.4}, {5.2, 2.9, 9.2, 5.4}, {2.7, 7.9, 6.1, 7.8}, {8.3, 9.4, 0.1, 4.1, 6.1}, {9.8, 7.9, 4.8, 4.4},
+	{5.3, 5.6, 2.4, 8, 1.4}, {3.1, 9.4, 4.9, 5.4}, {9.7, 8.1, 4.9}, {9.4, 8, 5.4}, {4.7, 3.5, 3.2}, {7.6, 8.5, 9.1}, {8.6, 9.2, 8.4},
+}
+
+// constantProfiles: the data profiles but the small integers.
+var constantProfiles = pick(sTenths, sCounts, sThousandths, sThousands, sNumbers)
+
+// constantData: constant data v, v, ... (a pool of one nonzero value, 0 made 1: the
+// weighted mean of zeros is exact) of one of the profiles, as many points as the weights;
+// rendered by f from the value and the count.
+func constantData(w []float64, f func(v float64, n int) []float64) hegel.Generator[statInputs] {
+	return hegel.FlatMap(constantProfiles, func(p seriesProfile) hegel.Generator[statInputs] {
+		return hegel.Map(seriesElements[p], func(v float64) statInputs {
+			if v == 0 {
+				v = 1
+			}
+			return statInputs{x: series{p, []float64{v}, f(v, len(w))}, w: w}
+		})
+	})
+}
+
+// constantWeighted: constant data under one of the weight lists, kept when the library's
+// own population standard deviation is NaN (88% of the draws; the filter's three attempts
+// make that 99.8%).
+var constantWeighted = hegel.Filter(hegel.FlatMap(hegel.SampledFrom(nanWeightLists), func(w []float64) hegel.Generator[statInputs] {
+	return constantData(w, repeated)
+}), func(c statInputs) bool { return math.IsNaN(stat.PopStdDev(c.x.x, c.w)) })
+
+// twoValuedWeighted: the same weights over data alternating between v and v (1 + 10^-e),
+// e in 1..6 (a spread of 1e-6 to 1e-1 of the magnitude, past the classifier's 1e-7): the
+// corrected two-pass variance is exact to roundoff there.
+var twoValuedWeighted = hegel.FlatMap(hegel.SampledFrom(nanWeightLists), func(w []float64) hegel.Generator[statInputs] {
+	return hegel.FlatMap(ints(1, 6), func(e int) hegel.Generator[statInputs] {
+		return constantData(w, func(v float64, n int) []float64 {
+			x := repeated(v, n)
+			for i := 1; i < n; i += 2 {
+				x[i] = v * (1 + pow10(-e))
+			}
+			return x
+		})
+	})
+})
+
+var deviations = pick("StdDev", "PopStdDev", "PopMeanStdDev")
+
+func TestHegelWeightedStdDevOfConstantData(t *testing.T) {
+	narrowStat(t, hegel.FlatMap(deviations, func(name string) hegel.Generator[statCase] {
+		return statCasesOf(name, shaped(constantWeighted, twoValuedWeighted))
+	}))
+}
+
+// --------------------------------------------------------------------------- gonum/39
+
+// dwarfedWeights: n weights, 1 then m 1e-17 (m in 6..10): floats.Sum's vector lanes each
+// accumulate a few of the small weights above half an ulp of 1, so its total exceeds 1,
+// while the sequential running sum of the quantile drops every one of them and never
+// reaches p = 1 times the total (measured: Quantile(1, Empirical) panics for every n in
+// 4..16 and m in 6..10, never for m <= 3 below n = 12, and never for any p below 1, where
+// the first point's weight already reaches p times the total).
+func dwarfedWeights(n int) hegel.Generator[[]float64] {
+	return hegel.Map(ints(6, 10), func(m int) []float64 {
+		w := repeated(float64(m)*1e-17, n)
+		w[0] = 1
+		return w
+	})
+}
+
+// quantileAtOne: the empirical quantile at p = 1 of four to sixteen sorted points under
+// the dwarfed weights (every draw panics), or past the shape under HEGEL_NO_KNOWN=1 the
+// same points unweighted.
+var quantileAtOne = hegel.FlatMap(ints(4, 16), func(n int) hegel.Generator[statInputs] {
+	return hegel.FlatMap(hegel.Map(datasetsOf(n), sorted), func(s series) hegel.Generator[statInputs] {
+		at := inputsWith(s).withExtra(extras{{"p", 1}, {"kind", float64(stat.Empirical)}})
+		return hegel.Map(shaped(dwarfedWeights(n), hegel.Just[[]float64](nil)), at.withW)
+	})
+})
+
+func TestHegelWeightedEmpiricalQuantileAtOne(t *testing.T) {
+	narrowStat(t, statCasesOf("Quantile", quantileAtOne))
+}
diff --git a/hegel/hegel_zoo_stat_test.go b/hegel/hegel_zoo_stat_test.go
new file mode 100644
index 0000000..29d7401
--- /dev/null
+++ b/hegel/hegel_zoo_stat_test.go
@@ -0,0 +1,1008 @@
+package hegel
+
+// TestHegelStat: the descriptive statistics of gonum.org/v1/gonum/stat agree with NumPy, SciPy
+// and their documented formulas, with and without weights. A case is a function of the table
+// and inputs from that function's own generator: a dataset record (a magnitude profile and
+// its values, a third of them from a small pool so that ties and constant data are common),
+// weights half the time, a second series or dividers, and named extras; the shape regions of
+// the recorded bugs gonum/37-39 (those of hegel_zoo_shapes_stat_test.go, which has one narrow
+// property per bug) are drawn one time in three by their functions and judged at the strict
+// tolerance like every other case, so the property fails naming the shape (statShape) and is
+// an expected failure beside the pins; HEGEL_NO_KNOWN=1 looks past them: the regions are not
+// drawn and a case that still has a shape is skipped (counted).
+
+import (
+	"math"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat"
+)
+
+const hzOracleStat = `
+def W(x, w, hasw):
+    x = np.asarray(x, dtype=float)
+    w = np.asarray(w, dtype=float) if hasw else np.ones(len(x))
+    return x, w
+
+def WZ(x, w, hasw, *ys):
+    # the moments: the points with a weight of 0 contribute nothing (and would make 0 * inf)
+    x, w = W(x, w, hasw)
+    keep = w != 0
+    return (x[keep], w[keep]) + tuple(np.asarray(y, dtype=float)[keep] for y in ys)
+
+def wmean(x, w):
+    if len(x) == 0:
+        return nan
+    return float(np.sum(w * x) / np.sum(w))
+
+def constant(x, w=None, hasw=False):
+    # a dataset without spread (among the points with weight), where the moment ratios are 0/0
+    x = np.asarray(x, dtype=float)
+    if hasw:
+        x = x[np.asarray(w, dtype=float) != 0]
+    return len(x) > 0 and float(np.ptp(x)) <= 1e-7 * float(np.max(np.abs(x)))
+
+UNDEFINED_EMPTY = {"CircularMean", "Skew", "ExKurtosis", "Entropy", "CrossEntropy", "KullbackLeibler",
+                   "JensenShannon", "Hellinger", "Bhattacharyya", "ChiSquare", "KolmogorovSmirnov", "Kendall",
+                   "LinearRegression", "RSquared", "RSquaredFrom", "RNoughtSquared", "BivariateMoment",
+                   "MomentAbout", "Histogram"}
+
+def wvar(x, w, ddof):
+    if len(x) == 0:
+        return nan
+    m = wmean(x, w)
+    return float(np.sum(w * (x - m) ** 2) / (np.sum(w) - ddof))
+
+def S_Mean(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wmean(x, w)
+
+def S_Variance(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wvar(x, w, 1)
+
+def S_PopVariance(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wvar(x, w, 0)
+
+def S_StdDev(x, y, w, hasw, e):
+    return math.sqrt(S_Variance(x, y, w, hasw, e))
+
+def S_PopStdDev(x, y, w, hasw, e):
+    return math.sqrt(S_PopVariance(x, y, w, hasw, e))
+
+def S_MeanVariance(x, y, w, hasw, e):
+    return [S_Mean(x, y, w, hasw, e), S_Variance(x, y, w, hasw, e)]
+
+def S_PopMeanStdDev(x, y, w, hasw, e):
+    return [S_Mean(x, y, w, hasw, e), S_PopStdDev(x, y, w, hasw, e)]
+
+def S_Skew(x, y, w, hasw, e):
+    if constant(x, w, hasw):
+        skip()
+    x, w = WZ(x, w, hasw)
+    if np.sum(w) <= 2:
+        skip()  # the correction divides by n - 2
+    m = wmean(x, w)
+    s = math.sqrt(wvar(x, w, 1))
+    n = float(np.sum(w))
+    return float(np.sum(w * ((x - m) / s) ** 3) * (n / (n - 1)) * (1 / (n - 2)))
+
+def S_ExKurtosis(x, y, w, hasw, e):
+    if constant(x, w, hasw):
+        skip()
+    x, w = WZ(x, w, hasw)
+    if np.sum(w) <= 3:
+        skip()  # the correction divides by n - 3
+    m = wmean(x, w)
+    s = math.sqrt(wvar(x, w, 1))
+    n = float(np.sum(w))
+    mul = ((n + 1) / (n - 1)) * (n / (n - 2)) * (1 / (n - 3))
+    off = 3 * ((n - 1) / (n - 2)) * ((n - 1) / (n - 3))
+    return float(np.sum(w * ((x - m) / s) ** 4) * mul - off)
+
+def S_Moment(x, y, w, hasw, e):
+    # all points: the code takes w * (x - mean)^n, so a point of weight 0 with an infinite or NaN
+    # power makes the moment NaN (0 * inf), as numpy does
+    x, w = W(x, w, hasw)
+    m = wmean(x, w)
+    if not isint(e[0]) and np.any(np.abs(x - m) <= 1e-13 * np.max(np.abs(x))):
+        skip()  # a deviation that is roundoff: its sign, so NaN or not for a fractional power, is noise
+    return float(np.sum(w * np.power(x - m, e[0])) / np.sum(w))
+
+def S_MomentAbout(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)  # all points, as in Moment
+    return float(np.sum(w * np.power(x - e[1], e[0])) / np.sum(w))
+
+def S_BivariateMoment(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)  # all points, as in Moment
+    y = np.asarray(y, dtype=float)
+    mx, my = wmean(x, w), wmean(y, w)
+    return float(np.sum(w * np.power(x - mx, e[0]) * np.power(y - my, e[1])) / np.sum(w))
+
+def S_GeometricMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(np.exp(np.sum(w * np.log(x)) / np.sum(w)))
+
+def S_HarmonicMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(np.sum(w) / np.sum(w / x))
+
+def S_CircularMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(math.atan2(np.sum(w * np.sin(x)), np.sum(w * np.cos(x))))
+
+def S_Correlation(x, y, w, hasw, e):
+    if constant(x, w, hasw) or constant(y, w, hasw):
+        skip()
+    x, w, y = WZ(x, w, hasw, y)
+    dx, dy = x - wmean(x, w), y - wmean(y, w)
+    return float(np.sum(w * dx * dy) / math.sqrt(np.sum(w * dx * dx) * np.sum(w * dy * dy)))
+
+def S_Covariance(x, y, w, hasw, e):
+    x, w, y = WZ(x, w, hasw, y)
+    if len(x) == 0:
+        return nan
+    dx, dy = x - wmean(x, w), y - wmean(y, w)
+    return float(np.sum(w * dx * dy) / (np.sum(w) - 1))
+
+def S_Kendall(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    n = len(x)
+    cc = dc = tot = 0.0
+    for i in range(n):
+        for j in range(i + 1, n):
+            sx, sy = np.sign(x[j] - x[i]), np.sign(y[j] - y[i])
+            wt = w[i] * w[j]
+            tot += wt
+            if sx == 0 or sy == 0:
+                skip()  # a tie: Tau-a counts it neither way; the code counts it by sign bit
+            if sx == sy:
+                cc += wt
+            else:
+                dc += wt
+    return (cc - dc) / tot
+
+def S_Entropy(x, y, w, hasw, e):
+    p = np.asarray(x, dtype=float)
+    nz = p[p != 0]
+    return float(-np.sum(nz * np.log(nz)))
+
+def S_CrossEntropy(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    m = p != 0
+    return float(-np.sum(p[m] * np.log(q[m])))
+
+def S_KullbackLeibler(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    m = p != 0
+    return float(np.sum(p[m] * (np.log(p[m]) - np.log(q[m]))))
+
+def S_JensenShannon(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    mid = 0.5 * (p + q)
+    js = 0.0
+    for pi, qi, mi in zip(p, q, mid):
+        if pi != 0:
+            js += 0.5 * pi * (math.log(pi) - math.log(mi))
+        if qi != 0:
+            js += 0.5 * qi * (math.log(qi) - math.log(mi))
+    return js
+
+def S_Hellinger(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    return float(math.sqrt(1 - np.sum(np.sqrt(p * q))))
+
+def S_Bhattacharyya(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    s = float(np.sum(np.sqrt(p * q)))
+    return inf if s == 0 else -math.log(s)
+
+def S_ChiSquare(x, y, w, hasw, e):
+    r = 0.0
+    for a, b in zip(x, y):
+        if a == 0 and b == 0:
+            continue
+        r += inf if b == 0 else (a - b) ** 2 / b
+    return r
+
+def S_Histogram(x, y, w, hasw, e):
+    # y holds the dividers
+    xs, ws = W(x, w, hasw)
+    dv = np.asarray(y, dtype=float)
+    chk(len(xs) == 0 or (xs.min() >= dv[0] and xs.max() < dv[-1]))  # documented conditions
+    return list(np.histogram(xs, bins=dv, weights=ws)[0])
+
+def S_Quantile(x, y, w, hasw, e):
+    p, kind = e[0], int(e[1])
+    chk(0 <= p <= 1)
+    chk(len(x) > 0)
+    if hasw and all(v == 0 for v in w):
+        if kind == 1:
+            return float(x[0])  # the running sum 0 reaches p * 0 at the first point
+        skip()
+    xs, ws = W(x, w, hasw)
+    if kind == 1:
+        cum = 0.0
+        fidx = p * np.sum(ws)
+        for xi, wi in zip(xs, ws):
+            cum += wi
+            if cum >= fidx:
+                return float(xi)
+        return float(xs[-1])
+    if kind == 7:
+        if hasw:
+            skip()  # a weighted R-7 quantile has no standard definition
+        return float(np.quantile(xs, p, method="linear"))
+    skip()
+
+def S_CDF(x, y, w, hasw, e):
+    q = e[0]
+    chk(len(x) > 0)
+    xs, ws = W(x, w, hasw)
+    if q < xs[0]:
+        return 0.0
+    if q >= xs[-1]:
+        return 1.0
+    if np.sum(ws) == 0:
+        return nan
+    return float(np.sum(ws[xs <= q]) / np.sum(ws))
+
+def S_KolmogorovSmirnov(x, y, w, hasw, e):
+    # y holds the second sample, w the concatenated weights (len(x) then len(y))
+    if len(x) == 0 and len(y) == 0:
+        return 0.0
+    if len(x) == 0 or len(y) == 0:
+        return 1.0
+    xs = np.asarray(x, dtype=float)
+    ys = np.asarray(y, dtype=float)
+    if hasw:
+        wx, wy = np.asarray(w[:len(x)], dtype=float), np.asarray(w[len(x):], dtype=float)
+    else:
+        wx, wy = np.ones(len(x)), np.ones(len(y))
+    best = 0.0
+    for t in np.union1d(xs, ys):
+        fx = np.sum(wx[xs <= t]) / np.sum(wx)
+        fy = np.sum(wy[ys <= t]) / np.sum(wy)
+        best = max(best, abs(fx - fy))
+    return float(best)
+
+def S_LinearRegression(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    if e[0] != 0:
+        return [0.0, float(np.sum(ws * xs * ys) / np.sum(ws * xs * xs))]
+    if len(xs) < 2 or np.sum(ws) == 0 or constant(x, w, hasw) or wvar(xs, ws, 0) == 0:
+        skip()
+    beta, alpha = np.polyfit(xs, ys, 1, w=np.sqrt(ws))
+    return [float(alpha), float(beta)]
+
+def S_RSquared(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    alpha, beta = e[0], e[1]
+    res = np.sum(ws * (ys - alpha - beta * xs) ** 2)
+    tot = np.sum(ws * (ys - wmean(ys, ws)) ** 2)
+    if constant(ys, ws, True):
+        skip()  # 1 - res / 0
+    return float(1 - res / tot)
+
+def S_RSquaredFrom(x, y, w, hasw, e):
+    # x: estimates, y: values
+    est, ws, vals = WZ(x, w, hasw, y)
+    res = np.sum(ws * (vals - est) ** 2)
+    tot = np.sum(ws * (vals - wmean(vals, ws)) ** 2)
+    if constant(vals, ws, True):
+        skip()  # 1 - res / 0
+    return float(1 - res / tot)
+
+def S_RNoughtSquared(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    beta = e[0]
+    return float(np.sum(ws * (beta * xs) ** 2) / np.sum(ws * ys * ys))
+
+def S_Mode(x, y, w, hasw, e):
+    if len(x) == 0 or (hasw and all(v == 0 for v in w)):
+        return [0.0, 0.0]  # no weight exceeds the initial count of 0
+    xs, ws = W(x, w, hasw)
+    counts = {}
+    for xi, wi in zip(xs, ws):
+        counts[xi] = counts.get(xi, 0.0) + wi
+    best = max(counts.values())
+    if sum(1 for v in counts.values() if v == best) > 1:
+        skip()
+    val = [k for k, v in counts.items() if v == best][0]
+    return [float(val), float(best)]
+
+def S_StdErr(x, y, w, hasw, e):
+    return e[0] / math.sqrt(e[1])
+
+def S_StdScore(x, y, w, hasw, e):
+    if e[2] == 0:
+        skip()
+    return (e[0] - e[1]) / e[2]
+
+def S_WassersteinDistance(x, y, w, hasw, e):
+    if len(x) == 0 or len(y) == 0:
+        return nan
+    if hasw:
+        return float(st.wasserstein_distance(x, y, w[:len(x)], w[len(x):]))
+    return float(st.wasserstein_distance(x, y))
+
+def Stat(name, x, y, w, hasw, e):
+    if len(x) == 0 and name in UNDEFINED_EMPTY:
+        skip()
+    try:
+        return globals()["S_" + name](x, y, w, hasw, e)
+    except (ZeroDivisionError, ValueError):
+        skip()  # a 0/0 or log(0) of the model: not judged
+`
+
+// --------------------------------------------------------------------------- datasets
+
+// seriesProfile is a magnitude profile of a dataset's values.
+type seriesProfile int
+
+const (
+	sSmallInts     seriesProfile = iota // integers -5..5
+	sTenths                             // tenths to 10 either side
+	sCounts                             // integers 0..100
+	sThousandths                        // thousandths to 10 either side
+	sThousands                          // thousands to a million either side
+	sNumbers                            // the ten magnitude profiles of hegel_zoo_gen_test.go, negative two times in five
+	sProbabilities                      // a probability vector: integers to 100 (0 one time in ten), normalised or not
+)
+
+var seriesProfileNames = [...]string{"smallInts", "tenths", "counts", "thousandths", "thousands", "numbers", "probabilities"}
+
+// over is the integer draw divided by den (k/10, k/1000: the decimal fractions, correctly
+// rounded).
+func over(g hegel.Generator[int], den float64) hegel.Generator[float64] {
+	return hegel.Map(g, func(k int) float64 { return float64(k) / den })
+}
+
+// seriesElements: a value of each data profile.
+var seriesElements = [...]hegel.Generator[float64]{
+	scaled(ints(-5, 5), 1),
+	over(ints(-100, 100), 10),
+	scaled(ints(0, 100), 1),
+	over(ints(-10000, 10000), 1000),
+	scaled(ints(-1000, 1000), 1000),
+	numbers,
+}
+
+// dataProfiles: one of the six data profiles, the small integers first.
+var dataProfiles = pick(sSmallInts, sTenths, sCounts, sThousandths, sThousands, sNumbers)
+
+// series is a dataset as drawn: its profile, the small pool its values were drawn from (nil
+// when they were drawn one by one) and the values.
+type series struct {
+	profile seriesProfile
+	pool    []float64
+	x       []float64
+}
+
+func (s series) GoString() string {
+	out := seriesProfileNames[s.profile]
+	if s.pool != nil {
+		out += "{" + strings.Join(hzFmts(s.pool), " ") + "}"
+	}
+	return out + hzShow(s.x)
+}
+
+// lengths: a dataset's length: 0 to 2 one time in ten (the empty dataset is a plain case),
+// 1 to 12 eight times, 13 to 60 once.
+var lengths = weighted(choice[int]{1, ints(0, 2)}, choice[int]{8, ints(1, 12)}, choice[int]{1, ints(13, 60)})
+
+// valuesOf: exactly n values of the generator (nil for none).
+func valuesOf(n int, elem hegel.Generator[float64]) hegel.Generator[[]float64] {
+	return hegel.Lists(elem).MinSize(n).MaxSize(n)
+}
+
+// datasetOf: n values of the profile, drawn one by one or, one time in three, from a pool of
+// one to three values of it (ties, and constant data).
+func datasetOf(n int, p seriesProfile) hegel.Generator[series] {
+	elem := seriesElements[p]
+	return weighted(
+		choice[series]{2, hegel.Map(valuesOf(n, elem), func(x []float64) series { return series{p, nil, x} })},
+		choice[series]{1, hegel.FlatMap(hegel.Lists(elem).MinSize(1).MaxSize(3), func(pool []float64) hegel.Generator[series] {
+			return hegel.Map(valuesOf(n, pick(pool...)), func(x []float64) series { return series{p, pool, x} })
+		})},
+	)
+}
+
+// datasetsOf: a dataset of n values of a drawn profile.
+func datasetsOf(n int) hegel.Generator[series] {
+	return hegel.FlatMap(dataProfiles, func(p seriesProfile) hegel.Generator[series] { return datasetOf(n, p) })
+}
+
+// datasets: a dataset of a drawn length.
+var datasets = hegel.FlatMap(lengths, datasetsOf)
+
+// mapped applies f to every value (nil stays nil).
+func mapped(xs []float64, f func(float64) float64) []float64 {
+	if xs == nil {
+		return nil
+	}
+	out := make([]float64, len(xs))
+	for i, v := range xs {
+		out[i] = f(v)
+	}
+	return out
+}
+
+// positive: the values' magnitudes, 0 made 1 (the geometric and harmonic means).
+func positive(s series) series {
+	f := func(v float64) float64 {
+		if v == 0 {
+			return 1
+		}
+		return math.Abs(v)
+	}
+	return series{s.profile, mapped(s.pool, f), mapped(s.x, f)}
+}
+
+// sortedValues: the values in order.
+func sortedValues(x []float64) []float64 {
+	out := append([]float64(nil), x...)
+	sort.Float64s(out)
+	return out
+}
+
+// sorted: the dataset in order (the empirical functions take sorted data).
+func sorted(s series) series { return series{s.profile, s.pool, sortedValues(s.x)} }
+
+// --------------------------------------------------------------------------- weights
+
+// weightValues: 1, an integer to 10, thousandths or tenths.
+var weightValues = hegel.OneOf(hegel.Just(1.0), scaled(ints(1, 10), 1), over(ints(1, 1000), 1000), over(ints(1, 99), 10))
+
+// weightsOf: n weights, each 0 one time in twenty when zeros (the two-sample tests take
+// none); an empty weighted dataset has an empty slice, not nil.
+func weightsOf(n int, zeros bool) hegel.Generator[[]float64] {
+	elem := weightValues
+	if zeros {
+		elem = weighted(choice[float64]{19, weightValues}, choice[float64]{1, hegel.Just(0.0)})
+	}
+	return hegel.Map(valuesOf(n, elem), func(w []float64) []float64 {
+		if w == nil {
+			return []float64{}
+		}
+		return w
+	})
+}
+
+// maybeWeightsOf: unweighted (nil) half the time.
+func maybeWeightsOf(n int, zeros bool) hegel.Generator[[]float64] {
+	return hegel.OneOf(hegel.Just[[]float64](nil), weightsOf(n, zeros))
+}
+
+// --------------------------------------------------------------------------- inputs
+
+// extra is a named argument beyond the dataset (a moment's order, a quantile's p, ...).
+type extra struct {
+	name string
+	v    float64
+}
+
+type extras []extra
+
+// list is the extras in order, as the oracle takes them.
+func (e extras) list() []float64 {
+	out := make([]float64, len(e))
+	for i, x := range e {
+		out[i] = x.v
+	}
+	return out
+}
+
+func (e extras) GoString() string {
+	parts := make([]string, len(e))
+	for i, x := range e {
+		parts[i] = x.name + "=" + hzFmt(x.v)
+	}
+	return strings.Join(parts, ", ")
+}
+
+// statInputs are the inputs of one call: the dataset, the second series or Histogram's
+// dividers (y), the weights (nil when unweighted; both samples' weights in a row for the
+// two-sample tests) and the extras.
+type statInputs struct {
+	x     series
+	y     []float64
+	w     []float64
+	extra extras
+}
+
+func (c statInputs) withY(y []float64) statInputs  { c.y = y; return c }
+func (c statInputs) withW(w []float64) statInputs  { c.w = w; return c }
+func (c statInputs) withExtra(e extras) statInputs { c.extra = e; return c }
+
+// split is the two samples' weights.
+func (c statInputs) split() (w, wy []float64) { return c.w[:len(c.x.x)], c.w[len(c.x.x):] }
+
+func seriesValues(s series) []float64 { return s.x }
+func inputsWith(s series) statInputs  { return statInputs{x: s} }
+
+// inputsOf: the dataset, weighted or not.
+func inputsOf(data hegel.Generator[series], zeros bool) hegel.Generator[statInputs] {
+	return hegel.FlatMap(data, func(s series) hegel.Generator[statInputs] {
+		return hegel.Map(maybeWeightsOf(len(s.x), zeros), inputsWith(s).withW)
+	})
+}
+
+// andY / andExtras: the inputs with a second series / extras drawn by a generator that may
+// depend on them; withExtras: by one that does not.
+func andY(in hegel.Generator[statInputs], f func(statInputs) hegel.Generator[[]float64]) hegel.Generator[statInputs] {
+	return hegel.FlatMap(in, func(c statInputs) hegel.Generator[statInputs] { return hegel.Map(f(c), c.withY) })
+}
+
+func andExtras(in hegel.Generator[statInputs], f func(statInputs) hegel.Generator[extras]) hegel.Generator[statInputs] {
+	return hegel.FlatMap(in, func(c statInputs) hegel.Generator[statInputs] { return hegel.Map(f(c), c.withExtra) })
+}
+
+func withExtras(in hegel.Generator[statInputs], e hegel.Generator[extras]) hegel.Generator[statInputs] {
+	return andExtras(in, func(statInputs) hegel.Generator[extras] { return e })
+}
+
+// twoSampleInputs: a first sample and a second of its own length (drawn by ys from the
+// first) and, when weighted, weights without zeros for both in a row.
+func twoSampleInputs(xs hegel.Generator[series], ys func(x series) hegel.Generator[[]float64]) hegel.Generator[statInputs] {
+	return hegel.FlatMap(xs, func(x series) hegel.Generator[statInputs] {
+		return hegel.FlatMap(ys(x), func(y []float64) hegel.Generator[statInputs] {
+			return hegel.Map(maybeWeightsOf(len(x.x)+len(y), false), statInputs{x: x, y: y}.withW)
+		})
+	})
+}
+
+// probabilityVectorsOf: n entries, an integer to 100 or 0 one time in ten (all zero: the
+// first is 1), normalised when norm.
+func probabilityVectorsOf(n int, norm bool) hegel.Generator[series] {
+	elem := weighted(choice[float64]{9, scaled(ints(1, 100), 1)}, choice[float64]{1, hegel.Just(0.0)})
+	return hegel.Map(valuesOf(n, elem), func(drawn []float64) series {
+		p := append([]float64{}, drawn...)
+		sum := 0.0
+		for _, v := range p {
+			sum += v
+		}
+		if sum == 0 && len(p) > 0 {
+			p[0], sum = 1, 1
+		}
+		if norm {
+			for i := range p {
+				p[i] /= sum
+			}
+		}
+		return series{profile: sProbabilities, x: p}
+	})
+}
+
+// dividersOf: two to eight dividers for the sorted data: the first at most the least value
+// (by an integer to 3), the last beyond the greatest (by 1 to 3), the others at thousandths
+// of the range; for an empty dataset (not judged) a sorted series.
+func dividersOf(c statInputs) hegel.Generator[[]float64] {
+	x := c.x.x
+	return hegel.FlatMap(ints(2, 8), func(nd int) hegel.Generator[[]float64] {
+		if len(x) == 0 {
+			return hegel.Map(valuesOf(nd, seriesElements[c.x.profile]), sortedValues)
+		}
+		lo, hi := x[0], x[len(x)-1]
+		return hegel.FlatMap(tuple(scaled(ints(0, 3), 1), scaled(ints(1, 3), 1)), func(ends []float64) hegel.Generator[[]float64] {
+			return hegel.Map(valuesOf(nd-2, over(ints(0, 1000), 1000)), func(fs []float64) []float64 {
+				d := append([]float64{lo - ends[0]}, mapped(fs, func(f float64) float64 { return lo + (hi-lo)*f })...)
+				return sortedValues(append(d, hi+ends[1]))
+			})
+		})
+	})
+}
+
+var (
+	plainInputs    = inputsOf(datasets, true)
+	positiveInputs = inputsOf(hegel.Map(datasets, positive), true)
+	sortedInputs   = inputsOf(hegel.Map(datasets, sorted), true)
+
+	// pairedInputs: a second series of the same length, independent (a drawn profile) or a
+	// noisy linear image a + b x + k/10 of the first.
+	pairedInputs = andY(plainInputs, func(c statInputs) hegel.Generator[[]float64] {
+		n := len(c.x.x)
+		independent := hegel.Map(datasetsOf(n), seriesValues)
+		image := hegel.FlatMap(tuple(numbers, numbers), func(ab []float64) hegel.Generator[[]float64] {
+			return hegel.Map(valuesOf(n, over(ints(-10, 10), 10)), func(noise []float64) []float64 {
+				y := make([]float64, n)
+				for i, v := range c.x.x {
+					y[i] = ab[0] + ab[1]*v + noise[i]
+				}
+				return y
+			})
+		})
+		return hegel.OneOf(independent, image)
+	})
+	// bivariateInputs: an independent second series of the same length and the orders r, s
+	// to 4.
+	bivariateInputs = withExtras(
+		andY(plainInputs, func(c statInputs) hegel.Generator[[]float64] { return hegel.Map(datasetsOf(len(c.x.x)), seriesValues) }),
+		hegel.Map(tuple(scaled(ints(0, 4), 1), scaled(ints(0, 4), 1)), func(a []float64) extras { return extras{{"r", a[0]}, {"s", a[1]}} }))
+
+	// orders: a moment's order, an integer to 6 or, three times in twenty, a half-integer to 5.
+	orders = weighted(choice[float64]{17, scaled(ints(0, 6), 1)}, choice[float64]{3, over(ints(1, 10), 2)})
+	momentInputs = withExtras(plainInputs, hegel.Map(orders, func(k float64) extras { return extras{{"k", k}} }))
+	// momentAboutInputs: the order and a centre: a number, or the weighted mean itself two
+	// times in five.
+	momentAboutInputs = andExtras(plainInputs, func(c statInputs) hegel.Generator[extras] {
+		centre := weighted(choice[float64]{3, numbers}, choice[float64]{2, hegel.Just(stat.Mean(c.x.x, c.w))})
+		return hegel.Map(tuple(orders, centre), func(a []float64) extras { return extras{{"k", a[0]}, {"mean", a[1]}} })
+	})
+
+	// entropyInputs: a probability vector, normalised seven times in ten; divergenceInputs:
+	// two of the same length, both normalised or neither.
+	entropyInputs = hegel.FlatMap(lengths, func(n int) hegel.Generator[statInputs] {
+		return hegel.FlatMap(chance(70), func(norm bool) hegel.Generator[statInputs] {
+			return hegel.Map(probabilityVectorsOf(n, norm), inputsWith)
+		})
+	})
+	divergenceInputs = hegel.FlatMap(lengths, func(n int) hegel.Generator[statInputs] {
+		return hegel.FlatMap(chance(70), func(norm bool) hegel.Generator[statInputs] {
+			return andY(hegel.Map(probabilityVectorsOf(n, norm), inputsWith), func(statInputs) hegel.Generator[[]float64] {
+				return hegel.Map(probabilityVectorsOf(n, norm), seriesValues)
+			})
+		})
+	})
+
+	histogramInputs = andY(sortedInputs, dividersOf)
+
+	// quantilePs: a probability (the ends and 1 - 10^-e included) or, three times in a
+	// hundred, one beyond [0, 1] (a panic); kinds: Empirical one time in three, LinInterp
+	// twice.
+	quantilePs     = weighted(choice[float64]{97, probabilities}, choice[float64]{3, pick(-0.1, 1.1)})
+	kinds          = pick(float64(stat.Empirical), float64(stat.LinInterp), float64(stat.LinInterp))
+	quantileExtras = hegel.Map(tuple(quantilePs, kinds), func(a []float64) extras { return extras{{"p", a[0]}, {"kind", a[1]}} })
+	quantileInputs = known(withExtras(sortedInputs, quantileExtras), quantileAtOne)
+
+	// cdfInputs: the sorted data and a point: a number, or one of the points half the time.
+	cdfInputs = andExtras(sortedInputs, func(c statInputs) hegel.Generator[extras] {
+		q := numbers
+		if len(c.x.x) > 0 {
+			q = hegel.OneOf(numbers, pick(c.x.x...))
+		}
+		return hegel.Map(q, func(v float64) extras { return extras{{"q", v}} })
+	})
+
+	// kolmogorovInputs: two sorted samples, the second's values among the first's two times
+	// in five; wassersteinInputs: two samples as drawn.
+	kolmogorovInputs = twoSampleInputs(hegel.Map(datasets, sorted), func(x series) hegel.Generator[[]float64] {
+		ys := hegel.Map(datasets, func(s series) []float64 { return sortedValues(s.x) })
+		if len(x.x) == 0 {
+			return ys
+		}
+		among := hegel.FlatMap(lengths, func(m int) hegel.Generator[[]float64] { return hegel.Map(valuesOf(m, pick(x.x...)), sortedValues) })
+		return weighted(choice[[]float64]{3, ys}, choice[[]float64]{2, among})
+	})
+	wassersteinInputs = twoSampleInputs(datasets, func(series) hegel.Generator[[]float64] { return hegel.Map(datasets, seriesValues) })
+
+	// linearRegressionInputs: through the origin three times in ten; rSquaredInputs: a line
+	// alpha + beta x, the fitted one half the time; rNoughtInputs: a slope.
+	linearRegressionInputs = withExtras(pairedInputs, hegel.Map(chance(30), func(origin bool) extras {
+		if origin {
+			return extras{{"origin", 1}}
+		}
+		return extras{{"origin", 0}}
+	}))
+	rSquaredInputs = andExtras(pairedInputs, func(c statInputs) hegel.Generator[extras] {
+		line := tuple(numbers, numbers)
+		if len(c.x.x) > 1 {
+			a, b := stat.LinearRegression(c.x.x, c.y, c.w, false)
+			line = hegel.OneOf(line, hegel.Just([]float64{a, b}))
+		}
+		return hegel.Map(line, func(ab []float64) extras { return extras{{"alpha", ab[0]}, {"beta", ab[1]}} })
+	})
+	rNoughtInputs = withExtras(pairedInputs, hegel.Map(numbers, func(b float64) extras { return extras{{"beta", b}} }))
+
+	// stdErrInputs: a standard deviation and a sample size to 100; stdScoreInputs: a value,
+	// a mean and a positive standard deviation (no dataset).
+	stdErrInputs = withExtras(hegel.Just(statInputs{}), hegel.Map(tuple(nonNegatives, scaled(ints(1, 100), 1)), func(a []float64) extras {
+		return extras{{"std", a[0]}, {"n", a[1]}}
+	}))
+	stdScoreInputs = withExtras(hegel.Just(statInputs{}), hegel.Map(tuple(numbers, numbers, positives), func(a []float64) extras {
+		return extras{{"x", a[0]}, {"mean", a[1]}, {"std", a[2]}}
+	}))
+)
+
+// --------------------------------------------------------------------------- the functions
+
+// statSpec is one function of stat: its inputs, the call, the magnitude its absolute
+// tolerance (1e-13 of it) is relative to and its relative tolerance.
+type statSpec struct {
+	name   string
+	inputs hegel.Generator[statInputs]
+	call   func(c statInputs) []float64
+	scale  func(c statInputs) float64
+	rtol   float64
+}
+
+// the scales
+func unit(statInputs) float64            { return 1 }
+func maxAbsX(c statInputs) float64       { return hzMaxAbs(c.x.x) }
+func maxAbsXY(c statInputs) float64      { return hzMaxAbs(c.x.x, c.y) }
+func squareOfX(c statInputs) float64     { return maxAbsX(c) * maxAbsX(c) }
+func productOfXY(c statInputs) float64   { return hzMaxAbs(c.x.x) * hzMaxAbs(c.y) }
+func momentScale(c statInputs) float64   { return math.Pow(hzMaxAbs(c.x.x), c.extra[0].v) }
+func momentAboutScale(c statInputs) float64 {
+	return math.Pow(hzMaxAbs(c.x.x, []float64{c.extra[1].v}), c.extra[0].v)
+}
+func bivariateScale(c statInputs) float64 { return math.Pow(hzMaxAbs(c.x.x, c.y), c.extra[0].v+c.extra[1].v) }
+func chiSquareScale(c statInputs) float64 { return 1 + hzMaxAbs(c.x.x, c.y) }
+func stdErrScale(c statInputs) float64    { return c.extra[0].v }
+func stdScoreScale(c statInputs) float64 {
+	return (math.Abs(c.extra[0].v) + math.Abs(c.extra[1].v)) / c.extra[2].v
+}
+
+// regressionScale: beta = cov(x, y)/var(x): roundoff in the mean of y (eps max|y|) divided
+// by the spread of x (LinearRegression(x=[2.01e-06 -1.19e-4], y=[0.5 0.5], w=[2 0.039]) is 0
+// here and 8.8e-12 with NumPy); alpha adds beta's error times |x|.
+func regressionScale(c statInputs) float64 {
+	s := hzMaxAbs(c.x.x, c.y) * (1 + hzMaxAbs(c.y))
+	if xs := hzWeighted(c.x.x, c.w); hzSpread(xs) > 0 {
+		s = math.Max(s, hzMaxAbs(c.y)*(1+hzMaxAbs(xs))/hzSpread(xs))
+	}
+	return s
+}
+func rSquaredScale(c statInputs) float64 {
+	return hzRSquaredScale(c.x.x, c.y, c.w, c.extra[0].v, c.extra[1].v)
+}
+func rSquaredFromScale(c statInputs) float64 { return hzRSquaredScale(c.x.x, c.y, c.w, hzMaxAbs(c.y), 0) }
+func rNoughtScale(c statInputs) float64      { return hzRSquaredScale(c.x.x, c.y, c.w, 0, c.extra[0].v) }
+
+// one wraps a single-valued function.
+func one(f func(c statInputs) float64) func(c statInputs) []float64 {
+	return func(c statInputs) []float64 { return []float64{f(c)} }
+}
+
+// two wraps a function returning a pair.
+func two(f func(c statInputs) (float64, float64)) func(c statInputs) []float64 {
+	return func(c statInputs) []float64 { a, b := f(c); return []float64{a, b} }
+}
+
+// statSpecs: the 37 functions, each with its inputs and, where it has a recorded bug, the
+// bug's shape region one time in three (known). HarmonicMean comes first: its shape (the
+// empty dataset, gonum/37) is the simplest deterministic failure, so the shrinker of
+// TestHegelStat lands there whatever it met first; Mean second, the most drawn index of a
+// SampledFrom table, has no recorded bug.
+var statSpecs = []statSpec{
+	{"HarmonicMean", known(positiveInputs, emptyInputs), one(func(c statInputs) float64 { return stat.HarmonicMean(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"Mean", plainInputs, one(func(c statInputs) float64 { return stat.Mean(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"Variance", plainInputs, one(func(c statInputs) float64 { return stat.Variance(c.x.x, c.w) }), squareOfX, 1e-10},
+	{"PopVariance", plainInputs, one(func(c statInputs) float64 { return stat.PopVariance(c.x.x, c.w) }), squareOfX, 1e-10},
+	{"StdDev", known(plainInputs, constantWeighted), one(func(c statInputs) float64 { return stat.StdDev(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"PopStdDev", known(plainInputs, constantWeighted), one(func(c statInputs) float64 { return stat.PopStdDev(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"MeanVariance", plainInputs, two(func(c statInputs) (float64, float64) { return stat.MeanVariance(c.x.x, c.w) }), squareOfX, 1e-10},
+	{"PopMeanStdDev", known(plainInputs, constantWeighted), two(func(c statInputs) (float64, float64) { return stat.PopMeanStdDev(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"Skew", plainInputs, one(func(c statInputs) float64 { return stat.Skew(c.x.x, c.w) }), unit, 1e-8},
+	{"ExKurtosis", plainInputs, one(func(c statInputs) float64 { return stat.ExKurtosis(c.x.x, c.w) }), unit, 1e-8},
+	{"Moment", momentInputs, one(func(c statInputs) float64 { return stat.Moment(c.extra[0].v, c.x.x, c.w) }), momentScale, 1e-10},
+	{"MomentAbout", momentAboutInputs, one(func(c statInputs) float64 { return stat.MomentAbout(c.extra[0].v, c.x.x, c.extra[1].v, c.w) }), momentAboutScale, 1e-10},
+	{"BivariateMoment", bivariateInputs, one(func(c statInputs) float64 { return stat.BivariateMoment(c.extra[0].v, c.extra[1].v, c.x.x, c.y, c.w) }), bivariateScale, 1e-10},
+	{"GeometricMean", positiveInputs, one(func(c statInputs) float64 { return stat.GeometricMean(c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"CircularMean", plainInputs, one(func(c statInputs) float64 { return stat.CircularMean(c.x.x, c.w) }), unit, 1e-10},
+	{"Correlation", pairedInputs, one(func(c statInputs) float64 { return stat.Correlation(c.x.x, c.y, c.w) }), unit, 1e-9},
+	{"Covariance", pairedInputs, one(func(c statInputs) float64 { return stat.Covariance(c.x.x, c.y, c.w) }), productOfXY, 1e-10},
+	{"Kendall", pairedInputs, one(func(c statInputs) float64 { return stat.Kendall(c.x.x, c.y, c.w) }), unit, 1e-10},
+	{"Entropy", entropyInputs, one(func(c statInputs) float64 { return stat.Entropy(c.x.x) }), unit, 1e-10},
+	{"CrossEntropy", divergenceInputs, one(func(c statInputs) float64 { return stat.CrossEntropy(c.x.x, c.y) }), unit, 1e-10},
+	{"KullbackLeibler", divergenceInputs, one(func(c statInputs) float64 { return stat.KullbackLeibler(c.x.x, c.y) }), unit, 1e-10},
+	{"JensenShannon", divergenceInputs, one(func(c statInputs) float64 { return stat.JensenShannon(c.x.x, c.y) }), unit, 1e-10},
+	{"Hellinger", divergenceInputs, one(func(c statInputs) float64 { return stat.Hellinger(c.x.x, c.y) }), unit, 1e-10},
+	{"Bhattacharyya", divergenceInputs, one(func(c statInputs) float64 { return stat.Bhattacharyya(c.x.x, c.y) }), unit, 1e-10},
+	{"ChiSquare", divergenceInputs, one(func(c statInputs) float64 { return stat.ChiSquare(c.x.x, c.y) }), chiSquareScale, 1e-10},
+	{"Histogram", histogramInputs, func(c statInputs) []float64 { return stat.Histogram(nil, c.y, c.x.x, c.w) }, unit, 1e-12},
+	{"Quantile", quantileInputs, one(func(c statInputs) float64 { return stat.Quantile(c.extra[0].v, stat.CumulantKind(c.extra[1].v), c.x.x, c.w) }), maxAbsX, 1e-10},
+	{"CDF", cdfInputs, one(func(c statInputs) float64 { return stat.CDF(c.extra[0].v, stat.Empirical, c.x.x, c.w) }), unit, 1e-10},
+	{"KolmogorovSmirnov", kolmogorovInputs, one(func(c statInputs) float64 {
+		if c.w == nil {
+			return stat.KolmogorovSmirnov(c.x.x, nil, c.y, nil)
+		}
+		w, wy := c.split()
+		return stat.KolmogorovSmirnov(c.x.x, w, c.y, wy)
+	}), unit, 1e-10},
+	{"LinearRegression", linearRegressionInputs, two(func(c statInputs) (float64, float64) { return stat.LinearRegression(c.x.x, c.y, c.w, c.extra[0].v == 1) }), regressionScale, 1e-9},
+	{"RSquared", rSquaredInputs, one(func(c statInputs) float64 { return stat.RSquared(c.x.x, c.y, c.w, c.extra[0].v, c.extra[1].v) }), rSquaredScale, 1e-9},
+	{"RSquaredFrom", pairedInputs, one(func(c statInputs) float64 { return stat.RSquaredFrom(c.x.x, c.y, c.w) }), rSquaredFromScale, 1e-9},
+	{"RNoughtSquared", rNoughtInputs, one(func(c statInputs) float64 { return stat.RNoughtSquared(c.x.x, c.y, c.w, c.extra[0].v) }), rNoughtScale, 1e-9},
+	{"Mode", plainInputs, two(func(c statInputs) (float64, float64) { return stat.Mode(c.x.x, c.w) }), unit, 1e-10},
+	{"StdErr", stdErrInputs, one(func(c statInputs) float64 { return stat.StdErr(c.extra[0].v, c.extra[1].v) }), stdErrScale, 1e-10},
+	{"StdScore", stdScoreInputs, one(func(c statInputs) float64 { return stat.StdScore(c.extra[0].v, c.extra[1].v, c.extra[2].v) }), stdScoreScale, 1e-10},
+	{"WassersteinDistance", wassersteinInputs, one(func(c statInputs) float64 {
+		if c.w == nil {
+			return stat.WassersteinDistance(c.x.x, c.y, nil, nil)
+		}
+		w, wy := c.split()
+		return stat.WassersteinDistance(c.x.x, c.y, w, wy)
+	}), maxAbsXY, 1e-9},
+}
+
+// statSpecOf is the spec of the function (for the narrow properties).
+func statSpecOf(name string) statSpec {
+	for _, s := range statSpecs {
+		if s.name == name {
+			return s
+		}
+	}
+	panic("no stat function " + name)
+}
+
+// statCase is a function and its inputs.
+type statCase struct {
+	fn statSpec
+	in statInputs
+}
+
+func (c statCase) GoString() string {
+	s := c.fn.name + "(x=" + c.in.x.GoString()
+	if c.in.y != nil {
+		s += ", y=" + hzShow(c.in.y)
+	}
+	if c.in.w != nil {
+		s += ", w=" + hzShow(c.in.w)
+	}
+	if len(c.in.extra) > 0 {
+		s += ", " + c.in.extra.GoString()
+	}
+	return s + ")"
+}
+
+// statCasesOf: the function applied to drawn inputs.
+func statCasesOf(name string, inputs hegel.Generator[statInputs]) hegel.Generator[statCase] {
+	s := statSpecOf(name)
+	return hegel.Map(inputs, func(in statInputs) statCase { return statCase{s, in} })
+}
+
+// statCases: a function of the table and inputs of its own generator.
+var statCases = hegel.FlatMap(hegel.SampledFrom(statSpecs), func(s statSpec) hegel.Generator[statCase] {
+	return hegel.Map(s.inputs, func(in statInputs) statCase { return statCase{s, in} })
+})
+
+// --------------------------------------------------------------------------- known shapes
+
+// statShape names the recorded bug whose shape the case has: HarmonicMean of an empty
+// dataset (gonum/37, a panic); a standard deviation of a nonempty dataset whose weighted
+// points have no spread (to 1e-7 of their magnitude; gonum/38, NaN when the weighted mean
+// is not the value: with the drawn weights one time in fifty, and one time in fifty
+// unweighted); Quantile with weights and p within 1e-12 of 1 (gonum/39, a panic when the
+// running weight sum rounds below the total: p = 1 only, one time in five with the drawn
+// weights of four points or more).
+func statShape(c statCase) string {
+	x, w := c.in.x.x, c.in.w
+	switch c.fn.name {
+	case "HarmonicMean":
+		if len(x) == 0 {
+			return "gonum/37"
+		}
+	case "Quantile":
+		if p := c.in.extra[0].v; w != nil && p >= 1-1e-12 && p <= 1 {
+			return "gonum/39"
+		}
+	case "StdDev", "PopStdDev", "MeanStdDev", "PopMeanStdDev":
+		if xw := hzWeighted(x, w); len(x) > 0 && hzSpread(xw) <= 1e-7*hzMaxAbs(xw) {
+			return "gonum/38"
+		}
+	}
+	return ""
+}
+
+// hzWeighted keeps the points with a nonzero weight.
+func hzWeighted(x, w []float64) []float64 {
+	if w == nil {
+		return x
+	}
+	var out []float64
+	for i, v := range x {
+		if w[i] != 0 {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// hzRSquaredScale: the residuals y - alpha - beta x cancel when the fitted values are far
+// larger than the spread of y, and the coefficient of determination is off by about
+// eps (|alpha| + |beta| max|x| + max|y|) / spread(y) absolutely (RSquared(x=[453000 283000
+// -379000 955000], y within 1 of 1.66e6, alpha=1.66e6) is 5e-8 off relatively for an R^2
+// of 6.6e-4). The tolerance is 1e-13 of that ratio (or of 1).
+func hzRSquaredScale(x, y, w []float64, alpha, beta float64) float64 {
+	yw := hzWeighted(y, w)
+	m := math.Abs(alpha) + math.Abs(beta)*hzMaxAbs(hzWeighted(x, w)) + hzMaxAbs(yw)
+	s := hzSpread(yw)
+	if s == 0 || m/s < 1 {
+		return 1
+	}
+	return m / s
+}
+
+func hzSpread(x []float64) float64 {
+	lo, hi := math.Inf(1), math.Inf(-1)
+	for _, v := range x {
+		lo, hi = math.Min(lo, v), math.Max(hi, v)
+	}
+	return hi - lo
+}
+
+func hzMaxAbs(xs ...[]float64) float64 {
+	m := 0.0
+	for _, s := range xs {
+		for _, v := range s {
+			if math.Abs(v) > m {
+				m = math.Abs(v)
+			}
+		}
+	}
+	return m
+}
+
+// --------------------------------------------------------------------------- the property
+
+func TestHegelStat(t *testing.T) {
+	o := hzStartOracle(t, hzOracleStat)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeStat(ht, o, c, hegel.Draw(ht, statCases))
+	})
+}
+
+// judgeStat asks the oracle about the case, calls the function and judges the result: a
+// case of a recorded bug's shape is judged like any other and fails naming the shape, or
+// under HEGEL_NO_KNOWN=1 is skipped (counted). The narrow properties of
+// hegel_zoo_shapes_stat_test.go judge their regions through it too.
+func judgeStat(ht *hegel.T, o *hzOracle, col *hzCollector, sc statCase) {
+	name, in := sc.fn.name, sc.in
+	shape := statShape(sc)
+	if shape != "" {
+		col.count("shape " + shape)
+		if noKnown {
+			col.count("known " + shape)
+			ht.Assume(false)
+		}
+	}
+	want, err := o.eval("Stat", hzS(name), hzA(in.x.x), hzA(in.y), hzA(in.w), hzB(in.w != nil), hzA(in.extra.list()))
+	if err != nil {
+		ht.Fatalf("%v", err)
+	}
+	var got []float64
+	pan := hzCatch(func() { got = sc.fn.call(in) })
+	note := ""
+	if shape != "" {
+		note = " (the shape of " + shape + ")"
+	}
+	switch want.t {
+	case "skip":
+		col.count("skip " + name)
+		return
+	case "panic":
+		if pan == nil {
+			col.failClass(ht, classOf(name+" no panic", nil, shape), "%#v = %v, want a panic%s", sc, got, note)
+			return
+		}
+		col.count("panic " + name)
+		return
+	}
+	if pan != nil {
+		col.failClass(ht, classOf(name+" panic", nil, shape), "%#v panicked: %v (want %v)%s", sc, pan, want, note)
+		return
+	}
+	exp := want.arr
+	if want.t == "n" {
+		exp = []float64{want.num}
+	}
+	if len(exp) != len(got) {
+		col.failClass(ht, classOf(name+" length", nil, shape), "%#v = %v, want %v%s", sc, got, want, note)
+		return
+	}
+	rtol, atol := sc.fn.rtol, 1e-13*sc.fn.scale(in)
+	for i := range exp {
+		if !hzClose(got[i], exp[i], rtol, atol) {
+			col.failClass(ht, classOf(name, nil, shape), "%#v = %v, want %v%s", sc, got, want, note)
+			return
+		}
+	}
+	col.count("ok " + name)
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..9126f4e
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,175 @@
+package hegel
+
+// Hegel property tests for gonum.org/v1/gonum, written for the Hegel zoo. See
+// targets/go/gonum/README.md. They live in a package of their own (hegel/) and drive the
+// public API of three packages: mathext (special functions), stat/distuv (univariate
+// distributions) and stat (descriptive statistics).
+//
+// Oracles: SciPy and NumPy over a JSON-lines subprocess (python3 with numpy and scipy on
+// PATH), the functions' documented definitions and special cases, and the library against
+// itself (a distribution's Quantile against its CDF, Survival against CDF, LogProb against
+// Prob).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing. HEGEL_NO_KNOWN=1 (noKnown) looks past the recorded bugs. Every generator is a
+// package-level value built from the binding's combinators over the shared number records of
+// hegel_zoo_gen_test.go (hegel_zoo_mathext_test.go, hegel_zoo_distuv_test.go,
+// hegel_zoo_stat_test.go); the shape regions of the recorded bugs are drawn by default and
+// named by the properties' classifiers (hegel_zoo_shapes_*_test.go, one narrow property per
+// bug); bugs.toml holds every value the code returns.
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// hzCall runs fn and returns its value and the panic it raised, if any.
+func hzCall(fn func() float64) (v float64, p any) {
+	defer func() {
+		if r := recover(); r != nil {
+			p = r
+			v = math.NaN()
+		}
+	}()
+	return fn(), nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shape regions (known) and a disagreement on one fails naming
+// the bug (TestHegelMathext, TestHegelDistuv and TestHegelStat are then expected failures
+// mapped to the bug they shrink to, beside the pins); under HEGEL_NO_KNOWN=1 the regions are
+// not drawn, a case that still has a shape of mathShape, distShape or statShape is skipped
+// (counted) or judged at the old relaxed tolerance, and the narrow properties draw the
+// neighbouring region instead.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// hzClose: a and b agree within rtol of the larger magnitude plus atol; NaN agrees with NaN,
+// infinities with the same infinity.
+func hzClose(a, b, rtol, atol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if math.IsInf(a, 0) || math.IsInf(b, 0) {
+		return a == b
+	}
+	d := math.Abs(a - b)
+	return d <= atol+rtol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+func hzShow(xs []float64) string {
+	if len(xs) > 12 {
+		return fmt.Sprintf("%v ... (%d values)", xs[:12], len(xs))
+	}
+	return fmt.Sprintf("%v", xs)
+}
