+        if not ((a <= 0 and isint(a) and a > c) or (b <= 0 and isint(b) and b > c)):
+            skip()
+    try:
+        v = mp.hyp2f1(a, b, c, z)
+    except Exception:  # noqa
+        skip()
+    if isinstance(v, mp.mpc):
