+    return F(v)
+
+def MvLgamma(v, dim):
+    chk(dim >= 1)
+    if v < (dim - 1) / 2:
+        return nan
+    s = mp.mpf(dim) * (dim - 1) / 4 * mp.log(mp.pi)
+    for i in range(1, dim + 1):
