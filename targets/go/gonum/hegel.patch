+// hzGenScale draws a scale parameter (positive, moderate).
+func hzGenScale(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 4) {
+	case 0:
+		return 1
+	case 1:
+		return float64(hzDrawInt(tc, 1, 40)) / 4
+	case 2:
+		return float64(hzDrawInt(tc, 1, 999)) / 1000
+	case 3:
+		return float64(hzDrawInt(tc, 1, 999)) * math.Pow(10, float64(hzDrawInt(tc, 0, 3)))
+	default:
+		return hzGenPos(tc)
+	}
+}
