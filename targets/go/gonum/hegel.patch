+    if a == 1:
+        return F(1 - (1 - mp.mpf(y)) ** (1 / mp.mpf(b)))
+    x0 = float(sp.betaincinv(a, b, y))
+    if not 0 < x0 < 1:
+        skip()
+    if max(a, b) > 1000:
+        # mpmath's incomplete beta does not converge here. For a tiny x the series is its leading
+        # term x^a (1-x)^b / (a B(a, b)) to 1e-18 (SciPy's inverse is 1e-7 off there); elsewhere
+        # polish SciPy's inverse against SciPy's incomplete beta
+        ma, mb, my = mp.mpf(a), mp.mpf(b), mp.mpf(y)
+        lb = mp.loggamma(ma) + mp.loggamma(mb) - mp.loggamma(ma + mb)
+        xl = mp.exp((mp.log(my) + mp.log(ma) + lb) / ma)
+        if (ma + mb) * xl / (ma + 1) < mp.mpf(10) ** -18 and mb * xl < mp.mpf(10) ** -18:
+            return F(xl)
+        r = refine(lambda t: mp.mpf(float(sp.betainc(a, b, float(t)))) - y, x0, min(y, 1 - y))
+        return x0 if r is None else r
+    if x0 < 1e-3:
