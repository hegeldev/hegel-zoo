+// hzPinNum: fn returns, without panicking, a value within rtol (and atol) of want.
+func hzPinNum(t *testing.T, desc string, fn func() float64, want, rtol, atol float64) {
+	t.Helper()
+	got, p := hzCall(fn)
+	if p != nil {
+		t.Errorf("%s panics: %v, want %v", desc, p, hzFmt(want))
+		return
+	}
+	if !hzClose(got, want, rtol, atol) {
+		t.Errorf("%s = %v, want %v", desc, hzFmt(got), hzFmt(want))
+	}
+}
+
+// hzPinPanics: fn panics.
+func hzPinPanics(t *testing.T, desc string, fn func() float64) {
+	t.Helper()
+	got, p := hzCall(fn)
+	if p == nil {
+		t.Errorf("%s = %v, want a panic", desc, hzFmt(got))
+	}
+}
