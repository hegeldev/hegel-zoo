+def Zeta(x, q):
+    if x == 1:
+        return inf
+    chk(x > 1)
+    chk(not (q <= 0 and isint(q)))
+    chk(not (q < 0 and not isint(x)))
+    return F(hurwitz(x, q))
+
+def hurwitz(s, q):
+    # Euler-Maclaurin: sum_{k<N} (k+q)^-s + w^(1-s)/(s-1) + w^-s/2 + sum_j B_2j/(2j)! s(s+1)..(s+2j-2) w^(1-s-2j),
+    # w = N + q, with N large enough that the tail converges (w > s/2). mpmath's own zeta(s, q)
+    # loses digits for large q and s (zeta(45.6, 900) is 1.3e-9 off at 30 digits, 8e-11 off at 80).
+    with mp.workdps(40):
+        s, q = mp.mpf(s), mp.mpf(q)
+        pw = (lambda b: b ** -int(s)) if isint(s) else (lambda b: b ** -s)
+        N = max(50, int(mp.ceil(s / 2 - q)) + 1)
+        if q < 0:
+            N = max(N, int(mp.ceil(-q)) + 50)
+        elif s > 100:
+            # the direct sum converges fast when q is small against s
+            K = int(mp.ceil(q * (mp.mpf(10) ** (40 / s) - 1))) + 2
+            if K < N:
+                return sum(pw(k + q) for k in range(K))
+        if N > 20000:
+            skip()
+        tot = mp.fsum(pw(k + q) for k in range(N))
+        w = N + q
+        tot += pw(w) * w / (s - 1) + pw(w) / 2
+        for j in range(1, 40):
+            term = mp.bernoulli(2 * j) / mp.factorial(2 * j) * mp.rf(s, 2 * j - 1) * pw(w) * w ** (1 - 2 * j)
+            tot += term
+            if abs(term) < mp.mpf(10) ** -38 * abs(tot):
+                break
+        return tot
+
+def NormalQuantile(p):
+    chk(0 <= p <= 1)
+    return float(st.norm.ppf(p))
