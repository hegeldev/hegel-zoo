+
+// weibullLargeK: Weibull{K, Lambda in quarters}'s Skewness and ExKurtosis for K = m 10^e in
+// [1e3, 9.9e7] (the combinations of Gamma(1 + i/K) cancel to 1/K^3 and 1/K^4; measured: 3e-7
+// and 3e-4 off at 1e3, 6e-9 and 6e-7 at 200) and its Variance and StdDev for K in [1e5,
+// 9.9e7] (measured: 2e-6 and 1e-6 off at 1e5 against the 1e-7 tolerance beyond 1e4; 3e4 is
+// 8e-8 off); past the shape, K in halves to 10.
+var (
+	weibullMoments = pick("Variance", "StdDev", "Skewness", "ExKurtosis")
+	weibullLargeK  = hegel.OneOf(
+		onOne(pick("Skewness", "ExKurtosis"), tuple(shaped(decimals(1, 99, 3, 6), scaled(ints(1, 20), 0.5)), tailScales)),
+		onOne(pick("Variance", "StdDev"), tuple(shaped(decimals(1, 99, 5, 6), scaled(ints(1, 20), 0.5)), tailScales)),
+	)
+)
+
+func TestHegelWeibullMomentsForALargeK(t *testing.T) {
+	narrowDist(t, casesOf("Weibull", weibullLargeK))
+}
+
+// --------------------------------------------------------------------------- gonum/34
+
+// weibullTinyK: Weibull{K = m 10^-e in [1e-5, 9e-3], Lambda}'s Variance, StdDev, Skewness and
+// ExKurtosis (Gamma(1 + 2/K) overflows from 2/K = 172, and Inf - Inf is NaN; measured: NaN
+// throughout, where the moment is finite - Weibull{0.005, 1e-150}.StdDev() is 2.5e284 - or
+// really infinite; K = 0.015 is exact); past the shape, K in halves to 10.
+var weibullTinyK = onOne(weibullMoments, tuple(shaped(decimals(1, 9, -5, -3), scaled(ints(1, 20), 0.5)), scales))
+
+func TestHegelWeibullMomentsForATinyK(t *testing.T) {
+	narrowDist(t, casesOf("Weibull", weibullTinyK))
+}
+
+// --------------------------------------------------------------------------- gonum/35
+
+// logNormalSmallSigma: LogNormal{Mu in tenths to 100, Sigma = m 10^-e in [1e-8, 9e-6]}'s
+// Variance, StdDev, Skewness and ExKurtosis (exp(Sigma^2) - 1 cancels; measured against the
+// expm1 forms: 4e-8 off at least at 1e-5, 0 at 1e-8; 1e-4 is 2e-9 to 1e-8 off, 3e-4 is right
+// to 7e-10); past the shape, Sigma in quarters.
+var logNormalSmallSigma = onOne(weibullMoments, tuple(tailLocations, shaped(decimals(1, 9, -8, -6), tailScales)))
+
+func TestHegelLogNormalMomentsForASmallSigma(t *testing.T) {
+	narrowDist(t, casesOf("LogNormal", logNormalSmallSigma))
+}
+
+// --------------------------------------------------------------------------- gonum/36
+
+// poissonLargeLambda: Poisson{Lambda = m 10^e in [1e9, 9.9e15]}'s densities at floor(Lambda)
+// plus an integer to 3 either side (x log Lambda - Lambda - lgamma(x + 1) cancels; measured:
+// Prob 5e-7 and LogProb 4e-8 off at 1e9, 4e-8 and 4e-9 at 1e8, right to 2e-10 at 1e5; above
+// 2^53 the argument is not an integer apart); past the shape, Lambda in quarters.
+var poissonLargeLambda = onOne(densities, hegel.Map(args(tuple(shaped(decimals(1, 99, 9, 14), quarters)), scaled(ints(-3, 3), 1)), func(a []float64) []float64 {
+	return []float64{a[0], math.Floor(a[0]) + a[1]}
+}))
+
+func TestHegelPoissonDensitiesForALargeLambda(t *testing.T) {
+	narrowDist(t, casesOf("Poisson", poissonLargeLambda))
+}
+
+// --------------------------------------------------------------------------- gonum/4, 5, 6, 7, 9
+// (the mathext regions the distributions inherit)
+
+// tinyAnswers: 10^-e for e in 11..15 (gonum/4: the inverse regularized gamma returns 0 where
+// the answer is below 1e-18); the Quantile of Gamma{Alpha in [0.06, 0.6]}, of ChiSquared and
+// Chi{K in [0.12, 1.2]} (K/2 there), and of StudentsT{Nu < 0.1} at any p.
+var (
+	tinyAnswers             = hegel.Map(ints(11, 15), func(e int) float64 { return pow10(-e) })
+	gammaQuantileTiny       = on("Quantile", args(tuple(scaled(ints(6, 60), 0.01), scales), tinyAnswers))
+	chiSquaredQuantileTiny  = on("Quantile", args(tuple(scaled(ints(12, 120), 0.01)), tinyAnswers))
+	chiQuantileTiny         = on("Quantile", args(tuple(scaled(ints(12, 120), 0.01)), tinyAnswers))
+	studentsTQuantileTinyNu = on("Quantile", args(tuple(locations, scales, scaled(ints(1, 99), 1e-3)), probabilities))
+)
+
+// inverseGammaQuantileNearOne: InverseGamma.Quantile within 10^-e of 1 for e in 7..15
+// (gonum/5: the complement's inverse near 1).
+var inverseGammaQuantileNearOne = on("Quantile", args(tuple(shapes, scales), hegel.Map(ints(7, 15), func(e int) float64 { return 1 - pow10(-e) })))
+
+// withinOfTheEnds: 10^-e or 1 - 10^-e for e in 7..15 (gonum/6: the inverse regularized beta
+// within 1e-6 of 0 or 1); the Quantile of Beta, F and StudentsT there.
+var (
+	withinOfTheEnds = hegel.Map(counts(ints(7, 15), ints(0, 1)), func(v []int) float64 {
+		if v[1] == 0 {
+			return pow10(-v[0])
+		}
+		return 1 - pow10(-v[0])
+	})
+	betaQuantileEnds      = on("Quantile", args(tuple(shapes, shapes), withinOfTheEnds))
+	fQuantileEnds         = on("Quantile", args(tuple(shapes, shapes), withinOfTheEnds))
+	studentsTQuantileEnds = on("Quantile", args(tuple(locations, scales, shapes), withinOfTheEnds))
+)
+
+// The regularized incomplete beta with a second parameter below 1 and x within 1e-3 of 1
+// (gonum/7): Beta{Alpha, Beta < 1}.CDF within d 10^-5 of 1, Beta{Alpha < 1, Beta}.Survival at
+// m 10^-e in [1e-9, 9e-4], F{D1, D2 tiny}.CDF with D2/(D1 x) = m 10^-e for e in 4..11.
+var (
+	betaCDFNearOne       = on("CDF", args(tuple(shapes, scaled(ints(1, 999), 1e-3)), hegel.Map(ints(5, 10), func(d int) float64 { return 1 - float64(d)*1e-5 })))
+	betaSurvivalNearZero = on("Survival", args(tuple(scaled(ints(1, 999), 1e-3), shapes), decimals(1, 9, -9, -4)))
+	fCDFTinyD2           = on("CDF", hegel.Map(args(tuple(fD1s, fTinyD2s), decimals(1, 9, -11, -4)), fAtRatio))
+)
+
+// betaEntropies: Beta's entropy, a sum of digammas (gonum/9).
+var betaEntropies = on("Entropy", tuple(shapes, shapes))
+
+// --------------------------------------------------------------------------- by distribution
+// (the shape regions each distribution of the table draws through known)
+
+var (
+	logisticShapes     = hegel.OneOf(logisticLogProbIgnored, logisticFarTails, logisticQuantileChecks, logisticSurvivalTail)
+	normalShapes       = normalSurvivalTail
+	betaShapes         = hegel.OneOf(betaQuantileEnds, betaCDFNearOne, betaSurvivalNearZero, betaEntropies)
+	binomialShapes     = hegel.OneOf(binomialLogProbTinyP, binomialDegenerate, binomialSurvivalTail)
+	chiShapes          = hegel.OneOf(chiNegative, chiAtOne, chiLargeMoments, chiQuantileTiny)
+	chiSquaredShapes   = hegel.OneOf(chiSquaredNegative, chiSquaredAtTwo, chiSquaredQuantileTiny)
+	exponentialShapes  = exponentialQuantileTail
+	fShapes            = hegel.OneOf(fCDFNearOne, fNegative, fDensityAtZero, fSurvivalTail, fQuantileEnds, fCDFTinyD2)
+	gammaShapes        = gammaQuantileTiny
+	gumbelShapes       = gumbelSurvivalTail
+	inverseGammaShapes = hegel.OneOf(inverseGammaNegative, inverseGammaQuantileNearOne)
+	laplaceShapes      = laplaceQuantileTail
+	logNormalShapes    = hegel.OneOf(logNormalNonPositive, logNormalSmallSigma, logNormalSurvivalTail)
+	nctShapes          = hegel.OneOf(nctQuantileChecks, nctBracketBound, nctLargeMu, nctDensityLargeNu, nctCDFFarOut, nctTinyNu)
+	poissonShapes      = hegel.OneOf(poissonZero, poissonLargeLambda, poissonSurvivalTail)
+	studentsTShapes    = hegel.OneOf(studentsTCenter, studentsTQuantileTinyNu, studentsTQuantileEnds)
+	triangleShapes     = hegel.OneOf(triangleFarFromZero, triangleSurvivalTail)
+	weibullShapes      = hegel.OneOf(weibullQuantileTail, weibullUnitShape, weibullLargeK, weibullTinyK)
+)
diff --git a/hegel/hegel_zoo_shapes_mathext_test.go b/hegel/hegel_zoo_shapes_mathext_test.go
