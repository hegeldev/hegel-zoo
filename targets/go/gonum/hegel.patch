+// --------------------------------------------------------------------------- numbers
+
+// hzGenNum draws a number of one of several magnitude profiles; neg allows negatives.
+func hzGenNum(tc hegel.TestCase, neg bool) float64 {
+	var v float64
+	switch hzDrawInt(tc, 0, 9) {
+	case 0: // small integers
+		v = float64(hzDrawInt(tc, 0, 10))
+	case 1: // halves and quarters
+		v = float64(hzDrawInt(tc, 0, 40)) / 4
+	case 2: // unit interval, three decimals
+		v = float64(hzDrawInt(tc, 0, 1000)) / 1000
+	case 3: // tenths to 100
+		v = float64(hzDrawInt(tc, 0, 1000)) / 10
+	case 4: // tiny
+		v = float64(hzDrawInt(tc, 1, 999)) * math.Pow(10, -float64(hzDrawInt(tc, 3, 12)))
+	case 5: // large
+		v = float64(hzDrawInt(tc, 1, 999)) * math.Pow(10, float64(hzDrawInt(tc, 1, 6)))
+	case 6: // huge
+		v = float64(hzDrawInt(tc, 1, 999)) * math.Pow(10, float64(hzDrawInt(tc, 7, 100)))
+	case 7: // arbitrary binary fraction
+		v = float64(hzDrawInt(tc, 0, 1<<30)) / float64(int64(1)<<hzDrawInt(tc, 0, 40))
+	case 8: // near integers
+		v = float64(hzDrawInt(tc, 0, 50)) + float64(hzDrawInt(tc, -3, 3))*1e-9
+	default: // integers to 1000
+		v = float64(hzDrawInt(tc, 0, 1000))
+	}
+	if neg && hzChance(tc, 40) {
+		v = -v
+	}
+	return v
+}
+
+// hzGenPos draws a positive number (never 0).
+func hzGenPos(tc hegel.TestCase) float64 {
+	for i := 0; i < 20; i++ {
+		if v := hzGenNum(tc, false); v > 0 {
+			return v
+		}
+	}
+	return 1
+}
+
+// hzGenProb draws a probability in [0, 1] with the ends and tiny values included.
+func hzGenProb(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		return 0
+	case 1:
+		return 1
+	case 2:
+		return math.Pow(10, -float64(hzDrawInt(tc, 2, 15)))
+	case 3:
+		return 1 - math.Pow(10, -float64(hzDrawInt(tc, 2, 15)))
+	case 4:
+		return 0.5
+	default:
+		return float64(hzDrawInt(tc, 1, 9999)) / 10000
+	}
+}
+
+// hzClose: a and b agree within rtol of the larger magnitude plus atol; NaN agrees with NaN,
+// infinities with the same infinity.
+func hzClose(a, b, rtol, atol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if math.IsInf(a, 0) || math.IsInf(b, 0) {
+		return a == b
+	}
+	d := math.Abs(a - b)
+	return d <= atol+rtol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+func hzShow(xs []float64) string {
+	if len(xs) > 12 {
+		return fmt.Sprintf("%v ... (%d values)", xs[:12], len(xs))
+	}
+	return fmt.Sprintf("%v", xs)
+}
