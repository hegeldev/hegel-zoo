diff --git a/hegel/hegel_zoo_shapes_distuv_test.go b/hegel/hegel_zoo_shapes_distuv_test.go
new file mode 100644
index 0000000..357ef52
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_distuv_test.go
@@ -0,0 +1,660 @@
+package hegel
+
+// The shape regions of the recorded distuv bugs (bugs.toml gonum/14..36) and of the five
+// mathext bugs the distributions inherit (gonum/4, 5, 6, 7, 9), and a narrow property over
+// each of the twenty-three (gonum/14..36): each region is a generator over the bug's shape
+// with random contents, judged exactly like the wide property (judgeDist: the oracle, the
+// strict tolerance, the classifier naming the shape). Every narrow property fails every run
+// by default; under HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (shaped(shape, past)) and the property passes. The wide property TestHegelDistuv draws the
+// regions of each distribution one time in three by weight by default (known) and never
+// under HEGEL_NO_KNOWN=1. The edges of the regions were measured against the oracle at the
+// strict tolerance (the gonum/26..36 regions with hzprobe, a grid of calls compared through
+// the oracle's own code); the comments quote them. Where a region covers several
+// distributions (gonum/27, 28, 30) the narrow property is a OneOf, the simplest first.
+
+import (
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat/distuv"
+)
+
+// on is the call of the method at the drawn arguments: the parameters followed by the
+// argument (the parameters alone for a moment).
+func on(method string, args hegel.Generator[[]float64]) hegel.Generator[distCall] {
+	return hegel.Map(args, func(a []float64) distCall {
+		if isMoment(method) {
+			return distCall{method, a, 0}
+		}
+		return distCall{method, a[:len(a)-1], a[len(a)-1]}
+	})
+}
+
+// onOne is the call of one of the methods.
+func onOne(methods hegel.Generator[string], args hegel.Generator[[]float64]) hegel.Generator[distCall] {
+	return hegel.FlatMap(methods, func(m string) hegel.Generator[distCall] { return on(m, args) })
+}
+
+// args is the parameter list followed by the argument.
+func args(params hegel.Generator[[]float64], x hegel.Generator[float64]) hegel.Generator[[]float64] {
+	return hegel.FlatMap(params, func(p []float64) hegel.Generator[[]float64] {
+		return hegel.Map(x, func(v float64) []float64 { return append(append([]float64{}, p...), v) })
+	})
+}
+
+// offsetBy renders [Mu, S, t] into [Mu, S, Mu + S t]: an argument t scales out.
+func offsetBy(a []float64) []float64 { return []float64{a[0], a[1], a[0] + a[1]*a[2]} }
+
+// signedInts is an integer in [lo, hi] of either sign.
+func signedInts(lo, hi int) hegel.Generator[float64] {
+	return hegel.Map(counts(ints(lo, hi), ints(0, 1)), func(v []int) float64 { return sign(v[1]) * float64(v[0]) })
+}
+
+// decimals is m 10^e for m in [mLo, mHi] and e in [eLo, eHi].
+func decimals(mLo, mHi, eLo, eHi int) hegel.Generator[float64] {
+	return hegel.Map(counts(ints(mLo, mHi), ints(eLo, eHi)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) })
+}
+
+var (
+	densities   = pick("LogProb", "Prob")
+	cumulatives = pick("CDF", "Survival")
+)
+
+// narrowDist runs a narrow property: every drawn case through the wide property's judge.
+func narrowDist(t *testing.T, cases hegel.Generator[distCase]) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeDist(ht, o, c, hegel.Draw(ht, cases))
+	})
+}
+
+// --------------------------------------------------------------------------- gonum/14
+
+// oddTenths: (2k + 1)/10 to 100 either side: never 0, and never twice a tenth, so that an
+// argument offset in tenths is never -Mu/2 (the standard log density is even: at Mu + t it
+// equals the one at t only for Mu = 0 or Mu = -2t).
+var oddTenths = hegel.Map(ints(-500, 499), func(k int) float64 { return float64(2*k+1) / 10 })
+
+// quartersButOne: k/4 to 10 except 1 (with Mu = 0 a scale of 1 shows nothing).
+var quartersButOne = hegel.Map(ints(1, 39), func(k int) float64 {
+	if k >= 4 {
+		k++
+	}
+	return float64(k) / 4
+})
+
+// logisticLogProbIgnored: Logistic{Mu, 1}.LogProb(Mu + t) for an odd-tenths Mu and t in tenths
+// to 30 (gonum returns the standard log density at Mu + t instead of the one at t; measured:
+// off by 6e-4 absolute at least), and Logistic{0, S}.LogProb(0) for S not 1 (off by log S).
+// Past the shape: the density Prob at the same arguments, which is right.
+var logisticLogProbIgnored = shaped(
+	hegel.OneOf(
+		on("LogProb", hegel.Map(args(tuple(oddTenths, hegel.Just(1.0)), scaled(ints(-300, 300), 0.1)), offsetBy)),
+		on("LogProb", args(tuple(hegel.Just(0.0), quartersButOne), hegel.Just(0.0))),
+	),
+	on("Prob", hegel.Map(args(tuple(oddTenths, quartersButOne), scaled(ints(-300, 300), 0.1)), offsetBy)),
+)
+
+func TestHegelLogisticLogProbIgnoresItsParameters(t *testing.T) {
+	narrowDist(t, casesOf("Logistic", logisticLogProbIgnored))
+}
+
+// --------------------------------------------------------------------------- gonum/15
+
+// logisticFarTails: Logistic{Mu, S}.Prob(Mu + S z) for Mu in tenths to 100, S in quarters to
+// 10 and z in [-630, -356] in tenths (the squared 1 + e^-z overflows: 0 where the density is
+// representable; measured: wrong throughout) or in [-2000, -710] (Inf/Inf: NaN); past the
+// shape, z in [-300, -1] (exact).
+var logisticFarTails = on("Prob", hegel.Map(args(tuple(scaled(ints(-1000, 1000), 0.1), scaled(ints(1, 40), 0.25)), shaped(
+	hegel.OneOf(scaled(ints(-6300, -3560), 0.1), scaled(ints(-20000, -7100), 0.1)),
+	scaled(ints(-3000, -10), 0.1),
+)), offsetBy))
+
+func TestHegelLogisticProbInTheFarTails(t *testing.T) {
+	narrowDist(t, casesOf("Logistic", logisticFarTails))
+}
+
+// --------------------------------------------------------------------------- gonum/16
+
+// badProbabilities: outside [0, 1].
+var badProbabilities = hegel.OneOf(
+	pick(-0.1, 1.1, -1.0, 2.0, math.Inf(1)),
+	negatives,
+	hegel.Map(positives, func(v float64) float64 { return 1 + v }),
+)
+
+// logisticQuantileChecks: Logistic.Quantile outside [0, 1] (NaN where the panic is due);
+// past the shape, inside it in thousandths.
+var logisticQuantileChecks = on("Quantile", args(tuple(locations, scales), shaped(badProbabilities, interior)))
+
+// nctQuantileChecks: NoncentralT{Nu <= 3, |Mu| <= 37}.Quantile at 0 or 1 (NaN, or -1, where
+// the infinities are due) or outside [0, 1] (NaN where the panic is due: above Nu = 3 the
+// normal first guess panics); past the shape, p in [0.05, 0.95] in hundredths with an
+// integer Nu to 200.
+var nctQuantileChecks = on("Quantile", shaped(
+	args(tuple(scaled(ints(1, 6), 0.5), scaled(ints(-37, 37), 1)), hegel.OneOf(ends, badProbabilities)),
+	args(tuple(scaled(ints(1, 200), 1), scaled(ints(-37, 37), 1)), scaled(ints(5, 95), 0.01)),
+))
+
+func TestHegelQuantileSkipsItsArgumentChecks(t *testing.T) {
+	narrowDist(t, hegel.OneOf(casesOf("Logistic", logisticQuantileChecks), casesOf("NoncentralT", nctQuantileChecks)))
+}
+
+// --------------------------------------------------------------------------- gonum/17
+
+// nctNarrowNus: Nu in halves to 10, hundredths to 1, integers to 200 and hundreds to 3000.
+var nctNarrowNus = hegel.OneOf(
+	scaled(ints(1, 20), 0.5),
+	scaled(ints(1, 99), 0.01),
+	scaled(ints(1, 200), 1),
+	scaled(ints(3, 30), 100),
+)
+
+// nearTheEnds: p within 1e-2 of 0 or 1, by 1e-4 at least.
+var nearTheEnds = hegel.Map(counts(ints(1, 100), ints(0, 1)), func(v []int) float64 {
+	if v[1] == 0 {
+		return float64(v[0]) * 1e-4
+	}
+	return 1 - float64(v[0])*1e-4
+})
+
+// notInverted: the library's own CDF does not invert its Quantile (the bracket search gave
+// up, or stopped at its bound).
+func notInverted(a []float64) bool {
+	d := distuv.NoncentralT{Nu: a[0], Mu: a[1]}
+	q := d.Quantile(a[2])
+	return math.IsNaN(q) || !hzClose(d.CDF(q), a[2], 1e-3, 0)
+}
+
+// nctBracketBound: NoncentralT{Nu in [0.01, 0.1], |Mu| <= 5}.Quantile(p) for p near the ends
+// (the quantile of so small a Nu lies far beyond 2^24, the bracket bound, and the bound or a
+// fraction of it is returned; measured: wrong at every probed point), kept where the
+// library's own CDF does not invert its Quantile (hegel.Filter, three tries); past the shape,
