+package hegel
+
+// TestHegelDistuv: the univariate distributions of gonum.org/v1/gonum/stat/distuv agree with
+// SciPy (scipy.stats), with mpmath for the moments that cancel, and with their documented
+// special cases. A case is a distribution of the table, a method it has, parameters from the
+// distribution's own generators (package-level values over the shared number profiles of
+// hegel_zoo_gen_test.go) and an argument: a point of the support, a number, or for a discrete
+// distribution a small integer; the shape regions of the recorded bugs gonum/14-36 and of the
+// five mathext bugs the distributions inherit (hegel_zoo_shapes_distuv_test.go, one narrow
+// property per bug for gonum/14-25) are drawn one time in three by weight and judged at the strict
+// tolerance like every other case, so the property fails naming the shape (distShape,
+// distShapeOf) and is an expected failure beside the pins; HEGEL_NO_KNOWN=1 looks past them:
+// the regions are not drawn, a case that still has a shape is skipped (a wrong region) or
+// judged at the relaxed tolerance (the entropies, gonum/9). TestHegelDistuvOther covers
+// AlphaStable's closed-form moments and Categorical (no recorded bug); TestHegelDistuvLaws
+// checks a distribution against itself (Survival against CDF, Prob against LogProb, Quantile
+// against CDF).
+
+import (
+	"math"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat/distuv"
+)
+
+const hzOracleDistuv = `
+def nanif(cond, v):
+    return nan if cond else v
+
+def D_Bernoulli(P):
+    d = st.bernoulli(P)
+    # SciPy's kurtosis is 1e-4 off for P = 1 - 1e-12 and its variance 1e-9 off for P = 1 - 1e-8;
+    # the textbook formulas in doubles
+    ex = {
+        "Variance": P * (1 - P), "StdDev": math.sqrt(P * (1 - P)),
+        "Median": 0.0 if P < 0.5 else 1.0 if P > 0.5 else 0.5,
+        "Skewness": (1 - 2 * P) / math.sqrt(P * (1 - P)) if 0 < P < 1 else skip,
+        "ExKurtosis": (1 - 6 * P * (1 - P)) / (P * (1 - P)) if 0 < P < 1 else skip,
+        "Quantile": lambda p: (chk(0 <= p <= 1), 0.0 if p <= 1 - P else 1.0)[1],
+    }
+    if P in (0, 1):
+        ex["Skewness"] = skip
+        ex["ExKurtosis"] = skip
+    return d, True, ex
+
+def D_Beta(a, b):
+    d = st.beta(a, b)
+    if a <= 1:
+        mode = nan if b <= 1 else 0.0
+    elif b <= 1:
+        mode = 1.0
+    else:
+        mode = (a - 1) / (a + b - 2)
+    return d, False, {"Mode": mode}
+
+def D_Binomial(N, P):
+    d = st.binom(int(N), P)
+    # SciPy's variance is 8e-9 off for P = 0.999999999; the textbook value in doubles
+    ex = {"Variance": N * P * (1 - P), "StdDev": math.sqrt(N * P * (1 - P))}
+    if N > 0 and 0 < P < 1:
+        ex["Skewness"] = (1 - 2 * P) / math.sqrt(N * P * (1 - P))
+        ex["ExKurtosis"] = (1 - 6 * P * (1 - P)) / (N * P * (1 - P))
+    if N == 0 or P in (0, 1):
+        ex["Skewness"] = skip
+        ex["ExKurtosis"] = skip
+    return d, True, ex
+
+def chi_moments(K):
+    with mp.workdps(90):  # the variance K - mean^2 cancels to 1/2 for K up to 1e16
+        K = mp.mpf(K)
+        mean = mp.sqrt(2) * mp.exp(mp.loggamma((K + 1) / 2) - mp.loggamma(K / 2))
+        var = K - mean ** 2
+        sd = mp.sqrt(var)
+        skew = mean / sd ** 3 * (1 - 2 * var)
+        kurt = 2 / var * (1 - mean * sd * skew - var)
+        return {"Mean": F(mean), "Variance": F(var), "StdDev": F(sd), "Skewness": F(skew), "ExKurtosis": F(kurt)}
+
+def D_Chi(K):
+    ex = chi_moments(K)
+    ex["Mode"] = nan if K < 1 else math.sqrt(K - 1)
+    return st.chi(K), False, ex
+
+def D_ChiSquared(K):
+    return st.chi2(K), False, {"Mode": max(K - 2, 0.0)}
+
+def D_Exponential(rate):
+    return st.expon(scale=1 / rate), False, {"Mode": 0.0}
+
+def D_F(d1, d2):
+    d = st.f(d1, d2)
+    return d, False, {
+        "Mean": nan if d2 <= 2 else d2 / (d2 - 2),
+        "Mode": nan if d1 <= 2 else (d1 - 2) / d1 * d2 / (d2 + 2),
+        "Skewness": nan if d2 <= 6 else float(d.stats(moments="s")),
+        "Variance": nan if d2 <= 4 else float(d.var()),
+        "StdDev": nan if d2 <= 4 else float(d.std()),
+        "ExKurtosis": nan if d2 <= 8 else float(d.stats(moments="k")),
+    }
+
+def D_Gamma(a, b):
+    return st.gamma(a, scale=1 / b), False, {"Mode": 0.0 if a < 1 else (a - 1) / b}
+
+def D_GumbelRight(mu, beta):
+    return st.gumbel_r(loc=mu, scale=beta), False, {"Mode": mu}
+
+def D_InverseGamma(a, b):
+    d = st.invgamma(a, scale=b)
+    return d, False, {
+        "Mode": b / (a + 1),
+        "Mean": inf if a <= 1 else b / (a - 1),
+        "Variance": inf if a <= 2 else float(d.var()),
+        "StdDev": inf if a <= 2 else float(d.std()),
+        "ExKurtosis": inf if a <= 4 else float(d.stats(moments="k")),
+    }
+
+def D_Laplace(mu, scale):
+    return st.laplace(loc=mu, scale=scale), False, {"Mode": mu}
+
+def D_Logistic(mu, s):
+    return st.logistic(loc=mu, scale=s), False, {"Mode": mu}
+
+def D_LogNormal(mu, sigma):
+    if abs(mu) > 300:
+        skip()  # SciPy's scale exp(mu) overflows or underflows
+    ex = {"Mode": math.exp(mu - sigma * sigma)}
+    if sigma > 20:
+        for m in ("Mean", "Variance", "StdDev", "Skewness", "ExKurtosis", "Mode"):
+            ex[m] = skip  # the moments overflow
+    return st.lognorm(sigma, scale=math.exp(mu)), False, ex
+
+def ncdf(a):
+    return mp.mpf(1) if a > 40 else mp.mpf(0) if a < -40 else mp.ncdf(a)
+
+def npdf(a):
+    return mp.mpf(0) if abs(a) > 40 else mp.npdf(a)
+
+def nct_quad(f, nu, mu, x):
+    # the integral of f(v) against the chi-squared(nu) density, with breakpoints at its bulk and
+    # where x sqrt(v/nu) = mu (checked against the central t and SciPy: NoncentralT oracle)
+    nu, mu, x = mp.mpf(nu), mp.mpf(mu), mp.mpf(x)
+    vx = nu * (mu / x) ** 2 if mu != 0 and x != 0 else None
+    if nu < 1:
+        # u = v^(nu/2): the density of u is (2/nu) exp(-u^(2/nu)/2) / (2^(nu/2) Gamma(nu/2)), smooth at 0
+        c = 2 / nu / (2 ** (nu / 2) * mp.gamma(nu / 2))
+        pts = {mp.mpf(k) for k in (0.25, 0.5, 1, 1.5, 2, 3)}
+        if vx is not None:
+            ux = vx ** (nu / 2)
+            pts |= {ux / 4, ux / 2, ux, 2 * ux, 4 * ux}
+        pts = [0] + sorted(u for u in pts if u < 10) + [10, mp.inf]
+        return mp.quad(lambda u: f(u ** (2 / nu)) * c * mp.exp(-u ** (2 / nu) / 2), pts)
+    # s = log v: the density is exp((nu/2) s - e^s/2) / (2^(nu/2) Gamma(nu/2))
+    lc = -(nu / 2) * mp.log(2) - mp.loggamma(nu / 2)
+    pts = {mp.log(nu) + k for k in (-150, -80, -40, -20, -10, -5, -2, -1, 0, 1, 2)}
+    s = mp.sqrt(2 * nu)
+    pts |= {mp.log(nu + k * s) for k in (-8, -4, -2, -1, 1, 2, 4, 8) if nu + k * s > 0}
+    if vx is not None:
+        pts |= {mp.log(vx) + k for k in (-3, -1, 0, 1, 3)}
+    hi = mp.log(nu + 8 * s) + 2
+    pts = sorted(q for q in pts if q < hi) + [hi]
+    return mp.quad(lambda q: f(mp.exp(q)) * mp.exp((nu / 2) * q - mp.exp(q) / 2 + lc), pts)
+
+def nct_cdf(x, nu, mu):
+    # P(T <= x) for T = (Z + mu) / sqrt(V / nu): the normal CDF averaged over V
+    if x == inf:
+        return 1.0
+    if x == -inf:
+        return 0.0
+    return F(nct_quad(lambda v: ncdf(mp.mpf(x) * mp.sqrt(v / nu) - mu), nu, mu, x))
+
+def nct_pdf(x, nu, mu):
+    if math.isinf(x):
+        return 0.0
+    return nct_quad(lambda v: mp.sqrt(v / nu) * npdf(mp.mpf(x) * mp.sqrt(v / nu) - mu), nu, mu, x)
+
+def D_NoncentralT(nu, mu):
+    if abs(mu) > 1e6 or (abs(mu) > 37 and nu < 1e-3):
+        skip()  # the quadrature below is slow for a tiny nu
+    d = st.nct(nu, mu)
+    ex = {
+        "Mean": nan if nu <= 1 else float(d.mean()),
+        "Variance": nan if nu <= 2 else float(d.var()),
+        "Quantile": lambda p: (chk(0 <= p <= 1), -inf if p == 0 else inf if p == 1 else float(d.ppf(p)))[1],
+    }
+    if abs(mu) > 37:
+        # SciPy's series is only valid to |mu| = 37.6 (nct(171, 236).logpdf(127) = -11.8, want -194.6)
+        ex["CDF"] = lambda x: nct_cdf(x, nu, mu)
+        ex["Prob"] = lambda x: F(nct_pdf(x, nu, mu))
+        ex["LogProb"] = lambda x: F(mp.log(nct_pdf(x, nu, mu))) if nct_pdf(x, nu, mu) > 0 else -inf
+        ex["Quantile"] = skip
+    else:
+        # SciPy's CDF and density are NaN (or raise) in the far tails: nct(171, 20).cdf(-2),
+        # nct(172, 3.19).pdf(-29), nct(1000, -3).pdf(3)
+        def sp_or(f, alt):
+            try:
+                v = float(f())
+            except (OverflowError, FloatingPointError, ValueError):
+                return alt()
+            return alt() if math.isnan(v) else v
+        slow = nu < 1e-3  # the quadrature is slow for a tiny nu: not judged where SciPy fails
+        ex["CDF"] = lambda x: sp_or(lambda: d.cdf(x), lambda: skip() if slow else nct_cdf(x, nu, mu))
+        ex["Prob"] = lambda x: sp_or(lambda: d.pdf(x), lambda: skip() if slow else F(nct_pdf(x, nu, mu)))
+        ex["LogProb"] = lambda x: sp_or(lambda: d.logpdf(x), lambda: skip() if slow else F(mp.log(nct_pdf(x, nu, mu))))
+    return d, False, ex
+
+def D_Normal(mu, sigma):
+    return st.norm(mu, sigma), False, {"Mode": mu}
+
+def D_Pareto(xm, a):
+    d = st.pareto(a, scale=xm)
+    ma = mp.mpf(a)
+    return d, False, {
+        "Mode": xm,
+        "Median": F(mp.mpf(xm) * mp.mpf(2) ** (1 / mp.mpf(a))),  # SciPy overflows 2^(1/a) for a < 1/1024
+        "Quantile": lambda p: (chk(0 <= p <= 1), inf if p == 1 else F(mp.mpf(xm) * (1 - mp.mpf(p)) ** (-1 / mp.mpf(a))))[1],
+        "Mean": inf if a <= 1 else a * xm / (a - 1),
+        "Variance": inf if a <= 2 else float(d.var()),
+        "StdDev": inf if a <= 2 else float(d.std()),
+        # the textbook forms in mpmath: SciPy loses digits next to the poles (Alpha = 4 + 2e-9)
+        "Skewness": nan if a <= 3 else F(2 * (1 + ma) / (ma - 3) * mp.sqrt((ma - 2) / ma)),
+        "ExKurtosis": nan if a <= 4 else F(6 * (ma ** 3 + ma ** 2 - 6 * ma - 2) / (ma * (ma - 3) * (ma - 4))),
+    }
+
+def D_Poisson(lam):
+    d = st.poisson(lam)
+    ex = {}
+    if lam > 1e4:
+        # SciPy's pmf is x log(lam) - lam - lgamma(x + 1) in doubles, which cancels like gonum's
+        def logpmf(x):
+            if x < 0 or x != math.floor(x):
+                return -inf
+            return F(mp.mpf(x) * mp.log(mp.mpf(lam)) - mp.mpf(lam) - mp.loggamma(mp.mpf(x) + 1))
+        ex = {"LogProb": logpmf, "Prob": lambda x: math.exp(logpmf(x))}
+    return d, True, ex
+
+def D_StudentsT(mu, sigma, nu):
+    d = st.t(nu, loc=mu, scale=sigma)
+    return d, False, {
+        "Mean": mu,
+        "Mode": mu,
+        "Variance": nan if nu <= 1 else inf if nu <= 2 else float(d.var()),
+        "StdDev": nan if nu <= 1 else inf if nu <= 2 else float(d.std()),
+    }
+
+def D_Triangle(a, b, c):
+    d = st.triang((c - a) / (b - a), loc=a, scale=b - a)
+    ma, mb, mc = mp.mpf(a), mp.mpf(b), mp.mpf(c)
+    q = ma * ma + mb * mb + mc * mc - ma * mb - ma * mc - mb * mc
+    var = q / 18
+    skew = mp.sqrt(2) * (ma + mb - 2 * mc) * (2 * ma - mb - mc) * (ma - 2 * mb + mc) / (5 * q ** mp.mpf(1.5))
+    return d, False, {"Mode": c, "Variance": F(var), "StdDev": F(mp.sqrt(var)), "Skewness": F(skew)}
+
+def D_Uniform(lo, hi):
+    return st.uniform(loc=lo, scale=hi - lo), False, {}
+
+def D_Weibull(k, lam):
+    d = st.weibull_min(k, scale=lam)
+    mk, ml = mp.mpf(k), mp.mpf(lam)
+    def logpdf(x):
+        # SciPy's pdf is NaN where (x/lam)^k overflows: weibull_min(511, scale=4).pdf(46)
+        if x < 0:
+            return -inf
+        if x == 0:
+            return inf if k < 1 else F(mp.log(mk / ml)) if k == 1 else -inf
+        z = mp.mpf(x) / ml
+        return F(mp.log(mk / ml) + (mk - 1) * mp.log(z) - z ** mk)
+    g = lambda i: mp.gamma(1 + i / mk)
+    mean = ml * g(1)
+    var = ml ** 2 * (g(2) - g(1) ** 2)
+    sd = mp.sqrt(var)
+    skew = (g(3) * ml ** 3 - 3 * mean * var - mean ** 3) / sd ** 3
+    kurt = (-6 * g(1) ** 4 + 12 * g(1) ** 2 * g(2) - 3 * g(2) ** 2 - 4 * g(1) * g(3) + g(4)) / (g(2) - g(1) ** 2) ** 2
+    ex = {"Mode": 0.0 if k <= 1 else lam * ((k - 1) / k) ** (1 / k),
+          "Mean": F(mean), "Variance": F(var), "StdDev": F(sd), "Skewness": F(skew), "ExKurtosis": F(kurt),
+          "LogProb": logpdf, "Prob": lambda x: math.exp(logpdf(x))}
+    return d, False, ex
+
+def Dist(name, params, method, x):
+    d, discrete, extra = globals()["D_" + name](*params)
+    if method in extra:
+        v = extra[method]
+        if v is skip:
+            skip()
+        return v(x) if callable(v) else v
+    if method == "CDF":
+        return d.cdf(x)
+    if method == "Survival":
+        return d.sf(x)
+    if method == "Prob":
+        return d.pmf(x) if discrete else d.pdf(x)
+    if method == "LogProb":
+        return d.logpmf(x) if discrete else d.logpdf(x)
+    if method == "LogSurvival":
+        return d.logsf(x)
+    if method == "Quantile":
+        chk(0 <= x <= 1)
+        if discrete and x == 0:
+            skip()
+        return d.ppf(x)
+    if method == "Mean":
+        return d.mean()
+    if method == "Median":
+        return d.median()
+    if method == "Variance":
+        return d.var()
+    if method == "StdDev":
+        return d.std()
+    if method == "Skewness":
+        return d.stats(moments="s")
+    if method == "ExKurtosis":
+        return d.stats(moments="k")
+    if method == "Entropy":
+        return d.entropy()
+    raise Exception("method " + method)
+
+def AlphaStable(alpha, beta, c, mu, method):
+    if method == "Mean":
+        return mu if alpha > 1 else nan
+    if method in ("Median", "Mode"):
+        chk(beta == 0)
+        return mu
+    if method == "Variance":
+        return 2 * c * c if alpha == 2 else inf
+    if method == "StdDev":
+        return math.sqrt(2) * c if alpha == 2 else inf
+    if method in ("Skewness", "ExKurtosis"):
+        return 0.0 if alpha == 2 else nan
+    raise Exception("method " + method)
+
+def Categorical(w, method, x):
+    total = sum(w)
+    if method == "CDF":
+        return sum(v for i, v in enumerate(w) if i <= x) / total
+    if method == "Prob":
+        if not isint(x) or x < 0 or x >= len(w):
+            return 0.0
+        return w[int(x)] / total
+    if method == "LogProb":
+        return math.log(Categorical(w, "Prob", x)) if Categorical(w, "Prob", x) > 0 else -inf
+    if method == "Mean":
+        return sum(i * v for i, v in enumerate(w)) / total
+    if method == "Entropy":
+        e = -sum(v / total * math.log(v / total) for v in w if v != 0)
+        if e < 1e-6:
+            skip()  # the sum cancels
+        return e
+    raise Exception("method " + method)
+`
+
+// --------------------------------------------------------------------------- methods
+
+// The methods of a distribution, by interface.
+type (
+	hzCDFer         interface{ CDF(float64) float64 }
+	hzSurvivaler    interface{ Survival(float64) float64 }
+	hzProber        interface{ Prob(float64) float64 }
+	hzLogProber     interface{ LogProb(float64) float64 }
+	hzLogSurvivaler interface{ LogSurvival(float64) float64 }
+	hzQuantiler     interface{ Quantile(float64) float64 }
+	hzMeaner        interface{ Mean() float64 }
+	hzMedianer      interface{ Median() float64 }
+	hzModer         interface{ Mode() float64 }
+	hzVariancer     interface{ Variance() float64 }
+	hzStdDever      interface{ StdDev() float64 }
+	hzSkewnesser    interface{ Skewness() float64 }
+	hzExKurtosiser  interface{ ExKurtosis() float64 }
+	hzEntropyer     interface{ Entropy() float64 }
+)
+
+// distMethods: the fourteen methods, LogProb first (the shrink target of a table: Logistic's
+// LogProb is the simplest deterministic failure, gonum/14).
+var distMethods = []string{"LogProb", "Prob", "CDF", "Survival", "LogSurvival", "Quantile", "Mean", "Median",
+	"Mode", "Variance", "StdDev", "Skewness", "ExKurtosis", "Entropy"}
+
+// hzDistCall invokes a method by name; ok is false when the distribution lacks it.
+func hzDistCall(d any, method string, x float64) (v float64, ok bool) {
+	switch method {
+	case "CDF":
+		if m, has := d.(hzCDFer); has {
+			return m.CDF(x), true
+		}
+	case "Survival":
+		if m, has := d.(hzSurvivaler); has {
+			return m.Survival(x), true
+		}
+	case "Prob":
+		if m, has := d.(hzProber); has {
+			return m.Prob(x), true
+		}
+	case "LogProb":
+		if m, has := d.(hzLogProber); has {
+			return m.LogProb(x), true
+		}
+	case "LogSurvival":
+		if m, has := d.(hzLogSurvivaler); has {
+			return m.LogSurvival(x), true
+		}
+	case "Quantile":
+		if m, has := d.(hzQuantiler); has {
+			return m.Quantile(x), true
+		}
+	case "Mean":
+		if m, has := d.(hzMeaner); has {
+			return m.Mean(), true
+		}
+	case "Median":
+		if m, has := d.(hzMedianer); has {
+			return m.Median(), true
+		}
+	case "Mode":
+		if m, has := d.(hzModer); has {
+			return m.Mode(), true
+		}
+	case "Variance":
+		if m, has := d.(hzVariancer); has {
+			return m.Variance(), true
+		}
+	case "StdDev":
+		if m, has := d.(hzStdDever); has {
+			return m.StdDev(), true
+		}
+	case "Skewness":
+		if m, has := d.(hzSkewnesser); has {
+			return m.Skewness(), true
+		}
+	case "ExKurtosis":
+		if m, has := d.(hzExKurtosiser); has {
+			return m.ExKurtosis(), true
+		}
+	case "Entropy":
+		if m, has := d.(hzEntropyer); has {
+			return m.Entropy(), true
+		}
+	}
+	return 0, false
+}
+
+// isMoment: a method without an argument.
+func isMoment(method string) bool {
+	switch method {
+	case "Mean", "Median", "Mode", "Variance", "StdDev", "Skewness", "ExKurtosis", "Entropy":
+		return true
+	}
+	return false
+}
+
+// isCumulative: CDF or Survival.
+func isCumulative(method string) bool { return method == "CDF" || method == "Survival" }
+
+// isDensity: Prob or LogProb.
+func isDensity(method string) bool { return method == "Prob" || method == "LogProb" }
+
+// methodsOf lists the methods the distribution has, in the table's order.
+func methodsOf(d any) []string {
+	var out []string
+	for _, m := range distMethods {
+		if _, ok := hzDistCall(d, m, 0.5); ok {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- parameters
+// (package-level generators; the plain alternative first in every choice. The shape regions
+// of the recorded bugs are hegel_zoo_shapes_distuv_test.go's, drawn through known; the
+// regions that are a large share of a plain generator's range are gated here with unless.)
+
+var (
+	// locations: 0 three times in ten, else any signed number.
+	locations = weighted(choice[float64]{30, hegel.Just(0.0)}, choice[float64]{70, numbers})
+	// moderateLocations: for the bounded supports, whose width must not be absorbed by the
+	// location: 0, integers to 10 either side, hundredths to 1000, thousands to a million.
+	moderateLocations = hegel.OneOf(
+		hegel.Just(0.0),
+		scaled(ints(-10, 10), 1),
+		scaled(ints(-100000, 100000), 0.01),
+		scaled(ints(-1000, 1000), 1000),
+	)
+	// scales: 1, quarters to 10, thousandths, m 10^e to 999000, any positive number.
+	scales = hegel.OneOf(
+		hegel.Just(1.0),
+		scaled(ints(1, 40), 0.25),
+		scaled(ints(1, 999), 1e-3),
+		hegel.Map(profileOf(pLarge, 1, 999, 0, 3), num.float64),
+		positives,
+	)
+	// trials: a count N: to 10, to 100, 100 to 2000, to 3.
+	trials = hegel.OneOf(scaled(ints(0, 10), 1), scaled(ints(0, 100), 1), scaled(ints(100, 2000), 1), scaled(ints(0, 3), 1))
+	// probabilityParameters: a P, or one time in ten 10^-e for e in 6..14.
+	probabilityParameters = weighted(
+		choice[float64]{90, probabilities},
+		choice[float64]{10, hegel.Map(ints(6, 14), func(e int) float64 { return pow10(-e) })},
+	)
+	// chiKs: Chi's K for the argument methods, huge one time in twenty.
+	chiKs = weighted(choice[float64]{95, shapes}, choice[float64]{5, pick(1e7, 1e8, 1e12, 1e16)})
+	// chiMomentKs: Chi's K for the moments: at most 5, or - the region of gonum/31, never under
+	// HEGEL_NO_KNOWN=1 - any K one time in three.
+	chiMomentKs = weighted(choice[float64]{2, shapesTo(5)}, choice[float64]{unless(noKnown, 1), chiKs})
+	// weibullMomentKs: Weibull's K for the moments: at most 20, or - the region of gonum/33,
+	// never under HEGEL_NO_KNOWN=1 - any shape one time in three.
+	weibullMomentKs = weighted(choice[float64]{2, shapesTo(20)}, choice[float64]{unless(noKnown, 1), shapes})
+	// poissonLambdas: 0 one time in ten, 1e6 to 1e15 about one time in twelve, else a scale.
+	poissonLambdas = weighted(
+		choice[float64]{10, hegel.Just(0.0)},
+		choice[float64]{8, pick(1e6, 1e8, 1e10, 1e12, 1e15)},
+		choice[float64]{82, scales},
+	)
+
+	// nctNus: NoncentralT's Nu for the argument methods: a shape to 3000, or - the regions
+	// where its CDF is wrong, gonum/19 beyond 3000 and gonum/21 below 1e-3, never under
+	// HEGEL_NO_KNOWN=1 - each one time in six.
+	nctNus = weighted(
+		choice[float64]{4, shapesTo(3000)},
+		choice[float64]{unless(noKnown, 1), largeNus},
+		choice[float64]{unless(noKnown, 1), tinyNus},
+	)
+	// largeNus: m 10^e in [3100, 999000].
+	largeNus = hegel.Map(counts(ints(31, 999), ints(2, 3)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) })
+	// tinyNus: m 10^-e in [1e-7, 9e-4].
+	tinyNus = hegel.Map(counts(ints(1, 9), ints(4, 7)), func(v []int) float64 { return float64(v[0]) * pow10(-v[1]) })
+	// nctMus: NoncentralT's Mu for the argument methods: 0 three times in ten, within 38 in
+	// magnitude (integers, quarters, hundredths, tiny) nine times in twenty, or - the region of
+	// gonum/18, never under HEGEL_NO_KNOWN=1 - beyond 38 one time in four.
+	nctMus = weighted(
+		choice[float64]{30, hegel.Just(0.0)},
+		choice[float64]{unless(noKnown, 25), farMus},
+		choice[float64]{45, hegel.OneOf(
+			scaled(ints(-38, 38), 1),
+			scaled(ints(-152, 152), 0.25),
+			scaled(ints(-3800, 3800), 0.01),
+			hegel.Map(signed(profileOf(pTiny, 1, 999, 3, 12)), num.float64),
+		)},
+	)
+	// farMus: m 10^e in [39, 999000], either sign.
+	farMus = hegel.Map(counts(ints(39, 999), ints(0, 3), ints(0, 1)), func(v []int) float64 {
+		return sign(v[2]) * float64(v[0]) * pow10(v[1])
+	})
+
+	// triangleWidths: a scale, or one time in ten millionths.
+	triangleWidths = weighted(choice[float64]{90, scales}, choice[float64]{10, scaled(ints(1, 999), 1e-6)})
+	// triangleParameters: a, b = a + width (at least 1e-9 |a|: a width lost in the rounding of
+	// the location makes no triangle) and the mode c at a, at b, or in thousandths between.
+	triangleParameters = hegel.Map(tuple(moderateLocations, triangleWidths, scaled(ints(-2, 1000), 1e-3)), func(v []float64) []float64 {
+		a, b := v[0], v[0]+v[1]
+		if b-a < 1e-9*math.Abs(a) {
+			b = a + 1e-9*math.Abs(a)
+		}
+		switch c := v[2]; {
+		case c == -2e-3:
+			return []float64{a, b, a}
+		case c == -1e-3:
+			return []float64{a, b, b}
+		default:
+			return []float64{a, b, a + (b-a)*c}
+		}
+	})
+	// uniformParameters: a and a + max(scale, 1e-9 |a|).
+	uniformParameters = hegel.Map(tuple(moderateLocations, scales), func(v []float64) []float64 {
+		return []float64{v[0], v[0] + math.Max(v[1], 1e-9*math.Abs(v[0]))}
+	})
+)
+
+// shapesTo: a shape parameter at most hi: halves, thousandths, integers, and any positive
+// number folded into (1, hi].
+func shapesTo(hi int) hegel.Generator[float64] {
+	return hegel.OneOf(
+		scaled(ints(1, min(20, 2*hi)), 0.5),
+		scaled(ints(1, 999), 1e-3),
+		scaled(ints(1, min(200, hi)), 1),
+		hegel.Map(positives, func(v float64) float64 {
+			if v > float64(hi) {
+				return math.Mod(v, float64(hi-1)) + 1
+			}
+			return v
+		}),
+	)
+}
+
+// sign is -1 for 0 and +1 for 1 (a drawn sign bit).
+func sign(s int) float64 { return float64(2*s - 1) }
+
+// --------------------------------------------------------------------------- the table
+
+// distSpec is one distribution: its parameter generators (the moments' where the argument
+// methods' is gated, see nctNus), its shape regions (hegel_zoo_shapes_distuv_test.go, nil
+// for none), constructor, the points of its support worth probing and a sample parameter
+// list to read its method set off.
+type distSpec struct {
+	name    string
+	params  hegel.Generator[[]float64]
+	moments hegel.Generator[[]float64]
+	shapes  hegel.Generator[distCall]
+	make    func(p []float64) any
+	points  func(p []float64) []float64
+	ints    bool // a discrete distribution on the integers
+	sample  []float64
+}
+
+// distCall is one method call: the method, the parameters and the argument (0 for a moment).
+type distCall struct {
+	method string
+	p      []float64
+	x      float64
+}
+
+// distCase is a call of a distribution of the table.
+type distCase struct {
+	dist distSpec
+	distCall
+}
+
+func (c distCase) GoString() string {
+	s := c.dist.name + "(" + strings.Join(hzFmts(c.p), ", ") + ")." + c.method + "("
+	if !isMoment(c.method) {
+		s += hzFmt(c.x)
+	}
+	return s + ")"
+}
+
+// distSpecs: the 22 distributions. Logistic comes first: its LogProb ignores Mu and S
+// (gonum/14), the simplest deterministic failure - but Logistic{0, 1}, every choice at its
+// minimum, is outside that shape, and the shrinker of TestHegelDistuv lands on Chi{1}.LogProb(0)
+// instead (gonum/28: K = 1 is the second half of the shapes, every other choice minimal;
+// twelve rounds of twelve); Normal second, the most drawn index of a SampledFrom table, has
+// only the Survival tail (gonum/30) among the recorded bugs.
+var distSpecs = []distSpec{
+	{name: "Logistic", params: tuple(locations, scales), shapes: logisticShapes,
+		make:   func(p []float64) any { return distuv.Logistic{Mu: p[0], S: p[1]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[0] + p[1], p[0] - p[1], p[0] - 1000*p[1]} }, sample: []float64{0, 1}},
+	{name: "Normal", params: tuple(locations, scales), shapes: normalShapes,
+		make:   func(p []float64) any { return distuv.Normal{Mu: p[0], Sigma: p[1]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[0] + p[1], p[0] - 3*p[1], p[0] + 9*p[1]} }, sample: []float64{0, 1}},
+	{name: "Bernoulli", params: tuple(probabilityParameters),
+		make:   func(p []float64) any { return distuv.Bernoulli{P: p[0]} },
+		points: func(p []float64) []float64 { return []float64{0, 1, 0.5, -1, 2} }, ints: true, sample: []float64{0.5}},
+	{name: "Beta", params: tuple(shapes, shapes), shapes: betaShapes,
+		make:   func(p []float64) any { return distuv.Beta{Alpha: p[0], Beta: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, 1, 0.5, -0.5, 1.5} }, sample: []float64{1, 1}},
+	{name: "Binomial", params: tuple(trials, probabilityParameters), shapes: binomialShapes,
+		make:   func(p []float64) any { return distuv.Binomial{N: p[0], P: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, 1, p[0], p[0] - 1, p[0] + 1, -1, 2.5} }, ints: true, sample: []float64{5, 0.5}},
+	{name: "Chi", params: tuple(chiKs), moments: tuple(chiMomentKs), shapes: chiShapes,
+		make:   func(p []float64) any { return distuv.Chi{K: p[0]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, math.Sqrt(p[0])} }, sample: []float64{3}},
+	{name: "ChiSquared", params: tuple(shapes), shapes: chiSquaredShapes,
+		make:   func(p []float64) any { return distuv.ChiSquared{K: p[0]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, p[0]} }, sample: []float64{3}},
+	{name: "Exponential", params: tuple(scales), shapes: exponentialShapes,
+		make:   func(p []float64) any { return distuv.Exponential{Rate: p[0]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, 1 / p[0]} }, sample: []float64{1}},
+	{name: "F", params: tuple(shapes, shapes), shapes: fShapes,
+		make:   func(p []float64) any { return distuv.F{D1: p[0], D2: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, 1, 1e20} }, sample: []float64{3, 5}},
+	{name: "Gamma", params: tuple(shapes, scales), shapes: gammaShapes,
+		make:   func(p []float64) any { return distuv.Gamma{Alpha: p[0], Beta: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, p[0] / p[1]} }, sample: []float64{2, 1}},
+	{name: "GumbelRight", params: tuple(locations, scales), shapes: gumbelShapes,
+		make:   func(p []float64) any { return distuv.GumbelRight{Mu: p[0], Beta: p[1]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[0] + p[1], p[0] - 5*p[1]} }, sample: []float64{0, 1}},
+	{name: "InverseGamma", params: tuple(shapes, scales), shapes: inverseGammaShapes,
+		make:   func(p []float64) any { return distuv.InverseGamma{Alpha: p[0], Beta: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, p[1] / (p[0] + 1)} }, sample: []float64{2, 1}},
+	{name: "Laplace", params: tuple(locations, scales), shapes: laplaceShapes,
+		make:   func(p []float64) any { return distuv.Laplace{Mu: p[0], Scale: p[1]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[0] + p[1], p[0] - p[1]} }, sample: []float64{0, 1}},
+	{name: "LogNormal", params: tuple(locations, scales), shapes: logNormalShapes,
+		make:   func(p []float64) any { return distuv.LogNormal{Mu: p[0], Sigma: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, math.Exp(p[0])} }, sample: []float64{0, 1}},
+	{name: "NoncentralT", params: tuple(nctNus, nctMus), moments: tuple(shapes, locations), shapes: nctShapes,
+		make:   func(p []float64) any { return distuv.NoncentralT{Nu: p[0], Mu: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, p[1], -p[1]} }, sample: []float64{5, 1}},
+	{name: "Pareto", params: tuple(scales, shapes),
+		make:   func(p []float64) any { return distuv.Pareto{Xm: p[0], Alpha: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, p[0], 2 * p[0], p[0] / 2} }, sample: []float64{1, 2}},
+	{name: "Poisson", params: tuple(poissonLambdas), shapes: poissonShapes,
+		make:   func(p []float64) any { return distuv.Poisson{Lambda: p[0]} },
+		points: func(p []float64) []float64 { return []float64{0, 1, math.Floor(p[0]), -1, 2.5, 30} }, ints: true, sample: []float64{2}},
+	{name: "StudentsT", params: tuple(locations, scales, shapes), shapes: studentsTShapes,
+		make:   func(p []float64) any { return distuv.StudentsT{Mu: p[0], Sigma: p[1], Nu: p[2]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[0] + p[1], p[0] - 3*p[1], p[0] + 1e-9*p[1]} }, sample: []float64{0, 1, 5}},
+	{name: "Triangle", params: triangleParameters, shapes: triangleShapes,
+		make:   func(p []float64) any { return distuv.NewTriangle(p[0], p[1], p[2], nil) },
+		points: func(p []float64) []float64 { return []float64{p[0], p[1], p[2], (p[0] + p[1]) / 2} }, sample: []float64{0, 1, 0.5}},
+	{name: "Uniform", params: uniformParameters, shapes: uniformShapes,
+		make:   func(p []float64) any { return distuv.Uniform{Min: p[0], Max: p[1]} },
+		points: func(p []float64) []float64 { return []float64{p[0], p[1], (p[0] + p[1]) / 2} }, sample: []float64{0, 1}},
+	{name: "Weibull", params: tuple(shapes, scales), moments: tuple(weibullMomentKs, scales), shapes: weibullShapes,
+		make:   func(p []float64) any { return distuv.Weibull{K: p[0], Lambda: p[1]} },
+		points: func(p []float64) []float64 { return []float64{0, -1, p[1]} }, sample: []float64{2, 1}},
+}
+
+// distSpecOf is the spec of the distribution (for the narrow properties).
+func distSpecOf(name string) distSpec {
+	for _, s := range distSpecs {
+		if s.name == name {
+			return s
+		}
+	}
+	panic("no distribution " + name)
+}
+
+// argumentsOf is the argument of a method: a probability (or a bad one) for Quantile, nothing
+// for a moment, else a point of the support one time in four and a number otherwise (for a
+// discrete distribution, a small integer one time in four too). Where a region of a recorded
+// bug is a large share of the numbers it is gated: a negative argument of the cumulative
+// methods of ChiSquared, F, InverseGamma and Chi (gonum/27), and a Logistic density beyond
+// 354 scales out (gonum/15) - by default at the numbers' rate, never under HEGEL_NO_KNOWN=1.
+func argumentsOf(s distSpec, method string, p []float64) hegel.Generator[float64] {
+	switch {
+	case method == "Quantile":
+		return probOrBad
+	case isMoment(method):
+		return hegel.Just(0.0)
+	}
+	points, any := s.points(p), numbers
+	switch {
+	case isCumulative(method) && (s.name == "ChiSquared" || s.name == "F" || s.name == "InverseGamma" || s.name == "Chi"):
+		if noKnown {
+			points = nonNegativeOf(points)
+		}
+		any = weighted(choice[float64]{60, nonNegatives}, choice[float64]{unless(noKnown, 40), negatives})
+	case s.name == "Logistic" && method == "Prob":
+		if noKnown {
+			points = points[:3]
+		}
+		any = weighted(
+			choice[float64]{3, hegel.Map(scaled(ints(-3540, 3540), 0.1), func(t float64) float64 { return p[0] + p[1]*t })},
+			choice[float64]{unless(noKnown, 1), numbers},
+		)
+	}
+	if s.ints {
+		return weighted(choice[float64]{1, pick(points...)}, choice[float64]{2, any}, choice[float64]{1, scaled(ints(0, 30), 1)})
+	}
+	return weighted(choice[float64]{1, pick(points...)}, choice[float64]{3, any})
+}
+
+// nonNegativeOf is the points at or above 0 (and not -0).
+func nonNegativeOf(points []float64) []float64 {
+	var out []float64
+	for _, v := range points {
+		if v >= 0 && !math.Signbit(v) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// plainCalls: a method the distribution has, its parameters (the moments' generator for a
+// moment, where there is one) and an argument.
+func plainCalls(s distSpec) hegel.Generator[distCall] {
+	return hegel.FlatMap(pick(methodsOf(s.make(s.sample))...), func(m string) hegel.Generator[distCall] {
+		params := s.params
+		if isMoment(m) && s.moments != nil {
+			params = s.moments
+		}
+		return hegel.FlatMap(params, func(p []float64) hegel.Generator[distCall] {
+			return hegel.Map(argumentsOf(s, m, p), func(x float64) distCall { return distCall{m, p, x} })
+		})
+	})
+}
+
+// distCallsOf: the calls of each distribution, plain or one time in three by weight the region of one
+// of its recorded bugs (known; never under HEGEL_NO_KNOWN=1).
+var distCallsOf = func() map[string]hegel.Generator[distCall] {
+	out := map[string]hegel.Generator[distCall]{}
+	for _, s := range distSpecs {
+		out[s.name] = plainCalls(s)
+		if s.shapes != nil {
+			out[s.name] = known(plainCalls(s), s.shapes)
+		}
+	}
+	return out
+}()
+
+// casesOf: the calls as cases of the distribution.
+func casesOf(name string, calls hegel.Generator[distCall]) hegel.Generator[distCase] {
+	s := distSpecOf(name)
+	return hegel.Map(calls, func(c distCall) distCase { return distCase{s, c} })
+}
+
+// distCases: a distribution of the table and one of its calls.
+var distCases = hegel.FlatMap(hegel.SampledFrom(distSpecs), func(s distSpec) hegel.Generator[distCase] {
+	return casesOf(s.name, distCallsOf[s.name])
+})
+
+// --------------------------------------------------------------------------- known shapes
+
+// distShape names the recorded bug (bugs.toml) whose shape a call has, from its parameters
+// and argument: a region the library gets wrong, skipped under HEGEL_NO_KNOWN=1, except
+// gonum/9 (the entropies are sums of digammas, each 3e-11 off: Beta{7, 7}.Entropy() is 6e-10
+// off), a precision loss judged at the relaxed tolerance under HEGEL_NO_KNOWN=1. By default
+// every case is judged at the strict tolerance and a mismatch names the shape. The predicates
+// are the old HZKnown steering's, kept exactly and in its order but for gonum/25, now before
+// gonum/7 for F's cumulative methods (the narrower region names its own bug): they are what
+// HEGEL_NO_KNOWN=1 skips by. The shapes known only from the oracle's answer are distShapeOf's.
+func distShape(name, method string, p []float64, x float64) string {
+	density, cumulative := isDensity(method), isCumulative(method)
+	switch name {
+	case "Logistic":
+		switch {
+		case method == "LogProb":
+			return "gonum/14"
+		case method == "Quantile" && !(x >= 0 && x <= 1):
+			return "gonum/16"
+		case method == "Prob" && math.Abs(x-p[0])/p[1] > 354:
+			return "gonum/15"
+		}
+	case "NoncentralT":
+		switch {
+		case method == "Quantile" && !(x > 0 && x < 1):
+			return "gonum/16"
+		case math.Abs(p[1]) > 38 && (density || cumulative || method == "Quantile"):
+			return "gonum/18"
+		case density && (p[0] > 3000 || math.Abs(x) < 1e-8*p[0]):
+			return "gonum/19"
+		case method == "Quantile" && (math.Min(x, 1-x) < 1e-4 || p[0] > 3000):
+			return "gonum/19" // the quantile is found on the CDF, wrong in the tails and for a large Nu
+		case cumulative && p[0] > 3000:
+			return "gonum/19" // the CDF is accurate to about 1e-11 absolute only
+		case p[0] < 1e-3 && (cumulative || density || method == "Quantile"):
+			return "gonum/21"
+		case cumulative && x*x > 1e9*p[0]:
+			return "gonum/20"
+		}
+	case "Exponential":
+		if method == "Quantile" && x >= 0 && x < 1e-6 {
+			return "gonum/22"
+		}
+	case "Beta":
+		switch {
+		case method == "Quantile" && x >= 0 && x <= 1 && hzInvBetaBad(p[0], p[1], x):
+			return "gonum/6"
+		case (method == "CDF" && p[1] < 1 && 1-x < 1e-3 && x < 1) || (method == "Survival" && p[0] < 1 && x < 1e-3 && x > 0):
+			return "gonum/7"
+		}
+	case "LogNormal":
+		if (density || cumulative) && x <= 0 {
+			return "gonum/26"
+		}
+		limit := map[string]float64{"Variance": 1e-3, "StdDev": 1e-3, "Skewness": 1e-3, "ExKurtosis": 0.05}[method]
+		if limit > 0 && p[1] < limit {
+			return "gonum/35"
+		}
+	case "ChiSquared", "F", "InverseGamma", "Chi":
+		switch {
+		case cumulative && (x < 0 || (x == 0 && math.Signbit(x))):
+			return "gonum/27"
+		case name == "InverseGamma" && method == "Quantile" && x > 1-1e-6 && x < 1:
+			return "gonum/5" // the quantile inverts the complement near 1
+		case name == "F" && cumulative && x > 0 && p[1]/(p[0]*x) < 1e-12:
+			return "gonum/25" // before gonum/7's wider region: the argument's rounding, not the incomplete beta's digits
+		case name == "F" && cumulative && x > 0 && p[1] < 2 && p[1]/(p[0]*x) < 1e-3:
+			return "gonum/7"
+		case name == "F" && method == "Survival" && x > 0 && p[0] < 2 && p[0]*x/(p[0]*x+p[1]) < 1e-3:
+			return "gonum/7" // the survival is RegIncBeta(d2/2, d1/2, d2/(d1 x + d2))
+		case name == "F" && method == "Quantile" && x > 0 && x < 1 && hzInvBetaBad(p[0]/2, p[1]/2, x):
+			return "gonum/6" // the quantile is InvRegIncBeta(d1/2, d2/2, p)
+		}
+	case "StudentsT":
+		switch {
+		case cumulative && x != p[0] && math.Abs(x-p[0]) < 1e-5*p[1]*math.Sqrt(p[2]):
+			return "gonum/32"
+		case method == "Quantile" && x > 0 && x < 1 && p[2] > 1e6*math.Pow(2.5*(x-0.5), 2):
+			return "gonum/32" // z is at least 2.5 |p - 0.5| for the standard t
+		case method == "Quantile" && p[2] < 0.1:
+			return "gonum/4"
+		case method == "Quantile" && x > 0 && x < 1 && hzInvBetaBad(p[2]/2, 0.5, 2*math.Min(x, 1-x)):
+			return "gonum/6" // the tail quantile is InvRegIncBeta(Nu/2, 1/2, 2 min(p, 1-p))
+		}
+	case "Laplace":
+		if method == "Quantile" && (x < 1e-5 || x > 1-1e-5) && x >= 0 && x <= 1 {
+			return "gonum/22"
+		}
+	case "Bernoulli", "Binomial":
+		if pp := p[len(p)-1]; (method == "LogProb" || method == "Entropy") && pp > 0 && pp < 1e-6 {
+			return "gonum/23"
+		}
+	case "Triangle":
+		if (method == "Variance" || method == "StdDev" || method == "Skewness") && math.Abs(p[0]) > 300*(p[1]-p[0]) {
+			return "gonum/24"
+		}
+	}
+	if method == "Quantile" {
+		switch {
+		case name == "Gamma" && hzGammaInvTiny(p[0], x),
+			(name == "Chi" || name == "ChiSquared") && hzGammaInvTiny(p[0]/2, x):
+			return "gonum/4"
+		}
+	}
+	if density {
+		switch {
+		case name == "ChiSquared" && p[0] == 2 && x == 0,
+			name == "Chi" && p[0] == 1 && x == 0,
+			name == "F" && x <= 0,
+			name == "Binomial" && (p[1] == 0 || p[1] == 1),
+			name == "Poisson" && p[0] == 0:
+			return "gonum/28"
+		case name == "Poisson" && p[0] > 1e5:
+			return "gonum/36"
+		case name == "Weibull" && p[0] == 1 && x == 0:
+			return "gonum/29"
+		}
+	}
+	if name == "Weibull" {
+		switch {
+		case method == "Quantile" && x >= 0 && x < 1e-6:
+			return "gonum/22"
+		case map[string]float64{"Variance": 200, "StdDev": 200, "Skewness": 50, "ExKurtosis": 20}[method] > 0 &&
+			p[0] > map[string]float64{"Variance": 200, "StdDev": 200, "Skewness": 50, "ExKurtosis": 20}[method]:
+			return "gonum/33"
+		case map[string]float64{"Variance": 2, "StdDev": 2, "Skewness": 3, "ExKurtosis": 4}[method] > 0 &&
+			map[string]float64{"Variance": 2, "StdDev": 2, "Skewness": 3, "ExKurtosis": 4}[method]/p[0] > 170:
+			return "gonum/34"
+		}
+	}
+	if name == "Chi" {
+		limit := map[string]float64{"Mean": 1e5, "Variance": 300, "StdDev": 300, "Skewness": 30, "ExKurtosis": 5, "Entropy": 1e5}[method]
+		if limit > 0 && p[0] > limit {
+			return "gonum/31"
+		}
+	}
+	if method == "Entropy" {
+		return "gonum/9"
+	}
+	return ""
+}
+
+// distShapeOf names the recorded bug whose shape a call has where that is known only from
+// the oracle's answer (and the library's): the Survival methods computed as 1 - CDF where
+// the survival is below 1e-4 (gonum/30), a Triangle CDF below 1e-6 (gonum/24), NoncentralT
+// densities below 1e-3 and CDFs below 1e-5 (gonum/19; the old steering stopped at 1e-6, and
+// between 1e-6 and 1e-5 the CDF is still 1e-7 off one time in five), its Quantile NaN or at the bracket
+// bound (gonum/17) or far out (gonum/20), and an F Quantile inverted through an argument
+// within 1e-8 of 1 (gonum/25).
+func distShapeOf(name, method string, p []float64, x, want, got float64) string {
+	switch {
+	case method == "Survival" && want < 1e-4:
+		switch name {
+		case "Normal", "LogNormal", "GumbelRight", "Logistic", "Poisson", "Binomial", "Triangle", "Uniform", "F":
+			return "gonum/30"
+		}
+	case name == "Triangle" && method == "CDF" && want < 1e-6:
+		return "gonum/24"
+	case name == "NoncentralT" && ((method == "Prob" && want < 1e-3) || (method == "LogProb" && want < math.Log(1e-3)) || (method == "CDF" && want < 1e-5)):
+		return "gonum/19"
+	case name == "NoncentralT" && method == "Quantile" && (math.IsNaN(got) || math.Abs(want) >= 1<<24) && !math.IsNaN(want):
+		return "gonum/17"
+	case name == "NoncentralT" && method == "Quantile" && want*want > 1e9*p[0]:
+		return "gonum/20" // the root is found on the CDF, imprecise out there
+	case name == "F" && method == "Quantile" && want > 0 && p[1]/(p[0]*want) < 1e-8:
+		return "gonum/25" // the inverse goes through an argument within 1e-8 of 1
+	}
+	return ""
+}
+
+// distTol returns the relative and absolute tolerances for a method's result: 1e-7 for
+// NoncentralT (its variance is a cancellation of terms in Mu^2 with a gamma ratio taken
+// through lgamma) and beyond a shape parameter of 1e4, 1e-8 for a quantile, else 1e-9; a log
+// density near 0 carries the rounding of a probability near 1 (1e-13), an entropy near 0 is a
+// cancellation of terms of order 1 (1e-12, or with relaxed - HEGEL_NO_KNOWN=1 - the 1e-10 of
+// gonum/9 at the parameters' scale), and a quantile root at 0 comes out as rounding noise.
+func distTol(name, method string, p []float64, relaxed bool) (rtol, atol float64) {
+	shape := 0.0
+	switch name {
+	case "Chi", "ChiSquared", "F", "Gamma", "InverseGamma", "Beta", "Weibull", "Pareto":
+		shape = math.Max(p[0], p[1%len(p)])
+	case "StudentsT":
+		shape = p[2]
+	case "NoncentralT":
+		shape = p[0]
+	}
+	switch {
+	case name == "NoncentralT" && (method == "Variance" || method == "StdDev"):
+		nu, mu := p[0], p[1]
+		lg, _ := math.Lgamma(nu / 2)
+		rtol = 1e-7 + 3e-15*math.Abs(lg)*mu*mu/(1+3.5*mu*mu/nu)
+	case name == "NoncentralT", shape > 1e4:
+		rtol = 1e-7
+	case method == "Quantile":
+		rtol = 1e-8
+	default:
+		rtol = 1e-9
+	}
+	switch method {
+	case "LogProb":
+		atol = 1e-13
+	case "Entropy":
+		atol = 1e-12
+		if relaxed {
+			atol = 1e-10 * (1 + hzMaxAbs(p))
+		}
+	case "Quantile":
+		atol = 1e-13 * (1 + hzMaxAbs(p))
+	}
+	return rtol, atol
+}
+
+// --------------------------------------------------------------------------- the property
+
+func TestHegelDistuv(t *testing.T) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeDist(ht, o, c, hegel.Draw(ht, distCases))
+	})
+}
+
+// judgeDist asks the oracle about the case, calls the method and judges the result: a case
+// of a recorded bug's shape is judged like any other and fails naming the shape, or under
+// HEGEL_NO_KNOWN=1 is skipped (counted) where the shape is a wrong region and judged at the
+// relaxed tolerance where it is the entropies' precision loss. The narrow properties of
+// hegel_zoo_shapes_distuv_test.go judge their regions through it too.
+func judgeDist(ht *hegel.T, o *hzOracle, c *hzCollector, dc distCase) {
+	name, method, p, x := dc.dist.name, dc.method, dc.p, dc.x
+	shape := distShape(name, method, p, x)
+	if shape != "" {
+		c.count("shape " + shape)
+		if noKnown && shape != "gonum/9" {
+			c.count("known " + shape)
+			ht.Assume(false)
+		}
+	}
+	want, err := o.eval("Dist", hzS(name), hzA(p), hzS(method), hzN(x))
+	if err != nil {
+		ht.Fatalf("%v", err)
+	}
+	dist := dc.dist.make(p)
+	got, pan := hzCall(func() float64 { v, _ := hzDistCall(dist, method, x); return v })
+	class := name + "." + method
+	note := func() string {
+		if shape != "" {
+			return " (the shape of " + shape + ")"
+		}
+		return ""
+	}
+	switch want.t {
+	case "skip":
+		c.count("skip " + class)
+		return
+	case "panic":
+		if pan == nil {
+			c.failClass(ht, classOf(class, p, shape), "%#v = %v, want a panic%s", dc, got, note())
+			return
+		}
+		c.count("panic " + class)
+		return
+	}
+	if pan != nil {
+		c.failClass(ht, classOf(class, p, shape), "%#v panicked: %v (want %v)%s", dc, pan, want, note())
+		return
+	}
+	if shape == "" {
+		if shape = distShapeOf(name, method, p, x, want.num, got); shape != "" {
+			c.count("shape " + shape)
+			if noKnown {
+				c.count("known " + shape)
+				ht.Assume(false)
+			}
+		}
+	}
+	if math.Abs(want.num) < 1e-280 && math.Abs(got) < 1e-280 {
+		c.count("skip denormal " + class) // an intermediate underflowed on one side or the other
+		return
+	}
+	if method == "LogProb" && want.num < -708 {
+		c.count("skip denormal " + class) // the density is denormal or underflows on one side or the other
+		return
+	}
+	if method == "Quantile" && got == 0 && want.num > 0 && want.num < 1e-280 {
+		c.count("skip denormal " + class) // an intermediate underflowed
+		return
+	}
+	rtol, atol := distTol(name, method, p, noKnown && shape == "gonum/9")
+	if !hzClose(got, want.num, rtol, atol) {
+		c.failClass(ht, classOf(class, p, shape), "%#v = %v, want %v%s", dc, got, want, note())
+		return
+	}
+	c.count("ok " + class)
+}
+
+// --------------------------------------------------------------------------- the others
+
+// otherCase is a call of AlphaStable (only its moments are closed-form) or of Categorical
+// (its weights are the parameters).
+type otherCase struct {
+	name   string
+	p      []float64
+	method string
+	x      float64
+}
+
+func (c otherCase) GoString() string {
+	s := c.name + "(" + strings.Join(hzFmts(c.p), ", ") + ")." + c.method + "("
+	if !isMoment(c.method) {
+		s += hzFmt(c.x)
+	}
+	return s + ")"
+}
+
+var (
+	// alphaStableCases: Alpha from the ends and middle of (0, 2], Beta from -1 to 1, a scale
+	// and a location, and one of the seven moments.
+	alphaStableCases = hegel.FlatMap(pick("Mean", "Median", "Mode", "Variance", "StdDev", "Skewness", "ExKurtosis"), func(m string) hegel.Generator[otherCase] {
+		return hegel.Map(tuple(pick(2.0, 1, 0.5, 1.5, 1.9, 0.1), pick(0.0, 0.5, -1, 1), scales, locations), func(p []float64) otherCase {
+			return otherCase{"AlphaStable", p, m, 0}
+		})
+	})
+	// categoricalWeights: one to eight weights, each 0 one time in five (all zero: the first
+	// is 1).
+	categoricalWeights = hegel.Map(hegel.Lists(weighted(choice[float64]{2, hegel.Just(0.0)}, choice[float64]{8, scales})).MinSize(1).MaxSize(8), func(w []float64) []float64 {
+		if allZero(w) {
+			return append([]float64{1}, w[1:]...)
+		}
+		return w
+	})
+	// categoricalCases: the weights, one of five methods, and an argument from -1 to the
+	// length, shifted by a half one time in five.
+	categoricalCases = hegel.Composite(func(tc hegel.TestCase) otherCase {
+		w := hegel.Draw(tc, categoricalWeights)
+		m := hegel.Draw(tc, pick("CDF", "Prob", "LogProb", "Mean", "Entropy"))
+		x := float64(hegel.Draw(tc, ints(-1, len(w))))
+		if hegel.Draw(tc, chance(20)) {
+			x += 0.5
+		}
+		return otherCase{"Categorical", w, m, x}
+	})
+	otherCases = hegel.OneOf(alphaStableCases, categoricalCases)
+)
+
+func allZero(w []float64) bool {
+	for _, v := range w {
+		if v != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func TestHegelDistuvOther(t *testing.T) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		oc := hegel.Draw(ht, otherCases)
+		var (
+			want hzExpect
+			err  error
+			dist any
+			rtol = 1e-9
+		)
+		if oc.name == "AlphaStable" {
+			want, err = o.eval("AlphaStable", hzN(oc.p[0]), hzN(oc.p[1]), hzN(oc.p[2]), hzN(oc.p[3]), hzS(oc.method))
+			dist, rtol = distuv.AlphaStable{Alpha: oc.p[0], Beta: oc.p[1], C: oc.p[2], Mu: oc.p[3]}, 1e-12
+		} else {
+			want, err = o.eval("Categorical", hzA(oc.p), hzS(oc.method), hzN(oc.x))
+			dist = distuv.NewCategorical(oc.p, nil)
+		}
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		got, pan := hzCall(func() float64 { v, _ := hzDistCall(dist, oc.method, oc.x); return v })
+		class := oc.name + "." + oc.method
+		switch want.t {
+		case "skip":
+			c.count("skip " + class)
+			return
+		case "panic":
+			if pan == nil {
+				c.failClass(ht, class, "%#v = %v, want a panic", oc, got)
+				return
+			}
+			c.count("panic " + class)
+			return
+		}
+		if pan != nil {
+			c.failClass(ht, class, "%#v panicked: %v (want %v)", oc, pan, want)
+			return
+		}
+		if math.Abs(want.num) < 1e-300 && math.Abs(got) < 1e-300 {
+			c.count("skip denormal " + class) // the libraries flush denormals differently
+			return
+		}
+		if !hzClose(got, want.num, rtol, 0) {
+			c.failClass(ht, class, "%#v = %v, want %v", oc, got, want)
+			return
+		}
+		c.count("ok " + class)
+	})
+}
+
+// --------------------------------------------------------------------------- the laws
+
+// lawCase is a distribution of the table at an argument.
+type lawCase struct {
+	dist distSpec
+	p    []float64
+	x    float64
+}
+
+func (c lawCase) GoString() string {
+	return c.dist.name + "(" + strings.Join(hzFmts(c.p), ", ") + ") at " + hzFmt(c.x)
+}
+
+// lawCases: a distribution, its parameters (the argument methods') and a CDF argument.
+var lawCases = hegel.FlatMap(hegel.SampledFrom(distSpecs), func(s distSpec) hegel.Generator[lawCase] {
+	return hegel.FlatMap(s.params, func(p []float64) hegel.Generator[lawCase] {
+		return hegel.Map(argumentsOf(s, "CDF", p), func(x float64) lawCase { return lawCase{s, p, x} })
+	})
+})
+
+// TestHegelDistuvLaws: a distribution against itself: CDF + Survival = 1, Prob = exp(LogProb),
+// and Quantile(CDF(x)) = x wherever the density is positive and the CDF is inside
+// (1e-6, 1 - 1e-6). A case whose argument has the shape of a recorded bug for CDF, Survival,
+// Prob or LogProb (distShape), or for Quantile at its CDF, fails naming the shape, or under
+// HEGEL_NO_KNOWN=1 is skipped (counted).
+func TestHegelDistuvLaws(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		lc := hegel.Draw(ht, lawCases)
+		s, p, x := lc.dist, lc.p, lc.x
+		shape := ""
+		for _, m := range []string{"CDF", "Survival", "Prob", "LogProb"} {
+			if shape = distShape(s.name, m, p, x); shape != "" {
+				break
+			}
+		}
+		if shape != "" {
+			c.count("shape " + shape)
+			if noKnown {
+				c.count("known " + shape)
+				ht.Assume(false)
+			}
+		}
+		note := func() string {
+			if shape != "" {
+				return " (the shape of " + shape + ")"
+			}
+			return ""
+		}
+		dist := s.make(p)
+		call := func(method string, x float64) (v float64, ok bool) {
+			v, pan := hzCall(func() float64 { var r float64; r, ok = hzDistCall(dist, method, x); return r })
+			if pan != nil {
+				c.failClass(ht, classOf(s.name+"."+method, p, shape), "%#v: %s(%v) panicked: %v%s", lc, method, x, pan, note())
+			}
+			return v, ok
+		}
+		cdf, ok1 := call("CDF", x)
+		sf, ok2 := call("Survival", x)
+		if ok1 && ok2 && !hzClose(cdf+sf, 1, 1e-10, 1e-10) {
+			c.failClass(ht, classOf(s.name+" CDF+Survival", p, shape), "%#v: CDF + Survival = %v + %v%s", lc, cdf, sf, note())
+			return
+		}
+		pr, ok1 := call("Prob", x)
+		lp, ok2 := call("LogProb", x)
+		if ok1 && ok2 && !hzClose(math.Exp(lp), pr, 1e-12, 0) {
+			c.failClass(ht, classOf(s.name+" LogProb", p, shape), "%#v: Prob = %v, exp(LogProb) = %v%s", lc, pr, math.Exp(lp), note())
+			return
+		}
+		if s.ints || !ok1 || !(cdf > 1e-6 && cdf < 1-1e-6) {
+			c.count("ok " + s.name)
+			return
+		}
+		// the inverse of an F goes through an argument within 1e-8 of 1 (gonum/25); the
+		// quantile's own shapes at p = CDF(x)
+		qShape := distShape(s.name, "Quantile", p, cdf)
+		if s.name == "F" && x > 0 && p[1]/(p[0]*x) < 1e-8 {
+			qShape = "gonum/25"
+		}
+		if qShape != "" {
+			shape = qShape
+			c.count("shape " + shape)
+			if noKnown {
+				c.count("known " + shape)
+				ht.Assume(false)
+			}
+		}
+		q, ok := call("Quantile", cdf)
+		if s.name == "NoncentralT" && math.IsNaN(q) {
+			shape = "gonum/17" // the bracket search failed
+			c.count("shape " + shape)
+			if noKnown {
+				c.count("known " + shape)
+				ht.Assume(false)
+			}
+		}
+		scale := math.Abs(x)
+		if sd, has := hzDistCall(dist, "StdDev", 0); has && sd > 0 && !math.IsInf(sd, 0) && !math.IsNaN(sd) {
+			scale += sd
+		} else {
+			// no finite spread (heavy tails): the parameters set the scale
+			scale++
+			for _, v := range p {
+				scale += math.Abs(v)
+			}
+		}
+		// Quantile(CDF(x)) = x wherever the density is positive.
+		if ok && pr > 1e-12 && !hzClose(q, x, 1e-6, 1e-8*scale) {
+			c.failClass(ht, classOf(s.name+" Quantile", p, shape), "%#v: Quantile(CDF = %v) = %v%s", lc, cdf, q, note())
+			return
+		}
+		c.count("ok " + s.name)
+	})
+}
