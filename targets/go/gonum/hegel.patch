+def GammaIncRegCompInv(a, y):
+    chk(a > 0 and 0 <= y <= 1)
+    if y == 0:
+        return inf
+    if y == 1:
+        return 0.0
+    x0 = float(sp.gammainccinv(a, y))
+    if not 0 < x0 < inf:
+        skip()
+    r = refine(lambda t: gammaincc_reg(a, t) - y, x0, min(y, 1 - y))
