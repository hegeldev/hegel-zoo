+const hzOracleMathext = `
+def beta_special(a, b):
+    if math.isnan(a) or math.isnan(b) or math.isinf(a) or math.isinf(b):
+        return nan
+    if a == 0 and b == 0:
+        return nan
+    if a < 0 or b < 0:
+        return nan
+    if a == 0 or b == 0:
+        return inf
+    return None
+
+def Beta(a, b):
+    s = beta_special(a, b)
+    if s is not None:
+        return s
+    return F(mp.exp(mp.loggamma(a) + mp.loggamma(b) - mp.loggamma(a + b)))
+
+def Lbeta(a, b):
+    s = beta_special(a, b)
+    if s is not None:
+        return s
+    return F(mp.loggamma(a) + mp.loggamma(b) - mp.loggamma(a + b))
+
+def betainc_reg(a, b, x):
+    # mpmath's betainc does not converge (or takes seconds) for parameters in the thousands,
+    # and loses digits for tiny x, where the hypergeometric form is exact and fast
+    if max(a, b) > 1000:
+        return mp.mpf(float(sp.betainc(a, b, x)))
+    if 0 < x < 0.1:
+        a, b, x = mp.mpf(a), mp.mpf(b), mp.mpf(x)
+        lb = mp.loggamma(a) + mp.loggamma(b) - mp.loggamma(a + b)
+        return mp.exp(a * mp.log(x) + b * mp.log(1 - x) - mp.log(a) - lb) * mp.hyp2f1(a + b, 1, a + 1, x)
+    return mp.betainc(a, b, 0, x, regularized=True)
+
+def RegIncBeta(a, b, x):
+    chk(0 <= x <= 1 and a > 0 and b > 0)
