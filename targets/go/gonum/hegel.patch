+	hzPinNum(t, "Logistic{3, 630}.LogProb(-80.2)", func() float64 { return d.LogProb(-80.2) }, -7.8363712071237615, 1e-12, 0)
+	hzPinNum(t, "Logistic{3, 630}.LogProb(-80.2) vs log Prob", func() float64 { return d.LogProb(-80.2) }, math.Log(d.Prob(-80.2)), 1e-12, 0)
+}
