+	default:
+		v := hzGenPos(tc)
+		if v > 1e6 {
+			v = math.Mod(v, 1e6) + 1
+		}
+		return v
+	}
+}
+
+type hzMathFn struct {
+	name string
+	gen  func(tc hegel.TestCase) []float64
+	call func(a []float64) float64
+	rtol float64
+}
+
+var hzMathFns = []hzMathFn{
+	{"Beta", func(tc hegel.TestCase) []float64 { return []float64{hzGenSpecial(tc), hzGenSpecial(tc)} },
+		func(a []float64) float64 { return mathext.Beta(a[0], a[1]) }, 1e-10},
+	{"Lbeta", func(tc hegel.TestCase) []float64 { return []float64{hzGenSpecial(tc), hzGenSpecial(tc)} },
+		func(a []float64) float64 { return mathext.Lbeta(a[0], a[1]) }, 1e-10},
+	{"RegIncBeta", func(tc hegel.TestCase) []float64 {
+		return []float64{hzGenShapeOrBad(tc), hzGenShapeOrBad(tc), hzGenProbOrBad(tc)}
+	}, func(a []float64) float64 { return mathext.RegIncBeta(a[0], a[1], a[2]) }, 1e-10},
+	{"InvRegIncBeta", func(tc hegel.TestCase) []float64 {
+		return []float64{hzGenShapeOrBad(tc), hzGenShapeOrBad(tc), hzGenProbOrBad(tc)}
+	}, func(a []float64) float64 { return mathext.InvRegIncBeta(a[0], a[1], a[2]) }, 1e-8},
+	{"Digamma", func(tc hegel.TestCase) []float64 { return []float64{hzGenSpecial(tc)} },
+		func(a []float64) float64 { return mathext.Digamma(a[0]) }, 1e-10},
+	{"GammaIncReg", func(tc hegel.TestCase) []float64 { return []float64{hzGenShapeOrBad(tc), hzGenNumOrBad(tc)} },
+		func(a []float64) float64 { return mathext.GammaIncReg(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegComp", func(tc hegel.TestCase) []float64 { return []float64{hzGenShapeOrBad(tc), hzGenNumOrBad(tc)} },
+		func(a []float64) float64 { return mathext.GammaIncRegComp(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegInv", func(tc hegel.TestCase) []float64 { return []float64{hzGenShapeOrBad(tc), hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.GammaIncRegInv(a[0], a[1]) }, 1e-9},
+	{"GammaIncRegCompInv", func(tc hegel.TestCase) []float64 { return []float64{hzGenShapeOrBad(tc), hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.GammaIncRegCompInv(a[0], a[1]) }, 1e-9},
+	{"Zeta", func(tc hegel.TestCase) []float64 {
+		x := 1 + hzGenNum(tc, false)
+		if hzChance(tc, 8) {
+			x = hzPick(tc, []float64{1, 0.5, 0, -1, -2.5})
+		}
+		return []float64{x, hzGenNum(tc, true)}
+	}, func(a []float64) float64 { return mathext.Zeta(a[0], a[1]) }, 1e-10},
+	{"NormalQuantile", func(tc hegel.TestCase) []float64 { return []float64{hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.NormalQuantile(a[0]) }, 1e-10},
+	{"Hypergeo", func(tc hegel.TestCase) []float64 {
+		return []float64{hzGenSmall(tc), hzGenSmall(tc), hzGenSmall(tc), hzGenZ(tc)}
+	}, func(a []float64) float64 { return mathext.Hypergeo(a[0], a[1], a[2], a[3]) }, 1e-9},
+	{"MvLgamma", func(tc hegel.TestCase) []float64 {
+		dim := hzDrawInt(tc, 1, 12)
+		if hzChance(tc, 4) {
+			dim = hzDrawInt(tc, -2, 0)
+		}
+		return []float64{hzGenNum(tc, true), float64(dim)}
+	}, func(a []float64) float64 { return mathext.MvLgamma(a[0], int(a[1])) }, 1e-10},
+	{"CompleteK", func(tc hegel.TestCase) []float64 { return []float64{hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.CompleteK(a[0]) }, 1e-10},
+	{"CompleteE", func(tc hegel.TestCase) []float64 { return []float64{hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.CompleteE(a[0]) }, 1e-10},
+	{"CompleteB", func(tc hegel.TestCase) []float64 { return []float64{hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.CompleteB(a[0]) }, 1e-10},
+	{"CompleteD", func(tc hegel.TestCase) []float64 { return []float64{hzGenProbOrBad(tc)} },
+		func(a []float64) float64 { return mathext.CompleteD(a[0]) }, 1e-10},
+	{"EllipticF", func(tc hegel.TestCase) []float64 { return []float64{hzGenAngle(tc), hzGenProb(tc)} },
+		func(a []float64) float64 { return mathext.EllipticF(a[0], a[1]) }, 1e-10},
+	{"EllipticE", func(tc hegel.TestCase) []float64 { return []float64{hzGenAngle(tc), hzGenProb(tc)} },
+		func(a []float64) float64 { return mathext.EllipticE(a[0], a[1]) }, 1e-10},
+	{"EllipticRF", func(tc hegel.TestCase) []float64 {
+		return []float64{hzGenNumOrBad(tc), hzGenNumOrBad(tc), hzGenNumOrBad(tc)}
+	}, func(a []float64) float64 { return mathext.EllipticRF(a[0], a[1], a[2]) }, 1e-10},
+	{"EllipticRD", func(tc hegel.TestCase) []float64 {
+		return []float64{hzGenNumOrBad(tc), hzGenNumOrBad(tc), hzGenNumOrBad(tc)}
+	}, func(a []float64) float64 { return mathext.EllipticRD(a[0], a[1], a[2]) }, 1e-10},
+}
+
+// hzGenShapeOrBad draws a shape, or (rarely) 0 or a negative value.
+func hzGenShapeOrBad(tc hegel.TestCase) float64 {
+	if hzChance(tc, 4) {
+		return -hzGenNum(tc, false)
+	}
+	return hzGenShape(tc)
+}
+
+// hzGenNumOrBad draws a non-negative number, or (rarely) a negative one.
+func hzGenNumOrBad(tc hegel.TestCase) float64 {
+	if hzChance(tc, 4) {
+		return -hzGenPos(tc)
+	}
+	return hzGenNum(tc, false)
+}
+
+// hzGenSmall draws a number of moderate size (for the hypergeometric parameters).
+func hzGenSmall(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 3) {
+	case 0:
+		return float64(hzDrawInt(tc, -5, 5))
+	case 1:
+		return float64(hzDrawInt(tc, -20, 20)) / 2
+	case 2:
+		return float64(hzDrawInt(tc, -1000, 1000)) / 100
+	default:
+		return float64(hzDrawInt(tc, -30, 30)) + float64(hzDrawInt(tc, 1, 9))/10
+	}
+}
+
+// hzGenZ draws the hypergeometric argument: inside the unit disc mostly, at the branch points
+// and beyond sometimes.
+func hzGenZ(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 5) {
+	case 0:
+		return hzPick(tc, []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5})
+	case 1:
+		return -1 - hzGenNum(tc, false)
+	case 2:
+		return -float64(hzDrawInt(tc, 900, 1000)) / 1000
+	default:
+		return float64(hzDrawInt(tc, -999, 999)) / 1000
+	}
+}
+
+// hzGenAngle draws an amplitude: mostly within [-pi/2, pi/2], sometimes beyond.
+func hzGenAngle(tc hegel.TestCase) float64 {
+	if hzChance(tc, 80) {
+		return float64(hzDrawInt(tc, -1000, 1000)) / 1000 * math.Pi / 2
+	}
+	return float64(hzDrawInt(tc, -4000, 4000)) / 1000 * math.Pi
+}
+
+// hzGammaInvTiny estimates the inverse regularized gamma x for (a, y) as (y Gamma(a+1))^(1/a) and
+// reports whether it is below 1e-8 (where the recorded bug gammaIncInvUnderflow bites).
+func hzGammaInvTiny(a, y float64) bool {
+	if a <= 0 || y <= 0 || y >= 1 {
+		return false
+	}
+	lg, _ := math.Lgamma(a + 1)
+	return (math.Log(y)+lg)/a < math.Log(1e-8)
+}
+
+// hzInvBetaBad: the region where InvRegIncBeta is wrong (recorded bug invRegIncBetaLarge).
+func hzInvBetaBad(a, b, y float64) bool {
+	m := math.Min(y, 1-y)
+	return m <= 1e-6 || (math.Max(a, b) > 1e4 && m < 1e-3)
+}
+
+// hzMathAvoid keeps the generated cases away from the recorded bugs (HZKnown).
+func hzMathAvoid(name string, a []float64) bool {
+	switch name {
+	case "Beta", "Lbeta":
+		if HZKnown.lbetaLarge && (math.Abs(a[0]) > 1e6 || math.Abs(a[1]) > 1e6) && a[0] > 0 && a[1] > 0 {
+			hzAvoid("lbetaLarge")
+			return true
+		}
+	case "GammaIncRegInv":
+		if HZKnown.gammaIncInvUnderflow && hzGammaInvTiny(a[0], a[1]) {
+			hzAvoid("gammaIncInvUnderflow")
+			return true
+		}
+	case "GammaIncRegCompInv":
+		if HZKnown.gammaIncCompInvNearOne && a[1] > 1-1e-6 && a[1] < 1 {
+			hzAvoid("gammaIncCompInvNearOne")
+			return true
+		}
+	case "GammaIncReg":
+		if HZKnown.argumentChecks && a[1] == 0 && a[0] <= 0 {
+			hzAvoid("argumentChecks")
+			return true
+		}
+	case "Hypergeo":
+		if HZKnown.hypergeoNaN && a[2] <= 0 && a[2] == math.Floor(a[2]) {
+			hzAvoid("hypergeoNaN") // the oracle judges the pole only when a or b terminates the series first
+			return true
+		}
+		if HZKnown.hypergeoPrecision && (a[2] < 0 || a[3] <= -0.9 || a[3] >= 0.99 || math.Max(math.Abs(a[0]), math.Abs(a[1])) >= 10) {
+			hzAvoid("hypergeoPrecision")
+			return true
+		}
+	case "EllipticF", "EllipticE":
+		if HZKnown.ellipticAmplitude && math.Abs(a[0]) > math.Pi/2 {
+			hzAvoid("ellipticAmplitude")
+			return true
+		}
+	case "RegIncBeta":
+		if HZKnown.regIncBetaTinyB && a[1] < 1 && 1-a[2] < 1e-3 && a[2] < 1 {
+			hzAvoid("regIncBetaTinyB")
+			return true
+		}
+	case "InvRegIncBeta":
+		if HZKnown.argumentChecks && (a[2] == 0 || a[2] == 1) && (a[0] <= 0 || a[1] <= 0) {
+			hzAvoid("argumentChecks")
+			return true
+		}
+		if HZKnown.invRegIncBetaLarge && hzInvBetaBad(a[0], a[1], a[2]) {
+			hzAvoid("invRegIncBetaLarge")
+			return true
+		}
+	case "Digamma":
+		if HZKnown.digammaNearPole && a[0] < 0 && math.Abs(a[0]-math.Round(a[0])) < 1e-5*math.Abs(a[0]) {
+			hzAvoid("digammaNearPole")
+			return true
+		}
+	case "Zeta":
+		if HZKnown.zetaOverflow && a[0] > 1e12 {
+			hzAvoid("zetaOverflow")
+			return true
+		}
+		if HZKnown.zetaNegativeQ && a[1] < 0 {
+			hzAvoid("zetaNegativeQ")
+			return true
+		}
+	}
+	return false
+}
+
+// hzMathTol returns the relative and absolute tolerances for a function's result.
+func hzMathTol(name string, a []float64, rtol float64) (float64, float64) {
+	switch name {
+	case "Digamma":
+		if HZKnown.digammaPrecision {
+			return rtol, 1e-10
+		}
+	case "Lbeta", "MvLgamma":
+		// the log-gamma terms cancel; their rounding is the floor
+		return rtol, 1e-15 * (1 + hzLgammaScale(a...))
+	case "Beta":
+		return rtol + 1e-15*(1+hzLgammaScale(a...)), 0
+	case "RegIncBeta", "InvRegIncBeta", "GammaIncReg", "GammaIncRegComp", "GammaIncRegInv", "GammaIncRegCompInv":
+		if a[0] > 1e4 || (len(a) > 2 && a[1] > 1e4) {
+			if name == "InvRegIncBeta" {
+				return 1e-6, 0 // InvRegIncBeta(0.002, 291457, 0.337) is 1.2e-7 off
+			}
+			return 1e-7, 0
+		}
+		if name == "InvRegIncBeta" && a[0] > 0 && a[1] > 0 {
+			// the inverse is ill-conditioned for a tiny parameter: dx/x = dy/(a y) at small x
+			return math.Max(rtol, 1e-11/math.Min(a[0], a[1])), 0
+		}
+		if name == "GammaIncRegCompInv" && a[0] > 0 && a[1] < 1 {
+			// dx/x = d(1-y)/(a (1-y)) at small x, and 1 - y carries the rounding of y
+			return math.Max(rtol, 1e-15/(a[0]*(1-a[1]))), 0
+		}
+	case "Zeta":
+		// q^-x for a huge x goes through repeated squaring in math.Pow, which loses 1e-16 x
+		return rtol + 1e-16*math.Abs(a[0]), 0
+	case "Hypergeo":
+		// the polynomial cases have exact roots: Hypergeo(3, 2, 1, -0.5) = 0
+		return rtol, 1e-20
+	}
+	return rtol, 0
+}
+
+// hzLgammaScale is the largest |lgamma| among the arguments and their sum.
+func hzLgammaScale(a ...float64) float64 {
+	sum, m := 0.0, 0.0
+	for _, v := range a {
+		if v > 0 {
+			lg, _ := math.Lgamma(v)
+			m = math.Max(m, math.Abs(lg))
+			sum += v
+		}
+	}
+	if sum > 0 {
+		lg, _ := math.Lgamma(sum)
+		m = math.Max(m, math.Abs(lg))
+	}
+	return m
+}
+
+// hzHypergeoClass names the region of a hypergeometric argument list, for the collector.
+func hzHypergeoClass(a []float64) string {
+	switch z := a[3]; {
+	case z == 1:
+		return "Hypergeo z=1"
+	case z > 1:
+		return "Hypergeo z>1"
+	case z < -1:
+		return "Hypergeo z<-1"
+	case a[2] <= 0 && a[2] == math.Floor(a[2]):
+		return "Hypergeo c nonpositive integer"
+	case z <= -0.9:
+		return "Hypergeo z near -1"
+	}
+	return "Hypergeo |z|<1"
+}
+
+func hzArgsN(a []float64) []hzArg {
+	out := make([]hzArg, len(a))
+	for i, v := range a {
+		out[i] = hzN(v)
+	}
+	return out
+}
+
+func TestHegelMathext(t *testing.T) {
+	o := hzStartOracle(t, hzOracleMathext)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		fn := hzPick(ht, hzMathFns)
+		a := fn.gen(ht)
+		if hzMathAvoid(fn.name, a) {
+			return
+		}
+		args := hzArgsN(a)
+		if fn.name == "MvLgamma" {
+			args[1] = hzI(int(a[1]))
+		}
+		want, err := o.eval(fn.name, args...)
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		got, p := hzCall(func() float64 { return fn.call(a) })
+		if fn.name == "Hypergeo" && HZKnown.hypergeoNaN && (p != nil || math.IsNaN(got) || math.IsInf(got, 0)) && want.t == "n" && !math.IsInf(want.num, 0) {
+			hzAvoid("hypergeoNaN")
+			return
+		}
+		hzJudgeNum(ht, c, fn.name, a, want, got, p, fn.rtol)
+	})
+}
+
+// hzJudgeNum compares a numeric result (and panic) with the oracle's verdict.
+func hzJudgeNum(ht *hegel.T, c *hzCollector, name string, a []float64, want hzExpect, got float64, p any, rtol float64) {
+	switch want.t {
+	case "skip":
+		c.count("skip " + name)
+		return
+	case "panic":
+		if p == nil {
+			c.failClass(ht, name+" no panic", "%s%v = %v, want a panic", name, a, got)
+			return
+		}
+		c.count("panic " + name)
+		return
+	}
+	if p != nil {
+		c.failClass(ht, name+" panic", "%s%v panicked: %v (want %v)", name, a, p, want)
+		return
+	}
+	if math.Abs(want.num) < 1e-300 && math.Abs(got) < 1e-300 {
+		c.count("skip denormal " + name) // the libraries flush denormals differently
+		return
+	}
+	rt, at := hzMathTol(name, a, rtol)
+	if !hzClose(got, want.num, rt, at) {
+		class := name
+		if name == "Hypergeo" {
+			class = hzHypergeoClass(a)
+		}
+		c.failClass(ht, class, "%s%v = %v, want %v", name, a, got, want)
+		return
+	}
+	c.count("ok " + name)
+}
+
+// hzGenComplex draws a complex argument of moderate magnitude.
+func hzGenComplex(tc hegel.TestCase) complex128 {
+	part := func() float64 {
+		switch hzDrawInt(tc, 0, 3) {
+		case 0:
+			return 0
+		case 1:
+			return float64(hzDrawInt(tc, -20, 20)) / 4
+		case 2:
+			return float64(hzDrawInt(tc, -2000, 2000)) / 1000
+		default:
+			return float64(hzDrawInt(tc, -30, 30))
+		}
+	}
+	return complex(part(), part())
+}
+
+func TestHegelMathextComplex(t *testing.T) {
+	o := hzStartOracle(t, hzOracleMathext)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		name := hzPick(ht, []string{"Li2", "AiryAi", "AiryAiDeriv"})
+		z := hzGenComplex(ht)
+		want, err := o.eval(name, hzN(real(z)), hzN(imag(z)))
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		var got complex128
+		p := hzCatch(func() {
+			switch name {
+			case "Li2":
+				got = mathext.Li2(z)
+			case "AiryAi":
+				got = mathext.AiryAi(z)
+			default:
+				got = mathext.AiryAiDeriv(z)
+			}
+		})
+		if p != nil {
+			c.failClass(ht, name+" panic", "%s(%v) panicked: %v", name, z, p)
+			return
+		}
+		if want.t == "skip" || cmplx.IsNaN(complex(want.num, want.im)) || cmplx.IsInf(complex(want.num, want.im)) {
+			c.count("skip " + name)
+			return
+		}
+		rt, at := hzMathTol(name, []float64{real(z), imag(z)}, 1e-9)
+		scale := cmplx.Abs(complex(want.num, want.im))
+		if !hzClose(real(got), want.num, rt, at+rt*scale) || !hzClose(imag(got), want.im, rt, at+rt*scale) {
+			c.failClass(ht, name, "%s(%v) = %v, want %v", name, z, got, want)
+			return
+		}
+		c.count("ok " + name)
+	})
+}
