index 0000000..c09d22d
--- /dev/null
+++ b/hegel/hegel_zoo_stat_test.go
@@ -0,0 +1,815 @@
+package hegel
+
+// TestHegelStat: the descriptive statistics of gonum.org/v1/gonum/stat agree with NumPy, SciPy
+// and their documented formulas, with and without weights.
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat"
+)
+
+const hzOracleStat = `
+def W(x, w, hasw):
+    x = np.asarray(x, dtype=float)
+    w = np.asarray(w, dtype=float) if hasw else np.ones(len(x))
+    return x, w
+
+def WZ(x, w, hasw, *ys):
+    # the moments: the points with a weight of 0 contribute nothing (and would make 0 * inf)
+    x, w = W(x, w, hasw)
+    keep = w != 0
+    return (x[keep], w[keep]) + tuple(np.asarray(y, dtype=float)[keep] for y in ys)
+
+def wmean(x, w):
+    if len(x) == 0:
+        return nan
+    return float(np.sum(w * x) / np.sum(w))
+
+def constant(x, w=None, hasw=False):
+    # a dataset without spread (among the points with weight), where the moment ratios are 0/0
+    x = np.asarray(x, dtype=float)
+    if hasw:
+        x = x[np.asarray(w, dtype=float) != 0]
+    return len(x) > 0 and float(np.ptp(x)) <= 1e-7 * float(np.max(np.abs(x)))
+
+UNDEFINED_EMPTY = {"CircularMean", "Skew", "ExKurtosis", "Entropy", "CrossEntropy", "KullbackLeibler",
+                   "JensenShannon", "Hellinger", "Bhattacharyya", "ChiSquare", "KolmogorovSmirnov", "Kendall",
+                   "LinearRegression", "RSquared", "RSquaredFrom", "RNoughtSquared", "BivariateMoment",
+                   "MomentAbout", "Histogram"}
+
+def wvar(x, w, ddof):
+    if len(x) == 0:
+        return nan
+    m = wmean(x, w)
+    return float(np.sum(w * (x - m) ** 2) / (np.sum(w) - ddof))
+
+def S_Mean(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wmean(x, w)
+
+def S_Variance(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wvar(x, w, 1)
+
+def S_PopVariance(x, y, w, hasw, e):
+    x, w = WZ(x, w, hasw)
+    return wvar(x, w, 0)
+
+def S_StdDev(x, y, w, hasw, e):
+    return math.sqrt(S_Variance(x, y, w, hasw, e))
+
+def S_PopStdDev(x, y, w, hasw, e):
+    return math.sqrt(S_PopVariance(x, y, w, hasw, e))
+
+def S_MeanVariance(x, y, w, hasw, e):
+    return [S_Mean(x, y, w, hasw, e), S_Variance(x, y, w, hasw, e)]
+
+def S_PopMeanStdDev(x, y, w, hasw, e):
+    return [S_Mean(x, y, w, hasw, e), S_PopStdDev(x, y, w, hasw, e)]
+
+def S_Skew(x, y, w, hasw, e):
+    if constant(x, w, hasw):
+        skip()
+    x, w = WZ(x, w, hasw)
+    if np.sum(w) <= 2:
+        skip()  # the correction divides by n - 2
+    m = wmean(x, w)
+    s = math.sqrt(wvar(x, w, 1))
+    n = float(np.sum(w))
+    return float(np.sum(w * ((x - m) / s) ** 3) * (n / (n - 1)) * (1 / (n - 2)))
+
+def S_ExKurtosis(x, y, w, hasw, e):
+    if constant(x, w, hasw):
+        skip()
+    x, w = WZ(x, w, hasw)
+    if np.sum(w) <= 3:
+        skip()  # the correction divides by n - 3
+    m = wmean(x, w)
+    s = math.sqrt(wvar(x, w, 1))
+    n = float(np.sum(w))
+    mul = ((n + 1) / (n - 1)) * (n / (n - 2)) * (1 / (n - 3))
+    off = 3 * ((n - 1) / (n - 2)) * ((n - 1) / (n - 3))
+    return float(np.sum(w * ((x - m) / s) ** 4) * mul - off)
+
+def S_Moment(x, y, w, hasw, e):
+    # all points: the code takes w * (x - mean)^n, so a point of weight 0 with an infinite or NaN
+    # power makes the moment NaN (0 * inf), as numpy does
+    x, w = W(x, w, hasw)
+    m = wmean(x, w)
+    if not isint(e[0]) and np.any(np.abs(x - m) <= 1e-13 * np.max(np.abs(x))):
+        skip()  # a deviation that is roundoff: its sign, so NaN or not for a fractional power, is noise
+    return float(np.sum(w * np.power(x - m, e[0])) / np.sum(w))
+
+def S_MomentAbout(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)  # all points, as in Moment
+    return float(np.sum(w * np.power(x - e[1], e[0])) / np.sum(w))
+
+def S_BivariateMoment(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)  # all points, as in Moment
+    y = np.asarray(y, dtype=float)
+    mx, my = wmean(x, w), wmean(y, w)
+    return float(np.sum(w * np.power(x - mx, e[0]) * np.power(y - my, e[1])) / np.sum(w))
+
+def S_GeometricMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(np.exp(np.sum(w * np.log(x)) / np.sum(w)))
+
+def S_HarmonicMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(np.sum(w) / np.sum(w / x))
+
+def S_CircularMean(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    return float(math.atan2(np.sum(w * np.sin(x)), np.sum(w * np.cos(x))))
+
+def S_Correlation(x, y, w, hasw, e):
+    if constant(x, w, hasw) or constant(y, w, hasw):
+        skip()
+    x, w, y = WZ(x, w, hasw, y)
+    dx, dy = x - wmean(x, w), y - wmean(y, w)
+    return float(np.sum(w * dx * dy) / math.sqrt(np.sum(w * dx * dx) * np.sum(w * dy * dy)))
+
+def S_Covariance(x, y, w, hasw, e):
+    x, w, y = WZ(x, w, hasw, y)
+    if len(x) == 0:
+        return nan
+    dx, dy = x - wmean(x, w), y - wmean(y, w)
+    return float(np.sum(w * dx * dy) / (np.sum(w) - 1))
+
+def S_Kendall(x, y, w, hasw, e):
+    x, w = W(x, w, hasw)
+    n = len(x)
+    cc = dc = tot = 0.0
+    for i in range(n):
+        for j in range(i + 1, n):
+            sx, sy = np.sign(x[j] - x[i]), np.sign(y[j] - y[i])
+            wt = w[i] * w[j]
+            tot += wt
+            if sx == 0 or sy == 0:
+                skip()  # a tie: Tau-a counts it neither way; the code counts it by sign bit
+            if sx == sy:
+                cc += wt
+            else:
+                dc += wt
+    return (cc - dc) / tot
+
+def S_Entropy(x, y, w, hasw, e):
+    p = np.asarray(x, dtype=float)
+    nz = p[p != 0]
+    return float(-np.sum(nz * np.log(nz)))
+
+def S_CrossEntropy(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    m = p != 0
+    return float(-np.sum(p[m] * np.log(q[m])))
+
+def S_KullbackLeibler(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    m = p != 0
+    return float(np.sum(p[m] * (np.log(p[m]) - np.log(q[m]))))
+
+def S_JensenShannon(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    mid = 0.5 * (p + q)
+    js = 0.0
+    for pi, qi, mi in zip(p, q, mid):
+        if pi != 0:
+            js += 0.5 * pi * (math.log(pi) - math.log(mi))
+        if qi != 0:
+            js += 0.5 * qi * (math.log(qi) - math.log(mi))
+    return js
+
+def S_Hellinger(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    return float(math.sqrt(1 - np.sum(np.sqrt(p * q))))
+
+def S_Bhattacharyya(x, y, w, hasw, e):
+    p, q = np.asarray(x, dtype=float), np.asarray(y, dtype=float)
+    s = float(np.sum(np.sqrt(p * q)))
+    return inf if s == 0 else -math.log(s)
+
+def S_ChiSquare(x, y, w, hasw, e):
+    r = 0.0
+    for a, b in zip(x, y):
+        if a == 0 and b == 0:
+            continue
+        r += inf if b == 0 else (a - b) ** 2 / b
+    return r
+
+def S_Histogram(x, y, w, hasw, e):
+    # y holds the dividers
+    xs, ws = W(x, w, hasw)
+    dv = np.asarray(y, dtype=float)
+    chk(len(xs) == 0 or (xs.min() >= dv[0] and xs.max() < dv[-1]))  # documented conditions
+    return list(np.histogram(xs, bins=dv, weights=ws)[0])
+
+def S_Quantile(x, y, w, hasw, e):
+    p, kind = e[0], int(e[1])
+    chk(0 <= p <= 1)
+    chk(len(x) > 0)
+    if hasw and all(v == 0 for v in w):
+        if kind == 1:
+            return float(x[0])  # the running sum 0 reaches p * 0 at the first point
+        skip()
+    xs, ws = W(x, w, hasw)
+    if kind == 1:
+        cum = 0.0
+        fidx = p * np.sum(ws)
+        for xi, wi in zip(xs, ws):
+            cum += wi
+            if cum >= fidx:
+                return float(xi)
+        return float(xs[-1])
+    if kind == 7:
+        if hasw:
+            skip()  # a weighted R-7 quantile has no standard definition
+        return float(np.quantile(xs, p, method="linear"))
+    skip()
+
+def S_CDF(x, y, w, hasw, e):
+    q = e[0]
+    chk(len(x) > 0)
+    xs, ws = W(x, w, hasw)
+    if q < xs[0]:
+        return 0.0
+    if q >= xs[-1]:
+        return 1.0
+    if np.sum(ws) == 0:
+        return nan
+    return float(np.sum(ws[xs <= q]) / np.sum(ws))
+
+def S_KolmogorovSmirnov(x, y, w, hasw, e):
+    # y holds the second sample, w the concatenated weights (len(x) then len(y))
+    if len(x) == 0 and len(y) == 0:
+        return 0.0
+    if len(x) == 0 or len(y) == 0:
+        return 1.0
+    xs = np.asarray(x, dtype=float)
+    ys = np.asarray(y, dtype=float)
+    if hasw:
+        wx, wy = np.asarray(w[:len(x)], dtype=float), np.asarray(w[len(x):], dtype=float)
+    else:
+        wx, wy = np.ones(len(x)), np.ones(len(y))
+    best = 0.0
+    for t in np.union1d(xs, ys):
+        fx = np.sum(wx[xs <= t]) / np.sum(wx)
+        fy = np.sum(wy[ys <= t]) / np.sum(wy)
+        best = max(best, abs(fx - fy))
+    return float(best)
+
+def S_LinearRegression(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    if e[0] != 0:
+        return [0.0, float(np.sum(ws * xs * ys) / np.sum(ws * xs * xs))]
+    if len(xs) < 2 or np.sum(ws) == 0 or constant(x, w, hasw) or wvar(xs, ws, 0) == 0:
+        skip()
+    beta, alpha = np.polyfit(xs, ys, 1, w=np.sqrt(ws))
+    return [float(alpha), float(beta)]
+
+def S_RSquared(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    alpha, beta = e[0], e[1]
+    res = np.sum(ws * (ys - alpha - beta * xs) ** 2)
+    tot = np.sum(ws * (ys - wmean(ys, ws)) ** 2)
+    if constant(ys, ws, True):
+        skip()  # 1 - res / 0
+    return float(1 - res / tot)
+
+def S_RSquaredFrom(x, y, w, hasw, e):
+    # x: estimates, y: values
+    est, ws, vals = WZ(x, w, hasw, y)
+    res = np.sum(ws * (vals - est) ** 2)
+    tot = np.sum(ws * (vals - wmean(vals, ws)) ** 2)
+    if constant(vals, ws, True):
+        skip()  # 1 - res / 0
+    return float(1 - res / tot)
+
+def S_RNoughtSquared(x, y, w, hasw, e):
+    xs, ws, ys = WZ(x, w, hasw, y)
+    beta = e[0]
+    return float(np.sum(ws * (beta * xs) ** 2) / np.sum(ws * ys * ys))
+
+def S_Mode(x, y, w, hasw, e):
+    if len(x) == 0 or (hasw and all(v == 0 for v in w)):
+        return [0.0, 0.0]  # no weight exceeds the initial count of 0
+    xs, ws = W(x, w, hasw)
+    counts = {}
+    for xi, wi in zip(xs, ws):
+        counts[xi] = counts.get(xi, 0.0) + wi
+    best = max(counts.values())
+    if sum(1 for v in counts.values() if v == best) > 1:
+        skip()
+    val = [k for k, v in counts.items() if v == best][0]
+    return [float(val), float(best)]
+
+def S_StdErr(x, y, w, hasw, e):
+    return e[0] / math.sqrt(e[1])
+
+def S_StdScore(x, y, w, hasw, e):
+    if e[2] == 0:
+        skip()
+    return (e[0] - e[1]) / e[2]
+
+def S_WassersteinDistance(x, y, w, hasw, e):
+    if len(x) == 0 or len(y) == 0:
+        return nan
+    if hasw:
+        return float(st.wasserstein_distance(x, y, w[:len(x)], w[len(x):]))
+    return float(st.wasserstein_distance(x, y))
+
+def Stat(name, x, y, w, hasw, e):
+    if len(x) == 0 and name in UNDEFINED_EMPTY:
+        skip()
+    try:
+        return globals()["S_" + name](x, y, w, hasw, e)
+    except (ZeroDivisionError, ValueError):
+        skip()  # a 0/0 or log(0) of the model: not judged
+`
+
+// hzGenSeries draws n values of one profile; a third of the series come from a small pool, so
+// ties are common.
+func hzGenSeries(tc hegel.TestCase, n int) []float64 {
+	xs := make([]float64, n)
+	profile := hzDrawInt(tc, 0, 5)
+	one := func() float64 {
+		switch profile {
+		case 0:
+			return float64(hzDrawInt(tc, -5, 5))
+		case 1:
+			return float64(hzDrawInt(tc, -100, 100)) / 10
+		case 2:
+			return float64(hzDrawInt(tc, 0, 100))
+		case 3:
+			return float64(hzDrawInt(tc, -10000, 10000)) / 1000
+		case 4:
+			return float64(hzDrawInt(tc, -1000, 1000)) * 1000
+		default:
+			return hzGenNum(tc, true)
+		}
+	}
+	if hzChance(tc, 33) {
+		pool := []float64{one(), one(), one()}[:hzDrawInt(tc, 1, 3)]
+		for i := range xs {
+			xs[i] = hzPick(tc, pool)
+		}
+		return xs
+	}
+	for i := range xs {
+		xs[i] = one()
+	}
+	return xs
+}
+
+func hzGenLen(tc hegel.TestCase) int {
+	switch hzDrawInt(tc, 0, 9) {
+	case 0:
+		return hzDrawInt(tc, 0, 2)
+	case 1:
+		return hzDrawInt(tc, 13, 60)
+	default:
+		return hzDrawInt(tc, 1, 12)
+	}
+}
+
+// hzGenWeights draws positive weights (a zero weight now and then when zeros is set).
+func hzGenWeights(tc hegel.TestCase, n int, zeros bool) []float64 {
+	w := make([]float64, n)
+	for i := range w {
+		switch hzDrawInt(tc, 0, 3) {
+		case 0:
+			w[i] = 1
+		case 1:
+			w[i] = float64(hzDrawInt(tc, 1, 10))
+		case 2:
+			w[i] = float64(hzDrawInt(tc, 1, 1000)) / 1000
+		default:
+			w[i] = float64(hzDrawInt(tc, 1, 99)) / 10
+		}
+		if zeros && hzChance(tc, 5) {
+			w[i] = 0
+		}
+	}
+	return w
+}
+
+// hzGenProbs draws a probability vector of n entries (zeros now and then), normalised when
+// norm is set.
+func hzGenProbs(tc hegel.TestCase, n int, norm bool) []float64 {
+	p := make([]float64, n)
+	var sum float64
+	for i := range p {
+		if hzChance(tc, 10) {
+			p[i] = 0
+		} else {
+			p[i] = float64(hzDrawInt(tc, 1, 100))
+		}
+		sum += p[i]
+	}
+	if sum == 0 && len(p) > 0 {
+		p[0], sum = 1, 1
+	}
+	if norm {
+		for i := range p {
+			p[i] /= sum
+		}
+	}
+	return p
+}
+
+func hzMaxAbs(xs ...[]float64) float64 {
+	m := 0.0
+	for _, s := range xs {
+		for _, v := range s {
+			if math.Abs(v) > m {
+				m = math.Abs(v)
+			}
+		}
+	}
+	return m
+}
+
+// hzStatCase is one generated call: the inputs and the call itself.
+type hzStatCase struct {
+	name  string
+	x, y  []float64
+	w     []float64 // nil when unweighted
+	extra []float64
+	call  func() []float64
+	scale float64 // the magnitude the absolute tolerance is relative to
+	rtol  float64
+}
+
+func hzNilOr(w []float64) []float64 {
+	if w == nil {
+		return []float64{}
+	}
+	return w
+}
+
+// hzGenStat draws a stat function and its inputs.
+func hzGenStat(tc hegel.TestCase) hzStatCase {
+	name := hzPick(tc, []string{"Mean", "Variance", "PopVariance", "StdDev", "PopStdDev", "MeanVariance", "PopMeanStdDev",
+		"Skew", "ExKurtosis", "Moment", "MomentAbout", "BivariateMoment", "GeometricMean", "HarmonicMean",
+		"CircularMean", "Correlation", "Covariance", "Kendall", "Entropy", "CrossEntropy", "KullbackLeibler",
+		"JensenShannon", "Hellinger", "Bhattacharyya", "ChiSquare", "Histogram", "Quantile", "CDF",
+		"KolmogorovSmirnov", "LinearRegression", "RSquared", "RSquaredFrom", "RNoughtSquared", "Mode",
+		"StdErr", "StdScore", "WassersteinDistance"})
+	n := hzGenLen(tc)
+	x := hzGenSeries(tc, n)
+	var w []float64
+	if hzChance(tc, 50) {
+		w = hzGenWeights(tc, n, true)
+	}
+	c := hzStatCase{name: name, x: x, w: w, rtol: 1e-10, scale: hzMaxAbs(x)}
+	one := func(f func() float64) func() []float64 { return func() []float64 { return []float64{f()} } }
+	switch name {
+	case "Mean":
+		c.call = one(func() float64 { return stat.Mean(x, w) })
+	case "Variance":
+		c.scale *= c.scale
+		c.call = one(func() float64 { return stat.Variance(x, w) })
+	case "PopVariance":
+		c.scale *= c.scale
+		c.call = one(func() float64 { return stat.PopVariance(x, w) })
+	case "StdDev":
+		c.call = one(func() float64 { return stat.StdDev(x, w) })
+	case "PopStdDev":
+		c.call = one(func() float64 { return stat.PopStdDev(x, w) })
+	case "MeanVariance":
+		c.scale *= c.scale
+		c.call = func() []float64 { m, v := stat.MeanVariance(x, w); return []float64{m, v} }
+	case "PopMeanStdDev":
+		c.call = func() []float64 { m, s := stat.PopMeanStdDev(x, w); return []float64{m, s} }
+	case "Skew":
+		c.scale, c.rtol = 1, 1e-8
+		c.call = one(func() float64 { return stat.Skew(x, w) })
+	case "ExKurtosis":
+		c.scale, c.rtol = 1, 1e-8
+		c.call = one(func() float64 { return stat.ExKurtosis(x, w) })
+	case "Moment", "MomentAbout":
+		k := float64(hzDrawInt(tc, 0, 6))
+		if hzChance(tc, 15) {
+			k = float64(hzDrawInt(tc, 1, 10)) / 2
+		}
+		c.scale = math.Pow(c.scale, k)
+		if name == "Moment" {
+			c.extra = []float64{k}
+			c.call = one(func() float64 { return stat.Moment(k, x, w) })
+		} else {
+			mean := hzGenNum(tc, true)
+			if hzChance(tc, 40) {
+				mean = stat.Mean(x, w)
+			}
+			c.extra = []float64{k, mean}
+			c.scale = math.Pow(hzMaxAbs(x, []float64{mean}), k)
+			c.call = one(func() float64 { return stat.MomentAbout(k, x, mean, w) })
+		}
+	case "BivariateMoment":
+		r, s := float64(hzDrawInt(tc, 0, 4)), float64(hzDrawInt(tc, 0, 4))
+		c.y = hzGenSeries(tc, n)
+		c.extra = []float64{r, s}
+		c.scale = math.Pow(hzMaxAbs(x, c.y), r+s)
+		c.call = one(func() float64 { return stat.BivariateMoment(r, s, x, c.y, w) })
+	case "GeometricMean", "HarmonicMean":
+		for i := range x {
+			x[i] = math.Abs(x[i])
+			if x[i] == 0 {
+				x[i] = 1
+			}
+		}
+		if name == "GeometricMean" {
+			c.call = one(func() float64 { return stat.GeometricMean(x, w) })
+		} else {
+			c.call = one(func() float64 { return stat.HarmonicMean(x, w) })
+		}
+	case "CircularMean":
+		c.scale = 1
+		c.call = one(func() float64 { return stat.CircularMean(x, w) })
+	case "Correlation":
+		c.y = hzGenPaired(tc, x)
+		c.scale, c.rtol = 1, 1e-9
+		c.call = one(func() float64 { return stat.Correlation(x, c.y, w) })
+	case "Covariance":
+		c.y = hzGenPaired(tc, x)
+		c.scale = hzMaxAbs(x) * hzMaxAbs(c.y)
+		c.call = one(func() float64 { return stat.Covariance(x, c.y, w) })
+	case "Kendall":
+		c.y = hzGenPaired(tc, x)
+		c.scale = 1
+		c.call = one(func() float64 { return stat.Kendall(x, c.y, w) })
+	case "Entropy":
+		x = hzGenProbs(tc, n, hzChance(tc, 70))
+		c.x, c.w, c.scale = x, nil, 1
+		c.call = one(func() float64 { return stat.Entropy(x) })
+	case "CrossEntropy", "KullbackLeibler", "JensenShannon", "Hellinger", "Bhattacharyya", "ChiSquare":
+		norm := hzChance(tc, 70)
+		x = hzGenProbs(tc, n, norm)
+		c.y = hzGenProbs(tc, n, norm)
+		c.x, c.w, c.scale = x, nil, 1
+		y := c.y
+		switch name {
+		case "CrossEntropy":
+			c.call = one(func() float64 { return stat.CrossEntropy(x, y) })
+		case "KullbackLeibler":
+			c.call = one(func() float64 { return stat.KullbackLeibler(x, y) })
+		case "JensenShannon":
+			c.call = one(func() float64 { return stat.JensenShannon(x, y) })
+		case "Hellinger":
+			c.call = one(func() float64 { return stat.Hellinger(x, y) })
+		case "Bhattacharyya":
+			c.call = one(func() float64 { return stat.Bhattacharyya(x, y) })
+		default:
+			c.scale = 1 + hzMaxAbs(x, y)
+			c.call = one(func() float64 { return stat.ChiSquare(x, y) })
+		}
+	case "Histogram":
+		sort.Float64s(x)
+		// dividers: sorted, first <= min x, last > max x
+		nd := hzDrawInt(tc, 2, 8)
+		d := hzGenSeries(tc, nd)
+		if n > 0 {
+			lo, hi := x[0], x[n-1]
+			d[0] = lo - float64(hzDrawInt(tc, 0, 3))
+			d[nd-1] = hi + float64(hzDrawInt(tc, 1, 3))
+			for i := 1; i < nd-1; i++ {
+				d[i] = lo + (hi-lo)*float64(hzDrawInt(tc, 0, 1000))/1000
+			}
+		}
+		sort.Float64s(d)
+		c.y = d
+		c.scale = 1
+		c.rtol = 1e-12
+		c.call = func() []float64 { return stat.Histogram(nil, d, x, w) }
+	case "Quantile":
+		sort.Float64s(x)
+		p := hzGenProb(tc)
+		if hzChance(tc, 3) {
+			p = hzPick(tc, []float64{-0.1, 1.1})
+		}
+		kind := hzPick(tc, []float64{1, 7, 7})
+		c.extra = []float64{p, kind}
+		c.call = one(func() float64 { return stat.Quantile(p, stat.CumulantKind(kind), x, w) })
+	case "CDF":
+		sort.Float64s(x)
+		q := hzGenNum(tc, true)
+		if n > 0 && hzChance(tc, 50) {
+			q = hzPick(tc, x)
+		}
+		c.extra = []float64{q}
+		c.scale = 1
+		c.call = one(func() float64 { return stat.CDF(q, stat.Empirical, x, w) })
+	case "KolmogorovSmirnov":
+		sort.Float64s(x)
+		m := hzGenLen(tc)
+		y := hzGenSeries(tc, m)
+		if hzChance(tc, 40) && n > 0 {
+			for i := range y {
+				y[i] = hzPick(tc, x)
+			}
+		}
+		sort.Float64s(y)
+		c.y = y
+		var wy []float64
+		if w != nil {
+			w = hzGenWeights(tc, n, false)
+			wy = hzGenWeights(tc, m, false)
+			c.w = append(append([]float64{}, w...), wy...)
+		}
+		c.scale = 1
+		c.call = one(func() float64 { return stat.KolmogorovSmirnov(x, w, y, wy) })
+	case "LinearRegression":
+		c.y = hzGenPaired(tc, x)
+		origin := hzChance(tc, 30)
+		c.extra = []float64{0}
+		if origin {
+			c.extra = []float64{1}
+		}
+		c.scale = hzMaxAbs(x, c.y) * (1 + hzMaxAbs(c.y))
+		// beta = cov(x, y)/var(x): roundoff in the mean of y (eps max|y|) divided by the spread of x
+		// (LinearRegression(x=[2.01e-06 -1.19e-4], y=[0.5 0.5], w=[2 0.039]) is 0 here and 8.8e-12
+		// with NumPy); alpha adds beta's error times |x|
+		if xs := hzWeighted(x, w); hzSpread(xs) > 0 {
+			c.scale = math.Max(c.scale, hzMaxAbs(c.y)*(1+hzMaxAbs(xs))/hzSpread(xs))
+		}
+		c.rtol = 1e-9
+		c.call = func() []float64 { a, b := stat.LinearRegression(x, c.y, w, origin); return []float64{a, b} }
+	case "RSquared":
+		c.y = hzGenPaired(tc, x)
+		alpha, beta := hzGenNum(tc, true), hzGenNum(tc, true)
+		if hzChance(tc, 50) && n > 1 {
+			alpha, beta = stat.LinearRegression(x, c.y, w, false)
+		}
+		c.extra = []float64{alpha, beta}
+		c.scale = hzRSquaredScale(x, c.y, w, alpha, beta)
+		c.rtol = 1e-9
+		c.call = one(func() float64 { return stat.RSquared(x, c.y, w, alpha, beta) })
+	case "RSquaredFrom":
+		c.y = hzGenPaired(tc, x)
+		c.scale = hzRSquaredScale(x, c.y, w, hzMaxAbs(c.y), 0)
+		c.rtol = 1e-9
+		c.call = one(func() float64 { return stat.RSquaredFrom(x, c.y, w) })
+	case "RNoughtSquared":
+		c.y = hzGenPaired(tc, x)
+		beta := hzGenNum(tc, true)
+		c.extra = []float64{beta}
+		c.scale = hzRSquaredScale(x, c.y, w, 0, beta)
+		c.rtol = 1e-9
+		c.call = one(func() float64 { return stat.RNoughtSquared(x, c.y, w, beta) })
+	case "Mode":
+		c.scale = 1
+		c.call = func() []float64 { v, cnt := stat.Mode(x, w); return []float64{v, cnt} }
+	case "StdErr":
+		s, k := hzGenNum(tc, false), float64(hzDrawInt(tc, 1, 100))
+		c.extra = []float64{s, k}
+		c.scale = s
+		c.call = one(func() float64 { return stat.StdErr(s, k) })
+	case "StdScore":
+		v, m, s := hzGenNum(tc, true), hzGenNum(tc, true), hzGenPos(tc)
+		c.extra = []float64{v, m, s}
+		c.scale = (math.Abs(v) + math.Abs(m)) / s
+		c.call = one(func() float64 { return stat.StdScore(v, m, s) })
+	case "WassersteinDistance":
+		m := hzGenLen(tc)
+		y := hzGenSeries(tc, m)
+		c.y = y
+		var wy []float64
+		if w != nil {
+			w = hzGenWeights(tc, n, false)
+			wy = hzGenWeights(tc, m, false)
+			c.w = append(append([]float64{}, w...), wy...)
+		}
+		c.scale = hzMaxAbs(x, y)
+		c.rtol = 1e-9
+		c.call = one(func() float64 { return stat.WassersteinDistance(x, y, w, wy) })
+	}
+	return c
+}
+
+// hzGenPaired draws a second series of the same length: independent, or a noisy linear image
+// of the first.
+func hzGenPaired(tc hegel.TestCase, x []float64) []float64 {
+	n := len(x)
+	if hzChance(tc, 50) {
+		return hzGenSeries(tc, n)
+	}
+	a, b := hzGenNum(tc, true), hzGenNum(tc, true)
+	y := make([]float64, n)
+	for i, v := range x {
+		y[i] = a + b*v + float64(hzDrawInt(tc, -10, 10))/10
+	}
+	return y
+}
+
+// hzStatAvoid keeps the generated cases away from the recorded bugs (HZKnown).
+func hzStatAvoid(c hzStatCase) bool {
+	switch c.name {
+	case "HarmonicMean":
+		if HZKnown.harmonicMeanEmpty && len(c.x) == 0 {
+			hzAvoid("harmonicMeanEmpty")
+			return true
+		}
+	case "Quantile":
+		if HZKnown.quantileEmpiricalPanic && c.w != nil && c.extra[0] >= 1-1e-12 && c.extra[0] <= 1 {
+			hzAvoid("quantileEmpiricalPanic")
+			return true
+		}
+	case "StdDev", "PopStdDev", "MeanStdDev", "PopMeanStdDev":
+		if HZKnown.stdDevConstant && len(c.x) > 0 && hzSpread(hzWeighted(c.x, c.w)) <= 1e-7*hzMaxAbs(hzWeighted(c.x, c.w)) {
+			hzAvoid("stdDevConstant")
+			return true
+		}
+	}
+	return false
+}
+
+// hzWeighted keeps the points with a nonzero weight.
+func hzWeighted(x, w []float64) []float64 {
+	if w == nil {
+		return x
+	}
+	var out []float64
+	for i, v := range x {
+		if w[i] != 0 {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// hzRSquaredScale: the residuals y - alpha - beta x cancel when the fitted values are far
+// larger than the spread of y, and the coefficient of determination is off by about
+// eps (|alpha| + |beta| max|x| + max|y|) / spread(y) absolutely (RSquared(x=[453000 283000
+// -379000 955000], y within 1 of 1.66e6, alpha=1.66e6) is 5e-8 off relatively for an R^2
+// of 6.6e-4). The tolerance is 1e-13 of that ratio (or of 1).
+func hzRSquaredScale(x, y, w []float64, alpha, beta float64) float64 {
+	yw := hzWeighted(y, w)
+	m := math.Abs(alpha) + math.Abs(beta)*hzMaxAbs(hzWeighted(x, w)) + hzMaxAbs(yw)
+	s := hzSpread(yw)
+	if s == 0 || m/s < 1 {
+		return 1
+	}
+	return m / s
+}
+
+func hzSpread(x []float64) float64 {
+	lo, hi := math.Inf(1), math.Inf(-1)
+	for _, v := range x {
+		lo, hi = math.Min(lo, v), math.Max(hi, v)
+	}
+	return hi - lo
+}
+
+func TestHegelStat(t *testing.T) {
+	o := hzStartOracle(t, hzOracleStat)
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hzGenStat(ht)
+		if hzStatAvoid(c) {
+			return
+		}
+		want, err := o.eval("Stat", hzS(c.name), hzA(c.x), hzA(hzNilOr(c.y)), hzA(hzNilOr(c.w)), hzB(c.w != nil), hzA(hzNilOr(c.extra)))
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		var got []float64
+		pan := hzCatch(func() { got = c.call() })
+		label := fmt.Sprintf("%s(x=%s, y=%s, w=%s, %v)", c.name, hzShow(c.x), hzShow(c.y), hzShow(c.w), c.extra)
+		switch want.t {
+		case "skip":
+			col.count("skip " + c.name)
+			return
+		case "panic":
+			if pan == nil {
+				col.failClass(ht, c.name+" no panic", "%s = %v, want a panic", label, got)
+				return
+			}
+			col.count("panic " + c.name)
+			return
+		}
+		if pan != nil {
+			col.failClass(ht, c.name+" panic", "%s panicked: %v (want %v)", label, pan, want)
+			return
+		}
+		exp := want.arr
+		if want.t == "n" {
+			exp = []float64{want.num}
+		}
+		if len(exp) != len(got) {
+			col.failClass(ht, c.name+" length", "%s = %v, want %v", label, got, want)
+			return
+		}
+		for i := range exp {
+			if !hzClose(got[i], exp[i], c.rtol, 1e-13*c.scale) {
+				col.failClass(ht, c.name, "%s = %v, want %v", label, got, want)
+				return
+			}
+		}
+		col.count("ok " + c.name)
+	})
+}
