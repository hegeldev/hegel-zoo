diff --git a/hegel/hegel_zoo_shapes_distuv_test.go b/hegel/hegel_zoo_shapes_distuv_test.go
new file mode 100644
index 0000000..32a886a
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_distuv_test.go
@@ -0,0 +1,491 @@
+package hegel
+
+// The shape regions of the recorded distuv bugs (bugs.toml gonum/14..36) and of the five
+// mathext bugs the distributions inherit (gonum/4, 5, 6, 7, 9), and the narrow properties
+// over the first twelve (gonum/14..25; the rest follow in part 3): each region is a generator
+// over the bug's shape with random contents, judged exactly like the wide property
+// (judgeDist: the oracle, the strict tolerance, the classifier naming the shape). Every
+// narrow property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (shaped(shape, past)) and the property passes. The wide
+// property TestHegelDistuv draws the regions of each distribution one time in three by
+// weight by default (known) and never under HEGEL_NO_KNOWN=1. The edges of the regions were measured
+// against the oracle at the strict tolerance; the comments quote them.
+
+import (
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat/distuv"
+)
+
+// on is the call of the method at the drawn arguments: the parameters followed by the
+// argument (the parameters alone for a moment).
+func on(method string, args hegel.Generator[[]float64]) hegel.Generator[distCall] {
+	return hegel.Map(args, func(a []float64) distCall {
+		if isMoment(method) {
+			return distCall{method, a, 0}
+		}
+		return distCall{method, a[:len(a)-1], a[len(a)-1]}
+	})
+}
+
+// onOne is the call of one of the methods.
+func onOne(methods hegel.Generator[string], args hegel.Generator[[]float64]) hegel.Generator[distCall] {
+	return hegel.FlatMap(methods, func(m string) hegel.Generator[distCall] { return on(m, args) })
+}
+
+// args is the parameter list followed by the argument.
+func args(params hegel.Generator[[]float64], x hegel.Generator[float64]) hegel.Generator[[]float64] {
+	return hegel.FlatMap(params, func(p []float64) hegel.Generator[[]float64] {
+		return hegel.Map(x, func(v float64) []float64 { return append(append([]float64{}, p...), v) })
+	})
+}
+
+// offsetBy renders [Mu, S, t] into [Mu, S, Mu + S t]: an argument t scales out.
+func offsetBy(a []float64) []float64 { return []float64{a[0], a[1], a[0] + a[1]*a[2]} }
+
+// signedInts is an integer in [lo, hi] of either sign.
+func signedInts(lo, hi int) hegel.Generator[float64] {
+	return hegel.Map(counts(ints(lo, hi), ints(0, 1)), func(v []int) float64 { return sign(v[1]) * float64(v[0]) })
+}
+
+// decimals is m 10^e for m in [mLo, mHi] and e in [eLo, eHi].
+func decimals(mLo, mHi, eLo, eHi int) hegel.Generator[float64] {
+	return hegel.Map(counts(ints(mLo, mHi), ints(eLo, eHi)), func(v []int) float64 { return float64(v[0]) * pow10(v[1]) })
+}
+
+var (
+	densities   = pick("LogProb", "Prob")
+	cumulatives = pick("CDF", "Survival")
+)
+
+// narrowDist runs a narrow property: every drawn case through the wide property's judge.
+func narrowDist(t *testing.T, cases hegel.Generator[distCase]) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeDist(ht, o, c, hegel.Draw(ht, cases))
+	})
+}
+
+// --------------------------------------------------------------------------- gonum/14
+
+// oddTenths: (2k + 1)/10 to 100 either side: never 0, and never twice a tenth, so that an
+// argument offset in tenths is never -Mu/2 (the standard log density is even: at Mu + t it
+// equals the one at t only for Mu = 0 or Mu = -2t).
+var oddTenths = hegel.Map(ints(-500, 499), func(k int) float64 { return float64(2*k+1) / 10 })
+
+// quartersButOne: k/4 to 10 except 1 (with Mu = 0 a scale of 1 shows nothing).
+var quartersButOne = hegel.Map(ints(1, 39), func(k int) float64 {
+	if k >= 4 {
+		k++
+	}
+	return float64(k) / 4
+})
+
+// logisticLogProbIgnored: Logistic{Mu, 1}.LogProb(Mu + t) for an odd-tenths Mu and t in tenths
+// to 30 (gonum returns the standard log density at Mu + t instead of the one at t; measured:
+// off by 6e-4 absolute at least), and Logistic{0, S}.LogProb(0) for S not 1 (off by log S).
+// Past the shape: the density Prob at the same arguments, which is right.
+var logisticLogProbIgnored = shaped(
+	hegel.OneOf(
+		on("LogProb", hegel.Map(args(tuple(oddTenths, hegel.Just(1.0)), scaled(ints(-300, 300), 0.1)), offsetBy)),
+		on("LogProb", args(tuple(hegel.Just(0.0), quartersButOne), hegel.Just(0.0))),
+	),
+	on("Prob", hegel.Map(args(tuple(oddTenths, quartersButOne), scaled(ints(-300, 300), 0.1)), offsetBy)),
+)
+
+func TestHegelLogisticLogProbIgnoresItsParameters(t *testing.T) {
+	narrowDist(t, casesOf("Logistic", logisticLogProbIgnored))
+}
+
+// --------------------------------------------------------------------------- gonum/15
+
+// logisticFarTails: Logistic{Mu, S}.Prob(Mu + S z) for Mu in tenths to 100, S in quarters to
+// 10 and z in [-630, -356] in tenths (the squared 1 + e^-z overflows: 0 where the density is
+// representable; measured: wrong throughout) or in [-2000, -710] (Inf/Inf: NaN); past the
+// shape, z in [-300, -1] (exact).
+var logisticFarTails = on("Prob", hegel.Map(args(tuple(scaled(ints(-1000, 1000), 0.1), scaled(ints(1, 40), 0.25)), shaped(
+	hegel.OneOf(scaled(ints(-6300, -3560), 0.1), scaled(ints(-20000, -7100), 0.1)),
+	scaled(ints(-3000, -10), 0.1),
+)), offsetBy))
+
+func TestHegelLogisticProbInTheFarTails(t *testing.T) {
+	narrowDist(t, casesOf("Logistic", logisticFarTails))
+}
+
+// --------------------------------------------------------------------------- gonum/16
+
+// badProbabilities: outside [0, 1].
+var badProbabilities = hegel.OneOf(
+	pick(-0.1, 1.1, -1.0, 2.0, math.Inf(1)),
+	negatives,
+	hegel.Map(positives, func(v float64) float64 { return 1 + v }),
+)
+
+// logisticQuantileChecks: Logistic.Quantile outside [0, 1] (NaN where the panic is due);
+// past the shape, inside it in thousandths.
+var logisticQuantileChecks = on("Quantile", args(tuple(locations, scales), shaped(badProbabilities, interior)))
+
+// nctQuantileChecks: NoncentralT{Nu <= 3, |Mu| <= 37}.Quantile at 0 or 1 (NaN, or -1, where
+// the infinities are due) or outside [0, 1] (NaN where the panic is due: above Nu = 3 the
+// normal first guess panics); past the shape, p in [0.05, 0.95] in hundredths with an
+// integer Nu to 200.
+var nctQuantileChecks = on("Quantile", shaped(
+	args(tuple(scaled(ints(1, 6), 0.5), scaled(ints(-37, 37), 1)), hegel.OneOf(ends, badProbabilities)),
+	args(tuple(scaled(ints(1, 200), 1), scaled(ints(-37, 37), 1)), scaled(ints(5, 95), 0.01)),
+))
+
+func TestHegelQuantileSkipsItsArgumentChecks(t *testing.T) {
+	narrowDist(t, hegel.OneOf(casesOf("Logistic", logisticQuantileChecks), casesOf("NoncentralT", nctQuantileChecks)))
+}
+
+// --------------------------------------------------------------------------- gonum/17
+
+// nctNarrowNus: Nu in halves to 10, hundredths to 1, integers to 200 and hundreds to 3000.
+var nctNarrowNus = hegel.OneOf(
+	scaled(ints(1, 20), 0.5),
+	scaled(ints(1, 99), 0.01),
+	scaled(ints(1, 200), 1),
+	scaled(ints(3, 30), 100),
+)
+
+// nearTheEnds: p within 1e-2 of 0 or 1, by 1e-4 at least.
+var nearTheEnds = hegel.Map(counts(ints(1, 100), ints(0, 1)), func(v []int) float64 {
+	if v[1] == 0 {
+		return float64(v[0]) * 1e-4
+	}
+	return 1 - float64(v[0])*1e-4
+})
+
+// notInverted: the library's own CDF does not invert its Quantile (the bracket search gave
+// up, or stopped at its bound).
+func notInverted(a []float64) bool {
+	d := distuv.NoncentralT{Nu: a[0], Mu: a[1]}
+	q := d.Quantile(a[2])
+	return math.IsNaN(q) || !hzClose(d.CDF(q), a[2], 1e-3, 0)
+}
+
+// nctBracketBound: NoncentralT{Nu in [0.01, 0.1], |Mu| <= 5}.Quantile(p) for p near the ends
+// (the quantile of so small a Nu lies far beyond 2^24, the bracket bound, and the bound or a
+// fraction of it is returned; measured: wrong at every probed point), kept where the
+// library's own CDF does not invert its Quantile (hegel.Filter, three tries); past the shape,
+// an integer Nu to 200 with p in [0.05, 0.95].
+var nctBracketBound = on("Quantile", shaped(
+	hegel.Filter(args(tuple(scaled(ints(10, 100), 1e-3), scaled(ints(-20, 20), 0.25)), nearTheEnds), notInverted),
+	args(tuple(scaled(ints(1, 200), 1), scaled(ints(-20, 20), 0.25)), scaled(ints(5, 95), 0.01)),
+))
+
+func TestHegelNoncentralTQuantileHitsItsBracketBound(t *testing.T) {
+	narrowDist(t, casesOf("NoncentralT", nctBracketBound))
+}
+
+// --------------------------------------------------------------------------- gonum/18
+
+// nctMildNus: Nu in halves to 10, integers to 200 and hundreds to 3000 (the oracle's
+// quadrature over a large Mu takes a second below Nu = 0.1).
+var nctMildNus = hegel.OneOf(scaled(ints(1, 20), 0.5), scaled(ints(1, 200), 1), scaled(ints(3, 30), 100))
+
+// nctLargeMu: NoncentralT{Nu, Mu}.Prob or CDF at Mu (1 + t/10) for |t| <= 2 and |Mu| = m 10^e
+// in [39, 999000] (the series of the CDF is only valid to 37.6; measured: wrong at every
+// probed point but a CDF of 1 well above a large Mu; LogProb inherits Prob's, and costs the
+// oracle two quadratures); past the shape, |Mu| an integer to 37 (exact to 1e-9).
+var nctLargeMu = onOne(pick("Prob", "CDF"), hegel.Map(
+	args(tuple(nctMildNus, shaped(farMus, signedInts(1, 37))), scaled(ints(-2, 2), 0.1)),
+	func(a []float64) []float64 { return []float64{a[0], a[1], a[1] * (1 + a[2])} },
+))
+
+func TestHegelNoncentralTWithALargeMu(t *testing.T) {
+	narrowDist(t, casesOf("NoncentralT", nctLargeMu))
+}
+
+// --------------------------------------------------------------------------- gonum/19
+
+// nctDensityLargeNu: NoncentralT{Nu = m 10^e in [1e4, 9.9e5], |Mu| <= 5}.LogProb or Prob at
+// Mu + t for |t| <= 2 (the density is the difference of two CDFs, each accurate to about
+// 1e-11 absolute; measured: off by 1e-6 relative or more throughout); past the shape, an
+// integer Nu to 200 (exact to 1e-9).
+var nctDensityLargeNu = onOne(densities, hegel.Map(
+	args(tuple(shaped(decimals(1, 99, 4, 5), scaled(ints(1, 200), 1)), scaled(ints(-20, 20), 0.25)), scaled(ints(-20, 20), 0.1)),
+	func(a []float64) []float64 { return []float64{a[0], a[1], a[1] + a[2]} },
+))
+
+func TestHegelNoncentralTDensityWithALargeNu(t *testing.T) {
+	narrowDist(t, casesOf("NoncentralT", nctDensityLargeNu))
+}
+
+// --------------------------------------------------------------------------- gonum/20
+
+// nctCDFFarOut: NoncentralT{Nu, |Mu| <= 5}.CDF(-m 10^e sqrt(Nu)) for e in 7..9 (x^2/(Nu + x^2)
+// rounds to 1 and the CDF collapses to 1.9e-13, having lost 1e-16 x^2/Nu before; measured:
+// wrong from x^2/Nu = 1e13 whatever Nu, from 1e11 below Nu = 1); past the shape, x within 2
+// of Mu in tenths, where the CDF is 1e-2 at least (the lower tail below 1e-5 is the shape of
+// gonum/19).
+var nctCDFFarOut = on("CDF", shaped(
+	hegel.Map(
+		args(tuple(nctNarrowNus, scaled(ints(-20, 20), 0.25)), hegel.Map(counts(ints(1, 9), ints(7, 9)), func(v []int) float64 { return -float64(v[0]) * pow10(v[1]) })),
+		func(a []float64) []float64 { return []float64{a[0], a[1], a[2] * math.Sqrt(a[0])} },
+	),
+	hegel.Map(
+		args(tuple(nctNarrowNus, scaled(ints(-20, 20), 0.25)), scaled(ints(-20, 20), 0.1)),
+		func(a []float64) []float64 { return []float64{a[0], a[1], a[1] + a[2]} },
+	),
+))
+
+func TestHegelNoncentralTCDFFarOut(t *testing.T) {
+	narrowDist(t, casesOf("NoncentralT", nctCDFFarOut))
+}
+
+// --------------------------------------------------------------------------- gonum/21
+
+// nctTinyNu: NoncentralT{Nu = m 10^-e, |Mu| <= 1}: Quantile(p) for p in hundredths with e in
+// 4..7 (the quantile of so small a Nu is astronomical and the bracket bound is returned), and
+// CDF or Prob at +-k/10 for k in 5..10 with e in 6..7 (measured: off by 1e-7 to 2e-7
+// relative; Nu = 1e-4, or |x| = 10, is exact); past the shape, Nu in thousandths from 1e-3.
+var nctTinyNu = hegel.OneOf(
+	on("Quantile", args(tuple(shaped(decimals(1, 9, -7, -4), scaled(ints(1, 999), 1e-3)), scaled(ints(-4, 4), 0.25)), scaled(ints(1, 99), 0.01))),
+	onOne(pick("CDF", "Prob"), args(tuple(shaped(decimals(1, 9, -7, -6), scaled(ints(1, 999), 1e-3)), scaled(ints(-4, 4), 0.25)), hegel.Map(counts(ints(5, 10), ints(0, 1)), func(v []int) float64 {
+		return sign(v[1]) * float64(v[0]) / 10
+	}))),
+)
+
+func TestHegelNoncentralTWithATinyNu(t *testing.T) {
+	narrowDist(t, casesOf("NoncentralT", nctTinyNu))
+}
+
+// --------------------------------------------------------------------------- gonum/22
+
+// tinyProbabilities: m 10^-e for m to 9 and e in 12..16 (1 - p rounds by up to 5e-17, which
+// log(1 - p) carries: 5e-6 relative at least against a tolerance of 1e-8; measured: wrong
+// throughout where the quantile is large enough for that to show above the absolute
+// tolerance of a quantile, 1e-13 at the parameters' scale; Laplace's upper end - 1 - 2(p -
+// 1/2), exact - is not the shape).
+var tinyProbabilities = decimals(1, 9, -16, -12)
+
+// exponentialQuantileTail: Exponential{Rate = m 10^-e for e in 10..12}.Quantile at a tiny p
+// (the quantile p/Rate is 1e-7 or more); past the shape, p in thousandths.
+var exponentialQuantileTail = on("Quantile", args(tuple(decimals(1, 9, -12, -10)), shaped(tinyProbabilities, interior)))
+
+// weibullQuantileTail: Weibull{K in [2, 20]}.Quantile at a tiny p (the quantile is Lambda
+// (-log(1 - p))^(1/K): the error divided by K, on a value of p^(1/K)); past the shape, p in
+// thousandths.
+var weibullQuantileTail = on("Quantile", args(tuple(scaled(ints(4, 40), 0.5), scales), shaped(tinyProbabilities, interior)))
+
+// laplaceQuantileTail: Laplace{Mu in tenths to 10, S in quarters}.Quantile at a tiny p (the
+// quantile is Mu + S log(2p): a large Mu would dilute the error); past the shape, p in
+// hundredths.
+var laplaceQuantileTail = on("Quantile", args(tuple(scaled(ints(-100, 100), 0.1), scaled(ints(1, 40), 0.25)), shaped(tinyProbabilities, scaled(ints(1, 99), 0.01))))
+
+func TestHegelQuantileTakesLogOfOneMinusP(t *testing.T) {
+	narrowDist(t, hegel.OneOf(
+		casesOf("Exponential", exponentialQuantileTail),
+		casesOf("Weibull", weibullQuantileTail),
+		casesOf("Laplace", laplaceQuantileTail),
+	))
+}
+
+// --------------------------------------------------------------------------- gonum/23
+
+// binomialLogProbTinyP: Binomial{N in [1e5, 1e6], P = m 10^-e for e in 10..14}.LogProb(0) =
+// N log(1 - P), which carries N times the rounding of 1 - P (measured: off by 1e-8 to 1e-4
+// relative; Bernoulli's LogProb(0) and Entropy, and a small N, stay within the 1e-13 absolute
+// tolerance of a log density); past the shape, N to 100 with P in thousandths to 1/2.
+var binomialLogProbTinyP = on("LogProb", args(shaped(
+	tuple(scaled(ints(100, 1000), 1000), decimals(1, 9, -14, -10)),
+	tuple(scaled(ints(1, 100), 1), scaled(ints(1, 500), 1e-3)),
+), hegel.Just(0.0)))
+
+func TestHegelBinomialLogProbTakesLogOfOneMinusP(t *testing.T) {
+	narrowDist(t, casesOf("Binomial", binomialLogProbTinyP))
+}
+
+// --------------------------------------------------------------------------- gonum/24
+
+// triangleFarFromZero: Triangle(a, a + w, c) with a in tenths to 100 either side, w = |a| 10^-e
+// for e in 5..8 and c at a + w j/1000: Variance, StdDev or Skewness (the quadratic form
+// cancels to 1e-16 a^2/w^2 relative, 1e-6 at least; measured: wrong throughout); past the
+// shape, w = |a| or |a|/10 (exact to 1e-12).
+var triangleFarFromZero = onOne(pick("Variance", "StdDev", "Skewness"), hegel.Map(
+	counts(ints(1, 1000), ints(0, 1), shaped(ints(5, 8), ints(0, 1)), ints(0, 1000)),
+	func(v []int) []float64 {
+		a := sign(v[1]) * float64(v[0]) / 10
+		w := math.Abs(a) * pow10(-v[2])
+		return []float64{a, a + w, a + w*float64(v[3])/1000}
+	},
+))
+
+func TestHegelNarrowTriangleFarFromZero(t *testing.T) {
+	narrowDist(t, casesOf("Triangle", triangleFarFromZero))
+}
+
+// --------------------------------------------------------------------------- gonum/25
+
+// fD1s: D1 in halves to 10, integers to 200 or m 10^e to 9.9e6.
+var fD1s = hegel.OneOf(scaled(ints(1, 20), 0.5), scaled(ints(1, 200), 1), decimals(1, 99, 2, 5))
+
+// fTinyD2s: D2 = m 10^-e in [0.001, 0.09].
+var fTinyD2s = decimals(1, 9, -3, -2)
+
+// fAtRatio renders [D1, D2, r] into [D1, D2, x] with D2/(D1 x) = r.
+func fAtRatio(a []float64) []float64 { return []float64{a[0], a[1], a[1] / (a[0] * a[2])} }
+
+// fCDFNearOne: F{D1, D2 tiny}.CDF(x) with D2/(D1 x) = m 10^-e for e in 13..16 (the
+// incomplete-beta argument D1 x/(D1 x + D2) rounds to within 1e-13 of 1, or to 1, where the
+// CDF of so small a D2 is well below 1; measured: wrong throughout); past the shape, e in
+// 0..2 (exact to 1e-10).
+var fCDFNearOne = on("CDF", hegel.Map(args(tuple(fD1s, fTinyD2s), shaped(decimals(1, 9, -16, -13), decimals(1, 9, -2, 0))), fAtRatio))
+
+func TestHegelFCDFArgumentRoundsToOne(t *testing.T) {
+	narrowDist(t, casesOf("F", fCDFNearOne))
+}
+
+// --------------------------------------------------------------------------- gonum/26..36
+// (the regions the wide property draws through known; their narrow properties are part 3's)
+
+// logNormalNonPositive: LogNormal's densities and cumulatives at 0 or below (gonum/26).
+var logNormalNonPositive = onOne(pick("LogProb", "Prob", "CDF", "Survival"), args(tuple(locations, scales), hegel.OneOf(hegel.Just(0.0), negatives)))
+
+// negativeArguments: the cumulative methods at a negative argument or at -0 (gonum/27).
+func negativeArguments(params hegel.Generator[[]float64]) hegel.Generator[distCall] {
+	return onOne(cumulatives, args(params, hegel.OneOf(negatives, hegel.Just(math.Copysign(0, -1)))))
+}
+
+// The densities at the edge of the support where 0 log 0 occurs (gonum/28): ChiSquared{2}
+// and Chi{1} at 0, F at or below 0, Binomial with P 0 or 1, Poisson{0}.
+var (
+	chiSquaredAtTwo    = onOne(densities, args(tuple(hegel.Just(2.0)), hegel.Just(0.0)))
+	chiAtOne           = onOne(densities, args(tuple(hegel.Just(1.0)), hegel.Just(0.0)))
+	fDensityAtZero     = onOne(densities, args(tuple(shapes, shapes), hegel.OneOf(hegel.Just(0.0), negatives)))
+	binomialDegenerate = onOne(densities, args(tuple(trials, ends), scaled(ints(0, 30), 1)))
+	poissonZero        = onOne(densities, args(tuple(hegel.Just(0.0)), scaled(ints(0, 5), 1)))
+)
+
+// weibullUnitShape: Weibull{1, Lambda}'s densities at 0 (gonum/29).
+var weibullUnitShape = onOne(densities, args(tuple(hegel.Just(1.0), scales), hegel.Just(0.0)))
+
+// The Survival methods computed as 1 - CDF, deep in the upper tail (gonum/30): Normal at
+// Mu + Sigma t for t in [5, 35], Logistic and GumbelRight at t in [10, 600], LogNormal at
+// exp(Mu + Sigma t) for t in [5, 30], Uniform within 10^-e of Max for e in 8..12, Poisson
+// {Lambda <= 10} at 20 to 80, Binomial{N <= 20, P <= 0.1} at N - 1, Triangle within (b - a)
+// 10^-e of b for e in 5..8, F at m 10^e for e in 6..12.
+var (
+	normalSurvivalTail    = on("Survival", hegel.Map(args(tuple(locations, scales), scaled(ints(50, 350), 0.1)), offsetBy))
+	logisticSurvivalTail  = on("Survival", hegel.Map(args(tuple(locations, scales), scaled(ints(10, 600), 1)), offsetBy))
+	gumbelSurvivalTail    = on("Survival", hegel.Map(args(tuple(locations, scales), scaled(ints(10, 600), 1)), offsetBy))
+	logNormalSurvivalTail = on("Survival", hegel.Map(args(tuple(scaled(ints(-1000, 1000), 0.1), scaled(ints(1, 40), 0.25)), scaled(ints(5, 30), 1)), func(a []float64) []float64 {
+		return []float64{a[0], a[1], math.Exp(a[0] + a[1]*a[2])}
+	}))
+	uniformSurvivalTail = on("Survival", hegel.Map(args(uniformParameters, hegel.Map(ints(8, 12), func(e int) float64 { return pow10(-e) })), func(a []float64) []float64 {
+		return []float64{a[0], a[1], a[1] - (a[1]-a[0])*a[2]}
+	}))
+	poissonSurvivalTail  = on("Survival", args(tuple(scaled(ints(1, 40), 0.25)), scaled(ints(20, 80), 1)))
+	binomialSurvivalTail = on("Survival", hegel.Map(tuple(scaled(ints(5, 20), 1), scaled(ints(1, 100), 1e-3)), func(p []float64) []float64 {
+		return []float64{p[0], p[1], p[0] - 1}
+	}))
+	triangleSurvivalTail = on("Survival", hegel.Map(args(triangleParameters, hegel.Map(ints(5, 8), func(e int) float64 { return pow10(-e) })), func(a []float64) []float64 {
+		return []float64{a[0], a[1], a[2], a[1] - (a[1]-a[0])*a[3]}
+	}))
+	fSurvivalTail = on("Survival", args(tuple(shapes, shapes), decimals(1, 9, 6, 12)))
+)
+
+// chiLargeMoments: Chi's moments and entropy for K = m 10^e in [1e5, 9.9e17] (gonum/31).
+var chiLargeMoments = onOne(pick("Mean", "Variance", "StdDev", "Skewness", "ExKurtosis", "Entropy"), tuple(decimals(1, 99, 5, 16)))
+
+// studentsTCenter: StudentsT's cumulatives within m 10^-e Sigma sqrt(Nu) of Mu for e in 6..9,
+// and its Quantile within m 10^-e of 1/2 for e in 4..6 (gonum/32).
+var studentsTCenter = hegel.OneOf(
+	onOne(cumulatives, hegel.Map(args(tuple(locations, scales, shapes), decimals(1, 9, -9, -6)), func(a []float64) []float64 {
+		return []float64{a[0], a[1], a[2], a[0] + a[1]*math.Sqrt(a[2])*a[3]}
+	})),
+	on("Quantile", args(tuple(locations, scales, scaled(ints(10, 200), 1)), hegel.Map(counts(ints(1, 9), ints(4, 6), ints(0, 1)), func(v []int) float64 {
+		return 0.5 + sign(v[2])*float64(v[0])*pow10(-v[1])
+	}))),
+)
+
+// weibullLargeK: Weibull's moments for K = m 10^e in [1e3, 9.9e7] (gonum/33); weibullTinyK:
+// for K = m 10^-e in [1e-5, 9e-3] (gonum/34).
+var (
+	weibullMoments = pick("Variance", "StdDev", "Skewness", "ExKurtosis")
+	weibullLargeK  = onOne(weibullMoments, tuple(decimals(1, 99, 3, 6), scales))
+	weibullTinyK   = onOne(weibullMoments, tuple(decimals(1, 9, -5, -3), scales))
+)
+
+// logNormalSmallSigma: LogNormal's moments for Sigma = m 10^-e in [1e-8, 9e-4] (gonum/35).
+var logNormalSmallSigma = onOne(weibullMoments, tuple(locations, decimals(1, 9, -8, -4)))
+
+// poissonLargeLambda: Poisson's densities for Lambda = m 10^e in [1e6, 9.9e16] at floor(Lambda)
+// plus an integer to 3 either side (gonum/36).
+var poissonLargeLambda = onOne(densities, hegel.Map(args(tuple(decimals(1, 99, 6, 15)), scaled(ints(-3, 3), 1)), func(a []float64) []float64 {
+	return []float64{a[0], math.Floor(a[0]) + a[1]}
+}))
+
+// --------------------------------------------------------------------------- gonum/4, 5, 6, 7, 9
+// (the mathext regions the distributions inherit)
+
+// tinyAnswers: 10^-e for e in 11..15 (gonum/4: the inverse regularized gamma returns 0 where
+// the answer is below 1e-18); the Quantile of Gamma{Alpha in [0.06, 0.6]}, of ChiSquared and
+// Chi{K in [0.12, 1.2]} (K/2 there), and of StudentsT{Nu < 0.1} at any p.
+var (
+	tinyAnswers             = hegel.Map(ints(11, 15), func(e int) float64 { return pow10(-e) })
+	gammaQuantileTiny       = on("Quantile", args(tuple(scaled(ints(6, 60), 0.01), scales), tinyAnswers))
+	chiSquaredQuantileTiny  = on("Quantile", args(tuple(scaled(ints(12, 120), 0.01)), tinyAnswers))
+	chiQuantileTiny         = on("Quantile", args(tuple(scaled(ints(12, 120), 0.01)), tinyAnswers))
+	studentsTQuantileTinyNu = on("Quantile", args(tuple(locations, scales, scaled(ints(1, 99), 1e-3)), probabilities))
+)
+
+// inverseGammaQuantileNearOne: InverseGamma.Quantile within 10^-e of 1 for e in 7..15
+// (gonum/5: the complement's inverse near 1).
+var inverseGammaQuantileNearOne = on("Quantile", args(tuple(shapes, scales), hegel.Map(ints(7, 15), func(e int) float64 { return 1 - pow10(-e) })))
+
+// withinOfTheEnds: 10^-e or 1 - 10^-e for e in 7..15 (gonum/6: the inverse regularized beta
+// within 1e-6 of 0 or 1); the Quantile of Beta, F and StudentsT there.
+var (
+	withinOfTheEnds = hegel.Map(counts(ints(7, 15), ints(0, 1)), func(v []int) float64 {
+		if v[1] == 0 {
+			return pow10(-v[0])
+		}
+		return 1 - pow10(-v[0])
+	})
+	betaQuantileEnds      = on("Quantile", args(tuple(shapes, shapes), withinOfTheEnds))
+	fQuantileEnds         = on("Quantile", args(tuple(shapes, shapes), withinOfTheEnds))
+	studentsTQuantileEnds = on("Quantile", args(tuple(locations, scales, shapes), withinOfTheEnds))
+)
+
+// The regularized incomplete beta with a second parameter below 1 and x within 1e-3 of 1
+// (gonum/7): Beta{Alpha, Beta < 1}.CDF within d 10^-5 of 1, Beta{Alpha < 1, Beta}.Survival at
+// m 10^-e in [1e-9, 9e-4], F{D1, D2 tiny}.CDF with D2/(D1 x) = m 10^-e for e in 4..11.
+var (
+	betaCDFNearOne       = on("CDF", args(tuple(shapes, scaled(ints(1, 999), 1e-3)), hegel.Map(ints(5, 10), func(d int) float64 { return 1 - float64(d)*1e-5 })))
+	betaSurvivalNearZero = on("Survival", args(tuple(scaled(ints(1, 999), 1e-3), shapes), decimals(1, 9, -9, -4)))
+	fCDFTinyD2           = on("CDF", hegel.Map(args(tuple(fD1s, fTinyD2s), decimals(1, 9, -11, -4)), fAtRatio))
+)
+
+// betaEntropies: Beta's entropy, a sum of digammas (gonum/9).
+var betaEntropies = on("Entropy", tuple(shapes, shapes))
+
+// --------------------------------------------------------------------------- by distribution
+// (the shape regions each distribution of the table draws through known)
+
+var (
+	logisticShapes     = hegel.OneOf(logisticLogProbIgnored, logisticFarTails, logisticQuantileChecks, logisticSurvivalTail)
+	normalShapes       = normalSurvivalTail
+	betaShapes         = hegel.OneOf(betaQuantileEnds, betaCDFNearOne, betaSurvivalNearZero, betaEntropies)
+	binomialShapes     = hegel.OneOf(binomialLogProbTinyP, binomialDegenerate, binomialSurvivalTail)
+	chiShapes          = hegel.OneOf(negativeArguments(tuple(chiKs)), chiAtOne, chiLargeMoments, chiQuantileTiny)
+	chiSquaredShapes   = hegel.OneOf(negativeArguments(tuple(shapes)), chiSquaredAtTwo, chiSquaredQuantileTiny)
+	exponentialShapes  = exponentialQuantileTail
+	fShapes            = hegel.OneOf(fCDFNearOne, negativeArguments(tuple(shapes, shapes)), fDensityAtZero, fSurvivalTail, fQuantileEnds, fCDFTinyD2)
+	gammaShapes        = gammaQuantileTiny
+	gumbelShapes       = gumbelSurvivalTail
+	inverseGammaShapes = hegel.OneOf(negativeArguments(tuple(shapes, scales)), inverseGammaQuantileNearOne)
+	laplaceShapes      = laplaceQuantileTail
+	logNormalShapes    = hegel.OneOf(logNormalNonPositive, logNormalSmallSigma, logNormalSurvivalTail)
+	nctShapes          = hegel.OneOf(nctQuantileChecks, nctBracketBound, nctLargeMu, nctDensityLargeNu, nctCDFFarOut, nctTinyNu)
+	poissonShapes      = hegel.OneOf(poissonZero, poissonLargeLambda, poissonSurvivalTail)
+	studentsTShapes    = hegel.OneOf(studentsTCenter, studentsTQuantileTinyNu, studentsTQuantileEnds)
+	triangleShapes     = hegel.OneOf(triangleFarFromZero, triangleSurvivalTail)
+	uniformShapes      = uniformSurvivalTail
+	weibullShapes      = hegel.OneOf(weibullQuantileTail, weibullUnitShape, weibullLargeK, weibullTinyK)
+)
