+def GammaIncReg(a, x):
+    chk(a > 0 and x >= 0)
+    return F(gammainc_reg(a, x))
+
+def GammaIncRegComp(a, x):
+    chk(a > 0 and x >= 0)
+    return F(gammaincc_reg(a, x))
+
+def GammaIncRegInv(a, y):
