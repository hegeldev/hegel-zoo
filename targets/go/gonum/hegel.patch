+
+func TestHegelDistuvOther(t *testing.T) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		if hzChance(ht, 50) {
+			// AlphaStable: only its moments are closed-form.
+			alpha := hzPick(ht, []float64{2, 1, 0.5, 1.5, 1.9, 0.1})
+			beta := hzPick(ht, []float64{0, 0.5, -1, 1})
+			cc := hzGenScale(ht)
+			mu := hzGenLoc(ht)
+			method := hzPick(ht, []string{"Mean", "Median", "Mode", "Variance", "StdDev", "Skewness", "ExKurtosis"})
+			want, err := o.eval("AlphaStable", hzN(alpha), hzN(beta), hzN(cc), hzN(mu), hzS(method))
+			if err != nil {
+				ht.Fatalf("%v", err)
+			}
+			dist := distuv.AlphaStable{Alpha: alpha, Beta: beta, C: cc, Mu: mu}
+			got, pan := hzCall(func() float64 { v, _ := hzDistCall(dist, method, 0); return v })
+			hzJudgeNum(ht, c, "AlphaStable."+method, []float64{alpha, beta, cc, mu}, want, got, pan, 1e-12)
+			return
+		}
+		n := hzDrawInt(ht, 1, 8)
+		w := make([]float64, n)
+		for i := range w {
+			if hzChance(ht, 20) {
+				w[i] = 0
+			} else {
+				w[i] = hzGenScale(ht)
+			}
+		}
+		if allZero(w) {
+			w[0] = 1
+		}
+		method := hzPick(ht, []string{"CDF", "Prob", "LogProb", "Mean", "Entropy"})
+		x := float64(hzDrawInt(ht, -1, n))
+		if hzChance(ht, 20) {
+			x += 0.5
+		}
+		want, err := o.eval("Categorical", hzA(w), hzS(method), hzN(x))
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		dist := distuv.NewCategorical(w, nil)
+		got, pan := hzCall(func() float64 { v, _ := hzDistCall(dist, method, x); return v })
+		hzJudgeNum(ht, c, "Categorical."+method, append(append([]float64{}, w...), x), want, got, pan, 1e-9)
+	})
+}
+
+func allZero(w []float64) bool {
+	for _, v := range w {
+		if v != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelDistuvLaws: a distribution against itself.
+func TestHegelDistuvLaws(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		d := hzPick(ht, hzDists)
+		p := d.params(ht)
+		dist := d.make(p)
+		x := hzGenX(ht, d, p)
+		label := fmt.Sprintf("%s%v", d.name, p)
+		if hzDistAvoid(d.name, "CDF", p, x) || hzDistAvoid(d.name, "Survival", p, x) || hzDistAvoid(d.name, "LogProb", p, x) {
+			return
+		}
+		cdf, ok1 := hzDistCall(dist, "CDF", x)
+		sf, ok2 := hzDistCall(dist, "Survival", x)
+		if ok1 && ok2 && !hzClose(cdf+sf, 1, 1e-10, 1e-10) {
+			c.failClass(ht, d.name+" CDF+Survival", "%s: CDF(%v) + Survival(%v) = %v + %v", label, x, x, cdf, sf)
+			return
+		}
+		pr, ok1 := hzDistCall(dist, "Prob", x)
+		lp, ok2 := hzDistCall(dist, "LogProb", x)
+		if ok1 && ok2 && !hzClose(math.Exp(lp), pr, 1e-12, 0) {
+			c.failClass(ht, d.name+" LogProb", "%s: Prob(%v) = %v, exp(LogProb) = %v", label, x, pr, math.Exp(lp))
+			return
+		}
+		if d.name == "F" && HZKnown.fCDFArgument && x > 0 && p[1]/(p[0]*x) < 1e-8 {
+			hzAvoid("fCDFArgument") // the inverse goes through an argument within 1e-8 of 1
+			return
+		}
+		if !d.ints && ok1 && cdf > 1e-6 && cdf < 1-1e-6 && !hzDistAvoid(d.name, "Quantile", p, cdf) {
+			q, ok := hzDistCall(dist, "Quantile", cdf)
+			if d.name == "NoncentralT" && HZKnown.nctQuantile && math.IsNaN(q) {
+				hzAvoid("nctQuantile")
+				return
+			}
+			scale := math.Abs(x)
+			if sd, has := hzDistCall(dist, "StdDev", 0); has && sd > 0 && !math.IsInf(sd, 0) && !math.IsNaN(sd) {
+				scale += sd
+			} else {
+				// no finite spread (heavy tails): the parameters set the scale
+				scale++
+				for _, v := range p {
+					scale += math.Abs(v)
+				}
+			}
+			if ok && !hzClose(q, x, 1e-6, 1e-8*scale) {
+				// Quantile(CDF(x)) = x wherever the density is positive.
+				if pr > 1e-12 {
+					c.failClass(ht, d.name+" Quantile", "%s: Quantile(CDF(%v) = %v) = %v", label, x, cdf, q)
+					return
+				}
+			}
+		}
+		c.count("ok " + d.name)
+	})
+}
