+	)
+	// invBetaY: InvRegIncBeta's y: probOrBad, but under HEGEL_NO_KNOWN=1 the ends and the
+	// extremes within 1e-6 of them weigh zero (hzInvBetaBad's region, gonum/6: every draw
+	// there would be a skip).
+	invBetaY = weighted(
+		choice[float64]{96, probabilitiesTo(unless(noKnown, 1), shaped(15, 5))},
+		choice[float64]{4, pick(-0.1, 1.1, -1.0, 2.0, math.Inf(1))},
+	)
+	// shapeOrBad: a shape parameter, or one time in twenty-five 0 or a negative value.
+	shapeOrBad = weighted(choice[float64]{96, shapes}, choice[float64]{4, negated(nonNegatives)})
+	// nonNegOrBad: a non-negative number, or one time in twenty-five a negative one.
+	nonNegOrBad = weighted(choice[float64]{96, nonNegatives}, choice[float64]{4, negatives})
+	// dimensions: MvLgamma's dimension, 1 to 12, or one time in twenty-five -2 to 0.
+	dimensions = weighted(
+		choice[float64]{96, scaled(ints(1, 12), 1)},
+		choice[float64]{4, scaled(ints(-2, 0), 1)},
+	)
+
+	// zetaExponents: 1 plus a non-negative number (the region of convergence), or one time in
+	// twelve a value at or below 1 for the panic checks.
+	zetaExponents = weighted(
+		choice[float64]{92, hegel.Map(nonNegatives, func(v float64) float64 { return 1 + v })},
+		choice[float64]{8, pick(1.0, 0.5, 0.0, -1.0, -2.5)},
+	)
+	// zetaOffsets: q non-negative three times in five and negative otherwise (the broad shape
+	// of gonum/13, drawn by default and not under HEGEL_NO_KNOWN=1).
+	zetaOffsets = weighted(
+		choice[float64]{60, nonNegatives},
+		choice[float64]{unless(noKnown, 40), negatives},
+	)
+
+	// amplitudes: within [-pi/2, pi/2], in thousandths of a quarter turn (beyond it is the
+	// shape of gonum/8, ellipticBeyond).
+	amplitudes = scaled(ints(-1000, 1000), math.Pi/2000)
+
+	// The hypergeometric parameters: a and b of moderate size, c positive, z inside the unit
+	// disc away from its edge (the tame region, where the cephes port is accurate); the wild
+	// region - a parameter of 10 or more, a non-positive c, z at or beyond the branch points or
+	// near them - is the broad shape of gonum/1 and gonum/2, drawn by default at its old rate
+	// and not under HEGEL_NO_KNOWN=1.
+	hypTenths = func(nLo, nHi int) hegel.Generator[float64] {
+		return hegel.Map(counts(ints(nLo, nHi), ints(1, 9)), func(v []int) float64 { return float64(v[0]) + float64(v[1])/10 })
+	}
+	hypTame = hegel.OneOf(
+		scaled(ints(-5, 5), 1),
+		scaled(ints(-19, 19), 0.5),
+		scaled(ints(-999, 999), 0.01),
+		hypTenths(-9, 9),
+	)
+	hypTamePositive = hegel.OneOf(
+		scaled(ints(1, 5), 1),
+		scaled(ints(1, 19), 0.5),
+		scaled(ints(1, 999), 0.01),
+		hypTenths(0, 9),
+	)
+	hypTameNonPositive = hegel.OneOf(
+		scaled(ints(-5, 0), 1),
+		scaled(ints(-19, 0), 0.5),
+		scaled(ints(-999, 0), 0.01),
+		hypTenths(-9, -1),
+	)
+	hypWild = weighted(
+		choice[float64]{1, pick(10.0, -10.0)},
+		choice[float64]{9, hegel.Map(counts(ints(10, 30), ints(1, 9), ints(0, 1)), func(v []int) float64 {
+			return float64(2*v[2]-1) * (float64(v[0]) + float64(v[1])/10)
+		})},
+	)
+	hypParameters = weighted(choice[float64]{80, hypTame}, choice[float64]{unless(noKnown, 20), hypWild})
+	hypC          = weighted(
+		choice[float64]{45, hypTamePositive},
+		choice[float64]{unless(noKnown, 45), hypTameNonPositive},
+		choice[float64]{unless(noKnown, 10), hypWild},
+	)
+	hypZTame = weighted(
+		choice[float64]{81, scaled(ints(-899, 989), 1e-3)},
+		choice[float64]{19, pick(0.0, math.Copysign(0, -1), 0.5, -0.5)},
+	)
+	hypZWild = weighted(
+		choice[float64]{13, pick(1.0, -1.0)},
+		choice[float64]{40, hegel.Map(nonNegatives, func(v float64) float64 { return -1 - v })},
+		choice[float64]{40, scaled(ints(900, 1000), -1e-3)},
+		choice[float64]{7, hegel.OneOf(scaled(ints(990, 999), 1e-3), scaled(ints(-999, -900), 1e-3))},
+	)
+	hypZ = weighted(choice[float64]{58, hypZTame}, choice[float64]{unless(noKnown, 42), hypZWild})
+)
+
+// --------------------------------------------------------------------------- the functions
+
+// mathSpec is one real function of mathext: its argument generator, the call and the
+// relative tolerance it is judged at.
+type mathSpec struct {
+	name string
+	args hegel.Generator[[]float64]
+	call func(a []float64) float64
+	rtol float64
+}
+
+// mathSpecs: the 21 functions, each with its plain arguments and, where it has recorded
+// bugs, their shape regions one time in five (known). Digamma comes first: its precision
+// shape (gonum/9) is the simplest deterministic failure, so the shrinker of TestHegelMathext
+// lands there whatever it met first; NormalQuantile second, the most drawn index of a
+// SampledFrom table, has no recorded bug.
+var mathSpecs = []mathSpec{
+	{"Digamma", known(tuple(specialOrNumber), hegel.OneOf(digammaZero, digammaNextToPole)), func(a []float64) float64 { return mathext.Digamma(a[0]) }, 1e-10},
+	{"NormalQuantile", tuple(probOrBad), func(a []float64) float64 { return mathext.NormalQuantile(a[0]) }, 1e-10},
+	{"Beta", tuple(specialOrNumber, specialOrNumber), func(a []float64) float64 { return mathext.Beta(a[0], a[1]) }, 1e-10},
+	{"Lbeta", known(tuple(specialOrNumber, specialOrNumber), lbetaLarge), func(a []float64) float64 { return mathext.Lbeta(a[0], a[1]) }, 1e-10},
+	{"RegIncBeta", known(tuple(shapeOrBad, shapeOrBad, probOrBad), regBetaTinyB), func(a []float64) float64 { return mathext.RegIncBeta(a[0], a[1], a[2]) }, 1e-10},
+	{"InvRegIncBeta", known(tuple(shapeOrBad, shapeOrBad, invBetaY), hegel.OneOf(invBetaNearOne, invBetaChecks)), func(a []float64) float64 { return mathext.InvRegIncBeta(a[0], a[1], a[2]) }, 1e-8},
+	{"GammaIncReg", known(tuple(shapeOrBad, nonNegOrBad), gammaIncRegChecks), func(a []float64) float64 { return mathext.GammaIncReg(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegComp", tuple(shapeOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.GammaIncRegComp(a[0], a[1]) }, 1e-10},
+	{"GammaIncRegInv", known(tuple(shapeOrBad, probOrBad), gammaIncInvTiny), func(a []float64) float64 { return mathext.GammaIncRegInv(a[0], a[1]) }, 1e-9},
+	{"GammaIncRegCompInv", known(tuple(shapeOrBad, probOrBad), gammaIncCompInvNearOne), func(a []float64) float64 { return mathext.GammaIncRegCompInv(a[0], a[1]) }, 1e-9},
+	{"Zeta", known(tuple(zetaExponents, zetaOffsets), hegel.OneOf(zetaHuge, zetaNegativeQ)), func(a []float64) float64 { return mathext.Zeta(a[0], a[1]) }, 1e-10},
+	{"Hypergeo", known(tuple(hypParameters, hypParameters, hypC, hypZ), hegel.OneOf(hypergeoSpecialPoints, hypergeoNearOne)), func(a []float64) float64 { return mathext.Hypergeo(a[0], a[1], a[2], a[3]) }, 1e-9},
+	{"MvLgamma", tuple(numbers, dimensions), func(a []float64) float64 { return mathext.MvLgamma(a[0], int(a[1])) }, 1e-10},
+	{"CompleteK", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteK(a[0]) }, 1e-10},
+	{"CompleteE", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteE(a[0]) }, 1e-10},
+	{"CompleteB", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteB(a[0]) }, 1e-10},
+	{"CompleteD", tuple(probOrBad), func(a []float64) float64 { return mathext.CompleteD(a[0]) }, 1e-10},
+	{"EllipticF", known(tuple(amplitudes, probabilities), ellipticBeyond), func(a []float64) float64 { return mathext.EllipticF(a[0], a[1]) }, 1e-10},
+	{"EllipticE", known(tuple(amplitudes, probabilities), ellipticBeyond), func(a []float64) float64 { return mathext.EllipticE(a[0], a[1]) }, 1e-10},
+	{"EllipticRF", tuple(nonNegOrBad, nonNegOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.EllipticRF(a[0], a[1], a[2]) }, 1e-10},
+	{"EllipticRD", tuple(nonNegOrBad, nonNegOrBad, nonNegOrBad), func(a []float64) float64 { return mathext.EllipticRD(a[0], a[1], a[2]) }, 1e-10},
+}
+
+// mathSpecOf is the spec of the function (for the narrow properties).
+func mathSpecOf(name string) mathSpec {
+	for _, s := range mathSpecs {
+		if s.name == name {
+			return s
+		}
+	}
+	panic("no mathext function " + name)
+}
+
+// mathCase is a function and its argument list.
+type mathCase struct {
+	fn   mathSpec
+	args []float64
+}
+
+func (c mathCase) GoString() string {
+	return c.fn.name + "(" + strings.Join(hzFmts(c.args), ", ") + ")"
+}
+
+// mathCases: a function of the table and arguments of its own generator.
+var mathCases = hegel.FlatMap(hegel.SampledFrom(mathSpecs), func(s mathSpec) hegel.Generator[mathCase] {
+	return hegel.Map(s.args, func(a []float64) mathCase { return mathCase{s, a} })
+})
+
+// --------------------------------------------------------------------------- known shapes
+
+// hzGammaInvTiny estimates the inverse regularized gamma x for (a, y) as (y Gamma(a+1))^(1/a) and
+// reports whether it is below 1e-8 (where the recorded bug gonum/4 bites).
+func hzGammaInvTiny(a, y float64) bool {
+	if a <= 0 || y <= 0 || y >= 1 {
+		return false
+	}
+	lg, _ := math.Lgamma(a + 1)
+	return (math.Log(y)+lg)/a < math.Log(1e-8)
+}
+
+// hzInvBetaBad: the region where InvRegIncBeta is wrong (recorded bug gonum/6).
+func hzInvBetaBad(a, b, y float64) bool {
+	m := math.Min(y, 1-y)
+	return m <= 1e-6 || (math.Max(a, b) > 1e4 && m < 1e-3)
+}
+
+// isInt reports whether x is an integer.
+func isInt(x float64) bool { return x == math.Floor(x) }
+
+// mathShape names the recorded bug (bugs.toml) whose shape the arguments of the function
+// have, and whether that shape is a region the library gets wrong - skipped under
+// HEGEL_NO_KNOWN=1 - or a precision loss modelled as a relaxed tolerance (mathTol), judged
+// at that tolerance under HEGEL_NO_KNOWN=1. By default every case is judged at the strict
+// tolerance and a mismatch names the shape. The predicates are the old HZKnown steering's,
+// kept exactly: they are what HEGEL_NO_KNOWN=1 skips by. (gonum/1 has a second, symptomatic
+// form: hypergeoUndefined.)
+func mathShape(name string, a []float64) (id string, skipped bool) {
+	switch name {
+	case "Beta", "Lbeta":
+		if a[0] > 0 && a[1] > 0 {
+			if a[0] > 1e6 || a[1] > 1e6 {
+				return "gonum/3", true // the lgamma terms cancel entirely
+			}
+			if 1e-15*(1+hzLgammaScale(a...)) > 1e-10 {
+				return "gonum/3", false // their rounding alone exceeds the tolerance
+			}
+		}
+	case "RegIncBeta":
+		if a[1] < 1 && 1-a[2] < 1e-3 && a[2] < 1 {
+			return "gonum/7", true
+		}
+	case "InvRegIncBeta":
+		if (a[2] == 0 || a[2] == 1) && (a[0] <= 0 || a[1] <= 0) {
+			return "gonum/11", true
+		}
+		if hzInvBetaBad(a[0], a[1], a[2]) {
+			return "gonum/6", true
+		}
+		if a[0] > 1e4 || a[1] > 1e4 {
+			return "gonum/6", false
+		}
+	case "GammaIncReg":
+		if a[1] == 0 && a[0] <= 0 {
+			return "gonum/11", true
+		}
+	case "GammaIncRegInv":
+		if hzGammaInvTiny(a[0], a[1]) {
+			return "gonum/4", true
+		}
+	case "GammaIncRegCompInv":
+		if a[1] > 1-1e-6 && a[1] < 1 {
+			return "gonum/5", true
+		}
+		if a[0] > 0 && a[1] < 1 && 1e-15/(a[0]*(1-a[1])) > 1e-9 {
+			return "gonum/5", false
+		}
+	case "Digamma":
+		if a[0] < 0 && math.Abs(a[0]-math.Round(a[0])) < 1e-5*math.Abs(a[0]) {
+			return "gonum/10", true
+		}
+		return "gonum/9", false // accurate to 3e-11 absolute only, everywhere
+	case "Zeta":
+		if a[0] > 1e12 {
+			return "gonum/12", true
+		}
+		if a[1] < 0 {
+			return "gonum/13", true
+		}
+	case "Hypergeo":
+		if a[2] <= 0 && isInt(a[2]) {
+			return "gonum/1", true // the oracle judges the pole only when a or b terminates the series first
+		}
+		if a[2] < 0 || a[3] <= -0.9 || a[3] >= 0.99 || math.Max(math.Abs(a[0]), math.Abs(a[1])) >= 10 {
+			return "gonum/2", true
+		}
+	case "EllipticF", "EllipticE":
+		if math.Abs(a[0]) > math.Pi/2 {
+			return "gonum/8", true
+		}
+	}
+	return "", false
+}
+
+// hypergeoUndefined: the symptom of gonum/1 - Hypergeo is NaN, infinite or panics where
+// 2F1 has a finite value.
+func hypergeoUndefined(got float64, p any, want hzExpect) bool {
+	return (p != nil || math.IsNaN(got) || math.IsInf(got, 0)) && want.t == "n" && !math.IsInf(want.num, 0)
+}
+
+// mathTol returns the relative and absolute tolerances for a function's result: the strict
+// ones by default, and with relaxed (HEGEL_NO_KNOWN=1) the ones the recorded precision
+// bugs were modelled with (gonum/9: Digamma to 1e-10 absolute; gonum/3: Lbeta and Beta to
+// 1e-15 of their lgamma scale; gonum/6: InvRegIncBeta to 1e-6 beyond parameter 1e4; gonum/5:
+// GammaIncRegCompInv to 1e-15/(a(1 - y))). The rest are not bug switches and apply in both
+// modes: the rounding floor of MvLgamma's lgamma terms (and of Lbeta's three, capped at the
+// scale of 1e4), SciPy's accuracy where the oracle falls back to it (parameters beyond 1e4),
+// the conditioning of InvRegIncBeta in a tiny parameter, Zeta's math.Pow and Hypergeo's exact
+// polynomial roots.
+func mathTol(name string, a []float64, rtol float64, relaxed bool) (float64, float64) {
+	switch name {
+	case "Digamma":
+		if relaxed {
+			return rtol, 1e-10
+		}
+	case "MvLgamma":
+		// the log-gamma terms cancel; their rounding is the floor
+		return rtol, 1e-15 * (1 + hzLgammaScale(a...))
+	case "Lbeta":
+		scale := hzLgammaScale(a...)
+		if !relaxed {
+			scale = math.Min(scale, 1e4)
+		}
+		return rtol, 1e-15 * (1 + scale)
+	case "Beta":
+		if relaxed {
+			return rtol + 1e-15*(1+hzLgammaScale(a...)), 0
+		}
+	case "RegIncBeta", "InvRegIncBeta", "GammaIncReg", "GammaIncRegComp", "GammaIncRegInv", "GammaIncRegCompInv":
+		if a[0] > 1e4 || (len(a) > 2 && a[1] > 1e4) {
+			if name == "InvRegIncBeta" {
+				if relaxed {
+					return 1e-6, 0 // InvRegIncBeta(0.002, 291457, 0.337) is 1.2e-7 off
+				}
+				return rtol, 0
+			}
+			return 1e-7, 0
+		}
+		if name == "InvRegIncBeta" && a[0] > 0 && a[1] > 0 {
+			// the inverse is ill-conditioned for a tiny parameter: dx/x = dy/(a y) at small x
+			return math.Max(rtol, 1e-11/math.Min(a[0], a[1])), 0
+		}
+		if name == "GammaIncRegCompInv" && relaxed && a[0] > 0 && a[1] < 1 {
+			// dx/x = d(1-y)/(a (1-y)) at small x, and 1 - y carries the rounding of y
+			return math.Max(rtol, 1e-15/(a[0]*(1-a[1]))), 0
+		}
+	case "Zeta":
+		// q^-x for a huge x goes through repeated squaring in math.Pow, which loses 1e-16 x
+		return rtol + 1e-16*math.Abs(a[0]), 0
+	case "Hypergeo":
+		// the polynomial cases have exact roots: Hypergeo(3, 2, 1, -0.5) = 0
+		return rtol, 1e-20
+	}
+	return rtol, 0
+}
+
+// hzLgammaScale is the largest |lgamma| among the arguments and their sum.
+func hzLgammaScale(a ...float64) float64 {
+	sum, m := 0.0, 0.0
+	for _, v := range a {
+		if v > 0 {
+			lg, _ := math.Lgamma(v)
+			m = math.Max(m, math.Abs(lg))
+			sum += v
+		}
+	}
+	if sum > 0 {
+		lg, _ := math.Lgamma(sum)
+		m = math.Max(m, math.Abs(lg))
+	}
+	return m
+}
+
+// hzHypergeoClass names the region of a hypergeometric argument list, for the collector.
+func hzHypergeoClass(a []float64) string {
+	switch z := a[3]; {
+	case z == 1:
+		return "Hypergeo z=1"
+	case z > 1:
+		return "Hypergeo z>1"
+	case z < -1:
+		return "Hypergeo z<-1"
+	case a[2] <= 0 && isInt(a[2]):
+		return "Hypergeo c nonpositive integer"
+	case z <= -0.9:
+		return "Hypergeo z near -1"
+	}
+	return "Hypergeo |z|<1"
+}
+
+func hzArgsN(a []float64) []hzArg {
+	out := make([]hzArg, len(a))
+	for i, v := range a {
+		out[i] = hzN(v)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the property
+
+func TestHegelMathext(t *testing.T) {
+	o := hzStartOracle(t, hzOracleMathext)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		judgeMath(ht, o, c, hegel.Draw(ht, mathCases))
+	})
+}
+
+// judgeMath asks the oracle about the case, calls the function and judges the result: a
+// case of a recorded bug's shape is judged like any other and fails naming the shape, or
+// under HEGEL_NO_KNOWN=1 is skipped (counted) where the shape is a wrong region and judged
+// at the relaxed tolerance where it is a precision loss. The narrow properties of
+// hegel_zoo_shapes_mathext_test.go judge their regions through it too.
+func judgeMath(ht *hegel.T, o *hzOracle, c *hzCollector, mc mathCase) {
+	name, a := mc.fn.name, mc.args
+	shape, skipped := mathShape(name, a)
+	if shape != "" {
+		c.count("shape " + shape)
+	}
+	if noKnown && skipped {
+		c.count("known " + shape)
+		ht.Assume(false)
+	}
+	args := hzArgsN(a)
+	if name == "MvLgamma" {
+		args[1] = hzI(int(a[1]))
+	}
+	want, err := o.eval(name, args...)
+	if err != nil {
+		ht.Fatalf("%v", err)
+	}
+	got, p := hzCall(func() float64 { return mc.fn.call(a) })
+	if name == "Hypergeo" && hypergeoUndefined(got, p, want) {
+		shape = "gonum/1"
+		c.count("shape gonum/1 (undefined)")
+		if noKnown {
+			c.count("known gonum/1")
+			ht.Assume(false)
+		}
+	}
+	judgeNum(ht, c, name, a, want, got, p, mc.fn.rtol, shape)
+}
+
+// judgeNum compares a numeric result (and panic) with the oracle's verdict, at the strict
+// tolerance by default and at the relaxed one under HEGEL_NO_KNOWN=1; a mismatch names the
+// shape of the recorded bug the case has, if any.
+func judgeNum(ht *hegel.T, c *hzCollector, name string, a []float64, want hzExpect, got float64, p any, rtol float64, shape string) {
+	note := ""
+	if shape != "" {
+		note = " (the shape of " + shape + ")"
+	}
+	switch want.t {
+	case "skip":
+		c.count("skip " + name)
+		return
+	case "panic":
+		if p == nil {
+			c.failClass(ht, classOf(name, a, shape), "%s%v = %v, want a panic%s", name, a, got, note)
+			return
+		}
+		c.count("panic " + name)
+		return
+	}
+	if p != nil {
+		c.failClass(ht, classOf(name, a, shape), "%s%v panicked: %v (want %v)%s", name, a, p, want, note)
+		return
+	}
+	if math.Abs(want.num) < 1e-300 && math.Abs(got) < 1e-300 {
+		c.count("skip denormal " + name) // the libraries flush denormals differently
+		return
+	}
+	rt, at := mathTol(name, a, rtol, noKnown)
+	if !hzClose(got, want.num, rt, at) {
+		c.failClass(ht, classOf(name, a, shape), "%s%v = %v, want %v%s", name, a, got, want, note)
+		return
+	}
+	c.count("ok " + name)
+}
+
+// classOf is the collector's class of a mismatch: the shape it has, else the function (the
+// hypergeometric region for Hypergeo).
+func classOf(name string, a []float64, shape string) string {
+	if shape != "" {
+		return shape
+	}
+	if name == "Hypergeo" {
+		return hzHypergeoClass(a)
+	}
+	return name
+}
+
+// --------------------------------------------------------------------------- complex
+
+// complexParts: a real or imaginary part of moderate magnitude, 0 first.
+var (
+	complexParts = hegel.OneOf(
+		hegel.Just(0.0),
+		scaled(ints(-20, 20), 0.25),
+		scaled(ints(-2000, 2000), 1e-3),
+		scaled(ints(-30, 30), 1),
+	)
+	complexArguments = hegel.Composite(func(tc hegel.TestCase) complex128 {
+		return complex(hegel.Draw(tc, complexParts), hegel.Draw(tc, complexParts))
+	})
+	complexFns = []string{"Li2", "AiryAi", "AiryAiDeriv"}
+)
+
+// complexCase is a complex function and its argument.
+type complexCase struct {
+	name string
+	z    complex128
+}
+
+func (c complexCase) GoString() string { return c.name + "(" + fmt.Sprint(c.z) + ")" }
+
+var complexCases = hegel.Composite(func(tc hegel.TestCase) complexCase {
+	return complexCase{name: hegel.Draw(tc, hegel.SampledFrom(complexFns)), z: hegel.Draw(tc, complexArguments)}
+})
+
+func TestHegelMathextComplex(t *testing.T) {
+	o := hzStartOracle(t, hzOracleMathext)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, complexCases)
+		name, z := cc.name, cc.z
+		want, err := o.eval(name, hzN(real(z)), hzN(imag(z)))
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		var got complex128
+		p := hzCatch(func() {
+			switch name {
+			case "Li2":
+				got = mathext.Li2(z)
+			case "AiryAi":
+				got = mathext.AiryAi(z)
+			default:
+				got = mathext.AiryAiDeriv(z)
+			}
+		})
+		if p != nil {
+			c.failClass(ht, name+" panic", "%s(%v) panicked: %v", name, z, p)
+			return
+		}
+		if want.t == "skip" || cmplx.IsNaN(complex(want.num, want.im)) || cmplx.IsInf(complex(want.num, want.im)) {
+			c.count("skip " + name)
+			return
+		}
+		rt, at := mathTol(name, []float64{real(z), imag(z)}, 1e-9, noKnown)
+		scale := cmplx.Abs(complex(want.num, want.im))
+		if !hzClose(real(got), want.num, rt, at+rt*scale) || !hzClose(imag(got), want.im, rt, at+rt*scale) {
+			c.failClass(ht, name, "%s(%v) = %v, want %v", name, z, got, want)
+			return
+		}
+		c.count("ok " + name)
+	})
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..591ecf1
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,283 @@
+package hegel
+
+// The Python oracle: a python3 subprocess speaking JSON lines, evaluating the functions with
+// SciPy and NumPy and the documented special cases. Floats travel as strings (Go's shortest
+// round-trip formatting, Python's repr) so that every double survives the trip exactly.
+//
+// A request is {"name": FUNCTION, "args": [ARG...]} with ARG one of {"n": "1.5"}, {"i": 3},
+// {"b": true} or {"a": ["1", "2"]} (a slice). The reply is {"ok": {"t": "n", "v": "1.5"}},
+// {"t": "c", "v": ["re", "im"]} (a complex number), {"t": "a", "v": ["1", "2"]} (a slice),
+// {"t": "panic"} (the documented panic is expected) or {"t": "skip"} (not judged);
+// {"error": ...} is a fault of the oracle itself.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+const hzOracleHead = `
+import sys, json, math, warnings
+import numpy as np
+from scipy import stats as st
+from scipy import special as sp
+import mpmath as mp
+warnings.simplefilter("ignore")
+mp.mp.dps = 30
+
+def F(v):
+    # an mpmath value as a float (mpmath keeps huge exponents; float() overflows to inf)
+    try:
+        return float(v)
+    except OverflowError:
+        return math.copysign(inf, v)
+
+nan, inf = float("nan"), float("inf")
+
+class Panic(Exception):
+    pass
+
+class Skip(Exception):
+    pass
+
+def panic():
+    raise Panic()
+
+def skip():
+    raise Skip()
+
+def chk(cond):
+    if not cond:
+        raise Panic()
+
+def isint(x):
+    return math.isfinite(x) and x == math.floor(x)
+`
+
+const hzOracleMain = `
+def decode(a):
+    if "n" in a:
+        return float(a["n"])
+    if "i" in a:
+        return int(a["i"])
+    if "b" in a:
+        return bool(a["b"])
+    if "s" in a:
+        return a["s"]
+    return [float(v) for v in a["a"]]
+
+def encode(v):
+    if isinstance(v, complex):
+        return {"t": "c", "v": [repr(float(v.real)), repr(float(v.imag))]}
+    if isinstance(v, (list, tuple, np.ndarray)):
+        return {"t": "a", "v": [repr(float(x)) for x in v]}
+    return {"t": "n", "v": repr(float(v))}
+
+for line in sys.stdin:
+    try:
+        req = json.loads(line)
+        fn = globals()[req["name"].replace(".", "_")]
+        args = [decode(a) for a in req["args"]]
+        try:
+            res = encode(fn(*args))
+        except Panic:
+            res = {"t": "panic"}
+        except Skip:
+            res = {"t": "skip"}
+        sys.stdout.write(json.dumps({"ok": res}) + "\n")
+    except Exception as e:  # noqa
+        sys.stdout.write(json.dumps({"error": repr(e)}) + "\n")
+    sys.stdout.flush()
+`
+
+type hzOracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T, parts ...string) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	src := hzOracleHead
+	for _, p := range parts {
+		src += p
+	}
+	src += hzOracleMain
+	if err := os.WriteFile(script, []byte(src), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<22)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+// hzArg is one argument: a number, an integer, a boolean, a string or a slice.
+type hzArg struct {
+	kind byte // 'n', 'i', 'b', 's', 'a'
+	num  float64
+	i    int
+	b    bool
+	s    string
+	arr  []float64
+}
+
+func hzN(v float64) hzArg   { return hzArg{kind: 'n', num: v} }
+func hzI(v int) hzArg       { return hzArg{kind: 'i', i: v} }
+func hzB(v bool) hzArg      { return hzArg{kind: 'b', b: v} }
+func hzS(v string) hzArg    { return hzArg{kind: 's', s: v} }
+func hzA(v []float64) hzArg { return hzArg{kind: 'a', arr: v} }
+
+func (a hzArg) json() map[string]any {
+	switch a.kind {
+	case 'n':
+		return map[string]any{"n": hzFmt(a.num)}
+	case 'i':
+		return map[string]any{"i": a.i}
+	case 'b':
+		return map[string]any{"b": a.b}
+	case 's':
+		return map[string]any{"s": a.s}
+	}
+	return map[string]any{"a": hzFmts(a.arr)}
+}
+
+func (a hzArg) String() string {
+	switch a.kind {
+	case 'n':
+		return hzFmt(a.num)
+	case 'i':
+		return strconv.Itoa(a.i)
+	case 'b':
+		return fmt.Sprint(a.b)
+	case 's':
+		return a.s
+	}
+	return hzShow(a.arr)
+}
+
+// hzExpect is the oracle's verdict: a number, a complex number, a slice, a panic or skip.
+type hzExpect struct {
+	t   string // "n", "c", "a", "panic", "skip"
+	num float64
+	im  float64
+	arr []float64
+}
+
+func (e hzExpect) String() string {
+	switch e.t {
+	case "n":
+		return hzFmt(e.num)
+	case "c":
+		return fmt.Sprintf("(%s%+si)", hzFmt(e.num), hzFmt(e.im))
+	case "a":
+		return hzShow(e.arr)
+	case "panic":
+		return "a panic"
+	}
+	return "skip"
+}
+
+func (o *hzOracle) eval(name string, args ...hzArg) (hzExpect, error) {
+	js := make([]map[string]any, len(args))
+	for i, a := range args {
+		js[i] = a.json()
+	}
+	b, err := json.Marshal(map[string]any{"name": name, "args": js})
+	if err != nil {
+		return hzExpect{}, err
+	}
+	o.in.Write(b)
+	o.in.WriteByte('\n')
+	if err := o.in.Flush(); err != nil {
+		return hzExpect{}, err
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		return hzExpect{}, fmt.Errorf("oracle: %v", err)
+	}
+	var r struct {
+		OK *struct {
+			T string          `json:"t"`
+			V json.RawMessage `json:"v"`
+		} `json:"ok"`
+		Error string `json:"error"`
+	}
+	if err := json.Unmarshal(line, &r); err != nil {
+		return hzExpect{}, fmt.Errorf("oracle reply %q: %v", line, err)
+	}
+	if r.Error != "" || r.OK == nil {
+		return hzExpect{}, fmt.Errorf("oracle %s(%v): %s", name, args, r.Error)
+	}
+	e := hzExpect{t: r.OK.T}
+	switch e.t {
+	case "n":
+		var s string
+		if err := json.Unmarshal(r.OK.V, &s); err != nil {
+			return e, err
+		}
+		e.num = hzParse(s)
+	case "c", "a":
+		var ss []string
+		if err := json.Unmarshal(r.OK.V, &ss); err != nil {
+			return e, err
+		}
+		for _, s := range ss {
+			e.arr = append(e.arr, hzParse(s))
+		}
+		if e.t == "c" {
+			e.num, e.im = e.arr[0], e.arr[1]
+		}
+	}
+	return e, nil
+}
+
+// hzParse reads Python's repr of a float (and Go's own formatting).
+func hzParse(s string) float64 {
+	switch s {
+	case "nan", "NaN":
+		return math.NaN()
+	case "inf", "+Inf":
+		return math.Inf(1)
+	case "-inf", "-Inf":
+		return math.Inf(-1)
+	}
+	v, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		panic(fmt.Sprintf("oracle float %q: %v", s, err))
+	}
+	return v
+}
+
+func hzFmt(v float64) string { return strconv.FormatFloat(v, 'g', -1, 64) }
+
+func hzFmts(xs []float64) []string {
+	out := make([]string, len(xs))
+	for i, v := range xs {
+		out[i] = hzFmt(v)
+	}
+	return out
+}
