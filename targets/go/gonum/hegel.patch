+def Digamma(x):
+    if math.isnan(x):
+        return nan
+    if x == 0:
+        return -inf if math.copysign(1, x) > 0 else inf
+    if x == -inf:
+        return nan
+    if x == inf:
+        return inf
+    if x < 0 and isint(x):
