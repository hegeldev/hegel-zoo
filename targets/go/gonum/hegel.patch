+func TestHegelDistuv(t *testing.T) {
+	o := hzStartOracle(t, hzOracleDistuv)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		d := hzPick(ht, hzDists)
+		p := d.params(ht)
+		dist := d.make(p)
+		var method string
+		for {
+			method = hzPick(ht, hzDistMethods)
+			if _, ok := hzDistCall(dist, method, 0.5); ok {
+				break
+			}
+		}
+		x := hzGenX(ht, d, p)
+		if method == "Quantile" {
+			x = hzGenProbOrBad(ht)
+		}
+		if hzDistAvoid(d.name, method, p, x) {
+			return
+		}
+		want, err := o.eval("Dist", hzS(d.name), hzA(p), hzS(method), hzN(x))
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		got, pan := hzCall(func() float64 { v, _ := hzDistCall(dist, method, x); return v })
+		label := fmt.Sprintf("%s%v.%s", d.name, p, method)
+		class := d.name + "." + method
+		switch want.t {
+		case "skip":
+			c.count("skip " + class)
+			return
+		case "panic":
+			if pan == nil {
+				c.failClass(ht, class+" no panic", "%s(%v) = %v, want a panic", label, x, got)
+				return
+			}
+			c.count("panic " + class)
+			return
+		}
+		if pan != nil {
+			c.failClass(ht, class+" panic", "%s(%v) panicked: %v (want %v)", label, x, pan, want)
+			return
+		}
+		if hzSurvivalTail(d.name, method, want.num) {
+			hzAvoid("survivalComplement")
+			return
+		}
+		if d.name == "Triangle" && method == "CDF" && HZKnown.triangleCancellation && want.num < 1e-6 {
+			hzAvoid("triangleCancellation")
+			return
+		}
+		if hzNctTail(d.name, method, want.num) {
+			hzAvoid("nctTails")
+			return
+		}
+		if d.name == "NoncentralT" && method == "Quantile" && HZKnown.nctQuantile && (math.IsNaN(got) || math.Abs(want.num) >= 1<<24) && !math.IsNaN(want.num) {
+			hzAvoid("nctQuantile")
+			return
+		}
+		if d.name == "NoncentralT" && method == "Quantile" && HZKnown.nctLargeX && want.num*want.num > 1e9*p[0] {
+			hzAvoid("nctLargeX") // the root is found on the CDF, imprecise out there
+			return
+		}
+		if d.name == "F" && method == "Quantile" && HZKnown.fCDFArgument && want.num > 0 && p[1]/(p[0]*want.num) < 1e-8 {
+			hzAvoid("fCDFArgument") // the inverse goes through an argument within 1e-8 of 1
+			return
+		}
+		if math.Abs(want.num) < 1e-280 && math.Abs(got) < 1e-280 {
+			c.count("skip denormal " + class) // an intermediate underflowed on one side or the other
+			return
+		}
+		if method == "LogProb" && want.num < -708 {
+			c.count("skip denormal " + class) // the density is denormal or underflows on one side or the other
+			return
+		}
+		atol := 0.0
+		if method == "LogProb" {
+			atol = 1e-13 // a log near 0 carries the rounding of a probability near 1
+		}
+		if method == "Entropy" {
+			atol = 1e-12 // an entropy near 0 is a cancellation of terms of order 1
+			if HZKnown.digammaPrecision {
+				// the entropies are sums of digammas, each 3e-11 off: Beta{7, 7}.Entropy() is 6e-10 off
+				atol = 1e-10 * (1 + hzMaxAbs(p))
+			}
+		}
+		if method == "Quantile" {
+			if got == 0 && want.num > 0 && want.num < 1e-280 {
+				c.count("skip denormal " + class) // an intermediate underflowed
+				return
+			}
+			atol = 1e-13 * (1 + hzMaxAbs(p)) // a root at 0 comes out as rounding noise
+		}
+		if !hzClose(got, want.num, hzDistTol(d.name, method, p, x), atol) {
+			c.failClass(ht, class, "%s(%v) = %v, want %v", label, x, got, want)
+			return
+		}
+		c.count("ok " + class)
+	})
