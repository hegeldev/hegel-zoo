+// hzDistAvoid keeps the generated cases away from the recorded bugs (HZKnown).
+func hzDistAvoid(name, method string, p []float64, x float64) bool {
+	density := method == "Prob" || method == "LogProb"
+	cumulative := method == "CDF" || method == "Survival"
+	switch name {
+	case "Logistic":
+		if HZKnown.logisticLogProb && method == "LogProb" {
+			hzAvoid("logisticLogProb")
+			return true
+		}
+		if HZKnown.quantileChecks && method == "Quantile" && !(x >= 0 && x <= 1) {
+			hzAvoid("quantileChecks")
+			return true
+		}
+		if HZKnown.logisticProbOverflow && method == "Prob" && math.Abs(x-p[0])/p[1] > 354 {
+			hzAvoid("logisticProbOverflow")
+			return true
+		}
+	case "NoncentralT":
+		if HZKnown.quantileChecks && method == "Quantile" && !(x > 0 && x < 1) {
+			hzAvoid("quantileChecks")
+			return true
+		}
+		if HZKnown.nctLargeMu && math.Abs(p[1]) > 38 && (density || cumulative || method == "Quantile") {
+			hzAvoid("nctLargeMu")
+			return true
+		}
+		if HZKnown.nctTails && density && (p[0] > 3000 || math.Abs(x) < 1e-8*p[0]) {
+			hzAvoid("nctTails")
+			return true
+		}
+		if HZKnown.nctTails && method == "Quantile" && x > 0 && x < 1 && (math.Min(x, 1-x) < 1e-4 || p[0] > 3000) {
+			hzAvoid("nctTails") // the quantile is found on the CDF, wrong in the tails and for a large Nu
+			return true
+		}
+		if HZKnown.nctTails && cumulative && p[0] > 3000 {
+			hzAvoid("nctTails") // the CDF is accurate to about 1e-11 absolute only
+			return true
+		}
+		if HZKnown.nctSmallNu && p[0] < 1e-3 && (cumulative || density || method == "Quantile") {
+			hzAvoid("nctSmallNu")
+			return true
+		}
+		if HZKnown.nctLargeX && cumulative && x*x > 1e9*p[0] {
+			hzAvoid("nctLargeX")
+			return true
+		}
+	case "Exponential":
+		if HZKnown.quantileLogOneMinusP && method == "Quantile" && x >= 0 && x < 1e-6 {
+			hzAvoid("quantileLogOneMinusP")
+			return true
+		}
+	case "Beta":
+		if HZKnown.invRegIncBetaLarge && method == "Quantile" && x >= 0 && x <= 1 && hzInvBetaBad(p[0], p[1], x) {
+			hzAvoid("invRegIncBetaLarge")
+			return true
+		}
+		if HZKnown.regIncBetaTinyB && ((method == "CDF" && p[1] < 1 && 1-x < 1e-3 && x < 1) || (method == "Survival" && p[0] < 1 && x < 1e-3 && x > 0)) {
+			hzAvoid("regIncBetaTinyB")
+			return true
+		}
+	case "LogNormal":
+		if HZKnown.logNormalNonPositive && (density || cumulative) && x <= 0 {
+			hzAvoid("logNormalNonPositive")
+			return true
+		}
+		if HZKnown.logNormalMomentsSmallSigma {
+			limit := map[string]float64{"Variance": 1e-3, "StdDev": 1e-3, "Skewness": 1e-3, "ExKurtosis": 0.05}[method]
+			if limit > 0 && p[1] < limit {
+				hzAvoid("logNormalMomentsSmallSigma")
+				return true
+			}
+		}
+	case "ChiSquared", "F", "InverseGamma", "Chi":
+		if HZKnown.negativeSupport && cumulative && (x < 0 || (x == 0 && math.Signbit(x))) {
+			hzAvoid("negativeSupport")
+			return true
+		}
+		if name == "InverseGamma" && HZKnown.gammaIncCompInvNearOne && method == "Quantile" && x > 1-1e-6 && x < 1 {
+			hzAvoid("gammaIncCompInvNearOne") // the quantile inverts the complement near 1
+			return true
+		}
+		if name == "F" && HZKnown.regIncBetaTinyB && cumulative && x > 0 && p[1] < 2 && p[1]/(p[0]*x) < 1e-3 {
+			hzAvoid("regIncBetaTinyB")
+			return true
+		}
+		if name == "F" && HZKnown.regIncBetaTinyB && method == "Survival" && x > 0 && p[0] < 2 && p[0]*x/(p[0]*x+p[1]) < 1e-3 {
+			hzAvoid("regIncBetaTinyB") // the survival is RegIncBeta(d2/2, d1/2, d2/(d1 x + d2))
+			return true
+		}
+		if name == "F" && HZKnown.invRegIncBetaLarge && method == "Quantile" && x > 0 && x < 1 && hzInvBetaBad(p[0]/2, p[1]/2, x) {
+			hzAvoid("invRegIncBetaLarge") // the quantile is InvRegIncBeta(d1/2, d2/2, p)
+			return true
+		}
+		if name == "F" && HZKnown.fCDFArgument && cumulative && x > 0 && p[1]/(p[0]*x) < 1e-12 {
+			hzAvoid("fCDFArgument")
+			return true
+		}
+	case "StudentsT":
+		if HZKnown.studentsTCenter && cumulative && x != p[0] && math.Abs(x-p[0]) < 1e-5*p[1]*math.Sqrt(p[2]) {
+			hzAvoid("studentsTCenter")
+			return true
+		}
+		if HZKnown.studentsTCenter && method == "Quantile" && x > 0 && x < 1 && p[2] > 1e6*math.Pow(2.5*(x-0.5), 2) {
+			hzAvoid("studentsTCenter") // z is at least 2.5 |p - 0.5| for the standard t
+			return true
+		}
+		if HZKnown.gammaIncInvUnderflow && method == "Quantile" && p[2] < 0.1 {
+			hzAvoid("gammaIncInvUnderflow")
+			return true
+		}
+		if HZKnown.invRegIncBetaLarge && method == "Quantile" && x > 0 && x < 1 && hzInvBetaBad(p[2]/2, 0.5, 2*math.Min(x, 1-x)) {
+			hzAvoid("invRegIncBetaLarge") // the tail quantile is InvRegIncBeta(Nu/2, 1/2, 2 min(p, 1-p))
+			return true
+		}
+	case "Laplace":
+		if HZKnown.quantileLogOneMinusP && method == "Quantile" && (x < 1e-5 || x > 1-1e-5) && x >= 0 && x <= 1 {
+			hzAvoid("quantileLogOneMinusP")
+			return true
+		}
+	case "Bernoulli", "Binomial":
+		pp := p[len(p)-1]
+		if HZKnown.logOneMinusP && (method == "LogProb" || method == "Entropy") && pp > 0 && pp < 1e-6 {
+			hzAvoid("logOneMinusP")
+			return true
+		}
+	case "Triangle":
+		if HZKnown.triangleCancellation && (method == "Variance" || method == "StdDev" || method == "Skewness") && math.Abs(p[0]) > 300*(p[1]-p[0]) {
+			hzAvoid("triangleCancellation")
+			return true
+		}
+	case "Gamma", "ChiSquared2":
+	}
+	if HZKnown.gammaIncInvUnderflow && method == "Quantile" {
+		switch name {
+		case "Gamma":
+			if hzGammaInvTiny(p[0], x) {
+				hzAvoid("gammaIncInvUnderflow")
+				return true
+			}
+		case "Chi", "ChiSquared":
+			if hzGammaInvTiny(p[0]/2, x) {
+				hzAvoid("gammaIncInvUnderflow")
+				return true
+			}
+		}
+	}
+	if HZKnown.zeroLogZero && density {
+		switch {
+		case name == "ChiSquared" && p[0] == 2 && x == 0,
+			name == "Chi" && p[0] == 1 && x == 0,
+			name == "F" && x <= 0,
+			name == "Binomial" && (p[1] == 0 || p[1] == 1),
+			name == "Poisson" && p[0] == 0:
+			hzAvoid("zeroLogZero")
+			return true
+		}
+	}
+	if HZKnown.poissonLargeLambda && name == "Poisson" && density && p[0] > 1e5 {
+		hzAvoid("poissonLargeLambda")
+		return true
+	}
+	if HZKnown.weibullUnitShape && name == "Weibull" && density && p[0] == 1 && x == 0 {
+		hzAvoid("weibullUnitShape")
+		return true
+	}
+	if name == "Weibull" {
+		if HZKnown.quantileLogOneMinusP && method == "Quantile" && x >= 0 && x < 1e-6 {
+			hzAvoid("quantileLogOneMinusP")
+			return true
+		}
+		if HZKnown.weibullMomentsLargeK {
+			limit := map[string]float64{"Variance": 200, "StdDev": 200, "Skewness": 50, "ExKurtosis": 20}[method]
+			if limit > 0 && p[0] > limit {
+				hzAvoid("weibullMomentsLargeK")
+				return true
+			}
+		}
+		if HZKnown.weibullMomentOverflow {
+			order := map[string]float64{"Variance": 2, "StdDev": 2, "Skewness": 3, "ExKurtosis": 4}[method]
+			if order > 0 && order/p[0] > 170 {
+				hzAvoid("weibullMomentOverflow")
+				return true
+			}
+		}
+	}
+	if HZKnown.chiMomentsLarge && name == "Chi" {
+		limit := map[string]float64{"Mean": 1e5, "Variance": 300, "StdDev": 300, "Skewness": 30, "ExKurtosis": 5, "Entropy": 1e5}[method]
+		if limit > 0 && p[0] > limit {
+			hzAvoid("chiMomentsLarge")
+			return true
+		}
+	}
+	return false
+}
+
+// hzDistTol returns the relative tolerance for a distribution method's result.
+func hzDistTol(name, method string, p []float64, x float64) float64 {
+	shape := 0.0
+	switch name {
+	case "Chi", "ChiSquared", "F", "Gamma", "InverseGamma", "Beta", "Weibull", "Pareto":
+		shape = math.Max(p[0], p[1%len(p)])
+	case "StudentsT":
+		shape = p[2]
+	case "NoncentralT":
+		shape = p[0]
+	}
+	switch {
+	case name == "NoncentralT" && (method == "Variance" || method == "StdDev"):
+		// the variance is a cancellation of terms in Mu^2 with a gamma ratio taken through lgamma
+		nu, mu := p[0], p[1]
+		lg, _ := math.Lgamma(nu / 2)
+		return 1e-7 + 3e-15*math.Abs(lg)*mu*mu/(1+3.5*mu*mu/nu)
+	case name == "NoncentralT":
+		return 1e-7
+	case shape > 1e4:
+		return 1e-7
+	case method == "Quantile":
+		return 1e-8
+	}
+	return 1e-9
+}
+
+// hzSurvivalTail: the Survival methods computed as 1 - CDF (recorded bug survivalComplement)
+// are not judged where the survival is below 1e-6.
+func hzSurvivalTail(name, method string, want float64) bool {
+	if !HZKnown.survivalComplement || method != "Survival" {
+		return false
+	}
+	switch name {
+	case "Normal", "LogNormal", "GumbelRight", "Logistic", "Poisson", "Binomial", "Triangle", "Uniform", "F":
+		return want < 1e-4
+	}
+	return false
+}
+
+// hzNctTail: NoncentralT densities below 1e-6 are not judged (recorded bug nctTails).
+func hzNctTail(name, method string, want float64) bool {
+	if !HZKnown.nctTails || name != "NoncentralT" {
+		return false
+	}
+	switch method {
+	case "Prob":
+		return want < 1e-3
+	case "LogProb":
+		return want < math.Log(1e-3)
+	case "CDF":
+		return want < 1e-6
+	}
+	return false
+}
