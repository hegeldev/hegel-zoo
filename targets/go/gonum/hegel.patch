+		scaled(ints(0, 999), 1e-3),
+	)
+}
+
+// ellipticBeyond: EllipticF and EllipticE at an amplitude beyond pi/2 in magnitude by 1 to
+// 3500 thousandths of a half-turn (measured: wrong at every probed point); past the shape,
+// within [-pi/2, pi/2] (pi/2 less 0 to 1000 thousandths).
+var ellipticBeyond = shaped(ellipticArguments(1, 3500), ellipticArguments(-1000, 0))
