+package hegel
+
+// TestHegelDistuv: the univariate distributions of gonum.org/v1/gonum/stat/distuv agree with
+// SciPy (scipy.stats), with mpmath for the moments that cancel, and with their documented
+// special cases; TestHegelDistuvLaws checks a distribution against itself (Survival against
+// CDF, Prob against LogProb, Quantile against CDF).
+
+import (
+	"fmt"
+	"math"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"gonum.org/v1/gonum/stat/distuv"
+)
+
+const hzOracleDistuv = `
+def nanif(cond, v):
+    return nan if cond else v
+
+def D_Bernoulli(P):
+    d = st.bernoulli(P)
+    # SciPy's kurtosis is 1e-4 off for P = 1 - 1e-12 and its variance 1e-9 off for P = 1 - 1e-8;
+    # the textbook formulas in doubles
+    ex = {
+        "Variance": P * (1 - P), "StdDev": math.sqrt(P * (1 - P)),
+        "Median": 0.0 if P < 0.5 else 1.0 if P > 0.5 else 0.5,
+        "Skewness": (1 - 2 * P) / math.sqrt(P * (1 - P)) if 0 < P < 1 else skip,
+        "ExKurtosis": (1 - 6 * P * (1 - P)) / (P * (1 - P)) if 0 < P < 1 else skip,
+        "Quantile": lambda p: (chk(0 <= p <= 1), 0.0 if p <= 1 - P else 1.0)[1],
+    }
+    if P in (0, 1):
+        ex["Skewness"] = skip
+        ex["ExKurtosis"] = skip
+    return d, True, ex
+
+def D_Beta(a, b):
+    d = st.beta(a, b)
+    if a <= 1:
+        mode = nan if b <= 1 else 0.0
+    elif b <= 1:
+        mode = 1.0
+    else:
+        mode = (a - 1) / (a + b - 2)
+    return d, False, {"Mode": mode}
+
+def D_Binomial(N, P):
+    d = st.binom(int(N), P)
+    # SciPy's variance is 8e-9 off for P = 0.999999999; the textbook value in doubles
+    ex = {"Variance": N * P * (1 - P), "StdDev": math.sqrt(N * P * (1 - P))}
+    if N > 0 and 0 < P < 1:
+        ex["Skewness"] = (1 - 2 * P) / math.sqrt(N * P * (1 - P))
+        ex["ExKurtosis"] = (1 - 6 * P * (1 - P)) / (N * P * (1 - P))
+    if N == 0 or P in (0, 1):
+        ex["Skewness"] = skip
+        ex["ExKurtosis"] = skip
+    return d, True, ex
+
+def chi_moments(K):
+    with mp.workdps(90):  # the variance K - mean^2 cancels to 1/2 for K up to 1e16
+        K = mp.mpf(K)
+        mean = mp.sqrt(2) * mp.exp(mp.loggamma((K + 1) / 2) - mp.loggamma(K / 2))
+        var = K - mean ** 2
+        sd = mp.sqrt(var)
+        skew = mean / sd ** 3 * (1 - 2 * var)
+        kurt = 2 / var * (1 - mean * sd * skew - var)
+        return {"Mean": F(mean), "Variance": F(var), "StdDev": F(sd), "Skewness": F(skew), "ExKurtosis": F(kurt)}
+
+def D_Chi(K):
+    ex = chi_moments(K)
+    ex["Mode"] = nan if K < 1 else math.sqrt(K - 1)
+    return st.chi(K), False, ex
+
+def D_ChiSquared(K):
+    return st.chi2(K), False, {"Mode": max(K - 2, 0.0)}
+
+def D_Exponential(rate):
+    return st.expon(scale=1 / rate), False, {"Mode": 0.0}
+
+def D_F(d1, d2):
+    d = st.f(d1, d2)
+    return d, False, {
+        "Mean": nan if d2 <= 2 else d2 / (d2 - 2),
+        "Mode": nan if d1 <= 2 else (d1 - 2) / d1 * d2 / (d2 + 2),
+        "Skewness": nan if d2 <= 6 else float(d.stats(moments="s")),
+        "Variance": nan if d2 <= 4 else float(d.var()),
+        "StdDev": nan if d2 <= 4 else float(d.std()),
+        "ExKurtosis": nan if d2 <= 8 else float(d.stats(moments="k")),
+    }
+
+def D_Gamma(a, b):
+    return st.gamma(a, scale=1 / b), False, {"Mode": 0.0 if a < 1 else (a - 1) / b}
+
+def D_GumbelRight(mu, beta):
+    return st.gumbel_r(loc=mu, scale=beta), False, {"Mode": mu}
+
+def D_InverseGamma(a, b):
+    d = st.invgamma(a, scale=b)
+    return d, False, {
+        "Mode": b / (a + 1),
+        "Mean": inf if a <= 1 else b / (a - 1),
+        "Variance": inf if a <= 2 else float(d.var()),
+        "StdDev": inf if a <= 2 else float(d.std()),
+        "ExKurtosis": inf if a <= 4 else float(d.stats(moments="k")),
+    }
+
+def D_Laplace(mu, scale):
+    return st.laplace(loc=mu, scale=scale), False, {"Mode": mu}
+
+def D_Logistic(mu, s):
+    return st.logistic(loc=mu, scale=s), False, {"Mode": mu}
+
+def D_LogNormal(mu, sigma):
+    if abs(mu) > 300:
+        skip()  # SciPy's scale exp(mu) overflows or underflows
+    ex = {"Mode": math.exp(mu - sigma * sigma)}
+    if sigma > 20:
+        for m in ("Mean", "Variance", "StdDev", "Skewness", "ExKurtosis", "Mode"):
+            ex[m] = skip  # the moments overflow
+    return st.lognorm(sigma, scale=math.exp(mu)), False, ex
+
+def ncdf(a):
+    return mp.mpf(1) if a > 40 else mp.mpf(0) if a < -40 else mp.ncdf(a)
+
+def npdf(a):
+    return mp.mpf(0) if abs(a) > 40 else mp.npdf(a)
+
+def nct_quad(f, nu, mu, x):
+    # the integral of f(v) against the chi-squared(nu) density, with breakpoints at its bulk and
+    # where x sqrt(v/nu) = mu (checked against the central t and SciPy: NoncentralT oracle)
+    nu, mu, x = mp.mpf(nu), mp.mpf(mu), mp.mpf(x)
+    vx = nu * (mu / x) ** 2 if mu != 0 and x != 0 else None
+    if nu < 1:
+        # u = v^(nu/2): the density of u is (2/nu) exp(-u^(2/nu)/2) / (2^(nu/2) Gamma(nu/2)), smooth at 0
+        c = 2 / nu / (2 ** (nu / 2) * mp.gamma(nu / 2))
+        pts = {mp.mpf(k) for k in (0.25, 0.5, 1, 1.5, 2, 3)}
+        if vx is not None:
+            ux = vx ** (nu / 2)
+            pts |= {ux / 4, ux / 2, ux, 2 * ux, 4 * ux}
+        pts = [0] + sorted(u for u in pts if u < 10) + [10, mp.inf]
+        return mp.quad(lambda u: f(u ** (2 / nu)) * c * mp.exp(-u ** (2 / nu) / 2), pts)
+    # s = log v: the density is exp((nu/2) s - e^s/2) / (2^(nu/2) Gamma(nu/2))
+    lc = -(nu / 2) * mp.log(2) - mp.loggamma(nu / 2)
+    pts = {mp.log(nu) + k for k in (-150, -80, -40, -20, -10, -5, -2, -1, 0, 1, 2)}
+    s = mp.sqrt(2 * nu)
+    pts |= {mp.log(nu + k * s) for k in (-8, -4, -2, -1, 1, 2, 4, 8) if nu + k * s > 0}
+    if vx is not None:
+        pts |= {mp.log(vx) + k for k in (-3, -1, 0, 1, 3)}
+    hi = mp.log(nu + 8 * s) + 2
+    pts = sorted(q for q in pts if q < hi) + [hi]
+    return mp.quad(lambda q: f(mp.exp(q)) * mp.exp((nu / 2) * q - mp.exp(q) / 2 + lc), pts)
+
+def nct_cdf(x, nu, mu):
+    # P(T <= x) for T = (Z + mu) / sqrt(V / nu): the normal CDF averaged over V
+    if x == inf:
+        return 1.0
+    if x == -inf:
+        return 0.0
+    return F(nct_quad(lambda v: ncdf(mp.mpf(x) * mp.sqrt(v / nu) - mu), nu, mu, x))
+
+def nct_pdf(x, nu, mu):
+    if math.isinf(x):
+        return 0.0
+    return nct_quad(lambda v: mp.sqrt(v / nu) * npdf(mp.mpf(x) * mp.sqrt(v / nu) - mu), nu, mu, x)
+
+def D_NoncentralT(nu, mu):
+    if abs(mu) > 1e6 or (abs(mu) > 37 and nu < 1e-3):
+        skip()  # the quadrature below is slow for a tiny nu
+    d = st.nct(nu, mu)
+    ex = {
+        "Mean": nan if nu <= 1 else float(d.mean()),
+        "Variance": nan if nu <= 2 else float(d.var()),
+        "Quantile": lambda p: (chk(0 <= p <= 1), -inf if p == 0 else inf if p == 1 else float(d.ppf(p)))[1],
+    }
+    if abs(mu) > 37:
+        # SciPy's series is only valid to |mu| = 37.6 (nct(171, 236).logpdf(127) = -11.8, want -194.6)
+        ex["CDF"] = lambda x: nct_cdf(x, nu, mu)
+        ex["Prob"] = lambda x: F(nct_pdf(x, nu, mu))
+        ex["LogProb"] = lambda x: F(mp.log(nct_pdf(x, nu, mu))) if nct_pdf(x, nu, mu) > 0 else -inf
+        ex["Quantile"] = skip
+    else:
+        # SciPy's CDF and density are NaN (or raise) in the far tails: nct(171, 20).cdf(-2),
+        # nct(172, 3.19).pdf(-29), nct(1000, -3).pdf(3)
+        def sp_or(f, alt):
+            try:
+                v = float(f())
+            except (OverflowError, FloatingPointError, ValueError):
+                return alt()
+            return alt() if math.isnan(v) else v
+        slow = nu < 1e-3  # the quadrature is slow for a tiny nu: not judged where SciPy fails
+        ex["CDF"] = lambda x: sp_or(lambda: d.cdf(x), lambda: skip() if slow else nct_cdf(x, nu, mu))
+        ex["Prob"] = lambda x: sp_or(lambda: d.pdf(x), lambda: skip() if slow else F(nct_pdf(x, nu, mu)))
+        ex["LogProb"] = lambda x: sp_or(lambda: d.logpdf(x), lambda: skip() if slow else F(mp.log(nct_pdf(x, nu, mu))))
+    return d, False, ex
+
+def D_Normal(mu, sigma):
+    return st.norm(mu, sigma), False, {"Mode": mu}
+
+def D_Pareto(xm, a):
+    d = st.pareto(a, scale=xm)
+    ma = mp.mpf(a)
+    return d, False, {
+        "Mode": xm,
+        "Median": F(mp.mpf(xm) * mp.mpf(2) ** (1 / mp.mpf(a))),  # SciPy overflows 2^(1/a) for a < 1/1024
+        "Quantile": lambda p: (chk(0 <= p <= 1), inf if p == 1 else F(mp.mpf(xm) * (1 - mp.mpf(p)) ** (-1 / mp.mpf(a))))[1],
+        "Mean": inf if a <= 1 else a * xm / (a - 1),
+        "Variance": inf if a <= 2 else float(d.var()),
+        "StdDev": inf if a <= 2 else float(d.std()),
+        # the textbook forms in mpmath: SciPy loses digits next to the poles (Alpha = 4 + 2e-9)
+        "Skewness": nan if a <= 3 else F(2 * (1 + ma) / (ma - 3) * mp.sqrt((ma - 2) / ma)),
+        "ExKurtosis": nan if a <= 4 else F(6 * (ma ** 3 + ma ** 2 - 6 * ma - 2) / (ma * (ma - 3) * (ma - 4))),
+    }
+
+def D_Poisson(lam):
+    d = st.poisson(lam)
+    ex = {}
+    if lam > 1e4:
+        # SciPy's pmf is x log(lam) - lam - lgamma(x + 1) in doubles, which cancels like gonum's
+        def logpmf(x):
+            if x < 0 or x != math.floor(x):
+                return -inf
+            return F(mp.mpf(x) * mp.log(mp.mpf(lam)) - mp.mpf(lam) - mp.loggamma(mp.mpf(x) + 1))
+        ex = {"LogProb": logpmf, "Prob": lambda x: math.exp(logpmf(x))}
+    return d, True, ex
+
+def D_StudentsT(mu, sigma, nu):
+    d = st.t(nu, loc=mu, scale=sigma)
+    return d, False, {
+        "Mean": mu,
+        "Mode": mu,
+        "Variance": nan if nu <= 1 else inf if nu <= 2 else float(d.var()),
+        "StdDev": nan if nu <= 1 else inf if nu <= 2 else float(d.std()),
+    }
+
+def D_Triangle(a, b, c):
+    d = st.triang((c - a) / (b - a), loc=a, scale=b - a)
+    ma, mb, mc = mp.mpf(a), mp.mpf(b), mp.mpf(c)
+    q = ma * ma + mb * mb + mc * mc - ma * mb - ma * mc - mb * mc
+    var = q / 18
+    skew = mp.sqrt(2) * (ma + mb - 2 * mc) * (2 * ma - mb - mc) * (ma - 2 * mb + mc) / (5 * q ** mp.mpf(1.5))
+    return d, False, {"Mode": c, "Variance": F(var), "StdDev": F(mp.sqrt(var)), "Skewness": F(skew)}
+
+def D_Uniform(lo, hi):
+    return st.uniform(loc=lo, scale=hi - lo), False, {}
+
+def D_Weibull(k, lam):
+    d = st.weibull_min(k, scale=lam)
+    mk, ml = mp.mpf(k), mp.mpf(lam)
+    def logpdf(x):
+        # SciPy's pdf is NaN where (x/lam)^k overflows: weibull_min(511, scale=4).pdf(46)
+        if x < 0:
+            return -inf
+        if x == 0:
+            return inf if k < 1 else F(mp.log(mk / ml)) if k == 1 else -inf
+        z = mp.mpf(x) / ml
+        return F(mp.log(mk / ml) + (mk - 1) * mp.log(z) - z ** mk)
+    g = lambda i: mp.gamma(1 + i / mk)
+    mean = ml * g(1)
+    var = ml ** 2 * (g(2) - g(1) ** 2)
+    sd = mp.sqrt(var)
+    skew = (g(3) * ml ** 3 - 3 * mean * var - mean ** 3) / sd ** 3
+    kurt = (-6 * g(1) ** 4 + 12 * g(1) ** 2 * g(2) - 3 * g(2) ** 2 - 4 * g(1) * g(3) + g(4)) / (g(2) - g(1) ** 2) ** 2
+    ex = {"Mode": 0.0 if k <= 1 else lam * ((k - 1) / k) ** (1 / k),
+          "Mean": F(mean), "Variance": F(var), "StdDev": F(sd), "Skewness": F(skew), "ExKurtosis": F(kurt),
+          "LogProb": logpdf, "Prob": lambda x: math.exp(logpdf(x))}
+    return d, False, ex
+
+def Dist(name, params, method, x):
+    d, discrete, extra = globals()["D_" + name](*params)
+    if method in extra:
+        v = extra[method]
+        if v is skip:
+            skip()
+        return v(x) if callable(v) else v
+    if method == "CDF":
+        return d.cdf(x)
+    if method == "Survival":
+        return d.sf(x)
+    if method == "Prob":
+        return d.pmf(x) if discrete else d.pdf(x)
+    if method == "LogProb":
+        return d.logpmf(x) if discrete else d.logpdf(x)
+    if method == "LogSurvival":
+        return d.logsf(x)
+    if method == "Quantile":
+        chk(0 <= x <= 1)
+        if discrete and x == 0:
+            skip()
+        return d.ppf(x)
+    if method == "Mean":
+        return d.mean()
+    if method == "Median":
+        return d.median()
+    if method == "Variance":
+        return d.var()
+    if method == "StdDev":
+        return d.std()
+    if method == "Skewness":
+        return d.stats(moments="s")
+    if method == "ExKurtosis":
+        return d.stats(moments="k")
+    if method == "Entropy":
+        return d.entropy()
+    raise Exception("method " + method)
+
+def AlphaStable(alpha, beta, c, mu, method):
+    if method == "Mean":
+        return mu if alpha > 1 else nan
+    if method in ("Median", "Mode"):
+        chk(beta == 0)
+        return mu
+    if method == "Variance":
+        return 2 * c * c if alpha == 2 else inf
+    if method == "StdDev":
+        return math.sqrt(2) * c if alpha == 2 else inf
+    if method in ("Skewness", "ExKurtosis"):
+        return 0.0 if alpha == 2 else nan
+    raise Exception("method " + method)
+
+def Categorical(w, method, x):
+    total = sum(w)
+    if method == "CDF":
+        return sum(v for i, v in enumerate(w) if i <= x) / total
+    if method == "Prob":
+        if not isint(x) or x < 0 or x >= len(w):
+            return 0.0
+        return w[int(x)] / total
+    if method == "LogProb":
+        return math.log(Categorical(w, "Prob", x)) if Categorical(w, "Prob", x) > 0 else -inf
+    if method == "Mean":
+        return sum(i * v for i, v in enumerate(w)) / total
+    if method == "Entropy":
+        e = -sum(v / total * math.log(v / total) for v in w if v != 0)
+        if e < 1e-6:
+            skip()  # the sum cancels
+        return e
+    raise Exception("method " + method)
+`
+
+// The methods of a distribution, by interface.
+type (
+	hzCDFer         interface{ CDF(float64) float64 }
+	hzSurvivaler    interface{ Survival(float64) float64 }
+	hzProber        interface{ Prob(float64) float64 }
+	hzLogProber     interface{ LogProb(float64) float64 }
+	hzLogSurvivaler interface{ LogSurvival(float64) float64 }
+	hzQuantiler     interface{ Quantile(float64) float64 }
+	hzMeaner        interface{ Mean() float64 }
+	hzMedianer      interface{ Median() float64 }
+	hzModer         interface{ Mode() float64 }
+	hzVariancer     interface{ Variance() float64 }
+	hzStdDever      interface{ StdDev() float64 }
+	hzSkewnesser    interface{ Skewness() float64 }
+	hzExKurtosiser  interface{ ExKurtosis() float64 }
+	hzEntropyer     interface{ Entropy() float64 }
+)
+
+var hzDistMethods = []string{"CDF", "Survival", "Prob", "LogProb", "LogSurvival", "Quantile", "Mean", "Median",
+	"Mode", "Variance", "StdDev", "Skewness", "ExKurtosis", "Entropy"}
+
+// hzDistCall invokes a method by name; ok is false when the distribution lacks it.
+func hzDistCall(d any, method string, x float64) (v float64, ok bool) {
+	switch method {
+	case "CDF":
+		if m, has := d.(hzCDFer); has {
+			return m.CDF(x), true
+		}
+	case "Survival":
+		if m, has := d.(hzSurvivaler); has {
+			return m.Survival(x), true
+		}
+	case "Prob":
+		if m, has := d.(hzProber); has {
+			return m.Prob(x), true
+		}
+	case "LogProb":
+		if m, has := d.(hzLogProber); has {
+			return m.LogProb(x), true
+		}
+	case "LogSurvival":
+		if m, has := d.(hzLogSurvivaler); has {
+			return m.LogSurvival(x), true
+		}
+	case "Quantile":
+		if m, has := d.(hzQuantiler); has {
+			return m.Quantile(x), true
+		}
+	case "Mean":
+		if m, has := d.(hzMeaner); has {
+			return m.Mean(), true
+		}
+	case "Median":
+		if m, has := d.(hzMedianer); has {
+			return m.Median(), true
+		}
+	case "Mode":
+		if m, has := d.(hzModer); has {
+			return m.Mode(), true
+		}
+	case "Variance":
+		if m, has := d.(hzVariancer); has {
+			return m.Variance(), true
+		}
+	case "StdDev":
+		if m, has := d.(hzStdDever); has {
+			return m.StdDev(), true
+		}
+	case "Skewness":
+		if m, has := d.(hzSkewnesser); has {
+			return m.Skewness(), true
+		}
+	case "ExKurtosis":
+		if m, has := d.(hzExKurtosiser); has {
+			return m.ExKurtosis(), true
+		}
+	case "Entropy":
+		if m, has := d.(hzEntropyer); has {
+			return m.Entropy(), true
+		}
+	}
+	return 0, false
+}
+
+// hzDistSpec: a distribution, its parameter generator, constructor and the points of its
+// support worth probing.
+type hzDistSpec struct {
+	name   string
+	params func(tc hegel.TestCase) []float64
+	make   func(p []float64) any
+	points func(p []float64) []float64
+	ints   bool // a discrete distribution on the integers
+}
+
+// hzGenLoc draws a location parameter.
+func hzGenLoc(tc hegel.TestCase) float64 {
+	if hzChance(tc, 30) {
+		return 0
+	}
+	return hzGenNum(tc, true)
+}
+
+// hzGenLocModerate draws a location parameter of moderate size (for the bounded supports,
+// whose width must not be absorbed by the location).
+func hzGenLocModerate(tc hegel.TestCase) float64 {
+	switch hzDrawInt(tc, 0, 3) {
+	case 0:
+		return 0
+	case 1:
+		return float64(hzDrawInt(tc, -10, 10))
+	case 2:
+		return float64(hzDrawInt(tc, -100000, 100000)) / 100
+	default:
+		return float64(hzDrawInt(tc, -1000, 1000)) * 1000
+	}
+}
