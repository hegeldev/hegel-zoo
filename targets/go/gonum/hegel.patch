+def EllipticRD(x, y, z):
+    lower, upper = (5 / 2.0 ** 1022) ** (1 / 3), (2.0 ** 1022 / 5) ** (1 / 3)
+    if not (0 <= x <= upper and 0 <= y <= upper and lower <= z <= upper and x + y >= lower):
