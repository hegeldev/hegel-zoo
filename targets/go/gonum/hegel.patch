+        if t == 0:
+            return inf
+        s += mp.loggamma(t)
+    return F(s)
+
+def CompleteK(m):
+    if not 0 <= m <= 1:
+        return nan
+    if m == 1:
+        return inf
+    return F(mp.ellipk(m))
+
+def CompleteE(m):
+    if not 0 <= m <= 1:
+        return nan
+    return F(mp.ellipe(m))
+
+def CompleteD(m):
+    if not 0 <= m <= 1:
+        return nan
+    if m == 1:
+        return inf
+    return F(mp.elliprd(0, 1 - mp.mpf(m), 1) / 3)
+
+def CompleteB(m):
+    if not 0 <= m <= 1:
+        return nan
+    if m == 1:
+        return 1.0
+    return F(mp.ellipk(m) - mp.elliprd(0, 1 - mp.mpf(m), 1) / 3)
