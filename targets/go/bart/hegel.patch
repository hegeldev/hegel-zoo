+var kinds = []string{"Table", "Fast", "Lite"}
+
+func newTab(kind string) rtab {
+	switch kind {
+	case "Table":
+		mk := func() *bart.Table[int] { return new(bart.Table[int]) }
+		return &wrap[*bart.Table[int]]{mk(), kind, mk}
+	case "Fast":
+		mk := func() *bart.Fast[int] { return new(bart.Fast[int]) }
+		return &wrap[*bart.Fast[int]]{mk(), kind, mk}
+	}
+	return &liteW{new(bart.Lite)}
+}
