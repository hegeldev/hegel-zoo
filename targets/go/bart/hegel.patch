+// tableAPI is what Table[int] and Fast[int] share, with the self type T.
+type tableAPI[T any] interface {
+	Insert(netip.Prefix, int)
+	Delete(netip.Prefix)
+	Get(netip.Prefix) (int, bool)
+	Lookup(netip.Addr) (int, bool)
+	Contains(netip.Addr) bool
+	LookupPrefix(netip.Prefix) (int, bool)
+	LookupPrefixLPM(netip.Prefix) (netip.Prefix, int, bool)
+	Modify(netip.Prefix, func(int, bool) (int, bool))
+	Supernets(netip.Prefix) iter.Seq2[netip.Prefix, int]
+	Subnets(netip.Prefix) iter.Seq2[netip.Prefix, int]
+	OverlapsPrefix(netip.Prefix) bool
+	Overlaps(T) bool
+	Overlaps4(T) bool
+	Overlaps6(T) bool
+	Union(T)
+	Equal(T) bool
+	Clone() T
+	InsertPersist(netip.Prefix, int) T
+	DeletePersist(netip.Prefix) T
+	ModifyPersist(netip.Prefix, func(int, bool) (int, bool)) T
+	UnionPersist(T) T
+	Size() int
+	Size4() int
+	Size6() int
+	All() iter.Seq2[netip.Prefix, int]
+	All4() iter.Seq2[netip.Prefix, int]
+	All6() iter.Seq2[netip.Prefix, int]
+	AllSorted() iter.Seq2[netip.Prefix, int]
+	AllSorted4() iter.Seq2[netip.Prefix, int]
+	AllSorted6() iter.Seq2[netip.Prefix, int]
+	DumpList4() []bart.DumpListNode[int]
+	DumpList6() []bart.DumpListNode[int]
+	MarshalJSON() ([]byte, error)
+	MarshalText() ([]byte, error)
+	Fprint(w io.Writer) error
+}
+
+type wrap[T tableAPI[T]] struct {
+	t    T
+	kind string
+	mk   func() T
+}
+
+func collect(seq iter.Seq2[netip.Prefix, int]) []pv {
+	var out []pv
+	for p, v := range seq {
+		out = append(out, pv{p, v})
+	}
+	return out
+}
+
+func (w *wrap[T]) name() string                            { return w.kind }
+func (w *wrap[T]) hasValues() bool                         { return true }
+func (w *wrap[T]) Insert(p netip.Prefix, v int)            { w.t.Insert(p, v) }
+func (w *wrap[T]) Delete(p netip.Prefix)                   { w.t.Delete(p) }
