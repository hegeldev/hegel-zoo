+// --------------------------------------------------------------------------- checks
+
+// check compares a table with its model: sizes, sorted and unsorted enumerations, the dump
+// trees, and a few queries related to the table's prefixes.
+func check(ht *hegel.T, col *collector, t rtab, md *model, what string) {
+	vals := t.hasValues()
+	if t.Size() != md.size(nil) || t.Size4() != md.size(ptr(true)) || t.Size6() != md.size(ptr(false)) {
+		col.failClass(ht, "Size", "%s: Size %d/%d/%d, want %d/%d/%d", what, t.Size(), t.Size4(), t.Size6(), md.size(nil), md.size(ptr(true)), md.size(ptr(false)))
+	}
+	for _, f := range []struct {
+		name string
+		got  []pv
+		want []netip.Prefix
+	}{
+		{"AllSorted", t.AllSorted(), md.sorted(nil)},
+		{"AllSorted4", t.AllSorted4(), md.sorted(ptr(true))},
+		{"AllSorted6", t.AllSorted6(), md.sorted(ptr(false))},
+	} {
+		if !samePV(f.got, f.want, md, vals) {
+			col.failClass(ht, f.name, "%s: %s %v, want %v", what, f.name, f.got, withVals(f.want, md))
+		}
+	}
+	for _, f := range []struct {
+		name string
+		got  []pv
+		want []netip.Prefix
+	}{
+		{"All", t.All(), md.sorted(nil)},
+		{"All4", t.All4(), md.sorted(ptr(true))},
+		{"All6", t.All6(), md.sorted(ptr(false))},
+	} {
+		got := append([]pv(nil), f.got...)
+		sortPV(got)
+		if !samePV(got, f.want, md, vals) {
+			col.failClass(ht, f.name, "%s: %s (sorted) %v, want %v", what, f.name, got, withVals(f.want, md))
+		}
+	}
+	if got, want := t.Dump4(), md.dumpTree(true); !sameTree(got, want, vals) {
+		col.failClass(ht, "DumpList4", "%s: DumpList4 %s, want %s", what, fmtTree(got), fmtTree(want))
+	}
+	if got, want := t.Dump6(), md.dumpTree(false); !sameTree(got, want, vals) {
+		col.failClass(ht, "DumpList6", "%s: DumpList6 %s, want %s", what, fmtTree(got), fmtTree(want))
+	}
+	// queries
+	for i := 0; i < 4; i++ {
+		q := genQuery(ht, md)
+		gv, gok := t.Get(q)
+		wv, wok := md.get(q)
+		if gok != wok || (vals && gok && gv != wv) {
+			col.failClass(ht, "Get", "%s: Get(%v) = %d, %v; want %d, %v", what, q, gv, gok, wv, wok)
+		}
+		gv, gok = t.LookupPrefix(q)
+		wp, wv, wok := md.lookupPrefix(q)
+		if gok != wok || (vals && gok && gv != wv) {
+			col.failClass(ht, "LookupPrefix", "%s: LookupPrefix(%v) = %d, %v; want %d, %v (%v)", what, q, gv, gok, wv, wok, wp)
+		}
+		gp, gv, gok := t.LookupPrefixLPM(q)
+		if gok != wok || (gok && gp != wp) || (vals && gok && gv != wv) {
+			col.failClass(ht, "LookupPrefixLPM", "%s: LookupPrefixLPM(%v) = %v, %d, %v; want %v, %d, %v", what, q, gp, gv, gok, wp, wv, wok)
+		}
+		if got, want := t.Supernets(q), md.supernets(q); !samePV(got, want, md, vals) {
+			col.failClass(ht, "Supernets", "%s: Supernets(%v) %v, want %v", what, q, got, withVals(want, md))
+		}
+		if got, want := t.Subnets(q), md.subnets(q); !samePV(got, want, md, vals) {
+			col.failClass(ht, "Subnets", "%s: Subnets(%v) %v, want %v", what, q, got, withVals(want, md))
+		}
+		if got, want := t.OverlapsPrefix(q), md.overlapsPrefix(q); got != want {
+			col.failClass(ht, "OverlapsPrefix", "%s: OverlapsPrefix(%v) = %v, want %v", what, q, got, want)
+		}
+		ip := genAddr(ht, md)
+		gv, gok = t.Lookup(ip)
+		wp, wv, wok = md.lookup(ip)
+		if gok != wok || (vals && gok && gv != wv) {
+			col.failClass(ht, "Lookup", "%s: Lookup(%v) = %d, %v; want %d, %v (%v)", what, ip, gv, gok, wv, wok, wp)
+		}
+		if got := t.Contains(ip); got != wok {
+			col.failClass(ht, "Contains", "%s: Contains(%v) = %v, want %v", what, ip, got, wok)
+		}
+		if ip.Is6() && chance(ht, 50) {
+			z := ip.WithZone("eth0")
+			zv, zok := t.Lookup(z)
+			if zok != wok || (vals && zok && zv != wv) || t.Contains(z) != wok {
+				col.failClass(ht, "Zone", "%s: Lookup(%v) = %d, %v, Contains %v; want %d, %v", what, z, zv, zok, t.Contains(z), wv, wok)
+			}
+		}
+	}
+}
+
+func ptr(b bool) *bool { return &b }
+
+func withVals(ps []netip.Prefix, md *model) []pv {
+	out := make([]pv, len(ps))
+	for i, p := range ps {
+		out[i] = pv{p, md.m[p]}
+	}
+	return out
+}
+
+func samePV(got []pv, want []netip.Prefix, md *model, vals bool) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range got {
+		if got[i].p != want[i] || (vals && got[i].v != md.m[want[i]]) {
+			return false
+		}
+	}
+	return true
+}
+
+func sortPV(xs []pv) {
+	for i := 1; i < len(xs); i++ {
+		for j := i; j > 0 && cmpPrefix(xs[j].p, xs[j-1].p) < 0; j-- {
+			xs[j], xs[j-1] = xs[j-1], xs[j]
+		}
+	}
+}
+
+func sameTree(a, b []treeNode, vals bool) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].pfx != b[i].pfx || (vals && a[i].val != b[i].val) || !sameTree(a[i].subs, b[i].subs, vals) {
+			return false
+		}
+	}
+	return true
+}
+
+// build fills a fresh table and model with n random prefixes.
+func build(ht *hegel.T, kind string, n int) (rtab, *model) {
+	t, md := newTab(kind), newModel()
+	for i := 0; i < n; i++ {
+		p, v := genPrefix(ht), genVal(ht)
+		t.Insert(p, v)
+		md.insert(p, v)
+	}
+	return t, md
+}
+
+var invalidPrefixes = []netip.Prefix{{}, netip.PrefixFrom(netip.MustParseAddr("10.0.0.0"), 33), netip.PrefixFrom(netip.MustParseAddr("::1"), 129), netip.PrefixFrom(netip.Addr{}, 8), netip.PrefixFrom(netip.MustParseAddr("1.2.3.4"), -1)}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelTable: Table, Fast and Lite under random sequences of Insert, Delete, Modify
+// (with the documented callback contract), the Persist variants (receiver unchanged, result
+// as modelled), Union, Clone independence and invalid inputs, compared with the model after
+// every step: sizes, All/AllSorted per family, DumpList trees, and queries (Get, Lookup,
+// Contains, LookupPrefix, LookupPrefixLPM, Supernets, Subnets, OverlapsPrefix, zones).
+func TestHegelTable(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, kinds)
+		tab, md := build(ht, kind, drawInt(ht, 0, 12))
+		var trace []string
+		where := func() string { return fmt.Sprintf("%s after %v", kind, trace) }
+		check(ht, col, tab, md, where())
+		nops := drawInt(ht, 0, 25)
+		for i := 0; i < nops; i++ {
+			switch drawInt(ht, 0, 9) {
+			case 0, 1, 2:
+				p, v := genQuery(ht, md), genVal(ht)
+				trace = append(trace, fmt.Sprintf("Insert(%v, %d)", p, v))
+				tab.Insert(p, v)
+				md.insert(p, v)
+			case 3:
+				p := genQuery(ht, md)
+				trace = append(trace, fmt.Sprintf("Delete(%v)", p))
+				tab.Delete(p)
+				md.delete(p)
+			case 4:
+				// Modify: the callback sees the current state and decides
+				p := genQuery(ht, md)
+				del := chance(ht, 40)
+				nv := genVal(ht)
+				calls := 0
+				wv, wok := md.get(p)
+				trace = append(trace, fmt.Sprintf("Modify(%v, del %v, val %d)", p, del, nv))
+				tab.Modify(p, func(cur int, ok bool) (int, bool) {
+					calls++
+					if ok != wok || (tab.hasValues() && ok && cur != wv) {
+						col.failClass(ht, "ModifyCallback", "%s: Modify callback got (%d, %v), want (%d, %v)", where(), cur, ok, wv, wok)
+					}
+					return nv, del
+				})
+				if calls != 1 && p.IsValid() {
+					col.failClass(ht, "ModifyCalls", "%s: Modify callback called %d times", where(), calls)
+				}
+				if del {
+					md.delete(p)
+				} else {
+					md.insert(p, nv)
+				}
+			case 5:
+				// Persist variants: the receiver keeps its state, the result is the modelled one
+				p, v := genQuery(ht, md), genVal(ht)
+				before := tab.Clone()
+				md2 := md.clone()
+				var res rtab
+				switch drawInt(ht, 0, 2) {
+				case 0:
+					trace = append(trace, fmt.Sprintf("InsertPersist(%v, %d)", p, v))
+					res = tab.InsertPersist(p, v)
+					md2.insert(p, v)
+				case 1:
+					trace = append(trace, fmt.Sprintf("DeletePersist(%v)", p))
+					res = tab.DeletePersist(p)
+					md2.delete(p)
+				default:
+					del := chance(ht, 40)
+					trace = append(trace, fmt.Sprintf("ModifyPersist(%v, del %v, val %d)", p, del, v))
+					res = tab.ModifyPersist(p, func(int, bool) (int, bool) { return v, del })
+					if del {
+						md2.delete(p)
+					} else {
+						md2.insert(p, v)
+					}
+				}
+				if !tab.Equal(before) {
+					col.failClass(ht, "PersistReceiver", "%s: the receiver changed", where())
+				}
+				check(ht, col, tab, md, where()+" (receiver)")
+				check(ht, col, res, md2, where()+" (result)")
+				// continue with the result half of the time
+				if chance(ht, 50) {
+					tab, md = res, md2
+					trace = append(trace, "-> result")
+				}
+			case 6:
+				// Union with a fresh random table
+				o, mo := build(ht, kind, drawInt(ht, 0, 6))
+				oBefore := o.Clone()
+				if chance(ht, 50) {
+					trace = append(trace, fmt.Sprintf("Union(%v)", o.AllSorted()))
+					tab.Union(o)
+					md.union(mo)
+				} else {
+					trace = append(trace, fmt.Sprintf("UnionPersist(%v)", o.AllSorted()))
+					before := tab.Clone()
+					res := tab.UnionPersist(o)
+					if !tab.Equal(before) {
+						col.failClass(ht, "UnionPersistReceiver", "%s: the receiver changed", where())
+					}
+					md2 := md.clone()
+					md2.union(mo)
+					check(ht, col, res, md2, where()+" (result)")
+					tab, md = res, md2
+				}
+				if !o.Equal(oBefore) {
+					col.failClass(ht, "UnionArgument", "%s: the argument changed", where())
+				}
+			case 7:
+				// Clone independence
+				c := tab.Clone()
+				if !c.Equal(tab) || !tab.Equal(c) {
+					col.failClass(ht, "CloneEqual", "%s: Clone not Equal", where())
+				}
+				p, v := genQuery(ht, md), genVal(ht)
+				trace = append(trace, fmt.Sprintf("Clone().Insert(%v, %d)", p, v))
+				c.Insert(p, v)
+				c.Delete(genQuery(ht, md))
+				check(ht, col, tab, md, where()+" (original after mutating the clone)")
+			case 8:
+				// invalid inputs are no-ops or negative answers
+				p := pick(ht, invalidPrefixes)
+				trace = append(trace, fmt.Sprintf("invalid %v", p))
+				tab.Insert(p, 1)
+				tab.Delete(p)
+				tab.Modify(p, func(int, bool) (int, bool) { return 1, false })
+				if _, ok := tab.Get(p); ok {
+					col.failClass(ht, "InvalidGet", "%s: Get(%v) ok", where(), p)
+				}
+				if _, ok := tab.LookupPrefix(p); ok {
+					col.failClass(ht, "InvalidLookupPrefix", "%s: LookupPrefix(%v) ok", where(), p)
+				}
+				if _, _, ok := tab.LookupPrefixLPM(p); ok {
+					col.failClass(ht, "InvalidLookupPrefixLPM", "%s: LookupPrefixLPM(%v) ok", where(), p)
+				}
+				if s := tab.Supernets(p); len(s) != 0 {
+					col.failClass(ht, "InvalidSupernets", "%s: Supernets(%v) = %v", where(), p, s)
+				}
+				if s := tab.Subnets(p); len(s) != 0 {
+					col.failClass(ht, "InvalidSubnets", "%s: Subnets(%v) = %v", where(), p, s)
+				}
+				if tab.OverlapsPrefix(p) {
+					col.failClass(ht, "InvalidOverlaps", "%s: OverlapsPrefix(%v) true", where(), p)
+				}
+				if _, ok := tab.Lookup(netip.Addr{}); ok || tab.Contains(netip.Addr{}) {
+					col.failClass(ht, "InvalidLookup", "%s: Lookup of the zero address ok", where())
+				}
+				r := tab.InsertPersist(p, 1)
+				r2 := tab.DeletePersist(p)
+				if !r.Equal(tab) || !r2.Equal(tab) {
+					col.failClass(ht, "InvalidPersist", "%s: InsertPersist/DeletePersist(%v) changed the table", where(), p)
+				}
+			default:
+				// a fresh insert of a random (possibly unmasked) prefix and its Get by an unmasked form
+				p, v := genPrefix(ht), genVal(ht)
+				trace = append(trace, fmt.Sprintf("Insert(%v, %d)", p, v))
+				tab.Insert(p, v)
+				md.insert(p, v)
+				u := netip.PrefixFrom(genAddrIn(ht, p), p.Bits())
+				if gv, ok := tab.Get(u); !ok || (tab.hasValues() && gv != v) {
+					col.failClass(ht, "GetUnmasked", "%s: Get(%v) = %d, %v after Insert(%v)", where(), u, gv, ok, p)
+				}
+			}
+			check(ht, col, tab, md, where())
+		}
+		col.count(kind)
+	})
+}
+
+// TestHegelSetOps: Overlaps/Overlaps4/Overlaps6 between two random tables (symmetric, as
+// modelled), Equal (reflexive, with clones, false after a change of value or set), Union as
+// the modelled merge with the argument's values winning.
+func TestHegelSetOps(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, kinds)
+		a, ma := build(ht, kind, drawInt(ht, 0, 8))
+		b, mb := build(ht, kind, drawInt(ht, 0, 8))
+		if chance(ht, 30) {
+			// make b share some prefixes with a
+			for _, e := range a.AllSorted() {
+				if chance(ht, 50) {
+					v := genVal(ht)
+					b.Insert(e.p, v)
+					mb.insert(e.p, v)
+				}
+			}
+		}
+		what := fmt.Sprintf("%s A=%v B=%v", kind, a.AllSorted(), b.AllSorted())
+		for _, f := range []struct {
+			name string
+			got  func(x, y rtab) bool
+			is4  *bool
+		}{
+			{"Overlaps", func(x, y rtab) bool { return x.Overlaps(y) }, nil},
+			{"Overlaps4", func(x, y rtab) bool { return x.Overlaps4(y) }, ptr(true)},
+			{"Overlaps6", func(x, y rtab) bool { return x.Overlaps6(y) }, ptr(false)},
+		} {
+			want := ma.overlaps(mb, f.is4)
+			if got := f.got(a, b); got != want {
+				col.failClass(ht, f.name, "%s: %s = %v, want %v", what, f.name, got, want)
+			}
+			if got := f.got(b, a); got != want {
+				col.failClass(ht, f.name+"Sym", "%s: %s (reversed) = %v, want %v", what, f.name, got, want)
+			}
+		}
+		if !a.Equal(a) || !a.Equal(a.Clone()) {
+			col.failClass(ht, "EqualSelf", "%s: A not Equal to itself or its clone", what)
+		}
+		if got, want := a.Equal(b), ma.equal(mb) || (!a.hasValues() && sameKeys(ma, mb)); got != want {
+			col.failClass(ht, "Equal", "%s: A.Equal(B) = %v, want %v", what, got, want)
+		}
+		if a.hasValues() && a.Size() > 0 {
+			c := a.Clone()
+			e := pick(ht, a.AllSorted())
+			c.Insert(e.p, e.v+1)
+			if a.Equal(c) {
+				col.failClass(ht, "EqualValue", "%s: Equal after changing the value of %v", what, e.p)
+			}
+		}
+		// Union
+		u := a.Clone()
+		u.Union(b)
+		mu := ma.clone()
+		mu.union(mb)
+		check(ht, col, u, mu, what+" Union")
+		if !u.Equal(a.UnionPersist(b)) {
+			col.failClass(ht, "UnionPersist", "%s: UnionPersist differs from Union", what)
+		}
+		if b.Size() == 0 && !u.Equal(a) {
+			col.failClass(ht, "UnionEmpty", "%s: Union with an empty table changed A", what)
+		}
+		// union with itself is identity
+		s := a.Clone()
+		s.Union(a)
+		if !s.Equal(a) {
+			col.failClass(ht, "UnionSelf", "%s: A.Union(A) != A", what)
+		}
+	})
+}
+
+func sameKeys(a, b *model) bool {
+	if len(a.m) != len(b.m) {
+		return false
+	}
+	for p := range a.m {
+		if _, ok := b.m[p]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelDump: MarshalJSON is the two DumpLists; Fprint/MarshalText lists every prefix
+// exactly once under one header per non-empty family, in sorted order.
+func TestHegelDump(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, kinds)
+		tab, md := build(ht, kind, drawInt(ht, 0, 12))
+		what := fmt.Sprintf("%s %v", kind, tab.AllSorted())
+		js, err := tab.MarshalJSON()
+		if err != nil {
+			col.failClass(ht, "JSONErr", "%s: MarshalJSON: %v", what, err)
+			return
+		}
+		var back struct {
+			V4 []bart.DumpListNode[json.RawMessage] `json:"ipv4"`
+			V6 []bart.DumpListNode[json.RawMessage] `json:"ipv6"`
+		}
+		if err := json.Unmarshal(js, &back); err != nil {
+			col.failClass(ht, "JSONParse", "%s: MarshalJSON output does not parse: %v: %s", what, err, js)
+			return
+		}
+		if got, want := toTree(back.V4), md.dumpTree(true); !sameTree(got, want, false) {
+			col.failClass(ht, "JSON4", "%s: JSON ipv4 %s, want %s", what, fmtTree(got), fmtTree(want))
+		}
+		if got, want := toTree(back.V6), md.dumpTree(false); !sameTree(got, want, false) {
+			col.failClass(ht, "JSON6", "%s: JSON ipv6 %s, want %s", what, fmtTree(got), fmtTree(want))
+		}
+		if tab.hasValues() {
+			// the values survive
+			var walk func(ns []bart.DumpListNode[json.RawMessage])
+			walk = func(ns []bart.DumpListNode[json.RawMessage]) {
+				for _, n := range ns {
+					if string(n.Value) != fmt.Sprint(md.m[n.CIDR]) {
+						col.failClass(ht, "JSONValue", "%s: JSON value of %v is %s, want %d", what, n.CIDR, n.Value, md.m[n.CIDR])
+					}
+					walk(n.Subnets)
+				}
+			}
+			walk(back.V4)
+			walk(back.V6)
+		}
+		var buf bytes.Buffer
+		if err := tab.Fprint(&buf); err != nil {
+			col.failClass(ht, "FprintErr", "%s: Fprint: %v", what, err)
+			return
+		}
+		txt, err := tab.MarshalText()
+		if err != nil || string(txt) != buf.String() {
+			col.failClass(ht, "MarshalText", "%s: MarshalText %q, %v; Fprint %q", what, txt, err, buf.String())
+		}
+		lines := strings.Split(strings.TrimRight(buf.String(), "\n"), "\n")
+		if buf.Len() == 0 {
+			lines = nil
+		}
+		headers, entries := 0, 0
+		var order []netip.Prefix
+		for _, l := range lines {
+			if l == "\u25bc" {
+				headers++
+				continue
+			}
+			i := strings.Index(l, "\u2500 ")
+			if i < 0 {
+				col.failClass(ht, "FprintLine", "%s: unexpected line %q", what, l)
+				continue
+			}
+			rest := l[i+len("\u2500 "):]
+			j := strings.Index(rest, " (")
+			if j < 0 && tab.hasValues() {
+				col.failClass(ht, "FprintLine", "%s: unexpected line %q", what, l)
+				continue
+			}
+			if j < 0 {
+				j = len(rest) // Lite prints no value
+			}
+			p, err := netip.ParsePrefix(rest[:j])
+			if err != nil {
+				col.failClass(ht, "FprintPrefix", "%s: line %q: %v", what, l, err)
+				continue
+			}
+			order = append(order, p)
+			entries++
+		}
+		wantHeaders := 0
+		if md.size(ptr(true)) > 0 {
+			wantHeaders++
+		}
+		if md.size(ptr(false)) > 0 {
+			wantHeaders++
+		}
+		if headers != wantHeaders || entries != md.size(nil) {
+			col.failClass(ht, "FprintShape", "%s: Fprint has %d headers and %d entries, want %d and %d:\n%s", what, headers, entries, wantHeaders, md.size(nil), buf.String())
+		}
+		if !samePrefixes(order, md.sorted(nil)) {
+			col.failClass(ht, "FprintOrder", "%s: Fprint order %v, want %v", what, order, md.sorted(nil))
+		}
+	})
+}
+
+// TestHegelAggregate: Lite.Aggregate yields the minimal covering set: covered prefixes gone,
+// full sibling pairs merged, every address's membership unchanged.
+func TestHegelAggregate(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tab, md := build(ht, "Lite", drawInt(ht, 0, 10))
+		// add siblings and subnets deliberately
+		for _, e := range tab.AllSorted() {
+			if e.p.Bits() > 0 && chance(ht, 40) {
+				s := sibling(e.p)
+				tab.Insert(s, 0)
+				md.insert(s, 0)
+			}
+			if chance(ht, 30) {
+				q := genQuery(ht, md)
+				tab.Insert(q, 0)
+				md.insert(q, 0)
+			}
+		}
+		before := tab.Clone()
+		what := fmt.Sprintf("Lite %v", tab.AllSorted())
+		addrs := make([]netip.Addr, 0, 12)
+		for i := 0; i < 12; i++ {
+			addrs = append(addrs, genAddr(ht, md))
+		}
+		tab.(*liteW).t.Aggregate()
+		md.aggregate()
+		check(ht, col, tab, md, what+" aggregated")
+		for _, ip := range addrs {
+			if tab.Contains(ip) != before.Contains(ip) {
+				col.failClass(ht, "AggregateContains", "%s: Contains(%v) changed from %v by Aggregate", what, ip, before.Contains(ip))
+			}
+		}
+		if tab.Size() > before.Size() {
+			col.failClass(ht, "AggregateSize", "%s: Aggregate grew the table from %d to %d", what, before.Size(), tab.Size())
+		}
+		// idempotent
+		again := tab.Clone()
+		again.(*liteW).t.Aggregate()
+		if !again.Equal(tab) {
+			col.failClass(ht, "AggregateIdempotent", "%s: a second Aggregate changed the table: %v -> %v", what, tab.AllSorted(), again.AllSorted())
+		}
+	})
+}
+
+// TestHegelPersistVersions: a chain of Persist operations leaves every earlier version
+// intact (structural sharing must not leak writes), each still matching its own model.
+func TestHegelPersistVersions(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, kinds)
+		tab, md := build(ht, kind, drawInt(ht, 0, 8))
+		type version struct {
+			t  rtab
+			md *model
+			op string
+		}
+		versions := []version{{tab, md, "start"}}
+		n := drawInt(ht, 1, 10)
+		for i := 0; i < n; i++ {
+			cur := versions[len(versions)-1]
+			p, v := genQuery(ht, cur.md), genVal(ht)
+			nm := cur.md.clone()
+			var nt rtab
+			var op string
+			switch drawInt(ht, 0, 3) {
+			case 0, 1:
+				nt = cur.t.InsertPersist(p, v)
+				nm.insert(p, v)
+				op = fmt.Sprintf("InsertPersist(%v, %d)", p, v)
+			case 2:
+				nt = cur.t.DeletePersist(p)
+				nm.delete(p)
+				op = fmt.Sprintf("DeletePersist(%v)", p)
+			default:
+				o, mo := build(ht, kind, drawInt(ht, 0, 4))
+				nt = cur.t.UnionPersist(o)
+				nm.union(mo)
+				op = fmt.Sprintf("UnionPersist(%v)", o.AllSorted())
+			}
+			versions = append(versions, version{nt, nm, op})
+		}
+		// (no in-place mutation here: the versions share untouched nodes by design, so only the
+		// Persist operations are valid on them from now on)
+		for i, ver := range versions {
+			check(ht, col, ver.t, ver.md, fmt.Sprintf("%s version %d (%s) of %d", kind, i, ver.op, len(versions)))
+		}
+	})
+}
