diff --git a/hegel/hegel_concurrent_test.go b/hegel/hegel_concurrent_test.go
new file mode 100644
index 0000000..f88e0ee
--- /dev/null
+++ b/hegel/hegel_concurrent_test.go
@@ -0,0 +1,99 @@
+package hegel
+
+import (
+	"fmt"
+	"net/netip"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelConcurrentPersist: the documented lock-free pattern: readers query a version
+// while a writer produces new versions with the Persist operations; every reader's answers
+// must match the version's model throughout (run with -race in development).
+func TestHegelConcurrentPersist(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, kinds)
+		tab, md := build(ht, kind, drawInt(ht, 1, 10))
+		// the queries the readers will ask, and the answers of the initial version
+		type q struct {
+			p    netip.Prefix
+			want []pv
+		}
+		nq := drawInt(ht, 1, 6)
+		qs := make([]q, nq)
+		for i := range qs {
+			p := genQuery(ht, md)
+			qs[i] = q{p, tab.Supernets(p)}
+		}
+		// the writer's operations, drawn up front (no draws inside goroutines)
+		nops := drawInt(ht, 1, 12)
+		type wop struct {
+			p   netip.Prefix
+			v   int
+			del bool
+		}
+		ops := make([]wop, nops)
+		for i := range ops {
+			ops[i] = wop{genQuery(ht, md), genVal(ht), chance(ht, 30)}
+		}
+		var wg sync.WaitGroup
+		var mu sync.Mutex
+		var bad []string
+		readers := drawInt(ht, 1, 3)
+		for r := 0; r < readers; r++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				for round := 0; round < 20; round++ {
+					for _, qq := range qs {
+						got := tab.Supernets(qq.p)
+						if !samePVList(got, qq.want) {
+							mu.Lock()
+							bad = append(bad, fmt.Sprintf("Supernets(%v) = %v, want %v", qq.p, got, qq.want))
+							mu.Unlock()
+							return
+						}
+						if _, ok := tab.LookupPrefix(qq.p); ok != (len(qq.want) > 0) {
+							mu.Lock()
+							bad = append(bad, fmt.Sprintf("LookupPrefix(%v) ok %v, want %v", qq.p, ok, len(qq.want) > 0))
+							mu.Unlock()
+							return
+						}
+					}
+				}
+			}()
+		}
+		cur := tab
+		wmd := md.clone()
+		for _, o := range ops {
+			if o.del {
+				cur = cur.DeletePersist(o.p)
+				wmd.delete(o.p)
+			} else {
+				cur = cur.InsertPersist(o.p, o.v)
+				wmd.insert(o.p, o.v)
+			}
+		}
+		wg.Wait()
+		for _, b := range bad {
+			col.failClass(ht, "Reader", "%s: a reader of the original version saw %s while the writer persisted %d ops", kind, b, nops)
+		}
+		check(ht, col, tab, md, fmt.Sprintf("%s original after %d persist ops", kind, nops))
+		check(ht, col, cur, wmd, fmt.Sprintf("%s newest after %d persist ops", kind, nops))
+	})
+}
+
+func samePVList(a, b []pv) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..f7828fa
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,485 @@
+package hegel
+
+// The model: a routing table as a map from canonical (masked) prefix to value, with every
+// query answered by brute force over the map using net/netip.
+
+import (
+	"fmt"
+	"net/netip"
+	"sort"
+
+	"hegel.dev/go/hegel"
+)
+
+type model struct {
+	m map[netip.Prefix]int
+}
+
+func newModel() *model { return &model{m: map[netip.Prefix]int{}} }
+
+func (md *model) clone() *model {
+	c := newModel()
+	for p, v := range md.m {
+		c.m[p] = v
+	}
+	return c
+}
+
+func (md *model) insert(p netip.Prefix, v int) {
+	if !p.IsValid() {
+		return
+	}
+	md.m[p.Masked()] = v
+}
+
+func (md *model) delete(p netip.Prefix) {
+	if !p.IsValid() {
+		return
+	}
+	delete(md.m, p.Masked())
+}
+
+func (md *model) get(p netip.Prefix) (int, bool) {
+	if !p.IsValid() {
+		return 0, false
+	}
+	v, ok := md.m[p.Masked()]
+	return v, ok
+}
+
+// lookup: the longest prefix containing ip (an IPv6 address with a zone is looked up without
+// it, as the package documents).
+func (md *model) lookup(ip netip.Addr) (netip.Prefix, int, bool) {
+	if !ip.IsValid() {
+		return netip.Prefix{}, 0, false
+	}
+	ip = ip.WithZone("")
+	best, bv, ok := netip.Prefix{}, 0, false
+	for p, v := range md.m {
+		if p.Addr().Is4() == ip.Is4() && p.Contains(ip) && (!ok || p.Bits() > best.Bits()) {
+			best, bv, ok = p, v, true
+		}
+	}
+	return best, bv, ok
+}
+
+// covers reports whether p covers q: same family, p no longer than q, q's address inside p.
+func covers(p, q netip.Prefix) bool {
+	return p.Addr().Is4() == q.Addr().Is4() && p.Bits() <= q.Bits() && p.Contains(q.Addr())
+}
+
+// lookupPrefix: the longest prefix covering q (the most specific entry matching every address
+// of q).
+func (md *model) lookupPrefix(q netip.Prefix) (netip.Prefix, int, bool) {
+	if !q.IsValid() {
+		return netip.Prefix{}, 0, false
+	}
+	q = q.Masked()
+	best, bv, ok := netip.Prefix{}, 0, false
+	for p, v := range md.m {
+		if covers(p, q) && (!ok || p.Bits() > best.Bits()) {
+			best, bv, ok = p, v, true
+		}
+	}
+	return best, bv, ok
+}
+
+// supernets: every prefix covering q, longest first.
+func (md *model) supernets(q netip.Prefix) []netip.Prefix {
+	if !q.IsValid() {
+		return nil
+	}
+	q = q.Masked()
+	var out []netip.Prefix
+	for p := range md.m {
+		if covers(p, q) {
+			out = append(out, p)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Bits() > out[j].Bits() })
+	return out
+}
+
+// subnets: every prefix covered by q, in CIDR sort order.
+func (md *model) subnets(q netip.Prefix) []netip.Prefix {
+	if !q.IsValid() {
+		return nil
+	}
+	q = q.Masked()
+	var out []netip.Prefix
+	for p := range md.m {
+		if covers(q, p) {
+			out = append(out, p)
+		}
+	}
+	sortPrefixes(out)
+	return out
+}
+
+func (md *model) overlapsPrefix(q netip.Prefix) bool {
+	if !q.IsValid() {
+		return false
+	}
+	for p := range md.m {
+		if p.Addr().Is4() == q.Addr().Is4() && p.Overlaps(q) {
+			return true
+		}
+	}
+	return false
+}
+
+func (md *model) overlaps(o *model, is4 *bool) bool {
+	for p := range md.m {
+		if is4 != nil && p.Addr().Is4() != *is4 {
+			continue
+		}
+		for q := range o.m {
+			if p.Addr().Is4() == q.Addr().Is4() && p.Overlaps(q) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (md *model) union(o *model) {
+	for p, v := range o.m {
+		md.m[p] = v
+	}
+}
+
+func (md *model) equal(o *model) bool {
+	if len(md.m) != len(o.m) {
+		return false
+	}
+	for p, v := range md.m {
+		if w, ok := o.m[p]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+func (md *model) size(is4 *bool) int {
+	n := 0
+	for p := range md.m {
+		if is4 == nil || p.Addr().Is4() == *is4 {
+			n++
+		}
+	}
+	return n
+}
+
+// sorted: every prefix of the family (nil: both, IPv4 first) in CIDR sort order.
+func (md *model) sorted(is4 *bool) []netip.Prefix {
+	var v4, v6 []netip.Prefix
+	for p := range md.m {
+		if p.Addr().Is4() {
+			v4 = append(v4, p)
+		} else {
+			v6 = append(v6, p)
+		}
+	}
+	sortPrefixes(v4)
+	sortPrefixes(v6)
+	if is4 == nil {
+		return append(v4, v6...)
+	}
+	if *is4 {
+		return v4
+	}
+	return v6
+}
+
+// dumpTree: the hierarchy of one family: roots are prefixes with no covering prefix; the
+// children of a node are the prefixes whose closest covering prefix is that node; sorted.
+type treeNode struct {
+	pfx  netip.Prefix
+	val  int
+	subs []treeNode
+}
+
+func (md *model) dumpTree(is4 bool) []treeNode {
+	all := md.sorted(&is4)
+	parent := map[netip.Prefix]netip.Prefix{}
+	hasParent := map[netip.Prefix]bool{}
+	for _, p := range all {
+		for _, q := range all {
+			if q != p && covers(q, p) && (!hasParent[p] || q.Bits() > parent[p].Bits()) {
+				parent[p], hasParent[p] = q, true
+			}
+		}
+	}
+	var build func(par netip.Prefix, root bool) []treeNode
+	build = func(par netip.Prefix, root bool) []treeNode {
+		var out []treeNode
+		for _, p := range all {
+			if root && !hasParent[p] || !root && hasParent[p] && parent[p] == par {
+				out = append(out, treeNode{pfx: p, val: md.m[p], subs: build(p, false)})
+			}
+		}
+		return out
+	}
+	return build(netip.Prefix{}, true)
+}
+
+// aggregate: the minimal set of CIDR blocks covering the same addresses: covered prefixes
+// removed, sibling pairs merged, to a fixpoint.
+func (md *model) aggregate() {
+	for {
+		changed := false
+		// remove covered
+		for p := range md.m {
+			for q := range md.m {
+				if q != p && covers(q, p) {
+					delete(md.m, p)
+					changed = true
+					break
+				}
+			}
+		}
+		// merge siblings
+		for p := range md.m {
+			if p.Bits() == 0 {
+				continue
+			}
+			s := sibling(p)
+			if _, ok := md.m[s]; ok {
+				parentPfx := netip.PrefixFrom(p.Addr(), p.Bits()-1).Masked()
+				delete(md.m, p)
+				delete(md.m, s)
+				md.m[parentPfx] = 0
+				changed = true
+				break
+			}
+		}
+		if !changed {
+			return
+		}
+	}
+}
+
+// sibling flips the last bit of p's network.
+func sibling(p netip.Prefix) netip.Prefix {
+	b := p.Bits()
+	if p.Addr().Is4() {
+		a := p.Addr().As4()
+		i := (b - 1) / 8
+		a[i] ^= 1 << (7 - uint(b-1)%8)
+		return netip.PrefixFrom(netip.AddrFrom4(a), b)
+	}
+	a := p.Addr().As16()
+	i := (b - 1) / 8
+	a[i] ^= 1 << (7 - uint(b-1)%8)
+	return netip.PrefixFrom(netip.AddrFrom16(a), b)
+}
+
+// cmpPrefix: CIDR sort order, by address then by length (IPv4 before IPv6).
+func cmpPrefix(a, b netip.Prefix) int {
+	if a.Addr().Is4() != b.Addr().Is4() {
+		if a.Addr().Is4() {
+			return -1
+		}
+		return 1
+	}
+	if c := a.Addr().Compare(b.Addr()); c != 0 {
+		return c
+	}
+	return a.Bits() - b.Bits()
+}
+
+func sortPrefixes(ps []netip.Prefix) {
+	sort.Slice(ps, func(i, j int) bool { return cmpPrefix(ps[i], ps[j]) < 0 })
+}
+
+// --------------------------------------------------------------------------- generators
+
+var v4Bases = []uint32{0x0a000000, 0x0a010000, 0xc0a80000, 0xc0a80100, 0xac100000, 0x00000000, 0xffffffff, 0x7f000000}
+
+// genPrefix4: an IPv4 prefix (not necessarily masked) with clustered addresses so that
+// prefixes overlap, cover and neighbour each other.
+func genPrefix4(tc hegel.TestCase) netip.Prefix {
+	var a uint32
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		a = uint32(drawInt(tc, 0, 1<<32-1))
+	default:
+		base := pick(tc, v4Bases)
+		low := uint32(drawInt(tc, 0, 0xffff))
+		if chance(tc, 50) {
+			low = uint32(drawInt(tc, 0, 3)) << uint(drawInt(tc, 0, 15))
+		}
+		a = base ^ low
+	}
+	b := drawInt(tc, 0, 32)
+	if chance(tc, 40) {
+		b = pick(tc, []int{0, 1, 7, 8, 9, 15, 16, 17, 23, 24, 25, 31, 32})
+	}
+	var ab [4]byte
+	ab[0], ab[1], ab[2], ab[3] = byte(a>>24), byte(a>>16), byte(a>>8), byte(a)
+	return netip.PrefixFrom(netip.AddrFrom4(ab), b)
+}
+
+// genPrefix6: an IPv6 prefix within a few documentation and special ranges.
+func genPrefix6(tc hegel.TestCase) netip.Prefix {
+	var a [16]byte
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		for i := range a {
+			a[i] = byte(drawInt(tc, 0, 255))
+		}
+	case 1:
+		a[0], a[1], a[2], a[3] = 0x20, 0x01, 0x0d, 0xb8
+		for i := 4; i < 16; i++ {
+			if chance(tc, 30) {
+				a[i] = byte(drawInt(tc, 0, 255))
+			}
+		}
+	case 2:
+		a[0], a[1] = 0xfe, 0x80
+		a[15] = byte(drawInt(tc, 0, 3))
+	default:
+		a[0], a[1], a[2], a[3] = 0x20, 0x01, 0x0d, 0xb8
+		a[7] = byte(drawInt(tc, 0, 3))
+		a[15] = byte(drawInt(tc, 0, 3))
+	}
+	b := drawInt(tc, 0, 128)
+	if chance(tc, 40) {
+		b = pick(tc, []int{0, 1, 3, 8, 16, 31, 32, 33, 47, 48, 56, 63, 64, 65, 96, 112, 127, 128})
+	}
+	return netip.PrefixFrom(netip.AddrFrom16(a), b)
+}
+
+func genPrefix(tc hegel.TestCase) netip.Prefix {
+	if chance(tc, 55) {
+		return genPrefix4(tc)
+	}
+	return genPrefix6(tc)
+}
+
+// genAddrIn: an address inside p (its network, its last address, or a random one).
+func genAddrIn(tc hegel.TestCase, p netip.Prefix) netip.Addr {
+	p = p.Masked()
+	switch drawInt(tc, 0, 2) {
+	case 0:
+		return p.Addr()
+	case 1:
+		return lastAddr(p)
+	}
+	if p.Addr().Is4() {
+		a := p.Addr().As4()
+		host := 32 - p.Bits()
+		var r uint32
+		if host > 0 {
+			r = uint32(drawInt(tc, 0, 1<<uint(host)-1))
+		}
+		v := uint32(a[0])<<24 | uint32(a[1])<<16 | uint32(a[2])<<8 | uint32(a[3]) | r
+		return netip.AddrFrom4([4]byte{byte(v >> 24), byte(v >> 16), byte(v >> 8), byte(v)})
+	}
+	a := p.Addr().As16()
+	for i := p.Bits(); i < 128; i++ {
+		if chance(tc, 50) {
+			a[i/8] |= 1 << (7 - uint(i)%8)
+		}
+	}
+	return netip.AddrFrom16(a)
+}
+
+func lastAddr(p netip.Prefix) netip.Addr {
+	if p.Addr().Is4() {
+		a := p.Addr().As4()
+		for i := p.Bits(); i < 32; i++ {
+			a[i/8] |= 1 << (7 - uint(i)%8)
+		}
+		return netip.AddrFrom4(a)
+	}
+	a := p.Addr().As16()
+	for i := p.Bits(); i < 128; i++ {
+		a[i/8] |= 1 << (7 - uint(i)%8)
+	}
+	return netip.AddrFrom16(a)
+}
+
+// genAddr: an address near the table's prefixes (inside one, or just outside), or random.
+func genAddr(tc hegel.TestCase, md *model) netip.Addr {
+	ps := md.sorted(nil)
+	if len(ps) > 0 && chance(tc, 75) {
+		p := pick(tc, ps)
+		if chance(tc, 25) {
+			// the neighbour just past the prefix
+			a := lastAddr(p).Next()
+			if a.IsValid() {
+				return a
+			}
+		}
+		if chance(tc, 20) {
+			a := p.Masked().Addr().Prev()
+			if a.IsValid() {
+				return a
+			}
+		}
+		return genAddrIn(tc, p)
+	}
+	return genPrefix(tc).Addr()
+}
+
+// genQuery: a prefix for a lookup, related to the table's prefixes.
+func genQuery(tc hegel.TestCase, md *model) netip.Prefix {
+	ps := md.sorted(nil)
+	if len(ps) > 0 && chance(tc, 70) {
+		p := pick(tc, ps)
+		switch drawInt(tc, 0, 3) {
+		case 0:
+			return p
+		case 1: // a subnet
+			b := p.Bits()
+			if b < p.Addr().BitLen() {
+				b = drawInt(tc, b+1, p.Addr().BitLen())
+			}
+			return netip.PrefixFrom(genAddrIn(tc, p), b)
+		case 2: // a supernet
+			return netip.PrefixFrom(p.Addr(), drawInt(tc, 0, p.Bits()))
+		default: // unmasked
+			return netip.PrefixFrom(genAddrIn(tc, p), p.Bits())
+		}
+	}
+	return genPrefix(tc)
+}
+
+func genVal(tc hegel.TestCase) int { return drawInt(tc, 1, 1000) }
+
+// --------------------------------------------------------------------------- helpers
+
+func samePrefixes(a, b []netip.Prefix) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func setOf(ps []netip.Prefix) map[netip.Prefix]bool {
+	s := map[netip.Prefix]bool{}
+	for _, p := range ps {
+		s[p] = true
+	}
+	return s
+}
+
+func fmtTree(ns []treeNode) string {
+	s := "["
+	for i, n := range ns {
+		if i > 0 {
+			s += " "
+		}
+		s += fmt.Sprintf("%v=%d", n.pfx, n.val)
+		if len(n.subs) > 0 {
+			s += fmtTree(n.subs)
+		}
+	}
+	return s + "]"
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..bfc2650
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,839 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"iter"
+	"net/netip"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gaissmai/bart"
+)
+
+// --------------------------------------------------------------------------- adapters
+
+// pv is a prefix with its value.
+type pv struct {
+	p netip.Prefix
+	v int
+}
+
+// rtab is the common face of Table[int], Fast[int] and Lite for the properties. Lite has no
+// values: its adapter reports 0 and hasValues() false.
+type rtab interface {
+	name() string
+	hasValues() bool
+	Insert(p netip.Prefix, v int)
+	Delete(p netip.Prefix)
+	Get(p netip.Prefix) (int, bool)
+	Lookup(ip netip.Addr) (int, bool)
+	Contains(ip netip.Addr) bool
+	LookupPrefix(p netip.Prefix) (int, bool)
+	LookupPrefixLPM(p netip.Prefix) (netip.Prefix, int, bool)
+	// Modify: the callback receives (value, exists) and returns (new value, delete)
+	Modify(p netip.Prefix, cb func(int, bool) (int, bool))
+	Supernets(p netip.Prefix) []pv
+	Subnets(p netip.Prefix) []pv
+	OverlapsPrefix(p netip.Prefix) bool
+	Overlaps(o rtab) bool
+	Overlaps4(o rtab) bool
+	Overlaps6(o rtab) bool
+	Union(o rtab)
+	Equal(o rtab) bool
+	Clone() rtab
+	InsertPersist(p netip.Prefix, v int) rtab
+	DeletePersist(p netip.Prefix) rtab
+	ModifyPersist(p netip.Prefix, cb func(int, bool) (int, bool)) rtab
+	UnionPersist(o rtab) rtab
+	Size() int
+	Size4() int
+	Size6() int
+	All() []pv
+	All4() []pv
+	All6() []pv
+	AllSorted() []pv
+	AllSorted4() []pv
+	AllSorted6() []pv
+	Dump4() []treeNode
+	Dump6() []treeNode
+	MarshalJSON() ([]byte, error)
+	MarshalText() ([]byte, error)
+	Fprint(w *bytes.Buffer) error
+	fresh() rtab
+}
