+
+func toTree[V any](ns []bart.DumpListNode[V]) []treeNode {
+	var out []treeNode
+	for _, n := range ns {
+		v := 0
+		if x, ok := any(n.Value).(int); ok {
+			v = x
+		}
+		out = append(out, treeNode{pfx: n.CIDR, val: v, subs: toTree(n.Subnets)})
+	}
+	return out
+}
