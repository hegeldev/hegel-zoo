--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,498 @@
+package mapstructure_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// the bug judges (encoding/json on a struct tagged for both packages, the
+// weak conversion table, the Metadata model), so that each bug has a
+// property that finds it every run; the wide properties in hegel_test.go
+// reach the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws
+// the neighbouring region the bug does not touch instead (numbers within
+// their field's range, integral floats, the unexported field skipped by
+// IgnoreUntaggedFields, float32 values exact in both widths, an interface
+// value of the input's own kind, a non-nil value for the pointer) and
+// passes.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"testing"
+
+	"github.com/go-viper/mapstructure/v2"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- mapstructure/1 and /2
+
+// Ranged has a field per numeric width a number can leave the range of.
+type Ranged struct {
+	I8  int8    `mapstructure:"i8" json:"i8"`
+	I16 int16   `mapstructure:"i16" json:"i16"`
+	I32 int32   `mapstructure:"i32" json:"i32"`
+	I64 int64   `mapstructure:"i64" json:"i64"`
+	U8  uint8   `mapstructure:"u8" json:"u8"`
+	U16 uint16  `mapstructure:"u16" json:"u16"`
+	U32 uint32  `mapstructure:"u32" json:"u32"`
+	U64 uint64  `mapstructure:"u64" json:"u64"`
+	F32 float32 `mapstructure:"f32" json:"f32"`
+}
+
+// numText is the JSON text of a Go number: an integral float reads as an
+// integer ("300", "1000000"), a fraction does not ("300.5"), and a float of
+// 1e21 or more is written with an exponent, as encoding/json writes it.
+func numText(in any) string {
+	switch x := in.(type) {
+	case int:
+		return strconv.FormatInt(int64(x), 10)
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case uint:
+		return strconv.FormatUint(uint64(x), 10)
+	case uint64:
+		return strconv.FormatUint(x, 10)
+	case float32:
+		return floatText(float64(x), 32)
+	case float64:
+		return floatText(x, 64)
+	}
+	panic(fmt.Sprintf("numText: %T", in))
+}
+
+func floatText(f float64, bits int) string {
+	if math.Abs(f) < 1e21 {
+		return strconv.FormatFloat(f, 'f', -1, bits)
+	}
+	return strconv.FormatFloat(f, 'g', -1, bits)
+}
+
+// numberCase: a field of Ranged and a Go number decoded into it.
+type numberCase struct {
+	key string
+	in  any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c numberCase) GoString() string { return fmt.Sprintf("%s <- %T(%v)", c.key, c.in, c.in) }
+
+// ofKinds is n in one of the Go kinds that hold it: int and int64, uint and
+// uint64 when it is not negative, float64 when it is within 2^53.
+func ofKinds(n int64) hegel.Generator[any] {
+	kinds := []hegel.Generator[any]{hegel.Just[any](int(n)), hegel.Just[any](n)}
+	if n >= 0 {
+		kinds = append(kinds, hegel.Just[any](uint(n)), hegel.Just[any](uint64(n)))
+	}
+	if -(1<<53) <= n && n <= 1<<53 {
+		kinds = append(kinds, hegel.Just[any](float64(n)))
+	}
+	return hegel.OneOf(kinds...)
+}
+
+// within is an integer of [lo, hi] in one of the kinds that hold it.
+func within(lo, hi int64) hegel.Generator[any] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), ofKinds)
+}
+
+// beyond is an integer past [lo, hi] by one to span, above or below, in one
+// of the kinds that hold it.
+func beyond(lo, hi, span int64) hegel.Generator[any] {
+	steps := hegel.Integers[int64](1, span)
+	return hegel.FlatMap(hegel.OneOf(
+		hegel.Map(steps, func(k int64) int64 { return hi + k }),
+		hegel.Map(steps, func(k int64) int64 { return lo - k }),
+	), ofKinds)
+}
+
+// width: a field of Ranged below 64 bits, its range and the span of the
+// numbers drawn past it.
+type width struct {
+	key    string
+	lo, hi int64
+	span   int64
+}
+
+var widths = []width{
+	{"i8", math.MinInt8, math.MaxInt8, 1 << 7},
+	{"i16", math.MinInt16, math.MaxInt16, 1 << 15},
+	{"i32", math.MinInt32, math.MaxInt32, 1 << 31},
+	{"u8", 0, math.MaxUint8, 1 << 8},
+	{"u16", 0, math.MaxUint16, 1 << 16},
+	{"u32", 0, math.MaxUint32, 1 << 32},
+}
+
+var rangedKeys = []string{"i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32"}
+
+// hugeFloats: a float64 past float32's range, of either sign (10^39 to
+// 10^308).
+var hugeFloats = hegel.Composite(func(tc hegel.TestCase) any {
+	f := math.Pow10(hegel.Draw(tc, hegel.Integers(39, 308)))
+	if hegel.Draw(tc, chance(50)) {
+		f = -f
+	}
+	return f
+})
+
+// rangedNumbers: per field of Ranged, a number outside its range (the shape
+// of mapstructure/1: a signed or unsigned width overrun in either direction,
+// int64 met by a uint64 or a float at or beyond 2^63, uint64 by a float at
+// or beyond 2^64 or a negative integer, float32 by a float beyond its range)
+// or, under HEGEL_NO_KNOWN=1, one within it.
+var rangedNumbers = func() map[string]hegel.Generator[any] {
+	m := map[string]hegel.Generator[any]{}
+	for _, w := range widths {
+		m[w.key] = shaped(beyond(w.lo, w.hi, w.span), within(w.lo, w.hi))
+	}
+	exact := within(-(1 << 53), 1<<53)
+	m["i64"] = shaped(hegel.OneOf(
+		asAny(hegel.Integers[uint64](1<<63, math.MaxUint64)),
+		asAny(hegel.SampledFrom([]float64{1 << 63, 1e19, 1e20, -1e19, -1e30})),
+	), exact)
+	m["u64"] = shaped(hegel.OneOf(
+		asAny(hegel.SampledFrom([]float64{1 << 64, 1e20, 1e30})),
+		hegel.FlatMap(hegel.Map(hegel.Integers[int64](1, 1<<20), func(k int64) int64 { return -k }), ofKinds),
+	), within(0, 1<<53))
+	m["f32"] = shaped(hugeFloats, asAny(integralFloats(-1000000, 1000000)))
+	return m
+}()
+
+var numberCases = hegel.FlatMap(hegel.SampledFrom(rangedKeys), func(key string) hegel.Generator[numberCase] {
+	return hegel.Map(rangedNumbers[key], func(in any) numberCase { return numberCase{key, in} })
+})
+
+// agreesWithJSON decodes the number into the field of Ranged in strict mode
+// and has encoding/json read its JSON text into the same field: both refuse
+// it, or both give the same struct.
+func agreesWithJSON(ht *hegel.T, key string, in any, shape []string) {
+	var got, want Ranged
+	gerr := mapstructure.Decode(map[string]any{key: in}, &got)
+	text := fmt.Sprintf(`{%q: %s}`, key, numText(in))
+	werr := json.Unmarshal([]byte(text), &want)
+	if (gerr == nil) != (werr == nil) {
+		mismatch(ht, shape, "Decode(%s <- %T(%v)): error %v; encoding/json on %s: %v", key, in, in, gerr, text, werr)
+	}
+	if gerr == nil && !reflect.DeepEqual(got, want) {
+		mismatch(ht, shape, "Decode(%s <- %T(%v)) = %+v; encoding/json on %s gives %+v", key, in, in, got, text, want)
+	}
+}
+
+// TestHegelOutOfRangeNumbersAreRefused: a number outside the range of the
+// integer or float field it is decoded into is refused in strict mode, as
+// encoding/json refuses it ("cannot unmarshal number 300 into ... int8");
+// the library wraps it through reflect's SetInt/SetUint or saturates it
+// (mapstructure/1).
+func TestHegelOutOfRangeNumbersAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, numberCases)
+		agreesWithJSON(ht, c.key, c.in, known("mapstructure/1"))
+	})
+}
+
+var (
+	intKeys = []string{"i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"}
+	// fractions: the fraction part of a float into an integer field (the
+	// shape of mapstructure/2); none under HEGEL_NO_KNOWN=1.
+	fractions = shaped(hegel.SampledFrom([]float64{0.5, 0.25, 0.75, 0.1, 0.7, 0.999}), hegel.Just(0.0))
+)
+
+// floatKinds is f as a float64 or as a float32.
+func floatKinds(f float64) hegel.Generator[any] {
+	return hegel.OneOf(hegel.Just[any](f), hegel.Just[any](float32(f)))
+}
+
+// fractionCases: an integer field of Ranged and a float within its range
+// with a fraction from fractions, as a float64 or a float32.
+var fractionCases = hegel.FlatMap(hegel.SampledFrom(intKeys), func(key string) hegel.Generator[numberCase] {
+	lo := -100
+	if key[0] == 'u' {
+		lo = 0
+	}
+	wholes := hegel.Integers(lo, 100)
+	values := hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) float64 {
+		return float64(hegel.Draw(tc, wholes)) + hegel.Draw(tc, fractions)
+	}), floatKinds)
+	return hegel.Map(values, func(in any) numberCase { return numberCase{key, in} })
+})
+
+// TestHegelFractionalFloatsIntoIntegersAreRefused: a float with a fraction
+// decoded into an integer field in strict mode is refused, as encoding/json
+// refuses "1.7" for an int; the library converts it with int64() and keeps
+// the integer part (mapstructure/2).
+func TestHegelFractionalFloatsIntoIntegersAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, fractionCases)
+		agreesWithJSON(ht, c.key, c.in, known("mapstructure/2"))
+	})
+}
+
+// --------------------------------------------------------------------------- mapstructure/3
+
+// Partly has two tagged exported fields and an unexported one, which the
+// decoder skips.
+type Partly struct {
+	Pub  int    `mapstructure:"pub"`
+	Also string `mapstructure:"also"`
+	priv int
+}
+
+// unsetCase: the keys of Partly present in the input (nil: absent).
+type unsetCase struct {
+	pub  *int
+	also *string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c unsetCase) GoString() string { return fmt.Sprintf("input %#v", c.input()) }
+
+func (c unsetCase) input() map[string]any {
+	in := map[string]any{}
+	if c.pub != nil {
+		in["pub"] = *c.pub
+	}
+	if c.also != nil {
+		in["also"] = *c.also
+	}
+	return in
+}
+
+// unset: the exported fields absent from the input.
+func (c unsetCase) unset() []string {
+	keys := []string{}
+	if c.pub == nil {
+		keys = append(keys, "pub")
+	}
+	if c.also == nil {
+		keys = append(keys, "also")
+	}
+	return keys
+}
+
+var unsetCases = hegel.Composite(func(tc hegel.TestCase) unsetCase {
+	return unsetCase{pub: hegel.Draw(tc, optional(50, hegel.Integers(-9, 9))), also: hegel.Draw(tc, optional(50, strs))}
+})
+
+// TestHegelErrorUnsetSkipsUnexportedFields: Metadata.Unset lists the
+// exported fields the input does not set and ErrorUnset fires exactly when
+// there is one; an unexported field, which the decoder skips, is neither.
+// The library records the unexported field as unset before skipping it
+// (mapstructure/3). Under HEGEL_NO_KNOWN=1 the struct is decoded with
+// IgnoreUntaggedFields, which skips the untagged unexported field first: the
+// neighbouring region, in which the accounting holds.
+func TestHegelErrorUnsetSkipsUnexportedFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, unsetCases)
+		input, wantUnset := c.input(), c.unset()
+		var md mapstructure.Metadata
+		var p Partly
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &p, Metadata: &md, IgnoreUntaggedFields: noKnown})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		if err := dec.Decode(input); err != nil {
+			fail(ht, "Decode(%#v) = %v", input, err)
+			return
+		}
+		if !reflect.DeepEqual(sorted(md.Unset), sorted(wantUnset)) {
+			mismatch(ht, known("mapstructure/3"), "Metadata.Unset = %q for %#v; the exported fields absent are %q", md.Unset, input, wantUnset)
+			return
+		}
+		var q Partly
+		d2, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &q, ErrorUnset: true, IgnoreUntaggedFields: noKnown})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		err = d2.Decode(input)
+		if (err != nil) != (len(wantUnset) > 0) {
+			mismatch(ht, known("mapstructure/3"), "ErrorUnset: err %v for %#v; the exported fields absent are %q", err, input, wantUnset)
+		}
+		_ = p.priv
+	})
+}
+
+// --------------------------------------------------------------------------- mapstructure/4
+
+// weakFloat32s: a float32 for the string field of Weak: a decimal a/10^b
+// with one to seven decimals, whose shortest float64 form is usually longer
+// (the shape of mapstructure/4), or under HEGEL_NO_KNOWN=1 a dyadic a/2^b
+// of at most six significant digits (|a| < 1000, b up to 3), which both
+// widths write alike.
+var weakFloat32s = shaped(
+	hegel.Composite(func(tc hegel.TestCase) float32 {
+		return float32(float64(hegel.Draw(tc, hegel.Integers(-999999, 999999))) / math.Pow10(hegel.Draw(tc, hegel.Integers(1, 7))))
+	}),
+	hegel.Composite(func(tc hegel.TestCase) float32 {
+		return float32(hegel.Draw(tc, hegel.Integers(-999, 999))) / float32(int(1)<<hegel.Draw(tc, hegel.Integers(0, 3)))
+	}),
+)
+
+// TestHegelWeakFloat32ToStringKeepsItsShortestForm: WeaklyTypedInput turns
+// a float32 into the shortest decimal that reads back as that float32
+// (strconv.FormatFloat with bitSize 32), as it does for every other number;
+// the library formats it as a float64 (mapstructure/4).
+func TestHegelWeakFloat32ToStringKeepsItsShortestForm(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := hegel.Draw(ht, weakFloat32s)
+		var out Weak
+		if err := mapstructure.WeakDecode(map[string]any{"s": f}, &out); err != nil {
+			fail(ht, "WeakDecode(s <- float32(%v)) = %v", f, err)
+			return
+		}
+		if want := strconv.FormatFloat(float64(f), 'f', -1, 32); out.S != want {
+			mismatch(ht, known("mapstructure/4"), "WeakDecode(s <- float32(%v)) = %q, want %q", f, out.S, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- mapstructure/5
+
+// Holder has one interface field.
+type Holder struct {
+	Any any `mapstructure:"any"`
+}
+
+// kindOf names the kind of an interface value of anys ("" for nil).
+func kindOf(v any) string {
+	switch v.(type) {
+	case string:
+		return "string"
+	case float64:
+		return "float64"
+	case bool:
+		return "bool"
+	case []any:
+		return "list"
+	case map[string]any:
+		return "map"
+	}
+	return ""
+}
+
+var (
+	anyKindNames = []string{"string", "float64", "bool", "list", "map"}
+	anyKinds     = map[string]hegel.Generator[any]{"string": anyStrings, "float64": anyFloats, "bool": anyBools, "list": anyLists, "map": anyMaps}
+)
+
+// oldValuesFor: the value the interface field holds before the decode of
+// in: of another kind than in's (the shape of mapstructure/5), or under
+// HEGEL_NO_KNOWN=1 of in's own kind (nil for nil).
+func oldValuesFor(in any) hegel.Generator[any] {
+	kind := kindOf(in)
+	if noKnown {
+		if kind == "" {
+			return hegel.Just[any](nil)
+		}
+		return anyKinds[kind]
+	}
+	var others []hegel.Generator[any]
+	for _, name := range anyKindNames {
+		if name != kind {
+			others = append(others, anyKinds[name])
+		}
+	}
+	return hegel.OneOf(others...)
+}
+
+// zeroFieldsCase: the value the interface field holds before the decode,
+// and the value decoded into it with ZeroFields.
+type zeroFieldsCase struct {
+	old, in any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c zeroFieldsCase) GoString() string { return fmt.Sprintf("%#v over %#v", c.in, c.old) }
+
+var zeroFieldsCases = hegel.FlatMap(anys, func(in any) hegel.Generator[zeroFieldsCase] {
+	return hegel.Map(oldValuesFor(in), func(old any) zeroFieldsCase { return zeroFieldsCase{old: old, in: in} })
+})
+
+// TestHegelZeroFieldsReplacesAnInterfaceValue: with ZeroFields a field is
+// zeroed before it is written, so decoding over a struct whose interface
+// field holds a value gives what decoding into a fresh struct gives; the
+// library decodes into the old dynamic value, and fails when the input does
+// not fit its type (mapstructure/5).
+func TestHegelZeroFieldsReplacesAnInterfaceValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroFieldsCases)
+		input := map[string]any{"any": c.in}
+		var want Holder
+		werr := mapstructure.Decode(input, &want)
+		got := Holder{Any: c.old}
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &got, ZeroFields: true})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		gerr := dec.Decode(input)
+		if (gerr == nil) != (werr == nil) {
+			mismatch(ht, known("mapstructure/5"), "ZeroFields decode of %#v over an `any` holding %#v: %v; into a fresh struct: %v", c.in, c.old, gerr, werr)
+		}
+		if gerr == nil && !reflect.DeepEqual(got, want) {
+			mismatch(ht, known("mapstructure/5"), "ZeroFields decode of %#v over an `any` holding %#v = %#v; into a fresh struct %#v", c.in, c.old, got.Any, want.Any)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- mapstructure/6
+
+// PtrHolder has one pointer-to-struct field.
+type PtrHolder struct {
+	P *Inner `mapstructure:"p" json:"p"`
+}
+
+// pointerCase: the Inner the pointer field points to before the decode,
+// whether ZeroFields is on, and the input for the field: nil by default
+// (the shape of mapstructure/6), or under HEGEL_NO_KNOWN=1 another Inner.
+type pointerCase struct {
+	old  Inner
+	zero bool
+	in   *Inner
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c pointerCase) GoString() string {
+	return fmt.Sprintf("%#v over P=&%+v, ZeroFields %v", c.input(), c.old, c.zero)
+}
+
+// input is the map decoded: the field nil, or the Inner as a map.
+func (c pointerCase) input() map[string]any {
+	if c.in == nil {
+		return map[string]any{"p": nil}
+	}
+	return map[string]any{"p": map[string]any{"n": c.in.N, "s": c.in.S, "ok": c.in.OK}}
+}
+
+var pointerCases = hegel.Composite(func(tc hegel.TestCase) pointerCase {
+	return pointerCase{
+		old:  hegel.Draw(tc, inners),
+		zero: hegel.Draw(tc, hegel.Booleans()),
+		in:   hegel.Draw(tc, shaped(hegel.Just[*Inner](nil), hegel.Map(inners, ptrTo[Inner]))),
+	}
+})
+
+// TestHegelNilInputClearsAPrefilledPointer: decoding a map over a struct
+// whose pointer-to-struct field is set gives what encoding/json gives for
+// the same JSON over the same struct: nil for a null, the value for a
+// value, with or without ZeroFields. The library dereferences the set
+// pointer first and decodes the nil into the struct, so the pointer stays
+// (mapstructure/6).
+func TestHegelNilInputClearsAPrefilledPointer(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pointerCases)
+		input := c.input()
+		want := PtrHolder{P: ptrTo(c.old)}
+		if err := json.Unmarshal([]byte(jsonText(input)), &want); err != nil {
+			ht.Fatalf("json: %v", err)
+		}
+		got := PtrHolder{P: ptrTo(c.old)}
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &got, ZeroFields: c.zero})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		if err := dec.Decode(input); err != nil {
+			fail(ht, "Decode(%#v) over P=&%+v = %v", input, c.old, err)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, known("mapstructure/6"), "ZeroFields=%v: Decode(%#v) over P=&%+v leaves P=%s; encoding/json gives P=%s", c.zero, input, c.old, innerText(got.P), innerText(want.P))
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..ac31949
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1392 @@
+package mapstructure_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-viper/mapstructure/v2"
+	"hegel.dev/go/hegel"
+)
+
+// Property-based tests for go-viper/mapstructure. The oracles: encoding/json
+// on a struct universe tagged identically for both packages (struct→map,
+// and JSON-derived maps → struct), a model of the documented weak conversion
+// table, a model of Metadata/ErrorUnused/ErrorUnset/remain on a flat struct,
+// and the standard library parsers behind the string decode hooks.
+//
+// Every property draws one case record built from the binding's combinators
+// (a Big and the struct it is decoded over, a weak field with an input of a
+// random kind, the keys of a flat struct present in an input, a hook field
+// and its string), and pure functions turn the record into the values the
+// library and the oracle see. The shapes of the recorded bugs (bugs.toml)
+// are drawn at their natural rate, so the properties that meet them fail,
+// naming the shape, and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its
+// shape region alone, and the pins at the end of this file are the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Collect mode (MAPSTRUCTURE_COLLECT=1) prints every disagreement instead of
+// failing.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("MAPSTRUCTURE_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ------------------------------------------------------------ known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the gates of Known are on: the shapes are left out of the generators
+// (shaped) and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means
+// the shape is left out, which is so only under HEGEL_NO_KNOWN=1. The pins
+// at the end of this file assert the correct behaviour and fail while a bug
+// is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	wrappedIntegers    bool // mapstructure/1: an out-of-range number is wrapped or saturated silently (300 into int8 is 44)
+	truncatedFloats    bool // mapstructure/2: a float is truncated into an integer field without WeaklyTypedInput and without error
+	unexportedUnset    bool // mapstructure/3: ErrorUnset and Metadata.Unset count an unexported field, which the decoder skips
+	float32AsFloat64   bool // mapstructure/4: WeaklyTypedInput formats a float32 as a float64 when converting to string
+	interfaceNotZeroed bool // mapstructure/5: ZeroFields does not zero an interface field, so the input must fit the old dynamic type
+	nilKeepsPointer    bool // mapstructure/6: a nil input leaves a pre-filled pointer-to-struct field set
+}{
+	wrappedIntegers:    noKnown,
+	truncatedFloats:    noKnown,
+	unexportedUnset:    noKnown,
+	float32AsFloat64:   noKnown,
+	interfaceNotZeroed: noKnown,
+	nilKeepsPointer:    noKnown,
+}
+
+// gates are the switches of Known by bug id.
+var gates = map[string]bool{
+	"mapstructure/1": Known.wrappedIntegers,
+	"mapstructure/2": Known.truncatedFloats,
+	"mapstructure/3": Known.unexportedUnset,
+	"mapstructure/4": Known.float32AsFloat64,
+	"mapstructure/5": Known.interfaceNotZeroed,
+	"mapstructure/6": Known.nilKeepsPointer,
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and while every gate of the shape is on (HEGEL_NO_KNOWN=1)
+// a disagreement on it is skipped instead (rare then, since the generators
+// leave the shapes out).
+func mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		gated := true
+		for _, id := range shape {
+			gated = gated && gates[id]
+		}
+		ht.Assume(!gated)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// ------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny widens a generator's values to any (for the alternatives of a mixed
+// choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// jsonText is the JSON text of a value.
+func jsonText(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// ------------------------------------------------------------ the universe
+
+type Inner struct {
+	N  int    `mapstructure:"n" json:"n"`
+	S  string `mapstructure:"s" json:"s"`
+	OK bool   `mapstructure:"ok,omitempty" json:"ok,omitempty"`
+}
+
+type Base struct {
+	ID   uint16   `mapstructure:"id" json:"id"`
+	Tags []string `mapstructure:"tags,omitzero" json:"tags,omitzero"`
+}
+
+type Big struct {
+	Base    `mapstructure:",squash"`
+	Name    string         `mapstructure:"name" json:"name"`
+	Age     int8           `mapstructure:"age,omitempty" json:"age,omitempty"`
+	Score   float64        `mapstructure:"score" json:"score"`
+	F32     float32        `mapstructure:"f32,omitzero" json:"f32,omitzero"`
+	Big     int64          `mapstructure:"big" json:"big"`
+	U       uint64         `mapstructure:"u" json:"u"`
+	Ptr     *Inner         `mapstructure:"ptr,omitempty" json:"ptr,omitempty"`
+	Ptr2    *Inner         `mapstructure:"ptr2" json:"ptr2"`
+	In      Inner          `mapstructure:"in" json:"in"`
+	List    []Inner        `mapstructure:"list" json:"list"`
+	Nums    []int          `mapstructure:"nums,omitempty" json:"nums,omitempty"`
+	Kv      map[string]int `mapstructure:"kv" json:"kv"`
+	Any     any            `mapstructure:"any" json:"any"`
+	Skip    string         `mapstructure:"-" json:"-"`
+	hidden  int
+	Renamed string `mapstructure:"other_name" json:"other_name"`
+}
+
+func innerText(p *Inner) string {
+	if p == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("&%+v", *p)
+}
+
+// GoString is what the draw report prints (it uses %#v); the pointers are
+// dereferenced.
+func (b Big) GoString() string {
+	return fmt.Sprintf("Big{ID:%d Tags:%#v Name:%q Age:%d Score:%v F32:%v Big:%d U:%d Ptr:%s Ptr2:%s In:%+v List:%+v Nums:%#v Kv:%#v Any:%#v Renamed:%q}",
+		b.ID, b.Tags, b.Name, b.Age, b.Score, b.F32, b.Big, b.U, innerText(b.Ptr), innerText(b.Ptr2), b.In, b.List, b.Nums, b.Kv, b.Any, b.Renamed)
+}
+
+var (
+	strPool   = []string{"", "a", "Bob", "ünï", "with space", "0x10", "true", "12", "-3", "null"}
+	floatPool = []float64{0, 1.5, -2.25, 1e10, 0.1, 3, -0.5, 123456.789}
+	f32Pool   = []float32{0, 0.5, 1.25, 100, -3.75}
+	kvKeys    = []string{"x", "y", "z", "ü"}
+)
+
+var (
+	strs   = hegel.SampledFrom(strPool)
+	floats = hegel.SampledFrom(floatPool)
+	f32s   = hegel.SampledFrom(f32Pool)
+	inners = hegel.Composite(func(tc hegel.TestCase) Inner {
+		return Inner{N: hegel.Draw(tc, hegel.Integers(-1000, 1000)), S: hegel.Draw(tc, strs), OK: hegel.Draw(tc, hegel.Booleans())}
+	})
+	// tags, innerLists, kvs: a nil collection, an empty one, or one to three
+	// elements (the three spellings encoding/json and the tags treat apart).
+	tags       = hegel.OneOf(hegel.Just[[]string](nil), hegel.Just([]string{}), many(strs, 1, 3))
+	innerLists = hegel.OneOf(hegel.Just[[]Inner](nil), hegel.Just([]Inner{}), many(inners, 1, 3))
+	kvs        = hegel.OneOf(hegel.Just[map[string]int](nil), hegel.Just(map[string]int{}), hegel.Maps(hegel.SampledFrom(kvKeys), hegel.Integers(-9, 9)).MinSize(1).MaxSize(3))
+	// The kinds of an interface value encoding/json itself produces: a
+	// string, a float64, a bool, a two-element list, a one-entry map.
+	anyStrings = asAny(strs)
+	anyFloats  = asAny(floats)
+	anyBools   = asAny(hegel.Booleans())
+	anyLists   = hegel.Composite(func(tc hegel.TestCase) any { return []any{hegel.Draw(tc, floats), hegel.Draw(tc, strs)} })
+	anyMaps    = hegel.Map(strs, func(s string) any { return map[string]any{"k": s} })
+	anys       = hegel.OneOf(hegel.Just[any](nil), anyStrings, anyFloats, anyBools, anyLists, anyMaps)
+	// bigs: a Big whose JSON round trip is exact: integers within 2^53, no
+	// NaN/Inf, no empty-but-non-nil value under omitempty (dropped, so it
+	// would come back nil), nothing in the fields both packages skip.
+	bigs = hegel.Composite(func(tc hegel.TestCase) Big {
+		return Big{
+			Base:    Base{ID: uint16(hegel.Draw(tc, hegel.Integers(0, 65535))), Tags: hegel.Draw(tc, tags)},
+			Name:    hegel.Draw(tc, strs),
+			Age:     int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+			Score:   hegel.Draw(tc, floats),
+			F32:     hegel.Draw(tc, f32s),
+			Big:     int64(hegel.Draw(tc, hegel.Integers(-(1<<53), 1<<53))),
+			U:       uint64(hegel.Draw(tc, hegel.Integers(0, 1<<53))),
+			Ptr:     hegel.Draw(tc, optional(50, inners)),
+			Ptr2:    hegel.Draw(tc, optional(50, inners)),
+			In:      hegel.Draw(tc, inners),
+			List:    hegel.Draw(tc, innerLists),
+			Nums:    hegel.Draw(tc, maybe(50, many(hegel.Integers(-50, 50), 1, 3))),
+			Kv:      hegel.Draw(tc, kvs),
+			Any:     hegel.Draw(tc, anys),
+			Renamed: hegel.Draw(tc, strs),
+		}
+	})
+)
+
+// viaJSON normalises a value through encoding/json into generic Go values.
+func viaJSON(v any) (any, error) {
+	data, err := json.Marshal(v)
+	if err != nil {
+		return nil, err
+	}
+	var out any
+	err = json.Unmarshal(data, &out)
+	return out, err
+}
+
+// ------------------------------------------------------------- properties
+
+// TestHegelStructToMapAgreesWithJSON: decoding a struct into a map gives, up
+// to JSON's value types, the object encoding/json writes for it — names,
+// squash, omitempty, omitzero, `-`, unexported fields, nested structs,
+// pointers, slices and maps alike.
+func TestHegelStructToMapAgreesWithJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := hegel.Draw(ht, bigs)
+		var m map[string]any
+		if err := mapstructure.Decode(v, &m); err != nil {
+			fail(ht, "Decode(struct, &map) = %v for %#v", err, v)
+			return
+		}
+		want, err := viaJSON(v)
+		if err != nil {
+			ht.Fatalf("json: %v", err)
+		}
+		got, err := viaJSON(m)
+		if err != nil {
+			fail(ht, "the map %#v does not marshal: %v", m, err)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "Decode(struct, &map) = %#v\n  as JSON %v\n  json.Marshal(struct) %v", m, got, want)
+		}
+	})
+}
+
+// TestHegelStructMapStructRoundTrips: struct → map → struct is the identity
+// on the universe.
+func TestHegelStructMapStructRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := hegel.Draw(ht, bigs)
+		var m map[string]any
+		if err := mapstructure.Decode(v, &m); err != nil {
+			fail(ht, "Decode(struct, &map) = %v", err)
+			return
+		}
+		var out Big
+		if err := mapstructure.Decode(m, &out); err != nil {
+			fail(ht, "Decode(map, &struct) = %v for %#v", err, m)
+			return
+		}
+		if !reflect.DeepEqual(out, v) {
+			fail(ht, "round trip changed the value:\n  in  %#v\n  map %#v\n  out %#v", v, m, out)
+		}
+	})
+}
+
+// jsonCase: a Big, and (30% of the time) the Big its JSON is decoded over
+// with ZeroFields instead of a fresh struct.
+type jsonCase struct {
+	v         Big
+	prefilled *Big
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c jsonCase) GoString() string {
+	s := fmt.Sprintf("value %#v", c.v)
+	if c.prefilled != nil {
+		s += fmt.Sprintf("\nprefilled %#v", *c.prefilled)
+	}
+	return s
+}
+
+// shapes names the recorded bugs whose shape the pre-filled decode has: the
+// `any` field holding a value of another kind than the input's
+// (mapstructure/5), a non-nil pointer-to-struct field meeting a null
+// (mapstructure/6).
+func (c jsonCase) shapes() []string {
+	if c.prefilled == nil {
+		return nil
+	}
+	var s []string
+	if p := c.prefilled; p.Any != nil && c.v.Any != nil && reflect.TypeOf(p.Any) != reflect.TypeOf(c.v.Any) {
+		s = append(s, "mapstructure/5")
+	}
+	if c.prefilled.Ptr2 != nil && c.v.Ptr2 == nil {
+		s = append(s, "mapstructure/6")
+	}
+	return s
+}
+
+// prefill is a Big to decode over: zero in every field a key omitted by
+// omitempty/omitzero would leave as it was (a key that is absent is never
+// written, by design) — Age, F32, Ptr, Nums, Tags, In.OK and the OK of
+// Ptr2's pointee. The `any` field (the shape of mapstructure/5) and Ptr2
+// (mapstructure/6) keep their values, or are nil too under HEGEL_NO_KNOWN=1.
+func prefill(b Big) Big {
+	b.Age, b.F32, b.Ptr, b.Nums, b.Tags, b.In.OK = 0, 0, nil, nil, nil, false
+	if b.Ptr2 != nil {
+		in := *b.Ptr2
+		in.OK = false
+		b.Ptr2 = &in
+	}
+	if Known.interfaceNotZeroed {
+		b.Any = nil
+	}
+	if Known.nilKeepsPointer {
+		b.Ptr2 = nil
+	}
+	return b
+}
+
+// copied is a Big whose pointer fields point to copies (so that a decode
+// over it leaves the case as drawn).
+func copied(b Big) Big {
+	if b.Ptr != nil {
+		b.Ptr = ptrTo(*b.Ptr)
+	}
+	if b.Ptr2 != nil {
+		b.Ptr2 = ptrTo(*b.Ptr2)
+	}
+	return b
+}
+
+var jsonCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+	return jsonCase{v: hegel.Draw(tc, bigs), prefilled: hegel.Draw(tc, optional(30, hegel.Map(bigs, prefill)))}
+})
+
+// TestHegelJSONMapDecodesLikeEncodingJSON: the generic value json.Unmarshal
+// produces for a struct's JSON decodes, with Decode, to what json.Unmarshal
+// produces for the struct itself — into a fresh struct, or with ZeroFields
+// over a pre-filled one (prefill), which must give the same for the keys
+// present.
+func TestHegelJSONMapDecodesLikeEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, jsonCases)
+		data, err := json.Marshal(c.v)
+		if err != nil {
+			ht.Fatalf("json: %v", err)
+		}
+		var generic any
+		if err := json.Unmarshal(data, &generic); err != nil {
+			ht.Fatalf("json: %v", err)
+		}
+		var want Big
+		if err := json.Unmarshal(data, &want); err != nil {
+			ht.Fatalf("json: %v", err)
+		}
+		var got Big
+		shape := c.shapes()
+		if c.prefilled != nil {
+			got = copied(*c.prefilled)
+			dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &got, ZeroFields: true})
+			if err != nil {
+				ht.Fatalf("NewDecoder: %v", err)
+			}
+			if err := dec.Decode(generic); err != nil {
+				mismatch(ht, shape, "Decode(json map) with ZeroFields = %v for %s\n  over %#v", err, data, *c.prefilled)
+				return
+			}
+		} else if err := mapstructure.Decode(generic, &got); err != nil {
+			fail(ht, "Decode(json map) = %v for %s", err, data)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, shape, "Decode(json map) = %#v\n  json.Unmarshal %#v\n  from %s", got, want, data)
+		}
+	})
+}
+
+// ------------------------------------------------------ weak conversions
+
+type Weak struct {
+	I  int            `mapstructure:"i"`
+	I8 int8           `mapstructure:"i8"`
+	U  uint           `mapstructure:"u"`
+	F  float64        `mapstructure:"f"`
+	B  bool           `mapstructure:"b"`
+	S  string         `mapstructure:"s"`
+	L  []string       `mapstructure:"l"`
+	M  map[string]int `mapstructure:"m"`
+}
+
+var weakStrings = []string{"", "12", "-3", "0x1f", "0X1F", "017", "0o17", "0b101", "1_000", "1.5", "-0.25", "1e3", "true", "false", "t", "F", "TRUE", "0", "1", "abc", " 1", "1 ", "+7", "300", "-129", "255", "9223372036854775808", "Inf", "NaN"}
+
+var (
+	weakFields = []string{"i", "i8", "u", "f", "b", "s", "l", "m"}
+	// mixed: the elements of the list and map inputs.
+	mixed = []any{"1", 2, "x", true}
+	// weakF32Pool: f32Pool and float32 values whose shortest form is longer
+	// as a float64 (the shape of mapstructure/4).
+	weakF32Pool = append([]float32{0.1, 0.3, 1e-7, 3.14}, f32Pool...)
+)
+
+// weakCase: a field of Weak and the input decoded into it.
+type weakCase struct {
+	field string
+	in    any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c weakCase) GoString() string { return fmt.Sprintf("%s <- %T %#v", c.field, c.in, c.in) }
+
+func integralFloats(lo, hi int) hegel.Generator[float64] {
+	return hegel.Map(hegel.Integers(lo, hi), func(n int) float64 { return float64(n) })
+}
+
+func integralFloat32s(lo, hi int) hegel.Generator[float32] {
+	return hegel.Map(hegel.Integers(lo, hi), func(n int) float32 { return float32(n) })
+}
+
+// weakInputsFor: an input of a random kind for the weak decode of field:
+// nil, a bool, an int within 300, an int64 within 2^40, a uint up to 300, an
+// integral float64 within 200, a float64 with a fraction or beyond 2^64, a
+// float32, one of the weak strings, a list of up to two mixed values, an
+// empty or a two-entry map, a []byte. Under HEGEL_NO_KNOWN=1 the numbers fit
+// the field: within int8 for i8 (mapstructure/1), integral for the integer
+// fields and non-negative for u (mapstructure/2), and the float32 for s and
+// l exact in both widths (mapstructure/4).
+func weakInputsFor(field string) hegel.Generator[any] {
+	ints, int64s, uints := hegel.Integers(-300, 300), hegel.Integers[int64](-(1<<40), 1<<40), hegel.Integers[uint](0, 300)
+	integral := integralFloats(-200, 200)
+	fractional := hegel.SampledFrom([]float64{1.5, -0.5, 1e21, 0.1, 100.25})
+	float32s := hegel.SampledFrom(weakF32Pool)
+	if noKnown {
+		switch field {
+		case "i8":
+			ints, int64s, uints = hegel.Integers(-128, 127), hegel.Integers[int64](-128, 127), hegel.Integers[uint](0, 127)
+			integral = integralFloats(-128, 127)
+			fractional, float32s = integral, integralFloat32s(-128, 127)
+		case "i":
+			fractional, float32s = integral, integralFloat32s(-200, 200)
+		case "u":
+			integral = integralFloats(0, 200)
+			fractional, float32s = integral, integralFloat32s(0, 200)
+		case "s", "l":
+			float32s = f32s
+		}
+	}
+	return hegel.OneOf(
+		hegel.Just[any](nil),
+		anyBools,
+		asAny(ints),
+		asAny(int64s),
+		asAny(uints),
+		asAny(integral),
+		asAny(fractional),
+		asAny(float32s),
+		asAny(hegel.SampledFrom(weakStrings)),
+		asAny(many(hegel.SampledFrom(mixed), 0, 2)),
+		hegel.OneOf(hegel.Just[any](map[string]any{}), hegel.Map(hegel.SampledFrom(mixed), func(v any) any { return map[string]any{"k": v, "j": 5} })),
+		hegel.Map(strs, func(s string) any { return []byte(s) }),
+	)
+}
+
+var weakInputs = func() map[string]hegel.Generator[any] {
+	m := map[string]hegel.Generator[any]{}
+	for _, f := range weakFields {
+		m[f] = weakInputsFor(f)
+	}
+	return m
+}()
+
+var weakCases = hegel.FlatMap(hegel.SampledFrom(weakFields), func(field string) hegel.Generator[weakCase] {
+	return hegel.Map(weakInputs[field], func(in any) weakCase { return weakCase{field, in} })
+})
+
+// weakInt is the documented table for an integer target of the given bit size.
+func weakInt(in any, bits int) (int64, bool) {
+	switch x := in.(type) {
+	case int:
+		return int64(x), inRange(int64(x), bits)
+	case int64:
+		return x, inRange(x, bits)
+	case uint:
+		return int64(x), inRange(int64(x), bits)
+	case float64:
+		return int64(x), x == math.Trunc(x) && inRange(int64(x), bits)
+	case float32:
+		return int64(x), float64(x) == math.Trunc(float64(x)) && inRange(int64(x), bits)
+	case bool:
+		if x {
+			return 1, true
+		}
+		return 0, true
+	case string:
+		if x == "" {
+			return 0, true
+		}
+		i, err := strconv.ParseInt(x, 0, bits)
+		return i, err == nil
+	}
+	return 0, false
+}
+
+func inRange(i int64, bits int) bool {
+	return bits >= 64 || (i >= -(1<<(bits-1)) && i < 1<<(bits-1))
+}
+
+func weakUint(in any) (uint64, bool) {
+	switch x := in.(type) {
+	case int:
+		return uint64(x), true // "negative numbers to overflowed uint values"
+	case int64:
+		return uint64(x), true
+	case uint:
+		return uint64(x), true
+	case float64:
+		return uint64(x), x >= 0 && x == math.Trunc(x)
+	case float32:
+		return uint64(x), x >= 0 && float64(x) == math.Trunc(float64(x))
+	case bool:
+		if x {
+			return 1, true
+		}
+		return 0, true
+	case string:
+		if x == "" {
+			return 0, true
+		}
+		i, err := strconv.ParseUint(x, 0, 64)
+		return i, err == nil
+	}
+	return 0, false
+}
+
+func weakFloat(in any) (float64, bool) {
+	switch x := in.(type) {
+	case int:
+		return float64(x), true
+	case int64:
+		return float64(x), true
+	case uint:
+		return float64(x), true
+	case float64:
+		return x, true
+	case float32:
+		return float64(x), true
+	case bool:
+		if x {
+			return 1, true
+		}
+		return 0, true
+	case string:
+		if x == "" {
+			return 0, true
+		}
+		f, err := strconv.ParseFloat(x, 64)
+		return f, err == nil
+	}
+	return 0, false
+}
+
+func weakBool(in any) (bool, bool) {
+	switch x := in.(type) {
+	case int:
+		return x != 0, true
+	case int64:
+		return x != 0, true
+	case uint:
+		return x != 0, true
+	case float64:
+		return x != 0, true
+	case float32:
+		return x != 0, true
+	case bool:
+		return x, true
+	case string:
+		if x == "" {
+			return false, true
+		}
+		b, err := strconv.ParseBool(x)
+		return b, err == nil
+	}
+	return false, false
+}
+
+func weakString(in any) (string, bool) {
+	switch x := in.(type) {
+	case string:
+		return x, true
+	case bool:
+		if x {
+			return "1", true
+		}
+		return "0", true
+	case int:
+		return strconv.FormatInt(int64(x), 10), true
+	case int64:
+		return strconv.FormatInt(x, 10), true
+	case uint:
+		return strconv.FormatUint(uint64(x), 10), true
+	case float64:
+		return strconv.FormatFloat(x, 'f', -1, 64), true
+	case float32:
+		return strconv.FormatFloat(float64(x), 'f', -1, 32), true
+	case []byte:
+		return string(x), true
+	}
+	return "", false
+}
+
+// weakStrings decodes into []string: a slice element-wise, an empty map to an
+// empty slice, any other single value lifted into a one-element slice.
+func weakStringSlice(in any) ([]string, bool) {
+	switch x := in.(type) {
+	case nil:
+		return nil, true
+	case []any:
+		if x == nil {
+			return nil, true
+		}
+		out := make([]string, 0, len(x))
+		for _, e := range x {
+			s, ok := weakString(e)
+			if !ok {
+				return nil, false
+			}
+			out = append(out, s)
+		}
+		return out, true
+	case []byte:
+		out := make([]string, 0, len(x))
+		for _, b := range x {
+			out = append(out, strconv.Itoa(int(b)))
+		}
+		return out, true
+	case map[string]any:
+		if len(x) == 0 {
+			return []string{}, true
+		}
+		return nil, false
+	}
+	s, ok := weakString(in)
+	if !ok {
+		return nil, false
+	}
+	return []string{s}, true
+}
+
+// weakIntMap decodes into map[string]int: a map element-wise (weak values),
+// an empty slice to an empty map, a slice of maps merged.
+func weakIntMap(in any) (map[string]int, bool) {
+	switch x := in.(type) {
+	case nil:
+		return nil, true
+	case map[string]any:
+		out := map[string]int{}
+		for k, v := range x {
+			i, ok := weakInt(v, 64)
+			if !ok {
+				return nil, false
+			}
+			out[k] = int(i)
+		}
+		return out, true
+	case []any:
+		out := map[string]int{}
+		for _, e := range x {
+			m, ok := e.(map[string]any)
+			if !ok {
+				return nil, false
+			}
+			for k, v := range m {
+				i, ok := weakInt(v, 64)
+				if !ok {
+					return nil, false
+				}
+				out[k] = int(i)
+			}
+		}
+		return out, true
+	case []byte:
+		if len(x) == 0 {
+			return map[string]int{}, true
+		}
+		return nil, false
+	}
+	return nil, false
+}
+
+// floatShape names mapstructure/2 for a float into an integer field that
+// has a fraction or lies beyond the field's range (the float is converted
+// with int64()/uint64() and no check).
+func floatShape(field string, x float64) []string {
+	switch field {
+	case "i", "i8":
+		return shapeIf(x != math.Trunc(x) || x < -(1<<63) || x >= 1<<63 || (field == "i8" && !inRange(int64(x), 8)), "mapstructure/2")
+	case "u":
+		return shapeIf(x != math.Trunc(x) || x < 0 || x >= 1<<64, "mapstructure/2")
+	}
+	return nil
+}
+
+// weakShape names the recorded bug whose shape a weak case has: an integer
+// beyond int8 into i8 (mapstructure/1), a float with a fraction or beyond
+// the field's range into an integer field (mapstructure/2), a float32 into
+// a string or a string slice whose shortest form differs between the widths
+// (mapstructure/4); nothing otherwise.
+func weakShape(field string, in any) []string {
+	switch x := in.(type) {
+	case int, int64, uint:
+		if field == "i8" {
+			i, _ := weakInt(x, 64)
+			return shapeIf(!inRange(i, 8), "mapstructure/1")
+		}
+	case float64:
+		return floatShape(field, x)
+	case float32:
+		if field == "s" || field == "l" {
+			return shapeIf(strconv.FormatFloat(float64(x), 'f', -1, 32) != strconv.FormatFloat(float64(x), 'f', -1, 64), "mapstructure/4")
+		}
+		return floatShape(field, float64(x))
+	}
+	return nil
+}
+
+// TestHegelWeakDecodeFollowsTheConversionTable: WeakDecode of one field from
+// an input of a random kind gives the value the documented table implies,
+// or an error exactly when the table has no row.
+func TestHegelWeakDecodeFollowsTheConversionTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, weakCases)
+		field, in := c.field, c.in
+		shape := weakShape(field, in)
+		var out Weak
+		err := mapstructure.WeakDecode(map[string]any{field: in}, &out)
+		var want any
+		var ok bool
+		var got any
+		switch field {
+		case "i":
+			var i int64
+			i, ok = weakInt(in, 64)
+			want, got = int(i), out.I
+		case "i8":
+			var i int64
+			i, ok = weakInt(in, 8)
+			want, got = int8(i), out.I8
+		case "u":
+			var u uint64
+			u, ok = weakUint(in)
+			want, got = uint(u), out.U
+		case "f":
+			want, ok = weakFloat(in)
+			got = out.F
+		case "b":
+			want, ok = weakBool(in)
+			got = out.B
+		case "s":
+			want, ok = weakString(in)
+			got = out.S
+		case "l":
+			want, ok = weakStringSlice(in)
+			got = out.L
+		case "m":
+			want, ok = weakIntMap(in)
+			got = out.M
+		}
+		if in == nil {
+			// nil input leaves the field alone, whatever the target.
+			want, ok = reflect.Zero(reflect.TypeOf(got)).Interface(), true
+		}
+		if (err == nil) != ok {
+			mismatch(ht, shape, "WeakDecode(%s <- %#v): error %v, the table says ok=%v (want %#v)", field, in, err, ok, want)
+			return
+		}
+		if gf, isF := got.(float64); isF && math.IsNaN(gf) && math.IsNaN(want.(float64)) {
+			return
+		}
+		if ok && !reflect.DeepEqual(got, want) {
+			mismatch(ht, shape, "WeakDecode(%s <- %#v) = %#v, the table says %#v", field, in, got, want)
+		}
+	})
+}
+
+// ------------------------------------------------------------- metadata
+
+type Flat struct {
+	Base `mapstructure:",squash"`
+	A    int    `mapstructure:"a"`
+	B    string `mapstructure:"bee"`
+	C    bool   `mapstructure:"c,omitempty"`
+	D    *int   `mapstructure:"d"`
+}
+
+type FlatR struct {
+	Flat `mapstructure:",squash"`
+	Rest map[string]any `mapstructure:",remain"`
+}
+
+// FlatH is a Flat beside an unexported field, which the decoder skips: the
+// shape of mapstructure/3 (ErrorUnset and Metadata.Unset count it).
+type FlatH struct {
+	Flat   `mapstructure:",squash"`
+	hidden int
+}
+
+type FlatRH struct {
+	FlatH `mapstructure:",squash"`
+	Rest  map[string]any `mapstructure:",remain"`
+}
+
+var flatKeys = []string{"id", "tags", "a", "bee", "c", "d"}
+
+// flatValues: a value for each key of the flat struct.
+var flatValues = map[string]hegel.Generator[any]{
+	"id":   asAny(hegel.Integers(0, 65535)),
+	"tags": asAny(tags),
+	"a":    asAny(hegel.Integers(-9, 9)),
+	"bee":  anyStrings,
+	"c":    anyBools,
+	"d":    asAny(hegel.Integers(0, 9)),
+}
+
+// flatEntry: a key of the flat struct as present in the input: upper-cased
+// (matched case-insensitively) or not, with its value.
+type flatEntry struct {
+	upper bool
+	val   any
+}
+
+// flatEntries: per key of flatKeys, the entry 60% of the time (upper-cased
+// 20%), else nil for absent.
+var flatEntries = func() []hegel.Generator[*flatEntry] {
+	gens := make([]hegel.Generator[*flatEntry], len(flatKeys))
+	for i, k := range flatKeys {
+		values := flatValues[k]
+		gens[i] = optional(60, hegel.Composite(func(tc hegel.TestCase) flatEntry {
+			return flatEntry{upper: hegel.Draw(tc, chance(20)), val: hegel.Draw(tc, values)}
+		}))
+	}
+	return gens
+}()
+
+// metaCase: which keys of the flat struct the input holds and how, the
+// extra keys, AllowUnsetPointer, which of ErrorUnused and ErrorUnset is
+// checked, and whether the target has an unexported field (FlatH, the shape
+// of mapstructure/3; never under HEGEL_NO_KNOWN=1).
+type metaCase struct {
+	entries  []*flatEntry // per flatKeys
+	extras   map[string]any
+	allowPtr bool
+	mode     string
+	hidden   bool
+}
+
+var metaCases = hegel.Composite(func(tc hegel.TestCase) metaCase {
+	c := metaCase{entries: make([]*flatEntry, len(flatKeys))}
+	for i, g := range flatEntries {
+		c.entries[i] = hegel.Draw(tc, g)
+	}
+	c.extras = hegel.Draw(tc, hegel.Maps(hegel.SampledFrom([]string{"x", "y", "zz"}), asAny(hegel.Integers(-9, 9))).MaxSize(3))
+	c.allowPtr = hegel.Draw(tc, chance(30))
+	c.mode = hegel.Draw(tc, hegel.SampledFrom([]string{"unused", "unset"}))
+	c.hidden = hegel.Draw(tc, shaped(chance(30), hegel.Just(false)))
+	return c
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c metaCase) GoString() string {
+	return fmt.Sprintf("input %#v allowPtr %v mode %s hidden %v", c.input(), c.allowPtr, c.mode, c.hidden)
+}
+
+// input is the map decoded: the present keys (as spelled) and the extras.
+func (c metaCase) input() map[string]any {
+	in := map[string]any{}
+	for i, e := range c.entries {
+		if e == nil {
+			continue
+		}
+		k := flatKeys[i]
+		if e.upper {
+			k = strings.ToUpper(k)
+		}
+		in[k] = e.val
+	}
+	for k, v := range c.extras {
+		in[k] = v
+	}
+	return in
+}
+
+// present: the keys decoded, as Metadata.Keys lists them: a slice
+// contributes one key per element as well.
+func (c metaCase) present() []string {
+	var keys []string
+	for i, e := range c.entries {
+		if e == nil {
+			continue
+		}
+		if tags, ok := e.val.([]string); ok {
+			for j := range tags {
+				keys = append(keys, fmt.Sprintf("tags[%d]", j))
+			}
+		}
+		keys = append(keys, flatKeys[i])
+	}
+	return keys
+}
+
+// unset: the absent keys, the pointer excepted under AllowUnsetPointer.
+func (c metaCase) unset() []string {
+	keys := []string{}
+	for i, e := range c.entries {
+		if e == nil && !(flatKeys[i] == "d" && c.allowPtr) {
+			keys = append(keys, flatKeys[i])
+		}
+	}
+	return keys
+}
+
+// unused: the extra keys.
+func (c metaCase) unused() []string {
+	keys := []string{}
+	for k := range c.extras {
+		keys = append(keys, k)
+	}
+	return keys
+}
+
+// rest: what a remain field takes: the extras, nil when there are none.
+func (c metaCase) rest() map[string]any {
+	if len(c.extras) > 0 {
+		return c.extras
+	}
+	return nil
+}
+
+// target is a fresh struct to decode into: a Flat, or a FlatH when hidden,
+// with a remain field when remain.
+func (c metaCase) target(remain bool) any {
+	switch {
+	case c.hidden && remain:
+		return &FlatRH{}
+	case c.hidden:
+		return &FlatH{}
+	case remain:
+		return &FlatR{}
+	}
+	return &Flat{}
+}
+
+// flatOf is the Flat part of a target.
+func flatOf(target any) Flat {
+	switch p := target.(type) {
+	case *Flat:
+		return *p
+	case *FlatH:
+		return p.Flat
+	case *FlatR:
+		return p.Flat
+	case *FlatRH:
+		return p.Flat
+	}
+	panic(fmt.Sprintf("flatOf: %T", target))
+}
+
+// restOf is the remain map of a target.
+func restOf(target any) map[string]any {
+	switch p := target.(type) {
+	case *FlatR:
+		return p.Rest
+	case *FlatRH:
+		return p.Rest
+	}
+	return nil
+}
+
+func sorted(xs []string) []string {
+	out := append([]string{}, xs...)
+	sort.Strings(out)
+	return out
+}
+
+// TestHegelMetadataAccountsForEveryKey: on a flat struct, Metadata.Keys are
+// the fields present in the input, Unused the extra keys, Unset the absent
+// fields (pointers excepted under AllowUnsetPointer); ErrorUnused and
+// ErrorUnset fire exactly then; a `,remain` map takes the extras.
+func TestHegelMetadataAccountsForEveryKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, metaCases)
+		input := c.input()
+		wantKeys, wantUnused, wantUnset := c.present(), c.unused(), c.unset()
+		shape := shapeIf(c.hidden, "mapstructure/3")
+
+		var md mapstructure.Metadata
+		target := c.target(false)
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: target, Metadata: &md, AllowUnsetPointer: c.allowPtr})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		if err := dec.Decode(input); err != nil {
+			fail(ht, "Decode(%#v) = %v", input, err)
+			return
+		}
+		out := flatOf(target)
+		if !reflect.DeepEqual(sorted(md.Keys), sorted(wantKeys)) || !reflect.DeepEqual(sorted(md.Unused), sorted(wantUnused)) || !reflect.DeepEqual(sorted(md.Unset), sorted(wantUnset)) {
+			mismatch(ht, shape, "Metadata for %#v (AllowUnsetPointer %v):\n  Keys %q want %q\n  Unused %q want %q\n  Unset %q want %q", input, c.allowPtr, md.Keys, wantKeys, md.Unused, wantUnused, md.Unset, wantUnset)
+			return
+		}
+		// ErrorUnused / ErrorUnset (the drawn mode) fires exactly when its list is non-empty.
+		cfg := &mapstructure.DecoderConfig{Result: c.target(false), AllowUnsetPointer: c.allowPtr, ErrorUnused: c.mode == "unused", ErrorUnset: c.mode == "unset"}
+		d2, _ := mapstructure.NewDecoder(cfg)
+		err = d2.Decode(input)
+		wantErr := (c.mode == "unused" && len(wantUnused) > 0) || (c.mode == "unset" && len(wantUnset) > 0)
+		if (err != nil) != wantErr {
+			mismatch(ht, shape, "Error%s: err %v for %#v, want error %v (unused %q unset %q)", strings.ToUpper(c.mode[:1])+c.mode[1:], err, input, wantErr, wantUnused, wantUnset)
+			return
+		}
+		// A remain field takes the extras and clears Unused.
+		rt := c.target(true)
+		var md2 mapstructure.Metadata
+		d3, _ := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: rt, Metadata: &md2, ErrorUnused: true})
+		if err := d3.Decode(input); err != nil {
+			fail(ht, "Decode into the remain struct = %v for %#v", err, input)
+			return
+		}
+		if rest := restOf(rt); !reflect.DeepEqual(rest, c.rest()) || len(md2.Unused) != 0 || !reflect.DeepEqual(flatOf(rt), out) {
+			fail(ht, "remain: Rest %#v want %#v, Unused %q, fields %+v vs %+v for %#v", rest, c.rest(), md2.Unused, flatOf(rt), out, input)
+		}
+	})
+}
+
+// ------------------------------------------------------------------ hooks
+
+type Hooked struct {
+	D   time.Duration `mapstructure:"d"`
+	L   []string      `mapstructure:"l"`
+	I8  int8          `mapstructure:"i8"`
+	U16 uint16        `mapstructure:"u16"`
+	F   float64       `mapstructure:"f"`
+	B   bool          `mapstructure:"b"`
+}
+
+var durationStrings = []string{"0", "1h2m", "300ms", "-1.5s", "1", "abc", "", "2h45m30.5s", "1µs", "1us", "+3ns", "1.5", "99999999999999999999h"}
+
+// hookCase: a field of Hooked and the string decoded into it.
+type hookCase struct {
+	field string
+	in    string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hookCase) GoString() string { return fmt.Sprintf("%s <- %q", c.field, c.in) }
+
+var (
+	hookFields = []string{"d", "l", "i8", "u16", "f", "b"}
+	// hookInputs: the string for each field: a duration, up to three
+	// comma-joined parts, or one of the weak strings.
+	hookInputs = map[string]hegel.Generator[string]{
+		"d":   hegel.SampledFrom(durationStrings),
+		"l":   hegel.Map(many(hegel.SampledFrom([]string{"", "a", "b c", "1"}), 0, 3), func(parts []string) string { return strings.Join(parts, ",") }),
+		"i8":  hegel.SampledFrom(weakStrings),
+		"u16": hegel.SampledFrom(weakStrings),
+		"f":   hegel.SampledFrom(weakStrings),
+		"b":   hegel.SampledFrom(weakStrings),
+	}
+	hookCases = hegel.FlatMap(hegel.SampledFrom(hookFields), func(field string) hegel.Generator[hookCase] {
+		return hegel.Map(hookInputs[field], func(in string) hookCase { return hookCase{field, in} })
+	})
+)
+
+// TestHegelDecodeHooksMatchTheirParsers: with the composed string hooks, a
+// string input decodes to what time.ParseDuration, strings.Split and strconv
+// give, and fails exactly when they do.
+func TestHegelDecodeHooksMatchTheirParsers(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hookCases)
+		field, in := c.field, c.in
+		var out Hooked
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+			Result: &out,
+			DecodeHook: mapstructure.ComposeDecodeHookFunc(
+				mapstructure.StringToTimeDurationHookFunc(),
+				mapstructure.StringToSliceHookFunc(","),
+				mapstructure.StringToBasicTypeHookFunc(),
+			),
+		})
+		if err != nil {
+			ht.Fatalf("NewDecoder: %v", err)
+		}
+		err = dec.Decode(map[string]any{field: in})
+		var want, got any
+		var perr error
+		switch field {
+		case "d":
+			want, perr = time.ParseDuration(in)
+			got = out.D
+		case "l":
+			if in == "" {
+				want = []string{}
+			} else {
+				want = strings.Split(in, ",")
+			}
+			got = out.L
+		case "i8":
+			var i int64
+			i, perr = strconv.ParseInt(in, 0, 8)
+			want, got = int8(i), out.I8
+		case "u16":
+			var u uint64
+			u, perr = strconv.ParseUint(in, 0, 16)
+			want, got = uint16(u), out.U16
+		case "f":
+			want, perr = strconv.ParseFloat(in, 64)
+			got = out.F
+		case "b":
+			want, perr = strconv.ParseBool(in)
+			got = out.B
+		}
+		if (err != nil) != (perr != nil) {
+			fail(ht, "hooked Decode(%s <- %q): error %v, the parser says %v", field, in, err, perr)
+			return
+		}
+		if gf, ok := got.(float64); ok && math.IsNaN(gf) && math.IsNaN(want.(float64)) {
+			return
+		}
+		if perr == nil && !reflect.DeepEqual(got, want) {
+			fail(ht, "hooked Decode(%s <- %q) = %#v, the parser says %#v", field, in, got, want)
+		}
+	})
+}
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ------------------------------------------------------------------- pins
+
+// TestHegelPinIntegerOverflowWraps — mapstructure/1: an out-of-range number
+// is wrapped (reflect's SetInt/SetUint truncate) or saturated instead of
+// refused; encoding/json reports "cannot unmarshal number 300 into int8".
+func TestHegelPinIntegerOverflowWraps(t *testing.T) {
+	defer guard(t)
+	var a struct{ A int8 }
+	if err := mapstructure.Decode(map[string]any{"a": 300}, &a); err == nil {
+		t.Errorf("Decode(300 into int8) = %d, no error", a.A)
+	}
+	var b struct{ A uint8 }
+	if err := mapstructure.Decode(map[string]any{"a": 256}, &b); err == nil {
+		t.Errorf("Decode(256 into uint8) = %d, no error", b.A)
+	}
+	var c struct{ A int64 }
+	if err := mapstructure.Decode(map[string]any{"a": uint64(math.MaxUint64)}, &c); err == nil {
+		t.Errorf("Decode(MaxUint64 into int64) = %d, no error", c.A)
+	}
+	var d struct{ A float32 }
+	if err := mapstructure.Decode(map[string]any{"a": 1e300}, &d); err == nil {
+		t.Errorf("Decode(1e300 into float32) = %v, no error", d.A)
+	}
+}
+
+// TestHegelPinFloatTruncatedIntoInt — mapstructure/2: a float with a
+// fraction, or beyond the integer range, is converted to an int without
+// WeaklyTypedInput and without error (1.7 → 1, 1e30 → MinInt64).
+func TestHegelPinFloatTruncatedIntoInt(t *testing.T) {
+	defer guard(t)
+	var a struct{ A int64 }
+	if err := mapstructure.Decode(map[string]any{"a": 1.7}, &a); err == nil {
+		t.Errorf("Decode(1.7 into int64) = %d, no error", a.A)
+	}
+	if err := mapstructure.Decode(map[string]any{"a": 1e30}, &a); err == nil {
+		t.Errorf("Decode(1e30 into int64) = %d, no error", a.A)
+	}
+}
+
+// TestHegelPinErrorUnsetCountsUnexportedField — mapstructure/3: an
+// unexported field, which the decoder skips by documentation, is reported
+// as unset by ErrorUnset, so the option cannot be used with such structs.
+func TestHegelPinErrorUnsetCountsUnexportedField(t *testing.T) {
+	defer guard(t)
+	type P struct {
+		Pub  int
+		priv int
+	}
+	var p P
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &p, ErrorUnset: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dec.Decode(map[string]any{"pub": 1}); err != nil {
+		t.Errorf("ErrorUnset with an unexported field: %v", err)
+	}
+	_ = p.priv
+}
+
+// TestHegelPinWeakFloat32ToString — mapstructure/4: a float32 converted to a
+// string with WeaklyTypedInput is formatted as a float64, so float32(0.1)
+// becomes "0.10000000149011612".
+func TestHegelPinWeakFloat32ToString(t *testing.T) {
+	defer guard(t)
+	var s struct{ S string }
+	if err := mapstructure.WeakDecode(map[string]any{"s": float32(0.1)}, &s); err != nil {
+		t.Fatal(err)
+	}
+	if want := strconv.FormatFloat(float64(float32(0.1)), 'f', -1, 32); s.S != want {
+		t.Errorf("WeakDecode(float32(0.1) into string) = %q, want %q", s.S, want)
+	}
+}
+
+// TestHegelPinZeroFieldsKeepsInterfaceDynamicType — mapstructure/5: with
+// ZeroFields, an interface field holding a value is not zeroed first; the
+// input must convert to the old dynamic type.
+func TestHegelPinZeroFieldsKeepsInterfaceDynamicType(t *testing.T) {
+	defer guard(t)
+	out := struct{ Any any }{Any: 1.5}
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &out, ZeroFields: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dec.Decode(map[string]any{"any": true}); err != nil {
+		t.Errorf("ZeroFields decode of true into an `any` holding 1.5: %v", err)
+	} else if out.Any != true {
+		t.Errorf("ZeroFields decode of true into an `any` holding 1.5 = %#v", out.Any)
+	}
+}
+
+// TestHegelPinNilInputKeepsPrefilledPointer — mapstructure/6: a nil input
+// for a non-nil pointer-to-struct field leaves the pointer set (the field is
+// dereferenced as if it were an embedded struct), with or without
+// ZeroFields; encoding/json sets it to nil for null.
+func TestHegelPinNilInputKeepsPrefilledPointer(t *testing.T) {
+	defer guard(t)
+	for _, zero := range []bool{false, true} {
+		out := struct{ P *Inner }{P: &Inner{N: 1}}
+		dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{Result: &out, ZeroFields: zero})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := dec.Decode(map[string]any{"p": nil}); err != nil {
+			t.Fatal(err)
+		}
+		if out.P != nil {
+			t.Errorf("ZeroFields=%v: decoding nil into a pre-filled *Inner leaves %+v", zero, *out.P)
+		}
+	}
+}
