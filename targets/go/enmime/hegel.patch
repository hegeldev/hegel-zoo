diff --git a/hegel/hegel_build_test.go b/hegel/hegel_build_test.go
new file mode 100644
index 0000000..ba09721
--- /dev/null
+++ b/hegel/hegel_build_test.go
@@ -0,0 +1,158 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/jhillyerd/enmime/v2"
+	"hegel.dev/go/hegel"
+)
+
+// A built message's expected leaves.
+type leaf struct {
+	ct, filename string
+	content      []byte
+}
+
+func (l leaf) key() string {
+	return l.ct + "\x00" + l.filename + "\x00" + hex.EncodeToString(l.content)
+}
+
+func sortLeaves(ls []leaf) {
+	sort.Slice(ls, func(i, j int) bool { return ls[i].key() < ls[j].key() })
+}
+
+func showLeaves(ls []leaf) string {
+	var b strings.Builder
+	for _, l := range ls {
+		fmt.Fprintf(&b, "  %s %q %q\n", l.ct, l.filename, l.content)
+	}
+	return b.String()
+}
+
+// TestHegelBuildReadByPython: a message built with Builder and written with
+// Encode is read by Python (and by enmime itself) with the given subject,
+// addresses, text, HTML and attachments.
+func TestHegelBuildReadByPython(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		subject := pick(tc, words...)
+		for k := pick(tc, 0, 0, 1, 8); k > 0; k-- {
+			subject += " " + pick(tc, words...)
+		}
+		from := genAddress(tc)
+		bld := enmime.Builder().From(from.name, from.addr).Subject(subject)
+		var tos []address
+		for k := n(tc, 1, 3); k > 0; k-- {
+			a := genAddress(tc)
+			tos = append(tos, a)
+			bld = bld.To(a.name, a.addr)
+		}
+		var want []leaf
+		text, html := "", ""
+		if chance(tc, 80) {
+			text = pick(tc, texts...)
+			if text == "" {
+				text = "x"
+			}
+			bld = bld.Text([]byte(text))
+			want = append(want, leaf{"text/plain", "", []byte(text)})
+		}
+		if chance(tc, 50) {
+			html = "<p>" + pick(tc, texts...) + "</p>"
+			bld = bld.HTML([]byte(html))
+			want = append(want, leaf{"text/html", "", []byte(html)})
+		}
+		if text == "" && html == "" {
+			text = "body"
+			bld = bld.Text([]byte(text))
+			want = append(want, leaf{"text/plain", "", []byte(text)})
+		}
+		for k := pick(tc, 0, 0, 1, 2, 3); k > 0; k-- {
+			ct := pick(tc, "application/octet-stream", "application/pdf", "image/gif", "text/plain", "text/csv")
+			content := []byte(pick(tc, binaries...))
+			if strings.HasPrefix(ct, "text/") {
+				content = []byte(pick(tc, texts...))
+			}
+			name := pick(tc, fileNames...)
+			if chance(tc, 30) && html != "" {
+				bld = bld.AddInline(content, ct, name, "cid"+fmt.Sprint(k))
+			} else {
+				bld = bld.AddAttachment(content, ct, name)
+			}
+			want = append(want, leaf{ct, name, content})
+		}
+		root, err := bld.Build()
+		if err != nil {
+			fail(ht, "Build: %v", err)
+		}
+		var buf bytes.Buffer
+		if err := root.Encode(&buf); err != nil {
+			fail(ht, "Encode: %v", err)
+		}
+		msg := buf.String()
+		if id := knownBuild(subject, from, tos, want, msg); id != "" {
+			count("known " + id)
+			return
+		}
+		count(fmt.Sprintf("%d leaves", len(want)))
+
+		// Python's reading.
+		py := py.parse(msg)
+		if py.Error != "" {
+			fail(ht, "Python rejects the built message: %s\nmessage:\n%s", py.Error, msg)
+		}
+		var got []leaf
+		for _, p := range py.Parts {
+			c, _ := hex.DecodeString(p.Content)
+			got = append(got, leaf{p.CT, p.Filename, c})
+		}
+		sortLeaves(want)
+		sortLeaves(got)
+		if len(got) != len(want) || showLeaves(got) != showLeaves(want) {
+			fail(ht, "Python reads the built message differently\nwant:\n%sgot:\n%smessage:\n%s", showLeaves(want), showLeaves(got), msg)
+		}
+		if py.Subject == nil || *py.Subject != subject {
+			fail(ht, "Python reads Subject %v, built %q\nmessage:\n%s", py.Subject, subject, msg)
+		}
+		if len(py.From) != 1 || py.From[0][0] != from.name || py.From[0][1] != from.addr {
+			fail(ht, "Python reads From %v, built %q <%s>\nmessage:\n%s", py.From, from.name, from.addr, msg)
+		}
+		if len(py.To) != len(tos) {
+			fail(ht, "Python reads %d To addresses, built %d\nmessage:\n%s", len(py.To), len(tos), msg)
+		}
+		for i, a := range tos {
+			if py.To[i][0] != a.name || py.To[i][1] != a.addr {
+				fail(ht, "Python reads To[%d] %q <%s>, built %q <%s>\nmessage:\n%s", i, py.To[i][0], py.To[i][1], a.name, a.addr, msg)
+			}
+		}
+
+		// enmime's own reading.
+		env, err := parser.ReadEnvelope(strings.NewReader(msg))
+		if err != nil {
+			fail(ht, "enmime rejects its own message: %v\nmessage:\n%s", err, msg)
+		}
+		if env.GetHeader("Subject") != subject {
+			fail(ht, "enmime reads back Subject %q, built %q\nmessage:\n%s", env.GetHeader("Subject"), subject, msg)
+		}
+		textParts := false
+		for _, l := range want {
+			if l.filename != "" && strings.HasPrefix(l.ct, "text/") {
+				textParts = true // Envelope.Text gathers inline text parts too, by design
+			}
+		}
+		if !textParts {
+			if env.Text != text && !(text == "" && env.Text != "") { // text derived from HTML when absent
+				fail(ht, "enmime reads back Text %q, built %q\nmessage:\n%s", env.Text, text, msg)
+			}
+			if env.HTML != html {
+				fail(ht, "enmime reads back HTML %q, built %q\nmessage:\n%s", env.HTML, html, msg)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_mime_test.go b/hegel/hegel_mime_test.go
new file mode 100644
index 0000000..ce92d6d
--- /dev/null
+++ b/hegel/hegel_mime_test.go
@@ -0,0 +1,723 @@
+package hegel
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime"
+	"mime/quotedprintable"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/jhillyerd/enmime/v2"
+	"golang.org/x/text/encoding/charmap"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// texts is the alphabet of text contents: ASCII, Latin-1, wider Unicode,
+// lines, trailing spaces, dots and dashes at line starts (boundary-like),
+// long lines, and characters special to quoted-printable.
+var texts = []string{
+	"", "hello", "Hello, world!\r\n", "line one\r\nline two\r\n", "no final newline",
+	"café", "naïve façade", "日本語", "emoji \U0001F600 here", "a=b = c==\r\n",
+	"trailing space \r\ntab\t\r\n", ".\r\n..\r\n", "--\r\n--not-a-boundary\r\n",
+	strings.Repeat("0123456789", 10), "From here\r\n", "=?utf-8?q?not_encoded?=",
+	"\r\n\r\nblank first\r\n", "   leading spaces",
+}
+
+// asciiTexts are the texts that are pure ASCII.
+var asciiTexts = func() []string {
+	var out []string
+	for _, t := range texts {
+		if isASCII(t) {
+			out = append(out, t)
+		}
+	}
+	return out
+}()
+
+// latin1Texts are the texts representable in ISO-8859-1.
+var latin1Texts = func() []string {
+	var out []string
+	for _, t := range texts {
+		if _, err := charmap.ISO8859_1.NewEncoder().String(t); err == nil {
+			out = append(out, t)
+		}
+	}
+	return out
+}()
+
+// cp1252Texts use the 0x80-0x9F range of Windows-1252 (not Latin-1).
+var cp1252Texts = []string{"smart \u201cquotes\u201d", "price \u20ac5", "dash \u2014 here\r\n", "\u2026"}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// words are header phrases: plain, needing quoting, non-ASCII.
+var words = []string{"Alice", "Bob Smith", "O'Brien", "Zoë", "Jürgen Müller", "山田 太郎", "a (comment)", "x, y", "Dr. Who", "=?foo?="}
+
+var addrs = []string{"alice@example.com", "bob.smith@example.org", "x+tag@sub.example.net", "\"quoted local\"@example.com", "a@[127.0.0.1]"}
+
+var binaries = []string{"", "\x00\x01\x02\xff\xfe", "GIF89a\x00\x00", "%PDF-1.4\n%\xe2\xe3\xcf\xd3\n", "\xff\xd8\xff\xe0JFIF"}
+
+var fileNames = []string{"a.txt", "report.pdf", "my file.txt", "résumé.pdf", "日本.txt", "semi;colon.txt", "quo\"te.txt", "x", "a\\b.txt"}
+
+var boundaries = []string{"b1", "----=_Part_0_123.456", "=-=-=", "boundary with space", "b'q", "abc:def", "b.1-2_3", "0"}
+
+// encWord encodes s as an RFC 2047 encoded word in the given charset and
+// encoding, or returns it as is when plain (ASCII with no specials).
+func encWord(tc hegel.TestCase, s string) string {
+	return encWordLang(tc, s, nil)
+}
+
+// encWordLang is encWord with an RFC 2231 language tag (=?utf-8*en?q?...?=,
+// RFC 2231 5) one time in ten when m is given, noting it in m.
+func encWordLang(tc hegel.TestCase, s string, m *message) string {
+	if isASCII(s) && chance(tc, 60) {
+		return s
+	}
+	cs := pick(tc, "utf-8", "UTF-8", "iso-8859-1")
+	if m != nil && chance(tc, 10) {
+		enc := encWordLang(tc, s, nil)
+		if strings.HasPrefix(enc, "=?") {
+			m.languageTag = true
+			i := strings.Index(enc[2:], "?") + 2
+			return enc[:i] + "*" + pick(tc, "en", "fr-CA", "") + enc[i:]
+		}
+		return enc
+	}
+	enc := pick(tc, mime.BEncoding, mime.QEncoding)
+	if strings.EqualFold(cs, "iso-8859-1") {
+		b, err := charmap.ISO8859_1.NewEncoder().String(s)
+		if err != nil {
+			cs = "utf-8"
+		} else {
+			s = b
+		}
+	}
+	return enc.Encode(cs, s)
+}
+
+// phrase draws a display name, plain or encoded.
+type address struct{ name, addr string }
+
+func genAddress(tc hegel.TestCase) address {
+	a := address{addr: pick(tc, addrs...)}
+	if chance(tc, 70) {
+		a.name = pick(tc, words...)
+	}
+	return a
+}
+
+// writeAddress writes the address the way a mail client would, quoting a
+// display name with specials or encoding a non-ASCII one.
+func writeAddress(tc hegel.TestCase, a address) string {
+	if a.name == "" {
+		if chance(tc, 30) {
+			return "<" + a.addr + ">"
+		}
+		return a.addr
+	}
+	name := a.name
+	if !isASCII(name) {
+		name = encWord(tc, name)
+	} else if strings.ContainsAny(name, "(),.:;<>@[]\"\\") || chance(tc, 30) {
+		name = `"` + strings.ReplaceAll(strings.ReplaceAll(name, `\`, `\\`), `"`, `\"`) + `"`
+	}
+	return name + " <" + a.addr + ">"
+}
+
+// part is a generated MIME part: a leaf with content or a multipart.
+type part struct {
+	ctype    string // media type
+	charset  string // for text parts, "" for none
+	cte      string // 7bit, 8bit, quoted-printable, base64, "" for none
+	disp     string // "", attachment, inline
+	filename string
+	content  string // decoded content (text: UTF-8; other: bytes)
+	boundary string
+	children []*part
+	extra    []string // extra header lines
+
+	noContentType bool // no Content-Type header: text/plain by default
+	noHeaders     bool // no headers at all (a child part): text/plain by default
+
+	fileName2231Charset bool // file name as an RFC 2231 value in a non-UTF-8 charset
+	boundaryLikeLine    bool // a content line starting with the parent's boundary and more text
+}
+
+// charsetEncoder returns the encoder for a single-byte charset name, nil for
+// UTF-8, ASCII or unknown.
+func charsetEncoder(cs string) *charmap.Charmap {
+	switch strings.ToLower(cs) {
+	case "iso-8859-1", "latin1":
+		return charmap.ISO8859_1
+	case "windows-1252":
+		return charmap.Windows1252
+	}
+	return nil
+}
+
+// spell varies the case of a token (media types, encodings are
+// case-insensitive).
+func spell(tc hegel.TestCase, s string) string {
+	switch pick(tc, 0, 0, 0, 1, 2) {
+	case 1:
+		return strings.ToUpper(s)
+	case 2:
+		return strings.ToUpper(s[:1]) + s[1:]
+	}
+	return s
+}
+
+func genLeaf(tc hegel.TestCase, depth int) *part {
+	p := &part{}
+	switch pick(tc, 0, 0, 0, 1, 2, 3) {
+	case 0, 1:
+		p.ctype = pick(tc, "text/plain", "text/plain", "text/html", "text/csv")
+		p.charset = pick(tc, "utf-8", "utf-8", "UTF-8", "utf8", "iso-8859-1", "ISO-8859-1", "latin1", "windows-1252", "us-ascii", "ascii", "")
+		switch charsetEncoder(p.charset) {
+		case nil:
+			if p.charset == "" || strings.HasPrefix(strings.ToLower(p.charset), "us") || p.charset == "ascii" {
+				p.content = pick(tc, asciiTexts...)
+			} else {
+				p.content = pick(tc, texts...)
+			}
+		case charmap.Windows1252:
+			p.content = pick(tc, append(latin1Texts, cp1252Texts...)...)
+		default:
+			p.content = pick(tc, latin1Texts...)
+		}
+		if p.charset == "" && chance(tc, 30) {
+			p.noContentType = true // text/plain by default
+			p.ctype = "text/plain"
+		}
+		p.cte = pick(tc, "", "7bit", "8bit", "quoted-printable", "base64")
+		if (p.cte == "" || p.cte == "7bit") && !isASCII(p.content) {
+			p.cte = pick(tc, "8bit", "quoted-printable", "base64")
+		}
+		if p.charset == "" && (p.cte == "8bit" || p.cte == "quoted-printable") && chance(tc, 50) {
+			p.cte = "base64"
+		}
+		if chance(tc, 25) {
+			p.disp = pick(tc, "attachment", "inline")
+			if chance(tc, 70) {
+				p.filename = pick(tc, fileNames...)
+			}
+		}
+	case 2:
+		p.ctype = pick(tc, "application/octet-stream", "application/pdf", "image/gif", "image/jpeg")
+		p.content = pick(tc, binaries...)
+		p.cte = pick(tc, "base64", "base64", "quoted-printable")
+		if isASCII(p.content) && !strings.ContainsAny(p.content, "\x00") {
+			p.cte = pick(tc, "base64", "7bit")
+		}
+		p.disp = pick(tc, "attachment", "attachment", "inline", "")
+		if chance(tc, 80) {
+			p.filename = pick(tc, fileNames...)
+		}
+	case 3:
+		p.ctype = pick(tc, "application/json", "text/calendar", "application/x-unknown")
+		p.content = pick(tc, asciiTexts...)
+		p.cte = pick(tc, "", "7bit", "base64")
+		if strings.HasPrefix(p.ctype, "text/") {
+			p.charset = "us-ascii"
+		}
+	}
+	return p
+}
+
+func genPart(tc hegel.TestCase, depth int) *part {
+	return genPartIn(tc, depth, nil)
+}
+
+// genPartIn draws a part; a nested multipart's boundary differs from its
+// ancestors' (a boundary must not occur inside the part it delimits).
+func genPartIn(tc hegel.TestCase, depth int, used []string) *part {
+	if depth < 2 && chance(tc, 35) {
+		p := &part{
+			ctype:    pick(tc, "multipart/mixed", "multipart/alternative", "multipart/related"),
+			boundary: pick(tc, boundaries...),
+		}
+		for _, u := range used {
+			if strings.HasPrefix(p.boundary, u) || strings.HasPrefix(u, p.boundary) {
+				p.boundary = fmt.Sprintf("%s_%d", p.boundary, depth)
+			}
+		}
+		for k := n(tc, 1, 3); k > 0; k-- {
+			p.children = append(p.children, genPartIn(tc, depth+1, append(used, p.boundary)))
+		}
+		return p
+	}
+	p := genLeaf(tc, depth)
+	if depth > 0 && p.noContentType && p.cte == "" && p.disp == "" && chance(tc, 40) {
+		p.noHeaders = true
+	}
+	return p
+}
+
+// message is a generated message.
+type message struct {
+	subject string
+	from    []address
+	to      []address
+	root    *part
+	eol     string
+	text    string
+
+	languageTag   bool // an encoded word with an RFC 2231 language tag
+	commentBefore bool // a comment before an address in To
+}
+
+func genMessage(tc hegel.TestCase) message {
+	m := message{eol: pick(tc, "\r\n", "\r\n", "\n")}
+	m.subject = pick(tc, words...)
+	for k := pick(tc, 0, 0, 1, 2, 8); k > 0; k-- {
+		m.subject += " " + pick(tc, words...)
+	}
+	m.from = []address{genAddress(tc)}
+	for k := n(tc, 1, 3); k > 0; k-- {
+		m.to = append(m.to, genAddress(tc))
+	}
+	m.root = genPart(tc, 0)
+	var b strings.Builder
+	w := func(s string) { b.WriteString(strings.ReplaceAll(s, "\r\n", m.eol)) }
+	w("From: " + writeAddress(tc, m.from[0]) + "\r\n")
+	var tos []string
+	for _, a := range m.to {
+		tos = append(tos, writeAddress(tc, a))
+	}
+	if chance(tc, 10) {
+		i := n(tc, 0, len(tos)-1)
+		tos[i] = pick(tc, "(comment) ", "(a (nested) one) ") + tos[i]
+		m.commentBefore = true
+	}
+	toLine := strings.Join(tos, pick(tc, ", ", ",\r\n ", ","))
+	if chance(tc, 10) {
+		toLine = pick(tc, "Team", "\"The Team\"", "undisclosed") + ": " + toLine + ";"
+	}
+	w("To: " + toLine + "\r\n")
+	subj := encWordLang(tc, m.subject, &m)
+	if strings.Contains(subj, "?= =?") && chance(tc, 50) {
+		// fold between encoded words (the folding white space is not part
+		// of the text, RFC 2047 6.2)
+		subj = strings.ReplaceAll(subj, "?= =?", "?=\r\n =?")
+	}
+	w("Subject: " + subj + "\r\n")
+	if chance(tc, 80) {
+		w("MIME-Version: 1.0\r\n")
+	}
+	w("Date: Mon, 01 Sep 2026 10:00:00 +0000\r\n")
+	writePart(tc, &b, m.root, m.eol, true, "")
+	m.text = b.String()
+	return m
+}
+
+// writePart writes a part's MIME headers (after the message headers, when
+// top) and its body.
+func writePart(tc hegel.TestCase, b *strings.Builder, p *part, eol string, top bool, parentBoundary string) {
+	w := func(s string) { b.WriteString(strings.ReplaceAll(s, "\r\n", eol)) }
+	if !p.noHeaders {
+		if !p.noContentType {
+			ct := spell(tc, p.ctype)
+			if p.boundary != "" {
+				q := p.boundary
+				if strings.ContainsAny(q, " '\":;()<>@,/?=[]") || chance(tc, 20) {
+					q = `"` + q + `"`
+				}
+				ct += pick(tc, "; boundary=", ";boundary=", "; Boundary=", ";\r\n boundary=") + q
+			}
+			if p.charset != "" {
+				cs := p.charset
+				if chance(tc, 30) {
+					cs = `"` + cs + `"`
+				}
+				ct += pick(tc, "; charset=", ";charset=", "; CHARSET=", ";\r\n\tcharset=") + cs
+			}
+			if p.filename != "" && chance(tc, 30) {
+				ct += "; name=" + quoteParam(p.filename)
+			}
+			w("Content-Type: " + ct + "\r\n")
+		}
+		if p.cte != "" {
+			w("Content-Transfer-Encoding: " + spell(tc, p.cte) + "\r\n")
+		}
+		if p.disp != "" {
+			cd := spell(tc, p.disp)
+			if p.filename != "" {
+				if enc := charsetEncoder("iso-8859-1"); chance(tc, 10) && !isASCII(p.filename) {
+					if l1, err := enc.NewEncoder().String(p.filename); err == nil {
+						p.fileName2231Charset = true
+						cd += "; filename*=" + pick(tc, "iso-8859-1", "ISO-8859-1") + "'" + pick(tc, "", "en") + "'" + pctEncode(l1)
+					} else {
+						cd += fileNameParam(tc, p.filename)
+					}
+				} else {
+					cd += fileNameParam(tc, p.filename)
+				}
+			}
+			w("Content-Disposition: " + cd + "\r\n")
+		}
+		if chance(tc, 10) {
+			w("X-Extra: value\r\n")
+		}
+	}
+	w("\r\n")
+	if p.boundary != "" {
+		if chance(tc, 30) {
+			w("This is a multi-part message in MIME format.\r\n")
+		}
+		if chance(tc, 10) {
+			w("\r\n")
+		}
+		trail := pick(tc, "", "", "  ", "\t")
+		for _, c := range p.children {
+			w("--" + p.boundary + trail + "\r\n")
+			writePart(tc, b, c, eol, false, p.boundary)
+		}
+		w("--" + p.boundary + "--" + trail + "\r\n")
+		if chance(tc, 30) {
+			w("epilogue text\r\n")
+		}
+		return
+	}
+	// body
+	content := p.content
+	if parentBoundary != "" && strings.HasPrefix(p.ctype, "text/") && (p.cte == "" || p.cte == "7bit" || p.cte == "8bit") && chance(tc, 8) {
+		// a line that begins with the boundary but is not a delimiter
+		// (RFC 2046 5.1.1: a delimiter is followed only by white space)
+		line := "--" + parentBoundary + pick(tc, " extra", "\textra", "--x", "-", "x")
+		if chance(tc, 30) {
+			line = "text " + line
+		}
+		content = strings.TrimSuffix(content, "\r\n") + "\r\n" + line + "\r\nafter\r\n"
+		p.content = content
+		p.boundaryLikeLine = true
+	}
+	if enc := charsetEncoder(p.charset); enc != nil {
+		content, _ = enc.NewEncoder().String(content)
+	}
+	switch strings.ToLower(p.cte) {
+	case "base64":
+		enc := base64.StdEncoding.EncodeToString([]byte(content))
+		if chance(tc, 10) {
+			enc = strings.TrimRight(enc, "=") // no padding
+		}
+		width := pick(tc, 76, 76, 60, 4, 1000)
+		for len(enc) > width {
+			w(enc[:width] + "\r\n")
+			enc = enc[width:]
+		}
+		w(enc + "\r\n")
+	case "quoted-printable":
+		var qb bytes.Buffer
+		qw := quotedprintable.NewWriter(&qb)
+		qw.Write([]byte(content))
+		qw.Close()
+		q := qb.String()
+		if chance(tc, 20) {
+			q = lowerHex(q)
+		}
+		w(q + "\r\n")
+	default:
+		w(content)
+		if !strings.HasSuffix(content, "\r\n") || chance(tc, 50) {
+			w("\r\n")
+		}
+	}
+}
+
+// lowerHex lowercases the hex digits of quoted-printable escapes.
+func lowerHex(q string) string {
+	var b strings.Builder
+	for i := 0; i < len(q); i++ {
+		if q[i] == '=' && i+2 < len(q) {
+			b.WriteByte('=')
+			b.WriteString(strings.ToLower(q[i+1 : i+3]))
+			i += 2
+			continue
+		}
+		b.WriteByte(q[i])
+	}
+	return b.String()
+}
+
+// fileNameParam writes the filename parameter of Content-Disposition in one
+// of its spellings: quoted (RFC 2045), RFC 2231 encoded, RFC 2231 with
+// continuations, RFC 2047 in the quoted value (common, not standard).
+func fileNameParam(tc hegel.TestCase, name string) string {
+	switch pick(tc, 0, 0, 0, 1, 2, 3, 4) {
+	case 1:
+		return "; filename*=" + pick(tc, "utf-8", "UTF-8") + "''" + pctEncode(name)
+	case 4:
+		// a split inside a multi-byte character: segments are concatenated
+		// before decoding (RFC 2231 4.1)
+		enc := pctEncode(name)
+		if len(enc) > 6 && enc[0] == '%' && enc[3] == '%' {
+			return "; filename*0*=utf-8''" + enc[:3] + "; filename*1*=" + enc[3:]
+		}
+		return "; filename=" + quoteParam(name)
+	case 2:
+		enc := pctEncode(name)
+		if len(enc) < 4 {
+			return "; filename=" + quoteParam(name)
+		}
+		cut := len(enc) / 2
+		// do not split a %XX escape (splitting between escapes, inside a
+		// multi-byte character, is allowed: segments are concatenated
+		// before decoding, RFC 2231 4.1)
+		for cut > 2 && (enc[cut-1] == '%' || enc[cut-2] == '%') {
+			cut--
+		}
+		return "; filename*0*=utf-8''" + enc[:cut] + "; filename*1*=" + enc[cut:]
+	case 3:
+		if isASCII(name) && len(name) > 2 {
+			cut := len(name) / 2
+			return "; filename*0=" + quoteParam(name[:cut]) + "; filename*1=" + quoteParam(name[cut:])
+		}
+		return "; filename=" + quoteParam(name)
+	}
+	return "; filename=" + quoteParam(name)
+}
+
+// pctEncode percent-encodes for an RFC 2231 extended value.
+func pctEncode(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c < 0x80 && (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '-' || c == '_') {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+// quoteParam writes a parameter value: a token as is, otherwise quoted.
+func quoteParam(v string) string {
+	if isASCII(v) && !strings.ContainsAny(v, " \"\\()<>@,;:/[]?=") && v != "" {
+		return v
+	}
+	return `"` + strings.ReplaceAll(strings.ReplaceAll(v, `\`, `\\`), `"`, `\"`) + `"`
+}
+
+// leaves lists the message's leaf parts in document order.
+func leaves(p *part) []*part {
+	if p.boundary == "" {
+		return []*part{p}
+	}
+	var out []*part
+	for _, c := range p.children {
+		out = append(out, leaves(c)...)
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Oracle: Python's email package in a child process.
+
+type pyPart struct {
+	CT             string `json:"ct"`
+	Charset        string `json:"charset"`
+	Disp           string `json:"disp"`
+	Filename       string `json:"filename"`
+	CTE            string `json:"cte"`
+	Content        string `json:"content"`
+	CharsetUnknown bool   `json:"charset_unknown"`
+}
+
+type pyReply struct {
+	Error   string      `json:"error"`
+	Subject *string     `json:"subject"`
+	From    [][2]string `json:"from"`
+	To      [][2]string `json:"to"`
+	Parts   []pyPart    `json:"parts"`
+	Defects []string    `json:"defects"`
+}
+
+type oracle struct {
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var py *oracle
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if py != nil {
+		py.in.Close()
+		py.cmd.Wait()
+	}
+	os.Exit(code)
+}
+
+func startOracle(t testing.TB) {
+	if py != nil {
+		return
+	}
+	wd, _ := os.Getwd()
+	cmd := exec.Command("python3", filepath.Join(wd, "oracle.py"))
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	py = &oracle{cmd, in, bufio.NewReaderSize(out, 1<<20)}
+}
+
+func (o *oracle) parse(msg string) pyReply {
+	if _, err := fmt.Fprintf(o.in, "%s\n", hex.EncodeToString([]byte(msg))); err != nil {
+		panic(fmt.Sprintf("oracle write: %v", err))
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("oracle read: %v", err))
+	}
+	var r pyReply
+	if err := json.Unmarshal(line, &r); err != nil {
+		panic(fmt.Sprintf("oracle json: %v: %s", err, line))
+	}
+	return r
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+var parser = enmime.NewParser(enmime.DisableCharacterDetection(true))
+
+// goLeaves lists the leaf parts of an enmime tree in document order.
+func goLeaves(p *enmime.Part) []*enmime.Part {
+	if p.FirstChild == nil {
+		return []*enmime.Part{p}
+	}
+	var out []*enmime.Part
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		out = append(out, goLeaves(c)...)
+	}
+	return out
+}
+
+// TestHegelReadMatchesPython: enmime's reading of a generated message (leaf
+// parts with their media type, charset, disposition, file name and decoded
+// content; the decoded Subject, From and To) is Python's.
+func TestHegelReadMatchesPython(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		m := genMessage(tc)
+		want := py.parse(m.text)
+		if want.Error != "" {
+			count("python rejects: " + firstWords(want.Error))
+			return
+		}
+		if id := known(m, want); id != "" {
+			count("known " + id)
+			return
+		}
+		env, err := parser.ReadEnvelope(strings.NewReader(m.text))
+		if err != nil {
+			fail(ht, "enmime rejects: %v\nmessage:\n%s", err, m.text)
+		}
+		exp := leaves(m.root)
+		got := goLeaves(env.Root)
+		if len(got) != len(want.Parts) || len(got) != len(exp) {
+			fail(ht, "enmime finds %d leaf parts, Python %d, generated %d\n%s\nmessage:\n%s", len(got), len(want.Parts), len(exp), showParts(got, want.Parts), m.text)
+		}
+		count(fmt.Sprintf("%d parts", len(exp)))
+		for i, g := range got {
+			w := want.Parts[i]
+			e := exp[i]
+			if e.noContentType || e.noHeaders {
+				// No Content-Type header: Python applies the text/plain
+				// default; enmime leaves the type empty on child parts (with
+				// a warning) and applies text/plain; charset=us-ascii on the
+				// root. Only the content is compared.
+				count("no Content-Type")
+			} else {
+				if !strings.EqualFold(g.ContentType, w.CT) {
+					fail(ht, "part %d: enmime type %q, Python %q\nmessage:\n%s", i, g.ContentType, w.CT, m.text)
+				}
+				if !strings.EqualFold(g.Charset, w.Charset) {
+					fail(ht, "part %d: enmime charset %q, Python %q\nmessage:\n%s", i, g.Charset, w.Charset, m.text)
+				}
+			}
+			if !strings.EqualFold(g.Disposition, w.Disp) {
+				fail(ht, "part %d: enmime disposition %q, Python %q\nmessage:\n%s", i, g.Disposition, w.Disp, m.text)
+			}
+			if g.FileName != w.Filename {
+				fail(ht, "part %d: enmime file name %q, Python %q (generated %q)\nmessage:\n%s", i, g.FileName, w.Filename, e.filename, m.text)
+			}
+			wc, _ := hex.DecodeString(w.Content)
+			if !bytes.Equal(g.Content, wc) {
+				fail(ht, "part %d (%s, %s, cte %s): enmime content %q, Python %q (generated %q)\nmessage:\n%s", i, g.ContentType, g.Charset, e.cte, g.Content, wc, e.content, m.text)
+			}
+		}
+		if want.Subject != nil {
+			if s := env.GetHeader("Subject"); s != *want.Subject {
+				fail(ht, "Subject: enmime %q, Python %q (generated %q)\nmessage:\n%s", s, *want.Subject, m.subject, m.text)
+			}
+		}
+		for _, h := range []struct {
+			name string
+			want [][2]string
+			gen  []address
+		}{{"From", want.From, m.from}, {"To", want.To, m.to}} {
+			list, err := env.AddressList(h.name)
+			if err != nil {
+				fail(ht, "%s: enmime AddressList: %v\nmessage:\n%s", h.name, err, m.text)
+			}
+			if len(list) != len(h.want) {
+				fail(ht, "%s: enmime %d addresses, Python %d\nmessage:\n%s", h.name, len(list), len(h.want), m.text)
+			}
+			for i, a := range list {
+				if a.Name != h.want[i][0] || a.Address != h.want[i][1] {
+					fail(ht, "%s[%d]: enmime %q <%s>, Python %q <%s> (generated %q <%s>)\nmessage:\n%s", h.name, i, a.Name, a.Address, h.want[i][0], h.want[i][1], h.gen[i].name, h.gen[i].addr, m.text)
+				}
+			}
+		}
+	})
+}
+
+func showParts(got []*enmime.Part, want []pyPart) string {
+	var b strings.Builder
+	for i, g := range got {
+		fmt.Fprintf(&b, "  enmime %d: %s %s %q\n", i, g.ContentType, g.Disposition, g.FileName)
+	}
+	for i, w := range want {
+		fmt.Fprintf(&b, "  python %d: %s %s %q\n", i, w.CT, w.Disp, w.Filename)
+	}
+	return b.String()
+}
+
+func firstWords(s string) string {
+	f := strings.Fields(s)
+	if len(f) > 4 {
+		f = f[:4]
+	}
+	return strings.Join(f, " ")
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..896b91a
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/jhillyerd/enmime/v2"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are Python's email package's reading and
+// the RFCs.
+
+func crlf(s string) string { return strings.ReplaceAll(s, "\n", "\r\n") }
+
+func read(t *testing.T, msg string) *enmime.Envelope {
+	t.Helper()
+	env, err := enmime.ReadEnvelope(strings.NewReader(msg))
+	if err != nil {
+		t.Fatalf("ReadEnvelope: %v", err)
+	}
+	return env
+}
+
+func lastChild(p *enmime.Part) *enmime.Part {
+	var last *enmime.Part
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		last = c
+	}
+	return last
+}
+
+// enmime/1: a part without a Content-Type header (text/plain by default,
+// RFC 2046 5.2) keeps its Content-Disposition and file name; enmime drops
+// them, so the attachment is neither in Envelope.Attachments nor named.
+func TestHegelPinDispositionWithoutContentType(t *testing.T) {
+	env := read(t, crlf(`From: a@example.com
+To: b@example.com
+Subject: notes
+MIME-Version: 1.0
+Content-Type: multipart/mixed; boundary="b1"
+
+--b1
+Content-Type: text/plain; charset=utf-8
+
+See the attached notes.
+--b1
+Content-Disposition: attachment; filename="notes.txt"
+
+line one
+line two
+--b1--
+`))
+	second := lastChild(env.Root)
+	if second == nil {
+		t.Fatal("no child parts")
+	}
+	if second.Disposition != "attachment" {
+		t.Errorf("Disposition of the part without Content-Type = %q, want %q (Python: attachment)", second.Disposition, "attachment")
+	}
+	if second.FileName != "notes.txt" {
+		t.Errorf("FileName of the part without Content-Type = %q, want %q", second.FileName, "notes.txt")
+	}
+	if len(env.Attachments) != 1 {
+		t.Errorf("Envelope.Attachments has %d parts, want 1", len(env.Attachments))
+	}
+}
+
+// enmime/2: an RFC 2231 file name in a charset other than UTF-8 is dropped,
+// and with continuations partly kept undecoded.
+func TestHegelPinRFC2231FileNameCharset(t *testing.T) {
+	head := "From: a@example.com\r\nTo: b@example.com\r\nSubject: s\r\nMIME-Version: 1.0\r\nContent-Type: application/pdf\r\n"
+	env := read(t, head+"Content-Disposition: attachment; filename*=iso-8859-1''r%E9sum%E9.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "résumé.pdf" {
+		t.Errorf("filename*=iso-8859-1''r%%E9sum%%E9.pdf: FileName %q, want %q (Python)", env.Root.FileName, "résumé.pdf")
+	}
+	env = read(t, head+"Content-Disposition: attachment; filename*0*=iso-8859-1''r%E9; filename*1*=sum%E9.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "résumé.pdf" {
+		t.Errorf("filename*0*=iso-8859-1''r%%E9; filename*1*=sum%%E9.pdf: FileName %q, want %q", env.Root.FileName, "résumé.pdf")
+	}
+	env = read(t, head+"Content-Disposition: attachment; filename*=windows-1252''%80.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "€.pdf" {
+		t.Errorf("filename*=windows-1252''%%80.pdf: FileName %q, want %q", env.Root.FileName, "€.pdf")
+	}
+}
+
+// enmime/3: a body line that begins with the boundary and continues with
+// text is not a delimiter (RFC 2046 5.1.1: only white space may follow);
+// enmime takes "--b1 extra" as one (and then fails on the next line as a
+// header) and "--b1--x" anywhere in a line as the terminator.
+func TestHegelPinBoundaryFollowedByText(t *testing.T) {
+	head := "From: a@example.com\r\nTo: b@example.com\r\nSubject: s\r\nMIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=b1\r\n\r\n"
+	msg := head + "--b1\r\nContent-Type: text/plain\r\n\r\none\r\n--b1 extra\r\nstill one\r\n--b1\r\nContent-Type: text/plain\r\n\r\ntwo\r\n--b1--\r\n"
+	env, err := enmime.ReadEnvelope(strings.NewReader(msg))
+	if err != nil {
+		t.Errorf("a body line \"--b1 extra\": ReadEnvelope fails: %v (Python: two parts, the first \"one\\r\\n--b1 extra\\r\\nstill one\")", err)
+	} else if c := env.Root.FirstChild; c == nil || string(c.Content) != "one\r\n--b1 extra\r\nstill one" {
+		t.Errorf("a body line \"--b1 extra\": first part %q", c.Content)
+	}
+	msg = head + "--b1\r\nContent-Type: text/plain\r\n\r\none\r\ntext --b1--x\r\nstill one\r\n--b1--\r\n"
+	env = read(t, msg)
+	if c := env.Root.FirstChild; c == nil || string(c.Content) != "one\r\ntext --b1--x\r\nstill one" {
+		t.Errorf("a body line \"text --b1--x\": first part %q, want %q", c.Content, "one\r\ntext --b1--x\r\nstill one")
+	}
+}
+
+// enmime/4: an encoded word with an RFC 2231 language tag
+// (=?utf-8*en?q?...?=, RFC 2231 5) is decoded like one without.
+func TestHegelPinEncodedWordLanguageTag(t *testing.T) {
+	env := read(t, "From: =?utf-8*en?q?Zo=C3=AB?= <a@example.com>\r\nSubject: =?utf-8*en?q?caf=C3=A9?=\r\n\r\nbody\r\n")
+	if s := env.GetHeader("Subject"); s != "café" {
+		t.Errorf("Subject =?utf-8*en?q?caf=C3=A9?= decodes to %q, want %q (Python)", s, "café")
+	}
+	from, err := env.AddressList("From")
+	if err != nil || len(from) != 1 || from[0].Name != "Zoë" {
+		t.Errorf("From =?utf-8*en?q?Zo=C3=AB?= <a@example.com>: %v, %v; want name %q", from, err, "Zoë")
+	}
+}
+
+// enmime/5: a comment before an address (CFWS, RFC 5322 3.4) makes the whole
+// address list unparseable.
+func TestHegelPinCommentBeforeAddress(t *testing.T) {
+	env := read(t, "From: a@example.com\r\nTo: (pre) d@example.org\r\nSubject: s\r\n\r\nbody\r\n")
+	to, err := env.AddressList("To")
+	if err != nil || len(to) != 1 || to[0].Address != "d@example.org" {
+		t.Errorf("To: (pre) d@example.org: %v, %v; want one address d@example.org (Python)", to, err)
+	}
+	env = read(t, "From: a@example.com\r\nTo: a@x.com, (c) b@x.com\r\nSubject: s\r\n\r\nbody\r\n")
+	to, err = env.AddressList("To")
+	if err != nil || len(to) != 2 {
+		t.Errorf("To: a@x.com, (c) b@x.com: %v, %v; want two addresses", to, err)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..0f3cc43
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,134 @@
+package hegel
+
+// Hegel property tests for enmime: generated MIME messages, read by this
+// package and by Python's email package, must give the same headers, parts
+// and decoded contents; messages built by each must be read by the other.
+//
+// Needs python3.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
