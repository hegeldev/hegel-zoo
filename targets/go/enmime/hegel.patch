+"""Oracle for the zoo's enmime tests: Python's email package, one request per
+line on stdin. Request: the message as hex. Reply: one JSON object per line:
+
+  {"subject": str, "from": [[name, addr], ...], "to": [...],
+   "parts": [{"ct": str, "charset": str, "disp": str, "filename": str,
+              "content": hex, "cte": str}, ...],
+   "defects": [str, ...]}
+
+or {"error": str}. Parts are the leaves of the MIME tree in document order;
+text parts' contents are decoded with the declared charset and re-encoded as
+UTF-8 (as enmime does), others are the transfer-decoded bytes.
+"""
+import binascii
+import json
+import sys
+from email import message_from_bytes, policy
+
+
+def addresses(msg, name):
+    h = msg.get(name)
+    if h is None:
+        return None
+    out = []
+    for a in getattr(h, "addresses", ()):
+        out.append([a.display_name, a.username + "@" + a.domain])
+    return out
+
+
+def part_info(p):
+    info = {
+        "ct": p.get_content_type(),
+        "charset": p.get_content_charset() or "",
+        "disp": p.get_content_disposition() or "",
+        "filename": p.get_filename() or "",
+        "cte": (p.get("Content-Transfer-Encoding") or "").strip().lower(),
+    }
+    payload = p.get_payload(decode=True)
+    if payload is None:
+        payload = b""
+    if p.get_content_maintype() == "text":
+        cs = p.get_content_charset()
+        if cs:
+            try:
+                payload = payload.decode(cs, errors="replace").encode("utf-8")
+            except LookupError:
+                info["charset_unknown"] = True
+    info["content"] = binascii.hexlify(payload).decode("ascii")
+    return info
+
+
+def handle(data):
+    msg = message_from_bytes(data, policy=policy.default)
+    parts = []
+    for p in msg.walk():
+        if p.is_multipart():
+            continue
+        parts.append(part_info(p))
+    defects = [type(d).__name__ for d in msg.defects]
+    for p in msg.walk():
+        if p is not msg:
+            defects.extend(type(d).__name__ for d in p.defects)
+    subject = msg.get("Subject")
+    return {
+        "subject": str(subject) if subject is not None else None,
+        "from": addresses(msg, "From"),
+        "to": addresses(msg, "To"),
+        "parts": parts,
+        "defects": defects,
+    }
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            data = binascii.unhexlify(line)
+            reply = handle(data)
+        except Exception as e:  # noqa: BLE001
+            reply = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(reply, ensure_ascii=True) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
