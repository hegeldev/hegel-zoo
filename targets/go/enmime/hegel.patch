+package hegel
+
+import "os"
+
+// Gates for the recorded bugs (bugs.toml). A case that has a known bug's
+// shape is counted, not judged. HEGEL_NO_KNOWN=1 disables the gates.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// known returns the id of a recorded bug whose shape the message has, or "".
+func known(m message, want pyReply) string {
+	if noKnown {
+		return ""
+	}
+	for _, e := range leaves(m.root) {
+		if e.noContentType && e.disp != "" {
+			return "enmime/1"
+		}
+		if e.fileName2231Charset {
+			return "enmime/2"
+		}
+		if e.boundaryLikeLine {
+			return "enmime/3"
+		}
+	}
+	if m.languageTag {
+		return "enmime/4"
+	}
+	if m.commentBefore {
+		return "enmime/5"
+	}
+	return ""
+}
