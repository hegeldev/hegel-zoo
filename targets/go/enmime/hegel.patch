+// Package hegel holds the zoo's Hegel property tests for enmime. See the
+// target's README.
+package hegel
diff --git a/hegel/hegel_build_test.go b/hegel/hegel_build_test.go
new file mode 100644
index 0000000..6362a70
--- /dev/null
+++ b/hegel/hegel_build_test.go
@@ -0,0 +1,206 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/jhillyerd/enmime/v2"
+	"hegel.dev/go/hegel"
+)
+
+// A built message's expected leaves.
+type leaf struct {
+	ct, filename string
+	content      []byte
+}
+
+func (l leaf) key() string {
+	return l.ct + "\x00" + l.filename + "\x00" + hex.EncodeToString(l.content)
+}
+
+func sortLeaves(ls []leaf) {
+	sort.Slice(ls, func(i, j int) bool { return ls[i].key() < ls[j].key() })
+}
+
+func showLeaves(ls []leaf) string {
+	var b strings.Builder
+	for _, l := range ls {
+		fmt.Fprintf(&b, "  %s %q %q\n", l.ct, l.filename, l.content)
+	}
+	return b.String()
+}
+
+// attachment is a part added to the Builder: its media type, content of
+// the type's kind, file name, and whether it is added inline (three times
+// in ten; only when the message has an HTML part, else as an attachment).
+type attachment struct {
+	ctype, name, content string
+	inline               bool
+}
+
+var (
+	attachmentTypes = hegel.SampledFrom([]string{"application/octet-stream", "application/pdf", "image/gif", "text/plain", "text/csv"})
+	textPool        = hegel.SampledFrom(texts)
+	attachments     = hegel.Composite(func(tc hegel.TestCase) attachment {
+		a := attachment{ctype: hegel.Draw(tc, attachmentTypes)}
+		contents := binaryPool
+		if strings.HasPrefix(a.ctype, "text/") {
+			contents = textPool
+		}
+		a.content = hegel.Draw(tc, contents)
+		a.name = hegel.Draw(tc, fileNamePool)
+		a.inline = hegel.Draw(tc, chance(30))
+		return a
+	})
+)
+
+// buildCase: a Subject of one to nine words, From, one to three To, a text
+// part four times in five (an empty text becomes "x"), an HTML part half of
+// the time (a text "body" when neither), and up to three attachments.
+type buildCase struct {
+	subject     string
+	from        address
+	tos         []address
+	text        *string
+	html        *string
+	attachments []attachment
+}
+
+var buildCases = hegel.Composite(func(tc hegel.TestCase) buildCase {
+	return buildCase{
+		subject:     hegel.Draw(tc, subjects),
+		from:        hegel.Draw(tc, mailboxes),
+		tos:         hegel.Draw(tc, many(mailboxes, 1, 3)),
+		text:        hegel.Draw(tc, optional(80, textPool)),
+		html:        hegel.Draw(tc, optional(50, textPool)),
+		attachments: hegel.Draw(tc, many(attachments, 0, 3)),
+	}
+})
+
+// build feeds the case to the Builder and returns it with the leaves,
+// text and HTML the message is expected to read back as.
+func (c buildCase) build() (bld enmime.MailBuilder, want []leaf, text, html string) {
+	bld = enmime.Builder().From(c.from.name, c.from.addr).Subject(c.subject)
+	for _, a := range c.tos {
+		bld = bld.To(a.name, a.addr)
+	}
+	if c.text != nil {
+		text = *c.text
+		if text == "" {
+			text = "x"
+		}
+	}
+	if c.html != nil {
+		html = "<p>" + *c.html + "</p>"
+	}
+	if text == "" && html == "" {
+		text = "body"
+	}
+	if text != "" {
+		bld = bld.Text([]byte(text))
+		want = append(want, leaf{"text/plain", "", []byte(text)})
+	}
+	if html != "" {
+		bld = bld.HTML([]byte(html))
+		want = append(want, leaf{"text/html", "", []byte(html)})
+	}
+	for i, a := range c.attachments {
+		content := []byte(a.content)
+		if a.inline && html != "" {
+			bld = bld.AddInline(content, a.ctype, a.name, fmt.Sprintf("cid%d", i))
+		} else {
+			bld = bld.AddAttachment(content, a.ctype, a.name)
+		}
+		want = append(want, leaf{a.ctype, a.name, content})
+	}
+	return bld, want, text, html
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c buildCase) GoString() string {
+	_, want, text, html := c.build()
+	tos := make([]string, len(c.tos))
+	for i, a := range c.tos {
+		tos[i] = fmt.Sprintf("%q <%s>", a.name, a.addr)
+	}
+	return fmt.Sprintf("subject %q from %q <%s> to %s text %q html %q leaves:\n%s", c.subject, c.from.name, c.from.addr, strings.Join(tos, ", "), text, html, showLeaves(want))
+}
+
+// TestHegelBuildReadByPython: a message built with Builder and written with
+// Encode is read by Python (and by enmime itself) with the given subject,
+// addresses, text, HTML and attachments.
+func TestHegelBuildReadByPython(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, buildCases)
+		bld, want, text, html := c.build()
+		subject, from, tos := c.subject, c.from, c.tos
+		root, err := bld.Build()
+		if err != nil {
+			fail(ht, "Build: %v", err)
+		}
+		var buf bytes.Buffer
+		if err := root.Encode(&buf); err != nil {
+			fail(ht, "Encode: %v", err)
+		}
+		msg := buf.String()
+		count(fmt.Sprintf("%d leaves", len(want)))
+
+		// Python's reading.
+		py := py.parse(msg)
+		if py.Error != "" {
+			fail(ht, "Python rejects the built message: %s\nmessage:\n%s", py.Error, msg)
+		}
+		var got []leaf
+		for _, p := range py.Parts {
+			c, _ := hex.DecodeString(p.Content)
+			got = append(got, leaf{p.CT, p.Filename, c})
+		}
+		sortLeaves(want)
+		sortLeaves(got)
+		if len(got) != len(want) || showLeaves(got) != showLeaves(want) {
+			fail(ht, "Python reads the built message differently\nwant:\n%sgot:\n%smessage:\n%s", showLeaves(want), showLeaves(got), msg)
+		}
+		if py.Subject == nil || *py.Subject != subject {
+			fail(ht, "Python reads Subject %v, built %q\nmessage:\n%s", py.Subject, subject, msg)
+		}
+		if len(py.From) != 1 || py.From[0][0] != from.name || py.From[0][1] != from.addr {
+			fail(ht, "Python reads From %v, built %q <%s>\nmessage:\n%s", py.From, from.name, from.addr, msg)
+		}
+		if len(py.To) != len(tos) {
+			fail(ht, "Python reads %d To addresses, built %d\nmessage:\n%s", len(py.To), len(tos), msg)
+		}
+		for i, a := range tos {
+			if py.To[i][0] != a.name || py.To[i][1] != a.addr {
+				fail(ht, "Python reads To[%d] %q <%s>, built %q <%s>\nmessage:\n%s", i, py.To[i][0], py.To[i][1], a.name, a.addr, msg)
+			}
+		}
+
+		// enmime's own reading.
+		env, err := parser.ReadEnvelope(strings.NewReader(msg))
+		if err != nil {
+			fail(ht, "enmime rejects its own message: %v\nmessage:\n%s", err, msg)
+		}
+		if env.GetHeader("Subject") != subject {
+			fail(ht, "enmime reads back Subject %q, built %q\nmessage:\n%s", env.GetHeader("Subject"), subject, msg)
+		}
+		textParts := false
+		for _, l := range want {
+			if l.filename != "" && strings.HasPrefix(l.ct, "text/") {
+				textParts = true // Envelope.Text gathers inline text parts too, by design
+			}
+		}
+		if !textParts {
+			if env.Text != text && !(text == "" && env.Text != "") { // text derived from HTML when absent
+				fail(ht, "enmime reads back Text %q, built %q\nmessage:\n%s", env.Text, text, msg)
+			}
+			if env.HTML != html {
+				fail(ht, "enmime reads back HTML %q, built %q\nmessage:\n%s", env.HTML, html, msg)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_mime_test.go b/hegel/hegel_mime_test.go
new file mode 100644
index 0000000..e6466d7
--- /dev/null
+++ b/hegel/hegel_mime_test.go
@@ -0,0 +1,1174 @@
+package hegel
+
+// A message is drawn as a small tree of records: its header fields with the
+// styles they are written in (an address with its quoting and encoding, the
+// Subject's encoding, the To list's separator, comment and group), and a
+// part tree whose leaves and multiparts carry a style record for every
+// spelling a MIME writer is free in (the case of tokens, parameter quoting
+// and folding, the file name parameter's form, base64 line width and
+// padding, preamble and epilogue, ...). fitted and render are pure functions
+// of the tree, so a shrunk failure is a small tree. The shapes of the
+// recorded bugs are drawn at their natural rate (a disposition on a child
+// part without Content-Type, an ISO-8859-1 RFC 2231 file name, a body line
+// starting with the boundary, a language tag in the Subject's encoded word,
+// a comment before an address) and named by knownShape when a case fails;
+// under HEGEL_NO_KNOWN=1 the generators leave them out (shaped).
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime"
+	"mime/quotedprintable"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/jhillyerd/enmime/v2"
+	"golang.org/x/text/encoding/charmap"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Pools.
+
+// texts is the alphabet of text contents: ASCII, Latin-1, wider Unicode,
+// lines, trailing spaces, dots and dashes at line starts (boundary-like),
+// long lines, and characters special to quoted-printable.
+var texts = []string{
+	"", "hello", "Hello, world!\r\n", "line one\r\nline two\r\n", "no final newline",
+	"caf\u00e9", "na\u00efve fa\u00e7ade", "\u65e5\u672c\u8a9e", "emoji \U0001F600 here", "a=b = c==\r\n",
+	"trailing space \r\ntab\t\r\n", ".\r\n..\r\n", "--\r\n--not-a-boundary\r\n",
+	strings.Repeat("0123456789", 10), "From here\r\n", "=?utf-8?q?not_encoded?=",
+	"\r\n\r\nblank first\r\n", "   leading spaces",
+}
+
+// asciiTexts are the texts that are pure ASCII.
+var asciiTexts = func() []string {
+	var out []string
+	for _, t := range texts {
+		if isASCII(t) {
+			out = append(out, t)
+		}
+	}
+	return out
+}()
+
+// latin1Texts are the texts representable in ISO-8859-1.
+var latin1Texts = func() []string {
+	var out []string
+	for _, t := range texts {
+		if latin1Encodable(t) {
+			out = append(out, t)
+		}
+	}
+	return out
+}()
+
+// cp1252Texts use the 0x80-0x9F range of Windows-1252 (not Latin-1).
+var cp1252Texts = []string{"smart \u201cquotes\u201d", "price \u20ac5", "dash \u2014 here\r\n", "\u2026"}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+func latin1Encodable(s string) bool {
+	_, err := charmap.ISO8859_1.NewEncoder().String(s)
+	return err == nil
+}
+
+// words are header phrases: plain, needing quoting, non-ASCII.
+var words = []string{"Alice", "Bob Smith", "O'Brien", "Zo\u00eb", "J\u00fcrgen M\u00fcller", "\u5c71\u7530 \u592a\u90ce", "a (comment)", "x, y", "Dr. Who", "=?foo?="}
+
+var addrs = []string{"alice@example.com", "bob.smith@example.org", "x+tag@sub.example.net", "\"quoted local\"@example.com", "a@[127.0.0.1]"}
+
+var binaries = []string{"", "\x00\x01\x02\xff\xfe", "GIF89a\x00\x00", "%PDF-1.4\n%\xe2\xe3\xcf\xd3\n", "\xff\xd8\xff\xe0JFIF"}
+
+var fileNames = []string{"a.txt", "report.pdf", "my file.txt", "r\u00e9sum\u00e9.pdf", "\u65e5\u672c.txt", "semi;colon.txt", "quo\"te.txt", "x", "a\\b.txt"}
+
+var boundaries = []string{"b1", "----=_Part_0_123.456", "=-=-=", "boundary with space", "b'q", "abc:def", "b.1-2_3", "0"}
+
+var (
+	wordPool     = hegel.SampledFrom(words)
+	addrPool     = hegel.SampledFrom(addrs)
+	fileNamePool = hegel.SampledFrom(fileNames)
+	boundaryPool = hegel.SampledFrom(boundaries)
+	asciiPool    = hegel.SampledFrom(asciiTexts)
+	// subjects: one to nine words.
+	subjects = joined(many(wordPool, 1, 9), " ")
+)
+
+// ---------------------------------------------------------------------------
+// Header words and addresses.
+
+// spelling is how a case-insensitive token (a media type, an encoding, a
+// disposition) is written: as is, three times in five, in upper case, or
+// capitalised.
+type spelling int
+
+const (
+	asIs spelling = iota
+	upperCase
+	capitalised
+)
+
+var spellings = hegel.SampledFrom([]spelling{asIs, asIs, asIs, upperCase, capitalised})
+
+func (s spelling) of(tok string) string {
+	switch s {
+	case upperCase:
+		return strings.ToUpper(tok)
+	case capitalised:
+		return strings.ToUpper(tok[:1]) + tok[1:]
+	}
+	return tok
+}
+
+// encStyle is how a non-ASCII header word is written as an RFC 2047
+// encoded word: the charset (ISO-8859-1 falls back to UTF-8 when the word
+// does not fit), Q or B, and for the Subject one time in ten an RFC 2231
+// language tag (=?utf-8*en?q?...?=, RFC 2231 5; the shape of enmime/4, left
+// out under HEGEL_NO_KNOWN=1). An ASCII word is written as it is.
+type encStyle struct {
+	charset string
+	b       bool
+	lang    *string
+}
+
+var (
+	charsetNames  = hegel.SampledFrom([]string{"utf-8", "UTF-8", "iso-8859-1"})
+	langTags      = hegel.SampledFrom([]string{"en", "fr-CA", ""})
+	nameEncodings = hegel.Composite(func(tc hegel.TestCase) encStyle {
+		return encStyle{charset: hegel.Draw(tc, charsetNames), b: hegel.Draw(tc, chance(50))}
+	})
+	subjectEncodings = hegel.Composite(func(tc hegel.TestCase) encStyle {
+		e := hegel.Draw(tc, nameEncodings)
+		e.lang = hegel.Draw(tc, shaped(optional(10, langTags), hegel.Just[*string](nil)))
+		return e
+	})
+)
+
+// encode writes s as an encoded word (Go's encoder writes an ASCII word as
+// it is and splits a long one into several words); the language tag goes
+// into the first word.
+func (e encStyle) encode(s string) string {
+	cs := e.charset
+	if strings.EqualFold(cs, "iso-8859-1") {
+		if l1, err := charmap.ISO8859_1.NewEncoder().String(s); err == nil {
+			s = l1
+		} else {
+			cs = "utf-8"
+		}
+	}
+	enc := mime.QEncoding
+	if e.b {
+		enc = mime.BEncoding
+	}
+	out := enc.Encode(cs, s)
+	if e.lang != nil && strings.HasPrefix(out, "=?") {
+		i := strings.Index(out[2:], "?") + 2
+		out = out[:i] + "*" + *e.lang + out[i:]
+	}
+	return out
+}
+
+// tagged reports whether encoding s writes a language tag (s is encoded at
+// all only when it is not ASCII).
+func (e encStyle) tagged(s string) bool { return e.lang != nil && !isASCII(s) }
+
+// address is a mailbox: a display name (absent three times in ten) and an
+// address, with the style it is written in: a bare address in angle
+// brackets three times in ten, a plain ASCII name quoted anyway three times
+// in ten, a non-ASCII name as an encoded word.
+type address struct {
+	name, addr string
+	angled     bool
+	quoted     bool
+	enc        encStyle
+}
+
+var (
+	// mailboxes: an address without a style (the Builder takes name and
+	// address only).
+	mailboxes = hegel.Composite(func(tc hegel.TestCase) address {
+		return address{name: hegel.Draw(tc, maybe(70, wordPool)), addr: hegel.Draw(tc, addrPool)}
+	})
+	addresses = hegel.Composite(func(tc hegel.TestCase) address {
+		a := hegel.Draw(tc, mailboxes)
+		a.angled = hegel.Draw(tc, chance(30))
+		a.quoted = hegel.Draw(tc, chance(30))
+		a.enc = hegel.Draw(tc, nameEncodings)
+		return a
+	})
+)
+
+// written is the address the way a mail client writes it, quoting a display
+// name with specials or encoding a non-ASCII one.
+func (a address) written() string {
+	if a.name == "" {
+		if a.angled {
+			return "<" + a.addr + ">"
+		}
+		return a.addr
+	}
+	name := a.name
+	if !isASCII(name) {
+		name = a.enc.encode(name)
+	} else if strings.ContainsAny(name, "(),.:;<>@[]\"\\") || a.quoted {
+		name = quoted(name)
+	}
+	return name + " <" + a.addr + ">"
+}
+
+func quoted(s string) string {
+	return `"` + strings.ReplaceAll(strings.ReplaceAll(s, `\`, `\\`), `"`, `\"`) + `"`
+}
+
+// comment is an RFC 5322 comment written before the at-th address of the To
+// list (modulo their number): the shape of enmime/5.
+type comment struct {
+	text string
+	at   int
+}
+
+// toStyle is how the To list is written: the separator between addresses,
+// a comment before one of them one time in ten (none under
+// HEGEL_NO_KNOWN=1), and one time in ten the list as a group.
+type toStyle struct {
+	sep     string
+	comment *comment
+	group   string
+}
+
+var (
+	listSeps   = hegel.SampledFrom([]string{", ", ",\r\n ", ","})
+	groupNames = hegel.SampledFrom([]string{"Team", "\"The Team\"", "undisclosed"})
+	comments   = hegel.Composite(func(tc hegel.TestCase) *comment {
+		return &comment{text: hegel.Draw(tc, hegel.SampledFrom([]string{"(comment) ", "(a (nested) one) "})), at: hegel.Draw(tc, positions)}
+	})
+	toStyles = hegel.Composite(func(tc hegel.TestCase) toStyle {
+		return toStyle{
+			sep:     hegel.Draw(tc, listSeps),
+			comment: hegel.Draw(tc, shaped(maybe(10, comments), hegel.Just[*comment](nil))),
+			group:   hegel.Draw(tc, maybe(10, groupNames)),
+		}
+	})
+)
+
+// line writes the To header's value.
+func (st toStyle) line(tos []address) string {
+	ws := make([]string, len(tos))
+	for i, a := range tos {
+		ws[i] = a.written()
+	}
+	if st.comment != nil {
+		i := st.comment.at % len(ws)
+		ws[i] = st.comment.text + ws[i]
+	}
+	line := strings.Join(ws, st.sep)
+	if st.group != "" {
+		line = st.group + ": " + line + ";"
+	}
+	return line
+}
+
+// ---------------------------------------------------------------------------
+// Parts.
+
+// part is a MIME part: a leaf with content, or a multipart with a boundary
+// and children. content is the decoded content (text: UTF-8; other: bytes).
+type part struct {
+	ctype    string // media type
+	charset  string // for text parts, "" for none
+	cte      string // 7bit, 8bit, quoted-printable, base64, "" for none
+	disp     string // "", attachment, inline
+	filename string
+	content  string
+	boundary string
+	children []*part
+
+	noContentType bool // no Content-Type header: text/plain by default
+	noHeaders     bool // no headers at all (a child part): text/plain by default
+
+	style leafStyle  // a leaf's spellings
+	multi multiStyle // a multipart's spellings
+
+	// set by fitted
+	child            bool // not the root part
+	boundaryLikeLine bool // a content line starting with the parent's boundary and more text
+}
+
+// boundaryLine is a body line that begins with the parent's boundary but is
+// not a delimiter (RFC 2046 5.1.1: a delimiter is followed only by white
+// space): the boundary, a suffix, and "text " before it three times in ten.
+// A suffix that is white space then text, or "--" then text, is the shape of
+// enmime/3 (taken as a delimiter or the terminator); "-" and "x" are body
+// text to both parsers, and the only suffixes under HEGEL_NO_KNOWN=1.
+type boundaryLine struct {
+	suffix   string
+	prefixed bool
+}
+
+// bug reports whether the line is one enmime misreads (the shape of enmime/3).
+func (b boundaryLine) bug() bool {
+	return b.suffix[0] == ' ' || b.suffix[0] == '\t' || strings.HasPrefix(b.suffix, "--")
+}
+
+var (
+	bugSuffixes      = []string{" extra", "\textra", "--x"}
+	harmlessSuffixes = []string{"-", "x"}
+	lineSuffixes     = hegel.SampledFrom(shaped(append(append([]string{}, bugSuffixes...), harmlessSuffixes...), harmlessSuffixes))
+	boundaryLines    = hegel.Composite(func(tc hegel.TestCase) *boundaryLine {
+		return &boundaryLine{suffix: hegel.Draw(tc, lineSuffixes), prefixed: hegel.Draw(tc, chance(30))}
+	})
+)
+
+// latin1Param is the file name written as an RFC 2231 extended value in
+// ISO-8859-1 (filename*=iso-8859-1'en'r%E9sum%E9.pdf): the charset's
+// spelling and the language. The shape of enmime/2; none under
+// HEGEL_NO_KNOWN=1.
+type latin1Param struct {
+	charset string
+	lang    string
+}
+
+// fileParamStyle is how the filename parameter of Content-Disposition is
+// written: kind 0 quoted (RFC 2045), 1 RFC 2231 encoded (utf-8 or UTF-8),
+// 2 RFC 2231 with continuations, 3 continuations of quoted ASCII halves,
+// 4 a continuation split inside a multi-byte character; when latin1 is set
+// and the name is non-ASCII and fits ISO-8859-1, in that charset instead.
+type fileParamStyle struct {
+	kind      int
+	upperUTF8 bool
+	latin1    *latin1Param
+}
+
+var (
+	fileParamKinds = hegel.SampledFrom([]int{0, 0, 0, 1, 2, 3, 4})
+	latin1Params   = hegel.Composite(func(tc hegel.TestCase) *latin1Param {
+		return &latin1Param{
+			charset: hegel.Draw(tc, hegel.SampledFrom([]string{"iso-8859-1", "ISO-8859-1"})),
+			lang:    hegel.Draw(tc, hegel.SampledFrom([]string{"", "en"})),
+		}
+	})
+	fileParamStyles = hegel.Composite(func(tc hegel.TestCase) fileParamStyle {
+		return fileParamStyle{
+			kind:      hegel.Draw(tc, fileParamKinds),
+			upperUTF8: hegel.Draw(tc, chance(50)),
+			latin1:    hegel.Draw(tc, shaped(maybe(10, latin1Params), hegel.Just[*latin1Param](nil))),
+		}
+	})
+)
+
+// leafStyle is the spellings of a leaf part.
+type leafStyle struct {
+	ctCase        spelling
+	charsetQuoted bool   // the charset value quoted, three times in ten
+	charsetSep    string // the charset parameter's separator and spelling
+	nameParam     bool   // the file name as a name parameter of Content-Type too, three times in ten
+	cteCase       spelling
+	dispCase      spelling
+	fileParam     fileParamStyle
+	extra         bool // an X-Extra header, one time in ten
+	b64Unpadded   bool // base64 without padding, one time in ten
+	b64Width      int  // base64 line width
+	qpLowerHex    bool // quoted-printable escapes in lower-case hex, one time in five
+	finalEOL      bool // a line end after content that already ends with one, half of the time
+	bLine         *boundaryLine
+}
+
+var (
+	charsetSeps = hegel.SampledFrom([]string{"; charset=", ";charset=", "; CHARSET=", ";\r\n\tcharset="})
+	b64Widths   = hegel.SampledFrom([]int{76, 76, 60, 4, 1000})
+	leafStyles  = hegel.Composite(func(tc hegel.TestCase) leafStyle {
+		return leafStyle{
+			ctCase:        hegel.Draw(tc, spellings),
+			charsetQuoted: hegel.Draw(tc, chance(30)),
+			charsetSep:    hegel.Draw(tc, charsetSeps),
+			nameParam:     hegel.Draw(tc, chance(30)),
+			cteCase:       hegel.Draw(tc, spellings),
+			dispCase:      hegel.Draw(tc, spellings),
+			fileParam:     hegel.Draw(tc, fileParamStyles),
+			extra:         hegel.Draw(tc, chance(10)),
+			b64Unpadded:   hegel.Draw(tc, chance(10)),
+			b64Width:      hegel.Draw(tc, b64Widths),
+			qpLowerHex:    hegel.Draw(tc, chance(20)),
+			finalEOL:      hegel.Draw(tc, chance(50)),
+			bLine:         hegel.Draw(tc, maybe(8, boundaryLines)),
+		}
+	})
+)
+
+// multiStyle is the spellings of a multipart.
+type multiStyle struct {
+	ctCase   spelling
+	bQuoted  bool   // the boundary quoted though it needs no quoting, one time in five
+	bSep     string // the boundary parameter's separator and spelling
+	extra    bool   // an X-Extra header, one time in ten
+	preamble bool   // three times in ten
+	blank    bool   // a blank line after the preamble, one time in ten
+	trail    string // white space after the boundary lines
+	epilogue bool   // three times in ten
+}
+
+var (
+	boundarySeps = hegel.SampledFrom([]string{"; boundary=", ";boundary=", "; Boundary=", ";\r\n boundary="})
+	trails       = hegel.SampledFrom([]string{"", "", "  ", "\t"})
+	multiStyles  = hegel.Composite(func(tc hegel.TestCase) multiStyle {
+		return multiStyle{
+			ctCase:   hegel.Draw(tc, spellings),
+			bQuoted:  hegel.Draw(tc, chance(20)),
+			bSep:     hegel.Draw(tc, boundarySeps),
+			extra:    hegel.Draw(tc, chance(10)),
+			preamble: hegel.Draw(tc, chance(30)),
+			blank:    hegel.Draw(tc, chance(10)),
+			trail:    hegel.Draw(tc, trails),
+			epilogue: hegel.Draw(tc, chance(30)),
+		}
+	})
+)
+
+// charsetEncoder returns the encoder for a single-byte charset name, nil for
+// UTF-8, ASCII or unknown.
+func charsetEncoder(cs string) *charmap.Charmap {
+	switch strings.ToLower(cs) {
+	case "iso-8859-1", "latin1":
+		return charmap.ISO8859_1
+	case "windows-1252":
+		return charmap.Windows1252
+	}
+	return nil
+}
+
+// contentsFor: the text contents a charset can carry: ASCII for none,
+// us-ascii and ascii; Latin-1 for ISO-8859-1; Latin-1 and the Windows-1252
+// range for windows-1252; everything for UTF-8.
+var contentsFor = func() map[string]hegel.Generator[string] {
+	latin1 := hegel.SampledFrom(latin1Texts)
+	m := map[string]hegel.Generator[string]{
+		"":             asciiPool,
+		"us-ascii":     asciiPool,
+		"ascii":        asciiPool,
+		"utf-8":        hegel.SampledFrom(texts),
+		"UTF-8":        hegel.SampledFrom(texts),
+		"utf8":         hegel.SampledFrom(texts),
+		"iso-8859-1":   latin1,
+		"ISO-8859-1":   latin1,
+		"latin1":       latin1,
+		"windows-1252": hegel.SampledFrom(append(append([]string{}, latin1Texts...), cp1252Texts...)),
+	}
+	return m
+}()
+
+var (
+	textTypes = hegel.SampledFrom([]string{"text/plain", "text/plain", "text/html", "text/csv"})
+	// charsets: none first, then the UTF-8, ISO-8859-1, Windows-1252 and
+	// ASCII spellings.
+	charsets = hegel.SampledFrom([]string{"", "utf-8", "utf-8", "UTF-8", "utf8", "iso-8859-1", "ISO-8859-1", "latin1", "windows-1252", "us-ascii", "ascii"})
+	// ctes: the encodings of ASCII content in a declared charset; ctes8bit
+	// those of non-ASCII content; ctesBare those of content without a
+	// charset (8bit and quoted-printable half as often, base64 twice).
+	ctes         = hegel.SampledFrom([]string{"", "7bit", "8bit", "quoted-printable", "base64"})
+	ctes8bit     = hegel.SampledFrom([]string{"8bit", "quoted-printable", "base64"})
+	ctesBare     = hegel.SampledFrom([]string{"", "", "7bit", "7bit", "8bit", "quoted-printable", "base64", "base64", "base64", "base64"})
+	dispositions = hegel.SampledFrom([]string{"attachment", "inline"})
+	// missingContentType: a text part without a charset has no Content-Type
+	// header three times in ten; with a disposition that is the shape of
+	// enmime/1 (on a child part), so under HEGEL_NO_KNOWN=1 a part with a
+	// disposition keeps its Content-Type. Indexed by "has a disposition".
+	missingContentType = [2]hegel.Generator[bool]{chance(30), shaped(chance(30), hegel.Just(false))}
+)
+
+// ctesFor: the encodings that fit the content.
+func ctesFor(charset, content string) hegel.Generator[string] {
+	switch {
+	case charset == "":
+		return ctesBare
+	case !isASCII(content):
+		return ctes8bit
+	}
+	return ctes
+}
+
+func boolIndex(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// textLeaves: a text part (plain twice, html, csv) in a charset, with
+// content the charset carries, an encoding that fits, a disposition one
+// time in four (with a file name seven times in ten), no Content-Type header
+// three times in ten when it has no charset, and no headers at all two
+// times in five where that fits (fitted).
+var textLeaves = hegel.Composite(func(tc hegel.TestCase) *part {
+	p := &part{ctype: hegel.Draw(tc, textTypes), charset: hegel.Draw(tc, charsets)}
+	p.content = hegel.Draw(tc, contentsFor[p.charset])
+	p.cte = hegel.Draw(tc, ctesFor(p.charset, p.content))
+	p.disp = hegel.Draw(tc, maybe(25, dispositions))
+	if p.disp != "" {
+		p.filename = hegel.Draw(tc, maybe(70, fileNamePool))
+	}
+	if p.charset == "" {
+		p.noContentType = hegel.Draw(tc, missingContentType[boolIndex(p.disp != "")])
+	}
+	if p.noContentType {
+		p.ctype = "text/plain" // the default
+	}
+	p.noHeaders = hegel.Draw(tc, chance(40))
+	p.style = hegel.Draw(tc, leafStyles)
+	return p
+})
+
+var (
+	binaryTypes = hegel.SampledFrom([]string{"application/octet-stream", "application/pdf", "image/gif", "image/jpeg"})
+	binaryPool  = hegel.SampledFrom(binaries)
+	// binaryCTEs: base64 twice, quoted-printable once; for ASCII content
+	// without a NUL, base64 or 7bit.
+	binaryCTEs      = hegel.SampledFrom([]string{"base64", "base64", "quoted-printable"})
+	plainBinaryCTEs = hegel.SampledFrom([]string{"base64", "7bit"})
+	binaryDisps     = hegel.SampledFrom([]string{"", "attachment", "attachment", "inline"})
+)
+
+// binaryLeaves: a binary part with a disposition three times in four and a
+// file name four times in five.
+var binaryLeaves = hegel.Composite(func(tc hegel.TestCase) *part {
+	p := &part{ctype: hegel.Draw(tc, binaryTypes), content: hegel.Draw(tc, binaryPool)}
+	ctes := binaryCTEs
+	if isASCII(p.content) && !strings.Contains(p.content, "\x00") {
+		ctes = plainBinaryCTEs
+	}
+	p.cte = hegel.Draw(tc, ctes)
+	p.disp = hegel.Draw(tc, binaryDisps)
+	p.filename = hegel.Draw(tc, maybe(80, fileNamePool))
+	p.style = hegel.Draw(tc, leafStyles)
+	return p
+})
+
+var (
+	otherTypes = hegel.SampledFrom([]string{"application/json", "text/calendar", "application/x-unknown"})
+	otherCTEs  = hegel.SampledFrom([]string{"", "7bit", "base64"})
+)
+
+// otherLeaves: an application or calendar part with ASCII content.
+var otherLeaves = hegel.Composite(func(tc hegel.TestCase) *part {
+	p := &part{ctype: hegel.Draw(tc, otherTypes), content: hegel.Draw(tc, asciiPool), cte: hegel.Draw(tc, otherCTEs)}
+	if strings.HasPrefix(p.ctype, "text/") {
+		p.charset = "us-ascii"
+	}
+	p.style = hegel.Draw(tc, leafStyles)
+	return p
+})
+
+// leafParts: a text part four times in six, a binary and another part once.
+var leafParts = weighted(choice[*part]{4, textLeaves}, choice[*part]{1, binaryLeaves}, choice[*part]{1, otherLeaves})
+
+var multiTypes = hegel.SampledFrom([]string{"multipart/mixed", "multipart/alternative", "multipart/related"})
+
+// partTrees: a part tree two levels deep: a leaf, or (below the bound, 35%
+// of the time) a multipart of one to three parts; the depth counter lives
+// in the closure and is restored by defer, so an aborted draw cannot leave
+// it stale. The multipart generator is returned too, for the properties
+// that need a multipart root.
+func partTrees() (nodes, multiparts hegel.Generator[*part]) {
+	depth := 0
+	children := many(deferred(&nodes), 1, 3)
+	multiparts = hegel.Composite(func(tc hegel.TestCase) *part {
+		depth++
+		defer func() { depth-- }()
+		return &part{
+			ctype:    hegel.Draw(tc, multiTypes),
+			boundary: hegel.Draw(tc, boundaryPool),
+			multi:    hegel.Draw(tc, multiStyles),
+			children: hegel.Draw(tc, children),
+		}
+	})
+	branches := weighted(choice[*part]{65, leafParts}, choice[*part]{35, multiparts})
+	nodes = hegel.Composite(func(tc hegel.TestCase) *part {
+		if depth >= 2 {
+			return hegel.Draw(tc, leafParts)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return nodes, multiparts
+}
+
+var parts, multiparts = partTrees()
+
+// identityCTE reports an encoding that writes the content as it is.
+func identityCTE(cte string) bool { return cte == "" || cte == "7bit" || cte == "8bit" }
+
+// fitted is the tree as it is written: a nested multipart's boundary made
+// distinct from its ancestors' (a boundary must not occur inside the part it
+// delimits; a prefix relation is a clash), the no-headers flag kept only
+// where it fits (a child leaf without Content-Type, encoding and
+// disposition), and a leaf's boundary-like line appended to its content
+// where it fits (a text leaf of a multipart in an identity encoding).
+func fitted(p *part, depth int, used []string, parentBoundary string) *part {
+	q := *p
+	q.child = depth > 0
+	if p.boundary != "" {
+		for _, u := range used {
+			if strings.HasPrefix(q.boundary, u) || strings.HasPrefix(u, q.boundary) {
+				q.boundary = fmt.Sprintf("%s_%d", q.boundary, depth)
+			}
+		}
+		used = append(append([]string{}, used...), q.boundary)
+		q.children = make([]*part, len(p.children))
+		for i, c := range p.children {
+			q.children[i] = fitted(c, depth+1, used, q.boundary)
+		}
+		return &q
+	}
+	q.noHeaders = p.noHeaders && q.child && p.noContentType && p.cte == "" && p.disp == ""
+	if b := p.style.bLine; b != nil && parentBoundary != "" && strings.HasPrefix(p.ctype, "text/") && identityCTE(p.cte) {
+		line := "--" + parentBoundary + b.suffix
+		if b.prefixed {
+			line = "text " + line
+		}
+		q.content = strings.TrimSuffix(p.content, "\r\n") + "\r\n" + line + "\r\nafter\r\n"
+		q.boundaryLikeLine = true
+	}
+	return &q
+}
+
+// leaves lists the tree's leaf parts in document order.
+func leaves(p *part) []*part {
+	if p.boundary == "" {
+		return []*part{p}
+	}
+	var out []*part
+	for _, c := range p.children {
+		out = append(out, leaves(c)...)
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// The writer: pure functions of the tree.
+
+// contentType writes the Content-Type header's value.
+func (p *part) contentType() string {
+	if p.boundary != "" {
+		q := p.boundary
+		if strings.ContainsAny(q, " '\":;()<>@,/?=[]") || p.multi.bQuoted {
+			q = `"` + q + `"`
+		}
+		return p.multi.ctCase.of(p.ctype) + p.multi.bSep + q
+	}
+	st := p.style
+	ct := st.ctCase.of(p.ctype)
+	if p.charset != "" {
+		cs := p.charset
+		if st.charsetQuoted {
+			cs = `"` + cs + `"`
+		}
+		ct += st.charsetSep + cs
+	}
+	if p.filename != "" && st.nameParam {
+		ct += "; name=" + quoteParam(p.filename)
+	}
+	return ct
+}
+
+// fileNameIn2231Charset reports whether the file name is written as an
+// RFC 2231 value in ISO-8859-1 (the shape of enmime/2): the style asks for
+// it, and the name is non-ASCII and fits the charset.
+func (p *part) fileNameIn2231Charset() bool {
+	return p.style.fileParam.latin1 != nil && p.disp != "" && p.filename != "" && !isASCII(p.filename) && latin1Encodable(p.filename)
+}
+
+// contentDisposition writes the Content-Disposition header's value.
+func (p *part) contentDisposition() string {
+	cd := p.style.dispCase.of(p.disp)
+	if p.filename == "" {
+		return cd
+	}
+	st := p.style.fileParam
+	if p.fileNameIn2231Charset() {
+		l1, _ := charmap.ISO8859_1.NewEncoder().String(p.filename)
+		return cd + "; filename*=" + st.latin1.charset + "'" + st.latin1.lang + "'" + pctEncode(l1)
+	}
+	return cd + fileNameParam(p.filename, st.kind, st.upperUTF8)
+}
+
+// fileNameParam writes the filename parameter of Content-Disposition in the
+// kind-th of its spellings (fileParamStyle): quoted (RFC 2045), RFC 2231
+// encoded, RFC 2231 with continuations, RFC 2047 in the quoted value
+// (common, not standard).
+func fileNameParam(name string, kind int, upperUTF8 bool) string {
+	switch kind {
+	case 1:
+		cs := "utf-8"
+		if upperUTF8 {
+			cs = "UTF-8"
+		}
+		return "; filename*=" + cs + "''" + pctEncode(name)
+	case 4:
+		// a split inside a multi-byte character: segments are concatenated
+		// before decoding (RFC 2231 4.1)
+		enc := pctEncode(name)
+		if len(enc) > 6 && enc[0] == '%' && enc[3] == '%' {
+			return "; filename*0*=utf-8''" + enc[:3] + "; filename*1*=" + enc[3:]
+		}
+		return "; filename=" + quoteParam(name)
+	case 2:
+		enc := pctEncode(name)
+		if len(enc) < 4 {
+			return "; filename=" + quoteParam(name)
+		}
+		cut := len(enc) / 2
+		// do not split a %XX escape (splitting between escapes, inside a
+		// multi-byte character, is allowed: segments are concatenated
+		// before decoding, RFC 2231 4.1)
+		for cut > 2 && (enc[cut-1] == '%' || enc[cut-2] == '%') {
+			cut--
+		}
+		return "; filename*0*=utf-8''" + enc[:cut] + "; filename*1*=" + enc[cut:]
+	case 3:
+		if isASCII(name) && len(name) > 2 {
+			cut := len(name) / 2
+			return "; filename*0=" + quoteParam(name[:cut]) + "; filename*1=" + quoteParam(name[cut:])
+		}
+		return "; filename=" + quoteParam(name)
+	}
+	return "; filename=" + quoteParam(name)
+}
+
+// pctEncode percent-encodes for an RFC 2231 extended value.
+func pctEncode(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c < 0x80 && (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '-' || c == '_') {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+// quoteParam writes a parameter value: a token as is, otherwise quoted.
+func quoteParam(v string) string {
+	if isASCII(v) && !strings.ContainsAny(v, " \"\\()<>@,;:/[]?=") && v != "" {
+		return v
+	}
+	return quoted(v)
+}
+
+// body writes a leaf's content in its charset and encoding (with the line
+// ends of the tree, CRLF; the message writer converts them).
+func (p *part) body() string {
+	content := p.content
+	if enc := charsetEncoder(p.charset); enc != nil {
+		content, _ = enc.NewEncoder().String(content)
+	}
+	st := p.style
+	switch strings.ToLower(p.cte) {
+	case "base64":
+		enc := base64.StdEncoding.EncodeToString([]byte(content))
+		if st.b64Unpadded {
+			enc = strings.TrimRight(enc, "=") // no padding
+		}
+		var b strings.Builder
+		for len(enc) > st.b64Width {
+			b.WriteString(enc[:st.b64Width] + "\r\n")
+			enc = enc[st.b64Width:]
+		}
+		return b.String() + enc + "\r\n"
+	case "quoted-printable":
+		var qb bytes.Buffer
+		qw := quotedprintable.NewWriter(&qb)
+		qw.Write([]byte(content))
+		qw.Close()
+		q := qb.String()
+		if st.qpLowerHex {
+			q = lowerHex(q)
+		}
+		return q + "\r\n"
+	}
+	if !strings.HasSuffix(content, "\r\n") || st.finalEOL {
+		content += "\r\n"
+	}
+	return content
+}
+
+// lowerHex lowercases the hex digits of quoted-printable escapes.
+func lowerHex(q string) string {
+	var b strings.Builder
+	for i := 0; i < len(q); i++ {
+		if q[i] == '=' && i+2 < len(q) {
+			b.WriteByte('=')
+			b.WriteString(strings.ToLower(q[i+1 : i+3]))
+			i += 2
+			continue
+		}
+		b.WriteByte(q[i])
+	}
+	return b.String()
+}
+
+// writePart writes a part's MIME headers (after the message headers, for
+// the root) and its body, with every line end as eol.
+func writePart(b *strings.Builder, p *part, eol string) {
+	w := func(s string) { b.WriteString(strings.ReplaceAll(s, "\r\n", eol)) }
+	if !p.noHeaders {
+		if !p.noContentType {
+			w("Content-Type: " + p.contentType() + "\r\n")
+		}
+		if p.cte != "" {
+			w("Content-Transfer-Encoding: " + p.style.cteCase.of(p.cte) + "\r\n")
+		}
+		if p.disp != "" {
+			w("Content-Disposition: " + p.contentDisposition() + "\r\n")
+		}
+		if p.style.extra || p.multi.extra {
+			w("X-Extra: value\r\n")
+		}
+	}
+	w("\r\n")
+	if p.boundary == "" {
+		w(p.body())
+		return
+	}
+	st := p.multi
+	if st.preamble {
+		w("This is a multi-part message in MIME format.\r\n")
+	}
+	if st.blank {
+		w("\r\n")
+	}
+	for _, c := range p.children {
+		w("--" + p.boundary + st.trail + "\r\n")
+		writePart(b, c, eol)
+	}
+	w("--" + p.boundary + "--" + st.trail + "\r\n")
+	if st.epilogue {
+		w("epilogue text\r\n")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Messages.
+
+// message is a generated message: its header values, the part tree and the
+// styles, and the rendered text.
+type message struct {
+	subject     string
+	from        address
+	to          []address
+	root        *part
+	eol         string
+	subjEnc     encStyle
+	fold        bool // fold between the Subject's encoded words, half of the time
+	toStyle     toStyle
+	mimeVersion bool // four times in five
+	text        string
+}
+
+var eols = hegel.SampledFrom([]string{"\r\n", "\r\n", "\n"})
+
+// specsOver: a message over the root generator, before fitting and
+// rendering (finish).
+func specsOver(roots hegel.Generator[*part]) hegel.Generator[message] {
+	return hegel.Composite(func(tc hegel.TestCase) message {
+		return message{
+			subject:     hegel.Draw(tc, subjects),
+			from:        hegel.Draw(tc, addresses),
+			to:          hegel.Draw(tc, many(addresses, 1, 3)),
+			root:        hegel.Draw(tc, roots),
+			eol:         hegel.Draw(tc, eols),
+			subjEnc:     hegel.Draw(tc, subjectEncodings),
+			fold:        hegel.Draw(tc, chance(50)),
+			toStyle:     hegel.Draw(tc, toStyles),
+			mimeVersion: hegel.Draw(tc, chance(80)),
+		}
+	})
+}
+
+// finish fits the tree and renders the message.
+func finish(m message) message {
+	m.root = fitted(m.root, 0, nil, "")
+	m.text = m.render()
+	return m
+}
+
+var (
+	messageSpecs = specsOver(parts)
+	// messages: the cases of TestHegelReadMatchesPython.
+	messages = hegel.Map(messageSpecs, finish)
+)
+
+// subjectHeader writes the Subject header's value: the encoded subject,
+// folded between encoded words when fold is set (the folding white space is
+// not part of the text, RFC 2047 6.2).
+func (m message) subjectHeader() string {
+	s := m.subjEnc.encode(m.subject)
+	if m.fold {
+		s = strings.ReplaceAll(s, "?= =?", "?=\r\n =?")
+	}
+	return s
+}
+
+// render writes the message with its line ends.
+func (m message) render() string {
+	var b strings.Builder
+	w := func(s string) { b.WriteString(strings.ReplaceAll(s, "\r\n", m.eol)) }
+	w("From: " + m.from.written() + "\r\n")
+	w("To: " + m.toStyle.line(m.to) + "\r\n")
+	w("Subject: " + m.subjectHeader() + "\r\n")
+	if m.mimeVersion {
+		w("MIME-Version: 1.0\r\n")
+	}
+	w("Date: Mon, 01 Sep 2026 10:00:00 +0000\r\n")
+	writePart(&b, m.root, m.eol)
+	return b.String()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (m message) GoString() string { return "message:\n" + m.text }
+
+// knownShape names the recorded bug whose shape the message has, or "":
+// a child part without Content-Type but with a disposition (enmime/1), a
+// file name as an RFC 2231 value in ISO-8859-1 (enmime/2), a body line
+// starting with the boundary that enmime takes as a delimiter or the
+// terminator (enmime/3), a language tag in the Subject's encoded word
+// (enmime/4), a comment before an address of To (enmime/5).
+func knownShape(m message) string {
+	for _, e := range leaves(m.root) {
+		switch {
+		case e.child && e.noContentType && e.disp != "":
+			return "enmime/1"
+		case e.fileNameIn2231Charset():
+			return "enmime/2"
+		case e.boundaryLikeLine && e.style.bLine.bug():
+			return "enmime/3"
+		}
+	}
+	if m.subjEnc.tagged(m.subject) {
+		return "enmime/4"
+	}
+	if m.toStyle.comment != nil {
+		return "enmime/5"
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------------------
+// Oracle: Python's email package in a child process.
+
+type pyPart struct {
+	CT             string `json:"ct"`
+	Charset        string `json:"charset"`
+	Disp           string `json:"disp"`
+	Filename       string `json:"filename"`
+	CTE            string `json:"cte"`
+	Content        string `json:"content"`
+	CharsetUnknown bool   `json:"charset_unknown"`
+}
+
+type pyReply struct {
+	Error   string      `json:"error"`
+	Subject *string     `json:"subject"`
+	From    [][2]string `json:"from"`
+	To      [][2]string `json:"to"`
+	Parts   []pyPart    `json:"parts"`
+	Defects []string    `json:"defects"`
+}
+
+type oracle struct {
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var py *oracle
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if py != nil {
+		py.in.Close()
+		py.cmd.Wait()
+	}
+	os.Exit(code)
+}
+
+func startOracle(t testing.TB) {
+	if py != nil {
+		return
+	}
+	wd, _ := os.Getwd()
+	cmd := exec.Command("python3", filepath.Join(wd, "oracle.py"))
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	py = &oracle{cmd, in, bufio.NewReaderSize(out, 1<<20)}
+}
+
+func (o *oracle) parse(msg string) pyReply {
+	if _, err := fmt.Fprintf(o.in, "%s\n", hex.EncodeToString([]byte(msg))); err != nil {
+		panic(fmt.Sprintf("oracle write: %v", err))
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("oracle read: %v", err))
+	}
+	var r pyReply
+	if err := json.Unmarshal(line, &r); err != nil {
+		panic(fmt.Sprintf("oracle json: %v: %s", err, line))
+	}
+	return r
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+var parser = enmime.NewParser(enmime.DisableCharacterDetection(true))
+
+// goLeaves lists the leaf parts of an enmime tree in document order.
+func goLeaves(p *enmime.Part) []*enmime.Part {
+	if p.FirstChild == nil {
+		return []*enmime.Part{p}
+	}
+	var out []*enmime.Part
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		out = append(out, goLeaves(c)...)
+	}
+	return out
+}
+
+// TestHegelReadMatchesPython: enmime's reading of a generated message (leaf
+// parts with their media type, charset, disposition, file name and decoded
+// content; the decoded Subject, From and To) is Python's. The shapes of the
+// five recorded bugs are drawn at their natural rate, so this property
+// fails while any of them is open; each has its own property in
+// hegel_shapes_test.go.
+func TestHegelReadMatchesPython(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		readMatchesPython(ht, hegel.Draw(ht, messages))
+	})
+}
+
+// readMatchesPython judges one message: Python's reading (a message it
+// rejects is counted and skipped) against enmime's, every disagreement
+// named with the recorded bug's shape the message has, if any.
+func readMatchesPython(ht *hegel.T, m message) {
+	want := py.parse(m.text)
+	if want.Error != "" {
+		count("python rejects: " + firstWords(want.Error))
+		ht.Assume(false)
+	}
+	shape := knownShape(m)
+	env, err := parser.ReadEnvelope(strings.NewReader(m.text))
+	if err != nil {
+		mismatch(ht, shape, "enmime rejects: %v\nmessage:\n%s", err, m.text)
+	}
+	exp := leaves(m.root)
+	got := goLeaves(env.Root)
+	if len(got) != len(want.Parts) || len(got) != len(exp) {
+		mismatch(ht, shape, "enmime finds %d leaf parts, Python %d, generated %d\n%s\nmessage:\n%s", len(got), len(want.Parts), len(exp), showParts(got, want.Parts), m.text)
+	}
+	count(fmt.Sprintf("%d parts", len(exp)))
+	for i, g := range got {
+		w := want.Parts[i]
+		e := exp[i]
+		if e.noContentType || e.noHeaders {
+			// No Content-Type header: Python applies the text/plain
+			// default; enmime leaves the type empty on child parts (with
+			// a warning) and applies text/plain; charset=us-ascii on the
+			// root. Only the content is compared.
+			count("no Content-Type")
+		} else {
+			if !strings.EqualFold(g.ContentType, w.CT) {
+				mismatch(ht, shape, "part %d: enmime type %q, Python %q\nmessage:\n%s", i, g.ContentType, w.CT, m.text)
+			}
+			switch {
+			case e.charset == "" && w.Charset == "" && g.Charset != "" && utf8.RuneCount(g.Content) >= 100:
+				// No charset declared and a hundred runes or more of content:
+				// enmime detects a charset (chardet; DisableCharacterDetection
+				// only keeps a declared one, MinCharsetDetectRunes is 100),
+				// Python reports none. A design difference (README), not
+				// judged; the content is.
+				count("charset detected")
+			case !strings.EqualFold(g.Charset, w.Charset):
+				mismatch(ht, shape, "part %d: enmime charset %q, Python %q\nmessage:\n%s", i, g.Charset, w.Charset, m.text)
+			}
+		}
+		if !strings.EqualFold(g.Disposition, w.Disp) {
+			mismatch(ht, shape, "part %d: enmime disposition %q, Python %q\nmessage:\n%s", i, g.Disposition, w.Disp, m.text)
+		}
+		if g.FileName != w.Filename {
+			mismatch(ht, shape, "part %d: enmime file name %q, Python %q (generated %q)\nmessage:\n%s", i, g.FileName, w.Filename, e.filename, m.text)
+		}
+		wc, _ := hex.DecodeString(w.Content)
+		if !bytes.Equal(g.Content, wc) {
+			mismatch(ht, shape, "part %d (%s, %s, cte %s): enmime content %q, Python %q (generated %q)\nmessage:\n%s", i, g.ContentType, g.Charset, e.cte, g.Content, wc, e.content, m.text)
+		}
+	}
+	if want.Subject != nil {
+		if s := env.GetHeader("Subject"); s != *want.Subject {
+			mismatch(ht, shape, "Subject: enmime %q, Python %q (generated %q)\nmessage:\n%s", s, *want.Subject, m.subject, m.text)
+		}
+	}
+	for _, h := range []struct {
+		name string
+		want [][2]string
+		gen  []address
+	}{{"From", want.From, []address{m.from}}, {"To", want.To, m.to}} {
+		list, err := env.AddressList(h.name)
+		if err != nil {
+			mismatch(ht, shape, "%s: enmime AddressList: %v\nmessage:\n%s", h.name, err, m.text)
+		}
+		if len(list) != len(h.want) {
+			mismatch(ht, shape, "%s: enmime %d addresses, Python %d\nmessage:\n%s", h.name, len(list), len(h.want), m.text)
+		}
+		for i, a := range list {
+			if a.Name != h.want[i][0] || a.Address != h.want[i][1] {
+				mismatch(ht, shape, "%s[%d]: enmime %q <%s>, Python %q <%s> (generated %q <%s>)\nmessage:\n%s", h.name, i, a.Name, a.Address, h.want[i][0], h.want[i][1], h.gen[i].name, h.gen[i].addr, m.text)
+			}
+		}
+	}
+}
+
+func showParts(got []*enmime.Part, want []pyPart) string {
+	var b strings.Builder
+	for i, g := range got {
+		fmt.Fprintf(&b, "  enmime %d: %s %s %q\n", i, g.ContentType, g.Disposition, g.FileName)
+	}
+	for i, w := range want {
+		fmt.Fprintf(&b, "  python %d: %s %s %q\n", i, w.CT, w.Disp, w.Filename)
+	}
+	return b.String()
+}
+
+func firstWords(s string) string {
+	f := strings.Fields(s)
+	if len(f) > 4 {
+		f = f[:4]
+	}
+	return strings.Join(f, " ")
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..896b91a
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/jhillyerd/enmime/v2"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are Python's email package's reading and
+// the RFCs.
+
+func crlf(s string) string { return strings.ReplaceAll(s, "\n", "\r\n") }
+
+func read(t *testing.T, msg string) *enmime.Envelope {
+	t.Helper()
+	env, err := enmime.ReadEnvelope(strings.NewReader(msg))
+	if err != nil {
+		t.Fatalf("ReadEnvelope: %v", err)
+	}
+	return env
+}
+
+func lastChild(p *enmime.Part) *enmime.Part {
+	var last *enmime.Part
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		last = c
+	}
+	return last
+}
+
+// enmime/1: a part without a Content-Type header (text/plain by default,
+// RFC 2046 5.2) keeps its Content-Disposition and file name; enmime drops
+// them, so the attachment is neither in Envelope.Attachments nor named.
+func TestHegelPinDispositionWithoutContentType(t *testing.T) {
+	env := read(t, crlf(`From: a@example.com
+To: b@example.com
+Subject: notes
+MIME-Version: 1.0
+Content-Type: multipart/mixed; boundary="b1"
+
+--b1
+Content-Type: text/plain; charset=utf-8
+
+See the attached notes.
+--b1
+Content-Disposition: attachment; filename="notes.txt"
+
+line one
+line two
+--b1--
+`))
+	second := lastChild(env.Root)
+	if second == nil {
+		t.Fatal("no child parts")
+	}
+	if second.Disposition != "attachment" {
+		t.Errorf("Disposition of the part without Content-Type = %q, want %q (Python: attachment)", second.Disposition, "attachment")
+	}
+	if second.FileName != "notes.txt" {
+		t.Errorf("FileName of the part without Content-Type = %q, want %q", second.FileName, "notes.txt")
+	}
+	if len(env.Attachments) != 1 {
+		t.Errorf("Envelope.Attachments has %d parts, want 1", len(env.Attachments))
+	}
+}
+
+// enmime/2: an RFC 2231 file name in a charset other than UTF-8 is dropped,
+// and with continuations partly kept undecoded.
+func TestHegelPinRFC2231FileNameCharset(t *testing.T) {
+	head := "From: a@example.com\r\nTo: b@example.com\r\nSubject: s\r\nMIME-Version: 1.0\r\nContent-Type: application/pdf\r\n"
+	env := read(t, head+"Content-Disposition: attachment; filename*=iso-8859-1''r%E9sum%E9.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "résumé.pdf" {
+		t.Errorf("filename*=iso-8859-1''r%%E9sum%%E9.pdf: FileName %q, want %q (Python)", env.Root.FileName, "résumé.pdf")
+	}
+	env = read(t, head+"Content-Disposition: attachment; filename*0*=iso-8859-1''r%E9; filename*1*=sum%E9.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "résumé.pdf" {
+		t.Errorf("filename*0*=iso-8859-1''r%%E9; filename*1*=sum%%E9.pdf: FileName %q, want %q", env.Root.FileName, "résumé.pdf")
+	}
+	env = read(t, head+"Content-Disposition: attachment; filename*=windows-1252''%80.pdf\r\n\r\nx\r\n")
+	if env.Root.FileName != "€.pdf" {
+		t.Errorf("filename*=windows-1252''%%80.pdf: FileName %q, want %q", env.Root.FileName, "€.pdf")
+	}
+}
+
+// enmime/3: a body line that begins with the boundary and continues with
+// text is not a delimiter (RFC 2046 5.1.1: only white space may follow);
+// enmime takes "--b1 extra" as one (and then fails on the next line as a
+// header) and "--b1--x" anywhere in a line as the terminator.
+func TestHegelPinBoundaryFollowedByText(t *testing.T) {
+	head := "From: a@example.com\r\nTo: b@example.com\r\nSubject: s\r\nMIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=b1\r\n\r\n"
+	msg := head + "--b1\r\nContent-Type: text/plain\r\n\r\none\r\n--b1 extra\r\nstill one\r\n--b1\r\nContent-Type: text/plain\r\n\r\ntwo\r\n--b1--\r\n"
+	env, err := enmime.ReadEnvelope(strings.NewReader(msg))
+	if err != nil {
+		t.Errorf("a body line \"--b1 extra\": ReadEnvelope fails: %v (Python: two parts, the first \"one\\r\\n--b1 extra\\r\\nstill one\")", err)
+	} else if c := env.Root.FirstChild; c == nil || string(c.Content) != "one\r\n--b1 extra\r\nstill one" {
+		t.Errorf("a body line \"--b1 extra\": first part %q", c.Content)
+	}
+	msg = head + "--b1\r\nContent-Type: text/plain\r\n\r\none\r\ntext --b1--x\r\nstill one\r\n--b1--\r\n"
+	env = read(t, msg)
+	if c := env.Root.FirstChild; c == nil || string(c.Content) != "one\r\ntext --b1--x\r\nstill one" {
+		t.Errorf("a body line \"text --b1--x\": first part %q, want %q", c.Content, "one\r\ntext --b1--x\r\nstill one")
+	}
+}
+
+// enmime/4: an encoded word with an RFC 2231 language tag
+// (=?utf-8*en?q?...?=, RFC 2231 5) is decoded like one without.
+func TestHegelPinEncodedWordLanguageTag(t *testing.T) {
+	env := read(t, "From: =?utf-8*en?q?Zo=C3=AB?= <a@example.com>\r\nSubject: =?utf-8*en?q?caf=C3=A9?=\r\n\r\nbody\r\n")
+	if s := env.GetHeader("Subject"); s != "café" {
+		t.Errorf("Subject =?utf-8*en?q?caf=C3=A9?= decodes to %q, want %q (Python)", s, "café")
+	}
+	from, err := env.AddressList("From")
+	if err != nil || len(from) != 1 || from[0].Name != "Zoë" {
+		t.Errorf("From =?utf-8*en?q?Zo=C3=AB?= <a@example.com>: %v, %v; want name %q", from, err, "Zoë")
+	}
+}
+
+// enmime/5: a comment before an address (CFWS, RFC 5322 3.4) makes the whole
+// address list unparseable.
+func TestHegelPinCommentBeforeAddress(t *testing.T) {
+	env := read(t, "From: a@example.com\r\nTo: (pre) d@example.org\r\nSubject: s\r\n\r\nbody\r\n")
+	to, err := env.AddressList("To")
+	if err != nil || len(to) != 1 || to[0].Address != "d@example.org" {
+		t.Errorf("To: (pre) d@example.org: %v, %v; want one address d@example.org (Python)", to, err)
+	}
+	env = read(t, "From: a@example.com\r\nTo: a@x.com, (c) b@x.com\r\nSubject: s\r\n\r\nbody\r\n")
+	to, err = env.AddressList("To")
+	if err != nil || len(to) != 2 {
+		t.Errorf("To: a@x.com, (c) b@x.com: %v, %v; want two addresses", to, err)
+	}
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..ba0f119
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,177 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a message of the wide
+// generator with the bug's shape put into it (a leaf of the tree replaced,
+// a header style set), judged by the oracle of TestHegelReadMatchesPython,
+// so that each bug has a property that finds it every run (the wide property
+// reaches the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each
+// draws the neighbouring region the bug does not touch instead (the same
+// part with its Content-Type, the file name in UTF-8, a body line that only
+// resembles a delimiter, the encoded word without its tag, the To list
+// without its comment) and passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// multipartSpecs: a message whose root is a multipart, so that every leaf
+// is a child part.
+var multipartSpecs = specsOver(multiparts)
+
+// leafAt is the at-th leaf of the tree, modulo their number.
+func leafAt(root *part, at int) *part {
+	ls := leaves(root)
+	return ls[at%len(ls)]
+}
+
+// withLeaf: a message of specs with the leaf at a drawn position replaced
+// by one of leaves, fitted and rendered.
+func withLeaf(specs hegel.Generator[message], leaves hegel.Generator[*part]) hegel.Generator[message] {
+	return hegel.Composite(func(tc hegel.TestCase) message {
+		m := hegel.Draw(tc, specs)
+		*leafAt(m.root, hegel.Draw(tc, positions)) = *hegel.Draw(tc, leaves)
+		return finish(m)
+	})
+}
+
+// shapeProperty runs the oracle over the messages.
+func shapeProperty(t *testing.T, msgs hegel.Generator[message]) {
+	t.Helper()
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		readMatchesPython(ht, hegel.Draw(ht, msgs))
+	})
+}
+
+// --------------------------------------------------------------------------- enmime/1
+
+// dispositionsWithoutContentType: a text part without a charset and, by
+// default, without a Content-Type header (text/plain by default, RFC 2046
+// 5.2), with a disposition and a file name seven times in ten; under
+// HEGEL_NO_KNOWN=1 the same part with its Content-Type header.
+var dispositionsWithoutContentType = hegel.Composite(func(tc hegel.TestCase) *part {
+	return &part{
+		ctype:         "text/plain",
+		content:       hegel.Draw(tc, asciiPool),
+		cte:           hegel.Draw(tc, ctesBare),
+		disp:          hegel.Draw(tc, dispositions),
+		filename:      hegel.Draw(tc, maybe(70, fileNamePool)),
+		noContentType: shaped(true, false),
+		style:         hegel.Draw(tc, leafStyles),
+	}
+})
+
+// TestHegelDispositionSurvivesMissingContentType: a child part with a
+// Content-Disposition but no Content-Type keeps its disposition and file
+// name, as Python reads them; enmime drops both (enmime/1).
+func TestHegelDispositionSurvivesMissingContentType(t *testing.T) {
+	shapeProperty(t, withLeaf(multipartSpecs, dispositionsWithoutContentType))
+}
+
+// --------------------------------------------------------------------------- enmime/2
+
+// latin1Names: non-ASCII file names that fit ISO-8859-1.
+var latin1Names = hegel.SampledFrom([]string{"r\u00e9sum\u00e9.pdf", "caf\u00e9.txt", "J\u00fcrgen \u00e0 c\u00f4t\u00e9.pdf", "\u00e9"})
+
+// fileNamesInLatin1: a leaf of the wide generator with a disposition and
+// one of the names, written by default as an RFC 2231 value in ISO-8859-1
+// (with or without a language); under HEGEL_NO_KNOWN=1 in the UTF-8 or
+// quoted spellings.
+var fileNamesInLatin1 = hegel.Composite(func(tc hegel.TestCase) *part {
+	p := hegel.Draw(tc, leafParts)
+	p.disp = hegel.Draw(tc, dispositions)
+	p.filename = hegel.Draw(tc, latin1Names)
+	p.style.fileParam.latin1 = hegel.Draw(tc, shaped(latin1Params, hegel.Just[*latin1Param](nil)))
+	return p
+})
+
+// TestHegelRFC2231FileNamesDecodeInLatin1: a file name written as an
+// RFC 2231 extended value in ISO-8859-1 (RFC 2231 4 allows any registered
+// charset) is decoded, as Python decodes it; enmime gives no file name
+// (enmime/2).
+func TestHegelRFC2231FileNamesDecodeInLatin1(t *testing.T) {
+	shapeProperty(t, withLeaf(messageSpecs, fileNamesInLatin1))
+}
+
+// --------------------------------------------------------------------------- enmime/3
+
+// identityCTEsFor: the encodings that write the content as it is.
+func identityCTEsFor(content string) hegel.Generator[string] {
+	if isASCII(content) {
+		return hegel.SampledFrom([]string{"", "7bit", "8bit"})
+	}
+	return hegel.Just("8bit")
+}
+
+// textLeavesWithBoundaryLines: a text part of the wide generator in an
+// identity encoding whose content gets a line starting with the parent's
+// boundary, by default one enmime misreads (white space then text, or "--"
+// then text); under HEGEL_NO_KNOWN=1 one both parsers keep as text.
+var textLeavesWithBoundaryLines = hegel.Composite(func(tc hegel.TestCase) *part {
+	p := hegel.Draw(tc, textLeaves)
+	p.cte = hegel.Draw(tc, identityCTEsFor(p.content))
+	p.style.bLine = &boundaryLine{
+		suffix:   hegel.Draw(tc, shaped(hegel.SampledFrom(bugSuffixes), hegel.SampledFrom(harmlessSuffixes))),
+		prefixed: hegel.Draw(tc, chance(30)),
+	}
+	return p
+})
+
+// TestHegelBoundaryLikeBodyLinesStayInTheContent: a body line that begins
+// with the boundary and goes on with text is body text (RFC 2046 5.1.1:
+// only white space may follow a delimiter), as Python keeps it; enmime
+// takes "--b1 extra" as a delimiter (and then fails on the next line as a
+// header) and "--b1--x" anywhere in a line as the terminator (enmime/3).
+func TestHegelBoundaryLikeBodyLinesStayInTheContent(t *testing.T) {
+	shapeProperty(t, withLeaf(multipartSpecs, textLeavesWithBoundaryLines))
+}
+
+// --------------------------------------------------------------------------- enmime/4
+
+// nonASCIIWords: the header phrases an encoded word is needed for.
+var nonASCIIWords = func() []string {
+	var out []string
+	for _, w := range words {
+		if !isASCII(w) {
+			out = append(out, w)
+		}
+	}
+	return out
+}()
+
+// taggedSubjects: a subject of a non-ASCII word and up to three more, so
+// that it is written as encoded words, with by default a language tag on
+// the first (=?utf-8*en?q?...?=); under HEGEL_NO_KNOWN=1 without.
+var taggedSubjects = hegel.Composite(func(tc hegel.TestCase) message {
+	m := hegel.Draw(tc, messageSpecs)
+	m.subject = strings.Join(append([]string{hegel.Draw(tc, hegel.SampledFrom(nonASCIIWords))}, hegel.Draw(tc, many(wordPool, 0, 3))...), " ")
+	m.subjEnc.lang = hegel.Draw(tc, shaped(hegel.Map(langTags, ptrTo[string]), hegel.Just[*string](nil)))
+	return finish(m)
+})
+
+// TestHegelLanguageTaggedEncodedWordsDecode: an encoded word with an
+// RFC 2231 language tag (RFC 2231 5) decodes like one without, as Python
+// decodes it; enmime leaves the Subject undecoded (enmime/4).
+func TestHegelLanguageTaggedEncodedWordsDecode(t *testing.T) {
+	shapeProperty(t, taggedSubjects)
+}
+
+// --------------------------------------------------------------------------- enmime/5
+
+// commentedToLists: a message whose To list has, by default, a comment
+// before one of its addresses; under HEGEL_NO_KNOWN=1 none.
+var commentedToLists = hegel.Composite(func(tc hegel.TestCase) message {
+	m := hegel.Draw(tc, messageSpecs)
+	m.toStyle.comment = hegel.Draw(tc, shaped(comments, hegel.Just[*comment](nil)))
+	return finish(m)
+})
+
+// TestHegelCommentsBeforeAddressesParse: a comment before an address (CFWS,
+// RFC 5322 3.4) leaves the address list readable, as Python reads it;
+// enmime's AddressList fails with "missing word in phrase" (enmime/5).
+func TestHegelCommentsBeforeAddressesParse(t *testing.T) {
+	shapeProperty(t, commentedToLists)
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..b552c3f
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,220 @@
+package hegel
+
+// Hegel property tests for enmime: generated MIME messages, read by this
+// package and by Python's email package, must give the same headers, parts
+// and decoded contents; messages built by each must be read by the other.
+//
+// Every property draws one case record (a message as a small tree of records
+// with the styles it is written in, rendered by pure functions; a Builder
+// case) with one Draw. The shapes of the recorded bugs (bugs.toml) are drawn
+// at their natural rate, so the property that meets one fails, naming the
+// shape (mismatch), and is the expected failure mapped to the bug;
+// hegel_shapes_test.go has one property per bug over its shape region alone,
+// and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches
+// the known shapes off (noKnown, known.go) for a run that looks past them.
+//
+// Needs python3.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is
+// that of the recorded bug shape names ("" for none): the failure names the
+// shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is
+// skipped instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += "\n(the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// deferred draws from a generator assigned later (a recursive grammar's
+// forward reference).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// joined is the strings of a list joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(ws []string) string { return strings.Join(ws, sep) })
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..6a2bd9b
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,22 @@
+package hegel
+
+import "os"
+
+// The recorded bugs (bugs.toml). By default the generators draw the shapes
+// of the recorded bugs and the properties that meet them fail, naming the
+// shape (mismatch, hegel_test.go; knownShape, hegel_mime_test.go, is the
+// classifier). HEGEL_NO_KNOWN=1 looks past the recorded bugs: the shapes
+// are left out of the generators (shaped) and a mismatch that still has a
+// known shape is skipped.
+
+// noKnown: HEGEL_NO_KNOWN=1, read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..931d318
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,87 @@
+"""Oracle for the zoo's enmime tests: Python's email package, one request per
+line on stdin. Request: the message as hex. Reply: one JSON object per line:
+
+  {"subject": str, "from": [[name, addr], ...], "to": [...],
+   "parts": [{"ct": str, "charset": str, "disp": str, "filename": str,
+              "content": hex, "cte": str}, ...],
+   "defects": [str, ...]}
+
+or {"error": str}. Parts are the leaves of the MIME tree in document order;
+text parts' contents are decoded with the declared charset and re-encoded as
+UTF-8 (as enmime does), others are the transfer-decoded bytes.
+"""
+import binascii
+import json
+import sys
+from email import message_from_bytes, policy
+
+
+def addresses(msg, name):
+    h = msg.get(name)
+    if h is None:
+        return None
+    out = []
+    for a in getattr(h, "addresses", ()):
+        out.append([a.display_name, a.username + "@" + a.domain])
+    return out
+
+
+def part_info(p):
+    info = {
+        "ct": p.get_content_type(),
+        "charset": p.get_content_charset() or "",
+        "disp": p.get_content_disposition() or "",
+        "filename": p.get_filename() or "",
+        "cte": (p.get("Content-Transfer-Encoding") or "").strip().lower(),
+    }
+    payload = p.get_payload(decode=True)
+    if payload is None:
+        payload = b""
+    if p.get_content_maintype() == "text":
+        cs = p.get_content_charset()
+        if cs:
+            try:
+                payload = payload.decode(cs, errors="replace").encode("utf-8")
+            except LookupError:
+                info["charset_unknown"] = True
+    info["content"] = binascii.hexlify(payload).decode("ascii")
+    return info
+
+
+def handle(data):
+    msg = message_from_bytes(data, policy=policy.default)
+    parts = []
+    for p in msg.walk():
+        if p.is_multipart():
+            continue
+        parts.append(part_info(p))
+    defects = [type(d).__name__ for d in msg.defects]
+    for p in msg.walk():
+        if p is not msg:
+            defects.extend(type(d).__name__ for d in p.defects)
+    subject = msg.get("Subject")
+    return {
+        "subject": str(subject) if subject is not None else None,
+        "from": addresses(msg, "From"),
+        "to": addresses(msg, "To"),
+        "parts": parts,
+        "defects": defects,
+    }
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            data = binascii.unhexlify(line)
+            reply = handle(data)
+        except Exception as e:  # noqa: BLE001
+            reply = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(reply, ensure_ascii=True) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
