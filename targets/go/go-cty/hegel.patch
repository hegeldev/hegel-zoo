+// TestHegelMsgpackRoundTrip: the msgpack serialization round-trips values with their type,
+// unknown values included, and the implied type reads a buffer without unknowns back. A null,
+// unknown or empty element under a placeholder-bearing element type comes back with the
+// declared type, and panics the unmarshal beside a known element (go-cty/1).
+func TestHegelMsgpackRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tv := hegel.Draw(ht, msgpackCases)
+		ty, v := tv.ty, tv.v
+		shape := shapeIf(losesElementType(ty, v), "go-cty/1")
+		buf, err := ctymsgpack.Marshal(v, ty)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(%s, %s): %v", v.GoString(), tyString(ty), err)
+			return
+		}
+		got, err, panicked := recovering(func() (cty.Value, error) { return ctymsgpack.Unmarshal(buf, ty) })
+		if panicked != nil {
+			c.mismatch(ht, "unmarshal panic", shape, "Unmarshal(%x, %s) panics: %v (value %s)", buf, tyString(ty), panicked, v.GoString())
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, "unmarshal", shape, "Unmarshal(%x, %s): %v (value %s)", buf, tyString(ty), err, v.GoString())
+			return
+		}
+		if !got.RawEquals(v) {
+			c.mismatch(ht, "value", shape, "round trip of %s as %s gives %s", v.GoString(), tyString(ty), got.GoString())
+			return
+		}
+		if !hasDynamic(ty) && v.IsWhollyKnown() {
+			ity, err := ctymsgpack.ImpliedType(buf)
+			if err != nil {
+				c.failClass(ht, "implied", "ImpliedType(%x): %v (value %s)", buf, err, v.GoString())
+				return
+			}
+			iv, err := ctymsgpack.Unmarshal(buf, ity)
+			if err != nil {
+				c.failClass(ht, "implied unmarshal", "Unmarshal(%x, implied %s): %v", buf, tyString(ity), err)
+				return
+			}
+			back, err := convert.Convert(iv, ty)
+			if err != nil {
+				c.failClass(ht, "implied convert", "Convert(%s, %s) after ImpliedType: %v", iv.GoString(), tyString(ty), err)
+				return
+			}
+			if !back.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "implied value", "value read with the implied type %s and converted back is %s, not %s", tyString(ity), back.GoString(), v.GoString())
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- related types
+
+// freshTypes: a type unrelated to the source, with placeholders three times in ten.
+var freshTypes = weighted(choice[cty.Type]{70, plainTypes2}, choice[cty.Type]{30, dynamicTypes2})
+
+// relatedTypesOf is the generator of target types for a conversion from ty: an unrelated type,
+// the type with one primitive swapped, or (half the time) a structural cousin.
+func relatedTypesOf(ty cty.Type) hegel.Generator[cty.Type] {
+	return weighted(
+		choice[cty.Type]{25, freshTypes},
+		choice[cty.Type]{25, swappedOf(ty)},
+		choice[cty.Type]{50, cousinsOf(ty)},
+	)
+}
+
+// swappedOf is ty with one primitive somewhere in it replaced by another primitive.
+func swappedOf(ty cty.Type) hegel.Generator[cty.Type] {
+	switch {
+	case ty.IsPrimitiveType():
+		return plainPrimitives
+	case ty.IsListType():
+		return hegel.Map(swappedOf(ty.ElementType()), cty.List)
+	case ty.IsSetType():
+		return hegel.Map(swappedOf(ty.ElementType()), cty.Set)
+	case ty.IsMapType():
+		return hegel.Map(swappedOf(ty.ElementType()), cty.Map)
+	case ty.IsObjectType():
+		attrs := ty.AttributeTypes()
+		if len(attrs) == 0 {
+			return hegel.Just(ty)
+		}
+		return hegel.FlatMap(hegel.SampledFrom(sortedKeys(attrs)), func(k string) hegel.Generator[cty.Type] {
+			return hegel.Map(swappedOf(attrs[k]), func(swapped cty.Type) cty.Type {
+				out := map[string]cty.Type{}
+				for name, a := range attrs {
+					out[name] = a
+				}
+				out[k] = swapped
+				return cty.Object(out)
+			})
+		})
+	case ty.IsTupleType():
+		etys := ty.TupleElementTypes()
+		if len(etys) == 0 {
+			return hegel.Just(ty)
+		}
+		return hegel.FlatMap(hegel.Integers(0, len(etys)-1), func(i int) hegel.Generator[cty.Type] {
+			return hegel.Map(swappedOf(etys[i]), func(swapped cty.Type) cty.Type {
+				out := append([]cty.Type{}, etys...)
+				out[i] = swapped
+				return cty.Tuple(out)
+			})
+		})
+	}
+	return hegel.Just(ty)
+}
+
+// cousinsOf is the same elements in another kind: a list, set or tuple of a sequence's
+// element type; a list or set of one of a tuple's element types; an object of a map's element
+// type; a map of one of an object's attribute types, or the object with an attribute dropped
+// or added; a primitive for a primitive.
+func cousinsOf(ty cty.Type) hegel.Generator[cty.Type] {
+	switch {
+	case ty.IsListType() || ty.IsSetType():
+		ety := ty.ElementType()
+		return hegel.OneOf(
+			hegel.Just(cty.List(ety)),
+			hegel.Just(cty.Set(ety)),
+			hegel.Map(hegel.Integers(0, 3), func(n int) cty.Type {
+				elems := make([]cty.Type, n)
+				for i := range elems {
+					elems[i] = ety
+				}
+				return cty.Tuple(elems)
+			}),
+		)
+	case ty.IsTupleType():
+		etys := ty.TupleElementTypes()
+		if len(etys) == 0 {
+			return hegel.SampledFrom([]cty.Type{cty.List(cty.String), cty.Set(cty.Number), cty.EmptyTuple})
+		}
+		return hegel.FlatMap(hegel.SampledFrom(etys), func(e cty.Type) hegel.Generator[cty.Type] {
+			return hegel.OneOf(hegel.Just(cty.List(e)), hegel.Just(cty.Set(e)))
+		})
+	case ty.IsMapType():
+		return hegel.Map(hegel.Maps(attrKeys, hegel.Just(ty.ElementType())).MaxSize(3), objectOf)
+	case ty.IsObjectType():
+		attrs := ty.AttributeTypes()
+		if len(attrs) == 0 {
+			return hegel.Map(plainPrimitives, cty.Map)
+		}
+		names := hegel.SampledFrom(sortedKeys(attrs))
+		return weighted(
+			choice[cty.Type]{50, hegel.Map(names, func(k string) cty.Type { return cty.Map(attrs[k]) })},
+			choice[cty.Type]{25, hegel.Map(names, func(k string) cty.Type {
+				out := map[string]cty.Type{}
+				for name, a := range attrs {
+					out[name] = a
+				}
+				delete(out, k)
+				return cty.Object(out)
+			})},
+			choice[cty.Type]{25, hegel.Composite(func(tc hegel.TestCase) cty.Type {
+				out := map[string]cty.Type{}
+				for name, a := range attrs {
+					out[name] = a
+				}
+				out[hegel.Draw(tc, attrKeys)] = hegel.Draw(tc, plainPrimitives)
+				return cty.Object(out)
+			})},
+		)
+	}
+	return plainPrimitives
+}
