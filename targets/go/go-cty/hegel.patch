+// TestHegelConversionRules: a safe conversion never fails and yields the target type; Convert
+// succeeds exactly when an unsafe conversion exists (or the types are equal) and yields the
+// target type; converting back along a safe, lossless path gives the original value.
+func TestHegelConversionRules(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, convCases)
+		ty, v, want := cc.ty, cc.v, cc.want
+		if want.Equals(ty) {
+			out, err := convert.Convert(v, want)
+			if err != nil || !out.RawEquals(v) {
+				c.failClass(ht, "identity", "Convert(%s, its own type %s) = %s, %v", v.GoString(), tyString(ty), out.GoString(), err)
+			}
+			return
+		}
+		safe := convert.GetConversion(ty, want)
+		unsafe := convert.GetConversionUnsafe(ty, want)
+		if safe != nil && unsafe == nil {
+			c.failClass(ht, "safe not unsafe", "GetConversion(%s, %s) exists but GetConversionUnsafe does not", tyString(ty), tyString(want))
+			return
+		}
+		if safe != nil {
+			out, err := safe(v)
+			if err != nil {
+				c.failClass(ht, "safe fails", "the safe conversion %s -> %s fails on %s: %v", tyString(ty), tyString(want), v.GoString(), err)
+				return
+			}
+			if !hasDynamic(want) && !out.Type().Equals(want) {
+				c.failClass(ht, "safe type", "the safe conversion %s -> %s gives %s of type %s", tyString(ty), tyString(want), out.GoString(), tyString(out.Type()))
+				return
+			}
+		}
+		out, err := convert.Convert(v, want)
+		if unsafe == nil {
+			if err == nil {
+				c.failClass(ht, "no conversion", "GetConversionUnsafe(%s, %s) is nil but Convert(%s) = %s", tyString(ty), tyString(want), v.GoString(), out.GoString())
+			}
+			return
+		}
+		if err != nil {
+			if safe != nil {
+				c.failClass(ht, "convert safe fails", "Convert(%s, %s) fails though a safe conversion exists: %v", v.GoString(), tyString(want), err)
+			}
+			c.count("unsafe error")
+			return
+		}
+		if !hasDynamic(want) && !out.Type().Equals(want) {
+			c.failClass(ht, "convert type", "Convert(%s, %s) = %s of type %s", v.GoString(), tyString(want), out.GoString(), tyString(out.Type()))
+			return
+		}
+		if v.IsNull() && !out.IsNull() || !v.IsNull() && out.IsNull() {
+			c.failClass(ht, "nullness", "Convert(%s, %s) = %s: nullness changed", v.GoString(), tyString(want), out.GoString())
+			return
+		}
+		// back along a safe, lossless path
+		if safe != nil && !hasSet(want) && !hasDynamic(want) && !hasDynamic(ty) {
+			back, err := convert.Convert(out, ty)
+			if err != nil {
+				c.count("no way back")
+				return
+			}
+			if !back.RawEquals(v) {
+				c.failClass(ht, "round trip", "%s -> %s -> %s: %s became %s via %s", tyString(ty), tyString(want), tyString(ty), v.GoString(), back.GoString(), out.GoString())
+				return
+			}
+		}
+	})
+}
