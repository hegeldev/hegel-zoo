+// isEmptyCollection reports a known list, set or map without elements.
+func isEmptyCollection(v cty.Value) bool {
+	return v.IsKnown() && !v.IsNull() && (v.Type().IsListType() || v.Type().IsSetType() || v.Type().IsMapType()) && v.LengthInt() == 0
+}
+
+// losesElementType reports the shape of go-cty/1: somewhere in v, marshalled as ty, a null,
+// unknown or empty collection sits at a position whose declared type is not its own (the
+// declared one holds a placeholder, the value's is concrete: the position is inside an element
+// of a list, set or map whose element type holds the placeholder), so the codecs write nothing
+// the reader could take the value's type from and it comes back with the declared type. A
+// position typed exactly DynamicPseudoType is written with the value's own type and loses
+// nothing.
+func losesElementType(ty cty.Type, v cty.Value) bool {
+	if ty == cty.DynamicPseudoType {
+		return false
+	}
+	if v.IsNull() || !v.IsKnown() || isEmptyCollection(v) {
+		return !v.Type().Equals(ty)
+	}
+	switch {
+	case ty.IsListType(), ty.IsSetType(), ty.IsMapType():
+		for it := v.ElementIterator(); it.Next(); {
+			_, e := it.Element()
+			if losesElementType(ty.ElementType(), e) {
+				return true
+			}
+		}
+	case ty.IsObjectType():
+		for name, aty := range ty.AttributeTypes() {
+			if losesElementType(aty, v.GetAttr(name)) {
+				return true
+			}
+		}
+	case ty.IsTupleType():
+		for i, ety := range ty.TupleElementTypes() {
+			if losesElementType(ety, v.Index(cty.NumberIntVal(int64(i)))) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// recovering runs unmarshal and returns what it panicked with, if it did (the go-cty/1 shape
+// panics inside cty.ListVal; the run must go on).
+func recovering(unmarshal func() (cty.Value, error)) (got cty.Value, err error, panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	got, err = unmarshal()
+	return
+}
+
+// TestHegelJSONRoundTrip: a value marshalled with its type unmarshals, with the same type, to an
+// equal value ("it is guaranteed that values will round-trip through JSON serialization to
+// produce a value of the same type"); the type itself round-trips through MarshalType; the
+// implied type of the buffer reads it to a value that converts back to the original; and
+// SimpleJSONValue reads any buffer the type-preserving marshaller wrote. A null or empty
+// element under a placeholder-bearing element type comes back with the declared type, and
+// panics the unmarshal beside a known element (go-cty/1).
+func TestHegelJSONRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tv := hegel.Draw(ht, jsonCases)
+		ty, v := tv.ty, tv.v
+		shape := shapeIf(losesElementType(ty, v), "go-cty/1")
+		buf, err := ctyjson.Marshal(v, ty)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(%s, %s): %v", v.GoString(), tyString(ty), err)
+			return
+		}
+		got, err, panicked := recovering(func() (cty.Value, error) { return ctyjson.Unmarshal(buf, ty) })
+		if panicked != nil {
+			c.mismatch(ht, "unmarshal panic", shape, "Unmarshal(%s, %s) panics: %v (value %s)", buf, tyString(ty), panicked, v.GoString())
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, "unmarshal", shape, "Unmarshal(%s, %s): %v (value %s)", buf, tyString(ty), err, v.GoString())
+			return
+		}
+		if !got.RawEquals(v) {
+			c.mismatch(ht, "value", shape, "round trip of %s as %s gives %s (JSON %s)", v.GoString(), tyString(ty), got.GoString(), buf)
+			return
+		}
+		// the type
+		tbuf, err := ctyjson.MarshalType(ty)
+		if err != nil {
+			c.failClass(ht, "marshal type", "MarshalType(%s): %v", tyString(ty), err)
+			return
+		}
+		ty2, err := ctyjson.UnmarshalType(tbuf)
+		if err != nil || !ty2.Equals(ty) {
+			c.failClass(ht, "type", "type round trip of %s gives %s, %v (JSON %s)", tyString(ty), tyString(ty2), err, tbuf)
+			return
+		}
+		// the implied type: for a value without dynamic placeholders the buffer is plain JSON
+		if !hasDynamic(ty) {
+			ity, err := ctyjson.ImpliedType(buf)
+			if err != nil {
+				c.failClass(ht, "implied", "ImpliedType(%s): %v", buf, err)
+				return
+			}
+			iv, err := ctyjson.Unmarshal(buf, ity)
+			if err != nil {
+				c.failClass(ht, "implied unmarshal", "Unmarshal(%s, implied %s): %v", buf, tyString(ity), err)
+				return
+			}
+			back, err := convert.Convert(iv, ty)
+			if err != nil {
+				c.failClass(ht, "implied convert", "Convert(%s, %s) after ImpliedType: %v (JSON %s)", iv.GoString(), tyString(ty), err, buf)
+				return
+			}
+			if !back.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "implied value", "value read with the implied type %s and converted back is %s, not %s (JSON %s)", tyString(ity), back.GoString(), v.GoString(), buf)
+				return
+			}
+			var sv ctyjson.SimpleJSONValue
+			if err := json.Unmarshal(buf, &sv); err != nil {
+				c.failClass(ht, "simple", "SimpleJSONValue does not read %s: %v", buf, err)
+				return
+			}
+			back2, err := convert.Convert(sv.Value, ty)
+			if err != nil {
+				c.failClass(ht, "simple convert", "Convert(%s, %s) after SimpleJSONValue: %v (JSON %s)", sv.Value.GoString(), tyString(ty), err, buf)
+				return
+			}
+			if !back2.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "simple value", "SimpleJSONValue %s converted back is %s, not %s (JSON %s)", sv.Value.GoString(), back2.GoString(), v.GoString(), buf)
+				return
+			}
+			out, err := json.Marshal(ctyjson.SimpleJSONValue{Value: v})
+			if err != nil {
+				c.failClass(ht, "simple marshal", "json.Marshal(SimpleJSONValue{%s}): %v", v.GoString(), err)
+				return
+			}
+			var sv2 ctyjson.SimpleJSONValue
+			if err := json.Unmarshal(out, &sv2); err != nil {
+				c.failClass(ht, "simple reread", "SimpleJSONValue does not read its own output %s: %v", out, err)
+				return
+			}
+		}
+	})
+}
