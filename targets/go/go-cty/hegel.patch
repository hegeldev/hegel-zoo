+// --------------------------------------------------------------------------- round trips
+
+var (
+	// jsonCases: a type with placeholders up to three deep and a value of it with nulls at a
+	// tenth of the positions.
+	jsonCases = typedValuesOf(dynamicTypes, valueOpts{nullPct: 10})
+	// msgpackCases: the same, half the time with unknowns at a tenth of the positions too.
+	msgpackCases = hegel.FlatMap(hegel.SampledFrom([]int{0, 10}), func(unknownPct int) hegel.Generator[typed] {
+		return typedValuesOf(dynamicTypes, valueOpts{nullPct: 10, unknownPct: unknownPct})
