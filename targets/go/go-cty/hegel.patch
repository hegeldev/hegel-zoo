+// --------------------------------------------------------------------------- format
+
+type fmtSeg struct {
+	lit  string
+	verb string // "s", "d", "v", "t", "q", "f", "x", "o", "b"
+	raw  string // the full verb text
+	arg  cty.Value
+	want string
+}
+
+func TestHegelFormat(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		var format strings.Builder
+		var want strings.Builder
+		var args []cty.Value
+		var argDesc []string
+		var verbs []string
+		n := drawInt(ht, 0, 4)
+		for i := 0; i < n; i++ {
+			if chance(ht, 50) {
+				lit := pick(ht, []string{"x", " ", "a-b", "%%", "日", "=", "\n"})
+				format.WriteString(lit)
+				want.WriteString(strings.ReplaceAll(lit, "%%", "%"))
+			}
+			verb := pick(ht, []string{"s", "s", "d", "v", "t", "q", "f", "x", "o", "b", "X"})
+			flags := ""
+			width := -1
+			prec := -1
+			if chance(ht, 30) && verb != "v" && verb != "t" && verb != "q" {
+				if chance(ht, 40) {
+					flags += "-"
+				} else if chance(ht, 30) && verb != "s" {
+					flags += "0"
+				}
+				if chance(ht, 30) && verb != "s" {
+					flags += "+"
+				}
+				width = drawInt(ht, 0, 8)
+			}
+			if chance(ht, 30) && (verb == "s" || verb == "f") {
+				prec = drawInt(ht, 0, 4)
+			}
+			raw := "%" + flags
+			if width >= 0 {
+				raw += itoa(width)
+			}
+			if prec >= 0 {
+				raw += "." + itoa(prec)
+			}
+			raw += verb
+			format.WriteString(raw)
+			verbs = append(verbs, verb)
+
+			var arg cty.Value
+			var w string
+			switch verb {
+			case "s":
+				s := pick(ht, []string{"", "a", "hello", "Hello World", "日本語", "🙂", "ab cd", "x_y"})
+				arg = cty.StringVal(s)
+				if chance(ht, 20) {
+					arg = cty.NumberIntVal(int64(drawInt(ht, -50, 50)))
+					s = numStr(arg)
+				} else if chance(ht, 10) {
+					arg = cty.BoolVal(chance(ht, 50))
+					s = fmt.Sprint(arg.True())
+				}
+				r := []rune(s)
+				if prec == 0 && Known.formatZeroPrecision {
+					prec = -1 // precision 0 is ignored
+				}
+				if prec >= 0 && prec < len(r) {
+					r = r[:prec]
+				}
+				w = string(r)
+				if width > len(r) {
+					pad := strings.Repeat(" ", width-len(r))
+					if strings.Contains(flags, "-") {
+						w = w + pad
+					} else {
+						w = pad + w
+					}
+				}
+			case "d", "x", "o", "b", "X":
+				i := int64(drawInt(ht, -300, 300))
+				if chance(ht, 15) {
+					i = 1 << 40
+				}
+				arg = cty.NumberIntVal(i)
+				w = fmt.Sprintf(raw, big.NewInt(i))
+			case "f":
+				arg = genNumber(ht)
+				w = fmt.Sprintf(raw, arg.AsBigFloat())
+			case "t":
+				arg = cty.BoolVal(chance(ht, 50))
+				w = fmt.Sprint(arg.True())
+			case "q":
+				s := pick(ht, plainStrings)
+				arg = cty.StringVal(s)
+				jb, _ := json.Marshal(s)
+				w = string(jb)
+			case "v":
+				switch drawInt(ht, 1, 3) {
+				case 1:
+					s := pick(ht, plainStrings)
+					arg = cty.StringVal(s)
+					w = s
+				case 2:
+					arg = genNumber(ht)
+					w = arg.AsBigFloat().Text('g', -1)
+				default:
+					arg = cty.BoolVal(chance(ht, 50))
+					w = fmt.Sprint(arg.True())
+				}
+			}
+			args = append(args, arg)
+			argDesc = append(argDesc, arg.GoString())
+			want.WriteString(w)
+		}
+		if chance(ht, 50) {
+			lit := pick(ht, []string{"!", " end", "%%", "日"})
+			format.WriteString(lit)
+			want.WriteString(strings.ReplaceAll(lit, "%%", "%"))
+		}
+		got, err := stdlib.Format(cty.StringVal(format.String()), args...)
+		if err != nil {
+			c.failClass(ht, "Format", "Format(%q, %s): %v", format.String(), argDesc, err)
+		} else if !got.IsKnown() || got.Type() != cty.String {
+			c.failClass(ht, "Format", "Format(%q, %s) = %s", format.String(), argDesc, got.GoString())
+		} else if got.AsString() != want.String() {
+			c.failClass(ht, "Format", "Format(%q, %s) = %q, want %q", format.String(), argDesc, got.AsString(), want.String())
+		}
+
+		// too few arguments fail; a null argument fails; an unknown one gives an unknown
+		if n > 0 {
+			if got, err := stdlib.Format(cty.StringVal(format.String()), args[:n-1]...); err == nil {
+				c.failClass(ht, "Format args", "Format(%q) with %d of %d arguments = %s, want an error", format.String(), n-1, n, got.GoString())
+			}
+			// a null argument: "null" for %v, an error otherwise
+			nulled := append([]cty.Value(nil), args...)
+			nulled[0] = cty.NullVal(args[0].Type())
+			got, err := stdlib.Format(cty.StringVal(format.String()), nulled...)
+			if verbs[0] == "v" {
+				if err != nil || !strings.Contains(got.AsString(), "null") {
+					c.failClass(ht, "Format null", "Format(%q) with a null argument for %%v = %s, %v; want \"null\"", format.String(), got.GoString(), err)
+				}
+			} else if err == nil {
+				c.failClass(ht, "Format null", "Format(%q) with a null argument = %s, want an error", format.String(), got.GoString())
+			}
+			unk := append([]cty.Value(nil), args...)
+			unk[0] = cty.UnknownVal(args[0].Type())
+			if got, err := stdlib.Format(cty.StringVal(format.String()), unk...); err != nil || got.IsKnown() {
+				c.failClass(ht, "Format unknown", "Format(%q) with an unknown argument = %s, %v; want an unknown string", format.String(), got.GoString(), err)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- regex
+
+var regexPatterns = []struct {
+	pat   string
+	named bool // has named groups
+	n     int  // number of groups
+}{
+	{`a`, false, 0},
+	{`[0-9]+`, false, 0},
+	{`([0-9]+)`, false, 1},
+	{`(a)(b)?`, false, 2},
+	{`(?P<x>[a-z]+)`, true, 1},
+	{`(?P<k>[a-z]+)=(?P<v>[0-9]*)`, true, 2},
+	{`(?P<a>a)(?P<b>b)?c`, true, 2},
+	{`h(el)+o`, false, 1},
+	{`^$`, false, 0},
+	{`.`, false, 0},
+}
+
+var regexSubjects = []string{"", "a", "abc", "ab", "123", "x=12,y=3", "hello", "aac", "héllo 42", "k=", "helelo"}
+
+func TestHegelRegex(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := pick(ht, regexPatterns)
+		s := pick(ht, regexSubjects)
+		re := regexp.MustCompile(p.pat)
+
+		// the model of one match from its submatch indexes
+		model := func(idx []int) cty.Value {
+			switch {
+			case p.n == 0:
+				return cty.StringVal(s[idx[0]:idx[1]])
+			case p.named:
+				attrs := map[string]cty.Value{}
+				for gi, name := range re.SubexpNames() {
+					if gi == 0 {
+						continue
+					}
+					if idx[2*gi] < 0 {
+						attrs[name] = cty.NullVal(cty.String)
+					} else {
+						attrs[name] = cty.StringVal(s[idx[2*gi]:idx[2*gi+1]])
+					}
+				}
+				return cty.ObjectVal(attrs)
+			default:
+				var elems []cty.Value
+				for gi := 1; gi <= p.n; gi++ {
+					if idx[2*gi] < 0 {
+						elems = append(elems, cty.NullVal(cty.String))
+					} else {
+						elems = append(elems, cty.StringVal(s[idx[2*gi]:idx[2*gi+1]]))
+					}
+				}
+				return cty.TupleVal(elems)
+			}
+		}
+
+		first := re.FindStringSubmatchIndex(s)
+		got, err := stdlib.Regex(cty.StringVal(p.pat), cty.StringVal(s))
+		switch {
+		case first == nil:
+			if err == nil {
+				c.failClass(ht, "Regex", "Regex(%q, %q) = %s, want an error (no match)", p.pat, s, got.GoString())
+			}
+		case err != nil:
+			c.failClass(ht, "Regex", "Regex(%q, %q): %v", p.pat, s, err)
+		default:
+			if want := model(first); !got.RawEquals(want) {
+				c.failClass(ht, "Regex", "Regex(%q, %q) = %s, want %s", p.pat, s, got.GoString(), want.GoString())
+			}
+		}
+
+		all := re.FindAllStringSubmatchIndex(s, -1)
+		gotAll, err := stdlib.RegexAll(cty.StringVal(p.pat), cty.StringVal(s))
+		if err != nil {
+			c.failClass(ht, "RegexAll", "RegexAll(%q, %q): %v", p.pat, s, err)
+		} else if !gotAll.Type().IsListType() {
+			c.failClass(ht, "RegexAll", "RegexAll(%q, %q) = %s, want a list", p.pat, s, gotAll.GoString())
+		} else {
+			var want []cty.Value
+			for _, idx := range all {
+				want = append(want, model(idx))
+			}
+			if !sameElems(elemsOf(gotAll), want) {
+				c.failClass(ht, "RegexAll", "RegexAll(%q, %q) = %s, want %v", p.pat, s, gotAll.GoString(), want)
+			}
+		}
+
+		// RegexReplace against Go's ReplaceAllString
+		rep := pick(ht, []string{"", "_", "[$0]", "$1", "${x}"})
+		if strings.Contains(rep, "$1") && p.n == 0 {
+			rep = "_"
+		}
+		if strings.Contains(rep, "${x}") && !(p.named && re.SubexpIndex("x") >= 0) {
+			rep = "_"
+		}
+		gotR, err := stdlib.RegexReplace(cty.StringVal(s), cty.StringVal(p.pat), cty.StringVal(rep))
+		if err != nil {
+			c.failClass(ht, "RegexReplace", "RegexReplace(%q, %q, %q): %v", s, p.pat, rep, err)
+		} else if want := re.ReplaceAllString(s, rep); gotR.AsString() != want {
+			c.failClass(ht, "RegexReplace", "RegexReplace(%q, %q, %q) = %q, want %q", s, p.pat, rep, gotR.AsString(), want)
+		}
+
+		// an invalid pattern fails
+		if got, err := stdlib.Regex(cty.StringVal("("), cty.StringVal(s)); err == nil {
+			c.failClass(ht, "Regex", "Regex(\"(\", %q) = %s, want an error", s, got.GoString())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- JSON, CSV
+
+func TestHegelJSONFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ty := genType(ht, typeOpts{depth: 3})
+		v := genValue(ht, ty, valueOpts{nullPct: 10})
+		enc, err := stdlib.JSONEncode(v)
+		if err != nil {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s): %v", v.GoString(), err)
+			return
+		}
+		if enc.Type() != cty.String || !enc.IsKnown() {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s) = %s", v.GoString(), enc.GoString())
+			return
+		}
+		if !json.Valid([]byte(enc.AsString())) {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s) = %q is not JSON", v.GoString(), enc.AsString())
+			return
+		}
+		dec, err := stdlib.JSONDecode(enc)
+		if err != nil {
+			c.failClass(ht, "JSONDecode", "JSONDecode(%q): %v", enc.AsString(), err)
+			return
+		}
+		if hasSet(ty) {
+			// sets come back as tuples; their order is not part of the value
+			return
+		}
+		back, err := convert.Convert(dec, ty)
+		if err != nil {
+			c.failClass(ht, "convert back", "JSONDecode(%q) = %s does not convert to %s: %v", enc.AsString(), dec.GoString(), tyString(ty), err)
+			return
+		}
+		if !back.RawEquals(v) {
+			c.failClass(ht, "round trip", "JSONEncode/JSONDecode of %s (%s) gives %s (JSON %s)", v.GoString(), tyString(ty), back.GoString(), enc.AsString())
+		}
+		// an unknown encodes to an unknown string, invalid JSON fails to decode
+		if u, err := stdlib.JSONEncode(cty.UnknownVal(ty)); err != nil || u.IsKnown() {
+			c.failClass(ht, "unknown", "JSONEncode(unknown %s) = %s, %v", tyString(ty), u.GoString(), err)
+		}
+		trailing := pick(ht, []string{"]", "}", " x", " 1", "]]"})
+		if Known.jsonDecodeTrailingBrackets && strings.Trim(trailing, "]}") == "" {
+			trailing = " x" // a trailing bracket is not noticed
+		}
+		if got, err := stdlib.JSONDecode(cty.StringVal(enc.AsString() + trailing)); err == nil {
+			c.failClass(ht, "invalid", "JSONDecode(%q) = %s, want an error", enc.AsString()+trailing, got.GoString())
+		}
+	})
+}
+
+var csvCells = []string{"", "a", "hello world", "1", "with,comma", `with "quote"`, "multi\nline", " padded ", "日本語", "-0"}
+
+func TestHegelCSVDecode(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		// distinct header names, rows of cells
+		cols := drawInt(ht, 1, 4)
+		var header []string
+		seen := map[string]bool{}
+		for len(header) < cols {
+			h := pick(ht, []string{"a", "b", "name", "id", "x y", "Z", "with,comma", `q"uote`})
+			if !seen[h] {
+				seen[h] = true
+				header = append(header, h)
+			}
+		}
+		rows := drawInt(ht, 0, 4)
+		var records [][]string
+		records = append(records, header)
+		for i := 0; i < rows; i++ {
+			row := make([]string, cols)
+			for j := range row {
+				row[j] = pick(ht, csvCells)
+				if cols == 1 && row[j] == "" {
+					row[j] = "x" // an empty line is not a record
+				}
+			}
+			records = append(records, row)
+		}
+		var buf bytes.Buffer
+		w := csv.NewWriter(&buf)
+		if chance(ht, 30) {
+			w.UseCRLF = true
+		}
+		if err := w.WriteAll(records); err != nil {
+			ht.Fatalf("csv writer: %v", err)
+		}
+		text := buf.String()
+		got, err := stdlib.CSVDecode(cty.StringVal(text))
+		if err != nil {
+			c.failClass(ht, "CSVDecode", "CSVDecode(%q): %v", text, err)
+			return
+		}
+		attrs := map[string]cty.Type{}
+		for _, h := range header {
+			attrs[h] = cty.String
+		}
+		wantTy := cty.List(cty.Object(attrs))
+		if !got.Type().Equals(wantTy) {
+			c.failClass(ht, "CSVDecode type", "CSVDecode(%q) has type %s, want %s", text, tyString(got.Type()), tyString(wantTy))
+			return
+		}
+		var want cty.Value
+		if rows == 0 {
+			want = cty.ListValEmpty(cty.Object(attrs))
+		} else {
+			var elems []cty.Value
+			for _, row := range records[1:] {
+				m := map[string]cty.Value{}
+				for j, h := range header {
+					m[h] = cty.StringVal(row[j])
+				}
+				elems = append(elems, cty.ObjectVal(m))
+			}
+			want = cty.ListVal(elems)
+		}
+		if !got.RawEquals(want) {
+			c.failClass(ht, "CSVDecode", "CSVDecode(%q) = %s, want %s", text, got.GoString(), want.GoString())
+		}
+		// a ragged table fails
+		if rows > 0 && cols > 1 {
+			ragged := text + "x\n"
+			if got, err := stdlib.CSVDecode(cty.StringVal(ragged)); err == nil {
+				c.failClass(ht, "CSVDecode ragged", "CSVDecode(%q) = %s, want an error", ragged, got.GoString())
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- dates
+
+var dateTokens = []struct{ tok, layout string }{
+	{"YY", "06"}, {"YYYY", "2006"}, {"M", "1"}, {"MM", "01"}, {"MMM", "Jan"}, {"MMMM", "January"},
+	{"D", "2"}, {"DD", "02"}, {"EEE", "Mon"}, {"EEEE", "Monday"},
+	{"h", "H24"}, {"hh", "15"}, {"H", "3"}, {"HH", "03"}, {"AA", "PM"}, {"aa", "pm"},
+	{"m", "4"}, {"mm", "04"}, {"s", "5"}, {"ss", "05"},
+	{"ZZZZ", "-0700"}, {"ZZZZZ", "-07:00"}, {"Z", "Z07:00"}, {"ZZZ", "UTC"},
+}
+
+func genTime(tc hegel.TestCase) time.Time {
+	secs := int64(drawInt(tc, -1500000000, 2500000000))
+	off := 0
+	if chance(tc, 50) {
+		off = drawInt(tc, -14, 14)*3600 + pick(tc, []int{0, 0, 30 * 60, 45 * 60})
+	}
+	loc := time.UTC
+	if off != 0 {
+		loc = time.FixedZone("", off)
+	}
+	return time.Unix(secs, 0).In(loc)
+}
+
+func TestHegelFormatDate(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tm := genTime(ht)
+		ts := tm.Format(time.RFC3339)
+		var format, want strings.Builder
+		n := drawInt(ht, 1, 5)
+		for i := 0; i < n; i++ {
+			tk := pick(ht, dateTokens)
+			format.WriteString(tk.tok)
+			switch tk.layout {
+			case "H24":
+				want.WriteString(itoa(tm.Hour()))
+			case "UTC":
+				s := tm.Format("-0700")
+				if s == "+0000" {
+					s = "UTC"
+				}
+				want.WriteString(s)
+			default:
+				want.WriteString(tm.Format(tk.layout))
+			}
+			if i < n-1 || chance(ht, 30) {
+				sep := pick(ht, []string{"-", ":", " ", "/", ".", "'at'", "'T'", "''", "_", ","})
+				format.WriteString(sep)
+				if strings.HasPrefix(sep, "'") {
+					sep = strings.Trim(sep, "'")
+					if sep == "" {
+						sep = "'"
+					}
+				}
+				want.WriteString(sep)
+			}
+		}
+		got, err := stdlib.FormatDate(cty.StringVal(format.String()), cty.StringVal(ts))
+		if err != nil {
+			c.failClass(ht, "FormatDate", "FormatDate(%q, %q): %v", format.String(), ts, err)
+		} else if got.AsString() != want.String() {
+			c.failClass(ht, "FormatDate", "FormatDate(%q, %q) = %q, want %q", format.String(), ts, got.AsString(), want.String())
+		}
+		// an invalid timestamp fails
+		if got, err := stdlib.FormatDate(cty.StringVal(format.String()), cty.StringVal("2020-13-01T00:00:00Z")); err == nil {
+			c.failClass(ht, "FormatDate invalid", "FormatDate(%q, month 13) = %s, want an error", format.String(), got.GoString())
+		}
+
+		// TimeAdd against Go
+		dur := pick(ht, []string{"1h", "-2h5m", "1.5h", "30s", "1000ms", "0s", "24h", "-1h30m10s", "1h1m1s"})
+		got, err = stdlib.TimeAdd(cty.StringVal(ts), cty.StringVal(dur))
+		d, _ := time.ParseDuration(dur)
+		if err != nil {
+			c.failClass(ht, "TimeAdd", "TimeAdd(%q, %q): %v", ts, dur, err)
+		} else if wantT := tm.Add(d); got.AsString() != wantT.Format(time.RFC3339) {
+			c.failClass(ht, "TimeAdd", "TimeAdd(%q, %q) = %q, want %q", ts, dur, got.AsString(), wantT.Format(time.RFC3339))
+		}
+		if got, err := stdlib.TimeAdd(cty.StringVal(ts), cty.StringVal("1 hour")); err == nil {
+			c.failClass(ht, "TimeAdd invalid", "TimeAdd(%q, \"1 hour\") = %s, want an error", ts, got.GoString())
+		}
+	})
+}
