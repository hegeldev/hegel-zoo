+package hegel
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/convert"
+	ctyjson "github.com/zclconf/go-cty/cty/json"
+	ctymsgpack "github.com/zclconf/go-cty/cty/msgpack"
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelJSONRoundTrip: a value marshalled with its type unmarshals, with the same type, to an
+// equal value ("it is guaranteed that values will round-trip through JSON serialization to
+// produce a value of the same type"); the type itself round-trips through MarshalType; the
+// implied type of the buffer reads it to a value that converts back to the original; and
+// SimpleJSONValue reads any buffer the type-preserving marshaller wrote.
+func TestHegelJSONRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ty := genType(ht, typeOpts{dynamic: true, depth: 3})
+		v := genValue(ht, ty, valueOpts{nullPct: 10})
+		buf, err := ctyjson.Marshal(v, ty)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(%s, %s): %v", v.GoString(), tyString(ty), err)
+			return
+		}
+		got, err := ctyjson.Unmarshal(buf, ty)
+		if err != nil {
+			c.failClass(ht, "unmarshal", "Unmarshal(%s, %s): %v (value %s)", buf, tyString(ty), err, v.GoString())
+			return
+		}
+		if !got.RawEquals(v) {
+			c.failClass(ht, "value", "round trip of %s as %s gives %s (JSON %s)", v.GoString(), tyString(ty), got.GoString(), buf)
+			return
+		}
+		// the type
+		tbuf, err := ctyjson.MarshalType(ty)
+		if err != nil {
+			c.failClass(ht, "marshal type", "MarshalType(%s): %v", tyString(ty), err)
+			return
+		}
+		ty2, err := ctyjson.UnmarshalType(tbuf)
+		if err != nil || !ty2.Equals(ty) {
+			c.failClass(ht, "type", "type round trip of %s gives %s, %v (JSON %s)", tyString(ty), tyString(ty2), err, tbuf)
+			return
+		}
+		// the implied type: for a value without dynamic placeholders the buffer is plain JSON
+		if !hasDynamic(ty) {
+			ity, err := ctyjson.ImpliedType(buf)
+			if err != nil {
+				c.failClass(ht, "implied", "ImpliedType(%s): %v", buf, err)
+				return
+			}
+			iv, err := ctyjson.Unmarshal(buf, ity)
+			if err != nil {
+				c.failClass(ht, "implied unmarshal", "Unmarshal(%s, implied %s): %v", buf, tyString(ity), err)
+				return
+			}
+			back, err := convert.Convert(iv, ty)
+			if err != nil {
+				c.failClass(ht, "implied convert", "Convert(%s, %s) after ImpliedType: %v (JSON %s)", iv.GoString(), tyString(ty), err, buf)
+				return
+			}
+			if !back.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "implied value", "value read with the implied type %s and converted back is %s, not %s (JSON %s)", tyString(ity), back.GoString(), v.GoString(), buf)
+				return
+			}
+			var sv ctyjson.SimpleJSONValue
+			if err := json.Unmarshal(buf, &sv); err != nil {
+				c.failClass(ht, "simple", "SimpleJSONValue does not read %s: %v", buf, err)
+				return
+			}
+			back2, err := convert.Convert(sv.Value, ty)
+			if err != nil {
+				c.failClass(ht, "simple convert", "Convert(%s, %s) after SimpleJSONValue: %v (JSON %s)", sv.Value.GoString(), tyString(ty), err, buf)
+				return
+			}
+			if !back2.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "simple value", "SimpleJSONValue %s converted back is %s, not %s (JSON %s)", sv.Value.GoString(), back2.GoString(), v.GoString(), buf)
+				return
+			}
+			out, err := json.Marshal(ctyjson.SimpleJSONValue{Value: v})
+			if err != nil {
+				c.failClass(ht, "simple marshal", "json.Marshal(SimpleJSONValue{%s}): %v", v.GoString(), err)
+				return
+			}
+			var sv2 ctyjson.SimpleJSONValue
+			if err := json.Unmarshal(out, &sv2); err != nil {
+				c.failClass(ht, "simple reread", "SimpleJSONValue does not read its own output %s: %v", out, err)
+				return
+			}
+		}
+	})
+}
+
+// TestHegelMsgpackRoundTrip: the msgpack serialization round-trips values with their type,
+// unknown values included, and the implied type reads a buffer without unknowns back.
+func TestHegelMsgpackRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ty := genType(ht, typeOpts{dynamic: true, depth: 3})
+		unknownPct := 0
+		if chance(ht, 50) {
+			unknownPct = 10
+		}
+		v := genValue(ht, ty, valueOpts{nullPct: 10, unknownPct: unknownPct})
+		buf, err := ctymsgpack.Marshal(v, ty)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(%s, %s): %v", v.GoString(), tyString(ty), err)
+			return
+		}
+		got, err := ctymsgpack.Unmarshal(buf, ty)
+		if err != nil {
+			c.failClass(ht, "unmarshal", "Unmarshal(%x, %s): %v (value %s)", buf, tyString(ty), err, v.GoString())
+			return
+		}
+		if !got.RawEquals(v) {
+			c.failClass(ht, "value", "round trip of %s as %s gives %s", v.GoString(), tyString(ty), got.GoString())
+			return
+		}
+		if !hasDynamic(ty) && v.IsWhollyKnown() {
+			ity, err := ctymsgpack.ImpliedType(buf)
+			if err != nil {
+				c.failClass(ht, "implied", "ImpliedType(%x): %v (value %s)", buf, err, v.GoString())
+				return
+			}
+			iv, err := ctymsgpack.Unmarshal(buf, ity)
+			if err != nil {
+				c.failClass(ht, "implied unmarshal", "Unmarshal(%x, implied %s): %v", buf, tyString(ity), err)
+				return
+			}
+			back, err := convert.Convert(iv, ty)
+			if err != nil {
+				c.failClass(ht, "implied convert", "Convert(%s, %s) after ImpliedType: %v", iv.GoString(), tyString(ty), err)
+				return
+			}
+			if !back.RawEquals(v) && !hasSet(ty) {
+				c.failClass(ht, "implied value", "value read with the implied type %s and converted back is %s, not %s", tyString(ity), back.GoString(), v.GoString())
+				return
+			}
+		}
+	})
+}
+
+// genRelatedType draws a target type for a conversion from ty: a structural cousin (list, set
+// or tuple of the same elements; map or object of the same attributes), a type with one
+// primitive swapped, or an unrelated type.
+func genRelatedType(tc hegel.TestCase, ty cty.Type) cty.Type {
+	switch drawInt(tc, 1, 4) {
+	case 1:
+		return genType(tc, typeOpts{dynamic: chance(tc, 30), depth: 2})
+	case 2:
+		return swapPrimitive(tc, ty)
+	default:
+		return cousin(tc, ty)
+	}
+}
+
+// swapPrimitive replaces one primitive somewhere in the type by another primitive.
+func swapPrimitive(tc hegel.TestCase, ty cty.Type) cty.Type {
+	switch {
+	case ty.IsPrimitiveType():
+		return genPrimitiveType(tc, false)
+	case ty.IsListType():
+		return cty.List(swapPrimitive(tc, ty.ElementType()))
+	case ty.IsSetType():
+		return cty.Set(swapPrimitive(tc, ty.ElementType()))
+	case ty.IsMapType():
+		return cty.Map(swapPrimitive(tc, ty.ElementType()))
+	case ty.IsObjectType():
+		attrs := map[string]cty.Type{}
+		for k, a := range ty.AttributeTypes() {
+			attrs[k] = a
+		}
+		if len(attrs) > 0 {
+			k := pick(tc, sortedKeys(attrs))
+			attrs[k] = swapPrimitive(tc, attrs[k])
+		}
+		return cty.Object(attrs)
+	case ty.IsTupleType():
+		elems := append([]cty.Type{}, ty.TupleElementTypes()...)
+		if len(elems) > 0 {
+			i := drawInt(tc, 0, len(elems)-1)
+			elems[i] = swapPrimitive(tc, elems[i])
+		}
+		return cty.Tuple(elems)
+	}
+	return ty
+}
+
+func sortedKeys(m map[string]cty.Type) []string {
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	sortStrings(out)
+	return out
+}
+
+// cousin: the same elements in another kind.
+func cousin(tc hegel.TestCase, ty cty.Type) cty.Type {
+	switch {
+	case ty.IsListType() || ty.IsSetType():
+		switch drawInt(tc, 1, 3) {
+		case 1:
+			return cty.List(ty.ElementType())
+		case 2:
+			return cty.Set(ty.ElementType())
+		default:
+			n := drawInt(tc, 0, 3)
+			elems := make([]cty.Type, n)
+			for i := range elems {
+				elems[i] = ty.ElementType()
+			}
+			return cty.Tuple(elems)
+		}
+	case ty.IsTupleType():
+		ets := ty.TupleElementTypes()
+		if len(ets) == 0 {
+			return pick(tc, []cty.Type{cty.List(cty.String), cty.Set(cty.Number), cty.EmptyTuple})
+		}
+		e := pick(tc, ets)
+		if chance(tc, 50) {
+			return cty.List(e)
+		}
+		return cty.Set(e)
+	case ty.IsMapType():
+		attrs := map[string]cty.Type{}
+		for i, n := 0, drawInt(tc, 0, 3); i < n; i++ {
+			attrs[pick(tc, attrNames)] = ty.ElementType()
+		}
+		return cty.Object(attrs)
+	case ty.IsObjectType():
+		ats := ty.AttributeTypes()
+		if len(ats) == 0 {
+			return cty.Map(genPrimitiveType(tc, false))
+		}
+		if chance(tc, 50) {
+			return cty.Map(ats[pick(tc, sortedKeys(ats))])
+		}
+		// the same object with an attribute dropped or added
+		attrs := map[string]cty.Type{}
+		for k, a := range ats {
+			attrs[k] = a
+		}
+		if chance(tc, 50) {
+			delete(attrs, pick(tc, sortedKeys(ats)))
+		} else {
+			attrs[pick(tc, attrNames)] = genPrimitiveType(tc, false)
+		}
+		return cty.Object(attrs)
+	default:
+		return genPrimitiveType(tc, false)
+	}
+}
+
+// TestHegelConversionRules: a safe conversion never fails and yields the target type; Convert
+// succeeds exactly when an unsafe conversion exists (or the types are equal) and yields the
+// target type; converting back along a safe, lossless path gives the original value.
+func TestHegelConversionRules(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ty := genType(ht, typeOpts{depth: 3})
+		v := genValue(ht, ty, valueOpts{nullPct: 8})
+		want := genRelatedType(ht, ty)
+		if want.Equals(ty) {
+			out, err := convert.Convert(v, want)
+			if err != nil || !out.RawEquals(v) {
+				c.failClass(ht, "identity", "Convert(%s, its own type %s) = %s, %v", v.GoString(), tyString(ty), out.GoString(), err)
+			}
+			return
+		}
+		safe := convert.GetConversion(ty, want)
+		unsafe := convert.GetConversionUnsafe(ty, want)
+		if safe != nil && unsafe == nil {
+			c.failClass(ht, "safe not unsafe", "GetConversion(%s, %s) exists but GetConversionUnsafe does not", tyString(ty), tyString(want))
+			return
+		}
+		if safe != nil {
+			out, err := safe(v)
+			if err != nil {
+				c.failClass(ht, "safe fails", "the safe conversion %s -> %s fails on %s: %v", tyString(ty), tyString(want), v.GoString(), err)
+				return
+			}
+			if !hasDynamic(want) && !out.Type().Equals(want) {
+				c.failClass(ht, "safe type", "the safe conversion %s -> %s gives %s of type %s", tyString(ty), tyString(want), out.GoString(), tyString(out.Type()))
+				return
+			}
+		}
+		out, err := convert.Convert(v, want)
+		if unsafe == nil {
+			if err == nil {
+				c.failClass(ht, "no conversion", "GetConversionUnsafe(%s, %s) is nil but Convert(%s) = %s", tyString(ty), tyString(want), v.GoString(), out.GoString())
+			}
+			return
+		}
+		if err != nil {
+			if safe != nil {
+				c.failClass(ht, "convert safe fails", "Convert(%s, %s) fails though a safe conversion exists: %v", v.GoString(), tyString(want), err)
+			}
+			c.count("unsafe error")
+			return
+		}
+		if !hasDynamic(want) && !out.Type().Equals(want) {
+			c.failClass(ht, "convert type", "Convert(%s, %s) = %s of type %s", v.GoString(), tyString(want), out.GoString(), tyString(out.Type()))
+			return
+		}
+		if v.IsNull() && !out.IsNull() || !v.IsNull() && out.IsNull() {
+			c.failClass(ht, "nullness", "Convert(%s, %s) = %s: nullness changed", v.GoString(), tyString(want), out.GoString())
+			return
+		}
+		// back along a safe, lossless path
+		if safe != nil && !hasSet(want) && !hasDynamic(want) && !hasDynamic(ty) {
+			back, err := convert.Convert(out, ty)
+			if err != nil {
+				c.count("no way back")
+				return
+			}
+			if !back.RawEquals(v) {
+				c.failClass(ht, "round trip", "%s -> %s -> %s: %s became %s via %s", tyString(ty), tyString(want), tyString(ty), v.GoString(), back.GoString(), out.GoString())
+				return
+			}
+		}
+	})
+}
+
+// TestHegelUnification: the type Unify returns is one every input type converts to, with the
+// conversions it hands back; UnifyUnsafe the same, the conversions allowed to fail on some
+// values but never on the type.
+func TestHegelUnification(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		n := drawInt(ht, 1, 3)
+		var types []cty.Type
+		var vals []cty.Value
+		base := genType(ht, typeOpts{depth: 2})
+		for i := 0; i < n; i++ {
+			ty := base
+			if i > 0 {
+				ty = genRelatedType(ht, base)
+			}
+			types = append(types, ty)
+			vals = append(vals, genValue(ht, ty, valueOpts{nullPct: 5}))
+		}
+		for _, unsafe := range []bool{false, true} {
+			var uty cty.Type
+			var convs []convert.Conversion
+			if unsafe {
+				uty, convs = convert.UnifyUnsafe(types)
+			} else {
+				uty, convs = convert.Unify(types)
+			}
+			if uty == cty.NilType {
+				c.count("no unification")
+				continue
+			}
+			if len(convs) != len(types) {
+				c.failClass(ht, "conversions", "Unify(%v) returned %d conversions for %d types", types, len(convs), len(types))
+				return
+			}
+			for i, ty := range types {
+				if convs[i] == nil {
+					if !ty.Equals(uty) {
+						c.failClass(ht, "nil conversion", "Unify(%v) = %s with a nil conversion for %s", types, tyString(uty), tyString(ty))
+						return
+					}
+					continue
+				}
+				out, err := convs[i](vals[i])
+				if err != nil {
+					if !unsafe {
+						c.failClass(ht, "safe unify fails", "Unify(%v) = %s: the conversion of %s fails: %v", types, tyString(uty), vals[i].GoString(), err)
+						return
+					}
+					c.count("unsafe unify error")
+					continue
+				}
+				if !hasDynamic(uty) && !out.Type().Equals(uty) {
+					c.failClass(ht, "unify type", "Unify(%v) = %s but the conversion of %s gives type %s", types, tyString(uty), vals[i].GoString(), tyString(out.Type()))
+					return
+				}
+			}
+		}
+	})
+}
