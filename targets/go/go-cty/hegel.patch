+// --------------------------------------------------------------------------- unification
+
+// unifyCase: a base type without placeholders, up to two types related to it, and a value of
+// each.
+type unifyCase struct {
+	types []cty.Type
+	vals  []cty.Value
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c unifyCase) GoString() string {
+	s := "unify"
+	for i, ty := range c.types {
+		s += fmt.Sprintf("\n  %s as %s", c.vals[i].GoString(), tyString(ty))
+	}
+	return s
+}
+
+var unifyCases = hegel.Composite(func(tc hegel.TestCase) unifyCase {
+	base := hegel.Draw(tc, plainTypes2)
+	types := append([]cty.Type{base}, hegel.Draw(tc, many(relatedTypesOf(base), 0, 2))...)
+	vals := make([]cty.Value, len(types))
+	for i, ty := range types {
+		vals[i] = hegel.Draw(tc, valuesOf(ty, valueOpts{nullPct: 5}))
+	}
+	return unifyCase{types, vals}
+})
+
+// TestHegelUnification: the type Unify returns is one every input type converts to, with the
+// conversions it hands back; UnifyUnsafe the same, the conversions allowed to fail on some
+// values but never on the type.
+func TestHegelUnification(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		uc := hegel.Draw(ht, unifyCases)
+		types, vals := uc.types, uc.vals
+		for _, unsafe := range []bool{false, true} {
+			var uty cty.Type
+			var convs []convert.Conversion
+			if unsafe {
+				uty, convs = convert.UnifyUnsafe(types)
+			} else {
+				uty, convs = convert.Unify(types)
+			}
+			if uty == cty.NilType {
+				c.count("no unification")
+				continue
+			}
+			if len(convs) != len(types) {
+				c.failClass(ht, "conversions", "Unify(%v) returned %d conversions for %d types", types, len(convs), len(types))
+				return
+			}
+			for i, ty := range types {
+				if convs[i] == nil {
+					if !ty.Equals(uty) {
+						c.failClass(ht, "nil conversion", "Unify(%v) = %s with a nil conversion for %s", types, tyString(uty), tyString(ty))
+						return
+					}
+					continue
+				}
+				out, err := convs[i](vals[i])
+				if err != nil {
+					if !unsafe {
+						c.failClass(ht, "safe unify fails", "Unify(%v) = %s: the conversion of %s fails: %v", types, tyString(uty), vals[i].GoString(), err)
+						return
+					}
+					c.count("unsafe unify error")
+					continue
+				}
+				if !hasDynamic(uty) && !out.Type().Equals(uty) {
+					c.failClass(ht, "unify type", "Unify(%v) = %s but the conversion of %s gives type %s", types, tyString(uty), vals[i].GoString(), tyString(out.Type()))
+					return
+				}
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..91f51db
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,366 @@
+package hegel
+
+// Generators of cty types and values, as values. A type comes from typesAt, a depth-indexed
+// generator memoised per depth over a weighted choice of kinds with the primitive first; a
+// value of a drawn type comes from valuesOf, a function of the type returning the generator of
+// its values (the properties FlatMap it over the type generator, so that the value follows the
+// type); numbers and strings are weighted choices over small forms and sample tables.
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+var attrNames = []string{"a", "b", "name", "id", "x_y", "Z"}
+
+var (
+	attrKeys        = hegel.SampledFrom(attrNames)
+	plainPrimitives = hegel.SampledFrom([]cty.Type{cty.String, cty.Number, cty.Bool})
+	// dynamicPrimitives: the primitives and, 15% of the time, the DynamicPseudoType placeholder.
+	dynamicPrimitives = weighted(choice[cty.Type]{85, plainPrimitives}, choice[cty.Type]{15, hegel.Just(cty.DynamicPseudoType)})
+)
+
+func primitivesOf(dynamic bool) hegel.Generator[cty.Type] {
+	if dynamic {
+		return dynamicPrimitives
+	}
+	return plainPrimitives
+}
+
+func objectOf(attrs map[string]cty.Type) cty.Type {
+	if attrs == nil {
+		attrs = map[string]cty.Type{}
+	}
+	return cty.Object(attrs)
+}
+
+func tupleOf(elems []cty.Type) cty.Type {
+	if elems == nil {
+		elems = []cty.Type{}
+	}
+	return cty.Tuple(elems)
+}
+
+type typeKey struct {
+	dynamic bool
+	depth   int
+}
+
+var typeMemo = map[typeKey]hegel.Generator[cty.Type]{}
+
+// typesAt is the generator of types nested up to depth, with DynamicPseudoType placeholders
+// when dynamic (never inside a set: a set of dynamic values is legal but its JSON form needs
+// type information the round trip does not keep for elements), memoised per (dynamic, depth):
+// a primitive first, then a list, map or set of a type one level down, an object of up to
+// three attributes or a tuple of up to three elements.
+func typesAt(dynamic bool, depth int) hegel.Generator[cty.Type] {
+	key := typeKey{dynamic, depth}
+	if g, ok := typeMemo[key]; ok {
+		return g
+	}
+	g := primitivesOf(dynamic)
+	if depth > 0 {
+		inner := typesAt(dynamic, depth-1)
+		plain := typesAt(false, depth-1)
+		g = weighted(
+			choice[cty.Type]{40, primitivesOf(dynamic)},
+			choice[cty.Type]{10, hegel.Map(inner, cty.List)},
+			choice[cty.Type]{10, hegel.Map(inner, cty.Map)},
+			choice[cty.Type]{10, hegel.Map(plain, cty.Set)},
+			choice[cty.Type]{10, hegel.Map(hegel.Maps(attrKeys, inner).MaxSize(3), objectOf)},
+			choice[cty.Type]{20, hegel.Map(many(inner, 0, 3), tupleOf)},
+		)
+	}
+	typeMemo[key] = g
+	return g
+}
+
+var (
+	dynamicTypes  = typesAt(true, 3)  // the codec round trips
+	plainTypes    = typesAt(false, 3) // conversions, the stdlib's JSON functions
+	dynamicTypes2 = typesAt(true, 2)
+	plainTypes2   = typesAt(false, 2)
+	shallowTypes  = typesAt(false, 1) // the concrete type standing in for a placeholder
+)
+
+// valueOpts steers valuesOf.
+type valueOpts struct {
+	nullPct    int  // chance of a null at any position
+	unknownPct int  // chance of an unknown at any position
+	noEmpty    bool // collections have at least one element (see elemOpts)
+}
+
+// minLen is the smallest collection length the options allow.
+func (o valueOpts) minLen() int {
+	if o.noEmpty {
+		return 1
+	}
+	return 0
+}
+
+var sampleStrings = []string{"", "a", "hello", "Hello World", "héllo", "日本語", "a\nb", `q"uote`, "tab\tx", "  spaced  ", "1", "true", "null", "-0", "1e3", "🙂", "é", "\\back"}
+
+var specialNumbers = []string{"123456789012345678901234567890", "-98765432109876543210", "9223372036854775807", "18446744073709551615", "1e30", "0.1", "1e-10", "3.14159265358979323846264338327950288"}
+
+func intVal(i int64) cty.Value { return cty.NumberIntVal(i) }
+
+var (
+	samples = hegel.SampledFrom(sampleStrings)
+	// stringValues: a sample string or, a fifth of the time, two concatenated.
+	stringValues = hegel.Map(weighted(choice[string]{80, samples}, choice[string]{20, cat(samples, samples)}), cty.StringVal)
+	// decimals: three decimal places.
+	decimals = hegel.Composite(func(tc hegel.TestCase) cty.Value {
+		return cty.MustParseNumberVal(fmt.Sprintf("%d.%03d", hegel.Draw(tc, hegel.Integers(-1000, 1000)), hegel.Draw(tc, hegel.Integers(0, 999))))
+	})
+	// numbers: a weighted choice of forms, the small integers first: integers within three,
+	// within a thousand, decimals, big and special numbers, sevenths.
+	numbers = weighted(
+		choice[cty.Value]{20, hegel.Map(ints(-3, 3), intVal)},
+		choice[cty.Value]{40, hegel.Map(ints(-1000, 1000), intVal)},
+		choice[cty.Value]{20, decimals},
+		choice[cty.Value]{10, hegel.Map(hegel.SampledFrom(specialNumbers), cty.MustParseNumberVal)},
+		choice[cty.Value]{10, hegel.Map(hegel.Integers(-100000, 100000), func(i int) cty.Value { return cty.NumberFloatVal(float64(i) / 7) })},
+	)
+	bools = hegel.Map(hegel.Booleans(), cty.BoolVal)
+)
+
+// valuesOf is the generator of values of ty: at every position a known value first, then a
+// null (nullPct) or an unknown (unknownPct) of the position's type; a DynamicPseudoType
+// position holds a value of some concrete type one level deep (or the dynamic null or
+// unknown).
+func valuesOf(ty cty.Type, o valueOpts) hegel.Generator[cty.Value] {
+	known := knownValuesOf(ty, o)
+	if o.nullPct == 0 && o.unknownPct == 0 {
+		return known
+	}
+	return weighted(
+		choice[cty.Value]{100 - o.nullPct - o.unknownPct, known},
+		choice[cty.Value]{o.nullPct, hegel.Just(cty.NullVal(ty))},
+		choice[cty.Value]{o.unknownPct, hegel.Just(cty.UnknownVal(ty))},
+	)
+}
+
+// knownValuesOf is the generator of known values of ty. The elements of one list, set or map
+// share one concrete type (cty.ListVal refuses a mix), drawn once per collection; sets hold
+// no unknowns (their membership would be undefined) and dedupe their elements by GoString;
+// the attributes of an object are drawn in name order.
+func knownValuesOf(ty cty.Type, o valueOpts) hegel.Generator[cty.Value] {
+	switch {
+	case ty == cty.DynamicPseudoType:
+		return hegel.FlatMap(shallowTypes, func(conc cty.Type) hegel.Generator[cty.Value] { return valuesOf(conc, o) })
+	case ty == cty.String:
+		return stringValues
+	case ty == cty.Number:
+		return numbers
+	case ty == cty.Bool:
+		return bools
+	case ty.IsListType():
+		ety := ty.ElementType()
+		return hegel.FlatMap(concreteOf(ety), func(conc cty.Type) hegel.Generator[cty.Value] {
+			return hegel.Map(many(valuesOf(conc, elemOpts(ety, conc, o)), o.minLen(), 3), func(elems []cty.Value) cty.Value {
+				if len(elems) == 0 {
+					return cty.ListValEmpty(ety)
+				}
+				return cty.ListVal(elems)
+			})
+		})
+	case ty.IsSetType():
+		ety := ty.ElementType()
+		inner := valueOpts{nullPct: o.nullPct, noEmpty: o.noEmpty}
+		return hegel.FlatMap(concreteOf(ety), func(conc cty.Type) hegel.Generator[cty.Value] {
+			return hegel.Map(many(valuesOf(conc, elemOpts(ety, conc, inner)), o.minLen(), 3), func(elems []cty.Value) cty.Value {
+				elems = distinctValues(elems)
+				if len(elems) == 0 {
+					return cty.SetValEmpty(ety)
+				}
+				return cty.SetVal(elems)
+			})
+		})
+	case ty.IsMapType():
+		ety := ty.ElementType()
+		return hegel.FlatMap(concreteOf(ety), func(conc cty.Type) hegel.Generator[cty.Value] {
+			return hegel.Map(hegel.Maps(attrKeys, valuesOf(conc, elemOpts(ety, conc, o))).MinSize(o.minLen()).MaxSize(3), func(m map[string]cty.Value) cty.Value {
+				if len(m) == 0 {
+					return cty.MapValEmpty(ety)
+				}
+				return cty.MapVal(m)
+			})
+		})
+	case ty.IsObjectType():
+		attrs := ty.AttributeTypes()
+		names := sortedKeys(attrs)
+		gens := make([]hegel.Generator[cty.Value], len(names))
+		for i, name := range names {
+			gens[i] = valuesOf(attrs[name], o)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cty.Value {
+			m := map[string]cty.Value{}
+			for i, name := range names {
+				m[name] = hegel.Draw(tc, gens[i])
+			}
+			return cty.ObjectVal(m)
+		})
+	case ty.IsTupleType():
+		etys := ty.TupleElementTypes()
+		gens := make([]hegel.Generator[cty.Value], len(etys))
+		for i, ety := range etys {
+			gens[i] = valuesOf(ety, o)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cty.Value {
+			elems := make([]cty.Value, len(gens))
+			for i, g := range gens {
+				elems[i] = hegel.Draw(tc, g)
+			}
+			return cty.TupleVal(elems)
+		})
+	}
+	panic("valuesOf: unhandled type " + ty.FriendlyName())
+}
+
+// distinctValues keeps the first of equal values (by GoString), in order.
+func distinctValues(elems []cty.Value) []cty.Value {
+	seen := map[string]bool{}
+	var out []cty.Value
+	for _, v := range elems {
+		k := v.GoString()
+		if !seen[k] {
+			seen[k] = true
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// elemOpts: the value options for the elements of a collection whose declared element type is
+// decl and whose elements are generated as conc. While Known.dynamicElemNullLosesType is on
+// (HEGEL_NO_KNOWN=1), a collection whose element type holds a placeholder gets known,
+// non-empty elements only: a null, unknown or empty-collection element comes back from a codec
+// with the declared type, and beside a known element that makes the unmarshalled list
+// inconsistent (a panic).
+func elemOpts(decl, conc cty.Type, o valueOpts) valueOpts {
+	if Known.dynamicElemNullLosesType && !decl.Equals(conc) {
+		return valueOpts{noEmpty: true}
+	}
+	return o
+}
+
+// concreteOf is the generator of concrete types for a type with placeholders: every
+// DynamicPseudoType replaced by a shallow concrete type (the type itself, without a draw, when
+// it has none).
+func concreteOf(ty cty.Type) hegel.Generator[cty.Type] {
+	switch {
+	case !ty.HasDynamicTypes():
+		return hegel.Just(ty)
+	case ty == cty.DynamicPseudoType:
+		return shallowTypes
+	case ty.IsListType():
+		return hegel.Map(concreteOf(ty.ElementType()), cty.List)
+	case ty.IsSetType():
+		return hegel.Map(concreteOf(ty.ElementType()), cty.Set)
+	case ty.IsMapType():
+		return hegel.Map(concreteOf(ty.ElementType()), cty.Map)
+	case ty.IsObjectType():
+		attrs := ty.AttributeTypes()
+		names := sortedKeys(attrs)
+		gens := make([]hegel.Generator[cty.Type], len(names))
+		for i, name := range names {
+			gens[i] = concreteOf(attrs[name])
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cty.Type {
+			out := map[string]cty.Type{}
+			for i, name := range names {
+				out[name] = hegel.Draw(tc, gens[i])
+			}
+			return cty.Object(out)
+		})
+	case ty.IsTupleType():
+		etys := ty.TupleElementTypes()
+		gens := make([]hegel.Generator[cty.Type], len(etys))
+		for i, ety := range etys {
+			gens[i] = concreteOf(ety)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cty.Type {
+			out := make([]cty.Type, len(gens))
+			for i, g := range gens {
+				out[i] = hegel.Draw(tc, g)
+			}
+			return cty.Tuple(out)
+		})
+	}
+	return hegel.Just(ty)
+}
+
+// typed is a value with the type it is marshalled as.
+type typed struct {
+	ty cty.Type
+	v  cty.Value
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c typed) GoString() string { return fmt.Sprintf("%s as %s", c.v.GoString(), tyString(c.ty)) }
+
+// typedValuesOf draws a type from types and a value of it.
+func typedValuesOf(types hegel.Generator[cty.Type], o valueOpts) hegel.Generator[typed] {
+	return hegel.FlatMap(types, func(ty cty.Type) hegel.Generator[typed] {
+		return hegel.Map(valuesOf(ty, o), func(v cty.Value) typed { return typed{ty, v} })
+	})
+}
+
+// hasDynamic reports a DynamicPseudoType anywhere in the type.
+func hasDynamic(ty cty.Type) bool { return ty.HasDynamicTypes() }
+
+// hasSet reports a set type anywhere in the type.
+func hasSet(ty cty.Type) bool {
+	switch {
+	case ty.IsSetType():
+		return true
+	case ty.IsListType(), ty.IsMapType():
+		return hasSet(ty.ElementType())
+	case ty.IsObjectType():
+		for _, a := range ty.AttributeTypes() {
+			if hasSet(a) {
+				return true
+			}
+		}
+	case ty.IsTupleType():
+		for _, e := range ty.TupleElementTypes() {
+			if hasSet(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// tyString renders a type for messages.
+func tyString(ty cty.Type) string { return ty.GoString() }
+
+func sortedKeys(m map[string]cty.Type) []string {
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// keysOf returns the sorted keys of a map value.
+func keysOf(v cty.Value) []string {
+	var out []string
+	for it := v.ElementIterator(); it.Next(); {
+		k, _ := it.Element()
+		out = append(out, k.AsString())
+	}
+	sort.Strings(out)
+	return out
+}
+
+// numStr renders a number the way cty's number-to-string conversion does (shortest exact
+// decimal), for messages.
+func numStr(v cty.Value) string { return v.AsBigFloat().Text('f', -1) }
+
+func itoa(i int) string { return strconv.Itoa(i) }
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..5901cf1
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,167 @@
+package hegel
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// the bug exists and passes once it is fixed (then its Known switch and its entry in
+// target.toml's expected_failures come off).
+
+import (
+	"testing"
+
+	"strings"
+
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/function/stdlib"
+	ctyjson "github.com/zclconf/go-cty/cty/json"
+	ctymsgpack "github.com/zclconf/go-cty/cty/msgpack"
+)
+
+// go-cty/1: a list whose element type holds a placeholder round-trips with a null, unknown or
+// empty element beside a known one.
+func TestHegelPinDynamicElementListRoundTrip(t *testing.T) {
+	ty := cty.List(cty.List(cty.DynamicPseudoType))
+	known := cty.ListVal([]cty.Value{cty.StringVal("a")})
+	for _, tc := range []struct {
+		name string
+		v    cty.Value
+	}{
+		{"null", cty.ListVal([]cty.Value{cty.NullVal(cty.List(cty.String)), known})},
+		{"unknown", cty.ListVal([]cty.Value{cty.UnknownVal(cty.List(cty.String)), known})},
+		{"empty", cty.ListVal([]cty.Value{cty.ListValEmpty(cty.String), known})},
+	} {
+		buf, err := ctymsgpack.Marshal(tc.v, ty)
+		if err != nil {
+			t.Errorf("msgpack.Marshal(%s): %v", tc.v.GoString(), err)
+			continue
+		}
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("msgpack.Unmarshal of the %s case panics: %v", tc.name, r)
+				}
+			}()
+			got, err := ctymsgpack.Unmarshal(buf, ty)
+			if err != nil {
+				t.Errorf("msgpack.Unmarshal of the %s case: %v", tc.name, err)
+			} else if !got.RawEquals(tc.v) {
+				t.Errorf("msgpack round trip of %s gives %s", tc.v.GoString(), got.GoString())
+			}
+		}()
+		if tc.name != "unknown" {
+			jbuf, err := ctyjson.Marshal(tc.v, ty)
+			if err != nil {
+				t.Errorf("json.Marshal(%s): %v", tc.v.GoString(), err)
+				continue
+			}
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Errorf("json.Unmarshal of the %s case panics: %v (JSON %s)", tc.name, r, jbuf)
+					}
+				}()
+				got, err := ctyjson.Unmarshal(jbuf, ty)
+				if err != nil {
+					t.Errorf("json.Unmarshal of the %s case: %v (JSON %s)", tc.name, err, jbuf)
+				} else if !got.RawEquals(tc.v) {
+					t.Errorf("json round trip of %s gives %s (JSON %s)", tc.v.GoString(), got.GoString(), jbuf)
+				}
+			}()
+		}
+	}
+}
+
+// go-cty/2: Substr with a negative offset and length 0 is the empty string.
+func TestHegelPinSubstrNegativeOffsetZeroLength(t *testing.T) {
+	got, err := stdlib.Substr(cty.StringVal("abcde"), cty.NumberIntVal(-2), cty.NumberIntVal(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.AsString() != "" {
+		t.Errorf("Substr(\"abcde\", -2, 0) = %q, want \"\" (Substr(\"abcde\", 3, 0) is \"\")", got.AsString())
+	}
+}
+
+// go-cty/3: Title upper-cases the letter after each non-letter, non-digit character, as its
+// description says.
+func TestHegelPinTitleAfterUnderscore(t *testing.T) {
+	got, err := stdlib.Title(cty.StringVal("x_y a.b"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.AsString() != "X_Y A.B" {
+		t.Errorf("Title(\"x_y a.b\") = %q, want \"X_Y A.B\" (description: %s)", got.AsString(), stdlib.TitleFunc.Description())
+	}
+}
+
+// go-cty/4: the descriptions of the comparison functions name the operands the right way round.
+func TestHegelPinComparisonDescriptions(t *testing.T) {
+	// GreaterThan(5, 3) is true, so its description must not say the second number is greater
+	// than the first
+	gt, _ := stdlib.GreaterThan(cty.NumberIntVal(5), cty.NumberIntVal(3))
+	if !gt.True() {
+		t.Fatalf("GreaterThan(5, 3) = %s", gt.GoString())
+	}
+	for _, f := range []struct {
+		name string
+		desc string
+	}{
+		{"GreaterThan", stdlib.GreaterThanFunc.Description()},
+		{"GreaterThanOrEqualTo", stdlib.GreaterThanOrEqualToFunc.Description()},
+		{"LessThan", stdlib.LessThanFunc.Description()},
+		{"LessThanOrEqualTo", stdlib.LessThanOrEqualToFunc.Description()},
+	} {
+		if strings.Contains(f.desc, "the second number is") && strings.Contains(f.desc, "than the first") {
+			t.Errorf("%s's description reads the operands backwards: %q", f.name, f.desc)
+		}
+	}
+}
+
+// go-cty/5: Range rejects a zero step from the caller.
+func TestHegelPinRangeZeroStep(t *testing.T) {
+	got, err := stdlib.Range(cty.NumberIntVal(2), cty.NumberIntVal(2), cty.NumberIntVal(0))
+	if err == nil {
+		t.Errorf("Range(2, 2, 0) = %s, want the error \"step must not be zero\"", got.GoString())
+	}
+	_, err = stdlib.Range(cty.NumberIntVal(1), cty.NumberIntVal(5), cty.NumberIntVal(0))
+	if err == nil || !strings.Contains(err.Error(), "zero") {
+		t.Errorf("Range(1, 5, 0): %v, want \"step must not be zero\"", err)
+	}
+}
+
+// go-cty/6: Format's %s honours a precision of 0.
+func TestHegelPinFormatZeroPrecision(t *testing.T) {
+	got, err := stdlib.Format(cty.StringVal("[%.0s|%.1s]"), cty.StringVal("abc"), cty.StringVal("abc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.AsString() != "[|a]" {
+		t.Errorf("Format(\"[%%.0s|%%.1s]\", \"abc\", \"abc\") = %q, want \"[|a]\"", got.AsString())
+	}
+}
+
+// go-cty/7: JSON with data after the value is rejected.
+func TestHegelPinJSONTrailingData(t *testing.T) {
+	for _, s := range []string{`{"a":1}]`, `[1]}`, `true]`} {
+		if got, err := stdlib.JSONDecode(cty.StringVal(s)); err == nil {
+			t.Errorf("JSONDecode(%q) = %s, want an error", s, got.GoString())
+		}
+	}
+	if got, err := ctyjson.Unmarshal([]byte(`[1] x`), cty.List(cty.Number)); err == nil {
+		t.Errorf("json.Unmarshal(`[1] x`, List(Number)) = %s, want an error", got.GoString())
+	}
+	if got, err := ctyjson.Unmarshal([]byte(`true false`), cty.Bool); err == nil {
+		t.Errorf("json.Unmarshal(`true false`, Bool) = %s, want an error", got.GoString())
+	}
+}
+
+// go-cty/8: Modulo by zero gives the documented infinity.
+func TestHegelPinModuloByZero(t *testing.T) {
+	if got := cty.NumberIntVal(5).Modulo(cty.Zero); !got.RawEquals(cty.PositiveInfinity) {
+		t.Errorf("NumberIntVal(5).Modulo(Zero) = %s, want PositiveInfinity (Divide gives %s)", got.GoString(), cty.NumberIntVal(5).Divide(cty.Zero).GoString())
+	}
+	if got := cty.NumberIntVal(-5).Modulo(cty.Zero); !got.RawEquals(cty.NegativeInfinity) {
+		t.Errorf("NumberIntVal(-5).Modulo(Zero) = %s, want NegativeInfinity", got.GoString())
+	}
+	if got, err := stdlib.Modulo(cty.NumberIntVal(5), cty.NumberIntVal(0)); err == nil && !got.RawEquals(cty.PositiveInfinity) {
+		t.Errorf("stdlib.Modulo(5, 0) = %s, want PositiveInfinity or an error", got.GoString())
+	}
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..3d19616
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,415 @@
+package hegel
+
+// One property per recorded bug (bugs.toml), each over the bug's shape region alone and judged
+// by the documented model the wide properties use; under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region past the shape instead (known, non-empty elements; a positive length or
+// a non-negative offset; separators other than the underscore; non-zero steps; a positive
+// precision; text after the document; non-zero divisors) and passes.
+
+import (
+	"fmt"
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/function/stdlib"
+	ctyjson "github.com/zclconf/go-cty/cty/json"
+	ctymsgpack "github.com/zclconf/go-cty/cty/msgpack"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- go-cty/1
+
+// lostKind is the form of an element that comes back with the declared element type: a null,
+// an unknown (msgpack only) or an empty collection of its own concrete type.
+type lostKind int
+
+const (
+	lostNull lostKind = iota
+	lostUnknown
+	lostEmpty
+)
+
+// dynamicElemCase: a list or map whose element type holds a placeholder, holding known
+// non-empty elements of one concrete type and (in the shape region) one null, unknown or empty
+// element among them.
+type dynamicElemCase struct {
+	msgpack bool
+	asMap   bool
+	ety     cty.Type // List(D), Map(D) or Object({a: D})
+	conc    cty.Type // the elements' concrete type
+	knowns  []cty.Value
+	lost    *lostKind // nil: no lost element (past the shape)
+	pos     int       // where the lost element goes among the knowns
+	keys    []string  // the map keys, one per element (attrNames)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dynamicElemCase) GoString() string {
+	codec := "json"
+	if c.msgpack {
+		codec = "msgpack"
+	}
+	ty, v := c.typed()
+	return fmt.Sprintf("%s: %s as %s", codec, v.GoString(), tyString(ty))
+}
+
+// lostValue is the lost element: a null or unknown of the concrete type, or the empty
+// collection of its element type.
+func (c dynamicElemCase) lostValue() cty.Value {
+	switch *c.lost {
+	case lostUnknown:
+		return cty.UnknownVal(c.conc)
+	case lostEmpty:
+		if c.conc.IsMapType() {
+			return cty.MapValEmpty(c.conc.ElementType())
+		}
+		return cty.ListValEmpty(c.conc.ElementType())
+	}
+	return cty.NullVal(c.conc)
+}
+
+// elems is the elements in order, the lost one at its position.
+func (c dynamicElemCase) elems() []cty.Value {
+	if c.lost == nil {
+		return c.knowns
+	}
+	out := append([]cty.Value(nil), c.knowns[:c.pos]...)
+	out = append(out, c.lostValue())
+	return append(out, c.knowns[c.pos:]...)
+}
+
+// typed renders the case to the type and the value marshalled as it.
+func (c dynamicElemCase) typed() (cty.Type, cty.Value) {
+	elems := c.elems()
+	if c.asMap {
+		m := map[string]cty.Value{}
+		for i, e := range elems {
+			m[c.keys[i]] = e
+		}
+		if len(m) == 0 {
+			return cty.Map(c.ety), cty.MapValEmpty(c.ety)
+		}
+		return cty.Map(c.ety), cty.MapVal(m)
+	}
+	if len(elems) == 0 {
+		return cty.List(c.ety), cty.ListValEmpty(c.ety)
+	}
+	return cty.List(c.ety), cty.ListVal(elems)
+}
+
+var (
+	dynamicElemTypes = hegel.SampledFrom([]cty.Type{
+		cty.List(cty.DynamicPseudoType),
+		cty.Map(cty.DynamicPseudoType),
+		cty.Object(map[string]cty.Type{"a": cty.DynamicPseudoType}),
+	})
+	dynamicElemCases = hegel.Composite(func(tc hegel.TestCase) dynamicElemCase {
+		c := dynamicElemCase{msgpack: hegel.Draw(tc, hegel.Booleans()), asMap: hegel.Draw(tc, hegel.Booleans()), ety: hegel.Draw(tc, dynamicElemTypes)}
+		c.conc = hegel.Draw(tc, concreteOf(c.ety))
+		// the shape: zero to two known elements and one lost; past it: one to three known
+		c.knowns = hegel.Draw(tc, many(valuesOf(c.conc, valueOpts{noEmpty: true}), shaped(0, 1), shaped(2, 3)))
+		if !noKnown {
+			// a null, or (msgpack) an unknown, or (list and map elements) the empty collection
+			kinds := []lostKind{lostNull}
+			if c.msgpack {
+				kinds = append(kinds, lostUnknown)
+			}
+			if !c.conc.IsObjectType() {
+				kinds = append(kinds, lostEmpty)
+			}
+			c.lost = ptrTo(hegel.Draw(tc, hegel.SampledFrom(kinds)))
+			c.pos = hegel.Draw(tc, hegel.Integers(0, len(c.knowns)))
+		}
+		c.keys = attrNames // one key per element, in the table's order
+		return c
+	})
+)
+
+// TestHegelDynamicElementTypesKeepNullElements: a null, unknown or empty-collection element
+// of a list or map whose element type holds a placeholder round-trips through JSON and msgpack
+// with its own type, and beside a known element the unmarshal does not panic (go-cty/1). Under
+// HEGEL_NO_KNOWN=1 the elements are all known and non-empty.
+func TestHegelDynamicElementTypesKeepNullElements(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		dc := hegel.Draw(ht, dynamicElemCases)
+		ty, v := dc.typed()
+		shape := known("go-cty/1")
+		marshal, unmarshal := ctyjson.Marshal, ctyjson.Unmarshal
+		if dc.msgpack {
+			marshal, unmarshal = ctymsgpack.Marshal, ctymsgpack.Unmarshal
+		}
+		buf, err := marshal(v, ty)
+		if err != nil {
+			c.failClass(ht, "marshal", "Marshal(%s, %s): %v", v.GoString(), tyString(ty), err)
+			return
+		}
+		got, err, panicked := recovering(func() (cty.Value, error) { return unmarshal(buf, ty) })
+		switch {
+		case panicked != nil:
+			c.mismatch(ht, "unmarshal panic", shape, "Unmarshal(%q, %s) panics: %v (value %s)", buf, tyString(ty), panicked, v.GoString())
+		case err != nil:
+			c.mismatch(ht, "unmarshal", shape, "Unmarshal(%q, %s): %v (value %s)", buf, tyString(ty), err, v.GoString())
+		case !got.RawEquals(v):
+			c.mismatch(ht, "value", shape, "round trip of %s as %s gives %s (%q)", v.GoString(), tyString(ty), got.GoString(), buf)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/2
+
+// substrCase: a non-empty string, an offset and a length.
+type substrCase struct {
+	s           string
+	off, length int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c substrCase) GoString() string { return fmt.Sprintf("Substr(%q, %d, %d)", c.s, c.off, c.length) }
+
+var (
+	nonEmptyPlain = hegel.Filter(plain, func(s string) bool { return s != "" })
+	substrCases   = hegel.FlatMap(nonEmptyPlain, func(s string) hegel.Generator[substrCase] {
+		n := len([]rune(s))
+		negative := hegel.Integers(-n, -1)
+		// the shape: a negative offset with length 0; past it, a positive length with a negative
+		// offset or a non-negative offset with length 0
+		return shaped(
+			hegel.Map(negative, func(off int) substrCase { return substrCase{s, off, 0} }),
+			weighted(
+				choice[substrCase]{50, hegel.Composite(func(tc hegel.TestCase) substrCase {
+					return substrCase{s, hegel.Draw(tc, negative), hegel.Draw(tc, hegel.Integers(1, n+1))}
+				})},
+				choice[substrCase]{50, hegel.Map(hegel.Integers(0, n), func(off int) substrCase { return substrCase{s, off, 0} })},
+			),
+		)
+	})
+)
+
+// TestHegelSubstrNegativeOffsetsWithZeroLength: Substr with a negative offset and length 0 is
+// the empty string, as with any offset (go-cty/2). Under HEGEL_NO_KNOWN=1 the length is
+// positive or the offset non-negative.
+func TestHegelSubstrNegativeOffsetsWithZeroLength(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, substrCases)
+		got, err := stdlib.Substr(cty.StringVal(sc.s), cty.NumberIntVal(int64(sc.off)), cty.NumberIntVal(int64(sc.length)))
+		checkString(c, ht, "Substr", known("go-cty/2"), got, err, substrWant([]rune(sc.s), sc.off, sc.length), sc.GoString())
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/3
+
+var (
+	titleWords = hegel.SampledFrom([]string{"a", "hello", "world", "x", "foo", "bar", "\u00e9t\u00e9", "b2", "zz"})
+	// titleSeparators: the underscore (the shape), or past it the separators strings.Title knows.
+	titleSeparators = shaped(hegel.Just("_"), hegel.SampledFrom([]string{" ", "-", ".", "/", ","}))
+	titleCases      = hegel.Composite(func(tc hegel.TestCase) string {
+		return strings.Join(hegel.Draw(tc, many(titleWords, 2, 4)), hegel.Draw(tc, titleSeparators))
+	})
+)
+
+// TestHegelTitleAfterUnderscores: Title upper-cases the letter after an underscore, a
+// non-letter, non-digit character by its description (go-cty/3). Under HEGEL_NO_KNOWN=1 the
+// words are joined by other separators.
+func TestHegelTitleAfterUnderscores(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, titleCases)
+		got, err := stdlib.Title(cty.StringVal(s))
+		checkString(c, ht, "Title", known("go-cty/3"), got, err, titleWant(s), fmt.Sprintf("Title(%q)", s))
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/4
+
+// numberPair: two numbers that differ.
+type numberPair struct{ a, b cty.Value }
+
+// GoString is what the draw report prints (it uses %#v).
+func (p numberPair) GoString() string { return fmt.Sprintf("%s, %s", numStr(p.a), numStr(p.b)) }
+
+var numberPairs = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) numberPair {
+	return numberPair{hegel.Draw(tc, numbers), hegel.Draw(tc, numbers)}
+}), func(p numberPair) bool { return p.a.AsBigFloat().Cmp(p.b.AsBigFloat()) != 0 })
+
+// TestHegelComparisonsAgainstDescriptions: LessThan, LessThanOrEqualTo, GreaterThan and
+// GreaterThanOrEqualTo of two numbers that differ, against what their descriptions say of the
+// operands (go-cty/4). Under HEGEL_NO_KNOWN=1 the model is the numeric order of the arguments
+// as given, which the descriptions do not state.
+func TestHegelComparisonsAgainstDescriptions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, numberPairs)
+		a, b := p.a, p.b
+		lt, le, gt, ge := comparisonWant(a.AsBigFloat().Cmp(b.AsBigFloat()))
+		check := func(name string, got cty.Value, err error, want bool) {
+			if err != nil {
+				c.mismatch(ht, name, known("go-cty/4"), "%s(%s, %s): %v", name, numStr(a), numStr(b), err)
+			} else if got.True() != want {
+				c.mismatch(ht, name, known("go-cty/4"), "%s(%s, %s) = %v, want %v", name, numStr(a), numStr(b), got.True(), want)
+			}
+		}
+		got, err := stdlib.LessThan(a, b)
+		check("LessThan", got, err, lt)
+		got, err = stdlib.LessThanOrEqualTo(a, b)
+		check("LessThanOrEqualTo", got, err, le)
+		got, err = stdlib.GreaterThan(a, b)
+		check("GreaterThan", got, err, gt)
+		got, err = stdlib.GreaterThanOrEqualTo(a, b)
+		check("GreaterThanOrEqualTo", got, err, ge)
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/5
+
+var (
+	// nonZeroSteps: -3 to 3 without 0.
+	nonZeroSteps  = hegel.Map(hegel.Integers(0, 5), func(i int) int { return []int{1, -1, 2, -2, 3, -3}[i] })
+	zeroStepCases = hegel.Composite(func(tc hegel.TestCase) rangeCase {
+		start := hegel.Draw(tc, rangeEnds)
+		end := start
+		if !hegel.Draw(tc, chance(50)) {
+			end = hegel.Draw(tc, rangeEnds)
+		}
+		return rangeCase{nargs: 3, start: start, end: end, step: hegel.Draw(tc, shaped(hegel.Just(0), nonZeroSteps))}
+	})
+)
+
+// TestHegelRangeRejectsZeroSteps: Range with a step of 0 fails, from any start to any end,
+// the end being the start half the time (go-cty/5: Range(n, n, 0) is the empty list). Under
+// HEGEL_NO_KNOWN=1 the steps are non-zero.
+func TestHegelRangeRejectsZeroSteps(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, zeroStepCases)
+		checkRange(c, ht, known("go-cty/5"), rc)
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/6
+
+// candidateFormatAsIsPrecision names the shape gated out of the %s precision property: %v
+// ignores every precision (formatAppendAsIs never reads it), where the documentation has %v
+// format a string as %s and precision limit a string's length. Counted, not judged, until it
+// is recorded (hegel-bindings.md).
+const candidateFormatAsIsPrecision = "candidate/go/go-cty-9"
+
+// precisionCase: a string formatted by %s or %v with a precision.
+type precisionCase struct {
+	verb string
+	prec int
+	s    string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c precisionCase) GoString() string {
+	return fmt.Sprintf("Format(\"%%.%d%s\", %q)", c.prec, c.verb, c.s)
+}
+
+var precisionCases = hegel.Composite(func(tc hegel.TestCase) precisionCase {
+	return precisionCase{
+		// %s nine times in ten, %v the tenth (gated: candidateFormatAsIsPrecision)
+		verb: hegel.Draw(tc, weighted(choice[string]{90, hegel.Just("s")}, choice[string]{10, hegel.Just("v")})),
+		// the shape: precision 0; past it, 1 to 4
+		prec: hegel.Draw(tc, shaped(hegel.Just(0), hegel.Integers(1, 4))),
+		s:    hegel.Draw(tc, plain),
+	}
+})
+
+// TestHegelFormatStringPrecision: Format's %s truncates the string to the precision, 0
+// included (go-cty/6). Under HEGEL_NO_KNOWN=1 the precision is positive. The %v cases are
+// counted and skipped (candidateFormatAsIsPrecision).
+func TestHegelFormatStringPrecision(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		pc := hegel.Draw(ht, precisionCases)
+		if pc.verb == "v" {
+			c.count(candidateFormatAsIsPrecision)
+			ht.Assume(false)
+		}
+		seg := fmtSeg{verb: pc.verb, width: -1, prec: pc.prec, arg: cty.StringVal(pc.s)}
+		checkFormat(c, ht, known("go-cty/6"), formatCase{segs: []fmtSeg{seg}})
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/7
+
+// trailedDoc: a value's JSON document and the text appended to it.
+type trailedDoc struct {
+	v        cty.Value
+	trailing string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (d trailedDoc) GoString() string { return fmt.Sprintf("%s then %q", d.v.GoString(), d.trailing) }
+
+var (
+	// bracketTrailers: closing brackets (the shape), or past it text.
+	bracketTrailers = shaped(hegel.SampledFrom([]string{"]", "}", "]]"}), hegel.SampledFrom([]string{" x", " 1"}))
+	trailedDocs     = hegel.Composite(func(tc hegel.TestCase) trailedDoc {
+		ty := hegel.Draw(tc, plainTypes)
+		return trailedDoc{v: hegel.Draw(tc, valuesOf(ty, valueOpts{nullPct: 10})), trailing: hegel.Draw(tc, bracketTrailers)}
+	})
+)
+
+// TestHegelJSONDecodeRejectsTrailingBrackets: JSONDecode rejects a valid document followed by
+// a stray "]" or "}" (go-cty/7). Under HEGEL_NO_KNOWN=1 the document is followed by text.
+func TestHegelJSONDecodeRejectsTrailingBrackets(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, trailedDocs)
+		enc, err := stdlib.JSONEncode(d.v)
+		if err != nil {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s): %v", d.v.GoString(), err)
+			return
+		}
+		checkTrailing(c, ht, known("go-cty/7"), enc.AsString(), d.trailing)
+	})
+}
+
+// --------------------------------------------------------------------------- go-cty/8
+
+// moduloCase: an integer dividend and divisor.
+type moduloCase struct{ a, b int64 }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c moduloCase) GoString() string { return fmt.Sprintf("Modulo(%d, %d)", c.a, c.b) }
+
+var (
+	// nonZeroInts: -1000 to 1000 without 0.
+	nonZeroInts = hegel.Map(hegel.Integers(1, 2000), func(i int) int64 {
+		if i > 1000 {
+			return int64(1000 - i)
+		}
+		return int64(i)
+	})
+	moduloCases = hegel.Composite(func(tc hegel.TestCase) moduloCase {
+		return moduloCase{a: hegel.Draw(tc, ints(-1000, 1000)), b: hegel.Draw(tc, shaped(hegel.Just[int64](0), nonZeroInts))}
+	})
+)
+
+// TestHegelModuloByZero: Modulo of an integer by zero is the infinity of the dividend's sign
+// (Value.Modulo's documentation; go-cty/8). Under HEGEL_NO_KNOWN=1 the divisor is non-zero
+// and the model big.Int's remainder.
+func TestHegelModuloByZero(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, moduloCases)
+		a, b := cty.NumberIntVal(mc.a), cty.NumberIntVal(mc.b)
+		got, err := stdlib.Modulo(a, b)
+		var want cty.Value
+		if mc.b == 0 {
+			want = moduloByZeroWant(a)
+		} else {
+			want = cty.NumberVal(new(big.Float).SetInt(new(big.Int).Rem(big.NewInt(mc.a), big.NewInt(mc.b))))
+		}
+		if err != nil {
+			c.mismatch(ht, "Modulo", known("go-cty/8"), "%s: %v", mc.GoString(), err)
+		} else if got.AsBigFloat().Cmp(want.AsBigFloat()) != 0 {
+			c.mismatch(ht, "Modulo", known("go-cty/8"), "%s = %s, want %s", mc.GoString(), got.GoString(), want.GoString())
+		}
+	})
+}
diff --git a/hegel/hegel_stdlib_test.go b/hegel/hegel_stdlib_test.go
new file mode 100644
index 0000000..d67e895
--- /dev/null
+++ b/hegel/hegel_stdlib_test.go
@@ -0,0 +1,2022 @@
+package hegel
+
+// The stdlib functions against models written from their doc comments and Description fields.
+// Each property draws one case record (a Composite where a draw depends on another, Map/Lists
+// over the sample tables otherwise) and judges it; the models are pure functions of the
+// record, shared with the narrow properties of hegel_shapes_test.go.
+
+import (
+	"bytes"
+	"encoding/csv"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+	"unicode"
+
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/convert"
+	"github.com/zclconf/go-cty/cty/function/stdlib"
+	"hegel.dev/go/hegel"
+)
+
+// plainStrings: strings whose grapheme clusters are single runes (no combining marks, no
+// "\r\n"), so the rune-based models agree with the documented character semantics.
+var plainStrings = []string{"", "a", "hello", "Hello World", "héllo", "日本語", "a\nb", `q"uote`, "tab\tx", "  spaced  ", "1", "true", "-0", "🙂", "é", "\\back", "x_y", "a-b c", "ABC", "MiXeD", "\n\n", "end\n", "<a&b>"}
+
+var (
+	plainSamples = hegel.SampledFrom(plainStrings)
+	// plain: a sample string or, a quarter of the time, two concatenated.
+	plain = weighted(choice[string]{75, plainSamples}, choice[string]{25, cat(plainSamples, plainSamples)})
+)
+
+// plains is a list of lo to hi plain strings.
+func plains(lo, hi int) hegel.Generator[[]string] { return many(plain, lo, hi) }
+
+func strList(xs []string) cty.Value {
+	if len(xs) == 0 {
+		return cty.ListValEmpty(cty.String)
+	}
+	vals := make([]cty.Value, len(xs))
+	for i, x := range xs {
+		vals[i] = cty.StringVal(x)
+	}
+	return cty.ListVal(vals)
+}
+
+func strTuple(xs []string) cty.Value {
+	vals := make([]cty.Value, len(xs))
+	for i, x := range xs {
+		vals[i] = cty.StringVal(x)
+	}
+	return cty.TupleVal(vals)
+}
+
+func strMap(m map[string]string) cty.Value {
+	if len(m) == 0 {
+		return cty.MapValEmpty(cty.String)
+	}
+	vals := map[string]cty.Value{}
+	for k, v := range m {
+		vals[k] = cty.StringVal(v)
+	}
+	return cty.MapVal(vals)
+}
+
+// elemsOf lists the elements of a known list, set or tuple value.
+func elemsOf(v cty.Value) []cty.Value {
+	var out []cty.Value
+	for it := v.ElementIterator(); it.Next(); {
+		_, e := it.Element()
+		out = append(out, e)
+	}
+	return out
+}
+
+func stringsOf(v cty.Value) []string {
+	var out []string
+	for _, e := range elemsOf(v) {
+		out = append(out, e.AsString())
+	}
+	return out
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func sameElems(got []cty.Value, want []cty.Value) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range got {
+		if !got[i].RawEquals(want[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func reverseRunes(s string) string {
+	r := []rune(s)
+	for i, j := 0, len(r)-1; i < j; i, j = i+1, j-1 {
+		r[i], r[j] = r[j], r[i]
+	}
+	return string(r)
+}
+
+// --------------------------------------------------------------------------- strings
+
+// substrWant is Substr's documented result on the runes: a negative offset counts from the
+// end, length -1 is the rest, length 0 the empty string. While
+// Known.substrNegativeOffsetZeroLength is on, a negative offset with length 0 gives the rest
+// from the offset (go-cty/2).
+func substrWant(runes []rune, off, length int) string {
+	n := len(runes)
+	o := off
+	if o < 0 {
+		o += n
+	}
+	switch {
+	case length == 0 && off < 0 && Known.substrNegativeOffsetZeroLength:
+		return string(runes[o:])
+	case length == 0:
+		return ""
+	case length < 0:
+		return string(runes[o:])
+	}
+	end := o + length
+	if end > n {
+		end = n
+	}
+	return string(runes[o:end])
+}
+
+// titleWant is Title's described result: one letter after each non-letter, non-digit
+// character upper-cased. While Known.titleUnderscore is on it is strings.Title, whose
+// separators exclude the underscore and every non-ASCII, non-space character (go-cty/3).
+func titleWant(s string) string {
+	if Known.titleUnderscore {
+		return strings.Title(s)
+	}
+	var b strings.Builder
+	prevSep := true
+	for _, r := range s {
+		if prevSep {
+			b.WriteRune(unicode.ToTitle(r))
+		} else {
+			b.WriteRune(r)
+		}
+		prevSep = !unicode.IsLetter(r) && !unicode.IsDigit(r)
+	}
+	return b.String()
+}
+
+// titleShape reports the shape of go-cty/3: a letter with a title-case form follows an
+// underscore or a non-ASCII character that is neither a letter, a digit nor a space, which the
+// description counts as a separator and strings.Title does not.
+func titleShape(s string) bool {
+	prev := rune(-1)
+	for _, r := range s {
+		if prev >= 0 && unicode.IsLetter(r) && unicode.ToTitle(r) != r &&
+			(prev == '_' || (prev > 0x7f && !unicode.IsLetter(prev) && !unicode.IsDigit(prev) && !unicode.IsSpace(prev))) {
+			return true
+		}
+		prev = r
+	}
+	return false
+}
+
+// stringCase: the subject string and the arguments of each string function.
+type stringCase struct {
+	s           string
+	off, length int        // Substr: an offset in [-n, n] and a length in [-1, n+1] for n runes
+	tail        string     // Chomp: the line ending appended to s
+	indent      int        // Indent: spaces
+	cut         string     // Trim: the cutset
+	affix       string     // TrimPrefix, TrimSuffix
+	sub, rep    string     // Replace
+	sep         string     // Split, Join
+	lists       [][]string // Join: one to three lists
+	xs          []string   // Sort
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c stringCase) GoString() string {
+	return fmt.Sprintf("s %q off %d len %d tail %q indent %d cut %q affix %q sub %q rep %q sep %q lists %q sort %q",
+		c.s, c.off, c.length, c.tail, c.indent, c.cut, c.affix, c.sub, c.rep, c.sep, c.lists, c.xs)
+}
+
+var (
+	lineEndings = hegel.SampledFrom([]string{"", "\n", "\r\n", "\n\n", "\r\n\r\n", "\n\r"})
+	cutsets     = hegel.SampledFrom([]string{"", " ", "ab", "lo", "\n", "é", "abc123"})
+	affixes     = hegel.SampledFrom([]string{"", "h", "he", "日", "  ", "Hello", "x"})
+	substrings  = hegel.SampledFrom([]string{"l", "ll", "o", " ", "日本", "🙂", "zz", "\n"})
+	replacers   = hegel.SampledFrom([]string{"", "L", "--", "日"})
+	separators  = hegel.SampledFrom([]string{",", " ", "l", "\n", "ab", "日"})
+	stringCases = hegel.Composite(func(tc hegel.TestCase) stringCase {
+		s := hegel.Draw(tc, plain)
+		n := len([]rune(s))
+		return stringCase{
+			s:      s,
+			off:    hegel.Draw(tc, hegel.Integers(-n, n)),
+			length: hegel.Draw(tc, hegel.Integers(-1, n+1)),
+			tail:   hegel.Draw(tc, lineEndings),
+			indent: hegel.Draw(tc, hegel.Integers(0, 4)),
+			cut:    hegel.Draw(tc, cutsets),
+			affix:  hegel.Draw(tc, affixes),
+			sub:    hegel.Draw(tc, substrings),
+			rep:    hegel.Draw(tc, replacers),
+			sep:    hegel.Draw(tc, separators),
+			lists:  hegel.Draw(tc, many(plains(0, 3), 1, 3)),
+			xs:     hegel.Draw(tc, plains(0, 5)),
+		}
+	})
+)
+
+// checkString checks that got is the known string want.
+func checkString(c *collector, ht *hegel.T, name, shape string, got cty.Value, err error, want string, call string) {
+	if err != nil {
+		c.mismatch(ht, name, shape, "%s: %v", call, err)
+		return
+	}
+	if got.Type() != cty.String || !got.IsKnown() || got.IsNull() {
+		c.mismatch(ht, name, shape, "%s: %s is not a known string", call, got.GoString())
+		return
+	}
+	if got.AsString() != want {
+		c.mismatch(ht, name, shape, "%s = %q, want %q", call, got.AsString(), want)
+	}
+}
+
+// TestHegelStringFunctions: the string functions against models by runes. Substr with a
+// negative offset and length 0 returns the rest of the string (go-cty/2); Title leaves the
+// letter after an underscore alone (go-cty/3).
+func TestHegelStringFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, stringCases)
+		s := sc.s
+		sv := cty.StringVal(s)
+		runes := []rune(s)
+		n := len(runes)
+
+		check := func(name string, got cty.Value, err error, want string) {
+			checkString(c, ht, name, "", got, err, want, fmt.Sprintf("%s(%q)", name, s))
+		}
+
+		got, err := stdlib.Upper(sv)
+		check("Upper", got, err, strings.ToUpper(s))
+		got, err = stdlib.Lower(sv)
+		check("Lower", got, err, strings.ToLower(s))
+		got, err = stdlib.Reverse(sv)
+		check("Reverse", got, err, reverseRunes(s))
+		got, err = stdlib.TrimSpace(sv)
+		check("TrimSpace", got, err, strings.TrimSpace(s))
+
+		got, err = stdlib.Strlen(sv)
+		if err != nil {
+			c.failClass(ht, "Strlen", "Strlen(%q): %v", s, err)
+		} else if got.AsBigFloat().Cmp(big.NewFloat(float64(n))) != 0 {
+			c.failClass(ht, "Strlen", "Strlen(%q) = %s, want %d", s, numStr(got), n)
+		}
+
+		// Substr: offset in characters (a negative one counts from the end), length -1 = the rest
+		got, err = stdlib.Substr(sv, cty.NumberIntVal(int64(sc.off)), cty.NumberIntVal(int64(sc.length)))
+		checkString(c, ht, "Substr", shapeIf(sc.off < 0 && sc.length == 0, "go-cty/2"), got, err, substrWant(runes, sc.off, sc.length), fmt.Sprintf("Substr(%q, %d, %d)", s, sc.off, sc.length))
+
+		// Chomp: newline characters at the end
+		{
+			cs := s + sc.tail
+			want := cs
+			for strings.HasSuffix(want, "\n") || strings.HasSuffix(want, "\r") {
+				want = strings.TrimRight(want, "\n")
+				want = strings.TrimRight(want, "\r")
+			}
+			got, err := stdlib.Chomp(cty.StringVal(cs))
+			checkString(c, ht, "Chomp", "", got, err, want, fmt.Sprintf("Chomp(%q)", cs))
+		}
+
+		// Indent: spaces after each newline
+		got, err = stdlib.Indent(cty.NumberIntVal(int64(sc.indent)), sv)
+		check("Indent", got, err, strings.ReplaceAll(s, "\n", "\n"+strings.Repeat(" ", sc.indent)))
+
+		// Title: one letter after each non-letter, non-digit character upper-cased
+		got, err = stdlib.Title(sv)
+		checkString(c, ht, "Title", shapeIf(titleShape(s), "go-cty/3"), got, err, titleWant(s), fmt.Sprintf("Title(%q)", s))
+
+		// Trim family
+		got, err = stdlib.Trim(sv, cty.StringVal(sc.cut))
+		check("Trim", got, err, strings.Trim(s, sc.cut))
+		got, err = stdlib.TrimPrefix(sv, cty.StringVal(sc.affix))
+		check("TrimPrefix", got, err, strings.TrimPrefix(s, sc.affix))
+		got, err = stdlib.TrimSuffix(sv, cty.StringVal(sc.affix))
+		check("TrimSuffix", got, err, strings.TrimSuffix(s, sc.affix))
+
+		// Replace: all instances
+		got, err = stdlib.Replace(sv, cty.StringVal(sc.sub), cty.StringVal(sc.rep))
+		check("Replace", got, err, strings.ReplaceAll(s, sc.sub, sc.rep))
+
+		// Split / Join
+		sep := sc.sep
+		got, err = stdlib.Split(cty.StringVal(sep), sv)
+		if err != nil {
+			c.failClass(ht, "Split", "Split(%q, %q): %v", sep, s, err)
+		} else if want := strings.Split(s, sep); !sameStrings(stringsOf(got), want) {
+			c.failClass(ht, "Split", "Split(%q, %q) = %q, want %q", sep, s, stringsOf(got), want)
+		} else {
+			// Join undoes Split
+			back, err := stdlib.Join(cty.StringVal(sep), got)
+			check("Join", back, err, s)
+		}
+		var all []string
+		var args []cty.Value
+		for _, xs := range sc.lists {
+			all = append(all, xs...)
+			args = append(args, strList(xs))
+		}
+		got, err = stdlib.Join(cty.StringVal(sep), args...)
+		check("Join", got, err, strings.Join(all, sep))
+
+		// Sort: lexicographic
+		xs := sc.xs
+		got, err = stdlib.Sort(strList(xs))
+		if err != nil {
+			c.failClass(ht, "Sort", "Sort(%q): %v", xs, err)
+		} else {
+			want := append([]string(nil), xs...)
+			sort.Strings(want)
+			if !sameStrings(stringsOf(got), want) {
+				c.failClass(ht, "Sort", "Sort(%q) = %q, want %q", xs, stringsOf(got), want)
+			}
+		}
+
+		// unknown and null arguments
+		if u, err := stdlib.Upper(cty.UnknownVal(cty.String)); err != nil || u.IsKnown() {
+			c.failClass(ht, "unknown", "Upper(unknown) = %s, %v; want an unknown string", u.GoString(), err)
+		}
+		if _, err := stdlib.Upper(cty.NullVal(cty.String)); err == nil {
+			c.failClass(ht, "null", "Upper(null) does not fail")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- collections
+
+// flatPart is one element of Flatten's argument: a list, a tuple, or a tuple holding a list
+// (one level deeper).
+type flatPart struct {
+	zs   []string
+	kind int // 0 list, 1 tuple, 2 nested
+}
+
+func (p flatPart) value() cty.Value {
+	switch p.kind {
+	case 1:
+		return strTuple(p.zs)
+	case 2:
+		return cty.TupleVal([]cty.Value{strList(p.zs)})
+	}
+	return strList(p.zs)
+}
+
+// collectionCase: a sequence of strings and the arguments of each collection function.
+type collectionCase struct {
+	xs         []string
+	tuple      bool // the sequence as a tuple rather than a list
+	idx        int  // Element: 0 to 2n+1
+	at         int  // HasIndex, Index: -1 to n
+	needle     string
+	start, end int // Slice: 0 <= start <= end <= n
+	size       int // Chunklist: 1 to n+1
+	ys         []string
+	parts      []flatPart // Flatten
+	extra      *string    // Flatten: a string among the sequences (when the result stays short)
+	coalesce   []*string  // Coalesce: nil is a null
+	lists      [][]string // CoalesceList: nil is an empty list
+	m, m2      map[string]string
+	key, def   string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c collectionCase) GoString() string {
+	var co []string
+	for _, p := range c.coalesce {
+		if p == nil {
+			co = append(co, "null")
+		} else {
+			co = append(co, fmt.Sprintf("%q", *p))
+		}
+	}
+	extra := "none"
+	if c.extra != nil {
+		extra = fmt.Sprintf("%q", *c.extra)
+	}
+	return fmt.Sprintf("xs %q tuple %v idx %d at %d needle %q slice %d:%d size %d ys %q parts %v extra %s coalesce %v lists %q m %v m2 %v key %q def %q",
+		c.xs, c.tuple, c.idx, c.at, c.needle, c.start, c.end, c.size, c.ys, c.parts, extra, co, c.lists, c.m, c.m2, c.key, c.def)
+}
+
+var (
+	flatParts = hegel.Composite(func(tc hegel.TestCase) flatPart {
+		return flatPart{zs: hegel.Draw(tc, plains(0, 3)), kind: hegel.Draw(tc, hegel.Integers(0, 2))}
+	})
+	// shortLists: an empty list four times in ten, else up to two strings.
+	shortLists      = weighted(choice[[]string]{40, hegel.Just[[]string](nil)}, choice[[]string]{60, plains(0, 2)})
+	stringMaps      = hegel.Maps(attrKeys, plain)
+	collectionCases = hegel.Composite(func(tc hegel.TestCase) collectionCase {
+		xs := hegel.Draw(tc, plains(0, 5))
+		n := len(xs)
+		start := hegel.Draw(tc, hegel.Integers(0, n))
+		return collectionCase{
+			xs:       xs,
+			tuple:    hegel.Draw(tc, chance(30)),
+			idx:      hegel.Draw(tc, hegel.Integers(0, 2*n+1)),
+			at:       hegel.Draw(tc, hegel.Integers(-1, n)),
+			needle:   hegel.Draw(tc, plain),
+			start:    start,
+			end:      hegel.Draw(tc, hegel.Integers(start, n)),
+			size:     hegel.Draw(tc, hegel.Integers(1, n+1)),
+			ys:       hegel.Draw(tc, plains(0, 3)),
+			parts:    hegel.Draw(tc, many(flatParts, 0, 3)),
+			extra:    hegel.Draw(tc, optional(30, plain)),
+			coalesce: hegel.Draw(tc, many(optional(60, plain), 1, 4)),
+			lists:    hegel.Draw(tc, many(shortLists, 1, 4)),
+			m:        hegel.Draw(tc, stringMaps.MaxSize(4)),
+			m2:       hegel.Draw(tc, stringMaps.MaxSize(3)),
+			key:      hegel.Draw(tc, attrKeys),
+			def:      hegel.Draw(tc, plain),
+		}
+	})
+)
+
+// TestHegelCollectionFunctions: the collection functions against models over a sequence of
+// strings and maps of strings.
+func TestHegelCollectionFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, collectionCases)
+		xs := cc.xs
+		n := len(xs)
+		lv := strList(xs)
+		if cc.tuple {
+			lv = strTuple(xs)
+		}
+
+		if got, err := stdlib.Length(lv); err != nil {
+			c.failClass(ht, "Length", "Length(%q): %v", xs, err)
+		} else if got.AsBigFloat().Cmp(big.NewFloat(float64(n))) != 0 {
+			c.failClass(ht, "Length", "Length(%q) = %s", xs, numStr(got))
+		}
+
+		// Element: index modulo the length; error on an empty sequence
+		idx := cc.idx
+		got, err := stdlib.Element(lv, cty.NumberIntVal(int64(idx)))
+		switch {
+		case n == 0:
+			if err == nil {
+				c.failClass(ht, "Element", "Element([], %d) = %s, want an error", idx, got.GoString())
+			}
+		case err != nil:
+			c.failClass(ht, "Element", "Element(%q, %d): %v", xs, idx, err)
+		case got.AsString() != xs[idx%n]:
+			c.failClass(ht, "Element", "Element(%q, %d) = %q, want %q", xs, idx, got.AsString(), xs[idx%n])
+		}
+
+		// HasIndex / Index
+		i2 := cc.at
+		hi, err := stdlib.HasIndex(lv, cty.NumberIntVal(int64(i2)))
+		if err != nil {
+			c.failClass(ht, "HasIndex", "HasIndex(%q, %d): %v", xs, i2, err)
+		} else if hi.True() != (i2 >= 0 && i2 < n) {
+			c.failClass(ht, "HasIndex", "HasIndex(%q, %d) = %s", xs, i2, hi.GoString())
+		}
+		iv, err := stdlib.Index(lv, cty.NumberIntVal(int64(i2)))
+		if i2 >= 0 && i2 < n {
+			if err != nil {
+				c.failClass(ht, "Index", "Index(%q, %d): %v", xs, i2, err)
+			} else if iv.AsString() != xs[i2] {
+				c.failClass(ht, "Index", "Index(%q, %d) = %q", xs, i2, iv.AsString())
+			}
+		} else if err == nil {
+			c.failClass(ht, "Index", "Index(%q, %d) = %s, want an error", xs, i2, iv.GoString())
+		}
+
+		// Contains
+		needle := cc.needle
+		if got, err := stdlib.Contains(lv, cty.StringVal(needle)); err != nil {
+			c.failClass(ht, "Contains", "Contains(%q, %q): %v", xs, needle, err)
+		} else {
+			want := false
+			for _, x := range xs {
+				if x == needle {
+					want = true
+				}
+			}
+			if got.True() != want {
+				c.failClass(ht, "Contains", "Contains(%q, %q) = %s", xs, needle, got.GoString())
+			}
+		}
+
+		// Distinct: first occurrences in order
+		if got, err := stdlib.Distinct(strList(xs)); err != nil {
+			c.failClass(ht, "Distinct", "Distinct(%q): %v", xs, err)
+		} else {
+			seen := map[string]bool{}
+			var want []string
+			for _, x := range xs {
+				if !seen[x] {
+					seen[x] = true
+					want = append(want, x)
+				}
+			}
+			if !sameStrings(stringsOf(got), want) {
+				c.failClass(ht, "Distinct", "Distinct(%q) = %q, want %q", xs, stringsOf(got), want)
+			}
+		}
+
+		// Compact: empty strings removed
+		if got, err := stdlib.Compact(strList(xs)); err != nil {
+			c.failClass(ht, "Compact", "Compact(%q): %v", xs, err)
+		} else {
+			var want []string
+			for _, x := range xs {
+				if x != "" {
+					want = append(want, x)
+				}
+			}
+			if !sameStrings(stringsOf(got), want) {
+				c.failClass(ht, "Compact", "Compact(%q) = %q, want %q", xs, stringsOf(got), want)
+			}
+		}
+
+		// ReverseList
+		if got, err := stdlib.ReverseList(lv); err != nil {
+			c.failClass(ht, "ReverseList", "ReverseList(%q): %v", xs, err)
+		} else {
+			want := make([]string, n)
+			for i, x := range xs {
+				want[n-1-i] = x
+			}
+			if !sameStrings(stringsOf(got), want) {
+				c.failClass(ht, "ReverseList", "ReverseList(%q) = %q", xs, stringsOf(got))
+			}
+		}
+
+		// Slice: 0 <= start <= end <= n
+		start, end := cc.start, cc.end
+		if got, err := stdlib.Slice(lv, cty.NumberIntVal(int64(start)), cty.NumberIntVal(int64(end))); err != nil {
+			c.failClass(ht, "Slice", "Slice(%q, %d, %d): %v", xs, start, end, err)
+		} else if !sameStrings(stringsOf(got), xs[start:end]) {
+			c.failClass(ht, "Slice", "Slice(%q, %d, %d) = %q", xs, start, end, stringsOf(got))
+		}
+		if _, err := stdlib.Slice(lv, cty.NumberIntVal(int64(n)+1), cty.NumberIntVal(int64(n)+1)); err == nil {
+			c.failClass(ht, "Slice", "Slice(%q, %d, %d) does not fail", xs, n+1, n+1)
+		}
+
+		// Chunklist: chunks of at most size elements, all but the last exactly size
+		size := cc.size
+		if got, err := stdlib.Chunklist(strList(xs), cty.NumberIntVal(int64(size))); err != nil {
+			c.failClass(ht, "Chunklist", "Chunklist(%q, %d): %v", xs, size, err)
+		} else {
+			chunks := elemsOf(got)
+			var flat []string
+			for i, ch := range chunks {
+				cs := stringsOf(ch)
+				if len(cs) == 0 || len(cs) > size || (i < len(chunks)-1 && len(cs) != size) {
+					c.failClass(ht, "Chunklist", "Chunklist(%q, %d): chunk %d has %d elements", xs, size, i, len(cs))
+				}
+				flat = append(flat, cs...)
+			}
+			if !sameStrings(flat, xs) {
+				c.failClass(ht, "Chunklist", "Chunklist(%q, %d) = %s", xs, size, got.GoString())
+			}
+		}
+		if got, err := stdlib.Chunklist(strList(xs), cty.NumberIntVal(0)); err != nil {
+			c.failClass(ht, "Chunklist", "Chunklist(%q, 0): %v", xs, err)
+		} else if n > 0 && (got.LengthInt() != 1 || !sameStrings(stringsOf(elemsOf(got)[0]), xs)) {
+			// size 0: one chunk holding the whole list
+			c.failClass(ht, "Chunklist", "Chunklist(%q, 0) = %s", xs, got.GoString())
+		}
+		if _, err := stdlib.Chunklist(strList(xs), cty.NumberIntVal(-1)); err == nil {
+			c.failClass(ht, "Chunklist", "Chunklist(%q, -1) does not fail", xs)
+		}
+
+		// Concat: the sequences in order
+		ys := cc.ys
+		if got, err := stdlib.Concat(lv, strList(ys)); err != nil {
+			c.failClass(ht, "Concat", "Concat(%q, %q): %v", xs, ys, err)
+		} else if want := append(append([]string(nil), xs...), ys...); !sameStrings(stringsOf(got), want) {
+			c.failClass(ht, "Concat", "Concat(%q, %q) = %q", xs, ys, stringsOf(got))
+		}
+
+		// Flatten: nested sequences flattened into a tuple
+		{
+			var want []string
+			var parts []cty.Value
+			for _, p := range cc.parts {
+				want = append(want, p.zs...)
+				parts = append(parts, p.value())
+			}
+			if cc.extra != nil && len(want) < 6 {
+				parts = append(parts, cty.StringVal(*cc.extra))
+				want = append(want, *cc.extra)
+			}
+			if got, err := stdlib.Flatten(cty.TupleVal(parts)); err != nil {
+				c.failClass(ht, "Flatten", "Flatten(%s): %v", cty.TupleVal(parts).GoString(), err)
+			} else if !got.Type().IsTupleType() {
+				c.failClass(ht, "Flatten", "Flatten gives a %s, want a tuple", tyString(got.Type()))
+			} else if !sameStrings(stringsOf(got), want) {
+				c.failClass(ht, "Flatten", "Flatten(%s) = %q, want %q", cty.TupleVal(parts).GoString(), stringsOf(got), want)
+			}
+		}
+
+		// Coalesce / CoalesceList
+		{
+			var args []cty.Value
+			want := ""
+			found := false
+			for _, p := range cc.coalesce {
+				if p == nil {
+					args = append(args, cty.NullVal(cty.String))
+					continue
+				}
+				if !found {
+					want, found = *p, true
+				}
+				args = append(args, cty.StringVal(*p))
+			}
+			got, err := stdlib.Coalesce(args...)
+			switch {
+			case !found && err == nil:
+				c.failClass(ht, "Coalesce", "Coalesce of nulls only = %s, want an error", got.GoString())
+			case found && err != nil:
+				c.failClass(ht, "Coalesce", "Coalesce(%s): %v", args, err)
+			case found && got.AsString() != want:
+				c.failClass(ht, "Coalesce", "Coalesce(%s) = %q, want %q", args, got.AsString(), want)
+			}
+			var lists []cty.Value
+			var wantL []string
+			foundL := false
+			for _, zs := range cc.lists {
+				if len(zs) > 0 && !foundL {
+					wantL, foundL = zs, true
+				}
+				lists = append(lists, strList(zs))
+			}
+			got, err = stdlib.CoalesceList(lists...)
+			switch {
+			case !foundL && err == nil:
+				c.failClass(ht, "CoalesceList", "CoalesceList of empty lists = %s, want an error", got.GoString())
+			case foundL && err != nil:
+				c.failClass(ht, "CoalesceList", "CoalesceList(%s): %v", lists, err)
+			case foundL && !sameStrings(stringsOf(got), wantL):
+				c.failClass(ht, "CoalesceList", "CoalesceList(%s) = %q, want %q", lists, stringsOf(got), wantL)
+			}
+		}
+
+		// maps: Keys, Values, Lookup, Merge, Zipmap
+		m := cc.m
+		mv := strMap(m)
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		vals := make([]string, len(keys))
+		for i, k := range keys {
+			vals[i] = m[k]
+		}
+		if got, err := stdlib.Keys(mv); err != nil {
+			c.failClass(ht, "Keys", "Keys(%v): %v", m, err)
+		} else if !sameStrings(stringsOf(got), keys) {
+			c.failClass(ht, "Keys", "Keys(%v) = %q, want %q", m, stringsOf(got), keys)
+		}
+		if got, err := stdlib.Values(mv); err != nil {
+			c.failClass(ht, "Values", "Values(%v): %v", m, err)
+		} else if !sameStrings(stringsOf(got), vals) {
+			c.failClass(ht, "Values", "Values(%v) = %q, want %q", m, stringsOf(got), vals)
+		}
+		key, def := cc.key, cc.def
+		if got, err := stdlib.Lookup(mv, cty.StringVal(key), cty.StringVal(def)); err != nil {
+			c.failClass(ht, "Lookup", "Lookup(%v, %q): %v", m, key, err)
+		} else {
+			want, ok := m[key]
+			if !ok {
+				want = def
+			}
+			if got.AsString() != want {
+				c.failClass(ht, "Lookup", "Lookup(%v, %q, %q) = %q, want %q", m, key, def, got.AsString(), want)
+			}
+		}
+		m2 := cc.m2
+		if got, err := stdlib.Merge(mv, strMap(m2)); err != nil {
+			c.failClass(ht, "Merge", "Merge(%v, %v): %v", m, m2, err)
+		} else {
+			want := map[string]string{}
+			for k, v := range m {
+				want[k] = v
+			}
+			for k, v := range m2 {
+				want[k] = v
+			}
+			gotM := map[string]string{}
+			if !got.IsNull() && got.LengthInt() > 0 {
+				for it := got.ElementIterator(); it.Next(); {
+					k, v := it.Element()
+					gotM[k.AsString()] = v.AsString()
+				}
+			}
+			if fmt.Sprint(gotM) != fmt.Sprint(want) {
+				c.failClass(ht, "Merge", "Merge(%v, %v) = %v, want %v", m, m2, gotM, want)
+			}
+		}
+		if got, err := stdlib.Zipmap(strList(keys), strList(vals)); err != nil {
+			c.failClass(ht, "Zipmap", "Zipmap(%q, %q): %v", keys, vals, err)
+		} else if !got.RawEquals(mv) {
+			c.failClass(ht, "Zipmap", "Zipmap(%q, %q) = %s, want %s", keys, vals, got.GoString(), mv.GoString())
+		}
+		if len(keys) > 0 {
+			if got, err := stdlib.Zipmap(strList(keys), strList(vals[1:])); err == nil {
+				c.failClass(ht, "Zipmap", "Zipmap with %d keys and %d values = %s, want an error", len(keys), len(vals)-1, got.GoString())
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- sets
+
+func intSet(xs []int) cty.Value {
+	if len(xs) == 0 {
+		return cty.SetValEmpty(cty.Number)
+	}
+	vals := make([]cty.Value, len(xs))
+	for i, x := range xs {
+		vals[i] = cty.NumberIntVal(int64(x))
+	}
+	return cty.SetVal(vals)
+}
+
+func setOf(xs []int) map[int]bool {
+	m := map[int]bool{}
+	for _, x := range xs {
+		m[x] = true
+	}
+	return m
+}
+
+func setKeys(m map[int]bool) []int {
+	var out []int
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Ints(out)
+	return out
+}
+
+func intsOf(v cty.Value) []int {
+	var out []int
+	for _, e := range elemsOf(v) {
+		bf := e.AsBigFloat()
+		i, _ := bf.Int64()
+		out = append(out, int(i))
+	}
+	sort.Ints(out)
+	return out
+}
+
+func sameInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// setCase: two sets of small integers and a probe.
+type setCase struct {
+	a, b map[int]bool
+	x    int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c setCase) GoString() string {
+	return fmt.Sprintf("a %v b %v x %d", setKeys(c.a), setKeys(c.b), c.x)
+}
+
+var (
+	smallInts = hegel.Integers(-3, 5)
+	intSets   = hegel.Map(many(smallInts, 0, 4), setOf)
+	setCases  = hegel.Composite(func(tc hegel.TestCase) setCase {
+		return setCase{a: hegel.Draw(tc, intSets), b: hegel.Draw(tc, intSets), x: hegel.Draw(tc, smallInts)}
+	})
+)
+
+// TestHegelSetFunctions: the set functions against set algebra over small integers.
+func TestHegelSetFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, setCases)
+		a, b, x := sc.a, sc.b, sc.x
+		av, bv := intSet(setKeys(a)), intSet(setKeys(b))
+
+		if got, err := stdlib.SetHasElement(av, cty.NumberIntVal(int64(x))); err != nil {
+			c.failClass(ht, "SetHasElement", "SetHasElement(%v, %d): %v", setKeys(a), x, err)
+		} else if got.True() != a[x] {
+			c.failClass(ht, "SetHasElement", "SetHasElement(%v, %d) = %s", setKeys(a), x, got.GoString())
+		}
+
+		check := func(name string, got cty.Value, err error, want map[int]bool) {
+			if err != nil {
+				c.failClass(ht, name, "%s(%v, %v): %v", name, setKeys(a), setKeys(b), err)
+				return
+			}
+			if !got.Type().IsSetType() {
+				c.failClass(ht, name, "%s gives a %s, want a set", name, tyString(got.Type()))
+				return
+			}
+			if !sameInts(intsOf(got), setKeys(want)) {
+				c.failClass(ht, name, "%s(%v, %v) = %v, want %v", name, setKeys(a), setKeys(b), intsOf(got), setKeys(want))
+			}
+		}
+		union := map[int]bool{}
+		inter := map[int]bool{}
+		diff := map[int]bool{}
+		sym := map[int]bool{}
+		for k := range a {
+			union[k] = true
+			if b[k] {
+				inter[k] = true
+			} else {
+				diff[k] = true
+				sym[k] = true
+			}
+		}
+		for k := range b {
+			union[k] = true
+			if !a[k] {
+				sym[k] = true
+			}
+		}
+		got, err := stdlib.SetUnion(av, bv)
+		check("SetUnion", got, err, union)
+		got, err = stdlib.SetIntersection(av, bv)
+		check("SetIntersection", got, err, inter)
+		got, err = stdlib.SetSubtract(av, bv)
+		check("SetSubtract", got, err, diff)
+		got, err = stdlib.SetSymmetricDifference(av, bv)
+		check("SetSymmetricDifference", got, err, sym)
+
+		// SetProduct: every pair once, as tuples
+		if len(a) > 0 && len(b) > 0 {
+			got, err := stdlib.SetProduct(av, bv)
+			if err != nil {
+				c.failClass(ht, "SetProduct", "SetProduct(%v, %v): %v", setKeys(a), setKeys(b), err)
+			} else {
+				pairs := map[[2]int]bool{}
+				for _, e := range elemsOf(got) {
+					es := elemsOf(e)
+					if len(es) != 2 {
+						c.failClass(ht, "SetProduct", "SetProduct element %s is not a pair", e.GoString())
+						return
+					}
+					p0, _ := es[0].AsBigFloat().Int64()
+					p1, _ := es[1].AsBigFloat().Int64()
+					pairs[[2]int{int(p0), int(p1)}] = true
+				}
+				if len(pairs) != len(a)*len(b) || got.LengthInt() != len(a)*len(b) {
+					c.failClass(ht, "SetProduct", "SetProduct(%v, %v) has %d elements (%d distinct), want %d", setKeys(a), setKeys(b), got.LengthInt(), len(pairs), len(a)*len(b))
+					return
+				}
+				for k := range a {
+					for l := range b {
+						if !pairs[[2]int{k, l}] {
+							c.failClass(ht, "SetProduct", "SetProduct(%v, %v) lacks (%d, %d)", setKeys(a), setKeys(b), k, l)
+						}
+					}
+				}
+			}
+		} else if _, err := stdlib.SetProduct(av, bv); err == nil && len(a)+len(b) > 0 {
+			// the product with an empty set is empty; both empty is fine too
+			_ = err
+		}
+
+		// Contains and Distinct on sets, Length
+		if got, err := stdlib.Length(av); err != nil || got.AsBigFloat().Cmp(big.NewFloat(float64(len(a)))) != 0 {
+			c.failClass(ht, "Length", "Length(set %v) = %s, %v", setKeys(a), got.GoString(), err)
+		}
+		if got, err := stdlib.Contains(av, cty.NumberIntVal(int64(x))); err != nil || got.True() != a[x] {
+			c.failClass(ht, "Contains", "Contains(set %v, %d) = %s, %v", setKeys(a), x, got.GoString(), err)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- numbers
+
+func bigOf(v cty.Value) *big.Float { return v.AsBigFloat() }
+
+func floorBig(bf *big.Float) *big.Int {
+	i, acc := bf.Int(nil)
+	if acc == big.Above { // truncation went up: negative non-integer
+		i.Sub(i, big.NewInt(1))
+	}
+	return i
+}
+
+func ceilBig(bf *big.Float) *big.Int {
+	i, acc := bf.Int(nil)
+	if acc == big.Below { // truncation went down: positive non-integer
+		i.Add(i, big.NewInt(1))
+	}
+	return i
+}
+
+// comparisonWant is what the descriptions of LessThan, LessThanOrEqualTo, GreaterThan and
+// GreaterThanOrEqualTo say of two numbers comparing as cmp: GreaterThan "returns true if and
+// only if the second number is greater than the first", and so on. While
+// Known.comparisonDescriptionsReversed is on, the functions compare the first number with the
+// second (go-cty/4).
+func comparisonWant(cmp int) (lt, le, gt, ge bool) {
+	if Known.comparisonDescriptionsReversed {
+		return cmp < 0, cmp <= 0, cmp > 0, cmp >= 0
+	}
+	return cmp > 0, cmp >= 0, cmp < 0, cmp <= 0
+}
+
+// moduloByZeroWant is Value.Modulo's documented result for a zero divisor: an infinity of the
+// dividend's sign. While Known.moduloByZeroIsDividend is on it is the dividend (go-cty/8).
+func moduloByZeroWant(a cty.Value) cty.Value {
+	if Known.moduloByZeroIsDividend {
+		return a
+	}
+	if a.AsBigFloat().Sign() < 0 {
+		return cty.NegativeInfinity
+	}
+	return cty.PositiveInfinity
+}
+
+// numberCase: two numbers and the arguments of Pow and ParseInt.
+type numberCase struct {
+	a, b   cty.Value
+	exp    int      // Pow: 0 to 6
+	base   int      // ParseInt: 2 to 36
+	parsed *big.Int // ParseInt: the integer written in the base
+	upper  bool     // ParseInt: the digits upper-cased
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c numberCase) GoString() string {
+	return fmt.Sprintf("a %s b %s exp %d base %d parsed %s upper %v", numStr(c.a), numStr(c.b), c.exp, c.base, c.parsed, c.upper)
+}
+
+var (
+	// parsedInts: an integer within a hundred thousand or, a fifth of the time, a thirty-digit one.
+	parsedInts = weighted(
+		choice[*big.Int]{80, hegel.Map(ints(-100000, 100000), big.NewInt)},
+		choice[*big.Int]{20, hegel.Just(mustBig("123456789012345678901234567890"))},
+	)
+	numberCases = hegel.Composite(func(tc hegel.TestCase) numberCase {
+		return numberCase{
+			a:      hegel.Draw(tc, numbers),
+			b:      hegel.Draw(tc, numbers),
+			exp:    hegel.Draw(tc, hegel.Integers(0, 6)),
+			base:   hegel.Draw(tc, hegel.Integers(2, 36)),
+			parsed: hegel.Draw(tc, parsedInts),
+			upper:  hegel.Draw(tc, chance(30)),
+		}
+	})
+)
+
+func mustBig(s string) *big.Int {
+	i, ok := new(big.Int).SetString(s, 10)
+	if !ok {
+		panic(s)
+	}
+	return i
+}
+
+// TestHegelNumberFunctions: the number functions against big.Float and big.Int. The
+// comparison functions' descriptions name the operands backwards (go-cty/4); Modulo by zero
+// returns the dividend (go-cty/8).
+func TestHegelNumberFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nc := hegel.Draw(ht, numberCases)
+		a, b := nc.a, nc.b
+		ab, bb := bigOf(a), bigOf(b)
+
+		checkNum := func(name string, got cty.Value, err error, want *big.Float) {
+			if err != nil {
+				c.failClass(ht, name, "%s(%s, %s): %v", name, numStr(a), numStr(b), err)
+				return
+			}
+			if got.Type() != cty.Number || !got.IsKnown() || got.IsNull() {
+				c.failClass(ht, name, "%s(%s, %s) = %s, want a known number", name, numStr(a), numStr(b), got.GoString())
+				return
+			}
+			if got.AsBigFloat().Cmp(want) != 0 {
+				c.failClass(ht, name, "%s(%s, %s) = %s, want %s", name, numStr(a), numStr(b), numStr(got), want.Text('g', 30))
+			}
+		}
+		checkBool := func(name, shape string, got cty.Value, err error, want bool) {
+			if err != nil {
+				c.mismatch(ht, name, shape, "%s(%s, %s): %v", name, numStr(a), numStr(b), err)
+				return
+			}
+			if got.Type() != cty.Bool || !got.IsKnown() || got.IsNull() {
+				c.mismatch(ht, name, shape, "%s(%s, %s) = %s, want a known bool", name, numStr(a), numStr(b), got.GoString())
+				return
+			}
+			if got.True() != want {
+				c.mismatch(ht, name, shape, "%s(%s, %s) = %v, want %v", name, numStr(a), numStr(b), got.True(), want)
+			}
+		}
+
+		got, err := stdlib.Absolute(a)
+		checkNum("Absolute", got, err, new(big.Float).Abs(ab))
+		got, err = stdlib.Negate(a)
+		checkNum("Negate", got, err, new(big.Float).Neg(ab))
+		got, err = stdlib.Signum(a)
+		checkNum("Signum", got, err, big.NewFloat(float64(ab.Sign())))
+		got, err = stdlib.Int(a)
+		{
+			i, _ := ab.Int(nil)
+			checkNum("Int", got, err, new(big.Float).SetInt(i))
+		}
+		got, err = stdlib.Floor(a)
+		checkNum("Floor", got, err, new(big.Float).SetInt(floorBig(ab)))
+		got, err = stdlib.Ceil(a)
+		checkNum("Ceil", got, err, new(big.Float).SetInt(ceilBig(ab)))
+
+		cmp := ab.Cmp(bb)
+		// the descriptions of the comparison functions: GreaterThan "returns true if and only if
+		// the second number is greater than the first", and so on
+		lt, le, gt, ge := comparisonWant(cmp)
+		shape := shapeIf(cmp != 0, "go-cty/4")
+		got, err = stdlib.LessThan(a, b)
+		checkBool("LessThan", shape, got, err, lt)
+		got, err = stdlib.LessThanOrEqualTo(a, b)
+		checkBool("LessThanOrEqualTo", shape, got, err, le)
+		got, err = stdlib.GreaterThan(a, b)
+		checkBool("GreaterThan", shape, got, err, gt)
+		got, err = stdlib.GreaterThanOrEqualTo(a, b)
+		checkBool("GreaterThanOrEqualTo", shape, got, err, ge)
+		got, err = stdlib.Equal(a, b)
+		checkBool("Equal", "", got, err, cmp == 0)
+		got, err = stdlib.NotEqual(a, b)
+		checkBool("NotEqual", "", got, err, cmp != 0)
+
+		minB, maxB := ab, bb
+		if cmp > 0 {
+			minB, maxB = bb, ab
+		}
+		got, err = stdlib.Min(a, b)
+		checkNum("Min", got, err, minB)
+		got, err = stdlib.Max(a, b)
+		checkNum("Max", got, err, maxB)
+		got, err = stdlib.Min(a)
+		checkNum("Min", got, err, ab)
+		if _, err := stdlib.Max(); err == nil {
+			c.failClass(ht, "Max", "Max() does not fail")
+		}
+
+		// algebra: commutativity, inverse, identity
+		s1, _ := stdlib.Add(a, b)
+		s2, _ := stdlib.Add(b, a)
+		if !s1.RawEquals(s2) {
+			c.failClass(ht, "Add", "Add(%s, %s) = %s but Add(%s, %s) = %s", numStr(a), numStr(b), numStr(s1), numStr(b), numStr(a), numStr(s2))
+		}
+		p1, _ := stdlib.Multiply(a, b)
+		p2, _ := stdlib.Multiply(b, a)
+		if !p1.RawEquals(p2) {
+			c.failClass(ht, "Multiply", "Multiply(%s, %s) = %s but Multiply(%s, %s) = %s", numStr(a), numStr(b), numStr(p1), numStr(b), numStr(a), numStr(p2))
+		}
+		z, _ := stdlib.Subtract(a, a)
+		checkNum("Subtract", z, nil, new(big.Float))
+		one, err := stdlib.Divide(a, a)
+		if ab.Sign() == 0 {
+			if err == nil {
+				c.failClass(ht, "Divide", "Divide(0, 0) = %s, want an error", one.GoString())
+			}
+		} else {
+			checkNum("Divide", one, err, big.NewFloat(1))
+		}
+
+		// integer arithmetic is exact
+		if ab.IsInt() && bb.IsInt() {
+			ai, _ := ab.Int(nil)
+			bi, _ := bb.Int(nil)
+			got, err = stdlib.Add(a, b)
+			checkNum("Add", got, err, new(big.Float).SetInt(new(big.Int).Add(ai, bi)))
+			got, err = stdlib.Subtract(a, b)
+			checkNum("Subtract", got, err, new(big.Float).SetInt(new(big.Int).Sub(ai, bi)))
+			got, err = stdlib.Multiply(a, b)
+			checkNum("Multiply", got, err, new(big.Float).SetInt(new(big.Int).Mul(ai, bi)))
+			if bi.Sign() != 0 {
+				got, err = stdlib.Modulo(a, b)
+				checkNum("Modulo", got, err, new(big.Float).SetInt(new(big.Int).Rem(ai, bi)))
+				prod, _ := stdlib.Multiply(a, b)
+				q, err := stdlib.Divide(prod, b)
+				checkNum("Divide", q, err, ab)
+			} else {
+				// Value.Modulo documents an infinity of the dividend's sign for a zero divisor
+				got, err := stdlib.Modulo(a, b)
+				want := moduloByZeroWant(a)
+				if err != nil {
+					c.mismatch(ht, "Modulo", "go-cty/8", "Modulo(%s, 0): %v", numStr(a), err)
+				} else if !got.RawEquals(want) {
+					c.mismatch(ht, "Modulo", "go-cty/8", "Modulo(%s, 0) = %s, want %s", numStr(a), got.GoString(), want.GoString())
+				}
+			}
+			// Pow with a small non-negative exponent
+			if ai.IsInt64() && ai.Int64() >= -20 && ai.Int64() <= 20 {
+				e := nc.exp
+				got, err = stdlib.Pow(a, cty.NumberIntVal(int64(e)))
+				checkNum("Pow", got, err, new(big.Float).SetInt(new(big.Int).Exp(ai, big.NewInt(int64(e)), nil)))
+			}
+		}
+
+		// ParseInt against big.Int
+		{
+			base := nc.base
+			ai := nc.parsed
+			str := ai.Text(base)
+			if nc.upper {
+				str = strings.ToUpper(str)
+			}
+			got, err := stdlib.ParseInt(cty.StringVal(str), cty.NumberIntVal(int64(base)))
+			if err != nil {
+				c.failClass(ht, "ParseInt", "ParseInt(%q, %d): %v", str, base, err)
+			} else if got.AsBigFloat().Cmp(new(big.Float).SetInt(ai)) != 0 {
+				c.failClass(ht, "ParseInt", "ParseInt(%q, %d) = %s, want %s", str, base, numStr(got), ai)
+			}
+			if base < 36 {
+				bad := str + "z"
+				if got, err := stdlib.ParseInt(cty.StringVal(bad), cty.NumberIntVal(int64(base))); err == nil {
+					c.failClass(ht, "ParseInt", "ParseInt(%q, %d) = %s, want an error", bad, base, numStr(got))
+				}
+			}
+		}
+
+		// unknowns propagate, nulls fail
+		if u, err := stdlib.Add(a, cty.UnknownVal(cty.Number)); err != nil || u.IsKnown() {
+			c.failClass(ht, "unknown", "Add(%s, unknown) = %s, %v", numStr(a), u.GoString(), err)
+		}
+		if _, err := stdlib.Add(a, cty.NullVal(cty.Number)); err == nil {
+			c.failClass(ht, "null", "Add(%s, null) does not fail", numStr(a))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- range
+
+// rangeCase: Range's one, two or three arguments.
+type rangeCase struct {
+	nargs            int
+	start, end, step int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c rangeCase) GoString() string { return fmt.Sprintf("Range%v", c.ints()) }
+
+// ints is the arguments: the end alone, start and end, or start, end and step.
+func (c rangeCase) ints() []int {
+	switch c.nargs {
+	case 1:
+		return []int{c.end}
+	case 2:
+		return []int{c.start, c.end}
+	}
+	return []int{c.start, c.end, c.step}
+}
+
+func (c rangeCase) args() []cty.Value {
+	var args []cty.Value
+	for _, i := range c.ints() {
+		args = append(args, cty.NumberIntVal(int64(i)))
+	}
+	return args
+}
+
+// series is the documented series and step: with one argument from zero to the end, with two
+// from the start to the end, stepping by -1 when the end is below the start (as the
+// implementation does; the doc comment says the step defaults to 1), else by the step.
+func (c rangeCase) series() (start, end, step int) {
+	switch c.nargs {
+	case 1:
+		start, end, step = 0, c.end, 1
+	case 2:
+		start, end, step = c.start, c.end, 1
+	default:
+		return c.start, c.end, c.step
+	}
+	if end < start {
+		step = -1
+	}
+	return start, end, step
+}
+
+// rangeWant is Range's documented result on the series: an error for a zero step or a step
+// pointing away from the end, else the numbers from the start up to (not including) the end.
+// While Known.rangeZeroStepCheck is on, a zero step from the caller passes the check: the
+// empty series when the start is the end (go-cty/5), and the error of the 1024-value cap
+// otherwise.
+func rangeWant(start, end, step int) (want []int, wantErr bool) {
+	if step == 0 {
+		return nil, !(Known.rangeZeroStepCheck && start == end)
+	}
+	if (step > 0 && end < start) || (step < 0 && end > start) {
+		return nil, true
+	}
+	for x := start; (step > 0 && x < end) || (step < 0 && x > end); x += step {
+		want = append(want, x)
+	}
+	return want, false
+}
+
+var (
+	rangeEnds  = hegel.Integers(-6, 6)
+	rangeCases = hegel.Composite(func(tc hegel.TestCase) rangeCase {
+		return rangeCase{
+			nargs: hegel.Draw(tc, hegel.Integers(1, 3)),
+			start: hegel.Draw(tc, rangeEnds),
+			end:   hegel.Draw(tc, rangeEnds),
+			step:  hegel.Draw(tc, hegel.Integers(-3, 3)),
+		}
+	})
+)
+
+// checkRange checks Range's result against the documented series.
+func checkRange(c *collector, ht *hegel.T, shape string, rc rangeCase) {
+	args := rc.args()
+	start, end, step := rc.series()
+	got, err := stdlib.Range(args...)
+	want, wantErr := rangeWant(start, end, step)
+	if wantErr {
+		if err == nil {
+			c.mismatch(ht, "Range", shape, "Range(%d, %d, %d) = %s, want an error", start, end, step, got.GoString())
+		}
+		return
+	}
+	if err != nil {
+		c.mismatch(ht, "Range", shape, "Range(%d, %d, %d): %v", start, end, step, err)
+	} else if !got.Type().IsListType() || got.Type().ElementType() != cty.Number {
+		c.mismatch(ht, "Range", shape, "Range gives a %s", tyString(got.Type()))
+	} else {
+		var gotInts []int
+		for _, e := range elemsOf(got) {
+			i, _ := e.AsBigFloat().Int64()
+			gotInts = append(gotInts, int(i))
+		}
+		if !sameInts(gotInts, want) {
+			c.mismatch(ht, "Range", shape, "Range(%v) = %v, want %v", rc.ints(), gotInts, want)
+		}
+	}
+}
+
+// TestHegelRange: Range gives the documented series. A zero step from the caller is not
+// rejected: Range(n, n, 0) is the empty list (go-cty/5).
+func TestHegelRange(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, rangeCases)
+		start, end, step := rc.series()
+		checkRange(c, ht, shapeIf(rc.nargs == 3 && step == 0 && start == end, "go-cty/5"), rc)
+	})
+}
+
+// --------------------------------------------------------------------------- format
+
+// fmtSeg is one segment of a format string: a literal, then a verb with its flags, width and
+// precision, and the argument it consumes.
+type fmtSeg struct {
+	lit   string // literal text before the verb ("" none; "%%" an escaped percent sign)
+	verb  string // s d v t q f x o b X
+	pad   string // "", "-" or "0"
+	plus  bool
+	width int // -1 none
+	prec  int // -1 none
+	arg   cty.Value
+}
+
+// raw is the verb's text in the format string.
+func (s fmtSeg) raw() string {
+	r := "%" + s.pad
+	if s.plus {
+		r += "+"
+	}
+	if s.width >= 0 {
+		r += itoa(s.width)
+	}
+	if s.prec >= 0 {
+		r += "." + itoa(s.prec)
+	}
+	return r + s.verb
+}
+
+// argString is the string a %s argument converts to.
+func argString(arg cty.Value) string {
+	switch arg.Type() {
+	case cty.Number:
+		return numStr(arg)
+	case cty.Bool:
+		return fmt.Sprint(arg.True())
+	}
+	return arg.AsString()
+}
+
+// want is the documented formatting of the argument by the verb: %s converts to a string,
+// truncated to the precision in characters and padded to the width (while
+// Known.formatZeroPrecision is on, a precision of 0 is ignored: go-cty/6); the integer verbs
+// and %f as Go formats a big.Int or big.Float; %t a bool; %q the JSON string; %v a string as
+// is, a number by its shortest form, a bool as %t.
+func (s fmtSeg) want() string {
+	switch s.verb {
+	case "s":
+		r := []rune(argString(s.arg))
+		prec := s.prec
+		if prec == 0 && Known.formatZeroPrecision {
+			prec = -1 // precision 0 is ignored
+		}
+		if prec >= 0 && prec < len(r) {
+			r = r[:prec]
+		}
+		w := string(r)
+		if s.width > len(r) {
+			pad := strings.Repeat(" ", s.width-len(r))
+			if s.pad == "-" {
+				w = w + pad
+			} else {
+				w = pad + w
+			}
+		}
+		return w
+	case "d", "x", "o", "b", "X":
+		i, _ := s.arg.AsBigFloat().Int(nil)
+		return fmt.Sprintf(s.raw(), i)
+	case "f":
+		return fmt.Sprintf(s.raw(), s.arg.AsBigFloat())
+	case "t":
+		return fmt.Sprint(s.arg.True())
+	case "q":
+		jb, _ := json.Marshal(s.arg.AsString())
+		return string(jb)
+	case "v":
+		switch s.arg.Type() {
+		case cty.Number:
+			return s.arg.AsBigFloat().Text('g', -1)
+		case cty.Bool:
+			return fmt.Sprint(s.arg.True())
+		}
+		return s.arg.AsString()
+	}
+	panic("fmtSeg.want: verb " + s.verb)
+}
+
+// formatCase: the segments of a format string and a trailing literal.
+type formatCase struct {
+	segs []fmtSeg
+	tail string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c formatCase) GoString() string {
+	s := fmt.Sprintf("format %q, args", c.format())
+	for _, seg := range c.segs {
+		s += " " + seg.arg.GoString()
+	}
+	return s
+}
+
+func (c formatCase) format() string {
+	var b strings.Builder
+	for _, seg := range c.segs {
+		b.WriteString(seg.lit)
+		b.WriteString(seg.raw())
+	}
+	b.WriteString(c.tail)
+	return b.String()
+}
+
+func (c formatCase) args() []cty.Value {
+	var args []cty.Value
+	for _, seg := range c.segs {
+		args = append(args, seg.arg)
+	}
+	return args
+}
+
+// want is the documented output: the literals with %% unescaped, each verb's formatting.
+func (c formatCase) want() string {
+	var b strings.Builder
+	for _, seg := range c.segs {
+		b.WriteString(strings.ReplaceAll(seg.lit, "%%", "%"))
+		b.WriteString(seg.want())
+	}
+	b.WriteString(strings.ReplaceAll(c.tail, "%%", "%"))
+	return b.String()
+}
+
+// shape names go-cty/6 when a %s has a precision of 0 and a string to truncate.
+func (c formatCase) shape() string {
+	for _, seg := range c.segs {
+		if seg.verb == "s" && seg.prec == 0 && argString(seg.arg) != "" {
+			return "go-cty/6"
+		}
+	}
+	return ""
+}
+
+// widthSpec is a width with its flags.
+type widthSpec struct {
+	pad   string
+	plus  bool
+	width int
+}
+
+var (
+	fmtVerbs    = hegel.SampledFrom([]string{"s", "s", "d", "v", "t", "q", "f", "x", "o", "b", "X"})
+	fmtLiterals = maybe(50, hegel.SampledFrom([]string{"x", " ", "a-b", "%%", "日", "=", "\n"}))
+	fmtTails    = maybe(50, hegel.SampledFrom([]string{"!", " end", "%%", "日"}))
+	fmtStrings  = hegel.SampledFrom([]string{"", "a", "hello", "Hello World", "日本語", "🙂", "ab cd", "x_y"})
+	// stringArgs: a %s argument: a string, a number or a bool (converted).
+	stringArgs = weighted(
+		choice[cty.Value]{72, hegel.Map(fmtStrings, cty.StringVal)},
+		choice[cty.Value]{20, hegel.Map(ints(-50, 50), intVal)},
+		choice[cty.Value]{8, bools},
+	)
+	// integerArgs: an integer within three hundred or, now and then, 2^40.
+	integerArgs = weighted(choice[cty.Value]{85, hegel.Map(ints(-300, 300), intVal)}, choice[cty.Value]{15, hegel.Just(cty.NumberIntVal(1 << 40))})
+	quotedArgs  = hegel.Map(plainSamples, cty.StringVal)
+	// asIsArgs: a %v argument: a string, a number or a bool.
+	asIsArgs = weighted(choice[cty.Value]{34, quotedArgs}, choice[cty.Value]{33, numbers}, choice[cty.Value]{33, bools})
+	// fmtPrecisions: none, or 0 to 4 three times in ten.
+	fmtPrecisions = weighted(choice[int]{70, hegel.Just(-1)}, choice[int]{30, hegel.Integers(0, 4)})
+	noPrecision   = hegel.Just(-1)
+	// segmentsOf: the segment generator per verb: a literal half the time; for the verbs with
+	// a width (not v, t, q) a width three times in ten with its flags ("-" four times in ten,
+	// else "0" three times in ten and "+" three times in ten, neither on %s); a precision on
+	// %s and %f; the argument of the verb's kind.
+	segmentsOf = map[string]hegel.Generator[fmtSeg]{
+		"s": segments("s", widths(weighted(choice[string]{60, hegel.Just("")}, choice[string]{40, hegel.Just("-")}), hegel.Just(false)), fmtPrecisions, stringArgs),
+		"d": segments("d", numberWidths, noPrecision, integerArgs),
+		"x": segments("x", numberWidths, noPrecision, integerArgs),
+		"o": segments("o", numberWidths, noPrecision, integerArgs),
+		"b": segments("b", numberWidths, noPrecision, integerArgs),
+		"X": segments("X", numberWidths, noPrecision, integerArgs),
+		"f": segments("f", numberWidths, fmtPrecisions, numbers),
+		"v": segments("v", noWidth, noPrecision, asIsArgs),
+		"t": segments("t", noWidth, noPrecision, bools),
+		"q": segments("q", noWidth, noPrecision, quotedArgs),
+	}
+	fmtSegments = hegel.FlatMap(fmtVerbs, func(verb string) hegel.Generator[fmtSeg] { return segmentsOf[verb] })
+	formatCases = hegel.Composite(func(tc hegel.TestCase) formatCase {
+		return formatCase{segs: hegel.Draw(tc, many(fmtSegments, 0, 4)), tail: hegel.Draw(tc, fmtTails)}
+	})
+	noWidth      = hegel.Just[*widthSpec](nil)
+	numberWidths = widths(weighted(choice[string]{42, hegel.Just("")}, choice[string]{40, hegel.Just("-")}, choice[string]{18, hegel.Just("0")}), chance(30))
+)
+
+// widths is a width of 0 to 8 with its flags three times in ten, else none.
+func widths(pads hegel.Generator[string], plus hegel.Generator[bool]) hegel.Generator[*widthSpec] {
+	return optional(30, hegel.Composite(func(tc hegel.TestCase) widthSpec {
+		return widthSpec{pad: hegel.Draw(tc, pads), plus: hegel.Draw(tc, plus), width: hegel.Draw(tc, hegel.Integers(0, 8))}
+	}))
+}
+
+// segments is the segment generator of one verb.
+func segments(verb string, widths hegel.Generator[*widthSpec], precs hegel.Generator[int], args hegel.Generator[cty.Value]) hegel.Generator[fmtSeg] {
+	return hegel.Composite(func(tc hegel.TestCase) fmtSeg {
+		seg := fmtSeg{lit: hegel.Draw(tc, fmtLiterals), verb: verb, width: -1, prec: hegel.Draw(tc, precs), arg: hegel.Draw(tc, args)}
+		if w := hegel.Draw(tc, widths); w != nil {
+			seg.pad, seg.plus, seg.width = w.pad, w.plus, w.width
+		}
+		return seg
+	})
+}
+
+// checkFormat checks Format of the case against its documented output.
+func checkFormat(c *collector, ht *hegel.T, shape string, fc formatCase) {
+	format, args, want := fc.format(), fc.args(), fc.want()
+	var argDesc []string
+	for _, a := range args {
+		argDesc = append(argDesc, a.GoString())
+	}
+	got, err := stdlib.Format(cty.StringVal(format), args...)
+	if err != nil {
+		c.mismatch(ht, "Format", shape, "Format(%q, %s): %v", format, argDesc, err)
+	} else if !got.IsKnown() || got.Type() != cty.String {
+		c.mismatch(ht, "Format", shape, "Format(%q, %s) = %s", format, argDesc, got.GoString())
+	} else if got.AsString() != want {
+		c.mismatch(ht, "Format", shape, "Format(%q, %s) = %q, want %q", format, argDesc, got.AsString(), want)
+	}
+}
+
+// TestHegelFormat: Format against the documented verbs, flags, widths and precisions; too few
+// arguments fail; a null argument fails except for %v, which prints "null"; an unknown
+// argument gives an unknown. %s ignores a precision of 0 (go-cty/6).
+func TestHegelFormat(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		fc := hegel.Draw(ht, formatCases)
+		checkFormat(c, ht, fc.shape(), fc)
+
+		// too few arguments fail; a null argument fails; an unknown one gives an unknown
+		format, args := fc.format(), fc.args()
+		n := len(args)
+		if n > 0 {
+			if got, err := stdlib.Format(cty.StringVal(format), args[:n-1]...); err == nil {
+				c.failClass(ht, "Format args", "Format(%q) with %d of %d arguments = %s, want an error", format, n-1, n, got.GoString())
+			}
+			// a null argument: "null" for %v, an error otherwise
+			nulled := append([]cty.Value(nil), args...)
+			nulled[0] = cty.NullVal(args[0].Type())
+			got, err := stdlib.Format(cty.StringVal(format), nulled...)
+			if fc.segs[0].verb == "v" {
+				if err != nil || !strings.Contains(got.AsString(), "null") {
+					c.failClass(ht, "Format null", "Format(%q) with a null argument for %%v = %s, %v; want \"null\"", format, got.GoString(), err)
+				}
+			} else if err == nil {
+				c.failClass(ht, "Format null", "Format(%q) with a null argument = %s, want an error", format, got.GoString())
+			}
+			unk := append([]cty.Value(nil), args...)
+			unk[0] = cty.UnknownVal(args[0].Type())
+			if got, err := stdlib.Format(cty.StringVal(format), unk...); err != nil || got.IsKnown() {
+				c.failClass(ht, "Format unknown", "Format(%q) with an unknown argument = %s, %v; want an unknown string", format, got.GoString(), err)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- regex
+
+type regexPattern struct {
+	pat   string
+	named bool // has named groups
+	n     int  // number of groups
+}
+
+var regexPatterns = []regexPattern{
+	{`a`, false, 0},
+	{`[0-9]+`, false, 0},
+	{`([0-9]+)`, false, 1},
+	{`(a)(b)?`, false, 2},
+	{`(?P<x>[a-z]+)`, true, 1},
+	{`(?P<k>[a-z]+)=(?P<v>[0-9]*)`, true, 2},
+	{`(?P<a>a)(?P<b>b)?c`, true, 2},
+	{`h(el)+o`, false, 1},
+	{`^$`, false, 0},
+	{`.`, false, 0},
+}
+
+var regexSubjects = []string{"", "a", "abc", "ab", "123", "x=12,y=3", "hello", "aac", "héllo 42", "k=", "helelo"}
+
+// regexCase: a pattern, a subject and a replacement.
+type regexCase struct {
+	p   regexPattern
+	s   string
+	rep string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c regexCase) GoString() string {
+	return fmt.Sprintf("pattern %q subject %q replacement %q", c.p.pat, c.s, c.rep)
+}
+
+var regexCases = hegel.Composite(func(tc hegel.TestCase) regexCase {
+	return regexCase{
+		p:   hegel.Draw(tc, hegel.SampledFrom(regexPatterns)),
+		s:   hegel.Draw(tc, hegel.SampledFrom(regexSubjects)),
+		rep: hegel.Draw(tc, hegel.SampledFrom([]string{"", "_", "[$0]", "$1", "${x}"})),
+	}
+})
+
+// TestHegelRegex: Regex, RegexAll and RegexReplace against Go's regexp with the documented
+// result shapes.
+func TestHegelRegex(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, regexCases)
+		p, s := rc.p, rc.s
+		re := regexp.MustCompile(p.pat)
+
+		// the model of one match from its submatch indexes
+		model := func(idx []int) cty.Value {
+			switch {
+			case p.n == 0:
+				return cty.StringVal(s[idx[0]:idx[1]])
+			case p.named:
+				attrs := map[string]cty.Value{}
+				for gi, name := range re.SubexpNames() {
+					if gi == 0 {
+						continue
+					}
+					if idx[2*gi] < 0 {
+						attrs[name] = cty.NullVal(cty.String)
+					} else {
+						attrs[name] = cty.StringVal(s[idx[2*gi]:idx[2*gi+1]])
+					}
+				}
+				return cty.ObjectVal(attrs)
+			default:
+				var elems []cty.Value
+				for gi := 1; gi <= p.n; gi++ {
+					if idx[2*gi] < 0 {
+						elems = append(elems, cty.NullVal(cty.String))
+					} else {
+						elems = append(elems, cty.StringVal(s[idx[2*gi]:idx[2*gi+1]]))
+					}
+				}
+				return cty.TupleVal(elems)
+			}
+		}
+
+		first := re.FindStringSubmatchIndex(s)
+		got, err := stdlib.Regex(cty.StringVal(p.pat), cty.StringVal(s))
+		switch {
+		case first == nil:
+			if err == nil {
+				c.failClass(ht, "Regex", "Regex(%q, %q) = %s, want an error (no match)", p.pat, s, got.GoString())
+			}
+		case err != nil:
+			c.failClass(ht, "Regex", "Regex(%q, %q): %v", p.pat, s, err)
+		default:
+			if want := model(first); !got.RawEquals(want) {
+				c.failClass(ht, "Regex", "Regex(%q, %q) = %s, want %s", p.pat, s, got.GoString(), want.GoString())
+			}
+		}
+
+		all := re.FindAllStringSubmatchIndex(s, -1)
+		gotAll, err := stdlib.RegexAll(cty.StringVal(p.pat), cty.StringVal(s))
+		if err != nil {
+			c.failClass(ht, "RegexAll", "RegexAll(%q, %q): %v", p.pat, s, err)
+		} else if !gotAll.Type().IsListType() {
+			c.failClass(ht, "RegexAll", "RegexAll(%q, %q) = %s, want a list", p.pat, s, gotAll.GoString())
+		} else {
+			var want []cty.Value
+			for _, idx := range all {
+				want = append(want, model(idx))
+			}
+			if !sameElems(elemsOf(gotAll), want) {
+				c.failClass(ht, "RegexAll", "RegexAll(%q, %q) = %s, want %v", p.pat, s, gotAll.GoString(), want)
+			}
+		}
+
+		// RegexReplace against Go's ReplaceAllString (a replacement naming a group the
+		// pattern lacks is "_")
+		rep := rc.rep
+		if strings.Contains(rep, "$1") && p.n == 0 {
+			rep = "_"
+		}
+		if strings.Contains(rep, "${x}") && !(p.named && re.SubexpIndex("x") >= 0) {
+			rep = "_"
+		}
+		gotR, err := stdlib.RegexReplace(cty.StringVal(s), cty.StringVal(p.pat), cty.StringVal(rep))
+		if err != nil {
+			c.failClass(ht, "RegexReplace", "RegexReplace(%q, %q, %q): %v", s, p.pat, rep, err)
+		} else if want := re.ReplaceAllString(s, rep); gotR.AsString() != want {
+			c.failClass(ht, "RegexReplace", "RegexReplace(%q, %q, %q) = %q, want %q", s, p.pat, rep, gotR.AsString(), want)
+		}
+
+		// an invalid pattern fails
+		if got, err := stdlib.Regex(cty.StringVal("("), cty.StringVal(s)); err == nil {
+			c.failClass(ht, "Regex", "Regex(\"(\", %q) = %s, want an error", s, got.GoString())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- JSON, CSV
+
+// jsonCase: a value of a type without placeholders and the text appended to its encoding.
+type jsonCase struct {
+	ty       cty.Type
+	v        cty.Value
+	trailing string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c jsonCase) GoString() string {
+	return fmt.Sprintf("%s as %s, trailing %q", c.v.GoString(), tyString(c.ty), c.trailing)
+}
+
+var (
+	// trailers: the text after a JSON document that makes it invalid: a stray bracket (the
+	// shape of go-cty/7), or text; under HEGEL_NO_KNOWN=1 text only, since a trailing bracket
+	// is not noticed.
+	trailers    = shaped(hegel.SampledFrom([]string{"]", "}", " x", " 1", "]]"}), hegel.SampledFrom([]string{" x", " 1"}))
+	jsonFnCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+		ty := hegel.Draw(tc, plainTypes)
+		return jsonCase{ty: ty, v: hegel.Draw(tc, valuesOf(ty, valueOpts{nullPct: 10})), trailing: hegel.Draw(tc, trailers)}
+	})
+)
+
+// bareBrackets reports a trailer of closing brackets only, the shape of go-cty/7.
+func bareBrackets(trailing string) bool { return strings.Trim(trailing, "]}") == "" }
+
+// TestHegelJSONFunctions: JSONEncode writes JSON that JSONDecode reads back to a value
+// converting to the original; an unknown encodes to an unknown; a document with data after
+// the value is rejected (a stray "]" or "}" is accepted: go-cty/7).
+func TestHegelJSONFunctions(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		jc := hegel.Draw(ht, jsonFnCases)
+		ty, v := jc.ty, jc.v
+		enc, err := stdlib.JSONEncode(v)
+		if err != nil {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s): %v", v.GoString(), err)
+			return
+		}
+		if enc.Type() != cty.String || !enc.IsKnown() {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s) = %s", v.GoString(), enc.GoString())
+			return
+		}
+		if !json.Valid([]byte(enc.AsString())) {
+			c.failClass(ht, "JSONEncode", "JSONEncode(%s) = %q is not JSON", v.GoString(), enc.AsString())
+			return
+		}
+		dec, err := stdlib.JSONDecode(enc)
+		if err != nil {
+			c.failClass(ht, "JSONDecode", "JSONDecode(%q): %v", enc.AsString(), err)
+			return
+		}
+		if !hasSet(ty) {
+			// sets come back as tuples; their order is not part of the value
+			back, err := convert.Convert(dec, ty)
+			if err != nil {
+				c.failClass(ht, "convert back", "JSONDecode(%q) = %s does not convert to %s: %v", enc.AsString(), dec.GoString(), tyString(ty), err)
+				return
+			}
+			if !back.RawEquals(v) {
+				c.failClass(ht, "round trip", "JSONEncode/JSONDecode of %s (%s) gives %s (JSON %s)", v.GoString(), tyString(ty), back.GoString(), enc.AsString())
+				return
+			}
+		}
+		// an unknown encodes to an unknown string, invalid JSON fails to decode
+		if u, err := stdlib.JSONEncode(cty.UnknownVal(ty)); err != nil || u.IsKnown() {
+			c.failClass(ht, "unknown", "JSONEncode(unknown %s) = %s, %v", tyString(ty), u.GoString(), err)
+		}
+		checkTrailing(c, ht, shapeIf(bareBrackets(jc.trailing), "go-cty/7"), enc.AsString(), jc.trailing)
+	})
+}
+
+// checkTrailing checks that JSONDecode rejects the document with the trailing text.
+func checkTrailing(c *collector, ht *hegel.T, shape, doc, trailing string) {
+	if got, err := stdlib.JSONDecode(cty.StringVal(doc + trailing)); err == nil {
+		c.mismatch(ht, "invalid", shape, "JSONDecode(%q) = %s, want an error", doc+trailing, got.GoString())
+	}
+}
+
+var (
+	csvCells   = []string{"", "a", "hello world", "1", "with,comma", `with "quote"`, "multi\nline", " padded ", "日本語", "-0"}
+	csvHeaders = []string{"a", "b", "name", "id", "x y", "Z", "with,comma", `q"uote`}
+)
+
+// csvCase: distinct header names, rows of cells, and the line ending.
+type csvCase struct {
+	header []string
+	rows   [][]string
+	crlf   bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c csvCase) GoString() string {
+	return fmt.Sprintf("header %q rows %q crlf %v", c.header, c.rows, c.crlf)
+}
+
+// records is the table written: the header, then the rows, an empty cell of a one-column
+// table written as "x" (an empty line is not a record).
+func (c csvCase) records() [][]string {
+	records := [][]string{c.header}
+	for _, row := range c.rows {
+		row = append([]string(nil), row...)
+		for j := range row {
+			if len(c.header) == 1 && row[j] == "" {
+				row[j] = "x"
+			}
+		}
+		records = append(records, row)
+	}
+	return records
+}
+
+// text is the table as encoding/csv writes it.
+func (c csvCase) text() string {
+	var buf bytes.Buffer
+	w := csv.NewWriter(&buf)
+	w.UseCRLF = c.crlf
+	if err := w.WriteAll(c.records()); err != nil {
+		panic(err)
+	}
+	return buf.String()
+}
+
+// distinctStrings keeps the first of equal strings, in order.
+func distinctStrings(xs []string) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+var (
+	headers  = hegel.Map(many(hegel.SampledFrom(csvHeaders), 1, 4), distinctStrings)
+	csvCases = hegel.FlatMap(headers, func(header []string) hegel.Generator[csvCase] {
+		cols := len(header)
+		return hegel.Composite(func(tc hegel.TestCase) csvCase {
+			return csvCase{header: header, rows: hegel.Draw(tc, many(many(hegel.SampledFrom(csvCells), cols, cols), 0, 4)), crlf: hegel.Draw(tc, chance(30))}
+		})
+	})
+)
+
+// TestHegelCSVDecode: CSVDecode reads a table encoding/csv wrote into a list of objects keyed
+// by the header; a ragged table fails.
+func TestHegelCSVDecode(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, csvCases)
+		header, records := cc.header, cc.records()
+		cols, rows := len(header), len(cc.rows)
+		text := cc.text()
+		got, err := stdlib.CSVDecode(cty.StringVal(text))
+		if err != nil {
+			c.failClass(ht, "CSVDecode", "CSVDecode(%q): %v", text, err)
+			return
+		}
+		attrs := map[string]cty.Type{}
+		for _, h := range header {
+			attrs[h] = cty.String
+		}
+		wantTy := cty.List(cty.Object(attrs))
+		if !got.Type().Equals(wantTy) {
+			c.failClass(ht, "CSVDecode type", "CSVDecode(%q) has type %s, want %s", text, tyString(got.Type()), tyString(wantTy))
+			return
+		}
+		var want cty.Value
+		if rows == 0 {
+			want = cty.ListValEmpty(cty.Object(attrs))
+		} else {
+			var elems []cty.Value
+			for _, row := range records[1:] {
+				m := map[string]cty.Value{}
+				for j, h := range header {
+					m[h] = cty.StringVal(row[j])
+				}
+				elems = append(elems, cty.ObjectVal(m))
+			}
+			want = cty.ListVal(elems)
+		}
+		if !got.RawEquals(want) {
+			c.failClass(ht, "CSVDecode", "CSVDecode(%q) = %s, want %s", text, got.GoString(), want.GoString())
+		}
+		// a ragged table fails
+		if rows > 0 && cols > 1 {
+			ragged := text + "x\n"
+			if got, err := stdlib.CSVDecode(cty.StringVal(ragged)); err == nil {
+				c.failClass(ht, "CSVDecode ragged", "CSVDecode(%q) = %s, want an error", ragged, got.GoString())
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- dates
+
+type dateToken struct{ tok, layout string }
+
+var dateTokens = []dateToken{
+	{"YY", "06"}, {"YYYY", "2006"}, {"M", "1"}, {"MM", "01"}, {"MMM", "Jan"}, {"MMMM", "January"},
+	{"D", "2"}, {"DD", "02"}, {"EEE", "Mon"}, {"EEEE", "Monday"},
+	{"h", "H24"}, {"hh", "15"}, {"H", "3"}, {"HH", "03"}, {"AA", "PM"}, {"aa", "pm"},
+	{"m", "4"}, {"mm", "04"}, {"s", "5"}, {"ss", "05"},
+	{"ZZZZ", "-0700"}, {"ZZZZZ", "-07:00"}, {"Z", "Z07:00"}, {"ZZZ", "UTC"},
+}
+
+// timeSpec is an instant and a zone offset (seconds east of UTC; 0 is UTC).
+type timeSpec struct {
+	secs int64
+	off  int
+}
+
+func (t timeSpec) time() time.Time {
+	loc := time.UTC
+	if t.off != 0 {
+		loc = time.FixedZone("", t.off)
+	}
+	return time.Unix(t.secs, 0).In(loc)
+}
+
+// dateCase: a time, the tokens of a format with the separator after each (the last one's
+// written three times in ten), and a duration for TimeAdd.
+type dateCase struct {
+	t       timeSpec
+	toks    []dateToken
+	seps    []string
+	lastSep bool
+	dur     string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dateCase) GoString() string {
+	return fmt.Sprintf("time %s format %q dur %q", c.t.time().Format(time.RFC3339), c.format(), c.dur)
+}
+
+// format is the format string.
+func (c dateCase) format() string {
+	var b strings.Builder
+	for i, tk := range c.toks {
+		b.WriteString(tk.tok)
+		if i < len(c.toks)-1 || c.lastSep {
+			b.WriteString(c.seps[i])
+		}
+	}
+	return b.String()
+}
+
+// want is the formatted time: each token by its Go layout (the 24-hour "h" and the "ZZZ" zone
+// name by hand), each separator with its quotes removed (two apostrophes are one).
+func (c dateCase) want() string {
+	tm := c.t.time()
+	var b strings.Builder
+	for i, tk := range c.toks {
+		switch tk.layout {
+		case "H24":
+			b.WriteString(itoa(tm.Hour()))
+		case "UTC":
+			s := tm.Format("-0700")
+			if s == "+0000" {
+				s = "UTC"
+			}
+			b.WriteString(s)
+		default:
+			b.WriteString(tm.Format(tk.layout))
+		}
+		if i < len(c.toks)-1 || c.lastSep {
+			sep := c.seps[i]
+			if strings.HasPrefix(sep, "'") {
+				sep = strings.Trim(sep, "'")
+				if sep == "" {
+					sep = "'"
+				}
+			}
+			b.WriteString(sep)
+		}
+	}
+	return b.String()
+}
+
+var (
+	// zoneOffsets: UTC half the time, else whole hours within fourteen and a half or three
+	// quarters now and then.
+	zoneOffsets = maybe(50, hegel.Composite(func(tc hegel.TestCase) int {
+		return hegel.Draw(tc, hegel.Integers(-14, 14))*3600 + hegel.Draw(tc, hegel.SampledFrom([]int{0, 0, 30 * 60, 45 * 60}))
+	}))
+	timeSpecs = hegel.Composite(func(tc hegel.TestCase) timeSpec {
+		return timeSpec{secs: hegel.Draw(tc, hegel.Integers[int64](-1500000000, 2500000000)), off: hegel.Draw(tc, zoneOffsets)}
+	})
+	dateSeps  = hegel.SampledFrom([]string{"-", ":", " ", "/", ".", "'at'", "'T'", "''", "_", ","})
+	durations = hegel.SampledFrom([]string{"1h", "-2h5m", "1.5h", "30s", "1000ms", "0s", "24h", "-1h30m10s", "1h1m1s"})
+	dateCases = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		toks := hegel.Draw(tc, many(hegel.SampledFrom(dateTokens), 1, 5))
+		return dateCase{
+			t:       hegel.Draw(tc, timeSpecs),
+			toks:    toks,
+			seps:    hegel.Draw(tc, many(dateSeps, len(toks), len(toks))),
+			lastSep: hegel.Draw(tc, chance(30)),
+			dur:     hegel.Draw(tc, durations),
+		}
+	})
+)
+
+// TestHegelFormatDate: FormatDate against Go's time layouts and TimeAdd against
+// time.Duration; an invalid timestamp and an invalid duration fail.
+func TestHegelFormatDate(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		dc := hegel.Draw(ht, dateCases)
+		tm := dc.t.time()
+		ts := tm.Format(time.RFC3339)
+		format, want := dc.format(), dc.want()
+		got, err := stdlib.FormatDate(cty.StringVal(format), cty.StringVal(ts))
+		if err != nil {
+			c.failClass(ht, "FormatDate", "FormatDate(%q, %q): %v", format, ts, err)
+		} else if got.AsString() != want {
+			c.failClass(ht, "FormatDate", "FormatDate(%q, %q) = %q, want %q", format, ts, got.AsString(), want)
+		}
+		// an invalid timestamp fails
+		if got, err := stdlib.FormatDate(cty.StringVal(format), cty.StringVal("2020-13-01T00:00:00Z")); err == nil {
+			c.failClass(ht, "FormatDate invalid", "FormatDate(%q, month 13) = %s, want an error", format, got.GoString())
+		}
+
+		// TimeAdd against Go
+		dur := dc.dur
+		got, err = stdlib.TimeAdd(cty.StringVal(ts), cty.StringVal(dur))
+		d, _ := time.ParseDuration(dur)
+		if err != nil {
+			c.failClass(ht, "TimeAdd", "TimeAdd(%q, %q): %v", ts, dur, err)
+		} else if wantT := tm.Add(d); got.AsString() != wantT.Format(time.RFC3339) {
+			c.failClass(ht, "TimeAdd", "TimeAdd(%q, %q) = %q, want %q", ts, dur, got.AsString(), wantT.Format(time.RFC3339))
+		}
+		if got, err := stdlib.TimeAdd(cty.StringVal(ts), cty.StringVal("1 hour")); err == nil {
+			c.failClass(ht, "TimeAdd invalid", "TimeAdd(%q, \"1 hour\") = %s, want an error", ts, got.GoString())
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..416048d
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,274 @@
+package hegel
+
+// Hegel property tests for go-cty, written for the Hegel zoo. See targets/go/go-cty/README.md.
+//
+// Oracle: the documentation in docs/ (types.md, convert.md, json.md, functions.md) and the
+// doc comments of the stdlib functions, evaluated over generated types and values: the
+// conversion rules, the JSON and msgpack serializations (a value marshalled with its type
+// unmarshals to an equal value, the implied type reads it back), value operations and stdlib
+// functions against models written from their documentation.
+//
+// Generators are values built from the binding's combinators (hegel_gen_test.go for the types
+// and values, each stdlib property's case record beside the property): a property draws one
+// record and judges it, and pure functions render the record into the arguments the library
+// and the model see. The shapes of the recorded bugs (bugs.toml) are drawn at their natural
+// rate, so the properties that meet them fail, naming the shape, and are the expected failures
+// mapped to the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over
+// its shape region alone, and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1
+// switches the known shapes off (noKnown, below): the models then reproduce the recorded
+// behaviour and the codec generators leave the one shape the models cannot state out.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is failClass on a case that has the shape of a recorded bug (shape names it, or is
+// "" for a plain failure): the message names the shape, so that the shrunk failure of a wide
+// property can be read off against bugs.toml.
+func (c *collector) mismatch(ht *hegel.T, class, shape string, format string, args ...any) {
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch of Known is off: the models state the documented behaviour, the generators draw
+// the shapes of the bugs and the properties that meet them fail, naming the shape (mismatch).
+// Under HEGEL_NO_KNOWN=1 the switches are on: the models reproduce the recorded behaviour
+// instead, and the codec generators give the collections of go-cty/1 known, non-empty elements.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on, which is so only under HEGEL_NO_KNOWN=1; the pins assert the documented behaviour and
+// fail while the bug exists, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	// a null, unknown or empty-collection element under a collection type whose element type
+	// holds a DynamicPseudoType (List(List(DynamicPseudoType)), Map(Map(DynamicPseudoType)))
+	// comes back from JSON and msgpack with the declared element type rather than its own, and
+	// when a known element sits beside it the unmarshal panics ("inconsistent list element types")
+	dynamicElemNullLosesType bool
+	// Title's description says one letter after each non-letter, non-digit character is
+	// upper-cased; the function (strings.Title) leaves the letter after an underscore alone
+	titleUnderscore bool
+	// the descriptions of LessThan, LessThanOrEqualTo, GreaterThan and GreaterThanOrEqualTo
+	// name the operands the wrong way round ("true if and only if the second number is greater
+	// than the first" for GreaterThan)
+	comparisonDescriptionsReversed bool
+	// Substr with a negative offset and length 0 returns the rest of the string from the offset
+	// instead of the empty string (the length-0 short circuit sits in the else branch of the
+	// negative-offset adjustment)
+	substrNegativeOffsetZeroLength bool
+	// Range's "step must not be zero" check compares the step Value with == against cty.Zero, so
+	// a zero from the caller passes it: Range(n, n, 0) is the empty list and Range(a, b, 0) fails
+	// with "more than 1024 values were generated"
+	rangeZeroStepCheck bool
+	// Format's %s ignores a precision of 0 ("%.0s" gives the whole string; the documentation:
+	// precision limits the length of the input)
+	formatZeroPrecision bool
+	// JSONDecode (json.ImpliedType) notices trailing data after the value only when json.Decoder.
+	// More reports it, which it does not for a "]" or "}"; the typed json.Unmarshal never checks
+	jsonDecodeTrailingBrackets bool
+	// Modulo by zero returns the dividend; Value.Modulo documents an infinity of the
+	// dividend's sign (and Divide by zero does give the infinity)
+	moduloByZeroIsDividend bool
+}{
+	dynamicElemNullLosesType:       noKnown,
+	titleUnderscore:                noKnown,
+	comparisonDescriptionsReversed: noKnown,
+	substrNegativeOffsetZeroLength: noKnown,
+	rangeZeroStepCheck:             noKnown,
+	formatZeroPrecision:            noKnown,
+	jsonDecodeTrailingBrackets:     noKnown,
+	moduloByZeroIsDividend:         noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape ("" otherwise), for mismatch.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) string { return shapeIf(!noKnown, id) }
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// cat is the concatenation of two strings (the binding has no tuple combinator).
+func cat(a, b hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string { return hegel.Draw(tc, a) + hegel.Draw(tc, b) })
+}
+
+// ints is an integer as an int64 (for cty.NumberIntVal).
+func ints(lo, hi int) hegel.Generator[int64] {
+	return hegel.Map(hegel.Integers(lo, hi), func(i int) int64 { return int64(i) })
+}
