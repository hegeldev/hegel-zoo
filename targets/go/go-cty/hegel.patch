+// --------------------------------------------------------------------------- conversions
+
+// convCase: a value of a type without placeholders and a related type to convert it to.
+type convCase struct {
+	ty   cty.Type
+	v    cty.Value
+	want cty.Type
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c convCase) GoString() string {
+	return fmt.Sprintf("%s as %s -> %s", c.v.GoString(), tyString(c.ty), tyString(c.want))
+}
+
+var convCases = hegel.Composite(func(tc hegel.TestCase) convCase {
+	ty := hegel.Draw(tc, plainTypes)
+	return convCase{ty: ty, v: hegel.Draw(tc, valuesOf(ty, valueOpts{nullPct: 8})), want: hegel.Draw(tc, relatedTypesOf(ty))}
+})
