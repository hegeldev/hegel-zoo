+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/14
+
+// looseRawMessages: a RawMessage with whitespace, a raw <, > or & or a container (which the
+// indented output must re-indent): rawMessages, with a leading space when the drawn one has
+// none of the three; under HEGEL_NO_KNOWN=1 rawMessages as they are (compact and escaped).
+var looseRawMessages = shaped(
+	hegel.Map(rawMessages, func(r std.RawMessage) std.RawMessage {
+		s := shapesOf(r)
