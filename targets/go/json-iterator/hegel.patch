diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..340f02c
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,419 @@
+package jsoniter_test
+
+// The pins: one plain test per recorded bug (bugs.toml), kept byte for byte from the first
+// version of this harness. Each records one difference from encoding/json; target.toml lists
+// them as expected failures until fixed upstream.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"io"
+	"strings"
+	"testing"
+)
+
+// ---------------------------------------------------------------------------
+// Pins.  Each records one difference from encoding/json found while writing
+// the properties above; they are listed in targets/go/json-iterator/bugs.toml
+// and expected to fail until fixed upstream.  The pins recover from panics so
+// that one crash cannot hide the others.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// hgLoose is a Marshaler whose output has whitespace around it.
+type hgLoose struct{}
+
+func (hgLoose) MarshalJSON() ([]byte, error) { return []byte(" { \"v\" : 3 } "), nil }
+
+// hgStringOpt exercises the `,string` option and json.Number on decoding.
+type hgStringOpt struct {
+	S  string     `json:"s"`
+	SS string     `json:"ss,string"`
+	IS int        `json:"is,string"`
+	N  std.Number `json:"n"`
+}
+
+func TestHegelPinIndentMayBeAnyString(t *testing.T) {
+	defer guard(t)
+	for _, indent := range []string{"\t", "xx"} {
+		g, err := json.MarshalIndent([]int{1}, "", indent)
+		w, _ := std.MarshalIndent([]int{1}, "", indent)
+		if err != nil || string(g) != string(w) {
+			t.Fatalf("MarshalIndent(indent=%q): %q (%v), encoding/json %q", indent, g, err, w)
+		}
+	}
+}
+
+func TestHegelPinEncoderSetIndentKeepsTheIndentString(t *testing.T) {
+	defer guard(t)
+	var gb, wb bytes.Buffer
+	ge, we := json.NewEncoder(&gb), std.NewEncoder(&wb)
+	ge.SetIndent("", "\t")
+	we.SetIndent("", "\t")
+	_ = ge.Encode([]int{1})
+	_ = we.Encode([]int{1})
+	if gb.String() != wb.String() {
+		t.Fatalf("Encoder with a tab indent: %q, encoding/json %q", gb.String(), wb.String())
+	}
+}
+
+func TestHegelPinEmptyMapIndentsAsBraces(t *testing.T) {
+	defer guard(t)
+	g, err := json.MarshalIndent(map[string]int{}, "", " ")
+	w, _ := std.MarshalIndent(map[string]int{}, "", " ")
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("MarshalIndent(empty map): %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinEmptyIndentStillBreaksLines(t *testing.T) {
+	defer guard(t)
+	v := map[string]any{"a": []int{}}
+	g, err := json.MarshalIndent(v, "", "")
+	w, _ := std.MarshalIndent(v, "", "")
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("MarshalIndent(indent=\"\"): %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinMapValuesIndentNested(t *testing.T) {
+	defer guard(t)
+	for _, v := range []any{map[string][]int{"k": {1}}, map[string]any{"k": map[string]int{"a": 1}}} {
+		g, err := json.MarshalIndent(v, "", " ")
+		w, _ := std.MarshalIndent(v, "", " ")
+		if err != nil || string(g) != string(w) {
+			t.Fatalf("MarshalIndent(%T): %q (%v), encoding/json %q", v, g, err, w)
+		}
+	}
+}
+
+func TestHegelPinValidRejectsTrailingBytes(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"1 2", "[1]]", "truex", "{} }", "null x"} {
+		if json.Valid([]byte(text)) || std.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) = %v, encoding/json %v", text, json.Valid([]byte(text)), std.Valid([]byte(text)))
+		}
+	}
+}
+
+func TestHegelPinValidAcceptsTopLevelNumbers(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"-1", "1.5", "1e5", " 1E+2"} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err != nil {
+			t.Fatalf("Unmarshal(%q): %v", text, err)
+		}
+		if !json.Valid([]byte(text)) || !std.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) = %v, encoding/json %v", text, json.Valid([]byte(text)), std.Valid([]byte(text)))
+		}
+	}
+}
+
+func TestHegelPinValidAcceptsSmallMantissaLargeExponent(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"[0.25e40]", "[0.1e60]", "{\"a\":0.5E+39}"} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err != nil {
+			t.Fatalf("Unmarshal(%q): %v", text, err)
+		}
+		if !json.Valid([]byte(text)) || !std.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) = %v, encoding/json %v", text, json.Valid([]byte(text)), std.Valid([]byte(text)))
+		}
+	}
+}
+
+func TestHegelPinValidAcceptsNumbersOutOfFloat64Range(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"[1e400]", "[-2e308]"} {
+		if !json.Valid([]byte(text)) || !std.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) = %v, encoding/json %v", text, json.Valid([]byte(text)), std.Valid([]byte(text)))
+		}
+	}
+}
+
+func TestHegelPinValidRejectsNegativeLeadingZeros(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"[-00]", "[-01]", "[-.5]", "{\"a\":-00.5}"} {
+		var v any
+		if err := json.Unmarshal([]byte(text), &v); err == nil {
+			t.Fatalf("Unmarshal(%q) accepted", text)
+		}
+		if json.Valid([]byte(text)) || std.Valid([]byte(text)) {
+			t.Fatalf("Valid(%q) = %v, encoding/json %v", text, json.Valid([]byte(text)), std.Valid([]byte(text)))
+		}
+	}
+}
+
+func TestHegelPinRawControlCharactersAfterAnEscapeAreRejected(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"\"a\\nb\tc\"", "[\"\\u0041\x01\"]", "\"\\\"\x00\""} {
+		var v any
+		err := json.Unmarshal([]byte(text), &v)
+		if std.Valid([]byte(text)) {
+			t.Fatalf("encoding/json accepts %q", text)
+		}
+		if json.Valid([]byte(text)) || err == nil {
+			t.Fatalf("%q: Valid %v, Unmarshal error %v (a raw control character in a string)", text, json.Valid([]byte(text)), err)
+		}
+	}
+}
+
+func TestHegelPinDecoderReturnsEOFAtTheEnd(t *testing.T) {
+	defer guard(t)
+	for _, stream := range []string{"1\n", "1", "[1]\n{}\n"} {
+		d := json.NewDecoder(strings.NewReader(stream))
+		var v any
+		var err error
+		for i := 0; i < 4 && err == nil; i++ {
+			err = d.Decode(&v)
+		}
+		if err != io.EOF {
+			t.Fatalf("Decode past the end of %q: %v, want io.EOF", stream, err)
+		}
+	}
+}
+
+func TestHegelPinDecoderRawMessageLeadingWhitespace(t *testing.T) {
+	defer guard(t)
+	for _, stream := range []string{" 12", "\n[1]", "  true"} {
+		var g, w std.RawMessage
+		if err := json.NewDecoder(strings.NewReader(stream)).Decode(&g); err != nil {
+			t.Fatalf("Decode(%q): %v", stream, err)
+		}
+		_ = std.NewDecoder(strings.NewReader(stream)).Decode(&w)
+		if string(g) != string(w) {
+			t.Fatalf("Decoder into RawMessage from %q: %q, encoding/json %q", stream, []byte(g), []byte(w))
+		}
+	}
+}
+
+func TestHegelPinInvalidRawMessageIsAnError(t *testing.T) {
+	defer guard(t)
+	for _, raw := range []string{"[1,", "1 2", "  "} {
+		v := struct{ R std.RawMessage }{std.RawMessage(raw)}
+		g, err := json.Marshal(v)
+		if _, werr := std.Marshal(v); werr == nil {
+			t.Fatalf("encoding/json accepts RawMessage %q", raw)
+		}
+		if err == nil {
+			t.Fatalf("Marshal(RawMessage %q) = %q with no error", raw, g)
+		}
+	}
+}
+
+func TestHegelPinInvalidNumberLiteralIsAnError(t *testing.T) {
+	defer guard(t)
+	for _, num := range []std.Number{"abc", "01", "-"} {
+		g, err := json.Marshal(num)
+		if _, werr := std.Marshal(num); werr == nil {
+			t.Fatalf("encoding/json accepts Number %q", num)
+		}
+		if err == nil {
+			t.Fatalf("Marshal(Number %q) = %q with no error", num, g)
+		}
+	}
+}
+
+func TestHegelPinMarshalerOutputIsCompacted(t *testing.T) {
+	defer guard(t)
+	v := struct {
+		R std.RawMessage
+		J hgLoose
+	}{R: std.RawMessage("\n [1,\t2] ")}
+	g, err := json.Marshal(v)
+	w, _ := std.Marshal(v)
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("Marshal: %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinInvalidUTF8IsWrittenAsRawReplacementCharacters(t *testing.T) {
+	defer guard(t)
+	g, err := json.Marshal("a\xffb")
+	w, _ := std.Marshal("a\xffb")
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("Marshal(\"a\\xffb\"): %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinBackspaceAndFormFeedUseShortEscapes(t *testing.T) {
+	defer guard(t)
+	g, err := json.Marshal("\b\f")
+	w, _ := std.Marshal("\b\f")
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("Marshal(\"\\b\\f\"): %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinBoolMapKeysAreUnsupported(t *testing.T) {
+	defer guard(t)
+	v := map[bool]int{true: 1}
+	if _, werr := std.Marshal(v); werr == nil {
+		t.Fatalf("encoding/json accepts map[bool]int")
+	}
+	if g, err := json.Marshal(v); err == nil {
+		t.Fatalf("Marshal(map[bool]int) = %q with no error", g)
+	}
+}
+
+func TestHegelPinStringOptionOnlyAppliesToScalars(t *testing.T) {
+	defer guard(t)
+	v := struct {
+		S []int `json:"s,string"`
+		P *int  `json:"p,string"`
+	}{S: []int{1}}
+	g, err := json.Marshal(v)
+	w, _ := std.Marshal(v)
+	if err != nil || string(g) != string(w) {
+		t.Fatalf("Marshal: %q (%v), encoding/json %q", g, err, w)
+	}
+}
+
+func TestHegelPinNulByteDoesNotTerminateTheInput(t *testing.T) {
+	defer guard(t)
+	text := "1\x00garbage"
+	var v any
+	err := json.Unmarshal([]byte(text), &v)
+	if json.Valid([]byte(text)) || err == nil {
+		t.Fatalf("%q: Valid %v, Unmarshal error %v (encoding/json rejects it)", text, json.Valid([]byte(text)), err)
+	}
+}
+
+func TestHegelPinInvalidUTF8InputIsReplaced(t *testing.T) {
+	defer guard(t)
+	var g, w string
+	if err := json.Unmarshal([]byte("\"a\xffb\""), &g); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	_ = std.Unmarshal([]byte("\"a\xffb\""), &w)
+	if g != w {
+		t.Fatalf("Unmarshal(\"a\\xffb\") = %q, encoding/json %q", g, w)
+	}
+}
+
+func TestHegelPinLoneSurrogateBeforeAPair(t *testing.T) {
+	defer guard(t)
+	text := `"\udc00\udbff\udfff"`
+	var g, w string
+	if err := json.Unmarshal([]byte(text), &g); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	_ = std.Unmarshal([]byte(text), &w)
+	if g != w {
+		t.Fatalf("Unmarshal(%s) = %q, encoding/json %q", text, g, w)
+	}
+}
+
+func TestHegelPinNullIntoStringKindsIsANoOp(t *testing.T) {
+	defer guard(t)
+	v := hgStringOpt{S: "s", SS: "q", N: "9"}
+	if err := json.Unmarshal([]byte(`{"s":null,"ss":null,"n":null}`), &v); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	if v.S != "s" || v.SS != "q" || v.N != "9" {
+		t.Fatalf("null cleared string-kinded fields: %+v (encoding/json leaves them unchanged)", v)
+	}
+}
+
+func TestHegelPinNullIntoTextUnmarshalerIsANoOp(t *testing.T) {
+	defer guard(t)
+	v := struct{ T hgText }{hgText{"x"}}
+	if err := json.Unmarshal([]byte(`{"T":null}`), &v); err != nil {
+		t.Fatalf("Unmarshal: %v (encoding/json does not call UnmarshalText for null)", err)
+	}
+	if v.T.V != "x" {
+		t.Fatalf("null changed the TextUnmarshaler value: %+v", v)
+	}
+}
+
+func TestHegelPinNullIntoRawMessageKeepsTheLiteral(t *testing.T) {
+	defer guard(t)
+	var g, w struct {
+		R std.RawMessage `json:"r,omitempty"`
+	}
+	if err := json.Unmarshal([]byte(`{"r":null}`), &g); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	_ = std.Unmarshal([]byte(`{"r":null}`), &w)
+	if string(g.R) != string(w.R) {
+		t.Fatalf("null into a RawMessage field: %q, encoding/json %q", []byte(g.R), []byte(w.R))
+	}
+}
+
+func TestHegelPinTypeErrorLeavesTheFieldUnchanged(t *testing.T) {
+	defer guard(t)
+	v := struct {
+		I int8
+		S string
+	}{I: 2, S: "s"}
+	if err := json.Unmarshal([]byte(`{"I":300,"S":5}`), &v); err == nil {
+		t.Fatalf("Unmarshal accepted 300 into int8 and a number into a string")
+	}
+	if v.I != 2 || v.S != "s" {
+		t.Fatalf("a type error zeroed the field: %+v (encoding/json leaves it unchanged)", v)
+	}
+}
+
+func TestHegelPinUnmarshalKeepsGoingAfterATypeError(t *testing.T) {
+	defer guard(t)
+	v := struct {
+		I int
+		S string
+	}{}
+	if err := json.Unmarshal([]byte(`{"I":true,"S":"after"}`), &v); err == nil {
+		t.Fatalf("Unmarshal accepted a bool into an int")
+	}
+	if v.S != "after" {
+		t.Fatalf("the field after the type error was not decoded: %+v (encoding/json decodes it)", v)
+	}
+}
+
+func TestHegelPinShortArrayZeroesTheRest(t *testing.T) {
+	defer guard(t)
+	a := [3]int16{1, 2, 3}
+	if err := json.Unmarshal([]byte("[9]"), &a); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	if a != [3]int16{9, 0, 0} {
+		t.Fatalf("[9] into [3]int16 = %v, encoding/json [9 0 0]", a)
+	}
+}
+
+func TestHegelPinStringOptionIsStrict(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{`{"is":" 5"}`, `{"ss":"5"}`} {
+		var g, w hgStringOpt
+		if werr := std.Unmarshal([]byte(text), &w); werr == nil {
+			t.Fatalf("encoding/json accepts %s", text)
+		}
+		if err := json.Unmarshal([]byte(text), &g); err == nil {
+			t.Fatalf("Unmarshal(%s) accepted: %+v", text, g)
+		}
+	}
+}
+
+func TestHegelPinInvalidNumberStringsAreRejected(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{`{"n":"abc"}`, `{"n":""}`, `{"n":"01"}`} {
+		var g hgStringOpt
+		if err := json.Unmarshal([]byte(text), &g); err == nil {
+			t.Fatalf("Unmarshal(%s) accepted, Number = %q (encoding/json rejects it)", text, g.N)
+		}
+	}
+}
+
+func TestHegelPinStringOptionAndIntegerKeysAreUnescaped(t *testing.T) {
+	defer guard(t)
+	var v hgStringOpt
+	if err := json.Unmarshal([]byte(`{"is":"7\u00344"}`), &v); err != nil || v.IS != 744 {
+		t.Fatalf("`,string` int from \"7\\u00344\": %d, %v (encoding/json 744)", v.IS, err)
+	}
+	var m map[int32]string
+	if err := json.Unmarshal([]byte(`{"\u00396":"x"}`), &m); err != nil || m[96] != "x" {
+		t.Fatalf("map[int32] key from \"\\u00396\": %v, %v (encoding/json {96: x})", m, err)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..0dff37d
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,505 @@
+package jsoniter_test
+
+// One property per recorded bug the wide properties reach (bugs.toml): a generator over the
+// bug's shape region with random contents, judged by the judge of the wide property that
+// found it, so that each bug has a property that finds it every run (the wide properties in
+// hegel_test.go reach the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws
+// the neighbouring region the bug does not touch instead (spaces for the indent, a map with
+// a member, scalar map values, a compact RawMessage, valid UTF-8, \n for \b, whitespace
+// after the value, the number inside an array, an exponent within range, a stream ending at
+// a closer, an escaped control character, ...) and passes.
+
+import (
+	std "encoding/json"
+	"fmt"
+	"strconv"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- plain values
+
+// hgPlain is a small struct without a shape of its own.
+type hgPlain struct {
+	A int    `json:"a"`
+	B string `json:"b,omitempty"`
+}
+
+// hgStr holds one string.
+type hgStr struct {
+	S string `json:"s"`
+}
+
+// hgMapped holds one string-keyed map.
+type hgMapped struct {
+	M map[string]int `json:"m"`
+	N int            `json:"n"`
+}
+
+// hgRaw holds one RawMessage.
+type hgRaw struct {
+	R std.RawMessage `json:"r"`
+	N int            `json:"n"`
+}
+
+var (
+	plainInners = hegel.Map(pairs(hegel.Integers(-9, 9), maybe(50, cleanStrs)), func(p pair[int, string]) hgPlain { return hgPlain{p.a, p.b} })
+	// plainValues: values whose output has none of the recorded shapes: a slice of integers, a
+	// slice of small structs, a pair of Marshalers.
+	plainValues = weighted(
+		choice[any]{1, asAny(hegel.Map(many(hegel.Integers(-5, 5), 0, 3), nonNil[int]))},
+		choice[any]{1, asAny(hegel.Map(many(plainInners, 0, 3), nonNil[hgPlain]))},
+		choice[any]{1, asAny(hegel.Map(pairs(smallMarshes, smallMarshes), func(p pair[hgMarsh, hgMarsh]) [2]hgMarsh { return [2]hgMarsh{p.a, p.b} }))},
+	)
+	spaceIndents = hegel.SampledFrom([]string{" ", "  ", "    "})
+	// oddIndents: an indent that is not made of spaces (json-iterator/1, /2); spaces under
+	// HEGEL_NO_KNOWN=1.
+	oddIndents = shaped(hegel.SampledFrom([]string{"\t", "xx", "\t ", "\n"}), spaceIndents)
+	// emptyIndents: the empty indent (json-iterator/4); one space under HEGEL_NO_KNOWN=1.
+	emptyIndents = shaped(hegel.Just(""), hegel.Just(" "))
+)
+
+// encoderCases draws a marshalCase over the values, the Encoder's second values, the two
+// indents and whether the Encoder indents.
+func encoderCases(values, seconds hegel.Generator[any], indent, indent2 hegel.Generator[string], indented hegel.Generator[bool]) hegel.Generator[marshalCase] {
+	return hegel.Composite(func(tc hegel.TestCase) marshalCase {
+		return marshalCase{
+			v:         hegel.Draw(tc, values),
+			indent:    hegel.Draw(tc, indent),
+			second:    hegel.Draw(tc, seconds),
+			escapeOff: hegel.Draw(tc, chance(50)),
+			indented:  hegel.Draw(tc, indented),
+			indent2:   hegel.Draw(tc, indent2),
+		}
+	})
+}
+
+// spliced is base with piece inserted at a drawn rune boundary.
+func spliced(base, piece hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		rs := []rune(hegel.Draw(tc, base))
+		at := hegel.Draw(tc, positions) % (len(rs) + 1)
+		return string(rs[:at]) + hegel.Draw(tc, piece) + string(rs[at:])
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/1
+
+// TestHegelMarshalIndentTakesAnyIndent: MarshalIndent accepts any indent string and writes
+// it, as encoding/json does; json-iterator panics on one that is not made of spaces
+// (json-iterator/1).
+func TestHegelMarshalIndentTakesAnyIndent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		encodesLike(ht, hegel.Draw(ht, encoderCases(plainValues, plainValues, oddIndents, spaceIndents, hegel.Just(false))))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/2
+
