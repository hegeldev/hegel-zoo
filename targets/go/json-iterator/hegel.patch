+package jsoniter_test
+
+// Hegel property tests for github.com/json-iterator/go.
+//
+// The oracle is the standard library's encoding/json, loaded here as `std`.
+// json-iterator's README promises "100% compatibility with the standard
+// library" through ConfigCompatibleWithStandardLibrary, which is the API under
+// test here (bound to `json` below, so that the calls read like the standard
+// ones): wherever the two disagree on a byte of output, a decoded value, or
+// whether an input is valid, one of them is wrong -- and the standard library
+// is the reference.  Every property draws one case record: Go values come from
+// a rich struct universe and interface{} trees, JSON texts from a tree rendered
+// by a pure writer whose whitespace, escape choices and key order come from a
+// drawn tape (an empty tape is the compact, plainly escaped, sorted text, so
+// that is what a case shrinks to).  The properties compare Marshal/
+// MarshalIndent/Encoder, Unmarshal into interface{} and into structs, Valid on
+// valid and mutated texts, and Decoder streams.  The shapes of the recorded
+// bugs (bugs.toml) are drawn at their natural rate, so the properties that
+// meet them fail, naming the shape, and are the expected failures mapped to
+// the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug
+// over its shape region alone, and hegel_pins_test.go the regression
+// examples.  HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below)
+// for a run that looks past the bugs.
+//
+// Set JSONITER_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	jsoniter "github.com/json-iterator/go"
+	"hegel.dev/go/hegel"
+)
+
+// json is the API under test.
+var json = jsoniter.ConfigCompatibleWithStandardLibrary
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on, the shapes are left out
+// of the generators (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of the recorded json-iterator bugs; on means the shape is left
+// out of the generators (or the one check only it can fail is skipped), which is so only under
+// HEGEL_NO_KNOWN=1.
+var Known = struct {
+	oddIndents    bool // json-iterator/1, /2, /4: MarshalIndent panics on a non-space indent and is compact on "", SetIndent turns the indent into spaces
+	emptyMaps     bool // json-iterator/3: MarshalIndent writes an empty map as "{\n \n}"
+	indentUnsafe  bool // json-iterator/5, /14: containers that are map values, and RawMessages, are not re-indented
+	validShapes   bool // json-iterator/6, /7, /31: Valid checks only the first value, rejects a top-level -1, 1.5, 1e5, accepts -00
+	bigNumbers    bool // json-iterator/8, /9: Valid rejects 0.-mantissa literals above float32 range and numbers out of float64 range
+	eofAtEnd      bool // json-iterator/10: Decode after the last value is a syntax error, not io.EOF, after trailing whitespace or a bare number
+	rawVerbatim   bool // json-iterator/14: a RawMessage is copied verbatim, neither compacted nor HTML-escaped
+	utf8Strings   bool // json-iterator/15, /20: invalid UTF-8 is written as \ufffd escapes and read through unchanged
+	shortEscapes  bool // json-iterator/16: U+0008 and U+000C are written as \u0008 and \u000c
+	lonePairs     bool // json-iterator/21: a surrogate pair escape right after a lone surrogate escape is corrupted
+	nullRaw       bool // json-iterator/24: null into a RawMessage stores nil
+	structEscapes bool // json-iterator/30: `,string` numbers and integer map keys are read without unescaping
+	tabInsertions bool // json-iterator/32: a raw control character after an escape in a string is accepted
+}{
+	oddIndents:    noKnown,
+	emptyMaps:     noKnown,
+	indentUnsafe:  noKnown,
+	validShapes:   noKnown,
+	bigNumbers:    noKnown,
+	eofAtEnd:      noKnown,
+	rawVerbatim:   noKnown,
+	utf8Strings:   noKnown,
+	shortEscapes:  noKnown,
+	lonePairs:     noKnown,
+	nullRaw:       noKnown,
+	structEscapes: noKnown,
+	tabInsertions: noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// bug is the id of the n-th recorded bug.
+func bug(n int) string { return fmt.Sprintf("json-iterator/%d", n) }
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// collected is the panic value fail() raises in collect mode; property()
+// swallows it so that the case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("JSONITER_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shapes are those of the
+// recorded bugs named (none for a plain disagreement): the failure names them, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 60 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// joined concatenates the drawn pieces.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements, and both libraries write a nil slice or map as null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure writer consumes in order, recycled
+// modulo its length, for the choices a JSON text leaves free (whitespace, an escape's
+// spelling, the order of an object's members). An empty tape answers 0 to every question,
+// so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// ---------------------------------------------------------------------------
+// The struct universe.
+
+// hgText is a TextMarshaler (value receiver) / TextUnmarshaler (pointer
+// receiver) pair; it is used both as a field and as a map key type below.
+type hgText struct{ V string }
+
+func (x hgText) MarshalText() ([]byte, error) { return []byte("t:" + x.V), nil }
+
+func (x *hgText) UnmarshalText(b []byte) error {
+	s := string(b)
+	if !strings.HasPrefix(s, "t:") {
+		return fmt.Errorf("hgText: bad text %q", s)
+	}
+	x.V = s[2:]
+	return nil
+}
+
+// hgKey is a TextMarshaler map key whose text sorts like its number.
+type hgKey struct{ K uint8 }
+
+func (k hgKey) MarshalText() ([]byte, error) { return []byte(fmt.Sprintf("k%03d", k.K)), nil }
+
+func (k *hgKey) UnmarshalText(b []byte) error {
+	v, err := strconv.Atoi(strings.TrimPrefix(string(b), "k"))
+	if err != nil || v < 0 || v > 255 {
+		return fmt.Errorf("hgKey: bad key %q", b)
+	}
+	k.K = uint8(v)
+	return nil
+}
+
+// hgMarsh is a value-receiver Marshaler with a pointer-receiver Unmarshaler.
+// Its output is a compact scalar (`"m:<v>"`): encoding/json compacts and
+// re-indents a Marshaler's output and json-iterator copies it verbatim
+// (json-iterator/14), a shape the RawMessage of hgRich draws in every form
+// (whitespace, HTML characters, a container under indentation), so a container
+// or whitespace here would only find that bug again.
+type hgMarsh struct{ V int32 }
+
+func (m hgMarsh) MarshalJSON() ([]byte, error) {
+	return []byte(fmt.Sprintf("\"m:%d\"", m.V)), nil
+}
+
+func (m *hgMarsh) UnmarshalJSON(b []byte) error {
+	var w string
+	if err := std.Unmarshal(b, &w); err != nil {
+		return err
+	}
+	v, err := strconv.ParseInt(strings.TrimPrefix(w, "m:"), 10, 32)
+	if err != nil || !strings.HasPrefix(w, "m:") {
+		return fmt.Errorf("hgMarsh: bad text %q", w)
+	}
+	m.V = int32(v)
+	return nil
+}
+
+type hgInner struct {
+	A int      `json:"a"`
+	B string   `json:"b,omitempty"`
+	C *float64 `json:"c,omitempty"`
+}
+
+// HgEmbedded is exported so that it can be embedded and decoded into.
+type HgEmbedded struct {
+	E1 uint16   `json:"e1"`
+	E2 []string `json:"e2,omitempty"`
+}
+
+// hgRich exercises most of the encoding/json struct vocabulary: embedding,
+// pointers, every integer width, both float widths, the `string` option on
+// integers and on a string, omitempty on scalars and containers, []byte, a
+// fixed array, slices of structs, maps with string / integer / TextMarshaler
+// keys, Number, RawMessage, Marshaler and TextMarshaler fields, interface{},
+// `-`, `-,` and an unexported field.  Its keys are pairwise distinct even
+// case-insensitively, so the struct property may vary their case.
+type hgRich struct {
+	HgEmbedded
+	P     *hgInner         `json:"p"`
+	I8    int8             `json:"i8"`
+	I16   int16            `json:"i16,omitempty"`
+	I32   int32            `json:"i32,string"`
+	I64   int64            `json:"i64"`
+	U8    uint8            `json:"u8"`
+	U32   uint32           `json:"u32,omitempty"`
+	U64   uint64           `json:"u64,string"`
+	F32   float32          `json:"f32"`
+	F64   float64          `json:"f64,omitempty"`
+	S     string           `json:"s"`
+	SS    string           `json:"ss,string"`
+	B     bool             `json:"b,omitempty"`
+	Bs    []byte           `json:"bs"`
+	Arr   [3]int16         `json:"arr"`
+	Sl    []hgInner        `json:"sl,omitempty"`
+	M     map[string]int   `json:"m,omitempty"`
+	MI    map[int32]string `json:"mi"`
+	MT    map[hgKey]bool   `json:"mt,omitempty"`
+	N     std.Number       `json:"n,omitempty"`
+	R     std.RawMessage   `json:"r,omitempty"`
+	T     hgText           `json:"t"`
+	TP    *hgText          `json:"tp,omitempty"`
+	J     hgMarsh          `json:"j"`
+	Any   any              `json:"any"`
+	Skip  int              `json:"-"`
+	Dash  int              `json:"-,"`
+	Lower int              `json:"lower"`
+	NoTag int
+	//lint:ignore U1000 deliberately unexported, must be ignored by both encoders
+	hidden int
+}
+
+// ---------------------------------------------------------------------------
+// Generators for Go values.
+
+// stringPieces cover ASCII punctuation, quotes and backslashes, control characters,
+// HTML-significant characters, U+2028/2029 and non-BMP runes (the non-ASCII ones spelled as
+// escapes: e acute, "nihon", a grinning face, U+2028, U+2029, U+FFFD, y diaeresis, U+10FFFF,
+// a no-break space, and U+FFFD right before a grinning face: the writer may spell the first
+// as a lone surrogate escape and the second as a surrogate pair, json-iterator/21).
+var stringPieces = []string{
+	"", "a", "Z", "0", "hello", "x y", " ", "\"", "\\", "/", "<", ">", "&", "'",
+	"\n", "\t", "\r", "\x00", "\x01", "\x1f", "\x7f",
+	"\U000000e9", "\U000065e5\U0000672c", "\U0001F600", "\U00002028", "\U00002029", "\U0000fffd", "\U000000ff", "\U0010ffff", "\U000000a0",
+	"\U0000fffd\U0001F600",
+	"{", "}", "[", "]", ",", ":", "null", "true", "1e5", "-0",
+}
+
+// keyAlphabet holds characters needing escapes, so that key sorting and key escaping are both
+// exercised (e acute, u diaeresis, "ni" and U+2028 among them).
+const keyAlphabet = "abcxyzABCXYZ0189-_.:/#$%'()*+,;=?@[]^{}|~\U000000e9\U000000fc\U000065e5 !\"\\<>&\n\U00002028"
+
+// blockRunes: a rune of the first Unicode blocks.
+var blockRunes = hegel.Map(hegel.Integers[rune](0x20, 0x2fff), func(r rune) string { return string(r) })
+
+// basePieces: a piece of a Go string: one of the pieces above seventeen times in twenty, else
+// a block rune.
+var basePieces = weighted(
+	choice[string]{85, hegel.SampledFrom(stringPieces)},
+	choice[string]{15, blockRunes},
+)
+
+// strPieces: basePieces and the pieces of the recorded encode-side bugs, each once in
+// twenty-seven or so: U+0008 and U+000C (json-iterator/16) and, with invalid, invalid UTF-8
+// (json-iterator/15 on the encode side, /20 inside a JSON text). Under HEGEL_NO_KNOWN=1
+// basePieces alone.
+func strPieces(invalid bool) hegel.Generator[string] {
+	cs := []choice[string]{{100, basePieces}}
+	if !Known.shortEscapes {
+		cs = append(cs, choice[string]{4, hegel.SampledFrom([]string{"\b", "\f", "a\bb\fc"})})
+	}
+	if invalid && !Known.utf8Strings {
+		cs = append(cs, choice[string]{4, hegel.SampledFrom([]string{"\xff", "a\xffb", "\xc3(", "\xed\xa0\x80"})})
+	}
+	return weighted(cs...)
+}
+
+var (
+	// strs: up to six pieces, a Go string of the whole universe.
+	strs = joined(many(strPieces(true), 0, 6))
+	// utf8Strs: the same without invalid UTF-8, for the values whose round trip is compared
+	// (a byte both encoders replace by U+FFFD cannot come back) and for the RawMessage trees.
+	utf8Strs = joined(many(strPieces(false), 0, 6))
+	// cleanStrs: basePieces alone, for the narrow properties that put one shape into a string.
+	cleanStrs = joined(many(basePieces, 0, 6))
+	// mapKeys: a map key (possibly empty) from keyAlphabet.
+	mapKeys = hegel.Text().Alphabet(keyAlphabet).MaxSize(5)
+	// controlTails: a few more control characters, three times in twenty, for JSON texts that
+	// are only decoded.
+	controlTails = maybe(15, hegel.SampledFrom([]string{"\b", "\f", "a\bb\fc", "\x0b"}))
+	textStrs     = hegel.Map(pairs(strs, controlTails), func(p pair[string, string]) string { return p.a + p.b })
+	rawStrs      = hegel.Map(pairs(utf8Strs, controlTails), func(p pair[string, string]) string { return p.a + p.b })
+	strLists     = many(strs, 0, 3)
+	// byteSlices: up to eight bytes, empty but not nil when there are none.
+	byteSlices = hegel.Map(hegel.Binary(0, 8), nonNil[byte])
+)
+
+var (
+	u32s = hegel.Integers[uint32](0, math.MaxUint32)
+	i32s = hegel.Integers[int32](math.MinInt32, math.MaxInt32)
+	// uint64s: within a thousand once in four, within 32 bits once, else of any width.
+	uint64s = weighted(
+		choice[uint64]{1, hegel.Integers[uint64](0, 1000)},
+		choice[uint64]{1, hegel.Integers[uint64](0, math.MaxUint32)},
+		choice[uint64]{2, hegel.Map(pairs(u32s, u32s), func(p pair[uint32, uint32]) uint64 { return uint64(p.a)<<32 | uint64(p.b) })},
+	)
+	// int64s: within a thousand once in four, at an edge of int64 or of the exact float64
+	// integers once, else the bits of a uint64.
+	int64s = weighted(
+		choice[int64]{1, hegel.Integers[int64](-1000, 1000)},
+		choice[int64]{1, hegel.SampledFrom([]int64{math.MinInt64, math.MaxInt64, -1 << 53, 1 << 53, 1<<53 + 1, -(1<<53 + 1)})},
+		choice[int64]{2, hegel.Map(uint64s, func(u uint64) int64 { return int64(u) })},
+	)
+)
+
+var floatEdges = []float64{0.1, 0.5, 1.0 / 3, 1e20, 1e21, 123456789012345680000, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-10, 1e-100, 2.5e-300}
+
+func isFinite(f float64) bool { return !math.IsNaN(f) && !math.IsInf(f, 0) }
+
+// floatBases: a finite float64 within the range of a float of `bits` bits, of eight kinds as
+// often as each other: zero, a negative zero, an integer within a million, a decimal of up to
+// six places, a tiny value (down to the width's smallest denormal), a huge value at or above
+// 1e21 (where encoding/json switches to exponent form), the float of random bits (NaN and the
+// infinities filtered out: encoding/json rejects them, one draw in two thousand), or an edge.
+func floatBases(bits int) hegel.Generator[float64] {
+	maxExp, tinyExp, edges := 300, 1074, floatEdges
+	bitFloats := hegel.Map(uint64s, math.Float64frombits)
+	if bits == 32 {
+		maxExp, tinyExp, edges = 32, 149, nil
+		for _, e := range floatEdges {
+			if e <= math.MaxFloat32 {
+				edges = append(edges, e)
+			}
+		}
+		bitFloats = hegel.Map(u32s, func(u uint32) float64 { return float64(math.Float32frombits(u)) })
+	}
+	return weighted(
+		choice[float64]{1, hegel.Just(0.0)},
+		choice[float64]{1, hegel.Just(math.Copysign(0, -1))},
+		choice[float64]{1, hegel.Map(hegel.Integers(-1000000, 1000000), func(x int) float64 { return float64(x) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(-1000000, 1000000), hegel.Integers(0, 6)), func(p pair[int, int]) float64 { return float64(p.a) / math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(0, 1<<20), hegel.Integers(1, tinyExp)), func(p pair[int, int]) float64 { return math.Ldexp(1+float64(p.a)/float64(1<<20), -p.b) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(1, 999999), hegel.Integers(21, maxExp)), func(p pair[int, int]) float64 { return float64(p.a) * math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Filter(bitFloats, isFinite)},
+		choice[float64]{1, hegel.SampledFrom(edges)},
+	)
+}
+
+// signed negates three times in ten.
+func signed(g hegel.Generator[float64]) hegel.Generator[float64] {
+	return hegel.Map(pairs(g, chance(30)), func(p pair[float64, bool]) float64 {
+		if p.b {
+			return -p.a
+		}
+		return p.a
+	})
+}
+
+var (
+	floats   = signed(floatBases(64))
+	float32s = hegel.Map(signed(floatBases(32)), func(f float64) float32 { return float32(f) })
+	inners   = hegel.Composite(func(tc hegel.TestCase) hgInner {
+		return hgInner{A: hegel.Draw(tc, hegel.Integers(-100000, 100000)), B: hegel.Draw(tc, maybe(50, strs)), C: hegel.Draw(tc, optional(40, floats))}
+	})
+	innerLists = hegel.Map(many(inners, 0, 3), nonNil[hgInner])
+)
+
+// minMapSize: maps may be empty (non-nil: the shape of json-iterator/3 under MarshalIndent);
+// under HEGEL_NO_KNOWN=1 a map has a member.
+var minMapSize = shaped(0, 1)
+
+// mapsOf: a map of minMapSize to max members, empty but not nil when there are none.
+func mapsOf[K comparable, V any](g hegel.MapGenerator[K, V], max int) hegel.Generator[map[K]V] {
+	return hegel.Map(g.MinSize(minMapSize).MaxSize(max), nonNilMap[K, V])
+}
+
+// anyTrees: an interface{} tree of the kinds encoding/json itself produces (nil, bool,
+// float64, string, []any and map[string]any) with at most maxDepth levels of containers and
+// leafStrs for its strings. A node is a leaf (nil or a bool once in six each, a float or a
+// string twice) three times in five, else a list of up to four nodes or a map of up to four
+// once each. The depth counter lives in the closure and is restored by defer, so an aborted
+// draw cannot leave it stale.
+func anyTrees(maxDepth int, leafStrs hegel.Generator[string]) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(floats)},
+		choice[any]{2, asAny(leafStrs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	maps := mapsOf(hegel.Maps(mapKeys, child), 4)
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(maps)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var (
+	anyTrees3, anyTrees2, anyTrees1 = anyTrees(3, strs), anyTrees(2, strs), anyTrees(1, strs)
+	// utf8Trees3: for the round trip, whose strings must come back as they were.
+	utf8Trees3 = anyTrees(3, utf8Strs)
+)
+
+// compacted is the compact form of a JSON text (the text itself when it is not JSON).
+func compacted(raw string) string {
+	var c bytes.Buffer
+	if err := std.Compact(&c, []byte(raw)); err != nil {
+		return raw
+	}
+	return c.String()
+}
+
+var (
+	hgKeys       = hegel.Map(hegel.Integers(0, 255), func(k int) hgKey { return hgKey{uint8(k)} })
+	hgTexts      = hegel.Map(strs, func(s string) hgText { return hgText{s} })
+	hgMarshes    = hegel.Map(i32s, func(v int32) hgMarsh { return hgMarsh{v} })
+	int16Triples = hegel.Map(many(hegel.Integers(-300, 300), 3, 3), func(xs []int) (a [3]int16) {
+		for i, x := range xs {
+			a[i] = int16(x)
+		}
+		return a
+	})
+	numbers = hegel.Map(numLits, func(l string) std.Number { return std.Number(l) })
+	// rawMessages: a tree of two levels rendered with a tape: with its whitespace and its <, >
+	// and & raw, which encoding/json compacts and HTML-escapes and json-iterator copies
+	// verbatim (json-iterator/14); a bare null, which json-iterator decodes into a nil
+	// RawMessage (json-iterator/24). Under HEGEL_NO_KNOWN=1 compact, with <, > and & spelled
+	// as escapes, and [null] for null. Raw U+2028/U+2029 are always spelled as escapes: with
+	// HTML escaping off, encoding/json before Go 1.25's rewrite copied them through while
+	// today's escapes them, and neither reading is wrong (see the README's oracle caveat).
+	rawMessages = hegel.Map(pairs(rawTrees2, tapes), func(p pair[any, []int]) std.RawMessage {
+		raw := render(p.a, p.b, false, false)
+		raw = strings.ReplaceAll(raw, "\U00002028", "\\u2028")
+		raw = strings.ReplaceAll(raw, "\U00002029", "\\u2029")
+		c := compacted(raw)
+		if Known.rawVerbatim {
+			raw = strings.NewReplacer("<", "\\u003c", ">", "\\u003e", "&", "\\u0026").Replace(c)
+		}
+		if Known.nullRaw && c == "null" {
+			raw = "[null]"
+		}
+		return std.RawMessage(raw)
+	})
+	// riches: an hgRich; the optional fields present half of the time or so.
+	riches = hegel.Composite(func(tc hegel.TestCase) hgRich {
+		return hgRich{
+			HgEmbedded: HgEmbedded{
+				E1: uint16(hegel.Draw(tc, hegel.Integers(0, 65535))),
+				E2: hegel.Draw(tc, maybe(50, strLists)),
+			},
+			P:      hegel.Draw(tc, optional(60, inners)),
+			I8:     int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+			I16:    int16(hegel.Draw(tc, hegel.Integers(-32768, 32767))),
+			I32:    hegel.Draw(tc, i32s),
+			I64:    hegel.Draw(tc, int64s),
+			U8:     uint8(hegel.Draw(tc, hegel.Integers(0, 255))),
+			U32:    hegel.Draw(tc, u32s),
+			U64:    hegel.Draw(tc, uint64s),
+			F32:    hegel.Draw(tc, float32s),
+			F64:    hegel.Draw(tc, floats),
+			S:      hegel.Draw(tc, strs),
+			SS:     hegel.Draw(tc, strs),
+			B:      hegel.Draw(tc, hegel.Booleans()),
+			Bs:     hegel.Draw(tc, maybe(70, byteSlices)),
+			Arr:    hegel.Draw(tc, int16Triples),
+			Sl:     hegel.Draw(tc, maybe(50, innerLists)),
+			M:      hegel.Draw(tc, maybe(50, mapsOf(hegel.Maps(mapKeys, hegel.Integers(-1000, 1000)), 4))),
+			MI:     hegel.Draw(tc, maybe(60, mapsOf(hegel.Maps(i32s, strs), 4))),
+			MT:     hegel.Draw(tc, maybe(40, mapsOf(hegel.Maps(hgKeys, hegel.Booleans()), 4))),
+			N:      hegel.Draw(tc, maybe(50, numbers)),
+			R:      hegel.Draw(tc, maybe(50, rawMessages)),
+			T:      hegel.Draw(tc, hgTexts),
+			TP:     hegel.Draw(tc, optional(40, hgTexts)),
+			J:      hegel.Draw(tc, hgMarshes),
+			Any:    hegel.Draw(tc, maybe(60, anyTrees2)),
+			Skip:   hegel.Draw(tc, hegel.Integers(1, 100)),
+			Dash:   hegel.Draw(tc, hegel.Integers(1, 100)),
+			Lower:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+			NoTag:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+			hidden: hegel.Draw(tc, hegel.Integers(1, 100)),
+		}
+	})
+	smallMarshes = hegel.Map(hegel.Integers(-5, 5), func(v int) hgMarsh { return hgMarsh{int32(v)} })
+	// tops: a top-level value for the encoders from the whole universe: an interface{} tree
+	// once in five, a struct three times in ten, a pointer to one, a slice of structs, a
+	// string-keyed and a TextMarshaler-keyed map, and an array of Marshalers once each.
+	tops = weighted(
+		choice[any]{2, anyTrees3},
+		choice[any]{3, asAny(riches)},
+		choice[any]{1, asAny(hegel.Map(riches, ptrTo[hgRich]))},
+		choice[any]{1, asAny(innerLists)},
+		choice[any]{1, asAny(mapsOf(hegel.Maps(mapKeys, inners), 3))},
+		choice[any]{1, asAny(mapsOf(hegel.Maps(hgKeys, anyTrees1), 3))},
+		choice[any]{1, asAny(hegel.Map(pairs(smallMarshes, smallMarshes), func(p pair[hgMarsh, hgMarsh]) [2]hgMarsh { return [2]hgMarsh{p.a, p.b} }))},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Generators for JSON texts.
+//
+// A tree is nil | bool | jnum | string | []any | jobj; jnum is a number
+// literal kept verbatim, jobj is an ordered list of pairs (duplicates
+// allowed, rarely).  render writes a tree with the whitespace and escape
+// choices of a tape.  A jraw leaf is a string literal written as it is,
+// malformed or not (hegel_shapes_test.go builds them).
+
+type jnum string
+
+type jraw string
+
+type jpair struct {
+	k string
+	v any
+}
+
+type jobj []jpair
+
+const digits = "0123456789"
+
+func digitText(lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(digits).MinSize(lo).MaxSize(hi)
+}
+
+// numLit is a JSON number literal: an optional minus, the integer digits, a fraction and an
+// exponent (each "" when absent).
+type numLit struct {
+	neg              bool
+	whole, frac, exp string
+}
+
+func (l numLit) String() string {
+	var b strings.Builder
+	if l.neg {
+		b.WriteByte('-')
+	}
+	b.WriteString(l.whole)
+	if l.frac != "" {
+		b.WriteByte('.')
+		b.WriteString(l.frac)
+	}
+	b.WriteString(l.exp)
+	return b.String()
+}
+
+var (
+	// wholes: one digit two times in five, else up to twenty digits without a leading zero.
+	wholes = weighted(
+		choice[string]{40, hegel.Map(hegel.Integers(0, 9), strconv.Itoa)},
+		choice[string]{60, hegel.Map(pairs(hegel.Integers(1, 9), digitText(0, 19)), func(p pair[int, string]) string { return strconv.Itoa(p.a) + p.b })},
+	)
+	expMarks = hegel.SampledFrom([]string{"e", "E"})
+	expSigns = hegel.SampledFrom([]string{"", "+", "-"})
+	// zeroExpDigits: the exponent of a literal whose integer part is 0: at or below 38, or
+	// half of the time from 39 to 99, where with a fraction the value passes float32 range
+	// (json-iterator/8: Valid rejects it); at or below 38 under HEGEL_NO_KNOWN=1.
+	zeroExpDigits = hegel.Map(shaped(
+		weighted(choice[int]{1, hegel.Integers(0, 38)}, choice[int]{1, hegel.Integers(39, 99)}),
+		hegel.Integers(0, 38),
+	), strconv.Itoa)
+	// expDigits: one or two exponent digits, and once in seven three (a magnitude past
+	// float64 range from e309 on, json-iterator/9: Valid rejects it); one or two under
+	// HEGEL_NO_KNOWN=1.
+	expDigits = shaped(
+		weighted(choice[string]{6, digitText(1, 2)}, choice[string]{1, digitText(3, 3)}),
+		digitText(1, 2),
+	)
+	// numLits: a valid JSON number literal: negative three times in ten, a fraction of up to
+	// six digits two times in five, an exponent three times in ten.
+	numLits = hegel.FlatMap(wholes, func(whole string) hegel.Generator[string] {
+		expTexts := expDigits
+		if whole == "0" {
+			expTexts = zeroExpDigits
+		}
+		exps := hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, expMarks) + hegel.Draw(tc, expSigns) + hegel.Draw(tc, expTexts)
+		})
+		return hegel.Composite(func(tc hegel.TestCase) string {
+			return numLit{
+				neg:   hegel.Draw(tc, chance(30)),
+				whole: whole,
+				frac:  hegel.Draw(tc, maybe(40, digitText(1, 6))),
+				exp:   hegel.Draw(tc, maybe(30, exps)),
+			}.String()
+		})
+	})
+	jnums = hegel.Map(numLits, func(l string) jnum { return jnum(l) })
+)
+
+// objEntry is a drawn member of an object: its key, or (once in ten, past the first member)
+// the key of an earlier member, pos modulo their count - a duplicate key, of which the last
+// wins.
+type objEntry struct {
+	key string
+	dup bool
+	pos int
+	v   any
+}
+
+func toObj(es []objEntry) jobj {
+	out := make(jobj, 0, len(es))
+	for i, e := range es {
+		k := e.key
+		if e.dup && i > 0 {
+			k = out[e.pos%i].k
+		}
+		out = append(out, jpair{k, e.v})
+	}
+	return out
+}
+
+// trees: a JSON tree with at most maxDepth levels of containers and leafStrs for its strings
+// and keys. A node is a leaf (null or a bool once in ten each, a number or a string twice)
+// three times in five, else an array of up to four nodes or an object of up to four members
+// once each; the depth counter lives in the closure like anyTrees'.
+func trees(maxDepth int, leafStrs hegel.Generator[string]) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(jnums)},
+		choice[any]{2, asAny(leafStrs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	entries := hegel.Composite(func(tc hegel.TestCase) objEntry {
+		return objEntry{key: hegel.Draw(tc, leafStrs), dup: hegel.Draw(tc, chance(10)), pos: hegel.Draw(tc, positions), v: hegel.Draw(tc, child)}
+	})
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	objs := hegel.Map(many(entries, 0, 4), toObj)
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(objs)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var (
+	trees3, trees2, trees1 = trees(3, textStrs), trees(2, textStrs), trees(1, textStrs)
+	rawTrees2              = trees(2, rawStrs)
+	cleanTrees2            = trees(2, cleanStrs)
+)
+
+// ---------------------------------------------------------------------------
+// The writer: a pure function of a tree and a tape.
+
+var wsBytes = []byte{' ', ' ', '\t', '\n', '\r'}
+
+// ws is whitespace once in four: one to three of space (twice as likely), tab, newline and
+// return.
+func (t *tape) ws() string {
+	if !t.coin(25) {
+		return ""
+	}
+	n := 1 + t.next(3)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteByte(wsBytes[t.next(len(wsBytes))])
+	}
+	return b.String()
+}
+
+// hexEscape is the \u escape of u, in upper case three times in ten.
+func (t *tape) hexEscape(u uint16) string {
+	s := fmt.Sprintf("\\u%04x", u)
+	if t.coin(30) {
+		s = "\\u" + strings.ToUpper(s[2:])
+	}
+	return s
+}
+
+var shortEscapes = map[rune]string{'\b': `\b`, '\f': `\f`, '\n': `\n`, '\r': `\r`, '\t': `\t`}
+
+// writeString writes s as a JSON string literal with the tape's escape choices; with plain
+// set it uses no \u escapes except for control characters. A byte that is not UTF-8 is
+// written as it is (json-iterator/20: read through where encoding/json replaces it).
+func (t *tape) writeString(s string, b *strings.Builder, plain bool) {
+	b.WriteByte('"')
+	// lone is set after a lone surrogate escape: under HEGEL_NO_KNOWN=1 the next rune is then
+	// never written as a surrogate pair (json-iterator/21).
+	lone := false
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		i += size
+		wasLone := lone
+		lone = false
+		switch {
+		case r == utf8.RuneError && size == 1:
+			b.WriteByte(s[i-1])
+		case r == '"':
+			if !plain && t.coin(50) {
+				b.WriteString("\\u0022")
+			} else {
+				b.WriteString(`\"`)
+			}
+		case r == '\\':
+			if !plain && t.coin(50) {
+				b.WriteString("\\u005c")
+			} else {
+				b.WriteString(`\\`)
+			}
+		case r < 0x20:
+			if e, ok := shortEscapes[r]; ok && t.coin(60) {
+				b.WriteString(e)
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		case r == '/' && !plain && t.coin(40):
+			b.WriteString(`\/`)
+		case r == 0xfffd && !plain && t.coin(50):
+			// a lone low surrogate escape decodes to U+FFFD in both libraries
+			// (only low surrogates: two neighbours must never form a pair)
+			b.WriteString([]string{"\\udc00", "\\uDFFF"}[t.next(2)])
+			lone = true
+		case !plain && t.coin(12) && !(Known.lonePairs && wasLone && r > 0xffff):
+			if r > 0xffff {
+				r1, r2 := (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00
+				b.WriteString(t.hexEscape(uint16(r1)))
+				b.WriteString(t.hexEscape(uint16(r2)))
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func (t *tape) write(v any, b *strings.Builder, plain bool) {
+	b.WriteString(t.ws())
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case jnum:
+		b.WriteString(string(x))
+	case jraw:
+		b.WriteString(string(x))
+	case string:
+		t.writeString(x, b, plain)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			t.write(e, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte(']')
+	case jobj:
+		b.WriteByte('{')
+		for i, p := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			b.WriteString(t.ws())
+			t.writeString(p.k, b, plain)
+			b.WriteString(t.ws())
+			b.WriteByte(':')
+			t.write(p.v, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("write: unexpected %T", v))
+	}
+}
+
+// render is tree as JSON text with the whitespace and escape choices of the tape (an empty
+// tape: no whitespace, the short escapes); with plain no optional \u escapes, with trailing
+// whitespace after the value.
+func render(tree any, tp []int, plain, trailing bool) string {
+	t := &tape{vals: tp}
+	var b strings.Builder
+	t.write(tree, &b, plain)
+	if trailing {
+		b.WriteString(t.ws())
+	}
+	return b.String()
+}
+
+// treeOf parses encoding/json's own encoding of a value into a tree (numbers kept verbatim)
+// whose objects' members are ordered by a rank the tape gives each (equal ranks, and so an
+// empty tape, keep the sorted order), so that it can be re-rendered with random formatting
+// and key order.
+func treeOf(canon []byte, ranks *tape) any {
+	d := std.NewDecoder(bytes.NewReader(canon))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		panic(fmt.Sprintf("treeOf: %v for %s", err, canon))
+	}
+	return ordered(v, ranks)
+}
+
+func ordered(v any, ranks *tape) any {
+	switch x := v.(type) {
+	case map[string]any:
+		ks := make([]string, 0, len(x))
+		for k := range x {
+			ks = append(ks, k)
+		}
+		sort.Strings(ks) // deterministic before the ranks apply
+		rank := make(map[string]int, len(ks))
+		for _, k := range ks {
+			rank[k] = ranks.next(100)
+		}
+		sort.SliceStable(ks, func(i, j int) bool { return rank[ks[i]] < rank[ks[j]] })
+		out := make(jobj, 0, len(ks))
+		for _, k := range ks {
+			out = append(out, jpair{k, ordered(x[k], ranks)})
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = ordered(e, ranks)
+		}
+		return out
+	case std.Number:
+		return jnum(x)
+	default:
+		return x
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs, named on a mismatch.
+
+// valueShape records which recorded encode-side shapes a Go value holds.
+type valueShape struct {
+	emptyMap     bool // json-iterator/3: an empty (non-nil) map, under indentation
+	mapContainer bool // json-iterator/5: a map whose value is a container, under indentation
+	rawLoose     bool // json-iterator/14: a RawMessage that is not compact or holds <, > or &
+	rawContainer bool // json-iterator/14: a RawMessage holding a container, under indentation
+	badUTF8      bool // json-iterator/15: a string that is not valid UTF-8
+	shortEsc     bool // json-iterator/16: a string holding U+0008 or U+000C
+}
+
+var rawMessageType = reflect.TypeOf(std.RawMessage(nil))
+
+// shapesOf walks a value (through pointers, interfaces, containers and every struct field,
+// exported or not: a TextMarshaler's text is its field).
+func shapesOf(v any) (s valueShape) {
+	s.walk(reflect.ValueOf(v))
+	return s
+}
+
+func (s *valueShape) walk(v reflect.Value) {
+	if !v.IsValid() {
+		return
+	}
+	if v.Kind() == reflect.Slice && v.Type() == rawMessageType {
+		b := string(v.Bytes())
+		if compacted(b) != b || strings.ContainsAny(b, "<>&") {
+			s.rawLoose = true
+		}
+		if c := strings.TrimLeft(b, " \t\n\r"); c != "" && (c[0] == '[' || c[0] == '{') {
+			s.rawContainer = true
+		}
+		return
+	}
+	switch v.Kind() {
+	case reflect.String:
+		str := v.String()
+		if !utf8.ValidString(str) {
+			s.badUTF8 = true
+		}
+		if strings.ContainsAny(str, "\b\f") {
+			s.shortEsc = true
+		}
+	case reflect.Interface, reflect.Pointer:
+		if !v.IsNil() {
+			s.walk(v.Elem())
+		}
+	case reflect.Map:
+		if !v.IsNil() && v.Len() == 0 {
+			s.emptyMap = true
+		}
+		it := v.MapRange()
+		for it.Next() {
+			s.walk(it.Key())
+			e := it.Value()
+			for (e.Kind() == reflect.Interface || e.Kind() == reflect.Pointer) && !e.IsNil() {
+				e = e.Elem()
+			}
+			switch e.Kind() {
+			case reflect.Map, reflect.Slice, reflect.Array, reflect.Struct:
+				s.mapContainer = true
+			}
+			s.walk(it.Value())
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			s.walk(v.Index(i))
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			s.walk(v.Field(i))
+		}
+	}
+}
+
+// compact names the shapes that show in compact output.
+func (s valueShape) compact() []string {
+	var shapes []string
+	if s.rawLoose {
+		shapes = append(shapes, bug(14))
+	}
+	if s.badUTF8 {
+		shapes = append(shapes, bug(15))
+	}
+	if s.shortEsc {
+		shapes = append(shapes, bug(16))
+	}
+	return shapes
+}
+
+// indented names the shapes that show in indented output, MarshalIndent's or (encoder) the
+// Encoder's, with the indent string: one that is not spaces panics MarshalIndent
+// (json-iterator/1) and is turned into spaces by SetIndent (json-iterator/2), the empty one
+// makes MarshalIndent compact (json-iterator/4; the Encoder is compact in both libraries).
+func (s valueShape) indented(indent string, encoder bool) []string {
+	shapes := s.compact()
+	switch {
+	case indent == "" && !encoder:
+		shapes = append(shapes, bug(4))
+	case indent != "" && strings.Trim(indent, " ") != "" && encoder:
+		shapes = append(shapes, bug(2))
+	case indent != "" && strings.Trim(indent, " ") != "":
+		shapes = append(shapes, bug(1))
+	}
+	if s.emptyMap {
+		shapes = append(shapes, bug(3))
+	}
+	if s.mapContainer {
+		shapes = append(shapes, bug(5))
+	}
+	if s.rawContainer && !s.rawLoose {
+		shapes = append(shapes, bug(14))
+	}
+	return shapes
+}
+
+var (
+	negativeLeadingZero = regexp.MustCompile(`-0[0-9]|-\.`)
+	// lonePairEscape: a lone low surrogate escape followed by a surrogate pair escape.
+	lonePairEscape = regexp.MustCompile(`\\u[dD][c-fC-F][0-9a-fA-F]{2}\\u[dD][89abAB][0-9a-fA-F]{2}\\u[dD][c-fC-F][0-9a-fA-F]{2}`)
+	numberLiterals = regexp.MustCompile(`-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?`)
+	// numberEscapes: a \u escape of a digit, a sign, a dot or an exponent mark, the escapes
+	// that meet json-iterator/30 inside a `,string` number or an integer key.
+	numberEscapes = regexp.MustCompile(`(?i)\\u00(3[0-9]|2[bde]|45|65)`)
+)
+
+// controlAfterEscape reports whether a string literal of the text holds a raw control
+// character after an escape (the fast path rejects one before any escape).
+func controlAfterEscape(s string) bool {
+	in, esc := false, false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case !in:
+			in, esc = c == '"', false
+		case c == '"':
+			in = false
+		case c == '\\':
+			esc = true
+			i++
+		case c < 0x20 && esc:
+			return true
+		}
+	}
+	return false
+}
+
+// outsideStrings blanks the contents of the text's string literals, so that a number pattern
+// inside a string does not count as a number.
+func outsideStrings(s string) string {
+	b := []byte(s)
+	in := false
+	for i := 0; i < len(b); i++ {
+		switch {
+		case !in:
+			in = b[i] == '"'
+		case b[i] == '"':
+			in = false
+		case b[i] == '\\':
+			b[i] = ' '
+			if i+1 < len(b) {
+				i++
+				b[i] = ' '
+			}
+		default:
+			b[i] = ' '
+		}
+	}
+	return string(b)
+}
+
+// textShapes names the recorded bugs whose shape a JSON text (valid or not) has for the
+// decoders and Valid: a complete value followed by more than whitespace (json-iterator/6), a
+// top-level number (/7), a 0.-mantissa literal above float32 range (/8), a literal out of
+// float64 range (/9), a negative number with leading zeros or no integer digit (/31), invalid
+// UTF-8 (/20), a surrogate pair escape after a lone surrogate escape (/21), a raw control
+// character after an escape inside a string (/32), and a bare null, which a RawMessage takes
+// as nil (/24). Decided with the oracle's decoder and regular expressions only (the number
+// patterns outside the string literals).
+func textShapes(s string) []string {
+	var shapes []string
+	add := func(n int) {
+		id := bug(n)
+		for _, have := range shapes {
+			if have == id {
+				return
+			}
+		}
+		shapes = append(shapes, id)
+	}
+	d := std.NewDecoder(strings.NewReader(s))
+	var v any
+	if err := d.Decode(&v); err == nil {
+		if _, isNum := v.(float64); isNum {
+			add(7)
+		}
+		if strings.TrimLeft(s[d.InputOffset():], " \t\n\r") != "" {
+			add(6)
+		}
+	}
+	nums := outsideStrings(s)
+	for _, lit := range numberLiterals.FindAllString(nums, -1) {
+		f, err := strconv.ParseFloat(lit, 64)
+		switch {
+		case err != nil:
+			add(9)
+		case strings.HasPrefix(strings.TrimPrefix(lit, "-"), "0.") && math.Abs(f) > math.MaxFloat32:
+			add(8)
+		}
+	}
+	if negativeLeadingZero.MatchString(nums) {
+		add(31)
+	}
+	if !utf8.ValidString(s) {
+		add(20)
+	}
+	if lonePairEscape.MatchString(s) {
+		add(21)
+	}
+	if controlAfterEscape(s) {
+		add(32)
+	}
+	if strings.Trim(s, " \t\n\r") == "null" {
+		add(24)
+	}
+	return shapes
+}
+
+// only keeps the shapes among the bugs named.
+func only(shapes []string, ns ...int) []string {
+	var out []string
+	for _, s := range shapes {
+		for _, n := range ns {
+			if s == bug(n) {
+				out = append(out, s)
+			}
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Mutations of a JSON text.
+
+// structural: the bytes a mutation deletes, duplicates or inserts: brackets, braces, commas,
+// colons, quotes, a space, letters of the literals, digits, signs, a dot, an exponent mark,
+// an x and a backslash; a tab too (inserted into a string that holds an escape it is the
+// shape of json-iterator/32), except under HEGEL_NO_KNOWN=1.
+var structural = func() string {
+	s := "[]{},:\" true0-+.eEx\\"
+	if !Known.tabInsertions {
+		s += "\t"
+	}
+	return s
+}()
+
+type mutKind int
+
+const (
+	mutTruncate  mutKind = iota // cut the text at an index
+	mutDelete                   // delete one structural or whitespace byte
+	mutDuplicate                // duplicate one
+	mutInsert                   // insert a structural byte at an index
+)
+
+var mutKindNames = []string{"truncate", "delete", "duplicate", "insert"}
+
+// mutation is one structural edit of a JSON text: at is an index into the text (truncate,
+// insert) or into its structural and whitespace bytes (delete, duplicate; -1 when it has
+// none, and the text stays as it is). An index inside a multi-byte character leaves invalid
+// UTF-8 (json-iterator/20); under HEGEL_NO_KNOWN=1 it moves to the next rune boundary.
+type mutation struct {
+	kind mutKind
+	at   int
+	ch   byte
+}
+
+func (m mutation) String() string {
+	if m.kind == mutInsert {
+		return fmt.Sprintf("insert %q at %d", m.ch, m.at)
+	}
+	return fmt.Sprintf("%s at %d", mutKindNames[m.kind], m.at)
+}
+
+func boundary(s string, i int) int {
+	if !Known.utf8Strings {
+		return i
+	}
+	for i < len(s) && !utf8.RuneStart(s[i]) {
+		i++
+	}
+	return i
+}
+
+func structuralIndices(s string) []int {
+	var idx []int
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(structural+" \t\n\r", s[i]) >= 0 {
+			idx = append(idx, i)
+		}
+	}
+	return idx
+}
+
+// mutationsOf: a mutation of s, each kind as often as the others, its index drawn against s.
+func mutationsOf(s string) hegel.Generator[mutation] {
+	idx := structuralIndices(s)
+	bounds := hegel.Integers(0, len(s))
+	inIdx := hegel.Just(-1)
+	if len(idx) > 0 {
+		inIdx = hegel.Map(hegel.Integers(0, len(idx)-1), func(i int) int { return idx[i] })
+	}
+	return weighted(
+		choice[mutation]{1, hegel.Map(bounds, func(i int) mutation { return mutation{kind: mutTruncate, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDelete, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDuplicate, at: i} })},
+		choice[mutation]{1, hegel.Map(pairs(bounds, hegel.SampledFrom([]byte(structural))), func(p pair[int, byte]) mutation {
+			return mutation{kind: mutInsert, at: p.a, ch: p.b}
+		})},
+	)
+}
+
+func (m mutation) apply(s string) string {
+	switch m.kind {
+	case mutTruncate:
+		return s[:boundary(s, m.at)]
+	case mutDelete:
+		if m.at < 0 {
+			return s
+		}
+		return s[:m.at] + s[m.at+1:]
+	case mutDuplicate:
+		if m.at < 0 {
+			return s
+		}
+		return s[:m.at+1] + s[m.at:]
+	default:
+		i := boundary(s, m.at)
+		return s[:i] + string(m.ch) + s[i:]
+	}
+}
+
+// discarded reports whether a mutated text is not compared: under HEGEL_NO_KNOWN=1 one with
+// any recorded shape (a complete value followed by more bytes, a bare top-level number, a
+// negative leading zero, a number past the float ranges, a raw control character after an
+// escape, a bare null), as the old test discarded them; by default none. The mutation
+// generator filters such edits out; the property keeps the check as a guard.
+func discarded(m string) bool {
+	return noKnown && len(textShapes(m)) > 0
+}
+
+// ---------------------------------------------------------------------------
+// The rest of the harness.
+
+// indents: runs of spaces, and by default a tab, the empty indent, letters and a tab with a
+// space (json-iterator/1, /2, /4); under HEGEL_NO_KNOWN=1 spaces only.
+var indents = shaped(
+	hegel.SampledFrom([]string{" ", "  ", "    ", "\t", "", "xx", "\t "}),
+	hegel.SampledFrom([]string{" ", "  ", "    "}),
+)
+
+func short(b []byte) string {
+	s := string(b)
+	if len(s) > 300 {
+		return s[:300] + "..."
+	}
+	return s
+}
+
+// indentUnsafe reports whether v holds a shape MarshalIndent gets wrong: a map whose value is
+// a container (map, slice, array or struct; json-iterator/5) or a RawMessage holding a
+// container (copied verbatim instead of re-indented; json-iterator/14). Under HEGEL_NO_KNOWN=1
+// indented output is only compared for values without either; by default it is compared and
+// the mismatch names the shape.
+func indentUnsafe(v any) bool {
+	if !Known.indentUnsafe {
+		return false
+	}
+	s := shapesOf(v)
+	return s.mapContainer || s.rawContainer
+}
+
+// noEscape is the compatible configuration with HTML escaping turned off.
+var noEscape = jsoniter.Config{SortMapKeys: true, ValidateJsonRawMessage: true}.Froze()
+
+// diffAt shows the first difference between two texts with some context.
+func diffAt(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := i - 40
+	if lo < 0 {
+		lo = 0
+	}
+	cut := func(s string) string {
+		if lo >= len(s) {
+			return ""
+		}
+		hi := i + 60
+		if hi > len(s) {
+			hi = len(s)
+		}
+		return s[lo:hi]
+	}
+	return fmt.Sprintf("at byte %d:\n   a %q\n   b %q", i, cut(a), cut(b))
+}
+
+func stdJSON(v any) string {
+	b, err := std.Marshal(v)
+	if err != nil {
+		return "ERR:" + err.Error()
+	}
+	return string(b)
+}
+
+// marshalIndent is json.MarshalIndent with its panic (json-iterator/1: "indent can only be
+// space") as an error, so that the mismatch names the shape instead of the panic wrapper
+// reporting a bare panic.
+func marshalIndent(v any, indent string) (b []byte, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	return json.MarshalIndent(v, "", indent)
+}
+
+// ---------------------------------------------------------------------------
+// Cases: one record per property, drawn once.
+
+// marshalCase: the value, MarshalIndent's indent, the Encoder's second value, whether the
+// Encoder's HTML escaping is turned off (it stays on when either value holds U+2028/9, see
+// the property), and whether and how it indents.
+type marshalCase struct {
+	v         any
+	indent    string
+	second    any
+	escapeOff bool
+	indented  bool
+	indent2   string
+}
+
+func (c marshalCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s\nindent %q; second %s; escapeOff=%v indented=%v indent2 %q",
+		c.v, short([]byte(stdJSON(c.v))), c.indent, short([]byte(stdJSON(c.second))), c.escapeOff, c.indented, c.indent2)
+}
+
+var marshalCases = hegel.Composite(func(tc hegel.TestCase) marshalCase {
+	return marshalCase{
+		v:         hegel.Draw(tc, tops),
+		indent:    hegel.Draw(tc, indents),
+		second:    hegel.Draw(tc, anyTrees1),
+		escapeOff: hegel.Draw(tc, chance(50)),
+		indented:  hegel.Draw(tc, chance(50)),
+		indent2:   hegel.Draw(tc, indents),
+	}
+})
+
+// textCase: a tree of three levels and the tape of its rendering (with trailing whitespace).
+type textCase struct {
+	tree any
+	tape []int
+}
+
+func (c textCase) text() string { return render(c.tree, c.tape, false, true) }
+
+func (c textCase) GoString() string {
+	return fmt.Sprintf("text %q (tape of %d)", short([]byte(c.text())), len(c.tape))
+}
+
+func textCasesOf(treesOf hegel.Generator[any]) hegel.Generator[textCase] {
+	return hegel.Composite(func(tc hegel.TestCase) textCase {
+		return textCase{tree: hegel.Draw(tc, treesOf), tape: hegel.Draw(tc, tapes)}
+	})
+}
+
+var textCases = textCasesOf(trees3)
+
+// structCase: the value; the ranks of its keys (a tape: equal ranks keep the sorted order);
+// an unknown member three times in ten, inserted at a position modulo the member count; the
+// coins that upper-case the keys once in five (recycled over the members; encoding/json
+// matches keys case-insensitively); the tapes of the two renderings; and whether the
+// renderings use the optional \u escapes (json-iterator/30: `,string` numbers and integer
+// map keys are read without unescaping) - in the wide property unless HEGEL_NO_KNOWN=1.
+type structCase struct {
+	v       hgRich
+	ranks   []int
+	unknown *any
+	at      int
+	upper   []bool
+	tape    []int
+	tape2   []int
+	escapes bool
+}
+
+// render is encoding/json's encoding of the value re-rendered twice: the tree in the drawn
+// key order, with the unknown member and the upper-cased keys, written with each tape.
+func (c structCase) render(canon []byte) (text, plain string) {
+	tree := treeOf(canon, &tape{vals: c.ranks}).(jobj)
+	if c.unknown != nil {
+		at := c.at % (len(tree) + 1)
+		tree = append(tree[:at], append(jobj{{"zz_unknown", *c.unknown}}, tree[at:]...)...)
+	}
+	if len(c.upper) > 0 {
+		for i := range tree {
+			if c.upper[i%len(c.upper)] {
+				tree[i].k = strings.ToUpper(tree[i].k)
+			}
+		}
+	}
+	return render(tree, c.tape, !c.escapes, true), render(tree, c.tape2, !c.escapes, true)
+}
+
+func (c structCase) GoString() string {
+	canon := stdJSON(c.v)
+	text, plain := c.render([]byte(canon))
+	return fmt.Sprintf("canonical: %s\ntext:      %s\nplain:     %s\nunknown=%v at %d, upper %v", short([]byte(canon)), short([]byte(text)), short([]byte(plain)), c.unknown != nil, c.at, c.upper)
+}
+
+// structCasesOf draws a structCase over the values, with the renderings' tapes from tapesOf
+// and the optional escapes on when escapes says so.
+func structCasesOf(values hegel.Generator[hgRich], tapesOf hegel.Generator[[]int], escapes bool) hegel.Generator[structCase] {
+	return hegel.Composite(func(tc hegel.TestCase) structCase {
+		return structCase{
+			v:       hegel.Draw(tc, values),
+			ranks:   hegel.Draw(tc, tapes),
+			unknown: hegel.Draw(tc, optional(30, trees1)),
+			at:      hegel.Draw(tc, positions),
+			upper:   hegel.Draw(tc, maybe(20, many(hegel.Booleans(), 1, 32))),
+			tape:    hegel.Draw(tc, tapesOf),
+			tape2:   hegel.Draw(tc, tapesOf),
+			escapes: escapes,
+		}
+	})
+}
+
+var structCases = structCasesOf(riches, tapes, !Known.structEscapes)
+
+// validCase: a tree rendered with a tape (trailing whitespace half of the time) and, three
+// times in five, a mutation of the text, drawn against it. Under HEGEL_NO_KNOWN=1 a top-level
+// number (json-iterator/7) or null (json-iterator/24) is wrapped in an array.
+type validCase struct {
+	tree     any
+	tape     []int
+	trailing bool
+	text     string // the rendering
+	mut      *mutation
+}
+
+func (c validCase) GoString() string {
+	s := fmt.Sprintf("text %q", short([]byte(c.text)))
+	if c.mut != nil {
+		s += fmt.Sprintf("; %v -> %q", *c.mut, short([]byte(c.mut.apply(c.text))))
+	}
+	return s
+}
+
+var validCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) validCase {
+	tree := hegel.Draw(tc, trees3)
+	if _, isNum := tree.(jnum); (Known.validShapes && isNum) || (Known.nullRaw && tree == nil) {
+		tree = []any{tree}
+	}
+	c := validCase{tree: tree, tape: hegel.Draw(tc, tapes), trailing: hegel.Draw(tc, chance(50))}
+	c.text = render(c.tree, c.tape, false, c.trailing)
+	return c
+}), func(c validCase) hegel.Generator[validCase] {
+	kept := hegel.Filter(mutationsOf(c.text), func(m mutation) bool { return !discarded(m.apply(c.text)) })
+	return hegel.Map(optional(60, kept), func(m *mutation) validCase {
+		c.mut = m
+		return c
+	})
+})
+
+// streamValue: a value of a stream: its tree of two levels, the tape of its rendering, and
+// the separator before it, kept seven times in ten; else written only when the two values
+// are not self-delimiting on both sides (e.g. "...]" then "{...", or "...}" then "[...").
+type streamValue struct {
+	tree    any
+	tape    []int
+	sep     string
+	keepSep bool
+}
+
+// streamCase: one to four values, then garbage three times in ten (else trailing whitespace
+// once in eight).
+type streamCase struct {
+	values  []streamValue
+	garbage string
+	trail   string
+}
+
+// text writes the stream.
+func (c streamCase) text() string {
+	var b strings.Builder
+	for i, v := range c.values {
+		text := render(v.tree, v.tape, false, false)
+		if i > 0 {
+			prev := b.String()
+			next := strings.TrimLeft(text, " \t\r\n")
+			if v.keepSep || next == "" || !strings.ContainsRune("]}\"", rune(prev[len(prev)-1])) || !strings.ContainsRune("[{\"", rune(next[0])) {
+				b.WriteString(v.sep)
+			}
+		}
+		b.WriteString(text)
+	}
+	if c.garbage != "" {
+		b.WriteString(c.garbage)
+	} else {
+		b.WriteString(c.trail)
+	}
+	return b.String()
+}
+
+// eofShape reports whether the stream has the shape of json-iterator/10: no garbage, and
+// whitespace after the last value or a bare number as the last value (after a container, a
+// literal or a string the Decoder does reach io.EOF).
+func (c streamCase) eofShape() bool {
+	if c.garbage != "" {
+		return false
+	}
+	_, isNum := c.values[len(c.values)-1].tree.(jnum)
+	return c.trail != "" || isNum
+}
+
+// shapes names the recorded bug whose shape a mismatch at Decode #i of the stream (or at
+// More() after value #i) has: at the Decode after the last value (i == k) with no garbage it
+// is json-iterator/10; anywhere, invalid UTF-8 in a value (/20) or a pair escape after a lone
+// surrogate escape (/21).
+func (c streamCase) shapes(i int) []string {
+	var shapes []string
+	if i == len(c.values) && c.eofShape() {
+		shapes = append(shapes, bug(10))
+	}
+	return append(shapes, only(textShapes(c.text()), 20, 21)...)
+}
+
+func (c streamCase) GoString() string {
+	return fmt.Sprintf("stream %q (%d values, garbage %q)", short([]byte(c.text())), len(c.values), c.garbage)
+}
+
+var (
+	// garbageTails: what may follow a stream. An unterminated { or " is left out: after it
+	// More() at EOF was false in encoding/json before Go 1.25 and is true in today's, see the
+	// README's oracle caveat. "1." is left out: encoding/json's Decoder reads the number up to
+	// the second dot and fails on the next call, json-iterator fails at once (see the README).
+	garbageTails = hegel.SampledFrom([]string{" x", ",", "\x01", " -", "]", "}", " tru", "nul", "\"ab"})
+	separators   = hegel.SampledFrom([]string{" ", "\n", "\t", " \r\n"})
+	wsRuns       = hegel.Map(many(hegel.SampledFrom(wsBytes), 1, 3), func(bs []byte) string { return string(bs) })
+	streamValues = hegel.Composite(func(tc hegel.TestCase) streamValue {
+		return streamValue{tree: hegel.Draw(tc, trees2), tape: hegel.Draw(tc, tapes), sep: hegel.Draw(tc, separators), keepSep: hegel.Draw(tc, chance(70))}
+	})
+	streamCases = hegel.Composite(func(tc hegel.TestCase) streamCase {
+		return streamCase{values: hegel.Draw(tc, many(streamValues, 1, 4)), garbage: hegel.Draw(tc, maybe(30, garbageTails)), trail: hegel.Draw(tc, maybe(12, wsRuns))}
+	})
+)
+
+// roundTripCase: an interface{} tree two times in five, else a struct of the universe.
+type roundTripCase struct{ v any }
+
+func (c roundTripCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s", c.v, short([]byte(stdJSON(c.v))))
+}
+
+var roundTripCases = hegel.Map(weighted(
+	choice[any]{2, utf8Trees3},
+	choice[any]{3, asAny(riches)},
+), func(v any) roundTripCase { return roundTripCase{v} })
+
+// ---------------------------------------------------------------------------
+// The judges: one per property, shared with the narrow properties of hegel_shapes_test.go.
+
+// encodesLike judges one marshalCase: Marshal, MarshalIndent and Encoder produce byte-for-byte
+// what encoding/json produces, with and without HTML escaping and indentation; a mismatch
+// names the shapes of the value (shapesOf) and of the indent.
+func encodesLike(ht *hegel.T, c marshalCase) {
+	v := c.v
+	vs, ss := shapesOf(v), shapesOf(c.second)
+
+	g, ge := json.Marshal(v)
+	w, we := std.Marshal(v)
+	if (ge == nil) != (we == nil) {
+		fail(ht, "Marshal error mismatch: json-iterator %v, encoding/json %v", ge, we)
+	}
+	if string(g) != string(w) {
+		mismatch(ht, vs.compact(), "Marshal differs %s", diffAt(string(g), string(w)))
+	}
+
+	// MarshalIndent's prefix is documented as unsupported, so it is always "".
+	indentOK := !indentUnsafe(v)
+	if indentOK {
+		gi, gie := marshalIndent(v, c.indent)
+		wi, wie := std.MarshalIndent(v, "", c.indent)
+		if (gie == nil) != (wie == nil) || string(gi) != string(wi) {
+			mismatch(ht, vs.indented(c.indent, false), "MarshalIndent(%q) differs (%v, %v) %s", c.indent, gie, wie, diffAt(string(gi), string(wi)))
+		}
+	}
+
+	var gb, wb bytes.Buffer
+	genc, wenc := json.NewEncoder(&gb), std.NewEncoder(&wb)
+	// With HTML escaping off, today's encoding/json still escapes
+	// U+2028/U+2029 where json-iterator (and encoding/json before Go
+	// 1.25) writes them raw; neither is wrong, so escaping stays on for
+	// values containing them.
+	second := c.second
+	both := stdJSON(v) + stdJSON(second)
+	escape := !c.escapeOff || strings.Contains(both, "\\u2028") || strings.Contains(both, "\\u2029")
+	genc.SetEscapeHTML(escape)
+	wenc.SetEscapeHTML(escape)
+	indented := c.indented && indentOK && !indentUnsafe(second)
+	if indented {
+		genc.SetIndent("", c.indent2)
+		wenc.SetIndent("", c.indent2)
+	}
+	for _, x := range []any{v, second} {
+		ge, we := genc.Encode(x), wenc.Encode(x)
+		if (ge == nil) != (we == nil) {
+			fail(ht, "Encoder.Encode error mismatch: json-iterator %v, encoding/json %v", ge, we)
+		}
+	}
+	if gb.String() != wb.String() {
+		shapes := append(vs.compact(), ss.compact()...)
+		if indented {
+			shapes = append(shapes, vs.indented(c.indent2, true)...)
+			shapes = append(shapes, ss.indented(c.indent2, true)...)
+		}
+		mismatch(ht, dedupe(shapes), "Encoder output differs (escapeHTML=%v) %s", escape, diffAt(gb.String(), wb.String()))
+	}
+
+	// A Config with EscapeHTML off is the package-level spelling of
+	// SetEscapeHTML(false).
+	if we == nil && !escape {
+		opt, err := noEscape.Marshal(v)
+		var ref bytes.Buffer
+		enc := std.NewEncoder(&ref)
+		enc.SetEscapeHTML(false)
+		_ = enc.Encode(v)
+		want := strings.TrimSuffix(ref.String(), "\n")
+		if err != nil || string(opt) != want {
+			mismatch(ht, vs.compact(), "Marshal with EscapeHTML off differs (%v) %s", err, diffAt(string(opt), want))
+		}
+	}
+}
+
+func dedupe(shapes []string) []string {
+	var out []string
+	for _, s := range shapes {
+		seen := false
+		for _, o := range out {
+			seen = seen || o == s
+		}
+		if !seen {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// interfaceDecodesLike judges one valid text: Unmarshal into interface{} and Decoder.UseNumber
+// give exactly the value encoding/json gives, and Valid accepts it (for a top-level number
+// only by default: json-iterator/7). shapes names the recorded bugs whose shape the text has.
+func interfaceDecodesLike(ht *hegel.T, text string, topNumber bool, shapes []string) {
+	var g, w any
+	ge := json.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if we != nil {
+		// a number outside float64 range: both must reject it (the verdict of the case)
+		if ge == nil {
+			fail(ht, "json-iterator accepts a text encoding/json rejects (%v)", we)
+		}
+		return
+	}
+	if ge != nil {
+		mismatch(ht, shapes, "json-iterator rejects a valid text: %v", ge)
+	}
+	if !reflect.DeepEqual(g, w) {
+		mismatch(ht, shapes, "Unmarshal into interface{} differs:\n json-iterator %#v\n encoding/json %#v", g, w)
+	}
+
+	gd, wd := json.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+	gd.UseNumber()
+	wd.UseNumber()
+	var gn, wn any
+	ge, we = gd.Decode(&gn), wd.Decode(&wn)
+	if ge != nil || we != nil {
+		mismatch(ht, shapes, "UseNumber decode errors: json-iterator %v, encoding/json %v", ge, we)
+	}
+	if !reflect.DeepEqual(gn, wn) {
+		mismatch(ht, shapes, "UseNumber decode differs:\n json-iterator %#v\n encoding/json %#v", gn, wn)
+	}
+	if (!topNumber || !Known.validShapes) && !json.Valid([]byte(text)) {
+		mismatch(ht, shapes, "Valid is false for a text Unmarshal accepted: %q", short([]byte(text)))
+	}
+}
+
+// structShapes names the recorded bugs whose shape a struct case has: a \u escape of a digit
+// or sign in the text (json-iterator/30) and a null RawMessage (json-iterator/24).
+func structShapes(v hgRich, text string) []string {
+	var shapes []string
+	if numberEscapes.MatchString(text) {
+		shapes = append(shapes, bug(30))
+	}
+	if compacted(string(v.R)) == "null" {
+		shapes = append(shapes, bug(24))
+	}
+	return shapes
+}
+
+// structDecodesLike judges one structCase: encoding/json's own encoding of the hgRich,
+// re-rendered, decodes to the same struct in both libraries (and back to the original
+// encoding), and DisallowUnknownFields rejects exactly the texts with an unknown key.
+func structDecodesLike(ht *hegel.T, c structCase) {
+	v := c.v
+	canon, err := std.Marshal(v)
+	if err != nil {
+		fail(ht, "encoding/json cannot encode the generated value: %v", err)
+	}
+	text, plain := c.render(canon)
+	unknown := c.unknown != nil
+	shapes := structShapes(v, text)
+
+	var a, b hgRich
+	ea, eb := json.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+	if eb != nil {
+		fail(ht, "encoding/json rejects its own re-rendered encoding: %v", eb)
+	}
+	if ea != nil {
+		mismatch(ht, shapes, "json-iterator rejects the text: %v", ea)
+	}
+	ja, jb := stdJSON(a), stdJSON(b)
+	if ja != jb {
+		mismatch(ht, shapes, "decoded structs differ %s\n text %q", diffAt(ja, jb), short([]byte(text)))
+	}
+	// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+	// out of the comparison with the original encoding.
+	v.R, a.R = nil, nil
+	canonNoRaw := stdJSON(v)
+	if stdJSON(a) != canonNoRaw {
+		mismatch(ht, shapes, "round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+	}
+
+	// The stream Decoder gets the same tree rendered again.
+	shapes = structShapes(c.v, plain)
+	var da, db hgRich
+	gd, wd := json.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+	gd.DisallowUnknownFields()
+	wd.DisallowUnknownFields()
+	ea, eb = gd.Decode(&da), wd.Decode(&db)
+	if (eb != nil) != unknown {
+		fail(ht, "encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+	}
+	if (ea != nil) != unknown {
+		mismatch(ht, shapes, "json-iterator DisallowUnknownFields: unknown key present=%v but err=%v", unknown, ea)
+	}
+	da.R = nil
+	if !unknown && stdJSON(da) != canonNoRaw {
+		mismatch(ht, shapes, "Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+	}
+}
+
+// validAgrees judges one text, valid or not: Valid and the Unmarshal verdicts (into
+// interface{} and into RawMessage) agree with encoding/json's, and so do the decoded values
+// when there are any. shapes names the recorded bugs whose shape the text has (textShapes).
+func validAgrees(ht *hegel.T, text string, shapes []string) {
+	gv, wv := json.Valid([]byte(text)), std.Valid([]byte(text))
+	if gv != wv {
+		mismatch(ht, shapes, "Valid differs: json-iterator %v, encoding/json %v: %q", gv, wv, short([]byte(text)))
+	}
+
+	var g, w any
+	ge := json.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shapes, "Unmarshal verdict differs: json-iterator %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+	}
+	if we == nil && !reflect.DeepEqual(g, w) {
+		mismatch(ht, shapes, "Unmarshal into interface{} differs:\n json-iterator %#v\n encoding/json %#v", g, w)
+	}
+	if we == nil && !wv {
+		fail(ht, "encoding/json: Unmarshal accepts what Valid rejects")
+	}
+
+	var gr, wr std.RawMessage
+	ge, we = json.Unmarshal([]byte(text), &gr), std.Unmarshal([]byte(text), &wr)
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shapes, "Unmarshal into RawMessage verdict differs: json-iterator %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+	}
+	if we == nil && string(gr) != string(wr) {
+		mismatch(ht, shapes, "Unmarshal into RawMessage differs:\n json-iterator %q\n encoding/json %q", short(gr), short(wr))
+	}
+}
+
+// decodesLike judges one stream of k values: both Decoders give the same values, the same
+// error verdicts and the same More() answers. Only the presence of an error is compared,
+// except that io.EOF, the Decoder's documented clean end of input, is a verdict of its own:
+// the two libraries disagreeing on it is a mismatch (json-iterator/10 at the end of a stream).
+// The k values are compared, and the Decode after the last one when garbage follows (tail)
+// or atEnd says so (by default always; under HEGEL_NO_KNOWN=1 not on the shape of
+// json-iterator/10). shapes names the recorded bugs whose shape a mismatch at Decode #i (or
+// at More() after value #i) has.
+func decodesLike(ht *hegel.T, stream string, k int, tail, atEnd bool, shapes func(i int) []string) {
+	last := k - 1
+	if tail || atEnd {
+		last = k
+	}
+	gd, wd := json.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+	for i := 0; i <= last; i++ {
+		var gv, wv any
+		ge, we := gd.Decode(&gv), wd.Decode(&wv)
+		if (ge == nil) != (we == nil) {
+			mismatch(ht, shapes(i), "Decode #%d error mismatch: json-iterator %v, encoding/json %v: %q", i, ge, we, short([]byte(stream)))
+		}
+		if we != nil {
+			if errors.Is(ge, io.EOF) != errors.Is(we, io.EOF) {
+				mismatch(ht, shapes(i), "Decode #%d: json-iterator %v, encoding/json %v (a clean end of input against an error): %q", i, ge, we, short([]byte(stream)))
+			}
+			break
+		}
+		if !reflect.DeepEqual(gv, wv) {
+			mismatch(ht, shapes(i), "Decode #%d differs:\n json-iterator %#v\n encoding/json %#v\n stream %q", i, gv, wv, short([]byte(stream)))
+		}
+		if gm, wm := gd.More(), wd.More(); gm != wm {
+			mismatch(ht, shapes(i), "More() after value #%d: json-iterator %v, encoding/json %v: %q", i, gm, wm, short([]byte(stream)))
+		}
+	}
+
+	// (json-iterator's Decoder has no Token method.)
+}
+
+// roundTripShapes names the recorded bugs whose shape an hgRich has for its own round trip: a
+// RawMessage that is not compact, written verbatim and read back trimmed (json-iterator/14),
+// a string that is not valid UTF-8, written as a \ufffd escape that reads back as a U+FFFD
+// the second Marshal writes raw (json-iterator/15), and a null RawMessage, read back as nil
+// and then omitted (json-iterator/24).
+func roundTripShapes(v hgRich) []string {
+	var shapes []string
+	s := shapesOf(v)
+	if s.rawLoose {
+		shapes = append(shapes, bug(14))
+	}
+	if s.badUTF8 {
+		shapes = append(shapes, bug(15))
+	}
+	if compacted(string(v.R)) == "null" {
+		shapes = append(shapes, bug(24))
+	}
+	return shapes
+}
+
+// roundTrips judges one value on json-iterator alone: Unmarshal(Marshal(v)) re-encodes to
+// the same bytes (an hgRich), or gives the same tree (an interface{} tree).
+func roundTrips(ht *hegel.T, v any) {
+	switch v := v.(type) {
+	case hgRich:
+		shapes := roundTripShapes(v)
+		text, err := json.Marshal(v)
+		if err != nil {
+			fail(ht, "Marshal: %v", err)
+		}
+		var back hgRich
+		if err := json.Unmarshal(text, &back); err != nil {
+			mismatch(ht, shapes, "Unmarshal of Marshal output: %v", err)
+		}
+		again, err := json.Marshal(back)
+		if err != nil || string(again) != string(text) {
+			mismatch(ht, shapes, "round trip differs (%v) %s", err, diffAt(string(text), string(again)))
+		}
+	default:
+		text, err := json.Marshal(v)
+		if err != nil {
+			fail(ht, "Marshal: %v", err)
+		}
+		var back any
+		if err := json.Unmarshal(text, &back); err != nil {
+			fail(ht, "Unmarshal of Marshal output: %v", err)
+		}
+		if !reflect.DeepEqual(v, back) {
+			fail(ht, "round trip differs:\n original %#v\n back     %#v", v, back)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// Marshal, MarshalIndent and Encoder produce byte-for-byte what encoding/json
+// produces, for random values from the whole universe, with and without HTML
+// escaping and indentation. The universe draws the indent strings, empty maps,
+// map-valued containers, loose RawMessages, invalid UTF-8 and U+0008/U+000C at
+// their natural rates (json-iterator/1-5, /14-16), so this property fails
+// while any of them is open.
+func TestHegelMarshalMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		encodesLike(ht, hegel.Draw(ht, marshalCases))
+	})
+}
+
+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings, and Valid accepts them. The trees draw top-level
+// numbers, 0.-mantissa literals above float32 range, invalid UTF-8 and a pair
+// escape after a lone surrogate escape at their natural rates (json-iterator/7,
+// /8, /20, /21), so this property fails while any of them is open.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, textCases)
+		_, isNum := c.tree.(jnum)
+		text := c.text()
+		interfaceDecodesLike(ht, text, isNum, only(textShapes(text), 7, 8, 20, 21))
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (and back to the original encoding), and
+// DisallowUnknownFields rejects exactly the texts with an unknown key. The
+// texts carry \u escapes inside `,string` numbers and integer keys, and the
+// universe a null RawMessage, at their natural rates (json-iterator/30, /24),
+// so this property fails while either is open.
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		structDecodesLike(ht, hegel.Draw(ht, structCases))
+	})
+}
+
+// Valid and Unmarshal agree with encoding/json on whether a text is valid,
+// for random valid texts and for texts with one structural mutation (which
+// are usually invalid), and on the decoded value when it is. The mutations
+// leave complete values with trailing bytes, top-level numbers, negative
+// leading zeros, numbers past the float ranges, invalid UTF-8, a raw tab after
+// an escape and a bare null at their natural rates (json-iterator/6-9, /20,
+// /24, /31, /32), so this property fails while any of them is open.
+func TestHegelValidMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, validCases)
+		text := c.text
+		if c.mut != nil {
+			// the generator filtered the discarded shapes out; this is the guard
+			if m := c.mut.apply(c.text); !discarded(m) {
+				text = m
+			}
+		}
+		validAgrees(ht, text, textShapes(text))
+	})
+}
+
+// A Decoder reading a stream of values (optionally followed by garbage) yields
+// the same values, errors and More() answers as encoding/json's Decoder, and
+// reports io.EOF exactly where it does. The streams end in whitespace or a bare
+// number at their natural rate (json-iterator/10), so this property fails while
+// that is open.
+func TestHegelDecoderStreamMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, streamCases)
+		decodesLike(ht, c.text(), len(c.values), c.garbage != "", !(Known.eofAtEnd && c.eofShape()), c.shapes)
+	})
+}
+
+// json-iterator on its own: Unmarshal(Marshal(v)) re-encodes to the same bytes, for
+// the struct universe and for interface{} trees. The universe draws loose and
+// null RawMessages at their natural rates (json-iterator/14, /24), so this
+// property fails while either is open.
+func TestHegelMarshalUnmarshalRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		roundTrips(ht, hegel.Draw(ht, roundTripCases).v)
+	})
+}
