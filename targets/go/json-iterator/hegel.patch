+package jsoniter_test
+
+// Hegel property tests for github.com/json-iterator/go.
+//
+// The oracle is the standard library's encoding/json, loaded here as `std`.
+// json-iterator's README promises "100% compatibility with the standard
+// library" through ConfigCompatibleWithStandardLibrary, which is the API under
+// test here (bound to `json` below, so that the calls read like the standard
+// ones): wherever the two disagree on a byte of output, a decoded value, or
+// whether an input is valid, one of them is wrong -- and the standard library
+// is the reference.  The properties generate random Go values (a rich struct
+// universe plus interface{} trees) and random JSON texts (with random
+// whitespace, escapes and number spellings) and compare Marshal/MarshalIndent/
+// Encoder, Unmarshal into interface{} and into structs, Valid on valid and
+// mutated texts, and Decoder streams.  Every difference found while writing
+// the tests is pinned by a TestHegelPin* test at the bottom; the generators
+// avoid those pinned shapes and say so in a comment where they do.
+//
+// Set JSONITER_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	jsoniter "github.com/json-iterator/go"
+	"hegel.dev/go/hegel"
+)
+
+// json is the API under test.
+var json = jsoniter.ConfigCompatibleWithStandardLibrary
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// collected is the panic value fail() raises in collect mode; property()
+// swallows it so that the case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("JSONITER_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 60 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The struct universe.
+
+// hgText is a TextMarshaler (value receiver) / TextUnmarshaler (pointer
+// receiver) pair; it is used both as a field and as a map key type below.
+type hgText struct{ V string }
+
+func (x hgText) MarshalText() ([]byte, error) { return []byte("t:" + x.V), nil }
+
+func (x *hgText) UnmarshalText(b []byte) error {
+	s := string(b)
+	if !strings.HasPrefix(s, "t:") {
+		return fmt.Errorf("hgText: bad text %q", s)
+	}
+	x.V = s[2:]
+	return nil
+}
+
+// hgKey is a TextMarshaler map key whose text sorts like its number.
+type hgKey struct{ K uint8 }
+
+func (k hgKey) MarshalText() ([]byte, error) { return []byte(fmt.Sprintf("k%03d", k.K)), nil }
+
+func (k *hgKey) UnmarshalText(b []byte) error {
+	v, err := strconv.Atoi(strings.TrimPrefix(string(b), "k"))
+	if err != nil || v < 0 || v > 255 {
+		return fmt.Errorf("hgKey: bad key %q", b)
+	}
+	k.K = uint8(v)
+	return nil
+}
+
+// hgMarsh is a value-receiver Marshaler with a pointer-receiver Unmarshaler.
+// Its output is a compact scalar (`"m:<v>"`): encoding/json compacts and
+// re-indents a Marshaler's output and json-iterator copies it verbatim
+// (TestHegelPinMarshalerOutputIsCompacted), so a container or whitespace here
+// would only find that bug again.
+type hgMarsh struct{ V int32 }
+
+func (m hgMarsh) MarshalJSON() ([]byte, error) {
+	return []byte(fmt.Sprintf("\"m:%d\"", m.V)), nil
+}
+
+func (m *hgMarsh) UnmarshalJSON(b []byte) error {
+	var w string
+	if err := std.Unmarshal(b, &w); err != nil {
+		return err
+	}
+	v, err := strconv.ParseInt(strings.TrimPrefix(w, "m:"), 10, 32)
+	if err != nil || !strings.HasPrefix(w, "m:") {
+		return fmt.Errorf("hgMarsh: bad text %q", w)
+	}
+	m.V = int32(v)
+	return nil
+}
+
+type hgInner struct {
+	A int      `json:"a"`
+	B string   `json:"b,omitempty"`
+	C *float64 `json:"c,omitempty"`
+}
+
+// HgEmbedded is exported so that it can be embedded and decoded into.
+type HgEmbedded struct {
+	E1 uint16   `json:"e1"`
+	E2 []string `json:"e2,omitempty"`
+}
+
+// hgRich exercises most of the encoding/json struct vocabulary: embedding,
+// pointers, every integer width, both float widths, the `string` option on
+// integers and on a string, omitempty on scalars and containers, []byte, a
+// fixed array, slices of structs, maps with string / integer / TextMarshaler
+// keys, Number, RawMessage, Marshaler and TextMarshaler fields, interface{},
+// `-`, `-,` and an unexported field.  Its keys are pairwise distinct even
+// case-insensitively, so the struct property may vary their case.
+type hgRich struct {
+	HgEmbedded
+	P     *hgInner         `json:"p"`
+	I8    int8             `json:"i8"`
+	I16   int16            `json:"i16,omitempty"`
+	I32   int32            `json:"i32,string"`
+	I64   int64            `json:"i64"`
+	U8    uint8            `json:"u8"`
+	U32   uint32           `json:"u32,omitempty"`
+	U64   uint64           `json:"u64,string"`
+	F32   float32          `json:"f32"`
+	F64   float64          `json:"f64,omitempty"`
+	S     string           `json:"s"`
+	SS    string           `json:"ss,string"`
+	B     bool             `json:"b,omitempty"`
+	Bs    []byte           `json:"bs"`
+	Arr   [3]int16         `json:"arr"`
+	Sl    []hgInner        `json:"sl,omitempty"`
+	M     map[string]int   `json:"m,omitempty"`
+	MI    map[int32]string `json:"mi"`
+	MT    map[hgKey]bool   `json:"mt,omitempty"`
+	N     std.Number       `json:"n,omitempty"`
+	R     std.RawMessage   `json:"r,omitempty"`
+	T     hgText           `json:"t"`
+	TP    *hgText          `json:"tp,omitempty"`
+	J     hgMarsh          `json:"j"`
+	Any   any              `json:"any"`
+	Skip  int              `json:"-"`
+	Dash  int              `json:"-,"`
+	Lower int              `json:"lower"`
+	NoTag int
+	//lint:ignore U1000 deliberately unexported, must be ignored by both encoders
+	hidden int
+}
+
+// ---------------------------------------------------------------------------
+// Generators for Go values.
+
+var stringPieces = []string{
+	"", "a", "Z", "0", "hello", "x y", " ", "\"", "\\", "/", "<", ">", "&", "'",
+	"\n", "\t", "\r", "\x00", "\x01", "\x1f", "\x7f",
+	"é", "日本", "😀", "\u2028", "\u2029", "\ufffd", "ÿ", "\U0010ffff", "\u00a0",
+	"{", "}", "[", "]", ",", ":", "null", "true", "1e5", "-0",
+}
+
+// genStr returns a valid-UTF-8 string built from pieces that cover ASCII
+// punctuation, quotes and backslashes, control characters, HTML-significant
+// characters, U+2028/2029 and non-BMP runes.  Invalid UTF-8 is not generated
+// (TestHegelPinInvalidUTF8IsWrittenAsRawReplacementCharacters) and U+0008 and
+// U+000C are left to genTextStr (TestHegelPinBackspaceAndFormFeedUseShortEscapes).
+func genStr(tc hegel.TestCase) string {
+	k := n(tc, 0, 6)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		if chance(tc, 15) {
+			b.WriteRune(rune(n(tc, 0x20, 0x2fff)))
+		} else {
+			b.WriteString(pick(tc, stringPieces))
+		}
+	}
+	return b.String()
+}
+
+const keyAlphabet = "abcxyzABCXYZ0189-_.:/#$%'()*+,;=?@[]^{}|~éü日 !\"\\<>&\n\u2028"
+
+// genKey returns a map key (possibly empty) from an alphabet that includes
+// characters needing escapes, so that key sorting and key escaping are both
+// exercised.
+func genKey(tc hegel.TestCase) string {
+	runes := []rune(keyAlphabet)
+	k := n(tc, 0, 5)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteRune(pick(tc, runes))
+	}
+	return b.String()
+}
+
+// genTextStr is genStr with a few more control characters, for JSON texts
+// that are only decoded.
+func genTextStr(tc hegel.TestCase) string {
+	s := genStr(tc)
+	if chance(tc, 15) {
+		s += pick(tc, []string{"\b", "\f", "a\bb\fc", "\x0b"})
+	}
+	return s
+}
+
+func genStrings(tc hegel.TestCase) []string {
+	k := n(tc, 0, 3)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = genStr(tc)
+	}
+	return out
+}
+
+func genBytes(tc hegel.TestCase) []byte {
+	k := n(tc, 0, 8)
+	out := make([]byte, k)
+	for i := range out {
+		out[i] = byte(n(tc, 0, 255))
+	}
+	return out
+}
+
+func genUint64(tc hegel.TestCase) uint64 {
+	switch n(tc, 0, 3) {
+	case 0:
+		return uint64(n(tc, 0, 1000))
+	case 1:
+		return uint64(n(tc, 0, math.MaxUint32))
+	default:
+		return uint64(n(tc, 0, math.MaxUint32))<<32 | uint64(n(tc, 0, math.MaxUint32))
+	}
+}
+
+func genInt64(tc hegel.TestCase) int64 {
+	switch n(tc, 0, 3) {
+	case 0:
+		return int64(n(tc, -1000, 1000))
+	case 1:
+		return pick(tc, []int64{math.MinInt64, math.MaxInt64, -1 << 53, 1 << 53, 1<<53 + 1, -(1<<53 + 1)})
+	default:
+		return int64(genUint64(tc))
+	}
+}
+
+func genFloat(tc hegel.TestCase) float64 {
+	for tries := 0; ; tries++ {
+		if tries == 32 {
+			return 0
+		}
+		var f float64
+		switch n(tc, 0, 7) {
+		case 0:
+			f = 0
+		case 1:
+			f = math.Copysign(0, -1)
+		case 2:
+			f = float64(n(tc, -1000000, 1000000))
+		case 3:
+			f = float64(n(tc, -1000000, 1000000)) / math.Pow10(n(tc, 0, 6))
+		case 4:
+			// tiny
+			f = math.Ldexp(1+float64(n(tc, 0, 1<<20))/float64(1<<20), -n(tc, 1, 1074))
+		case 5:
+			// huge: at or above 1e21, where encoding/json switches to exponent form
+			f = float64(n(tc, 1, 999999)) * math.Pow10(n(tc, 21, 300))
+		case 6:
+			f = math.Float64frombits(genUint64(tc))
+		default:
+			f = pick(tc, []float64{0.1, 0.5, 1.0 / 3, 1e20, 1e21, 123456789012345680000, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-10, 1e-100, 2.5e-300})
+		}
+		if chance(tc, 30) {
+			f = -f
+		}
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			continue
+		}
+		return f
+	}
+}
+
+// genFloat32 avoids NaN and the infinities (encoding/json rejects them; see
+// TestHegelMarshalMatchesEncodingJSON for the explicit check).
+func genFloat32(tc hegel.TestCase) float32 {
+	for tries := 0; ; tries++ {
+		if tries == 32 {
+			return 0
+		}
+		f := float32(genFloat(tc))
+		if chance(tc, 20) {
+			f = math.Float32frombits(uint32(n(tc, 0, math.MaxUint32)))
+		}
+		g := float64(f)
+		if math.IsNaN(g) || math.IsInf(g, 0) {
+			continue
+		}
+		return f
+	}
+}
+
+func genInner(tc hegel.TestCase) hgInner {
+	in := hgInner{A: n(tc, -100000, 100000)}
+	if chance(tc, 50) {
+		in.B = genStr(tc)
+	}
+	if chance(tc, 40) {
+		c := genFloat(tc)
+		in.C = &c
+	}
+	return in
+}
+
+// genAny returns an interface{} tree of the kinds encoding/json itself
+// produces: nil, bool, float64, string, []any and map[string]any.
+func genAny(tc hegel.TestCase, depth int) any {
+	top := 9
+	if depth <= 0 {
+		top = 5
+	}
+	switch n(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2, 3:
+		return genFloat(tc)
+	case 4, 5:
+		return genStr(tc)
+	case 6, 7:
+		k := n(tc, 0, 4)
+		out := make([]any, k)
+		for i := range out {
+			out[i] = genAny(tc, depth-1)
+		}
+		return out
+	default:
+		// Maps are never empty: MarshalIndent of an empty map is pinned
+		// (TestHegelPinEmptyMapIndentsAsBraces); nil maps and structs with
+		// no fields cover the empty case.
+		k := n(tc, 1, 4)
+		out := make(map[string]any, k)
+		for i := 0; i < k; i++ {
+			out[genKey(tc)] = genAny(tc, depth-1)
+		}
+		return out
+	}
+}
+
+func genRich(tc hegel.TestCase) hgRich {
+	var r hgRich
+	r.E1 = uint16(n(tc, 0, 65535))
+	if chance(tc, 50) {
+		r.E2 = genStrings(tc)
+	}
+	if chance(tc, 60) {
+		in := genInner(tc)
+		r.P = &in
+	}
+	r.I8 = int8(n(tc, -128, 127))
+	r.I16 = int16(n(tc, -32768, 32767))
+	r.I32 = int32(wide(tc, math.MinInt32, math.MaxInt32))
+	r.I64 = genInt64(tc)
+	r.U8 = uint8(n(tc, 0, 255))
+	r.U32 = uint32(n(tc, 0, math.MaxUint32))
+	r.U64 = genUint64(tc)
+	r.F32 = genFloat32(tc)
+	r.F64 = genFloat(tc)
+	r.S = genStr(tc)
+	r.SS = genStr(tc)
+	r.B = chance(tc, 50)
+	if chance(tc, 70) {
+		r.Bs = genBytes(tc)
+	}
+	for i := range r.Arr {
+		r.Arr[i] = int16(n(tc, -300, 300))
+	}
+	if chance(tc, 50) {
+		r.Sl = make([]hgInner, n(tc, 0, 3))
+		for i := range r.Sl {
+			r.Sl[i] = genInner(tc)
+		}
+	}
+	// Maps are non-empty when present (TestHegelPinEmptyMapIndentsAsBraces).
+	if chance(tc, 50) {
+		r.M = map[string]int{}
+		for i := n(tc, 1, 4); i > 0; i-- {
+			r.M[genKey(tc)] = n(tc, -1000, 1000)
+		}
+	}
+	if chance(tc, 60) {
+		r.MI = map[int32]string{}
+		for i := n(tc, 1, 4); i > 0; i-- {
+			r.MI[int32(wide(tc, math.MinInt32, math.MaxInt32))] = genStr(tc)
+		}
+	}
+	if chance(tc, 40) {
+		r.MT = map[hgKey]bool{}
+		for i := n(tc, 1, 4); i > 0; i-- {
+			r.MT[hgKey{uint8(n(tc, 0, 255))}] = chance(tc, 50)
+		}
+	}
+	if chance(tc, 50) {
+		r.N = std.Number(genNumLit(tc))
+	}
+	if chance(tc, 50) {
+		// Raw U+2028/U+2029 inside a RawMessage are spelled as escapes: with
+		// HTML escaping off, encoding/json before Go 1.25's rewrite copied
+		// them through while today's escapes them, and neither reading is
+		// wrong (see the README's oracle caveat).
+		// The RawMessage is compact for the same reason as hgMarsh's output.
+		raw := emitText(tc, genTree(tc, 2), false)
+		raw = strings.ReplaceAll(raw, "\u2028", `\u2028`)
+		raw = strings.ReplaceAll(raw, "\u2029", `\u2029`)
+		var c bytes.Buffer
+		if err := std.Compact(&c, []byte(raw)); err != nil {
+			panic(err)
+		}
+		if c.String() == "null" {
+			// a bare null decodes to a nil RawMessage in json-iterator
+			// (TestHegelPinNullIntoRawMessageKeepsTheLiteral)
+			c.Reset()
+			c.WriteString("[null]")
+		}
+		// encoding/json HTML-escapes a RawMessage's content, json-iterator copies
+		// it (TestHegelPinMarshalerOutputIsCompacted): spell <, > and & as escapes.
+		r.R = std.RawMessage(strings.NewReplacer("<", `\u003c`, ">", `\u003e`, "&", `\u0026`).Replace(c.String()))
+	}
+	r.T = hgText{genStr(tc)}
+	if chance(tc, 40) {
+		r.TP = &hgText{genStr(tc)}
+	}
+	r.J = hgMarsh{int32(wide(tc, math.MinInt32, math.MaxInt32))}
+	if chance(tc, 60) {
+		r.Any = genAny(tc, 2)
+	}
+	r.Skip = n(tc, 1, 100)
+	r.Dash = n(tc, 1, 100)
+	r.Lower = n(tc, -100, 100)
+	r.NoTag = n(tc, -100, 100)
+	r.hidden = n(tc, 1, 100)
+	return r
+}
+
+// genTop picks a top-level value for the encoders from the whole universe.
+func genTop(tc hegel.TestCase) any {
+	switch n(tc, 0, 9) {
+	case 0, 1, 2:
+		return genRich(tc)
+	case 3:
+		r := genRich(tc)
+		return &r
+	case 4, 5:
+		return genAny(tc, 3)
+	case 6:
+		out := make([]hgInner, n(tc, 0, 3))
+		for i := range out {
+			out[i] = genInner(tc)
+		}
+		return out
+	case 7:
+		out := map[string]hgInner{}
+		for i := n(tc, 1, 3); i > 0; i-- {
+			out[genKey(tc)] = genInner(tc)
+		}
+		return out
+	case 8:
+		out := map[hgKey]any{}
+		for i := n(tc, 1, 3); i > 0; i-- {
+			out[hgKey{uint8(n(tc, 0, 255))}] = genAny(tc, 1)
+		}
+		return out
+	default:
+		return [2]hgMarsh{{int32(n(tc, -5, 5))}, {int32(n(tc, -5, 5))}}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Generators for JSON texts.
+//
+// A tree is nil | bool | jnum | string | []any | jobj; jnum is a number
+// literal kept verbatim, jobj is an ordered list of pairs (duplicates
+// allowed, rarely).  emitText renders a tree with random whitespace, random
+// escape choices and the given number spellings.
+
+type jnum string
+
+type jpair struct {
+	k string
+	v any
+}
+
+type jobj []jpair
+
+// genNumLit returns a random valid JSON number literal whose magnitude stays
+// inside float64 range (at most 20 integer digits and a two-digit exponent),
+// because json-iterator's Valid rejects out-of-range numbers
+// (TestHegelPinValidAcceptsNumbersOutOfFloat64Range); a literal with a "0."
+// mantissa keeps its exponent at or below 38 because Valid rejects such
+// literals above float32 range (TestHegelPinValidAcceptsSmallMantissaLargeExponent).
+func genNumLit(tc hegel.TestCase) string {
+	var b strings.Builder
+	if chance(tc, 30) {
+		b.WriteByte('-')
+	}
+	k := n(tc, 1, 20)
+	if chance(tc, 40) {
+		k = 1
+	}
+	zero := false
+	if k == 1 {
+		d := n(tc, 0, 9)
+		zero = d == 0
+		b.WriteByte(byte('0' + d))
+	} else {
+		b.WriteByte(byte('1' + n(tc, 0, 8)))
+		for i := 1; i < k; i++ {
+			b.WriteByte(byte('0' + n(tc, 0, 9)))
+		}
+	}
+	if chance(tc, 40) {
+		b.WriteByte('.')
+		for i := n(tc, 1, 6); i > 0; i-- {
+			b.WriteByte(byte('0' + n(tc, 0, 9)))
+		}
+	}
+	if chance(tc, 30) {
+		b.WriteString(pick(tc, []string{"e", "E"}))
+		b.WriteString(pick(tc, []string{"", "+", "-"}))
+		if zero {
+			b.WriteString(strconv.Itoa(n(tc, 0, 38)))
+		} else {
+			for i := n(tc, 1, 2); i > 0; i-- {
+				b.WriteByte(byte('0' + n(tc, 0, 9)))
+			}
+		}
+	}
+	return b.String()
+}
+
+func genTree(tc hegel.TestCase, depth int) any {
+	top := 9
+	if depth <= 0 {
+		top = 5
+	}
+	switch n(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2, 3:
+		return jnum(genNumLit(tc))
+	case 4, 5:
+		return genTextStr(tc)
+	case 6, 7:
+		k := n(tc, 0, 4)
+		out := make([]any, k)
+		for i := range out {
+			out[i] = genTree(tc, depth-1)
+		}
+		return out
+	default:
+		k := n(tc, 0, 4)
+		out := make(jobj, 0, k)
+		for i := 0; i < k; i++ {
+			key := genTextStr(tc)
+			if i > 0 && chance(tc, 10) {
+				key = out[n(tc, 0, i-1)].k // a duplicate key: the last one wins
+			}
+			out = append(out, jpair{key, genTree(tc, depth-1)})
+		}
+		return out
+	}
+}
+
+// toTree converts a value decoded by encoding/json with UseNumber into a tree
+// whose objects are in random order.
+func toTree(tc hegel.TestCase, v any) any {
+	switch x := v.(type) {
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys) // deterministic before the drawn shuffle
+		out := make(jobj, 0, len(x))
+		for _, k := range keys {
+			out = append(out, jpair{k, toTree(tc, x[k])})
+		}
+		for i := len(out) - 1; i > 0; i-- {
+			j := n(tc, 0, i)
+			out[i], out[j] = out[j], out[i]
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = toTree(tc, e)
+		}
+		return out
+	case std.Number:
+		return jnum(x)
+	default:
+		return x
+	}
+}
+
+func ws(tc hegel.TestCase) string {
+	if chance(tc, 75) {
+		return ""
+	}
+	var b strings.Builder
+	for i := n(tc, 1, 3); i > 0; i-- {
+		b.WriteByte(pick(tc, []byte{' ', ' ', '\t', '\n', '\r'}))
+	}
+	return b.String()
+}
+
+func hexEscape(tc hegel.TestCase, u uint16) string {
+	s := fmt.Sprintf("\\u%04x", u)
+	if chance(tc, 30) {
+		s = strings.ToUpper(s[2:])
+		s = "\\u" + s
+	}
+	return s
+}
+
+// emitString writes s as a JSON string literal with random escape choices;
+// with plain set it uses no \u escapes except for control characters.
+func emitString(tc hegel.TestCase, s string, b *strings.Builder, plain bool) {
+	b.WriteByte('"')
+	// lone is set after a lone surrogate escape: the next rune is then never
+	// written as a surrogate pair (TestHegelPinLoneSurrogateBeforeAPair).
+	lone := false
+	for _, r := range s {
+		wasLone := lone
+		lone = false
+		switch {
+		case r == '"':
+			if plain {
+				b.WriteString(`\"`)
+			} else {
+				b.WriteString(pick(tc, []string{`\"`, `\u0022`}))
+			}
+		case r == '\\':
+			if plain {
+				b.WriteString(`\\`)
+			} else {
+				b.WriteString(pick(tc, []string{`\\`, `\u005c`}))
+			}
+		case r < 0x20:
+			short := map[rune]string{'\b': `\b`, '\f': `\f`, '\n': `\n`, '\r': `\r`, '\t': `\t`}
+			if e, ok := short[r]; ok && chance(tc, 60) {
+				b.WriteString(e)
+			} else {
+				b.WriteString(hexEscape(tc, uint16(r)))
+			}
+		case r == '/' && !plain && chance(tc, 40):
+			b.WriteString(`\/`)
+		case r == '\ufffd' && !plain && chance(tc, 50):
+			// a lone low surrogate escape decodes to U+FFFD in both libraries
+			// (only low surrogates: two neighbours must never form a pair)
+			b.WriteString(pick(tc, []string{`\udc00`, `\uDFFF`}))
+			lone = true
+		case !plain && chance(tc, 12) && !(wasLone && r > 0xffff):
+			if r > 0xffff {
+				r1, r2 := (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00
+				b.WriteString(hexEscape(tc, uint16(r1)))
+				b.WriteString(hexEscape(tc, uint16(r2)))
+			} else {
+				b.WriteString(hexEscape(tc, uint16(r)))
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func emit(tc hegel.TestCase, v any, b *strings.Builder, plain bool) {
+	b.WriteString(ws(tc))
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case jnum:
+		b.WriteString(string(x))
+	case string:
+		emitString(tc, x, b, plain)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				b.WriteString(ws(tc))
+				b.WriteByte(',')
+			}
+			emit(tc, e, b, plain)
+		}
+		b.WriteString(ws(tc))
+		b.WriteByte(']')
+	case jobj:
+		b.WriteByte('{')
+		for i, p := range x {
+			if i > 0 {
+				b.WriteString(ws(tc))
+				b.WriteByte(',')
+			}
+			b.WriteString(ws(tc))
+			emitString(tc, p.k, b, plain)
+			b.WriteString(ws(tc))
+			b.WriteByte(':')
+			emit(tc, p.v, b, plain)
+		}
+		b.WriteString(ws(tc))
+		b.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("emit: unexpected %T", v))
+	}
+}
+
+// emitText renders a tree, optionally with trailing whitespace.
+func emitText(tc hegel.TestCase, tree any, trailing bool) string {
+	var b strings.Builder
+	emit(tc, tree, &b, false)
+	if trailing {
+		b.WriteString(ws(tc))
+	}
+	return b.String()
+}
+
+// emitTextPlain renders a tree with random whitespace but without optional
+// escapes.
+func emitTextPlain(tc hegel.TestCase, tree any) string {
+	var b strings.Builder
+	emit(tc, tree, &b, true)
+	b.WriteString(ws(tc))
+	return b.String()
+}
+
+// canonTree parses encoding/json's own encoding of v into a tree (numbers kept
+// verbatim) so that it can be re-rendered with random formatting.
+func canonTree(tc hegel.TestCase, canon []byte) any {
+	d := std.NewDecoder(bytes.NewReader(canon))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		panic(fmt.Sprintf("canonTree: %v for %s", err, canon))
+	}
+	return toTree(tc, v)
+}
+
+var negativeLeadingZero = regexp.MustCompile(`-0[0-9]|-\.`)
+
+// pinnedValidShape reports whether s is a text on which json-iterator's Valid
+// is known to disagree with encoding/json: a complete value followed by
+// anything but whitespace (TestHegelPinValidRejectsTrailingBytes), a bare
+// top-level number (TestHegelPinValidAcceptsTopLevelNumbers), or a negative
+// number with leading zeros or no integer digit
+// (TestHegelPinValidRejectsNegativeLeadingZeros).  It is decided with the
+// oracle's decoder and a regular expression only.
+func pinnedValidShape(s string) bool {
+	if negativeLeadingZero.MatchString(s) {
+		return true
+	}
+	d := std.NewDecoder(strings.NewReader(s))
+	var v any
+	if err := d.Decode(&v); err != nil {
+		// a syntactically valid text that fails to decode holds a number out
+		// of float64 range (TestHegelPinValidAcceptsNumbersOutOfFloat64Range)
+		var te *std.UnmarshalTypeError
+		return errors.As(err, &te) && std.Valid([]byte(s))
+	}
+	if _, isNum := v.(float64); isNum {
+		return true
+	}
+	// (InputOffset rather than Buffered: Go 1.27's Buffered is empty after
+	// some values even when input remains.)
+	rest := s[d.InputOffset():]
+	return strings.TrimLeft(rest, " \t\n\r") != ""
+}
+
+// mutate applies one structural edit to a JSON text: it deletes or duplicates
+// one bracket, brace, comma, colon, quote or whitespace byte, inserts one such
+// punctuation byte (or a letter, a digit, a sign or a backslash) at a rune
+// boundary, or truncates the text at a rune boundary.  Edits inside a
+// multi-byte character would leave invalid UTF-8, whose decoding is pinned
+// (TestHegelPinInvalidUTF8InputIsReplaced).
+func runeBoundary(s string, i int) int {
+	for i < len(s) && !utf8.RuneStart(s[i]) {
+		i++
+	}
+	return i
+}
+
+func mutate(tc hegel.TestCase, s string) string {
+	// No tab in the insertion alphabet: a raw control character inside a
+	// string that also holds an escape is pinned
+	// (TestHegelPinRawControlCharactersAfterAnEscapeAreRejected).
+	const structural = "[]{},:\" true0-+.eEx\\"
+	var idx []int
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(structural+" \t\n\r", s[i]) >= 0 {
+			idx = append(idx, i)
+		}
+	}
+	switch n(tc, 0, 3) {
+	case 0:
+		if len(idx) == 0 {
+			return s
+		}
+		i := pick(tc, idx)
+		return s[:i] + s[i+1:]
+	case 1:
+		i := runeBoundary(s, n(tc, 0, len(s)))
+		return s[:i] + string(structural[n(tc, 0, len(structural)-1)]) + s[i:]
+	case 2:
+		return s[:runeBoundary(s, n(tc, 0, len(s)))]
+	default:
+		if len(idx) == 0 {
+			return s
+		}
+		i := pick(tc, idx)
+		return s[:i+1] + s[i:]
+	}
+}
+
+// indents are runs of spaces only: MarshalIndent panics on anything else and
+// SetIndent turns anything else into spaces (TestHegelPinIndentMayBeAnyString),
+// and an empty indent is pinned too (TestHegelPinEmptyIndentStillBreaksLines).
+var indents = []string{" ", "  ", "    "}
+
+func short(b []byte) string {
+	s := string(b)
+	if len(s) > 300 {
+		return s[:300] + "..."
+	}
+	return s
+}
+
+var rawMessageType = reflect.TypeOf(std.RawMessage(nil))
+
+// indentUnsafe reports whether v holds a shape MarshalIndent gets wrong: a map
+// whose value is a container (map, slice, array or struct;
+// TestHegelPinMapValuesIndentNested) or a RawMessage holding a container
+// (copied verbatim instead of re-indented; TestHegelPinMarshalerOutputIsCompacted).
+// Indented output is only compared for values without either.
+func indentUnsafe(v reflect.Value) bool {
+	if v.Kind() == reflect.Slice && v.Type() == rawMessageType {
+		b := v.Bytes()
+		return len(b) > 0 && (b[0] == '[' || b[0] == '{')
+	}
+	switch v.Kind() {
+	case reflect.Interface, reflect.Pointer:
+		if v.IsNil() {
+			return false
+		}
+		return indentUnsafe(v.Elem())
+	case reflect.Map:
+		it := v.MapRange()
+		for it.Next() {
+			e := it.Value()
+			for e.Kind() == reflect.Interface || e.Kind() == reflect.Pointer {
+				if e.IsNil() {
+					break
+				}
+				e = e.Elem()
+			}
+			switch e.Kind() {
+			case reflect.Map, reflect.Slice, reflect.Array, reflect.Struct:
+				return true
+			}
+			if indentUnsafe(it.Value()) {
+				return true
+			}
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if indentUnsafe(v.Index(i)) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).IsExported() && indentUnsafe(v.Field(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// noEscape is the compatible configuration with HTML escaping turned off.
+var noEscape = jsoniter.Config{SortMapKeys: true, ValidateJsonRawMessage: true}.Froze()
+
+// diffAt shows the first difference between two texts with some context.
+func diffAt(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := i - 40
+	if lo < 0 {
+		lo = 0
+	}
+	cut := func(s string) string {
+		if lo >= len(s) {
+			return ""
+		}
+		hi := i + 60
+		if hi > len(s) {
+			hi = len(s)
+		}
+		return s[lo:hi]
+	}
+	return fmt.Sprintf("at byte %d:\n   a %q\n   b %q", i, cut(a), cut(b))
+}
+
+func stdJSON(v any) string {
+	b, err := std.Marshal(v)
+	if err != nil {
+		return "ERR:" + err.Error()
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// Marshal, MarshalIndent and Encoder produce byte-for-byte what encoding/json
+// produces, for random values from the whole universe, with and without HTML
+// escaping and indentation.
+func TestHegelMarshalMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genTop(ht)
+		note(ht, "value (%T): %s", v, short([]byte(stdJSON(v))))
+
+		g, ge := json.Marshal(v)
+		w, we := std.Marshal(v)
+		if (ge == nil) != (we == nil) {
+			fail(ht, "Marshal error mismatch: json-iterator %v, encoding/json %v", ge, we)
+		}
+		if string(g) != string(w) {
+			fail(ht, "Marshal differs %s", diffAt(string(g), string(w)))
+		}
+
+		// MarshalIndent's prefix is documented as unsupported, so it is always "".
+		indentOK := !indentUnsafe(reflect.ValueOf(v))
+		indent := pick(ht, indents)
+		if indentOK {
+			gi, gie := json.MarshalIndent(v, "", indent)
+			wi, wie := std.MarshalIndent(v, "", indent)
+			if (gie == nil) != (wie == nil) || string(gi) != string(wi) {
+				fail(ht, "MarshalIndent(%q) differs (%v, %v) %s", indent, gie, wie, diffAt(string(gi), string(wi)))
+			}
+		}
+
+		var gb, wb bytes.Buffer
+		genc, wenc := json.NewEncoder(&gb), std.NewEncoder(&wb)
+		// With HTML escaping off, today's encoding/json still escapes
+		// U+2028/U+2029 where json-iterator (and encoding/json before Go
+		// 1.25) writes them raw; neither is wrong, so escaping stays on for
+		// values containing them.
+		second := genAny(ht, 1)
+		escape := true
+		both := stdJSON(v) + stdJSON(second)
+		if !strings.Contains(both, `\u2028`) && !strings.Contains(both, `\u2029`) {
+			escape = chance(ht, 50)
+		}
+		genc.SetEscapeHTML(escape)
+		wenc.SetEscapeHTML(escape)
+		if chance(ht, 50) && indentOK && !indentUnsafe(reflect.ValueOf(second)) {
+			i := pick(ht, indents)
+			genc.SetIndent("", i)
+			wenc.SetIndent("", i)
+		}
+		for _, x := range []any{v, second} {
+			ge, we := genc.Encode(x), wenc.Encode(x)
+			if (ge == nil) != (we == nil) {
+				fail(ht, "Encoder.Encode error mismatch: json-iterator %v, encoding/json %v", ge, we)
+			}
+		}
+		if gb.String() != wb.String() {
+			fail(ht, "Encoder output differs (escapeHTML=%v) %s", escape, diffAt(gb.String(), wb.String()))
+		}
+
+		// A Config with EscapeHTML off is the package-level spelling of
+		// SetEscapeHTML(false).
+		if we == nil && !escape {
+			opt, err := noEscape.Marshal(v)
+			var ref bytes.Buffer
+			enc := std.NewEncoder(&ref)
+			enc.SetEscapeHTML(false)
+			_ = enc.Encode(v)
+			want := strings.TrimSuffix(ref.String(), "\n")
+			if err != nil || string(opt) != want {
+				fail(ht, "Marshal with EscapeHTML off differs (%v) %s", err, diffAt(string(opt), want))
+			}
+		}
+	})
+}
+
+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTree(ht, 3)
+		text := emitText(ht, tree, true)
+		note(ht, "text: %q", short([]byte(text)))
+
+		var g, w any
+		ge := json.Unmarshal([]byte(text), &g)
+		we := std.Unmarshal([]byte(text), &w)
+		if we != nil {
+			// a number outside float64 range: both must reject it
+			if ge == nil {
+				fail(ht, "json-iterator accepts a text encoding/json rejects (%v)", we)
+			}
+			return
+		}
+		if ge != nil {
+			fail(ht, "json-iterator rejects a valid text: %v", ge)
+		}
+		if !reflect.DeepEqual(g, w) {
+			fail(ht, "Unmarshal into interface{} differs:\n json-iterator %#v\n encoding/json %#v", g, w)
+		}
+
+		gd, wd := json.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+		gd.UseNumber()
+		wd.UseNumber()
+		var gn, wn any
+		ge, we = gd.Decode(&gn), wd.Decode(&wn)
+		if ge != nil || we != nil {
+			fail(ht, "UseNumber decode errors: json-iterator %v, encoding/json %v", ge, we)
+		}
+		if !reflect.DeepEqual(gn, wn) {
+			fail(ht, "UseNumber decode differs:\n json-iterator %#v\n encoding/json %#v", gn, wn)
+		}
+		// Valid is pinned for top-level numbers (TestHegelPinValidAcceptsTopLevelNumbers).
+		if _, isNum := tree.(jnum); !isNum && !json.Valid([]byte(text)) {
+			fail(ht, "Valid is false for a text Unmarshal accepted: %q", short([]byte(text)))
+		}
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (and back to the original encoding), and
+// DisallowUnknownFields rejects exactly the texts with an unknown key.
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genRich(ht)
+		canon, err := std.Marshal(v)
+		if err != nil {
+			fail(ht, "encoding/json cannot encode the generated value: %v", err)
+		}
+		tree := canonTree(ht, canon).(jobj)
+		unknown := chance(ht, 30)
+		if unknown {
+			at := n(ht, 0, len(tree))
+			tree = append(tree[:at], append(jobj{{"zz_unknown", genTree(ht, 1)}}, tree[at:]...)...)
+		}
+		if chance(ht, 20) {
+			// encoding/json matches keys case-insensitively
+			for i := range tree {
+				if chance(ht, 50) {
+					tree[i].k = strings.ToUpper(tree[i].k)
+				}
+			}
+		}
+		// Rendered without optional \u escapes: json-iterator reads `,string`
+		// numbers and integer map keys without unescaping
+		// (TestHegelPinStringOptionAndIntegerKeysAreUnescaped).
+		text := emitTextPlain(ht, tree)
+		note(ht, "canonical: %s", short(canon))
+		note(ht, "text:      %s", short([]byte(text)))
+
+		var a, b hgRich
+		ea, eb := json.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+		if eb != nil {
+			fail(ht, "encoding/json rejects its own re-rendered encoding: %v", eb)
+		}
+		if ea != nil {
+			fail(ht, "json-iterator rejects the text: %v", ea)
+		}
+		ja, jb := stdJSON(a), stdJSON(b)
+		if ja != jb {
+			fail(ht, "decoded structs differ %s\n text %q", diffAt(ja, jb), short([]byte(text)))
+		}
+		// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+		// out of the comparison with the original encoding.
+		v.R, a.R = nil, nil
+		canonNoRaw := stdJSON(v)
+		if stdJSON(a) != canonNoRaw {
+			fail(ht, "round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+		}
+
+		// The stream Decoder gets the same tree rendered again.
+		plain := emitTextPlain(ht, tree)
+		var da, db hgRich
+		gd, wd := json.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+		gd.DisallowUnknownFields()
+		wd.DisallowUnknownFields()
+		ea, eb = gd.Decode(&da), wd.Decode(&db)
+		if (eb != nil) != unknown {
+			fail(ht, "encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+		}
+		if (ea != nil) != unknown {
+			fail(ht, "json-iterator DisallowUnknownFields: unknown key present=%v but err=%v", unknown, ea)
+		}
+		da.R = nil
+		if !unknown && stdJSON(da) != canonNoRaw {
+			fail(ht, "Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+		}
+	})
+}
