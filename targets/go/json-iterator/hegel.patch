+// TestHegelMapValuesIndentNested: MarshalIndent indents a container that is a map value one
+// level deeper than its key, as encoding/json does; json-iterator puts its elements and
+// closer at the key's level (json-iterator/5).
+func TestHegelMapValuesIndentNested(t *testing.T) {
