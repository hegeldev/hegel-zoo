+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/9
+
+// hugeLits: a literal with a nonzero integer part and an exponent of 309 to 999, out of
+// float64 range (json-iterator/9); an exponent of up to 99 under HEGEL_NO_KNOWN=1.
+var hugeLits = hegel.Composite(func(tc hegel.TestCase) string {
+	return numLit{
+		neg:   hegel.Draw(tc, chance(30)),
+		whole: strconv.Itoa(hegel.Draw(tc, hegel.Integers(1, 9))) + hegel.Draw(tc, digitText(0, 5)),
+		frac:  hegel.Draw(tc, maybe(40, digitText(1, 3))),
+		exp:   hegel.Draw(tc, expMarks) + hegel.Draw(tc, hegel.SampledFrom([]string{"", "+"})) + strconv.Itoa(hegel.Draw(tc, shaped(hegel.Integers(309, 999), hegel.Integers(0, 99)))),
+	}.String()
+})
+
+// TestHegelValidAcceptsNumbersOutOfFloat64Range: Valid is about syntax and accepts a number
+// out of float64 range, as encoding/json does (whose Unmarshal into a float64 then reports
+// the range); json-iterator's Valid reports the range as invalid syntax (json-iterator/9).
+func TestHegelValidAcceptsNumbersOutOfFloat64Range(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, hegel.Map(pairs(hugeLits, inContainer), func(p pair[string, func(string) string]) string { return p.b(p.a) }))
+		validAgrees(ht, text, textShapes(text))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/10
+
+var (
+	cleanStreamValues = hegel.Composite(func(tc hegel.TestCase) streamValue {
+		return streamValue{tree: hegel.Draw(tc, cleanTrees2), tape: hegel.Draw(tc, tapes), sep: hegel.Draw(tc, separators), keepSep: hegel.Draw(tc, chance(70))}
+	})
+	// eofStreams: one to four values and then whitespace, or a bare number as the last value
+	// (json-iterator/10); under HEGEL_NO_KNOWN=1 nothing after the last value, which is not a
+	// bare number.
+	eofStreams = hegel.Composite(func(tc hegel.TestCase) streamCase {
+		c := streamCase{values: hegel.Draw(tc, many(cleanStreamValues, 1, 4)), trail: hegel.Draw(tc, shaped(maybe(70, wsRuns), hegel.Just("")))}
+		if Known.eofAtEnd {
+			last := &c.values[len(c.values)-1]
+			last.tree = wrapped(last.tree)
+		}
+		return c
+	})
+)
+
+// TestHegelDecoderReturnsEOFAtTheEnd: Decode after the last value of a stream returns io.EOF,
+// as encoding/json does, whatever whitespace follows and whatever the last value is;
+// json-iterator returns a syntax error after trailing whitespace or a bare number
+// (json-iterator/10).
+func TestHegelDecoderReturnsEOFAtTheEnd(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, eofStreams)
+		decodesLike(ht, c.text(), len(c.values), false, true, c.shapes)
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/20
+
+// TestHegelInvalidUTF8InputIsReplaced: an invalid byte inside a string of the text decodes
+// as U+FFFD, as encoding/json documents; json-iterator passes it through (json-iterator/20).
+func TestHegelInvalidUTF8InputIsReplaced(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, hegel.Map(pairs(badUTF8Strs, tapes), func(p pair[string, []int]) string { return render([]any{p.a}, p.b, false, true) }))
+		interfaceDecodesLike(ht, text, false, only(textShapes(text), 20))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/21
+
+var (
+	loneEscapes = hegel.SampledFrom([]string{"\\udc00", "\\uDFFF", "\\ud800"})
+	// pairEscapes: the surrogate pair escape of a non-BMP rune.
+	pairEscapes = hegel.Map(hegel.Integers[rune](0x10000, 0x10ffff), func(r rune) string {
+		return fmt.Sprintf("\\u%04x\\u%04x", (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00)
+	})
+	// afterLone: what follows the lone surrogate escape: a pair escape (json-iterator/21);
+	// under HEGEL_NO_KNOWN=1 a BMP escape or a plain character.
+	afterLone = shaped(pairEscapes, hegel.SampledFrom([]string{"\\u0041", "A", "\\u00e9", "\\u2028", " "}))
+	// loneTexts: a string literal holding the lone escape and what follows it between clean
+	// characters, rendered bare or inside an array with a tape.
+	loneTexts = hegel.Composite(func(tc hegel.TestCase) string {
+		lit := jraw("\"" + hegel.Draw(tc, hegel.Text().Alphabet("abc xyz1").MaxSize(3)) + hegel.Draw(tc, loneEscapes) + hegel.Draw(tc, afterLone) + hegel.Draw(tc, hegel.Text().Alphabet("abc xyz1").MaxSize(3)) + "\"")
+		return render(hegel.Draw(tc, hegel.SampledFrom([]any{lit, []any{lit}})), hegel.Draw(tc, tapes), false, true)
+	})
+)
+
+// TestHegelLoneSurrogateBeforeAPairKeepsThePair: a lone surrogate escape decodes as U+FFFD
+// and a surrogate pair escape right after it as its rune, as encoding/json does;
+// json-iterator reads the pair as two more lone surrogates (json-iterator/21).
+func TestHegelLoneSurrogateBeforeAPairKeepsThePair(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, loneTexts)
+		interfaceDecodesLike(ht, text, false, only(textShapes(text), 21))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/24
+
+// nullRawRiches: an hgRich whose RawMessage is null (json-iterator/24); [null] under
+// HEGEL_NO_KNOWN=1.
+var nullRawRiches = hegel.Map(riches, func(r hgRich) hgRich {
+	r.R = std.RawMessage(shaped("null", "[null]"))
+	return r
+})
+
+// TestHegelNullIntoRawMessageKeepsTheLiteral: null into a RawMessage field stores the bytes
+// null, as encoding/json does, so the field is written again; json-iterator stores nil, and
+// omitempty then drops the field (json-iterator/24).
+func TestHegelNullIntoRawMessageKeepsTheLiteral(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		structDecodesLike(ht, hegel.Draw(ht, structCasesOf(nullRawRiches, tapes, false)))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/30
+
+var (
+	// noRawRiches: an hgRich without a RawMessage (json-iterator/24 is judged above).
+	noRawRiches = hegel.Map(riches, func(r hgRich) hgRich {
+		r.R = nil
+		return r
+	})
+	// escapeTapes: a tape whose every coin comes up heads, so that every optional escape is
+	// written (the digits of the `,string` numbers and the integer keys among them,
+	// json-iterator/30).
+	escapeTapes = many(hegel.Integers(88, 99), 1, 100)
+)
+
+// TestHegelStringOptionAndIntegerKeysAreUnescaped: a `,string` number and an integer map key
+// are read after unescaping, as encoding/json does; json-iterator reads the digits out of the
+// quoted text and fails at a \u escape (json-iterator/30).
+func TestHegelStringOptionAndIntegerKeysAreUnescaped(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		structDecodesLike(ht, hegel.Draw(ht, structCasesOf(noRawRiches, escapeTapes, shaped(true, false))))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/31
+
+// negativeZeroLits: a negative number with leading zeros or without an integer digit
+// (json-iterator/31); under HEGEL_NO_KNOWN=1 -0, -0.d or -d.
+var negativeZeroLits = shaped(
+	weighted(
+		choice[string]{1, hegel.Map(pairs(digitText(1, 2), maybe(40, digitText(1, 3))), func(p pair[string, string]) string {
+			if p.b != "" {
+				return "-0" + p.a + "." + p.b
+			}
+			return "-0" + p.a
+		})},
+		choice[string]{1, hegel.Map(digitText(1, 3), func(d string) string { return "-." + d })},
+	),
+	weighted(
+		choice[string]{1, hegel.Just("-0")},
+		choice[string]{1, hegel.Map(digitText(1, 3), func(d string) string { return "-0." + d })},
+		choice[string]{1, hegel.Map(hegel.Integers(1, 9), func(d int) string { return "-" + strconv.Itoa(d) })},
+	),
+)
+
+// TestHegelValidRejectsNegativeLeadingZeros: a negative number with leading zeros or no
+// integer digit is invalid, so Valid rejects it as encoding/json (and json-iterator's own
+// Unmarshal) does; json-iterator's Valid accepts it inside a container (json-iterator/31).
+func TestHegelValidRejectsNegativeLeadingZeros(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, hegel.Map(pairs(negativeZeroLits, inContainer), func(p pair[string, func(string) string]) string { return p.b(p.a) }))
+		validAgrees(ht, text, textShapes(text))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/32
+
+var (
+	escapeTexts = hegel.SampledFrom([]string{"\\n", "\\u0041", "\\\"", "\\\\", "\\/", "\\t"})
+	// controlAfter: a raw control character after the escape (json-iterator/32); its \u escape
+	// under HEGEL_NO_KNOWN=1.
+	controlAfter = hegel.Map(hegel.Integers(0, 0x1f), func(b int) string {
+		return shaped(string(rune(b)), fmt.Sprintf("\\u%04x", b))
+	})
+	// controlTexts: a string literal with an escape and then the control character between
+	// clean characters, rendered bare or inside an array with a tape.
+	controlTexts = hegel.Composite(func(tc hegel.TestCase) string {
+		lit := jraw("\"" + hegel.Draw(tc, hegel.Text().Alphabet("abc xyz1").MaxSize(3)) + hegel.Draw(tc, escapeTexts) + hegel.Draw(tc, controlAfter) + hegel.Draw(tc, hegel.Text().Alphabet("abc xyz1").MaxSize(3)) + "\"")
+		return render(hegel.Draw(tc, hegel.SampledFrom([]any{lit, []any{lit}})), hegel.Draw(tc, tapes), false, true)
+	})
+)
+
+// TestHegelRawControlCharactersAfterAnEscapeAreRejected: a string holding a raw U+0000-U+001F
+// is invalid JSON whatever else it holds, so Valid and Unmarshal reject it as encoding/json
+// does; json-iterator's slow path, taken once the string holds an escape, copies the raw byte
+// through (json-iterator/32).
+func TestHegelRawControlCharactersAfterAnEscapeAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, controlTexts)
+		validAgrees(ht, text, textShapes(text))
+	})
+}
