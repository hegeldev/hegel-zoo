+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/16
+
+// shortEscapeStrs: a clean string with U+0008 or U+000C spliced in; \n, \r or \t under
+// HEGEL_NO_KNOWN=1.
+var shortEscapeStrs = spliced(cleanStrs, shaped(hegel.SampledFrom([]string{"\b", "\f"}), hegel.SampledFrom([]string{"\n", "\r", "\t"})))
+
+// TestHegelBackspaceAndFormFeedUseShortEscapes: Marshal writes U+0008 and U+000C as \b and
+// \f, as encoding/json does since Go 1.22; json-iterator writes \u0008 and \u000c
+// (json-iterator/16).
+func TestHegelBackspaceAndFormFeedUseShortEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		strs := asAny(hegel.Map(shortEscapeStrs, func(s string) hgStr { return hgStr{s} }))
