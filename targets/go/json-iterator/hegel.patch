+	})
+}
+
+// --------------------------------------------------------------------------- texts
+
+// wrapped puts a top-level number or null inside an array (their own shapes, json-iterator/7
+// and /24, are judged by their own properties).
+func wrapped(tree any) any {
+	if _, isNum := tree.(jnum); isNum || tree == nil {
+		return []any{tree}
+	}
+	return tree
+}
+
+// cleanTexts: a clean tree of two levels rendered with a tape, without trailing whitespace.
+var cleanTexts = hegel.Map(pairs(cleanTrees2, tapes), func(p pair[any, []int]) string { return render(wrapped(p.a), p.b, false, false) })
+
+// --------------------------------------------------------------------------- json-iterator/6
+
+// trailingTails: more than whitespace after a complete value (json-iterator/6); whitespace or
+// nothing under HEGEL_NO_KNOWN=1.
+var trailingTails = shaped(
+	hegel.SampledFrom([]string{" x", "]", "}", " 2", "true", "{}", ",", "\"\"", "\x00"}),
+	hegel.SampledFrom([]string{"", " ", "\n", "\t\r"}),
+)
+
+// TestHegelValidRejectsTrailingBytes: a text with anything but whitespace after its value is
+// invalid, so Valid rejects it as encoding/json (and json-iterator's own Unmarshal) does;
+// json-iterator's Valid checks only the first value (json-iterator/6).
+func TestHegelValidRejectsTrailingBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, hegel.Map(pairs(cleanTexts, trailingTails), func(p pair[string, string]) string { return p.a + p.b }))
+		validAgrees(ht, text, textShapes(text))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/7
+
+// topNumberTexts: a number literal at the top level (json-iterator/7), rendered with a tape
+// (whitespace around it, after which json-iterator's Valid does accept it, so a case shrinks
+// to the bare literal); inside an array under HEGEL_NO_KNOWN=1.
+var topNumberTexts = hegel.Map(pairs(jnums, tapes), func(p pair[jnum, []int]) string {
+	return render(shaped[any](p.a, []any{p.a}), p.b, false, true)
+})
+
+// TestHegelValidAcceptsTopLevelNumbers: Valid accepts a top-level number that Unmarshal
+// decodes, as encoding/json does; json-iterator's Valid rejects it (json-iterator/7).
+func TestHegelValidAcceptsTopLevelNumbers(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, topNumberTexts)
+		interfaceDecodesLike(ht, text, false, only(textShapes(text), 7))
+	})
+}
+
+// --------------------------------------------------------------------------- json-iterator/8
+
+// smallMantissaLits: a 0.-mantissa literal with a nonzero fraction and an exponent of 40 to
+// 99, above float32 range (json-iterator/8); an exponent at or below 38 under HEGEL_NO_KNOWN=1.
+var smallMantissaLits = hegel.Composite(func(tc hegel.TestCase) string {
+	return numLit{
+		neg:   hegel.Draw(tc, chance(30)),
+		whole: "0",
+		frac:  hegel.Draw(tc, hegel.Text().Alphabet("123456789").MinSize(1).MaxSize(1)) + hegel.Draw(tc, digitText(0, 5)),
+		exp:   hegel.Draw(tc, expMarks) + hegel.Draw(tc, hegel.SampledFrom([]string{"", "+"})) + strconv.Itoa(hegel.Draw(tc, shaped(hegel.Integers(40, 99), hegel.Integers(0, 38)))),
+	}.String()
+})
+
+// inContainer puts a literal inside an array or an object (json-iterator's Valid rejects
+// every bare top-level number, json-iterator/7).
+var inContainer = hegel.SampledFrom([]func(string) string{
+	func(s string) string { return "[" + s + "]" },
+	func(s string) string { return "{\"a\":" + s + "}" },
+	func(s string) string { return "[1, " + s + "]" },
+})
+
+// TestHegelValidAcceptsSmallMantissaLargeExponent: Valid accepts an in-range number whose
+// integer part is 0 and whose value passes float32 range, as encoding/json does and as
+// Unmarshal decodes it; json-iterator's Valid rejects it (json-iterator/8).
+func TestHegelValidAcceptsSmallMantissaLargeExponent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, hegel.Map(pairs(smallMantissaLits, inContainer), func(p pair[string, func(string) string]) string { return p.b(p.a) }))
