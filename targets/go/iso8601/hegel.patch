+// ---- pins: one plain test per recorded bug --------------------------------------------------
+
+// iso8601/1: a leading Z is skipped like a leading +.
+func TestHegelPinLeadingZIsRejected(t *testing.T) {
+	if got, err := iso8601.ParseString("Z2020-01-02T03:04:05Z"); err == nil {
+		t.Fatalf("ParseString(\"Z2020-01-02T03:04:05Z\") = %s, want an error", got)
+	}
+}
+
+// iso8601/2: ParseISOZone accepts offsets that are not +-hh, +-hhmm or +-hh:mm, and hours or
+// minutes out of range.
+func TestHegelPinMalformedZonesAreRejected(t *testing.T) {
+	for _, z := range []string{"+013", "+01:3", "+01:", "+25:00", "+01:60", "+99:99"} {
+		if loc, err := iso8601.ParseISOZone([]byte(z)); err == nil {
+			_, off := time.Date(2020, 1, 1, 0, 0, 0, 0, loc).Zone()
+			t.Errorf("ParseISOZone(%q) = offset %d, want an error", z, off)
+		}
+	}
+	if got, err := iso8601.ParseString("2020-01-02T03:04:05+25:99"); err == nil {
+		t.Errorf("ParseString(\"2020-01-02T03:04:05+25:99\") = %s, want an error", got)
+	}
+}
+
+// iso8601/3: more than nine fraction digits are only refused when the digits' value reaches 1e9;
+// with leading zeros they are taken as nanoseconds unscaled.
+func TestHegelPinDeepFractionsAreNotMisread(t *testing.T) {
+	got, err := iso8601.ParseString("2020-01-02T03:04:05.0000000005Z")
+	if err == nil && got.Nanosecond() != 0 {
+		t.Fatalf("ParseString(\"2020-01-02T03:04:05.0000000005Z\") = %s (%d ns), want 0 ns or an error", got.Format(time.RFC3339Nano), got.Nanosecond())
+	}
+	got, err = iso8601.ParseString("2020-01-02T03:04:05.00000000012Z")
+	if err == nil && got.Nanosecond() != 0 {
+		t.Fatalf("ParseString(\"2020-01-02T03:04:05.00000000012Z\") = %s (%d ns), want 0 ns or an error", got.Format(time.RFC3339Nano), got.Nanosecond())
+	}
+}
+
+// iso8601/4: the year-only form "0000" fails with a month range error, while "0000-01" parses.
+func TestHegelPinYearZeroAloneParses(t *testing.T) {
+	want, err := iso8601.ParseString("0000-01")
+	if err != nil {
+		t.Skipf("0000-01 is refused too: %v", err)
+	}
+	got, err := iso8601.ParseString("0000")
+	if err != nil || !got.Equal(want) {
+		t.Fatalf("ParseString(\"0000\") = %s, %v; \"0000-01\" gives %s", got, err, want)
+	}
+}
+
+// iso8601/5: Time.UnmarshalJSON's null test uses && where it needs ||, so any 4-byte value sharing
+// a byte with "null" in the same position is treated as null.
+func TestHegelPinShortStringsAreNotNull(t *testing.T) {
+	for _, raw := range []string{`"1l"`, `"u2"`, `"ab"`} {
+		var w iso8601.Time
+		w.Time = time.Date(1999, 12, 31, 0, 0, 0, 0, time.UTC)
+		err := json.Unmarshal([]byte(raw), &w)
+		if err == nil {
+			t.Errorf("json.Unmarshal(%s) into iso8601.Time succeeded and left %s, want a parse error", raw, w.Time)
+		}
+	}
+}
