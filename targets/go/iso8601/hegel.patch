+// Hegel property tests for github.com/relvacode/iso8601: a model of the grammar the parser
+// documents (ISO 8601 calendar and ordinal dates, times with fractions, Z and +-hh[:mm] zones,
+// with the parser's lenient digit counts) built from generated components, so every accepted
+// input must yield exactly the time its digits spell and every malformed input must be refused;
+// Go's time.Parse on the RFC 3339 subset; encoding/json for the JSON wrapper.
+package iso8601_test
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relvacode/iso8601"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func count(ht *hegel.T, what string) { ht.Note(what) }
+
+// Known bugs, gated so the properties pass while the pins fail (see bugs.toml).
+var known = struct {
+	leadingZ      bool // iso8601/1: a leading Z is skipped like a leading +
+	looseZone     bool // iso8601/2: ParseISOZone accepts malformed and out-of-range offsets
+	deepFraction  bool // iso8601/3: more than 9 fraction digits with leading zeros are not scaled
+	yearZeroAlone bool // iso8601/4: "0000" fails with a month range error
+	fourByteNull  bool // iso8601/5: UnmarshalJSON treats any 4-byte value sharing a byte with null as null
+}{true, true, true, true, true}
+
+// ---- the model -----------------------------------------------------------------------------
+
+// spec is a generated date-time and the string spelling it.
+type spec struct {
+	text    string
+	year    int
+	month   int // 0 for an ordinal date
+	day     int // day of month, or day of year for an ordinal date
+	ordinal bool
+	hasTime bool
+	hour    int
+	min     int
+	sec     int
+	nanos   int
+	zone    int // -1 none, 0 Z, 1 offset
+	offset  int // seconds east of UTC
+}
+
+func (s spec) want(loc *time.Location) time.Time {
+	switch s.zone {
+	case 0:
+		loc = time.UTC
+	case 1:
+		loc = time.FixedZone("", s.offset)
+	}
+	if s.ordinal {
+		return time.Date(s.year, 1, s.day, s.hour, s.min, s.sec, s.nanos, loc)
+	}
+	return time.Date(s.year, time.Month(s.month), s.day, s.hour, s.min, s.sec, s.nanos, loc)
+}
+
+func isLeap(y int) bool { return y%4 == 0 && (y%100 != 0 || y%400 == 0) }
+
+func daysIn(m, y int) int {
+	switch m {
+	case 2:
+		if isLeap(y) {
+			return 29
+		}
+		return 28
+	case 4, 6, 9, 11:
+		return 30
+	}
+	return 31
+}
+
+func daysInYear(y int) int {
+	if isLeap(y) {
+		return 366
+	}
+	return 365
+}
+
+func digits(tc hegel.TestCase, v, width int) string {
+	s := strconv.Itoa(v)
+	for len(s) < width {
+		s = "0" + s
+	}
+	return s
+}
+
+// genSpec draws a valid date-time (mostly canonical ISO 8601, sometimes with the parser's
+// lenient digit counts).
+func genSpec(tc hegel.TestCase) spec {
+	var s spec
+	s.year = pick(tc, []int{n(tc, 1, 9999), n(tc, 1900, 2100), 2000, 2024, 1970, 9999, 1, n(tc, 0, 99)})
+	var b strings.Builder
+	if chance(tc, 5) {
+		b.WriteByte('+')
+	}
+	lenient := chance(tc, 10)
+	yw := 4
+	if lenient {
+		yw = n(tc, 1, 6)
+	}
+	b.WriteString(digits(tc, s.year, yw))
+	form := n(tc, 0, 3) // 0 year, 1 year-month, 2 full date, 3 ordinal
+	switch form {
+	case 0:
+		s.month, s.day = 1, 1
+	case 1:
+		s.month, s.day = n(tc, 1, 12), 1
+		b.WriteString("-" + digits(tc, s.month, 2))
+	case 2:
+		s.month = n(tc, 1, 12)
+		s.day = n(tc, 1, daysIn(s.month, s.year))
+		mw, dw := 2, 2
+		if lenient {
+			mw, dw = n(tc, 1, 2), n(tc, 1, 2)
+		}
+		b.WriteString("-" + digits(tc, s.month, mw) + "-" + digits(tc, s.day, dw))
+	case 3:
+		s.ordinal = true
+		s.day = n(tc, 1, daysInYear(s.year))
+		b.WriteString("-" + digits(tc, s.day, 3))
+	}
+	if form >= 2 && chance(tc, 80) {
+		s.hasTime = true
+		if chance(tc, 85) {
+			b.WriteByte('T')
+		} else {
+			b.WriteByte(' ')
+		}
+		s.hour = n(tc, 0, 23)
+		hw := 2
+		if lenient {
+			hw = n(tc, 1, 2)
+		}
+		b.WriteString(digits(tc, s.hour, hw))
+		parts := n(tc, 0, 3) // 0 hour only, 1 +minutes, 2 +seconds, 3 +fraction
+		if parts >= 1 {
+			s.min = n(tc, 0, 59)
+			b.WriteString(":" + digits(tc, s.min, 2))
+		}
+		if parts >= 2 {
+			s.sec = n(tc, 0, 59)
+			b.WriteString(":" + digits(tc, s.sec, 2))
+		}
+		if parts >= 3 {
+			nd := n(tc, 1, 9)
+			frac := n(tc, 0, 9)
+			if chance(tc, 50) {
+				frac = 0
+			}
+			fs := digits(tc, frac, 1)
+			for len(fs) < nd {
+				if chance(tc, 50) {
+					fs = "0" + fs
+				} else {
+					fs += strconv.Itoa(n(tc, 0, 9))
+				}
+			}
+			fs = fs[:nd]
+			b.WriteString("." + fs)
+			v, _ := strconv.Atoi(fs)
+			for i := nd; i < 9; i++ {
+				v *= 10
+			}
+			s.nanos = v
+		}
+	}
+	s.zone = -1
+	if s.hasTime && chance(tc, 70) {
+		switch n(tc, 0, 3) {
+		case 0:
+			s.zone = 0
+			b.WriteByte('Z')
+		default:
+			s.zone = 1
+			hh := n(tc, 0, 23)
+			mm := pick(tc, []int{0, 0, 30, 45, n(tc, 0, 59)})
+			neg := chance(tc, 50)
+			if hh == 0 && mm == 0 {
+				neg = false // -00:00 is not a valid ISO 8601 zone
+			}
+			s.offset = hh*3600 + mm*60
+			if neg {
+				s.offset = -s.offset
+				b.WriteByte('-')
+			} else {
+				b.WriteByte('+')
+			}
+			switch n(tc, 0, 2) {
+			case 0:
+				b.WriteString(digits(tc, hh, 2))
+				if mm != 0 {
+					b.WriteString(":" + digits(tc, mm, 2))
+				}
+			case 1:
+				b.WriteString(digits(tc, hh, 2) + digits(tc, mm, 2))
+			default:
+				b.WriteString(digits(tc, hh, 2) + ":" + digits(tc, mm, 2))
+			}
+		}
+	}
+	s.text = b.String()
+	return s
+}
+
+// modelParse is the reference parser: it returns the time the input spells in loc, or a
+// description of why the input is malformed ("syntax", or "range:<element>:<given>:<min>:<max>").
+func modelParse(in string, loc *time.Location) (time.Time, string) {
+	i := 0
+	if i < len(in) && in[i] == '+' {
+		i++
+	}
+	num := func() (int, int, bool) { // value, digit count, overflow-free
+		start := i
+		v := 0
+		for i < len(in) && in[i] >= '0' && in[i] <= '9' {
+			if v < 1e9 {
+				v = v*10 + int(in[i]-'0')
+			}
+			i++
+		}
+		return v, i - start, v < 1e9
+	}
+	year, yn, _ := num()
+	if yn == 0 {
+		if i == len(in) {
+			// nothing at all: the parser reports the unset month
+			return time.Time{}, "range:month:0:1:12"
+		}
+		return time.Time{}, "syntax"
+	}
+	month, day := 1, 1
+	ordinal := false
+	haveDay := false
+	if i < len(in) && in[i] == '-' {
+		i++
+		v, k, _ := num()
+		if k == 0 {
+			if i == len(in) {
+				return time.Time{}, "range:month:0:1:12" // "2020-": the month stays 0
+			}
+			return time.Time{}, "syntax"
+		}
+		if k == 3 && !(i < len(in) && in[i] == '-') {
+			// three digits not followed by a day are an ordinal day of the year
+			ordinal = true
+			day = v
+		} else {
+			month = v
+			if i < len(in) && in[i] == '-' {
+				i++
+				v, k, _ := num()
+				if k == 0 && !(i == len(in) || in[i] == 'T' || in[i] == ' ') {
+					return time.Time{}, "syntax"
+				}
+				// "2020-01-" or "2020-01-T1": the day stays 0 and the range check reports it
+				day = v
+				haveDay = true
+			}
+		}
+	}
+	hour, min, sec, nanos := 0, 0, 0, 0
+	fracTooLong := false
+	hasTime := false
+	if i < len(in) && (in[i] == 'T' || in[i] == ' ') {
+		if !ordinal && !haveDay {
+			return time.Time{}, "syntax"
+		}
+		hasTime = true
+		i++
+		var hn int
+		hour, hn, _ = num() // an empty trailing component reads as 0 (the parser's lenience)
+		if hn == 0 && i < len(in) && in[i] == ':' {
+			return time.Time{}, "syntax"
+		}
+		if i < len(in) && in[i] == ':' {
+			i++
+			var k int
+			min, k, _ = num()
+			if k == 0 && i < len(in) && in[i] == ':' {
+				return time.Time{}, "syntax"
+			}
+			if i < len(in) && in[i] == ':' {
+				i++
+				sec, k, _ = num()
+				if i < len(in) && in[i] == '.' {
+					if k == 0 {
+						return time.Time{}, "syntax"
+					}
+					i++
+					start := i
+					v, fn, _ := num() // an empty fraction reads as 0 (lenience)
+					if fn > 9 {
+						fracTooLong = true
+					} else {
+						for j := fn; j < 9; j++ {
+							v *= 10
+						}
+						nanos = v
+					}
+					_ = start
+				}
+			}
+		}
+	} else if i < len(in) && in[i] == '.' {
+		return time.Time{}, "syntax"
+	}
+	// zone
+	if i < len(in) {
+		if in[i] == 'Z' {
+			if !hasTime && !ordinal {
+				return time.Time{}, "syntax"
+			}
+			i++
+			if i != len(in) {
+				return time.Time{}, "syntax"
+			}
+			loc = time.UTC
+		} else if in[i] == '+' || in[i] == '-' {
+			if !hasTime && !ordinal {
+				return time.Time{}, "syntax" // a zone needs a time (or, the parser's quirk, an ordinal date)
+			}
+			off, ok := modelZone(in[i:])
+			if !ok {
+				return time.Time{}, "syntax:zone:" + in[i:]
+			}
+			loc = time.FixedZone("", off)
+			i = len(in)
+		} else {
+			return time.Time{}, "syntax"
+		}
+	}
+	if fracTooLong {
+		return time.Time{}, "syntax"
+	}
+	rng := func(el string, given, lo, hi int) string {
+		return fmt.Sprintf("range:%s:%d:%d:%d", el, given, lo, hi)
+	}
+	switch {
+	case !ordinal && (month < 1 || month > 12):
+		return time.Time{}, rng("month", month, 1, 12)
+	case ordinal && (day < 1 || day > daysInYear(year)):
+		return time.Time{}, rng("day", day, 1, daysInYear(year))
+	case !ordinal && (day < 1 || day > daysIn(month, year)):
+		return time.Time{}, rng("day", day, 1, daysIn(month, year))
+	case hour > 23:
+		return time.Time{}, rng("hour", hour, 0, 23)
+	case min > 59:
+		return time.Time{}, rng("minute", min, 0, 59)
+	case sec > 59:
+		return time.Time{}, rng("second", sec, 0, 59)
+	}
+	if ordinal {
+		return time.Date(year, 1, day, hour, min, sec, nanos, loc), ""
+	}
+	return time.Date(year, time.Month(month), day, hour, min, sec, nanos, loc), ""
+}
+
+// modelZone parses Z, z, +hh, +hhmm, +hh:mm (and the - forms) with hh in 0..23, mm in 0..59,
+// -00, -0000 and -00:00 refused.
+func modelZone(z string) (int, bool) {
+	if z == "Z" || z == "z" {
+		return 0, true
+	}
+	if len(z) < 3 || (z[0] != '+' && z[0] != '-') {
+		return 0, false
+	}
+	rest := z[1:]
+	var hh, mm string
+	switch len(rest) {
+	case 2:
+		hh = rest
+	case 4:
+		hh, mm = rest[:2], rest[2:]
+	case 5:
+		if rest[2] != ':' {
+			return 0, false
+		}
+		hh, mm = rest[:2], rest[3:]
+	default:
+		return 0, false
+	}
+	h, err1 := strconv.Atoi(hh)
+	m := 0
+	var err2 error
+	if mm != "" {
+		m, err2 = strconv.Atoi(mm)
+	}
+	if err1 != nil || err2 != nil || !allDigits(hh) || (mm != "" && !allDigits(mm)) || h > 23 || m > 59 {
+		return 0, false
+	}
+	off := h*3600 + m*60
+	if z[0] == '-' {
+		if off == 0 {
+			return 0, false
+		}
+		off = -off
+	}
+	return off, true
+}
+
+func allDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return len(s) > 0
+}
+
+func same(a, b time.Time) bool {
+	if !a.Equal(b) {
+		return false
+	}
+	_, oa := a.Zone()
+	_, ob := b.Zone()
+	return oa == ob
+}
+
+func show(t time.Time) string {
+	return t.Format("2006-01-02T15:04:05.999999999Z07:00")
+}
+
+// mutate applies one random edit to a valid string.
+func mutate(tc hegel.TestCase, s string) string {
+	pool := "0123456789-:T .Z+z/,;Tt0"
+	if len(s) == 0 {
+		return string(pool[n(tc, 0, len(pool)-1)])
+	}
+	switch n(tc, 0, 4) {
+	case 0: // replace
+		i := n(tc, 0, len(s)-1)
+		return s[:i] + string(pool[n(tc, 0, len(pool)-1)]) + s[i+1:]
+	case 1: // insert
+		i := n(tc, 0, len(s))
+		return s[:i] + string(pool[n(tc, 0, len(pool)-1)]) + s[i:]
+	case 2: // delete
+		i := n(tc, 0, len(s)-1)
+		return s[:i] + s[i+1:]
+	case 3: // truncate
+		return s[:n(tc, 0, len(s))]
+	default: // append a zone or digits
+		return s + pick(tc, []string{"Z", "+01:00", "-05", "0", "00", ":00", ".5", "T10", "+0130", "+013", "+01:3", "+25:00", "+01:60", "-00:00", "z", "+01:", "Zz"})
+	}
+}
+
+// ---- 1. valid inputs parse to their components ----------------------------------------------
+
+func TestHegelValidDatesParseToTheirComponents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s := genSpec(tc)
+		locs := []*time.Location{time.UTC, time.FixedZone("plus3", 3*3600), time.FixedZone("minus7h30", -(7*3600 + 1800))}
+		loc := pick(tc, locs)
+		want := s.want(loc)
+		got, err := iso8601.ParseInLocation([]byte(s.text), loc)
+		if err != nil {
+			if known.yearZeroAlone && strings.Trim(strings.TrimPrefix(s.text, "+"), "0") == "" {
+				count(ht, "known iso8601/4 (year zero alone)")
+				return
+			}
+			ht.Fatalf("ParseInLocation(%q) failed: %v (want %s)", s.text, err, show(want))
+		}
+		if !same(got, want) {
+			ht.Fatalf("ParseInLocation(%q, %s) = %s, want %s", s.text, loc, show(got), show(want))
+		}
+		if s.zone == -1 && got.Location() != loc {
+			ht.Fatalf("ParseInLocation(%q, %s) returned location %s", s.text, loc, got.Location())
+		}
+		// the four entry points agree
+		g2, err2 := iso8601.ParseStringInLocation(s.text, loc)
+		g3, err3 := iso8601.Parse([]byte(s.text))
+		g4, err4 := iso8601.ParseString(s.text)
+		if err2 != nil || err3 != nil || err4 != nil || !same(g2, got) || !same(g3, s.want(time.UTC)) || !same(g4, g3) {
+			ht.Fatalf("the entry points disagree on %q: %s %v / %s %v / %s %v / %s %v", s.text, show(got), err, show(g2), err2, show(g3), err3, show(g4), err4)
+		}
+		// Go's own formats round-trip through the parser
+		for _, layout := range []string{time.RFC3339Nano, "2006-01-02T15:04:05.999999999Z07:00", "2006-01-02T15:04:05.999999999"} {
+			text := got.Format(layout)
+			back, err := iso8601.ParseInLocation([]byte(text), got.Location())
+			if err != nil || !same(back, got) {
+				ht.Fatalf("re-parsing %q (from %q, layout %q) gives %s, %v", text, s.text, layout, show(back), err)
+			}
+		}
+		// the JSON wrapper parses the quoted string
+		var w iso8601.Time
+		if err := json.Unmarshal([]byte(strconv.Quote(s.text)), &w); err != nil || !same(w.Time, s.want(time.UTC)) {
+			ht.Fatalf("json.Unmarshal(%q) into iso8601.Time gives %s, %v", s.text, show(w.Time), err)
+		}
+		count(ht, fmt.Sprintf("form: ordinal=%v time=%v zone=%d", s.ordinal, s.hasTime, s.zone))
+	})
+}
+
+// ---- 2. the model decides acceptance and value ---------------------------------------------
+
+func TestHegelParserFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s := genSpec(tc).text
+		edits := n(tc, 0, 3)
+		for i := 0; i < edits; i++ {
+			s = mutate(tc, s)
+		}
+		if len(s) > 40 {
+			return
+		}
+		loc := pick(tc, []*time.Location{time.UTC, time.FixedZone("plus3", 3*3600)})
+		want, why := modelParse(s, loc)
+		got, err := iso8601.ParseInLocation([]byte(s), loc)
+		// known deviations
+		if known.leadingZ && strings.HasPrefix(s, "Z") {
+			count(ht, "known iso8601/1 (leading Z)")
+			return
+		}
+		if known.looseZone && strings.HasPrefix(why, "syntax:zone:") {
+			if _, zerr := iso8601.ParseISOZone([]byte(strings.TrimPrefix(why, "syntax:zone:"))); zerr == nil {
+				count(ht, "known iso8601/2 (loose zone)")
+				return
+			}
+			why = "syntax"
+		}
+		if known.deepFraction && why == "syntax" && err == nil {
+			if j := strings.Index(s, "."); j >= 0 {
+				k := j + 1
+				for k < len(s) && s[k] >= '0' && s[k] <= '9' {
+					k++
+				}
+				if k-j-1 > 9 {
+					count(ht, "known iso8601/3 (deep fraction)")
+					return
+				}
+			}
+		}
+		if known.yearZeroAlone && why == "" && err != nil && strings.Trim(strings.TrimPrefix(s, "+"), "0") == "" {
+			count(ht, "known iso8601/4 (year zero alone)")
+			return
+		}
+		switch {
+		case why == "" && err != nil:
+			ht.Fatalf("Parse(%q) failed with %v; the model gives %s", s, err, show(want))
+		case why == "" && err == nil:
+			if !same(got, want) {
+				ht.Fatalf("Parse(%q) = %s, the model gives %s", s, show(got), show(want))
+			}
+			count(ht, "accepted")
+		case why != "" && err == nil:
+			ht.Fatalf("Parse(%q) = %s, the model refuses it (%s)", s, show(got), why)
+		default:
+			var re *iso8601.RangeError
+			if strings.HasPrefix(why, "range:") {
+				if !errors.As(err, &re) {
+					ht.Fatalf("Parse(%q) failed with %v (%T), the model expects a RangeError (%s)", s, err, err, why)
+				}
+				parts := strings.Split(why, ":")
+				given, _ := strconv.Atoi(parts[2])
+				lo, _ := strconv.Atoi(parts[3])
+				hi, _ := strconv.Atoi(parts[4])
+				if re.Element != parts[1] || re.Given != given || re.Min != lo || re.Max != hi || re.Value != s {
+					ht.Fatalf("Parse(%q) RangeError %+v, the model expects %s", s, *re, why)
+				}
+				count(ht, "range error")
+			} else {
+				if errors.As(err, &re) {
+					ht.Fatalf("Parse(%q) failed with a RangeError %v, the model expects a syntax error", s, err)
+				}
+				count(ht, "syntax error")
+			}
+		}
+	})
+}
