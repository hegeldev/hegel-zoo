+// ---- 4. JSON --------------------------------------------------------------------------------
+
+func TestHegelJsonWrapperFollowsEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		var raw string
+		kind := n(tc, 0, 5)
+		switch kind {
+		case 0:
+			raw = "null"
+		case 1:
+			raw = strconv.Quote(genSpec(tc).text)
+		case 2:
+			s := genSpec(tc).text
+			for i := 0; i < n(tc, 1, 3); i++ {
+				s = mutate(tc, s)
+			}
+			raw = strconv.Quote(s)
+		case 3:
+			raw = pick(tc, []string{"true", "false", "1234", "12.5", "-1", "{}", "[]", `{"a":1}`, "[1]", "1e10", "0"})
+		case 4: // short strings
+			pool := "nul0123456789-:TZ+ .abcdefghijklmnopqrstuvwxyz"
+			k := n(tc, 0, 5)
+			var b strings.Builder
+			for i := 0; i < k; i++ {
+				b.WriteByte(pool[n(tc, 0, len(pool)-1)])
+			}
+			raw = strconv.Quote(b.String())
+		default:
+			raw = strconv.Quote(pick(tc, []string{"2020-01-02", "2020-01-02T10:20:30Z", "", " ", "null", "nu", "2020"}))
+		}
+		if known.fourByteNull && len(raw) == 4 && raw != "null" && (raw[0] == 'n' || raw[1] == 'u' || raw[2] == 'l' || raw[3] == 'l') {
+			count(ht, "known iso8601/5 (four-byte null)")
+			return
+		}
+		doc := `{"t":` + raw + `,"p":` + raw + `}`
+		var got struct {
+			T iso8601.Time  `json:"t"`
+			P *iso8601.Time `json:"p"`
+		}
+		sentinel := time.Date(1999, 12, 31, 23, 59, 59, 0, time.UTC)
+		got.T.Time = sentinel
+		err := json.Unmarshal([]byte(doc), &got)
+		// the model: null leaves the value alone (and nils the pointer); a string parses; anything
+		// else is ErrNotString
+		var wantErr error
+		var want time.Time
+		switch {
+		case raw == "null":
+			want = sentinel
+		case raw[0] == '"':
+			var s string
+			if e := json.Unmarshal([]byte(raw), &s); e != nil {
+				return
+			}
+			want, wantErr = iso8601.Parse([]byte(s))
+		default:
+			wantErr = iso8601.ErrNotString
+		}
+		if (err == nil) != (wantErr == nil) {
+			ht.Fatalf("json.Unmarshal(%s) gives %v, the model expects %v", doc, err, wantErr)
+		}
+		if wantErr != nil {
+			if wantErr == iso8601.ErrNotString && !errors.Is(err, iso8601.ErrNotString) {
+				ht.Fatalf("json.Unmarshal(%s) gives %v, want ErrNotString", doc, err)
+			}
+			count(ht, "error")
+			return
+		}
+		if !same(got.T.Time, want) {
+			ht.Fatalf("json.Unmarshal(%s) sets t = %s, want %s", doc, show(got.T.Time), show(want))
+		}
+		if raw == "null" {
+			if got.P != nil {
+				ht.Fatalf("json.Unmarshal(%s) left the pointer non-nil", doc)
+			}
+			count(ht, "null")
+		} else if got.P == nil || !same(got.P.Time, want) {
+			ht.Fatalf("json.Unmarshal(%s) sets p = %v, want %s", doc, got.P, show(want))
+		}
+		// Marshal of the wrapper is time.Time's RFC 3339 form and re-parses to the same instant
+		_, off := want.Zone()
+		if known.looseZone && (off <= -24*3600 || off >= 24*3600) {
+			count(ht, "known iso8601/2 (loose zone)") // an offset time.Time cannot marshal
+			return
+		}
+		if raw != "null" && want.Year() >= 1 && want.Year() <= 9999 {
+			out, err := json.Marshal(got.T)
+			if err != nil {
+				ht.Fatalf("json.Marshal of the parsed %s: %v", show(want), err)
+			}
+			var back iso8601.Time
+			if err := json.Unmarshal(out, &back); err != nil || !back.Time.Equal(want) {
+				if want.Year() >= 1 && want.Year() <= 9999 {
+					ht.Fatalf("json round trip of %s through %s gives %s, %v", show(want), out, show(back.Time), err)
+				}
+			}
+			count(ht, "round trip")
+		}
+	})
+}
