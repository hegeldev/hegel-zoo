+// Hegel property tests for github.com/relvacode/iso8601: a model of the grammar the parser
+// documents (ISO 8601 calendar and ordinal dates, times with fractions, Z and +-hh[:mm] zones,
+// with the parser's lenient digit counts) built from generated components, so every accepted
+// input must yield exactly the time its digits spell and every malformed input must be refused;
+// Go's time.Parse on the RFC 3339 subset; encoding/json for the JSON wrapper.
+//
+// The generators draw small records (a date-time spec, a list of edits, a zone) and pure
+// functions render them into strings; the model then judges the rendered string.
+package iso8601_test
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relvacode/iso8601"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// Known bugs, gated so the properties pass while the pins fail (see bugs.toml).
+var known = struct {
+	leadingZ      bool // iso8601/1: a leading Z is skipped like a leading +
+	looseZone     bool // iso8601/2: ParseISOZone accepts malformed and out-of-range offsets
+	deepFraction  bool // iso8601/3: more than 9 fraction digits with leading zeros are not scaled
+	yearZeroAlone bool // iso8601/4: "0000" fails with a month range error
+	fourByteNull  bool // iso8601/5: UnmarshalJSON treats any 4-byte value sharing a byte with null as null
+}{true, true, true, true, true}
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// many concatenates lo to hi draws of g (a SampledFrom pool keeps repeated entries as weights,
+// which Text().Alphabet would not).
+func many(g hegel.Generator[string], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(g).MinSize(lo).MaxSize(hi), func(parts []string) string { return strings.Join(parts, "") })
+}
+
+// pad writes v with at least width digits.
+func pad(v, width int) string {
+	s := strconv.Itoa(v)
+	for len(s) < width {
+		s = "0" + s
+	}
+	return s
+}
+
+// ---- the calendar --------------------------------------------------------------------------
+
+func isLeap(y int) bool { return y%4 == 0 && (y%100 != 0 || y%400 == 0) }
+
+func daysIn(m, y int) int {
+	switch m {
+	case 2:
+		if isLeap(y) {
+			return 29
+		}
+		return 28
+	case 4, 6, 9, 11:
+		return 30
+	}
+	return 31
+}
+
+func daysInYear(y int) int {
+	if isLeap(y) {
+		return 366
+	}
+	return 365
+}
+
+// ---- a valid date-time as data -------------------------------------------------------------
+
+// zone is the zone designator of a date-time: none, Z, or a signed offset in one of the
+// documented spellings.
+type zone struct {
+	kind   int // noZone, utcZone, offsetZone
+	neg    bool
+	hh, mm int
+	form   int // hhOptMM, hhmm, hhColonMM, hhOnly
+}
+
+const (
+	noZone = iota
+	utcZone
+	offsetZone
+)
+
+const (
+	hhOptMM   = iota // +hh, or +hh:mm when the minutes are not zero
+	hhmm             // +hhmm
+	hhColonMM        // +hh:mm
+	hhOnly           // +hh: the minutes are dropped
+)
+
+// offset is the zone's offset east of UTC in seconds, as spelled.
+func (z zone) offset() int {
+	off := z.hh * 3600
+	if z.form != hhOnly {
+		off += z.mm * 60
+	}
+	if z.neg {
+		off = -off
+	}
+	return off
+}
+
+func (z zone) String() string {
+	switch z.kind {
+	case noZone:
+		return ""
+	case utcZone:
+		return "Z"
+	}
+	sign := "+"
+	if z.neg {
+		sign = "-"
+	}
+	hh, mm := pad(z.hh, 2), pad(z.mm, 2)
+	switch z.form {
+	case hhOnly:
+		return sign + hh
+	case hhmm:
+		return sign + hh + mm
+	case hhColonMM:
+		return sign + hh + ":" + mm
+	}
+	if z.mm == 0 {
+		return sign + hh
+	}
+	return sign + hh + ":" + mm
+}
+
+// positive turns -00, -0000 and -00:00, which are not valid ISO 8601 zones, into their + forms.
+func (z zone) positive() zone {
+	if z.hh == 0 && (z.mm == 0 || z.form == hhOnly) {
+		z.neg = false
+	}
+	return z
+}
+
+var (
+	hours   = hegel.Integers(0, 23)
+	minutes = hegel.Integers(0, 59)
+	// zone minutes: mostly on the hour, sometimes a half or three quarters, sometimes anything
+	zoneMinutes = hegel.OneOf(hegel.Just(0), hegel.Just(0), hegel.Just(30), hegel.Just(45), minutes)
+	// offsets: the spellings Parse documents for a date-time
+	offsets = hegel.Composite(func(tc hegel.TestCase) zone {
+		return zone{
+			kind: offsetZone,
+			neg:  hegel.Draw(tc, chance(50)),
+			hh:   hegel.Draw(tc, hours),
+			mm:   hegel.Draw(tc, zoneMinutes),
+			form: hegel.Draw(tc, hegel.Integers(hhOptMM, hhColonMM)),
+		}
+	})
+	// zones of a date-time: none, Z, or an offset that is never -00:00
+	zones = weighted(
+		choice[zone]{30, hegel.Just(zone{kind: noZone})},
+		choice[zone]{17, hegel.Just(zone{kind: utcZone})},
+		choice[zone]{53, hegel.Map(offsets, zone.positive)},
+	)
+)
+
+// widths are the minimum digit counts of the components: canonical, or the parser's lenience.
+type widths struct{ year, month, day, hour int }
+
+var digitWidths = weighted(
+	choice[widths]{90, hegel.Just(widths{4, 2, 2, 2})},
+	choice[widths]{10, hegel.Composite(func(tc hegel.TestCase) widths {
+		return widths{
+			year:  hegel.Draw(tc, hegel.Integers(1, 6)),
+			month: hegel.Draw(tc, hegel.Integers(1, 2)),
+			day:   hegel.Draw(tc, hegel.Integers(1, 2)),
+			hour:  hegel.Draw(tc, hegel.Integers(1, 2)),
+		}
+	})},
+)
+
+// years: a few fixed ones, any year, a modern one, a two-digit one (0 reaches iso8601/4).
+var years = hegel.OneOf(
+	hegel.Just(2000), hegel.Just(2024), hegel.Just(1970), hegel.Just(9999), hegel.Just(1),
+	hegel.Integers(1, 9999), hegel.Integers(1900, 2100), hegel.Integers(0, 99),
+)
+
+// date is the date part after the year: which form, and its month and day.
+type date struct {
+	form       int // yearOnly, yearMonth, fullDate, ordinalDate
+	month, day int // month 0 and day of the year for an ordinal date
+}
+
+const (
+	yearOnly = iota
+	yearMonth
+	fullDate
+	ordinalDate
+)
+
+var months = hegel.Integers(1, 12)
+
+// dateFor generates the date part of a given year (the day depends on the month and the year).
+func dateFor(year int) hegel.Generator[date] {
+	return hegel.OneOf(
+		hegel.Just(date{form: yearOnly, month: 1, day: 1}),
+		hegel.Map(months, func(m int) date { return date{form: yearMonth, month: m, day: 1} }),
+		hegel.FlatMap(months, func(m int) hegel.Generator[date] {
+			return hegel.Map(hegel.Integers(1, daysIn(m, year)), func(d int) date { return date{form: fullDate, month: m, day: d} })
+		}),
+		hegel.Map(hegel.Integers(1, daysInYear(year)), func(d int) date { return date{form: ordinalDate, day: d} }),
+	)
+}
+
+// clockTail is what follows the hour: nothing, minutes, seconds, a fraction.
+type clockTail struct {
+	parts    int // 0 hour only, 1 +minutes, 2 +seconds, 3 +fraction
+	min, sec int
+	frac     string // the fraction's digits, one to nine
+}
+
+var (
+	digitText = hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(9)
+	// fractions: any digits, or leading zeros and one digit
+	fractions  = weighted(choice[string]{50, digitText}, choice[string]{50, hegel.FromRegex(`0{0,8}[0-9]`, true)})
+	clockTails = hegel.OneOf(
+		hegel.Just(clockTail{}),
+		hegel.Map(minutes, func(m int) clockTail { return clockTail{parts: 1, min: m} }),
+		hegel.Composite(func(tc hegel.TestCase) clockTail {
+			return clockTail{parts: 2, min: hegel.Draw(tc, minutes), sec: hegel.Draw(tc, minutes)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) clockTail {
+			return clockTail{parts: 3, min: hegel.Draw(tc, minutes), sec: hegel.Draw(tc, minutes), frac: hegel.Draw(tc, fractions)}
+		}),
+	)
+)
+
+// nanos is the nanoseconds a fraction's digits spell.
+func nanos(frac string) int {
+	v, _ := strconv.Atoi(frac)
+	for i := len(frac); i < 9; i++ {
+		v *= 10
+	}
+	return v
+}
+
+// clock is the time part of a date-time, if any.
+type clock struct {
+	present bool
+	sep     string // T or a space
+	hour    int
+	tail    clockTail
+	zone    zone
+}
+
+var (
+	separators = weighted(choice[string]{85, hegel.Just("T")}, choice[string]{15, hegel.Just(" ")})
+	clocks     = weighted(
+		choice[clock]{20, hegel.Just(clock{})},
+		choice[clock]{80, hegel.Composite(func(tc hegel.TestCase) clock {
+			return clock{
+				present: true,
+				sep:     hegel.Draw(tc, separators),
+				hour:    hegel.Draw(tc, hours),
+				tail:    hegel.Draw(tc, clockTails),
+				zone:    hegel.Draw(tc, zones),
+			}
+		})},
+	)
+)
+
+// spec is a valid date-time and how it is spelled; String renders it.
+type spec struct {
+	plus   bool // a leading + sign
+	widths widths
+	year   int
+	date   date
+	clock  clock
+}
+
+// specs: mostly canonical ISO 8601, sometimes with the parser's lenient digit counts; a time
+// (and so a zone) only after a full or ordinal date.
+var specs = hegel.Composite(func(tc hegel.TestCase) spec {
+	s := spec{plus: hegel.Draw(tc, chance(5)), widths: hegel.Draw(tc, digitWidths), year: hegel.Draw(tc, years)}
+	s.date = hegel.Draw(tc, dateFor(s.year))
+	if s.date.form >= fullDate {
+		s.clock = hegel.Draw(tc, clocks)
+	}
+	return s
+})
+
+func (s spec) String() string {
+	var b strings.Builder
+	if s.plus {
+		b.WriteByte('+')
+	}
+	b.WriteString(pad(s.year, s.widths.year))
+	switch s.date.form {
+	case yearMonth:
+		b.WriteString("-" + pad(s.date.month, 2))
+	case fullDate:
+		b.WriteString("-" + pad(s.date.month, s.widths.month) + "-" + pad(s.date.day, s.widths.day))
+	case ordinalDate:
+		b.WriteString("-" + pad(s.date.day, 3))
+	}
+	if c := s.clock; c.present {
+		b.WriteString(c.sep + pad(c.hour, s.widths.hour))
+		if c.tail.parts >= 1 {
+			b.WriteString(":" + pad(c.tail.min, 2))
+		}
+		if c.tail.parts >= 2 {
+			b.WriteString(":" + pad(c.tail.sec, 2))
+		}
+		if c.tail.parts >= 3 {
+			b.WriteString("." + c.tail.frac)
+		}
+		b.WriteString(c.zone.String())
+	}
+	return b.String()
+}
+
+// want is the time the spec spells, in loc when it has no zone.
+func (s spec) want(loc *time.Location) time.Time {
+	switch s.clock.zone.kind {
+	case utcZone:
+		loc = time.UTC
+	case offsetZone:
+		loc = time.FixedZone("", s.clock.zone.offset())
+	}
+	c := s.clock
+	if s.date.form == ordinalDate {
+		return time.Date(s.year, 1, s.date.day, c.hour, c.tail.min, c.tail.sec, nanos(c.tail.frac), loc)
+	}
+	return time.Date(s.year, time.Month(s.date.month), s.date.day, c.hour, c.tail.min, c.tail.sec, nanos(c.tail.frac), loc)
+}
+
+// yearZero: the text is a year of zeros and nothing else (the shape of iso8601/4).
+func yearZero(text string) bool { return strings.Trim(strings.TrimPrefix(text, "+"), "0") == "" }
+
+// ---- edits of a string ---------------------------------------------------------------------
+
+// edit is one change of a string; positions are taken modulo the live length when it is
+// applied (delete and truncate of an empty string do nothing).
+type edit struct {
+	op   string // delete, truncate, replace, insert, append
+	at   int
+	text string // the character replaced or inserted, or the appended tail
+}
+
+func apply(s string, edits []edit) string {
+	for _, e := range edits {
+		switch e.op {
+		case "delete":
+			if len(s) > 0 {
+				i := e.at % len(s)
+				s = s[:i] + s[i+1:]
+			}
+		case "truncate":
+			s = s[:e.at%(len(s)+1)]
+		case "replace":
+			if len(s) == 0 {
+				s = e.text
+			} else {
+				i := e.at % len(s)
+				s = s[:i] + e.text + s[i+1:]
+			}
+		case "insert":
+			i := e.at % (len(s) + 1)
+			s = s[:i] + e.text + s[i:]
+		case "append":
+			s += e.text
+		}
+	}
+	return s
+}
+
+var (
+	// the characters an edit puts in: digits, separators, zone letters, and some the grammar
+	// never uses; T and 0 twice, a cheap weighting
+	editChars = hegel.SampledFrom(strings.Split("0123456789-:T .Z+z/,;Tt0", ""))
+	// zone-like and digit tails, the malformed zones of iso8601/2 among them
+	tails     = hegel.SampledFrom([]string{"Z", "+01:00", "-05", "0", "00", ":00", ".5", "T10", "+0130", "+013", "+01:3", "+25:00", "+01:60", "-00:00", "z", "+01:", "Zz"})
+	position  = hegel.Integers(0, 47)
+	deletes   = hegel.Map(position, func(i int) edit { return edit{op: "delete", at: i} })
+	truncates = hegel.Map(position, func(i int) edit { return edit{op: "truncate", at: i} })
+	replaces  = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{op: "replace", at: hegel.Draw(tc, position), text: hegel.Draw(tc, editChars)}
+	})
+	inserts = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{op: "insert", at: hegel.Draw(tc, position), text: hegel.Draw(tc, editChars)}
+	})
+	appends = hegel.Map(tails, func(t string) edit { return edit{op: "append", text: t} })
+	edits   = hegel.OneOf(deletes, truncates, replaces, inserts, appends)
+)
+
+// mutation is a valid date-time and lo to hi edits of its text; String renders the result.
+type mutation struct {
+	base  spec
+	edits []edit
+}
+
+func (m mutation) String() string { return apply(m.base.String(), m.edits) }
+
+func mutations(lo, hi int) hegel.Generator[mutation] {
+	return hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{base: hegel.Draw(tc, specs), edits: hegel.Draw(tc, hegel.Lists(edits).MinSize(lo).MaxSize(hi))}
+	})
+}
+
+// ---- the model -----------------------------------------------------------------------------
+
+// modelParse is the reference parser: it returns the time the input spells in loc, or a
+// description of why the input is malformed ("syntax", or "range:<element>:<given>:<min>:<max>").
+func modelParse(in string, loc *time.Location) (time.Time, string) {
+	i := 0
+	if i < len(in) && in[i] == '+' {
+		i++
+	}
+	num := func() (int, int, bool) { // value, digit count, overflow-free
+		start := i
+		v := 0
+		for i < len(in) && in[i] >= '0' && in[i] <= '9' {
+			if v < 1e9 {
+				v = v*10 + int(in[i]-'0')
+			}
+			i++
+		}
+		return v, i - start, v < 1e9
+	}
+	year, yn, _ := num()
+	if yn == 0 {
+		if i == len(in) {
+			// nothing at all: the parser reports the unset month
+			return time.Time{}, "range:month:0:1:12"
+		}
+		return time.Time{}, "syntax"
+	}
+	month, day := 1, 1
+	ordinal := false
+	haveDay := false
+	if i < len(in) && in[i] == '-' {
+		i++
+		v, k, _ := num()
+		if k == 0 {
+			if i == len(in) {
+				return time.Time{}, "range:month:0:1:12" // "2020-": the month stays 0
+			}
+			return time.Time{}, "syntax"
+		}
+		if k == 3 && !(i < len(in) && in[i] == '-') {
+			// three digits not followed by a day are an ordinal day of the year
+			ordinal = true
+			day = v
+		} else {
+			month = v
+			if i < len(in) && in[i] == '-' {
+				i++
+				v, k, _ := num()
+				if k == 0 && !(i == len(in) || in[i] == 'T' || in[i] == ' ') {
+					return time.Time{}, "syntax"
+				}
+				// "2020-01-" or "2020-01-T1": the day stays 0 and the range check reports it
+				day = v
+				haveDay = true
+			}
+		}
+	}
+	hour, min, sec, nanos := 0, 0, 0, 0
+	fracTooLong := false
+	hasTime := false
+	if i < len(in) && (in[i] == 'T' || in[i] == ' ') {
+		if !ordinal && !haveDay {
+			return time.Time{}, "syntax"
+		}
+		hasTime = true
+		i++
+		var hn int
+		hour, hn, _ = num() // an empty trailing component reads as 0 (the parser's lenience)
+		if hn == 0 && i < len(in) && in[i] == ':' {
+			return time.Time{}, "syntax"
+		}
+		if i < len(in) && in[i] == ':' {
+			i++
+			var k int
+			min, k, _ = num()
+			if k == 0 && i < len(in) && in[i] == ':' {
+				return time.Time{}, "syntax"
+			}
+			if i < len(in) && in[i] == ':' {
+				i++
+				sec, k, _ = num()
+				if i < len(in) && in[i] == '.' {
+					if k == 0 {
+						return time.Time{}, "syntax"
+					}
+					i++
+					start := i
+					v, fn, _ := num() // an empty fraction reads as 0 (lenience)
+					if fn > 9 {
+						fracTooLong = true
+					} else {
+						for j := fn; j < 9; j++ {
+							v *= 10
+						}
+						nanos = v
+					}
+					_ = start
+				}
+			}
+		}
+	} else if i < len(in) && in[i] == '.' {
+		return time.Time{}, "syntax"
+	}
+	// zone
+	if i < len(in) {
+		if in[i] == 'Z' {
+			if !hasTime && !ordinal {
+				return time.Time{}, "syntax"
+			}
+			i++
+			if i != len(in) {
+				return time.Time{}, "syntax"
+			}
+			loc = time.UTC
+		} else if in[i] == '+' || in[i] == '-' {
+			if !hasTime && !ordinal {
+				return time.Time{}, "syntax" // a zone needs a time (or, the parser's quirk, an ordinal date)
+			}
+			off, ok := modelZone(in[i:])
+			if !ok {
+				return time.Time{}, "syntax:zone:" + in[i:]
+			}
+			loc = time.FixedZone("", off)
+			i = len(in)
+		} else {
+			return time.Time{}, "syntax"
+		}
+	}
+	if fracTooLong {
+		return time.Time{}, "syntax"
+	}
+	rng := func(el string, given, lo, hi int) string {
+		return fmt.Sprintf("range:%s:%d:%d:%d", el, given, lo, hi)
+	}
+	switch {
+	case !ordinal && (month < 1 || month > 12):
+		return time.Time{}, rng("month", month, 1, 12)
+	case ordinal && (day < 1 || day > daysInYear(year)):
+		return time.Time{}, rng("day", day, 1, daysInYear(year))
+	case !ordinal && (day < 1 || day > daysIn(month, year)):
+		return time.Time{}, rng("day", day, 1, daysIn(month, year))
+	case hour > 23:
+		return time.Time{}, rng("hour", hour, 0, 23)
+	case min > 59:
+		return time.Time{}, rng("minute", min, 0, 59)
+	case sec > 59:
+		return time.Time{}, rng("second", sec, 0, 59)
+	}
+	if ordinal {
+		return time.Date(year, 1, day, hour, min, sec, nanos, loc), ""
+	}
+	return time.Date(year, time.Month(month), day, hour, min, sec, nanos, loc), ""
+}
+
+// modelZone parses Z, z, +hh, +hhmm, +hh:mm (and the - forms) with hh in 0..23, mm in 0..59,
+// -00, -0000 and -00:00 refused.
+func modelZone(z string) (int, bool) {
+	if z == "Z" || z == "z" {
+		return 0, true
+	}
+	if len(z) < 3 || (z[0] != '+' && z[0] != '-') {
+		return 0, false
+	}
+	rest := z[1:]
+	var hh, mm string
+	switch len(rest) {
+	case 2:
+		hh = rest
+	case 4:
+		hh, mm = rest[:2], rest[2:]
+	case 5:
+		if rest[2] != ':' {
+			return 0, false
+		}
+		hh, mm = rest[:2], rest[3:]
+	default:
+		return 0, false
+	}
+	h, err1 := strconv.Atoi(hh)
+	m := 0
+	var err2 error
+	if mm != "" {
+		m, err2 = strconv.Atoi(mm)
+	}
+	if err1 != nil || err2 != nil || !allDigits(hh) || (mm != "" && !allDigits(mm)) || h > 23 || m > 59 {
+		return 0, false
+	}
+	off := h*3600 + m*60
+	if z[0] == '-' {
+		if off == 0 {
+			return 0, false
+		}
+		off = -off
+	}
+	return off, true
+}
+
+func allDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return len(s) > 0
+}
+
+// fractionDigits counts the digits after the first '.' (the shape of iso8601/3 when above nine).
+func fractionDigits(s string) int {
+	j := strings.Index(s, ".")
+	if j < 0 {
+		return 0
+	}
+	k := j + 1
+	for k < len(s) && s[k] >= '0' && s[k] <= '9' {
+		k++
+	}
+	return k - j - 1
+}
+
+func same(a, b time.Time) bool {
+	if !a.Equal(b) {
+		return false
+	}
+	_, oa := a.Zone()
+	_, ob := b.Zone()
+	return oa == ob
+}
+
+func show(t time.Time) string {
+	return t.Format("2006-01-02T15:04:05.999999999Z07:00")
+}
+
+var locations = []*time.Location{time.UTC, time.FixedZone("plus3", 3*3600), time.FixedZone("minus7h30", -(7*3600 + 1800))}
+
+// ---- 1. valid inputs parse to their components ----------------------------------------------
+
+func TestHegelValidDatesParseToTheirComponents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, specs)
+		loc := hegel.Draw(ht, hegel.SampledFrom(locations))
+		text := s.String()
+		want := s.want(loc)
+		got, err := iso8601.ParseInLocation([]byte(text), loc)
+		if err != nil {
+			ht.Assume(!(known.yearZeroAlone && yearZero(text)))
+			ht.Fatalf("ParseInLocation(%q) failed: %v (want %s)", text, err, show(want))
+		}
+		if !same(got, want) {
+			ht.Fatalf("ParseInLocation(%q, %s) = %s, want %s", text, loc, show(got), show(want))
+		}
+		if s.clock.zone.kind == noZone && got.Location() != loc {
+			ht.Fatalf("ParseInLocation(%q, %s) returned location %s", text, loc, got.Location())
+		}
+		// the four entry points agree
+		g2, err2 := iso8601.ParseStringInLocation(text, loc)
+		g3, err3 := iso8601.Parse([]byte(text))
+		g4, err4 := iso8601.ParseString(text)
+		if err2 != nil || err3 != nil || err4 != nil || !same(g2, got) || !same(g3, s.want(time.UTC)) || !same(g4, g3) {
+			ht.Fatalf("the entry points disagree on %q: %s %v / %s %v / %s %v / %s %v", text, show(got), err, show(g2), err2, show(g3), err3, show(g4), err4)
+		}
+		// Go's own formats round-trip through the parser
+		for _, layout := range []string{time.RFC3339Nano, "2006-01-02T15:04:05.999999999Z07:00", "2006-01-02T15:04:05.999999999"} {
+			formatted := got.Format(layout)
+			back, err := iso8601.ParseInLocation([]byte(formatted), got.Location())
+			if err != nil || !same(back, got) {
+				ht.Fatalf("re-parsing %q (from %q, layout %q) gives %s, %v", formatted, text, layout, show(back), err)
+			}
+		}
+		// the JSON wrapper parses the quoted string
+		var w iso8601.Time
+		if err := json.Unmarshal([]byte(strconv.Quote(text)), &w); err != nil || !same(w.Time, s.want(time.UTC)) {
+			ht.Fatalf("json.Unmarshal(%q) into iso8601.Time gives %s, %v", text, show(w.Time), err)
+		}
+	})
+}
+
+// ---- 2. the model decides acceptance and value ---------------------------------------------
+
+func TestHegelParserFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, mutations(0, 3)).String()
+		ht.Assume(len(s) <= 40)
+		loc := hegel.Draw(ht, hegel.SampledFrom(locations[:2]))
+		want, why := modelParse(s, loc)
+		got, err := iso8601.ParseInLocation([]byte(s), loc)
+		// known deviations
+		ht.Assume(!(known.leadingZ && strings.HasPrefix(s, "Z")))
+		if known.looseZone && strings.HasPrefix(why, "syntax:zone:") {
+			_, zerr := iso8601.ParseISOZone([]byte(strings.TrimPrefix(why, "syntax:zone:")))
+			ht.Assume(zerr != nil)
+			why = "syntax"
+		}
+		ht.Assume(!(known.deepFraction && why == "syntax" && err == nil && fractionDigits(s) > 9))
+		ht.Assume(!(known.yearZeroAlone && why == "" && err != nil && yearZero(s)))
+		switch {
+		case why == "" && err != nil:
+			ht.Fatalf("Parse(%q) failed with %v; the model gives %s", s, err, show(want))
+		case why == "" && err == nil:
+			if !same(got, want) {
+				ht.Fatalf("Parse(%q) = %s, the model gives %s", s, show(got), show(want))
+			}
+		case why != "" && err == nil:
+			ht.Fatalf("Parse(%q) = %s, the model refuses it (%s)", s, show(got), why)
+		default:
+			var re *iso8601.RangeError
+			if strings.HasPrefix(why, "range:") {
+				if !errors.As(err, &re) {
+					ht.Fatalf("Parse(%q) failed with %v (%T), the model expects a RangeError (%s)", s, err, err, why)
+				}
+				parts := strings.Split(why, ":")
+				given, _ := strconv.Atoi(parts[2])
+				lo, _ := strconv.Atoi(parts[3])
+				hi, _ := strconv.Atoi(parts[4])
+				if re.Element != parts[1] || re.Given != given || re.Min != lo || re.Max != hi || re.Value != s {
+					ht.Fatalf("Parse(%q) RangeError %+v, the model expects %s", s, *re, why)
+				}
+			} else if errors.As(err, &re) {
+				ht.Fatalf("Parse(%q) failed with a RangeError %v, the model expects a syntax error", s, err)
+			}
+		}
+	})
+}
+
+// ---- 3. zones -------------------------------------------------------------------------------
+
+var (
+	// zoneForms: the spellings ParseISOZone documents, with any hour and minute (-00 included,
+	// which the model refuses)
+	zoneForms = hegel.Composite(func(tc hegel.TestCase) zone {
+		return zone{
+			kind: offsetZone,
+			neg:  hegel.Draw(tc, chance(50)),
+			hh:   hegel.Draw(tc, hours),
+			mm:   hegel.Draw(tc, minutes),
+			form: hegel.Draw(tc, hegel.SampledFrom([]int{hhOnly, hhmm, hhColonMM})),
+		}
+	})
+	validZones = weighted(
+		choice[string]{10, hegel.SampledFrom([]string{"Z", "z"})},
+		choice[string]{90, hegel.Map(zoneForms, zone.String)},
+	)
+	// mutatedZones: one edit of a well-formed zone
+	mutatedZones = hegel.Composite(func(tc hegel.TestCase) string {
+		base := hegel.Draw(tc, hegel.SampledFrom([]string{"+01:00", "-0530", "+00", "Z", "-12:00", "+2359"}))
+		return apply(base, []edit{hegel.Draw(tc, edits)})
+	})
+	randomZones = hegel.Text().Alphabet("0123456789+-:Zz").MaxSize(7)
+	zoneStrings = hegel.OneOf(validZones, mutatedZones, randomZones)
+)
+
+func TestHegelZoneOffsetsFollowTheirDocumentation(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		z := hegel.Draw(ht, zoneStrings)
+		want, ok := modelZone(z)
+		loc, err := iso8601.ParseISOZone([]byte(z))
+		ht.Assume(!(known.looseZone && !ok && err == nil))
+		if ok != (err == nil) {
+			ht.Fatalf("ParseISOZone(%q) = %v, %v; the model says valid=%v (offset %d)", z, loc, err, ok, want)
+		}
+		if ok {
+			_, off := time.Date(2020, 1, 1, 0, 0, 0, 0, loc).Zone()
+			if off != want {
+				ht.Fatalf("ParseISOZone(%q) has offset %d, want %d", z, off, want)
+			}
+			if (z == "Z" || z == "z") && loc != time.UTC {
+				ht.Fatalf("ParseISOZone(%q) is not time.UTC", z)
+			}
+		}
+	})
+}
+
+// ---- 4. JSON --------------------------------------------------------------------------------
+
+// rawJSON is the JSON value given to the wrapper: null, a valid or mutated date-time string,
+// a value that is not a string, a short string of letters (n, u and l weighted, for
+// iso8601/5), or a fixed string.
+var rawJSON = hegel.OneOf(
+	hegel.Just("null"),
+	hegel.Map(specs, func(s spec) string { return strconv.Quote(s.String()) }),
+	hegel.Map(mutations(1, 3), func(m mutation) string { return strconv.Quote(m.String()) }),
+	hegel.SampledFrom([]string{"true", "false", "1234", "12.5", "-1", "{}", "[]", `{"a":1}`, "[1]", "1e10", "0"}),
+	hegel.Map(many(hegel.SampledFrom(strings.Split("nul0123456789-:TZ+ .abcdefghijklmnopqrstuvwxyz", "")), 0, 5), strconv.Quote),
+	hegel.Map(hegel.SampledFrom([]string{"2020-01-02", "2020-01-02T10:20:30Z", "", " ", "null", "nu", "2020"}), strconv.Quote),
+)
+
+func TestHegelJsonWrapperFollowsEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		raw := hegel.Draw(ht, rawJSON)
+		ht.Assume(!(known.fourByteNull && len(raw) == 4 && raw != "null" && (raw[0] == 'n' || raw[1] == 'u' || raw[2] == 'l' || raw[3] == 'l')))
+		doc := `{"t":` + raw + `,"p":` + raw + `}`
+		var got struct {
+			T iso8601.Time  `json:"t"`
+			P *iso8601.Time `json:"p"`
+		}
+		sentinel := time.Date(1999, 12, 31, 23, 59, 59, 0, time.UTC)
+		got.T.Time = sentinel
+		err := json.Unmarshal([]byte(doc), &got)
+		// the model: null leaves the value alone (and nils the pointer); a string parses; anything
+		// else is ErrNotString
+		var wantErr error
+		var want time.Time
+		switch {
+		case raw == "null":
+			want = sentinel
+		case raw[0] == '"':
+			var s string
+			ht.Assume(json.Unmarshal([]byte(raw), &s) == nil)
+			want, wantErr = iso8601.Parse([]byte(s))
+		default:
+			wantErr = iso8601.ErrNotString
+		}
+		if (err == nil) != (wantErr == nil) {
+			ht.Fatalf("json.Unmarshal(%s) gives %v, the model expects %v", doc, err, wantErr)
+		}
+		if wantErr != nil {
+			if wantErr == iso8601.ErrNotString && !errors.Is(err, iso8601.ErrNotString) {
+				ht.Fatalf("json.Unmarshal(%s) gives %v, want ErrNotString", doc, err)
+			}
+			return
+		}
+		if !same(got.T.Time, want) {
+			ht.Fatalf("json.Unmarshal(%s) sets t = %s, want %s", doc, show(got.T.Time), show(want))
+		}
+		if raw == "null" {
+			if got.P != nil {
+				ht.Fatalf("json.Unmarshal(%s) left the pointer non-nil", doc)
+			}
+		} else if got.P == nil || !same(got.P.Time, want) {
+			ht.Fatalf("json.Unmarshal(%s) sets p = %v, want %s", doc, got.P, show(want))
+		}
+		// Marshal of the wrapper is time.Time's RFC 3339 form and re-parses to the same instant
+		_, off := want.Zone()
+		ht.Assume(!(known.looseZone && (off <= -24*3600 || off >= 24*3600))) // an offset time.Time cannot marshal
+		if raw != "null" && want.Year() >= 1 && want.Year() <= 9999 {
+			out, err := json.Marshal(got.T)
+			if err != nil {
+				ht.Fatalf("json.Marshal of the parsed %s: %v", show(want), err)
+			}
+			var back iso8601.Time
+			if err := json.Unmarshal(out, &back); err != nil || !back.Time.Equal(want) {
+				if want.Year() >= 1 && want.Year() <= 9999 {
+					ht.Fatalf("json round trip of %s through %s gives %s, %v", show(want), out, show(back.Time), err)
+				}
+			}
+		}
+	})
+}
+
+// ---- 5. the RFC 3339 subset agrees with time.Parse -----------------------------------------
+
+// rfc is an RFC 3339 string by fields: mostly in range, sometimes a field just out of range
+// so that time.Parse's range checks are exercised too.
+type rfc struct {
+	y, mo, d, h, mi, se int
+	frac, zone          string
+}
+
+func (r rfc) String() string {
+	return fmt.Sprintf("%04d-%02d-%02dT%02d:%02d:%02d%s%s", r.y, r.mo, r.d, r.h, r.mi, r.se, r.frac, r.zone)
+}
+
+// rfcFields generates the six fields with the given ranges.
+func rfcFields(mo, d, h, mi, se hegel.Generator[int]) hegel.Generator[rfc] {
+	return hegel.Composite(func(tc hegel.TestCase) rfc {
+		return rfc{
+			y:  hegel.Draw(tc, hegel.Integers(1, 9999)),
+			mo: hegel.Draw(tc, mo),
+			d:  hegel.Draw(tc, d),
+			h:  hegel.Draw(tc, h),
+			mi: hegel.Draw(tc, mi),
+			se: hegel.Draw(tc, se),
+		}
+	})
+}
+
+var (
+	inRange = rfcFields(months, hegel.Integers(1, 28), hours, minutes, minutes)
+	wide    = rfcFields(hegel.Integers(0, 13), hegel.Integers(0, 32), hegel.Integers(0, 24), hegel.Integers(0, 60), hegel.Integers(0, 60))
+	// rfcFractions: none, or up to four zeros and one to three digits, at most nine digits
+	rfcFractions = weighted(
+		choice[string]{50, hegel.Just("")},
+		choice[string]{50, hegel.Composite(func(tc hegel.TestCase) string {
+			f := "." + strings.Repeat("0", hegel.Draw(tc, hegel.Integers(0, 4))) + strconv.Itoa(hegel.Draw(tc, hegel.Integers(1, 999)))
+			if len(f) > 10 {
+				f = f[:10]
+			}
+			return f
+		})},
+	)
+	// rfcZones: Z, or +-hh:mm (never -00:00)
+	rfcZones = weighted(
+		choice[string]{40, hegel.Just("Z")},
+		choice[string]{60, hegel.Map(hegel.Composite(func(tc hegel.TestCase) zone {
+			return zone{kind: offsetZone, neg: hegel.Draw(tc, chance(50)), hh: hegel.Draw(tc, hours), mm: hegel.Draw(tc, minutes), form: hhColonMM}
+		}), func(z zone) string { return z.positive().String() })},
+	)
+	rfcs = hegel.Composite(func(tc hegel.TestCase) rfc {
+		r := hegel.Draw(tc, weighted(choice[rfc]{70, inRange}, choice[rfc]{30, wide}))
+		r.frac = hegel.Draw(tc, rfcFractions)
+		r.zone = hegel.Draw(tc, rfcZones)
+		return r
+	})
+)
+
+func TestHegelRfc3339SubsetAgreesWithTimeParse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, rfcs).String()
+		ref, refErr := time.Parse(time.RFC3339Nano, s)
+		got, err := iso8601.Parse([]byte(s))
+		if (refErr == nil) != (err == nil) {
+			ht.Fatalf("time.Parse(%q) gives %s, %v; iso8601.Parse gives %s, %v", s, show(ref), refErr, show(got), err)
+		}
+		if err == nil && !same(got, ref) {
+			ht.Fatalf("iso8601.Parse(%q) = %s, time.Parse gives %s", s, show(got), show(ref))
+		}
+	})
+}
+
+// ---- pins: one plain test per recorded bug --------------------------------------------------
+
+// iso8601/1: a leading Z is skipped like a leading +.
+func TestHegelPinLeadingZIsRejected(t *testing.T) {
+	if got, err := iso8601.ParseString("Z2020-01-02T03:04:05Z"); err == nil {
+		t.Fatalf("ParseString(\"Z2020-01-02T03:04:05Z\") = %s, want an error", got)
+	}
+}
+
+// iso8601/2: ParseISOZone accepts offsets that are not +-hh, +-hhmm or +-hh:mm, and hours or
+// minutes out of range.
+func TestHegelPinMalformedZonesAreRejected(t *testing.T) {
+	for _, z := range []string{"+013", "+01:3", "+01:", "+25:00", "+01:60", "+99:99"} {
+		if loc, err := iso8601.ParseISOZone([]byte(z)); err == nil {
+			_, off := time.Date(2020, 1, 1, 0, 0, 0, 0, loc).Zone()
+			t.Errorf("ParseISOZone(%q) = offset %d, want an error", z, off)
+		}
+	}
+	if got, err := iso8601.ParseString("2020-01-02T03:04:05+25:99"); err == nil {
+		t.Errorf("ParseString(\"2020-01-02T03:04:05+25:99\") = %s, want an error", got)
+	}
+}
+
+// iso8601/3: more than nine fraction digits are only refused when the digits' value reaches 1e9;
+// with leading zeros they are taken as nanoseconds unscaled.
+func TestHegelPinDeepFractionsAreNotMisread(t *testing.T) {
+	got, err := iso8601.ParseString("2020-01-02T03:04:05.0000000005Z")
+	if err == nil && got.Nanosecond() != 0 {
+		t.Fatalf("ParseString(\"2020-01-02T03:04:05.0000000005Z\") = %s (%d ns), want 0 ns or an error", got.Format(time.RFC3339Nano), got.Nanosecond())
+	}
+	got, err = iso8601.ParseString("2020-01-02T03:04:05.00000000012Z")
+	if err == nil && got.Nanosecond() != 0 {
+		t.Fatalf("ParseString(\"2020-01-02T03:04:05.00000000012Z\") = %s (%d ns), want 0 ns or an error", got.Format(time.RFC3339Nano), got.Nanosecond())
+	}
+}
+
+// iso8601/4: the year-only form "0000" fails with a month range error, while "0000-01" parses.
+func TestHegelPinYearZeroAloneParses(t *testing.T) {
+	want, err := iso8601.ParseString("0000-01")
+	if err != nil {
+		t.Skipf("0000-01 is refused too: %v", err)
+	}
+	got, err := iso8601.ParseString("0000")
+	if err != nil || !got.Equal(want) {
+		t.Fatalf("ParseString(\"0000\") = %s, %v; \"0000-01\" gives %s", got, err, want)
+	}
+}
+
+// iso8601/5: Time.UnmarshalJSON's null test uses && where it needs ||, so any 4-byte value sharing
+// a byte with "null" in the same position is treated as null.
+func TestHegelPinShortStringsAreNotNull(t *testing.T) {
+	for _, raw := range []string{`"1l"`, `"u2"`, `"ab"`} {
+		var w iso8601.Time
+		w.Time = time.Date(1999, 12, 31, 0, 0, 0, 0, time.UTC)
+		err := json.Unmarshal([]byte(raw), &w)
+		if err == nil {
+			t.Errorf("json.Unmarshal(%s) into iso8601.Time succeeded and left %s, want a parse error", raw, w.Time)
+		}
+	}
+}
