+// ---- 5. the RFC 3339 subset agrees with time.Parse -----------------------------------------
+
+func TestHegelRfc3339SubsetAgreesWithTimeParse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		// build an RFC 3339 string, then perturb digits so that time.Parse's range checks are
+		// exercised too
+		y, mo, d := n(tc, 1, 9999), n(tc, 0, 13), n(tc, 0, 32)
+		h, mi, se := n(tc, 0, 24), n(tc, 0, 60), n(tc, 0, 60)
+		if chance(tc, 70) {
+			mo, d, h, mi, se = n(tc, 1, 12), n(tc, 1, 28), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59)
+		}
+		frac := ""
+		if chance(tc, 50) {
+			frac = "." + strings.Repeat("0", n(tc, 0, 4)) + strconv.Itoa(n(tc, 1, 999))
+			if len(frac) > 10 {
+				frac = frac[:10]
+			}
+		}
+		zone := "Z"
+		if chance(tc, 60) {
+			zone = pick(tc, []string{"+", "-"}) + digits(tc, n(tc, 0, 23), 2) + ":" + digits(tc, n(tc, 0, 59), 2)
+			if zone == "-00:00" {
+				zone = "+00:00"
+			}
+		}
+		s := fmt.Sprintf("%04d-%02d-%02dT%02d:%02d:%02d%s%s", y, mo, d, h, mi, se, frac, zone)
+		ref, refErr := time.Parse(time.RFC3339Nano, s)
+		got, err := iso8601.Parse([]byte(s))
+		if (refErr == nil) != (err == nil) {
+			ht.Fatalf("time.Parse(%q) gives %s, %v; iso8601.Parse gives %s, %v", s, show(ref), refErr, show(got), err)
+		}
+		if err == nil {
+			if !same(got, ref) {
+				ht.Fatalf("iso8601.Parse(%q) = %s, time.Parse gives %s", s, show(got), show(ref))
+			}
+			count(ht, "agree")
+		} else {
+			count(ht, "both refuse")
+		}
+	})
+}
