+// ---- 3. zones -------------------------------------------------------------------------------
+
+func TestHegelZoneOffsetsFollowTheirDocumentation(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		var z string
+		switch n(tc, 0, 2) {
+		case 0: // valid
+			hh, mm := n(tc, 0, 23), n(tc, 0, 59)
+			sign := pick(tc, []string{"+", "-"})
+			z = sign + pick(tc, []string{digits(tc, hh, 2), digits(tc, hh, 2) + digits(tc, mm, 2), digits(tc, hh, 2) + ":" + digits(tc, mm, 2)})
+			if chance(tc, 10) {
+				z = pick(tc, []string{"Z", "z"})
+			}
+		case 1: // mutated
+			z = mutate(tc, pick(tc, []string{"+01:00", "-0530", "+00", "Z", "-12:00", "+2359"}))
+		default: // random
+			pool := "0123456789+-:Zz"
+			k := n(tc, 0, 7)
+			var b strings.Builder
+			for i := 0; i < k; i++ {
+				b.WriteByte(pool[n(tc, 0, len(pool)-1)])
+			}
+			z = b.String()
+		}
+		want, ok := modelZone(z)
+		loc, err := iso8601.ParseISOZone([]byte(z))
+		if known.looseZone && !ok && err == nil {
+			count(ht, "known iso8601/2 (loose zone)")
+			return
+		}
+		if ok != (err == nil) {
+			ht.Fatalf("ParseISOZone(%q) = %v, %v; the model says valid=%v (offset %d)", z, loc, err, ok, want)
+		}
+		if ok {
+			_, off := time.Date(2020, 1, 1, 0, 0, 0, 0, loc).Zone()
+			if off != want {
+				ht.Fatalf("ParseISOZone(%q) has offset %d, want %d", z, off, want)
+			}
+			if (z == "Z" || z == "z") && loc != time.UTC {
+				ht.Fatalf("ParseISOZone(%q) is not time.UTC", z)
+			}
+			count(ht, "valid zone")
+		} else {
+			count(ht, "invalid zone")
+		}
+	})
+}
