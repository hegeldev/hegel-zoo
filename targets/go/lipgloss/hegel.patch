+// Package zootest is the shared Hegel harness of the hegel-zoo lipgloss target: collect
+// mode, generators helpers and the SGR/OSC 8 cell parser used to read rendered output.
+package zootest
+
+import (
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+func HegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("LIPGLOSS_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func Fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func Property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, msg)
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, HegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func Count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func Note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------- known bugs
+
+// NoKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By
+// default every switch of Known is off: the models say what the documentation says, the
+// generators draw the shape of every recorded bug as a steady alternative, and a property
+// that meets one fails naming the bug (Mismatch), so the wide properties are the expected
+// failures mapped to the bugs they find, beside the pins. Under HEGEL_NO_KNOWN=1 the
+// switches skip, tolerate and steer: a shape alternative gets weight zero at the generator
+// (Unless), a tolerance edits the rendered cells towards the model, a check goes unrun, and
+// a disagreement on a shape that is still drawn is counted and assumed away.
+var NoKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known has one switch per recorded bug, all set from NoKnown.
+var Known = struct {
+	SpaceStylerTearsClusters       bool // lipgloss/1: Underline or Strikethrough styles the text rune by rune, tearing grapheme clusters apart
+	ReverseDroppedOnSpaces         bool // lipgloss/2: Reverse is dropped from spaces when the space styler is active
+	SpacesUnderlinedSingle         bool // lipgloss/3: Spaces get a single underline whatever UnderlineStyle the text has
+	HyperlinkCoversWhitespace      bool // lipgloss/4: A Hyperlink covers the padding, alignment, border and margin cells between the first and last line
+	PlaceMirrorsFractions          bool // lipgloss/5: PlaceHorizontal and PlaceVertical mirror fractional positions
+	HeightIgnoredForFractionAlign  bool // lipgloss/6: Height is ignored when AlignVertical is a fractional position
+	FractionalAlignIsLeft          bool // lipgloss/7: A fractional horizontal alignment is treated as Left
+	TableWidthIgnoresBorders       bool // lipgloss/8: table: Width ignores the borders when deciding whether to shrink, and the right border is clipped
+	ShrinkSkipsFirstColumn         bool // lipgloss/9: table: shrinkToMedian never shrinks the first column
+	BottomBorderClippedNoHeaders   bool // lipgloss/10: table: the bottom border is clipped when a table with Height has no headers
+	HeaderHeightFollowsLastColumn  bool // lipgloss/11: table: the header row's height follows the last column's padding only
+	NoWrapDropsLines               bool // lipgloss/12: table: Wrap(false) drops every line after the first of a multi-line cell
+	OverflowRowPaddingOffByOne     bool // lipgloss/13: table: the overflow row takes the previous row's padding when the table has headers
+	TrailingHiddenKeepTheBranch    bool // lipgloss/14: tree: two hidden children at the end of a branch leave the last visible child with the branch glyph
+	WidthPadsLastLineOnly          bool // lipgloss/15: tree: Width pads only the last line of a multi-line item
+	OffsetEndIsACount              bool // lipgloss/16: tree: Offset's end is documented as an index but used as a count from the end
+	AlphabetYieldsAtSign           bool // lipgloss/17: list: the Alphabet enumerator labels every 26th block of 26 items with '@'
+	NoWrapIgnoresVerticalPadding   bool // lipgloss/18: table: Wrap(false) ignores vertical padding, so a padded cell loses its text
+	CompositorDrawsAbsolute        bool // lipgloss/19: Compositor.Render draws layers at absolute coordinates on a canvas sized to the bounds
+	AutoNestingUnhidesLeaf         bool // lipgloss/20: tree: auto-nesting a rootless tree onto a hidden leaf makes it visible
+	HiddenFirstShiftsNumbering     bool // lipgloss/21: tree: a hidden first child keeps its index and shifts the enumeration
+	CompositorOrderPastTwelve      bool // lipgloss/22: Compositor draws equal-z layers out of insertion order once there are more than twelve
+	BorderBlendSkipsRightCorners   bool // lipgloss/23: Border foreground blends skip two colours at the top-right and bottom-right corners
+	Blend1DDropsLastStop           bool // lipgloss/24: Blend1D drops the last stop when there are fewer than two steps per segment
+	Blend2DStopsShort              bool // lipgloss/25: Blend2D never reaches the last stop
+	StyleRunesPadsMultiLine        bool // lipgloss/26: StyleRunes pads multi-line strings, inserting spaces mid-line
+	Blend2DRightAnglesInexact      bool // lipgloss/27: Blend2D right angles are inexact: the residue of sin/cos decides cells on a boundary
+	DarkChannelsRenderBright       bool // lipgloss/28: A colour channel below 1/256 is written out 256 times too bright
+	AllNilBlendPanics              bool // lipgloss/29: Render panics when every stop of a border foreground blend is nil
+	HiddenChildIndexesPastSiblings bool // lipgloss/30: tree: a hidden child anywhere but first makes the renderer call the style functions with an index past the children it passes them
+}{
+	NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown,
+	NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown,
+	NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown, NoKnown,
+}
+
+// Mismatch reports a disagreement with the model on a case whose known shapes are named
+// (none for a plain failure): each shape is counted as lipgloss/N-shape, under
+// HEGEL_NO_KNOWN=1 the case is assumed away, and by default it fails with the shapes
+// appended, naming the bug.
+func Mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		for _, s := range shapes {
+			Count(s + "-shape")
+		}
+		if NoKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	Fail(ht, format, args...)
+}
+
+// Shapes collects the ids of the recorded bugs whose shape a case has.
+type Shapes []string
+
+// Add appends the id when the condition holds.
+func (s *Shapes) Add(id string, when bool) {
+	if when && !slices.Contains(*s, id) {
+		*s = append(*s, id)
+	}
+}
+
+// ---------------------------------------------------------------- generator idioms
+//
+// hegel-go has no weighted choice, biased coin, optional with a probability, fixed-size
+// list or tuple combinator; these are the zoo's spellings (STYLE.md).
+
+// Choice is one alternative of a weighted choice.
+type Choice[T any] struct {
+	Weight int
+	Gen    hegel.Generator[T]
+}
+
+// Weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first. A weight of
+// zero (Unless) removes the alternative.
+func Weighted[T any](choices ...Choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.Weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.Weight {
+				return c.Gen
+			}
+			i -= c.Weight
+		}
+		panic("unreachable")
+	})
+}
+
+// W is a weighted alternative.
+func W[T any](weight int, g hegel.Generator[T]) Choice[T] { return Choice[T]{weight, g} }
+
+// Unless is the weight w, or zero when the switch is on: the shape alternative of a known
+// bug is drawn by default and not at all under HEGEL_NO_KNOWN=1.
+func Unless(sw bool, w int) int {
+	if sw {
+		return 0
+	}
+	return w
+}
+
+// Chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so
+// the true range is the top of the die).
+func Chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// Maybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func Maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return Weighted(W(100-pct, hegel.Just(zero)), W(pct, g))
+}
+
+// Pick is one of a small table of values (the first is the shrink target).
+func Pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// Counted is a list of lo to hi elements with the count drawn first, so that the empty
+// list is as likely as any other count (Lists().MaxSize(n) almost never draws it).
+func Counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(k int) hegel.Generator[[]T] {
+		if k == 0 {
+			return hegel.Just([]T(nil))
+		}
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// Shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it (the narrow properties).
+func Shaped[T any](known, past T) T {
+	if NoKnown {
+		return past
+	}
+	return known
+}
+
+func Guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+const (
+	ABold uint8 = 1 << iota
+	AFaint
+	AItalic
+	ABlink
+	ARapidBlink
+	AReverse
+	AConceal
+	AStrike
+)
+
+// MStyle is the pen: what an SGR-reading terminal holds for a cell.
+type MStyle struct {
+	Fg, Bg, Ul color.Color
+	Attrs      uint8
+	Under      ansi.Underline
+}
+
+func (s MStyle) String() string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b under:%d}", s.Fg, s.Bg, s.Ul, s.Attrs, s.Under)
+}
+
+func ColorEqual(c, o color.Color) bool {
+	if c == nil && o == nil {
+		return true
+	}
+	if c == nil || o == nil {
+		return false
+	}
+	cr, cg, cb, ca := c.RGBA()
+	or, og, ob, oa := o.RGBA()
+	return cr == or && cg == og && cb == ob && ca == oa
+}
+
+// MCell is one screen cell: a grapheme with its width, pen and hyperlink.
+type MCell struct {
+	G    string
+	W    int
+	St   MStyle
+	Link string // URL
+	Lp   string // link params
+}
+
+func (c MCell) String() string {
+	s := fmt.Sprintf("{%q w%d %s", c.G, c.W, c.St)
+	if c.Link != "" {
+		s += fmt.Sprintf(" link=%s;%s", c.Lp, c.Link)
+	}
+	return s + "}"
+}
+
+// ApplySGR applies one SGR parameter list to st following ECMA-48 and the xterm/kitty colour
+// and underline extensions.
+func ApplySGR(params []ansi.Param, st *MStyle) {
+	if len(params) == 0 {
+		*st = MStyle{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		p := params[i]
+		v := p.Param(0)
+		switch {
+		case v == 0:
+			*st = MStyle{}
+		case v == 1:
+			st.Attrs |= ABold
+		case v == 2:
+			st.Attrs |= AFaint
+		case v == 3:
+			st.Attrs |= AItalic
+		case v == 4:
+			if p.HasMore() && i+1 < len(params) {
+				i++
+				st.Under = ansi.Underline(params[i].Param(1))
+			} else {
+				st.Under = ansi.UnderlineSingle
+			}
+		case v == 5:
+			st.Attrs |= ABlink
+		case v == 6:
+			st.Attrs |= ARapidBlink
+		case v == 7:
+			st.Attrs |= AReverse
+		case v == 8:
+			st.Attrs |= AConceal
+		case v == 9:
+			st.Attrs |= AStrike
+		case v == 22:
+			st.Attrs &^= ABold | AFaint
+		case v == 23:
+			st.Attrs &^= AItalic
+		case v == 24:
+			st.Under = ansi.UnderlineNone
+		case v == 25:
+			st.Attrs &^= ABlink | ARapidBlink
+		case v == 27:
+			st.Attrs &^= AReverse
+		case v == 28:
+			st.Attrs &^= AConceal
+		case v == 29:
+			st.Attrs &^= AStrike
+		case v >= 30 && v <= 37:
+			st.Fg = ansi.BasicColor(v - 30)
+		case v == 39:
+			st.Fg = nil
+		case v >= 40 && v <= 47:
+			st.Bg = ansi.BasicColor(v - 40)
+		case v == 49:
+			st.Bg = nil
+		case v == 59:
+			st.Ul = nil
+		case v >= 90 && v <= 97:
+			st.Fg = ansi.BasicColor(v - 90 + 8)
+		case v >= 100 && v <= 107:
+			st.Bg = ansi.BasicColor(v - 100 + 8)
+		case v == 38 || v == 48 || v == 58:
+			end := i
+			for end+1 < len(params) && params[end].HasMore() {
+				end++
+			}
+			run := params[i : end+1]
+			if len(run) == 1 {
+				run = params[i:min(len(params), i+5)]
+				if len(run) > 1 && run[1].Param(0) == 5 {
+					run = run[:3]
+				}
+				end = i + len(run) - 1
+			}
+			var c color.Color
+			switch {
+			case len(run) >= 3 && run[1].Param(0) == 5:
+				c = ansi.ExtendedColor(run[2].Param(0))
+			case len(run) == 6 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[3].Param(0)), G: uint8(run[4].Param(0)), B: uint8(run[5].Param(0)), A: 0xff}
+			case len(run) >= 5 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[2].Param(0)), G: uint8(run[3].Param(0)), B: uint8(run[4].Param(0)), A: 0xff}
+			}
+			switch v {
+			case 38:
+				st.Fg = c
+			case 48:
+				st.Bg = c
+			default:
+				st.Ul = c
+			}
+			i = end
+		}
+	}
+}
+
+// ParseCells replays a rendered string onto rows of cells: text lands with the pen and link
+// in force, SGR and OSC 8 move the pen, "\n" starts a row. Zero-width graphemes (a combining
+// mark separated from its base by a sequence) become cells of width 0.
+func ParseCells(out string) [][]MCell {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st MStyle
+	var link, lp string
+	var state byte
+	rows := [][]MCell{{}}
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			ApplySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			parts := strings.SplitN(string(p.Data()), ";", 3)
+			if len(parts) == 3 {
+				lp, link = parts[1], parts[2]
+			}
+		case sq == "\n":
+			rows = append(rows, []MCell{})
+		case sq == "\r":
+			// Left in place: the model never expects one.
+			rows[len(rows)-1] = append(rows[len(rows)-1], MCell{G: "\r", W: 0, St: st, Link: link, Lp: lp})
+		case ansi.HasEscPrefix(sq) || ansi.HasCsiPrefix(sq) || ansi.HasOscPrefix(sq) || ansi.HasDcsPrefix(sq):
+			// Other sequences do not draw.
+		default:
+			rows[len(rows)-1] = append(rows[len(rows)-1], MCell{G: sq, W: w, St: st, Link: link, Lp: lp})
+		}
+		out = out[k:]
+		state = ns
+	}
+	return rows
+}
+
+func RowsString(rows [][]MCell) string {
+	var sb strings.Builder
+	for y, r := range rows {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range r {
+			sb.WriteString(" " + c.String())
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func RowsRow(r []MCell) string {
+	var sb strings.Builder
+	for _, c := range r {
+		sb.WriteString(" " + c.String())
+	}
+	return sb.String()
+}
+
+func RowsPlain(rows [][]MCell) string {
+	lines := make([]string, len(rows))
+	for y, r := range rows {
+		var sb strings.Builder
+		for _, c := range r {
+			sb.WriteString(c.G)
+		}
+		lines[y] = sb.String()
+	}
+	return strings.Join(lines, "\n")
+}
+
+func IsSpaceCell(g string) bool {
+	return g == " " || g == " "
+}
+
+// SameCell compares two cells up to what a terminal shows: on a blank, bold, faint, italic,
+// blink and the foreground colour are invisible; an underline colour without an underline is
+// invisible everywhere.
+func SameCell(a, b MCell) bool {
+	if a.G != b.G || a.W != b.W || a.Link != b.Link || a.Lp != b.Lp {
+		return false
+	}
+	as, bs := a.St, b.St
+	if IsSpaceCell(a.G) {
+		invisible := ABold | AFaint | AItalic | ABlink | ARapidBlink
+		as.Attrs &^= invisible
+		bs.Attrs &^= invisible
+		as.Fg, bs.Fg = nil, nil
+	}
+	if as.Under == ansi.UnderlineNone {
+		as.Ul = nil
+	}
+	if bs.Under == ansi.UnderlineNone {
+		bs.Ul = nil
+	}
+	return as.Attrs == bs.Attrs && as.Under == bs.Under && ColorEqual(as.Fg, bs.Fg) && ColorEqual(as.Bg, bs.Bg) && ColorEqual(as.Ul, bs.Ul)
+}
+
+func CompareRows(ht *hegel.T, what string, got, want [][]MCell, out string) {
+	if len(got) != len(want) {
+		Fail(ht, "%s: %d lines rendered, model has %d\nrendered %q\ngot   %q\nmodel %q", what, len(got), len(want), out, RowsPlain(got), RowsPlain(want))
+	}
+	for y := range want {
+		if len(got[y]) != len(want[y]) {
+			Fail(ht, "%s: line %d has %d cells, model has %d\nrendered %q\ngot   %q\nmodel %q", what, y, len(got[y]), len(want[y]), out, RowsPlain(got), RowsPlain(want))
+		}
+		for x := range want[y] {
+			if !SameCell(got[y][x], want[y][x]) {
+				Fail(ht, "%s: line %d cell %d is %s, model %s\nrendered %q\nrow got   %s\nrow model %s", what, y, x, got[y][x], want[y][x], out, RowsRow(got[y]), RowsRow(want[y]))
+			}
+		}
+	}
+}
+
+func RowWidth(r []MCell) int {
+	w := 0
+	for _, c := range r {
+		w += c.W
+	}
+	return w
+}
