@@ -0,0 +1,230 @@
+package table
+
+// One narrow property per recorded bug of the table package: each draws the bug's shape
+// region with random contents and judges it by the same model as the wide property, so by
+// default it fails naming the bug; under HEGEL_NO_KNOWN=1 it draws the neighbouring region
+// and passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// plainTables: a table without styles or a Height, whose cells have no newlines.
+var plainTables = hegel.Map(tables, func(sp tableSpec) tableSpec {
+	sp.styles, sp.styled = nil, false
+	sp.hasHeight, sp.height, sp.yOffset = false, 0, 0
+	for i, row := range sp.rows {
+		for j, c := range row {
+			sp.rows[i][j] = strings.ReplaceAll(c, "\n", "")
+		}
+	}
+	return sp
+})
+
+// TestHegelTableWidthCountsTheBorders: a Width between the content and the content plus
+// the borders shrinks the columns to fit (lipgloss/8); under HEGEL_NO_KNOWN=1 a Width
+// beyond the content plus the borders.
+func TestHegelTableWidthCountsTheBorders(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, plainTables)
+		sp.left, sp.rgt, sp.fit = true, true, false
+		if len(sp.rows) == 0 {
+			sp.rows = [][]string{hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))}
+		}
+		st := sp.columnStats()
+		content := sumOf(maxWidths(st))
+		if known.TableWidthIgnoresBorders {
+			sp.width = content + sp.borderCount() + hegel.Draw(ht, hegel.Integers(0, 6))
+		} else {
+			sp.width = content + hegel.Draw(ht, hegel.Integers(0, sp.borderCount()-1))
+		}
+		checkTable(ht, sp, nil)
+	})
+}
+
+// sparseTables: three or four columns of narrow cells with column separators and no side
+// borders. The first column holds one cell of l graphemes among cells of at most one (so it
+// is the column furthest above its median) and is narrower than the others, which hold u
+// graphemes except in the first row (a shorter cell there keeps their floor below u without
+// touching their median, which skips the first row). The Width is one or two below the
+// content, so the k = separators + 1..2 cells to cut all come from the first column
+// (l > k) in the median pass (lipgloss/9 breaks there and cuts the biggest column instead).
+// Under HEGEL_NO_KNOWN=1 the sparse column is the last one.
+var sparseTables = hegel.Map(hegel.Composite(func(tc hegel.TestCase) tableSpec {
+	sp := hegel.Draw(tc, plainTables)
+	sp.cols = hegel.Draw(tc, hegel.Integers(3, 4))
+	sp.headers = nil
+	sp.left, sp.rgt, sp.col = false, false, true
+	n := hegel.Draw(tc, hegel.Integers(3, 5))
+	long := hegel.Draw(tc, hegel.Integers(0, n-1))
+	extra := hegel.Draw(tc, hegel.Integers(1, 2))
+	k := sp.cols - 1 + extra
+	u := hegel.Draw(tc, hegel.Integers(k+2, 10))
+	l := hegel.Draw(tc, hegel.Integers(k+1, u-1))
+	short := hegel.Map(counted(pick(narrow...), 0, 1), func(gs []string) string { return strings.Join(gs, "") })
+	ofWidth := func(w int) hegel.Generator[string] {
+		return hegel.Map(hegel.Lists(pick(narrow...)).MinSize(w).MaxSize(w), func(gs []string) string { return strings.Join(gs, "") })
+	}
+	sp.rows = make([][]string, n)
+	for i := range sp.rows {
+		sp.rows[i] = make([]string, sp.cols)
+		for j := range sp.rows[i] {
+			switch {
+			case j == 0 && i == long:
+				sp.rows[i][j] = hegel.Draw(tc, ofWidth(l))
+			case j == 0:
+				sp.rows[i][j] = hegel.Draw(tc, short)
+			case i == 0:
+				sp.rows[i][j] = hegel.Draw(tc, ofWidth(u-hegel.Draw(tc, hegel.Integers(1, 2))))
+			default:
+				sp.rows[i][j] = hegel.Draw(tc, ofWidth(u))
+			}
+		}
+	}
+	sp.fit = false
+	sp.width = sumOf(maxWidths(sp.columnStats())) - extra
+	return sp
+}), func(sp tableSpec) tableSpec {
+	if known.ShrinkSkipsFirstColumn {
+		for _, row := range sp.rows {
+			row[0], row[len(row)-1] = row[len(row)-1], row[0]
+		}
+	}
+	return sp
+})
+
+// TestHegelShrinkingReachesTheFirstColumn: the column furthest above its median is the
+// one shrunk, the first column included.
+func TestHegelShrinkingReachesTheFirstColumn(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkTable(ht, hegel.Draw(ht, sparseTables), nil)
+	})
+}
+
+// TestHegelBottomBorderSurvivesHeightWithoutHeaders: a table without headers or a header
+// separator, with a Height that allows every line, keeps its bottom border (lipgloss/10);
+// under HEGEL_NO_KNOWN=1 the header separator is on.
+func TestHegelBottomBorderSurvivesHeightWithoutHeaders(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, plainTables)
+		sp.headers, sp.hdr, sp.bot = nil, known.BottomBorderClippedNoHeaders, true
+		if len(sp.rows) == 0 {
+			sp.rows = [][]string{hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))}
+		}
+		sp.hasHeight, sp.yOffset = true, 0
+		sp.height = hegel.Draw(ht, hegel.Integers(1, 12))
+		checkTable(ht, sp, nil)
+	})
+}
+
+// TestHegelHeaderHeightFollowsEveryColumn: the header row is as tall as its tallest cell
+// frame (lipgloss/11 takes the last column's); under HEGEL_NO_KNOWN=1 every header column
+// has the same vertical padding.
+func TestHegelHeaderHeightFollowsEveryColumn(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, plainTables)
+		sp.cols = max(sp.cols, 2)
+		sp.wrap = true
+		if len(sp.rows) == 0 {
+			sp.rows = [][]string{hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))}
+		}
+		for i := range sp.rows {
+			for len(sp.rows[i]) < sp.cols {
+				sp.rows[i] = append(sp.rows[i], "")
+			}
+		}
+		sp.headers = hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))
+		sp.styled = true
+		pads := hegel.Draw(ht, hegel.Lists(pair01).MinSize(sp.cols).MaxSize(sp.cols))
+		if known.HeaderHeightFollowsLastColumn {
+			for j := range pads {
+				pads[j] = pads[0]
+			}
+		} else {
+			pads[0] = [2]int{1, hegel.Draw(ht, hegel.Integers(0, 1))}
+			pads[sp.cols-1] = [2]int{}
+		}
+		for j, p := range pads {
+			sp.styles = append(sp.styles, cellStyle{-1, j, cellSpec{padT: p[0], padB: p[1]}})
+		}
+		checkTable(ht, sp, nil)
+	})
+}
+
+// multiLineTables: tables whose cells have newlines three times in ten.
+var multiLineTables = hegel.Map(hegel.Composite(func(tc hegel.TestCase) tableSpec {
+	sp := hegel.Draw(tc, plainTables)
+	if len(sp.rows) == 0 {
+		sp.rows = [][]string{hegel.Draw(tc, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))}
+	}
+	multi := cellsOf(30)
+	for i := range sp.rows {
+		for j := range sp.rows[i] {
+			sp.rows[i][j] = hegel.Draw(tc, multi)
+		}
+	}
+	return sp
+}), func(sp tableSpec) tableSpec {
+	sp.wrap = known.NoWrapDropsLines
+	return sp
+})
+
+// TestHegelNoWrapKeepsEveryLine: a multi-line cell without wrapping shows its lines or an
+// ellipsis (lipgloss/12); under HEGEL_NO_KNOWN=1 the same cells wrapped.
+func TestHegelNoWrapKeepsEveryLine(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkTable(ht, hegel.Draw(ht, multiLineTables), nil)
+	})
+}
+
+// TestHegelOverflowRowTakesItsOwnPadding: with headers and a Height that leaves rows unseen,
+// the overflow row is as tall as its own vertical padding asks (lipgloss/13 reads the
+// previous row's); under HEGEL_NO_KNOWN=1 the same without headers.
+func TestHegelOverflowRowTakesItsOwnPadding(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, plainTables)
+		sp.wrap = true
+		n := hegel.Draw(ht, hegel.Integers(3, 5))
+		sp.rows = hegel.Draw(ht, hegel.Lists(hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols)).MinSize(n).MaxSize(n))
+		sp.headers = hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))
+		if known.OverflowRowPaddingOffByOne {
+			sp.headers = nil
+		}
+		sp.styled = true
+		for r := 0; r < n; r++ {
+			if hegel.Draw(ht, chance(60)) {
+				sp.styles = append(sp.styles, cellStyle{r, 0, cellSpec{padT: 1}})
+			}
+		}
+		sp.hasHeight, sp.yOffset = true, 0
+		sp.height = hegel.Draw(ht, hegel.Integers(3, 6))
+		checkTable(ht, sp, nil)
+	})
+}
+
+// TestHegelNoWrapKeepsVerticalPadding: a padded cell without wrapping keeps its text in a
+// row tall enough (lipgloss/18); under HEGEL_NO_KNOWN=1 the same cells wrapped.
+func TestHegelNoWrapKeepsVerticalPadding(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, plainTables)
+		sp.wrap = known.NoWrapIgnoresVerticalPadding
+		if len(sp.rows) == 0 {
+			sp.rows = [][]string{hegel.Draw(ht, hegel.Lists(flatCells).MinSize(sp.cols).MaxSize(sp.cols))}
+		}
+		sp.styled = true
+		for r := -1; r < len(sp.rows); r++ {
+			if r == -1 && !sp.hasHeaders() {
+				continue
+			}
+			for c := 0; c < sp.cols; c++ {
+				if p := hegel.Draw(ht, maybe(40, pair01)); p != [2]int{} {
+					sp.styles = append(sp.styles, cellStyle{r, c, cellSpec{padT: p[0], padB: p[1]}})
+				}
+			}
+		}
+		checkTable(ht, sp, nil)
+	})
+}
diff --git a/table/hegel_test.go b/table/hegel_test.go
new file mode 100644
index 0000000..edd8647
--- /dev/null
+++ b/table/hegel_test.go
@@ -0,0 +1,1180 @@
+package table
+
+// Hegel property tests for charm.land/lipgloss/v2/table (hegel-zoo target go/lipgloss).
+//
+// A random table (headers, rows, borders, per-cell styles, Width/FitContent/Wrap/Height/
+// YOffset) is drawn as a record, rendered and read back as a grid: the column widths and row
+// heights must be the documented resizer's, the border lines exactly the ones the widths and
+// border runes prescribe, every cell region must hold its cell's text (wrapped, or truncated
+// with "…"), and the visible-row bookkeeping must match what was drawn. The shapes of
+// lipgloss/8-13 and /18 are drawn as steady alternatives and named on a mismatch; under
+// HEGEL_NO_KNOWN=1 the generators keep out of them and the model follows the implementation
+// where a switch says so.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"charm.land/lipgloss/v2/internal/zootest"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func property(t *testing.T, fn func(ht *hegel.T)) { zootest.Property(t, fn) }
+
+func fail(ht *hegel.T, format string, args ...any) { zootest.Fail(ht, format, args...) }
+
+func count(name string) { zootest.Count(name) }
+
+func note(ht *hegel.T, format string, args ...any) { zootest.Note(ht, format, args...) }
+
+func guard(t *testing.T) { zootest.Guard(t) }
+
+func mismatch(ht *hegel.T, sh []string, format string, args ...any) {
+	zootest.Mismatch(ht, sh, format, args...)
+}
+
+var known = &zootest.Known
+
+type shapes = zootest.Shapes
+
+func weighted[T any](choices ...zootest.Choice[T]) hegel.Generator[T] {
+	return zootest.Weighted(choices...)
+}
+
+func w[T any](weight int, g hegel.Generator[T]) zootest.Choice[T] { return zootest.W(weight, g) }
+
+func unless(sw bool, weight int) int { return zootest.Unless(sw, weight) }
+
+func chance(pct int) hegel.Generator[bool] { return zootest.Chance(pct) }
+
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] { return zootest.Maybe(pct, g) }
+
+func pick[T any](xs ...T) hegel.Generator[T] { return zootest.Pick(xs...) }
+
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return zootest.Counted(g, lo, hi)
+}
+
+// ---------------------------------------------------------------- cells
+
+var (
+	narrow = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "+", "="}
+	wide   = []string{"世", "界", "😃", "Ａ"}
+)
+
+// cellPiecesOf is one grapheme of a cell: narrow, a space, a wide one, or a newline with
+// weight nl.
+func cellPiecesOf(nl int) hegel.Generator[string] {
+	return weighted(w(61, pick(narrow...)), w(15, hegel.Just(" ")), w(20, pick(wide...)), w(nl, hegel.Just("\n")))
+}
+
+// cellsOf is a cell of zero to nine graphemes.
+func cellsOf(nl int) hegel.Generator[string] {
+	return hegel.Map(counted(cellPiecesOf(nl), 0, 9), func(gs []string) string { return strings.Join(gs, "") })
+}
+
+var (
+	// cells: a cell with a newline one time in twenty-five.
+	cells = cellsOf(4)
+	// flatCells: a cell without newlines (headers; and the rows of a table without wrapping
+	// under HEGEL_NO_KNOWN=1, beside lipgloss/12).
+	flatCells = cellsOf(0)
+)
+
+// cellSpec is the per-position style the StyleFunc returns.
+type cellSpec struct {
+	padL, padR, padT, padB int
+	marL, marR             int
+	width, height          int
+	bg                     bool
+	align                  lipgloss.Position
+}
+
+func (c cellSpec) style() lipgloss.Style {
+	s := lipgloss.NewStyle().Padding(c.padT, c.padR, c.padB, c.padL).Margin(0, c.marR, 0, c.marL).AlignHorizontal(c.align)
+	if c.width > 0 {
+		s = s.Width(c.width)
+	}
+	if c.height > 0 {
+		s = s.Height(c.height)
+	}
+	if c.bg {
+		s = s.Background(lipgloss.Color("4"))
+	}
+	return s
+}
+
+func (c cellSpec) xpad() int { return c.padL + c.padR + c.marL + c.marR }
+
+func (c cellSpec) ypad() int { return c.padT + c.padB }
+
+func (c cellSpec) String() string {
+	return fmt.Sprintf("pad %d,%d,%d,%d mar %d,%d w%d h%d bg %v align %v", c.padT, c.padR, c.padB, c.padL, c.marL, c.marR, c.width, c.height, c.bg, c.align)
+}
+
+var (
+	pair01 = hegel.Composite(func(tc hegel.TestCase) [2]int {
+		return [2]int{hegel.Draw(tc, hegel.Integers(0, 1)), hegel.Draw(tc, hegel.Integers(0, 1))}
+	})
+	aligns = pick(lipgloss.Left, lipgloss.Center, lipgloss.Right)
+)
+
+// cellSpecsOf is a cell style for a table that wraps (or not) and has a table width (or
+// not): horizontal padding, an alignment, a background in three; vertical padding one time in
+// five (not without wrapping under HEGEL_NO_KNOWN=1: lipgloss/18), margins in seven, a fixed
+// width in ten (not with a table width: the resizer cannot honour both), a height in ten
+// (one line only without wrapping under HEGEL_NO_KNOWN=1: lipgloss/12).
+func cellSpecsOf(wrap, tableWidth bool) hegel.Generator[cellSpec] {
+	vpad := 20
+	if !wrap {
+		vpad = unless(known.NoWrapIgnoresVerticalPadding, 20)
+	}
+	widths := 10
+	if tableWidth {
+		widths = 0
+	}
+	heights := hegel.Integers(1, 3)
+	if !wrap && known.NoWrapDropsLines {
+		heights = hegel.Just(1)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) cellSpec {
+		var cs cellSpec
+		h := hegel.Draw(tc, pair01)
+		cs.padL, cs.padR = h[0], h[1]
+		cs.align = hegel.Draw(tc, aligns)
+		cs.bg = hegel.Draw(tc, chance(30))
+		if v := hegel.Draw(tc, maybe(vpad, pair01)); v != [2]int{} {
+			cs.padT, cs.padB = v[0], v[1]
+		}
+		if m := hegel.Draw(tc, maybe(15, pair01)); m != [2]int{} {
+			cs.marL, cs.marR = m[0], m[1]
+		}
+		cs.width = hegel.Draw(tc, maybe(widths, hegel.Integers(2, 8)))
+		cs.height = hegel.Draw(tc, maybe(10, heights))
+		return cs
+	})
+}
+
+// ---------------------------------------------------------------- the table record
+
+// cellStyle is a styled position: the row (-1 the header row) and column.
+type cellStyle struct {
+	row, col int
+	spec     cellSpec
+}
+
+type tableSpec struct {
+	headers   []string
+	rows      [][]string
+	cols      int
+	bName     string
+	top, bot  bool
+	left, rgt bool
+	hdr, col  bool
+	row       bool
+	width     int
+	fit       bool
+	wrap      bool
+	height    int
+	hasHeight bool
+	yOffset   int
+	styles    []cellStyle
+	styled    bool
+}
+
+var borders = map[string]lipgloss.Border{
+	"normal": lipgloss.NormalBorder(), "rounded": lipgloss.RoundedBorder(), "thick": lipgloss.ThickBorder(),
+	"double": lipgloss.DoubleBorder(), "ascii": lipgloss.ASCIIBorder(), "markdown": lipgloss.MarkdownBorder(),
+	"hidden": lipgloss.HiddenBorder(), "block": lipgloss.BlockBorder(),
+}
+
+var borderNames = []string{"normal", "rounded", "thick", "double", "ascii", "markdown", "hidden", "block"}
+
+func (sp tableSpec) border() lipgloss.Border { return borders[sp.bName] }
+
+func (sp tableSpec) hasHeaders() bool { return len(sp.headers) > 0 }
+
+// styleAt is the style at a position (the zero style where none was drawn).
+func (sp tableSpec) styleAt(row, col int) cellSpec {
+	for _, s := range sp.styles {
+		if s.row == row && s.col == col {
+			return s.spec
+		}
+	}
+	return cellSpec{}
+}
+
+func (sp tableSpec) build() *Table {
+	t := New().Border(sp.border()).BorderTop(sp.top).BorderBottom(sp.bot).BorderLeft(sp.left).BorderRight(sp.rgt).
+		BorderHeader(sp.hdr).BorderColumn(sp.col).BorderRow(sp.row).Wrap(sp.wrap)
+	if sp.hasHeaders() {
+		t = t.Headers(sp.headers...)
+	}
+	t = t.Rows(sp.rows...)
+	if sp.width > 0 {
+		t = t.Width(sp.width)
+		if sp.fit {
+			t = t.FitContent()
+		}
+	}
+	if sp.hasHeight {
+		t = t.Height(sp.height).YOffset(sp.yOffset)
+	}
+	if sp.styled {
+		t = t.StyleFunc(func(row, col int) lipgloss.Style { return sp.styleAt(row, col).style() })
+	}
+	return t
+}
+
+func (sp tableSpec) GoString() string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "table %d cols", sp.cols)
+	if sp.hasHeaders() {
+		fmt.Fprintf(&sb, " headers %q", sp.headers)
+	}
+	fmt.Fprintf(&sb, " rows %q border %s", sp.rows, sp.bName)
+	fmt.Fprintf(&sb, " sides t%v b%v l%v r%v hdr %v col %v row %v wrap %v", sp.top, sp.bot, sp.left, sp.rgt, sp.hdr, sp.col, sp.row, sp.wrap)
+	if sp.width > 0 {
+		fmt.Fprintf(&sb, " width %d", sp.width)
+		if sp.fit {
+			sb.WriteString(" fit")
+		}
+	}
+	if sp.hasHeight {
+		fmt.Fprintf(&sb, " height %d yoffset %d", sp.height, sp.yOffset)
+	}
+	if sp.styled {
+		sb.WriteString(" styles")
+		for _, s := range sp.styles {
+			fmt.Fprintf(&sb, " (%d,%d: %s)", s.row, s.col, s.spec)
+		}
+	}
+	return sb.String()
+}
+
+// tables: the table record. The wrap flag and the width are drawn first so that the cells
+// and styles can keep out of the regions of lipgloss/12 and /18 under HEGEL_NO_KNOWN=1;
+// the header styles share one vertical padding there (lipgloss/11).
+var tables = hegel.Composite(func(tc hegel.TestCase) tableSpec {
+	var sp tableSpec
+	sp.cols = hegel.Draw(tc, hegel.Integers(1, 4))
+	sp.wrap = hegel.Draw(tc, chance(70))
+	sp.width = hegel.Draw(tc, maybe(50, hegel.Integers(1, 40)))
+	if sp.width > 0 {
+		sp.fit = hegel.Draw(tc, chance(25))
+	}
+	rowCells := cells
+	if !sp.wrap && known.NoWrapDropsLines {
+		rowCells = flatCells
+	}
+	if hegel.Draw(tc, chance(60)) {
+		n := sp.cols
+		// Fewer headers than columns are padded with empty ones by the table.
+		if sp.cols > 1 && hegel.Draw(tc, chance(20)) {
+			n--
+		}
+		sp.headers = hegel.Draw(tc, hegel.Lists(flatCells).MinSize(n).MaxSize(n))
+	}
+	sp.rows = hegel.Draw(tc, counted(hegel.Lists(rowCells).MinSize(sp.cols).MaxSize(sp.cols), 0, 5))
+	if len(sp.rows) == 0 && sp.hasHeaders() {
+		// Without rows the headers are not padded: the table has as many columns as headers.
+		sp.cols = len(sp.headers)
+	}
+	sp.bName = hegel.Draw(tc, pick(borderNames...))
+	sp.top, sp.bot, sp.left, sp.rgt = hegel.Draw(tc, chance(80)), hegel.Draw(tc, chance(80)), hegel.Draw(tc, chance(80)), hegel.Draw(tc, chance(80))
+	sp.hdr, sp.col, sp.row = hegel.Draw(tc, chance(80)), hegel.Draw(tc, chance(80)), hegel.Draw(tc, chance(40))
+	if hegel.Draw(tc, chance(30)) {
+		sp.height = hegel.Draw(tc, hegel.Integers(1, 12))
+		sp.hasHeight = true
+		sp.yOffset = hegel.Draw(tc, maybe(50, hegel.Integers(0, len(sp.rows))))
+	}
+	if hegel.Draw(tc, chance(50)) {
+		sp.styled = true
+		specs := cellSpecsOf(sp.wrap, sp.width > 0)
+		shared := hegel.Draw(tc, maybe(20, pair01))
+		if !sp.wrap && known.NoWrapIgnoresVerticalPadding {
+			shared = [2]int{}
+		}
+		for r := -1; r < len(sp.rows); r++ {
+			if r == -1 && !sp.hasHeaders() {
+				continue
+			}
+			for c := 0; c < sp.cols; c++ {
+				has := hegel.Draw(tc, chance(50))
+				uniform := r == -1 && known.HeaderHeightFollowsLastColumn
+				if !has && !uniform {
+					continue
+				}
+				var cs cellSpec
+				if has {
+					cs = hegel.Draw(tc, specs)
+				}
+				if uniform {
+					cs.padT, cs.padB = shared[0], shared[1]
+				}
+				sp.styles = append(sp.styles, cellStyle{r, c, cs})
+			}
+		}
+	}
+	return sp
+})
+
+// ---------------------------------------------------------------- the resizer model
+
+// colStats is what the resizer knows of a column: the widest and narrowest cell, the median
+// of the cells after the first row, the largest horizontal frame and the fixed style width.
+type colStats struct {
+	max, min, median, xpad, fixed int
+}
+
+// allRows is the header row (padded to the column count) followed by the data rows.
+func (sp tableSpec) allRows() [][]string {
+	var all [][]string
+	if sp.hasHeaders() {
+		h := make([]string, sp.cols)
+		copy(h, sp.headers)
+		all = append(all, h)
+	}
+	return append(all, sp.rows...)
+}
+
+// rowIndex is the StyleFunc's row for the i-th of allRows.
+func (sp tableSpec) rowIndex(i int) int {
+	if sp.hasHeaders() {
+		return i - 1
+	}
+	return i
+}
+
+func medianOf(ws []int) int {
+	n := append([]int(nil), ws...)
+	sort.Ints(n)
+	if len(n) == 0 {
+		return 0
+	}
+	if len(n)%2 == 0 {
+		h := len(n) / 2
+		return (n[h-1] + n[h]) / 2
+	}
+	return n[len(n)/2]
+}
+
+func (sp tableSpec) columnStats() []colStats {
+	all := sp.allRows()
+	st := make([]colStats, sp.cols)
+	for j := 0; j < sp.cols; j++ {
+		var ws []int
+		for i, row := range all {
+			wd := lipgloss.Width(row[j])
+			if i == 0 {
+				st[j].max, st[j].min = wd, wd
+			} else {
+				st[j].max, st[j].min = max(st[j].max, wd), min(st[j].min, wd)
+				ws = append(ws, wd)
+			}
+			cs := sp.styleAt(sp.rowIndex(i), j)
+			st[j].xpad = max(st[j].xpad, cs.xpad())
+			st[j].fixed = max(st[j].fixed, cs.width)
+		}
+		st[j].median = medianOf(ws)
+	}
+	return st
+}
+
+func (sp tableSpec) borderCount() int {
+	return btoi(sp.left) + btoi(sp.rgt) + (sp.cols-1)*btoi(sp.col)
+}
+
+// maxWidths is each column's widest cell plus its frame, or its fixed width.
+func maxWidths(st []colStats) []int {
+	ws := make([]int, len(st))
+	for j, c := range st {
+		if c.fixed > 0 {
+			ws[j] = c.fixed
+		} else {
+			ws[j] = c.max + c.xpad
+		}
+	}
+	return ws
+}
+
+func sumOf(xs []int) int {
+	s := 0
+	for _, x := range xs {
+		s += x
+	}
+	return s
+}
+
+// tableWidth is the width the resizer works towards: the one asked, the content's without
+// one, the smaller of the two with FitContent.
+func (sp tableSpec) tableWidth(st []colStats) int {
+	detect := sumOf(maxWidths(st)) + sp.borderCount()
+	switch {
+	case sp.width <= 0:
+		return detect
+	case sp.fit && detect < sp.width:
+		return detect
+	}
+	return sp.width
+}
+
+// modelWidths is the documented resizer: a table narrower than the width asked has its
+// shortest columns widened one cell at a time; a wider one is shrunk in three passes - the
+// columns at half the table or more first, then the column furthest above its median, then
+// the biggest - each respecting a column's floor (its frame plus its narrowest cell), and
+// again without the floor if that was not enough. Fixed-width columns are left alone. The
+// decision to shrink counts the borders (lipgloss/8 does not); the median pass reaches the
+// first column (lipgloss/9 does not). The shapes are reported with the widths.
+func (sp tableSpec) modelWidths(st []colStats) (widths []int, shape8, shape9 bool) {
+	tw := sp.tableWidth(st)
+	borders := sp.borderCount()
+	widths = maxWidths(st)
+	maxTotal := sumOf(widths)
+	shape8 = maxTotal <= tw && tw < maxTotal+borders
+	expand := maxTotal+borders <= tw
+	if known.TableWidthIgnoresBorders {
+		expand = maxTotal <= tw
+	}
+	if expand {
+		for sumOf(widths)+borders < tw {
+			shortest, shortestWidth := 0, int(^uint(0)>>1)
+			for j, wd := range widths {
+				if wd == st[j].fixed {
+					continue
+				}
+				if wd < shortestWidth {
+					shortest, shortestWidth = j, wd
+				}
+			}
+			widths[shortest]++
+		}
+		return widths, shape8, false
+	}
+	floor := func(j int) int { return st[j].xpad + max(st[j].min, 1) }
+	shrinkBiggest := func(veryBigOnly, useFloor bool) {
+		for sumOf(widths)+borders > tw {
+			big, bigWidth := -1, -1
+			for j, wd := range widths {
+				if wd == st[j].fixed || (useFloor && wd <= floor(j)) {
+					continue
+				}
+				if veryBigOnly && wd < tw/2 {
+					continue
+				}
+				if wd > bigWidth {
+					big, bigWidth = j, wd
+				}
+			}
+			if big < 0 || widths[big] == 0 {
+				break
+			}
+			widths[big]--
+		}
+	}
+	shrinkToMedian := func(useFloor bool) {
+		for sumOf(widths)+borders > tw {
+			best, bestDiff := -1, 0
+			for j, wd := range widths {
+				if wd == st[j].fixed || (useFloor && wd <= floor(j)) {
+					continue
+				}
+				if d := wd - st[j].median; d > 0 && d > bestDiff {
+					best, bestDiff = j, d
+				}
+			}
+			if best == 0 {
+				shape9 = true
+				if known.ShrinkSkipsFirstColumn {
+					break
+				}
+			}
+			if best < 0 || widths[best] == 0 {
+				break
+			}
+			widths[best]--
+		}
+	}
+	shrinkBiggest(true, true)
+	shrinkToMedian(true)
+	shrinkBiggest(false, true)
+	if sumOf(widths)+borders > tw {
+		shrinkBiggest(true, false)
+		shrinkToMedian(false)
+		shrinkBiggest(false, false)
+	}
+	return widths, shape8, shape9
+}
+
+// contentHeight is the lines a cell takes when wrapped to a width (x/ansi's wrap is the
+// oracle here, as in the resizer).
+func contentHeight(content string, width int) int {
+	if width == 0 {
+		return 1
+	}
+	content = strings.ReplaceAll(content, "\r\n", "\n")
+	h := 0
+	for _, line := range strings.Split(content, "\n") {
+		h += strings.Count(ansi.Wrap(line, width, ""), "\n") + 1
+	}
+	return h
+}
+
+// modelHeights is each row's height: the style heights at least; with wrapping the header is
+// one line plus its tallest vertical frame (lipgloss/11 takes the last column's) and a data
+// row holds its tallest wrapped cell with its frame; without wrapping a row holds one line
+// plus its tallest frame (lipgloss/18 forgets the frame).
+func (sp tableSpec) modelHeights(widths []int, st []colStats) (heights []int, shape11, shape18 bool) {
+	all := sp.allRows()
+	heights = make([]int, len(all))
+	for i, row := range all {
+		h := 1
+		for j := range row {
+			h = max(h, sp.styleAt(sp.rowIndex(i), j).height)
+		}
+		header := i == 0 && sp.hasHeaders()
+		switch {
+		case !sp.wrap:
+			for j := range row {
+				if yp := sp.styleAt(sp.rowIndex(i), j).ypad(); yp > 0 {
+					shape18 = true
+					if !known.NoWrapIgnoresVerticalPadding {
+						h = max(h, 1+yp)
+					}
+				}
+			}
+		case header:
+			h = 1 + sp.styleAt(-1, len(row)-1).ypad()
+			for j := range row {
+				yp := sp.styleAt(-1, j).ypad()
+				if yp != sp.styleAt(-1, len(row)-1).ypad() {
+					shape11 = true
+				}
+				if !known.HeaderHeightFollowsLastColumn {
+					h = max(h, 1+yp)
+				}
+			}
+		default:
+			for j, cell := range row {
+				cs := sp.styleAt(sp.rowIndex(i), j)
+				h = max(h, contentHeight(cell, widths[j]-st[j].xpad)+cs.ypad())
+			}
+		}
+		heights[i] = h
+	}
+	return heights, shape11, shape18
+}
+
+// ---------------------------------------------------------------- the grid check
+
+// graphemesNoSpace returns the non-blank graphemes of a plain string in order.
+func graphemesNoSpace(s string) []string {
+	var out []string
+	for _, row := range zootest.ParseCells(s) {
+		for _, c := range row {
+			if zootest.IsSpaceCell(c.G) || c.G == "\n" {
+				continue
+			}
+			out = append(out, c.G)
+		}
+	}
+	return out
+}
+
+// edge builds a horizontal border line from the widths and the runes for the corners, the
+// fill and the junction.
+func edge(sp tableSpec, widths []int, l, fill, mid, r string) string {
+	var sb strings.Builder
+	if sp.left {
+		sb.WriteString(l)
+	}
+	for j, w := range widths {
+		sb.WriteString(strings.Repeat(fill, w))
+		if j < len(widths)-1 && sp.col {
+			sb.WriteString(mid)
+		}
+	}
+	if sp.rgt {
+		sb.WriteString(r)
+	}
+	return sb.String()
+}
+
+// verticalPadding reports whether any header or cell style has vertical padding.
+func verticalPadding(sp tableSpec) bool {
+	for _, s := range sp.styles {
+		if s.spec.ypad() > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// hasWide reports whether any header or cell contains a wide grapheme.
+func hasWide(sp tableSpec) bool {
+	all := strings.Join(sp.headers, "")
+	for _, row := range sp.rows {
+		all += strings.Join(row, "")
+	}
+	return strings.ContainsAny(all, strings.Join(wide, ""))
+}
+
+// leadingSpaceLine reports a header or a cell line that starts with a space.
+func leadingSpaceLine(sp tableSpec) bool {
+	for _, h := range sp.headers {
+		if strings.HasPrefix(h, " ") {
+			return true
+		}
+	}
+	for _, row := range sp.rows {
+		for _, c := range row {
+			if strings.Contains("\n"+c, "\n ") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// checkTable renders the table and checks the widths, heights, border lines, cell regions
+// and visible-row bookkeeping against the model, naming the shapes met on a mismatch.
+func checkTable(ht *hegel.T, sp tableSpec, sh shapes) {
+	tb := sp.build()
+	out := tb.String()
+	note(ht, "rendered\n%s", out)
+	hasHeaders := sp.hasHeaders()
+	if !hasHeaders && len(sp.rows) == 0 {
+		if out != "" {
+			fail(ht, "empty table rendered %q", out)
+		}
+		count("empty")
+		return
+	}
+	if again := tb.String(); again != out {
+		fail(ht, "String() is not idempotent:\n%s\nthen\n%s", out, again)
+	}
+	first, last := tb.firstVisibleRowIndex, tb.lastVisibleRowIndex
+	if !hasHeaders && !sp.top && !sp.bot && last == -2 && first >= len(sp.rows) {
+		// Every row is offset away and there is no frame: nothing is rendered.
+		if out != "" {
+			fail(ht, "YOffset(%d) past the %d rows with no frame rendered %q", sp.yOffset, len(sp.rows), out)
+		}
+		count("nothing-visible")
+		return
+	}
+	failf := func(format string, args ...any) {
+		mismatch(ht, sh, format+"\nspec %#v", append(args, sp)...)
+	}
+	lines := strings.Split(out, "\n")
+	plain := make([]string, len(lines))
+	for i, l := range lines {
+		plain[i] = ansi.Strip(l)
+	}
+	// Widths and heights against the resizer model.
+	st := sp.columnStats()
+	minTotal := sp.borderCount()
+	for j := range st {
+		minTotal += st[j].xpad + 1
+	}
+	if sp.width > 0 && sp.width < minTotal {
+		// Impossible budget: columns narrower than their own frame render wider than
+		// their column and the grid falls apart; nothing to check here.
+		count("width-below-minimum")
+		ht.Assume(false)
+	}
+	wantWidths, shape8, shape9 := sp.modelWidths(st)
+	sh.Add("lipgloss/8", shape8)
+	sh.Add("lipgloss/9", shape9)
+	if shape9 && known.ShrinkSkipsFirstColumn {
+		count("lipgloss/9-shape")
+	}
+	widths, heights := tb.widths, tb.heights
+	if fmt.Sprint(widths) != fmt.Sprint(wantWidths) {
+		failf("columns are %v wide, the resizer model says %v (table width %d, borders %d):\n%s", widths, wantWidths, sp.tableWidth(st), sp.borderCount(), out)
+	}
+	wantHeights, shape11, shape18 := sp.modelHeights(widths, st)
+	sh.Add("lipgloss/11", shape11)
+	sh.Add("lipgloss/18", shape18)
+	if fmt.Sprint(heights) != fmt.Sprint(wantHeights) {
+		failf("rows are %v tall, the model says %v:\n%s", heights, wantHeights, out)
+	}
+	// Per-column model gaps: a fixed style width below another cell's frame overflows the
+	// column; a style width with a table width cannot both be honoured.
+	for j := range widths {
+		if st[j].fixed > 0 && st[j].fixed < st[j].xpad+1 {
+			count("fixed-width-below-frame")
+			ht.Assume(false)
+		}
+		if st[j].fixed > 0 && sp.width > 0 {
+			count("fixed-width-with-table-width")
+			ht.Assume(false)
+		}
+	}
+	// Rectangular.
+	w0 := 0
+	for _, l := range lines {
+		w0 = max(w0, ansi.StringWidth(l))
+	}
+	for i, l := range lines {
+		if w := ansi.StringWidth(l); w != w0 {
+			if sp.width > 0 && w0 == sp.width && w == w0-1 && hasWide(sp) {
+				// A wide grapheme cut by MaxWidth at the right edge leaves its line one
+				// cell short, as any cell clipping would.
+				count("wide-cut-at-edge")
+				continue
+			}
+			if !sp.wrap && leadingSpaceLine(sp) {
+				// x-ansi/19: a truncated cell whose line starts with a space wraps one
+				// cell too wide and MaxWidth cuts the border off.
+				count("x-ansi-wrap-shape")
+				ht.Assume(false)
+			}
+			failf("line %d has width %d, line 0 has %d:\n%s", i, w, w0, out)
+		}
+	}
+	borders := sp.borderCount()
+	natural := sumOf(widths) + borders
+	if natural == 0 {
+		// Every line is empty and the trailing-newline trim eats one: no grid to read.
+		count("zero-width-table")
+		ht.Assume(false)
+	}
+	for j, w := range widths {
+		if w == 0 && (st[j].max > 0 || tb.lastVisibleRowIndex != -2) {
+			// A column shrunk to nothing (the floorless fallback of an impossible budget)
+			// still renders its cells, Width(0) being no limit - the overflow row's "…"
+			// among them: no grid to read.
+			count("zero-width-column")
+			ht.Assume(false)
+		}
+	}
+	tw := sp.tableWidth(st)
+	switch {
+	case sp.width == 0 || tw < sp.width:
+		if w0 != natural {
+			failf("table is %d wide, columns %v + %d borders = %d:\n%s", w0, widths, borders, natural, out)
+		}
+		count("content-width")
+	default:
+		if natural != sp.width {
+			failf("Width(%d) asked, columns %v + %d borders = %d:\n%s", sp.width, widths, borders, natural, out)
+		}
+		if w0 != sp.width {
+			failf("Width(%d) asked, rendered %d wide:\n%s", sp.width, w0, out)
+		}
+		count("exact-width")
+	}
+	if w0 > natural {
+		failf("rendered %d wide, the grid is %d:\n%s", w0, natural, out)
+	}
+	clipped := w0 < natural
+	if clipped {
+		count("clipped-by-maxwidth")
+	}
+
+	// Expected line structure.
+	b := sp.border()
+	var want []string // plain expected lines; "" for content lines
+	var rowOf []int   // row index per line (-1 header, -2 border, -3 overflow)
+	if sp.top {
+		want = append(want, edge(sp, widths, b.TopLeft, b.Top, b.MiddleTop, b.TopRight))
+		rowOf = append(rowOf, -2)
+	}
+	if hasHeaders {
+		for k := 0; k < heights[0]; k++ {
+			want = append(want, "")
+			rowOf = append(rowOf, -1)
+		}
+		if sp.hdr {
+			want = append(want, edge(sp, widths, b.MiddleLeft, b.Top, b.Middle, b.MiddleRight))
+			rowOf = append(rowOf, -2)
+		}
+	}
+	if len(sp.rows) > 0 {
+		end := len(sp.rows) - 1
+		if last != -2 {
+			end = last
+		}
+		for r := first; r <= end; r++ {
+			hi := r
+			if hasHeaders {
+				hi++
+			}
+			for k := 0; k < heights[hi]; k++ {
+				want = append(want, "")
+				rowOf = append(rowOf, r)
+			}
+			if sp.row && r < len(sp.rows)-1 {
+				want = append(want, edge(sp, widths, b.MiddleLeft, b.Bottom, b.Middle, b.MiddleRight))
+				rowOf = append(rowOf, -2)
+			}
+		}
+		if last != -2 {
+			for k := 0; k < tb.overflowHeight; k++ {
+				want = append(want, "")
+				rowOf = append(rowOf, -3)
+			}
+		}
+	}
+	if sp.bot {
+		want = append(want, edge(sp, widths, b.BottomLeft, b.Bottom, b.MiddleBottom, b.BottomRight))
+		rowOf = append(rowOf, -2)
+	}
+	// lipgloss/10: computeHeight undercounts and MaxHeight clips the last lines (MaxHeight(0)
+	// is no limit, so a computeHeight of 0 clips nothing).
+	if ch := tb.computeHeight(); sp.hasHeight && ch > 0 && ch < sp.height && ch < len(want) {
+		sh.Add("lipgloss/10", true)
+		if known.BottomBorderClippedNoHeaders {
+			count("lipgloss/10-shape")
+			want, rowOf = want[:ch], rowOf[:ch]
+		}
+	}
+	if sp.hasHeight && len(lines) > sp.height {
+		failf("Height(%d) asked, %d lines rendered:\n%s", sp.height, len(lines), out)
+	}
+	// A row cut by the height limit has fewer lines than its height: its regions are not
+	// read.
+	partial := map[int]bool{}
+	if len(lines) != len(want) {
+		if sp.hasHeight && len(want) > sp.height && len(lines) == sp.height {
+			count("clipped-by-maxheight")
+			want, rowOf = want[:sp.height], rowOf[:sp.height]
+			if r := rowOf[len(rowOf)-1]; r != -2 {
+				partial[r] = true
+			}
+		} else {
+			failf("%d lines rendered, the grid has %d (rows %d..%d, heights %v):\n%s", len(lines), len(want), first, last, heights, out)
+		}
+	}
+	for i := range want {
+		if want[i] == "" {
+			continue
+		}
+		w := want[i]
+		if clipped {
+			w = ansi.Truncate(w, w0, "")
+		}
+		if plain[i] != w {
+			failf("line %d is %q, the grid wants %q:\n%s", i, plain[i], w, out)
+		}
+	}
+	// Column spans and separator positions.
+	starts := make([]int, len(widths))
+	x := 0
+	if sp.left {
+		x++
+	}
+	seps := map[int]bool{}
+	for j, w := range widths {
+		starts[j] = x
+		x += w
+		if j < len(widths)-1 && sp.col {
+			seps[x] = true
+			x++
+		}
+	}
+	// Content lines: separators in place, each region holds its cell's text.
+	type region struct{ lines []string }
+	regions := map[[2]int]*region{}
+	var keys [][2]int
+	for i, r := range rowOf {
+		if r == -2 {
+			continue
+		}
+		cellsOfLine := zootest.ParseCells(lines[i])[0]
+		parts := make([]strings.Builder, len(widths))
+		pos := 0
+		for _, c := range cellsOfLine {
+			switch {
+			case c.W == 0:
+			case seps[pos]:
+				if c.G != b.Left && !(b.Left == "" && c.G == " ") {
+					failf("line %d column separator at %d is %q, want %q:\n%s", i, pos, c.G, b.Left, out)
+				}
+			case sp.left && pos == 0:
+				if c.G != b.Left && !(b.Left == "" && c.G == " ") {
+					failf("line %d left border is %q, want %q:\n%s", i, c.G, b.Left, out)
+				}
+			case pos >= natural-btoi(sp.rgt) && sp.rgt && !clipped:
+				if c.G != b.Right && !(b.Right == "" && c.G == " ") {
+					failf("line %d right border is %q, want %q:\n%s", i, c.G, b.Right, out)
+				}
+			default:
+				j := sort.Search(len(widths), func(j int) bool { return starts[j]+widths[j] > pos })
+				if j < len(widths) && pos >= starts[j] {
+					parts[j].WriteString(c.G)
+				} else if !clipped {
+					failf("line %d cell %q at %d is in no column (spans %v %v):\n%s", i, c.G, pos, starts, widths, out)
+				}
+			}
+			pos += c.W
+		}
+		for j := range widths {
+			key := [2]int{r, j}
+			if regions[key] == nil {
+				regions[key] = &region{}
+				keys = append(keys, key)
+			}
+			regions[key].lines = append(regions[key].lines, parts[j].String())
+		}
+	}
+	if clipped {
+		count("regions-unchecked-clipped")
+		ht.Assume(false)
+	}
+	for _, key := range keys {
+		reg := regions[key]
+		r, j := key[0], key[1]
+		if partial[r] {
+			count("partial-row-unchecked")
+			continue
+		}
+		got := graphemesNoSpace(strings.Join(reg.lines, "\n"))
+		var cell string
+		switch {
+		case r == -3:
+			cell = "…"
+		case r == -1:
+			if j < len(sp.headers) {
+				cell = sp.headers[j]
+			}
+		default:
+			cell = sp.rows[r][j]
+		}
+		exp := graphemesNoSpace(cell)
+		cs := sp.styleAt(r, j)
+		inner := widths[j] - cs.xpad()
+		if inner < 2 {
+			if strings.ContainsAny(cell, strings.Join(wide, "")) {
+				// A wide cell in a column narrower than two: x/ansi's wrap and truncate
+				// shapes (x-ansi/12), not the table's.
+				count("wide-in-narrow-column")
+			} else {
+				count("region-narrower-than-two")
+			}
+			continue
+		}
+		joinedGot := strings.Join(got, "")
+		joinedExp := strings.Join(exp, "")
+		s := sh
+		s.Add("lipgloss/13", r == -3 && sp.styled && verticalPadding(sp))
+		s.Add("lipgloss/12", r >= 0 && !sp.wrap && (strings.Contains(cell, "\n") || heights[r+btoi(hasHeaders)] > 1))
+		switch {
+		case r == -3 && sp.styled && verticalPadding(sp) && joinedGot != joinedExp && known.OverflowRowPaddingOffByOne:
+			// lipgloss/13: the overflow row's height reads column 0's padding, of the
+			// wrong row when there are headers.
+			count("lipgloss/13-shape")
+		case r == -1 || !sp.wrap || r == -3:
+			// Truncated to one line (headers) or to the cell area, with "…".
+			if joinedGot == joinedExp {
+				break
+			}
+			if strings.HasSuffix(joinedGot, "…") && strings.HasPrefix(joinedExp, strings.TrimSuffix(joinedGot, "…")) {
+				count("truncated")
+				break
+			}
+			mismatch(ht, s, "cell (%d,%d) region holds %q, cell is %q:\n%s\nspec %#v", r, j, joinedGot, cell, out, sp)
+		default:
+			if joinedGot != joinedExp {
+				if cs.height > 0 || sp.hasHeight {
+					count("wrapped-cell-clipped-by-height")
+					break
+				}
+				if strings.Contains(cell, "-") || strings.Contains("\n"+cell, "\n ") {
+					// x-ansi/8 and /19: Wrap puts a breakpoint on a full line, or is
+					// confused by leading spaces; MaxWidth then clips.
+					count("x-ansi-wrap-shape")
+					break
+				}
+				mismatch(ht, s, "cell (%d,%d) region holds %q, cell is %q (wrap):\n%s\nspec %#v", r, j, joinedGot, cell, out, sp)
+			}
+		}
+	}
+	// Visible-row bookkeeping.
+	if sp.hasHeight {
+		if first < 0 || first > len(sp.rows) || (last != -2 && (last < first-1 || last >= len(sp.rows)-1)) {
+			failf("visible rows %d..%d of %d:\n%s", first, last, len(sp.rows), out)
+		}
+		if v := tb.VisibleRows(); last == -2 && v != len(sp.rows)-first || last != -2 && v != last-first+1 {
+			failf("VisibleRows() = %d, rows %d..%d of %d", v, first, last, len(sp.rows))
+		}
+	} else if first != 0 || last != -2 {
+		failf("no Height set but visible rows are %d..%d", first, last)
+	}
+	count("ok")
+}
+
+// TestHegelTableLaysOutItsGrid: Table.String against the resizer and grid model.
+func TestHegelTableLaysOutItsGrid(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkTable(ht, hegel.Draw(ht, tables), nil)
+	})
+}
+
+// ---------------------------------------------------------------- data views
+
+// dataCase: ragged rows of cells and which to keep.
+type dataCase struct {
+	cols int
+	rows [][]string
+	keep []bool
+}
+
+func (c dataCase) GoString() string {
+	return fmt.Sprintf("%d cols rows %q keep %v", c.cols, c.rows, c.keep)
+}
+
+var dataCases = hegel.Composite(func(tc hegel.TestCase) dataCase {
+	cols := hegel.Draw(tc, hegel.Integers(0, 4))
+	n := hegel.Draw(tc, hegel.Integers(0, 6))
+	rows := make([][]string, n)
+	for i := range rows {
+		rows[i] = hegel.Draw(tc, counted(cells, 0, cols))
+	}
+	return dataCase{
+		cols: cols,
+		rows: rows,
+		keep: hegel.Draw(tc, hegel.Lists(chance(60)).MinSize(n).MaxSize(n)),
+	}
+})
+
+// TestHegelTableDataViews checks Filter and DataToMatrix against the rows.
+func TestHegelTableDataViews(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, dataCases)
+		d := NewStringData(c.rows...)
+		f := NewFilter(d).Filter(func(i int) bool { return c.keep[i] })
+		var want [][]string
+		for i, row := range c.rows {
+			if !c.keep[i] {
+				continue
+			}
+			full := make([]string, d.Columns())
+			copy(full, row)
+			want = append(want, full)
+		}
+		got := DataToMatrix(f)
+		if fmt.Sprint(got) != fmt.Sprint(want) || f.Rows() != len(want) {
+			fail(ht, "Filter/DataToMatrix = %q (%d rows), want %q", got, f.Rows(), want)
+		}
+		if d.Columns() > c.cols {
+			fail(ht, "Columns() = %d > %d", d.Columns(), c.cols)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/8: optimizedWidths compares the columns' widths without the borders to the table
+// width, so a table whose content plus borders exceeds Width by up to the border count is
+// expanded instead of shrunk, and the final MaxWidth clips the right border away.
+func TestHegelPinWidthIgnoresBordersWhenDecidingToShrink(t *testing.T) {
+	defer guard(t)
+	out := New().Row("abcd", "k").Width(7).String()
+	lines := strings.Split(out, "\n")
+	if lipgloss.Width(out) == 7 && strings.HasSuffix(lines[0], "┐") {
+		return
+	}
+	t.Fatalf("Row(\"abcd\", \"k\").Width(7) renders %q: width %d, the right border is cut", out, lipgloss.Width(out))
+}
+
+// lipgloss/9: shrinkToMedian stops when the column with the biggest excess over its median
+// is column 0 (`biggestDiffToMedianIndex <= 0`), so the first column is never shrunk towards
+// its median and the biggest other column is cut instead; the same table with its columns
+// reversed shrinks as documented.
+func TestHegelPinShrinkToMedianSkipsTheFirstColumn(t *testing.T) {
+	defer guard(t)
+	sparseFirst := New().Row("aaaaaa", "bbbbbbb", "ccccccc").Row("a", "bbbbb", "ccccccc").Row("aaa", "bbbbbbb", "ccccccc").Width(19)
+	sparseLast := New().Row("ccccccc", "bbbbbbb", "aaaaaa").Row("ccccccc", "bbbbb", "a").Row("ccccccc", "bbbbbbb", "aaa").Width(19)
+	_ = sparseFirst.String()
+	_ = sparseLast.String()
+	if sparseFirst.widths[0] == sparseLast.widths[2] && sparseFirst.widths[1] == sparseLast.widths[0] && sparseFirst.widths[2] == sparseLast.widths[1] {
+		return
+	}
+	t.Fatalf("with the sparse column first the widths are %v; with it last they are %v (the sparse column is cut towards its median, as documented)", sparseFirst.widths, sparseLast.widths)
+}
+
+// lipgloss/10: computeHeight counts `sum(heights) - 1 + btoi(hasHeaders) + …`, one line short
+// when the table has no headers and no header separator, and String() clips the rendering to
+// min(Height, computeHeight): the bottom border disappears although the height allows it.
+func TestHegelPinBottomBorderClippedWithoutHeaders(t *testing.T) {
+	defer guard(t)
+	tb := New().Row("a").BorderHeader(false).Height(10)
+	out := tb.String()
+	if strings.HasSuffix(out, "└─┘") {
+		return
+	}
+	t.Fatalf("Row(\"a\").BorderHeader(false).Height(10) renders %q: no bottom border (computeHeight = %d, the table needs 3 lines)", out, tb.computeHeight())
+}
+
+// lipgloss/11: the header row's height is `1 + padding of the last column` rather than the
+// largest vertical frame among the header cells, so a padded header cell in an earlier column
+// spills into an extra line that has no border characters.
+func TestHegelPinHeaderHeightFollowsTheLastColumn(t *testing.T) {
+	defer guard(t)
+	tb := New().Headers("A", "B").Row("1", "2").StyleFunc(func(row, col int) lipgloss.Style {
+		if row == HeaderRow && col == 0 {
+			return lipgloss.NewStyle().PaddingTop(1)
+		}
+		return lipgloss.NewStyle()
+	})
+	out := tb.String()
+	lines := strings.Split(out, "\n")
+	for i, l := range lines {
+		if !strings.Contains(l, "│") && !strings.Contains(l, "─") {
+			t.Fatalf("header padded in column 0 only: line %d %q has no border characters:\n%s", i, l, out)
+		}
+	}
+}
+
+// lipgloss/12: with Wrap(false) a multi-line cell is truncated by ansi.Truncate, which does
+// not count newlines, and then cut to one line by MaxHeight: the lines after the first are
+// dropped without a marker, and a cell that starts with a newline renders blank.
+func TestHegelPinNoWrapDropsTheLinesAfterTheFirst(t *testing.T) {
+	defer guard(t)
+	out := New().Row("\nfoo", "x").Wrap(false).String()
+	if strings.Contains(out, "fo") || strings.Contains(out, "…") {
+		return
+	}
+	t.Fatalf("Row(\"\\nfoo\", \"x\").Wrap(false) renders %q: the first cell is blank, no ellipsis", out)
+}
+
+// lipgloss/13: visibleRowIndexes sizes the overflow row from column 0's vertical padding at
+// `yPaddings[lastVisibleRowIndex+1]`, an index that omits the header row, so with headers the
+// overflow row gets the previous row's padding (and never another column's); a padded
+// overflow cell then loses its "…".
+func TestHegelPinOverflowRowPaddingOffByOneWithHeaders(t *testing.T) {
+	defer guard(t)
+	style := func(row, col int) lipgloss.Style {
+		if row == 2 {
+			return lipgloss.NewStyle().PaddingTop(1)
+		}
+		return lipgloss.NewStyle()
+	}
+	withHeaders := New().Headers("H").Row("a").Row("b").Row("c").Row("d").StyleFunc(style).Height(7).String()
+	without := New().Row("a").Row("b").Row("c").Row("d").StyleFunc(style).Height(5).String()
+	if strings.Contains(withHeaders, "…") {
+		return
+	}
+	t.Fatalf("with headers the overflow row has no ellipsis:\n%s\nwithout headers it has:\n%s", withHeaders, without)
+}
+
+// lipgloss/18: with Wrap(false) the row heights are the style heights only — vertical
+// padding is added in expandRowHeights, which returns early without wrapping — so a cell
+// with PaddingTop(1) is rendered two lines tall and MaxHeight(1) keeps the padding line: the
+// text disappears.
+func TestHegelPinNoWrapIgnoresVerticalPadding(t *testing.T) {
+	defer guard(t)
+	out := New().Row("x").Wrap(false).StyleFunc(func(int, int) lipgloss.Style { return lipgloss.NewStyle().PaddingTop(1) }).String()
+	if strings.Contains(out, "x") {
+		return
+	}
+	t.Fatalf("Row(\"x\").Wrap(false) with PaddingTop(1) renders %q: the cell's text is gone", out)
+}
diff --git a/tree/hegel_shapes_test.go b/tree/hegel_shapes_test.go
new file mode 100644
index 0000000..9dd10db
--- /dev/null
+++ b/tree/hegel_shapes_test.go
@@ -0,0 +1,148 @@
+package tree_test
+
+// One narrow property per recorded bug of the tree and list packages: each draws the bug's
+// shape region with random contents and judges it by the same model as the wide property,
+// so by default it fails naming the bug; under HEGEL_NO_KNOWN=1 it draws the neighbouring
+// region and passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// hiddenLeaf is a hidden leaf with a random value.
+var hiddenLeaf = hegel.Map(flatValues, func(v string) tnode { return tnode{value: v, hidden: true} })
+
+// TestHegelTrailingHiddenChildrenCloseTheBranch: a sibling list ending in two hidden
+// children still gives its last visible child the final branch (lipgloss/14); under
+// HEGEL_NO_KNOWN=1 one hidden child at the end.
+func TestHegelTrailingHiddenChildrenCloseTheBranch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		c.root.offset = nil
+		c.root.children = append(c.root.children, tnode{value: hegel.Draw(ht, flatValues)}, hegel.Draw(ht, hiddenLeaf))
+		if !known.TrailingHiddenKeepTheBranch {
+			c.root.children = append(c.root.children, hegel.Draw(ht, hiddenLeaf))
+		}
+		c.settle()
+		checkTree(ht, c, nil)
+	})
+}
+
+// TestHegelWidthPadsEveryLineOfAnItem: with a Width every line of a multi-line item is
+// padded to it (lipgloss/15); under HEGEL_NO_KNOWN=1 the same tree without a Width.
+func TestHegelWidthPadsEveryLineOfAnItem(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		c.width = hegel.Draw(ht, hegel.Integers(3, 24))
+		if known.WidthPadsLastLineOnly {
+			c.width = 0
+		}
+		lines := hegel.Draw(ht, hegel.Lists(flatValues).MinSize(2).MaxSize(3))
+		c.root.children = append(c.root.children, tnode{value: strings.Join(lines, "\n")})
+		c.root.offset = nil
+		c.settle()
+		checkTree(ht, c, nil)
+	})
+}
+
+// TestHegelOffsetEndIsAnIndex: Offset(start, end) keeps children[start:end], end being an
+// index (-1 the end) as the list documentation shows (lipgloss/16 reads it as a count from
+// the end); under HEGEL_NO_KNOWN=1 offsets whose two readings agree (end at half).
+func TestHegelOffsetEndIsAnIndex(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		n := 2 * hegel.Draw(ht, hegel.Integers(1, 3))
+		c.root.children = hegel.Draw(ht, hegel.Lists(nodesOf(1, flatValues, kindFlat)).MinSize(n).MaxSize(n))
+		for i := range c.root.children {
+			c.root.children[i].hidden = false
+		}
+		start := hegel.Draw(ht, hegel.Integers(0, n/2))
+		end := hegel.Draw(ht, pick(-1, n/2+1, n))
+		if known.OffsetEndIsACount {
+			end = n / 2
+		}
+		c.root.offset = &offsetSpec{start, end}
+		c.settle()
+		checkTree(ht, c, nil)
+	})
+}
+
+// TestHegelAlphabetEnumeratorNeverYieldsAt: Alphabet labels the indexes 676k..676k+25 (k
+// from 2) with letters (lipgloss/17 writes '@'); under HEGEL_NO_KNOWN=1 the other indexes.
+func TestHegelAlphabetEnumeratorNeverYieldsAt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		indexes := atSignIndexes
+		if known.AlphabetYieldsAtSign {
+			indexes = plainIndexes
+		}
+		checkEnumerators(ht, hegel.Draw(ht, indexes), nil)
+	})
+}
+
+// TestHegelAutoNestingKeepsTheLeafHidden: a nested list after a hidden item becomes that
+// item, hidden (lipgloss/20 shows it); under HEGEL_NO_KNOWN=1 a value after the hidden item.
+func TestHegelAutoNestingKeepsTheLeafHidden(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		n := hegel.Draw(ht, listsOf(1))
+		n.children = append(n.children, hegel.Draw(ht, hiddenLeaf))
+		if known.AutoNestingUnhidesLeaf {
+			n.children = append(n.children, tnode{value: hegel.Draw(ht, flatValues)})
+		} else {
+			sub := hegel.Draw(ht, listsOf(0))
+			sub.sub = true
+			n.children = append(n.children, sub)
+		}
+		checkList(ht, n, nil)
+	})
+}
+
+// TestHegelHiddenFirstChildKeepsTheNumbering: under the arabic enumerator the visible
+// children are numbered from 1 when the first child is hidden (lipgloss/21 starts at 2);
+// under HEGEL_NO_KNOWN=1 the hidden child is not the first.
+func TestHegelHiddenFirstChildKeepsTheNumbering(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		c.es = enumerators[2]
+		c.root.offset = nil
+		h := hegel.Draw(ht, hiddenLeaf)
+		rest := append([]tnode{{value: hegel.Draw(ht, flatValues)}}, c.root.children...)
+		if known.HiddenFirstShiftsNumbering {
+			c.root.children = append(rest, h)
+		} else {
+			c.root.children = append([]tnode{h}, rest...)
+		}
+		c.settle()
+		checkTree(ht, c, nil)
+	})
+}
+
+// TestHegelStyleFunctionsGetSiblingIndexes: the style functions are called with indexes of
+// the children they are given when a hidden child follows a visible one (lipgloss/30 asks
+// past the end); under HEGEL_NO_KNOWN=1 the hidden child comes first.
+func TestHegelStyleFunctionsGetSiblingIndexes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		c.styled = true
+		c.root.offset = nil
+		for i := range c.root.children {
+			c.root.children[i].hidden = false
+		}
+		h := hegel.Draw(ht, hiddenLeaf)
+		v := tnode{value: hegel.Draw(ht, flatValues)}
+		if known.HiddenChildIndexesPastSiblings {
+			c.root.children = append([]tnode{h, v}, c.root.children...)
+			if c.es.name == "arabic" {
+				c.es = enumerators[0] // a hidden first child is lipgloss/21's region there
+			}
+		} else {
+			at := hegel.Draw(ht, hegel.Integers(0, 4)) % (len(c.root.children) + 1)
+			ch := append([]tnode{v}, c.root.children[:at]...)
+			ch = append(ch, h)
+			c.root.children = append(ch, c.root.children[at:]...)
+		}
+		checkTree(ht, c, nil)
+	})
+}
diff --git a/tree/hegel_test.go b/tree/hegel_test.go
new file mode 100644
index 0000000..66aaf30
--- /dev/null
+++ b/tree/hegel_test.go
@@ -0,0 +1,807 @@
+package tree_test
+
+// Hegel property tests for charm.land/lipgloss/v2/tree and /list (hegel-zoo target
+// go/lipgloss): a random tree (nested roots, hidden nodes, offsets, multi-line values, custom
+// enumerators and indenters, style functions, Width) is drawn as a depth-indexed tower of
+// node records, rendered and compared with the documented layout — root line, one line per
+// visible child with its enumerator right-aligned to the widest sibling enumerator,
+// continuation lines and sub-trees indented — built as plain strings. The shapes of
+// lipgloss/14-17, /20, /21 and /30 are steady alternatives, named on a mismatch; under
+// HEGEL_NO_KNOWN=1 the generators keep out of them or the model follows the implementation.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"charm.land/lipgloss/v2/internal/zootest"
+	"charm.land/lipgloss/v2/list"
+	"charm.land/lipgloss/v2/tree"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func property(t *testing.T, fn func(ht *hegel.T)) { zootest.Property(t, fn) }
+
+func fail(ht *hegel.T, format string, args ...any) { zootest.Fail(ht, format, args...) }
+
+func count(name string) { zootest.Count(name) }
+
+func note(ht *hegel.T, format string, args ...any) { zootest.Note(ht, format, args...) }
+
+func guard(t *testing.T) { zootest.Guard(t) }
+
+func mismatch(ht *hegel.T, sh []string, format string, args ...any) {
+	zootest.Mismatch(ht, sh, format, args...)
+}
+
+var known = &zootest.Known
+
+type shapes = zootest.Shapes
+
+func weighted[T any](choices ...zootest.Choice[T]) hegel.Generator[T] {
+	return zootest.Weighted(choices...)
+}
+
+func w[T any](weight int, g hegel.Generator[T]) zootest.Choice[T] { return zootest.W(weight, g) }
+
+func unless(sw bool, weight int) int { return zootest.Unless(sw, weight) }
+
+func chance(pct int) hegel.Generator[bool] { return zootest.Chance(pct) }
+
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] { return zootest.Maybe(pct, g) }
+
+func pick[T any](xs ...T) hegel.Generator[T] { return zootest.Pick(xs...) }
+
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return zootest.Counted(g, lo, hi)
+}
+
+// ---------------------------------------------------------------- values
+
+var (
+	narrow = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "+", "="}
+	wide   = []string{"世", "界", "😃", "Ａ"}
+)
+
+// valuesOf is a node value of one to six graphemes: narrow ones, a space in ten, a wide
+// one in seven, and a newline with weight nl (trimmed at the ends).
+func valuesOf(nl int) hegel.Generator[string] {
+	piece := weighted(w(67, pick(narrow...)), w(10, hegel.Just(" ")), w(15, pick(wide...)), w(nl, hegel.Just("\n")))
+	return hegel.Map(counted(piece, 1, 6), func(gs []string) string { return strings.Trim(strings.Join(gs, ""), "\n") })
+}
+
+var (
+	// multiValues: a newline in a dozen graphemes (a multi-line item).
+	multiValues = valuesOf(8)
+	// flatValues: single-line values.
+	flatValues = valuesOf(0)
+)
+
+// ---------------------------------------------------------------- the node record
+
+// offsetSpec is an Offset(start, end) call.
+type offsetSpec struct {
+	start, end int
+}
+
+// tnode is the drawn shape of a node.
+type tnode struct {
+	value    string
+	hidden   bool
+	children []tnode
+	offset   *offsetSpec
+	sub      bool // a nested list.New (auto-nested by the tree)
+}
+
+// offsetsFor is an Offset for n children: a start up to n, an end from -1 to n.
+func offsetsFor(n int) hegel.Generator[offsetSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) offsetSpec {
+		return offsetSpec{start: hegel.Draw(tc, hegel.Integers(0, n)), end: hegel.Draw(tc, hegel.Integers(-1, n))}
+	})
+}
+
+// nodesOf is the tower of node generators: depth 0 is a leaf, depth d a node whose children
+// (half the time, up to four) come from depth d-1, with an Offset one time in five. A node
+// with children is always rooted (a rootless one auto-nests: the list property). Memoised
+// per depth and value kind.
+var nodeTowers = map[[2]int]hegel.Generator[tnode]{}
+
+func nodesOf(depth int, values hegel.Generator[string], kind int) hegel.Generator[tnode] {
+	key := [2]int{depth, kind}
+	if g, ok := nodeTowers[key]; ok {
+		return g
+	}
+	var g hegel.Generator[tnode]
+	if depth == 0 {
+		g = hegel.Composite(func(tc hegel.TestCase) tnode {
+			return tnode{value: hegel.Draw(tc, values), hidden: hegel.Draw(tc, chance(10))}
+		})
+	} else {
+		below := nodesOf(depth-1, values, kind)
+		g = hegel.Composite(func(tc hegel.TestCase) tnode {
+			n := tnode{value: hegel.Draw(tc, values), hidden: hegel.Draw(tc, chance(10))}
+			if hegel.Draw(tc, chance(50)) {
+				n.children = hegel.Draw(tc, counted(below, 0, 4))
+				if len(n.children) > 0 {
+					if off := hegel.Draw(tc, maybe(20, offsetsFor(len(n.children)))); off != (offsetSpec{}) {
+						n.offset = &offsetSpec{off.start, off.end}
+					}
+				}
+				if n.value == "" {
+					n.value = "x"
+				}
+			}
+			return n
+		})
+	}
+	nodeTowers[key] = g
+	return g
+}
+
+const (
+	kindMulti = iota
+	kindFlat
+)
+
+func (n tnode) build() *tree.Tree {
+	t := tree.Root(n.value).Hide(n.hidden)
+	for _, c := range n.children {
+		if len(c.children) == 0 && c.offset == nil {
+			t.Child(tree.NewLeaf(c.value, c.hidden))
+			continue
+		}
+		t.Child(c.build())
+	}
+	if n.offset != nil {
+		t.Offset(n.offset.start, n.offset.end)
+	}
+	return t
+}
+
+// inRange is the children Offset leaves: as documented, children[start:end] with the
+// bounds clamped (a negative end or one past the end is the end; start and end swapped
+// when reversed); lipgloss/16 reads end as a count from the end.
+func (n tnode) inRange() []tnode {
+	if n.offset == nil {
+		return n.children
+	}
+	l := len(n.children)
+	start, end := n.offset.start, n.offset.end
+	if start > end {
+		start, end = end, start
+	}
+	start = max(start, 0)
+	if end < 0 || end > l {
+		end = l
+	}
+	if known.OffsetEndIsACount {
+		end = l - end
+	}
+	if end <= start {
+		return nil
+	}
+	return n.children[start:end]
+}
+
+// offsetReadingsDiffer reports an Offset whose documented and count readings leave
+// different children.
+func (n tnode) offsetReadingsDiffer() bool {
+	if n.offset != nil {
+		l := len(n.children)
+		start, end := n.offset.start, n.offset.end
+		if start > end {
+			start, end = end, start
+		}
+		start = max(start, 0)
+		if end < 0 || end > l {
+			end = l
+		}
+		a, b := max(start, end), max(start, l-end)
+		if a != b {
+			return true
+		}
+	}
+	for _, c := range n.inRange() {
+		if c.offsetReadingsDiffer() {
+			return true
+		}
+	}
+	return false
+}
+
+func (n tnode) visible() []tnode {
+	var out []tnode
+	for _, c := range n.inRange() {
+		if !c.hidden {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// adjacentHidden reports a sibling list with two hidden children in a row, anywhere in the
+// tree (lipgloss/14).
+func (n tnode) adjacentHidden() bool {
+	ch := n.inRange()
+	for i := 1; i < len(ch); i++ {
+		if ch[i-1].hidden && ch[i].hidden {
+			return true
+		}
+	}
+	for _, c := range ch {
+		if c.adjacentHidden() {
+			return true
+		}
+	}
+	return false
+}
+
+// hiddenFirst reports a node whose first child in range is hidden (lipgloss/21).
+func (n tnode) hiddenFirst() bool {
+	ch := n.inRange()
+	if len(ch) > 0 && ch[0].hidden {
+		return true
+	}
+	for _, c := range ch {
+		if c.hiddenFirst() {
+			return true
+		}
+	}
+	return false
+}
+
+// hiddenLater reports a node with a hidden child in range after the first (lipgloss/30).
+func (n tnode) hiddenLater() bool {
+	ch := n.inRange()
+	for i := 1; i < len(ch); i++ {
+		if ch[i].hidden {
+			return true
+		}
+	}
+	for _, c := range ch {
+		if !c.hidden && c.hiddenLater() {
+			return true
+		}
+	}
+	return false
+}
+
+// multiLine reports a visible node value with a newline.
+func (n tnode) multiLine() bool {
+	for _, c := range n.visible() {
+		if strings.Contains(c.value, "\n") || c.multiLine() {
+			return true
+		}
+	}
+	return false
+}
+
+// unhideAdjacent makes a hidden child after a hidden one visible, at every level
+// (HEGEL_NO_KNOWN=1 keeps out of lipgloss/14).
+func (n *tnode) unhideAdjacent() {
+	for i := range n.children {
+		if i > 0 && n.children[i-1].hidden && n.children[i].hidden {
+			n.children[i].hidden = false
+		}
+		n.children[i].unhideAdjacent()
+	}
+}
+
+// unhideFirst makes the first child in range visible, at every level (HEGEL_NO_KNOWN=1
+// keeps the arabic enumeration out of lipgloss/21).
+func (n *tnode) unhideFirst() {
+	// inRange slices n.children, so ch[0] aliases the child itself.
+	if ch := n.inRange(); len(ch) > 0 {
+		ch[0].hidden = false
+	}
+	for i := range n.children {
+		n.children[i].unhideFirst()
+	}
+}
+
+func (n tnode) describe(indent string) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "%s%q", indent, n.value)
+	if n.hidden {
+		sb.WriteString(" hidden")
+	}
+	if n.sub {
+		sb.WriteString(" (sublist)")
+	}
+	if n.offset != nil {
+		fmt.Fprintf(&sb, " offset(%d,%d)", n.offset.start, n.offset.end)
+	}
+	for _, c := range n.children {
+		sb.WriteString("\n" + c.describe(indent+"  "))
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------- enumerators
+
+type enumSpec struct {
+	name string
+	enum func(n, i int) string
+	ind  func(n, i int) string
+}
+
+var enumerators = []enumSpec{
+	{"default", func(n, i int) string {
+		if i == n-1 {
+			return "└──"
+		}
+		return "├──"
+	}, func(n, i int) string {
+		if i == n-1 {
+			return "   "
+		}
+		return "│  "
+	}},
+	{"rounded", func(n, i int) string {
+		if i == n-1 {
+			return "╰──"
+		}
+		return "├──"
+	}, func(n, i int) string {
+		if i == n-1 {
+			return "   "
+		}
+		return "│  "
+	}},
+	{"arabic", func(n, i int) string { return fmt.Sprintf("%d.", i+1) }, func(n, i int) string { return "  " }},
+	{"star", func(n, i int) string { return "*" }, func(n, i int) string { return "" }},
+}
+
+func (es enumSpec) apply(tr *tree.Tree) *tree.Tree {
+	switch es.name {
+	case "rounded":
+		return tr.Enumerator(tree.RoundedEnumerator)
+	case "arabic":
+		return tr.Enumerator(func(c tree.Children, i int) string { return fmt.Sprintf("%d.", i+1) }).Indenter(func(tree.Children, int) string { return "  " })
+	case "star":
+		return tr.Enumerator(func(tree.Children, int) string { return "*" }).Indenter(func(tree.Children, int) string { return "" })
+	}
+	return tr
+}
+
+func padTo(s string, w int) string { return s + strings.Repeat(" ", max(0, w-ansi.StringWidth(s))) }
+
+func blockWidth(lines []string) int {
+	w := 0
+	for _, l := range lines {
+		w = max(w, ansi.StringWidth(l))
+	}
+	return w
+}
+
+// modelRender lays the tree out as documented: the root line, then one line per visible
+// child with its enumerator right-aligned to the widest sibling enumerator, continuation
+// lines under the indent, sub-trees indented, every line padded to the width.
+func modelRender(n tnode, root bool, prefix string, es enumSpec, width int) (lines []string) {
+	if root && n.value != "" {
+		lines = append(lines, padTo(n.value, width))
+	}
+	vis := n.visible()
+	maxLen := 0
+	for i := range vis {
+		maxLen = max(maxLen, ansi.StringWidth(es.enum(len(vis), i))+1)
+	}
+	for i, c := range vis {
+		enum := es.enum(len(vis), i) + " "
+		indent := es.ind(len(vis), i) + " "
+		nodePrefix := strings.Repeat(" ", maxLen-ansi.StringWidth(enum)) + enum
+		item := strings.Split(c.value, "\n")
+		// The prefix column blocks, as JoinVertical pads them.
+		npBlock := []string{nodePrefix}
+		for k := 1; k < len(item); k++ {
+			npBlock = append(npBlock, indent)
+		}
+		npw := blockWidth(npBlock)
+		iw := blockWidth(item)
+		for k, l := range item {
+			line := prefix + padTo(npBlock[k], npw) + padTo(l, iw)
+			lines = append(lines, padTo(line, width))
+		}
+		if len(c.children) > 0 {
+			lines = append(lines, modelRender(c, false, prefix+indent, es, width)...)
+		}
+	}
+	return lines
+}
+
+// ---------------------------------------------------------------- the tree property
+
+// treeCase: the root (never hidden, single-line value), the enumerator, the Width and
+// whether style functions are set.
+type treeCase struct {
+	root   tnode
+	es     enumSpec
+	width  int
+	styled bool
+}
+
+func (c treeCase) GoString() string {
+	return fmt.Sprintf("tree %s\nenumerator %s width %d styled %v", c.root.describe(""), c.es.name, c.width, c.styled)
+}
+
+// treeCases draws the Width first: with one, under HEGEL_NO_KNOWN=1, the values are
+// single-line (lipgloss/15). Adjacent hidden children (lipgloss/14) and a hidden first child
+// under the arabic enumerator (lipgloss/21) are unhidden there too.
+var treeCases = hegel.Composite(func(tc hegel.TestCase) treeCase {
+	c := treeCase{
+		width:  hegel.Draw(tc, maybe(40, hegel.Integers(3, 24))),
+		es:     hegel.Draw(tc, pick(enumerators...)),
+		styled: hegel.Draw(tc, chance(50)),
+	}
+	values, kind := multiValues, kindMulti
+	if c.width > 0 && known.WidthPadsLastLineOnly {
+		values, kind = flatValues, kindFlat
+	}
+	c.root = hegel.Draw(tc, nodesOf(3, values, kind))
+	c.root.hidden = false
+	c.root.value = strings.ReplaceAll(c.root.value, "\n", " ")
+	if c.root.value == "" {
+		c.root.value = "x"
+	}
+	c.settle()
+	return c
+})
+
+// settle applies the HEGEL_NO_KNOWN=1 adjustments to a case: no two hidden children in a
+// row (lipgloss/14), no hidden first child under the arabic enumerator (lipgloss/21).
+func (c *treeCase) settle() {
+	if known.TrailingHiddenKeepTheBranch {
+		c.root.unhideAdjacent()
+	}
+	if known.HiddenFirstShiftsNumbering && c.es.name == "arabic" {
+		c.root.unhideFirst()
+	}
+}
+
+// checkTree renders the tree and compares it with the model, naming the shapes met:
+// lipgloss/14 (two hidden children in a row), /15 (a multi-line item with a Width), /16
+// (an Offset whose end reads differently as an index and as a count), /21 (a hidden first
+// child numbered), /30 (style functions asked for an index past the siblings).
+func checkTree(ht *hegel.T, c treeCase, sh shapes) {
+	n := c.root
+	tr := c.es.apply(n.build())
+	if c.width > 0 {
+		tr = tr.Width(c.width)
+	}
+	// The style functions return the defaults (a space after the enumerator and the
+	// indent) and record a call for an index past the children they were given.
+	past := 0
+	if c.styled {
+		record := func(st lipgloss.Style) tree.StyleFunc {
+			return func(children tree.Children, i int) lipgloss.Style {
+				if i >= children.Length() {
+					past++
+				}
+				return st
+			}
+		}
+		padded := lipgloss.NewStyle().PaddingRight(1)
+		tr = tr.EnumeratorStyleFunc(record(padded)).IndenterStyleFunc(record(padded)).ItemStyleFunc(record(lipgloss.NewStyle()))
+	}
+	sh.Add("lipgloss/14", n.adjacentHidden())
+	sh.Add("lipgloss/15", n.multiLine() && c.width > 0)
+	sh.Add("lipgloss/16", n.offsetReadingsDiffer())
+	sh.Add("lipgloss/21", c.es.name == "arabic" && n.hiddenFirst())
+	sh.Add("lipgloss/30", c.styled && n.hiddenLater())
+	var out string
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				mismatch(ht, sh, "String() panicked: %v\ntree %s", r, n.describe(""))
+			}
+		}()
+		out = tr.String()
+	}()
+	note(ht, "rendered\n%s", out)
+	want := modelRender(n, true, "", c.es, c.width)
+	if out != strings.Join(want, "\n") {
+		mismatch(ht, sh, "tree %s (enumerator %s, width %d) renders\n%s\nmodel\n%s", n.describe(""), c.es.name, c.width, out, strings.Join(want, "\n"))
+	}
+	if c.width > 0 && out != "" {
+		for i, l := range strings.Split(out, "\n") {
+			if ansi.StringWidth(l) < c.width {
+				mismatch(ht, sh, "Width(%d): line %d %q is %d wide:\n%s", c.width, i, l, ansi.StringWidth(l), out)
+			}
+		}
+	}
+	if past > 0 {
+		if known.HiddenChildIndexesPastSiblings {
+			count("lipgloss/30-shape")
+		} else {
+			mismatch(ht, sh, "the style functions were asked %d times for an index past the children they were given\ntree %s", past, n.describe(""))
+		}
+	}
+	count("ok")
+}
+
+// TestHegelTreeFollowsTheLayout: tree.String against the documented layout.
+func TestHegelTreeFollowsTheLayout(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkTree(ht, hegel.Draw(ht, treeCases), nil)
+	})
+}
+
+// ---------------------------------------------------------------- list enumerators
+
+func romanRef(n int) string {
+	vals := []int{1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1}
+	syms := []string{"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"}
+	var sb strings.Builder
+	for i, v := range vals {
+		for n >= v {
+			n -= v
+			sb.WriteString(syms[i])
+		}
+	}
+	return sb.String()
+}
+
+// alphaRef is the bijective base-26 numbering (A…Z, AA…ZZ, AAA…).
+func alphaRef(n int) string {
+	var out []byte
+	for n >= 0 {
+		out = append([]byte{byte('A' + n%26)}, out...)
+		n = n/26 - 1
+	}
+	return string(out)
+}
+
+// atSignIndex reports an index whose three-letter label has '@' in the middle: 676k+j for
+// k from 2 (lipgloss/17).
+func atSignIndex(i int) bool { return i >= 702 && (i/26)%26 == 0 }
+
+var (
+	// plainIndexes: an index outside lipgloss/17's blocks.
+	plainIndexes = hegel.Filter(hegel.Integers(0, 4000), func(i int) bool { return !atSignIndex(i) })
+	// atSignIndexes: an index in one of the blocks (676k, k 2..5, plus 0..25).
+	atSignIndexes = hegel.Map(hegel.Composite(func(tc hegel.TestCase) [2]int {
+		return [2]int{hegel.Draw(tc, hegel.Integers(2, 5)), hegel.Draw(tc, hegel.Integers(0, 25))}
+	}), func(kj [2]int) int { return 676*kj[0] + kj[1] })
+	// enumIndexes: an index up to 4000, in one of the '@' blocks three times in a hundred.
+	enumIndexes = weighted(w(97, plainIndexes), w(unless(known.AlphabetYieldsAtSign, 3), atSignIndexes))
+)
+
+// checkEnumerators: Roman, Arabic and Alphabet label the index as documented (Alphabet is
+// the bijective base-26 numbering).
+func checkEnumerators(ht *hegel.T, i int, sh shapes) {
+	if got, want := list.Roman(nil, i), romanRef(i+1)+"."; got != want {
+		fail(ht, "Roman(%d) = %q, want %q", i, got, want)
+	}
+	if got, want := list.Arabic(nil, i), fmt.Sprintf("%d.", i+1); got != want {
+		fail(ht, "Arabic(%d) = %q, want %q", i, got, want)
+	}
+	sh.Add("lipgloss/17", atSignIndex(i))
+	if got, want := list.Alphabet(nil, i), alphaRef(i)+"."; got != want {
+		mismatch(ht, sh, "Alphabet(%d) = %q, want %q", i, got, want)
+	}
+	count("ok")
+}
+
+func TestHegelListEnumeratorsCount(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkEnumerators(ht, hegel.Draw(ht, enumIndexes), nil)
+	})
+}
+
+// ---------------------------------------------------------------- lists
+
+// listsOf is the tower of list generators: zero to four items, each a value, a hidden leaf
+// one time in ten, or (below the top depth) a nested list three times in ten. Under
+// HEGEL_NO_KNOWN=1 a nested list that would take over a hidden leaf (lipgloss/20) is drawn
+// as a value instead.
+var listTowers = map[int]hegel.Generator[tnode]{}
+
+func listsOf(depth int) hegel.Generator[tnode] {
+	if g, ok := listTowers[depth]; ok {
+		return g
+	}
+	var g hegel.Generator[tnode]
+	leaf := hegel.Composite(func(tc hegel.TestCase) tnode {
+		return tnode{value: hegel.Draw(tc, flatValues), hidden: hegel.Draw(tc, chance(10))}
+	})
+	if depth == 0 {
+		g = hegel.Map(counted(leaf, 0, 4), func(items []tnode) tnode { return tnode{children: items} })
+	} else {
+		below := listsOf(depth - 1)
+		g = hegel.Composite(func(tc hegel.TestCase) tnode {
+			var n tnode
+			k := hegel.Draw(tc, hegel.Integers(0, 4))
+			for ; k > 0; k-- {
+				if hegel.Draw(tc, chance(30)) {
+					sub := hegel.Draw(tc, below)
+					sub.sub = true
+					if _, takes := simulate(tnode{children: append(append([]tnode(nil), n.children...), sub)}); !takes || !known.AutoNestingUnhidesLeaf {
+						n.children = append(n.children, sub)
+						continue
+					}
+				}
+				n.children = append(n.children, hegel.Draw(tc, leaf))
+			}
+			return n
+		})
+	}
+	listTowers[depth] = g
+	return g
+}
+
+func (n tnode) buildList() *list.List {
+	l := list.New()
+	for _, c := range n.children {
+		switch {
+		case c.sub:
+			l.Item(c.buildList())
+		case c.hidden:
+			l.Item(tree.NewLeaf(c.value, true))
+		default:
+			l.Item(c.value)
+		}
+	}
+	return l
+}
+
+// simulate rebuilds the item tree the way tree.Child nests rootless trees, as documented:
+// a nested list becomes its previous sibling item - taking its value and its hidden flag
+// (lipgloss/20 drops the flag) - or merges into a previous nested list. It reports whether
+// a hidden leaf was taken over.
+func simulate(n tnode) (out tnode, tookHidden bool) {
+	out = tnode{value: n.value, sub: n.sub, hidden: n.hidden}
+	for _, c := range n.children {
+		s, th := simulate(c)
+		tookHidden = tookHidden || th || addChild(&out, s)
+	}
+	return out, tookHidden
+}
+
+func addChild(parent *tnode, item tnode) (tookHidden bool) {
+	if item.sub && item.value == "" && len(parent.children) > 0 {
+		prev := parent.children[len(parent.children)-1]
+		if prev.sub {
+			for _, c := range item.children {
+				tookHidden = addChild(&prev, c) || tookHidden
+			}
+			parent.children[len(parent.children)-1] = prev
+			return tookHidden
+		}
+		parent.children = parent.children[:len(parent.children)-1]
+		hidden := prev.hidden && !known.AutoNestingUnhidesLeaf
+		item = tnode{value: prev.value, sub: true, children: item.children, hidden: hidden}
+		tookHidden = prev.hidden
+	}
+	parent.children = append(parent.children, item)
+	return tookHidden
+}
+
+// checkList: a list is a tree with the bullet enumerator and a one-space indenter; nested
+// lists keep their own enumerator; hidden items and their sub-lists are not shown.
+func checkList(ht *hegel.T, n tnode, sh shapes) {
+	l := n.buildList()
+	note(ht, "list %s", n.describe(""))
+	out := l.String()
+	sim, tookHidden := simulate(n)
+	sh.Add("lipgloss/20", tookHidden)
+	if tookHidden && known.AutoNestingUnhidesLeaf {
+		count("lipgloss/20-shape")
+	}
+	var want []string
+	var walk func(n tnode, prefix string)
+	walk = func(n tnode, prefix string) {
+		for _, c := range n.children {
+			if c.hidden {
+				continue
+			}
+			want = append(want, prefix+"• "+c.value)
+			walk(c, prefix+"  ")
+		}
+	}
+	walk(sim, "")
+	if out != strings.Join(want, "\n") {
+		mismatch(ht, sh, "list %s renders\n%s\nmodel\n%s", n.describe(""), out, strings.Join(want, "\n"))
+	}
+	count("ok")
+}
+
+// TestHegelListsNestAsTrees: list.String against the auto-nesting model.
+func TestHegelListsNestAsTrees(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkList(ht, hegel.Draw(ht, listsOf(2)), nil)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/20: a rootless child tree takes over its previous sibling leaf — value only: the
+// leaf's hidden flag is dropped, so a hidden item becomes visible when a nested list
+// follows it.
+func TestHegelPinAutoNestingUnhidesTheLeaf(t *testing.T) {
+	defer guard(t)
+	out := tree.Root("r").Child("a", tree.NewLeaf("h", true), tree.New().Child("x")).String()
+	if !strings.Contains(out, "h") {
+		return
+	}
+	t.Fatalf("Root(\"r\").Child(\"a\", hidden \"h\", tree.New().Child(\"x\")) renders the hidden leaf:\n%s", out)
+}
+
+// lipgloss/14: the renderer drops a hidden child only when it directly follows the child
+// being examined, once, so two hidden children at the end of a sibling list leave one of
+// them counted and the last visible child gets the non-final "├──".
+func TestHegelPinTrailingHiddenChildrenKeepTheBranch(t *testing.T) {
+	defer guard(t)
+	out := tree.Root("r").Child("a", "b", tree.NewLeaf("c", true), tree.NewLeaf("d", true)).String()
+	if strings.Contains(out, "└── b") {
+		return
+	}
+	t.Fatalf("Root(\"r\").Child(\"a\", \"b\", hidden, hidden) renders\n%s\nthe last visible child b has no final branch", out)
+}
+
+// lipgloss/15: Width pads `line + Render(spaces)` where line is the whole multi-line item, so
+// only its last line reaches the width; the first line stays short.
+func TestHegelPinWidthPadsOnlyTheLastLineOfAMultilineItem(t *testing.T) {
+	defer guard(t)
+	out := tree.Root("r").Child("a\nb").Width(10).String()
+	lines := strings.Split(out, "\n")
+	for i, l := range lines {
+		if ansi.StringWidth(l) != 10 {
+			t.Fatalf("Root(\"r\").Child(\"a\\nb\").Width(10): line %d %q is %d wide:\n%s", i, l, ansi.StringWidth(l), out)
+		}
+	}
+}
+
+// lipgloss/16: Offset(start, end) documents `end` as an index ("Offset(1, -1)" keeps B–D in
+// the list doc) but Children() uses it as a count from the end, so the documented call shows
+// nothing.
+func TestHegelPinOffsetEndIsACountFromTheEnd(t *testing.T) {
+	defer guard(t)
+	out := list.New("A", "B", "C", "D").Offset(1, -1).String()
+	if strings.Contains(out, "B") && strings.Contains(out, "D") {
+		return
+	}
+	t.Fatalf("list.New(\"A\", \"B\", \"C\", \"D\").Offset(1, -1) renders %q; the doc shows B, C, D", out)
+}
+
+// lipgloss/17: Alphabet's three-letter formula computes the middle letter as
+// 'A'+(i/26)%26-1, which is '@' whenever (i/26)%26 == 0: every 26th block of 26 indexes from
+// 702 up gets a non-letter label.
+func TestHegelPinAlphabetEnumeratorYieldsAnAtSign(t *testing.T) {
+	defer guard(t)
+	got := list.Alphabet(nil, 1364)
+	if got == "AZM." {
+		return
+	}
+	t.Fatalf("list.Alphabet(nil, 1364) = %q, want %q (bijective base 26); Alphabet(701) = %q, Alphabet(702) = %q", got, "AZM.", list.Alphabet(nil, 701), list.Alphabet(nil, 702))
+}
+
+// lipgloss/21: the renderer removes a hidden child from the enumeration only when it follows
+// the child being examined, so a hidden first child keeps its index and the visible items
+// are numbered from 2.
+func TestHegelPinHiddenFirstItemShiftsTheNumbering(t *testing.T) {
+	defer guard(t)
+	out := list.New(tree.NewLeaf("h", true), "a", "b").Enumerator(list.Arabic).String()
+	if strings.HasPrefix(out, "1. a") {
+		return
+	}
+	t.Fatalf("list.New(hidden, \"a\", \"b\").Enumerator(list.Arabic) renders %q", out)
+}
+
+// lipgloss/30: with a hidden child anywhere but first, the renderer's first loop shortens
+// its local sibling list (Remove(i+1)) while still iterating over the original length, so
+// the enumerator style function is called with an index past the end of the children it is
+// given — a style function that looks its child up (bubbles' tree does) panics.
+func TestHegelPinHiddenChildIndexesPastTheSiblings(t *testing.T) {
+	defer guard(t)
+	_ = tree.Root("r").Child("a", tree.NewLeaf("h", true), "b").
+		EnumeratorStyleFunc(func(children tree.Children, i int) lipgloss.Style {
+			if i >= children.Length() {
+				panic(fmt.Sprintf("enumerator style function asked for child %d of %d", i, children.Length()))
+			}
+			return lipgloss.NewStyle()
+		}).String()
+}
