+// ---------------------------------------------------------------- the Render model
+
+// modelRender builds the cells Style.Render should produce for the given lines. It returns a
+// tag naming a case the model covers through x/ansi's wrap (counted, not skipped).
+func modelRender(sp styleSpec, lines []textLine) (rows [][]mcell, tag string) {
+	var skipTag string
+	defer func() { tag = skipTag }()
+	// Tabs and transform.
+	tw := 4
+	if sp.tabWidth != nil {
+		tw = *sp.tabWidth
+	}
+	var work [][]string
+	for _, l := range lines {
+		var gs []string
+		for _, g := range l {
+			switch {
+			case g == "\t":
+				for i := 0; i < tw; i++ {
+					gs = append(gs, " ")
+				}
+			case sp.transform:
+				gs = append(gs, strings.ToUpper(g))
+			default:
+				gs = append(gs, g)
+			}
+		}
+		work = append(work, gs)
+	}
+	if sp.inline {
+		var one []string
+		for _, gs := range work {
+			one = append(one, gs...)
+		}
+		work = [][]string{one}
+	}
+
+	// Pens.
+	var te, teSpace, teWS mstyle
+	if sp.bold {
+		te.attrs |= aBold
+	}
+	if sp.italic {
+		te.attrs |= aItalic
+	}
+	if sp.hasUnderline() {
+		te.under = sp.ulStyle()
+	}
+	if sp.reverse {
+		te.attrs |= aReverse
+		teWS.attrs |= aReverse
+	}
+	if sp.blink {
+		te.attrs |= aBlink
+	}
+	if sp.faint {
+		te.attrs |= aFaint
+	}
+	if sp.strike {
+		te.attrs |= aStrike
+	}
+	colorWS := sp.colorWS == nil || *sp.colorWS
+	te.fg, te.bg, te.ul = nilIfNo(sp.fg), nilIfNo(sp.bg), nilIfNo(sp.ulColor)
+	if sp.reverse {
+		teWS.fg = te.fg
+	}
+	if colorWS {
+		teWS.bg = te.bg
+		teWS.ul = te.ul
+	}
+	// Spaces inside the text: the text's pen, with underline and strikethrough governed by
+	// the *Spaces settings (default: follow the text).
+	// Spaces can be underlined or struck without the text being so (documented), and then
+	// get a single underline.
+	teSpace = te
+	ulSpaces := sp.hasUnderline()
+	if sp.ulSpaces != nil {
+		ulSpaces = *sp.ulSpaces
+	}
+	switch {
+	case !ulSpaces:
+		teSpace.under = ansi.UnderlineNone
+	case !sp.hasUnderline():
+		teSpace.under = ansi.UnderlineSingle
+	}
+	strikeSpaces := sp.strike
+	if sp.strikeSpaces != nil {
+		strikeSpaces = *sp.strikeSpaces
+	}
+	if strikeSpaces {
+		teSpace.attrs |= aStrike
+	} else {
+		teSpace.attrs &^= aStrike
+	}
+	styleWS := colorWS || sp.reverse
+	var wsPen mstyle
+	if styleWS {
+		wsPen = teWS
+	}
+
+	// Sizes.
+	pad, mar := sp.pad(), sp.mar()
+	padT, padR, padB, padL := pad[0], pad[1], pad[2], pad[3]
+	marT, marR, marB, marL := mar[0], mar[1], mar[2], mar[3]
+	bTop, bRight, bBottom, bLeft := sp.borderSides()
+	var hb, vb int
+	if sp.border != nil {
+		b := borders[sp.border.name]
+		if bLeft {
+			hb += maxRuneWidth(b.Left)
+		}
+		if bRight {
+			hb += maxRuneWidth(b.Right)
+		}
+		if bTop {
+			vb += maxRuneWidth(b.Top)
+		}
+		if bBottom {
+			vb += maxRuneWidth(b.Bottom)
+		}
+	}
+	width := sp.widthValue() - hb
+	height := sp.heightValue() - vb
+	link, linkParams := sp.linkURL()
+	if !sp.inline && width > 0 {
+		// Wrapping is x/ansi's (ansi.Wrap, checked in the x-ansi target); the model takes
+		// its lines and lays them out. A limit below one leaves the text alone.
+		wrapAt := width - padL - padR
+		needs := false
+		for _, gs := range work {
+			w := 0
+			for _, g := range gs {
+				w += gwidth(g)
+			}
+			if w > wrapAt {
+				needs = true
+			}
+		}
+		if wrapAt < 1 {
+			skipTag = "wrap-limit-below-one"
+		} else if needs {
+			skipTag = "wrapped"
+			var plain []string
+			for _, gs := range work {
+				plain = append(plain, strings.Join(gs, ""))
+			}
+			work = nil
+			for _, line := range strings.Split(ansi.Wrap(strings.Join(plain, "\n"), wrapAt, ""), "\n") {
+				work = append(work, graphemes(line))
+			}
+		}
+	}
+
+	// Core text.
+	for _, gs := range work {
+		var row []mcell
+		for _, g := range gs {
+			st := te
+			if isSpace(g) {
+				st = teSpace
+			}
+			row = append(row, mcell{g: g, w: gwidth(g), st: st, link: link, lp: linkParams})
+		}
+		rows = append(rows, row)
+	}
+
+	// Padding.
+	if !sp.inline {
+		padChar := " "
+		if sp.padChar != 0 {
+			padChar = string(sp.padChar)
+		}
+		padCell := mcell{g: padChar, w: gwidth(padChar), st: wsPen}
+		for y := range rows {
+			rows[y] = append(repeatCell(padCell, padL), rows[y]...)
+			rows[y] = append(rows[y], repeatCell(padCell, padR)...)
+		}
+		for i := 0; i < padT; i++ {
+			rows = append([][]mcell{{}}, rows...)
+		}
+		for i := 0; i < padB; i++ {
+			rows = append(rows, []mcell{})
+		}
+	}
+
+	// Height: the block is padded to it, the gap split by the vertical position (a
+	// fraction interpolates between Top and Bottom, as Position documents).
+	if height > 0 && height >= len(rows) {
+		gap := height - len(rows)
+		av := sp.alignVValue()
+		switch {
+		case av == Bottom:
+			rows = append(make([][]mcell, gap), rows...)
+		case av == Center:
+			top := gap / 2
+			rows = append(make([][]mcell, top), rows...)
+			rows = append(rows, make([][]mcell, gap-top)...)
+		case av == Top:
+			rows = append(rows, make([][]mcell, gap)...)
+		default:
+			top := int(math.Round(float64(gap) * av.value()))
+			rows = append(make([][]mcell, top), rows...)
+			rows = append(rows, make([][]mcell, gap-top)...)
+		}
+	}
+
+	// Horizontal alignment: every line padded to the block width (a fraction interpolates
+	// between Left and Right).
+	if len(rows) > 1 || width != 0 {
+		widest := 0
+		for _, r := range rows {
+			widest = max(widest, rowWidth(r))
+		}
+		target := max(widest, width)
+		sp1 := mcell{g: " ", w: 1, st: wsPen}
+		ah := sp.alignHValue()
+		for y, r := range rows {
+			short := target - rowWidth(r)
+			if short <= 0 {
+				continue
+			}
+			switch {
+			case ah == Right:
+				rows[y] = append(repeatCell(sp1, short), r...)
+			case ah == Center:
+				l := short / 2
+				rows[y] = append(append(repeatCell(sp1, l), r...), repeatCell(sp1, short-l)...)
+			case ah == Left:
+				rows[y] = append(r, repeatCell(sp1, short)...)
+			default:
+				l := int(math.Round(float64(short) * ah.value()))
+				rows[y] = append(append(repeatCell(sp1, l), r...), repeatCell(sp1, short-l)...)
+			}
+		}
+	}
+
+	if !sp.inline {
+		// Border.
+		if sp.border != nil && (bTop || bRight || bBottom || bLeft) {
+			b := borders[sp.border.name]
+			widest := 0
+			for _, r := range rows {
+				widest = max(widest, rowWidth(r))
+			}
+			fullWidth := widest
+			if bLeft {
+				if b.Left == "" {
+					b.Left = " "
+				}
+				fullWidth += maxRuneWidth(b.Left)
+			}
+			if bRight {
+				if b.Right == "" {
+					b.Right = " "
+				}
+				fullWidth += maxRuneWidth(b.Right)
+			}
+			corner := func(c string, show bool) string {
+				if !show {
+					return ""
+				}
+				if c == "" {
+					return " "
+				}
+				return string([]rune(c)[:1])
+			}
+			tl, tr := corner(b.TopLeft, bTop && bLeft), corner(b.TopRight, bTop && bRight)
+			bl, br := corner(b.BottomLeft, bBottom && bLeft), corner(b.BottomRight, bBottom && bRight)
+			pen := func(side int) mstyle {
+				return mstyle{fg: nilIfNo(sp.borderFg(side)), bg: nilIfNo(sp.borderBg(side))}
+			}
+			edge := func(l, mid, r string, side int) []mcell {
+				if mid == "" {
+					mid = " "
+				}
+				var row []mcell
+				for _, g := range graphemes(l) {
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+				}
+				mids := []rune(mid)
+				j := 0
+				for w := 0; w < fullWidth-gwidth(l)-gwidth(r); {
+					g := string(mids[j])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+					w += gwidth(g)
+					j = (j + 1) % len(mids)
+				}
+				for _, g := range graphemes(r) {
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+				}
+				return row
+			}
+			var out [][]mcell
+			if bTop {
+				out = append(out, edge(tl, b.Top, tr, 0))
+			}
+			leftRunes, rightRunes := []rune(b.Left), []rune(b.Right)
+			for i, r := range rows {
+				var row []mcell
+				if bLeft {
+					g := string(leftRunes[i%len(leftRunes)])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(3)})
+				}
+				row = append(row, r...)
+				if bRight {
+					g := string(rightRunes[i%len(rightRunes)])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(1)})
+				}
+				out = append(out, row)
+			}
+			if bBottom {
+				out = append(out, edge(bl, b.Bottom, br, 2))
+			}
+			rows = out
+		}
+		// Margins.
+		marChar := " "
+		if sp.marChar != 0 {
+			marChar = string(sp.marChar)
+		}
+		marPen := mstyle{bg: nilIfNo(sp.marBg)}
+		marCell := mcell{g: marChar, w: gwidth(marChar), st: marPen}
+		for y := range rows {
+			rows[y] = append(repeatCell(marCell, marL), rows[y]...)
+			rows[y] = append(rows[y], repeatCell(marCell, marR)...)
+		}
+		widest := 0
+		for _, r := range rows {
+			widest = max(widest, rowWidth(r))
+		}
+		blank := repeatCell(mcell{g: " ", w: 1, st: marPen}, widest)
+		for i := 0; i < marT; i++ {
+			rows = append([][]mcell{append([]mcell(nil), blank...)}, rows...)
+		}
+		for i := 0; i < marB; i++ {
+			rows = append(rows, append([]mcell(nil), blank...))
+		}
+	}
+
+	// MaxWidth: cells are dropped from the right, a wide cell that straddles the limit too.
+	if sp.maxWidth > 0 {
+		for y, r := range rows {
+			var kept []mcell
+			w := 0
+			for _, c := range r {
+				if w+c.w > sp.maxWidth {
+					break
+				}
+				kept = append(kept, c)
+				w += c.w
+			}
+			rows[y] = kept
+		}
+	}
+	if sp.maxHeight > 0 && len(rows) > sp.maxHeight {
+		rows = rows[:sp.maxHeight]
+	}
+	for y := range rows {
+		if rows[y] == nil {
+			rows[y] = []mcell{}
+		}
+	}
+	return rows, ""
+}
+
+func isSpace(g string) bool {
+	rs := []rune(g)
+	return len(rs) == 1 && unicode.IsSpace(rs[0])
+}
+
+func repeatCell(c mcell, k int) []mcell {
+	out := make([]mcell, 0, max(k, 0))
+	for i := 0; i < k; i++ {
+		out = append(out, c)
+	}
+	return out
+}
+
+// graphemes splits a plain string into grapheme clusters.
+func graphemes(s string) []string {
+	var out []string
+	var state byte
+	for len(s) > 0 {
+		g, _, k, ns := ansi.DecodeSequence(s, state, nil)
+		out = append(out, g)
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+func hasCluster(lines []textLine) bool {
+	for _, l := range lines {
+		for _, g := range l {
+			if len([]rune(g)) > 1 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// spaceStyler reports whether Render styles the text rune by rune (spaces separately).
+func (sp styleSpec) spaceStyler() bool {
+	ulSpaces := sp.hasUnderline()
+	if sp.ulSpaces != nil {
+		ulSpaces = *sp.ulSpaces
+	}
+	strikeSpaces := sp.strike
+	if sp.strikeSpaces != nil {
+		strikeSpaces = *sp.strikeSpaces
+	}
+	return (sp.hasUnderline() && !ulSpaces) || (sp.strike && !strikeSpaces) || ulSpaces || strikeSpaces
+}
+
+// tolerate walks the rendered rows against the model where a recorded bug is known to
+// differ: lipgloss/2 (reverse dropped from spaces by the space styler), lipgloss/3 (spaces
+// get a single underline whatever the text's underline style) and lipgloss/4 (the hyperlink
+// covers the padding, alignment, border and margin cells between the first line's text and
+// the last line's). By default a difference met is recorded as the bug's shape, so the
+// comparison fails naming it; under HEGEL_NO_KNOWN=1 the rendered cell is edited towards the
+// model and the tolerance counted.
+func tolerate(sp styleSpec, got, want [][]mcell, sh *shapes) {
+	// The link spans from the first line's text to the last line's, so padding, alignment,
+	// border and margin cells in between carry it.
+	multiLink := sp.link != nil
+	for y := range want {
+		if y >= len(got) {
+			return
+		}
+		for x := range want[y] {
+			if x >= len(got[y]) {
+				break
+			}
+			g, w := &got[y][x], want[y][x]
+			if multiLink && g.link != "" && w.link == "" {
+				if known.HyperlinkCoversWhitespace {
+					g.link, g.lp = "", ""
+					count("tolerated-link-on-whitespace")
+				} else {
+					sh.Add("lipgloss/4", true)
+				}
+			}
+			if !isSpaceCell(g.g) || !sp.spaceStyler() {
+				continue
+			}
+			if w.st.attrs&aReverse != 0 && g.st.attrs&aReverse == 0 {
+				if known.ReverseDroppedOnSpaces {
+					g.st.attrs |= aReverse
+					count("tolerated-reverse-dropped-on-space")
+				} else {
+					sh.Add("lipgloss/2", true)
+				}
+			}
+			if w.st.under != ansi.UnderlineNone && g.st.under == ansi.UnderlineSingle && w.st.under != g.st.under {
+				if known.SpacesUnderlinedSingle {
+					g.st.under = w.st.under
+					count("tolerated-single-underline-on-space")
+				} else {
+					sh.Add("lipgloss/3", true)
+				}
+			}
+		}
+	}
+}
+
+// renderCase is a style and a text for Render.
+type renderCase struct {
+	style styleSpec
+	text  textSpec
+}
+
+func (c renderCase) GoString() string { return c.style.GoString() + " " + c.text.GoString() }
+
+// renderCases: a style and a text; under HEGEL_NO_KNOWN=1 a style on the rune-by-rune path
+// gets a text without clusters (lipgloss/1's shape is then not drawn).
+var renderCases = hegel.Composite(func(tc hegel.TestCase) renderCase {
+	sp := hegel.Draw(tc, styles)
+	t := texts
+	if known.SpaceStylerTearsClusters && sp.spaceStyler() {
+		t = plainTexts
+	}
+	return renderCase{sp, hegel.Draw(tc, t)}
+})
+
+// checkRender renders the text with the style and compares the cells with the block model,
+// naming the case's known shapes on a mismatch: lipgloss/1 (a cluster on the rune-by-rune
+// path), /6 (a fractional vertical alignment with a Height), /7 (a fractional horizontal
+// alignment), and /2-/4 where tolerate met them. The size helpers and GetFrameSize are
+// checked against the same cells.
+func checkRender(ht *hegel.T, sp styleSpec, text textSpec, sh shapes) {
+	s := sp.apply()
+	str := text.String()
+	out := s.Render(str)
+	note(ht, "rendered %q", out)
+	if sp.props() == 0 {
+		want := strings.ReplaceAll(str, "\t", "    ")
+		if out != want {
+			fail(ht, "Render with no properties = %q, want the text with tabs expanded %q", out, want)
+		}
+		count("no-props")
+		return
+	}
+	lines := text.lines()
+	want, tag := modelRender(sp, lines)
+	if tag != "" {
+		count(tag)
+	}
+	sh.Add("lipgloss/1", sp.spaceStyler() && hasCluster(lines))
+	sh.Add("lipgloss/6", fractional(sp.alignVValue()) && sp.height != nil)
+	sh.Add("lipgloss/7", fractional(sp.alignHValue()))
+	got := parseCells(out)
+	tolerate(sp, got, want, &sh)
+	compareRows(ht, "Render", got, want, out, sh)
+	// The size helpers agree with the cells.
+	if w, h := Size(out); w != Width(out) || h != len(want) || h != Height(out) {
+		fail(ht, "Size(%q) = %dx%d, Height %d, model %d lines", out, w, h, Height(out), len(want))
+	}
+	widest := 0
+	for _, r := range want {
+		widest = max(widest, rowWidth(r))
+	}
+	if got := Width(out); got != widest {
+		fail(ht, "Width(%q) = %d, model %d", out, got, widest)
+	}
+	// GetFrameSize is what the frame adds around the content when nothing is clipped.
+	if sp.maxWidth == 0 && sp.maxHeight == 0 && !sp.inline {
+		pad, mar := sp.pad(), sp.mar()
+		hf, vf := s.GetFrameSize()
+		if hf != pad[3]+pad[1]+mar[3]+mar[1]+s.GetHorizontalBorderSize() || vf != pad[0]+pad[2]+mar[0]+mar[2]+s.GetVerticalBorderSize() {
+			fail(ht, "GetFrameSize() = %d,%d for %#v", hf, vf, sp)
+		}
+	}
+	count("ok")
+}
+
+// TestHegelRenderFollowsTheBlockModel: Style.Render against the cell model of the documented
+// layout, with Width, Height, Size and GetFrameSize checked on the same cells.
+func TestHegelRenderFollowsTheBlockModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, renderCases)
+		checkRender(ht, c.style, c.text, nil)
+	})
+}
+
+// ---------------------------------------------------------------- Join and Place
+
+// blocks: one to four lines of zero to six plain graphemes and spaces.
+var (
+	blockLines = hegel.Map(counted(weighted(w(80, plainGrapheme), w(20, hegel.Just(" "))), 0, 6), func(gs []string) string { return strings.Join(gs, "") })
+	blocks     = hegel.Map(counted(blockLines, 1, 4), func(ls []string) string { return strings.Join(ls, "\n") })
+
+	// joinPositions: the constants and fractions alike (the joins interpolate as documented).
+	joinPositions = pick(Top, Center, Bottom, 0.25, 0.7, 0.1)
+	// placePositions: a constant, or a fraction (lipgloss/5: mirrored by Place).
+	placePositions = weighted(w(50, pick(Top, Center, Bottom)), w(unless(known.PlaceMirrorsFractions, 50), pick(Position(0.25), 0.7, 0.1)))
+)
+
+func padTo(line string, w int) string {
+	return line + strings.Repeat(" ", max(0, w-ansi.StringWidth(line)))
+}
+
+// joinCase: the blocks and the position.
+type joinCase struct {
+	blocks []string
+	pos    Position
+}
+
+func (c joinCase) GoString() string { return fmt.Sprintf("join %v of %q", c.pos, c.blocks) }
+
+var joinCases = hegel.Composite(func(tc hegel.TestCase) joinCase {
+	return joinCase{blocks: hegel.Draw(tc, counted(blocks, 0, 4)), pos: hegel.Draw(tc, joinPositions)}
+})
+
+func TestHegelJoinsFollowTheirModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, joinCases)
+		blocks, pos := c.blocks, c.pos
+		// JoinHorizontal: each block padded to its own width, made the same height with
+		// round(gap*pos) blank lines above; lines concatenated.
+		gotH := JoinHorizontal(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotH != want {
+				fail(ht, "JoinHorizontal(%v, %q) = %q", pos, blocks, gotH)
+			}
+		} else {
+			maxH := 0
+			var split [][]string
+			var widths []int
+			for _, b := range blocks {
+				ls := strings.Split(b, "\n")
+				split = append(split, ls)
+				widths = append(widths, Width(b))
+				maxH = max(maxH, len(ls))
+			}
+			for i := range split {
+				gap := maxH - len(split[i])
+				above := int(math.Round(float64(gap) * pos.value()))
+				padded := make([]string, above)
+				padded = append(padded, split[i]...)
+				for len(padded) < maxH {
+					padded = append(padded, "")
+				}
+				split[i] = padded
+			}
+			var want []string
+			for y := 0; y < maxH; y++ {
+				var sb strings.Builder
+				for i := range split {
+					sb.WriteString(padTo(split[i][y], widths[i]))
+				}
+				want = append(want, sb.String())
+			}
+			if w := strings.Join(want, "\n"); gotH != w {
+				fail(ht, "JoinHorizontal(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotH, w)
+			}
+		}
+		// JoinVertical: every line padded to the widest block, round(gap*pos) spaces on the
+		// left.
+		gotV := JoinVertical(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotV != want {
+				fail(ht, "JoinVertical(%v, %q) = %q", pos, blocks, gotV)
+			}
+		} else {
+			maxW := 0
+			for _, b := range blocks {
+				maxW = max(maxW, Width(b))
+			}
+			var want []string
+			for _, b := range blocks {
+				for _, l := range strings.Split(b, "\n") {
+					gap := maxW - ansi.StringWidth(l)
+					left := int(math.Round(float64(gap) * pos.value()))
+					want = append(want, strings.Repeat(" ", left)+l+strings.Repeat(" ", gap-left))
+				}
+			}
+			if w := strings.Join(want, "\n"); gotV != w {
+				fail(ht, "JoinVertical(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotV, w)
+			}
+		}
+		count("ok")
+	})
+}
+
+// wsFill is the whitespace renderer's model: the chars cycled until the width is filled, a
+// wide char that overshoots is written (the width then runs over) - the code's own rule; the
+// model uses narrow chars only.
+func wsFill(chars string, width int) string {
+	if chars == "" {
+		chars = " "
+	}
+	rs := []rune(chars)
+	var sb strings.Builder
+	for i, j := 0, 0; i < width; j = (j + 1) % len(rs) {
+		sb.WriteRune(rs[j])
+		i += max(1, ansi.StringWidth(string(rs[j])))
+	}
+	return sb.String()
+}
+
+// placeCase: the block, the box, the positions and the whitespace chars.
+type placeCase struct {
+	block         string
+	width, height int
+	hPos, vPos    Position
+	chars         string
+}
+
+func (c placeCase) GoString() string {
+	return fmt.Sprintf("Place(%d, %d, %v, %v, %q, chars %q)", c.width, c.height, c.hPos, c.vPos, c.block, c.chars)
+}
+
+func placeCasesOf(positions hegel.Generator[Position]) hegel.Generator[placeCase] {
+	return hegel.Composite(func(tc hegel.TestCase) placeCase {
+		return placeCase{
+			block:  hegel.Draw(tc, blocks),
+			width:  hegel.Draw(tc, hegel.Integers(0, 14)),
+			height: hegel.Draw(tc, hegel.Integers(0, 6)),
+			hPos:   hegel.Draw(tc, positions),
+			vPos:   hegel.Draw(tc, positions),
+			chars:  hegel.Draw(tc, pick("", " ", ".", "ab", "-=")),
+		}
+	})
+}
+
+var placeCases = placeCasesOf(placePositions)
+
+// checkPlace: PlaceHorizontal puts each line after round(total*pos) columns of whitespace
+// (0 the start, 1 the end; Center splits the gap with the smaller half first), PlaceVertical
+// round(gap*pos) blank lines above, and Place is their composition. A fractional position
+// that comes out mirrored is lipgloss/5's shape.
+func checkPlace(ht *hegel.T, c placeCase, sh shapes) {
+	block := c.block
+	lines := strings.Split(block, "\n")
+	cw, chh := Width(block), len(lines)
+	width, height, hPos, vPos, chars := c.width, c.height, c.hPos, c.vPos, c.chars
+	var opts []WhitespaceOption
+	if chars != "" {
+		opts = append(opts, WithWhitespaceChars(chars))
+	}
+	wantH := block
+	if gap := width - cw; gap > 0 {
+		var out []string
+		for _, l := range lines {
+			total := gap + cw - ansi.StringWidth(l)
+			left := int(math.Round(float64(total) * hPos.value()))
+			if hPos == Center {
+				left = total / 2
+			}
+			out = append(out, wsFill(chars, left)+l+wsFill(chars, total-left))
+		}
+		wantH = strings.Join(out, "\n")
+	}
+	gotH := PlaceHorizontal(width, hPos, block, opts...)
+	if gotH != wantH {
+		h := sh
+		h.Add("lipgloss/5", fractional(hPos))
+		mismatch(ht, h, "PlaceHorizontal(%d, %v, %q) =\n%q\nmodel\n%q", width, hPos, block, gotH, wantH)
+	}
+	wantV := gotH
+	if gap := height - chh; gap > 0 {
+		above := int(math.Round(float64(gap) * vPos.value()))
+		if vPos == Center {
+			above = gap / 2
+		}
+		empty := wsFill(chars, Width(gotH))
+		var out []string
+		for i := 0; i < above; i++ {
+			out = append(out, empty)
+		}
+		out = append(out, strings.Split(gotH, "\n")...)
+		for i := 0; i < gap-above; i++ {
+			out = append(out, empty)
+		}
+		wantV = strings.Join(out, "\n")
+	}
+	gotV := PlaceVertical(height, vPos, gotH, opts...)
+	if gotV != wantV {
+		v := sh
+		v.Add("lipgloss/5", fractional(vPos))
+		mismatch(ht, v, "PlaceVertical(%d, %v, %q) =\n%q\nmodel\n%q", height, vPos, gotH, gotV, wantV)
+	}
+	if got := Place(width, height, hPos, vPos, block, opts...); got != gotV {
+		fail(ht, "Place = %q, PlaceVertical(PlaceHorizontal) = %q", got, gotV)
+	}
+	count("ok")
+}
+
+func TestHegelPlaceFollowsItsModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkPlace(ht, hegel.Draw(ht, placeCases), nil)
+	})
+}
+
+// ---------------------------------------------------------------- Wrap
+
+// styledGraphemes walks a styled string and returns its non-space graphemes with the pen and
+// link in force at each, plus the plain text without whitespace.
+func styledGraphemes(s string) (gs []string, sts []mstyle, links []string, plain string) {
+	for _, row := range parseCells(s) {
+		for _, c := range row {
+			if isSpaceCell(c.g) || c.g == "\t" || c.g == "\r" {
+				continue
+			}
+			gs = append(gs, c.g)
+			sts = append(sts, c.st)
+			links = append(links, c.link)
+			plain += c.g
+		}
+	}
+	return
+}
+
+// inlineStyle is a style that colours text without changing its layout.
+type inlineStyle struct {
+	bold, italic, reverse bool
+	fg, bg                color.Color
+}
+
+func (s inlineStyle) apply() Style {
+	st := NewStyle().Bold(s.bold).Italic(s.italic).Reverse(s.reverse)
+	if s.fg != nil {
+		st = st.Foreground(s.fg)
+	}
+	if s.bg != nil {
+		st = st.Background(s.bg)
+	}
+	return st
+}
+
+// pen is the mstyle the inline style sets on a text cell.
+func (s inlineStyle) pen() mstyle {
+	var st mstyle
+	if s.bold {
+		st.attrs |= aBold
+	}
+	if s.italic {
+		st.attrs |= aItalic
+	}
+	if s.reverse {
+		st.attrs |= aReverse
+	}
+	st.fg, st.bg = nilIfNo(s.fg), nilIfNo(s.bg)
+	return st
+}
+
+func (s inlineStyle) GoString() string {
+	return fmt.Sprintf("{bold %v italic %v reverse %v fg %v bg %v}", s.bold, s.italic, s.reverse, s.fg, s.bg)
+}
+
+var inlineStyles = hegel.Composite(func(tc hegel.TestCase) inlineStyle {
+	return inlineStyle{
+		bold:    hegel.Draw(tc, chance(25)),
+		italic:  hegel.Draw(tc, chance(15)),
+		reverse: hegel.Draw(tc, chance(15)),
+		fg:      hegel.Draw(tc, maybe(40, colors)),
+		bg:      hegel.Draw(tc, maybe(40, colors)),
+	}
+})
+
+// piece is one part of a styled text: a run of graphemes (with a trailing space or not), a
+// styled "x", a reset, a hyperlink, or a separator.
+type piece struct {
+	kind  string
+	text  string
+	style inlineStyle
+}
+
+func (p piece) String() string {
+	switch p.kind {
+	case "styled":
+		return p.style.apply().Render("x")
+	case "reset":
+		return "\x1b[m"
+	case "link":
+		return ansi.SetHyperlink(p.text, "")
+	}
+	return p.text
+}
+
+var (
+	textRuns = hegel.Composite(func(tc hegel.TestCase) piece {
+		s := strings.Join(hegel.Draw(tc, counted(plainGrapheme, 1, 6)), "")
+		if hegel.Draw(tc, chance(60)) {
+			s += " "
+		}
+		return piece{kind: "text", text: s}
+	})
+	pieces = weighted(
+		w(60, textRuns),
+		w(10, hegel.Map(inlineStyles, func(s inlineStyle) piece { return piece{kind: "styled", style: s} })),
+		w(10, hegel.Just(piece{kind: "reset"})),
+		w(10, hegel.Map(hegel.Integers(0, 9), func(i int) piece { return piece{kind: "link", text: fmt.Sprintf("https://example.com/%d", i)} })),
+		w(10, hegel.Map(pick(" ", "  ", "\n", "-", " - "), func(s string) piece { return piece{kind: "sep", text: s} })),
+	)
+	styledTexts = hegel.Map(counted(pieces, 0, 12), func(ps []piece) string {
+		var sb strings.Builder
+		for _, p := range ps {
+			sb.WriteString(p.String())
+		}
+		return sb.String()
+	})
+)
+
+type wrapCase struct {
+	in    string
+	limit int
+}
+
+func (c wrapCase) GoString() string { return fmt.Sprintf("Wrap(%q, %d)", c.in, c.limit) }
+
+var wrapCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	return wrapCase{in: hegel.Draw(tc, styledTexts), limit: hegel.Draw(tc, hegel.Integers(1, 16))}
+})
+
+func TestHegelWrapKeepsContentAndStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wrapCases)
+		in, limit := c.in, c.limit
+		out := Wrap(in, limit, "")
+		// lipgloss only re-applies styles around ansi.Wrap's newlines: the visible text is
+		// ansi.Wrap's. Lines wider than the limit are x/ansi's own (x-ansi/8, /12, /19, /21 in
+		// this zoo) and are counted, not failed, when ansi.Wrap produced them.
+		raw := ansi.Wrap(in, limit, "")
+		if ansi.Strip(out) != ansi.Strip(raw) {
+			fail(ht, "Wrap changes the visible text of ansi.Wrap: %q vs %q (input %q)", ansi.Strip(out), ansi.Strip(raw), in)
+		}
+		rawLines := strings.Split(raw, "\n")
+		for i, line := range strings.Split(out, "\n") {
+			if w := ansi.StringWidth(line); w > limit {
+				if i < len(rawLines) && ansi.StringWidth(rawLines[i]) > limit {
+					count("x-ansi-wrap-overflow")
+					continue
+				}
+				fail(ht, "line %d %q has width %d > %d in %q", i, line, w, limit, out)
+			}
+		}
+		gi, si, li, pi := styledGraphemes(in)
+		go_, so, lo, po := styledGraphemes(out)
+		if pi != po {
+			fail(ht, "content changed: %q -> %q (plain %q vs %q)", in, out, pi, po)
+		}
+		for i := range gi {
+			if !sameCell(mcell{g: gi[i], w: 1, st: si[i], link: li[i]}, mcell{g: go_[i], w: 1, st: so[i], link: lo[i]}) {
+				fail(ht, "grapheme %d %q: %s link %q in, %s link %q out\nin  %q\nout %q", i, gi[i], si[i], li[i], so[i], lo[i], in, out)
+			}
+		}
+		if strings.Count(out, "\n") < strings.Count(in, "\n") {
+			fail(ht, "newlines lost: %q -> %q", in, out)
+		}
+		// Every newline is preceded by a reset when a style or link is open, so a line never
+		// carries the previous line's pen into a consumer that handles lines separately.
+		outLines := strings.Split(out, "\n")
+		for i, line := range outLines[:len(outLines)-1] {
+			// The pen after the line is what a probe cell appended to it receives.
+			end := parseCells(line + "x")
+			last := end[0][len(end[0])-1]
+			if last.st != (mstyle{}) || last.link != "" {
+				fail(ht, "line %d %q ends with an open pen %s link %q in %q", i, line, last.st, last.link, out)
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- StyleRanges
+
+// rangeSpec places one range after the previous one: skip graphemes from where the last
+// range ended (modulo what is left), span graphemes long (at least one), with a style.
+type rangeSpec struct {
+	skip, span int
+	style      inlineStyle
+}
+
+// rangesCase: the graphemes of the text and the range specs.
+type rangesCase struct {
+	gs     []string
+	ranges []rangeSpec
+}
+
+func (c rangesCase) GoString() string {
+	return fmt.Sprintf("StyleRanges(%q, %d ranges)", strings.Join(c.gs, ""), len(c.ranges))
+}
+
+var (
+	rangeSpecs = hegel.Composite(func(tc hegel.TestCase) rangeSpec {
+		return rangeSpec{skip: hegel.Draw(tc, hegel.Integers(0, 11)), span: hegel.Draw(tc, hegel.Integers(0, 11)), style: hegel.Draw(tc, inlineStyles)}
+	})
+	rangesCases = hegel.Composite(func(tc hegel.TestCase) rangesCase {
+		return rangesCase{
+			gs:     hegel.Draw(tc, counted(weighted(w(85, plainGrapheme), w(15, hegel.Just(" "))), 0, 12)),
+			ranges: hegel.Draw(tc, counted(rangeSpecs, 0, 3)),
+		}
+	})
+)
+
+// place turns the specs into disjoint, ordered grapheme ranges [a, b) of the text.
+func (c rangesCase) place() (bounds [][2]int, styles []inlineStyle) {
+	cur := 0
+	for _, r := range c.ranges {
+		if cur >= len(c.gs) {
+			break
+		}
+		a := cur + r.skip%(len(c.gs)-cur)
+		b := a + 1 + r.span%(len(c.gs)-a)
+		bounds = append(bounds, [2]int{a, b})
+		styles = append(styles, r.style)
+		cur = b
+	}
+	return
+}
+
+func TestHegelStyleRangesStyleTheirCells(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rangesCases)
+		gs := c.gs
+		text := strings.Join(gs, "")
+		// Cell offsets at grapheme boundaries.
+		offsets := []int{0}
+		for _, g := range gs {
+			offsets = append(offsets, offsets[len(offsets)-1]+gwidth(g))
+		}
+		total := offsets[len(offsets)-1]
+		bounds, styles := c.place()
+		var ranges []Range
+		for i, b := range bounds {
+			ranges = append(ranges, NewRange(offsets[b[0]], offsets[b[1]], styles[i].apply()))
+		}
+		note(ht, "StyleRanges(%q, %v) total width %d", text, ranges, total)
+		out := StyleRanges(text, ranges...)
+		rows := parseCells(out)
+		if len(rows) != 1 {
+			fail(ht, "StyleRanges produced %d lines: %q", len(rows), out)
+		}
+		var want []mcell
+		x := 0
+		for _, g := range gs {
+			var st mstyle
+			for i, r := range ranges {
+				if x >= r.Start && x < r.End {
+					st = styles[i].pen()
+				}
+			}
+			want = append(want, mcell{g: g, w: gwidth(g), st: st})
+			x += gwidth(g)
+		}
+		compareRows(ht, "StyleRanges", rows, [][]mcell{want}, out, nil)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- Inherit
+
+type stylePair struct {
+	a, b styleSpec
+}
+
+func (p stylePair) GoString() string { return "a " + p.a.GoString() + "\nb " + p.b.GoString() }
+
+var stylePairs = hegel.Composite(func(tc hegel.TestCase) stylePair {
+	return stylePair{hegel.Draw(tc, styles), hegel.Draw(tc, styles)}
+})
+
+func TestHegelInheritTakesUnsetValuesOnly(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, stylePairs)
+		a, b := p.a.apply(), p.b.apply()
+		c := a.Inherit(b)
+		// Colours and attributes: a's if set, else b's.
+		wantFg := a.GetForeground()
+		if !a.isSet(foregroundKey) {
+			wantFg = b.GetForeground()
+		}
+		if !colorEqual(c.GetForeground(), wantFg) {
+			fail(ht, "Inherit foreground = %v, want %v", c.GetForeground(), wantFg)
+		}
+		if got, want := c.GetBold(), a.GetBold() || (!a.isSet(boldKey) && b.GetBold()); got != want {
+			fail(ht, "Inherit bold = %v, want %v", got, want)
+		}
+		if got, want := c.GetWidth(), a.GetWidth(); !a.isSet(widthKey) && b.isSet(widthKey) {
+			if got != b.GetWidth() {
+				fail(ht, "Inherit width = %d, want b's %d", got, b.GetWidth())
+			}
+		} else if got != want {
+			fail(ht, "Inherit width = %d, want a's %d", got, want)
+		}
+		// Margins and padding are never inherited.
+		if c.GetPaddingLeft() != a.GetPaddingLeft() || c.GetMarginLeft() != a.GetMarginLeft() || c.GetPaddingTop() != a.GetPaddingTop() || c.GetMarginBottom() != a.GetMarginBottom() {
+			fail(ht, "Inherit copied padding or margins: %d/%d, a had %d/%d", c.GetPaddingLeft(), c.GetMarginLeft(), a.GetPaddingLeft(), a.GetMarginLeft())
+		}
+		// The margin background follows an inherited background when neither set one.
+		if b.isSet(backgroundKey) && !a.isSet(marginBackgroundKey) && !b.isSet(marginBackgroundKey) {
+			if !colorEqual(c.getAsColor(marginBackgroundKey), b.GetBackground()) {
+				fail(ht, "Inherit margin background = %v, want b's background %v", c.getAsColor(marginBackgroundKey), b.GetBackground())
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/1: with underline or strikethrough on (the rune-by-rune "space styler" path),
+// every rune is styled separately, so grapheme clusters such as ZWJ emoji sequences are torn
+// apart by SGR sequences; the rendered width grows accordingly.
+func TestHegelPinSpaceStylerTearsGraphemeClusters(t *testing.T) {
+	defer guard(t)
+	family := "👨‍👩‍👧"
+	out := NewStyle().Underline(true).Render(family)
+	if strings.Contains(out, family) {
+		return
+	}
+	if w := Width(out); w == Width(family) {
+		return
+	}
+	t.Fatalf("Underline(true).Render(%q) = %q (width %d, the cluster's width is %d)", family, out, Width(out), Width(family))
+}
+
+// lipgloss/2: on the space styler path, spaces get only colours, underline and strikethrough;
+// Reverse is dropped, so a reversed underlined string has an unreversed hole at every space.
+func TestHegelPinReverseDroppedFromSpacesUnderUnderline(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Reverse(true).Underline(true).Render("a b")
+	rows := parseCells(out)
+	if len(rows) == 1 && len(rows[0]) == 3 && rows[0][1].st.attrs&aReverse != 0 {
+		return
+	}
+	t.Fatalf("Reverse(true).Underline(true).Render(\"a b\") = %q: the space is not reversed", out)
+}
+
+// lipgloss/3: spaces are underlined with a plain single underline whatever UnderlineStyle the
+// text uses, so a curly-underlined string has straight underlines under its spaces.
+func TestHegelPinSpacesUnderlinedSingleUnderCurlyText(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().UnderlineStyle(ansi.UnderlineCurly).Render("a b")
+	rows := parseCells(out)
+	if len(rows) == 1 && len(rows[0]) == 3 && rows[0][1].st.under == ansi.UnderlineCurly {
+		return
+	}
+	t.Fatalf("UnderlineStyle(Curly).Render(\"a b\") = %q: the space has underline %d, the text %d", out, rows[0][1].st.under, rows[0][0].st.under)
+}
+
+// lipgloss/4: the hyperlink is opened before the first line and closed after the last, so the
+// padding and alignment whitespace of every line but the first (left) and last (right) is
+// part of the link while the first line's padding is not.
+func TestHegelPinHyperlinkCoversPaddingOfContinuationLines(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Hyperlink("https://example.com").PaddingLeft(2).Render("a\nb")
+	rows := parseCells(out)
+	if len(rows) != 2 || len(rows[0]) != 3 || len(rows[1]) != 3 {
+		t.Fatalf("unexpected shape %q", out)
+	}
+	if rows[0][0].link == rows[1][0].link {
+		return
+	}
+	t.Fatalf("Hyperlink(...).PaddingLeft(2).Render(\"a\\nb\") = %q: the first line's padding has link %q, the second line's %q", out, rows[0][0].link, rows[1][0].link)
+}
+
+// lipgloss/5: PlaceHorizontal and PlaceVertical put a fractional position on the wrong side
+// (0.9 lands near the start), the mirror image of what JoinHorizontal/JoinVertical and the
+// docs ("0 is the start, 1 the end") do.
+func TestHegelPinPlaceMirrorsFractionalPositions(t *testing.T) {
+	defer guard(t)
+	h := PlaceHorizontal(10, 0.9, "ab")
+	v := PlaceVertical(4, 0.9, "ab")
+	jh := JoinVertical(0.9, "ab", strings.Repeat("x", 10))
+	if h == "       ab " && v == "  \n  \n ab\n  "[:0]+"  \n  \n  \nab" {
+		return
+	}
+	t.Fatalf("PlaceHorizontal(10, 0.9, \"ab\") = %q and PlaceVertical(4, 0.9, \"ab\") = %q, while JoinVertical(0.9, ...) puts the text on the right: %q", h, v, strings.Split(jh, "\n")[0])
+}
+
+// lipgloss/6: Height is ignored when AlignVertical is a fractional position: the block is not
+// padded to its height at all.
+func TestHegelPinHeightIgnoredForFractionalVerticalAlign(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Height(4).AlignVertical(0.3).Render("ab")
+	if Height(out) == 4 {
+		return
+	}
+	t.Fatalf("Height(4).AlignVertical(0.3).Render(\"ab\") = %q (height %d), Height(4).Render = %q", out, Height(out), NewStyle().Height(4).Render("ab"))
+}
+
+// lipgloss/7: a fractional horizontal alignment is treated as Left: Align(0.9) with a Width
+// puts the text at the left edge.
+func TestHegelPinFractionalHorizontalAlignIsLeft(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Width(6).Align(0.9).Render("ab")
+	if out != "ab    " {
+		return
+	}
+	t.Fatalf("Width(6).Align(0.9).Render(\"ab\") = %q, the same as Align(Left)", out)
+}
