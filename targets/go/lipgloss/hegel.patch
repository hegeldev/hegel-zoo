+func TestHegelRenderFollowsTheBlockModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp, s := genSpec(ht)
+		lines, text := genText(ht, true, !sp.hasTabWidth || sp.tabWidth >= 0)
+		note(ht, "style %+v", sp)
+		note(ht, "text %q", text)
+		out := s.Render(text)
+		note(ht, "rendered %q", out)
+		if sp.props == 0 {
+			want := strings.ReplaceAll(text, "\t", "    ")
+			if out != want {
+				fail(ht, "Render with no properties = %q, want the text with tabs expanded %q", out, want)
+			}
+			count("no-props")
+			return
+		}
+		want, tag := modelRender(sp, lines)
+		if tag != "" {
+			count(tag)
+		}
+		if sp.spaceStyler() && hasCluster(lines) {
+			// lipgloss/1: the space styler tears grapheme clusters apart.
+			count("cluster-torn")
+			return
+		}
+		got := parseCells(out)
+		tolerate(sp, got, want)
+		compareRows(ht, "Render", got, want, out)
