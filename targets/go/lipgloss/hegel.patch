+// ---------------------------------------------------------------- StyleRanges
+
+func TestHegelStyleRangesStyleTheirCells(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var gs []string
+		for k := n(ht, 0, 12); k > 0; k-- {
+			if chance(ht, 15) {
+				gs = append(gs, " ")
+			} else {
+				gs = append(gs, genGrapheme(ht, true, false))
+			}
+		}
+		text := strings.Join(gs, "")
+		// Cell offsets at grapheme boundaries.
+		offsets := []int{0}
+		for _, g := range gs {
+			offsets = append(offsets, offsets[len(offsets)-1]+gwidth(g))
+		}
+		total := offsets[len(offsets)-1]
+		var ranges []Range
+		var specs []spec
+		cur := 0
+		for k := n(ht, 0, 3); k > 0 && cur < len(gs); k-- {
+			a := n(ht, cur, len(gs)-1)
+			b := n(ht, a+1, len(gs))
+			sp, st := genSpec(ht)
+			st = NewStyle().Bold(sp.bold).Italic(sp.italic).Reverse(sp.reverse)
+			if sp.fg != nil {
+				st = st.Foreground(sp.fg)
+			}
+			if sp.bg != nil {
+				st = st.Background(sp.bg)
+			}
+			ranges = append(ranges, NewRange(offsets[a], offsets[b], st))
+			specs = append(specs, sp)
+			cur = b
+		}
+		note(ht, "StyleRanges(%q, %v) total width %d", text, ranges, total)
+		out := StyleRanges(text, ranges...)
+		rows := parseCells(out)
+		if len(rows) != 1 {
+			fail(ht, "StyleRanges produced %d lines: %q", len(rows), out)
+		}
+		var want []mcell
+		x := 0
+		for _, g := range gs {
+			var st mstyle
+			for i, r := range ranges {
+				if x >= r.Start && x < r.End {
+					sp := specs[i]
+					if sp.bold {
+						st.attrs |= aBold
+					}
+					if sp.italic {
+						st.attrs |= aItalic
+					}
+					if sp.reverse {
+						st.attrs |= aReverse
+					}
+					st.fg, st.bg = nilIfNo(sp.fg), nilIfNo(sp.bg)
+				}
+			}
+			want = append(want, mcell{g: g, w: gwidth(g), st: st})
+			x += gwidth(g)
+		}
+		compareRows(ht, "StyleRanges", rows, [][]mcell{want}, out)
+		count("ok")
+	})
+}
