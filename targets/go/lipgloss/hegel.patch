+package lipgloss
+
+// Hegel property tests for charm.land/lipgloss/v2 (hegel-zoo target go/lipgloss).
+//
+// Style.Render is checked against a cell model of the documented layout rules: the text is
+// split into graphemes, wrapped, styled, padded, sized, aligned, bordered and margined the way
+// the README and the method docs describe, and the rendered string is parsed back into cells
+// (graphemes with the SGR pen and hyperlink in force) and compared cell by cell. Join*,
+// Place*, Wrap, StyleRanges, Inherit and the size helpers have their own models.
+
+import (
+	"fmt"
+	"image/color"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("LIPGLOSS_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, msg)
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- cells and SGR
+
+const (
+	aBold uint8 = 1 << iota
+	aFaint
+	aItalic
+	aBlink
+	aRapidBlink
+	aReverse
+	aConceal
+	aStrike
+)
+
+// mstyle is the pen: what an SGR-reading terminal holds for a cell.
+type mstyle struct {
+	fg, bg, ul color.Color
+	attrs      uint8
+	under      ansi.Underline
+}
+
+func (s mstyle) String() string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b under:%d}", s.fg, s.bg, s.ul, s.attrs, s.under)
+}
+
+func colorEqual(c, o color.Color) bool {
+	if c == nil && o == nil {
+		return true
+	}
+	if c == nil || o == nil {
+		return false
+	}
+	cr, cg, cb, ca := c.RGBA()
+	or, og, ob, oa := o.RGBA()
+	return cr == or && cg == og && cb == ob && ca == oa
+}
+
+// mcell is one screen cell: a grapheme with its width, pen and hyperlink.
+type mcell struct {
+	g    string
+	w    int
+	st   mstyle
+	link string // URL
+	lp   string // link params
+}
+
+func (c mcell) String() string {
+	s := fmt.Sprintf("{%q w%d %s", c.g, c.w, c.st)
+	if c.link != "" {
+		s += fmt.Sprintf(" link=%s;%s", c.lp, c.link)
+	}
+	return s + "}"
+}
+
+// applySGR applies one SGR parameter list to st following ECMA-48 and the xterm/kitty colour
+// and underline extensions.
+func applySGR(params []ansi.Param, st *mstyle) {
+	if len(params) == 0 {
+		*st = mstyle{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		p := params[i]
+		v := p.Param(0)
+		switch {
+		case v == 0:
+			*st = mstyle{}
+		case v == 1:
+			st.attrs |= aBold
+		case v == 2:
+			st.attrs |= aFaint
+		case v == 3:
+			st.attrs |= aItalic
+		case v == 4:
+			if p.HasMore() && i+1 < len(params) {
+				i++
+				st.under = ansi.Underline(params[i].Param(1))
+			} else {
+				st.under = ansi.UnderlineSingle
+			}
+		case v == 5:
+			st.attrs |= aBlink
+		case v == 6:
+			st.attrs |= aRapidBlink
+		case v == 7:
+			st.attrs |= aReverse
+		case v == 8:
+			st.attrs |= aConceal
+		case v == 9:
+			st.attrs |= aStrike
+		case v == 22:
+			st.attrs &^= aBold | aFaint
+		case v == 23:
+			st.attrs &^= aItalic
+		case v == 24:
+			st.under = ansi.UnderlineNone
+		case v == 25:
+			st.attrs &^= aBlink | aRapidBlink
+		case v == 27:
+			st.attrs &^= aReverse
+		case v == 28:
+			st.attrs &^= aConceal
+		case v == 29:
+			st.attrs &^= aStrike
+		case v >= 30 && v <= 37:
+			st.fg = ansi.BasicColor(v - 30)
+		case v == 39:
+			st.fg = nil
+		case v >= 40 && v <= 47:
+			st.bg = ansi.BasicColor(v - 40)
+		case v == 49:
+			st.bg = nil
+		case v == 59:
+			st.ul = nil
+		case v >= 90 && v <= 97:
+			st.fg = ansi.BasicColor(v - 90 + 8)
+		case v >= 100 && v <= 107:
+			st.bg = ansi.BasicColor(v - 100 + 8)
+		case v == 38 || v == 48 || v == 58:
+			end := i
+			for end+1 < len(params) && params[end].HasMore() {
+				end++
+			}
+			run := params[i : end+1]
+			if len(run) == 1 {
+				run = params[i:min(len(params), i+5)]
+				if len(run) > 1 && run[1].Param(0) == 5 {
+					run = run[:3]
+				}
+				end = i + len(run) - 1
+			}
+			var c color.Color
+			switch {
+			case len(run) >= 3 && run[1].Param(0) == 5:
+				c = ansi.ExtendedColor(run[2].Param(0))
+			case len(run) == 6 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[3].Param(0)), G: uint8(run[4].Param(0)), B: uint8(run[5].Param(0)), A: 0xff}
+			case len(run) >= 5 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[2].Param(0)), G: uint8(run[3].Param(0)), B: uint8(run[4].Param(0)), A: 0xff}
+			}
+			switch v {
+			case 38:
+				st.fg = c
+			case 48:
+				st.bg = c
+			default:
+				st.ul = c
+			}
+			i = end
+		}
+	}
+}
+
+// parseCells replays a rendered string onto rows of cells: text lands with the pen and link
+// in force, SGR and OSC 8 move the pen, "\n" starts a row. Zero-width graphemes (a combining
+// mark separated from its base by a sequence) become cells of width 0.
+func parseCells(out string) [][]mcell {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st mstyle
+	var link, lp string
+	var state byte
+	rows := [][]mcell{{}}
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			parts := strings.SplitN(string(p.Data()), ";", 3)
+			if len(parts) == 3 {
+				lp, link = parts[1], parts[2]
+			}
+		case sq == "\n":
+			rows = append(rows, []mcell{})
+		case sq == "\r":
+			// Left in place: the model never expects one.
+			rows[len(rows)-1] = append(rows[len(rows)-1], mcell{g: "\r", w: 0, st: st, link: link, lp: lp})
+		case ansi.HasEscPrefix(sq) || ansi.HasCsiPrefix(sq) || ansi.HasOscPrefix(sq) || ansi.HasDcsPrefix(sq):
+			// Other sequences do not draw.
+		default:
+			rows[len(rows)-1] = append(rows[len(rows)-1], mcell{g: sq, w: w, st: st, link: link, lp: lp})
+		}
+		out = out[k:]
+		state = ns
+	}
+	return rows
+}
+
+func rowsString(rows [][]mcell) string {
+	var sb strings.Builder
+	for y, r := range rows {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range r {
+			sb.WriteString(" " + c.String())
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func rowsRow(r []mcell) string {
+	var sb strings.Builder
+	for _, c := range r {
+		sb.WriteString(" " + c.String())
+	}
+	return sb.String()
+}
+
+func rowsPlain(rows [][]mcell) string {
+	lines := make([]string, len(rows))
+	for y, r := range rows {
+		var sb strings.Builder
+		for _, c := range r {
+			sb.WriteString(c.g)
+		}
+		lines[y] = sb.String()
+	}
+	return strings.Join(lines, "\n")
+}
+
+func isSpaceCell(g string) bool {
+	return g == " " || g == " "
+}
+
+// sameCell compares two cells up to what a terminal shows: on a blank, bold, faint, italic,
+// blink and the foreground colour are invisible; an underline colour without an underline is
+// invisible everywhere.
+func sameCell(a, b mcell) bool {
+	if a.g != b.g || a.w != b.w || a.link != b.link || a.lp != b.lp {
+		return false
+	}
+	as, bs := a.st, b.st
+	if isSpaceCell(a.g) {
+		invisible := aBold | aFaint | aItalic | aBlink | aRapidBlink
+		as.attrs &^= invisible
+		bs.attrs &^= invisible
+		as.fg, bs.fg = nil, nil
+	}
+	if as.under == ansi.UnderlineNone {
+		as.ul = nil
+	}
+	if bs.under == ansi.UnderlineNone {
+		bs.ul = nil
+	}
+	return as.attrs == bs.attrs && as.under == bs.under && colorEqual(as.fg, bs.fg) && colorEqual(as.bg, bs.bg) && colorEqual(as.ul, bs.ul)
+}
+
+func compareRows(ht *hegel.T, what string, got, want [][]mcell, out string) {
+	if len(got) != len(want) {
+		fail(ht, "%s: %d lines rendered, model has %d\nrendered %q\ngot   %q\nmodel %q", what, len(got), len(want), out, rowsPlain(got), rowsPlain(want))
+	}
+	for y := range want {
+		if len(got[y]) != len(want[y]) {
+			fail(ht, "%s: line %d has %d cells, model has %d\nrendered %q\ngot   %q\nmodel %q", what, y, len(got[y]), len(want[y]), out, rowsPlain(got), rowsPlain(want))
+		}
+		for x := range want[y] {
+			if !sameCell(got[y][x], want[y][x]) {
+				fail(ht, "%s: line %d cell %d is %s, model %s\nrendered %q\nrow got   %s\nrow model %s", what, y, x, got[y][x], want[y][x], out, rowsRow(got[y]), rowsRow(want[y]))
+			}
+		}
+	}
+}
+
+func rowWidth(r []mcell) int {
+	w := 0
+	for _, c := range r {
+		w += c.w
+	}
+	return w
+}
+
+// ---------------------------------------------------------------- generators
+
+var (
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "|", "+"}
+	wideGraphemes   = []string{"世", "界", "中", "😃", "Ａ"}
+	// Clusters of several runes; a style applied rune by rune tears them apart.
+	clusterGraphemes = []string{"ก้", "👨‍👩‍👧", "é"}
+)
+
+func genGrapheme(tc hegel.TestCase, wide, clusters bool) string {
+	switch {
+	case clusters && chance(tc, 10):
+		return pick(tc, clusterGraphemes)
+	case wide && chance(tc, 25):
+		return pick(tc, wideGraphemes)
+	}
+	return pick(tc, narrowGraphemes)
+}
+
+func gwidth(g string) int { return ansi.StringWidth(g) }
+
+func genColor(tc hegel.TestCase) color.Color {
+	switch n(tc, 0, 3) {
+	case 0:
+		return Color(pick(tc, []string{"1", "9", "#ff0000", "#00ff00"}))
+	case 1:
+		return Color(strconv.Itoa(n(tc, 16, 255)))
+	case 2:
+		return Color(fmt.Sprintf("#%02x%02x%02x", n(tc, 0, 255), n(tc, 0, 255), n(tc, 0, 255)))
+	default:
+		return ansi.BasicColor(n(tc, 0, 15))
+	}
+}
+
+// textLine is one generated input line as graphemes.
+type textLine []string
+
+func (l textLine) String() string { return strings.Join(l, "") }
+
+// genText draws 1–4 lines of 0–9 graphemes (spaces, tabs and wide cells included).
+func genText(tc hegel.TestCase, clusters, tabs bool) ([]textLine, string) {
+	var lines []textLine
+	var sb strings.Builder
+	k := n(tc, 1, 4)
+	for i := 0; i < k; i++ {
+		var l textLine
+		for j := n(tc, 0, 9); j > 0; j-- {
+			switch {
+			case chance(tc, 20):
+				l = append(l, " ")
+			case tabs && chance(tc, 5):
+				l = append(l, "\t")
+			default:
+				l = append(l, genGrapheme(tc, true, clusters))
+			}
+		}
+		lines = append(lines, l)
+		if i > 0 {
+			if chance(tc, 15) {
+				sb.WriteString("\r\n")
+			} else {
+				sb.WriteByte('\n')
+			}
+		}
+		sb.WriteString(l.String())
+	}
+	return lines, sb.String()
+}
+
+// spec is a generated style: the values we set, so the model knows them.
+type spec struct {
+	bold, italic, strike, reverse, blink, faint bool
+	underline                                   bool
+	ulStyle                                     ansi.Underline
+	fg, bg, ulColor                             color.Color
+	width, height                               int
+	hasWidth, hasHeight                         bool
+	alignH, alignV                              Position
+	hasAlignH, hasAlignV                        bool
+	padT, padR, padB, padL                      int
+	padChar                                     rune
+	colorWS                                     bool
+	hasColorWS                                  bool
+	marT, marR, marB, marL                      int
+	marBg                                       color.Color
+	marChar                                     rune
+	border                                      Border
+	borderName                                  string
+	hasBorder                                   bool
+	sidesSet                                    bool
+	bTop, bRight, bBottom, bLeft                bool
+	bFg                                         [4]color.Color // top, right, bottom, left
+	bBg                                         [4]color.Color
+	inline                                      bool
+	maxWidth, maxHeight                         int
+	tabWidth                                    int
+	hasTabWidth                                 bool
+	ulSpaces, strikeSpaces                      bool
+	hasUlSpaces, hasStrikeSpaces                bool
+	link, linkParams                            string
+	transform                                   bool
+	props                                       int
+}
+
+var borders = map[string]Border{
+	"normal": NormalBorder(), "rounded": RoundedBorder(), "block": BlockBorder(), "outerhalf": OuterHalfBlockBorder(),
+	"innerhalf": InnerHalfBlockBorder(), "thick": ThickBorder(), "double": DoubleBorder(), "hidden": HiddenBorder(),
+	"markdown": MarkdownBorder(), "ascii": ASCIIBorder(),
+}
+
+var borderNames = []string{"normal", "rounded", "block", "outerhalf", "innerhalf", "thick", "double", "hidden", "markdown", "ascii"}
+
+func genSpec(tc hegel.TestCase) (spec, Style) {
+	var sp spec
+	s := NewStyle()
+	set := func() bool { sp.props++; return true }
+	if chance(tc, 25) {
+		sp.bold = set()
+		s = s.Bold(true)
+	}
+	if chance(tc, 15) {
+		sp.italic = set()
+		s = s.Italic(true)
+	}
+	if chance(tc, 25) {
+		sp.underline = set()
+		if chance(tc, 50) {
+			s = s.Underline(true)
+			sp.ulStyle = ansi.UnderlineSingle
+		} else {
+			sp.ulStyle = ansi.Underline(n(tc, 1, 5))
+			s = s.UnderlineStyle(sp.ulStyle)
+		}
+	}
+	if chance(tc, 15) {
+		sp.ulColor = genColor(tc)
+		set()
+		s = s.UnderlineColor(sp.ulColor)
+	}
+	if chance(tc, 15) {
+		sp.strike = set()
+		s = s.Strikethrough(true)
+	}
+	if chance(tc, 15) {
+		sp.reverse = set()
+		s = s.Reverse(true)
+	}
+	if chance(tc, 8) {
+		sp.blink = set()
+		s = s.Blink(true)
+	}
+	if chance(tc, 10) {
+		sp.faint = set()
+		s = s.Faint(true)
+	}
+	if chance(tc, 40) {
+		sp.fg = genColor(tc)
+		set()
+		s = s.Foreground(sp.fg)
+	}
+	if chance(tc, 40) {
+		sp.bg = genColor(tc)
+		set()
+		s = s.Background(sp.bg)
+	}
+	if chance(tc, 45) {
+		sp.width = n(tc, 0, 14)
+		sp.hasWidth = set()
+		s = s.Width(sp.width)
+	}
+	if chance(tc, 30) {
+		sp.height = n(tc, 0, 6)
+		sp.hasHeight = set()
+		s = s.Height(sp.height)
+	}
+	if chance(tc, 40) {
+		sp.alignH = pick(tc, []Position{Left, Center, Right})
+		sp.hasAlignH = set()
+		s = s.AlignHorizontal(sp.alignH)
+	}
+	if chance(tc, 30) {
+		sp.alignV = pick(tc, []Position{Top, Center, Bottom})
+		sp.hasAlignV = set()
+		s = s.AlignVertical(sp.alignV)
+	}
+	if chance(tc, 45) {
+		sp.padT, sp.padR, sp.padB, sp.padL = n(tc, 0, 2), n(tc, 0, 2), n(tc, 0, 2), n(tc, 0, 2)
+		set()
+		s = s.Padding(sp.padT, sp.padR, sp.padB, sp.padL)
+	}
+	if chance(tc, 15) {
+		sp.padChar = pick(tc, []rune{'.', '~', '*'})
+		set()
+		s = s.PaddingChar(sp.padChar)
+	}
+	if chance(tc, 20) {
+		sp.colorWS = chance(tc, 50)
+		sp.hasColorWS = set()
+		s = s.ColorWhitespace(sp.colorWS)
+	}
+	if chance(tc, 35) {
+		sp.marT, sp.marR, sp.marB, sp.marL = n(tc, 0, 2), n(tc, 0, 2), n(tc, 0, 2), n(tc, 0, 2)
+		set()
+		s = s.Margin(sp.marT, sp.marR, sp.marB, sp.marL)
+	}
+	if chance(tc, 15) {
+		sp.marBg = genColor(tc)
+		set()
+		s = s.MarginBackground(sp.marBg)
+	}
+	if chance(tc, 10) {
+		sp.marChar = pick(tc, []rune{'.', '~'})
+		set()
+		s = s.MarginChar(sp.marChar)
+	}
+	if chance(tc, 45) {
+		sp.borderName = pick(tc, borderNames)
+		sp.border = borders[sp.borderName]
+		sp.hasBorder = set()
+		if chance(tc, 50) {
+			s = s.BorderStyle(sp.border)
+			sp.bTop, sp.bRight, sp.bBottom, sp.bLeft = true, true, true, true
+		} else {
+			sp.sidesSet = true
+			sp.bTop, sp.bRight, sp.bBottom, sp.bLeft = chance(tc, 70), chance(tc, 70), chance(tc, 70), chance(tc, 70)
+			s = s.Border(sp.border, sp.bTop, sp.bRight, sp.bBottom, sp.bLeft)
+		}
+		if chance(tc, 40) {
+			for i := range sp.bFg {
+				if chance(tc, 60) {
+					sp.bFg[i] = genColor(tc)
+				}
+			}
+			s = s.BorderTopForeground(sp.bFg[0]).BorderRightForeground(sp.bFg[1]).BorderBottomForeground(sp.bFg[2]).BorderLeftForeground(sp.bFg[3])
+		}
+		if chance(tc, 30) {
+			for i := range sp.bBg {
+				if chance(tc, 60) {
+					sp.bBg[i] = genColor(tc)
+				}
+			}
+			s = s.BorderTopBackground(sp.bBg[0]).BorderRightBackground(sp.bBg[1]).BorderBottomBackground(sp.bBg[2]).BorderLeftBackground(sp.bBg[3])
+		}
+	}
+	if chance(tc, 10) {
+		sp.inline = set()
+		s = s.Inline(true)
+	}
+	if chance(tc, 15) {
+		sp.maxWidth = n(tc, 1, 12)
+		set()
+		s = s.MaxWidth(sp.maxWidth)
+	}
+	if chance(tc, 15) {
+		sp.maxHeight = n(tc, 1, 5)
+		set()
+		s = s.MaxHeight(sp.maxHeight)
+	}
+	if chance(tc, 15) {
+		sp.tabWidth = pick(tc, []int{0, 2, 8})
+		sp.hasTabWidth = set()
+		s = s.TabWidth(sp.tabWidth)
+	}
+	if chance(tc, 15) {
+		sp.ulSpaces = chance(tc, 50)
+		sp.hasUlSpaces = set()
+		s = s.UnderlineSpaces(sp.ulSpaces)
+	}
+	if chance(tc, 10) {
+		sp.strikeSpaces = chance(tc, 50)
+		sp.hasStrikeSpaces = set()
+		s = s.StrikethroughSpaces(sp.strikeSpaces)
+	}
+	if chance(tc, 15) {
+		sp.link = fmt.Sprintf("https://example.com/%d", n(tc, 0, 9))
+		set()
+		if chance(tc, 40) {
+			sp.linkParams = fmt.Sprintf("id=%d", n(tc, 0, 9))
+			s = s.Hyperlink(sp.link, sp.linkParams)
+		} else {
+			s = s.Hyperlink(sp.link)
+		}
+	}
+	if chance(tc, 10) {
+		sp.transform = set()
+		s = s.Transform(strings.ToUpper)
+	}
+	return sp, s
+}
+
+func nilIfNo(c color.Color) color.Color {
+	if c == nil || c == noColor {
+		return nil
+	}
+	return c
+}
+
+// ---------------------------------------------------------------- the Render model
+
+// modelRender builds the cells Style.Render should produce for the given lines. It returns a
+// non-empty skip reason when the model does not cover the case.
+func modelRender(sp spec, lines []textLine) (rows [][]mcell, tag string) {
+	var skipTag string
+	defer func() { tag = skipTag }()
+	// Tabs and transform.
+	tw := 4
+	if sp.hasTabWidth {
+		tw = sp.tabWidth
+	}
+	var work [][]string
+	for _, l := range lines {
+		var gs []string
+		for _, g := range l {
+			switch {
+			case g == "\t":
+				for i := 0; i < tw; i++ {
+					gs = append(gs, " ")
+				}
+			case sp.transform:
+				gs = append(gs, strings.ToUpper(g))
+			default:
+				gs = append(gs, g)
+			}
+		}
+		work = append(work, gs)
+	}
+	if sp.inline {
+		var one []string
+		for _, gs := range work {
+			one = append(one, gs...)
+		}
+		work = [][]string{one}
+	}
+
+	// Pens.
+	var te, teSpace, teWS mstyle
+	if sp.bold {
+		te.attrs |= aBold
+	}
+	if sp.italic {
+		te.attrs |= aItalic
+	}
+	if sp.underline {
+		te.under = sp.ulStyle
+	}
+	if sp.reverse {
+		te.attrs |= aReverse
+		teWS.attrs |= aReverse
+	}
+	if sp.blink {
+		te.attrs |= aBlink
+	}
+	if sp.faint {
+		te.attrs |= aFaint
+	}
+	if sp.strike {
+		te.attrs |= aStrike
+	}
+	colorWS := !sp.hasColorWS || sp.colorWS
+	te.fg, te.bg, te.ul = nilIfNo(sp.fg), nilIfNo(sp.bg), nilIfNo(sp.ulColor)
+	if sp.reverse {
+		teWS.fg = te.fg
+	}
+	if colorWS {
+		teWS.bg = te.bg
+		teWS.ul = te.ul
+	}
+	// Spaces inside the text: the text's pen, with underline and strikethrough governed by
+	// the *Spaces settings (default: follow the text).
+	// Spaces can be underlined or struck without the text being so (documented), and then
+	// get a single underline.
+	teSpace = te
+	ulSpaces := sp.underline
+	if sp.hasUlSpaces {
+		ulSpaces = sp.ulSpaces
+	}
+	switch {
+	case !ulSpaces:
+		teSpace.under = ansi.UnderlineNone
+	case !sp.underline:
+		teSpace.under = ansi.UnderlineSingle
+	}
+	strikeSpaces := sp.strike
+	if sp.hasStrikeSpaces {
+		strikeSpaces = sp.strikeSpaces
+	}
+	if strikeSpaces {
+		teSpace.attrs |= aStrike
+	} else {
+		teSpace.attrs &^= aStrike
+	}
+	styleWS := colorWS || sp.reverse
+	var wsPen mstyle
+	if styleWS {
+		wsPen = teWS
+	}
+
+	// Sizes.
+	bTop, bRight, bBottom, bLeft := sp.borderSides()
+	var hb, vb int
+	if sp.hasBorder {
+		if bLeft {
+			hb += maxRuneWidth(sp.border.Left)
+		}
+		if bRight {
+			hb += maxRuneWidth(sp.border.Right)
+		}
+		if bTop {
+			vb += maxRuneWidth(sp.border.Top)
+		}
+		if bBottom {
+			vb += maxRuneWidth(sp.border.Bottom)
+		}
+	}
+	width := sp.width - hb
+	height := sp.height - vb
+	if !sp.inline && width > 0 {
+		// Wrapping is x/ansi's (ansi.Wrap, checked in the x-ansi target); the model takes
+		// its lines and lays them out. A limit below one leaves the text alone.
+		wrapAt := width - sp.padL - sp.padR
+		needs := false
+		for _, gs := range work {
+			w := 0
+			for _, g := range gs {
+				w += gwidth(g)
+			}
+			if w > wrapAt {
+				needs = true
+			}
+		}
+		if wrapAt < 1 {
+			skipTag = "wrap-limit-below-one"
+		} else if needs {
+			skipTag = "wrapped"
+			var plain []string
+			for _, gs := range work {
+				plain = append(plain, strings.Join(gs, ""))
+			}
+			work = nil
+			for _, line := range strings.Split(ansi.Wrap(strings.Join(plain, "\n"), wrapAt, ""), "\n") {
+				work = append(work, graphemes(line))
+			}
+		}
+	}
+
+	// Core text.
+	for _, gs := range work {
+		var row []mcell
+		for _, g := range gs {
+			st := te
+			if isSpace(g) {
+				st = teSpace
+			}
+			row = append(row, mcell{g: g, w: gwidth(g), st: st, link: sp.link, lp: sp.linkParams})
+		}
+		rows = append(rows, row)
+	}
+
+	// Padding.
+	if !sp.inline {
+		padChar := " "
+		if sp.padChar != 0 {
+			padChar = string(sp.padChar)
+		}
+		padCell := mcell{g: padChar, w: gwidth(padChar), st: wsPen}
+		for y := range rows {
+			rows[y] = append(repeatCell(padCell, sp.padL), rows[y]...)
+			rows[y] = append(rows[y], repeatCell(padCell, sp.padR)...)
+		}
+		for i := 0; i < sp.padT; i++ {
+			rows = append([][]mcell{{}}, rows...)
+		}
+		for i := 0; i < sp.padB; i++ {
+			rows = append(rows, []mcell{})
+		}
+	}
+
+	// Height.
+	if height > 0 && height >= len(rows) {
+		gap := height - len(rows)
+		switch sp.alignV {
+		case Bottom:
+			rows = append(make([][]mcell, gap), rows...)
+		case Center:
+			top := gap / 2
+			rows = append(make([][]mcell, top), rows...)
+			rows = append(rows, make([][]mcell, gap-top)...)
+		default:
+			rows = append(rows, make([][]mcell, gap)...)
+		}
+	}
+
+	// Horizontal alignment: every line padded to the block width.
+	if len(rows) > 1 || width != 0 {
+		widest := 0
+		for _, r := range rows {
+			widest = max(widest, rowWidth(r))
+		}
+		target := max(widest, width)
+		sp1 := mcell{g: " ", w: 1, st: wsPen}
+		for y, r := range rows {
+			short := target - rowWidth(r)
+			if short <= 0 {
+				continue
+			}
+			switch sp.alignH {
+			case Right:
+				rows[y] = append(repeatCell(sp1, short), r...)
+			case Center:
+				l := short / 2
+				rows[y] = append(append(repeatCell(sp1, l), r...), repeatCell(sp1, short-l)...)
+			default:
+				rows[y] = append(r, repeatCell(sp1, short)...)
+			}
+		}
+	}
+
+	if !sp.inline {
+		// Border.
+		if sp.hasBorder && (bTop || bRight || bBottom || bLeft) {
+			b := sp.border
+			widest := 0
+			for _, r := range rows {
+				widest = max(widest, rowWidth(r))
+			}
+			fullWidth := widest
+			if bLeft {
+				if b.Left == "" {
+					b.Left = " "
+				}
+				fullWidth += maxRuneWidth(b.Left)
+			}
+			if bRight {
+				if b.Right == "" {
+					b.Right = " "
+				}
+				fullWidth += maxRuneWidth(b.Right)
+			}
+			corner := func(c string, show bool) string {
+				if !show {
+					return ""
+				}
+				if c == "" {
+					return " "
+				}
+				return string([]rune(c)[:1])
+			}
+			tl, tr := corner(b.TopLeft, bTop && bLeft), corner(b.TopRight, bTop && bRight)
+			bl, br := corner(b.BottomLeft, bBottom && bLeft), corner(b.BottomRight, bBottom && bRight)
+			pen := func(side int) mstyle {
+				return mstyle{fg: nilIfNo(sp.bFg[side]), bg: nilIfNo(sp.bBg[side])}
+			}
+			edge := func(l, mid, r string, side int) []mcell {
+				if mid == "" {
+					mid = " "
+				}
+				var row []mcell
+				for _, g := range graphemes(l) {
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+				}
+				mids := []rune(mid)
+				j := 0
+				for w := 0; w < fullWidth-gwidth(l)-gwidth(r); {
+					g := string(mids[j])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+					w += gwidth(g)
+					j = (j + 1) % len(mids)
+				}
+				for _, g := range graphemes(r) {
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(side)})
+				}
+				return row
+			}
+			var out [][]mcell
+			if bTop {
+				out = append(out, edge(tl, b.Top, tr, 0))
+			}
+			leftRunes, rightRunes := []rune(b.Left), []rune(b.Right)
+			for i, r := range rows {
+				var row []mcell
+				if bLeft {
+					g := string(leftRunes[i%len(leftRunes)])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(3)})
+				}
+				row = append(row, r...)
+				if bRight {
+					g := string(rightRunes[i%len(rightRunes)])
+					row = append(row, mcell{g: g, w: gwidth(g), st: pen(1)})
+				}
+				out = append(out, row)
+			}
+			if bBottom {
+				out = append(out, edge(bl, b.Bottom, br, 2))
+			}
+			rows = out
+		}
+		// Margins.
+		marChar := " "
+		if sp.marChar != 0 {
+			marChar = string(sp.marChar)
+		}
+		marPen := mstyle{bg: nilIfNo(sp.marBg)}
+		marCell := mcell{g: marChar, w: gwidth(marChar), st: marPen}
+		for y := range rows {
+			rows[y] = append(repeatCell(marCell, sp.marL), rows[y]...)
+			rows[y] = append(rows[y], repeatCell(marCell, sp.marR)...)
+		}
+		widest := 0
+		for _, r := range rows {
+			widest = max(widest, rowWidth(r))
+		}
+		blank := repeatCell(mcell{g: " ", w: 1, st: marPen}, widest)
+		for i := 0; i < sp.marT; i++ {
+			rows = append([][]mcell{append([]mcell(nil), blank...)}, rows...)
+		}
+		for i := 0; i < sp.marB; i++ {
+			rows = append(rows, append([]mcell(nil), blank...))
+		}
+	}
+
+	// MaxWidth: cells are dropped from the right, a wide cell that straddles the limit too.
+	if sp.maxWidth > 0 {
+		for y, r := range rows {
+			var kept []mcell
+			w := 0
+			for _, c := range r {
+				if w+c.w > sp.maxWidth {
+					break
+				}
+				kept = append(kept, c)
+				w += c.w
+			}
+			rows[y] = kept
+		}
+	}
+	if sp.maxHeight > 0 && len(rows) > sp.maxHeight {
+		rows = rows[:sp.maxHeight]
+	}
+	for y := range rows {
+		if rows[y] == nil {
+			rows[y] = []mcell{}
+		}
+	}
+	return rows, ""
+}
+
+func (sp spec) borderSides() (top, right, bottom, left bool) {
+	if !sp.hasBorder {
+		return false, false, false, false
+	}
+	return sp.bTop, sp.bRight, sp.bBottom, sp.bLeft
+}
+
+func isSpace(g string) bool {
+	rs := []rune(g)
+	return len(rs) == 1 && unicode.IsSpace(rs[0])
+}
+
+func repeatCell(c mcell, k int) []mcell {
+	out := make([]mcell, 0, max(k, 0))
+	for i := 0; i < k; i++ {
+		out = append(out, c)
+	}
+	return out
+}
+
+// graphemes splits a plain string into grapheme clusters.
+func graphemes(s string) []string {
+	var out []string
+	var state byte
+	for len(s) > 0 {
+		g, _, k, ns := ansi.DecodeSequence(s, state, nil)
+		out = append(out, g)
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+func hasCluster(lines []textLine) bool {
+	for _, l := range lines {
+		for _, g := range l {
+			if len([]rune(g)) > 1 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// spaceStyler reports whether Render styles the text rune by rune (spaces separately).
+func (sp spec) spaceStyler() bool {
+	ulSpaces := sp.underline
+	if sp.hasUlSpaces {
+		ulSpaces = sp.ulSpaces
+	}
+	strikeSpaces := sp.strike
+	if sp.hasStrikeSpaces {
+		strikeSpaces = sp.strikeSpaces
+	}
+	return (sp.underline && !ulSpaces) || (sp.strike && !strikeSpaces) || ulSpaces || strikeSpaces
+}
+
+// tolerate edits the rendered rows towards the model where a pinned bug is known to differ,
+// counting each tolerance used: lipgloss/2 (reverse dropped from spaces by the space styler),
+// lipgloss/3 (spaces get a single underline whatever the text's underline style) and
+// lipgloss/4 (the hyperlink covers the padding, alignment, border and margin cells between
+// the first line's text and the last line's).
+func tolerate(sp spec, got, want [][]mcell) {
+	// The link spans from the first line's text to the last line's, so padding, alignment,
+	// border and margin cells in between carry it.
+	multiLink := sp.link != ""
+	for y := range want {
+		if y >= len(got) {
+			return
+		}
+		for x := range want[y] {
+			if x >= len(got[y]) {
+				break
+			}
+			g, w := &got[y][x], want[y][x]
+			if multiLink && g.link != "" && w.link == "" {
+				g.link, g.lp = "", ""
+				count("tolerated-link-on-whitespace")
+			}
+			if !isSpaceCell(g.g) || !sp.spaceStyler() {
+				continue
+			}
+			if w.st.attrs&aReverse != 0 && g.st.attrs&aReverse == 0 {
+				g.st.attrs |= aReverse
+				count("tolerated-reverse-dropped-on-space")
+			}
+			if w.st.under != ansi.UnderlineNone && g.st.under == ansi.UnderlineSingle && w.st.under != g.st.under {
+				g.st.under = w.st.under
+				count("tolerated-single-underline-on-space")
+			}
+		}
+	}
+}
+
+func TestHegelRenderFollowsTheBlockModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp, s := genSpec(ht)
+		lines, text := genText(ht, true, !sp.hasTabWidth || sp.tabWidth >= 0)
+		note(ht, "style %+v", sp)
+		note(ht, "text %q", text)
+		out := s.Render(text)
+		note(ht, "rendered %q", out)
+		if sp.props == 0 {
+			want := strings.ReplaceAll(text, "\t", "    ")
+			if out != want {
+				fail(ht, "Render with no properties = %q, want the text with tabs expanded %q", out, want)
+			}
+			count("no-props")
+			return
+		}
+		want, tag := modelRender(sp, lines)
+		if tag != "" {
+			count(tag)
+		}
+		if sp.spaceStyler() && hasCluster(lines) {
+			// lipgloss/1: the space styler tears grapheme clusters apart.
+			count("cluster-torn")
+			return
+		}
+		got := parseCells(out)
+		tolerate(sp, got, want)
+		compareRows(ht, "Render", got, want, out)
+		// The size helpers agree with the cells.
+		if w, h := Size(out); w != Width(out) || h != len(want) || h != Height(out) {
+			fail(ht, "Size(%q) = %d×%d, Height %d, model %d lines", out, w, h, Height(out), len(want))
+		}
+		widest := 0
+		for _, r := range want {
+			widest = max(widest, rowWidth(r))
+		}
+		if got := Width(out); got != widest {
+			fail(ht, "Width(%q) = %d, model %d", out, got, widest)
+		}
+		// GetFrameSize is what the frame adds around the content when nothing is clipped.
+		if sp.maxWidth == 0 && sp.maxHeight == 0 && !sp.inline {
+			hf, vf := s.GetFrameSize()
+			if hf != sp.padL+sp.padR+sp.marL+sp.marR+s.GetHorizontalBorderSize() || vf != sp.padT+sp.padB+sp.marT+sp.marB+s.GetVerticalBorderSize() {
+				fail(ht, "GetFrameSize() = %d,%d for %+v", hf, vf, sp)
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- Join and Place
+
+func genBlock(tc hegel.TestCase) string {
+	var lines []string
+	for k := n(tc, 1, 4); k > 0; k-- {
+		var sb strings.Builder
+		for j := n(tc, 0, 6); j > 0; j-- {
+			if chance(tc, 20) {
+				sb.WriteByte(' ')
+			} else {
+				sb.WriteString(genGrapheme(tc, true, false))
+			}
+		}
+		lines = append(lines, sb.String())
+	}
+	return strings.Join(lines, "\n")
+}
+
+var positions = []Position{Top, Center, Bottom, 0.25, 0.7, 0.1}
+
+func padTo(line string, w int) string {
+	return line + strings.Repeat(" ", max(0, w-ansi.StringWidth(line)))
+}
+
+func TestHegelJoinsFollowTheirModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var blocks []string
+		for k := n(ht, 0, 4); k > 0; k-- {
+			blocks = append(blocks, genBlock(ht))
+		}
+		pos := pick(ht, positions)
+		note(ht, "pos %v blocks %q", pos, blocks)
+		// JoinHorizontal: each block padded to its own width, made the same height with
+		// round(gap*pos) blank lines above; lines concatenated.
+		gotH := JoinHorizontal(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotH != want {
+				fail(ht, "JoinHorizontal(%v, %q) = %q", pos, blocks, gotH)
+			}
+		} else {
+			maxH := 0
+			var split [][]string
+			var widths []int
+			for _, b := range blocks {
+				ls := strings.Split(b, "\n")
+				split = append(split, ls)
+				widths = append(widths, Width(b))
+				maxH = max(maxH, len(ls))
+			}
+			for i := range split {
+				gap := maxH - len(split[i])
+				above := int(math.Round(float64(gap) * pos.value()))
+				padded := make([]string, above)
+				padded = append(padded, split[i]...)
+				for len(padded) < maxH {
+					padded = append(padded, "")
+				}
+				split[i] = padded
+			}
+			var want []string
+			for y := 0; y < maxH; y++ {
+				var sb strings.Builder
+				for i := range split {
+					sb.WriteString(padTo(split[i][y], widths[i]))
+				}
+				want = append(want, sb.String())
+			}
+			if w := strings.Join(want, "\n"); gotH != w {
+				fail(ht, "JoinHorizontal(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotH, w)
+			}
+		}
+		// JoinVertical: every line padded to the widest block, round(gap*pos) spaces on the
+		// left.
+		gotV := JoinVertical(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotV != want {
+				fail(ht, "JoinVertical(%v, %q) = %q", pos, blocks, gotV)
+			}
+		} else {
+			maxW := 0
+			for _, b := range blocks {
+				maxW = max(maxW, Width(b))
+			}
+			var want []string
+			for _, b := range blocks {
+				for _, l := range strings.Split(b, "\n") {
+					gap := maxW - ansi.StringWidth(l)
+					left := int(math.Round(float64(gap) * pos.value()))
+					want = append(want, strings.Repeat(" ", left)+l+strings.Repeat(" ", gap-left))
+				}
+			}
+			if w := strings.Join(want, "\n"); gotV != w {
+				fail(ht, "JoinVertical(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotV, w)
+			}
+		}
+		count("ok")
+	})
+}
+
+// wsFill is the whitespace renderer's model: the chars cycled until the width is filled, a
+// wide char that overshoots is written (the width then runs over) — the code's own rule; the
+// model uses narrow chars only.
+func wsFill(chars string, width int) string {
+	if chars == "" {
+		chars = " "
+	}
+	rs := []rune(chars)
+	var sb strings.Builder
+	for i, j := 0, 0; i < width; j = (j + 1) % len(rs) {
+		sb.WriteRune(rs[j])
+		i += max(1, ansi.StringWidth(string(rs[j])))
+	}
+	return sb.String()
+}
+
+func TestHegelPlaceFollowsItsModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		block := genBlock(ht)
+		lines := strings.Split(block, "\n")
+		cw, chh := Width(block), len(lines)
+		width, height := n(ht, 0, 14), n(ht, 0, 6)
+		hPos, vPos := pick(ht, positions), pick(ht, positions)
+		chars := pick(ht, []string{"", " ", ".", "ab", "-="})
+		var opts []WhitespaceOption
+		if chars != "" {
+			opts = append(opts, WithWhitespaceChars(chars))
+		}
+		note(ht, "Place(%d,%d,%v,%v,%q, chars %q)", width, height, hPos, vPos, block, chars)
+		// Horizontal: gap = width - content width; per line the text sits after
+		// round(total*pos) columns of whitespace (0 = left, 1 = right).
+		wantH := block
+		if gap := width - cw; gap > 0 {
+			var out []string
+			for _, l := range lines {
+				total := gap + cw - ansi.StringWidth(l)
+				left := int(math.Round(float64(total) * hPos.value()))
+				if hPos == Center {
+					left = total / 2
+				}
+				out = append(out, wsFill(chars, left)+l+wsFill(chars, total-left))
+			}
+			wantH = strings.Join(out, "\n")
+		}
+		gotH := PlaceHorizontal(width, hPos, block, opts...)
+		if gotH != wantH {
+			if hPos != Left && hPos != Right && hPos != Center {
+				count("fractional-position-mirrored")
+				return
+			}
+			fail(ht, "PlaceHorizontal(%d, %v, %q) =\n%q\nmodel\n%q", width, hPos, block, gotH, wantH)
+		}
+		// Vertical: round(gap*pos) blank lines above, the rest below; blank lines are
+		// whitespace of the block's width.
+		wantV := gotH
+		if gap := height - chh; gap > 0 {
+			above := int(math.Round(float64(gap) * vPos.value()))
+			if vPos == Center {
+				above = gap / 2
+			}
+			empty := wsFill(chars, Width(gotH))
+			var out []string
+			for i := 0; i < above; i++ {
+				out = append(out, empty)
+			}
+			out = append(out, strings.Split(gotH, "\n")...)
+			for i := 0; i < gap-above; i++ {
+				out = append(out, empty)
+			}
+			wantV = strings.Join(out, "\n")
+		}
+		gotV := PlaceVertical(height, vPos, gotH, opts...)
+		if gotV != wantV {
+			if vPos != Top && vPos != Bottom && vPos != Center {
+				count("fractional-position-mirrored")
+				return
+			}
+			fail(ht, "PlaceVertical(%d, %v, %q) =\n%q\nmodel\n%q", height, vPos, gotH, gotV, wantV)
+		}
+		if got := Place(width, height, hPos, vPos, block, opts...); got != gotV {
+			fail(ht, "Place = %q, PlaceVertical(PlaceHorizontal) = %q", got, gotV)
+		}
+		count("ok")
+	})
+}
