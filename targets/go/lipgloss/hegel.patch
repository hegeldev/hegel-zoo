+func TestHegelWrapKeepsContentAndStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		in := genStyledText(ht)
+		limit := n(ht, 1, 16)
+		note(ht, "Wrap(%q, %d)", in, limit)
+		out := Wrap(in, limit, "")
+		// lipgloss only re-applies styles around ansi.Wrap's newlines: the visible text is
+		// ansi.Wrap's. Lines wider than the limit are x/ansi's own (x-ansi/8, /12, /19, /21 in
+		// this zoo) and are counted, not failed, when ansi.Wrap produced them.
+		raw := ansi.Wrap(in, limit, "")
+		if ansi.Strip(out) != ansi.Strip(raw) {
+			fail(ht, "Wrap changes the visible text of ansi.Wrap: %q vs %q (input %q)", ansi.Strip(out), ansi.Strip(raw), in)
+		}
+		rawLines := strings.Split(raw, "\n")
+		for i, line := range strings.Split(out, "\n") {
+			if w := ansi.StringWidth(line); w > limit {
+				if i < len(rawLines) && ansi.StringWidth(rawLines[i]) > limit {
+					count("x-ansi-wrap-overflow")
+					continue
+				}
+				fail(ht, "line %d %q has width %d > %d in %q", i, line, w, limit, out)
+			}
+		}
+		gi, si, li, pi := styledGraphemes(in)
+		go_, so, lo, po := styledGraphemes(out)
+		if pi != po {
+			fail(ht, "content changed: %q -> %q (plain %q vs %q)", in, out, pi, po)
+		}
+		for i := range gi {
+			if !sameCell(mcell{g: gi[i], w: 1, st: si[i], link: li[i]}, mcell{g: go_[i], w: 1, st: so[i], link: lo[i]}) {
+				fail(ht, "grapheme %d %q: %s link %q in, %s link %q out\nin  %q\nout %q", i, gi[i], si[i], li[i], so[i], lo[i], in, out)
+			}
+		}
+		if strings.Count(out, "\n") < strings.Count(in, "\n") {
+			fail(ht, "newlines lost: %q -> %q", in, out)
+		}
+		// Every newline is preceded by a reset when a style or link is open, so a line never
+		// carries the previous line's pen into a consumer that handles lines separately.
+		outLines := strings.Split(out, "\n")
+		for i, line := range outLines[:len(outLines)-1] {
+			// The pen after the line is what a probe cell appended to it receives.
+			end := parseCells(line + "x")
+			last := end[0][len(end[0])-1]
+			if last.st != (mstyle{}) || last.link != "" {
+				fail(ht, "line %d %q ends with an open pen %s link %q in %q", i, line, last.st, last.link, out)
+			}
+		}
+		count("ok")
+	})
+}
