+// ---------------------------------------------------------------- Join and Place
+
+func genBlock(tc hegel.TestCase) string {
+	var lines []string
+	for k := n(tc, 1, 4); k > 0; k-- {
+		var sb strings.Builder
+		for j := n(tc, 0, 6); j > 0; j-- {
+			if chance(tc, 20) {
+				sb.WriteByte(' ')
+			} else {
+				sb.WriteString(genGrapheme(tc, true, false))
+			}
+		}
+		lines = append(lines, sb.String())
+	}
+	return strings.Join(lines, "\n")
+}
+
+var positions = []Position{Top, Center, Bottom, 0.25, 0.7, 0.1}
+
+func padTo(line string, w int) string {
+	return line + strings.Repeat(" ", max(0, w-ansi.StringWidth(line)))
+}
+
+func TestHegelJoinsFollowTheirModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var blocks []string
+		for k := n(ht, 0, 4); k > 0; k-- {
+			blocks = append(blocks, genBlock(ht))
+		}
+		pos := pick(ht, positions)
+		note(ht, "pos %v blocks %q", pos, blocks)
+		// JoinHorizontal: each block padded to its own width, made the same height with
+		// round(gap*pos) blank lines above; lines concatenated.
+		gotH := JoinHorizontal(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotH != want {
+				fail(ht, "JoinHorizontal(%v, %q) = %q", pos, blocks, gotH)
+			}
+		} else {
+			maxH := 0
+			var split [][]string
+			var widths []int
+			for _, b := range blocks {
+				ls := strings.Split(b, "\n")
+				split = append(split, ls)
+				widths = append(widths, Width(b))
+				maxH = max(maxH, len(ls))
+			}
+			for i := range split {
+				gap := maxH - len(split[i])
+				above := int(math.Round(float64(gap) * pos.value()))
+				padded := make([]string, above)
+				padded = append(padded, split[i]...)
+				for len(padded) < maxH {
+					padded = append(padded, "")
+				}
+				split[i] = padded
+			}
+			var want []string
+			for y := 0; y < maxH; y++ {
+				var sb strings.Builder
+				for i := range split {
+					sb.WriteString(padTo(split[i][y], widths[i]))
+				}
+				want = append(want, sb.String())
+			}
+			if w := strings.Join(want, "\n"); gotH != w {
+				fail(ht, "JoinHorizontal(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotH, w)
+			}
+		}
+		// JoinVertical: every line padded to the widest block, round(gap*pos) spaces on the
+		// left.
+		gotV := JoinVertical(pos, blocks...)
+		if len(blocks) <= 1 {
+			want := ""
+			if len(blocks) == 1 {
+				want = blocks[0]
+			}
+			if gotV != want {
+				fail(ht, "JoinVertical(%v, %q) = %q", pos, blocks, gotV)
+			}
+		} else {
+			maxW := 0
+			for _, b := range blocks {
+				maxW = max(maxW, Width(b))
+			}
+			var want []string
+			for _, b := range blocks {
+				for _, l := range strings.Split(b, "\n") {
+					gap := maxW - ansi.StringWidth(l)
+					left := int(math.Round(float64(gap) * pos.value()))
+					want = append(want, strings.Repeat(" ", left)+l+strings.Repeat(" ", gap-left))
+				}
+			}
+			if w := strings.Join(want, "\n"); gotV != w {
+				fail(ht, "JoinVertical(%v, %q) =\n%q\nmodel\n%q", pos, blocks, gotV, w)
+			}
+		}
+		count("ok")
+	})
+}
+
+// wsFill is the whitespace renderer's model: the chars cycled until the width is filled, a
+// wide char that overshoots is written (the width then runs over) — the code's own rule; the
+// model uses narrow chars only.
+func wsFill(chars string, width int) string {
+	if chars == "" {
+		chars = " "
+	}
+	rs := []rune(chars)
+	var sb strings.Builder
+	for i, j := 0, 0; i < width; j = (j + 1) % len(rs) {
+		sb.WriteRune(rs[j])
+		i += max(1, ansi.StringWidth(string(rs[j])))
+	}
+	return sb.String()
+}
+
+func TestHegelPlaceFollowsItsModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		block := genBlock(ht)
+		lines := strings.Split(block, "\n")
+		cw, chh := Width(block), len(lines)
+		width, height := n(ht, 0, 14), n(ht, 0, 6)
+		hPos, vPos := pick(ht, positions), pick(ht, positions)
+		chars := pick(ht, []string{"", " ", ".", "ab", "-="})
+		var opts []WhitespaceOption
+		if chars != "" {
+			opts = append(opts, WithWhitespaceChars(chars))
+		}
+		note(ht, "Place(%d,%d,%v,%v,%q, chars %q)", width, height, hPos, vPos, block, chars)
+		// Horizontal: gap = width - content width; per line the text sits after
+		// round(total*pos) columns of whitespace (0 = left, 1 = right).
+		wantH := block
+		if gap := width - cw; gap > 0 {
+			var out []string
+			for _, l := range lines {
+				total := gap + cw - ansi.StringWidth(l)
+				left := int(math.Round(float64(total) * hPos.value()))
+				if hPos == Center {
+					left = total / 2
+				}
+				out = append(out, wsFill(chars, left)+l+wsFill(chars, total-left))
+			}
+			wantH = strings.Join(out, "\n")
+		}
+		gotH := PlaceHorizontal(width, hPos, block, opts...)
+		if gotH != wantH {
+			if hPos != Left && hPos != Right && hPos != Center {
+				count("fractional-position-mirrored")
+				return
+			}
+			fail(ht, "PlaceHorizontal(%d, %v, %q) =\n%q\nmodel\n%q", width, hPos, block, gotH, wantH)
+		}
+		// Vertical: round(gap*pos) blank lines above, the rest below; blank lines are
+		// whitespace of the block's width.
+		wantV := gotH
+		if gap := height - chh; gap > 0 {
+			above := int(math.Round(float64(gap) * vPos.value()))
+			if vPos == Center {
+				above = gap / 2
+			}
+			empty := wsFill(chars, Width(gotH))
+			var out []string
+			for i := 0; i < above; i++ {
+				out = append(out, empty)
+			}
+			out = append(out, strings.Split(gotH, "\n")...)
+			for i := 0; i < gap-above; i++ {
+				out = append(out, empty)
+			}
+			wantV = strings.Join(out, "\n")
+		}
+		gotV := PlaceVertical(height, vPos, gotH, opts...)
+		if gotV != wantV {
+			if vPos != Top && vPos != Bottom && vPos != Center {
+				count("fractional-position-mirrored")
+				return
+			}
+			fail(ht, "PlaceVertical(%d, %v, %q) =\n%q\nmodel\n%q", height, vPos, gotH, gotV, wantV)
+		}
+		if got := Place(width, height, hPos, vPos, block, opts...); got != gotV {
+			fail(ht, "Place = %q, PlaceVertical(PlaceHorizontal) = %q", got, gotV)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- Wrap
+
+// styledGraphemes walks a styled string and returns its non-space graphemes with the pen and
+// link in force at each, plus the plain text without whitespace.
+func styledGraphemes(s string) (gs []string, sts []mstyle, links []string, plain string) {
+	for _, row := range parseCells(s) {
+		for _, c := range row {
+			if isSpaceCell(c.g) || c.g == "\t" || c.g == "\r" {
+				continue
+			}
+			gs = append(gs, c.g)
+			sts = append(sts, c.st)
+			links = append(links, c.link)
+			plain += c.g
+		}
+	}
+	return
+}
+
+func genStyledText(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for k := n(tc, 0, 12); k > 0; k-- {
+		switch n(tc, 0, 9) {
+		case 0:
+			_, s := genSpec(tc)
+			// Only inline styling matters here; strip the layout properties.
+			s = NewStyle().Bold(s.GetBold()).Italic(s.GetItalic()).Foreground(s.GetForeground()).Background(s.GetBackground()).Reverse(s.GetReverse())
+			sb.WriteString(s.Render("x"))
+		case 1:
+			sb.WriteString("\x1b[m")
+		case 2:
+			sb.WriteString(ansi.SetHyperlink(fmt.Sprintf("https://example.com/%d", n(tc, 0, 9)), ""))
+		case 3:
+			sb.WriteString(pick(tc, []string{" ", "  ", "\n", "-", " - "}))
+		default:
+			for j := n(tc, 1, 6); j > 0; j-- {
+				sb.WriteString(genGrapheme(tc, true, false))
+			}
+			if chance(tc, 60) {
+				sb.WriteString(" ")
+			}
+		}
+	}
+	return sb.String()
+}
