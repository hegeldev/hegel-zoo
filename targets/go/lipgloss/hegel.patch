+package lipgloss
+
+// Blend1D/Blend2D, the border foreground blend, StyleRunes and SetString/Value against their
+// documentation. The stops, rings, rune strings and styles are drawn as records; the shapes
+// of lipgloss/23-29 are steady alternatives or regions of them, named on a mismatch.
+
+import (
+	"fmt"
+	"image/color"
+	"math"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- colours
+
+func rgb8(c color.Color) (int, int, int) {
+	r, g, b, _ := c.RGBA()
+	return int(r >> 8), int(g >> 8), int(b >> 8)
+}
+
+// closeColor: equal to within one 8-bit step per channel (the blend works in float, the
+// terminal in bytes).
+func closeColor(c, o color.Color) bool {
+	if c == nil || o == nil {
+		return c == nil && o == nil
+	}
+	r1, g1, b1 := rgb8(c)
+	r2, g2, b2 := rgb8(o)
+	return absInt(r1-r2) <= 1 && absInt(g1-g2) <= 1 && absInt(b1-b2) <= 1
+}
+
+func absInt(x int) int {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
+
+func hexOf(c color.Color) string {
+	if c == nil {
+		return "nil"
+	}
+	r, g, b := rgb8(c)
+	return fmt.Sprintf("#%02x%02x%02x", r, g, b)
+}
+
+func hexes(cs []color.Color) string {
+	parts := make([]string, len(cs))
+	for i, c := range cs {
+		parts[i] = hexOf(c)
+	}
+	return strings.Join(parts, " ")
+}
+
+func opaque(c color.Color) color.Color {
+	if c == nil {
+		return nil
+	}
+	r, g, b := rgb8(c)
+	return color.RGBA{uint8(r), uint8(g), uint8(b), 255}
+}
+
+// validStops are the stops Blend1D blends: the non-nil ones, made opaque.
+func validStops(stops []color.Color) []color.Color {
+	var valid []color.Color
+	for _, c := range stops {
+		if c != nil {
+			valid = append(valid, opaque(c))
+		}
+	}
+	return valid
+}
+
+var (
+	rgbs = hegel.Map(rgbTriples, func(t [3]int) color.Color {
+		return color.RGBA{uint8(t[0]), uint8(t[1]), uint8(t[2]), 255}
+	})
+	// transparent: alpha 0, documented as treated opaque.
+	transparent = hegel.Map(rgbTriples, func(t [3]int) color.Color {
+		return color.RGBA{uint8(t[0]), uint8(t[1]), uint8(t[2]), 0}
+	})
+	// stops: an opaque colour, a transparent one in ten; stopsWithNils has a nil one in ten.
+	stops         = weighted(w(90, rgbs), w(10, transparent))
+	stopsWithNils = weighted(w(80, rgbs), w(10, transparent), w(10, hegel.Just[color.Color](nil)))
+)
+
+// ---------------------------------------------------------------- Blend1D
+
+// blend1DCase: the steps and the stops. Under HEGEL_NO_KNOWN=1 the steps are drawn outside
+// lipgloss/24's region (fewer than two steps per segment).
+type blend1DCase struct {
+	steps int
+	stops []color.Color
+}
+
+func (c blend1DCase) GoString() string {
+	return fmt.Sprintf("Blend1D(%d, %s)", c.steps, hexes(c.stops))
+}
+
+func stepsFor(stops []color.Color) hegel.Generator[int] {
+	segments := len(validStops(stops)) - 1
+	if !known.Blend1DDropsLastStop || segments < 1 {
+		return hegel.Integers(-2, 40)
+	}
+	return hegel.OneOf(hegel.Integers(-2, len(stops)), hegel.Integers(max(2*segments, len(stops)+1), 40))
+}
+
+var blend1DCases = hegel.Composite(func(tc hegel.TestCase) blend1DCase {
+	stops := hegel.Draw(tc, counted(stopsWithNils, 0, 6))
+	return blend1DCase{steps: hegel.Draw(tc, stepsFor(stops)), stops: stops}
+})
+
+// TestHegelBlend1DRunsThroughItsStops: the ramp has the requested length, holds no nil, starts
+// at the first stop, ends at the last, passes through every stop in order, and reversing the
+// stops reverses the ramp when the segments are equal. A segment of a single step is its start
+// colour only, so with fewer than two steps per segment the ramp misses the last stop
+// (lipgloss/24).
+func TestHegelBlend1DRunsThroughItsStops(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, blend1DCases)
+		steps, stops := c.steps, c.stops
+		got := Blend1D(steps, append([]color.Color(nil), stops...)...)
+		valid := validStops(stops)
+		wantLen := max(steps, 0)
+		if steps > len(stops) && len(valid) == 0 {
+			wantLen = 0 // nil: nothing to blend
+		}
+		if len(got) != wantLen {
+			fail(ht, "Blend1D(%d, %s) has %d colours, want %d: %s", steps, hexes(stops), len(got), wantLen, hexes(got))
+		}
+		if steps <= len(stops) {
+			// Returned as given (nil and transparent included).
+			for i, c := range got {
+				if !colorEqual(c, stops[i]) {
+					fail(ht, "Blend1D(%d, %s)[%d] = %s, want the stop itself", steps, hexes(stops), i, hexOf(c))
+				}
+			}
+			return
+		}
+		if len(valid) == 0 {
+			return
+		}
+		for i, c := range got {
+			if c == nil {
+				fail(ht, "Blend1D(%d, %s)[%d] is nil", steps, hexes(stops), i)
+			}
+		}
+		if len(valid) == 1 {
+			for i, c := range got {
+				if !closeColor(c, valid[0]) {
+					fail(ht, "Blend1D(%d, %s)[%d] = %s, want the single stop", steps, hexes(stops), i, hexOf(c))
+				}
+			}
+			return
+		}
+		segments := len(valid) - 1
+		var sh shapes
+		sh.Add("lipgloss/24", steps/segments < 2)
+		if !closeColor(got[0], valid[0]) {
+			fail(ht, "Blend1D(%d, %s) starts at %s, not at the first stop: %s", steps, hexes(stops), hexOf(got[0]), hexes(got))
+		}
+		if !closeColor(got[len(got)-1], valid[len(valid)-1]) {
+			mismatch(ht, sh, "Blend1D(%d, %s) ends at %s, not at the last stop: %s", steps, hexes(stops), hexOf(got[len(got)-1]), hexes(got))
+		}
+		// Every stop appears, in order.
+		k := 0
+		for _, c := range got {
+			if k < len(valid) && closeColor(c, valid[k]) {
+				k++
+			}
+		}
+		if k < len(valid) {
+			mismatch(ht, sh, "Blend1D(%d, %s) passes through %d of %d stops in order: %s", steps, hexes(stops), k, len(valid), hexes(got))
+		}
+		if steps%segments == 0 {
+			rev := make([]color.Color, len(valid))
+			for i, c := range valid {
+				rev[len(valid)-1-i] = c
+			}
+			back := Blend1D(steps, rev...)
+			for i := range got {
+				if !closeColor(got[i], back[len(back)-1-i]) {
+					mismatch(ht, sh, "Blend1D(%d, %s)[%d] = %s but the reversed stops give %s at the mirrored position\nforward %s\nreversed %s", steps, hexes(stops), i, hexOf(got[i]), hexOf(back[len(back)-1-i]), hexes(got), hexes(back))
+				}
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------- Blend2D
+
+type blend2DCase struct {
+	w, h  int
+	angle float64
+	stops []color.Color
+}
+
+func (c blend2DCase) GoString() string {
+	return fmt.Sprintf("Blend2D(%d, %d, %v, %s)", c.w, c.h, c.angle, hexes(c.stops))
+}
+
+// blend2DCases: by default lipgloss/27's shape first (rightAngleCases, hegel_shapes_test.go;
+// first and at a fifth, since the engine's bounded integer draw favours the lowest values
+// unevenly from run to run and the property mapped to the bug must reach it every run), then
+// any size up to 12 by 12, any of ten angles and one to four stops.
+var blend2DCases = weighted(
+	w(unless(known.Blend2DRightAnglesInexact, 20), rightAngleCases),
+	w(80, hegel.Composite(func(tc hegel.TestCase) blend2DCase {
+		return blend2DCase{
+			w:     hegel.Draw(tc, hegel.Integers(0, 12)),
+			h:     hegel.Draw(tc, hegel.Integers(0, 12)),
+			angle: hegel.Draw(tc, pick(0.0, 90, 180, 270, 45, 30.5, -90, 360, 720, 135)),
+			stops: hegel.Draw(tc, counted(stops, 1, 4)),
+		}
+	})),
+)
+
+// TestHegelBlend2DIsARotatedRamp: width x height colours; one stop fills; at 0 degrees the
+// colour depends on the column only and never steps backwards along the row, at 90 degrees on
+// the row only; 180 degrees mirrors 0; every colour is one of the 1D ramp's. A cell whose
+// ideal position lands exactly on a ramp index is decided by the residue of sin/cos at a
+// right angle (lipgloss/27).
+func TestHegelBlend2DIsARotatedRamp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, blend2DCases)
+		w, h, angle, stops := c.w, c.h, c.angle, c.stops
+		got := Blend2D(w, h, angle, stops...)
+		W, H := max(w, 1), max(h, 1)
+		if len(got) != W*H {
+			fail(ht, "Blend2D(%d,%d,%v) has %d colours, want %d", w, h, angle, len(got), W*H)
+		}
+		for i, c := range got {
+			if c == nil {
+				fail(ht, "Blend2D(%d,%d,%v)[%d] is nil", w, h, angle, i)
+			}
+		}
+		if len(stops) == 1 {
+			for i, c := range got {
+				if !closeColor(c, opaque(stops[0])) {
+					fail(ht, "Blend2D(%d,%d,%v)[%d] = %s, want the single stop %s", w, h, angle, i, hexOf(c), hexOf(stops[0]))
+				}
+			}
+			return
+		}
+		ramp := Blend1D(max(W, H), stops...)
+		index := func(c color.Color) int {
+			for i, r := range ramp {
+				if closeColor(c, r) {
+					return i
+				}
+			}
+			return -1
+		}
+		at := func(x, y int) color.Color { return got[y*W+x] }
+		for y := 0; y < H; y++ {
+			for x := 0; x < W; x++ {
+				if index(at(x, y)) < 0 {
+					fail(ht, "Blend2D(%d,%d,%v) at (%d,%d) = %s is not on the 1D ramp %s", w, h, angle, x, y, hexOf(at(x, y)), hexes(ramp))
+				}
+			}
+		}
+		a := angle - 360*float64(int(angle/360))
+		if a < 0 {
+			a += 360
+		}
+		// boundary reports whether a cell's ideal position at a right angle lands exactly on
+		// a ramp index: the point where the sin/cos residues of 90/180/270 degrees decide
+		// which way int() rounds (lipgloss/27).
+		boundary := func(x, y int, ang float64) bool {
+			dx := float64(x) - float64(W-1)/2
+			dy := float64(y) - float64(H-1)/2
+			var rot float64
+			switch ang {
+			case 0:
+				rot = dx
+			case 90:
+				rot = -dy
+			case 180:
+				rot = -dx
+			case 270:
+				rot = dy
+			default:
+				return false
+			}
+			diag := math.Sqrt(float64(W*W + H*H))
+			v := (rot + diag/2) / diag * float64(len(ramp)-1)
+			return math.Abs(v-math.Round(v)) < 1e-9
+		}
+		// differ fails two cells that share an ideal position and disagree, naming
+		// lipgloss/27 when the cell is on a boundary.
+		differ := func(c, o color.Color, x, y int, ang float64, format string, args ...any) {
+			if closeColor(c, o) {
+				return
+			}
+			var sh shapes
+			sh.Add("lipgloss/27", boundary(x, y, ang))
+			mismatch(ht, sh, format, args...)
+		}
+		switch a {
+		case 0, 180:
+			for y := 1; y < H; y++ {
+				for x := 0; x < W; x++ {
+					differ(at(x, y), at(x, 0), x, y, a, "Blend2D(%d,%d,%v): rows differ at column %d: row 0 %s, row %d %s", w, h, angle, x, hexOf(at(x, 0)), y, hexOf(at(x, y)))
+				}
+			}
+			// The top row walks the ramp forwards (0 degrees) or backwards (180); a colour
+			// may occur at several ramp indices, so the walk picks the nearest one ahead.
+			pos := -1
+			if a == 180 {
+				pos = len(ramp)
+			}
+			for x := 0; x < W; x++ {
+				next := -1
+				for i, r := range ramp {
+					if !closeColor(at(x, 0), r) {
+						continue
+					}
+					if a == 0 && i >= pos && (next < 0 || i < next) {
+						next = i
+					}
+					if a == 180 && i <= pos && i > next {
+						next = i
+					}
+				}
+				if next < 0 {
+					fail(ht, "Blend2D(%d,%d,%v): the ramp steps backwards at column %d (%s after %s at index %d)\nstops %s\nramp %s", w, h, angle, x, hexOf(at(x, 0)), hexOf(at(max(x-1, 0), 0)), pos, hexes(stops), hexes(ramp))
+				}
+				pos = next
+			}
+		case 90, 270:
+			for x := 1; x < W; x++ {
+				for y := 0; y < H; y++ {
+					differ(at(x, y), at(0, y), x, y, a, "Blend2D(%d,%d,%v): columns differ at row %d: column 0 %s, column %d %s", w, h, angle, y, hexOf(at(0, y)), x, hexOf(at(x, y)))
+				}
+			}
+		}
+		if a == 0 || a == 90 {
+			mirror := Blend2D(w, h, angle+180, stops...)
+			for y := 0; y < H; y++ {
+				for x := 0; x < W; x++ {
+					differ(mirror[y*W+x], at(W-1-x, H-1-y), x, y, a+180, "Blend2D(%d,%d,%v) at (%d,%d) = %s, but %v degrees gives %s at the mirrored cell", w, h, angle+180, x, y, hexOf(mirror[y*W+x]), angle, hexOf(at(W-1-x, H-1-y)))
+				}
+			}
+		}
+	})
+}
+
+// endsCase: a one-row gradient's width and stops. Under HEGEL_NO_KNOWN=1 the width gives
+// every segment two steps at least (lipgloss/24's region is not drawn).
+type endsCase struct {
+	w     int
+	stops []color.Color
+}
+
+func (c endsCase) GoString() string { return fmt.Sprintf("Blend2D(%d, 1, 0, %s)", c.w, hexes(c.stops)) }
+
+var endsCases = hegel.Composite(func(tc hegel.TestCase) endsCase {
+	stops := hegel.Draw(tc, counted(stops, 2, 4))
+	lo := 2
+	if known.Blend1DDropsLastStop {
+		lo = 2 * (len(stops) - 1)
+	}
+	return endsCase{w: hegel.Draw(tc, hegel.Integers(lo, 40)), stops: stops}
+})
+
+// checkEnds: a one-row 0-degree gradient starts at the first stop and ends at the last, as the
+// 1D ramp does. Blend2D maps cell centres onto the ramp with int(), so the far end is never
+// reached (lipgloss/25); with fewer than two steps per segment the ramp itself misses the last
+// stop (lipgloss/24).
+func checkEnds(ht *hegel.T, c endsCase, sh shapes) {
+	w, stops := c.w, c.stops
+	got := Blend2D(w, 1, 0, stops...)
+	first, last := opaque(stops[0]), opaque(stops[len(stops)-1])
+	if !closeColor(got[0], first) {
+		fail(ht, "Blend2D(%d, 1, 0, %s) starts at %s, not the first stop", w, hexes(stops), hexOf(got[0]))
+	}
+	sh.Add("lipgloss/24", w/(len(stops)-1) < 2)
+	if known.Blend2DStopsShort {
+		// The far end of the ramp is truncated (lipgloss/25): counted, not checked.
+		if !closeColor(got[w-1], last) {
+			count("lipgloss/25-shape")
+		}
+		return
+	}
+	sh.Add("lipgloss/25", true)
+	if !closeColor(got[w-1], last) {
+		mismatch(ht, sh, "Blend2D(%d, 1, 0, %s) ends at %s, not the last stop %s: %s", w, hexes(stops), hexOf(got[w-1]), hexOf(last), hexes(got))
+	}
+	count("ok")
+}
+
+// TestHegelBlend2DReachesBothEnds: a one-row gradient at 0 degrees runs from the first stop to
+// the last, as the 1D ramp does.
+func TestHegelBlend2DReachesBothEnds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkEnds(ht, hegel.Draw(ht, endsCases), nil)
+	})
+}
+
+// ---------------------------------------------------------------- border blend
+
+// perimeterPath lists the border cells of a rendered block clockwise from the top-left
+// corner: top row left to right, right column top to bottom, bottom row right to left, left
+// column bottom to top; each entry is (row, column) in the rendered cell grid.
+func perimeterPath(rows, cols int, top, right, bottom, left bool) [][2]int {
+	var path [][2]int
+	if top {
+		x0, x1 := 0, cols-1
+		if !left {
+			x0 = 0
+		}
+		for x := x0; x <= x1; x++ {
+			path = append(path, [2]int{0, x})
+		}
+	}
+	y0, y1 := 0, rows-1
+	if top {
+		y0 = 1
+	}
+	if bottom {
+		y1 = rows - 2
+	}
+	if right {
+		for y := y0; y <= y1; y++ {
+			path = append(path, [2]int{y, cols - 1})
+		}
+	}
+	if bottom {
+		for x := cols - 1; x >= 0; x-- {
+			path = append(path, [2]int{rows - 1, x})
+		}
+	}
+	if left {
+		for y := y1; y >= y0; y-- {
+			path = append(path, [2]int{y, 0})
+		}
+	}
+	return path
+}
+
+// borderBlendCase: the text (one fill character per line, w wide), the border, the sides
+// when set explicitly, the stops, the offset and the background.
+type borderBlendCase struct {
+	w      int
+	fills  []string
+	name   string
+	sides  *[4]bool // top, right, bottom, left
+	stops  []color.Color
+	offset int
+	bg     color.Color
+}
+
+func (c borderBlendCase) text() string {
+	lines := make([]string, len(c.fills))
+	for i, f := range c.fills {
+		lines[i] = strings.Repeat(f, c.w)
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (c borderBlendCase) style() Style {
+	st := NewStyle().Border(borders[c.name])
+	if c.sides != nil {
+		st = st.BorderTop(c.sides[0]).BorderRight(c.sides[1]).BorderBottom(c.sides[2]).BorderLeft(c.sides[3])
+	}
+	if c.bg != nil {
+		st = st.BorderBackground(c.bg)
+	}
+	return st.BorderForegroundBlend(c.stops...).BorderForegroundBlendOffset(c.offset)
+}
+
+func (c borderBlendCase) GoString() string {
+	sides := "all sides"
+	if c.sides != nil {
+		sides = fmt.Sprintf("sides t%v r%v b%v l%v", c.sides[0], c.sides[1], c.sides[2], c.sides[3])
+	}
+	return fmt.Sprintf("%q border %s %s blend %s offset %d bg %v", c.text(), c.name, sides, hexes(c.stops), c.offset, c.bg)
+}
+
+// allNil reports stops that are all nil.
+func allNil(stops []color.Color) bool {
+	for _, s := range stops {
+		if s != nil {
+			return false
+		}
+	}
+	return true
+}
+
+var (
+	fourSides60 = hegel.Composite(func(tc hegel.TestCase) [4]bool {
+		return [4]bool{hegel.Draw(tc, chance(60)), hegel.Draw(tc, chance(60)), hegel.Draw(tc, chance(60)), hegel.Draw(tc, chance(60))}
+	})
+	// nilRings: two to five nil stops (lipgloss/29: Render panics).
+	nilRings = hegel.Map(hegel.Integers(2, 5), func(k int) []color.Color { return make([]color.Color, k) })
+	// rings: two to five opaque or transparent stops; with a nil among them one time in
+	// ten (dropped by Blend1D); all nil one time in ten.
+	rings = weighted(
+		w(100, counted(stops, 2, 5)),
+		w(10, counted(stopsWithNils, 2, 5)),
+		w(unless(known.AllNilBlendPanics, 10), nilRings),
+	)
+	borderBlendCases = hegel.Composite(func(tc hegel.TestCase) borderBlendCase {
+		h := hegel.Draw(tc, hegel.Integers(1, 4))
+		return borderBlendCase{
+			w:      hegel.Draw(tc, hegel.Integers(0, 8)),
+			fills:  hegel.Draw(tc, hegel.Lists(pick("a", "b", ".", " ", "x")).MinSize(h).MaxSize(h)),
+			name:   hegel.Draw(tc, pick(borderNames...)),
+			sides:  hegel.Draw(tc, maybe(30, ptr(fourSides60))),
+			stops:  hegel.Draw(tc, rings),
+			offset: hegel.Draw(tc, maybe(60, hegel.Integers(-30, 30))),
+			bg:     hegel.Draw(tc, maybe(40, colors)),
+		}
+	})
+)
+
+// checkBorderBlend: with BorderForegroundBlend the border cells' foregrounds walk a ramp
+// clockwise from the top-left corner, one ramp colour per cell (the offset moves the ramp's
+// start along the path), with the side's background and the border's glyphs; the text keeps
+// its own styles. Known shapes: a ring of nil stops panics (lipgloss/29); a ramp colour with
+// a 16-bit channel below 256 is written 256 times too bright (lipgloss/28); the ring is two
+// colours longer than each horizontal edge, so the walk jumps at the right-hand corners
+// (lipgloss/23); a ring shorter than two steps per segment misses its last stop
+// (lipgloss/24).
+func checkBorderBlend(ht *hegel.T, c borderBlendCase, sh shapes) {
+	w, h := c.w, len(c.fills)
+	text := c.text()
+	top, right, bottom, left := true, true, true, true
+	partial := c.sides != nil
+	if partial {
+		top, right, bottom, left = c.sides[0], c.sides[1], c.sides[2], c.sides[3]
+	}
+	stops, offset, bg := c.stops, c.offset, c.bg
+	st := c.style()
+	sh.Add("lipgloss/29", allNil(stops))
+	var out string
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				mismatch(ht, sh, "Render panicked: %v (blend %s)", r, hexes(stops))
+			}
+		}()
+		out = st.Render(text)
+	}()
+	if allNil(stops) {
+		// Nothing to blend: a plain border is the documented fallback for a nil stop.
+		if want := NewStyle().Border(borders[c.name]).Render(text); c.sides == nil && bg == nil && out != want {
+			mismatch(ht, sh, "a blend of nil stops renders %q, a plain border %q", out, want)
+		}
+		count("nil-ring")
+		return
+	}
+	got := parseCells(out)
+	cols := w
+	if left {
+		cols++
+	}
+	if right {
+		cols++
+	}
+	rows := h
+	if top {
+		rows++
+	}
+	if bottom {
+		rows++
+	}
+	if !top && !right && !bottom && !left {
+		count("no-sides")
+		return
+	}
+	if len(got) != rows {
+		fail(ht, "%d rows rendered, want %d:\n%s", len(got), rows, rowsString(got))
+	}
+	for y, r := range got {
+		if rowWidth(r) != cols {
+			fail(ht, "row %d is %d cells wide, want %d:\n%s", y, rowWidth(r), cols, rowsString(got))
+		}
+	}
+	// The ring: the library blends over (height + width + 2) * 2 steps where width counts
+	// the side border columns; the path is shorter (lipgloss/23).
+	valid := validStops(stops)
+	ringLen := (h + cols + 2) * 2
+	ring := Blend1D(ringLen, stops...)
+	sh.Add("lipgloss/24", len(valid) > 1 && ringLen/(len(valid)-1) < 2)
+	path := perimeterPath(rows, cols, top, right, bottom, left)
+	if len(path) == 0 {
+		count("empty-path") // a top or bottom edge of nothing
+		return
+	}
+	// index lists the ring indices a cell's colour matches; a colour that matches only
+	// through the misencoding of lipgloss/28 is accepted under HEGEL_NO_KNOWN=1 and
+	// otherwise reported as the shape.
+	index := func(c color.Color) (idx []int, dark bool) {
+		for i, r := range ring {
+			if closeColor(c, r) {
+				idx = append(idx, i)
+			} else if m := misencoded(r); m != nil && closeColor(c, m) {
+				dark = true
+				if known.DarkChannelsRenderBright {
+					count("lipgloss/28-shape")
+					idx = append(idx, i)
+				}
+			}
+		}
+		return idx, dark
+	}
+	cellAt := func(p [2]int) mcell {
+		r := got[p[0]]
+		x := 0
+		for _, c := range r {
+			if x == p[1] {
+				return c
+			}
+			x += c.w
+		}
+		return mcell{}
+	}
+	// Every border cell is on the ring, carries the background, and is a border glyph.
+	for k, p := range path {
+		c := cellAt(p)
+		if idx, dark := index(c.st.fg); c.st.fg == nil || len(idx) == 0 {
+			s := sh
+			s.Add("lipgloss/28", dark)
+			mismatch(ht, s, "border cell %d at %v has foreground %s, not a ramp colour\nstops %s (%v) offset %d text %q border %s\nring %s\n%s\noutput %q", k, p, hexOf(c.st.fg), hexes(stops), stops, offset, text, c.g, hexes(ring), rowsString(got), out)
+		}
+		if !colorEqual(c.st.bg, bg) {
+			fail(ht, "border cell %d at %v has background %v, want %v\n%s", k, p, c.st.bg, bg, rowsString(got))
+		}
+	}
+	// The text cells keep no border colour.
+	for y := 0; y < h; y++ {
+		ry := y
+		if top {
+			ry++
+		}
+		x0 := 0
+		if left {
+			x0 = 1
+		}
+		for x := 0; x < w; x++ {
+			c := cellAt([2]int{ry, x0 + x})
+			if c.st.fg != nil || c.st.bg != nil {
+				fail(ht, "text cell (%d,%d) is styled %s\n%s", x, y, c.st, rowsString(got))
+			}
+		}
+	}
+	// The walk: consecutive cells of one edge have consecutive ring indices; across a
+	// corner too, except where a missing side breaks the path; the top-right and
+	// bottom-right corners are where the ring skips two colours (lipgloss/23).
+	start := ((-offset)%ringLen + ringLen) % ringLen
+	if top && left {
+		if idx, _ := index(cellAt(path[0]).st.fg); !containsInt(idx, start) {
+			mismatch(ht, sh, "the top-left corner has ring index %v, want %d (offset %d, ring of %d)\nring %s\n%s", idx, start, offset, ringLen, hexes(ring), rowsString(got))
+		}
+	}
+	edgeOf := func(p [2]int) string {
+		switch {
+		case top && p[0] == 0:
+			return "top"
+		case bottom && p[0] == rows-1:
+			return "bottom"
+		case p[1] == 0:
+			return "left"
+		default:
+			return "right"
+		}
+	}
+	prev, _ := index(cellAt(path[0]).st.fg)
+	for k := 1; k < len(path); k++ {
+		cur, _ := index(cellAt(path[k]).st.fg)
+		e0, e1 := edgeOf(path[k-1]), edgeOf(path[k])
+		corner := false
+		if e0 != e1 {
+			if partial {
+				// A missing side: the ring index jumps across the gap.
+				count("broken-path")
+				prev = cur
+				continue
+			}
+			if e1 == "right" || e1 == "bottom" {
+				if known.BorderBlendSkipsRightCorners {
+					count("lipgloss/23-shape")
+					prev = cur
+					continue
+				}
+				corner = true
+			}
+		}
+		ok := false
+		for _, i := range prev {
+			if containsInt(cur, (i+1)%ringLen) {
+				ok = true
+			}
+		}
+		if !ok {
+			s := sh
+			s.Add("lipgloss/23", corner)
+			mismatch(ht, s, "border cells %d and %d (%v -> %v, %s -> %s) have ring indices %v and %v: not consecutive\nring %s\n%s", k-1, k, path[k-1], path[k], e0, e1, prev, cur, hexes(ring), rowsString(got))
+		}
+		prev = cur
+	}
+	count("ok")
+}
+
+// TestHegelBorderBlendWrapsTheFrame: BorderForegroundBlend/Offset against the ring, walked
+// along the perimeter, with backgrounds and partial sides.
+func TestHegelBorderBlendWrapsTheFrame(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkBorderBlend(ht, hegel.Draw(ht, borderBlendCases), nil)
+	})
+}
+
+// misencoded returns the colour lipgloss actually writes for c when one of its 16-bit
+// channels is below 256 and so is emitted verbatim instead of divided by 256
+// (lipgloss/28), or nil when c is written faithfully.
+func misencoded(c color.Color) color.Color {
+	r, g, b, _ := c.RGBA()
+	sh := func(v uint32) uint32 {
+		if v > 0xff {
+			return v >> 8
+		}
+		return v
+	}
+	if sh(r) == r>>8 && sh(g) == g>>8 && sh(b) == b>>8 {
+		return nil
+	}
+	return color.RGBA{uint8(sh(r)), uint8(sh(g)), uint8(sh(b)), 255}
+}
+
+func containsInt(xs []int, x int) bool {
+	for _, v := range xs {
+		if v == x {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------- StyleRunes
+
+// runeStyles: a style that colours text without changing its layout (foreground,
+// background, bold, italic).
+var runeStyles = hegel.Composite(func(tc hegel.TestCase) inlineStyle {
+	return inlineStyle{
+		fg:     hegel.Draw(tc, maybe(60, colors)),
+		bg:     hegel.Draw(tc, maybe(40, colors)),
+		bold:   hegel.Draw(tc, chance(30)),
+		italic: hegel.Draw(tc, chance(20)),
+	}
+})
+
+// runesCase: the string as runes, the indices to match (in or out of range), the two styles.
+type runesCase struct {
+	str                string
+	indices            []int
+	matched, unmatched inlineStyle
+}
+
+func (c runesCase) GoString() string {
+	return fmt.Sprintf("StyleRunes(%q, %v, matched %#v, unmatched %#v)", c.str, c.indices, c.matched, c.unmatched)
+}
+
+// runesOf is one rune or wide grapheme of the string: a letter, a space, a wide grapheme, or
+// a newline (lipgloss/26: a multi-line string is padded).
+func runesOf() hegel.Generator[string] {
+	return weighted(
+		w(71, pick("a", "b", "Z", "0", "\u00e9", "-")),
+		w(14, hegel.Just(" ")),
+		w(12, wideGrapheme),
+		w(unless(known.StyleRunesPadsMultiLine, 3), hegel.Just("\n")),
+	)
+}
+
+func runesCasesOf(runes hegel.Generator[string]) hegel.Generator[runesCase] {
+	return hegel.Composite(func(tc hegel.TestCase) runesCase {
+		return runesCase{
+			str:       strings.Join(hegel.Draw(tc, counted(runes, 0, 12)), ""),
+			indices:   hegel.Draw(tc, counted(hegel.Integers(-2, 14), 0, 6)),
+			matched:   hegel.Draw(tc, runeStyles),
+			unmatched: hegel.Draw(tc, runeStyles),
+		}
+	})
+}
+
+// multiLineRunesCases: lipgloss/26's shape with every instance reaching the bug - a first
+// line of one to six graphemes and a second line that is a strictly shorter prefix of it, so
+// the block always has a line to pad (two lines of one width, or two empty ones, pad nothing).
+var multiLineRunesCases = hegel.Composite(func(tc hegel.TestCase) runesCase {
+	c := hegel.Draw(tc, runesCasesOf(narrowGrapheme))
+	first := hegel.Draw(tc, counted(narrowGrapheme, 1, 6))
+	k := hegel.Draw(tc, hegel.Integers(0, len(first)-1))
+	c.str = strings.Join(first, "") + "\n" + strings.Join(first[:k], "")
+	return c
+})
+
+// runesCases: by default lipgloss/26's shape first and at a fifth (the engine's bounded
+// integer draw favours the lowest values unevenly from run to run, and the property mapped to
+// the bug must reach it every run: as a three-percent newline at the last index of runesOf it
+// passed a full run), then any string.
+var runesCases = weighted(
+	w(unless(known.StyleRunesPadsMultiLine, 20), multiLineRunesCases),
+	w(80, runesCasesOf(runesOf())),
+)
+
+// checkStyleRunes: the output shows the string unchanged, each rune with the matched style
+// when its index is listed (out-of-range indices ignored) and the unmatched style otherwise.
+// Each run of runes goes through Style.Render, which pads a block's lines to its widest, so a
+// multi-line string gains spaces (lipgloss/26).
+func checkStyleRunes(ht *hegel.T, c runesCase, sh shapes) {
+	str, indices, matched, unmatched := c.str, c.indices, c.matched, c.unmatched
+	sh.Add("lipgloss/26", strings.Contains(str, "\n"))
+	out := StyleRunes(str, indices, matched.apply(), unmatched.apply())
+	rows := parseCells(out)
+	var plain strings.Builder
+	for y, r := range rows {
+		if y > 0 {
+			plain.WriteString("\n")
+		}
+		for _, c := range r {
+			plain.WriteString(c.g)
+		}
+	}
+	if plain.String() != str {
+		mismatch(ht, sh, "StyleRunes(%q, %v) shows %q", str, indices, plain.String())
+	}
+	set := map[int]bool{}
+	for _, i := range indices {
+		set[i] = true
+	}
+	want := func(st inlineStyle) mstyle {
+		m := st.pen()
+		m.attrs &= aBold | aItalic
+		return m
+	}
+	i := 0
+	for _, r := range rows {
+		for _, c := range r {
+			st := unmatched
+			if set[i] {
+				st = matched
+			}
+			wm := want(st)
+			gm := c.st
+			if c.g == " " {
+				// Bold/italic and the foreground are invisible on a blank.
+				wm.attrs, gm.attrs = 0, 0
+				wm.fg, gm.fg = nil, nil
+			}
+			if !colorEqual(wm.fg, gm.fg) || !colorEqual(wm.bg, gm.bg) || wm.attrs != gm.attrs&5 {
+				mismatch(ht, sh, "StyleRunes(%q, %v): rune %d %q has %s, want %s (matched %v)\n%s\noutput %q", str, indices, i, c.g, gm, wm, set[i], rowsString(rows), out)
+			}
+			i += len([]rune(c.g))
+		}
+		i++ // the newline
+	}
+	count("ok")
+}
+
+// TestHegelStyleRunesStyleTheirRunes: StyleRunes styles exactly the matched runes.
+func TestHegelStyleRunesStyleTheirRunes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkStyleRunes(ht, hegel.Draw(ht, runesCases), nil)
+	})
+}
+
+// ---------------------------------------------------------------- SetString / Value
+
+type setStringCase struct {
+	parts []string
+	extra string
+	style inlineStyle
+}
+
+func (c setStringCase) GoString() string {
+	return fmt.Sprintf("SetString(%q) extra %q style %#v", c.parts, c.extra, c.style)
+}
+
+var setStringCases = hegel.Composite(func(tc hegel.TestCase) setStringCase {
+	return setStringCase{
+		parts: hegel.Draw(tc, counted(pick("", "a", "hello", "x y", "\u00e9"), 0, 3)),
+		extra: hegel.Draw(tc, pick("", "z", "more text")),
+		style: hegel.Draw(tc, runeStyles),
+	}
+})
+
+// TestHegelSetStringJoinsAndRenders: Value is the strings joined by spaces; String renders it;
+// Render prepends it to its arguments; Inherit does not carry it.
+func TestHegelSetStringJoinsAndRenders(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, setStringCases)
+		parts, extra := c.parts, c.extra
+		st := c.style.apply().SetString(parts...)
+		want := strings.Join(parts, " ")
+		if st.Value() != want {
+			fail(ht, "SetString(%q).Value() = %q, want %q", parts, st.Value(), want)
+		}
+		if st.String() != st.Render() {
+			fail(ht, "SetString(%q).String() = %q, Render() = %q", parts, st.String(), st.Render())
+		}
+		if want == "" {
+			if st.Render(extra) != withoutValue(st).Render(extra) {
+				fail(ht, "an empty value changes Render(%q): %q vs %q", extra, st.Render(extra), withoutValue(st).Render(extra))
+			}
+		} else if st.Render(extra) != withoutValue(st).Render(want, extra) {
+			fail(ht, "SetString(%q).Render(%q) = %q, want Render(%q, %q) = %q", parts, extra, st.Render(extra), want, extra, withoutValue(st).Render(want, extra))
+		}
+		if v := NewStyle().Inherit(st).Value(); v != "" {
+			fail(ht, "Inherit carried the value %q", v)
+		}
+		count("ok")
+	})
+}
+
+// withoutValue returns the style without its value.
+func withoutValue(st Style) Style {
+	st.value = ""
+	return st
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/23: borderBlend allocates (height + width + 2) * 2 ramp colours where width already
+// counts the side border columns, so each horizontal edge gets two colours more than it has
+// cells and the ramp jumps by two at the top-right and bottom-right corners.
+func TestHegelPinBorderBlendSkipsTwoColoursAtTheRightCorners(t *testing.T) {
+	defer guard(t)
+	stops := []color.Color{color.RGBA{0, 0, 0, 255}, color.RGBA{255, 255, 255, 255}}
+	out := NewStyle().Border(NormalBorder()).BorderForegroundBlend(stops...).Render("abc")
+	rows := parseCells(out)
+	// 5 columns x 3 rows: the path has 12 cells; the ramp has (1+5+2)*2 = 16 colours.
+	ring := Blend1D(16, stops...)
+	idx := func(c color.Color) int {
+		for i, r := range ring {
+			if closeColor(c, r) {
+				return i
+			}
+		}
+		return -1
+	}
+	topRight, rightSide := rows[0][4].st.fg, rows[1][4].st.fg
+	if idx(rightSide) == idx(topRight)+1 {
+		return
+	}
+	t.Fatalf("top-right corner is ramp colour %d, the cell below it %d (ring of 16 for a 12-cell path): the gradient jumps at the corner", idx(topRight), idx(rightSide))
+}
+
+// lipgloss/24: Blend1D gives a segment of a single step its start colour only, so with fewer
+// than two steps per segment the ramp never reaches the last stop.
+func TestHegelPinBlend1DDropsTheLastStop(t *testing.T) {
+	defer guard(t)
+	a, b, c, d := color.RGBA{255, 0, 0, 255}, color.RGBA{0, 255, 0, 255}, color.RGBA{0, 0, 255, 255}, color.RGBA{255, 255, 0, 255}
+	got := Blend1D(5, a, b, c, d)
+	if closeColor(got[4], d) {
+		return
+	}
+	t.Fatalf("Blend1D(5, red, green, blue, yellow) = %s: it ends at %s, not yellow", hexes(got), hexOf(got[4]))
+}
+
+// lipgloss/25: Blend2D maps cell centres onto the ramp with int(), so the far end of the ramp
+// is never used: a one-row gradient starts at the first stop but stops short of the last.
+func TestHegelPinBlend2DStopsShortOfTheLastStop(t *testing.T) {
+	defer guard(t)
+	a, b := color.RGBA{0, 0, 0, 255}, color.RGBA{255, 255, 255, 255}
+	got := Blend2D(10, 1, 0, a, b)
+	if closeColor(got[9], b) {
+		return
+	}
+	t.Fatalf("Blend2D(10, 1, 0, black, white) = %s: the first cell is %s, the last %s", hexes(got), hexOf(got[0]), hexOf(got[9]))
+}
+
+// lipgloss/27: Blend2D rotates with cos/sin of the angle in radians; at 180 and 270 degrees
+// the residue (about 1e-16) is multiplied by the cell offset and flips int() on an exact ramp
+// boundary, so a 270-degree gradient is not constant along its rows and 180 is not the
+// mirror of 0.
+func TestHegelPinBlend2DRightAnglesAreInexact(t *testing.T) {
+	defer guard(t)
+	a, b := color.RGBA{0, 0, 0, 255}, color.RGBA{255, 255, 255, 255}
+	got := Blend2D(11, 1, 270, a, b)
+	uniform := true
+	for _, c := range got {
+		if !closeColor(c, got[0]) {
+			uniform = false
+		}
+	}
+	if uniform {
+		return
+	}
+	t.Fatalf("Blend2D(11, 1, 270, black, white), a one-row gradient across the rows, is %s", hexes(got))
+}
+
+// lipgloss/26: StyleRunes renders each run of runes through Style.Render, which pads a
+// multi-line block to its widest line, so a ragged multi-line string gains trailing spaces -
+// a different number depending on where the runs are cut.
+func TestHegelPinStyleRunesPadsMultiLineStrings(t *testing.T) {
+	defer guard(t)
+	plain := func(out string) string {
+		var sb strings.Builder
+		for y, r := range parseCells(out) {
+			if y > 0 {
+				sb.WriteString("\n")
+			}
+			for _, c := range r {
+				sb.WriteString(c.g)
+			}
+		}
+		return sb.String()
+	}
+	red := NewStyle().Foreground(Color("#ff0000"))
+	none := plain(StyleRunes("abc\nd", nil, NewStyle().Bold(true), red))
+	cut := plain(StyleRunes("ab\ncd", []int{4}, NewStyle().Bold(true), red))
+	if none == "abc\nd" && cut == "ab\ncd" {
+		return
+	}
+	t.Fatalf("StyleRunes(\"abc\\nd\", nil, bold, red) shows %q; StyleRunes(\"ab\\ncd\", [4], bold, red) shows %q (an unstyled unmatched style is returned as is, a styled one goes through Render)", none, cut)
+}
+
+// lipgloss/28: a colour channel whose 16-bit value is below 256 (an intensity under
+// 1/256, as Blend1D readily produces next to a stop with a zero channel) is written out
+// verbatim as the 8-bit value, 256 times too bright.
+func TestHegelPinNearBlackChannelsRenderBright(t *testing.T) {
+	defer guard(t)
+	ramp := Blend1D(30, color.RGBA{230, 23, 89, 255}, color.RGBA{58, 0, 32, 255}, color.RGBA{205, 210, 63, 255})
+	c := ramp[12]
+	r, g, b, _ := c.RGBA()
+	want := fmt.Sprintf("38;2;%d;%d;%d", r>>8, g>>8, b>>8)
+	out := NewStyle().Foreground(c).Render("x")
+	if !strings.Contains(out, want) {
+		t.Fatalf("Blend1D colour %s (16-bit %d,%d,%d) renders as %q, want %s", hexOf(c), r, g, b, out, want)
+	}
+	c2 := color.RGBA64{R: 0x8000, G: 0x00c7, B: 0x0001, A: 0xffff}
+	if out := NewStyle().Background(c2).Render("x"); !strings.Contains(out, "48;2;128;0;0") {
+		t.Fatalf("RGBA64 #800000 (G = 199/65535) renders as %q, want 48;2;128;0;0", out)
+	}
+}
+
+// lipgloss/29: a border foreground blend whose stops are all nil panics in Render.
+func TestHegelPinBorderBlendPanicsWhenEveryStopIsNil(t *testing.T) {
+	defer guard(t)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Render panicked: %v", r)
+		}
+	}()
+	out := NewStyle().Border(NormalBorder()).BorderForegroundBlend(nil, nil).Render("x")
+	if out != NewStyle().Border(NormalBorder()).Render("x") {
+		t.Fatalf("got %q", out)
+	}
+}
diff --git a/hegel_canvas_test.go b/hegel_canvas_test.go
new file mode 100644
index 0000000..be570ba
--- /dev/null
+++ b/hegel_canvas_test.go
@@ -0,0 +1,388 @@
+package lipgloss
+
+// Hegel property tests for Layer, Compositor and Canvas (hegel-zoo target go/lipgloss): a
+// random layer tree is flattened and painted by a cell model - absolute positions, z order
+// with insertion order for ties, later cells on top - and compared with Compositor.Render
+// and Hit; Layer.Width/Height are the union bounds.
+
+import (
+	"fmt"
+	"image"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// layerSpec is a drawn layer: its position, z, lines, background flag, whether it gets an
+// ID (assigned in tree order by assignIDs), and its children.
+type layerSpec struct {
+	x, y, z  int
+	hasID    bool
+	id       string
+	lines    []string
+	bg       bool
+	children []layerSpec
+}
+
+// content is the layer's text: the lines, rendered with a background when asked.
+func (l layerSpec) content() string {
+	s := strings.Join(l.lines, "\n")
+	if l.bg {
+		s = NewStyle().Background(Color("2")).Render(s)
+	}
+	return s
+}
+
+func (l layerSpec) build() *Layer {
+	lay := NewLayer(l.content()).X(l.x).Y(l.y).Z(l.z).ID(l.id)
+	for _, c := range l.children {
+		lay.AddLayers(c.build())
+	}
+	return lay
+}
+
+func (l layerSpec) GoString() string {
+	s := fmt.Sprintf("{%q at %d,%d z%d id %q", strings.Join(l.lines, "\n"), l.x, l.y, l.z, l.id)
+	if l.bg {
+		s += " bg"
+	}
+	for _, c := range l.children {
+		s += " " + c.GoString()
+	}
+	return s + "}"
+}
+
+// layerLinesOf is one line of a layer: lo to five graphemes, blanks among them.
+func layerLinesOf(lo int) hegel.Generator[string] {
+	return hegel.Map(counted(weighted(w(80, narrowGrapheme), w(20, hegel.Just(" "))), lo, 5), func(gs []string) string { return strings.Join(gs, "") })
+}
+
+// leafLayersOf is a childless layer whose lines come from lines.
+func leafLayersOf(lines hegel.Generator[string]) hegel.Generator[layerSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) layerSpec {
+		return layerSpec{
+			x:     hegel.Draw(tc, hegel.Integers(0, 8)),
+			y:     hegel.Draw(tc, hegel.Integers(0, 4)),
+			z:     hegel.Draw(tc, hegel.Integers(0, 3)),
+			hasID: hegel.Draw(tc, chance(80)),
+			lines: hegel.Draw(tc, counted(lines, 1, 3)),
+			bg:    hegel.Draw(tc, chance(30)),
+		}
+	})
+}
+
+// Depth-indexed tower: leaves, then layers whose children are leaves. The anchor is the
+// first root: when it sits at the origin its first line is never empty, so the bounds start
+// there.
+var (
+	leafLayers   = leafLayersOf(layerLinesOf(0))
+	anchorLayers = hegel.Composite(func(tc hegel.TestCase) layerSpec {
+		l := hegel.Draw(tc, leafLayersOf(layerLinesOf(1)))
+		l.children = hegel.Draw(tc, maybe(30, counted(leafLayers, 1, 2)))
+		return l
+	})
+	layers = hegel.Composite(func(tc hegel.TestCase) layerSpec {
+		l := hegel.Draw(tc, leafLayers)
+		l.children = hegel.Draw(tc, maybe(30, counted(leafLayers, 1, 2)))
+		return l
+	})
+)
+
+// assignIDs gives every layer that asked for one an ID in tree order (la, lb, ...).
+func assignIDs(ls []layerSpec, next *int) {
+	for i := range ls {
+		if ls[i].hasID {
+			ls[i].id = "l" + string(rune('a'+*next))
+		}
+		*next++
+		assignIDs(ls[i].children, next)
+	}
+}
+
+// hitSpec is a Hit probe, taken modulo the bounds (and one cell around them) when applied.
+type hitSpec struct {
+	dx, dy int
+}
+
+// compositorCase: the roots, whether the first root sits at the origin, and the Hit probes.
+type compositorCase struct {
+	roots    []layerSpec
+	atOrigin bool
+	hits     []hitSpec
+}
+
+func (c compositorCase) GoString() string {
+	return fmt.Sprintf("layers %#v at origin %v", c.roots, c.atOrigin)
+}
+
+// layout returns the roots as built: IDs assigned, the first root moved to the origin when
+// asked.
+func (c compositorCase) layout() []layerSpec {
+	roots := make([]layerSpec, len(c.roots))
+	copy(roots, c.roots)
+	next := 0
+	assignIDs(roots, &next)
+	if c.atOrigin && len(roots) > 0 {
+		roots[0].x, roots[0].y = 0, 0
+	}
+	return roots
+}
+
+var (
+	hits = hegel.Composite(func(tc hegel.TestCase) hitSpec {
+		return hitSpec{hegel.Draw(tc, hegel.Integers(0, 30)), hegel.Draw(tc, hegel.Integers(0, 30))}
+	})
+	// origins: the first root at the origin most of the time, elsewhere otherwise
+	// (lipgloss/19: content away from the origin is lost).
+	origins = weighted(w(70, hegel.Just(true)), w(unless(known.CompositorDrawsAbsolute, 30), hegel.Just(false)))
+	// crowds: twelve to sixteen single-cell layers at the origin (lipgloss/22: equal-z
+	// layers drawn out of insertion order past twelve elements, the compositor's root
+	// among them).
+	crowds    = crowdsOf(12, 16)
+	treeCases = hegel.Composite(func(tc hegel.TestCase) compositorCase {
+		roots := append([]layerSpec{hegel.Draw(tc, anchorLayers)}, hegel.Draw(tc, counted(layers, 0, 3))...)
+		return compositorCase{
+			roots:    roots,
+			atOrigin: hegel.Draw(tc, origins),
+			hits:     hegel.Draw(tc, hegel.Lists(hits).MinSize(6).MaxSize(6)),
+		}
+	})
+	crowdCases = hegel.Composite(func(tc hegel.TestCase) compositorCase {
+		return compositorCase{
+			roots:    hegel.Draw(tc, crowds),
+			atOrigin: true,
+			hits:     hegel.Draw(tc, hegel.Lists(hits).MinSize(6).MaxSize(6)),
+		}
+	})
+	compositorCases = weighted(w(100, treeCases), w(unless(known.CompositorOrderPastTwelve, 15), crowdCases))
+)
+
+// crowdsOf is lo to hi single-cell layers at the origin with z 0..3, each with an ID.
+func crowdsOf(lo, hi int) hegel.Generator[[]layerSpec] {
+	return hegel.Map(counted(hegel.Integers(0, 3), lo, hi), func(zs []int) []layerSpec {
+		ls := make([]layerSpec, len(zs))
+		for i, z := range zs {
+			ls[i] = layerSpec{z: z, hasID: true, lines: []string{string(rune('a' + i))}}
+		}
+		return ls
+	})
+}
+
+type flatLayer struct {
+	spec   layerSpec
+	absX   int
+	absY   int
+	bounds image.Rectangle
+}
+
+func (f flatLayer) String() string {
+	return fmt.Sprintf("{%s at %d,%d %v}", f.spec.GoString(), f.absX, f.absY, f.bounds)
+}
+
+func flatten(l layerSpec, px, py int, out *[]flatLayer) {
+	ax, ay := l.x+px, l.y+py
+	content := l.content()
+	w, h := Width(content), Height(content)
+	*out = append(*out, flatLayer{l, ax, ay, image.Rect(ax, ay, ax+w, ay+h)})
+	for _, c := range l.children {
+		flatten(c, ax, ay, out)
+	}
+}
+
+// checkCompositor paints the layer tree by z then insertion order and compares the result
+// with Compositor.Render (after TrimSpace), Bounds, the layers' sizes and Hit. Render draws
+// at absolute coordinates on a canvas sized to the bounds (lipgloss/19) and sorts equal-z
+// layers unstably past twelve (lipgloss/22): the shapes are named on a mismatch, and under
+// HEGEL_NO_KNOWN=1 the rendering and hits are not compared there.
+func checkCompositor(ht *hegel.T, c compositorCase, sh shapes) {
+	roots := c.layout()
+	var built []*Layer
+	var flat []flatLayer
+	for _, r := range roots {
+		built = append(built, r.build())
+		flatten(r, 0, 0, &flat)
+	}
+	comp := NewCompositor(built...)
+	// Bounds: the union of every layer's rectangle (the root is empty at the origin).
+	bounds := image.Rect(0, 0, 0, 0)
+	for _, f := range flat {
+		bounds = bounds.Union(f.bounds)
+	}
+	if bounds.Empty() {
+		// Every layer is empty (no content): the union of empty rectangles is
+		// whichever one image.Rectangle.Union keeps, a position without meaning.
+		count("empty-bounds")
+	} else if comp.Bounds() != bounds {
+		fail(ht, "Bounds() = %v, the union of the layers is %v", comp.Bounds(), bounds)
+	}
+	// Layer sizes are their own union bounds.
+	for i, r := range roots {
+		var sub []flatLayer
+		flatten(r, 0, 0, &sub)
+		u := sub[0].bounds
+		for _, f := range sub {
+			u = u.Union(f.bounds)
+		}
+		if built[i].Width() != u.Dx() || built[i].Height() != u.Dy() {
+			fail(ht, "layer %d is %dx%d, its union bounds are %v", i, built[i].Width(), built[i].Height(), u)
+		}
+	}
+	// Paint: by z, ties in insertion order, later on top.
+	w, h := bounds.Dx(), bounds.Dy()
+	grid := make([][]mcell, h)
+	for y := range grid {
+		grid[y] = make([]mcell, w)
+		for x := range grid[y] {
+			grid[y][x] = mcell{g: " ", w: 1}
+		}
+	}
+	top := make([][]string, h)
+	for y := range top {
+		top[y] = make([]string, w)
+	}
+	for z := 0; z <= 3; z++ {
+		for _, f := range flat {
+			if f.spec.z != z {
+				continue
+			}
+			// A layer is a rectangle: short lines are padded with blank cells.
+			lw := f.bounds.Dx()
+			for cy, row := range parseCells(f.spec.content()) {
+				x := f.absX - bounds.Min.X
+				y := f.absY + cy - bounds.Min.Y
+				for _, cell := range row {
+					if y >= 0 && y < h && x >= 0 && x+cell.w <= w {
+						grid[y][x] = cell
+						for k := 1; k < cell.w; k++ {
+							grid[y][x+k] = mcell{g: "", w: 0}
+						}
+					}
+					x += cell.w
+				}
+				for ; x < f.absX-bounds.Min.X+lw; x++ {
+					if y >= 0 && y < h && x >= 0 && x < w {
+						grid[y][x] = mcell{g: " ", w: 1}
+					}
+				}
+			}
+			// Hit testing sees the whole rectangle, blank cells included.
+			if f.spec.id != "" {
+				for y := f.bounds.Min.Y; y < f.bounds.Max.Y; y++ {
+					for x := f.bounds.Min.X; x < f.bounds.Max.X; x++ {
+						if y-bounds.Min.Y < h && x-bounds.Min.X < w {
+							top[y-bounds.Min.Y][x-bounds.Min.X] = f.spec.id
+						}
+					}
+				}
+			}
+		}
+	}
+	out := comp.Render()
+	offOrigin := bounds.Min != (image.Point{})
+	crowded := len(flat) >= 12 // the compositor's own root makes thirteen
+	sh.Add("lipgloss/19", offOrigin)
+	sh.Add("lipgloss/22", crowded)
+	skipRender := (known.CompositorDrawsAbsolute && offOrigin) || (known.CompositorOrderPastTwelve && crowded)
+	if skipRender {
+		if offOrigin {
+			count("lipgloss/19-shape")
+		}
+		if crowded {
+			count("lipgloss/22-shape")
+		}
+	} else {
+		// TrimSpace drops trailing blanks that carry no style.
+		var want []string
+		for y := range grid {
+			row := grid[y]
+			for len(row) > 0 && row[len(row)-1].g == " " && row[len(row)-1].st == (mstyle{}) {
+				row = row[:len(row)-1]
+			}
+			var sb strings.Builder
+			for _, cell := range row {
+				sb.WriteString(cell.g)
+			}
+			want = append(want, sb.String())
+		}
+		got := strings.Split(out, "\n")
+		for i := range got {
+			got[i] = ansi.Strip(got[i])
+		}
+		for len(want) > len(got) && strings.TrimSpace(want[len(want)-1]) == "" {
+			want = want[:len(want)-1]
+		}
+		if strings.Join(got, "\n") != strings.Join(want, "\n") {
+			mismatch(ht, sh, "Render() =\n%s\nmodel\n%s\nlayers %v", strings.Join(got, "\n"), strings.Join(want, "\n"), flat)
+		}
+		// Styles: a painted cell keeps its background.
+		rows := parseCells(out)
+		for y := range rows {
+			x := 0
+			for _, cell := range rows[y] {
+				if x < w && grid[y][x].w > 0 && !colorEqual(cell.st.bg, grid[y][x].st.bg) {
+					mismatch(ht, sh, "cell (%d,%d) has bg %v, model %v:\n%s", x, y, cell.st.bg, grid[y][x].st.bg, out)
+				}
+				x += cell.w
+			}
+		}
+	}
+	// Hit tests over the bounds and a margin around them.
+	if !(known.CompositorOrderPastTwelve && crowded) {
+		for _, p := range c.hits {
+			x := bounds.Min.X - 1 + p.dx%(bounds.Dx()+2)
+			y := bounds.Min.Y - 1 + p.dy%(bounds.Dy()+2)
+			want := ""
+			if x >= bounds.Min.X && y >= bounds.Min.Y && x < bounds.Max.X && y < bounds.Max.Y {
+				want = top[y-bounds.Min.Y][x-bounds.Min.X]
+			}
+			if got := comp.Hit(x, y).ID(); got != want {
+				mismatch(ht, sh, "Hit(%d,%d) = %q, model %q; layers %v", x, y, got, want, flat)
+			}
+		}
+	}
+	count("ok")
+}
+
+// TestHegelCompositorPaintsLayersInOrder: Compositor.Render/Bounds/Hit and Layer.Width/Height
+// against the paint model.
+func TestHegelCompositorPaintsLayersInOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkCompositor(ht, hegel.Draw(ht, compositorCases), nil)
+	})
+}
+
+// lipgloss/19: Compositor.Render makes a canvas of the bounds' size and draws every layer at
+// its absolute position, so a layer tree that does not start at the origin renders shifted
+// off the canvas - nothing at all when it starts below and to the right.
+func TestHegelPinCompositorRenderDropsContentAwayFromTheOrigin(t *testing.T) {
+	defer guard(t)
+	c := NewCompositor(NewLayer("ab").X(3).Y(2))
+	out := c.Render()
+	if strings.Contains(out, "ab") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("NewCompositor(NewLayer(\"ab\").X(3).Y(2)).Render() = %q (bounds %v)", out, c.Bounds())
+}
+
+// lipgloss/22: Compositor.flatten orders the layers with slices.SortFunc by z, which is not
+// a stable sort: up to twelve elements it is an insertion sort and equal-z layers keep their
+// insertion order (later on top, as Canvas documents), from thirteen - the compositor's
+// root counts - the pattern-defeating quicksort reorders them, so which of two overlapping
+// equal-z layers is drawn on top (and hit first) depends on how many layers there are.
+func TestHegelPinCompositorDrawOrderIsUnstablePastTwelveLayers(t *testing.T) {
+	defer guard(t)
+	zs := []int{2, 0, 1, 0, 2, 2, 2, 1, 1, 0, 1, 0, 1}
+	var ls []*Layer
+	for i, z := range zs {
+		id := string(rune('a' + i))
+		ls = append(ls, NewLayer(id).ID(id).Z(z))
+	}
+	c := NewCompositor(ls...)
+	out := c.Render()
+	if out == "g" && c.Hit(0, 0).ID() == "g" {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("13 single-cell layers at the origin with z %v: Render() = %q, Hit(0,0) = %q; the last layer with z 2 is g (12 layers keep the order)", zs, out, c.Hit(0, 0).ID())
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..a0da13b
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,377 @@
+package lipgloss
+
+// One narrow property per recorded bug of the root package: each draws the bug's shape
+// region with random contents and judges it by the same model as the wide property, so by
+// default it fails naming the bug; under HEGEL_NO_KNOWN=1 it draws the neighbouring region
+// and passes.
+
+import (
+	"image/color"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- Render (1-4, 6, 7)
+
+// spaceStylerStyles: a style on the rune-by-rune space styler path (an underline or a
+// strikethrough), without a hyperlink or reverse, so that only the cluster shape is met.
+var spaceStylerStyles = hegel.Composite(func(tc hegel.TestCase) styleSpec {
+	sp := hegel.Draw(tc, styles)
+	if hegel.Draw(tc, chance(50)) {
+		sp.underline = &underlineSpec{style: ansi.UnderlineSingle, viaBool: true}
+	} else {
+		sp.strike = true
+	}
+	sp.link, sp.reverse = nil, false
+	return sp
+})
+
+// withCluster puts a cluster grapheme into the text at a drawn position (modulo the live
+// sizes).
+type withCluster struct {
+	text    textSpec
+	cluster string
+	at      int
+}
+
+var clusteredTexts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) withCluster {
+	return withCluster{
+		text:    hegel.Draw(tc, plainTexts),
+		cluster: hegel.Draw(tc, pick(clusterGraphemes[0], clusterGraphemes[1])),
+		at:      hegel.Draw(tc, hegel.Integers(0, 40)),
+	}
+}), func(c withCluster) textSpec {
+	t := make(textSpec, len(c.text))
+	copy(t, c.text)
+	y := c.at % len(t)
+	gs := append(textLine(nil), t[y].gs...)
+	x := c.at % (len(gs) + 1)
+	gs = append(gs[:x], append(textLine{c.cluster}, gs[x:]...)...)
+	t[y].gs = gs
+	return t
+})
+
+// TestHegelClustersSurviveTheSpaceStyler: a text with a grapheme cluster under an underline
+// or strikethrough style keeps its clusters (lipgloss/1); under HEGEL_NO_KNOWN=1 the same
+// styles on texts without clusters.
+func TestHegelClustersSurviveTheSpaceStyler(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, spaceStylerStyles)
+		texts := clusteredTexts
+		if known.SpaceStylerTearsClusters {
+			texts = plainTexts
+		}
+		checkRender(ht, sp, hegel.Draw(ht, texts), nil)
+	})
+}
+
+// spacedTexts: a plain text with a space put in at a drawn position.
+var spacedTexts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) withCluster {
+	return withCluster{text: hegel.Draw(tc, plainTexts), cluster: " ", at: hegel.Draw(tc, hegel.Integers(0, 40))}
+}), func(c withCluster) textSpec {
+	t := make(textSpec, len(c.text))
+	copy(t, c.text)
+	y := c.at % len(t)
+	gs := append(textLine(nil), t[y].gs...)
+	x := c.at % (len(gs) + 1)
+	gs = append(gs[:x], append(textLine{c.cluster}, gs[x:]...)...)
+	t[y].gs = gs
+	return t
+})
+
+// TestHegelReverseReachesStyledSpaces: Reverse(true) with an underline or strikethrough
+// shows the spaces reversed too (lipgloss/2); under HEGEL_NO_KNOWN=1 Reverse without the
+// space styler.
+func TestHegelReverseReachesStyledSpaces(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, spaceStylerStyles)
+		sp.reverse = true
+		if known.ReverseDroppedOnSpaces {
+			sp.underline, sp.strike, sp.ulSpaces, sp.strikeSpaces = nil, false, nil, nil
+		}
+		checkRender(ht, sp, hegel.Draw(ht, spacedTexts), nil)
+	})
+}
+
+// TestHegelSpacesTakeTheTextsUnderlineStyle: a double, curly, dotted or dashed underline
+// underlines the spaces the same way (lipgloss/3); under HEGEL_NO_KNOWN=1 a single underline.
+func TestHegelSpacesTakeTheTextsUnderlineStyle(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, styles)
+		sp.underline = &underlineSpec{style: ansi.Underline(hegel.Draw(ht, hegel.Integers(2, 5)))}
+		if known.SpacesUnderlinedSingle {
+			sp.underline = &underlineSpec{style: ansi.UnderlineSingle}
+		}
+		sp.link, sp.reverse = nil, false
+		checkRender(ht, sp, hegel.Draw(ht, spacedTexts), nil)
+	})
+}
+
+// TestHegelHyperlinksCoverTextOnly: a hyperlink on a multi-line block covers the text cells
+// only, not the padding, alignment, border or margin between the lines (lipgloss/4); under
+// HEGEL_NO_KNOWN=1 a hyperlink on a single line with inline attributes only.
+func TestHegelHyperlinksCoverTextOnly(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, styles)
+		sp.link = ptrOf(hegel.Draw(ht, links))
+		sp.underline, sp.strike, sp.ulSpaces, sp.strikeSpaces = nil, false, nil, nil
+		sp.alignH, sp.alignV = nil, nil
+		texts := textsOf(plainGrapheme)
+		if known.HyperlinkCoversWhitespace {
+			sp = styleSpec{bold: sp.bold, italic: sp.italic, fg: sp.fg, bg: sp.bg, link: sp.link}
+			texts = hegel.Map(textsOf(plainGrapheme), func(t textSpec) textSpec { return t[:1] })
+		}
+		checkRender(ht, sp, hegel.Draw(ht, texts), nil)
+	})
+}
+
+func ptrOf[T any](v T) *T { return &v }
+
+// TestHegelHeightHoldsUnderFractionalAlign: a Height with a fractional vertical alignment
+// pads the block to the height (lipgloss/6); under HEGEL_NO_KNOWN=1 the constants.
+func TestHegelHeightHoldsUnderFractionalAlign(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, styles)
+		sp.height = ptrOf(hegel.Draw(ht, hegel.Integers(1, 6)))
+		sp.alignV = ptrOf(hegel.Draw(ht, fractions))
+		if known.HeightIgnoredForFractionAlign {
+			sp.alignV = ptrOf(hegel.Draw(ht, constantsV))
+		}
+		sp.alignH, sp.link, sp.underline, sp.strike = nil, nil, nil, false
+		checkRender(ht, sp, hegel.Draw(ht, plainTexts), nil)
+	})
+}
+
+// TestHegelFractionalHorizontalAlignIsHonoured: a fractional horizontal alignment places
+// each line after round(gap*pos) columns (lipgloss/7); under HEGEL_NO_KNOWN=1 the constants.
+func TestHegelFractionalHorizontalAlignIsHonoured(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, styles)
+		sp.alignH = ptrOf(hegel.Draw(ht, fractions))
+		if known.FractionalAlignIsLeft {
+			sp.alignH = ptrOf(hegel.Draw(ht, constantsH))
+		}
+		sp.alignV, sp.link, sp.underline, sp.strike = nil, nil, nil, false
+		checkRender(ht, sp, hegel.Draw(ht, plainTexts), nil)
+	})
+}
+
+// ---------------------------------------------------------------- Place (5)
+
+// TestHegelFractionalPlacePositionsAreNotMirrored: Place at a fractional position puts
+// round(gap*pos) of the whitespace before the block (lipgloss/5); under HEGEL_NO_KNOWN=1 the
+// constants.
+func TestHegelFractionalPlacePositionsAreNotMirrored(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		positions := fractions
+		if known.PlaceMirrorsFractions {
+			positions = pick(Left, Center, Right)
+		}
+		checkPlace(ht, hegel.Draw(ht, placeCasesOf(positions)), nil)
+	})
+}
+
+// ---------------------------------------------------------------- Compositor (19, 22)
+
+// TestHegelCompositorDrawsAwayFromTheOrigin: a layer tree whose first root sits away from the
+// origin renders its content (lipgloss/19); under HEGEL_NO_KNOWN=1 the root at the origin.
+func TestHegelCompositorDrawsAwayFromTheOrigin(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		c.atOrigin = known.CompositorDrawsAbsolute
+		if !c.atOrigin {
+			c.roots[0].x = hegel.Draw(ht, hegel.Integers(1, 8))
+			c.roots[0].y = hegel.Draw(ht, hegel.Integers(1, 4))
+		}
+		checkCompositor(ht, c, nil)
+	})
+}
+
+// TestHegelEqualZLayersKeepInsertionOrder: twelve to sixteen equal-z layers at the origin
+// are drawn later on top (lipgloss/22); under HEGEL_NO_KNOWN=1 two to eleven.
+func TestHegelEqualZLayersKeepInsertionOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		lo, hi := 12, 16
+		if known.CompositorOrderPastTwelve {
+			lo, hi = 2, 11
+		}
+		c := compositorCase{
+			roots:    hegel.Draw(ht, crowdsOf(lo, hi)),
+			atOrigin: true,
+			hits:     hegel.Draw(ht, hegel.Lists(hits).MinSize(6).MaxSize(6)),
+		}
+		checkCompositor(ht, c, nil)
+	})
+}
+
+// ---------------------------------------------------------------- blends (23-25, 27-29)
+
+// brightRGBs: an opaque colour with every channel at 32 or more, so a ramp between two of
+// them never passes through the near-black intensities of lipgloss/28.
+var brightRGBs = hegel.Map(rgbTriples, func(t [3]int) color.Color {
+	return color.RGBA{uint8(32 + t[0]%224), uint8(32 + t[1]%224), uint8(32 + t[2]%224), 255}
+})
+
+// opaqueRings: two to five bright stops, the ring of lipgloss/23's shape.
+var opaqueRings = counted(brightRGBs, 2, 5)
+
+// TestHegelBorderBlendsReachEveryCorner: a blend over all four sides steps by one ring colour
+// at every corner (lipgloss/23); under HEGEL_NO_KNOWN=1 borders without a right side.
+func TestHegelBorderBlendsReachEveryCorner(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, borderBlendCases)
+		c.stops = hegel.Draw(ht, opaqueRings)
+		c.sides = nil
+		c.w = hegel.Draw(ht, hegel.Integers(1, 8))
+		if known.BorderBlendSkipsRightCorners {
+			c.sides = &[4]bool{hegel.Draw(ht, chance(70)), false, hegel.Draw(ht, chance(70)), true}
+		}
+		checkBorderBlend(ht, c, nil)
+	})
+}
+
+// shortRamps: four to six opaque stops with fewer than two steps per segment
+// (lipgloss/24); under HEGEL_NO_KNOWN=1 two steps per segment at least.
+var shortRamps = hegel.Composite(func(tc hegel.TestCase) blend1DCase {
+	stops := hegel.Draw(tc, counted(rgbs, 4, 6))
+	segments := len(stops) - 1
+	steps := hegel.Draw(tc, hegel.Integers(len(stops)+1, 2*segments-1))
+	if known.Blend1DDropsLastStop {
+		steps = hegel.Draw(tc, hegel.Integers(2*segments, 40))
+	}
+	return blend1DCase{steps: steps, stops: stops}
+})
+
+// TestHegelBlend1DKeepsTheLastStop: a ramp with fewer than two steps per segment still ends
+// at the last stop.
+func TestHegelBlend1DKeepsTheLastStop(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, shortRamps)
+		got := Blend1D(c.steps, c.stops...)
+		last := opaque(c.stops[len(c.stops)-1])
+		var sh shapes
+		sh.Add("lipgloss/24", c.steps/(len(c.stops)-1) < 2)
+		if len(got) != c.steps {
+			fail(ht, "Blend1D(%d, %s) has %d colours", c.steps, hexes(c.stops), len(got))
+		}
+		if !closeColor(got[len(got)-1], last) {
+			mismatch(ht, sh, "Blend1D(%d, %s) ends at %s, not at the last stop: %s", c.steps, hexes(c.stops), hexOf(got[len(got)-1]), hexes(got))
+		}
+		count("ok")
+	})
+}
+
+// TestHegelBlend2DReachesTheLastStop: a one-row gradient with two steps per segment at
+// least ends at the last stop (lipgloss/25); under HEGEL_NO_KNOWN=1 the far end is counted
+// and the near end checked, as in the wide property.
+func TestHegelBlend2DReachesTheLastStop(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		stops := hegel.Draw(ht, counted(rgbs, 2, 4))
+		w := hegel.Draw(ht, hegel.Integers(2*(len(stops)-1), 40))
+		checkEnds(ht, endsCase{w: w, stops: stops}, nil)
+	})
+}
+
+// rightAngleCases: a one-row gradient at 270 degrees or a one-column one at 180, an odd
+// number of cells (so the centre lands on a ramp index: lipgloss/27); under
+// HEGEL_NO_KNOWN=1 the same at 0 and 90 degrees.
+var rightAngleCases = hegel.Composite(func(tc hegel.TestCase) blend2DCase {
+	n := 2*hegel.Draw(tc, hegel.Integers(1, 6)) + 1
+	stops := hegel.Draw(tc, counted(rgbs, 2, 3))
+	if hegel.Draw(tc, chance(50)) {
+		angle := 270.0
+		if known.Blend2DRightAnglesInexact {
+			angle = 90
+		}
+		return blend2DCase{w: n, h: 1, angle: angle, stops: stops}
+	}
+	angle := 180.0
+	if known.Blend2DRightAnglesInexact {
+		angle = 0
+	}
+	return blend2DCase{w: 1, h: n, angle: angle, stops: stops}
+})
+
+// TestHegelBlend2DRightAnglesAreExact: a gradient across the rows is constant along each row.
+func TestHegelBlend2DRightAnglesAreExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rightAngleCases)
+		got := Blend2D(c.w, c.h, c.angle, c.stops...)
+		var sh shapes
+		sh.Add("lipgloss/27", c.angle == 180 || c.angle == 270)
+		for i, col := range got {
+			if !closeColor(col, got[0]) {
+				mismatch(ht, sh, "Blend2D(%d,%d,%v, %s), a gradient across its %d cells, is not uniform: %s (cell %d)", c.w, c.h, c.angle, hexes(c.stops), len(got), hexes(got), i)
+			}
+		}
+		count("ok")
+	})
+}
+
+// darkStops: a stop with a zero channel next to a dark one, so the ramp passes through
+// intensities under 1/255 (lipgloss/28); under HEGEL_NO_KNOWN=1 every channel at 32 or more.
+var darkStops = hegel.Composite(func(tc hegel.TestCase) []color.Color {
+	if known.DarkChannelsRenderBright {
+		return hegel.Draw(tc, counted(brightRGBs, 2, 3))
+	}
+	zero := hegel.Draw(tc, hegel.Integers(0, 2))
+	t := hegel.Draw(tc, rgbTriples)
+	t[zero] = 0
+	d := hegel.Draw(tc, rgbTriples)
+	d[zero] = 1 + d[zero]%24
+	a := color.RGBA{uint8(t[0]), uint8(t[1]), uint8(t[2]), 255}
+	b := color.RGBA{uint8(d[0]), uint8(d[1]), uint8(d[2]), 255}
+	if hegel.Draw(tc, chance(50)) {
+		return []color.Color{a, b}
+	}
+	return []color.Color{b, a}
+})
+
+// TestHegelDarkChannelsStayDark: a border blend through near-black intensities writes them
+// dark; the border has no right side so the corner jump of lipgloss/23 is not met.
+func TestHegelDarkChannelsStayDark(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, borderBlendCases)
+		c.stops = hegel.Draw(ht, darkStops)
+		c.sides = &[4]bool{true, false, true, true}
+		c.w = hegel.Draw(ht, hegel.Integers(4, 8))
+		checkBorderBlend(ht, c, nil)
+	})
+}
+
+// TestHegelAllNilBlendsRender: a border blend whose stops are all nil renders a plain border
+// (lipgloss/29); under HEGEL_NO_KNOWN=1 rings with a colour among the nils.
+func TestHegelAllNilBlendsRender(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, borderBlendCases)
+		c.stops = hegel.Draw(ht, nilRings)
+		if known.AllNilBlendPanics {
+			c.stops = hegel.Draw(ht, hegel.Map(hegel.Composite(func(tc hegel.TestCase) []color.Color {
+				ring := hegel.Draw(tc, nilRings)
+				ring[hegel.Draw(tc, hegel.Integers(0, 10))%len(ring)] = hegel.Draw(tc, rgbs)
+				return ring
+			}), func(r []color.Color) []color.Color { return r }))
+		}
+		checkBorderBlend(ht, c, nil)
+	})
+}
+
+// ---------------------------------------------------------------- StyleRunes (26)
+
+// TestHegelStyleRunesKeepsMultiLineStrings: StyleRunes on a string of two or three lines
+// shows the string as it is (lipgloss/26); under HEGEL_NO_KNOWN=1 single lines.
+func TestHegelStyleRunesKeepsMultiLineStrings(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		lo, hi := 2, 3
+		if known.StyleRunesPadsMultiLine {
+			lo, hi = 1, 1
+		}
+		lines := hegel.Map(counted(weighted(w(80, narrowGrapheme), w(15, hegel.Just(" ")), w(5, wideGrapheme)), 0, 6), func(gs []string) string { return strings.Join(gs, "") })
+		c := hegel.Draw(ht, runesCasesOf(narrowGrapheme))
+		c.str = strings.Join(hegel.Draw(ht, counted(lines, lo, hi)), "\n")
+		checkStyleRunes(ht, c, nil)
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..eb33d0d
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2048 @@
+package lipgloss
+
+// Hegel property tests for charm.land/lipgloss/v2 (hegel-zoo target go/lipgloss).
+//
+// Style.Render is checked against a cell model of the documented layout rules: the text is
+// split into graphemes, wrapped, styled, padded, sized, aligned, bordered and margined the way
+// the README and the method docs describe, and the rendered string is parsed back into cells
+// (graphemes with the SGR pen and hyperlink in force) and compared cell by cell. Join*,
+// Place*, Wrap, StyleRanges, Inherit and the size helpers have their own models.
+//
+// The generators are package-level values: a style is a record of optional property records
+// with a pure apply() producing the Style, a text is a list of lines of grapheme records
+// rendered by a pure function, and every choice puts the plain alternative first. The shapes
+// of the recorded bugs (bugs.toml) are drawn as steady alternatives and a property that meets
+// one fails naming the bug (mismatch); HEGEL_NO_KNOWN=1 (zootest.Known) switches the shapes
+// off for a run that looks past the known bugs. hegel_shapes_test.go has one narrow property
+// per bug; the pins at the end of each file are the regression examples.
+
+import (
+	"fmt"
+	"image/color"
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/lipgloss/v2/internal/zootest"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+// The harness and the LIPGLOSS_COLLECT collector are zootest's (shared with the table and
+// tree packages); these are the local spellings.
+
+func hegelOpts() []hegel.Option { return zootest.HegelOpts() }
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	zootest.Property(t, fn)
+}
+
+func fail(ht *hegel.T, format string, args ...any) { zootest.Fail(ht, format, args...) }
+
+func count(name string) { zootest.Count(name) }
+
+func note(ht *hegel.T, format string, args ...any) { zootest.Note(ht, format, args...) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// mismatch reports a disagreement with the model on a case whose known shapes are named:
+// counted, assumed away under HEGEL_NO_KNOWN=1, failed naming the bug by default.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	zootest.Mismatch(ht, shapes, format, args...)
+}
+
+var known = &zootest.Known
+
+type shapes = zootest.Shapes
+
+// Generator idioms (zootest): weighted choice shrinking to the first alternative, the biased
+// coin shrinking to false, maybe with the absent value first, a small table, a counted list.
+
+func weighted[T any](choices ...zootest.Choice[T]) hegel.Generator[T] {
+	return zootest.Weighted(choices...)
+}
+
+func w[T any](weight int, g hegel.Generator[T]) zootest.Choice[T] { return zootest.W(weight, g) }
+
+func unless(sw bool, weight int) int { return zootest.Unless(sw, weight) }
+
+func chance(pct int) hegel.Generator[bool] { return zootest.Chance(pct) }
+
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] { return zootest.Maybe(pct, g) }
+
+func pick[T any](xs ...T) hegel.Generator[T] { return zootest.Pick(xs...) }
+
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return zootest.Counted(g, lo, hi)
+}
+
+// ptr is the drawn value behind a pointer (an optional record is a nil or set pointer).
+func ptr[T any](g hegel.Generator[T]) hegel.Generator[*T] {
+	return hegel.Map(g, func(v T) *T { return &v })
+}
+
+// ---------------------------------------------------------------- cells and SGR
+
+const (
+	aBold uint8 = 1 << iota
+	aFaint
+	aItalic
+	aBlink
+	aRapidBlink
+	aReverse
+	aConceal
+	aStrike
+)
+
+// mstyle is the pen: what an SGR-reading terminal holds for a cell.
+type mstyle struct {
+	fg, bg, ul color.Color
+	attrs      uint8
+	under      ansi.Underline
+}
+
+func (s mstyle) String() string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b under:%d}", s.fg, s.bg, s.ul, s.attrs, s.under)
+}
+
+func colorEqual(c, o color.Color) bool {
+	if c == nil && o == nil {
+		return true
+	}
+	if c == nil || o == nil {
+		return false
+	}
+	cr, cg, cb, ca := c.RGBA()
+	or, og, ob, oa := o.RGBA()
+	return cr == or && cg == og && cb == ob && ca == oa
+}
+
+// mcell is one screen cell: a grapheme with its width, pen and hyperlink.
+type mcell struct {
+	g    string
+	w    int
+	st   mstyle
+	link string // URL
+	lp   string // link params
+}
+
+func (c mcell) String() string {
+	s := fmt.Sprintf("{%q w%d %s", c.g, c.w, c.st)
+	if c.link != "" {
+		s += fmt.Sprintf(" link=%s;%s", c.lp, c.link)
+	}
+	return s + "}"
+}
+
+// applySGR applies one SGR parameter list to st following ECMA-48 and the xterm/kitty colour
+// and underline extensions.
+func applySGR(params []ansi.Param, st *mstyle) {
+	if len(params) == 0 {
+		*st = mstyle{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		p := params[i]
+		v := p.Param(0)
+		switch {
+		case v == 0:
+			*st = mstyle{}
+		case v == 1:
+			st.attrs |= aBold
+		case v == 2:
+			st.attrs |= aFaint
+		case v == 3:
+			st.attrs |= aItalic
+		case v == 4:
+			if p.HasMore() && i+1 < len(params) {
+				i++
+				st.under = ansi.Underline(params[i].Param(1))
+			} else {
+				st.under = ansi.UnderlineSingle
+			}
+		case v == 5:
+			st.attrs |= aBlink
+		case v == 6:
+			st.attrs |= aRapidBlink
+		case v == 7:
+			st.attrs |= aReverse
+		case v == 8:
+			st.attrs |= aConceal
+		case v == 9:
+			st.attrs |= aStrike
+		case v == 22:
+			st.attrs &^= aBold | aFaint
+		case v == 23:
+			st.attrs &^= aItalic
+		case v == 24:
+			st.under = ansi.UnderlineNone
+		case v == 25:
+			st.attrs &^= aBlink | aRapidBlink
+		case v == 27:
+			st.attrs &^= aReverse
+		case v == 28:
+			st.attrs &^= aConceal
+		case v == 29:
+			st.attrs &^= aStrike
+		case v >= 30 && v <= 37:
+			st.fg = ansi.BasicColor(v - 30)
+		case v == 39:
+			st.fg = nil
+		case v >= 40 && v <= 47:
+			st.bg = ansi.BasicColor(v - 40)
+		case v == 49:
+			st.bg = nil
+		case v == 59:
+			st.ul = nil
+		case v >= 90 && v <= 97:
+			st.fg = ansi.BasicColor(v - 90 + 8)
+		case v >= 100 && v <= 107:
+			st.bg = ansi.BasicColor(v - 100 + 8)
+		case v == 38 || v == 48 || v == 58:
+			end := i
+			for end+1 < len(params) && params[end].HasMore() {
+				end++
+			}
+			run := params[i : end+1]
+			if len(run) == 1 {
+				run = params[i:min(len(params), i+5)]
+				if len(run) > 1 && run[1].Param(0) == 5 {
+					run = run[:3]
+				}
+				end = i + len(run) - 1
+			}
+			var c color.Color
+			switch {
+			case len(run) >= 3 && run[1].Param(0) == 5:
+				c = ansi.ExtendedColor(run[2].Param(0))
+			case len(run) == 6 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[3].Param(0)), G: uint8(run[4].Param(0)), B: uint8(run[5].Param(0)), A: 0xff}
+			case len(run) >= 5 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[2].Param(0)), G: uint8(run[3].Param(0)), B: uint8(run[4].Param(0)), A: 0xff}
+			}
+			switch v {
+			case 38:
+				st.fg = c
+			case 48:
+				st.bg = c
+			default:
+				st.ul = c
+			}
+			i = end
+		}
+	}
+}
+
+// parseCells replays a rendered string onto rows of cells: text lands with the pen and link
+// in force, SGR and OSC 8 move the pen, "\n" starts a row. Zero-width graphemes (a combining
+// mark separated from its base by a sequence) become cells of width 0.
+func parseCells(out string) [][]mcell {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st mstyle
+	var link, lp string
+	var state byte
+	rows := [][]mcell{{}}
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			parts := strings.SplitN(string(p.Data()), ";", 3)
+			if len(parts) == 3 {
+				lp, link = parts[1], parts[2]
+			}
+		case sq == "\n":
+			rows = append(rows, []mcell{})
+		case sq == "\r":
+			// Left in place: the model never expects one.
+			rows[len(rows)-1] = append(rows[len(rows)-1], mcell{g: "\r", w: 0, st: st, link: link, lp: lp})
+		case ansi.HasEscPrefix(sq) || ansi.HasCsiPrefix(sq) || ansi.HasOscPrefix(sq) || ansi.HasDcsPrefix(sq):
+			// Other sequences do not draw.
+		default:
+			rows[len(rows)-1] = append(rows[len(rows)-1], mcell{g: sq, w: w, st: st, link: link, lp: lp})
+		}
+		out = out[k:]
+		state = ns
+	}
+	return rows
+}
+
+func rowsString(rows [][]mcell) string {
+	var sb strings.Builder
+	for y, r := range rows {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range r {
+			sb.WriteString(" " + c.String())
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func rowsRow(r []mcell) string {
+	var sb strings.Builder
+	for _, c := range r {
+		sb.WriteString(" " + c.String())
+	}
+	return sb.String()
+}
+
+func rowsPlain(rows [][]mcell) string {
+	lines := make([]string, len(rows))
+	for y, r := range rows {
+		var sb strings.Builder
+		for _, c := range r {
+			sb.WriteString(c.g)
+		}
+		lines[y] = sb.String()
+	}
+	return strings.Join(lines, "\n")
+}
+
+func isSpaceCell(g string) bool {
+	return g == " " || g == " "
+}
+
+// sameCell compares two cells up to what a terminal shows: on a blank, bold, faint, italic,
+// blink and the foreground colour are invisible; an underline colour without an underline is
+// invisible everywhere.
+func sameCell(a, b mcell) bool {
+	if a.g != b.g || a.w != b.w || a.link != b.link || a.lp != b.lp {
+		return false
+	}
+	as, bs := a.st, b.st
+	if isSpaceCell(a.g) {
+		invisible := aBold | aFaint | aItalic | aBlink | aRapidBlink
+		as.attrs &^= invisible
+		bs.attrs &^= invisible
+		as.fg, bs.fg = nil, nil
+	}
+	if as.under == ansi.UnderlineNone {
+		as.ul = nil
+	}
+	if bs.under == ansi.UnderlineNone {
+		bs.ul = nil
+	}
+	return as.attrs == bs.attrs && as.under == bs.under && colorEqual(as.fg, bs.fg) && colorEqual(as.bg, bs.bg) && colorEqual(as.ul, bs.ul)
+}
+
+// compareRows fails on the first cell that differs, naming the case's known shapes.
+func compareRows(ht *hegel.T, what string, got, want [][]mcell, out string, sh shapes) {
+	if len(got) != len(want) {
+		mismatch(ht, sh, "%s: %d lines rendered, model has %d\nrendered %q\ngot   %q\nmodel %q", what, len(got), len(want), out, rowsPlain(got), rowsPlain(want))
+	}
+	for y := range want {
+		if len(got[y]) != len(want[y]) {
+			mismatch(ht, sh, "%s: line %d has %d cells, model has %d\nrendered %q\ngot   %q\nmodel %q", what, y, len(got[y]), len(want[y]), out, rowsPlain(got), rowsPlain(want))
+		}
+		for x := range want[y] {
+			if !sameCell(got[y][x], want[y][x]) {
+				mismatch(ht, sh, "%s: line %d cell %d is %s, model %s\nrendered %q\nrow got   %s\nrow model %s", what, y, x, got[y][x], want[y][x], out, rowsRow(got[y]), rowsRow(want[y]))
+			}
+		}
+	}
+}
+
+func rowWidth(r []mcell) int {
+	w := 0
+	for _, c := range r {
+		w += c.w
+	}
+	return w
+}
+
+// ---------------------------------------------------------------- graphemes and text
+
+var (
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "|", "+"}
+	wideGraphemes   = []string{"世", "界", "中", "😃", "Ａ"}
+	// Clusters of several runes; a style applied rune by rune tears them apart.
+	clusterGraphemes = []string{"ก้", "👨‍👩‍👧", "é"}
+)
+
+var (
+	narrowGrapheme  = pick(narrowGraphemes...)
+	wideGrapheme    = pick(wideGraphemes...)
+	clusterGrapheme = pick(clusterGraphemes...)
+	// plainGrapheme: a narrow grapheme, a wide one a quarter of the time.
+	plainGrapheme = weighted(w(75, narrowGrapheme), w(25, wideGrapheme))
+	// clusteredGrapheme: a plain grapheme, a cluster one time in ten.
+	clusteredGrapheme = weighted(w(90, plainGrapheme), w(10, clusterGrapheme))
+)
+
+func gwidth(g string) int { return ansi.StringWidth(g) }
+
+// textLine is one input line as graphemes.
+type textLine []string
+
+func (l textLine) String() string { return strings.Join(l, "") }
+
+// line is a drawn line: its graphemes and whether a CRLF (rather than LF) precedes it.
+type line struct {
+	gs   textLine
+	crlf bool
+}
+
+// textSpec is the text Render is given: one to four lines.
+type textSpec []line
+
+// String renders the text: lines joined by "\n", or by "\r\n" where the line asks for it.
+func (t textSpec) String() string {
+	var sb strings.Builder
+	for i, l := range t {
+		if i > 0 {
+			if l.crlf {
+				sb.WriteString("\r\n")
+			} else {
+				sb.WriteByte('\n')
+			}
+		}
+		sb.WriteString(l.gs.String())
+	}
+	return sb.String()
+}
+
+func (t textSpec) GoString() string { return fmt.Sprintf("%q", t.String()) }
+
+// lines is the text as grapheme lines, for the model.
+func (t textSpec) lines() []textLine {
+	out := make([]textLine, len(t))
+	for i, l := range t {
+		out[i] = l.gs
+	}
+	return out
+}
+
+// textGraphemesOf is a grapheme of the text: one of g, a space a fifth of the time, a tab
+// one time in twenty-five.
+func textGraphemesOf(g hegel.Generator[string]) hegel.Generator[string] {
+	return weighted(w(76, g), w(20, hegel.Just(" ")), w(4, hegel.Just("\t")))
+}
+
+// textsOf is one to four lines of zero to nine graphemes of g.
+func textsOf(g hegel.Generator[string]) hegel.Generator[textSpec] {
+	lines := hegel.Composite(func(tc hegel.TestCase) line {
+		return line{gs: hegel.Draw(tc, counted(textGraphemesOf(g), 0, 9)), crlf: hegel.Draw(tc, chance(15))}
+	})
+	return hegel.Map(counted(lines, 1, 4), func(ls []line) textSpec { return textSpec(ls) })
+}
+
+var (
+	// texts: the text of a Render case, clusters included.
+	texts = textsOf(clusteredGrapheme)
+	// plainTexts: the same without clusters (the region beside lipgloss/1).
+	plainTexts = textsOf(plainGrapheme)
+)
+
+// ---------------------------------------------------------------- colours
+
+var (
+	rgbTriples = hegel.Composite(func(tc hegel.TestCase) [3]int {
+		return [3]int{hegel.Draw(tc, hegel.Integers(0, 255)), hegel.Draw(tc, hegel.Integers(0, 255)), hegel.Draw(tc, hegel.Integers(0, 255))}
+	})
+	// colors: a named basic colour, an indexed one, a hex RGB one, an ansi.BasicColor.
+	colors = hegel.OneOf(
+		hegel.Map(pick("1", "9", "#ff0000", "#00ff00"), func(s string) color.Color { return Color(s) }),
+		hegel.Map(hegel.Integers(16, 255), func(i int) color.Color { return Color(strconv.Itoa(i)) }),
+		hegel.Map(rgbTriples, func(t [3]int) color.Color { return Color(fmt.Sprintf("#%02x%02x%02x", t[0], t[1], t[2])) }),
+		hegel.Map(hegel.Integers(0, 15), func(i int) color.Color { return ansi.BasicColor(i) }),
+	)
+)
+
+// ---------------------------------------------------------------- the style record
+
+// sides is top, right, bottom, left.
+type sides [4]int
+
+// underlineSpec: the underline style, set with Underline(true) (single) or UnderlineStyle.
+type underlineSpec struct {
+	style   ansi.Underline
+	viaBool bool
+}
+
+// borderSpec: the preset border, the sides when set explicitly (nil: BorderStyle, every
+// side), and the per-side colours when set (an entry may be nil).
+type borderSpec struct {
+	name   string
+	sides  *[4]bool // top, right, bottom, left
+	fg, bg *[4]color.Color
+}
+
+type linkSpec struct {
+	url, params string
+}
+
+// styleSpec is the drawn style: each property absent (nil, zero) or set. apply builds the
+// Style; the model reads the record.
+type styleSpec struct {
+	bold, italic, strike, reverse, blink, faint bool
+	underline                                   *underlineSpec
+	ulColor, fg, bg                             color.Color
+	width, height                               *int
+	alignH, alignV                              *Position
+	padding                                     *sides
+	padChar                                     rune
+	colorWS                                     *bool
+	margin                                      *sides
+	marBg                                       color.Color
+	marChar                                     rune
+	border                                      *borderSpec
+	inline                                      bool
+	maxWidth, maxHeight                         int
+	tabWidth                                    *int
+	ulSpaces, strikeSpaces                      *bool
+	link                                        *linkSpec
+	transform                                   bool
+}
+
+var borders = map[string]Border{
+	"normal": NormalBorder(), "rounded": RoundedBorder(), "block": BlockBorder(), "outerhalf": OuterHalfBlockBorder(),
+	"innerhalf": InnerHalfBlockBorder(), "thick": ThickBorder(), "double": DoubleBorder(), "hidden": HiddenBorder(),
+	"markdown": MarkdownBorder(), "ascii": ASCIIBorder(),
+}
+
+var borderNames = []string{"normal", "rounded", "block", "outerhalf", "innerhalf", "thick", "double", "hidden", "markdown", "ascii"}
+
+// fractional reports a position that is none of the three constants.
+func fractional(p Position) bool { return p != Left && p != Center && p != Right }
+
+var (
+	constantsH = pick(Left, Center, Right)
+	constantsV = pick(Top, Center, Bottom)
+	fractions  = pick(Position(0.25), 0.7, 0.1, 0.9)
+	// alignsH: a constant, or a fraction (lipgloss/7: treated as Left).
+	alignsH = weighted(w(100, constantsH), w(unless(known.FractionalAlignIsLeft, 25), fractions))
+	// alignsV: a constant, or a fraction (lipgloss/6: Height ignored).
+	alignsV = weighted(w(100, constantsV), w(unless(known.HeightIgnoredForFractionAlign, 25), fractions))
+
+	underlines = hegel.Composite(func(tc hegel.TestCase) underlineSpec {
+		if hegel.Draw(tc, chance(50)) {
+			return underlineSpec{style: ansi.Underline(hegel.Draw(tc, hegel.Integers(1, 5)))}
+		}
+		return underlineSpec{style: ansi.UnderlineSingle, viaBool: true}
+	})
+	fourSides = hegel.Composite(func(tc hegel.TestCase) sides {
+		return sides{hegel.Draw(tc, hegel.Integers(0, 2)), hegel.Draw(tc, hegel.Integers(0, 2)), hegel.Draw(tc, hegel.Integers(0, 2)), hegel.Draw(tc, hegel.Integers(0, 2))}
+	})
+	fourFlags = hegel.Composite(func(tc hegel.TestCase) [4]bool {
+		return [4]bool{hegel.Draw(tc, chance(70)), hegel.Draw(tc, chance(70)), hegel.Draw(tc, chance(70)), hegel.Draw(tc, chance(70))}
+	})
+	fourColors = hegel.Composite(func(tc hegel.TestCase) [4]color.Color {
+		return [4]color.Color{hegel.Draw(tc, maybe(60, colors)), hegel.Draw(tc, maybe(60, colors)), hegel.Draw(tc, maybe(60, colors)), hegel.Draw(tc, maybe(60, colors))}
+	})
+	borderSpecs = hegel.Composite(func(tc hegel.TestCase) borderSpec {
+		return borderSpec{
+			name:  hegel.Draw(tc, pick(borderNames...)),
+			sides: hegel.Draw(tc, maybe(50, ptr(fourFlags))),
+			fg:    hegel.Draw(tc, maybe(40, ptr(fourColors))),
+			bg:    hegel.Draw(tc, maybe(30, ptr(fourColors))),
+		}
+	})
+	links = hegel.Composite(func(tc hegel.TestCase) linkSpec {
+		return linkSpec{
+			url:    fmt.Sprintf("https://example.com/%d", hegel.Draw(tc, hegel.Integers(0, 9))),
+			params: hegel.Draw(tc, maybe(40, hegel.Map(hegel.Integers(0, 9), func(i int) string { return fmt.Sprintf("id=%d", i) }))),
+		}
+	})
+
+	// styles: every property absent most of the time.
+	styles = hegel.Composite(func(tc hegel.TestCase) styleSpec {
+		return styleSpec{
+			bold:         hegel.Draw(tc, chance(25)),
+			italic:       hegel.Draw(tc, chance(15)),
+			underline:    hegel.Draw(tc, maybe(25, ptr(underlines))),
+			ulColor:      hegel.Draw(tc, maybe(15, colors)),
+			strike:       hegel.Draw(tc, chance(15)),
+			reverse:      hegel.Draw(tc, chance(15)),
+			blink:        hegel.Draw(tc, chance(8)),
+			faint:        hegel.Draw(tc, chance(10)),
+			fg:           hegel.Draw(tc, maybe(40, colors)),
+			bg:           hegel.Draw(tc, maybe(40, colors)),
+			width:        hegel.Draw(tc, maybe(45, ptr(hegel.Integers(0, 14)))),
+			height:       hegel.Draw(tc, maybe(30, ptr(hegel.Integers(0, 6)))),
+			alignH:       hegel.Draw(tc, maybe(40, ptr(alignsH))),
+			alignV:       hegel.Draw(tc, maybe(30, ptr(alignsV))),
+			padding:      hegel.Draw(tc, maybe(45, ptr(fourSides))),
+			padChar:      hegel.Draw(tc, maybe(15, pick('.', '~', '*'))),
+			colorWS:      hegel.Draw(tc, maybe(20, ptr(chance(50)))),
+			margin:       hegel.Draw(tc, maybe(35, ptr(fourSides))),
+			marBg:        hegel.Draw(tc, maybe(15, colors)),
+			marChar:      hegel.Draw(tc, maybe(10, pick('.', '~'))),
+			border:       hegel.Draw(tc, maybe(45, ptr(borderSpecs))),
+			inline:       hegel.Draw(tc, chance(10)),
+			maxWidth:     hegel.Draw(tc, maybe(15, hegel.Integers(1, 12))),
+			maxHeight:    hegel.Draw(tc, maybe(15, hegel.Integers(1, 5))),
+			tabWidth:     hegel.Draw(tc, maybe(15, ptr(pick(0, 2, 8)))),
+			ulSpaces:     hegel.Draw(tc, maybe(15, ptr(chance(50)))),
+			strikeSpaces: hegel.Draw(tc, maybe(10, ptr(chance(50)))),
+			link:         hegel.Draw(tc, maybe(15, ptr(links))),
+			transform:    hegel.Draw(tc, chance(10)),
+		}
+	})
+)
+
+// apply builds the Style the record describes.
+func (sp styleSpec) apply() Style {
+	s := NewStyle()
+	if sp.bold {
+		s = s.Bold(true)
+	}
+	if sp.italic {
+		s = s.Italic(true)
+	}
+	if sp.underline != nil {
+		if sp.underline.viaBool {
+			s = s.Underline(true)
+		} else {
+			s = s.UnderlineStyle(sp.underline.style)
+		}
+	}
+	if sp.ulColor != nil {
+		s = s.UnderlineColor(sp.ulColor)
+	}
+	if sp.strike {
+		s = s.Strikethrough(true)
+	}
+	if sp.reverse {
+		s = s.Reverse(true)
+	}
+	if sp.blink {
+		s = s.Blink(true)
+	}
+	if sp.faint {
+		s = s.Faint(true)
+	}
+	if sp.fg != nil {
+		s = s.Foreground(sp.fg)
+	}
+	if sp.bg != nil {
+		s = s.Background(sp.bg)
+	}
+	if sp.width != nil {
+		s = s.Width(*sp.width)
+	}
+	if sp.height != nil {
+		s = s.Height(*sp.height)
+	}
+	if sp.alignH != nil {
+		s = s.AlignHorizontal(*sp.alignH)
+	}
+	if sp.alignV != nil {
+		s = s.AlignVertical(*sp.alignV)
+	}
+	if sp.padding != nil {
+		s = s.Padding(sp.padding[0], sp.padding[1], sp.padding[2], sp.padding[3])
+	}
+	if sp.padChar != 0 {
+		s = s.PaddingChar(sp.padChar)
+	}
+	if sp.colorWS != nil {
+		s = s.ColorWhitespace(*sp.colorWS)
+	}
+	if sp.margin != nil {
+		s = s.Margin(sp.margin[0], sp.margin[1], sp.margin[2], sp.margin[3])
+	}
+	if sp.marBg != nil {
+		s = s.MarginBackground(sp.marBg)
+	}
+	if sp.marChar != 0 {
+		s = s.MarginChar(sp.marChar)
+	}
+	if b := sp.border; b != nil {
+		if b.sides == nil {
+			s = s.BorderStyle(borders[b.name])
+		} else {
+			s = s.Border(borders[b.name], b.sides[0], b.sides[1], b.sides[2], b.sides[3])
+		}
+		if b.fg != nil {
+			s = s.BorderTopForeground(b.fg[0]).BorderRightForeground(b.fg[1]).BorderBottomForeground(b.fg[2]).BorderLeftForeground(b.fg[3])
+		}
+		if b.bg != nil {
+			s = s.BorderTopBackground(b.bg[0]).BorderRightBackground(b.bg[1]).BorderBottomBackground(b.bg[2]).BorderLeftBackground(b.bg[3])
+		}
+	}
+	if sp.inline {
+		s = s.Inline(true)
+	}
+	if sp.maxWidth > 0 {
+		s = s.MaxWidth(sp.maxWidth)
+	}
+	if sp.maxHeight > 0 {
+		s = s.MaxHeight(sp.maxHeight)
+	}
+	if sp.tabWidth != nil {
+		s = s.TabWidth(*sp.tabWidth)
+	}
+	if sp.ulSpaces != nil {
+		s = s.UnderlineSpaces(*sp.ulSpaces)
+	}
+	if sp.strikeSpaces != nil {
+		s = s.StrikethroughSpaces(*sp.strikeSpaces)
+	}
+	if sp.link != nil {
+		if sp.link.params != "" {
+			s = s.Hyperlink(sp.link.url, sp.link.params)
+		} else {
+			s = s.Hyperlink(sp.link.url)
+		}
+	}
+	if sp.transform {
+		s = s.Transform(strings.ToUpper)
+	}
+	return s
+}
+
+// props counts the set properties (zero: Render returns the text, tabs expanded).
+func (sp styleSpec) props() int {
+	n := 0
+	for _, set := range []bool{sp.bold, sp.italic, sp.underline != nil, sp.ulColor != nil, sp.strike, sp.reverse, sp.blink, sp.faint,
+		sp.fg != nil, sp.bg != nil, sp.width != nil, sp.height != nil, sp.alignH != nil, sp.alignV != nil, sp.padding != nil, sp.padChar != 0,
+		sp.colorWS != nil, sp.margin != nil, sp.marBg != nil, sp.marChar != 0, sp.border != nil, sp.inline, sp.maxWidth > 0, sp.maxHeight > 0,
+		sp.tabWidth != nil, sp.ulSpaces != nil, sp.strikeSpaces != nil, sp.link != nil, sp.transform} {
+		if set {
+			n++
+		}
+	}
+	return n
+}
+
+func (sp styleSpec) GoString() string {
+	var parts []string
+	add := func(name string, set bool, v any) {
+		if set {
+			parts = append(parts, fmt.Sprintf("%s=%v", name, v))
+		}
+	}
+	add("bold", sp.bold, true)
+	add("italic", sp.italic, true)
+	if sp.underline != nil {
+		add("underline", true, fmt.Sprintf("%d(bool %v)", sp.underline.style, sp.underline.viaBool))
+	}
+	add("ulColor", sp.ulColor != nil, sp.ulColor)
+	add("strike", sp.strike, true)
+	add("reverse", sp.reverse, true)
+	add("blink", sp.blink, true)
+	add("faint", sp.faint, true)
+	add("fg", sp.fg != nil, sp.fg)
+	add("bg", sp.bg != nil, sp.bg)
+	if sp.width != nil {
+		add("width", true, *sp.width)
+	}
+	if sp.height != nil {
+		add("height", true, *sp.height)
+	}
+	if sp.alignH != nil {
+		add("alignH", true, *sp.alignH)
+	}
+	if sp.alignV != nil {
+		add("alignV", true, *sp.alignV)
+	}
+	if sp.padding != nil {
+		add("padding", true, *sp.padding)
+	}
+	add("padChar", sp.padChar != 0, string(sp.padChar))
+	if sp.colorWS != nil {
+		add("colorWS", true, *sp.colorWS)
+	}
+	if sp.margin != nil {
+		add("margin", true, *sp.margin)
+	}
+	add("marBg", sp.marBg != nil, sp.marBg)
+	add("marChar", sp.marChar != 0, string(sp.marChar))
+	if b := sp.border; b != nil {
+		desc := b.name
+		if b.sides != nil {
+			desc += fmt.Sprintf(" sides %v", *b.sides)
+		}
+		if b.fg != nil {
+			desc += fmt.Sprintf(" fg %v", *b.fg)
+		}
+		if b.bg != nil {
+			desc += fmt.Sprintf(" bg %v", *b.bg)
+		}
+		add("border", true, desc)
+	}
+	add("inline", sp.inline, true)
+	add("maxWidth", sp.maxWidth > 0, sp.maxWidth)
+	add("maxHeight", sp.maxHeight > 0, sp.maxHeight)
+	if sp.tabWidth != nil {
+		add("tabWidth", true, *sp.tabWidth)
+	}
+	if sp.ulSpaces != nil {
+		add("ulSpaces", true, *sp.ulSpaces)
+	}
+	if sp.strikeSpaces != nil {
+		add("strikeSpaces", true, *sp.strikeSpaces)
+	}
+	if sp.link != nil {
+		add("link", true, sp.link.url+";"+sp.link.params)
+	}
+	add("transform", sp.transform, true)
+	return "style{" + strings.Join(parts, " ") + "}"
+}
+
