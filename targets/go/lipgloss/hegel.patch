+		if got, want := c.GetBold(), a.GetBold() || (!a.isSet(boldKey) && b.GetBold()); got != want {
+			fail(ht, "Inherit bold = %v, want %v", got, want)
+		}
+		if got, want := c.GetWidth(), a.GetWidth(); !a.isSet(widthKey) && b.isSet(widthKey) {
+			if got != b.GetWidth() {
+				fail(ht, "Inherit width = %d, want b's %d", got, b.GetWidth())
+			}
+		} else if got != want {
+			fail(ht, "Inherit width = %d, want a's %d", got, want)
+		}
+		// Margins and padding are never inherited.
+		if c.GetPaddingLeft() != a.GetPaddingLeft() || c.GetMarginLeft() != a.GetMarginLeft() || c.GetPaddingTop() != a.GetPaddingTop() || c.GetMarginBottom() != a.GetMarginBottom() {
+			fail(ht, "Inherit copied padding or margins: %d/%d, a had %d/%d", c.GetPaddingLeft(), c.GetMarginLeft(), a.GetPaddingLeft(), a.GetMarginLeft())
+		}
+		// The margin background follows an inherited background when neither set one.
+		if b.isSet(backgroundKey) && !a.isSet(marginBackgroundKey) && !b.isSet(marginBackgroundKey) {
+			if !colorEqual(c.getAsColor(marginBackgroundKey), b.GetBackground()) {
+				fail(ht, "Inherit margin background = %v, want b's background %v", c.getAsColor(marginBackgroundKey), b.GetBackground())
+			}
+		}
+		// Rendering with the inherited style equals rendering with a where a is set.
+		if a.isSet(foregroundKey) && a.isSet(backgroundKey) && a.isSet(boldKey) && !b.isSet(linkKey) && !b.isSet(transformKey) {
+			_ = c
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/1: with underline or strikethrough on (the rune-by-rune "space styler" path),
+// every rune is styled separately, so grapheme clusters such as ZWJ emoji sequences are torn
+// apart by SGR sequences; the rendered width grows accordingly.
+func TestHegelPinSpaceStylerTearsGraphemeClusters(t *testing.T) {
+	defer guard(t)
+	family := "👨‍👩‍👧"
+	out := NewStyle().Underline(true).Render(family)
+	if strings.Contains(out, family) {
+		t.Fatalf("fixed: the cluster is rendered whole: %q", out)
+	}
+	if w := Width(out); w == Width(family) {
+		t.Fatalf("fixed: Width(%q) = %d", out, w)
+	}
+	t.Fatalf("Underline(true).Render(%q) = %q (width %d, the cluster's width is %d)", family, out, Width(out), Width(family))
+}
+
+// lipgloss/2: on the space styler path, spaces get only colours, underline and strikethrough;
+// Reverse is dropped, so a reversed underlined string has an unreversed hole at every space.
+func TestHegelPinReverseDroppedFromSpacesUnderUnderline(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Reverse(true).Underline(true).Render("a b")
+	rows := parseCells(out)
+	if len(rows) == 1 && len(rows[0]) == 3 && rows[0][1].st.attrs&aReverse != 0 {
+		t.Fatalf("fixed: the space is reversed in %q", out)
+	}
+	t.Fatalf("Reverse(true).Underline(true).Render(\"a b\") = %q: the space is not reversed", out)
+}
+
+// lipgloss/3: spaces are underlined with a plain single underline whatever UnderlineStyle the
+// text uses, so a curly-underlined string has straight underlines under its spaces.
+func TestHegelPinSpacesUnderlinedSingleUnderCurlyText(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().UnderlineStyle(ansi.UnderlineCurly).Render("a b")
+	rows := parseCells(out)
+	if len(rows) == 1 && len(rows[0]) == 3 && rows[0][1].st.under == ansi.UnderlineCurly {
+		t.Fatalf("fixed: the space is curly-underlined in %q", out)
+	}
+	t.Fatalf("UnderlineStyle(Curly).Render(\"a b\") = %q: the space has underline %d, the text %d", out, rows[0][1].st.under, rows[0][0].st.under)
+}
+
+// lipgloss/4: the hyperlink is opened before the first line and closed after the last, so the
+// padding and alignment whitespace of every line but the first (left) and last (right) is
+// part of the link while the first line's padding is not.
+func TestHegelPinHyperlinkCoversPaddingOfContinuationLines(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Hyperlink("https://example.com").PaddingLeft(2).Render("a\nb")
+	rows := parseCells(out)
+	if len(rows) != 2 || len(rows[0]) != 3 || len(rows[1]) != 3 {
+		t.Fatalf("unexpected shape %q", out)
+	}
+	if rows[0][0].link == rows[1][0].link {
+		t.Fatalf("fixed: both lines' padding have link %q in %q", rows[1][0].link, out)
+	}
+	t.Fatalf("Hyperlink(...).PaddingLeft(2).Render(\"a\\nb\") = %q: the first line's padding has link %q, the second line's %q", out, rows[0][0].link, rows[1][0].link)
+}
+
+// lipgloss/5: PlaceHorizontal and PlaceVertical put a fractional position on the wrong side
+// (0.9 lands near the start), the mirror image of what JoinHorizontal/JoinVertical and the
+// docs ("0 is the start, 1 the end") do.
+func TestHegelPinPlaceMirrorsFractionalPositions(t *testing.T) {
+	defer guard(t)
+	h := PlaceHorizontal(10, 0.9, "ab")
+	v := PlaceVertical(4, 0.9, "ab")
+	jh := JoinVertical(0.9, "ab", strings.Repeat("x", 10))
+	if h == "       ab " && v == "  \n  \n ab\n  "[:0]+"  \n  \n  \nab" {
+		t.Fatalf("fixed: %q %q", h, v)
+	}
+	if h == "       ab " {
+		t.Fatalf("fixed horizontally: %q (vertical %q)", h, v)
+	}
+	t.Fatalf("PlaceHorizontal(10, 0.9, \"ab\") = %q and PlaceVertical(4, 0.9, \"ab\") = %q, while JoinVertical(0.9, ...) puts the text on the right: %q", h, v, strings.Split(jh, "\n")[0])
+}
+
+// lipgloss/6: Height is ignored when AlignVertical is a fractional position: the block is not
+// padded to its height at all.
+func TestHegelPinHeightIgnoredForFractionalVerticalAlign(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Height(4).AlignVertical(0.3).Render("ab")
+	if Height(out) == 4 {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Height(4).AlignVertical(0.3).Render(\"ab\") = %q (height %d), Height(4).Render = %q", out, Height(out), NewStyle().Height(4).Render("ab"))
+}
+
+// lipgloss/7: a fractional horizontal alignment is treated as Left: Align(0.9) with a Width
+// puts the text at the left edge.
+func TestHegelPinFractionalHorizontalAlignIsLeft(t *testing.T) {
+	defer guard(t)
+	out := NewStyle().Width(6).Align(0.9).Render("ab")
+	if out != "ab    " {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Width(6).Align(0.9).Render(\"ab\") = %q, the same as Align(Left)", out)
+}
diff --git a/internal/zootest/zootest.go b/internal/zootest/zootest.go
new file mode 100644
index 0000000..ad89f3a
--- /dev/null
+++ b/internal/zootest/zootest.go
@@ -0,0 +1,395 @@
+// Package zootest is the shared Hegel harness of the hegel-zoo lipgloss target: collect
+// mode, generators helpers and the SGR/OSC 8 cell parser used to read rendered output.
+package zootest
+
+import (
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+func HegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("LIPGLOSS_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func Fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func Property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, msg)
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, HegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func Count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func N(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func Chance(tc hegel.TestCase, pct int) bool { return N(tc, 1, 100) <= pct }
+
+func Pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func Note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func Guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+const (
+	ABold uint8 = 1 << iota
+	AFaint
+	AItalic
+	ABlink
+	ARapidBlink
+	AReverse
+	AConceal
+	AStrike
+)
+
+// MStyle is the pen: what an SGR-reading terminal holds for a cell.
+type MStyle struct {
+	Fg, Bg, Ul color.Color
+	Attrs      uint8
+	Under      ansi.Underline
+}
+
+func (s MStyle) String() string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b under:%d}", s.Fg, s.Bg, s.Ul, s.Attrs, s.Under)
+}
+
+func ColorEqual(c, o color.Color) bool {
+	if c == nil && o == nil {
+		return true
+	}
+	if c == nil || o == nil {
+		return false
+	}
+	cr, cg, cb, ca := c.RGBA()
+	or, og, ob, oa := o.RGBA()
+	return cr == or && cg == og && cb == ob && ca == oa
+}
+
+// MCell is one screen cell: a grapheme with its width, pen and hyperlink.
+type MCell struct {
+	G    string
+	W    int
+	St   MStyle
+	Link string // URL
+	Lp   string // link params
+}
+
+func (c MCell) String() string {
+	s := fmt.Sprintf("{%q w%d %s", c.G, c.W, c.St)
+	if c.Link != "" {
+		s += fmt.Sprintf(" link=%s;%s", c.Lp, c.Link)
+	}
+	return s + "}"
+}
+
+// ApplySGR applies one SGR parameter list to st following ECMA-48 and the xterm/kitty colour
+// and underline extensions.
+func ApplySGR(params []ansi.Param, st *MStyle) {
+	if len(params) == 0 {
+		*st = MStyle{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		p := params[i]
+		v := p.Param(0)
+		switch {
+		case v == 0:
+			*st = MStyle{}
+		case v == 1:
+			st.Attrs |= ABold
+		case v == 2:
+			st.Attrs |= AFaint
+		case v == 3:
+			st.Attrs |= AItalic
+		case v == 4:
+			if p.HasMore() && i+1 < len(params) {
+				i++
+				st.Under = ansi.Underline(params[i].Param(1))
+			} else {
+				st.Under = ansi.UnderlineSingle
+			}
+		case v == 5:
+			st.Attrs |= ABlink
+		case v == 6:
+			st.Attrs |= ARapidBlink
+		case v == 7:
+			st.Attrs |= AReverse
+		case v == 8:
+			st.Attrs |= AConceal
+		case v == 9:
+			st.Attrs |= AStrike
+		case v == 22:
+			st.Attrs &^= ABold | AFaint
+		case v == 23:
+			st.Attrs &^= AItalic
+		case v == 24:
+			st.Under = ansi.UnderlineNone
+		case v == 25:
+			st.Attrs &^= ABlink | ARapidBlink
+		case v == 27:
+			st.Attrs &^= AReverse
+		case v == 28:
+			st.Attrs &^= AConceal
+		case v == 29:
+			st.Attrs &^= AStrike
+		case v >= 30 && v <= 37:
+			st.Fg = ansi.BasicColor(v - 30)
+		case v == 39:
+			st.Fg = nil
+		case v >= 40 && v <= 47:
+			st.Bg = ansi.BasicColor(v - 40)
+		case v == 49:
+			st.Bg = nil
+		case v == 59:
+			st.Ul = nil
+		case v >= 90 && v <= 97:
+			st.Fg = ansi.BasicColor(v - 90 + 8)
+		case v >= 100 && v <= 107:
+			st.Bg = ansi.BasicColor(v - 100 + 8)
+		case v == 38 || v == 48 || v == 58:
+			end := i
+			for end+1 < len(params) && params[end].HasMore() {
+				end++
+			}
+			run := params[i : end+1]
+			if len(run) == 1 {
+				run = params[i:min(len(params), i+5)]
+				if len(run) > 1 && run[1].Param(0) == 5 {
+					run = run[:3]
+				}
+				end = i + len(run) - 1
+			}
+			var c color.Color
+			switch {
+			case len(run) >= 3 && run[1].Param(0) == 5:
+				c = ansi.ExtendedColor(run[2].Param(0))
+			case len(run) == 6 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[3].Param(0)), G: uint8(run[4].Param(0)), B: uint8(run[5].Param(0)), A: 0xff}
+			case len(run) >= 5 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[2].Param(0)), G: uint8(run[3].Param(0)), B: uint8(run[4].Param(0)), A: 0xff}
+			}
+			switch v {
+			case 38:
+				st.Fg = c
+			case 48:
+				st.Bg = c
+			default:
+				st.Ul = c
+			}
+			i = end
+		}
+	}
+}
+
+// ParseCells replays a rendered string onto rows of cells: text lands with the pen and link
+// in force, SGR and OSC 8 move the pen, "\n" starts a row. Zero-width graphemes (a combining
+// mark separated from its base by a sequence) become cells of width 0.
+func ParseCells(out string) [][]MCell {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st MStyle
+	var link, lp string
+	var state byte
+	rows := [][]MCell{{}}
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			ApplySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			parts := strings.SplitN(string(p.Data()), ";", 3)
+			if len(parts) == 3 {
+				lp, link = parts[1], parts[2]
+			}
+		case sq == "\n":
+			rows = append(rows, []MCell{})
+		case sq == "\r":
+			// Left in place: the model never expects one.
+			rows[len(rows)-1] = append(rows[len(rows)-1], MCell{G: "\r", W: 0, St: st, Link: link, Lp: lp})
+		case ansi.HasEscPrefix(sq) || ansi.HasCsiPrefix(sq) || ansi.HasOscPrefix(sq) || ansi.HasDcsPrefix(sq):
+			// Other sequences do not draw.
+		default:
+			rows[len(rows)-1] = append(rows[len(rows)-1], MCell{G: sq, W: w, St: st, Link: link, Lp: lp})
+		}
+		out = out[k:]
+		state = ns
+	}
+	return rows
+}
+
+func RowsString(rows [][]MCell) string {
+	var sb strings.Builder
+	for y, r := range rows {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range r {
+			sb.WriteString(" " + c.String())
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func RowsRow(r []MCell) string {
+	var sb strings.Builder
+	for _, c := range r {
+		sb.WriteString(" " + c.String())
+	}
+	return sb.String()
+}
+
+func RowsPlain(rows [][]MCell) string {
+	lines := make([]string, len(rows))
+	for y, r := range rows {
+		var sb strings.Builder
+		for _, c := range r {
+			sb.WriteString(c.G)
+		}
+		lines[y] = sb.String()
+	}
+	return strings.Join(lines, "\n")
+}
+
+func IsSpaceCell(g string) bool {
+	return g == " " || g == " "
+}
+
+// SameCell compares two cells up to what a terminal shows: on a blank, bold, faint, italic,
+// blink and the foreground colour are invisible; an underline colour without an underline is
+// invisible everywhere.
+func SameCell(a, b MCell) bool {
+	if a.G != b.G || a.W != b.W || a.Link != b.Link || a.Lp != b.Lp {
+		return false
+	}
+	as, bs := a.St, b.St
+	if IsSpaceCell(a.G) {
+		invisible := ABold | AFaint | AItalic | ABlink | ARapidBlink
+		as.Attrs &^= invisible
+		bs.Attrs &^= invisible
+		as.Fg, bs.Fg = nil, nil
+	}
+	if as.Under == ansi.UnderlineNone {
+		as.Ul = nil
+	}
+	if bs.Under == ansi.UnderlineNone {
+		bs.Ul = nil
+	}
+	return as.Attrs == bs.Attrs && as.Under == bs.Under && ColorEqual(as.Fg, bs.Fg) && ColorEqual(as.Bg, bs.Bg) && ColorEqual(as.Ul, bs.Ul)
+}
+
+func CompareRows(ht *hegel.T, what string, got, want [][]MCell, out string) {
+	if len(got) != len(want) {
+		Fail(ht, "%s: %d lines rendered, model has %d\nrendered %q\ngot   %q\nmodel %q", what, len(got), len(want), out, RowsPlain(got), RowsPlain(want))
+	}
+	for y := range want {
+		if len(got[y]) != len(want[y]) {
+			Fail(ht, "%s: line %d has %d cells, model has %d\nrendered %q\ngot   %q\nmodel %q", what, y, len(got[y]), len(want[y]), out, RowsPlain(got), RowsPlain(want))
+		}
+		for x := range want[y] {
+			if !SameCell(got[y][x], want[y][x]) {
+				Fail(ht, "%s: line %d cell %d is %s, model %s\nrendered %q\nrow got   %s\nrow model %s", what, y, x, got[y][x], want[y][x], out, RowsRow(got[y]), RowsRow(want[y]))
+			}
+		}
+	}
+}
+
+func RowWidth(r []MCell) int {
+	w := 0
+	for _, c := range r {
+		w += c.W
+	}
+	return w
+}
diff --git a/table/hegel_test.go b/table/hegel_test.go
new file mode 100644
index 0000000..82dbe96
--- /dev/null
+++ b/table/hegel_test.go
@@ -0,0 +1,800 @@
+package table
+
+// Hegel property tests for charm.land/lipgloss/v2/table (hegel-zoo target go/lipgloss).
+//
+// A random table (headers, rows, borders, per-cell styles, Width/FitContent/Wrap/Height/
+// YOffset) is rendered and read back as a grid: the border lines must be exactly the ones the
+// column widths and border runes prescribe, every cell region must hold its cell's text
+// (wrapped, or truncated with "…"), the table must be as wide as asked when that is possible,
+// and the visible-row bookkeeping must match what was drawn.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"charm.land/lipgloss/v2/internal/zootest"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	narrow = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "+", "="}
+	wide   = []string{"世", "界", "😃", "Ａ"}
+)
+
+func genCell(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for k := zootest.N(tc, 0, 9); k > 0; k-- {
+		switch {
+		case zootest.Chance(tc, 15):
+			sb.WriteByte(' ')
+		case zootest.Chance(tc, 4):
+			sb.WriteByte('\n')
+		case zootest.Chance(tc, 20):
+			sb.WriteString(zootest.Pick(tc, wide))
+		default:
+			sb.WriteString(zootest.Pick(tc, narrow))
+		}
+	}
+	return sb.String()
+}
+
+// cellSpec is the per-position style the generated StyleFunc returns.
+type cellSpec struct {
+	padL, padR, padT, padB int
+	marL, marR             int
+	width, height          int
+	bg                     bool
+	align                  lipgloss.Position
+}
+
+func (c cellSpec) style() lipgloss.Style {
+	s := lipgloss.NewStyle().Padding(c.padT, c.padR, c.padB, c.padL).Margin(0, c.marR, 0, c.marL).AlignHorizontal(c.align)
+	if c.width > 0 {
+		s = s.Width(c.width)
+	}
+	if c.height > 0 {
+		s = s.Height(c.height)
+	}
+	if c.bg {
+		s = s.Background(lipgloss.Color("4"))
+	}
+	return s
+}
+
+type tableSpec struct {
+	headers   []string
+	rows      [][]string
+	cols      int
+	border    lipgloss.Border
+	bName     string
+	top, bot  bool
+	left, rgt bool
+	hdr, col  bool
+	row       bool
+	width     int
+	fit       bool
+	wrap      bool
+	height    int
+	hasHeight bool
+	yOffset   int
+	styles    map[[2]int]cellSpec
+	styled    bool
+}
+
+var borders = map[string]lipgloss.Border{
+	"normal": lipgloss.NormalBorder(), "rounded": lipgloss.RoundedBorder(), "thick": lipgloss.ThickBorder(),
+	"double": lipgloss.DoubleBorder(), "ascii": lipgloss.ASCIIBorder(), "markdown": lipgloss.MarkdownBorder(),
+	"hidden": lipgloss.HiddenBorder(), "block": lipgloss.BlockBorder(),
+}
+
+var borderNames = []string{"normal", "rounded", "thick", "double", "ascii", "markdown", "hidden", "block"}
+
+func genTable(tc hegel.TestCase) (*Table, tableSpec) {
+	var sp tableSpec
+	sp.cols = zootest.N(tc, 1, 4)
+	if zootest.Chance(tc, 60) {
+		for j := 0; j < sp.cols; j++ {
+			sp.headers = append(sp.headers, strings.ReplaceAll(genCell(tc), "\n", ""))
+		}
+		// Fewer headers than columns are padded with empty ones by the table.
+		if zootest.Chance(tc, 20) && sp.cols > 1 {
+			sp.headers = sp.headers[:sp.cols-1]
+		}
+	}
+	for r := zootest.N(tc, 0, 5); r > 0; r-- {
+		var row []string
+		for j := 0; j < sp.cols; j++ {
+			row = append(row, genCell(tc))
+		}
+		sp.rows = append(sp.rows, row)
+	}
+	sp.bName = zootest.Pick(tc, borderNames)
+	sp.border = borders[sp.bName]
+	sp.top, sp.bot, sp.left, sp.rgt = zootest.Chance(tc, 80), zootest.Chance(tc, 80), zootest.Chance(tc, 80), zootest.Chance(tc, 80)
+	sp.hdr, sp.col, sp.row = zootest.Chance(tc, 80), zootest.Chance(tc, 80), zootest.Chance(tc, 40)
+	sp.wrap = zootest.Chance(tc, 70)
+	if zootest.Chance(tc, 50) {
+		sp.width = zootest.N(tc, 1, 40)
+		sp.fit = zootest.Chance(tc, 25)
+	}
+	if zootest.Chance(tc, 30) {
+		sp.height = zootest.N(tc, 1, 12)
+		sp.hasHeight = true
+		if zootest.Chance(tc, 50) {
+			sp.yOffset = zootest.N(tc, 0, len(sp.rows))
+		}
+	}
+	sp.styles = map[[2]int]cellSpec{}
+	if zootest.Chance(tc, 50) {
+		sp.styled = true
+		for r := -1; r < len(sp.rows); r++ {
+			for c := 0; c < sp.cols; c++ {
+				if !zootest.Chance(tc, 50) {
+					continue
+				}
+				cs := cellSpec{
+					padL: zootest.N(tc, 0, 1), padR: zootest.N(tc, 0, 1),
+					align: zootest.Pick(tc, []lipgloss.Position{lipgloss.Left, lipgloss.Center, lipgloss.Right}),
+					bg:    zootest.Chance(tc, 30),
+				}
+				if zootest.Chance(tc, 20) {
+					cs.padT, cs.padB = zootest.N(tc, 0, 1), zootest.N(tc, 0, 1)
+				}
+				if zootest.Chance(tc, 15) {
+					cs.marL, cs.marR = zootest.N(tc, 0, 1), zootest.N(tc, 0, 1)
+				}
+				if zootest.Chance(tc, 10) {
+					cs.width = zootest.N(tc, 2, 8)
+				}
+				if zootest.Chance(tc, 10) {
+					cs.height = zootest.N(tc, 1, 3)
+				}
+				sp.styles[[2]int{r, c}] = cs
+			}
+		}
+	}
+	t := New().Border(sp.border).BorderTop(sp.top).BorderBottom(sp.bot).BorderLeft(sp.left).BorderRight(sp.rgt).
+		BorderHeader(sp.hdr).BorderColumn(sp.col).BorderRow(sp.row).Wrap(sp.wrap)
+	if len(sp.headers) > 0 {
+		t = t.Headers(sp.headers...)
+	}
+	t = t.Rows(sp.rows...)
+	if sp.width > 0 {
+		t = t.Width(sp.width)
+		if sp.fit {
+			t = t.FitContent()
+		}
+	}
+	if sp.hasHeight {
+		t = t.Height(sp.height).YOffset(sp.yOffset)
+	}
+	if sp.styled {
+		styles := sp.styles
+		t = t.StyleFunc(func(row, col int) lipgloss.Style {
+			if cs, ok := styles[[2]int{row, col}]; ok {
+				return cs.style()
+			}
+			return lipgloss.NewStyle()
+		})
+	}
+	return t, sp
+}
+
+func (sp tableSpec) styleAt(row, col int) cellSpec {
+	return sp.styles[[2]int{row, col}]
+}
+
+// graphemesNoSpace returns the non-blank graphemes of a plain string in order.
+func graphemesNoSpace(s string) []string {
+	var out []string
+	for _, row := range zootest.ParseCells(s) {
+		for _, c := range row {
+			if zootest.IsSpaceCell(c.G) || c.G == "\n" {
+				continue
+			}
+			out = append(out, c.G)
+		}
+	}
+	return out
+}
+
+// edge builds a horizontal border line from the widths and the runes for the corners, the
+// fill and the junction.
+func edge(sp tableSpec, widths []int, l, fill, mid, r string) string {
+	var sb strings.Builder
+	if sp.left {
+		sb.WriteString(l)
+	}
+	for j, w := range widths {
+		sb.WriteString(strings.Repeat(fill, w))
+		if j < len(widths)-1 && sp.col {
+			sb.WriteString(mid)
+		}
+	}
+	if sp.rgt {
+		sb.WriteString(r)
+	}
+	return sb.String()
+}
+
+// leadingSpaceLine reports a cell with a line that starts with a space.
+func leadingSpaceLine(sp tableSpec) bool {
+	for _, h := range sp.headers {
+		if strings.HasPrefix(h, " ") {
+			return true
+		}
+	}
+	for _, row := range sp.rows {
+		for _, c := range row {
+			if strings.Contains("\n"+c, "\n ") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func failf(ht *hegel.T, sp tableSpec, format string, args ...any) {
+	zootest.Fail(ht, format+"\nspec %+v", append(args, sp)...)
+}
+
+// contentWidths is the documented column width without a table width: the widest cell plus
+// the column's largest horizontal frame, or the fixed style width.
+func (sp tableSpec) contentWidths() (widths []int, fixed bool) {
+	hasHeaders := len(sp.headers) > 0
+	for j := 0; j < sp.cols; j++ {
+		want, fixedW, xpad := 0, 0, 0
+		for r := -1; r < len(sp.rows); r++ {
+			var cell string
+			if r == -1 {
+				if !hasHeaders {
+					continue
+				}
+				if j < len(sp.headers) {
+					cell = sp.headers[j]
+				}
+			} else {
+				cell = sp.rows[r][j]
+			}
+			want = max(want, lipgloss.Width(cell))
+			cs := sp.styleAt(r, j)
+			xpad = max(xpad, cs.padL+cs.padR+cs.marL+cs.marR)
+			fixedW = max(fixedW, cs.width)
+		}
+		if fixedW > 0 {
+			want = fixedW
+			fixed = true
+		} else {
+			want += xpad
+		}
+		widths = append(widths, want)
+	}
+	return widths, fixed
+}
+
+func TestHegelTableLaysOutItsGrid(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		tb, sp := genTable(ht)
+		zootest.Note(ht, "table %+v", sp)
+		out := tb.String()
+		zootest.Note(ht, "rendered\n%s", out)
+		hasHeaders := len(sp.headers) > 0
+		if !hasHeaders && len(sp.rows) == 0 {
+			if out != "" {
+				failf(ht, sp, "empty table rendered %q", out)
+			}
+			zootest.Count("empty")
+			return
+		}
+		if again := tb.String(); again != out {
+			failf(ht, sp, "String() is not idempotent:\n%s\nthen\n%s", out, again)
+		}
+		lines := strings.Split(out, "\n")
+		plain := make([]string, len(lines))
+		for i, l := range lines {
+			plain[i] = ansi.Strip(l)
+		}
+		widths, heights := tb.widths, tb.heights
+		for j, w := range widths {
+			if w == 0 {
+				zootest.Count("zero-width-column")
+				return
+			}
+			xpad, fixedW := 0, 0
+			for r := -1; r < len(sp.rows); r++ {
+				var cell string
+				if r == -1 {
+					if j < len(sp.headers) {
+						cell = sp.headers[j]
+					}
+				} else {
+					cell = sp.rows[r][j]
+				}
+				cs := sp.styleAt(r, j)
+				xpad = max(xpad, cs.padL+cs.padR+cs.marL+cs.marR)
+				fixedW = max(fixedW, cs.width)
+				if w-cs.padL-cs.padR-cs.marL-cs.marR < 2 && strings.ContainsAny(cell, strings.Join(wide, "")) {
+					// A wide cell in a column narrower than two: x/ansi's wrap and truncate
+					// shapes (x-ansi/12), not the table's.
+					zootest.Count("wide-in-narrow-column")
+					return
+				}
+			}
+			if fixedW > 0 && sp.width > 0 {
+				// A style Width and a table Width: the resizer cannot honour both.
+				zootest.Count("fixed-width-with-table-width")
+				return
+			}
+			if fixedW > 0 && fixedW < xpad+1 {
+				// A style Width smaller than another cell's frame in the column: the
+				// frame wins and the column overflows.
+				zootest.Count("fixed-width-below-frame")
+				return
+			}
+		}
+		// Rectangular.
+		w0 := ansi.StringWidth(lines[0])
+		for i, l := range lines {
+			if w := ansi.StringWidth(l); w != w0 {
+				if !sp.wrap && leadingSpaceLine(sp) {
+					// x-ansi/19: a truncated cell whose line starts with a space wraps one
+					// cell too wide and MaxWidth cuts the border off.
+					zootest.Count("x-ansi-wrap-shape")
+					return
+				}
+				failf(ht, sp, "line %d has width %d, line 0 has %d:\n%s", i, w, w0, out)
+			}
+		}
+		borders := 0
+		if sp.left {
+			borders++
+		}
+		if sp.rgt {
+			borders++
+		}
+		if sp.col {
+			borders += len(widths) - 1
+		}
+		total := 0
+		for _, w := range widths {
+			total += w
+		}
+		natural := total + borders
+		// Widths: the resizer's decision must be consistent with the request.
+		cw, fixed := sp.contentWidths()
+		contentTotal := 0
+		minTotal := borders
+		for j := range widths {
+			contentTotal += cw[j]
+			xpad := 0
+			for r := -1; r < len(sp.rows); r++ {
+				cs := sp.styleAt(r, j)
+				xpad = max(xpad, cs.padL+cs.padR+cs.marL+cs.marR)
+			}
+			minTotal += xpad + 1
+		}
+		switch {
+		case sp.width == 0 || (sp.fit && contentTotal+borders <= sp.width):
+			// Content width: each column is its widest cell plus the column's frame.
+			for j, w := range widths {
+				if w != cw[j] {
+					failf(ht, sp, "column %d has width %d, content needs %d:\n%s", j, w, cw[j], out)
+				}
+			}
+			if ansi.StringWidth(lines[0]) != natural {
+				failf(ht, sp, "table is %d wide, columns %v + %d borders = %d:\n%s", ansi.StringWidth(lines[0]), widths, borders, natural, out)
+			}
+			zootest.Count("content-width")
+		case fixed:
+			zootest.Count("fixed-width-column")
+		case sp.width < minTotal:
+			// Impossible budget: every column shrinks to what it can.
+			zootest.Count("width-below-minimum")
+		case contentTotal <= sp.width && sp.width < contentTotal+borders:
+			// lipgloss/8: the shrink decision ignores the borders.
+			zootest.Count("lipgloss/8-shape")
+		default:
+			if natural != sp.width {
+				failf(ht, sp, "Width(%d) asked, columns %v + %d borders = %d:\n%s", sp.width, widths, borders, natural, out)
+			}
+			if ansi.StringWidth(lines[0]) != sp.width {
+				failf(ht, sp, "Width(%d) asked, rendered %d wide:\n%s", sp.width, ansi.StringWidth(lines[0]), out)
+			}
+			zootest.Count("exact-width")
+		}
+		if ansi.StringWidth(lines[0]) > natural {
+			failf(ht, sp, "rendered %d wide, the grid is %d:\n%s", ansi.StringWidth(lines[0]), natural, out)
+		}
+		clipped := ansi.StringWidth(lines[0]) < natural
+		if clipped {
+			zootest.Count("clipped-by-maxwidth")
+		}
+
+		// Expected line structure.
+		b := sp.border
+		var want []string // plain expected lines; "" for content lines
+		var rowOf []int   // row index per line (-1 header, -2 border, -3 overflow)
+		first, last := tb.firstVisibleRowIndex, tb.lastVisibleRowIndex
+		if sp.top {
+			want = append(want, edge(sp, widths, b.TopLeft, b.Top, b.MiddleTop, b.TopRight))
+			rowOf = append(rowOf, -2)
+		}
+		if hasHeaders {
+			for k := 0; k < heights[0]; k++ {
+				want = append(want, "")
+				rowOf = append(rowOf, -1)
+			}
+			if sp.hdr {
+				want = append(want, edge(sp, widths, b.MiddleLeft, b.Top, b.Middle, b.MiddleRight))
+				rowOf = append(rowOf, -2)
+			}
+		}
+		if len(sp.rows) > 0 {
+			end := len(sp.rows) - 1
+			if last != -2 {
+				end = last
+			}
+			for r := first; r <= end; r++ {
+				hi := r
+				if hasHeaders {
+					hi++
+				}
+				for k := 0; k < heights[hi]; k++ {
+					want = append(want, "")
+					rowOf = append(rowOf, r)
+				}
+				if sp.row && r < len(sp.rows)-1 {
+					want = append(want, edge(sp, widths, b.MiddleLeft, b.Bottom, b.Middle, b.MiddleRight))
+					rowOf = append(rowOf, -2)
+				}
+			}
+			if last != -2 {
+				for k := 0; k < tb.overflowHeight; k++ {
+					want = append(want, "")
+					rowOf = append(rowOf, -3)
+				}
+			}
+		}
+		if sp.bot {
+			want = append(want, edge(sp, widths, b.BottomLeft, b.Bottom, b.MiddleBottom, b.BottomRight))
+			rowOf = append(rowOf, -2)
+		}
+		if ch := tb.computeHeight(); sp.hasHeight && ch < sp.height && ch < len(want) {
+			// lipgloss/10: computeHeight undercounts and MaxHeight clips the last lines.
+			zootest.Count("lipgloss/10-shape")
+			want, rowOf = want[:ch], rowOf[:ch]
+		}
+		if hasHeaders {
+			vpad := -1
+			for j := 0; j < sp.cols; j++ {
+				cs := sp.styleAt(-1, j)
+				if vpad >= 0 && cs.padT+cs.padB != vpad {
+					// lipgloss/11: the header height follows the last column's padding.
+					zootest.Count("lipgloss/11-shape")
+					return
+				}
+				vpad = cs.padT + cs.padB
+			}
+		}
+		if sp.hasHeight && len(lines) > sp.height {
+			failf(ht, sp, "Height(%d) asked, %d lines rendered:\n%s", sp.height, len(lines), out)
+		}
+		if len(lines) != len(want) {
+			if sp.hasHeight && len(want) > sp.height && len(lines) == sp.height {
+				zootest.Count("clipped-by-maxheight")
+				want, rowOf = want[:sp.height], rowOf[:sp.height]
+				clipped = true
+			} else {
+				failf(ht, sp, "%d lines rendered, the grid has %d (rows %d..%d, heights %v):\n%s", len(lines), len(want), first, last, heights, out)
+			}
+		}
+		for i := range want {
+			if want[i] == "" {
+				continue
+			}
+			w := want[i]
+			if clipped {
+				w = ansi.Truncate(w, ansi.StringWidth(lines[0]), "")
+			}
+			if plain[i] != w {
+				failf(ht, sp, "line %d is %q, the grid wants %q:\n%s", i, plain[i], w, out)
+			}
+		}
+		// Column boundaries.
+		var starts []int
+		x := 0
+		if sp.left {
+			x++
+		}
+		for j, w := range widths {
+			starts = append(starts, x)
+			x += w
+			if j < len(widths)-1 && sp.col {
+				x++
+			}
+		}
+		// Content lines: separators in place, each region holds its cell's text.
+		type region struct{ lines []string }
+		regions := map[[2]int]*region{}
+		for i, r := range rowOf {
+			if r == -2 {
+				continue
+			}
+			cells := zootest.ParseCells(lines[i])[0]
+			// Split the line into columns by cell widths.
+			col := 0
+			pos := 0
+			var cur strings.Builder
+			var parts []string
+			seps := map[int]bool{}
+			for j := range widths {
+				if j < len(widths)-1 && sp.col {
+					seps[starts[j]+widths[j]] = true
+				}
+			}
+			for _, c := range cells {
+				if pos == starts[col]+widths[col] && col < len(widths) {
+					if seps[pos] {
+						if c.G != ansi.Strip(b.Left) && !(b.Left == "" && c.G == " ") {
+							failf(ht, sp, "line %d column separator at %d is %q, want %q:\n%s", i, pos, c.G, b.Left, out)
+						}
+					}
+					parts = append(parts, cur.String())
+					cur.Reset()
+					col++
+					if col == len(widths) {
+						break
+					}
+				}
+				if pos >= starts[col] {
+					cur.WriteString(c.G)
+				}
+				pos += c.W
+			}
+			if col < len(widths) {
+				parts = append(parts, cur.String())
+			}
+			if len(parts) != len(widths) && !clipped {
+				failf(ht, sp, "line %d splits into %d columns, want %d: %q\n%s", i, len(parts), len(widths), plain[i], out)
+			}
+			for j, p := range parts {
+				key := [2]int{r, j}
+				if regions[key] == nil {
+					regions[key] = &region{}
+				}
+				regions[key].lines = append(regions[key].lines, p)
+			}
+		}
+		if clipped {
+			zootest.Count("regions-unchecked-clipped")
+			return
+		}
+		for key, reg := range regions {
+			r, j := key[0], key[1]
+			got := graphemesNoSpace(strings.Join(reg.lines, "\n"))
+			var cell string
+			switch {
+			case r == -3:
+				cell = "…"
+			case r == -1:
+				if j < len(sp.headers) {
+					cell = sp.headers[j]
+				}
+			default:
+				cell = sp.rows[r][j]
+			}
+			exp := graphemesNoSpace(cell)
+			cs := sp.styleAt(r, j)
+			inner := widths[j] - cs.padL - cs.padR - cs.marL - cs.marR
+			if inner < 2 {
+				zootest.Count("region-narrower-than-two")
+				continue
+			}
+			joinedGot := strings.Join(got, "")
+			joinedExp := strings.Join(exp, "")
+			switch {
+			case r == -3 && sp.styled && joinedGot != joinedExp:
+				// lipgloss/13: the overflow row's height reads column 0's padding, of the
+				// wrong row when there are headers.
+				zootest.Count("lipgloss/13-shape")
+			case r >= 0 && !sp.wrap && cs.padT+cs.padB > 0 && joinedGot != joinedExp:
+				// lipgloss/18: without wrapping the row height ignores vertical padding.
+				zootest.Count("lipgloss/18-shape")
+			case r >= 0 && !sp.wrap && strings.Contains(cell, "\n"):
+				// lipgloss/12: a multi-line cell without wrapping keeps its first line only.
+				zootest.Count("lipgloss/12-shape")
+			case r >= 0 && !sp.wrap && heights[r+btoi(hasHeaders)] > 1 && joinedGot != joinedExp:
+				// lipgloss/12 too: without wrapping the cell is truncated to width×height
+				// cells and then wrapped into the tall row anyway.
+				zootest.Count("nowrap-tall-row")
+			case r == -1 || !sp.wrap || r == -3:
+				// Truncated to one line (headers) or to the cell area, with "…".
+				if joinedGot == joinedExp {
+					break
+				}
+				if strings.HasSuffix(joinedGot, "…") && strings.HasPrefix(joinedExp, strings.TrimSuffix(joinedGot, "…")) {
+					zootest.Count("truncated")
+					break
+				}
+				failf(ht, sp, "cell (%d,%d) region holds %q, cell is %q:\n%s", r, j, joinedGot, cell, out)
+			default:
+				if joinedGot != joinedExp {
+					if cs.height > 0 || sp.hasHeight {
+						zootest.Count("wrapped-cell-clipped-by-height")
+						break
+					}
+					if strings.Contains(cell, "-") || strings.Contains("\n"+cell, "\n ") {
+						// x-ansi/8 and /19: Wrap puts a breakpoint on a full line, or is
+						// confused by leading spaces; MaxWidth then clips.
+						zootest.Count("x-ansi-wrap-shape")
+						break
+					}
+					failf(ht, sp, "cell (%d,%d) region holds %q, cell is %q (wrap):\n%s", r, j, joinedGot, cell, out)
+				}
+			}
+		}
+		// Visible-row bookkeeping.
+		if sp.hasHeight {
+			if first < 0 || first > len(sp.rows) || (last != -2 && (last < first-1 || last >= len(sp.rows)-1)) {
+				failf(ht, sp, "visible rows %d..%d of %d:\n%s", first, last, len(sp.rows), out)
+			}
+			if v := tb.VisibleRows(); last == -2 && v != len(sp.rows)-first || last != -2 && v != last-first+1 {
+				failf(ht, sp, "VisibleRows() = %d, rows %d..%d of %d", v, first, last, len(sp.rows))
+			}
+		} else if first != 0 || last != -2 {
+			failf(ht, sp, "no Height set but visible rows are %d..%d", first, last)
+		}
+		zootest.Count("ok")
+	})
+}
+
+// TestHegelTableDataViews checks Filter and DataToMatrix against the rows.
+func TestHegelTableDataViews(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		var rows [][]string
+		cols := zootest.N(ht, 0, 4)
+		for r := zootest.N(ht, 0, 6); r > 0; r-- {
+			var row []string
+			for j := zootest.N(ht, 0, cols); j > 0; j-- {
+				row = append(row, genCell(ht))
+			}
+			rows = append(rows, row)
+		}
+		d := NewStringData(rows...)
+		keep := map[int]bool{}
+		for i := range rows {
+			keep[i] = zootest.Chance(ht, 60)
+		}
+		f := NewFilter(d).Filter(func(i int) bool { return keep[i] })
+		var want [][]string
+		for i, row := range rows {
+			if !keep[i] {
+				continue
+			}
+			full := make([]string, d.Columns())
+			copy(full, row)
+			want = append(want, full)
+		}
+		got := DataToMatrix(f)
+		if fmt.Sprint(got) != fmt.Sprint(want) || f.Rows() != len(want) {
+			zootest.Fail(ht, "Filter/DataToMatrix = %q (%d rows), want %q", got, f.Rows(), want)
+		}
+		if d.Columns() != cols && len(rows) > 0 && d.Columns() > cols {
+			zootest.Fail(ht, "Columns() = %d > %d", d.Columns(), cols)
+		}
+		zootest.Count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/8: optimizedWidths compares the columns' widths without the borders to the table
+// width, so a table whose content plus borders exceeds Width by up to the border count is
+// expanded instead of shrunk, and the final MaxWidth clips the right border away.
+func TestHegelPinWidthIgnoresBordersWhenDecidingToShrink(t *testing.T) {
+	defer zootest.Guard(t)
+	out := New().Row("abcd", "k").Width(7).String()
+	lines := strings.Split(out, "\n")
+	if lipgloss.Width(out) == 7 && strings.HasSuffix(lines[0], "┐") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Row(\"abcd\", \"k\").Width(7) renders %q: width %d, the right border is cut", out, lipgloss.Width(out))
+}
+
+// lipgloss/9: shrinkToMedian stops when the column with the biggest excess over its median
+// is column 0 (`biggestDiffToMedianIndex <= 0`), so the first column is never shrunk towards
+// its median and the biggest other column is cut instead; the same table with its columns
+// reversed shrinks as documented.
+func TestHegelPinShrinkToMedianSkipsTheFirstColumn(t *testing.T) {
+	defer zootest.Guard(t)
+	sparseFirst := New().Row("aaaaaa", "bbbbbbb", "ccccccc").Row("a", "bbbbb", "ccccccc").Row("aaa", "bbbbbbb", "ccccccc").Width(19)
+	sparseLast := New().Row("ccccccc", "bbbbbbb", "aaaaaa").Row("ccccccc", "bbbbb", "a").Row("ccccccc", "bbbbbbb", "aaa").Width(19)
+	_ = sparseFirst.String()
+	_ = sparseLast.String()
+	if sparseFirst.widths[0] == sparseLast.widths[2] && sparseFirst.widths[1] == sparseLast.widths[0] && sparseFirst.widths[2] == sparseLast.widths[1] {
+		t.Fatalf("fixed: widths %v and %v", sparseFirst.widths, sparseLast.widths)
+	}
+	t.Fatalf("with the sparse column first the widths are %v; with it last they are %v (the sparse column is cut towards its median, as documented)", sparseFirst.widths, sparseLast.widths)
+}
+
+// lipgloss/10: computeHeight counts `sum(heights) - 1 + btoi(hasHeaders) + …`, one line short
+// when the table has no headers and no header separator, and String() clips the rendering to
+// min(Height, computeHeight): the bottom border disappears although the height allows it.
+func TestHegelPinBottomBorderClippedWithoutHeaders(t *testing.T) {
+	defer zootest.Guard(t)
+	tb := New().Row("a").BorderHeader(false).Height(10)
+	out := tb.String()
+	if strings.HasSuffix(out, "└─┘") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Row(\"a\").BorderHeader(false).Height(10) renders %q: no bottom border (computeHeight = %d, the table needs 3 lines)", out, tb.computeHeight())
+}
+
+// lipgloss/11: the header row's height is `1 + padding of the last column` rather than the
+// largest vertical frame among the header cells, so a padded header cell in an earlier column
+// spills into an extra line that has no border characters.
+func TestHegelPinHeaderHeightFollowsTheLastColumn(t *testing.T) {
+	defer zootest.Guard(t)
+	tb := New().Headers("A", "B").Row("1", "2").StyleFunc(func(row, col int) lipgloss.Style {
+		if row == HeaderRow && col == 0 {
+			return lipgloss.NewStyle().PaddingTop(1)
+		}
+		return lipgloss.NewStyle()
+	})
+	out := tb.String()
+	lines := strings.Split(out, "\n")
+	for i, l := range lines {
+		if !strings.Contains(l, "│") && !strings.Contains(l, "─") {
+			t.Fatalf("header padded in column 0 only: line %d %q has no border characters:\n%s", i, l, out)
+		}
+	}
+	t.Fatalf("fixed:\n%s", out)
+}
+
+// lipgloss/12: with Wrap(false) a multi-line cell is truncated by ansi.Truncate, which does
+// not count newlines, and then cut to one line by MaxHeight: the lines after the first are
+// dropped without a marker, and a cell that starts with a newline renders blank.
+func TestHegelPinNoWrapDropsTheLinesAfterTheFirst(t *testing.T) {
+	defer zootest.Guard(t)
+	out := New().Row("\nfoo", "x").Wrap(false).String()
+	if strings.Contains(out, "fo") || strings.Contains(out, "…") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Row(\"\\nfoo\", \"x\").Wrap(false) renders %q: the first cell is blank, no ellipsis", out)
+}
+
+// lipgloss/13: visibleRowIndexes sizes the overflow row from column 0's vertical padding at
+// `yPaddings[lastVisibleRowIndex+1]`, an index that omits the header row, so with headers the
+// overflow row gets the previous row's padding (and never another column's); a padded
+// overflow cell then loses its "…".
+func TestHegelPinOverflowRowPaddingOffByOneWithHeaders(t *testing.T) {
+	defer zootest.Guard(t)
+	style := func(row, col int) lipgloss.Style {
+		if row == 2 {
+			return lipgloss.NewStyle().PaddingTop(1)
+		}
+		return lipgloss.NewStyle()
+	}
+	withHeaders := New().Headers("H").Row("a").Row("b").Row("c").Row("d").StyleFunc(style).Height(7).String()
+	without := New().Row("a").Row("b").Row("c").Row("d").StyleFunc(style).Height(5).String()
+	if strings.Contains(withHeaders, "…") {
+		t.Fatalf("fixed:\n%s\n%s", withHeaders, without)
+	}
+	t.Fatalf("with headers the overflow row has no ellipsis:\n%s\nwithout headers it has:\n%s", withHeaders, without)
+}
+
+// lipgloss/18: with Wrap(false) the row heights are the style heights only — vertical
+// padding is added in expandRowHeights, which returns early without wrapping — so a cell
+// with PaddingTop(1) is rendered two lines tall and MaxHeight(1) keeps the padding line: the
+// text disappears.
+func TestHegelPinNoWrapIgnoresVerticalPadding(t *testing.T) {
+	defer zootest.Guard(t)
+	out := New().Row("x").Wrap(false).StyleFunc(func(int, int) lipgloss.Style { return lipgloss.NewStyle().PaddingTop(1) }).String()
+	if strings.Contains(out, "x") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("Row(\"x\").Wrap(false) with PaddingTop(1) renders %q: the cell's text is gone", out)
+}
diff --git a/tree/hegel_test.go b/tree/hegel_test.go
new file mode 100644
index 0000000..c55e1c0
--- /dev/null
+++ b/tree/hegel_test.go
@@ -0,0 +1,474 @@
+package tree_test
+
+// Hegel property tests for charm.land/lipgloss/v2/tree and /list (hegel-zoo target
+// go/lipgloss): a random tree (nested roots, hidden nodes, offsets, multi-line values, custom
+// enumerators and indenters, Width) is rendered and compared with the documented layout —
+// root line, one line per visible child with its enumerator right-aligned to the widest
+// sibling enumerator, continuation lines and sub-trees indented — built as plain strings.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2/internal/zootest"
+	"charm.land/lipgloss/v2/list"
+	"charm.land/lipgloss/v2/tree"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	narrow = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "+", "="}
+	wide   = []string{"世", "界", "😃", "Ａ"}
+)
+
+func genValue(tc hegel.TestCase, multiline bool) string {
+	var sb strings.Builder
+	for k := zootest.N(tc, 1, 6); k > 0; k-- {
+		switch {
+		case zootest.Chance(tc, 10):
+			sb.WriteByte(' ')
+		case multiline && zootest.Chance(tc, 8):
+			sb.WriteByte('\n')
+		case zootest.Chance(tc, 15):
+			sb.WriteString(zootest.Pick(tc, wide))
+		default:
+			sb.WriteString(zootest.Pick(tc, narrow))
+		}
+	}
+	return strings.Trim(sb.String(), "\n")
+}
+
+// tnode is the generated shape of a node.
+type tnode struct {
+	value    string
+	hidden   bool
+	children []*tnode
+	offStart int
+	offEnd   int  // counted from the end, as the code does
+	sub      bool // a nested list.New (auto-nested by the tree)
+}
+
+func genNode(tc hegel.TestCase, depth int) *tnode {
+	n := &tnode{value: genValue(tc, true), hidden: zootest.Chance(tc, 10)}
+	if depth > 0 && zootest.Chance(tc, 50) {
+		for k := zootest.N(tc, 0, 4); k > 0; k-- {
+			n.children = append(n.children, genNode(tc, depth-1))
+		}
+		if len(n.children) > 0 && zootest.Chance(tc, 20) {
+			// Offset(start, end): end is a count from the end in Children(); start <= end
+			// avoids the swap in Offset.
+			n.offStart = zootest.N(tc, 0, len(n.children))
+			n.offEnd = zootest.N(tc, n.offStart, len(n.children))
+		}
+		if n.value == "" {
+			// A rootless tree auto-nests into its previous sibling (lipgloss/20 and the
+			// list property); the tree property keeps every node rooted.
+			n.value = "x"
+		}
+	}
+	return n
+}
+
+func (n *tnode) build() *tree.Tree {
+	t := tree.Root(n.value).Hide(n.hidden)
+	for _, c := range n.children {
+		if len(c.children) == 0 && c.offStart == 0 && c.offEnd == 0 {
+			t.Child(tree.NewLeaf(c.value, c.hidden))
+			continue
+		}
+		t.Child(c.build())
+	}
+	if n.offStart > 0 || n.offEnd > 0 {
+		t.Offset(n.offStart, n.offEnd)
+	}
+	return t
+}
+
+func (n *tnode) visible() []*tnode {
+	var out []*tnode
+	for i := n.offStart; i < len(n.children)-n.offEnd; i++ {
+		if !n.children[i].hidden {
+			out = append(out, n.children[i])
+		}
+	}
+	return out
+}
+
+type enumSpec struct {
+	name string
+	enum func(n, i int) string
+	ind  func(n, i int) string
+}
+
+var enumerators = []enumSpec{
+	{"default", func(n, i int) string {
+		if i == n-1 {
+			return "└──"
+		}
+		return "├──"
+	}, func(n, i int) string {
+		if i == n-1 {
+			return "   "
+		}
+		return "│  "
+	}},
+	{"rounded", func(n, i int) string {
+		if i == n-1 {
+			return "╰──"
+		}
+		return "├──"
+	}, func(n, i int) string {
+		if i == n-1 {
+			return "   "
+		}
+		return "│  "
+	}},
+	{"arabic", func(n, i int) string { return fmt.Sprintf("%d.", i+1) }, func(n, i int) string { return "  " }},
+	{"star", func(n, i int) string { return "*" }, func(n, i int) string { return "" }},
+}
+
+func padTo(s string, w int) string { return s + strings.Repeat(" ", max(0, w-ansi.StringWidth(s))) }
+
+func blockWidth(lines []string) int {
+	w := 0
+	for _, l := range lines {
+		w = max(w, ansi.StringWidth(l))
+	}
+	return w
+}
+
+// modelRender lays the tree out as documented. multi reports a multi-line item (the Width
+// padding then differs, lipgloss/15).
+func modelRender(n *tnode, root bool, prefix string, es enumSpec, width int) (lines []string, multi bool) {
+	if root && n.value != "" {
+		lines = append(lines, padTo(n.value, width))
+	}
+	vis := n.visible()
+	maxLen := 0
+	for i := range vis {
+		maxLen = max(maxLen, ansi.StringWidth(es.enum(len(vis), i))+1)
+	}
+	for i, c := range vis {
+		enum := es.enum(len(vis), i) + " "
+		indent := es.ind(len(vis), i) + " "
+		nodePrefix := strings.Repeat(" ", maxLen-ansi.StringWidth(enum)) + enum
+		item := strings.Split(c.value, "\n")
+		if len(item) > 1 {
+			multi = true
+		}
+		// The prefix column blocks, as JoinVertical pads them.
+		npBlock := []string{nodePrefix}
+		for k := 1; k < len(item); k++ {
+			npBlock = append(npBlock, indent)
+		}
+		npw := blockWidth(npBlock)
+		iw := blockWidth(item)
+		for k, l := range item {
+			line := prefix + padTo(npBlock[k], npw) + padTo(l, iw)
+			lines = append(lines, padTo(line, width))
+		}
+		if len(c.children) > 0 {
+			sub, m := modelRender(c, false, prefix+indent, es, width)
+			multi = multi || m
+			lines = append(lines, sub...)
+		}
+	}
+	return lines, multi
+}
+
+func TestHegelTreeFollowsTheLayout(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		n := genNode(ht, 3)
+		n.hidden = false
+		n.value = strings.ReplaceAll(n.value, "\n", " ")
+		es := zootest.Pick(ht, enumerators)
+		width := 0
+		if zootest.Chance(ht, 40) {
+			width = zootest.N(ht, 3, 24)
+		}
+		tr := n.build()
+		switch es.name {
+		case "rounded":
+			tr = tr.Enumerator(tree.RoundedEnumerator)
+		case "arabic":
+			tr = tr.Enumerator(func(c tree.Children, i int) string { return fmt.Sprintf("%d.", i+1) }).Indenter(func(tree.Children, int) string { return "  " })
+		case "star":
+			tr = tr.Enumerator(func(tree.Children, int) string { return "*" }).Indenter(func(tree.Children, int) string { return "" })
+		}
+		if width > 0 {
+			tr = tr.Width(width)
+		}
+		zootest.Note(ht, "tree %s width %d enumerator %s", describe(n, ""), width, es.name)
+		out := tr.String()
+		want, multi := modelRender(n, true, "", es, width)
+		if out != strings.Join(want, "\n") {
+			// lipgloss/14: two or more hidden children at the end of a sibling list leave
+			// the last visible one with a non-final enumerator.
+			if trailingHidden(n) {
+				zootest.Count("lipgloss/14-shape")
+				return
+			}
+			// lipgloss/15: with a Width, only the last line of a multi-line item is padded.
+			if multi && width > 0 {
+				zootest.Count("lipgloss/15-shape")
+				return
+			}
+			// lipgloss/21: a hidden first child keeps its index, so the enumeration of the
+			// visible children starts at 2.
+			if es.name == "arabic" && hiddenFirst(n) {
+				zootest.Count("lipgloss/21-shape")
+				return
+			}
+			zootest.Fail(ht, "tree %s (enumerator %s, width %d) renders\n%s\nmodel\n%s", describe(n, ""), es.name, width, out, strings.Join(want, "\n"))
+		}
+		if width > 0 && out != "" {
+			for i, l := range strings.Split(out, "\n") {
+				if ansi.StringWidth(l) < width {
+					zootest.Fail(ht, "Width(%d): line %d %q is %d wide:\n%s", width, i, l, ansi.StringWidth(l), out)
+				}
+			}
+		}
+		zootest.Count("ok")
+	})
+}
+
+// trailingHidden reports a sibling list with two hidden children in a row after a visible
+// one, anywhere in the tree.
+func trailingHidden(n *tnode) bool {
+	ch := n.children[n.offStart:max(n.offStart, len(n.children)-n.offEnd)]
+	for i := 0; i+2 < len(ch)+1 && i+1 < len(ch); i++ {
+		if ch[i].hidden && ch[i+1].hidden {
+			return true
+		}
+	}
+	for _, c := range ch {
+		if trailingHidden(c) {
+			return true
+		}
+	}
+	return false
+}
+
+// hiddenFirst reports a node whose first child in range is hidden.
+func hiddenFirst(n *tnode) bool {
+	ch := n.children[n.offStart:max(n.offStart, len(n.children)-n.offEnd)]
+	if len(ch) > 0 && ch[0].hidden {
+		return true
+	}
+	for _, c := range ch {
+		if hiddenFirst(c) {
+			return true
+		}
+	}
+	return false
+}
+
+func describe(n *tnode, indent string) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "%s%q", indent, n.value)
+	if n.hidden {
+		sb.WriteString(" hidden")
+	}
+	if n.sub {
+		sb.WriteString(" (sublist)")
+	}
+	if n.offStart > 0 || n.offEnd > 0 {
+		fmt.Fprintf(&sb, " offset(%d,%d)", n.offStart, n.offEnd)
+	}
+	for _, c := range n.children {
+		sb.WriteString("\n" + describe(c, indent+"  "))
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------- list enumerators
+
+func romanRef(n int) string {
+	vals := []int{1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1}
+	syms := []string{"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"}
+	var sb strings.Builder
+	for i, v := range vals {
+		for n >= v {
+			n -= v
+			sb.WriteString(syms[i])
+		}
+	}
+	return sb.String()
+}
+
+// alphaRef is the bijective base-26 numbering (A…Z, AA…ZZ, AAA…).
+func alphaRef(n int) string {
+	var out []byte
+	for n >= 0 {
+		out = append([]byte{byte('A' + n%26)}, out...)
+		n = n/26 - 1
+	}
+	return string(out)
+}
+
+func TestHegelListEnumeratorsCount(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		i := zootest.N(ht, 0, 4000)
+		if got, want := list.Roman(nil, i), romanRef(i+1)+"."; got != want {
+			zootest.Fail(ht, "Roman(%d) = %q, want %q", i, got, want)
+		}
+		if got, want := list.Arabic(nil, i), fmt.Sprintf("%d.", i+1); got != want {
+			zootest.Fail(ht, "Arabic(%d) = %q, want %q", i, got, want)
+		}
+		if i < 26*26*26+26*26+26 {
+			if i >= 702 && (i/26)%26 == 0 {
+				// lipgloss/17: the middle letter comes out as '@'.
+				zootest.Count("lipgloss/17-shape")
+			} else if got, want := list.Alphabet(nil, i), alphaRef(i)+"."; got != want {
+				zootest.Fail(ht, "Alphabet(%d) = %q, want %q", i, got, want)
+			}
+		}
+		zootest.Count("ok")
+	})
+}
+
+// TestHegelListsNestAsTrees: a list is a tree with the bullet enumerator and a one-space
+// indenter; nested lists keep their own enumerator.
+func TestHegelListsNestAsTrees(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		var build func(depth int) (*list.List, *tnode)
+		build = func(depth int) (*list.List, *tnode) {
+			l := list.New()
+			n := &tnode{}
+			for k := zootest.N(ht, 0, 4); k > 0; k-- {
+				if depth > 0 && zootest.Chance(ht, 30) {
+					sub, sn := build(depth - 1)
+					sn.sub = true
+					l.Item(sub)
+					n.children = append(n.children, sn)
+					continue
+				}
+				v := genValue(ht, false)
+				l.Item(v)
+				n.children = append(n.children, &tnode{value: v})
+			}
+			return l, n
+		}
+		l, n := build(2)
+		zootest.Note(ht, "list %s", describe(n, ""))
+		out := l.String()
+		// Auto-nesting, as documented for Child: a nested list (a rootless tree) becomes
+		// the previous item (taking its value) or merges into a previous nested list.
+		sim := simulate(n)
+		var want []string
+		var walk func(n *tnode, prefix string)
+		walk = func(n *tnode, prefix string) {
+			for _, c := range n.children {
+				want = append(want, prefix+"• "+c.value)
+				walk(c, prefix+"  ")
+			}
+		}
+		walk(sim, "")
+		if out != strings.Join(want, "\n") {
+			zootest.Fail(ht, "list %s renders\n%s\nmodel\n%s", describe(n, ""), out, strings.Join(want, "\n"))
+		}
+		zootest.Count("ok")
+	})
+}
+
+// simulate rebuilds the item tree the way tree.Child nests rootless trees.
+func simulate(n *tnode) *tnode {
+	out := &tnode{value: n.value, sub: n.sub}
+	for _, c := range n.children {
+		addChild(out, simulate(c))
+	}
+	return out
+}
+
+func addChild(parent, item *tnode) {
+	if item.sub && item.value == "" && len(parent.children) > 0 {
+		prev := parent.children[len(parent.children)-1]
+		if prev.sub {
+			for _, c := range item.children {
+				addChild(prev, c)
+			}
+			return
+		}
+		parent.children = parent.children[:len(parent.children)-1]
+		item = &tnode{value: prev.value, sub: true, children: item.children}
+	}
+	parent.children = append(parent.children, item)
+}
+
+// ---------------------------------------------------------------- pins
+
+// lipgloss/20: a rootless child tree takes over its previous sibling leaf — value only: the
+// leaf's hidden flag is dropped, so a hidden item becomes visible when a nested list
+// follows it.
+func TestHegelPinAutoNestingUnhidesTheLeaf(t *testing.T) {
+	defer zootest.Guard(t)
+	out := tree.Root("r").Child("a", tree.NewLeaf("h", true), tree.New().Child("x")).String()
+	if !strings.Contains(out, "h") {
+		t.Fatalf("fixed:\n%s", out)
+	}
+	t.Fatalf("Root(\"r\").Child(\"a\", hidden \"h\", tree.New().Child(\"x\")) renders the hidden leaf:\n%s", out)
+}
+
+// lipgloss/14: the renderer drops a hidden child only when it directly follows the child
+// being examined, once, so two hidden children at the end of a sibling list leave one of
+// them counted and the last visible child gets the non-final "├──".
+func TestHegelPinTrailingHiddenChildrenKeepTheBranch(t *testing.T) {
+	defer zootest.Guard(t)
+	out := tree.Root("r").Child("a", "b", tree.NewLeaf("c", true), tree.NewLeaf("d", true)).String()
+	if strings.Contains(out, "└── b") {
+		t.Fatalf("fixed:\n%s", out)
+	}
+	t.Fatalf("Root(\"r\").Child(\"a\", \"b\", hidden, hidden) renders\n%s\nthe last visible child b has no final branch", out)
+}
+
+// lipgloss/15: Width pads `line + Render(spaces)` where line is the whole multi-line item, so
+// only its last line reaches the width; the first line stays short.
+func TestHegelPinWidthPadsOnlyTheLastLineOfAMultilineItem(t *testing.T) {
+	defer zootest.Guard(t)
+	out := tree.Root("r").Child("a\nb").Width(10).String()
+	lines := strings.Split(out, "\n")
+	for i, l := range lines {
+		if ansi.StringWidth(l) != 10 {
+			t.Fatalf("Root(\"r\").Child(\"a\\nb\").Width(10): line %d %q is %d wide:\n%s", i, l, ansi.StringWidth(l), out)
+		}
+	}
+	t.Fatalf("fixed:\n%s", out)
+}
+
+// lipgloss/16: Offset(start, end) documents `end` as an index ("Offset(1, -1)" keeps B–D in
+// the list doc) but Children() uses it as a count from the end, so the documented call shows
+// nothing.
+func TestHegelPinOffsetEndIsACountFromTheEnd(t *testing.T) {
+	defer zootest.Guard(t)
+	out := list.New("A", "B", "C", "D").Offset(1, -1).String()
+	if strings.Contains(out, "B") && strings.Contains(out, "D") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("list.New(\"A\", \"B\", \"C\", \"D\").Offset(1, -1) renders %q; the doc shows B, C, D", out)
+}
+
+// lipgloss/17: Alphabet's three-letter formula computes the middle letter as
+// 'A'+(i/26)%26-1, which is '@' whenever (i/26)%26 == 0: every 26th block of 26 indexes from
+// 702 up gets a non-letter label.
+func TestHegelPinAlphabetEnumeratorYieldsAnAtSign(t *testing.T) {
+	defer zootest.Guard(t)
+	got := list.Alphabet(nil, 1364)
+	if got == "AZM." {
+		t.Fatalf("fixed: %q", got)
+	}
+	t.Fatalf("list.Alphabet(nil, 1364) = %q, want %q (bijective base 26); Alphabet(701) = %q, Alphabet(702) = %q", got, "AZM.", list.Alphabet(nil, 701), list.Alphabet(nil, 702))
+}
+
+// lipgloss/21: the renderer removes a hidden child from the enumeration only when it follows
+// the child being examined, so a hidden first child keeps its index and the visible items
+// are numbered from 2.
+func TestHegelPinHiddenFirstItemShiftsTheNumbering(t *testing.T) {
+	defer zootest.Guard(t)
+	out := list.New(tree.NewLeaf("h", true), "a", "b").Enumerator(list.Arabic).String()
+	if strings.HasPrefix(out, "1. a") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("list.New(hidden, \"a\", \"b\").Enumerator(list.Arabic) renders %q", out)
+}
