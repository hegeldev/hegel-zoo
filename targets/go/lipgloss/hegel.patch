diff --git a/hegel_canvas_test.go b/hegel_canvas_test.go
new file mode 100644
index 0000000..900be69
--- /dev/null
+++ b/hegel_canvas_test.go
@@ -0,0 +1,235 @@
+package lipgloss
+
+// Hegel property tests for Layer, Compositor and Canvas (hegel-zoo target go/lipgloss): a
+// random layer tree is flattened and painted by a cell model — absolute positions, z order
+// with insertion order for ties, later cells on top — and compared with Compositor.Render
+// and Hit; Layer.Width/Height are the union bounds.
+
+import (
+	"image"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+type layerSpec struct {
+	id       string
+	content  string
+	x, y, z  int
+	bg       bool
+	children []*layerSpec
+}
+
+func genLayer(tc hegel.TestCase, depth int, id *int) *layerSpec {
+	l := &layerSpec{x: n(tc, 0, 8), y: n(tc, 0, 4), z: n(tc, 0, 3)}
+	if chance(tc, 80) {
+		l.id = "l" + string(rune('a'+*id))
+	}
+	*id++
+	var lines []string
+	for k := n(tc, 1, 3); k > 0; k-- {
+		var sb strings.Builder
+		for j := n(tc, 0, 5); j > 0; j-- {
+			if chance(tc, 20) {
+				sb.WriteByte(' ')
+			} else {
+				sb.WriteString(pick(tc, narrowGraphemes))
+			}
+		}
+		lines = append(lines, sb.String())
+	}
+	l.content = strings.Join(lines, "\n")
+	if chance(tc, 30) {
+		l.bg = true
+		l.content = NewStyle().Background(Color("2")).Render(l.content)
+	}
+	if depth > 0 && chance(tc, 30) {
+		for k := n(tc, 1, 2); k > 0; k-- {
+			l.children = append(l.children, genLayer(tc, depth-1, id))
+		}
+	}
+	return l
+}
+
+func (l *layerSpec) build() *Layer {
+	lay := NewLayer(l.content).X(l.x).Y(l.y).Z(l.z).ID(l.id)
+	for _, c := range l.children {
+		lay.AddLayers(c.build())
+	}
+	return lay
+}
+
+type flatLayer struct {
+	spec   *layerSpec
+	absX   int
+	absY   int
+	bounds image.Rectangle
+}
+
+func flatten(l *layerSpec, px, py int, out *[]flatLayer) {
+	ax, ay := l.x+px, l.y+py
+	w, h := Width(l.content), Height(l.content)
+	*out = append(*out, flatLayer{l, ax, ay, image.Rect(ax, ay, ax+w, ay+h)})
+	for _, c := range l.children {
+		flatten(c, ax, ay, out)
+	}
+}
+
+func TestHegelCompositorPaintsLayersInOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		id := 0
+		var roots []*layerSpec
+		for k := n(ht, 1, 4); k > 0; k-- {
+			roots = append(roots, genLayer(ht, 1, &id))
+		}
+		if chance(ht, 70) {
+			roots[0].x, roots[0].y = 0, 0
+		}
+		var built []*Layer
+		var flat []flatLayer
+		for _, r := range roots {
+			built = append(built, r.build())
+			flatten(r, 0, 0, &flat)
+		}
+		note(ht, "layers %+v", flat)
+		c := NewCompositor(built...)
+		// Bounds: the union of every layer's rectangle (the root is empty at the origin).
+		bounds := image.Rect(0, 0, 0, 0)
+		for _, f := range flat {
+			bounds = bounds.Union(f.bounds)
+		}
+		if c.Bounds() != bounds {
+			fail(ht, "Bounds() = %v, the union of the layers is %v", c.Bounds(), bounds)
+		}
+		// Layer sizes are their own union bounds.
+		for i, r := range roots {
+			var sub []flatLayer
+			flatten(r, 0, 0, &sub)
+			u := sub[0].bounds
+			for _, f := range sub {
+				u = u.Union(f.bounds)
+			}
+			if built[i].Width() != u.Dx() || built[i].Height() != u.Dy() {
+				fail(ht, "layer %d is %dx%d, its union bounds are %v", i, built[i].Width(), built[i].Height(), u)
+			}
+		}
+		// Paint: by z, ties in insertion order, later on top.
+		w, h := bounds.Dx(), bounds.Dy()
+		grid := make([][]mcell, h)
+		for y := range grid {
+			grid[y] = make([]mcell, w)
+			for x := range grid[y] {
+				grid[y][x] = mcell{g: " ", w: 1}
+			}
+		}
+		top := make([][]string, h)
+		for y := range top {
+			top[y] = make([]string, w)
+		}
+		for z := 0; z <= 3; z++ {
+			for _, f := range flat {
+				if f.spec.z != z {
+					continue
+				}
+				// A layer is a rectangle: short lines are padded with blank cells.
+				lw := f.bounds.Dx()
+				for cy, row := range parseCells(f.spec.content) {
+					x := f.absX - bounds.Min.X
+					y := f.absY + cy - bounds.Min.Y
+					for _, cell := range row {
+						if y >= 0 && y < h && x >= 0 && x+cell.w <= w {
+							grid[y][x] = cell
+							for k := 1; k < cell.w; k++ {
+								grid[y][x+k] = mcell{g: "", w: 0}
+							}
+						}
+						x += cell.w
+					}
+					for ; x < f.absX-bounds.Min.X+lw; x++ {
+						if y >= 0 && y < h && x >= 0 && x < w {
+							grid[y][x] = mcell{g: " ", w: 1}
+						}
+					}
+				}
+				// Hit testing sees the whole rectangle, blank cells included.
+				if f.spec.id != "" {
+					for y := f.bounds.Min.Y; y < f.bounds.Max.Y; y++ {
+						for x := f.bounds.Min.X; x < f.bounds.Max.X; x++ {
+							if y-bounds.Min.Y < h && x-bounds.Min.X < w {
+								top[y-bounds.Min.Y][x-bounds.Min.X] = f.spec.id
+							}
+						}
+					}
+				}
+			}
+		}
+		out := c.Render()
+		if bounds.Min != (image.Point{}) {
+			// lipgloss/19: Render draws at absolute coordinates on a canvas sized to the
+			// bounds, so anything not starting at the origin is lost.
+			count("lipgloss/19-shape")
+		} else {
+			// TrimSpace drops trailing blanks that carry no style.
+			var want []string
+			for y := range grid {
+				row := grid[y]
+				for len(row) > 0 && row[len(row)-1].g == " " && row[len(row)-1].st == (mstyle{}) {
+					row = row[:len(row)-1]
+				}
+				var sb strings.Builder
+				for _, cell := range row {
+					sb.WriteString(cell.g)
+				}
+				want = append(want, sb.String())
+			}
+			got := strings.Split(out, "\n")
+			for i := range got {
+				got[i] = ansi.Strip(got[i])
+			}
+			for len(want) > len(got) && strings.TrimSpace(want[len(want)-1]) == "" {
+				want = want[:len(want)-1]
+			}
+			if strings.Join(got, "\n") != strings.Join(want, "\n") {
+				fail(ht, "Render() =\n%s\nmodel\n%s\nlayers %+v", strings.Join(got, "\n"), strings.Join(want, "\n"), flat)
+			}
+			// Styles: a painted cell keeps its background.
+			rows := parseCells(out)
+			for y := range rows {
+				x := 0
+				for _, cell := range rows[y] {
+					if x < w && grid[y][x].w > 0 && !colorEqual(cell.st.bg, grid[y][x].st.bg) {
+						fail(ht, "cell (%d,%d) has bg %v, model %v:\n%s", x, y, cell.st.bg, grid[y][x].st.bg, out)
+					}
+					x += cell.w
+				}
+			}
+		}
+		// Hit tests over the bounds and a margin around them.
+		for k := 0; k < 6; k++ {
+			x, y := n(ht, bounds.Min.X-1, bounds.Max.X), n(ht, bounds.Min.Y-1, bounds.Max.Y)
+			want := ""
+			if x >= bounds.Min.X && y >= bounds.Min.Y && x < bounds.Max.X && y < bounds.Max.Y {
+				want = top[y-bounds.Min.Y][x-bounds.Min.X]
+			}
+			if got := c.Hit(x, y).ID(); got != want {
+				fail(ht, "Hit(%d,%d) = %q, model %q; layers %+v", x, y, got, want, flat)
+			}
+		}
+		count("ok")
+	})
+}
+
+// lipgloss/19: Compositor.Render makes a canvas of the bounds' size and draws every layer at
+// its absolute position, so a layer tree that does not start at the origin renders shifted
+// off the canvas — nothing at all when it starts below and to the right.
+func TestHegelPinCompositorRenderDropsContentAwayFromTheOrigin(t *testing.T) {
+	defer guard(t)
+	c := NewCompositor(NewLayer("ab").X(3).Y(2))
+	out := c.Render()
+	if strings.Contains(out, "ab") {
+		t.Fatalf("fixed: %q", out)
+	}
+	t.Fatalf("NewCompositor(NewLayer(\"ab\").X(3).Y(2)).Render() = %q (bounds %v)", out, c.Bounds())
+}
