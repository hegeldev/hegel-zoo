+// Package hegel holds the Hegel zoo's property tests for ssh_config:
+// generated ssh_config files against ssh -G.
+package hegel
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..11ca6bb
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,83 @@
+package hegel
+
+import (
+	"testing"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are what ssh -G reports for the same
+// file (OpenSSH 9.6) and what ssh_config(5) says.
+
+func get(t *testing.T, text, alias, key string) string {
+	t.Helper()
+	cfg, err := ssh_config.DecodeBytes([]byte(text))
+	if err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	v, err := cfg.Get(alias, key)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	return v
+}
+
+// ssh_config/1: the patterns of a Host line are separated by whitespace,
+// tabs included; the package splits them on spaces only.
+func TestHegelPinTabSeparatedHostPatterns(t *testing.T) {
+	if got := get(t, "Host foo\tbar\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Host foo<TAB>bar: Port for bar = %q; ssh -G gives 2222 (two patterns)", got)
+	}
+	if got := get(t, "Host\tfoo\tbar\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Host<TAB>foo<TAB>bar: Port for foo = %q; ssh -G gives 2222", got)
+	}
+}
+
+// ssh_config/2: "?" matches exactly one character (ssh_config(5),
+// PATTERNS); the package compiles it to ".?", zero or one, so "fo?" matches
+// "fo" and "??" matches "x".
+func TestHegelPinQuestionMarkIsOneCharacter(t *testing.T) {
+	if got := get(t, "Host fo?\n Port 2222\n", "fo", "Port"); got != "" {
+		t.Errorf("Host fo?: Port for fo = %q; ssh -G does not match fo (22)", got)
+	}
+	if got := get(t, "Host ??\n Port 2222\n", "x", "Port"); got != "" {
+		t.Errorf("Host ??: Port for x = %q; ssh -G does not match x (22)", got)
+	}
+	if got := get(t, "Host fo?\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Host fo?: Port for foo = %q; want 2222", got)
+	}
+}
+
+// ssh_config/3: the argument of Match host is a comma-separated pattern
+// list (ssh_config(5): "Match host ... patterns are comma-separated"); the
+// package reads it as one pattern with a literal comma.
+func TestHegelPinMatchHostCommaList(t *testing.T) {
+	if got := get(t, "Match host foo,bar\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Match host foo,bar: Port for bar = %q; ssh -G gives 2222", got)
+	}
+	if got := get(t, "Match host !foo,*\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Match host !foo,*: Port for bar = %q; ssh -G gives 2222", got)
+	}
+}
+
+// ssh_config/4: Match host is matched against the target hostname after
+// HostName substitution (ssh_config(5)), not against the alias.
+func TestHegelPinMatchHostUsesHostName(t *testing.T) {
+	text := "Host foo\n HostName bar\nMatch host bar\n Port 2222\nMatch host foo\n Port 3333\n"
+	if got := get(t, text, "foo", "Port"); got != "2222" {
+		t.Errorf("Host foo / HostName bar / Match host bar: Port for foo = %q; ssh -G gives 2222 (Match host sees the hostname bar)", got)
+	}
+}
+
+// ssh_config/5: Match host compares case-insensitively (ssh lowercases the
+// hostname and match_pattern_list folds the pattern); the package's regexp
+// is case-sensitive.
+func TestHegelPinMatchHostCaseInsensitive(t *testing.T) {
+	if got := get(t, "Match host FOO\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Match host FOO: Port for foo = %q; ssh -G gives 2222", got)
+	}
+	if got := get(t, "Match host foo\n Port 2222\n", "FOO", "Port"); got != "2222" {
+		t.Errorf("Match host foo: Port for FOO = %q; ssh -G gives 2222 (the hostname is lowercased)", got)
+	}
+}
diff --git a/hegel/hegel_ssh_test.go b/hegel/hegel_ssh_test.go
new file mode 100644
index 0000000..d598db6
--- /dev/null
+++ b/hegel/hegel_ssh_test.go
@@ -0,0 +1,467 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// ---------------------------------------------------------------------------
+// The keywords compared. ssh -G prints every keyword's effective value, in
+// lower case; the package answers Get (first value wins) or GetAll (for the
+// keywords that accumulate).
+
+type keyword struct {
+	name   string // as ssh -G prints it
+	plural bool   // accumulates across matching blocks (GetAll)
+	rest   bool   // takes the rest of the line (no end-of-line comment)
+	gen    func(tc hegel.TestCase) string
+}
+
+var (
+	yesno = func(tc hegel.TestCase) string { return pick(tc, "yes", "no") }
+	small = func(tc hegel.TestCase) string { return pick(tc, "1", "2", "3", "5", "10", "30", "60") }
+	words = func(tc hegel.TestCase) string { return pick(tc, "alice", "bob", "Alice", "a_b", "root", "u-1") }
+	paths = func(tc hegel.TestCase) string {
+		return pick(tc, "~/.ssh/id_rsa", "~/.ssh/id_ed25519", "/tmp/key", "key1", "~/k.pem", "./id")
+	}
+)
+
+var keywords = []keyword{
+	{"port", false, false, func(tc hegel.TestCase) string { return pick(tc, "22", "2222", "22222", "1", "65535", "443") }},
+	{"user", false, false, words},
+	{"hostname", false, false, func(tc hegel.TestCase) string {
+		return pick(tc, "example.com", "10.0.0.1", "host1", "EXAMPLE.org", "h.internal")
+	}},
+	{"compression", false, false, yesno},
+	{"forwardagent", false, false, yesno},
+	{"identitiesonly", false, false, yesno},
+	{"batchmode", false, false, yesno},
+	{"connecttimeout", false, false, small},
+	{"serveraliveinterval", false, false, small},
+	{"serveralivecountmax", false, false, small},
+	{"loglevel", false, false, func(tc hegel.TestCase) string {
+		return pick(tc, "QUIET", "FATAL", "ERROR", "INFO", "VERBOSE", "DEBUG", "DEBUG1", "DEBUG2", "DEBUG3")
+	}},
+	{"stricthostkeychecking", false, false, func(tc hegel.TestCase) string { return pick(tc, "yes", "no", "ask", "accept-new") }},
+	{"requesttty", false, false, func(tc hegel.TestCase) string { return pick(tc, "yes", "no", "force", "auto") }},
+	{"addressfamily", false, false, func(tc hegel.TestCase) string { return pick(tc, "any", "inet", "inet6") }},
+	{"hostkeyalias", false, false, words},
+	{"proxycommand", false, true, func(tc hegel.TestCase) string {
+		return pick(tc, "nc %h %p", "ssh -W %h:%p jump", "none", "/usr/bin/nc -X 5 -x localhost:1080 %h %p", "connect")
+	}},
+	{"localcommand", false, true, func(tc hegel.TestCase) string { return pick(tc, "echo hi there", "true", "echo %h") }},
+	{"identityfile", true, false, paths},
+	{"certificatefile", true, false, func(tc hegel.TestCase) string { return pick(tc, "c1", "~/.ssh/c2-cert.pub", "/etc/c3") }},
+	{"sendenv", true, false, func(tc hegel.TestCase) string {
+		k := n(tc, 1, 3)
+		var vs []string
+		for i := 0; i < k; i++ {
+			vs = append(vs, pick(tc, "LANG", "LC_ALL", "FOO", "A", "LC_*"))
+		}
+		return strings.Join(vs, pick(tc, " ", "  ", "\t"))
+	}},
+	{"setenv", true, false, func(tc hegel.TestCase) string {
+		k := n(tc, 1, 2)
+		var vs []string
+		for i := 0; i < k; i++ {
+			vs = append(vs, pick(tc, "A=1", "B=two", "TERM=xterm"))
+		}
+		return strings.Join(vs, " ")
+	}},
+}
+
+// keywordSpelling is how the keyword appears in the file.
+func keywordSpelling(tc hegel.TestCase, k keyword) string {
+	canonical := map[string]string{
+		"port": "Port", "user": "User", "hostname": "HostName", "compression": "Compression",
+		"forwardagent": "ForwardAgent", "identitiesonly": "IdentitiesOnly", "batchmode": "BatchMode",
+		"connecttimeout": "ConnectTimeout", "serveraliveinterval": "ServerAliveInterval",
+		"serveralivecountmax": "ServerAliveCountMax", "loglevel": "LogLevel",
+		"stricthostkeychecking": "StrictHostKeyChecking", "requesttty": "RequestTTY",
+		"addressfamily": "AddressFamily", "hostkeyalias": "HostKeyAlias", "proxycommand": "ProxyCommand",
+		"localcommand": "LocalCommand", "identityfile": "IdentityFile", "certificatefile": "CertificateFile",
+		"sendenv": "SendEnv", "setenv": "SetEnv",
+	}
+	switch n(tc, 1, 10) {
+	case 1:
+		return k.name
+	case 2:
+		return strings.ToUpper(k.name)
+	default:
+		return canonical[k.name]
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The generated config.
+
+var patterns = []string{
+	"foo", "foo*", "*bar", "f?o", "fo?", "*", "!foobar", "!*bar", "a.b", "*.example.com",
+	"10.0.0.?", "?", "foo?", "*.*", "FOO", "!foo", "10.0.0.*", "a.*", "??", "b*r",
+}
+
+var aliases = []string{"foo", "foobar", "bar", "a.b", "a.example.com", "x", "10.0.0.1", "10.0.0.12", "FOO", "fo", "ab"}
+
+// directive is one keyword line.
+type directive struct {
+	key   keyword
+	value string
+	text  string // the line as written
+}
+
+// block is a Host or Match line (or the implicit leading block) and its
+// directives.
+type block struct {
+	patterns   []string // empty for the implicit block and for Match all
+	match      bool     // a Match line: "Match all" (no patterns) or "Match host <list>"
+	hostLine   string
+	directives []directive
+}
+
+type config struct {
+	blocks   []block
+	text     string
+	hasMatch bool
+}
+
+func (c *config) String() string { return c.text }
+
+func genConfig(tc hegel.TestCase) *config {
+	c := &config{}
+	var b strings.Builder
+	eol := pick(tc, "\n", "\n", "\n", "\r\n")
+	withMatch := chance(tc, 25)
+	// Sometimes directives before any Host line (the implicit Host *).
+	if chance(tc, 30) {
+		bl := block{}
+		genDirectives(tc, &bl, &b, eol, withMatch)
+		c.blocks = append(c.blocks, bl)
+	}
+	k := n(tc, 0, 4)
+	// Under HEGEL_NO_KNOWN a config with Match blocks has no HostName
+	// directive, no comma lists and no upper case (the shapes of bugs 3-5).
+	for i := 0; i < k; i++ {
+		bl := block{}
+		var line strings.Builder
+		line.WriteString(pick(tc, "", "", "  ", "\t"))
+		if withMatch && chance(tc, 50) {
+			bl.match = true
+			c.hasMatch = true
+			line.WriteString(pick(tc, "Match", "Match", "match", "MATCH"))
+			line.WriteString(pick(tc, " ", " ", "\t", "  "))
+			if chance(tc, 25) {
+				line.WriteString(pick(tc, "all", "all", "ALL"))
+			} else {
+				line.WriteString(pick(tc, "host", "host", "Host"))
+				line.WriteString(pick(tc, " ", " ", "\t"))
+				m := n(tc, 1, 3)
+				if noKnown {
+					m = 1
+				}
+				for j := 0; j < m; j++ {
+					p := pick(tc, patterns...)
+					if noKnown {
+						p = strings.ToLower(p)
+					}
+					bl.patterns = append(bl.patterns, p)
+				}
+				line.WriteString(strings.Join(bl.patterns, ","))
+			}
+		} else {
+			m := n(tc, 1, 3)
+			for j := 0; j < m; j++ {
+				bl.patterns = append(bl.patterns, pick(tc, patterns...))
+			}
+			line.WriteString(pick(tc, "Host", "Host", "host", "HOST"))
+			line.WriteString(pick(tc, " ", " ", "\t", " = ", "="))
+			sep := pick(tc, " ", " ", "  ", "\t")
+			if noKnown && sep == "\t" {
+				sep = " "
+			}
+			line.WriteString(strings.Join(bl.patterns, sep))
+		}
+		if chance(tc, 15) {
+			line.WriteString(pick(tc, " # hosts", "  #c", " #"))
+		}
+		bl.hostLine = line.String()
+		b.WriteString(bl.hostLine + eol)
+		genDirectives(tc, &bl, &b, eol, withMatch)
+		c.blocks = append(c.blocks, bl)
+	}
+	c.text = b.String()
+	return c
+}
+
+func genDirectives(tc hegel.TestCase, bl *block, b *strings.Builder, eol string, withMatch bool) {
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 12) {
+		case 1:
+			b.WriteString(pick(tc, "", "  ", "\t") + eol) // a blank line
+			continue
+		case 2:
+			b.WriteString(pick(tc, "# comment", "  # indented", "#", "\t#x") + eol)
+			continue
+		}
+		kw := pick(tc, keywords...)
+		if noKnown && kw.name == "hostname" && withMatch {
+			kw = keywords[0] // Port
+		}
+		val := kw.gen(tc)
+		var line strings.Builder
+		line.WriteString(pick(tc, "  ", "  ", "\t", "", "    "))
+		line.WriteString(keywordSpelling(tc, kw))
+		line.WriteString(pick(tc, " ", " ", "\t", " = ", "=", "  "))
+		written := val
+		if !kw.rest && !strings.ContainsAny(val, " \t") && chance(tc, 15) {
+			written = `"` + val + `"`
+		}
+		if kw.name == "identityfile" && chance(tc, 10) {
+			val = pick(tc, "~/.ssh/my key", "a b")
+			written = `"` + val + `"`
+		}
+		line.WriteString(written)
+		if !kw.rest && chance(tc, 15) {
+			line.WriteString(pick(tc, " # c", "  #comment", "\t# x"))
+		} else if chance(tc, 10) {
+			line.WriteString(pick(tc, " ", "\t", "  "))
+		}
+		bl.directives = append(bl.directives, directive{key: kw, value: val, text: line.String()})
+		b.WriteString(line.String() + eol)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// ssh -G.
+
+var (
+	sshDefaultsOnce sync.Once
+	sshDefaults     map[string][]string
+	sshDefaultsErr  error
+	sshDir          string
+)
+
+// sshG runs ssh -G -F on the config text for alias and returns the printed
+// keyword values (several lines for the accumulating keywords).
+func sshG(text, alias string) (map[string][]string, string, error) {
+	f, err := os.CreateTemp(sshDir, "cfg")
+	if err != nil {
+		return nil, "", err
+	}
+	defer os.Remove(f.Name())
+	if _, err := f.WriteString(text); err != nil {
+		return nil, "", err
+	}
+	f.Close()
+	cmd := exec.Command("ssh", "-G", "-F", f.Name(), "--", alias)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, strings.TrimSpace(stderr.String()), fmt.Errorf("ssh -G: %v", err)
+	}
+	m := map[string][]string{}
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		if line == "" {
+			continue
+		}
+		k, v, _ := strings.Cut(line, " ")
+		m[k] = append(m[k], v)
+	}
+	return m, "", nil
+}
+
+func setupSSH(t testing.TB) {
+	t.Helper()
+	sshDefaultsOnce.Do(func() {
+		if _, err := exec.LookPath("ssh"); err != nil {
+			sshDefaultsErr = fmt.Errorf("ssh not found: %v", err)
+			return
+		}
+		sshDir, sshDefaultsErr = os.MkdirTemp("", "hegel-ssh")
+		if sshDefaultsErr != nil {
+			return
+		}
+		m, stderr, err := sshG("", "hegel-defaults")
+		if err != nil {
+			sshDefaultsErr = fmt.Errorf("%v\n%s", err, stderr)
+			return
+		}
+		sshDefaults = m
+	})
+	if sshDefaultsErr != nil {
+		t.Fatalf("%v", sshDefaultsErr)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The package's answer, spelled as ssh -G prints it.
+
+// libValues answers for one keyword: what ssh -G would print if the package
+// were right, given its Get/GetAll answer and ssh's defaults.
+func libValues(cfg *ssh_config.Config, alias string, k keyword) ([]string, error) {
+	if k.plural {
+		vals, err := cfg.GetAll(alias, k.name)
+		if err != nil {
+			return nil, err
+		}
+		var out []string
+		switch k.name {
+		case "sendenv":
+			for _, v := range vals {
+				out = append(out, strings.Fields(v)...)
+			}
+		case "setenv":
+			// ssh takes SetEnv from the first directive that applies only
+			// (the option is one list, not accumulated as SendEnv is), and
+			// keeps the first assignment of a variable within it.
+			if len(vals) > 0 {
+				seen := map[string]bool{}
+				for _, f := range strings.Fields(vals[0]) {
+					name, _, _ := strings.Cut(f, "=")
+					if !seen[name] {
+						seen[name] = true
+						out = append(out, f)
+					}
+				}
+			}
+		default:
+			// ssh ignores a file named a second time.
+			seen := map[string]bool{}
+			for _, v := range vals {
+				if !seen[v] {
+					seen[v] = true
+					out = append(out, v)
+				}
+			}
+		}
+		if len(out) == 0 {
+			return sshDefaults[k.name], nil
+		}
+		return out, nil
+	}
+	v, err := cfg.Get(alias, k.name)
+	if err != nil {
+		return nil, err
+	}
+	// ssh's spellings of the effective values.
+	switch k.name {
+	case "hostname":
+		if v == "" {
+			v = alias
+		}
+		return []string{strings.ToLower(v)}, nil
+	case "hostkeyalias":
+		v = strings.ToLower(v)
+	case "requesttty", "stricthostkeychecking":
+		switch v {
+		case "yes":
+			v = "true"
+		case "no":
+			v = "false"
+		}
+	case "loglevel":
+		switch v {
+		case "DEBUG1":
+			v = "DEBUG"
+		case "QUIET":
+			v = "SILENT"
+		}
+	case "serveraliveinterval":
+		// BatchMode yes gives ServerAliveInterval a default of 300.
+		if v == "" {
+			if bm, _ := cfg.Get(alias, "batchmode"); bm == "yes" {
+				v = "300"
+			}
+		}
+	case "proxycommand":
+		if v == "none" {
+			return nil, nil // unset
+		}
+	}
+	if v == "" {
+		return sshDefaults[k.name], nil
+	}
+	return []string{v}, nil
+}
+
+// ---------------------------------------------------------------------------
+// The property.
+
+func TestHegelMatchesSSH(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		c := genConfig(ht)
+		alias := pick(ht, aliases...)
+		if noKnown && c.hasMatch {
+			alias = strings.ToLower(alias)
+		}
+		want, stderr, err := sshG(c.text, alias)
+		if err != nil {
+			count("ssh rejects: " + firstLine(stderr))
+			return
+		}
+		cfg, err := ssh_config.DecodeBytes([]byte(c.text))
+		if err != nil {
+			fail(ht, "ssh_config rejects (%v) what ssh accepts\n%s", err, show(c, alias))
+		}
+		for _, k := range keywords {
+			got, err := libValues(cfg, alias, k)
+			if err != nil {
+				fail(ht, "Get(%q, %q): %v\n%s", alias, k.name, err, show(c, alias))
+			}
+			w := want[k.name]
+			if !equalStrings(got, w) {
+				if kb := known(c, alias, k.name); kb != "" {
+					count("known " + kb)
+					continue
+				}
+				fail(ht, "%s for %q: ssh_config %q, ssh -G %q\n%s", k.name, alias, got, w, show(c, alias))
+			}
+		}
+		count("ok")
+	})
+}
+
+func firstLine(s string) string {
+	s, _, _ = strings.Cut(s, "\n")
+	// Strip the temp file name and line number.
+	if i := strings.Index(s, ": line "); i >= 0 {
+		if j := strings.Index(s[i+7:], ": "); j >= 0 {
+			s = s[i+7+j+2:]
+		}
+	}
+	return s
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func show(c *config, alias string) string {
+	return fmt.Sprintf("alias: %s\nconfig:\n%s", alias, indent(c.text))
+}
+
+func indent(s string) string {
+	lines := strings.Split(strings.TrimRight(s, "\n"), "\n")
+	for i, l := range lines {
+		lines[i] = "  | " + l
+	}
+	return strings.Join(lines, "\n")
+}
