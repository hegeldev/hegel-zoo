+// Package hegel holds the Hegel zoo's property tests for ssh_config:
+// generated ssh_config files against ssh -G.
+package hegel
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..11ca6bb
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,83 @@
+package hegel
+
+import (
+	"testing"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are what ssh -G reports for the same
+// file (OpenSSH 9.6) and what ssh_config(5) says.
+
+func get(t *testing.T, text, alias, key string) string {
+	t.Helper()
+	cfg, err := ssh_config.DecodeBytes([]byte(text))
+	if err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	v, err := cfg.Get(alias, key)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	return v
+}
+
+// ssh_config/1: the patterns of a Host line are separated by whitespace,
+// tabs included; the package splits them on spaces only.
+func TestHegelPinTabSeparatedHostPatterns(t *testing.T) {
+	if got := get(t, "Host foo\tbar\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Host foo<TAB>bar: Port for bar = %q; ssh -G gives 2222 (two patterns)", got)
+	}
+	if got := get(t, "Host\tfoo\tbar\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Host<TAB>foo<TAB>bar: Port for foo = %q; ssh -G gives 2222", got)
+	}
+}
+
+// ssh_config/2: "?" matches exactly one character (ssh_config(5),
+// PATTERNS); the package compiles it to ".?", zero or one, so "fo?" matches
+// "fo" and "??" matches "x".
+func TestHegelPinQuestionMarkIsOneCharacter(t *testing.T) {
+	if got := get(t, "Host fo?\n Port 2222\n", "fo", "Port"); got != "" {
+		t.Errorf("Host fo?: Port for fo = %q; ssh -G does not match fo (22)", got)
+	}
+	if got := get(t, "Host ??\n Port 2222\n", "x", "Port"); got != "" {
+		t.Errorf("Host ??: Port for x = %q; ssh -G does not match x (22)", got)
+	}
+	if got := get(t, "Host fo?\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Host fo?: Port for foo = %q; want 2222", got)
+	}
+}
+
+// ssh_config/3: the argument of Match host is a comma-separated pattern
+// list (ssh_config(5): "Match host ... patterns are comma-separated"); the
+// package reads it as one pattern with a literal comma.
+func TestHegelPinMatchHostCommaList(t *testing.T) {
+	if got := get(t, "Match host foo,bar\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Match host foo,bar: Port for bar = %q; ssh -G gives 2222", got)
+	}
+	if got := get(t, "Match host !foo,*\n Port 2222\n", "bar", "Port"); got != "2222" {
+		t.Errorf("Match host !foo,*: Port for bar = %q; ssh -G gives 2222", got)
+	}
+}
+
+// ssh_config/4: Match host is matched against the target hostname after
+// HostName substitution (ssh_config(5)), not against the alias.
+func TestHegelPinMatchHostUsesHostName(t *testing.T) {
+	text := "Host foo\n HostName bar\nMatch host bar\n Port 2222\nMatch host foo\n Port 3333\n"
+	if got := get(t, text, "foo", "Port"); got != "2222" {
+		t.Errorf("Host foo / HostName bar / Match host bar: Port for foo = %q; ssh -G gives 2222 (Match host sees the hostname bar)", got)
+	}
+}
+
+// ssh_config/5: Match host compares case-insensitively (ssh lowercases the
+// hostname and match_pattern_list folds the pattern); the package's regexp
+// is case-sensitive.
+func TestHegelPinMatchHostCaseInsensitive(t *testing.T) {
+	if got := get(t, "Match host FOO\n Port 2222\n", "foo", "Port"); got != "2222" {
+		t.Errorf("Match host FOO: Port for foo = %q; ssh -G gives 2222", got)
+	}
+	if got := get(t, "Match host foo\n Port 2222\n", "FOO", "Port"); got != "2222" {
+		t.Errorf("Match host foo: Port for FOO = %q; ssh -G gives 2222 (the hostname is lowercased)", got)
+	}
+}
diff --git a/hegel/hegel_ssh_test.go b/hegel/hegel_ssh_test.go
new file mode 100644
index 0000000..72eaced
--- /dev/null
+++ b/hegel/hegel_ssh_test.go
@@ -0,0 +1,756 @@
+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// ---------------------------------------------------------------------------
+// The keywords compared. ssh -G prints every keyword's effective value, in
+// lower case; the package answers Get (first value wins) or GetAll (for the
+// keywords that accumulate).
+
+type keyword struct {
+	name      string // as ssh -G prints it
+	canonical string // as ssh_config(5) spells it
+	plural    bool   // accumulates across matching blocks (GetAll)
+	rest      bool   // takes the rest of the line (no end-of-line comment)
+	values    hegel.Generator[string]
+}
+
+var (
+	yesno     = hegel.SampledFrom([]string{"yes", "no"})
+	small     = hegel.SampledFrom([]string{"1", "2", "3", "5", "10", "30", "60"})
+	userNames = hegel.SampledFrom([]string{"alice", "bob", "Alice", "a_b", "root", "u-1"})
+	paths     = hegel.SampledFrom([]string{"~/.ssh/id_rsa", "~/.ssh/id_ed25519", "/tmp/key", "key1", "~/k.pem", "./id"})
+	// IdentityFile: a path, sometimes one with a space (written in quotes).
+	keyFiles = weighted(choice[string]{90, paths}, choice[string]{10, hegel.SampledFrom([]string{"~/.ssh/my key", "a b"})})
+	envNames = hegel.SampledFrom([]string{"LANG", "LC_ALL", "FOO", "A", "LC_*"})
+	// SendEnv: one to three names, separated by spaces or a tab.
+	sendEnvs = hegel.Composite(func(tc hegel.TestCase) string {
+		return strings.Join(hegel.Draw(tc, hegel.Lists(envNames).MinSize(1).MaxSize(3)), hegel.Draw(tc, hegel.SampledFrom([]string{" ", "  ", "\t"})))
+	})
+	setEnvs = hegel.Map(hegel.Lists(hegel.SampledFrom([]string{"A=1", "B=two", "TERM=xterm"})).MinSize(1).MaxSize(2), joinSpaced)
+)
+
+func joinSpaced(ws []string) string { return strings.Join(ws, " ") }
+
+var keywords = []keyword{
+	{"port", "Port", false, false, hegel.SampledFrom([]string{"22", "2222", "22222", "1", "65535", "443"})},
+	{"user", "User", false, false, userNames},
+	{"hostname", "HostName", false, false, hegel.SampledFrom([]string{"example.com", "10.0.0.1", "host1", "EXAMPLE.org", "h.internal"})},
+	{"compression", "Compression", false, false, yesno},
+	{"forwardagent", "ForwardAgent", false, false, yesno},
+	{"identitiesonly", "IdentitiesOnly", false, false, yesno},
+	{"batchmode", "BatchMode", false, false, yesno},
+	{"connecttimeout", "ConnectTimeout", false, false, small},
+	{"serveraliveinterval", "ServerAliveInterval", false, false, small},
+	{"serveralivecountmax", "ServerAliveCountMax", false, false, small},
+	{"loglevel", "LogLevel", false, false, hegel.SampledFrom([]string{"QUIET", "FATAL", "ERROR", "INFO", "VERBOSE", "DEBUG", "DEBUG1", "DEBUG2", "DEBUG3"})},
+	{"stricthostkeychecking", "StrictHostKeyChecking", false, false, hegel.SampledFrom([]string{"yes", "no", "ask", "accept-new"})},
+	{"requesttty", "RequestTTY", false, false, hegel.SampledFrom([]string{"yes", "no", "force", "auto"})},
+	{"addressfamily", "AddressFamily", false, false, hegel.SampledFrom([]string{"any", "inet", "inet6"})},
+	{"hostkeyalias", "HostKeyAlias", false, false, userNames},
+	{"proxycommand", "ProxyCommand", false, true, hegel.SampledFrom([]string{"nc %h %p", "ssh -W %h:%p jump", "none", "/usr/bin/nc -X 5 -x localhost:1080 %h %p", "connect"})},
+	{"localcommand", "LocalCommand", false, true, hegel.SampledFrom([]string{"echo hi there", "true", "echo %h"})},
+	{"identityfile", "IdentityFile", true, false, keyFiles},
+	{"certificatefile", "CertificateFile", true, false, hegel.SampledFrom([]string{"c1", "~/.ssh/c2-cert.pub", "/etc/c3"})},
+	{"sendenv", "SendEnv", true, false, sendEnvs},
+	{"setenv", "SetEnv", true, false, setEnvs},
+}
+
+// ---------------------------------------------------------------------------
+// The generated config: small data (blocks of lines, each a few drawn
+// fields) rendered to text by pure functions. The shapes of the recorded
+// bugs (bugs.toml) are drawn by default, so the properties that find them
+// fail and are the expected failures; the pins beside them are the
+// regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off, for
+// a run that looks past the bugs: the generators then draw no tabs between
+// Host patterns and, with Match blocks, no comma lists, no HostName
+// directive and no upper case, and a disagreement the classifier in
+// known.go attributes to a recorded bug is skipped.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs. Read once; the
+// generators consult it when they are built, the properties when they judge.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// casing is how a keyword is spelled: as ssh_config(5) does, or all lower or
+// all upper case.
+type casing int
+
+const (
+	canonical casing = iota
+	lower
+	upper
+)
+
+func (k keyword) spelled(c casing) string {
+	switch c {
+	case lower:
+		return k.name
+	case upper:
+		return strings.ToUpper(k.name)
+	}
+	return k.canonical
+}
+
+// directive is one keyword line.
+type directive struct {
+	indent  string
+	key     keyword
+	casing  casing
+	sep     string // between the keyword and the value
+	value   string
+	quoted  bool   // the value written in double quotes (when it has no whitespace and the keyword does not take the rest of the line)
+	trailer string // an end-of-line comment or trailing whitespace
+}
+
+func (d directive) String() string {
+	v := d.value
+	spaced := strings.ContainsAny(v, " \t")
+	if (d.quoted && !d.key.rest && !spaced) || (spaced && d.key.name == "identityfile") {
+		v = `"` + v + `"`
+	}
+	return d.indent + d.key.spelled(d.casing) + d.sep + v + d.trailer
+}
+
+var (
+	casings = weighted(choice[casing]{8, hegel.Just(canonical)}, choice[casing]{1, hegel.Just(lower)}, choice[casing]{1, hegel.Just(upper)})
+	indents = hegel.SampledFrom([]string{"", "  ", "  ", "\t", "    "})
+	seps    = hegel.SampledFrom([]string{" ", " ", "\t", " = ", "=", "  "})
+	spaces  = hegel.SampledFrom([]string{" ", "\t", "  "})
+	// after the value: nothing, an end-of-line comment or trailing whitespace
+	trailers = weighted(choice[string]{76, hegel.Just("")}, choice[string]{15, hegel.SampledFrom([]string{" # c", "  #comment", "\t# x"})}, choice[string]{9, spaces})
+	// a comment is part of the command for ssh
+	restTrailers = maybe(10, spaces)
+)
+
+func directiveOf(k keyword) hegel.Generator[directive] {
+	trailer := trailers
+	if k.rest {
+		trailer = restTrailers
+	}
+	return hegel.Composite(func(tc hegel.TestCase) directive {
+		return directive{
+			indent:  hegel.Draw(tc, indents),
+			key:     k,
+			casing:  hegel.Draw(tc, casings),
+			sep:     hegel.Draw(tc, seps),
+			value:   hegel.Draw(tc, k.values),
+			quoted:  hegel.Draw(tc, chance(15)),
+			trailer: hegel.Draw(tc, trailer),
+		}
+	})
+}
+
+// directivesFor is a directive of any keyword, or of any but HostName.
+func directivesFor(hostName bool) hegel.Generator[directive] {
+	var gens []hegel.Generator[directive]
+	for _, k := range keywords {
+		if hostName || k.name != "hostname" {
+			gens = append(gens, directiveOf(k))
+		}
+	}
+	return hegel.OneOf(gens...)
+}
+
+// line is one line of a block: a blank line, a comment line or a directive.
+type line interface{ String() string }
+
+// rawLine is a blank or comment line, as written.
+type rawLine string
+
+func (l rawLine) String() string { return string(l) }
+
+func asLine[T line](g hegel.Generator[T]) hegel.Generator[line] {
+	return hegel.Map(g, func(x T) line { return x })
+}
+
+var (
+	blankLines   = asLine(hegel.Map(hegel.SampledFrom([]string{"", "  ", "\t"}), func(s string) rawLine { return rawLine(s) }))
+	commentLines = asLine(hegel.Map(hegel.SampledFrom([]string{"# comment", "  # indented", "#", "\t#x"}), func(s string) rawLine { return rawLine(s) }))
+)
+
+// linesFor is the lines of a block, up to four; a config with Match blocks
+// has no HostName directive under HEGEL_NO_KNOWN (the shape of ssh_config/4).
+func linesFor(withMatch bool) hegel.Generator[[]line] {
+	directives := asLine(directivesFor(!(noKnown && withMatch)))
+	return hegel.Lists(weighted(choice[line]{1, blankLines}, choice[line]{1, commentLines}, choice[line]{10, directives})).MaxSize(4)
+}
+
+// Host and Match host patterns, and the aliases asked about.
+var patterns = []string{
+	"foo", "foo*", "*bar", "f?o", "fo?", "*", "!foobar", "!*bar", "a.b", "*.example.com",
+	"10.0.0.?", "?", "foo?", "*.*", "FOO", "!foo", "10.0.0.*", "a.*", "??", "b*r",
+}
+
+var aliases = []string{"foo", "foobar", "bar", "a.b", "a.example.com", "x", "10.0.0.1", "10.0.0.12", "FOO", "fo", "ab"}
+
+// args is what follows the keyword of a Host or Match line: for Host the
+// patterns, for Match the criterion "all", or "host" and its pattern list.
+type args struct {
+	match     bool
+	criterion string   // Match: all, ALL, host, Host
+	critSep   string   // Match host: between the criterion and the list
+	patterns  []string // Host: the patterns; Match host: the pattern list
+	patSep    string   // Host: between the patterns
+}
+
+func (a args) String() string {
+	sep := a.patSep
+	if a.match {
+		sep = ","
+	}
+	return a.criterion + a.critSep + strings.Join(a.patterns, sep)
+}
+
+var (
+	hostPatternLists  = hegel.Lists(hegel.SampledFrom(patterns)).MinSize(1).MaxSize(3)
+	matchPatternLists = hostPatternLists
+	patternSeps       = hegel.SampledFrom([]string{" ", " ", "  ", "\t"})
+)
+
+func init() {
+	if noKnown {
+		// The shapes of ssh_config/1, /3 and /5: tabs between Host
+		// patterns, Match host lists, upper case in Match patterns.
+		patternSeps = hegel.SampledFrom([]string{" ", " ", "  "})
+		matchPatternLists = hegel.Lists(hegel.Map(hegel.SampledFrom(patterns), strings.ToLower)).MinSize(1).MaxSize(1)
+	}
+}
+
+var (
+	hostArgs = hegel.Composite(func(tc hegel.TestCase) args {
+		return args{patterns: hegel.Draw(tc, hostPatternLists), patSep: hegel.Draw(tc, patternSeps)}
+	})
+	matchAllArgs  = hegel.Map(hegel.SampledFrom([]string{"all", "all", "ALL"}), func(w string) args { return args{match: true, criterion: w} })
+	matchHostArgs = hegel.Composite(func(tc hegel.TestCase) args {
+		return args{
+			match:     true,
+			criterion: hegel.Draw(tc, hegel.SampledFrom([]string{"host", "host", "Host"})),
+			critSep:   hegel.Draw(tc, hegel.SampledFrom([]string{" ", " ", "\t"})),
+			patterns:  hegel.Draw(tc, matchPatternLists),
+		}
+	})
+	matchArgs = weighted(choice[args]{25, matchAllArgs}, choice[args]{75, matchHostArgs})
+)
+
+// header is a block's Host or Match line.
+type header struct {
+	indent, keyword, sep string
+	args                 args
+	comment              string
+}
+
+func (h header) String() string { return h.indent + h.keyword + h.sep + h.args.String() + h.comment }
+
+var (
+	headerIndents  = hegel.SampledFrom([]string{"", "", "  ", "\t"})
+	headerComments = maybe(15, hegel.SampledFrom([]string{" # hosts", "  #c", " #"}))
+)
+
+func headerOf(keywords, seps hegel.Generator[string], a hegel.Generator[args]) hegel.Generator[header] {
+	return hegel.Composite(func(tc hegel.TestCase) header {
+		return header{
+			indent:  hegel.Draw(tc, headerIndents),
+			keyword: hegel.Draw(tc, keywords),
+			sep:     hegel.Draw(tc, seps),
+			args:    hegel.Draw(tc, a),
+			comment: hegel.Draw(tc, headerComments),
+		}
+	})
+}
+
+var (
+	hostHeaders  = headerOf(hegel.SampledFrom([]string{"Host", "Host", "host", "HOST"}), hegel.SampledFrom([]string{" ", " ", "\t", " = ", "="}), hostArgs)
+	matchHeaders = headerOf(hegel.SampledFrom([]string{"Match", "Match", "match", "MATCH"}), hegel.SampledFrom([]string{" ", " ", "\t", "  "}), matchArgs)
+)
+
+// block is a Host or Match line and its lines.
+type block struct {
+	header header
+	lines  []line
+}
+
+func blocksFor(withMatch bool) hegel.Generator[block] {
+	headers := hostHeaders
+	if withMatch {
+		headers = hegel.OneOf(hostHeaders, matchHeaders)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) block {
+		return block{header: hegel.Draw(tc, headers), lines: hegel.Draw(tc, linesFor(withMatch))}
+	})
+}
+
+// config is a file: lines before any block (the implicit Host *), then up
+// to four blocks.
+type config struct {
+	eol      string
+	preamble []line
+	blocks   []block
+}
+
+// String renders the file.
+func (c config) String() string {
+	var b strings.Builder
+	for _, l := range c.preamble {
+		b.WriteString(l.String() + c.eol)
+	}
+	for _, bl := range c.blocks {
+		b.WriteString(bl.header.String() + c.eol)
+		for _, l := range bl.lines {
+			b.WriteString(l.String() + c.eol)
+		}
+	}
+	return b.String()
+}
+
+func (c config) hasMatch() bool {
+	for _, bl := range c.blocks {
+		if bl.header.args.match {
+			return true
+		}
+	}
+	return false
+}
+
+var eols = hegel.SampledFrom([]string{"\n", "\n", "\n", "\r\n"})
+
+// sshCase is a config and the alias asked about.
+type sshCase struct {
+	config config
+	alias  string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c sshCase) GoString() string {
+	return fmt.Sprintf("alias: %s\nconfig:\n%s", c.alias, indent(c.config.String()))
+}
+
+func indent(s string) string {
+	lines := strings.Split(strings.TrimRight(s, "\n"), "\n")
+	for i, l := range lines {
+		lines[i] = "  | " + l
+	}
+	return strings.Join(lines, "\n")
+}
+
+// casesFor draws a config with, or without, Match blocks and an alias; with
+// Match blocks under HEGEL_NO_KNOWN the alias is lower case (ssh_config/5).
+func casesFor(withMatch bool) hegel.Generator[sshCase] {
+	alias := hegel.SampledFrom(aliases)
+	if noKnown && withMatch {
+		alias = hegel.Map(alias, strings.ToLower)
+	}
+	configs := hegel.Composite(func(tc hegel.TestCase) config {
+		return config{
+			eol:      hegel.Draw(tc, eols),
+			preamble: hegel.Draw(tc, maybe(30, linesFor(withMatch))),
+			blocks:   hegel.Draw(tc, hegel.Lists(blocksFor(withMatch)).MaxSize(4)),
+		}
+	})
+	return hegel.Composite(func(tc hegel.TestCase) sshCase {
+		return sshCase{config: hegel.Draw(tc, configs), alias: hegel.Draw(tc, alias)}
+	})
+}
+
+var cases = weighted(choice[sshCase]{75, casesFor(false)}, choice[sshCase]{25, casesFor(true)})
+
+// ---------------------------------------------------------------------------
+// ssh -G.
+
+var (
+	sshDefaultsOnce sync.Once
+	sshDefaults     map[string][]string
+	sshDefaultsErr  error
+	sshDir          string
+)
+
+// sshG runs ssh -G -F on the config text for alias and returns the printed
+// keyword values (several lines for the accumulating keywords).
+func sshG(text, alias string) (map[string][]string, error) {
+	f, err := os.CreateTemp(sshDir, "cfg")
+	if err != nil {
+		return nil, err
+	}
+	defer os.Remove(f.Name())
+	if _, err := f.WriteString(text); err != nil {
+		return nil, err
+	}
+	f.Close()
+	cmd := exec.Command("ssh", "-G", "-F", f.Name(), "--", alias)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("ssh -G: %v: %s", err, strings.TrimSpace(stderr.String()))
+	}
+	m := map[string][]string{}
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		if line == "" {
+			continue
+		}
+		k, v, _ := strings.Cut(line, " ")
+		m[k] = append(m[k], v)
+	}
+	return m, nil
+}
+
+func setupSSH(t testing.TB) {
+	t.Helper()
+	sshDefaultsOnce.Do(func() {
+		if _, err := exec.LookPath("ssh"); err != nil {
+			sshDefaultsErr = fmt.Errorf("ssh not found: %v", err)
+			return
+		}
+		sshDir, sshDefaultsErr = os.MkdirTemp("", "hegel-ssh")
+		if sshDefaultsErr != nil {
+			return
+		}
+		sshDefaults, sshDefaultsErr = sshG("", "hegel-defaults")
+	})
+	if sshDefaultsErr != nil {
+		t.Fatalf("%v", sshDefaultsErr)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The package's answer, spelled as ssh -G prints it.
+
+// libValues answers for one keyword: what ssh -G would print if the package
+// were right, given its Get/GetAll answer and ssh's defaults.
+func libValues(cfg *ssh_config.Config, alias string, k keyword) ([]string, error) {
+	if k.plural {
+		vals, err := cfg.GetAll(alias, k.name)
+		if err != nil {
+			return nil, err
+		}
+		var out []string
+		switch k.name {
+		case "sendenv":
+			for _, v := range vals {
+				out = append(out, strings.Fields(v)...)
+			}
+		case "setenv":
+			// ssh takes SetEnv from the first directive that applies only
+			// (the option is one list, not accumulated as SendEnv is), and
+			// keeps the first assignment of a variable within it.
+			if len(vals) > 0 {
+				seen := map[string]bool{}
+				for _, f := range strings.Fields(vals[0]) {
+					name, _, _ := strings.Cut(f, "=")
+					if !seen[name] {
+						seen[name] = true
+						out = append(out, f)
+					}
+				}
+			}
+		default:
+			// ssh ignores a file named a second time.
+			seen := map[string]bool{}
+			for _, v := range vals {
+				if !seen[v] {
+					seen[v] = true
+					out = append(out, v)
+				}
+			}
+		}
+		if len(out) == 0 {
+			return sshDefaults[k.name], nil
+		}
+		return out, nil
+	}
+	v, err := cfg.Get(alias, k.name)
+	if err != nil {
+		return nil, err
+	}
+	// ssh's spellings of the effective values.
+	switch k.name {
+	case "hostname":
+		if v == "" {
+			v = alias
+		}
+		return []string{strings.ToLower(v)}, nil
+	case "hostkeyalias":
+		v = strings.ToLower(v)
+	case "requesttty", "stricthostkeychecking":
+		switch v {
+		case "yes":
+			v = "true"
+		case "no":
+			v = "false"
+		}
+	case "loglevel":
+		switch v {
+		case "DEBUG1":
+			v = "DEBUG"
+		case "QUIET":
+			v = "SILENT"
+		}
+	case "serveraliveinterval":
+		// BatchMode yes gives ServerAliveInterval a default of 300.
+		if v == "" {
+			if bm, _ := cfg.Get(alias, "batchmode"); bm == "yes" {
+				v = "300"
+			}
+		}
+	case "proxycommand":
+		if v == "none" {
+			return nil, nil // unset
+		}
+	}
+	if v == "" {
+		return sshDefaults[k.name], nil
+	}
+	return []string{v}, nil
+}
+
+// ---------------------------------------------------------------------------
+// The property.
+
+// agreesWithSSH judges one case: the package's Get/GetAll, spelled as ssh
+// does, is what ssh -G prints for every keyword compared (the whole of
+// ssh -G's output is the oracle's answer, so one case judges all the
+// keywords). A config ssh rejects is not judged. A disagreement the
+// classifier attributes to a recorded bug is named in the failure, and
+// under HEGEL_NO_KNOWN=1 skipped.
+func agreesWithSSH(ht *hegel.T, c sshCase) {
+	text := c.config.String()
+	want, err := sshG(text, c.alias)
+	ht.Assume(err == nil)
+	cfg, err := ssh_config.DecodeBytes([]byte(text))
+	if err != nil {
+		ht.Fatalf("ssh_config rejects (%v) what ssh accepts", err)
+	}
+	for _, k := range keywords {
+		got, err := libValues(cfg, c.alias, k)
+		if err != nil {
+			ht.Fatalf("Get(%q, %q): %v", c.alias, k.name, err)
+		}
+		if w := want[k.name]; !slices.Equal(got, w) {
+			shape := known(c.config, c.alias)
+			if noKnown {
+				ht.Assume(shape == "")
+			}
+			if shape != "" {
+				shape = " (the shape of " + shape + ")"
+			}
+			ht.Fatalf("%s for %q: ssh_config %q, ssh -G %q%s", k.name, c.alias, got, w, shape)
+		}
+	}
+}
+
+// TestHegelMatchesSSH: for a generated config and an alias, the package
+// agrees with ssh -G. The config draws the shapes of all five recorded bugs
+// at their natural rate, so this property fails while any is open and
+// shrinks to the smallest of them; each bug also has its own property below.
+func TestHegelMatchesSSH(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, cases))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// One property per recorded bug: a generator over the bug's shape region
+// with random contents, judged by the same oracle, so that each bug has a
+// property that finds it every run. Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring shape the bug does not touch instead (spaces for tabs, a
+// character for the "?", one pattern for the list, a HostName equal to the
+// alias, one spelling for pattern and alias), and passes.
+
+// names is a host name or pattern word of lower-case letters; targets is one
+// from a disjoint alphabet, so a target is never the alias it is drawn beside.
+var (
+	names   = hegel.Text().Alphabet("abcdefghxyz").MinSize(1).MaxSize(5)
+	targets = hegel.Text().Alphabet("stuvw").MinSize(1).MaxSize(5)
+	// the lines of a Host block: one to three directives of any keyword; of
+	// a Match block: any but HostName (the shape of ssh_config/4)
+	hostLines  = hegel.Lists(asLine(directivesFor(true))).MinSize(1).MaxSize(3)
+	matchLines = hegel.Lists(asLine(directivesFor(false))).MinSize(1).MaxSize(3)
+	// the separator between the patterns of a Host line: containing a tab
+	// (the shape of ssh_config/1), or under HEGEL_NO_KNOWN=1 spaces
+	tabSeps   = hegel.SampledFrom([]string{"\t", "\t\t", "\t ", " \t"})
+	spaceSeps = hegel.SampledFrom([]string{" ", "  "})
+	positions = hegel.Integers(0, 5)
+)
+
+// plainDirective is a directive of the keyword named as ssh -G prints it.
+func plainDirective(name, value string) directive {
+	for _, k := range keywords {
+		if k.name == name {
+			return directive{indent: "  ", key: k, casing: canonical, sep: " ", value: value}
+		}
+	}
+	panic("no keyword " + name)
+}
+
+func hostHeader(sep string, patterns []string, patSep string) header {
+	return header{keyword: "Host", sep: sep, args: args{patterns: patterns, patSep: patSep}}
+}
+
+func matchHostHeader(patterns []string) header {
+	return header{keyword: "Match", sep: " ", args: args{match: true, criterion: "host", critSep: " ", patterns: patterns}}
+}
+
+func caseOf(alias string, blocks ...block) sshCase {
+	return sshCase{config: config{eol: "\n", blocks: blocks}, alias: alias}
+}
+
+// upperMask upper-cases the letters of s whose bit is set in mask.
+func upperMask(s string, mask int) string {
+	b := []byte(s)
+	for i := range b {
+		if mask&(1<<i) != 0 {
+			b[i] -= 'a' - 'A'
+		}
+	}
+	return string(b)
+}
+
+// tabSeparatedHostCases: a Host line of two or three names separated by
+// tabs (after a space or a tab), a block of directives, and one of the names
+// as the alias.
+var tabSeparatedHostCases = func() hegel.Generator[sshCase] {
+	seps := tabSeps
+	if noKnown {
+		seps = spaceSeps
+	}
+	return hegel.Composite(func(tc hegel.TestCase) sshCase {
+		ps := hegel.Draw(tc, hegel.Lists(names).MinSize(2).MaxSize(3))
+		h := hostHeader(hegel.Draw(tc, hegel.SampledFrom([]string{" ", "\t"})), ps, hegel.Draw(tc, seps))
+		alias := ps[hegel.Draw(tc, positions)%len(ps)]
+		return caseOf(alias, block{h, hegel.Draw(tc, hostLines)})
+	})
+}()
+
+// TestHegelTabSeparatedHostPatternsMatch: the patterns of a Host line are
+// separated by any whitespace, so an alias equal to one of them selects the
+// block, tabs or spaces between them. The package splits on spaces only
+// (ssh_config/1), so with a tab the block applies to none of its names.
+func TestHegelTabSeparatedHostPatternsMatch(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, tabSeparatedHostCases))
+	})
+}
+
+// questionMarkCases: a Host or Match host pattern with a "?" inserted into a
+// name, and the alias that name with the "?" given no character (the shape
+// of ssh_config/2) or, under HEGEL_NO_KNOWN=1, one character.
+var questionMarkCases = func() hegel.Generator[sshCase] {
+	fills := hegel.Just("")
+	if noKnown {
+		fills = hegel.Text().Alphabet("abcdefghxyz").MinSize(1).MaxSize(1)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) sshCase {
+		w := hegel.Draw(tc, names)
+		at := hegel.Draw(tc, positions) % (len(w) + 1)
+		pattern, alias := w[:at]+"?"+w[at:], w[:at]+hegel.Draw(tc, fills)+w[at:]
+		if hegel.Draw(tc, hegel.SampledFrom([]bool{false, true})) {
+			return caseOf(alias, block{matchHostHeader([]string{pattern}), hegel.Draw(tc, matchLines)})
+		}
+		return caseOf(alias, block{hostHeader(" ", []string{pattern}, " "), hegel.Draw(tc, hostLines)})
+	})
+}()
+
+// TestHegelQuestionMarkMatchesOneCharacter: "?" in a Host or Match host
+// pattern matches exactly one character (ssh_config(5), PATTERNS), so the
+// name with the "?" left out is not selected by the block. The package
+// compiles it to ".?" (ssh_config/2) and applies the block.
+func TestHegelQuestionMarkMatchesOneCharacter(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, questionMarkCases))
+	})
+}
+
+// matchHostListCases: a Match host with a comma-separated list of two or
+// three names (one under HEGEL_NO_KNOWN=1), a block of directives, and one
+// of the names as the alias.
+var matchHostListCases = func() hegel.Generator[sshCase] {
+	lists := hegel.Lists(names).MinSize(2).MaxSize(3)
+	if noKnown {
+		lists = hegel.Lists(names).MinSize(1).MaxSize(1)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) sshCase {
+		ps := hegel.Draw(tc, lists)
+		alias := ps[hegel.Draw(tc, positions)%len(ps)]
+		return caseOf(alias, block{matchHostHeader(ps), hegel.Draw(tc, matchLines)})
+	})
+}()
+
+// TestHegelMatchHostCommaListMatchesEachPattern: the argument of Match host
+// is a comma-separated pattern list, so the block applies to an alias equal
+// to any of its names. The package reads the list as one pattern with
+// literal commas (ssh_config/3) and applies the block to none.
+func TestHegelMatchHostCommaListMatchesEachPattern(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, matchHostListCases))
+	})
+}
+
+// matchHostAfterHostNameCases: a Host block for the alias whose first
+// directive is a HostName (another name, or under HEGEL_NO_KNOWN=1 the alias
+// itself), then a Match host block for that HostName and, half the time, one
+// for the alias.
+var matchHostAfterHostNameCases = hegel.Composite(func(tc hegel.TestCase) sshCase {
+	alias := hegel.Draw(tc, names)
+	target := alias
+	if !noKnown {
+		target = hegel.Draw(tc, targets)
+	}
+	hostBlock := block{hostHeader(" ", []string{alias}, " "), append([]line{plainDirective("hostname", target)}, hegel.Draw(tc, matchLines)...)}
+	blocks := []block{hostBlock, {matchHostHeader([]string{target}), hegel.Draw(tc, matchLines)}}
+	if hegel.Draw(tc, chance(50)) {
+		blocks = append(blocks, block{matchHostHeader([]string{alias}), hegel.Draw(tc, matchLines)})
+	}
+	return caseOf(alias, blocks...)
+})
+
+// TestHegelMatchHostSeesTheHostName: Match host is matched against the
+// target host name after HostName substitution (ssh_config(5)), so a Match
+// host block naming the HostName set by an earlier Host block applies, and
+// one naming the alias does not. The package matches the alias
+// (ssh_config/4) and does the opposite.
+func TestHegelMatchHostSeesTheHostName(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, matchHostAfterHostNameCases))
+	})
+}
+
+// matchHostCaseCases: a Match host pattern and an alias that are one name in
+// two spellings differing in case (the same spelling under
+// HEGEL_NO_KNOWN=1), and a block of directives.
+var matchHostCaseCases = hegel.Composite(func(tc hegel.TestCase) sshCase {
+	w := hegel.Draw(tc, names)
+	bits := 1 << len(w)
+	patternMask := hegel.Draw(tc, hegel.Integers(0, 31)) % bits
+	aliasMask := patternMask
+	if !noKnown {
+		aliasMask ^= 1 + hegel.Draw(tc, hegel.Integers(0, 30))%(bits-1)
+	}
+	return caseOf(upperMask(w, aliasMask), block{matchHostHeader([]string{upperMask(w, patternMask)}), hegel.Draw(tc, matchLines)})
+})
+
+// TestHegelMatchHostIgnoresCase: Match host compares case-insensitively (ssh
+// lowercases the host name and folds the pattern), so a block applies to an
+// alias that spells its pattern in another case. The package's regexp is
+// case-sensitive (ssh_config/5) and the block does not apply.
+func TestHegelMatchHostIgnoresCase(t *testing.T) {
+	setupSSH(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithSSH(ht, hegel.Draw(ht, matchHostCaseCases))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..d346cce
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,94 @@
+package hegel
+
+// Hegel property tests for ssh_config: generated ssh_config files, read by
+// this package and by ssh -G (the OpenSSH client of the machine), must give
+// the same effective values for a queried host.
+//
+// Needs the ssh binary.
+
+import (
+	"os"
+	"reflect"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness: hegel-go reads no environment variable, so HEGEL_TEST_CASES goes
+// through hegelOpts; a panic in the code under test is turned into a failure
+// of the current case (hegel-go would re-raise it after shrinking and abort
+// the test binary).
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// ---------------------------------------------------------------------------
+// Generator helpers.
+
+// weighted chooses among generators in proportion to integer weights with
+// one draw; it shrinks towards the first choice, so the simplest comes first.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe is g pct percent of the time and the zero value otherwise; it
+// shrinks to the zero value.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..85ab95f
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,116 @@
+package hegel
+
+import (
+	"slices"
+	"strings"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// The shapes of the recorded bugs (bugs.toml): known names the bug that
+// explains a disagreement between the package and ssh -G for the generated
+// config and alias, or "" when none does. By default the properties draw
+// these shapes and fail on them, naming the shape (hegel_ssh_test.go); under
+// HEGEL_NO_KNOWN=1 the generators avoid the coarse shapes and a disagreement
+// known attributes to a bug is skipped, so that a round looks past the known
+// bugs. The pins in hegel_pins_test.go reproduce each bug deterministically.
+
+func known(c config, alias string) string {
+	hasHostName := strings.Contains(strings.ToLower(c.String()), "hostname")
+	for _, bl := range c.blocks {
+		h := bl.header
+		if h.args.match && len(h.args.patterns) > 0 {
+			// ssh_config/3: Match host takes a comma-separated pattern list.
+			if len(h.args.patterns) > 1 {
+				return "ssh_config/3"
+			}
+			// ssh_config/4: Match host is matched against the hostname after
+			// HostName substitution, not the alias.
+			if hasHostName {
+				return "ssh_config/4"
+			}
+			// ssh_config/5: Match host matches case-insensitively.
+			if strings.ToLower(h.args.patterns[0]) != h.args.patterns[0] || strings.ToLower(alias) != alias {
+				return "ssh_config/5"
+			}
+			// ssh_config/2 applies to Match host patterns too.
+			if hasQuestion(h.args.patterns) && libMatches(h.args.patterns, alias) != sshMatches(h.args.patterns, alias) {
+				return "ssh_config/2"
+			}
+			continue
+		}
+		// ssh_config/1: the package splits the patterns of a Host line on
+		// spaces only, so a piece with a tab inside is one pattern that
+		// matches nothing (a tab after the keyword is fine).
+		if len(h.args.patterns) > 1 && slices.ContainsFunc(strings.Split(h.args.String(), " "), func(p string) bool { return strings.Contains(p, "\t") }) {
+			return "ssh_config/1"
+		}
+		// ssh_config/2: "?" matches zero characters as well as one, so a
+		// block matches an alias ssh would not match it to.
+		if hasQuestion(h.args.patterns) && libMatches(h.args.patterns, alias) != sshMatches(h.args.patterns, alias) {
+			return "ssh_config/2"
+		}
+	}
+	return ""
+}
+
+func hasQuestion(patterns []string) bool {
+	for _, p := range patterns {
+		if strings.Contains(p, "?") {
+			return true
+		}
+	}
+	return false
+}
+
+// libMatches is Host.Matches over the package's patterns.
+func libMatches(patterns []string, alias string) bool {
+	h := &ssh_config.Host{}
+	for _, p := range patterns {
+		pat, err := ssh_config.NewPattern(p)
+		if err != nil {
+			return false
+		}
+		h.Patterns = append(h.Patterns, pat)
+	}
+	return h.Matches(alias)
+}
+
+// sshMatches is ssh's match_hostname over a Host line: a negated pattern
+// that matches vetoes the line, otherwise any match wins; "*" is any run,
+// "?" exactly one character.
+func sshMatches(patterns []string, alias string) bool {
+	found := false
+	for _, p := range patterns {
+		neg := strings.HasPrefix(p, "!")
+		if neg {
+			p = p[1:]
+		}
+		if glob(p, alias) {
+			if neg {
+				return false
+			}
+			found = true
+		}
+	}
+	return found
+}
+
+func glob(p, s string) bool {
+	if p == "" {
+		return s == ""
+	}
+	switch p[0] {
+	case '*':
+		for i := 0; i <= len(s); i++ {
+			if glob(p[1:], s[i:]) {
+				return true
+			}
+		}
+		return false
+	case '?':
+		return s != "" && glob(p[1:], s[1:])
+	default:
+		return s != "" && s[0] == p[0] && glob(p[1:], s[1:])
+	}
+}
