+package hegel
+
+import (
+	"os"
+	"strings"
+
+	"github.com/kevinburke/ssh_config"
+)
+
+// The gates for the recorded bugs (bugs.toml): known names the bug that
+// explains a disagreement between the package and ssh -G about key for the
+// generated config and alias, or "" when none does. Under HEGEL_NO_KNOWN=1
+// the generator avoids the shapes the gates are on, so that a round looks
+// past the known bugs. The pins in hegel_pins_test.go reproduce each bug
+// deterministically.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+func known(c *config, alias, key string) string {
+	hasHostName := strings.Contains(strings.ToLower(c.text), "hostname")
+	for _, bl := range c.blocks {
+		if bl.match && len(bl.patterns) > 0 {
+			// ssh_config/3: Match host takes a comma-separated pattern list.
+			if len(bl.patterns) > 1 {
+				return "ssh_config/3"
+			}
+			// ssh_config/4: Match host is matched against the hostname after
+			// HostName substitution, not the alias.
+			if hasHostName {
+				return "ssh_config/4"
+			}
+			// ssh_config/5: Match host matches case-insensitively.
+			if strings.ToLower(bl.patterns[0]) != bl.patterns[0] || strings.ToLower(alias) != alias {
+				return "ssh_config/5"
+			}
+			// ssh_config/2 applies to Match host patterns too.
+			if hasQuestion(bl.patterns) && libMatches(bl.patterns, alias) != sshMatches(bl.patterns, alias) {
+				return "ssh_config/2"
+			}
+			continue
+		}
+		// ssh_config/1: patterns separated by tabs on a Host line are one
+		// pattern.
+		if strings.Contains(strings.TrimLeft(bl.hostLine, " \t"), "\t") && len(bl.patterns) > 1 {
+			return "ssh_config/1"
+		}
+		// ssh_config/2: "?" matches zero characters as well as one, so a
+		// block matches an alias ssh would not match it to.
+		if hasQuestion(bl.patterns) && libMatches(bl.patterns, alias) != sshMatches(bl.patterns, alias) {
+			return "ssh_config/2"
+		}
+	}
+	return ""
+}
+
+func hasQuestion(patterns []string) bool {
+	for _, p := range patterns {
+		if strings.Contains(p, "?") {
+			return true
+		}
+	}
+	return false
+}
+
+// libMatches is Host.Matches over the package's patterns.
+func libMatches(patterns []string, alias string) bool {
+	h := &ssh_config.Host{}
+	for _, p := range patterns {
+		pat, err := ssh_config.NewPattern(p)
+		if err != nil {
+			return false
+		}
+		h.Patterns = append(h.Patterns, pat)
+	}
+	return h.Matches(alias)
+}
+
+// sshMatches is ssh's match_hostname over a Host line: a negated pattern
+// that matches vetoes the line, otherwise any match wins; "*" is any run,
+// "?" exactly one character.
+func sshMatches(patterns []string, alias string) bool {
+	found := false
+	for _, p := range patterns {
+		neg := strings.HasPrefix(p, "!")
+		if neg {
+			p = p[1:]
+		}
+		if glob(p, alias) {
+			if neg {
+				return false
+			}
+			found = true
+		}
+	}
+	return found
+}
+
+func glob(p, s string) bool {
+	if p == "" {
+		return s == ""
+	}
+	switch p[0] {
+	case '*':
+		for i := 0; i <= len(s); i++ {
+			if glob(p[1:], s[i:]) {
+				return true
+			}
+		}
+		return false
+	case '?':
+		return s != "" && glob(p[1:], s[1:])
+	default:
+		return s != "" && s[0] == p[0] && glob(p[1:], s[1:])
+	}
+}
