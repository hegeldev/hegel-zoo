+// ---------------------------------------------------------------------------
+// parquet-go/4 and 7: float statistics.
+
+// floatColumnCase: a float or double column, its encoding, its values and
+// parquet-go's writer options.
+type floatColumnCase struct {
+	kind   kind
+	enc    string
+	values []float64
+	fo     fileOptions
+}
+
+func (c floatColumnCase) GoString() string {
+	return fmt.Sprintf("%s column (%s) holding %v, %s", c.kind, c.enc, c.values, c.fo)
+}
+
+// goCase is the case as parquet-go writes it: one required column.
+func (c floatColumnCase) goCase() goCase {
+	spec := rootOf(fieldSpec{kind: c.kind, enc: c.enc})
+	typ := baseType(spec)
+	rows := make([]reflect.Value, len(c.values))
+	for i, x := range c.values {
+		v := reflect.New(typ).Elem()
+		v.Field(0).SetFloat(x)
+		rows[i] = v
+	}
+	return goCase{spec: spec, rows: rows, fo: c.fo}
+}
+
+var (
+	negZero = math.Copysign(0, -1)
+	// magnitudes: positive finite values, and +Inf.
+	magnitudes = weighted(
+		choice[float64]{4, hegel.Map(hegel.Integers(1, 8000), func(n int) float64 { return float64(n) / 8 })},
+		choice[float64]{1, hegel.Just(math.Inf(1))},
+	)
+	// zeroSequences: the values of a column whose first zero is +0.0 and a
+	// later one -0.0, the rest non-negative (the minimum must then be
+	// written -0.0); or the mirror image (the maximum must be +0.0); or NaN
+	// throughout (no bounds must be written). Under HEGEL_NO_KNOWN=1 the
+	// zeros are of one sign.
+	zeroSequences = shaped(weighted(
+		choice[[]float64]{2, hegel.Map(bothZeros, func(xs []float64) []float64 { return xs })},
+		choice[[]float64]{2, hegel.Map(bothZeros, func(xs []float64) []float64 {
+			out := make([]float64, len(xs))
+			for i, x := range xs {
+				out[i] = -x
+			}
+			return out
+		})},
+		choice[[]float64]{1, hegel.Map(hegel.Integers(1, 5), func(n int) []float64 {
+			out := make([]float64, n)
+			for i := range out {
+				out[i] = math.NaN()
+			}
+			return out
+		})},
+	), oneSignZeros)
+	// bothZeros: fillers, +0, fillers, -0, fillers.
+	bothZeros = hegel.Composite(func(tc hegel.TestCase) []float64 {
+		fillers := listsOf(magnitudes, hegel.Integers(0, 3))
+		out := append([]float64(nil), hegel.Draw(tc, fillers)...)
+		out = append(out, 0)
+		out = append(out, hegel.Draw(tc, fillers)...)
+		out = append(out, negZero)
+		return append(out, hegel.Draw(tc, fillers)...)
+	})
+	// oneSignZeros: one to six signed magnitudes or zeros of the one sign.
+	oneSignZeros = hegel.FlatMap(pick(0.0, negZero), func(zero float64) hegel.Generator[[]float64] {
+		values := weighted(
+			choice[float64]{2, hegel.Just(zero)},
+			choice[float64]{3, magnitudes},
+			choice[float64]{3, hegel.Map(magnitudes, func(x float64) float64 { return -x })},
+		)
+		return listsOf(values, hegel.Integers(1, 6))
+	})
+	signedZeroCases = hegel.Composite(func(tc hegel.TestCase) floatColumnCase {
+		return floatColumnCase{
+			kind:   hegel.Draw(tc, pick(kDouble, kFloat)),
+			enc:    hegel.Draw(tc, pick("plain", "")),
+			values: hegel.Draw(tc, zeroSequences),
+			fo:     hegel.Draw(tc, plainFileOptions),
+		}
+	})
+)
+
+// TestHegelFloatBoundsAreSignedZeros: the statistics parquet-go writes for a
+// float column follow the format's order for floats: a zero minimum is
+// written -0.0 and a zero maximum +0.0 whichever zero came first, and no
+// bounds are written for a column of NaNs (parquet-go/4), as pyarrow reads
+// them. Under HEGEL_NO_KNOWN=1 the column's zeros are of one sign.
+func TestHegelFloatBoundsAreSignedZeros(t *testing.T) {
