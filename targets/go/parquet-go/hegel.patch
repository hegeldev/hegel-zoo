+		return append(xs[:at], append([]float64{math.NaN()}, xs[at:]...)...)
+	}), listsOf(finites, hegel.Integers(1, 6)))
+	dictionaryNaNCases = hegel.Composite(func(tc hegel.TestCase) floatColumnCase {
+		return floatColumnCase{
+			kind:   hegel.Draw(tc, pick(kDouble, kFloat)),
+			enc:    "dict",
+			values: hegel.Draw(tc, nanSequences),
+			fo:     hegel.Draw(tc, plainFileOptions),
