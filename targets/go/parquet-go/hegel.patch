+
+// withLogicalType returns the file with the logical type of its index-th
+// schema element (0 is the root) replaced by lt, the rest as written; a nil
+// lt keeps the annotation and only re-encodes the footer.
+func withLogicalType(data []byte, index int, lt *format.LogicalType) ([]byte, error) {
+	return withFooter(data, func(md *format.FileMetaData) {
+		if lt != nil {
+			md.Schema[index].LogicalType = *lt
+		}
+	})
+}
+
+// dataRegion is the length of the file before its footer.
+func dataRegion(data []byte) int {
+	n := len(data)
+	if n < 8 {
+		return n
+	}
+	return max(0, n-8-int(binary.LittleEndian.Uint32(data[n-8:n-4])))
+}
+
+// withFooter returns the file with its footer decoded, edited and
+// re-encoded, the rest as written.
+func withFooter(data []byte, edit func(md *format.FileMetaData)) ([]byte, error) {
+	// [data][footer][footer length, 4 bytes little-endian]["PAR1"]
+	n := len(data)
+	footerLen := int(binary.LittleEndian.Uint32(data[n-8 : n-4]))
+	var md format.FileMetaData
+	if err := thrift.Unmarshal(new(thrift.CompactProtocol), data[n-8-footerLen:n-8], &md); err != nil {
+		return nil, err
+	}
+	edit(&md)
+	footer, err := thrift.Marshal(new(thrift.CompactProtocol), &md)
+	if err != nil {
+		return nil, err
+	}
+	out := append([]byte(nil), data[:n-8-footerLen]...)
+	out = append(out, footer...)
+	out = binary.LittleEndian.AppendUint32(out, uint32(len(footer)))
+	return append(out, "PAR1"...), nil
+}
+
+// openAndReadOutcome opens the file, prints its schema and reads its rows through
+// the row API and a Reader into smallRow, and describes the outcome:
+// "rejected" (OpenFile errs), "read", "Reader errs" or "<step> panics: ...".
+func openAndReadOutcome(data []byte) (res string) {
+	step := "OpenFile"
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("%s panics: %v", step, r)
+		}
+	}()
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return "rejected"
+	}
+	step = "Schema().String()"
+	_ = f.Schema().String()
+	step = "the row API"
+	if r := readOutcome(f); strings.HasPrefix(r, "panic: ") {
+		return "the row API panics: " + strings.TrimPrefix(r, "panic: ")
+	}
+	step = "Reader.Read"
+	r := parquet.NewReader(f)
+	var row smallRow
+	for {
+		if err := r.Read(&row); err != nil {
+			if err == io.EOF {
+				return "read"
+			}
+			return "Reader errs"
+		}
+	}
+}
+
+// optionalRow is the row of the small files of the page-count tests: every
+// column optional, so that its data pages v2 count nulls.
+type optionalRow struct {
+	B *bool   `parquet:"b"`
+	C *int32  `parquet:"c"`
+	D *string `parquet:"d"`
+}
+
+// presentOr is a pointer to a value of g pct percent of the time, nil (the
+// shrink target) otherwise.
+func presentOr[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return weighted(
+		choice[*T]{100 - pct, hegel.Just[*T](nil)},
+		choice[*T]{pct, hegel.Map(g, func(v T) *T { return &v })},
+	)
+}
+
+// optionalRows: one to three rows, each column present seven times in ten.
+var optionalRows = listsOf(hegel.Composite(func(tc hegel.TestCase) optionalRow {
+	return optionalRow{
+		B: hegel.Draw(tc, presentOr(70, hegel.Booleans())),
+		C: hegel.Draw(tc, presentOr(70, hegel.Integers(int32(-1000), 1000))),
+		D: hegel.Draw(tc, presentOr(70, texts)),
+	}
+}), hegel.Integers(1, 3))
+
+// nullCountCase: the rows of a file with data pages v2, the column whose
+// first page's header is edited, and the excess of nulls over values it
+// will count (taken modulo what the header's encoding can hold).
+type nullCountCase struct {
+	rows   []optionalRow
+	col    int
+	excess int
+}
+
+var nullCountCases = hegel.Composite(func(tc hegel.TestCase) nullCountCase {
+	return nullCountCase{rows: hegel.Draw(tc, optionalRows), col: hegel.Draw(tc, pick(0, 1, 2)), excess: hegel.Draw(tc, hegel.Integers(0, 62))}
+})
+
+// nulls is the null count the page will claim: more than its values
+// (parquet-go/20's shape; up to 63, which encodes in one byte like the
+// written count) or, under HEGEL_NO_KNOWN=1, the written count.
+func (c nullCountCase) nulls(v2 *format.DataPageHeaderV2) int32 {
+	if noKnown {
+		return v2.NumNulls
+	}
+	return v2.NumValues + 1 + int32(c.excess)%(63-v2.NumValues)
+}
+
+// TestHegelPagesWithMoreNullsThanValuesAreRejected: a data page v2 header
+// whose num_nulls exceeds its num_values is malformed; reading the page is
+// an error, not a panic (parquet-go/20). Under HEGEL_NO_KNOWN=1 the counts
+// stay as written.
+func TestHegelPagesWithMoreNullsThanValuesAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nullCountCases)
+		var buf bytes.Buffer
+		if err := parquet.Write[optionalRow](&buf, c.rows, parquet.DataPageVersion(2)); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		data, err := withPageCounts(buf.Bytes(), c.col, func(h *format.PageHeader) {
+			if !h.DataPageHeaderV2.Valid {
+				ht.Fatalf("column %d's first data page is not a data page v2", c.col)
+			}
+			v2 := &h.DataPageHeaderV2.V
+			nulls := c.nulls(v2)
+			curDesc = fmt.Sprintf("a %d-row file whose column %s's data page v2 counts %d values and %d nulls (written: %d)", len(c.rows), string("bcd"[c.col]), v2.NumValues, nulls, v2.NumNulls)
+			v2.NumNulls = nulls
+		})
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		res := openAndReadOutcome(data)
+		if strings.Contains(res, "panics") {
+			mismatch(ht, "parquet-go/20", "%s: %s", curDesc, res)
+		}
+		count(res)
+	})
+}
+
+// withPageCounts returns the file with the header of the first data page of
+// column chunk col (of row group 0) edited, the rest as written. The edited
+// header must encode in as many bytes as the written one (counts in
+// [-64, 63] do, for the small files here), as the page data follows it.
+func withPageCounts(data []byte, col int, edit func(h *format.PageHeader)) ([]byte, error) {
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return nil, err
+	}
+	off := int(f.Metadata().RowGroups[0].Columns[col].MetaData.DataPageOffset)
+	// The header's length is not recorded: it is the length of the prefix
+	// the decoder accepts without trailing bytes.
+	var h format.PageHeader
+	size := 0
+	for k := 1; k <= len(data)-off; k++ {
+		if thrift.Unmarshal(new(thrift.CompactProtocol), data[off:off+k], &h) == nil {
+			size = k
+			break
+		}
+	}
+	if size == 0 {
+		return nil, fmt.Errorf("no page header at offset %d", off)
+	}
+	edit(&h)
+	header, err := thrift.Marshal(new(thrift.CompactProtocol), &h)
+	if err != nil {
+		return nil, err
+	}
+	if len(header) != size {
+		return nil, fmt.Errorf("the edited page header is %d bytes, the written one %d", len(header), size)
+	}
+	out := append([]byte(nil), data...)
+	copy(out[off:], header)
+	return out, nil
+}
+
+// openFileAllowance is what OpenFile may allocate for a file of size bytes:
+// the file itself (its footer, read optimistically, and the page index
+// buffers) and the structures decoded from it.
+func openFileAllowance(size int) int64 { return 4*int64(size) + 256<<10 }
+
+// openFileInProcess is the largest footer claim opened in this process; a
+// larger one goes to a child, whose address space is capped.
+const openFileInProcess = 64 << 20
+
+// openFileMeasured opens the file in this process and reports what OpenFile
+// allocated meanwhile.
+func openFileMeasured(data []byte) (f *parquet.File, err error, alloc int64) {
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	f, err = parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	runtime.ReadMemStats(&after)
+	return f, err, int64(after.TotalAlloc - before.TotalAlloc)
+}
+
+// openOutcome opens the file in this process and describes the outcome:
+// "ok", "error: ..." or "panic: ...".
+func openOutcome(data []byte) (f *parquet.File, alloc int64, res string) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	var err error
+	f, err, alloc = openFileMeasured(data)
+	if err != nil {
+		return f, alloc, "error: " + err.Error()
+	}
+	return f, alloc, "ok"
+}
+
+// readOutcome reads up to 1000 rows of the file through the row API and
+// describes the outcome: "ok" or "panic: ...".
+func readOutcome(f *parquet.File) (res string) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	var read int64
+	for _, rg := range f.RowGroups() {
+		rr := rg.Rows()
+		buf := make([]parquet.Row, 4)
+		for read < 1000 {
+			k, err := rr.ReadRows(buf)
+			read += int64(k)
+			if err != nil || k == 0 {
+				break
+			}
+		}
+		rr.Close()
+	}
+	return "ok"
+}
+
+// decodeOutcome decodes an LZ4_RAW block and describes the outcome.
+func decodeOutcome(src []byte) (res string) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	if _, err := parquet.Lz4Raw.Decode(nil, src); err != nil {
+		return "error: " + err.Error()
+	}
+	return "ok"
+}
+
+// openFileVerdict words an outcome for a failure message.
+func openFileVerdict(alloc int64, res string) string {
+	if res == childDies {
+		return res
+	}
+	return fmt.Sprintf("allocates %d bytes and returns %s", alloc, res)
+}
+
+// The environment variables of the child that opens one file, decodes one
+// LZ4 block, or reads one file of noise: the test re-runs itself with the
+// file's path, or the block's bytes, in one of them (golang-ical's pattern
+// for a call that cannot be run in-process).
+const (
+	openFileChildEnv    = "ZOO_PARQUET_OPEN_FILE"
+	lz4BlockChildEnv    = "ZOO_PARQUET_LZ4_BLOCK"
+	noiseFileChildEnv   = "ZOO_PARQUET_NOISE_FILE"
+	readFileChildEnv    = "ZOO_PARQUET_READ_FILE"
+	readSchemaChildEnv  = "ZOO_PARQUET_READ_SCHEMA"
+	childAddressSpaceKB = 2500000 // ulimit -v of the child; the test binary needs 1.8 GB to start
+	childDies           = "dies: out of memory"
+)
+
+// openFileChild is the child's side of openFileInChild, lz4DecodeInChild,
+// readNoiseInChild and readFile: in the child it does the one thing asked,
+// prints the outcome and reports true, so the test returns.
+func openFileChild() bool {
+	if path := os.Getenv(readFileChildEnv); path != "" {
+		var m map[string]any
+		data, err := os.ReadFile(path)
+		if err == nil {
+			err = json.Unmarshal([]byte(os.Getenv(readSchemaChildEnv)), &m)
+		}
+		if err != nil {
+			fmt.Printf("ZOO_READ_FILE result=%q\n", "child: "+err.Error())
+			return true
+		}
+		r := readFileOutcome(data, specFromJSON(m), int(num(m["limit"])))
+		rows := make([]json.RawMessage, len(r.rows))
+		for i, row := range r.rows {
+			rows[i] = json.RawMessage(row)
+		}
+		fmt.Printf("ZOO_READ_FILE_ROWS %s\nZOO_READ_FILE_GROUPS %s\nZOO_READ_FILE result=%q\n", jsonString(rows), jsonString(r.groups), r.result)
+		return true
+	}
+	if h := os.Getenv(lz4BlockChildEnv); h != "" {
+		src, err := hex.DecodeString(h)
+		if err != nil {
+			fmt.Printf("ZOO_LZ4 result=%q\n", "child: "+err.Error())
+		} else {
+			fmt.Printf("ZOO_LZ4 result=%q\n", decodeOutcome(src))
+		}
+		return true
+	}
+	if path := os.Getenv(noiseFileChildEnv); path != "" {
+		fmt.Printf("ZOO_NOISE result=%q\n", readNoiseOutcome(path))
+		return true
+	}
+	path := os.Getenv(openFileChildEnv)
+	if path == "" {
+		return false
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		fmt.Printf("ZOO_OPEN alloc=0 open=%q\n", "child: reading the file: "+err.Error())
+		return true
+	}
+	f, alloc, open := openOutcome(data)
+	fmt.Printf("ZOO_OPEN alloc=%d open=%q\n", alloc, open)
+	if open != "ok" {
+		return true
+	}
+	fmt.Printf("ZOO_READ read=%q\n", readOutcome(f))
+	// The reflection reader too, when the schema is given.
+	if schema := os.Getenv(readSchemaChildEnv); schema != "" {
+		var m map[string]any
+		if err := json.Unmarshal([]byte(schema), &m); err != nil {
+			fmt.Printf("ZOO_REFLECT reflect=%q\n", "child: "+err.Error())
+			return true
+		}
+		fmt.Printf("ZOO_REFLECT reflect=%q\n", reflectOutcome(data, specFromJSON(m), int(num(m["limit"]))))
+	}
+	return true
+}
+
+// reflectOutcome reads up to limit rows of the file into values of the
+// schema's type and describes the outcome: "ok", "error: ..." or
+// "panic: ...".
+func reflectOutcome(data []byte, spec fieldSpec, limit int) (res string) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	if _, err := readReflect(data, baseType(spec), limit); err != nil {
+		return "error: " + err.Error()
+	}
+	return "ok"
+}
+
+// runChild re-runs the test in a child process with the environment
+// variables set and its address space capped, returning its output.
+func runChild(testName string, env ...string) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/bin/sh", "-c", fmt.Sprintf(`ulimit -v %d && exec "$0" "$@"`, childAddressSpaceKB), os.Args[0], "-test.run", "^"+testName+"$")
+	cmd.Env = append(os.Environ(), env...)
+	cmd.WaitDelay = 500 * time.Millisecond // a killed child cannot hold the pipes open
+	out, err := cmd.CombinedOutput()
+	if err != nil && ctx.Err() != nil {
+		err = ctx.Err()
+	}
+	return string(out), err
+}
+
+// childNothing words a child that reported nothing.
+func childNothing(out string, err error) string {
+	text := strings.TrimSpace(out)
+	if len(text) > 400 {
+		text = text[len(text)-400:]
+	}
+	return fmt.Sprintf("child: the child reports nothing (%v): %s", err, text)
+}
+
+// childOutcome is what the child reports of a file: what OpenFile allocated
+// and how opening, reading through the row API and (when a schema was
+// given) through the reflection Reader ended ("ok", "error: ...",
+// "panic: ..." or childDies; "child: ..." when the child itself failed).
+type childOutcome struct {
+	alloc               int64
+	open, read, reflect string
+}
+
+// inChildFile writes the data to a temporary file and runs the child with
+// the environment variable naming it (and the others given).
+func inChildFile(testName, env string, data []byte, more ...string) (string, error) {
+	tmp, err := os.CreateTemp("", "zoo-open-*.parquet")
+	if err != nil {
+		return "", err
+	}
+	defer os.Remove(tmp.Name())
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return "", err
+	}
+	tmp.Close()
+	return runChild(testName, append([]string{env + "=" + tmp.Name()}, more...)...)
+}
+
+// openFileInChild opens the file and reads its rows in a child process,
+// through the reflection Reader too when the schema is given.
+func openFileInChild(testName string, data []byte, schema ...string) childOutcome {
+	out, err := inChildFile(testName, openFileChildEnv, data, schema...)
+	if out == "" && err != nil {
+		return childOutcome{open: "child: " + err.Error()}
+	}
+	var c childOutcome
+	for _, line := range strings.Split(out, "\n") {
+		switch {
+		case strings.HasPrefix(line, "ZOO_OPEN "):
+			fmt.Sscanf(line, "ZOO_OPEN alloc=%d open=%q", &c.alloc, &c.open)
+		case strings.HasPrefix(line, "ZOO_READ "):
+			fmt.Sscanf(line, "ZOO_READ read=%q", &c.read)
+		case strings.HasPrefix(line, "ZOO_REFLECT "):
+			fmt.Sscanf(line, "ZOO_REFLECT reflect=%q", &c.reflect)
+		}
+	}
+	died := strings.Contains(out, "out of memory")
+	switch {
+	case c.open == "" && died:
+		c.open = childDies
+	case c.open == "":
+		c.open = childNothing(out, err)
+	case c.open == "ok" && c.read == "" && died:
+		c.read = childDies
+	case c.open == "ok" && c.read == "":
+		c.read = childNothing(out, err)
+	case c.open == "ok" && len(schema) > 0 && c.reflect == "" && died:
+		c.reflect = childDies
+	case c.open == "ok" && len(schema) > 0 && c.reflect == "":
+		c.reflect = childNothing(out, err)
+	}
+	return c
+}
+
+// lz4DecodeInChild decodes the block in a child process.
+func lz4DecodeInChild(testName string, block []byte) string {
+	out, err := runChild(testName, lz4BlockChildEnv+"="+hex.EncodeToString(block))
+	return childResult(out, err, "ZOO_LZ4 result=%q")
+}
+
+// childResult is the result the child printed in the format, childDies
+// when it died, else what it printed instead.
+func childResult(out string, err error, format string) string {
+	for _, line := range strings.Split(out, "\n") {
+		var res string
+		if strings.HasPrefix(line, strings.SplitN(format, " ", 2)[0]) {
+			if _, err := fmt.Sscanf(line, format, &res); err == nil {
+				return res
+			}
+		}
+	}
+	if strings.Contains(out, "out of memory") {
+		return childDies
+	}
+	return childNothing(out, err)
+}
+
+// checkOpenFileChild makes sure the child opens and reads a sound file, so
+// that a child that dies is the library's doing.
+func checkOpenFileChild(t *testing.T, testName string) {
+	var buf bytes.Buffer
+	if err := parquet.Write[smallRow](&buf, []smallRow{{1, "x"}}); err != nil {
+		t.Fatal(err)
+	}
+	if c := openFileInChild(testName, buf.Bytes()); c.open != "ok" || c.read != "ok" {
+		t.Fatalf("the child process does not open and read a sound %d-byte file: open %s, read %s (allocated %d bytes)", buf.Len(), c.open, c.read, c.alloc)
+	}
+}
+
+// isZeroBits reports the canonical form of +0.0 or -0.0.
+func isZeroBits(c string) bool {
+	switch c {
+	case "f32:00000000", "f32:80000000", "f64:0000000000000000", "f64:8000000000000000":
+		return true
+	}
+	return false
+}
