+// ---------------------------------------------------------------------------
+// Damage: a list of edits applied to a file by a pure function, positions
+// taken modulo the live length.
+
+// edit is one change to a file: a bit flipped, a byte set, the file
+// truncated, a span of bytes deleted or bytes inserted, at a position.
+type edit struct {
+	kind  string
+	at    int
+	bit   int
+	value byte
+	span  int
+	bytes []byte
+}
+
+func (e edit) GoString() string {
+	switch e.kind {
+	case "flip":
+		return fmt.Sprintf("flip bit %d at %d", e.bit, e.at)
+	case "set":
+		return fmt.Sprintf("set %#x at %d", e.value, e.at)
+	case "delete":
+		return fmt.Sprintf("delete %d at %d", e.span, e.at)
+	case "insert":
+		return fmt.Sprintf("insert %x at %d", e.bytes, e.at)
+	}
+	return fmt.Sprintf("%s at %d", e.kind, e.at)
+}
+
+var (
+	positions = hegel.Integers(0, 1<<20-1)
+	edits     = weighted(
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "flip", at: hegel.Draw(tc, positions), bit: hegel.Draw(tc, hegel.Integers(0, 7))}
+		})},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "set", at: hegel.Draw(tc, positions), value: hegel.Draw(tc, byteValues)}
+		})},
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "truncate", at: at} })},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "delete", at: hegel.Draw(tc, positions), span: hegel.Draw(tc, hegel.Integers(1, 8))}
+		})},
+		choice[edit]{1, hegel.Composite(func(tc hegel.TestCase) edit {
+			return edit{kind: "insert", at: hegel.Draw(tc, positions), bytes: hegel.Draw(tc, listsOf(byteValues, hegel.Integers(1, 8)))}
+		})},
+	)
+	damages = hegel.Lists(edits).MinSize(1).MaxSize(3)
+)
+
+// damage applies the edits to a copy of the data, positions taken modulo
+// the first within bytes (the live length at most); an edit of an empty
+// file is a no-op.
+func damage(data []byte, edits []edit, within int) []byte {
+	out := append([]byte(nil), data...)
+	for _, e := range edits {
+		n := min(within, len(out))
+		if n <= 0 {
+			break
+		}
+		i := e.at % n
+		switch e.kind {
+		case "flip":
+			out[i] ^= byte(1 << uint(e.bit))
+		case "set":
+			out[i] = e.value
+		case "truncate":
+			out = out[:i]
+		case "delete":
+			out = append(out[:i], out[min(i+e.span, len(out)):]...)
+		case "insert":
+			out = append(out[:i], append(append([]byte(nil), e.bytes...), out[i:]...)...)
+		}
+	}
+	return out
+}
+
+// damagedCase is a file parquet-go wrote and the edits that damage it.
+type damagedCase struct {
+	goCase
+	edits []edit
+}
+
+func (c damagedCase) GoString() string { return fmt.Sprintf("%s, damaged by %#v", c.goCase, c.edits) }
+
+var damagedCases = hegel.Composite(func(tc hegel.TestCase) damagedCase {
+	return damagedCase{goCase: hegel.Draw(tc, goCases), edits: hegel.Draw(tc, damages)}
+})
