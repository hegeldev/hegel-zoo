@@ -0,0 +1,874 @@
+package hegel
+
+// Generators: a schema spec, the reflect-built Go struct type for it (with
+// parquet struct tags), random rows of that type, the canonical form of a
+// row shared with the oracle, and the writer options of a file.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kBool kind = iota
+	kInt8
+	kInt16
+	kInt32
+	kInt64
+	kUint8
+	kUint16
+	kUint32
+	kUint64
+	kFloat
+	kDouble
+	kString
+	kBytes
+	kFixed
+	kUUID
+	kJSON
+	kEnum
+	kDec32
+	kDec64
+	kDecFixed
+	kDate
+	kTimeMs
+	kTimeUs
+	kTimeNs
+	kTsMs
+	kTsUs
+	kTsNs
+	kGroup
+)
+
+var kindNames = [...]string{"bool", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float", "double", "string", "bytes", "fixed", "uuid", "json", "enum", "decimal32", "decimal64", "decimalfixed", "date", "time_ms", "time_us", "time_ns", "ts_ms", "ts_us", "ts_ns", "group"}
+
+func (k kind) String() string { return kindNames[k] }
+
+// scalarKinds are the leaf kinds; mapValueKinds the ones used as map values.
+var scalarKinds = []kind{kBool, kInt8, kInt16, kInt32, kInt64, kUint8, kUint16, kUint32, kUint64, kFloat, kDouble, kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDec32, kDec64, kDecFixed, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs}
+var mapValueKinds = []kind{kBool, kInt32, kInt64, kDouble, kString, kBytes}
+
+// fieldSpec describes one field of a schema.
+type fieldSpec struct {
+	name         string
+	kind         kind
+	optional     bool   // a pointer in Go, nullable in parquet
+	rep          string // "", "repeated" (bare slice) or "list" (LIST logical type)
+	elemOptional bool   // list elements are pointers
+	isMap        bool   // map[string]kind
+	fixedLen     int    // for kFixed, kDecFixed
+	scale        int    // decimals
+	precision    int
+	utc          bool // timestamps
+	enc          string
+	comp         string
+	pyEnc        string      // pyarrow's encoding of the column (the reverse direction)
+	pyComp       string      // pyarrow's codec of the column (the reverse direction)
+	fields       []fieldSpec // kGroup
+}
+
+func (f fieldSpec) String() string {
+	var b strings.Builder
+	b.WriteString(f.name + ":")
+	if f.optional {
+		b.WriteString("?")
+	}
+	if f.rep != "" {
+		b.WriteString(f.rep + "<")
+		if f.elemOptional {
+			b.WriteString("?")
+		}
+	}
+	if f.isMap {
+		b.WriteString("map<string,")
+	}
+	if f.kind == kGroup {
+		parts := make([]string, len(f.fields))
+		for i, s := range f.fields {
+			parts[i] = s.String()
+		}
+		b.WriteString("{" + strings.Join(parts, " ") + "}")
+	} else {
+		b.WriteString(f.kind.String())
+	}
+	switch f.kind {
+	case kFixed, kDecFixed:
+		fmt.Fprintf(&b, "(%d)", f.fixedLen)
+	}
+	switch f.kind {
+	case kDec32, kDec64, kDecFixed:
+		fmt.Fprintf(&b, "[%d.%d]", f.precision, f.scale)
+	case kTsMs, kTsUs, kTsNs:
+		if f.utc {
+			b.WriteString("[utc]")
+		} else {
+			b.WriteString("[local]")
+		}
+	}
+	if f.rep != "" || f.isMap {
+		b.WriteString(">")
+	}
+	if f.enc != "" {
+		b.WriteString("," + f.enc)
+	}
+	if f.comp != "" {
+		b.WriteString("," + f.comp)
+	}
+	if f.pyEnc != "" {
+		b.WriteString(",py:" + f.pyEnc)
+	}
+	if f.pyComp != "" {
+		b.WriteString(",py:" + f.pyComp)
+	}
+	return b.String()
+}
+
+// genSchema draws a top-level schema: a group of 1..6 fields.
+func genSchema(tc hegel.TestCase) fieldSpec {
+	return genGroup(tc, "root", 0)
+}
+
+func genGroup(tc hegel.TestCase, name string, depth int) fieldSpec {
+	g := fieldSpec{name: name, kind: kGroup}
+	nf := n(tc, 1, 6)
+	if depth > 0 {
+		nf = n(tc, 1, 3)
+	}
+	for i := 0; i < nf; i++ {
+		g.fields = append(g.fields, genField(tc, fmt.Sprintf("%s%d", pick(tc, "c", "col", "x", "Val", "f_"), i), depth))
+	}
+	return g
+}
+
+func genField(tc hegel.TestCase, name string, depth int) fieldSpec {
+	f := fieldSpec{name: name}
+	switch {
+	case depth < 2 && chance(tc, 15):
+		f = genGroup(tc, name, depth+1)
+	case chance(tc, 8):
+		f.isMap = true
+		f.kind = pick(tc, mapValueKinds...)
+	default:
+		f.kind = pick(tc, scalarKinds...)
+	}
+	switch f.kind {
+	case kFixed:
+		f.fixedLen = n(tc, 1, 20)
+	case kDecFixed:
+		f.fixedLen = n(tc, 1, 15)
+		// The largest precision whose values all fit in fixedLen signed bytes.
+		f.precision = int(math.Floor(float64(8*f.fixedLen-1) * math.Log10(2)))
+		if f.precision > 38 {
+			f.precision = 38
+		}
+		f.scale = n(tc, 0, f.precision)
+	case kDec32:
+		f.precision = n(tc, 1, 9)
+		f.scale = n(tc, 0, f.precision)
+	case kDec64:
+		f.precision = n(tc, 1, 18)
+		f.scale = n(tc, 0, f.precision)
+	case kTsMs, kTsUs, kTsNs:
+		f.utc = chance(tc, 50)
+	}
+	if !f.isMap {
+		switch n(tc, 1, 10) {
+		case 1, 2, 3:
+			f.optional = true
+		case 4:
+			f.rep = "repeated"
+		case 5, 6:
+			f.rep = "list"
+			f.elemOptional = chance(tc, 50)
+		}
+		if f.kind == kGroup && f.rep == "repeated" && chance(tc, 50) {
+			f.rep = "list"
+		}
+	}
+	// The tags parquet-go accepts depend on the Go shape: logical-type tags
+	// are refused on bare slices; on pointers enum, time and uuid are refused
+	// and json loses the optionality (see the notes); delta is refused on
+	// both.
+	pointer := f.optional || f.elemOptional
+	if f.kind != kGroup && !f.isMap && (f.rep == "repeated" || pointer) {
+		bad := map[kind]bool{kEnum: true, kTimeMs: true, kTimeUs: true, kTimeNs: true, kUUID: true, kJSON: true}
+		if f.rep == "repeated" {
+			for _, k := range []kind{kDec32, kDec64, kDecFixed, kDate, kTsMs, kTsUs, kTsNs} {
+				bad[k] = true
+			}
+		}
+		if bad[f.kind] {
+			f.kind = pick(tc, kInt32, kInt64, kString, kBytes, kFixed, kDouble)
+			f.fixedLen = n(tc, 1, 20)
+		}
+	}
+	if f.rep != "" && f.kind == kUint8 {
+		f.kind = kUint16 // []uint8 is []byte to Go and to parquet-go: a byte array, not a list
+	}
+	if f.kind != kGroup && !f.isMap && chance(tc, 40) {
+		encs := []string{"plain", "dict", "delta"}
+		switch f.kind {
+		case kBool:
+			encs = []string{"plain", "dict"}
+		case kFloat, kDouble:
+			encs = []string{"plain", "dict", "split"}
+		}
+		if f.rep == "repeated" || pointer {
+			encs = encs[:2]
+		}
+		f.enc = pick(tc, encs...)
+	}
+	if f.kind != kGroup && !f.isMap && chance(tc, 30) {
+		f.comp = pick(tc, "snappy", "gzip", "zstd", "lz4", "brotli", "uncompressed")
+	}
+	return f
+}
+
+// baseType is the Go type of one value of the field (without pointer, slice
+// or map).
+func baseType(f fieldSpec) reflect.Type {
+	switch f.kind {
+	case kBool:
+		return reflect.TypeOf(false)
+	case kInt8:
+		return reflect.TypeOf(int8(0))
+	case kInt16:
+		return reflect.TypeOf(int16(0))
+	case kInt32, kDec32, kDate, kTimeMs:
+		return reflect.TypeOf(int32(0))
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return reflect.TypeOf(int64(0))
+	case kUint8:
+		return reflect.TypeOf(uint8(0))
+	case kUint16:
+		return reflect.TypeOf(uint16(0))
+	case kUint32:
+		return reflect.TypeOf(uint32(0))
+	case kUint64:
+		return reflect.TypeOf(uint64(0))
+	case kFloat:
+		return reflect.TypeOf(float32(0))
+	case kDouble:
+		return reflect.TypeOf(float64(0))
+	case kString, kJSON, kEnum:
+		return reflect.TypeOf("")
+	case kBytes:
+		return reflect.TypeOf([]byte(nil))
+	case kFixed, kDecFixed:
+		return reflect.ArrayOf(f.fixedLen, reflect.TypeOf(byte(0)))
+	case kUUID:
+		return reflect.ArrayOf(16, reflect.TypeOf(byte(0)))
+	case kGroup:
+		fields := make([]reflect.StructField, len(f.fields))
+		for i, s := range f.fields {
+			fields[i] = reflect.StructField{Name: fmt.Sprintf("F%d", i), Type: goType(s), Tag: reflect.StructTag(tagOf(s))}
+		}
+		return reflect.StructOf(fields)
+	}
+	panic("unknown kind")
+}
+
+// goType is the Go type of the field as a struct member.
+func goType(f fieldSpec) reflect.Type {
+	t := baseType(f)
+	if f.isMap {
+		return reflect.MapOf(reflect.TypeOf(""), t)
+	}
+	if f.rep != "" {
+		if f.elemOptional {
+			t = reflect.PointerTo(t)
+		}
+		return reflect.SliceOf(t)
+	}
+	if f.optional {
+		return reflect.PointerTo(t)
+	}
+	return t
+}
+
+// logicalTags are the tags of the field's logical type.
+func logicalTags(f fieldSpec) []string {
+	switch f.kind {
+	case kEnum:
+		return []string{"enum"}
+	case kJSON:
+		return []string{"json"}
+	case kUUID:
+		return []string{"uuid"}
+	case kDec32, kDec64, kDecFixed:
+		return []string{fmt.Sprintf("decimal(%d:%d)", f.scale, f.precision)}
+	case kDate:
+		return []string{"date"}
+	case kTimeMs:
+		return []string{"time(millisecond)"}
+	case kTimeUs:
+		return []string{"time(microsecond)"}
+	case kTimeNs:
+		return []string{"time(nanosecond)"}
+	case kTsMs, kTsUs, kTsNs:
+		unit := map[kind]string{kTsMs: "millisecond", kTsUs: "microsecond", kTsNs: "nanosecond"}[f.kind]
+		adj := "local"
+		if f.utc {
+			adj = "utc"
+		}
+		return []string{fmt.Sprintf("timestamp(%s:%s)", unit, adj)}
+	}
+	return nil
+}
+
+// tagOf is the parquet struct tag of the field: for a LIST the logical type,
+// encoding and compression go on the element.
+func tagOf(f fieldSpec) string {
+	leaf := logicalTags(f)
+	if f.enc != "" {
+		leaf = append(leaf, f.enc)
+	}
+	if f.comp != "" {
+		leaf = append(leaf, f.comp)
+	}
+	if f.rep == "list" {
+		tag := fmt.Sprintf(`parquet:"%s,list"`, f.name)
+		if len(leaf) > 0 {
+			tag += fmt.Sprintf(` parquet-element:",%s"`, strings.Join(leaf, ","))
+		}
+		return tag
+	}
+	return fmt.Sprintf(`parquet:"%s"`, strings.Join(append([]string{f.name}, leaf...), ","))
+}
+
+// ---------------------------------------------------------------------------
+// Values.
+
+func genRows(tc hegel.TestCase, schema fieldSpec, typ reflect.Type) []reflect.Value {
+	nr := pick(tc, 0, 1, 2, n(tc, 1, 12), n(tc, 1, 60))
+	rows := make([]reflect.Value, nr)
+	for i := range rows {
+		rows[i] = genBase(tc, schema)
+	}
+	return rows
+}
+
+// genValue draws a value of goType(f).
+func genValue(tc hegel.TestCase, f fieldSpec) reflect.Value {
+	if f.isMap {
+		m := reflect.MakeMap(goType(f))
+		for i, k := 0, n(tc, 0, 4); i < k; i++ {
+			m.SetMapIndex(reflect.ValueOf(genString(tc)), genBase(tc, f))
+		}
+		return m
+	}
+	if f.rep != "" {
+		l := pick(tc, 0, 1, n(tc, 0, 5))
+		s := reflect.MakeSlice(goType(f), l, l)
+		for i := 0; i < l; i++ {
+			if f.elemOptional {
+				if chance(tc, 30) {
+					continue
+				}
+				p := reflect.New(baseType(f))
+				p.Elem().Set(genBase(tc, f))
+				s.Index(i).Set(p)
+			} else {
+				s.Index(i).Set(genBase(tc, f))
+			}
+		}
+		return s
+	}
+	if f.optional {
+		if chance(tc, 30) {
+			return reflect.Zero(goType(f))
+		}
+		p := reflect.New(baseType(f))
+		p.Elem().Set(genBase(tc, f))
+		return p
+	}
+	return genBase(tc, f)
+}
+
+func genInt64(tc hegel.TestCase, bits int) int64 {
+	switch n(tc, 1, 6) {
+	case 1:
+		return 0
+	case 2:
+		return int64(n(tc, -100, 100))
+	case 3:
+		return math.MaxInt64 >> (64 - bits)
+	case 4:
+		return math.MinInt64 >> (64 - bits)
+	case 5:
+		return int64(n(tc, -1000000, 1000000))
+	}
+	hi := uint64(n(tc, 0, math.MaxInt32))
+	lo := uint64(n(tc, 0, math.MaxInt32))
+	v := int64(hi<<33 ^ lo<<1 ^ uint64(n(tc, 0, 1)))
+	return v >> (64 - bits)
+}
+
+func genUint64(tc hegel.TestCase, bits int) uint64 {
+	switch n(tc, 1, 5) {
+	case 1:
+		return 0
+	case 2:
+		return uint64(n(tc, 0, 200))
+	case 3:
+		return math.MaxUint64 >> (64 - bits)
+	case 4:
+		return (uint64(1) << (bits - 1)) + uint64(n(tc, 0, 3))
+	}
+	hi := uint64(n(tc, 0, math.MaxInt32))
+	lo := uint64(n(tc, 0, math.MaxInt32))
+	return (hi<<33 ^ lo<<1 ^ uint64(n(tc, 0, 1))) >> (64 - bits)
+}
+
+func genFloat64(tc hegel.TestCase) float64 {
+	switch n(tc, 1, 10) {
+	case 1:
+		return 0
+	case 2:
+		return math.Copysign(0, -1)
+	case 3:
+		return math.NaN()
+	case 4:
+		return math.Inf(1)
+	case 5:
+		return math.Inf(-1)
+	case 6:
+		return math.MaxFloat64
+	case 7:
+		return math.SmallestNonzeroFloat64
+	case 8:
+		return float64(n(tc, -1000, 1000)) / 8
+	}
+	return math.Float64frombits(uint64(n(tc, 0, math.MaxInt32))<<32 | uint64(n(tc, 0, math.MaxInt32)))
+}
+
+func genFloat32(tc hegel.TestCase) float32 {
+	switch n(tc, 1, 10) {
+	case 1:
+		return 0
+	case 2:
+		return float32(math.Copysign(0, -1))
+	case 3:
+		return float32(math.NaN())
+	case 4:
+		return float32(math.Inf(1))
+	case 5:
+		return float32(math.Inf(-1))
+	case 6:
+		return math.MaxFloat32
+	case 7:
+		return math.SmallestNonzeroFloat32
+	case 8:
+		return float32(n(tc, -1000, 1000)) / 8
+	}
+	return math.Float32frombits(uint32(n(tc, 0, math.MaxInt32))<<1 | uint32(n(tc, 0, 1)))
+}
+
+var alphabet = []string{"a", "b", "z", "A", "0", "9", " ", "_", "-", ".", "\u00e9", "\u65e5", "\U0001F600", "\u00a0", "\"", "\\", "\n", "\x00"}
+
+func genString(tc hegel.TestCase) string {
+	l := pick(tc, 0, 1, n(tc, 0, 12), n(tc, 20, 60))
+	var b strings.Builder
+	for i := 0; i < l; i++ {
+		b.WriteString(pick(tc, alphabet...))
+	}
+	return b.String()
+}
+
+func genBytes(tc hegel.TestCase, l int) []byte {
+	b := make([]byte, l)
+	for i := range b {
+		b[i] = byte(pick(tc, 0, 1, 0x7f, 0x80, 0xff, n(tc, 0, 255)))
+	}
+	return b
+}
+
+// genDecimalBytes draws an unscaled decimal of at most precision digits as a
+// big-endian two's complement value of l bytes.
+func genDecimalBytes(tc hegel.TestCase, l, precision int) []byte {
+	limit := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(precision)), nil)
+	var v *big.Int
+	switch n(tc, 1, 4) {
+	case 1:
+		v = big.NewInt(int64(n(tc, -100, 100)))
+		v.Rem(v, limit) // within the precision (1 or 2 digits are possible)
+	case 2:
+		v = new(big.Int).Sub(limit, big.NewInt(1))
+		if chance(tc, 50) {
+			v.Neg(v)
+		}
+	default:
+		v = big.NewInt(0)
+		for i := 0; i < l; i++ {
+			v.Lsh(v, 8)
+			v.Or(v, big.NewInt(int64(n(tc, 0, 255))))
+		}
+		v.Mod(v, limit)
+		if chance(tc, 50) {
+			v.Neg(v)
+		}
+	}
+	// two's complement, l bytes
+	mod := new(big.Int).Lsh(big.NewInt(1), uint(8*l))
+	u := new(big.Int).Mod(v, mod)
+	b := u.FillBytes(make([]byte, l))
+	return b
+}
+
+func setBytes(v reflect.Value, b []byte) {
+	reflect.Copy(v, reflect.ValueOf(b))
+}
+
+// genBase draws one value of baseType(f).
+func genBase(tc hegel.TestCase, f fieldSpec) reflect.Value {
+	t := baseType(f)
+	switch f.kind {
+	case kBool:
+		return reflect.ValueOf(chance(tc, 50))
+	case kInt8:
+		return reflect.ValueOf(int8(genInt64(tc, 8)))
+	case kInt16:
+		return reflect.ValueOf(int16(genInt64(tc, 16)))
+	case kInt32, kDate:
+		return reflect.ValueOf(int32(genInt64(tc, 32)))
+	case kInt64, kTsMs, kTsUs, kTsNs:
+		return reflect.ValueOf(genInt64(tc, 64))
+	case kTimeMs:
+		return reflect.ValueOf(int32(pick(tc, 0, 86399999, n(tc, 0, 86399999))))
+	case kTimeUs:
+		return reflect.ValueOf(int64(pick(tc, 0, 86399999999, n(tc, 0, 86399999999))))
+	case kTimeNs:
+		return reflect.ValueOf(int64(pick(tc, 0, 86399999999999, n(tc, 0, 86399999999999))))
+	case kUint8:
+		return reflect.ValueOf(uint8(genUint64(tc, 8)))
+	case kUint16:
+		return reflect.ValueOf(uint16(genUint64(tc, 16)))
+	case kUint32:
+		return reflect.ValueOf(uint32(genUint64(tc, 32)))
+	case kUint64:
+		return reflect.ValueOf(genUint64(tc, 64))
+	case kFloat:
+		return reflect.ValueOf(genFloat32(tc))
+	case kDouble:
+		return reflect.ValueOf(genFloat64(tc))
+	case kString, kEnum:
+		return reflect.ValueOf(genString(tc))
+	case kJSON:
+		return reflect.ValueOf(pick(tc, `{}`, `[]`, `{"a":1}`, `"`+genString(tc)+`"`, `null`, strconv.Itoa(n(tc, -5, 5))))
+	case kBytes:
+		return reflect.ValueOf(genBytes(tc, pick(tc, 0, 1, n(tc, 0, 12), n(tc, 20, 50))))
+	case kFixed, kUUID:
+		v := reflect.New(t).Elem()
+		setBytes(v, genBytes(tc, t.Len()))
+		return v
+	case kDec32:
+		limit := int64(math.Pow10(f.precision))
+		return reflect.ValueOf(int32(genInt64(tc, 32) % limit))
+	case kDec64:
+		limit := int64(math.Pow10(f.precision))
+		return reflect.ValueOf(genInt64(tc, 64) % limit)
+	case kDecFixed:
+		v := reflect.New(t).Elem()
+		setBytes(v, genDecimalBytes(tc, f.fixedLen, f.precision))
+		return v
+	case kGroup:
+		v := reflect.New(t).Elem()
+		for i, s := range f.fields {
+			v.Field(i).Set(genValue(tc, s))
+		}
+		return v
+	}
+	panic("unknown kind")
+}
+
+// ---------------------------------------------------------------------------
+// Canonical form (see oracle.py).
+
+func canonValue(f fieldSpec, v reflect.Value) any {
+	if f.isMap {
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return keys[i].String() < keys[j].String() })
+		pairs := make([]any, 0, len(keys))
+		for _, k := range keys {
+			pairs = append(pairs, []any{k.String(), canonBase(f, v.MapIndex(k))})
+		}
+		return pairs
+	}
+	if f.rep != "" {
+		out := make([]any, 0, v.Len())
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			if f.elemOptional {
+				if e.IsNil() {
+					out = append(out, nil)
+					continue
+				}
+				e = e.Elem()
+			}
+			out = append(out, canonBase(f, e))
+		}
+		return out
+	}
+	if f.optional {
+		if v.IsNil() {
+			return nil
+		}
+		v = v.Elem()
+	}
+	return canonBase(f, v)
+}
+
+func arrayBytes(v reflect.Value) []byte {
+	b := make([]byte, v.Len())
+	reflect.Copy(reflect.ValueOf(b), v)
+	return b
+}
+
+func canonBase(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kBool:
+		return v.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return strconv.FormatInt(v.Int(), 10)
+	case kUint8, kUint16, kUint32, kUint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case kFloat:
+		return fmt.Sprintf("f32:%08x", math.Float32bits(float32(v.Float())))
+	case kDouble:
+		return fmt.Sprintf("f64:%016x", math.Float64bits(v.Float()))
+	case kString, kJSON:
+		return v.String()
+	case kEnum:
+		return hex.EncodeToString([]byte(v.String()))
+	case kBytes:
+		return hex.EncodeToString(v.Bytes())
+	case kFixed, kUUID:
+		return hex.EncodeToString(arrayBytes(v))
+	case kDecFixed:
+		return twosComplement(arrayBytes(v)).String()
+	case kGroup:
+		m := map[string]any{}
+		for i, s := range f.fields {
+			m[s.name] = canonValue(s, v.Field(i))
+		}
+		return m
+	}
+	panic("unknown kind")
+}
+
+func twosComplement(b []byte) *big.Int {
+	v := new(big.Int).SetBytes(b)
+	if len(b) > 0 && b[0]&0x80 != 0 {
+		v.Sub(v, new(big.Int).Lsh(big.NewInt(1), uint(8*len(b))))
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Statistics truth for the flat leaves.
+
+// flatLeaf is a leaf reached through non-repeated fields only, whose
+// statistics are simple: one value or null per row.
+type flatLeaf struct {
+	path string
+	spec fieldSpec
+	get  func(row reflect.Value) (reflect.Value, bool) // value of the leaf in the row, present?
+}
+
+func flatLeaves(schema fieldSpec) []flatLeaf {
+	var out []flatLeaf
+	var walk func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool))
+	walk = func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool)) {
+		for i, s := range f.fields {
+			i, s := i, s
+			if s.rep != "" || s.isMap {
+				continue
+			}
+			sub := func(row reflect.Value) (reflect.Value, bool) {
+				g, ok := get(row)
+				if !ok {
+					return reflect.Value{}, false
+				}
+				v := g.Field(i)
+				if s.optional {
+					if v.IsNil() {
+						return reflect.Value{}, false
+					}
+					v = v.Elem()
+				}
+				return v, true
+			}
+			name := s.name
+			if prefix != "" {
+				name = prefix + "." + s.name
+			}
+			if s.kind == kGroup {
+				walk(s, name, sub)
+			} else {
+				out = append(out, flatLeaf{path: name, spec: s, get: sub})
+			}
+		}
+	}
+	walk(schema, "", func(row reflect.Value) (reflect.Value, bool) { return row, true })
+	return out
+}
+
+// statCanon is the canonical form of a value as a statistics bound (the
+// physical value; byte arrays of any logical type as hex).
+func statCanon(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kString, kJSON:
+		return hex.EncodeToString([]byte(v.String()))
+	}
+	return canonBase(f, v)
+}
+
+// statLess orders values as the parquet column order of the type does;
+// NaN never takes part, -0 sorts before +0.
+func statLess(f fieldSpec, a, b reflect.Value) bool {
+	switch f.kind {
+	case kBool:
+		return !a.Bool() && b.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return a.Int() < b.Int()
+	case kUint8, kUint16, kUint32, kUint64:
+		return a.Uint() < b.Uint()
+	case kFloat, kDouble:
+		x, y := a.Float(), b.Float()
+		if x == 0 && y == 0 {
+			return math.Signbit(x) && !math.Signbit(y)
+		}
+		return x < y
+	case kString, kJSON, kEnum:
+		return a.String() < b.String()
+	case kBytes:
+		return bytes.Compare(a.Bytes(), b.Bytes()) < 0
+	case kFixed, kUUID:
+		return bytes.Compare(arrayBytes(a), arrayBytes(b)) < 0
+	case kDecFixed:
+		return twosComplement(arrayBytes(a)).Cmp(twosComplement(arrayBytes(b))) < 0
+	}
+	panic("unknown kind")
+}
+
+func isNaN(f fieldSpec, v reflect.Value) bool {
+	return (f.kind == kFloat || f.kind == kDouble) && math.IsNaN(v.Float())
+}
+
+// ---------------------------------------------------------------------------
+// Writer options.
+
+type fileOptions struct {
+	comp           string
+	pageVersion    int
+	pageBuffer     int
+	writeBuffer    int
+	pageStats      bool
+	maxRows        int64
+	keyValue       map[string]string
+	bloom          string // path of a flat leaf with a bloom filter
+	dictMaxBytes   int64
+	skipPageBounds string
+}
+
+func genFileOptions(tc hegel.TestCase, leaves []flatLeaf) fileOptions {
+	o := fileOptions{
+		comp:        pick(tc, "", "", "snappy", "gzip", "zstd", "lz4", "brotli", "uncompressed"),
+		pageVersion: pick(tc, 1, 2, 2),
+		pageBuffer:  pick(tc, 0, 0, 128, 1024, 4096),
+		writeBuffer: pick(tc, 0, 0, 64, 1024),
+		pageStats:   chance(tc, 50),
+	}
+	if chance(tc, 40) {
+		o.maxRows = int64(n(tc, 1, 7))
+	}
+	if chance(tc, 30) {
+		o.keyValue = map[string]string{"k" + strconv.Itoa(n(tc, 0, 9)): genString(tc)}
+	}
+	if len(leaves) > 0 && chance(tc, 30) {
+		o.bloom = leaves[n(tc, 0, len(leaves)-1)].path
+	}
+	if chance(tc, 20) {
+		o.dictMaxBytes = int64(pick(tc, 1, 64, 4096))
+	}
+	return o
+}
+
+func codecOf(name string) parquet.WriterOption {
+	switch name {
+	case "snappy":
+		return parquet.Compression(&parquet.Snappy)
+	case "gzip":
+		return parquet.Compression(&parquet.Gzip)
+	case "zstd":
+		return parquet.Compression(&parquet.Zstd)
+	case "lz4":
+		return parquet.Compression(&parquet.Lz4Raw)
+	case "brotli":
+		return parquet.Compression(&parquet.Brotli)
+	case "uncompressed":
+		return parquet.Compression(&parquet.Uncompressed)
+	}
+	return nil
+}
+
+// compressionName is the name pyarrow reports for a codec tag.
+func compressionName(tag string) string {
+	switch tag {
+	case "snappy":
+		return "SNAPPY"
+	case "gzip":
+		return "GZIP"
+	case "zstd":
+		return "ZSTD"
+	case "lz4":
+		return "LZ4" // pyarrow's name for LZ4_RAW (its LZ4_HADOOP is the deprecated codec)
+	case "brotli":
+		return "BROTLI"
+	case "uncompressed", "":
+		return "UNCOMPRESSED"
+	}
+	return "?"
+}
+
+func (o fileOptions) writerOptions(schema *parquet.Schema) []parquet.WriterOption {
+	opts := []parquet.WriterOption{schema, parquet.DataPageVersion(o.pageVersion), parquet.DataPageStatistics(o.pageStats)}
+	if c := codecOf(o.comp); c != nil {
+		opts = append(opts, c)
+	}
+	if o.pageBuffer > 0 {
+		opts = append(opts, parquet.PageBufferSize(o.pageBuffer))
+	}
+	if o.writeBuffer > 0 {
+		opts = append(opts, parquet.WriteBufferSize(o.writeBuffer))
+	}
+	if o.maxRows > 0 {
+		opts = append(opts, parquet.MaxRowsPerRowGroup(o.maxRows))
+	}
+	for k, v := range o.keyValue {
+		opts = append(opts, parquet.KeyValueMetadata(k, v))
+	}
+	if o.bloom != "" {
+		opts = append(opts, parquet.BloomFilters(parquet.SplitBlockFilter(10, strings.Split(o.bloom, ".")...)))
+	}
+	if o.dictMaxBytes > 0 {
+		opts = append(opts, parquet.DictionaryMaxBytes(o.dictMaxBytes))
+	}
+	return opts
+}
+
+func (o fileOptions) String() string {
+	return fmt.Sprintf("comp=%q v%d pagebuf=%d writebuf=%d pagestats=%v maxrows=%d kv=%v bloom=%q dictmax=%d", o.comp, o.pageVersion, o.pageBuffer, o.writeBuffer, o.pageStats, o.maxRows, o.keyValue, o.bloom, o.dictMaxBytes)
+}
