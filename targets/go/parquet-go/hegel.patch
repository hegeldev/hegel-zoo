+// flatKinds are the scalar kinds that need no parameters (length, precision).
+var flatKinds = []kind{kBool, kInt8, kInt16, kInt32, kInt64, kUint8, kUint16, kUint32, kUint64, kFloat, kDouble, kString, kBytes, kDate, kTsMs, kTsUs}
+
+// indexlessCase: a file whose first column is a float holding NaN in every
+// row (so that pyarrow writes no column index for it, parquet-go/15's
+// shape; finite values under HEGEL_NO_KNOWN=1), followed by one to three
+// flat columns, with statistics and the page index on.
+type indexlessCase struct {
+	pyCase
+}
+
+var (
+	flatColumns = hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		return fieldSpec{kind: hegel.Draw(tc, hegel.SampledFrom(flatKinds)), optional: hegel.Draw(tc, chance(50))}
+	})
+	indexlessSchemas = hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		fields := append([]fieldSpec{{kind: hegel.Draw(tc, pick(kFloat, kDouble))}}, hegel.Draw(tc, listsOf(flatColumns, hegel.Integers(1, 3)))...)
+		return fieldSpec{name: "root", kind: kGroup, fields: named(fields, []string{"f", "c", "c", "c"})}
+	})
+	indexlessOptionGens = func() pyOptionGens {
+		g := defaultPyOptionGens
+		g.statistics, g.pageIndex = hegel.Just(true), hegel.Just(true)
+		return g
+	}()
+	// firstValues: the first column's value, NaN or finite.
+	nanValues      = asValue(hegel.Map(hegel.Just(0), func(int) float64 { return math.NaN() }))
+	firstValues    = shaped(nanValues, asValue(eighths))
+	indexlessCase_ = hegel.FlatMap(indexlessSchemas, func(root fieldSpec) hegel.Generator[pyCase] {
+		return hegel.FlatMap(pyOptionsOf(indexlessOptionGens), func(o pyOptions) hegel.Generator[pyCase] {
+			spec := pyarrowSpec(root, o)
+			first := hegel.Map(firstValues, func(v reflect.Value) reflect.Value { return v.Convert(baseType(spec.fields[0])) })
+			rows := listsOf(groupOf(spec, map[int]hegel.Generator[reflect.Value]{0: first}), hegel.Integers(1, 12))
+			return hegel.Map(rows, func(rows []reflect.Value) pyCase { return pyCase{o: o, spec: spec, rows: rows} })
+		})
+	})
+	indexlessCases = hegel.Map(indexlessCase_, func(c pyCase) indexlessCase { return indexlessCase{c} })
+)
