+// parquet-go/4: floating-point column statistics deviate from the rules of
+// the format's TypeDefinedOrder (parquet.thrift): a zero minimum should be
+// written as -0.0 and a zero maximum as +0.0, but parquet-go keeps the zero
+// it met first ({+0, -0}: min +0; {-0, +0}: max -0); and when every value
+// is NaN, min and max must not be written, but parquet-go writes NaN.
+func TestHegelPinFloatStatisticsFollowTheSpec(t *testing.T) {
+	type F struct {
+		A float64 `parquet:"a"`
+	}
+	minMax := func(rows []F) (minBits, maxBits uint64, has bool) {
+		var buf bytes.Buffer
+		if err := parquet.Write[F](&buf, rows); err != nil {
+			t.Fatal(err)
+		}
+		f, err := parquet.OpenFile(bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		st := f.Metadata().RowGroups[0].Columns[0].MetaData.Statistics
+		if len(st.MinValue) != 8 || len(st.MaxValue) != 8 {
+			return 0, 0, false
+		}
+		return binary.LittleEndian.Uint64(st.MinValue), binary.LittleEndian.Uint64(st.MaxValue), true
+	}
+	negZero := math.Float64bits(math.Copysign(0, -1))
+	if mn, mx, has := minMax([]F{{0}, {math.Copysign(0, -1)}}); !has || mn != negZero || mx != 0 {
+		t.Errorf("values {+0, -0}: min %x max %x (has %v), want min -0.0 (%x) and max +0.0 (0)", mn, mx, has, negZero)
+	}
+	if mn, mx, has := minMax([]F{{math.Copysign(0, -1)}, {0}}); !has || mn != negZero || mx != 0 {
+		t.Errorf("values {-0, +0}: min %x max %x (has %v), want min -0.0 (%x) and max +0.0 (0)", mn, mx, has, negZero)
+	}
+	if mn, mx, has := minMax([]F{{math.NaN()}, {math.NaN()}}); has {
+		t.Errorf("values {NaN, NaN}: min %x max %x written, want no min/max", mn, mx)
+	}
+}
