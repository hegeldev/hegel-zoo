+package hegel
+
+// Hegel property tests for parquet-go. Files parquet-go writes for generated
+// schemas and rows (through GenericWriter[any] on reflect-built struct
+// types) are read back by pyarrow - a child process speaking one JSON line
+// each way, oracle.py - and by parquet-go itself, and compared with the rows
+// in a canonical form both sides produce; the column chunk statistics,
+// encodings and compression pyarrow reports are compared with what the rows
+// and the options say they must be.
+//
+// Needs python3 with pyarrow.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+// curDesc describes the case under test, for panic reports.
+var curDesc string
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("%s: panic in the code under test: %v", curDesc, r))
+				collectedMu.Unlock()
+				return
+			}
+			fail(ht, "%s: panic in the code under test: %v", curDesc, r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// The oracle: pyarrow in a child process, one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	cmd.Env = append(os.Environ(), "PYTHONDONTWRITEBYTECODE=1") // no __pycache__ in the tree the patch is saved from
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one JSON request and returns the answer object.
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %.200q: %v", o.name, resp, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		return nil, fmt.Errorf("%s oracle failed on %v: %v", o.name, req, e)
+	}
+	return m, nil
+}
+
+var (
+	pyOnce sync.Once
+	py     *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("pyarrow", "python3", "-u", "oracle.py") })
+	return py
+}
+
+// pyColumn is a column chunk as pyarrow reports it.
+type pyColumn struct {
+	path                                     string
+	physical, compression                    string
+	encodings                                []string
+	numValues                                int64
+	hasNullCount                             bool
+	nullCount                                int64
+	hasMinMax                                bool
+	min, max                                 any
+	dictionaryPage, columnIndex, offsetIndex bool
+}
+
+type pyRowGroup struct {
+	numRows int64
+	columns []pyColumn
+}
+
+// pyFile is pyarrow's reading of a parquet file.
+type pyFile struct {
+	ok           bool
+	err          string
+	rows         []any // canonical rows: map[string]any each
+	numRows      int64
+	numRowGroups int
+	createdBy    string
+	format       string
+	schema       string
+	keyValue     map[string]string
+	rowGroups    []pyRowGroup
+}
+
+func str(v any) string {
+	s, _ := v.(string)
+	return s
+}
+
+func num(v any) int64 {
+	f, _ := v.(float64)
+	return int64(f)
+}
+
+func boolean(v any) bool {
+	b, _ := v.(bool)
+	return b
+}
+
+func pythonRead(t testing.TB, path string) pyFile {
+	m, err := pyOracle().call(map[string]any{"op": "read", "path": path})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	f := pyFile{ok: boolean(m["ok"])}
+	if !f.ok {
+		f.err = str(m["reason"])
+		return f
+	}
+	f.rows, _ = m["rows"].([]any)
+	f.numRows = num(m["num_rows"])
+	f.numRowGroups = int(num(m["num_row_groups"]))
+	f.createdBy = str(m["created_by"])
+	f.format = str(m["format_version"])
+	f.schema = str(m["schema"])
+	f.keyValue = map[string]string{}
+	if kv, ok := m["key_value"].(map[string]any); ok {
+		for k, v := range kv {
+			f.keyValue[k] = str(v)
+		}
+	}
+	groups, _ := m["row_groups"].([]any)
+	for _, g := range groups {
+		gm, _ := g.(map[string]any)
+		rg := pyRowGroup{numRows: num(gm["num_rows"])}
+		cols, _ := gm["columns"].([]any)
+		for _, c := range cols {
+			cm, _ := c.(map[string]any)
+			col := pyColumn{
+				path:           str(cm["path"]),
+				physical:       str(cm["physical"]),
+				compression:    str(cm["compression"]),
+				numValues:      num(cm["num_values"]),
+				hasMinMax:      boolean(cm["has_min_max"]),
+				min:            cm["min"],
+				max:            cm["max"],
+				dictionaryPage: boolean(cm["dictionary_page"]),
+				columnIndex:    boolean(cm["column_index"]),
+				offsetIndex:    boolean(cm["offset_index"]),
+			}
+			if cm["null_count"] != nil {
+				col.hasNullCount, col.nullCount = true, num(cm["null_count"])
+			}
+			encs, _ := cm["encodings"].([]any)
+			for _, e := range encs {
+				col.encodings = append(col.encodings, str(e))
+			}
+			rg.columns = append(rg.columns, col)
+		}
+		f.rowGroups = append(f.rowGroups, rg)
+	}
+	return f
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..a0c1468
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,71 @@
+package hegel
+
+import "strings"
+
+// Known bugs of parquet-go at the pinned commit, gated so the properties
+// stay green while they are open. Each rule names the zoo's bug id; the
+// pins in hegel_pins_test.go fail while the bug is open.
+
+// caseInfo describes a failing case for the gates.
+type caseInfo struct {
+	prop      string    // which property
+	spec      fieldSpec // the schema
+	want, got any       // canonical rows
+	panic     string    // the panic's message
+	stage     string    // damaged files: "open" (OpenFile) or "read"
+}
+
+// known returns the id of the bug that explains the case, or "".
+func known(c caseInfo) string {
+	switch {
+	case c.prop == "writer" && hasOptionalListElement(c.spec):
+		// parquet-go/1: Schema.Deconstruct, and so the deprecated Writer,
+		// mishandles optional LIST elements: pointer elements panic,
+		// non-pointer optional elements are written as nulls.
+		return "parquet-go/1"
+	case c.prop == "damaged" && c.stage == "open" && (strings.Contains(c.panic, "makeslice: len out of range") || strings.Contains(c.panic, "slice bounds out of range")):
+		// parquet-go/8: damaged (negative) column or offset index lengths in
+		// the footer make OpenFile panic in ReadPageIndex.
+		return "parquet-go/8"
+	case c.prop == "damaged" && strings.Contains(c.panic, "is not assignable to type"):
+		// parquet-go/5: a value assigned to a [N]byte field it does not fit
+		// (here because damage renamed the column, so the reader fills it
+		// with nulls) panics in reflect.Set instead of returning an error.
+		return "parquet-go/5"
+	case c.prop == "damaged" && strings.Contains(c.panic, "slice bounds out of range"):
+		// parquet-go/6: a damaged v2 data page header whose level lengths
+		// exceed the page makes decodeLevelsV2 panic.
+		return "parquet-go/6"
+	}
+	return ""
+}
+
+// hasOptionalListElement reports a LIST with optional (pointer) elements
+// anywhere in the schema.
+func hasOptionalListElement(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.rep == "list" && s.elemOptional {
+			return true
+		}
+		if s.kind == kGroup && hasOptionalListElement(s) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasDictBool reports a dictionary-encoded boolean leaf anywhere in the
+// schema: the format allows the encoding for every physical type, but
+// parquet-cpp (pyarrow) refuses to read it ("Dictionary encoding not
+// implemented for boolean type"), so such files are counted, not compared.
+func hasDictBool(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.kind == kBool && s.enc == "dict" {
+			return true
+		}
+		if s.kind == kGroup && hasDictBool(s) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..a987ee0
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""pyarrow oracle for the parquet-go hegel tests: one JSON object per line in, one per line out.
+
+  {"op": "read", "path": str}
+      -> {"ok": false, "reason": "..."} when pyarrow cannot read the file, else
+         {"ok": true, "rows": [...], "num_rows": int, "num_row_groups": int, "created_by": str,
+          "format_version": str, "schema": str, "key_value": {str: str},
+          "row_groups": [{"num_rows": int, "columns": [{"path": str, "physical": str,
+              "encodings": [str], "compression": str, "num_values": int,
+              "null_count": int|null, "has_min_max": bool, "min": canon|null, "max": canon|null,
+              "dictionary_page": bool, "column_index": bool, "offset_index": bool}]}]}
+
+Rows are in a canonical form shared with the Go side: null -> null, booleans -> bool,
+integers (and dates, times and timestamps as their integer representation, and the unscaled
+value of decimals) -> decimal string, float32 -> "f32:" + 8 hex digits of the bits,
+float64 -> "f64:" + 16 hex digits, strings -> the string, binary (and enums, fixed-length
+byte arrays and UUIDs) -> lowercase hex, lists -> arrays, maps -> arrays of [key, value]
+sorted by key, groups -> objects keyed by field name. Statistics minima and maxima use the
+same encoding of the physical value, with byte arrays of every logical type as hex.
+"""
+import json
+import struct
+import sys
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pyarrow.parquet as pq
+
+
+def canon(arr):
+    """Canonical values (a Python list, one entry per element) of an Arrow array."""
+    if isinstance(arr, pa.ChunkedArray):
+        arr = arr.combine_chunks()
+    if isinstance(arr.type, pa.BaseExtensionType):  # arrow.uuid, arrow.json
+        arr = arr.storage
+    t = arr.type
+    n = len(arr)
+    valid = arr.is_valid().to_pylist()
+    if pa.types.is_null(t):
+        return [None] * n
+    if pa.types.is_list(t) or pa.types.is_large_list(t):
+        offs = arr.offsets.to_pylist()
+        vals = canon(arr.values)
+        return [vals[offs[i]:offs[i + 1]] if valid[i] else None for i in range(n)]
+    if pa.types.is_map(t):
+        offs = arr.offsets.to_pylist()
+        keys = canon(arr.keys)
+        items = canon(arr.items)
+        out = []
+        for i in range(n):
+            if not valid[i]:
+                out.append(None)
+                continue
+            pairs = [[keys[j], items[j]] for j in range(offs[i], offs[i + 1])]
+            pairs.sort(key=lambda p: p[0])  # by code point, as Go compares UTF-8 bytes
+            out.append(pairs)
+        return out
+    if pa.types.is_struct(t):
+        cols = [(t.field(i).name, canon(arr.field(i))) for i in range(t.num_fields)]
+        return [{name: col[i] for name, col in cols} if valid[i] else None for i in range(n)]
+    if pa.types.is_boolean(t):
+        return arr.to_pylist()
+    if pa.types.is_integer(t):
+        return [None if x is None else str(x) for x in arr.to_pylist()]
+    if pa.types.is_float32(t):
+        bits = arr.view(pa.uint32()).to_pylist()
+        return ["f32:%08x" % bits[i] if valid[i] else None for i in range(n)]
+    if pa.types.is_float64(t):
+        bits = arr.view(pa.uint64()).to_pylist()
+        return ["f64:%016x" % bits[i] if valid[i] else None for i in range(n)]
+    if pa.types.is_string(t) or pa.types.is_large_string(t):
+        return arr.to_pylist()
+    if pa.types.is_binary(t) or pa.types.is_large_binary(t) or pa.types.is_fixed_size_binary(t):
+        return [None if x is None else x.hex() for x in arr.to_pylist()]
+    if pa.types.is_decimal(t):
+        return [None if d is None else unscaled(d, t.scale) for d in arr.to_pylist()]
+    if pa.types.is_date32(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int32()).to_pylist()]
+    if pa.types.is_date64(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int64()).to_pylist()]
+    if pa.types.is_time32(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int32()).to_pylist()]
+    if pa.types.is_time64(t) or pa.types.is_timestamp(t) or pa.types.is_duration(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int64()).to_pylist()]
+    raise ValueError("oracle: unsupported Arrow type %s" % t)
+
+
+def unscaled(d, scale):
+    """The unscaled integer of a Decimal at the given scale, exactly (the default decimal
+    context would round at 28 digits)."""
+    sign, digits, exponent = d.as_tuple()
+    v = int("".join(map(str, digits)) or "0") * 10 ** (exponent + scale)
+    return str(-v if sign else v)
+
+
+def canon_stat(stats, which):
+    """Canonical form of a statistics bound (physical value)."""
+    raw = stats.min_raw if which == "min" else stats.max_raw
+    phys = stats.physical_type
+    lt = str(stats.logical_type)
+    if phys == "BOOLEAN":
+        return bool(raw)
+    if phys in ("INT32", "INT64"):
+        if lt.startswith("Int(") and "isSigned=false" in lt:
+            return str(stats.min if which == "min" else stats.max)
+        return str(raw)
+    if phys == "FLOAT":
+        return "f32:" + struct.pack(">f", raw).hex()
+    if phys == "DOUBLE":
+        return "f64:" + struct.pack(">d", raw).hex()
+    if phys in ("BYTE_ARRAY", "FIXED_LEN_BYTE_ARRAY"):
+        if lt.startswith("Decimal"):
+            return str(int.from_bytes(raw, "big", signed=True))
+        return raw.hex()
+    if phys == "INT96":
+        return raw.hex() if isinstance(raw, bytes) else str(raw)
+    return str(raw)
+
+
+def read(path):
+    try:
+        f = pq.ParquetFile(path)
+        table = f.read()
+        cols = [canon(table.column(i)) for i in range(table.num_columns)]
+        names = table.column_names
+        rows = [{names[c]: cols[c][r] for c in range(len(names))} for r in range(table.num_rows)]
+        md = f.metadata
+        groups = []
+        for g in range(md.num_row_groups):
+            rg = md.row_group(g)
+            columns = []
+            for c in range(rg.num_columns):
+                cc = rg.column(c)
+                st = cc.statistics if cc.is_stats_set else None
+                col = {
+                    "path": cc.path_in_schema,
+                    "physical": str(cc.physical_type),
+                    "encodings": [str(e) for e in cc.encodings],
+                    "compression": str(cc.compression),
+                    "num_values": cc.num_values,
+                    "null_count": (st.null_count if st is not None and st.has_null_count else None),
+                    "has_min_max": bool(st is not None and st.has_min_max),
+                    "min": None,
+                    "max": None,
+                    "dictionary_page": cc.has_dictionary_page,
+                    "column_index": cc.has_column_index,
+                    "offset_index": cc.has_offset_index,
+                }
+                if st is not None and st.has_min_max:
+                    col["min"] = canon_stat(st, "min")
+                    col["max"] = canon_stat(st, "max")
+                columns.append(col)
+            groups.append({"num_rows": rg.num_rows, "columns": columns})
+        kv = {}
+        if md.metadata:
+            for k, v in md.metadata.items():
+                if k != b"ARROW:schema":
+                    kv[k.decode("utf-8", "replace")] = v.decode("utf-8", "replace")
+        return {
+            "ok": True,
+            "rows": rows,
+            "num_rows": md.num_rows,
+            "num_row_groups": md.num_row_groups,
+            "created_by": md.created_by,
+            "format_version": md.format_version,
+            "schema": str(f.schema_arrow),
+            "key_value": kv,
+            "row_groups": groups,
+        }
+    except (pa.ArrowException, ValueError, OSError, UnicodeDecodeError) as e:  # noqa: PERF203
+        return {"ok": False, "reason": "%s: %s" % (type(e).__name__, e)}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        req = json.loads(line)
+        try:
+            if req["op"] == "read":
+                out = read(req["path"])
+            else:
+                out = {"error": "oracle: unknown op"}
+        except Exception as e:  # noqa: BLE001
+            out = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
