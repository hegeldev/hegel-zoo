+// on silently, and the reflection readers (parquet.Read, GenericReader,
+// Reader) panic on it in Value.byteArray ("unsafe.Slice: ptr is nil and len
+// is not zero") through stringType.AssignValue instead of returning an error.
+func TestHegelPinDamagedByteArrayPageErrorsNotPanics(t *testing.T) {
+	type Inner struct {
+		Val0 *int16           `parquet:"Val0,dict"`
+		Col1 map[string]int32 `parquet:"col1"`
+		Col2 map[string]bool  `parquet:"col2"`
+	}
+	type Outer struct {
+		F0 []*Inner `parquet:"f_0,list"`
+	}
+	type R struct {
+		Val0 []uint32         `parquet:"Val0,dict"`
+		C1   []float64        `parquet:"c1,lz4"`
+		X2   *int64           `parquet:"x2,timestamp(nanosecond:utc),plain"`
+		Col3 map[string]int64 `parquet:"col3"`
+		Col4 *Outer           `parquet:"col4"`
+	}
+	data, err := base64.StdEncoding.DecodeString(damagedByteArrayPage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data))); err != nil {
+		t.Skipf("OpenFile rejects the file (fine): %v", err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("reading the damaged file into a struct panics: %v", r)
+		}
+	}()
+	rows, err := parquet.Read[R](bytes.NewReader(data), int64(len(data)))
+	t.Logf("Read[R]: %d rows, %v (an error is fine)", len(rows), err)
+}
+
+// parquet-go/17: OpenFile allocates a buffer of the footer length the
+// trailer claims (4 bytes before the magic number) before checking it
+// against the file's size, and the page index buffers of the lengths the
+// footer claims likewise: one damaged byte makes it allocate up to 4 GB for
+// a file of a few hundred bytes, and when the allocation fails the Go
+// runtime aborts the process, where OpenFile should return an error.
+func TestHegelPinOpenFileChecksTheFooterLength(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	var buf bytes.Buffer
+	if err := parquet.Write[smallRow](&buf, []smallRow{{1, "x"}, {2, "y"}}); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.Bytes()
+	claim := func(size uint32) []byte {
+		out := append([]byte(nil), data...)
+		binary.LittleEndian.PutUint32(out[len(out)-8:], size)
+		return out
+	}
+	// A claim this process can afford, measured here.
+	if _, alloc, res := openOutcome(claim(64 << 20)); alloc > openFileAllowance(len(data)) {
+		t.Errorf("OpenFile of a %d-byte file whose trailer claims a 64 MiB footer allocates %d bytes (and returns %s); the claim should be rejected first", len(data), alloc, res)
+	}
+	// One it cannot, in a child process with a capped address space.
+	name := t.Name()
+	checkOpenFileChild(t, name)
+	if c := openFileInChild(name, claim(0x7f0000a0)); c.alloc > openFileAllowance(len(data)) || c.open == childDies {
+		t.Errorf("OpenFile of a %d-byte file whose trailer claims a 2 GB footer %s", len(data), openFileVerdict(c.alloc, c.open))
+	}
+}
+
+// parquet-go/18: compress/lz4's Decode doubles its output buffer on every
+// error from lz4.UncompressBlock, taking each for a short buffer, so a
+// corrupt LZ4_RAW page (three bytes of garbage suffice) makes reading its
+// column allocate 9, 18, 36, ... bytes up to gigabytes, until an allocation
+// fails and the Go runtime aborts the process; the codec should return the
+// decoder's error. The zoo met it reading the rows of a damaged file.
+func TestHegelPinDamagedLZ4PageReturnsAnError(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	checkOpenFileChild(t, name)
+	if res := lz4DecodeInChild(name, []byte{0xff, 0xff, 0xff}); res != "ok" && !strings.HasPrefix(res, "error:") {
+		t.Errorf("Lz4Raw.Decode of the corrupt block ff ff ff %s", res)
+	}
+}
+
+// parquet-go/19: a leaf schema element (a physical type, no children) whose
+// logical type annotation is MAP or LIST gets a group Type from OpenFile
+// (schemaElementTypeOf in column.go returns mapType or listType for the
+// annotation whatever the element is), and that Type's Kind panics ("cannot
+// call Kind on parquet MAP type"): OpenFile itself when the file has rows
+// (FileRowGroup.init), and Schema.String, EqualNodes and so Reader.Read into
+// a struct (updateReadSchema) when it has none, where OpenFile should reject
+// the element or the readers return an error. The zoo met it reading a
+// damaged empty file whose INT32 leaf had its logical type changed to MAP.
+func TestHegelPinLeafAnnotatedMapErrorsNotPanics(t *testing.T) {
+	var buf bytes.Buffer
+	if err := parquet.Write[smallRow](&buf, []smallRow{{1, "x"}, {2, "y"}}); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		name string
+		lt   format.LogicalTypeValue
+	}{{"MAP", &format.MapType{}}, {"LIST", &format.ListType{}}} {
+		data, err := withLogicalType(buf.Bytes(), 1, &format.LogicalType{Value: c.lt})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if res := openAndReadOutcome(data); strings.Contains(res, "panics") {
+			t.Errorf("with the INT32 leaf a annotated %s, %s", c.name, res)
+		} else {
+			t.Logf("with the INT32 leaf a annotated %s: %s (fine)", c.name, res)
+		}
+	}
+}
+
+// parquet-go/20: a data page v2 header whose num_nulls exceeds its num_values
+// makes reading the page panic ("number of values out of range: -1 not in
+// [0:2147483647]": the makeNumValues check of limits.go on the difference of
+// the two counts, reached from Column.decodeDataPageV2 through decodeDataPage
+// and Type.NewPage) instead of returning an error, so the row API
+// (RowGroup.Rows().ReadRows) and every reader on top of it crash on the file.
+// The zoo met it reading a damaged file (an optional BOOLEAN column whose
+// page counted 1 value and 2 nulls).
+func TestHegelPinNullsBeyondValuesErrorsNotPanics(t *testing.T) {
+	yes := true
+	var buf bytes.Buffer
+	if err := parquet.Write[optionalRow](&buf, []optionalRow{{B: &yes}}, parquet.DataPageVersion(2)); err != nil {
+		t.Fatal(err)
+	}
+	data, err := withPageCounts(buf.Bytes(), 0, func(h *format.PageHeader) { h.DataPageHeaderV2.V.NumNulls = 2 })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res := openAndReadOutcome(data); strings.Contains(res, "panics") {
+		t.Errorf("with column b's data page v2 (1 value) counting 2 nulls, %s", res)
+	} else {
+		t.Logf("with column b's data page v2 (1 value) counting 2 nulls: %s (fine)", res)
+	}
+}
+
+// parquet-go/14: an LZ4_RAW page whose compressed size is more than a third
+// of its uncompressed size (data that compresses poorly) is decoded from a
+// stale buffer: Column.decompress hands the LZ4 codec a pooled buffer of the
+// uncompressed size, the codec reserves 3x the compressed size and so
+// allocates a new one when the pooled one is smaller, and decompress keeps
+// the pooled buffer (never written) whenever the decoded length equals the
+// header's. The page's bytes are then whatever the buffer held before.
+func TestHegelPinLZ4RawPagesDecompress(t *testing.T) {
+	type R struct {
+		B []byte `parquet:"b"`
+	}
+	rnd := rand.New(rand.NewSource(14))
+	b := make([]byte, 2<<20) // 2 MiB of noise: LZ4 cannot shrink it, and no pooled buffer is 6 MiB
+	rnd.Read(b)
+	var buf bytes.Buffer
+	if err := parquet.Write[R](&buf, []R{{B: b}}, parquet.Compression(&parquet.Lz4Raw)); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := parquet.Read[R](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Fatalf("reading back an LZ4_RAW page of incompressible bytes: %v", err)
+	}
+	if len(rows) != 1 || !bytes.Equal(rows[0].B, b) {
+		t.Errorf("the value read back differs from the 2 MiB written (%d rows, %d bytes)", len(rows), len(rows[0].B))
+	}
+}
