+// smallRow is the row of the small files of the OpenFile tests.
+type smallRow struct {
+	A int32  `parquet:"a"`
+	B string `parquet:"b"`
+}
+
+// smallRows: one to three small rows.
+var smallRows = listsOf(hegel.Composite(func(tc hegel.TestCase) smallRow {
+	return smallRow{hegel.Draw(tc, hegel.Integers(int32(-1000), 1000)), hegel.Draw(tc, texts)}
+}), hegel.Integers(1, 3))
+
+// writeSmall writes the small rows to a file.
+func writeSmall(ht *hegel.T, rows []smallRow, opts ...parquet.WriterOption) []byte {
+	var buf bytes.Buffer
+	if err := parquet.Write[smallRow](&buf, rows, opts...); err != nil {
+		ht.Fatalf("%v", err)
+	}
+	return buf.Bytes()
+}
+
+// footerClaimCase: a small file and the footer length its trailer will
+// claim, drawn as a number mapped into the range past the file
+// (parquet-go/17's shape) or, under HEGEL_NO_KNOWN=1, within it.
+type footerClaimCase struct {
+	rows  []smallRow
+	claim int
+}
+
+var footerClaimCases = hegel.Composite(func(tc hegel.TestCase) footerClaimCase {
+	return footerClaimCase{rows: hegel.Draw(tc, smallRows), claim: hegel.Draw(tc, hegel.Integers(0, 1<<32-1))}
+})
+
+// claimed is the footer length claimed for a file of size bytes: one past
+// the file (size-7 to 2^32-1), or within it (0 to size-8).
+func (c footerClaimCase) claimed(size int) int {
+	if noKnown {
+		return c.claim % (size - 7)
+	}
+	return size - 7 + c.claim%(1<<32-(size-7))
+}
+
+// TestHegelOpenFileChecksTheFooterLength: OpenFile allocates no more than
+// the file holds whatever footer length its trailer claims; a claim longer
+// than the file is an error, not a buffer of that length (parquet-go/17).
+// Under HEGEL_NO_KNOWN=1 the claims stay within the file.
+func TestHegelOpenFileChecksTheFooterLength(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	checkOpenFileChild(t, name)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, footerClaimCases)
+		data := writeSmall(ht, c.rows)
+		claim := c.claimed(len(data))
+		binary.LittleEndian.PutUint32(data[len(data)-8:], uint32(claim))
+		curDesc = fmt.Sprintf("a %d-byte file whose trailer claims a %d-byte footer", len(data), claim)
+		var alloc int64
+		var res string
+		if int64(claim) > openFileInProcess {
+			child := openFileInChild(name, data)
+			alloc, res = child.alloc, child.open
+		} else {
+			_, alloc, res = openOutcome(data)
+		}
+		if strings.HasPrefix(res, "child:") {
+			ht.Fatalf("%s: %s", curDesc, res)
+		}
+		if alloc > openFileAllowance(len(data)) || res == childDies || strings.HasPrefix(res, "panic:") {
+			mismatch(ht, "parquet-go/17", "%s: OpenFile %s", curDesc, openFileVerdict(alloc, res))
+		}
+	})
+}
+
+// blockDamage is what happens to an LZ4 block: nothing, garbage bytes in
+// its place, or a bit flipped (the position modulo its length).
+type blockDamage struct {
+	kind  string
+	bytes []byte
+	at    int
+	bit   int
+}
+
+func (d blockDamage) GoString() string {
+	switch d.kind {
+	case "garbage":
+		return fmt.Sprintf("garbage %x", d.bytes)
+	case "flip":
+		return fmt.Sprintf("flip bit %d at %d", d.bit, d.at)
+	}
+	return d.kind
+}
+
+// lz4BlockCase: the bytes a block is encoded from and its damage.
+type lz4BlockCase struct {
+	payload []byte
+	damage  blockDamage
+}
+
+var (
+	blockDamages = shaped(weighted(
+		choice[blockDamage]{1, hegel.Map(listsOf(byteValues, hegel.Integers(1, 16)), func(b []byte) blockDamage { return blockDamage{kind: "garbage", bytes: b} })},
+		choice[blockDamage]{1, hegel.Composite(func(tc hegel.TestCase) blockDamage {
+			return blockDamage{kind: "flip", at: hegel.Draw(tc, positions), bit: hegel.Draw(tc, hegel.Integers(0, 7))}
+		})},
+	), hegel.Just(blockDamage{kind: "sound"}))
+	lz4BlockCases = hegel.Composite(func(tc hegel.TestCase) lz4BlockCase {
+		return lz4BlockCase{payload: hegel.Draw(tc, listsOf(byteValues, hegel.Integers(1, 64))), damage: hegel.Draw(tc, blockDamages)}
+	})
+)
+
+// block is the damaged LZ4 block of the case.
+func (c lz4BlockCase) block(ht *hegel.T) []byte {
+	block, err := parquet.Lz4Raw.Encode(nil, c.payload)
+	if err != nil {
+		ht.Fatalf("%v", err)
+	}
+	switch c.damage.kind {
+	case "garbage":
+		return c.damage.bytes
+	case "flip":
+		block[c.damage.at%len(block)] ^= byte(1 << c.damage.bit)
+	}
+	return block
+}
+
+// TestHegelDamagedLZ4PagesReturnAnError: Lz4Raw.Decode of a damaged block
+// (a compressed block with a bit flipped, or bytes that never were one)
+// returns an error, instead of doubling its buffer without end until the
+// process dies (parquet-go/18). Under HEGEL_NO_KNOWN=1 the blocks are sound.
+func TestHegelDamagedLZ4PagesReturnAnError(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	checkOpenFileChild(t, name)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lz4BlockCases)
+		block := c.block(ht)
+		curDesc = fmt.Sprintf("the LZ4 block %x (%#v)", block, c.damage)
+		res := lz4DecodeInChild(name, block)
+		if strings.HasPrefix(res, "child:") {
+			ht.Fatalf("%s: %s", curDesc, res)
+		}
+		if res == childDies || strings.HasPrefix(res, "panic:") {
+			mismatch(ht, "parquet-go/18", "%s: Lz4Raw.Decode %s", curDesc, res)
+		}
+	})
+}
