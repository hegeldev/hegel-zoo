+// ---------------------------------------------------------------------------
+// parquet-go/14: LZ4_RAW pages of incompressible data.
+
+// noiseRow is the row of the files of noise: one byte-array column.
+type noiseRow struct {
+	B []byte `parquet:"b"`
+}
+
+// noiseCase: a file of one to three byte arrays of noise (random bytes
+// from a seed, which LZ4 cannot shrink), compressed with LZ4_RAW (snappy or
+// zstd under HEGEL_NO_KNOWN=1) by one of the two writers.
+type noiseCase struct {
+	seed   int64
+	sizes  []int
+	codec  string
+	writer string
+}
+
+func (c noiseCase) GoString() string {
+	return fmt.Sprintf("%d bytes of noise (seed %d) in %d rows, %s, the %s writer", c.total(), c.seed, len(c.sizes), c.codec, c.writer)
+}
+
+func (c noiseCase) total() int {
+	n := 0
+	for _, s := range c.sizes {
+		n += s
+	}
+	return n
+}
+
+// rows are the case's rows: the noise cut into the sizes.
+func (c noiseCase) rows() []noiseRow {
+	rnd := rand.New(rand.NewSource(c.seed))
+	rows := make([]noiseRow, len(c.sizes))
+	for i, s := range c.sizes {
+		rows[i].B = make([]byte, s)
+		rnd.Read(rows[i].B)
+	}
+	return rows
+}
+
+var noiseCases = hegel.Composite(func(tc hegel.TestCase) noiseCase {
+	return noiseCase{
+		seed:   hegel.Draw(tc, hegel.Integers(int64(0), 1<<31)),
+		sizes:  hegel.Draw(tc, listsOf(hegel.Integers(1<<10, 64<<10), hegel.Integers(1, 3))),
+		codec:  hegel.Draw(tc, shaped(hegel.Just("lz4"), pick("snappy", "zstd"))),
+		writer: hegel.Draw(tc, pick("generic", "deprecated")),
+	}
+})
+
+// noiseDigest is the digest of the rows read back: the length and bytes
+// of every value.
+func noiseDigest(rows []noiseRow) string {
+	h := sha256.New()
+	for _, r := range rows {
+		fmt.Fprintf(h, "%d:", len(r.B))
+		h.Write(r.B)
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// readNoiseOutcome reads the file into noiseRows (the child's side) and
+// describes the outcome: "ok <digest>", "error: ..." or "panic: ...".
+func readNoiseOutcome(path string) (res string) {
+	defer func() {
+		if r := recover(); r != nil {
+			res = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	f, err := parquet.ReadFile[noiseRow](path)
+	if err != nil {
+		return "error: " + err.Error()
+	}
+	return "ok " + noiseDigest(f)
+}
+
+// noiseVerdicts caches the child's verdict per file, so that a case is read
+// once however often Hegel replays it.
+var (
+	noiseVerdicts   = map[[32]byte]string{}
+	noiseVerdictsMu sync.Mutex
+)
+
+// readNoiseInChild reads the file in a child process (a fresh buffer pool:
+// in this process the pages decoded before would hide or show the shape).
+func readNoiseInChild(testName string, data []byte) string {
+	key := sha256.Sum256(data)
+	noiseVerdictsMu.Lock()
+	res, ok := noiseVerdicts[key]
+	noiseVerdictsMu.Unlock()
+	if ok {
+		return res
+	}
+	out, err := inChildFile(testName, noiseFileChildEnv, data)
+	res = childResult(out, err, "ZOO_NOISE result=%q")
+	noiseVerdictsMu.Lock()
+	noiseVerdicts[key] = res
+	noiseVerdictsMu.Unlock()
+	return res
+}
+
+// TestHegelLZ4RawPagesDecompress: parquet-go reads back the LZ4_RAW pages it
+// wrote for data that compresses by less than 3x, with either writer
+// (parquet-go/14). Under HEGEL_NO_KNOWN=1 the pages are snappy or zstd.
+func TestHegelLZ4RawPagesDecompress(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, noiseCases)
+		curDesc = fmt.Sprintf("%#v", c)
+		rows := c.rows()
+		values := make([]reflect.Value, len(rows))
+		for i := range rows {
+			values[i] = reflect.ValueOf(rows[i])
+		}
+		opts := []parquet.WriterOption{parquet.SchemaOf(noiseRow{}), codecOf(c.codec)}
+		var data []byte
+		var err error
+		if c.writer == "generic" {
+			data, err = writeGeneric(values, opts, nil)
+		} else {
+			data, err = writeDeprecated(values, opts)
+		}
+		if err != nil {
+			fail(ht, "%s: writing: %v", curDesc, err)
+		}
+		res := readNoiseInChild(name, data)
+		if strings.HasPrefix(res, "child:") {
+			ht.Fatalf("%s: %s", curDesc, res)
+		}
+		if want := "ok " + noiseDigest(rows); res != want {
+			id := ""
+			if c.codec == "lz4" {
+				id = "parquet-go/14"
+			}
+			mismatch(ht, id, "%s: reading back the %d-byte file gives %s, the rows written digest to %s", curDesc, len(data), res, strings.TrimPrefix(want, "ok "))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// parquet-go/10: decimals converted between physical types.
+
+// decimalCase: a decimal of a precision and scale, stored as INT32 or INT64
+// by the writer and read into a FIXED_LEN_BYTE_ARRAY field (of the length
+// parquet-go gives the precision, pyDecimalSize), or the other way round;
+// under HEGEL_NO_KNOWN=1 read into the physical type written.
+type decimalCase struct {
+	precision, scale int
+	direction        string // "int to fixed", "fixed to int" or "as written"
+	values           []int64
+	fo               fileOptions
+}
+
+func (c decimalCase) GoString() string {
+	return fmt.Sprintf("decimal(%d:%d) values %v, %s (fixed length %d), %s", c.scale, c.precision, c.values, c.direction, c.fixedLen(), c.fo)
+}
+
+func (c decimalCase) fixedLen() int { return pyDecimalSize[c.precision] }
+
+// integerSpec is the decimal as an INT32 (precision up to 9) or INT64 column.
+func (c decimalCase) integerSpec() fieldSpec {
+	k := kDec64
+	if c.precision <= 9 {
+		k = kDec32
+	}
+	return rootOf(fieldSpec{kind: k, precision: c.precision, scale: c.scale})
+}
+
+// fixedSpec is the decimal as a FIXED_LEN_BYTE_ARRAY column.
+func (c decimalCase) fixedSpec() fieldSpec {
+	return rootOf(fieldSpec{kind: kDecFixed, precision: c.precision, scale: c.scale, fixedLen: c.fixedLen()})
+}
+
+// specs are the schema written and the schema read.
+func (c decimalCase) specs() (written, read fieldSpec) {
+	switch c.direction {
+	case "int to fixed":
+		return c.integerSpec(), c.fixedSpec()
+	case "fixed to int":
+		return c.fixedSpec(), c.integerSpec()
+	}
+	return c.integerSpec(), c.integerSpec()
+}
+
+// rows are the values as rows of the written schema.
+func (c decimalCase) rows(spec fieldSpec) []reflect.Value {
+	typ := baseType(spec)
+	rows := make([]reflect.Value, len(c.values))
+	for i, x := range c.values {
+		v := reflect.New(typ).Elem()
+		if spec.fields[0].kind == kDecFixed {
+			b := make([]byte, c.fixedLen())
+			unscaled := big.NewInt(x)
+			if x < 0 {
+				unscaled.Add(unscaled, new(big.Int).Lsh(big.NewInt(1), uint(8*c.fixedLen())))
+			}
+			unscaled.FillBytes(b)
+			setBytes(v.Field(0), b)
+		} else {
+			v.Field(0).SetInt(x)
+		}
+		rows[i] = v
+	}
+	return rows
+}
+
+var decimalCases = hegel.FlatMap(hegel.Integers(1, 18), func(precision int) hegel.Generator[decimalCase] {
+	limit := int64(math.Pow10(precision)) - 1
+	return hegel.Composite(func(tc hegel.TestCase) decimalCase {
+		return decimalCase{
+			precision: precision,
+			scale:     hegel.Draw(tc, hegel.Integers(0, precision)),
+			direction: hegel.Draw(tc, shaped(pick("int to fixed", "fixed to int"), hegel.Just("as written"))),
+			values:    hegel.Draw(tc, listsOf(hegel.Integers(-limit, limit), hegel.Integers(1, 4))),
+			fo:        hegel.Draw(tc, plainFileOptions),
+		}
+	})
+})
+
+// TestHegelDecimalConversionIsBigEndian: a DECIMAL column stored as INT32 or
+// INT64 reads into a FIXED_LEN_BYTE_ARRAY decimal field as the big-endian
+// two's complement of its values, and the other way round (parquet-go/10).
+// Under HEGEL_NO_KNOWN=1 the field has the physical type written.
+func TestHegelDecimalConversionIsBigEndian(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, decimalCases)
+		written, read := c.specs()
+		curDesc = fmt.Sprintf("%#v", c)
+		rows := c.rows(written)
+		data, err := writeGeneric(rows, c.fo.writerOptions(parquet.SchemaOf(reflect.New(baseType(written)).Interface())), nil)
+		if err != nil {
+			fail(ht, "%s: writing: %v", curDesc, err)
+		}
+		id := ""
+		if c.direction != "as written" {
+			id = "parquet-go/10"
+		}
+		back, err := readReflect(data, baseType(read), len(rows)+1)
+		if err != nil {
+			mismatch(ht, id, "%s: reading: %v", curDesc, err)
+		}
+		if len(back) != len(rows) {
+			mismatch(ht, id, "%s: %d rows read of %d", curDesc, len(back), len(rows))
+		}
+		for i := range rows {
+			want, got := canonBase(written, rows[i]), canonBase(read, back[i])
+			if !reflect.DeepEqual(want, got) {
+				mismatch(ht, id, "%s: row %d reads as %s, written %s", curDesc, i, jsonString(got), jsonString(want))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// parquet-go/5: a [N]byte column the file lacks.
+
+// missingFixedCase: a file of one to three flat columns, read into a struct
+// with a [N]byte column besides (which the file lacks, or has too under
+// HEGEL_NO_KNOWN=1).
+type missingFixedCase struct {
+	spec    fieldSpec // the reader's schema: the file's columns and the fixed one last
+	rows    []reflect.Value
+	missing bool // the file lacks the fixed column
+	fo      fileOptions
+}
+
+func (c missingFixedCase) GoString() string {
+	return fmt.Sprintf("reader schema %s, %d rows, the file lacking the last column: %v, %s", c.spec, len(c.rows), c.missing, c.fo)
+}
+
+// written is the file's schema.
+func (c missingFixedCase) written() fieldSpec {
+	if !c.missing {
+		return c.spec
+	}
+	spec := c.spec
+	spec.fields = spec.fields[:len(spec.fields)-1]
+	return spec
+}
+
+// writtenRows are the rows as the file holds them.
+func (c missingFixedCase) writtenRows() []reflect.Value {
+	if !c.missing {
+		return c.rows
+	}
+	typ := baseType(c.written())
+	rows := make([]reflect.Value, len(c.rows))
+	for i, r := range c.rows {
+		v := reflect.New(typ).Elem()
+		for j := 0; j < typ.NumField(); j++ {
+			v.Field(j).Set(r.Field(j))
+		}
+		rows[i] = v
+	}
+	return rows
+}
+
+// expected are the rows the reader should give: the fixed column zero when
+// the file lacks it.
+func (c missingFixedCase) expected() []reflect.Value {
+	if !c.missing {
+		return c.rows
+	}
+	rows := make([]reflect.Value, len(c.rows))
+	for i, r := range c.rows {
+		v := reflect.New(r.Type()).Elem()
+		v.Set(r)
+		v.Field(len(c.spec.fields) - 1).SetZero()
+		rows[i] = v
+	}
+	return rows
+}
+
+var missingFixedCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+	columns := hegel.Draw(tc, listsOf(flatColumns, hegel.Integers(1, 3)))
+	fixed := fieldSpec{kind: kFixed, fixedLen: hegel.Draw(tc, hegel.Integers(1, 16))}
+	return rootOf(append(columns, fixed)...)
+}), func(spec fieldSpec) hegel.Generator[missingFixedCase] {
+	rows := rowsOf(spec, hegel.Integers(1, 3))
+	options := fileOptionsOf(flatLeaves(spec.fields[len(spec.fields)-1]))
+	return hegel.Composite(func(tc hegel.TestCase) missingFixedCase {
+		return missingFixedCase{spec: spec, rows: hegel.Draw(tc, rows), missing: hegel.Draw(tc, shaped(hegel.Just(true), hegel.Just(false))), fo: hegel.Draw(tc, options)}
+	})
+})
+
+// TestHegelMissingFixedColumnsReadAsZero: reading a file into a struct with
+// a [N]byte field the file has no column for gives the zero array, as it
+// gives zero values for missing columns of other types, instead of
+// panicking (parquet-go/5). Under HEGEL_NO_KNOWN=1 the file has the column.
+func TestHegelMissingFixedColumnsReadAsZero(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, missingFixedCases)
+		curDesc = fmt.Sprintf("%#v", c)
+		written := c.written()
+		data, err := writeGeneric(c.writtenRows(), c.fo.writerOptions(parquet.SchemaOf(reflect.New(baseType(written)).Interface())), nil)
+		if err != nil {
+			fail(ht, "%s: writing: %v", curDesc, err)
+		}
+		id := ""
+		if c.missing {
+			id = "parquet-go/5"
+		}
+		var back []reflect.Value
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					if isHegelPanic(r) {
+						panic(r)
+					}
+					mismatch(ht, id, "%s: reading panics: %v", curDesc, r)
+				}
+			}()
+			back, err = readReflect(data, baseType(c.spec), len(c.rows)+1)
+		}()
+		if err != nil {
+			mismatch(ht, id, "%s: reading: %v", curDesc, err)
+		}
+		expected := c.expected()
+		if len(back) != len(expected) {
+			mismatch(ht, id, "%s: %d rows read of %d", curDesc, len(back), len(expected))
+		}
+		for i := range expected {
+			want, got := canonBase(c.spec, expected[i]), canonBase(c.spec, back[i])
+			if !reflect.DeepEqual(want, got) {
+				mismatch(ht, id, "%s: row %d reads as %s, want %s", curDesc, i, jsonString(got), jsonString(want))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// parquet-go/6: damaged level lengths of a data page v2.
+
+// levelLengthCase: a small file with data pages v2, the column whose first
+// page's header is edited, which level length (definition or repetition)
+// and the excess over the page's compressed size it will claim.
+type levelLengthCase struct {
+	rows   []optionalRow
+	col    int
+	which  string
+	excess int
+}
+
+func (c levelLengthCase) GoString() string {
+	return fmt.Sprintf("%d rows, column %s's %s level length claimed beyond the page by %d", len(c.rows), string("bcd"[c.col]), c.which, c.excess)
+}
+
+// shortOptionalRows: one to three rows of short values (strings of up to
+// eight ASCII characters), so that a page is shorter than 63 bytes and a
+// length beyond it encodes in the header's byte.
+var shortOptionalRows = listsOf(hegel.Composite(func(tc hegel.TestCase) optionalRow {
+	return optionalRow{
+		B: hegel.Draw(tc, presentOr(70, hegel.Booleans())),
+		C: hegel.Draw(tc, presentOr(70, hegel.Integers(int32(-1000), 1000))),
+		D: hegel.Draw(tc, presentOr(70, hegel.Text().Alphabet("abz09 _").MaxSize(8))),
+	}
+}), hegel.Integers(1, 3))
+
+var levelLengthCases = hegel.Composite(func(tc hegel.TestCase) levelLengthCase {
+	return levelLengthCase{
+		rows:   hegel.Draw(tc, shortOptionalRows),
+		col:    hegel.Draw(tc, pick(0, 1, 2)),
+		which:  hegel.Draw(tc, pick("definition", "repetition")),
+		excess: hegel.Draw(tc, hegel.Integers(0, 60)),
+	}
+})
+
+// length is the level byte length the page will claim: beyond its
+// compressed size (up to 63, one header byte like the written length) or,
+// under HEGEL_NO_KNOWN=1, the written length.
+func (c levelLengthCase) length(written, compressed int32) int32 {
+	if noKnown {
+		return written
+	}
+	return compressed + 1 + int32(c.excess)%(63-compressed)
+}
+
+// TestHegelDamagedLevelsAreAnError: a data page v2 whose header claims more
+// level bytes than the page holds is malformed; reading it is an error, not
+// a panic (parquet-go/6). The file is opened and read in a child process
+// (openFileInChild): levels decoded from the wrong bytes can make the RLE
+// decoder allocate the run length they claim, gigabytes (the candidate
+// parquet-go/21, counted and skipped). Under HEGEL_NO_KNOWN=1 the lengths
+// stay as written.
+func TestHegelDamagedLevelsAreAnError(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, levelLengthCases)
+		var buf bytes.Buffer
+		if err := parquet.Write[optionalRow](&buf, c.rows, parquet.DataPageVersion(2)); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		data, err := withPageCounts(buf.Bytes(), c.col, func(h *format.PageHeader) {
+			if !h.DataPageHeaderV2.Valid {
+				ht.Fatalf("column %d's first data page is not a data page v2", c.col)
+			}
+			if h.CompressedPageSize >= 63 {
+				ht.Fatalf("column %d's first data page is %d bytes, too long for the header's byte", c.col, h.CompressedPageSize)
+			}
+			v2 := &h.DataPageHeaderV2.V
+			field := &v2.DefinitionLevelsByteLength
+			if c.which == "repetition" {
+				field = &v2.RepetitionLevelsByteLength
+			}
+			length := c.length(*field, h.CompressedPageSize)
+			curDesc = fmt.Sprintf("a %d-row file whose column %s's %d-byte data page v2 claims %d %s level bytes (written: %d)", len(c.rows), string("bcd"[c.col]), h.CompressedPageSize, length, c.which, *field)
+			*field = length
+		})
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		child := openFileInChild(name, data)
+		if strings.HasPrefix(child.open, "child:") || strings.HasPrefix(child.read, "child:") {
+			ht.Fatalf("%s: %s%s", curDesc, child.open, child.read)
+		}
+		if child.open != "ok" {
+			fail(ht, "%s: OpenFile %s", curDesc, openFileVerdict(child.alloc, child.open))
+		}
+		switch {
+		case child.read == childDies:
+			// candidate/go/parquet-go-21 (no pin yet, see the report): the
+			// RLE level decoder allocates the run length the misread level
+			// bytes claim, without bound. Counted and skipped.
+			count("candidate/go/parquet-go-21: decoding the damaged levels exhausts the child's address space")
+			ht.Assume(false)
+		case strings.HasPrefix(child.read, "panic: "):
+			mismatch(ht, "parquet-go/6", "%s: the row API panics: %s", curDesc, strings.TrimPrefix(child.read, "panic: "))
+		}
+		count("read " + child.read)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// parquet-go/8: negative page index lengths in the footer.
+
+// indexLengthEdit: one column chunk's column or offset index length set.
+type indexLengthEdit struct {
+	col    int
+	which  string
+	length int32
+}
+
+func (e indexLengthEdit) GoString() string {
+	return fmt.Sprintf("column %d's %s index length %d", e.col, e.which, e.length)
+}
+
+// indexLengthCase: a small file and the index lengths set in its footer:
+// negative (parquet-go/8's shape), or non-negative under HEGEL_NO_KNOWN=1
+// (taken modulo the file's size).
+type indexLengthCase struct {
+	rows  []smallRow
+	edits []indexLengthEdit
+}
+
+var (
+	indexLengths     = shaped(hegel.Integers(int32(math.MinInt32), -1), hegel.Integers(int32(0), math.MaxInt32))
+	indexLengthEdits = hegel.Composite(func(tc hegel.TestCase) indexLengthEdit {
+		return indexLengthEdit{col: hegel.Draw(tc, pick(0, 1)), which: hegel.Draw(tc, pick("column", "offset")), length: hegel.Draw(tc, indexLengths)}
+	})
+	indexLengthCases = hegel.Composite(func(tc hegel.TestCase) indexLengthCase {
+		return indexLengthCase{rows: hegel.Draw(tc, smallRows), edits: hegel.Draw(tc, listsOf(indexLengthEdits, hegel.Integers(1, 2)))}
+	})
+)
+
+// TestHegelNegativeIndexLengthsAreAnError: a footer whose column or offset
+// index lengths are negative is malformed; OpenFile rejects it instead of
+// panicking (parquet-go/8). Under HEGEL_NO_KNOWN=1 the lengths set are
+// non-negative (and wrong: an error, or the file as read without an index).
+func TestHegelNegativeIndexLengthsAreAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexLengthCases)
+		data := writeSmall(ht, c.rows)
+		edited, err := withFooter(data, func(md *format.FileMetaData) {
+			for _, e := range c.edits {
+				col := &md.RowGroups[0].Columns[e.col]
+				length := e.length
+				if noKnown {
+					length %= int32(len(data))
+				}
+				if e.which == "column" {
+					col.ColumnIndexLength = length
+				} else {
+					col.OffsetIndexLength = length
+				}
+			}
+		})
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		curDesc = fmt.Sprintf("a %d-byte file with %#v", len(data), c.edits)
+		_, alloc, res := openOutcome(edited)
+		if strings.HasPrefix(res, "panic:") {
+			mismatch(ht, "parquet-go/8", "%s: OpenFile %s", curDesc, openFileVerdict(alloc, res))
+		}
+		if alloc > openFileAllowance(len(edited)) {
+			fail(ht, "%s: OpenFile %s", curDesc, openFileVerdict(alloc, res))
+		}
+		count(strings.SplitN(res, ":", 2)[0])
+	})
+}
+
+// ---------------------------------------------------------------------------
+// parquet-go/16: a page header claiming fewer values than the column holds.
+
+// shortPageCase: a file parquet-go wrote whose first field is a map of one
+// to four entries per row (its key and value columns hold the same number
+// of values), followed by a byte-array leaf, a non-zero integer leaf and
+// up to two other leaves, in one row group of one page per column, with
+// the first data page header of the map's key or value column claiming
+// fewer values than written (as written under HEGEL_NO_KNOWN=1). The row
+// API then yields rows short of a value, and the reflection reader assigns
+// the integer's value to the byte-array leaf.
+type shortPageCase struct {
+	goCase
+	col   int // 0: the map's key column, 1: its value column
+	fewer int // the values the header loses, 0 under HEGEL_NO_KNOWN=1
+}
+
+func (c shortPageCase) GoString() string {
+	return fmt.Sprintf("%s, the map's column %d claiming %d values fewer", c.goCase, c.col, c.fewer)
+}
+
+var (
+	// shortPageSchemas: the map, a byte-array leaf, an integer leaf and up
+	// to two others.
+	shortPageSchemas = hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		fields := []fieldSpec{
+			hegel.Draw(tc, mapFields),
+			{kind: hegel.Draw(tc, pick(kString, kBytes, kEnum, kJSON))},
+			{kind: hegel.Draw(tc, pick(kInt32, kInt64))},
+		}
+		fields = append(fields, hegel.Draw(tc, listsOf(flatColumns, hegel.Integers(0, 2)))...)
+		return rootOf(fields...)
+	})
+	// nonEmptyMapCounts: the entries of the maps.
+	nonEmptyMapCounts = hegel.Integers(1, 4)
+	shortPageCases    = hegel.FlatMap(shortPageSchemas, func(spec fieldSpec) hegel.Generator[shortPageCase] {
+		entries := hegel.Composite(func(tc hegel.TestCase) entry {
+			return entry{hegel.Draw(tc, texts), hegel.Draw(tc, baseOf(spec.fields[0]))}
+		})
+		maps := hegel.Map(listsOf(entries, nonEmptyMapCounts), func(es []entry) reflect.Value {
+			m := reflect.MakeMap(goType(spec.fields[0]))
+			for _, e := range es {
+				m.SetMapIndex(reflect.ValueOf(e.key), e.value)
+			}
+			return m
+		})
+		nonZero := hegel.Map(hegel.Integers(1, 1<<20), func(n int) reflect.Value {
+			return reflect.ValueOf(n).Convert(baseType(spec.fields[2]))
+		})
+		rows := listsOf(groupOf(spec, map[int]hegel.Generator[reflect.Value]{0: maps, 2: nonZero}), hegel.Integers(1, 3))
+		return hegel.Composite(func(tc hegel.TestCase) shortPageCase {
+			c := shortPageCase{
+				goCase: goCase{spec: spec, rows: hegel.Draw(tc, rows), fo: hegel.Draw(tc, plainFileOptions)},
+				col:    hegel.Draw(tc, hegel.Integers(0, 1)),
+			}
+			total := 0
+			for _, r := range c.rows {
+				total += r.Field(0).Len()
+			}
+			c.fewer = hegel.Draw(tc, shaped(hegel.Integers(1, total), hegel.Just(0)))
+			return c
+		})
+	})
+)
+
+// TestHegelDamagedByteArrayPagesAreAnError: a file whose page header claims
+// fewer values than its column's sibling holds never makes the row API or
+// the reflection reader panic: the file is read as an error, or as values
+// (parquet-go/16: the reflection reader slices a nil pointer by the
+// integer's value). Under HEGEL_NO_KNOWN=1 the counts are as written.
+func TestHegelDamagedByteArrayPagesAreAnError(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, shortPageCases)
+		curDesc = c.GoString()
+		data, err := withPageCounts(writeCase(ht, c.goCase), c.col, func(h *format.PageHeader) {
+			if h.DataPageHeaderV2.Valid {
+				h.DataPageHeaderV2.V.NumValues -= int32(c.fewer)
+			} else {
+				h.DataPageHeader.V.NumValues -= int32(c.fewer)
+			}
+		})
+		if err != nil {
+			ht.Fatalf("%s: %v", curDesc, err)
+		}
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			count("OpenFile: error")
+			return
+		}
+		if res := readOutcome(f); strings.HasPrefix(res, "panic: ") {
+			mismatch(ht, known(caseInfo{prop: "damaged", panic: res, stage: "read"}), "%s: the row API panics: %s", curDesc, strings.TrimPrefix(res, "panic: "))
+		} else {
+			count("row API: " + res)
+		}
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					if isHegelPanic(r) {
+						panic(r)
+					}
+					mismatch(ht, known(caseInfo{prop: "damaged", panic: fmt.Sprint(r), stage: "read"}), "%s: the reflection reader panics: %v", curDesc, r)
+				}
+			}()
+			if _, err := readReflect(data, c.typ(), len(c.rows)+1); err != nil {
+				count("reflection reader: error")
+			} else {
+				count("reflection reader: rows")
+			}
+		}()
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..95f5803
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,433 @@
+package hegel
+
+// Hegel property tests for parquet-go. Files parquet-go writes for generated
+// schemas and rows (through GenericWriter[any] on reflect-built struct
+// types) are read back by pyarrow - a child process speaking one JSON line
+// each way, oracle.py - and by parquet-go itself, and compared with the rows
+// in a canonical form both sides produce; the column chunk statistics,
+// encodings and compression pyarrow reports are compared with what the rows
+// and the options say they must be.
+//
+// The generators (hegel_gen_test.go, hegel_reverse_test.go) are package-level
+// values built from the binding's combinators: a schema is a tree drawn from
+// a depth-indexed tower, its rows a generator derived from the tree, the
+// writer options records, and the damage of a file a list of edit records;
+// pure functions render them. The shapes of the recorded bugs (bugs.toml,
+// classified in known.go) are drawn by default and a disagreement on one
+// fails naming the bug ("the shape of parquet-go/N"), so the wide properties
+// that meet them are the expected failures mapped to the bugs; under
+// HEGEL_NO_KNOWN=1 (noKnown, read once) such a case is counted and ends, and
+// the generators leave the shapes out where their rate would be high.
+// hegel_shapes_test.go has one narrow property per bug over its shape region.
+//
+// Needs python3 with pyarrow.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+	// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs whose gates are
+	// off by default (STYLE.md rule 11; parquet-go/15). Read once.
+	noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+)
+
+type collected struct{}
+
+// curDesc describes the case under test, for panic reports.
+var curDesc string
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("%s: panic in the code under test: %v", curDesc, r))
+				collectedMu.Unlock()
+				return
+			}
+			fail(ht, "%s: panic in the code under test: %v", curDesc, r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement on a case: one that a recorded bug's shape
+// explains (id is the bug's id, from known or the statistics check) fails
+// naming the bug, or under HEGEL_NO_KNOWN=1 is counted and the case ends;
+// one nothing explains (id "") fails plainly.
+func mismatch(ht *hegel.T, id string, format string, args ...any) {
+	if id != "" {
+		count("shape " + id)
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + id + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms (hegel-go has no weighted choice, biased coin, optional
+// with a probability or tuple combinator; these are the zoo's spellings).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first. A weight of zero leaves the choice out.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// unless is the weight w, or zero when off: the clean HEGEL_NO_KNOWN=1 gate
+// of a shape in a weighted choice (no case is skipped).
+func unless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table (the first is the shrink target; the second
+// is the one the engine favours).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// shaped is the generator of a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, of the neighbouring region past it.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// exactly is a list of exactly k elements (Lists with a MaxSize alone
+// almost never draws the empty list, so counts are drawn first).
+func exactly[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// listsOf is a list whose length is drawn from counts.
+func listsOf[T any](g hegel.Generator[T], counts hegel.Generator[int]) hegel.Generator[[]T] {
+	return hegel.FlatMap(counts, func(k int) hegel.Generator[[]T] { return exactly(g, k) })
+}
+
+// ---------------------------------------------------------------------------
+// The oracle: pyarrow in a child process, one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	cmd.Env = append(os.Environ(), "PYTHONDONTWRITEBYTECODE=1") // no __pycache__ in the tree the patch is saved from
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one JSON request and returns the answer object.
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %.200q: %v", o.name, resp, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		return nil, fmt.Errorf("%s oracle failed on %v: %v", o.name, req, e)
+	}
+	return m, nil
+}
+
+var (
+	pyOnce sync.Once
+	py     *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("pyarrow", "python3", "-u", "oracle.py") })
+	return py
+}
+
+// pyColumn is a column chunk as pyarrow reports it.
+type pyColumn struct {
+	path                                     string
+	physical, compression                    string
+	encodings                                []string
+	numValues                                int64
+	hasNullCount                             bool
+	nullCount                                int64
+	hasMinMax                                bool
+	min, max                                 any
+	dictionaryPage, columnIndex, offsetIndex bool
+}
+
+type pyRowGroup struct {
+	numRows int64
+	columns []pyColumn
+}
+
+// pyFile is pyarrow's reading of a parquet file.
+type pyFile struct {
+	ok           bool
+	err          string
+	rows         []any // canonical rows: map[string]any each
+	numRows      int64
+	numRowGroups int
+	createdBy    string
+	format       string
+	schema       string
+	keyValue     map[string]string
+	rowGroups    []pyRowGroup
+}
+
+func str(v any) string {
+	s, _ := v.(string)
+	return s
+}
+
+func num(v any) int64 {
+	f, _ := v.(float64)
+	return int64(f)
+}
+
+func boolean(v any) bool {
+	b, _ := v.(bool)
+	return b
+}
+
+func pythonRead(t testing.TB, path string) pyFile {
+	m, err := pyOracle().call(map[string]any{"op": "read", "path": path})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	f := pyFile{ok: boolean(m["ok"])}
+	if !f.ok {
+		f.err = str(m["reason"])
+		return f
+	}
+	f.rows, _ = m["rows"].([]any)
+	f.numRows = num(m["num_rows"])
+	f.numRowGroups = int(num(m["num_row_groups"]))
+	f.createdBy = str(m["created_by"])
+	f.format = str(m["format_version"])
+	f.schema = str(m["schema"])
+	f.keyValue = map[string]string{}
+	if kv, ok := m["key_value"].(map[string]any); ok {
+		for k, v := range kv {
+			f.keyValue[k] = str(v)
+		}
+	}
+	groups, _ := m["row_groups"].([]any)
+	for _, g := range groups {
+		gm, _ := g.(map[string]any)
+		rg := pyRowGroup{numRows: num(gm["num_rows"])}
+		cols, _ := gm["columns"].([]any)
+		for _, c := range cols {
+			cm, _ := c.(map[string]any)
+			col := pyColumn{
+				path:           str(cm["path"]),
+				physical:       str(cm["physical"]),
+				compression:    str(cm["compression"]),
+				numValues:      num(cm["num_values"]),
+				hasMinMax:      boolean(cm["has_min_max"]),
+				min:            cm["min"],
+				max:            cm["max"],
+				dictionaryPage: boolean(cm["dictionary_page"]),
+				columnIndex:    boolean(cm["column_index"]),
+				offsetIndex:    boolean(cm["offset_index"]),
+			}
+			if cm["null_count"] != nil {
+				col.hasNullCount, col.nullCount = true, num(cm["null_count"])
+			}
+			encs, _ := cm["encodings"].([]any)
+			for _, e := range encs {
+				col.encodings = append(col.encodings, str(e))
+			}
+			rg.columns = append(rg.columns, col)
+		}
+		f.rowGroups = append(f.rowGroups, rg)
+	}
+	return f
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..af758a2
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,199 @@
+package hegel
+
+import "strings"
+
+// The shapes of the known bugs of parquet-go at the pinned commit (ids from
+// the zoo's bugs.toml). The properties draw them at their natural rate and,
+// on a disagreement, fail naming the bug the case has the shape of (mismatch
+// in hegel_test.go); under HEGEL_NO_KNOWN=1 such a case is counted and ends.
+// The pins in hegel_pins_test.go fail while the bugs are open, and
+// hegel_shapes_test.go has one narrow property per bug.
+
+// caseInfo describes a failing case for the classifier.
+type caseInfo struct {
+	prop  string    // which property: "writer", "readback", "damaged" or "pyarrow"
+	spec  fieldSpec // the schema
+	panic string    // the panic's message
+	stage string    // damaged files: "open" (OpenFile), "allocation", "read" or "read allocation"; pyarrow and parquet-go files: "error" (a read fails), "values" (rows differ), "panic", "page index"
+	rows  int       // pyarrow files: the number of rows
+	// pyOpts: pyarrow files: the writer options; noFirstIndex: the first
+	// column chunk of the file has no column index (pyarrow writes none for
+	// a FLOAT or DOUBLE column with an all-NaN page).
+	pyOpts       pyOptions
+	noFirstIndex bool
+	fileOpts     fileOptions // parquet-go's own files: the writer options
+}
+
+// known returns the id of the bug whose shape explains the case, or "".
+func known(c caseInfo) string {
+	switch {
+	case c.prop == "writer" && hasOptionalListElement(c.spec):
+		// parquet-go/1: Schema.Deconstruct, and so the deprecated Writer,
+		// mishandles optional LIST elements: pointer elements panic,
+		// non-pointer optional elements are written as nulls.
+		return "parquet-go/1"
+	case c.prop == "damaged" && c.stage == "open" && (strings.Contains(c.panic, "makeslice: len out of range") || strings.Contains(c.panic, "slice bounds out of range")):
+		// parquet-go/8: damaged (negative) column or offset index lengths in
+		// the footer make OpenFile panic in ReadPageIndex.
+		return "parquet-go/8"
+	case c.prop == "damaged" && strings.Contains(c.panic, "is not assignable to type"):
+		// parquet-go/5: a value assigned to a [N]byte field it does not fit
+		// (here because damage renamed the column, so the reader fills it
+		// with nulls) panics in reflect.Set instead of returning an error.
+		return "parquet-go/5"
+	case c.prop == "damaged" && strings.Contains(c.panic, "slice bounds out of range"):
+		// parquet-go/6: a damaged v2 data page header whose level lengths
+		// exceed the page makes decodeLevelsV2 panic.
+		return "parquet-go/6"
+	case c.prop == "damaged" && strings.Contains(c.panic, "unsafe.Slice: ptr is nil"):
+		// parquet-go/16: a damaged byte-array page yields a Value with a nil
+		// pointer and a non-zero length, which the row API passes on and
+		// the reflection readers (Read, GenericReader, Reader) crash on in
+		// Value.byteArray.
+		return "parquet-go/16"
+	case c.prop == "damaged" && c.stage == "allocation":
+		// parquet-go/17: OpenFile allocates the footer length the trailer
+		// claims, and the page index lengths the footer claims, before
+		// checking them against the file: gigabytes for one damaged byte.
+		return "parquet-go/17"
+	case c.prop == "damaged" && c.stage == "read allocation" && lz4Tagged(c.spec, c.fileOpts):
+		// parquet-go/18: a damaged LZ4_RAW page makes compress/lz4's Decode
+		// double its buffer without end (every error taken for a short
+		// buffer).
+		return "parquet-go/18"
+	case c.prop == "damaged" && strings.Contains(c.panic, "cannot call Kind on parquet"):
+		// parquet-go/19: a leaf schema element annotated MAP or LIST (damage
+		// to its logical type) gets a group Type whose Kind panics, in
+		// OpenFile (a file with rows), Schema.String and the Reader's schema
+		// comparison.
+		return "parquet-go/19"
+	case c.prop == "damaged" && strings.Contains(c.panic, "number of values out of range"):
+		// parquet-go/20: a data page v2 header whose num_nulls exceeds its
+		// num_values (damage to a count) makes decoding the page panic in
+		// the makeNumValues check instead of returning an error.
+		return "parquet-go/20"
+	case c.prop == "pyarrow" && c.rows == 0 && anyDictionary(c.spec, c.pyOpts):
+		// parquet-go/11: an empty file whose chunks have a dictionary page
+		// but no data page fails with "Seek: invalid offset".
+		return "parquet-go/11"
+	case c.prop == "pyarrow" && (c.stage == "values" || c.stage == "error") && c.pyOpts.elemName != "element" && hasList(c.spec):
+		// parquet-go/9: the reflection reader reads LIST elements not named
+		// "element" as zero values, or drops them.
+		return "parquet-go/9"
+	case c.prop == "pyarrow" && (c.stage == "values" || c.stage == "error") && usesLZ4(c.spec, c.pyOpts):
+		// parquet-go/14: LZ4_RAW pages that compress by less than 3x are
+		// decoded from a stale buffer (garbage values or decoding errors).
+		return "parquet-go/14"
+	case c.prop == "pyarrow" && c.stage == "values" && (c.pyOpts.pageVersion == "2.0" && hasBool(c.spec) || hasRLEBool(c.spec)):
+		// parquet-go/12: RLE-encoded booleans (parquet-cpp's choice for
+		// booleans in data pages v2) decode wrongly when the data holds a run.
+		return "parquet-go/12"
+	case c.prop == "pyarrow" && c.stage == "panic" && c.pyOpts.pageVersion == "2.0" && strings.Contains(c.panic, "invalid memory address"):
+		// parquet-go/13: a data page v2 with zero values makes decodeDataPage
+		// dereference nil repetition levels.
+		return "parquet-go/13"
+	case c.prop == "pyarrow" && c.stage == "page index" && c.noFirstIndex:
+		// parquet-go/15: when the first column chunk of the file has no
+		// column index, the column indexes of every other column read as
+		// empty (no pages, so no null counts and no bounds).
+		return "parquet-go/15"
+	case c.prop == "readback" && (c.stage == "error" || c.stage == "values") && lz4Tagged(c.spec, c.fileOpts):
+		// parquet-go/14 for parquet-go's own files: an LZ4_RAW page that
+		// compresses by less than 3x is decoded from a stale buffer.
+		return "parquet-go/14"
+	}
+	return ""
+}
+
+// lz4Tagged reports whether the file's codec or some column's tag is LZ4.
+func lz4Tagged(f fieldSpec, o fileOptions) bool {
+	if o.comp == "lz4" {
+		return true
+	}
+	for _, s := range f.fields {
+		if s.comp == "lz4" || (s.kind == kGroup && lz4Tagged(s, fileOptions{})) {
+			return true
+		}
+	}
+	return false
+}
+
+// usesLZ4 reports whether some column is LZ4-compressed.
+func usesLZ4(f fieldSpec, o pyOptions) bool {
+	if o.comp == "lz4" {
+		return true
+	}
+	for _, s := range f.fields {
+		if s.pyComp == "lz4" || (s.kind == kGroup && usesLZ4(s, o)) {
+			return true
+		}
+	}
+	return false
+}
+
+// anyDictionary reports whether pyarrow dictionary-encodes some column: the
+// file-wide option, or a column asked for it.
+func anyDictionary(f fieldSpec, o pyOptions) bool {
+	return o.dictionary || hasPyDict(f)
+}
+
+// hasPyDict reports a leaf pyarrow was asked to dictionary-encode.
+func hasPyDict(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.pyEnc == "dict" || (s.kind == kGroup && hasPyDict(s)) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasBool reports a boolean leaf anywhere in the schema (map values and
+// list elements included).
+func hasBool(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.kind == kBool || (s.kind == kGroup && hasBool(s)) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasRLEBool reports a boolean leaf pyarrow was asked to RLE-encode.
+func hasRLEBool(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.kind == kBool && s.pyEnc == "RLE" || (s.kind == kGroup && hasRLEBool(s)) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasOptionalListElement reports a LIST with optional (pointer) elements
+// anywhere in the schema.
+func hasOptionalListElement(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.rep == "list" && s.elemOptional {
+			return true
+		}
+		if s.kind == kGroup && hasOptionalListElement(s) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasDictBool reports a dictionary-encoded boolean leaf anywhere in the
+// schema: the format allows the encoding for every physical type, but
+// parquet-cpp (pyarrow) refuses to read it ("Dictionary encoding not
+// implemented for boolean type"), so such files are counted, not compared.
+func hasDictBool(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.kind == kBool && s.enc == "dict" {
+			return true
+		}
+		if s.kind == kGroup && hasDictBool(s) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..e4e0494
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,374 @@
+#!/usr/bin/env python3
+"""pyarrow oracle for the parquet-go hegel tests: one JSON object per line in, one per line out.
+
+  {"op": "write", "path": str, "schema": spec, "rows": [canon], "options": {...}}
+      -> {"ok": true, "schema": str, "num_row_groups": int} once pyarrow has written the rows
+         to the file, or {"ok": false, "reason": "..."} when pyarrow refuses. A spec is
+         {"name", "kind", "optional", "rep" ("" or "list"), "elemOptional", "isMap", "fixedLen",
+         "scale", "precision", "utc", "fields": [spec]} with the kind names of the Go side; the
+         rows are canonical values (below); the options are keyword arguments of
+         pyarrow.parquet.write_table plus "list_element_name" and "key_value".
+  {"op": "read", "path": str}
+      -> {"ok": false, "reason": "..."} when pyarrow cannot read the file, else
+         {"ok": true, "rows": [...], "num_rows": int, "num_row_groups": int, "created_by": str,
+          "format_version": str, "schema": str, "key_value": {str: str},
+          "row_groups": [{"num_rows": int, "columns": [{"path": str, "physical": str,
+              "encodings": [str], "compression": str, "num_values": int,
+              "null_count": int|null, "has_min_max": bool, "min": canon|null, "max": canon|null,
+              "dictionary_page": bool, "column_index": bool, "offset_index": bool}]}]}
+
+Rows are in a canonical form shared with the Go side: null -> null, booleans -> bool,
+integers (and dates, times and timestamps as their integer representation, and the unscaled
+value of decimals) -> decimal string, float32 -> "f32:" + 8 hex digits of the bits,
+float64 -> "f64:" + 16 hex digits, strings -> the string, binary (and enums, fixed-length
+byte arrays and UUIDs) -> lowercase hex, lists -> arrays, maps -> arrays of [key, value]
+sorted by key, groups -> objects keyed by field name. Statistics minima and maxima use the
+same encoding of the physical value, with byte arrays of every logical type as hex.
+"""
+import decimal
+import json
+import struct
+import sys
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pyarrow.parquet as pq
+
+
+def canon(arr):
+    """Canonical values (a Python list, one entry per element) of an Arrow array."""
+    if isinstance(arr, pa.ChunkedArray):
+        arr = arr.combine_chunks()
+    if isinstance(arr.type, pa.BaseExtensionType):  # arrow.uuid, arrow.json
+        arr = arr.storage
+    t = arr.type
+    n = len(arr)
+    valid = arr.is_valid().to_pylist()
+    if pa.types.is_null(t):
+        return [None] * n
+    if pa.types.is_list(t) or pa.types.is_large_list(t):
+        offs = arr.offsets.to_pylist()
+        vals = canon(arr.values)
+        return [vals[offs[i]:offs[i + 1]] if valid[i] else None for i in range(n)]
+    if pa.types.is_map(t):
+        offs = arr.offsets.to_pylist()
+        keys = canon(arr.keys)
+        items = canon(arr.items)
+        out = []
+        for i in range(n):
+            if not valid[i]:
+                out.append(None)
+                continue
+            pairs = [[keys[j], items[j]] for j in range(offs[i], offs[i + 1])]
+            pairs.sort(key=lambda p: p[0])  # by code point, as Go compares UTF-8 bytes
+            out.append(pairs)
+        return out
+    if pa.types.is_struct(t):
+        cols = [(t.field(i).name, canon(arr.field(i))) for i in range(t.num_fields)]
+        return [{name: col[i] for name, col in cols} if valid[i] else None for i in range(n)]
+    if pa.types.is_boolean(t):
+        return arr.to_pylist()
+    if pa.types.is_integer(t):
+        return [None if x is None else str(x) for x in arr.to_pylist()]
+    if pa.types.is_float32(t):
+        bits = arr.view(pa.uint32()).to_pylist()
+        return ["f32:%08x" % bits[i] if valid[i] else None for i in range(n)]
+    if pa.types.is_float64(t):
+        bits = arr.view(pa.uint64()).to_pylist()
+        return ["f64:%016x" % bits[i] if valid[i] else None for i in range(n)]
+    if pa.types.is_string(t) or pa.types.is_large_string(t):
+        return arr.to_pylist()
+    if pa.types.is_binary(t) or pa.types.is_large_binary(t) or pa.types.is_fixed_size_binary(t):
+        return [None if x is None else x.hex() for x in arr.to_pylist()]
+    if pa.types.is_decimal(t):
+        return [None if d is None else unscaled(d, t.scale) for d in arr.to_pylist()]
+    if pa.types.is_date32(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int32()).to_pylist()]
+    if pa.types.is_date64(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int64()).to_pylist()]
+    if pa.types.is_time32(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int32()).to_pylist()]
+    if pa.types.is_time64(t) or pa.types.is_timestamp(t) or pa.types.is_duration(t):
+        return [None if x is None else str(x) for x in arr.cast(pa.int64()).to_pylist()]
+    raise ValueError("oracle: unsupported Arrow type %s" % t)
+
+
+def unscaled(d, scale):
+    """The unscaled integer of a Decimal at the given scale, exactly (the default decimal
+    context would round at 28 digits)."""
+    sign, digits, exponent = d.as_tuple()
+    v = int("".join(map(str, digits)) or "0") * 10 ** (exponent + scale)
+    return str(-v if sign else v)
+
+
+def canon_stat(stats, which):
+    """Canonical form of a statistics bound (physical value)."""
+    raw = stats.min_raw if which == "min" else stats.max_raw
+    phys = stats.physical_type
+    lt = str(stats.logical_type)
+    if phys == "BOOLEAN":
+        return bool(raw)
+    if phys in ("INT32", "INT64"):
+        if lt.startswith("Int(") and "isSigned=false" in lt:
+            return str(stats.min if which == "min" else stats.max)
+        return str(raw)
+    if phys == "FLOAT":
+        return "f32:" + struct.pack(">f", raw).hex()
+    if phys == "DOUBLE":
+        return "f64:" + struct.pack(">d", raw).hex()
+    if phys in ("BYTE_ARRAY", "FIXED_LEN_BYTE_ARRAY"):
+        if lt.startswith("Decimal"):
+            return str(int.from_bytes(raw, "big", signed=True))
+        return raw.hex()
+    if phys == "INT96":
+        return raw.hex() if isinstance(raw, bytes) else str(raw)
+    return str(raw)
+
+
+def read(path):
+    try:
+        f = pq.ParquetFile(path)
+        table = f.read()
+        cols = [canon(table.column(i)) for i in range(table.num_columns)]
+        names = table.column_names
+        rows = [{names[c]: cols[c][r] for c in range(len(names))} for r in range(table.num_rows)]
+        md = f.metadata
+        groups = []
+        for g in range(md.num_row_groups):
+            rg = md.row_group(g)
+            columns = []
+            for c in range(rg.num_columns):
+                cc = rg.column(c)
+                st = cc.statistics if cc.is_stats_set else None
+                col = {
+                    "path": cc.path_in_schema,
+                    "physical": str(cc.physical_type),
+                    "encodings": [str(e) for e in cc.encodings],
+                    "compression": str(cc.compression),
+                    "num_values": cc.num_values,
+                    "null_count": (st.null_count if st is not None and st.has_null_count else None),
+                    "has_min_max": bool(st is not None and st.has_min_max),
+                    "min": None,
+                    "max": None,
+                    "dictionary_page": cc.has_dictionary_page,
+                    "column_index": cc.has_column_index,
+                    "offset_index": cc.has_offset_index,
+                }
+                if st is not None and st.has_min_max:
+                    col["min"] = canon_stat(st, "min")
+                    col["max"] = canon_stat(st, "max")
+                columns.append(col)
+            groups.append({"num_rows": rg.num_rows, "columns": columns})
+        kv = {}
+        if md.metadata:
+            for k, v in md.metadata.items():
+                if k != b"ARROW:schema":
+                    kv[k.decode("utf-8", "replace")] = v.decode("utf-8", "replace")
+        return {
+            "ok": True,
+            "rows": rows,
+            "num_rows": md.num_rows,
+            "num_row_groups": md.num_row_groups,
+            "created_by": md.created_by,
+            "format_version": md.format_version,
+            "schema": str(f.schema_arrow),
+            "key_value": kv,
+            "row_groups": groups,
+        }
+    except (pa.ArrowException, ValueError, OSError, UnicodeDecodeError) as e:  # noqa: PERF203
+        return {"ok": False, "reason": "%s: %s" % (type(e).__name__, e)}
+
+
+# ---------------------------------------------------------------------------
+# Writing: Arrow arrays from a spec and canonical values.
+
+INT_TYPES = {
+    "int8": pa.int8(), "int16": pa.int16(), "int32": pa.int32(), "int64": pa.int64(),
+    "uint8": pa.uint8(), "uint16": pa.uint16(), "uint32": pa.uint32(), "uint64": pa.uint64(),
+}
+DECIMAL_CTX = decimal.Context(prec=80)
+
+
+def arrow_type(f, elem_name):
+    """The Arrow type of one value of the field (no list, map or nullability)."""
+    k = f["kind"]
+    if k == "bool":
+        return pa.bool_()
+    if k in INT_TYPES:
+        return INT_TYPES[k]
+    if k == "float":
+        return pa.float32()
+    if k == "double":
+        return pa.float64()
+    if k in ("string", "enum"):
+        return pa.string()
+    if k == "bytes":
+        return pa.binary()
+    if k == "fixed":
+        return pa.binary(f["fixedLen"])
+    if k == "uuid":
+        return pa.uuid()
+    if k == "json":
+        return pa.json_()
+    if k == "decimal32":
+        return pa.decimal32(f["precision"], f["scale"])
+    if k == "decimal64":
+        return pa.decimal64(f["precision"], f["scale"])
+    if k == "decimalfixed":
+        return pa.decimal128(f["precision"], f["scale"])
+    if k == "date":
+        return pa.date32()
+    if k == "time_ms":
+        return pa.time32("ms")
+    if k == "time_us":
+        return pa.time64("us")
+    if k == "time_ns":
+        return pa.time64("ns")
+    if k.startswith("ts_"):
+        return pa.timestamp(k[3:], tz="UTC" if f["utc"] else None)
+    if k == "group":
+        return pa.struct([arrow_field(sub, elem_name) for sub in f["fields"]])
+    raise ValueError("oracle: unknown kind %s" % k)
+
+
+def field_type(f, elem_name):
+    t = arrow_type(f, elem_name)
+    if f["isMap"]:
+        return pa.map_(pa.string(), pa.field("value", t, nullable=False))
+    if f["rep"]:
+        return pa.list_(pa.field(elem_name, t, nullable=bool(f["elemOptional"])))
+    return t
+
+
+def arrow_field(f, elem_name):
+    return pa.field(f["name"], field_type(f, elem_name), nullable=bool(f["optional"]))
+
+
+def filler(f):
+    """A canonical value for a required child under a null parent (never read)."""
+    k = f["kind"]
+    if f["isMap"] or f["rep"]:
+        return []
+    if k == "bool":
+        return False
+    if k in INT_TYPES or k.startswith("decimal") or k in ("date",) or k.startswith("time") or k.startswith("ts_"):
+        return "0"
+    if k == "float":
+        return "f32:00000000"
+    if k == "double":
+        return "f64:0000000000000000"
+    if k in ("string", "enum", "bytes", "json"):
+        return ""
+    if k == "fixed":
+        return "00" * f["fixedLen"]
+    if k == "uuid":
+        return "00" * 16
+    if k == "group":
+        return {sub["name"]: filler(sub) for sub in f["fields"]}
+    raise ValueError("oracle: unknown kind %s" % k)
+
+
+def build_base(f, vals, elem_name):
+    """An Arrow array of arrow_type(f) from canonical values (None for null)."""
+    k = f["kind"]
+    t = arrow_type(f, elem_name)
+    if k == "bool":
+        return pa.array(vals, pa.bool_())
+    if k in INT_TYPES:
+        return pa.array([None if v is None else int(v) for v in vals], t)
+    if k == "float":
+        return pa.array([None if v is None else int(v[4:], 16) for v in vals], pa.uint32()).view(pa.float32())
+    if k == "double":
+        return pa.array([None if v is None else int(v[4:], 16) for v in vals], pa.uint64()).view(pa.float64())
+    if k in ("string", "enum"):
+        return pa.array(vals, pa.string())
+    if k == "json":
+        return pa.ExtensionArray.from_storage(t, pa.array(vals, pa.string()))
+    if k in ("bytes", "fixed"):
+        return pa.array([None if v is None else bytes.fromhex(v) for v in vals], t)
+    if k == "uuid":
+        return pa.ExtensionArray.from_storage(t, pa.array([None if v is None else bytes.fromhex(v) for v in vals], pa.binary(16)))
+    if k.startswith("decimal"):
+        # Exactly the unscaled value at the type's scale: quantize pins the exponent, as
+        # pyarrow infers the precision from the first element's digits and exponent.
+        q = decimal.Decimal(1).scaleb(-f["scale"])
+        ds = [None if v is None else decimal.Decimal(int(v)).scaleb(-f["scale"], context=DECIMAL_CTX).quantize(q, context=DECIMAL_CTX) for v in vals]
+        return pa.array(ds, t)
+    if k in ("date", "time_ms"):
+        return pa.array([None if v is None else int(v) for v in vals], pa.int32()).view(t)
+    if k in ("time_us", "time_ns") or k.startswith("ts_"):
+        return pa.array([None if v is None else int(v) for v in vals], pa.int64()).view(t)
+    if k == "group":
+        children = []
+        for sub in f["fields"]:
+            col = [(filler(sub) if not sub["optional"] and not sub["isMap"] and not sub["rep"] else None) if v is None else v[sub["name"]] for v in vals]
+            children.append(build_field(sub, col, elem_name))
+        mask = pa.array([v is None for v in vals], pa.bool_())
+        return pa.StructArray.from_arrays(children, fields=list(t), mask=mask)
+    raise ValueError("oracle: unknown kind %s" % k)
+
+
+def build_field(f, vals, elem_name):
+    """An Arrow array of field_type(f) from canonical values."""
+    ft = field_type(f, elem_name)
+    if f["isMap"]:
+        offsets, keys, items = [0], [], []
+        for v in vals:
+            pairs = v or []
+            keys.extend(p[0] for p in pairs)
+            items.append([p[1] for p in pairs])
+            offsets.append(offsets[-1] + len(pairs))
+        flat = [x for sub in items for x in sub]
+        return pa.MapArray.from_arrays(pa.array(offsets, pa.int32()), pa.array(keys, pa.string()),
+                                       build_base(f, flat, elem_name), type=ft)
+    if f["rep"]:
+        offsets, flat = [0], []
+        for v in vals:
+            elems = v or []
+            flat.extend(elems)
+            offsets.append(offsets[-1] + len(elems))
+        mask = pa.array([v is None for v in vals], pa.bool_())
+        return pa.ListArray.from_arrays(pa.array(offsets, pa.int32()), build_base(f, flat, elem_name), type=ft, mask=mask)
+    return build_base(f, vals, elem_name)
+
+
+def write(path, spec, rows, options):
+    options = dict(options)
+    elem_name = options.pop("list_element_name", "element")
+    key_value = options.pop("key_value", None)
+    fields = [arrow_field(f, elem_name) for f in spec["fields"]]
+    arrays = [build_field(f, [r[f["name"]] for r in rows], elem_name) for f in spec["fields"]]
+    schema = pa.schema(fields)
+    if key_value:
+        schema = schema.with_metadata({k: v for k, v in key_value.items()})
+    table = pa.Table.from_arrays(arrays, schema=schema)
+    table.validate(full=True)
+    try:
+        pq.write_table(table, path, use_compliant_nested_type=(elem_name == "element"), **options)
+    except (pa.ArrowException, ValueError, OSError) as e:  # noqa: PERF203
+        return {"ok": False, "reason": "%s: %s" % (type(e).__name__, e)}
+    f = pq.ParquetFile(path)
+    return {"ok": True, "schema": str(f.schema), "num_row_groups": f.metadata.num_row_groups}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        req = json.loads(line)
+        try:
+            if req["op"] == "read":
+                out = read(req["path"])
+            elif req["op"] == "write":
+                out = write(req["path"], req["schema"], req["rows"], req["options"])
+            else:
+                out = {"error": "oracle: unknown op"}
+        except Exception as e:  # noqa: BLE001
+            out = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
