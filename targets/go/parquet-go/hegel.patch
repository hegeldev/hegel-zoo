+		}
+		return spec
+	})
+	return hegel.FlatMap(schemas, func(spec fieldSpec) hegel.Generator[goCase] {
+		rows := rowsOf(spec, counts)
+		options := fileOptionsOf(flatLeaves(spec))
+		return hegel.Composite(func(tc hegel.TestCase) goCase {
+			return goCase{spec: spec, rows: hegel.Draw(tc, rows), fo: hegel.Draw(tc, options), batches: hegel.Draw(tc, batches)}
+		})
