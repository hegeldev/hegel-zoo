+// TestHegelGroupAnnotationsOnLeavesAreRejected: a leaf schema element (a
+// physical type, no children) annotated with a group logical type (MAP or
+// LIST) is malformed; OpenFile rejects the file, or its Schema and readers
+// return errors, and nothing panics (parquet-go/19). Under HEGEL_NO_KNOWN=1
+// the annotations stay as written.
+func TestHegelGroupAnnotationsOnLeavesAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, annotationCases)
+		index := 1 // schema element 0 is the root
+		if c.leaf == "b" {
+			index = 2
+		}
+		data, err := withLogicalType(writeSmall(ht, c.rows), index, c.logicalType())
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
