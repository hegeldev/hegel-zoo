+// parquet-go/15: a file whose first column chunk has no column index (the
+// page index is optional per column; pyarrow writes none for a FLOAT or
+// DOUBLE column with an all-NaN page) loses the column indexes of every
+// other column: OpenFile's ReadPageIndex takes the first chunk's offset as
+// the base of the column index section, skips the section when that offset
+// is 0, and still stores an empty index into every chunk, which ColumnIndex
+// returns (0 pages, no null counts, no bounds) although the file holds them.
+func TestHegelPinColumnIndexesFollowAnIndexlessFirstColumn(t *testing.T) {
+	type R struct {
+		A float64 `parquet:"a"`
+		B *int32  `parquet:"b"`
+	}
+	one := int32(1)
+	var buf bytes.Buffer
+	if err := parquet.Write[R](&buf, []R{{A: 1, B: nil}, {A: 2, B: &one}}); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.Bytes()
+	// [data][footer][footer length, 4 bytes little-endian]["PAR1"]
+	n := len(data)
+	footerLen := int(binary.LittleEndian.Uint32(data[n-8 : n-4]))
+	var md format.FileMetaData
+	if err := thrift.Unmarshal(new(thrift.CompactProtocol), data[n-8-footerLen:n-8], &md); err != nil {
+		t.Fatal(err)
+	}
+	if md.RowGroups[0].Columns[0].ColumnIndexOffset == 0 || md.RowGroups[0].Columns[1].ColumnIndexOffset == 0 {
+		t.Fatal("the writer wrote no column index; the pin needs one")
+	}
+	// Drop column a's column index, as a writer that has none for it would.
+	md.RowGroups[0].Columns[0].ColumnIndexOffset, md.RowGroups[0].Columns[0].ColumnIndexLength = 0, 0
+	footer, err := thrift.Marshal(new(thrift.CompactProtocol), &md)
+	if err != nil {
+		t.Fatal(err)
+	}
+	edited := append([]byte(nil), data[:n-8-footerLen]...)
+	edited = append(edited, footer...)
+	edited = binary.LittleEndian.AppendUint32(edited, uint32(len(footer)))
+	edited = append(edited, "PAR1"...)
+	pages := func(name string, file []byte) (pages int, nulls int64) {
+		f, err := parquet.OpenFile(bytes.NewReader(file), int64(len(file)))
+		if err != nil {
+			t.Fatalf("%s: OpenFile: %v", name, err)
+		}
+		ci, err := f.RowGroups()[0].ColumnChunks()[1].(*parquet.FileColumnChunk).ColumnIndex()
+		if err != nil {
+			t.Fatalf("%s: column b: ColumnIndex: %v", name, err)
+		}
+		for p := 0; p < ci.NumPages(); p++ {
+			nulls += ci.NullCount(p)
+		}
+		return ci.NumPages(), nulls
+	}
+	wantPages, wantNulls := pages("the file as written", data)
+	gotPages, gotNulls := pages("the file without column a's index", edited)
+	if gotPages != wantPages || gotNulls != wantNulls {
+		t.Errorf("once column a has no column index, column b's reads as %d pages with %d nulls; the file holds %d page(s) with %d null(s)", gotPages, gotNulls, wantPages, wantNulls)
+	}
+}
