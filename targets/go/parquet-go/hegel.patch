+// ---------------------------------------------------------------------------
+// parquet-go/12: RLE-encoded booleans with a run.
+
+// run is a run of equal booleans.
+type run struct {
+	value bool
+	n     int
+}
+
+func (r run) GoString() string { return fmt.Sprintf("%d x %v", r.n, r.value) }
+
+// boolRunCase: the runs of a boolean column, one of which (the shape) is
+// seven to sixteen trues, and how pyarrow encodes it: pages v2 (where
+// parquet-cpp RLE-encodes booleans), or RLE asked for on pages v1 or v2;
+// under HEGEL_NO_KNOWN=1 PLAIN booleans in pages v1.
+type boolRunCase struct {
+	before, after []run
+	shape         run
+	version       string
+	encoding      string
+	dictionary    bool
+	statistics    bool
+}
+
+func (c boolRunCase) GoString() string {
+	return fmt.Sprintf("runs %#v %#v %#v, pages v%s, encoding %q, dictionary %v, statistics %v", c.before, c.shape, c.after, c.version, c.encoding, c.dictionary, c.statistics)
+}
+
+var (
+	runs = hegel.Composite(func(tc hegel.TestCase) run {
+		return run{hegel.Draw(tc, hegel.Booleans()), hegel.Draw(tc, hegel.Integers(1, 12))}
+	})
+	shapeRuns = shaped(hegel.Map(hegel.Integers(7, 16), func(n int) run { return run{true, n} }), runs)
+	// boolEncodings: the page version and the column encoding asked for.
+	boolEncodings = shaped(pick([2]string{"2.0", ""}, [2]string{"1.0", "RLE"}, [2]string{"2.0", "RLE"}), hegel.Just([2]string{"1.0", ""}))
+	boolRunCases  = hegel.Composite(func(tc hegel.TestCase) boolRunCase {
+		enc := hegel.Draw(tc, boolEncodings)
+		return boolRunCase{
+			before:     hegel.Draw(tc, listsOf(runs, hegel.Integers(0, 3))),
+			shape:      hegel.Draw(tc, shapeRuns),
+			after:      hegel.Draw(tc, listsOf(runs, hegel.Integers(0, 3))),
+			version:    enc[0],
+			encoding:   enc[1],
+			dictionary: hegel.Draw(tc, chance(50)),
+			statistics: hegel.Draw(tc, chance(50)),
+		}
+	})
+	boolSpec = rootOf(fieldSpec{kind: kBool})
+)
+
+// pyCase is the case as pyarrow writes it: one required boolean column.
+func (c boolRunCase) pyCase() pyCase {
+	spec := boolSpec
+	spec.fields = []fieldSpec{{name: "c0", kind: kBool, pyEnc: c.encoding}}
+	o := pyOptions{pageVersion: c.version, dictionary: c.dictionary, statistics: c.statistics, elemName: "element"}
+	typ := baseType(spec)
+	var rows []reflect.Value
+	for _, r := range append(append(append([]run(nil), c.before...), c.shape), c.after...) {
+		for i := 0; i < r.n; i++ {
+			v := reflect.New(typ).Elem()
+			v.Field(0).SetBool(r.value)
+			rows = append(rows, v)
+		}
+	}
+	return pyCase{o: o, spec: spec, rows: rows}
+}
