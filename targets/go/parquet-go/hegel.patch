+// Package hegel holds the zoo's Hegel property tests for parquet-go: files
+// written for generated schemas, rows and writer options are read back by
+// pyarrow (a child-process oracle, oracle.py) and by parquet-go itself and
+// compared with the rows, along with the metadata pyarrow reports.
+package hegel
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..df743b9
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,1206 @@
+package hegel
+
+// Generators: a schema spec drawn from a depth-indexed tower of generators
+// (scalar kinds as a table with the plain kinds first, logical types,
+// encodings and compression as alternatives, groups, lists, maps and
+// optional fields as the containers of the level below), the reflect-built
+// Go struct type for it (with parquet struct tags), the rows of a schema as a
+// generator derived from the spec, the canonical form of a row shared with
+// the oracle, and the writer options of a file as a record. Every generator
+// is a package-level value or a pure function of drawn data; the plain
+// alternative comes first in every choice, so a minimal case is a required
+// boolean column with no rows.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"math/big"
+	"math/rand"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kBool kind = iota
+	kInt8
+	kInt16
+	kInt32
+	kInt64
+	kUint8
+	kUint16
+	kUint32
+	kUint64
+	kFloat
+	kDouble
+	kString
+	kBytes
+	kFixed
+	kUUID
+	kJSON
+	kEnum
+	kDec32
+	kDec64
+	kDecFixed
+	kDate
+	kTimeMs
+	kTimeUs
+	kTimeNs
+	kTsMs
+	kTsUs
+	kTsNs
+	kGroup
+)
+
+var kindNames = [...]string{"bool", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float", "double", "string", "bytes", "fixed", "uuid", "json", "enum", "decimal32", "decimal64", "decimalfixed", "date", "time_ms", "time_us", "time_ns", "ts_ms", "ts_us", "ts_ns", "group"}
+
+func (k kind) String() string { return kindNames[k] }
+
+// scalarKinds are the leaf kinds, the plain ones first; mapValueKinds the
+// ones used as map values.
+var scalarKinds = []kind{kBool, kInt8, kInt16, kInt32, kInt64, kUint8, kUint16, kUint32, kUint64, kFloat, kDouble, kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDec32, kDec64, kDecFixed, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs}
+var mapValueKinds = []kind{kBool, kInt32, kInt64, kDouble, kString, kBytes}
+
+// fieldSpec describes one field of a schema.
+type fieldSpec struct {
+	name         string
+	kind         kind
+	optional     bool   // a pointer in Go, nullable in parquet
+	rep          string // "", "repeated" (bare slice) or "list" (LIST logical type)
+	elemOptional bool   // list elements are pointers
+	isMap        bool   // map[string]kind
+	fixedLen     int    // for kFixed, kDecFixed
+	scale        int    // decimals
+	precision    int
+	utc          bool // timestamps
+	enc          string
+	comp         string
+	pyEnc        string      // pyarrow's encoding of the column (the reverse direction)
+	pyComp       string      // pyarrow's codec of the column (the reverse direction)
+	longStrings  bool        // strings of thousands of characters (a page LZ4_RAW cannot shrink threefold, parquet-go/14's shape)
+	fields       []fieldSpec // kGroup
+}
+
+// withLongStrings is the schema with every field's strings long.
+func withLongStrings(f fieldSpec) fieldSpec {
+	f.longStrings = true
+	f.fields = append([]fieldSpec(nil), f.fields...)
+	for i := range f.fields {
+		f.fields[i] = withLongStrings(f.fields[i])
+	}
+	return f
+}
+
+func (f fieldSpec) String() string {
+	var b strings.Builder
+	b.WriteString(f.name + ":")
+	if f.optional {
+		b.WriteString("?")
+	}
+	if f.rep != "" {
+		b.WriteString(f.rep + "<")
+		if f.elemOptional {
+			b.WriteString("?")
+		}
+	}
+	if f.isMap {
+		b.WriteString("map<string,")
+	}
+	if f.kind == kGroup {
+		parts := make([]string, len(f.fields))
+		for i, s := range f.fields {
+			parts[i] = s.String()
+		}
+		b.WriteString("{" + strings.Join(parts, " ") + "}")
+	} else {
+		b.WriteString(f.kind.String())
+	}
+	switch f.kind {
+	case kFixed, kDecFixed:
+		fmt.Fprintf(&b, "(%d)", f.fixedLen)
+	}
+	switch f.kind {
+	case kDec32, kDec64, kDecFixed:
+		fmt.Fprintf(&b, "[%d.%d]", f.precision, f.scale)
+	case kTsMs, kTsUs, kTsNs:
+		if f.utc {
+			b.WriteString("[utc]")
+		} else {
+			b.WriteString("[local]")
+		}
+	}
+	if f.rep != "" || f.isMap {
+		b.WriteString(">")
+	}
+	if f.enc != "" {
+		b.WriteString("," + f.enc)
+	}
+	if f.comp != "" {
+		b.WriteString("," + f.comp)
+	}
+	if f.pyEnc != "" {
+		b.WriteString(",py:" + f.pyEnc)
+	}
+	if f.pyComp != "" {
+		b.WriteString(",py:" + f.pyComp)
+	}
+	return b.String()
+}
+
+func (f fieldSpec) GoString() string { return f.String() }
+
+// ---------------------------------------------------------------------------
+// Schema specs.
+
+// shape is how a field holds its values: plain, optional (a pointer in Go),
+// repeated (a bare slice), or a LIST with required or optional elements.
+type shape struct {
+	optional, elemOptional bool
+	rep                    string
+}
+
+var (
+	plainShape    = shape{}
+	optionalShape = shape{optional: true}
+	repeatedShape = shape{rep: "repeated"}
+	listShape     = shape{rep: "list"}
+	listOptShape  = shape{rep: "list", elemOptional: true}
+	// shapes: plain most often, then optional, a bare slice and the lists.
+	shapes = pick(plainShape, plainShape, plainShape, plainShape, optionalShape, optionalShape, optionalShape, repeatedShape, listShape, listOptShape)
+	// shapesWithRequiredElements: the same without the LIST of optional
+	// elements (parquet-go/1's shape in the deprecated Writer).
+	shapesWithRequiredElements = pick(plainShape, plainShape, plainShape, plainShape, optionalShape, optionalShape, optionalShape, repeatedShape, listShape)
+)
+
+// kindsFor are the scalar kinds parquet-go's tags accept in a shape: on
+// pointers (optional fields, optional list elements) enum, time and uuid are
+// refused and json loses its optionality, on bare slices every logical type
+// is refused, and in any slice uint8 is a byte array to Go and to parquet-go
+// rather than a list.
+func kindsFor(s shape) []kind {
+	pointer := s.optional || s.elemOptional
+	var out []kind
+	for _, k := range scalarKinds {
+		switch {
+		case (s.rep == "repeated" || pointer) && (k == kEnum || k == kTimeMs || k == kTimeUs || k == kTimeNs || k == kUUID || k == kJSON):
+		case s.rep == "repeated" && (k == kDec32 || k == kDec64 || k == kDecFixed || k == kDate || k == kTsMs || k == kTsUs || k == kTsNs):
+		case s.rep != "" && k == kUint8:
+		default:
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// fixedPrecision is the largest decimal precision whose values all fit in
+// l signed bytes.
+func fixedPrecision(l int) int {
+	return min(int(math.Floor(float64(8*l-1)*math.Log10(2))), 38)
+}
+
+var (
+	// codecs: any of parquet-go's; LZ4_RAW (a page it cannot shrink by 3x
+	// is decoded from a stale buffer, parquet-go/14's shape) never under
+	// HEGEL_NO_KNOWN=1.
+	codecs = weighted(
+		choice[string]{5, pick("snappy", "gzip", "zstd", "brotli", "uncompressed")},
+		choice[string]{unless(noKnown, 1), hegel.Just("lz4")},
+	)
+	// fileCodecs: the file's codec, the default (snappy) most often.
+	fileCodecs = weighted(
+		choice[string]{2, hegel.Just("")},
+		choice[string]{5, pick("snappy", "gzip", "zstd", "brotli", "uncompressed")},
+		choice[string]{unless(noKnown, 1), hegel.Just("lz4")},
+	)
+	compressions = maybe(30, codecs)
+	fixedLens    = hegel.Integers(1, 20)
+	decimalLens  = hegel.Integers(1, 15)
+)
+
+// encodingsFor is the encoding tag of a leaf: none most of the time, else
+// one parquet-go accepts for the kind (delta and split are refused on
+// pointers and bare slices).
+func encodingsFor(k kind, s shape) hegel.Generator[string] {
+	encs := []string{"plain", "dict", "delta"}
+	switch k {
+	case kBool:
+		encs = []string{"plain", "dict"}
+	case kFloat, kDouble:
+		encs = []string{"plain", "dict", "split"}
+	}
+	if s.rep == "repeated" || s.optional || s.elemOptional {
+		encs = encs[:2]
+	}
+	return maybe(40, pick(encs...))
+}
+
+// leafOf is a scalar leaf of the kind in the shape: its parameters (the
+// length of a fixed array, the precision and scale of a decimal, the time
+// zone of a timestamp), its encoding and its compression.
+func leafOf(k kind, s shape) hegel.Generator[fieldSpec] {
+	encodings := encodingsFor(k, s)
+	return hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		f := fieldSpec{kind: k, optional: s.optional, rep: s.rep, elemOptional: s.elemOptional}
+		switch k {
+		case kFixed:
+			f.fixedLen = hegel.Draw(tc, fixedLens)
+		case kDecFixed:
+			f.fixedLen = hegel.Draw(tc, decimalLens)
+			f.precision = fixedPrecision(f.fixedLen)
+			f.scale = hegel.Draw(tc, hegel.Integers(0, f.precision))
+		case kDec32:
+			f.precision = hegel.Draw(tc, hegel.Integers(1, 9))
+			f.scale = hegel.Draw(tc, hegel.Integers(0, f.precision))
+		case kDec64:
+			f.precision = hegel.Draw(tc, hegel.Integers(1, 18))
+			f.scale = hegel.Draw(tc, hegel.Integers(0, f.precision))
+		case kTsMs, kTsUs, kTsNs:
+			f.utc = hegel.Draw(tc, chance(50))
+		}
+		f.enc = hegel.Draw(tc, encodings)
+		f.comp = hegel.Draw(tc, compressions)
+		return f
+	})
+}
+
+// leavesOf is a scalar leaf of any kind the shape accepts, built once per
+// shape.
+var leavesOf = func() func(shape) hegel.Generator[fieldSpec] {
+	table := map[shape]hegel.Generator[fieldSpec]{}
+	for _, s := range []shape{plainShape, optionalShape, repeatedShape, listShape, listOptShape} {
+		byKind := map[kind]hegel.Generator[fieldSpec]{}
+		for _, k := range kindsFor(s) {
+			byKind[k] = leafOf(k, s)
+		}
+		table[s] = hegel.FlatMap(hegel.SampledFrom(kindsFor(s)), func(k kind) hegel.Generator[fieldSpec] { return byKind[k] })
+	}
+	return func(s shape) hegel.Generator[fieldSpec] { return table[s] }
+}()
+
+// mapFields: a map from strings to a value kind.
+var mapFields = hegel.Map(hegel.SampledFrom(mapValueKinds), func(k kind) fieldSpec { return fieldSpec{isMap: true, kind: k} })
+
+// namePrefixes are the spellings of field names; a field is named by its
+// prefix and its index in the group.
+var namePrefixes = pick("c", "col", "x", "Val", "f_")
+
+// named gives the fields of a group their names.
+func named(fields []fieldSpec, prefixes []string) []fieldSpec {
+	out := make([]fieldSpec, len(fields))
+	for i, f := range fields {
+		f.name = fmt.Sprintf("%s%d", prefixes[i], i)
+		out[i] = f
+	}
+	return out
+}
+
+// groupsOf is a group of lo to hi fields of the level below, in a shape.
+func groupsOf(fields hegel.Generator[fieldSpec], lo, hi int, shapes hegel.Generator[shape]) hegel.Generator[fieldSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		s := hegel.Draw(tc, shapes)
+		fs := hegel.Draw(tc, hegel.Lists(fields).MinSize(lo).MaxSize(hi))
+		ps := hegel.Draw(tc, exactly(namePrefixes, len(fs)))
+		return fieldSpec{kind: kGroup, optional: s.optional, rep: s.rep, elemOptional: s.elemOptional, fields: named(fs, ps)}
+	})
+}
+
+// towerOpts selects the shapes a tower draws.
+type towerOpts struct {
+	// optionalListsFirst: a LIST of optional scalar elements is the first
+	// alternative of a field, at a fifth - parquet-go/1's shape, which
+	// TestHegelWriterPathsAgree must reach every run - and no field has
+	// that shape under HEGEL_NO_KNOWN=1.
+	optionalListsFirst bool
+}
+
+// newTower builds the depth-indexed tower of field generators: level 2 has
+// scalar leaves and maps, levels 1 and 0 groups of the level below too; the
+// root is a group of one to six level-0 fields.
+func newTower(o towerOpts) hegel.Generator[fieldSpec] {
+	fieldShapes := shapes
+	if o.optionalListsFirst {
+		fieldShapes = shaped(shapes, shapesWithRequiredElements)
+	}
+	leaves := hegel.FlatMap(fieldShapes, leavesOf)
+	var levels [3]hegel.Generator[fieldSpec]
+	for d := 2; d >= 0; d-- {
+		var alts []choice[fieldSpec]
+		if o.optionalListsFirst {
+			alts = append(alts, choice[fieldSpec]{unless(noKnown, 20), leavesOf(listOptShape)})
+		}
+		alts = append(alts, choice[fieldSpec]{77, leaves}, choice[fieldSpec]{8, mapFields})
+		if d < 2 {
+			alts = append(alts, choice[fieldSpec]{15, groupsOf(levels[d+1], 1, 3, fieldShapes)})
+		}
+		levels[d] = weighted(alts...)
+	}
+	return hegel.Map(groupsOf(levels[0], 1, 6, hegel.Just(plainShape)), func(g fieldSpec) fieldSpec {
+		g.name = "root"
+		return g
+	})
+}
+
+var (
+	// schemas: a top-level schema, a group of one to six fields.
+	schemas = newTower(towerOpts{})
+	// writerSchemas: the same for the deprecated Writer, which must meet
+	// parquet-go/1's LIST of optional elements every run.
+	writerSchemas = newTower(towerOpts{optionalListsFirst: true})
+)
+
+// baseType is the Go type of one value of the field (without pointer, slice
+// or map).
+func baseType(f fieldSpec) reflect.Type {
+	switch f.kind {
+	case kBool:
+		return reflect.TypeOf(false)
+	case kInt8:
+		return reflect.TypeOf(int8(0))
+	case kInt16:
+		return reflect.TypeOf(int16(0))
+	case kInt32, kDec32, kDate, kTimeMs:
+		return reflect.TypeOf(int32(0))
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return reflect.TypeOf(int64(0))
+	case kUint8:
+		return reflect.TypeOf(uint8(0))
+	case kUint16:
+		return reflect.TypeOf(uint16(0))
+	case kUint32:
+		return reflect.TypeOf(uint32(0))
+	case kUint64:
+		return reflect.TypeOf(uint64(0))
+	case kFloat:
+		return reflect.TypeOf(float32(0))
+	case kDouble:
+		return reflect.TypeOf(float64(0))
+	case kString, kJSON, kEnum:
+		return reflect.TypeOf("")
+	case kBytes:
+		return reflect.TypeOf([]byte(nil))
+	case kFixed, kDecFixed:
+		return reflect.ArrayOf(f.fixedLen, reflect.TypeOf(byte(0)))
+	case kUUID:
+		return reflect.ArrayOf(16, reflect.TypeOf(byte(0)))
+	case kGroup:
+		fields := make([]reflect.StructField, len(f.fields))
+		for i, s := range f.fields {
+			fields[i] = reflect.StructField{Name: fmt.Sprintf("F%d", i), Type: goType(s), Tag: reflect.StructTag(tagOf(s))}
+		}
+		return reflect.StructOf(fields)
+	}
+	panic("unknown kind")
+}
+
+// goType is the Go type of the field as a struct member.
+func goType(f fieldSpec) reflect.Type {
+	t := baseType(f)
+	if f.isMap {
+		return reflect.MapOf(reflect.TypeOf(""), t)
+	}
+	if f.rep != "" {
+		if f.elemOptional {
+			t = reflect.PointerTo(t)
+		}
+		return reflect.SliceOf(t)
+	}
+	if f.optional {
+		return reflect.PointerTo(t)
+	}
+	return t
+}
+
+// logicalTags are the tags of the field's logical type.
+func logicalTags(f fieldSpec) []string {
+	switch f.kind {
+	case kEnum:
+		return []string{"enum"}
+	case kJSON:
+		return []string{"json"}
+	case kUUID:
+		return []string{"uuid"}
+	case kDec32, kDec64, kDecFixed:
+		return []string{fmt.Sprintf("decimal(%d:%d)", f.scale, f.precision)}
+	case kDate:
+		return []string{"date"}
+	case kTimeMs:
+		return []string{"time(millisecond)"}
+	case kTimeUs:
+		return []string{"time(microsecond)"}
+	case kTimeNs:
+		return []string{"time(nanosecond)"}
+	case kTsMs, kTsUs, kTsNs:
+		unit := map[kind]string{kTsMs: "millisecond", kTsUs: "microsecond", kTsNs: "nanosecond"}[f.kind]
+		adj := "local"
+		if f.utc {
+			adj = "utc"
+		}
+		return []string{fmt.Sprintf("timestamp(%s:%s)", unit, adj)}
+	}
+	return nil
+}
+
+// tagOf is the parquet struct tag of the field: for a LIST the logical type,
+// encoding and compression go on the element.
+func tagOf(f fieldSpec) string {
+	leaf := logicalTags(f)
+	if f.enc != "" {
+		leaf = append(leaf, f.enc)
+	}
+	if f.comp != "" {
+		leaf = append(leaf, f.comp)
+	}
+	if f.rep == "list" {
+		tag := fmt.Sprintf(`parquet:"%s,list"`, f.name)
+		if len(leaf) > 0 {
+			tag += fmt.Sprintf(` parquet-element:",%s"`, strings.Join(leaf, ","))
+		}
+		return tag
+	}
+	return fmt.Sprintf(`parquet:"%s"`, strings.Join(append([]string{f.name}, leaf...), ","))
+}
+
+// ---------------------------------------------------------------------------
+// Values: a generator of reflect.Values derived from the spec.
+
+// Counts: rows per file, elements per list, entries per map, bytes per
+// value, drawn before the collection (hegel-go's Lists with a MaxSize alone
+// almost never draws the empty list).
+var (
+	rowCounts     = weighted(choice[int]{2, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}, choice[int]{2, hegel.Just(2)}, choice[int]{2, hegel.Integers(1, 12)}, choice[int]{2, hegel.Integers(1, 60)})
+	someRowCounts = weighted(choice[int]{2, hegel.Just(1)}, choice[int]{2, hegel.Just(2)}, choice[int]{2, hegel.Integers(1, 12)}, choice[int]{2, hegel.Integers(1, 60)})
+	listCounts    = weighted(choice[int]{3, hegel.Just(0)}, choice[int]{3, hegel.Just(1)}, choice[int]{4, hegel.Integers(0, 5)})
+	mapCounts     = hegel.Integers(0, 4)
+	byteCounts    = weighted(choice[int]{2, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}, choice[int]{4, hegel.Integers(0, 12)}, choice[int]{2, hegel.Integers(20, 50)})
+)
+
+// intsOf is a signed integer of the width: a small one most often, a bound,
+// one up to a million, or any.
+func intsOf(bits int) hegel.Generator[int64] {
+	hi := int64(math.MaxInt64 >> (64 - bits))
+	lo := int64(math.MinInt64 >> (64 - bits))
+	return weighted(
+		choice[int64]{3, hegel.Integers(int64(-100), 100)},
+		choice[int64]{1, pick(int64(0), hi, lo, hi-1, lo+1)},
+		choice[int64]{2, hegel.Integers(max(lo, -1000000), min(hi, 1000000))},
+		choice[int64]{2, hegel.Integers(lo, hi)},
+	)
+}
+
+// uintsOf is an unsigned integer of the width: a small one most often, a
+// bound, one just past the signed range, or any.
+func uintsOf(bits int) hegel.Generator[uint64] {
+	hi := uint64(math.MaxUint64 >> (64 - bits))
+	half := uint64(1) << (bits - 1)
+	return weighted(
+		choice[uint64]{3, hegel.Integers(uint64(0), 200)},
+		choice[uint64]{1, pick(uint64(0), hi, hi-1, half, half+1, half+2, half+3)},
+		choice[uint64]{2, hegel.Integers(uint64(0), hi)},
+	)
+}
+
+var (
+	// doubles and floats: eighths of a small range most often, the special
+	// values (the zeros, NaN, the infinities, the extremes), or any bits.
+	eighths = hegel.Map(hegel.Integers(-8000, 8000), func(n int) float64 { return float64(n) / 8 })
+	doubles = weighted(
+		choice[float64]{3, eighths},
+		choice[float64]{5, pick(0.0, math.Copysign(0, -1), math.NaN(), math.Inf(1), math.Inf(-1), math.MaxFloat64, math.SmallestNonzeroFloat64)},
+		choice[float64]{2, hegel.Map(hegel.Integers(uint64(0), uint64(math.MaxUint64)), math.Float64frombits)},
+	)
+	floats = weighted(
+		choice[float32]{3, hegel.Map(eighths, func(x float64) float32 { return float32(x) })},
+		choice[float32]{5, pick(float32(0), float32(math.Copysign(0, -1)), float32(math.NaN()), float32(math.Inf(1)), float32(math.Inf(-1)), math.MaxFloat32, math.SmallestNonzeroFloat32)},
+		choice[float32]{2, hegel.Map(hegel.Integers(uint32(0), uint32(math.MaxUint32)), math.Float32frombits)},
+	)
+	// alphabet: the characters of strings - letters, digits, blanks and
+	// punctuation, accented and wide characters, an emoji, a no-break space,
+	// a quote, a backslash, a newline and a NUL.
+	alphabet = "abzA09 _-.\u00e9\u65e5\U0001F600\u00a0\"\\\n\x00"
+	texts    = weighted(
+		choice[string]{2, hegel.Text().Alphabet(alphabet).MaxSize(1)},
+		choice[string]{5, hegel.Text().Alphabet(alphabet).MaxSize(12)},
+		choice[string]{3, hegel.Text().Alphabet(alphabet).MinSize(20).MaxSize(60)},
+	)
+	// longTexts: strings of thousands of characters of the alphabet (a
+	// page of kilobytes, which LZ4_RAW cannot shrink threefold:
+	// parquet-go/14's shape), from a seed rather than a character at a
+	// time; the strings of a case with longStrings.
+	longTexts = hegel.Composite(func(tc hegel.TestCase) string {
+		n := hegel.Draw(tc, hegel.Integers(1000, 4000))
+		r := rand.New(rand.NewSource(hegel.Draw(tc, hegel.Integers(int64(0), 1<<31))))
+		runes := []rune(alphabet)
+		var b strings.Builder
+		for i := 0; i < n; i++ {
+			b.WriteRune(runes[r.Intn(len(runes))])
+		}
+		return b.String()
+	})
+	// byteValues: the edge bytes mostly, else any.
+	byteValues = weighted(choice[byte]{5, pick(byte(0), 1, 0x7f, 0x80, 0xff)}, choice[byte]{1, hegel.Integers(byte(0), 255)})
+	blobs      = listsOf(byteValues, byteCounts)
+	jsons      = weighted(
+		choice[string]{3, pick(`{}`, `[]`, `{"a":1}`, `null`)},
+		choice[string]{1, hegel.Map(texts, func(s string) string { return `"` + s + `"` })},
+		choice[string]{1, hegel.Map(hegel.Integers(-5, 5), strconv.Itoa)},
+	)
+)
+
+// textsOf is the strings of the field: long ones when the schema says so.
+func textsOf(f fieldSpec) hegel.Generator[string] {
+	if f.longStrings {
+		return longTexts
+	}
+	return texts
+}
+
+// bytesOf is exactly l bytes.
+func bytesOf(l int) hegel.Generator[[]byte] { return exactly(byteValues, l) }
+
+// timesOf is a time of day in the unit: midnight, the last instant, or any.
+func timesOf(last int64) hegel.Generator[int64] {
+	return weighted(choice[int64]{1, pick(int64(0), last)}, choice[int64]{3, hegel.Integers(int64(0), last)})
+}
+
+// decimalBytesOf is an unscaled decimal of at most precision digits as a
+// big-endian two's complement value of l bytes: a small one, the largest,
+// or any.
+func decimalBytesOf(l, precision int) hegel.Generator[[]byte] {
+	limit := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(precision)), nil)
+	largest := new(big.Int).Sub(limit, big.NewInt(1))
+	unscaled := weighted(
+		choice[*big.Int]{2, hegel.Map(hegel.Integers(int64(-100), 100), func(n int64) *big.Int {
+			return new(big.Int).Rem(big.NewInt(n), limit) // within the precision (1 or 2 digits are possible)
+		})},
+		choice[*big.Int]{1, hegel.Map(chance(50), func(neg bool) *big.Int { return signed(largest, neg) })},
+		choice[*big.Int]{2, hegel.Composite(func(tc hegel.TestCase) *big.Int {
+			v := new(big.Int).SetBytes(hegel.Draw(tc, exactly(hegel.Integers(byte(0), 255), l)))
+			v.Mod(v, limit)
+			return signed(v, hegel.Draw(tc, chance(50)))
+		})},
+	)
+	mod := new(big.Int).Lsh(big.NewInt(1), uint(8*l))
+	return hegel.Map(unscaled, func(v *big.Int) []byte {
+		return new(big.Int).Mod(v, mod).FillBytes(make([]byte, l))
+	})
+}
+
+func signed(v *big.Int, neg bool) *big.Int {
+	if neg {
+		return new(big.Int).Neg(v)
+	}
+	return v
+}
+
+func setBytes(v reflect.Value, b []byte) {
+	reflect.Copy(v, reflect.ValueOf(b))
+}
+
+// asValue is the generator's values as reflect.Values.
+func asValue[T any](g hegel.Generator[T]) hegel.Generator[reflect.Value] {
+	return hegel.Map(g, func(v T) reflect.Value { return reflect.ValueOf(v) })
+}
+
+// arrayOf is a value of the array type filled from the bytes.
+func arrayOf(t reflect.Type, g hegel.Generator[[]byte]) hegel.Generator[reflect.Value] {
+	return hegel.Map(g, func(b []byte) reflect.Value {
+		v := reflect.New(t).Elem()
+		setBytes(v, b)
+		return v
+	})
+}
+
+// baseOf is one value of baseType(f).
+func baseOf(f fieldSpec) hegel.Generator[reflect.Value] {
+	t := baseType(f)
+	switch f.kind {
+	case kBool:
+		return asValue(hegel.Booleans())
+	case kInt8:
+		return asValue(hegel.Map(intsOf(8), func(v int64) int8 { return int8(v) }))
+	case kInt16:
+		return asValue(hegel.Map(intsOf(16), func(v int64) int16 { return int16(v) }))
+	case kInt32, kDate:
+		return asValue(hegel.Map(intsOf(32), func(v int64) int32 { return int32(v) }))
+	case kInt64, kTsMs, kTsUs, kTsNs:
+		return asValue(intsOf(64))
+	case kTimeMs:
+		return asValue(hegel.Map(timesOf(86399999), func(v int64) int32 { return int32(v) }))
+	case kTimeUs:
+		return asValue(timesOf(86399999999))
+	case kTimeNs:
+		return asValue(timesOf(86399999999999))
+	case kUint8:
+		return asValue(hegel.Map(uintsOf(8), func(v uint64) uint8 { return uint8(v) }))
+	case kUint16:
+		return asValue(hegel.Map(uintsOf(16), func(v uint64) uint16 { return uint16(v) }))
+	case kUint32:
+		return asValue(hegel.Map(uintsOf(32), func(v uint64) uint32 { return uint32(v) }))
+	case kUint64:
+		return asValue(uintsOf(64))
+	case kFloat:
+		return asValue(floats)
+	case kDouble:
+		return asValue(doubles)
+	case kString, kEnum:
+		return asValue(textsOf(f))
+	case kJSON:
+		return asValue(jsons)
+	case kBytes:
+		return asValue(blobs)
+	case kFixed, kUUID:
+		return arrayOf(t, bytesOf(t.Len()))
+	case kDec32:
+		limit := int64(math.Pow10(f.precision))
+		return asValue(hegel.Map(intsOf(32), func(v int64) int32 { return int32(v % limit) }))
+	case kDec64:
+		limit := int64(math.Pow10(f.precision))
+		return asValue(hegel.Map(intsOf(64), func(v int64) int64 { return v % limit }))
+	case kDecFixed:
+		return arrayOf(t, decimalBytesOf(f.fixedLen, f.precision))
+	case kGroup:
+		return groupOf(f, nil)
+	}
+	panic("unknown kind")
+}
+
+// groupOf is a value of the group's struct type, each field drawn from
+// valuesOf or from the override given for its index.
+func groupOf(f fieldSpec, overrides map[int]hegel.Generator[reflect.Value]) hegel.Generator[reflect.Value] {
+	t := baseType(f)
+	gens := make([]hegel.Generator[reflect.Value], len(f.fields))
+	for i, s := range f.fields {
+		if g, ok := overrides[i]; ok {
+			gens[i] = g
+		} else {
+			gens[i] = valuesOf(s)
+		}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) reflect.Value {
+		v := reflect.New(t).Elem()
+		for i, g := range gens {
+			v.Field(i).Set(hegel.Draw(tc, g))
+		}
+		return v
+	})
+}
+
+// pointerTo is the value behind a new pointer.
+func pointerTo(v reflect.Value) reflect.Value {
+	p := reflect.New(v.Type())
+	p.Elem().Set(v)
+	return p
+}
+
+// listOf is a slice value of the field's list type, its length from counts
+// and, when the elements are pointers, nil for nilPct percent of them.
+func listOf(f fieldSpec, counts hegel.Generator[int], nilPct int) hegel.Generator[reflect.Value] {
+	elem := baseOf(f)
+	if f.elemOptional {
+		elem = weighted(
+			choice[reflect.Value]{nilPct, hegel.Just(reflect.Zero(reflect.PointerTo(baseType(f))))},
+			choice[reflect.Value]{100 - nilPct, hegel.Map(baseOf(f), pointerTo)},
+		)
+	}
+	return hegel.Map(listsOf(elem, counts), func(vs []reflect.Value) reflect.Value {
+		s := reflect.MakeSlice(goType(f), len(vs), len(vs))
+		for i, v := range vs {
+			s.Index(i).Set(v)
+		}
+		return s
+	})
+}
+
+// entry is one entry of a map value.
+type entry struct {
+	key   string
+	value reflect.Value
+}
+
+// mapOf is a map value of the field's type from a list of entries (a later
+// entry with the same key wins, as in a literal).
+func mapOf(f fieldSpec) hegel.Generator[reflect.Value] {
+	entries := hegel.Composite(func(tc hegel.TestCase) entry {
+		return entry{hegel.Draw(tc, textsOf(f)), hegel.Draw(tc, baseOf(f))}
+	})
+	return hegel.Map(listsOf(entries, mapCounts), func(es []entry) reflect.Value {
+		m := reflect.MakeMap(goType(f))
+		for _, e := range es {
+			m.SetMapIndex(reflect.ValueOf(e.key), e.value)
+		}
+		return m
+	})
+}
+
+// valuesOf is a value of goType(f): a map, a slice, a pointer (nil three
+// times in ten) or a base value.
+func valuesOf(f fieldSpec) hegel.Generator[reflect.Value] {
+	switch {
+	case f.isMap:
+		return mapOf(f)
+	case f.rep != "":
+		return listOf(f, listCounts, 30)
+	case f.optional:
+		return weighted(
+			choice[reflect.Value]{30, hegel.Just(reflect.Zero(goType(f)))},
+			choice[reflect.Value]{70, hegel.Map(baseOf(f), pointerTo)},
+		)
+	}
+	return baseOf(f)
+}
+
+// rowsOf is the rows of a schema: as many values of its struct type as
+// counts says.
+func rowsOf(spec fieldSpec, counts hegel.Generator[int]) hegel.Generator[[]reflect.Value] {
+	return listsOf(baseOf(spec), counts)
+}
+
+// ---------------------------------------------------------------------------
+// Canonical form (see oracle.py).
+
+func canonValue(f fieldSpec, v reflect.Value) any {
+	if f.isMap {
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return keys[i].String() < keys[j].String() })
+		pairs := make([]any, 0, len(keys))
+		for _, k := range keys {
+			pairs = append(pairs, []any{k.String(), canonBase(f, v.MapIndex(k))})
+		}
+		return pairs
+	}
+	if f.rep != "" {
+		out := make([]any, 0, v.Len())
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			if f.elemOptional {
+				if e.IsNil() {
+					out = append(out, nil)
+					continue
+				}
+				e = e.Elem()
+			}
+			out = append(out, canonBase(f, e))
+		}
+		return out
+	}
+	if f.optional {
+		if v.IsNil() {
+			return nil
+		}
+		v = v.Elem()
+	}
+	return canonBase(f, v)
+}
+
+func arrayBytes(v reflect.Value) []byte {
+	b := make([]byte, v.Len())
+	reflect.Copy(reflect.ValueOf(b), v)
+	return b
+}
+
+func canonBase(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kBool:
+		return v.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return strconv.FormatInt(v.Int(), 10)
+	case kUint8, kUint16, kUint32, kUint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case kFloat:
+		return fmt.Sprintf("f32:%08x", math.Float32bits(float32(v.Float())))
+	case kDouble:
+		return fmt.Sprintf("f64:%016x", math.Float64bits(v.Float()))
+	case kString, kJSON:
+		return v.String()
+	case kEnum:
+		return hex.EncodeToString([]byte(v.String()))
+	case kBytes:
+		return hex.EncodeToString(v.Bytes())
+	case kFixed, kUUID:
+		return hex.EncodeToString(arrayBytes(v))
+	case kDecFixed:
+		return twosComplement(arrayBytes(v)).String()
+	case kGroup:
+		m := map[string]any{}
+		for i, s := range f.fields {
+			m[s.name] = canonValue(s, v.Field(i))
+		}
+		return m
+	}
+	panic("unknown kind")
+}
+
+func twosComplement(b []byte) *big.Int {
+	v := new(big.Int).SetBytes(b)
+	if len(b) > 0 && b[0]&0x80 != 0 {
+		v.Sub(v, new(big.Int).Lsh(big.NewInt(1), uint(8*len(b))))
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Statistics truth for the flat leaves.
+
+// flatLeaf is a leaf reached through non-repeated fields only, whose
+// statistics are simple: one value or null per row.
+type flatLeaf struct {
+	path string
+	spec fieldSpec
+	get  func(row reflect.Value) (reflect.Value, bool) // value of the leaf in the row, present?
+}
+
+func flatLeaves(schema fieldSpec) []flatLeaf {
+	var out []flatLeaf
+	var walk func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool))
+	walk = func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool)) {
+		for i, s := range f.fields {
+			i, s := i, s
+			if s.rep != "" || s.isMap {
+				continue
+			}
+			sub := func(row reflect.Value) (reflect.Value, bool) {
+				g, ok := get(row)
+				if !ok {
+					return reflect.Value{}, false
+				}
+				v := g.Field(i)
+				if s.optional {
+					if v.IsNil() {
+						return reflect.Value{}, false
+					}
+					v = v.Elem()
+				}
+				return v, true
+			}
+			name := s.name
+			if prefix != "" {
+				name = prefix + "." + s.name
+			}
+			if s.kind == kGroup {
+				walk(s, name, sub)
+			} else {
+				out = append(out, flatLeaf{path: name, spec: s, get: sub})
+			}
+		}
+	}
+	walk(schema, "", func(row reflect.Value) (reflect.Value, bool) { return row, true })
+	return out
+}
+
+// statCanon is the canonical form of a value as a statistics bound (the
+// physical value; byte arrays of any logical type as hex).
+func statCanon(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kString, kJSON:
+		return hex.EncodeToString([]byte(v.String()))
+	}
+	return canonBase(f, v)
+}
+
+// statLess orders values as the parquet column order of the type does;
+// NaN never takes part, -0 sorts before +0.
+func statLess(f fieldSpec, a, b reflect.Value) bool {
+	switch f.kind {
+	case kBool:
+		return !a.Bool() && b.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return a.Int() < b.Int()
+	case kUint8, kUint16, kUint32, kUint64:
+		return a.Uint() < b.Uint()
+	case kFloat, kDouble:
+		x, y := a.Float(), b.Float()
+		if x == 0 && y == 0 {
+			return math.Signbit(x) && !math.Signbit(y)
+		}
+		return x < y
+	case kString, kJSON, kEnum:
+		return a.String() < b.String()
+	case kBytes:
+		return bytes.Compare(a.Bytes(), b.Bytes()) < 0
+	case kFixed, kUUID:
+		return bytes.Compare(arrayBytes(a), arrayBytes(b)) < 0
+	case kDecFixed:
+		return twosComplement(arrayBytes(a)).Cmp(twosComplement(arrayBytes(b))) < 0
+	}
+	panic("unknown kind")
+}
+
+func isNaN(f fieldSpec, v reflect.Value) bool {
+	return (f.kind == kFloat || f.kind == kDouble) && math.IsNaN(v.Float())
+}
+
+// ---------------------------------------------------------------------------
+// Writer options: a record, the plainest alternative first in every field.
+
+type fileOptions struct {
+	comp           string
+	pageVersion    int
+	pageBuffer     int
+	writeBuffer    int
+	pageStats      bool
+	maxRows        int64
+	keyValue       map[string]string
+	bloom          string // path of a flat leaf with a bloom filter
+	dictMaxBytes   int64
+	skipPageBounds string
+}
+
+// keyValues: one key/value pair of metadata.
+var keyValues = hegel.Composite(func(tc hegel.TestCase) map[string]string {
+	return map[string]string{"k" + strconv.Itoa(hegel.Draw(tc, hegel.Integers(0, 9))): hegel.Draw(tc, texts)}
+})
+
+// fileOptionsOf is the writer options of a file with the flat leaves (one
+// of which may carry a bloom filter).
+func fileOptionsOf(leaves []flatLeaf) hegel.Generator[fileOptions] {
+	bloom := hegel.Just("")
+	if len(leaves) > 0 {
+		bloom = maybe(30, hegel.Map(hegel.Integers(0, len(leaves)-1), func(i int) string { return leaves[i].path }))
+	}
+	return hegel.Composite(func(tc hegel.TestCase) fileOptions {
+		return fileOptions{
+			comp:         hegel.Draw(tc, fileCodecs),
+			pageVersion:  hegel.Draw(tc, pick(1, 2, 2)),
+			pageBuffer:   hegel.Draw(tc, pick(0, 0, 128, 1024, 4096)),
+			writeBuffer:  hegel.Draw(tc, pick(0, 0, 64, 1024)),
+			pageStats:    hegel.Draw(tc, chance(50)),
+			maxRows:      hegel.Draw(tc, maybe(40, hegel.Integers(int64(1), 7))),
+			keyValue:     hegel.Draw(tc, maybe(30, keyValues)),
+			bloom:        hegel.Draw(tc, bloom),
+			dictMaxBytes: hegel.Draw(tc, maybe(20, pick(int64(1), 64, 4096))),
+		}
+	})
+}
+
+func codecOf(name string) parquet.WriterOption {
+	switch name {
+	case "snappy":
+		return parquet.Compression(&parquet.Snappy)
+	case "gzip":
+		return parquet.Compression(&parquet.Gzip)
+	case "zstd":
+		return parquet.Compression(&parquet.Zstd)
+	case "lz4":
+		return parquet.Compression(&parquet.Lz4Raw)
+	case "brotli":
+		return parquet.Compression(&parquet.Brotli)
+	case "uncompressed":
+		return parquet.Compression(&parquet.Uncompressed)
+	}
+	return nil
+}
+
+// compressionName is the name pyarrow reports for a codec tag.
+func compressionName(tag string) string {
+	switch tag {
+	case "snappy":
+		return "SNAPPY"
+	case "gzip":
+		return "GZIP"
+	case "zstd":
+		return "ZSTD"
+	case "lz4":
+		return "LZ4" // pyarrow's name for LZ4_RAW (its LZ4_HADOOP is the deprecated codec)
+	case "brotli":
+		return "BROTLI"
+	case "uncompressed", "":
+		return "UNCOMPRESSED"
+	}
+	return "?"
+}
+
+func (o fileOptions) writerOptions(schema *parquet.Schema) []parquet.WriterOption {
+	opts := []parquet.WriterOption{schema, parquet.DataPageVersion(o.pageVersion), parquet.DataPageStatistics(o.pageStats)}
+	if c := codecOf(o.comp); c != nil {
+		opts = append(opts, c)
+	}
+	if o.pageBuffer > 0 {
+		opts = append(opts, parquet.PageBufferSize(o.pageBuffer))
+	}
+	if o.writeBuffer > 0 {
+		opts = append(opts, parquet.WriteBufferSize(o.writeBuffer))
+	}
+	if o.maxRows > 0 {
+		opts = append(opts, parquet.MaxRowsPerRowGroup(o.maxRows))
+	}
+	for k, v := range o.keyValue {
+		opts = append(opts, parquet.KeyValueMetadata(k, v))
+	}
+	if o.bloom != "" {
+		opts = append(opts, parquet.BloomFilters(parquet.SplitBlockFilter(10, strings.Split(o.bloom, ".")...)))
+	}
+	if o.dictMaxBytes > 0 {
+		opts = append(opts, parquet.DictionaryMaxBytes(o.dictMaxBytes))
+	}
+	return opts
+}
+
+func (o fileOptions) String() string {
+	return fmt.Sprintf("comp=%q v%d pagebuf=%d writebuf=%d pagestats=%v maxrows=%d kv=%v bloom=%q dictmax=%d", o.comp, o.pageVersion, o.pageBuffer, o.writeBuffer, o.pageStats, o.maxRows, o.keyValue, o.bloom, o.dictMaxBytes)
+}
+
+func (o fileOptions) GoString() string { return o.String() }
+
+// ---------------------------------------------------------------------------
+// Cases of the properties over parquet-go's own files.
+
+// batch is how one Write call of writeGeneric takes rows: size rows (all
+// that are left when 0; taken modulo what is left otherwise) and a Flush
+// after it.
+type batch struct {
+	size  int
+	flush bool
+}
+
+var batches = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) batch {
+	return batch{size: hegel.Draw(tc, hegel.Integers(0, 11)), flush: hegel.Draw(tc, chance(30))}
+})).MaxSize(3)
+
+// goCase is a schema, its rows, parquet-go's writer options and the batches
+// the rows are written in.
+type goCase struct {
+	spec    fieldSpec
+	rows    []reflect.Value
+	fo      fileOptions
+	batches []batch
+}
+
+func (c goCase) typ() reflect.Type { return baseType(c.spec) }
+
+func (c goCase) schema() *parquet.Schema {
+	return parquet.SchemaOf(reflect.New(c.typ()).Interface())
+}
+
+func (c goCase) String() string {
+	long := ""
+	if c.spec.longStrings {
+		long = " of long strings"
+	}
+	return fmt.Sprintf("schema %s, %d rows%s, %s", c.spec, len(c.rows), long, c.fo)
+}
+
+func (c goCase) GoString() string { return c.String() }
+
+// longStringCases: three cases in a hundred write strings of thousands of
+// characters (pages of kilobytes).
+var longStringCases = chance(3)
+
+// goCasesOf is a case over a schema of the tower with as many rows as
+// counts says.
+func goCasesOf(tower hegel.Generator[fieldSpec], counts hegel.Generator[int]) hegel.Generator[goCase] {
+	schemas := hegel.Composite(func(tc hegel.TestCase) fieldSpec {
+		spec := hegel.Draw(tc, tower)
