+package hegel
+
+// Generators: a schema spec, the reflect-built Go struct type for it (with
+// parquet struct tags), random rows of that type, the canonical form of a
+// row shared with the oracle, and the writer options of a file.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kBool kind = iota
+	kInt8
+	kInt16
+	kInt32
+	kInt64
+	kUint8
+	kUint16
+	kUint32
+	kUint64
+	kFloat
+	kDouble
+	kString
+	kBytes
+	kFixed
+	kUUID
+	kJSON
+	kEnum
+	kDec32
+	kDec64
+	kDecFixed
+	kDate
+	kTimeMs
+	kTimeUs
+	kTimeNs
+	kTsMs
+	kTsUs
+	kTsNs
+	kGroup
+)
+
+var kindNames = [...]string{"bool", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float", "double", "string", "bytes", "fixed", "uuid", "json", "enum", "decimal32", "decimal64", "decimalfixed", "date", "time_ms", "time_us", "time_ns", "ts_ms", "ts_us", "ts_ns", "group"}
+
+func (k kind) String() string { return kindNames[k] }
+
+// scalarKinds are the leaf kinds; mapValueKinds the ones used as map values.
+var scalarKinds = []kind{kBool, kInt8, kInt16, kInt32, kInt64, kUint8, kUint16, kUint32, kUint64, kFloat, kDouble, kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDec32, kDec64, kDecFixed, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs}
+var mapValueKinds = []kind{kBool, kInt32, kInt64, kDouble, kString, kBytes}
+
+// fieldSpec describes one field of a schema.
+type fieldSpec struct {
+	name         string
+	kind         kind
+	optional     bool   // a pointer in Go, nullable in parquet
+	rep          string // "", "repeated" (bare slice) or "list" (LIST logical type)
+	elemOptional bool   // list elements are pointers
+	isMap        bool   // map[string]kind
+	fixedLen     int    // for kFixed, kDecFixed
+	scale        int    // decimals
+	precision    int
+	utc          bool // timestamps
+	enc          string
+	comp         string
+	fields       []fieldSpec // kGroup
+}
+
+func (f fieldSpec) String() string {
+	var b strings.Builder
+	b.WriteString(f.name + ":")
+	if f.optional {
+		b.WriteString("?")
+	}
+	if f.rep != "" {
+		b.WriteString(f.rep + "<")
+		if f.elemOptional {
+			b.WriteString("?")
+		}
+	}
+	if f.isMap {
+		b.WriteString("map<string,")
+	}
+	if f.kind == kGroup {
+		parts := make([]string, len(f.fields))
+		for i, s := range f.fields {
+			parts[i] = s.String()
+		}
+		b.WriteString("{" + strings.Join(parts, " ") + "}")
+	} else {
+		b.WriteString(f.kind.String())
+	}
+	switch f.kind {
+	case kFixed, kDecFixed:
+		fmt.Fprintf(&b, "(%d)", f.fixedLen)
+	}
+	switch f.kind {
+	case kDec32, kDec64, kDecFixed:
+		fmt.Fprintf(&b, "[%d.%d]", f.precision, f.scale)
+	case kTsMs, kTsUs, kTsNs:
+		if f.utc {
+			b.WriteString("[utc]")
+		} else {
+			b.WriteString("[local]")
+		}
+	}
+	if f.rep != "" || f.isMap {
+		b.WriteString(">")
+	}
+	if f.enc != "" {
+		b.WriteString("," + f.enc)
+	}
+	if f.comp != "" {
+		b.WriteString("," + f.comp)
+	}
+	return b.String()
+}
+
+// genSchema draws a top-level schema: a group of 1..6 fields.
+func genSchema(tc hegel.TestCase) fieldSpec {
+	return genGroup(tc, "root", 0)
+}
+
+func genGroup(tc hegel.TestCase, name string, depth int) fieldSpec {
+	g := fieldSpec{name: name, kind: kGroup}
+	nf := n(tc, 1, 6)
+	if depth > 0 {
+		nf = n(tc, 1, 3)
+	}
+	for i := 0; i < nf; i++ {
+		g.fields = append(g.fields, genField(tc, fmt.Sprintf("%s%d", pick(tc, "c", "col", "x", "Val", "f_"), i), depth))
+	}
+	return g
+}
+
+func genField(tc hegel.TestCase, name string, depth int) fieldSpec {
+	f := fieldSpec{name: name}
+	switch {
+	case depth < 2 && chance(tc, 15):
+		f = genGroup(tc, name, depth+1)
+	case chance(tc, 8):
+		f.isMap = true
+		f.kind = pick(tc, mapValueKinds...)
+	default:
+		f.kind = pick(tc, scalarKinds...)
+	}
+	switch f.kind {
+	case kFixed:
+		f.fixedLen = n(tc, 1, 20)
+	case kDecFixed:
+		f.fixedLen = n(tc, 1, 15)
+		// The largest precision whose values all fit in fixedLen signed bytes.
+		f.precision = int(math.Floor(float64(8*f.fixedLen-1) * math.Log10(2)))
+		if f.precision > 38 {
+			f.precision = 38
+		}
+		f.scale = n(tc, 0, f.precision)
+	case kDec32:
+		f.precision = n(tc, 1, 9)
+		f.scale = n(tc, 0, f.precision)
+	case kDec64:
+		f.precision = n(tc, 1, 18)
+		f.scale = n(tc, 0, f.precision)
+	case kTsMs, kTsUs, kTsNs:
+		f.utc = chance(tc, 50)
+	}
+	if !f.isMap {
+		switch n(tc, 1, 10) {
+		case 1, 2, 3:
+			f.optional = true
+		case 4:
+			f.rep = "repeated"
+		case 5, 6:
+			f.rep = "list"
+			f.elemOptional = chance(tc, 50)
+		}
+		if f.kind == kGroup && f.rep == "repeated" && chance(tc, 50) {
+			f.rep = "list"
+		}
+	}
+	// The tags parquet-go accepts depend on the Go shape: logical-type tags
+	// are refused on bare slices; on pointers enum, time and uuid are refused
+	// and json loses the optionality (see the notes); delta is refused on
+	// both.
+	pointer := f.optional || f.elemOptional
+	if f.kind != kGroup && !f.isMap && (f.rep == "repeated" || pointer) {
+		bad := map[kind]bool{kEnum: true, kTimeMs: true, kTimeUs: true, kTimeNs: true, kUUID: true, kJSON: true}
+		if f.rep == "repeated" {
+			for _, k := range []kind{kDec32, kDec64, kDecFixed, kDate, kTsMs, kTsUs, kTsNs} {
+				bad[k] = true
+			}
+		}
+		if bad[f.kind] {
+			f.kind = pick(tc, kInt32, kInt64, kString, kBytes, kFixed, kDouble)
+			f.fixedLen = n(tc, 1, 20)
+		}
+	}
+	if f.rep != "" && f.kind == kUint8 {
+		f.kind = kUint16 // []uint8 is []byte to Go and to parquet-go: a byte array, not a list
+	}
+	if f.kind != kGroup && !f.isMap && chance(tc, 40) {
+		encs := []string{"plain", "dict", "delta"}
+		switch f.kind {
+		case kBool:
+			encs = []string{"plain", "dict"}
+		case kFloat, kDouble:
+			encs = []string{"plain", "dict", "split"}
+		}
+		if f.rep == "repeated" || pointer {
+			encs = encs[:2]
+		}
+		f.enc = pick(tc, encs...)
+	}
+	if f.kind != kGroup && !f.isMap && chance(tc, 30) {
+		f.comp = pick(tc, "snappy", "gzip", "zstd", "lz4", "brotli", "uncompressed")
+	}
+	return f
+}
+
+// baseType is the Go type of one value of the field (without pointer, slice
+// or map).
+func baseType(f fieldSpec) reflect.Type {
+	switch f.kind {
+	case kBool:
+		return reflect.TypeOf(false)
+	case kInt8:
+		return reflect.TypeOf(int8(0))
+	case kInt16:
+		return reflect.TypeOf(int16(0))
+	case kInt32, kDec32, kDate, kTimeMs:
+		return reflect.TypeOf(int32(0))
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return reflect.TypeOf(int64(0))
+	case kUint8:
+		return reflect.TypeOf(uint8(0))
+	case kUint16:
+		return reflect.TypeOf(uint16(0))
+	case kUint32:
+		return reflect.TypeOf(uint32(0))
+	case kUint64:
+		return reflect.TypeOf(uint64(0))
+	case kFloat:
+		return reflect.TypeOf(float32(0))
+	case kDouble:
+		return reflect.TypeOf(float64(0))
+	case kString, kJSON, kEnum:
+		return reflect.TypeOf("")
+	case kBytes:
+		return reflect.TypeOf([]byte(nil))
+	case kFixed, kDecFixed:
+		return reflect.ArrayOf(f.fixedLen, reflect.TypeOf(byte(0)))
+	case kUUID:
+		return reflect.ArrayOf(16, reflect.TypeOf(byte(0)))
+	case kGroup:
+		fields := make([]reflect.StructField, len(f.fields))
+		for i, s := range f.fields {
+			fields[i] = reflect.StructField{Name: fmt.Sprintf("F%d", i), Type: goType(s), Tag: reflect.StructTag(tagOf(s))}
+		}
+		return reflect.StructOf(fields)
+	}
+	panic("unknown kind")
+}
+
+// goType is the Go type of the field as a struct member.
+func goType(f fieldSpec) reflect.Type {
+	t := baseType(f)
+	if f.isMap {
+		return reflect.MapOf(reflect.TypeOf(""), t)
+	}
+	if f.rep != "" {
+		if f.elemOptional {
+			t = reflect.PointerTo(t)
+		}
+		return reflect.SliceOf(t)
+	}
+	if f.optional {
+		return reflect.PointerTo(t)
+	}
+	return t
+}
+
+// logicalTags are the tags of the field's logical type.
+func logicalTags(f fieldSpec) []string {
+	switch f.kind {
+	case kEnum:
+		return []string{"enum"}
+	case kJSON:
+		return []string{"json"}
+	case kUUID:
+		return []string{"uuid"}
+	case kDec32, kDec64, kDecFixed:
+		return []string{fmt.Sprintf("decimal(%d:%d)", f.scale, f.precision)}
+	case kDate:
+		return []string{"date"}
+	case kTimeMs:
+		return []string{"time(millisecond)"}
+	case kTimeUs:
+		return []string{"time(microsecond)"}
+	case kTimeNs:
+		return []string{"time(nanosecond)"}
+	case kTsMs, kTsUs, kTsNs:
+		unit := map[kind]string{kTsMs: "millisecond", kTsUs: "microsecond", kTsNs: "nanosecond"}[f.kind]
+		adj := "local"
+		if f.utc {
+			adj = "utc"
+		}
+		return []string{fmt.Sprintf("timestamp(%s:%s)", unit, adj)}
+	}
+	return nil
+}
+
+// tagOf is the parquet struct tag of the field: for a LIST the logical type,
+// encoding and compression go on the element.
+func tagOf(f fieldSpec) string {
+	leaf := logicalTags(f)
+	if f.enc != "" {
+		leaf = append(leaf, f.enc)
+	}
+	if f.comp != "" {
+		leaf = append(leaf, f.comp)
+	}
+	if f.rep == "list" {
+		tag := fmt.Sprintf(`parquet:"%s,list"`, f.name)
+		if len(leaf) > 0 {
+			tag += fmt.Sprintf(` parquet-element:",%s"`, strings.Join(leaf, ","))
+		}
+		return tag
+	}
+	return fmt.Sprintf(`parquet:"%s"`, strings.Join(append([]string{f.name}, leaf...), ","))
+}
+
+// ---------------------------------------------------------------------------
+// Values.
+
+func genRows(tc hegel.TestCase, schema fieldSpec, typ reflect.Type) []reflect.Value {
+	nr := pick(tc, 0, 1, 2, n(tc, 1, 12), n(tc, 1, 60))
+	rows := make([]reflect.Value, nr)
+	for i := range rows {
+		rows[i] = genBase(tc, schema)
+	}
+	return rows
+}
+
+// genValue draws a value of goType(f).
+func genValue(tc hegel.TestCase, f fieldSpec) reflect.Value {
+	if f.isMap {
+		m := reflect.MakeMap(goType(f))
+		for i, k := 0, n(tc, 0, 4); i < k; i++ {
+			m.SetMapIndex(reflect.ValueOf(genString(tc)), genBase(tc, f))
+		}
+		return m
+	}
+	if f.rep != "" {
+		l := pick(tc, 0, 1, n(tc, 0, 5))
+		s := reflect.MakeSlice(goType(f), l, l)
+		for i := 0; i < l; i++ {
+			if f.elemOptional {
+				if chance(tc, 30) {
+					continue
+				}
+				p := reflect.New(baseType(f))
+				p.Elem().Set(genBase(tc, f))
+				s.Index(i).Set(p)
+			} else {
+				s.Index(i).Set(genBase(tc, f))
+			}
+		}
+		return s
+	}
+	if f.optional {
+		if chance(tc, 30) {
+			return reflect.Zero(goType(f))
+		}
+		p := reflect.New(baseType(f))
+		p.Elem().Set(genBase(tc, f))
+		return p
+	}
+	return genBase(tc, f)
+}
+
+func genInt64(tc hegel.TestCase, bits int) int64 {
+	switch n(tc, 1, 6) {
+	case 1:
+		return 0
+	case 2:
+		return int64(n(tc, -100, 100))
+	case 3:
+		return math.MaxInt64 >> (64 - bits)
+	case 4:
+		return math.MinInt64 >> (64 - bits)
+	case 5:
+		return int64(n(tc, -1000000, 1000000))
+	}
+	hi := uint64(n(tc, 0, math.MaxInt32))
+	lo := uint64(n(tc, 0, math.MaxInt32))
+	v := int64(hi<<33 ^ lo<<1 ^ uint64(n(tc, 0, 1)))
+	return v >> (64 - bits)
+}
+
+func genUint64(tc hegel.TestCase, bits int) uint64 {
+	switch n(tc, 1, 5) {
+	case 1:
+		return 0
+	case 2:
+		return uint64(n(tc, 0, 200))
+	case 3:
+		return math.MaxUint64 >> (64 - bits)
+	case 4:
+		return (uint64(1) << (bits - 1)) + uint64(n(tc, 0, 3))
+	}
+	hi := uint64(n(tc, 0, math.MaxInt32))
+	lo := uint64(n(tc, 0, math.MaxInt32))
+	return (hi<<33 ^ lo<<1 ^ uint64(n(tc, 0, 1))) >> (64 - bits)
+}
+
+func genFloat64(tc hegel.TestCase) float64 {
+	switch n(tc, 1, 10) {
+	case 1:
+		return 0
+	case 2:
+		return math.Copysign(0, -1)
+	case 3:
+		return math.NaN()
+	case 4:
+		return math.Inf(1)
+	case 5:
+		return math.Inf(-1)
+	case 6:
+		return math.MaxFloat64
+	case 7:
+		return math.SmallestNonzeroFloat64
+	case 8:
+		return float64(n(tc, -1000, 1000)) / 8
+	}
+	return math.Float64frombits(uint64(n(tc, 0, math.MaxInt32))<<32 | uint64(n(tc, 0, math.MaxInt32)))
+}
+
+func genFloat32(tc hegel.TestCase) float32 {
+	switch n(tc, 1, 10) {
+	case 1:
+		return 0
+	case 2:
+		return float32(math.Copysign(0, -1))
+	case 3:
+		return float32(math.NaN())
+	case 4:
+		return float32(math.Inf(1))
+	case 5:
+		return float32(math.Inf(-1))
+	case 6:
+		return math.MaxFloat32
+	case 7:
+		return math.SmallestNonzeroFloat32
+	case 8:
+		return float32(n(tc, -1000, 1000)) / 8
+	}
+	return math.Float32frombits(uint32(n(tc, 0, math.MaxInt32))<<1 | uint32(n(tc, 0, 1)))
+}
+
+var alphabet = []string{"a", "b", "z", "A", "0", "9", " ", "_", "-", ".", "\u00e9", "\u65e5", "\U0001F600", "\u00a0", "\"", "\\", "\n", "\x00"}
+
+func genString(tc hegel.TestCase) string {
+	l := pick(tc, 0, 1, n(tc, 0, 12), n(tc, 20, 60))
+	var b strings.Builder
+	for i := 0; i < l; i++ {
+		b.WriteString(pick(tc, alphabet...))
+	}
+	return b.String()
+}
+
+func genBytes(tc hegel.TestCase, l int) []byte {
+	b := make([]byte, l)
+	for i := range b {
+		b[i] = byte(pick(tc, 0, 1, 0x7f, 0x80, 0xff, n(tc, 0, 255)))
+	}
+	return b
+}
+
+// genDecimalBytes draws an unscaled decimal of at most precision digits as a
+// big-endian two's complement value of l bytes.
+func genDecimalBytes(tc hegel.TestCase, l, precision int) []byte {
+	limit := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(precision)), nil)
+	var v *big.Int
+	switch n(tc, 1, 4) {
+	case 1:
+		v = big.NewInt(int64(n(tc, -100, 100)))
+	case 2:
+		v = new(big.Int).Sub(limit, big.NewInt(1))
+		if chance(tc, 50) {
+			v.Neg(v)
+		}
+	default:
+		v = big.NewInt(0)
+		for i := 0; i < l; i++ {
+			v.Lsh(v, 8)
+			v.Or(v, big.NewInt(int64(n(tc, 0, 255))))
+		}
+		v.Mod(v, limit)
+		if chance(tc, 50) {
+			v.Neg(v)
+		}
+	}
+	// two's complement, l bytes
+	mod := new(big.Int).Lsh(big.NewInt(1), uint(8*l))
+	u := new(big.Int).Mod(v, mod)
+	b := u.FillBytes(make([]byte, l))
+	return b
+}
+
+func setBytes(v reflect.Value, b []byte) {
+	reflect.Copy(v, reflect.ValueOf(b))
+}
+
+// genBase draws one value of baseType(f).
+func genBase(tc hegel.TestCase, f fieldSpec) reflect.Value {
+	t := baseType(f)
+	switch f.kind {
+	case kBool:
+		return reflect.ValueOf(chance(tc, 50))
+	case kInt8:
+		return reflect.ValueOf(int8(genInt64(tc, 8)))
+	case kInt16:
+		return reflect.ValueOf(int16(genInt64(tc, 16)))
+	case kInt32, kDate:
+		return reflect.ValueOf(int32(genInt64(tc, 32)))
+	case kInt64, kTsMs, kTsUs, kTsNs:
+		return reflect.ValueOf(genInt64(tc, 64))
+	case kTimeMs:
+		return reflect.ValueOf(int32(pick(tc, 0, 86399999, n(tc, 0, 86399999))))
+	case kTimeUs:
+		return reflect.ValueOf(int64(pick(tc, 0, 86399999999, n(tc, 0, 86399999999))))
+	case kTimeNs:
+		return reflect.ValueOf(int64(pick(tc, 0, 86399999999999, n(tc, 0, 86399999999999))))
+	case kUint8:
+		return reflect.ValueOf(uint8(genUint64(tc, 8)))
+	case kUint16:
+		return reflect.ValueOf(uint16(genUint64(tc, 16)))
+	case kUint32:
+		return reflect.ValueOf(uint32(genUint64(tc, 32)))
+	case kUint64:
+		return reflect.ValueOf(genUint64(tc, 64))
+	case kFloat:
+		return reflect.ValueOf(genFloat32(tc))
+	case kDouble:
+		return reflect.ValueOf(genFloat64(tc))
+	case kString, kEnum:
+		return reflect.ValueOf(genString(tc))
+	case kJSON:
+		return reflect.ValueOf(pick(tc, `{}`, `[]`, `{"a":1}`, `"`+genString(tc)+`"`, `null`, strconv.Itoa(n(tc, -5, 5))))
+	case kBytes:
+		return reflect.ValueOf(genBytes(tc, pick(tc, 0, 1, n(tc, 0, 12), n(tc, 20, 50))))
+	case kFixed, kUUID:
+		v := reflect.New(t).Elem()
+		setBytes(v, genBytes(tc, t.Len()))
+		return v
+	case kDec32:
+		limit := int64(math.Pow10(f.precision))
+		return reflect.ValueOf(int32(genInt64(tc, 32) % limit))
+	case kDec64:
+		limit := int64(math.Pow10(f.precision))
+		return reflect.ValueOf(genInt64(tc, 64) % limit)
+	case kDecFixed:
+		v := reflect.New(t).Elem()
+		setBytes(v, genDecimalBytes(tc, f.fixedLen, f.precision))
+		return v
+	case kGroup:
+		v := reflect.New(t).Elem()
+		for i, s := range f.fields {
+			v.Field(i).Set(genValue(tc, s))
+		}
+		return v
+	}
+	panic("unknown kind")
+}
+
+// ---------------------------------------------------------------------------
+// Canonical form (see oracle.py).
+
+func canonValue(f fieldSpec, v reflect.Value) any {
+	if f.isMap {
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return keys[i].String() < keys[j].String() })
+		pairs := make([]any, 0, len(keys))
+		for _, k := range keys {
+			pairs = append(pairs, []any{k.String(), canonBase(f, v.MapIndex(k))})
+		}
+		return pairs
+	}
+	if f.rep != "" {
+		out := make([]any, 0, v.Len())
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			if f.elemOptional {
+				if e.IsNil() {
+					out = append(out, nil)
+					continue
+				}
+				e = e.Elem()
+			}
+			out = append(out, canonBase(f, e))
+		}
+		return out
+	}
+	if f.optional {
+		if v.IsNil() {
+			return nil
+		}
+		v = v.Elem()
+	}
+	return canonBase(f, v)
+}
+
+func arrayBytes(v reflect.Value) []byte {
+	b := make([]byte, v.Len())
+	reflect.Copy(reflect.ValueOf(b), v)
+	return b
+}
+
+func canonBase(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kBool:
+		return v.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return strconv.FormatInt(v.Int(), 10)
+	case kUint8, kUint16, kUint32, kUint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case kFloat:
+		return fmt.Sprintf("f32:%08x", math.Float32bits(float32(v.Float())))
+	case kDouble:
+		return fmt.Sprintf("f64:%016x", math.Float64bits(v.Float()))
+	case kString, kJSON:
+		return v.String()
+	case kEnum:
+		return hex.EncodeToString([]byte(v.String()))
+	case kBytes:
+		return hex.EncodeToString(v.Bytes())
+	case kFixed, kUUID:
+		return hex.EncodeToString(arrayBytes(v))
+	case kDecFixed:
+		return twosComplement(arrayBytes(v)).String()
+	case kGroup:
+		m := map[string]any{}
+		for i, s := range f.fields {
+			m[s.name] = canonValue(s, v.Field(i))
+		}
+		return m
+	}
+	panic("unknown kind")
+}
+
+func twosComplement(b []byte) *big.Int {
+	v := new(big.Int).SetBytes(b)
+	if len(b) > 0 && b[0]&0x80 != 0 {
+		v.Sub(v, new(big.Int).Lsh(big.NewInt(1), uint(8*len(b))))
+	}
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Statistics truth for the flat leaves.
+
+// flatLeaf is a leaf reached through non-repeated fields only, whose
+// statistics are simple: one value or null per row.
+type flatLeaf struct {
+	path string
+	spec fieldSpec
+	get  func(row reflect.Value) (reflect.Value, bool) // value of the leaf in the row, present?
+}
+
+func flatLeaves(schema fieldSpec) []flatLeaf {
+	var out []flatLeaf
+	var walk func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool))
+	walk = func(f fieldSpec, prefix string, get func(reflect.Value) (reflect.Value, bool)) {
+		for i, s := range f.fields {
+			i, s := i, s
+			if s.rep != "" || s.isMap {
+				continue
+			}
+			sub := func(row reflect.Value) (reflect.Value, bool) {
+				g, ok := get(row)
+				if !ok {
+					return reflect.Value{}, false
+				}
+				v := g.Field(i)
+				if s.optional {
+					if v.IsNil() {
+						return reflect.Value{}, false
+					}
+					v = v.Elem()
+				}
+				return v, true
+			}
+			name := s.name
+			if prefix != "" {
+				name = prefix + "." + s.name
+			}
+			if s.kind == kGroup {
+				walk(s, name, sub)
+			} else {
+				out = append(out, flatLeaf{path: name, spec: s, get: sub})
+			}
+		}
+	}
+	walk(schema, "", func(row reflect.Value) (reflect.Value, bool) { return row, true })
+	return out
+}
+
+// statCanon is the canonical form of a value as a statistics bound (the
+// physical value; byte arrays of any logical type as hex).
+func statCanon(f fieldSpec, v reflect.Value) any {
+	switch f.kind {
+	case kString, kJSON:
+		return hex.EncodeToString([]byte(v.String()))
+	}
+	return canonBase(f, v)
+}
+
+// statLess orders values as the parquet column order of the type does;
+// NaN never takes part, -0 sorts before +0.
+func statLess(f fieldSpec, a, b reflect.Value) bool {
+	switch f.kind {
+	case kBool:
+		return !a.Bool() && b.Bool()
+	case kInt8, kInt16, kInt32, kInt64, kDec32, kDec64, kDate, kTimeMs, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return a.Int() < b.Int()
+	case kUint8, kUint16, kUint32, kUint64:
+		return a.Uint() < b.Uint()
+	case kFloat, kDouble:
+		x, y := a.Float(), b.Float()
+		if x == 0 && y == 0 {
+			return math.Signbit(x) && !math.Signbit(y)
+		}
+		return x < y
+	case kString, kJSON, kEnum:
+		return a.String() < b.String()
+	case kBytes:
+		return bytes.Compare(a.Bytes(), b.Bytes()) < 0
+	case kFixed, kUUID:
+		return bytes.Compare(arrayBytes(a), arrayBytes(b)) < 0
+	case kDecFixed:
+		return twosComplement(arrayBytes(a)).Cmp(twosComplement(arrayBytes(b))) < 0
+	}
+	panic("unknown kind")
+}
+
+func isNaN(f fieldSpec, v reflect.Value) bool {
+	return (f.kind == kFloat || f.kind == kDouble) && math.IsNaN(v.Float())
+}
+
+// ---------------------------------------------------------------------------
+// Writer options.
+
+type fileOptions struct {
+	comp           string
+	pageVersion    int
+	pageBuffer     int
+	writeBuffer    int
+	pageStats      bool
+	maxRows        int64
+	keyValue       map[string]string
+	bloom          string // path of a flat leaf with a bloom filter
+	dictMaxBytes   int64
+	skipPageBounds string
+}
+
+func genFileOptions(tc hegel.TestCase, leaves []flatLeaf) fileOptions {
+	o := fileOptions{
+		comp:        pick(tc, "", "", "snappy", "gzip", "zstd", "lz4", "brotli", "uncompressed"),
+		pageVersion: pick(tc, 1, 2, 2),
+		pageBuffer:  pick(tc, 0, 0, 128, 1024, 4096),
+		writeBuffer: pick(tc, 0, 0, 64, 1024),
+		pageStats:   chance(tc, 50),
+	}
+	if chance(tc, 40) {
+		o.maxRows = int64(n(tc, 1, 7))
+	}
+	if chance(tc, 30) {
+		o.keyValue = map[string]string{"k" + strconv.Itoa(n(tc, 0, 9)): genString(tc)}
+	}
+	if len(leaves) > 0 && chance(tc, 30) {
+		o.bloom = leaves[n(tc, 0, len(leaves)-1)].path
+	}
+	if chance(tc, 20) {
+		o.dictMaxBytes = int64(pick(tc, 1, 64, 4096))
+	}
+	return o
+}
+
+func codecOf(name string) parquet.WriterOption {
+	switch name {
+	case "snappy":
+		return parquet.Compression(&parquet.Snappy)
+	case "gzip":
+		return parquet.Compression(&parquet.Gzip)
+	case "zstd":
+		return parquet.Compression(&parquet.Zstd)
+	case "lz4":
+		return parquet.Compression(&parquet.Lz4Raw)
+	case "brotli":
+		return parquet.Compression(&parquet.Brotli)
+	case "uncompressed":
+		return parquet.Compression(&parquet.Uncompressed)
+	}
+	return nil
+}
+
+// compressionName is the name pyarrow reports for a codec tag.
+func compressionName(tag string) string {
+	switch tag {
+	case "snappy":
+		return "SNAPPY"
+	case "gzip":
+		return "GZIP"
+	case "zstd":
+		return "ZSTD"
+	case "lz4":
+		return "LZ4" // pyarrow's name for LZ4_RAW (its LZ4_HADOOP is the deprecated codec)
+	case "brotli":
+		return "BROTLI"
+	case "uncompressed", "":
+		return "UNCOMPRESSED"
+	}
+	return "?"
+}
+
+func (o fileOptions) writerOptions(schema *parquet.Schema) []parquet.WriterOption {
+	opts := []parquet.WriterOption{schema, parquet.DataPageVersion(o.pageVersion), parquet.DataPageStatistics(o.pageStats)}
+	if c := codecOf(o.comp); c != nil {
+		opts = append(opts, c)
+	}
+	if o.pageBuffer > 0 {
+		opts = append(opts, parquet.PageBufferSize(o.pageBuffer))
+	}
+	if o.writeBuffer > 0 {
+		opts = append(opts, parquet.WriteBufferSize(o.writeBuffer))
+	}
+	if o.maxRows > 0 {
+		opts = append(opts, parquet.MaxRowsPerRowGroup(o.maxRows))
+	}
+	for k, v := range o.keyValue {
+		opts = append(opts, parquet.KeyValueMetadata(k, v))
+	}
+	if o.bloom != "" {
+		opts = append(opts, parquet.BloomFilters(parquet.SplitBlockFilter(10, strings.Split(o.bloom, ".")...)))
+	}
+	if o.dictMaxBytes > 0 {
+		opts = append(opts, parquet.DictionaryMaxBytes(o.dictMaxBytes))
+	}
+	return opts
+}
+
+func (o fileOptions) String() string {
+	return fmt.Sprintf("comp=%q v%d pagebuf=%d writebuf=%d pagestats=%v maxrows=%d kv=%v bloom=%q dictmax=%d", o.comp, o.pageVersion, o.pageBuffer, o.writeBuffer, o.pageStats, o.maxRows, o.keyValue, o.bloom, o.dictMaxBytes)
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..fc95bee
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,245 @@
+package hegel
+
+// Pins: one plain test per open bug in the zoo's bugs.toml, failing while the
+// bug is open so that a fix upstream is noticed.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+)
+
+// parquet-go/4: floating-point column statistics deviate from the rules of
+// the format's TypeDefinedOrder (parquet.thrift): a zero minimum should be
+// written as -0.0 and a zero maximum as +0.0, but parquet-go keeps the zero
+// it met first ({+0, -0}: min +0; {-0, +0}: max -0); and when every value
+// is NaN, min and max must not be written, but parquet-go writes NaN.
+func TestHegelPinFloatStatisticsFollowTheSpec(t *testing.T) {
+	type F struct {
+		A float64 `parquet:"a"`
+	}
+	minMax := func(rows []F) (minBits, maxBits uint64, has bool) {
+		var buf bytes.Buffer
+		if err := parquet.Write[F](&buf, rows); err != nil {
+			t.Fatal(err)
+		}
+		f, err := parquet.OpenFile(bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		st := f.Metadata().RowGroups[0].Columns[0].MetaData.Statistics
+		if len(st.MinValue) != 8 || len(st.MaxValue) != 8 {
+			return 0, 0, false
+		}
+		return binary.LittleEndian.Uint64(st.MinValue), binary.LittleEndian.Uint64(st.MaxValue), true
+	}
+	negZero := math.Float64bits(math.Copysign(0, -1))
+	if mn, mx, has := minMax([]F{{0}, {math.Copysign(0, -1)}}); !has || mn != negZero || mx != 0 {
+		t.Errorf("values {+0, -0}: min %x max %x (has %v), want min -0.0 (%x) and max +0.0 (0)", mn, mx, has, negZero)
+	}
+	if mn, mx, has := minMax([]F{{math.Copysign(0, -1)}, {0}}); !has || mn != negZero || mx != 0 {
+		t.Errorf("values {-0, +0}: min %x max %x (has %v), want min -0.0 (%x) and max +0.0 (0)", mn, mx, has, negZero)
+	}
+	if mn, mx, has := minMax([]F{{math.NaN()}, {math.NaN()}}); has {
+		t.Errorf("values {NaN, NaN}: min %x max %x written, want no min/max", mn, mx)
+	}
+}
+
+// parquet-go/7: the statistics of a dictionary-encoded FLOAT or DOUBLE
+// column holding a NaN are wrong: {-1, NaN, 1} gets min 1 and max 1, {NaN,
+// 1, -1} gets max NaN; the plain-encoded column gets min -1, max 1.
+func TestHegelPinDictionaryFloatStatistics(t *testing.T) {
+	type D struct {
+		A float64 `parquet:"a,dict"`
+	}
+	bounds := func(rows []D) (min, max float64) {
+		var buf bytes.Buffer
+		if err := parquet.Write[D](&buf, rows); err != nil {
+			t.Fatal(err)
+		}
+		f, err := parquet.OpenFile(bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		st := f.Metadata().RowGroups[0].Columns[0].MetaData.Statistics
+		if len(st.MinValue) != 8 || len(st.MaxValue) != 8 {
+			t.Fatalf("no min/max written: %x %x", st.MinValue, st.MaxValue)
+		}
+		return math.Float64frombits(binary.LittleEndian.Uint64(st.MinValue)), math.Float64frombits(binary.LittleEndian.Uint64(st.MaxValue))
+	}
+	if mn, mx := bounds([]D{{-1}, {math.NaN()}, {1}}); mn != -1 || mx != 1 {
+		t.Errorf("dictionary-encoded {-1, NaN, 1}: min %v max %v, want -1 and 1", mn, mx)
+	}
+	if mn, mx := bounds([]D{{math.NaN()}, {1}, {-1}}); mn != -1 || mx != 1 {
+		t.Errorf("dictionary-encoded {NaN, 1, -1}: min %v max %v, want -1 and 1", mn, mx)
+	}
+}
+
+// parquet-go/5: reading a file into a Go struct with a [N]byte field the
+// file has no column for (the ordinary schema-evolution case, which
+// parquet-go otherwise handles by filling the column with nulls) panics
+// with "reflect.Set: value of type []uint8 is not assignable to type
+// [7]uint8" in fixedLenByteArrayType.AssignValue, through Read,
+// GenericReader and Reader alike.
+func TestHegelPinMissingFixedColumnReads(t *testing.T) {
+	type W struct {
+		A int32   `parquet:"a"`
+		B [7]byte `parquet:"b"`
+	}
+	type V struct {
+		A int32   `parquet:"a"`
+		C [7]byte `parquet:"c"`
+	}
+	var buf bytes.Buffer
+	if err := parquet.Write[W](&buf, []W{{A: 1, B: [7]byte{1, 2, 3, 4, 5, 6, 7}}}); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("reading a file without column c into a struct with a [7]byte c panics: %v", r)
+		}
+	}()
+	rows, err := parquet.Read[V](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	t.Logf("Read[V]: %v, %v", rows, err)
+}
+
+// corruptedV2 is a 1509-byte file parquet-go wrote (v2 data pages, zstd and
+// gzip columns, a MAP) with a few bytes damaged by the zoo's fuzzing;
+// OpenFile accepts it and reading its rows panics.
+const corruptedV2 = ""
+
+// parquet-go/6: a damaged v2 data page whose header's level lengths do not
+// fit the page makes reading the rows panic in decodeLevelsV2 ("slice
+// bounds out of range [1092:140]") instead of returning an error; OpenFile
+// accepts the file.
+func TestHegelPinCorruptedPageErrorsNotPanics(t *testing.T) {
+	data, err := base64.StdEncoding.DecodeString(corruptedV2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Skipf("OpenFile rejects the file (fine): %v", err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("reading the rows of the corrupted file panics: %v", r)
+		}
+	}()
+	rows := f.RowGroups()[0].Rows()
+	defer rows.Close()
+	buf := make([]parquet.Row, 4)
+	for {
+		k, err := rows.ReadRows(buf)
+		if err != nil {
+			t.Logf("ReadRows returns %v (fine)", err)
+			return
+		}
+		if k == 0 {
+			return
+		}
+	}
+}
+
+// parquet-go/1: Schema.Deconstruct - and so the deprecated Writer, whose
+// documentation says GenericWriter[any] behaves the same - mishandles the
+// optional elements of a LIST: pointer elements ([]*float64) make it panic
+// ("cannot create parquet value of type DOUBLE from go value of type
+// *float64"), and non-pointer elements tagged optional are written with a
+// definition level that reads back as null. GenericWriter writes both right.
+func TestHegelPinDeconstructOptionalListElements(t *testing.T) {
+	type P struct {
+		A []*float64 `parquet:"a,list"`
+	}
+	type Q struct {
+		A []string `parquet:"a,list" parquet-element:",optional"`
+	}
+	f := 1.5
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Errorf("Schema.Deconstruct of a []*float64 list panics: %v", r)
+			}
+		}()
+		s := parquet.SchemaOf(P{})
+		row := s.Deconstruct(nil, P{A: []*float64{&f, nil}})
+		t.Logf("Deconstruct: %v", row)
+	}()
+	var buf bytes.Buffer
+	w := parquet.NewWriter(&buf)
+	if err := w.Write(Q{A: []string{"x", "yy"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	back, err := parquet.Read[Q](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fmt.Sprint(back) != fmt.Sprint([]Q{{A: []string{"x", "yy"}}}) {
+		t.Errorf("Writer.Write of %v reads back as %v", []Q{{A: []string{"x", "yy"}}}, back)
+	}
+}
+
+// parquet-go/2: SchemaOf accepts a [N]byte field whose decimal precision
+// needs more than N bytes ([8]byte with decimal(0:19) -> a
+// fixed_len_byte_array(8) DECIMAL(19,0) column, invalid since 10^19-1 needs
+// 9 bytes) instead of rejecting the tag as it rejects other invalid tag
+// combinations, and writing a row then panics deep in the column buffer
+// ("cannot write byte array of length 8 to fixed length byte array column of
+// size 9"; [15]byte with decimal(0:36): "cannot write 15 bytes to [16]byte
+// column").
+func TestHegelPinDecimalPrecisionFitsFixedLength(t *testing.T) {
+	type D struct {
+		A [8]byte `parquet:"a,decimal(0:19)"`
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("writing a [8]byte decimal(0:19) panics: %v", r)
+		}
+	}()
+	schema := parquet.SchemaOf(D{})
+	t.Logf("SchemaOf accepted:\n%s", schema)
+	var buf bytes.Buffer
+	if err := parquet.Write[D](&buf, []D{{A: [8]byte{1, 2, 3, 4, 5, 6, 7, 8}}}); err != nil {
+		t.Logf("Write returns an error (acceptable): %v", err)
+	}
+}
+
+// parquet-go/3: a decimal tag on a slice of integers ([]int32, []int64),
+// which the documentation lists for int32, int64, []byte and [N]byte only,
+// is not rejected: SchemaOf yields a required fixed_len_byte_array(4)
+// DECIMAL column (a byte array sized from the precision, as if the slice
+// were []byte), Write succeeds, and Read panics
+// ("reflect.Value.SetBytes of non-byte slice").
+func TestHegelPinDecimalTagOnIntSlice(t *testing.T) {
+	type D struct {
+		A []int32 `parquet:"a,decimal(2:9)"`
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("reading back a []int32 decimal panics: %v", r)
+		}
+	}()
+	schema := parquet.SchemaOf(D{})
+	t.Logf("SchemaOf gives:\n%s", schema)
+	var buf bytes.Buffer
+	if err := parquet.Write[D](&buf, []D{{A: []int32{1, 2, 3}}}); err != nil {
+		t.Logf("Write returns an error (acceptable): %v", err)
+		return
+	}
+	back, err := parquet.Read[D](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Logf("Read returns an error (acceptable): %v", err)
+		return
+	}
+	if fmt.Sprint(back) != fmt.Sprint([]D{{A: []int32{1, 2, 3}}}) {
+		t.Errorf("[]int32 decimal reads back as %v", back)
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..d319f12
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,510 @@
+package hegel
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime/debug"
+	"strings"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+func jsonString(v any) string {
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+// writeGeneric writes the rows through GenericWriter[any], in a few batches
+// with an occasional Flush between them, and returns the file.
+func writeGeneric(tc hegel.TestCase, rows []reflect.Value, opts []parquet.WriterOption) ([]byte, error) {
+	var buf bytes.Buffer
+	w := parquet.NewGenericWriter[any](&buf, opts...)
+	vals := make([]any, len(rows))
+	for i, r := range rows {
+		vals[i] = r.Interface()
+	}
+	for len(vals) > 0 {
+		k := len(vals)
+		if chance(tc, 40) {
+			k = n(tc, 1, len(vals))
+		}
+		if _, err := w.Write(vals[:k]); err != nil {
+			return nil, err
+		}
+		vals = vals[k:]
+		if len(vals) > 0 && chance(tc, 30) {
+			if err := w.Flush(); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// leafPaths maps the parquet column paths of the schema to their specs.
+func leafPaths(f fieldSpec, prefix string, out map[string]fieldSpec) {
+	for _, s := range f.fields {
+		p := s.name
+		if prefix != "" {
+			p = prefix + "." + s.name
+		}
+		switch {
+		case s.isMap:
+			out[p+".key_value.key"] = fieldSpec{name: "key", kind: kString, comp: s.comp}
+			out[p+".key_value.value"] = fieldSpec{name: "value", kind: s.kind, comp: s.comp, enc: s.enc}
+		case s.rep == "list":
+			if s.kind == kGroup {
+				leafPaths(s, p+".list.element", out)
+			} else {
+				out[p+".list.element"] = s
+			}
+		case s.kind == kGroup:
+			leafPaths(s, p, out)
+		default:
+			out[p] = s
+		}
+	}
+}
+
+// encodingNames are what pyarrow reports for an encoding tag on a kind.
+func encodingNames(f fieldSpec) []string {
+	switch f.enc {
+	case "plain":
+		return []string{"PLAIN"}
+	case "dict":
+		return []string{"RLE_DICTIONARY", "PLAIN_DICTIONARY"}
+	case "split":
+		return []string{"BYTE_STREAM_SPLIT"}
+	case "delta":
+		switch f.kind {
+		case kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDecFixed:
+			return []string{"DELTA_BYTE_ARRAY", "DELTA_LENGTH_BYTE_ARRAY"}
+		default:
+			return []string{"DELTA_BINARY_PACKED"}
+		}
+	}
+	return nil
+}
+
+func contains(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func isByteKind(k kind) bool {
+	switch k {
+	case kString, kBytes, kFixed, kUUID, kJSON, kEnum:
+		return true
+	}
+	return false
+}
+
+// checkMetadata compares what pyarrow reports about the file with the rows
+// and options it was written from.
+func checkMetadata(ht *hegel.T, desc string, spec fieldSpec, rows []reflect.Value, fo fileOptions, py pyFile) {
+	for k, v := range fo.keyValue {
+		if py.keyValue[k] != v {
+			fail(ht, "%s: key/value metadata %q = %q, want %q", desc, k, py.keyValue[k], v)
+		}
+	}
+	paths := map[string]fieldSpec{}
+	leafPaths(spec, "", paths)
+	flat := map[string]flatLeaf{}
+	for _, l := range flatLeaves(spec) {
+		flat[l.path] = l
+	}
+	var total int64
+	for gi, g := range py.rowGroups {
+		if fo.maxRows > 0 && g.numRows > fo.maxRows {
+			fail(ht, "%s: row group %d has %d rows, more than MaxRowsPerRowGroup(%d)", desc, gi, g.numRows, fo.maxRows)
+		}
+		if total+g.numRows > int64(len(rows)) {
+			fail(ht, "%s: row groups hold more rows (%d+) than were written (%d)", desc, total+g.numRows, len(rows))
+		}
+		groupRows := rows[total : total+g.numRows]
+		total += g.numRows
+		for _, col := range g.columns {
+			leaf, known := paths[col.path]
+			if !known {
+				fail(ht, "%s: pyarrow reports a column %q the schema does not have (paths %v)", desc, col.path, paths)
+			}
+			// Compression: the column's own tag, else the file's codec.
+			wantComp := compressionName(fo.comp)
+			if leaf.comp != "" {
+				wantComp = compressionName(leaf.comp)
+			}
+			if col.compression != wantComp {
+				fail(ht, "%s: column %s is compressed with %s, want %s", desc, col.path, col.compression, wantComp)
+			}
+			// Encodings: the requested one is among those used.
+			if names := encodingNames(leaf); names != nil {
+				found := false
+				for _, name := range names {
+					found = found || contains(col.encodings, name)
+				}
+				if !found {
+					count(fmt.Sprintf("requested encoding %s absent on %s (%v)", leaf.enc, leaf.kind, col.encodings))
+				}
+			}
+			// Statistics of the flat leaves.
+			fl, isFlat := flat[col.path]
+			if !isFlat {
+				continue
+			}
+			if col.numValues != g.numRows {
+				fail(ht, "%s: column %s has %d values in row group %d of %d rows", desc, col.path, col.numValues, gi, g.numRows)
+			}
+			var nulls int64
+			var minV, maxV reflect.Value
+			nan := false
+			for _, row := range groupRows {
+				v, ok := fl.get(row)
+				if !ok {
+					nulls++
+					continue
+				}
+				if isNaN(fl.spec, v) {
+					nan = true
+					continue
+				}
+				if !minV.IsValid() || statLess(fl.spec, v, minV) {
+					minV = v
+				}
+				if !maxV.IsValid() || statLess(fl.spec, maxV, v) {
+					maxV = v
+				}
+			}
+			if col.hasNullCount && col.nullCount != nulls {
+				fail(ht, "%s: column %s has null_count %d in row group %d, but %d of its %d values are null", desc, col.path, col.nullCount, gi, nulls, g.numRows)
+			}
+			if !col.hasNullCount {
+				count("no null count")
+			}
+			if !minV.IsValid() {
+				switch {
+				case col.hasMinMax && nan:
+					count("known parquet-go/4 (min/max written for an all-NaN column)")
+				case col.hasMinMax:
+					count("min/max present on an all-null column")
+				}
+				continue
+			}
+			if !col.hasMinMax {
+				if nan {
+					count("no min/max with NaN present")
+				} else {
+					count("no min/max on " + fl.spec.kind.String())
+				}
+				continue
+			}
+			wantMin, wantMax := statCanon(fl.spec, minV), statCanon(fl.spec, maxV)
+			for _, b := range []struct {
+				what      string
+				got, want any
+			}{{"min", col.min, wantMin}, {"max", col.max, wantMax}} {
+				if reflect.DeepEqual(b.got, b.want) {
+					continue
+				}
+				gs, _ := b.got.(string)
+				ws, _ := b.want.(string)
+				if isByteKind(fl.spec.kind) && len(gs) < len(ws) && (b.what == "min" && strings.HasPrefix(ws, gs) || b.what == "max" && gs > ws[:len(gs)]) {
+					count("truncated " + b.what)
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && isZeroBits(gs) && isZeroBits(ws) {
+					count("known parquet-go/4 (signed zero bound)")
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && nan && fl.spec.enc == "dict" {
+					count("known parquet-go/7 (dictionary float statistics with NaN)")
+					continue
+				}
+				fail(ht, "%s: column %s row group %d: %s statistic is %v, but the values' %s is %v (%d values, %d null)", desc, col.path, gi, b.what, b.got, b.what, b.want, g.numRows, nulls)
+			}
+		}
+	}
+	if total != int64(len(rows)) {
+		fail(ht, "%s: row groups hold %d rows, %d were written", desc, total, len(rows))
+	}
+}
+
+// TestHegelPyarrowReadsWhatParquetGoWrites: a file parquet-go writes for a
+// generated schema, rows and options is read by pyarrow to the value, and
+// its metadata (row groups, compression, encodings, null counts, minima and
+// maxima of the flat columns, key/value pairs) says what the rows and
+// options say.
+func TestHegelPyarrowReadsWhatParquetGoWrites(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "go.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		if err := os.WriteFile(path, data, 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the file: %s\nparquet schema:\n%s", desc, py.err, schema)
+		}
+		count(fmt.Sprintf("%d row groups", py.numRowGroups))
+		if py.numRows != int64(len(rows)) || len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows (metadata says %d), %d were written", desc, len(py.rows), py.numRows, len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d differs:\n  parquet-go wrote %s\n  pyarrow reads    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+		checkMetadata(ht, desc, spec, rows, fo, py)
+	})
+}
+
+// readReflect reads every row of the file into values of typ through the
+// reflection-based Reader.
+func readReflect(data []byte, typ reflect.Type) ([]reflect.Value, error) {
+	r := parquet.NewReader(bytes.NewReader(data))
+	defer r.Close()
+	var out []reflect.Value
+	for {
+		v := reflect.New(typ)
+		err := r.Read(v.Interface())
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return out, err
+		}
+		out = append(out, v.Elem())
+	}
+}
+
+// TestHegelReadsBackWhatItWrites: parquet-go reads its own file back to the
+// value, through the reflection Reader and through the row API.
+func TestHegelReadsBackWhatItWrites(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		back, err := readReflect(data, typ)
+		if err != nil {
+			fail(ht, "%s: reading back: %v", desc, err)
+		}
+		if len(back) != len(rows) {
+			fail(ht, "%s: %d rows read back of %d", desc, len(back), len(rows))
+		}
+		for i := range rows {
+			want, got := canonBase(spec, rows[i]), canonBase(spec, back[i])
+			if !reflect.DeepEqual(want, got) {
+				fail(ht, "%s: row %d differs:\n  written %s\n  read    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(got), schema)
+			}
+		}
+		// The row API: as many rows, each with as many values as leaves.
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			fail(ht, "%s: OpenFile: %v", desc, err)
+		}
+		if f.NumRows() != int64(len(rows)) {
+			fail(ht, "%s: OpenFile reports %d rows, %d were written", desc, f.NumRows(), len(rows))
+		}
+		var seen int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for {
+				k, err := rr.ReadRows(buf)
+				seen += int64(k)
+				if err != nil {
+					if err.Error() != "EOF" {
+						fail(ht, "%s: ReadRows: %v", desc, err)
+					}
+					break
+				}
+				if k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if seen != int64(len(rows)) {
+			fail(ht, "%s: the row API yields %d rows, %d were written", desc, seen, len(rows))
+		}
+	})
+}
+
+// TestHegelWriterPathsAgree: the deprecated Writer (whose documentation says
+// GenericWriter[any] has the same behaviour) writes the same rows to a file
+// pyarrow reads to the same values.
+func TestHegelWriterPathsAgree(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "writer.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		if len(rows) == 0 {
+			count("no rows")
+			return
+		}
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		if id := known(caseInfo{prop: "writer", spec: spec}); id != "" {
+			count("known " + id)
+			return
+		}
+		var buf bytes.Buffer
+		w := parquet.NewWriter(&buf, fo.writerOptions(schema)...)
+		for _, r := range rows {
+			if err := w.Write(r.Interface()); err != nil {
+				fail(ht, "%s: Writer.Write: %v", desc, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "%s: Writer.Close: %v", desc, err)
+		}
+		if err := os.WriteFile(path, buf.Bytes(), 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the Writer's file: %s", desc, py.err)
+		}
+		if len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows of the Writer's file, %d were written", desc, len(py.rows), len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d of the Writer's file differs:\n  written      %s\n  pyarrow reads %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+	})
+}
+
+// TestHegelDamagedFilesNeverPanic: a damaged file never makes OpenFile or
+// reading its rows panic.
+func TestHegelDamagedFilesNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		curDesc = fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "schema %s: writing: %v", spec, err)
+		}
+		damaged := damage(ht, data)
+		desc := fmt.Sprintf("schema %s, %d rows, %d bytes damaged to %d bytes", spec, len(rows), len(data), len(damaged))
+		f, err := parquet.OpenFile(bytes.NewReader(damaged), int64(len(damaged)))
+		if err != nil {
+			count("OpenFile fails")
+			return
+		}
+		count("OpenFile succeeds")
+		defer func() {
+			if r := recover(); r != nil {
+				if id := known(caseInfo{prop: "damaged", panic: fmt.Sprint(r)}); id != "" {
+					count("known " + id)
+					return
+				}
+				if dir := os.Getenv("HEGEL_DUMP"); dir != "" {
+					name := filepath.Join(dir, fmt.Sprintf("panic-%d.parquet", len(damaged)))
+					_ = os.WriteFile(name, damaged, 0o644)
+					fail(ht, "%s: reading panics: %v (file %s)\n%s", desc, r, name, debug.Stack())
+				}
+				fail(ht, "%s: reading panics: %v", desc, r)
+			}
+		}()
+		var read int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for read < 1000 {
+				k, err := rr.ReadRows(buf)
+				read += int64(k)
+				if err != nil || k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if _, err := readReflect(damaged, typ); err != nil {
+			count("reflect read fails")
+		}
+	})
+}
+
+// damage flips, truncates, deletes or inserts bytes.
+func damage(tc hegel.TestCase, data []byte) []byte {
+	out := append([]byte(nil), data...)
+	for k := n(tc, 1, 3); k > 0 && len(out) > 0; k-- {
+		i := n(tc, 0, len(out)-1)
+		switch n(tc, 1, 5) {
+		case 1:
+			out[i] ^= byte(1 << uint(n(tc, 0, 7)))
+		case 2:
+			out[i] = byte(pick(tc, 0, 0xff, 0x7f, 0x80, n(tc, 0, 255)))
+		case 3:
+			out = out[:i]
+		case 4:
+			j := i + n(tc, 1, 8)
+			if j > len(out) {
+				j = len(out)
+			}
+			out = append(out[:i], out[j:]...)
+		case 5:
+			ins := genBytes(tc, n(tc, 1, 8))
+			out = append(out[:i], append(ins, out[i:]...)...)
+		}
+	}
+	return out
+}
+
+// isZeroBits reports the canonical form of +0.0 or -0.0.
+func isZeroBits(c string) bool {
+	switch c {
+	case "f32:00000000", "f32:80000000", "f64:0000000000000000", "f64:8000000000000000":
+		return true
+	}
+	return false
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..711b73e
--- /dev/null
+++ b/hegel/hegel_test.go
