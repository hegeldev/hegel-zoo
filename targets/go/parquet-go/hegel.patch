+// ---------------------------------------------------------------------------
+// parquet-go/13: a data page v2 of zero values.
+
+var (
+	optionalListShape = shape{rep: "list", optional: true}
+	// containerFields: a map, a LIST, a LIST of optional elements or an
+	// optional LIST, of a scalar kind.
+	containerFields = weighted(
+		choice[fieldSpec]{1, mapFields},
+		choice[fieldSpec]{1, leavesOf(listShape)},
+		choice[fieldSpec]{1, leavesOf(listOptShape)},
+		choice[fieldSpec]{1, hegel.FlatMap(hegel.SampledFrom(kindsFor(optionalListShape)), func(k kind) hegel.Generator[fieldSpec] { return leafOf(k, optionalListShape) })},
+	)
+	// tinyPageSizes: data pages of one byte (of a kilobyte, so that every
+	// page holds values, under HEGEL_NO_KNOWN=1).
+	tinyPageSizes = shaped(hegel.Just(1), hegel.Just(1024))
+	// emptyPageCases: one row holding an empty container (one to three
+	// values under HEGEL_NO_KNOWN=1), written by pyarrow in data pages v2
+	// of one byte with dictionary encoding, where parquet-cpp emits a data
+	// page of zero values for the container's column.
+	emptyPageCases = hegel.FlatMap(hegel.Map(containerFields, func(f fieldSpec) fieldSpec { return rootOf(f) }), func(root fieldSpec) hegel.Generator[pyCase] {
+		options := hegel.Composite(func(tc hegel.TestCase) pyOptions {
+			o := hegel.Draw(tc, pyOptionsOf(defaultPyOptionGens))
+			o.pageVersion, o.dictionary, o.rowGroupSize, o.batchSize = "2.0", true, 0, 0
+			o.dataPageSize = hegel.Draw(tc, tinyPageSizes)
+			return o
+		})
+		return hegel.FlatMap(options, func(o pyOptions) hegel.Generator[pyCase] {
+			spec := pyarrowSpec(root, o)
+			f := spec.fields[0]
+			var values hegel.Generator[reflect.Value]
+			if f.isMap {
+				values = shaped(hegel.Just(reflect.MakeMap(goType(f))), mapOf(f))
+			} else {
+				values = shaped(hegel.Just(reflect.MakeSlice(goType(f), 0, 0)), listOf(f, hegel.Integers(1, 3), 30))
+			}
+			rows := hegel.Map(groupOf(spec, map[int]hegel.Generator[reflect.Value]{0: values}), func(v reflect.Value) []reflect.Value { return []reflect.Value{v} })
+			return hegel.Map(rows, func(rows []reflect.Value) pyCase { return pyCase{o: o, spec: spec, rows: rows} })
+		})
+	})
+)
