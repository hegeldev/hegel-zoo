+		}
+		desc := c.String()
+		curDesc = desc
+		w := pythonWrite(t, path, c.spec, canon, c.o.optionsJSON(c.spec))
+		if !w.ok {
+			count("pyarrow refuses: " + firstLine(w.reason))
+			ht.Assume(false)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		desc += "\nparquet schema:\n" + w.schema
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			fail(ht, "%s: OpenFile: %v", desc, err)
+		}
+		info := caseInfo{prop: "pyarrow", spec: c.spec, rows: len(c.rows), pyOpts: c.o, noFirstIndex: firstColumnIndexMissing(f)}
+		leaves := flatLeaves(c.spec)
+		var start int64
+		for gi, rg := range f.RowGroups() {
+			end := min(start+rg.NumRows(), int64(len(c.rows)))
+			checkChunks(ht, desc, gi, rg, leaves, c.rows[start:end], info)
+			start = end
+		}
