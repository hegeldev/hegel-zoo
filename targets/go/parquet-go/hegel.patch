+// TestHegelColumnIndexesFollowAnIndexlessFirstColumn: the column indexes of
+// the other columns of a file whose first column has none (pyarrow writes
+// no column index for a FLOAT or DOUBLE column with an all-NaN page) read
+// as the file has them: a page per data page, with the null counts and the
+// bounds of the rows (parquet-go/15). Under HEGEL_NO_KNOWN=1 the first
+// column holds finite values and keeps its index.
+func TestHegelColumnIndexesFollowAnIndexlessFirstColumn(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "py.parquet")
