+// TestHegelPyarrowReadsWhatParquetGoWrites: a file parquet-go writes for a
+// generated schema, rows and options is read by pyarrow to the value, and
+// its metadata (row groups, compression, encodings, null counts, minima and
+// maxima of the flat columns, key/value pairs) says what the rows and
+// options say.
+func TestHegelPyarrowReadsWhatParquetGoWrites(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "go.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		if err := os.WriteFile(path, data, 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the file: %s\nparquet schema:\n%s", desc, py.err, schema)
+		}
+		count(fmt.Sprintf("%d row groups", py.numRowGroups))
+		if py.numRows != int64(len(rows)) || len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows (metadata says %d), %d were written", desc, len(py.rows), py.numRows, len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d differs:\n  parquet-go wrote %s\n  pyarrow reads    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+		checkMetadata(ht, desc, spec, rows, fo, py)
+	})
+}
+
+// readReflect reads every row of the file into values of typ through the
+// reflection-based Reader.
+func readReflect(data []byte, typ reflect.Type) ([]reflect.Value, error) {
+	r := parquet.NewReader(bytes.NewReader(data))
+	defer r.Close()
+	var out []reflect.Value
+	for {
+		v := reflect.New(typ)
+		err := r.Read(v.Interface())
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return out, err
+		}
+		out = append(out, v.Elem())
+	}
+}
+
+// TestHegelReadsBackWhatItWrites: parquet-go reads its own file back to the
+// value, through the reflection Reader and through the row API.
+func TestHegelReadsBackWhatItWrites(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		back, err := readReflect(data, typ)
+		if err != nil {
+			fail(ht, "%s: reading back: %v", desc, err)
+		}
+		if len(back) != len(rows) {
+			fail(ht, "%s: %d rows read back of %d", desc, len(back), len(rows))
+		}
+		for i := range rows {
+			want, got := canonBase(spec, rows[i]), canonBase(spec, back[i])
+			if !reflect.DeepEqual(want, got) {
+				fail(ht, "%s: row %d differs:\n  written %s\n  read    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(got), schema)
+			}
+		}
+		// The row API: as many rows, each with as many values as leaves.
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			fail(ht, "%s: OpenFile: %v", desc, err)
+		}
+		if f.NumRows() != int64(len(rows)) {
+			fail(ht, "%s: OpenFile reports %d rows, %d were written", desc, f.NumRows(), len(rows))
+		}
+		var seen int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for {
+				k, err := rr.ReadRows(buf)
+				seen += int64(k)
+				if err != nil {
+					if err.Error() != "EOF" {
+						fail(ht, "%s: ReadRows: %v", desc, err)
+					}
+					break
+				}
+				if k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if seen != int64(len(rows)) {
+			fail(ht, "%s: the row API yields %d rows, %d were written", desc, seen, len(rows))
+		}
+	})
+}
