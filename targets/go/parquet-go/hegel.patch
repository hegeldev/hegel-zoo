+// checkMetadata compares what pyarrow reports about the file with the rows
+// and options it was written from.
+func checkMetadata(ht *hegel.T, desc string, spec fieldSpec, rows []reflect.Value, fo fileOptions, py pyFile) {
+	for k, v := range fo.keyValue {
+		if py.keyValue[k] != v {
+			fail(ht, "%s: key/value metadata %q = %q, want %q", desc, k, py.keyValue[k], v)
+		}
+	}
+	paths := map[string]fieldSpec{}
+	leafPaths(spec, "", paths)
+	flat := map[string]flatLeaf{}
+	for _, l := range flatLeaves(spec) {
+		flat[l.path] = l
+	}
+	var total int64
+	for gi, g := range py.rowGroups {
+		if fo.maxRows > 0 && g.numRows > fo.maxRows {
+			fail(ht, "%s: row group %d has %d rows, more than MaxRowsPerRowGroup(%d)", desc, gi, g.numRows, fo.maxRows)
+		}
+		if total+g.numRows > int64(len(rows)) {
+			fail(ht, "%s: row groups hold more rows (%d+) than were written (%d)", desc, total+g.numRows, len(rows))
+		}
+		groupRows := rows[total : total+g.numRows]
+		total += g.numRows
+		for _, col := range g.columns {
+			leaf, known := paths[col.path]
+			if !known {
+				fail(ht, "%s: pyarrow reports a column %q the schema does not have (paths %v)", desc, col.path, paths)
+			}
+			// Compression: the column's own tag, else the file's codec.
+			wantComp := compressionName(fo.comp)
+			if leaf.comp != "" {
+				wantComp = compressionName(leaf.comp)
+			}
+			if col.compression != wantComp {
+				fail(ht, "%s: column %s is compressed with %s, want %s", desc, col.path, col.compression, wantComp)
+			}
+			// Encodings: the requested one is among those used.
+			if names := encodingNames(leaf); names != nil {
+				found := false
+				for _, name := range names {
+					found = found || contains(col.encodings, name)
+				}
+				if !found {
+					count(fmt.Sprintf("requested encoding %s absent on %s (%v)", leaf.enc, leaf.kind, col.encodings))
+				}
+			}
+			// Statistics of the flat leaves.
+			fl, isFlat := flat[col.path]
+			if !isFlat {
+				continue
+			}
+			if col.numValues != g.numRows {
+				fail(ht, "%s: column %s has %d values in row group %d of %d rows", desc, col.path, col.numValues, gi, g.numRows)
+			}
+			var nulls int64
+			var minV, maxV reflect.Value
+			nan := false
+			for _, row := range groupRows {
+				v, ok := fl.get(row)
+				if !ok {
+					nulls++
+					continue
+				}
+				if isNaN(fl.spec, v) {
+					nan = true
+					continue
+				}
+				if !minV.IsValid() || statLess(fl.spec, v, minV) {
+					minV = v
+				}
+				if !maxV.IsValid() || statLess(fl.spec, maxV, v) {
+					maxV = v
+				}
+			}
+			if col.hasNullCount && col.nullCount != nulls {
+				fail(ht, "%s: column %s has null_count %d in row group %d, but %d of its %d values are null", desc, col.path, col.nullCount, gi, nulls, g.numRows)
+			}
+			if !col.hasNullCount {
+				count("no null count")
+			}
+			if !minV.IsValid() {
+				switch {
+				case col.hasMinMax && nan:
+					count("known parquet-go/4 (min/max written for an all-NaN column)")
+				case col.hasMinMax:
+					count("min/max present on an all-null column")
+				}
+				continue
+			}
+			if !col.hasMinMax {
+				if nan {
+					count("no min/max with NaN present")
+				} else {
+					count("no min/max on " + fl.spec.kind.String())
+				}
+				continue
+			}
+			wantMin, wantMax := statCanon(fl.spec, minV), statCanon(fl.spec, maxV)
+			for _, b := range []struct {
+				what      string
+				got, want any
+			}{{"min", col.min, wantMin}, {"max", col.max, wantMax}} {
+				if reflect.DeepEqual(b.got, b.want) {
+					continue
+				}
+				gs, _ := b.got.(string)
+				ws, _ := b.want.(string)
+				if isByteKind(fl.spec.kind) && len(gs) < len(ws) && (b.what == "min" && strings.HasPrefix(ws, gs) || b.what == "max" && gs > ws[:len(gs)]) {
+					count("truncated " + b.what)
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && isZeroBits(gs) && isZeroBits(ws) {
+					count("known parquet-go/4 (signed zero bound)")
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && nan && fl.spec.enc == "dict" {
+					count("known parquet-go/7 (dictionary float statistics with NaN)")
+					continue
+				}
+				fail(ht, "%s: column %s row group %d: %s statistic is %v, but the values' %s is %v (%d values, %d null)", desc, col.path, gi, b.what, b.got, b.what, b.want, g.numRows, nulls)
+			}
+		}
+	}
+	if total != int64(len(rows)) {
+		fail(ht, "%s: row groups hold %d rows, %d were written", desc, total, len(rows))
+	}
+}
