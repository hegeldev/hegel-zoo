+// parquet-go/7: the statistics of a dictionary-encoded FLOAT or DOUBLE
+// column holding a NaN are wrong: {-1, NaN, 1} gets min 1 and max 1, {NaN,
+// 1, -1} gets max NaN; the plain-encoded column gets min -1, max 1.
+func TestHegelPinDictionaryFloatStatistics(t *testing.T) {
+	type D struct {
+		A float64 `parquet:"a,dict"`
+	}
+	bounds := func(rows []D) (min, max float64) {
+		var buf bytes.Buffer
+		if err := parquet.Write[D](&buf, rows); err != nil {
+			t.Fatal(err)
+		}
+		f, err := parquet.OpenFile(bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		st := f.Metadata().RowGroups[0].Columns[0].MetaData.Statistics
+		if len(st.MinValue) != 8 || len(st.MaxValue) != 8 {
+			t.Fatalf("no min/max written: %x %x", st.MinValue, st.MaxValue)
+		}
+		return math.Float64frombits(binary.LittleEndian.Uint64(st.MinValue)), math.Float64frombits(binary.LittleEndian.Uint64(st.MaxValue))
+	}
+	if mn, mx := bounds([]D{{-1}, {math.NaN()}, {1}}); mn != -1 || mx != 1 {
+		t.Errorf("dictionary-encoded {-1, NaN, 1}: min %v max %v, want -1 and 1", mn, mx)
+	}
+	if mn, mx := bounds([]D{{math.NaN()}, {1}, {-1}}); mn != -1 || mx != 1 {
+		t.Errorf("dictionary-encoded {NaN, 1, -1}: min %v max %v, want -1 and 1", mn, mx)
+	}
+}
