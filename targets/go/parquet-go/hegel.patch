+// firstColumnIndexMissing reports whether the first column chunk of the
+// file has no column index (the shape of parquet-go/15).
+func firstColumnIndexMissing(f *parquet.File) bool {
+	groups := f.RowGroups()
+	if len(groups) == 0 {
+		return false
+	}
+	_, err := groups[0].ColumnChunks()[0].(*parquet.FileColumnChunk).ColumnIndex()
+	return errors.Is(err, parquet.ErrMissingColumnIndex)
+}
