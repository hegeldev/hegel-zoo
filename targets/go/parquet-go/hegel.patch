+				fail(ht, "%s: Writer.Write: %v", desc, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "%s: Writer.Close: %v", desc, err)
+		}
+		if err := os.WriteFile(path, buf.Bytes(), 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the Writer's file: %s", desc, py.err)
+		}
+		if len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows of the Writer's file, %d were written", desc, len(py.rows), len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d of the Writer's file differs:\n  written      %s\n  pyarrow reads %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+	})
+}
