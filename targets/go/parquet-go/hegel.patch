+
+func jsonString(v any) string {
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+// writeGeneric writes the rows through GenericWriter[any] in the batches
+// (each a Write of some of the rows left, with a Flush after it or not; the
+// rows left after the last batch go in one Write), and returns the file.
+func writeGeneric(rows []reflect.Value, opts []parquet.WriterOption, batches []batch) ([]byte, error) {
+	var buf bytes.Buffer
+	w := parquet.NewGenericWriter[any](&buf, opts...)
+	vals := make([]any, len(rows))
+	for i, r := range rows {
+		vals[i] = r.Interface()
+	}
+	for _, b := range batches {
+		if len(vals) == 0 {
+			break
+		}
+		k := len(vals)
+		if b.size > 0 {
+			k = 1 + b.size%len(vals)
+		}
+		if _, err := w.Write(vals[:k]); err != nil {
+			return nil, err
+		}
+		vals = vals[k:]
+		if len(vals) > 0 && b.flush {
+			if err := w.Flush(); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if len(vals) > 0 {
+		if _, err := w.Write(vals); err != nil {
+			return nil, err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// leafPaths maps the parquet column paths of the schema to their specs.
+func leafPaths(f fieldSpec, prefix string, out map[string]fieldSpec) {
+	for _, s := range f.fields {
+		p := s.name
+		if prefix != "" {
+			p = prefix + "." + s.name
+		}
+		switch {
+		case s.isMap:
+			out[p+".key_value.key"] = fieldSpec{name: "key", kind: kString, comp: s.comp}
+			out[p+".key_value.value"] = fieldSpec{name: "value", kind: s.kind, comp: s.comp, enc: s.enc}
+		case s.rep == "list":
+			if s.kind == kGroup {
+				leafPaths(s, p+".list.element", out)
+			} else {
+				out[p+".list.element"] = s
+			}
+		case s.kind == kGroup:
+			leafPaths(s, p, out)
+		default:
+			out[p] = s
+		}
+	}
+}
+
+// encodingNames are what pyarrow reports for an encoding tag on a kind.
+func encodingNames(f fieldSpec) []string {
+	switch f.enc {
+	case "plain":
+		return []string{"PLAIN"}
+	case "dict":
+		return []string{"RLE_DICTIONARY", "PLAIN_DICTIONARY"}
+	case "split":
+		return []string{"BYTE_STREAM_SPLIT"}
+	case "delta":
+		switch f.kind {
+		case kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDecFixed:
+			return []string{"DELTA_BYTE_ARRAY", "DELTA_LENGTH_BYTE_ARRAY"}
+		default:
+			return []string{"DELTA_BINARY_PACKED"}
+		}
+	}
+	return nil
+}
+
+func contains(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func isByteKind(k kind) bool {
+	switch k {
+	case kString, kBytes, kFixed, kUUID, kJSON, kEnum:
+		return true
+	}
+	return false
+}
+
+func isFloatKind(k kind) bool { return k == kFloat || k == kDouble }
+
+// checkMetadata compares what pyarrow reports about the file with the rows
+// and options it was written from. A float column's bounds that are zeros
+// of the wrong sign, or written for an all-NaN column, are parquet-go/4's
+// shape; wrong bounds of a dictionary-encoded float column holding a NaN
+// are parquet-go/7's.
+func checkMetadata(ht *hegel.T, desc string, spec fieldSpec, rows []reflect.Value, fo fileOptions, py pyFile) {
+	for k, v := range fo.keyValue {
+		if py.keyValue[k] != v {
+			fail(ht, "%s: key/value metadata %q = %q, want %q", desc, k, py.keyValue[k], v)
+		}
+	}
+	paths := map[string]fieldSpec{}
+	leafPaths(spec, "", paths)
+	flat := map[string]flatLeaf{}
+	for _, l := range flatLeaves(spec) {
+		flat[l.path] = l
+	}
+	var total int64
+	for gi, g := range py.rowGroups {
+		if fo.maxRows > 0 && g.numRows > fo.maxRows {
+			fail(ht, "%s: row group %d has %d rows, more than MaxRowsPerRowGroup(%d)", desc, gi, g.numRows, fo.maxRows)
+		}
+		if total+g.numRows > int64(len(rows)) {
+			fail(ht, "%s: row groups hold more rows (%d+) than were written (%d)", desc, total+g.numRows, len(rows))
+		}
+		groupRows := rows[total : total+g.numRows]
+		total += g.numRows
+		for _, col := range g.columns {
+			leaf, known := paths[col.path]
+			if !known {
+				fail(ht, "%s: pyarrow reports a column %q the schema does not have (paths %v)", desc, col.path, paths)
+			}
+			// Compression: the column's own tag, else the file's codec.
+			wantComp := compressionName(fo.comp)
+			if leaf.comp != "" {
+				wantComp = compressionName(leaf.comp)
+			}
+			if col.compression != wantComp {
+				fail(ht, "%s: column %s is compressed with %s, want %s", desc, col.path, col.compression, wantComp)
+			}
+			// Encodings: the requested one is among those used.
+			if names := encodingNames(leaf); names != nil {
+				found := false
+				for _, name := range names {
+					found = found || contains(col.encodings, name)
+				}
+				if !found {
+					count(fmt.Sprintf("requested encoding %s absent on %s (%v)", leaf.enc, leaf.kind, col.encodings))
+				}
+			}
+			// Statistics of the flat leaves.
+			fl, isFlat := flat[col.path]
+			if !isFlat {
+				continue
+			}
+			if col.numValues != g.numRows {
+				fail(ht, "%s: column %s has %d values in row group %d of %d rows", desc, col.path, col.numValues, gi, g.numRows)
+			}
+			var nulls int64
+			var minV, maxV reflect.Value
+			nan := false
+			for _, row := range groupRows {
+				v, ok := fl.get(row)
+				if !ok {
+					nulls++
+					continue
+				}
+				if isNaN(fl.spec, v) {
+					nan = true
+					continue
+				}
+				if !minV.IsValid() || statLess(fl.spec, v, minV) {
+					minV = v
+				}
+				if !maxV.IsValid() || statLess(fl.spec, maxV, v) {
+					maxV = v
+				}
+			}
+			if col.hasNullCount && col.nullCount != nulls {
+				fail(ht, "%s: column %s has null_count %d in row group %d, but %d of its %d values are null", desc, col.path, col.nullCount, gi, nulls, g.numRows)
+			}
+			if !col.hasNullCount {
+				count("no null count")
+			}
+			if !minV.IsValid() {
+				switch {
+				case col.hasMinMax && nan:
+					mismatch(ht, "parquet-go/4", "%s: column %s row group %d: min %v and max %v are written for a column whose values are all NaN", desc, col.path, gi, col.min, col.max)
+				case col.hasMinMax:
+					count("min/max present on an all-null column")
+				}
+				continue
+			}
+			if !col.hasMinMax {
+				if nan {
+					count("no min/max with NaN present")
+				} else {
+					count("no min/max on " + fl.spec.kind.String())
+				}
+				continue
+			}
+			wantMin, wantMax := statCanon(fl.spec, minV), statCanon(fl.spec, maxV)
+			for _, b := range []struct {
+				what      string
+				got, want any
+			}{{"min", col.min, wantMin}, {"max", col.max, wantMax}} {
+				if reflect.DeepEqual(b.got, b.want) {
+					continue
+				}
+				gs, _ := b.got.(string)
+				ws, _ := b.want.(string)
+				if isByteKind(fl.spec.kind) && len(gs) < len(ws) && (b.what == "min" && strings.HasPrefix(ws, gs) || b.what == "max" && gs > ws[:len(gs)]) {
+					count("truncated " + b.what)
+					continue
+				}
+				id := ""
+				switch {
+				case isFloatKind(fl.spec.kind) && isZeroBits(gs) && isZeroBits(ws):
+					id = "parquet-go/4"
+				case isFloatKind(fl.spec.kind) && nan && fl.spec.enc == "dict":
+					id = "parquet-go/7"
+				}
+				mismatch(ht, id, "%s: column %s row group %d: %s statistic is %v, but the values' %s is %v (%d values, %d null, NaN present: %v)", desc, col.path, gi, b.what, b.got, b.what, b.want, g.numRows, nulls, nan)
+			}
+		}
+	}
+	if total != int64(len(rows)) {
+		fail(ht, "%s: row groups hold %d rows, %d were written", desc, total, len(rows))
+	}
+}
+
+// writeCase writes the case's rows with GenericWriter and the case's options.
+func writeCase(ht *hegel.T, c goCase) []byte {
+	data, err := writeGeneric(c.rows, c.fo.writerOptions(c.schema()), c.batches)
+	if err != nil {
+		fail(ht, "%s: writing: %v", c, err)
+	}
+	return data
+}
+
+// checkPyarrowReads judges one case as TestHegelPyarrowReadsWhatParquetGoWrites
+// does: pyarrow reads the file parquet-go wrote to the value, and its
+// metadata says what the rows and options say. A file with a
+// dictionary-encoded boolean column, which parquet-cpp refuses to read, is
+// counted and the case ends.
+func checkPyarrowReads(t testing.TB, ht *hegel.T, path string, c goCase) {
+	desc := c.String()
+	curDesc = desc
+	data := writeCase(ht, c)
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		ht.Fatalf("%v", err)
+	}
+	py := pythonRead(t, path)
+	if !py.ok {
+		if hasDictBool(c.spec) && strings.Contains(py.err, "boolean") {
+			count("pyarrow refuses dictionary-encoded booleans")
+			ht.Assume(false)
+		}
+		fail(ht, "%s: pyarrow cannot read the file: %s\nparquet schema:\n%s", desc, py.err, c.schema())
+	}
+	count(fmt.Sprintf("%d row groups", py.numRowGroups))
+	if py.numRows != int64(len(c.rows)) || len(py.rows) != len(c.rows) {
+		fail(ht, "%s: pyarrow reads %d rows (metadata says %d), %d were written", desc, len(py.rows), py.numRows, len(c.rows))
+	}
+	for i, r := range c.rows {
+		want := canonBase(c.spec, r)
+		if !reflect.DeepEqual(want, py.rows[i]) {
+			fail(ht, "%s: row %d differs:\n  parquet-go wrote %s\n  pyarrow reads    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), c.schema())
+		}
+	}
+	checkMetadata(ht, desc, c.spec, c.rows, c.fo, py)
+}
+
+// TestHegelPyarrowReadsWhatParquetGoWrites: a file parquet-go writes for a
+// generated schema, rows and options is read by pyarrow to the value, and
+// its metadata (row groups, compression, encodings, null counts, minima and
+// maxima of the flat columns, key/value pairs) says what the rows and
+// options say. The bounds of float columns with signed zeros or NaN are
+// parquet-go/4's and parquet-go/7's shapes.
+func TestHegelPyarrowReadsWhatParquetGoWrites(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "go.parquet")
+	property(t, func(ht *hegel.T) {
+		checkPyarrowReads(t, ht, path, hegel.Draw(ht, goCases))
+	})
+}
+
+// readReflect reads the rows of the file into values of typ through the
+// reflection-based Reader, at most limit of them (a damaged file can make
+// the Reader yield rows without end).
+func readReflect(data []byte, typ reflect.Type, limit int) ([]reflect.Value, error) {
+	r := parquet.NewReader(bytes.NewReader(data))
+	defer r.Close()
+	var out []reflect.Value
+	for len(out) < limit {
+		v := reflect.New(typ)
+		err := r.Read(v.Interface())
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return out, err
+		}
+		out = append(out, v.Elem())
+	}
+	return out, nil
+}
+
+// groupCounts reads every row group of the file through the row API and
+// reports how many rows each yields (one more than the group's count at
+// most), or the first error.
+func groupCounts(f *parquet.File) ([]int64, error) {
+	var counts []int64
+	for gi, rg := range f.RowGroups() {
+		rr := rg.Rows()
+		buf := make([]parquet.Row, 4)
+		var seen int64
+		for seen <= rg.NumRows() {
+			k, err := rr.ReadRows(buf)
+			seen += int64(k)
+			if err != nil {
+				if err.Error() != "EOF" {
+					rr.Close()
+					return counts, fmt.Errorf("ReadRows in row group %d: %w", gi, err)
+				}
+				break
+			}
+			if k == 0 {
+				break
+			}
+		}
+		rr.Close()
+		counts = append(counts, seen)
+	}
+	return counts, nil
+}
+
+// fileRead is what reading a file gives: the rows the reflection Reader
+// reads, in canonical form as JSON, and how many rows the row API yields
+// per row group; or how reading ended ("error: ...", "panic: ..." or, in a
+// child process, childDies).
+type fileRead struct {
+	result string // "ok" or the failure
+	rows   []string
+	groups []int64
+}
+
+// readFileOutcome reads the file into values of the schema's type (limit
+// rows at most) and through the row API, in this process.
+func readFileOutcome(data []byte, spec fieldSpec, limit int) (r fileRead) {
+	defer func() {
+		if p := recover(); p != nil {
+			r = fileRead{result: fmt.Sprintf("panic: %v", p)}
+		}
+	}()
+	back, err := readReflect(data, baseType(spec), limit)
+	if err != nil {
+		return fileRead{result: "error: reading: " + err.Error()}
+	}
+	r.rows = make([]string, len(back))
+	for i, row := range back {
+		r.rows[i] = jsonString(canonBase(spec, row))
+	}
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return fileRead{result: "error: OpenFile: " + err.Error()}
+	}
+	r.groups, err = groupCounts(f)
+	if err != nil {
+		return fileRead{result: "error: " + err.Error()}
+	}
+	r.result = "ok"
+	return r
+}
+
+// readFile reads the file as readFileOutcome does, in a child process when
+// inChild (openFileChild's ZOO_PARQUET_READ_FILE side): an LZ4_RAW page
+// decoded from a stale buffer (parquet-go/14) feeds the value decoders
+// garbage, whose lengths they allocate without bound, gigabytes that in
+// this process abort the binary or starve the tests after it.
+func readFile(testName string, data []byte, spec fieldSpec, limit int, inChild bool) fileRead {
+	if !inChild {
+		return readFileOutcome(data, spec, limit)
+	}
+	out, err := inChildFile(testName, readFileChildEnv, data, readSchemaChildEnv+"="+schemaJSON(spec, limit))
+	r := fileRead{result: childResult(out, err, "ZOO_READ_FILE result=%q")}
+	for _, line := range strings.Split(out, "\n") {
+		if rest, ok := strings.CutPrefix(line, "ZOO_READ_FILE_ROWS "); ok {
+			var rows []json.RawMessage
+			if json.Unmarshal([]byte(rest), &rows) == nil {
+				for _, row := range rows {
+					r.rows = append(r.rows, string(row))
+				}
+			}
+		}
+		if rest, ok := strings.CutPrefix(line, "ZOO_READ_FILE_GROUPS "); ok {
+			json.Unmarshal([]byte(rest), &r.groups)
+		}
+	}
+	return r
+}
+
+// schemaJSON is the schema and the row limit as the child reads them.
+func schemaJSON(spec fieldSpec, limit int) string {
+	m := specJSON(spec)
+	m["limit"] = limit
+	return jsonString(m)
+}
+
+// specFromJSON is the schema specJSON renders (the child's side).
+func specFromJSON(m map[string]any) fieldSpec {
+	f := fieldSpec{
+		name:         str(m["name"]),
+		optional:     boolean(m["optional"]),
+		rep:          str(m["rep"]),
+		elemOptional: boolean(m["elemOptional"]),
+		isMap:        boolean(m["isMap"]),
+		fixedLen:     int(num(m["fixedLen"])),
+		scale:        int(num(m["scale"])),
+		precision:    int(num(m["precision"])),
+		utc:          boolean(m["utc"]),
+	}
+	for k, name := range kindNames {
+		if name == str(m["kind"]) {
+			f.kind = kind(k)
+		}
+	}
+	if fields, ok := m["fields"].([]any); ok {
+		for _, s := range fields {
+			f.fields = append(f.fields, specFromJSON(s.(map[string]any)))
+		}
+	}
+	return f
+}
+
+// checkReadsBack judges one case as TestHegelReadsBackWhatItWrites does:
+// parquet-go reads its own file back to the value through the reflection
+// Reader, and the row API yields as many rows. An LZ4 column read wrong is
+// parquet-go/14's shape; a file with LZ4 pages is read in a child process
+// (readFile).
+func checkReadsBack(ht *hegel.T, testName string, c goCase) {
+	desc := c.String()
+	curDesc = desc
+	data := writeCase(ht, c)
+	info := caseInfo{prop: "readback", spec: c.spec, fileOpts: c.fo}
+	r := readFile(testName, data, c.spec, len(c.rows)+1, lz4Tagged(c.spec, c.fo))
+	checkRead(ht, desc, info, r, c.spec, c.rows)
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		fail(ht, "%s: OpenFile: %v", desc, err)
+	}
+	if f.NumRows() != int64(len(c.rows)) {
+		fail(ht, "%s: OpenFile reports %d rows, %d were written", desc, f.NumRows(), len(c.rows))
+	}
+	var seen int64
+	for _, n := range r.groups {
+		seen += n
+	}
+	if seen != int64(len(c.rows)) {
+		info.stage = "values"
+		mismatch(ht, known(info), "%s: the row API yields %d rows, %d were written", desc, seen, len(c.rows))
+	}
+}
+
+// checkRead compares what reading the file gave with the rows written: a
+// failure of the read, or rows that differ, is classified by known.
+func checkRead(ht *hegel.T, desc string, info caseInfo, r fileRead, spec fieldSpec, rows []reflect.Value) {
+	if strings.HasPrefix(r.result, "child:") {
+		ht.Fatalf("%s: %s", desc, r.result)
+	}
+	switch {
+	case r.result == childDies:
+		info.stage = "error"
+		mismatch(ht, known(info), "%s: reading the file in a child process exhausts its %d MB address space", desc, childAddressSpaceKB>>10)
+	case strings.HasPrefix(r.result, "panic: "):
+		info.stage, info.panic = "panic", strings.TrimPrefix(r.result, "panic: ")
+		mismatch(ht, known(info), "%s: reading panics: %s", desc, info.panic)
+	case r.result != "ok":
+		info.stage = "error"
+		mismatch(ht, known(info), "%s: %s", desc, strings.TrimPrefix(r.result, "error: "))
+	}
+	info.stage = "values"
+	if len(r.rows) != len(rows) {
+		mismatch(ht, known(info), "%s: %d rows read of %d", desc, len(r.rows), len(rows))
+	}
+	for i, row := range rows {
+		if want := jsonString(canonBase(spec, row)); want != r.rows[i] {
+			mismatch(ht, known(info), "%s: row %d differs:\n  written %s\n  read    %s", desc, i, want, r.rows[i])
+		}
+	}
+}
+
+// TestHegelReadsBackWhatItWrites: parquet-go reads its own file back to the
+// value, through the reflection Reader and through the row API.
+func TestHegelReadsBackWhatItWrites(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	property(t, func(ht *hegel.T) {
+		checkReadsBack(ht, name, hegel.Draw(ht, goCases))
+	})
+}
+
+// writeDeprecated writes the rows one by one through the deprecated Writer
+// and returns the file; a panic of the writer is returned as an error.
+func writeDeprecated(rows []reflect.Value, opts []parquet.WriterOption) (data []byte, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if isHegelPanic(r) {
+				panic(r)
+			}
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	var buf bytes.Buffer
+	w := parquet.NewWriter(&buf, opts...)
+	for _, r := range rows {
+		if err := w.Write(r.Interface()); err != nil {
+			return nil, fmt.Errorf("Writer.Write: %w", err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		return nil, fmt.Errorf("Writer.Close: %w", err)
+	}
+	return buf.Bytes(), nil
+}
+
+// checkWriterPath judges one case as TestHegelWriterPathsAgree does: the
+// deprecated Writer writes the rows to a file pyarrow reads to the same
+// values. A LIST of optional elements is parquet-go/1's shape.
+func checkWriterPath(t testing.TB, ht *hegel.T, path string, c goCase) {
+	desc := c.String()
+	curDesc = desc
+	info := caseInfo{prop: "writer", spec: c.spec}
+	data, err := writeDeprecated(c.rows, c.fo.writerOptions(c.schema()))
+	if err != nil {
+		mismatch(ht, known(info), "%s: the deprecated Writer: %v", desc, err)
+	}
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		ht.Fatalf("%v", err)
+	}
+	py := pythonRead(t, path)
+	if !py.ok {
+		if hasDictBool(c.spec) && strings.Contains(py.err, "boolean") {
+			count("pyarrow refuses dictionary-encoded booleans")
+			ht.Assume(false)
+		}
+		fail(ht, "%s: pyarrow cannot read the Writer's file: %s", desc, py.err)
+	}
+	if len(py.rows) != len(c.rows) {
+		mismatch(ht, known(info), "%s: pyarrow reads %d rows of the Writer's file, %d were written", desc, len(py.rows), len(c.rows))
+	}
+	for i, r := range c.rows {
+		want := canonBase(c.spec, r)
+		if !reflect.DeepEqual(want, py.rows[i]) {
+			mismatch(ht, known(info), "%s: row %d of the Writer's file differs:\n  written      %s\n  pyarrow reads %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), c.schema())
+		}
+	}
+}
+
+// TestHegelWriterPathsAgree: the deprecated Writer (whose documentation says
+// GenericWriter[any] has the same behaviour) writes the same rows to a file
+// pyarrow reads to the same values. Its schemas have a LIST of optional
+// elements (parquet-go/1's shape) in a fifth of their fields by default.
+func TestHegelWriterPathsAgree(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "writer.parquet")
+	property(t, func(ht *hegel.T) {
+		checkWriterPath(t, ht, path, hegel.Draw(ht, writerCases))
+	})
+}
+
+// checkDamaged judges one case as TestHegelDamagedFilesNeverPanic does: the
+// damaged file never makes OpenFile or reading its rows panic, and OpenFile
+// allocates no more than the file holds. OpenFile and the row API run in a
+// child process (openFileInChild): a damaged length makes them allocate
+// gigabytes (parquet-go/17 and 18), which in this process aborts the binary
+// or starves the tests after it. The child reports what OpenFile allocated
+// and how each stage (OpenFile, the row API, the reflection Reader, both
+// bounded) ended; a panic or a death is classified by known. Under
+// HEGEL_NO_KNOWN=1 the damage stays before the footer, whose lengths and
+// annotations are parquet-go/8's, 17's and 19's shapes.
+func checkDamaged(ht *hegel.T, testName string, c damagedCase) {
+	curDesc = c.goCase.String()
+	data := writeCase(ht, c.goCase)
+	within := len(data)
+	if noKnown {
+		within = dataRegion(data)
+	}
+	damaged := damage(data, c.edits, within)
+	desc := fmt.Sprintf("%s, %d bytes damaged to %d bytes by %#v", c.goCase, len(data), len(damaged), c.edits)
+	stage := "open"
+	defer func() {
+		if r := recover(); r != nil {
+			if isHegelPanic(r) {
+				panic(r)
+			}
+			id := known(caseInfo{prop: "damaged", panic: fmt.Sprint(r), stage: stage})
+			if dir := os.Getenv("HEGEL_DUMP"); dir != "" {
+				name := filepath.Join(dir, fmt.Sprintf("panic-%d.parquet", len(damaged)))
+				_ = os.WriteFile(name, damaged, 0o644)
+				mismatch(ht, id, "%s: %s panics: %v (file %s)\n%s", desc, stage, r, name, debug.Stack())
+			}
+			mismatch(ht, id, "%s: %s panics: %v", desc, stage, r)
+		}
+	}()
+	child := openFileInChild(testName, damaged, readSchemaChildEnv+"="+schemaJSON(c.spec, 1000))
+	if strings.HasPrefix(child.open, "child:") || strings.HasPrefix(child.read, "child:") || strings.HasPrefix(child.reflect, "child:") {
+		ht.Fatalf("%s: %s%s%s", desc, child.open, child.read, child.reflect)
+	}
+	info := caseInfo{prop: "damaged", spec: c.spec, fileOpts: c.fo}
+	if child.open == childDies || child.alloc > openFileAllowance(len(damaged)) {
+		stage = "allocation"
+		info.stage = stage
+		mismatch(ht, known(info), "%s: OpenFile %s", desc, openFileVerdict(child.alloc, child.open))
+	}
+	if strings.HasPrefix(child.open, "panic: ") {
+		panic(strings.TrimPrefix(child.open, "panic: "))
+	}
+	if child.open != "ok" {
+		count("OpenFile fails")
+		return
+	}
+	count("OpenFile succeeds")
+	stage = "read"
+	for _, read := range []string{child.read, child.reflect} {
+		if read == childDies {
+			stage = "read allocation"
+			info.stage = stage
+			if !lz4Tagged(c.spec, c.fo) {
+				// candidate/go/parquet-go-21 (no pin yet, see the report): a
+				// damaged page of another codec makes a decoder allocate the
+				// length the damaged bytes claim, gigabytes. Counted and
+				// skipped (HEGEL_DUMP=dir keeps the file).
+				count("candidate/go/parquet-go-21: decoding the damaged pages exhausts the child's address space")
+				if dir := os.Getenv("HEGEL_DUMP"); dir != "" {
+					name := filepath.Join(dir, fmt.Sprintf("dies-%d.parquet", len(damaged)))
+					_ = os.WriteFile(name, damaged, 0o644)
+				}
+				ht.Assume(false)
+			}
+			mismatch(ht, known(info), "%s: reading the rows exhausts a %d MB address space", desc, childAddressSpaceKB>>10)
+		}
+		if strings.HasPrefix(read, "panic: ") {
+			panic(strings.TrimPrefix(read, "panic: "))
+		}
+	}
+	if strings.HasPrefix(child.reflect, "error: ") {
+		count("reflect read fails")
+	}
+}
+
+// TestHegelDamagedFilesNeverPanic: a file with flipped, set, deleted or
+// inserted bytes, or truncated, never makes OpenFile or reading its rows
+// panic, and OpenFile allocates no more than the file holds (parquet-go/5,
+// 6, 8, 16, 17, 18, 19 and 20 are the shapes it meets; HEGEL_DUMP=dir keeps
+// the files that do). Under HEGEL_NO_KNOWN=1 the damage stays before the
+// footer.
+func TestHegelDamagedFilesNeverPanic(t *testing.T) {
+	if openFileChild() {
+		return
+	}
+	name := t.Name()
+	property(t, func(ht *hegel.T) {
+		checkDamaged(ht, name, hegel.Draw(ht, damagedCases))
+	})
+}
+
+// isHegelPanic reports a panic that is Hegel's own control flow (a failing
+// or aborted case), to be let through a recover.
+func isHegelPanic(r any) bool {
+	if _, ok := r.(collected); ok {
+		return true
+	}
+	if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+		return true
+	}
+	tn := reflect.TypeOf(r).String()
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
