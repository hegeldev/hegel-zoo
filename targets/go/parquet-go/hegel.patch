+func TestHegelPinDamagedPageIndexLengthErrors(t *testing.T) {
+	type R struct {
+		A int32  `parquet:"a"`
+		B string `parquet:"b"`
+	}
+	var buf bytes.Buffer
+	if err := parquet.Write[R](&buf, []R{{1, "x"}, {2, "y"}}); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.Bytes()
+	// [data][footer][footer length, 4 bytes little-endian]["PAR1"]
+	n := len(data)
+	footerLen := int(binary.LittleEndian.Uint32(data[n-8 : n-4]))
+	footer := data[n-8-footerLen : n-8]
+	rebuild := func(edit func(md *format.FileMetaData)) []byte {
+		var md format.FileMetaData
+		if err := thrift.Unmarshal(new(thrift.CompactProtocol), footer, &md); err != nil {
+			t.Fatal(err)
+		}
+		if md.RowGroups[0].Columns[0].ColumnIndexLength == 0 {
+			t.Fatal("the writer wrote no column index; the pin needs one")
+		}
