+// writeGeneric writes the rows through GenericWriter[any], in a few batches
+// with an occasional Flush between them, and returns the file.
+func writeGeneric(tc hegel.TestCase, rows []reflect.Value, opts []parquet.WriterOption) ([]byte, error) {
+	var buf bytes.Buffer
+	w := parquet.NewGenericWriter[any](&buf, opts...)
+	vals := make([]any, len(rows))
+	for i, r := range rows {
+		vals[i] = r.Interface()
+	}
+	for len(vals) > 0 {
+		k := len(vals)
+		if chance(tc, 40) {
+			k = n(tc, 1, len(vals))
+		}
+		if _, err := w.Write(vals[:k]); err != nil {
+			return nil, err
+		}
+		vals = vals[k:]
+		if len(vals) > 0 && chance(tc, 30) {
+			if err := w.Flush(); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
