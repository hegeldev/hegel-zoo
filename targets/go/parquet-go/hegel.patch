+// TestHegelDamagedFilesNeverPanic: a damaged file never makes OpenFile or
+// reading its rows panic.
+func TestHegelDamagedFilesNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		curDesc = fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "schema %s: writing: %v", spec, err)
+		}
+		damaged := damage(ht, data)
+		desc := fmt.Sprintf("schema %s, %d rows, %d bytes damaged to %d bytes", spec, len(rows), len(data), len(damaged))
+		stage := "open"
+		defer func() {
+			if r := recover(); r != nil {
+				if id := known(caseInfo{prop: "damaged", panic: fmt.Sprint(r), stage: stage}); id != "" {
+					count("known " + id)
+					return
+				}
+				if dir := os.Getenv("HEGEL_DUMP"); dir != "" {
+					name := filepath.Join(dir, fmt.Sprintf("panic-%d.parquet", len(damaged)))
+					_ = os.WriteFile(name, damaged, 0o644)
+					fail(ht, "%s: %s panics: %v (file %s)\n%s", desc, stage, r, name, debug.Stack())
+				}
+				fail(ht, "%s: %s panics: %v", desc, stage, r)
+			}
+		}()
+		f, err := parquet.OpenFile(bytes.NewReader(damaged), int64(len(damaged)))
+		if err != nil {
+			count("OpenFile fails")
+			return
+		}
+		count("OpenFile succeeds")
+		stage = "read"
+		var read int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for read < 1000 {
+				k, err := rr.ReadRows(buf)
+				read += int64(k)
+				if err != nil || k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if _, err := readReflect(damaged, typ); err != nil {
+			count("reflect read fails")
+		}
+	})
+}
+
+// damage flips, truncates, deletes or inserts bytes.
+func damage(tc hegel.TestCase, data []byte) []byte {
+	out := append([]byte(nil), data...)
+	for k := n(tc, 1, 3); k > 0 && len(out) > 0; k-- {
+		i := n(tc, 0, len(out)-1)
+		switch n(tc, 1, 5) {
+		case 1:
+			out[i] ^= byte(1 << uint(n(tc, 0, 7)))
+		case 2:
+			out[i] = byte(pick(tc, 0, 0xff, 0x7f, 0x80, n(tc, 0, 255)))
+		case 3:
+			out = out[:i]
+		case 4:
+			j := i + n(tc, 1, 8)
+			if j > len(out) {
+				j = len(out)
+			}
+			out = append(out[:i], out[j:]...)
+		case 5:
+			ins := genBytes(tc, n(tc, 1, 8))
+			out = append(out[:i], append(ins, out[i:]...)...)
+		}
+	}
+	return out
+}
+
+// isZeroBits reports the canonical form of +0.0 or -0.0.
+func isZeroBits(c string) bool {
+	switch c {
+	case "f32:00000000", "f32:80000000", "f64:0000000000000000", "f64:8000000000000000":
+		return true
+	}
+	return false
+}
diff --git a/hegel/hegel_pyfiles_test.go b/hegel/hegel_pyfiles_test.go
new file mode 100644
index 0000000..8aea5e6
--- /dev/null
+++ b/hegel/hegel_pyfiles_test.go
@@ -0,0 +1,214 @@
+package hegel
+
+// Pins for the bugs the reverse direction found: files pyarrow 25.0.1 wrote
+// (embedded, a few hundred bytes each; pyarrow reads every one of them to
+// the values in the comments) that parquet-go reads wrongly, and a schema
+// conversion pyarrow's files exercise.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+)
+
+func decodeFile(t *testing.T, b64 string) []byte {
+	data, err := base64.StdEncoding.DecodeString(b64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// pyListItem: two LIST columns whose elements are named item and array
+// (pyarrow with use_compliant_nested_type=False; the default before pyarrow
+// 13, and what Spark's and Hive's older files look like): li: [[1, 2], [3],
+// []], lg: [[{c: q}], [], [{c: r}, {c: s}]].
+const pyListItem = ""
+
+// pyEmptyDict: a required int32 column a, no rows, dictionary encoding on
+// (a dictionary page at offset 4, data_page_offset 0).
+const pyEmptyDict = "UEFSMRUEFQAVAEwVABUAEgAAFQQZLDUAGAZzY2hlbWEVAgAVAiUAGAFhABYAGRwZHCYAHBUCGSUABhkYAWEVABYAFhwWHCYAJggpHBUEFQAVAgAAABYcFgAmCBYcACggcGFycXVldC1jcHAtYXJyb3cgdmVyc2lvbiAyNS4wLjEZHBwAAAB0AAAAUEFSMQ=="
+
+// pyBoolRLE: a required boolean column b in a data page v2, RLE-encoded as
+// parquet-cpp does for booleans in v2 pages: ten trues, three falses, then
+// true, false, true.
+const pyBoolRLE = "UEFSMRUGFRAVEFwVIBUAFSAVBhUAFQASHBgBARgBABYAKAEBGAEAEREAAAAEAAAAFAEDKBUEGSw1ABgGc2NoZW1hFQIAFQAlABgBYgAWIBkcGRwmABwVABkVBhkYAWIVABYgFmAWYCYIPBgBARgBABYAKAEBGAEAEREAGRwVABUGFQIAAAAWYBYgJggWYAAoIHBhcnF1ZXQtY3BwLWFycm93IHZlcnNpb24gMjUuMC4xGRwcAAAAgwAAAFBBUjE="
+
+// pyEmptyPageV2: one row holding an empty map<string, bool>, data pages v2
+// of 64 bytes: the value column starts with a data page of zero values
+// (num_values 0, no levels).
+const pyEmptyPageV2 = ""
+
+// parquet-go/9: the reflection reader reads the elements of a LIST whose
+// element field is not named "element" as zero values (scalars) or drops
+// them (groups), where the row API reads them right; the format leaves the
+// element's name free ("item", "array", ... in files of other writers).
+func TestHegelPinListElementNameIsFree(t *testing.T) {
+	type C struct {
+		C string `parquet:"c"`
+	}
+	type R struct {
+		LI []int32 `parquet:"li,list"`
+		LG []C     `parquet:"lg,list"`
+	}
+	data := decodeFile(t, pyListItem)
+	rows, err := parquet.Read[R](bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+	want := []R{{LI: []int32{1, 2}, LG: []C{{"q"}}}, {LI: []int32{3}, LG: []C{}}, {LI: []int32{}, LG: []C{{"r"}, {"s"}}}}
+	for i := range want {
+		if i >= len(rows) {
+			t.Fatalf("%d rows read, want %d", len(rows), len(want))
+		}
+		if fmt.Sprint(rows[i]) != fmt.Sprint(want[i]) {
+			t.Errorf("row %d: parquet-go reads %+v, pyarrow wrote %+v", i, rows[i], want[i])
+		}
+	}
+}
+
+// parquet-go/10: converting a DECIMAL column between INT32/INT64 and
+// FIXED_LEN_BYTE_ARRAY (a file's physical type differing from the Go
+// field's) copies the integer's little-endian bytes, where the format
+// stores fixed-length decimals as big-endian two's complement: 12345 in a
+// [3]byte decimal(2:5) field comes out as 39 30 00, and pyarrow's default
+// decimal files (FIXED_LEN_BYTE_ARRAY) read into int32/int64 fields give
+// byte-reversed values.
+func TestHegelPinDecimalConversionIsBigEndian(t *testing.T) {
+	type I struct {
+		D int32 `parquet:"d,decimal(2:5)"`
+	}
+	type F struct {
+		D [3]byte `parquet:"d,decimal(2:5)"`
+	}
+	type I8 struct {
+		D int64 `parquet:"d,decimal(3:18)"`
+	}
+	type F8 struct {
+		D [8]byte `parquet:"d,decimal(3:18)"`
+	}
+	var buf bytes.Buffer
+	if err := parquet.Write[I](&buf, []I{{12345}, {-1}}); err != nil {
+		t.Fatal(err)
+	}
+	fs, err := parquet.Read[F](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Fatalf("reading the INT32 decimal into [3]byte: %v", err)
+	}
+	if want := []F{{[3]byte{0x00, 0x30, 0x39}}, {[3]byte{0xff, 0xff, 0xff}}}; !reflect.DeepEqual(fs, want) {
+		t.Errorf("INT32 DECIMAL(5,2) values 12345 and -1 read into [3]byte give % x, want % x (big-endian two's complement)", fs, want)
+	}
+	buf.Reset()
+	if err := parquet.Write[F](&buf, []F{{[3]byte{0x00, 0x30, 0x39}}, {[3]byte{0xff, 0xff, 0xff}}}); err != nil {
+		t.Fatal(err)
+	}
+	is, err := parquet.Read[I](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Fatalf("reading the FIXED_LEN_BYTE_ARRAY(3) decimal into int32: %v", err)
+	}
+	if want := []I{{12345}, {-1}}; !reflect.DeepEqual(is, want) {
+		t.Errorf("FIXED_LEN_BYTE_ARRAY(3) DECIMAL(5,2) values 00 30 39 and ff ff ff read into int32 give %v, want %v", is, want)
+	}
+	buf.Reset()
+	if err := parquet.Write[I8](&buf, []I8{{123456789012345678}}); err != nil {
+		t.Fatal(err)
+	}
+	f8, err := parquet.Read[F8](bytes.NewReader(buf.Bytes()), int64(buf.Len()))
+	if err != nil {
+		t.Fatalf("reading the INT64 decimal into [8]byte: %v", err)
+	}
+	if want := []F8{{[8]byte{0x01, 0xb6, 0x9b, 0x4b, 0xa6, 0x30, 0xf3, 0x4e}}}; !reflect.DeepEqual(f8, want) {
+		t.Errorf("INT64 DECIMAL(18,3) value 123456789012345678 read into [8]byte gives % x, want % x", f8, want)
+	}
+}
+
+// parquet-go/11: a file with no rows whose column chunks have a dictionary
+// page but no data page (data_page_offset 0; pyarrow writes one for every
+// empty table with dictionary encoding on) makes reading fail with "Seek:
+// invalid offset" instead of yielding no rows.
+func TestHegelPinEmptyDictionaryFileReads(t *testing.T) {
+	type R struct {
+		A int32 `parquet:"a"`
+	}
+	data := decodeFile(t, pyEmptyDict)
+	rows, err := parquet.Read[R](bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Errorf("Read of the empty file: %v (want no rows and no error)", err)
+	}
+	if len(rows) != 0 {
+		t.Errorf("Read gives %d rows of an empty file", len(rows))
+	}
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatalf("OpenFile: %v", err)
+	}
+	if f.NumRows() != 0 {
+		t.Errorf("NumRows is %d", f.NumRows())
+	}
+	for _, rg := range f.RowGroups() {
+		rr := rg.Rows()
+		n, err := rr.ReadRows(make([]parquet.Row, 4))
+		rr.Close()
+		if n != 0 || (err != nil && err.Error() != "EOF") {
+			t.Errorf("ReadRows of the empty row group: %d rows, %v (want 0 and EOF)", n, err)
+		}
+	}
+}
+
+// parquet-go/12: RLE-encoded booleans (the encoding parquet-cpp uses for
+// BOOLEAN columns in data pages v2) are decoded wrongly when the RLE data
+// holds a run: a run of n equal values yields one byte holding the value's
+// low bit, so ten trues read as true, false, false, ...
+func TestHegelPinRLEBooleansDecode(t *testing.T) {
+	type R struct {
+		B bool `parquet:"b"`
+	}
+	data := decodeFile(t, pyBoolRLE)
+	rows, err := parquet.Read[R](bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+	want := []bool{true, true, true, true, true, true, true, true, true, true, false, false, false, true, false, true}
+	got := make([]bool, len(rows))
+	for i, r := range rows {
+		got[i] = r.B
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("RLE booleans read as %v, pyarrow wrote %v", got, want)
+	}
+	// The encoding alone: a run of two trues (header 0x04 = run of 2, value 1).
+	bits, err := parquet.RLE.DecodeBoolean(nil, []byte{2, 0, 0, 0, 0x04, 0x01})
+	if err != nil {
+		t.Fatalf("DecodeBoolean: %v", err)
+	}
+	if len(bits) == 0 || bits[0]&0x03 != 0x03 {
+		t.Errorf("RLE.DecodeBoolean of a run of two trues gives bits % x, want the two low bits set", bits)
+	}
+}
+
+// parquet-go/13: a data page v2 with zero values (no levels, which
+// parquet-cpp emits at times, here for the value column of a single empty
+// map with 64-byte pages) makes reading panic with a nil pointer
+// dereference in decodeDataPage instead of yielding no values.
+func TestHegelPinEmptyDataPageV2Reads(t *testing.T) {
+	type R struct {
+		M map[string]bool `parquet:"m"`
+	}
+	data := decodeFile(t, pyEmptyPageV2)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("reading the file panics: %v", r)
+		}
+	}()
+	rows, err := parquet.Read[R](bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+	if len(rows) != 1 || len(rows[0].M) != 0 {
+		t.Errorf("read %+v, pyarrow wrote one row with an empty map", rows)
+	}
+}
diff --git a/hegel/hegel_reverse_test.go b/hegel/hegel_reverse_test.go
new file mode 100644
index 0000000..9710c88
--- /dev/null
+++ b/hegel/hegel_reverse_test.go
@@ -0,0 +1,624 @@
+package hegel
+
+// The other direction: pyarrow writes a file for a generated schema, rows
+// and writer options (oracle.py's "write" op), and parquet-go reads it.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+// pyDecimalSize is the FIXED_LEN_BYTE_ARRAY length parquet-cpp uses for a
+// decimal of each precision (index 1..38).
+var pyDecimalSize = [...]int{0, 1, 1, 2, 2, 3, 3, 4, 4, 4, 5, 5, 6, 6, 6, 7, 7, 8, 8, 9, 9, 9, 10, 10, 11, 11, 11, 12, 12, 13, 13, 13, 14, 14, 15, 15, 16, 16, 16}
+
+// pyOptions are the writer options passed to pyarrow.parquet.write_table.
+type pyOptions struct {
+	comp            string // file-wide codec ("" = pyarrow's default, snappy)
+	dictionary      bool   // use_dictionary for the columns without an encoding of their own
+	pageVersion     string // "1.0" or "2.0"
+	statistics      bool
+	rowGroupSize    int // 0 = default
+	dataPageSize    int // 0 = default
+	batchSize       int // 0 = default
+	pageIndex       bool
+	elemName        string // name of LIST elements ("element" = compliant)
+	decimalAsInt    bool   // store_decimal_as_integer
+	keyValue        map[string]string
+	dictPageLimit   int
+	pyarrowEncoding map[string]string // column path -> pyarrow encoding name
+	pyarrowDict     []string          // column paths dictionary-encoded on request
+	pyarrowComp     map[string]string // column path -> codec
+}
+
+func (o pyOptions) String() string {
+	return fmt.Sprintf("comp=%q dict=%v v%s stats=%v rowgroup=%d pagesize=%d batch=%d index=%v elem=%q decimalint=%v kv=%v dictlimit=%d enc=%v dictcols=%v colcomp=%v",
+		o.comp, o.dictionary, o.pageVersion, o.statistics, o.rowGroupSize, o.dataPageSize, o.batchSize, o.pageIndex, o.elemName, o.decimalAsInt, o.keyValue, o.dictPageLimit, o.pyarrowEncoding, o.pyarrowDict, o.pyarrowComp)
+}
+
+func genPyOptions(tc hegel.TestCase) pyOptions {
+	o := pyOptions{
+		comp:         pick(tc, "", "", "snappy", "gzip", "brotli", "zstd", "lz4", "none"),
+		dictionary:   chance(tc, 60),
+		pageVersion:  pick(tc, "1.0", "2.0", "2.0"),
+		statistics:   chance(tc, 70),
+		pageIndex:    chance(tc, 50),
+		elemName:     pick(tc, "element", "element", "element", "element", "element", "element", "item", "array", "x"),
+		decimalAsInt: chance(tc, 40),
+	}
+	if chance(tc, 50) {
+		o.rowGroupSize = n(tc, 1, 7)
+	}
+	if chance(tc, 40) {
+		o.dataPageSize = pick(tc, 1, 64, 1024)
+	}
+	if chance(tc, 30) {
+		o.batchSize = n(tc, 1, 5)
+	}
+	if chance(tc, 30) {
+		o.keyValue = map[string]string{"k" + strconv.Itoa(n(tc, 0, 9)): genString(tc)}
+	}
+	if chance(tc, 20) {
+		o.dictPageLimit = pick(tc, 1, 64, 4096)
+	}
+	return o
+}
+
+// pyarrowSpec adapts a generated schema to what pyarrow can write: no ENUM
+// (a string), no bare repeated fields (a LIST), decimals in the physical
+// type pyarrow picks for the precision and the store_decimal_as_integer
+// option, and pyarrow's encodings and codecs on the leaves.
+func pyarrowSpec(tc hegel.TestCase, f fieldSpec, o pyOptions) fieldSpec {
+	if f.kind == kEnum {
+		f.kind = kString
+	}
+	if f.rep == "repeated" {
+		f.rep = "list"
+	}
+	switch f.kind {
+	case kDec32, kDec64, kDecFixed:
+		switch {
+		case o.decimalAsInt && f.precision <= 9:
+			f.kind, f.fixedLen = kDec32, 0
+		case o.decimalAsInt && f.precision <= 18:
+			f.kind, f.fixedLen = kDec64, 0
+		default:
+			f.kind, f.fixedLen = kDecFixed, pyDecimalSize[f.precision]
+		}
+	}
+	f.enc, f.comp = "", ""
+	if f.kind != kGroup && !f.isMap {
+		if chance(tc, 50) {
+			f.pyEnc = pick(tc, pyEncodings(f.kind)...)
+		}
+		if chance(tc, 25) {
+			f.pyComp = pick(tc, "snappy", "gzip", "brotli", "zstd", "lz4", "none")
+		}
+	}
+	for i := range f.fields {
+		f.fields[i] = pyarrowSpec(tc, f.fields[i], o)
+	}
+	return f
+}
+
+// pyEncodings are the encodings pyarrow accepts for a kind ("dict" goes to
+// use_dictionary, the others to column_encoding).
+func pyEncodings(k kind) []string {
+	switch k {
+	case kBool:
+		return []string{"dict", "PLAIN", "RLE"}
+	case kFloat, kDouble:
+		return []string{"dict", "PLAIN", "BYTE_STREAM_SPLIT"}
+	case kString, kBytes, kJSON:
+		return []string{"dict", "PLAIN", "DELTA_LENGTH_BYTE_ARRAY", "DELTA_BYTE_ARRAY"}
+	case kFixed, kUUID, kDecFixed:
+		return []string{"dict", "PLAIN", "DELTA_BYTE_ARRAY", "BYTE_STREAM_SPLIT"}
+	}
+	return []string{"dict", "PLAIN", "DELTA_BINARY_PACKED", "BYTE_STREAM_SPLIT"}
+}
+
+// pyLeafPaths maps the parquet column paths of the schema (with pyarrow's
+// list element name) to their specs.
+func pyLeafPaths(f fieldSpec, prefix, elem string, out map[string]fieldSpec) {
+	for _, s := range f.fields {
+		p := s.name
+		if prefix != "" {
+			p = prefix + "." + s.name
+		}
+		switch {
+		case s.isMap:
+			out[p+".key_value.key"] = fieldSpec{name: "key", kind: kString}
+			out[p+".key_value.value"] = fieldSpec{name: "value", kind: s.kind, pyComp: s.pyComp, pyEnc: s.pyEnc}
+		case s.rep == "list":
+			if s.kind == kGroup {
+				pyLeafPaths(s, p+".list."+elem, elem, out)
+			} else {
+				out[p+".list."+elem] = s
+			}
+		case s.kind == kGroup:
+			pyLeafPaths(s, p, elem, out)
+		default:
+			out[p] = s
+		}
+	}
+}
+
+// specJSON is the spec as oracle.py reads it.
+func specJSON(f fieldSpec) map[string]any {
+	m := map[string]any{
+		"name": f.name, "kind": f.kind.String(), "optional": f.optional, "rep": f.rep,
+		"elemOptional": f.elemOptional, "isMap": f.isMap, "fixedLen": f.fixedLen,
+		"scale": f.scale, "precision": f.precision, "utc": f.utc, "fields": nil,
+	}
+	if f.kind == kGroup {
+		fields := make([]any, len(f.fields))
+		for i, s := range f.fields {
+			fields[i] = specJSON(s)
+		}
+		m["fields"] = fields
+	}
+	return m
+}
+
+// optionsJSON are the keyword arguments of write_table (plus the oracle's
+// own two), with the per-column encodings and codecs from the leaves.
+func (o *pyOptions) optionsJSON(spec fieldSpec) map[string]any {
+	paths := map[string]fieldSpec{}
+	pyLeafPaths(spec, "", o.elemName, paths)
+	o.pyarrowEncoding = map[string]string{}
+	o.pyarrowComp = map[string]string{}
+	o.pyarrowDict = nil
+	for p, leaf := range paths {
+		switch leaf.pyEnc {
+		case "":
+		case "dict":
+			o.pyarrowDict = append(o.pyarrowDict, p)
+		default:
+			o.pyarrowEncoding[p] = leaf.pyEnc
+		}
+		if leaf.pyComp != "" {
+			o.pyarrowComp[p] = leaf.pyComp
+		}
+	}
+	m := map[string]any{
+		"data_page_version":        o.pageVersion,
+		"write_statistics":         o.statistics,
+		"write_page_index":         o.pageIndex,
+		"list_element_name":        o.elemName,
+		"store_decimal_as_integer": o.decimalAsInt,
+		"version":                  "2.6",
+	}
+	if len(o.pyarrowComp) > 0 {
+		comp := map[string]any{}
+		for p, c := range o.pyarrowComp {
+			comp[p] = c
+		}
+		// A per-column dict has no file-wide default: pyarrow uses snappy
+		// for the other columns... unless the file codec is given too.
+		if o.comp != "" {
+			for p := range paths {
+				if _, ok := comp[p]; !ok {
+					comp[p] = o.comp
+				}
+			}
+		}
+		m["compression"] = comp
+	} else if o.comp != "" {
+		m["compression"] = o.comp
+	}
+	if len(o.pyarrowEncoding) > 0 {
+		m["column_encoding"] = o.pyarrowEncoding
+	}
+	switch {
+	case o.dictionary && len(o.pyarrowEncoding) == 0 && len(o.pyarrowDict) == 0:
+		m["use_dictionary"] = true
+	case o.dictionary:
+		var cols []string
+		for p, leaf := range paths {
+			if leaf.pyEnc == "" || leaf.pyEnc == "dict" {
+				cols = append(cols, p)
+			}
+		}
+		m["use_dictionary"] = cols
+	case len(o.pyarrowDict) > 0:
+		m["use_dictionary"] = o.pyarrowDict
+	default:
+		m["use_dictionary"] = false
+	}
+	if o.rowGroupSize > 0 {
+		m["row_group_size"] = o.rowGroupSize
+	}
+	if o.dataPageSize > 0 {
+		m["data_page_size"] = o.dataPageSize
+	}
+	if o.batchSize > 0 {
+		m["write_batch_size"] = o.batchSize
+	}
+	if o.keyValue != nil {
+		m["key_value"] = o.keyValue
+	}
+	if o.dictPageLimit > 0 {
+		m["dictionary_pagesize_limit"] = o.dictPageLimit
+	}
+	return m
+}
+
+// pyWritten is what the oracle says about a file it wrote.
+type pyWritten struct {
+	ok           bool
+	reason       string
+	schema       string
+	numRowGroups int
+}
+
+func pythonWrite(t testing.TB, path string, spec fieldSpec, rows []any, options map[string]any) pyWritten {
+	m, err := pyOracle().call(map[string]any{"op": "write", "path": path, "schema": specJSON(spec), "rows": rows, "options": options})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	w := pyWritten{ok: boolean(m["ok"])}
+	if !w.ok {
+		w.reason = str(m["reason"])
+		return w
+	}
+	w.schema = str(m["schema"])
+	w.numRowGroups = int(num(m["num_row_groups"]))
+	return w
+}
+
+// valueCanon is the canonical form of a parquet.Value of the leaf, as a
+// statistics bound (see statCanon).
+func valueCanon(f fieldSpec, v parquet.Value) any {
+	switch f.kind {
+	case kBool:
+		return v.Boolean()
+	case kInt8, kInt16, kInt32, kDec32, kDate, kTimeMs:
+		return strconv.FormatInt(int64(v.Int32()), 10)
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return strconv.FormatInt(v.Int64(), 10)
+	case kUint8, kUint16, kUint32:
+		return strconv.FormatUint(uint64(v.Uint32()), 10)
+	case kUint64:
+		return strconv.FormatUint(v.Uint64(), 10)
+	case kFloat:
+		return fmt.Sprintf("f32:%08x", math.Float32bits(v.Float()))
+	case kDouble:
+		return fmt.Sprintf("f64:%016x", math.Float64bits(v.Double()))
+	case kDecFixed:
+		return twosComplement(v.ByteArray()).String()
+	}
+	return hex.EncodeToString(v.ByteArray())
+}
+
+func hasList(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.rep == "list" || (s.kind == kGroup && hasList(s)) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelReadsWhatPyarrowWrites: parquet-go reads a file pyarrow wrote for
+// a generated schema, rows and writer options back to the value, through
+// the reflection Reader; the row API yields the rows; the file's row
+// groups, key/value metadata, column statistics and page index say what
+// the rows and options say.
+func TestHegelReadsWhatPyarrowWrites(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "py.parquet")
+	property(t, func(ht *hegel.T) {
+		o := genPyOptions(ht)
+		spec := pyarrowSpec(ht, genSchema(ht), o)
+		typ := baseType(spec)
+		rows := genRows(ht, spec, typ)
+		canon := make([]any, len(rows))
+		for i, r := range rows {
+			canon[i] = canonBase(spec, r)
+		}
+		options := o.optionsJSON(spec)
+		desc := fmt.Sprintf("schema %s, %d rows, pyarrow options %s", spec, len(rows), o)
+		curDesc = desc
+		w := pythonWrite(ht, path, spec, canon, options)
+		if !w.ok {
+			count("pyarrow refuses: " + firstLine(w.reason))
+			return
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		desc += "\nparquet schema:\n" + w.schema
+		info := caseInfo{prop: "pyarrow", spec: spec, rows: len(rows), pyOpts: o}
+
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			fail(ht, "%s: OpenFile: %v", desc, err)
+		}
+		if f.NumRows() != int64(len(rows)) {
+			fail(ht, "%s: OpenFile reports %d rows, pyarrow wrote %d", desc, f.NumRows(), len(rows))
+		}
+		groups := f.RowGroups()
+		if len(groups) != w.numRowGroups {
+			fail(ht, "%s: parquet-go sees %d row groups, pyarrow wrote %d", desc, len(groups), w.numRowGroups)
+		}
+		if o.rowGroupSize > 0 && len(rows) > 0 && len(groups) != (len(rows)+o.rowGroupSize-1)/o.rowGroupSize {
+			fail(ht, "%s: %d row groups for %d rows with row_group_size %d", desc, len(groups), len(rows), o.rowGroupSize)
+		}
+		for k, v := range o.keyValue {
+			got, ok := f.Lookup(k)
+			if !ok || got != v {
+				fail(ht, "%s: key/value metadata %q = %q (present %v), want %q", desc, k, got, ok, v)
+			}
+		}
+		info.stage = "read"
+		if id := known(info); id != "" {
+			count("known " + id)
+			return
+		}
+		guard(ht, desc, info, func() {
+			// The reflection reader.
+			info.stage = "reflect"
+			if id := known(info); id != "" {
+				count("known " + id)
+			} else {
+				back, err := readReflect(data, typ)
+				if err != nil {
+					info.stage = "error"
+					if id := known(info); id != "" {
+						count("known " + id)
+						return
+					}
+					fail(ht, "%s: reading: %v", desc, err)
+				}
+				if len(back) != len(rows) {
+					fail(ht, "%s: %d rows read of %d", desc, len(back), len(rows))
+				}
+				for i := range rows {
+					if got := canonBase(spec, back[i]); !reflect.DeepEqual(canon[i], got) {
+						info.stage = "values"
+						if id := known(info); id != "" {
+							count("known " + id)
+							break
+						}
+						fail(ht, "%s: row %d differs:\n  pyarrow wrote   %s\n  parquet-go reads %s", desc, i, jsonString(canon[i]), jsonString(got))
+					}
+				}
+			}
+
+			// The row API and the column chunks.
+			leaves := flatLeaves(spec)
+			var start int64
+			for gi, rg := range groups {
+				rr := rg.Rows()
+				buf := make([]parquet.Row, 3)
+				var seen int64
+				for {
+					k, err := rr.ReadRows(buf)
+					seen += int64(k)
+					if err != nil {
+						if err.Error() != "EOF" {
+							info.stage = "error"
+							if id := known(info); id != "" {
+								count("known " + id)
+								return
+							}
+							fail(ht, "%s: ReadRows in row group %d: %v", desc, gi, err)
+						}
+						break
+					}
+					if k == 0 {
+						break
+					}
+				}
+				rr.Close()
+				if seen != rg.NumRows() {
+					fail(ht, "%s: the row API yields %d rows of row group %d, which has %d", desc, seen, gi, rg.NumRows())
+				}
+				if start+rg.NumRows() > int64(len(rows)) {
+					fail(ht, "%s: row groups hold more rows (%d+) than pyarrow wrote (%d)", desc, start+rg.NumRows(), len(rows))
+				}
+				groupRows := rows[start : start+rg.NumRows()]
+				start += rg.NumRows()
+				checkChunks(ht, desc, gi, rg, leaves, groupRows, o)
+			}
+			if start != int64(len(rows)) {
+				fail(ht, "%s: row groups hold %d rows, pyarrow wrote %d", desc, start, len(rows))
+			}
+		})
+	})
+}
+
+// guard runs body, letting the property's own control flow through and
+// classifying panics of the code under test with the gates.
+func guard(ht *hegel.T, desc string, info caseInfo, body func()) {
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		if _, ok := r.(collected); ok {
+			panic(r)
+		}
+		tn := reflect.TypeOf(r).String()
+		if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+			panic(r)
+		}
+		if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+			panic(r)
+		}
+		info.stage, info.panic = "panic", fmt.Sprint(r)
+		if id := known(info); id != "" {
+			count("known " + id)
+			return
+		}
+		fail(ht, "%s: reading panics: %v", desc, r)
+	}()
+	body()
+}
+
+func firstLine(s string) string {
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		s = s[:i]
+	}
+	if len(s) > 120 {
+		s = s[:120]
+	}
+	return s
+}
+
+// checkChunks compares the column chunks of the flat leaves in one row
+// group, as parquet-go reads them, with the rows: the value count, the null
+// count and the bounds of the chunk statistics, and the page index.
+func checkChunks(ht *hegel.T, desc string, gi int, rg parquet.RowGroup, leaves []flatLeaf, groupRows []reflect.Value, o pyOptions) {
+	chunks := rg.ColumnChunks()
+	byPath := map[string]parquet.ColumnChunk{}
+	for _, c := range chunks {
+		byPath[strings.Join(rg.Schema().Columns()[c.Column()], ".")] = c
+	}
+	for _, leaf := range leaves {
+		c, ok := byPath[leaf.path]
+		if !ok {
+			fail(ht, "%s: no column chunk at path %q in row group %d (paths %v)", desc, leaf.path, gi, rg.Schema().Columns())
+		}
+		chunk := c.(*parquet.FileColumnChunk)
+		var nulls int64
+		var minV, maxV reflect.Value
+		nan := false
+		for _, row := range groupRows {
+			v, ok := leaf.get(row)
+			if !ok {
+				nulls++
+				continue
+			}
+			if isNaN(leaf.spec, v) {
+				nan = true
+				continue
+			}
+			if !minV.IsValid() || statLess(leaf.spec, v, minV) {
+				minV = v
+			}
+			if !maxV.IsValid() || statLess(leaf.spec, maxV, v) {
+				maxV = v
+			}
+		}
+		if chunk.NumValues() != int64(len(groupRows)) {
+			fail(ht, "%s: column %s has %d values in row group %d of %d rows", desc, leaf.path, chunk.NumValues(), gi, len(groupRows))
+		}
+		if o.statistics && chunk.NullCount() != nulls {
+			fail(ht, "%s: column %s: parquet-go reads null count %d in row group %d, %d of its %d values are null", desc, leaf.path, chunk.NullCount(), gi, nulls, len(groupRows))
+		}
+		if o.statistics {
+			lo, hi, has := chunk.Bounds()
+			switch {
+			case !minV.IsValid() && has:
+				count("bounds present on an all-null or all-NaN column")
+			case minV.IsValid() && !has:
+				count("no bounds on " + leaf.spec.kind.String())
+			case has:
+				checkBound(ht, desc, leaf, gi, "chunk min", valueCanon(leaf.spec, lo), statCanon(leaf.spec, minV), nan)
+				checkBound(ht, desc, leaf, gi, "chunk max", valueCanon(leaf.spec, hi), statCanon(leaf.spec, maxV), nan)
+			}
+		}
+		if o.pageIndex {
+			ci, err := chunk.ColumnIndex()
+			if err != nil {
+				if !o.statistics || len(groupRows) == 0 {
+					count("no column index without statistics or rows")
+					continue
+				}
+				fail(ht, "%s: column %s: ColumnIndex: %v", desc, leaf.path, err)
+			}
+			var pageNulls int64
+			var pmin, pmax parquet.Value
+			for p := 0; p < ci.NumPages(); p++ {
+				pageNulls += ci.NullCount(p)
+				if ci.NullPage(p) {
+					continue
+				}
+				lo, hi := ci.MinValue(p), ci.MaxValue(p)
+				if lo.IsNull() || hi.IsNull() {
+					count("null bound in the page index of a non-null page")
+					continue
+				}
+				if pmin.IsNull() || valueLess(leaf.spec, lo, pmin) {
+					pmin = lo
+				}
+				if pmax.IsNull() || valueLess(leaf.spec, pmax, hi) {
+					pmax = hi
+				}
+			}
+			if pageNulls != nulls {
+				fail(ht, "%s: column %s: the page index counts %d nulls in row group %d, %d of its %d values are null", desc, leaf.path, pageNulls, gi, nulls, len(groupRows))
+			}
+			if minV.IsValid() && !pmin.IsNull() {
+				checkBound(ht, desc, leaf, gi, "page index min", valueCanon(leaf.spec, pmin), statCanon(leaf.spec, minV), nan)
+				checkBound(ht, desc, leaf, gi, "page index max", valueCanon(leaf.spec, pmax), statCanon(leaf.spec, maxV), nan)
+			} else if minV.IsValid() {
+				count("no page index bounds on " + leaf.spec.kind.String())
+			}
+		}
+	}
+}
+
+// valueLess orders two parquet.Values of the leaf as statLess does.
+func valueLess(f fieldSpec, a, b parquet.Value) bool {
+	switch f.kind {
+	case kBool:
+		return !a.Boolean() && b.Boolean()
+	case kInt8, kInt16, kInt32, kDec32, kDate, kTimeMs:
+		return a.Int32() < b.Int32()
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return a.Int64() < b.Int64()
+	case kUint8, kUint16, kUint32:
+		return a.Uint32() < b.Uint32()
+	case kUint64:
+		return a.Uint64() < b.Uint64()
+	case kFloat, kDouble:
+		x, y := a.Double(), b.Double()
+		if f.kind == kFloat {
+			x, y = float64(a.Float()), float64(b.Float())
+		}
+		if x == 0 && y == 0 {
+			return math.Signbit(x) && !math.Signbit(y)
+		}
+		return x < y
+	case kDecFixed:
+		return twosComplement(a.ByteArray()).Cmp(twosComplement(b.ByteArray())) < 0
+	}
+	return bytes.Compare(a.ByteArray(), b.ByteArray()) < 0
+}
+
+// checkBound compares one bound parquet-go read with the values' bound,
+// allowing pyarrow's truncation of long byte arrays.
+func checkBound(ht *hegel.T, desc string, leaf flatLeaf, gi int, what string, got, want any, nan bool) {
+	if reflect.DeepEqual(got, want) {
+		return
+	}
+	gs, _ := got.(string)
+	ws, _ := want.(string)
+	isMin := strings.HasSuffix(what, "min")
+	if isByteKind(leaf.spec.kind) && len(gs) < len(ws) && (isMin && strings.HasPrefix(ws, gs) || !isMin && gs > ws[:len(gs)]) {
+		count("truncated " + what)
+		return
+	}
+	if isByteKind(leaf.spec.kind) && !isMin && len(gs) <= len(ws) && gs > ws[:len(gs)] {
+		count("truncated " + what)
+		return
+	}
+	if (leaf.spec.kind == kFloat || leaf.spec.kind == kDouble) && isZeroBits(gs) && isZeroBits(ws) {
+		count("pyarrow signed-zero bound")
+		return
+	}
+	fail(ht, "%s: column %s row group %d: parquet-go reads %s %v, the values' bound is %v (NaN present: %v)", desc, leaf.path, gi, what, got, want, nan)
+}
