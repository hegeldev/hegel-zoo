+var (
+	// nanSequences: one to six finite values with a NaN among them at a
+	// drawn place (none under HEGEL_NO_KNOWN=1).
+	finites = weighted(
+		choice[float64]{1, hegel.Just(0.0)},
+		choice[float64]{3, magnitudes},
+		choice[float64]{3, hegel.Map(magnitudes, func(x float64) float64 { return -x })},
