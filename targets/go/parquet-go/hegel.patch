+// parquet-go/8: a footer whose column index lengths are negative (damage, or
+// a hostile file) makes OpenFile panic in ReadPageIndex ("makeslice: len out
+// of range" when the lengths sum to a negative number, "slice bounds out of
+// range" when one of them is negative) instead of returning an error.
+func TestHegelPinDamagedPageIndexLengthErrors(t *testing.T) {
+	type R struct {
+		A int32  `parquet:"a"`
+		B string `parquet:"b"`
+	}
+	var buf bytes.Buffer
+	if err := parquet.Write[R](&buf, []R{{1, "x"}, {2, "y"}}); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.Bytes()
+	// [data][footer][footer length, 4 bytes little-endian]["PAR1"]
+	n := len(data)
+	footerLen := int(binary.LittleEndian.Uint32(data[n-8 : n-4]))
+	footer := data[n-8-footerLen : n-8]
+	rebuild := func(edit func(md *format.FileMetaData)) []byte {
+		var md format.FileMetaData
+		if err := thrift.Unmarshal(new(thrift.CompactProtocol), footer, &md); err != nil {
+			t.Fatal(err)
+		}
+		if md.RowGroups[0].Columns[0].ColumnIndexLength == 0 {
+			t.Fatal("the writer wrote no column index; the pin needs one")
+		}
+		edit(&md)
+		newFooter, err := thrift.Marshal(new(thrift.CompactProtocol), &md)
+		if err != nil {
+			t.Fatal(err)
+		}
+		out := append([]byte(nil), data[:n-8-footerLen]...)
+		out = append(out, newFooter...)
+		out = binary.LittleEndian.AppendUint32(out, uint32(len(newFooter)))
+		return append(out, "PAR1"...)
+	}
+	open := func(name string, damaged []byte) {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Errorf("%s: OpenFile panics: %v", name, r)
+			}
+		}()
+		if _, err := parquet.OpenFile(bytes.NewReader(damaged), int64(len(damaged))); err != nil {
+			t.Logf("%s: OpenFile returns %v (fine)", name, err)
+		} else {
+			t.Logf("%s: OpenFile accepts the file (the page index is optional; fine)", name)
+		}
+	}
+	open("every column index length -1", rebuild(func(md *format.FileMetaData) {
+		for i := range md.RowGroups[0].Columns {
+			md.RowGroups[0].Columns[i].ColumnIndexLength = -1
+		}
+	}))
+	open("one column index length -1", rebuild(func(md *format.FileMetaData) {
+		md.RowGroups[0].Columns[0].ColumnIndexLength = -1
+	}))
+	open("one offset index length -1", rebuild(func(md *format.FileMetaData) {
+		md.RowGroups[0].Columns[1].OffsetIndexLength = -1
+	}))
+}
