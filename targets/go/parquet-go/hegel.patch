--- /dev/null
+++ b/hegel/hegel_reverse_test.go
@@ -0,0 +1,828 @@
+package hegel
+
+// The other direction: pyarrow writes a file for a generated schema, rows
+// and writer options (oracle.py's "write" op), and parquet-go reads it. The
+// options are a record; pyarrow's per-column encodings and codecs are a tape
+// of choices in the record, applied to the leaves in order by pyarrowSpec,
+// a pure function of the schema and the record.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+// pyDecimalSize is the FIXED_LEN_BYTE_ARRAY length parquet-cpp uses for a
+// decimal of each precision (index 1..38).
+var pyDecimalSize = [...]int{0, 1, 1, 2, 2, 3, 3, 4, 4, 4, 5, 5, 6, 6, 6, 7, 7, 8, 8, 9, 9, 9, 10, 10, 11, 11, 11, 12, 12, 13, 13, 13, 14, 14, 15, 15, 16, 16, 16}
+
+// columnChoice is pyarrow's treatment of one leaf: an encoding (0 none, 1
+// dictionary, else 2 plus an index into the other encodings pyarrow accepts
+// for the leaf's kind, taken modulo their number) and a codec ("" none).
+type columnChoice struct {
+	enc  int
+	comp string
+}
+
+func (c columnChoice) GoString() string { return fmt.Sprintf("{enc %d, comp %q}", c.enc, c.comp) }
+
+// pyOptions are the writer options passed to pyarrow.parquet.write_table.
+type pyOptions struct {
+	comp          string // file-wide codec ("" = pyarrow's default, snappy)
+	dictionary    bool   // use_dictionary for the columns without an encoding of their own
+	pageVersion   string // "1.0" or "2.0"
+	statistics    bool
+	rowGroupSize  int // 0 = default
+	dataPageSize  int // 0 = default
+	batchSize     int // 0 = default
+	pageIndex     bool
+	elemName      string // name of LIST elements ("element" = compliant)
+	decimalAsInt  bool   // store_decimal_as_integer
+	keyValue      map[string]string
+	dictPageLimit int
+	columns       []columnChoice // the leaves' encodings and codecs, in order, modulo the length
+}
+
+func (o pyOptions) String() string {
+	return fmt.Sprintf("comp=%q dict=%v v%s stats=%v rowgroup=%d pagesize=%d batch=%d index=%v elem=%q decimalint=%v kv=%v dictlimit=%d columns=%#v",
+		o.comp, o.dictionary, o.pageVersion, o.statistics, o.rowGroupSize, o.dataPageSize, o.batchSize, o.pageIndex, o.elemName, o.decimalAsInt, o.keyValue, o.dictPageLimit, o.columns)
+}
+
+func (o pyOptions) GoString() string { return o.String() }
+
+var (
+	pyCodecs     = pick("snappy", "gzip", "brotli", "zstd", "lz4", "none")
+	pageVersions = pick("1.0", "2.0", "2.0")
+	// elemNames: the LIST element name, "element" (the compliant one) two
+	// times in three, else what older writers use (parquet-go/9's shape;
+	// never under HEGEL_NO_KNOWN=1).
+	elemNames     = weighted(choice[string]{6, hegel.Just("element")}, choice[string]{unless(noKnown, 3), pick("item", "array", "x")})
+	columnChoices = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) columnChoice {
+		return columnChoice{enc: hegel.Draw(tc, maybe(50, hegel.Integers(1, 4))), comp: hegel.Draw(tc, maybe(25, pyCodecs))}
+	})).MaxSize(6)
+)
+
+// dataPageSizesFor is the data page size for a page version: the default
+// most often, else tiny or small. Under HEGEL_NO_KNOWN=1 pages v2 are never
+// tiny (parquet-cpp then writes a data page of zero values for an empty map
+// or list, parquet-go/13's shape).
+func dataPageSizesFor(version string) hegel.Generator[int] {
+	if noKnown && version == "2.0" {
+		return maybe(40, hegel.Just(1024))
+	}
+	return maybe(40, pick(1, 64, 1024))
+}
+
+// pyOptionGens are the generators of the option fields a property may
+// shape: the file-wide dictionary switch, the page version, statistics, the
+// page index, the row group size and the per-column choices.
+type pyOptionGens struct {
+	dictionary   hegel.Generator[bool]
+	pageVersion  hegel.Generator[string]
+	statistics   hegel.Generator[bool]
+	pageIndex    hegel.Generator[bool]
+	rowGroupSize hegel.Generator[int]
+	batchSize    hegel.Generator[int]
+	columns      hegel.Generator[[]columnChoice]
+}
+
+// defaultPyOptionGens are the generators of the wide property.
+var defaultPyOptionGens = pyOptionGens{
+	dictionary:   chance(60),
+	pageVersion:  pageVersions,
+	statistics:   chance(70),
+	pageIndex:    chance(50),
+	rowGroupSize: maybe(50, hegel.Integers(1, 7)),
+	batchSize:    maybe(30, hegel.Integers(1, 5)),
+	columns:      columnChoices,
+}
+
+// pyOptionsOf is the options record drawn from the generators.
+func pyOptionsOf(g pyOptionGens) hegel.Generator[pyOptions] {
+	return hegel.Composite(func(tc hegel.TestCase) pyOptions {
+		version := hegel.Draw(tc, g.pageVersion)
+		return pyOptions{
+			comp:          hegel.Draw(tc, pick("", "", "snappy", "gzip", "brotli", "zstd", "lz4", "none")),
+			dictionary:    hegel.Draw(tc, g.dictionary),
+			pageVersion:   version,
+			statistics:    hegel.Draw(tc, g.statistics),
+			rowGroupSize:  hegel.Draw(tc, g.rowGroupSize),
+			dataPageSize:  hegel.Draw(tc, dataPageSizesFor(version)),
+			batchSize:     hegel.Draw(tc, g.batchSize),
+			pageIndex:     hegel.Draw(tc, g.pageIndex),
+			elemName:      hegel.Draw(tc, elemNames),
+			decimalAsInt:  hegel.Draw(tc, chance(40)),
+			keyValue:      hegel.Draw(tc, maybe(30, keyValues)),
+			dictPageLimit: hegel.Draw(tc, maybe(20, pick(1, 64, 4096))),
+			columns:       hegel.Draw(tc, g.columns),
+		}
+	})
+}
+
+// pyarrowSpec adapts a generated schema to what pyarrow can write: no ENUM
+// (a string), no bare repeated fields (a LIST), decimals in the physical
+// type pyarrow picks for the precision and the store_decimal_as_integer
+// option, and pyarrow's encodings and codecs on the leaves from the
+// options' tape of column choices, in leaf order.
+func pyarrowSpec(f fieldSpec, o pyOptions) fieldSpec {
+	next := 0
+	return pyarrowField(f, o, &next)
+}
+
+func pyarrowField(f fieldSpec, o pyOptions, next *int) fieldSpec {
+	if f.kind == kEnum {
+		f.kind = kString
+	}
+	if f.rep == "repeated" {
+		f.rep = "list"
+	}
+	switch f.kind {
+	case kDec32, kDec64, kDecFixed:
+		switch {
+		case o.decimalAsInt && f.precision <= 9:
+			f.kind, f.fixedLen = kDec32, 0
+		case o.decimalAsInt && f.precision <= 18:
+			f.kind, f.fixedLen = kDec64, 0
+		default:
+			f.kind, f.fixedLen = kDecFixed, pyDecimalSize[f.precision]
+		}
+	}
+	f.enc, f.comp = "", ""
+	if f.kind != kGroup && !f.isMap && len(o.columns) > 0 {
+		c := o.columns[*next%len(o.columns)]
+		*next++
+		switch {
+		case c.enc == 1:
+			f.pyEnc = "dict"
+		case c.enc > 1:
+			encs := pyEncodings(f.kind)
+			f.pyEnc = encs[(c.enc-2)%len(encs)]
+		}
+		f.pyComp = c.comp
+	}
+	for i := range f.fields {
+		f.fields[i] = pyarrowField(f.fields[i], o, next)
+	}
+	return f
+}
+
+// pyEncodings are the encodings pyarrow accepts for a kind in
+// column_encoding (dictionary encoding goes to use_dictionary). Under
+// HEGEL_NO_KNOWN=1 booleans are not asked for RLE (parquet-go/12's shape).
+func pyEncodings(k kind) []string {
+	switch k {
+	case kBool:
+		if noKnown {
+			return []string{"PLAIN"}
+		}
+		return []string{"PLAIN", "RLE"}
+	case kFloat, kDouble:
+		return []string{"PLAIN", "BYTE_STREAM_SPLIT"}
+	case kString, kBytes, kJSON:
+		return []string{"PLAIN", "DELTA_LENGTH_BYTE_ARRAY", "DELTA_BYTE_ARRAY"}
+	case kFixed, kUUID, kDecFixed:
+		return []string{"PLAIN", "DELTA_BYTE_ARRAY", "BYTE_STREAM_SPLIT"}
+	}
+	return []string{"PLAIN", "DELTA_BINARY_PACKED", "BYTE_STREAM_SPLIT"}
+}
+
+// pyLeafPaths maps the parquet column paths of the schema (with pyarrow's
+// list element name) to their specs.
+func pyLeafPaths(f fieldSpec, prefix, elem string, out map[string]fieldSpec) {
+	for _, s := range f.fields {
+		p := s.name
+		if prefix != "" {
+			p = prefix + "." + s.name
+		}
+		switch {
+		case s.isMap:
+			out[p+".key_value.key"] = fieldSpec{name: "key", kind: kString}
+			out[p+".key_value.value"] = fieldSpec{name: "value", kind: s.kind, pyComp: s.pyComp, pyEnc: s.pyEnc}
+		case s.rep == "list":
+			if s.kind == kGroup {
+				pyLeafPaths(s, p+".list."+elem, elem, out)
+			} else {
+				out[p+".list."+elem] = s
+			}
+		case s.kind == kGroup:
+			pyLeafPaths(s, p, elem, out)
+		default:
+			out[p] = s
+		}
+	}
+}
+
+// specJSON is the spec as oracle.py reads it.
+func specJSON(f fieldSpec) map[string]any {
+	m := map[string]any{
+		"name": f.name, "kind": f.kind.String(), "optional": f.optional, "rep": f.rep,
+		"elemOptional": f.elemOptional, "isMap": f.isMap, "fixedLen": f.fixedLen,
+		"scale": f.scale, "precision": f.precision, "utc": f.utc, "fields": nil,
+	}
+	if f.kind == kGroup {
+		fields := make([]any, len(f.fields))
+		for i, s := range f.fields {
+			fields[i] = specJSON(s)
+		}
+		m["fields"] = fields
+	}
+	return m
+}
+
+// optionsJSON are the keyword arguments of write_table (plus the oracle's
+// own two), with the per-column encodings and codecs from the leaves.
+func (o pyOptions) optionsJSON(spec fieldSpec) map[string]any {
+	paths := map[string]fieldSpec{}
+	pyLeafPaths(spec, "", o.elemName, paths)
+	encoding := map[string]string{}
+	comp := map[string]any{}
+	var dict []string
+	for p, leaf := range paths {
+		switch leaf.pyEnc {
+		case "":
+		case "dict":
+			dict = append(dict, p)
+		default:
+			encoding[p] = leaf.pyEnc
+		}
+		if leaf.pyComp != "" {
+			comp[p] = leaf.pyComp
+		}
+	}
+	m := map[string]any{
+		"data_page_version":        o.pageVersion,
+		"write_statistics":         o.statistics,
+		"write_page_index":         o.pageIndex,
+		"list_element_name":        o.elemName,
+		"store_decimal_as_integer": o.decimalAsInt,
+		"version":                  "2.6",
+	}
+	if len(comp) > 0 {
+		// A per-column dict has no file-wide default: pyarrow uses snappy
+		// for the other columns... unless the file codec is given too.
+		if o.comp != "" {
+			for p := range paths {
+				if _, ok := comp[p]; !ok {
+					comp[p] = o.comp
+				}
+			}
+		}
+		m["compression"] = comp
+	} else if o.comp != "" {
+		m["compression"] = o.comp
+	}
+	if len(encoding) > 0 {
+		m["column_encoding"] = encoding
+	}
+	switch {
+	case o.dictionary && len(encoding) == 0 && len(dict) == 0:
+		m["use_dictionary"] = true
+	case o.dictionary:
+		var cols []string
+		for p, leaf := range paths {
+			if leaf.pyEnc == "" || leaf.pyEnc == "dict" {
+				cols = append(cols, p)
+			}
+		}
+		m["use_dictionary"] = cols
+	case len(dict) > 0:
+		m["use_dictionary"] = dict
+	default:
+		m["use_dictionary"] = false
+	}
+	if o.rowGroupSize > 0 {
+		m["row_group_size"] = o.rowGroupSize
+	}
+	if o.dataPageSize > 0 {
+		m["data_page_size"] = o.dataPageSize
+	}
+	if o.batchSize > 0 {
+		m["write_batch_size"] = o.batchSize
+	}
+	if o.keyValue != nil {
+		m["key_value"] = o.keyValue
+	}
+	if o.dictPageLimit > 0 {
+		m["dictionary_pagesize_limit"] = o.dictPageLimit
+	}
+	return m
+}
+
+// pyWritten is what the oracle says about a file it wrote.
+type pyWritten struct {
+	ok           bool
+	reason       string
+	schema       string
+	numRowGroups int
+}
+
+func pythonWrite(t testing.TB, path string, spec fieldSpec, rows []any, options map[string]any) pyWritten {
+	m, err := pyOracle().call(map[string]any{"op": "write", "path": path, "schema": specJSON(spec), "rows": rows, "options": options})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	w := pyWritten{ok: boolean(m["ok"])}
+	if !w.ok {
+		w.reason = str(m["reason"])
+		return w
+	}
+	w.schema = str(m["schema"])
+	w.numRowGroups = int(num(m["num_row_groups"]))
+	return w
+}
+
+// valueCanon is the canonical form of a parquet.Value of the leaf, as a
+// statistics bound (see statCanon).
+func valueCanon(f fieldSpec, v parquet.Value) any {
+	switch f.kind {
+	case kBool:
+		return v.Boolean()
+	case kInt8, kInt16, kInt32, kDec32, kDate, kTimeMs:
+		return strconv.FormatInt(int64(v.Int32()), 10)
+	case kInt64, kDec64, kTimeUs, kTimeNs, kTsMs, kTsUs, kTsNs:
+		return strconv.FormatInt(v.Int64(), 10)
+	case kUint8, kUint16, kUint32:
+		return strconv.FormatUint(uint64(v.Uint32()), 10)
+	case kUint64:
+		return strconv.FormatUint(v.Uint64(), 10)
+	case kFloat:
+		return fmt.Sprintf("f32:%08x", math.Float32bits(v.Float()))
+	case kDouble:
+		return fmt.Sprintf("f64:%016x", math.Float64bits(v.Double()))
+	case kDecFixed:
+		return twosComplement(v.ByteArray()).String()
+	}
+	return hex.EncodeToString(v.ByteArray())
+}
+
+func hasList(f fieldSpec) bool {
+	for _, s := range f.fields {
+		if s.rep == "list" || (s.kind == kGroup && hasList(s)) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Cases: the file pyarrow writes.
+
+// pyCase is pyarrow's writer options, the schema as pyarrow writes it and
+// the rows.
+type pyCase struct {
+	o    pyOptions
+	spec fieldSpec
+	rows []reflect.Value
+}
+
+func (c pyCase) typ() reflect.Type { return baseType(c.spec) }
+
+func (c pyCase) String() string {
+	return fmt.Sprintf("schema %s, %d rows, pyarrow options %s", c.spec, len(c.rows), c.o)
+}
+
+func (c pyCase) GoString() string { return c.String() }
+
+// pyCasesOf is a case over a schema of the tower with the options drawn
+// from the generators and as many rows as counts says; a schema with a
+// boolean column takes pages v1 under HEGEL_NO_KNOWN=1 (parquet-cpp
+// RLE-encodes booleans in pages v2, parquet-go/12's shape).
+func pyCasesOf(tower hegel.Generator[fieldSpec], g pyOptionGens, counts hegel.Generator[int]) hegel.Generator[pyCase] {
+	options := pyOptionsOf(g)
+	v1 := g
+	v1.pageVersion = hegel.Just("1.0")
+	optionsV1 := pyOptionsOf(v1)
+	return hegel.FlatMap(tower, func(spec fieldSpec) hegel.Generator[pyCase] {
+		o := options
+		if noKnown && hasBool(spec) {
+			o = optionsV1
+		}
+		return hegel.FlatMap(o, func(o pyOptions) hegel.Generator[pyCase] {
+			spec := pyarrowSpec(spec, o)
+			return hegel.Map(rowsOf(spec, counts), func(rows []reflect.Value) pyCase { return pyCase{o: o, spec: spec, rows: rows} })
+		})
+	})
+}
+
+var (
+	// emptyDictionaryCases: an empty table with dictionary encoding on,
+	// parquet-go/11's shape; emptyPlainCases: one with it off everywhere.
+	emptyDictionaryCases = pyCasesOf(schemas, withDictionary(defaultPyOptionGens, hegel.Just(true)), hegel.Just(0))
+	emptyPlainCases      = pyCasesOf(schemas, withDictionary(defaultPyOptionGens, hegel.Just(false)), hegel.Just(0))
+	// pyCases: the empty dictionary-encoded table first, at a fifth, so
+	// that TestHegelReadsWhatPyarrowWrites meets parquet-go/11 every run
+	// (none under HEGEL_NO_KNOWN=1); an empty plain table; else rows.
+	pyCases = weighted(
+		choice[pyCase]{unless(noKnown, 2), emptyDictionaryCases},
+		choice[pyCase]{1, emptyPlainCases},
+		choice[pyCase]{7, pyCasesOf(schemas, defaultPyOptionGens, someRowCounts)},
+	)
+)
+
+// withDictionary is the option generators with the file-wide dictionary
+// switch drawn from on and, when on is always false, no column asked for
+// dictionary encoding either.
+func withDictionary(g pyOptionGens, on hegel.Generator[bool]) pyOptionGens {
+	g.dictionary = on
+	g.columns = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) columnChoice {
+		// enc 1 is the dictionary; 2.. the others.
+		return columnChoice{enc: hegel.Draw(tc, maybe(50, hegel.Integers(2, 4))), comp: hegel.Draw(tc, maybe(25, pyCodecs))}
+	})).MaxSize(6)
+	return g
+}
+
+// checkPyarrowFile judges one case as TestHegelReadsWhatPyarrowWrites does:
+// parquet-go reads the file pyarrow wrote back to the value through the
+// reflection Reader, the row API yields the rows, and the file's row
+// groups, key/value metadata, column statistics and page index say what
+// the rows and options say. A file with LZ4 pages is read in a child
+// process (readFile). A disagreement on the shape of a recorded bug
+// (known.go) fails naming it; under HEGEL_NO_KNOWN=1 such a case ends.
+func checkPyarrowFile(t testing.TB, ht *hegel.T, testName, path string, c pyCase) {
+	o, spec, rows := c.o, c.spec, c.rows
+	canon := make([]any, len(rows))
+	for i, r := range rows {
+		canon[i] = canonBase(spec, r)
+	}
+	desc := c.String()
+	curDesc = desc
+	w := pythonWrite(t, path, spec, canon, o.optionsJSON(spec))
+	if !w.ok {
+		count("pyarrow refuses: " + firstLine(w.reason))
+		ht.Assume(false)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		ht.Fatalf("%v", err)
+	}
+	desc += "\nparquet schema:\n" + w.schema
+	info := caseInfo{prop: "pyarrow", spec: spec, rows: len(rows), pyOpts: o}
+
+	f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		fail(ht, "%s: OpenFile: %v", desc, err)
+	}
+	if f.NumRows() != int64(len(rows)) {
+		fail(ht, "%s: OpenFile reports %d rows, pyarrow wrote %d", desc, f.NumRows(), len(rows))
+	}
+	groups := f.RowGroups()
+	info.noFirstIndex = firstColumnIndexMissing(f)
+	if len(groups) != w.numRowGroups {
+		fail(ht, "%s: parquet-go sees %d row groups, pyarrow wrote %d", desc, len(groups), w.numRowGroups)
+	}
+	if o.rowGroupSize > 0 && len(rows) > 0 && len(groups) != (len(rows)+o.rowGroupSize-1)/o.rowGroupSize {
+		fail(ht, "%s: %d row groups for %d rows with row_group_size %d", desc, len(groups), len(rows), o.rowGroupSize)
+	}
+	for k, v := range o.keyValue {
+		got, ok := f.Lookup(k)
+		if !ok || got != v {
+			fail(ht, "%s: key/value metadata %q = %q (present %v), want %q", desc, k, got, ok, v)
+		}
+	}
+	// The reflection reader and the row API (in a child process for a file
+	// with LZ4 pages, see readFile).
+	r := readFile(testName, data, spec, len(rows)+1, usesLZ4(spec, o))
+	checkRead(ht, desc, info, r, spec, rows)
+	if len(r.groups) != len(groups) {
+		fail(ht, "%s: the row API reads %d row groups of %d", desc, len(r.groups), len(groups))
+	}
+
+	// The column chunks.
+	leaves := flatLeaves(spec)
+	var start int64
+	for gi, rg := range groups {
+		if r.groups[gi] != rg.NumRows() {
+			fail(ht, "%s: the row API yields %d rows of row group %d, which has %d", desc, r.groups[gi], gi, rg.NumRows())
+		}
+		if start+rg.NumRows() > int64(len(rows)) {
+			fail(ht, "%s: row groups hold more rows (%d+) than pyarrow wrote (%d)", desc, start+rg.NumRows(), len(rows))
+		}
+		groupRows := rows[start : start+rg.NumRows()]
+		start += rg.NumRows()
+		checkChunks(ht, desc, gi, rg, leaves, groupRows, info)
+	}
+	if start != int64(len(rows)) {
+		fail(ht, "%s: row groups hold %d rows, pyarrow wrote %d", desc, start, len(rows))
+	}
+}
