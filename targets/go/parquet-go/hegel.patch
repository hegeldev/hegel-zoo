+// TestHegelWriterPathsAgree: the deprecated Writer (whose documentation says
+// GenericWriter[any] has the same behaviour) writes the same rows to a file
+// pyarrow reads to the same values.
+func TestHegelWriterPathsAgree(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "writer.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		if len(rows) == 0 {
+			count("no rows")
+			return
+		}
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		if id := known(caseInfo{prop: "writer", spec: spec}); id != "" {
+			count("known " + id)
+			return
+		}
+		var buf bytes.Buffer
+		w := parquet.NewWriter(&buf, fo.writerOptions(schema)...)
