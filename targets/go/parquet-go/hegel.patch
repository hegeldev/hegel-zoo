+			o.elemName = hegel.Draw(tc, otherElemNames)
+			if noKnown && hasBool(root) {
+				o.pageVersion = "1.0" // parquet-go/12's shape otherwise
+			}
+			return o
+		})
+		return hegel.FlatMap(options, func(o pyOptions) hegel.Generator[pyCase] {
+			spec := pyarrowSpec(root, o)
+			rows := listsOf(groupOf(spec, map[int]hegel.Generator[reflect.Value]{0: listOf(spec.fields[0], hegel.Integers(1, 4), 30)}), hegel.Integers(1, 3))
+			return hegel.Map(rows, func(rows []reflect.Value) pyCase { return pyCase{o: o, spec: spec, rows: rows} })
+		})
+	})
+)
