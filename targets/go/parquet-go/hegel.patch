+package hegel
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime/debug"
+	"strings"
+	"testing"
+
+	"github.com/parquet-go/parquet-go"
+	"hegel.dev/go/hegel"
+)
+
+func jsonString(v any) string {
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+// writeGeneric writes the rows through GenericWriter[any], in a few batches
+// with an occasional Flush between them, and returns the file.
+func writeGeneric(tc hegel.TestCase, rows []reflect.Value, opts []parquet.WriterOption) ([]byte, error) {
+	var buf bytes.Buffer
+	w := parquet.NewGenericWriter[any](&buf, opts...)
+	vals := make([]any, len(rows))
+	for i, r := range rows {
+		vals[i] = r.Interface()
+	}
+	for len(vals) > 0 {
+		k := len(vals)
+		if chance(tc, 40) {
+			k = n(tc, 1, len(vals))
+		}
+		if _, err := w.Write(vals[:k]); err != nil {
+			return nil, err
+		}
+		vals = vals[k:]
+		if len(vals) > 0 && chance(tc, 30) {
+			if err := w.Flush(); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// leafPaths maps the parquet column paths of the schema to their specs.
+func leafPaths(f fieldSpec, prefix string, out map[string]fieldSpec) {
+	for _, s := range f.fields {
+		p := s.name
+		if prefix != "" {
+			p = prefix + "." + s.name
+		}
+		switch {
+		case s.isMap:
+			out[p+".key_value.key"] = fieldSpec{name: "key", kind: kString, comp: s.comp}
+			out[p+".key_value.value"] = fieldSpec{name: "value", kind: s.kind, comp: s.comp, enc: s.enc}
+		case s.rep == "list":
+			if s.kind == kGroup {
+				leafPaths(s, p+".list.element", out)
+			} else {
+				out[p+".list.element"] = s
+			}
+		case s.kind == kGroup:
+			leafPaths(s, p, out)
+		default:
+			out[p] = s
+		}
+	}
+}
+
+// encodingNames are what pyarrow reports for an encoding tag on a kind.
+func encodingNames(f fieldSpec) []string {
+	switch f.enc {
+	case "plain":
+		return []string{"PLAIN"}
+	case "dict":
+		return []string{"RLE_DICTIONARY", "PLAIN_DICTIONARY"}
+	case "split":
+		return []string{"BYTE_STREAM_SPLIT"}
+	case "delta":
+		switch f.kind {
+		case kString, kBytes, kFixed, kUUID, kJSON, kEnum, kDecFixed:
+			return []string{"DELTA_BYTE_ARRAY", "DELTA_LENGTH_BYTE_ARRAY"}
+		default:
+			return []string{"DELTA_BINARY_PACKED"}
+		}
+	}
+	return nil
+}
+
+func contains(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func isByteKind(k kind) bool {
+	switch k {
+	case kString, kBytes, kFixed, kUUID, kJSON, kEnum:
+		return true
+	}
+	return false
+}
+
+// checkMetadata compares what pyarrow reports about the file with the rows
+// and options it was written from.
+func checkMetadata(ht *hegel.T, desc string, spec fieldSpec, rows []reflect.Value, fo fileOptions, py pyFile) {
+	for k, v := range fo.keyValue {
+		if py.keyValue[k] != v {
+			fail(ht, "%s: key/value metadata %q = %q, want %q", desc, k, py.keyValue[k], v)
+		}
+	}
+	paths := map[string]fieldSpec{}
+	leafPaths(spec, "", paths)
+	flat := map[string]flatLeaf{}
+	for _, l := range flatLeaves(spec) {
+		flat[l.path] = l
+	}
+	var total int64
+	for gi, g := range py.rowGroups {
+		if fo.maxRows > 0 && g.numRows > fo.maxRows {
+			fail(ht, "%s: row group %d has %d rows, more than MaxRowsPerRowGroup(%d)", desc, gi, g.numRows, fo.maxRows)
+		}
+		if total+g.numRows > int64(len(rows)) {
+			fail(ht, "%s: row groups hold more rows (%d+) than were written (%d)", desc, total+g.numRows, len(rows))
+		}
+		groupRows := rows[total : total+g.numRows]
+		total += g.numRows
+		for _, col := range g.columns {
+			leaf, known := paths[col.path]
+			if !known {
+				fail(ht, "%s: pyarrow reports a column %q the schema does not have (paths %v)", desc, col.path, paths)
+			}
+			// Compression: the column's own tag, else the file's codec.
+			wantComp := compressionName(fo.comp)
+			if leaf.comp != "" {
+				wantComp = compressionName(leaf.comp)
+			}
+			if col.compression != wantComp {
+				fail(ht, "%s: column %s is compressed with %s, want %s", desc, col.path, col.compression, wantComp)
+			}
+			// Encodings: the requested one is among those used.
+			if names := encodingNames(leaf); names != nil {
+				found := false
+				for _, name := range names {
+					found = found || contains(col.encodings, name)
+				}
+				if !found {
+					count(fmt.Sprintf("requested encoding %s absent on %s (%v)", leaf.enc, leaf.kind, col.encodings))
+				}
+			}
+			// Statistics of the flat leaves.
+			fl, isFlat := flat[col.path]
+			if !isFlat {
+				continue
+			}
+			if col.numValues != g.numRows {
+				fail(ht, "%s: column %s has %d values in row group %d of %d rows", desc, col.path, col.numValues, gi, g.numRows)
+			}
+			var nulls int64
+			var minV, maxV reflect.Value
+			nan := false
+			for _, row := range groupRows {
+				v, ok := fl.get(row)
+				if !ok {
+					nulls++
+					continue
+				}
+				if isNaN(fl.spec, v) {
+					nan = true
+					continue
+				}
+				if !minV.IsValid() || statLess(fl.spec, v, minV) {
+					minV = v
+				}
+				if !maxV.IsValid() || statLess(fl.spec, maxV, v) {
+					maxV = v
+				}
+			}
+			if col.hasNullCount && col.nullCount != nulls {
+				fail(ht, "%s: column %s has null_count %d in row group %d, but %d of its %d values are null", desc, col.path, col.nullCount, gi, nulls, g.numRows)
+			}
+			if !col.hasNullCount {
+				count("no null count")
+			}
+			if !minV.IsValid() {
+				switch {
+				case col.hasMinMax && nan:
+					count("known parquet-go/4 (min/max written for an all-NaN column)")
+				case col.hasMinMax:
+					count("min/max present on an all-null column")
+				}
+				continue
+			}
+			if !col.hasMinMax {
+				if nan {
+					count("no min/max with NaN present")
+				} else {
+					count("no min/max on " + fl.spec.kind.String())
+				}
+				continue
+			}
+			wantMin, wantMax := statCanon(fl.spec, minV), statCanon(fl.spec, maxV)
+			for _, b := range []struct {
+				what      string
+				got, want any
+			}{{"min", col.min, wantMin}, {"max", col.max, wantMax}} {
+				if reflect.DeepEqual(b.got, b.want) {
+					continue
+				}
+				gs, _ := b.got.(string)
+				ws, _ := b.want.(string)
+				if isByteKind(fl.spec.kind) && len(gs) < len(ws) && (b.what == "min" && strings.HasPrefix(ws, gs) || b.what == "max" && gs > ws[:len(gs)]) {
+					count("truncated " + b.what)
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && isZeroBits(gs) && isZeroBits(ws) {
+					count("known parquet-go/4 (signed zero bound)")
+					continue
+				}
+				if (fl.spec.kind == kFloat || fl.spec.kind == kDouble) && nan && fl.spec.enc == "dict" {
+					count("known parquet-go/7 (dictionary float statistics with NaN)")
+					continue
+				}
+				fail(ht, "%s: column %s row group %d: %s statistic is %v, but the values' %s is %v (%d values, %d null)", desc, col.path, gi, b.what, b.got, b.what, b.want, g.numRows, nulls)
+			}
+		}
+	}
+	if total != int64(len(rows)) {
+		fail(ht, "%s: row groups hold %d rows, %d were written", desc, total, len(rows))
+	}
+}
+
+// TestHegelPyarrowReadsWhatParquetGoWrites: a file parquet-go writes for a
+// generated schema, rows and options is read by pyarrow to the value, and
+// its metadata (row groups, compression, encodings, null counts, minima and
+// maxima of the flat columns, key/value pairs) says what the rows and
+// options say.
+func TestHegelPyarrowReadsWhatParquetGoWrites(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "go.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		if err := os.WriteFile(path, data, 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the file: %s\nparquet schema:\n%s", desc, py.err, schema)
+		}
+		count(fmt.Sprintf("%d row groups", py.numRowGroups))
+		if py.numRows != int64(len(rows)) || len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows (metadata says %d), %d were written", desc, len(py.rows), py.numRows, len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d differs:\n  parquet-go wrote %s\n  pyarrow reads    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+		checkMetadata(ht, desc, spec, rows, fo, py)
+	})
+}
+
+// readReflect reads every row of the file into values of typ through the
+// reflection-based Reader.
+func readReflect(data []byte, typ reflect.Type) ([]reflect.Value, error) {
+	r := parquet.NewReader(bytes.NewReader(data))
+	defer r.Close()
+	var out []reflect.Value
+	for {
+		v := reflect.New(typ)
+		err := r.Read(v.Interface())
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return out, err
+		}
+		out = append(out, v.Elem())
+	}
+}
+
+// TestHegelReadsBackWhatItWrites: parquet-go reads its own file back to the
+// value, through the reflection Reader and through the row API.
+func TestHegelReadsBackWhatItWrites(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "%s: writing: %v", desc, err)
+		}
+		back, err := readReflect(data, typ)
+		if err != nil {
+			fail(ht, "%s: reading back: %v", desc, err)
+		}
+		if len(back) != len(rows) {
+			fail(ht, "%s: %d rows read back of %d", desc, len(back), len(rows))
+		}
+		for i := range rows {
+			want, got := canonBase(spec, rows[i]), canonBase(spec, back[i])
+			if !reflect.DeepEqual(want, got) {
+				fail(ht, "%s: row %d differs:\n  written %s\n  read    %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(got), schema)
+			}
+		}
+		// The row API: as many rows, each with as many values as leaves.
+		f, err := parquet.OpenFile(bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			fail(ht, "%s: OpenFile: %v", desc, err)
+		}
+		if f.NumRows() != int64(len(rows)) {
+			fail(ht, "%s: OpenFile reports %d rows, %d were written", desc, f.NumRows(), len(rows))
+		}
+		var seen int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for {
+				k, err := rr.ReadRows(buf)
+				seen += int64(k)
+				if err != nil {
+					if err.Error() != "EOF" {
+						fail(ht, "%s: ReadRows: %v", desc, err)
+					}
+					break
+				}
+				if k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if seen != int64(len(rows)) {
+			fail(ht, "%s: the row API yields %d rows, %d were written", desc, seen, len(rows))
+		}
+	})
+}
+
+// TestHegelWriterPathsAgree: the deprecated Writer (whose documentation says
+// GenericWriter[any] has the same behaviour) writes the same rows to a file
+// pyarrow reads to the same values.
+func TestHegelWriterPathsAgree(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "writer.parquet")
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		if len(rows) == 0 {
+			count("no rows")
+			return
+		}
+		fo := genFileOptions(ht, flatLeaves(spec))
+		desc := fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		curDesc = desc
+		if id := known(caseInfo{prop: "writer", spec: spec}); id != "" {
+			count("known " + id)
+			return
+		}
+		var buf bytes.Buffer
+		w := parquet.NewWriter(&buf, fo.writerOptions(schema)...)
+		for _, r := range rows {
+			if err := w.Write(r.Interface()); err != nil {
+				fail(ht, "%s: Writer.Write: %v", desc, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "%s: Writer.Close: %v", desc, err)
+		}
+		if err := os.WriteFile(path, buf.Bytes(), 0o644); err != nil {
+			ht.Fatalf("%v", err)
+		}
+		py := pythonRead(ht, path)
+		if !py.ok {
+			if hasDictBool(spec) && strings.Contains(py.err, "boolean") {
+				count("pyarrow refuses dictionary-encoded booleans")
+				return
+			}
+			fail(ht, "%s: pyarrow cannot read the Writer's file: %s", desc, py.err)
+		}
+		if len(py.rows) != len(rows) {
+			fail(ht, "%s: pyarrow reads %d rows of the Writer's file, %d were written", desc, len(py.rows), len(rows))
+		}
+		for i, r := range rows {
+			want := canonBase(spec, r)
+			if !reflect.DeepEqual(want, py.rows[i]) {
+				fail(ht, "%s: row %d of the Writer's file differs:\n  written      %s\n  pyarrow reads %s\nparquet schema:\n%s", desc, i, jsonString(want), jsonString(py.rows[i]), schema)
+			}
+		}
+	})
+}
+
+// TestHegelDamagedFilesNeverPanic: a damaged file never makes OpenFile or
+// reading its rows panic.
+func TestHegelDamagedFilesNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		spec := genSchema(ht)
+		typ := baseType(spec)
+		schema := parquet.SchemaOf(reflect.New(typ).Interface())
+		rows := genRows(ht, spec, typ)
+		fo := genFileOptions(ht, flatLeaves(spec))
+		curDesc = fmt.Sprintf("schema %s, %d rows, %s", spec, len(rows), fo)
+		data, err := writeGeneric(ht, rows, fo.writerOptions(schema))
+		if err != nil {
+			fail(ht, "schema %s: writing: %v", spec, err)
+		}
+		damaged := damage(ht, data)
+		desc := fmt.Sprintf("schema %s, %d rows, %d bytes damaged to %d bytes", spec, len(rows), len(data), len(damaged))
+		stage := "open"
+		defer func() {
+			if r := recover(); r != nil {
+				if id := known(caseInfo{prop: "damaged", panic: fmt.Sprint(r), stage: stage}); id != "" {
+					count("known " + id)
+					return
+				}
+				if dir := os.Getenv("HEGEL_DUMP"); dir != "" {
+					name := filepath.Join(dir, fmt.Sprintf("panic-%d.parquet", len(damaged)))
+					_ = os.WriteFile(name, damaged, 0o644)
+					fail(ht, "%s: %s panics: %v (file %s)\n%s", desc, stage, r, name, debug.Stack())
+				}
+				fail(ht, "%s: %s panics: %v", desc, stage, r)
+			}
+		}()
+		f, err := parquet.OpenFile(bytes.NewReader(damaged), int64(len(damaged)))
+		if err != nil {
+			count("OpenFile fails")
+			return
+		}
+		count("OpenFile succeeds")
+		stage = "read"
+		var read int64
+		for _, rg := range f.RowGroups() {
+			rr := rg.Rows()
+			buf := make([]parquet.Row, 4)
+			for read < 1000 {
+				k, err := rr.ReadRows(buf)
+				read += int64(k)
+				if err != nil || k == 0 {
+					break
+				}
+			}
+			rr.Close()
+		}
+		if _, err := readReflect(damaged, typ); err != nil {
+			count("reflect read fails")
+		}
+	})
+}
+
+// damage flips, truncates, deletes or inserts bytes.
+func damage(tc hegel.TestCase, data []byte) []byte {
+	out := append([]byte(nil), data...)
+	for k := n(tc, 1, 3); k > 0 && len(out) > 0; k-- {
+		i := n(tc, 0, len(out)-1)
+		switch n(tc, 1, 5) {
+		case 1:
+			out[i] ^= byte(1 << uint(n(tc, 0, 7)))
+		case 2:
+			out[i] = byte(pick(tc, 0, 0xff, 0x7f, 0x80, n(tc, 0, 255)))
+		case 3:
+			out = out[:i]
+		case 4:
+			j := i + n(tc, 1, 8)
+			if j > len(out) {
+				j = len(out)
+			}
+			out = append(out[:i], out[j:]...)
+		case 5:
+			ins := genBytes(tc, n(tc, 1, 8))
+			out = append(out[:i], append(ins, out[i:]...)...)
+		}
+	}
+	return out
+}
+
+// isZeroBits reports the canonical form of +0.0 or -0.0.
+func isZeroBits(c string) bool {
+	switch c {
+	case "f32:00000000", "f32:80000000", "f64:0000000000000000", "f64:8000000000000000":
+		return true
+	}
+	return false
+}
