+// bubbles/18: the line-number gutter is sized at render time from
+// MaxHeight's digits while the text width was fixed by SetWidth; with
+// MaxHeight 0 ("no limit") line 10 pushes the text one column right.
+func TestHegelPinNoLimitGutterShiftsTheText(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 12)
+	m.MaxHeight = 0
+	m.SetHeight(12)
+	m.SetValue(strings.Repeat("x\n", 11) + "x")
+	rows := plainRows(m.View())
+	col := func(r string) int { return strings.Index(zootest.Plain(zootest.Cells(r)), "x") }
+	if col(rows[0]) != col(rows[9]) {
+		t.Fatalf("MaxHeight 0: the text starts at column %d on line 1 and %d on line 10:\n%s\n%s", col(rows[0]), col(rows[9]), rows[0], rows[9])
+	}
+}
+
+// bubbles/19: SetValue (and InsertString) leave the viewport at the top
+// while the cursor is on the last line; View shows the first lines and
+// Cursor() points below the textarea until the next message.
+func TestHegelPinSetValueDoesNotScrollToTheCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.SetValue("l1\nl2\nl3\nl4\nl5\nl6")
+	if m.Line() != 5 {
+		t.Fatalf("cursor on line %d, want 5", m.Line())
+	}
+	m.SetVirtualCursor(false)
+	c := m.Cursor()
+	if m.ScrollYOffset() != 3 || c.Position.Y != 2 {
+		t.Fatalf("after SetValue of six lines in a height of 3: ScrollYOffset %d (want 3), Cursor().Y %d (want 2); view:\n%s",
+			m.ScrollYOffset(), c.Position.Y, strings.Join(plainRows(m.View()), "\n"))
+	}
+}
+
+// bubbles/20: CRLF line breaks are doubled by the sanitizer.
+func TestHegelPinCRLFPasteDoublesTheLineBreaks(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m = press(m, tea.PasteMsg{Content: "a\r\nb"})
+	if m.Value() != "a\nb" {
+		t.Fatalf("pasting \"a\\r\\nb\" gives %q, want \"a\\nb\"", m.Value())
+	}
+}
+
+// bubbles/21: MaxHeight refuses Enter at the limit but a paste adds lines
+// past it.
+func TestHegelPinPasteIgnoresMaxHeight(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.MaxHeight = 3
+	m.SetHeight(3)
+	m.SetValue("a\nb\nc")
+	m = press(m, kEnter)
+	if m.LineCount() != 3 {
+		t.Fatalf("Enter at MaxHeight 3 gave %d lines", m.LineCount())
+	}
+	m = press(m, tea.PasteMsg{Content: "x\ny\nz"})
+	if m.LineCount() > 3 {
+		t.Fatalf("a paste at MaxHeight 3 gave %d lines: %q", m.LineCount(), m.Value())
+	}
+}
+
+// bubbles/22: a MaxWidth below the prompt and gutter width drives the text
+// width negative and the view shows no text.
+func TestHegelPinSmallMaxWidthHidesTheText(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.MaxWidth = 3
+	m.SetWidth(20)
+	if m.Width() < 1 {
+		t.Errorf("MaxWidth 3: Width() = %d, want at least 1", m.Width())
+	}
+	m = press(m, typed('a'))
+	if v := m.View(); !strings.Contains(v, "a") {
+		t.Errorf("MaxWidth 3: the typed 'a' is not in the view %q", plainRows(v)[0])
+	}
+}
+
+// bubbles/23: a placeholder of white space (trimmed to nothing) renders no
+// cursor at all.
+func TestHegelPinBlankPlaceholderHasNoCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.Placeholder = "   "
+	for _, c := range zootest.Cells(strings.Split(m.View(), "\n")[0]) {
+		if c.Rev {
+			return
+		}
+	}
+	t.Fatalf("no reversed (cursor) cell in the first row of a focused textarea with a blank placeholder: %q", plainRows(m.View())[0])
+}
+
+// bubbles/25: Enter ignores CharLimit; the newline counts in Length, which
+// then exceeds the limit.
+func TestHegelPinEnterIgnoresCharLimit(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.CharLimit = 2
+	m.SetValue("ab")
+	m = press(m, kEnter)
+	if m.Length() > 2 {
+		t.Fatalf("CharLimit 2 after \"ab\": Enter gives %q, Length %d", m.Value(), m.Length())
+	}
+}
+
+// bubbles/26: an empty keyboard selection (shift+right at the end of the
+// buffer) keeps its anchor through later edits, so the next shift+arrow
+// selects from where the cursor was.
+func TestHegelPinEmptySelectionKeepsAStaleAnchor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue("o")
+	m = press(m, kSelRight) // nothing to select past the end
+	m = press(m, kKillBack) // line is now empty
+	for _, r := range "abc" {
+		m = press(m, typed(r))
+	}
+	m = press(m, kSelLeft)
+	if got := m.SelectedText(); got != "c" {
+		t.Errorf("shift+left after typing \"abc\" selects %q, want \"c\"", got)
+	}
+	// and when the anchor's line has been deleted, the next edit panics
+	m = pinArea(20, 3)
+	m.SetValue("a\n")
+	m = press(m, kSelRight)  // empty selection anchored at (1,0)
+	m = press(m, kBackspace) // joins the lines: line 1 is gone
+	m = press(m, kSelLeft)   // selection from the stale (1,0) to (0,0)
+	m = press(m, typed('x')) // deleteSelection indexes value[1]
+	if m.Value() != "x" && m.Value() != "ax" {
+		t.Errorf("value %q after the stale selection", m.Value())
+	}
+}
+
+// bubbles/24: ctrl+w on the first word of a line also deletes the space
+// before it.
+func TestHegelPinTextareaDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w after \" ab\": value %q, want \" \"", m.Value())
+	}
+}
diff --git a/textinput/hegel_shapes_test.go b/textinput/hegel_shapes_test.go
new file mode 100644
index 0000000..fe3fb44
--- /dev/null
+++ b/textinput/hegel_shapes_test.go
@@ -0,0 +1,393 @@
+package textinput
+
+// The shape regions of the recorded textinput bugs (bugs.toml bubbles/1 to 12 and 98) and
+// the narrow properties over them: each region is a generator over the bug's shape
+// with random contents, judged exactly like the wide property of its kind
+// (judgeEditing, judgePlaceholder, judgeSuggestions, judgeCursor). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (zootest.Shaped) and the property passes. Every
+// shape is deterministic in the library, so every instance reaches the bug
+// (measured with math/rand over the library: 1000 of 1000 for each of the
+// constructions below). The shapes of bubbles/2 and 4 (the placeholder without a
+// width, with a negative one), 12 and 98 (EchoNone) are drawn by the wide properties
+// too; the others are relations the wide properties reach at their natural rates.
+
+import (
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowEditing, narrowPlaceholder, narrowSuggestions and narrowCursor run a narrow
+// property: every drawn case through the wide property's judge.
+func narrowEditing(t *testing.T, cases hegel.Generator[inputCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeEditing(j, c)
+	})
+}
+
+func narrowPlaceholder(t *testing.T, cases hegel.Generator[placeholderCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePlaceholder(j, c)
+	})
+}
+
+func narrowSuggestions(t *testing.T, cases hegel.Generator[sugCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSuggestions(j, c)
+	})
+}
+
+func narrowCursor(t *testing.T, cases hegel.Generator[cursorCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+var (
+	// wordRunes: the runes of a word (no space); narrowWordRunes: the same without
+	// the wide runes; narrowPlaceholderRunes: ASCII three times in five, else a
+	// narrow rune.
+	wordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, wideRunes),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+	narrowWordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+	narrowPlaceholderRunes = zootest.Weighted(zootest.W(6, asciiRunes), zootest.W(4, narrowRunes))
+
+	noValidator = hegel.Just(validator{kind: "none"})
+)
+
+func words(lo, hi int) hegel.Generator[string] { return textsOf(wordRunes, lo, hi) }
+
+func initialOf(values hegel.Generator[string]) hegel.Generator[initial] {
+	return hegel.Map(values, func(s string) initial { return initial{set: true, s: s} })
+}
+
+// plainStart: a start with the width and value given, no limit, no validator,
+// EchoNormal.
+func plainStart(widths hegel.Generator[int], values hegel.Generator[string]) hegel.Generator[inputStart] {
+	return startsOf(widths, hegel.Just(0), noValidator, hegel.Just(EchoNormal), initialOf(values))
+}
+
+func opsOf(kinds ...string) []inputOp {
+	ops := make([]inputOp, len(kinds))
+	for i, k := range kinds {
+		ops[i] = inputOp{kind: k}
+	}
+	return ops
+}
+
+// --------------------------------------------------------------------------- bubbles/1
+
+// deleteWordForwardOnTheLastRune: a value of up to six runes, a non-space rune
+// under the cursor and, after it, nothing (alt+d on the last rune: a panic) or a
+// space and a word (deleteWordForward steps over the rune and deletes the next
+// word too); past the shape, more runes of the same word after it.
+var deleteWordForwardOnTheLastRune = hegel.Composite(func(tc hegel.TestCase) inputCase {
+	head := hegel.Draw(tc, textsOf(runes, 0, 6))
+	under := hegel.Draw(tc, wordRunes)
+	tail := hegel.Draw(tc, zootest.Shaped(
+		zootest.Weighted(
+			zootest.W(1, hegel.Just("")),
+			zootest.W(1, hegel.Map(words(1, 6), func(w string) string { return " " + w })),
+		),
+		words(1, 6),
+	))
+	start := hegel.Draw(tc, plainStart(hegel.Just(0), hegel.Just(head+string(under)+tail)))
+	return inputCase{start: start, ops: []inputOp{{kind: "setcursor", n: len([]rune(head))}, {kind: "alt+d"}}}
+})
+
+func TestHegelTextinputDeleteWordForwardOnTheLastRune(t *testing.T) {
+	narrowEditing(t, deleteWordForwardOnTheLastRune)
+}
+
+// --------------------------------------------------------------------------- bubbles/2
+
+// placeholderWithoutAWidth: a placeholder of two to twenty narrow runes and no
+// width (past the shape, a width of 1 to 24).
+var placeholderWithoutAWidth = placeholderCasesOf(
+	textsOf(narrowPlaceholderRunes, 2, 20),
+	zootest.Shaped(hegel.Just(0), zootest.Ints(1, 24)),
+)
+
+func TestHegelTextinputPlaceholderWithoutAWidth(t *testing.T) {
+	narrowPlaceholder(t, placeholderWithoutAWidth)
+}
+
+// --------------------------------------------------------------------------- bubbles/3
+
+// widePlaceholderRunes: a width of 1 to 24 and a placeholder with a wide rune among
+// the runes the field shows (after up to width narrow ones), then up to five more;
+// past the shape, a narrow rune there and narrow ones after it.
+var widePlaceholderRunes = hegel.FlatMap(zootest.Ints(1, 24), func(w int) hegel.Generator[placeholderCase] {
+	placeholder := hegel.Composite(func(tc hegel.TestCase) string {
+		prefix := hegel.Draw(tc, textsOf(narrowPlaceholderRunes, 0, w))
+		r := hegel.Draw(tc, zootest.Shaped(wideRunes, narrowPlaceholderRunes))
+		rest := hegel.Draw(tc, textsOf(zootest.Shaped(runes, narrowRunes), 0, 5))
+		return prefix + string(r) + rest
+	})
+	return placeholderCasesOf(placeholder, hegel.Just(w))
+})
+
+func TestHegelTextinputWidePlaceholderRunes(t *testing.T) {
+	narrowPlaceholder(t, widePlaceholderRunes)
+}
+
+// --------------------------------------------------------------------------- bubbles/4
+
+// negativeWidthPlaceholder: a placeholder and a width of -5 to -1 (past the shape,
+// 1 to 24).
+var negativeWidthPlaceholder = placeholderCasesOf(
+	textsOf(narrowPlaceholderRunes, 1, 20),
+	zootest.Shaped(zootest.Ints(-5, -1), zootest.Ints(1, 24)),
+)
+
+func TestHegelTextinputNegativeWidthPlaceholder(t *testing.T) {
+	narrowPlaceholder(t, negativeWidthPlaceholder)
+}
+
+// --------------------------------------------------------------------------- bubbles/5
+
+func typeOps(s string) []sugOp {
+	var ops []sugOp
+	for _, r := range s {
+		ops = append(ops, sugOp{kind: "type", r: r})
+	}
+	return ops
+}
+
+// setValueKeepsStaleSuggestions: one to three suggestions, a prefix of the first
+// typed (so that it matches), then a Reset or a SetValue of a value matching
+// nothing (a "z" first), whose matches the library keeps, and a tab that completes
+// the wrong text or panics; past the shape, a SetValue of the typed prefix itself
+// (the same matches).
+var setValueKeepsStaleSuggestions = hegel.Composite(func(tc hegel.TestCase) sugCase {
+	sugs := hegel.Draw(tc, zootest.Counted(sugWords, 1, 3))
+	first := []rune(sugs[0])
+	k := hegel.Draw(tc, zootest.Ints(1, len(first)))
+	stale := hegel.Draw(tc, zootest.Shaped(
+		zootest.Weighted(
+			zootest.W(1, sugOpOf("reset")),
+			zootest.W(1, hegel.Map(sugWords, func(w string) sugOp { return sugOp{kind: "setvalue", s: "z" + w} })),
+		),
+		hegel.Just(sugOp{kind: "setvalue", s: string(first[:k])}),
+	))
+	ops := append(typeOps(string(first[:k])), stale, sugOp{kind: "tab"})
+	return sugCase{sugs: sugs, ops: ops}
+})
+
+func TestHegelTextinputSetValueKeepsStaleSuggestions(t *testing.T) {
+	narrowSuggestions(t, setValueKeepsStaleSuggestions)
+}
+
+// --------------------------------------------------------------------------- bubbles/6
+
+// prevSuggestionWithoutAMatch: none to three suggestions and nothing typed, or a
+// value matching none (a "z" first), then up, which takes the index to -1; past the
+// shape, a prefix of the first suggestion typed, then up.
+var prevSuggestionWithoutAMatch = zootest.Shaped(
+	hegel.Composite(func(tc hegel.TestCase) sugCase {
+		sugs := hegel.Draw(tc, zootest.Counted(sugWords, 0, 3))
+		typed := hegel.Draw(tc, zootest.Weighted(
+			zootest.W(1, hegel.Just("")),
+			zootest.W(2, hegel.Map(textsOf(sugAlphabet, 0, 3), func(w string) string { return "z" + w })),
+		))
+		return sugCase{sugs: sugs, ops: append(typeOps(typed), sugOp{kind: "up"})}
+	}),
+	hegel.Composite(func(tc hegel.TestCase) sugCase {
+		sugs := hegel.Draw(tc, zootest.Counted(sugWords, 1, 3))
+		first := []rune(sugs[0])
+		k := hegel.Draw(tc, zootest.Ints(1, len(first)))
+		return sugCase{sugs: sugs, ops: append(typeOps(string(first[:k])), sugOp{kind: "up"})}
+	}),
+)
+
+func TestHegelTextinputPrevSuggestionWithoutAMatch(t *testing.T) {
+	narrowSuggestions(t, prevSuggestionWithoutAMatch)
+}
+
+// --------------------------------------------------------------------------- bubbles/7
+
+// setWidthLeavesTheWindowWide: a value of two to fourteen narrow runes and then
+// SetWidth to less than its width, which leaves the window as it was, wider than
+// the field (past the shape, a width the value fits).
+var setWidthLeavesTheWindowWide = hegel.FlatMap(zootest.Ints(2, 14), func(n int) hegel.Generator[inputCase] {
+	return casesOf(
+		plainStart(hegel.Just(0), textsOf(narrowRunes, n, n)),
+		zootest.One(setWidthOp(zootest.Shaped(zootest.Ints(1, n-1), zootest.Ints(n, 14)))),
+	)
+})
+
+func TestHegelTextinputSetWidthLeavesTheWindowWide(t *testing.T) {
+	narrowEditing(t, setWidthLeavesTheWindowWide)
+}
+
+// --------------------------------------------------------------------------- bubbles/8
+
+var (
+	cursorPrompts = zootest.Sampled("> ", "", "Name: ")
+
+	// scrolledCursor: a width of 1 to 10, a longer value of narrow runes and the
+	// cursor set inside it, so that the window is scrolled.
+	scrolledCursor = hegel.FlatMap(zootest.Ints(1, 10), func(w int) hegel.Generator[cursorCase] {
+		return hegel.FlatMap(zootest.Ints(w+1, w+5), func(n int) hegel.Generator[cursorCase] {
+			return cursorCasesOf(hegel.Just(w), zootest.Counted(narrowRunes, n, n), zootest.One(zootest.Ints(1, n-1)))
+		})
+	})
+	// wideBeforeTheCursor: no width and a wide rune before the cursor.
+	wideBeforeTheCursor = hegel.Composite(func(tc hegel.TestCase) cursorCase {
+		prefix := hegel.Draw(tc, textsOf(narrowRunes, 0, 5))
+		wide := hegel.Draw(tc, wideRunes)
+		rest := hegel.Draw(tc, textsOf(narrowRunes, 0, 5))
+		value := prefix + string(wide) + rest
+		return cursorCase{
+			prompt:  hegel.Draw(tc, cursorPrompts),
+			value:   value,
+			cursors: []int{hegel.Draw(tc, zootest.Ints(len([]rune(prefix))+1, len([]rune(value))))},
+		}
+	})
+	// fittingCursor: a narrow value no longer than the width (or any length without
+	// one) and up to four cursor positions: the window never scrolls.
+	fittingCursor = hegel.FlatMap(cursorWidths, func(w int) hegel.Generator[cursorCase] {
+		hi := 14
+		if w > 0 {
+			hi = w
+		}
+		return cursorCasesOf(hegel.Just(w), zootest.Counted(narrowRunes, 0, hi), zootest.Counted(zootest.Ints(0, 14), 0, 4))
+	})
+
+	// realCursorInAScrolledWindow: the scrolled window two times in three, the wide
+	// rune one; past the shape, a value that fits.
+	realCursorInAScrolledWindow = zootest.Shaped(
+		zootest.Weighted(zootest.W(2, scrolledCursor), zootest.W(1, wideBeforeTheCursor)),
+		fittingCursor,
+	)
+)
+
+func TestHegelTextinputRealCursorInAScrolledWindow(t *testing.T) {
+	narrowCursor(t, realCursorInAScrolledWindow)
+}
+
+// --------------------------------------------------------------------------- bubbles/9
+
+var (
+	// quietOnEmpty: the keys that leave an empty value empty and Err as the
+	// validator says.
+	quietOnEmpty = hegel.Map(zootest.Sampled("left", "right", "home", "end", "delete", "ctrl+k", "ctrl+u"), func(k string) inputOp { return inputOp{kind: k} })
+
+	// backspaceOnAnEmptyRequiredField: a "required" validator (past the shape, none
+	// or a maximum), no value or SetValue(""), up to two quiet keys and a backspace,
+	// after which the library clears Err without asking the validator.
+	backspaceOnAnEmptyRequiredField = casesOf(
+		startsOf(widths, limits,
+			zootest.Shaped(hegel.Just(validator{kind: "required"}), zootest.Weighted(zootest.W(1, noValidator), zootest.W(1, hegel.Map(zootest.Ints(1, 6), func(k int) validator { return validator{kind: "max", k: k} })))),
+			hegel.Just(EchoNormal),
+			zootest.Maybe(50, hegel.Just(initial{set: true}))),
+		zootest.Seq(zootest.Counted(quietOnEmpty, 0, 2), hegel.Just(opsOf("backspace"))),
+	)
+)
+
+func TestHegelTextinputBackspaceOnAnEmptyRequiredField(t *testing.T) {
+	narrowEditing(t, backspaceOnAnEmptyRequiredField)
+}
+
+// --------------------------------------------------------------------------- bubbles/10
+
+// deleteWordBackwardAfterOneLeadingSpace: one space (past the shape, none or two),
+// a word, then nothing or a space and more, with ctrl+w at the word's end: the
+// library deletes the space before the word too.
+var deleteWordBackwardAfterOneLeadingSpace = hegel.Composite(func(tc hegel.TestCase) inputCase {
+	lead := hegel.Draw(tc, zootest.Shaped(hegel.Just(" "), zootest.Sampled("", "  ")))
+	word := hegel.Draw(tc, words(1, 6))
+	tail := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(1, hegel.Just("")),
+		zootest.W(1, hegel.Map(textsOf(runes, 0, 6), func(t string) string { return " " + t })),
+	))
+	start := hegel.Draw(tc, plainStart(widths, hegel.Just(lead+word+tail)))
+	return inputCase{start: start, ops: []inputOp{{kind: "setcursor", n: len([]rune(lead + word))}, {kind: "ctrl+w"}}}
+})
+
+func TestHegelTextinputDeleteWordBackwardAfterOneLeadingSpace(t *testing.T) {
+	narrowEditing(t, deleteWordBackwardAfterOneLeadingSpace)
+}
+
+// --------------------------------------------------------------------------- bubbles/11
+
+// cursorScrolledPastTheWindow: a width of 1 to 10, a longer word of narrow runes,
+// home and then more rights than the window holds (past the shape, at most the
+// window's width): the window ends at the cursor and the rune under it is hidden.
+var cursorScrolledPastTheWindow = hegel.FlatMap(zootest.Ints(1, 10), func(w int) hegel.Generator[inputCase] {
+	return hegel.FlatMap(zootest.Ints(w+2, w+6), func(n int) hegel.Generator[inputCase] {
+		rights := hegel.Map(zootest.Shaped(zootest.Ints(w+1, n-1), zootest.Ints(0, w)), func(k int) []inputOp {
+			ops := opsOf("home")
+			for range k {
+				ops = append(ops, inputOp{kind: "right"})
+			}
+			return ops
+		})
+		return casesOf(plainStart(hegel.Just(w), textsOf(narrowWordRunes, n, n)), rights)
+	})
+})
+
+func TestHegelTextinputCursorScrolledPastTheWindow(t *testing.T) {
+	narrowEditing(t, cursorScrolledPastTheWindow)
+}
+
+// --------------------------------------------------------------------------- bubbles/12
+
+// echoNoneFieldShrinks: EchoNone (past the shape, EchoPassword), a width of 1 to
+// 12, a value of 1 to 14 narrow runes and a cursor key: the field is padded by the
+// hidden value's width. Narrow runes only: with a width of 1 and a wide rune last
+// the library's window is empty at the end of the value and the view is right by
+// luck (154 of 20000 with wide runes among the value's, none without; the wide
+// property draws them).
+var echoNoneFieldShrinks = casesOf(
+	startsOf(zootest.Ints(1, 12), hegel.Just(0), noValidator,
+		zootest.Shaped(hegel.Just(EchoNone), hegel.Just(EchoPassword)),
+		initialOf(textsOf(narrowRunes, 1, 14))),
+	zootest.One(hegel.Map(zootest.Sampled("left", "right", "home", "end"), func(k string) inputOp { return inputOp{kind: k} })),
+)
+
+func TestHegelTextinputEchoNoneFieldShrinks(t *testing.T) {
+	narrowEditing(t, echoNoneFieldShrinks)
+}
+
+// --------------------------------------------------------------------------- bubbles/98
+
+// echoNoneCursorInsideTheValue: EchoNone (past the shape, EchoPassword), no width, a
+// value of 1 to 14 narrow runes and home or left, which put the cursor inside the
+// value: the cursor cell is the echo of the rune under it, nothing, and the cursor
+// vanishes (1000 of 1000 by math/rand; with a width the field is bubbles/12's shape
+// first, so the region has none).
+var echoNoneCursorInsideTheValue = casesOf(
+	startsOf(hegel.Just(0), hegel.Just(0), noValidator,
+		zootest.Shaped(hegel.Just(EchoNone), hegel.Just(EchoPassword)),
+		initialOf(textsOf(narrowRunes, 1, 14))),
+	zootest.One(hegel.Map(zootest.Sampled("home", "left"), func(k string) inputOp { return inputOp{kind: k} })),
+)
+
+func TestHegelTextinputEchoNoneCursorInsideTheValue(t *testing.T) {
+	narrowEditing(t, echoNoneCursorInsideTheValue)
+}
