+// suggestion model
+type sugModel struct {
+	value   string
+	sugs    []string
+	matched []string
+	idx     int
+}
+
+func (s *sugModel) update() {
+	if s.value == "" || len(s.sugs) == 0 {
+		// Nothing matches an empty value; the index is left as it was
+		// (it is reset the next time the matches change).
+		s.matched = nil
+		return
+	}
+	var matched []string
+	for _, x := range s.sugs {
+		if strings.HasPrefix(strings.ToLower(x), strings.ToLower(s.value)) {
+			matched = append(matched, x)
+		}
+	}
+	if !equalStrings(matched, s.matched) {
+		s.idx = 0
+	}
+	s.matched = matched
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelSuggestionsFollowThePrefix: the matched suggestions are those
+// with the value as a case-insensitive prefix; up/down cycle, tab completes,
+// the view shows the completion after the cursor.
+func TestHegelSuggestionsFollowThePrefix(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		m.Focus()
+		m.ShowSuggestions = true
+		alphabet := []rune("abAB ")
+		s := &sugModel{}
+		for k := n(ht, 0, 5); k > 0; k-- {
+			var w []rune
+			for j := n(ht, 1, 5); j > 0; j-- {
+				w = append(w, pick(ht, alphabet))
+			}
+			s.sugs = append(s.sugs, string(w))
+		}
+		m.SetSuggestions(s.sugs)
+		note(ht, "suggestions %q", s.sugs)
+		if got := m.AvailableSuggestions(); !equalStrings(got, s.sugs) {
+			fail(ht, "AvailableSuggestions %q, want %q", got, s.sugs)
+		}
+		for i := n(ht, 1, 25); i > 0; i-- {
+			var what string
+			switch n(ht, 0, 9) {
+			case 0, 1, 2, 3:
+				r := pick(ht, alphabet)
+				what = fmt.Sprintf("type %q", r)
+				m = press(m, typed(r))
+				s.value += string(r)
+				s.update()
+			case 4:
+				what = "backspace"
+				m = press(m, kBackspace)
+				if rs := []rune(s.value); len(rs) > 0 {
+					s.value = string(rs[:len(rs)-1])
+				}
+				s.update()
+			case 5:
+				what = "down"
+				m = press(m, kDown)
+				s.idx++
+				if s.idx >= len(s.matched) {
+					s.idx = 0
+				}
+				s.update()
+			case 6:
+				what = "up"
+				if len(s.matched) == 0 {
+					// previousSuggestion goes to -1 with nothing matched
+					// and CurrentSuggestion then panics (bubbles/6).
+					count("bubbles/6-shape")
+					continue
+				}
+				m = press(m, kUp)
+				s.idx--
+				if s.idx < 0 {
+					s.idx = len(s.matched) - 1
+				}
+				s.update()
+			case 7, 8:
+				what = "tab"
+				m = press(m, kTab)
+				if len(s.matched) > 0 {
+					// The typed prefix keeps its case; the suggestion's
+					// remainder is appended.
+					s.value += string([]rune(s.matched[s.idx])[len([]rune(s.value)):])
+				}
+				s.update()
+			default:
+				// SetValue and Reset leave the matched suggestions where
+				// they were (bubbles/5): the sequence ends here.
+				count("bubbles/5-shape")
+				return
+			}
+			note(ht, "%s -> %q matched %q idx %d", what, m.Value(), m.MatchedSuggestions(), m.CurrentSuggestionIndex())
+			if m.Value() != s.value {
+				fail(ht, "after %s: value %q, want %q", what, m.Value(), s.value)
+			}
+			if got := m.MatchedSuggestions(); !equalStrings(got, s.matched) {
+				fail(ht, "after %s: matched %q, want %q (value %q of %q)", what, got, s.matched, s.value, s.sugs)
+			}
+			if m.CurrentSuggestionIndex() != s.idx {
+				fail(ht, "after %s: suggestion index %d, want %d (matched %q)", what, m.CurrentSuggestionIndex(), s.idx, s.matched)
+			}
+			wantCur := ""
+			if s.idx < len(s.matched) {
+				wantCur = s.matched[s.idx]
+			}
+			if got := m.CurrentSuggestion(); got != wantCur {
+				fail(ht, "after %s: CurrentSuggestion %q, want %q", what, got, wantCur)
+			}
+			// The view: value, then the rest of the current suggestion.
+			plain := zootest.Plain(zootest.Cells(m.View()))
+			want := m.Prompt + s.value
+			if len(s.matched) > 0 && len([]rune(wantCur)) > len([]rune(s.value)) {
+				want += string([]rune(wantCur)[len([]rune(s.value)):])
+			} else {
+				want += " "
+			}
+			if plain != want {
+				fail(ht, "after %s: view %q, want %q (matched %q idx %d)", what, plain, want, s.matched, s.idx)
+			}
+		}
+	})
+}
