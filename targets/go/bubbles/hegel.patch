+		return st
+	}),
+	zootest.One(nOp("setwidth", zootest.Shaped[hegel.Generator[int]](zootest.Ints(3, 9), zootest.Ints(10, 60)))),
+)
+
+// TestHegelTreeSetSizeMeasuresTheHelpAtTheNewWidth: SetSize sizes the
+// viewport by the help's height at the new width.
+func TestHegelTreeSetSizeMeasuresTheHelpAtTheNewWidth(t *testing.T) {
+	narrowTree(t, setSizeMeasuresTheHelpAtTheNewWidth)
+}
+
+// threeRowValues: three or four words on their own rows.
+var threeRowValues = hegel.Map(zootest.Counted(plainValues, 3, 4), func(rows []string) string {
+	return strings.Join(rows, "\n")
+})
+
+// setNodesScrollsToTheRoot: eight to twelve leaves in a window of two rows,
+// the last selected, then SetNodes of a closed root taller than the window
+// (the selection clamped to the root, the offset past it, the shape of
+// bubbles/90, 1000 of 1000); past it a closed root of one row.
+var setNodesScrollsToTheRoot = casesOf(
+	hegel.Map(plainStarts(leavesOf(8, 12), hegel.Just(4)), withHelp),
+	zootest.Seq(
+		zootest.One(bottomOps),
+		zootest.One(setNodesOf(subOf(zootest.Shaped[hegel.Generator[string]](threeRowValues, plainValues), never, zootest.Counted(plainLeaves, 1, 2), never))),
+	),
+)
+
+// TestHegelTreeSetNodesScrollsToTheRoot: SetNodes clamping the selection to
+// the root scrolls it into view.
+func TestHegelTreeSetNodesScrollsToTheRoot(t *testing.T) {
+	narrowTree(t, setNodesScrollsToTheRoot)
+}
diff --git a/tree/hegel_test.go b/tree/hegel_test.go
new file mode 100644
index 0000000..a1f156a
--- /dev/null
+++ b/tree/hegel_test.go
@@ -0,0 +1,1423 @@
+package tree
+
+// Hegel properties of the tree component against the true model of its
+// layout, its selection and its scroll.
+//
+// A case is a record of a start (the tree's nodes, the size, the scroll-off,
+// whether the help is shown, the cursor and the open/closed characters, the
+// rounded enumerator, a TreeStyle or NodeStyle alternative) and a list of
+// operation records applied in order: every default binding through Update
+// (each of its keys, the spacebar among the page-down keys), SetYOffset,
+// SetSize/SetHeight/SetWidth, SetScrollOff, SetShowHelp, SetNodes (a drawn
+// tree or nil), SetCursorCharacter, Node.SetValue on a drawn node followed by
+// SetNodes of the same root, and the Root().Value() query.
+//
+// The model states what the library should do. The visible nodes are laid
+// out in DFS order through the open nodes, a hidden node and its subtree
+// skipped, with a node offset and a line offset that counts every rendered
+// row above the node: the rows of a multi-line ancestor (bubbles/86), the
+// indicator row of an open, empty-valued node with children (bubbles/88),
+// the padding rows of a padded node style (bubbles/85). The rows are the
+// cursor column joined to the tree's rows (indents, enumerators, indicators,
+// continuation rows, a frame of the TreeStyle around them, bubbles/83 and
+// /84), a value wider than the width cut by the viewport, not wrapped
+// (bubbles/79), a child's SetValue drawn (bubbles/80), a nil root drawn as
+// an empty value (bubbles/82). The selection is clamped as the library
+// clamps it; the viewport's height is Height less the help's height at the
+// current width and help mode (bubbles/77, /89); the viewport's offset
+// follows the library's own scroll-off rule after every operation, a resize
+// (bubbles/78) and a SetNodes clamping the selection to the root (bubbles/90)
+// included; the spacebar pages down (bubbles/87); Root().Value() carries one
+// indicator (bubbles/81); SetNodes(nil) is an empty tree (bubbles/75, where
+// the library panics: Judge.Recover names it).
+//
+// Before each operation a classifier over the model and the operation names
+// the recorded bug whose shape the step has (a space key, 87; `?` changing
+// the help's height, 77; a width change with the full help shown, 89; a
+// resize whose true scroll differs from none, 78; a movement of zero at the
+// root with the offset past it, 90; SetNodes(nil), 75; Root().Value() with an
+// indicator, 81; SetValue on a child, 80), and a classifier over the state
+// names the shape the layout has (a hidden node, 76; a nil root, 82; the
+// three styles, 83/84/85; a node whose library line offset is short, 86/88;
+// a row wider than the width, 79; a child with a stale value, 80). Every
+// comparison is then made and fails naming the shape.
+//
+// Under HEGEL_NO_KNOWN=1 the shapes are not drawn: no wide values, no narrow
+// widths, no multi-line or empty value on a node with children, no hidden
+// node, no nil tree, no style, no spacebar; and the operations whose shape
+// is a relation with the live state (77, 78, 89, 90, 81, 80) are dropped
+// from the case on a replay of the model (unshaped).
+//
+// Only the first child of a parent is ever hidden: hiding any other child
+// panics inside lipgloss's renderer, which calls the enumerator style
+// function with an index past the shortened sibling list (lipgloss/30), a
+// dependency bug that is not ours to draw.
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	ltree "charm.land/lipgloss/v2/tree"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/help"
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+var property = zootest.Property
+
+// ---------------------------------------------------------------- specs
+
+// tSpec is a drawn node: its value, whether it was made with Root (a sub,
+// with an indicator and maybe children), its open state, whether it is
+// hidden (only ever the first child of its parent, see the header) and its
+// children; nilRoot is the nil tree of New(nil) and SetNodes(nil).
+type tSpec struct {
+	val     string
+	sub     bool
+	open    bool
+	hidden  bool
+	kids    []tSpec
+	nilRoot bool
+}
+
+func (n tSpec) String() string {
+	if n.nilRoot {
+		return "nil"
+	}
+	s := fmt.Sprintf("%q", n.val)
+	if n.hidden {
+		s = "hidden " + s
+	}
+	if !n.sub {
+		return s
+	}
+	if !n.open {
+		s += " closed"
+	}
+	parts := make([]string, len(n.kids))
+	for i, k := range n.kids {
+		parts[i] = k.String()
+	}
+	return s + "{" + strings.Join(parts, ", ") + "}"
+}
+
+var words = []string{"a", "bb", "ccc", "dddd", "emacs", "zsh", "go.mod", "x", "README", "tools", "img.png", "b2", "q"}
+
+// plainValues: one word, at most seven columns wide, so that no row of a
+// tree three levels deep is wider than twenty-four columns.
+var plainValues = zootest.Sampled(words...)
+
+// wideValues: a word repeated eight to fourteen times, wider than most widths
+// (the row then wraps, bubbles/79).
+var wideValues = hegel.FlatMap(plainValues, func(w string) hegel.Generator[string] {
+	return hegel.Map(zootest.Ints(8, 14), func(n int) string { return strings.Repeat(w+"-", n) })
+})
+
+// multiLineValues: two or three words on their own rows.
+var multiLineValues = hegel.Map(zootest.Counted(plainValues, 2, 3), func(rows []string) string {
+	return strings.Join(rows, "\n")
+})
+
+// leafValues: a plain word, or an empty, multi-line or (bubbles/79, off under
+// HEGEL_NO_KNOWN=1) wide value.
+var leafValues = zootest.Weighted(
+	zootest.W(85, plainValues),
+	zootest.W(3, hegel.Just("")),
+	zootest.W(10, multiLineValues),
+	zootest.W(zootest.Unless(zootest.NoKnown, 2), wideValues),
+)
+
+// subValues: the values of a node with children; an empty one (bubbles/88) or
+// a multi-line one (bubbles/86) is the shape of the offsets below it.
+var subValues = zootest.Weighted(
+	zootest.W(85, plainValues),
+	zootest.W(zootest.Unless(zootest.NoKnown, 3), hegel.Just("")),
+	zootest.W(zootest.Unless(zootest.NoKnown, 10), multiLineValues),
+	zootest.W(zootest.Unless(zootest.NoKnown, 2), wideValues),
+)
+
+// newValues: the values SetValue gives a node, none of them a word of the
+// tree.
+var newValues = zootest.Sampled("alpha", "beta", "gamma", "delta")
+
+func leafOf(values hegel.Generator[string]) hegel.Generator[tSpec] {
+	return hegel.Map(values, func(v string) tSpec { return tSpec{val: v} })
+}
+
+var (
+	leafSpecs = leafOf(leafValues)
+	opens     = zootest.Weighted(zootest.W(3, hegel.Just(true)), zootest.W(1, hegel.Just(false)))
+	rootOpens = zootest.Weighted(zootest.W(9, hegel.Just(true)), zootest.W(1, hegel.Just(false)))
+	always    = hegel.Just(true)
+	never     = hegel.Just(false)
+
+	// hiddenFirsts: the first child hidden (bubbles/76), never under
+	// HEGEL_NO_KNOWN=1.
+	hiddenFirsts = zootest.Coin(zootest.Unless(zootest.NoKnown, 8))
+)
+
+// subOf is a node made with Root: its value, its open state, its children
+// and whether the first of them is hidden.
+func subOf(values hegel.Generator[string], opens hegel.Generator[bool], kids hegel.Generator[[]tSpec], hidden hegel.Generator[bool]) hegel.Generator[tSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) tSpec {
+		n := tSpec{sub: true, val: hegel.Draw(tc, values), open: hegel.Draw(tc, opens), kids: hegel.Draw(tc, kids)}
+		if len(n.kids) > 0 && hegel.Draw(tc, hidden) {
+			n.kids[0].hidden = true
+		}
+		return n
+	})
+}
+
+// specsOf is a node of the given depth: a leaf, or a sub with up to four
+// children of the depth below.
+func specsOf(depth int) hegel.Generator[tSpec] {
+	if depth == 0 {
+		return leafSpecs
+	}
+	return zootest.Weighted(
+		zootest.W(45, leafSpecs),
+		zootest.W(55, subOf(subValues, opens, zootest.Counted(specsOf(depth-1), 0, 4), hiddenFirsts)),
+	)
+}
+
+// rootSpecs: a root three levels deep with one to four children.
+var rootSpecs = subOf(subValues, rootOpens, zootest.Counted(specsOf(2), 1, 4), hiddenFirsts)
+
+// trees: the nil tree (bubbles/82 at the start, the shape the wide property
+// is mapped to and shrinks to, so first at a solid weight; bubbles/75 in
+// SetNodes), never under HEGEL_NO_KNOWN=1, or a drawn root.
+var trees = zootest.Weighted(
+	zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just(tSpec{nilRoot: true})),
+	zootest.W(19, rootSpecs),
+)
+
+// ---------------------------------------------------------------- starts
+
+type charPair struct{ open, closed string }
+
+var (
+	defaultChars = charPair{"\u25BC", "\u25B6"}
+	plusChars    = charPair{"-", "+"}
+	noChars      = charPair{"", ""}
+)
+
+// tStart is the start of a case.
+type tStart struct {
+	tree    tSpec
+	w, h    int
+	so      int
+	help    bool // the help shown
+	full    bool // the full help from the start (bubbles/89's narrow property)
+	cursor  string
+	chars   charPair
+	rounded bool
+	style   string // "", "top" (PaddingTop(1)), "border" or "padded" (NodeStyle PaddingBottom(1))
+}
+
+func (st tStart) String() string {
+	return fmt.Sprintf("tree %s %dx%d so %d help %v full %v cursor %q chars %q/%q rounded %v style %q",
+		st.tree, st.w, st.h, st.so, st.help, st.full, st.cursor, st.chars.open, st.chars.closed, st.rounded, st.style)
+}
+
+var (
+	// widths: a narrow one wraps a plain row (bubbles/79), off under
+	// HEGEL_NO_KNOWN=1.
+	widths  = zootest.Weighted(zootest.W(97, zootest.Ints(24, 60)), zootest.W(zootest.Unless(zootest.NoKnown, 3), zootest.Ints(6, 23)))
+	heights = zootest.Weighted(zootest.W(95, zootest.Ints(3, 18)), zootest.W(5, zootest.Ints(0, 2)))
+	// scrollOffs: the default five, or a drawn one.
+	scrollOffs = zootest.Weighted(zootest.W(6, hegel.Just(5)), zootest.W(4, zootest.Ints(0, 8)))
+	helps      = zootest.Weighted(zootest.W(8, hegel.Just(true)), zootest.W(2, hegel.Just(false)))
+	cursors    = zootest.Weighted(zootest.W(80, hegel.Just("\u2192")), zootest.W(10, hegel.Just("")), zootest.W(10, hegel.Just("\U0001F449")))
+	charPairs  = zootest.Weighted(zootest.W(85, hegel.Just(defaultChars)), zootest.W(10, hegel.Just(plusChars)), zootest.W(5, hegel.Just(noChars)))
+	roundeds   = zootest.Coin(20)
+	// styles: the three styles of bubbles/83, /84 and /85, never under
+	// HEGEL_NO_KNOWN=1.
+	styles = zootest.Weighted(
+		zootest.W(94, hegel.Just("")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just("top")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just("border")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just("padded")),
+	)
+	noStyle = hegel.Just("")
+)
+
+func startsOf(trees hegel.Generator[tSpec], widths, heights hegel.Generator[int], styles hegel.Generator[string]) hegel.Generator[tStart] {
+	return hegel.Composite(func(tc hegel.TestCase) tStart {
+		return tStart{
+			tree:    hegel.Draw(tc, trees),
+			w:       hegel.Draw(tc, widths),
+			h:       hegel.Draw(tc, heights),
+			so:      hegel.Draw(tc, scrollOffs),
+			help:    hegel.Draw(tc, helps),
+			cursor:  hegel.Draw(tc, cursors),
+			chars:   hegel.Draw(tc, charPairs),
+			rounded: hegel.Draw(tc, roundeds),
+			style:   hegel.Draw(tc, styles),
+		}
+	})
+}
+
+var treeStarts = startsOf(trees, widths, heights, styles)
+
+// build makes the library's model of the start over root (nil for the nil
+// tree) with every option applied, sized and rendered as the model is.
+func (st tStart) build(root *Node) Model {
+	m := New(root, st.w, st.h)
+	m.SetScrollOff(st.so)
+	m.SetShowHelp(st.help)
+	m.SetCursorCharacter(st.cursor)
+	m.SetOpenCharacter(st.chars.open)
+	m.SetClosedCharacter(st.chars.closed)
+	if st.rounded {
+		m.Enumerator(ltree.RoundedEnumerator)
+	}
+	if st.style != "" {
+		s := m.styles
+		switch st.style {
+		case "top":
+			s.TreeStyle = lipgloss.NewStyle().PaddingTop(1)
+		case "border":
+			s.TreeStyle = lipgloss.NewStyle().Border(lipgloss.NormalBorder())
+		case "padded":
+			s.NodeStyle = lipgloss.NewStyle().PaddingBottom(1)
+		}
+		m.SetStyles(s)
+	}
+	m.Help.ShowAll = st.full
+	m.SetSize(st.w, st.h)
+	m.SetNodes(m.Root())
+	return m
+}
+
+// ---------------------------------------------------------------- ops
+
+// tOp is one operation: a key press (key), SetYOffset/SetHeight/SetWidth/
+// SetScrollOff (n), SetSize (w, h), SetShowHelp (on), SetNodes (tree),
+// SetCursorCharacter (s), SetValue on the node n modulo the live count (n,
+// s), or the Root().Value() query.
+type tOp struct {
+	kind string
+	key  tea.KeyPressMsg
+	n    int
+	w, h int
+	on   bool
+	tree tSpec
+	s    string
+}
+
+func (o tOp) GoString() string {
+	switch o.kind {
+	case "setyoffset", "setheight", "setwidth", "setscrolloff":
+		return fmt.Sprintf("%s(%d)", o.kind, o.n)
+	case "setsize":
+		return fmt.Sprintf("setsize(%d,%d)", o.w, o.h)
+	case "setshowhelp":
+		return fmt.Sprintf("setshowhelp(%v)", o.on)
+	case "setnodes":
+		return "setnodes(" + o.tree.String() + ")"
+	case "setcursor":
+		return fmt.Sprintf("setcursor(%q)", o.s)
+	case "setvalue":
+		return fmt.Sprintf("setvalue(%d,%q)", o.n, o.s)
+	case "rootvalue":
+		return "rootvalue"
+	}
+	return o.kind + "(" + o.key.String() + ")"
+}
+
+func ch(r rune) tea.KeyPressMsg   { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+func ctrl(r rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: r, Mod: tea.ModCtrl} }
+func code(c rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: c} }
+
+var spaceKey = tea.KeyPressMsg{Code: tea.KeySpace, Text: " "}
+
+// keyed is the binding kind pressed by one of its keys.
+func keyed(kind string, keys ...tea.KeyPressMsg) hegel.Generator[tOp] {
+	if len(keys) == 1 {
+		return hegel.Just(tOp{kind: kind, key: keys[0]})
+	}
+	return hegel.Map(zootest.Sampled(keys...), func(k tea.KeyPressMsg) tOp { return tOp{kind: kind, key: k} })
+}
+
+func nOp(kind string, ns hegel.Generator[int]) hegel.Generator[tOp] {
+	return hegel.Map(ns, func(n int) tOp { return tOp{kind: kind, n: n} })
+}
+
+// pageDownKeys: pgdown, f or the spacebar (bubbles/87, off under
+// HEGEL_NO_KNOWN=1).
+var pageDownKeys = zootest.Weighted(
+	zootest.W(2, hegel.Just(code(tea.KeyPgDown))),
+	zootest.W(1, hegel.Just(ch('f'))),
+	zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(spaceKey)),
+)
+
+var (
+	downOps     = keyed("down", code(tea.KeyDown), ch('j'), ctrl('n'))
+	upOps       = keyed("up", code(tea.KeyUp), ch('k'), ctrl('p'))
+	pgdownOps   = hegel.Map(pageDownKeys, func(k tea.KeyPressMsg) tOp { return tOp{kind: "pgdown", key: k} })
+	pgupOps     = keyed("pgup", code(tea.KeyPgUp), ch('b'))
+	halfdownOps = keyed("halfdown", ch('d'), ctrl('d'))
+	halfupOps   = keyed("halfup", ch('u'), ctrl('u'))
+	topOps      = keyed("top", ch('g'), code(tea.KeyHome))
+	bottomOps   = keyed("bottom", ch('G'), code(tea.KeyEnd))
+	toggleOps   = keyed("toggle", code(tea.KeyEnter))
+	openOps     = keyed("open", ch('l'), code(tea.KeyRight))
+	closeOps    = keyed("close", ch('h'), code(tea.KeyLeft))
+	helpOps     = keyed("help", ch('?'))
+	// setYOffsetOps takes a literal offset, maybe out of range.
+	setYOffsetOps = nOp("setyoffset", zootest.Ints(-1, 24))
+	setSizeOps    = hegel.Composite(func(tc hegel.TestCase) tOp {
+		return tOp{kind: "setsize", w: hegel.Draw(tc, widths), h: hegel.Draw(tc, heights)}
+	})
+	setHeightOps    = nOp("setheight", heights)
+	setWidthOps     = nOp("setwidth", widths)
+	setScrollOffOps = nOp("setscrolloff", zootest.Ints(0, 8))
+	setShowHelpOps  = hegel.Map(zootest.Sampled(false, true), func(on bool) tOp { return tOp{kind: "setshowhelp", on: on} })
+	setNodesOps     = hegel.Map(trees, func(t tSpec) tOp { return tOp{kind: "setnodes", tree: t} })
+	setCursorOps    = hegel.Map(zootest.Sampled("\u2192", ">", "", "\U0001F449", "\u00BB"), func(c string) tOp { return tOp{kind: "setcursor", s: c} })
+	setValueOps     = hegel.Composite(func(tc hegel.TestCase) tOp {
+		return tOp{kind: "setvalue", n: hegel.Draw(tc, zootest.Ints(0, 24)), s: hegel.Draw(tc, newValues)}
+	})
+	rootValueOps = hegel.Just(tOp{kind: "rootvalue"})
+)
+
+// treeOps: the operations at the weights of the old step table, the setters
+// and the queries added at one each.
+var treeOps = zootest.Weighted(
+	zootest.W(8, downOps),
+	zootest.W(6, upOps),
+	zootest.W(3, pgdownOps),
+	zootest.W(3, pgupOps),
+	zootest.W(2, halfdownOps),
+	zootest.W(2, halfupOps),
+	zootest.W(2, topOps),
+	zootest.W(2, bottomOps),
+	zootest.W(6, toggleOps),
+	zootest.W(3, openOps),
+	zootest.W(3, closeOps),
+	zootest.W(2, helpOps),
+	zootest.W(2, setYOffsetOps),
+	zootest.W(3, setSizeOps),
+	zootest.W(2, setHeightOps),
+	zootest.W(1, setWidthOps),
+	zootest.W(2, setScrollOffOps),
+	zootest.W(2, setShowHelpOps),
+	zootest.W(1, setNodesOps),
+	zootest.W(1, setCursorOps),
+	zootest.W(1, setValueOps),
+	zootest.W(1, rootValueOps),
+)
+
+// tCase is a start and the operations applied to it.
+type tCase struct {
+	start tStart
+	ops   []tOp
+}
+
+func (c tCase) GoString() string {
+	parts := make([]string, len(c.ops))
+	for i, op := range c.ops {
+		parts[i] = op.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(parts, ", ")
+}
+
+func casesOf(starts hegel.Generator[tStart], ops hegel.Generator[[]tOp]) hegel.Generator[tCase] {
+	return hegel.Composite(func(tc hegel.TestCase) tCase {
+		return tCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// treeCases: a start and one to forty-five operations.
+var treeCases = casesOf(treeStarts, zootest.Counted(treeOps, 1, 45))
+
+// ---------------------------------------------------------------- model
+
+// tn is one live node of the model: its value and rows, whether it was made
+// with Root, its open and hidden state, its children (hidden ones included),
+// the library's node, the rows the library draws it with (the value given at
+// its creation, or the root's last SetValue: a child's SetValue is not drawn,
+// bubbles/80, stale), and the layout: parent, last sibling, the ancestors'
+// indents, the offset in nodes, the line offset (true), the line offset
+// without the padding rows of a padded style (base) and the one the library
+// computes (lib, short under a multi-line or an empty-valued node, bubbles/86
+// and /88).
+type tn struct {
+	val     string
+	rows    []string
+	sub     bool
+	open    bool
+	hidden  bool
+	nilRoot bool
+	kids    []*tn
+	node    *Node
+	libRows int
+	stale   bool
+
+	parent *tn
+	last   bool
+	pre    string
+	y      int
+	line   int
+	base   int
+	lib    int
+}
+
+// build makes the live node of a spec with the library's nodes under it
+// (the nil tree: a root with an empty value and no library node yet).
+func (n tSpec) build() *tn {
+	t := &tn{val: n.val, rows: strings.Split(n.val, "\n"), sub: n.sub, open: n.open, hidden: n.hidden, nilRoot: n.nilRoot}
+	t.libRows = len(t.rows)
+	if n.nilRoot {
+		t.sub, t.open = true, true
+		return t
+	}
+	if !n.sub {
+		return t
+	}
+	root := Root(n.val)
+	for _, k := range n.kids {
+		kt := k.build()
+		t.kids = append(t.kids, kt)
+		if k.sub {
+			root.Child(kt.node)
+		} else {
+			root.Child(k.val)
+		}
+	}
+	for i, kn := range root.ChildNodes() {
+		t.kids[i].node = kn
+		if t.kids[i].hidden {
+			kn.SetHidden(true)
+		}
+	}
+	if !n.open {
+		root.Close()
+	}
+	t.node = root
+	return t
+}
+
+func (n *tn) clone() *tn {
+	c := *n
+	c.rows = append([]string(nil), n.rows...)
+	c.kids = make([]*tn, len(n.kids))
+	for i, k := range n.kids {
+		c.kids[i] = k.clone()
+	}
+	return &c
+}
+
+// tm is the model: the tree, the visible nodes, the selection, the sizes
+// and the viewport, and the content as rendered at the last update.
+type tm struct {
+	root     *tn
+	vis      []*tn
+	sel      int
+	w, h     int
+	vh       int // the viewport's height
+	vpY      int // the viewport's offset
+	so       int
+	showHelp bool
+	showAll  bool
+	lastEnum string
+	openCh   string
+	closedCh string
+	cursor   string
+	style    string
+
+	rows    []string // the content rows at the last render
+	total   int      // their count
+	wide    bool     // a tree row wider than the width at the last render (bubbles/79)
+	renderW int
+	lines   int // the tree's rows at the last layout, padding excluded
+}
+
+// helpStyle is the default help style the model measures the help with.
+var helpStyle = DefaultDarkStyles().HelpStyle
+
+// helpLines is the height of the help view at a width, short or full.
+func helpLines(w int, showAll bool) int {
+	h := help.New()
+	h.SetWidth(w)
+	h.ShowAll = showAll
+	return lipgloss.Height(helpStyle.Render(h.View(Model{KeyMap: DefaultKeyMap()})))
+}
+
+func newTm(st tStart) *tm {
+	s := &tm{w: st.w, h: st.h, so: st.so, showHelp: st.help, showAll: st.full, cursor: st.cursor,
+		openCh: st.chars.open, closedCh: st.chars.closed, lastEnum: "\u2514\u2500\u2500", style: st.style}
+	if st.rounded {
+		s.lastEnum = "\u2570\u2500\u2500"
+	}
+	s.root = st.tree.build()
+	s.vh = s.viewportHeight(st.w)
+	s.layout()
+	s.update(0, true)
+	return s
+}
+
+func (s *tm) clone() *tm {
+	c := *s
+	c.root = s.root.clone()
+	c.vis = nil
+	c.rows = append([]string(nil), s.rows...)
+	c.layout()
+	return &c
+}
+
+// viewportHeight is Height less the help's height at the width w.
+func (s *tm) viewportHeight(w int) int {
+	if s.showHelp {
+		return s.h - helpLines(w, s.showAll)
+	}
+	return s.h
+}
+
+func (s *tm) frameTop() int {
+	if s.style == "top" || s.style == "border" {
+		return 1
+	}
+	return 0
+}
+
+// layout lays the visible nodes out in DFS order with their offsets, and
+// computes the library's line offsets beside the true ones.
+func (s *tm) layout() {
+	s.vis = s.vis[:0]
+	s.lines = 0
+	s.walk(s.root, nil, true, "")
+	s.root.lib = 0
+	s.libLines(s.root)
+}
+
+func (s *tm) walk(n *tn, parent *tn, last bool, pre string) {
+	n.parent, n.last, n.pre = parent, last, pre
+	n.y = len(s.vis)
+	n.base = s.lines
+	s.lines += len(n.rows)
+	s.vis = append(s.vis, n)
+	if !n.sub || !n.open {
+		return
+	}
+	kpre := pre
+	if parent != nil { // the root's children carry no indent
+		if last {
+			kpre += "   "
+		} else {
+			kpre += "\u2502  "
+		}
+	}
+	for i, k := range n.kids {
+		if k.hidden {
+			continue
+		}
+		s.walk(k, n, i == len(n.kids)-1, kpre)
+	}
+}
+
+// libLines replays setYOffsets: a child's line offset is the parent's plus
+// the earlier siblings' extra rows plus its index, hidden siblings counted,
+// a parent's own extra rows never (bubbles/86), an open empty-valued sibling's
+// indicator row never (bubbles/88).
+func (s *tm) libLines(n *tn) {
+	above := 0
+	for i, k := range n.kids {
+		k.lib = n.lib + above + i + 1
+		if k.sub && k.open {
+			s.libLines(k)
+		}
+		above += libHeight(k) - 1
+	}
+}
+
+// libHeight is Node.Height(): the node rendered as a tree of its own, whose
+// empty root line lipgloss omits.
+func libHeight(n *tn) int {
+	if n.hidden {
+		return 1
+	}
+	if !n.sub || !n.open {
+		if n.val == "" {
+			return 1
+		}
+		return n.libRows
+	}
+	h := n.libRows
+	if n.val == "" {
+		h = 0
+	}
+	for _, k := range n.kids {
+		h += drawnRows(k)
+	}
+	return max(h, 1)
+}
+
+// drawnRows are the rows of a node drawn inside its parent.
+func drawnRows(n *tn) int {
+	if n.hidden {
+		return 0
+	}
+	h := n.libRows
+	if n.sub && n.open {
+		for _, k := range n.kids {
+			h += drawnRows(k)
+		}
+	}
+	return h
+}
+
+func (s *tm) indicator(n *tn) string {
+	if !n.sub {
+		return ""
+	}
+	ch := s.closedCh
+	if n.open {
+		ch = s.openCh
+	}
+	if ch != "" {
+		ch += " "
+	}
+	return ch
+}
+
+// nodeRows are the rendered rows of one node, without the cursor column: the
+// enumerator, the indicator and the value's first row, the continuation rows
+// under the indent, and the padding row of a padded style under an
+// unselected leaf (the selected one has the selected style, unpadded).
+func (s *tm) nodeRows(n *tn, selected bool) []string {
+	ind := s.indicator(n)
+	pad := strings.Repeat(" ", ansi.StringWidth(ind))
+	var out []string
+	if n.parent == nil {
+		out = append(out, ind+n.rows[0])
+		for _, r := range n.rows[1:] {
+			out = append(out, pad+r)
+		}
+		return out
+	}
+	enum, indent := "\u251C\u2500\u2500", "\u2502  "
+	if n.last {
+		enum, indent = s.lastEnum, "   "
+	}
+	out = append(out, n.pre+enum+ind+n.rows[0])
+	for _, r := range n.rows[1:] {
+		out = append(out, n.pre+indent+pad+r)
+	}
+	if s.style == "padded" && !n.sub && !selected {
+		out = append(out, n.pre+indent)
+	}
+	return out
+}
+
+// render mirrors updateViewport's SetContent: the tree's rows with their
+// line offsets, the frame of the style around them, the cursor column
+// joined on the left with the cursor on the selected node's row.
+func (s *tm) render() {
+	s.renderW = s.w
+	s.wide = false
+	var tree []string
+	at := 0
+	for i, n := range s.vis {
+		n.line = len(tree)
+		if i == s.sel {
+			at = n.line
+		}
+		rows := s.nodeRows(n, i == s.sel)
+		for _, r := range rows {
+			if ansi.StringWidth(r) > s.w {
+				s.wide = true
+			}
+		}
+		tree = append(tree, rows...)
+	}
+	ccw := 0
+	if s.cursor != "" {
+		ccw = ansi.StringWidth(s.cursor) + 1 // PaddingRight(1)
+	}
+	content := tree
+	switch s.style {
+	case "top":
+		content = append([]string{""}, tree...)
+	case "border":
+		cw := s.w - ccw - 2
+		content = []string{"\u250C" + strings.Repeat("\u2500", cw) + "\u2510"}
+		for _, t := range tree {
+			t = ansi.Truncate(t, cw, "")
+			content = append(content, "\u2502"+t+strings.Repeat(" ", cw-ansi.StringWidth(t))+"\u2502")
+		}
+		content = append(content, "\u2514"+strings.Repeat("\u2500", cw)+"\u2518")
+	}
+	at += s.frameTop()
+	s.rows = s.rows[:0]
+	for i, c := range content {
+		cell := ""
+		if s.cursor != "" {
+			cell = strings.Repeat(" ", ccw)
+			if i == at {
+				cell = s.cursor + " "
+			}
+		}
+		s.rows = append(s.rows, cell+c)
+	}
+	s.total = len(s.rows)
+}
+
+func (s *tm) maxY() int { return max(0, s.total-s.vh) }
+
+// update is updateViewport(movement): the selection clamped, the content
+// rendered and the offset clamped to it, then the scroll-off rule unless the
+// root is selected with no movement and the offset is at the top (the
+// initial render); without fix the library's early return there whatever
+// the offset (bubbles/90).
+func (s *tm) update(movement int, fix bool) {
+	s.sel = max(min(len(s.vis)-1, s.sel+movement), 0)
+	s.render()
+	s.vpY = min(s.vpY, s.maxY())
+	if s.sel == 0 && movement == 0 && (s.vpY == 0 || !fix) {
+		return // the initial render; the library's early return whatever the offset (bubbles/90)
+	}
+	s.scroll()
+}
+
+// scroll is the library's scroll-off rule on the selected node's content
+// line: at least scrollOff lines (at most half the window) above and below
+// it, one side corrected per move.
+func (s *tm) scroll() {
+	line := s.vis[s.sel].line + s.frameTop()
+	height := max(0, min(s.vh, s.total-s.vpY)) // VisibleLineCount
+	if s.vh <= 0 {
+		height = 0
+	}
+	so := min(s.so, height/2)
+	minTop := max(line-so, 0)
+	minBottom := min(s.total-1, line+so)
+	if s.vpY > minTop {
+		s.vpY = min(max(minTop, 0), s.maxY())
+	} else if s.vpY+height < minBottom+1 {
+		s.vpY = min(max(minBottom-height+1, 0), s.maxY())
+	}
+}
+
+// fix clamps the offset to the content and, with a window to show it in,
+// applies the scroll-off rule without a movement (what a resize owes the
+// selection).
+func (s *tm) fix() {
+	s.vpY = min(s.vpY, s.maxY())
+	if s.vh >= 1 {
+		s.scroll()
+	}
+}
+
+// resize is SetSize: the viewport's height from the help's height at the new
+// width and the selection kept in view; without fix the library's, the help
+// measured at the old width (bubbles/89) and no scroll (bubbles/78).
+func (s *tm) resize(w, h int, fix bool) {
+	old := s.w
+	s.w, s.h = w, h
+	if fix {
+		s.vh = s.viewportHeight(w)
+		s.fix()
+		return
+	}
+	s.vh = s.viewportHeight(old)
+}
+
+func (s *tm) toggle(open bool, fix bool) {
+	s.vis[s.sel].open = open
+	s.layout()
+	s.update(0, fix)
+}
+
+func (s *tm) setNodes(root *tn, fix bool) {
+	s.root = root
+	s.layout()
+	s.update(0, fix)
+}
+
+// step applies op to the model: the true arithmetic, or without fix the
+// library's where it differs.
+func (s *tm) step(op tOp, fix bool) {
+	switch op.kind {
+	case "down":
+		s.update(1, fix)
+	case "up":
+		s.update(-1, fix)
+	case "pgdown":
+		s.update(s.vh, fix)
+	case "pgup":
+		s.update(-s.vh, fix)
+	case "halfdown":
+		s.update(s.vh/2, fix)
+	case "halfup":
+		s.update(-s.vh/2, fix)
+	case "top":
+		s.update(-s.sel, fix)
+	case "bottom":
+		s.update(len(s.vis), fix)
+	case "toggle":
+		s.toggle(!s.vis[s.sel].open, fix)
+	case "open":
+		s.toggle(true, fix)
+	case "close":
+		s.toggle(false, fix)
+	case "help":
+		s.showAll = !s.showAll
+		if fix && s.showHelp { // the viewport follows the help (bubbles/77)
+			s.resize(s.w, s.h, true)
+		}
+	case "setyoffset":
+		s.update(op.n-s.sel, fix)
+	case "setsize":
+		s.resize(op.w, op.h, fix)
+	case "setheight":
+		s.resize(s.w, op.n, fix)
+	case "setwidth":
+		s.resize(op.n, s.h, fix)
+	case "setscrolloff":
+		s.so = op.n
+	case "setshowhelp":
+		s.showHelp = op.on
+		s.resize(s.w, s.h, fix)
+	case "setnodes":
+		s.setNodes(op.tree.build(), fix)
+	case "setcursor":
+		s.cursor = op.s
+		s.resize(s.w, s.h, fix)
+	case "setvalue":
+		n := s.vis[op.n%len(s.vis)]
+		n.val = op.s
+		n.rows = strings.Split(op.s, "\n")
+		if n == s.root {
+			n.libRows = len(n.rows) // the root is re-rendered from its value
+		} else {
+			n.stale = true // a child is not (bubbles/80)
+		}
+		s.layout()
+		s.update(0, fix)
+	}
+}
+
+// ---------------------------------------------------------------- shapes
+
+// stepShape names the recorded bug whose shape the step has, from the
+// model's state and the operation before it is taken: the spacebar (87),
+// SetNodes(nil) (75), Root().Value() with an indicator (81), SetValue on a
+// child (80), `?` changing the help's height (77); then the operation is
+// replayed on two clones, with the library's arithmetic and the true one,
+// and a difference is a width change measuring the help at the old width
+// (89), a resize not scrolling (78) or a movement of zero at the root with
+// the offset past it (90).
+func stepShape(s *tm, op tOp) string {
+	switch {
+	case op.key == spaceKey:
+		return "bubbles/87"
+	case op.kind == "setnodes" && op.tree.nilRoot:
+		return "bubbles/75"
+	case op.kind == "rootvalue":
+		if s.indicator(s.root) != "" {
+			return "bubbles/81"
+		}
+		return ""
+	case op.kind == "setvalue" && op.n%len(s.vis) != 0:
+		return "bubbles/80"
+	case op.kind == "help":
+		if s.showHelp && helpLines(s.w, !s.showAll) != helpLines(s.w, s.showAll) {
+			return "bubbles/77"
+		}
+		return ""
+	}
+	lib, truth := s.clone(), s.clone()
+	lib.step(op, false)
+	truth.step(op, true)
+	if lib.vh != truth.vh {
+		return "bubbles/89"
+	}
+	if lib.vpY != truth.vpY {
+		switch op.kind {
+		case "setsize", "setheight", "setwidth", "setshowhelp", "setcursor":
+			return "bubbles/78"
+		}
+		return "bubbles/90"
+	}
+	return ""
+}
+
+// stateShape names the recorded bug whose shape the model's state has: a
+// hidden node in the open part of the tree (76), the nil root (82), the
+// styles (83, 84, 85), a stale child value (80), a node whose library line
+// offset is short (86 under a multi-line ancestor, 88 after an empty-valued
+// sibling), a row wider than the width (79).
+func stateShape(s *tm) string {
+	if hasHidden(s.root) {
+		return "bubbles/76"
+	}
+	if s.root.nilRoot {
+		return "bubbles/82"
+	}
+	switch s.style {
+	case "top":
+		return "bubbles/83"
+	case "border":
+		return "bubbles/84"
+	case "padded":
+		return "bubbles/85"
+	}
+	for _, n := range s.vis {
+		if n.stale {
+			return "bubbles/80"
+		}
+	}
+	for _, n := range s.vis {
+		if n.lib != n.base {
+			if underMultiLine(n) {
+				return "bubbles/86"
+			}
+			return "bubbles/88"
+		}
+	}
+	if s.wide {
+		return "bubbles/79"
+	}
+	return ""
+}
+
+// hasHidden reports a hidden node the library still lays out: under open
+// nodes only (a closed node has no children to the library).
+func hasHidden(n *tn) bool {
+	if !n.sub || !n.open {
+		return false
+	}
+	for _, k := range n.kids {
+		if k.hidden || hasHidden(k) {
+			return true
+		}
+	}
+	return false
+}
+
+func underMultiLine(n *tn) bool {
+	for p := n.parent; p != nil; p = p.parent {
+		if len(p.rows) > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// unshaped drops, under HEGEL_NO_KNOWN=1, the operations the classifier
+// names a shape for, replaying the model over the kept ones.
+func (s *tm) unshaped(ops []tOp) []tOp {
+	var kept []tOp
+	for _, op := range ops {
+		if stepShape(s, op) != "" {
+			continue
+		}
+		s.step(op, true)
+		kept = append(kept, op)
+	}
+	return kept
+}
+
+// ---------------------------------------------------------------- judge
+
+// tRun is one case under judgement: the judge, the library's model and the
+// model.
+type tRun struct {
+	j *zootest.Judge
+	m Model
+	s *tm
+}
+
+// judgeTree builds the tree of the start, applies the operations and checks
+// the library against the model after the start and after every operation;
+// the wide and the narrow properties share it. With drop the operations with
+// a shape are dropped first (the wide property under HEGEL_NO_KNOWN=1).
+func judgeTree(j *zootest.Judge, c tCase, drop bool) {
+	r := &tRun{j: j, s: newTm(c.start)}
+	ops := c.ops
+	if drop {
+		ops = r.s.clone().unshaped(ops)
+	}
+	r.m = c.start.build(r.s.root.node)
+	if r.s.root.node == nil {
+		r.s.root.node = r.m.Root() // New(nil): the library's empty root
+	}
+	j.Shape(stateShape(r.s))
+	r.check("at the start", tOp{})
+	for _, op := range ops {
+		j.Shape(stateShape(r.s))
+		j.Shape(stepShape(r.s, op))
+		r.apply(op)
+		s := r.s
+		j.Note("%s -> sel %d of %d, total %d, vpY %d, %dx%d vh %d so %d help %v/%v cursor %q",
+			op.GoString(), s.sel, len(s.vis), s.total, s.vpY, s.w, s.h, s.vh, s.so, s.showHelp, s.showAll, s.cursor)
+		j.Shape(stateShape(s))
+		r.check("after "+op.GoString(), op)
+	}
+}
+
+// apply applies op to the library and to the model (the model first for
+// SetNodes, whose library nodes it builds; the library first for SetValue,
+// whose node is the model's before the step).
+func (r *tRun) apply(op tOp) {
+	m, s := &r.m, r.s
+	switch op.kind {
+	case "setnodes":
+		s.step(op, true)
+		m.SetNodes(s.root.node) // nil for the nil tree: panics (bubbles/75)
+		return
+	case "setvalue":
+		s.vis[op.n%len(s.vis)].node.SetValue(op.s)
+		m.SetNodes(m.Root())
+	case "rootvalue":
+	case "setyoffset":
+		m.SetYOffset(op.n)
+	case "setsize":
+		m.SetSize(op.w, op.h)
+	case "setheight":
+		m.SetHeight(op.n)
+	case "setwidth":
+		m.SetWidth(op.n)
+	case "setscrolloff":
+		m.SetScrollOff(op.n)
+	case "setshowhelp":
+		m.SetShowHelp(op.on)
+	case "setcursor":
+		m.SetCursorCharacter(op.s)
+		m.SetSize(m.Width(), m.Height())
+	default:
+		var cmd tea.Cmd
+		*m, cmd = m.Update(op.key)
+		if cmd != nil {
+			if msg := cmd(); msg != nil {
+				*m, _ = m.Update(msg)
+			}
+		}
+	}
+	s.step(op, true)
+}
+
+// check compares the library with the model: the selection and the offsets
+// of every visible node, the size, the viewport's height and offset, the
+// selected line in view, the view's line count and its rows, and after the
+// Root().Value() query its rows.
+func (r *tRun) check(what string, op tOp) {
+	j, m, s := r.j, &r.m, r.s
+	if m.YOffset() != s.sel {
+		j.Fail("%s: YOffset %d, want %d", what, m.YOffset(), s.sel)
+	}
+	if m.Root().Size() != len(s.vis) {
+		j.Fail("%s: Size %d, want %d", what, m.Root().Size(), len(s.vis))
+	}
+	if m.NodeAtCurrentOffset() != s.vis[s.sel].node {
+		j.Fail("%s: NodeAtCurrentOffset is %v, want %q", what, m.NodeAtCurrentOffset().GivenValue(), s.vis[s.sel].val)
+	}
+	for i, n := range s.vis {
+		if n.node.YOffset() != i {
+			j.Fail("%s: node %q at y=%d, want y=%d", what, n.val, n.node.YOffset(), i)
+		}
+		if n.node.LineOffset() != n.line {
+			j.Fail("%s: node %q at line=%d, want line=%d", what, n.val, n.node.LineOffset(), n.line)
+		}
+		if n.node.IsSelected() != (i == s.sel) {
+			j.Fail("%s: node %q IsSelected %v at y=%d (selected %d)", what, n.val, n.node.IsSelected(), i, s.sel)
+		}
+		if m.Node(i) != n.node {
+			j.Fail("%s: Node(%d) is not %q", what, i, n.val)
+		}
+	}
+	if m.Node(len(s.vis)) != nil {
+		j.Fail("%s: Node(%d) past the end is %v", what, len(s.vis), m.Node(len(s.vis)).GivenValue())
+	}
+	if m.Width() != s.w || m.Height() != s.h {
+		j.Fail("%s: size %dx%d, want %dx%d", what, m.Width(), m.Height(), s.w, s.h)
+	}
+	if m.viewport.Height() != s.vh {
+		j.Fail("%s: viewport height %d, want %d", what, m.viewport.Height(), s.vh)
+	}
+	if m.ViewportYOffset() != s.vpY {
+		j.Fail("%s: viewport YOffset %d, want %d", what, m.ViewportYOffset(), s.vpY)
+	}
+
+	// The selection is in view.
+	if s.vh >= 1 {
+		line := s.vis[s.sel].line + s.frameTop()
+		if line < s.vpY || line >= s.vpY+s.vh {
+			j.Fail("%s: selected line %d outside the window [%d,%d)", what, line, s.vpY, s.vpY+s.vh)
+		}
+	}
+
+	// The view.
+	view := strings.Split(ansi.Strip(m.View()), "\n")
+	hv := 0
+	if s.showHelp {
+		hv = helpLines(s.w, s.showAll)
+	}
+	want := max(s.vh, 1) + hv
+	if len(view) != want {
+		j.Fail("%s: view has %d lines, want %d\n%s", what, len(view), want, strings.Join(view, "\n"))
+	}
+	if s.vh >= 1 && want != s.h {
+		j.Fail("%s: view has %d lines for a height of %d", what, want, s.h)
+	}
+	if s.vh >= 1 && s.w >= 1 {
+		for i := 0; i < s.vh; i++ {
+			exp := ""
+			if idx := s.vpY + i; idx < len(s.rows) {
+				exp = s.rows[idx]
+			}
+			exp = strings.TrimRight(ansi.Truncate(exp, s.w, ""), " ")
+			got := strings.TrimRight(view[i], " ")
+			if got != exp {
+				j.Fail("%s: row %d is %q, want %q\n%s", what, i, got, exp, strings.Join(view, "\n"))
+			}
+		}
+	}
+
+	// Root().Value(): the indicator once before the value's rows.
+	if op.kind == "rootvalue" {
+		got := strings.Split(ansi.Strip(m.Root().Value()), "\n")
+		exp := s.nodeRows(s.root, s.sel == 0)
+		same := len(got) == len(exp)
+		for i := 0; same && i < len(got); i++ {
+			same = strings.TrimRight(got[i], " ") == strings.TrimRight(exp[i], " ")
+		}
+		if !same {
+			j.Fail("%s: Root().Value() is %q, want %q", what, strings.Join(got, "\n"), strings.Join(exp, "\n"))
+		}
+	}
+}
+
+// runTree runs one drawn case under the judge.
+func runTree(ht *hegel.T, c tCase, drop bool) {
+	j := zootest.NewJudge(ht)
+	defer j.Recover()
+	judgeTree(j, c, drop)
+}
+
+// TestHegelTreeFollowsTheModel: every binding and setter over a random tree
