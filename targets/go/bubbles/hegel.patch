+// bubbles/1: deleteWordForward moves past the rune under the cursor before it
+// looks for the word: at the last rune it indexes past the value.
+func TestHegelPinDeleteWordForwardStartsOneRuneTooFar(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("ab c")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a c" {
+		t.Fatalf("alt+d at a|b c gives %q, want %q", m.Value(), "a c")
+	}
+	m = New()
+	m.Focus()
+	m.SetValue("ab")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a" {
+		t.Fatalf("alt+d at a|b gives %q, want %q", m.Value(), "a")
+	}
+}
