diff --git a/help/hegel_shapes_test.go b/help/hegel_shapes_test.go
new file mode 100644
index 0000000..5e03e05
--- /dev/null
+++ b/help/hegel_shapes_test.go
@@ -0,0 +1,62 @@
+package help
+
+// The shape regions of the recorded help bugs (bugs.toml bubbles/57, 58) and the
+// narrow properties over them: each region is a layout with random contents at a
+// width where the layout model meets the shape (the model's own predicate, since
+// the width is a relation with the layout: hegel.Filter keeps the layouts with such
+// a width), judged exactly like the wide property (judgeHelp). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 the width is drawn
+// from the widths at which the layout meets no shape instead (zootest.Shaped) and
+// the property passes. Measured standalone (math/rand over the model and the
+// library): a layout has a width meeting bubbles/57 931 of 1000 times and one
+// meeting bubbles/58 933 of 1000 times, and at such a width the library's view
+// differs from the model's every time (931 of 931, 933 of 933).
+
+import (
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowHelp runs a narrow property: every drawn case through the wide property's
+// judge.
+func narrowHelp(t *testing.T, cases hegel.Generator[helpCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeHelp(j, c)
+	})
+}
+
+// atWidthsOf: the layouts with a width at which the views meet the shape, at such
+// a width; past the shape, at a width at which they meet none.
+func atWidthsOf(id string) hegel.Generator[helpCase] {
+	withShape := hegel.Filter(layouts, func(l helpLayout) bool { return len(l.widthsOf(id)) > 0 })
+	return hegel.FlatMap(withShape, func(l helpLayout) hegel.Generator[helpCase] {
+		ws := zootest.Shaped(l.widthsOf(id), l.widthsOf(""))
+		return hegel.Map(zootest.Sampled(ws...), func(w int) helpCase { return helpCase{helpLayout: l, width: w} })
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/57
+
+// ellipsisDoesNotFit: a layout at a width where an item (or column) does not fit
+// and the ellipsis after what fits does not fit either: the library adds the item.
+var ellipsisDoesNotFit = atWidthsOf("bubbles/57")
+
+func TestHegelHelpItemAddedWhenTheEllipsisDoesNotFit(t *testing.T) {
+	narrowHelp(t, ellipsisDoesNotFit)
+}
+
+// --------------------------------------------------------------------------- bubbles/58
+
+// ellipsisFitsExactly: a layout at a width where an item (or column) does not fit
+// and the ellipsis after what fits ends exactly at the width: the library drops it
+// and adds the item.
+var ellipsisFitsExactly = atWidthsOf("bubbles/58")
+
+func TestHegelHelpEllipsisFittingExactlyIsDropped(t *testing.T) {
+	narrowHelp(t, ellipsisFitsExactly)
+}
diff --git a/help/hegel_test.go b/help/hegel_test.go
new file mode 100644
index 0000000..3bddd5e
--- /dev/null
+++ b/help/hegel_test.go
@@ -0,0 +1,433 @@
+package help
+
+// Hegel properties for the help bubble: the short and the full view checked
+// against a layout model of the enabled bindings, the separators, the width
+// and the ellipsis. A case is a layout (separators, ellipsis, bindings,
+// groups) and a width; the layout model says at which widths a view meets
+// the shape of a recorded bug (an item that does not fit added when the
+// ellipsis does not fit either, bubbles/57; an ellipsis fitting exactly
+// dropped, bubbles/58), and such a case fails naming it. Under
+// HEGEL_NO_KNOWN=1 the width is drawn from the widths at which neither view
+// meets a shape.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"charm.land/bubbles/v2/key"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+var helpWords = []string{"", "a", "?", "up", "esc", "ctrl+c", "↑/k", "quit", "move down", "全角", "x"}
+
+type hb struct {
+	key, desc string
+	on        bool
+}
+
+func (b hb) binding() key.Binding {
+	kb := key.NewBinding(key.WithKeys("x"), key.WithHelp(b.key, b.desc))
+	if !b.on {
+		kb.SetEnabled(false)
+	}
+	return kb
+}
+
+func pad(s string, w int) string {
+	return s + strings.Repeat(" ", max(0, w-ansi.StringWidth(s)))
+}
+
+// fit is shouldAddItem done right: the item is added only when it fits; when
+// it does not, the ellipsis tail is added when there is room for it.
+// exact reports that the tail would fit exactly (bubbles/58's shape).
+func fit(width, total, w, tailW int) (add, tail, exact bool) {
+	if width <= 0 || total+w <= width {
+		return true, false, false
+	}
+	return false, total+tailW <= width, total+tailW == width
+}
+
+// fitShape names the recorded bug the library meets where fit stops: the
+// ellipsis fitting exactly is dropped (bubbles/58); the item is added when the
+// ellipsis does not fit either (bubbles/57).
+func fitShape(add, tail, exact bool) string {
+	switch {
+	case add:
+		return ""
+	case exact:
+		return "bubbles/58"
+	case !tail:
+		return "bubbles/57"
+	}
+	return ""
+}
+
+// shortModel is the short help line: enabled items "key desc" joined by the
+// separator, cut at the width with the ellipsis; shape names the recorded bug
+// met at the cut, if any.
+func shortModel(width int, sep, ell string, bs []hb) (line string, shape string) {
+	tailW := ansi.StringWidth(" " + ell)
+	total := 0
+	var sb strings.Builder
+	for _, b := range bs {
+		if !b.on {
+			continue
+		}
+		item := b.key + " " + b.desc
+		if total > 0 {
+			item = sep + item
+		}
+		w := ansi.StringWidth(item)
+		add, tail, ex := fit(width, total, w, tailW)
+		if !add {
+			if tail {
+				sb.WriteString(" " + ell)
+			}
+			return sb.String(), fitShape(add, tail, ex)
+		}
+		total += w
+		sb.WriteString(item)
+	}
+	return sb.String(), ""
+}
+
+// fullModel is the full help block: one column per group with an enabled
+// binding, keys and descriptions aligned, columns joined at the top; shape
+// names the recorded bug met at the cut, if any.
+func fullModel(width int, sep, ell string, groups [][]hb) (lines []string, shape string) {
+	type col struct {
+		lines []string
+		w     int
+	}
+	var cols []col
+	total := 0
+	tailW := ansi.StringWidth(" " + ell)
+	height := 0
+	for _, g := range groups {
+		var keys, descs []string
+		kw, dw := 0, 0
+		for _, b := range g {
+			if !b.on {
+				continue
+			}
+			keys = append(keys, b.key)
+			descs = append(descs, b.desc)
+			kw = max(kw, ansi.StringWidth(b.key))
+			dw = max(dw, ansi.StringWidth(b.desc))
+		}
+		if len(keys) == 0 {
+			continue
+		}
+		s := ""
+		if total > 0 {
+			s = sep
+		}
+		// the separator is a one-line block joined at the top: it shows on
+		// the first line only, the lines below get spaces
+		c := col{w: ansi.StringWidth(s) + kw + 1 + dw}
+		for i := range keys {
+			c.lines = append(c.lines, pad(s, ansi.StringWidth(s))+pad(keys[i], kw)+" "+pad(descs[i], dw))
+			s = strings.Repeat(" ", ansi.StringWidth(s))
+		}
+		add, tail, ex := fit(width, total, c.w, tailW)
+		if !add {
+			if tail {
+				cols = append(cols, col{lines: []string{" " + ell}, w: tailW})
+				height = max(height, 1)
+			}
+			shape = fitShape(add, tail, ex)
+			break
+		}
+		total += c.w
+		cols = append(cols, c)
+		height = max(height, len(c.lines))
+	}
+	if len(cols) == 0 {
+		return nil, shape
+	}
+	for r := 0; r < height; r++ {
+		var sb strings.Builder
+		for _, c := range cols {
+			l := ""
+			if r < len(c.lines) {
+				l = c.lines[r]
+			}
+			sb.WriteString(pad(l, c.w))
+		}
+		lines = append(lines, sb.String())
+	}
+	return lines, shape
+}
+
+// helpSeps: the separators set on the model (set), or New()'s.
+type helpSeps struct {
+	set         bool
+	short, full string
+}
+
+// helpEllipsis: the ellipsis set on the model (set), or New()'s.
+type helpEllipsis struct {
+	set bool
+	s   string
+}
+
+// helpGroup is one group of the full help: bindings, or a nil group (skipped like one
+// without enabled bindings).
+type helpGroup struct {
+	bs  []hb
+	nil bool
+}
+
+// helpLayout is everything but the width.
+type helpLayout struct {
+	seps    helpSeps
+	ell     helpEllipsis
+	bs      []hb
+	groups  []helpGroup
+	showAll bool
+}
+
+// helpCase is a layout at a width.
+type helpCase struct {
+	helpLayout
+	width int
+}
+
+func (c helpCase) GoString() string {
+	m := c.model()
+	var sb strings.Builder
+	sb.WriteString(fmt.Sprintf("width %d, sep %q/%q, ellipsis %q, ShowAll %v, bindings %+v, groups", c.width, m.ShortSeparator, m.FullSeparator, m.Ellipsis, c.showAll, c.bs))
+	for _, g := range c.groups {
+		if g.nil {
+			sb.WriteString(" nil")
+		} else {
+			sb.WriteString(fmt.Sprintf(" %+v", g.bs))
+		}
+	}
+	return sb.String()
+}
+
+// model is New() with the layout's separators and ellipsis set.
+func (l helpLayout) model() Model {
+	m := New()
+	if l.seps.set {
+		m.ShortSeparator, m.FullSeparator = l.seps.short, l.seps.full
+	}
+	if l.ell.set {
+		m.Ellipsis = l.ell.s
+	}
+	return m
+}
+
+// hbGroups is the groups as the model takes them (nil for a nil group).
+func (l helpLayout) hbGroups() [][]hb {
+	var groups [][]hb
+	for _, g := range l.groups {
+		if g.nil {
+			groups = append(groups, nil)
+		} else {
+			groups = append(groups, g.bs)
+		}
+	}
+	return groups
+}
+
+// shapeAt names the recorded bug the views meet at the width, the short view's
+// first (the order the judge compares them in); "" when neither does.
+func (l helpLayout) shapeAt(width int) string {
+	m := l.model()
+	if _, shape := shortModel(width, m.ShortSeparator, m.Ellipsis, l.bs); shape != "" {
+		return shape
+	}
+	_, shape := fullModel(width, m.FullSeparator, m.Ellipsis, l.hbGroups())
+	return shape
+}
+
+// widthsOf: the widths from 0 to 40 at which the views meet the shape (id "" for
+// the widths at which they meet none; 0 is always one of those).
+func (l helpLayout) widthsOf(id string) []int {
+	var out []int
+	for w := 0; w <= 40; w++ {
+		if l.shapeAt(w) == id {
+			out = append(out, w)
+		}
+	}
+	return out
+}
+
+var (
+	words = zootest.Sampled(helpWords...)
+
+	// bindings: a key and a description from the words, disabled 15 times in 100.
+	bindings = hegel.Composite(func(tc hegel.TestCase) hb {
+		return hb{key: hegel.Draw(tc, words), desc: hegel.Draw(tc, words), on: !hegel.Draw(tc, zootest.Coin(15))}
+	})
+
+	// seps: New()'s separators, or 30 times in 100 a pair from the tables.
+	seps = zootest.Weighted(
+		zootest.W(7, hegel.Just(helpSeps{})),
+		zootest.W(3, hegel.Composite(func(tc hegel.TestCase) helpSeps {
+			return helpSeps{
+				set:   true,
+				short: hegel.Draw(tc, zootest.Sampled(" | ", " ", "", "・")),
+				full:  hegel.Draw(tc, zootest.Sampled(" | ", "  ", "", " ・ ")),
+			}
+		})),
+	)
+	// ellipses: New()'s ellipsis, or 30 times in 100 one from the table.
+	ellipses = zootest.Weighted(
+		zootest.W(7, hegel.Just(helpEllipsis{})),
+		zootest.W(3, hegel.Map(zootest.Sampled("...", "", "→", "…"), func(s string) helpEllipsis { return helpEllipsis{set: true, s: s} })),
+	)
+
+	// groups: none to three bindings, or one time in ten a nil group.
+	groups = hegel.Composite(func(tc hegel.TestCase) helpGroup {
+		return helpGroup{bs: hegel.Draw(tc, zootest.Counted(bindings, 0, 3)), nil: hegel.Draw(tc, zootest.Coin(10))}
+	})
+
+	// layouts: the separators, the ellipsis, none to six bindings for the short view,
+	// none to four groups for the full view, ShowAll half the time.
+	layouts = hegel.Composite(func(tc hegel.TestCase) helpLayout {
+		return helpLayout{
+			seps:    hegel.Draw(tc, seps),
+			ell:     hegel.Draw(tc, ellipses),
+			bs:      hegel.Draw(tc, zootest.Counted(bindings, 0, 6)),
+			groups:  hegel.Draw(tc, zootest.Counted(groups, 0, 4)),
+			showAll: hegel.Draw(tc, zootest.Coin(50)),
+		}
+	})
+
+	// widths: no width one time in five, else 1 to 40 (the shapes of bubbles/57 and
+	// 58 are relations between the width and the layout, met at whatever rate the
+	// layouts give them).
+	widths = zootest.Weighted(
+		zootest.W(1, hegel.Just(0)),
+		zootest.W(4, zootest.Ints(1, 40)),
+	)
+
+	// helpCases: a layout at a width.
+	helpCases = hegel.FlatMap(layouts, func(l helpLayout) hegel.Generator[helpCase] {
+		return hegel.Map(widthsFor(l), func(w int) helpCase { return helpCase{helpLayout: l, width: w} })
+	})
+)
+
+// widthsFor is the widths; under HEGEL_NO_KNOWN=1 only those at which the layout's
+// views meet no recorded bug (a relation, not an alternative: the width is drawn
+// from the layout's safe set rather than filtered).
+func widthsFor(l helpLayout) hegel.Generator[int] {
+	if zootest.NoKnown {
+		return zootest.Sampled(l.widthsOf("")...)
+	}
+	return widths
+}
+
+// judgeHelp renders the short and the full view at the width and checks them
+// against the layout model, and View against whichever ShowAll selects; a mismatch
+// at a width where the model meets a recorded bug's shape names it.
+func judgeHelp(j *zootest.Judge, c helpCase) {
+	m := c.model()
+	width := c.width
+	m.SetWidth(width)
+	if m.Width() != width {
+		j.Fail("Width() %d after SetWidth(%d)", m.Width(), width)
+	}
+	bs := c.bs
+	var kbs []key.Binding
+	for _, b := range bs {
+		kbs = append(kbs, b.binding())
+	}
+	got := m.ShortHelpView(kbs)
+	plain := ansi.Strip(got)
+	want, shape := shortModel(width, m.ShortSeparator, m.Ellipsis, bs)
+	if plain != want {
+		j.Shape(shape)
+		j.Fail("width %d, sep %q, ellipsis %q, bindings %+v:\nShortHelpView %q\nwant          %q", width, m.ShortSeparator, m.Ellipsis, bs, plain, want)
+	}
+	if ansi.StringWidth(got) != ansi.StringWidth(plain) || strings.Contains(got, "\n") {
+		j.Fail("styled short view %q is not one line of the plain width", got)
+	}
+	groups := c.hbGroups()
+	var kgroups [][]key.Binding
+	for _, g := range c.groups {
+		var kg []key.Binding
+		if !g.nil {
+			for _, b := range g.bs {
+				kg = append(kg, b.binding())
+			}
+		}
+		kgroups = append(kgroups, kg)
+	}
+	got = m.FullHelpView(kgroups)
+	var lines []string
+	if got != "" {
+		lines = strings.Split(ansi.Strip(got), "\n")
+	}
+	wantLines, shape := fullModel(width, m.FullSeparator, m.Ellipsis, groups)
+	if strings.Join(lines, "\n") != strings.Join(wantLines, "\n") {
+		j.Shape(shape)
+		j.Fail("width %d, sep %q, ellipsis %q, groups %+v:\nFullHelpView\n%s\nwant\n%s", width, m.FullSeparator, m.Ellipsis, groups, strings.Join(lines, "\n"), strings.Join(wantLines, "\n"))
+	}
+	m.ShowAll = c.showAll
+	km := zkeys{short: kbs, full: kgroups}
+	if v := ansi.Strip(m.View(km)); (m.ShowAll && v != strings.Join(lines, "\n")) || (!m.ShowAll && v != plain) {
+		j.Fail("View (ShowAll %v) %q", m.ShowAll, v)
+	}
+}
+
+// TestHegelHelpFitsTheWidth: ShortHelpView is the enabled bindings' "key
+// desc" items joined by the separator, and FullHelpView one aligned column
+// per group; with a width set, both stop before the item or column that
+// does not fit and end in the ellipsis when there is room for it, so the
+// rendered width never exceeds the width.
+func TestHegelHelpFitsTheWidth(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, helpCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeHelp(j, c)
+	})
+}
+
+type zkeys struct {
+	short []key.Binding
+	full  [][]key.Binding
+}
+
+func (k zkeys) ShortHelp() []key.Binding  { return k.short }
+func (k zkeys) FullHelp() [][]key.Binding { return k.full }
+
+func pinBindings(pairs ...string) []key.Binding {
+	var out []key.Binding
+	for i := 0; i+1 < len(pairs); i += 2 {
+		out = append(out, key.NewBinding(key.WithKeys("x"), key.WithHelp(pairs[i], pairs[i+1])))
+	}
+	return out
+}
+
+// bubbles/57: when the next item does not fit and there is no room for the
+// ellipsis either, shouldAddItem says to add the item, so the short and the
+// full help view overflow their width.
+func TestHegelPinHelpOverflowsWhenTheEllipsisDoesNotFit(t *testing.T) {
+	m := New()
+	m.SetWidth(5)
+	s := ansi.Strip(m.ShortHelpView(pinBindings("a", "b", "c", "d", "e", "f")))
+	f := ansi.Strip(m.FullHelpView([][]key.Binding{pinBindings("a", "b"), pinBindings("c", "d"), pinBindings("e", "f")}))
+	if ansi.StringWidth(s) > 5 || ansi.StringWidth(f) > 5 {
+		t.Fatalf("width 5: ShortHelpView %q (%d wide), FullHelpView %q (%d wide)", s, ansi.StringWidth(s), f, ansi.StringWidth(f))
+	}
+}
+
+// bubbles/58: the ellipsis is only used when totalWidth + its width is
+// strictly less than the width, so an ellipsis that would end exactly at the
+// width is dropped and (by bubbles/57) the item is added instead.
+func TestHegelPinHelpEllipsisFittingExactlyIsDropped(t *testing.T) {
+	m := New()
+	m.SetWidth(11)
+	s := ansi.Strip(m.ShortHelpView(pinBindings("a", "b", "c", "d", "e", "f")))
+	if s != "a b • c d …" {
+		t.Fatalf("width 11: ShortHelpView %q (%d wide), want %q", s, ansi.StringWidth(s), "a b • c d …")
+	}
+}
diff --git a/internal/zootest/gen.go b/internal/zootest/gen.go
new file mode 100644
index 0000000..a536587
--- /dev/null
+++ b/internal/zootest/gen.go
@@ -0,0 +1,158 @@
+package zootest
+
+// The generator idioms the packages' tests share (hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator; these are the zoo's spellings, as
+// go/gonum's hegel_zoo_gen_test.go spells them). Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on
+// it, except the shape of a recorded bug a plain-mapped wide property must reach every
+// run, which goes first at a solid weight and is never drawn under HEGEL_NO_KNOWN=1.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// NoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, Unless; the region past the shape, Shaped) or the
+// case is skipped (Judge.Shape), for a run that looks past the known bugs. By default
+// every property draws them and fails naming the shape.
+var NoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// Choice is one alternative of a weighted choice.
+type Choice[T any] struct {
+	Weight int
+	Gen    hegel.Generator[T]
+}
+
+// W is the choice of weight w for g.
+func W[T any](w int, g hegel.Generator[T]) Choice[T] { return Choice[T]{Weight: w, Gen: g} }
+
+// Weighted generates from one of the choices, chosen with probability proportional to
+// its weight (a weight of zero is never drawn); it shrinks towards the first choice, so
+// the simplest comes first. The engine's bounded integer draw favours the value 1 of
+// the die, so a first alternative that must be drawn often needs a weight of two or
+// more.
+func Weighted[T any](choices ...Choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.Weight
+	}
+	if total <= 0 {
+		panic("zootest.Weighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.Weight {
+				return c.Gen
+			}
+			i -= c.Weight
+		}
+		panic("unreachable")
+	})
+}
+
+// Coin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so
+// the true range is the top of the die, not the bottom).
+func Coin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// Maybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func Maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return Weighted(W(100-pct, hegel.Just(zero)), W(pct, g))
+}
+
+// Sampled is one of a small table (the first is the shrink target; the engine favours
+// the second).
+func Sampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// Ints is an integer in [lo, hi], draw-free when the range is one value.
+func Ints(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// Unless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func Unless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// Only is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws
+// and the case is then a skip, so the region must be a small share of g). Every draw
+// the predicate rejects is counted as "filtered <name>" for the collector.
+func Only[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			Count("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// Shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func Shaped[T any](shape, past T) T {
+	if NoKnown {
+		return past
+	}
+	return shape
+}
+
+// Known is the plain generator, or the region of a recorded bug's shape one time in
+// five (the shape first, the exception of STYLE.md rule 3: the engine favours the
+// second value of a die, here the plain alternative's); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func Known[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return Weighted(W(Unless(NoKnown, 1), shape), W(4, plain))
+}
+
+// Tuple draws one value from each generator (a Composite only because the binding has
+// no tuple combinator).
+func Tuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// Counted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func Counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(Ints(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// Seq concatenates the drawn lists (a prefix, the shape, a suffix).
+func Seq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// One is a list of the one drawn value.
+func One[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/internal/zootest/zootest.go b/internal/zootest/zootest.go
new file mode 100644
index 0000000..3aca533
--- /dev/null
+++ b/internal/zootest/zootest.go
@@ -0,0 +1,289 @@
+// Package zootest is the shared harness of the Hegel zoo's bubbles tests: a
+// property wrapper with a collect mode, small generators, and a parser that
+// turns a rendered view into cells with their reverse-video flag.
+package zootest
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// Collecting is set by BUBBLES_COLLECT=1: mismatches are recorded and the
+// property goes on instead of failing at the first one.
+var Collecting = os.Getenv("BUBBLES_COLLECT") != ""
+
+type collected struct{}
+
+var (
+	mu    sync.Mutex
+	msgs  []string
+	stats = map[string]int{}
+)
+
+// Fail reports a mismatch: fatal normally, recorded in collect mode.
+func Fail(ht *hegel.T, format string, args ...any) {
+	if Collecting {
+		mu.Lock()
+		msgs = append(msgs, fmt.Sprintf(format, args...))
+		mu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// Count bumps a statistic (the shape of a pinned bug, a generator branch).
+func Count(key string) {
+	mu.Lock()
+	stats[key]++
+	mu.Unlock()
+}
+
+// Guard turns a panic in a pin into a test failure with the panic's value.
+func Guard(t *testing.T) {
+	t.Helper()
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func opts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// Property runs fn under Hegel; panics in the code under test become
+// failures (or recorded mismatches in collect mode).
+func Property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if Collecting {
+		mu.Lock()
+		msgs = nil
+		stats = map[string]int{}
+		mu.Unlock()
+		defer func() {
+			mu.Lock()
+			defer mu.Unlock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(msgs), sb.String())
+			for i, m := range msgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if isInternal(r) {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if Collecting {
+				mu.Lock()
+				msgs = append(msgs, msg)
+				mu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, opts()...)
+}
+
+// isInternal reports a panic value that is Hegel's own (an abort, an assume): it must
+// propagate.
+func isInternal(r any) bool {
+	tn := reflect.TypeOf(r).String()
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
+
+// Judge judges one drawn case: it names the recorded bug whose shape the case has, so
+// that a mismatch or a library panic fails "(the shape of bubbles/N)", and under
+// HEGEL_NO_KNOWN=1 skips the case instead (counted as known). The wide and the narrow
+// properties of a package share their judge function and so this.
+type Judge struct {
+	ht    *hegel.T
+	shape string
+}
+
+// NewJudge is the judge of the case drawn by the property ht runs.
+func NewJudge(ht *hegel.T) *Judge { return &Judge{ht: ht} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none):
+// counted, and the first shape named is the one a failure reports. Under
+// HEGEL_NO_KNOWN=1 the case is assumed away (counted as known).
+func (j *Judge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	Count("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if NoKnown {
+		Count("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *Judge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch, naming the shape.
+func (j *Judge) Fail(format string, args ...any) {
+	Fail(j.ht, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v
+// of a library value is part of the test (cursor.Mode.String, bubbles/96).
+func (j *Judge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the
+// code under test into a failure naming the shape.
+func (j *Judge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	if _, ok := r.(collected); ok || isInternal(r) {
+		panic(r)
+	}
+	j.Fail("panic in the code under test: %v", r)
+}
+
+// Cell is one grapheme of a rendered view with its display width and whether
+// it was drawn in reverse video (how the bubbles' virtual cursor shows).
+type Cell struct {
+	S   string
+	W   int
+	Rev bool
+}
+
+// Cells parses a rendered line: SGR sequences set or clear reverse video,
+// other escape sequences are skipped, text is split into graphemes.
+func Cells(s string) []Cell {
+	var cells []Cell
+	rev := false
+	i := 0
+	for i < len(s) {
+		if s[i] == 0x1b && i+1 < len(s) {
+			switch s[i+1] {
+			case '[':
+				j := i + 2
+				for j < len(s) && !(s[j] >= 0x40 && s[j] <= 0x7e) {
+					j++
+				}
+				if j < len(s) && s[j] == 'm' {
+					params := s[i+2 : j]
+					if params == "" {
+						rev = false
+					}
+					for _, p := range strings.Split(params, ";") {
+						switch p {
+						case "", "0":
+							rev = false
+						case "7":
+							rev = true
+						case "27":
+							rev = false
+						}
+					}
+				}
+				i = j + 1
+				continue
+			case ']':
+				j := i + 2
+				for j < len(s) {
+					if s[j] == 0x07 {
+						j++
+						break
+					}
+					if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+						j += 2
+						break
+					}
+					j++
+				}
+				i = j
+				continue
+			}
+		}
+		j := i
+		for j < len(s) && s[j] != 0x1b {
+			j++
+		}
+		g := uniseg.NewGraphemes(s[i:j])
+		for g.Next() {
+			cells = append(cells, Cell{S: g.Str(), W: g.Width(), Rev: rev})
+		}
+		i = j
+	}
+	return cells
+}
+
+// Plain is the text of the cells.
+func Plain(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		sb.WriteString(c.S)
+	}
+	return sb.String()
+}
+
+// Width is the display width of the cells.
+func Width(cells []Cell) int {
+	w := 0
+	for _, c := range cells {
+		w += c.W
+	}
+	return w
+}
+
+// String renders cells for a failure message: reversed cells in brackets.
+func String(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		if c.Rev {
+			sb.WriteString("[" + c.S + "]")
+		} else {
+			sb.WriteString(c.S)
+		}
+	}
+	return sb.String()
+}
diff --git a/key/hegel_test.go b/key/hegel_test.go
new file mode 100644
index 0000000..b38cc6e
--- /dev/null
+++ b/key/hegel_test.go
@@ -0,0 +1,240 @@
+package key_test
+
+// Hegel zoo: properties of the key package: Matches is exactly membership
+// among the enabled bindings, and Enabled follows SetKeys/SetEnabled/Unbind.
+// A case is a few binding records and a list of operation records applied in
+// order, positions taken modulo the number of bindings.
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"charm.land/bubbles/v2/key"
+)
+
+// keyNames are the strings bindings are made of; keyPresses are key presses
+// whose String() is expected to land on some of them.
+var keyNames = []string{"a", "b", "up", "down", "ctrl+c", "enter", "space", " ", "?", "esc", "shift+tab", "pgdown", "G"}
+
+var keyPresses = []tea.KeyPressMsg{
+	{Code: 'a', Text: "a"},
+	{Code: 'b', Text: "b"},
+	{Code: tea.KeyUp},
+	{Code: tea.KeyDown},
+	{Code: 'c', Mod: tea.ModCtrl},
+	{Code: tea.KeyEnter},
+	{Code: tea.KeySpace, Text: " "},
+	{Code: '?', Text: "?"},
+	{Code: tea.KeyEscape},
+	{Code: tea.KeyTab, Mod: tea.ModShift},
+	{Code: tea.KeyPgDown},
+	{Code: 'G', Text: "G", Mod: tea.ModShift},
+	{Code: 'z', Text: "z"},
+}
+
+// kmir is one binding as drawn, and its mirror while the operations run.
+type kmir struct {
+	keys     []string // nil when unbound
+	help     key.Help // the zero Help when none was given
+	disabled bool
+}
+
+func (b *kmir) enabled() bool { return !b.disabled && b.keys != nil }
+
+func (b kmir) GoString() string {
+	s := fmt.Sprintf("%q", b.keys)
+	if b.help != (key.Help{}) {
+		s += fmt.Sprintf(" help %q/%q", b.help.Key, b.help.Desc)
+	}
+	if b.disabled {
+		s += " disabled"
+	}
+	return s
+}
+
+// binding builds the library's binding from the record.
+func (b kmir) binding() key.Binding {
+	var opts []key.BindingOpt
+	if b.keys != nil {
+		opts = append(opts, key.WithKeys(b.keys...))
+	}
+	if b.help != (key.Help{}) {
+		opts = append(opts, key.WithHelp(b.help.Key, b.help.Desc))
+	}
+	if b.disabled {
+		opts = append(opts, key.WithDisabled())
+	}
+	return key.NewBinding(opts...)
+}
+
+// keyOp is one operation: Matches of a key press against all the bindings and each
+// one, or SetKeys, SetEnabled, Unbind or SetHelp on the binding at a position (taken
+// modulo the number of bindings; nothing to do without bindings).
+type keyOp struct {
+	kind  string
+	press int // match: the key press
+	at    int // the binding
+	keys  []string
+	help  key.Help
+}
+
+func (o keyOp) GoString() string {
+	switch o.kind {
+	case "match":
+		return fmt.Sprintf("match(%q)", keyPresses[o.press].String())
+	case "setkeys":
+		return fmt.Sprintf("setkeys(%d, %q)", o.at, o.keys)
+	case "sethelp":
+		return fmt.Sprintf("sethelp(%d, %q/%q)", o.at, o.help.Key, o.help.Desc)
+	}
+	return fmt.Sprintf("%s(%d)", o.kind, o.at)
+}
+
+type keyCase struct {
+	bindings []kmir
+	ops      []keyOp
+}
+
+func (c keyCase) GoString() string {
+	bs := make([]string, len(c.bindings))
+	for i, b := range c.bindings {
+		bs[i] = b.GoString()
+	}
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return "bindings " + strings.Join(bs, "; ") + "\n ops " + strings.Join(ops, ", ")
+}
+
+var (
+	names = zootest.Sampled(keyNames...)
+
+	// keyLists: none (nil: unbound) to three key names.
+	keyLists = zootest.Counted(names, 0, 3)
+	// helps: a help text; the bindings' descriptions say "do x".
+	helps = hegel.Composite(func(tc hegel.TestCase) key.Help {
+		return key.Help{Key: hegel.Draw(tc, names), Desc: hegel.Draw(tc, names)}
+	})
+	doHelps = hegel.Map(helps, func(h key.Help) key.Help { h.Desc = "do " + h.Desc; return h })
+
+	// bindings: keys, a help half the time, disabled one time in five.
+	bindings = hegel.Composite(func(tc hegel.TestCase) kmir {
+		return kmir{keys: hegel.Draw(tc, keyLists), help: hegel.Draw(tc, zootest.Maybe(50, doHelps)), disabled: hegel.Draw(tc, zootest.Coin(20))}
+	})
+
+	presses   = zootest.Ints(0, len(keyPresses)-1)
+	positions = zootest.Ints(0, 3)
+
+	// keyOps: a match three times in eight, the setters once each.
+	keyOps = zootest.Weighted(
+		zootest.W(3, hegel.Map(presses, func(p int) keyOp { return keyOp{kind: "match", press: p} })),
+		zootest.W(1, onBinding("setkeys", keyLists, hegel.Just(key.Help{}))),
+		zootest.W(1, onBinding("enable", hegel.Just[[]string](nil), hegel.Just(key.Help{}))),
+		zootest.W(1, onBinding("disable", hegel.Just[[]string](nil), hegel.Just(key.Help{}))),
+		zootest.W(1, onBinding("unbind", hegel.Just[[]string](nil), hegel.Just(key.Help{}))),
+		zootest.W(1, onBinding("sethelp", hegel.Just[[]string](nil), helps)),
+	)
+
+	// keyCases: none to four bindings and one to ten operations.
+	keyCases = hegel.Composite(func(tc hegel.TestCase) keyCase {
+		return keyCase{bindings: hegel.Draw(tc, zootest.Counted(bindings, 0, 4)), ops: hegel.Draw(tc, zootest.Counted(keyOps, 1, 10))}
+	})
+)
+
+// onBinding: an operation of the kind on a drawn position with its arguments.
+func onBinding(kind string, keys hegel.Generator[[]string], help hegel.Generator[key.Help]) hegel.Generator[keyOp] {
+	return hegel.Composite(func(tc hegel.TestCase) keyOp {
+		return keyOp{kind: kind, at: hegel.Draw(tc, positions), keys: hegel.Draw(tc, keys), help: hegel.Draw(tc, help)}
+	})
+}
+
+// judgeKeys builds the bindings, applies the operations and checks Matches against
+// membership among the enabled bindings, plus Keys, Help and Enabled after every
+// setter.
+func judgeKeys(j *zootest.Judge, c keyCase) {
+	n := len(c.bindings)
+	bs := make([]key.Binding, n)
+	ms := make([]kmir, n)
+	for i, b := range c.bindings {
+		ms[i] = b
+		bs[i] = b.binding()
+	}
+	check := func(what string) {
+		for i := range bs {
+			if bs[i].Enabled() != ms[i].enabled() {
+				j.Fail("%s: binding %d enabled %v, expected %v (keys %q, disabled %v)", what, i, bs[i].Enabled(), ms[i].enabled(), ms[i].keys, ms[i].disabled)
+			}
+			if !slices.Equal(bs[i].Keys(), ms[i].keys) {
+				j.Fail("%s: binding %d keys %q, expected %q", what, i, bs[i].Keys(), ms[i].keys)
+			}
+			if bs[i].Help() != ms[i].help {
+				j.Fail("%s: binding %d help %+v, expected %+v", what, i, bs[i].Help(), ms[i].help)
+			}
+		}
+	}
+	check("new")
+	for _, op := range c.ops {
+		if op.kind == "match" {
+			k := keyPresses[op.press]
+			want := false
+			for i := range ms {
+				if ms[i].enabled() && slices.Contains(ms[i].keys, k.String()) {
+					want = true
+				}
+			}
+			if got := key.Matches(k, bs...); got != want {
+				j.Fail("Matches(%q) = %v, expected %v", k.String(), got, want)
+			}
+			for i := range bs {
+				single := ms[i].enabled() && slices.Contains(ms[i].keys, k.String())
+				if got := key.Matches(k, bs[i]); got != single {
+					j.Fail("Matches(%q, binding %d) = %v, expected %v", k.String(), i, got, single)
+				}
+			}
+			continue
+		}
+		if n == 0 {
+			continue // nothing to set
+		}
+		i := op.at % n
+		switch op.kind {
+		case "setkeys":
+			ms[i].keys = op.keys
+			bs[i].SetKeys(op.keys...)
+		case "enable":
+			bs[i].SetEnabled(true)
+			ms[i].disabled = false
+		case "disable":
+			bs[i].SetEnabled(false)
+			ms[i].disabled = true
+		case "unbind":
+			bs[i].Unbind()
+			ms[i].keys = nil
+			ms[i].help = key.Help{}
+		case "sethelp":
+			ms[i].help = op.help
+			bs[i].SetHelp(op.help.Key, op.help.Desc)
+		}
+		check(op.kind)
+	}
+}
+
+// TestHegelKeyMatches builds a few bindings, mutates them and checks Matches
+// against membership among the enabled bindings, plus Keys, Help and Enabled.
+func TestHegelKeyMatches(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, keyCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeKeys(j, c)
+	})
+}
diff --git a/list/hegel_shapes_test.go b/list/hegel_shapes_test.go
new file mode 100644
index 0000000..e911a58
--- /dev/null
+++ b/list/hegel_shapes_test.go
@@ -0,0 +1,178 @@
+package list
+
+// The shape regions of the recorded list bugs (bugs.toml bubbles/49 to 56)
+// and the narrow properties over them: each region is a generator over the
+// bug's shape with random contents, judged exactly like the wide property
+// (judgeList). Every narrow property fails every run by default; under
+// HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (zootest.Shaped) and the property passes. The hit rates below were measured
+// with the collector over the generators themselves (BUBBLES_COLLECT=1
+// HEGEL_TEST_CASES=1000: the mismatches per case). Every shape here is also
+// drawn by the wide property at its natural rate.
+
+import (
+	"fmt"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowList runs a narrow property: every drawn case through the wide
+// property's judge.
+func narrowList(t *testing.T, cases hegel.Generator[lsCase]) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeList(j, c)
+	})
+}
+
+// plainStarts: a sized list without the help (whose line overflows a list
+// narrower than fifty, bubbles/55), of lo to hi items.
+func plainStarts(lo, hi int, widths, heights hegel.Generator[int]) hegel.Generator[lsStart] {
+	return startsOf(hegel.Map(zootest.Counted(words, lo, hi), numbered), widths, heights, descs, hegel.Just(true), hegel.Just(false))
+}
+
+// numbered titles the words "wNN word" in order.
+func numbered(ws []string) []string {
+	out := make([]string, len(ws))
+	for i, w := range ws {
+		out[i] = fmt.Sprintf("w%02d %s", i, w)
+	}
+	return out
+}
+
+func filterOp(text string) lsOp { return lsOp{kind: "filtertext", text: text} }
+func removeOp(n int) lsOp       { return lsOp{kind: "remove", n: n} }
+
+// --------------------------------------------------------------------------- bubbles/49
+
+// globalIndexUnderAnEmptyFilter: two to twenty-five items, SetFilterText of
+// an empty term (past the shape, a word) and one to three moves down: the
+// library's match records carry index 0 and GlobalIndex is 0 whatever is
+// selected (1000 of 1000).
+var globalIndexUnderAnEmptyFilter = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(2, 25, widths, heights))
+	term := zootest.Shaped("", hegel.Draw(tc, words))
+	downs := hegel.Draw(tc, zootest.Counted(hegel.Map(zootest.Sampled("down", "j"), opOf), 1, 3))
+	return lsCase{start: start, ops: append([]lsOp{filterOp(term)}, downs...)}
+})
+
+func TestHegelListGlobalIndexUnderAnEmptyFilter(t *testing.T) {
+	narrowList(t, globalIndexUnderAnEmptyFilter)
+}
+
+// --------------------------------------------------------------------------- bubbles/50
+
+// removeItemUnderAFilter: two to ten items in a list of width 28 or more
+// (the status bar of the filter fits), a filter "w0k" matching item k alone
+// (k from 1), then RemoveItem(k) (past the shape, of an index past the
+// items, a no-op): the library takes k into its one match record, leaves
+// the removed item shown and the filter applied where the truth has nothing
+// left to show (1000 of 1000).
+var removeItemUnderAFilter = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(2, 10, zootest.Ints(28, 60), heights))
+	k := hegel.Draw(tc, zootest.Ints(1, len(start.titles)-1))
+	n := zootest.Shaped(k, len(start.titles))
+	return lsCase{start: start, ops: []lsOp{filterOp(fmt.Sprintf("w%02d", k)), removeOp(n)}}
+})
+
+func TestHegelListRemoveItemUnderAFilter(t *testing.T) {
+	narrowList(t, removeItemUnderAFilter)
+}
+
+// --------------------------------------------------------------------------- bubbles/51
+
+// removeItemWithANegativeIndex: any items and RemoveItem of -5 to -1 (past
+// the shape, 0 to 26): the library panics (1000 of 1000).
+var removeItemWithANegativeIndex = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(0, 25, widths, heights))
+	n := hegel.Draw(tc, zootest.Ints(zootest.Shaped(-5, 0), zootest.Shaped(-1, 26)))
+	return lsCase{start: start, ops: []lsOp{removeOp(n)}}
+})
+
+func TestHegelListRemoveItemWithANegativeIndex(t *testing.T) {
+	narrowList(t, removeItemWithANegativeIndex)
+}
+
+// --------------------------------------------------------------------------- bubbles/52
+
+// setItemsUnderAFilterStallsThePages: a filter "w" (every title starts with
+// it), then SetItems of more items than a page holds (past the shape, a
+// page or fewer): the library counted its pages before the matches came
+// and keeps one (1000 of 1000).
+var setItemsUnderAFilterStallsThePages = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(0, 25, widths, heights))
+	pp := newLsModel(start).pp
+	titles := hegel.Draw(tc, hegel.Map(zootest.Counted(words, zootest.Shaped(pp+1, 0), zootest.Shaped(25, pp)), numbered))
+	return lsCase{start: start, ops: []lsOp{filterOp("w"), {kind: "setitems", titles: titles}}}
+})
+
+func TestHegelListSetItemsUnderAFilterStallsThePages(t *testing.T) {
+	narrowList(t, setItemsUnderAFilterStallsThePages)
+}
+
+// --------------------------------------------------------------------------- bubbles/53
+
+// setItemsLeavesTheCursorPastTheEnd: a height of 13 or more (a page of two
+// or more), at least a page of items, Select of a cursor on the first page
+// above 0 (past the shape, 0) and SetItems of one item: the library keeps
+// the cursor on the clamped page, past the one item (1000 of 1000).
+var setItemsLeavesTheCursorPastTheEnd = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(12, 25, widths, zootest.Ints(13, 30)))
+	pp := newLsModel(start).pp
+	i := hegel.Draw(tc, zootest.Ints(zootest.Shaped(1, 0), zootest.Shaped(pp-1, 0)))
+	one := hegel.Draw(tc, hegel.Map(zootest.Counted(words, 1, 1), numbered))
+	return lsCase{start: start, ops: []lsOp{{kind: "select", n: i}, {kind: "setitems", titles: one}}}
+})
+
+func TestHegelListSetItemsLeavesTheCursorPastTheEnd(t *testing.T) {
+	narrowList(t, setItemsLeavesTheCursorPastTheEnd)
+}
+
+// --------------------------------------------------------------------------- bubbles/54
+
+// newDoesNotSizeTheHelp: a fresh list New alone made (past the shape, sized
+// by SetSize) of one to twenty-five items, the help shown, narrower than its
+// short help of fifty cells (past the shape, fifty or wider), then up to
+// three keys: the help line runs past the width (1000 of 1000).
+var newDoesNotSizeTheHelp = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, startsOf(hegel.Map(zootest.Counted(words, 1, 25), numbered), zootest.Ints(zootest.Shaped(20, 50), zootest.Shaped(47, 60)), heights, descs, hegel.Just(zootest.Shaped(false, true)), hegel.Just(true)))
+	return lsCase{start: start, ops: hegel.Draw(tc, zootest.Counted(keyOps, 0, 3))}
+})
+
+func TestHegelListNewDoesNotSizeTheHelp(t *testing.T) {
+	narrowList(t, newDoesNotSizeTheHelp)
+}
+
+// --------------------------------------------------------------------------- bubbles/55
+
+// chromeOverflowsTheWidth: two to ten items in a sized list of width 20 to
+// 26 (past the shape, 28 or more) and a filter "w0k" matching item k alone:
+// the status bar "\u201cw0k\u201d 1 item \u2022 n filtered" of 25 or 26
+// cells is padded by two and never cut (1000 of 1000).
+var chromeOverflowsTheWidth = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(2, 10, zootest.Ints(zootest.Shaped(20, 28), zootest.Shaped(26, 60)), heights))
+	k := hegel.Draw(tc, zootest.Ints(0, len(start.titles)-1))
+	return lsCase{start: start, ops: []lsOp{filterOp(fmt.Sprintf("w%02d", k))}}
+})
+
+func TestHegelListChromeOverflowsTheWidth(t *testing.T) {
+	narrowList(t, chromeOverflowsTheWidth)
+}
+
+// --------------------------------------------------------------------------- bubbles/56
+
+// removeItemKeepsTheBindings: one item (past the shape, two), RemoveItem(0)
+// and "/": the library did not refresh the bindings and opens the filter
+// over nothing (1000 of 1000).
+var removeItemKeepsTheBindings = hegel.Composite(func(tc hegel.TestCase) lsCase {
+	start := hegel.Draw(tc, plainStarts(zootest.Shaped(1, 2), zootest.Shaped(1, 2), widths, heights))
+	return lsCase{start: start, ops: []lsOp{removeOp(0), opOf("/")}}
+})
+
+func TestHegelListRemoveItemKeepsTheBindings(t *testing.T) {
+	narrowList(t, removeItemKeepsTheBindings)
+}
diff --git a/list/hegel_test.go b/list/hegel_test.go
new file mode 100644
index 0000000..7f4ef18
--- /dev/null
+++ b/list/hegel_test.go
@@ -0,0 +1,1308 @@
+package list
+
+// Hegel property tests for the list bubble: items, a fuzzy filter, a
+// selection and a paginator, with a title, a status bar, pagination dots and
+// a help line around the page of items.
+//
+// A case is a record of the start (the items, the size, whether the default
+// delegate shows descriptions, whether SetSize follows New, whether the help
+// is shown) and a list of operation records (every default binding and the
+// filter input's keys, Select, SetItems, SetItem, InsertItem, RemoveItem,
+// SetSize, the section toggles, SetFilterText, ResetFilter, the page and end
+// methods, InfiniteScrolling) applied in order; the commands Update returns
+// are run at once and their messages fed back, as Bubble Tea would. The model
+// keeps the items, the filter state and term, the items shown (all of them,
+// or DefaultFilter's ranks: the library's own filter is the oracle for the
+// order, the list's bookkeeping around it is what is tested), the selection,
+// the layout and a mirror of the paginator, and beside the truth the
+// library's own bookkeeping where it goes wrong: the match records it keeps
+// (their global indices), the page count as it last computed it, the cursor
+// as it restores it, the key bindings as it last refreshed them. After the
+// start and after every operation FilterState, FilterValue, Items,
+// VisibleItems, PerPage, TotalPages, Index, Page, Cursor, SelectedItem,
+// GlobalIndex and the lines of View (the title or filter line, the status
+// text, the page's items with the selected one marked, the pagination dots
+// or p/n, every line within the width) must follow the truth.
+//
+// The shapes of the recorded bugs are drawn like any other case and the
+// classifier names the bug a step has before it is taken: a negative
+// RemoveItem index (bubbles/51), RemoveItem under a filter (50), a stale key
+// binding (56), and on a clone where the step is replayed the state it
+// leaves: an empty filter's zero indices (49), a stale page count (52), a
+// cursor past the end (53), a fresh list's unsized help or filter line (54),
+// chrome wider than the list (55). The comparison is always made and fails
+// naming the shape. Under HEGEL_NO_KNOWN=1 the list is always sized, the help
+// starts hidden and the operations that would reach a shape are dropped from
+// the case.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+)
+
+var property = zootest.Property
+
+type zitem struct{ title string }
+
+func (i zitem) Title() string       { return i.title }
+func (i zitem) Description() string { return "desc" }
+func (i zitem) FilterValue() string { return i.title }
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+var browseKeys = map[string]tea.KeyPressMsg{
+	"up": keyOf(tea.KeyUp), "k": typed('k'), "down": keyOf(tea.KeyDown), "j": typed('j'),
+	"left": keyOf(tea.KeyLeft), "h": typed('h'), "pgup": keyOf(tea.KeyPgUp), "b": typed('b'), "u": typed('u'),
+	"right": keyOf(tea.KeyRight), "l": typed('l'), "pgdown": keyOf(tea.KeyPgDown), "f": typed('f'), "d": typed('d'),
+	"home": keyOf(tea.KeyHome), "g": typed('g'), "end": keyOf(tea.KeyEnd), "G": typed('G'),
+	"/": typed('/'), "esc": keyOf(tea.KeyEscape),
+	"a": typed('a'), "b!": typed('b'), "c": typed('c'), "d!": typed('d'), "e": typed('e'),
+	"backspace": keyOf(tea.KeyBackspace), "enter": keyOf(tea.KeyEnter),
+}
+
+// ranked is the order DefaultFilter gives the items for a term.
+func ranked(term string, titles []string) []int {
+	var out []int
+	for _, r := range DefaultFilter(term, titles) {
+		out = append(out, r.Index)
+	}
+	return out
+}
+
+func seq(n int) []int {
+	out := make([]int, n)
+	for i := range out {
+		out[i] = i
+	}
+	return out
+}
+
+func plainLine(l string) string {
+	return strings.TrimRight(zootest.Plain(zootest.Cells(l)), " ")
+}
+
+func cellsWidth(s string) int { return zootest.Width(zootest.Cells(s)) }
+
+func clampInt(v, lo, hi int) int { return min(max(v, lo), hi) }
+
+// ---------------------------------------------------------------- generators
+
+var (
+	// words: one to five letters from a to e (so that terms of such letters
+	// match some titles).
+	words = hegel.Map(zootest.Counted(hegel.Map(zootest.Ints(0, 4), func(i int) rune { return 'a' + rune(i) }), 1, 5),
+		func(r []rune) string { return string(r) })
+	// terms: a filter term of one to three such letters, or none one time
+	// in ten.
+	terms = zootest.Weighted(zootest.W(9, hegel.Map(zootest.Counted(hegel.Map(zootest.Ints(0, 4), func(i int) rune { return 'a' + rune(i) }), 1, 3),
+		func(r []rune) string { return string(r) })), zootest.W(1, hegel.Just("")))
+	widths  = zootest.Ints(20, 60)
+	heights = zootest.Ints(12, 30)
+	// descs: whether the delegate shows descriptions (an item of two lines),
+	// seven times in ten.
+	descs = zootest.Coin(70)
+	// sizeds: whether SetSize follows New, four times in five (never not
+	// under HEGEL_NO_KNOWN=1: a fresh list's help and filter input are
+	// unsized, bubbles/54).
+	sizeds = zootest.Weighted(zootest.W(4, hegel.Just(true)), zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(false)))
+	// helps: whether the help starts shown, half the time (never under
+	// HEGEL_NO_KNOWN=1: the help line may overflow a list narrower than
+	// fifty, bubbles/55).
+	helps = zootest.Coin(zootest.Unless(zootest.NoKnown, 50))
+)
+
+// titlesOf: none to hi item titles "wNN word", numbered in order.
+func titlesOf(hi int) hegel.Generator[[]string] {
+	return hegel.Map(zootest.Counted(words, 0, hi), func(ws []string) []string {
+		out := make([]string, len(ws))
+		for i, w := range ws {
+			out[i] = fmt.Sprintf("w%02d %s", i, w)
+		}
+		return out
+	})
+}
+
+// lsStart is the start of a case.
+type lsStart struct {
+	titles []string
+	width  int
+	height int
+	desc   bool
+	sized  bool
+	help   bool
+}
+
+func (s lsStart) String() string {
+	flags := ""
+	if s.desc {
+		flags += " desc"
+	}
+	if !s.sized {
+		flags += " unsized"
+	}
+	if s.help {
+		flags += " help"
+	}
+	return fmt.Sprintf("list %dx%d%s items %q", s.width, s.height, flags, s.titles)
+}
+
+// build makes the list of the start: New, the virtual cursor off (its blink
+// would be a timer command), SetSize when sized, the help as drawn.
+func (s lsStart) build() Model {
+	d := NewDefaultDelegate()
+	d.ShowDescription = s.desc
+	items := make([]Item, len(s.titles))
+	for i, t := range s.titles {
+		items[i] = zitem{t}
+	}
+	m := New(items, d, s.width, s.height)
+	m.FilterInput.SetVirtualCursor(false)
+	if s.sized {
+		m.SetSize(s.width, s.height)
+	}
+	m.SetShowHelp(s.help)
+	return m
+}
+
+func startsOf(titles hegel.Generator[[]string], widths, heights hegel.Generator[int], descs, sizeds, helps hegel.Generator[bool]) hegel.Generator[lsStart] {
+	return hegel.Composite(func(tc hegel.TestCase) lsStart {
+		return lsStart{titles: hegel.Draw(tc, titles), width: hegel.Draw(tc, widths), height: hegel.Draw(tc, heights),
+			desc: hegel.Draw(tc, descs), sized: hegel.Draw(tc, sizeds), help: hegel.Draw(tc, helps)}
+	})
+}
+
+var lsStarts = startsOf(titlesOf(25), widths, heights, descs, sizeds, helps)
+
+// lsOp is one operation: a key (a binding, a letter a to e, backspace or
+// enter: what it does depends on whether the filter is being edited), or a
+// method with its arguments (indices modulo the live size, but RemoveItem's,
+// which is literal: bubbles/51 is a negative one).
+type lsOp struct {
+	kind   string
+	n, h   int
+	text   string
+	titles []string
+	which  string
+}
+
+func (op lsOp) GoString() string {
+	switch op.kind {
+	case "select", "remove":
+		return fmt.Sprintf("%s(%d)", op.kind, op.n)
+	case "setitem", "insert":
+		return fmt.Sprintf("%s(%d, %q)", op.kind, op.n, op.text)
+	case "setitems":
+		return fmt.Sprintf("setitems(%q)", op.titles)
+	case "setsize":
+		return fmt.Sprintf("setsize(%d, %d)", op.n, op.h)
+	case "toggle", "method":
+		return fmt.Sprintf("%s(%s)", op.kind, op.which)
+	case "filtertext":
+		return fmt.Sprintf("filtertext(%q)", op.text)
+	}
+	return strings.TrimSuffix(op.kind, "!")
+}
+
+func opOf(kind string) lsOp { return lsOp{kind: kind} }
+
+var (
+	keyKinds = []string{"up", "k", "down", "j", "left", "h", "pgup", "b", "u", "right", "l", "pgdown", "f", "d", "home", "g", "end", "G", "/", "esc",
+		"a", "b!", "c", "d!", "e", "backspace", "enter"}
+	pageKeys = " left h pgup b u right l pgdown f d "
+	keyOps   = hegel.Map(zootest.Sampled(keyKinds...), opOf)
+	// lsOps: an operation; keys ten times in twenty-two, RemoveItem twice,
+	// the rest once each.
+	lsOps = zootest.Weighted(
+		zootest.W(10, keyOps),
+		zootest.W(1, hegel.Map(zootest.Ints(0, 24), func(n int) lsOp { return lsOp{kind: "select", n: n} })),
+		zootest.W(1, hegel.Map(titlesOf(25), func(ts []string) lsOp { return lsOp{kind: "setitems", titles: ts} })),
+		zootest.W(1, textOp("setitem", zootest.Ints(0, 24))),
+		zootest.W(1, textOp("insert", zootest.Ints(-1, 26))),
+		zootest.W(2, hegel.Map(zootest.Ints(-1, 26), func(n int) lsOp { return lsOp{kind: "remove", n: n} })),
+		zootest.W(1, sizeOp),
+		zootest.W(1, hegel.Map(zootest.Sampled("title", "status", "pag", "help"), func(w string) lsOp { return lsOp{kind: "toggle", which: w} })),
+		zootest.W(1, hegel.Map(terms, func(t string) lsOp { return lsOp{kind: "filtertext", text: t} })),
+		zootest.W(1, hegel.Just(opOf("resetfilter"))),
+		zootest.W(1, hegel.Map(zootest.Sampled("start", "end", "next", "prev"), func(w string) lsOp { return lsOp{kind: "method", which: w} })),
+		zootest.W(1, hegel.Just(opOf("infinite"))),
+	)
+	sizeOp = hegel.Composite(func(tc hegel.TestCase) lsOp {
+		return lsOp{kind: "setsize", n: hegel.Draw(tc, widths), h: hegel.Draw(tc, heights)}
+	})
+)
+
+// textOp: kind with an index and a word.
+func textOp(kind string, ns hegel.Generator[int]) hegel.Generator[lsOp] {
+	return hegel.Composite(func(tc hegel.TestCase) lsOp {
+		return lsOp{kind: kind, n: hegel.Draw(tc, ns), text: hegel.Draw(tc, words)}
+	})
+}
+
+// lsCase is a start and the operations applied to it.
+type lsCase struct {
+	start lsStart
+	ops   []lsOp
+}
+
+func (c lsCase) GoString() string {
+	parts := make([]string, len(c.ops))
+	for i, op := range c.ops {
+		parts[i] = op.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(parts, ", ")
+}
+
+func casesOf(starts hegel.Generator[lsStart], ops hegel.Generator[[]lsOp]) hegel.Generator[lsCase] {
+	return hegel.Composite(func(tc hegel.TestCase) lsCase {
+		return lsCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// lsCases: a start and one to forty operations; under HEGEL_NO_KNOWN=1 the
+// operations that would reach a shape are dropped (unshaped).
+var lsCases = hegel.Map(casesOf(lsStarts, zootest.Counted(lsOps, 1, 40)), unshaped)
+
+// unshaped drops, under HEGEL_NO_KNOWN=1, the operations the classifier
+// names a shape for, replaying the model over the kept ones.
+func unshaped(c lsCase) lsCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	m := newLsModel(c.start)
+	var kept []lsOp
+	for _, op := range c.ops {
+		if stepShape(m, op) != "" {
+			continue
+		}
+		m.apply(op)
+		kept = append(kept, op)
+	}
+	return lsCase{start: c.start, ops: kept}
+}
+
+// ---------------------------------------------------------------- model
+
+// lsMatch is a match record as the library keeps it: the global index it
+// carries (0 for every item of an empty term, bubbles/49; stale after a
+// RemoveItem under a filter, bubbles/50) and the item's title.
+type lsMatch struct {
+	index int
+	title string
+}
+
+// lsModel is the model: the items, the filter state, term and input cursor, the indices
+// shown in order (the truth), the library's match records, the selection as
+// the library restores it (sel, the truth being sel clamped into the shown
+// items), the layout, the paginator's PerPage and the page count as the
+// library last computed it, the page and filter key bindings as it last
+// refreshed them, and whether the help and filter input were sized.
+type lsModel struct {
+	titles     []string
+	state      FilterState
+	text       string
+	cur        int // the filter input's cursor, a rune offset into text
+	visible    []int
+	matches    []lsMatch
+	sel        int
+	w, h       int
+	showTitle  bool
+	showStatus bool
+	showPag    bool
+	showHelp   bool
+	infinite   bool
+	itemH      int
+	pp         int
+	pages      int
+	kbPages    bool
+	kbItems    bool
+	sized      bool
+}
+
+func newLsModel(s lsStart) *lsModel {
+	m := &lsModel{titles: append([]string{}, s.titles...), state: Unfiltered, w: s.width, h: s.height,
+		showTitle: true, showStatus: true, showPag: true, showHelp: true, itemH: 1, sized: s.sized}
+	if s.desc {
+		m.itemH = 2
+	}
+	m.visible = m.all()
+	m.updPag(len(m.titles))
+	m.updKeys()
+	m.showHelp = s.help
+	m.updPag(len(m.titles))
+	return m
+}
+
+func (m *lsModel) clone() *lsModel {
+	d := *m
+	d.titles = append([]string{}, m.titles...)
+	d.visible = append([]int{}, m.visible...)
+	d.matches = append([]lsMatch{}, m.matches...)
+	return &d
+}
+
+func (m *lsModel) all() []int { return seq(len(m.titles)) }
+
+// filtered is the truth of what the filter shows: all the items without a
+// term, DefaultFilter's ranks with one.
+func (m *lsModel) filtered() []int {
+	if m.state == Unfiltered || m.text == "" {
+		return m.all()
+	}
+	return ranked(m.text, m.titles)
+}
+
+// libFiltered is what the library's filterItems command yields: every item
+// with index 0 for an empty term (itemsAsFilterItems), else the ranks.
+func (m *lsModel) libFiltered() []lsMatch {
+	if m.state == Unfiltered || m.text == "" {
+		out := make([]lsMatch, len(m.titles))
+		for i, t := range m.titles {
+			out[i] = lsMatch{title: t}
+		}
+		return out
+	}
+	var out []lsMatch
+	for _, i := range ranked(m.text, m.titles) {
+		out = append(out, lsMatch{index: i, title: m.titles[i]})
+	}
+	return out
+}
+
+// refilter runs the filter command: the library's matches and the truth.
+func (m *lsModel) refilter() {
+	m.matches = m.libFiltered()
+	m.visible = m.filtered()
+}
+
+// libCount is the number of items the library shows (its match records
+// under a filter).
+func (m *lsModel) libCount() int {
+	if m.state != Unfiltered {
+		return len(m.matches)
+	}
+	return len(m.titles)
+}
+
+// libTitles is VisibleItems as the library returns them.
+func (m *lsModel) libTitles() []string {
+	if m.state == Unfiltered {
+		return m.titles
+	}
+	out := make([]string, len(m.matches))
+	for i, r := range m.matches {
+		out[i] = r.title
+	}
+	return out
+}
+
+// trueTitles is what the list should show.
+func (m *lsModel) trueTitles() []string {
+	out := make([]string, len(m.visible))
+	for i, v := range m.visible {
+		out[i] = m.titles[v]
+	}
+	return out
+}
+
+func (m *lsModel) chrome() int {
+	c := 1
+	if m.showTitle || m.state == Filtering {
+		c = 2
+	}
+	if m.showStatus {
+		c += 2
+	}
+	if m.showPag {
+		c++
+	}
+	if m.showHelp {
+		c += 2
+	}
+	return c
+}
+
+// updPag mirrors updatePagination with n items shown at the time of the
+// call: PerPage from the height less the chrome, the page count, and the
+// cursor restored as it was on the page clamped into the count (past the
+// end of a shorter list, bubbles/53).
+func (m *lsModel) updPag(n int) {
+	m.pp = max(1, (m.h-m.chrome())/(m.itemH+1))
+	if n < 1 {
+		m.pages = 1
+	} else {
+		m.pages = (n + m.pp - 1) / m.pp
+	}
+	page, cursor := m.sel/m.pp, m.sel%m.pp
+	if page >= m.pages-1 {
+		page = max(0, m.pages-1)
+	}
+	m.sel = page*m.pp + cursor
+}
+
+// updKeys mirrors updateKeybindings' browsing branch.
+func (m *lsModel) updKeys() {
+	m.kbPages = m.pages > 1
+	m.kbItems = len(m.titles) > 0
+}
+
+// truePages is the page count of the items shown.
+func (m *lsModel) truePages() int {
+	if len(m.visible) < 1 {
+		return 1
+	}
+	return (len(m.visible) + m.pp - 1) / m.pp
+}
+
+// trueSel is the selection: sel clamped into the items shown.
+func (m *lsModel) trueSel() int { return clampInt(m.sel, 0, max(0, len(m.visible)-1)) }
+
+// endSel is the last item as GoToEnd finds it: the last page's last item,
+// by the library's page count.
+func (m *lsModel) endSel() int {
+	return (m.pages-1)*m.pp + max(0, clampInt(m.libCount()-(m.pages-1)*m.pp, 0, m.pp)-1)
+}
+
+// clampCursor mirrors handleBrowsing's clamp after every browsing message.
+func (m *lsModel) clampCursor() {
+	page, cursor := m.sel/m.pp, m.sel%m.pp
+	on := clampInt(m.libCount()-page*m.pp, 0, m.pp)
+	m.sel = page*m.pp + clampInt(cursor, 0, max(0, on-1))
+}
+
+// reset mirrors resetFiltering.
+func (m *lsModel) reset() {
+	if m.state == Unfiltered {
+		return
+	}
+	m.state = Unfiltered
+	m.text, m.cur = "", 0
+	m.matches = nil
+	m.visible = m.all()
+	m.updPag(len(m.titles))
+	m.updKeys()
+}
+
+// libGlobal is GlobalIndex as the library computes it.
+func (m *lsModel) libGlobal() int {
+	if m.matches == nil || m.sel >= len(m.matches) {
+		return m.sel
+	}
+	return m.matches[m.sel].index
+}
+
+// apply applies op to the model.
+func (m *lsModel) apply(op lsOp) {
+	switch op.kind {
+	case "select":
+		i := op.n % max(1, m.libCount())
+		m.sel = i
+	case "setitems":
+		m.titles = append([]string{}, op.titles...)
+		if m.state != Unfiltered {
+			m.matches = nil
+			m.updPag(0)
+			m.updKeys()
+			m.refilter()
+		} else {
+			m.visible = m.all()
+			m.updPag(len(m.titles))
+			m.updKeys()
+		}
+	case "setitem":
+		if len(m.titles) == 0 {
+			return
+		}
+		i := op.n % len(m.titles)
+		m.titles[i] = fmt.Sprintf("w%02d %s", i, op.text)
+		m.updPag(m.libCount())
+		if m.state != Unfiltered {
+			m.refilter()
+		} else {
+			m.visible = m.all()
+		}
+	case "insert":
+		at := clampInt(op.n, 0, len(m.titles))
+		m.titles = append(m.titles[:at], append([]string{"w99 " + op.text}, m.titles[at:]...)...)
+		if m.state == Unfiltered {
+			m.visible = m.all()
+		}
+		m.updPag(m.libCount())
+		m.updKeys()
+		if m.state != Unfiltered {
+			m.refilter()
+		}
+	case "remove":
+		m.remove(op.n)
+	case "setsize":
+		m.w, m.h = op.n, op.h
+		m.sized = true
+		m.updPag(m.libCount())
+		m.updKeys()
+	case "toggle":
+		switch op.which {
+		case "title":
+			m.showTitle = !m.showTitle
+		case "status":
+			m.showStatus = !m.showStatus
+		case "pag":
+			m.showPag = !m.showPag
+		case "help":
+			m.showHelp = !m.showHelp
+		}
+		m.updPag(m.libCount())
+	case "filtertext":
+		m.state = FilterApplied
+		m.text, m.cur = op.text, len([]rune(op.text))
+		m.refilter()
+		m.sel = 0
+		m.updPag(m.libCount())
+		m.updKeys()
+	case "resetfilter":
+		m.reset()
+	case "method":
+		page := m.sel / m.pp
+		switch op.which {
+		case "start":
+			m.sel = 0
+		case "end":
+			m.sel = m.endSel()
+		case "next":
+			if page < m.pages-1 {
+				m.sel += m.pp
+			}
+			m.clampCursor()
+		case "prev":
+			if page > 0 {
+				m.sel -= m.pp
+			}
+			m.clampCursor()
+		}
+	case "infinite":
+		m.infinite = !m.infinite
+	default:
+		if m.state == Filtering {
+			m.filterKey(op.kind)
+		} else {
+			m.browseKey(op.kind)
+		}
+	}
+}
+
+// remove is RemoveItem(n) (n in range; a negative one panics, bubbles/51):
+// the item out of the items and, under a filter, out of the shown ones, the
+// filter reset when none is shown; the library takes n into its match
+// records instead (bubbles/50), which the model mirrors.
+func (m *lsModel) remove(n int) {
+	if n < len(m.titles) {
+		m.titles = append(m.titles[:n], m.titles[n+1:]...)
+	}
+	if m.state == Unfiltered {
+		m.visible = m.all()
+		m.updPag(len(m.titles))
+		return
+	}
+	m.visible = without(m.visible, n)
+	if n < len(m.matches) {
+		m.matches = append(m.matches[:n:n], m.matches[n+1:]...)
+	}
+	if len(m.visible) == 0 {
+		m.state = Unfiltered
+		m.text, m.cur = "", 0
+		m.matches = nil
+		m.visible = m.all()
+		m.updPag(len(m.titles))
+		m.updKeys()
+		return
+	}
+	m.updPag(len(m.matches))
+}
+
+// without is the shown indices with item n taken out and the later ones
+// moved down.
+func without(visible []int, n int) []int {
+	var keep []int
+	for _, v := range visible {
+		if v < n {
+			keep = append(keep, v)
+		} else if v > n {
+			keep = append(keep, v-1)
+		}
+	}
+	return keep
+}
+
+// removeDiverges reports a RemoveItem(n) under a filter whose outcome in
+// the library (its match at position n removed, the filter reset when its
+// records run out) differs in what is shown or in the filter's state from
+// the truth (bubbles/50); stale global indices are left to the state.
+func (m *lsModel) removeDiverges(n int) bool {
+	var lib []string
+	for i, r := range m.matches {
+		if i != n {
+			lib = append(lib, r.title)
+		}
+	}
+	var truth []string
+	for _, v := range without(m.visible, n) {
+		if v < n {
+			truth = append(truth, m.titles[v])
+		} else {
+			truth = append(truth, m.titles[v+1])
+		}
+	}
+	if (len(lib) == 0) != (len(truth) == 0) {
+		return true
+	}
+	return strings.Join(lib, "\x00") != strings.Join(truth, "\x00")
+}
+
+// browseKey is a key while browsing.
+func (m *lsModel) browseKey(k string) {
+	n := m.libCount()
+	page := m.sel / m.pp
+	switch k {
+	case "up", "k":
+		if n == 0 {
+			break
+		}
+		if m.sel == 0 {
+			if m.infinite {
+				m.sel = m.endSel()
+			}
+		} else {
+			m.sel--
+		}
+	case "down", "j":
+		if n == 0 {
+			break
+		}
+		if m.sel >= m.endSel() {
+			if m.infinite {
+				m.sel = 0
+			}
+		} else {
+			m.sel++
+		}
+	case "left", "h", "pgup", "b", "u", "b!":
+		if page > 0 {
+			m.sel -= m.pp
+		}
+	case "right", "l", "pgdown", "f", "d", "d!":
+		if page < m.pages-1 {
+			m.sel += m.pp
+		}
+	case "home", "g":
+		m.sel = 0
+	case "end", "G":
+		m.sel = m.endSel()
+	case "/":
+		if len(m.titles) == 0 {
+			break
+		}
+		if m.text == "" {
+			m.refilter()
+		}
+		m.sel = 0
+		m.state = Filtering
+		m.cur = len([]rune(m.text))
+		m.kbPages, m.kbItems = false, false
+		m.updPag(m.libCount()) // the blink message comes back through handleFiltering
+		return
+	case "esc":
+		m.reset()
+	}
+	m.clampCursor()
+}
+
+// filterKey is a key while the filter is being edited: a letter typed into
+// the term at the input's cursor (the filter re-run, the pagination updated
+// before its matches arrive, bubbles/52), backspace, the cursor keys, enter
+// or up/down accepting a term, esc cancelling.
+func (m *lsModel) filterKey(k string) {
+	n := m.libCount()
+	rs := []rune(m.text)
+	switch k {
+	case "enter", "up", "down":
+		if m.text == "" || len(m.titles) == 0 {
+			m.updPag(n)
+			return
+		}
+		if n == 0 {
+			m.reset()
+			return
+		}
+		m.state = FilterApplied
+		m.updKeys() // the accept path refreshes the bindings before the pagination (bubbles/56)
+		m.updPag(n)
+	case "esc":
+		m.reset()
+		m.kbItems = true // cancel re-enables the filter key whatever the items (bubbles/56)
+	case "backspace":
+		m.updPag(n)
+		if m.cur > 0 {
+			m.text = string(append(rs[:m.cur-1:m.cur-1], rs[m.cur:]...))
+			m.cur--
+			m.refilter()
+		}
+	case "left":
+		m.cur = max(0, m.cur-1)
+		m.updPag(n)
+	case "right":
+		m.cur = min(len(rs), m.cur+1)
+		m.updPag(n)
+	case "home":
+		m.cur = 0
+		m.updPag(n)
+	case "end":
+		m.cur = len(rs)
+		m.updPag(n)
+	case "pgup", "pgdown":
+		m.updPag(n)
+	default:
+		ch := []rune(strings.TrimSuffix(k, "!"))
+		m.text = string(append(append(append([]rune{}, rs[:m.cur]...), ch...), rs[m.cur:]...))
+		m.cur += len(ch)
+		m.updPag(n)
+		m.refilter()
+	}
+}
+
+// ---------------------------------------------------------------- shapes
+
+// status is the status bar's text.
+func (m *lsModel) status() string {
+	n := len(m.visible)
+	name := "items"
+	if n == 1 {
+		name = "item"
+	}
+	var b string
+	switch {
+	case m.state == Filtering && n == 0:
+		b = "Nothing matched"
+	case m.state == Filtering:
+		b = fmt.Sprintf("%d %s", n, name)
+	case len(m.titles) == 0:
+		b = "No items"
+	default:
+		if m.state == FilterApplied {
+			b = "\u201c" + truncated(strings.TrimSpace(m.text), 10) + "\u201d "
+		}
+		b += fmt.Sprintf("%d %s", n, name)
+	}
+	if k := len(m.titles) - n; k > 0 {
+		b += fmt.Sprintf(" \u2022 %d filtered", k)
+	}
+	return b
+}
+
+// truncated cuts s to width cells with an ellipsis.
+func truncated(s string, width int) string {
+	cells := zootest.Cells(s)
+	if zootest.Width(cells) <= width {
+		return s
+	}
+	var b strings.Builder
+	col := 0
+	for _, c := range cells {
+		if col+c.W > width-1 {
+			break
+		}
+		b.WriteString(c.S)
+		col += c.W
+	}
+	return b.String() + "\u2026"
+}
+
+// helpWidth is the width of the short help as the help bubble lays it out
+// at width (0 for unsized): the enabled items in order, separated, each
+// added while it fits or no ellipsis fits after the ones before it.
+func (m *lsModel) helpWidth(width int) int {
+	var items []string
+	if m.state == Filtering {
+		if m.text != "" {
+			items = append(items, "enter apply filter")
+		}
+		items = append(items, "esc cancel")
+	} else {
+		if m.kbItems {
+			items = append(items, "\u2191/k up", "\u2193/j down", "/ filter")
+		}
+		if m.state == FilterApplied {
+			items = append(items, "esc clear filter")
+		}
+		items = append(items, "v select", "? more")
+	}
+	total := 0
+	for _, it := range items {
+		w := cellsWidth(it)
+		if total > 0 {
+			w += 3
+		}
+		if width > 0 && total+w > width && total+2 < width {
+			return total + 2
+		}
+		total += w
+	}
+	return total
+}
+
+// chromeShape names the chrome line wider than the list: the unsized filter
+// line or help line of a fresh list (bubbles/54), the status bar, the dots
+// or the sized help line (55).
+func (m *lsModel) chromeShape() string {
+	switch {
+	case m.state == Filtering && !m.sized && 10+cellsWidth(m.text) > m.w:
+		return "bubbles/54"
+	case m.showStatus && 2+cellsWidth(m.status()) > m.w:
+		return "bubbles/55"
+	case m.showPag && m.pages >= 2 && m.pages <= m.w && m.pages+2 > m.w:
+		return "bubbles/55"
+	case m.showHelp && !m.sized && 2+m.helpWidth(0) > m.w:
+		return "bubbles/54"
+	case m.showHelp && 2+m.helpWidth(m.w) > m.w:
+		return "bubbles/55"
+	}
+	return ""
+}
+
+// stateShape names the recorded bug whose shape the model's state has, in
+// the order of the checks: the library's match records showing other items
+// than the truth (bubbles/50); a page count the matches did not update
+// (52); a cursor restored past the end (53); a global index of 0 under an
+// empty term (49) or stale after a RemoveItem (50); then the chrome.
+func stateShape(m *lsModel) string {
+	switch {
+	case m.state != Unfiltered && strings.Join(m.libTitles(), "\x00") != strings.Join(m.trueTitles(), "\x00"):
+		return "bubbles/50"
+	case m.pages != m.truePages():
+		return "bubbles/52"
+	case m.sel != m.trueSel():
+		return "bubbles/53"
+	case len(m.visible) > 0 && m.libGlobal() != m.visible[m.sel]:
+		if m.text == "" {
+			return "bubbles/49"
+		}
+		return "bubbles/50"
+	}
+	return m.chromeShape()
+}
+
+// stepShape names the recorded bug whose shape the operation has from the
+// model's state, before it is taken: RemoveItem with a negative index, which
+// panics (bubbles/51); RemoveItem under a filter that takes the index into
+// the match records (50); a page key or the filter key whose binding the
+// library did not refresh (56); then the shapes of the state the operation
+// leaves (on a clone where it is replayed).
+func stepShape(m *lsModel, op lsOp) string {
+	switch {
+	case op.kind == "remove" && op.n < 0:
+		return "bubbles/51"
+	case op.kind == "remove" && m.state != Unfiltered && m.removeDiverges(op.n):
+		return "bubbles/50"
+	case m.state != Filtering && strings.Contains(pageKeys, " "+strings.TrimSuffix(op.kind, "!")+" ") && !m.kbPages && m.pages > 1:
+		return "bubbles/56"
+	case m.state != Filtering && op.kind == "/" && m.kbItems && len(m.titles) == 0:
+		return "bubbles/56"
+	}
+	d := m.clone()
+	d.apply(op)
+	return stateShape(d)
+}
+
+// ---------------------------------------------------------------- judge
+
+// feed runs a command and feeds its messages to the list, as Bubble Tea
+// would.
+func feed(l *Model, cmd tea.Cmd) {
+	if cmd == nil {
+		return
+	}
+	switch v := cmd().(type) {
+	case nil:
+	case tea.BatchMsg:
+		for _, c := range v {
+			feed(l, c)
+		}
+	case tea.QuitMsg:
+	default:
+		var next tea.Cmd
+		*l, next = l.Update(v)
+		feed(l, next)
+	}
+}
+
+func press(l *Model, k tea.KeyPressMsg) {
+	var cmd tea.Cmd
+	*l, cmd = l.Update(k)
+	feed(l, cmd)
+}
+
+// applyLib applies op to the list; the arguments are resolved against the
+// model's state before the operation.
+func applyLib(l *Model, m *lsModel, op lsOp) {
+	switch op.kind {
+	case "select":
+		l.Select(op.n % max(1, m.libCount()))
+	case "setitems":
+		items := make([]Item, len(op.titles))
+		for i, t := range op.titles {
+			items[i] = zitem{t}
+		}
+		feed(l, l.SetItems(items))
+	case "setitem":
+		if len(m.titles) == 0 {
+			return
+		}
+		i := op.n % len(m.titles)
+		feed(l, l.SetItem(i, zitem{fmt.Sprintf("w%02d %s", i, op.text)}))
+	case "insert":
+		feed(l, l.InsertItem(op.n, zitem{"w99 " + op.text}))
+	case "remove":
+		l.RemoveItem(op.n)
+	case "setsize":
+		l.SetSize(op.n, op.h)
+	case "toggle":
+		switch op.which {
+		case "title":
+			l.SetShowTitle(!m.showTitle)
+		case "status":
+			l.SetShowStatusBar(!m.showStatus)
+		case "pag":
+			l.SetShowPagination(!m.showPag)
+		case "help":
+			l.SetShowHelp(!m.showHelp)
+		}
+	case "filtertext":
+		l.SetFilterText(op.text)
+	case "resetfilter":
+		l.ResetFilter()
+	case "method":
+		switch op.which {
+		case "start":
+			l.GoToStart()
+		case "end":
+			l.GoToEnd()
+		case "next":
+			l.NextPage()
+		case "prev":
+			l.PrevPage()
+		}
+	case "infinite":
+		l.InfiniteScrolling = !m.infinite
+	default:
+		press(l, browseKeys[op.kind])
+	}
+}
+
+// judgeList builds the start, applies the operations and checks the list
+// against the model after the start and after every operation; the wide and
+// the narrow properties share it.
+func judgeList(j *zootest.Judge, c lsCase) {
+	m := newLsModel(c.start)
+	j.Shape(stateShape(m))
+	l := c.start.build()
+	checkList(j, &l, m, "at the start")
+	for _, op := range c.ops {
+		j.Shape(stepShape(m, op))
+		applyLib(&l, m, op)
+		m.apply(op)
+		j.Note("%s -> %v %q sel %d of %d, %d pages of %d", op.GoString(), m.state, m.text, m.sel, len(m.visible), m.pages, m.pp)
+		checkList(j, &l, m, "after "+op.GoString())
+	}
+}
+
+// checkList compares the list with the model: the filter state and term,
+// the item count, PerPage, VisibleItems, TotalPages, Index, Page, Cursor,
+// SelectedItem, GlobalIndex and the view.
+func checkList(j *zootest.Judge, l *Model, m *lsModel, what string) {
+	if l.FilterState() != m.state || l.FilterValue() != m.text {
+		j.Fail("%s: state %v %q, want %v %q", what, l.FilterState(), l.FilterValue(), m.state, m.text)
+	}
+	if len(l.Items()) != len(m.titles) {
+		j.Fail("%s: %d items, want %d", what, len(l.Items()), len(m.titles))
+	}
+	if l.Paginator.PerPage != m.pp {
+		j.Fail("%s: PerPage %d, want %d (height %d, chrome %d)", what, l.Paginator.PerPage, m.pp, m.h, m.chrome())
+	}
+	var got []string
+	for _, it := range l.VisibleItems() {
+		got = append(got, it.(zitem).title)
+	}
+	if want := m.trueTitles(); strings.Join(got, "\x00") != strings.Join(want, "\x00") {
+		j.Fail("%s: VisibleItems %q, want %q", what, got, want)
+	}
+	if pages := m.truePages(); l.Paginator.TotalPages != pages {
+		j.Fail("%s: TotalPages %d, want %d", what, l.Paginator.TotalPages, pages)
+	}
+	sel := m.trueSel()
+	if l.Index() != sel || l.Paginator.Page != sel/m.pp || l.Cursor() != sel%m.pp {
+		j.Fail("%s: Index %d (page %d, cursor %d), want %d (page %d, cursor %d)", what, l.Index(), l.Paginator.Page, l.Cursor(), sel, sel/m.pp, sel%m.pp)
+	}
+	if len(m.visible) == 0 {
+		if l.SelectedItem() != nil {
+			j.Fail("%s: SelectedItem %v with nothing shown", what, l.SelectedItem())
+		}
+	} else {
+		want := m.titles[m.visible[sel]]
+		if got := l.SelectedItem(); got == nil || got.(zitem).title != want {
+			j.Fail("%s: SelectedItem %v, want %q", what, got, want)
+		}
+		if gi := l.GlobalIndex(); gi != m.visible[sel] {
+			j.Fail("%s: GlobalIndex %d, want %d", what, gi, m.visible[sel])
+		}
+	}
+	checkView(j, l, m, what)
+}
+
+// checkView compares the lines of View with the model: the height, every
+// line within the width, the title or filter line, the status, the page's
+// items (the selected one marked) and the pagination.
+func checkView(j *zootest.Judge, l *Model, m *lsModel, what string) {
+	lines := strings.Split(l.View(), "\n")
+	if len(lines) != m.h {
+		j.Fail("%s: View has %d lines, want %d", what, len(lines), m.h)
+	}
+	for i, line := range lines {
+		if wd := cellsWidth(strings.TrimRight(line, " ")); wd > m.w {
+			j.Fail("%s: line %d is %d cells wide in a width of %d: %q", what, i, wd, m.w, plainLine(line))
+		}
+	}
+	li := 1
+	switch {
+	case m.state == Filtering:
+		if !strings.HasPrefix(plainLine(lines[0]), "  Filter:") {
+			j.Fail("%s: title line %q while filtering", what, plainLine(lines[0]))
+		}
+		li = 2
+	case m.showTitle:
+		if got := plainLine(lines[0]); got != "   List" {
+			j.Fail("%s: title line %q", what, got)
+		}
+		li = 2
+	}
+	if m.showStatus {
+		if got, want := plainLine(lines[li]), "  "+m.status(); got != want {
+			j.Fail("%s: status line %q, want %q", what, got, want)
+		}
+		li += 2
+	}
+	n := len(m.visible)
+	sel := m.trueSel()
+	page := sel / m.pp
+	switch {
+	case n == 0 && m.state == Filtering:
+		if got := plainLine(lines[li]); got != "" {
+			j.Fail("%s: content %q while filtering to nothing", what, got)
+		}
+	case n == 0:
+		if got := plainLine(lines[li]); got != "No items." {
+			j.Fail("%s: content %q with no items, want %q", what, got, "No items.")
+		}
+	default:
+		for k := page * m.pp; k < min(n, (page+1)*m.pp); k++ {
+			mark := "  "
+			if k == sel && m.state != Filtering {
+				mark = "\u2502 "
+			}
+			at := li + (k-page*m.pp)*(m.itemH+1)
+			if got, want := plainLine(lines[at]), mark+m.titles[m.visible[k]]; got != want {
+				j.Fail("%s: item line %d %q, want %q", what, at, got, want)
+			}
+			if m.itemH == 2 {
+				if got, want := plainLine(lines[at+1]), mark+"desc"; got != want {
+					j.Fail("%s: desc line %d %q, want %q", what, at+1, got, want)
+				}
+			}
+		}
+	}
+	if m.showPag {
+		pl := m.h - 1
+		if m.showHelp {
+			pl -= 2
+		}
+		got := plainLine(lines[pl])
+		pages := m.truePages()
+		switch {
+		case pages < 2:
+			if got != "" {
+				j.Fail("%s: pagination %q with one page", what, got)
+			}
+		case pages <= m.w:
+			if got != "  "+strings.Repeat("\u2022", pages) {
+				j.Fail("%s: pagination %q, want %d dots", what, got, pages)
+			}
+		default:
+			if want := fmt.Sprintf("  %d/%d", page+1, pages); got != want {
+				j.Fail("%s: pagination %q, want %q", what, got, want)
+			}
+		}
+	}
+}
+
+// TestHegelListFollowsTheModel: the selection index follows the bindings and
+// the setters; the filter's visible items are DefaultFilter's ranks; Index,
+// GlobalIndex, SelectedItem, VisibleItems, the paginator and the lines of
+// View (title, status, the page's items with the selected one marked, the
+// pagination dots) agree with the model after every step.
+func TestHegelListFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lsCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeList(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func panicked(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+func pinItems(n int) []Item {
+	its := make([]Item, n)
+	for i := range its {
+		its[i] = zitem{fmt.Sprintf("item %02d", i)}
+	}
+	return its
+}
+
+func pinList(n int) Model {
+	m := New(pinItems(n), NewDefaultDelegate(), 40, 14)
+	m.FilterInput.SetVirtualCursor(false)
+	m.SetSize(40, 14)
+	return m
+}
+
+func runCmd(m Model, cmd tea.Cmd) Model {
+	if cmd == nil {
+		return m
+	}
+	switch v := cmd().(type) {
+	case tea.BatchMsg:
+		for _, c := range v {
+			m = runCmd(m, c)
+		}
+	case FilterMatchesMsg:
+		m, _ = m.Update(v)
+	}
+	return m
+}
+
+func widest(view string) int {
+	w := 0
+	for _, l := range strings.Split(view, "\n") {
+		w = max(w, zootest.Width(zootest.Cells(strings.TrimRight(l, " "))))
+	}
+	return w
+}
+
+// bubbles/49: with an empty filter the visible items all carry index 0, so
+// GlobalIndex is 0 for every selection.
+func TestHegelPinListGlobalIndexOfAnEmptyFilter(t *testing.T) {
+	m := pinList(6)
+	m.SetFilterText("")
+	m.CursorDown()
+	m.CursorDown()
+	if m.Index() != 2 || m.GlobalIndex() != 2 {
+		t.Fatalf("after SetFilterText(\"\") and two moves: Index %d, GlobalIndex %d, SelectedItem %v", m.Index(), m.GlobalIndex(), m.SelectedItem())
+	}
+}
+
+// bubbles/50: RemoveItem under a filter removes filteredItems[index] rather
+// than the match for the item, so the removed item stays visible and the
+// global indices of the matches after it are stale.
+func TestHegelPinListRemoveItemUnderAFilter(t *testing.T) {
+	m := pinList(6)
+	m.SetFilterText("05")
+	m.RemoveItem(5)
+	if len(m.Items()) != 5 || len(m.VisibleItems()) != 0 {
+		t.Fatalf("after RemoveItem(5) with the filter matching item 05: %d items, visible %v", len(m.Items()), m.VisibleItems())
+	}
+}
+
+// bubbles/51: RemoveItem with a negative index panics, though the doc says an
+// index out of bounds is a no-op.
+func TestHegelPinListRemoveItemNegativePanics(t *testing.T) {
+	m := pinList(3)
+	if panicked(func() { m.RemoveItem(-1) }) {
+		t.Fatalf("RemoveItem(-1) panicked")
+	}
+}
+
+// bubbles/52: the FilterMatchesMsg handler does not update the pagination,
+// so after SetItems under a filter the page count is stale: one page for
+// twelve matches, and the cursor cannot leave it.
+func TestHegelPinListSetItemsUnderAFilterStallsThePages(t *testing.T) {
+	m := pinList(3)
+	m.SetFilterText("item")
+	m = runCmd(m, m.SetItems(pinItems(12)))
+	for range 11 {
+		m.CursorDown()
+	}
+	if m.Paginator.TotalPages != 6 || m.Index() != 11 {
+		t.Fatalf("12 matches, PerPage %d: TotalPages %d, Index after eleven moves down %d", m.Paginator.PerPage, m.Paginator.TotalPages, m.Index())
+	}
+}
+
+// bubbles/56: the key bindings fall out of step with the items and pages:
+// RemoveItem and the section toggles update the pagination but not the
+// bindings, so after the last item is removed "/" still opens the filter;
+// cancelling a filter re-enables "/" on an empty list; accepting one refreshes
+// the bindings before the pagination.
+func TestHegelPinListRemoveItemKeepsTheBindings(t *testing.T) {
+	m := pinList(1)
+	m.RemoveItem(0)
+	m, _ = m.Update(typed('/'))
+	if m.FilterState() != Unfiltered {
+		t.Fatalf("\"/\" on an emptied list: FilterState %v", m.FilterState())
+	}
+}
+
+// bubbles/53: SetItems leaves the cursor where it was on the (clamped) page,
+// past the end of a shorter list, so SelectedItem is nil and no item is
+// marked until the next message clamps it.
+func TestHegelPinListSetItemsLeavesTheCursorPastTheEnd(t *testing.T) {
+	m := pinList(20)
+	m.Select(15)
+	m.SetItems(pinItems(1))
+	if m.SelectedItem() == nil || m.Index() != 0 {
+		t.Fatalf("after Select(15), SetItems(1): Index %d, SelectedItem %v", m.Index(), m.SelectedItem())
+	}
+}
+
+// bubbles/54: New does not size the help or the filter input (only SetSize
+// does), so the help line runs past the width and widens every line.
+func TestHegelPinListNewDoesNotSizeTheHelp(t *testing.T) {
+	m := New(pinItems(30), NewDefaultDelegate(), 20, 14)
+	if w := widest(m.View()); w > 20 {
+		t.Fatalf("a list of width 20 from New renders %d cells wide", w)
+	}
+}
+
+// bubbles/55: the chrome is not fitted to the width: the status bar is never
+// truncated, the help is truncated to the width before its two-cell padding
+// and the title bar to width−1 before its own, so the view is wider than the
+// width and every line is padded to it.
+func TestHegelPinListChromeOverflowsTheWidth(t *testing.T) {
+	m := pinList(30)
+	m.SetSize(20, 14)
+	if w := widest(m.View()); w > 20 {
+		t.Fatalf("a list of width 20 renders %d cells wide: %q", w, plainLine(strings.Split(m.View(), "\n")[13]))
+	}
+}
diff --git a/paginator/hegel_shapes_test.go b/paginator/hegel_shapes_test.go
new file mode 100644
index 0000000..189ecaf
--- /dev/null
+++ b/paginator/hegel_shapes_test.go
@@ -0,0 +1,67 @@
+package paginator
+
+// The shape regions of the recorded paginator bugs (bugs.toml bubbles/40, 41) and
+// the narrow properties over them: each region is a generator over the bug's shape
+// with random contents, judged exactly like the wide property (judgePaginator).
+// Every narrow property fails every run by default; under HEGEL_NO_KNOWN=1 its
+// generator is the region next to the shape instead (zootest.Shaped) and the
+// property passes. Both shapes are deterministic in the library (a page never
+// clamped, a count of zero returned early), so every instance reaches the bug
+// (measured: 1000 of 1000 with math/rand over the library).
+
+import (
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowPaginator runs a narrow property: every drawn case through the wide
+// property's judge.
+func narrowPaginator(t *testing.T, cases hegel.Generator[pageCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePaginator(j, c)
+	})
+}
+
+var forwardOps = hegel.Map(zootest.Sampled("next", "right", "l", "pgdown"), func(k string) pageOp { return pageOp{kind: k} })
+
+// --------------------------------------------------------------------------- bubbles/40
+
+// pageOutlivesTheTotal: a paginator moved forward to page n (n in 1..7, with items
+// enough for it) and then given a count of at most n times the page size, which
+// leaves page n past the end; up to six operations follow. Past the shape, a count
+// that keeps page n.
+var pageOutlivesTheTotal = hegel.Composite(func(tc hegel.TestCase) pageCase {
+	per := hegel.Draw(tc, pers)
+	n := hegel.Draw(tc, zootest.Ints(1, min(7, 39/per)))
+	items := hegel.Draw(tc, zootest.Ints(n*per+1, 40))
+	shrunk := itemsOp(zootest.Shaped(zootest.Ints(1, n*per), zootest.Ints(n*per+1, 40)), hegel.Just(false))
+	ops := hegel.Draw(tc, zootest.Seq(
+		zootest.Counted(forwardOps, n, n),
+		zootest.One(shrunk),
+		zootest.Counted(pageOps, 0, 6),
+	))
+	return pageCase{per: per, look: hegel.Draw(tc, looks), items: items, ops: ops}
+})
+
+func TestHegelPaginatorPageOutlivesTheTotal(t *testing.T) {
+	narrowPaginator(t, pageOutlivesTheTotal)
+}
+
+// --------------------------------------------------------------------------- bubbles/41
+
+// emptiedList: a paginator moved about and then given a count of zero; up to six
+// operations follow. Past the shape, a count of one to forty keeping the page.
+var emptiedList = casesOf(pers, itemCounts, zootest.Seq(
+	zootest.Counted(navOps, 0, 6),
+	zootest.One(zootest.Shaped(itemsOp(hegel.Just(0), hegel.Just(false)), itemsOp(itemCounts, hegel.Just(true)))),
+	zootest.Counted(pageOps, 0, 6),
+))
+
+func TestHegelPaginatorEmptiedListKeepsTheOldTotal(t *testing.T) {
+	narrowPaginator(t, emptiedList)
+}
diff --git a/paginator/hegel_test.go b/paginator/hegel_test.go
new file mode 100644
index 0000000..c561c4e
--- /dev/null
+++ b/paginator/hegel_test.go
@@ -0,0 +1,284 @@
+package paginator
+
+// Hegel properties for the paginator: a model of pages over a slice, driven
+// through the default key bindings and the helpers, checked against the
+// slice bounds, the first/last flags and the rendered view. A case is the
+// paginator's options, an item count and a list of operation records applied
+// in order; the shapes of the recorded bugs (an item count of zero,
+// bubbles/41; a count that leaves the page past the end, bubbles/40) are
+// drawn like any other case and fail naming them, and are not drawn under
+// HEGEL_NO_KNOWN=1 (no zero, every count keeping the page).
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+)
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+func pagesFor(items, per int) int {
+	n := items / per
+	if items%per > 0 {
+		n++
+	}
+	return n
+}
+
+// pageOp is one operation: the helpers (next, prev), the default key bindings
+// (right, left, l, h, pgdown, pgup), another key (other) or a new item count
+// (items; keep raises it to the count that keeps the current page, relative to
+// the live page like a position taken modulo the size).
+type pageOp struct {
+	kind  string
+	items int
+	keep  bool
+}
+
+func (o pageOp) GoString() string {
+	switch {
+	case o.kind != "items":
+		return o.kind
+	case o.keep:
+		return fmt.Sprintf("items(%d, keeping the page)", o.items)
+	}
+	return fmt.Sprintf("items(%d)", o.items)
+}
+
+// pageLook: the display options.
+type pageLook struct {
+	dots       bool
+	customDots bool
+	format     bool
+}
+
+// pageCase: the options, the item count and the operations.
+type pageCase struct {
+	per   int
+	look  pageLook
+	items int
+	ops   []pageOp
+}
+
+func (c pageCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	s := fmt.Sprintf("PerPage %d, %d items", c.per, c.items)
+	if c.look.dots {
+		s += ", Dots"
+	}
+	if c.look.customDots {
+		s += ", dots *-"
+	}
+	if c.look.format {
+		s += ", format 'page %d of %d'"
+	}
+	return s + ": " + strings.Join(ops, ", ")
+}
+
+func opOf(kind string) hegel.Generator[pageOp] { return hegel.Just(pageOp{kind: kind}) }
+
+// itemsOp: an items operation over the counts, keeping the page or not.
+func itemsOp(counts hegel.Generator[int], keep hegel.Generator[bool]) hegel.Generator[pageOp] {
+	return hegel.Composite(func(tc hegel.TestCase) pageOp {
+		return pageOp{kind: "items", items: hegel.Draw(tc, counts), keep: hegel.Draw(tc, keep)}
+	})
+}
+
+var (
+	pers       = zootest.Ints(1, 5)
+	itemCounts = zootest.Ints(1, 40)
+
+	looks = hegel.Composite(func(tc hegel.TestCase) pageLook {
+		return pageLook{
+			dots:       hegel.Draw(tc, zootest.Coin(50)),
+			customDots: hegel.Draw(tc, zootest.Coin(20)),
+			format:     hegel.Draw(tc, zootest.Coin(20)),
+		}
+	})
+
+	// navOps: the page moves and the other key, at the old property's weights.
+	navOps = hegel.Map(zootest.Sampled("next", "prev", "right", "left", "l", "h", "pgdown", "pgup", "other"), func(k string) pageOp { return pageOp{kind: k} })
+
+	// counts: a new item count, zero one time in five (first: the shape the wide
+	// property shrinks to, bubbles/41), never under HEGEL_NO_KNOWN=1.
+	counts = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just(0)),
+		zootest.W(8, itemCounts),
+	)
+	// keeps: whether the count keeps the current page (one time in five; a count
+	// below the page's first item leaves the page past the end, bubbles/40); always
+	// under HEGEL_NO_KNOWN=1.
+	keeps = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 4), hegel.Just(false)),
+		zootest.W(1, hegel.Just(true)),
+	)
+
+	// pageOps: the moves nine times in ten, a new count one time in ten.
+	pageOps = zootest.Weighted(
+		zootest.W(9, navOps),
+		zootest.W(1, itemsOp(counts, keeps)),
+	)
+
+	// pageCases: the options, one to forty items and one to thirty operations.
+	pageCases = casesOf(pers, itemCounts, zootest.Counted(pageOps, 1, 30))
+)
+
+// casesOf: a case from the page size, the item count and the operations.
+func casesOf(per, items hegel.Generator[int], ops hegel.Generator[[]pageOp]) hegel.Generator[pageCase] {
+	return hegel.Composite(func(tc hegel.TestCase) pageCase {
+		return pageCase{per: hegel.Draw(tc, per), look: hegel.Draw(tc, looks), items: hegel.Draw(tc, items), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+func keyFor(kind string) tea.KeyPressMsg {
+	switch kind {
+	case "right":
+		return keyOf(tea.KeyRight)
+	case "left":
+		return keyOf(tea.KeyLeft)
+	case "pgdown":
+		return keyOf(tea.KeyPgDown)
+	case "pgup":
+		return keyOf(tea.KeyPgUp)
+	case "l":
+		return typed('l')
+	case "h":
+		return typed('h')
+	}
+	return typed('x')
+}
+
+// judgePaginator drives the paginator through the case and checks Page, TotalPages,
+// the first/last flags, the slice bounds and the view against the model after every
+// operation: pages = ceil(items / PerPage) (none for no items: the library keeps
+// the old count, bubbles/41), Page moves by one within [0, pages-1] and is kept
+// within it when the count shrinks (the library leaves it past the end,
+// bubbles/40).
+func judgePaginator(j *zootest.Judge, c pageCase) {
+	per, items := c.per, c.items
+	p := New(WithPerPage(per))
+	if c.look.dots {
+		p.Type = Dots
+	}
+	if c.look.customDots {
+		p.ActiveDot, p.InactiveDot = "*", "-"
+	}
+	if c.look.format {
+		p.ArabicFormat = "page %d of %d"
+	}
+	if got := p.SetTotalPages(items); got != pagesFor(items, per) {
+		j.Fail("SetTotalPages(%d) with PerPage %d returned %d, want %d", items, per, got, pagesFor(items, per))
+	}
+	page, pages := 0, pagesFor(items, per)
+	var log []string
+	for _, op := range c.ops {
+		log = append(log, op.GoString())
+		switch op.kind {
+		case "next":
+			p.NextPage()
+			page = min(page+1, pages-1)
+		case "prev":
+			p.PrevPage()
+			page = max(page-1, 0)
+		case "right", "l", "pgdown":
+			p, _ = p.Update(keyFor(op.kind))
+			page = min(page+1, pages-1)
+		case "left", "h", "pgup":
+			p, _ = p.Update(keyFor(op.kind))
+			page = max(page-1, 0)
+		case "items":
+			items = op.items
+			if op.keep {
+				items = max(items, page*per+1)
+			}
+			log[len(log)-1] = fmt.Sprintf("items(%d)", items)
+			before := page
+			pages = pagesFor(items, per)
+			page = max(0, min(page, pages-1))
+			switch {
+			case items < 1:
+				// SetTotalPages(0) keeps the previous count.
+				j.Shape("bubbles/41")
+			case before > pages-1:
+				// the page is not clamped when the total shrinks.
+				j.Shape("bubbles/40")
+			}
+			if got := p.SetTotalPages(items); got != pages {
+				j.Fail("%s: SetTotalPages(%d) returned %d, want %d", strings.Join(log, ","), items, got, pages)
+			}
+		case "other":
+			p, _ = p.Update(keyFor(op.kind))
+		}
+		if p.Page != page || p.TotalPages != pages {
+			j.Fail("%s: Page %d of %d, want %d of %d", strings.Join(log, ","), p.Page, p.TotalPages, page, pages)
+		}
+		if p.OnFirstPage() != (page == 0) || p.OnLastPage() != (page == pages-1) {
+			j.Fail("%s: OnFirstPage %v OnLastPage %v at page %d of %d", strings.Join(log, ","), p.OnFirstPage(), p.OnLastPage(), page, pages)
+		}
+		start, end := p.GetSliceBounds(items)
+		if start != page*per || end != min(page*per+per, items) || p.ItemsOnPage(items) != end-start {
+			j.Fail("%s: bounds (%d,%d), ItemsOnPage %d for page %d of %d items, PerPage %d", strings.Join(log, ","), start, end, p.ItemsOnPage(items), page, items, per)
+		}
+		var want string
+		if p.Type == Dots {
+			want = strings.Repeat(p.InactiveDot, page) + p.ActiveDot + strings.Repeat(p.InactiveDot, max(0, pages-page-1))
+		} else {
+			want = fmt.Sprintf(p.ArabicFormat, page+1, pages)
+		}
+		if got := p.View(); got != want {
+			j.Fail("%s: View %q, want %q", strings.Join(log, ","), got, want)
+		}
+	}
+}
+
+// TestHegelPaginatorFollowsTheModel: pages = ceil(items / PerPage), Page
+// moves by one within [0, pages-1] on the default bindings and the
+// helpers, GetSliceBounds/ItemsOnPage describe Page's slice of the items,
+// and View shows Page under both display types.
+func TestHegelPaginatorFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pageCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePaginator(j, c)
+	})
+}
+
+// bubbles/40: SetTotalPages never clamps Page; once the page count shrinks
+// below it, OnLastPage is false and NextPage keeps counting up, and
+// GetSliceBounds returns a start past the end.
+func TestHegelPinPaginatorPageOutlivesTheTotal(t *testing.T) {
+	p := New(WithPerPage(3))
+	p.SetTotalPages(30)
+	for range 9 {
+		p.NextPage()
+	}
+	if p.Page != 9 || !p.OnLastPage() {
+		t.Fatalf("page %d of %d, OnLastPage %v", p.Page, p.TotalPages, p.OnLastPage())
+	}
+	p.SetTotalPages(6)
+	p.NextPage()
+	start, end := p.GetSliceBounds(6)
+	if p.Page > 1 || start > end {
+		t.Fatalf("after SetTotalPages(6): Page %d of %d, OnLastPage %v, bounds (%d,%d), ItemsOnPage %d, View %q", p.Page, p.TotalPages, p.OnLastPage(), start, end, p.ItemsOnPage(6), p.View())
+	}
+}
+
+// bubbles/41: SetTotalPages(0) leaves the previous count in place, so an
+// emptied list still shows its old pages.
+func TestHegelPinPaginatorZeroItemsKeepTheOldTotal(t *testing.T) {
+	p := New(WithPerPage(3))
+	p.SetTotalPages(30)
+	p.SetTotalPages(0)
+	if p.TotalPages != 0 {
+		t.Fatalf("after SetTotalPages(0): TotalPages %d, View %q", p.TotalPages, p.View())
+	}
+}
diff --git a/progress/hegel_shapes_test.go b/progress/hegel_shapes_test.go
new file mode 100644
index 0000000..f2785f2
--- /dev/null
+++ b/progress/hegel_shapes_test.go
@@ -0,0 +1,207 @@
+package progress
+
+// The shape regions of the recorded progress bugs (bugs.toml bubbles/59 to 63) and
+// the narrow properties over them: each region is a generator over the bug's shape
+// with random contents, judged exactly like the wide properties (judgeBar,
+// judgeSettle). Every narrow property fails every run by default; under
+// HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (zootest.Shaped) and the property passes. The option shapes (bubbles/60 to 63)
+// are deterministic in the library, so every instance reaches the bug; the
+// animation's (bubbles/59) is a relation between the spring and the motion, so
+// its region is kept to the instances that reach it by the library's own
+// predicate (stopsEarly: measured standalone with math/rand, a spring of damping
+// 0.1 to 0.5 settled at 0.3 to 1 and moved down by 0.3 to 1 stops early 973 of
+// 1000 times, and one of damping 1 to 2 never does, 0 of 538).
+
+import (
+	"math"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowBar and narrowSettle run a narrow property: every drawn case through the
+// wide property's judge.
+func narrowBar(t *testing.T, cases hegel.Generator[barCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeBar(j, c)
+	})
+}
+
+func narrowSettle(t *testing.T, cases hegel.Generator[settleCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSettle(j, c)
+	})
+}
+
+var (
+	// wideBarWidths: widths at which the bar has cells to draw whatever the text
+	// (at most 9 cells with narrowFormats: the empty format, left out, prints
+	// "%!(EXTRA float64=89.60000000000001)"); wideSetWidths the same after New, half
+	// the time.
+	wideBarWidths = zootest.Ints(30, 60)
+	wideSetWidths = zootest.Maybe(50, hegel.Map(wideBarWidths, func(w int) widthOpt { return widthOpt{set: true, w: w} }))
+	narrowFormats = zootest.Maybe(20, hegel.Map(zootest.Sampled(" %.1f%%", "%3.0f", " [%5.1f%%]"), func(s string) formatOpt { return formatOpt{set: true, s: s} }))
+
+	// plainOps: the options that touch neither the colours nor the fill runes.
+	plainOps = zootest.Weighted(
+		zootest.W(1, hegel.Map(zootest.Coin(70), func(v bool) barOp { return barOp{kind: "scaled", scaled: v} })),
+		zootest.W(1, opOf("nopct")),
+		zootest.W(1, hegel.Map(wideBarWidths, func(w int) barOp { return barOp{kind: "width", width: w} })),
+	)
+	// plainOrCharsOps: those and narrow fill runes.
+	plainOrCharsOps = zootest.Weighted(
+		zootest.W(3, plainOps),
+		zootest.W(1, charsOp(narrowFulls, narrowEmpties)),
+	)
+
+	finiteSetters = settersOf(finiteValues)
+
+	// overdamped: a damping of 1 to 2.
+	overdamped = hegel.Map(zootest.Ints(10, 20), func(n int) float64 { return float64(n) / 10 })
+)
+
+// --------------------------------------------------------------------------- bubbles/59
+
+// stopsOnTheWayDown: a spring of damping 0.1 to 0.5 (past the shape, 1 to 2), after
+// up to one setter, settled at 0.3 to 1 and then moved down by 0.3 to 1: the
+// animation stops the first time it is near the target, with the velocity it had.
+// The region is kept to the instances that stop early (past the shape, to those
+// that do not).
+var stopsOnTheWayDown = hegel.Filter(
+	settleCasesOf(
+		hegel.Map(zootest.Shaped(zootest.Ints(1, 5), zootest.Ints(10, 20)), func(n int) float64 { return float64(n) / 10 }),
+		zootest.Seq(
+			zootest.Counted(finiteSetters, 0, 1),
+			zootest.One(hegel.Map(zootest.Ints(300, 1000), func(n int) setter { return setter{kind: "set", v: float64(n) / 1000, frames: 30000} })),
+			zootest.One(hegel.Map(zootest.Ints(300, 1000), func(n int) setter { return setter{kind: "decr", v: float64(n) / 1000} })),
+		),
+	),
+	zootest.Shaped(stopsEarly, func(c settleCase) bool { return !stopsEarly(c) }),
+)
+
+func TestHegelProgressStopsOnTheWayDown(t *testing.T) {
+	narrowSettle(t, stopsOnTheWayDown)
+}
+
+// --------------------------------------------------------------------------- bubbles/60
+
+// colorFuncThenBlend: a colour function and, after up to two plain options, a blend
+// (two or three colours, or the default blend; past the shape, none or one colour,
+// which clears the function), with the bar wide enough to draw the fill at a
+// percentage of 0.5 to 1.
+var colorFuncThenBlend = barCasesOf(
+	zootest.Seq(
+		zootest.Counted(plainOrCharsOps, 0, 2),
+		zootest.One(opOf("colorfunc")),
+		zootest.Counted(plainOrCharsOps, 0, 2),
+		zootest.One(zootest.Shaped(
+			zootest.Weighted(zootest.W(1, colorsOp(2)), zootest.W(1, colorsOp(3)), zootest.W(1, opOf("defaultblend"))),
+			zootest.Weighted(zootest.W(1, opOf("colors0")), zootest.W(1, colorsOp(1))),
+		)),
+		zootest.Counted(plainOrCharsOps, 0, 2),
+	),
+	hegel.Map(zootest.Ints(500, 1000), func(n int) float64 { return float64(n) / 1000 }),
+	wideSetWidths,
+	narrowFormats,
+)
+
+func TestHegelProgressColorFuncSurvivesALaterBlend(t *testing.T) {
+	narrowBar(t, colorFuncThenBlend)
+}
+
+// --------------------------------------------------------------------------- bubbles/61
+
+// wideFill is the fill runes and a percentage at which a two-cell rune is drawn:
+// both runes two cells wide at any percentage, or the full rune at 0.6 to 1.2 or
+// the empty rune at -0.2 to 0.4 (past the shape, one-cell runes at any
+// percentage).
+type wideFill struct {
+	full, empty rune
+	p           float64
+}
+
+func fillOf(fulls, empties hegel.Generator[rune], p hegel.Generator[float64]) hegel.Generator[wideFill] {
+	return hegel.Composite(func(tc hegel.TestCase) wideFill {
+		return wideFill{full: hegel.Draw(tc, fulls), empty: hegel.Draw(tc, empties), p: hegel.Draw(tc, p)}
+	})
+}
+
+var (
+	thousandths = func(lo, hi int) hegel.Generator[float64] {
+		return hegel.Map(zootest.Ints(lo, hi), func(n int) float64 { return float64(n) / 1000 })
+	}
+	wideFills = zootest.Shaped(
+		zootest.Weighted(
+			zootest.W(2, fillOf(hegel.Just('\u5168'), hegel.Just('\u3000'), pcts)),
+			zootest.W(1, fillOf(hegel.Just('\u5168'), narrowEmpties, thousandths(600, 1200))),
+			zootest.W(1, fillOf(narrowFulls, hegel.Just('\u3000'), thousandths(-200, 400))),
+		),
+		fillOf(narrowFulls, narrowEmpties, pcts),
+	)
+
+	// wideRunes: the fill runes among up to four plain options, the bar wide enough
+	// to draw both parts.
+	wideRunes = hegel.FlatMap(wideFills, func(f wideFill) hegel.Generator[barCase] {
+		return barCasesOf(
+			zootest.Seq(
+				zootest.Counted(plainOps, 0, 2),
+				zootest.One(hegel.Just(barOp{kind: "chars", full: f.full, empty: f.empty})),
+				zootest.Counted(plainOps, 0, 2),
+			),
+			hegel.Just(f.p),
+			wideSetWidths,
+			narrowFormats,
+		)
+	})
+)
+
+func TestHegelProgressWideFillRunesWidenTheBar(t *testing.T) {
+	narrowBar(t, wideRunes)
+}
+
+// --------------------------------------------------------------------------- bubbles/62
+
+// colorFuncPastOne: a colour function among up to four plain options and a
+// percentage past 1 (1.25, or 1.001 to 1.5; past the shape, 0 to 1), the bar wide
+// enough to draw the fill: the function is told the percentage unclamped.
+var colorFuncPastOne = barCasesOf(
+	zootest.Seq(
+		zootest.Counted(plainOrCharsOps, 0, 2),
+		zootest.One(opOf("colorfunc")),
+		zootest.Counted(plainOrCharsOps, 0, 2),
+	),
+	zootest.Shaped(
+		zootest.Weighted(zootest.W(1, hegel.Just(1.25)), zootest.W(1, thousandths(1001, 1500))),
+		thousandths(0, 1000),
+	),
+	wideSetWidths,
+	narrowFormats,
+)
+
+func TestHegelProgressColorFuncToldThePercentagePastOne(t *testing.T) {
+	narrowBar(t, colorFuncPastOne)
+}
+
+// --------------------------------------------------------------------------- bubbles/63
+
+// nanSetter: a setter of NaN (past the shape, of a finite value) among up to three
+// finite ones; past the shape the spring is overdamped (damping 1 to 2) and the
+// animations that still stop early (bubbles/59) are filtered out as in the wide
+// property.
+var nanSetter = zootest.Only(zootest.NoKnown, "stops early", settleCasesOf(zootest.Shaped(dampings, overdamped), zootest.Seq(
+	zootest.Counted(finiteSetters, 0, 2),
+	zootest.One(settersOf(zootest.Shaped(hegel.Just(math.NaN()), finiteValues))),
+	zootest.Counted(finiteSetters, 0, 1),
+)), func(c settleCase) bool { return !stopsEarly(c) })
+
+func TestHegelProgressNaNPercentNeverSettles(t *testing.T) {
+	narrowSettle(t, nanSetter)
+}
diff --git a/progress/hegel_test.go b/progress/hegel_test.go
new file mode 100644
index 0000000..623c20b
--- /dev/null
+++ b/progress/hegel_test.go
@@ -0,0 +1,791 @@
+package progress
+
+// Hegel properties for the progress bar: ViewAs checked cell by cell (text
+// and colours) against a model of the options, and the spring animation
+// driven frame by frame to equilibrium. A case is a list of option records
+// (and the setters after New) and the percentage; the shapes of the recorded
+// bugs are drawn like any other case and fail naming them (barShape; the
+// settled velocity and a NaN setter in the animation), and are not drawn
+// under HEGEL_NO_KNOWN=1 (narrow fill runes, no blend after a live colour
+// function, no percentage past 1 with one, no NaN, no animation that stops
+// on the way down).
+
+import (
+	"fmt"
+	"image/color"
+	"math"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var palette = []color.Color{
+	lipgloss.Color("#FF0000"), lipgloss.Color("#00FF00"), lipgloss.Color("#0000FF"),
+	lipgloss.Color("#5A56E0"), lipgloss.Color("#EE6FF8"), lipgloss.Color("#000000"),
+	lipgloss.Color("#FFFFFF"), lipgloss.Color("#123456"), lipgloss.Color("#7571F9"),
+}
+
+func rgb(c color.Color) string {
+	if c == nil {
+		return ""
+	}
+	r, g, b, _ := c.RGBA()
+	return fmt.Sprintf("%d;%d;%d", r>>8, g>>8, b>>8)
+}
+
+// rgbShift encodes a colour the way x/ansi does (lipgloss/28): a 16-bit
+// channel of 0xff or below is emitted as is instead of divided by 256, so
+// a blend step next to black renders a spike in that channel.
+func rgbShift(c color.Color) string {
+	if c == nil {
+		return ""
+	}
+	sh := func(v uint32) uint32 {
+		if v > 0xff {
+			return v >> 8
+		}
+		return v
+	}
+	r, g, b, _ := c.RGBA()
+	return fmt.Sprintf("%d;%d;%d", sh(r), sh(g), sh(b))
+}
+
+// zcell is one rune of a rendered bar with its foreground and background
+// (true-colour SGR triples, "" when unset).
+type zcell struct{ s, fg, bg string }
+
+func sgrCells(s string) []zcell {
+	var out []zcell
+	fg, bg := "", ""
+	for i := 0; i < len(s); {
+		if s[i] == 0x1b && i+1 < len(s) && s[i+1] == '[' {
+			j := i + 2
+			for j < len(s) && !(s[j] >= 0x40 && s[j] <= 0x7e) {
+				j++
+			}
+			if j < len(s) && s[j] == 'm' {
+				params := s[i+2 : j]
+				if params == "" {
+					fg, bg = "", ""
+				}
+				ps := strings.Split(params, ";")
+				for k := 0; k < len(ps); k++ {
+					switch ps[k] {
+					case "0":
+						fg, bg = "", ""
+					case "39":
+						fg = ""
+					case "49":
+						bg = ""
+					case "38", "48":
+						if k+4 < len(ps) && ps[k+1] == "2" {
+							v := strings.Join(ps[k+2:k+5], ";")
+							if ps[k] == "38" {
+								fg = v
+							} else {
+								bg = v
+							}
+							k += 4
+						}
+					}
+				}
+			}
+			i = j + 1
+			continue
+		}
+		r, n := utf8.DecodeRuneInString(s[i:])
+		out = append(out, zcell{string(r), fg, bg})
+		i += n
+	}
+	return out
+}
+
+func clamp01(p float64) float64 { return math.Max(0, math.Min(1, p)) }
+
+// barModel is the documented state of a bar: what the options say the
+// colours, characters and text should be.
+type barModel struct {
+	width     int
+	full      rune
+	empty     rune
+	fullColor color.Color
+	emptyCol  color.Color
+	showPct   bool
+	format    string
+	blend     []color.Color
+	fn        func(cur float64) color.Color
+	scaled    bool
+}
+
+// fill is the bar's geometry at the percentage: the bar's width (the width less
+// the text), the filled width and the text's width.
+func (b barModel) fill(p float64) (tw, fw, textW int) {
+	text := ""
+	if b.showPct {
+		text = fmt.Sprintf(b.format, clamp01(p)*100)
+	}
+	textW = ansi.StringWidth(text)
+	tw = max(0, b.width-textW)
+	fw = int(math.Round(float64(tw) * clamp01(p)))
+	fw = max(0, min(tw, fw))
+	return tw, fw, textW
+}
+
+func (b barModel) view(p float64, rgb func(color.Color) string) (cells []zcell, textW int) {
+	text := ""
+	if b.showPct {
+		text = fmt.Sprintf(b.format, clamp01(p)*100)
+	}
+	tw, fw, textW := b.fill(p)
+	half := b.full == DefaultFullCharHalfBlock
+	var blend []color.Color
+	if b.fn == nil && len(b.blend) > 0 {
+		n := tw
+		if b.scaled {
+			n = fw
+		}
+		if half {
+			n *= 2
+		}
+		blend = lipgloss.Blend1D(n, b.blend...)
+	}
+	for i := 0; i < fw; i++ {
+		c := zcell{s: string(b.full)}
+		switch {
+		case b.fn != nil:
+			c.fg = rgb(b.fn(float64(i) / float64(tw)))
+			if half {
+				c.bg = rgb(b.fn(min(float64(i)/float64(tw)+0.5/float64(tw), 1)))
+			}
+		case len(b.blend) > 0:
+			if half {
+				c.fg, c.bg = rgb(blend[2*i]), rgb(blend[2*i+1])
+			} else {
+				c.fg = rgb(blend[i])
+			}
+		default:
+			c.fg = rgb(b.fullColor)
+		}
+		cells = append(cells, c)
+	}
+	for i := fw; i < tw; i++ {
+		cells = append(cells, zcell{s: string(b.empty), fg: rgb(b.emptyCol)})
+	}
+	for _, r := range text {
+		cells = append(cells, zcell{s: string(r)})
+	}
+	return cells, textW
+}
+
+func runeWidth(r rune) int { return uniseg.StringWidth(string(r)) }
+
+func fmtCells(cs []zcell) string {
+	var sb strings.Builder
+	for _, c := range cs {
+		fmt.Fprintf(&sb, "%s(%s/%s) ", c.s, c.fg, c.bg)
+	}
+	return sb.String()
+}
+
+func rgbs(cs []color.Color) string {
+	var out []string
+	for _, c := range cs {
+		out = append(out, rgb(c))
+	}
+	return strings.Join(out, ",")
+}
+
+// fnColor is the colour function's colour: a palette entry by the cell's position.
+func fnColor(cur float64) color.Color { return palette[int(cur*float64(len(palette)))%len(palette)] }
+
+// barOp is one option of New: WithColors with none, one, two or three colours,
+// WithDefaultBlend, WithColorFunc, WithScaled, WithFillCharacters, WithoutPercentage
+// or WithWidth.
+type barOp struct {
+	kind   string
+	colors []color.Color // colors1, colors2, colors3
+	scaled bool          // scaled
+	full   rune          // chars
+	empty  rune          // chars
+	width  int           // width
+}
+
+func (o barOp) GoString() string {
+	switch o.kind {
+	case "colors1", "colors2", "colors3":
+		return fmt.Sprintf("%s(%s)", o.kind, rgbs(o.colors))
+	case "scaled":
+		return fmt.Sprintf("scaled(%v)", o.scaled)
+	case "chars":
+		return fmt.Sprintf("chars(%c,%c)", o.full, o.empty)
+	case "width":
+		return fmt.Sprintf("width(%d)", o.width)
+	}
+	return o.kind
+}
+
+// widthOpt is a SetWidth after New (set), or none; formatOpt a PercentFormat (set),
+// or New()'s.
+type widthOpt struct {
+	set bool
+	w   int
+}
+
+type formatOpt struct {
+	set bool
+	s   string
+}
+
+// barCase: the options, the width and format set after New, the empty colour (nil
+// for New()'s) and the percentage drawn.
+type barCase struct {
+	ops      []barOp
+	setWidth widthOpt
+	format   formatOpt
+	emptyCol color.Color
+	p        float64
+}
+
+func (c barCase) GoString() string {
+	var parts []string
+	for _, o := range c.ops {
+		parts = append(parts, o.GoString())
+	}
+	if c.setWidth.set {
+		parts = append(parts, fmt.Sprintf("SetWidth(%d)", c.setWidth.w))
+	}
+	if c.format.set {
+		parts = append(parts, fmt.Sprintf("PercentFormat(%q)", c.format.s))
+	}
+	if c.emptyCol != nil {
+		parts = append(parts, "EmptyColor("+rgb(c.emptyCol)+")")
+	}
+	return fmt.Sprintf("%s ViewAs(%v)", strings.Join(parts, " "), c.p)
+}
+
+// model is what the options say the bar is.
+func (c barCase) model() barModel {
+	model := barModel{width: defaultWidth, full: DefaultFullCharHalfBlock, empty: DefaultEmptyCharBlock,
+		fullColor: defaultFullColor, emptyCol: defaultEmptyColor, showPct: true, format: " %3.0f%%"}
+	for _, op := range c.ops {
+		switch op.kind {
+		case "colors0":
+			model.fullColor, model.blend, model.fn = defaultFullColor, nil, nil
+		case "colors1":
+			model.fullColor, model.blend, model.fn = op.colors[0], nil, nil
+		case "colors2", "colors3":
+			model.blend, model.fn = op.colors, nil
+		case "defaultblend":
+			model.blend, model.fn = []color.Color{defaultBlendStart, defaultBlendEnd}, nil
+		case "colorfunc":
+			model.fn, model.blend = fnColor, nil
+		case "scaled":
+			model.scaled = op.scaled
+		case "chars":
+			model.full, model.empty = op.full, op.empty
+		case "nopct":
+			model.showPct = false
+		case "width":
+			model.width = op.width
+		}
+	}
+	if c.setWidth.set {
+		model.width = c.setWidth.w
+	}
+	if c.format.set {
+		model.format = c.format.s
+	}
+	if c.emptyCol != nil {
+		model.emptyCol = c.emptyCol
+	}
+	return model
+}
+
+// options is the library's options; the colour function records the totals it is
+// told.
+func (c barCase) options(totals *[]float64) []Option {
+	var opts []Option
+	for _, op := range c.ops {
+		switch op.kind {
+		case "colors0":
+			opts = append(opts, WithColors())
+		case "colors1", "colors2", "colors3":
+			opts = append(opts, WithColors(op.colors...))
+		case "defaultblend":
+			opts = append(opts, WithDefaultBlend())
+		case "colorfunc":
+			opts = append(opts, WithColorFunc(func(total, cur float64) color.Color {
+				*totals = append(*totals, total)
+				return fnColor(cur)
+			}))
+		case "scaled":
+			opts = append(opts, WithScaled(op.scaled))
+		case "chars":
+			opts = append(opts, WithFillCharacters(op.full, op.empty))
+		case "nopct":
+			opts = append(opts, WithoutPercentage())
+		case "width":
+			opts = append(opts, WithWidth(op.width))
+		}
+	}
+	return opts
+}
+
+// keepsColorFunc reports that a colour function is set and a blend set after it
+// (WithColors with two or more colours, WithDefaultBlend) did not clear it: the
+// options as the library composes them (bubbles/60).
+func keepsColorFunc(ops []barOp) bool {
+	fn, blendAfter := false, false
+	for _, op := range ops {
+		switch op.kind {
+		case "colorfunc":
+			fn, blendAfter = true, false
+		case "colors0", "colors1":
+			fn, blendAfter = false, false
+		case "colors2", "colors3", "defaultblend":
+			blendAfter = true
+		}
+	}
+	return fn && blendAfter
+}
+
+// barShape names the recorded bug whose shape the case has: a colour function kept
+// through a later blend and drawing the fill (bubbles/60); a colour function told a
+// percentage past 1 (bubbles/62); a fill rune not one cell wide where the rendered
+// width differs from the width (bubbles/61).
+func barShape(c barCase) string {
+	model := c.model()
+	tw, fw, textW := model.fill(c.p)
+	wide := runeWidth(model.full) != 1 || runeWidth(model.empty) != 1
+	cellsW := fw*runeWidth(model.full) + (tw-fw)*runeWidth(model.empty) + textW
+	switch {
+	case keepsColorFunc(c.ops) && model.fn == nil && fw > 0:
+		return "bubbles/60"
+	case model.fn != nil && c.p > 1 && fw > 0:
+		return "bubbles/62"
+	case wide && cellsW != max(model.width, textW):
+		return "bubbles/61"
+	}
+	return ""
+}
+
+func opOf(kind string) hegel.Generator[barOp] { return hegel.Just(barOp{kind: kind}) }
+
+// colorsOp: WithColors with n colours from the palette.
+func colorsOp(n int) hegel.Generator[barOp] {
+	return hegel.Map(zootest.Counted(colors, n, n), func(cs []color.Color) barOp {
+		return barOp{kind: fmt.Sprintf("colors%d", n), colors: cs}
+	})
+}
+
+// charsOp: WithFillCharacters from the rune generators.
+func charsOp(fulls, empties hegel.Generator[rune]) hegel.Generator[barOp] {
+	return hegel.Composite(func(tc hegel.TestCase) barOp {
+		return barOp{kind: "chars", full: hegel.Draw(tc, fulls), empty: hegel.Draw(tc, empties)}
+	})
+}
+
+// barOpsOf: the options at the old property's weights, the fill runes and widths
+// from the generators given; the colour function first and at weight two (with a
+// percentage past 1 it is the shape the wide property shrinks to, bubbles/62).
+func barOpsOf(fulls, empties hegel.Generator[rune], widths hegel.Generator[int]) hegel.Generator[barOp] {
+	return zootest.Weighted(
+		zootest.W(2, opOf("colorfunc")),
+		zootest.W(1, opOf("colors0")),
+		zootest.W(1, colorsOp(1)),
+		zootest.W(1, colorsOp(2)),
+		zootest.W(1, colorsOp(3)),
+		zootest.W(1, opOf("defaultblend")),
+		zootest.W(1, hegel.Map(zootest.Coin(70), func(v bool) barOp { return barOp{kind: "scaled", scaled: v} })),
+		zootest.W(1, charsOp(fulls, empties)),
+		zootest.W(1, opOf("nopct")),
+		zootest.W(1, hegel.Map(widths, func(w int) barOp { return barOp{kind: "width", width: w} })),
+	)
+}
+
+var (
+	colors = zootest.Sampled(palette...)
+
+	// narrowFulls, narrowEmpties: the one-cell fill runes; fullRunes, emptyRunes: the
+	// two-cell rune first, one time in five (bubbles/61), never under
+	// HEGEL_NO_KNOWN=1.
+	narrowFulls   = zootest.Sampled(DefaultFullCharHalfBlock, DefaultFullCharFullBlock, '#', '=')
+	narrowEmpties = zootest.Sampled(DefaultEmptyCharBlock, ' ', '-', '.')
+	fullRunes     = zootest.Weighted(zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just('\u5168')), zootest.W(8, narrowFulls))
+	emptyRunes    = zootest.Weighted(zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just('\u3000')), zootest.W(8, narrowEmpties))
+
+	barWidths = zootest.Ints(0, 60)
+	barOps    = barOpsOf(fullRunes, emptyRunes, barWidths)
+
+	// pcts: a percentage from the table, or one in thousandths from -0.1 to 1.1.
+	pcts = zootest.Weighted(
+		zootest.W(1, zootest.Sampled(0, 1, 0.5, -0.25, 1.25, 0.001, 0.999, 0.3333, 0.05, 0.95, 0.125)),
+		zootest.W(1, hegel.Map(zootest.Ints(-100, 1100), func(n int) float64 { return float64(n) / 1000 })),
+	)
+
+	setWidths = zootest.Maybe(50, hegel.Map(barWidths, func(w int) widthOpt { return widthOpt{set: true, w: w} }))
+	formats   = zootest.Maybe(20, hegel.Map(zootest.Sampled(" %.1f%%", "%3.0f", " [%5.1f%%]", ""), func(s string) formatOpt { return formatOpt{set: true, s: s} }))
+	emptyCols = zootest.Maybe(20, colors)
+
+	// barCases: none to five options, the width and format after New, the empty
+	// colour and the percentage; under HEGEL_NO_KNOWN=1 only the cases without a
+	// shape (a colour function kept or told a percentage past 1 is a relation
+	// between the options and the percentage, filtered out).
+	barCases = zootest.Only(zootest.NoKnown, "bar shapes", barCasesOf(zootest.Counted(barOps, 0, 5), pcts, setWidths, formats), func(c barCase) bool { return barShape(c) == "" })
+)
+
+// barCasesOf: a case from the options, the percentage, the width and the format
+// after New.
+func barCasesOf(ops hegel.Generator[[]barOp], p hegel.Generator[float64], setWidth hegel.Generator[widthOpt], format hegel.Generator[formatOpt]) hegel.Generator[barCase] {
+	return hegel.Composite(func(tc hegel.TestCase) barCase {
+		return barCase{
+			ops:      hegel.Draw(tc, ops),
+			setWidth: hegel.Draw(tc, setWidth),
+			format:   hegel.Draw(tc, format),
+			emptyCol: hegel.Draw(tc, emptyCols),
+			p:        hegel.Draw(tc, p),
+		}
+	})
+}
+
+// judgeBar builds the bar from the case and checks Width, the totals the colour
+// function is told and ViewAs cell by cell and in width against the model.
+func judgeBar(j *zootest.Judge, c barCase) {
+	j.Shape(barShape(c))
+	model := c.model()
+	var totals []float64
+	m := New(c.options(&totals)...)
+	if c.setWidth.set {
+		m.SetWidth(c.setWidth.w)
+	}
+	if c.format.set {
+		m.PercentFormat = c.format.s
+	}
+	if c.emptyCol != nil {
+		m.EmptyColor = c.emptyCol
+	}
+	if m.Width() != model.width {
+		j.Fail("Width() %d, want %d", m.Width(), model.width)
+	}
+	p := c.p
+	totals = nil
+	got := m.ViewAs(p)
+	if model.fn != nil && p != clamp01(p) {
+		for _, tot := range totals {
+			if tot != clamp01(p) {
+				j.Fail("ViewAs(%v) told the colour function total %v, want %v", p, tot, clamp01(p))
+			}
+		}
+	}
+	want, textW := model.view(p, rgb)
+	cells := sgrCells(got)
+	if len(cells) != len(want) {
+		j.Fail("ViewAs(%v) has %d runes, want %d\n got  %s\n want %s", p, len(cells), len(want), fmtCells(cells), fmtCells(want))
+	}
+	for i := range cells {
+		if cells[i] != want[i] {
+			if alt, _ := model.view(p, rgbShift); cells[i] == alt[i] {
+				// lipgloss/28 (x/ansi's shift): a blend step with a
+				// 16-bit channel below 256 is emitted unshifted.
+				zootest.Count("lipgloss/28")
+				return
+			}
+			j.Fail("ViewAs(%v) rune %d is %v, want %v\n got  %s\n want %s", p, i, cells[i], want[i], fmtCells(cells), fmtCells(want))
+		}
+	}
+	if w := ansi.StringWidth(got); w != max(model.width, textW) {
+		j.Fail("ViewAs(%v) is %d wide, want %d (text %d)", p, w, max(model.width, textW), textW)
+	}
+	if model.width < textW && model.showPct {
+		zootest.Count("text wider than the bar")
+	}
+}
+
+// TestHegelProgressDrawsTheModel: ViewAs is round(tw·p) full runes, tw−fw
+// empty runes and the percentage text, tw = Width − text width; the full
+// runes carry the solid colour, the blend (over the bar or, scaled, over the
+// filled part; two stops per half block) or the colour function's colours at
+// i/tw (and i/tw + 1/2tw for the half block's background), the empty runes
+// the empty colour; the options compose as documented in whatever order.
+func TestHegelProgressDrawsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, barCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeBar(j, c)
+	})
+}
+
+// settle runs the animation to equilibrium (or the frame cap), returning the
+// frames it took.
+func settle(m *Model, cap int) int {
+	frames := 0
+	for frames < cap && m.IsAnimating() {
+		*m, _ = m.Update(FrameMsg{id: m.id, tag: m.tag})
+		frames++
+	}
+	return frames
+}
+
+// setter is one SetPercent/IncrPercent/DecrPercent with its value and the frames
+// of animation run after it (none for 0).
+type setter struct {
+	kind   string
+	v      float64
+	frames int
+}
+
+func (s setter) GoString() string {
+	if s.frames > 0 {
+		return fmt.Sprintf("%s(%v)+%d frames", s.kind, s.v, s.frames)
+	}
+	return fmt.Sprintf("%s(%v)", s.kind, s.v)
+}
+
+// settleCase: the spring, the width and the setters.
+type settleCase struct {
+	freq, damping float64
+	width         int
+	ops           []setter
+}
+
+func (c settleCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("spring(%v,%v) width %d: %s", c.freq, c.damping, c.width, strings.Join(ops, ", "))
+}
+
+// target is the percentage a setter's value sets: clamped to [0, 1]; a NaN is taken
+// as 0 (the library passes it through, bubbles/63: a model decision, since the
+// library documents no value for it).
+func target(p float64) float64 {
+	if math.IsNaN(p) {
+		return 0
+	}
+	return clamp01(p)
+}
+
+// stopsEarly replays the case through the library and reports that the animation
+// stopped with a velocity of 0.01 or more (bubbles/59's shape: it stops on the way
+// down the moment it is near the target).
+func stopsEarly(c settleCase) bool {
+	m := New(WithSpringOptions(c.freq, c.damping), WithWidth(c.width))
+	for _, op := range c.ops {
+		switch op.kind {
+		case "set":
+			m.SetPercent(op.v)
+		case "incr":
+			m.IncrPercent(op.v)
+		case "decr":
+			m.DecrPercent(op.v)
+		}
+		settle(&m, op.frames)
+	}
+	settle(&m, 30000)
+	return !m.IsAnimating() && math.Abs(m.velocity) >= 0.01
+}
+
+func settersOf(values hegel.Generator[float64]) hegel.Generator[setter] {
+	return hegel.Composite(func(tc hegel.TestCase) setter {
+		return setter{
+			kind:   hegel.Draw(tc, zootest.Sampled("set", "incr", "decr")),
+			v:      hegel.Draw(tc, values),
+			frames: hegel.Draw(tc, zootest.Maybe(50, zootest.Ints(1, 20))),
+		}
+	})
+}
+
+var (
+	freqs    = hegel.Map(zootest.Ints(1, 60), func(n int) float64 { return float64(n) })
+	dampings = hegel.Map(zootest.Ints(1, 20), func(n int) float64 { return float64(n) / 10 })
+
+	// finiteValues: a value in thousandths from -0.5 to 1.5; values: NaN one time in
+	// ten (first: the shape the wide property shrinks to, bubbles/63; never under
+	// HEGEL_NO_KNOWN=1), else a finite value.
+	finiteValues = hegel.Map(zootest.Ints(-500, 1500), func(n int) float64 { return float64(n) / 1000 })
+	values       = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), hegel.Just(math.NaN())),
+		zootest.W(18, finiteValues),
+	)
+
+	// settleCases: a spring, a width and one to three setters; under
+	// HEGEL_NO_KNOWN=1 only the animations that do not stop on the way down (a
+	// relation between the spring and the setters, filtered out by replaying the
+	// library).
+	settleCases = zootest.Only(zootest.NoKnown, "stops early", settleCasesOf(dampings, zootest.Counted(settersOf(values), 1, 3)), func(c settleCase) bool { return !stopsEarly(c) })
+)
+
+// settleCasesOf: a case from the damping and the setters.
+func settleCasesOf(dampings hegel.Generator[float64], ops hegel.Generator[[]setter]) hegel.Generator[settleCase] {
+	return hegel.Composite(func(tc hegel.TestCase) settleCase {
+		return settleCase{
+			freq:    hegel.Draw(tc, freqs),
+			damping: hegel.Draw(tc, dampings),
+			width:   hegel.Draw(tc, zootest.Ints(0, 40)),
+			ops:     hegel.Draw(tc, ops),
+		}
+	})
+}
+
+// judgeSettle applies the setters, checking the command, the target and that stale
+// and foreign frames are ignored, then runs the animation to equilibrium and checks
+// it settled at the target with a settled velocity and stays there.
+func judgeSettle(j *zootest.Judge, c settleCase) {
+	freq, damping := c.freq, c.damping
+	m := New(WithSpringOptions(freq, damping), WithWidth(c.width))
+	tgt := 0.0
+	var log []string
+	for _, op := range c.ops {
+		v := op.v
+		if math.IsNaN(v) {
+			// SetPercent clamps with math.Max/math.Min, which pass NaN through.
+			j.Shape("bubbles/63")
+		}
+		var cmd tea.Cmd
+		switch op.kind {
+		case "set":
+			cmd = m.SetPercent(v)
+			tgt = target(v)
+		case "incr":
+			cmd = m.IncrPercent(v)
+			tgt = target(tgt + v)
+		case "decr":
+			cmd = m.DecrPercent(v)
+			tgt = target(tgt - v)
+		}
+		log = append(log, fmt.Sprintf("%v", v))
+		if cmd == nil {
+			j.Fail("spring(%v,%v) %s: no command from the setter", freq, damping, strings.Join(log, ","))
+		}
+		if m.Percent() != tgt {
+			j.Fail("spring(%v,%v) %s: Percent() %v, want %v", freq, damping, strings.Join(log, ","), m.Percent(), tgt)
+		}
+		// a stale frame (previous tag) or another bar's frame is ignored
+		shown := m.percentShown
+		m2, cmd := m.Update(FrameMsg{id: m.id, tag: m.tag - 1})
+		m3, cmd3 := m.Update(FrameMsg{id: m.id + 1000, tag: m.tag})
+		m4, cmd4 := m.Update("other")
+		if m2.percentShown != shown || cmd != nil || m3.percentShown != shown || cmd3 != nil || m4.percentShown != shown || cmd4 != nil {
+			j.Fail("spring(%v,%v) %s: a stale or foreign message moved the bar", freq, damping, strings.Join(log, ","))
+		}
+		settle(&m, op.frames)
+	}
+	frames := 0
+	for frames < 30000 && m.IsAnimating() {
+		var cmd tea.Cmd
+		m, cmd = m.Update(FrameMsg{id: m.id, tag: m.tag})
+		frames++
+		if cmd == nil && m.IsAnimating() {
+			j.Fail("spring(%v,%v) %s: frame %d returned no command while animating", freq, damping, strings.Join(log, ","), frames)
+		}
+		if frames%97 == 1 {
+			if v := m.View(); v != m.ViewAs(m.percentShown) {
+				j.Fail("spring(%v,%v) %s: View %q differs from ViewAs(%v)", freq, damping, strings.Join(log, ","), v, m.percentShown)
+			}
+		}
+	}
+	if m.IsAnimating() {
+		j.Fail("spring(%v,%v) %s: still animating after %d frames (shown %v, velocity %v)", freq, damping, strings.Join(log, ","), frames, m.percentShown, m.velocity)
+	}
+	if math.Abs(m.percentShown-tgt) >= 0.001 {
+		j.Fail("spring(%v,%v) %s: settled at %v, target %v", freq, damping, strings.Join(log, ","), m.percentShown, tgt)
+	}
+	if math.Abs(m.velocity) >= 0.01 {
+		// IsAnimating compares the signed velocity with 0.01, so a bar moving
+		// down stops the moment it is near the target.
+		j.Shape("bubbles/59")
+		j.Fail("spring(%v,%v) %s: stopped at %v after %d frames with velocity %v, want one under 0.01", freq, damping, strings.Join(log, ","), m.percentShown, frames, m.velocity)
+	}
+	m2, cmd := m.Update(FrameMsg{id: m.id, tag: m.tag})
+	if cmd != nil || m2.percentShown != m.percentShown {
+		j.Fail("spring(%v,%v) %s: a frame after equilibrium moved the bar", freq, damping, strings.Join(log, ","))
+	}
+}
+
+// TestHegelProgressSettles: SetPercent/IncrPercent/DecrPercent clamp the
+// target to [0, 1] and start an animation whose frames (a FrameMsg with the
+// bar's id and tag; others are ignored) move the shown percentage to within
+// 0.001 of the target with a settled velocity; View is ViewAs of the shown
+// percentage throughout.
+func TestHegelProgressSettles(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, settleCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSettle(j, c)
+	})
+}
+
+// bubbles/59: IsAnimating returns false once the distance is under 0.001
+// and the *signed* velocity is under 0.01, so a bar animating downward
+// stops dead the first time it passes near the target, however fast it is
+// moving, while the same spring animating upward bounces to rest.
+func TestHegelPinProgressStopsOnTheWayDown(t *testing.T) {
+	m := New(WithSpringOptions(18, 0.2))
+	m.SetPercent(1)
+	up := settle(&m, 10000)
+	m.SetPercent(0)
+	down := settle(&m, 10000)
+	if math.Abs(m.velocity) >= 0.01 || down*4 < up {
+		t.Fatalf("spring(18, 0.2): up settled in %d frames, down in %d frames at %v with velocity %v", up, down, m.percentShown, m.velocity)
+	}
+}
+
+// bubbles/60: WithColors with two or more colours sets the blend but does
+// not clear a colour function set before it (one colour does), so the
+// options depend on their order.
+func TestHegelPinProgressWithColorsKeepsTheColorFunc(t *testing.T) {
+	red, green := lipgloss.Color("#FF0000"), lipgloss.Color("#00FF00")
+	fn := func(_, _ float64) color.Color { return lipgloss.Color("#0000FF") }
+	a := New(WithWidth(6), WithoutPercentage(), WithColorFunc(fn), WithColors(red, green))
+	b := New(WithWidth(6), WithoutPercentage(), WithColors(red, green))
+	if a.ViewAs(1) != b.ViewAs(1) {
+		t.Fatalf("WithColorFunc then WithColors(red, green): %q\nWithColors(red, green) alone:          %q", a.ViewAs(1), b.ViewAs(1))
+	}
+}
+
+// bubbles/61: the bar counts runes, not cells, so wide fill characters
+// render twice the width.
+func TestHegelPinProgressWideRunesDoubleTheWidth(t *testing.T) {
+	m := New(WithWidth(10), WithFillCharacters('全', '　'), WithoutPercentage())
+	if w := ansi.StringWidth(m.ViewAs(0.5)); w != 10 {
+		t.Fatalf("width 10 with wide fill runes renders %d wide: %q", w, ansi.Strip(m.ViewAs(0.5)))
+	}
+}
+
+// bubbles/62: ViewAs passes its argument to the colour function unclamped,
+// so total can be 1.7 or -0.3 while the bar and the text are clamped.
+func TestHegelPinProgressColorFuncGetsTheUnclampedTotal(t *testing.T) {
+	var totals []float64
+	m := New(WithWidth(4), WithoutPercentage(), WithColorFunc(func(total, _ float64) color.Color {
+		totals = append(totals, total)
+		return lipgloss.Color("#FF0000")
+	}))
+	m.ViewAs(1.7)
+	for _, tot := range totals {
+		if tot != 1 {
+			t.Fatalf("ViewAs(1.7) called the colour function with total %v", tot)
+		}
+	}
+}
+
+// bubbles/63: SetPercent clamps with math.Max/math.Min, which pass NaN
+// through, so IncrPercent(NaN) leaves Percent() NaN and an animation that
+// never reaches equilibrium (a frame command every tick, for ever).
+func TestHegelPinProgressNaNAnimatesForever(t *testing.T) {
+	m := New()
+	m.IncrPercent(math.NaN())
+	frames := settle(&m, 1000)
+	if math.IsNaN(m.Percent()) || frames == 1000 {
+		t.Fatalf("after IncrPercent(NaN): Percent() %v, still animating after %d frames", m.Percent(), frames)
+	}
+}
diff --git a/spinner/hegel_shapes_test.go b/spinner/hegel_shapes_test.go
new file mode 100644
index 0000000..6d7c473
--- /dev/null
+++ b/spinner/hegel_shapes_test.go
@@ -0,0 +1,55 @@
+package spinner
+
+// The shape region of the recorded spinner bug (bugs.toml bubbles/95) and the narrow
+// property over it: a generator over the bug's shape with random contents, judged
+// exactly like the wide property (judgeSpinner). It fails every run by default; under
+// HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (zootest.Shaped) and the property passes. The library accepts a tick carrying tag 0
+// whatever its own tag, so every instance reaches the bug (measured: 100 of 100 with
+// math/rand over the library, both forms).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// narrowSpinner runs a narrow property: every drawn case through the wide property's
+// judge.
+func narrowSpinner(t *testing.T, cases hegel.Generator[spinnerCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSpinner(j, c)
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/95
+
+// tickWithTagZeroAfterTheFirst: the two forms of a tag-0 tick reaching a spinner that
+// has ticked: a primed spinner (tag 1 or more) sent a broadcast TickMsg{ID: 0} after
+// up to six operations (past the shape, a tick with a stale tag, rejected by both),
+// or a spinner whose first tick is still pending sent Tick again, so that the first
+// round delivers two ticks carrying tag 0 and the library accepts both (past the
+// shape, the same with the first tick delivered before: the second chain's tick is
+// stale then); up to six operations follow either.
+var tickWithTagZeroAfterTheFirst = hegel.OneOf(
+	casesOf(hegel.Just(true), zootest.Seq(
+		zootest.Counted(spinnerOps, 0, 6),
+		zootest.One(zootest.Shaped(opOf("broadcast"), staleOps)),
+		zootest.Counted(spinnerOps, 0, 6),
+	)),
+	casesOf(hegel.Just(zootest.Shaped(false, true)), zootest.Seq(
+		zootest.One(opOf("tick")),
+		zootest.Counted(spinnerOps, 0, 4),
+		zootest.One(opOf("round")),
+		zootest.Counted(spinnerOps, 0, 6),
+	)),
+)
+
+func TestHegelSpinnerTickWithTagZeroAfterTheFirst(t *testing.T) {
+	narrowSpinner(t, tickWithTagZeroAfterTheFirst)
+}
diff --git a/spinner/hegel_test.go b/spinner/hegel_test.go
new file mode 100644
index 0000000..df92c70
--- /dev/null
+++ b/spinner/hegel_test.go
@@ -0,0 +1,242 @@
+package spinner
+
+// Hegel zoo: properties of the spinner component against a mirror of its
+// frame, its tag and the ticks it has in flight. A case is a spinner, whether
+// its first tick is delivered before the operations (primed) and a list of
+// operation records applied in order; the shape of the recorded bug
+// (bubbles/95, a tick carrying tag 0 accepted after the first) is drawn like
+// any other case and fails naming it, and is not drawn under
+// HEGEL_NO_KNOWN=1 (every spinner primed, no broadcast ticks).
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+var spinnerGlyphs = []string{"|", "/", "-", "\\", ".", "..", "...", "", "⠋", "⠙", "🌍", "▰▱▱", "a", "b"}
+
+// spinnerOp is one operation: a round (every tick in flight delivered, in order),
+// Tick (another chain from the current tag), a swap of the spinner, a tick of another
+// spinner, one with a stale tag (stale past the expected one) or a broadcast
+// (TickMsg{ID: 0}, which carries tag 0).
+type spinnerOp struct {
+	kind   string
+	frames []string // swap
+	stale  int      // stale: the offset past the expected tag
+}
+
+func (o spinnerOp) GoString() string {
+	switch o.kind {
+	case "swap":
+		return fmt.Sprintf("swap(%q)", o.frames)
+	case "stale":
+		return fmt.Sprintf("stale(+%d)", o.stale)
+	}
+	return o.kind
+}
+
+type spinnerCase struct {
+	frames []string
+	styled bool
+	primed bool // the first tick delivered before the operations
+	ops    []spinnerOp
+}
+
+func (c spinnerCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	s := fmt.Sprintf("frames %q", c.frames)
+	if c.styled {
+		s += " bold"
+	}
+	if c.primed {
+		s += " primed"
+	}
+	return s + ": " + strings.Join(ops, ", ")
+}
+
+func opOf(kind string) hegel.Generator[spinnerOp] { return hegel.Just(spinnerOp{kind: kind}) }
+
+var (
+	// frameLists: one to six glyphs.
+	frameLists = zootest.Counted(zootest.Sampled(spinnerGlyphs...), 1, 6)
+
+	swapOps  = hegel.Map(frameLists, func(fs []string) spinnerOp { return spinnerOp{kind: "swap", frames: fs} })
+	staleOps = hegel.Map(zootest.Ints(1, 5), func(k int) spinnerOp { return spinnerOp{kind: "stale", stale: k} })
+
+	// spinnerOps: the operations at the old property's weights; a broadcast tick is
+	// never drawn under HEGEL_NO_KNOWN=1 (it carries tag 0: bubbles/95 after the first
+	// tick).
+	spinnerOps = zootest.Weighted(
+		zootest.W(5, opOf("round")),
+		zootest.W(2, opOf("tick")),
+		zootest.W(1, swapOps),
+		zootest.W(1, opOf("foreign")),
+		zootest.W(1, staleOps),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), opOf("broadcast")),
+	)
+
+	// primes: the first tick pending through the operations (first; a second chain
+	// started then is bubbles/95) or delivered before them; always delivered under
+	// HEGEL_NO_KNOWN=1.
+	primes = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(false)),
+		zootest.W(1, hegel.Just(true)),
+	)
+
+	// spinnerCases: a spinner, bold three times in ten, primed or not, one to fourteen
+	// operations.
+	spinnerCases = casesOf(primes, zootest.Counted(spinnerOps, 1, 14))
+)
+
+// casesOf: a case from the priming and the operations.
+func casesOf(primed hegel.Generator[bool], ops hegel.Generator[[]spinnerOp]) hegel.Generator[spinnerCase] {
+	return hegel.Composite(func(tc hegel.TestCase) spinnerCase {
+		return spinnerCase{
+			frames: hegel.Draw(tc, frameLists),
+			styled: hegel.Draw(tc, zootest.Coin(30)),
+			primed: hegel.Draw(tc, primed),
+			ops:    hegel.Draw(tc, ops),
+		}
+	})
+}
+
+// judgeSpinner drives the spinner through the case and checks the frame shown, the
+// tag and the ticks emitted against the mirror after every step. The mirror accepts a
+// tick exactly when its tag is the one expected (the initial ticks carry tag 0, as
+// does a broadcast); the library accepts every tick carrying tag 0, which after the
+// first accepted tick is bubbles/95's shape.
+func judgeSpinner(j *zootest.Judge, c spinnerCase) {
+	sp := Spinner{Frames: c.frames, FPS: time.Microsecond}
+	opts := []Option{WithSpinner(sp)}
+	if c.styled {
+		opts = append(opts, WithStyle(lipgloss.NewStyle().Bold(true)))
+	}
+	m := New(opts...)
+	id := m.ID()
+	frames := c.frames
+	frame, tag := 0, 0
+	var lib []tea.Msg
+	var pend []int
+
+	check := func(what string) {
+		want := "(error)"
+		if frame < len(frames) {
+			want = frames[frame]
+		}
+		if got := ansi.Strip(m.View()); got != want || m.frame != frame || m.tag != tag {
+			j.Fail("%s: view %q frame %d tag %d, expected %q %d %d", what, got, m.frame, m.tag, want, frame, tag)
+		}
+		if m.ID() != id {
+			j.Fail("%s: id changed", what)
+		}
+	}
+	file := func(what string, msg tea.Msg, wantTag int) {
+		tk, ok := msg.(TickMsg)
+		if !ok || tk.ID != id || tk.tag != wantTag {
+			j.Fail("%s: %#v, expected TickMsg{%d, tag %d}", what, msg, id, wantTag)
+		}
+		lib = append(lib, msg)
+		pend = append(pend, wantTag)
+	}
+	deliver := func(what string, msg tea.Msg, msgTag int, own bool) {
+		if own && msgTag == 0 && tag != 0 {
+			// a tick carrying tag 0 is never rejected by the library; the mirror
+			// rejects it like any other stale tag
+			j.Shape("bubbles/95")
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(msg)
+		accepted := own && msgTag == tag
+		if accepted {
+			frame++
+			if frame >= len(frames) {
+				frame = 0
+			}
+			tag++
+			if cmd == nil {
+				j.Fail("%s: an accepted tick scheduled nothing", what)
+			}
+			file(what, cmd(), tag)
+		} else if cmd != nil {
+			j.Fail("%s: a rejected tick (tag %d, own %v, model tag %d) was answered", what, msgTag, own, tag)
+		}
+	}
+	round := func(what string) {
+		msgs, tags := lib, pend
+		lib, pend = nil, nil
+		for i, msg := range msgs {
+			deliver(what, msg, tags[i], true)
+		}
+		check(what)
+	}
+
+	file("first tick", m.Tick(), tag)
+	check("new")
+	if c.primed {
+		round("primed")
+	}
+	for step, op := range c.ops {
+		j.Note("step %d: %#v (frame %d/%d, tag %d, pending %v)", step, op, frame, len(frames), tag, pend)
+		switch op.kind {
+		case "tick":
+			file("tick", m.Tick(), tag)
+		case "swap":
+			m.Spinner = Spinner{Frames: op.frames, FPS: time.Microsecond}
+			frames = op.frames
+			check("swap")
+		case "foreign":
+			deliver("foreign", TickMsg{ID: id + 1000, tag: tag}, tag, false)
+			check("foreign")
+		case "stale":
+			st := tag + op.stale
+			deliver("stale", TickMsg{ID: id, tag: st}, st, true)
+			check("stale")
+		case "broadcast":
+			deliver("broadcast", TickMsg{ID: 0, tag: 0}, 0, true)
+			check("broadcast")
+		case "round":
+			round("round")
+		}
+	}
+}
+
+// TestHegelSpinnerAdvances drives a spinner with its own Tick, rounds of
+// delivery, spinner swaps and foreign or stale ticks and checks the frame
+// shown against the mirror. A tick carrying tag 0 is never rejected, so two
+// initial Ticks both advance the frame (bubbles/95: the mirror rejects the
+// second, the property fails naming the shape).
+func TestHegelSpinnerAdvances(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, spinnerCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSpinner(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/95
+func TestHegelPinSpinnerDoubleTickSkipsAFrame(t *testing.T) {
+	m := New(WithSpinner(Spinner{Frames: []string{"a", "b", "c", "d"}, FPS: time.Microsecond}))
+	first, second := m.Tick(), m.Tick()
+	m, _ = m.Update(first)
+	m, _ = m.Update(second)
+	if m.View() != "b" {
+		t.Fatalf("two initial ticks moved the spinner to %q, expected %q", m.View(), "b")
+	}
+}
diff --git a/stopwatch/hegel_shapes_test.go b/stopwatch/hegel_shapes_test.go
new file mode 100644
index 0000000..8ef6943
--- /dev/null
+++ b/stopwatch/hegel_shapes_test.go
@@ -0,0 +1,63 @@
+package stopwatch
+
+// The shape regions of the recorded stopwatch bugs (bugs.toml bubbles/91, 94) and the
+// narrow properties over them: each region is a generator over the bug's shape with
+// random contents, judged exactly like the wide property (judgeStopwatch). Every
+// narrow property fails every run by default; under HEGEL_NO_KNOWN=1 its generator
+// is the region next to the shape instead (zootest.Shaped) and the property passes.
+// Both shapes are deterministic in the library (an interval of zero, a guard that
+// lets tag 0 through), so every instance reaches the bug (measured: 100 of 100 with
+// math/rand over the library).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// narrowStopwatch runs a narrow property: every drawn case through the wide
+// property's judge.
+func narrowStopwatch(t *testing.T, cases hegel.Generator[stopwatchCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeStopwatch(j, c)
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/91
+
+// withoutAnInterval: New() alone in any start state, up to six operations, then Start
+// and a round (a tick is accepted on every instance: the one the Start scheduled, at
+// the latest) and up to six operations more; past the shape, New(WithInterval(d)).
+var withoutAnInterval = casesOf(hegel.Just(zootest.Shaped(true, false)), states, zootest.Seq(
+	zootest.Counted(stopwatchOps, 0, 6),
+	zootest.One(opOf("start")),
+	zootest.One(opOf("round")),
+	zootest.Counted(stopwatchOps, 0, 6),
+))
+
+func TestHegelStopwatchWithoutAnInterval(t *testing.T) {
+	narrowStopwatch(t, withoutAnInterval)
+}
+
+// --------------------------------------------------------------------------- bubbles/94
+
+// startedTwiceBeforeTheFirstTick: a stopwatch that has not ticked (fresh, or started
+// by Init), Start or Toggle and Start again, then a round: two or three ticks carrying
+// tag 0 arrive and the library accepts them all; up to six operations follow. Past
+// the shape, a stopwatch past its first tick: the later Start's tick is stale and
+// rejected.
+var startedTwiceBeforeTheFirstTick = casesOf(hegel.Just(false), zootest.Shaped(zootest.Sampled("fresh", "init"), hegel.Just("primed")), zootest.Seq(
+	zootest.One(zootest.Sampled(stopwatchOp{kind: "start"}, stopwatchOp{kind: "toggle"})),
+	zootest.One(opOf("start")),
+	zootest.One(opOf("round")),
+	zootest.Counted(stopwatchOps, 0, 6),
+))
+
+func TestHegelStopwatchStartedTwiceBeforeTheFirstTick(t *testing.T) {
+	narrowStopwatch(t, startedTwiceBeforeTheFirstTick)
+}
diff --git a/stopwatch/hegel_test.go b/stopwatch/hegel_test.go
new file mode 100644
index 0000000..d238623
--- /dev/null
+++ b/stopwatch/hegel_test.go
@@ -0,0 +1,372 @@
+package stopwatch
+
+// Hegel zoo: properties of the stopwatch component against a mirror of its
+// elapsed time, its running flag and the ticks it has in flight. A case is a
+// constructor (New(WithInterval(d)), or one time in five New() alone,
+// bubbles/91's shape), a start state (fresh, started, or started with its
+// first tick delivered) and a list of operation records applied in order; the
+// shapes of the recorded bugs are drawn like any other case and fail naming
+// them, and are not drawn under HEGEL_NO_KNOWN=1 (an interval always,
+// every stopwatch past its first tick: bubbles/94 lives before it).
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// zrun executes a command synchronously and flattens batches and sequences.
+func zrun(cmd tea.Cmd) []tea.Msg {
+	if cmd == nil {
+		return nil
+	}
+	msg := cmd()
+	if msg == nil {
+		return nil
+	}
+	v := reflect.ValueOf(msg)
+	if v.Kind() == reflect.Slice && v.Type().Elem() == reflect.TypeOf(tea.Cmd(nil)) {
+		var out []tea.Msg
+		for i := 0; i < v.Len(); i++ {
+			c, _ := v.Index(i).Interface().(tea.Cmd)
+			out = append(out, zrun(c)...)
+		}
+		return out
+	}
+	return []tea.Msg{msg}
+}
+
+// stopwatchOp is one operation: a round (every tick in flight delivered, in order),
+// Start, Stop, Toggle, Reset, another stopwatch's messages, a tick with a stale tag
+// (stale past the expected one) or a broadcast tick (TickMsg{ID: 0}, which the
+// stopwatch rejects).
+type stopwatchOp struct {
+	kind  string
+	stale int
+}
+
+func (o stopwatchOp) GoString() string {
+	if o.kind == "stale" {
+		return fmt.Sprintf("stale(+%d)", o.stale)
+	}
+	return o.kind
+}
+
+// stopwatchCase: the constructor, the interval, the start state and the operations.
+type stopwatchCase struct {
+	bare     bool          // New() without WithInterval (bubbles/91)
+	interval time.Duration // the interval given to WithInterval
+	state    string        // fresh, init (started, first tick pending) or primed (first tick delivered)
+	ops      []stopwatchOp
+}
+
+func (c stopwatchCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	ctor := fmt.Sprintf("New(WithInterval(%v))", c.interval)
+	if c.bare {
+		ctor = "New()"
+	}
+	return ctor + " " + c.state + ": " + strings.Join(ops, ", ")
+}
+
+func opOf(kind string) hegel.Generator[stopwatchOp] { return hegel.Just(stopwatchOp{kind: kind}) }
+
+var (
+	// intervals: a microsecond, or two three times in twenty (the tick commands sleep
+	// their interval).
+	intervals = zootest.Weighted(zootest.W(17, hegel.Just(time.Microsecond)), zootest.W(3, hegel.Just(2*time.Microsecond)))
+
+	// bares: New() without an interval one time in five (first: the shape the wide
+	// property reaches every run, bubbles/91), never under HEGEL_NO_KNOWN=1.
+	bares = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(true)),
+		zootest.W(4, hegel.Just(false)),
+	)
+
+	// states: fresh, started (Init: its first tick pending, tag 0) or primed (the first
+	// tick delivered, tag 1); only primed under HEGEL_NO_KNOWN=1, since a second Start
+	// before the first tick is bubbles/94.
+	states = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just("fresh")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just("init")),
+		zootest.W(1, hegel.Just("primed")),
+	)
+
+	staleOps = hegel.Map(zootest.Ints(1, 5), func(k int) stopwatchOp { return stopwatchOp{kind: "stale", stale: k} })
+
+	// stopwatchOps: the operations at the old property's weights.
+	stopwatchOps = zootest.Weighted(
+		zootest.W(6, opOf("round")),
+		zootest.W(2, opOf("start")),
+		zootest.W(2, opOf("stop")),
+		zootest.W(2, opOf("toggle")),
+		zootest.W(2, opOf("reset")),
+		zootest.W(1, opOf("foreign")),
+		zootest.W(1, staleOps),
+		zootest.W(1, opOf("broadcast")),
+	)
+
+	// stopwatchCases: a constructor, a start state and one to fourteen operations.
+	stopwatchCases = casesOf(bares, states, zootest.Counted(stopwatchOps, 1, 14))
+)
+
+// casesOf: a case from the constructor, the state and the operations.
+func casesOf(bare hegel.Generator[bool], state hegel.Generator[string], ops hegel.Generator[[]stopwatchOp]) hegel.Generator[stopwatchCase] {
+	return hegel.Composite(func(tc hegel.TestCase) stopwatchCase {
+		return stopwatchCase{
+			bare:     hegel.Draw(tc, bare),
+			interval: hegel.Draw(tc, intervals),
+			state:    hegel.Draw(tc, state),
+			ops:      hegel.Draw(tc, ops),
+		}
+	})
+}
+
+// smir mirrors the stopwatch: elapsed time, tag, running flag and the tags
+// of the ticks in flight.
+type smir struct {
+	d        time.Duration
+	interval time.Duration
+	tag      int
+	running  bool
+	pend     []int
+}
+
+// judgeStopwatch drives the stopwatch through the case and checks Elapsed, Running,
+// the tag, View and the ticks emitted against the mirror after every step. The mirror
+// counts the documented interval (a second for New() alone, bubbles/91) and accepts a
+// tick exactly when its tag is the one expected (a fresh stopwatch's ticks carry tag
+// 0); the library accepts every tick carrying tag 0, which after the first accepted
+// tick is bubbles/94's shape.
+func judgeStopwatch(j *zootest.Judge, c stopwatchCase) {
+	s := &smir{interval: c.interval}
+	var m Model
+	if c.bare {
+		m = New()
+		s.interval = time.Second // the documented default
+	} else {
+		m = New(WithInterval(c.interval))
+	}
+	id := m.ID()
+	var lib []tea.Msg
+
+	check := func(what string) {
+		if m.Elapsed() != s.d || m.Running() != s.running || m.tag != s.tag {
+			j.Fail("%s: elapsed %v running %v tag %d, expected %v %v %d",
+				what, m.Elapsed(), m.Running(), m.tag, s.d, s.running, s.tag)
+		}
+		if m.View() != s.d.String() {
+			j.Fail("%s: view %q, expected %q", what, m.View(), s.d.String())
+		}
+		if m.ID() != id {
+			j.Fail("%s: id changed %d -> %d", what, id, m.ID())
+		}
+	}
+	// file puts a tick the library scheduled into the pending lists.
+	file := func(what string, out []tea.Msg, tag int) {
+		if len(out) != 1 {
+			j.Fail("%s: %d messages %v, expected one tick", what, len(out), out)
+		}
+		tk, ok := out[0].(TickMsg)
+		if !ok || tk.ID != id || tk.tag != tag {
+			j.Fail("%s: %#v, expected TickMsg{%d, %d}", what, out[0], id, tag)
+		}
+		lib = append(lib, out[0])
+		s.pend = append(s.pend, tag)
+	}
+	start := func(what string) {
+		tagAtCall := s.tag
+		msgs := zrun(m.Start())
+		if len(msgs) != 2 {
+			j.Fail("%s: %d messages %v, expected StartStopMsg then a tick", what, len(msgs), msgs)
+		}
+		ss, ok := msgs[0].(StartStopMsg)
+		if !ok || ss.ID != id || !ss.running {
+			j.Fail("%s: %#v, expected StartStopMsg{%d, true}", what, msgs[0], id)
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(ss)
+		if cmd != nil {
+			j.Fail("%s: StartStopMsg answered with a command", what)
+		}
+		s.running = true
+		file(what, msgs[1:], tagAtCall)
+		check(what)
+	}
+	stop := func(what string) {
+		msgs := zrun(m.Stop())
+		if len(msgs) != 1 {
+			j.Fail("%s: %d messages, expected one StartStopMsg", what, len(msgs))
+		}
+		ss, ok := msgs[0].(StartStopMsg)
+		if !ok || ss.ID != id || ss.running {
+			j.Fail("%s: %#v, expected StartStopMsg{%d, false}", what, msgs[0], id)
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(ss)
+		if cmd != nil {
+			j.Fail("%s: StartStopMsg answered with a command", what)
+		}
+		s.running = false
+		check(what)
+	}
+	// deliver feeds one tick and mirrors the acceptance rule.
+	deliver := func(what string, msg TickMsg, tag int) {
+		accepted := s.running && tag == s.tag
+		if s.running && tag == 0 && s.tag != 0 {
+			// a tick carrying tag 0 is never rejected by the library; the mirror
+			// rejects it like any other stale tag
+			j.Shape("bubbles/94")
+		}
+		if accepted && c.bare {
+			// New() alone has no interval: the tick adds nothing to Elapsed
+			j.Shape("bubbles/91")
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(msg)
+		if accepted {
+			s.d += s.interval
+			s.tag++
+			file(what, zrun(cmd), s.tag)
+		} else if cmd != nil {
+			j.Fail("%s: tick tag %d rejected by the mirror (running %v, tag %d) was answered", what, tag, s.running, s.tag)
+		}
+	}
+	round := func(what string) {
+		msgs, tags := lib, s.pend
+		lib, s.pend = nil, nil
+		for i, msg := range msgs {
+			deliver(what, msg.(TickMsg), tags[i])
+		}
+		check(what)
+	}
+
+	if c.state != "fresh" {
+		// Init is Start.
+		tagAtCall := s.tag
+		msgs := zrun(m.Init())
+		if len(msgs) != 2 {
+			j.Fail("init: %d messages %v", len(msgs), msgs)
+		}
+		m, _ = m.Update(msgs[0])
+		s.running = true
+		file("init", msgs[1:], tagAtCall)
+	}
+	check("init")
+	if c.state == "primed" {
+		round("primed")
+	}
+
+	for step, op := range c.ops {
+		j.Note("step %d: %#v (elapsed %v, running %v, tag %d, pending %v)", step, op, s.d, s.running, s.tag, s.pend)
+		switch op.kind {
+		case "start":
+			start("start")
+		case "stop":
+			stop("stop")
+		case "toggle":
+			if s.running {
+				stop("toggle")
+			} else {
+				start("toggle")
+			}
+		case "reset":
+			msgs := zrun(m.Reset())
+			if len(msgs) != 1 {
+				j.Fail("reset: %d messages", len(msgs))
+			}
+			rs, ok := msgs[0].(ResetMsg)
+			if !ok || rs.ID != id {
+				j.Fail("reset: %#v", msgs[0])
+			}
+			var cmd tea.Cmd
+			m, cmd = m.Update(rs)
+			if cmd != nil {
+				j.Fail("reset answered with a command")
+			}
+			s.d = 0
+			check("reset")
+		case "foreign":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: id + 1000, tag: s.tag})
+			if cmd != nil {
+				j.Fail("a tick for stopwatch %d was answered by %d", id+1000, id)
+			}
+			m, cmd = m.Update(StartStopMsg{ID: id + 1000, running: !s.running})
+			if cmd != nil {
+				j.Fail("a StartStopMsg for another stopwatch was answered")
+			}
+			m, _ = m.Update(ResetMsg{ID: id + 1000})
+			check("foreign")
+		case "stale":
+			tag := s.tag + op.stale
+			deliver("stale", TickMsg{ID: id, tag: tag}, tag)
+			check("stale")
+		case "broadcast":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: 0, tag: 0})
+			if cmd != nil {
+				j.Fail("a tick with ID 0 was accepted")
+			}
+			check("broadcast")
+		case "round":
+			round("round")
+		}
+	}
+}
+
+// TestHegelStopwatchCounts drives a stopwatch with start/stop/toggle/reset
+// and rounds of tick delivery and checks Elapsed, Running and View against
+// the mirror. A tick carrying tag 0 is never rejected, so two Start commands
+// on a fresh stopwatch both count (bubbles/94: the mirror rejects the second,
+// the property fails naming the shape). New() without WithInterval has no
+// interval at all (bubbles/91: the mirror counts the documented second, the
+// property fails naming the shape).
+func TestHegelStopwatchCounts(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, stopwatchCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeStopwatch(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/91
+func TestHegelPinStopwatchNewHasNoInterval(t *testing.T) {
+	m := New()
+	if m.Interval <= 0 {
+		t.Fatalf("stopwatch.New() leaves Interval at %v; New's doc says 1s", m.Interval)
+	}
+}
+
+// bubbles/94
+func TestHegelPinStopwatchFreshDoubleStartCountsTwice(t *testing.T) {
+	m := New(WithInterval(time.Microsecond))
+	var pend []tea.Msg
+	for i := 0; i < 2; i++ {
+		msgs := zrun(m.Start())
+		m, _ = m.Update(msgs[0])
+		pend = append(pend, msgs[1:]...)
+	}
+	// One interval passes: both ticks arrive.
+	for _, msg := range pend {
+		m, _ = m.Update(msg)
+	}
+	if m.Elapsed() != time.Microsecond {
+		t.Fatalf("Start twice then one interval: Elapsed %v, expected 1µs", m.Elapsed())
+	}
+}
diff --git a/table/hegel_shapes_test.go b/table/hegel_shapes_test.go
new file mode 100644
index 0000000..f535b50
--- /dev/null
+++ b/table/hegel_shapes_test.go
@@ -0,0 +1,188 @@
+package table
+
+// The shape regions of the recorded table bugs (bugs.toml bubbles/42 to 48)
+// and the narrow properties over them: each region is a generator over the
+// bug's shape with random contents, judged exactly like the wide property
+// (judgeTable; the cell values of all but bubbles/48's are tab-free, so that
+// no other shape is named first). Every narrow property fails every run by
+// default; under
+// HEGEL_NO_KNOWN=1 its generator is the region next to the shape instead
+// (zootest.Shaped) and the property passes. The hit rates below were measured
+// with the collector over the generators themselves (BUBBLES_COLLECT=1
+// HEGEL_TEST_CASES=1000: the mismatches per case). Every shape here is also
+// drawn by the wide property at its natural rate.
+
+import (
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowTable runs a narrow property: every drawn case through the wide
+// property's judge.
+func narrowTable(t *testing.T, cases hegel.Generator[tbCase]) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTable(j, c)
+	})
+}
+
+// fittingWidths: a width of at least the header's (bubbles/46 apart).
+func fittingWidths(cols []Column) hegel.Generator[int] {
+	return zootest.Ints(max(8, headerWidth(cols)), 50)
+}
+
+// keyOpsUpTo: none to n key operations.
+func keyOpsUpTo(n int) hegel.Generator[[]tbOp] { return zootest.Counted(keyOps, 0, n) }
+
+// --------------------------------------------------------------------------- bubbles/42
+
+// rowWithTooManyFields: any columns and one to thirty rows, one within the
+// first page given a field too many (past the shape, none), a height of 2 to
+// 9 and a width fitting the header, then up to three keys: New renders the
+// row and panics (1000 of 1000).
+var rowWithTooManyFields = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	cols := hegel.Draw(tc, columns)
+	height := hegel.Draw(tc, zootest.Ints(2, 9))
+	rows := hegel.Draw(tc, rowsOf(plainValues, len(cols), 1, 30))
+	k := zootest.Shaped(hegel.Draw(tc, zootest.Ints(0, min(height-2, len(rows)-1))), -1)
+	start := tbStart{cols: cols, rows: raggedRows(rows, k), ragged: k, height: height, width: hegel.Draw(tc, fittingWidths(cols))}
+	return tbCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(3))}
+})
+
+func TestHegelTableRowWithTooManyFields(t *testing.T) {
+	narrowTable(t, rowWithTooManyFields)
+}
+
+// --------------------------------------------------------------------------- bubbles/43
+
+// setCursorBeyondTheView: more rows than a page and SetCursor to a row past
+// the first page (past the shape, within it): the library shows the page
+// above the selection (1000 of 1000).
+var setCursorBeyondTheView = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	cols := hegel.Draw(tc, columns)
+	height := hegel.Draw(tc, zootest.Ints(2, 9))
+	page := height - 1
+	rows := hegel.Draw(tc, rowsOf(plainValues, len(cols), page+1, 30))
+	n := hegel.Draw(tc, zootest.Ints(zootest.Shaped(page, 0), zootest.Shaped(len(rows)-1, page-1)))
+	start := tbStart{cols: cols, rows: rows, ragged: -1, height: height, width: hegel.Draw(tc, fittingWidths(cols))}
+	return tbCase{start: start, ops: []tbOp{{kind: "setcursor", n: n, ragged: -1}}}
+})
+
+func TestHegelTableSetCursorBeyondTheView(t *testing.T) {
+	narrowTable(t, setCursorBeyondTheView)
+}
+
+// --------------------------------------------------------------------------- bubbles/44
+
+// moveUpFromASelectionBelow: a start whose cursor SetCursor put at least two
+// pages down (past the shape, within the first page) in rows enough for it,
+// then one up move of up to a page (MoveUp, up, k, pgup, b, u or ctrl+u):
+// the library's offset cases do not reach down to the selection, which stays
+// a row below the view (1000 of 1000).
+var moveUpFromASelectionBelow = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	cols := hegel.Draw(tc, columns)
+	height := hegel.Draw(tc, zootest.Ints(2, 9))
+	page := height - 1
+	rows := hegel.Draw(tc, rowsOf(plainValues, len(cols), 2*page+1, 30))
+	n := hegel.Draw(tc, zootest.Ints(zootest.Shaped(2*page, 0), zootest.Shaped(len(rows)-1, page-1)))
+	start := tbStart{cols: cols, rows: rows, ragged: -1, cursor: n, height: height, width: hegel.Draw(tc, fittingWidths(cols))}
+	op := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(1, nOp("moveup", zootest.Ints(1, max(1, n-page)))),
+		zootest.W(1, hegel.Map(zootest.Sampled("up", "k", "pgup", "b", "u", "ctrl+u"), opOf)),
+	))
+	return tbCase{start: start, ops: []tbOp{op}}
+})
+
+func TestHegelTableMoveUpFromASelectionBelow(t *testing.T) {
+	narrowTable(t, moveUpFromASelectionBelow)
+}
+
+// --------------------------------------------------------------------------- bubbles/45
+
+// moveOnAnEmptyTable: no rows (past the shape, one to thirty) and a move
+// (MoveUp, MoveDown, SetCursor, GotoTop, GotoBottom or a binding), then
+// perhaps SetRows: the library's cursor is -1 from the move on (1000 of
+// 1000).
+var moveOnAnEmptyTable = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	cols := hegel.Draw(tc, columns)
+	rows := hegel.Draw(tc, rowsOf(plainValues, len(cols), zootest.Shaped(0, 1), zootest.Shaped(0, 30)))
+	start := tbStart{cols: cols, rows: rows, ragged: -1, height: hegel.Draw(tc, zootest.Ints(2, 9)), width: hegel.Draw(tc, fittingWidths(cols))}
+	move := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(6, keyOps),
+		zootest.W(1, nOp("moveup", zootest.Ints(0, 40))),
+		zootest.W(1, nOp("movedown", zootest.Ints(0, 40))),
+		zootest.W(1, nOp("setcursor", zootest.Ints(-3, 33))),
+		zootest.W(1, hegel.Just(opOf("top"))),
+		zootest.W(1, hegel.Just(opOf("bottom"))),
+	))
+	after := hegel.Draw(tc, zootest.Counted(rowsOp("setrows", 1, 30, hegel.Just(false)), 0, 1))
+	return tbCase{start: start, ops: append([]tbOp{move}, after...)}
+})
+
+func TestHegelTableMoveOnAnEmptyTable(t *testing.T) {
+	narrowTable(t, moveOnAnEmptyTable)
+}
+
+// --------------------------------------------------------------------------- bubbles/46
+
+// headerWiderThanTheTable: three or four columns of titles of one to eight
+// letters, the first of a width of 2 to 7 and the others of 1 to 7, in a
+// table narrower than the start of the last title (past the shape, as wide as
+// the header or wider), then up to three keys: the library's header overhangs
+// the rows (1000 of 1000).
+var headerWiderThanTheTable = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	titles := textsOf(letters, 1, 8)
+	cols := hegel.Draw(tc, zootest.Seq(zootest.One(columnOf(titles, zootest.Ints(2, 7))), zootest.Counted(columnOf(titles, zootest.Ints(1, 7)), 2, 3)))
+	hw := headerWidth(cols)
+	lastTitle := hw - cols[len(cols)-1].Width - 1
+	width := hegel.Draw(tc, zootest.Ints(zootest.Shaped(8, hw), zootest.Shaped(lastTitle, 50)))
+	start := tbStart{cols: cols, rows: hegel.Draw(tc, rowsOf(plainValues, len(cols), 0, 30)), ragged: -1, height: hegel.Draw(tc, zootest.Ints(2, 9)), width: width}
+	return tbCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(3))}
+})
+
+func TestHegelTableHeaderWiderThanTheTable(t *testing.T) {
+	narrowTable(t, headerWiderThanTheTable)
+}
+
+// --------------------------------------------------------------------------- bubbles/47
+
+// heightBelowTwo: a table of height 0 or 1 (past the shape, 2 to 9), then up
+// to three keys: Height() is the height less one and View has two lines
+// (1000 of 1000).
+var heightBelowTwo = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	cols := hegel.Draw(tc, columns)
+	height := hegel.Draw(tc, zootest.Ints(zootest.Shaped(0, 2), zootest.Shaped(1, 9)))
+	start := tbStart{cols: cols, rows: hegel.Draw(tc, rowsOf(plainValues, len(cols), 0, 30)), ragged: -1, height: height, width: hegel.Draw(tc, fittingWidths(cols))}
+	return tbCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(3))}
+})
+
+func TestHegelTableHeightBelowTwo(t *testing.T) {
+	narrowTable(t, heightBelowTwo)
+}
+
+// --------------------------------------------------------------------------- bubbles/48
+
+// tabInACell: a first column of width w (1 to 7), the first row's first cell
+// p letters (p below w), a tab (past the shape, four spaces) and enough
+// letters to overflow the column, then up to two keys: the library truncates
+// with the tab at no width and the expanded cell loses its end (1000 of
+// 1000).
+var tabInACell = hegel.Composite(func(tc hegel.TestCase) tbCase {
+	w := hegel.Draw(tc, zootest.Ints(1, 7))
+	p := hegel.Draw(tc, zootest.Ints(0, w-1))
+	head := hegel.Draw(tc, textsOf(letters, p, p))
+	tail := hegel.Draw(tc, textsOf(letters, max(0, w-p-3), 5))
+	cols := append([]Column{{Title: hegel.Draw(tc, textsOf(cellRunes, 0, 8)), Width: w}}, hegel.Draw(tc, zootest.Counted(columnOf(textsOf(cellRunes, 0, 8), zootest.Ints(0, 7)), 0, 3))...)
+	rows := hegel.Draw(tc, rowsOf(plainValues, len(cols), 1, 30))
+	rows[0] = append(Row{head + zootest.Shaped("\t", "    ") + tail}, rows[0][1:]...)
+	start := tbStart{cols: cols, rows: rows, ragged: -1, height: hegel.Draw(tc, zootest.Ints(2, 9)), width: hegel.Draw(tc, fittingWidths(cols))}
+	return tbCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(2))}
+})
+
+func TestHegelTableTabInACell(t *testing.T) {
+	narrowTable(t, tabInACell)
+}
diff --git a/table/hegel_test.go b/table/hegel_test.go
new file mode 100644
index 0000000..65b4f9c
--- /dev/null
+++ b/table/hegel_test.go
@@ -0,0 +1,974 @@
+package table
+
+// Hegel property tests for the table bubble: columns of a title and a width,
+// rows of cell values, a cursor and a viewport of rendered rows around it.
+//
+// A case is a record of the start (the columns, the rows, a cursor placed by
+// SetCursor, the height and the width; the selection reversed, the default
+// paddings) and a list of operation records (every default binding, MoveUp
+// and MoveDown by any count, SetCursor, SetRows, SetColumns, SetHeight,
+// SetWidth, GotoTop, GotoBottom, Blur/Focus and FromValues) applied in order.
+// The model keeps the cursor clamped into the rows (0 with none), the focus,
+// the size, and the window the library renders (the rows within a height of
+// the cursor and the offset of the viewport over them, by the library's own
+// arithmetic, which is what says where the first shown row is). After the
+// start and after every operation Cursor, SelectedRow, Focused, Height (one
+// less than the table's height, never below zero), Width and the view must
+// follow: the header (every title truncated with an ellipsis and padded to its
+// column, between one space each side, cut to the width) over Height rows
+// rendered the same way (a tab is four cells, cut like any other), consecutive
+// from the window's first row, blank past the rows; after every operation the
+// cursor's row must be among them and the only reversed line. The start's own
+// view may leave the selection out (SetCursor's state, bubbles/43): what the
+// operations make of it is judged, which is how an up move's failure to scroll
+// down to it (bubbles/44) is reached at all.
+//
+// The shapes of the recorded bugs are drawn like any other case (a row with a
+// field too many, a tab in a cell, a height below two, a header wider than
+// the table, a cursor out of the view, a move on an empty table) and a
+// classifier over the model names the bug a step has before it is taken (on a
+// clone where the step is replayed); the comparison is always made and fails
+// naming the shape, a panic in the library too. Under HEGEL_NO_KNOWN=1 the
+// long rows, tabs and heights below two are not drawn, the start's cursor and
+// width keep the selection and the header in view, and the operations that
+// would reach a shape are dropped from the case.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"hegel.dev/go/hegel"
+)
+
+var property = zootest.Property
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+var tableKeys = map[string]tea.KeyPressMsg{
+	"up": keyOf(tea.KeyUp), "k": typed('k'), "down": keyOf(tea.KeyDown), "j": typed('j'),
+	"pgup": keyOf(tea.KeyPgUp), "b": typed('b'), "pgdown": keyOf(tea.KeyPgDown), "f": typed('f'), "space": keyOf(tea.KeySpace),
+	"u": typed('u'), "ctrl+u": tea.KeyPressMsg{Code: 'u', Mod: tea.ModCtrl}, "d": typed('d'), "ctrl+d": tea.KeyPressMsg{Code: 'd', Mod: tea.ModCtrl},
+	"home": keyOf(tea.KeyHome), "g": typed('g'), "end": keyOf(tea.KeyEnd), "G": typed('G'),
+}
+
+// plainStyles make the selection visible as reversed cells; the paddings are
+// the defaults.
+func plainStyles() Styles {
+	return Styles{
+		Selected: lipgloss.NewStyle().Reverse(true),
+		Header:   lipgloss.NewStyle().Padding(0, 1),
+		Cell:     lipgloss.NewStyle().Padding(0, 1),
+	}
+}
+
+// ---------------------------------------------------------------- generators
+
+// cellRunes: the runes of a title or a cell value at the old generator's
+// shares (a letter, a space, a wide rune).
+var cellRunes = zootest.Weighted(
+	zootest.W(73, hegel.Map(zootest.Ints(0, 25), func(i int) rune { return 'a' + rune(i) })),
+	zootest.W(15, hegel.Just(' ')),
+	zootest.W(12, hegel.Just('\u65e5')),
+)
+
+// textsOf is a string of lo to hi runes drawn from rs.
+func textsOf(rs hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(zootest.Counted(rs, lo, hi), func(r []rune) string { return string(r) })
+}
+
+var (
+	letters = hegel.Map(zootest.Ints(0, 25), func(i int) rune { return 'a' + rune(i) })
+
+	// plainValues: a cell value of up to nine runes.
+	plainValues = textsOf(cellRunes, 0, 9)
+	// values: a plain value or, one time in sixty (never under
+	// HEGEL_NO_KNOWN=1), two halves around a tab (bubbles/48).
+	values = zootest.Weighted(
+		zootest.W(59, plainValues),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Map(zootest.Tuple(textsOf(cellRunes, 0, 5), textsOf(cellRunes, 0, 5)), func(h []string) string { return strings.Join(h, "\t") })),
+	)
+	// columns: one to four columns of a title of up to eight runes and a width
+	// of 0 (skipped) to 7.
+	columns = zootest.Counted(columnOf(textsOf(cellRunes, 0, 8), zootest.Ints(0, 7)), 1, 4)
+	// raggeds: whether one row gets a field too many (bubbles/42), eight times
+	// in a hundred and never under HEGEL_NO_KNOWN=1.
+	raggeds = zootest.Coin(zootest.Unless(zootest.NoKnown, 8))
+	// heights: a table height of 2 to 9 or, one time in twenty (never under
+	// HEGEL_NO_KNOWN=1), 0 or 1 (bubbles/47).
+	heights = zootest.Weighted(zootest.W(19, zootest.Ints(2, 9)), zootest.W(zootest.Unless(zootest.NoKnown, 1), zootest.Ints(0, 1)))
+	widths  = zootest.Ints(8, 50)
+)
+
+// columnOf is a column of a drawn title and width (a Composite only because
+// the binding has no record combinator).
+func columnOf(titles hegel.Generator[string], widths hegel.Generator[int]) hegel.Generator[Column] {
+	return hegel.Composite(func(tc hegel.TestCase) Column {
+		return Column{Title: hegel.Draw(tc, titles), Width: hegel.Draw(tc, widths)}
+	})
+}
+
+// rowsOf: a list of lo to hi rows of fields values.
+func rowsOf(values hegel.Generator[string], fields, lo, hi int) hegel.Generator[[]Row] {
+	fs := make([]hegel.Generator[string], fields)
+	for i := range fs {
+		fs[i] = values
+	}
+	return zootest.Counted(hegel.Map(zootest.Tuple(fs...), func(f []string) Row { return f }), lo, hi)
+}
+
+// tbStart is the start of a case: the columns, the rows (one of which may be
+// ragged, with a field too many), the cursor SetCursor places, the height and
+// the width.
+type tbStart struct {
+	cols   []Column
+	rows   []Row
+	ragged int // the index of the row with a field too many, -1 for none
+	cursor int
+	height int
+	width  int
+}
+
+func (s tbStart) String() string {
+	return fmt.Sprintf("table %dx%d cols %s rows %s cursor %d", s.width, s.height, colsString(s.cols), rowsString(s.rows), s.cursor)
+}
+
+func colsString(cols []Column) string {
+	parts := make([]string, len(cols))
+	for i, c := range cols {
+		parts[i] = fmt.Sprintf("%q/%d", c.Title, c.Width)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func rowsString(rows []Row) string {
+	parts := make([]string, len(rows))
+	for i, r := range rows {
+		parts[i] = fmt.Sprintf("%q", []string(r))
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// build makes the table of the start; a cursor above 0 is placed by SetCursor.
+func (s tbStart) build() Model {
+	m := New(WithColumns(s.cols), WithRows(s.rows), WithHeight(s.height), WithWidth(s.width), WithFocused(true), WithStyles(plainStyles()))
+	if s.cursor > 0 {
+		m.SetCursor(s.cursor)
+	}
+	return m
+}
+
+// raggedRows is rows with the row at k (modulo the rows) given a field too
+// many; -1 for none.
+func raggedRows(rows []Row, k int) []Row {
+	if k < 0 || len(rows) == 0 {
+		return rows
+	}
+	out := append([]Row{}, rows...)
+	i := k % len(rows)
+	out[i] = append(append(Row{}, rows[i]...), "x")
+	return out
+}
+
+// headerWidth is the width of the header: every shown column plus its
+// paddings.
+func headerWidth(cols []Column) int {
+	w := 0
+	for _, c := range cols {
+		if c.Width > 0 {
+			w += c.Width + 2
+		}
+	}
+	return w
+}
+
+// startsOf: the columns, rows of as many fields (one of them ragged at the
+// raggeds' rate), a height, a cursor (0 three times in four, else within the
+// rows up to 40, or under HEGEL_NO_KNOWN=1 within the first page, so that the
+// start shows it) and a width of 8 to 50 (under HEGEL_NO_KNOWN=1, at least
+// the header's).
+func startsOf(columns hegel.Generator[[]Column], rowsHi int, raggeds hegel.Generator[bool], heights hegel.Generator[int]) hegel.Generator[tbStart] {
+	return hegel.Composite(func(tc hegel.TestCase) tbStart {
+		cols := hegel.Draw(tc, columns)
+		rows := hegel.Draw(tc, rowsOf(values, len(cols), 0, rowsHi))
+		ragged := -1
+		if hegel.Draw(tc, raggeds) {
+			ragged = hegel.Draw(tc, zootest.Ints(0, rowsHi))
+		}
+		height := hegel.Draw(tc, heights)
+		cursor := 0
+		if top := min(len(rows)-1, zootest.Shaped(40, height-2)); top >= 1 {
+			cursor = hegel.Draw(tc, zootest.Maybe(25, zootest.Ints(1, top)))
+		}
+		width := hegel.Draw(tc, zootest.Ints(zootest.Shaped(8, max(8, headerWidth(cols))), 50))
+		return tbStart{cols: cols, rows: raggedRows(rows, ragged), ragged: ragged, cursor: cursor, height: height, width: width}
+	})
+}
+
+var tbStarts = startsOf(columns, 30, raggeds, heights)
+
+// tbOp is one operation: a key, a move or a setter with its argument (the
+// rows of setrows and fromvalues are drawn with five fields and cut to the
+// live column count, the one at ragged given a field too many).
+type tbOp struct {
+	kind   string
+	n      int
+	rows   []Row
+	ragged int
+	cols   []Column
+}
+
+func (op tbOp) GoString() string {
+	switch op.kind {
+	case "moveup", "movedown", "setcursor", "setheight", "setwidth":
+		return fmt.Sprintf("%s(%d)", op.kind, op.n)
+	case "setrows", "fromvalues":
+		return fmt.Sprintf("%s(%s ragged %d)", op.kind, rowsString(op.rows), op.ragged)
+	case "setcols":
+		return fmt.Sprintf("setcols(%s)", colsString(op.cols))
+	}
+	return op.kind
+}
+
+func opOf(kind string) tbOp { return tbOp{kind: kind, ragged: -1} }
+
+func nOp(kind string, ns hegel.Generator[int]) hegel.Generator[tbOp] {
+	return hegel.Map(ns, func(n int) tbOp { return tbOp{kind: kind, n: n, ragged: -1} })
+}
+
+// rowsOp: kind with lo to hi rows of five fields and, at the raggeds' rate,
+// the index of a row to give a field too many.
+func rowsOp(kind string, lo, hi int, raggeds hegel.Generator[bool]) hegel.Generator[tbOp] {
+	return hegel.Composite(func(tc hegel.TestCase) tbOp {
+		op := tbOp{kind: kind, rows: hegel.Draw(tc, rowsOf(values, 5, lo, hi)), ragged: -1}
+		if hegel.Draw(tc, raggeds) {
+			op.ragged = hegel.Draw(tc, zootest.Ints(0, hi))
+		}
+		return op
+	})
+}
+
+// upKinds and downKinds: the bindings that move up and down.
+var (
+	upKinds   = []string{"up", "k", "pgup", "b", "u", "ctrl+u", "home", "g"}
+	downKinds = []string{"down", "j", "pgdown", "f", "space", "d", "ctrl+d", "end", "G"}
+	keyKinds  = append(append([]string{}, upKinds...), downKinds...)
+	keyOps    = hegel.Map(zootest.Sampled(keyKinds...), opOf)
+)
+
+// tbOps: an operation at the old shares (a key three times in fourteen, the
+// rest once each).
+var tbOps = zootest.Weighted(
+	zootest.W(3, keyOps),
+	zootest.W(1, nOp("moveup", zootest.Ints(0, 40))),
+	zootest.W(1, nOp("movedown", zootest.Ints(0, 40))),
+	zootest.W(1, nOp("setcursor", zootest.Ints(-3, 33))),
+	zootest.W(1, rowsOp("setrows", 0, 30, raggeds)),
+	zootest.W(1, hegel.Map(columns, func(cols []Column) tbOp { return tbOp{kind: "setcols", cols: cols, ragged: -1} })),
+	zootest.W(1, nOp("setheight", heights)),
+	zootest.W(1, nOp("setwidth", widths)),
+	zootest.W(1, hegel.Just(opOf("top"))),
+	zootest.W(1, hegel.Just(opOf("bottom"))),
+	zootest.W(1, hegel.Just(opOf("focus"))),
+	zootest.W(1, rowsOp("fromvalues", 0, 12, raggeds)),
+)
+
+// tbCase is a start and the operations applied to it.
+type tbCase struct {
+	start tbStart
+	ops   []tbOp
+}
+
+func (c tbCase) GoString() string {
+	parts := make([]string, len(c.ops))
+	for i, op := range c.ops {
+		parts[i] = op.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(parts, ", ")
+}
+
+func casesOf(starts hegel.Generator[tbStart], ops hegel.Generator[[]tbOp]) hegel.Generator[tbCase] {
+	return hegel.Composite(func(tc hegel.TestCase) tbCase {
+		return tbCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// tbCases: a start and one to forty operations; under HEGEL_NO_KNOWN=1 the
+// operations that would reach a shape are dropped (unshaped).
+var tbCases = hegel.Map(casesOf(tbStarts, zootest.Counted(tbOps, 1, 40)), unshaped)
+
+// unshaped drops, under HEGEL_NO_KNOWN=1, the operations the classifier
+// names a shape for, replaying the model over the kept ones: a move on an
+// empty table (bubbles/45), a setter or an up move that leaves the selection
+// out of view (43, 44), columns fewer than a row's fields (42), a width below
+// the header's (46).
+func unshaped(c tbCase) tbCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	m := newTbModel(c.start)
+	var kept []tbOp
+	for _, op := range c.ops {
+		if stepShape(m, op) != "" {
+			continue
+		}
+		m.apply(op)
+		kept = append(kept, op)
+	}
+	return tbCase{start: c.start, ops: kept}
+}
+
+// ---------------------------------------------------------------- model
+
+// cellText is the text of one column cell: the value (a tab four cells)
+// truncated to the column's width with an ellipsis and padded to it, between
+// one space each side.
+func cellText(value string, width int) string {
+	cells := zootest.Cells(strings.ReplaceAll(value, "\t", "    "))
+	var b strings.Builder
+	col := 0
+	if zootest.Width(cells) > width {
+		for _, c := range cells {
+			if col+c.W > width-1 {
+				break
+			}
+			b.WriteString(c.S)
+			col += c.W
+		}
+		b.WriteString("\u2026")
+		col++
+	} else {
+		for _, c := range cells {
+			b.WriteString(c.S)
+		}
+		col = zootest.Width(cells)
+	}
+	b.WriteString(strings.Repeat(" ", width-col))
+	return " " + b.String() + " "
+}
+
+// rowText is a row's line: the cells of its first len(cols) fields in the
+// columns of a width above 0.
+func rowText(cols []Column, r Row) string {
+	var b strings.Builder
+	for i, v := range r {
+		if i >= len(cols) || cols[i].Width <= 0 {
+			continue
+		}
+		b.WriteString(cellText(v, cols[i].Width))
+	}
+	return b.String()
+}
+
+func headerText(cols []Column) string {
+	var b strings.Builder
+	for _, c := range cols {
+		if c.Width <= 0 {
+			continue
+		}
+		b.WriteString(cellText(c.Title, c.Width))
+	}
+	return b.String()
+}
+
+// cut keeps the cells that fit in width columns, as the viewport does, and
+// drops trailing blanks.
+func cut(s string, width int) string {
+	var b strings.Builder
+	col := 0
+	for _, c := range zootest.Cells(s) {
+		if col+c.W > width {
+			break
+		}
+		b.WriteString(c.S)
+		col += c.W
+	}
+	return strings.TrimRight(b.String(), " ")
+}
+
+func clampInt(v, lo, hi int) int { return min(max(v, lo), hi) }
+
+// libWindow is the window the library renders, by its own arithmetic: its
+// cursor (-1 after a move on an empty table, bubbles/45), the rows start to
+// end it renders (within h, the viewport's height, of the cursor), the
+// viewport's offset over them and its line count.
+type libWindow struct {
+	cursor, start, end, offset, total, h int
+}
+
+// update is UpdateViewport: the window around the cursor, the offset pulled
+// back to the bottom when past it.
+func (l *libWindow) update(cols []Column, rows []Row) {
+	if l.cursor >= 0 {
+		l.start = clampInt(l.cursor-l.h, 0, l.cursor)
+	} else {
+		l.start = 0
+	}
+	l.end = clampInt(l.cursor+l.h, l.cursor, len(rows))
+	l.total = max(0, l.end-l.start)
+	if l.total == 1 && rowText(cols, rows[l.start]) == "" {
+		l.total = 0 // one empty line is no content to the viewport
+	}
+	l.offset = min(l.offset, l.maxY())
+}
+
+func (l *libWindow) maxY() int { return max(0, l.total-l.h) }
+
+func (l *libWindow) setYOffset(n int) { l.offset = clampInt(n, 0, l.maxY()) }
+
+// first is the row the first shown line is.
+func (l *libWindow) first() int { return l.start + l.offset }
+
+// tbModel is the model of a table: the columns, the rows, the cursor (within
+// the rows, 0 with none), the focus, the height and width, and the library's
+// window.
+type tbModel struct {
+	cols   []Column
+	rows   []Row
+	cursor int
+	focus  bool
+	height int
+	width  int
+	lib    libWindow
+}
+
+func newTbModel(s tbStart) *tbModel {
+	m := &tbModel{cols: s.cols, rows: s.rows, focus: true, height: s.height, width: s.width}
+	m.lib = libWindow{h: s.height - 1}
+	m.lib.update(m.cols, m.rows)
+	if s.cursor > 0 {
+		m.setCursor(s.cursor)
+	}
+	return m
+}
+
+func (m *tbModel) clone() *tbModel {
+	d := *m
+	return &d
+}
+
+// rowsHeight is Height(): the rows the table shows, never below zero.
+func (m *tbModel) rowsHeight() int { return max(m.height-1, 0) }
+
+func (m *tbModel) last() int { return max(len(m.rows)-1, 0) }
+
+// shown reports the cursor's row among the shown ones.
+func (m *tbModel) shown() bool {
+	first := m.lib.first()
+	return m.cursor >= first && m.cursor < first+m.rowsHeight()
+}
+
+func (m *tbModel) setCursor(n int) {
+	m.cursor = clampInt(n, 0, m.last())
+	m.lib.cursor = clampInt(n, 0, len(m.rows)-1)
+	m.lib.update(m.cols, m.rows)
+}
+
+func (m *tbModel) setRows(rows []Row) {
+	m.rows = rows
+	m.cursor = clampInt(m.cursor, 0, m.last())
+	if m.lib.cursor > len(rows)-1 {
+		m.lib.cursor = len(rows) - 1
+	}
+	m.lib.update(m.cols, m.rows)
+}
+
+// moveUp is MoveUp(n): the cursor up by n; the library's offset by its three
+// cases (none of which handles a cursor below the view, bubbles/44), clamped
+// against the old content, then the window around the new cursor.
+func (m *tbModel) moveUp(n int) {
+	m.cursor = clampInt(m.cursor-n, 0, m.last())
+	l := &m.lib
+	l.cursor = clampInt(l.cursor-n, 0, len(m.rows)-1)
+	offset := l.offset
+	switch {
+	case l.start == 0:
+		offset = clampInt(offset, 0, l.cursor)
+	case l.start < l.h:
+		offset = clampInt(clampInt(offset+n, 0, l.cursor), 0, l.h)
+	case offset >= 1:
+		offset = clampInt(offset+n, 1, l.h)
+	}
+	l.setYOffset(offset)
+	l.update(m.cols, m.rows)
+}
+
+// moveDown is MoveDown(n): the cursor down by n, the window around it, then
+// the library's offset by its four cases.
+func (m *tbModel) moveDown(n int) {
+	m.cursor = clampInt(m.cursor+n, 0, m.last())
+	l := &m.lib
+	l.cursor = clampInt(l.cursor+n, 0, len(m.rows)-1)
+	l.update(m.cols, m.rows)
+	offset := l.offset
+	switch {
+	case l.end == len(m.rows) && offset > 0:
+		offset = clampInt(offset-n, 1, l.h)
+	case l.cursor > (l.end-l.start)/2 && offset > 0:
+		offset = clampInt(offset-n, 1, l.cursor)
+	case offset > 1:
+	case l.cursor > offset+l.h-1:
+		offset = clampInt(offset+1, 0, 1)
+	}
+	l.setYOffset(offset)
+}
+
+// resolveRows is the rows of a setrows or fromvalues op against ncols live
+// columns: every row cut to ncols fields, the ragged one given one more.
+func resolveRows(op tbOp, ncols int) []Row {
+	rows := make([]Row, len(op.rows))
+	for i, r := range op.rows {
+		rows[i] = append(Row{}, r[:ncols]...)
+	}
+	return raggedRows(rows, op.ragged)
+}
+
+// valuesOf is the FromValues text of rows: lines of comma-separated fields.
+func valuesOf(rows []Row) string {
+	lines := make([]string, len(rows))
+	for i, r := range rows {
+		lines[i] = strings.Join(r, ",")
+	}
+	return strings.Join(lines, "\n")
+}
+
+// parsedRows is what FromValues makes of a text: a row per line, a field per
+// comma (one row of one empty field for an empty text).
+func parsedRows(value string) []Row {
+	var rows []Row
+	for _, line := range strings.Split(value, "\n") {
+		rows = append(rows, Row(strings.Split(line, ",")))
+	}
+	return rows
+}
+
+// apply applies op to the model.
+func (m *tbModel) apply(op tbOp) {
+	h := m.lib.h
+	switch op.kind {
+	case "up", "k":
+		m.keyUp(1)
+	case "down", "j":
+		m.keyDown(1)
+	case "pgup", "b":
+		m.keyUp(h)
+	case "pgdown", "f", "space":
+		m.keyDown(h)
+	case "u", "ctrl+u":
+		m.keyUp(h / 2)
+	case "d", "ctrl+d":
+		m.keyDown(h / 2)
+	case "home", "g":
+		m.keyUp(m.cursor)
+	case "end", "G":
+		m.keyDown(len(m.rows))
+	case "moveup":
+		m.moveUp(op.n)
+	case "movedown":
+		m.moveDown(op.n)
+	case "setcursor":
+		m.setCursor(op.n)
+	case "setrows":
+		m.setRows(resolveRows(op, len(m.cols)))
+	case "fromvalues":
+		m.setRows(parsedRows(valuesOf(resolveRows(op, len(m.cols)))))
+	case "setcols":
+		m.cols = op.cols
+		m.lib.update(m.cols, m.rows)
+	case "setheight":
+		m.height = op.n
+		m.lib.h = op.n - 1
+		m.lib.update(m.cols, m.rows)
+	case "setwidth":
+		m.width = op.n
+		m.lib.update(m.cols, m.rows)
+	case "top":
+		m.moveUp(m.cursor)
+	case "bottom":
+		m.moveDown(len(m.rows))
+	case "focus":
+		m.focus = !m.focus
+		m.lib.update(m.cols, m.rows)
+	}
+}
+
+// keyUp and keyDown are a binding's move, ignored while blurred.
+func (m *tbModel) keyUp(n int) {
+	if m.focus {
+		m.moveUp(n)
+	}
+}
+
+func (m *tbModel) keyDown(n int) {
+	if m.focus {
+		m.moveDown(n)
+	}
+}
+
+// applyLib applies op to the table; the rows ops are resolved against the
+// model's live columns.
+func applyLib(t *Model, m *tbModel, op tbOp) {
+	switch op.kind {
+	case "moveup":
+		t.MoveUp(op.n)
+	case "movedown":
+		t.MoveDown(op.n)
+	case "setcursor":
+		t.SetCursor(op.n)
+	case "setrows":
+		t.SetRows(resolveRows(op, len(m.cols)))
+	case "fromvalues":
+		t.FromValues(valuesOf(resolveRows(op, len(m.cols))), ",")
+	case "setcols":
+		t.SetColumns(op.cols)
+	case "setheight":
+		t.SetHeight(op.n)
+	case "setwidth":
+		t.SetWidth(op.n)
+	case "top":
+		t.GotoTop()
+	case "bottom":
+		t.GotoBottom()
+	case "focus":
+		if m.focus {
+			t.Blur()
+		} else {
+			t.Focus()
+		}
+	default:
+		*t, _ = t.Update(tableKeys[op.kind])
+	}
+}
+
+// ---------------------------------------------------------------- shapes
+
+// ragged reports a row with more fields than the columns within the window
+// the library renders: renderRow panics on it (bubbles/42).
+func (m *tbModel) ragged() bool {
+	for i := m.lib.start; i < m.lib.end; i++ {
+		if len(m.rows[i]) > len(m.cols) {
+			return true
+		}
+	}
+	return false
+}
+
+// tabShape reports a shown cell the library renders wrong (bubbles/48): a
+// value whose cells, the tab four, overflow the column while the library,
+// the tab at no width, either does not truncate it or truncates it past the
+// tab (lipgloss then cuts the expanded cell where the model has its
+// ellipsis), the column's last cell within the table's width.
+func (m *tbModel) tabShape() bool {
+	first := m.lib.first()
+	for i := first; i < min(m.lib.end, first+m.rowsHeight()); i++ {
+		off := 0
+		for j, c := range m.cols {
+			if c.Width <= 0 {
+				continue
+			}
+			if j < len(m.rows[i]) && tabOverflows(m.rows[i][j], c.Width) && off+c.Width < m.width {
+				return true
+			}
+			off += c.Width + 2
+		}
+	}
+	return false
+}
+
+// tabOverflows: the value with its tabs as four cells is wider than width
+// while, with them as none, it fits or is truncated past its first tab.
+func tabOverflows(value string, width int) bool {
+	p := strings.IndexByte(value, '\t')
+	if p < 0 {
+		return false
+	}
+	narrow := strings.ReplaceAll(value, "\t", "")
+	wide := strings.ReplaceAll(value, "\t", "    ")
+	if zootest.Width(zootest.Cells(wide)) <= width {
+		return false
+	}
+	return zootest.Width(zootest.Cells(narrow)) <= width || zootest.Width(zootest.Cells(value[:p])) <= width-1
+}
+
+func isUp(kind string) bool {
+	for _, k := range upKinds {
+		if k == kind {
+			return true
+		}
+	}
+	return kind == "moveup" || kind == "top"
+}
+
+func isKey(kind string) bool {
+	for _, k := range keyKinds {
+		if k == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// headerOverhangs reports a header with a cell past the table's width, which
+// the library does not cut (bubbles/46; blank overhang shows nothing).
+func (m *tbModel) headerOverhangs() bool {
+	header := headerText(m.cols)
+	return strings.TrimRight(header, " ") != cut(header, m.width)
+}
+
+// stateShape names the recorded bug whose shape the model's state has: a row
+// with a field too many within the rendered window, on which the library
+// panics (bubbles/42); a height below two, which the library does not clamp
+// (47); a header past the table's width, which the library does not cut (46);
+// a shown cell with a tab, which the library truncates at no width (48).
+func stateShape(m *tbModel) string {
+	switch {
+	case m.ragged():
+		return "bubbles/42"
+	case m.height < 2:
+		return "bubbles/47"
+	case m.headerOverhangs():
+		return "bubbles/46"
+	case m.tabShape():
+		return "bubbles/48"
+	}
+	return ""
+}
+
+// startShape names the recorded bug whose shape the start has: the window
+// New renders (the first page) before SetCursor places the cursor, then the
+// state the start leaves.
+func startShape(s tbStart) string {
+	if shape := stateShape(newTbModel(tbStart{cols: s.cols, rows: s.rows, height: s.height, width: s.width})); shape != "" {
+		return shape
+	}
+	return stateShape(newTbModel(s))
+}
+
+// stepShape names the recorded bug whose shape the operation has from the
+// model's state, before it is applied (on a clone where it is replayed): the
+// shapes of the state the operation leaves, the library's cursor left at -1
+// by a move on an empty table (bubbles/45), then a setter, Blur, Focus or a
+// key ignored while blurred that leaves the selection out of view (43) or an
+// up move that leaves it below (44). A down move that leaves it out is no
+// recorded shape.
+func stepShape(m *tbModel, op tbOp) string {
+	d := m.clone()
+	d.apply(op)
+	if shape := stateShape(d); shape != "" {
+		return shape
+	}
+	if d.lib.cursor != d.cursor {
+		return "bubbles/45"
+	}
+	if d.shown() {
+		return ""
+	}
+	moved := op.kind == "moveup" || op.kind == "movedown" || op.kind == "top" || op.kind == "bottom" || (m.focus && isKey(op.kind))
+	switch {
+	case !moved:
+		return "bubbles/43"
+	case isUp(op.kind):
+		return "bubbles/44"
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------- judge
+
+// judgeTable builds the start, applies the operations and checks the table
+// against the model after the start and after every operation; the wide and
+// the narrow properties share it.
+func judgeTable(j *zootest.Judge, c tbCase) {
+	m := newTbModel(c.start)
+	j.Shape(startShape(c.start))
+	t := c.start.build()
+	checkTable(j, &t, m, "at the start", false)
+	for _, op := range c.ops {
+		j.Shape(stepShape(m, op))
+		applyLib(&t, m, op)
+		m.apply(op)
+		j.Note("%s -> cursor %d, rows %d..%d shown from %d", op.GoString(), m.cursor, m.lib.start, m.lib.end, m.lib.first())
+		checkTable(j, &t, m, "after "+op.GoString(), true)
+	}
+}
+
+// checkTable compares the table with the model: Focused, Cursor, SelectedRow,
+// Height, Width and the view (the header cut to the width over Height rows
+// from the window's first, blank past the rows, the cursor's row the only
+// reversed line), and after an operation (judged) the cursor's row shown.
+func checkTable(j *zootest.Judge, t *Model, m *tbModel, what string, judged bool) {
+	if t.Focused() != m.focus {
+		j.Fail("%s: Focused %v, want %v", what, t.Focused(), m.focus)
+	}
+	if t.Cursor() != m.cursor {
+		j.Fail("%s: Cursor %d, want %d (rows %d)", what, t.Cursor(), m.cursor, len(m.rows))
+	}
+	var want Row
+	if len(m.rows) > 0 {
+		want = m.rows[m.cursor]
+	}
+	if got := t.SelectedRow(); strings.Join(got, "|") != strings.Join(want, "|") || (got == nil) != (want == nil) {
+		j.Fail("%s: SelectedRow %q, want row %d %q", what, got, m.cursor, want)
+	}
+	h := m.rowsHeight()
+	if t.Height() != h || t.Width() != m.width {
+		j.Fail("%s: Height %d, Width %d, want %d, %d", what, t.Height(), t.Width(), h, m.width)
+	}
+	view := strings.Split(t.View(), "\n")
+	if len(view) != h+1 {
+		j.Fail("%s: View has %d lines, want %d:\n%s", what, len(view), h+1, t.View())
+	}
+	if got, want := strings.TrimRight(zootest.Plain(zootest.Cells(view[0])), " "), cut(headerText(m.cols), m.width); got != want {
+		j.Fail("%s: header %q, want %q", what, got, want)
+	}
+	first := m.lib.first()
+	reversed := -1
+	for i, line := range view[1:] {
+		cells := zootest.Cells(line)
+		want := ""
+		if first+i < m.lib.end {
+			want = cut(rowText(m.cols, m.rows[first+i]), m.width)
+		}
+		if got := strings.TrimRight(zootest.Plain(cells), " "); got != want {
+			j.Fail("%s: body line %d %q, want row %d %q", what, i, got, first+i, want)
+		}
+		for _, c := range cells {
+			if c.Rev && reversed >= 0 && reversed != i {
+				j.Fail("%s: lines %d and %d both reversed", what, reversed, i)
+			}
+			if c.Rev {
+				reversed = i
+			}
+		}
+	}
+	if !m.shown() {
+		if reversed >= 0 {
+			j.Fail("%s: line %d reversed while the cursor row %d is not shown (rows %d..%d)", what, reversed, m.cursor, first, first+h-1)
+		}
+		if judged {
+			j.Fail("%s: cursor row %d not shown (rows %d..%d of %d)", what, m.cursor, first, first+h-1, len(m.rows))
+		}
+		return
+	}
+	if len(m.rows) > 0 && rowText(m.cols, m.rows[m.cursor]) != "" && reversed != m.cursor-first {
+		j.Fail("%s: reversed line %d, want the cursor's line %d", what, reversed, m.cursor-first)
+	}
+}
+
+// TestHegelTableShowsTheSelectedRow: the cursor follows the bindings and
+// the setters within [0, rows-1]; SelectedRow is the cursor's row; View is
+// the header over Height() lines of consecutive rows, each the row's cells
+// cut to the width; the cursor's row is shown, and it is the only reversed
+// line.
+func TestHegelTableShowsTheSelectedRow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tbCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTable(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func panicked(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+func pinTable(rows int, h int) Model {
+	rs := make([]Row, rows)
+	for i := range rs {
+		rs[i] = Row{fmt.Sprintf("row %d", i), fmt.Sprintf("v%d", i)}
+	}
+	return New(WithColumns([]Column{{Title: "A", Width: 6}, {Title: "B", Width: 4}}), WithRows(rs), WithHeight(h), WithWidth(30), WithFocused(true), WithStyles(plainStyles()))
+}
+
+func shownRows(m Model) string {
+	var lines []string
+	for _, l := range strings.Split(m.View(), "\n")[1:] {
+		lines = append(lines, strings.TrimSpace(zootest.Plain(zootest.Cells(l))))
+	}
+	return strings.Join(lines, "/")
+}
+
+// bubbles/42: a row with more fields than there are columns panics in
+// renderRow (a stray separator in FromValues is enough).
+func TestHegelPinTableLongRowPanics(t *testing.T) {
+	m := pinTable(3, 6)
+	if panicked(func() { m.FromValues("a,b\nc,d,e", ",") }) {
+		t.Fatalf("FromValues with a three-field line under two columns panicked")
+	}
+}
+
+// bubbles/43: SetCursor moves the selection without scrolling to it; the
+// view shows the rows above.
+func TestHegelPinTableSetCursorHidesTheSelection(t *testing.T) {
+	m := pinTable(100, 6)
+	m.SetCursor(50)
+	if got := shownRows(m); !strings.Contains(got, "row 50 ") {
+		t.Fatalf("after SetCursor(50) the view shows %q", got)
+	}
+}
+
+// bubbles/44: from that state MoveUp keeps the selection one row below the
+// view (its third case needs an offset of at least 1).
+func TestHegelPinTableMoveUpKeepsTheSelectionBelow(t *testing.T) {
+	m := pinTable(100, 6)
+	m.SetCursor(50)
+	m.MoveUp(1)
+	if got := shownRows(m); !strings.Contains(got, "row 49 ") {
+		t.Fatalf("after SetCursor(50), MoveUp(1) the view shows %q", got)
+	}
+}
+
+// bubbles/45: a move on an empty table leaves the cursor at -1, and SetRows
+// only clamps downwards, so it stays there: no selected row, and one row
+// fewer rendered.
+func TestHegelPinTableCursorStaysNegative(t *testing.T) {
+	m := pinTable(0, 6)
+	m.MoveDown(1)
+	m.SetRows([]Row{{"a", "1"}, {"b", "2"}, {"c", "3"}, {"d", "4"}, {"e", "5"}})
+	if m.Cursor() != 0 || m.SelectedRow() == nil || !strings.Contains(shownRows(m), "e") {
+		t.Fatalf("Cursor %d, SelectedRow %q, view %q", m.Cursor(), m.SelectedRow(), shownRows(m))
+	}
+}
+
+// bubbles/46: the header line is not cut to the table's width.
+func TestHegelPinTableHeaderIgnoresTheWidth(t *testing.T) {
+	m := New(WithColumns([]Column{{Title: "Alpha", Width: 10}, {Title: "Beta", Width: 10}, {Title: "Gamma", Width: 10}}), WithRows([]Row{{"a", "b", "c"}}), WithHeight(4), WithWidth(12), WithFocused(true))
+	head := strings.Split(m.View(), "\n")[0]
+	if got := zootest.Width(zootest.Cells(head)); got > 12 {
+		t.Fatalf("header %q is %d cells wide in a table of width 12", head, got)
+	}
+}
+
+// bubbles/47: a height under 2 is not clamped: Height() goes negative and
+// View still has two lines.
+func TestHegelPinTableHeightBelowTwo(t *testing.T) {
+	m := pinTable(5, 0)
+	if m.Height() < 0 || len(strings.Split(m.View(), "\n")) != 1 {
+		t.Fatalf("height 0: Height() %d, View %q", m.Height(), m.View())
+	}
+}
+
+// bubbles/48: a tab in a cell value is truncated at width 0 and rendered at
+// width 4, so "a\tb" in a five-wide column shows "a" alone.
+func TestHegelPinTableTabEatsTheCell(t *testing.T) {
+	m := New(WithColumns([]Column{{Title: "A", Width: 5}}), WithRows([]Row{{"a\tb"}}), WithHeight(3), WithWidth(20), WithFocused(true))
+	row := zootest.Plain(zootest.Cells(strings.Split(m.View(), "\n")[1]))
+	if !strings.Contains(row, "b") {
+		t.Fatalf("row %q lost the b", row)
+	}
+}
