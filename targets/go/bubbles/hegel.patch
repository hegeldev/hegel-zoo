+	return fpCase{start: start, ops: []fpOp{open}}
+})
+
+func TestHegelFilepickerOpenAnUnreadableDirectory(t *testing.T) {
+	narrowPicker(t, openAnUnreadableDirectory)
+}
+
+// --------------------------------------------------------------------------- bubbles/70
+
+// backFromTheDefaultDirectory: the working directory moved into a directory
+// of random files and CurrentDirectory left at New's "." (past the shape, the
+// absolute path), then Back: the library computes Dir(".") and stays, while
+// the parent of the working directory's absolute path is meant (1000 of
+// 1000). The wide property never draws "."; the shape lives here.
+var backFromTheDefaultDirectory = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	tree := hegel.Draw(tc, filesTree(0, visibleNames))
+	start := hegel.Draw(tc, plainStarts(tree, hegel.Draw(tc, startHeights)))
+	start.rel = zootest.Shaped(true, false)
+	return fpCase{start: start, ops: []fpOp{hegel.Draw(tc, backOps)}}
+})
+
+func TestHegelFilepickerBackFromTheDefaultDirectory(t *testing.T) {
+	narrowPicker(t, backFromTheDefaultDirectory)
+}
+
+// --------------------------------------------------------------------------- bubbles/71
+
+// viewHasHeightLines: one to six files at any height and up to two moves:
+// every non-empty view ends in a newline after its lines, one more than the
+// height (1000 of 1000). The shape has no region beside it: under
+// HEGEL_NO_KNOWN=1 the same cases are drawn, the line count's check is
+// dropped and counted as known, and the rest of the view is compared.
+var viewHasHeightLines = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	tree := hegel.Draw(tc, filesTree(1, visibleNames))
+	start := hegel.Draw(tc, plainStarts(tree, hegel.Draw(tc, startHeights)))
+	moves := hegel.Draw(tc, zootest.Counted(zootest.Weighted(zootest.W(1, topOps), zootest.W(1, downOps), zootest.W(1, upOps)), 0, 2))
+	return fpCase{start: start, ops: moves}
+})
+
+func TestHegelFilepickerViewHasHeightLines(t *testing.T) {
+	narrowPicker(t, viewHasHeightLines)
+}
+
+// --------------------------------------------------------------------------- bubbles/72
+
+// enterOnADirectoryReportsIt: DirAllowed with FileAllowed off (past the
+// shape, on) and enter on a directory d1 of none to six files (past the
+// shape, one to six): the library has entered it and looks at its first
+// entry, a file it may not select, or nothing, and reports no selection
