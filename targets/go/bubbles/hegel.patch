new file mode 100644
index 0000000..073f797
--- /dev/null
+++ b/list/hegel_test.go
@@ -0,0 +1,897 @@
+package list
+
+// Hegel property for the list: a model of the items, the filter and the
+// selection index, driven through every default binding, the filter input
+// and the setters, checked against Index/GlobalIndex/SelectedItem/
+// VisibleItems, the paginator and every line of View(). Commands returned by
+// Update are run at once and their messages fed back, as Bubble Tea would.
+// The package is internal only for the item styles' defaults; nothing
+// unexported is read.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+)
+
+type zitem struct{ title string }
+
+func (i zitem) Title() string       { return i.title }
+func (i zitem) Description() string { return "desc" }
+func (i zitem) FilterValue() string { return i.title }
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+var browseKeys = map[string]tea.KeyPressMsg{
+	"up": keyOf(tea.KeyUp), "k": typed('k'), "down": keyOf(tea.KeyDown), "j": typed('j'),
+	"left": keyOf(tea.KeyLeft), "h": typed('h'), "pgup": keyOf(tea.KeyPgUp), "b": typed('b'), "u": typed('u'),
+	"right": keyOf(tea.KeyRight), "l": typed('l'), "pgdown": keyOf(tea.KeyPgDown), "f": typed('f'), "d": typed('d'),
+	"home": keyOf(tea.KeyHome), "g": typed('g'), "end": keyOf(tea.KeyEnd), "G": typed('G'),
+	"/": typed('/'), "esc": keyOf(tea.KeyEscape),
+}
+
+// ranked is the order DefaultFilter gives the items for a term.
+func ranked(term string, titles []string) []int {
+	var out []int
+	for _, r := range DefaultFilter(term, titles) {
+		out = append(out, r.Index)
+	}
+	return out
+}
+
+func seq(n int) []int {
+	out := make([]int, n)
+	for i := range out {
+		out[i] = i
+	}
+	return out
+}
+
+// lst is the model: the items, the filter, the visible indices, the
+// selection index, the layout flags and a mirror of the paginator.
+type lst struct {
+	titles     []string
+	state      FilterState
+	text       string
+	visible    []int // indices into titles, in the shown order
+	sel        int   // the library's Index()
+	w, h       int
+	showTitle  bool
+	showStatus bool
+	showPag    bool
+	showHelp   bool
+	infinite   bool
+	itemH      int
+	pp         int  // PerPage
+	staleIdx   bool // a RemoveItem under the filter left the match indices stale (bubbles/50)
+	kbPages    bool // the page keys as updateKeybindings last enabled them
+	kbItems    bool // the filter key likewise
+	pages      int  // the paginator's TotalPages as the library last computed it
+}
+
+func (s *lst) items() []Item {
+	out := make([]Item, len(s.titles))
+	for i, t := range s.titles {
+		out[i] = zitem{t}
+	}
+	return out
+}
+
+func (s *lst) all() []int { return seq(len(s.titles)) }
+
+// filtered is what filterItems returns for the current text.
+func (s *lst) filtered() []int {
+	if s.text == "" {
+		return s.all()
+	}
+	return ranked(s.text, s.titles)
+}
+
+func (s *lst) chrome() int {
+	c := 1
+	if s.showTitle || s.state == Filtering {
+		c = 2
+	}
+	if s.showStatus {
+		c += 2
+	}
+	if s.showPag {
+		c++
+	}
+	if s.showHelp {
+		c += 2
+	}
+	return c
+}
+
+// updPag mirrors updatePagination with n visible items at the time of the
+// call (the library's filteredItems may lag behind the model's visible).
+func (s *lst) updPag(n int) {
+	s.pp = max(1, (s.h-s.chrome())/(s.itemH+1))
+	if n < 1 {
+		s.pages = 1
+	} else {
+		s.pages = (n + s.pp - 1) / s.pp
+	}
+	page, cursor := s.sel/s.pp, s.sel%s.pp
+	if page >= s.pages-1 {
+		page = max(0, s.pages-1)
+	}
+	s.sel = page*s.pp + cursor
+}
+
+// updKeys mirrors updateKeybindings' browsing branch.
+func (s *lst) updKeys() {
+	s.kbPages = s.pages > 1
+	s.kbItems = len(s.titles) > 0
+}
+
+func (s *lst) truePages() int {
+	if len(s.visible) < 1 {
+		return 1
+	}
+	return (len(s.visible) + s.pp - 1) / s.pp
+}
+
+func (s *lst) last() int { return max(0, len(s.visible)-1) }
+
+// clampCursor mirrors handleBrowsing's clamp after every browsing message.
+func (s *lst) clampCursor() {
+	page, cursor := s.sel/s.pp, s.sel%s.pp
+	on := clampInt(len(s.visible)-page*s.pp, 0, s.pp)
+	s.sel = page*s.pp + clampInt(cursor, 0, max(0, on-1))
+}
+
+func (s *lst) reset() {
+	if s.state == Unfiltered {
+		return
+	}
+	s.state = Unfiltered
+	s.text = ""
+	s.visible = s.all()
+	s.staleIdx = false
+	s.updPag(len(s.visible))
+	s.updKeys()
+}
+
+func clampInt(v, lo, hi int) int { return min(max(v, lo), hi) }
+
+type run struct {
+	m   Model
+	s   *lst
+	log []string
+}
+
+// feed runs a command and feeds its messages to the model, mirroring what
+// the messages do to the model of the list.
+func (r *run) feed(cmd tea.Cmd) {
+	if cmd == nil {
+		return
+	}
+	msg := cmd()
+	switch v := msg.(type) {
+	case nil:
+	case tea.BatchMsg:
+		for _, c := range v {
+			r.feed(c)
+		}
+	case FilterMatchesMsg:
+		r.m, _ = r.m.Update(v)
+		r.s.visible = r.s.filtered()
+		r.s.staleIdx = false
+	case tea.QuitMsg:
+	default:
+		var next tea.Cmd
+		r.m, next = r.m.Update(v)
+		if r.s.state == Filtering {
+			r.s.updPag(len(r.s.visible))
+		} else {
+			r.s.clampCursor()
+		}
+		r.feed(next)
+	}
+}
+
+func (r *run) press(k tea.KeyPressMsg) {
+	var cmd tea.Cmd
+	r.m, cmd = r.m.Update(k)
+	r.feed(cmd)
+}
+
+func genTitle(tc hegel.TestCase, i int) string {
+	n := zootest.N(tc, 1, 5)
+	var b strings.Builder
+	for j := 0; j < n; j++ {
+		b.WriteByte(byte('a' + zootest.N(tc, 0, 4)))
+	}
+	return fmt.Sprintf("w%02d %s", i, b.String())
+}
+
+func genTitles(tc hegel.TestCase, hi int) []string {
+	out := make([]string, zootest.N(tc, 0, hi))
+	for i := range out {
+		out[i] = genTitle(tc, i)
+	}
+	return out
+}
+
+func genTerm(tc hegel.TestCase) string {
+	n := zootest.N(tc, 1, 3)
+	var b strings.Builder
+	for j := 0; j < n; j++ {
+		b.WriteByte(byte('a' + zootest.N(tc, 0, 4)))
+	}
+	return b.String()
+}
+
+func plainLine(l string) string {
+	return strings.TrimRight(zootest.Plain(zootest.Cells(l)), " ")
+}
+
+// TestHegelListFollowsTheModel: the selection index follows the bindings and
+// the setters; the filter's visible items are DefaultFilter's ranks; Index,
+// GlobalIndex, SelectedItem, VisibleItems, the paginator and the lines of
+// View (title, status, the page's items with the selected one marked, the
+// pagination dots) agree with the model after every step.
+func TestHegelListFollowsTheModel(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s := &lst{
+			titles: genTitles(tc, 25), state: Unfiltered,
+			w: zootest.N(tc, 20, 60), h: zootest.N(tc, 12, 30),
+			showTitle: true, showStatus: true, showPag: true, showHelp: true,
+			itemH: 2,
+		}
+		s.visible = s.all()
+		d := NewDefaultDelegate()
+		if zootest.Chance(tc, 30) {
+			d.ShowDescription = false
+			s.itemH = 1
+		}
+		r := &run{s: s}
+		r.m = New(s.items(), d, s.w, s.h)
+		r.m.FilterInput.SetVirtualCursor(false)
+		r.m.SetSize(s.w, s.h) // bubbles/54: New alone leaves the help unsized
+		s.updPag(len(s.visible))
+		s.updKeys()
+		trace := func() string { return strings.Join(r.log, ",") }
+		steps := zootest.N(tc, 1, 40)
+		for step := 0; step < steps; step++ {
+			var op string
+			if s.state == Filtering {
+				op = zootest.Pick(tc, []string{"type", "type", "type", "backspace", "enter", "esc", "accept-down", "setitems", "setsize"})
+			} else {
+				op = zootest.Pick(tc, []string{"key", "key", "key", "key", "select", "setitems", "setitem", "insert", "remove", "remove", "setsize", "toggle", "filtertext", "resetfilter", "method", "infinite"})
+			}
+			r.log = append(r.log, op)
+			switch op {
+			case "type":
+				c := rune('a' + zootest.N(tc, 0, 4))
+				r.log[len(r.log)-1] = string(c)
+				s.text += string(c)
+				n := len(s.visible)
+				r.press(typed(c))
+				// handleFiltering updates the pagination before the matches arrive
+				s.updPag(n)
+			case "backspace":
+				if s.text != "" {
+					s.text = s.text[:len(s.text)-1]
+				}
+				n := len(s.visible)
+				r.press(keyOf(tea.KeyBackspace))
+				s.updPag(n)
+			case "enter", "accept-down":
+				k := keyOf(tea.KeyEnter)
+				if op == "accept-down" {
+					k = keyOf(tea.KeyDown)
+				}
+				r.press(k)
+				switch {
+				case s.text == "" || len(s.titles) == 0:
+					s.updPag(len(s.visible))
+				case len(s.visible) == 0:
+					s.reset()
+				default:
+					s.state = FilterApplied
+					// the accept path refreshes the bindings before the pagination (bubbles/56)
+					s.updKeys()
+					s.updPag(len(s.visible))
+				}
+			case "esc":
+				r.press(keyOf(tea.KeyEscape))
+				s.reset()
+				s.kbItems = true // cancel re-enables the filter key whatever the items (bubbles/56)
+			case "key":
+				k := zootest.Pick(tc, []string{"up", "k", "down", "j", "left", "h", "pgup", "b", "u", "right", "l", "pgdown", "f", "d", "home", "g", "end", "G", "/", "esc"})
+				r.log[len(r.log)-1] = k
+				r.press(browseKeys[k])
+				n := len(s.visible)
+				page := s.sel / s.pp
+				pageKey := strings.Contains(" left h pgup b u right l pgdown f d ", " "+k+" ")
+				if (pageKey && s.kbPages != (s.pages > 1)) || (k == "/" && s.kbItems != (len(s.titles) > 0)) {
+					// bubbles/56: RemoveItem and the section toggles do not refresh the bindings.
+					zootest.Count("bubbles/56")
+					return
+				}
+				switch k {
+				case "up", "k":
+					if n == 0 {
+						break
+					}
+					if s.sel == 0 {
+						if s.infinite {
+							s.sel = s.last()
+						}
+					} else {
+						s.sel--
+					}
+				case "down", "j":
+					if n == 0 {
+						break
+					}
+					if s.sel >= s.last() {
+						if s.infinite {
+							s.sel = 0
+						}
+					} else {
+						s.sel++
+					}
+				case "left", "h", "pgup", "b", "u":
+					if s.pages > 1 && page > 0 {
+						s.sel -= s.pp
+					}
+				case "right", "l", "pgdown", "f", "d":
+					if s.pages > 1 && page < s.pages-1 {
+						s.sel += s.pp
+					}
+				case "home", "g":
+					if n > 0 {
+						s.sel = 0
+					}
+				case "end", "G":
+					if n > 0 {
+						s.sel = (s.pages-1)*s.pp + max(0, clampInt(n-(s.pages-1)*s.pp, 0, s.pp)-1)
+					}
+				case "/":
+					if len(s.titles) == 0 {
+						break
+					}
+					if s.text == "" {
+						s.visible = s.all()
+					}
+					s.sel = 0
+					s.state = Filtering
+					// the Blink message comes back through handleFiltering
+					s.updPag(len(s.visible))
+					s.kbPages = false
+				case "esc":
+					if s.state == FilterApplied {
+						s.reset()
+					}
+				}
+				if s.state != Filtering {
+					s.clampCursor()
+				}
+			case "select":
+				if len(s.visible) == 0 {
+					break
+				}
+				i := zootest.N(tc, 0, s.last())
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d)", i)
+				r.m.Select(i)
+				s.sel = i
+			case "setitems":
+				s.titles = genTitles(tc, 25)
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d)", len(s.titles))
+				cmd := r.m.SetItems(s.items())
+				if s.state != Unfiltered {
+					s.visible = nil
+					s.updPag(0)
+					s.updKeys()
+					r.feed(cmd)
+				} else {
+					s.visible = s.all()
+					s.updPag(len(s.visible))
+					s.updKeys()
+				}
+			case "setitem":
+				if len(s.titles) == 0 {
+					break
+				}
+				i := zootest.N(tc, 0, len(s.titles)-1)
+				s.titles[i] = genTitle(tc, i)
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d)", i)
+				cmd := r.m.SetItem(i, zitem{s.titles[i]})
+				s.updPag(len(s.visible))
+				r.feed(cmd)
+			case "insert":
+				i := zootest.N(tc, -1, len(s.titles)+1)
+				title := genTitle(tc, 90+step%10)
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d)", i)
+				cmd := r.m.InsertItem(i, zitem{title})
+				at := clampInt(i, 0, len(s.titles))
+				s.titles = append(s.titles[:at], append([]string{title}, s.titles[at:]...)...)
+				if s.state == Unfiltered {
+					s.visible = s.all()
+				}
+				s.updPag(len(s.visible))
+				s.updKeys()
+				r.feed(cmd)
+			case "remove":
+				if len(s.titles) == 0 {
+					break
+				}
+				i := zootest.N(tc, -1, len(s.titles))
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d)", i)
+				if i < 0 {
+					// bubbles/51: a negative index panics though "out of bounds is a no-op".
+					if panicked(func() { r.m.RemoveItem(i) }) {
+						zootest.Count("bubbles/51")
+						return
+					}
+					zootest.Fail(ht, "%s: RemoveItem(-1) did not panic", trace())
+					return
+				}
+				r.m.RemoveItem(i)
+				if i < len(s.titles) {
+					s.titles = append(s.titles[:i], s.titles[i+1:]...)
+				}
+				if s.state == Unfiltered {
+					s.visible = s.all()
+					s.updPag(len(s.visible))
+				} else {
+					var keep []int
+					for _, v := range s.visible {
+						if v < i {
+							keep = append(keep, v)
+						} else if v > i {
+							keep = append(keep, v-1)
+						}
+					}
+					s.visible = keep
+					s.staleIdx = true
+					if len(keep) == 0 {
+						s.reset()
+					} else {
+						s.updPag(len(s.visible))
+					}
+					// bubbles/50: the library removes filteredItems[i] instead (and
+					// resets the filter when that empties its slice).
+					if !r.sameVisible() || r.m.FilterState() != s.state {
+						zootest.Count("bubbles/50")
+						return
+					}
+				}
+			case "setsize":
+				s.w, s.h = zootest.N(tc, 20, 60), zootest.N(tc, 12, 30)
+				r.log[len(r.log)-1] += fmt.Sprintf("(%d,%d)", s.w, s.h)
+				r.m.SetSize(s.w, s.h)
+				s.updPag(len(s.visible))
+				s.updKeys()
+			case "toggle":
+				which := zootest.Pick(tc, []string{"title", "status", "pag", "help"})
+				r.log[len(r.log)-1] += "(" + which + ")"
+				switch which {
+				case "title":
+					s.showTitle = !s.showTitle
+					r.m.SetShowTitle(s.showTitle)
+				case "status":
+					s.showStatus = !s.showStatus
+					r.m.SetShowStatusBar(s.showStatus)
+				case "pag":
+					s.showPag = !s.showPag
+					r.m.SetShowPagination(s.showPag)
+				case "help":
+					s.showHelp = !s.showHelp
+					r.m.SetShowHelp(s.showHelp)
+				}
+				s.updPag(len(s.visible))
+			case "filtertext":
+				s.text = genTerm(tc)
+				if zootest.Chance(tc, 10) {
+					s.text = ""
+				}
+				r.log[len(r.log)-1] += "(" + s.text + ")"
+				r.m.SetFilterText(s.text)
+				s.state = FilterApplied
+				s.visible = s.filtered()
+				s.staleIdx = false
+				s.sel = 0
+				s.updPag(len(s.visible))
+				s.updKeys()
+			case "resetfilter":
+				r.m.ResetFilter()
+				s.reset()
+			case "method":
+				which := zootest.Pick(tc, []string{"start", "end", "next", "prev"})
+				r.log[len(r.log)-1] += "(" + which + ")"
+				n := len(s.visible)
+				page := s.sel / s.pp
+				switch which {
+				case "start":
+					r.m.GoToStart()
+					s.sel = 0
+				case "end":
+					r.m.GoToEnd()
+					s.sel = (s.pages-1)*s.pp + max(0, clampInt(n-(s.pages-1)*s.pp, 0, s.pp)-1)
+				case "next":
+					r.m.NextPage()
+					if page < s.pages-1 {
+						s.sel += s.pp
+					}
+					s.clampCursor()
+				case "prev":
+					r.m.PrevPage()
+					if page > 0 {
+						s.sel -= s.pp
+					}
+					s.clampCursor()
+				}
+			case "infinite":
+				s.infinite = !s.infinite
+				r.m.InfiniteScrolling = s.infinite
+			}
+			r.log[len(r.log)-1] += fmt.Sprintf("→%d/%d", s.sel, len(s.visible))
+			if msg := r.check(); msg != "" {
+				if strings.HasPrefix(msg, "bubbles/") {
+					zootest.Count(msg)
+					return
+				}
+				zootest.Fail(ht, "%s: %s", trace(), msg)
+				return
+			}
+		}
+	})
+}
+
+func (r *run) sameVisible() bool {
+	got := r.m.VisibleItems()
+	if len(got) != len(r.s.visible) {
+		return false
+	}
+	for i, v := range r.s.visible {
+		if got[i].(zitem).title != r.s.titles[v] {
+			return false
+		}
+	}
+	return true
+}
+
+// check compares the library with the model after a step; it returns "" when
+// they agree, a bug id for a modelled bug that ends the case, or a message.
+func (r *run) check() string {
+	m, s := r.m, r.s
+	if m.FilterState() != s.state || m.FilterValue() != s.text {
+		return fmt.Sprintf("state %v %q, want %v %q", m.FilterState(), m.FilterValue(), s.state, s.text)
+	}
+	if len(m.Items()) != len(s.titles) {
+		return fmt.Sprintf("%d items, want %d", len(m.Items()), len(s.titles))
+	}
+	if m.Paginator.PerPage != s.pp {
+		return fmt.Sprintf("PerPage %d, want %d (height %d, chrome %d)", m.Paginator.PerPage, s.pp, s.h, s.chrome())
+	}
+	if !r.sameVisible() {
+		var got []string
+		for _, it := range m.VisibleItems() {
+			got = append(got, it.(zitem).title)
+		}
+		var want []string
+		for _, v := range s.visible {
+			want = append(want, s.titles[v])
+		}
+		return fmt.Sprintf("VisibleItems %q, want %q", got, want)
+	}
+	if s.state == FilterApplied && s.pages != s.truePages() {
+		// bubbles/52: FilterMatchesMsg does not update the pagination.
+		if m.Paginator.TotalPages == s.pages {
+			return "bubbles/52"
+		}
+		return fmt.Sprintf("TotalPages %d after the matches, model %d, want %d", m.Paginator.TotalPages, s.pages, s.truePages())
+	}
+	if m.Paginator.TotalPages != s.pages {
+		return fmt.Sprintf("TotalPages %d, want %d", m.Paginator.TotalPages, s.pages)
+	}
+	if m.Index() != s.sel || m.Paginator.Page != s.sel/s.pp || m.Cursor() != s.sel%s.pp {
+		return fmt.Sprintf("Index %d (page %d, cursor %d), want %d (page %d, cursor %d)", m.Index(), m.Paginator.Page, m.Cursor(), s.sel, s.sel/s.pp, s.sel%s.pp)
+	}
+	if len(s.visible) > 0 && s.sel >= len(s.visible) {
+		// bubbles/53: a setter leaves the cursor past the end until the next message.
+		if m.SelectedItem() == nil {
+			return "bubbles/53"
+		}
+		return fmt.Sprintf("SelectedItem %v with Index %d of %d", m.SelectedItem(), s.sel, len(s.visible))
+	}
+	if len(s.visible) == 0 {
+		if m.SelectedItem() != nil {
+			return fmt.Sprintf("SelectedItem %v with nothing visible", m.SelectedItem())
+		}
+	} else {
+		want := s.titles[s.visible[s.sel]]
+		if got := m.SelectedItem(); got == nil || got.(zitem).title != want {
+			return fmt.Sprintf("SelectedItem %v, want %q", got, want)
+		}
+		if gi := m.GlobalIndex(); gi != s.visible[s.sel] {
+			if s.state != Unfiltered && s.text == "" && gi == 0 {
+				// bubbles/49: an empty filter's items all carry index 0.
+				zootest.Count("bubbles/49")
+			} else if s.staleIdx {
+				// bubbles/50: RemoveItem under a filter leaves the later matches' indices stale.
+				return "bubbles/50"
+			} else {
+				return fmt.Sprintf("GlobalIndex %d, want %d", gi, s.visible[s.sel])
+			}
+		}
+	}
+	return r.checkView()
+}
+
+func (r *run) checkView() string {
+	m, s := r.m, r.s
+	lines := strings.Split(m.View(), "\n")
+	if len(lines) != s.h {
+		return fmt.Sprintf("View has %d lines, want %d", len(lines), s.h)
+	}
+	// widths: the item lines are cut to the width; the chrome may overflow (bubbles/55)
+	bottom := 0
+	if s.showPag {
+		bottom++
+	}
+	if s.showHelp {
+		bottom += 2
+	}
+	for i, l := range lines {
+		if wd := zootest.Width(zootest.Cells(strings.TrimRight(l, " "))); wd > s.w {
+			if i < s.chrome()-bottom || i >= s.h-bottom {
+				zootest.Count("bubbles/55")
+				continue
+			}
+			return fmt.Sprintf("line %d is %d cells wide in a width of %d: %q", i, wd, s.w, plainLine(l))
+		}
+	}
+	li := 0
+	if s.state == Filtering {
+		if !strings.HasPrefix(plainLine(lines[0]), "  Filter:") {
+			return fmt.Sprintf("title line %q while filtering", plainLine(lines[0]))
+		}
+		li = 2
+	} else if s.showTitle {
+		if got := plainLine(lines[0]); got != "   List" {
+			return fmt.Sprintf("title line %q", got)
+		}
+		li = 2
+	} else {
+		li = 1
+	}
+	if s.showStatus {
+		if got, want := plainLine(lines[li]), "  "+r.status(); got != want {
+			return fmt.Sprintf("status line %q, want %q", got, want)
+		}
+		li += 2
+	}
+	n := len(s.visible)
+	page := s.sel / s.pp
+	switch {
+	case n == 0 && s.state == Filtering:
+		if got := plainLine(lines[li]); got != "" {
+			return fmt.Sprintf("content %q while filtering to nothing", got)
+		}
+	case n == 0:
+		if got := plainLine(lines[li]); got != "No items." {
+			return fmt.Sprintf("content %q with no items, want %q", got, "No items.")
+		}
+	default:
+		for k := page * s.pp; k < min(n, (page+1)*s.pp); k++ {
+			mark := "  "
+			if k == s.sel && s.state != Filtering {
+				mark = "│ "
+			}
+			at := li + (k-page*s.pp)*(s.itemH+1)
+			if got, want := plainLine(lines[at]), mark+s.titles[s.visible[k]]; got != want {
+				return fmt.Sprintf("item line %d %q, want %q", at, got, want)
+			}
+			if s.itemH == 2 {
+				if got, want := plainLine(lines[at+1]), mark+"desc"; got != want {
+					return fmt.Sprintf("desc line %d %q, want %q", at+1, got, want)
+				}
+			}
+		}
+	}
+	if s.showPag {
+		pl := s.h - 1
+		if s.showHelp {
+			pl -= 2
+		}
+		got := plainLine(lines[pl])
+		switch {
+		case s.pages < 2:
+			if got != "" {
+				return fmt.Sprintf("pagination %q with one page", got)
+			}
+		case s.pages <= s.w: // the switch to Arabic ignores the two-cell padding (bubbles/55)
+			if got != "  "+strings.Repeat("•", s.pages) {
+				return fmt.Sprintf("pagination %q, want %d dots", got, s.pages)
+			}
+		default:
+			if want := fmt.Sprintf("  %d/%d", page+1, s.pages); got != want {
+				return fmt.Sprintf("pagination %q, want %q", got, want)
+			}
+		}
+	}
+	return ""
+}
+
+func (r *run) status() string {
+	s := r.s
+	n := len(s.visible)
+	name := "items"
+	if n == 1 {
+		name = "item"
+	}
+	var b string
+	switch {
+	case s.state == Filtering && n == 0:
+		b = "Nothing matched"
+	case s.state == Filtering:
+		b = fmt.Sprintf("%d %s", n, name)
+	case len(s.titles) == 0:
+		b = "No items"
+	default:
+		if s.state == FilterApplied {
+			b = fmt.Sprintf("“%s” ", s.text)
+		}
+		b += fmt.Sprintf("%d %s", n, name)
+	}
+	if k := len(s.titles) - n; k > 0 {
+		b += fmt.Sprintf(" • %d filtered", k)
+	}
+	return b
+}
+
+func panicked(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+func pinItems(n int) []Item {
+	its := make([]Item, n)
+	for i := range its {
+		its[i] = zitem{fmt.Sprintf("item %02d", i)}
+	}
+	return its
+}
+
+func pinList(n int) Model {
+	m := New(pinItems(n), NewDefaultDelegate(), 40, 14)
+	m.FilterInput.SetVirtualCursor(false)
+	m.SetSize(40, 14)
+	return m
+}
+
+func runCmd(m Model, cmd tea.Cmd) Model {
+	if cmd == nil {
+		return m
+	}
+	switch v := cmd().(type) {
+	case tea.BatchMsg:
+		for _, c := range v {
+			m = runCmd(m, c)
+		}
+	case FilterMatchesMsg:
+		m, _ = m.Update(v)
+	}
+	return m
+}
+
+func widest(view string) int {
+	w := 0
+	for _, l := range strings.Split(view, "\n") {
+		w = max(w, zootest.Width(zootest.Cells(strings.TrimRight(l, " "))))
+	}
+	return w
+}
+
+// bubbles/49: with an empty filter the visible items all carry index 0, so
+// GlobalIndex is 0 for every selection.
+func TestHegelPinListGlobalIndexOfAnEmptyFilter(t *testing.T) {
+	m := pinList(6)
+	m.SetFilterText("")
+	m.CursorDown()
+	m.CursorDown()
+	if m.Index() != 2 || m.GlobalIndex() != 2 {
+		t.Fatalf("after SetFilterText(\"\") and two moves: Index %d, GlobalIndex %d, SelectedItem %v", m.Index(), m.GlobalIndex(), m.SelectedItem())
+	}
+}
+
+// bubbles/50: RemoveItem under a filter removes filteredItems[index] rather
+// than the match for the item, so the removed item stays visible and the
+// global indices of the matches after it are stale.
+func TestHegelPinListRemoveItemUnderAFilter(t *testing.T) {
+	m := pinList(6)
+	m.SetFilterText("05")
+	m.RemoveItem(5)
+	if len(m.Items()) != 5 || len(m.VisibleItems()) != 0 {
+		t.Fatalf("after RemoveItem(5) with the filter matching item 05: %d items, visible %v", len(m.Items()), m.VisibleItems())
+	}
+}
+
+// bubbles/51: RemoveItem with a negative index panics, though the doc says an
+// index out of bounds is a no-op.
+func TestHegelPinListRemoveItemNegativePanics(t *testing.T) {
+	m := pinList(3)
+	if panicked(func() { m.RemoveItem(-1) }) {
+		t.Fatalf("RemoveItem(-1) panicked")
+	}
+}
+
+// bubbles/52: the FilterMatchesMsg handler does not update the pagination,
+// so after SetItems under a filter the page count is stale: one page for
+// twelve matches, and the cursor cannot leave it.
+func TestHegelPinListSetItemsUnderAFilterStallsThePages(t *testing.T) {
+	m := pinList(3)
+	m.SetFilterText("item")
+	m = runCmd(m, m.SetItems(pinItems(12)))
+	for range 11 {
+		m.CursorDown()
+	}
+	if m.Paginator.TotalPages != 6 || m.Index() != 11 {
+		t.Fatalf("12 matches, PerPage %d: TotalPages %d, Index after eleven moves down %d", m.Paginator.PerPage, m.Paginator.TotalPages, m.Index())
+	}
+}
+
+// bubbles/56: the key bindings fall out of step with the items and pages:
+// RemoveItem and the section toggles update the pagination but not the
+// bindings, so after the last item is removed "/" still opens the filter;
+// cancelling a filter re-enables "/" on an empty list; accepting one refreshes
+// the bindings before the pagination.
+func TestHegelPinListRemoveItemKeepsTheBindings(t *testing.T) {
+	m := pinList(1)
+	m.RemoveItem(0)
+	m, _ = m.Update(typed('/'))
+	if m.FilterState() != Unfiltered {
+		t.Fatalf("\"/\" on an emptied list: FilterState %v", m.FilterState())
+	}
+}
+
+// bubbles/53: SetItems leaves the cursor where it was on the (clamped) page,
+// past the end of a shorter list, so SelectedItem is nil and no item is
+// marked until the next message clamps it.
+func TestHegelPinListSetItemsLeavesTheCursorPastTheEnd(t *testing.T) {
+	m := pinList(20)
+	m.Select(15)
+	m.SetItems(pinItems(1))
+	if m.SelectedItem() == nil || m.Index() != 0 {
+		t.Fatalf("after Select(15), SetItems(1): Index %d, SelectedItem %v", m.Index(), m.SelectedItem())
+	}
+}
+
+// bubbles/54: New does not size the help or the filter input (only SetSize
+// does), so the help line runs past the width and widens every line.
+func TestHegelPinListNewDoesNotSizeTheHelp(t *testing.T) {
+	m := New(pinItems(30), NewDefaultDelegate(), 20, 14)
+	if w := widest(m.View()); w > 20 {
+		t.Fatalf("a list of width 20 from New renders %d cells wide", w)
+	}
+}
+
+// bubbles/55: the chrome is not fitted to the width: the status bar is never
+// truncated, the help is truncated to the width before its two-cell padding
+// and the title bar to width−1 before its own, so the view is wider than the
+// width and every line is padded to it.
+func TestHegelPinListChromeOverflowsTheWidth(t *testing.T) {
+	m := pinList(30)
+	m.SetSize(20, 14)
+	if w := widest(m.View()); w > 20 {
+		t.Fatalf("a list of width 20 renders %d cells wide: %q", w, plainLine(strings.Split(m.View(), "\n")[13]))
+	}
+}
diff --git a/paginator/hegel_test.go b/paginator/hegel_test.go
new file mode 100644
index 0000000..c6509aa
--- /dev/null
+++ b/paginator/hegel_test.go
@@ -0,0 +1,156 @@
+package paginator
+
+// Hegel properties for the paginator: a model of pages over a slice, driven
+// through the default key bindings and the helpers, checked against the
+// slice bounds, the first/last flags and the rendered view.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+)
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+func pagesFor(items, per int) int {
+	n := items / per
+	if items%per > 0 {
+		n++
+	}
+	return n
+}
+
+// TestHegelPaginatorFollowsTheModel: pages = ceil(items / PerPage), Page
+// moves by one within [0, pages-1] on the default bindings and the
+// helpers, GetSliceBounds/ItemsOnPage describe Page's slice of the items,
+// and View shows Page under both display types.
+func TestHegelPaginatorFollowsTheModel(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		per := zootest.N(tc, 1, 5)
+		items := zootest.N(tc, 1, 40)
+		p := New(WithPerPage(per))
+		if zootest.Chance(tc, 50) {
+			p.Type = Dots
+		}
+		if zootest.Chance(tc, 20) {
+			p.ActiveDot, p.InactiveDot = "*", "-"
+		}
+		if zootest.Chance(tc, 20) {
+			p.ArabicFormat = "page %d of %d"
+		}
+		if got := p.SetTotalPages(items); got != pagesFor(items, per) {
+			zootest.Fail(ht, "SetTotalPages(%d) with PerPage %d returned %d, want %d", items, per, got, pagesFor(items, per))
+			return
+		}
+		page, pages := 0, pagesFor(items, per)
+		var log []string
+		steps := zootest.N(tc, 1, 30)
+		for step := 0; step < steps; step++ {
+			op := zootest.Pick(tc, []string{"next", "prev", "right", "left", "l", "h", "pgdown", "pgup", "items", "other"})
+			log = append(log, op)
+			switch op {
+			case "next":
+				p.NextPage()
+				page = min(page+1, pages-1)
+			case "prev":
+				p.PrevPage()
+				page = max(page-1, 0)
+			case "right", "l", "pgdown":
+				p, _ = p.Update(map[string]tea.KeyPressMsg{"right": keyOf(tea.KeyRight), "l": typed('l'), "pgdown": keyOf(tea.KeyPgDown)}[op])
+				page = min(page+1, pages-1)
+			case "left", "h", "pgup":
+				p, _ = p.Update(map[string]tea.KeyPressMsg{"left": keyOf(tea.KeyLeft), "h": typed('h'), "pgup": keyOf(tea.KeyPgUp)}[op])
+				page = max(page-1, 0)
+			case "items":
+				items = zootest.N(tc, 0, 40)
+				log[len(log)-1] += fmt.Sprintf("(%d)", items)
+				if items < 1 {
+					// bubbles/41: SetTotalPages(0) keeps the previous count.
+					p.SetTotalPages(items)
+					if p.TotalPages != 0 {
+						zootest.Count("bubbles/41")
+						return
+					}
+					zootest.Fail(ht, "SetTotalPages(0) gave %d pages", p.TotalPages)
+					return
+				}
+				pages = pagesFor(items, per)
+				if got := p.SetTotalPages(items); got != pages {
+					zootest.Fail(ht, "%s: SetTotalPages(%d) returned %d, want %d", strings.Join(log, ","), items, got, pages)
+					return
+				}
+				if page > pages-1 {
+					// bubbles/40: the page is not clamped when the total shrinks.
+					if p.Page == page {
+						zootest.Count("bubbles/40")
+						return
+					}
+					page = pages - 1
+				}
+			case "other":
+				p, _ = p.Update(typed('x'))
+			}
+			if p.Page != page || p.TotalPages != pages {
+				zootest.Fail(ht, "%s: Page %d of %d, want %d of %d", strings.Join(log, ","), p.Page, p.TotalPages, page, pages)
+				return
+			}
+			if p.OnFirstPage() != (page == 0) || p.OnLastPage() != (page == pages-1) {
+				zootest.Fail(ht, "%s: OnFirstPage %v OnLastPage %v at page %d of %d", strings.Join(log, ","), p.OnFirstPage(), p.OnLastPage(), page, pages)
+				return
+			}
+			start, end := p.GetSliceBounds(items)
+			if start != page*per || end != min(page*per+per, items) || p.ItemsOnPage(items) != end-start {
+				zootest.Fail(ht, "%s: bounds (%d,%d), ItemsOnPage %d for page %d of %d items, PerPage %d", strings.Join(log, ","), start, end, p.ItemsOnPage(items), page, items, per)
+				return
+			}
+			var want string
+			if p.Type == Dots {
+				want = strings.Repeat(p.InactiveDot, page) + p.ActiveDot + strings.Repeat(p.InactiveDot, pages-page-1)
+			} else {
+				want = fmt.Sprintf(p.ArabicFormat, page+1, pages)
+			}
+			if got := p.View(); got != want {
+				zootest.Fail(ht, "%s: View %q, want %q", strings.Join(log, ","), got, want)
+				return
+			}
+		}
+	})
+}
+
+// bubbles/40: SetTotalPages never clamps Page; once the page count shrinks
+// below it, OnLastPage is false and NextPage keeps counting up, and
+// GetSliceBounds returns a start past the end.
+func TestHegelPinPaginatorPageOutlivesTheTotal(t *testing.T) {
+	p := New(WithPerPage(3))
+	p.SetTotalPages(30)
+	for range 9 {
+		p.NextPage()
+	}
+	if p.Page != 9 || !p.OnLastPage() {
+		t.Fatalf("page %d of %d, OnLastPage %v", p.Page, p.TotalPages, p.OnLastPage())
+	}
+	p.SetTotalPages(6)
+	p.NextPage()
+	start, end := p.GetSliceBounds(6)
+	if p.Page > 1 || start > end {
+		t.Fatalf("after SetTotalPages(6): Page %d of %d, OnLastPage %v, bounds (%d,%d), ItemsOnPage %d, View %q", p.Page, p.TotalPages, p.OnLastPage(), start, end, p.ItemsOnPage(6), p.View())
+	}
+}
+
+// bubbles/41: SetTotalPages(0) leaves the previous count in place, so an
+// emptied list still shows its old pages.
+func TestHegelPinPaginatorZeroItemsKeepTheOldTotal(t *testing.T) {
+	p := New(WithPerPage(3))
+	p.SetTotalPages(30)
+	p.SetTotalPages(0)
+	if p.TotalPages != 0 {
+		t.Fatalf("after SetTotalPages(0): TotalPages %d, View %q", p.TotalPages, p.View())
+	}
+}
diff --git a/progress/hegel_test.go b/progress/hegel_test.go
new file mode 100644
index 0000000..cf756ab
--- /dev/null
+++ b/progress/hegel_test.go
@@ -0,0 +1,496 @@
+package progress
+
+// Hegel properties for the progress bar: ViewAs checked cell by cell (text
+// and colours) against a model of the options, and the spring animation
+// driven frame by frame to equilibrium.
+
+import (
+	"fmt"
+	"image/color"
+	"math"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var palette = []color.Color{
+	lipgloss.Color("#FF0000"), lipgloss.Color("#00FF00"), lipgloss.Color("#0000FF"),
+	lipgloss.Color("#5A56E0"), lipgloss.Color("#EE6FF8"), lipgloss.Color("#000000"),
+	lipgloss.Color("#FFFFFF"), lipgloss.Color("#123456"), lipgloss.Color("#7571F9"),
+}
+
+func rgb(c color.Color) string {
+	if c == nil {
+		return ""
+	}
+	r, g, b, _ := c.RGBA()
+	return fmt.Sprintf("%d;%d;%d", r>>8, g>>8, b>>8)
+}
+
+// rgbShift encodes a colour the way x/ansi does (lipgloss/28): a 16-bit
+// channel of 0xff or below is emitted as is instead of divided by 256, so
+// a blend step next to black renders a spike in that channel.
+func rgbShift(c color.Color) string {
+	if c == nil {
+		return ""
+	}
+	sh := func(v uint32) uint32 {
+		if v > 0xff {
+			return v >> 8
+		}
+		return v
+	}
+	r, g, b, _ := c.RGBA()
+	return fmt.Sprintf("%d;%d;%d", sh(r), sh(g), sh(b))
+}
+
+// zcell is one rune of a rendered bar with its foreground and background
+// (true-colour SGR triples, "" when unset).
+type zcell struct{ s, fg, bg string }
+
+func sgrCells(s string) []zcell {
+	var out []zcell
+	fg, bg := "", ""
+	for i := 0; i < len(s); {
+		if s[i] == 0x1b && i+1 < len(s) && s[i+1] == '[' {
+			j := i + 2
+			for j < len(s) && !(s[j] >= 0x40 && s[j] <= 0x7e) {
+				j++
+			}
+			if j < len(s) && s[j] == 'm' {
+				params := s[i+2 : j]
+				if params == "" {
+					fg, bg = "", ""
+				}
+				ps := strings.Split(params, ";")
+				for k := 0; k < len(ps); k++ {
+					switch ps[k] {
+					case "0":
+						fg, bg = "", ""
+					case "39":
+						fg = ""
+					case "49":
+						bg = ""
+					case "38", "48":
+						if k+4 < len(ps) && ps[k+1] == "2" {
+							v := strings.Join(ps[k+2:k+5], ";")
+							if ps[k] == "38" {
+								fg = v
+							} else {
+								bg = v
+							}
+							k += 4
+						}
+					}
+				}
+			}
+			i = j + 1
+			continue
+		}
+		r, n := utf8.DecodeRuneInString(s[i:])
+		out = append(out, zcell{string(r), fg, bg})
+		i += n
+	}
+	return out
+}
+
+func clamp01(p float64) float64 { return math.Max(0, math.Min(1, p)) }
+
+// barModel is the documented state of a bar: what the options say the
+// colours, characters and text should be.
+type barModel struct {
+	width     int
+	full      rune
+	empty     rune
+	fullColor color.Color
+	emptyCol  color.Color
+	showPct   bool
+	format    string
+	blend     []color.Color
+	fn        func(cur float64) color.Color
+	scaled    bool
+}
+
+func (b barModel) view(p float64, rgb func(color.Color) string) (cells []zcell, textW int) {
+	text := ""
+	if b.showPct {
+		text = fmt.Sprintf(b.format, clamp01(p)*100)
+	}
+	textW = ansi.StringWidth(text)
+	tw := max(0, b.width-textW)
+	fw := int(math.Round(float64(tw) * clamp01(p)))
+	fw = max(0, min(tw, fw))
+	half := b.full == DefaultFullCharHalfBlock
+	var blend []color.Color
+	if b.fn == nil && len(b.blend) > 0 {
+		n := tw
+		if b.scaled {
+			n = fw
+		}
+		if half {
+			n *= 2
+		}
+		blend = lipgloss.Blend1D(n, b.blend...)
+	}
+	for i := 0; i < fw; i++ {
+		c := zcell{s: string(b.full)}
+		switch {
+		case b.fn != nil:
+			c.fg = rgb(b.fn(float64(i) / float64(tw)))
+			if half {
+				c.bg = rgb(b.fn(min(float64(i)/float64(tw)+0.5/float64(tw), 1)))
+			}
+		case len(b.blend) > 0:
+			if half {
+				c.fg, c.bg = rgb(blend[2*i]), rgb(blend[2*i+1])
+			} else {
+				c.fg = rgb(blend[i])
+			}
+		default:
+			c.fg = rgb(b.fullColor)
+		}
+		cells = append(cells, c)
+	}
+	for i := fw; i < tw; i++ {
+		cells = append(cells, zcell{s: string(b.empty), fg: rgb(b.emptyCol)})
+	}
+	for _, r := range text {
+		cells = append(cells, zcell{s: string(r)})
+	}
+	return cells, textW
+}
+
+func runeWidth(r rune) int { return uniseg.StringWidth(string(r)) }
+
+func fmtCells(cs []zcell) string {
+	var sb strings.Builder
+	for _, c := range cs {
+		fmt.Fprintf(&sb, "%s(%s/%s) ", c.s, c.fg, c.bg)
+	}
+	return sb.String()
+}
+
+// TestHegelProgressDrawsTheModel: ViewAs is round(tw·p) full runes, tw−fw
+// empty runes and the percentage text, tw = Width − text width; the full
+// runes carry the solid colour, the blend (over the bar or, scaled, over the
+// filled part; two stops per half block) or the colour function's colours at
+// i/tw (and i/tw + 1/2tw for the half block's background), the empty runes
+// the empty colour; the options compose as documented in whatever order.
+func TestHegelProgressDrawsTheModel(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		model := barModel{width: defaultWidth, full: DefaultFullCharHalfBlock, empty: DefaultEmptyCharBlock,
+			fullColor: defaultFullColor, emptyCol: defaultEmptyColor, showPct: true, format: " %3.0f%%"}
+		var opts []Option
+		var log []string
+		fnColor := func(cur float64) color.Color { return palette[int(cur*float64(len(palette)))%len(palette)] }
+		var totals []float64
+		for range zootest.N(tc, 0, 5) {
+			switch op := zootest.Pick(tc, []string{"colors0", "colors1", "colors2", "colors3", "defaultblend", "colorfunc", "scaled", "chars", "nopct", "width"}); op {
+			case "colors0":
+				opts = append(opts, WithColors())
+				model.fullColor, model.blend, model.fn = defaultFullColor, nil, nil
+				log = append(log, op)
+			case "colors1":
+				c := zootest.Pick(tc, palette)
+				opts = append(opts, WithColors(c))
+				model.fullColor, model.blend, model.fn = c, nil, nil
+				log = append(log, op+"("+rgb(c)+")")
+			case "colors2", "colors3":
+				n := 2
+				if op == "colors3" {
+					n = 3
+				}
+				var cs []color.Color
+				for range n {
+					cs = append(cs, zootest.Pick(tc, palette))
+				}
+				opts = append(opts, WithColors(cs...))
+				model.blend, model.fn = cs, nil
+				log = append(log, fmt.Sprintf("%s(%s)", op, rgbs(cs)))
+			case "defaultblend":
+				opts = append(opts, WithDefaultBlend())
+				model.blend, model.fn = []color.Color{defaultBlendStart, defaultBlendEnd}, nil
+				log = append(log, op)
+			case "colorfunc":
+				opts = append(opts, WithColorFunc(func(total, cur float64) color.Color {
+					totals = append(totals, total)
+					return fnColor(cur)
+				}))
+				model.fn, model.blend = fnColor, nil
+				log = append(log, op)
+			case "scaled":
+				v := zootest.Chance(tc, 70)
+				opts = append(opts, WithScaled(v))
+				model.scaled = v
+				log = append(log, fmt.Sprintf("scaled(%v)", v))
+			case "chars":
+				f := zootest.Pick(tc, []rune{DefaultFullCharHalfBlock, DefaultFullCharFullBlock, '#', '=', '全'})
+				e := zootest.Pick(tc, []rune{DefaultEmptyCharBlock, ' ', '-', '.', '　'})
+				opts = append(opts, WithFillCharacters(f, e))
+				model.full, model.empty = f, e
+				log = append(log, fmt.Sprintf("chars(%c,%c)", f, e))
+			case "nopct":
+				opts = append(opts, WithoutPercentage())
+				model.showPct = false
+				log = append(log, op)
+			case "width":
+				w := zootest.N(tc, 0, 60)
+				opts = append(opts, WithWidth(w))
+				model.width = w
+				log = append(log, fmt.Sprintf("width(%d)", w))
+			}
+		}
+		m := New(opts...)
+		if zootest.Chance(tc, 50) {
+			model.width = zootest.N(tc, 0, 60)
+			m.SetWidth(model.width)
+			log = append(log, fmt.Sprintf("SetWidth(%d)", model.width))
+		}
+		if zootest.Chance(tc, 20) {
+			model.format = zootest.Pick(tc, []string{" %.1f%%", "%3.0f", " [%5.1f%%]", ""})
+			m.PercentFormat = model.format
+			log = append(log, fmt.Sprintf("PercentFormat(%q)", model.format))
+		}
+		if zootest.Chance(tc, 20) {
+			model.emptyCol = zootest.Pick(tc, palette)
+			m.EmptyColor = model.emptyCol
+			log = append(log, "EmptyColor("+rgb(model.emptyCol)+")")
+		}
+		if m.Width() != model.width {
+			zootest.Fail(ht, "%s: Width() %d, want %d", strings.Join(log, " "), m.Width(), model.width)
+			return
+		}
+		if m.colorFunc != nil && model.fn == nil {
+			// bubbles/60: WithColors with two or more colours keeps an
+			// earlier colour function.
+			zootest.Count("bubbles/60")
+			return
+		}
+		p := zootest.Pick(tc, []float64{0, 1, 0.5, -0.25, 1.25, 0.001, 0.999, 0.3333, 0.05, 0.95, 0.125})
+		if zootest.Chance(tc, 50) {
+			p = float64(zootest.N(tc, -100, 1100)) / 1000
+		}
+		totals = nil
+		got := m.ViewAs(p)
+		if model.fn != nil && p != clamp01(p) {
+			for _, tot := range totals {
+				if tot != clamp01(p) {
+					// bubbles/62: the colour function is told the unclamped percentage.
+					zootest.Count("bubbles/62")
+					return
+				}
+			}
+		}
+		want, textW := model.view(p, rgb)
+		cells := sgrCells(got)
+		if len(cells) != len(want) {
+			zootest.Fail(ht, "%s: ViewAs(%v) has %d runes, want %d\n got  %s\n want %s", strings.Join(log, " "), p, len(cells), len(want), fmtCells(cells), fmtCells(want))
+			return
+		}
+		for i := range cells {
+			if cells[i] != want[i] {
+				if alt, _ := model.view(p, rgbShift); cells[i] == alt[i] {
+					// lipgloss/28 (x/ansi's shift): a blend step with a
+					// 16-bit channel below 256 is emitted unshifted.
+					zootest.Count("lipgloss/28")
+					return
+				}
+				zootest.Fail(ht, "%s: ViewAs(%v) rune %d is %v, want %v\n got  %s\n want %s", strings.Join(log, " "), p, i, cells[i], want[i], fmtCells(cells), fmtCells(want))
+				return
+			}
+		}
+		if w := ansi.StringWidth(got); w != max(model.width, textW) {
+			if runeWidth(model.full) != 1 || runeWidth(model.empty) != 1 {
+				// bubbles/61: the fill counts runes, not cells.
+				zootest.Count("bubbles/61")
+				return
+			}
+			zootest.Fail(ht, "%s: ViewAs(%v) is %d wide, want %d (text %d)", strings.Join(log, " "), p, w, max(model.width, textW), textW)
+			return
+		}
+		if model.width < textW && model.showPct {
+			zootest.Count("text wider than the bar")
+		}
+	})
+}
+
+func rgbs(cs []color.Color) string {
+	var out []string
+	for _, c := range cs {
+		out = append(out, rgb(c))
+	}
+	return strings.Join(out, ",")
+}
+
+// settle runs the animation to equilibrium (or the frame cap), returning the
+// frames it took.
+func settle(m *Model, cap int) int {
+	frames := 0
+	for frames < cap && m.IsAnimating() {
+		*m, _ = m.Update(FrameMsg{id: m.id, tag: m.tag})
+		frames++
+	}
+	return frames
+}
+
+// TestHegelProgressSettles: SetPercent/IncrPercent/DecrPercent clamp the
+// target to [0, 1] and start an animation whose frames (a FrameMsg with the
+// bar's id and tag; others are ignored) move the shown percentage to within
+// 0.001 of the target with a settled velocity; View is ViewAs of the shown
+// percentage throughout.
+func TestHegelProgressSettles(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		freq := float64(zootest.N(tc, 1, 60))
+		damping := float64(zootest.N(tc, 1, 20)) / 10
+		m := New(WithSpringOptions(freq, damping), WithWidth(zootest.N(tc, 0, 40)))
+		target := 0.0
+		var log []string
+		for range zootest.N(tc, 1, 3) {
+			v := float64(zootest.N(tc, -500, 1500)) / 1000
+			var cmd tea.Cmd
+			switch op := zootest.Pick(tc, []string{"set", "incr", "decr"}); op {
+			case "set":
+				cmd = m.SetPercent(v)
+				target = clamp01(v)
+			case "incr":
+				cmd = m.IncrPercent(v)
+				target = clamp01(target + v)
+			case "decr":
+				cmd = m.DecrPercent(v)
+				target = clamp01(target - v)
+			}
+			log = append(log, fmt.Sprintf("%v", v))
+			if cmd == nil {
+				zootest.Fail(ht, "spring(%v,%v) %s: no command from the setter", freq, damping, strings.Join(log, ","))
+				return
+			}
+			if m.Percent() != target {
+				zootest.Fail(ht, "spring(%v,%v) %s: Percent() %v, want %v", freq, damping, strings.Join(log, ","), m.Percent(), target)
+				return
+			}
+			// a stale frame (previous tag) or another bar's frame is ignored
+			shown := m.percentShown
+			m2, cmd := m.Update(FrameMsg{id: m.id, tag: m.tag - 1})
+			m3, cmd3 := m.Update(FrameMsg{id: m.id + 1000, tag: m.tag})
+			m4, cmd4 := m.Update("other")
+			if m2.percentShown != shown || cmd != nil || m3.percentShown != shown || cmd3 != nil || m4.percentShown != shown || cmd4 != nil {
+				zootest.Fail(ht, "spring(%v,%v) %s: a stale or foreign message moved the bar", freq, damping, strings.Join(log, ","))
+				return
+			}
+			if zootest.Chance(tc, 50) {
+				settle(&m, zootest.N(tc, 1, 20))
+			}
+		}
+		frames := 0
+		for frames < 30000 && m.IsAnimating() {
+			var cmd tea.Cmd
+			m, cmd = m.Update(FrameMsg{id: m.id, tag: m.tag})
+			frames++
+			if cmd == nil && m.IsAnimating() {
+				zootest.Fail(ht, "spring(%v,%v) %s: frame %d returned no command while animating", freq, damping, strings.Join(log, ","), frames)
+				return
+			}
+			if frames%97 == 1 {
+				if v := m.View(); v != m.ViewAs(m.percentShown) {
+					zootest.Fail(ht, "spring(%v,%v) %s: View %q differs from ViewAs(%v)", freq, damping, strings.Join(log, ","), v, m.percentShown)
+					return
+				}
+			}
+		}
+		if m.IsAnimating() {
+			zootest.Fail(ht, "spring(%v,%v) %s: still animating after %d frames (shown %v, velocity %v)", freq, damping, strings.Join(log, ","), frames, m.percentShown, m.velocity)
+			return
+		}
+		if math.Abs(m.percentShown-target) >= 0.001 {
+			zootest.Fail(ht, "spring(%v,%v) %s: settled at %v, target %v", freq, damping, strings.Join(log, ","), m.percentShown, target)
+			return
+		}
+		if math.Abs(m.velocity) >= 0.01 {
+			// bubbles/59: IsAnimating compares the signed velocity with 0.01,
+			// so a bar moving down stops the moment it is near the target.
+			zootest.Count("bubbles/59")
+			return
+		}
+		m2, cmd := m.Update(FrameMsg{id: m.id, tag: m.tag})
+		if cmd != nil || m2.percentShown != m.percentShown {
+			zootest.Fail(ht, "spring(%v,%v) %s: a frame after equilibrium moved the bar", freq, damping, strings.Join(log, ","))
+			return
+		}
+	})
+}
+
+// bubbles/59: IsAnimating returns false once the distance is under 0.001
+// and the *signed* velocity is under 0.01, so a bar animating downward
+// stops dead the first time it passes near the target, however fast it is
+// moving, while the same spring animating upward bounces to rest.
+func TestHegelPinProgressStopsOnTheWayDown(t *testing.T) {
+	m := New(WithSpringOptions(18, 0.2))
+	m.SetPercent(1)
+	up := settle(&m, 10000)
+	m.SetPercent(0)
+	down := settle(&m, 10000)
+	if math.Abs(m.velocity) >= 0.01 || down*4 < up {
+		t.Fatalf("spring(18, 0.2): up settled in %d frames, down in %d frames at %v with velocity %v", up, down, m.percentShown, m.velocity)
+	}
+}
+
+// bubbles/60: WithColors with two or more colours sets the blend but does
+// not clear a colour function set before it (one colour does), so the
+// options depend on their order.
+func TestHegelPinProgressWithColorsKeepsTheColorFunc(t *testing.T) {
+	red, green := lipgloss.Color("#FF0000"), lipgloss.Color("#00FF00")
+	fn := func(_, _ float64) color.Color { return lipgloss.Color("#0000FF") }
+	a := New(WithWidth(6), WithoutPercentage(), WithColorFunc(fn), WithColors(red, green))
+	b := New(WithWidth(6), WithoutPercentage(), WithColors(red, green))
+	if a.ViewAs(1) != b.ViewAs(1) {
+		t.Fatalf("WithColorFunc then WithColors(red, green): %q\nWithColors(red, green) alone:          %q", a.ViewAs(1), b.ViewAs(1))
+	}
+}
+
+// bubbles/61: the bar counts runes, not cells, so wide fill characters
+// render twice the width.
+func TestHegelPinProgressWideRunesDoubleTheWidth(t *testing.T) {
+	m := New(WithWidth(10), WithFillCharacters('全', '　'), WithoutPercentage())
+	if w := ansi.StringWidth(m.ViewAs(0.5)); w != 10 {
+		t.Fatalf("width 10 with wide fill runes renders %d wide: %q", w, ansi.Strip(m.ViewAs(0.5)))
+	}
+}
+
+// bubbles/62: ViewAs passes its argument to the colour function unclamped,
+// so total can be 1.7 or -0.3 while the bar and the text are clamped.
+func TestHegelPinProgressColorFuncGetsTheUnclampedTotal(t *testing.T) {
+	var totals []float64
+	m := New(WithWidth(4), WithoutPercentage(), WithColorFunc(func(total, _ float64) color.Color {
+		totals = append(totals, total)
+		return lipgloss.Color("#FF0000")
+	}))
+	m.ViewAs(1.7)
+	for _, tot := range totals {
+		if tot != 1 {
+			t.Fatalf("ViewAs(1.7) called the colour function with total %v", tot)
+		}
+	}
+}
+
+// bubbles/63: SetPercent clamps with math.Max/math.Min, which pass NaN
+// through, so IncrPercent(NaN) leaves Percent() NaN and an animation that
+// never reaches equilibrium (a frame command every tick, for ever).
+func TestHegelPinProgressNaNAnimatesForever(t *testing.T) {
+	m := New()
+	m.IncrPercent(math.NaN())
+	frames := settle(&m, 1000)
+	if math.IsNaN(m.Percent()) || frames == 1000 {
+		t.Fatalf("after IncrPercent(NaN): Percent() %v, still animating after %d frames", m.Percent(), frames)
+	}
+}
diff --git a/table/hegel_test.go b/table/hegel_test.go
new file mode 100644
index 0000000..0ed3622
--- /dev/null
+++ b/table/hegel_test.go
@@ -0,0 +1,485 @@
+package table
+
+// Hegel properties for the table: a model of the rows and the cursor, driven
+// through every default binding and the setters, checked against the
+// selected row, the header, the rows shown in View() and the visibility of
+// the selection. The package is internal so the test reads m.start and the
+// viewport's offset to know which row the first body line is.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"hegel.dev/go/hegel"
+)
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+var tableKeys = map[string]tea.KeyPressMsg{
+	"up": keyOf(tea.KeyUp), "k": typed('k'), "down": keyOf(tea.KeyDown), "j": typed('j'),
+	"pgup": keyOf(tea.KeyPgUp), "b": typed('b'), "pgdown": keyOf(tea.KeyPgDown), "f": typed('f'), "space": keyOf(tea.KeySpace),
+	"u": typed('u'), "ctrl+u": tea.KeyPressMsg{Code: 'u', Mod: tea.ModCtrl}, "d": typed('d'), "ctrl+d": tea.KeyPressMsg{Code: 'd', Mod: tea.ModCtrl},
+	"home": keyOf(tea.KeyHome), "g": typed('g'), "end": keyOf(tea.KeyEnd), "G": typed('G'),
+}
+
+// plainStyles make the selection visible as reversed cells; the paddings are
+// the defaults.
+func plainStyles() Styles {
+	return Styles{
+		Selected: lipgloss.NewStyle().Reverse(true),
+		Header:   lipgloss.NewStyle().Padding(0, 1),
+		Cell:     lipgloss.NewStyle().Padding(0, 1),
+	}
+}
+
+func genText(tc hegel.TestCase, maxLen int) string {
+	n := zootest.N(tc, 0, maxLen)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		switch {
+		case zootest.Chance(tc, 12):
+			b.WriteString("日")
+		case zootest.Chance(tc, 15):
+			b.WriteByte(' ')
+		default:
+			b.WriteByte(byte('a' + zootest.N(tc, 0, 25)))
+		}
+	}
+	return b.String()
+}
+
+func genCols(tc hegel.TestCase, lo int) []Column {
+	cols := make([]Column, zootest.N(tc, lo, 4))
+	for i := range cols {
+		cols[i] = Column{Title: genText(tc, 8), Width: zootest.N(tc, 0, 7)}
+	}
+	return cols
+}
+
+func genRows(tc hegel.TestCase, ncols int, max int) []Row {
+	rows := make([]Row, zootest.N(tc, 0, max))
+	for i := range rows {
+		rows[i] = make(Row, ncols)
+		for j := range rows[i] {
+			rows[i][j] = genText(tc, 9)
+		}
+	}
+	return rows
+}
+
+// cellText is the text of one column cell: the value truncated to the
+// column's width with "…" and padded to it, between one space each side.
+func cellText(value string, width int) string {
+	cells := zootest.Cells(value)
+	var b strings.Builder
+	col := 0
+	if zootest.Width(cells) > width {
+		for _, c := range cells {
+			if col+c.W > width-1 {
+				break
+			}
+			b.WriteString(c.S)
+			col += c.W
+		}
+		b.WriteString("…")
+		col++
+	} else {
+		b.WriteString(value)
+		col = zootest.Width(cells)
+	}
+	b.WriteString(strings.Repeat(" ", width-col))
+	return " " + b.String() + " "
+}
+
+func rowText(cols []Column, r Row) string {
+	var b strings.Builder
+	for i, v := range r {
+		if i >= len(cols) || cols[i].Width <= 0 {
+			continue
+		}
+		b.WriteString(cellText(v, cols[i].Width))
+	}
+	return b.String()
+}
+
+func headerText(cols []Column) string {
+	var b strings.Builder
+	for _, c := range cols {
+		if c.Width <= 0 {
+			continue
+		}
+		b.WriteString(cellText(c.Title, c.Width))
+	}
+	return b.String()
+}
+
+// cut keeps the cells that fit in width columns, as the viewport does, and
+// drops trailing blanks.
+func cut(s string, width int) string {
+	var b strings.Builder
+	col := 0
+	for _, c := range zootest.Cells(s) {
+		if col+c.W > width {
+			break
+		}
+		b.WriteString(c.S)
+		col += c.W
+	}
+	return strings.TrimRight(b.String(), " ")
+}
+
+func ragged(cols []Column, rows []Row) bool {
+	for _, r := range rows {
+		if len(r) > len(cols) {
+			return true
+		}
+	}
+	return false
+}
+
+func clampInt(v, lo, hi int) int { return min(max(v, lo), hi) }
+
+// TestHegelTableShowsTheSelectedRow: the cursor follows the bindings and
+// the setters within [0, rows-1]; SelectedRow is the cursor's row; View is
+// the header over Height() lines of consecutive rows, each the row's cells
+// cut to the width; the cursor's row is shown, and it is the only reversed
+// line.
+func TestHegelTableShowsTheSelectedRow(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		cols := genCols(tc, 1)
+		rows := genRows(tc, len(cols), 30)
+		h := zootest.N(tc, 2, 9)
+		w := zootest.N(tc, 8, 50)
+		m := New(WithColumns(cols), WithRows(rows), WithHeight(h), WithWidth(w), WithFocused(true), WithStyles(plainStyles()))
+		cursor := 0
+		focus := true
+		hidden := "" // the bug that took the selection out of view, while it is
+		var log []string
+		trace := func() string { return strings.Join(log, ",") }
+		steps := zootest.N(tc, 1, 40)
+		for step := 0; step < steps; step++ {
+			op := zootest.Pick(tc, []string{"key", "key", "key", "moveup", "movedown", "setcursor", "setrows", "setcols", "setheight", "setwidth", "top", "bottom", "focus", "fromvalues"})
+			log = append(log, op)
+			n := 0
+			height := m.Height()
+			var do func()
+			switch op {
+			case "key":
+				k := zootest.Pick(tc, []string{"up", "k", "down", "j", "pgup", "b", "pgdown", "f", "space", "u", "ctrl+u", "d", "ctrl+d", "home", "g", "end", "G"})
+				log[len(log)-1] = k
+				do = func() { m, _ = m.Update(tableKeys[k]) }
+				if !focus {
+					break
+				}
+				switch k {
+				case "up", "k":
+					n = -1
+				case "down", "j":
+					n = 1
+				case "pgup", "b":
+					n = -height
+				case "pgdown", "f", "space":
+					n = height
+				case "u", "ctrl+u":
+					n = -height / 2
+				case "d", "ctrl+d":
+					n = height / 2
+				case "home", "g":
+					n = -cursor
+				case "end", "G":
+					n = len(rows)
+				}
+				if n <= 0 {
+					op = "moveup"
+				} else {
+					op = "movedown"
+				}
+				cursor = clampInt(cursor+n, 0, max(len(rows)-1, 0))
+			case "moveup":
+				n = zootest.N(tc, 0, 40)
+				log[len(log)-1] += fmt.Sprintf("(%d)", n)
+				do = func() { m.MoveUp(n) }
+				cursor = clampInt(cursor-n, 0, max(len(rows)-1, 0))
+			case "movedown":
+				n = zootest.N(tc, 0, 40)
+				log[len(log)-1] += fmt.Sprintf("(%d)", n)
+				do = func() { m.MoveDown(n) }
+				cursor = clampInt(cursor+n, 0, max(len(rows)-1, 0))
+			case "setcursor":
+				n = zootest.N(tc, -3, len(rows)+3)
+				log[len(log)-1] += fmt.Sprintf("(%d)", n)
+				do = func() { m.SetCursor(n) }
+				cursor = clampInt(n, 0, max(len(rows)-1, 0))
+			case "top":
+				do = func() { m.GotoTop() }
+				cursor = 0
+				op = "moveup"
+			case "bottom":
+				do = func() { m.GotoBottom() }
+				cursor = max(len(rows)-1, 0)
+				op = "movedown"
+			case "setrows":
+				rows = genRows(tc, len(cols), 30)
+				if zootest.Chance(tc, 8) && len(rows) > 0 {
+					rows[zootest.N(tc, 0, len(rows)-1)] = append(Row{}, append(rows[0], "x")...)
+				}
+				log[len(log)-1] += fmt.Sprintf("(%d)", len(rows))
+				r := rows
+				do = func() { m.SetRows(r) }
+				cursor = clampInt(cursor, 0, max(len(rows)-1, 0))
+			case "setcols":
+				lo := len(cols)
+				if zootest.Chance(tc, 10) {
+					lo = 1
+				}
+				cols = genCols(tc, min(lo, 4))
+				log[len(log)-1] += fmt.Sprintf("(%d)", len(cols))
+				c := cols
+				do = func() { m.SetColumns(c) }
+			case "setheight":
+				h = zootest.N(tc, 2, 9)
+				log[len(log)-1] += fmt.Sprintf("(%d)", h)
+				v := h
+				do = func() { m.SetHeight(v) }
+			case "setwidth":
+				w = zootest.N(tc, 8, 50)
+				log[len(log)-1] += fmt.Sprintf("(%d)", w)
+				v := w
+				do = func() { m.SetWidth(v) }
+			case "focus":
+				if focus {
+					do = func() { m.Blur() }
+				} else {
+					do = func() { m.Focus() }
+				}
+				focus = !focus
+			case "fromvalues":
+				rows = genRows(tc, len(cols), 12)
+				if zootest.Chance(tc, 8) && len(rows) > 0 {
+					rows[zootest.N(tc, 0, len(rows)-1)] = append(Row{}, append(rows[0], "x")...)
+				}
+				if len(rows) == 0 {
+					rows = []Row{make(Row, len(cols))}
+				}
+				var lines []string
+				for _, r := range rows {
+					lines = append(lines, strings.Join(r, ","))
+				}
+				log[len(log)-1] += fmt.Sprintf("(%d)", len(rows))
+				value := strings.Join(lines, "\n")
+				do = func() { m.FromValues(value, ",") }
+				cursor = clampInt(cursor, 0, max(len(rows)-1, 0))
+			}
+			preOff, preStart := m.viewport.YOffset(), m.start
+			if ragged(cols, rows) {
+				// bubbles/42: a row longer than the columns panics in renderRow
+				// as soon as it is within a page of the cursor.
+				if panicked(do) {
+					zootest.Count("bubbles/42")
+					return
+				}
+			} else {
+				do()
+			}
+			if m.Focused() != focus {
+				zootest.Fail(ht, "%s: Focused %v, want %v", trace(), m.Focused(), focus)
+				return
+			}
+			if len(rows) == 0 {
+				if m.SelectedRow() != nil {
+					zootest.Fail(ht, "%s: SelectedRow %q with no rows", trace(), m.SelectedRow())
+					return
+				}
+				log[len(log)-1] += fmt.Sprintf("→(%d)", m.Cursor())
+				continue
+			}
+			if m.Cursor() < 0 {
+				// bubbles/45: the cursor stays -1 once the table was empty.
+				zootest.Count("bubbles/45")
+				return
+			}
+			if m.Cursor() != cursor {
+				zootest.Fail(ht, "%s: Cursor %d, want %d (rows %d)", trace(), m.Cursor(), cursor, len(rows))
+				return
+			}
+			if got := m.SelectedRow(); strings.Join(got, "|") != strings.Join(rows[cursor], "|") {
+				zootest.Fail(ht, "%s: SelectedRow %q, want row %d %q", trace(), got, cursor, rows[cursor])
+				return
+			}
+			if m.Height() != h-1 {
+				zootest.Fail(ht, "%s: Height %d after a height of %d", trace(), m.Height(), h)
+				return
+			}
+			view := strings.Split(m.View(), "\n")
+			if len(view) != h {
+				zootest.Fail(ht, "%s: View has %d lines, want %d", trace(), len(view), h)
+				return
+			}
+			header := headerText(cols)
+			if zootest.Width(zootest.Cells(header)) > w {
+				// bubbles/46: the header is not cut to the table's width.
+				zootest.Count("bubbles/46")
+			} else if got := zootest.Plain(zootest.Cells(view[0])); got != header {
+				zootest.Fail(ht, "%s: header %q, want %q", trace(), got, header)
+				return
+			}
+			first := m.start + m.viewport.YOffset()
+			log[len(log)-1] += fmt.Sprintf("→(%d@%d)", m.Cursor(), first)
+			reversed := -1
+			for i, line := range view[1:] {
+				cells := zootest.Cells(line)
+				want := ""
+				if first+i < len(rows) {
+					want = cut(rowText(cols, rows[first+i]), w)
+				}
+				if got := strings.TrimRight(zootest.Plain(cells), " "); got != want {
+					zootest.Fail(ht, "%s: body line %d %q, want row %d %q", trace(), i, got, first+i, want)
+					return
+				}
+				for _, c := range cells {
+					if c.Rev {
+						if reversed >= 0 && reversed != i {
+							zootest.Fail(ht, "%s: lines %d and %d both reversed", trace(), reversed, i)
+							return
+						}
+						reversed = i
+					}
+				}
+			}
+			shown := cursor >= first && cursor < first+h-1
+			if shown {
+				hidden = ""
+				if rowText(cols, rows[cursor]) != "" && reversed != cursor-first {
+					zootest.Fail(ht, "%s: reversed line %d, want the cursor's line %d", trace(), reversed, cursor-first)
+					return
+				}
+				continue
+			}
+			if reversed >= 0 {
+				zootest.Fail(ht, "%s: line %d reversed while the cursor row %d is not shown (first %d)", trace(), reversed, cursor, first)
+				return
+			}
+			switch {
+			case op == "moveup" && hidden != "":
+				// bubbles/44: MoveUp never scrolls down to a selection below the
+				// view, so one hidden by a setter stays hidden through up moves.
+				hidden = "bubbles/44"
+			case op == "moveup":
+				zootest.Fail(ht, "%s: cursor row %d not shown after a move up from offset %d, start %d (rows %d..%d of %d)", trace(), cursor, preOff, preStart, first, first+h-2, len(rows))
+				return
+			case op == "movedown":
+				zootest.Fail(ht, "%s: cursor row %d not shown after a move down (rows %d..%d of %d)", trace(), cursor, first, first+h-2, len(rows))
+				return
+			case hidden != "":
+				// still out of view since the op that hid it
+			default:
+				// bubbles/43: the setters do not scroll the selection into view.
+				hidden = "bubbles/43"
+			}
+			zootest.Count(hidden)
+		}
+	})
+}
+
+func panicked(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+func pinTable(rows int, h int) Model {
+	rs := make([]Row, rows)
+	for i := range rs {
+		rs[i] = Row{fmt.Sprintf("row %d", i), fmt.Sprintf("v%d", i)}
+	}
+	return New(WithColumns([]Column{{Title: "A", Width: 6}, {Title: "B", Width: 4}}), WithRows(rs), WithHeight(h), WithWidth(30), WithFocused(true), WithStyles(plainStyles()))
+}
+
+func shownRows(m Model) string {
+	var lines []string
+	for _, l := range strings.Split(m.View(), "\n")[1:] {
+		lines = append(lines, strings.TrimSpace(zootest.Plain(zootest.Cells(l))))
+	}
+	return strings.Join(lines, "/")
+}
+
+// bubbles/42: a row with more fields than there are columns panics in
+// renderRow (a stray separator in FromValues is enough).
+func TestHegelPinTableLongRowPanics(t *testing.T) {
+	m := pinTable(3, 6)
+	if panicked(func() { m.FromValues("a,b\nc,d,e", ",") }) {
+		t.Fatalf("FromValues with a three-field line under two columns panicked")
+	}
+}
+
+// bubbles/43: SetCursor moves the selection without scrolling to it; the
+// view shows the rows above.
+func TestHegelPinTableSetCursorHidesTheSelection(t *testing.T) {
+	m := pinTable(100, 6)
+	m.SetCursor(50)
+	if got := shownRows(m); !strings.Contains(got, "row 50 ") {
+		t.Fatalf("after SetCursor(50) the view shows %q", got)
+	}
+}
+
+// bubbles/44: from that state MoveUp keeps the selection one row below the
+// view (its third case needs an offset of at least 1).
+func TestHegelPinTableMoveUpKeepsTheSelectionBelow(t *testing.T) {
+	m := pinTable(100, 6)
+	m.SetCursor(50)
+	m.MoveUp(1)
+	if got := shownRows(m); !strings.Contains(got, "row 49 ") {
+		t.Fatalf("after SetCursor(50), MoveUp(1) the view shows %q", got)
+	}
+}
+
+// bubbles/45: a move on an empty table leaves the cursor at -1, and SetRows
+// only clamps downwards, so it stays there: no selected row, and one row
+// fewer rendered.
+func TestHegelPinTableCursorStaysNegative(t *testing.T) {
+	m := pinTable(0, 6)
+	m.MoveDown(1)
+	m.SetRows([]Row{{"a", "1"}, {"b", "2"}, {"c", "3"}, {"d", "4"}, {"e", "5"}})
+	if m.Cursor() != 0 || m.SelectedRow() == nil || !strings.Contains(shownRows(m), "e") {
+		t.Fatalf("Cursor %d, SelectedRow %q, view %q", m.Cursor(), m.SelectedRow(), shownRows(m))
+	}
+}
+
+// bubbles/46: the header line is not cut to the table's width.
+func TestHegelPinTableHeaderIgnoresTheWidth(t *testing.T) {
+	m := New(WithColumns([]Column{{Title: "Alpha", Width: 10}, {Title: "Beta", Width: 10}, {Title: "Gamma", Width: 10}}), WithRows([]Row{{"a", "b", "c"}}), WithHeight(4), WithWidth(12), WithFocused(true))
+	head := strings.Split(m.View(), "\n")[0]
+	if got := zootest.Width(zootest.Cells(head)); got > 12 {
+		t.Fatalf("header %q is %d cells wide in a table of width 12", head, got)
+	}
+}
+
+// bubbles/47: a height under 2 is not clamped: Height() goes negative and
+// View still has two lines.
+func TestHegelPinTableHeightBelowTwo(t *testing.T) {
+	m := pinTable(5, 0)
+	if m.Height() < 0 || len(strings.Split(m.View(), "\n")) != 1 {
+		t.Fatalf("height 0: Height() %d, View %q", m.Height(), m.View())
+	}
+}
+
+// bubbles/48: a tab in a cell value is truncated at width 0 and rendered at
+// width 4, so "a\tb" in a five-wide column shows "a" alone.
+func TestHegelPinTableTabEatsTheCell(t *testing.T) {
+	m := New(WithColumns([]Column{{Title: "A", Width: 5}}), WithRows([]Row{{"a\tb"}}), WithHeight(3), WithWidth(20), WithFocused(true))
+	row := zootest.Plain(zootest.Cells(strings.Split(m.View(), "\n")[1]))
+	if !strings.Contains(row, "b") {
+		t.Fatalf("row %q lost the b", row)
+	}
+}
diff --git a/textarea/hegel_test.go b/textarea/hegel_test.go
new file mode 100644
index 0000000..610688c
--- /dev/null
+++ b/textarea/hegel_test.go
@@ -0,0 +1,1296 @@
+package textarea
+
+// Hegel property tests for the textarea bubble: a multi-line editor with
+// soft-wrapped lines, a vertical viewport, line numbers, a character limit,
+// a line limit and keyboard selections.
+//
+// The editing model is a slice of rune lines with a cursor and a selection;
+// every default key binding, pastes and the public setters are driven through
+// Update and Value, Line, Column, LineCount and SelectedText must follow it.
+// Vertical motion is checked against the library's own wrap grid (one visual
+// row per press), the rendered view against the grid (gutter, rows, padding,
+// the reversed cursor cell), the real cursor and PositionAt against the
+// virtual cursor, and LineInfo against the grid.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property = zootest.Property
+	fail     = zootest.Fail
+	count    = zootest.Count
+	guard    = zootest.Guard
+	n        = zootest.N
+	chance   = zootest.Chance
+	note     = zootest.Note
+)
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return zootest.Pick(tc, xs) }
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kEnter       = keyOf(tea.KeyEnter, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kBegin       = keyOf(tea.KeyHome, tea.ModCtrl)
+	kEndAll      = keyOf(tea.KeyEnd, tea.ModCtrl)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+	kTranspose   = keyOf('t', tea.ModCtrl)
+	kUpper       = keyOf('u', tea.ModAlt)
+	kLower       = keyOf('l', tea.ModAlt)
+	kCapital     = keyOf('c', tea.ModAlt)
+	kSelRight    = keyOf(tea.KeyRight, tea.ModShift)
+	kSelLeft     = keyOf(tea.KeyLeft, tea.ModShift)
+	kSelWordFwd  = keyOf('f', tea.ModAlt|tea.ModShift)
+	kSelWordBack = keyOf('b', tea.ModAlt|tea.ModShift)
+	kSelectAll   = keyOf('g', tea.ModCtrl)
+)
+
+// settleMsg is a message no binding matches: Update then only refreshes the
+// viewport and the cursor, as any unrelated message in a program would.
+type settleMsg struct{}
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+func genRune(tc hegel.TestCase) rune {
+	switch {
+	case chance(tc, 50):
+		return rune('a' + n(tc, 0, 25))
+	case chance(tc, 35):
+		return ' '
+	case chance(tc, 30):
+		return pick(tc, []rune("日本語漢字"))
+	case chance(tc, 40):
+		return rune('A' + n(tc, 0, 25))
+	case chance(tc, 50):
+		return pick(tc, []rune("0123456789.,-_/"))
+	default:
+		return pick(tc, []rune("éüñ"))
+	}
+}
+
+func genRunes(tc hegel.TestCase, lo, hi int) []rune {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = genRune(tc)
+	}
+	return rs
+}
+
+// genText draws a value as SetValue or a paste would bring it: several
+// lines, sometimes with tabs, lone CRs or CRLF pairs.
+func genText(tc hegel.TestCase) string {
+	k := n(tc, 1, 4)
+	var parts []string
+	for i := 0; i < k; i++ {
+		parts = append(parts, string(genRunes(tc, 0, 9)))
+	}
+	s := strings.Join(parts, "\n")
+	if chance(tc, 15) {
+		s = strings.ReplaceAll(s, "\n", "\r\n")
+	} else if chance(tc, 10) {
+		s = strings.ReplaceAll(s, "\n", "\r")
+	}
+	if chance(tc, 10) {
+		rs := []rune(s)
+		if len(rs) > 0 {
+			rs[n(tc, 0, len(rs)-1)] = '\t'
+		}
+		s = string(rs)
+	}
+	return s
+}
+
+func isWide(r rune) bool { return uniseg.StringWidth(string(r)) != 1 }
+
+func hasWide(rs []rune) bool {
+	for _, r := range rs {
+		if isWide(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// newArea makes a focused textarea whose text width is exactly width and
+// returns it with its prompt width and gutter width (line numbers).
+func newArea(tc hegel.TestCase, width, height int) (m Model, promptW, gutterW int) {
+	m = New()
+	m.Focus()
+	m.Prompt = pick(tc, []string{"┃ ", "> ", "", "|"})
+	m.ShowLineNumbers = chance(tc, 70)
+	if chance(tc, 30) {
+		m.MaxHeight = 9
+	}
+	promptW = uniseg.StringWidth(m.Prompt)
+	if m.ShowLineNumbers {
+		gutterW = len(strconv.Itoa(m.MaxHeight)) + 2
+	}
+	m.SetWidth(width + promptW + gutterW)
+	m.SetHeight(height)
+	if m.Width() != width {
+		panic(fmt.Sprintf("newArea: width %d, want %d", m.Width(), width))
+	}
+	return m, promptW, gutterW
+}
+
+// grid returns the library's wrap rows of every logical line.
+func grid(m Model) [][][]rune {
+	var g [][][]rune
+	for _, l := range m.value {
+		g = append(g, wrap(l, m.width))
+	}
+	return g
+}
+
+func visualRows(g [][][]rune) int {
+	t := 0
+	for _, rows := range g {
+		t += len(rows)
+	}
+	return t
+}
+
+// rowAt returns the runes of visual row v of the grid.
+func rowAt(g [][][]rune, v int) []rune {
+	for _, rows := range g {
+		if v < len(rows) {
+			return rows[v]
+		}
+		v -= len(rows)
+	}
+	return nil
+}
+
+// placeCursor puts the cursor on a random line and column of m (an internal
+// move, as SetValue and the keys would leave it) and settles the view.
+func placeCursor(tc hegel.TestCase, m Model) Model {
+	m.row = n(tc, 0, len(m.value)-1)
+	m.SetCursorColumn(n(tc, 0, len(m.value[m.row])))
+	return press(m, settleMsg{})
+}
+
+// ---------------------------------------------------------------- the editing model
+
+type pos struct{ row, col int }
+
+func (p pos) before(q pos) bool {
+	if p.row != q.row {
+		return p.row < q.row
+	}
+	return p.col < q.col
+}
+
+type editModel struct {
+	lines     [][]rune
+	row, col  int
+	anchor    pos
+	head      pos
+	has       bool // a selection was started and not cleared
+	libHas    bool // the textarea's own hasSelection flag (bubbles/26)
+	stale     bool // the textarea anchored a selection at a stale position
+	limit     int
+	maxHeight int
+}
+
+func newEditModel(limit, maxHeight int) *editModel {
+	return &editModel{lines: [][]rune{{}}, limit: limit, maxHeight: maxHeight}
+}
+
+func (e *editModel) value() string {
+	var parts []string
+	for _, l := range e.lines {
+		parts = append(parts, string(l))
+	}
+	return strings.Join(parts, "\n")
+}
+
+func (e *editModel) length() int {
+	t := len(e.lines) - 1
+	for _, l := range e.lines {
+		t += len(l)
+	}
+	return t
+}
+
+func (e *editModel) line() []rune { return e.lines[e.row] }
+
+func (e *editModel) selected() bool { return e.has && e.anchor != e.head }
+
+func (e *editModel) selection() (pos, pos) {
+	s, t := e.anchor, e.head
+	if t.before(s) {
+		s, t = t, s
+	}
+	return s, t
+}
+
+func (e *editModel) selectedText() string {
+	if !e.selected() {
+		return ""
+	}
+	s, t := e.selection()
+	if s.row == t.row {
+		return string(e.lines[s.row][s.col:t.col])
+	}
+	var b strings.Builder
+	b.WriteString(string(e.lines[s.row][s.col:]))
+	for r := s.row + 1; r < t.row; r++ {
+		b.WriteString("\n" + string(e.lines[r]))
+	}
+	b.WriteString("\n" + string(e.lines[t.row][:t.col]))
+	return b.String()
+}
+
+func (e *editModel) clearSel() {
+	e.has, e.libHas = false, false
+	e.anchor, e.head = pos{}, pos{}
+}
+
+// deleteSel removes the selection and reports whether there was one.
+func (e *editModel) deleteSel() bool {
+	if !e.selected() {
+		return false
+	}
+	s, t := e.selection()
+	merged := append(append([]rune{}, e.lines[s.row][:s.col]...), e.lines[t.row][t.col:]...)
+	rest := append([][]rune{}, e.lines[t.row+1:]...)
+	e.lines = append(append(e.lines[:s.row:s.row], merged), rest...)
+	e.row, e.col = s.row, s.col
+	e.clearSel()
+	return true
+}
+
+// sanitize is what the textarea should make of raw text: tabs become four
+// spaces, "\r\n" and lone "\r" line breaks, other controls vanish.
+func sanitize(s string) []rune {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\r", "\n")
+	s = strings.ReplaceAll(s, "\t", "    ")
+	var out []rune
+	for _, r := range s {
+		if r == '\n' || !unicode.IsControl(r) && r != unicode.ReplacementChar {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// insert inserts raw text at the cursor; it reports whether the character
+// limit or the line limit cut it.
+func (e *editModel) insert(s string) (cutByLimit, cutByLines bool) {
+	rs := sanitize(s)
+	if e.limit > 0 {
+		avail := e.limit - e.length()
+		if avail <= 0 {
+			return true, false
+		}
+		if avail < len(rs) {
+			rs = rs[:avail]
+			cutByLimit = true
+		}
+	}
+	parts := strings.Split(string(rs), "\n")
+	if e.maxHeight > 0 && len(e.lines)+len(parts)-1 > e.maxHeight {
+		parts = parts[:max(0, e.maxHeight-len(e.lines)+1)]
+		cutByLines = true
+		if len(parts) == 0 {
+			return
+		}
+	}
+	tail := append([]rune{}, e.line()[e.col:]...)
+	head := append([]rune{}, e.line()[:e.col]...)
+	first := append(head, []rune(parts[0])...)
+	if len(parts) == 1 {
+		e.lines[e.row] = append(first, tail...)
+		e.col = len(first)
+		return
+	}
+	newLines := [][]rune{first}
+	for _, p := range parts[1:] {
+		newLines = append(newLines, []rune(p))
+	}
+	last := len(newLines) - 1
+	e.col = len(newLines[last])
+	newLines[last] = append(newLines[last], tail...)
+	rest := append([][]rune{}, e.lines[e.row+1:]...)
+	e.lines = append(append(e.lines[:e.row:e.row], newLines...), rest...)
+	e.row += last
+	return
+}
+
+func (e *editModel) mergeBelow() {
+	if e.row >= len(e.lines)-1 {
+		return
+	}
+	e.lines[e.row] = append(e.lines[e.row], e.lines[e.row+1]...)
+	e.lines = append(e.lines[:e.row+1], e.lines[e.row+2:]...)
+}
+
+func (e *editModel) mergeAbove() {
+	if e.row == 0 {
+		return
+	}
+	e.col = len(e.lines[e.row-1])
+	e.lines[e.row-1] = append(e.lines[e.row-1], e.lines[e.row]...)
+	e.lines = append(e.lines[:e.row], e.lines[e.row+1:]...)
+	e.row--
+}
+
+func (e *editModel) splice(from, to int) {
+	l := e.line()
+	e.lines[e.row] = append(append([]rune{}, l[:from]...), l[to:]...)
+}
+
+func space(r rune) bool { return unicode.IsSpace(r) }
+
+// wordStart is where backward word deletion and motion stop: before the
+// spaces and the word to the left of the cursor.
+func (e *editModel) wordStart() int {
+	i := e.col
+	l := e.line()
+	for i > 0 && space(l[i-1]) {
+		i--
+	}
+	for i > 0 && !space(l[i-1]) {
+		i--
+	}
+	return i
+}
+
+func (e *editModel) wordEnd() int {
+	j := e.col
+	l := e.line()
+	for j < len(l) && space(l[j]) {
+		j++
+	}
+	for j < len(l) && !space(l[j]) {
+		j++
+	}
+	return j
+}
+
+func (e *editModel) left() {
+	if e.col == 0 && e.row > 0 {
+		e.row--
+		e.col = len(e.line())
+		return
+	}
+	if e.col > 0 {
+		e.col--
+	}
+}
+
+func (e *editModel) right() {
+	if e.col < len(e.line()) {
+		e.col++
+	} else if e.row < len(e.lines)-1 {
+		e.row++
+		e.col = 0
+	}
+}
+
+// wordLeft follows the textarea's own rule: step left (into the previous
+// line's last rune when at a line start) until on a non-space rune, then to
+// the start of that word.
+func (e *editModel) wordLeft() {
+	for {
+		or, oc := e.row, e.col
+		if e.col == 0 && e.row > 0 {
+			e.row--
+			e.col = len(e.line())
+		}
+		if e.col > 0 {
+			e.col--
+		}
+		if e.row == or && e.col == oc {
+			return
+		}
+		if e.col < len(e.line()) && !space(e.line()[e.col]) {
+			break
+		}
+	}
+	for e.col > 0 && !space(e.line()[e.col-1]) {
+		e.col--
+	}
+}
+
+// wordRight skips spaces (across line ends) and then a word; f sees every
+// rune of that word.
+func (e *editModel) wordRight(f func(i int, col int)) {
+	for e.col >= len(e.line()) || space(e.line()[e.col]) {
+		if e.row == len(e.lines)-1 && e.col == len(e.line()) {
+			break
+		}
+		e.right()
+	}
+	i := 0
+	for e.col < len(e.line()) && !space(e.line()[e.col]) {
+		if f != nil {
+			f(i, e.col)
+		}
+		e.col++
+		i++
+	}
+}
+
+// startSel anchors a keyboard selection at the cursor unless a non-empty one
+// is being extended. It reports whether the textarea, which only asks
+// whether a selection was ever started, keeps a stale anchor instead
+// (bubbles/26).
+func (e *editModel) startSel() (stale bool) {
+	stale = e.libHas && !e.selected() && e.anchor != (pos{e.row, e.col})
+	if !e.selected() {
+		e.anchor = pos{e.row, e.col}
+	}
+	e.has, e.libHas = true, true
+	e.head = pos{e.row, e.col}
+	if stale {
+		e.stale = true // from here on the textarea's selection is not the model's
+	}
+	return stale
+}
+
+func (e *editModel) endSel() { e.head = pos{e.row, e.col} }
+
+// step describes one operation of the editing property.
+type step struct {
+	name string
+	msg  tea.Msg
+	api  func(m *Model)
+	// shape names the pinned bug whose shape the step has, if any.
+	shape string
+}
+
+func opNames() []string {
+	return []string{
+		"type", "type", "type", "paste", "enter", "enter", "backspace", "backspace",
+		"delete", "delete", "left", "right", "home", "end", "killfwd", "killback",
+		"delwordback", "delwordfwd", "wordback", "wordfwd", "begin", "endall",
+		"transpose", "upper", "lower", "capital", "selright", "selleft",
+		"selwordfwd", "selwordback", "selectall", "setcol", "setvalue", "reset",
+		"insertstring",
+	}
+}
+
+// apply performs op on the model and returns the step for the textarea.
+func (e *editModel) apply(tc hegel.TestCase, op string) step {
+	switch op {
+	case "type":
+		r := genRune(tc)
+		e.deleteSel()
+		e.insert(string(r))
+		return step{name: "type " + strconv.QuoteRune(r), msg: typed(r)}
+	case "paste", "insertstring", "setvalue":
+		text := genText(tc)
+		s := step{name: op + " " + strconv.Quote(text)}
+		switch op {
+		case "paste":
+			e.deleteSel()
+			s.msg = tea.PasteMsg{Content: text}
+		case "insertstring":
+			if e.selected() {
+				return step{name: "skip"}
+			}
+			s.api = func(m *Model) { m.InsertString(text) }
+		default:
+			e.lines = [][]rune{{}}
+			e.row, e.col = 0, 0
+			e.clearSel()
+			s.api = func(m *Model) { m.SetValue(text) }
+		}
+		_, cutByLines := e.insert(text)
+		switch {
+		case strings.Contains(text, "\r\n"):
+			s.shape = "bubbles/20-shape"
+		case cutByLines:
+			s.shape = "bubbles/21-shape"
+		}
+		return s
+	case "enter":
+		e.deleteSel()
+		s := step{name: op, msg: kEnter}
+		if e.maxHeight <= 0 || len(e.lines) < e.maxHeight {
+			if cutByLimit, _ := e.insert("\n"); cutByLimit {
+				s.shape = "bubbles/25-shape"
+			}
+		}
+		return s
+	case "backspace":
+		if e.deleteSel() {
+			return step{name: op, msg: kBackspace}
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+		} else {
+			e.splice(e.col-1, e.col)
+			e.col--
+		}
+		return step{name: op, msg: kBackspace}
+	case "delete":
+		if e.deleteSel() {
+			return step{name: op, msg: kDelete}
+		}
+		if e.col < len(e.line()) {
+			e.splice(e.col, e.col+1)
+			if e.col == len(e.line()) && e.row < len(e.lines)-1 {
+				return step{name: op, msg: kDelete, shape: "bubbles/13-shape"}
+			}
+		} else {
+			e.mergeBelow()
+		}
+		return step{name: op, msg: kDelete}
+	case "killfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, len(e.line()))
+			}
+		}
+		return step{name: op, msg: kKill}
+	case "killback":
+		if !e.deleteSel() {
+			if e.col == 0 {
+				e.mergeAbove()
+			} else {
+				e.splice(0, e.col)
+				e.col = 0
+			}
+		}
+		return step{name: op, msg: kKillBack}
+	case "delwordback":
+		if e.deleteSel() {
+			return step{name: op, msg: kDelWordBack}
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+			return step{name: op, msg: kDelWordBack}
+		}
+		i := e.wordStart()
+		shape := ""
+		if i == 1 && space(e.line()[0]) {
+			shape = "bubbles/24-shape"
+		}
+		e.splice(i, e.col)
+		e.col = i
+		return step{name: op, msg: kDelWordBack, shape: shape}
+	case "delwordfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, e.wordEnd())
+			}
+		}
+		return step{name: op, msg: kDelWordFwd}
+	case "left":
+		e.clearSel()
+		e.left()
+		return step{name: op, msg: kLeft}
+	case "right":
+		e.clearSel()
+		e.right()
+		return step{name: op, msg: kRight}
+	case "home":
+		e.clearSel()
+		e.col = 0
+		return step{name: op, msg: kHome}
+	case "end":
+		e.clearSel()
+		e.col = len(e.line())
+		return step{name: op, msg: kEnd}
+	case "wordback":
+		e.clearSel()
+		e.wordLeft()
+		return step{name: op, msg: kWordBack}
+	case "wordfwd":
+		e.clearSel()
+		e.wordRight(nil)
+		return step{name: op, msg: kWordFwd}
+	case "begin":
+		e.clearSel()
+		e.row, e.col = 0, 0
+		return step{name: op, msg: kBegin}
+	case "endall":
+		e.clearSel()
+		e.row = len(e.lines) - 1
+		e.col = len(e.line())
+		return step{name: op, msg: kEndAll}
+	case "transpose":
+		l := e.line()
+		if e.col > 0 && len(l) >= 2 {
+			if e.col >= len(l) {
+				e.col--
+			}
+			l[e.col-1], l[e.col] = l[e.col], l[e.col-1]
+			if e.col < len(l) {
+				e.col++
+			}
+		}
+		return step{name: op, msg: kTranspose}
+	case "upper", "lower", "capital":
+		var msg tea.Msg
+		switch op {
+		case "upper":
+			msg = kUpper
+			e.wordRight(func(_, c int) { e.line()[c] = unicode.ToUpper(e.line()[c]) })
+		case "lower":
+			msg = kLower
+			e.wordRight(func(_, c int) { e.line()[c] = unicode.ToLower(e.line()[c]) })
+		default:
+			msg = kCapital
+			e.wordRight(func(i, c int) {
+				if i == 0 {
+					e.line()[c] = unicode.ToTitle(e.line()[c])
+				}
+			})
+		}
+		return step{name: op, msg: msg}
+	case "selright", "selleft", "selwordfwd", "selwordback":
+		s := step{name: op}
+		if e.startSel() {
+			s.shape = "bubbles/26-shape"
+		}
+		switch op {
+		case "selright":
+			s.msg = kSelRight
+			e.right()
+		case "selleft":
+			s.msg = kSelLeft
+			e.left()
+		case "selwordfwd":
+			s.msg = kSelWordFwd
+			e.wordRight(nil)
+		default:
+			s.msg = kSelWordBack
+			e.wordLeft()
+		}
+		e.endSel()
+		return s
+	case "selectall":
+		e.anchor = pos{0, 0}
+		e.head = pos{len(e.lines) - 1, len(e.lines[len(e.lines)-1])}
+		e.has, e.libHas = true, true
+		return step{name: op, msg: kSelectAll}
+	case "setcol":
+		k := n(tc, -1, len(e.line())+1)
+		e.col = min(max(k, 0), len(e.line()))
+		return step{name: fmt.Sprintf("setcol %d", k), api: func(m *Model) { m.SetCursorColumn(k) }}
+	case "reset":
+		e.lines = [][]rune{{}}
+		e.row, e.col = 0, 0
+		e.clearSel()
+		return step{name: op, api: func(m *Model) { m.Reset() }}
+	}
+	panic("unknown op " + op)
+}
+
+// TestHegelTextareaEditingFollowsTheModel drives every default key binding, pastes
+// and the public setters through Update and checks the value, the cursor and
+// the selection against the model after each step.
+func TestHegelTextareaEditingFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		limit := 0
+		if chance(ht, 30) {
+			limit = n(ht, 1, 12)
+		}
+		maxHeight := 99
+		if chance(ht, 30) {
+			maxHeight = n(ht, 1, 4)
+		}
+		m := New()
+		m.Focus()
+		m.CharLimit = limit
+		m.MaxHeight = maxHeight
+		m.SetWidth(n(ht, 8, 30))
+		m.SetHeight(n(ht, 1, 5))
+		e := newEditModel(limit, maxHeight)
+		steps := n(ht, 1, 30)
+		var log []string
+		var cur step
+		defer func() {
+			if r := recover(); r != nil {
+				if _, ok := r.(error); ok {
+					if cur.shape != "" || e.stale {
+						if cur.shape == "" {
+							cur.shape = "bubbles/26-shape"
+						}
+						// the textarea panicked on a step with a pinned shape
+						// (bubbles/26: a stale anchor on a deleted line)
+						count(cur.shape + "-panic")
+						return
+					}
+					// a runtime error in the textarea: say which steps led to it
+					panic(fmt.Sprintf("%v (limit=%d maxHeight=%d; steps: %s)", r, limit, maxHeight, strings.Join(log, "; ")))
+				}
+				panic(r)
+			}
+		}()
+		for i := 0; i < steps; i++ {
+			op := pick(ht, opNames())
+			s := e.apply(ht, op)
+			if s.name == "skip" {
+				continue
+			}
+			cur = s
+			if s.api != nil {
+				s.api(&m)
+			} else {
+				m = press(m, s.msg)
+			}
+			log = append(log, s.name)
+			if s.shape != "" {
+				count(s.shape)
+			}
+			mismatch := ""
+			switch {
+			case m.Value() != e.value():
+				mismatch = fmt.Sprintf("value %q, want %q", m.Value(), e.value())
+			case m.Line() != e.row || m.Column() != e.col:
+				mismatch = fmt.Sprintf("cursor (%d,%d), want (%d,%d)", m.Line(), m.Column(), e.row, e.col)
+			case m.LineCount() != len(e.lines):
+				mismatch = fmt.Sprintf("LineCount %d, want %d", m.LineCount(), len(e.lines))
+			case m.HasSelection() != e.selected():
+				mismatch = fmt.Sprintf("HasSelection %v, want %v", m.HasSelection(), e.selected())
+			case m.SelectedText() != e.selectedText():
+				mismatch = fmt.Sprintf("SelectedText %q, want %q", m.SelectedText(), e.selectedText())
+			}
+			if mismatch == "" {
+				continue
+			}
+			if s.shape != "" {
+				return
+			}
+			if e.stale {
+				count("bubbles/26-shape-later")
+				return
+			}
+			// bubbles/17: with a CharLimit the library measures the value in
+			// display columns, so any rune of another width diverges.
+			if limit > 0 && (hasWide([]rune(e.value())) || hasWide([]rune(m.Value()))) {
+				count("bubbles/17-shape")
+				return
+			}
+			fail(ht, "limit=%d maxHeight=%d after %s: %s\nsteps: %s", limit, maxHeight, s.name, mismatch, strings.Join(log, "; "))
+		}
+	})
+}
