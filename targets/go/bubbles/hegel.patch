+	r := Root("root").Child("h", "a", "b")
+	m := New(r, 30, 8)
+	r.ChildNodes()[0].SetHidden(true)
+	m.SetNodes(r)
+	if got := m.Root().Size(); got != 3 {
+		t.Errorf("Size %d with one of three children hidden, want 3", got)
+	}
+	m.Down()
+	if n := m.NodeAtCurrentOffset(); n.Hidden() {
+		t.Errorf("Down selects the hidden node %q", n.GivenValue())
+	}
+	m.Down()
+	m.Down() // the last node: its line offset indexes past the rendered lines
+	if got := cursorRow(m); !strings.Contains(got, "b") {
+		t.Errorf("cursor row %q, want the row of b", got)
+	}
