+package textarea
+
+// The shape regions of the recorded textarea bugs (bugs.toml bubbles/13 to 26)
+// and the narrow properties over them: each region is a generator over the bug's
+// shape with random contents, judged exactly like the wide property of its kind
+// (judgeArea, judgeMotion, judgeView, judgeLineInfo). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next
+// to the shape instead (zootest.Shaped) and the property passes. Every shape is
+// deterministic in the library, so every instance reaches the bug (measured with
+// math/rand over the library: 1000 of 1000 for each of the constructions below).
+// The shapes of bubbles/18 (a line-number gutter sized for MaxHeight 0 with ten
+// lines or more) and 19 (SetValue not settled by a message) live here only: the
+// wide properties never draw them. The others the wide properties reach at their
+// natural rates (20, 21, 22 and 23 as drawn alternatives).
+
+import (
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowArea, narrowMotion, narrowView and narrowLineInfo run a narrow property:
+// every drawn case through the wide property's judge.
+func narrowArea(t *testing.T, cases hegel.Generator[areaCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeArea(j, c)
+	})
+}
+
+func narrowMotion(t *testing.T, cases hegel.Generator[motionCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeMotion(j, c)
+	})
+}
+
+func narrowView(t *testing.T, cases hegel.Generator[viewCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeView(j, c)
+	})
+}
+
+func narrowLineInfo(t *testing.T, cases hegel.Generator[lineInfoCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeLineInfo(j, c)
+	})
+}
+
+var (
+	// plainStarts: an editing start without a limit (CharLimit 0, MaxHeight 99).
+	plainStarts = areaStartsOf(hegel.Just(0), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5))
+	// wordRunes: the runes of a word (no space).
+	wordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, wideRunes),
+		zootest.W(9, capitals),
+		zootest.W(7, marks),
+		zootest.W(6, accents),
+	)
+	// narrowTexts: one to four lines of narrow runes (no wrap row can overflow,
+	// bubbles/16) joined by "\n".
+	narrowTexts = multilineOf(zootest.Counted(textsOf(narrowRunes, 0, 9), 1, 4), hegel.Just("\n"), hegel.Just(0))
+	// shownPrompts: the prompts that take a column (bubbles/22 needs reserved
+	// columns).
+	shownPrompts = zootest.Sampled("> ", "\u2503 ", "|")
+)
+
+func opsOf(kinds ...string) []areaOp {
+	ops := make([]areaOp, len(kinds))
+	for i, k := range kinds {
+		ops[i] = areaOp{kind: k}
+	}
+	return ops
+}
+
+func typeOps(s string) []areaOp {
+	var ops []areaOp
+	for _, r := range s {
+		ops = append(ops, areaOp{kind: "type", r: r})
+	}
+	return ops
+}
+
+func setValue(s string) areaOp { return areaOp{kind: "setvalue", s: s} }
+
+func setCol(n int) areaOp { return areaOp{kind: "setcol", n: n} }
+
+// --------------------------------------------------------------------------- bubbles/13
+
+// deleteOnTheLastRuneOfALine: a first line of two to eight runes, a second line,
+// and Delete on the first line's last rune (past the shape, on an earlier rune).
+var deleteOnTheLastRuneOfALine = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	first := hegel.Draw(tc, textsOf(runes, 2, 8))
+	second := hegel.Draw(tc, textsOf(runes, 0, 8))
+	n := len([]rune(first))
+	col := hegel.Draw(tc, zootest.Shaped(hegel.Just(n-1), zootest.Ints(0, n-2)))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: append([]areaOp{setValue(first + "\n" + second), {kind: "begin"}, setCol(col)}, opsOf("delete")...)}
+})
+
+func TestHegelTextareaDeleteOnTheLastRuneOfALine(t *testing.T) {
+	narrowArea(t, deleteOnTheLastRuneOfALine)
+}
+
+// --------------------------------------------------------------------------- bubbles/14
+
+// verticalMotionAcrossAShortRow: a width of 4 to 8 and a line of three words, the
+// first and the last of width-1 letters, the middle one of one letter (past the
+// shape, of two to width-2), so that the rows are "head ", "x ", "tail "; the
+// cursor on the first row and Down, which skips the row of two runes.
+var verticalMotionAcrossAShortRow = hegel.FlatMap(zootest.Ints(4, 8), func(w int) hegel.Generator[motionCase] {
+	return hegel.Composite(func(tc hegel.TestCase) motionCase {
+		head := hegel.Draw(tc, textsOf(letters, w-1, w-1))
+		k := hegel.Draw(tc, zootest.Shaped(hegel.Just(1), zootest.Ints(2, w-2)))
+		mid := hegel.Draw(tc, textsOf(letters, k, k))
+		tail := hegel.Draw(tc, textsOf(letters, w-1, w-1))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), viewTall, hegel.Just(0), hegel.Just("")))
+		col := hegel.Draw(tc, zootest.Ints(0, w-1))
+		return motionCase{view: viewCase{start: start, text: head + " " + mid + " " + tail, col: col, settle: true}, moves: []string{"down"}}
+	})
+})
+
+func TestHegelTextareaVerticalMotionAcrossAShortRow(t *testing.T) {
+	narrowMotion(t, verticalMotionAcrossAShortRow)
+}
+
+// --------------------------------------------------------------------------- bubbles/15
+
+// lineInfoAtTheEndOfARow: a width of 3 to 10 and two words, of a and a+1 letters
+// (a chosen so that the second wraps onto its own row and neither is hard-broken),
+// whose rows then differ in width; the cursor at the end of the first row (past
+// the shape, inside either row).
+var lineInfoAtTheEndOfARow = hegel.FlatMap(zootest.Ints(3, 10), func(w int) hegel.Generator[lineInfoCase] {
+	return hegel.Composite(func(tc hegel.TestCase) lineInfoCase {
+		a := hegel.Draw(tc, zootest.Ints(max(1, (w-1)/2), w-2))
+		b := a + 1
+		value := hegel.Draw(tc, textsOf(letters, a, a)) + " " + hegel.Draw(tc, textsOf(letters, b, b))
+		col := hegel.Draw(tc, zootest.Shaped(hegel.Just(a+1), zootest.Weighted(zootest.W(1, zootest.Ints(0, a)), zootest.W(1, zootest.Ints(a+2, a+1+b)))))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), hegel.Just(3), hegel.Just(0), hegel.Just("")))
+		return lineInfoCase{start: start, value: value, col: col}
+	})
+})
+
+func TestHegelTextareaLineInfoAtTheEndOfARow(t *testing.T) {
+	narrowLineInfo(t, lineInfoAtTheEndOfARow)
+}
+
+// --------------------------------------------------------------------------- bubbles/16
+
+// wideRuneOverflowsTheRow: a width of 2 to 8 and a word of width-1 letters and a
+// wide rune (past the shape, width-2 letters and the rune, which fit), then up
+// to five letters; the cursor on the first row.
+var wideRuneOverflowsTheRow = hegel.FlatMap(zootest.Ints(2, 8), func(w int) hegel.Generator[viewCase] {
+	return hegel.Composite(func(tc hegel.TestCase) viewCase {
+		n := zootest.Shaped(w-1, w-2)
+		text := hegel.Draw(tc, textsOf(letters, n, n)) + string(hegel.Draw(tc, wideRunes)) + hegel.Draw(tc, textsOf(letters, 0, 5))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), viewTall, hegel.Just(0), hegel.Just("")))
+		return viewCase{start: start, text: text, col: hegel.Draw(tc, zootest.Ints(0, n)), settle: true}
+	})
+})
+
+func TestHegelTextareaWideRuneOverflowsTheRow(t *testing.T) {
+	narrowView(t, wideRuneOverflowsTheRow)
+}
+
+// --------------------------------------------------------------------------- bubbles/17
+
+// charLimitCountsColumns: a CharLimit of 2 to 8, a value of k wide runes with
+// 2k at or over the limit but k under it (past the shape, k letters), and a typed
+// letter, which the library refuses.
+var charLimitCountsColumns = hegel.FlatMap(zootest.Ints(2, 8), func(limit int) hegel.Generator[areaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) areaCase {
+		k := hegel.Draw(tc, zootest.Ints((limit+1)/2, limit-1))
+		value := hegel.Draw(tc, textsOf(zootest.Shaped(wideRunes, letters), k, k))
+		r := hegel.Draw(tc, letters)
+		start := hegel.Draw(tc, areaStartsOf(hegel.Just(limit), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+		return areaCase{start: start, ops: []areaOp{setValue(value), {kind: "type", r: r}}}
+	})
+})
+
+func TestHegelTextareaCharLimitCountsColumns(t *testing.T) {
+	narrowArea(t, charLimitCountsColumns)
+}
+
+// --------------------------------------------------------------------------- bubbles/18
+
+// noLimitGutterShiftsLineTen: MaxHeight 0, "no limit" (past the shape, 99), line
+// numbers, ten to fourteen lines of one to three letters, a height of 5 to 12
+// and the cursor on the last line, so that its two-digit number is shown, wider
+// than the gutter sized for one digit (measured with math/rand: 896 of 1000 show
+// the text pushed right, the rest, at width 1, the number alone with the text
+// cut off; every one is a row the judge rejects).
+var noLimitGutterShiftsLineTen = hegel.Composite(func(tc hegel.TestCase) viewCase {
+	lines := hegel.Draw(tc, zootest.Counted(textsOf(letters, 1, 3), 10, 14))
+	start := hegel.Draw(tc, viewStartsOf(prompts, hegel.Just(true), zootest.Shaped(hegel.Just(0), hegel.Just(99)), viewWide, zootest.Ints(5, 12), hegel.Just(0), hegel.Just("")))
+	return viewCase{start: start, text: strings.Join(lines, "\n"), row: len(lines) - 1, settle: true}
+})
+
+func TestHegelTextareaNoLimitGutterShiftsLineTen(t *testing.T) {
+	narrowView(t, noLimitGutterShiftsLineTen)
+}
+
+// --------------------------------------------------------------------------- bubbles/19
+
+// setValueDoesNotScroll: a height of 1 to 3 and a value of more lines, set and
+// not settled by a message (past the shape, settled): the cursor is on the last
+// line, below the view.
+var setValueDoesNotScroll = hegel.FlatMap(zootest.Ints(1, 3), func(h int) hegel.Generator[viewCase] {
+	return hegel.Composite(func(tc hegel.TestCase) viewCase {
+		lines := hegel.Draw(tc, zootest.Counted(textsOf(narrowRunes, 0, 5), h+1, h+5))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, viewWide, hegel.Just(h), hegel.Just(0), hegel.Just("")))
+		last := lines[len(lines)-1]
+		return viewCase{start: start, text: strings.Join(lines, "\n"), row: len(lines) - 1, col: len([]rune(last)), settle: zootest.Shaped(false, true)}
+	})
+})
+
+func TestHegelTextareaSetValueDoesNotScroll(t *testing.T) {
+	narrowView(t, setValueDoesNotScroll)
+}
+
+// --------------------------------------------------------------------------- bubbles/20
+
+// pasteWithCRLF: two or three lines joined by "\r\n" (past the shape, by "\n" or
+// a lone "\r") brought in by a paste, SetValue or InsertString.
+var pasteWithCRLF = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	text := hegel.Draw(tc, multilineOf(zootest.Counted(textsOf(runes, 0, 6), 2, 3), zootest.Shaped(hegel.Just("\r\n"), zootest.Sampled("\n", "\r")), hegel.Just(0)))
+	kind := hegel.Draw(tc, zootest.Sampled("paste", "setvalue", "insertstring"))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: []areaOp{{kind: kind, s: text}}}
+})
+
+func TestHegelTextareaPasteWithCRLF(t *testing.T) {
+	narrowArea(t, pasteWithCRLF)
+}
+
+// --------------------------------------------------------------------------- bubbles/21
+
+// pastePastMaxHeight: a MaxHeight of 1 to 4, a value of up to that many lines and
+// a paste that adds more lines than are left (past the shape, no more than that).
+var pastePastMaxHeight = hegel.FlatMap(zootest.Ints(1, 4), func(maxHeight int) hegel.Generator[areaCase] {
+	return hegel.FlatMap(zootest.Ints(1, maxHeight), func(j int) hegel.Generator[areaCase] {
+		return hegel.Composite(func(tc hegel.TestCase) areaCase {
+			k := hegel.Draw(tc, zootest.Shaped(zootest.Ints(maxHeight-j+1, maxHeight-j+3), zootest.Ints(0, maxHeight-j)))
+			value := strings.Join(hegel.Draw(tc, zootest.Counted(textsOf(letters, 0, 5), j, j)), "\n")
+			text := strings.Join(hegel.Draw(tc, zootest.Counted(textsOf(letters, 0, 5), k+1, k+1)), "\n")
+			start := hegel.Draw(tc, areaStartsOf(hegel.Just(0), hegel.Just(maxHeight), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+			return areaCase{start: start, ops: []areaOp{setValue(value), {kind: "paste", s: text}}}
+		})
+	})
+})
+
+func TestHegelTextareaPastePastMaxHeight(t *testing.T) {
+	narrowArea(t, pastePastMaxHeight)
+}
+
+// --------------------------------------------------------------------------- bubbles/22
+
+// maxWidthBelowThePromptAndGutter: a prompt that takes columns and a MaxWidth no
+// larger than the prompt and the gutter (past the shape, one that leaves 1 to 10
+// columns of text), a value of narrow runes and the cursor anywhere.
+var maxWidthBelowThePromptAndGutter = viewCasesOf(
+	viewStartsOf(shownPrompts, lineNums, maxHeight, viewWide, viewTall, zootest.Shaped(zootest.Ints(-5, -1), zootest.Ints(1, 10)), hegel.Just("")),
+	narrowTexts, rowsAt, colsAt, hegel.Just(true),
+)
+
+func TestHegelTextareaMaxWidthBelowThePromptAndGutter(t *testing.T) {
+	narrowView(t, maxWidthBelowThePromptAndGutter)
+}
+
+// --------------------------------------------------------------------------- bubbles/23
+
+// blankPlaceholder: an empty value and a placeholder of one to three spaces (past
+// the shape, of one letter).
+var blankPlaceholder = viewCasesOf(
+	viewStartsOf(prompts, lineNums, maxHeight, viewWide, viewTall, hegel.Just(0), zootest.Shaped(textsOf(hegel.Just(' '), 1, 3), textsOf(letters, 1, 1))),
+	hegel.Just(""), hegel.Just(0), hegel.Just(0), hegel.Just(true),
+)
+
+func TestHegelTextareaBlankPlaceholder(t *testing.T) {
+	narrowView(t, blankPlaceholder)
+}
+
+// --------------------------------------------------------------------------- bubbles/24
+
+// deleteWordBackwardAfterOneLeadingSpace: one space (past the shape, none or
+// two), a word, then nothing or a space and more, with ctrl+w at the word's end:
+// the library deletes the space before the word too.
+var deleteWordBackwardAfterOneLeadingSpace = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	lead := hegel.Draw(tc, zootest.Shaped(hegel.Just(" "), zootest.Sampled("", "  ")))
+	word := hegel.Draw(tc, textsOf(wordRunes, 1, 6))
+	tail := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(1, hegel.Just("")),
+		zootest.W(1, hegel.Map(textsOf(runes, 0, 6), func(t string) string { return " " + t })),
+	))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: append([]areaOp{setValue(lead + word + tail), setCol(len([]rune(lead + word)))}, opsOf("delwordback")...)}
+})
+
+func TestHegelTextareaDeleteWordBackwardAfterOneLeadingSpace(t *testing.T) {
+	narrowArea(t, deleteWordBackwardAfterOneLeadingSpace)
+}
+
+// --------------------------------------------------------------------------- bubbles/25
+
+// enterAtTheCharLimit: a CharLimit of 1 to 8, a value of as many narrow runes
+// (past the shape, fewer) and Enter, which the library does not count.
+var enterAtTheCharLimit = hegel.FlatMap(zootest.Ints(1, 8), func(limit int) hegel.Generator[areaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) areaCase {
+		n := hegel.Draw(tc, zootest.Shaped(hegel.Just(limit), zootest.Ints(0, limit-1)))
+		value := hegel.Draw(tc, textsOf(narrowRunes, n, n))
+		start := hegel.Draw(tc, areaStartsOf(hegel.Just(limit), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+		return areaCase{start: start, ops: append([]areaOp{setValue(value)}, opsOf("enter")...)}
+	})
+})
+
+func TestHegelTextareaEnterAtTheCharLimit(t *testing.T) {
+	narrowArea(t, enterAtTheCharLimit)
+}
+
+// --------------------------------------------------------------------------- bubbles/26
+
+var (
+	// staleAnchorAfterTyping: a word, shift+right at its end (an empty selection
+	// anchored there), one or three letters typed (two could be the same letter
+	// twice, which the stale selection and the right one both read as) and
+	// shift+left, which selects from the anchor; past the shape, a Left before the
+	// typing clears the empty selection.
+	staleAnchorAfterTyping = hegel.Composite(func(tc hegel.TestCase) areaCase {
+		word := hegel.Draw(tc, textsOf(letters, 1, 5))
+		k := hegel.Draw(tc, zootest.Sampled(1, 3))
+		typedLetters := hegel.Draw(tc, textsOf(letters, k, k))
+		start := hegel.Draw(tc, plainStarts)
+		ops := append([]areaOp{setValue(word)}, opsOf("endall", "selright")...)
+		ops = append(ops, zootest.Shaped[[]areaOp](nil, opsOf("left"))...)
+		ops = append(ops, typeOps(typedLetters)...)
+		return areaCase{start: start, ops: append(ops, opsOf("selleft")...)}
+	})
+	// staleAnchorOnADeletedLine: a word and an empty second line, shift+right at
+	// its start (nothing to select, the anchor on line 2), Backspace (the lines
+	// join) and shift+left, whose selection names the line that is gone, which
+	// SelectedText indexes; past the shape, a Right before the shift+left clears
+	// the empty selection.
+	staleAnchorOnADeletedLine = hegel.Composite(func(tc hegel.TestCase) areaCase {
+		word := hegel.Draw(tc, textsOf(letters, 1, 5))
+		start := hegel.Draw(tc, plainStarts)
+		ops := append([]areaOp{setValue(word + "\n")}, opsOf("endall", "selright", "backspace")...)
+		ops = append(ops, zootest.Shaped[[]areaOp](nil, opsOf("right"))...)
+		return areaCase{start: start, ops: append(ops, opsOf("selleft")...)}
+	})
+	emptySelectionThenShiftArrow = zootest.Weighted(zootest.W(2, staleAnchorAfterTyping), zootest.W(1, staleAnchorOnADeletedLine))
+)
+
+func TestHegelTextareaEmptySelectionThenShiftArrow(t *testing.T) {
+	narrowArea(t, emptySelectionThenShiftArrow)
+}
