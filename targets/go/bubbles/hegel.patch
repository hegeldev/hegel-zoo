+		zootest.W(1, hegel.Just([]fpOp{{kind: "setheight", n: h1}})),
+		zootest.W(1, zootest.Tuple(zootest.Shaped(lastOps, topOps), hegel.Just(fpOp{kind: "size", n: h1 + marginBottom}))),
+	))
+	return fpCase{start: start, ops: ops}
+})
+
+func TestHegelFilepickerGrowFillsTheWindow(t *testing.T) {
+	narrowPicker(t, growFillsTheWindow)
+}
+
+// --------------------------------------------------------------------------- bubbles/68
+
+// backIntoAShrunkListing: ShowHidden on over a hidden directory .d3, a
+// directory d1 of random files and hidden files only; Down to d1, Open,
+// ShowHidden off (past the shape, left on) and Back: the parent re-read has
+// one entry and the restored selection, 1, is past it (1000 of 1000).
+var backIntoAShrunkListing = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	root := emptyTree()
+	root.sizes[6] = hegel.Draw(tc, fileSizes) // .h.txt
+	root.sizes[7] = hegel.Draw(tc, fileSizes) // .i.go
+	root = withSubs(root, hegel.Draw(tc, filesTree(0, visibleNames)), fpTree{}, emptyTree())
+	start := hegel.Draw(tc, plainStarts(root, hegel.Draw(tc, startHeights)))
+	start.hidden = true
+	down, open, back := hegel.Draw(tc, downOps), hegel.Draw(tc, openOps), hegel.Draw(tc, backOps)
+	ops := zootest.Shaped([]fpOp{down, open, {kind: "togglehidden"}, back}, []fpOp{down, open, back})
+	return fpCase{start: start, ops: ops}
+})
+
+func TestHegelFilepickerBackIntoAShrunkListing(t *testing.T) {
+	narrowPicker(t, backIntoAShrunkListing)
+}
+
+// --------------------------------------------------------------------------- bubbles/69
+
+// openAnUnreadableDirectory: a directory d1 of mode 0o000 (past the shape,
+// readable) first in a listing of random files, and Open or enter on it: the
+// library enters it and keeps the parent's listing (1000 of 1000; the case
+// is assumed away when the process reads it anyway, as root does).
+var openAnUnreadableDirectory = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	root := hegel.Draw(tc, filesTree(0, visibleNames))
+	root = withSubs(root, hegel.Draw(tc, filesTree(0, visibleNames)))
+	root.locked = zootest.Shaped(0, -1)
