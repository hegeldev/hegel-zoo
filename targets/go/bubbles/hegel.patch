+// bubbles/10: ctrl+w on a word at the start of the input deletes the single
+// space before it as well.
+func TestHegelPinDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w at %q gives %q, want %q", " ab", m.Value(), " ")
+	}
+}
+
+// bubbles/11: scrolling forward, the window ends at the cursor: the rune under
+// it is not shown and the cursor is a blank at the right edge.
+func TestHegelPinForwardScrollHidesTheRuneUnderTheCursor(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(0)
+	for i := 0; i < 6; i++ {
+		m = press(m, kRight)
+	}
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev && c.S != "g" {
+			t.Fatalf("with the cursor on %q the view shows %s", "g", zootest.String(cells))
+		}
+	}
+}
+
+// bubbles/12: with EchoNone the padding is computed from the hidden value, so
+// the field shrinks as text is typed.
+func TestHegelPinEchoNonePadsByTheHiddenWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(3)
+	m.EchoMode = EchoNone
+	empty := lipgloss.Width(m.View())
+	m.SetValue("ab")
+	if w := lipgloss.Width(m.View()); w != empty {
+		t.Fatalf("EchoNone field is %d cells wide empty and %d with %q", empty, w, "ab")
+	}
+}
