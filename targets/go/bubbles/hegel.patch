+package textarea
+
+// The shape regions of the recorded textarea bugs (bugs.toml bubbles/13 to 26)
+// and the narrow properties over them: each region is a generator over the bug's
+// shape with random contents, judged exactly like the wide property of its kind
+// (judgeArea, judgeMotion, judgeView, judgeLineInfo). Every narrow property fails
+// every run by default; under HEGEL_NO_KNOWN=1 its generator is the region next
+// to the shape instead (zootest.Shaped) and the property passes. Every shape is
+// deterministic in the library, so every instance reaches the bug (measured with
+// math/rand over the library: 1000 of 1000 for each of the constructions below).
+// The shapes of bubbles/18 (a line-number gutter sized for MaxHeight 0 with ten
+// lines or more) and 19 (SetValue not settled by a message) live here only: the
+// wide properties never draw them. The others the wide properties reach at their
+// natural rates (20, 21, 22 and 23 as drawn alternatives).
+
+import (
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowArea, narrowMotion, narrowView and narrowLineInfo run a narrow property:
+// every drawn case through the wide property's judge.
+func narrowArea(t *testing.T, cases hegel.Generator[areaCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeArea(j, c)
+	})
+}
+
+func narrowMotion(t *testing.T, cases hegel.Generator[motionCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeMotion(j, c)
+	})
+}
+
+func narrowView(t *testing.T, cases hegel.Generator[viewCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeView(j, c)
+	})
+}
+
+func narrowLineInfo(t *testing.T, cases hegel.Generator[lineInfoCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeLineInfo(j, c)
+	})
+}
+
+var (
+	// plainStarts: an editing start without a limit (CharLimit 0, MaxHeight 99).
+	plainStarts = areaStartsOf(hegel.Just(0), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5))
+	// wordRunes: the runes of a word (no space).
+	wordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, wideRunes),
+		zootest.W(9, capitals),
+		zootest.W(7, marks),
+		zootest.W(6, accents),
+	)
+	// narrowTexts: one to four lines of narrow runes (no wrap row can overflow,
+	// bubbles/16) joined by "\n".
+	narrowTexts = multilineOf(zootest.Counted(textsOf(narrowRunes, 0, 9), 1, 4), hegel.Just("\n"), hegel.Just(0))
+	// shownPrompts: the prompts that take a column (bubbles/22 needs reserved
+	// columns).
+	shownPrompts = zootest.Sampled("> ", "\u2503 ", "|")
+)
+
+func opsOf(kinds ...string) []areaOp {
+	ops := make([]areaOp, len(kinds))
+	for i, k := range kinds {
+		ops[i] = areaOp{kind: k}
+	}
+	return ops
+}
+
+func typeOps(s string) []areaOp {
+	var ops []areaOp
+	for _, r := range s {
+		ops = append(ops, areaOp{kind: "type", r: r})
+	}
+	return ops
+}
+
+func setValue(s string) areaOp { return areaOp{kind: "setvalue", s: s} }
+
+func setCol(n int) areaOp { return areaOp{kind: "setcol", n: n} }
+
+// --------------------------------------------------------------------------- bubbles/13
+
+// deleteOnTheLastRuneOfALine: a first line of two to eight runes, a second line,
+// and Delete on the first line's last rune (past the shape, on an earlier rune).
+var deleteOnTheLastRuneOfALine = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	first := hegel.Draw(tc, textsOf(runes, 2, 8))
+	second := hegel.Draw(tc, textsOf(runes, 0, 8))
+	n := len([]rune(first))
+	col := hegel.Draw(tc, zootest.Shaped(hegel.Just(n-1), zootest.Ints(0, n-2)))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: append([]areaOp{setValue(first + "\n" + second), {kind: "begin"}, setCol(col)}, opsOf("delete")...)}
+})
+
+func TestHegelTextareaDeleteOnTheLastRuneOfALine(t *testing.T) {
+	narrowArea(t, deleteOnTheLastRuneOfALine)
+}
+
+// --------------------------------------------------------------------------- bubbles/14
+
+// verticalMotionAcrossAShortRow: a width of 4 to 8 and a line of three words, the
+// first and the last of width-1 letters, the middle one of one letter (past the
+// shape, of two to width-2), so that the rows are "head ", "x ", "tail "; the
+// cursor on the first row and Down, which skips the row of two runes.
+var verticalMotionAcrossAShortRow = hegel.FlatMap(zootest.Ints(4, 8), func(w int) hegel.Generator[motionCase] {
+	return hegel.Composite(func(tc hegel.TestCase) motionCase {
+		head := hegel.Draw(tc, textsOf(letters, w-1, w-1))
+		k := hegel.Draw(tc, zootest.Shaped(hegel.Just(1), zootest.Ints(2, w-2)))
+		mid := hegel.Draw(tc, textsOf(letters, k, k))
+		tail := hegel.Draw(tc, textsOf(letters, w-1, w-1))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), viewTall, hegel.Just(0), hegel.Just("")))
+		col := hegel.Draw(tc, zootest.Ints(0, w-1))
+		return motionCase{view: viewCase{start: start, text: head + " " + mid + " " + tail, col: col, settle: true}, moves: []string{"down"}}
+	})
+})
+
+func TestHegelTextareaVerticalMotionAcrossAShortRow(t *testing.T) {
+	narrowMotion(t, verticalMotionAcrossAShortRow)
+}
+
+// --------------------------------------------------------------------------- bubbles/15
+
+// lineInfoAtTheEndOfARow: a width of 3 to 10 and two words, of a and a+1 letters
+// (a chosen so that the second wraps onto its own row and neither is hard-broken),
+// whose rows then differ in width; the cursor at the end of the first row (past
+// the shape, inside either row).
+var lineInfoAtTheEndOfARow = hegel.FlatMap(zootest.Ints(3, 10), func(w int) hegel.Generator[lineInfoCase] {
+	return hegel.Composite(func(tc hegel.TestCase) lineInfoCase {
+		a := hegel.Draw(tc, zootest.Ints(max(1, (w-1)/2), w-2))
+		b := a + 1
+		value := hegel.Draw(tc, textsOf(letters, a, a)) + " " + hegel.Draw(tc, textsOf(letters, b, b))
+		col := hegel.Draw(tc, zootest.Shaped(hegel.Just(a+1), zootest.Weighted(zootest.W(1, zootest.Ints(0, a)), zootest.W(1, zootest.Ints(a+2, a+1+b)))))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), hegel.Just(3), hegel.Just(0), hegel.Just("")))
+		return lineInfoCase{start: start, value: value, col: col}
+	})
+})
+
+func TestHegelTextareaLineInfoAtTheEndOfARow(t *testing.T) {
+	narrowLineInfo(t, lineInfoAtTheEndOfARow)
+}
+
+// --------------------------------------------------------------------------- bubbles/16
+
+// wideRuneOverflowsTheRow: a width of 2 to 8 and a word of width-1 letters and a
+// wide rune (past the shape, width-2 letters and the rune, which fit), then up
+// to five letters; the cursor on the first row.
+var wideRuneOverflowsTheRow = hegel.FlatMap(zootest.Ints(2, 8), func(w int) hegel.Generator[viewCase] {
+	return hegel.Composite(func(tc hegel.TestCase) viewCase {
+		n := zootest.Shaped(w-1, w-2)
+		text := hegel.Draw(tc, textsOf(letters, n, n)) + string(hegel.Draw(tc, wideRunes)) + hegel.Draw(tc, textsOf(letters, 0, 5))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, hegel.Just(w), viewTall, hegel.Just(0), hegel.Just("")))
+		return viewCase{start: start, text: text, col: hegel.Draw(tc, zootest.Ints(0, n)), settle: true}
+	})
+})
+
+func TestHegelTextareaWideRuneOverflowsTheRow(t *testing.T) {
+	narrowView(t, wideRuneOverflowsTheRow)
+}
+
+// --------------------------------------------------------------------------- bubbles/17
+
+// charLimitCountsColumns: a CharLimit of 2 to 8, a value of k wide runes with
+// 2k at or over the limit but k under it (past the shape, k letters), and a typed
+// letter, which the library refuses.
+var charLimitCountsColumns = hegel.FlatMap(zootest.Ints(2, 8), func(limit int) hegel.Generator[areaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) areaCase {
+		k := hegel.Draw(tc, zootest.Ints((limit+1)/2, limit-1))
+		value := hegel.Draw(tc, textsOf(zootest.Shaped(wideRunes, letters), k, k))
+		r := hegel.Draw(tc, letters)
+		start := hegel.Draw(tc, areaStartsOf(hegel.Just(limit), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+		return areaCase{start: start, ops: []areaOp{setValue(value), {kind: "type", r: r}}}
+	})
+})
+
+func TestHegelTextareaCharLimitCountsColumns(t *testing.T) {
+	narrowArea(t, charLimitCountsColumns)
+}
+
+// --------------------------------------------------------------------------- bubbles/18
+
+// noLimitGutterShiftsLineTen: MaxHeight 0, "no limit" (past the shape, 99), line
+// numbers, ten to fourteen lines of one to three letters, a height of 5 to 12
+// and the cursor on the last line, so that its two-digit number is shown, wider
+// than the gutter sized for one digit (measured with math/rand: 896 of 1000 show
+// the text pushed right, the rest, at width 1, the number alone with the text
+// cut off; every one is a row the judge rejects).
+var noLimitGutterShiftsLineTen = hegel.Composite(func(tc hegel.TestCase) viewCase {
+	lines := hegel.Draw(tc, zootest.Counted(textsOf(letters, 1, 3), 10, 14))
+	start := hegel.Draw(tc, viewStartsOf(prompts, hegel.Just(true), zootest.Shaped(hegel.Just(0), hegel.Just(99)), viewWide, zootest.Ints(5, 12), hegel.Just(0), hegel.Just("")))
+	return viewCase{start: start, text: strings.Join(lines, "\n"), row: len(lines) - 1, settle: true}
+})
+
+func TestHegelTextareaNoLimitGutterShiftsLineTen(t *testing.T) {
+	narrowView(t, noLimitGutterShiftsLineTen)
+}
+
+// --------------------------------------------------------------------------- bubbles/19
+
+// setValueDoesNotScroll: a height of 1 to 3 and a value of more lines, set and
+// not settled by a message (past the shape, settled): the cursor is on the last
+// line, below the view.
+var setValueDoesNotScroll = hegel.FlatMap(zootest.Ints(1, 3), func(h int) hegel.Generator[viewCase] {
+	return hegel.Composite(func(tc hegel.TestCase) viewCase {
+		lines := hegel.Draw(tc, zootest.Counted(textsOf(narrowRunes, 0, 5), h+1, h+5))
+		start := hegel.Draw(tc, viewStartsOf(prompts, lineNums, maxHeight, viewWide, hegel.Just(h), hegel.Just(0), hegel.Just("")))
+		last := lines[len(lines)-1]
+		return viewCase{start: start, text: strings.Join(lines, "\n"), row: len(lines) - 1, col: len([]rune(last)), settle: zootest.Shaped(false, true)}
+	})
+})
+
+func TestHegelTextareaSetValueDoesNotScroll(t *testing.T) {
+	narrowView(t, setValueDoesNotScroll)
+}
+
+// --------------------------------------------------------------------------- bubbles/20
+
+// pasteWithCRLF: two or three lines joined by "\r\n" (past the shape, by "\n" or
+// a lone "\r") brought in by a paste, SetValue or InsertString.
+var pasteWithCRLF = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	text := hegel.Draw(tc, multilineOf(zootest.Counted(textsOf(runes, 0, 6), 2, 3), zootest.Shaped(hegel.Just("\r\n"), zootest.Sampled("\n", "\r")), hegel.Just(0)))
+	kind := hegel.Draw(tc, zootest.Sampled("paste", "setvalue", "insertstring"))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: []areaOp{{kind: kind, s: text}}}
+})
+
+func TestHegelTextareaPasteWithCRLF(t *testing.T) {
+	narrowArea(t, pasteWithCRLF)
+}
+
+// --------------------------------------------------------------------------- bubbles/21
+
+// pastePastMaxHeight: a MaxHeight of 1 to 4, a value of up to that many lines and
+// a paste that adds more lines than are left (past the shape, no more than that).
+var pastePastMaxHeight = hegel.FlatMap(zootest.Ints(1, 4), func(maxHeight int) hegel.Generator[areaCase] {
+	return hegel.FlatMap(zootest.Ints(1, maxHeight), func(j int) hegel.Generator[areaCase] {
+		return hegel.Composite(func(tc hegel.TestCase) areaCase {
+			k := hegel.Draw(tc, zootest.Shaped(zootest.Ints(maxHeight-j+1, maxHeight-j+3), zootest.Ints(0, maxHeight-j)))
+			value := strings.Join(hegel.Draw(tc, zootest.Counted(textsOf(letters, 0, 5), j, j)), "\n")
+			text := strings.Join(hegel.Draw(tc, zootest.Counted(textsOf(letters, 0, 5), k+1, k+1)), "\n")
+			start := hegel.Draw(tc, areaStartsOf(hegel.Just(0), hegel.Just(maxHeight), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+			return areaCase{start: start, ops: []areaOp{setValue(value), {kind: "paste", s: text}}}
+		})
+	})
+})
+
+func TestHegelTextareaPastePastMaxHeight(t *testing.T) {
+	narrowArea(t, pastePastMaxHeight)
+}
+
+// --------------------------------------------------------------------------- bubbles/22
+
+// maxWidthBelowThePromptAndGutter: a prompt that takes columns and a MaxWidth no
+// larger than the prompt and the gutter (past the shape, one that leaves 1 to 10
+// columns of text), a value of narrow runes and the cursor anywhere.
+var maxWidthBelowThePromptAndGutter = viewCasesOf(
+	viewStartsOf(shownPrompts, lineNums, maxHeight, viewWide, viewTall, zootest.Shaped(zootest.Ints(-5, -1), zootest.Ints(1, 10)), hegel.Just("")),
+	narrowTexts, rowsAt, colsAt, hegel.Just(true),
+)
+
+func TestHegelTextareaMaxWidthBelowThePromptAndGutter(t *testing.T) {
+	narrowView(t, maxWidthBelowThePromptAndGutter)
+}
+
+// --------------------------------------------------------------------------- bubbles/23
+
+// blankPlaceholder: an empty value and a placeholder of one to three spaces (past
+// the shape, of one letter).
+var blankPlaceholder = viewCasesOf(
+	viewStartsOf(prompts, lineNums, maxHeight, viewWide, viewTall, hegel.Just(0), zootest.Shaped(textsOf(hegel.Just(' '), 1, 3), textsOf(letters, 1, 1))),
+	hegel.Just(""), hegel.Just(0), hegel.Just(0), hegel.Just(true),
+)
+
+func TestHegelTextareaBlankPlaceholder(t *testing.T) {
+	narrowView(t, blankPlaceholder)
+}
+
+// --------------------------------------------------------------------------- bubbles/24
+
+// deleteWordBackwardAfterOneLeadingSpace: one space (past the shape, none or
+// two), a word, then nothing or a space and more, with ctrl+w at the word's end:
+// the library deletes the space before the word too.
+var deleteWordBackwardAfterOneLeadingSpace = hegel.Composite(func(tc hegel.TestCase) areaCase {
+	lead := hegel.Draw(tc, zootest.Shaped(hegel.Just(" "), zootest.Sampled("", "  ")))
+	word := hegel.Draw(tc, textsOf(wordRunes, 1, 6))
+	tail := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(1, hegel.Just("")),
+		zootest.W(1, hegel.Map(textsOf(runes, 0, 6), func(t string) string { return " " + t })),
+	))
+	start := hegel.Draw(tc, plainStarts)
+	return areaCase{start: start, ops: append([]areaOp{setValue(lead + word + tail), setCol(len([]rune(lead + word)))}, opsOf("delwordback")...)}
+})
+
+func TestHegelTextareaDeleteWordBackwardAfterOneLeadingSpace(t *testing.T) {
+	narrowArea(t, deleteWordBackwardAfterOneLeadingSpace)
+}
+
+// --------------------------------------------------------------------------- bubbles/25
+
+// enterAtTheCharLimit: a CharLimit of 1 to 8, a value of as many narrow runes
+// (past the shape, fewer) and Enter, which the library does not count.
+var enterAtTheCharLimit = hegel.FlatMap(zootest.Ints(1, 8), func(limit int) hegel.Generator[areaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) areaCase {
+		n := hegel.Draw(tc, zootest.Shaped(hegel.Just(limit), zootest.Ints(0, limit-1)))
+		value := hegel.Draw(tc, textsOf(narrowRunes, n, n))
+		start := hegel.Draw(tc, areaStartsOf(hegel.Just(limit), hegel.Just(99), zootest.Ints(8, 30), zootest.Ints(1, 5)))
+		return areaCase{start: start, ops: append([]areaOp{setValue(value)}, opsOf("enter")...)}
+	})
+})
+
+func TestHegelTextareaEnterAtTheCharLimit(t *testing.T) {
+	narrowArea(t, enterAtTheCharLimit)
+}
+
+// --------------------------------------------------------------------------- bubbles/26
+
+var (
+	// staleAnchorAfterTyping: a word, shift+right at its end (an empty selection
+	// anchored there), one or three letters typed (two could be the same letter
+	// twice, which the stale selection and the right one both read as) and
+	// shift+left, which selects from the anchor; past the shape, a Left before the
+	// typing clears the empty selection.
+	staleAnchorAfterTyping = hegel.Composite(func(tc hegel.TestCase) areaCase {
+		word := hegel.Draw(tc, textsOf(letters, 1, 5))
+		k := hegel.Draw(tc, zootest.Sampled(1, 3))
+		typedLetters := hegel.Draw(tc, textsOf(letters, k, k))
+		start := hegel.Draw(tc, plainStarts)
+		ops := append([]areaOp{setValue(word)}, opsOf("endall", "selright")...)
+		ops = append(ops, zootest.Shaped[[]areaOp](nil, opsOf("left"))...)
+		ops = append(ops, typeOps(typedLetters)...)
+		return areaCase{start: start, ops: append(ops, opsOf("selleft")...)}
+	})
+	// staleAnchorOnADeletedLine: a word and an empty second line, shift+right at
+	// its start (nothing to select, the anchor on line 2), Backspace (the lines
+	// join) and shift+left, whose selection names the line that is gone, which
+	// SelectedText indexes; past the shape, a Right before the shift+left clears
+	// the empty selection.
+	staleAnchorOnADeletedLine = hegel.Composite(func(tc hegel.TestCase) areaCase {
+		word := hegel.Draw(tc, textsOf(letters, 1, 5))
+		start := hegel.Draw(tc, plainStarts)
+		ops := append([]areaOp{setValue(word + "\n")}, opsOf("endall", "selright", "backspace")...)
+		ops = append(ops, zootest.Shaped[[]areaOp](nil, opsOf("right"))...)
+		return areaCase{start: start, ops: append(ops, opsOf("selleft")...)}
+	})
+	emptySelectionThenShiftArrow = zootest.Weighted(zootest.W(2, staleAnchorAfterTyping), zootest.W(1, staleAnchorOnADeletedLine))
+)
+
+func TestHegelTextareaEmptySelectionThenShiftArrow(t *testing.T) {
+	narrowArea(t, emptySelectionThenShiftArrow)
+}
diff --git a/textarea/hegel_test.go b/textarea/hegel_test.go
new file mode 100644
index 0000000..13ef9cc
--- /dev/null
+++ b/textarea/hegel_test.go
@@ -0,0 +1,1857 @@
+package textarea
+
+// Hegel property tests for the textarea bubble: a multi-line editor with
+// soft-wrapped lines, a vertical viewport, line numbers, a character limit,
+// a line limit and keyboard selections.
+//
+// The editing model is a slice of rune lines with a cursor and a selection. A
+// case is a record of the start (the character limit, MaxHeight, the width and
+// the height) and a list of operation records (every default key binding,
+// pastes and the public setters) applied in order through Update; after each
+// one Value, Line, Column, LineCount, HasSelection and SelectedText must follow
+// the model. Vertical motion is checked against the library's own wrap grid
+// (one visual row per press), the rendered view against the grid (gutter, rows,
+// padding, the reversed cursor cell), the real cursor and PositionAt against
+// the virtual cursor, and LineInfo against the grid.
+//
+// The shapes of the recorded bugs are drawn like any other case, judged against
+// the model and fail naming them. The editing bugs (bubbles/13, 17, 20, 21, 24,
+// 25, 26) are relations between an operation and the live state, declared by a
+// classifier over the model's state before each comparison; under
+// HEGEL_NO_KNOWN=1 the operations that would reach one are left out of the drawn
+// list by replaying the model (unshaped), and CRLF text is not drawn. The
+// motion bug (14) is declared from the grid before each move and the moves that
+// would reach it are left out the same way; the view bugs 16, 19, 22 and 23 and
+// LineInfo's 15 are declared before the comparison, and under HEGEL_NO_KNOWN=1 a
+// MaxWidth that bites, a blank placeholder and an unsettled SetValue are not
+// drawn, the cursor is not put at the end of a wrapped row, and a value with an
+// overflowing row is filtered out.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var guard = zootest.Guard
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kEnter       = keyOf(tea.KeyEnter, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kBegin       = keyOf(tea.KeyHome, tea.ModCtrl)
+	kEndAll      = keyOf(tea.KeyEnd, tea.ModCtrl)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+	kTranspose   = keyOf('t', tea.ModCtrl)
+	kUpper       = keyOf('u', tea.ModAlt)
+	kLower       = keyOf('l', tea.ModAlt)
+	kCapital     = keyOf('c', tea.ModAlt)
+	kSelRight    = keyOf(tea.KeyRight, tea.ModShift)
+	kSelLeft     = keyOf(tea.KeyLeft, tea.ModShift)
+	kSelWordFwd  = keyOf('f', tea.ModAlt|tea.ModShift)
+	kSelWordBack = keyOf('b', tea.ModAlt|tea.ModShift)
+	kSelectAll   = keyOf('g', tea.ModCtrl)
+)
+
+// keys maps an operation's kind to its key.
+var keys = map[string]tea.Msg{
+	"enter": kEnter, "backspace": kBackspace, "delete": kDelete,
+	"left": kLeft, "right": kRight, "home": kHome, "end": kEnd,
+	"killfwd": kKill, "killback": kKillBack, "delwordback": kDelWordBack, "delwordfwd": kDelWordFwd,
+	"wordback": kWordBack, "wordfwd": kWordFwd, "begin": kBegin, "endall": kEndAll,
+	"transpose": kTranspose, "upper": kUpper, "lower": kLower, "capital": kCapital,
+	"selright": kSelRight, "selleft": kSelLeft, "selwordfwd": kSelWordFwd, "selwordback": kSelWordBack,
+	"selectall": kSelectAll, "up": kUp, "down": kDown,
+}
+
+// settleMsg is a message no binding matches: Update then only refreshes the
+// viewport and the cursor, as any unrelated message in a program would.
+type settleMsg struct{}
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+func lettersFrom(base rune) hegel.Generator[rune] {
+	return hegel.Map(zootest.Ints(0, 25), func(i int) rune { return base + rune(i) })
+}
+
+// runesOf: the runes of a value at the old generator's shares (a letter one time in
+// two, a space, a wide rune at the weight given, a capital, a mark, an accent).
+func runesOf(wide int) hegel.Generator[rune] {
+	return zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(18, hegel.Just(' ')),
+		zootest.W(wide, wideRunes),
+		zootest.W(9, capitals),
+		zootest.W(7, marks),
+		zootest.W(6, accents),
+	)
+}
+
+// textsOf is a string of lo to hi runes drawn from rs.
+func textsOf(rs hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(zootest.Counted(rs, lo, hi), func(r []rune) string { return string(r) })
+}
+
+var (
+	letters   = lettersFrom('a')
+	capitals  = lettersFrom('A')
+	wideRunes = zootest.Sampled('\u65e5', '\u672c', '\u8a9e', '\u6f22', '\u5b57')
+	marks     = zootest.Sampled([]rune("0123456789.,-_/")...)
+	accents   = zootest.Sampled('\u00e9', '\u00fc', '\u00f1')
+
+	runes       = runesOf(10)
+	narrowRunes = runesOf(0)
+
+	// lineBreaks: the line break of a text as SetValue or a paste would bring it:
+	// "\n", a lone "\r", or "\r\n" (bubbles/20's shape, not drawn under
+	// HEGEL_NO_KNOWN=1).
+	lineBreaks = zootest.Weighted(
+		zootest.W(75, hegel.Just("\n")),
+		zootest.W(10, hegel.Just("\r")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 15), hegel.Just("\r\n")),
+	)
+	// texts: one to four lines of up to nine runes, a tab put in one time in ten.
+	texts = multilineOf(zootest.Counted(textsOf(runes, 0, 9), 1, 4), lineBreaks, zootest.Maybe(10, zootest.Ints(1, 40)))
+)
+
+// multilineOf joins the drawn lines with the drawn line break and, when tab is
+// not zero, replaces the rune at tab (modulo the length) with a tab.
+func multilineOf(lines hegel.Generator[[]string], breaks hegel.Generator[string], tabs hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		s := strings.Join(hegel.Draw(tc, lines), hegel.Draw(tc, breaks))
+		if tab := hegel.Draw(tc, tabs); tab > 0 && len(s) > 0 {
+			rs := []rune(s)
+			rs[(tab-1)%len(rs)] = '\t'
+			s = string(rs)
+		}
+		return s
+	})
+}
+
+func isWide(r rune) bool { return uniseg.StringWidth(string(r)) != 1 }
+
+// ---------------------------------------------------------------- the editing case
+
+// areaStart is the textarea an editing case starts from: the character limit (0
+// for none), MaxHeight, the width given to SetWidth and the height.
+type areaStart struct {
+	limit, maxHeight, width, height int
+}
+
+func (s areaStart) String() string {
+	return fmt.Sprintf("limit %d MaxHeight %d width %d height %d", s.limit, s.maxHeight, s.width, s.height)
+}
+
+// build makes the focused textarea and the model of the start.
+func (s areaStart) build() (Model, *editModel) {
+	m := New()
+	m.Focus()
+	m.CharLimit = s.limit
+	m.MaxHeight = s.maxHeight
+	m.SetWidth(s.width)
+	m.SetHeight(s.height)
+	return m, newEditModel(s.limit, s.maxHeight)
+}
+
+func areaStartsOf(limits, maxHeights, widths, heights hegel.Generator[int]) hegel.Generator[areaStart] {
+	return hegel.Composite(func(tc hegel.TestCase) areaStart {
+		return areaStart{
+			limit:     hegel.Draw(tc, limits),
+			maxHeight: hegel.Draw(tc, maxHeights),
+			width:     hegel.Draw(tc, widths),
+			height:    hegel.Draw(tc, heights),
+		}
+	})
+}
+
+// areaOp is one operation of an editing case: a typed rune, a key of the default
+// key map, a paste, InsertString, SetValue, SetCursorColumn (the column clamped
+// by the library) or Reset.
+type areaOp struct {
+	kind string
+	r    rune   // type
+	s    string // paste, insertstring, setvalue
+	n    int    // setcol
+}
+
+func (o areaOp) GoString() string {
+	switch o.kind {
+	case "type":
+		return "type " + strconv.QuoteRune(o.r)
+	case "paste", "insertstring", "setvalue":
+		return o.kind + " " + strconv.Quote(o.s)
+	case "setcol":
+		return fmt.Sprintf("setcol %d", o.n)
+	}
+	return o.kind
+}
+
+func opOf(kind string) hegel.Generator[areaOp] { return hegel.Just(areaOp{kind: kind}) }
+
+func typeOp(rs hegel.Generator[rune]) hegel.Generator[areaOp] {
+	return hegel.Map(rs, func(r rune) areaOp { return areaOp{kind: "type", r: r} })
+}
+
+func textOp(kind string, texts hegel.Generator[string]) hegel.Generator[areaOp] {
+	return hegel.Map(texts, func(s string) areaOp { return areaOp{kind: kind, s: s} })
+}
+
+func setColOp(cols hegel.Generator[int]) hegel.Generator[areaOp] {
+	return hegel.Map(cols, func(n int) areaOp { return areaOp{kind: "setcol", n: n} })
+}
+
+// editOpsOf: the operations at the old property's weights (a typed rune three
+// times in thirty-five, Enter, Backspace and Delete twice, the rest once).
+func editOpsOf(rs hegel.Generator[rune], texts hegel.Generator[string]) hegel.Generator[areaOp] {
+	return zootest.Weighted(
+		zootest.W(3, typeOp(rs)),
+		zootest.W(1, textOp("paste", texts)),
+		zootest.W(2, opOf("enter")),
+		zootest.W(2, opOf("backspace")),
+		zootest.W(2, opOf("delete")),
+		zootest.W(1, opOf("left")),
+		zootest.W(1, opOf("right")),
+		zootest.W(1, opOf("home")),
+		zootest.W(1, opOf("end")),
+		zootest.W(1, opOf("killfwd")),
+		zootest.W(1, opOf("killback")),
+		zootest.W(1, opOf("delwordback")),
+		zootest.W(1, opOf("delwordfwd")),
+		zootest.W(1, opOf("wordback")),
+		zootest.W(1, opOf("wordfwd")),
+		zootest.W(1, opOf("begin")),
+		zootest.W(1, opOf("endall")),
+		zootest.W(1, opOf("transpose")),
+		zootest.W(1, opOf("upper")),
+		zootest.W(1, opOf("lower")),
+		zootest.W(1, opOf("capital")),
+		zootest.W(1, opOf("selright")),
+		zootest.W(1, opOf("selleft")),
+		zootest.W(1, opOf("selwordfwd")),
+		zootest.W(1, opOf("selwordback")),
+		zootest.W(1, opOf("selectall")),
+		zootest.W(1, setColOp(zootest.Ints(-1, 40))),
+		zootest.W(1, textOp("setvalue", texts)),
+		zootest.W(1, opOf("reset")),
+		zootest.W(1, textOp("insertstring", texts)),
+	)
+}
+
+// areaCase is a start and the operations.
+type areaCase struct {
+	start areaStart
+	ops   []areaOp
+}
+
+func (c areaCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(ops, ", ")
+}
+
+func areaCasesOf(starts hegel.Generator[areaStart], ops hegel.Generator[[]areaOp]) hegel.Generator[areaCase] {
+	return hegel.Composite(func(tc hegel.TestCase) areaCase {
+		return areaCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+var (
+	// areaStarts: a CharLimit of 1 to 12 three times in ten, a MaxHeight of 1 to 4
+	// three times in ten (99, the default, otherwise), a width of 8 to 30 and a
+	// height of 1 to 5.
+	areaStarts = areaStartsOf(
+		zootest.Maybe(30, zootest.Ints(1, 12)),
+		zootest.Weighted(zootest.W(7, hegel.Just(99)), zootest.W(3, zootest.Ints(1, 4))),
+		zootest.Ints(8, 30),
+		zootest.Ints(1, 5),
+	)
+	editOps = editOpsOf(runes, texts)
+
+	// editCases: a start and one to thirty operations; under HEGEL_NO_KNOWN=1 the
+	// operations that would reach a recorded bug are left out (unshaped).
+	editCases = hegel.Map(areaCasesOf(areaStarts, zootest.Counted(editOps, 1, 30)), unshaped)
+)
+
+// unshaped is the case with, under HEGEL_NO_KNOWN=1, every operation that would
+// reach the shape of a recorded bug from the state the operations before it leave
+// (bubbles/13, 17, 20, 21, 24, 25, 26: relations between an operation and the live
+// state) left out, a no-op the shrinker can delete: the model is replayed over the
+// operations kept so far. By default the case is drawn as it is.
+func unshaped(c areaCase) areaCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	e := newEditModel(c.start.limit, c.start.maxHeight)
+	var kept []areaOp
+	for _, op := range c.ops {
+		if stepShape(e, op) != "" {
+			continue
+		}
+		e.apply(op)
+		kept = append(kept, op)
+	}
+	return areaCase{start: c.start, ops: kept}
+}
+
+// ---------------------------------------------------------------- the editing model
+
+type pos struct{ row, col int }
+
+func (p pos) before(q pos) bool {
+	if p.row != q.row {
+		return p.row < q.row
+	}
+	return p.col < q.col
+}
+
+type editModel struct {
+	lines     [][]rune
+	row, col  int
+	anchor    pos
+	head      pos
+	has       bool // a selection was started and not cleared
+	libHas    bool // the textarea's own hasSelection flag (bubbles/26)
+	limit     int
+	maxHeight int
+}
+
+func newEditModel(limit, maxHeight int) *editModel {
+	return &editModel{lines: [][]rune{{}}, limit: limit, maxHeight: maxHeight}
+}
+
+// clone is a deep copy, for the classifier's dry runs.
+func (e *editModel) clone() *editModel {
+	d := *e
+	d.lines = make([][]rune, len(e.lines))
+	for i, l := range e.lines {
+		d.lines[i] = append([]rune{}, l...)
+	}
+	return &d
+}
+
+func (e *editModel) value() string {
+	var parts []string
+	for _, l := range e.lines {
+		parts = append(parts, string(l))
+	}
+	return strings.Join(parts, "\n")
+}
+
+// length is the number of characters: the runes and the line breaks.
+func (e *editModel) length() int {
+	t := len(e.lines) - 1
+	for _, l := range e.lines {
+		t += len(l)
+	}
+	return t
+}
+
+// colLength is what the library's Length reports: the display columns of every
+// line plus the line breaks (bubbles/17).
+func (e *editModel) colLength() int {
+	t := len(e.lines) - 1
+	for _, l := range e.lines {
+		t += uniseg.StringWidth(string(l))
+	}
+	return t
+}
+
+func (e *editModel) line() []rune { return e.lines[e.row] }
+
+func (e *editModel) selected() bool { return e.has && e.anchor != e.head }
+
+func (e *editModel) selection() (pos, pos) {
+	s, t := e.anchor, e.head
+	if t.before(s) {
+		s, t = t, s
+	}
+	return s, t
+}
+
+func (e *editModel) selectedText() string {
+	if !e.selected() {
+		return ""
+	}
+	s, t := e.selection()
+	if s.row == t.row {
+		return string(e.lines[s.row][s.col:t.col])
+	}
+	var b strings.Builder
+	b.WriteString(string(e.lines[s.row][s.col:]))
+	for r := s.row + 1; r < t.row; r++ {
+		b.WriteString("\n" + string(e.lines[r]))
+	}
+	b.WriteString("\n" + string(e.lines[t.row][:t.col]))
+	return b.String()
+}
+
+func (e *editModel) clearSel() {
+	e.has, e.libHas = false, false
+	e.anchor, e.head = pos{}, pos{}
+}
+
+// deleteSel removes the selection and reports whether there was one.
+func (e *editModel) deleteSel() bool {
+	if !e.selected() {
+		return false
+	}
+	s, t := e.selection()
+	merged := append(append([]rune{}, e.lines[s.row][:s.col]...), e.lines[t.row][t.col:]...)
+	rest := append([][]rune{}, e.lines[t.row+1:]...)
+	e.lines = append(append(e.lines[:s.row:s.row], merged), rest...)
+	e.row, e.col = s.row, s.col
+	e.clearSel()
+	return true
+}
+
+// sanitize is what the textarea should make of raw text: tabs become four
+// spaces, "\r\n" and lone "\r" line breaks, other controls vanish.
+func sanitize(s string) []rune {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\r", "\n")
+	s = strings.ReplaceAll(s, "\t", "    ")
+	var out []rune
+	for _, r := range s {
+		if r == '\n' || !unicode.IsControl(r) && r != unicode.ReplacementChar {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// cutOf is how many of n runes a limit with avail characters left admits.
+func cutOf(n, avail int) int {
+	if avail <= 0 {
+		return 0
+	}
+	return min(n, avail)
+}
+
+// insert inserts raw text at the cursor; it reports whether the character
+// limit or the line limit cut it.
+func (e *editModel) insert(s string) (cutByLimit, cutByLines bool) {
+	rs := sanitize(s)
+	if e.limit > 0 {
+		avail := e.limit - e.length()
+		if avail <= 0 {
+			return true, false
+		}
+		if avail < len(rs) {
+			rs = rs[:avail]
+			cutByLimit = true
+		}
+	}
+	parts := strings.Split(string(rs), "\n")
+	if e.maxHeight > 0 && len(e.lines)+len(parts)-1 > e.maxHeight {
+		parts = parts[:max(0, e.maxHeight-len(e.lines)+1)]
+		cutByLines = true
+		if len(parts) == 0 {
+			return
+		}
+	}
+	tail := append([]rune{}, e.line()[e.col:]...)
+	head := append([]rune{}, e.line()[:e.col]...)
+	first := append(head, []rune(parts[0])...)
+	if len(parts) == 1 {
+		e.lines[e.row] = append(first, tail...)
+		e.col = len(first)
+		return
+	}
+	newLines := [][]rune{first}
+	for _, p := range parts[1:] {
+		newLines = append(newLines, []rune(p))
+	}
+	last := len(newLines) - 1
+	e.col = len(newLines[last])
+	newLines[last] = append(newLines[last], tail...)
+	rest := append([][]rune{}, e.lines[e.row+1:]...)
+	e.lines = append(append(e.lines[:e.row:e.row], newLines...), rest...)
+	e.row += last
+	return
+}
+
+func (e *editModel) mergeBelow() {
+	if e.row >= len(e.lines)-1 {
+		return
+	}
+	e.lines[e.row] = append(e.lines[e.row], e.lines[e.row+1]...)
+	e.lines = append(e.lines[:e.row+1], e.lines[e.row+2:]...)
+}
+
+func (e *editModel) mergeAbove() {
+	if e.row == 0 {
+		return
+	}
+	e.col = len(e.lines[e.row-1])
+	e.lines[e.row-1] = append(e.lines[e.row-1], e.lines[e.row]...)
+	e.lines = append(e.lines[:e.row], e.lines[e.row+1:]...)
+	e.row--
+}
+
+func (e *editModel) splice(from, to int) {
+	l := e.line()
+	e.lines[e.row] = append(append([]rune{}, l[:from]...), l[to:]...)
+}
+
+func space(r rune) bool { return unicode.IsSpace(r) }
+
+// wordStart is where backward word deletion and motion stop: before the
+// spaces and the word to the left of the cursor.
+func (e *editModel) wordStart() int {
+	i := e.col
+	l := e.line()
+	for i > 0 && space(l[i-1]) {
+		i--
+	}
+	for i > 0 && !space(l[i-1]) {
+		i--
+	}
+	return i
+}
+
+func (e *editModel) wordEnd() int {
+	j := e.col
+	l := e.line()
+	for j < len(l) && space(l[j]) {
+		j++
+	}
+	for j < len(l) && !space(l[j]) {
+		j++
+	}
+	return j
+}
+
+func (e *editModel) left() {
+	if e.col == 0 && e.row > 0 {
+		e.row--
+		e.col = len(e.line())
+		return
+	}
+	if e.col > 0 {
+		e.col--
+	}
+}
+
+func (e *editModel) right() {
+	if e.col < len(e.line()) {
+		e.col++
+	} else if e.row < len(e.lines)-1 {
+		e.row++
+		e.col = 0
+	}
+}
+
+// wordLeft follows the textarea's own rule: step left (into the previous
+// line's last rune when at a line start) until on a non-space rune, then to
+// the start of that word.
+func (e *editModel) wordLeft() {
+	for {
+		or, oc := e.row, e.col
+		if e.col == 0 && e.row > 0 {
+			e.row--
+			e.col = len(e.line())
+		}
+		if e.col > 0 {
+			e.col--
+		}
+		if e.row == or && e.col == oc {
+			return
+		}
+		if e.col < len(e.line()) && !space(e.line()[e.col]) {
+			break
+		}
+	}
+	for e.col > 0 && !space(e.line()[e.col-1]) {
+		e.col--
+	}
+}
+
+// wordRight skips spaces (across line ends) and then a word; f sees every
+// rune of that word.
+func (e *editModel) wordRight(f func(i int, col int)) {
+	for e.col >= len(e.line()) || space(e.line()[e.col]) {
+		if e.row == len(e.lines)-1 && e.col == len(e.line()) {
+			break
+		}
+		e.right()
+	}
+	i := 0
+	for e.col < len(e.line()) && !space(e.line()[e.col]) {
+		if f != nil {
+			f(i, e.col)
+		}
+		e.col++
+		i++
+	}
+}
+
+// startSel anchors a keyboard selection at the cursor unless a non-empty one is
+// being extended (the model's rule; the textarea keeps a stale anchor instead
+// when an empty one was started, bubbles/26, which stepShape declares).
+func (e *editModel) startSel() {
+	if !e.selected() {
+		e.anchor = pos{e.row, e.col}
+	}
+	e.has, e.libHas = true, true
+	e.head = pos{e.row, e.col}
+}
+
+func (e *editModel) endSel() { e.head = pos{e.row, e.col} }
+
+// stepShape names the recorded bug whose shape the operation has from the
+// model's state, before it is applied: a text with CRLF, which the library's
+// sanitizer doubles (bubbles/20); an insertion a CharLimit cuts differently
+// when counted in display columns, as the library counts the value (17; the
+// value after the selection it deletes); an insertion the line limit should cut
+// (21); Enter at the character limit (25); Delete on the last rune of a line
+// that is not the last (13); ctrl+w on a word that begins at column 1 after a
+// space (24); a shift+arrow after an empty keyboard selection whose anchor is
+// not at the cursor (26).
+func stepShape(e *editModel, op areaOp) string {
+	switch op.kind {
+	case "paste", "insertstring", "setvalue":
+		if strings.Contains(op.s, "\r\n") {
+			return "bubbles/20"
+		}
+	}
+	switch op.kind {
+	case "type", "paste", "insertstring":
+		if op.kind == "insertstring" && e.selected() {
+			return ""
+		}
+		text := op.s
+		if op.kind == "type" {
+			text = string(op.r)
+		}
+		d := e.clone()
+		if op.kind != "insertstring" {
+			d.deleteSel()
+		}
+		if n := len(sanitize(text)); d.limit > 0 && cutOf(n, d.limit-d.length()) != cutOf(n, d.limit-d.colLength()) {
+			return "bubbles/17"
+		}
+		if _, cutByLines := d.insert(text); cutByLines {
+			return "bubbles/21"
+		}
+	case "setvalue":
+		d := newEditModel(e.limit, e.maxHeight)
+		if _, cutByLines := d.insert(op.s); cutByLines {
+			return "bubbles/21"
+		}
+	case "enter":
+		d := e.clone()
+		d.deleteSel()
+		if (d.maxHeight <= 0 || len(d.lines) < d.maxHeight) && d.limit > 0 && d.length() >= d.limit {
+			return "bubbles/25"
+		}
+	case "delete":
+		if !e.selected() && e.col == len(e.line())-1 && e.row < len(e.lines)-1 {
+			return "bubbles/13"
+		}
+	case "delwordback":
+		if !e.selected() && e.col > 0 && e.wordStart() == 1 && space(e.line()[0]) {
+			return "bubbles/24"
+		}
+	case "selright", "selleft", "selwordfwd", "selwordback":
+		if e.libHas && !e.selected() && e.anchor != (pos{e.row, e.col}) {
+			return "bubbles/26"
+		}
+	}
+	return ""
+}
+
+// apply performs op on the model.
+func (e *editModel) apply(op areaOp) {
+	switch op.kind {
+	case "type":
+		e.deleteSel()
+		e.insert(string(op.r))
+	case "paste":
+		e.deleteSel()
+		e.insert(op.s)
+	case "insertstring":
+		// InsertString under a selection is not driven: its contract there is unstated.
+		if !e.selected() {
+			e.insert(op.s)
+		}
+	case "setvalue":
+		e.lines = [][]rune{{}}
+		e.row, e.col = 0, 0
+		e.clearSel()
+		e.insert(op.s)
+	case "enter":
+		e.deleteSel()
+		if e.maxHeight <= 0 || len(e.lines) < e.maxHeight {
+			e.insert("\n")
+		}
+	case "backspace":
+		if e.deleteSel() {
+			return
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+		} else {
+			e.splice(e.col-1, e.col)
+			e.col--
+		}
+	case "delete":
+		if e.deleteSel() {
+			return
+		}
+		if e.col < len(e.line()) {
+			e.splice(e.col, e.col+1)
+		} else {
+			e.mergeBelow()
+		}
+	case "killfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, len(e.line()))
+			}
+		}
+	case "killback":
+		if !e.deleteSel() {
+			if e.col == 0 {
+				e.mergeAbove()
+			} else {
+				e.splice(0, e.col)
+				e.col = 0
+			}
+		}
+	case "delwordback":
+		if e.deleteSel() {
+			return
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+			return
+		}
+		i := e.wordStart()
+		e.splice(i, e.col)
+		e.col = i
+	case "delwordfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, e.wordEnd())
+			}
+		}
+	case "left":
+		e.clearSel()
+		e.left()
+	case "right":
+		e.clearSel()
+		e.right()
+	case "home":
+		e.clearSel()
+		e.col = 0
+	case "end":
+		e.clearSel()
+		e.col = len(e.line())
+	case "wordback":
+		e.clearSel()
+		e.wordLeft()
+	case "wordfwd":
+		e.clearSel()
+		e.wordRight(nil)
+	case "begin":
+		e.clearSel()
+		e.row, e.col = 0, 0
+	case "endall":
+		e.clearSel()
+		e.row = len(e.lines) - 1
+		e.col = len(e.line())
+	case "transpose":
+		l := e.line()
+		if e.col > 0 && len(l) >= 2 {
+			if e.col >= len(l) {
+				e.col--
+			}
+			l[e.col-1], l[e.col] = l[e.col], l[e.col-1]
+			if e.col < len(l) {
+				e.col++
+			}
+		}
+	case "upper":
+		e.wordRight(func(_, c int) { e.line()[c] = unicode.ToUpper(e.line()[c]) })
+	case "lower":
+		e.wordRight(func(_, c int) { e.line()[c] = unicode.ToLower(e.line()[c]) })
+	case "capital":
+		e.wordRight(func(i, c int) {
+			if i == 0 {
+				e.line()[c] = unicode.ToTitle(e.line()[c])
+			}
+		})
+	case "selright":
+		e.startSel()
+		e.right()
+		e.endSel()
+	case "selleft":
+		e.startSel()
+		e.left()
+		e.endSel()
+	case "selwordfwd":
+		e.startSel()
+		e.wordRight(nil)
+		e.endSel()
+	case "selwordback":
+		e.startSel()
+		e.wordLeft()
+		e.endSel()
+	case "selectall":
+		e.anchor = pos{0, 0}
+		e.head = pos{len(e.lines) - 1, len(e.lines[len(e.lines)-1])}
+		e.has, e.libHas = true, true
+	case "setcol":
+		e.col = min(max(op.n, 0), len(e.line()))
+	case "reset":
+		e.lines = [][]rune{{}}
+		e.row, e.col = 0, 0
+		e.clearSel()
+	default:
+		panic("unknown op " + op.kind)
+	}
+}
+
+// applyArea performs op on the textarea (InsertString under a selection is not
+// driven, as in the model).
+func applyArea(m *Model, e *editModel, op areaOp) {
+	switch op.kind {
+	case "type":
+		*m = press(*m, typed(op.r))
+	case "paste":
+		*m = press(*m, tea.PasteMsg{Content: op.s})
+	case "insertstring":
+		if !e.selected() {
+			m.InsertString(op.s)
+		}
+	case "setvalue":
+		m.SetValue(op.s)
+	case "setcol":
+		m.SetCursorColumn(op.n)
+	case "reset":
+		m.Reset()
+	default:
+		*m = press(*m, keys[op.kind])
+	}
+}
+
+// judgeArea drives the textarea through the case and checks the value, the
+// cursor, the line count and the selection against the model after every
+// operation; the wide and the narrow properties share it.
+func judgeArea(j *zootest.Judge, c areaCase) {
+	m, e := c.start.build()
+	for _, op := range c.ops {
+		j.Shape(stepShape(e, op))
+		applyArea(&m, e, op)
+		e.apply(op)
+		what := "after " + op.GoString()
+		j.Note("%s -> %q cursor (%d,%d)", op.GoString(), m.Value(), m.Line(), m.Column())
+		if m.Value() != e.value() {
+			j.Fail("%s: value %q, want %q", what, m.Value(), e.value())
+		}
+		if m.Line() != e.row || m.Column() != e.col {
+			j.Fail("%s: cursor (%d,%d), want (%d,%d)", what, m.Line(), m.Column(), e.row, e.col)
+		}
+		if m.LineCount() != len(e.lines) {
+			j.Fail("%s: LineCount %d, want %d", what, m.LineCount(), len(e.lines))
+		}
+		if m.HasSelection() != e.selected() {
+			j.Fail("%s: HasSelection %v, want %v", what, m.HasSelection(), e.selected())
+		}
+		if got, want := m.SelectedText(), e.selectedText(); got != want {
+			j.Fail("%s: SelectedText %q, want %q", what, got, want)
+		}
+	}
+}
+
+// TestHegelTextareaEditingFollowsTheModel drives every default key binding, pastes
+// and the public setters through Update and checks the value, the cursor and
+// the selection against the model after each step.
+func TestHegelTextareaEditingFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeArea(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- the view case
+
+// viewStart is the textarea the view, motion, cursor and LineInfo cases start
+// from: the prompt, line numbers, MaxHeight (99 or 9; 0, "no limit", only in
+// bubbles/18's narrow property), the text width, the height, MaxWidth (0 for
+// none) and the placeholder ("" for none).
+type viewStart struct {
+	prompt      string
+	lineNumbers bool
+	maxHeight   int
+	width       int
+	height      int
+	maxWidth    int
+	placeholder string
+}
+
+func (s viewStart) String() string {
+	parts := []string{fmt.Sprintf("prompt %q", s.prompt)}
+	if s.lineNumbers {
+		parts = append(parts, "line numbers")
+	}
+	parts = append(parts, fmt.Sprintf("MaxHeight %d width %d height %d", s.maxHeight, s.width, s.height))
+	if s.maxWidth > 0 {
+		parts = append(parts, fmt.Sprintf("MaxWidth %d", s.maxWidth))
+	}
+	if s.placeholder != "" {
+		parts = append(parts, fmt.Sprintf("placeholder %q", s.placeholder))
+	}
+	return strings.Join(parts, " ")
+}
+
+// reserved is the columns of the prompt and the line-number gutter.
+func (s viewStart) reserved() (promptW, gutterW int) {
+	promptW = uniseg.StringWidth(s.prompt)
+	if s.lineNumbers {
+		gutterW = len(strconv.Itoa(s.maxHeight)) + 2
+	}
+	return promptW, gutterW
+}
+
+// textWidth is the text width the textarea must have: the width, or what
+// MaxWidth leaves of it past the reserved columns, never less than one.
+func (s viewStart) textWidth() int {
+	w := s.width
+	if s.maxWidth > 0 {
+		promptW, gutterW := s.reserved()
+		w = min(s.width+promptW+gutterW, s.maxWidth) - promptW - gutterW
+	}
+	return max(1, w)
+}
+
+// build makes the focused textarea of the start.
+func (s viewStart) build() Model {
+	m := New()
+	m.Focus()
+	m.Prompt = s.prompt
+	m.ShowLineNumbers = s.lineNumbers
+	m.MaxHeight = s.maxHeight
+	m.MaxWidth = s.maxWidth
+	m.Placeholder = s.placeholder
+	promptW, gutterW := s.reserved()
+	m.SetWidth(s.width + promptW + gutterW)
+	m.SetHeight(s.height)
+	return m
+}
+
+// viewStartsOf: a start from the generators of its parts; maxWidths is relative
+// to the reserved columns (0 for none, k > 0 for a MaxWidth that leaves k
+// columns of text, k < 0 for one of reserved+k+1 columns, which leaves none:
+// bubbles/22's shape).
+func viewStartsOf(prompts hegel.Generator[string], lineNumbers hegel.Generator[bool], maxHeights, widths, heights, maxWidths hegel.Generator[int], placeholders hegel.Generator[string]) hegel.Generator[viewStart] {
+	return hegel.Composite(func(tc hegel.TestCase) viewStart {
+		s := viewStart{
+			prompt:      hegel.Draw(tc, prompts),
+			lineNumbers: hegel.Draw(tc, lineNumbers),
+			maxHeight:   hegel.Draw(tc, maxHeights),
+			width:       hegel.Draw(tc, widths),
+			height:      hegel.Draw(tc, heights),
+			placeholder: hegel.Draw(tc, placeholders),
+		}
+		promptW, gutterW := s.reserved()
+		switch k := hegel.Draw(tc, maxWidths); {
+		case k > 0:
+			s.maxWidth = promptW + gutterW + k
+		case k < 0:
+			s.maxWidth = max(1, promptW+gutterW+k+1)
+		}
+		return s
+	})
+}
+
+// viewCase is a start, the value set into it, where the cursor is put (an internal
+// move, as SetValue and the keys would leave it; modulo the lines and the line's
+// length) and whether a message settles the view after that (always, except in
+// bubbles/19's narrow property).
+type viewCase struct {
+	start    viewStart
+	text     string
+	row, col int
+	settle   bool
+}
+
+func (c viewCase) GoString() string {
+	s := fmt.Sprintf("%s: SetValue(%q), cursor at %d,%d", c.start.String(), c.text, c.row, c.col)
+	if !c.settle {
+		s += ", not settled"
+	}
+	return s
+}
+
+func viewCasesOf(starts hegel.Generator[viewStart], texts hegel.Generator[string], rows, cols hegel.Generator[int], settles hegel.Generator[bool]) hegel.Generator[viewCase] {
+	return hegel.Composite(func(tc hegel.TestCase) viewCase {
+		return viewCase{
+			start:  hegel.Draw(tc, starts),
+			text:   hegel.Draw(tc, texts),
+			row:    hegel.Draw(tc, rows),
+			col:    hegel.Draw(tc, cols),
+			settle: hegel.Draw(tc, settles),
+		}
+	})
+}
+
+// build makes the textarea of the case with its value, cursor and view.
+func (c viewCase) build() Model {
+	m := c.start.build()
+	m.SetValue(c.text)
+	m.row = c.row % len(m.value)
+	m.SetCursorColumn(c.col % (len(m.value[m.row]) + 1))
+	if c.settle {
+		m = press(m, settleMsg{})
+	}
+	return m
+}
+
+var (
+	prompts   = zootest.Sampled("", "> ", "\u2503 ", "|")
+	viewWide  = zootest.Ints(1, 10)
+	viewTall  = zootest.Ints(1, 6)
+	lineNums  = zootest.Coin(70)
+	maxHeight = zootest.Weighted(zootest.W(7, hegel.Just(99)), zootest.W(3, hegel.Just(9)))
+	rowsAt    = zootest.Ints(0, 7)
+	colsAt    = zootest.Ints(0, 40)
+	noExtras  = viewStartsOf(prompts, lineNums, maxHeight, viewWide, viewTall, hegel.Just(0), hegel.Just(""))
+
+	// maxWidths: none nine times in ten, else a MaxWidth leaving 1 to 10 columns of
+	// text, or one below the reserved columns (bubbles/22; not under
+	// HEGEL_NO_KNOWN=1).
+	maxWidths = zootest.Weighted(
+		zootest.W(18, hegel.Just(0)),
+		zootest.W(1, zootest.Ints(1, 10)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), zootest.Ints(-5, -1)),
+	)
+	// placeholders: none nine times in ten, else one letter, or one to three spaces
+	// (bubbles/23; not under HEGEL_NO_KNOWN=1).
+	placeholders = zootest.Weighted(
+		zootest.W(18, hegel.Just("")),
+		zootest.W(1, textsOf(letters, 1, 1)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), textsOf(hegel.Just(' '), 1, 3)),
+	)
+	viewStarts = viewStartsOf(prompts, lineNums, maxHeight, viewWide, viewTall, maxWidths, placeholders)
+
+	// viewCases: a value, the cursor anywhere, settled; under HEGEL_NO_KNOWN=1 a value
+	// with a wrap row wider than the width (bubbles/16, a word of width-1 columns and
+	// a wide rune) is filtered out.
+	viewCases = zootest.Only(zootest.NoKnown, "bubbles/16", viewCasesOf(viewStarts, texts, rowsAt, colsAt, hegel.Just(true)), func(c viewCase) bool {
+		return overflowShape(gridOf(c)) == ""
+	})
+	// cursorCases: the same for the real cursor, the overflow of the cursor's row
+	// filtered out.
+	cursorCases = zootest.Only(zootest.NoKnown, "bubbles/16", viewCasesOf(noExtras, texts, rowsAt, colsAt, hegel.Just(true)), func(c viewCase) bool {
+		m := c.build()
+		return rowShape(rowAt(grid(m), m.cursorLineNumber()), m.width) == ""
+	})
+)
+
+// grid returns the library's wrap rows of every logical line.
+func grid(m Model) [][][]rune {
+	var g [][][]rune
+	for _, l := range m.value {
+		g = append(g, wrap(l, m.width))
+	}
+	return g
+}
+
+// gridOf is the grid a case's value will have, with the rows' width.
+func gridOf(c viewCase) ([][][]rune, int) {
+	m := c.start.build()
+	m.SetValue(c.text)
+	return grid(m), m.width
+}
+
+func visualRows(g [][][]rune) int {
+	t := 0
+	for _, rows := range g {
+		t += len(rows)
+	}
+	return t
+}
+
+// rowAt returns the runes of visual row v of the grid.
+func rowAt(g [][][]rune, v int) []rune {
+	for _, rows := range g {
+		if v < len(rows) {
+			return rows[v]
+		}
+		v -= len(rows)
+	}
+	return nil
+}
+
+func rowsOf(g [][][]rune) []string {
+	var out []string
+	for _, rows := range g {
+		for _, r := range rows {
+			out = append(out, string(r))
+		}
+	}
+	return out
+}
+
+// shownRow is a wrap row as the view must show it: one trailing space trimmed when
+// the row is wider than the width (the wrap's trailing space).
+func shownRow(r []rune, width int) string {
+	text := string(r)
+	if uniseg.StringWidth(text) > width {
+		text = strings.TrimSuffix(text, " ")
+	}
+	return text
+}
+
+// rowShape names bubbles/16's shape: a wrap row wider than the width once its
+// trailing space is trimmed (a word of width-1 columns and a wide rune), which
+// the view cuts.
+func rowShape(r []rune, width int) string {
+	if uniseg.StringWidth(shownRow(r, width)) > width {
+		return "bubbles/16"
+	}
+	return ""
+}
+
+// overflowShape names bubbles/16's shape when any row of the grid has it.
+func overflowShape(g [][][]rune, width int) string {
+	for _, rows := range g {
+		for _, r := range rows {
+			if s := rowShape(r, width); s != "" {
+				return s
+			}
+		}
+	}
+	return ""
+}
+
+// startShape names bubbles/22's shape: a MaxWidth no larger than the prompt and
+// the gutter, which leaves the text no column.
+func startShape(s viewStart) string {
+	if promptW, gutterW := s.reserved(); s.maxWidth > 0 && s.maxWidth <= promptW+gutterW {
+		return "bubbles/22"
+	}
+	return ""
+}
+
+// gutterShape names bubbles/18's shape: line numbers and more lines than
+// MaxHeight's digits can number (MaxHeight 0, "no limit", reserves one digit),
+// so that the numbers from 10 on push their text right.
+func gutterShape(s viewStart, lines int) string {
+	if s.lineNumbers && len(strconv.Itoa(lines)) > len(strconv.Itoa(s.maxHeight)) {
+		return "bubbles/18"
+	}
+	return ""
+}
+
+// placeholderShape names bubbles/23's shape: a placeholder of white space, which
+// the library trims to nothing and then draws no cursor for.
+func placeholderShape(s viewStart) string {
+	if s.placeholder != "" && strings.TrimSpace(s.placeholder) == "" {
+		return "bubbles/23"
+	}
+	return ""
+}
+
+// judgeView compares the view with the grid: height rows of prompt + gutter +
+// width cells; the rows from the scroll offset on show the wrap rows (line
+// number on a line's first row, blank on continuation rows, one trailing space
+// trimmed when the row overflows, padding to the width), then end-of-buffer
+// rows; the cursor's row is visible and its cell, at gutter + CharOffset, is the
+// only reversed one and holds the rune under the cursor. With an empty value
+// and a placeholder the first row shows the placeholder with the cursor on its
+// first cell. The wide and the narrow properties share it.
+func judgeView(j *zootest.Judge, c viewCase) {
+	j.Shape(startShape(c.start))
+	m := c.build()
+	promptW, gutterW := c.start.reserved()
+	width := c.start.textWidth()
+	if m.Width() != width {
+		j.Fail("Width() is %d, want %d (SetWidth(%d), %d reserved)", m.Width(), width, c.start.width+promptW+gutterW, promptW+gutterW)
+	}
+	g := grid(m)
+	li := m.LineInfo()
+	cursorRow := m.cursorLineNumber()
+	yoff := m.viewport.YOffset()
+	height := c.start.height
+	digits := len(strconv.Itoa(c.start.maxHeight))
+	if !c.settle && cursorRow >= yoff+height {
+		// bubbles/19: SetValue leaves the viewport at the top with the cursor below it.
+		j.Shape("bubbles/19")
+	}
+	j.Shape(overflowShape(g, width))
+	j.Shape(gutterShape(c.start, len(m.value)))
+	fullW := promptW + gutterW + width
+	gutter := func(n int) string {
+		if !c.start.lineNumbers {
+			return ""
+		}
+		if n > 0 {
+			return fmt.Sprintf(" %*d ", digits, n)
+		}
+		return fmt.Sprintf(" %*s ", digits, " ")
+	}
+	eob := m.Prompt + string(m.EndOfBufferCharacter) + strings.Repeat(" ", max(0, width-1+gutterW))
+
+	// expected plain rows and the cursor cell
+	var rows []string
+	wantRow, wantCol, cursorRune := cursorRow, promptW+gutterW+li.CharOffset, " "
+	if m.Value() == "" && c.start.placeholder != "" {
+		j.Shape(placeholderShape(c.start))
+		p := strings.TrimSpace(c.start.placeholder)
+		rows = append(rows, m.Prompt+gutter(1)+p+strings.Repeat(" ", max(0, width-uniseg.StringWidth(p))))
+		wantRow, wantCol = 0, promptW+gutterW
+		if p != "" {
+			cursorRune = string([]rune(p)[0])
+		}
+	} else {
+		for l, wrapped := range g {
+			for k, r := range wrapped {
+				text := shownRow(r, width)
+				text += strings.Repeat(" ", max(0, width-uniseg.StringWidth(text)))
+				number := 0 // a continuation row has none
+				if k == 0 {
+					number = l + 1
+				}
+				rows = append(rows, m.Prompt+gutter(number)+text)
+			}
+		}
+		if li.ColumnOffset < len(rowAt(g, cursorRow)) {
+			cursorRune = string(rowAt(g, cursorRow)[li.ColumnOffset])
+		}
+	}
+	for len(rows) < yoff+height {
+		rows = append(rows, eob)
+	}
+
+	lines := strings.Split(strings.TrimSuffix(m.View(), "\n"), "\n")
+	if len(lines) != height {
+		j.Fail("view has %d rows, want height %d:\n%s", len(lines), height, m.View())
+	}
+	if wantRow < yoff || wantRow >= yoff+height {
+		j.Fail("cursor row %d not in the view [%d,%d)", wantRow, yoff, yoff+height)
+	}
+	for i, line := range lines {
+		cells := zootest.Cells(line)
+		want := rows[yoff+i]
+		plain := zootest.Plain(cells)
+		if zootest.Width(cells) != fullW || strings.TrimRight(plain, " ") != strings.TrimRight(want, " ") {
+			j.Fail("row %d (visual %d) is %q (%d cells), want %q (%d cells)\nvalue %q width %d rows %q",
+				i, yoff+i, zootest.String(cells), zootest.Width(cells), want, fullW, m.Value(), width, rowsOf(g))
+		}
+		// the cursor cell
+		col, reversed := 0, 0
+		for _, cell := range cells {
+			if cell.Rev {
+				reversed++
+				if yoff+i != wantRow || col != wantCol || cell.S != cursorRune {
+					j.Fail("reversed cell %q at (%d,%d), want %q at (%d,%d)\nvalue %q width %d li %+v rows %q",
+						cell.S, col, yoff+i, cursorRune, wantCol, wantRow, m.Value(), width, li, rowsOf(g))
+				}
+			}
+			col += cell.W
+		}
+		if yoff+i == wantRow && reversed != 1 {
+			j.Fail("row %d has %d reversed cells, want the cursor %q at column %d\nview row %s", i, reversed, cursorRune, wantCol, zootest.String(cells))
+		}
+	}
+}
+
+// TestHegelViewShowsTheWrappedRows: the view is height rows of prompt +
+// gutter + text width cells; the rows from the scroll offset on show the
+// wrap grid's rows (line number on a line's first row, blank on
+// continuation rows, one trailing space trimmed when the row overflows,
+// padding to the width), then end-of-buffer rows; the cursor's row is
+// visible and its cell, at gutter + CharOffset, is the only reversed one and
+// holds the rune under the cursor.
+func TestHegelViewShowsTheWrappedRows(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, viewCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeView(j, c)
+	})
+}
+
+// judgeCursor: the real cursor's position is the virtual cursor's cell, and
+// PositionAt of that cell is the cursor's position in the buffer.
+func judgeCursor(j *zootest.Judge, c viewCase) {
+	m := c.build()
+	g := grid(m)
+	j.Shape(rowShape(rowAt(g, m.cursorLineNumber()), m.width)) // the cursor's row is cut
+	x, y := -1, -1
+	for i, line := range strings.Split(strings.TrimSuffix(m.View(), "\n"), "\n") {
+		col := 0
+		for _, cell := range zootest.Cells(line) {
+			if cell.Rev {
+				x, y = col, i
+			}
+			col += cell.W
+		}
+	}
+	if x < 0 {
+		j.Fail("no virtual cursor in the view of %q", m.Value())
+	}
+	real := m
+	real.SetVirtualCursor(false)
+	cur := real.Cursor()
+	if cur == nil || cur.Position.X != x || cur.Position.Y != y {
+		j.Fail("real cursor %+v, virtual at (%d,%d); value %q cursor (%d,%d) width %d",
+			cur, x, y, m.Value(), m.Line(), m.Column(), m.Width())
+	}
+	p := m.PositionAt(x, y)
+	if p.Row != m.Line() || p.Col != m.Column() {
+		j.Fail("PositionAt(%d,%d) = %+v, cursor (%d,%d); value %q width %d rows %q",
+			x, y, p, m.Line(), m.Column(), m.Value(), m.Width(), rowsOf(g))
+	}
+}
+
+// TestHegelRealCursorAndPositionAtAgree: the real cursor's position is the
+// virtual cursor's cell, and PositionAt of that cell is the cursor's
+// position in the buffer.
+func TestHegelRealCursorAndPositionAtAgree(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cursorCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- vertical motion
+
+// motionCase is a view case and the Up and Down presses after it.
+type motionCase struct {
+	view  viewCase
+	moves []string
+}
+
+func (c motionCase) GoString() string {
+	return c.view.GoString() + ": " + strings.Join(c.moves, ", ")
+}
+
+func motionCasesOf(views hegel.Generator[viewCase], moves hegel.Generator[[]string]) hegel.Generator[motionCase] {
+	return hegel.Composite(func(tc hegel.TestCase) motionCase {
+		return motionCase{view: hegel.Draw(tc, views), moves: hegel.Draw(tc, moves)}
+	})
+}
+
+var (
+	moves = zootest.Sampled("down", "up")
+	// motionCases: a settled value with the cursor anywhere and one to six presses;
+	// under HEGEL_NO_KNOWN=1 the presses that would reach bubbles/14 are left out
+	// (unshapedMoves).
+	motionCases = hegel.Map(motionCasesOf(viewCasesOf(noExtras, texts, rowsAt, colsAt, hegel.Just(true)), zootest.Counted(moves, 1, 6)), unshapedMoves)
+)
+
+// unshapedMoves is the case with, under HEGEL_NO_KNOWN=1, every press that would
+// reach bubbles/14's shape from where the presses before it leave the cursor
+// left out: the textarea is replayed over the presses kept so far.
+func unshapedMoves(c motionCase) motionCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	m := c.view.build()
+	g := grid(m)
+	var kept []string
+	for _, dir := range c.moves {
+		if motionShape(m, g, dir) != "" {
+			continue
+		}
+		m = press(m, keys[dir])
+		kept = append(kept, dir)
+	}
+	return motionCase{view: c.view, moves: kept}
+}
+
+// motionShape names bubbles/14's shape before a press, from the grid and the
+// cursor's row: the library steps between the rows of a line by rune index, two
+// runes into the next row (so a row of two runes or fewer that is not the last is
+// skipped, and a last row of one rune, the wrap's lone trailing space, is not
+// reached or, from itself, is left upwards), two runes back into the previous
+// row (so a previous row of one rune is skipped and one of two runes, reported
+// with the row before's CharWidth, is walked through when the remembered column
+// is past it), and then walks to the remembered column over the row it landed
+// on, which runs off a row whose last rune is wide.
+func motionShape(m Model, g [][][]rune, dir string) string {
+	rows := g[m.row]
+	li := m.LineInfo()
+	i := li.RowOffset
+	goal := max(m.lastCharOffset, li.CharOffset)
+	var target []rune
+	switch {
+	case dir == "down" && i < len(rows)-1:
+		next := rows[i+1]
+		if i+1 < len(rows)-1 && len(next) <= 2 || i+1 == len(rows)-1 && len(next) == 1 {
+			return "bubbles/14"
+		}
+		target = next
+	case dir == "down" && m.row < len(g)-1:
+		target = g[m.row+1][0]
+	case dir == "down":
+		if len(rows[i]) == 1 && len(m.value[m.row]) > 0 {
+			return "bubbles/14"
+		}
+		target = rows[i]
+	case dir == "up" && i > 0:
+		prev := rows[i-1]
+		if i-1 > 0 && (len(prev) == 1 || len(prev) == 2 && goal >= 2 && uniseg.StringWidth(string(rows[i-2])) >= 3) {
+			return "bubbles/14"
+		}
+		target = prev
+	case dir == "up" && m.row > 0:
+		above := g[m.row-1]
+		target = above[len(above)-1]
+	default:
+		target = rows[i]
+	}
+	if len(target) > 0 && isWide(target[len(target)-1]) && goal >= uniseg.StringWidth(string(target))-1 {
+		return "bubbles/14"
+	}
+	return ""
+}
+
+// judgeMotion: Up and Down move the cursor by exactly one row of the wrap grid
+// (none at the edges) and never change the value.
+func judgeMotion(j *zootest.Judge, c motionCase) {
+	m := c.view.build()
+	g := grid(m)
+	total := visualRows(g)
+	value := m.Value()
+	for _, dir := range c.moves {
+		j.Shape(motionShape(m, g, dir))
+		before := m.cursorLineNumber()
+		want := before
+		if dir == "down" && want < total-1 {
+			want++
+		}
+		if dir == "up" && want > 0 {
+			want--
+		}
+		m = press(m, keys[dir])
+		got := m.cursorLineNumber()
+		j.Note("%s: visual row %d -> %d (cursor %d,%d)", dir, before, got, m.Line(), m.Column())
+		if m.Value() != value {
+			j.Fail("value changed by %s: %q -> %q", dir, value, m.Value())
+		}
+		if m.Column() < 0 || m.Column() > len(m.value[m.Line()]) {
+			j.Fail("cursor column %d out of line %q", m.Column(), string(m.value[m.Line()]))
+		}
+		if got != want {
+			j.Fail("width %d value %q: %s from visual row %d landed on %d, want %d (rows %q)",
+				m.Width(), value, dir, before, got, want, rowsOf(g))
+		}
+	}
+}
+
+// TestHegelVerticalMotionMovesOneVisualRow: Up and Down move the cursor by
+// exactly one row of the wrap grid (none at the edges) and never change the
+// value.
+func TestHegelVerticalMotionMovesOneVisualRow(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, motionCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeMotion(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- LineInfo
+
+// lineInfoCase is a start, a one-line value and the cursor's column.
+type lineInfoCase struct {
+	start viewStart
+	value string
+	col   int
+}
+
+func (c lineInfoCase) GoString() string {
+	return fmt.Sprintf("%s: SetValue(%q), column %d", c.start.String(), c.value, c.col)
+}
+
+// lineInfoCasesOf: the column from colsOf, given the value's rows (every column
+// by default; under HEGEL_NO_KNOWN=1 none at the end of a row that is not the
+// last, bubbles/15's shape).
+func lineInfoCasesOf(starts hegel.Generator[viewStart], values hegel.Generator[string], colsOf func(rows [][]rune, n int) hegel.Generator[int]) hegel.Generator[lineInfoCase] {
+	return hegel.Composite(func(tc hegel.TestCase) lineInfoCase {
+		c := lineInfoCase{start: hegel.Draw(tc, starts), value: hegel.Draw(tc, values)}
+		rs := []rune(c.value)
+		c.col = hegel.Draw(tc, colsOf(wrap(rs, c.start.textWidth()), len(rs)))
+		return c
+	})
+}
+
+// anyColumn: a column of the value, 0 to its length.
+func anyColumn(_ [][]rune, n int) hegel.Generator[int] { return zootest.Ints(0, n) }
+
+// insideRows: a column that is not the end of a row other than the last.
+func insideRows(rows [][]rune, n int) hegel.Generator[int] {
+	ends := map[int]bool{}
+	start := 0
+	for i, r := range rows {
+		start += len(r)
+		if i+1 < len(rows) {
+			ends[start] = true
+		}
+	}
+	var cols []int
+	for c := 0; c <= n; c++ {
+		if !ends[c] {
+			cols = append(cols, c)
+		}
+	}
+	return zootest.Sampled(cols...)
+}
+
+var lineInfoCases = lineInfoCasesOf(
+	viewStartsOf(prompts, lineNums, maxHeight, viewWide, hegel.Just(3), hegel.Just(0), hegel.Just("")),
+	textsOf(runes, 0, 24),
+	zootest.Shaped(anyColumn, insideRows),
+)
+
+// lineInfoShape names bubbles/15's shape: the cursor at the end of a row that is
+// not the last, which LineInfo reports as the start of the next row.
+func lineInfoShape(rows [][]rune, col int) string {
+	start := 0
+	for i, r := range rows {
+		start += len(r)
+		if start == col && i+1 < len(rows) {
+			return "bubbles/15"
+		}
+	}
+	return ""
+}
+
+// judgeLineInfo: LineInfo reports the wrap row the cursor is on (the next row
+// when at the end of a row that is not the last), its rune count and display
+// width, and the cursor's offsets within it.
+func judgeLineInfo(j *zootest.Judge, c lineInfoCase) {
+	m := c.start.build()
+	m.SetValue(c.value)
+	m.SetCursorColumn(c.col)
+	rows := wrap(m.value[0], m.width)
+	j.Shape(lineInfoShape(rows, m.col))
+	want := LineInfo{Height: len(rows)}
+	start := 0
+	for i, r := range rows {
+		if start+len(r) == m.col && i+1 < len(rows) {
+			want.RowOffset, want.StartColumn = i+1, m.col
+			want.Width, want.CharWidth = len(rows[i+1]), uniseg.StringWidth(string(rows[i+1]))
+			break
+		}
+		if start+len(r) >= m.col {
+			want.RowOffset, want.StartColumn = i, start
+			want.Width, want.CharWidth = len(r), uniseg.StringWidth(string(r))
+			want.ColumnOffset = m.col - start
+			want.CharOffset = uniseg.StringWidth(string(r[:want.ColumnOffset]))
+			break
+		}
+		start += len(r)
+	}
+	if got := m.LineInfo(); got != want {
+		j.Fail("value %q width %d col %d: LineInfo %+v, want %+v (rows %q)",
+			m.Value(), m.width, m.col, got, want, rowsOf([][][]rune{rows}))
+	}
+}
+
+// TestHegelLineInfoDescribesTheWrappedRow: LineInfo reports the wrap row the
+// cursor is on (the next row when at the end of a row that is not the last),
+// its rune count and display width, and the cursor's offsets within it.
+func TestHegelLineInfoDescribesTheWrappedRow(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lineInfoCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeLineInfo(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func pinArea(width, height int) Model {
+	m := New()
+	m.Focus()
+	m.Prompt = "> "
+	m.SetWidth(width + 2 + 4)
+	m.SetHeight(height)
+	return m
+}
+
+func plainRows(v string) []string {
+	var out []string
+	for _, l := range strings.Split(strings.TrimSuffix(v, "\n"), "\n") {
+		out = append(out, zootest.String(zootest.Cells(l)))
+	}
+	return out
+}
+
+// bubbles/13: Delete on the last rune of a line also joins the next line.
+func TestHegelPinDeleteOnTheLastRuneJoinsTheNextLine(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m.SetValue("ab\ncd")
+	m.MoveToBegin()
+	m.SetCursorColumn(1)
+	m = press(m, kDelete)
+	if m.Value() != "a\ncd" {
+		t.Fatalf("delete on 'b' of \"ab\\ncd\": value %q, want \"a\\ncd\"", m.Value())
+	}
+}
+
+// bubbles/14: Down skips a wrapped row of two runes or fewer and Up sticks
+// below it.
+func TestHegelPinVerticalMotionSkipsShortWrappedRows(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abcd e fghi") // rows "abcd ", "e ", "fghi "
+	m.MoveToBegin()
+	m = press(m, kDown)
+	if r := m.cursorLineNumber(); r != 1 {
+		t.Errorf("down from row 0 landed on visual row %d (col %d), want 1", r, m.Column())
+	}
+	m.MoveToEnd()
+	m = press(m, kUp)
+	if r := m.cursorLineNumber(); r != 1 {
+		t.Errorf("up from row 2 landed on visual row %d (col %d), want 1", r, m.Column())
+	}
+}
+
+// bubbles/15: LineInfo at the start of a wrapped row reports the previous
+// row's CharWidth.
+func TestHegelPinLineInfoCharWidthIsThePreviousRows(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abc defgh") // rows "abc ", "defgh "
+	m.SetCursorColumn(4)
+	li := m.LineInfo()
+	if li.RowOffset != 1 || li.Width != 6 {
+		t.Fatalf("unexpected LineInfo %+v", li)
+	}
+	if li.CharWidth != 6 {
+		t.Fatalf("LineInfo at the start of row \"defgh \": CharWidth %d, want 6 (Width %d)", li.CharWidth, li.Width)
+	}
+}
+
+// bubbles/16: a double-width rune after width-1 columns of a word makes a
+// wrap row wider than the width; the view truncates it and the rune is gone.
+func TestHegelPinWideRuneOverflowsTheRowAndVanishes(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abcd日")
+	rows := wrap([]rune("abcd日"), 5)
+	if w := uniseg.StringWidth(string(rows[0])); w > 5 {
+		t.Errorf("wrap row %q is %d columns wide in a width of 5", string(rows[0]), w)
+	}
+	if v := m.View(); !strings.Contains(v, "日") {
+		t.Errorf("the view of \"abcd日\" does not contain 日:\n%s", strings.Join(plainRows(v), "\n"))
+	}
+}
+
+// bubbles/17: CharLimit is measured in display columns, so two CJK
+// characters exhaust a limit of 4 and a paste of three passes it.
+func TestHegelPinCharLimitCountsColumns(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m.CharLimit = 4
+	m.SetValue("日本")
+	m = press(m, typed('語'))
+	if m.Value() != "日本語" {
+		t.Errorf("CharLimit 4 after \"日本\": typing 語 gives %q, want \"日本語\"", m.Value())
+	}
+	m = pinArea(20, 4)
+	m.CharLimit = 4
+	m = press(m, tea.PasteMsg{Content: "日本語漢字"})
+	if m.Value() != "日本語漢" {
+		t.Errorf("CharLimit 4: pasting five CJK characters gives %q (Length %d), want \"日本語漢\"", m.Value(), m.Length())
+	}
+}
+
+// bubbles/18: the line-number gutter is sized at render time from
+// MaxHeight's digits while the text width was fixed by SetWidth; with
+// MaxHeight 0 ("no limit") line 10 pushes the text one column right.
+func TestHegelPinNoLimitGutterShiftsTheText(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 12)
+	m.MaxHeight = 0
+	m.SetHeight(12)
+	m.SetValue(strings.Repeat("x\n", 11) + "x")
+	rows := plainRows(m.View())
+	col := func(r string) int { return strings.Index(zootest.Plain(zootest.Cells(r)), "x") }
+	if col(rows[0]) != col(rows[9]) {
+		t.Fatalf("MaxHeight 0: the text starts at column %d on line 1 and %d on line 10:\n%s\n%s", col(rows[0]), col(rows[9]), rows[0], rows[9])
+	}
+}
+
+// bubbles/19: SetValue (and InsertString) leave the viewport at the top
+// while the cursor is on the last line; View shows the first lines and
+// Cursor() points below the textarea until the next message.
+func TestHegelPinSetValueDoesNotScrollToTheCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.SetValue("l1\nl2\nl3\nl4\nl5\nl6")
+	if m.Line() != 5 {
+		t.Fatalf("cursor on line %d, want 5", m.Line())
+	}
+	m.SetVirtualCursor(false)
+	c := m.Cursor()
+	if m.ScrollYOffset() != 3 || c.Position.Y != 2 {
+		t.Fatalf("after SetValue of six lines in a height of 3: ScrollYOffset %d (want 3), Cursor().Y %d (want 2); view:\n%s",
+			m.ScrollYOffset(), c.Position.Y, strings.Join(plainRows(m.View()), "\n"))
+	}
+}
+
+// bubbles/20: CRLF line breaks are doubled by the sanitizer.
+func TestHegelPinCRLFPasteDoublesTheLineBreaks(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m = press(m, tea.PasteMsg{Content: "a\r\nb"})
+	if m.Value() != "a\nb" {
+		t.Fatalf("pasting \"a\\r\\nb\" gives %q, want \"a\\nb\"", m.Value())
+	}
+}
+
+// bubbles/21: MaxHeight refuses Enter at the limit but a paste adds lines
+// past it.
+func TestHegelPinPasteIgnoresMaxHeight(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.MaxHeight = 3
+	m.SetHeight(3)
+	m.SetValue("a\nb\nc")
+	m = press(m, kEnter)
+	if m.LineCount() != 3 {
+		t.Fatalf("Enter at MaxHeight 3 gave %d lines", m.LineCount())
+	}
+	m = press(m, tea.PasteMsg{Content: "x\ny\nz"})
+	if m.LineCount() > 3 {
+		t.Fatalf("a paste at MaxHeight 3 gave %d lines: %q", m.LineCount(), m.Value())
+	}
+}
+
+// bubbles/22: a MaxWidth below the prompt and gutter width drives the text
+// width negative and the view shows no text.
+func TestHegelPinSmallMaxWidthHidesTheText(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.MaxWidth = 3
+	m.SetWidth(20)
+	if m.Width() < 1 {
+		t.Errorf("MaxWidth 3: Width() = %d, want at least 1", m.Width())
+	}
+	m = press(m, typed('a'))
+	if v := m.View(); !strings.Contains(v, "a") {
+		t.Errorf("MaxWidth 3: the typed 'a' is not in the view %q", plainRows(v)[0])
+	}
+}
+
+// bubbles/23: a placeholder of white space (trimmed to nothing) renders no
+// cursor at all.
+func TestHegelPinBlankPlaceholderHasNoCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.Placeholder = "   "
+	for _, c := range zootest.Cells(strings.Split(m.View(), "\n")[0]) {
+		if c.Rev {
+			return
+		}
+	}
+	t.Fatalf("no reversed (cursor) cell in the first row of a focused textarea with a blank placeholder: %q", plainRows(m.View())[0])
+}
+
+// bubbles/25: Enter ignores CharLimit; the newline counts in Length, which
+// then exceeds the limit.
+func TestHegelPinEnterIgnoresCharLimit(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.CharLimit = 2
+	m.SetValue("ab")
+	m = press(m, kEnter)
+	if m.Length() > 2 {
+		t.Fatalf("CharLimit 2 after \"ab\": Enter gives %q, Length %d", m.Value(), m.Length())
+	}
+}
+
+// bubbles/26: an empty keyboard selection (shift+right at the end of the
+// buffer) keeps its anchor through later edits, so the next shift+arrow
+// selects from where the cursor was.
+func TestHegelPinEmptySelectionKeepsAStaleAnchor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue("o")
+	m = press(m, kSelRight) // nothing to select past the end
+	m = press(m, kKillBack) // line is now empty
+	for _, r := range "abc" {
+		m = press(m, typed(r))
+	}
+	m = press(m, kSelLeft)
+	if got := m.SelectedText(); got != "c" {
+		t.Errorf("shift+left after typing \"abc\" selects %q, want \"c\"", got)
+	}
+	// and when the anchor's line has been deleted, the next edit panics
+	m = pinArea(20, 3)
+	m.SetValue("a\n")
+	m = press(m, kSelRight)  // empty selection anchored at (1,0)
+	m = press(m, kBackspace) // joins the lines: line 1 is gone
+	m = press(m, kSelLeft)   // selection from the stale (1,0) to (0,0)
+	m = press(m, typed('x')) // deleteSelection indexes value[1]
+	if m.Value() != "x" && m.Value() != "ax" {
+		t.Errorf("value %q after the stale selection", m.Value())
+	}
+}
+
+// bubbles/24: ctrl+w on the first word of a line also deletes the space
+// before it.
+func TestHegelPinTextareaDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w after \" ab\": value %q, want \" \"", m.Value())
+	}
+}
diff --git a/textinput/hegel_shapes_test.go b/textinput/hegel_shapes_test.go
new file mode 100644
index 0000000..fe3fb44
--- /dev/null
+++ b/textinput/hegel_shapes_test.go
@@ -0,0 +1,393 @@
+package textinput
+
+// The shape regions of the recorded textinput bugs (bugs.toml bubbles/1 to 12 and 98) and
+// the narrow properties over them: each region is a generator over the bug's shape
+// with random contents, judged exactly like the wide property of its kind
+// (judgeEditing, judgePlaceholder, judgeSuggestions, judgeCursor). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (zootest.Shaped) and the property passes. Every
+// shape is deterministic in the library, so every instance reaches the bug
+// (measured with math/rand over the library: 1000 of 1000 for each of the
+// constructions below). The shapes of bubbles/2 and 4 (the placeholder without a
+// width, with a negative one), 12 and 98 (EchoNone) are drawn by the wide properties
+// too; the others are relations the wide properties reach at their natural rates.
+
+import (
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowEditing, narrowPlaceholder, narrowSuggestions and narrowCursor run a narrow
+// property: every drawn case through the wide property's judge.
+func narrowEditing(t *testing.T, cases hegel.Generator[inputCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeEditing(j, c)
+	})
+}
+
+func narrowPlaceholder(t *testing.T, cases hegel.Generator[placeholderCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePlaceholder(j, c)
+	})
+}
+
+func narrowSuggestions(t *testing.T, cases hegel.Generator[sugCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSuggestions(j, c)
+	})
+}
+
+func narrowCursor(t *testing.T, cases hegel.Generator[cursorCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+var (
+	// wordRunes: the runes of a word (no space); narrowWordRunes: the same without
+	// the wide runes; narrowPlaceholderRunes: ASCII three times in five, else a
+	// narrow rune.
+	wordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, wideRunes),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+	narrowWordRunes = zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+	narrowPlaceholderRunes = zootest.Weighted(zootest.W(6, asciiRunes), zootest.W(4, narrowRunes))
+
+	noValidator = hegel.Just(validator{kind: "none"})
+)
+
+func words(lo, hi int) hegel.Generator[string] { return textsOf(wordRunes, lo, hi) }
+
+func initialOf(values hegel.Generator[string]) hegel.Generator[initial] {
+	return hegel.Map(values, func(s string) initial { return initial{set: true, s: s} })
+}
+
+// plainStart: a start with the width and value given, no limit, no validator,
+// EchoNormal.
+func plainStart(widths hegel.Generator[int], values hegel.Generator[string]) hegel.Generator[inputStart] {
+	return startsOf(widths, hegel.Just(0), noValidator, hegel.Just(EchoNormal), initialOf(values))
+}
+
+func opsOf(kinds ...string) []inputOp {
+	ops := make([]inputOp, len(kinds))
+	for i, k := range kinds {
+		ops[i] = inputOp{kind: k}
+	}
+	return ops
+}
+
+// --------------------------------------------------------------------------- bubbles/1
+
+// deleteWordForwardOnTheLastRune: a value of up to six runes, a non-space rune
+// under the cursor and, after it, nothing (alt+d on the last rune: a panic) or a
+// space and a word (deleteWordForward steps over the rune and deletes the next
+// word too); past the shape, more runes of the same word after it.
+var deleteWordForwardOnTheLastRune = hegel.Composite(func(tc hegel.TestCase) inputCase {
+	head := hegel.Draw(tc, textsOf(runes, 0, 6))
+	under := hegel.Draw(tc, wordRunes)
+	tail := hegel.Draw(tc, zootest.Shaped(
+		zootest.Weighted(
+			zootest.W(1, hegel.Just("")),
+			zootest.W(1, hegel.Map(words(1, 6), func(w string) string { return " " + w })),
+		),
+		words(1, 6),
+	))
+	start := hegel.Draw(tc, plainStart(hegel.Just(0), hegel.Just(head+string(under)+tail)))
+	return inputCase{start: start, ops: []inputOp{{kind: "setcursor", n: len([]rune(head))}, {kind: "alt+d"}}}
+})
+
+func TestHegelTextinputDeleteWordForwardOnTheLastRune(t *testing.T) {
+	narrowEditing(t, deleteWordForwardOnTheLastRune)
+}
+
+// --------------------------------------------------------------------------- bubbles/2
+
+// placeholderWithoutAWidth: a placeholder of two to twenty narrow runes and no
+// width (past the shape, a width of 1 to 24).
+var placeholderWithoutAWidth = placeholderCasesOf(
+	textsOf(narrowPlaceholderRunes, 2, 20),
+	zootest.Shaped(hegel.Just(0), zootest.Ints(1, 24)),
+)
+
+func TestHegelTextinputPlaceholderWithoutAWidth(t *testing.T) {
+	narrowPlaceholder(t, placeholderWithoutAWidth)
+}
+
+// --------------------------------------------------------------------------- bubbles/3
+
+// widePlaceholderRunes: a width of 1 to 24 and a placeholder with a wide rune among
+// the runes the field shows (after up to width narrow ones), then up to five more;
+// past the shape, a narrow rune there and narrow ones after it.
+var widePlaceholderRunes = hegel.FlatMap(zootest.Ints(1, 24), func(w int) hegel.Generator[placeholderCase] {
+	placeholder := hegel.Composite(func(tc hegel.TestCase) string {
+		prefix := hegel.Draw(tc, textsOf(narrowPlaceholderRunes, 0, w))
+		r := hegel.Draw(tc, zootest.Shaped(wideRunes, narrowPlaceholderRunes))
+		rest := hegel.Draw(tc, textsOf(zootest.Shaped(runes, narrowRunes), 0, 5))
+		return prefix + string(r) + rest
+	})
+	return placeholderCasesOf(placeholder, hegel.Just(w))
+})
+
+func TestHegelTextinputWidePlaceholderRunes(t *testing.T) {
+	narrowPlaceholder(t, widePlaceholderRunes)
+}
+
+// --------------------------------------------------------------------------- bubbles/4
+
+// negativeWidthPlaceholder: a placeholder and a width of -5 to -1 (past the shape,
+// 1 to 24).
+var negativeWidthPlaceholder = placeholderCasesOf(
+	textsOf(narrowPlaceholderRunes, 1, 20),
+	zootest.Shaped(zootest.Ints(-5, -1), zootest.Ints(1, 24)),
+)
+
+func TestHegelTextinputNegativeWidthPlaceholder(t *testing.T) {
+	narrowPlaceholder(t, negativeWidthPlaceholder)
+}
+
+// --------------------------------------------------------------------------- bubbles/5
+
+func typeOps(s string) []sugOp {
+	var ops []sugOp
+	for _, r := range s {
+		ops = append(ops, sugOp{kind: "type", r: r})
+	}
+	return ops
+}
+
+// setValueKeepsStaleSuggestions: one to three suggestions, a prefix of the first
+// typed (so that it matches), then a Reset or a SetValue of a value matching
+// nothing (a "z" first), whose matches the library keeps, and a tab that completes
+// the wrong text or panics; past the shape, a SetValue of the typed prefix itself
+// (the same matches).
+var setValueKeepsStaleSuggestions = hegel.Composite(func(tc hegel.TestCase) sugCase {
+	sugs := hegel.Draw(tc, zootest.Counted(sugWords, 1, 3))
+	first := []rune(sugs[0])
+	k := hegel.Draw(tc, zootest.Ints(1, len(first)))
+	stale := hegel.Draw(tc, zootest.Shaped(
+		zootest.Weighted(
+			zootest.W(1, sugOpOf("reset")),
+			zootest.W(1, hegel.Map(sugWords, func(w string) sugOp { return sugOp{kind: "setvalue", s: "z" + w} })),
+		),
+		hegel.Just(sugOp{kind: "setvalue", s: string(first[:k])}),
+	))
+	ops := append(typeOps(string(first[:k])), stale, sugOp{kind: "tab"})
+	return sugCase{sugs: sugs, ops: ops}
+})
+
+func TestHegelTextinputSetValueKeepsStaleSuggestions(t *testing.T) {
+	narrowSuggestions(t, setValueKeepsStaleSuggestions)
+}
+
+// --------------------------------------------------------------------------- bubbles/6
+
+// prevSuggestionWithoutAMatch: none to three suggestions and nothing typed, or a
+// value matching none (a "z" first), then up, which takes the index to -1; past the
+// shape, a prefix of the first suggestion typed, then up.
+var prevSuggestionWithoutAMatch = zootest.Shaped(
+	hegel.Composite(func(tc hegel.TestCase) sugCase {
+		sugs := hegel.Draw(tc, zootest.Counted(sugWords, 0, 3))
+		typed := hegel.Draw(tc, zootest.Weighted(
+			zootest.W(1, hegel.Just("")),
+			zootest.W(2, hegel.Map(textsOf(sugAlphabet, 0, 3), func(w string) string { return "z" + w })),
+		))
+		return sugCase{sugs: sugs, ops: append(typeOps(typed), sugOp{kind: "up"})}
+	}),
+	hegel.Composite(func(tc hegel.TestCase) sugCase {
+		sugs := hegel.Draw(tc, zootest.Counted(sugWords, 1, 3))
+		first := []rune(sugs[0])
+		k := hegel.Draw(tc, zootest.Ints(1, len(first)))
+		return sugCase{sugs: sugs, ops: append(typeOps(string(first[:k])), sugOp{kind: "up"})}
+	}),
+)
+
+func TestHegelTextinputPrevSuggestionWithoutAMatch(t *testing.T) {
+	narrowSuggestions(t, prevSuggestionWithoutAMatch)
+}
+
+// --------------------------------------------------------------------------- bubbles/7
+
+// setWidthLeavesTheWindowWide: a value of two to fourteen narrow runes and then
+// SetWidth to less than its width, which leaves the window as it was, wider than
+// the field (past the shape, a width the value fits).
+var setWidthLeavesTheWindowWide = hegel.FlatMap(zootest.Ints(2, 14), func(n int) hegel.Generator[inputCase] {
+	return casesOf(
+		plainStart(hegel.Just(0), textsOf(narrowRunes, n, n)),
+		zootest.One(setWidthOp(zootest.Shaped(zootest.Ints(1, n-1), zootest.Ints(n, 14)))),
+	)
+})
+
+func TestHegelTextinputSetWidthLeavesTheWindowWide(t *testing.T) {
+	narrowEditing(t, setWidthLeavesTheWindowWide)
+}
+
+// --------------------------------------------------------------------------- bubbles/8
+
+var (
+	cursorPrompts = zootest.Sampled("> ", "", "Name: ")
+
+	// scrolledCursor: a width of 1 to 10, a longer value of narrow runes and the
+	// cursor set inside it, so that the window is scrolled.
+	scrolledCursor = hegel.FlatMap(zootest.Ints(1, 10), func(w int) hegel.Generator[cursorCase] {
+		return hegel.FlatMap(zootest.Ints(w+1, w+5), func(n int) hegel.Generator[cursorCase] {
+			return cursorCasesOf(hegel.Just(w), zootest.Counted(narrowRunes, n, n), zootest.One(zootest.Ints(1, n-1)))
+		})
+	})
+	// wideBeforeTheCursor: no width and a wide rune before the cursor.
+	wideBeforeTheCursor = hegel.Composite(func(tc hegel.TestCase) cursorCase {
+		prefix := hegel.Draw(tc, textsOf(narrowRunes, 0, 5))
+		wide := hegel.Draw(tc, wideRunes)
+		rest := hegel.Draw(tc, textsOf(narrowRunes, 0, 5))
+		value := prefix + string(wide) + rest
+		return cursorCase{
+			prompt:  hegel.Draw(tc, cursorPrompts),
+			value:   value,
+			cursors: []int{hegel.Draw(tc, zootest.Ints(len([]rune(prefix))+1, len([]rune(value))))},
+		}
+	})
+	// fittingCursor: a narrow value no longer than the width (or any length without
+	// one) and up to four cursor positions: the window never scrolls.
+	fittingCursor = hegel.FlatMap(cursorWidths, func(w int) hegel.Generator[cursorCase] {
+		hi := 14
+		if w > 0 {
+			hi = w
+		}
+		return cursorCasesOf(hegel.Just(w), zootest.Counted(narrowRunes, 0, hi), zootest.Counted(zootest.Ints(0, 14), 0, 4))
+	})
+
+	// realCursorInAScrolledWindow: the scrolled window two times in three, the wide
+	// rune one; past the shape, a value that fits.
+	realCursorInAScrolledWindow = zootest.Shaped(
+		zootest.Weighted(zootest.W(2, scrolledCursor), zootest.W(1, wideBeforeTheCursor)),
+		fittingCursor,
+	)
+)
+
+func TestHegelTextinputRealCursorInAScrolledWindow(t *testing.T) {
+	narrowCursor(t, realCursorInAScrolledWindow)
+}
+
+// --------------------------------------------------------------------------- bubbles/9
+
+var (
+	// quietOnEmpty: the keys that leave an empty value empty and Err as the
+	// validator says.
+	quietOnEmpty = hegel.Map(zootest.Sampled("left", "right", "home", "end", "delete", "ctrl+k", "ctrl+u"), func(k string) inputOp { return inputOp{kind: k} })
+
+	// backspaceOnAnEmptyRequiredField: a "required" validator (past the shape, none
+	// or a maximum), no value or SetValue(""), up to two quiet keys and a backspace,
+	// after which the library clears Err without asking the validator.
+	backspaceOnAnEmptyRequiredField = casesOf(
+		startsOf(widths, limits,
+			zootest.Shaped(hegel.Just(validator{kind: "required"}), zootest.Weighted(zootest.W(1, noValidator), zootest.W(1, hegel.Map(zootest.Ints(1, 6), func(k int) validator { return validator{kind: "max", k: k} })))),
+			hegel.Just(EchoNormal),
+			zootest.Maybe(50, hegel.Just(initial{set: true}))),
+		zootest.Seq(zootest.Counted(quietOnEmpty, 0, 2), hegel.Just(opsOf("backspace"))),
+	)
+)
+
+func TestHegelTextinputBackspaceOnAnEmptyRequiredField(t *testing.T) {
+	narrowEditing(t, backspaceOnAnEmptyRequiredField)
+}
+
+// --------------------------------------------------------------------------- bubbles/10
+
+// deleteWordBackwardAfterOneLeadingSpace: one space (past the shape, none or two),
+// a word, then nothing or a space and more, with ctrl+w at the word's end: the
+// library deletes the space before the word too.
+var deleteWordBackwardAfterOneLeadingSpace = hegel.Composite(func(tc hegel.TestCase) inputCase {
+	lead := hegel.Draw(tc, zootest.Shaped(hegel.Just(" "), zootest.Sampled("", "  ")))
+	word := hegel.Draw(tc, words(1, 6))
+	tail := hegel.Draw(tc, zootest.Weighted(
+		zootest.W(1, hegel.Just("")),
+		zootest.W(1, hegel.Map(textsOf(runes, 0, 6), func(t string) string { return " " + t })),
+	))
+	start := hegel.Draw(tc, plainStart(widths, hegel.Just(lead+word+tail)))
+	return inputCase{start: start, ops: []inputOp{{kind: "setcursor", n: len([]rune(lead + word))}, {kind: "ctrl+w"}}}
+})
+
+func TestHegelTextinputDeleteWordBackwardAfterOneLeadingSpace(t *testing.T) {
+	narrowEditing(t, deleteWordBackwardAfterOneLeadingSpace)
+}
+
+// --------------------------------------------------------------------------- bubbles/11
+
+// cursorScrolledPastTheWindow: a width of 1 to 10, a longer word of narrow runes,
+// home and then more rights than the window holds (past the shape, at most the
+// window's width): the window ends at the cursor and the rune under it is hidden.
+var cursorScrolledPastTheWindow = hegel.FlatMap(zootest.Ints(1, 10), func(w int) hegel.Generator[inputCase] {
+	return hegel.FlatMap(zootest.Ints(w+2, w+6), func(n int) hegel.Generator[inputCase] {
+		rights := hegel.Map(zootest.Shaped(zootest.Ints(w+1, n-1), zootest.Ints(0, w)), func(k int) []inputOp {
+			ops := opsOf("home")
+			for range k {
+				ops = append(ops, inputOp{kind: "right"})
+			}
+			return ops
+		})
+		return casesOf(plainStart(hegel.Just(w), textsOf(narrowWordRunes, n, n)), rights)
+	})
+})
+
+func TestHegelTextinputCursorScrolledPastTheWindow(t *testing.T) {
+	narrowEditing(t, cursorScrolledPastTheWindow)
+}
+
+// --------------------------------------------------------------------------- bubbles/12
+
+// echoNoneFieldShrinks: EchoNone (past the shape, EchoPassword), a width of 1 to
+// 12, a value of 1 to 14 narrow runes and a cursor key: the field is padded by the
+// hidden value's width. Narrow runes only: with a width of 1 and a wide rune last
+// the library's window is empty at the end of the value and the view is right by
+// luck (154 of 20000 with wide runes among the value's, none without; the wide
+// property draws them).
+var echoNoneFieldShrinks = casesOf(
+	startsOf(zootest.Ints(1, 12), hegel.Just(0), noValidator,
+		zootest.Shaped(hegel.Just(EchoNone), hegel.Just(EchoPassword)),
+		initialOf(textsOf(narrowRunes, 1, 14))),
+	zootest.One(hegel.Map(zootest.Sampled("left", "right", "home", "end"), func(k string) inputOp { return inputOp{kind: k} })),
+)
+
+func TestHegelTextinputEchoNoneFieldShrinks(t *testing.T) {
+	narrowEditing(t, echoNoneFieldShrinks)
+}
+
+// --------------------------------------------------------------------------- bubbles/98
+
+// echoNoneCursorInsideTheValue: EchoNone (past the shape, EchoPassword), no width, a
+// value of 1 to 14 narrow runes and home or left, which put the cursor inside the
+// value: the cursor cell is the echo of the rune under it, nothing, and the cursor
+// vanishes (1000 of 1000 by math/rand; with a width the field is bubbles/12's shape
+// first, so the region has none).
+var echoNoneCursorInsideTheValue = casesOf(
+	startsOf(hegel.Just(0), hegel.Just(0), noValidator,
+		zootest.Shaped(hegel.Just(EchoNone), hegel.Just(EchoPassword)),
+		initialOf(textsOf(narrowRunes, 1, 14))),
+	zootest.One(hegel.Map(zootest.Sampled("home", "left"), func(k string) inputOp { return inputOp{kind: k} })),
+)
+
+func TestHegelTextinputEchoNoneCursorInsideTheValue(t *testing.T) {
+	narrowEditing(t, echoNoneCursorInsideTheValue)
+}
diff --git a/textinput/hegel_test.go b/textinput/hegel_test.go
new file mode 100644
index 0000000..bafb7f0
--- /dev/null
+++ b/textinput/hegel_test.go
@@ -0,0 +1,1516 @@
+package textinput
+
+// Hegel property tests for the textinput bubble: a single-line editor with a
+// cursor, an optional width (a horizontally scrolling window), a character
+// limit, a validator, echo modes and prefix suggestions.
+//
+// The model is a rune slice with a cursor. A case is a record of the start (the
+// prompt, the width, the character limit, the validator, the echo mode, the
+// initial value) and a list of operation records (every key of the default key
+// map, pastes, SetValue, SetCursor, SetWidth and Reset) applied in order; after
+// each one Value, Position and Err must match the model, and View, parsed into
+// cells, must show the prompt, the echoed window of the value that holds the
+// cursor (the library's own offsets are read, being internal; the window never
+// wider than the field), the rune under the cursor in reverse video at the
+// cursor's column, and the padding that makes the field exactly Width+1 cells.
+//
+// The shapes of the recorded bugs are drawn like any other case, judged against
+// that model and fail naming them. bubbles/1, 7, 9, 10 and 11 (and 5, 6 and 8 of
+// the other properties) are relations between an operation and the live state,
+// declared by a classifier before each comparison; under HEGEL_NO_KNOWN=1 the
+// operations that would reach one are left out of the drawn list by replaying
+// the library and the model (unshaped), EchoNone (bubbles/12), no or a negative
+// width for the placeholder (2, 4) and wide placeholder runes (3) are not drawn,
+// and the cursor property's values fit the field.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var guard = zootest.Guard
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kTab         = keyOf(tea.KeyTab, 0)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+)
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+var (
+	errTooLong  = errors.New("too long")
+	errRequired = errors.New("required")
+)
+
+// validator is a case's Validate function: none, a maximum rune count or
+// "required" (the empty value rejected).
+type validator struct {
+	kind string
+	k    int
+}
+
+func (v validator) String() string {
+	if v.kind == "max" {
+		return fmt.Sprintf("max %d", v.k)
+	}
+	return v.kind
+}
+
+func (v validator) fn() ValidateFunc {
+	switch v.kind {
+	case "max":
+		k := v.k
+		return func(s string) error {
+			if len([]rune(s)) > k {
+				return errTooLong
+			}
+			return nil
+		}
+	case "required":
+		return func(s string) error {
+			if s == "" {
+				return errRequired
+			}
+			return nil
+		}
+	}
+	return nil
+}
+
+func lettersFrom(base rune) hegel.Generator[rune] {
+	return hegel.Map(zootest.Ints(0, 25), func(i int) rune { return base + rune(i) })
+}
+
+// runesOf: a letter one time in two, else a space, a wide rune (at the weight
+// given), a capital, a digit or mark, an accented letter (the old ladder's shares).
+func runesOf(wide int) hegel.Generator[rune] {
+	return zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(15, hegel.Just(' ')),
+		zootest.W(wide, wideRunes),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+}
+
+// textsOf: lo to hi runes as a string.
+func textsOf(rs hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(zootest.Counted(rs, lo, hi), func(rs []rune) string { return string(rs) })
+}
+
+var (
+	prompts   = zootest.Sampled("> ", "", "Name: ", "\u2192 ")
+	letters   = lettersFrom('a')
+	capitals  = lettersFrom('A')
+	wideRunes = zootest.Sampled('\u65e5', '\u672c', '\u8a9e', '\u6f22', '\u5b57')
+	marks     = zootest.Sampled([]rune("0123456789.,-_/")...)
+	accents   = zootest.Sampled('\u00e9', '\u00fc', '\u00f1')
+
+	runes       = runesOf(10)
+	narrowRunes = runesOf(0)
+	texts       = textsOf(runes, 0, 14)
+	// pasteRunes: a tab, a newline or a carriage return one time in ten, as a paste
+	// brings them.
+	pasteRunes = zootest.Weighted(zootest.W(9, runes), zootest.W(1, zootest.Sampled('\t', '\n', '\r')))
+	pastes     = textsOf(pasteRunes, 0, 8)
+
+	validators = zootest.Weighted(
+		zootest.W(1, hegel.Just(validator{kind: "none"})),
+		zootest.W(1, hegel.Map(zootest.Ints(1, 6), func(k int) validator { return validator{kind: "max", k: k} })),
+		zootest.W(1, hegel.Just(validator{kind: "required"})),
+	)
+	// echos: normal seven times in ten, password two, none one; EchoNone is never
+	// drawn under HEGEL_NO_KNOWN=1 (every non-empty value in a field with a width is
+	// bubbles/12's shape).
+	echos = zootest.Weighted(
+		zootest.W(7, hegel.Just(EchoNormal)),
+		zootest.W(2, hegel.Just(EchoPassword)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(EchoNone)),
+	)
+
+	// widths: a width of 1 to 12 three times in five; limits: a CharLimit of 1 to 8
+	// three times in ten; initials: a SetValue of up to 14 runes seven times in ten.
+	widths   = zootest.Maybe(60, zootest.Ints(1, 12))
+	limits   = zootest.Maybe(30, zootest.Ints(1, 8))
+	initials = zootest.Maybe(70, hegel.Map(texts, func(s string) initial { return initial{set: true, s: s} }))
+	starts   = startsOf(widths, limits, validators, echos, initials)
+
+	// motions: the cursor keys drawn as one alternative, as the old property had them.
+	motions = hegel.Map(zootest.Sampled("home", "end", "alt+b", "alt+f"), func(k string) inputOp { return inputOp{kind: k} })
+	editOps = editOpsOf(runes, pastes, texts)
+
+	// editCases: a start and one to forty operations; under HEGEL_NO_KNOWN=1 the
+	// operations that would reach a recorded bug are left out (unshaped).
+	editCases = hegel.Map(casesOf(starts, zootest.Counted(editOps, 1, 40)), unshaped)
+)
+
+// initial is the SetValue before the operations, if any.
+type initial struct {
+	set bool
+	s   string
+}
+
+// inputStart is the input a case starts from.
+type inputStart struct {
+	prompt   string
+	width    int // 0 for none
+	limit    int // 0 for none
+	validate validator
+	echo     EchoMode
+	value    initial
+}
+
+func (s inputStart) String() string {
+	parts := []string{fmt.Sprintf("prompt %q", s.prompt)}
+	if s.width > 0 {
+		parts = append(parts, fmt.Sprintf("width %d", s.width))
+	}
+	if s.limit > 0 {
+		parts = append(parts, fmt.Sprintf("limit %d", s.limit))
+	}
+	if s.validate.kind != "none" {
+		parts = append(parts, "validate "+s.validate.String())
+	}
+	switch s.echo {
+	case EchoPassword:
+		parts = append(parts, "EchoPassword")
+	case EchoNone:
+		parts = append(parts, "EchoNone")
+	}
+	if s.value.set {
+		parts = append(parts, fmt.Sprintf("SetValue(%q)", s.value.s))
+	}
+	return strings.Join(parts, " ")
+}
+
+// build makes the focused input and the model of the start.
+func (s inputStart) build() (Model, *editModel) {
+	m := New()
+	m.Focus()
+	m.Prompt = s.prompt
+	if s.width > 0 {
+		m.SetWidth(s.width)
+	}
+	e := &editModel{limit: s.limit, validate: s.validate.fn(), echo: s.echo}
+	m.CharLimit = s.limit
+	m.Validate = e.validate
+	m.EchoMode = s.echo
+	if s.value.set {
+		m.SetValue(s.value.s)
+		e.setValue(s.value.s)
+	}
+	return m, e
+}
+
+// startsOf: a start from the generators of its parts (the prompt from the table).
+func startsOf(widths, limits hegel.Generator[int], validators hegel.Generator[validator], echos hegel.Generator[EchoMode], values hegel.Generator[initial]) hegel.Generator[inputStart] {
+	return hegel.Composite(func(tc hegel.TestCase) inputStart {
+		return inputStart{
+			prompt:   hegel.Draw(tc, prompts),
+			width:    hegel.Draw(tc, widths),
+			limit:    hegel.Draw(tc, limits),
+			validate: hegel.Draw(tc, validators),
+			echo:     hegel.Draw(tc, echos),
+			value:    hegel.Draw(tc, values),
+		}
+	})
+}
+
+// inputOp is one operation: a typed rune, a key of the default key map, a paste,
+// SetValue, SetCursor (the position clamped by the library), Reset or SetWidth.
+type inputOp struct {
+	kind string
+	r    rune   // type
+	s    string // paste, setvalue
+	n    int    // setcursor, setwidth
+}
+
+func (o inputOp) GoString() string {
+	switch o.kind {
+	case "type":
+		return fmt.Sprintf("type %q", o.r)
+	case "paste":
+		return fmt.Sprintf("paste %q", o.s)
+	case "setvalue":
+		return fmt.Sprintf("SetValue(%q)", o.s)
+	case "setcursor":
+		return fmt.Sprintf("SetCursor(%d)", o.n)
+	case "setwidth":
+		return fmt.Sprintf("SetWidth(%d)", o.n)
+	}
+	return o.kind
+}
+
+func opOf(kind string) hegel.Generator[inputOp] { return hegel.Just(inputOp{kind: kind}) }
+
+func typeOp(rs hegel.Generator[rune]) hegel.Generator[inputOp] {
+	return hegel.Map(rs, func(r rune) inputOp { return inputOp{kind: "type", r: r} })
+}
+
+func pasteOp(texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return hegel.Map(texts, func(s string) inputOp { return inputOp{kind: "paste", s: s} })
+}
+
+func setValueOp(texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return hegel.Map(texts, func(s string) inputOp { return inputOp{kind: "setvalue", s: s} })
+}
+
+func setCursorOp(positions hegel.Generator[int]) hegel.Generator[inputOp] {
+	return hegel.Map(positions, func(p int) inputOp { return inputOp{kind: "setcursor", n: p} })
+}
+
+func setWidthOp(widths hegel.Generator[int]) hegel.Generator[inputOp] {
+	return hegel.Map(widths, func(w int) inputOp { return inputOp{kind: "setwidth", n: w} })
+}
+
+// editOpsOf: the operations at the old property's weights (a typed rune five times
+// in nineteen, the rest once each, the cursor keys sharing one), plus SetWidth,
+// the usual order under a window-size message (bubbles/7's first shape).
+func editOpsOf(rs hegel.Generator[rune], pastes, texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return zootest.Weighted(
+		zootest.W(5, typeOp(rs)),
+		zootest.W(1, opOf("left")),
+		zootest.W(1, opOf("right")),
+		zootest.W(1, opOf("backspace")),
+		zootest.W(1, opOf("delete")),
+		zootest.W(1, opOf("ctrl+w")),
+		zootest.W(1, opOf("alt+d")),
+		zootest.W(1, opOf("ctrl+k")),
+		zootest.W(1, opOf("ctrl+u")),
+		zootest.W(1, motions),
+		zootest.W(1, pasteOp(pastes)),
+		zootest.W(1, setValueOp(texts)),
+		zootest.W(1, setCursorOp(zootest.Ints(-1, 16))),
+		zootest.W(1, opOf("reset")),
+		zootest.W(1, setWidthOp(zootest.Ints(1, 12))),
+	)
+}
+
+// inputCase is a start and the operations.
+type inputCase struct {
+	start inputStart
+	ops   []inputOp
+}
+
+func (c inputCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(ops, ", ")
+}
+
+// casesOf: a case from the start and the operations.
+func casesOf(starts hegel.Generator[inputStart], ops hegel.Generator[[]inputOp]) hegel.Generator[inputCase] {
+	return hegel.Composite(func(tc hegel.TestCase) inputCase {
+		return inputCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// unshaped is the case with, under HEGEL_NO_KNOWN=1, every operation that would
+// reach the shape of a recorded bug from the state the operations before it leave
+// (bubbles/1, 7, 9, 10, 11: relations between an operation and the live state,
+// the window's included) left out, a no-op the shrinker can delete: the library
+// and the model are replayed over the operations kept so far. By default the
+// case is drawn as it is.
+func unshaped(c inputCase) inputCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	var kept []inputOp
+	for _, op := range c.ops {
+		trial := append(kept[:len(kept):len(kept)], op)
+		if lastShape(c.start, trial) == "" {
+			kept = trial
+		}
+	}
+	return inputCase{start: c.start, ops: kept}
+}
+
+// lastShape replays the start and the operations and names the shape the last
+// operation has (before it, stepShape; after it, the view's).
+func lastShape(start inputStart, ops []inputOp) string {
+	m, e := start.build()
+	for _, op := range ops[:len(ops)-1] {
+		apply(&m, e, op)
+	}
+	last := ops[len(ops)-1]
+	if s := stepShape(e, last); s != "" {
+		return s
+	}
+	apply(&m, e, last)
+	return viewShape(m)
+}
+
+// ---------------------------------------------------------------- the model
+
+type editModel struct {
+	value    []rune
+	pos      int
+	limit    int
+	err      error
+	validate ValidateFunc
+	echo     EchoMode
+}
+
+// sanitize is what the input sanitizer does: tabs and newline characters
+// become single spaces, one each.
+func sanitize(rs []rune) []rune {
+	out := make([]rune, 0, len(rs))
+	for _, r := range rs {
+		if r == '\t' || r == '\n' || r == '\r' {
+			r = ' '
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+func (e *editModel) check(v []rune) error {
+	if e.validate != nil {
+		return e.validate(string(v))
+	}
+	return nil
+}
+
+func (e *editModel) setValue(s string) {
+	rs := sanitize([]rune(s))
+	e.err = e.check(rs)
+	empty := len(e.value) == 0
+	if e.limit > 0 && len(rs) > e.limit {
+		rs = rs[:e.limit]
+	}
+	e.value = rs
+	if (e.pos == 0 && empty) || e.pos > len(e.value) {
+		e.pos = len(e.value)
+	}
+}
+
+func (e *editModel) insert(rs []rune) {
+	rs = sanitize(rs)
+	if e.limit > 0 {
+		avail := e.limit - len(e.value)
+		if avail <= 0 {
+			return
+		}
+		if len(rs) > avail {
+			rs = rs[:avail]
+		}
+	}
+	v := make([]rune, 0, len(e.value)+len(rs))
+	v = append(v, e.value[:e.pos]...)
+	v = append(v, rs...)
+	v = append(v, e.value[e.pos:]...)
+	empty := len(e.value) == 0
+	e.pos += len(rs)
+	e.err = e.check(v)
+	e.value = v
+	if (e.pos == 0 && empty) || e.pos > len(v) {
+		e.pos = len(v)
+	}
+}
+
+func (e *editModel) cut(from, to int) {
+	v := make([]rune, 0, len(e.value))
+	v = append(v, e.value[:from]...)
+	v = append(v, e.value[to:]...)
+	e.value = v
+	e.err = e.check(v)
+}
+
+func isSpace(r rune) bool { return unicode.IsSpace(r) }
+
+func (e *editModel) clamp(p int) int {
+	return max(0, min(p, len(e.value)))
+}
+
+// wordStart is where a backward word motion from pos ends: past any spaces,
+// then past the word.
+func (e *editModel) wordStart() int {
+	s := e.pos
+	for s > 0 && isSpace(e.value[s-1]) {
+		s--
+	}
+	for s > 0 && !isSpace(e.value[s-1]) {
+		s--
+	}
+	return s
+}
+
+// wordEnd is where a forward word motion from pos ends.
+func (e *editModel) wordEnd() int {
+	t := e.pos
+	for t < len(e.value) && isSpace(e.value[t]) {
+		t++
+	}
+	for t < len(e.value) && !isSpace(e.value[t]) {
+		t++
+	}
+	return t
+}
+
+// stepShape names the recorded bug whose shape the operation has in the state
+// before it: a backspace on an empty value the validator rejects, which the
+// library clears Err for without asking it (bubbles/9); ctrl+w on a word that
+// begins at index 1 after a space, which goes with the word (bubbles/10); alt+d
+// with the cursor on the last rune (a panic) or on the last rune of a word, which
+// deleteWordForward steps over before it looks for the word (bubbles/1).
+func stepShape(e *editModel, op inputOp) string {
+	switch op.kind {
+	case "backspace":
+		if len(e.value) == 0 && e.check(nil) != nil {
+			return "bubbles/9"
+		}
+	case "ctrl+w":
+		if e.echo == EchoNormal && e.pos > 0 && e.wordStart() == 1 {
+			return "bubbles/10"
+		}
+	case "alt+d":
+		if e.echo == EchoNormal && e.pos < len(e.value) &&
+			(e.pos+1 == len(e.value) || !isSpace(e.value[e.pos]) && isSpace(e.value[e.pos+1])) {
+			return "bubbles/1"
+		}
+	}
+	return ""
+}
+
+// apply performs the operation on the input and on the model: word motions go
+// past spaces and then past the word (to the ends in the masked modes), the
+// deletions revalidate, SetValue validates before the limit cuts, an insertion at
+// the limit leaves Err alone.
+func apply(m *Model, e *editModel, op inputOp) {
+	switch op.kind {
+	case "type":
+		*m = press(*m, typed(op.r))
+		e.insert([]rune{op.r})
+	case "left":
+		*m = press(*m, kLeft)
+		if e.pos > 0 {
+			e.pos--
+		}
+	case "right":
+		*m = press(*m, kRight)
+		if e.pos < len(e.value) {
+			e.pos++
+		}
+	case "backspace":
+		*m = press(*m, kBackspace)
+		if len(e.value) > 0 && e.pos > 0 {
+			e.cut(e.pos-1, e.pos)
+			e.pos--
+		} else {
+			e.err = e.check(e.value)
+		}
+	case "delete":
+		*m = press(*m, kDelete)
+		if e.pos < len(e.value) {
+			e.cut(e.pos, e.pos+1)
+		}
+	case "ctrl+w":
+		*m = press(*m, kDelWordBack)
+		if e.pos > 0 && len(e.value) > 0 {
+			s := 0
+			if e.echo == EchoNormal {
+				s = e.wordStart()
+			}
+			e.cut(s, e.pos)
+			e.pos = s
+		}
+	case "alt+d":
+		*m = press(*m, kDelWordFwd)
+		if e.pos < len(e.value) {
+			t := len(e.value)
+			if e.echo == EchoNormal {
+				t = e.wordEnd()
+			}
+			e.cut(e.pos, t)
+		}
+	case "ctrl+k":
+		*m = press(*m, kKill)
+		e.cut(e.pos, len(e.value))
+	case "ctrl+u":
+		*m = press(*m, kKillBack)
+		e.cut(0, e.pos)
+		e.pos = 0
+	case "home":
+		*m = press(*m, kHome)
+		e.pos = 0
+	case "end":
+		*m = press(*m, kEnd)
+		e.pos = len(e.value)
+	case "alt+b":
+		*m = press(*m, kWordBack)
+		if e.pos > 0 && len(e.value) > 0 {
+			s := 0
+			if e.echo == EchoNormal {
+				s = e.wordStart()
+			}
+			e.pos = s
+		}
+	case "alt+f":
+		*m = press(*m, kWordFwd)
+		if e.pos < len(e.value) {
+			t := len(e.value)
+			if e.echo == EchoNormal {
+				t = e.wordEnd()
+			}
+			e.pos = t
+		}
+	case "paste":
+		*m = press(*m, tea.PasteMsg{Content: op.s})
+		e.insert([]rune(op.s))
+	case "setvalue":
+		m.SetValue(op.s)
+		e.setValue(op.s)
+	case "setcursor":
+		m.SetCursor(op.n)
+		e.pos = e.clamp(op.n)
+	case "reset":
+		m.Reset()
+		e.value = nil
+		e.pos = 0
+	case "setwidth":
+		m.SetWidth(op.n)
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// ---------------------------------------------------------------- views
+
+func echo(m Model, s string) string {
+	switch m.EchoMode {
+	case EchoPassword:
+		return strings.Repeat(string(m.EchoCharacter), uniseg.StringWidth(s))
+	case EchoNone:
+		return ""
+	}
+	return s
+}
+
+func spaces(k int) string {
+	if k <= 0 {
+		return ""
+	}
+	return strings.Repeat(" ", k)
+}
+
+// viewShape names the recorded bug whose shape the view has: with EchoNone a
+// non-empty value in a field with a width, whose padding the library computes from
+// the hidden value (bubbles/12); a window wider than the field, which the library
+// re-fits only when the cursor crosses an edge (bubbles/7); the cursor at the
+// window's end with the rune under it past the window, where the library draws a
+// blank (bubbles/11).
+func viewShape(m Model) string {
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		return ""
+	}
+	if m.EchoMode == EchoNone {
+		switch {
+		case len(value) > 0 && m.Width() > 0:
+			return "bubbles/12"
+		case pos < len(value):
+			// the cursor cell is the echo of the rune under it, nothing (with a
+			// width the field is wrong by bubbles/12 first).
+			return "bubbles/98"
+		}
+		return ""
+	}
+	window := uniseg.StringWidth(echo(m, string(value[off:right])))
+	if pos == right {
+		window++
+	}
+	switch {
+	case m.Width() > 0 && window > m.Width()+1:
+		return "bubbles/7"
+	case pos == right && pos < len(value):
+		return "bubbles/11"
+	}
+	return ""
+}
+
+// checkView compares View with the model: the window the library keeps (offset,
+// offsetRight) holds the cursor and is never wider than the field; the text is
+// the prompt, the echoed window with the rune under the cursor shown (a blank
+// past the end of the value) and the padding to Width+1 cells; the cursor is one
+// reversed run at the cursor's column, as wide as the rune under it. With
+// EchoNone nothing of the value is echoed: a blank cursor cell and the padding.
+func checkView(j *zootest.Judge, m Model, what string) {
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		j.Fail("%s: window [%d,%d) does not hold the cursor %d in a value of %d runes", what, off, right, pos, len(value))
+	}
+	if m.Width() <= 0 && (off != 0 || right != len(value)) {
+		j.Fail("%s: no width, but the window is [%d,%d) of %d runes", what, off, right, len(value))
+	}
+	j.Shape(viewShape(m))
+	var before, cursorChar, after string
+	if m.EchoMode == EchoNone {
+		// A blank cursor cell wherever the cursor is (the library echoes the rune
+		// under it, nothing, inside the value: bubbles/98).
+		cursorChar = " "
+	} else {
+		before = echo(m, string(value[off:pos]))
+		cursorChar = " "
+		if pos < len(value) {
+			cursorChar = echo(m, string(value[pos]))
+		}
+		if pos < right {
+			after = echo(m, string(value[pos+1:right]))
+		}
+		window := uniseg.StringWidth(echo(m, string(value[off:right])))
+		if pos == right {
+			window++
+		}
+		if m.Width() > 0 && window > m.Width()+1 {
+			j.Fail("%s: the window [%d,%d) shows %d cells in a field of %d (width %d, cursor %d)\nview %s", what, off, right, window, m.Width()+1, m.Width(), pos, zootest.String(zootest.Cells(m.View())))
+		}
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	shown := uniseg.StringWidth(before) + uniseg.StringWidth(cursorChar) + uniseg.StringWidth(after)
+	want := m.Prompt + before + cursorChar + after
+	if m.Width() > 0 {
+		want += spaces(m.Width() + 1 - shown)
+	}
+	if got := zootest.Plain(cells); got != want {
+		j.Fail("%s: view text %q, want %q (window [%d,%d) cursor %d width %d)\nview %s", what, got, want, off, right, pos, m.Width(), zootest.String(cells))
+	}
+	// The cursor: one reversed run at the cursor's column.
+	col := promptW + uniseg.StringWidth(before)
+	x, start, revW := 0, -1, 0
+	for _, c := range cells {
+		if c.Rev {
+			if start < 0 {
+				start = x
+			} else if revW != x-start {
+				j.Fail("%s: reversed cells are not one run\nview %s", what, zootest.String(cells))
+			}
+			revW += c.W
+		}
+		x += c.W
+	}
+	if start != col || revW != uniseg.StringWidth(cursorChar) {
+		j.Fail("%s: the cursor run is at column %d, %d wide; want column %d, %d wide (%q)\nview %s", what, start, revW, col, uniseg.StringWidth(cursorChar), cursorChar, zootest.String(cells))
+	}
+}
+
+// judgeEditing drives the input through the case and checks Value, Position, Err
+// and the view against the model after every operation; the wide and the narrow
+// properties share it.
+func judgeEditing(j *zootest.Judge, c inputCase) {
+	m, e := c.start.build()
+	for _, op := range c.ops {
+		j.Shape(stepShape(e, op))
+		apply(&m, e, op)
+		what := "after " + op.GoString()
+		j.Note("%s -> %q pos %d", op.GoString(), m.Value(), m.Position())
+		if m.Value() != string(e.value) {
+			j.Fail("%s: value %q, want %q", what, m.Value(), string(e.value))
+		}
+		if m.Position() != e.pos {
+			j.Fail("%s: cursor at %d, want %d (value %q)", what, m.Position(), e.pos, m.Value())
+		}
+		if errString(m.Err) != errString(e.err) {
+			j.Fail("%s: Err %v, want %v (value %q, validator %s)", what, m.Err, e.err, m.Value(), c.start.validate)
+		}
+		checkView(j, m, what)
+	}
+}
+
+// ---------------------------------------------------------------- properties
+
+// TestHegelEditingFollowsTheModel: every key of the default key map, pastes,
+// SetValue, SetCursor, SetWidth and Reset against the rune-slice model; Value,
+// Position, Err and the View after each step.
+func TestHegelEditingFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeEditing(j, c)
+	})
+}
+
+// placeholderCase: a focused or blurred input with a placeholder and a width (0
+// for none, negative as a window-size handler may compute it).
+type placeholderCase struct {
+	focused     bool
+	prompt      string
+	placeholder string
+	width       int
+}
+
+func (c placeholderCase) GoString() string {
+	focus := "blurred"
+	if c.focused {
+		focus = "focused"
+	}
+	return fmt.Sprintf("%s, prompt %q, placeholder %q, width %d", focus, c.prompt, c.placeholder, c.width)
+}
+
+var (
+	asciiRunes = zootest.Sampled([]rune("abcdefghij .,")...)
+	// placeholderRunes: ASCII three times in five, else any rune; the wide ones never
+	// under HEGEL_NO_KNOWN=1 (bubbles/3).
+	placeholderRunes = zootest.Weighted(zootest.W(6, asciiRunes), zootest.W(4, runesOf(zootest.Unless(zootest.NoKnown, 10))))
+	placeholders     = textsOf(placeholderRunes, 1, 20)
+	// placeholderWidths: 1 to 24, or none (bubbles/2) or negative (bubbles/4), each
+	// one time in 26 as the old draw had them; neither under HEGEL_NO_KNOWN=1.
+	placeholderWidths = zootest.Weighted(
+		zootest.W(24, zootest.Ints(1, 24)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(0)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(-1)),
+	)
+	placeholderCases = placeholderCasesOf(placeholders, placeholderWidths)
+)
+
+// placeholderCasesOf: a case from the placeholder and the width.
+func placeholderCasesOf(placeholders hegel.Generator[string], widths hegel.Generator[int]) hegel.Generator[placeholderCase] {
+	return hegel.Composite(func(tc hegel.TestCase) placeholderCase {
+		return placeholderCase{
+			focused:     hegel.Draw(tc, zootest.Coin(50)),
+			prompt:      hegel.Draw(tc, zootest.Sampled("> ", "", "Name: ")),
+			placeholder: hegel.Draw(tc, placeholders),
+			width:       hegel.Draw(tc, widths),
+		}
+	})
+}
+
+func hasWide(rs []rune) bool {
+	for _, r := range rs {
+		if uniseg.StringWidth(string(r)) != 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// placeholderShape names the recorded bug whose shape the case has: a negative
+// width, which View panics on (bubbles/4); no width with more than one rune, cut
+// to the first (bubbles/2); a wide rune among the runes a field of the width
+// shows, sliced by display width (bubbles/3).
+func placeholderShape(c placeholderCase) string {
+	rs := []rune(c.placeholder)
+	switch {
+	case c.width < 0:
+		return "bubbles/4"
+	case c.width == 0 && len(rs) > 1:
+		return "bubbles/2"
+	case c.width > 0 && hasWide(rs[:min(len(rs), c.width+1)]):
+		return "bubbles/3"
+	}
+	return ""
+}
+
+// fit cuts s to the graphemes that fit in width cells (a wide rune that does not
+// fit is dropped).
+func fit(s string, width int) string {
+	var sb strings.Builder
+	w := 0
+	g := uniseg.NewGraphemes(s)
+	for g.Next() {
+		if w+g.Width() > width {
+			break
+		}
+		w += g.Width()
+		sb.WriteString(g.Str())
+	}
+	return sb.String()
+}
+
+// judgePlaceholder checks the placeholder view: the placeholder cut to the field's
+// Width+1 cells and padded to it (whole without a width, a width of 0 or less
+// being ignored as documented), the cursor on its first cell when focused.
+func judgePlaceholder(j *zootest.Judge, c placeholderCase) {
+	j.Shape(placeholderShape(c))
+	m := New()
+	if c.focused {
+		m.Focus()
+	}
+	m.Prompt = c.prompt
+	m.Placeholder = c.placeholder
+	if c.width != 0 {
+		m.SetWidth(c.width)
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	text := c.placeholder
+	if c.width > 0 {
+		text = fit(c.placeholder, c.width+1)
+	}
+	want := m.Prompt + text
+	if c.width > 0 {
+		want += spaces(c.width + 1 - uniseg.StringWidth(text))
+	}
+	if got := zootest.Plain(cells); got != want {
+		j.Fail("placeholder view %q, want %q\n%s", got, want, zootest.String(cells))
+	}
+	if strings.Contains(zootest.Plain(cells), "\x00") {
+		j.Fail("placeholder view contains NUL: %q", zootest.Plain(cells))
+	}
+	for i, cell := range cells {
+		if cell.Rev != (m.Focused() && i == promptW) {
+			j.Fail("the cursor is not exactly on the first placeholder cell (focused %v)\n%s", m.Focused(), zootest.String(cells))
+		}
+	}
+}
+
+// TestHegelPlaceholderFillsTheField: with no value the field shows the
+// placeholder, cut to the width and padded to width+1, cursor on its first
+// cell.
+func TestHegelPlaceholderFillsTheField(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, placeholderCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePlaceholder(j, c)
+	})
+}
+
+// suggestion model: the value with its cursor (SetValue keeps the cursor where it
+// was in a non-empty value, so a later typed rune lands there), the suggestions,
+// the matches and the index.
+type sugModel struct {
+	value   []rune
+	pos     int
+	sugs    []string
+	matched []string
+	idx     int
+}
+
+// matches is the case-insensitive prefix matches of a value (none for an empty
+// value).
+func (s *sugModel) matches(value string) []string {
+	if value == "" {
+		return nil
+	}
+	var matched []string
+	for _, x := range s.sugs {
+		if strings.HasPrefix(strings.ToLower(x), strings.ToLower(value)) {
+			matched = append(matched, x)
+		}
+	}
+	return matched
+}
+
+func (s *sugModel) update() {
+	if len(s.value) == 0 || len(s.sugs) == 0 {
+		// Nothing matches an empty value; the index is left as it was
+		// (it is reset the next time the matches change).
+		s.matched = nil
+		return
+	}
+	matched := s.matches(string(s.value))
+	if !equalStrings(matched, s.matched) {
+		s.idx = 0
+	}
+	s.matched = matched
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// sugOp is one operation of the suggestion property: a typed rune, backspace,
+// down, up, tab, SetValue or Reset.
+type sugOp struct {
+	kind string
+	r    rune   // type
+	s    string // setvalue
+}
+
+func (o sugOp) GoString() string {
+	switch o.kind {
+	case "type":
+		return fmt.Sprintf("type %q", o.r)
+	case "setvalue":
+		return fmt.Sprintf("SetValue(%q)", o.s)
+	}
+	return o.kind
+}
+
+// sugCase: the suggestions and the operations.
+type sugCase struct {
+	sugs []string
+	ops  []sugOp
+}
+
+func (c sugCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("suggestions %q: %s", c.sugs, strings.Join(ops, ", "))
+}
+
+func sugOpOf(kind string) hegel.Generator[sugOp] { return hegel.Just(sugOp{kind: kind}) }
+
+func typeSug(rs hegel.Generator[rune]) hegel.Generator[sugOp] {
+	return hegel.Map(rs, func(r rune) sugOp { return sugOp{kind: "type", r: r} })
+}
+
+func setValueSug(texts hegel.Generator[string]) hegel.Generator[sugOp] {
+	return hegel.Map(texts, func(s string) sugOp { return sugOp{kind: "setvalue", s: s} })
+}
+
+var (
+	sugAlphabet = zootest.Sampled([]rune("abAB ")...)
+	sugWords    = textsOf(sugAlphabet, 1, 5)
+	sugLists    = zootest.Counted(sugWords, 0, 5)
+	// sugOps: the operations at the old property's weights: a typed rune four times
+	// in ten, backspace, down and up once, tab twice, SetValue or Reset once
+	// (bubbles/5's shape when the matches change).
+	sugOps = zootest.Weighted(
+		zootest.W(4, typeSug(sugAlphabet)),
+		zootest.W(1, sugOpOf("backspace")),
+		zootest.W(1, sugOpOf("down")),
+		zootest.W(1, sugOpOf("up")),
+		zootest.W(2, sugOpOf("tab")),
+		zootest.W(1, zootest.Weighted(zootest.W(1, setValueSug(sugWords)), zootest.W(1, sugOpOf("reset")))),
+	)
+	// sugCases: none to five suggestions and one to twenty-five operations; under
+	// HEGEL_NO_KNOWN=1 the operations that would reach a recorded bug are left out.
+	sugCases = hegel.Map(sugCasesOf(sugLists, zootest.Counted(sugOps, 1, 25)), unshapedSug)
+)
+
+// sugCasesOf: a case from the suggestions and the operations.
+func sugCasesOf(sugs hegel.Generator[[]string], ops hegel.Generator[[]sugOp]) hegel.Generator[sugCase] {
+	return hegel.Composite(func(tc hegel.TestCase) sugCase {
+		return sugCase{sugs: hegel.Draw(tc, sugs), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// sugShape names the recorded bug whose shape the operation has in the model's
+// state: up with nothing matched and the index at 0, which the library takes to
+// -1 (bubbles/6); SetValue or Reset to a value whose matches differ from the
+// current ones, which the library keeps (bubbles/5).
+func sugShape(s *sugModel, op sugOp) string {
+	switch op.kind {
+	case "up":
+		if len(s.matched) == 0 && s.idx == 0 {
+			return "bubbles/6"
+		}
+	case "setvalue", "reset":
+		if !equalStrings(s.matches(op.s), s.matched) {
+			return "bubbles/5"
+		}
+	}
+	return ""
+}
+
+// applySug performs the operation on the model (the library's part is in
+// judgeSuggestions): a rune is typed at the cursor, backspace deletes before it,
+// tab appends the current suggestion's remainder to the typed prefix and moves to
+// the end; up and down cycle within the matches, staying at 0 with none; SetValue
+// moves the cursor to the end only from an empty value or past the new end, Reset
+// to the start.
+func (s *sugModel) applySug(op sugOp) {
+	switch op.kind {
+	case "type":
+		s.value = slices.Insert(slices.Clone(s.value), s.pos, op.r)
+		s.pos++
+	case "backspace":
+		if s.pos > 0 {
+			s.value = slices.Delete(slices.Clone(s.value), s.pos-1, s.pos)
+			s.pos--
+		}
+	case "down":
+		s.idx++
+		if s.idx >= len(s.matched) {
+			s.idx = 0
+		}
+	case "up":
+		s.idx--
+		if s.idx < 0 {
+			s.idx = max(len(s.matched)-1, 0)
+		}
+	case "tab":
+		if len(s.matched) > 0 {
+			s.value = append(slices.Clone(s.value), []rune(s.matched[s.idx])[len(s.value):]...)
+			s.pos = len(s.value)
+		}
+	case "setvalue":
+		empty := len(s.value) == 0
+		s.value = []rune(op.s)
+		if (s.pos == 0 && empty) || s.pos > len(s.value) {
+			s.pos = len(s.value)
+		}
+	case "reset":
+		s.value, s.pos = nil, 0
+	}
+	s.update()
+}
+
+// unshapedSug is the case with, under HEGEL_NO_KNOWN=1, every operation that would
+// reach a recorded bug from the model's state left out (the model replayed); by
+// default the case as drawn.
+func unshapedSug(c sugCase) sugCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	s := &sugModel{sugs: c.sugs}
+	var kept []sugOp
+	for _, op := range c.ops {
+		if sugShape(s, op) != "" {
+			continue
+		}
+		s.applySug(op)
+		kept = append(kept, op)
+	}
+	return sugCase{sugs: c.sugs, ops: kept}
+}
+
+// judgeSuggestions drives the input through the case and checks the value, the
+// matched suggestions, the index, CurrentSuggestion and the view after every
+// operation.
+func judgeSuggestions(j *zootest.Judge, c sugCase) {
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	s := &sugModel{sugs: c.sugs}
+	m.SetSuggestions(s.sugs)
+	if got := m.AvailableSuggestions(); !equalStrings(got, s.sugs) {
+		j.Fail("AvailableSuggestions %q, want %q", got, s.sugs)
+	}
+	for _, op := range c.ops {
+		j.Shape(sugShape(s, op))
+		switch op.kind {
+		case "type":
+			m = press(m, typed(op.r))
+		case "backspace":
+			m = press(m, kBackspace)
+		case "down":
+			m = press(m, kDown)
+		case "up":
+			m = press(m, kUp)
+		case "tab":
+			m = press(m, kTab)
+		case "setvalue":
+			m.SetValue(op.s)
+		case "reset":
+			m.Reset()
+		}
+		s.applySug(op)
+		what := "after " + op.GoString()
+		j.Note("%s -> %q matched %q idx %d", op.GoString(), m.Value(), m.MatchedSuggestions(), m.CurrentSuggestionIndex())
+		if m.Value() != string(s.value) || m.Position() != s.pos {
+			j.Fail("%s: value %q at %d, want %q at %d", what, m.Value(), m.Position(), string(s.value), s.pos)
+		}
+		if got := m.MatchedSuggestions(); !equalStrings(got, s.matched) {
+			j.Fail("%s: matched %q, want %q (value %q of %q)", what, got, s.matched, string(s.value), s.sugs)
+		}
+		if m.CurrentSuggestionIndex() != s.idx {
+			j.Fail("%s: suggestion index %d, want %d (matched %q)", what, m.CurrentSuggestionIndex(), s.idx, s.matched)
+		}
+		wantCur := ""
+		if s.idx < len(s.matched) {
+			wantCur = s.matched[s.idx]
+		}
+		if got := m.CurrentSuggestion(); got != wantCur {
+			j.Fail("%s: CurrentSuggestion %q, want %q", what, got, wantCur)
+		}
+		// The view: the value, then the rest of the current suggestion, or the
+		// blank cursor cell when the cursor is at the end.
+		plain := zootest.Plain(zootest.Cells(m.View()))
+		want := m.Prompt + string(s.value)
+		if len(s.matched) > 0 && len([]rune(wantCur)) > len(s.value) {
+			want += string([]rune(wantCur)[len(s.value):])
+		} else if s.pos == len(s.value) {
+			want += " "
+		}
+		if plain != want {
+			j.Fail("%s: view %q, want %q (matched %q idx %d)", what, plain, want, s.matched, s.idx)
+		}
+	}
+}
+
+// TestHegelSuggestionsFollowThePrefix: the matched suggestions are those
+// with the value as a case-insensitive prefix; up/down cycle, tab completes,
+// the view shows the completion after the cursor.
+func TestHegelSuggestionsFollowThePrefix(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sugCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSuggestions(j, c)
+	})
+}
+
+// cursorCase: a prompt, a width (0 for none), a value and the SetCursor
+// positions, each taken modulo the value's length plus one.
+type cursorCase struct {
+	prompt  string
+	width   int
+	value   string
+	cursors []int
+}
+
+func (c cursorCase) GoString() string {
+	return fmt.Sprintf("prompt %q width %d value %q SetCursor %v", c.prompt, c.width, c.value, c.cursors)
+}
+
+var (
+	cursorWidths = zootest.Maybe(70, zootest.Ints(1, 10))
+	// cursorRunes: the wide runes never under HEGEL_NO_KNOWN=1 (a wide rune before the
+	// cursor is bubbles/8's shape).
+	cursorRunes = runesOf(zootest.Unless(zootest.NoKnown, 10))
+	// cursorCases: a width seven times in ten, a value of up to 14 runes (under
+	// HEGEL_NO_KNOWN=1 no longer than the width, so that the window never scrolls:
+	// bubbles/8's other shape) and up to four SetCursor positions.
+	cursorCases = hegel.FlatMap(cursorWidths, func(w int) hegel.Generator[cursorCase] {
+		hi := 14
+		if zootest.NoKnown && w > 0 {
+			hi = min(hi, w)
+		}
+		return cursorCasesOf(hegel.Just(w), zootest.Counted(cursorRunes, 0, hi), zootest.Counted(zootest.Ints(0, 14), 0, 4))
+	})
+)
+
+// cursorCasesOf: a case from the width, the value's runes and the positions.
+func cursorCasesOf(widths hegel.Generator[int], values hegel.Generator[[]rune], positions hegel.Generator[[]int]) hegel.Generator[cursorCase] {
+	return hegel.Composite(func(tc hegel.TestCase) cursorCase {
+		return cursorCase{
+			prompt:  hegel.Draw(tc, zootest.Sampled("> ", "", "Name: ")),
+			width:   hegel.Draw(tc, widths),
+			value:   string(hegel.Draw(tc, values)),
+			cursors: hegel.Draw(tc, positions),
+		}
+	})
+}
+
+// cursorShape names bubbles/8's shape: Cursor() puts the real cursor at the prompt
+// width plus the rune index, capped at the width, which is not the column of the
+// view's cursor once the window has scrolled or a wide rune precedes the cursor.
+func cursorShape(m Model) string {
+	x := m.pos
+	if m.Width() > 0 {
+		x = min(x, m.Width())
+	}
+	if x != uniseg.StringWidth(string(m.value[m.offset:m.pos])) {
+		return "bubbles/8"
+	}
+	return ""
+}
+
+// judgeCursor sets the value and the cursor, checks the view and then that the real
+// cursor sits at the column where the view draws the virtual one.
+func judgeCursor(j *zootest.Judge, c cursorCase) {
+	m := New()
+	m.Focus()
+	m.Prompt = c.prompt
+	if c.width > 0 {
+		m.SetWidth(c.width)
+	}
+	m.SetValue(c.value)
+	for _, p := range c.cursors {
+		m.SetCursor(p % (len(m.value) + 1))
+	}
+	j.Note("pos %d window [%d,%d)", m.pos, m.offset, m.offsetRight)
+	checkView(j, m, "virtual cursor")
+	j.Shape(cursorShape(m))
+	want := lipgloss.Width(m.Prompt) + uniseg.StringWidth(string(m.value[m.offset:m.pos]))
+	m.SetVirtualCursor(false)
+	cur := m.Cursor()
+	if cur == nil {
+		j.Fail("Cursor() is nil for a focused input without a virtual cursor")
+	}
+	if cur.Position.Y != 0 {
+		j.Fail("Cursor() row %d, want 0", cur.Position.Y)
+	}
+	if cur.Position.X != want {
+		j.Fail("Cursor() at column %d, want %d (value %q pos %d window [%d,%d) width %d)", cur.Position.X, want, m.Value(), m.pos, m.offset, m.offsetRight, m.Width())
+	}
+}
+
+// TestHegelRealCursorSitsUnderTheVirtualOne: with the virtual cursor off,
+// Cursor() reports the column where View draws the cursor.
+func TestHegelRealCursorSitsUnderTheVirtualOne(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cursorCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/1: deleteWordForward moves past the rune under the cursor before it
+// looks for the word: at the last rune it indexes past the value.
+func TestHegelPinDeleteWordForwardStartsOneRuneTooFar(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("ab c")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a c" {
+		t.Fatalf("alt+d at a|b c gives %q, want %q", m.Value(), "a c")
+	}
+	m = New()
+	m.Focus()
+	m.SetValue("ab")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a" {
+		t.Fatalf("alt+d at a|b gives %q, want %q", m.Value(), "a")
+	}
+}
+
+// bubbles/2: without a width the placeholder is cut to its first rune.
+func TestHegelPinPlaceholderIsCutToOneRuneWithoutWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	if got := zootest.Plain(zootest.Cells(m.View())); got != "> Hello" {
+		t.Fatalf("View with placeholder %q and no width shows %q, want %q", m.Placeholder, got, "> Hello")
+	}
+}
+
+// bubbles/3: the placeholder is sliced by its display width as if it were a
+// rune count: NUL runes appear after wide characters, and a wide placeholder
+// overflows the width.
+func TestHegelPinPlaceholderIsSlicedByDisplayWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "输入消息..."
+	m.SetWidth(20)
+	v := m.View()
+	if strings.Contains(v, "\x00") {
+		t.Fatalf("View with placeholder %q width 20 contains NUL runes: %q", m.Placeholder, v)
+	}
+	m.Placeholder = "输入消息"
+	m.SetWidth(3)
+	if w := lipgloss.Width(m.View()); w > 2+4 {
+		t.Fatalf("View with placeholder %q width 3 is %d cells wide, want at most %d: %q", m.Placeholder, w, 2+4, m.View())
+	}
+}
+
+// bubbles/4: a negative width (documented as ignored) with a placeholder
+// panics in View.
+func TestHegelPinNegativeWidthPlaceholderPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	m.SetWidth(-1)
+	_ = m.View()
+}
+
+// bubbles/5: SetValue and Reset keep the matched suggestions of the previous
+// value; tab then completes the wrong text, or panics when the value is
+// longer than the stale suggestion.
+func TestHegelPinSetValueKeepsStaleSuggestions(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("zzz")
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("after SetValue(%q) the current suggestion is %q, want none", "zzz", got)
+	}
+	m = press(m, kTab)
+	if m.Value() != "zzz" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "zzz", m.Value())
+	}
+	m = New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("apple pie")
+	m = press(m, kTab)
+	if m.Value() != "apple pie" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "apple pie", m.Value())
+	}
+}
+
+// bubbles/6: up with no matched suggestion sets the index to -1 and
+// CurrentSuggestion panics.
+func TestHegelPinPrevSuggestionWithoutMatchesPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, kUp)
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("CurrentSuggestion %q, want none", got)
+	}
+	if i := m.CurrentSuggestionIndex(); i < 0 {
+		t.Fatalf("CurrentSuggestionIndex %d", i)
+	}
+}
+
+// bubbles/7: SetWidth after the value is set does not scroll the window; the
+// whole value stays visible until the cursor crosses an edge.
+func TestHegelPinSetWidthDoesNotScrollTheView(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("abcdefghij")
+	m.SetCursor(3)
+	m.SetWidth(5)
+	if w := lipgloss.Width(m.View()); w != 2+6 {
+		t.Fatalf("after SetWidth(5) the view is %d cells wide, want %d: %q", w, 2+6, m.View())
+	}
+}
+
+// bubbles/8: Cursor() places the real cursor at prompt + rune index, ignoring
+// the scrolled window and wide runes.
+func TestHegelPinRealCursorIgnoresTheScroll(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(5) // the window is [5,10): the cursor sits on the first visible cell
+	m.SetVirtualCursor(false)
+	if x := m.Cursor().Position.X; x != 2 {
+		t.Fatalf("Cursor() at column %d, want 2 (window [%d,%d), view %q)", x, m.offset, m.offsetRight, m.View())
+	}
+}
+
+// bubbles/9: backspace on an empty input clears Err without validating.
+func TestHegelPinBackspaceOnEmptyClearsErr(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.Validate = func(s string) error {
+		if s == "" {
+			return errRequired
+		}
+		return nil
+	}
+	m.SetValue("")
+	if m.Err == nil {
+		t.Fatalf("SetValue(\"\") did not set Err")
+	}
+	m = press(m, kBackspace)
+	if m.Err == nil {
+		t.Fatalf("backspace on the empty input cleared Err although the validator rejects \"\"")
+	}
+}
+
+// bubbles/10: ctrl+w on a word at the start of the input deletes the single
+// space before it as well.
+func TestHegelPinDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w at %q gives %q, want %q", " ab", m.Value(), " ")
+	}
+}
+
+// bubbles/11: scrolling forward, the window ends at the cursor: the rune under
+// it is not shown and the cursor is a blank at the right edge.
+func TestHegelPinForwardScrollHidesTheRuneUnderTheCursor(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(0)
+	for i := 0; i < 6; i++ {
+		m = press(m, kRight)
+	}
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev && c.S != "g" {
+			t.Fatalf("with the cursor on %q the view shows %s", "g", zootest.String(cells))
+		}
+	}
+}
+
+// bubbles/12: with EchoNone the padding is computed from the hidden value, so
+// the field shrinks as text is typed.
+func TestHegelPinEchoNonePadsByTheHiddenWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(3)
+	m.EchoMode = EchoNone
+	empty := lipgloss.Width(m.View())
+	m.SetValue("ab")
+	if w := lipgloss.Width(m.View()); w != empty {
+		t.Fatalf("EchoNone field is %d cells wide empty and %d with %q", empty, w, "ab")
+	}
+}
+
+// bubbles/98: with EchoNone the cursor vanishes while it is inside the value:
+// its cell is the echo of the rune under it, nothing.
+func TestHegelPinEchoNoneCursorVanishesInsideTheValue(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.EchoMode = EchoNone
+	m.SetValue("ab")
+	m.SetCursor(1)
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev {
+			return
+		}
+	}
+	t.Fatalf("EchoNone with the cursor inside %q shows no cursor: %s", "ab", zootest.String(cells))
+}
diff --git a/timer/hegel_shapes_test.go b/timer/hegel_shapes_test.go
new file mode 100644
index 0000000..6d093f9
--- /dev/null
+++ b/timer/hegel_shapes_test.go
@@ -0,0 +1,64 @@
+package timer
+
+// The shape regions of the recorded timer bugs (bugs.toml bubbles/92, 93) and the
+// narrow properties over them: each region is a generator over the bug's shape with
+// random contents, judged exactly like the wide property (judgeTimer). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (zootest.Shaped) and the property passes. Both
+// shapes are deterministic in the library (a tag never advanced, a subtraction never
+// clamped), so every instance reaches the bug (measured: 100 of 100 with math/rand
+// over the library).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// narrowTimer runs a narrow property: every drawn case through the wide property's
+// judge.
+func narrowTimer(t *testing.T, cases hegel.Generator[timerCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTimer(j, c)
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/92
+
+// startedTwice: a timer of two to six intervals (so that it is still running when the
+// second chain's tick arrives) started again, or sent a broadcast tick, while its
+// first tick is in flight, then a round: the two ticks are both accepted, the second
+// with a tag the mirror has moved past; up to six operations follow. Past the shape,
+// Stop instead: its answering tick and the chain's are both dropped.
+var startedTwice = casesOf(multiples(2, 6), zootest.Seq(
+	zootest.One(zootest.Shaped(zootest.Sampled(timerOp{kind: "start"}, timerOp{kind: "broadcast"}), opOf("stop"))),
+	zootest.One(opOf("round")),
+	zootest.Counted(timerOps, 0, 6),
+))
+
+func TestHegelTimerStartedTwice(t *testing.T) {
+	narrowTimer(t, startedTwice)
+}
+
+// --------------------------------------------------------------------------- bubbles/93
+
+// timeoutNotAMultiple: a timeout of none to six intervals and a remainder, and one
+// round more than the intervals: the last tick takes the countdown below zero on
+// every instance; up to six operations follow. Past the shape, one to six intervals
+// exactly, where the countdown stops at zero.
+var timeoutNotAMultiple = hegel.FlatMap(zootest.Shaped(withRemainder(zootest.Ints(0, 6)), multiples(1, 6)), func(spec timeoutSpec) hegel.Generator[timerCase] {
+	rounds := make([]timerOp, spec.k+1)
+	for i := range rounds {
+		rounds[i] = timerOp{kind: "round"}
+	}
+	return casesOf(hegel.Just(spec), zootest.Seq(hegel.Just(rounds), zootest.Counted(timerOps, 0, 6)))
+})
+
+func TestHegelTimerTimeoutNotAMultipleOfTheInterval(t *testing.T) {
+	narrowTimer(t, timeoutNotAMultiple)
+}
diff --git a/timer/hegel_test.go b/timer/hegel_test.go
new file mode 100644
index 0000000..56a22f7
--- /dev/null
+++ b/timer/hegel_test.go
@@ -0,0 +1,403 @@
+package timer
+
+// Hegel zoo: properties of the timer component against a mirror of its
+// countdown, its running flag and the tick commands it has in flight. A case
+// is an interval, a timeout (a multiple of the interval, or one time in four
+// with a remainder: bubbles/93's shape) and a list of operation records
+// applied in order; the shapes of the recorded bugs are drawn like any other
+// case and fail naming them, and are not drawn under HEGEL_NO_KNOWN=1
+// (timeouts that are multiples; no Start, Toggle or broadcast tick, each of
+// which starts a second chain the library never rejects: bubbles/92).
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// zrun executes a command synchronously and flattens batches and sequences
+// into the messages they would deliver. Tick commands sleep their interval,
+// so the properties use microsecond intervals.
+func zrun(cmd tea.Cmd) []tea.Msg {
+	if cmd == nil {
+		return nil
+	}
+	msg := cmd()
+	if msg == nil {
+		return nil
+	}
+	v := reflect.ValueOf(msg)
+	if v.Kind() == reflect.Slice && v.Type().Elem() == reflect.TypeOf(tea.Cmd(nil)) {
+		var out []tea.Msg
+		for i := 0; i < v.Len(); i++ {
+			c, _ := v.Index(i).Interface().(tea.Cmd)
+			out = append(out, zrun(c)...)
+		}
+		return out
+	}
+	return []tea.Msg{msg}
+}
+
+// timerOp is one operation: a round (every message in flight delivered, in order),
+// Start, Stop, Toggle, a restart (Stop, a round, Start: the only way to resume with
+// one chain in flight), another timer's messages, a tick with a stale tag (stale past
+// the expected one) or a broadcast tick (TickMsg{ID: 0}, accepted by every timer).
+type timerOp struct {
+	kind  string
+	stale int
+}
+
+func (o timerOp) GoString() string {
+	if o.kind == "tagged" {
+		return fmt.Sprintf("tagged(+%d)", o.stale)
+	}
+	return o.kind
+}
+
+// timeoutSpec is a timeout in intervals plus a remainder below one interval.
+type timeoutSpec struct {
+	k   int
+	rem time.Duration
+}
+
+func (t timeoutSpec) of(interval time.Duration) time.Duration {
+	return time.Duration(t.k)*interval + t.rem
+}
+
+// timerCase: the interval, the timeout and the operations.
+type timerCase struct {
+	interval time.Duration
+	timeout  timeoutSpec
+	ops      []timerOp
+}
+
+func (c timerCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("New(%v, WithInterval(%v)): %s", c.timeout.of(c.interval), c.interval, strings.Join(ops, ", "))
+}
+
+func opOf(kind string) hegel.Generator[timerOp] { return hegel.Just(timerOp{kind: kind}) }
+
+// multiples: lo to hi intervals exactly.
+func multiples(lo, hi int) hegel.Generator[timeoutSpec] {
+	return hegel.Map(zootest.Ints(lo, hi), func(k int) timeoutSpec { return timeoutSpec{k: k} })
+}
+
+// withRemainder: k intervals and a remainder of 1 to 999 nanoseconds (below either
+// interval): the countdown goes past zero (bubbles/93).
+func withRemainder(k hegel.Generator[int]) hegel.Generator[timeoutSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) timeoutSpec {
+		return timeoutSpec{k: hegel.Draw(tc, k), rem: time.Duration(hegel.Draw(tc, zootest.Ints(1, 999)))}
+	})
+}
+
+var (
+	// intervals: a microsecond, or two three times in twenty (the tick commands sleep
+	// their interval).
+	intervals = zootest.Weighted(zootest.W(17, hegel.Just(time.Microsecond)), zootest.W(3, hegel.Just(2*time.Microsecond)))
+
+	// timeouts: one to six intervals, or one time in four none to six intervals and a
+	// remainder (never under HEGEL_NO_KNOWN=1).
+	timeouts = zootest.Weighted(
+		zootest.W(6, multiples(1, 6)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), withRemainder(zootest.Ints(0, 6))),
+	)
+
+	taggedOps = hegel.Map(zootest.Ints(1, 5), func(k int) timerOp { return timerOp{kind: "tagged", stale: k} })
+
+	// timerOps: the operations at the old property's weights, Start first (the
+	// simplest: a Start while a tick is in flight is bubbles/92); Start, Toggle and
+	// the broadcast tick, each of which adds a tick chain the library never rejects,
+	// are not drawn under HEGEL_NO_KNOWN=1, and a restart (Stop, a round that drops
+	// what was in flight, Start) is drawn instead of them.
+	timerOps = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), opOf("start")),
+		zootest.W(7, opOf("round")),
+		zootest.W(2, opOf("stop")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), opOf("toggle")),
+		zootest.W(1, opOf("foreign")),
+		zootest.W(1, taggedOps),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), opOf("broadcast")),
+		zootest.W(1, opOf("restart")),
+	)
+
+	// timerCases: an interval, a timeout and one to fourteen operations.
+	timerCases = casesOf(timeouts, zootest.Counted(timerOps, 1, 14))
+)
+
+// casesOf: a case from the timeout and the operations.
+func casesOf(timeout hegel.Generator[timeoutSpec], ops hegel.Generator[[]timerOp]) hegel.Generator[timerCase] {
+	return hegel.Composite(func(tc hegel.TestCase) timerCase {
+		return timerCase{interval: hegel.Draw(tc, intervals), timeout: hegel.Draw(tc, timeout), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// pending is one message the mirror expects the library to have in flight:
+// a tick (with the Timeout flag it was scheduled with and the tag the mirror
+// gave it) or a TimeoutMsg.
+type pending struct {
+	tick bool
+	flag bool
+	tag  int
+}
+
+// tmir mirrors the timer.
+type tmir struct {
+	timeout  time.Duration
+	interval time.Duration
+	running  bool
+	tag      int // advanced by every accepted tick (the library never advances its own: bubbles/92)
+	pend     []pending
+	timeouts int // TimeoutMsgs delivered
+}
+
+func (s *tmir) timedout() bool  { return s.timeout <= 0 }
+func (s *tmir) isRunning() bool { return s.running && !s.timedout() }
+
+// tickOut is what Update returns after an accepted tick: the next tick and,
+// when the countdown has just crossed zero, the timeout message.
+func (s *tmir) tickOut(crossed bool) []pending {
+	out := []pending{{tick: true, flag: s.timedout(), tag: s.tag}}
+	if crossed {
+		out = append(out, pending{tick: false})
+	}
+	return out
+}
+
+// judgeTimer drives the timer through the case and checks Timeout, Running, Timedout,
+// View and the messages the timer emits against the mirror after every step. The
+// mirror counts the countdown down to zero and no further (the library goes
+// negative: bubbles/93), gives every tick it files the tag expected when it was
+// scheduled and accepts a tick exactly when its tag is the one expected; the library
+// never advances its tag, so it accepts every chain's ticks (bubbles/92).
+func judgeTimer(j *zootest.Judge, c timerCase) {
+	s := &tmir{timeout: c.timeout.of(c.interval), interval: c.interval, running: true}
+	m := New(s.timeout, WithInterval(c.interval))
+	id := m.ID()
+
+	// expect checks a batch of messages returned by Update or Init
+	// against the mirror's expectation and files them as pending.
+	var lib []tea.Msg
+	expect := func(what string, out []tea.Msg, want []pending) {
+		if len(out) != len(want) {
+			j.Fail("%s: %d messages %v, expected %d", what, len(out), out, len(want))
+		}
+		for i, msg := range out {
+			switch msg := msg.(type) {
+			case TickMsg:
+				if !want[i].tick {
+					j.Fail("%s: message %d is a tick, expected TimeoutMsg", what, i)
+				}
+				if msg.ID != id || msg.Timeout != want[i].flag {
+					j.Fail("%s: tick %+v, expected id %d timeout %v", what, msg, id, want[i].flag)
+				}
+			case TimeoutMsg:
+				if want[i].tick {
+					j.Fail("%s: message %d is a TimeoutMsg, expected a tick", what, i)
+				}
+				if msg.ID != id {
+					j.Fail("%s: TimeoutMsg for %d, expected %d", what, msg.ID, id)
+				}
+			default:
+				j.Fail("%s: unexpected message %T", what, msg)
+			}
+		}
+		lib = append(lib, out...)
+		s.pend = append(s.pend, want...)
+	}
+	check := func(what string) {
+		if m.Timeout != s.timeout || m.Running() != s.isRunning() || m.Timedout() != s.timedout() {
+			j.Fail("%s: timeout %v running %v timedout %v, expected %v %v %v",
+				what, m.Timeout, m.Running(), m.Timedout(), s.timeout, s.isRunning(), s.timedout())
+		}
+		if m.View() != s.timeout.String() {
+			j.Fail("%s: view %q, expected %q", what, m.View(), s.timeout.String())
+		}
+		if m.ID() != id {
+			j.Fail("%s: id changed %d -> %d", what, id, m.ID())
+		}
+	}
+	// tick mirrors an accepted tick: the countdown moves one interval, to zero at
+	// the least, and the next tick is scheduled.
+	tick := func(what string, cmd tea.Cmd) {
+		before := s.timeout
+		if before > 0 && before < s.interval {
+			// the library's countdown goes negative here
+			j.Shape("bubbles/93")
+		}
+		s.timeout = max(0, before-s.interval)
+		s.tag++
+		expect(what, zrun(cmd), s.tickOut(before > 0 && s.timeout <= 0))
+	}
+	// deliver feeds one tick carrying the mirror's tag and mirrors the acceptance
+	// rule.
+	deliver := func(what string, msg tea.Msg, tag int) {
+		if s.isRunning() && tag != s.tag {
+			// a stale tag: the library never advances its own and accepts the tick
+			j.Shape("bubbles/92")
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(msg)
+		if s.isRunning() && tag == s.tag {
+			tick(what, cmd)
+		} else {
+			expect(what+" dropped", zrun(cmd), nil)
+		}
+	}
+	// startStop delivers the message a Start/Stop/Toggle command sends.
+	startStop := func(what string, cmd tea.Cmd, want bool) {
+		msgs := zrun(cmd)
+		if len(msgs) != 1 {
+			j.Fail("%s: %d messages, expected one StartStopMsg", what, len(msgs))
+		}
+		ss, ok := msgs[0].(StartStopMsg)
+		if !ok || ss.ID != id || ss.running != want {
+			j.Fail("%s: %#v, expected StartStopMsg{%d, %v}", what, msgs[0], id, want)
+		}
+		var c tea.Cmd
+		m, c = m.Update(ss)
+		s.running = want
+		// The library answers every StartStopMsg with a fresh tick.
+		expect(what, zrun(c), []pending{{tick: true, flag: s.timedout(), tag: s.tag}})
+		check(what)
+	}
+
+	// round delivers everything in flight, in order.
+	round := func() {
+		msgs, want := lib, s.pend
+		lib, s.pend = nil, nil
+		for i, msg := range msgs {
+			switch msg.(type) {
+			case TickMsg:
+				if !want[i].tick {
+					j.Fail("round: pending %d is a tick, mirror has a TimeoutMsg", i)
+				}
+				deliver("round tick", msg, want[i].tag)
+			case TimeoutMsg:
+				if want[i].tick {
+					j.Fail("round: pending %d is a TimeoutMsg, mirror has a tick", i)
+				}
+				s.timeouts++
+				if s.timeouts > 1 {
+					j.Fail("round: a second TimeoutMsg")
+				}
+				var cmd tea.Cmd
+				m, cmd = m.Update(msg)
+				expect("round timeout", zrun(cmd), nil)
+			}
+		}
+		check("round")
+	}
+
+	expect("init", zrun(m.Init()), []pending{{tick: true, flag: s.timedout(), tag: s.tag}})
+	check("init")
+
+	for step, op := range c.ops {
+		j.Note("step %d: %#v (timeout %v, running %v, tag %d, %d pending)", step, op, s.timeout, s.running, s.tag, len(s.pend))
+		switch op.kind {
+		case "start":
+			startStop("start", m.Start(), true)
+		case "stop":
+			startStop("stop", m.Stop(), false)
+		case "toggle":
+			startStop("toggle", m.Toggle(), !s.isRunning())
+		case "restart":
+			startStop("restart stop", m.Stop(), false)
+			round()
+			startStop("restart start", m.Start(), true)
+		case "foreign":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: id + 1000})
+			if cmd != nil {
+				j.Fail("a tick for timer %d was answered by timer %d", id+1000, id)
+			}
+			m, cmd = m.Update(StartStopMsg{ID: id + 1000, running: !s.running})
+			if cmd != nil {
+				j.Fail("a StartStopMsg for timer %d was answered by timer %d", id+1000, id)
+			}
+			check("foreign")
+		case "tagged":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: id, tag: s.tag + op.stale})
+			if cmd != nil {
+				j.Fail("a tick with a stale tag was accepted")
+			}
+			check("tagged")
+		case "broadcast":
+			// an ID-0 tick is accepted by every timer; it carries tag 0
+			deliver("broadcast", TickMsg{ID: 0}, 0)
+			check("broadcast")
+		case "round":
+			round()
+		}
+	}
+	if s.timedout() && s.timeouts == 0 && len(s.pend) == 0 {
+		j.Fail("timed out at %v with nothing in flight and no TimeoutMsg delivered", s.timeout)
+	}
+}
+
+// TestHegelTimerCountsDown drives a timer with start/stop/toggle and rounds
+// of tick delivery and checks Timeout, Running, Timedout, View and the
+// messages the timer emits against the mirror. The shapes of bubbles/92
+// (every StartStopMsg and every broadcast tick starts another tick chain and
+// none is ever rejected, so the countdown speeds up) and bubbles/93 (the
+// countdown goes negative when the timeout is not a multiple of the
+// interval) fail naming them.
+func TestHegelTimerCountsDown(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, timerCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTimer(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/92
+func TestHegelPinTimerStartWhileRunningDoublesTheSpeed(t *testing.T) {
+	m := New(10*time.Microsecond, WithInterval(time.Microsecond))
+	pend := zrun(m.Init())
+	for _, msg := range zrun(m.Start()) {
+		var c tea.Cmd
+		m, c = m.Update(msg)
+		pend = append(pend, zrun(c)...)
+	}
+	// One interval passes: every tick in flight arrives.
+	for _, msg := range pend {
+		m, _ = m.Update(msg)
+	}
+	if m.Timeout != 9*time.Microsecond {
+		t.Fatalf("after Init, Start and one interval the timeout is %v, expected 9µs: %d ticks were accepted", m.Timeout, 10-int(m.Timeout/time.Microsecond))
+	}
+}
+
+// bubbles/93
+func TestHegelPinTimerViewGoesNegative(t *testing.T) {
+	m := New(1500*time.Microsecond, WithInterval(1000*time.Microsecond))
+	pend := zrun(m.Init())
+	for round := 0; round < 3; round++ {
+		var next []tea.Msg
+		for _, msg := range pend {
+			var c tea.Cmd
+			m, c = m.Update(msg)
+			next = append(next, zrun(c)...)
+		}
+		pend = next
+	}
+	if m.Timeout < 0 {
+		t.Fatalf("a 1.5ms timer ticking every 1ms ends at %v (View %q), expected 0", m.Timeout, m.View())
+	}
+}
diff --git a/tree/hegel_test.go b/tree/hegel_test.go
new file mode 100644
index 0000000..0ed8288
--- /dev/null
+++ b/tree/hegel_test.go
@@ -0,0 +1,826 @@
+package tree
+
+// Hegel zoo: properties of the tree component against a mirror of its
+// selection, its line offsets, its viewport scroll and its rendered rows.
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	ltree "charm.land/lipgloss/v2/tree"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// ---------------------------------------------------------------- the model
+
+// tn mirrors one node: its value, whether it was made with Root (and so
+// carries an open/closed indicator), its open state and its children.
+type tn struct {
+	val  string
+	rows []string
+	sub  bool
+	open bool
+	kids []*tn
+	node *Node
+
+	// filled by layout
+	parent *tn
+	last   bool
+	pre    string // the ancestors' indents
+	y      int    // offset in nodes
+	line   int    // offset in rendered lines
+	shift  int    // lines the library's offset is short by (bubbles/86)
+}
+
+var words = []string{"a", "bb", "ccc", "dddd", "emacs", "zsh", "go.mod", "x", "README", "tools", "img.png", "b2", "q"}
+
+func genValue(tc hegel.TestCase) string {
+	switch {
+	case zootest.Chance(tc, 3):
+		return ""
+	case zootest.Chance(tc, 2):
+		zootest.Count("gen-wide")
+		return strings.Repeat(zootest.Pick(tc, words)+"-", zootest.N(tc, 8, 14))
+	case zootest.Chance(tc, 10):
+		n := zootest.N(tc, 2, 3)
+		rows := make([]string, n)
+		for i := range rows {
+			rows[i] = zootest.Pick(tc, words)
+		}
+		zootest.Count("gen-multiline")
+		return strings.Join(rows, "\n")
+	}
+	return zootest.Pick(tc, words)
+}
+
+func genTree(tc hegel.TestCase, depth int) *tn {
+	n := &tn{val: genValue(tc)}
+	n.rows = strings.Split(n.val, "\n")
+	if depth == 0 || zootest.Chance(tc, 45) {
+		return n // a leaf
+	}
+	n.sub = true
+	n.open = !zootest.Chance(tc, 25)
+	k := zootest.N(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		n.kids = append(n.kids, genTree(tc, depth-1))
+	}
+	return n
+}
+
+// build makes the library's nodes for the mirror (and remembers them).
+func build(n *tn) *Node {
+	if !n.sub {
+		return nil // leaves are added to the parent as strings
+	}
+	root := Root(n.val)
+	for _, k := range n.kids {
+		if k.sub {
+			root.Child(build(k))
+		} else {
+			root.Child(k.val)
+		}
+	}
+	n.node = root
+	kids := root.ChildNodes()
+	for i, k := range n.kids {
+		if !k.sub {
+			k.node = kids[i]
+		}
+	}
+	if !n.open {
+		root.Close()
+	}
+	return root
+}
+
+// tm mirrors the model: the tree, the selection, the sizes and the viewport.
+type tm struct {
+	root     *tn
+	vis      []*tn
+	total    int
+	sel      int
+	w, h     int
+	vh       int // the viewport's height (h minus the help at the last SetSize)
+	vpY      int
+	so       int
+	showHelp bool
+	showAll  bool
+	sizedAll bool // ShowAll at the last SetSize
+	lastEnum string
+	openCh   string
+	closedCh string
+	cursor   string
+
+	// the content as rendered at the last updateViewport
+	rows    []string
+	wide    bool
+	renderW int
+
+	sized     bool // a resize since the last scroll fix (bubbles/78)
+	helpStale bool // the viewport was sized by the help at the old width (bubbles/89)
+	rootStale bool // the selection was clamped to the root without a scroll (bubbles/90)
+}
+
+func (s *tm) layout() {
+	s.vis = s.vis[:0]
+	s.total = 0
+	s.walk(s.root, nil, false, "", 0)
+}
+
+func (s *tm) walk(n *tn, parent *tn, last bool, pre string, shift int) {
+	n.parent, n.last, n.pre, n.shift = parent, last, pre, shift
+	n.y = len(s.vis)
+	n.line = s.total
+	s.vis = append(s.vis, n)
+	s.total += len(n.rows)
+	if !n.open {
+		return
+	}
+	// The library's line offsets are short by the extra rows of every
+	// multi-line ancestor (bubbles/86) and by one for every earlier sibling
+	// (of the node or of an ancestor) that is an open, empty-valued node
+	// with children, whose own rendering drops its root line (bubbles/88).
+	short := 0
+	for i, k := range n.kids {
+		kpre := pre
+		if parent != nil { // the root's children carry no indent
+			if last {
+				kpre += "   "
+			} else {
+				kpre += "│  "
+			}
+		}
+		s.walk(k, n, i == len(n.kids)-1, kpre, shift+len(n.rows)-1+short)
+		if k.sub && k.val == "" && k.open && len(k.kids) > 0 {
+			short++
+		}
+	}
+}
+
+func (s *tm) indicator(n *tn) string {
+	if !n.sub {
+		return ""
+	}
+	ch := s.closedCh
+	if n.open {
+		ch = s.openCh
+	}
+	if ch != "" {
+		ch += " "
+	}
+	return ch
+}
+
+// nodeRows are the rendered lines of one node, without the cursor column.
+func (s *tm) nodeRows(n *tn) []string {
+	ind := s.indicator(n)
+	pad := strings.Repeat(" ", ansi.StringWidth(ind))
+	var out []string
+	if n.parent == nil {
+		out = append(out, ind+n.rows[0])
+		for _, r := range n.rows[1:] {
+			out = append(out, pad+r)
+		}
+		return out
+	}
+	enum := "├──"
+	indent := "│  "
+	if n.last {
+		enum = s.lastEnum
+		indent = "   "
+	}
+	out = append(out, n.pre+enum+ind+n.rows[0])
+	for _, r := range n.rows[1:] {
+		out = append(out, n.pre+indent+pad+r)
+	}
+	return out
+}
+
+// render mirrors updateViewport's SetContent: the cursor column joined to
+// the tree's rows, and whether any row is wider than the width (bubbles/79).
+func (s *tm) render() {
+	s.rows = s.rows[:0]
+	s.wide = false
+	s.renderW = s.w
+	cw := ansi.StringWidth(s.cursor)
+	blank := strings.Repeat(" ", cw) + " "
+	for i, n := range s.vis {
+		for j, r := range s.nodeRows(n) {
+			row := r
+			if s.cursor != "" {
+				if i == s.sel && j == 0 {
+					row = s.cursor + " " + r
+				} else {
+					row = blank + r
+				}
+			}
+			if ansi.StringWidth(row) > s.w {
+				s.wide = true
+			}
+			s.rows = append(s.rows, row)
+		}
+	}
+}
+
+func (s *tm) maxY() int { return max(0, s.total-s.vh) }
+
+func (s *tm) setContent() {
+	if s.vpY > s.maxY() {
+		s.vpY = s.maxY()
+	}
+}
+
+// update mirrors Model.updateViewport(movement).
+func (s *tm) update(movement int) {
+	s.sel = max(min(len(s.vis)-1, s.sel+movement), 0)
+	s.render()
+	s.setContent()
+	if s.sel == 0 && movement == 0 {
+		// The "initial render" early return: no scroll, whatever the
+		// viewport's offset (bubbles/90 when it is past the root).
+		s.rootStale = s.vpY > 0
+		return
+	}
+	s.sized = false
+	s.rootStale = false
+	// The library scrolls by its own line offset, short by the extra
+	// rows of multi-line ancestors (bubbles/86).
+	line := s.vis[s.sel].line - s.vis[s.sel].shift
+	height := max(0, min(s.vh, s.total-s.vpY)) // VisibleLineCount
+	if s.vh <= 0 {
+		height = 0
+	}
+	so := min(s.so, height/2)
+	minTop := max(line-so, 0)
+	minBottom := min(s.total-1, line+so)
+	if s.vpY > minTop {
+		s.vpY = min(max(minTop, 0), s.maxY())
+	} else if s.vpY+height < minBottom+1 {
+		s.vpY = min(max(minBottom-height+1, 0), s.maxY())
+	}
+}
+
+// setSize mirrors SetSize; before is the help's height as it was before the
+// call (SetSize measures it before giving the help its new width, bubbles/89).
+func (s *tm) setSize(m *Model, w, h int, before int) {
+	s.w, s.h = w, h
+	hv, now := 0, 0
+	if s.showHelp {
+		hv = before
+		now = lipgloss.Height(m.helpView())
+	}
+	s.vh = h - hv
+	s.helpStale = hv != now
+	s.sizedAll = s.showAll
+	s.sized = true
+}
+
+// helpHeight is the help view's height as the library measures it now.
+func helpHeight(m *Model) int { return lipgloss.Height(m.helpView()) }
+
+func (s *tm) toggle(open bool) {
+	n := s.vis[s.sel]
+	n.open = open
+	s.layout()
+	s.update(0)
+}
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(tc hegel.TestCase, op string) tea.KeyPressMsg {
+	pick := func(ks ...tea.KeyPressMsg) tea.KeyPressMsg { return zootest.Pick(tc, ks) }
+	ch := func(r rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+	ctrl := func(r rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: r, Mod: tea.ModCtrl} }
+	switch op {
+	case "down":
+		return pick(tea.KeyPressMsg{Code: tea.KeyDown}, ch('j'), ctrl('n'))
+	case "up":
+		return pick(tea.KeyPressMsg{Code: tea.KeyUp}, ch('k'), ctrl('p'))
+	case "pgdown":
+		return pick(tea.KeyPressMsg{Code: tea.KeyPgDown}, tea.KeyPressMsg{Code: tea.KeySpace, Text: " "}, ch('f'))
+	case "pgup":
+		return pick(tea.KeyPressMsg{Code: tea.KeyPgUp}, ch('b'))
+	case "halfdown":
+		return pick(ch('d'), ctrl('d'))
+	case "halfup":
+		return pick(ch('u'), ctrl('u'))
+	case "top":
+		return pick(ch('g'), tea.KeyPressMsg{Code: tea.KeyHome})
+	case "bottom":
+		return pick(ch('G'), tea.KeyPressMsg{Code: tea.KeyEnd})
+	case "toggle":
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	case "open":
+		return pick(ch('l'), tea.KeyPressMsg{Code: tea.KeyRight})
+	case "close":
+		return pick(ch('h'), tea.KeyPressMsg{Code: tea.KeyLeft})
+	case "help":
+		return ch('?')
+	}
+	panic(op)
+}
+
+var treeOps = []string{
+	"down", "down", "down", "down", "down", "down", "down", "down",
+	"up", "up", "up", "up", "up", "up",
+	"pgdown", "pgdown", "pgdown", "pgup", "pgup", "pgup",
+	"halfdown", "halfdown", "halfup", "halfup",
+	"top", "top", "bottom", "bottom",
+	"toggle", "toggle", "toggle", "toggle", "toggle", "toggle",
+	"open", "open", "open", "close", "close", "close",
+	"help", "help",
+	"setyoffset", "setyoffset",
+	"setsize", "setsize", "setsize", "setheight", "setheight", "setwidth",
+	"setscrolloff", "setscrolloff", "setshowhelp", "setshowhelp",
+	"setnodes", "setcursor",
+}
+
+// ---------------------------------------------------------------- property
+
+func TestHegelTreeFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s := &tm{lastEnum: "└──", openCh: "▼", closedCh: "▶", cursor: "→", so: 5, showHelp: true}
+
+		// The tree: always a Root at the top.
+		s.root = genTree(tc, 3)
+		s.root.sub = true
+		s.root.open = !zootest.Chance(tc, 10)
+		if len(s.root.kids) == 0 {
+			s.root.kids = append(s.root.kids, genTree(tc, 2))
+		}
+		root := build(s.root)
+
+		w := zootest.N(tc, 24, 60)
+		if zootest.Chance(tc, 3) {
+			w = zootest.N(tc, 6, 23)
+		}
+		h := zootest.N(tc, 3, 18)
+		if zootest.Chance(tc, 5) {
+			h = zootest.N(tc, 0, 2)
+		}
+		m := New(root, w, h)
+		if zootest.Chance(tc, 40) {
+			s.so = zootest.N(tc, 0, 8)
+			m.SetScrollOff(s.so)
+		}
+		if zootest.Chance(tc, 20) {
+			s.showHelp = false
+			m.SetShowHelp(false)
+		}
+		switch {
+		case zootest.Chance(tc, 10):
+			s.cursor = ""
+			m.SetCursorCharacter("")
+		case zootest.Chance(tc, 10):
+			s.cursor = "👉"
+			m.SetCursorCharacter("👉")
+		}
+		switch {
+		case zootest.Chance(tc, 10):
+			s.openCh, s.closedCh = "-", "+"
+			m.SetOpenCharacter("-")
+			m.SetClosedCharacter("+")
+		case zootest.Chance(tc, 5):
+			s.openCh, s.closedCh = "", ""
+			m.SetOpenCharacter("")
+			m.SetClosedCharacter("")
+		}
+		if zootest.Chance(tc, 20) {
+			s.lastEnum = "╰──"
+			m.Enumerator(ltree.RoundedEnumerator)
+		}
+		hb := helpHeight(&m)
+		m.SetSize(w, h)
+		s.setSize(&m, w, h, hb)
+		m.SetNodes(root) // renders with every option applied
+		s.layout()
+		s.update(0)
+
+		var trail []string
+		nops := zootest.N(tc, 1, 45)
+		for step := 0; step < nops; step++ {
+			op := zootest.Pick(tc, treeOps)
+			desc := op
+			switch op {
+			case "down", "up", "pgdown", "pgup", "halfdown", "halfup", "top", "bottom", "toggle", "open", "close", "help":
+				k := keyOf(tc, op)
+				desc = fmt.Sprintf("%s(%s)", op, k.String())
+				var cmd tea.Cmd
+				m, cmd = m.Update(k)
+				if cmd != nil {
+					if msg := cmd(); msg != nil {
+						m, _ = m.Update(msg)
+					}
+				}
+				switch op {
+				case "down":
+					s.update(1)
+				case "up":
+					s.update(-1)
+				case "pgdown":
+					if k.Code == tea.KeySpace {
+						zootest.Count("bubbles/87") // bound as " ", reported as "space"
+					} else {
+						s.update(s.vh)
+					}
+				case "pgup":
+					s.update(-s.vh)
+				case "halfdown":
+					s.update(s.vh / 2)
+				case "halfup":
+					s.update(-s.vh / 2)
+				case "top":
+					s.update(-s.sel)
+				case "bottom":
+					s.update(len(s.vis))
+				case "toggle":
+					s.toggle(!s.vis[s.sel].open)
+				case "open":
+					s.toggle(true)
+				case "close":
+					s.toggle(false)
+				case "help":
+					s.showAll = !s.showAll
+				}
+			case "setyoffset":
+				y := zootest.N(tc, -1, len(s.vis)+1)
+				desc = fmt.Sprintf("setyoffset(%d)", y)
+				m.SetYOffset(y)
+				s.update(y - s.sel)
+			case "setsize", "setheight", "setwidth":
+				nw, nh := s.w, s.h
+				if op != "setheight" {
+					nw = zootest.N(tc, 24, 60)
+					if zootest.Chance(tc, 10) {
+						nw = zootest.N(tc, 6, 23)
+					}
+				}
+				if op != "setwidth" {
+					nh = zootest.N(tc, 3, 18)
+					if zootest.Chance(tc, 10) {
+						nh = zootest.N(tc, 0, 2)
+					}
+				}
+				desc = fmt.Sprintf("%s(%d,%d)", op, nw, nh)
+				hb := helpHeight(&m)
+				switch op {
+				case "setsize":
+					m.SetSize(nw, nh)
+				case "setheight":
+					m.SetHeight(nh)
+				case "setwidth":
+					m.SetWidth(nw)
+				}
+				s.setSize(&m, nw, nh, hb)
+			case "setscrolloff":
+				s.so = zootest.N(tc, 0, 8)
+				desc = fmt.Sprintf("setscrolloff(%d)", s.so)
+				m.SetScrollOff(s.so)
+			case "setshowhelp":
+				s.showHelp = zootest.Chance(tc, 50)
+				desc = fmt.Sprintf("setshowhelp(%v)", s.showHelp)
+				hb := helpHeight(&m)
+				m.SetShowHelp(s.showHelp)
+				s.setSize(&m, s.w, s.h, hb)
+			case "setnodes":
+				s.root = genTree(tc, 3)
+				s.root.sub = true
+				s.root.open = !zootest.Chance(tc, 10)
+				root = build(s.root)
+				m.SetNodes(root)
+				s.layout()
+				s.update(0)
+			case "setcursor":
+				s.cursor = zootest.Pick(tc, []string{"→", ">", "", "👉", "»"})
+				desc = fmt.Sprintf("setcursor(%q)", s.cursor)
+				m.SetCursorCharacter(s.cursor)
+				hb := helpHeight(&m)
+				m.SetSize(s.w, s.h)
+				s.setSize(&m, s.w, s.h, hb)
+			}
+			trail = append(trail, desc)
+			ctx := func() string {
+				return fmt.Sprintf("after %v\nsel=%d of %d, total=%d lines, vpY=%d, w=%d h=%d vh=%d so=%d help=%v/%v cursor=%q",
+					trail, s.sel, len(s.vis), s.total, s.vpY, s.w, s.h, s.vh, s.so, s.showHelp, s.showAll, s.cursor)
+			}
+
+			// The selection and the offsets.
+			if m.YOffset() != s.sel {
+				zootest.Fail(ht, "YOffset %d, want %d\n%s", m.YOffset(), s.sel, ctx())
+			}
+			if m.Root().Size() != len(s.vis) {
+				zootest.Fail(ht, "Size %d, want %d\n%s", m.Root().Size(), len(s.vis), ctx())
+			}
+			if m.NodeAtCurrentOffset() != s.vis[s.sel].node {
+				zootest.Fail(ht, "NodeAtCurrentOffset is %v, want %q\n%s", m.NodeAtCurrentOffset().GivenValue(), s.vis[s.sel].val, ctx())
+			}
+			for i, n := range s.vis {
+				if n.node.YOffset() != i {
+					zootest.Fail(ht, "node %q at y=%d, want y=%d\n%s", n.val, n.node.YOffset(), i, ctx())
+				}
+				if n.shift > 0 {
+					zootest.Count("bubbles/86")
+				} else if n.node.LineOffset() != n.line {
+					zootest.Fail(ht, "node %q at line=%d, want line=%d\n%s", n.val, n.node.LineOffset(), n.line, ctx())
+				}
+				if n.node.IsSelected() != (i == s.sel) {
+					zootest.Fail(ht, "node %q IsSelected %v at y=%d (selected %d)\n%s", n.val, n.node.IsSelected(), i, s.sel, ctx())
+				}
+				if m.Node(i) != n.node {
+					zootest.Fail(ht, "Node(%d) is not %q\n%s", i, n.val, ctx())
+				}
+			}
+			if m.Node(len(s.vis)) != nil {
+				zootest.Fail(ht, "Node(%d) past the end is %v\n%s", len(s.vis), m.Node(len(s.vis)).GivenValue(), ctx())
+			}
+			if m.Width() != s.w || m.Height() != s.h {
+				zootest.Fail(ht, "size %dx%d, want %dx%d\n%s", m.Width(), m.Height(), s.w, s.h, ctx())
+			}
+			if m.viewport.Height() != s.vh {
+				zootest.Fail(ht, "viewport height %d, want %d\n%s", m.viewport.Height(), s.vh, ctx())
+			}
+			if s.wide {
+				// A row wider than the width is wrapped by the tree style,
+				// so the content has more lines than the model: the scroll
+				// is the library's while that lasts (bubbles/79).
+				zootest.Count("bubbles/79")
+				s.vpY = m.ViewportYOffset()
+				continue
+			}
+			if m.ViewportYOffset() != s.vpY {
+				zootest.Fail(ht, "viewport YOffset %d, want %d\n%s", m.ViewportYOffset(), s.vpY, ctx())
+			}
+
+			// The selection is in view (bubbles/78 after a resize).
+			if s.vh >= 1 {
+				line := s.vis[s.sel].line
+				if line < s.vpY || line >= s.vpY+s.vh {
+					if s.sized {
+						zootest.Count("bubbles/78")
+					} else if s.rootStale {
+						zootest.Count("bubbles/90")
+					} else if s.vis[s.sel].shift > 0 {
+						zootest.Count("bubbles/86")
+					} else {
+						zootest.Fail(ht, "selected line %d outside the window [%d,%d)\n%s", line, s.vpY, s.vpY+s.vh, ctx())
+					}
+				}
+			}
+
+			// The view.
+			if s.vis[s.sel].shift > 0 {
+				zootest.Count("bubbles/86") // the cursor is drawn on the library's line
+				continue
+			}
+			view := strings.Split(ansi.Strip(m.View()), "\n")
+			hv := 0
+			if s.showHelp {
+				hv = lipgloss.Height(m.helpView())
+			}
+			want := max(s.vh, 1) + hv
+			if len(view) != want {
+				zootest.Fail(ht, "view has %d lines, want %d\n%s\n%s", len(view), want, ctx(), strings.Join(view, "\n"))
+			}
+			if s.vh >= 1 && want != s.h {
+				if s.showAll != s.sizedAll {
+					zootest.Count("bubbles/77")
+				} else if s.helpStale {
+					zootest.Count("bubbles/89")
+				} else {
+					zootest.Fail(ht, "view has %d lines for a height of %d\n%s", want, s.h, ctx())
+				}
+			}
+			if s.vh >= 1 && s.w >= 1 {
+				for i := 0; i < s.vh; i++ {
+					exp := ""
+					if idx := s.vpY + i; idx < len(s.rows) {
+						exp = s.rows[idx]
+					}
+					exp = strings.TrimRight(ansi.Truncate(exp, s.w, ""), " ")
+					got := strings.TrimRight(view[i], " ")
+					if got != exp {
+						zootest.Fail(ht, "row %d is %q, want %q\n%s\n%s", i, got, exp, ctx(), strings.Join(view, "\n"))
+					}
+				}
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func pinTree(children ...any) Model {
+	return New(Root("root").Child(children...), 30, 8)
+}
+
+// cursorRow is the stripped view row carrying the cursor, or "".
+func cursorRow(m Model) string {
+	for _, l := range strings.Split(ansi.Strip(m.View()), "\n") {
+		if strings.HasPrefix(l, "→") {
+			return l
+		}
+	}
+	return ""
+}
+
+// bubbles/75
+func TestHegelPinTreeSetNodesNilPanics(t *testing.T) {
+	defer zootest.Guard(t)
+	m := pinTree("a")
+	m.SetNodes(nil)
+	if m.Root() != nil {
+		t.Fatalf("root %v after SetNodes(nil)", m.Root().GivenValue())
+	}
+}
