+	start := hegel.Draw(tc, plainStarts(root, hegel.Draw(tc, startHeights)))
+	start.hidden, start.dirOK, start.fileOK = false, true, zootest.Shaped(false, true)
+	return fpCase{start: start, ops: []fpOp{opOf("enter", "enter")}}
+})
+
+func TestHegelFilepickerEnterOnADirectoryReportsIt(t *testing.T) {
+	narrowPicker(t, enterOnADirectoryReportsIt)
+}
+
+// --------------------------------------------------------------------------- bubbles/73
+
+// backRestoresTheWindowAtTheNewHeight: Open on a directory, a resize inside
+// it (past the shape, none) and Back: the parent's window comes back as
+// saved, with more rows than the new height (a height of 2 to 6 over files
+// enough to fill it, shrunk inside a directory of random files) or fewer
+// (two directories at height 1, G to the second, an empty one so that the
+// resize itself leaves nothing hidden, grown inside it: the window widens
+// downward over the one entry) (1000 of 1000).
+var backRestoresTheWindowAtTheNewHeight = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	sub := hegel.Draw(tc, filesTree(0, visibleNames))
+	more := hegel.Draw(tc, zootest.Coin(50))
+	var root fpTree
+	var h, h1 int
+	var ops, past []fpOp
+	open, back := hegel.Draw(tc, openOps), hegel.Draw(tc, backOps)
+	if !more {
+		root = withSubs(emptyTree(), sub, emptyTree())
+		h, h1 = 1, hegel.Draw(tc, zootest.Ints(2, 8))
+		ops = []fpOp{opOf("G", "G"), open, hegel.Draw(tc, resizeTo(h1)), back}
+		past = []fpOp{opOf("G", "G"), open, back}
+	} else {
+		h = hegel.Draw(tc, zootest.Ints(2, 6))
+		root = withSubs(hegel.Draw(tc, filesTree(h-1, visibleNames)), sub)
+		h1 = hegel.Draw(tc, zootest.Ints(1, h-1))
+		ops = []fpOp{open, hegel.Draw(tc, resizeTo(h1)), back}
+		past = []fpOp{open, back}
+	}
+	start := autoHeight(hegel.Draw(tc, plainStarts(root, h)))
+	start.hidden = false
+	return fpCase{start: start, ops: zootest.Shaped(ops, past)}
+})
+
+func TestHegelFilepickerBackRestoresTheWindowAtTheNewHeight(t *testing.T) {
+	narrowPicker(t, backRestoresTheWindowAtTheNewHeight)
+}
+
+// --------------------------------------------------------------------------- bubbles/74
+
+// negativeHeightAndAPageKey: AutoHeight and a WindowSizeMsg of 1 to 4 rows
+// (a height of -4 to -1) over one to six files, then a page key: the library
+// adds the negative height and the selection moves the other way (1000 of
+// 1000). Past the shape, 5 to 8 rows (a height of 0 to 3) and PageDown over
+// at least twice the height in files, which does not clamp (bubbles/64's
+// shape otherwise).
+var negativeHeightAndAPageKey = hegel.Composite(func(tc hegel.TestCase) fpCase {
+	rows := hegel.Draw(tc, zootest.Ints(zootest.Shaped(1, 5), zootest.Shaped(4, 8)))
+	tree := hegel.Draw(tc, filesTree(zootest.Shaped(1, max(1, 2*(rows-marginBottom))), visibleNames))
+	start := autoHeight(hegel.Draw(tc, plainStarts(tree, hegel.Draw(tc, startHeights))))
+	page := hegel.Draw(tc, zootest.Shaped(zootest.Weighted(zootest.W(1, pgdownOps), zootest.W(1, pgupOps)), pgdownOps))
+	return fpCase{start: start, ops: []fpOp{{kind: "size", n: rows}, page}}
+})
+
+func TestHegelFilepickerNegativeHeightAndAPageKey(t *testing.T) {
+	narrowPicker(t, negativeHeightAndAPageKey)
+}
