+// bubbles/26: an empty keyboard selection (shift+right at the end of the
+// buffer) keeps its anchor through later edits, so the next shift+arrow
+// selects from where the cursor was.
+func TestHegelPinEmptySelectionKeepsAStaleAnchor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue("o")
+	m = press(m, kSelRight) // nothing to select past the end
+	m = press(m, kKillBack) // line is now empty
+	for _, r := range "abc" {
+		m = press(m, typed(r))
+	}
+	m = press(m, kSelLeft)
+	if got := m.SelectedText(); got != "c" {
+		t.Errorf("shift+left after typing \"abc\" selects %q, want \"c\"", got)
+	}
+	// and when the anchor's line has been deleted, the next edit panics
+	m = pinArea(20, 3)
+	m.SetValue("a\n")
+	m = press(m, kSelRight)  // empty selection anchored at (1,0)
+	m = press(m, kBackspace) // joins the lines: line 1 is gone
+	m = press(m, kSelLeft)   // selection from the stale (1,0) to (0,0)
+	m = press(m, typed('x')) // deleteSelection indexes value[1]
+	if m.Value() != "x" && m.Value() != "ax" {
+		t.Errorf("value %q after the stale selection", m.Value())
