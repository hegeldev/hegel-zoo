+// TestHegelRealCursorSitsUnderTheVirtualOne: with the virtual cursor off,
+// Cursor() reports the column where View draws the cursor.
+func TestHegelRealCursorSitsUnderTheVirtualOne(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		m.Focus()
+		m.Prompt = pick(ht, []string{"> ", "", "Name: "})
+		if chance(ht, 70) {
+			m.SetWidth(n(ht, 1, 10))
+		}
+		m.SetValue(string(genRunes(ht, 0, 14)))
+		for i := n(ht, 0, 4); i > 0; i-- {
+			m.SetCursor(n(ht, 0, len(m.value)))
+		}
+		note(ht, "width %d value %q pos %d window [%d,%d)", m.Width(), m.Value(), m.pos, m.offset, m.offsetRight)
+		checkView(ht, m, "virtual cursor")
+		want := lipgloss.Width(m.Prompt) + uniseg.StringWidth(string(m.value[m.offset:m.pos]))
+		m.SetVirtualCursor(false)
+		c := m.Cursor()
+		if c == nil {
+			fail(ht, "Cursor() is nil for a focused input without a virtual cursor")
+		}
+		if c.Position.Y != 0 {
+			fail(ht, "Cursor() row %d, want 0", c.Position.Y)
+		}
+		if c.Position.X != want {
+			if m.offset > 0 || uniseg.StringWidth(string(m.value[:m.pos])) != m.pos {
+				// Cursor() adds the rune index to the prompt width: wrong
+				// once the window has scrolled or a wide rune precedes the
+				// cursor (bubbles/8).
+				count("bubbles/8-shape")
+				return
+			}
+			fail(ht, "Cursor() at column %d, want %d (value %q pos %d window [%d,%d) width %d)", c.Position.X, want, m.Value(), m.pos, m.offset, m.offsetRight, m.Width())
+		}
+	})
+}
