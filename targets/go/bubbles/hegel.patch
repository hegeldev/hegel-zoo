new file mode 100644
index 0000000..1cb74bf
--- /dev/null
+++ b/filepicker/hegel_test.go
@@ -0,0 +1,1330 @@
+package filepicker
+
+// Hegel property tests for the file picker: a random directory tree is built
+// under a fresh temporary directory per case and the picker driven through
+// every binding, the window messages and the setters against a model of its
+// listing, its selection, its window and its view stack.
+//
+// A case is a record of the start (the tree's spec: which of eight file names
+// exist and their sizes, which of three subdirectory names exist, two levels
+// deep, the symlinks to a file, a directory and nowhere, and a subdirectory
+// made unreadable; ShowHidden, AutoHeight, the permission and size columns,
+// FileAllowed/DirAllowed, AllowedTypes and a height or none) and a list of
+// one to twenty-five operation records (every default binding: g, G,
+// j/down/ctrl+n, k/up/ctrl+p, J/pgdown, K/pgup, h/backspace/left/esc,
+// l/right, enter; a WindowSizeMsg, SetHeight, toggling ShowHidden, new
+// allowed flags and types) applied in order; the commands Update returns are
+// run and their messages fed back. The model keeps the listing as readDir
+// defines it (directories first, names ascending, hidden names dropped unless
+// ShowHidden), the selection, the window and the view stack, and states the
+// TRUE window: the selection inside the listing and the window, never more
+// rows than the height and never fewer than the entries allow (the page keys
+// clamp to a window of Height entries; a smaller height keeps the selection
+// in view; G without a height selects the last entry and shows it; a larger
+// height fills the window with entries; Back restores the parent's selection
+// clamped to the re-read listing and its window fitted to the current height;
+// a negative height is no height; an unreadable directory is not entered)
+// and the true selection report (DidSelectFile looks at the entry enter was
+// pressed on). After the start and after every operation CurrentDirectory,
+// Path, the selection and window indices, the height, HighlightedPath and
+// the lines of View (cursor, mode, size, name, symlink target; blank rows to
+// the height; the empty-directory message) must follow, and after an enter
+// DidSelectFile/DidSelectDisabledFile must report the pressed entry per the
+// allowed flags and types.
+//
+// The shapes of the recorded bugs are drawn like any other case and a
+// classifier names the bug a step has before it is taken, on a clone where
+// the step is replayed with the library's arithmetic beside the true one: a
+// page key clamping at an end (bubbles/64), or any page key at a negative
+// height (74); a resize hiding the selection (65) or leaving rows blank over
+// hidden entries (67); G without a height (66); Back onto a listing of another
+// length (68) or at another height (73); Open or enter on an unreadable
+// directory (69); enter on a directory with DirAllowed whose report the
+// library takes from the entered listing (72). The comparison is always made
+// and fails naming the shape. The trailing newline (71) is the shape of every
+// non-empty directory's view and cannot be drawn or not drawn: the view's
+// line count is its own check, which fails by default naming 71, so the wide
+// property's basin is 71 in every round (the other bugs are reached by the
+// narrow properties and judged by the wide property under HEGEL_NO_KNOWN=1);
+// under HEGEL_NO_KNOWN=1 that one check is dropped (counted as known once per
+// case) and the rest of the view compared with the trailing newline stripped,
+// the unreadable directory is not drawn and the operations with a shape are
+// dropped from the case on a replay of the model. Back from the default
+// directory "." (70) needs the working directory and lives in its narrow
+// property alone.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/dustin/go-humanize"
+	"hegel.dev/go/hegel"
+)
+
+var property = zootest.Property
+
+// ---------------------------------------------------------------- listing
+
+// fent is one entry of a listing as the picker sees it.
+type fent struct {
+	name    string
+	dir     bool // IsDir of the entry itself (false for a symlink)
+	link    bool
+	target  string // EvalSymlinks of a symlink, "" when broken
+	linkDir bool   // the symlink's target is a directory
+	mode    string
+	size    string
+}
+
+// readEntries lists dir the way readDir does: directories first, names
+// ascending, hidden names dropped unless showHidden.
+func readEntries(dir string, showHidden bool) ([]fent, error) {
+	des, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	sort.SliceStable(des, func(i, j int) bool {
+		if des[i].IsDir() == des[j].IsDir() {
+			return des[i].Name() < des[j].Name()
+		}
+		return des[i].IsDir()
+	})
+	var out []fent
+	for _, de := range des {
+		if !showHidden && strings.HasPrefix(de.Name(), ".") {
+			continue
+		}
+		info, err := de.Info()
+		if err != nil {
+			return nil, err
+		}
+		e := fent{name: de.Name(), dir: de.IsDir(), mode: info.Mode().String()}
+		e.size = strings.Replace(humanize.Bytes(uint64(info.Size())), " ", "", 1)
+		if info.Mode()&os.ModeSymlink != 0 {
+			e.link = true
+			e.target, _ = filepath.EvalSymlinks(filepath.Join(dir, de.Name()))
+			if st, err := os.Stat(e.target); err == nil && st.IsDir() {
+				e.linkDir = true
+			}
+		}
+		out = append(out, e)
+	}
+	return out, nil
+}
+
+// row is the entry's line of the view: the cursor or a blank, the mode, the
+// size, the name and a symlink's target.
+func (e fent) row(selected bool, cursor string, perms, sizes bool) string {
+	var sb strings.Builder
+	if selected {
+		sb.WriteString(cursor)
+	} else {
+		sb.WriteString(" ")
+	}
+	if perms {
+		sb.WriteString(" " + e.mode)
+	}
+	if sizes {
+		fmt.Fprintf(&sb, "%7s", e.size)
+	}
+	sb.WriteString(" " + e.name)
+	if e.link {
+		sb.WriteString(" \u2192 " + e.target)
+	}
+	return sb.String()
+}
+
+func keyMsg(s string) tea.KeyPressMsg {
+	switch s {
+	case "enter":
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	case "pgdown":
+		return tea.KeyPressMsg{Code: tea.KeyPgDown}
+	case "pgup":
+		return tea.KeyPressMsg{Code: tea.KeyPgUp}
+	case "down":
+		return tea.KeyPressMsg{Code: tea.KeyDown}
+	case "up":
+		return tea.KeyPressMsg{Code: tea.KeyUp}
+	case "left":
+		return tea.KeyPressMsg{Code: tea.KeyLeft}
+	case "right":
+		return tea.KeyPressMsg{Code: tea.KeyRight}
+	case "backspace":
+		return tea.KeyPressMsg{Code: tea.KeyBackspace}
+	case "esc":
+		return tea.KeyPressMsg{Code: tea.KeyEscape}
+	case "ctrl+n":
+		return tea.KeyPressMsg{Code: 'n', Mod: tea.ModCtrl}
+	case "ctrl+p":
+		return tea.KeyPressMsg{Code: 'p', Mod: tea.ModCtrl}
+	}
+	r := []rune(s)[0]
+	return tea.KeyPressMsg{Code: r, Text: s}
+}
+
+// ---------------------------------------------------------------- generators
+
+var fileNames = []string{"a.go", "b.txt", "c.md", "d.go", "e", "ff.txt", ".h.txt", ".i.go"}
+var dirNames = []string{"d1", "d2", ".d3"}
+
+// fpTree is the spec of a directory: the size of each of the eight file
+// names (-1 for absent), the three subdirectory names (present or not, two
+// levels deep), the symlinks ln-f (to a.go), ln-d (to d1) and ln-x (to
+// nowhere), and the index of the subdirectory made unreadable (chmod 0o000,
+// bubbles/69), -1 for none.
+type fpTree struct {
+	present       bool
+	sizes         []int
+	subs          []fpTree
+	lnF, lnD, lnX bool
+	locked        int
+}
+
+// emptyTree is a present directory with nothing in it.
+func emptyTree() fpTree {
+	return fpTree{present: true, sizes: []int{-1, -1, -1, -1, -1, -1, -1, -1}, locked: -1}
+}
+
+func (t fpTree) String() string {
+	var parts []string
+	for i, sz := range t.sizes {
+		if sz >= 0 {
+			parts = append(parts, fmt.Sprintf("%s:%d", fileNames[i], sz))
+		}
+	}
+	for i, sub := range t.subs {
+		if sub.present {
+			name := dirNames[i]
+			if t.locked == i {
+				name += "(unreadable)"
+			}
+			parts = append(parts, name+sub.String())
+		}
+	}
+	if t.lnF {
+		parts = append(parts, "ln-f")
+	}
+	if t.lnD {
+		parts = append(parts, "ln-d")
+	}
+	if t.lnX {
+		parts = append(parts, "ln-x")
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+// hasLocked reports an unreadable directory anywhere in the tree.
+func (t fpTree) hasLocked() bool {
+	if t.locked >= 0 {
+		return true
+	}
+	for _, sub := range t.subs {
+		if sub.present && sub.hasLocked() {
+			return true
+		}
+	}
+	return false
+}
+
+// build makes the tree under dir; an unreadable subdirectory has its mode
+// restored by cleanup so that the temporary directory can be removed.
+func (t fpTree) build(dir string, cleanup func(func())) {
+	for i, sz := range t.sizes {
+		if sz >= 0 {
+			os.WriteFile(filepath.Join(dir, fileNames[i]), []byte(strings.Repeat("x", sz)), 0o644)
+		}
+	}
+	for i, sub := range t.subs {
+		if sub.present {
+			p := filepath.Join(dir, dirNames[i])
+			os.Mkdir(p, 0o755)
+			sub.build(p, cleanup)
+		}
+	}
+	if t.lnF {
+		os.Symlink(filepath.Join(dir, "a.go"), filepath.Join(dir, "ln-f"))
+	}
+	if t.lnD {
+		os.Symlink(filepath.Join(dir, "d1"), filepath.Join(dir, "ln-d"))
+	}
+	if t.lnX {
+		os.Symlink(filepath.Join(dir, "nowhere"), filepath.Join(dir, "ln-x"))
+	}
+	if t.locked >= 0 {
+		p := filepath.Join(dir, dirNames[t.locked])
+		os.Chmod(p, 0)
+		cleanup(func() { os.Chmod(p, 0o755) })
+	}
+}
+
+var (
+	// fileSizes: a file absent (first) or, 45 percent of the time, of 0 to
+	// 3000 bytes.
+	fileSizes = zootest.Weighted(zootest.W(55, hegel.Just(-1)), zootest.W(45, zootest.Ints(0, 3000)))
+	// lockeds: no unreadable subdirectory, or one of the three one time in
+	// forty (never under HEGEL_NO_KNOWN=1; bubbles/69). The subdirectory is
+	// made present.
+	lockeds = zootest.Weighted(zootest.W(39, hegel.Just(-1)), zootest.W(zootest.Unless(zootest.NoKnown, 1), zootest.Ints(0, 2)))
+	// fpTrees: a directory tree three levels deep.
+	fpTrees = treeOf(0)
+)
+
+// treeOf is a directory at depth (subdirectories below depth 2): the eight
+// files at the fileSizes' rate, the three subdirectories half the time each,
+// the symlinks one time in four, four and seven, an unreadable subdirectory
+// at the lockeds' rate.
+func treeOf(depth int) hegel.Generator[fpTree] {
+	sizes := zootest.Tuple(fileSizes, fileSizes, fileSizes, fileSizes, fileSizes, fileSizes, fileSizes, fileSizes)
+	subs := hegel.Just([]fpTree(nil))
+	locks := hegel.Just(-1)
+	if depth < 2 {
+		sub := zootest.Maybe(50, treeOf(depth+1))
+		subs = zootest.Tuple(sub, sub, sub)
+		locks = lockeds
+	}
+	return hegel.Composite(func(tc hegel.TestCase) fpTree {
+		t := fpTree{present: true, sizes: hegel.Draw(tc, sizes), subs: hegel.Draw(tc, subs), locked: -1}
+		t.lnF = hegel.Draw(tc, zootest.Coin(25))
+		t.lnD = hegel.Draw(tc, zootest.Coin(25))
+		t.lnX = hegel.Draw(tc, zootest.Coin(15))
+		if k := hegel.Draw(tc, locks); k >= 0 {
+			t.locked = k
+			if !t.subs[k].present {
+				t.subs[k] = emptyTree()
+			}
+		}
+		return t
+	})
+}
+
+// fpStart is the start of a case: the tree and the picker's settings; a
+// height of -1 is none (SetHeight never called); rel leaves CurrentDirectory
+// at New's "." with the working directory at the tree's root (the narrow
+// property of bubbles/70 alone).
+type fpStart struct {
+	tree                                          fpTree
+	hidden, auto, noPerms, noSizes, fileOK, dirOK bool
+	types                                         []string
+	height                                        int
+	rel                                           bool
+}
+
+func (s fpStart) String() string {
+	flags := ""
+	if s.hidden {
+		flags += " hidden"
+	}
+	if s.auto {
+		flags += " autoheight"
+	}
+	if s.noPerms {
+		flags += " noperms"
+	}
+	if s.noSizes {
+		flags += " nosizes"
+	}
+	if s.fileOK {
+		flags += " files"
+	}
+	if s.dirOK {
+		flags += " dirs"
+	}
+	if s.types != nil {
+		flags += fmt.Sprintf(" types%v", s.types)
+	}
+	if s.rel {
+		flags += " from-dot"
+	}
+	return fmt.Sprintf("tree %s height %d%s", s.tree, s.height, flags)
+}
+
+// build makes the picker of the start over root, its listing read.
+func (s fpStart) build(root string) Model {
+	m := New()
+	if !s.rel {
+		m.CurrentDirectory = root
+	}
+	m.ShowHidden = s.hidden
+	m.AutoHeight = s.auto
+	m.ShowPermissions = !s.noPerms
+	m.ShowSize = !s.noSizes
+	m.FileAllowed = s.fileOK
+	m.DirAllowed = s.dirOK
+	m.AllowedTypes = s.types
+	if s.height >= 0 {
+		m.SetHeight(s.height)
+	}
+	m, _ = m.Update(m.Init()())
+	return m
+}
+
+var typeTables = [][]string{{".go"}, {".txt", ".md"}, {".go", ".txt"}, {"e"}}
+
+var (
+	// fileOKs: FileAllowed (the default, first) four times in five.
+	fileOKs = zootest.Weighted(zootest.W(4, hegel.Just(true)), zootest.W(1, hegel.Just(false)))
+	// dirOKs: DirAllowed two times in five.
+	dirOKs = zootest.Coin(40)
+	// allowedTypes: none, or one of four tables two times in five.
+	allowedTypes = zootest.Maybe(40, zootest.Sampled(typeTables...))
+	// startHeights: none (New's, first) three times in ten, else 1 to 6.
+	startHeights = zootest.Weighted(zootest.W(3, hegel.Just(-1)), zootest.W(7, zootest.Ints(1, 6)))
+)
+
+// startsOf is a start from its parts; ShowHidden three times in ten,
+// AutoHeight seven, the permission and size columns off three times in ten
+// each.
+func startsOf(trees hegel.Generator[fpTree], heights hegel.Generator[int], fileOKs, dirOKs hegel.Generator[bool], types hegel.Generator[[]string]) hegel.Generator[fpStart] {
+	return hegel.Composite(func(tc hegel.TestCase) fpStart {
+		return fpStart{
+			tree:    hegel.Draw(tc, trees),
+			hidden:  hegel.Draw(tc, zootest.Coin(30)),
+			auto:    hegel.Draw(tc, zootest.Coin(70)),
+			noPerms: hegel.Draw(tc, zootest.Coin(30)),
+			noSizes: hegel.Draw(tc, zootest.Coin(30)),
+			fileOK:  hegel.Draw(tc, fileOKs),
+			dirOK:   hegel.Draw(tc, dirOKs),
+			types:   hegel.Draw(tc, types),
+			height:  hegel.Draw(tc, heights),
+		}
+	})
+}
+
+var fpStarts = startsOf(fpTrees, startHeights, fileOKs, dirOKs, allowedTypes)
+
+// fpOp is one operation: a binding by one of its keys, a WindowSizeMsg of n
+// rows, SetHeight(n), a ShowHidden toggle, new allowed types or flags.
+type fpOp struct {
+	kind          string
+	key           string
+	n             int
+	types         []string
+	fileOK, dirOK bool
+}
+
+func (op fpOp) GoString() string {
+	switch op.kind {
+	case "size", "setheight":
+		return fmt.Sprintf("%s(%d)", op.kind, op.n)
+	case "allowed":
+		return fmt.Sprintf("allowed(%v)", op.types)
+	case "flags":
+		return fmt.Sprintf("flags(%v,%v)", op.fileOK, op.dirOK)
+	case "togglehidden":
+		return op.kind
+	}
+	if op.key != op.kind {
+		return fmt.Sprintf("%s(%s)", op.kind, op.key)
+	}
+	return op.kind
+}
+
+func opOf(kind, key string) fpOp { return fpOp{kind: kind, key: key} }
+
+// keyed is the binding kind pressed by one of its keys.
+func keyed(kind string, keys ...string) hegel.Generator[fpOp] {
+	if len(keys) == 1 {
+		return hegel.Just(opOf(kind, keys[0]))
+	}
+	return hegel.Map(zootest.Sampled(keys...), func(k string) fpOp { return opOf(kind, k) })
+}
+
+func nOp(kind string, ns hegel.Generator[int]) hegel.Generator[fpOp] {
+	return hegel.Map(ns, func(n int) fpOp { return fpOp{kind: kind, n: n} })
+}
+
+var (
+	topOps    = keyed("g", "g")
+	lastOps   = keyed("G", "G")
+	downOps   = keyed("down", "j", "down", "ctrl+n")
+	upOps     = keyed("up", "k", "up", "ctrl+p")
+	pgdownOps = keyed("pgdown", "J", "pgdown")
+	pgupOps   = keyed("pgup", "K", "pgup")
+	backOps   = keyed("back", "h", "backspace", "left", "esc")
+	openOps   = keyed("open", "l", "right")
+	enterOps  = keyed("enter", "enter")
+	// sizeOps: a WindowSizeMsg of 1 to 12 rows (a height of -4 to 7 under
+	// AutoHeight: a negative one is bubbles/74's).
+	sizeOps = nOp("size", zootest.Ints(1, 12))
+	// setHeightOps: SetHeight(0 to 8).
+	setHeightOps = nOp("setheight", zootest.Ints(0, 8))
+	toggleOps    = hegel.Just(fpOp{kind: "togglehidden"})
+	allowedOps   = hegel.Map(zootest.Sampled(nil, []string{".go"}, []string{".txt", ".md"}, []string{"e"}), func(ts []string) fpOp { return fpOp{kind: "allowed", types: ts} })
+	flagsOps     = hegel.Composite(func(tc hegel.TestCase) fpOp {
+		return fpOp{kind: "flags", fileOK: hegel.Draw(tc, fileOKs), dirOK: hegel.Draw(tc, dirOKs)}
+	})
+
+	// fpOps: an operation at the old shares (down, up and enter twice, the
+	// rest once).
+	fpOps = zootest.Weighted(
+		zootest.W(1, topOps),
+		zootest.W(2, downOps),
+		zootest.W(2, upOps),
+		zootest.W(1, lastOps),
+		zootest.W(1, pgdownOps),
+		zootest.W(1, pgupOps),
+		zootest.W(1, backOps),
+		zootest.W(1, openOps),
+		zootest.W(2, enterOps),
+		zootest.W(1, sizeOps),
+		zootest.W(1, setHeightOps),
+		zootest.W(1, toggleOps),
+		zootest.W(1, allowedOps),
+		zootest.W(1, flagsOps),
+	)
+)
+
+// fpCase is a start and the operations applied to it.
+type fpCase struct {
+	start fpStart
+	ops   []fpOp
+}
+
+func (c fpCase) GoString() string {
+	parts := make([]string, len(c.ops))
+	for i, op := range c.ops {
+		parts[i] = op.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(parts, ", ")
+}
+
+func casesOf(starts hegel.Generator[fpStart], ops hegel.Generator[[]fpOp]) hegel.Generator[fpCase] {
+	return hegel.Composite(func(tc hegel.TestCase) fpCase {
+		return fpCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// fpCases: a start and one to twenty-five operations.
+var fpCases = casesOf(fpStarts, zootest.Counted(fpOps, 1, 25))
+
+// ---------------------------------------------------------------- model
+
+// listing is a directory as read once per case (the tree does not change
+// under the picker; the model reads each directory once).
+type listing struct {
+	files []fent
+	err   error
+}
+
+// saved is a view pushed on Open: the selection and window, the listing's
+// length and the height at the time.
+type saved struct{ sel, mn, mx, n, h int }
+
+// fpModel is the model: the directory the case must not leave (top), the
+// current directory, the settings, the listing, the selection, the window,
+// the height, the view stack and the selected path.
+type fpModel struct {
+	top, cwd                    string
+	hidden, auto, fileOK, dirOK bool
+	types                       []string
+	files                       []fent
+	sel, mn, mx, h              int
+	stack                       []saved
+	path                        string
+	cache                       map[string]listing
+}
+
+func newFpModel(s fpStart, top, root string) *fpModel {
+	m := &fpModel{top: top, cwd: root, hidden: s.hidden, auto: s.auto, fileOK: s.fileOK, dirOK: s.dirOK, types: s.types, cache: map[string]listing{}}
+	if s.rel {
+		m.cwd = "."
+	}
+	if s.height >= 0 {
+		m.setHeight(s.height)
+	}
+	m.read()
+	return m
+}
+
+func (s *fpModel) clone() *fpModel {
+	d := *s
+	d.stack = append([]saved{}, s.stack...)
+	return &d
+}
+
+// win is the rows the window holds: the height, or one without a height.
+func (s *fpModel) win() int { return max(s.h, 1) }
+
+// bottom is bottomIdx: the last index of a window starting at top.
+func (s *fpModel) bottom(top int) int {
+	if s.h < 1 {
+		return top
+	}
+	return top + s.h - 1
+}
+
+func (s *fpModel) list(dir string) listing {
+	key := dir + "\x00" + strconv.FormatBool(s.hidden)
+	l, ok := s.cache[key]
+	if !ok {
+		l.files, l.err = readEntries(dir, s.hidden)
+		s.cache[key] = l
+	}
+	return l
+}
+
+// read is the readDirMsg handler: the listing, and the window widened to the
+// height (an unreadable directory leaves the listing as it was).
+func (s *fpModel) read() {
+	l := s.list(s.cwd)
+	if l.err != nil {
+		return
+	}
+	s.files = l.files
+	s.mx = max(s.mx, s.bottom(s.mn))
+}
+
+// setHeight is SetHeight: the window's bottom recomputed when it is past the
+// new height (an index compared with a count, bubbles/67).
+func (s *fpModel) setHeight(h int) {
+	s.h = h
+	if s.mx > s.h-1 {
+		s.mx = s.bottom(s.mn)
+	}
+}
+
+// norm states the true window from the library's: the selection inside the
+// listing, no more than Height rows (cut from the top, as the library's
+// resizes cut), the selection inside the window (the window moved the least
+// to hold it), and the window filled with entries where the listing has
+// enough. An empty listing has nothing to state (the library's -1 there is
+// "nothing selected", a fact of the model).
+func (s *fpModel) norm() {
+	n := len(s.files)
+	if n == 0 {
+		return
+	}
+	win := s.win()
+	s.sel = min(max(s.sel, 0), n-1)
+	if s.mx-s.mn+1 > win {
+		s.mx = s.mn + win - 1
+	}
+	if s.sel < s.mn {
+		s.mn = s.sel
+		s.mx = s.mn + win - 1
+	}
+	if s.sel > s.mx {
+		s.mx = s.sel
+		s.mn = max(s.mx-win+1, 0)
+	}
+	if min(s.mx, n-1)-s.mn+1 < min(win, n) {
+		s.mn = max(min(s.mn, n-win), 0)
+		s.mx = s.mn + win - 1
+	}
+}
+
+// eligible reports the entry selectable per the allowed flags: a file with
+// FileAllowed, a directory (or a symlink to one) with DirAllowed; a broken
+// symlink never.
+func (s *fpModel) eligible(f fent) bool {
+	if f.link && f.target == "" {
+		return false
+	}
+	isDir := f.dir || f.linkDir
+	return (!isDir && s.fileOK) || (isDir && s.dirOK)
+}
+
+// canSelect is the AllowedTypes rule: none, or a suffix of the path.
+func (s *fpModel) canSelect(path string) bool {
+	if len(s.types) == 0 {
+		return true
+	}
+	for _, ext := range s.types {
+		if strings.HasSuffix(path, ext) {
+			return true
+		}
+	}
+	return false
+}
+
+// pressed is the eligibility of the entry under the selection: what an enter
+// reports (the true report, taken before the step).
+func (s *fpModel) pressed() bool {
+	n := len(s.files)
+	if n == 0 || s.sel < 0 || s.sel >= n {
+		return false
+	}
+	return s.eligible(s.files[s.sel])
+}
+
+// libReport is the eligibility didSelectFile derives after the step: the
+// entry under the selection of the listing it then has, and a Path.
+func (s *fpModel) libReport() bool {
+	return s.pressed() && s.path != ""
+}
+
+// noop reports an operation that does not fit the state: Back at the top of
+// the case's directory (not sent to the library).
+func (s *fpModel) noop(op fpOp) bool {
+	return op.kind == "back" && s.cwd == s.top
+}
+
+// step applies op with the library's arithmetic (fix false: the mirror the
+// classifier compares against) or the true one (fix true, normalised).
+func (s *fpModel) step(op fpOp, fix bool) {
+	n := len(s.files)
+	switch op.kind {
+	case "g":
+		s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+	case "G":
+		s.sel, s.mx = n-1, n-1
+		if fix {
+			s.mn = max(n-s.win(), 0) // the last entry shown, with or without a height
+		} else {
+			s.mn = max(n-s.h, 0) // len(files) without a height: an empty window (bubbles/66)
+		}
+	case "down":
+		s.sel++
+		if s.sel >= n {
+			s.sel = n - 1
+		}
+		if s.sel > s.mx {
+			s.mn++
+			s.mx++
+		}
+	case "up":
+		s.sel--
+		if s.sel < 0 {
+			s.sel = 0
+		}
+		if s.sel < s.mn {
+			s.mn--
+			s.mx--
+		}
+	case "pgdown":
+		h := s.h
+		if fix {
+			h = max(h, 0) // a negative height is no height (bubbles/74)
+		}
+		s.sel += h
+		if s.sel >= n {
+			s.sel = n - 1
+		}
+		s.mn += h
+		s.mx += h
+		if s.mx >= n {
+			s.mx = n - 1
+			if fix {
+				s.mn = max(s.mx-s.win()+1, 0) // a window of Height entries
+			} else {
+				s.mn = max(s.mx-h, 0) // Height+1 entries (bubbles/64)
+			}
+		}
+	case "pgup":
+		h := s.h
+		if fix {
+			h = max(h, 0)
+		}
+		s.sel -= h
+		if s.sel < 0 {
+			s.sel = 0
+		}
+		s.mn -= h
+		s.mx -= h
+		if s.mn < 0 {
+			s.mn = 0
+			if fix {
+				s.mx = s.bottom(0)
+			} else {
+				s.mx = h // Height+1 entries (bubbles/64)
+			}
+		}
+	case "back":
+		s.back(fix)
+	case "open", "enter":
+		s.open(op.kind == "enter", fix)
+	case "size":
+		if s.auto {
+			s.setHeight(op.n - marginBottom)
+		}
+		s.mx = s.bottom(s.mn)
+	case "setheight":
+		s.setHeight(op.n)
+	case "togglehidden":
+		s.hidden = !s.hidden
+	case "allowed":
+		s.types = op.types
+	case "flags":
+		s.fileOK, s.dirOK = op.fileOK, op.dirOK
+	}
+	if fix {
+		s.norm()
+	}
+}
+
+// back is the Back binding: the parent directory (of the working directory's
+// absolute path from ".", bubbles/70; the library takes Dir(".") = "."), the
+// parent's view popped or a fresh one, the parent re-read (the selection
+// clamped and the window fitted by norm; the library restores them verbatim,
+// bubbles/68 and 73).
+func (s *fpModel) back(fix bool) {
+	dir := s.cwd
+	if fix {
+		if abs, err := filepath.Abs(dir); err == nil {
+			dir = abs
+		}
+	}
+	s.cwd = filepath.Dir(dir)
+	if k := len(s.stack); k > 0 {
+		v := s.stack[k-1]
+		s.stack = s.stack[:k-1]
+		s.sel, s.mn, s.mx = v.sel, v.mn, v.mx
+	} else {
+		s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+	}
+	s.read()
+}
+
+// open is the Open binding (and enter, which also selects): nothing on an
+// empty listing or a broken symlink; an eligible entry becomes Path on enter;
+// a directory (or a symlink to one) is entered with the view pushed, unless
+// it cannot be read (the true picker stays put; the library enters it and
+// keeps the old listing, bubbles/69).
+func (s *fpModel) open(enter, fix bool) {
+	n := len(s.files)
+	if n == 0 || s.sel < 0 || s.sel >= n {
+		return
+	}
+	f := s.files[s.sel]
+	if f.link && f.target == "" {
+		return
+	}
+	if enter && s.eligible(f) {
+		s.path = filepath.Join(s.cwd, f.name)
+	}
+	if !(f.dir || f.linkDir) {
+		return
+	}
+	next := filepath.Join(s.cwd, f.name)
+	if fix && s.list(next).err != nil {
+		return
+	}
+	s.stack = append(s.stack, saved{s.sel, s.mn, s.mx, n, s.h})
+	s.cwd = next
+	s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+	s.read()
+}
+
+// same reports two model states the library would show alike.
+func same(a, b *fpModel) bool {
+	return a.cwd == b.cwd && a.sel == b.sel && a.mn == b.mn && a.mx == b.mx && a.h == b.h &&
+		len(a.files) == len(b.files) && len(a.stack) == len(b.stack) && a.path == b.path
+}
+
+// ---------------------------------------------------------------- shapes
+
+// stepShape names the recorded bug whose shape the operation has from the
+// model's state, before it is taken: the operation is replayed on two clones,
+// with the library's arithmetic and with the true one, and a difference is
+// named by the operation: Open with a selection the listing no longer has
+// (bubbles/68); Open or enter entering an unreadable directory (69); enter
+// on a directory whose report the library takes from the entered listing
+// (72); a page key at a negative height (74) or clamping at an end (64); a
+// resize hiding the selection (65) or leaving rows blank over hidden entries
+// (67); G without a height (66); Back from "." (70), onto a listing of
+// another length (68) or at another height (73).
+func stepShape(s *fpModel, op fpOp) string {
+	if s.noop(op) {
+		return ""
+	}
+	n := len(s.files)
+	if (op.kind == "open" || op.kind == "enter") && n > 0 && (s.sel < 0 || s.sel >= n) {
+		return "bubbles/68"
+	}
+	lib, truth := s.clone(), s.clone()
+	lib.step(op, false)
+	truth.step(op, true)
+	if op.kind == "open" || op.kind == "enter" {
+		if lib.cwd != truth.cwd {
+			return "bubbles/69"
+		}
+		if op.kind == "enter" && lib.cwd != s.cwd && lib.libReport() != s.pressed() {
+			return "bubbles/72"
+		}
+	}
+	if same(lib, truth) {
+		return ""
+	}
+	switch op.kind {
+	case "pgdown", "pgup":
+		if s.h < 0 {
+			return "bubbles/74"
+		}
+		return "bubbles/64"
+	case "size", "setheight":
+		if lib.sel < lib.mn || lib.sel > lib.mx {
+			return "bubbles/65"
+		}
+		return "bubbles/67"
+	case "G":
+		if s.h < 1 {
+			return "bubbles/66"
+		}
+	case "back":
+		if lib.cwd != truth.cwd {
+			return "bubbles/70"
+		}
+		if k := len(s.stack); k > 0 {
+			switch v := s.stack[k-1]; {
+			case v.n != len(truth.files):
+				return "bubbles/68"
+			case v.h != s.h:
+				return "bubbles/73"
+			}
+		}
+	}
+	return ""
+}
+
+// unshaped drops, under HEGEL_NO_KNOWN=1, the operations the classifier
+// names a shape for, replaying the model over the kept ones (the model reads
+// the tree, so the replay is done in the property, not in a generator).
+func (s *fpModel) unshaped(ops []fpOp) []fpOp {
+	var kept []fpOp
+	for _, op := range ops {
+		if s.noop(op) || stepShape(s, op) != "" {
+			continue
+		}
+		s.step(op, true)
+		kept = append(kept, op)
+	}
+	return kept
+}
+
+// ---------------------------------------------------------------- judge
+
+var (
+	lockedOnce sync.Once
+	lockedOK   bool
+)
+
+// lockedReadable reports a process that reads a directory of mode 0o000
+// anyway (root): the shape of bubbles/69 then does not exist.
+func lockedReadable() bool {
+	lockedOnce.Do(func() {
+		d, err := os.MkdirTemp("", "zoo-fp-probe")
+		if err != nil {
+			return
+		}
+		defer os.RemoveAll(d)
+		p := filepath.Join(d, "locked")
+		os.Mkdir(p, 0o755)
+		os.Chmod(p, 0)
+		_, err = os.ReadDir(p)
+		lockedOK = err == nil
+		os.Chmod(p, 0o755)
+	})
+	return lockedOK
+}
+
+// applyLib applies op to the picker, running the command a key returns; the
+// message sent is returned (the DidSelect reports take it).
+func applyLib(m *Model, op fpOp) tea.Msg {
+	var msg tea.Msg
+	switch op.kind {
+	case "size":
+		msg = tea.WindowSizeMsg{Width: 80, Height: op.n}
+	case "setheight":
+		m.SetHeight(op.n)
+		return nil
+	case "togglehidden":
+		m.ShowHidden = !m.ShowHidden
+		return nil
+	case "allowed":
+		m.AllowedTypes = op.types
+		return nil
+	case "flags":
+		m.FileAllowed, m.DirAllowed = op.fileOK, op.dirOK
+		return nil
+	default:
+		msg = keyMsg(op.key)
+	}
+	var cmd tea.Cmd
+	*m, cmd = m.Update(msg)
+	if cmd != nil {
+		*m, _ = m.Update(cmd())
+	}
+	return msg
+}
+
+// fpRun is one case under judgement: the judge, the picker, the model, the
+// first view whose line count was wrong (the trailing newline, bubbles/71,
+// failed at the end of the case so that a later step's own shape fails
+// first) and whether that check was counted as known this case.
+type fpRun struct {
+	j       *zootest.Judge
+	m       Model
+	s       *fpModel
+	bad71   string
+	known71 bool
+}
+
+// judgeFilepicker builds the picker of the start over root (top is the
+// directory the case must not leave), applies the operations and checks the
+// picker against the model after the start and after every operation; the
+// wide and the narrow properties share it. With drop the operations with a
+// shape are dropped first (the wide property under HEGEL_NO_KNOWN=1).
+func judgeFilepicker(j *zootest.Judge, c fpCase, top, root string, drop bool) {
+	r := &fpRun{j: j, s: newFpModel(c.start, top, root)}
+	ops := c.ops
+	if drop {
+		ops = r.s.clone().unshaped(ops)
+	}
+	r.m = c.start.build(root)
+	r.check("at the start", nil, false)
+	for _, op := range ops {
+		if r.s.noop(op) {
+			continue
+		}
+		j.Shape(stepShape(r.s, op))
+		want := r.s.pressed()
+		msg := applyLib(&r.m, op)
+		if op.kind != "enter" {
+			msg = nil // the DidSelect reports are checked on an enter
+		}
+		r.s.step(op, true)
+		j.Note("%s -> %s sel %d win [%d,%d] h %d of %d entries", op.GoString(), r.s.where(), r.s.sel, r.s.mn, r.s.mx, r.s.h, len(r.s.files))
+		r.check("after "+op.GoString(), msg, want)
+	}
+	if r.bad71 != "" {
+		j.Shape("bubbles/71")
+		j.Fail("%s", r.bad71)
+	}
+}
+
+// where is the current directory relative to the case's top.
+func (s *fpModel) where() string {
+	if rel, err := filepath.Rel(s.top, s.cwd); err == nil && filepath.IsAbs(s.cwd) {
+		return rel
+	}
+	return s.cwd
+}
+
+// check compares the picker with the model: after an enter the DidSelect
+// reports (the pressed entry's eligibility, split by AllowedTypes), then
+// CurrentDirectory and Path, the listing's length, the selection and window
+// indices and the height (the model's hold the window's invariants: the
+// selection inside, no more rows than the height, no fewer than the entries
+// allow), HighlightedPath and the view.
+func (r *fpRun) check(what string, enter tea.Msg, want bool) {
+	j, m, s := r.j, &r.m, r.s
+	if enter != nil {
+		got, gotPath := m.DidSelectFile(enter)
+		gotD, gotPathD := m.DidSelectDisabledFile(enter)
+		ok := s.canSelect(s.path)
+		if got != (want && ok) || gotD != (want && !ok) || (got && gotPath != s.path) || (gotD && gotPathD != s.path) {
+			j.Fail("%s: DidSelectFile %v %q, DidSelectDisabledFile %v %q; want %v / %v with path %q (Path %q)", what, got, gotPath, gotD, gotPathD, want && ok, want && !ok, s.path, m.Path)
+		}
+	}
+	if m.CurrentDirectory != s.cwd || m.Path != s.path {
+		j.Fail("%s: CurrentDirectory %q, Path %q; want %q, %q", what, m.CurrentDirectory, m.Path, s.cwd, s.path)
+	}
+	if len(m.files) != len(s.files) || m.selected != s.sel || m.minIdx != s.mn || m.maxIdx != s.mx || m.height != s.h {
+		j.Fail("%s: files %d sel %d win [%d,%d] h %d; want files %d sel %d win [%d,%d] h %d", what, len(m.files), m.selected, m.minIdx, m.maxIdx, m.height, len(s.files), s.sel, s.mn, s.mx, s.h)
+	}
+	n := len(s.files)
+	wantHP := ""
+	if n > 0 && s.sel >= 0 && s.sel < n {
+		wantHP = filepath.Join(s.cwd, s.files[s.sel].name)
+	}
+	if hp := m.HighlightedPath(); hp != wantHP {
+		j.Fail("%s: HighlightedPath %q, want %q", what, hp, wantHP)
+	}
+	view := ansi.Strip(m.View())
+	if n == 0 {
+		lines := strings.Split(view, "\n")
+		if !strings.HasPrefix(lines[0], "  Bummer. No Files Found.") || len(lines) != max(s.h, 1) {
+			j.Fail("%s: empty view %q for height %d", what, view, s.h)
+		}
+		return
+	}
+	var rows []string
+	for i := max(s.mn, 0); i <= s.mx && i < n; i++ {
+		rows = append(rows, s.files[i].row(i == s.sel, m.Cursor, m.ShowPermissions, m.ShowSize))
+	}
+	// The view has max(rows, Height) lines; the library's ends in a newline
+	// after them (bubbles/71), the shape of every non-empty view: by default
+	// the count is checked and the first wrong one fails at the end of the
+	// case naming it (a step's own shape fails first); under HEGEL_NO_KNOWN=1
+	// that check is dropped (counted as known once per case) and the lines
+	// are compared with the trailing newline stripped.
+	count := max(len(rows), s.h)
+	if zootest.NoKnown {
+		if !r.known71 {
+			r.known71 = true
+			zootest.Count("known bubbles/71")
+		}
+		view = strings.TrimSuffix(view, "\n")
+	} else if lines := strings.Split(view, "\n"); len(lines) != count && r.bad71 == "" {
+		r.bad71 = fmt.Sprintf("%s: view has %d lines for %d rows and height %d, want %d:\n%s", what, len(lines), len(rows), s.h, count, view)
+	}
+	lines := strings.Split(view, "\n")
+	for i := 0; i < max(len(lines), count); i++ {
+		got, want := "", ""
+		if i < len(lines) {
+			got = lines[i]
+		}
+		if i < len(rows) {
+			want = rows[i]
+		}
+		if strings.TrimRight(got, " ") != strings.TrimRight(want, " ") {
+			j.Fail("%s: view line %d %q, want %q\n%s", what, i, got, want, view)
+		}
+	}
+}
+
+// runPicker runs one drawn case: the tree built under a fresh temporary
+// directory (the working directory moved to it for a start from "."), the
+// case assumed away when its unreadable directory is readable to this
+// process, then the judge.
+func runPicker(t *testing.T, ht *hegel.T, c fpCase, drop bool) {
+	if c.start.tree.hasLocked() && lockedReadable() {
+		ht.Assume(false)
+	}
+	top := t.TempDir()
+	root := filepath.Join(top, "root")
+	if c.start.rel {
+		root = filepath.Join(top, "scratch", "cwd")
+		os.MkdirAll(root, 0o755)
+		t.Chdir(root)
+	} else {
+		os.Mkdir(root, 0o755)
+	}
+	c.start.tree.build(root, t.Cleanup)
+	j := zootest.NewJudge(ht)
+	defer j.Recover()
+	judgeFilepicker(j, c, top, root, drop)
+}
+
+// TestHegelFilepickerFollowsTheModel: the listing is the directory's entries,
+// directories first, hidden names per ShowHidden; every binding, the window
+// messages and SetHeight move the selection and the window as the model
+// defines them and the window keeps the selection visible with Height rows;
+// View shows exactly the window's rows with the cursor on the selection;
+// HighlightedPath, CurrentDirectory, Path and the DidSelect reports follow.
+func TestHegelFilepickerFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, fpCases)
+		runPicker(t, ht, c, zootest.NoKnown)
+	})
+}
+
+// pinDir builds a directory of n files f00.txt… and the directories given,
+// returning its path.
+func pinDir(t *testing.T, n int, dirs ...string) string {
+	t.Helper()
+	root := t.TempDir()
+	for i := 0; i < n; i++ {
+		if err := os.WriteFile(filepath.Join(root, fmt.Sprintf("f%02d.txt", i)), []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, d := range dirs {
+		if err := os.Mkdir(filepath.Join(root, d), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return root
+}
+
+// pinPicker returns a picker over dir with the height set (0: never set),
+// its listing read.
+func pinPicker(dir string, h int) Model {
+	m := New()
+	m.CurrentDirectory = dir
+	if h > 0 {
+		m.SetHeight(h)
+	}
+	m, _ = m.Update(m.Init()())
+	return m
+}
+
+func pinStep(m Model, msg tea.Msg) Model {
+	m, cmd := m.Update(msg)
+	if cmd != nil {
+		m, _ = m.Update(cmd())
+	}
+	return m
+}
+
+func pinRows(m Model) int {
+	n := 0
+	for _, l := range strings.Split(ansi.Strip(m.View()), "\n") {
+		if strings.TrimSpace(l) != "" {
+			n++
+		}
+	}
+	return n
+}
+
+// bubbles/64: when PageDown or PageUp clamps at an end of the listing the
+// window is set to Height+1 entries (maxIdx − Height … maxIdx), so the view
+// shows one row more than the height.
+func TestHegelPinFilepickerPageKeysShowOneRowTooMany(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 3)
+	for range 3 {
+		m = pinStep(m, keyMsg("pgdown"))
+	}
+	if rows := pinRows(m); rows > 3 {
+		t.Fatalf("after three PageDowns in ten entries with height 3: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/65: a smaller height (WindowSizeMsg or SetHeight) cuts the window
+// from its top, so a selection near the bottom falls out of view and no
+// cursor is drawn.
+func TestHegelPinFilepickerShrinkHidesTheSelection(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 4)
+	m = pinStep(m, keyMsg("G"))
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 7}) // height 2
+	if m.selected < m.minIdx || m.selected > m.maxIdx || !strings.Contains(ansi.Strip(m.View()), "> ") {
+		t.Fatalf("after G and a resize to height 2: selected %d, window [%d,%d]:\n%s", m.selected, m.minIdx, m.maxIdx, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/66: without a height (no WindowSizeMsg yet, SetHeight never
+// called) G sets minIdx to len(files) and maxIdx to len(files)−1, so the
+// view is empty and stays so through Up moves.
+func TestHegelPinFilepickerGoToLastWithoutHeightEmptiesTheView(t *testing.T) {
+	m := pinPicker(pinDir(t, 5), 0)
+	m = pinStep(m, keyMsg("G"))
+	m = pinStep(m, keyMsg("k"))
+	if v := ansi.Strip(m.View()); strings.TrimSpace(v) == "" {
+		t.Fatalf("G then k without a height: selected %d, window [%d,%d], view %q", m.selected, m.minIdx, m.maxIdx, v)
+	}
+}
+
+// bubbles/67: a larger height does not fill the window: SetHeight keeps
+// the old bottom when minIdx is 0 (maxIdx is compared with height−1 as if
+// it were a count), and a WindowSizeMsg keeps the old top, so rows stay
+// blank while entries are hidden.
+func TestHegelPinFilepickerSetHeightDoesNotFillTheWindow(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 2)
+	m.AutoHeight = false
+	m.SetHeight(6)
+	if rows := pinRows(m); rows < 6 {
+		t.Fatalf("SetHeight(6) over ten entries: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/68: readDirMsg never clamps the selection to the new listing, so
+// after ShowHidden is turned off inside a directory, Back restores a
+// selection past the end of the parent: HighlightedPath is empty, no cursor
+// is drawn and Open panics (a Down in an empty directory leaves −1 the same way).
+func TestHegelPinFilepickerStaleSelectionPanicsOnOpen(t *testing.T) {
+	root := pinDir(t, 0, ".a", ".b", "c")
+	m := New()
+	m.CurrentDirectory = root
+	m.ShowHidden = true
+	m.SetHeight(5)
+	m, _ = m.Update(m.Init()())
+	m = pinStep(m, keyMsg("G")) // c
+	m = pinStep(m, keyMsg("l"))
+	m.ShowHidden = false
+	m = pinStep(m, keyMsg("h"))
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Back into the parent with hidden entries turned off: selected %d of %d, HighlightedPath %q; Open panics: %v", m.selected, len(m.files), m.HighlightedPath(), r)
+		}
+	}()
+	m = pinStep(m, keyMsg("enter"))
+	if m.HighlightedPath() == "" {
+		t.Fatalf("Back into the parent with hidden entries turned off: selected %d of %d, HighlightedPath empty", m.selected, len(m.files))
+	}
+}
+
+// bubbles/69: Open changes CurrentDirectory before the directory is read,
+// and a read error is ignored, so an unreadable directory is "entered" with
+// the parent's listing still shown: HighlightedPath joins the new directory
+// with the old entries.
+func TestHegelPinFilepickerEntersAnUnreadableDirectory(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root can read anything")
+	}
+	root := pinDir(t, 2, "locked")
+	if err := os.Chmod(filepath.Join(root, "locked"), 0o000); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chmod(filepath.Join(root, "locked"), 0o755)
+	m := pinPicker(root, 5)
+	m = pinStep(m, keyMsg("l")) // locked sorts first
+	if m.CurrentDirectory != root {
+		t.Fatalf("after Open on an unreadable directory: CurrentDirectory %q, %d entries listed, HighlightedPath %q", m.CurrentDirectory, len(m.files), m.HighlightedPath())
+	}
+}
+
+// bubbles/70: Back computes filepath.Dir(CurrentDirectory), and Dir(".")
+// is ".", so with the default directory the Back key goes nowhere.
+func TestHegelPinFilepickerBackFromDotGoesNowhere(t *testing.T) {
+	m := pinPicker(".", 5)
+	m = pinStep(m, keyMsg("h"))
+	if m.CurrentDirectory == "." {
+		t.Fatalf("Back from %q: CurrentDirectory %q", ".", m.CurrentDirectory)
+	}
+}
+
+// bubbles/71: the view of a non-empty directory ends in a newline after
+// its Height lines, so it is one line taller than the empty directory's
+// view and than Height.
+func TestHegelPinFilepickerViewHasATrailingNewline(t *testing.T) {
+	m := pinPicker(pinDir(t, 2), 3)
+	e := pinPicker(pinDir(t, 0), 3)
+	if h, eh := lipgloss.Height(m.View()), lipgloss.Height(e.View()); h != 3 || eh != 3 {
+		t.Fatalf("height 3: the view of two files is %d lines (%q), of an empty directory %d", h, m.View(), eh)
+	}
+}
+
+// bubbles/72: after enter selects a directory (DirAllowed) the picker has
+// already entered it, so DidSelectFile looks at the new listing's first
+// entry: a directory holding only files is never reported selected when
+// FileAllowed is off, nor is an empty one.
+func TestHegelPinFilepickerDidSelectDirectoryLooksAtTheChild(t *testing.T) {
+	root := pinDir(t, 0, "d")
+	os.WriteFile(filepath.Join(root, "d", "a.go"), []byte("x"), 0o644)
+	m := pinPicker(root, 5)
+	m.DirAllowed, m.FileAllowed = true, false
+	enter := keyMsg("enter")
+	m = pinStep(m, enter)
+	ok, path := m.DidSelectFile(enter)
+	if !ok || path != filepath.Join(root, "d") {
+		t.Fatalf("enter on directory d with DirAllowed: Path %q, DidSelectFile %v %q", m.Path, ok, path)
+	}
+}
+
+// bubbles/73: Back restores the parent's saved selection and window
+// verbatim, so after a resize inside a subdirectory the parent shows the
+// old window: more rows than the height, or fewer.
+func TestHegelPinFilepickerBackRestoresAnUnfittedWindow(t *testing.T) {
+	m := pinPicker(pinDir(t, 10, "sub"), 5)
+	m = pinStep(m, keyMsg("l"))                             // sub sorts first
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 7}) // height 2
+	m = pinStep(m, keyMsg("h"))
+	if rows := pinRows(m); rows > 2 {
+		t.Fatalf("Back after a resize to height 2: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/74: SetHeight accepts a negative height (AutoHeight makes one
+// from a terminal under six rows) and the page keys add it, so PageUp moves
+// the selection and the window down and PageDown up, off the listing.
+func TestHegelPinFilepickerNegativeHeightInvertsThePageKeys(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 0)
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 2}) // height −3
+	m = pinStep(m, keyMsg("pgup"))
+	if m.selected != 0 || m.minIdx != 0 {
+		t.Fatalf("PageUp from the top at height %d: selected %d, window [%d,%d]", m.height, m.selected, m.minIdx, m.maxIdx)
+	}
+}
