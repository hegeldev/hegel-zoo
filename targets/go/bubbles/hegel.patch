diff --git a/internal/zootest/zootest.go b/internal/zootest/zootest.go
new file mode 100644
index 0000000..12a7c99
--- /dev/null
+++ b/internal/zootest/zootest.go
@@ -0,0 +1,242 @@
+// Package zootest is the shared harness of the Hegel zoo's bubbles tests: a
+// property wrapper with a collect mode, small generators, and a parser that
+// turns a rendered view into cells with their reverse-video flag.
+package zootest
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// Collecting is set by BUBBLES_COLLECT=1: mismatches are recorded and the
+// property goes on instead of failing at the first one.
+var Collecting = os.Getenv("BUBBLES_COLLECT") != ""
+
+type collected struct{}
+
+var (
+	mu    sync.Mutex
+	msgs  []string
+	stats = map[string]int{}
+)
+
+// Fail reports a mismatch: fatal normally, recorded in collect mode.
+func Fail(ht *hegel.T, format string, args ...any) {
+	if Collecting {
+		mu.Lock()
+		msgs = append(msgs, fmt.Sprintf(format, args...))
+		mu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// Count bumps a statistic (the shape of a pinned bug, a generator branch).
+func Count(key string) {
+	mu.Lock()
+	stats[key]++
+	mu.Unlock()
+}
+
+// Guard turns a panic in a pin into a test failure with the panic's value.
+func Guard(t *testing.T) {
+	t.Helper()
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func opts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// Property runs fn under Hegel; panics in the code under test become
+// failures (or recorded mismatches in collect mode).
+func Property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if Collecting {
+		mu.Lock()
+		msgs = nil
+		stats = map[string]int{}
+		mu.Unlock()
+		defer func() {
+			mu.Lock()
+			defer mu.Unlock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(msgs), sb.String())
+			for i, m := range msgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if Collecting {
+				mu.Lock()
+				msgs = append(msgs, msg)
+				mu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, opts()...)
+}
+
+// N draws an integer in [lo, hi].
+func N(tc hegel.TestCase, lo, hi int) int {
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+// Pick draws one of xs.
+func Pick[T any](tc hegel.TestCase, xs []T) T {
+	return xs[hegel.Draw(tc, hegel.Integers(0, len(xs)-1))]
+}
+
+// Chance is true pct percent of the time.
+func Chance(tc hegel.TestCase, pct int) bool {
+	return hegel.Draw(tc, hegel.Integers(0, 99)) < pct
+}
+
+// Note logs a line that Hegel shows with a failure.
+func Note(ht *hegel.T, format string, args ...any) {
+	ht.Logf(format, args...)
+}
+
+// Cell is one grapheme of a rendered view with its display width and whether
+// it was drawn in reverse video (how the bubbles' virtual cursor shows).
+type Cell struct {
+	S   string
+	W   int
+	Rev bool
+}
+
+// Cells parses a rendered line: SGR sequences set or clear reverse video,
+// other escape sequences are skipped, text is split into graphemes.
+func Cells(s string) []Cell {
+	var cells []Cell
+	rev := false
+	i := 0
+	for i < len(s) {
+		if s[i] == 0x1b && i+1 < len(s) {
+			switch s[i+1] {
+			case '[':
+				j := i + 2
+				for j < len(s) && !(s[j] >= 0x40 && s[j] <= 0x7e) {
+					j++
+				}
+				if j < len(s) && s[j] == 'm' {
+					params := s[i+2 : j]
+					if params == "" {
+						rev = false
+					}
+					for _, p := range strings.Split(params, ";") {
+						switch p {
+						case "", "0":
+							rev = false
+						case "7":
+							rev = true
+						case "27":
+							rev = false
+						}
+					}
+				}
+				i = j + 1
+				continue
+			case ']':
+				j := i + 2
+				for j < len(s) {
+					if s[j] == 0x07 {
+						j++
+						break
+					}
+					if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+						j += 2
+						break
+					}
+					j++
+				}
+				i = j
+				continue
+			}
+		}
+		j := i
+		for j < len(s) && s[j] != 0x1b {
+			j++
+		}
+		g := uniseg.NewGraphemes(s[i:j])
+		for g.Next() {
+			cells = append(cells, Cell{S: g.Str(), W: g.Width(), Rev: rev})
+		}
+		i = j
+	}
+	return cells
+}
+
+// Plain is the text of the cells.
+func Plain(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		sb.WriteString(c.S)
+	}
+	return sb.String()
+}
+
+// Width is the display width of the cells.
+func Width(cells []Cell) int {
+	w := 0
+	for _, c := range cells {
+		w += c.W
+	}
+	return w
+}
+
+// String renders cells for a failure message: reversed cells in brackets.
+func String(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		if c.Rev {
+			sb.WriteString("[" + c.S + "]")
+		} else {
+			sb.WriteString(c.S)
+		}
+	}
+	return sb.String()
+}
diff --git a/textarea/hegel_test.go b/textarea/hegel_test.go
new file mode 100644
index 0000000..610688c
--- /dev/null
+++ b/textarea/hegel_test.go
@@ -0,0 +1,1296 @@
+package textarea
+
+// Hegel property tests for the textarea bubble: a multi-line editor with
+// soft-wrapped lines, a vertical viewport, line numbers, a character limit,
+// a line limit and keyboard selections.
+//
+// The editing model is a slice of rune lines with a cursor and a selection;
+// every default key binding, pastes and the public setters are driven through
+// Update and Value, Line, Column, LineCount and SelectedText must follow it.
+// Vertical motion is checked against the library's own wrap grid (one visual
+// row per press), the rendered view against the grid (gutter, rows, padding,
+// the reversed cursor cell), the real cursor and PositionAt against the
+// virtual cursor, and LineInfo against the grid.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property = zootest.Property
+	fail     = zootest.Fail
+	count    = zootest.Count
+	guard    = zootest.Guard
+	n        = zootest.N
+	chance   = zootest.Chance
+	note     = zootest.Note
+)
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return zootest.Pick(tc, xs) }
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kEnter       = keyOf(tea.KeyEnter, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kBegin       = keyOf(tea.KeyHome, tea.ModCtrl)
+	kEndAll      = keyOf(tea.KeyEnd, tea.ModCtrl)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+	kTranspose   = keyOf('t', tea.ModCtrl)
+	kUpper       = keyOf('u', tea.ModAlt)
+	kLower       = keyOf('l', tea.ModAlt)
+	kCapital     = keyOf('c', tea.ModAlt)
+	kSelRight    = keyOf(tea.KeyRight, tea.ModShift)
+	kSelLeft     = keyOf(tea.KeyLeft, tea.ModShift)
+	kSelWordFwd  = keyOf('f', tea.ModAlt|tea.ModShift)
+	kSelWordBack = keyOf('b', tea.ModAlt|tea.ModShift)
+	kSelectAll   = keyOf('g', tea.ModCtrl)
+)
+
+// settleMsg is a message no binding matches: Update then only refreshes the
+// viewport and the cursor, as any unrelated message in a program would.
+type settleMsg struct{}
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+func genRune(tc hegel.TestCase) rune {
+	switch {
+	case chance(tc, 50):
+		return rune('a' + n(tc, 0, 25))
+	case chance(tc, 35):
+		return ' '
+	case chance(tc, 30):
+		return pick(tc, []rune("日本語漢字"))
+	case chance(tc, 40):
+		return rune('A' + n(tc, 0, 25))
+	case chance(tc, 50):
+		return pick(tc, []rune("0123456789.,-_/"))
+	default:
+		return pick(tc, []rune("éüñ"))
+	}
+}
+
+func genRunes(tc hegel.TestCase, lo, hi int) []rune {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = genRune(tc)
+	}
+	return rs
+}
+
+// genText draws a value as SetValue or a paste would bring it: several
+// lines, sometimes with tabs, lone CRs or CRLF pairs.
+func genText(tc hegel.TestCase) string {
+	k := n(tc, 1, 4)
+	var parts []string
+	for i := 0; i < k; i++ {
+		parts = append(parts, string(genRunes(tc, 0, 9)))
+	}
+	s := strings.Join(parts, "\n")
+	if chance(tc, 15) {
+		s = strings.ReplaceAll(s, "\n", "\r\n")
+	} else if chance(tc, 10) {
+		s = strings.ReplaceAll(s, "\n", "\r")
+	}
+	if chance(tc, 10) {
+		rs := []rune(s)
+		if len(rs) > 0 {
+			rs[n(tc, 0, len(rs)-1)] = '\t'
+		}
+		s = string(rs)
+	}
+	return s
+}
+
+func isWide(r rune) bool { return uniseg.StringWidth(string(r)) != 1 }
+
+func hasWide(rs []rune) bool {
+	for _, r := range rs {
+		if isWide(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// newArea makes a focused textarea whose text width is exactly width and
+// returns it with its prompt width and gutter width (line numbers).
+func newArea(tc hegel.TestCase, width, height int) (m Model, promptW, gutterW int) {
+	m = New()
+	m.Focus()
+	m.Prompt = pick(tc, []string{"┃ ", "> ", "", "|"})
+	m.ShowLineNumbers = chance(tc, 70)
+	if chance(tc, 30) {
+		m.MaxHeight = 9
+	}
+	promptW = uniseg.StringWidth(m.Prompt)
+	if m.ShowLineNumbers {
+		gutterW = len(strconv.Itoa(m.MaxHeight)) + 2
+	}
+	m.SetWidth(width + promptW + gutterW)
+	m.SetHeight(height)
+	if m.Width() != width {
+		panic(fmt.Sprintf("newArea: width %d, want %d", m.Width(), width))
+	}
+	return m, promptW, gutterW
+}
+
+// grid returns the library's wrap rows of every logical line.
+func grid(m Model) [][][]rune {
+	var g [][][]rune
+	for _, l := range m.value {
+		g = append(g, wrap(l, m.width))
+	}
+	return g
+}
+
+func visualRows(g [][][]rune) int {
+	t := 0
+	for _, rows := range g {
+		t += len(rows)
+	}
+	return t
+}
+
+// rowAt returns the runes of visual row v of the grid.
+func rowAt(g [][][]rune, v int) []rune {
+	for _, rows := range g {
+		if v < len(rows) {
+			return rows[v]
+		}
+		v -= len(rows)
+	}
+	return nil
+}
+
+// placeCursor puts the cursor on a random line and column of m (an internal
+// move, as SetValue and the keys would leave it) and settles the view.
+func placeCursor(tc hegel.TestCase, m Model) Model {
+	m.row = n(tc, 0, len(m.value)-1)
+	m.SetCursorColumn(n(tc, 0, len(m.value[m.row])))
+	return press(m, settleMsg{})
+}
+
+// ---------------------------------------------------------------- the editing model
+
+type pos struct{ row, col int }
+
+func (p pos) before(q pos) bool {
+	if p.row != q.row {
+		return p.row < q.row
+	}
+	return p.col < q.col
+}
+
+type editModel struct {
+	lines     [][]rune
+	row, col  int
+	anchor    pos
+	head      pos
+	has       bool // a selection was started and not cleared
+	libHas    bool // the textarea's own hasSelection flag (bubbles/26)
+	stale     bool // the textarea anchored a selection at a stale position
+	limit     int
+	maxHeight int
+}
+
+func newEditModel(limit, maxHeight int) *editModel {
+	return &editModel{lines: [][]rune{{}}, limit: limit, maxHeight: maxHeight}
+}
+
+func (e *editModel) value() string {
+	var parts []string
+	for _, l := range e.lines {
+		parts = append(parts, string(l))
+	}
+	return strings.Join(parts, "\n")
+}
+
+func (e *editModel) length() int {
+	t := len(e.lines) - 1
+	for _, l := range e.lines {
+		t += len(l)
+	}
+	return t
+}
+
+func (e *editModel) line() []rune { return e.lines[e.row] }
+
+func (e *editModel) selected() bool { return e.has && e.anchor != e.head }
+
+func (e *editModel) selection() (pos, pos) {
+	s, t := e.anchor, e.head
+	if t.before(s) {
+		s, t = t, s
+	}
+	return s, t
+}
+
+func (e *editModel) selectedText() string {
+	if !e.selected() {
+		return ""
+	}
+	s, t := e.selection()
+	if s.row == t.row {
+		return string(e.lines[s.row][s.col:t.col])
+	}
+	var b strings.Builder
+	b.WriteString(string(e.lines[s.row][s.col:]))
+	for r := s.row + 1; r < t.row; r++ {
+		b.WriteString("\n" + string(e.lines[r]))
+	}
+	b.WriteString("\n" + string(e.lines[t.row][:t.col]))
+	return b.String()
+}
+
+func (e *editModel) clearSel() {
+	e.has, e.libHas = false, false
+	e.anchor, e.head = pos{}, pos{}
+}
+
+// deleteSel removes the selection and reports whether there was one.
+func (e *editModel) deleteSel() bool {
+	if !e.selected() {
+		return false
+	}
+	s, t := e.selection()
+	merged := append(append([]rune{}, e.lines[s.row][:s.col]...), e.lines[t.row][t.col:]...)
+	rest := append([][]rune{}, e.lines[t.row+1:]...)
+	e.lines = append(append(e.lines[:s.row:s.row], merged), rest...)
+	e.row, e.col = s.row, s.col
+	e.clearSel()
+	return true
+}
+
+// sanitize is what the textarea should make of raw text: tabs become four
+// spaces, "\r\n" and lone "\r" line breaks, other controls vanish.
+func sanitize(s string) []rune {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\r", "\n")
+	s = strings.ReplaceAll(s, "\t", "    ")
+	var out []rune
+	for _, r := range s {
+		if r == '\n' || !unicode.IsControl(r) && r != unicode.ReplacementChar {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// insert inserts raw text at the cursor; it reports whether the character
+// limit or the line limit cut it.
+func (e *editModel) insert(s string) (cutByLimit, cutByLines bool) {
+	rs := sanitize(s)
+	if e.limit > 0 {
+		avail := e.limit - e.length()
+		if avail <= 0 {
+			return true, false
+		}
+		if avail < len(rs) {
+			rs = rs[:avail]
+			cutByLimit = true
+		}
+	}
+	parts := strings.Split(string(rs), "\n")
+	if e.maxHeight > 0 && len(e.lines)+len(parts)-1 > e.maxHeight {
+		parts = parts[:max(0, e.maxHeight-len(e.lines)+1)]
+		cutByLines = true
+		if len(parts) == 0 {
+			return
+		}
+	}
+	tail := append([]rune{}, e.line()[e.col:]...)
+	head := append([]rune{}, e.line()[:e.col]...)
+	first := append(head, []rune(parts[0])...)
+	if len(parts) == 1 {
+		e.lines[e.row] = append(first, tail...)
+		e.col = len(first)
+		return
+	}
+	newLines := [][]rune{first}
+	for _, p := range parts[1:] {
+		newLines = append(newLines, []rune(p))
+	}
+	last := len(newLines) - 1
+	e.col = len(newLines[last])
+	newLines[last] = append(newLines[last], tail...)
+	rest := append([][]rune{}, e.lines[e.row+1:]...)
+	e.lines = append(append(e.lines[:e.row:e.row], newLines...), rest...)
+	e.row += last
+	return
+}
+
+func (e *editModel) mergeBelow() {
+	if e.row >= len(e.lines)-1 {
+		return
+	}
+	e.lines[e.row] = append(e.lines[e.row], e.lines[e.row+1]...)
+	e.lines = append(e.lines[:e.row+1], e.lines[e.row+2:]...)
+}
+
+func (e *editModel) mergeAbove() {
+	if e.row == 0 {
+		return
+	}
+	e.col = len(e.lines[e.row-1])
+	e.lines[e.row-1] = append(e.lines[e.row-1], e.lines[e.row]...)
+	e.lines = append(e.lines[:e.row], e.lines[e.row+1:]...)
+	e.row--
+}
+
+func (e *editModel) splice(from, to int) {
+	l := e.line()
+	e.lines[e.row] = append(append([]rune{}, l[:from]...), l[to:]...)
+}
+
+func space(r rune) bool { return unicode.IsSpace(r) }
+
+// wordStart is where backward word deletion and motion stop: before the
+// spaces and the word to the left of the cursor.
+func (e *editModel) wordStart() int {
+	i := e.col
+	l := e.line()
+	for i > 0 && space(l[i-1]) {
+		i--
+	}
+	for i > 0 && !space(l[i-1]) {
+		i--
+	}
+	return i
+}
+
+func (e *editModel) wordEnd() int {
+	j := e.col
+	l := e.line()
+	for j < len(l) && space(l[j]) {
+		j++
+	}
+	for j < len(l) && !space(l[j]) {
+		j++
+	}
+	return j
+}
+
+func (e *editModel) left() {
+	if e.col == 0 && e.row > 0 {
+		e.row--
+		e.col = len(e.line())
+		return
+	}
+	if e.col > 0 {
+		e.col--
+	}
+}
+
+func (e *editModel) right() {
+	if e.col < len(e.line()) {
+		e.col++
+	} else if e.row < len(e.lines)-1 {
+		e.row++
+		e.col = 0
+	}
+}
+
+// wordLeft follows the textarea's own rule: step left (into the previous
+// line's last rune when at a line start) until on a non-space rune, then to
+// the start of that word.
+func (e *editModel) wordLeft() {
+	for {
+		or, oc := e.row, e.col
+		if e.col == 0 && e.row > 0 {
+			e.row--
+			e.col = len(e.line())
+		}
+		if e.col > 0 {
+			e.col--
+		}
+		if e.row == or && e.col == oc {
+			return
+		}
+		if e.col < len(e.line()) && !space(e.line()[e.col]) {
+			break
+		}
+	}
+	for e.col > 0 && !space(e.line()[e.col-1]) {
+		e.col--
+	}
+}
+
+// wordRight skips spaces (across line ends) and then a word; f sees every
+// rune of that word.
+func (e *editModel) wordRight(f func(i int, col int)) {
+	for e.col >= len(e.line()) || space(e.line()[e.col]) {
+		if e.row == len(e.lines)-1 && e.col == len(e.line()) {
+			break
+		}
+		e.right()
+	}
+	i := 0
+	for e.col < len(e.line()) && !space(e.line()[e.col]) {
+		if f != nil {
+			f(i, e.col)
+		}
+		e.col++
+		i++
+	}
+}
+
+// startSel anchors a keyboard selection at the cursor unless a non-empty one
+// is being extended. It reports whether the textarea, which only asks
+// whether a selection was ever started, keeps a stale anchor instead
+// (bubbles/26).
+func (e *editModel) startSel() (stale bool) {
+	stale = e.libHas && !e.selected() && e.anchor != (pos{e.row, e.col})
+	if !e.selected() {
+		e.anchor = pos{e.row, e.col}
+	}
+	e.has, e.libHas = true, true
+	e.head = pos{e.row, e.col}
+	if stale {
+		e.stale = true // from here on the textarea's selection is not the model's
+	}
+	return stale
+}
+
+func (e *editModel) endSel() { e.head = pos{e.row, e.col} }
+
+// step describes one operation of the editing property.
+type step struct {
+	name string
+	msg  tea.Msg
+	api  func(m *Model)
+	// shape names the pinned bug whose shape the step has, if any.
+	shape string
+}
+
+func opNames() []string {
+	return []string{
+		"type", "type", "type", "paste", "enter", "enter", "backspace", "backspace",
+		"delete", "delete", "left", "right", "home", "end", "killfwd", "killback",
+		"delwordback", "delwordfwd", "wordback", "wordfwd", "begin", "endall",
+		"transpose", "upper", "lower", "capital", "selright", "selleft",
+		"selwordfwd", "selwordback", "selectall", "setcol", "setvalue", "reset",
+		"insertstring",
+	}
+}
+
+// apply performs op on the model and returns the step for the textarea.
+func (e *editModel) apply(tc hegel.TestCase, op string) step {
+	switch op {
+	case "type":
+		r := genRune(tc)
+		e.deleteSel()
+		e.insert(string(r))
+		return step{name: "type " + strconv.QuoteRune(r), msg: typed(r)}
+	case "paste", "insertstring", "setvalue":
+		text := genText(tc)
+		s := step{name: op + " " + strconv.Quote(text)}
+		switch op {
+		case "paste":
+			e.deleteSel()
+			s.msg = tea.PasteMsg{Content: text}
+		case "insertstring":
+			if e.selected() {
+				return step{name: "skip"}
+			}
+			s.api = func(m *Model) { m.InsertString(text) }
+		default:
+			e.lines = [][]rune{{}}
+			e.row, e.col = 0, 0
+			e.clearSel()
+			s.api = func(m *Model) { m.SetValue(text) }
+		}
+		_, cutByLines := e.insert(text)
+		switch {
+		case strings.Contains(text, "\r\n"):
+			s.shape = "bubbles/20-shape"
+		case cutByLines:
+			s.shape = "bubbles/21-shape"
+		}
+		return s
+	case "enter":
+		e.deleteSel()
+		s := step{name: op, msg: kEnter}
+		if e.maxHeight <= 0 || len(e.lines) < e.maxHeight {
+			if cutByLimit, _ := e.insert("\n"); cutByLimit {
+				s.shape = "bubbles/25-shape"
+			}
+		}
+		return s
+	case "backspace":
+		if e.deleteSel() {
+			return step{name: op, msg: kBackspace}
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+		} else {
+			e.splice(e.col-1, e.col)
+			e.col--
+		}
+		return step{name: op, msg: kBackspace}
+	case "delete":
+		if e.deleteSel() {
+			return step{name: op, msg: kDelete}
+		}
+		if e.col < len(e.line()) {
+			e.splice(e.col, e.col+1)
+			if e.col == len(e.line()) && e.row < len(e.lines)-1 {
+				return step{name: op, msg: kDelete, shape: "bubbles/13-shape"}
+			}
+		} else {
+			e.mergeBelow()
+		}
+		return step{name: op, msg: kDelete}
+	case "killfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, len(e.line()))
+			}
+		}
+		return step{name: op, msg: kKill}
+	case "killback":
+		if !e.deleteSel() {
+			if e.col == 0 {
+				e.mergeAbove()
+			} else {
+				e.splice(0, e.col)
+				e.col = 0
+			}
+		}
+		return step{name: op, msg: kKillBack}
+	case "delwordback":
+		if e.deleteSel() {
+			return step{name: op, msg: kDelWordBack}
+		}
+		if e.col == 0 {
+			e.mergeAbove()
+			return step{name: op, msg: kDelWordBack}
+		}
+		i := e.wordStart()
+		shape := ""
+		if i == 1 && space(e.line()[0]) {
+			shape = "bubbles/24-shape"
+		}
+		e.splice(i, e.col)
+		e.col = i
+		return step{name: op, msg: kDelWordBack, shape: shape}
+	case "delwordfwd":
+		if !e.deleteSel() {
+			if e.col >= len(e.line()) {
+				e.mergeBelow()
+			} else {
+				e.splice(e.col, e.wordEnd())
+			}
+		}
+		return step{name: op, msg: kDelWordFwd}
+	case "left":
+		e.clearSel()
+		e.left()
+		return step{name: op, msg: kLeft}
+	case "right":
+		e.clearSel()
+		e.right()
+		return step{name: op, msg: kRight}
+	case "home":
+		e.clearSel()
+		e.col = 0
+		return step{name: op, msg: kHome}
+	case "end":
+		e.clearSel()
+		e.col = len(e.line())
+		return step{name: op, msg: kEnd}
+	case "wordback":
+		e.clearSel()
+		e.wordLeft()
+		return step{name: op, msg: kWordBack}
+	case "wordfwd":
+		e.clearSel()
+		e.wordRight(nil)
+		return step{name: op, msg: kWordFwd}
+	case "begin":
+		e.clearSel()
+		e.row, e.col = 0, 0
+		return step{name: op, msg: kBegin}
+	case "endall":
+		e.clearSel()
+		e.row = len(e.lines) - 1
+		e.col = len(e.line())
+		return step{name: op, msg: kEndAll}
+	case "transpose":
+		l := e.line()
+		if e.col > 0 && len(l) >= 2 {
+			if e.col >= len(l) {
+				e.col--
+			}
+			l[e.col-1], l[e.col] = l[e.col], l[e.col-1]
+			if e.col < len(l) {
+				e.col++
+			}
+		}
+		return step{name: op, msg: kTranspose}
+	case "upper", "lower", "capital":
+		var msg tea.Msg
+		switch op {
+		case "upper":
+			msg = kUpper
+			e.wordRight(func(_, c int) { e.line()[c] = unicode.ToUpper(e.line()[c]) })
+		case "lower":
+			msg = kLower
+			e.wordRight(func(_, c int) { e.line()[c] = unicode.ToLower(e.line()[c]) })
+		default:
+			msg = kCapital
+			e.wordRight(func(i, c int) {
+				if i == 0 {
+					e.line()[c] = unicode.ToTitle(e.line()[c])
+				}
+			})
+		}
+		return step{name: op, msg: msg}
+	case "selright", "selleft", "selwordfwd", "selwordback":
+		s := step{name: op}
+		if e.startSel() {
+			s.shape = "bubbles/26-shape"
+		}
+		switch op {
+		case "selright":
+			s.msg = kSelRight
+			e.right()
+		case "selleft":
+			s.msg = kSelLeft
+			e.left()
+		case "selwordfwd":
+			s.msg = kSelWordFwd
+			e.wordRight(nil)
+		default:
+			s.msg = kSelWordBack
+			e.wordLeft()
+		}
+		e.endSel()
+		return s
+	case "selectall":
+		e.anchor = pos{0, 0}
+		e.head = pos{len(e.lines) - 1, len(e.lines[len(e.lines)-1])}
+		e.has, e.libHas = true, true
+		return step{name: op, msg: kSelectAll}
+	case "setcol":
+		k := n(tc, -1, len(e.line())+1)
+		e.col = min(max(k, 0), len(e.line()))
+		return step{name: fmt.Sprintf("setcol %d", k), api: func(m *Model) { m.SetCursorColumn(k) }}
+	case "reset":
+		e.lines = [][]rune{{}}
+		e.row, e.col = 0, 0
+		e.clearSel()
+		return step{name: op, api: func(m *Model) { m.Reset() }}
+	}
+	panic("unknown op " + op)
+}
+
+// TestHegelTextareaEditingFollowsTheModel drives every default key binding, pastes
+// and the public setters through Update and checks the value, the cursor and
+// the selection against the model after each step.
+func TestHegelTextareaEditingFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		limit := 0
+		if chance(ht, 30) {
+			limit = n(ht, 1, 12)
+		}
+		maxHeight := 99
+		if chance(ht, 30) {
+			maxHeight = n(ht, 1, 4)
+		}
+		m := New()
+		m.Focus()
+		m.CharLimit = limit
+		m.MaxHeight = maxHeight
+		m.SetWidth(n(ht, 8, 30))
+		m.SetHeight(n(ht, 1, 5))
+		e := newEditModel(limit, maxHeight)
+		steps := n(ht, 1, 30)
+		var log []string
+		var cur step
+		defer func() {
+			if r := recover(); r != nil {
+				if _, ok := r.(error); ok {
+					if cur.shape != "" || e.stale {
+						if cur.shape == "" {
+							cur.shape = "bubbles/26-shape"
+						}
+						// the textarea panicked on a step with a pinned shape
+						// (bubbles/26: a stale anchor on a deleted line)
+						count(cur.shape + "-panic")
+						return
+					}
+					// a runtime error in the textarea: say which steps led to it
+					panic(fmt.Sprintf("%v (limit=%d maxHeight=%d; steps: %s)", r, limit, maxHeight, strings.Join(log, "; ")))
+				}
+				panic(r)
+			}
+		}()
+		for i := 0; i < steps; i++ {
+			op := pick(ht, opNames())
+			s := e.apply(ht, op)
+			if s.name == "skip" {
+				continue
+			}
+			cur = s
+			if s.api != nil {
+				s.api(&m)
+			} else {
+				m = press(m, s.msg)
+			}
+			log = append(log, s.name)
+			if s.shape != "" {
+				count(s.shape)
+			}
+			mismatch := ""
+			switch {
+			case m.Value() != e.value():
+				mismatch = fmt.Sprintf("value %q, want %q", m.Value(), e.value())
+			case m.Line() != e.row || m.Column() != e.col:
+				mismatch = fmt.Sprintf("cursor (%d,%d), want (%d,%d)", m.Line(), m.Column(), e.row, e.col)
+			case m.LineCount() != len(e.lines):
+				mismatch = fmt.Sprintf("LineCount %d, want %d", m.LineCount(), len(e.lines))
+			case m.HasSelection() != e.selected():
+				mismatch = fmt.Sprintf("HasSelection %v, want %v", m.HasSelection(), e.selected())
+			case m.SelectedText() != e.selectedText():
+				mismatch = fmt.Sprintf("SelectedText %q, want %q", m.SelectedText(), e.selectedText())
+			}
+			if mismatch == "" {
+				continue
+			}
+			if s.shape != "" {
+				return
+			}
+			if e.stale {
+				count("bubbles/26-shape-later")
+				return
+			}
+			// bubbles/17: with a CharLimit the library measures the value in
+			// display columns, so any rune of another width diverges.
+			if limit > 0 && (hasWide([]rune(e.value())) || hasWide([]rune(m.Value()))) {
+				count("bubbles/17-shape")
+				return
+			}
+			fail(ht, "limit=%d maxHeight=%d after %s: %s\nsteps: %s", limit, maxHeight, s.name, mismatch, strings.Join(log, "; "))
+		}
+	})
+}
+
+// TestHegelVerticalMotionMovesOneVisualRow: Up and Down move the cursor by
+// exactly one row of the wrap grid (none at the edges) and never change the
+// value.
+func TestHegelVerticalMotionMovesOneVisualRow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m, _, _ := newArea(ht, n(ht, 1, 10), n(ht, 1, 6))
+		m.SetValue(genText(ht))
+		m = placeCursor(ht, m)
+		g := grid(m)
+		total := visualRows(g)
+		value := m.Value()
+		var log []string
+		for i := n(ht, 1, 6); i > 0; i-- {
+			before := m.cursorLineNumber()
+			want := before
+			var k tea.Msg
+			if chance(ht, 50) {
+				k = kDown
+				if want < total-1 {
+					want++
+				}
+				log = append(log, "down")
+			} else {
+				k = kUp
+				if want > 0 {
+					want--
+				}
+				log = append(log, "up")
+			}
+			m = press(m, k)
+			got := m.cursorLineNumber()
+			if m.Value() != value {
+				fail(ht, "value changed by %s: %q -> %q", log, value, m.Value())
+			}
+			if m.Column() < 0 || m.Column() > len(m.value[m.Line()]) {
+				fail(ht, "cursor column %d out of line %q", m.Column(), string(m.value[m.Line()]))
+			}
+			if got == want {
+				continue
+			}
+			// bubbles/14: rows of two runes or fewer around the move (the
+			// row aimed at, or the lone trailing-space row the cursor is on).
+			if len(rowAt(g, want)) <= 2 || len(rowAt(g, before)) <= 2 || hasWide(rowAt(g, want)) {
+				count("bubbles/14-shape")
+				return
+			}
+			fail(ht, "width %d value %q: %s from visual row %d landed on %d, want %d (rows %q)",
+				m.Width(), value, strings.Join(log, ","), before, got, want, rowsOf(g))
+		}
+	})
+}
+
+func rowsOf(g [][][]rune) []string {
+	var out []string
+	for _, rows := range g {
+		for _, r := range rows {
+			out = append(out, string(r))
+		}
+	}
+	return out
+}
+
+// TestHegelViewShowsTheWrappedRows: the view is height rows of prompt +
+// gutter + text width cells; the rows from the scroll offset on show the
+// wrap grid's rows (line number on a line's first row, blank on
+// continuation rows, one trailing space trimmed when the row overflows,
+// padding to the width), then end-of-buffer rows; the cursor's row is
+// visible and its cell, at gutter + CharOffset, is the only reversed one and
+// holds the rune under the cursor.
+func TestHegelViewShowsTheWrappedRows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		width, height := n(ht, 1, 10), n(ht, 1, 6)
+		m, promptW, gutterW := newArea(ht, width, height)
+		m.SetValue(genText(ht))
+		m = placeCursor(ht, m)
+		g := grid(m)
+		li := m.LineInfo()
+		cursorRow := m.cursorLineNumber()
+		yoff := m.viewport.YOffset()
+		digits := len(strconv.Itoa(m.MaxHeight))
+
+		// expected plain rows and the cursor cell
+		type row struct {
+			plain string
+			wide  bool // the wrap row is wider than the width (bubbles/16)
+		}
+		var rows []row
+		for l, wrapped := range g {
+			for k, r := range wrapped {
+				gutter := ""
+				if m.ShowLineNumbers {
+					if k == 0 {
+						gutter = fmt.Sprintf(" %*d ", digits, l+1)
+					} else {
+						gutter = fmt.Sprintf(" %*s ", digits, " ")
+					}
+				}
+				text := string(r)
+				w := uniseg.StringWidth(text)
+				wide := false
+				if w > width {
+					text = strings.TrimSuffix(text, " ")
+					w = uniseg.StringWidth(text)
+					wide = w > width
+				}
+				text += strings.Repeat(" ", max(0, width-w))
+				rows = append(rows, row{plain: m.Prompt + gutter + text, wide: wide})
+			}
+		}
+		for len(rows) < yoff+height {
+			rows = append(rows, row{plain: m.Prompt + string(m.EndOfBufferCharacter) + strings.Repeat(" ", max(0, width-1+gutterW))})
+		}
+
+		lines := strings.Split(strings.TrimSuffix(m.View(), "\n"), "\n")
+		if len(lines) != height {
+			fail(ht, "view has %d rows, want height %d:\n%s", len(lines), height, m.View())
+		}
+		if cursorRow < yoff || cursorRow >= yoff+height {
+			fail(ht, "cursor row %d not in the view [%d,%d)", cursorRow, yoff, yoff+height)
+		}
+		wantCol := promptW + gutterW + li.CharOffset
+		cursorRune := " "
+		if li.ColumnOffset < len(rowAt(g, cursorRow)) {
+			cursorRune = string(rowAt(g, cursorRow)[li.ColumnOffset])
+		}
+		fullW := promptW + gutterW + width
+		for i, line := range lines {
+			cells := zootest.Cells(line)
+			want := rows[yoff+i]
+			plain := zootest.Plain(cells)
+			if zootest.Width(cells) != fullW || strings.TrimRight(plain, " ") != strings.TrimRight(want.plain, " ") {
+				if want.wide {
+					count("bubbles/16-shape")
+					return
+				}
+				fail(ht, "row %d (visual %d) is %q (%d cells), want %q (%d cells)\nvalue %q width %d rows %q",
+					i, yoff+i, zootest.String(cells), zootest.Width(cells), want.plain, fullW, m.Value(), width, rowsOf(g))
+			}
+			// the cursor cell
+			col := 0
+			for _, c := range cells {
+				if c.Rev {
+					if yoff+i != cursorRow || col != wantCol || c.S != cursorRune {
+						fail(ht, "reversed cell %q at (%d,%d), want %q at (%d,%d)\nvalue %q width %d li %+v rows %q",
+							c.S, col, yoff+i, cursorRune, wantCol, cursorRow, m.Value(), width, li, rowsOf(g))
+					}
+				}
+				col += c.W
+			}
+		}
+	})
+}
+
+// TestHegelRealCursorAndPositionAtAgree: the real cursor's position is the
+// virtual cursor's cell, and PositionAt of that cell is the cursor's
+// position in the buffer.
+func TestHegelRealCursorAndPositionAtAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m, _, _ := newArea(ht, n(ht, 1, 10), n(ht, 1, 6))
+		m.SetValue(genText(ht))
+		m = placeCursor(ht, m)
+		if g := grid(m); uniseg.StringWidth(string(rowAt(g, m.cursorLineNumber()))) > m.Width() {
+			count("bubbles/16-shape") // the cursor's row overflows and is truncated
+			return
+		}
+		x, y := -1, -1
+		for i, line := range strings.Split(strings.TrimSuffix(m.View(), "\n"), "\n") {
+			col := 0
+			for _, c := range zootest.Cells(line) {
+				if c.Rev {
+					x, y = col, i
+				}
+				col += c.W
+			}
+		}
+		if x < 0 {
+			fail(ht, "no virtual cursor in the view of %q", m.Value())
+		}
+		real := m
+		real.SetVirtualCursor(false)
+		c := real.Cursor()
+		if c == nil || c.Position.X != x || c.Position.Y != y {
+			fail(ht, "real cursor %+v, virtual at (%d,%d); value %q cursor (%d,%d) width %d",
+				c, x, y, m.Value(), m.Line(), m.Column(), m.Width())
+		}
+		p := m.PositionAt(x, y)
+		if p.Row != m.Line() || p.Col != m.Column() {
+			fail(ht, "PositionAt(%d,%d) = %+v, cursor (%d,%d); value %q width %d rows %q",
+				x, y, p, m.Line(), m.Column(), m.Value(), m.Width(), rowsOf(grid(m)))
+		}
+	})
+}
+
+// TestHegelLineInfoDescribesTheWrappedRow: LineInfo reports the wrap row the
+// cursor is on (the next row when at the end of a row that is not the last),
+// its rune count and display width, and the cursor's offsets within it.
+func TestHegelLineInfoDescribesTheWrappedRow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m, _, _ := newArea(ht, n(ht, 1, 10), 3)
+		m.SetValue(string(genRunes(ht, 0, 24)))
+		m.SetCursorColumn(n(ht, 0, len(m.value[0])))
+		rows := wrap(m.value[0], m.width)
+		want := LineInfo{Height: len(rows)}
+		start := 0
+		for i, r := range rows {
+			if start+len(r) == m.col && i+1 < len(rows) {
+				want.RowOffset, want.StartColumn = i+1, m.col
+				want.Width, want.CharWidth = len(rows[i+1]), uniseg.StringWidth(string(rows[i+1]))
+				break
+			}
+			if start+len(r) >= m.col {
+				want.RowOffset, want.StartColumn = i, start
+				want.Width, want.CharWidth = len(r), uniseg.StringWidth(string(r))
+				want.ColumnOffset = m.col - start
+				want.CharOffset = uniseg.StringWidth(string(r[:want.ColumnOffset]))
+				break
+			}
+			start += len(r)
+		}
+		got := m.LineInfo()
+		if got == want {
+			return
+		}
+		g2 := got
+		g2.CharWidth = want.CharWidth
+		if g2 == want && got.ColumnOffset == 0 && got.RowOffset > 0 {
+			count("bubbles/15-shape")
+			return
+		}
+		fail(ht, "value %q width %d col %d: LineInfo %+v, want %+v (rows %q)",
+			m.Value(), m.width, m.col, got, want, rowsOf([][][]rune{rows}))
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func pinArea(width, height int) Model {
+	m := New()
+	m.Focus()
+	m.Prompt = "> "
+	m.SetWidth(width + 2 + 4)
+	m.SetHeight(height)
+	return m
+}
+
+func plainRows(v string) []string {
+	var out []string
+	for _, l := range strings.Split(strings.TrimSuffix(v, "\n"), "\n") {
+		out = append(out, zootest.String(zootest.Cells(l)))
+	}
+	return out
+}
+
+// bubbles/13: Delete on the last rune of a line also joins the next line.
+func TestHegelPinDeleteOnTheLastRuneJoinsTheNextLine(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m.SetValue("ab\ncd")
+	m.MoveToBegin()
+	m.SetCursorColumn(1)
+	m = press(m, kDelete)
+	if m.Value() != "a\ncd" {
+		t.Fatalf("delete on 'b' of \"ab\\ncd\": value %q, want \"a\\ncd\"", m.Value())
+	}
+}
+
+// bubbles/14: Down skips a wrapped row of two runes or fewer and Up sticks
+// below it.
+func TestHegelPinVerticalMotionSkipsShortWrappedRows(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abcd e fghi") // rows "abcd ", "e ", "fghi "
+	m.MoveToBegin()
+	m = press(m, kDown)
+	if r := m.cursorLineNumber(); r != 1 {
+		t.Errorf("down from row 0 landed on visual row %d (col %d), want 1", r, m.Column())
+	}
+	m.MoveToEnd()
+	m = press(m, kUp)
+	if r := m.cursorLineNumber(); r != 1 {
+		t.Errorf("up from row 2 landed on visual row %d (col %d), want 1", r, m.Column())
+	}
+}
+
+// bubbles/15: LineInfo at the start of a wrapped row reports the previous
+// row's CharWidth.
+func TestHegelPinLineInfoCharWidthIsThePreviousRows(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abc defgh") // rows "abc ", "defgh "
+	m.SetCursorColumn(4)
+	li := m.LineInfo()
+	if li.RowOffset != 1 || li.Width != 6 {
+		t.Fatalf("unexpected LineInfo %+v", li)
+	}
+	if li.CharWidth != 6 {
+		t.Fatalf("LineInfo at the start of row \"defgh \": CharWidth %d, want 6 (Width %d)", li.CharWidth, li.Width)
+	}
+}
+
+// bubbles/16: a double-width rune after width-1 columns of a word makes a
+// wrap row wider than the width; the view truncates it and the rune is gone.
+func TestHegelPinWideRuneOverflowsTheRowAndVanishes(t *testing.T) {
+	defer guard(t)
+	m := pinArea(5, 4)
+	m.SetValue("abcd日")
+	rows := wrap([]rune("abcd日"), 5)
+	if w := uniseg.StringWidth(string(rows[0])); w > 5 {
+		t.Errorf("wrap row %q is %d columns wide in a width of 5", string(rows[0]), w)
+	}
+	if v := m.View(); !strings.Contains(v, "日") {
+		t.Errorf("the view of \"abcd日\" does not contain 日:\n%s", strings.Join(plainRows(v), "\n"))
+	}
+}
+
+// bubbles/17: CharLimit is measured in display columns, so two CJK
+// characters exhaust a limit of 4 and a paste of three passes it.
+func TestHegelPinCharLimitCountsColumns(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m.CharLimit = 4
+	m.SetValue("日本")
+	m = press(m, typed('語'))
+	if m.Value() != "日本語" {
+		t.Errorf("CharLimit 4 after \"日本\": typing 語 gives %q, want \"日本語\"", m.Value())
+	}
+	m = pinArea(20, 4)
+	m.CharLimit = 4
+	m = press(m, tea.PasteMsg{Content: "日本語漢字"})
+	if m.Value() != "日本語漢" {
+		t.Errorf("CharLimit 4: pasting five CJK characters gives %q (Length %d), want \"日本語漢\"", m.Value(), m.Length())
+	}
+}
+
+// bubbles/18: the line-number gutter is sized at render time from
+// MaxHeight's digits while the text width was fixed by SetWidth; with
+// MaxHeight 0 ("no limit") line 10 pushes the text one column right.
+func TestHegelPinNoLimitGutterShiftsTheText(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 12)
+	m.MaxHeight = 0
+	m.SetHeight(12)
+	m.SetValue(strings.Repeat("x\n", 11) + "x")
+	rows := plainRows(m.View())
+	col := func(r string) int { return strings.Index(zootest.Plain(zootest.Cells(r)), "x") }
+	if col(rows[0]) != col(rows[9]) {
+		t.Fatalf("MaxHeight 0: the text starts at column %d on line 1 and %d on line 10:\n%s\n%s", col(rows[0]), col(rows[9]), rows[0], rows[9])
+	}
+}
+
+// bubbles/19: SetValue (and InsertString) leave the viewport at the top
+// while the cursor is on the last line; View shows the first lines and
+// Cursor() points below the textarea until the next message.
+func TestHegelPinSetValueDoesNotScrollToTheCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.SetValue("l1\nl2\nl3\nl4\nl5\nl6")
+	if m.Line() != 5 {
+		t.Fatalf("cursor on line %d, want 5", m.Line())
+	}
+	m.SetVirtualCursor(false)
+	c := m.Cursor()
+	if m.ScrollYOffset() != 3 || c.Position.Y != 2 {
+		t.Fatalf("after SetValue of six lines in a height of 3: ScrollYOffset %d (want 3), Cursor().Y %d (want 2); view:\n%s",
+			m.ScrollYOffset(), c.Position.Y, strings.Join(plainRows(m.View()), "\n"))
+	}
+}
+
+// bubbles/20: CRLF line breaks are doubled by the sanitizer.
+func TestHegelPinCRLFPasteDoublesTheLineBreaks(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 4)
+	m = press(m, tea.PasteMsg{Content: "a\r\nb"})
+	if m.Value() != "a\nb" {
+		t.Fatalf("pasting \"a\\r\\nb\" gives %q, want \"a\\nb\"", m.Value())
+	}
+}
+
+// bubbles/21: MaxHeight refuses Enter at the limit but a paste adds lines
+// past it.
+func TestHegelPinPasteIgnoresMaxHeight(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.MaxHeight = 3
+	m.SetHeight(3)
+	m.SetValue("a\nb\nc")
+	m = press(m, kEnter)
+	if m.LineCount() != 3 {
+		t.Fatalf("Enter at MaxHeight 3 gave %d lines", m.LineCount())
+	}
+	m = press(m, tea.PasteMsg{Content: "x\ny\nz"})
+	if m.LineCount() > 3 {
+		t.Fatalf("a paste at MaxHeight 3 gave %d lines: %q", m.LineCount(), m.Value())
+	}
+}
+
+// bubbles/22: a MaxWidth below the prompt and gutter width drives the text
+// width negative and the view shows no text.
+func TestHegelPinSmallMaxWidthHidesTheText(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.MaxWidth = 3
+	m.SetWidth(20)
+	if m.Width() < 1 {
+		t.Errorf("MaxWidth 3: Width() = %d, want at least 1", m.Width())
+	}
+	m = press(m, typed('a'))
+	if v := m.View(); !strings.Contains(v, "a") {
+		t.Errorf("MaxWidth 3: the typed 'a' is not in the view %q", plainRows(v)[0])
+	}
+}
+
+// bubbles/23: a placeholder of white space (trimmed to nothing) renders no
+// cursor at all.
+func TestHegelPinBlankPlaceholderHasNoCursor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(10, 3)
+	m.Placeholder = "   "
+	for _, c := range zootest.Cells(strings.Split(m.View(), "\n")[0]) {
+		if c.Rev {
+			return
+		}
+	}
+	t.Fatalf("no reversed (cursor) cell in the first row of a focused textarea with a blank placeholder: %q", plainRows(m.View())[0])
+}
+
+// bubbles/25: Enter ignores CharLimit; the newline counts in Length, which
+// then exceeds the limit.
+func TestHegelPinEnterIgnoresCharLimit(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.CharLimit = 2
+	m.SetValue("ab")
+	m = press(m, kEnter)
+	if m.Length() > 2 {
+		t.Fatalf("CharLimit 2 after \"ab\": Enter gives %q, Length %d", m.Value(), m.Length())
+	}
+}
+
+// bubbles/26: an empty keyboard selection (shift+right at the end of the
+// buffer) keeps its anchor through later edits, so the next shift+arrow
+// selects from where the cursor was.
+func TestHegelPinEmptySelectionKeepsAStaleAnchor(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue("o")
+	m = press(m, kSelRight) // nothing to select past the end
+	m = press(m, kKillBack) // line is now empty
+	for _, r := range "abc" {
+		m = press(m, typed(r))
+	}
+	m = press(m, kSelLeft)
+	if got := m.SelectedText(); got != "c" {
+		t.Errorf("shift+left after typing \"abc\" selects %q, want \"c\"", got)
+	}
+	// and when the anchor's line has been deleted, the next edit panics
+	m = pinArea(20, 3)
+	m.SetValue("a\n")
+	m = press(m, kSelRight)  // empty selection anchored at (1,0)
+	m = press(m, kBackspace) // joins the lines: line 1 is gone
+	m = press(m, kSelLeft)   // selection from the stale (1,0) to (0,0)
+	m = press(m, typed('x')) // deleteSelection indexes value[1]
+	if m.Value() != "x" && m.Value() != "ax" {
+		t.Errorf("value %q after the stale selection", m.Value())
+	}
+}
+
+// bubbles/24: ctrl+w on the first word of a line also deletes the space
+// before it.
+func TestHegelPinTextareaDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w after \" ab\": value %q, want \" \"", m.Value())
+	}
+}
diff --git a/textinput/hegel_test.go b/textinput/hegel_test.go
new file mode 100644
index 0000000..5cf9f7e
--- /dev/null
+++ b/textinput/hegel_test.go
@@ -0,0 +1,978 @@
+package textinput
+
+// Hegel property tests for the textinput bubble: a single-line editor with a
+// cursor, an optional width (a horizontally scrolling window), a character
+// limit, a validator, echo modes and prefix suggestions.
+//
+// The model is a rune slice with a cursor. Every key of the default key map is
+// driven through Update; after each step Value, Position and Err must match the
+// model, and View, parsed into cells, must show the prompt, the window of the
+// value that contains the cursor (the library's own offsets are read, being
+// internal), the cursor in reverse video at the cursor's column, and the
+// padding that makes the field exactly Width+1 cells wide.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property = zootest.Property
+	fail     = zootest.Fail
+	count    = zootest.Count
+	guard    = zootest.Guard
+	n        = zootest.N
+	chance   = zootest.Chance
+	note     = zootest.Note
+)
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return zootest.Pick(tc, xs) }
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kTab         = keyOf(tea.KeyTab, 0)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+)
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+func genRune(tc hegel.TestCase) rune {
+	switch {
+	case chance(tc, 50):
+		return rune('a' + n(tc, 0, 25))
+	case chance(tc, 30):
+		return ' '
+	case chance(tc, 30):
+		return pick(tc, []rune("日本語漢字"))
+	case chance(tc, 40):
+		return rune('A' + n(tc, 0, 25))
+	case chance(tc, 50):
+		return pick(tc, []rune("0123456789.,-_/"))
+	default:
+		return pick(tc, []rune("éüñ"))
+	}
+}
+
+func genRunes(tc hegel.TestCase, lo, hi int) []rune {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = genRune(tc)
+	}
+	return rs
+}
+
+// genPaste draws text as a paste would bring it: with tabs and newlines.
+func genPaste(tc hegel.TestCase) string {
+	rs := genRunes(tc, 0, 8)
+	for i := range rs {
+		if chance(tc, 10) {
+			rs[i] = pick(tc, []rune{'\t', '\n', '\r'})
+		}
+	}
+	return string(rs)
+}
+
+var (
+	errTooLong  = errors.New("too long")
+	errRequired = errors.New("required")
+)
+
+func genValidate(tc hegel.TestCase) (ValidateFunc, string) {
+	switch n(tc, 0, 2) {
+	case 0:
+		return nil, "none"
+	case 1:
+		k := n(tc, 1, 6)
+		return func(s string) error {
+			if len([]rune(s)) > k {
+				return errTooLong
+			}
+			return nil
+		}, fmt.Sprintf("max %d", k)
+	default:
+		return func(s string) error {
+			if s == "" {
+				return errRequired
+			}
+			return nil
+		}, "required"
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// ---------------------------------------------------------------- the model
+
+type editModel struct {
+	value    []rune
+	pos      int
+	limit    int
+	err      error
+	validate ValidateFunc
+	echo     EchoMode
+}
+
+// sanitize is what the input sanitizer does: tabs and newline characters
+// become single spaces, one each.
+func sanitize(rs []rune) []rune {
+	out := make([]rune, 0, len(rs))
+	for _, r := range rs {
+		if r == '\t' || r == '\n' || r == '\r' {
+			r = ' '
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+func (e *editModel) check(v []rune) error {
+	if e.validate != nil {
+		return e.validate(string(v))
+	}
+	return nil
+}
+
+func (e *editModel) setValue(s string) {
+	rs := sanitize([]rune(s))
+	e.err = e.check(rs)
+	empty := len(e.value) == 0
+	if e.limit > 0 && len(rs) > e.limit {
+		rs = rs[:e.limit]
+	}
+	e.value = rs
+	if (e.pos == 0 && empty) || e.pos > len(e.value) {
+		e.pos = len(e.value)
+	}
+}
+
+func (e *editModel) insert(rs []rune) {
+	rs = sanitize(rs)
+	if e.limit > 0 {
+		avail := e.limit - len(e.value)
+		if avail <= 0 {
+			return
+		}
+		if len(rs) > avail {
+			rs = rs[:avail]
+		}
+	}
+	v := make([]rune, 0, len(e.value)+len(rs))
+	v = append(v, e.value[:e.pos]...)
+	v = append(v, rs...)
+	v = append(v, e.value[e.pos:]...)
+	empty := len(e.value) == 0
+	e.pos += len(rs)
+	e.err = e.check(v)
+	e.value = v
+	if (e.pos == 0 && empty) || e.pos > len(v) {
+		e.pos = len(v)
+	}
+}
+
+func (e *editModel) cut(from, to int) {
+	v := make([]rune, 0, len(e.value))
+	v = append(v, e.value[:from]...)
+	v = append(v, e.value[to:]...)
+	e.value = v
+	e.err = e.check(v)
+}
+
+func isSpace(r rune) bool { return unicode.IsSpace(r) }
+
+func (e *editModel) clamp(p int) int {
+	return max(0, min(p, len(e.value)))
+}
+
+// wordStart is where a backward word motion from pos ends: past any spaces,
+// then past the word.
+func (e *editModel) wordStart() int {
+	s := e.pos
+	for s > 0 && isSpace(e.value[s-1]) {
+		s--
+	}
+	for s > 0 && !isSpace(e.value[s-1]) {
+		s--
+	}
+	return s
+}
+
+// wordEnd is where a forward word motion from pos ends.
+func (e *editModel) wordEnd() int {
+	t := e.pos
+	for t < len(e.value) && isSpace(e.value[t]) {
+		t++
+	}
+	for t < len(e.value) && !isSpace(e.value[t]) {
+		t++
+	}
+	return t
+}
+
+// ---------------------------------------------------------------- views
+
+func echo(m Model, s string) string {
+	switch m.EchoMode {
+	case EchoPassword:
+		return strings.Repeat(string(m.EchoCharacter), uniseg.StringWidth(s))
+	case EchoNone:
+		return ""
+	}
+	return s
+}
+
+func spaces(k int) string {
+	if k <= 0 {
+		return ""
+	}
+	return strings.Repeat(" ", k)
+}
+
+// checkView compares View with the window the library keeps (offset,
+// offsetRight) around the cursor: the text, the cursor cell and the width.
+func checkView(ht *hegel.T, m Model, what string) {
+	if m.EchoMode == EchoNone {
+		return
+	}
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		fail(ht, "%s: window [%d,%d) does not hold the cursor %d in a value of %d runes", what, off, right, pos, len(value))
+	}
+	if m.Width() <= 0 && (off != 0 || right != len(value)) {
+		fail(ht, "%s: no width, but the window is [%d,%d) of %d runes", what, off, right, len(value))
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	window := echo(m, string(value[off:right]))
+	cursorChar := " "
+	if pos < right {
+		cursorChar = echo(m, string(value[pos]))
+	} else if pos < len(value) {
+		// The rune under the cursor is past the window: the cursor shows as
+		// a blank at the right edge (bubbles/11).
+		count("bubbles/11-shape")
+	}
+	want := m.Prompt + window
+	if pos == right {
+		want += " "
+	}
+	shown := uniseg.StringWidth(window)
+	if pos == right {
+		shown++
+	}
+	if m.Width() > 0 {
+		pad := m.Width() + 1 - shown
+		if pad < 0 {
+			// The window is only re-fitted when the cursor crosses one of
+			// its edges: SetWidth, an insertion inside the window and
+			// ctrl+u leave it wider than the width (bubbles/7).
+			count("bubbles/7-shape")
+			pad = 0
+		}
+		want += spaces(pad)
+	}
+	if got := zootest.Plain(cells); got != want {
+		fail(ht, "%s: view text %q, want %q (window [%d,%d) cursor %d width %d)\nview %s", what, got, want, off, right, pos, m.Width(), zootest.String(cells))
+	}
+	// The cursor: one reversed run at the cursor's column.
+	col := promptW + uniseg.StringWidth(echo(m, string(value[off:pos])))
+	x, start, revW := 0, -1, 0
+	for _, c := range cells {
+		if c.Rev {
+			if start < 0 {
+				start = x
+			} else if revW != x-start {
+				fail(ht, "%s: reversed cells are not one run\nview %s", what, zootest.String(cells))
+			}
+			revW += c.W
+		}
+		x += c.W
+	}
+	if start != col || revW != uniseg.StringWidth(cursorChar) {
+		fail(ht, "%s: the cursor run is at column %d, %d wide; want column %d, %d wide (%q)\nview %s", what, start, revW, col, uniseg.StringWidth(cursorChar), cursorChar, zootest.String(cells))
+	}
+}
