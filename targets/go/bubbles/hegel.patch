+// bubbles/90
+func TestHegelPinTreeSetNodesLeavesTheRootScrolledOff(t *testing.T) {
+	m := New(Root("root").Child("a", "b", "c", "d", "e", "f", "g", "h", "i", "j"), 30, 4)
