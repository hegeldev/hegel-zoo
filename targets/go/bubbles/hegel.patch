new file mode 100644
index 0000000..bafb7f0
--- /dev/null
+++ b/textinput/hegel_test.go
@@ -0,0 +1,1516 @@
+package textinput
+
+// Hegel property tests for the textinput bubble: a single-line editor with a
+// cursor, an optional width (a horizontally scrolling window), a character
+// limit, a validator, echo modes and prefix suggestions.
+//
+// The model is a rune slice with a cursor. A case is a record of the start (the
+// prompt, the width, the character limit, the validator, the echo mode, the
+// initial value) and a list of operation records (every key of the default key
+// map, pastes, SetValue, SetCursor, SetWidth and Reset) applied in order; after
+// each one Value, Position and Err must match the model, and View, parsed into
+// cells, must show the prompt, the echoed window of the value that holds the
+// cursor (the library's own offsets are read, being internal; the window never
+// wider than the field), the rune under the cursor in reverse video at the
+// cursor's column, and the padding that makes the field exactly Width+1 cells.
+//
+// The shapes of the recorded bugs are drawn like any other case, judged against
+// that model and fail naming them. bubbles/1, 7, 9, 10 and 11 (and 5, 6 and 8 of
+// the other properties) are relations between an operation and the live state,
+// declared by a classifier before each comparison; under HEGEL_NO_KNOWN=1 the
+// operations that would reach one are left out of the drawn list by replaying
+// the library and the model (unshaped), EchoNone (bubbles/12), no or a negative
+// width for the placeholder (2, 4) and wide placeholder runes (3) are not drawn,
+// and the cursor property's values fit the field.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var guard = zootest.Guard
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kTab         = keyOf(tea.KeyTab, 0)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+)
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+var (
+	errTooLong  = errors.New("too long")
+	errRequired = errors.New("required")
+)
+
+// validator is a case's Validate function: none, a maximum rune count or
+// "required" (the empty value rejected).
+type validator struct {
+	kind string
+	k    int
+}
+
+func (v validator) String() string {
+	if v.kind == "max" {
+		return fmt.Sprintf("max %d", v.k)
+	}
+	return v.kind
+}
+
+func (v validator) fn() ValidateFunc {
+	switch v.kind {
+	case "max":
+		k := v.k
+		return func(s string) error {
+			if len([]rune(s)) > k {
+				return errTooLong
+			}
+			return nil
+		}
+	case "required":
+		return func(s string) error {
+			if s == "" {
+				return errRequired
+			}
+			return nil
+		}
+	}
+	return nil
+}
+
+func lettersFrom(base rune) hegel.Generator[rune] {
+	return hegel.Map(zootest.Ints(0, 25), func(i int) rune { return base + rune(i) })
+}
+
+// runesOf: a letter one time in two, else a space, a wide rune (at the weight
+// given), a capital, a digit or mark, an accented letter (the old ladder's shares).
+func runesOf(wide int) hegel.Generator[rune] {
+	return zootest.Weighted(
+		zootest.W(50, letters),
+		zootest.W(15, hegel.Just(' ')),
+		zootest.W(wide, wideRunes),
+		zootest.W(10, capitals),
+		zootest.W(8, marks),
+		zootest.W(7, accents),
+	)
+}
+
+// textsOf: lo to hi runes as a string.
+func textsOf(rs hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(zootest.Counted(rs, lo, hi), func(rs []rune) string { return string(rs) })
+}
+
+var (
+	prompts   = zootest.Sampled("> ", "", "Name: ", "\u2192 ")
+	letters   = lettersFrom('a')
+	capitals  = lettersFrom('A')
+	wideRunes = zootest.Sampled('\u65e5', '\u672c', '\u8a9e', '\u6f22', '\u5b57')
+	marks     = zootest.Sampled([]rune("0123456789.,-_/")...)
+	accents   = zootest.Sampled('\u00e9', '\u00fc', '\u00f1')
+
+	runes       = runesOf(10)
+	narrowRunes = runesOf(0)
+	texts       = textsOf(runes, 0, 14)
+	// pasteRunes: a tab, a newline or a carriage return one time in ten, as a paste
+	// brings them.
+	pasteRunes = zootest.Weighted(zootest.W(9, runes), zootest.W(1, zootest.Sampled('\t', '\n', '\r')))
+	pastes     = textsOf(pasteRunes, 0, 8)
+
+	validators = zootest.Weighted(
+		zootest.W(1, hegel.Just(validator{kind: "none"})),
+		zootest.W(1, hegel.Map(zootest.Ints(1, 6), func(k int) validator { return validator{kind: "max", k: k} })),
+		zootest.W(1, hegel.Just(validator{kind: "required"})),
+	)
+	// echos: normal seven times in ten, password two, none one; EchoNone is never
+	// drawn under HEGEL_NO_KNOWN=1 (every non-empty value in a field with a width is
+	// bubbles/12's shape).
+	echos = zootest.Weighted(
+		zootest.W(7, hegel.Just(EchoNormal)),
+		zootest.W(2, hegel.Just(EchoPassword)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(EchoNone)),
+	)
+
+	// widths: a width of 1 to 12 three times in five; limits: a CharLimit of 1 to 8
+	// three times in ten; initials: a SetValue of up to 14 runes seven times in ten.
+	widths   = zootest.Maybe(60, zootest.Ints(1, 12))
+	limits   = zootest.Maybe(30, zootest.Ints(1, 8))
+	initials = zootest.Maybe(70, hegel.Map(texts, func(s string) initial { return initial{set: true, s: s} }))
+	starts   = startsOf(widths, limits, validators, echos, initials)
+
+	// motions: the cursor keys drawn as one alternative, as the old property had them.
+	motions = hegel.Map(zootest.Sampled("home", "end", "alt+b", "alt+f"), func(k string) inputOp { return inputOp{kind: k} })
+	editOps = editOpsOf(runes, pastes, texts)
+
+	// editCases: a start and one to forty operations; under HEGEL_NO_KNOWN=1 the
+	// operations that would reach a recorded bug are left out (unshaped).
+	editCases = hegel.Map(casesOf(starts, zootest.Counted(editOps, 1, 40)), unshaped)
+)
+
+// initial is the SetValue before the operations, if any.
+type initial struct {
+	set bool
+	s   string
+}
+
+// inputStart is the input a case starts from.
+type inputStart struct {
+	prompt   string
+	width    int // 0 for none
+	limit    int // 0 for none
+	validate validator
+	echo     EchoMode
+	value    initial
+}
+
+func (s inputStart) String() string {
+	parts := []string{fmt.Sprintf("prompt %q", s.prompt)}
+	if s.width > 0 {
+		parts = append(parts, fmt.Sprintf("width %d", s.width))
+	}
+	if s.limit > 0 {
+		parts = append(parts, fmt.Sprintf("limit %d", s.limit))
+	}
+	if s.validate.kind != "none" {
+		parts = append(parts, "validate "+s.validate.String())
+	}
+	switch s.echo {
+	case EchoPassword:
+		parts = append(parts, "EchoPassword")
+	case EchoNone:
+		parts = append(parts, "EchoNone")
+	}
+	if s.value.set {
+		parts = append(parts, fmt.Sprintf("SetValue(%q)", s.value.s))
+	}
+	return strings.Join(parts, " ")
+}
+
+// build makes the focused input and the model of the start.
+func (s inputStart) build() (Model, *editModel) {
+	m := New()
+	m.Focus()
+	m.Prompt = s.prompt
+	if s.width > 0 {
+		m.SetWidth(s.width)
+	}
+	e := &editModel{limit: s.limit, validate: s.validate.fn(), echo: s.echo}
+	m.CharLimit = s.limit
+	m.Validate = e.validate
+	m.EchoMode = s.echo
+	if s.value.set {
+		m.SetValue(s.value.s)
+		e.setValue(s.value.s)
+	}
+	return m, e
+}
+
+// startsOf: a start from the generators of its parts (the prompt from the table).
+func startsOf(widths, limits hegel.Generator[int], validators hegel.Generator[validator], echos hegel.Generator[EchoMode], values hegel.Generator[initial]) hegel.Generator[inputStart] {
+	return hegel.Composite(func(tc hegel.TestCase) inputStart {
+		return inputStart{
+			prompt:   hegel.Draw(tc, prompts),
+			width:    hegel.Draw(tc, widths),
+			limit:    hegel.Draw(tc, limits),
+			validate: hegel.Draw(tc, validators),
+			echo:     hegel.Draw(tc, echos),
+			value:    hegel.Draw(tc, values),
+		}
+	})
+}
+
+// inputOp is one operation: a typed rune, a key of the default key map, a paste,
+// SetValue, SetCursor (the position clamped by the library), Reset or SetWidth.
+type inputOp struct {
+	kind string
+	r    rune   // type
+	s    string // paste, setvalue
+	n    int    // setcursor, setwidth
+}
+
+func (o inputOp) GoString() string {
+	switch o.kind {
+	case "type":
+		return fmt.Sprintf("type %q", o.r)
+	case "paste":
+		return fmt.Sprintf("paste %q", o.s)
+	case "setvalue":
+		return fmt.Sprintf("SetValue(%q)", o.s)
+	case "setcursor":
+		return fmt.Sprintf("SetCursor(%d)", o.n)
+	case "setwidth":
+		return fmt.Sprintf("SetWidth(%d)", o.n)
+	}
+	return o.kind
+}
+
+func opOf(kind string) hegel.Generator[inputOp] { return hegel.Just(inputOp{kind: kind}) }
+
+func typeOp(rs hegel.Generator[rune]) hegel.Generator[inputOp] {
+	return hegel.Map(rs, func(r rune) inputOp { return inputOp{kind: "type", r: r} })
+}
+
+func pasteOp(texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return hegel.Map(texts, func(s string) inputOp { return inputOp{kind: "paste", s: s} })
+}
+
+func setValueOp(texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return hegel.Map(texts, func(s string) inputOp { return inputOp{kind: "setvalue", s: s} })
+}
+
+func setCursorOp(positions hegel.Generator[int]) hegel.Generator[inputOp] {
+	return hegel.Map(positions, func(p int) inputOp { return inputOp{kind: "setcursor", n: p} })
+}
+
+func setWidthOp(widths hegel.Generator[int]) hegel.Generator[inputOp] {
+	return hegel.Map(widths, func(w int) inputOp { return inputOp{kind: "setwidth", n: w} })
+}
+
+// editOpsOf: the operations at the old property's weights (a typed rune five times
+// in nineteen, the rest once each, the cursor keys sharing one), plus SetWidth,
+// the usual order under a window-size message (bubbles/7's first shape).
+func editOpsOf(rs hegel.Generator[rune], pastes, texts hegel.Generator[string]) hegel.Generator[inputOp] {
+	return zootest.Weighted(
+		zootest.W(5, typeOp(rs)),
+		zootest.W(1, opOf("left")),
+		zootest.W(1, opOf("right")),
+		zootest.W(1, opOf("backspace")),
+		zootest.W(1, opOf("delete")),
+		zootest.W(1, opOf("ctrl+w")),
+		zootest.W(1, opOf("alt+d")),
+		zootest.W(1, opOf("ctrl+k")),
+		zootest.W(1, opOf("ctrl+u")),
+		zootest.W(1, motions),
+		zootest.W(1, pasteOp(pastes)),
+		zootest.W(1, setValueOp(texts)),
+		zootest.W(1, setCursorOp(zootest.Ints(-1, 16))),
+		zootest.W(1, opOf("reset")),
+		zootest.W(1, setWidthOp(zootest.Ints(1, 12))),
+	)
+}
+
+// inputCase is a start and the operations.
+type inputCase struct {
+	start inputStart
+	ops   []inputOp
+}
+
+func (c inputCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(ops, ", ")
+}
+
+// casesOf: a case from the start and the operations.
+func casesOf(starts hegel.Generator[inputStart], ops hegel.Generator[[]inputOp]) hegel.Generator[inputCase] {
+	return hegel.Composite(func(tc hegel.TestCase) inputCase {
+		return inputCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// unshaped is the case with, under HEGEL_NO_KNOWN=1, every operation that would
+// reach the shape of a recorded bug from the state the operations before it leave
+// (bubbles/1, 7, 9, 10, 11: relations between an operation and the live state,
+// the window's included) left out, a no-op the shrinker can delete: the library
+// and the model are replayed over the operations kept so far. By default the
+// case is drawn as it is.
+func unshaped(c inputCase) inputCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	var kept []inputOp
+	for _, op := range c.ops {
+		trial := append(kept[:len(kept):len(kept)], op)
+		if lastShape(c.start, trial) == "" {
+			kept = trial
+		}
+	}
+	return inputCase{start: c.start, ops: kept}
+}
+
+// lastShape replays the start and the operations and names the shape the last
+// operation has (before it, stepShape; after it, the view's).
+func lastShape(start inputStart, ops []inputOp) string {
+	m, e := start.build()
+	for _, op := range ops[:len(ops)-1] {
+		apply(&m, e, op)
+	}
+	last := ops[len(ops)-1]
+	if s := stepShape(e, last); s != "" {
+		return s
+	}
+	apply(&m, e, last)
+	return viewShape(m)
+}
+
+// ---------------------------------------------------------------- the model
+
+type editModel struct {
+	value    []rune
+	pos      int
+	limit    int
+	err      error
+	validate ValidateFunc
+	echo     EchoMode
+}
+
+// sanitize is what the input sanitizer does: tabs and newline characters
+// become single spaces, one each.
+func sanitize(rs []rune) []rune {
+	out := make([]rune, 0, len(rs))
+	for _, r := range rs {
+		if r == '\t' || r == '\n' || r == '\r' {
+			r = ' '
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+func (e *editModel) check(v []rune) error {
+	if e.validate != nil {
+		return e.validate(string(v))
+	}
+	return nil
+}
+
+func (e *editModel) setValue(s string) {
+	rs := sanitize([]rune(s))
+	e.err = e.check(rs)
+	empty := len(e.value) == 0
+	if e.limit > 0 && len(rs) > e.limit {
+		rs = rs[:e.limit]
+	}
+	e.value = rs
+	if (e.pos == 0 && empty) || e.pos > len(e.value) {
+		e.pos = len(e.value)
+	}
+}
+
+func (e *editModel) insert(rs []rune) {
+	rs = sanitize(rs)
+	if e.limit > 0 {
+		avail := e.limit - len(e.value)
+		if avail <= 0 {
+			return
+		}
+		if len(rs) > avail {
+			rs = rs[:avail]
+		}
+	}
+	v := make([]rune, 0, len(e.value)+len(rs))
+	v = append(v, e.value[:e.pos]...)
+	v = append(v, rs...)
+	v = append(v, e.value[e.pos:]...)
+	empty := len(e.value) == 0
+	e.pos += len(rs)
+	e.err = e.check(v)
+	e.value = v
+	if (e.pos == 0 && empty) || e.pos > len(v) {
+		e.pos = len(v)
+	}
+}
+
+func (e *editModel) cut(from, to int) {
+	v := make([]rune, 0, len(e.value))
+	v = append(v, e.value[:from]...)
+	v = append(v, e.value[to:]...)
+	e.value = v
+	e.err = e.check(v)
+}
+
+func isSpace(r rune) bool { return unicode.IsSpace(r) }
+
+func (e *editModel) clamp(p int) int {
+	return max(0, min(p, len(e.value)))
+}
+
+// wordStart is where a backward word motion from pos ends: past any spaces,
+// then past the word.
+func (e *editModel) wordStart() int {
+	s := e.pos
+	for s > 0 && isSpace(e.value[s-1]) {
+		s--
+	}
+	for s > 0 && !isSpace(e.value[s-1]) {
+		s--
+	}
+	return s
+}
+
+// wordEnd is where a forward word motion from pos ends.
+func (e *editModel) wordEnd() int {
+	t := e.pos
+	for t < len(e.value) && isSpace(e.value[t]) {
+		t++
+	}
+	for t < len(e.value) && !isSpace(e.value[t]) {
+		t++
+	}
+	return t
+}
+
+// stepShape names the recorded bug whose shape the operation has in the state
+// before it: a backspace on an empty value the validator rejects, which the
+// library clears Err for without asking it (bubbles/9); ctrl+w on a word that
+// begins at index 1 after a space, which goes with the word (bubbles/10); alt+d
+// with the cursor on the last rune (a panic) or on the last rune of a word, which
+// deleteWordForward steps over before it looks for the word (bubbles/1).
+func stepShape(e *editModel, op inputOp) string {
+	switch op.kind {
+	case "backspace":
+		if len(e.value) == 0 && e.check(nil) != nil {
+			return "bubbles/9"
+		}
+	case "ctrl+w":
+		if e.echo == EchoNormal && e.pos > 0 && e.wordStart() == 1 {
+			return "bubbles/10"
+		}
+	case "alt+d":
+		if e.echo == EchoNormal && e.pos < len(e.value) &&
+			(e.pos+1 == len(e.value) || !isSpace(e.value[e.pos]) && isSpace(e.value[e.pos+1])) {
+			return "bubbles/1"
+		}
+	}
+	return ""
+}
+
+// apply performs the operation on the input and on the model: word motions go
+// past spaces and then past the word (to the ends in the masked modes), the
+// deletions revalidate, SetValue validates before the limit cuts, an insertion at
+// the limit leaves Err alone.
+func apply(m *Model, e *editModel, op inputOp) {
+	switch op.kind {
+	case "type":
+		*m = press(*m, typed(op.r))
+		e.insert([]rune{op.r})
+	case "left":
+		*m = press(*m, kLeft)
+		if e.pos > 0 {
+			e.pos--
+		}
+	case "right":
+		*m = press(*m, kRight)
+		if e.pos < len(e.value) {
+			e.pos++
+		}
+	case "backspace":
+		*m = press(*m, kBackspace)
+		if len(e.value) > 0 && e.pos > 0 {
+			e.cut(e.pos-1, e.pos)
+			e.pos--
+		} else {
+			e.err = e.check(e.value)
+		}
+	case "delete":
+		*m = press(*m, kDelete)
+		if e.pos < len(e.value) {
+			e.cut(e.pos, e.pos+1)
+		}
+	case "ctrl+w":
+		*m = press(*m, kDelWordBack)
+		if e.pos > 0 && len(e.value) > 0 {
+			s := 0
+			if e.echo == EchoNormal {
+				s = e.wordStart()
+			}
+			e.cut(s, e.pos)
+			e.pos = s
+		}
+	case "alt+d":
+		*m = press(*m, kDelWordFwd)
+		if e.pos < len(e.value) {
+			t := len(e.value)
+			if e.echo == EchoNormal {
+				t = e.wordEnd()
+			}
+			e.cut(e.pos, t)
+		}
+	case "ctrl+k":
+		*m = press(*m, kKill)
+		e.cut(e.pos, len(e.value))
+	case "ctrl+u":
+		*m = press(*m, kKillBack)
+		e.cut(0, e.pos)
+		e.pos = 0
+	case "home":
+		*m = press(*m, kHome)
+		e.pos = 0
+	case "end":
+		*m = press(*m, kEnd)
+		e.pos = len(e.value)
+	case "alt+b":
+		*m = press(*m, kWordBack)
+		if e.pos > 0 && len(e.value) > 0 {
+			s := 0
+			if e.echo == EchoNormal {
+				s = e.wordStart()
+			}
+			e.pos = s
+		}
+	case "alt+f":
+		*m = press(*m, kWordFwd)
+		if e.pos < len(e.value) {
+			t := len(e.value)
+			if e.echo == EchoNormal {
+				t = e.wordEnd()
+			}
+			e.pos = t
+		}
+	case "paste":
+		*m = press(*m, tea.PasteMsg{Content: op.s})
+		e.insert([]rune(op.s))
+	case "setvalue":
+		m.SetValue(op.s)
+		e.setValue(op.s)
+	case "setcursor":
+		m.SetCursor(op.n)
+		e.pos = e.clamp(op.n)
+	case "reset":
+		m.Reset()
+		e.value = nil
+		e.pos = 0
+	case "setwidth":
+		m.SetWidth(op.n)
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// ---------------------------------------------------------------- views
+
+func echo(m Model, s string) string {
+	switch m.EchoMode {
+	case EchoPassword:
+		return strings.Repeat(string(m.EchoCharacter), uniseg.StringWidth(s))
+	case EchoNone:
+		return ""
+	}
+	return s
+}
+
+func spaces(k int) string {
+	if k <= 0 {
+		return ""
+	}
+	return strings.Repeat(" ", k)
+}
+
+// viewShape names the recorded bug whose shape the view has: with EchoNone a
+// non-empty value in a field with a width, whose padding the library computes from
+// the hidden value (bubbles/12); a window wider than the field, which the library
+// re-fits only when the cursor crosses an edge (bubbles/7); the cursor at the
+// window's end with the rune under it past the window, where the library draws a
+// blank (bubbles/11).
+func viewShape(m Model) string {
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		return ""
+	}
+	if m.EchoMode == EchoNone {
+		switch {
+		case len(value) > 0 && m.Width() > 0:
+			return "bubbles/12"
+		case pos < len(value):
+			// the cursor cell is the echo of the rune under it, nothing (with a
+			// width the field is wrong by bubbles/12 first).
+			return "bubbles/98"
+		}
+		return ""
+	}
+	window := uniseg.StringWidth(echo(m, string(value[off:right])))
+	if pos == right {
+		window++
+	}
+	switch {
+	case m.Width() > 0 && window > m.Width()+1:
+		return "bubbles/7"
+	case pos == right && pos < len(value):
+		return "bubbles/11"
+	}
+	return ""
+}
+
+// checkView compares View with the model: the window the library keeps (offset,
+// offsetRight) holds the cursor and is never wider than the field; the text is
+// the prompt, the echoed window with the rune under the cursor shown (a blank
+// past the end of the value) and the padding to Width+1 cells; the cursor is one
+// reversed run at the cursor's column, as wide as the rune under it. With
+// EchoNone nothing of the value is echoed: a blank cursor cell and the padding.
+func checkView(j *zootest.Judge, m Model, what string) {
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		j.Fail("%s: window [%d,%d) does not hold the cursor %d in a value of %d runes", what, off, right, pos, len(value))
+	}
+	if m.Width() <= 0 && (off != 0 || right != len(value)) {
+		j.Fail("%s: no width, but the window is [%d,%d) of %d runes", what, off, right, len(value))
+	}
+	j.Shape(viewShape(m))
+	var before, cursorChar, after string
+	if m.EchoMode == EchoNone {
+		// A blank cursor cell wherever the cursor is (the library echoes the rune
+		// under it, nothing, inside the value: bubbles/98).
+		cursorChar = " "
+	} else {
+		before = echo(m, string(value[off:pos]))
+		cursorChar = " "
+		if pos < len(value) {
+			cursorChar = echo(m, string(value[pos]))
+		}
+		if pos < right {
+			after = echo(m, string(value[pos+1:right]))
+		}
+		window := uniseg.StringWidth(echo(m, string(value[off:right])))
+		if pos == right {
+			window++
+		}
+		if m.Width() > 0 && window > m.Width()+1 {
+			j.Fail("%s: the window [%d,%d) shows %d cells in a field of %d (width %d, cursor %d)\nview %s", what, off, right, window, m.Width()+1, m.Width(), pos, zootest.String(zootest.Cells(m.View())))
+		}
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	shown := uniseg.StringWidth(before) + uniseg.StringWidth(cursorChar) + uniseg.StringWidth(after)
+	want := m.Prompt + before + cursorChar + after
+	if m.Width() > 0 {
+		want += spaces(m.Width() + 1 - shown)
+	}
+	if got := zootest.Plain(cells); got != want {
+		j.Fail("%s: view text %q, want %q (window [%d,%d) cursor %d width %d)\nview %s", what, got, want, off, right, pos, m.Width(), zootest.String(cells))
+	}
+	// The cursor: one reversed run at the cursor's column.
+	col := promptW + uniseg.StringWidth(before)
+	x, start, revW := 0, -1, 0
+	for _, c := range cells {
+		if c.Rev {
+			if start < 0 {
+				start = x
+			} else if revW != x-start {
+				j.Fail("%s: reversed cells are not one run\nview %s", what, zootest.String(cells))
+			}
+			revW += c.W
+		}
+		x += c.W
+	}
+	if start != col || revW != uniseg.StringWidth(cursorChar) {
+		j.Fail("%s: the cursor run is at column %d, %d wide; want column %d, %d wide (%q)\nview %s", what, start, revW, col, uniseg.StringWidth(cursorChar), cursorChar, zootest.String(cells))
+	}
+}
+
+// judgeEditing drives the input through the case and checks Value, Position, Err
+// and the view against the model after every operation; the wide and the narrow
+// properties share it.
+func judgeEditing(j *zootest.Judge, c inputCase) {
+	m, e := c.start.build()
+	for _, op := range c.ops {
+		j.Shape(stepShape(e, op))
+		apply(&m, e, op)
+		what := "after " + op.GoString()
+		j.Note("%s -> %q pos %d", op.GoString(), m.Value(), m.Position())
+		if m.Value() != string(e.value) {
+			j.Fail("%s: value %q, want %q", what, m.Value(), string(e.value))
+		}
+		if m.Position() != e.pos {
+			j.Fail("%s: cursor at %d, want %d (value %q)", what, m.Position(), e.pos, m.Value())
+		}
+		if errString(m.Err) != errString(e.err) {
+			j.Fail("%s: Err %v, want %v (value %q, validator %s)", what, m.Err, e.err, m.Value(), c.start.validate)
+		}
+		checkView(j, m, what)
+	}
+}
+
+// ---------------------------------------------------------------- properties
+
+// TestHegelEditingFollowsTheModel: every key of the default key map, pastes,
+// SetValue, SetCursor, SetWidth and Reset against the rune-slice model; Value,
+// Position, Err and the View after each step.
+func TestHegelEditingFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeEditing(j, c)
+	})
+}
+
+// placeholderCase: a focused or blurred input with a placeholder and a width (0
+// for none, negative as a window-size handler may compute it).
+type placeholderCase struct {
+	focused     bool
+	prompt      string
+	placeholder string
+	width       int
+}
+
+func (c placeholderCase) GoString() string {
+	focus := "blurred"
+	if c.focused {
+		focus = "focused"
+	}
+	return fmt.Sprintf("%s, prompt %q, placeholder %q, width %d", focus, c.prompt, c.placeholder, c.width)
+}
+
+var (
+	asciiRunes = zootest.Sampled([]rune("abcdefghij .,")...)
+	// placeholderRunes: ASCII three times in five, else any rune; the wide ones never
+	// under HEGEL_NO_KNOWN=1 (bubbles/3).
+	placeholderRunes = zootest.Weighted(zootest.W(6, asciiRunes), zootest.W(4, runesOf(zootest.Unless(zootest.NoKnown, 10))))
+	placeholders     = textsOf(placeholderRunes, 1, 20)
+	// placeholderWidths: 1 to 24, or none (bubbles/2) or negative (bubbles/4), each
+	// one time in 26 as the old draw had them; neither under HEGEL_NO_KNOWN=1.
+	placeholderWidths = zootest.Weighted(
+		zootest.W(24, zootest.Ints(1, 24)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(0)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(-1)),
+	)
+	placeholderCases = placeholderCasesOf(placeholders, placeholderWidths)
+)
+
+// placeholderCasesOf: a case from the placeholder and the width.
+func placeholderCasesOf(placeholders hegel.Generator[string], widths hegel.Generator[int]) hegel.Generator[placeholderCase] {
+	return hegel.Composite(func(tc hegel.TestCase) placeholderCase {
+		return placeholderCase{
+			focused:     hegel.Draw(tc, zootest.Coin(50)),
+			prompt:      hegel.Draw(tc, zootest.Sampled("> ", "", "Name: ")),
+			placeholder: hegel.Draw(tc, placeholders),
+			width:       hegel.Draw(tc, widths),
+		}
+	})
+}
+
+func hasWide(rs []rune) bool {
+	for _, r := range rs {
+		if uniseg.StringWidth(string(r)) != 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// placeholderShape names the recorded bug whose shape the case has: a negative
+// width, which View panics on (bubbles/4); no width with more than one rune, cut
+// to the first (bubbles/2); a wide rune among the runes a field of the width
+// shows, sliced by display width (bubbles/3).
+func placeholderShape(c placeholderCase) string {
+	rs := []rune(c.placeholder)
+	switch {
+	case c.width < 0:
+		return "bubbles/4"
+	case c.width == 0 && len(rs) > 1:
+		return "bubbles/2"
+	case c.width > 0 && hasWide(rs[:min(len(rs), c.width+1)]):
+		return "bubbles/3"
+	}
+	return ""
+}
+
+// fit cuts s to the graphemes that fit in width cells (a wide rune that does not
+// fit is dropped).
+func fit(s string, width int) string {
+	var sb strings.Builder
+	w := 0
+	g := uniseg.NewGraphemes(s)
+	for g.Next() {
+		if w+g.Width() > width {
+			break
+		}
+		w += g.Width()
+		sb.WriteString(g.Str())
+	}
+	return sb.String()
+}
+
+// judgePlaceholder checks the placeholder view: the placeholder cut to the field's
+// Width+1 cells and padded to it (whole without a width, a width of 0 or less
+// being ignored as documented), the cursor on its first cell when focused.
+func judgePlaceholder(j *zootest.Judge, c placeholderCase) {
+	j.Shape(placeholderShape(c))
+	m := New()
+	if c.focused {
+		m.Focus()
+	}
+	m.Prompt = c.prompt
+	m.Placeholder = c.placeholder
+	if c.width != 0 {
+		m.SetWidth(c.width)
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	text := c.placeholder
+	if c.width > 0 {
+		text = fit(c.placeholder, c.width+1)
+	}
+	want := m.Prompt + text
+	if c.width > 0 {
+		want += spaces(c.width + 1 - uniseg.StringWidth(text))
+	}
+	if got := zootest.Plain(cells); got != want {
+		j.Fail("placeholder view %q, want %q\n%s", got, want, zootest.String(cells))
+	}
+	if strings.Contains(zootest.Plain(cells), "\x00") {
+		j.Fail("placeholder view contains NUL: %q", zootest.Plain(cells))
+	}
+	for i, cell := range cells {
+		if cell.Rev != (m.Focused() && i == promptW) {
+			j.Fail("the cursor is not exactly on the first placeholder cell (focused %v)\n%s", m.Focused(), zootest.String(cells))
+		}
+	}
+}
+
+// TestHegelPlaceholderFillsTheField: with no value the field shows the
+// placeholder, cut to the width and padded to width+1, cursor on its first
+// cell.
+func TestHegelPlaceholderFillsTheField(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, placeholderCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgePlaceholder(j, c)
+	})
+}
+
+// suggestion model: the value with its cursor (SetValue keeps the cursor where it
+// was in a non-empty value, so a later typed rune lands there), the suggestions,
+// the matches and the index.
+type sugModel struct {
+	value   []rune
+	pos     int
+	sugs    []string
+	matched []string
+	idx     int
+}
+
+// matches is the case-insensitive prefix matches of a value (none for an empty
+// value).
+func (s *sugModel) matches(value string) []string {
+	if value == "" {
+		return nil
+	}
+	var matched []string
+	for _, x := range s.sugs {
+		if strings.HasPrefix(strings.ToLower(x), strings.ToLower(value)) {
+			matched = append(matched, x)
+		}
+	}
+	return matched
+}
+
+func (s *sugModel) update() {
+	if len(s.value) == 0 || len(s.sugs) == 0 {
+		// Nothing matches an empty value; the index is left as it was
+		// (it is reset the next time the matches change).
+		s.matched = nil
+		return
+	}
+	matched := s.matches(string(s.value))
+	if !equalStrings(matched, s.matched) {
+		s.idx = 0
+	}
+	s.matched = matched
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// sugOp is one operation of the suggestion property: a typed rune, backspace,
+// down, up, tab, SetValue or Reset.
+type sugOp struct {
+	kind string
+	r    rune   // type
+	s    string // setvalue
+}
+
+func (o sugOp) GoString() string {
+	switch o.kind {
+	case "type":
+		return fmt.Sprintf("type %q", o.r)
+	case "setvalue":
+		return fmt.Sprintf("SetValue(%q)", o.s)
+	}
+	return o.kind
+}
+
+// sugCase: the suggestions and the operations.
+type sugCase struct {
+	sugs []string
+	ops  []sugOp
+}
+
+func (c sugCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("suggestions %q: %s", c.sugs, strings.Join(ops, ", "))
+}
+
+func sugOpOf(kind string) hegel.Generator[sugOp] { return hegel.Just(sugOp{kind: kind}) }
+
+func typeSug(rs hegel.Generator[rune]) hegel.Generator[sugOp] {
+	return hegel.Map(rs, func(r rune) sugOp { return sugOp{kind: "type", r: r} })
+}
+
+func setValueSug(texts hegel.Generator[string]) hegel.Generator[sugOp] {
+	return hegel.Map(texts, func(s string) sugOp { return sugOp{kind: "setvalue", s: s} })
+}
+
+var (
+	sugAlphabet = zootest.Sampled([]rune("abAB ")...)
+	sugWords    = textsOf(sugAlphabet, 1, 5)
+	sugLists    = zootest.Counted(sugWords, 0, 5)
+	// sugOps: the operations at the old property's weights: a typed rune four times
+	// in ten, backspace, down and up once, tab twice, SetValue or Reset once
+	// (bubbles/5's shape when the matches change).
+	sugOps = zootest.Weighted(
+		zootest.W(4, typeSug(sugAlphabet)),
+		zootest.W(1, sugOpOf("backspace")),
+		zootest.W(1, sugOpOf("down")),
+		zootest.W(1, sugOpOf("up")),
+		zootest.W(2, sugOpOf("tab")),
+		zootest.W(1, zootest.Weighted(zootest.W(1, setValueSug(sugWords)), zootest.W(1, sugOpOf("reset")))),
+	)
+	// sugCases: none to five suggestions and one to twenty-five operations; under
+	// HEGEL_NO_KNOWN=1 the operations that would reach a recorded bug are left out.
+	sugCases = hegel.Map(sugCasesOf(sugLists, zootest.Counted(sugOps, 1, 25)), unshapedSug)
+)
+
+// sugCasesOf: a case from the suggestions and the operations.
+func sugCasesOf(sugs hegel.Generator[[]string], ops hegel.Generator[[]sugOp]) hegel.Generator[sugCase] {
+	return hegel.Composite(func(tc hegel.TestCase) sugCase {
+		return sugCase{sugs: hegel.Draw(tc, sugs), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// sugShape names the recorded bug whose shape the operation has in the model's
+// state: up with nothing matched and the index at 0, which the library takes to
+// -1 (bubbles/6); SetValue or Reset to a value whose matches differ from the
+// current ones, which the library keeps (bubbles/5).
+func sugShape(s *sugModel, op sugOp) string {
+	switch op.kind {
+	case "up":
+		if len(s.matched) == 0 && s.idx == 0 {
+			return "bubbles/6"
+		}
+	case "setvalue", "reset":
+		if !equalStrings(s.matches(op.s), s.matched) {
+			return "bubbles/5"
+		}
+	}
+	return ""
+}
+
+// applySug performs the operation on the model (the library's part is in
+// judgeSuggestions): a rune is typed at the cursor, backspace deletes before it,
+// tab appends the current suggestion's remainder to the typed prefix and moves to
+// the end; up and down cycle within the matches, staying at 0 with none; SetValue
+// moves the cursor to the end only from an empty value or past the new end, Reset
+// to the start.
+func (s *sugModel) applySug(op sugOp) {
+	switch op.kind {
+	case "type":
+		s.value = slices.Insert(slices.Clone(s.value), s.pos, op.r)
+		s.pos++
+	case "backspace":
+		if s.pos > 0 {
+			s.value = slices.Delete(slices.Clone(s.value), s.pos-1, s.pos)
+			s.pos--
+		}
+	case "down":
+		s.idx++
+		if s.idx >= len(s.matched) {
+			s.idx = 0
+		}
+	case "up":
+		s.idx--
+		if s.idx < 0 {
+			s.idx = max(len(s.matched)-1, 0)
+		}
+	case "tab":
+		if len(s.matched) > 0 {
+			s.value = append(slices.Clone(s.value), []rune(s.matched[s.idx])[len(s.value):]...)
+			s.pos = len(s.value)
+		}
+	case "setvalue":
+		empty := len(s.value) == 0
+		s.value = []rune(op.s)
+		if (s.pos == 0 && empty) || s.pos > len(s.value) {
+			s.pos = len(s.value)
+		}
+	case "reset":
+		s.value, s.pos = nil, 0
+	}
+	s.update()
+}
+
+// unshapedSug is the case with, under HEGEL_NO_KNOWN=1, every operation that would
+// reach a recorded bug from the model's state left out (the model replayed); by
+// default the case as drawn.
+func unshapedSug(c sugCase) sugCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	s := &sugModel{sugs: c.sugs}
+	var kept []sugOp
+	for _, op := range c.ops {
+		if sugShape(s, op) != "" {
+			continue
+		}
+		s.applySug(op)
+		kept = append(kept, op)
+	}
+	return sugCase{sugs: c.sugs, ops: kept}
+}
+
+// judgeSuggestions drives the input through the case and checks the value, the
+// matched suggestions, the index, CurrentSuggestion and the view after every
+// operation.
+func judgeSuggestions(j *zootest.Judge, c sugCase) {
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	s := &sugModel{sugs: c.sugs}
+	m.SetSuggestions(s.sugs)
+	if got := m.AvailableSuggestions(); !equalStrings(got, s.sugs) {
+		j.Fail("AvailableSuggestions %q, want %q", got, s.sugs)
+	}
+	for _, op := range c.ops {
+		j.Shape(sugShape(s, op))
+		switch op.kind {
+		case "type":
+			m = press(m, typed(op.r))
+		case "backspace":
+			m = press(m, kBackspace)
+		case "down":
+			m = press(m, kDown)
+		case "up":
+			m = press(m, kUp)
+		case "tab":
+			m = press(m, kTab)
+		case "setvalue":
+			m.SetValue(op.s)
+		case "reset":
+			m.Reset()
+		}
+		s.applySug(op)
+		what := "after " + op.GoString()
+		j.Note("%s -> %q matched %q idx %d", op.GoString(), m.Value(), m.MatchedSuggestions(), m.CurrentSuggestionIndex())
+		if m.Value() != string(s.value) || m.Position() != s.pos {
+			j.Fail("%s: value %q at %d, want %q at %d", what, m.Value(), m.Position(), string(s.value), s.pos)
+		}
+		if got := m.MatchedSuggestions(); !equalStrings(got, s.matched) {
+			j.Fail("%s: matched %q, want %q (value %q of %q)", what, got, s.matched, string(s.value), s.sugs)
+		}
+		if m.CurrentSuggestionIndex() != s.idx {
+			j.Fail("%s: suggestion index %d, want %d (matched %q)", what, m.CurrentSuggestionIndex(), s.idx, s.matched)
+		}
+		wantCur := ""
+		if s.idx < len(s.matched) {
+			wantCur = s.matched[s.idx]
+		}
+		if got := m.CurrentSuggestion(); got != wantCur {
+			j.Fail("%s: CurrentSuggestion %q, want %q", what, got, wantCur)
+		}
+		// The view: the value, then the rest of the current suggestion, or the
+		// blank cursor cell when the cursor is at the end.
+		plain := zootest.Plain(zootest.Cells(m.View()))
+		want := m.Prompt + string(s.value)
+		if len(s.matched) > 0 && len([]rune(wantCur)) > len(s.value) {
+			want += string([]rune(wantCur)[len(s.value):])
+		} else if s.pos == len(s.value) {
+			want += " "
+		}
+		if plain != want {
+			j.Fail("%s: view %q, want %q (matched %q idx %d)", what, plain, want, s.matched, s.idx)
+		}
+	}
+}
+
+// TestHegelSuggestionsFollowThePrefix: the matched suggestions are those
+// with the value as a case-insensitive prefix; up/down cycle, tab completes,
+// the view shows the completion after the cursor.
+func TestHegelSuggestionsFollowThePrefix(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sugCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeSuggestions(j, c)
+	})
+}
+
+// cursorCase: a prompt, a width (0 for none), a value and the SetCursor
+// positions, each taken modulo the value's length plus one.
+type cursorCase struct {
+	prompt  string
+	width   int
+	value   string
+	cursors []int
+}
+
+func (c cursorCase) GoString() string {
+	return fmt.Sprintf("prompt %q width %d value %q SetCursor %v", c.prompt, c.width, c.value, c.cursors)
+}
+
+var (
+	cursorWidths = zootest.Maybe(70, zootest.Ints(1, 10))
+	// cursorRunes: the wide runes never under HEGEL_NO_KNOWN=1 (a wide rune before the
+	// cursor is bubbles/8's shape).
+	cursorRunes = runesOf(zootest.Unless(zootest.NoKnown, 10))
+	// cursorCases: a width seven times in ten, a value of up to 14 runes (under
+	// HEGEL_NO_KNOWN=1 no longer than the width, so that the window never scrolls:
+	// bubbles/8's other shape) and up to four SetCursor positions.
+	cursorCases = hegel.FlatMap(cursorWidths, func(w int) hegel.Generator[cursorCase] {
+		hi := 14
+		if zootest.NoKnown && w > 0 {
+			hi = min(hi, w)
+		}
+		return cursorCasesOf(hegel.Just(w), zootest.Counted(cursorRunes, 0, hi), zootest.Counted(zootest.Ints(0, 14), 0, 4))
+	})
+)
+
+// cursorCasesOf: a case from the width, the value's runes and the positions.
+func cursorCasesOf(widths hegel.Generator[int], values hegel.Generator[[]rune], positions hegel.Generator[[]int]) hegel.Generator[cursorCase] {
+	return hegel.Composite(func(tc hegel.TestCase) cursorCase {
+		return cursorCase{
+			prompt:  hegel.Draw(tc, zootest.Sampled("> ", "", "Name: ")),
+			width:   hegel.Draw(tc, widths),
+			value:   string(hegel.Draw(tc, values)),
+			cursors: hegel.Draw(tc, positions),
+		}
+	})
+}
+
+// cursorShape names bubbles/8's shape: Cursor() puts the real cursor at the prompt
+// width plus the rune index, capped at the width, which is not the column of the
+// view's cursor once the window has scrolled or a wide rune precedes the cursor.
+func cursorShape(m Model) string {
+	x := m.pos
+	if m.Width() > 0 {
+		x = min(x, m.Width())
+	}
+	if x != uniseg.StringWidth(string(m.value[m.offset:m.pos])) {
+		return "bubbles/8"
+	}
+	return ""
+}
+
+// judgeCursor sets the value and the cursor, checks the view and then that the real
+// cursor sits at the column where the view draws the virtual one.
+func judgeCursor(j *zootest.Judge, c cursorCase) {
+	m := New()
+	m.Focus()
+	m.Prompt = c.prompt
+	if c.width > 0 {
+		m.SetWidth(c.width)
+	}
+	m.SetValue(c.value)
+	for _, p := range c.cursors {
+		m.SetCursor(p % (len(m.value) + 1))
+	}
+	j.Note("pos %d window [%d,%d)", m.pos, m.offset, m.offsetRight)
+	checkView(j, m, "virtual cursor")
+	j.Shape(cursorShape(m))
+	want := lipgloss.Width(m.Prompt) + uniseg.StringWidth(string(m.value[m.offset:m.pos]))
+	m.SetVirtualCursor(false)
+	cur := m.Cursor()
+	if cur == nil {
+		j.Fail("Cursor() is nil for a focused input without a virtual cursor")
+	}
+	if cur.Position.Y != 0 {
+		j.Fail("Cursor() row %d, want 0", cur.Position.Y)
+	}
+	if cur.Position.X != want {
+		j.Fail("Cursor() at column %d, want %d (value %q pos %d window [%d,%d) width %d)", cur.Position.X, want, m.Value(), m.pos, m.offset, m.offsetRight, m.Width())
+	}
+}
+
+// TestHegelRealCursorSitsUnderTheVirtualOne: with the virtual cursor off,
+// Cursor() reports the column where View draws the cursor.
+func TestHegelRealCursorSitsUnderTheVirtualOne(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cursorCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/1: deleteWordForward moves past the rune under the cursor before it
+// looks for the word: at the last rune it indexes past the value.
+func TestHegelPinDeleteWordForwardStartsOneRuneTooFar(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("ab c")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a c" {
+		t.Fatalf("alt+d at a|b c gives %q, want %q", m.Value(), "a c")
+	}
+	m = New()
+	m.Focus()
+	m.SetValue("ab")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a" {
+		t.Fatalf("alt+d at a|b gives %q, want %q", m.Value(), "a")
+	}
+}
+
+// bubbles/2: without a width the placeholder is cut to its first rune.
+func TestHegelPinPlaceholderIsCutToOneRuneWithoutWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	if got := zootest.Plain(zootest.Cells(m.View())); got != "> Hello" {
+		t.Fatalf("View with placeholder %q and no width shows %q, want %q", m.Placeholder, got, "> Hello")
+	}
+}
+
+// bubbles/3: the placeholder is sliced by its display width as if it were a
+// rune count: NUL runes appear after wide characters, and a wide placeholder
+// overflows the width.
+func TestHegelPinPlaceholderIsSlicedByDisplayWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "输入消息..."
+	m.SetWidth(20)
+	v := m.View()
+	if strings.Contains(v, "\x00") {
+		t.Fatalf("View with placeholder %q width 20 contains NUL runes: %q", m.Placeholder, v)
+	}
+	m.Placeholder = "输入消息"
+	m.SetWidth(3)
+	if w := lipgloss.Width(m.View()); w > 2+4 {
+		t.Fatalf("View with placeholder %q width 3 is %d cells wide, want at most %d: %q", m.Placeholder, w, 2+4, m.View())
+	}
+}
+
+// bubbles/4: a negative width (documented as ignored) with a placeholder
+// panics in View.
+func TestHegelPinNegativeWidthPlaceholderPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	m.SetWidth(-1)
+	_ = m.View()
+}
+
+// bubbles/5: SetValue and Reset keep the matched suggestions of the previous
+// value; tab then completes the wrong text, or panics when the value is
+// longer than the stale suggestion.
+func TestHegelPinSetValueKeepsStaleSuggestions(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("zzz")
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("after SetValue(%q) the current suggestion is %q, want none", "zzz", got)
+	}
+	m = press(m, kTab)
+	if m.Value() != "zzz" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "zzz", m.Value())
+	}
+	m = New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("apple pie")
+	m = press(m, kTab)
+	if m.Value() != "apple pie" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "apple pie", m.Value())
+	}
+}
+
+// bubbles/6: up with no matched suggestion sets the index to -1 and
+// CurrentSuggestion panics.
+func TestHegelPinPrevSuggestionWithoutMatchesPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, kUp)
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("CurrentSuggestion %q, want none", got)
+	}
+	if i := m.CurrentSuggestionIndex(); i < 0 {
+		t.Fatalf("CurrentSuggestionIndex %d", i)
+	}
+}
+
+// bubbles/7: SetWidth after the value is set does not scroll the window; the
+// whole value stays visible until the cursor crosses an edge.
+func TestHegelPinSetWidthDoesNotScrollTheView(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("abcdefghij")
+	m.SetCursor(3)
+	m.SetWidth(5)
+	if w := lipgloss.Width(m.View()); w != 2+6 {
+		t.Fatalf("after SetWidth(5) the view is %d cells wide, want %d: %q", w, 2+6, m.View())
+	}
+}
+
+// bubbles/8: Cursor() places the real cursor at prompt + rune index, ignoring
+// the scrolled window and wide runes.
+func TestHegelPinRealCursorIgnoresTheScroll(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(5) // the window is [5,10): the cursor sits on the first visible cell
+	m.SetVirtualCursor(false)
+	if x := m.Cursor().Position.X; x != 2 {
+		t.Fatalf("Cursor() at column %d, want 2 (window [%d,%d), view %q)", x, m.offset, m.offsetRight, m.View())
+	}
+}
+
+// bubbles/9: backspace on an empty input clears Err without validating.
+func TestHegelPinBackspaceOnEmptyClearsErr(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.Validate = func(s string) error {
+		if s == "" {
+			return errRequired
+		}
+		return nil
+	}
+	m.SetValue("")
+	if m.Err == nil {
+		t.Fatalf("SetValue(\"\") did not set Err")
+	}
+	m = press(m, kBackspace)
+	if m.Err == nil {
+		t.Fatalf("backspace on the empty input cleared Err although the validator rejects \"\"")
+	}
+}
+
+// bubbles/10: ctrl+w on a word at the start of the input deletes the single
+// space before it as well.
+func TestHegelPinDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w at %q gives %q, want %q", " ab", m.Value(), " ")
+	}
+}
+
+// bubbles/11: scrolling forward, the window ends at the cursor: the rune under
+// it is not shown and the cursor is a blank at the right edge.
+func TestHegelPinForwardScrollHidesTheRuneUnderTheCursor(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(0)
+	for i := 0; i < 6; i++ {
+		m = press(m, kRight)
+	}
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev && c.S != "g" {
+			t.Fatalf("with the cursor on %q the view shows %s", "g", zootest.String(cells))
+		}
+	}
+}
+
+// bubbles/12: with EchoNone the padding is computed from the hidden value, so
+// the field shrinks as text is typed.
+func TestHegelPinEchoNonePadsByTheHiddenWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(3)
+	m.EchoMode = EchoNone
+	empty := lipgloss.Width(m.View())
+	m.SetValue("ab")
+	if w := lipgloss.Width(m.View()); w != empty {
+		t.Fatalf("EchoNone field is %d cells wide empty and %d with %q", empty, w, "ab")
+	}
+}
+
+// bubbles/98: with EchoNone the cursor vanishes while it is inside the value:
+// its cell is the echo of the rune under it, nothing.
+func TestHegelPinEchoNoneCursorVanishesInsideTheValue(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.EchoMode = EchoNone
+	m.SetValue("ab")
+	m.SetCursor(1)
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev {
+			return
+		}
+	}
+	t.Fatalf("EchoNone with the cursor inside %q shows no cursor: %s", "ab", zootest.String(cells))
+}
diff --git a/timer/hegel_shapes_test.go b/timer/hegel_shapes_test.go
new file mode 100644
index 0000000..6d093f9
--- /dev/null
+++ b/timer/hegel_shapes_test.go
@@ -0,0 +1,64 @@
+package timer
+
+// The shape regions of the recorded timer bugs (bugs.toml bubbles/92, 93) and the
+// narrow properties over them: each region is a generator over the bug's shape with
+// random contents, judged exactly like the wide property (judgeTimer). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (zootest.Shaped) and the property passes. Both
+// shapes are deterministic in the library (a tag never advanced, a subtraction never
+// clamped), so every instance reaches the bug (measured: 100 of 100 with math/rand
+// over the library).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// narrowTimer runs a narrow property: every drawn case through the wide property's
+// judge.
+func narrowTimer(t *testing.T, cases hegel.Generator[timerCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTimer(j, c)
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/92
+
+// startedTwice: a timer of two to six intervals (so that it is still running when the
+// second chain's tick arrives) started again, or sent a broadcast tick, while its
+// first tick is in flight, then a round: the two ticks are both accepted, the second
+// with a tag the mirror has moved past; up to six operations follow. Past the shape,
+// Stop instead: its answering tick and the chain's are both dropped.
+var startedTwice = casesOf(multiples(2, 6), zootest.Seq(
+	zootest.One(zootest.Shaped(zootest.Sampled(timerOp{kind: "start"}, timerOp{kind: "broadcast"}), opOf("stop"))),
+	zootest.One(opOf("round")),
+	zootest.Counted(timerOps, 0, 6),
+))
+
+func TestHegelTimerStartedTwice(t *testing.T) {
+	narrowTimer(t, startedTwice)
+}
+
+// --------------------------------------------------------------------------- bubbles/93
+
+// timeoutNotAMultiple: a timeout of none to six intervals and a remainder, and one
+// round more than the intervals: the last tick takes the countdown below zero on
+// every instance; up to six operations follow. Past the shape, one to six intervals
+// exactly, where the countdown stops at zero.
+var timeoutNotAMultiple = hegel.FlatMap(zootest.Shaped(withRemainder(zootest.Ints(0, 6)), multiples(1, 6)), func(spec timeoutSpec) hegel.Generator[timerCase] {
+	rounds := make([]timerOp, spec.k+1)
+	for i := range rounds {
+		rounds[i] = timerOp{kind: "round"}
+	}
+	return casesOf(hegel.Just(spec), zootest.Seq(hegel.Just(rounds), zootest.Counted(timerOps, 0, 6)))
+})
+
+func TestHegelTimerTimeoutNotAMultipleOfTheInterval(t *testing.T) {
+	narrowTimer(t, timeoutNotAMultiple)
+}
diff --git a/timer/hegel_test.go b/timer/hegel_test.go
new file mode 100644
index 0000000..56a22f7
--- /dev/null
+++ b/timer/hegel_test.go
@@ -0,0 +1,403 @@
+package timer
+
+// Hegel zoo: properties of the timer component against a mirror of its
+// countdown, its running flag and the tick commands it has in flight. A case
+// is an interval, a timeout (a multiple of the interval, or one time in four
+// with a remainder: bubbles/93's shape) and a list of operation records
+// applied in order; the shapes of the recorded bugs are drawn like any other
+// case and fail naming them, and are not drawn under HEGEL_NO_KNOWN=1
+// (timeouts that are multiples; no Start, Toggle or broadcast tick, each of
+// which starts a second chain the library never rejects: bubbles/92).
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// zrun executes a command synchronously and flattens batches and sequences
+// into the messages they would deliver. Tick commands sleep their interval,
+// so the properties use microsecond intervals.
+func zrun(cmd tea.Cmd) []tea.Msg {
+	if cmd == nil {
+		return nil
+	}
+	msg := cmd()
+	if msg == nil {
+		return nil
+	}
+	v := reflect.ValueOf(msg)
+	if v.Kind() == reflect.Slice && v.Type().Elem() == reflect.TypeOf(tea.Cmd(nil)) {
+		var out []tea.Msg
+		for i := 0; i < v.Len(); i++ {
+			c, _ := v.Index(i).Interface().(tea.Cmd)
+			out = append(out, zrun(c)...)
+		}
+		return out
+	}
+	return []tea.Msg{msg}
+}
+
+// timerOp is one operation: a round (every message in flight delivered, in order),
+// Start, Stop, Toggle, a restart (Stop, a round, Start: the only way to resume with
+// one chain in flight), another timer's messages, a tick with a stale tag (stale past
+// the expected one) or a broadcast tick (TickMsg{ID: 0}, accepted by every timer).
+type timerOp struct {
+	kind  string
+	stale int
+}
+
+func (o timerOp) GoString() string {
+	if o.kind == "tagged" {
+		return fmt.Sprintf("tagged(+%d)", o.stale)
+	}
+	return o.kind
+}
+
+// timeoutSpec is a timeout in intervals plus a remainder below one interval.
+type timeoutSpec struct {
+	k   int
+	rem time.Duration
+}
+
+func (t timeoutSpec) of(interval time.Duration) time.Duration {
+	return time.Duration(t.k)*interval + t.rem
+}
+
+// timerCase: the interval, the timeout and the operations.
+type timerCase struct {
+	interval time.Duration
+	timeout  timeoutSpec
+	ops      []timerOp
+}
+
+func (c timerCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("New(%v, WithInterval(%v)): %s", c.timeout.of(c.interval), c.interval, strings.Join(ops, ", "))
+}
+
+func opOf(kind string) hegel.Generator[timerOp] { return hegel.Just(timerOp{kind: kind}) }
+
+// multiples: lo to hi intervals exactly.
+func multiples(lo, hi int) hegel.Generator[timeoutSpec] {
+	return hegel.Map(zootest.Ints(lo, hi), func(k int) timeoutSpec { return timeoutSpec{k: k} })
+}
+
+// withRemainder: k intervals and a remainder of 1 to 999 nanoseconds (below either
+// interval): the countdown goes past zero (bubbles/93).
+func withRemainder(k hegel.Generator[int]) hegel.Generator[timeoutSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) timeoutSpec {
+		return timeoutSpec{k: hegel.Draw(tc, k), rem: time.Duration(hegel.Draw(tc, zootest.Ints(1, 999)))}
+	})
+}
+
+var (
+	// intervals: a microsecond, or two three times in twenty (the tick commands sleep
+	// their interval).
+	intervals = zootest.Weighted(zootest.W(17, hegel.Just(time.Microsecond)), zootest.W(3, hegel.Just(2*time.Microsecond)))
+
+	// timeouts: one to six intervals, or one time in four none to six intervals and a
+	// remainder (never under HEGEL_NO_KNOWN=1).
+	timeouts = zootest.Weighted(
+		zootest.W(6, multiples(1, 6)),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), withRemainder(zootest.Ints(0, 6))),
+	)
+
+	taggedOps = hegel.Map(zootest.Ints(1, 5), func(k int) timerOp { return timerOp{kind: "tagged", stale: k} })
+
+	// timerOps: the operations at the old property's weights, Start first (the
+	// simplest: a Start while a tick is in flight is bubbles/92); Start, Toggle and
+	// the broadcast tick, each of which adds a tick chain the library never rejects,
+	// are not drawn under HEGEL_NO_KNOWN=1, and a restart (Stop, a round that drops
+	// what was in flight, Start) is drawn instead of them.
+	timerOps = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), opOf("start")),
+		zootest.W(7, opOf("round")),
+		zootest.W(2, opOf("stop")),
+		zootest.W(zootest.Unless(zootest.NoKnown, 2), opOf("toggle")),
+		zootest.W(1, opOf("foreign")),
+		zootest.W(1, taggedOps),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), opOf("broadcast")),
+		zootest.W(1, opOf("restart")),
+	)
+
+	// timerCases: an interval, a timeout and one to fourteen operations.
+	timerCases = casesOf(timeouts, zootest.Counted(timerOps, 1, 14))
+)
+
+// casesOf: a case from the timeout and the operations.
+func casesOf(timeout hegel.Generator[timeoutSpec], ops hegel.Generator[[]timerOp]) hegel.Generator[timerCase] {
+	return hegel.Composite(func(tc hegel.TestCase) timerCase {
+		return timerCase{interval: hegel.Draw(tc, intervals), timeout: hegel.Draw(tc, timeout), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// pending is one message the mirror expects the library to have in flight:
+// a tick (with the Timeout flag it was scheduled with and the tag the mirror
+// gave it) or a TimeoutMsg.
+type pending struct {
+	tick bool
+	flag bool
+	tag  int
+}
+
+// tmir mirrors the timer.
+type tmir struct {
+	timeout  time.Duration
+	interval time.Duration
+	running  bool
+	tag      int // advanced by every accepted tick (the library never advances its own: bubbles/92)
+	pend     []pending
+	timeouts int // TimeoutMsgs delivered
+}
+
+func (s *tmir) timedout() bool  { return s.timeout <= 0 }
+func (s *tmir) isRunning() bool { return s.running && !s.timedout() }
+
+// tickOut is what Update returns after an accepted tick: the next tick and,
+// when the countdown has just crossed zero, the timeout message.
+func (s *tmir) tickOut(crossed bool) []pending {
+	out := []pending{{tick: true, flag: s.timedout(), tag: s.tag}}
+	if crossed {
+		out = append(out, pending{tick: false})
+	}
+	return out
+}
+
+// judgeTimer drives the timer through the case and checks Timeout, Running, Timedout,
+// View and the messages the timer emits against the mirror after every step. The
+// mirror counts the countdown down to zero and no further (the library goes
+// negative: bubbles/93), gives every tick it files the tag expected when it was
+// scheduled and accepts a tick exactly when its tag is the one expected; the library
+// never advances its tag, so it accepts every chain's ticks (bubbles/92).
+func judgeTimer(j *zootest.Judge, c timerCase) {
+	s := &tmir{timeout: c.timeout.of(c.interval), interval: c.interval, running: true}
+	m := New(s.timeout, WithInterval(c.interval))
+	id := m.ID()
+
+	// expect checks a batch of messages returned by Update or Init
+	// against the mirror's expectation and files them as pending.
+	var lib []tea.Msg
+	expect := func(what string, out []tea.Msg, want []pending) {
+		if len(out) != len(want) {
+			j.Fail("%s: %d messages %v, expected %d", what, len(out), out, len(want))
+		}
+		for i, msg := range out {
+			switch msg := msg.(type) {
+			case TickMsg:
+				if !want[i].tick {
+					j.Fail("%s: message %d is a tick, expected TimeoutMsg", what, i)
+				}
+				if msg.ID != id || msg.Timeout != want[i].flag {
+					j.Fail("%s: tick %+v, expected id %d timeout %v", what, msg, id, want[i].flag)
+				}
+			case TimeoutMsg:
+				if want[i].tick {
+					j.Fail("%s: message %d is a TimeoutMsg, expected a tick", what, i)
+				}
+				if msg.ID != id {
+					j.Fail("%s: TimeoutMsg for %d, expected %d", what, msg.ID, id)
+				}
+			default:
+				j.Fail("%s: unexpected message %T", what, msg)
+			}
+		}
+		lib = append(lib, out...)
+		s.pend = append(s.pend, want...)
+	}
+	check := func(what string) {
+		if m.Timeout != s.timeout || m.Running() != s.isRunning() || m.Timedout() != s.timedout() {
+			j.Fail("%s: timeout %v running %v timedout %v, expected %v %v %v",
+				what, m.Timeout, m.Running(), m.Timedout(), s.timeout, s.isRunning(), s.timedout())
+		}
+		if m.View() != s.timeout.String() {
+			j.Fail("%s: view %q, expected %q", what, m.View(), s.timeout.String())
+		}
+		if m.ID() != id {
+			j.Fail("%s: id changed %d -> %d", what, id, m.ID())
+		}
+	}
+	// tick mirrors an accepted tick: the countdown moves one interval, to zero at
+	// the least, and the next tick is scheduled.
+	tick := func(what string, cmd tea.Cmd) {
+		before := s.timeout
+		if before > 0 && before < s.interval {
+			// the library's countdown goes negative here
+			j.Shape("bubbles/93")
+		}
+		s.timeout = max(0, before-s.interval)
+		s.tag++
+		expect(what, zrun(cmd), s.tickOut(before > 0 && s.timeout <= 0))
+	}
+	// deliver feeds one tick carrying the mirror's tag and mirrors the acceptance
+	// rule.
+	deliver := func(what string, msg tea.Msg, tag int) {
+		if s.isRunning() && tag != s.tag {
+			// a stale tag: the library never advances its own and accepts the tick
+			j.Shape("bubbles/92")
+		}
+		var cmd tea.Cmd
+		m, cmd = m.Update(msg)
+		if s.isRunning() && tag == s.tag {
+			tick(what, cmd)
+		} else {
+			expect(what+" dropped", zrun(cmd), nil)
+		}
+	}
+	// startStop delivers the message a Start/Stop/Toggle command sends.
+	startStop := func(what string, cmd tea.Cmd, want bool) {
+		msgs := zrun(cmd)
+		if len(msgs) != 1 {
+			j.Fail("%s: %d messages, expected one StartStopMsg", what, len(msgs))
+		}
+		ss, ok := msgs[0].(StartStopMsg)
+		if !ok || ss.ID != id || ss.running != want {
+			j.Fail("%s: %#v, expected StartStopMsg{%d, %v}", what, msgs[0], id, want)
+		}
+		var c tea.Cmd
+		m, c = m.Update(ss)
+		s.running = want
+		// The library answers every StartStopMsg with a fresh tick.
+		expect(what, zrun(c), []pending{{tick: true, flag: s.timedout(), tag: s.tag}})
+		check(what)
+	}
+
+	// round delivers everything in flight, in order.
+	round := func() {
+		msgs, want := lib, s.pend
+		lib, s.pend = nil, nil
+		for i, msg := range msgs {
+			switch msg.(type) {
+			case TickMsg:
+				if !want[i].tick {
+					j.Fail("round: pending %d is a tick, mirror has a TimeoutMsg", i)
+				}
+				deliver("round tick", msg, want[i].tag)
+			case TimeoutMsg:
+				if want[i].tick {
+					j.Fail("round: pending %d is a TimeoutMsg, mirror has a tick", i)
+				}
+				s.timeouts++
+				if s.timeouts > 1 {
+					j.Fail("round: a second TimeoutMsg")
+				}
+				var cmd tea.Cmd
+				m, cmd = m.Update(msg)
+				expect("round timeout", zrun(cmd), nil)
+			}
+		}
+		check("round")
+	}
+
+	expect("init", zrun(m.Init()), []pending{{tick: true, flag: s.timedout(), tag: s.tag}})
+	check("init")
+
+	for step, op := range c.ops {
+		j.Note("step %d: %#v (timeout %v, running %v, tag %d, %d pending)", step, op, s.timeout, s.running, s.tag, len(s.pend))
+		switch op.kind {
+		case "start":
+			startStop("start", m.Start(), true)
+		case "stop":
+			startStop("stop", m.Stop(), false)
+		case "toggle":
+			startStop("toggle", m.Toggle(), !s.isRunning())
+		case "restart":
+			startStop("restart stop", m.Stop(), false)
+			round()
+			startStop("restart start", m.Start(), true)
+		case "foreign":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: id + 1000})
+			if cmd != nil {
+				j.Fail("a tick for timer %d was answered by timer %d", id+1000, id)
+			}
+			m, cmd = m.Update(StartStopMsg{ID: id + 1000, running: !s.running})
+			if cmd != nil {
+				j.Fail("a StartStopMsg for timer %d was answered by timer %d", id+1000, id)
+			}
+			check("foreign")
+		case "tagged":
+			var cmd tea.Cmd
+			m, cmd = m.Update(TickMsg{ID: id, tag: s.tag + op.stale})
+			if cmd != nil {
+				j.Fail("a tick with a stale tag was accepted")
+			}
+			check("tagged")
+		case "broadcast":
+			// an ID-0 tick is accepted by every timer; it carries tag 0
+			deliver("broadcast", TickMsg{ID: 0}, 0)
+			check("broadcast")
+		case "round":
+			round()
+		}
+	}
+	if s.timedout() && s.timeouts == 0 && len(s.pend) == 0 {
+		j.Fail("timed out at %v with nothing in flight and no TimeoutMsg delivered", s.timeout)
+	}
+}
+
+// TestHegelTimerCountsDown drives a timer with start/stop/toggle and rounds
+// of tick delivery and checks Timeout, Running, Timedout, View and the
+// messages the timer emits against the mirror. The shapes of bubbles/92
+// (every StartStopMsg and every broadcast tick starts another tick chain and
+// none is ever rejected, so the countdown speeds up) and bubbles/93 (the
+// countdown goes negative when the timeout is not a multiple of the
+// interval) fail naming them.
+func TestHegelTimerCountsDown(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, timerCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeTimer(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/92
+func TestHegelPinTimerStartWhileRunningDoublesTheSpeed(t *testing.T) {
+	m := New(10*time.Microsecond, WithInterval(time.Microsecond))
+	pend := zrun(m.Init())
+	for _, msg := range zrun(m.Start()) {
+		var c tea.Cmd
+		m, c = m.Update(msg)
+		pend = append(pend, zrun(c)...)
+	}
+	// One interval passes: every tick in flight arrives.
+	for _, msg := range pend {
+		m, _ = m.Update(msg)
+	}
+	if m.Timeout != 9*time.Microsecond {
+		t.Fatalf("after Init, Start and one interval the timeout is %v, expected 9µs: %d ticks were accepted", m.Timeout, 10-int(m.Timeout/time.Microsecond))
+	}
+}
+
+// bubbles/93
+func TestHegelPinTimerViewGoesNegative(t *testing.T) {
+	m := New(1500*time.Microsecond, WithInterval(1000*time.Microsecond))
+	pend := zrun(m.Init())
+	for round := 0; round < 3; round++ {
+		var next []tea.Msg
+		for _, msg := range pend {
+			var c tea.Cmd
+			m, c = m.Update(msg)
+			next = append(next, zrun(c)...)
+		}
+		pend = next
+	}
+	if m.Timeout < 0 {
+		t.Fatalf("a 1.5ms timer ticking every 1ms ends at %v (View %q), expected 0", m.Timeout, m.View())
+	}
+}
